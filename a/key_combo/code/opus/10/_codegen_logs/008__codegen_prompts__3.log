from itertools import combinations
from collections import defaultdict, deque

ODD=5; EVEN=4; NODE=2
pts=[(r,c) for r in range(4) for c in range(4)]

def map_levels(vals):
    vals=sorted(set(vals))
    actual={vals[0]:1}
    cur=1
    for a,b in zip(vals, vals[1:]):
        cur += ODD if (b-a)%2 else EVEN
        actual[b]=cur
    return actual

def build(nodes):
    row_map=map_levels([r for r,c in nodes])
    col_map=map_levels([c for r,c in nodes])
    anodes=[(row_map[r], col_map[c]) for r,c in nodes]
    by_row=defaultdict(list); by_col=defaultdict(list)
    for i,(r,c) in enumerate(anodes):
        by_row[r].append((c,i)); by_col[c].append((r,i))
    for arr in by_row.values(): arr.sort()
    for arr in by_col.values(): arr.sort()
    edges=[]; non=[]
    for arr in by_row.values():
        for (c1,i),(c2,j) in zip(arr, arr[1:]):
            (edges if (c2-c1)%2 else non).append(tuple(sorted((i,j))))
    for arr in by_col.values():
        for (r1,i),(r2,j) in zip(arr, arr[1:]):
            (edges if (r2-r1)%2 else non).append(tuple(sorted((i,j))))
    adj={i:set() for i in range(len(nodes))}
    for a,b in set(edges): adj[a].add(b); adj[b].add(a)
