    H=max(r for r,c in anodes)+NODE+2
    W=max(c for r,c in anodes)+NODE+2
    row_order={}
    col_order={}
    for r,arr in by_row.items():
        for k,(_,i) in enumerate(arr): row_order[i]=k
    for c,arr in by_col.items():
        for k,(_,i) in enumerate(arr): col_order[i]=k
    colors={}
    conflict=False
    def add(cell,col):
        nonlocal conflict
        prev=colors.get(cell)
        if prev is not None and prev"'!=col: conflict=True
        colors[cell]=col if prev is None else prev
    for i,(r,c) in enumerate(anodes):
