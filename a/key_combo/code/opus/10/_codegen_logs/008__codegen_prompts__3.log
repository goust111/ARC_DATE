+    ray_colors: dict[tuple[int, int], int] = {}
+
+    row_pos = {node.idx: i for row in by_row.values() for i, node in enumerate(row)}
+    col_pos = {node.idx: i for col in by_col.values() for i, node in enumerate(col)}
