    return anodes, adj, set(non), conflict

def shortest(adj,s,t):
    dist={s:0}; q=deque([s])
    while q:
        u=q.popleft()
        for v in adj[u]:
            if v not in dist:
                dist[v]=dist[u]+1; q.append(v)
    if t not in dist: return None,None
    ways={s:1}
