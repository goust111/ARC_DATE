+
+def _unique_shortest_path(adj: dict[int, set[int]], start: int, goal: int) -> tuple[list[int], list[frozenset[int]]]:
+    dist = {start: 0}
+    q = deque([start])
+    while q:
+        u = q.popleft()
+        for v in sorted(adj[u]):
+            if v in dist:
+                continue
+            dist[v] = dist[u] + 1
+            q.append(v)
