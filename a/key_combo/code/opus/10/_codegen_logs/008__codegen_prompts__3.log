+        raise AssertionError("terminals are disconnected")
+
+    ways = {start: 1}
+    for u in sorted(dist, key=dist.get):
+        for v in adj[u]:
+            if dist.get(v) == dist[u] + 1:
+                ways[v] = ways.get(v, 0) + ways[u]
