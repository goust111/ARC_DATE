+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is None:
+            continue
+        _validate_generated_instance(grid)
+        return grid
+    raise RuntimeError("failed to generate a valid odd-even ray shortest-path instance")
