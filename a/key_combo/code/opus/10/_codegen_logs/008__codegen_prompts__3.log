+    max_r = max(r for r, _ in placed) + NODE_SIZE
+    max_c = max(c for _, c in placed) + NODE_SIZE
+    bottom = int(RNG.choice(MARGIN_CHOICES))
+    right = int(RNG.choice(MARGIN_CHOICES))
