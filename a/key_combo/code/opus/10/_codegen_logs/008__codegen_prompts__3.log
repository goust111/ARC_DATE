+    "terminal_pairs": ((0, 2),),
+}
+
+TEMPLATE_7 = {
+    "points": ((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (3, 1)),
+    "terminal_pairs": ((0, 2), (3, 5)),
+}
+
+TEMPLATES = (TEMPLATE_6, TEMPLATE_7)
