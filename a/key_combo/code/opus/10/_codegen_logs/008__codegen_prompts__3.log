+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+RNG = np.random.default_rng()
+NODE_SIZE = 2
+MAX_GEN_ATTEMPTS = 400
+ODD_GAPS = (5, 7)
+EVEN_GAP = 4
+MARGIN_CHOICES = (1, 2, 3)
