+def _analyze_nodes(nodes: list[Node], shape: tuple[int, int]) -> dict:
+    by_row: dict[int, list[Node]] = defaultdict(list)
+    by_col: dict[int, list[Node]] = defaultdict(list)
+    for node in nodes:
+        by_row[node.r].append(node)
+        by_col[node.c].append(node)
