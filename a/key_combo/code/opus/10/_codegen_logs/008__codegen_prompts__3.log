+    cells = set()
+    for c in range(left.c + NODE_SIZE, right.c):
+        cells.add((left.r, c))
+        cells.add((left.r + 1, c))
+    return cells
+
+
+def _vertical_strip(upper: Node, lower: Node) -> set[tuple[int, int]]:
+    cells = set()
+    for r in range(upper.r + NODE_SIZE, lower.r):
+        cells.add((r, upper.c))
+        cells.add((r, upper.c + 1))
+    return cells
