    patches = []
    for _ in range(cycle_count):
        if cycle_count == GEN_THREE_CYCLE_COUNT:
            desired = random.choices(GEN_THREE_CYCLE_NOTCH_COUNTS, weights=GEN_THREE_CYCLE_NOTCH_WEIGHTS)[0]
