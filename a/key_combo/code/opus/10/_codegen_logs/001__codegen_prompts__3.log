        r0, c0, box = random.choice(candidates)
        paste(canvas, patch, r0, c0, transparent=GEN_BACKGROUND_COLOR)
        boxes.append(box)
        occupied.update((r0 + int(pr), c0 + int(pc)) for pr, pc in coords)
    return True


