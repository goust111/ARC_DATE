+    if not _validate_generated(inp, out, spec):
+        return None
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        attempt = _generate_attempt()
+        if attempt is None:
+            continue
+        inp, out = attempt
+        in_sig = hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest()
