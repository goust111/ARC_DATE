+        int(spec["panel_h"]),
+        int(spec["panel_w"]),
+        int(spec["rows"][-1]),
+        int(spec["marker_col"]),
+        mapped_color,
+        spec["stamp_offset"],
+        (SQUARE_SIZE, SQUARE_SIZE),
