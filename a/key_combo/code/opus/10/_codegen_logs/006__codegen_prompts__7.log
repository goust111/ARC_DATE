+
+    last_color = observed_colors[-1]
+    wrong_last_color = _build_output(
+        int(spec["panel_h"]),
+        int(spec["panel_w"]),
+        next_row,
+        int(spec["marker_col"]),
+        square_colors[marker_colors.index(last_color)],
+        spec["stamp_offset"],
+        (SQUARE_SIZE, SQUARE_SIZE),
+    )
+    if np.array_equal(wrong_last_color, expected):
+        return False
