+def _generate_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    panel_h = random.randint(7, 9)
+    panel_w = random.randint(5, 7)
+    n_panels = random.choice((3, 4))
+    lower_w = n_panels * panel_w + (n_panels + 1)
