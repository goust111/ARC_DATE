+                else:
+                    span = max(cc for _, cc in cells) - min(cc for _, cc in cells) + 1
+                    far = max(cc for _, cc in cells) if dc > 0 else min(cc for _, cc in cells)
+                    room = 6 - far if dc > 0 else far + 6
