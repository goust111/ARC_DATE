+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+MARKER_COLORS = (RED, GREEN, ORANGE)
+SIDE_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
