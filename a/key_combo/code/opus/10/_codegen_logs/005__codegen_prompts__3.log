+
+def _translation_ok(
+    transformed_markers: list[list[tuple[int, int]]],
+    transformed_blue: list[tuple[int, int]],
+    transformed_axis: list[tuple[int, int]],
+    shift_r: int,
+    shift_c: int,
+    shape: tuple[int, int],
+) -> bool:
+    h, w = shape
+    motif_mask = np.zeros(shape, dtype=bool)
+    for r, c in transformed_blue + transformed_axis:
+        rr = r + shift_r
+        cc = c + shift_c
+        motif_mask[rr, cc] = True
