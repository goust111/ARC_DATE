+def _semantic_checks(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert set(np.unique(g)).issubset({BACKGROUND, OBSTACLE, MARKER, PIVOT})
