+
+    obstacle_count = int(_RNG.integers(MIN_OBSTACLES, MAX_OBSTACLES + 1))
+    used_offsets = [offset]
+    row_limit, col_limit = _symmetric_limits(pivot, grid.shape)
+    candidates = [
