+
+def _line_candidates(
+    target: tuple[int, int],
+    pivot: tuple[int, int],
+    shape: tuple[int, int],
+    axis: str,
+    cross_pivot: bool,
+) -> list[tuple[int, int]]:
+    tr, tc = target
+    pr, pc = pivot
+    candidates: list[tuple[int, int]] = []
+
+    if cross_pivot:
+        if axis == "h":
+            cell = (tr, pc)
+            return [cell] if cell != target and cell != pivot else []
