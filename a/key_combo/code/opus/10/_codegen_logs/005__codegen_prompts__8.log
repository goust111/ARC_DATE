    shape: 1 row x N cols, N is odd, range 5-29
    background: black
    marker: exactly 1 red pixel at center column (col N//2)
  output:
    shape: N x N square
    background: black
    red_V:
      apex at (0, N//2); two diagonals descend left and right
      left arm: (r, N//2 - r) for r in 0..N//2
      right arm: (r, N//2 + r) for r in 0..N//2
    blue_lattice:
      NW-SE diagonal family with period 4
      condition: (c - r - apex_col) % 4 == 0
      placed where strictly inside the V (|c - apex_col| < r) OR below V (r > apex_col)
