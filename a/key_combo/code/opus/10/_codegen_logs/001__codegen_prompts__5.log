+        ccw = _dedupe_adjacent(_spiral_counterclockwise_from_tl(matrix))
+        no_dedup = spiral
+        if true_rings == _ring_sequence(row_major, max_depth):
+            continue
+        if true_rings == _ring_sequence(ccw, max_depth):
+            continue
+        if true_rings == _ring_sequence(no_dedup, max_depth):
+            continue
+        return matrix
+    return None
+
+
