+            for c in range(right, left - 1, -1):
+                out.append(int(matrix[top, c]))
+            top += 1
+    return out
+
+
+def _dedupe_adjacent(seq: list[int]) -> list[int]:
+    palette: list[int] = []
+    for color in seq:
+        if not palette or palette[-1] != color:
+            palette.append(int(color))
+    assert palette, "palette must be non-empty"
+    return palette
