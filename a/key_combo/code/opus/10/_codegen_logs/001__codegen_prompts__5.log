+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MAROON = 9
+PARTITION_COLORS = (1, 2, 3, 4, 6, 7, 8)
+MAX_ATTEMPTS = 500
