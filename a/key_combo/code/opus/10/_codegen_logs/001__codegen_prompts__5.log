+            out.append(int(matrix[top, c]))
+        top += 1
+        for r in range(top, bottom + 1):
+            out.append(int(matrix[r, right]))
+        right -= 1
+        if top <= bottom:
+            for c in range(right, left - 1, -1):
+                out.append(int(matrix[bottom, c]))
+            bottom -= 1
+        if left <= right:
+            for r in range(bottom, top - 1, -1):
