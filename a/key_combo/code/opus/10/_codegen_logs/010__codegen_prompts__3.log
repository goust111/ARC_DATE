+
+def _random_distractor(
+    proto_keys: set[tuple[tuple[int, ...], ...]],
+    size_window: tuple[int, int] | None = None,
+) -> np.ndarray:
+    pool = list(_shape_pool())
+    random.shuffle(pool)
+    fallback: np.ndarray | None = None
+    for base in pool:
+        if _proto_signature_set(base) & proto_keys:
+            continue
