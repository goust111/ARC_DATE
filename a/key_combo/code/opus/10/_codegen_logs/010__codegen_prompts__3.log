+
+    solver_proto, solver_info = _classify_candidates(inp)
+    if solver_proto.shape[0] != proto_comps[0].shape[0]:
+        return False
+
+    placed_red = sorted(
+        [obj for obj in placed if obj["kind"] != "prototype"],
+        key=lambda obj: tuple(_bbox_coords(obj["coords"])),
+    )
+    solver_red = sorted(
