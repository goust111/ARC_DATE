+    lo = min(match_sizes)
+    hi = max(match_sizes)
+    if not any(lo <= size <= hi for size in distractor_sizes):
+        return False
+
+    return True
+
+
+def _oracle_checks(inp: np.ndarray, placed: list[dict]) -> bool:
+    if inp.ndim != 2 or max(inp.shape) > 30:
+        return False
