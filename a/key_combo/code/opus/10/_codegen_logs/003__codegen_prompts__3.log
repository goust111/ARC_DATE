+
+        selected_markers: set[tuple[int, int]] = set()
+        plan_by_color: dict[int, list[tuple[int, int]]] = defaultdict(list)
+        pair_cycle = [(2, 4), (4, 6), (6, 2)]
+        random.shuffle(pair_cycle)
