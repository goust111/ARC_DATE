+
+
+def validate_input(grid: np.ndarray) -> dict:
+    h, w = grid.shape
+    comps = find_components(grid, BG)
+    corner_objects = {}
+    markers_by_color: dict[int, set[tuple[int, int]]] = defaultdict(set)
+    distractors = []
