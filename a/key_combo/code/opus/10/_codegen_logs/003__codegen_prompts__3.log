+def can_place_blob(grid: np.ndarray, cells: list[tuple[int, int]], blocked: set[tuple[int, int]]) -> bool:
+    h, w = grid.shape
+    cell_set = set(cells)
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
