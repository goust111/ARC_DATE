+def component_from_mask(mask: np.ndarray, corner: str, color: int, grid_shape: tuple[int, int]) -> dict:
+    h, w = grid_shape
+    mh, mw = mask.shape
+    r0, c0 = corner_anchor(corner, h, w, mh, mw)
+    coords = [(r0 + rr, c0 + cc) for rr in range(mh) for cc in range(mw) if mask[rr, cc]]
