+    comps = find_components(g, bg)
+    corner_objects: dict[str, dict] = {}
+    markers_by_color: dict[int, set[tuple[int, int]]] = defaultdict(set)
+    for comp in comps:
+        corner = bbox_corner(comp["bbox"], h, w)
+        if corner is not None:
+            corner_objects[corner] = comp
+            continue
