import numpy as np
from collections import deque

def expand(centers, arm_colors, center_colors, shape=(19,19)):
    h,w=shape
    claims={}
    def add(owner,pos,color):
        r,c=pos
        if not (0<=r<h and 0<=c<w): return
        claims.setdefault((r,c),[]).append((owner,color))
    for idx,(r,c) in enumerate(centers):
        add(idx,(r,c),center_colors[idx])
        for d in range(1,4):
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                add(idx,(r+dr*d,c+dc*d),arm_colors[idx])
        for d in range(1,3):
            for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:
                add(idx,(r+dr*d,c+dc*d),center_colors[idx])
    out=np.zeros((h,w),int)
    own=np.full((h,w),-1,int)
    kind=np.zeros((h,w),int)
