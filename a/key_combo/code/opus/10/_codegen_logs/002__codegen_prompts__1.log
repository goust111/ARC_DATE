      centroid=(sum(r for r,c in pts)//len(pts), sum(c for r,c in pts)//len(pts))
      win=min(wins,key=lambda i:(abs(crosses[i]['"'center'][0]-centroid[0])+abs(crosses[i]['center'][1]-centroid[1]),crosses[i]['center'][0],crosses[i]['center'][1]))
      arm=Counter(owner[r,c] for r,c in ta)
      armw=max(arm,key=arm.get) if arm else None
      near=min(range(len(crosses)), key=lambda i:(abs(crosses[i]['center'][0]-centroid[0])+abs(crosses[i]['center'][1]-centroid[1]),crosses[i]['center'][0],crosses[i]['center'][1]))
      alt=Counter(cnt)
      for p in set(tm):
        col=markers[p]
        for i,cr in enumerate(crosses):
          if cr['center_color']==col:
            alt[i]+=1; break
      altw=max(alt,key=alt.get)
      infos.append((len(pts),win,armw,near,altw,len(wins)>1,cnt,alt))
    return {'over':over,'eq':eq,'regs':infos,'board':board}

def sample_centers(h,w,n):
    for _ in range(300):
      nr=random.choice([2,2,3]); nc=random.choice([2,2,3])
      if nr*nc<n: continue
      row_gaps=[random.choice([5,6,6,7]) for _ in range(nr-1)]
      col_gaps=[random.choice([5,6,6,7]) for _ in range(nc-1)]
      rs=sum(row_gaps); cs=sum(col_gaps)
      if rs>h-8 or cs>w-8: continue
      r0=random.randint(3,h-4-rs); c0=random.randint(3,w-4-cs)
      rows=[r0]; cols=[c0]
      for g in row_gaps: rows.append(rows[-1]+g)
      for g in col_gaps: cols.append(cols[-1]+g)
      cand=[(r,c) for r in rows for c in cols]
      adj={p:set() for p in cand}
      for r in rows:
        row=[(r,c) for c in cols]
        for a,b in zip(row,row[1:]): adj[a].add(b); adj[b].add(a)
      for c in cols:
        col=[(r,c) for r in rows]
        for a,b in zip(col,col[1:]): adj[a].add(b); adj[b].add(a)
      start=random.choice(cand); sel=[start]; frontier=list(adj[start])
      while len(sel)<n and frontier:
        p=random.choice(frontier); frontier.remove(p)
        if p in sel: continue
        sel.append(p); frontier.extend([q for q in adj[p] if q not in sel])
      if len(sel)==n: return sel

def try_markers(crosses, shape):
    base=analyze(crosses,{},shape)
    if not base or len(base['regs'])<2: return None
    board=base['board']
    regs=regions(board)
    region_id={p:i for i,pts in enumerate(regs) for p in pts}
    candidates=[]; boundary=[]
    for r in range(shape[0]):
      for c in range(shape[1]):
        if board[r,c]"'!=0: continue
        # not adjacent 4 to input cross cells
        bad=False
        for cr in crosses:
          rr,cc=cr['"'center']
          for p in [(rr,cc),(rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)]:
            if abs(r-p[0])+abs(c-p[1])<=1: bad=True
        if bad: continue
        candidates.append((r,c))
        if any(0<=nr<shape[0] and 0<=nc<shape[1] and board[nr,nc]"'!=0 for nr,nc in neighbors8(r,c)):
          boundary.append((r,c))
    center_colors=[cr['"'center_color'] for cr in crosses]
    for _ in range(500):
      markers={}
      n=random.randint(4,8)
      pool=boundary[:] if len(boundary)>=n else candidates[:]
      random.shuffle(pool)
      # put 2 misleading markers near a region if possible
      if base['regs']:
        target=random.randrange(len(base['regs']))
        winner=base['regs'][target][1]
        alt=random.choice([i for i in range(len(crosses)) if i"'!=winner])
        reg_boundary=[p for p in boundary if region_id.get(p)==target]
        random.shuffle(reg_boundary)
        for p in reg_boundary[:2]: markers[p]=crosses[alt]['"'center_color']
      for p in pool:
        if len(markers)>=n: break
        if p in markers: continue
        if any(max(abs(p[0]-q[0]),abs(p[1]-q[1]))<=1 for q in markers): continue
        markers[p]=random.choice(center_colors)
      if len(markers)<4: continue
      ana=analyze(crosses,markers,shape)
      if not ana or len(ana['regs'])<2: continue
      if len({crosses[win]['center_color'] for _,win,_,_,_,_,_,_ in ana['regs']})<2: continue
      if not any(win"'!=near for _,win,_,near,_,_,_,_ in ana['"'regs']): continue
      if not any(arm is not None and win"'!=arm for _,win,arm,_,_,_,_,_ in ana['"'regs']): continue
      if not any(altw"'!=win for _,win,_,_,altw,_,_,_ in ana['"'regs']): continue
      return ana,markers
    return None

