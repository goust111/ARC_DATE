+        if mode == "region_tie" and not any(info["tied_vote"] for info in analysis["regions"]):
+            continue
+        if mode == "overlap_tie" and not analysis["distance_tie_overlap"]:
+            continue
+        return markers, analysis
+
+    return None
+
