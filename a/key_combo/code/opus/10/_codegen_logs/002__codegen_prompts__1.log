+
+def _closed_black_regions(board: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = board.shape
+    seen = np.zeros((h, w), dtype=bool)
+    regions: list[list[tuple[int, int]]] = []
+    for r in range(h):
