+        region_infos.append(
+            {
+                "cells": cells,
+                "size": len(cells),
+                "winner": winner,
+                "winner_color": fill_color,
+                "center_counts": center_counts,
+                "tied_vote": len(tied_winners) > 1,
+                "distance_tie": distance_tie,
+                "centroid": centroid,
+                "nearest_owner": nearest_owner,
+                "arm_winner": arm_winner,
+                "wrong_marker_winner": wrong_winner,
