import random
from collections import Counter, deque
import numpy as np

BLACK=0
ORTH=[(-1,0),(1,0),(0,-1),(0,1)]
DIAG=[(-1,-1),(-1,1),(1,-1),(1,1)]
ALL=list(range(1,10))


def neighbors8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr or dc:
                yield r+dr,c+dc

def comp(mask):
    h,w=mask.shape; seen=np.zeros((h,w),bool); out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=1; pts=[]
            while q:
                x,y=q.popleft(); pts.append((x,y))
                for dx,dy in ORTH:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and mask[nx,ny] and not seen[nx,ny]: seen[nx,ny]=1; q.append((nx,ny))
            out.append(pts)
    return out


def resolve(crosses, shape):
    h,w=shape
    claims={}
    for idx,cr in enumerate(crosses):
        r,c=cr['center']
        claims.setdefault((r,c), []).append((idx,'center'))
        for d in range(1,4):
            for dr,dc in ORTH:
                pos=(r+dr*d,c+dc*d)
                if 0<=pos[0]<h and 0<=pos[1]<w:
                    claims.setdefault(pos, []).append((idx,'arm'))
        for d in range(1,3):
            for dr,dc in DIAG:
                pos=(r+dr*d,c+dc*d)
                if 0<=pos[0]<h and 0<=pos[1]<w:
                    claims.setdefault(pos, []).append((idx,'center'))
    out=np.zeros((h,w),int)
    owner=np.full((h,w),-1,int)
    center_mask=np.zeros((h,w),bool)
    arm_mask=np.zeros((h,w),bool)
    overlap=0; eq_overlap=False
    for (r,c),lst in claims.items():
        if len(lst)>1: overlap+=1
        ranked=[]
        for idx,role in lst:
            cr,cc=crosses[idx]['center']
            ranked.append((abs(r-cr)+abs(c-cc), cr, cc, idx, role))
        ranked.sort()
        if len(ranked)>1 and ranked[0][:3]==ranked[1][:3]:
            eq_overlap=True
        _,_,_,idx,role=ranked[0]
        owner[r,c]=idx
        if role=='center':
            out[r,c]=crosses[idx]['center_color']; center_mask[r,c]=1
        else:
            out[r,c]=crosses[idx]['arm_color']; arm_mask[r,c]=1
    return out, owner, center_mask, arm_mask, overlap, eq_overlap


def regions(base):
    h,w=base.shape; seen=np.zeros((h,w),bool); regs=[]
    for r in range(h):
        for c in range(w):
            if base[r,c]"'!=0 or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=1; pts=[]; touch=False
            while q:
                x,y=q.popleft(); pts.append((x,y)); touch |= x in (0,h-1) or y in (0,w-1)
                for dx,dy in ORTH:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w and base[nx,ny]==0 and not seen[nx,ny]: seen[nx,ny]=1; q.append((nx,ny))
            if not touch: regs.append(pts)
    return regs


def analyze(crosses, markers, shape):
    exp, owner, center_mask, arm_mask, overlap, eq_overlap = resolve(crosses, shape)
    board=exp.copy()
    for (r,c),color in markers.items(): board[r,c]=color
    regs=regions(board)
    infos=[]
    for pts in regs:
        touched_center=set(); touched_arm=set(); touched_any=set()
        for r,c in pts:
            for nr,nc in neighbors8(r,c):
                if 0<=nr<shape[0] and 0<=nc<shape[1]:
                    if center_mask[nr,nc]: touched_center.add((nr,nc)); touched_any.add((nr,nc))
                    if arm_mask[nr,nc]: touched_arm.add((nr,nc))
                    if (nr,nc) in markers: touched_any.add((nr,nc))
        cnt=Counter(owner[r,c] for r,c in touched_center)
        if not cnt: return None
        maxv=max(cnt.values()); winners=[k for k,v in cnt.items() if v==maxv]
        centroid=(sum(r for r,c in pts)//len(pts), sum(c for r,c in pts)//len(pts))
        w=min(winners, key=lambda i:(abs(crosses[i]['"'center'][0]-centroid[0])+abs(crosses[i]['center'][1]-centroid[1]),crosses[i]['center'][0],crosses[i]['center'][1]))
        armcnt=Counter(owner[r,c] for r,c in touched_arm)
        if armcnt:
            armw=max(armcnt, key=lambda i:(armcnt[i],-crosses[i]['center'][0],-crosses[i]['center'][1]))
        else:
            armw=None
        nearest=min(range(len(crosses)), key=lambda i:(abs(crosses[i]['center'][0]-centroid[0])+abs(crosses[i]['center'][1]-centroid[1]), crosses[i]['center'][0], crosses[i]['center'][1]))
        alt=Counter()
        for r,c in touched_any:
            if (r,c) in markers:
                for i,cr in enumerate(crosses):
                    if cr['center_color']==markers[(r,c)]: alt[i]+=1; break
            elif center_mask[r,c]:
                alt[owner[r,c]] += 1
        altw=max(alt, key=lambda i:(alt[i],-crosses[i]['center'][0],-crosses[i]['center'][1])) if alt else None
        infos.append({'size':len(pts),'winner':w,'armw':armw,'nearest':nearest,'altw':altw,'tie':len(winners)>1,'touch':cnt})
    return {'board':board,'regions':infos,'overlap':overlap,'eq_overlap':eq_overlap,'n_regions':len(infos)}


def sample_centers(h,w,n):
    for _ in range(200):
        nr=random.choice([2,2,3])
        nc=random.choice([2,2,3])
        if nr*nc < n: continue
        row_gaps=[random.choice([5,6,6,7]) for _ in range(nr-1)]
        col_gaps=[random.choice([5,6,6,7]) for _ in range(nc-1)]
        row_span=sum(row_gaps)
        col_span=sum(col_gaps)
        if row_span > h-8 or col_span > w-8: continue
        r0=random.randint(3, h-4-row_span)
        c0=random.randint(3, w-4-col_span)
        rows=[r0]
        cols=[c0]
        for g in row_gaps: rows.append(rows[-1]+g)
        for g in col_gaps: cols.append(cols[-1]+g)
        cand=[(r,c) for r in rows for c in cols]
        idx_map={p:i for i,p in enumerate(cand)}
        adj={p:set() for p in cand}
        for r in rows:
            ordered=[(r,c) for c in cols]
            for a,b in zip(ordered, ordered[1:]): adj[a].add(b); adj[b].add(a)
        for c in cols:
            ordered=[(r,c) for r in rows]
            for a,b in zip(ordered, ordered[1:]): adj[a].add(b); adj[b].add(a)
        start=random.choice(cand)
        sel=[start]; frontier=list(adj[start])
        while len(sel)<n and frontier:
            p=random.choice(frontier); frontier.remove(p)
            if p in sel: continue
            sel.append(p)
            frontier.extend([q for q in adj[p] if q not in sel])
        if len(sel)<n:
            continue
        if not any(a[0]==b[0] or a[1]==b[1] for i,a in enumerate(sel) for b in sel[i+1:]):
            continue
        return sel
    return None


def try_markers(crosses, shape, want_mislead=True):
    base = analyze(crosses, {}, shape)
    if base is None or base['n_regions'] < 2:
        return None
    # candidate cells not on expansion and not near input cross cells
    inp_occ=set()
    for cr in crosses:
        r,c=cr['center']
        inp_occ.add((r,c))
        for dr,dc in ORTH: inp_occ.add((r+dr,c+dc))
    board=base['board']
    region_map={}
    regs=regions(board)
    for i,pts in enumerate(regs):
        for p in pts: region_map[p]=i
    boundary_by_region={i:[] for i in range(len(regs))}
    free=[]
    for r in range(shape[0]):
      for c in range(shape[1]):
        if board[r,c]"'!=0 or (r,c) in inp_occ: continue
        if any(max(abs(r-ir),abs(c-ic))<=1 for ir,ic in inp_occ):
            continue
        reg=region_map.get((r,c), -1)
        if reg>=0:
          adj_center=False
          for nr,nc in neighbors8(r,c):
            if 0<=nr<shape[0] and 0<=nc<shape[1] and base['"'board'][nr,nc]"'!=0:
              # only expansion touches count; approximate by nonzero
              adj_center=True; break
          if adj_center: boundary_by_region[reg].append((r,c))
        free.append((r,c))
    center_colors=[cr['"'center_color'] for cr in crosses]
    for _ in range(300):
        n_mark=random.randint(4,8)
        markers={}
        used=[]
        # target one region to mislead if possible
        target=None
        if want_mislead:
            choices=[i for i,pts in enumerate(regs) if len(boundary_by_region[i])>=2]
            if choices: target=random.choice(choices)
        if target is not None:
            winner=base['regions'][target]['winner']
            alts=[i for i in range(len(crosses)) if i"'!=winner]
            alt=random.choice(alts)
            cand=boundary_by_region[target][:]
            random.shuffle(cand)
            for pos in cand[:min(3,len(cand))]:
                markers[pos]=crosses[alt]['"'center_color']
                used.append(pos)
        pool=free[:]
        random.shuffle(pool)
        for pos in pool:
            if len(markers)>=n_mark: break
            if pos in markers: continue
            if any(max(abs(pos[0]-q[0]),abs(pos[1]-q[1]))<=1 for q in markers):
                continue
            markers[pos]=random.choice(center_colors)
        if len(markers)<4: continue
        ana=analyze(crosses, markers, shape)
        if ana is None or ana['n_regions']<2: continue
        winners={crosses[r['winner']]['center_color'] for r in ana['regions']}
        if len(winners)<2: continue
        if not any(r['winner']"'!=r['"'nearest'] for r in ana['regions']): continue
        if not any(r['armw'] is not None and r['winner']"'!=r['"'armw'] for r in ana['regions']): continue
        if want_mislead and not any(r['altw'] is not None and r['altw']"'!=r['"'winner'] for r in ana['regions']): continue
        return markers, ana
    return None

