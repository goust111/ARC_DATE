+def _render_input(crosses, markers: dict[tuple[int, int], int], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for cross in crosses:
+        r, c = cross["center"]
+        grid[r, c] = cross["center_color"]
+        grid[r - 1, c] = cross["arm_color"]
+        grid[r + 1, c] = cross["arm_color"]
