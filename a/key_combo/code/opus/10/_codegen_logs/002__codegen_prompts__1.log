+def _sample_layout(h: int, w: int, n_crosses: int):
+    for _ in range(250):
+        row_count = random.choice((2, 2, 3))
+        col_count = random.choice((2, 2, 3))
+        if row_count * col_count < n_crosses:
+            continue
+
+        row_gaps = [random.choice(GAP_CHOICES) for _ in range(row_count - 1)]
+        col_gaps = [random.choice(GAP_CHOICES) for _ in range(col_count - 1)]
+        row_span = sum(row_gaps)
+        col_span = sum(col_gaps)
+        if row_span > h - 8 or col_span > w - 8:
+            continue
+
+        r0 = random.randint(3, h - 4 - row_span)
+        c0 = random.randint(3, w - 4 - col_span)
+        rows = [r0]
+        cols = [c0]
+        for gap in row_gaps:
+            rows.append(rows[-1] + gap)
+        for gap in col_gaps:
+            cols.append(cols[-1] + gap)
+
+        lattice = [(r, c) for r in rows for c in cols]
+        adjacency = {point: set() for point in lattice}
+        for r in rows:
+            ordered = [(r, c) for c in cols]
+            for a, b in zip(ordered, ordered[1:]):
+                adjacency[a].add(b)
+                adjacency[b].add(a)
+        for c in cols:
+            ordered = [(r, c) for r in rows]
+            for a, b in zip(ordered, ordered[1:]):
+                adjacency[a].add(b)
+                adjacency[b].add(a)
+
+        start = random.choice(lattice)
+        selected = [start]
+        frontier = list(adjacency[start])
+        while len(selected) < n_crosses and frontier:
+            point = random.choice(frontier)
+            frontier.remove(point)
+            if point in selected:
+                continue
+            selected.append(point)
+            frontier.extend(neigh for neigh in adjacency[point] if neigh not in selected)
+
+        if len(selected) == n_crosses:
+            return selected
+    return None
