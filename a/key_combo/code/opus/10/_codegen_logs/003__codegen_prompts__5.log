+    if not _semantic_checks(inp, segments, palette, run_len, grey_col, palette_cols):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        inp = _gen_attempt()
+        if inp is not None:
+            return inp
+    raise RuntimeError("failed to generate a valid input")

