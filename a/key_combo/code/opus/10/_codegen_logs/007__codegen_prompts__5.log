+    for i in range(right_count):
+        grid[cr, cc + (right_first + i * step_h)] = GREEN
+    for i in range(up_count):
+        grid[cr - (up_first + i * step_v), cc] = BLUE
+    for i in range(down_count):
+        grid[cr + (down_first + i * step_v), cc] = BLUE
+    return grid
+
