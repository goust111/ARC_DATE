def _gen_target_ok(target, row_bands, col_bands):
    band_rows = len(row_bands)
    for i in range(1, band_rows):
        free = sum(len(col_bands[j]) for j in range(NUM_COL_BANDS) if target[i - 1][j] == target[i][j])
        if free < 2:
