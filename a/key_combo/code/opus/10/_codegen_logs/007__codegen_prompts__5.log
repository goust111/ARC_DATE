+    for (r, c), color in terminal_dots.items():
+        out[r, c] = color
+    return out
+
+
+def _build_input(
+    height: int,
+    width: int,
+    center: tuple[int, int],
+    step_h: int,
+    step_v: int,
+    left: tuple[int, int],
+    right: tuple[int, int],
+    up: tuple[int, int],
+    down: tuple[int, int],
