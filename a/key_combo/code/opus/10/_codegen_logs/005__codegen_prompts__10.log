+    decoded = {}
+    n = inp.shape[0] // 2
+    panels = _split_panels(inp, n, n)
+    for name, panel in panels.items():
+        marker = tuple(map(int, np.argwhere(panel == MARKER)[0]))
+        decoded[name] = _decode_marker_side(marker, panel.shape)
+    return decoded == sides
