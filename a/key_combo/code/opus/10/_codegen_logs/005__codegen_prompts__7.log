+
+    wanted_dents = random.randint(2, min(4, len(dent_candidates)))
+    dents = _pick_spaced_cells(boundaryish_dents or dent_candidates, wanted_dents, gap=3)
+    if len(dents) < 2:
+        dents = _pick_spaced_cells(dent_candidates, wanted_dents, gap=3)
+    if len(dents) < 2:
