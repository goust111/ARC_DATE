{
  "type": "transform_in_place",
  "src": "4-connected monochrome outline objects on the bg, plus isolated one-pixel marker pixels",
  "transform": "preserve outline pixels; remove isolated markers; fill each enclosed interior with the unique most frequent marker color contained in that region"
}
</annotation>
