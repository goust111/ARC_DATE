+    if np.any(g[nonguide] == guide_color):
+        return False
+    if not np.any(g[nonguide] != 0):
+        return False
+
+    edge_pixels = np.argwhere(
+        (g != 0)
+        & (
+            (np.arange(n)[:, None] == 0)
+            | (np.arange(n)[:, None] == n - 1)
+            | (np.arange(n)[None, :] == 0)
+            | (np.arange(n)[None, :] == n - 1)
