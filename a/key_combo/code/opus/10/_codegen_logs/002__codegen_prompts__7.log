+    if orientation == "row":
+        extra_border_cols = [0, n - 1]
+        for col in extra_border_cols:
+            for r in range(n):
+                if locked[r, col]:
+                    continue
+                if random.random() < 0.35:
+                    grid[r, col] = random.choice(fill_colors)
+    else:
+        extra_border_rows = [0, n - 1]
+        for row in extra_border_rows:
+            for c in range(n):
+                if locked[row, c]:
