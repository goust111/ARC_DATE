+    n = int(tile.shape[0])
+    out = np.zeros((n * n, n * n), dtype=int)
+    for gr, gc in occupied:
+        r0 = gr * n
+        c0 = gc * n
+        out[r0 : r0 + n, c0 : c0 + n] = tile
