+        current |= new_cells
+        if one_round:
+            break
+        frontier = new_cells
+    return current
+
+
+def _render_blocks(tile: np.ndarray, occupied: set[tuple[int, int]]) -> np.ndarray:
+    n = int(tile.shape[0])
+    out = np.zeros((n * n, n * n), dtype=int)
+    for gr, gc in occupied:
