+
+    if _block_values(out, n) - {tuple([0] * (n * n)), tuple(int(v) for v in g.reshape(-1))}:
+        return False
+
+    full_cells = _propagate_cells(n, main_cells, flags, one_round=False)
+    if require_longer_than_one_round and full_cells == one_round_cells:
+        return False
+
+    return True
+
+
