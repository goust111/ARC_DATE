+    grid = np.zeros((n, n), dtype=int)
+    locked = np.zeros((n, n), dtype=bool)
+
+    if orientation == "row":
+        grid[guide_index, :] = guide_color
+        locked[guide_index, :] = True
+    else:
+        grid[:, guide_index] = guide_color
