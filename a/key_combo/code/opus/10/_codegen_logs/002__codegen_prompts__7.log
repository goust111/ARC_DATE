+        return False
+    if not np.any(g[nonguide] != 0):
+        return False
+
+    edge_pixels = np.argwhere(
+        (g != 0)
+        & (
+            (np.arange(n)[:, None] == 0)
+            | (np.arange(n)[:, None] == n - 1)
+            | (np.arange(n)[None, :] == 0)
+            | (np.arange(n)[None, :] == n - 1)
+        )
+    )
+    if len(edge_pixels) < 2:
+        return False
+
+    flags = _edge_flags(g)
+    if orientation == "row":
+        if index > 0 and not flags["top"]:
+            return False
+        if index < n - 1 and not flags["bottom"] and not (index == 0 and flags["top"]):
+            return False
+        if index == 0 and not flags["bottom"]:
+            return False
+        if index == n - 1 and not flags["top"]:
+            return False
+    else:
+        if index > 0 and not flags["left"]:
+            return False
+        if index < n - 1 and not flags["right"] and not (index == 0 and flags["left"]):
+            return False
+        if index == 0 and not flags["right"]:
+            return False
+        if index == n - 1 and not flags["left"]:
+            return False
