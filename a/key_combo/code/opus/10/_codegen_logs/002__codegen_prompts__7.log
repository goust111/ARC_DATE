spec:
  input:
    grid: 3x3
    background: BLACK
    foreground: single non-black color; all eval examples use GRAY [observed]
    fg_pixels: 3-5 pixels (at least 1, with both fg and bg present)
    center_pixel: always fg [observed]
    connectivity: may be 1-3 connected components (no constraint)
  output:
    grid: 15x15 (= 3*(3+2) x 3*(3+2))
    structure: |
      A 3x3 lattice of 3x3 cells, centered at rows 3-11 / cols 3-11,
      surrounded by a 3-wide border on each side.
      For each fg pixel at (r,c) in input:
        1. Fill the lattice cell at row-band r+1, col-band c+1 with a 3x3 solid fg block.
        2. If r==0 (top edge): stamp the input fg pattern in the cell directly above.
           If r==2 (bottom edge): stamp it directly below.
        3. If c==0 (left edge): stamp the input fg pattern in the cell directly left.
           If c==2 (right edge): stamp it directly right.
      Stamps paint fg pixels only (no bg overwrite between stamps).

generation_strategy:
  approach: direct (input is tiny 3x3, output is deterministic)
  steps:
    - Create a 3x3 BLACK grid.
    - Pick a single fg color (any non-black).
    - Place 3-5 fg pixels; ensure at least 1 bg pixel remains.
    - Optionally bias toward center=(1,1) being fg to match observed pattern.
