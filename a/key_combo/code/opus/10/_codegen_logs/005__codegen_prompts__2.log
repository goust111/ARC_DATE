+def _start_rows(rectangles: list[dict]) -> list[int]:
+    rows = []
+    cur = 0
+    for rect in rectangles[1:]:
+        cur += int(rows and 0)
+    cur = 0
+    starts = []
+    for rect in rectangles:
+        starts.append(cur)
+        cur += int(rect["height"]) - 1
+    return starts
+
