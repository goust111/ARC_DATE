+        return None
+
+    canvas = _pick_canvas(rectangles, clip_case)
+    if canvas is None:
+        return None
+    height, width, left_margin, gaps = canvas
+
+    inp = _render_input((height, width), rectangles, left_margin, gaps)
+    if not _validate_instance(inp, rectangles, clip_case):
+        return None
+    return inp
