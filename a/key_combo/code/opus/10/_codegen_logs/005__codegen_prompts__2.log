+    if clip_case:
+        low = max(max_h, min_visible_h)
+        high = chain_h - 1
+        if low > high:
+            return None
+        height = random.randint(low, high)
+    else:
+        height = random.randint(max(chain_h, GRID_HEIGHT_RANGE[0]), min(30, max(chain_h, GRID_HEIGHT_RANGE[0]) + 4))
