+    directions = []
+    row = 0
+    for prev, cur in zip(rectangles, rectangles[1:]):
+        row += int(prev["height"]) - 1
+        if row < height:
+            if int(prev["bar_length"]) > int(cur["bar_length"]):
+                directions.append(-1)
+            else:
+                directions.append(1)
+    return directions
+
+
+def _validate_instance(inp: np.ndarray, rectangles: list[dict], clip_case: bool) -> bool:
+    try:
+        parsed = _extract_rectangles(inp)
+    except AssertionError:
+        return False
+
+    expected_tuples = [
+        (
+            int(rect["body_color"]),
+            int(rect["height"]),
+            int(rect["width"]),
+            int(rect["bar_row"]),
+            int(rect["bar_start"]),
+            int(rect["bar_length"]),
+        )
+        for rect in sorted(rectangles, key=lambda item: int(item["bbox"][1]))
+    ]
+    parsed_tuples = [
+        (
+            int(rect["body_color"]),
+            int(rect["height"]),
+            int(rect["width"]),
+            int(rect["bar_row"]),
+            int(rect["bar_start"]),
+            int(rect["bar_length"]),
+        )
+        for rect in parsed
+    ]
+    if parsed_tuples != expected_tuples:
+        return False
+
+    out = _render_chain(inp.shape, parsed)
+    try:
+        solved = main(inp)
+    except AssertionError:
+        return False
+    if not np.array_equal(solved, out):
+        return False
+    if np.any(out == GRAY):
+        return False
+    if np.array_equal(inp, out):
+        return False
+
+    visible = _visible_overlap_directions(parsed, inp.shape[0])
+    if len(visible) < 2:
+        return False
+    if not (any(v < 0 for v in visible) and any(v > 0 for v in visible)):
+        return False
+
+    chain_h = _chain_height(parsed)
+    if clip_case:
+        if not chain_h > inp.shape[0]:
+            return False
+    else:
+        if not chain_h <= inp.shape[0]:
+            return False
