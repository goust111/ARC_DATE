+
+def _chain_height(rectangles: list[dict]) -> int:
+    return 1 + sum(int(rect["height"]) - 1 for rect in rectangles)
+
+
+def _chain_width(rectangles: list[dict]) -> int:
+    return 1 + sum(int(rect["width"]) - 1 for rect in rectangles)
