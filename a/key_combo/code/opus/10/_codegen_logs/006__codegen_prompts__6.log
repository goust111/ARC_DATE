+
+    # Favor cells outside the start partition so the invisible walls matter.
+    preferred = [k for k in components if k != start_component] + [start_component]
+    for key in preferred:
+        cells = by_component.get(key, [])
+        if not cells:
+            continue
+        rng.shuffle(cells)
+        for cell in cells:
