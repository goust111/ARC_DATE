+    hr, hc = head
+    for direction in order:
+        dr, dc = DIRS[direction]
+        r, c = hr + dr, hc + dc
+        ray_cells = []
+        while _in_bounds(shape, r, c) and not blocked[r, c]:
+            if 1 <= r < shape[0] - 1 and 1 <= c < shape[1] - 1 and (r, c) not in used:
