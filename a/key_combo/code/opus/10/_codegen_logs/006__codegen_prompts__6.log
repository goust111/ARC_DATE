+    0: [(0, 0), (1, -1), (1, 1)],   # up
+    1: [(0, 0), (-1, -1), (1, -1)], # right
+    2: [(0, 0), (-1, -1), (-1, 1)], # down
+    3: [(0, 0), (-1, 1), (1, 1)],   # left
