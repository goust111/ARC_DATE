+        for mr, mc in markers:
+            d = dist[mr, mc]
+            if d < 0:
+                continue
+            cand = (d + 1, mr, mc, (mr, mc))
+            if best is None or cand < best:
+                best = cand
+        if best is not None:
+            return direction, best[3], best[0]
