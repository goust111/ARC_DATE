+        return None
+    return options[int(rng.integers(len(options)))]
+
+
+def _sample_visible_lure(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    blocked: np.ndarray,
+    head: tuple[int, int],
+    facing: int,
+    used: set[tuple[int, int]],
+) -> tuple[int, int] | None:
