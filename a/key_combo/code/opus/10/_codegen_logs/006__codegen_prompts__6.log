+
+def _sample_blocked_marker(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    blocked: np.ndarray,
+    red_cols: list[int],
+    blue_rows: list[int],
+    head: tuple[int, int],
+    sprite_cells: set[tuple[int, int]],
+) -> tuple[int, int] | None:
+    h, w = shape
+    hr, hc = head
