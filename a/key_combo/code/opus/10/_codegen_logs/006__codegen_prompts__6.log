+def _choose_target(
+    head: tuple[int, int],
+    facing: int,
+    markers: set[tuple[int, int]],
+    blocked: np.ndarray,
+) -> tuple[int, tuple[int, int], int] | None:
+    order = [facing, (facing + 1) % 4, (facing + 3) % 4, (facing + 2) % 4]
+    shape = blocked.shape
