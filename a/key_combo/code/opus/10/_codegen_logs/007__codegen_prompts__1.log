+    anchor = None
+    if red_r == r0 - 1 and c0 <= red_c <= c1:
+        side = "up"
+        anchor = red_c - c0
+    elif red_r == r1 + 1 and c0 <= red_c <= c1:
+        side = "down"
+        anchor = red_c - c0
+    elif red_c == c0 - 1 and r0 <= red_r <= r1:
+        side = "left"
+        anchor = red_r - r0
+    elif red_c == c1 + 1 and r0 <= red_r <= r1:
+        side = "right"
+        anchor = red_r - r0
