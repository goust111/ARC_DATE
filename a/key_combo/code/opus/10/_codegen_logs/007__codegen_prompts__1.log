+                        break
+                if not ok:
+                    break
+            if ok:
+                candidates.append((top, left))
+    random.shuffle(candidates)
+
+    for top, left in candidates:
+        touched = []
+        ok = True
+        for rr in range(ph):
+            for cc in range(pw):
+                if not mask[rr, cc]:
+                    continue
+                gr, gc = top + rr, left + cc
+                for dr in range(-padding, padding + 1):
