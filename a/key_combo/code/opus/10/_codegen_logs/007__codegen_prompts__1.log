+import numpy as np
+
+
+BG = 0
+RED = 2
+RECT_FILL = 5
+MARKER_COLORS = (1, 3, 4, 6, 7, 8, 9)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDE_ORDER = ("up", "down", "left", "right")
+OPPOSITE_SIDE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+GEN_RETRIES = 400
