+
+
+def intended_output(
+    rect_h: int,
+    rect_w: int,
+    fill: int,
+    markers: list[tuple[int, int]],
+    specs: list[SpriteSpec],
+) -> np.ndarray:
+    base = np.full((rect_h, rect_w), fill, dtype=int)
+    marker_map = {spec.color: marker for spec, marker in zip(specs, markers)}
+    sprite_map = {spec.color: spec for spec in specs}
