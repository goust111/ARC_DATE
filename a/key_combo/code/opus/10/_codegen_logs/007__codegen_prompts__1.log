+    marker_margin = 2
+    occupied = np.zeros((rect_h, rect_w), dtype=bool)
+    reserved = np.zeros((rect_h, rect_w), dtype=bool)
+    markers: list[tuple[int, int] | None] = [None] * len(specs)
+    bodies: list[tuple[tuple[int, int], ...] | None] = [None] * len(specs)
