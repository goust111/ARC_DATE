+
+def make_sprite_patch(spec: SpriteSpec) -> np.ndarray:
+    red_pos = marker_from_bbox(0, 0, spec)
+    all_cells = set(spec.body) | {red_pos}
+    r0, c0, r1, c1 = bbox_coords(all_cells)
