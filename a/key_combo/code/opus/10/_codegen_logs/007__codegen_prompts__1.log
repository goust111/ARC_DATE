+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        spec = specs[idx]
+        candidates = []
+        for top in range(rect_h - spec.height + 1):
+            for left in range(rect_w - spec.width + 1):
+                marker = marker_from_bbox(top, left, spec)
+                mr, mc = marker
+                if not (marker_margin <= mr < rect_h - marker_margin):
