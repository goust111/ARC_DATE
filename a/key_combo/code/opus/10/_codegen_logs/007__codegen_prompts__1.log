+                if any(reserved[r, c] for r, c in halo):
+                    continue
+                candidates.append((marker, body_cells, halo))
+        random.shuffle(candidates)
+
+        for marker, body_cells, halo in candidates:
+            markers[idx] = marker
+            bodies[idx] = body_cells
+            for r, c in set(body_cells) | {marker}:
+                occupied[r, c] = True
+            for r, c in halo:
+                reserved[r, c] = True
+            if dfs(pos + 1):
+                return True
+            markers[idx] = None
+            bodies[idx] = None
+            for r, c in set(body_cells) | {marker}:
+                occupied[r, c] = False
+            for r, c in halo:
