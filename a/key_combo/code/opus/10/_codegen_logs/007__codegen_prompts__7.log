+        else:
+            specs.append((r, c, -1, 0))
+    return specs
+
+
+def _visible_by_direct_check(
+    grid: np.ndarray,
+    holes: set[tuple[int, int]],
+    markers: list[tuple[int, int, int, int]],
+) -> set[tuple[int, int]]:
