+def _overlap_slices(shape: tuple[int, int], dr: int, dc: int) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0 = max(0, -dr)
+    r1 = min(h, h - dr)
+    c0 = max(0, -dc)
+    c1 = min(w, w - dc)
+    return r0, r1, c0, c1
