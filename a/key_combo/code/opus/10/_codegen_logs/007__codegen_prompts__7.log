+
+
+def _build_expected_output(
+    inp: np.ndarray,
+    truth: np.ndarray,
+    visible_holes: set[tuple[int, int]],
+) -> np.ndarray:
+    out = inp.copy()
+    for r, c in visible_holes:
+        out[r, c] = int(truth[r, c])
+    return out
+
+
+def _generate_case() -> np.ndarray | None:
