def _paint_expanded_border(out: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
    h, w = out.shape
    r0, c0, r1, c1 = bbox
    er0 = max(0, r0 - 1)
    ec0 = max(0, c0 - 1)
    er1 = min(h - 1, r1 + 1)
    ec1 = min(w - 1, c1 + 1)
    assert er0 <= er1 and ec0 <= ec1

