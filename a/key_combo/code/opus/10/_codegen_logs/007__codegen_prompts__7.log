+
+
+def _marker_position(side: str, line: int, h: int, w: int) -> tuple[int, int]:
+    if side == "L":
+        return line, 0
+    if side == "R":
+        return line, w - 1
+    if side == "T":
+        return 0, line
+    if side == "B":
+        return h - 1, line
+    raise ValueError(side)
+
+
+def _ray_cell(side: str, line: int, depth: int, h: int, w: int) -> tuple[int, int]:
+    if side == "L":
+        return line, depth
+    if side == "R":
+        return line, w - 1 - depth
+    if side == "T":
+        return depth, line
+    if side == "B":
