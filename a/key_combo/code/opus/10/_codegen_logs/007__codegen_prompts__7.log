+    visible_len = _randint(rng, 2, min(4, max_depth - 3))
+    wall_len = _randint(rng, 1, min(3, max_depth - visible_len - 1))
+    blocked_len = _randint(rng, 1, min(3, max_depth - visible_len - wall_len))
+
