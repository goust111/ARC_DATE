+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        frame_mask = sub == RED
+        border = np.zeros_like(frame_mask, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        assert np.array_equal(frame_mask, border), "red components must be one-cell-thick hollow rectangles"
+        frames.append((r0, c0, r1, c1))
