+        cc1 = min(c0 + fw - 1, hc1)
+        if rr0 <= rr1 and cc0 <= cc1:
+            visible_mask[rr0 - r0 : rr1 - r0 + 1, cc0 - c0 : cc1 - c0 + 1] = False
+        if float(np.mean(visible_mask)) < 0.35:
