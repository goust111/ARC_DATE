+    )
+    k = len(missing)
+    assert 2 <= k <= 4, "missing-intersection count must define K in [2, 4]"
+
+    occupied = _occupied_cell_crops(grid, row_lines, col_lines)
+    selected = occupied[::k]
+    assert 2 <= len(selected) <= 5, "expected 2 to 5 selected sprites"
+    return _concat_crops(selected)
