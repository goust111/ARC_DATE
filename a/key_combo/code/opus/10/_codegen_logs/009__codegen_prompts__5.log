+    holes: list[tuple[int, int]],
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, list[int], list[int]]:
+    row_lines = [i * (cell_h + 1) for i in range(cell_rows + 1)]
+    col_lines = [i * (cell_w + 1) for i in range(cell_cols + 1)]
