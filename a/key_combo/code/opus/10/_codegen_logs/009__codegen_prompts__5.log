+    assert len(positions) >= 3, "expected multiple regular grid lines"
+    diffs = np.diff(np.asarray(positions, dtype=int))
+    assert diffs.size > 0 and np.all(diffs == diffs[0]) and diffs[0] > 1, "grid lines must be evenly spaced"
