+def _enumerate_masks() -> dict[tuple[int, int], list[np.ndarray]]:
+    pools: dict[tuple[int, int], list[np.ndarray]] = {}
+    for h, w in ((2, 1), (2, 2), (2, 3), (3, 1), (3, 2)):
