+BG = 0
+BAR = 5
+CONTROL = 9
+SQUARE_COLORS = (1, 2, 3, 4, 7)
+SIDES = (1, 3, 5, 7, 9)
+SHRINK_SIDE = {1: 9, 3: 1, 5: 3, 7: 5, 9: 7}
+GROW_SIDE = {1: 3, 3: 5, 5: 7, 7: 9, 9: 1}
