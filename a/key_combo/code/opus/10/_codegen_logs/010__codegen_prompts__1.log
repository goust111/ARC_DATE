+    "nw": (6, 6),
+    "ne": (6, 18),
+    "center": (12, 12),
+    "sw": (18, 6),
+    "se": (18, 18),
+}
+CORNER_KEYS = ("nw", "ne", "sw", "se")
+DIRECTIONS = ("up", "down", "left", "right")
+SIDE_WEIGHTS = (3, 2, 3, 2, 3)
