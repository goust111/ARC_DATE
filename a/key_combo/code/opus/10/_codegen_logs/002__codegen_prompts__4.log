+    _place_markers(grid, bounds, rng)
+
+    inner_r0 = bounds["r_min"] + 2
+    inner_c0 = bounds["c_min"] + 2
+    smaller_is_blue = bool(rng.integers(0, 2))
+
+    if orientation == "horizontal":
