+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+GRID_MIN_SIZE = 12
+GRID_MAX_SIZE = 24
+INNER_MIN = 6
+INNER_MAX = 10
+MARGIN_MIN = 1
+MARGIN_MAX = 4
+MAX_GENERATION_ATTEMPTS = 400
