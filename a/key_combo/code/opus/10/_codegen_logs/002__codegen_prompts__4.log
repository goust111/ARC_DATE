+
+def _make_input(
+    rng: np.random.Generator,
+    orientation: str,
+    inner_h: int,
+    inner_w: int,
+    top_margin: int,
+    bottom_margin: int,
+    left_margin: int,
+    right_margin: int,
+) -> np.ndarray:
