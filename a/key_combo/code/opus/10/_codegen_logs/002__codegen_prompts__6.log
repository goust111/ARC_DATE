+def _distance_to_gap(coords: np.ndarray, gap_coords: np.ndarray) -> np.ndarray:
+    diffs = np.abs(coords[:, None, :] - gap_coords[None, :, :]).sum(axis=2)
+    return diffs.min(axis=1)
