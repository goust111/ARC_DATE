spec:
  grid: 12-15 rows x 13-15 cols
  colors:
    bg: 0 (black)
    marker: 5 (gray), always exactly 4 pixels [observed]
    draw: one non-bg, non-marker color (any except 0 and 5)
  markers:
    count: exactly 4 pixels of marker color
    extrema: unique top-most, bottom-most, left-most, right-most pixel
    each marker col/row falls strictly inside the opposite axis's frame range
    grid_margin: >=0 cells from grid edge (usually >=1) [observed]
  frame:
    bounds: 1 cell inside marker row/col extrema on each side
    size: 9-11 rows x 8-10 cols [observed]
    must not overlap any marker pixel
  foreground_object:
    shape: hollow rectangle (border = draw_color, interior = bg)
    bbox: 3-4 rows x 3-4 cols [observed]
    pixels: 8-12 [observed]
    connected: single 4-connected component
    placement: strictly inside frame interior, gap >= 2 from frame border on all sides
  output:
    draw frame rectangle in draw_color on the frame bounds
    preserve all existing pixels (markers + foreground object)

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid H in [12,15], W in [13,15]
    2. Pick draw_color from {1..9} \ {5}
    3. Choose frame bounds r0,r1,c0,c1 so frame is 9-11 rows x 8-10 cols and fits inside grid with margin >= 1 on each side
    4. Derive marker positions one cell outside each frame side -- top marker at (r0-1, rand col in [c0,c1]), bottom at (r1+1, rand), left at (rand row in [r0,r1], c0-1), right at (rand, c1+1). Ensure unique extrema and no marker-on-frame overlap
    5. Place hollow rectangle fg object (3-4 x 3-4) inside frame interior with gap >= 2 from frame border on all sides
    6. Build output grid by filling frame border with draw_color, placing markers and fg
    7. Derive input by removing the frame border (set frame border cells that were bg in original to bg), keeping markers and fg object
