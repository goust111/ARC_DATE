+    gap_bbox = _bbox(expected["gap_coords"])
+    if gap_bbox[2] - gap_bbox[0] + 1 != 3 or gap_bbox[3] - gap_bbox[1] + 1 != 3:
+        return False
+
+    for r, c in expected["cap"] + expected["frame"]:
+        if int(inp[r, c]) != BG:
