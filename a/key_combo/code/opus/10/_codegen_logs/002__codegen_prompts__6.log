+def _direction_of_object(obj: dict, gap_coords: np.ndarray) -> str:
+    gap_center = gap_coords.mean(axis=0)
+    obj_center = obj["coords"].mean(axis=0)
+    dr = float(obj_center[0] - gap_center[0])
