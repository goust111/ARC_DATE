+        "tips": tips,
+        "markers": markers,
+        "frame": frame,
+        "cap": cap,
+        "gap_coords": gap_coords,
+        "output": out,
+    }
+    if not _validate_instance(inp, expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_ATTEMPTS):
+        result = _generate_attempt(rng)
