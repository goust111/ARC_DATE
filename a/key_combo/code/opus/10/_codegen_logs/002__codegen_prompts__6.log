+    objects = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords = np.array(pts, dtype=int)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
