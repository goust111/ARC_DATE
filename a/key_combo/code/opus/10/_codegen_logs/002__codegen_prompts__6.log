+    obj_coords = [obj["coords"] for obj in objects]
+    scores = []
+    for r, c in bg_coords:
+        distances = []
+        for coords in obj_coords:
+            d = np.abs(coords[:, 0] - r) + np.abs(coords[:, 1] - c)
+            distances.append(int(d.min()))
