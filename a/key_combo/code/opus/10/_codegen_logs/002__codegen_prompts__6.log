+    objects = {}
+    occupied = set()
+    for direction in DIRECTIONS:
+        coords = _build_object(direction, tips[direction], areas_by_dir[direction], rng)
+        if not _shape_is_irregular(coords):
+            return None
+        if len(coords) != len(set(coords)):
+            return None
+        for r, c in coords:
