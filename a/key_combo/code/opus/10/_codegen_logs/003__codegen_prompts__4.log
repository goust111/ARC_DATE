+    placements.sort(key=lambda item: (item[1]["bbox"][0], item[1]["bbox"][1]))
+    return placements
+
+
+def _render_output(grid: np.ndarray) -> np.ndarray:
+    frame = _find_frame_component(grid)
+    slots = _extract_slots(grid, frame["bbox"])
