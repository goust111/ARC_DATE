+def _extract_slots(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> list[dict]:
+    r0, c0, r1, c1 = frame_bbox
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
