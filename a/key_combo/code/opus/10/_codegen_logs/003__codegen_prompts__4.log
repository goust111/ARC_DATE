+        mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+        mask[coords[:, 0] - sr0, coords[:, 1] - sc0] = True
+        slots.append(
+            {
+                "bbox": (r0 + sr0, c0 + sc0, r0 + sr1, c0 + sc1),
+                "local_bbox": (sr0, sc0, sr1, sc1),
+                "mask": mask,
+                "canonical": _canonical_key(mask),
