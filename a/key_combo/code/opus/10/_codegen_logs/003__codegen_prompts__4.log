+def _find_frame_component(grid: np.ndarray) -> dict:
+    grey_comps = _color_components(grid, {GREY})
+    if not grey_comps:
+        raise ValueError("expected a grey frame")
+    return max(grey_comps, key=lambda comp: int(comp["mask"].sum()))
