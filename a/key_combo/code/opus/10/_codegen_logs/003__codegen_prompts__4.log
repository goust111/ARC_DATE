+    return slots
+
+
+def _match_pieces_to_slots(pieces: list[dict], slots: list[dict]) -> list[tuple[dict, dict, np.ndarray]]:
+    slot_candidates = []
+    for piece in pieces:
+        matches = []
+        for slot_idx, slot in enumerate(slots):
