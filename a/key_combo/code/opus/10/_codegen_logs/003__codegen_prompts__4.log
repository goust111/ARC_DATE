+BLACK = 0
+RED = 2
+GREY = 5
+PIECE_COLORS = (1, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GENERATE_RETRIES = 400
