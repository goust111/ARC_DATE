+    shapes = []
+    for size in range(3, 7):
+        for cells in by_size[size]:
+            mask = _mask_from_cells(cells)
+            h, w = mask.shape
+            if h % 2 != 0:
+                continue
+            top = bool(mask[: h // 2].any())
+            bottom = bool(mask[h // 2 :].any())
+            if not (top and bottom):
