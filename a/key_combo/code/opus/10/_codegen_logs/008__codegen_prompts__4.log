        if grid[rr, cc] not in (_GEN_BLACK, _GEN_RED):
            return int(rr), int(cc), int(prev_r), int(prev_c)
        prev_r, prev_c = rr, cc
        rr += dr
        cc += dc
    return None


def _gen_opening_candidates(grid, r, c, axis, dr, dc, color_pool):
