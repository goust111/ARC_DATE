+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+LEFT_FG = 1
+RED = 2
+RIGHT_FG = 3
+SEP = 4
+ORANGE = 7
+
+PANEL_SIZE = 15
+PANEL_SIZE_OPTIONS = (12, 13, 14)
