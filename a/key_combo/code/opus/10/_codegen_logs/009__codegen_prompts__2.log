+        return "vertical_final"
+    if overlap & h_pair["final"]:
+        return "horizontal_final"
+    return "trail_only"
+
+
+def _validate_generated(grid: np.ndarray, target_v_color: int, target_h_color: int, requested_mode: str) -> bool:
