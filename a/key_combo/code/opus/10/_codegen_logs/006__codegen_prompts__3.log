import random
from collections import defaultdict, deque

def norm(cells):
    r0=min(r for r,c in cells); c0=min(c for r,c in cells)
    cells=tuple(sorted((r-r0,c-c0) for r,c in cells))
    return cells

def bends(cells):
    h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1
    s=set(cells)
    cnt=0
    for r in range(h-1):
        for c in range(w-1):
            n=((r,c) in s)+((r+1,c) in s)+((r,c+1) in s)+((r+1,c+1) in s)
            if n==3: cnt+=1
    return cnt

def bbox_dims(cells):
    return max(r for r,c in cells)+1, max(c for r,c in cells)+1

seen=set(); best=defaultdict(list)
for area in range(4,11):
    for _ in range(50000):
        cells={(0,0)}
        while len(cells)<area:
            r,c=random.choice(tuple(cells))
            dr,dc=random.choice([(1,0),(-1,0),(0,1),(0,-1)])
            cells.add((r+dr,c+dc))
        n=norm(cells)
        if n in seen: continue
        seen.add(n)
        b=bends(n)
        if 1<=b<=5:
            h,w=bbox_dims(n)
            score=max(h,w)*10 + h*w  # prefer compact
            best[(b,area)].append((score,n))
for b in range(1,6):
    print('BEND',b)
    for area in range(4,11):
        vals=best.get((b,area))
        if not vals: continue
        vals=sorted(vals,key=lambda x:x[0])
        print(' area',area,'shape',vals[0][1])
    print()
