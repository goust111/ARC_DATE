+def _ring_output(colors: list[int]) -> np.ndarray:
+    side = 2 * len(colors) - 1
+    out = np.full((side, side), int(colors[0]), dtype=int)
+    for layer, color in enumerate(colors[1:], start=1):
+        out[layer : side - layer, layer : side - layer] = int(color)
+    return out
