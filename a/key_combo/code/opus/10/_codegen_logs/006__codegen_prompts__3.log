from collections import defaultdict, deque

def norm(cells):
    r0=min(r for r,c in cells); c0=min(c for r,c in cells)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

def arr(cells):
    h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1
    a=[[0]*w for _ in range(h)]
    for r,c in cells: a[r][c]=1
    return a

def bends(cells):
    a=arr(cells)
    h=len(a); w=len(a[0])
    cnt=0
    for r in range(h-1):
        for c in range(w-1):
            s=a[r][c]+a[r+1][c]+a[r][c+1]+a[r+1][c+1]
            if s==3: cnt+=1
    return cnt

def conn(cells):
    s=set(cells)
    q=deque([next(iter(s))]); vis={next(iter(s))}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            p=(r+dr,c+dc)
            if p in s and p not in vis:
                vis.add(p); q.append(p)
    return len(vis)==len(s)

