+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _place_objects(h: int, w: int, specs: list[tuple[int, tuple[tuple[int, int], ...]]]) -> np.ndarray | None:
+    grid = np.zeros((h, w), dtype=int)
