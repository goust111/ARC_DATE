+def _count_bends(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    count = 0
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if int(mask[r : r + 2, c : c + 2].sum()) == 3:
+                count += 1
+    return count
