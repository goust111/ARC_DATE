+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+INPUT_COLOR = 3
+BEND_TO_COLOR = {1: 1, 2: 2, 3: 4, 4: 5, 5: 6}
+GEN_ATTEMPTS = 400
+
+
+# Normalized connected templates grouped by (bend_count, area).
