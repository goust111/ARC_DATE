+        used: set[int] = set()
+        order = bends[:]
+        random.shuffle(order)
+        ok = True
+        for bend in order:
+            candidates = [area for area in SHAPE_LIBRARY[bend] if area not in used]
+            if not candidates:
+                ok = False
+                break
+            area = random.choice(candidates)
+            area_by_bend[bend] = int(area)
+            used.add(int(area))
+        if not ok:
+            continue
