}
</annotation>
<generation_spec>
```yaml
spec:
  grid: fixed 8x8
  background: single dominant color (any 0-9); always 7 in eval [observed]
  markers:
    count: 1-4 colored pixels, each at a distinct grid corner (0,0), (0,7), (7,0), (7,7)
    colors: each marker a distinct non-bg color (0-9 minus bg)
  transform:
    - erase each corner marker back to bg
    - stamp a fixed inward stencil per corner in the marker's color
    - top-left stencil (2x2 block):  (1,1) (1,2) (2,1) (2,2)
    - top-right stencil (2x2 block): (1,5) (1,6) (2,5) (2,6)
    - bottom-left stencil (3px bent): (4,2) (5,2) (6,3)
    - bottom-right stencil (3px bent): (4,5) (5,5) (6,4)
  constraints:
    - all stencil target cells must be bg in the input (trivially satisfied since only corners are non-bg)
    - stencils never overlap (by design for 8x8)

generation_strategy:
  approach: direct (input is simple; just place corner markers)
  steps:
    1. pick bg color uniformly from 0-9
    2. fill 8x8 grid with bg
    3. choose k corners to activate (k from 1-4; sample subset of {TL,TR,BL,BR})
    4. sample k distinct non-bg colors for the chosen corners
    5. place each color at its corner cell
  notes: no output-first needed; the input is trivially the constrained object
```
