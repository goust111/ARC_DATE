+        total = 0
+        for i in range(n_shapes):
+            remaining_shapes = n_shapes - i - 1
+            max_for_this = min(3, 6 - total - remaining_shapes)
+            choices = [1]
+            if max_for_this >= 2:
+                choices += [2, 2]
+            if max_for_this >= 3:
+                choices += [3]
+            choice = random.choice(choices)
+            counts.append(choice)
