+    bottom_margin = 1
+    min_gap = 1
+    usable = height - top_margin - bottom_margin
+    need = sum(shape_heights) + min_gap * (len(shape_heights) - 1)
+    if usable < need:
+        return None
+    extra = usable - need
+    gaps = _random_gaps(extra, len(shape_heights) + 1)
+    rows = []
+    r = top_margin + gaps[0]
