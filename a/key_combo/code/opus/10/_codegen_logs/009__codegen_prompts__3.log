+    sys.path.append(str(_TOOLBOX_DIR))
+
+from arc_utils import bbox_coords, components_mask, crop_bbox, get_bg, paste
+
+
+BG = 8
+BLACK = 0
+SEP = 5
+LEGEND_SIZE = 5
+LEGEND_INNER = 3
+MAX_RETRIES = 400
