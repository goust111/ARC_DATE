def conn(mask):
    pts=set(mask)
    if not pts:return False
    q=deque([next(iter(pts))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nb=(r+dr,c+dc)
            if nb in pts and nb not in seen:
                seen.add(nb); q.append(nb)
    return seen==pts

