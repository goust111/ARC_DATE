+            out["left"].add((r, c))
+        if c == c1:
+            out["right"].add((r, c))
+        if r == r0:
+            out["up"].add((r, c))
+        if r == r1:
+            out["down"].add((r, c))
+    return out
+
+
+def _associate_markers(grid: np.ndarray, objects: list[dict]) -> dict[int, tuple[int, int, str]]:
+    owner = {}
+    side_cells = [_object_sides(obj) for obj in objects]
+    cell_to_object = {}
+    for idx, obj in enumerate(objects):
