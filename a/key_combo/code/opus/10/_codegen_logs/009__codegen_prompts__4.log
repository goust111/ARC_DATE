+    seen = set()
+    objects = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color in (BG, RED) or (r, c) in seen:
+                continue
+            mask = g == color
+            coords = _component(mask, (r, c))
+            seen.update(coords)
