+                sides.append(side)
+            elif side == "right" and any((int(r), int(c) - 1) == cell for cell in cells):
+                sides.append(side)
+            elif side == "up" and any((int(r) + 1, int(c)) == cell for cell in cells):
+                sides.append(side)
+            elif side == "down" and any((int(r) - 1, int(c)) == cell for cell in cells):
+                sides.append(side)
