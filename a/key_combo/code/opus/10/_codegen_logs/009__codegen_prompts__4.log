+    assert len(owner) == len(objects)
+    return owner
+
+
+def _mirror_coords(obj: dict, side: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = obj["bbox"]
+    out = []
+    for r, c in obj["coords"]:
