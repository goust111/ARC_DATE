+    sym_flags = [np.array_equal(tile, tile.T) for tile in tiles]
+    asym_indices = [idx for idx, is_sym in enumerate(sym_flags) if not is_sym]
+    assert len(asym_indices) == 1, "expected exactly one asymmetric tile"
