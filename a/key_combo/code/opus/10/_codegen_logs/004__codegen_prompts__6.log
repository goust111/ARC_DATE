+            [
+                (spec["anchor_tl"][0], spec["anchor_tl"][1]),
+                (spec["anchor_tl"][0] + 1, spec["anchor_tl"][1]),
+                (spec["anchor_tl"][0], spec["anchor_tl"][1] + 1),
