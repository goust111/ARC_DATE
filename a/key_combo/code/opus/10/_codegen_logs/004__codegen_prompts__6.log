+        bbox_a = _sprite_bbox_from_tl(mask_a, stop_a)
+
+        success_b = None
+        for _ in range(180):
+            mask_b = _random_mask(blocked_dir)
+            h_b, w_b = mask_b.shape
+            stop_choices = _adjacent_stop_choices(bbox_a, mask_b.shape, blocked_dir)
+            stop_choices.sort(key=lambda pos: pos[1])
+            for stop_b in stop_choices:
+                lead_steps_b = h_a
+                start_steps_b = random.randint(start_steps_a + 1, start_steps_a + 4)
