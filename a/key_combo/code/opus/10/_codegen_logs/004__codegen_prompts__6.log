+    for r, c in coords:
+        if not (0 <= r < H and 0 <= c < W):
+            return False
+        r0 = max(0, r - 1)
+        r1 = min(H, r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(W, c + 2)
+        if occupied[r0:r1, c0:c1].any():
