+BG = 0
+ANCHOR_COLOR = 5
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+MOTIF_BLOCKER_MASKS = [
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1, 0], [0, 1, 1, 1]], dtype=bool),
+    np.array([[1, 0, 1, 1], [1, 1, 1, 0]], dtype=bool),
+]
