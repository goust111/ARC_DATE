+    return positions
+
+
+def _expected_output(complete_seed: np.ndarray, interior_h: int, interior_w: int) -> np.ndarray:
+    out = np.full((interior_h + 2, interior_w + 2), FRAME, dtype=int)
+    out[1:-1, 1:-1] = _scale2(complete_seed)
+    return out
+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    expected: np.ndarray,
