        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        return_format="dict",
    )
    blocks: list[tuple[int, int]] = []
    for comp in comps:
        b = comp["bbox"]
        assert int(comp["area"]) == 4 and bbox_h(b) == 2 and bbox_w(b) == 2
        blocks.append((int(b[0]), int(b[1])))

