+    seen = set()
+    for seed in seeds:
+        comp = tuple(sorted(_component_from_mask(sprite_mask, seed)))
+        if comp and comp not in seen:
+            seen.add(comp)
+            components_by_seed.append(list(comp))
+    assert len(components_by_seed) == 1, "marker must select exactly one component"
