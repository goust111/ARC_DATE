+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    cell_rows = int(rng.choice([2, 3]))
+    cell_cols = 3
+    cell_h = int(rng.integers(5, 9))
+    cell_w = int(rng.integers(5, 9))
