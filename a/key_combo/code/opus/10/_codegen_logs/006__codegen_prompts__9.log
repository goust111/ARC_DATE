+import numpy as np
+
+
+BG = 0
+SEP = 5
+MARK = 8
+FG_COLORS = [1, 2, 3, 4, 6, 7, 9]
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GEN_ATTEMPTS = 400
