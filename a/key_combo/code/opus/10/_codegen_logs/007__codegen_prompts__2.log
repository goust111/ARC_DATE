  "path": "from each control pixel, take one orthogonal step toward the nearer edge bar along the bar-to-bar axis",
  "trajectory": "paint the stepped-to background pixel with the nearer edge bar's color",
  "transform": "leave the control pixels and edge bars unchanged"
}
</annotation>
<generation_spec>
