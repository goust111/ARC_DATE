spec:
  grid: 10-20 rows x 10-20 cols, always square [observed]
  colors:
    background: BLACK (0) [observed]
    foreground: GREEN (3) [observed], exactly 1 non-bg color
    yellow: absent from input, used only in output
  cross:
    structure: exactly one full-width row + one full-height column, all fg color
    center: intersection at (cr, cc); not on any edge (1 <= cr <= H-2, 1 <= cc <= W-2)
    min_edge_distance: >=3, ensures >=3 visible complete rings [observed]
    foreground_is_exactly_cross: all fg pixels lie on the cross row/col, no extras
  transform:
    for each bg pixel, compute Chebyshev distance d = max(|r-cr|, |c-cc|)
    if d is even, recolor to YELLOW; if odd, keep bg
    cross pixels unchanged

generation_strategy:
