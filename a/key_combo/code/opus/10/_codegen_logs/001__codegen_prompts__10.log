+        return False
+
+    off_x_markers = 0
+    for rect in rects:
+        r0 = int(rect["r0"])
+        c0 = int(rect["c0"])
+        r1 = int(rect["r1"])
+        c1 = int(rect["c1"])
+        marker = int(rect["marker"])
+        rect_h = r1 - r0 + 1
+        rect_w = c1 - c0 + 1
