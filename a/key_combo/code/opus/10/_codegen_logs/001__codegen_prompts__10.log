+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLORS = (1, 2, 3)
+YELLOW = 4
+FRAME = 5
+RECT_SIZES = (7, 9, 11)
+MAX_GEN_RETRIES = 400
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _x_mask(height: int, width: int) -> np.ndarray:
+    assert height > 0 and width > 0
+    if height > width:
+        return _x_mask(width, height).T
+
+    mask = np.zeros((height, width), dtype=bool)
+    center_rows = {(height - 1) // 2, height // 2}
+    for r in range(height):
+        d = min(r, height - 1 - r)
+        left = d
+        right = width - 1 - d
+        if r in center_rows:
+            mask[r, left : right + 1] = True
+        else:
+            mask[r, left] = True
+            mask[r, right] = True
+    return mask
+
+
+def _ring_fill(height: int, width: int, xmask: np.ndarray) -> np.ndarray:
+    rows, cols = np.indices((height, width))
+    center_r = height // 2
+    center_c = width // 2
+    dist = np.maximum(np.abs(rows - center_r), np.abs(cols - center_c))
+    return (~xmask) & (dist % 2 == 0)
+
