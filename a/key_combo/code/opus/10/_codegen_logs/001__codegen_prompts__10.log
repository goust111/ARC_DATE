+def _choose_sizes(n_rects: int) -> list[tuple[int, int]]:
+    kinds = ["wide", "tall"]
+    if n_rects == 3:
+        kinds.append(random.choices(["square", "wide", "tall"], weights=[3, 2, 2], k=1)[0])
+    sizes = [_random_size(kind) for kind in kinds]
+    random.shuffle(sizes)
+    return sizes
+
