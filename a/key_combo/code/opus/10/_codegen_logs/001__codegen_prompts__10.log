+def _shape_kind(size: tuple[int, int]) -> str:
+    h, w = size
+    if h < w:
+        return "wide"
+    if h > w:
+        return "tall"
+    return "square"
+
+
+def _random_size(kind: str) -> tuple[int, int]:
+    if kind == "wide":
+        return random.choice([(7, 9), (7, 11), (9, 11)])
+    if kind == "tall":
+        return random.choice([(9, 7), (11, 7), (11, 9)])
+    assert kind == "square"
+    return random.choice([(9, 9), (11, 11)])
