+            mask.tobytes(),
+            np.fliplr(mask).tobytes(),
+            np.flipud(mask).tobytes(),
+            np.flipud(np.fliplr(mask)).tobytes(),
+        }
+        if len(variants) != 4:
+            continue
+        if len(_component_coords(mask)) != 1:
+            continue
+        return mask
+
+    raise RuntimeError("failed to generate a non-symmetric sprite")
