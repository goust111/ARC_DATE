spec:
  grid: 18x18, background color 4
  sources:
    count: 2-3 per grid
    structure: 8-connected component of monochrome sprite pixels + 1 marker pixel of a different color
    sprite_color: any non-bg color; multiple sources may share the same sprite color
    marker_color: unique per source; distinct from all sprite colors and bg; not color 5
    sprite_pixels: 3-8, 8-connected, LR-symmetric about the marker column [observed]
    component_bbox: 3-4 rows x 3-5 cols (including marker)
    marker_position: 8-adjacent to at least one sprite pixel; may be inside or outside sprite bbox
  destinations:
