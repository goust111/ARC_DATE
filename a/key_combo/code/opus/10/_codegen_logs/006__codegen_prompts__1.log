+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+
+GRID_SIZES = (12, 14, 16)
+SPRITE_CELLS = (3, 4, 5, 6)
+TARGET_COUNTS = (3, 4, 5)
+MAX_GENERATION_ATTEMPTS = 500
+_SEEN_INPUT_SIGS: set[bytes] = set()
+_SEEN_OUTPUT_SIGS: set[bytes] = set()
