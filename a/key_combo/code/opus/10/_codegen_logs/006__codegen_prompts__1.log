+            continue
+        if np.count_nonzero(mask) != target:
+            continue
+        if np.array_equal(mask, np.fliplr(mask)):
+            continue
+        if np.array_equal(mask, np.flipud(mask)):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 2)):
+            continue
