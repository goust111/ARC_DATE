+    out = main(grid)
+    out_sig = out.tobytes() + str(out.shape).encode()
+    if inp_sig in _SEEN_INPUT_SIGS or out_sig in _SEEN_OUTPUT_SIGS:
+        return None
+
+    _SEEN_INPUT_SIGS.add(inp_sig)
+    _SEEN_OUTPUT_SIGS.add(out_sig)
