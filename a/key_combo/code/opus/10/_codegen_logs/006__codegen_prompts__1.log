+def _mask_to_anchor_deltas(mask: np.ndarray, anchor: tuple[int, int]) -> list[tuple[int, int]]:
+    ar, ac = anchor
+    coords = np.argwhere(mask)
+    return _sort_cells((int(r) - ar, int(c) - ac) for r, c in coords)
