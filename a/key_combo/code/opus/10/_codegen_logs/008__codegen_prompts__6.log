+    n = len(order)
+    out = np.array(grid, copy=True)
+    frame_right, gap = frame_extent
+    table = _table_from_order(order)
+    phase = np.where(np.indices((n, n))[0] <= np.indices((n, n))[1], np.indices((n, n))[1], (np.indices((n, n))[1] + 1) % n)
