+    )
+    assert np.any(mask & np.tril(np.ones_like(mask, dtype=bool), -1)), "need blanks below the diagonal"
+    assert all(visible_counts[idx] >= 1 for idx in range(1, n)), "all nonzero phases must stay visible"
+    return mask
+
