+    if height_min > 30:
+        raise ValueError("height exceeds ARC limit")
+    height = int(rng.integers(height_min, 31))
+    if height > 30:
+        raise ValueError("height exceeds ARC limit")
+
+    max_top = height - frame_span_h - 1
+    if max_top < 1:
+        raise ValueError("frames do not fit vertically")
+    top = int(rng.integers(1, max_top + 1))
+    left = left_margin
