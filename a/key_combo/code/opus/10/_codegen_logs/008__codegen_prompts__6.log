+from __future__ import annotations
+
+from itertools import combinations, permutations
+
+import numpy as np
+
+
+BG = 0
+BLANK = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _frame_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0 : r1 + 1, c0] = True
+    mask[r0 : r1 + 1, c1] = True
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
+    return mask
+
+
+def _phase_index(row: int, col: int, period: int) -> int:
+    if row <= col:
+        return col
+    return (col + 1) % period
+
+
+def _find_table_bbox(grid: np.ndarray, bg: int) -> tuple[int, int, int, int]:
+    candidates: list[tuple[int, int, int, int]] = []
+    for coords in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h == w >= 3 and len(coords) == h * w:
+            candidates.append((r0, c0, r1, c1))
