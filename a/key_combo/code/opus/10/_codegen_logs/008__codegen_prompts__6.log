+    bg = _get_bg(g)
+    table_bbox = _find_table_bbox(g, bg)
+    left, colors, frames = _left_frame_data(g, table_bbox, bg)
+    edges = _crossing_edges(left, colors, frames)
+    order = _unique_order(colors, edges)
+    return _fill_table(g, table_bbox, order)
