    rotation_patch: rows h-3 to h-1; 3x3 with color-7 clock-hand (2 pixels from center toward up/right/down/left = 0/90/180/270 deg)
  canvas:
    width: grid_w minus legend+separator cols; height: grid_h
    background: 2-4 non-{0,6} colors in bands/grid/nested-rings pattern [observed: usually 2 colors in uniform horizontal or vertical stripes]
    constraint: canvas bg colors must be disjoint from unit sprite colors (both panels)
  composite:
    build: tile color-swapped unit into each active frame cell -> (fh*uh) x (fw*uw)
    rotate: rot90 by -k (k from rotation patch)
    place: anchor_to_topleft maps (pr,pc) to canvas offset; composite must fit fully (no clipping)
    overlay: non-{0,6} composite pixels overwrite canvas; canvas color-6 pixels preserved; when multiple composites exist, they must not overlap (no shared non-{0,6} pixels)

generation_strategy:
