+def _parse_layout(grid: np.ndarray) -> Tuple[List[int], List[int]]:
+    row_lines = _full_color_rows(grid, YELLOW)
+    col_lines = _full_color_cols(grid, YELLOW)
+    assert len(row_lines) == GRID_CELLS - 1
+    assert len(col_lines) == GRID_CELLS - 1
