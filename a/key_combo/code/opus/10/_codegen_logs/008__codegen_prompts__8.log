        if (r, c) in seen or not _gen_in_bounds(noise_color.shape, r, c):
            continue
        if int(noise_color[r, c]) != int(color):
            continue
        seen.add((r, c))
        stack.extend(_gen_neighbors4(r, c))
    return seen


