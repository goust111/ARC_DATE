    return 0 <= row < height and 0 <= col < width


def _gen_noise_component(
    noise_color: np.ndarray, row: int, col: int, color: int
) -> set[tuple[int, int]]:
    stack = [(int(row), int(col))]
    seen: set[tuple[int, int]] = set()
