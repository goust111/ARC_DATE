# Direction marker masks.
MARKER_MASKS = {
    True: np.array([[1, 0, 0], [1, 1, 1], [0, 1, 0]], dtype=bool),
    False: np.array([[0, 0, 1], [1, 1, 1], [0, 1, 0]], dtype=bool),
