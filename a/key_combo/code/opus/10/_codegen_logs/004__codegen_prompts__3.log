+        "grid": g,
+        "bg": bg,
+        "n": n,
+        "template_mask": template_mask,
+        "template_bbox": template_bbox,
+        "control_row": control_row,
+        "controls": controls,
+        "copy_top": copy_top,
+        "copy_starts": copy_starts,
+        "total_grey_area": total_grey_area,
