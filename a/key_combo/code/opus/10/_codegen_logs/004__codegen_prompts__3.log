+                        stack.append((nr, nc))
+            if len(seen) != area:
+                continue
+            shape = _normalize(coords)
+            rs = [r for r, _ in shape]
+            cs = [c for _, c in shape]
+            h = max(rs) + 1
+            w = max(cs) + 1
