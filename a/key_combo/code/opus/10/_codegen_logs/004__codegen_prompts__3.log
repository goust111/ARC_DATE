+
+def _control_layout_candidates(n: int, bbox_w: int) -> list[dict]:
+    dist_choices = [dist for dist in range(2, 5) if dist >= bbox_w]
+    scaled_w = bbox_w * n
+    cands: list[dict] = []
+    for count in range(2, 5):
