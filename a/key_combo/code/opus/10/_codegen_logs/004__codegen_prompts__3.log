+
+def _render_scene(
+    scene: dict,
+    *,
+    scale_factor: int | None = None,
+    position_factor: int | None = None,
+    recolor: bool = True,
+) -> np.ndarray | None:
+    g = scene["grid"]
+    factor = scene["n"] if scale_factor is None else int(scale_factor)
+    if factor <= 0:
+        return None
