+                c0 + mc * SPRITE_SIZE : c0 + (mc + 1) * SPRITE_SIZE,
+            ] = color
+
+
+def _place_markers(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    colors: tuple[int, ...],
+    count_by_color: dict[int, int],
+    start_row: int,
