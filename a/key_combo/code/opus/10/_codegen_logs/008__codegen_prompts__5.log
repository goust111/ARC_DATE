+BG = 0
+RED = 2
+TEAL = 8
+SPRITE_SIZE = 4
+MACRO_SIDE = 3
+PATTERN_SIZE = SPRITE_SIZE * MACRO_SIDE
+PALETTE = (1, 3, 4, 6, 7, 9)
+RNG = np.random.default_rng()
