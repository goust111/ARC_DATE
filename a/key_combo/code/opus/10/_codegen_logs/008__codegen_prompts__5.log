+    _paste(out, control, control_r0, control_c0)
+
+    pattern_r0, pattern_c0, _, _ = pattern_bbox
+    for mr in range(MACRO_SIDE):
+        for mc in range(MACRO_SIDE):
+            color = int(macro_grid[mr, mc])
+            if color == BG:
