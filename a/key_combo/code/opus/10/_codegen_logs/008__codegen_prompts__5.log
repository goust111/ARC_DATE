+        bag: list[int] = []
+        for color, count in zip(colors, counts, strict=True):
+            bag.extend([int(color)] * int(count))
+        RNG.shuffle(bag)
+        for (r, c), color in zip(occupied, bag, strict=True):
+            assignment[r, c] = int(color)
