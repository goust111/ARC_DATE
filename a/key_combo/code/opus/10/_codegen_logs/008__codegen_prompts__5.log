+        cols = {c for _, c in occupied}
+        if rows != {0, 1, 2} and (0 not in rows or 2 not in rows):
+            continue
+        if cols != {0, 1, 2} and (0 not in cols or 2 not in cols):
+            continue
+        if 0 not in rows or 2 not in rows or 0 not in cols or 2 not in cols:
+            continue
+
