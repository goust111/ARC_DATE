+
+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    control_bbox: tuple[int, int, int, int],
+    sprite: np.ndarray,
+    pattern_bbox: tuple[int, int, int, int],
+    macro_grid: np.ndarray,
