+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if in_bounds(passable.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
