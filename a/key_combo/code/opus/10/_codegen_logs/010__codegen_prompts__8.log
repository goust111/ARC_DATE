+            r0, c0, r1, c1 = obj["bbox"]
+            if not (r0 >= 2 and c0 >= 2 and r1 < case["h"] - 2 and c1 < case["w"] - 2):
+                return False
+            for other in case["objects"]:
+                if other is obj:
+                    continue
+                for rect in _growth_rects(obj["bbox"]):
+                    if _rects_intersect(rect, other["bbox"]):
