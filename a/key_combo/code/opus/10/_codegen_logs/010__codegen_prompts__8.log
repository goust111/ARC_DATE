+                center = (r, c)
+                bar = _bar_cells(axis, center)
+                control = (r - step[0], c - step[1])
+                if not (0 <= control[0] < h and 0 <= control[1] < w):
+                    continue
+                if not all(0 <= rr < h and 0 <= cc < w for rr, cc in bar):
