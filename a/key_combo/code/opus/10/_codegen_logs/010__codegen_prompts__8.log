+                obj["growth_rects"] = _growth_rects(bbox) if obj["hit"] else []
+                placed.append(obj)
+                break
+        else:
+            return False
+    return True
+
+
+def _build_case() -> dict | None:
+    h = random.randint(20, 26)
+    w = random.randint(20, 26)
+    axis, center, control, bar_cells, step = _choose_marker(h, w)
