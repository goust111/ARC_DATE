+def _paint_rect(out: np.ndarray, rect: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = rect
+    h, w = out.shape
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(h - 1, int(r1))
+    cc1 = min(w - 1, int(c1))
+    if rr0 <= rr1 and cc0 <= cc1:
+        out[rr0 : rr1 + 1, cc0 : cc1 + 1] = int(color)
