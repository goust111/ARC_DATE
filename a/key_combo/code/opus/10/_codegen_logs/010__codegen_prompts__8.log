+            candidates = _candidate_bboxes(obj["side"], "opposite_offline", center, step, (h, w))
+        for bbox in candidates:
+            if _valid_bbox(bbox, hit=obj["hit"], placed=placed, marker_cells=marker_cells, shape=(h, w)):
