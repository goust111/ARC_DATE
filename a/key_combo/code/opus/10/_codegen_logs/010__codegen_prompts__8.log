+    out[(out == BAR) | (out == CONTROL)] = BG
+    for obj in objects:
+        r0, c0, r1, c1 = obj["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = BG
+    for obj in objects:
+        _draw_swapped_square(out, obj)
