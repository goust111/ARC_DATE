+
+def _pair_layout_ok(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    step: tuple[int, int],
+) -> bool:
+    if _gap_between_boxes(a, b) < MIN_GAP:
+        return False
+    if step[0] != 0:
+        col_overlap = min(a[3], b[3]) >= max(a[1], b[1])
