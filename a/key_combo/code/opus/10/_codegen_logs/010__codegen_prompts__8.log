+                "coords": coords,
+                "coords_set": {tuple(map(int, rc)) for rc in coords},
+                "side": side,
+                "inner_side": side - 2,
+                "inner_color": inner_color,
+                "border_color": border_color,
+                "center": ((r0 + r1) // 2, (c0 + c1) // 2),
+            }
+        )
+    assert 3 <= len(objects) <= 4, "expected three or four concentric-square objects"
+    return objects
