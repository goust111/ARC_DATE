+def _box_covers_marker_cells(bbox: tuple[int, int, int, int], cells: set[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return any(r0 <= r <= r1 and c0 <= c <= c1 for r, c in cells)
