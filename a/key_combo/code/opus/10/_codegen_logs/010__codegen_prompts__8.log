+
+
+def _valid_bbox(
+    bbox: tuple[int, int, int, int],
+    *,
+    hit: bool,
+    placed: list[dict],
+    marker_cells: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    if r0 < 1 or c0 < 1 or r1 >= h - 1 or c1 >= w - 1:
+        return False
+    if hit and (r0 < 2 or c0 < 2 or r1 >= h - 2 or c1 >= w - 2):
+        return False
+    if _box_covers_marker_cells(bbox, marker_cells):
+        return False
