+    else:
+        hit_count = random.choice([2, 2, 2, 1])
+    hit_indices = set(random.sample(range(count), hit_count))
+    case = {
+        "h": h,
+        "w": w,
+        "axis": axis,
+        "center": center,
+        "control": control,
+        "bar_cells": bar_cells,
+        "step": step,
+        "objects": [],
+    }
+    for i, spec in enumerate(specs):
+        case["objects"].append(
