+    for idx in random.sample(range(len(gaps)), random.randint(0, max_twos)):
+        gaps[idx] = 2
+
+    top_margin = 2
+    bottom_margin = 2 if n_segments == 7 else random.choice([2, 3])
+    height = top_margin + 1 + sum(gap + 1 for gap in gaps) + bottom_margin
