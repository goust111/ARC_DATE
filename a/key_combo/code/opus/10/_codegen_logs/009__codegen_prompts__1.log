+    body = g[:-1]
+    counts = Counter(int(v) for v in body.flat if int(v) != BACKGROUND)
+    marker_colors = [color for color, count in counts.items() if count == 2 and color not in control_set]
+    assert len(marker_colors) == len(control_colors)
