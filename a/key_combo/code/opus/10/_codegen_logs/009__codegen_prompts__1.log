+
+BACKGROUND = 0
+DEFAULT_OUTLINE_COLOR = 3
+MARKER_POOL = (1, 3, 4, 8, 9)
+CONTROL_POOL = (2, 5, 6, 7)
+MAX_GENERATION_ATTEMPTS = 600
