    c_sign = 0 if ec == sc else (1 if ec > sc else -1)
    r_steps = [r_sign] * abs(er - sr) + [0] * (step_count - abs(er - sr))
    c_steps = [c_sign] * abs(ec - sc) + [0] * (step_count - abs(ec - sc))
