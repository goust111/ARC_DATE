+def _translated_shape(abs_dr: int, abs_dc: int, sr: int, sc: int) -> dict:
+    p = (0, 0)
+    q = (sr * abs_dr, sc * abs_dc)
+    shape = _shape_from_markers(p, q)
+    shape["dr"] = q[0] - p[0]
+    shape["dc"] = q[1] - p[1]
+    return shape
+
