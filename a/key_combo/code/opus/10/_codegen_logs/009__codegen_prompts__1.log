+    for color in sorted(marker_colors):
+        pts = np.argwhere(body == color)
+        assert pts.shape == (2, 2)
+        p, q = sorted((tuple(map(int, pts[0])), tuple(map(int, pts[1]))))
+        shape = _shape_from_markers(p, q)
+        shape["marker_color"] = int(color)
+        shapes.append(shape)
