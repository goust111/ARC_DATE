from itertools import product

def sign(x): return (x>0)-(x<0)

def seg(a,b):
    r0,c0=a; r1,c1=b
    dr=r1-r0; dc=c1-c0
    n=max(abs(dr),abs(dc))
    sr=sign(dr); sc=sign(dc)
    return [(r0+i*sr,c0+i*sc) for i in range(n+1)]

def decompose(p,q):
    dr=q[0]-p[0]; dc=q[1]-p[1]
    adr=abs(dr); adc=abs(dc)
    diag=min(adr,adc)
    sr=sign(dr); sc=sign(dc)
    dvec=(sr*diag, sc*diag)
    if adr>adc: svec=(sr*(adr-adc),0)
    else: svec=(0,sc*(adc-adr))
    return svec,dvec

def poly(p,q):
    s,d=decompose(p,q)
    a=p; b=(p[0]+s[0],p[1]+s[1]); c=q; d2=(p[0]+d[0],p[1]+d[1])
    return [a,b,c,d2]

def cross(a,b,p):
    ax,ay=a[1],a[0]; bx,by=b[1],b[0]; px,py=p[1],p[0]
    return (bx-ax)*(py-ay)-(by-ay)*(px-ax)

def inside(pt, polyv):
    signs=[]
    for i in range(4):
        z=cross(polyv[i], polyv[(i+1)%4], pt)
        if z==0: return False
        signs.append(1 if z>0 else -1)
    return all(s==signs[0] for s in signs)

def area(adr,adc):
    p=(0,0); q=(adr,adc)
    s,d=decompose(p,q)
    sc=(p[0]+s[0],p[1]+s[1]); dc=(p[0]+d[0],p[1]+d[1])
    outline=set(seg(p,sc))|set(seg(p,dc))|set(seg(sc,q))|set(seg(dc,q))
    polyv=[p,sc,q,dc]
    rs=[r for r,c in polyv]; cs=[c for r,c in polyv]
    cnt=0
    cells=[]
    for r in range(min(rs), max(rs)+1):
      for c in range(min(cs), max(cs)+1):
        if (r,c) in outline: continue
        if inside((r,c), polyv):
          cnt+=1; cells.append((r,c))
    return cnt,len(outline)

vals=[]
for adr in range(2,9):
  for adc in range(2,9):
    if adr==adc: continue
    ar, per=area(adr,adc)
    vals.append((adr,adc,ar,per,adr+adc))
print('count', len(vals))
for row in sorted(vals, key=lambda x:(x[2],x[0],x[1]))[:40]:
  print(row)
print('unique areas', sorted(set(v[2] for v in vals)))
