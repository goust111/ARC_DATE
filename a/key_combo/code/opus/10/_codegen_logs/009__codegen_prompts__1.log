+    polygon = [p, straight_corner, q, diag_corner]
+    rows = [r for r, _c in polygon]
+    cols = [c for _r, c in polygon]
+    interior = set()
+    for r in range(min(rows), max(rows) + 1):
+        for c in range(min(cols), max(cols) + 1):
+            cell = (r, c)
+            if cell in outline:
+                continue
+            if _strictly_inside_polygon(cell, polygon):
