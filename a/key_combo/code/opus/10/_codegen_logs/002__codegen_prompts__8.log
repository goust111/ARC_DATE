+    earliest = plan["earliest"]
+    counts = plan["counts"].copy()
+    assert counts[earliest] > 0
+    order.append(earliest)
+    counts[earliest] -= 1
+    remainder: list[int] = []
+    for color, count in counts.items():
+        remainder.extend([color] * count)
+    random.shuffle(remainder)
+    order.extend(remainder)
+    return order
