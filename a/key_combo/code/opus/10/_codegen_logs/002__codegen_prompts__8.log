+def _render_squares(shape: tuple[int, int], squares: list[Square]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for sq in squares:
+        grid[sq.top : sq.top + 2, sq.left : sq.left + 2] = sq.color
+    return grid
