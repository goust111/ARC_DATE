+            {"counts": Counter({a: 2, b: 1}), "winner": a, "earliest": b},
+            {"counts": Counter({b: 2, c: 1}), "winner": b, "earliest": c},
+            {"counts": Counter({c: 2, a: 1}), "winner": c, "earliest": a},
