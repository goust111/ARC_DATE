+        for comp in _components(g == color):
+            if len(comp) == 1:
+                markers[comp[0]] = color
+                continue
+
+            r0, c0, r1, c1 = _bbox(comp)
+            if len(comp) == 4 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2):
+                if set(comp) == {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}:
