+    square_mask = _square_mask(g.shape, squares)
+    barrier = square_mask | ray_mask
+    out, regions = _region_trace(ray_grid, barrier, markers, tie_mode=tie_mode)
+    return {
+        "output": out,
+        "squares": squares,
+        "markers": markers,
+        "ray_grid": ray_grid,
+        "ray_mask": ray_mask,
+        "square_mask": square_mask,
+        "barrier": barrier,
+        "regions": regions,
+    }
