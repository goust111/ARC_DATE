+from __future__ import annotations
+
+from collections import Counter, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLACK = 0
+SQUARE_COLORS = (1, 2, 3)
+MARKER_COLORS = (4, 6, 7, 8, 9)
+DIAGONAL_RAYS = (
+    (0, 0, -1, -1),
+    (0, 1, -1, 1),
+    (1, 0, 1, -1),
+    (1, 1, 1, 1),
+)
+GEN_ATTEMPTS = 400
