+@dataclass(frozen=True)
+class Square:
+    color: int
+    top: int
+    left: int
+
+    @property
+    def bottom(self) -> int:
+        return self.top + 1
+
+    @property
+    def right(self) -> int:
+        return self.left + 1
+
+    @property
+    def cells(self) -> set[tuple[int, int]]:
