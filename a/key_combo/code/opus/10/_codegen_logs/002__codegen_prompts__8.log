+
+            regions.append(
+                {
+                    "cells": cells,
+                    "black_cells": black_cells,
+                    "markers": markers,
+                    "boundary_cells": boundary_cells,
+                    "counts": counts,
+                    "winner": winner,
+                    "tied_colors": tied_colors,
+                    "is_tie": is_tie,
+                }
+            )
