+def _simulate_paths(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    starts = sorted(int(c) for c in np.flatnonzero(g[h - 1] == GREY))
+    out = g.copy()
+    infos: list[dict] = []
+
+    for sc in starts:
+        r = h - 1
+        c = sc
+        cells = [(r, c)]
+        blockers: list[tuple[int, int]] = []
+        row_profile = {r: c}
