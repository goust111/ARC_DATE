+
+def _component_cells_local(mask: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+
+
+def _expected_output(
+    grid: np.ndarray,
+    copies: Iterable[dict[str, object]],
