+    if not _is_connected(mask, connectivity=8):
+        return None
+    if not _all_rows_cols_used(mask):
+        return None
+    if not np.all(mask.sum(axis=1) >= 2):
+        return None
+    if not np.all(mask.sum(axis=0) >= 2):
+        return None
