_GEN_COPY_COUNT_BOUNDS = (1, 3)
_GEN_DISTRACTOR_COUNT_BOUNDS = (13, 22)
_GEN_PINK_DENSITY_BOUNDS = (0.10, 0.13)
_GEN_DISTRACTOR_CLUSTER_BOUNDS = (1, 4)
