+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    deltas = STRUCT4 if int(connectivity) == 4 else STRUCT8
+    seen = np.zeros(mask.shape, dtype=bool)
+    parts: list[np.ndarray] = []
+    H, W = mask.shape
+    for r in range(H):
+        for c in range(W):
