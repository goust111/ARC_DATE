+    parts: list[np.ndarray] = []
+    H, W = mask.shape
+    for r in range(H):
+        for c in range(W):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
