+    ref_left_min = 2
+    ref_left_max = max(ref_left_min, W - tw - 7)
+    if ref_left_min > ref_left_max:
+        return None
+    ref_left = random.randint(ref_left_min, ref_left_max)
+    blue_top = GEN_SEPARATOR_ROW + 1
+    if blue_top + th > H:
+        return None
+
+    grid = np.zeros((H, W), dtype=int)
+    grid[GEN_SEPARATOR_ROW, :] = GREY
