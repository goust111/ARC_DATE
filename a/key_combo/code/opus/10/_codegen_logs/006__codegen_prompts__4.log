+
+    red_crop = (grid[red_box[0] : red_box[2] + 1, red_box[1] : red_box[3] + 1] == RED)
+    blue_crop = (grid[blue_box[0] : blue_box[2] + 1, blue_box[1] : blue_box[3] + 1] == BLUE)
