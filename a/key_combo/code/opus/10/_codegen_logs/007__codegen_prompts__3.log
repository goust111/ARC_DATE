import numpy as np

BLACK, RED, YELLOW, TEAL = 0, 2, 4, 8
MIN_SIZE, MAX_SIZE = 12, 17
MIN_TARGETS, MAX_TARGETS = 4, 6
MAX_ATTEMPTS = 2000


def manhattan(a,b):
    return abs(a[0]-b[0])+abs(a[1]-b[1])

def sign(x):
    return (x>0)-(x<0)

def l_path_cells(src,dst):
    r0,c0=src; r1,c1=dst
    cells=[]
    if c0 "'!= c1:
        step = 1 if c1>c0 else -1
        for c in range(c0+step, c1+step, step):
            if (r0,c)==(r1,c1):
                break
            cells.append((r0,c))
    if r0 != r1:
        step = 1 if r1>r0 else -1
        for r in range(r0+step, r1, step):
            cells.append((r,c1))
    return cells

def trace(start, targets):
    rem=list(targets)
    cur=start
    steps=[]
    ties=0
    close=0
    while rem:
        ordered=sorted(rem, key=lambda p: (manhattan(cur,p), p[0], p[1]))
        d0=manhattan(cur, ordered[0])
        if len(ordered)>1:
            d1=manhattan(cur, ordered[1])
            if d1==d0:
                ties+=1
            if d1 <= d0+2:
                close+=1
        dst=ordered[0]
        steps.append((cur,dst))
        rem.remove(dst)
        cur=dst
    return steps, ties, close

def validate(start, targets, shape, require_tie=None):
    pts=[start,*targets]
    if len(pts)!=len(set(pts)):
        return False
    rows={p[0] for p in pts}; cols={p[1] for p in pts}
    if len(rows)!=len(pts) or len(cols)!=len(pts):
        return False
    H,W=shape
    if not all(0<=r<H and 0<=c<W for r,c in pts):
        return False
    if max(rows)-min(rows) < 5 or max(cols)-min(cols) < 5:
        return False
    steps,ties,close=trace(start, targets)
    if require_tie is True and ties < 1:
        return False
    if require_tie is False and ties != 0:
        return False
    if close < 1:
        return False
    unique=set(); total=0; overlap=0
    hdirs=[]; vdirs=[]
    endpoint_set=set(pts)
    for src,dst in steps:
        cells=l_path_cells(src,dst)
        if not cells:
            return False
        if any(cell in endpoint_set-{src,dst} for cell in cells):
            return False
        if not all(0<=r<H and 0<=c<W for r,c in cells):
            return False
        total += len(cells)
        overlap += sum(cell in unique for cell in cells)
        unique.update(cells)
        hdirs.append(sign(dst[1]-src[1]))
        vdirs.append(sign(dst[0]-src[0]))
    if total < 12 or len(unique) < 10:
        return False
    if overlap * 2 > total:
        return False
    if len(set(hdirs)) + len(set(vdirs)) < 3:
        return False
    return True

def sample_general(rng, H, W, n_targets):
    rows = rng.choice(np.arange(1, H-1), size=n_targets+1, replace=False)
    cols = rng.choice(np.arange(1, W-1), size=n_targets+1, replace=False)
    rng.shuffle(rows)
    rng.shuffle(cols)
    pts=[(int(r),int(c)) for r,c in zip(rows, cols)]
    return pts[0], pts[1:]

def sample_tie(rng, H, W, n_targets):
    for _ in range(200):
        start=(int(rng.integers(2,H-2)), int(rng.integers(2,W-2)))
        dmax=min(7, H+W)
        d=int(rng.integers(4,dmax+1))
        offsets=[]
        for dr in range(-d+1,d):
            dc_abs=d-abs(dr)
            if dr==0 or dc_abs==0:
                continue
            for dc in (-dc_abs, dc_abs):
                p=(start[0]+dr,start[1]+dc)
                if 1<=p[0]<H-1 and 1<=p[1]<W-1:
                    offsets.append(p)
        uniq=[]
        for p in offsets:
            if p not in uniq:
                uniq.append(p)
        if len(uniq)<2:
            continue
        pairs=[(a,b) for i,a in enumerate(uniq) for b in uniq[i+1:] if a[0]!=b[0] and a[1]!=b[1]]
        if not pairs:
            continue
        a,b=pairs[int(rng.integers(len(pairs)))]
        used_rows={start[0],a[0],b[0]}; used_cols={start[1],a[1],b[1]}
        avail_rows=[r for r in range(1,H-1) if r not in used_rows]
        avail_cols=[c for c in range(1,W-1) if c not in used_cols]
        if len(avail_rows) < n_targets-2 or len(avail_cols) < n_targets-2:
            continue
        rng.shuffle(avail_rows); rng.shuffle(avail_cols)
        rest=[(int(avail_rows[i]), int(avail_cols[i])) for i in range(n_targets-2)]
        targets=[a,b,*rest]
