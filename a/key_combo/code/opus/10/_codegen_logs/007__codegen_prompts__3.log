+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+MIN_SIZE = 12
+MAX_SIZE_EXCLUSIVE = 17
+MIN_TARGETS = 4
+MAX_TARGETS = 6
+TIE_MODE_PROB = 0.4
