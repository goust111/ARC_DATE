+    r1, c1 = dst
+    cells: list[Coord] = []
+
+    if c0 != c1:
+        step_c = 1 if c1 > c0 else -1
+        for c in range(c0 + step_c, c1 + step_c, step_c):
+            if (r0, c) == (r1, c1):
+                break
+            cells.append((r0, c))
+
+    if r0 != r1:
+        step_r = 1 if r1 > r0 else -1
+        for r in range(r0 + step_r, r1, step_r):
+            cells.append((r, c1))
+
+    return cells
+
+
