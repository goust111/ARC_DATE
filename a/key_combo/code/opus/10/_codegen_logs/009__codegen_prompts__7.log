+    h, w = g.shape
+    out = np.zeros_like(g)
+
+    if edge == "left":
+        for r in range(h):
+            count = int(np.count_nonzero(g[r, :] == BLUE))
+            if count:
+                out[r, :count] = BLUE
+    elif edge == "right":
+        for r in range(h):
+            count = int(np.count_nonzero(g[r, :] == BLUE))
+            if count:
+                out[r, w - count :] = BLUE
+    elif edge == "top":
+        for c in range(w):
+            count = int(np.count_nonzero(g[:, c] == BLUE))
+            if count:
+                out[:count, c] = BLUE
+    else:
+        for c in range(w):
+            count = int(np.count_nonzero(g[:, c] == BLUE))
+            if count:
