+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+PINK = 6
+INSTRUCTION_SIZE = 4
+MACRO_SCALE = 2
+ACTIVE_HEIGHT = 2
+PERIOD = 2
+MAX_ATTEMPTS = 400
+
+
+def _decode_mask(block: np.ndarray) -> np.ndarray:
+    assert block.shape == (INSTRUCTION_SIZE, INSTRUCTION_SIZE)
+    mask = np.zeros((2, 2), dtype=bool)
