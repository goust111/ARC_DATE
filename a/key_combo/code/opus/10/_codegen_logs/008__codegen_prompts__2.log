+    out = np.zeros_like(inp)
+
+    for c in range(cutoff):
+        inp[band_r0 : band_r0 + ACTIVE_HEIGHT, c] = tile[:, c % PERIOD]
+    for c in range(width):
+        col = c % PERIOD
