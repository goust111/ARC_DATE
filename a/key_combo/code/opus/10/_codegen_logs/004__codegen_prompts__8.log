+def _follow_chain(start: dict[str, int], by_col: dict[int, dict[str, int]]) -> list[dict[str, int]]:
+    chain = [start]
+    current = start
+    while True:
+        next_col = current["col"] + current["height"]
+        nxt = by_col.get(next_col)
+        if nxt is None or nxt["color"] != RED:
