    cur_c0 = cur_c1 = target_cols[0]

    for c in target_cols[1:]:
        r0, r1 = _column_interval(mask, c)
        if c == cur_c1 + 1 and (r0, r1) == (cur_r0, cur_r1):
            cur_c1 = c
        else:
            runs.append((cur_r0, cur_c0, cur_r1, cur_c1))
            cur_r0, cur_r1 = r0, r1
            cur_c0 = cur_c1 = c

    runs.append((cur_r0, cur_c0, cur_r1, cur_c1))
