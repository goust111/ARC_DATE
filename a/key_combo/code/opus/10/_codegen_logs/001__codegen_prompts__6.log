+def _sample_symbol_ids(panel_count: int) -> list[int]:
+    symbols = list(GEN_SYMBOL_IDS)
+    if panel_count > len(symbols):
+        extras = [random.choice(GEN_SYMBOL_IDS) for _ in range(panel_count - len(symbols))]
+        symbols.extend(extras)
