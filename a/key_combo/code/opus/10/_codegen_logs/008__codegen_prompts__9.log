    h = rng.integers(min_dim, max_dim + 1)
    w = rng.integers(min_dim, max_dim + 1)
    r0 = rng.integers(0, size - h + 1)
    c0 = rng.integers(0, size - w + 1)
    return (int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1))


