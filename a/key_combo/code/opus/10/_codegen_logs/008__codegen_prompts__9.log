+    edges: set[tuple[int, int]] = set()
+    for a, b in combinations(colors, 2):
+        crossing = frames[a]["mask"] & frames[b]["mask"]
+        for r_raw, c_raw in np.argwhere(crossing):
+            visible = int(workspace[int(r_raw), int(c_raw)])
+            if visible == a:
