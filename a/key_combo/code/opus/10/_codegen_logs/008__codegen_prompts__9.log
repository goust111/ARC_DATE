+
+from itertools import combinations
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+PANEL_ACTIVE_W = 3
+DIVIDER_COL = 4
+WORKSPACE_COL0 = DIVIDER_COL + 1
+PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)
+GEN_ATTEMPTS = 600
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
