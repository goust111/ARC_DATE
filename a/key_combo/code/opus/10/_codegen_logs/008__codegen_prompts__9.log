+    return specs
+
+
+def _paint_panel(grid: np.ndarray, band_specs: list[dict]) -> None:
+    panel = grid[:, DIVIDER_COL - PANEL_ACTIVE_W : DIVIDER_COL]
+    for spec in band_specs:
+        color = int(spec["color"])
+        r0, r1 = int(spec["r0"]), int(spec["r1"])
+        if r0 == r1:
+            panel[r0, :] = color
+            continue
+        if spec["flip"]:
+            panel[r0, 2] = color
+            panel[r1, 0] = color
+        else:
+            panel[r0, 0] = color
+            panel[r1, 2] = color
