+    bands = _parse_bands(grid, divider)
+    frames, order = _parse_frames(grid, divider)
+    ordered_frames = [frames[color] for color in order]
+    band_colors = [_band_color_at_row(bands, frame["center_row"]) for frame in ordered_frames]
