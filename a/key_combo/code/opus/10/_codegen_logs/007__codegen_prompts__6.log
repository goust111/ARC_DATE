+        objects.append(extra)
+
+    grid = _render_objects((h, w), objects)
+    return grid if _input_semantics_ok(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
