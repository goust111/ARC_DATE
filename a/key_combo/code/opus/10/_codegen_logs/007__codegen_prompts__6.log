+    details = _solve_details(g)
+    cover = details["cover"]
+    bordered = details["bordered"]
+    out = details["output"]
+    enclosed = details["enclosed"]
+
+    if not np.any(cover >= 2):
+        return False
+    if not np.any(cover == 1):
+        return False
+    if len(enclosed) < 1:
+        return False
