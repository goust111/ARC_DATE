+        others = set().union(*(objects[j] for j in range(len(objects)) if j != idx))
+        objects[idx] = _add_outward_tail(objects[idx], outward_dir, others, (h, w))
+
+    occupied = set().union(*objects) if objects else set()
+    if want_extra:
