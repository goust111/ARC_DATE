+    blocks: list[dict] = []
+    for color, rows in ((BLUE, blue_rows), (RED, red_rows)):
+        final_edge = 0 if color == BLUE else width - BLOCK_SIZE
+        final_inner = BLOCK_SIZE if color == BLUE else width - 2 * BLOCK_SIZE
