+    if not any(bool(block["inward"]) for block in final_blocks):
+        return False
+
+    parity_by_color: dict[int, set[int]] = defaultdict(set)
+    for block in final_blocks:
+        parity_by_color[int(block["color"])].add(int(block["distance"]) % 2)
