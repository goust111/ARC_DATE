+    blue_has_inward = overlap_color == BLUE or (n_blue == 3 and rng.random() < 0.45)
+
+    blue_rows = _sample_rows_for_side(height, n_blue, blue_has_inward, rng)
+    red_rows = _sample_rows_for_side(height, n_red, red_has_inward, rng)
