+    assert active_rows
+    assert mismatch_rows
+    assert not np.any(g[:, :-1] == COUNTER_COLOR), "grey may only appear in the counter"
+    assert np.all((g == BACKGROUND) | np.isin(g, ACTIVE_COLORS + (COUNTER_COLOR,)))
+    return offset, active_rows, mismatch_rows
