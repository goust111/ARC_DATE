+def _choose_active_rows(marked_rows: list[int]) -> list[int]:
+    max_active = min(ACTIVE_ROWS_MAX, len(marked_rows) - 1)
+    n_active = random.randint(ACTIVE_ROWS_MIN, max_active)
+    return sorted(random.sample(marked_rows, n_active))
