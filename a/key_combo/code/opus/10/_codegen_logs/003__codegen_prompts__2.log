+    n_distinct = random.randint(2, min(len(ACTIVE_COLORS), n_active))
+    base = random.sample(ACTIVE_COLORS, n_distinct)
+    while len(base) < n_active:
+        base.append(random.choice(base))
+    random.shuffle(base)
+    return [int(color) for color in base]
+
+
