+GRID_MAX_SIDE = 16
+OFFSET_MIN = 1
+OFFSET_MAX = 4
+MARKED_ROWS_MIN = 3
+MARKED_ROWS_MAX = 6
+ACTIVE_ROWS_MIN = 1
+ACTIVE_ROWS_MAX = 3
