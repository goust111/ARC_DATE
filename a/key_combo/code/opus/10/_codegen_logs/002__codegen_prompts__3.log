  grid: 7-16 rows x 7-16 cols, always square [observed]
  background: 7 (orange) [observed]; dominant color
  foreground: exactly 1 non-bg color (varies per example)
  objects: all fg pixels form 4-connected monochromatic components
  movers:
    count: 1-3
    area: 4-10 (strictly >3)
    bbox: 2-5 rows x 2-4 cols, density 0.75-1.0
    position: placed in upper portion; enough empty bg rows below for drop
    columns: no column overlap between movers; no column overlap with markers [observed, test_0 has adjacent gap=0]
  markers:
    count: 1-2
    area: 1-3
    position: interspersed among movers in upper rows
  layout: row 0 all bg; all 4 edges all bg [observed]; >=1 bg col gap between most components
  rule: each mover translates straight down until its bbox bottom touches grid bottom row; markers stay fixed; movers cleared from original positions
  constraint: dropped movers must not overlap each other or markers

generation_strategy:
