+    if need > width:
+        return None
+    extras = width - need
+    slots = [0] * (len(sizes) + 1)
+    for _ in range(extras):
+        slots[random.randrange(len(slots))] += 1
+    starts: list[int] = []
+    c = slots[0]
+    for i, side in enumerate(sizes):
+        starts.append(c)
+        c += side
+        if i + 1 < len(sizes):
