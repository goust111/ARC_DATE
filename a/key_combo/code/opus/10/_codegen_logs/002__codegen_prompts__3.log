+def _render(blocks: list[dict], shape: tuple[int, int], *, use_input_rows: bool, mode: str) -> tuple[np.ndarray, dict, list[dict], list[set]]:
+    h, w = shape
+    out = np.zeros((h, w), dtype=int)
