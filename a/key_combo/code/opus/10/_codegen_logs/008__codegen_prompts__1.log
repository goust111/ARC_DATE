+    def search(index: int) -> list[set[tuple[int, int]]] | None:
+        if index == len(sizes):
+            return []
+        size = sizes[index]
+        candidates = []
+        for shape in ORIENTED_SHAPES[size]:
+            shape_h = 1 + max(r for r, _ in shape)
+            shape_w = 1 + max(c for _, c in shape)
+            if shape_h > height or shape_w > width:
+                continue
