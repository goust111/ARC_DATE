+    for r, c, color in emitters:
+        for cc in range(grid.shape[1]):
+            if (r, cc) in crossing_cells and (r, cc) not in emitter_positions:
+                continue
+            if out[r, cc] == BG:
+                out[r, cc] = color
+        for rr in range(grid.shape[0]):
+            if (rr, c) in crossing_cells and (rr, c) not in emitter_positions:
