+def _find_emitters(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    coords = np.argwhere((grid != BG) & (grid != GREY))
+    emitters = [(int(r), int(c), int(grid[r, c])) for r, c in coords]
+    emitters.sort()
