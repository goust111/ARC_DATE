+
+
+def _normalize_shape(coords: np.ndarray) -> np.ndarray:
+    shifted = coords.copy()
+    shifted[:, 0] -= int(shifted[:, 0].min())
+    shifted[:, 1] -= int(shifted[:, 1].min())
