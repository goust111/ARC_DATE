+        for c0, c1 in col_spans:
+            if c0 > c1:
+                continue
+            region = g[r0 : r1 + 1, c0 : c1 + 1]
+            grey_count = int(np.count_nonzero(region == GREY))
+            recolor = RECOLOR_BY_COUNT.get(grey_count, GREY)
