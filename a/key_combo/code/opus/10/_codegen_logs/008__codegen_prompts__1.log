+        c0, c1 = _region_spans(grid.shape[1], col_lines)[cc]
+        mask = out[r0 : r1 + 1, c0 : c1 + 1] == GREY
+        out[r0 : r1 + 1, c0 : c1 + 1][mask] = recolor
+    return out
