+def _grey_components(grid: np.ndarray) -> list[dict]:
+    visited = np.zeros_like(grid, dtype=bool)
+    components = []
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            if visited[r, c] or grid[r, c] != GREY:
+                continue
+            queue = deque([(r, c)])
+            visited[r, c] = True
+            coords = []
+            while queue:
