+def _lines_from_intervals(intervals: list[int]) -> list[int]:
+    lines = []
+    cursor = intervals[0]
+    lines.append(cursor)
+    for size in intervals[1:-1]:
+        cursor += 1 + size
+        lines.append(cursor)
+    return lines
