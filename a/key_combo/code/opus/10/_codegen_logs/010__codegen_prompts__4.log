+    separator_rows, separator_colors = _detect_separator_rows(grid)
+    if not (4 <= len(separator_rows) <= 6):
+        return False
+    if sum(int(c == GREY) for c in separator_colors.values()) < 2:
+        return False
+    if sum(int(c == ORANGE) for c in separator_colors.values()) < 2:
+        return False
