+                    color=int(color),
+                    bbox=(int(r0), int(c0), int(r1), int(c1)),
+                    rel_rows=rel_rows.astype(int),
+                    cols=cols.astype(int),
+                    height=int(r1 - r0 + 1),
+                    top_by_col=top_by_col,
+                    bottom_by_col=bottom_by_col,
