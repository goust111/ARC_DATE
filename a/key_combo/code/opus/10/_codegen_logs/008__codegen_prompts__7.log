0063:             output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
0064:             # Draw the red line from the red pixel to the border
0065:             draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
0066:         elif red_c == c:
0067:             # Extend the green rectangle to the top until it reaches the border
0068:             output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
0069:             # Draw the red line from the red pixel to the border
0070:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
0071:         elif red_c == c + height - 1:
0072:             # Extend the green rectangle to the bottom until it reaches the border
0073:             output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
0074:             # Draw the red line from the red pixel to the border
0075:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
0076:         else:
