0094:             right = patch[:, 3:]
0095:             left_kind = _block_kind(left, bg, marker)
0096:             right_kind = _block_kind(right, bg, marker)
0097:             assert {left_kind, right_kind} == {"marker", "cross"}, "expected one marker and one cross"
0098: 
0099:             if left_kind == "marker":
0100:                 moved[:, 3:] = np.rot90(right, 2)
0101:                 target_r, target_c = int(r0), W - w
0102:             else:
0103:                 moved[:, :3] = np.rot90(left, 2)
0104:                 target_r, target_c = int(r0), 0
0105: 
0106:         elif (h, w) == (6, 3):
0107:             top = patch[:3, :]
0108:             bottom = patch[3:, :]
0109:             top_kind = _block_kind(top, bg, marker)
0110:             bottom_kind = _block_kind(bottom, bg, marker)
0111:             assert {top_kind, bottom_kind} == {"marker", "cross"}, "expected one marker and one cross"
0112: 
0113:             if top_kind == "marker":
0114:                 moved[3:, :] = np.rot90(bottom, 2)
0115:                 target_r, target_c = H - h, int(c0)
0116:             else:
0117:                 moved[:3, :] = np.rot90(top, 2)
0118:                 target_r, target_c = 0, int(c0)
0119: 
0120:         else:
