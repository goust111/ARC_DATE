+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert _get_bg(g) == BG, "expected black background"
+    pivot_r, pivot_c = _find_pivot(g)
+    reflected = _reflect_overlay(g)
+    marker_mask = np.isin(reflected, MARKER_COLORS)
+    out = reflected.copy()
