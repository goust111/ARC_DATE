            if (r, c) in occupied:
                continue
            if _gen_touching_components((r, c), component_sets) == [target_idx]:
                candidates.append((r, c))
    return candidates


def _gen_distractor_candidates(height, width, occupied, component_sets):
    candidates = []
    for r in range(height):
