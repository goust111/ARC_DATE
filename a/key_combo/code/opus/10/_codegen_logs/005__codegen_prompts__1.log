+    if start in goals:
+        return [start]
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cell = q.popleft()
+        for nxt in _neighbors4(*cell):
+            if nxt not in allowed or nxt in parent:
+                continue
+            parent[nxt] = cell
+            if nxt in goals:
