+        r = int(r_raw)
+        c = int(c_raw)
+        rr, cc = _reflect_cell(r, c, pivot_r, pivot_c)
+        assert _in_bounds(out.shape, rr, cc), "reflected cell must stay in-bounds"
+        out[rr, cc] = int(out[r, c])
+    return out
