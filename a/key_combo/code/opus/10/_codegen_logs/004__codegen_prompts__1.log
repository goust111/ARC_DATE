def _gen_split(length: int, rng: np.random.Generator) -> int:
    lo = max(1, int(np.ceil(length * _GEN_SPLIT_MIN_RATIO)))
    hi = min(length - 1, int(np.floor(length * _GEN_SPLIT_MAX_RATIO)))
    choices = np.arange(lo, hi + 1)
