+        "lower": lower,
+        "upper_edge": upper_edge,
+        "lower_edge": lower_edge,
+    }
+    return inp, out, meta
+
+
+def _is_outer(cell: tuple[int, int], rows: int, cols: int) -> bool:
+    r, c = cell
