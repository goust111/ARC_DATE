        if 0 <= rr < h and 0 <= cc < w:
            out.append((rr, cc))
    return out


def _gen_grow_source(
    seed: set[Cell],
    blocked: set[Cell],
    h: int,
    w: int,
    target_n: int,
) -> set[Cell] | None:
    cells = set(seed)
    while len(cells) < target_n:
        frontier = sorted(
            {
                nbr
                for r, c in cells
                for nbr in _gen_neighbors4(r, c, h, w)
                if nbr not in cells and nbr not in blocked
            }
        )
        if not frontier:
            return None
        cells.add(random.choice(frontier))
    return cells


