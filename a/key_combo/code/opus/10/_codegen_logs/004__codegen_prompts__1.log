    inp = out.copy()
    inp[out == Color.TEAL] = background[out == Color.TEAL]

    candidates = _candidate_wedges(inp)
    if sorted(candidates) != sorted(placed):
        return None

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


