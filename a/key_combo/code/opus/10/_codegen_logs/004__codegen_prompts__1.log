    for rows in range(4, 7)
    for cols in range(rows + 2, 9)
    for cell_h in range(CELL_MIN, CELL_MAX + 1)
    for cell_w in range(CELL_MIN, CELL_MAX + 1)
    for start_col in range(1, max(1, cols - rows))
