+
+
+def _extract_regions(grid: np.ndarray) -> tuple[list[dict[str, object]], dict[tuple[int, int], dict[str, object]], list[int], list[int]]:
+    row_dividers = _constant_divider_rows(grid)
+    col_dividers = _constant_divider_cols(grid)
