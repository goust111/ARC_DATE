+    domino_cells: set[tuple[int, int]] = set()
+    direction: tuple[int, int] | None = None
+    if mixed_dominoes:
+        domino_cells = set(mixed_dominoes[0])
+        direction = _direction_from_domino(region, mixed_dominoes[0])
