+    candidate_donors = [rid for rid in region_ids if _region_neighbors(rid[0], rid[1], rows, cols)]
+    random.shuffle(candidate_donors)
+    donors: list[tuple[int, int]] = candidate_donors[:donor_goal]
+    if len(donors) != donor_goal:
