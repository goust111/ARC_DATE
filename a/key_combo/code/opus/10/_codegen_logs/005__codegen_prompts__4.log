+def _pick_cells(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    if len(candidates) < count:
+        return None
+    random.shuffle(candidates)
+    return [(int(r), int(c)) for r, c in candidates[:count]]
