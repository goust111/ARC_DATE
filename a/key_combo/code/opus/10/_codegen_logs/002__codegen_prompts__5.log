+                    overlap_pairs.add((i, j))
+    if len(overlap_pairs) < 2:
+        return False
+
+    feedback = any(
+        meta["survivors"][i] and meta["pre_neighbor_counts"][i] > meta["post_neighbor_counts"][i]
+        for i in range(len(markers))
+    )
