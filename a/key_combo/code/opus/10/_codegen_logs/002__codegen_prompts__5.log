    assert len(panel_shapes) == 1
    height, width = next(iter(panel_shapes))

    out = np.full((height, width), blank, dtype=int)
    for r0, c0, r1, c1 in boxes:
        patch = g[r0 : r1 + 1, c0 : c1 + 1]
        assert patch.shape == (height, width)
