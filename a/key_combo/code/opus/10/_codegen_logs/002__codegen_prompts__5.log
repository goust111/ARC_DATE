+def _analyze(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    markers = []
+    for r, c in np.argwhere(g != 0):
+        markers.append(
+            {
+                "row": int(r),
+                "col": int(c),
+                "color": int(g[r, c]),
+            }
+        )
+
+    for marker in markers:
+        halo = _halo_cells(g.shape, marker["row"], marker["col"])
+        marker["halo"] = halo
+        marker["halo_set"] = set(halo)
