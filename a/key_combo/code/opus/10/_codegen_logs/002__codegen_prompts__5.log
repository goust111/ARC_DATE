+def _contact_pixel_count(halo: tuple[tuple[int, int], ...], other_union: set[tuple[int, int]]) -> int:
+    count = 0
+    for r, c in halo:
+        if any((r + dr, c + dc) in other_union for dr, dc in DIR4):
+            count += 1
+    return count
+
