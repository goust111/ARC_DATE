+YELLOW = 4
+ORANGE = 7
+DIVIDER_COLORS = {YELLOW, ORANGE}
+REGION_COLORS = [1, 2, 3, 5, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
