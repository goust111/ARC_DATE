+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+ORANGE = 7
+DIVIDER_COLORS = {YELLOW, ORANGE}
+REGION_COLORS = [1, 2, 3, 5, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _monochrome_components(grid: np.ndarray) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(set(map(int, np.unique(grid))) - {BLACK, YELLOW, ORANGE}):
+        for coords in _components_from_mask(grid == color):
+            comps.append({"color": color, "coords": coords})
