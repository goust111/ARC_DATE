+
+
+def _sector_components(divider_grid: np.ndarray) -> list[np.ndarray]:
+    sectors = _components_from_mask(~np.isin(divider_grid, sorted(DIVIDER_COLORS)))
+    sectors.sort(key=lambda coords: tuple(coords.mean(axis=0)))
