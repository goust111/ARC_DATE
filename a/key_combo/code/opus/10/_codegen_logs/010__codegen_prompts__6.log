    if not _density_ok(fg_cells, area):
        return None
    _, region_count = label_mask(grid == bg, connectivity=4)
    if region_count != expected_regions:
        return None
    expected = np.full((expected_regions, 1), bg, dtype=int)
    try:
        actual = main(grid)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    return grid


