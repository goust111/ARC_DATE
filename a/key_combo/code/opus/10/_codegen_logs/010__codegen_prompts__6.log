+        g[cr, :] = ORANGE
+        g[cr:, cc] = ORANGE
+        extra_needed = region_count - 3
+        top_candidates: list[tuple[str, int]] = []
+        other_candidates: list[tuple[str, int]] = []
+        left_cols = list(range(2, cc - 2))
