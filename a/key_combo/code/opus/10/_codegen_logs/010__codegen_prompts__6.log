# Canvas and palette.
GRID_SHAPE = (8, 8)
GRID_ROWS, GRID_COLS = GRID_SHAPE
MIN_COL, MAX_COL = 0, GRID_COLS - 1
EMPTY_COLOR = -1
YELLOW_COLOR, ORANGE_COLOR = Color.YELLOW, Color.ORANGE
DIVIDER_COLORS = (YELLOW_COLOR, ORANGE_COLOR)
AVAILABLE_MOVING_COLORS = [0, 1, 2, 3, 5, 6, 8, 9]

