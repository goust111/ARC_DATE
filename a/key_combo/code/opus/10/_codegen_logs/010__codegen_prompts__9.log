+        assert len(source_rows) == len(seq)
+        for r, color in zip(source_rows, seq):
+            inp[int(r), center] = int(color)
+    return inp
+
+
+def _expected_output_from_input(inp: np.ndarray) -> np.ndarray:
+    return main(inp)
+
