+        slit_candidates.append(("R", r))
+
+    combos = []
+    k = piece_count
+    items = list(slit_candidates)
+    for i in range(len(items)):
+        for j in range(i + 1, len(items)):
+            pass
+    import itertools
+
+    for slits in itertools.combinations(items, k):
