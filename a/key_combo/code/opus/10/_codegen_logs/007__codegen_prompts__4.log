def _gen_grow_sprite_cells(cells, h, w):
    area = h * w
    min_fg = max(len(cells), math.ceil(_GEN_MIN_DENSITY * area))
    max_fg = math.floor(_GEN_MAX_DENSITY * area)
    if min_fg > max_fg:
