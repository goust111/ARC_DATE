import numpy as np
from collections import deque
import random

def comps(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                q=deque([(r,c)]); seen[r,c]=1; cur=[]
                while q:
                    x,y=q.popleft(); cur.append((x,y))
                    for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; q.append((nx,ny))
                out.append(cur)
    return out

def enclosed(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    q=deque()
    bg=~mask
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    while q:
        x,y=q.popleft()
        for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W and bg[nx,ny] and not seen[nx,ny]:
                seen[nx,ny]=1; q.append((nx,ny))
    return int((bg & ~seen).sum())

def try_trim():
    hh=ww=2
    H,W=hh+6,ww+6
    g=np.ones((H,W),dtype=bool)
    g[3:3+hh,3:3+ww]=0
    slits=[('T',3),('B',3),('R',3)]
    for typ,p in slits:
      if typ=='T': g[0:3,p]=0
      if typ=='B': g[H-3:H,p]=0
      if typ=='L': g[p,0:3]=0
      if typ=='R': g[p,W-3:W]=0
    cs=[set(c) for c in comps(g)]
    cs=sorted(cs,key=len)
    big=cs[-1]
    small=cs[:-1]
    hole={(r,c) for r in range(3,3+hh) for c in range(3,3+ww)}
    slitcells=set()
    for typ,p in slits:
      if typ=='T': slitcells|={(r,p) for r in range(3)}
      if typ=='B': slitcells|={(H-1-r,p) for r in range(3)}
      if typ=='L': slitcells|={(p,c) for c in range(3)}
      if typ=='R': slitcells|={(p,W-1-c) for c in range(3)}
    target=15
    big=set(big)
    while len(big)>target:
      cand=[]
      for cell in list(big):
        r,c=cell
        if any(abs(r-sr)+abs(c-sc)<=1 for sr,sc in slitcells):
          continue
        if any(abs(r-hr)+abs(c-hc)==1 for hr,hc in hole):
          continue
        deg=sum((r+dr,c+dc) in big for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)])
        if deg<=1: score=0
        elif deg==2: score=1
        else: score=2
        cand.append((score,cell))
      cand.sort()
      removed=False
      for _,cell in cand:
        test=big-{cell}
        if len(comps(np.array([[ (r,c) in test for c in range(W)] for r in range(H)],dtype=bool)))"'!=1:
          continue
        union=set().union(*small,test)
        mask=np.array([[ (r,c) in union for c in range(W)] for r in range(H)],dtype=bool)
        if enclosed(mask)<=0:
          continue
        big=test
        removed=True
        break
      if not removed:
        return False,len(big)
    union=set().union(*small,big)
    mask=np.array([[ (r,c) in union for c in range(W)] for r in range(H)],dtype=bool)
    print('"'success sizes',sorted([len(s) for s in small]+[len(big)]),'hole',enclosed(mask))
    for r in range(H):
      print(''.join('#' if (r,c) in union else '.' for c in range(W)))
    return True,len(big)
for _ in range(5):
  print(try_trim())
