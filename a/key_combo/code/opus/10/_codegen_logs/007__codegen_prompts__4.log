+def _frame_mask(hole_h: int, hole_w: int) -> np.ndarray:
+    h = hole_h + 6
+    w = hole_w + 6
+    mask = np.ones((h, w), dtype=bool)
+    mask[3 : 3 + hole_h, 3 : 3 + hole_w] = False
