    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                q=deque([(r,c)]); seen[r,c]=1; cur=[]
                while q:
                    x,y=q.popleft(); cur.append((x,y))
                    for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=1; q.append((nx,ny))
                out.append(cur)
    return out

def gen(hh,ww):
    H,W=hh+6,ww+6
    cands=[]
    for p in range(3,3+ww): cands += [('T',p),('B',p)]
    for p in range(3,3+hh): cands += [('L',p),('R',p)]
    for k in [3,4]:
        print('hole',hh,ww,'k',k)
        found=0
        for slits in itertools.combinations(cands,k):
            g=np.ones((H,W),dtype=int); g[3:3+hh,3:3+ww]=0
            for typ,p in slits:
                if typ=='T': g[0:3,p]=0
                if typ=='B': g[H-3:H,p]=0
                if typ=='L': g[p,0:3]=0
                if typ=='R': g[p,W-3:W]=0
            sizes=sorted(map(len,comps(g==1)))
            if len(sizes)==3 and min(sizes)>=8 and max(sizes)<=15:
                print(' ',slits,sizes)
                found+=1
                if found>=10: break
        print('found',found)
for hh,ww in [(1,1),(1,2),(2,1),(2,2)]: gen(hh,ww)
