+    grid = np.zeros(shape, dtype=int)
+    for comp in components:
+        for r, c in comp:
+            grid[r, c] = GREY
+
+    for color, (kind, pos) in zip(colors, active_slits):
+        a, b = _marker_pair(kind, pos, shape)
+        owner_a = owner_b = None
+        for idx, comp in enumerate(components):
+            if a in comp:
