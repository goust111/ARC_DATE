+    marker_slits = list(slits)
+    omitted = rng.randrange(len(marker_slits))
+    active_slits = [slit for i, slit in enumerate(marker_slits) if i != omitted]
+    colors = list(rng.sample(MARKER_POOL, len(active_slits)))
