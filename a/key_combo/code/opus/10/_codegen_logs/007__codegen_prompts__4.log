+        for color, (local_pos, direction) in obj["markers"].items():
+            lr, lc = local_pos
+            abs_pos = (obj["bbox"][0] + lr, obj["bbox"][1] + lc)
+            occurrences.setdefault(color, []).append(
+                {"obj": obj["id"], "local": local_pos, "dir": direction, "abs": abs_pos}
+            )
