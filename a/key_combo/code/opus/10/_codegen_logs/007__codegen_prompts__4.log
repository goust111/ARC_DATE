+
+def _optional_trim(
+    components: list[set[tuple[int, int]]],
+    protected: set[tuple[int, int]],
+    hole: set[tuple[int, int]],
+    rng: random.Random,
+) -> bool:
+    for idx in range(len(components)):
+        extra = rng.randint(0, 2)
+        for _ in range(extra):
