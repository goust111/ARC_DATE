+        a_obj, b_obj = int(a["obj"]), int(b["obj"])
+        a_off = offsets[a_obj]
+        b_off = offsets[b_obj]
+        a_pos = (a_off[0] + a["local"][0], a_off[1] + a["local"][1])
+        b_pos = (b_off[0] + b["local"][0], b_off[1] + b["local"][1])
+        target_b = (a_pos[0] + a["dir"][0], a_pos[1] + a["dir"][1])
