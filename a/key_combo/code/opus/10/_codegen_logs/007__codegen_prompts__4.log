+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(600):
+        local = _build_local_layout(rng)
+        if local is None:
+            continue
+        inp = _scatter_sprites(local, rng)
+        if inp is None:
+            continue
+        try:
+            out = main(inp)
+        except Exception:
+            continue
+        if _validate_semantics(inp, out):
