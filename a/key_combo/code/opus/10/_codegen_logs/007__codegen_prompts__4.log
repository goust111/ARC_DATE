+                    continue
+                deg = sum((r + dr, c + dc) in comp for dr, dc in DIR4)
+                if deg > 2:
+                    continue
+                candidates.append(cell)
+            rng.shuffle(candidates)
+            for cell in candidates:
+                if _remove_cell_if_valid(components, idx, cell):
+                    break
+    return True
