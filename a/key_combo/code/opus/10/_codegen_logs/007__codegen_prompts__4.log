+            return True
+    return False
+
+
+def _render_components(shape: tuple[int, int], components: list[set[tuple[int, int]]]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for comp in components:
+        for r, c in comp:
+            out[r, c] = GREY
+    return out
+
+
+def _remove_cell_if_valid(
