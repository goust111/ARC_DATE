+    if np.any((out != BLACK) & (out != GREY) & (out != YELLOW)):
+        return False
+
+    order = _marker_color_order(inp)
+    if len(order) != len(color_counts):
+        return False
+    for color in order:
+        try:
+            weakened = _fill_enclosed(_assemble_grey(inp, {color}) == GREY)
+        except Exception:
+            continue
+        if np.array_equal(weakened, out):
+            return False
+    return True
