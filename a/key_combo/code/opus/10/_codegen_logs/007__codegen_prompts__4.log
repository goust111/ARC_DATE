+    assembled = np.zeros_like(g)
+    for obj in objects:
+        r0, c0 = offsets[obj["id"]]
+        for rr, cc in np.argwhere(obj["mask"]):
+            tr = r0 + int(rr)
+            tc = c0 + int(cc)
+            assert 0 <= tr < g.shape[0] and 0 <= tc < g.shape[1]
+            assembled[tr, tc] = GREY
+    return assembled
