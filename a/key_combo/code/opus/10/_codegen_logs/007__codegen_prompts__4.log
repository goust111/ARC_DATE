+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+YELLOW = 4
+MARKER_POOL = (1, 2, 3, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
