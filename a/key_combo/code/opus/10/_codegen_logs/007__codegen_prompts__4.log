+    return True
+
+
+def _trim_component(
+    components: list[set[tuple[int, int]]],
+    comp_index: int,
+    target_size: int,
+    protected: set[tuple[int, int]],
+    hole: set[tuple[int, int]],
+    rng: random.Random,
