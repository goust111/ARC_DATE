+    return (pos - 1, w - 2), (pos + 1, w - 2)
+
+
+def _hole_cells(hole_h: int, hole_w: int) -> set[tuple[int, int]]:
+    return {(r, c) for r in range(3, 3 + hole_h) for c in range(3, 3 + hole_w)}
+
+
+def _cell_is_outer(mask: np.ndarray, r: int, c: int) -> bool:
