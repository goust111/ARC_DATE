+    if kind == "L":
+        return [(pos, c) for c in range(3)]
+    return [(pos, w - 1 - c) for c in range(3)]
+
+
+def _marker_pair(kind: str, pos: int, shape: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    h, w = shape
+    if kind == "T":
+        return (1, pos - 1), (1, pos + 1)
+    if kind == "B":
+        return (h - 2, pos - 1), (h - 2, pos + 1)
+    if kind == "L":
