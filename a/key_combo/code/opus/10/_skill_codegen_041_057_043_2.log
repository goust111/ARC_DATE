+def _gen_channel_path(h: int, w: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
+    hdir = int(rng.choice([-1, 1]))
+    turns = int(rng.integers(2, 5))
+    directions = [(1, 0)] + [((0, hdir) if i % 2 == 0 else (1, 0)) for i in range(turns)]
