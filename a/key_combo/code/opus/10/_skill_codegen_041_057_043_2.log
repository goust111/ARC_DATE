+def _is_thin_component(mask: np.ndarray) -> bool:
+    comps = _components(mask, connectivity=4)
+    if len(comps) != 1:
+        return False
+    cells = {tuple(map(int, xy)) for xy in comps[0]}
+    for r, c in cells:
+        degree = 0
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            degree += (nr, nc) in cells
+        if degree > 2:
+            return False
+    return True
