+    else:
+        lo, hi = c_min + total_h, c_max
+    if lo > hi:
+        return None
+    start_c = int(rng.integers(lo, hi + 1))
+
+    path = [(start_r, start_c)]
+    vi = 0
+    hi = 0
+    for dr, dc in directions:
+        steps = v_steps[vi] if dr else h_steps[hi]
+        if dr:
+            vi += 1
+        else:
+            hi += 1
+        r, c = path[-1]
+        for _ in range(steps):
+            r += dr
+            c += dc
+            path.append((r, c))
