+from __future__ import annotations
+
+import itertools
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+TOGGLE = np.arange(10, dtype=int)
+TOGGLE[BLACK] = TEAL
+TOGGLE[TEAL] = BLACK
+TOGGLE[PINK] = ORANGE
+TOGGLE[ORANGE] = PINK
