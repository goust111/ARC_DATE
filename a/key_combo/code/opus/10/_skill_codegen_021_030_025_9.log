from __future__ import annotations

from collections import defaultdict

import numpy as np

from arc_utils import find_components, get_bg, paste
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move the repeated boundary color's rectangles one block inward while leaving singleton boundary rectangles in place.

    Input structure:
    - The background is the most common color.
    - Foreground objects are solid monochrome rectangles touching a grid corner.
    - Exactly one foreground color appears as multiple separate 4-connected objects; other colors appear once.

    Rule:
    - Clear the multiple objects of the repeated color from their original positions.
    - For each cleared rectangle, translate it away from the row and column border it touches by exactly its height and width.
    - Keep singleton-color objects unchanged; overlapping translated rectangles of the same color merge.

    Key insight:
    - Multiplicity selects the moving color, and each boundary rectangle's touched edges determine its inward diagonal translation.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))

    by_color: dict[int, list[dict]] = defaultdict(list)
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        by_color[int(comp["color"])].append(comp)

    moving_colors = [color for color, comps in by_color.items() if len(comps) > 1]
    assert len(moving_colors) == 1
    moving_color = int(moving_colors[0])
    moving_objects = by_color[moving_color]

    out = g.copy()
    for comp in moving_objects:
        coords = comp["coords"]
        out[coords[:, 0], coords[:, 1]] = bg

    for comp in moving_objects:
        coords = comp["coords"]
        r0, c0, r1, c1 = map(int, comp["bbox"])
        height = int(r1 - r0 + 1)
        width = int(c1 - c0 + 1)
        assert int(comp["area"]) == height * width

        touches_top = r0 == 0
        touches_bottom = r1 == H - 1
        touches_left = c0 == 0
        touches_right = c1 == W - 1
        assert touches_top != touches_bottom
        assert touches_left != touches_right

        dr = height if touches_top else -height
        dc = width if touches_left else -width
        shifted = coords + np.array([dr, dc], dtype=int)
        assert bool(
            np.all(
                (0 <= shifted[:, 0])
                & (shifted[:, 0] < H)
                & (0 <= shifted[:, 1])
                & (shifted[:, 1] < W)
            )
        )

        target = out[shifted[:, 0], shifted[:, 1]]
        assert bool(np.all((target == bg) | (target == moving_color)))
        out[shifted[:, 0], shifted[:, 1]] = moving_color

    return out

# --------------- generator (o5x) ---------------

# Corner and movement model.
CORNERS = ("TL", "TR", "BL", "BR")
DIAGONAL_PAIRS = ({"TL", "BR"}, {"TR", "BL"})
INWARD_STEP_FACTOR = 2
COMPACT_CANVAS_FACTOR = 3

# Canvas, object count, and retry bounds.
GRID_ROW_BOUNDS = (7, 22)
GRID_COL_BOUNDS = (7, 30)
SQUARE_SIZE_BOUNDS = (1, 4)
MOVING_COUNT_BOUNDS = (2, 4)
GENERATION_RETRIES = 300

# Color palette.
COLOR_VALUES = tuple(range(10))

def _corner_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = 0 if corner[0] == "T" else H - s
    col = 0 if corner[1] == "L" else W - s
    return row, col


def _shifted_pos(corner: str, H: int, W: int, s: int) -> tuple[int, int]:
    row = s if corner[0] == "T" else H - INWARD_STEP_FACTOR * s
    col = s if corner[1] == "L" else W - INWARD_STEP_FACTOR * s
    return row, col


def _valid_sizes(s: int, moving_count: int) -> list[tuple[int, int]]:
    sizes = []
    min_h = max(GRID_ROW_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    min_w = max(GRID_COL_BOUNDS[0], INWARD_STEP_FACTOR * s + 1)
    for H in range(min_h, GRID_ROW_BOUNDS[1] + 1):
        for W in range(min_w, GRID_COL_BOUNDS[1] + 1):
            bg_area = H * W - len(CORNERS) * s * s
            if bg_area <= moving_count * s * s:
                continue
            compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
            if moving_count == MOVING_COUNT_BOUNDS[1] - 1 and compact:
                continue
            sizes.append((H, W))
    return sizes


def _pick_moving_corners(H: int, W: int, s: int, moving_count: int) -> set[str]:
    if moving_count == len(CORNERS):
        return set(CORNERS)
    compact = H < COMPACT_CANVAS_FACTOR * s and W < COMPACT_CANVAS_FACTOR * s
    if moving_count == MOVING_COUNT_BOUNDS[0] and compact:
        return set(random.choice(DIAGONAL_PAIRS))
    return set(random.sample(CORNERS, moving_count))


def _overlaps(a: tuple[int, int], b: tuple[int, int], s: int) -> bool:
    ar, ac = a
    br, bc = b
    return ar < br + s and br < ar + s and ac < bc + s and bc < ac + s


def _sample_layout():
    """Return a collision-free layout tuple, or None when the sampled size cannot work."""
    s = random.randint(*SQUARE_SIZE_BOUNDS)
    moving_count = random.randint(*MOVING_COUNT_BOUNDS)
    sizes = _valid_sizes(s, moving_count)
    if not sizes:
        return None
    H, W = random.choice(sizes)

    moving = _pick_moving_corners(H, W, s, moving_count)
    singletons = [corner for corner in CORNERS if corner not in moving]

    shifted = {corner: _shifted_pos(corner, H, W, s) for corner in moving}
    singleton_pos = {corner: _corner_pos(corner, H, W, s) for corner in singletons}
    for moved_pos in shifted.values():
        for kept_pos in singleton_pos.values():
            if _overlaps(moved_pos, kept_pos, s):
                return None
    return H, W, s, moving, singletons, shifted, singleton_pos


def _sample_colors(singleton_count: int) -> tuple[int, int, list[int]]:
    colors = list(COLOR_VALUES)
    bg = random.choice(colors)
    colors.remove(bg)
    moving_color = random.choice(colors)
    colors.remove(moving_color)
    singleton_colors = random.sample(colors, singleton_count)
    return bg, moving_color, singleton_colors


def _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors):
    """Render the matching input/output grids for an accepted layout and palette."""
    rect = np.full((s, s), moving_color, dtype=int)
    out = np.full((H, W), bg, dtype=int)
    for corner in moving:
        paste(out, rect, *shifted[corner])
    for corner, color in zip(singletons, singleton_colors):
        patch = np.full((s, s), color, dtype=int)
        paste(out, patch, *singleton_pos[corner])

    inp = out.copy()
    for corner in moving:
        r, c = shifted[corner]
        inp[r : r + s, c : c + s] = bg
    for corner in moving:
        paste(inp, rect, *_corner_pos(corner, H, W, s))
    return inp, out


def _gen_attempt() -> np.ndarray | None:
    layout = _sample_layout()
    if layout is None:
        return None
    H, W, s, moving, singletons, shifted, singleton_pos = layout
    bg, moving_color, singleton_colors = _sample_colors(len(singletons))
    inp, out = _render_pair(H, W, s, bg, moving_color, moving, singletons, shifted, singleton_pos, singleton_colors)
    try:
        return inp if np.array_equal(main(inp), out) else None
    except AssertionError:
        return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 22208ba4 input")
from __future__ import annotations

import numpy as np

from arc_utils import get_bg, paste
import random


def _constant_non_bg_rows(g: np.ndarray, bg: int) -> list[int]:
    return [
        int(r)
        for r in range(g.shape[0])
        if bool(np.all(g[r, :] == g[r, 0])) and int(g[r, 0]) != int(bg)
    ]


def _cell_signature(g: np.ndarray, r0: int, c0: int, size: int, bg: int) -> tuple[tuple[int, int, int], ...] | None:
    cell = g[int(r0) : int(r0) + int(size), int(c0) : int(c0) + int(size)]
    mask = cell != int(bg)
    if not bool(mask.any()):
        return None
    return tuple(
        (int(r), int(c), int(cell[r, c]))
        for r, c in zip(*np.where(mask), strict=False)
    )


def main(grid: np.ndarray) -> np.ndarray:
    """
    Look up query glyphs in a reference table and mark whether they form a line.

    Input structure:
    - Teal background with two full-width pink separator rows.
    - Above the first separator is a query row of 5x5 glyph cells.
    - Between separators is a reference table of the same 5x5 cells; a glyph is
      identified by both its color and its 3x3 shape.

    Rule:
    - Green-fill the background inside every table cell whose glyph exactly
      appears in the query row.
    - If the matched table cells form one complete row or one complete column,
      also green-fill the query band and the bottom verdict band.
    - Otherwise leave the query band unchanged and fill the bottom verdict band red.

    Key insight: The bottom color is not a count; it is the yes/no answer to
    whether the queried glyphs align as a full row or column in the table.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)
    cell_size = 5

    sep_rows = _constant_non_bg_rows(g, bg)
    assert len(sep_rows) >= 2, "expected two full-width separator rows"
    top_sep = sep_rows[0]
    bottom_sep = sep_rows[-1]

    table_region = g[top_sep + 1 : bottom_sep, :]
    table_fg = np.argwhere(table_region != bg)
    assert table_fg.size, "reference table must contain glyphs"

    first_glyph_r = top_sep + 1 + int(table_fg[:, 0].min())
    first_glyph_c = int(table_fg[:, 1].min())
    row0 = first_glyph_r - 1
    col0 = first_glyph_c - 1

    row_starts = list(range(row0, bottom_sep, cell_size))
    row_starts = [r for r in row_starts if r + cell_size <= bottom_sep]
    col_starts = list(range(col0, w, cell_size))
    col_starts = [c for c in col_starts if c + cell_size <= w]
    assert row_starts and col_starts, "could not infer table cell grid"

    query_sigs = [
        sig
        for c in col_starts
        if (sig := _cell_signature(g, 0, c, cell_size, bg)) is not None
    ]
    query_set = set(query_sigs)
    assert len(query_sigs) == len(query_set), "query glyphs should be distinct"

    out = g.copy()
    selected: list[tuple[int, int]] = []
    for ri, r in enumerate(row_starts):
        for ci, c in enumerate(col_starts):
            if _cell_signature(g, r, c, cell_size, bg) not in query_set:
                continue
            selected.append((int(ri), int(ci)))
            cell = out[r : r + cell_size, c : c + cell_size]
            cell[cell == bg] = 3

    complete_query = len(query_sigs) == len(col_starts)
    same_row = len({r for r, _c in selected}) == 1
    same_col = len({c for _r, c in selected}) == 1
    success = complete_query and len(selected) == len(query_sigs) and (same_row or same_col)

    if success:
        query_band = out[:top_sep, :]
        query_band[query_band == bg] = 3
        out[bottom_sep + 1 :, :] = 3
    else:
        out[bottom_sep + 1 :, :] = 2

    return out

# --------------- generator (o5x) ---------------

# -- Grid layout --
GRID_H, GRID_W = 30, 22       # fixed canvas size
TOP_SEP_ROW = 5                # query-band separator row
BOTTOM_SEP_ROW = 27            # table-bottom separator row
QUERY_BAND_H = 5               # height of query band (rows 0..4)
VERDICT_ROW = 28               # verdict band starts here

# -- Colors --
BG = 8                         # teal background
GREEN = 3                      # success / match highlight
RED = 2                        # fail verdict
SEP = 6                        # separator row color
GLYPH_COLORS = (0, 1, 2, 4, 5, 6, 7, 9)  # 8 available glyph colors

# -- Table geometry --
TABLE_DIM = 4                  # 4x4 grid of cells
CELL = 5                       # each cell is 5x5
ROWS = (7, 12, 17, 22)        # row offsets for 4 table rows
COLS = (1, 6, 11, 16)         # col offsets for 4 table columns

# -- Glyph shape --
FILL_MIN, FILL_MAX = 5, 9     # filled-pixel range per 3x3 glyph
SHAPE_BASE_COUNTS = {5: 2, 6: 2, 7: 2, 8: 2, 9: 1}  # min shapes per fill-count
MAX_SHAPES_PER_FILL = 5       # cap during random top-up

# -- Color distribution --
COLOR_MIN, COLOR_MAX = 1, 3   # each color used 1-3 times across 16 cells

# -- Outcome probabilities --
P_SUCCESS = 0.4               # chance of success outcome
P_QUERY_3 = 0.35              # chance of 3-query fail (vs 4-query fail)
FAIL_MODES = ("rect", "bent_row", "bent_col", "scatter_rows", "scatter_cols")

# -- Generation --
MAX_RETRIES = 300


def _has_full_bbox(mask: int) -> bool:
    """True if the 3x3 bitmask spans all four edges (non-empty top/bottom/left/right rows)."""
    bits = [(mask >> i) & 1 for i in range(9)]
    return (
        any(bits[0:3])
        and any(bits[6:9])
        and any(bits[i] for i in (0, 3, 6))
        and any(bits[i] for i in (2, 5, 8))
    )


PATTERNS_BY_FILL = {
    k: tuple(m for m in range(1 << 9) if m.bit_count() == k and _has_full_bbox(m))
    for k in range(FILL_MIN, FILL_MAX + 1)
}


def _balanced_color_list() -> list[int]:
    """Assign 16 colors (one per cell) so each of the 8 palette colors appears 1-3 times."""
    counts = {c: COLOR_MIN for c in GLYPH_COLORS}
    extras = TABLE_DIM * TABLE_DIM - len(GLYPH_COLORS) * COLOR_MIN  # 16 - 8 = 8
    for _ in range(extras):
        choices = [c for c in GLYPH_COLORS if counts[c] < COLOR_MAX]
        counts[random.choice(choices)] += 1
    colors = [c for c, n in counts.items() for _ in range(n)]
    random.shuffle(colors)
    return colors


def _balanced_shape_masks() -> list[int]:
    """Pick 16 distinct 3x3 shape masks with a balanced distribution of fill counts."""
    counts = dict(SHAPE_BASE_COUNTS)
    extras = TABLE_DIM * TABLE_DIM - sum(counts.values())  # 16 - 9 = 7
    for _ in range(extras):
        choices = [k for k in range(FILL_MIN, FILL_MAX) if counts[k] < MAX_SHAPES_PER_FILL]
        counts[random.choice(choices)] += 1

    masks: list[int] = []
    for k, n in counts.items():
        masks.extend(random.sample(PATTERNS_BY_FILL[k], n))
    random.shuffle(masks)
    return masks


def _glyph(mask: int, color: int) -> np.ndarray:
    """Render a 3x3 bitmask as a CELL x CELL array with 1-pixel border of BG."""
    cell = np.full((CELL, CELL), BG, dtype=int)
    bits = np.array([(mask >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)
    cell[1:4, 1:4][bits] = color
    return cell


def _line_cells() -> list[tuple[int, int]]:
    """Pick a complete row or column of 4 cells (shuffled order)."""
    if random.random() < 0.5:
        r = random.randrange(TABLE_DIM)
        cells = [(r, c) for c in range(TABLE_DIM)]
    else:
        c = random.randrange(TABLE_DIM)
        cells = [(r, c) for r in range(TABLE_DIM)]
    random.shuffle(cells)
    return cells


def _fail_cells(count: int) -> list[tuple[int, int]]:
    """Pick `count` distinct cells that do NOT all share a single row or column."""
    if count == 3:
        rs = random.sample(range(TABLE_DIM), random.choice((2, 3)))
        cs = random.sample(range(TABLE_DIM), random.choice((2, 3)))
        cells = [(rs[0], cs[0]), (rs[1], cs[1])]
        pool = [(r, c) for r in rs for c in cs if (r, c) not in cells]
        cells.append(random.choice(pool))
    else:
        mode = random.choice(FAIL_MODES)
        if mode == "rect":
            rs = random.sample(range(TABLE_DIM), 2)
            cs = random.sample(range(TABLE_DIM), 2)
