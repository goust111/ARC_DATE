+from __future__ import annotations
+
+from collections import defaultdict
+import random
+
+import numpy as np
+
+
+RED = 2
+GREEN = 3
+PINK = 6
+TEAL = 8
+BLACK = 0
+
+CELL = 5
+TABLE_DIM = 3
+QUERY_H = 5
+TABLE_H = TABLE_DIM * CELL
+SEP1_ROW = QUERY_H
+TABLE_ROW0 = SEP1_ROW + 1
+SEP2_ROW = TABLE_ROW0 + TABLE_H
+VERDICT_H = 1
+RED_BAND_H = 2
