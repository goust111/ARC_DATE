+
+def _safe_wall_segment(
+    cells: list[Coord],
+    shape: tuple[int, int],
+    occupied: set[Coord],
+    line_cells: set[Coord],
+    controls: set[Coord],
+) -> bool:
+    h, w = shape
+    if not cells:
+        return False
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
