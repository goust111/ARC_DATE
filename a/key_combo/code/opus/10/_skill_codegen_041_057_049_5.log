+    assert len(mapped) == len(set(mapped)), "scaled bars must stay distinct"
+    return mapped
+
+
+def _draw_rectilinear(grid: np.ndarray, box: BBox, rows: list[int], cols: list[int], color: int) -> None:
+    r0, c0, r1, c1 = box
+    for r in rows:
+        grid[r, c0 : c1 + 1] = color
+    for c in cols:
