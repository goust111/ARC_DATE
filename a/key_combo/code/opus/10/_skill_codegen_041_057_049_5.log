+    order: list[int] = []
+    for raw in grid.ravel():
+        color = int(raw)
+        if color not in seen:
+            seen.add(color)
+            order.append(color)
+    return order
+
+
+def _path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:
+    r0, c0 = start
+    r1, c1 = stop
+    pts: list[Coord] = []
