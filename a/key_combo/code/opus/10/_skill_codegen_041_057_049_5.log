+        h_ok, v_ok = _axis_legality(simulated, pts[0], pts[1])
+        if not (h_ok or v_ok):
+            return False
+        path, axis = _choose_path(simulated, pts[0], pts[1])
+        axes.append(axis)
+        for r, c in path[1:-1]:
