+    if r == r0 - 1 and c0 <= c <= c1:
+        sides.append("top")
+    if r == r1 + 1 and c0 <= c <= c1:
+        sides.append("bottom")
+    if c == c0 - 1 and r0 <= r <= r1:
+        sides.append("left")
+    if c == c1 + 1 and r0 <= r <= r1:
+        sides.append("right")
+    return sides
+
+
+def _infer_target_bbox(shape: tuple[int, int], original: BBox, markers: list[Coord]) -> BBox:
