+        orient = random.choice(("h", "rh", "v", "uv"))
+        cr, cc = random.choice(sorted(controls))
+        dr = _rand_inclusive(-3, 3)
+        dc = _rand_inclusive(-3, 3)
+        seg = _segment_cells((cr + dr, cc + dc), orient, length)
