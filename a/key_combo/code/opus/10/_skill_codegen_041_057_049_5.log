+
+
+def _place_walls(
+    base: np.ndarray,
+    route_cells: set[Coord],
+    line_cells: set[Coord],
+    controls: set[Coord],
+) -> np.ndarray | None:
+    grid = base.copy()
+    occupied = set(route_cells) | set(np.argwhere(grid == LINE).tolist())  # type: ignore[arg-type]
+    occupied = {(int(r), int(c)) for r, c in occupied}
+    target_count = _rand_inclusive(2, 4)
+    placed = 0
+
+    candidates: list[list[Coord]] = []
+    for _ in range(240):
