0039:         if int(pts.shape[0]) < 8:
0040:             continue
0041:         r0, c0 = pts.min(axis=0)
0042:         r1, c1 = pts.max(axis=0)
0043:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
0044:         h = int(r1 - r0 + 1)
0045:         w = int(c1 - c0 + 1)
0046:         if h < 3 or w < 3:
0047:             continue
0048: 
0049:         t = None
0050:         inner_col = None
0051:         for tt in range(1, int(min(h, w) // 2) + 1):
0052:             inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]
0053:             if inner.size == 0:
0054:                 continue
0055:             if bool((inner == int(border)).any()):
0056:                 continue
0057:             u = set(map(int, inner.flatten()))
0058:             if len(u) != 1:
0059:                 continue
0060: 
0061:             ok = True
0062:             if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):
0063:                 ok = False
0064:             if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):
0065:                 ok = False
0066:             if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):
0067:                 ok = False
0068:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):
0069:                 ok = False
0070:             if not ok:
0071:                 continue
0072: 
0073:             t = int(tt)
0074:             inner_col = int(next(iter(u)))
0075:             break
0076: 
0077:         if t is None or inner_col is None:
