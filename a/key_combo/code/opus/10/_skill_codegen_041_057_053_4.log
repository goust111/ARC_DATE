+        diffs = [rows[i + 1] - rows[i] for i in range(len(rows) - 1)]
+        assert len(set(diffs)) == 1 and diffs[0] == size + 1, "separator spacing must match slot size"
+        start_r = rows[0] - size
+        c0 = next(iter(c0s))
+        origins = [(start_r + i * (size + 1), c0) for i in range(len(rows) + 1)]
