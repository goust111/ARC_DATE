spec:
  grid: (2n+1) x (2n+1) odd square, n=2-4
  background: single color, fills center cross (row n and col n)
  quadrants: 4 equal n x n corner tiles separated by the bg cross
  source_tiles:
    count: 3 of the 4 quadrants
    content: binary mask of source_color on bg
    relationship: the 3 masks are 3 distinct members of a 4-rotation family (rot90)
    pixel_count: all 3 masks have identical nonzero pixel count
    constraint: rotation family must have exactly 4 distinct members (no rotational symmetry)
  placeholder_tile:
    count: 1 quadrant
    content: solid fill of a single color != bg and != source_color
    position: any of the 4 quadrant positions
  colors: bg, source_color, placeholder_color are 3 distinct colors [observed] bg=0, source=1, placeholder=2
  output: n x n tile showing the missing 4th rotation, source_color on bg

generation_strategy:
