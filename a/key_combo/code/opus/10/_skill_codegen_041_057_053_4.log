+from arc_utils import Color, colors_present, components_mask, find_components, get_bg, paste
+
+
+BACKGROUND = Color.BLACK
+SEPARATOR = Color.GREY
+SPRITE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_ATTEMPTS = 500
+SHAPE_ATTEMPTS = 300
+PATTERN_ATTEMPTS = 200
