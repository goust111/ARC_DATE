+    for i, block_h in enumerate(row_sizes):
+        col = 0
+        for j, block_w in enumerate(col_sizes):
+            grid[row : row + block_h, col : col + block_w] = int(compact[i, j])
+            col += int(block_w)
+            if j < 2:
