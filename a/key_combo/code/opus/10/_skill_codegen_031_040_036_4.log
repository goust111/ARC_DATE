+        row += int(block_h)
+        if i < 2:
+            row += 1
+
+    return grid
+
+
+def _recolor_pattern(abstract: np.ndarray, actual_colors: tuple[int, ...]) -> np.ndarray:
+    compact = np.zeros_like(abstract)
+    for color_id, actual in enumerate(actual_colors, start=1):
+        compact[abstract == color_id] = actual
+    return compact
+
