from itertools import combinations
from collections import Counter

cells=[(r,c) for r in range(3) for c in range(3)]
valid_pairs=[p for p in combinations(cells,2) if p[0][0]"'!=p[1][0] and p[0][1]!=p[1][1]]

def route_cells(a,b):
    if a>b:
        a,b=b,a
    (r0,c0),(r1,c1)=a,b
    out=[]
    step=1 if c1>c0 else -1
    for c in range(c0+step,c1+step,step):
        out.append((r0,c))
    for r in range(r0+1,r1+1):
        out.append((r,c1))
    return out

def analyze(pairs):
    occ={}
    for i,p in enumerate(pairs,1):
        for cell in p:
            occ[cell]=i
    claims={}
    endpoint_block=False
    for i,p in enumerate(pairs,1):
        for cell in route_cells(*p):
            if cell in occ:
                if occ[cell]!=i:
                    endpoint_block=True
                continue
            claims.setdefault(cell,set()).add(i)
    pink=sum(len(v)>1 for v in claims.values())
    changed=len(claims)
    return pink, endpoint_block, changed

seen2=[]
for ps in combinations(valid_pairs,2):
    flat=[c for p in ps for c in p]
    if len(set(flat))<4:
        continue
    seen2.append(analyze(ps))
seen3=[]
for ps in combinations(valid_pairs,3):
    flat=[c for p in ps for c in p]
    if len(set(flat))<6:
        continue
    seen3.append(analyze(ps))
for name, arr in [('"'2',seen2),('3',seen3)]:
    cnt=Counter(arr)
    print('pairs',name,'cases',len(arr),'distinct',len(cnt))
    for k,v in cnt.most_common():
        print(k,v)
    print('plain',sum(1 for p,e,c in arr if p==0 and not e and c>=2))
    print('overlap',sum(1 for p,e,c in arr if p>=1))
    print('block',sum(1 for p,e,c in arr if e))
    print()
