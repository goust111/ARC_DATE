+        for c in range(grid.shape[1]):
+            value = int(grid[r, c])
+            if value == 0:
+                continue
+            if value not in mapping:
+                mapping[value] = next_color
+                next_color += 1
+            out[r, c] = mapping[value]
+    return out
+
+
