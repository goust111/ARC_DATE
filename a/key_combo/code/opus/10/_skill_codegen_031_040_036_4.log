+    seen: set[tuple[int, ...]] = set()
+
+    for num_pairs in (2, 3):
+        for pair_combo in itertools.combinations(PAIR_OPTIONS, num_pairs):
+            used = [cell for pair in pair_combo for cell in pair]
+            if len(set(used)) != 2 * num_pairs:
+                continue
+
