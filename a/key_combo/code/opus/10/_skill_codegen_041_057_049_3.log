+        a2 = (r1 - 2, c0 + 1)
+        a3 = (r1 - 2, c1 - 1)
+        comp1 = _component_shape(a1, (-1, 0), (0, -1) if c0 + 1 > c0 else None)
+        comp2 = [a2, (a2[0] + 1, a2[1]), (a2[0], a2[1] - 1)]
+        comp3 = _component_shape(a3, (0, 1), (1, 0) if r1 - 2 < r1 - 1 else None)
+        path1 = _path_cells(a1, a2, "v")
+        path2 = _path_cells(a2, a3, "h")
