+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == color
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(grid.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(sorted(coords), dtype=int))
+    return comps
+
+
+def _bbox_top_left(coords: np.ndarray) -> tuple[int, int]:
+    mins = coords.min(axis=0)
+    return int(mins[0]), int(mins[1])
+
+
+def _row_major_colors(grid: np.ndarray, exclude: set[int]) -> list[int]:
+    seen = set(exclude)
+    order: list[int] = []
+    for value in grid.ravel():
+        color = int(value)
+        if color not in seen:
+            seen.add(color)
+            order.append(color)
+    return order
+
+
+def _path_cells(start: Coord, stop: Coord, first_axis: str) -> list[Coord]:
+    r0, c0 = start
+    r1, c1 = stop
+    cells: list[Coord] = []
+    if r0 == r1 or c0 == c1:
+        if r0 == r1:
+            step = 1 if c1 >= c0 else -1
+            for c in range(c0, c1 + step, step):
+                cells.append((r0, c))
+        else:
+            step = 1 if r1 >= r0 else -1
+            for r in range(r0, r1 + step, step):
+                cells.append((r, c0))
+        return cells
