WALL = Color.TEAL

# Palette.
N_COLORS = 10
ALL_COLORS = [c for c in range(N_COLORS) if c not in (BG, WALL)]

# Canvas sizing.
MIN_ROWS = 8
MAX_ROWS = 12
MIN_COLS = 10
MAX_COLS = 12
LARGE_GRID_CONNECTABLE_THRESHOLD = 3
LARGE_GRID_MIN_ROWS = 10
