+def _erase_paths(output: np.ndarray, keep_colors: list[int]) -> np.ndarray:
+    inp = output.copy()
+    for color in keep_colors:
+        comps = _components_of_color(output, color)
+        component_mask = np.zeros_like(output, dtype=bool)
+        for comp in comps:
+            for r, c in comp:
