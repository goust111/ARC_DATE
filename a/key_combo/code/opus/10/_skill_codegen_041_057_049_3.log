+def _zone_templates(n_extra: int, h: int, w: int) -> list[tuple[int, int, int, int]]:
+    zones = [
+        (1, w // 2 + 1, h // 2 - 2, w - 2),
+        (h // 2 + 1, 1, h - 2, w // 2 - 2),
