+
+def _erase_paths(output: np.ndarray, route_map: dict[int, list[Coord]]) -> np.ndarray:
+    inp = output.copy()
+    for color, cells in route_map.items():
+        for r, c in cells:
+            if int(inp[r, c]) == color:
+                inp[r, c] = BG
