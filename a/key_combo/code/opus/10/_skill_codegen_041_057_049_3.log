        if placement is None:
            stats['extra_chain'] = stats.get('extra_chain', 0) + 1
            bad = True
            break
    if bad:
        continue

    wall_target = int(np.random.randint(3, 6))
    extra_walls = wall_target - 1
    if extra_walls < 2:
        extra_walls = 2
    if not mod._place_extra_walls(output, extra_walls):
        stats['walls'] = stats.get('walls', 0) + 1
        continue

    expected = output.copy()
    inp = mod._erase_paths(expected, keep_colors)

    low_counts = [len(mod._components_of_color(inp, color)) for color in keep_colors]
    if not low_counts:
        stats['low_counts'] = stats.get('low_counts', 0) + 1
        continue
    noise_count = max(low_counts) + int(np.random.randint(1, 3))
    noise_count = max(4, min(5, noise_count))
    if noise_count <= max(low_counts):
        stats['noise_count'] = stats.get('noise_count', 0) + 1
        continue

    if not mod._place_noise_components(inp, noise_color, special['route_cells'], noise_count):
        stats['noise_place'] = stats.get('noise_place', 0) + 1
        continue
    if not mod._semantic_ok(inp, expected, special_color):
        stats['semantic'] = stats.get('semantic', 0) + 1
        continue
    stats['success'] = stats.get('success', 0) + 1

print(stats)
