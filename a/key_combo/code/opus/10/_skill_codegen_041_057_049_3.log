+        a1 = (r0 + 1, c)
+        a2 = (r1 - 1, c)
+        comp1 = _component_shape(a1, (-1, 0), (0, -1) if c > c0 + 1 and np.random.random() < 0.5 else None)
+        comp2 = _component_shape(a2, (1, 0), (0, 1) if c < c1 - 1 and np.random.random() < 0.5 else None)
+        path = _path_cells(a1, a2, "v")
+    else:
+        a1 = (r0 + 1, c0 + 1)
+        a2 = (r1 - 1, c1 - 1)
