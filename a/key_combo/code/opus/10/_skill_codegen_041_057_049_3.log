    assert len(frame_colors) == 1
    frame_color = frame_colors[0]

    doors: list[tuple[tuple[int, int], tuple[int, int]]] = []
    for r0, c0 in zip(*np.where(g == marker_color)):
        r, c = int(r0), int(c0)
