+    out = np.full_like(g, BLACK)
+    ordered = sorted(groups.items(), key=lambda item: len(item[1]))
+    for key, items in ordered:
+        color = RANK_TO_COLOR[rank_by_shape[key]]
+        mask = items[0]["mask"]
+        for item in items:
+            _paint_mask(out, mask, item["top"], color)
+    return out
+
