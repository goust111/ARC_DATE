+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+RANK_TO_COLOR = {1: RED, 2: BLUE, 3: GREEN}
+COUNT_OPTIONS = [(2, 3, 4), (2, 3, 5), (2, 4, 5), (3, 4, 5)]
+GRID_ROW_RANGE = (16, 22)
+GRID_COL_RANGE = (14, 18)
+GEN_RETRY_LIMIT = 600
