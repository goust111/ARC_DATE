+    groups: dict[tuple[tuple[int, ...], ...], list[dict]] = defaultdict(list)
+    for component in components:
+        groups[component["key"]].append(component)
+    return groups
+
+
+def _rank_by_shape(groups: dict[tuple[tuple[int, ...], ...], list[dict]]) -> dict[tuple[tuple[int, ...], ...], int]:
