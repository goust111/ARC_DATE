+    triple: tuple[int, int, int],
+    order: tuple[int, int, int],
+    shape: tuple[int, int],
+) -> list[dict] | None:
+    h, w = shape
+    t0, t1, t2 = order
+    deltas01 = LEGAL_OVERLAP_DELTAS[(triple[t0], triple[t1])][:]
+    deltas12 = LEGAL_OVERLAP_DELTAS[(triple[t1], triple[t2])][:]
+    random.shuffle(deltas01)
+    random.shuffle(deltas12)
