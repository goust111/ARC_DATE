+    rank_by_type = {type_index: rank for rank, type_index in enumerate(frequency_order, start=1)}
+    for type_index in sorted(range(3), key=lambda t: counts[t]):
+        color = RANK_TO_COLOR[rank_by_type[type_index]]
+        for item in placed:
