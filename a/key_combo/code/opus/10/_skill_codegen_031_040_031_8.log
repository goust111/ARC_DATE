+    rows, cols = np.where(mask)
+    return {(r0 + int(r), c0 + int(c)) for r, c in zip(rows, cols)}
+
+
+def _can_place(mask: np.ndarray, top: tuple[int, int], placed: list[dict], shape: tuple[int, int]) -> bool:
+    h, w = shape
