+def _overlap_pair_count(placed: list[dict]) -> int:
+    total = 0
+    for i in range(len(placed)):
+        for j in range(i + 1, len(placed)):
+            total += int(_bbox_overlap(placed[i]["bbox"], placed[j]["bbox"]))
+    return total
+
