+def _infer_row_cycle(slot_patches: list[np.ndarray]) -> tuple[int, tuple[int, ...]]:
+    matches = _matching_cycles(slot_patches)
+    assert matches, "row must expose a valid diagonal cycle"
+    return matches[0]
