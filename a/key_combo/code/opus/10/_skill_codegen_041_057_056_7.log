+
+    if not search(0):
+        return None
+    return [pos for pos in positions if pos is not None]
+
+
+def _draw_frame(
+    grid: np.ndarray,
+    out_meta: list[dict],
+    top: int,
+    left: int,
+    spec: tuple[list[int], list[int]],
+    row_specs: list[tuple[int, tuple[int, ...]]],
