+def _rect_clear(
+    rect: tuple[int, int, int, int], placed: list[tuple[int, int, int, int]], gap: int
+) -> bool:
+    r0, c0, r1, c1 = rect
+    for pr0, pc0, pr1, pc1 in placed:
+        if not (r1 + gap < pr0 or pr1 + gap < r0 or c1 + gap < pc0 or pc1 + gap < c0):
