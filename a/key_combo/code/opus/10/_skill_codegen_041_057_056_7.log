+
+
+def _slot_patch(grid: np.ndarray, frame: dict, slot_r: int, slot_c: int) -> np.ndarray:
+    rows = frame["rows"]
+    cols = frame["cols"]
+    return grid[
+        rows[slot_r] + 1 : rows[slot_r + 1],
+        cols[slot_c] + 1 : cols[slot_c + 1],
