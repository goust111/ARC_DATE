+
+
+def _apply_transform(grid: np.ndarray, name: str) -> np.ndarray:
+    if name == "identity":
+        return grid.copy()
+    if name == "flipud":
+        return np.flipud(grid)
+    if name == "fliplr":
+        return np.fliplr(grid)
+    if name == "rot180":
+        return np.rot90(grid, 2)
+    if name == "transpose":
+        return grid.T.copy()
+    if name == "rot90":
+        return np.rot90(grid, 1)
+    if name == "rot270":
+        return np.rot90(grid, 3)
