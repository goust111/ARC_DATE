+        cells = _full_slash(h, w, sigma)
+        if len(cells) < 6:
+            continue
+        if cells[0][0] in (0, h - 1) and cells[0][1] in (0, w - 1):
+            continue
+        if cells[-1][0] in (0, h - 1) and cells[-1][1] in (0, w - 1):
