+def _solve_from_segments(shape: tuple[int, int], segments: list[tuple[int, tuple[int, int], tuple[int, int]]]) -> tuple[np.ndarray, np.ndarray, list[dict], list[dict]]:
+    drawn = _render_segments(shape, segments)
