+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w) or (nr, nc) not in region_set:
+                is_boundary = True
+                break
+        if not is_boundary:
+            continue
