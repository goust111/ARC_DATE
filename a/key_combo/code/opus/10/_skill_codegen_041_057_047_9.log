+def _infer_segments(grid: np.ndarray) -> list[tuple[int, tuple[int, int], tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    segments = []
+    for color in LINE_COLORS:
+        coords = [tuple(map(int, rc)) for rc in np.argwhere(g == color)]
+        if not coords:
