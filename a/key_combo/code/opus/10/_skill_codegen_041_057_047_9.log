+    zero_mask = drawn == BLACK
+    corner_cells = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+    large_regions = []
+    small_regions = []
+
+    for comp in _zero_components(zero_mask):
+        comp_set = set(comp)
+        if any(corner in comp_set for corner in corner_cells):
+            continue
+        touches = _touch_colors(comp, drawn)
+        info = {
+            "coords": comp,
+            "area": int(len(comp)),
+            "touches": touches,
