+_SPRITE_EXTENT: dict[str, tuple[int, int, int, int]] = {}
+for _name, _rels in BODY_REL.items():
+    _all = _rels + [(0, 0)]
+    _SPRITE_EXTENT[_name] = (
+        min(dr for dr, _dc in _all),
