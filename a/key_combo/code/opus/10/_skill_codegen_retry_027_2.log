MAX_GENERATION_ATTEMPTS = 300


def _gen_expected_output(inp: np.ndarray) -> np.ndarray:
    return np.block(
        [
            [inp, np.rot90(inp, -1)],
            [np.rot90(inp, 1), np.rot90(inp, 2)],
        ]
    )


