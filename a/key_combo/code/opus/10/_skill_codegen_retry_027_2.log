+def _manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return abs(int(a[0]) - int(b[0])) + abs(int(a[1]) - int(b[1]))
+
+
+def _has_matching_counterexample(
+    anchors: dict[int, tuple[int, int]],
+    sprite_markers: dict[int, tuple[int, int]],
+) -> bool:
