+    blocked = np.zeros((H, W), dtype=bool)
+    anchors: list[tuple[int, int]] = []
+    for _ in range(count):
+        candidates = [
+            (r, c)
+            for r in range(1, H - 1)
+            for c in range(1, W - 1)
+            if not blocked[r, c]
