+    anchors = {color: pos for color, pos in zip(colors, anchor_positions)}
+
+    grid = np.zeros((H, W), dtype=int)
+    for color, (r, c) in anchors.items():
+        grid[r, c] = int(color)
+
+    sprite_markers = _place_sprites(grid, colors, directions, anchors)
