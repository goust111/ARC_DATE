                gaps.append((start, stop))
                placed = True
                break
            if not placed:
                ok = False
                break
        if ok and np.any(~keep) and np.any(keep):
            return keep
    raise RuntimeError("failed to sample guide gaps")


def _build_input(tile: np.ndarray, keep_cols: np.ndarray, guide_top: bool, r_cut: int, c_cut: int) -> np.ndarray:
    content_h = r_cut + random.randint(1, 4)
