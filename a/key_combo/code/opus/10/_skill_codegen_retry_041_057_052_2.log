    guide_row = np.where(keep_cols, GUIDE, BG)
    if guide_top:
        return np.vstack([guide_row[None, :], content])
    return np.vstack([content, guide_row[None, :]])


def _gen_attempt() -> np.ndarray | None:
    tile = _sample_exact_tile()
