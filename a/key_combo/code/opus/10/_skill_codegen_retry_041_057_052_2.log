+        tile_w = random.randint(3, 4)
+        color_count = random.randint(2, 3)
+        palette = [BG] + random.sample(list(TILE_COLORS), color_count)
+        tile = np.array(
+            [[random.choice(palette) for _ in range(tile_w)] for _ in range(tile_h)],
+            dtype=int,
+        )
