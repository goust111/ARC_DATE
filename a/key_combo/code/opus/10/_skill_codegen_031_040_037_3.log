+        blue_rows = np.flatnonzero(seed_panel[:, c] == BLUE)
+        assert not (red_rows.size and blue_rows.size), "a column cannot contain both propagation directions"
+
+        for r in red_rows:
+            rr = int(r) + 1
+            while rr < h and int(seed_panel[rr, c]) == bg:
+                out[rr, c] = RED
+                rr += 1
