+            if min_rest <= next_remaining <= max_rest:
+                prefix.append(value)
+                rec(next_remaining, slots - 1, prefix)
+                prefix.pop()
+
+    rec(total, parts, [])
+    return out
+
+
+def _sample_lengths_and_gaps() -> tuple[tuple[int, ...], tuple[int, ...]]:
+    segment_count = random.choice(SEGMENT_COUNT_OPTIONS)
