+        pos = (pos + gap_len) % perimeter
+    raise AssertionError("expected a unique longest gap")
+
+
+def _sample_shift(perimeter: int, segment_lengths: tuple[int, ...], gap_lengths: tuple[int, ...]) -> int:
+    wrap_longest = bool(random.getrandbits(1))
