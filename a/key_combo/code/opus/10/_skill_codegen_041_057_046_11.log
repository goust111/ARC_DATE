+        next_start = segments[(idx + 1) % len(segments)][0]
+        gap_start = (start + length) % n
+        gap_len = (next_start - gap_start) % n
+        assert gap_len > 0, "adjacent segments must be separated by black pixels"
+        for step in range(gap_len):
