+
+
+def _l_path(src: tuple[int, int], dst: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc = src
+    dr, dc = dst
+    path = [(sr, sc)]
+    c_step = _sign(dc - sc)
+    if c_step:
+        for c in range(sc + c_step, dc + c_step, c_step):
+            path.append((sr, c))
