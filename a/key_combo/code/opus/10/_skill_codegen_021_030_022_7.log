+    candidates = _enumerate_candidates(shape, anchors)
+    crossing_pairs = [
+        (a, b)
+        for a, b in combinations(candidates, 2)
+        if a["length"] != b["length"]
+        and _compatible(a, [b])
+        and _compatible(b, [a])
+        and _paths_cross(a, b)
