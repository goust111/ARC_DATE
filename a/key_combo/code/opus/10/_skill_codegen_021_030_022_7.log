+
+
+def _l_path_vertical_first(src: tuple[int, int], dst: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc = src
+    dr, dc = dst
+    path = [(sr, sc)]
+    r_step = _sign(dr - sr)
+    if r_step:
