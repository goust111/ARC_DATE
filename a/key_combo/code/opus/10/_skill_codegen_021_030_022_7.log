+
+def _place_anchors(h: int, w: int, count: int) -> list[tuple[int, int, int, int]] | None:
+    top_lefts = [(r, c) for r in range(1, h - 2) for c in range(1, w - 2)]
+    random.shuffle(top_lefts)
+    candidates = [(r, c, r + 1, c + 1) for r, c in top_lefts]
