+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        h = random.randint(MIN_GRID, MAX_GRID)
+        w = random.randint(MIN_GRID, MAX_GRID)
+        anchor_count = 3 if min(h, w) >= 15 and random.random() < 0.45 else 2
