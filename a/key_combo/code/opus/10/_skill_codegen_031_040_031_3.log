            variants.append(candidate)
    if not variants:
        return None

    patch = random.choice(variants).copy()
    if random.choice(GEN_FLIP_CHOICES):
        patch = np.fliplr(patch).copy()
    if random.choice(GEN_FLIP_CHOICES):
        patch = np.flipud(patch).copy()
    return patch


