    width = len(top)
    patch = np.zeros((height, width), dtype=int)
    path = _gen_path_from_profiles(top, bottom)
    if len(set(path)) != len(path):
        return None
    coords = np.asarray(path, dtype=int)
    rows = coords[:, 0]
    cols = coords[:, 1]
    if np.any((rows < 0) | (rows >= height) | (cols < 0) | (cols >= width)):
