27: def main(grid: np.ndarray) -> np.ndarray:
28:     """Fill zero holes by reconstructing the smallest repeating color table visible in the grid.
29: 
30:     Input structure
31:     The grid is a rectangular periodic color table with black 0 cells as missing entries; each position in the true repeating tile is visible at least once.
32: 
33:     Rule
34:     Infer the smallest period p where all nonzero cells agree by (row mod p, column mod p), build that p x p tile, and replace every cell by the corresponding tile color.
35: 
36:     Key insight
37:     The nonzero pixels are samples of one complete repeating tile, so the repair follows from periodicity rather than from numeric color ordering.
38:     """
39:     g = np.asarray(grid, dtype=int)
40:     assert g.ndim == 2
41:     assert np.any(g == 0)
42: 
43:     tile = _periodic_tile(g)
44:     p = tile.shape[0]
45:     rows = np.arange(g.shape[0])[:, None] % p
46:     cols = np.arange(g.shape[1])[None, :] % p
47:     out = tile[rows, cols]
48:     assert np.all((g == 0) | (out == g))
49:     return out
