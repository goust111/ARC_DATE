+from __future__ import annotations
+
+import random
+from collections import deque
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+COUNT_TO_TURNS = {1: 1, 2: 2, 3: 3}
+
+GEN_SLOT_HEIGHTS = (6, 7)
+GEN_SLOT_WIDTHS = (6, 7)
+GEN_GUTTERS = (4, 5)
+GEN_MARGINS = (0, 1)
+GEN_MAX_ATTEMPTS = 500
