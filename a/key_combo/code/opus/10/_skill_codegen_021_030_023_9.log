+def _generate_candidate() -> np.ndarray | None:
+    object_count = random.choice((3, 4))
+    counts = [1, 2, 3]
+    if object_count == 4:
+        counts.append(random.choice((1, 2, 3)))
+    random.shuffle(counts)
