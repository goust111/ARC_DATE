spec:
  grid: 4-9 rows x 5-12 cols
  background: 0 (black)
  platform:
    color: any non-bg color (1-8)
    bottom_row: solid platform color spanning full width
    shelf_row: row above bottom; contains platform-color separator runs and bg gaps
    separators: 2-4 runs of platform color in shelf row; first starts at col 0, last ends at col W-1; widths 1-2 each
    slots: bg gaps between consecutive separators; widths all distinct within example; range 1-4
  objects:
    count: 1-3, equal to number of slots
    shape: solid monochrome rectangles with exactly one side == 2; other side 1-4 (the normalized width)
    colors: distinct from each other, bg, and platform color
    placement: scattered above the shelf row (gap >= 1 row to shelf); non-overlapping; row H-3 always bg [observed]
    match: each object's normalized width uniquely matches one slot width
  output:
    clear all objects from original positions
    rotate each to 2-tall orientation and place bottom-aligned in its matching-width slot
    rows above shelf-1 become all bg

generation_strategy:
  approach: output-first
  steps:
    1. Pick N objects (1-3), assign each a distinct normalized width (all different, range 1-4).
    2. Build the shelf row: place N+1 separator runs (width 1-2 each) such that gaps between them equal the chosen slot widths. First sep starts at col 0, last ends at col W-1.
    3. Set bottom row to solid platform color. Set shelf-1 and shelf rows to the output state (slots filled with object colors, 2 rows tall).
    4. Derive input by clearing the slot fills (restore bg in slots on shelf and shelf-1 rows).
