+
+def _sprite_from_coords(coords: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    sprite = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    sprite[coords[:, 0] - r0, coords[:, 1] - c0] = int(color)
