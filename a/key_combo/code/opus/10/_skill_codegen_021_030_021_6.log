+        sr, sc = small_pos
+        lr, lc = large_pos
+        small_bbox = (sr, sc, sr + sh - 1, sc + sw - 1)
+        large_bbox = (lr, lc, lr + lh - 1, lc + lw - 1)
+        if not _bbox_has_gap(small_bbox, [large_bbox]):
+            continue
