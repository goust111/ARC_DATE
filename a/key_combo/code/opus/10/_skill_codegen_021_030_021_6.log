+    out = np.full(shape, BLACK, dtype=int)
+    body_mask = np.zeros(shape, dtype=bool)
+
+    for obj in survivors:
+        rr, cc = obj["coords"].T
+        out[rr, cc] = GREY
+        body_mask[rr, cc] = True
+
+    ordered = sorted(survivors, key=lambda obj: (int(obj["bbox"][0]), int(obj["bbox"][1])))
+    for obj in ordered:
