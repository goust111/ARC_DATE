+        coords = np.array(sorted(cells), dtype=int)
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        cropped = coords - np.array([r0, c0], dtype=int)
+        patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+        patch[cropped[:, 0], cropped[:, 1]] = int(color)
