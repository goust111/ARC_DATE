+            "area": int(areas[index]),
+            "coords": coords,
+            "bbox": bbox,
+            "patch": patch,
+        }
+        placed_bboxes.append(bbox)
+
+    return [spec for spec in specs if spec is not None]
+
+
+def _render_input(shape: tuple[int, int], specs: list[dict]) -> np.ndarray:
+    grid = np.full(shape, BLACK, dtype=int)
+    for spec in specs:
+        patch = spec["patch"]
+        r0, c0, _, _ = spec["bbox"]
+        mask = patch != BLACK
