+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+INPUT_COLORS = (BLUE, RED, PINK, ORANGE)
+FOUR_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))
