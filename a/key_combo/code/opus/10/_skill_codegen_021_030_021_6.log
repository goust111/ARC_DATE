+def _random_blob_patch(area: int, color: int) -> np.ndarray:
+    dim_options = [
+        (h, w)
+        for h in range(2, 7)
+        for w in range(2, 7)
+        if h * w > area and h * w <= area + max(4, area // 2 + 1)
+    ]
+    assert dim_options, f"no feasible dimensions for area {area}"
