+    h, w = map(int, shape)
+    ph, pw = map(int, patch_shape)
+    candidates = []
+    for r in range(h - ph + 1):
+        for c in range(w - pw + 1):
+            bbox = (r, c, r + ph - 1, c + pw - 1)
+            if _bbox_has_gap(bbox, placed_bboxes):
