+    r0, c0, r1, c1 = bbox
+    er0 = max(0, int(r0) - 1)
+    ec0 = max(0, int(c0) - 1)
+    er1 = min(h - 1, int(r1) + 1)
+    ec1 = min(w - 1, int(c1) + 1)
+
+    cells: list[tuple[int, int]] = []
+    for r in range(er0, er1 + 1):
+        for c in range(ec0, ec1 + 1):
+            if r in (er0, er1) or c in (ec0, ec1):
+                cells.append((r, c))
