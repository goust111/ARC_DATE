+
+    median_area = _lower_median([int(obj["area"]) for obj in survivors])
+    out = np.full(shape, BLACK, dtype=int)
+    body_mask = np.zeros(shape, dtype=bool)
+
+    for obj in survivors:
+        rr, cc = obj["coords"].T
+        out[rr, cc] = GREY
+        body_mask[rr, cc] = True
