+        matched = [template for template in templates if template["shape"] == query["shape"]]
+        assert len(matched) == 1
+        assert colors == {DEPTH_TO_COLOR[int(matched[0]["depth"])]}
+
+
+def _generate_one() -> np.ndarray | None:
