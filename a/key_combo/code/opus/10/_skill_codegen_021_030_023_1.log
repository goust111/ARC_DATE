+
+
+def _draw_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    region = grid[top : top + h, left : left + w]
+    mask = patch != BG
+    assert not np.any(region[mask] != BG)
+    region[mask] = patch[mask]
