+def _shape_patch(coords: tuple[tuple[int, int], ...], depth_colors: bool) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    patch = np.full((h, w), BG, dtype=int)
+    for r, c in coords:
+        rr = r - r0
+        cc = c - c0
