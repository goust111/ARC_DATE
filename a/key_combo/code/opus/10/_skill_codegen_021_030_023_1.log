+    random.shuffle(slots)
+    placed = []
+    for shape, (base_r, base_c) in zip(templates, slots):
+        coords = random.choice(_shape_variants(shape))
+        patch = _shape_patch(coords, depth_colors=True)
+        h, w = patch.shape
+        max_dr = 5 - h
+        max_dc = 5 - w
