   186	def main(grid: np.ndarray) -> np.ndarray:
   187	    """Recolor each grey query sprite by matching its shape to a depth-encoded legend template.
   188	
   189	    Input structure:
   190	    A black background contains a single-pixel grey L divider that touches the top and left edges and isolates
   191	    an upper-left legend rectangle. The legend holds 3-4 multicolor 4-connected template sprites whose outer
   192	    layer is blue, next layer red, and third layer green. Elsewhere, 3-5 grey query sprites appear as
   193	    rotation/reflection copies of the legend shapes.
   194	
   195	    Rule:
   196	    Find the legend template whose shape matches each grey query sprite up to rotation/reflection. For the
   197	    matched template, compute the maximum bbox-edge depth among its cells: outer layer depth 1, next layer
   198	    depth 2, next layer depth 3. Recolor the entire grey query sprite to blue for depth 1, red for depth 2,
   199	    and green for depth 3. Keep the divider, legend, and background unchanged.
   200	
   201	    Key insight:
   202	    The legend is not a direct color dictionary: shape identity selects a template, and that template's hidden
   203	    concentric depth encodes the output color.
   204	    """
   205	    g = np.asarray(grid, dtype=int)
   206	    assert g.ndim == 2, "expected a 2D grid"
   207	    info = _scene(g)
   208	
   209	    depth_by_shape = {template["shape"]: int(template["depth"]) for template in info["templates"]}
