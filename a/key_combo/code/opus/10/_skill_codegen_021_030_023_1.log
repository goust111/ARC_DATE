+# --------------- generator ---------------
+
+GRID_MIN = 21
+GRID_MAX = 27
+DIVIDER_MIN = 13
+DIVIDER_MAX = 15
+QUERY_COUNT_MAX = 5
+QUERY_GAP = 2
+GEN_ATTEMPTS = 400
+
+SHAPE_LIBRARY = [
