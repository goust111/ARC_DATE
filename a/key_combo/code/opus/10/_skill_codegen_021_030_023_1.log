+            {
+                "name": shape["name"],
+                "depth": shape["depth"],
+                "shape": _canonical_shape(abs_coords),
+                "coords": abs_coords,
+                "bbox": _bbox(abs_coords),
+                "area": int(len(abs_coords)),
