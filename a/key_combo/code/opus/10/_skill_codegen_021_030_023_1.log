+        "coords": ((0, 0), (0, 1), (0, 2), (1, 0), (1, 2)),
+        "depth": 1,
+    },
+    {
+        "name": "d2_plus5",
+        "coords": ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
