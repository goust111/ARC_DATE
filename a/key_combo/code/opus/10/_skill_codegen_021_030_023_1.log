+        left = base_c + random.randint(0, max_dc)
+        _draw_patch(grid, patch, top, left)
+        abs_coords = np.argwhere(grid[top : top + h, left : left + w] != BG)
+        abs_coords[:, 0] += top
+        abs_coords[:, 1] += left
+        placed.append(
+            {
+                "name": shape["name"],
+                "depth": shape["depth"],
+                "shape": _canonical_shape(abs_coords),
+                "coords": abs_coords,
+                "bbox": _bbox(abs_coords),
+                "area": int(len(abs_coords)),
+            }
