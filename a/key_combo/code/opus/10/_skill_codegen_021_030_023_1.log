+    for or0, oc0, or1, oc1 in others:
+        if r1 < or0:
+            dr = or0 - r1 - 1
+        elif or1 < r0:
+            dr = r0 - or1 - 1
+        else:
+            dr = 0
+        if c1 < oc0:
+            dc = oc0 - c1 - 1
+        elif oc1 < c0:
+            dc = c0 - oc1 - 1
+        else:
