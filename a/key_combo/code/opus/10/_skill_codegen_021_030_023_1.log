+
+def _generate_one() -> np.ndarray | None:
+    height = random.randint(GRID_MIN, GRID_MAX)
+    width = random.randint(GRID_MIN, GRID_MAX)
+    divider_r = random.randint(DIVIDER_MIN, DIVIDER_MAX)
