+# --------------- generator ---------------
+
+GRID_MIN = 21
+GRID_MAX = 27
+DIVIDER_MIN = 13
+DIVIDER_MAX = 15
+QUERY_COUNT_MAX = 5
+QUERY_GAP = 2
+GEN_ATTEMPTS = 400
+
+SHAPE_LIBRARY = [
+    {
+        "name": "d1_l5",
+        "coords": ((0, 0), (0, 1), (0, 2), (1, 0), (2, 0)),
+        "depth": 1,
+    },
+    {
+        "name": "d1_c7",
+        "coords": ((0, 0), (0, 1), (0, 2), (1, 0), (2, 0), (2, 1), (2, 2)),
+        "depth": 1,
+    },
+    {
+        "name": "d1_u5",
+        "coords": ((0, 0), (0, 1), (0, 2), (1, 0), (1, 2)),
+        "depth": 1,
+    },
+    {
+        "name": "d2_plus5",
+        "coords": ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+        "depth": 2,
+    },
+    {
+        "name": "d2_t7",
+        "coords": ((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2), (2, 1)),
+        "depth": 2,
+    },
+    {
+        "name": "d2_p6",
+        "coords": ((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (2, 1)),
+        "depth": 2,
+    },
+    {
+        "name": "d3_cross9",
+        "coords": (
+            (0, 2),
+            (1, 2),
+            (2, 0),
+            (2, 1),
+            (2, 2),
+            (2, 3),
+            (2, 4),
+            (3, 2),
+            (4, 2),
+        ),
+        "depth": 3,
+    },
+]
