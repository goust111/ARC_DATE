   211	    for query in info["queries"]:
   212	        shape = query["shape"]
   213	        assert shape in depth_by_shape, "every query must match a legend template"
   214	        out_color = DEPTH_TO_COLOR[depth_by_shape[shape]]
   215	        coords = query["coords"]
   216	        out[coords[:, 0], coords[:, 1]] = out_color
   217	    return out
