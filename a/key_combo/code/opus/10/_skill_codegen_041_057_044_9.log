+
+
+def _draw_grid(cell_size: int, n_rows: int, n_cols: int) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    h = n_rows * cell_size + (n_rows - 1)
+    w = n_cols * cell_size + (n_cols - 1)
