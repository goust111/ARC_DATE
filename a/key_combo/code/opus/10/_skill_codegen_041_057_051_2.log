    h, w = out.shape
    r0, c0, r1, c1 = box
    er0 = max(0, r0 - 1)
    ec0 = max(0, c0 - 1)
    er1 = min(h - 1, r1 + 1)
    ec1 = min(w - 1, c1 + 1)
    for r in range(er0, er1 + 1):
        for c in range(ec0, ec1 + 1):
            if (r in (er0, er1) or c in (ec0, ec1)) and out[r, c] == GEN_BACKGROUND:
                out[r, c] = GEN_FRAME


