import numpy as np
from collections import deque
BLACK,BLUE,YELLOW,MAROON=0,1,4,9
DIRS={'N':(-1,0),'S':(1,0),'W':(0,-1),'E':(0,1)}
OPP={'N':'S','S':'N','W':'E','E':'W'}

def enclosed(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if mask[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if mask[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS.values():
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1;q.append((nr,nc))
    return mask & ~seen

def comps(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,dtype=bool); out=[]
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not seen[r,c]:
          q=[(r,c)]; seen[r,c]=1; pts=[]
          while q:
            rr,cc=q.pop(); pts.append((rr,cc))
            for dr,dc in DIRS.values():
              nr,nc=rr+dr,cc+dc
              if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1;q.append((nr,nc))
          out.append(pts)
    return out

def solve(g):
    H,W=g.shape
    mar=set(map(tuple,np.argwhere(g==MAROON)))
    out=g.copy(); objs=[]
    for comp in comps(g==BLUE):
      dirs=set()
      for r,c in comp:
        out[r,c]=0
        for name,(dr,dc) in DIRS.items():
          if (r+dr,c+dc) in mar: dirs.add(OPP[name])
      if len(dirs)"'!=1: return None
      d=dirs.pop(); dr,dc=DIRS[d]
      rs=[r for r,c in comp]; cs=[c for r,c in comp]
      k={'"'N':min(rs),'S':H-1-max(rs),'W':min(cs),'E':W-1-max(cs)}[d]
      moved=[(r+dr*k,c+dc*k) for r,c in comp]
      objs.append((d,comp,moved))
    occ=set()
    for _,_,moved in objs:
      for p in moved:
        if p in occ or p in mar: return None
        occ.add(p); out[p]=BLUE
    pre=enclosed(g==0)
    post=enclosed(out==0)
    out[post & ~pre]=YELLOW
    return out, pre, post, objs

