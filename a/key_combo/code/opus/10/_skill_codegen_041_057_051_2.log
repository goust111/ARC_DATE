  top={(0,c) for c in range(1,w+1)} | {(r,w) for r in range(1,t+1)}
  left={(r,0) for r in range(0,h+1)} | {(h,c) for c in range(1,f+1)}
  mar={(r,w+1) for r in range(t,h+2)} | {(h+1,c) for c in range(f,w+2)}
  gt=h-t; gl=w-f
  top_in={(r+gt,c) for r,c in top}
