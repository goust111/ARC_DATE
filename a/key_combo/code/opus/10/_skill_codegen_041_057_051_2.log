    for r in range(H):
      for c in [0,W-1]:
        if mask[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(W):
      for r in [0,H-1]:
        if mask[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    while q:
