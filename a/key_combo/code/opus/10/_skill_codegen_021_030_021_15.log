+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _sorted_markers(grid: np.ndarray) -> list[tuple[int, int]]:
+    return sorted(tuple(map(int, rc)) for rc in np.argwhere(grid == BLUE))
