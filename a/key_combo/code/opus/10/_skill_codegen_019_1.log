+def _rotate_coords_90(coords: np.ndarray, center2: tuple[int, int]) -> np.ndarray | None:
+    out = []
+    cr2, cc2 = center2
+    for r, c in np.asarray(coords, dtype=int):
+        pr2 = 2 * int(r)
+        pc2 = 2 * int(c)
+        nr2 = cr2 + (pc2 - cc2)
+        nc2 = cc2 - (pr2 - cr2)
+        if nr2 % 2 or nc2 % 2:
