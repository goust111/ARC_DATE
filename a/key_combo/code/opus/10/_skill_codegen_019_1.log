    n1, n2, n3 = counts
    comps = find_components(grid, bg=_GEN_BG, colors=[_GEN_FG], connectivity=_GEN_CONNECTIVITY)
    areas = [int(comp["area"]) for comp in comps]
    if areas.count(1) != n1 or areas.count(2) != n2 or areas.count(3) != n3:
