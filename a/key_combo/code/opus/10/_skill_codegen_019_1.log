+def _gen_attempt() -> np.ndarray | None:
+    shapes = _sample_shapes(_choose_completion_counts())
+    inp, out = _build_example(shapes)
+    return inp if _example_is_good(inp, out) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        inp = _gen_attempt()
+        if inp is not None:
+            return inp
