+                        existing_mask.shape[0] * existing_mask.shape[1],
+                    ) < (
+                        prev["full_mask"].shape[0] * prev["full_mask"].shape[1],
+                        prev["existing_mask"].shape[0] * prev["existing_mask"].shape[1],
+                    ):
