+
+
+def _derangement(n: int) -> list[int]:
+    perm = list(range(n))
+    while True:
+        random.shuffle(perm)
+        if all(i != perm[i] for i in range(n)):
+            return perm
+
+
+def _choose_completion_counts() -> list[int]:
+    if random.random() < 0.7:
