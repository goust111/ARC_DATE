+
+def _coords_connected(coords: np.ndarray) -> bool:
+    coords = np.asarray(coords, dtype=int)
+    pts = {tuple(map(int, rc)) for rc in coords}
+    if not pts:
+        return False
+    start = next(iter(pts))
+    q = deque([start])
+    seen = {start}
