+            continue
+        return transformed
+    raise RuntimeError("failed to sample non-degenerate shape set")
+
+
+def _render_mask(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
+    patch = np.full(mask.shape, bg, dtype=int)
+    patch[np.asarray(mask, dtype=bool)] = int(color)
+    return patch
