+MASK_BITS_BY_AREA = {area: tuple(bits_list) for area, bits_list in MASK_BITS_BY_AREA.items()}
+
+
+def _random_mask_bits(area_lo: int, area_hi: int, exclude: set[int] | None = None) -> int:
