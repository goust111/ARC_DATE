+
+def _slot_positions(panel: int) -> list[tuple[int, int]]:
+    return [_global_pos(panel, r, c) for r in range(3) for c in range(3)]
+
+
+def _build_plan() -> tuple[tuple[int, int], set[tuple[int, int]], set[tuple[int, int]], bool]:
