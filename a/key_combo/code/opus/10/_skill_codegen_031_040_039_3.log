+    col_bands: list[tuple[int, int]],
+    slots: dict[tuple[int, int], Slot],
+    matches: set[tuple[int, int]],
+    connectors: set[tuple[int, int]],
+) -> np.ndarray:
+    out = crop.copy()
+
+    for sr, sc in connectors:
+        slot = slots[(sr, sc)]
+        rb0, rb1 = row_bands[sr]
+        cb0, cb1 = col_bands[sc]
+        block = out[rb0:rb1, cb0:cb1]
