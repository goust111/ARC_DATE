+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+
+LEFT = 0
+RIGHT = 1
+
+PANEL_COLORS = {LEFT: BLUE, RIGHT: RED}
+OPPOSITE_PANEL_COLORS = {LEFT: RED, RIGHT: BLUE}
+SYMBOL_COLORS = (GREEN, YELLOW, MAGENTA, ORANGE)
+
+TABLE_H = 11
+TABLE_W = 23
+SLOT_SIZE = 3
+ROW_SEPARATORS = (3, 7)
+COL_SEPARATORS = (3, 7, 11, 15, 19)
+MAX_GENERATE_ATTEMPTS = 400
