+                midpoint=_global_pos(panel, row, 1),
+                endpoints=(_global_pos(panel, row, 0), _global_pos(panel, row, 2)),
+            )
+        )
+    for col in range(3):
+        lines.append(
+            LineSpec(
+                midpoint=_global_pos(panel, 1, col),
+                endpoints=(_global_pos(panel, 0, col), _global_pos(panel, 2, col)),
