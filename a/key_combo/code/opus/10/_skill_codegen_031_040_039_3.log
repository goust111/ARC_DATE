+@dataclass(frozen=True)
+class Slot:
+    panel: int
+    panel_color: int
+    color: int | None
+    mask: np.ndarray
+
+
+@dataclass(frozen=True)
+class LineSpec:
+    midpoint: tuple[int, int]
+    endpoints: tuple[tuple[int, int], tuple[int, int]]
