+        if not _is_rectangular_frame(coords):
+            continue
+        r0, c0, r1, c1 = _bbox(coords)
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "interior_area": (r1 - r0 - 1) * (c1 - c0 - 1),
+            }
+        )
+    return frames
+
+
