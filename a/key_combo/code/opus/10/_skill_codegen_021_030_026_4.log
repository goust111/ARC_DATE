    return np.array(list(selected), dtype=int)


def _gen_place_components(
    grid: np.ndarray,
    side_mask: np.ndarray,
    occupied: np.ndarray,
    color: int,
    sizes: list[int],
) -> list[tuple[int, int]] | None:
