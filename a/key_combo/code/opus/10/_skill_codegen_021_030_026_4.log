+_INTERVALS_4 = {
+    2: [tuple(range(0, 2)), tuple(range(1, 3)), tuple(range(2, 4))],
+    3: [tuple(range(0, 3)), tuple(range(1, 4))],
+    4: [tuple(range(0, 4))],
