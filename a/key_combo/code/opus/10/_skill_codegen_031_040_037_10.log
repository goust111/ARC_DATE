+        row_gap = br0 - ar1 - 1
+    elif br1 < ar0:
+        row_gap = ar0 - br1 - 1
+    col_gap = 0
+    if ac1 < bc0:
+        col_gap = bc0 - ac1 - 1
+    elif bc1 < ac0:
+        col_gap = ac0 - bc1 - 1
+    return row_gap + col_gap >= 2
