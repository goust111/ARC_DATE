+                return False
+
+    winner_candidates = [cand for cand in candidates if cand["color"] == meta["winner_color"]]
+    if len(winner_candidates) != 1:
+        return False
+    if not np.array_equal(winner_candidates[0]["inner"], meta["winner_template"]):
+        return False
+
