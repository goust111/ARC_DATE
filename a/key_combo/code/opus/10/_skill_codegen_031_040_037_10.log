+        random.shuffle(candidates)
+        for r0, c0, box in candidates:
+            positions[idx] = (r0, c0)
+            placed_boxes.append(box)
+            if rec(i + 1):
+                return True
+            placed_boxes.pop()
+            positions[idx] = None
+        return False
