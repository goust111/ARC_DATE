+            nxt, cur_dir = random.choice(options)
+            if last_dir is not None and cur_dir != last_dir:
+                turns += 1
+            path.append(nxt)
+            path_set.add(nxt)
+            orbit_key = (nxt[0] % row_period, nxt[1] % col_period)
+            orbit_counts[orbit_key] = orbit_counts.get(orbit_key, 0) + 1
+            last_dir = cur_dir
