+    return True
+
+
+def _sample_snake(shape: tuple[int, int], row_period: int, col_period: int, length: int) -> list[Coord] | None:
+    h, w = shape
+    orbit_size = (h // row_period) * (w // col_period)
+    max_per_orbit = orbit_size // 2
+
+    for _ in range(800):
