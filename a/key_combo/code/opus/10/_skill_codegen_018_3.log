+    for obj in objects:
+        grouped[obj["signature"]].append(obj)
+
+    classes = []
+    for signature, members in grouped.items():
+        sort_key = min((member["r0"], member["c0"]) for member in members)
+        classes.append(
+            {
+                "signature": signature,
+                "members": members,
+                "sort_key": sort_key,
+            }
+        )
+    classes.sort(key=lambda cls: cls["sort_key"])
+    return classes
+
+
+def _fits_mask(occupied, mask, r0, c0):
+    h, w = mask.shape
+    H, W = occupied.shape
