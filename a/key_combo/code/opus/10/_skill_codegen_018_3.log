+        for nr in range(H - h, obj["r0"] - 1, -1):
+            if _fits_mask(occupied, obj["mask"], nr, obj["c0"]):
+                return nr, obj["c0"]
+    elif obj["direction"] == "right":
+        for nc in range(W - w, obj["c0"] - 1, -1):
+            if _fits_mask(occupied, obj["mask"], obj["r0"], nc):
+                return obj["r0"], nc
+    else:
+        for nc in range(0, obj["c0"] + 1):
+            if _fits_mask(occupied, obj["mask"], obj["r0"], nc):
+                return obj["r0"], nc
