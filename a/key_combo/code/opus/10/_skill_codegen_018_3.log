+
+SHAPE_COMBOS = {
+    2: [
+        ("L4", "T4"),
+        ("L4", "S4"),
+        ("T4", "S4"),
+    ],
+    3: [
+        ("P5", "L4", "T4"),
+        ("U5", "L4", "S4"),
+        ("P5", "T4", "S4"),
+    ],
