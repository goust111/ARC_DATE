+BASE_SHAPES = {
+    "L3": _mask_from_strings(["#.", "##"]),
+    "L4": _mask_from_strings(["#..", "###"]),
+    "T4": _mask_from_strings(["###", ".#."]),
+    "S4": _mask_from_strings([".##", "##."]),
+    "P5": _mask_from_strings(["##.", "###"]),
+    "U5": _mask_from_strings(["#.#", "###"]),
