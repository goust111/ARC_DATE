+        if count > 1:
+            orientations[1] = "V"
+    if branch % 4 == 3:
+        orientations = ["V"] * count
+        orientations[0] = "H"
+    return orientations
+
+
+def _wrong_cycle_outputs(
+    obstacle_grid: np.ndarray,
+    cycle: list[int],
+    start: tuple[int, int],
+    heading: tuple[int, int],
+) -> list[np.ndarray]:
+    asc_cycle = list(reversed(cycle))
+    alt1, _ = _simulate(obstacle_grid, asc_cycle, start, heading)
