+        reserved |= _expanded(cells, (h, w))
+    return grid
+
+
+def _sample_orientations(count: int, branch: int, rng: random.Random) -> list[str]:
+    orientations = ["H" if rng.random() < 0.5 else "V" for _ in range(count)]
+    if branch % 2 == 0:
