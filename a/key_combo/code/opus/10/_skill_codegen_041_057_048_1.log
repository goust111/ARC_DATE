+def _sample_top_rows(shapes: list[np.ndarray], chain_start: int) -> tuple[list[int], int]:
+    count = len(shapes)
+    heights = [int(shape.shape[0]) for shape in shapes]
+    tops = [0] * count
+    cursor = random.randint(1, 2)
