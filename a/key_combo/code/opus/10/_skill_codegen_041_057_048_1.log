SPRITE_HEIGHT_MIN = 3
SPRITE_HEIGHT_MAX = 7
SPRITE_WIDTH_MIN = 4
SPRITE_WIDTH_MAX = 9
SPRITE_AREA_MIN = 15
SPRITE_AREA_MAX = 36
SPRITE_FILL_MIN = 0.40
SPRITE_FILL_MAX = 0.66

# Object counts and placement spacing.
