+    top_rows = [obj["bbox"][0] for obj in objects]
+    assert len(set(top_rows)) == len(top_rows), "foreground objects must have distinct top rows"
+
+    ordered = []
+    for obj_id, obj in enumerate(sorted(objects, key=lambda item: item["bbox"][0])):
+        ordered.append(
