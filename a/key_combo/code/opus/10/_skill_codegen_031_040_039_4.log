+
+def _choose_distractors(
+    rng: random.Random,
+    grid: np.ndarray,
+    frames: list[Frame],
+    output_wo_distractors: np.ndarray,
+    count: int,
+) -> list[tuple[int, int]] | None:
+    h, w = grid.shape
+    base_candidates = []
+    visible_erase = []
+    for r in range(h):
