+
+
+def _distance_to_bbox(frame: Frame, r: int, c: int) -> int:
+    dr = 0 if frame.r0 <= r <= frame.r1 else min(abs(r - frame.r0), abs(r - frame.r1))
+    dc = 0 if frame.c0 <= c <= frame.c1 else min(abs(c - frame.c0), abs(c - frame.c1))
