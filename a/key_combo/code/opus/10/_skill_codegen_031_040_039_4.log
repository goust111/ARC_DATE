+                    r0 = 0
+                elif mode in {"bottom", "bl", "br"}:
+                    r0 = h - side
+                else:
+                    r0 = rng.randint(0, h - side)
+
+                if mode in {"left", "tl", "bl"}:
+                    c0 = 0
+                elif mode in {"right", "tr", "br"}:
