+
+        markers: list[tuple[int, int, Frame]] = []
+        used_stops: set[tuple[int, int]] = set()
+        per_frame_counts = []
+        for frame in frames:
+            picked = _pick_markers_for_frame(rng, frame, used_stops)
+            if picked is None:
