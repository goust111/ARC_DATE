+
+
+def _make_frame_canvas(grid: np.ndarray, frame: Frame) -> None:
+    for r, c in frame.perimeter_cells():
+        grid[r, c] = GREEN
+
+
+def _scene_output_without_distractors(
+    h: int,
+    w: int,
+    frames: list[Frame],
