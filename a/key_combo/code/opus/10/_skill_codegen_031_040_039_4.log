+
+
+def _sample_frames(rng: random.Random, h: int, w: int, count: int) -> list[Frame] | None:
+    sizes = [7, 9, 11]
+    clearance = 3
+    touch_edge = rng.random() < 0.35
+    frames: list[Frame] = []
+
+    for idx in range(count):
+        for _ in range(250):
+            side = rng.choice(sizes if count == 2 else [7, 7, 9, 9, 11])
+            if side > h or side > w:
+                continue
