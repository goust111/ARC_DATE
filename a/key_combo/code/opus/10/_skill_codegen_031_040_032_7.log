+    expected.append(near_miss)
+
+    if "right_top" in gap_names:
+        origin2 = _sprite_origin_from_block(block, "right_top")
+        extra = _place_contact_sprite(
+            grid,
+            occupied,
+            _ray_contact(origin2, (-1, 1), random.randint(4, 6)),
