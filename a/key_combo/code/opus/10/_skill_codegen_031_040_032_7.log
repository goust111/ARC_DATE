+            gaps: list[dict] = []
+            for dr in range(4):
+                for dc in range(4):
+                    if 1 <= dr <= 2 and 1 <= dc <= 2:
+                        continue
+                    value = int(grid[fr + dr, fc + dc])
+                    if (dr, dc) in GAP_OFFSETS:
+                        if value == BG:
