+    colors = [ctrl["color"] for ctrl in controls]
+    assert len(colors) == len(set(colors)), "control colors must be distinct"
+
+    sides = {ctrl["side"] for ctrl in controls}
+    if sides <= {"top", "bottom"}:
+        orientation = "vertical"
+        axis_key = "c"
+    elif sides <= {"left", "right"}:
