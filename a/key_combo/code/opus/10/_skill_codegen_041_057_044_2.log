+def _region_geometry(shape: tuple[int, int], orientation: str, rays: list[dict]) -> list[dict]:
+    h, w = shape
+    limit = w if orientation == "vertical" else h
+    axes = [ray["axis"] for ray in rays]
+    bounds = [-1, *axes, limit]
+    regions = []
+    scale = h if orientation == "vertical" else w
