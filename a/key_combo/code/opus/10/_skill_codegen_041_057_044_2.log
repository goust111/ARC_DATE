+def _iter_border_controls(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    controls = []
+    border_mask = np.zeros_like(grid, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
