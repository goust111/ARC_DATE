+            height = random.randint(5, min(7, cell_h))
+            width = random.randint(4, min(7, cell_w))
+            winner_dims = (height, width)
+            dims.append((height, width))
+        else:
+            height = random.randint(4, min(7, cell_h))
+            width = random.randint(4, min(8, cell_w))
+            dims.append((height, width))
