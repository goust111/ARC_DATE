+                    "bbox": (r0, c0, r1, c1),
+                    "coords": coords,
+                    "crop": crop.copy(),
+                    "marker_count": int(np.count_nonzero(crop == MARKER)),
+                    "area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                }
+            )
+
+    return panels
+
+
+def _shift_selected_rows_right(crop: np.ndarray) -> np.ndarray:
+    out = crop.copy()
+    h, w = crop.shape
+    for r in range(h):
+        distance = h - 1 - r
+        if distance >= 2 and distance % 2 == 0:
+            out[r, 0] = BG
+            out[r, 1:w] = crop[r, 0 : w - 1]
+    return out
+
+
+def _shift_selected_rows_left(crop: np.ndarray) -> np.ndarray:
+    out = crop.copy()
+    h, w = crop.shape
+    for r in range(h):
+        distance = h - 1 - r
+        if distance >= 2 and distance % 2 == 0:
+            out[r, 0 : w - 1] = crop[r, 1:w]
+            out[r, w - 1] = BG
+    return out
+
+
+def _shift_top_anchored_right(crop: np.ndarray) -> np.ndarray:
+    out = crop.copy()
+    h, w = crop.shape
+    for r in range(0, h, 2):
+        out[r, 0] = BG
+        out[r, 1:w] = crop[r, 0 : w - 1]
+    return out
+
+
+def _shift_wrong_bottom_phase(crop: np.ndarray) -> np.ndarray:
+    out = crop.copy()
+    h, w = crop.shape
+    for r in range(h):
+        distance = h - 1 - r
+        if distance % 2 == 1:
+            out[r, 0] = BG
+            out[r, 1:w] = crop[r, 0 : w - 1]
+    return out
+
+
