+    return panel
+
+
+def _panel_box_in_cell(cell: tuple[int, int, int, int], dims: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, r1, c0, c1 = cell
+    height, width = dims
+    top = random.randint(r0, r1 - height)
+    left = random.randint(c0, c1 - width)
+    return top, left, top + height - 1, left + width - 1
+
+
