+        shift_rows = [r for r in range(crop.shape[0]) if (crop.shape[0] - 1 - r) >= 2 and (crop.shape[0] - 1 - r) % 2 == 0]
+        fixed_rows = [r for r in range(crop.shape[0]) if r not in shift_rows]
