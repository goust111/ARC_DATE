+        if len(winners) != 1:
+            return False
+
+        winner = winners[0]
+        if not any(panel["area"] > winner["area"] for panel in panels if panel is not winner):
+            return False
+        crop = winner["crop"]
+        expected = _shift_selected_rows_right(crop)
