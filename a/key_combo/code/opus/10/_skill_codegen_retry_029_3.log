  "type": "transform_in_place",
  "src": "single-color 4-connected foreground lattice rows inside the object bbox",
  "transform": "anchor the bottom bbox row; moving upward, leave every other row fixed and shift the intervening rows one pixel left/right in alternating order"
}
</annotation>
