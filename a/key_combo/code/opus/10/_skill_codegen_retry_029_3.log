+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_panels(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    panels = []
+
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] == BG or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] != BG:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            crop = grid[r0 : r1 + 1, c0 : c1 + 1]
+            colors = set(map(int, np.unique(crop)))
+            if not colors.issubset({BG, MARKER, PANEL}):
+                continue
+            if MARKER not in colors and PANEL not in colors:
+                continue
+            panels.append(
