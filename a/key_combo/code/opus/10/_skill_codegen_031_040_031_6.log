+    width = mask.shape[1]
+    best_k, best_score, second_best = _best_vertical_axis(coords, width)
+    pts = set(coords)
+    clean = np.zeros_like(mask, dtype=bool)
+    for r, c in coords:
+        mirror_c = best_k - c
+        if 0 <= mirror_c < width and (r, mirror_c) in pts:
