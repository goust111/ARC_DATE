+        submask = clean_mask[box[0] : box[2] + 1, box[1] : box[3] + 1]
+        patch[submask] = color
+        layers.append(
+            {
+                "color": color,
+                "raw_count": int(raw_mask.sum()),
+                "clean_count": int(clean_mask.sum()),
+                "best_k": int(best_k),
+                "best_score": int(best_score),
+                "second_best": int(second_best),
+                "bbox": box,
+                "patch": patch,
+            }
+        )
