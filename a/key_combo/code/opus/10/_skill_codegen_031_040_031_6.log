+
+BG = 0
+COLOR_POOL = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+
+GRID_SIDE_RANGE = (19, 20)
+COLOR_COUNT_CHOICES = (3, 4)
+
+MIN_CLEAN_H = 3
+MAX_CLEAN_H = 5
+MIN_CLEAN_W = 3
+MAX_CLEAN_W = 5
+MIN_CLEAN_COUNT = 6
+MAX_CLEAN_COUNT = 14
+
+LOCAL_PAD = 1
+MAX_NOISE_PER_COLOR = 6
+BEST_AXIS_GAP_MIN = 2
+GEN_ATTEMPTS = 600
+SHAPE_ATTEMPTS = 240
+NOISE_ATTEMPTS = 120
