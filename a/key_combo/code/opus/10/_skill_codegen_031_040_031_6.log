+    best_score = -1
+    second_best = -1
+    for k in range(0, 2 * (width - 1) + 1):
+        score = _axis_score(pts, width, k)
+        if score > best_score:
+            second_best = best_score
+            best_score = score
+            best_k = k
+        elif score > second_best:
+            second_best = score
+    return int(best_k), int(best_score), int(second_best)
