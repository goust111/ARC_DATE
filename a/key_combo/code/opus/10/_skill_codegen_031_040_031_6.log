+    canvas = np.zeros((h + 2 * LOCAL_PAD, w + 2 * LOCAL_PAD), dtype=int)
+    canvas[LOCAL_PAD : LOCAL_PAD + h, LOCAL_PAD : LOCAL_PAD + w] = sprite
