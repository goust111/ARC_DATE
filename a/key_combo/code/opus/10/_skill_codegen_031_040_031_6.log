+            side_w = w // 2
+            if w % 2 == 0:
+                if target_count % 2 != 0:
+                    continue
+                left_count = target_count // 2
+                if h <= left_count <= h * side_w:
+                    specs.append((h, w, 0))
+            else:
+                for center_count in range(0, h + 1):
+                    if (target_count - center_count) < 0 or (target_count - center_count) % 2 != 0:
+                        continue
+                    left_count = (target_count - center_count) // 2
+                    if h <= left_count <= h * side_w:
