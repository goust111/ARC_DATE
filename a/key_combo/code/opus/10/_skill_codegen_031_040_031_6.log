+    cols[random.randrange(h)] = 0
+    if side_w > 1:
+        cols[random.randrange(h)] = side_w - 1
+    cells = {(r, cols[r]) for r in range(h)}
+    all_cells = [(r, c) for r in range(h) for c in range(side_w)]
+    while len(cells) < left_count:
