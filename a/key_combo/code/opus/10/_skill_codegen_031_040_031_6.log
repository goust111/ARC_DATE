+    width = clean_mask.shape[1]
+    cols = np.arange(width)
+    mirror_cols = true_k - cols
+    on_axis = mirror_cols == cols
+    adj[:, on_axis] = False
+    valid = (mirror_cols >= 0) & (mirror_cols < width) & ~on_axis
+    for c in np.where(valid)[0]:
+        adj[:, c] &= ~clean_mask[:, mirror_cols[c]]
