+    width = sum(int(p.shape[1]) for p in patches) + max(0, len(patches) - 1)
+    out = np.zeros((height, width), dtype=int)
+    c0 = 0
+    for idx, patch in enumerate(patches):
+        h, w = patch.shape
+        out[:h, c0 : c0 + w] = patch
