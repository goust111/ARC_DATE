+        (1, 1, mid_r - 2, mid_c - 2),
+        (1, mid_c + 1, mid_r - 2, width - 2),
+        (mid_r + 1, 1, height - 2, mid_c - 2),
+        (mid_r + 1, mid_c + 1, height - 2, width - 2),
