+def _noise_candidates(clean_mask: np.ndarray, true_k: int) -> list[tuple[int, int]]:
+    adj = np.zeros_like(clean_mask, dtype=bool)
+    adj[1:, :] |= clean_mask[:-1, :]
+    adj[:-1, :] |= clean_mask[1:, :]
+    adj[:, 1:] |= clean_mask[:, :-1]
+    adj[:, :-1] |= clean_mask[:, 1:]
+    adj &= ~clean_mask
