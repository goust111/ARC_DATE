+    expected = _expected_output_from_specs(specs)
+    if max(expected.shape) > 30:
+        return None
+    if not _validate_case(grid, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
