+def _expected_output_from_specs(specs: list[dict]) -> np.ndarray:
+    ordered = sorted(specs, key=lambda spec: (-spec["clean_count"], spec["slot_index"]))
+    return _pack_patches([spec["clean_patch"] for spec in ordered])
+
