+    fragments: list[np.ndarray] = []
+    for cells in buckets.values():
+        fragments.extend(_components_from_cells(cells))
+    return fragments
+
+
+def _ordered_fragments(sprites: list[np.ndarray], markers: list[int]) -> list[np.ndarray]:
+    fragments: list[np.ndarray] = []
+    for sprite in sprites:
