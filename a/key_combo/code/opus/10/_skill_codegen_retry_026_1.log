+    for item in placed:
+        moved = item["moved"]
+        out[moved[:, 0], moved[:, 1]] = BLUE
+
+    meta = {
+        "divider_r": divider_r,
+        "markers": markers,
+        "sprites": sprites,
+        "fragments": fragments,
+        "placed": placed,
