+        assert any(w > 1 for w in widths), "each sprite must create a multi-column fragment"
+        fragments.extend(parts)
+    fragments.sort(key=lambda frag: (-int(frag[:, 0].max()), int(frag[:, 1].min())))
+    return fragments
+
+
+def _drop_fragment(
+    fragment: np.ndarray,
+    divider_r: int,
+    occupied: np.ndarray,
+) -> np.ndarray:
+    coords = fragment.copy()
+    width = _width(coords)
+    H, _W = occupied.shape
+    shift = 0
+    while True:
+        moved = coords.copy()
+        moved[:, 0] += shift + 1
+        if width == 1:
+            if np.any(moved[:, 0] >= H):
+                break
