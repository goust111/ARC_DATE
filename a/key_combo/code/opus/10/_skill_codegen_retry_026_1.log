  "type": "move_to_match",
  "src": "blue marker mask s left of the full-height grey divider",
  "dst": "red marker mask d in the mirror slot between the old and shifted divider",
  "match_cond": "d.column_span == reflection of s.column_span across the old divider",
  "transform": "move the grey divider from column k to column 2*k+1; recolor matched d from red to blue and preserve all other markers"
}
</annotation>
<generation_spec>
