+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        inp = _build_input()
+        try:
+            _semantic_check(inp)
+            out = main(inp)
+            assert out.shape == inp.shape
+            return inp
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid non-degenerate input")

