+    assert len(set(gaps)) == 1, "lattice spacing must be uniform"
+    bands = []
+    for a, b in zip(walls, walls[1:]):
+        assert b - a >= 2, "each lattice cell needs positive interior area"
+        bands.append((a + 1, b - 1))
+    return bands
+
