+    wall_cols = _full_line_positions(grid, Color.TEAL, axis=1)
+    assert len(wall_rows) >= 2 and len(wall_cols) >= 2, "expected a teal lattice"
+    row_bands = _cell_bands(wall_rows)
+    col_bands = _cell_bands(wall_cols)
