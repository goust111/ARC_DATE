    count: exactly 1
  squares:
    color: single object_color shared by all squares
    shape: solid NxN squares, side lengths 1-7
    count: 5-11 total, at least 1 odd-sided, 0+ even-sided
    odd_count: 2-8; even_count: 3 [observed]
    separation: min Manhattan distance >=2 between any two components (including marker)
    may touch grid edges
  transform:
    odd_squares: center pixel recolored to marker_color
    even_squares: unchanged
