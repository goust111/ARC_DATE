  blockers:
    count: 0-3; color 1 (blue) [observed]; single color per grid
    placement: every blocker must lie on the actual (possibly already-deflected) diagonal path
    shape: 1-2 horizontally adjacent cells per row; at most 2 distinct rows carry blockers
  trail:
