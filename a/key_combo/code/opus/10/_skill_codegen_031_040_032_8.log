+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+YELLOW = 4
+GREY = 5
+OBJ_COLORS = (1, 2, 3, 6)
+ALL_OBJECT_COLORS = set(OBJ_COLORS)
+
+SHAPES: tuple[tuple[tuple[int, int], ...], ...] = (
+    ((0, 0), (0, 1)),
