+    return random.choice(candidates)
+
+
+def _plan_boundary_object(
+    height: int,
+    width: int,
+    direction: str,
+    existing: list[dict],
+) -> dict | None:
+    shapes = list(SHAPES)
+    random.shuffle(shapes)
+    for shape in shapes:
