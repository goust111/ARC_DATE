MOTIF_POS_MAX = 4                             # exclusive upper bound for top-left position (0..3)
FG_COLORS = [1, 2, 3, 4, 5, 6, 8]            # valid foreground colors (exclude 0, 7, 9)
MAX_RETRIES = 300                             # oracle-validation retry budget

