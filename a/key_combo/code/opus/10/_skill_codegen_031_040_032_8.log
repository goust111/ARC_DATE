spec:
  grid: fixed 4 rows x 9 cols, black background
  objects:
    count: exactly 2 monochrome 4-connected foreground objects, distinct non-black colors
    arrangement: left-to-right, column-separated by >=0 all-black columns (gap 0-4 [observed])
    bbox_isolation: each object's bbox contains only its color and black (no overlap between bboxes)
    bbox_size: 3-5 rows x 3-5 cols [observed]
    shape: |
      single 4-connected component forming a closed loop that encloses >=1 black pixel.
      Most are rectangular frames (all bbox-border cells colored); some are irregular
      with 1-2 bg cells on bbox border and 1-2 colored cells in interior, but still
