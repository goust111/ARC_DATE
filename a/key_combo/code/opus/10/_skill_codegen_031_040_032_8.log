+
+
+def _render_input(height: int, width: int, plans: list[dict]) -> np.ndarray:
+    grid = _checkerboard(height, width)
+    for plan in plans:
+        for r, c in plan["input_cells"]:
+            grid[r, c] = int(plan["color"])
+    return grid
