+        for c in range(c0 + c_step, c1 + c_step, c_step):
+            path.append((r0, c))
+        r_step = 1 if r1 > r0 else -1
+        for r in range(r0 + r_step, r1 + r_step, r_step):
+            path.append((r, c1))
+    else:
