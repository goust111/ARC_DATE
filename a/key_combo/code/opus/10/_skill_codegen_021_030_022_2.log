+def _analyze_grid(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert set(map(int, np.unique(g))) <= {BLACK, BLUE, RED, GREEN}
