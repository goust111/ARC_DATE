+            return None
+        placed.append(chosen)
+        occupied_groups.append(chosen)
+    return placed
+
+
+def _build_grid(
+    shape: tuple[int, int],
+    green_pair: tuple[Coord, Coord],
+    blue_pair: tuple[Coord, Coord],
+    red_objects: list[set[Coord]],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for obj in red_objects:
+        for r, c in obj:
