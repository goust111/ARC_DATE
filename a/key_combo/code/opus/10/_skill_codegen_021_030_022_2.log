+
+def _shape_variants(base: tuple[Coord, ...]) -> list[tuple[Coord, ...]]:
+    normalized = _normalize_shape(list(base))
+    height = max(r for r, _ in normalized) + 1
+    width = max(c for _, c in normalized) + 1
