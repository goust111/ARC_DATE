+    targets = set(_adjacent_black_cells(grid, target_box))
+    assert starts and targets
+
+    dist = np.full(grid.shape, -1, dtype=int)
+    queue = deque()
+    for r, c in starts:
+        dist[r, c] = 1
+        queue.append((r, c))
+
+    while queue:
+        r, c = queue.popleft()
+        if (r, c) in targets:
+            return int(dist[r, c] + 1)
+        for dr, dc in DIR4:
