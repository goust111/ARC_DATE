+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDE_SETS = (("right", "top"), ("right", "bottom"), ("right", "top", "bottom"))
+GENERATE_ATTEMPTS = 500
