+
+
+def _shortest_black_path_stats(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+) -> tuple[int, int]:
+    dist = {start: 0}
+    ways = {start: 1}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]) or grid[nr, nc] != BLACK:
+                continue
+            nd = dist[(r, c)] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                ways[nxt] = ways[(r, c)]
+                queue.append(nxt)
+            elif dist[nxt] == nd:
+                ways[nxt] = min(2, ways[nxt] + ways[(r, c)])
+    assert goal in dist
+    return int(dist[goal]), int(min(2, ways[goal]))
+
