+    ways = {start: 1}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]) or grid[nr, nc] != BLACK:
+                continue
+            nd = dist[(r, c)] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                ways[nxt] = ways[(r, c)]
+                queue.append(nxt)
+            elif dist[nxt] == nd:
+                ways[nxt] = min(2, ways[nxt] + ways[(r, c)])
+    assert goal in dist
+    return int(dist[goal]), int(min(2, ways[goal]))
+
+
+def _black_component(grid: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and grid[nr, nc] == BLACK and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
