+def _black_component(grid: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and grid[nr, nc] == BLACK and nxt not in seen:
+                seen.add(nxt)
+                queue.append(nxt)
+    return seen
