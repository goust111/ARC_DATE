+    width: int,
+    source_origin: tuple[int, int],
+) -> list[tuple[int, int, int, int]]:
+    border = _border_mask(height, width)
+    windows: list[tuple[int, int, int, int]] = []
+    for r0 in range(grid.shape[0] - height + 1):
