+
+    if not _validate_instance(grid, template_box, window_boxes, source_door, window_doors, frame_color, fill_color):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_ATTEMPTS):
+        grid = _gen_attempt()
