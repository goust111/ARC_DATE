+
+
+def _box_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    ar0, ac0, ah, aw = a
+    br0, bc0, bh, bw = b
+    return not (
+        ar0 + ah - 1 + pad < br0
+        or br0 + bh - 1 + pad < ar0
+        or ac0 + aw - 1 + pad < bc0
+        or bc0 + bw - 1 + pad < ac0
