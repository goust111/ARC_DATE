import random
import numpy as np
from collections import Counter

COLORS=[1,2,3,4]
OB=5
BG=0


def make_tile(shape):
    th,tw=shape
    while True:
        cols=random.sample(COLORS, random.choice([2,3]))
        tile=np.array([[random.choice(cols) for _ in range(tw)] for _ in range(th)],dtype=int)
        if len(set(map(int,tile.ravel())))<2:
            continue
        ok=True
        for pr in range(1,th+1):
            for pc in range(1,tw+1):
                if pr==th and pc==tw:
                    continue
                small=np.empty((pr,pc),dtype=int)
                for r in range(pr):
                    for c in range(pc):
                        small[r,c]=tile[r,c]
                if all(tile[r,c]==small[r%pr,c%pc] for r in range(th) for c in range(tw)):
                    ok=False
        if ok:
            return tile


def infer(g):
    H,W=g.shape
    known=np.argwhere((g"'!=BG)&(g!=OB))
    cands=[]
    for pr in range(1,H+1):
        for pc in range(1,W+1):
            tile=np.full((pr,pc),-1,dtype=int)
            good=True
            for r,c in known:
                rr=r%pr; cc=c%pc; val=int(g[r,c])
                if tile[rr,cc]==-1: tile[rr,cc]=val
                elif tile[rr,cc]!=val:
                    good=False; break
            if good and not np.any(tile==-1):
                cands.append((pr*pc,pr,pc,tile.copy()))
    if not cands: raise ValueError
    area=min(x[0] for x in cands)
    best=[x for x in cands if x[0]==area]
    assert len(best)==1
    _,pr,pc,tile=best[0]
    return pr,pc,tile


def shadow_mask(g):
    H,W=g.shape
    mask=np.zeros((H,W),dtype=bool)
    for r,c in np.argwhere(g==OB):
        r=int(r); c=int(c)
        rr=r+1
        while rr<H and int(g[rr,c])==BG:
            mask[rr,c]=True
            rr+=1
    return mask


def solve(g):
    pr,pc,tile=infer(g)
    out=g.copy()
    sh=shadow_mask(g)
    for r,c in np.argwhere(g==BG):
        r=int(r); c=int(c)
        if not sh[r,c]: out[r,c]=tile[r%pr,c%pc]
    return out


def construct():
    H=random.randint(11,16); W=random.randint(11,16)
    shape=random.choice([(2,2),(3,2)])
