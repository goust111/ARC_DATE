    full=np.fromfunction(lambda r,c: tile[r%shape[0],c%shape[1]], (H,W), dtype=int)
    holes=set(); obstacles=[]
    obstacle_count=random.choice([1,2,3])
    columns=random.sample(range(W), obstacle_count)

    # first obstacle: stop branch + counterexample below stopper
    c=columns[0]
    r=random.randint(1, H-5)
    shadow_len=random.randint(1, min(3, H-r-3))
    stopper=r+shadow_len+1
    extra=random.randint(stopper+1, H-1)
    obstacles.append((r,c))
    for rr in range(r+1, r+shadow_len+1): holes.add((rr,c))
    holes.add((extra,c))

    for idx,c in enumerate(columns[1:], start=1):
        mode=random.choice(['"'bottom','stop'])
        if mode=='bottom':
            r=random.randint(max(0,H-4), H-2)
            obstacles.append((r,c))
            for rr in range(r+1, H): holes.add((rr,c))
        else:
            if H < 6: continue
            r=random.randint(0, H-4)
            max_shadow=min(2, H-r-2)
            if max_shadow < 1:
                r=H-3; max_shadow=1
            shadow_len=random.randint(1,max_shadow)
            obstacles.append((r,c))
            for rr in range(r+1, r+shadow_len+1): holes.add((rr,c))
            if r+shadow_len+2 < H and random.random()<0.6:
                holes.add((random.randint(r+shadow_len+2,H-1), c))

    obstacle_set=set(obstacles)
    holes={p for p in holes if p not in obstacle_set}
    if len(holes) > 10:
        return None

    g=full.copy()
