    blocked=[(r,c) for r,c in holes if sh[r,c]]
    if not filled_candidates or not blocked:
        return None

    # add extra unshadowed holes to reach 5..10
    available=[(r,c) for r in range(H) for c in range(W) if (r,c) not in holes and (r,c) not in obstacle_set]
    random.shuffle(available)
