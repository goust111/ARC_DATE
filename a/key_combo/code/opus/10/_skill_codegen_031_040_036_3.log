spec:
  grid: 22x22 (fixed)
  tile:
    shape: NxN square, N in 3-8
    symmetry: transpose (tile == tile.T) [observed]
    colors: 3-7 distinct non-black colors (no color 0 in tile)
    uniqueness: exactly one minimal-area tile consistent with all known pixels
  holes:
    count: 4-5 rectangular regions of black (color 0)
    sizes: 4-34 cells each; total 46-65 cells (9-14% of grid)
    shape: rectangular bbox, nearly always perfectly filled [observed]
