+
+    parsed_template, parsed_blue_cols, parsed_red_rows = _build_template(seed_cell)
+    if parsed_blue_cols != blue_cols or parsed_red_rows != red_rows:
+        return False
+
+    if any(seed_cell[r, c] != BLACK for r in red_rows for c in blue_cols):
