+    return out
+
+
+def _validate_generated_instance(
+    inp: np.ndarray,
+    *,
+    seed_r: int,
+    seed_c: int,
+    blue_cols: list[int],
+    red_rows: list[int],
+    border: bool,
+) -> bool:
