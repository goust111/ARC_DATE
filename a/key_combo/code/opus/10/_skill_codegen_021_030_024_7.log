+        separators = [5, 11]
+    grid = np.zeros((size, size), dtype=int)
+    grid[separators, :] = GREY
+    grid[:, separators] = GREY
+    row_runs = _open_runs(size, np.array(separators, dtype=int))
+    col_runs = _open_runs(size, np.array(separators, dtype=int))
+    return grid, row_runs, col_runs
+
+
