+
+def _flood_mask(mask: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = mask.shape
+    sr, sc = start
+    seen = np.zeros((h, w), dtype=bool)
+    if not mask[sr, sc]:
+        return seen
+    stack = [(sr, sc)]
+    seen[sr, sc] = True
