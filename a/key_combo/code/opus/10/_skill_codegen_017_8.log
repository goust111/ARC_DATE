    lower_count = random.choice([3, 5]) if odd_region == "lower" else random.choice([2, 4])

    collision_region = random.choice(["upper", "lower"])
    occupied: set[tuple[int, int]] = set()

    upper_cells = _place_region_pixels(
        upper_mask,
