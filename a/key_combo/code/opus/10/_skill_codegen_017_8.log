+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_DIR8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
+    (1, 0),
