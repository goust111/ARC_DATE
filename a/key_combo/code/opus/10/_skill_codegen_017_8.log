+    h, w = mask.shape
+    sr, sc = start
+    seen = np.zeros((h, w), dtype=bool)
+    if not mask[sr, sc]:
+        return seen
+    stack = [(sr, sc)]
+    seen[sr, sc] = True
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in _DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
+    return seen
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    unseen = mask.copy()
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not unseen[r, c]:
