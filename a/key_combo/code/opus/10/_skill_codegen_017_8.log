+def _slide_region(
+    blues: list[tuple[int, int]],
+    *,
+    region_name: str,
+    toward_wall: bool,
+    wall_top: np.ndarray,
+    wall_bottom: np.ndarray,
+    h: int,
+) -> list[tuple[int, int]]:
+    if not blues:
+        return []
+
+    if region_name == "upper":
+        if toward_wall:
+            target = lambda c: int(wall_top[c] - 1)
+            priority = lambda rc: (target(rc[1]) - rc[0], -rc[0], rc[1])
+            retreat = -1
+            valid = lambda src_r, dst_r: dst_r >= src_r
+        else:
