    lower_cells = _place_region_pixels(
        lower_mask,
        wall,
        wall_top,
        wall_bottom,
        region_name="lower",
        toward_wall=(odd_region == "lower"),
        count=lower_count,
        require_collision=(collision_region == "lower"),
        occupied=occupied,
    )
    if lower_cells is None:
        return None

    for r, c in upper_cells + lower_cells:
        grid[r, c] = BLUE

