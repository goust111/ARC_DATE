+            target = lambda c: int(wall_bottom[c] + 1)
+            priority = lambda rc: (rc[0] - target(rc[1]), rc[0], rc[1])
+            retreat = 1
+            valid = lambda src_r, dst_r: dst_r <= src_r
+        else:
+            target = lambda c: h - 1
+            priority = lambda rc: ((h - 1) - rc[0], -rc[0], rc[1])
+            retreat = -1
+            valid = lambda src_r, dst_r: dst_r >= src_r
