    for c in range(1, w):
        a = profile[c - 1]
        b = profile[c]
        wall[min(a, b) : max(a, b) + 1, c] = True
    return wall


def _candidate_rows_by_col(
    region_mask: np.ndarray,
    wall: np.ndarray,
    wall_top: np.ndarray,
    wall_bottom: np.ndarray,
    *,
    region_name: str,
    toward_wall: bool,
) -> dict[int, list[int]]:
    h, w = region_mask.shape
    out: dict[int, list[int]] = {}
    for c in range(w):
