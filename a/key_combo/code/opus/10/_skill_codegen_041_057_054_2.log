+    arr = np.asarray(coords, dtype=int)
+    r0, c0, r1, c1 = _bbox_from_coords(arr)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for rc in coords:
+        out[rc[0] - r0, rc[1] - c0] = values[rc]
+    return out
