+
+def _fits_patch(
+    patch: np.ndarray,
+    occupied: np.ndarray,
+    top: int,
+    left: int,
+) -> bool:
+    h, w = patch.shape
+    H, W = occupied.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return False
+    mask = patch != BG
+    if not mask.any():
+        return False
+    r0 = max(0, top - 1)
+    c0 = max(0, left - 1)
+    r1 = min(H, top + h + 1)
+    c1 = min(W, left + w + 1)
+    if occupied[r0:r1, c0:c1].any():
+        return False
+    return True
+
+
+def _paste_nonzero(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    mask = patch != BG
+    view = dst[top : top + h, left : left + w]
+    view[mask] = patch[mask]
+
