+    out[norm_gate] = GREEN
+    inp[norm_marker] = color
+    out[norm_parking] = color
+    for r, c in norm_interior:
+        out[r, c] = color
+
+    return {
+        "input_patch": inp,
+        "output_patch": out,
+        "color": color,
+        "open_dir": open_dir,
+        "turn_count": turn_count,
+        "gate": norm_gate,
+        "parking": norm_parking,
+        "entry": norm_entry,
+        "marker": norm_marker,
+        "gate_ends": norm_gate_ends,
+        "wall": norm_wall,
+        "interior": norm_interior,
+        "path": set(norm_path),
+        "erased": set(norm_path) - {norm_parking},
+        "shape": inp.shape,
