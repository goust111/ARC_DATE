+    rows = [r for r, _ in mapping.values()]
+    cols = [c for _, c in mapping.values()]
+    h = max(rows) + 1
+    w = max(cols) + 1
+
+    inp = np.zeros((h, w), dtype=int)
+    out = np.zeros((h, w), dtype=int)
+
+    for r, c in norm_wall:
+        inp[r, c] = ORANGE
+        out[r, c] = ORANGE
+    for r, c in norm_gate_ends:
+        inp[r, c] = MAROON
+        out[r, c] = MAROON
+    for r, c in norm_path:
+        inp[r, c] = GREEN
