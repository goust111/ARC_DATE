+        "parking": parking,
+        "entry": entry,
+        "wall": wall,
+        "interior": interior,
+    }
+
+
+def _segment_split(turn_count: int, total_path: int) -> list[int]:
+    tail = total_path - 1
+    if turn_count == 0:
+        return [tail]
+    if turn_count == 1:
+        a = random.randint(1, min(3, tail - 1))
+        return [a, tail - a]
+    a = random.randint(1, min(3, tail - 2))
