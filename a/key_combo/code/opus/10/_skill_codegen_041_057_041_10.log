16: def _reachable(
17:     g: np.ndarray,
18:     bg: int,
19:     seed: tuple[int, int],
20:     moves: list[tuple[int, int]],
21:     bounds: tuple[int, int, int, int],
22: ) -> np.ndarray:
23:     r0, c0, r1, c1 = bounds
24: 
25:     def valid(r: int, c: int) -> bool:
