20: def _strictly_contains(outer: dict, inner: dict) -> bool:
21:     r0, c0, r1, c1 = outer["bbox"]
22:     rr0, cc0, rr1, cc1 = inner["bbox"]
23:     return r0 < rr0 and c0 < cc0 and rr1 < r1 and cc1 < c1
