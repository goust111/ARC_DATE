737:     Returns:
738:         (r0,c0) or None if no placement exists.
739:     """
740:     H, W = canvas.shape
741:     h, w = patch.shape
742:     border = int(border)
743:     padding = int(padding)
744:     bg = int(transparent)
745: 
746:     if h <= 0 or w <= 0:
747:         return None
748:     if H - h + 1 - border <= border or W - w + 1 - border <= border:
749:         return None
750: 
751:     # Occupancy of the canvas (optionally dilated to enforce padding).
752:     occ = (canvas != bg)
753:     if padding > 0:
754:         if int(padding_connectivity) == 4:
755:             struct = STRUCT4
756:         elif int(padding_connectivity) == 8:
757:             struct = STRUCT8
758:         else:
759:             raise ValueError("first_free_location: padding_connectivity must be 4 or 8")
760:         occ = ndimage.binary_dilation(occ, iterations=padding, structure=struct)
761: 
762:     patch_mask = (patch != bg)
763:     if not bool(patch_mask.any()):
764:         # Empty patch: any in-bounds location works; choose first.
765:         return int(border), int(border)
766: 
767:     for r0 in range(border, H - h + 1 - border):
768:         for c0 in range(border, W - w + 1 - border):
769:             if not bool((occ[r0 : r0 + h, c0 : c0 + w] & patch_mask).any()):
770:                 return int(r0), int(c0)
771:     return None
