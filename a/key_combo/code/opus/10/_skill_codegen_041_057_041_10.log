27: 
28:     assert valid(*seed)
29:     seen = np.zeros(g.shape, dtype=bool)
30:     seen[seed] = True
31:     q = deque([seed])
32:     while q:
33:         r, c = q.popleft()
34:         for dr, dc in moves:
35:             rr, cc = r + dr, c + dc
36:             if valid(rr, cc) and not seen[rr, cc]:
37:                 seen[rr, cc] = True
38:                 q.append((rr, cc))
39:     return seen
