113: def _gen_distribute_counts(total: int, roots: int, cap: int) -> list[int]:
114:     childless = random.choice(_gen_count_options(total, roots, cap))
115:     counts = [_GEN_CHILDLESS_ROOT_NODES] * childless + [_GEN_CHILD_ROOT_MIN_NODES] * (roots - childless)
116:     remaining = total - sum(counts)
