+import numpy as np
+
+
+BG = 0
+BAR = 5
+BLUE = 1
+RED = 2
+PIECE_COLORS = [3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
