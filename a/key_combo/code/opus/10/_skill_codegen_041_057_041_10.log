+    for r, c in coords:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask
+
+
+def mask_cells(mask: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    pts = []
+    for r, c in np.argwhere(mask):
+        pts.append((top + int(r), left + int(c)))
+    return pts
+
