6: def main(grid: np.ndarray) -> np.ndarray:
7:     """
8:     Connect framed squares via colored bridges following a control-pixel sequence.
9: 
10:     Input structure:
11:     - bg = background. Border color forms equal-sized framed squares with unique inner fill colors.
12:     - Control row below squares: colored pixels read left-to-right encode visitation order.
13: 
14:     Rule:
15:     - Start at the square matching first control color c0.
16:     - For each consecutive pair (ci, ci+1), find the ci+1-colored square aligned in the same row or column band, preferring nearest.
17:     - Draw a bridge colored ci between the pair, spanning the gap with inner-square thickness.
18: 
19:     Key insight: Row/column-band alignment plus proximity resolves ambiguity when inner colors repeat.
20:     """
21:     g = np.array(grid, dtype=int)
22:     H, W = g.shape
23:     bg = int(get_bg(g))
24: 
25:     # border color = most common non-bg color
26:     cnt = Counter(map(int, g.flatten()))
27:     border = None
28:     for col, _k in cnt.most_common():
29:         if int(col) != int(bg):
30:             border = int(col)
31:             break
32:     assert not (border is None)
33: 
34:     # detect framed squares as connected components of the border color
35:     lab, n = label_mask(g == int(border), connectivity=4)
36:     frames: list[dict] = []
37:     for cid in range(1, int(n) + 1):
38:         pts = np.argwhere(lab == int(cid))
39:         if int(pts.shape[0]) < 8:
40:             continue
41:         r0, c0 = pts.min(axis=0)
42:         r1, c1 = pts.max(axis=0)
43:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
44:         h = int(r1 - r0 + 1)
45:         w = int(c1 - c0 + 1)
46:         if h < 3 or w < 3:
47:             continue
48: 
49:         t = None
50:         inner_col = None
51:         for tt in range(1, int(min(h, w) // 2) + 1):
52:             inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]
53:             if inner.size == 0:
54:                 continue
55:             if bool((inner == int(border)).any()):
56:                 continue
57:             u = set(map(int, inner.flatten()))
58:             if len(u) != 1:
59:                 continue
60: 
61:             ok = True
62:             if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):
63:                 ok = False
64:             if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):
65:                 ok = False
66:             if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):
67:                 ok = False
68:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):
69:                 ok = False
70:             if not ok:
71:                 continue
72: 
73:             t = int(tt)
74:             inner_col = int(next(iter(u)))
75:             break
76: 
77:         if t is None or inner_col is None:
78:             continue
79: 
80:         frames.append(
81:             {
82:                 "bbox": (int(r0), int(c0), int(r1), int(c1)),
83:                 "t": int(t),
84:                 "inner": int(inner_col),
85:                 "inner_bbox": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),
86:             }
87:         )
88: 
89:     assert not (not frames)
90: 
91:     by: dict[int, list[dict]] = defaultdict(list)
92:     for f in frames:
93:         by[int(f["inner"])].append(f)
94: 
95:     max_frame_r = max(int(f["bbox"][2]) for f in frames)
96: 
97:     # control row = bottom-most row below the squares with >=2 non-bg pixels
98:     ctrl_r = None
99:     for r in range(int(H - 1), int(max_frame_r), -1):
100:         if int((g[int(r)] != int(bg)).sum()) >= 2:
101:             ctrl_r = int(r)
102:             break
103:     assert not (ctrl_r is None)
104: 
105:     ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]
106:     assert not (len(ctrl) < 2)
107: 
108:     def center(f: dict) -> tuple[int, int]:
109:         r0, c0, r1, c1 = map(int, f["bbox"])
110:         return int((r0 + r1) // 2), int((c0 + c1) // 2)
111: 
112:     def aligned(f1: dict, f2: dict) -> tuple[bool, bool]:
113:         a = f1["inner_bbox"]
114:         b = f2["inner_bbox"]
115:         same_row = bool(int(a[0]) == int(b[0]) and int(a[2]) == int(b[2]))
116:         same_col = bool(int(a[1]) == int(b[1]) and int(a[3]) == int(b[3]))
117:         return same_row, same_col
118: 
119:     # choose start frame
120:     start_color = int(ctrl[0])
121:     assert not (start_color not in by)
122:     start_cands = by[start_color]
123:     if len(start_cands) == 1:
124:         cur = start_cands[0]
125:     else:
126:         nxt_color = int(ctrl[1])
127:         nxt_cands = by.get(nxt_color, [])
128:         best = None
129:         bestf = None
130:         for f in start_cands:
131:             for g2 in (nxt_cands if nxt_cands else [f]):
132:                 sr, sc = aligned(f, g2)
133:                 al = 1 if (sr or sc) else 0
134:                 (r1_, c1_) = center(f)
135:                 (r2_, c2_) = center(g2)
136:                 d = abs(int(r1_) - int(r2_)) + abs(int(c1_) - int(c2_))
137:                 cand = (int(al), -int(d))
138:                 if best is None or cand > best:
139:                     best = cand
140:                     bestf = f
141:         cur = bestf
142: 
143:     out = g.copy()
144: 
145:     def draw_bridge(fa: dict, fb: dict, color: int) -> None:
146:         (r0a, c0a, r1a, c1a) = map(int, fa["bbox"])
147:         (r0b, c0b, r1b, c1b) = map(int, fb["bbox"])
148:         ia = fa["inner_bbox"]
149:         sr, sc = aligned(fa, fb)
150:         if sr:
151:             rr0, rr1 = int(ia[0]), int(ia[2])
152:             if int(c1a) < int(c0b):
153:                 cc0, cc1 = int(c1a + 1), int(c0b - 1)
154:             else:
155:                 cc0, cc1 = int(c1b + 1), int(c0a - 1)
156:             for r in range(int(rr0), int(rr1) + 1):
157:                 for c in range(int(cc0), int(cc1) + 1):
158:                     if 0 <= r < H and 0 <= c < W:
159:                         out[int(r), int(c)] = int(color)
160:             return
161:         if sc:
162:             cc0, cc1 = int(ia[1]), int(ia[3])
163:             if int(r1a) < int(r0b):
164:                 rr0, rr1 = int(r1a + 1), int(r0b - 1)
165:             else:
166:                 rr0, rr1 = int(r1b + 1), int(r0a - 1)
167:             for r in range(int(rr0), int(rr1) + 1):
168:                 for c in range(int(cc0), int(cc1) + 1):
169:                     if 0 <= r < H and 0 <= c < W:
170:                         out[int(r), int(c)] = int(color)
