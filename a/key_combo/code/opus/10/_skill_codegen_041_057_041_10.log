26: def main(grid: np.ndarray) -> np.ndarray:
27:     """
28:     Recolor every nested foreground rectangle to the color of the outermost rectangle that contains it.
29: 
30:     Input structure
31:     - The background is the dominant color.
32:     - Every foreground object is a 4-connected monochromatic rectangular perimeter, possibly a degenerate rectangle with no interior.
33:     - Some rectangles are strictly nested inside the interior of larger rectangles.
34: 
35:     Rule
36:     - Find the foreground rectangles that are not strictly inside any other foreground rectangle.
37:     - For each such outermost rectangle, recolor every non-background pixel strictly inside its bbox to that rectangle's color.
38:     - Preserve the outermost rectangle borders, the background, and any top-level rectangle that has no foreground pixels inside it.
39: 
40:     Key insight
41:     - The visible containment hierarchy, not the inner objects' own colors or shapes, determines the replacement color.
42:     """
43:     g = np.asarray(grid, dtype=int)
44:     bg = get_bg(g)
45:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
46:     assert comps
47:     assert all(_is_rectangular_perimeter(comp) for comp in comps)
48: 
49:     outermost = [
50:         comp
51:         for comp in comps
52:         if not any(_strictly_contains(parent, comp) for parent in comps if parent is not comp)
53:     ]
54:     assert outermost
55:     assert any(
56:         _strictly_contains(parent, child)
57:         for parent in outermost
58:         for child in comps
59:         if child is not parent
60:     )
61: 
62:     out = g.copy()
63:     for comp in outermost:
64:         r0, c0, r1, c1 = comp["bbox"]
65:         if r1 <= r0 + 1 or c1 <= c0 + 1:
66:             continue
67:         interior = out[r0 + 1 : r1, c0 + 1 : c1]
68:         foreground = g[r0 + 1 : r1, c0 + 1 : c1] != bg
69:         interior[foreground] = int(comp["color"])
70:     return out
