+def canonical_root(width: int) -> np.ndarray:
+    if width == 1:
+        return np.array([[1], [1]], dtype=bool)
+    if width == 2:
+        return np.array([[1, 0], [1, 0], [1, 1]], dtype=bool)
+    return np.array([[1, 0, 1], [1, 0, 1], [1, 0, 1], [1, 1, 1]], dtype=bool)
