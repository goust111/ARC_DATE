300:                         if not BLOCK_ROOM_MIN <= n1 <= BLOCK_ROOM_MAX:
301:                             continue
302:                         bh1, bw1 = _block_shape(r1, c1, s1)
303:                         for r2 in ROOM_GRID_RANGE:
304:                             for c2 in ROOM_GRID_RANGE:
305:                                 n2 = r2 * c2
306:                                 total_rooms = n1 + n2
307:                                 valid_block2 = BLOCK_ROOM_MIN <= n2 <= BLOCK_ROOM_MAX
308:                                 valid_total = TOTAL_ROOM_MIN <= total_rooms <= TOTAL_ROOM_MAX
309:                                 if not (valid_block2 and valid_total):
310:                                     continue
311:                                 bh2, bw2 = _block_shape(r2, c2, s2)
312:                                 for gap in GAP_RANGE:
313:                                     approx = _layout_distance_estimate(r1, c1, s1, r2, c2, s2, gap)
314:                                     if approx < LAYOUT_DISTANCE_MIN:
