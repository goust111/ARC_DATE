+def classify_open_frame(comp: dict) -> dict | None:
+    r0, c0, r1, c1 = comp["bbox"]
+    pts = {(int(r), int(c)) for r, c in comp["coords"]}
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
