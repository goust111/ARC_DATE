+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] == g.shape[1], "expected a square 2D grid"
+    n = int(g.shape[0])
+    k = isqrt(n)
+    assert k * k == n, "expected side length N = k^2"
+
+    blocks = []
+    for br in range(k):
+        for bc in range(k):
+            block = g[br * k : (br + 1) * k, bc * k : (bc + 1) * k]
+            if np.any(block != BG):
+                blocks.append((br, bc))
