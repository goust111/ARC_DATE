+def _render_output(
+    grid: np.ndarray, cups: list[dict[str, Any]], amounts: list[int]
+) -> np.ndarray:
+    out = _copy_int_grid(grid)
+
+    for cup, amount in zip(cups, amounts):
+        left = int(cup["left"])
+        right = int(cup["right"])
+        top = int(cup["top"])
