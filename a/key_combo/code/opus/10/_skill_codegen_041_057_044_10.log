+def _copy_int_grid(grid: np.ndarray) -> np.ndarray:
+    return np.asarray(grid, dtype=int).copy()
+
+
+def _adjacent(cup_a: dict[str, int], cup_b: dict[str, int]) -> bool:
+    return int(cup_b["left"]) - int(cup_a["right"]) <= 2
