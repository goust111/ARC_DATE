+def _bbox_gap_ok(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return (
+        ar1 + MIN_BBOX_GAP < br0
+        or br1 + MIN_BBOX_GAP < ar0
+        or ac1 + MIN_BBOX_GAP < bc0
+        or bc1 + MIN_BBOX_GAP < ac0
