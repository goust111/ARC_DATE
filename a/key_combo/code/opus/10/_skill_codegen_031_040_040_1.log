+def _ray_span(shape: tuple[int, int], start: tuple[int, int], step: tuple[int, int]) -> int:
+    r, c = start
+    dr, dc = step
+    span = 0
+    r += dr
+    c += dc
+    while _in_bounds(shape, r, c):
