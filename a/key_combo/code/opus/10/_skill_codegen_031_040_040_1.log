+
+BG = 0
+GREY = 5
+OBJECT_COLORS = (1, 3, 6)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CORNER_DIRS = {
+    "ul": (-1, -1),
+    "ur": (-1, 1),
+    "ll": (1, -1),
+    "lr": (1, 1),
+}
+TOP_PAIR = ("ul", "ur")
+LEFT_PAIR = ("ul", "ll")
+BOX_CHOICES = ((4, 4), (4, 5), (5, 4))
+GEN_RETRIES = 400
+PLACEMENT_RETRIES = 200
+PATCH_RETRIES = 200
+SUBSET_RETRIES = 60
+MIN_MARGIN = 2
+MIN_BBOX_GAP = 2
