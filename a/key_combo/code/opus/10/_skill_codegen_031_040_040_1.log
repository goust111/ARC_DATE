+
+
+def _corner_map_from_bbox(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {
+        "ul": (r0, c0),
+        "ur": (r0, c1),
+        "ll": (r1, c0),
+        "lr": (r1, c1),
