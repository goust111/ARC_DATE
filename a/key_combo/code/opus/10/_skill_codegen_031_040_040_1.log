+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            parts.append(np.asarray(coords, dtype=int))
+    return parts
+
+
+def _is_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    stack = [next(iter(cells))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS4:
+            nb = (r + dr, c + dc)
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                stack.append(nb)
+    return len(seen) == len(cells)
+
+
+def _rect_cells(r0: int, c0: int, h: int, w: int) -> set[tuple[int, int]]:
+    return {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+
+
+def _border_cells(h: int, w: int) -> set[tuple[int, int]]:
+    cells = set()
+    for r in range(h):
+        cells.add((r, 0))
+        cells.add((r, w - 1))
+    for c in range(w):
+        cells.add((0, c))
+        cells.add((h - 1, c))
+    return cells
+
+
+def _corner_regions_visible(cells: set[tuple[int, int]], h: int, w: int) -> bool:
+    regions = [
+        _rect_cells(0, 0, min(2, h), min(2, w)),
+        _rect_cells(0, max(0, w - 2), min(2, h), min(2, w)),
+        _rect_cells(max(0, h - 2), 0, min(2, h), min(2, w)),
+        _rect_cells(max(0, h - 2), max(0, w - 2), min(2, h), min(2, w)),
+    ]
