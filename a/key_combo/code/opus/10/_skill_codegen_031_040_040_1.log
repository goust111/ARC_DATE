+            "h": h,
+            "w": w,
+            "visible_cells": visible,
+            "full_cells": cells,
+            "occ_bbox_rel": (occ_r0, occ_c0, occ_r0 + occ_h - 1, occ_c0 + occ_w - 1),
+            "occ_shape": (occ_h, occ_w),
+            "orientation": orientation,
+            "patch": patch,
+            "occ_mask": occ_mask,
+        }
+    return None
+
