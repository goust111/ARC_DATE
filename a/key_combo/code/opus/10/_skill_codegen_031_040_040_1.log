+        border = _border_cells(h, w)
+        host = _rect_cells(occ_r0, occ_c0, occ_h, occ_w)
+        cells = _try_remove_border_cells(rng, border, host, h, w)
+        if cells is None or len(cells) > 15:
+            continue
+        visible = cells - host
+        if not _is_connected(visible):
