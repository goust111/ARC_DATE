+    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+    removable = sorted(border - corners)
+    base = border | host
+    min_target = max(8, len(base) - 3)
+    max_target = min(15, len(base))
+    if min_target > max_target:
+        return None
