+def _paint_object(grid: np.ndarray, patch: np.ndarray, defect_sites: set[tuple[int, int]], top: int, left: int) -> None:
+    for r, c in np.argwhere(patch == BLUE):
+        rr = top + int(r)
+        cc = left + int(c)
+        grid[rr, cc] = RED if (int(r), int(c)) in defect_sites else BLUE
