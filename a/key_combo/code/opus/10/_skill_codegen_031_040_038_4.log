+        c_hi = width - right_margin - w
+        if r_lo > r_hi or c_lo > c_hi:
+            return None
+
+        success = False
+        for _ in range(400):
+            top = random.randint(r_lo, r_hi)
+            left = random.randint(c_lo, c_hi)
