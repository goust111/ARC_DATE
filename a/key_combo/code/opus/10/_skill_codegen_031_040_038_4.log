+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+EDGE = 5
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+EDGE_SIDES = ("top", "bottom", "left", "right")
+OPPOSITE_SIDE = {"top": "bottom", "bottom": "top", "left": "right", "right": "left"}
+_GEN_COUNTER = 0
