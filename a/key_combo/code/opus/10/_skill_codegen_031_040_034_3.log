+    succs = [[] for _ in range(n)]
+    preds = [[] for _ in range(n)]
+    for i in range(n):
+        for j in range(n):
+            if i == j:
+                continue
+            if blocks[i]["trail"] == blocks[j]["lead"]:
+                succs[i].append(j)
+                preds[j].append(i)
+
+    starts = [i for i in range(n) if len(preds[i]) == 0]
+    ends = [i for i in range(n) if len(succs[i]) == 0]
+    if len(starts) != 1 or len(ends) != 1:
+        raise AssertionError("chain endpoints must be unique")
+
+    start = starts[0]
+    order = [start]
+    seen = {start}
+    cur = start
+    while succs[cur]:
+        if len(succs[cur]) != 1:
+            raise AssertionError("chain branching is not allowed")
+        nxt = succs[cur][0]
+        if len(preds[nxt]) != 1 or nxt in seen:
+            raise AssertionError("chain must be a unique simple path")
+        seen.add(nxt)
+        order.append(nxt)
+        cur = nxt
+
+    if len(order) != n:
+        raise AssertionError("chain must cover every block")
+
+    for idx in range(1, n - 1):
+        node = order[idx]
+        if len(preds[node]) != 1 or len(succs[node]) != 1:
+            raise AssertionError("interior blocks must have degree pattern 1->1")
+    if len(preds[order[0]]) != 0 or len(succs[order[0]]) != 1:
+        raise AssertionError("invalid start block")
+    if len(preds[order[-1]]) != 1 or len(succs[order[-1]]) != 0:
+        raise AssertionError("invalid end block")
+    return order
+
+
+def _paint_transformed(out: np.ndarray, block: dict, chain_index: int) -> None:
+    color = COLOR_CYCLE[(chain_index - 1) % len(COLOR_CYCLE)]
+    for r, c in block["coords"]:
+        out[r, c] = color
+
+    r0, c0, r1, c1 = block["core_bbox"]
+    start_offset = 1 if chain_index % 2 == 1 else 2
+    if block["orient"] == "h":
+        center_r = r0 + 1
+        for offset in range(start_offset, block["length"], 2):
+            out[center_r, c0 + offset] = BG
+    else:
+        center_c = c0 + 1
+        for offset in range(start_offset, block["length"], 2):
+            out[r0 + offset, center_c] = BG
+
+
+def _expected_from_blocks(shape: tuple[int, int], blocks: list[dict], order: list[int]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for chain_index, block_idx in enumerate(order, start=1):
+        _paint_transformed(out, blocks[block_idx], chain_index)
+    return out
+
