labels=range(6)

def count_ham(seq):
    n=len(seq)-1
    succ=[[] for _ in range(n)]
    pred=[[] for _ in range(n)]
    for i in range(n):
        for j in range(n):
            if i==j: continue
            if seq[i+1]==seq[j]:
