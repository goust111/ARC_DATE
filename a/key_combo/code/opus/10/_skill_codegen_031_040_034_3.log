+        return {
+            "coords": coords,
+            "bbox": (r0, c0, r1, c1),
+            "orient": "h",
+            "core_bbox": (r0, c0 + 1, r1, c1 - 1),
+            "lead": left,
+            "trail": right,
+            "length": w - 2,
+        }
+
+    if w == 3 and h in (7, 9):
