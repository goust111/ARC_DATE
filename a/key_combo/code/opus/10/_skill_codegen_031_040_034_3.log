+    blocks = _extract_blocks(g)
+    order = _chain_order(blocks)
+    return _expected_from_blocks(g.shape, blocks, order)
+
+
+def _make_patch(orient: str, length: int, lead: frozenset[int], trail: frozenset[int]) -> np.ndarray:
+    if orient == "h":
