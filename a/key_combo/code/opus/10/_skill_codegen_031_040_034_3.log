+def _generate_spec() -> tuple[str, list[dict]]:
+    n = random.choice((4, 5, 6))
+    orient = random.choice(("h", "v"))
+    labels = random.sample(list(LABELS), n)
+    outer = labels[0]
+    chain_labels = labels[1:]
+
+    lengths = [5, 7]
+    while len(lengths) < n:
+        lengths.append(random.choice((5, 7)))
+    random.shuffle(lengths)
