+def _paint_transformed(out: np.ndarray, block: dict, chain_index: int) -> None:
+    color = COLOR_CYCLE[(chain_index - 1) % len(COLOR_CYCLE)]
+    for r, c in block["coords"]:
+        out[r, c] = color
