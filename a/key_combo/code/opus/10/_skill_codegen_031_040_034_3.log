+def _placement_ok(placed: list[tuple[int, int, int, int]], bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    for pr0, pc0, pr1, pc1 in placed:
+        if not (r1 + 2 < pr0 or pr1 + 2 < r0 or c1 + 2 < pc0 or pc1 + 2 < c0):
+            return False
+    return True
