                    if dr == 0 and dc == 0:
                        continue
                    if abs(dr) + abs(dc) < 6:
                        continue
                    shifted = {(r + dr, c + dc) for r, c in rotated[k2]}
                    overlap = len(rotated[k1] & shifted)
                    if 1 <= overlap <= 3:
                        specs.append((k1, k2, dr, dc))
