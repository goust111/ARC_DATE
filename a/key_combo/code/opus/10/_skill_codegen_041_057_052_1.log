95: def _gen_polyomino_patch(area: int) -> np.ndarray:
96:     coords = {(0, 0)}
97:     while len(coords) < area:
98:         frontier = []
99:         for r, c in coords:
100:             for dr, dc in DIRS_4:
101:                 nr, nc = r + dr, c + dc
102:                 if (nr, nc) in coords:
103:                     continue
104:                 trial = coords | {(nr, nc)}
105:                 rows = [p[0] for p in trial]
106:                 cols = [p[1] for p in trial]
107:                 h = max(rows) - min(rows) + 1
108:                 w = max(cols) - min(cols) + 1
109:                 if max(h, w) <= PATCH_LONG_SIDE_MAX and min(h, w) <= PATCH_SHORT_SIDE_MAX:
