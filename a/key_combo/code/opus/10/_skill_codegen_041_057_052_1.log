+MIN_OBJECT_GAP_ANY = 2
+MIN_OBJECT_GAP_SAME = 4
+SHAPE_TILE = 3
+SHAPE_PITCH = 4
+
+_BASE_SHAPES = [
+    np.array([[1, 1, 0], [0, 1, 0], [0, 0, 0]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 0], [0, 0, 0]], dtype=int),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 0]], dtype=int),
