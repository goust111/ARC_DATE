+    boxes = _expanded_boxes(grid)
+    h, w = grid.shape
+    conflict_cells = 0
+    preserved_overlap = 0
+    clipped_boxes = 0
+    for r in range(h):
+        for c in range(w):
+            claims: list[tuple[int, int]] = []
+            for color, rects in boxes.items():
+                for r0, c0, r1, c1 in rects:
+                    if r0 <= r <= r1 and c0 <= c <= c1:
+                        claims.append((counts[color], color))
