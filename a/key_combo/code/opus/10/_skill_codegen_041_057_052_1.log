+
+def _min_chebyshev_gap(a: np.ndarray, b: np.ndarray) -> int:
+    best = 10**9
+    for r1, c1 in a:
+        for r2, c2 in b:
+            best = min(best, max(abs(int(r1) - int(r2)), abs(int(c1) - int(c2))))
+    return int(best)
