+            er1 = min(h - 1, r1 + radius)
+            ec1 = min(w - 1, c1 + radius)
+            k_view = best_k[er0 : er1 + 1, ec0 : ec1 + 1]
+            c_view = best_color[er0 : er1 + 1, ec0 : ec1 + 1]
