+    for rects in boxes.values():
+        for r0, c0, r1, c1 in rects:
+            if r0 == 0 or c0 == 0 or r1 == h - 1 or c1 == w - 1:
+                clipped_boxes += 1
+
+    if conflict_cells == 0:
+        return False
+    if preserved_overlap == 0:
+        return False
+    if want_clipping and clipped_boxes == 0:
+        return False
