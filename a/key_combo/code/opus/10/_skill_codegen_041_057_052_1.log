35:     colors = list(flat_counts)
36:     bg = _unique_most_common(flat_counts, colors, "background")
37:     wall = _unique_most_common(flat_counts, [color for color in colors if color != bg], "wall")
38:     marker_colors = set(colors) - {bg, wall}
