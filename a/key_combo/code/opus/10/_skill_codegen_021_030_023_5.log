  control_sprite:
    type: monochrome rectangular region with holes (bg cells inside bbox)
    size: 3-8 rows × 3-8 cols
    color: single foreground color ≠ bg
    fill_ratio: 0.28-0.72 of bbox area (holes = bg cells)
    holes: ≥1 bg cell inside bbox
  building_block:
    type: polychrome square patch
    size: 2-5 × 2-5 (always square, H=W)
    colors: ≥2 distinct foreground colors, all ≠ bg and ≠ ctrl color
    symmetry: LR and UD [observed]
