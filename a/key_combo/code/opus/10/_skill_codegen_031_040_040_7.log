+def _mirror_mosaic(tile: np.ndarray) -> np.ndarray:
+    tile = np.asarray(tile, dtype=int)
+    h, w = tile.shape
+    out = np.empty((3 * h, 3 * w), dtype=int)
+    for sr in range(3):
+        for sc in range(3):
+            patch = tile
+            if sr != 1:
+                patch = np.flipud(patch)
+            if sc != 1:
+                patch = np.fliplr(patch)
+            out[sr * h : (sr + 1) * h, sc * w : (sc + 1) * w] = patch
