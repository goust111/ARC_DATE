spec:
  grid: always 16x16
  symmetry: full D4 (LR, UD, 90/180/270 rotation, transpose, anti-transpose)
  pattern:
    fundamental_domain: upper triangle of 8x8 TL quadrant (36 independent cells)
    expansion: q[r,c]=q[c,r] fills 8x8; reflect LR+UD to fill 16x16
    colors: 7-8 distinct non-black colors from palette 1-9; no black (0) in pattern
  hole:
    size: exactly 3x3 compact black patch
    count: exactly 1
    placement: entirely in left half (c0 in 0-5) or right half (c0 in 8-13); r0 in 0-13
    constraint: must not overlap its LR mirror image (guaranteed by half-placement)
  output: 3x3 patch recovered by copying the hole's LR-mirror region and reversing columns

generation_strategy:
  approach: output-first (build D4-symmetric grid, then punch hole)
  steps:
    - pick 7-8 distinct colors from 1-9
    - fill 36-cell upper triangle of 8x8 with random choices from those colors
    - mirror to full 8x8 via q[r,c]=q[c,r], then reflect LR+UD to get 16x16
    - pick random 3x3 hole position with c0 in [0,5] or [8,13], r0 in [0,13]
    - record the 3x3 patch at that position as the expected output
    - zero out (black) the 3x3 hole to produce the input grid
```
