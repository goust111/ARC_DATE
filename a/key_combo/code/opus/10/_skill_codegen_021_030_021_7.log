DES_PATHS="/home/lixinyu/snap/a/key_combo/des/opus/1/006.md"
SOURCE=both
TOP_K=8
OUT_DIR=/home/lixinyu/snap/a/key_combo/code/opus   # 实际输出到 /home/lixinyu/snap/a/key_combo/code/opus/1/006

python /home/lixinyu/snap/a/key_combo/skill/arc-codegen-similar-local/scripts/build_arc_codegen_prompts_with_similarity.py \
  $(printf -- ' --des_path %s' $DES_PATHS) \
