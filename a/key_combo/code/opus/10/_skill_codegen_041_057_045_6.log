    (h, w)
    for h in range(_GEN_LOOP_SIZE_MIN, _GEN_LOOP_SIZE_MAX + 1)
    for w in range(_GEN_LOOP_SIZE_MIN, _GEN_LOOP_SIZE_MAX + 1)
