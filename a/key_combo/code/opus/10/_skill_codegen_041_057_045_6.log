_GEN_MAX_DUPLICATES_PER_COLOR = 2
_GEN_MAX_DUPLICATED_COLORS = 1
_GEN_MIN_OUTPUT_COLORS = 2


def _gen_perimeter(size: tuple[int, int]) -> int:
