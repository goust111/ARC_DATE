_GEN_COMBOS_BY_TOTAL: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {}
for _gen_target in range(_GEN_BLUE_TOTAL_MIN, _GEN_BLUE_TOTAL_MAX + 1):
    _gen_options: list[tuple[tuple[int, int], ...]] = []
    for _gen_count in _GEN_LOOP_COUNT_OPTIONS:
