                panel,
                patch,
                transparent=int(panel[0, 0]),
                border=_GEN_PLACEMENT_BORDER,
                padding=_GEN_PLACEMENT_PADDING,
                padding_connectivity=_GEN_PLACEMENT_CONNECTIVITY,
