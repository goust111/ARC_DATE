def _gen_rect_specs(count):
    min_area = max(_GEN_FG_AREA_RANGE[0], _GEN_BLOB_AREAS[0] * count)
    max_area = min(_GEN_FG_AREA_RANGE[1], _GEN_BLOB_AREAS[-1] * count)
