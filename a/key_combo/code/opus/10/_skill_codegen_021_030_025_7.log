+            return False
+        if not np.any(out == CYAN):
+            return False
+        if not np.any(out == GREEN):
+            return False
+        return True
+    except AssertionError:
+        return False
+
+
+def _sample_dimensions() -> tuple[int, int, int]:
+    motif_h = random.choice((3, 4))
