+        if not np.any(wrap_holes):
+            return False
+
+        nonwrap_holes = _planar_nonwrap_hole_mask(tiled)
+        if not np.any(wrap_holes & ~nonwrap_holes):
+            return False
+
+        out = main(g)
+        if out.shape != g.shape:
