+    right_cols = range(max(0, motif.shape[1] - 3), motif.shape[1])
+    return bool(np.any(motif[:, list(left_cols)] == BLUE)) and bool(
+        np.any(motif[:, list(right_cols)] == BLUE)
+    )
+
+
