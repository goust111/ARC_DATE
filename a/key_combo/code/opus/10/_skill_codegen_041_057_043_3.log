+    for macro_r in range(MACRO_SIDE):
+        for macro_c in range(MACRO_SIDE):
+            if (macro_r, macro_c) in unique_positions:
+                occ = next(unique_iter)
+                expected[macro_r, macro_c] = BLACK
+            else:
