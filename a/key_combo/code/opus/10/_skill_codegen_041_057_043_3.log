+    assert g.ndim == 2, "expected a 2D grid"
+    assert tuple(map(int, g.shape)) == GRID_SHAPE, "expected a 6x6 array of 3x3 macro-blocks"
+    _freq, _areas, _variants, out = _analyze_grid(g)
+    return out
