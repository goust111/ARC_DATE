import itertools, numpy as np

def conn4(mask):
    pts=[tuple(p) for p in np.argwhere(mask)]
    if not pts: return False
    seen={pts[0]}; stack=[pts[0]]
    s=set(pts)
    while stack:
        r,c=stack.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
