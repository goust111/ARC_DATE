+        chosen = {positions[idx] for idx in pick_ids}
+        rows = {r for r, _ in chosen}
+        cols = {c for _, c in chosen}
+        if any(r < 3 for r in rows) and any(r >= 3 for r in rows) and any(c < 3 for c in cols) and any(c >= 3 for c in cols):
