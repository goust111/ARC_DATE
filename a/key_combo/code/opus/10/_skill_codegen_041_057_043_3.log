+def _extract_block_mask(grid: np.ndarray, macro_r: int, macro_c: int) -> np.ndarray:
+    r0 = macro_r * BLOCK_SIZE
+    c0 = macro_c * BLOCK_SIZE
+    return np.asarray(grid[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE] == BLUE, dtype=bool)
