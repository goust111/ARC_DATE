+        if group["force_variant_diversity"]:
+            distinct_pair = list(map(int, _RNG.choice(len(variants), size=2, replace=False)))
+            chosen_variant_ids[0] = distinct_pair[0]
+            chosen_variant_ids[1] = distinct_pair[1]
