135: def main(grid: np.ndarray) -> np.ndarray:
136:     """
137:     Complete scaled copies of the blue source template at matching red marker squares.
138: 
139:     Input structure
140:     - A black background contains one 4-connected mixed-color template object and detached same-color target squares.
141:     - The template has source-color pixels and marker-color pixels; the detached marker objects are solid k x k squares.
142:     - The output shape is unchanged.
143: 
144:     Rule
145:     - Use the template bbox as the pattern coordinate system.
146:     - Group target marker squares into sets whose top-left corners match the template marker coordinates at one common scale k.
147:     - For each matched group, scale every source-color template cell to a k x k block and paint it at that instance's origin, clipping any part outside the grid.
148: 
149:     Key insight
150:     The detached marker squares are enlarged copies of the template's marker cells; their side length gives the scale for copying the source-color cells.
151:     """
152:     g = np.asarray(grid, dtype=int)
153:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
154: 
155:     bg = int(get_bg(g))
156:     template, template_coords, source_color, marker_color = _find_template_roles(g, bg)
157:     source_rel, marker_rel = _template_cells(
158:         g, template, template_coords, source_color, marker_color
159:     )
160:     targets = _target_marker_squares(g, bg, marker_color, template_coords)
161:     instances = _matched_instances(targets, marker_rel)
162: 
163:     out = g.copy()
164:     for (origin_r, origin_c), scale in instances:
165:         block = np.full((scale, scale), int(source_color), dtype=int)
166:         for rel_r, rel_c in source_rel:
167:             paste(
168:                 out,
169:                 block,
170:                 origin_r + rel_r * scale,
171:                 origin_c + rel_c * scale,
172:                 transparent=bg,
173:                 overwrite=False,
174:                 clip=True,
175:             )
176: 
177:     return out
