229:     """
230:     Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.
231: 
232:     Input structure:
233:     - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).
234: 
235:     Rule:
236:     - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.
237:     - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.
238:     - Total painted pixels equal the original segment length.
239: 
240:     Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.
241:     """
242:     g = np.asarray(grid, dtype=int)
243:     h, w = g.shape
244:     bg = get_bg(g)
245: 
246:     colors = sorted(set(int(v) for v in np.unique(g)) - {bg})
247: 
248:     out = g.copy()
249: 
250:     def bar_candidates():
251:         # Yield (bar_color, bar_component, terminal_endpoint).
252:         for col in colors:
253:             for comp in _components(g, col, conn8=False):
254:                 if len(comp) < 2 or not _is_straight_line(comp):
255:                     continue
256:                 e0, e1 = _bar_endpoints(comp)
257:                 touch0 = _touches_border(e0, h, w)
258:                 touch1 = _touches_border(e1, h, w)
259:                 if touch0 == touch1:
260:                     continue  # require exactly one endpoint on border
261:                 # Orientation must be perpendicular to the edge it touches.
262:                 rs = [r for r, _ in comp]
263:                 cs = [c for _, c in comp]
264:                 vertical = len(set(cs)) == 1
