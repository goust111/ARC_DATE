+CLOSED_COLOR = 3
+OPEN_COLOR = 4
+SEPARATOR_COLOR = 5
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
