74:     out = np.full((h, sum(group.shape[1] for group in groups)), bg, dtype=int)
75:     c = 0
76: 
77:     first = groups[0]
78:     out[:, : first.shape[1]] = first
79:     prev_right_row = _endpoint_row(first, bg, "right")
