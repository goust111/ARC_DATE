+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _extract_scene(
+    grid: np.ndarray,
+) -> tuple[list[tuple[int, int]], tuple[int, int, int, int], list[tuple[int, tuple[int, int], str]]]:
