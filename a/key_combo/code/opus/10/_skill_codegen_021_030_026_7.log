+    for source_id, (color, _pos, direction) in enumerate(indicators, start=1):
+        step_r, step_c = CARDINAL_STEPS[direction]
+        stride = bbox_h + 1 if direction in {"up", "down"} else bbox_w + 1
+        k = 1
+        while True:
