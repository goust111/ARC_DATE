+                bg_seen[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not bg_seen[r, c]:
+                bg_seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(mask.shape, nr, nc) and not mask[nr, nc] and not bg_seen[nr, nc]:
+                bg_seen[nr, nc] = True
+                q.append((nr, nc))
+
+    return bool(np.any((~mask) & (~bg_seen)))
+
+
