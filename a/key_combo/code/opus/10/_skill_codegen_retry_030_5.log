import random
from collections import deque


def nbr4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def contour(region):
    H=len(region); W=len(region[0])
    out=[[False]*W for _ in range(H)]
    for r in range(H):
        for c in range(W):
            if not region[r][c]:
                continue
            for nr,nc in nbr4(r,c):
                if not (0<=nr<H and 0<=nc<W) or not region[nr][nc]:
                    out[r][c]=True
                    break
    return out

def degs(mask):
    H=len(mask);W=len(mask[0])
    ds=[]
    for r in range(H):
        for c in range(W):
            if mask[r][c]:
                d=sum(0<=nr<H and 0<=nc<W and mask[nr][nc] for nr,nc in nbr4(r,c))
                ds.append(d)
    return sorted(set(ds)),ds

def build_row_interval(h=7):
    widths=[]
    peak=random.randint(2,h-3)
    w=random.randint(2,3)
    for r in range(h):
        if r<peak:
            w+=random.choice([0,1])
        elif r>peak:
            w-=random.choice([0,1])
        widths.append(max(2,min(7,w)))
    widths[0]=max(widths[0],2); widths[-1]=max(widths[-1],2)
    center=6
    centers=[]
    for r in range(h):
        center += random.choice([-1,0,1])
        centers.append(center)
    W=20
    reg=[[False]*W for _ in range(h)]
    for r,(w,c0) in enumerate(zip(widths,centers)):
        l=max(1,min(W-w-1,c0-w//2))
        for c in range(l,l+w):
            reg[r][c]=True
    return reg

for i in range(20):
    reg=build_row_interval(random.randint(6,9))
    con=contour(reg)
    vals,ds=degs(con)
    print(i,vals,ds.count(2),len(ds))
