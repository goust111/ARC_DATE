    xs = _find_x_3x3(g, bg)  # center -> (color, (r0,c0))

    # Build track mask: non-bg minus token cells.
    track_mask = g != bg
    for (cr, cc), (_, (r0, c0)) in solids.items():
        track_mask[r0 : r0 + 3, c0 : c0 + 3] = False
    for (cr, cc) in xs.keys():
        for dr, dc in _X_OFF:
