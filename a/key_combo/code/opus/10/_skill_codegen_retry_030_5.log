+    ah, aw = anchor_shape
+    ph, pw = patch_shape
+    gh, gw = grid_shape
+
+    row_overlap = int(rng.integers(3, min(ah, ph) - 1))
+    col_overlap = int(rng.integers(3, min(aw, pw) - 1))
+    row_sign = int(rng.choice([-1, 1]))
+    col_sign = int(rng.choice([-1, 1]))
+
+    if row_sign > 0:
+        top = anchor_top + ah - row_overlap
+    else:
+        top = anchor_top - ph + row_overlap
+
+    if col_sign > 0:
+        left = anchor_left + aw - col_overlap
+    else:
+        left = anchor_left - pw + col_overlap
+
+    if not (1 <= top <= gh - ph - 1 and 1 <= left <= gw - pw - 1):
+        return None
+    return top, left
+
+
+def _generate_candidate(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1]))
+    w = int(rng.integers(GRID_SIDE_RANGE[0], GRID_SIDE_RANGE[1]))
+
+    for _ in range(100):
+        try:
+            patch_a = _make_region_patch(rng)
+            patch_b = _make_region_patch(rng)
+        except ValueError:
+            continue
+
+        if patch_a.shape[0] >= h - 1 or patch_a.shape[1] >= w - 1:
+            continue
+        if patch_b.shape[0] >= h - 1 or patch_b.shape[1] >= w - 1:
+            continue
+
+        top_a, left_a = _choose_top_left(rng, (h, w), patch_a.shape)
+        region_a = _place_patch((h, w), patch_a, top_a, left_a)
+
+        for _ in range(12):
+            pos_b = _relative_position(rng, top_a, left_a, patch_a.shape, patch_b.shape, (h, w))
+            if pos_b is None:
+                continue
+            top_b, left_b = pos_b
+            region_b = _place_patch((h, w), patch_b, top_b, left_b)
+
+            border_a = _shape_border(region_a)
+            border_b = _shape_border(region_b)
+            if np.any(border_a & border_b):
+                continue
+            if not _is_simple_cycle(border_a) or not _is_simple_cycle(border_b):
+                continue
+
+            interior_a = region_a & (~border_a)
+            interior_b = region_b & (~border_b)
+            if interior_a.sum() < 5 or interior_b.sum() < 5:
+                continue
+
+            overlap = interior_a & interior_b
+            only_a = interior_a & (~interior_b)
+            only_b = interior_b & (~interior_a)
+            if not overlap.any() or not only_a.any() or not only_b.any():
+                continue
+
+            min_area = min(int(interior_a.sum()), int(interior_b.sum()))
+            if overlap.sum() < max(2, min_area // 8):
+                continue
+            if overlap.sum() > min_area * 3 // 4:
+                continue
+
+            inferred_a = _infer_interior(border_a)
+            inferred_b = _infer_interior(border_b)
+            if not np.array_equal(inferred_a, interior_a):
+                continue
+            if not np.array_equal(inferred_b, interior_b):
+                continue
+
+            inp = np.zeros((h, w), dtype=int)
+            inp[border_a] = RED
+            inp[border_b] = BLUE
+
+            expected = np.zeros((h, w), dtype=int)
+            xor_mask = interior_a ^ interior_b
+            expected[xor_mask] = GREEN
+            expected[_outline_black_neighbors(xor_mask)] = YELLOW
+            actual = main(inp)
+            if not np.array_equal(actual, expected):
+                continue
+
+            if xor_mask.sum() > (h * w) // 3:
+                continue
+            if _outline_black_neighbors(xor_mask).sum() == 0:
+                continue
+            return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_candidate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 5")

