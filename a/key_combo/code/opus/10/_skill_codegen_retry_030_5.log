+        return False
+    h, w = loop_mask.shape
+    for r, c in points:
+        rr = int(r)
+        cc = int(c)
+        degree = 0
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and loop_mask[nr, nc]:
+                degree += 1
+        if degree != 2:
