+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        count += 1
+        q = deque([(rr, cc)])
+        seen[rr, cc] = True
+        while q:
+            cr, cc2 = q.popleft()
+            for nr, nc in _neighbors4(cr, cc2):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
