+        ext = int(rng.integers(1, 3))
+        cols = range(left - ext, left) if side == "left" else range(left + width, left + width + ext)
+        if min(cols, default=1) < 1 or max(cols, default=region.shape[1] - 2) >= region.shape[1] - 1:
