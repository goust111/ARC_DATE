+    h, w = grid_shape
+    ph, pw = patch_shape
+    top = int(rng.integers(1, h - ph))
+    left = int(rng.integers(1, w - pw))
+    return top, left
+
+
+def _relative_position(
+    rng: np.random.Generator,
+    anchor_top: int,
+    anchor_left: int,
+    anchor_shape: tuple[int, int],
+    patch_shape: tuple[int, int],
