+    border = np.zeros_like(region, dtype=bool)
+    for r, c in np.argwhere(region):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if not (0 <= nr < h and 0 <= nc < w) or not region[nr, nc]:
+                border[rr, cc] = True
+                break
