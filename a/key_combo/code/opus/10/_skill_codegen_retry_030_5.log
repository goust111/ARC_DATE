+    for r in range(h):
+        enqueue(r, 0)
+        enqueue(r, w - 1)
+    for c in range(w):
+        enqueue(0, c)
+        enqueue(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            enqueue(nr, nc)
+
+    return (~outside) & (~loop_mask)
