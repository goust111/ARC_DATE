+    base_h = int(rng.integers(BASE_HEIGHT_RANGE[0], BASE_HEIGHT_RANGE[1]))
+    base_w = int(rng.integers(BASE_WIDTH_RANGE[0], BASE_WIDTH_RANGE[1]))
+    r0 = int(rng.integers(3, 16 - base_h - 3))
+    c0 = int(rng.integers(3, 16 - base_w - 3))
