+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        count += 1
+        q = deque([(rr, cc)])
+        seen[rr, cc] = True
+        while q:
