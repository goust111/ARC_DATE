+
+
+def _semantic_transform(grid: np.ndarray) -> np.ndarray:
+    red_interior = _infer_interior(grid == RED)
+    blue_interior = _infer_interior(grid == BLUE)
+    xor_mask = red_interior ^ blue_interior
