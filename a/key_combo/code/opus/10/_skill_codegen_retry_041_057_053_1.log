+    intended_areas = sorted((room["inner"][2] - room["inner"][0] + 1) * (room["inner"][3] - room["inner"][1] + 1) for room in rooms)
+    if recovered_areas != intended_areas:
+        return False
+
+    for coords in enclosed:
