+ROOM_INTERIOR_WIDTH_RANGE = (4, 7)
+ROOM_MARGIN_TOP = 2
+ROOM_MARGIN_SIDE = 1
+ROOM_MARGIN_BOTTOM = 1
+ROOM_GAP = 2
+MAX_GENERATION_ATTEMPTS = 400
