+    def priority(spec: dict) -> tuple[int, int]:
+        if spec["touch"] and spec["mode"] == "overlap":
+            return (0, 0)
+        if spec["touch"] and spec["mode"] == "adjacent":
+            return (0, 1)
+        return (1, 0 if spec["hole"] else 1)
