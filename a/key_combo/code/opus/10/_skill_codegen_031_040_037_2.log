+            top, left = candidates[int(rng.integers(0, len(candidates)))]
+            abs_coords = _render_component(grid, sprite, top, left)
+            _mark_blocked(blocked, abs_coords)
+            placed = True
+            break
+        if not placed:
+            return None
+
+    return grid if _validate_input(grid) else None
+
