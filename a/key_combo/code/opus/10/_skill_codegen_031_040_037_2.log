+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            comps.append(
+                {
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": (
+                        int(arr[:, 0].min()),
+                        int(arr[:, 1].min()),
+                        int(arr[:, 0].max()),
+                        int(arr[:, 1].max()),
+                    ),
+                }
+            )
+    return comps
+
+
+def _emit_ray_mask(sources: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for sr, sc in sources:
+        sr = int(sr)
+        sc = int(sc)
+        for dr, dc in DIAG4:
+            r, c = sr, sc
+            while 0 <= r < h and 0 <= c < w:
+                mask[r, c] = True
+                r += dr
+                c += dc
+    return mask
+
+
+def _expand4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _component_has_hole(coords: np.ndarray) -> bool:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    mask = np.zeros((r1 - r0 + 3, c1 - c0 + 3), dtype=bool)
+    mask[coords[:, 0] - r0 + 1, coords[:, 1] - c0 + 1] = True
+
+    seen = np.zeros_like(mask, dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and not seen[nr, nc] and not mask[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return bool(np.any((~mask) & (~seen)))
+
