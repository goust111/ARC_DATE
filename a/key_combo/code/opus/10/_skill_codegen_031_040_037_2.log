+    ray_mask = _emit_ray_mask(np.asarray(sources, dtype=int), (h, w))
+    ray_touch = _expand4(ray_mask)
+    blocked = np.zeros((h, w), dtype=bool)
+    source_blocked = _source_forbidden((h, w), sources)
+    specs = _component_specs(rng)
+
+    for spec in specs:
+        placed = False
+        for _ in range(40):
