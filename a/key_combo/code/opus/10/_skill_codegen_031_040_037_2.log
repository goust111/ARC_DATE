+from collections import deque
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG4 = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+GRID_H_RANGE = (17, 23)
+GRID_W_RANGE = (17, 23)
+FRAME_SIZES = [(3, 3), (3, 4), (3, 5), (4, 4), (4, 5)]
+MAX_GENERATION_ATTEMPTS = 500
