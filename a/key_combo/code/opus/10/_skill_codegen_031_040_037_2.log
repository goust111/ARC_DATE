) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
    r0, c0, _r1, _c1 = map(int, template["bbox"])
    source_rel: list[tuple[int, int]] = []
    marker_rel: list[tuple[int, int]] = []

