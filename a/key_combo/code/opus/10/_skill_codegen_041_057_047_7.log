+        np.any(grid[r0, c0 : c1 + 1] == color)
+        and np.any(grid[r1, c0 : c1 + 1] == color)
+        and np.any(grid[r0 : r1 + 1, c0] == color)
+        and np.any(grid[r0 : r1 + 1, c1] == color)
