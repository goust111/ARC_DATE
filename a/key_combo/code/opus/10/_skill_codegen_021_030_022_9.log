+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _analyze_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    colors = sorted(int(color) for color in np.unique(g) if int(color) != BLACK)
