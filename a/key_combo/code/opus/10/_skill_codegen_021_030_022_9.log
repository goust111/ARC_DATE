+
+
+def _render_output(shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=int)
+    for obj in objects:
+        color = int(obj["color"])
+        for r, c in obj["moved_cells"]:
+            out[r, c] = color
