+import numpy as np
+
+
+BLACK = 0
+PALETTE = tuple(range(1, 10))
+
+GRID_H_RANGE = (12, 14)
+GRID_W_RANGE = (11, 15)
+OBJECT_COUNT_RANGE = (3, 5)
+ROW_BANDS = (0, 2, 4)
