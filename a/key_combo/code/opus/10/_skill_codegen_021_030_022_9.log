   175	def main(grid: np.ndarray) -> np.ndarray:
   176	    """
   177	    Slide each small object right where it has southeast support, then project the slid centers to the bottom row.
   178	
   179	    Input structure:
   180	    - Black background contains 3-5 small 4-connected monochrome objects in the upper half.
   181	    - Each object uses a distinct non-black color and has some pixels with a same-object pixel strictly southeast of them.
   182	    - The bottom row is empty black background before projection.
   183	
   184	    Rule:
   185	    - For each object independently, move every pixel one column right iff some pixel of the same object lies strictly below and strictly to its right, using the original object positions for that test.
   186	    - After this one-round slide, compute each object's new bounding box and take its horizontal center column.
   187	    - Mark that center on the bottom row with the object's color while keeping the slid objects visible.
   188	    - If multiple objects want the same center column, the larger-area object keeps it; equal areas are broken by the object whose slid bbox starts higher. Lower-priority objects shift right by one additional column each.
   189	
   190	    Key insight:
   191	    - The projection is determined by the post-slide geometry, not the original shape, and collisions are resolved by object area before the lower-priority projection shifts right.
   192	    """
   193	    g = np.asarray(grid, dtype=int)
   194	    assert g.ndim == 2 and g.size > 0
   195	    objects = _analyze_objects(g)
   196	    return _render_output(g.shape, objects)
