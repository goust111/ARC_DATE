+def _build_scene() -> tuple[np.ndarray, str] | None:
+    height = random.randint(*GRID_H_RANGE)
+    width = random.randint(*GRID_W_RANGE)
+    object_count = random.randint(*OBJECT_COUNT_RANGE)
+    branch_mode = random.choice(["area", "tie"])
