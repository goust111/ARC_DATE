from __future__ import annotations
import random
from itertools import combinations
from collections import Counter
import numpy as np

BLACK=0
ROW_BANDS=(0,2,4)
COLORS=tuple(range(1,10))


def neighbors4(r,c): return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def normalize(cells):
    minr=min(r for r,c in cells); minc=min(c for r,c in cells)
    return tuple(sorted((r-minr,c-minc) for r,c in cells))

def bbox(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs),min(cs),max(rs),max(cs)

def transforms(cells):
    outs=[]; pts=list(cells)
    for k in range(4):
        rot=[]
        for r,c in pts:
            x,y=r,c
            for _ in range(k): x,y=y,-x
            rot.append((x,y))
        for flip in [False,True]:
            arr=[(x,-y) if flip else (x,y) for x,y in rot]
            outs.append(normalize(arr))
    return set(outs)

def is4(cells):
    s=set(cells); st=[next(iter(s))]; seen={st[0]}
    while st:
        r,c=st.pop()
        for n in neighbors4(r,c):
            if n in s and n not in seen: seen.add(n); st.append(n)
    return len(seen)==len(s)

def slide(cells):
    s=set(cells); out=[]; supported=[]
    for r,c in cells:
        has=any(rr>r and cc>c for rr,cc in s)
        supported.append(has)
        out.append((r,c+1) if has else (r,c))
    return tuple(sorted(out)),tuple(supported)

def center(cells):
    b=bbox(cells); return (b[1]+b[3])//2

def build_lib():
    coords=[(r,c) for r in range(3) for c in range(4)]
    lib=[]
    for area in range(3,8):
        for comb in combinations(coords,area):
            if (0,0) not in comb: continue
            sh=normalize(comb)
            if not is4(sh): continue
            moved,sup=slide(sh)
            if len(set(moved))"'!=len(sh): continue
            if not any(sup) or all(sup): continue
            if len(transforms(sh))<8: continue
            b=bbox(sh)
            lib.append({'"'cells':sh,'area':area,'h':b[2]-b[0]+1,'w':b[3]-b[1]+1,'moved':normalize(moved),'moved_bbox':bbox(moved),'center_before':center(sh),'center_after':center(moved)})
    return lib
LIB=build_lib()
print('lib',len(LIB),Counter(d['area'] for d in LIB))
CHANGED=[d for d in LIB if d['center_before']"'!=d['"'center_after']]
print('changed',len(CHANGED),Counter(d['area'] for d in CHANGED))


def translate(cells, dr, dc): return tuple(sorted((r+dr,c+dc) for r,c in cells))

def valid_place(existing, cells, gap=1):
    s=set(cells)
    for others in existing:
        o=set(others)
        for r,c in s:
            for rr,cc in o:
                if max(abs(r-rr), abs(c-cc))<=gap:
                    return False
    return True

def gen_one():
    H=random.randint(12,14); W=random.randint(11,15)
    n=random.randint(3,5)
    branch=random.choice(['area','tie'])
    if branch=='area':
        larger_area, smaller_area=random.choice([(7,5),(7,6),(6,5)])
        large=random.choice([s for s in CHANGED if s['area']==larger_area])
        small=random.choice([s for s in CHANGED if s['area']==smaller_area])
        rows=[0,4] if random.random()<0.5 else [4,0]
        # force larger lower than smaller
        if rows[0] < rows[1]:
            rows=[rows[1],rows[0]]
        pair=[('L',large,rows[0]),('S',small,rows[1])]
    else:
        area=random.choice([5,6,7])
        cand=random.sample([s for s in CHANGED if s['area']==area],2)
        rows=random.sample(ROW_BANDS,2)
        pair=[('A',cand[0],min(rows)),('B',cand[1],max(rows))]
    # common target center
    ranges=[]
    for _,shape,row in pair:
        max_extent=max(max(c for _,c in shape['cells']), shape['moved_bbox'][3])
        lo=shape['center_after']
        hi=min(W-2, W-1-max_extent+shape['center_after'])
        ranges.append((lo,hi))
    lo=max(r[0] for r in ranges); hi=min(r[1] for r in ranges)
    if lo>hi: return None
    target=random.randint(lo,hi)
    objects=[]; input_occ=[]; moved_occ=[]; used_centers={target}; reserved_cols={target,target+1}
    for tag,shape,row in pair:
        c0=target-shape['center_after']
        cells=translate(shape['cells'],row,c0)
        moved=translate(shape['moved'],row,c0)
        if not valid_place(input_occ,cells,1): return None
        if not valid_place(moved_occ,moved,0): return None
        objects.append((shape,row,c0,cells,moved))
        input_occ.append(cells); moved_occ.append(moved)
    extras_needed=n-2
    extra_tries=0
    while len(objects)<n and extra_tries<300:
        extra_tries+=1
        shape=random.choice(LIB)
        row=random.choice(ROW_BANDS)
        max_input=max(c for _,c in shape['cells']); max_moved=shape['moved_bbox'][3]
        max_extent=max(max_input,max_moved)
        c0=random.randint(0,W-1-max_extent)
        center_after=c0+shape['center_after']
        if center_after in reserved_cols or center_after in used_centers: continue
        cells=translate(shape['cells'],row,c0)
        moved=translate(shape['moved'],row,c0)
        if max(r for r,c in cells)>6: continue
        if not valid_place(input_occ,cells,1): continue
        if not valid_place(moved_occ,moved,0): continue
        objects.append((shape,row,c0,cells,moved))
        input_occ.append(cells); moved_occ.append(moved)
        used_centers.add(center_after)
        reserved_cols.add(center_after)
    if len(objects)"'!=n: return None
    # check raw centers differ
    if all(shape['"'center_before']==shape['center_after'] for shape, *_ in objects[:2]): return None
    return H,W,branch,objects,target

cnt=0
for i in range(1000):
    if gen_one() is not None: cnt+=1
print('success',cnt)
