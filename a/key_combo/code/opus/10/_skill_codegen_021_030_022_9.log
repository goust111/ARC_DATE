+    objects = []
+    input_placements: list[tuple[tuple[int, int], ...]] = []
+    output_placements: list[tuple[tuple[int, int], ...]] = []
+    reserved_centers = {target_center, target_center + 1}
+    used_colors = random.sample(PALETTE, object_count)
