+def _is_connected4(cells: tuple[tuple[int, int], ...]) -> bool:
+    todo = [cells[0]]
+    seen = {cells[0]}
+    cell_set = set(cells)
+    while todo:
+        r, c = todo.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cell_set and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                todo.append((nr, nc))
+    return len(seen) == len(cells)
+
