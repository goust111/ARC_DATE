+            if out[nr, nc] != BLACK:
+                stop_reason = "blocked"
+                break
+
+            r, c = nr, nc
+            out[r, c] = YELLOW
+            painted += 1
+
+            if ray["axis"] == "row":
+                delta = _nearest_signed_delta(r, blue_by_col.get(c, []))
+                if delta is not None:
+                    shift_r = r - 1 if delta > 0 else r + 1
+                    shift_c = c
+                    if not _in_bounds(out.shape, shift_r, shift_c):
+                        stop_reason = "boundary"
+                        break
+                    if out[shift_r, shift_c] == YELLOW:
+                        stop_reason = "collision"
+                        break
+                    if out[shift_r, shift_c] != BLACK:
+                        stop_reason = "blocked"
+                        break
+                    r, c = shift_r, shift_c
+                    out[r, c] = YELLOW
+                    painted += 1
+                    deflections += 1
+            else:
+                delta = _nearest_signed_delta(c, blue_by_row.get(r, []))
+                if delta is not None:
+                    shift_r = r
+                    shift_c = c - 1 if delta > 0 else c + 1
+                    if not _in_bounds(out.shape, shift_r, shift_c):
+                        stop_reason = "boundary"
+                        break
+                    if out[shift_r, shift_c] == YELLOW:
+                        stop_reason = "collision"
+                        break
+                    if out[shift_r, shift_c] != BLACK:
+                        stop_reason = "blocked"
+                        break
+                    r, c = shift_r, shift_c
+                    out[r, c] = YELLOW
+                    painted += 1
