    grid[right_row, c1] = inner
    grid[right_row, c1 + 1] = inner

    grid[r0, top_col] = inner
    grid[r0 - 1, top_col] = inner

    grid[r1, bottom_col] = inner
    grid[r1 + 1, bottom_col] = inner


