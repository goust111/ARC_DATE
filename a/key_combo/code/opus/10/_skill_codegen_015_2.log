+    grid[left_blue_row, left_blue_col] = BLUE
+    grid[right_blue_row, right_blue_col] = BLUE
+    grid[top_blue_row, top_blue_col] = BLUE
+    grid[bottom_blue_row, bottom_blue_col] = BLUE
+
