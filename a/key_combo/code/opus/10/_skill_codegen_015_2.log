+def _candidate_grid() -> np.ndarray:
+    height, width, rect_h, rect_w = _choose_dims()
+    grid = np.zeros((height, width), dtype=int)
+    outer, inner = random.sample(list(NON_SPECIAL_COLORS), 2)
