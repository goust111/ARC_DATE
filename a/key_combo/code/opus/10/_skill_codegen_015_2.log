+def _choose_two_with_gap(values: list[int], min_gap: int) -> tuple[int, int]:
+    pairs = [(a, b) for i, a in enumerate(values) for b in values[i + 1 :] if b - a >= min_gap]
+    if not pairs:
+        raise ValueError("no feasible pair")
