def _gen_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:
    last = n - 1
    return {
        (r, c),
        (r, last - c),
        (last - r, c),
        (last - r, last - c),
        (c, r),
        (c, last - r),
        (last - c, r),
        (last - c, last - r),
    }


def _gen_d4_grid(n: int, palette: list[int]) -> np.ndarray:
    grid = np.empty((n, n), dtype=int)
