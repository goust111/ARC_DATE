+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    _box, marker_mask = _find_marker_rect(g)
+    corrected = _correct_anomaly(g, marker_mask)
+    return _fill_marker(corrected, marker_mask)
