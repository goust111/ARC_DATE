+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3)
+MARKER = 6
+ANOMALY_SIZE = 3
+MASK_SIZES = ((3, 3), (3, 4), (4, 3), (4, 4))
+MAX_GENERATION_ATTEMPTS = 400
