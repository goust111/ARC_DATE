+            fallback_options: list[tuple[tuple[int, int, int, int], str]] = []
+            for marker_key in other_keys:
+                protected = [family[key] for key in family if key != marker_key]
+                for mh, mw in MASK_SIZES:
+                    for r0 in range(h - mh + 1):
