+    pw = random.randint(1, min(3, w))
+    r0 = random.randint(0, h - ph)
+    c0 = random.randint(0, w - pw)
+    canvas[r0 : r0 + ph, c0 : c0 + pw] = int(color)
+
+
+def _paint_line(canvas: np.ndarray, color: int) -> None:
