+
+def _make_corrupted_patch(correct: np.ndarray) -> np.ndarray:
+    bad = np.empty_like(correct)
+    for r in range(correct.shape[0]):
+        for c in range(correct.shape[1]):
+            choices = [color for color in PALETTE if color != int(correct[r, c])]
+            if not choices:
