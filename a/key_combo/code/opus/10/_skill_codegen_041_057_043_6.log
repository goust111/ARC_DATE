+def _visible_mirror_values_for_marker(
+    grid: np.ndarray, marker_mask: np.ndarray, r: int, c: int
+) -> list[int]:
+    h, w = grid.shape
+    sr = h - 1 - int(r)
+    sc = w - 1 - int(c)
+    vals: list[int] = []
+    for rr, cc in ((int(r), sc), (sr, int(c)), (sr, sc)):
+        if (rr, cc) == (int(r), int(c)):
+            continue
+        if not marker_mask[rr, cc]:
