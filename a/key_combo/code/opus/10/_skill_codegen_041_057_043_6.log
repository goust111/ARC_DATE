        h_bounds, w_bounds = CLOSED_SIZE_BY_COUNT[min(closed_count, 3)]
        h = random.randint(*h_bounds)
        w = random.randint(*w_bounds)

        base_area = 2 * h + 2 * w - 4
        if base_area > CLOSED_BASE_AREA_MAX:
