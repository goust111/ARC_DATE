+    return bad
+
+
+def _marker_has_axis_overlap(box: tuple[int, int, int, int], shape: tuple[int, int]) -> bool:
+    center_r = shape[0] // 2
+    center_c = shape[1] // 2
+    r0, c0, r1, c1 = box
+    return (r0 <= center_r <= r1) or (c0 <= center_c <= c1)
