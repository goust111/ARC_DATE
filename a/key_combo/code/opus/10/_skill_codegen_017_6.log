    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND, dtype=int)
    for idx in range(0, GRID_SIZE, STRIDE):
        grid[idx, :] = ORANGE
        grid[:, idx] = ORANGE
    return grid


