+    side_c = int(c1 - c0 + 1)
+    assert side_r == side_c, "expected a square"
+    assert int(len(blue)) == side_r * side_c, "expected a solid square"
+    assert side_r in (2, 3, 4), "square side must be 2, 3, or 4"
