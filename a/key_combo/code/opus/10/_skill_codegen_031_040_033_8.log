+def _contiguous_span(indices: np.ndarray) -> tuple[int, int]:
+    assert indices.size > 0, "expected a non-empty side run"
+    lo = int(indices[0])
+    hi = int(indices[-1])
+    assert np.array_equal(indices, np.arange(lo, hi + 1)), "expected a contiguous side run"
+    return lo, hi
