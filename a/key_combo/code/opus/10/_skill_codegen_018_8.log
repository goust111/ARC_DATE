+def _band_index(row: int, separators: list[int], height: int) -> int | None:
+    bounds = [-1] + separators + [height]
+    for i in range(len(bounds) - 1):
+        if bounds[i] < row < bounds[i + 1]:
+            return i
+    return None
+
