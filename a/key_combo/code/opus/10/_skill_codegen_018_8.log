+
+def _trace_path(grid: np.ndarray, start_col: int) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    r = h - 1
+    c = int(start_col)
+    path = [(r, c)]
+    while True:
+        if r == 0:
+            break
+        if int(grid[r - 1, c]) == WALL:
+            moved = False
+            for dc in (1, -1):
+                nc = c + dc
+                if 0 <= nc < w and int(grid[r, nc]) != WALL:
+                    c = nc
+                    path.append((r, c))
+                    moved = True
+                    break
+            if not moved:
+                break
+        else:
+            r -= 1
+            path.append((r, c))
