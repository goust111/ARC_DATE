+    marker_set = set(MARKER_COLORS)
+    out = g.copy()
+    for chamber in visited:
+        rows, cols = _chamber_ranges(chamber, separators, divider, g.shape)
+        marker_hits: dict[tuple[int, int], int] = {}
+        for r in rows:
+            for c in cols:
