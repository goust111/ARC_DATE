+    wall_counts = np.sum(grid == WALL, axis=0)
+    col = max(range(1, w - 1), key=lambda c: int(wall_counts[c]))
+    assert int(wall_counts[col]) >= h // 2, "expected one dominant vertical divider"
+    return int(col)
