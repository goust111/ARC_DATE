+) -> tuple[int, int] | None:
+    shuffled = candidates[:]
+    random.shuffle(shuffled)
+    for cell in shuffled:
+        if all(max(abs(cell[0] - rr), abs(cell[1] - cc)) > 1 for rr, cc in used):
