/bin/bash -lc "python - <<'PY'
import random, numpy as np
from collections import Counter

SIZE_MIN,SIZE_MAX=12,16
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
QUADS=[(-1,-1),(-1,1),(1,-1),(1,1)]

def qof(seed, cell):
    sr,sc=seed; r,c=cell
    dr = -1 if r<sr else 1
    dc = -1 if c<sc else 1
    return (dr,dc)

def inb(size,r,c): return 0<=r<size and 0<=c<size

def build(size,seed,blockers):
    g=np.zeros((size,size),int); g[seed]=1
    for b in blockers: g[b]=2
    return g

def simulate(grid):
    size=grid.shape[0]
    sr,sc=map(int,np.argwhere(grid==1)[0])
    out=grid.copy(); r,c=sr,sc; leg=2; di=0; completed=0
    path={(sr,sc)}; visited=[]; legs=[]
    while True:
        dr,dc=DIRS[di]
        leg_steps=[]
        for step in range(leg):
            r+=dr;c+=dc
            steprec=(r,c,inb(size,r,c))
            leg_steps.append(steprec)
            if steprec[2]:
                if grid[r,c]==2:
                    return out,{'stop':'blocker_mid','completed_legs':completed,'path':path,'legs':legs,'stop_cell':(r,c),'stop_leg_index':len(legs),'stop_step_index':step}
                if out[r,c]==0:
                    out[r,c]=1
                path.add((r,c)); visited.append((r,c))
        legs.append(leg_steps)
        completed += 1
        ndi=(di+1)%4
        nleg=leg + (2 if ndi in (0,2) else 0)
        dr2,dc2=DIRS[ndi]
        nr,nc=r+dr2,c+dc2
        if inb(size,nr,nc) and grid[nr,nc]==2:
            return out,{'stop':'next_first_blocker','completed_legs':completed,'path':path,'legs':legs,'stop_cell':(nr,nc),'stop_leg_index':len(legs),'stop_step_index':0}
        rr,cc=r,c; all_oob=True
        for _ in range(nleg):
            rr+=dr2;cc+=dc2
            if inb(size,rr,cc): all_oob=False; break
        if all_oob:
            return out,{'stop':'all_oob_next','completed_legs':completed,'path':path,'legs':legs,'stop_cell':None,'stop_leg_index':len(legs),'stop_step_index':None}
        di,leg=ndi,nleg

def count_regions(out):
    size=out.shape[0]
    seen=np.zeros_like(out,bool); n=0
    for r in range(size):
        for c in range(size):
            if out[r,c]"'!=0 or seen[r,c]: continue
            n+=1; st=[(r,c)]; seen[r,c]=1
            while st:
                x,y=st.pop()
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    xx,yy=x+dx,y+dy
                    if inb(size,xx,yy) and out[xx,yy]==0 and not seen[xx,yy]: seen[xx,yy]=1; st.append((xx,yy))
    return n

def candidates_for_seed(size, seed):
    grid=build(size,seed,[])
    out,meta=simulate(grid)
    return out,meta

def pick_seed(size):
    # bias near border or off-center for more partitions
    cands=[]
    for r in range(2,size-2):
        for c in range(2,size-2):
            out,meta=candidates_for_seed(size,(r,c))
            n=count_regions(out)
            if meta['"'completed_legs']>=3 and n>=2:
                score=(n, max(abs(r-(size-1)/2), abs(c-(size-1)/2)))
                cands.append(((r,c),score))
    if not cands: return None
    cands.sort(key=lambda x:x[1], reverse=True)
    top=[p for p,_ in cands[:max(8,len(cands)//3)]]
    return random.choice(top)

def off_axis_cells(size,seed, quadrants=None):
    sr,sc=seed
    cells=[]
    for r in range(size):
        for c in range(size):
            if (r,c)==seed or r==sr or c==sc: continue
            q=qof(seed,(r,c))
            if quadrants is None or q in quadrants:
                cells.append((r,c))
    return cells

def choose_isolated(cands, used, seed, forbidden):
    sr,sc=seed
    random.shuffle(cands)
    for cell in cands:
        if cell in forbidden: continue
        if any(max(abs(cell[0]-r),abs(cell[1]-c))<=1 for r,c in used): continue
        return cell
    return None

def gen_attempt():
    size=random.randint(SIZE_MIN,SIZE_MAX)
    seed=pick_seed(size)
    if seed is None: return None
    branch=random.choices(['oob','mid','next'], weights=[0.35,0.4,0.25])[0]
    obstacle_count=random.randint(1,3)
    base_grid=build(size,seed,[])
    base_out,base_meta=simulate(base_grid)
    stop_cell=None
    blockers=[]
    if branch=='oob':
        forbidden=set(base_meta['path'])
        quadrant_order=random.sample(QUADS, obstacle_count)
        used=[]
        for q in quadrant_order:
            cands=[cell for cell in off_axis_cells(size,seed,[q]) if cell not in forbidden]
            cell=choose_isolated(cands, used, seed, forbidden)
            if cell is None: return None
            blockers.append(cell); used.append(cell)
    else:
        legs=base_meta['legs']
        leg_start=3
        stop_candidates=[]
        for leg_index in range(leg_start, len(legs)):
            steps=legs[leg_index]
            inb_steps=[(i,(r,c)) for i,(r,c,ok) in enumerate(steps) if ok]
            if branch=='mid':
                for i,cell in inb_steps[1:]:
                    stop_candidates.append((leg_index,i,cell))
            else:
                if inb_steps and inb_steps[0][0]==0:
                    stop_candidates.append((leg_index,0,inb_steps[0][1]))
        random.shuffle(stop_candidates)
        for leg_index, step_index, stop_cell in stop_candidates[:60]:
            stop_q=qof(seed, stop_cell)
            qs=[q for q in QUADS if q"'!=stop_q]
            if len(qs)<obstacle_count-1: continue
            used=[stop_cell]; blockers=[stop_cell]
            forbidden=set(base_meta['"'path'])
            # only forbid earlier path positions, allow later path maybe? safer use full path
            ok=True
            for q in random.sample(qs, obstacle_count-1):
                cands=[cell for cell in off_axis_cells(size,seed,[q]) if cell not in forbidden and cell"'!=stop_cell]
                cell=choose_isolated(cands, used, seed, forbidden)
                if cell is None: ok=False; break
                blockers.append(cell); used.append(cell)
            if not ok: continue
            out,meta=simulate(build(size,seed,blockers))
            n=count_regions(out)
            if meta['"'stop']=='blocker_mid' and branch=='mid' and meta['completed_legs']>=3 and 2<=n<=6:
                # terminating blocker matters
                out2,meta2=simulate(build(size,seed,[b for b in blockers if b"'!=stop_cell]))
                if meta2['"'stop']"'!=meta['"'stop'] or not np.array_equal(out2,out):
                    return build(size,seed,blockers),meta,n
            if meta['stop']=='next_first_blocker' and branch=='next' and meta['completed_legs']>=3 and 2<=n<=6:
                out2,meta2=simulate(build(size,seed,[b for b in blockers if b"'!=stop_cell]))
                if meta2['"'stop']"'!=meta['"'stop'] or not np.array_equal(out2,out):
                    return build(size,seed,blockers),meta,n
        return None
    grid=build(size,seed,blockers)
    out,meta=simulate(grid)
    n=count_regions(out)
    if meta['stop']=='all_oob_next' and meta['completed_legs']>=3 and 2<=n<=6:
        return grid,meta,n
    return None

stats=Counter(); ns=Counter(); ok=0
for _ in range(300):
    res=gen_attempt()
    if res is None: continue
    grid,meta,n=res
    ok+=1
    stats[meta['stop']] += 1
    ns[n]+=1
print('ok',ok)
print(stats)
print(ns)
