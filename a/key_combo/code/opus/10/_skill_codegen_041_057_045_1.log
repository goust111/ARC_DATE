+def _quadrant(seed: tuple[int, int], cell: tuple[int, int]) -> tuple[int, int]:
+    sr, sc = seed
+    r, c = cell
+    assert r != sr and c != sc
+    return (-1 if r < sr else 1, -1 if c < sc else 1)
