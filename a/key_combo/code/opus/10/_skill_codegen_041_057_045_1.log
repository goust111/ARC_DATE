import random, numpy as np
from collections import Counter
SIZE_MIN,SIZE_MAX=12,16
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
QUADS=[(-1,-1),(-1,1),(1,-1),(1,1)]

def qof(seed, cell):
    sr,sc=seed; r,c=cell
    return (-1 if r<sr else 1, -1 if c<sc else 1)

def inb(size,r,c): return 0<=r<size and 0<=c<size

def build(size,seed,blockers):
    g=np.zeros((size,size),int); g[seed]=1
    for b in blockers:g[b]=2
    return g

def simulate(grid):
    size=grid.shape[0]
    sr,sc=map(int,np.argwhere(grid==1)[0])
    out=grid.copy(); r,c=sr,sc; leg=2; di=0; completed=0
    path={(sr,sc)}; legs=[]
    while True:
        dr,dc=DIRS[di]
        leg_steps=[]
        for step in range(leg):
            r+=dr;c+=dc
            ok=inb(size,r,c)
            leg_steps.append((r,c,ok))
            if ok:
                if grid[r,c]==2:
                    return out,{'stop':'blocker_mid','completed_legs':completed,'path':path,'legs':legs,'stop_cell':(r,c)}
                if out[r,c]==0: out[r,c]=1
                path.add((r,c))
        legs.append(leg_steps)
        completed += 1
        ndi=(di+1)%4; nleg=leg+(2 if ndi in (0,2) else 0)
        dr2,dc2=DIRS[ndi]
        nr,nc=r+dr2,c+dc2
        if inb(size,nr,nc) and grid[nr,nc]==2:
            return out,{'stop':'next_first_blocker','completed_legs':completed,'path':path,'legs':legs,'stop_cell':(nr,nc)}
        rr,cc=r,c; all_oob=True
        for _ in range(nleg):
            rr+=dr2;cc+=dc2
            if inb(size,rr,cc): all_oob=False; break
        if all_oob:
            return out,{'stop':'all_oob_next','completed_legs':completed,'path':path,'legs':legs,'stop_cell':None}
        di,leg=ndi,nleg

def count_regions(out):
    size=out.shape[0]
    seen=np.zeros_like(out,bool); n=0
    for r in range(size):
        for c in range(size):
            if out[r,c]"'!=0 or seen[r,c]: continue
            n+=1; st=[(r,c)]; seen[r,c]=1
            while st:
                x,y=st.pop()
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    xx,yy=x+dx,y+dy
                    if inb(size,xx,yy) and out[xx,yy]==0 and not seen[xx,yy]: seen[xx,yy]=1; st.append((xx,yy))
    return n

def pick_seed(size, branch):
    cands=[]
    for r in range(2,size-2):
        for c in range(2,size-2):
            out,meta=simulate(build(size,(r,c),[]))
            base_n=count_regions(out)
            if meta['"'completed_legs']<3 or base_n<2: continue
            next_ct=0; mid_ct=0
            for leg_index in range(3,len(meta['legs'])):
                inb_steps=[(i,(rr,cc)) for i,(rr,cc,ok) in enumerate(meta['legs'][leg_index]) if ok]
                if inb_steps:
                    if inb_steps[0][0]==0: next_ct+=1
                    mid_ct += max(0, len(inb_steps)-1)
            score=(base_n, max(abs(r-(size-1)/2), abs(c-(size-1)/2)))
            if branch=='oob': cands.append(((r,c), score))
            elif branch=='mid' and mid_ct: cands.append(((r,c), (mid_ct,)+score))
            elif branch=='next' and next_ct: cands.append(((r,c), (next_ct,)+score))
    if not cands: return None
    cands.sort(key=lambda x:x[1], reverse=True)
    top=[p for p,_ in cands[:max(10,len(cands)//2)]]
    return random.choice(top)

def off_axis(size,seed,q):
    sr,sc=seed
    return [(r,c) for r in range(size) for c in range(size) if (r,c)"'!=seed and r!=sr and c!=sc and qof(seed,(r,c))==q]

def choose(cands, used, forbidden):
    random.shuffle(cands)
    for cell in cands:
        if cell in forbidden: continue
        if any(max(abs(cell[0]-r),abs(cell[1]-c))<=1 for r,c in used): continue
        return cell
    return None

def gen_attempt():
    branch=random.choices(['"'oob','mid','next'], weights=[0.25,0.4,0.35])[0]
    size=random.randint(SIZE_MIN,SIZE_MAX)
    seed=pick_seed(size, branch)
    if seed is None: return None
    obstacle_count=random.randint(1,3)
    base_out, base_meta=simulate(build(size,seed,[]))
    base_forbidden=set(base_meta['path'])
    if branch=='oob':
        qs=random.sample(QUADS, obstacle_count)
        blockers=[]
        for q in qs:
