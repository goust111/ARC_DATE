            out,meta=simulate(grid); n=count_regions(out)
            if meta['"'completed_legs']>=3 and 2<=n<=6:
                cand_evals.append((n, grid, meta))
    if not cand_evals: return None
    cand_evals.sort(key=lambda t:t[0], reverse=True)
    top=cand_evals[:max(1,min(12,len(cand_evals)))]
    n,grid,meta=random.choice(top)
    return grid,meta,n

stats=Counter(); ns=Counter(); ok=0
for _ in range(300):
    res=gen_attempt();
    if res is None: continue
    _,meta,n=res; ok+=1; stats[meta['stop']]+=1; ns[n]+=1
print('ok',ok)
print(stats)
print(ns)
