spec:
  grid: 13-16 rows x 15-16 cols
  background: single color (0 in all examples) [observed]; fills boundary and surrounds panel
  panel:
    shape: solid filled rectangle, 8-12 rows x 8-13 cols
    color: single color distinct from background (8 in all examples) [observed]
    position: offset from grid edges by >=1 cell on each side; margins vary 1-6 cells
    constraint: every cell inside panel bbox is non-background (fully filled)
  markers:
    count: 2-4 distinct colors, each forming exactly one solid 2x2 block inside the panel
    colors: each marker is a unique color != background and != panel_color
    placement: each marker center must lie clearly in one quadrant (top/bottom x left/right half of panel bbox); no two markers share a quadrant
    gap: each marker has >=1 cell clearance to panel edges on all four sides
  output:
    shape: always 2x2
    rule: |
      Split panel bbox into top/bottom halves (rows) and left/right halves (cols).
      Each cell (r,c) in the 2x2 output gets the marker color whose center falls
      in that quadrant, or background if no marker occupies that quadrant.

generation_strategy:
  approach: output-first
  steps:
    - Pick background color and panel color (2 distinct colors).
    - Choose marker count K in [2,4]. Pick K distinct colors != bg, != panel_color.
    - Build 2x2 output grid; place K marker colors in K distinct cells, fill rest with bg.
    - Choose panel dimensions H_p in [8,12], W_p in [8,13] (both even preferred for symmetry but not required; min 6 to fit 2x2 markers with clearance in each half).
    - For each occupied output cell (r,c), place a 2x2 marker inside the corresponding quadrant of the panel, with >=1 cell gap to panel edges and to the quadrant boundary.
    - Fill remaining panel cells with panel_color.
    - Choose grid dimensions by adding 1-5 cell margins on each side of the panel (total grid 13-16 rows, 15-16 cols).
    - Embed panel in grid; fill exterior with background.
