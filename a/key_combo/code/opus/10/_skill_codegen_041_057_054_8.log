+def _split_box_rows(box: tuple[int, int, int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    r0, r1, _c0, _c1 = box
+    mid = r0 + (r1 - r0) // 2
+    assert r0 < mid < r1, "quadrant needs non-empty upper and lower bands"
+    return (r0, mid), (mid, r1)
