6: def main(grid: np.ndarray) -> np.ndarray:
7:     """Select the color whose count grows the most below the gray divider and output it as a 2x2 square.
8: 
9:     Input structure
10:     A mostly background grid contains one full-width gray horizontal divider and two non-background,
11:     non-gray colored marker masks above and below that divider.
12: 
13:     Rule
14:     For each marker color, count its pixels above the divider and below the divider. Choose the
15:     color with the largest value of below_count - above_count, and return a 2x2 grid filled with
16:     that color.
17: 
18:     Key insight
19:     The gray bar splits the scene into before/after regions; the answer is the color with the
20:     greater net increase from the upper region to the lower region.
21:     """
22:     g = np.asarray(grid, dtype=int)
23: 
24:     bg = get_bg(g)
25:     divider_rows = np.where(np.all(g == Color.GREY, axis=1))[0]
26:     assert len(divider_rows) == 1
27:     divider = int(divider_rows[0])
28: 
29:     marker_colors = colors_present(g, exclude={bg, Color.GREY})
30:     assert len(marker_colors) == 2
31: 
32:     scores = []
33:     for color in marker_colors:
34:         above = int(np.count_nonzero(g[:divider] == color))
35:         below = int(np.count_nonzero(g[divider + 1 :] == color))
36:         scores.append((below - above, color))
37: 
38:     best_score = max(score for score, _ in scores)
39:     winners = [color for score, color in scores if score == best_score]
40:     assert len(winners) == 1
41: 
42:     return np.full((2, 2), winners[0], dtype=int)
