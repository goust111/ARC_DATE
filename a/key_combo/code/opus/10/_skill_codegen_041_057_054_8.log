+    r0, r1, c0, c1 = box
+    values = set(map(int, grid[r0:r1, c0:c1].ravel()))
+    return sorted(values - {BG, DIVIDER})
+
+
+def _quadrant_scores(grid: np.ndarray, box: tuple[int, int, int, int]) -> dict[int, int]:
+    (top0, top1), (bot0, bot1) = _split_box_rows(box)
+    _r0, _r1, c0, c1 = box
