  "type": "transform_in_place",
  "src": "filled rectangular panel containing solid 2x2 colored markers",
  "transform": "collapse the panel to a 2x2 map: each marker color fills the cell for the panel half containing that marker; absent cells are background",
  "grid_shape": "2x2 coarse position map"
}
</annotation>
<generation_spec>
