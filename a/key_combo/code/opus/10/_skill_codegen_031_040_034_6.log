+def _can_place(occupied: np.ndarray, top: int, left: int, height: int, width: int, pad: int = 1) -> bool:
+    h, w = occupied.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h, top + height + pad)
+    c1 = min(w, left + width + pad)
