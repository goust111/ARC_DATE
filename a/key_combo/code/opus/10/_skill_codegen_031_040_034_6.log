spec:
  grid: 15x15 always
  background: 0 (black), ~57-63% of cells
  l_stencil:
    position: always top-left corner (row 0, col 0)
    shape: grey(5) right-column (col 3, rows 0-2) + bottom-row (row 3, cols 0-3) = 7 cells forming an L
    sample: the 3x3 region at [0:3, 0:3] inside the L; 4-5 nonzero cells, 3-4 distinct nonzero colors, never contains grey(5)
  duplicate:
    content: exact copy of the 3x3 sample placed elsewhere in the grid
    count: exactly 1 duplicate (total 2 occurrences of the pattern)
