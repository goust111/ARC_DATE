+def _build_source_patch(sample: np.ndarray, height: int, width: int) -> np.ndarray:
+    patch = np.zeros((height, width), dtype=int)
+    patch[:SAMPLE_SIZE, :SAMPLE_SIZE] = sample
+    patch[:height, 3] = GREY
+    patch[3, :width] = GREY
+    return patch
+
