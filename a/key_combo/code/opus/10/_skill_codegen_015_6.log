+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 7
+TASK_COLORS = (8, 3, 5)
+
+GRID_SIDE_RANGE = (20, 26)
+DIAMOND_RADIUS_RANGE = (2, 6)
+RECT_SIDE_RANGE = (2, 7)
+
+OUTER_MARGIN = 1
+BOX_GAP = 1
+PLACEMENT_TRIES = 300
+MAX_GENERATION_ATTEMPTS = 600
+
+RELATION_PATTERNS = (
+    ("fill", "border", "equal"),
+    ("fill", "border", "border"),
+    ("fill", "fill", "border"),
+    ("fill", "equal", "border"),
+)
+SEEN_OUTPUT_SIGNATURES: set[tuple[tuple[int, int], bytes]] = set()
