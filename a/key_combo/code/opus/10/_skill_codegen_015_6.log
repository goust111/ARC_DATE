+def _neighbors8(r: int, c: int, shape: tuple[int, int]):
+    h, w = shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                yield rr, cc
+
+
+def _components8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc2 = stack.pop()
+            comp.append((cr, cc2))
+            for nr, nc in _neighbors8(cr, cc2, mask.shape):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _bbox_from_points(points: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [p[0] for p in points]
+    cols = [p[1] for p in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _diamond_outline_points(cr: int, cc: int, radius: int) -> list[tuple[int, int]]:
+    if radius == 0:
+        return [(cr, cc)]
+    pts: list[tuple[int, int]] = []
+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        pts.append((cr + dr, cc + dc))
+        if dc != 0:
+            pts.append((cr + dr, cc - dc))
+    return pts
