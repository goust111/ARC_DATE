+    c0_max = w - OUTER_MARGIN - width
+    if r0_max < r0_min or c0_max < c0_min:
+        return None
+
+    for _ in range(PLACEMENT_TRIES):
+        r0 = random.randint(r0_min, r0_max)
+        c0 = random.randint(c0_min, c0_max)
+        box = (r0, c0, r0 + height - 1, c0 + width - 1)
