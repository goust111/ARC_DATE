+UNIQUE_BBOXES = ((3, 3), (3, 5), (5, 3), (5, 5))
+PAIR_BBOXES = (
+    (2, 3),
+    (3, 2),
+    (2, 4),
+    (4, 2),
+    (3, 3),
+    (3, 4),
+    (4, 3),
+    (3, 5),
+    (5, 3),
+    (5, 5),
