+
+    for dims in choices:
+        h, w = dims
+        for _ in range(120):
+            mask = _random_mask(
+                h,
+                w,
+                min_area=force_area if force_area is not None else 4,
+                max_area=force_area if force_area is not None else 8,
+                require_odd=require_odd,
+            )
+            if mask is None:
+                continue
+            sig = _mask_signature(mask)
+            if sig not in seen:
+                seen.add(sig)
+                return mask
