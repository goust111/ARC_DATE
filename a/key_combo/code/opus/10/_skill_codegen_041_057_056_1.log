+
+
+def _gen_attempt() -> np.ndarray | None:
+    sprite_count = random.choice(SPRITE_COUNTS)
+    pair_count = (sprite_count - 1) // 2
+    seen: set[tuple[tuple[int, ...], ...]] = set()
+
