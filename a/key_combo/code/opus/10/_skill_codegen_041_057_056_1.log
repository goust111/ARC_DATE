+    seen = set()
+    coords = list(map(tuple, np.argwhere(mask)))
+    if not coords:
+        return False
+    stack = [coords[0]]
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nxt in _neighbors4(cell[0], cell[1], mask.shape[0], mask.shape[1]):
+            if mask[nxt] and nxt not in seen:
