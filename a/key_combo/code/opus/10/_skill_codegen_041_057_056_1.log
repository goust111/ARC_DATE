+    mode = random.choice(PATTERN_MODES)
+    if mode == "rows":
+        row_colors = [random.choice(chosen) for _ in range(rows)]
+        pattern = np.array([[row_colors[r]] * cols for r in range(rows)], dtype=int)
+    elif mode == "cols":
