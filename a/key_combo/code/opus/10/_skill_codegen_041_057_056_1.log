+    def backtrack(k: int) -> bool:
+        if k == len(order):
+            return True
+        idx = order[k]
+        patch = patches[idx]
+        for r, c in _candidate_locations(reserved, patch.shape):
+            h, w = patch.shape
+            reserved[r : r + h, c : c + w] = True
+            locs[idx] = (r, c)
+            if backtrack(k + 1):
+                return True
+            reserved[r : r + h, c : c + w] = False
+            locs[idx] = None
+        return False
+
+    if not backtrack(0):
