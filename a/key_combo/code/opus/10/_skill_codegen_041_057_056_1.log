+
+
+def _place_patches(top_h: int, width: int, patches: list[np.ndarray]) -> list[tuple[int, int]] | None:
+    reserved = np.zeros((top_h, width), dtype=bool)
+    locs: list[tuple[int, int] | None] = [None] * len(patches)
+    order = list(range(len(patches)))
