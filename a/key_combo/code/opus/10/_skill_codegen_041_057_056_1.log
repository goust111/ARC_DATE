+def _build_distinct_mask(
+    seen: set[tuple[tuple[int, ...], ...]],
+    *,
+    bbox_choices: tuple[tuple[int, int], ...],
+    force_bbox: tuple[int, int] | None = None,
+    force_area: int | None = None,
+    require_odd: bool = False,
