+
+def _neighbors4(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    seen = set()
+    coords = list(map(tuple, np.argwhere(mask)))
+    if not coords:
+        return False
+    stack = [coords[0]]
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        for nxt in _neighbors4(cell[0], cell[1], mask.shape[0], mask.shape[1]):
+            if mask[nxt] and nxt not in seen:
+                stack.append(nxt)
+    return len(seen) == len(coords)
+
+
+def _is_irregular(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if int(mask.sum()) == h * w:
+        return False
+    row_mixed = any(0 < int(mask[r].sum()) < w for r in range(h))
+    col_mixed = any(0 < int(mask[:, c].sum()) < h for c in range(w))
+    return row_mixed or col_mixed
+
+
+def _random_mask(
+    h: int,
+    w: int,
+    *,
+    min_area: int = 4,
+    max_area: int = 8,
+    require_odd: bool = False,
+) -> np.ndarray | None:
+    if require_odd and (h % 2 == 0 or w % 2 == 0):
+        return None
+
+    upper = min(max_area, h * w - 1)
+    if upper < min_area:
+        return None
+
+    for _ in range(300):
+        area = random.randint(min_area, upper)
+        mask = np.zeros((h, w), dtype=bool)
+        start = (random.randrange(h), random.randrange(w))
+        mask[start] = True
+
+        while int(mask.sum()) < area:
+            frontier = set()
+            for r, c in np.argwhere(mask):
+                for nr, nc in _neighbors4(int(r), int(c), h, w):
+                    if not mask[nr, nc]:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            nr, nc = random.choice(tuple(frontier))
+            mask[nr, nc] = True
