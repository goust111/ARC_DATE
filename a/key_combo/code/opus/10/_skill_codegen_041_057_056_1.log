+    (3, 2),
+    (2, 4),
+    (4, 2),
+    (3, 3),
+    (3, 4),
+    (4, 3),
+    (3, 5),
+    (5, 3),
+)
+PATTERN_MODES = ("random", "rows", "cols", "checker")
