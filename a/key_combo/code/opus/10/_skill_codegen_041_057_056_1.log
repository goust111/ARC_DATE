+            nr, nc = random.choice(tuple(frontier))
+            mask[nr, nc] = True
+
+        if int(mask.sum()) != area:
+            continue
+        rows, cols = np.where(mask)
+        if rows.min() != 0 or rows.max() != h - 1 or cols.min() != 0 or cols.max() != w - 1:
+            continue
+        if not _is_connected(mask):
+            continue
+        if not _is_irregular(mask):
+            continue
+        return mask
+    return None
