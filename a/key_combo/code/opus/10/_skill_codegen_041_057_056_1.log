+
+def _make_pattern(colors: list[int], shape: tuple[int, int], unique_color: int) -> np.ndarray:
+    rows, cols = shape
+    cell_count = rows * cols
+    usable = list(colors)
+    want = random.randint(2, min(len(usable), cell_count))
