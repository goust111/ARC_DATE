import itertools, numpy as np

def out_from_profile(H,W,m,s):
    # occupied deltas m..m+len(s)-1
    out=np.zeros((2*H,2*W),int)
    for i,st in enumerate(s):
        d=m+i
        # find start col
        c=st+d
        if not (0<=st<H and 0<=c<W):
            return None
        r=st
        while r<2*H and c<2*W:
            out[r,c]=1; r+=1; c+=1
    return out

def enclosed_regions(g):
    H,W=g.shape
    bg=(g==0)
    vis=np.zeros((H,W),bool)
    regs=[]
    for r in range(H):
      for c in range(W):
        if bg[r,c] and not vis[r,c]:
          st=[(r,c)]; vis[r,c]=1; pts=[]; touch=False
          while st:
            x,y=st.pop(); pts.append((x,y))
            if x in (0,H-1) or y in (0,W-1): touch=True
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              nx,ny=x+dx,y+dy
              if 0<=nx<H and 0<=ny<W and bg[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
          if not touch: regs.append(len(pts))
    return sorted(regs)

