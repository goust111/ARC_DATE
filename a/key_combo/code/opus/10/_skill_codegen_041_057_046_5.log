    edges//=2
    if edges!=n-1: return False
    if max(degs)>3 or sum(d==3 for d in degs)>1: return False
    # no enclosed regions in input
    if enclosed_regions(g): return False
    return True

def rand_shape(H=7,W=7):
    g=np.zeros((H,W),int)
    # grow a path then optional branch
    n=random.randint(5,10)
    r=random.randint(1,H-2); c=random.randint(1,W-2)
    path=[(r,c)]; g[r,c]=1
    while len(path)<n:
      # prefer extend from ends, occasional branch from body
      candidates=[]
      ends=[path[0],path[-1]]
      attach_points=ends if random.random()<0.8 else path
      for rr,cc in attach_points:
        for dr,dc in random.sample([(1,0),(-1,0),(0,1),(0,-1)],4):
          nr,nc=rr+dr,cc+dc
          if not (0<=nr<H and 0<=nc<W) or g[nr,nc]:
            continue
          neigh=[(nr+ddr,nc+ddc) for ddr,ddc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=nr+ddr<H and 0<=nc+ddc<W and g[nr+ddr,nc+ddc]]
          if len(neigh)!=1: continue
          # temp add and check branch limit/cycle
          g[nr,nc]=1
          pts=[tuple(x) for x in np.argwhere(g==1)]
          degs=[]; ok=True; edges=0
          for x,y in pts:
            deg=sum(1 for ddr,ddc in ((1,0),(-1,0),(0,1),(0,-1)) if 0<=x+ddr<H and 0<=y+ddc<W and g[x+ddr,y+ddc])
            degs.append(deg); edges+=deg
          edges//=2
          if edges!=len(pts)-1 or max(degs)>3 or sum(d==3 for d in degs)>1:
            ok=False
          if ok: candidates.append((nr,nc))
          g[nr,nc]=0
      if not candidates:
        return None
      nr,nc=random.choice(candidates)
      g[nr,nc]=1
      # update path roughly; not exact for branch case but okay
      path.append((nr,nc))
    return g

seen=set(); found=0; start=time.time()
for i in range(200000):
  g=rand_shape(7,7)
  if g is None or not input_ok(g):
    continue
  regs=enclosed_regions(tile(g))
  areas=sorted(len(x) for x in regs)
  if len(set(areas))<2 or not any(a%2==0 for a in areas) or not any(a%2==1 for a in areas):
    continue
  key=g.tobytes()
  if key in seen: continue
  seen.add(key); found+=1
  ys,xs=np.where(g==1)
  print('"'FOUND',found,'iter',i,'bbox',((ys.min(),xs.min()),(ys.max(),xs.max())),'areas',areas)
  for row in g:
    print(''.join('#' if v else '.' for v in row))
  print()
  if found>=15: break
print('done',found,'time',time.time()-start)
