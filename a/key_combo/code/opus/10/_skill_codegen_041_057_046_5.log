import numpy as np, random, time

def tile(g):
    H,W=g.shape
    out=np.zeros((2*H,2*W),dtype=int)
    for r,c in np.argwhere(g==1):
        rr,cc=r,c
        while rr<2*H and cc<2*W:
            out[rr,cc]=1
            rr+=1; cc+=1
    return out

def enclosed(g):
    H,W=g.shape; vis=np.zeros((H,W),bool); regs=[]
    for r in range(H):
      for c in range(W):
        if g[r,c]==0 and not vis[r,c]:
          st=[(r,c)]; vis[r,c]=1; area=0; touch=False
          while st:
            x,y=st.pop(); area+=1
            if x in (0,H-1) or y in (0,W-1): touch=True
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              nx,ny=x+dx,y+dy
              if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
          if not touch: regs.append(area)
    return sorted(regs)

def comp_count(mask):
    H,W=mask.shape; vis=np.zeros((H,W),bool); n=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not vis[r,c]:
          n+=1; st=[(r,c)]; vis[r,c]=1
          while st:
            x,y=st.pop()
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              nx,ny=x+dx,y+dy
              if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
    return n

def rand_path(H,W,n):
    g=np.zeros((H,W),int)
    r=random.randrange(H); c=random.randrange(W)
    g[r,c]=1; path=[(r,c)]
    while len(path)<n:
      r,c=path[-1]
      opts=[]
      for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<H and 0<=nc<W and g[nr,nc]==0:
