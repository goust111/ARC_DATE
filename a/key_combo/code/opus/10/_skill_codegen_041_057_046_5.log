import itertools, numpy as np

def cells_from_segments(lengths, dirs):
    r=c=0
    cells=[(r,c)]
    for L,(dr,dc) in zip(lengths,dirs):
        for _ in range(L):
            r+=dr; c+=dc; cells.append((r,c))
    return cells

def normalize(cells):
    r0=min(r for r,c in cells); c0=min(c for r,c in cells)
    return [(r-r0,c-c0) for r,c in cells]

def grid_from(cells):
    cells=normalize(cells)
    h=max(r for r,c in cells)+1; w=max(c for r,c in cells)+1
    g=np.zeros((h,w),int)
    for r,c in cells:
      if g[r,c]: return None
      g[r,c]=1
    return g

def tile(g,H=None,W=None,off=(0,0)):
    if H is None: H,W=g.shape
    out=np.zeros((2*H,2*W),int)
    pts=np.argwhere(g==1)
    for r,c in pts:
      rr,cc=r,c
      while rr<2*H and cc<2*W:
        out[rr,cc]=1; rr+=1; cc+=1
    return out

def enclosed(g):
    H,W=g.shape; vis=np.zeros((H,W),bool); regs=[]
    for r in range(H):
      for c in range(W):
        if g[r,c]==0 and not vis[r,c]:
          st=[(r,c)]; vis[r,c]=1; area=0; touch=False
          while st:
            x,y=st.pop(); area+=1
            if x in (0,H-1) or y in (0,W-1): touch=True
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              nx,ny=x+dx,y+dy
              if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
          if not touch: regs.append(area)
    return sorted(regs)

# alternating dirs no immediate reverse
DIRS=[(0,1),(1,0),(0,-1),(-1,0)]

def next_dirs(prev):
  idx=DIRS.index(prev)
  return [DIRS[(idx+1)%4], DIRS[(idx-1)%4]]

found=0
for segs in range(3,7):
  # segs segments, cells = 1 + sum(lengths) in 5..10
  for lengths in itertools.product([1,2,3,4], repeat=segs):
    total=1+sum(lengths)
    if not (5<=total<=10): continue
    for start_dir in DIRS:
      dir_lists=[[start_dir]]
      for _ in range(segs-1):
        new=[]
        for dl in dir_lists:
          for nd in next_dirs(dl[-1]):
            new.append(dl+[nd])
        dir_lists=new
      for dirs in dir_lists:
        cells=cells_from_segments(lengths,dirs)
        if len(set(cells))"'!=len(cells):
          continue
        g=grid_from(cells)
        if g is None or max(g.shape)>7:
          continue
        areas=enclosed(tile(g))
        if len(areas)>=2:
          found+=1
          print('"'found',found,'segs',segs,'lengths',lengths,'dirs',dirs,'shape',g.shape,'areas',areas)
          for row in g:
            print(''.join('#' if v else '.' for v in row))
          print()
          if found>=40: raise SystemExit
print('done',found)
