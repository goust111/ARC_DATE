    marker_mask = (variant != int(bg)) & (variant != int(skeleton))
    cells = [
        (int(r + dr), int(c + dc), int(variant[int(r), int(c)]))
        for r, c in np.argwhere(marker_mask)
    ]
    return tuple(sorted(cells))


