            sign = 1 if cross > 0 else -1
            turn_signs[(r, c)] = sign
            counts[sign] += 1

        assert turn_signs
        assert abs(counts[1] - counts[-1]) == 4, counts
        convex_sign = 1 if counts[1] > counts[-1] else -1
        for (r, c), sign in turn_signs.items():
            out[r, c] = YELLOW if sign == convex_sign else RED

    return out

