+
+def _find_path(
+    start: tuple[int, int],
+    end: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cell = q.popleft()
+        if cell == end:
+            path = []
+            cur = end
+            while cur is not None:
+                path.append(cur)
+                cur = prev[cur]
+            return path[::-1]
+        neighbors = list(_neighbors4(*cell))
+        random.shuffle(neighbors)
+        for nr, nc in neighbors:
