+from __future__ import annotations
+
+import itertools
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GUIDE_COLOR_POOL = [3, 4, 6, 7, 8, 9]
+CENTER_COLOR_POOL = [3, 4, 5, 6, 7, 8, 9]
+FRAME_SIZE = 5
+VECTOR_BOUND = 8
+GEN_ATTEMPTS = 400
+VECTOR_SAMPLE_TRIES = 20000
+CONNECT_TRIES = 60
