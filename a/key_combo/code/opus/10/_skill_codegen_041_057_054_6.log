+def _blue_cycle_edges(grid: np.ndarray, red_parts: list[list[tuple[int, int]]]) -> set[tuple[int, int]]:
+    owner = {}
+    for idx, cells in enumerate(red_parts):
+        for cell in cells:
+            owner[cell] = idx
