+    edges: set[tuple[int, int]] = set()
+    for cells in _components(grid == BLUE):
+        touched = set()
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                idx = owner.get((nr, nc))
+                if idx is not None:
+                    touched.add(idx)
+        assert len(touched) == 2
+        a, b = sorted(touched)
+        edges.add((a, b))
