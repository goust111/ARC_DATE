+            frame_box = (dr - 1, dc - 1, dr + 3, dc + 3)
+            center_box = (0, 0, 2, 2)
+            if not (
+                frame_box[2] < center_box[0]
+                or center_box[2] < frame_box[0]
+                or frame_box[3] < center_box[1]
+                or center_box[3] < frame_box[1]
