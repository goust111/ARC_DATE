+def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], occupied: set[tuple[int, int]]):
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = RED
+    grid[r1, c0 : c1 + 1] = RED
+    grid[r0 : r1 + 1, c0] = RED
+    grid[r0 : r1 + 1, c1] = RED
