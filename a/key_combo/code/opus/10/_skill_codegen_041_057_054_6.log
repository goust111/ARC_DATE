+        coord_set = set(coords)
+        subsets = []
+        for k in range(2, len(coords)):
+            for sub in itertools.combinations(coords, k):
+                if not _is_connected(sub):
+                    continue
+                valid = set()
+                for sr, sc in sub:
+                    for cr, cc in coords:
+                        dr = sr - cr
+                        dc = sc - cc
+                        if all((r - dr, c - dc) in coord_set for r, c in sub):
+                            valid.add((dr, dc))
+                if valid == {(0, 0)}:
+                    subsets.append(tuple(sorted(sub)))
