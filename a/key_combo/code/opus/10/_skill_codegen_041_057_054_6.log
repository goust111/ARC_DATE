+        for dc in range(-VECTOR_BOUND, VECTOR_BOUND + 1):
+            if dr == 0 and dc == 0:
+                continue
+            if max(abs(dr), abs(dc)) < 4:
+                continue
+            frame_box = (dr - 1, dc - 1, dr + 3, dc + 3)
+            center_box = (0, 0, 2, 2)
+            if not (
+                frame_box[2] < center_box[0]
+                or center_box[2] < frame_box[0]
+                or frame_box[3] < center_box[1]
+                or center_box[3] < frame_box[1]
+            ):
+                continue
+            out.append((dr, dc))
+    return out
