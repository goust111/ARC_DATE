+    for dr, dc in vectors:
+        box = (dr - 1, dc - 1, dr + 3, dc + 3)
+        for other in boxes:
+            if not (
+                box[2] + 1 < other[0]
+                or other[2] + 1 < box[0]
+                or box[3] + 1 < other[1]
+                or other[3] + 1 < box[1]
