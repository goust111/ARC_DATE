+        cross_r = int(rng.integers(cross_r_lo, cross_r_hi + 1))
+        cross_c = int(rng.integers(cross_c_lo, cross_c_hi + 1))
+        h_anchor_r = cross_r - h_local_row
+        v_anchor_c = cross_c - v_local_col
