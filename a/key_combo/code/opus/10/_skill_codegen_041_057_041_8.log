+    occupied_core: set[tuple[int, int]],
+    h: int,
+    w: int,
+    work_r0: int,
+    work_c0: int,
+    panel_box: tuple[int, int, int, int],
+    rng: np.random.Generator,
+) -> tuple[
+    dict[int, list[list[tuple[int, int]]]],
+    dict[int, set[tuple[int, int]]],
+    set[tuple[int, int]],
+    set[tuple[int, int]],
+] | None:
+    (color_a, shape_a, orient_a), (color_b, shape_b, orient_b) = specs
+    rows_a = sorted({r for r, _ in shape_a})
+    cols_a = sorted({c for _, c in shape_a})
+    rows_b = sorted({r for r, _ in shape_b})
+    cols_b = sorted({c for _, c in shape_b})
+
+    for _ in range(500):
+        cross_r = int(rng.integers(work_r0 + 2, h - 4))
+        cross_c = int(rng.integers(work_c0 + 3, w - 4))
