+        h_left = _shape_cells(h_shape, (h_anchor_r, left_h_c))
+        h_right = _shape_cells(h_shape, (h_anchor_r, right_h_c))
+        v_top = _shape_cells(v_shape, (top_v_r, v_anchor_c))
+        v_bottom = _shape_cells(v_shape, (bottom_v_r, v_anchor_c))
