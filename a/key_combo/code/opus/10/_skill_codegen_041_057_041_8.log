+        v_path = _pair_path_from_cells(v_top, v_bottom)
+        if not h_path or not v_path:
+            continue
+        if (cross_r, cross_c) not in h_path or (cross_r, cross_c) not in v_path:
+            continue
+        if (h_path & v_path) != {(cross_r, cross_c)}:
