+        cross_c_hi = min(w - v_w + v_local_col, h_path_hi)
+        cross_r_lo = max(work_r0 + h_local_row, v_path_lo)
+        cross_r_hi = min(h - h_h + h_local_row, v_path_hi)
+        if cross_c_lo > cross_c_hi or cross_r_lo > cross_r_hi:
+            continue
