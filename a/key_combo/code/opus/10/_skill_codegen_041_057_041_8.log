+        cross_specs = [
+            (legend_colors[0], legend_shapes[0], cross_order[0]),
+            (legend_colors[1], legend_shapes[1], cross_order[1]),
+        ]
+        placed = _place_crossing_pairs(
+            cross_specs,
+            occupied_halo,
