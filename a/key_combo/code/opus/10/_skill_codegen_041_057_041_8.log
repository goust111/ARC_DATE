+    out = _apply_priority(base, fill_by_color, priority)
+
+    r0, c0, r1, c1 = panel_box
+    out[r0 : r1 + 1, c0 : c1 + 1] = g[r0 : r1 + 1, c0 : c1 + 1]
+    return out
