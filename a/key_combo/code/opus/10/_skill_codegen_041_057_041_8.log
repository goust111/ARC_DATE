+            same_color_existing = [_cells_to_profile(cells) for cells in planned_shapes[extra_color]]
+            extra_profiles = [_cells_to_profile(extra_a), _cells_to_profile(extra_b)]
+            dummy = np.zeros((h, w), dtype=int)
