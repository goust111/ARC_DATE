+
+
+def _compose_expected_output(
+    grid: np.ndarray,
+    planned_shapes: dict[int, list[list[tuple[int, int]]]],
+    priority: list[int],
+    planned_paths: dict[int, set[tuple[int, int]]],
+    panel_box: tuple[int, int, int, int],
+) -> np.ndarray:
