+            right_a_c = int(rng.integers(cross_c + 2, w - 1))
+            if a_anchor_r < work_r0 or a_anchor_r + 1 >= h or right_a_c + 1 >= w:
+                continue
+            a_left = _shape_cells(shape_a, (a_anchor_r, left_a_c))
+            a_right = _shape_cells(shape_a, (a_anchor_r, right_a_c))
+        else:
+            local_col = int(rng.choice(cols_a))
+            a_anchor_c = cross_c - local_col
+            top_a_r = int(rng.integers(work_r0, max(work_r0 + 1, cross_r - 3)))
+            bottom_a_r = int(rng.integers(cross_r + 2, h - 1))
+            if a_anchor_c < work_c0 or a_anchor_c + 1 >= w or bottom_a_r + 1 >= h:
+                continue
+            a_left = _shape_cells(shape_a, (top_a_r, a_anchor_c))
+            a_right = _shape_cells(shape_a, (bottom_a_r, a_anchor_c))
+
+        if orient_b == "H":
+            local_row = int(rng.choice(rows_b))
+            b_anchor_r = cross_r - local_row
+            left_b_c = int(rng.integers(work_c0, max(work_c0 + 1, cross_c - 3)))
+            right_b_c = int(rng.integers(cross_c + 2, w - 1))
+            if b_anchor_r < work_r0 or b_anchor_r + 1 >= h or right_b_c + 1 >= w:
+                continue
+            b_left = _shape_cells(shape_b, (b_anchor_r, left_b_c))
+            b_right = _shape_cells(shape_b, (b_anchor_r, right_b_c))
+        else:
+            local_col = int(rng.choice(cols_b))
+            b_anchor_c = cross_c - local_col
+            top_b_r = int(rng.integers(work_r0, max(work_r0 + 1, cross_r - 3)))
+            bottom_b_r = int(rng.integers(cross_r + 2, h - 1))
+            if b_anchor_c < work_c0 or b_anchor_c + 1 >= w or bottom_b_r + 1 >= h:
+                continue
+            b_left = _shape_cells(shape_b, (top_b_r, b_anchor_c))
+            b_right = _shape_cells(shape_b, (bottom_b_r, b_anchor_c))
+
+        all_candidates = [a_left, a_right, b_left, b_right]
+        temp_halo = set(occupied_halo)
+        ok = True
+        for cells in all_candidates:
+            if not _can_place_cells(cells, temp_halo, h, w, work_r0, panel_box):
+                ok = False
+                break
+            temp_halo |= _shape_halo(cells, h, w)
