+        extra_shape = legend_shapes[extra_idx]
+        for _ in range(300):
+            a_r = int(rng.integers(work_r0, h - 1))
+            a_c = int(rng.integers(work_c0, w - 1))
+            b_r = int(rng.integers(work_r0, h - 1))
