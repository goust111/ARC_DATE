+
+def _side_values(arr: np.ndarray, side: str, *, exclude_corners: bool) -> np.ndarray:
+    if side == "top":
+        vals = arr[0, :]
+    elif side == "bottom":
+        vals = arr[-1, :]
+    elif side == "left":
