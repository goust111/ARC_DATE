  "src": "solid multicolor target rectangle separated from isolated horizontal two-pixel color legends",
  "symbol_instructions": "each legend domino maps its right color to its left color",
  "transform": "crop to the target rectangle bbox; recolor target pixels whose color is a legend right color to that legend's left color; preserve the remaining base color",
  "grid_shape": "target rectangle bbox"
}
</annotation>
<generation_spec>
