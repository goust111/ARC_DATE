VALID_DIRECTIONS = {(-1, 0), (1, 0), (0, -1), (0, 1)}


def _marker_direction(g: np.ndarray, body_color: int, r: int, c: int) -> tuple[int, int]:
    H, W = g.shape
    rel: list[tuple[int, int]] = []
