+    "right": {
+        "shape": (3, 4),
+        "grey": {(1, 0), (1, 2), (1, 3), (0, 1), (2, 1)},
+        "marker": (1, 1),
+        "tip": (1, 3),
+    },
+    "left": {
+        "shape": (3, 4),
+        "grey": {(1, 0), (1, 1), (1, 3), (0, 2), (2, 2)},
+        "marker": (1, 2),
+        "tip": (1, 0),
+    },
+    "down": {
+        "shape": (4, 3),
+        "grey": {(0, 1), (2, 1), (3, 1), (1, 0), (1, 2)},
+        "marker": (1, 1),
+        "tip": (3, 1),
+    },
+    "up": {
+        "shape": (4, 3),
+        "grey": {(0, 1), (1, 1), (3, 1), (2, 0), (2, 2)},
+        "marker": (2, 1),
+        "tip": (0, 1),
