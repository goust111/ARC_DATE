+import numpy as np
+
+
+BG = 0
+FRAME = 5
+SIDE_ORDER = ("up", "down", "left", "right")
+SIDE_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
