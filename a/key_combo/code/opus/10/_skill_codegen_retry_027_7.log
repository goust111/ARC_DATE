+        "down": [(r1 + 1, top_start), (r1 + 1, top_start + 1)],
+        "left": [(side_start, c0 - 1), (side_start + 1, c0 - 1)],
+        "right": [(side_start, c1 + 1), (side_start + 1, c1 + 1)],
