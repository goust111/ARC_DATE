spec:
  grid: 13x13, background 0
  target:
    shape: solid filled rectangle, 4-7 rows x 4-7 cols
    colors: 1 base color + 2-3 source colors; each non-base color forms one 4-connected blob of 3-5 cells
    base_color_fraction: 56-75% of target area
  legends:
    count: 2-3 (one per source color in target)
    shape: horizontal 1x2 domino; left=replacement, right=source
    source: a color present in target; replacement: a color absent from target
    placement: scattered on grid, each separated from target and all other components by >=1 bg cell
  color_budget: all 2*N+1 non-bg colors are distinct (N=num_legends); no color reuse across base, sources, replacements
  output: crop target bbox, replace each source color with its legend replacement; base color preserved

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid 13x13, bg=0. Choose N in {2,3}. Pick 2*N+1 distinct non-bg colors; assign 1 as base, N as source, N as replacement.
    2. Build the OUTPUT rectangle (4-7 rows x 4-7 cols) using base + replacement colors. Fill with base, then paint N connected blobs (one per replacement color, 3-5 cells each) ensuring base >= 56% of area.
    3. Derive the INPUT target by swapping each replacement color back to its source color.
    4. Place target rectangle at a random position on the 13x13 grid with >=2 cells margin from all edges (to leave room for legends).
    5. For each (replacement, source) pair, create a 1x2 legend domino [replacement, source]. Place each on the grid separated from the target and all other dominos by >=1 bg cell.
```
