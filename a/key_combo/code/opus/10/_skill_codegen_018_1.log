    require_internal_gap: bool = False,
) -> tuple[int, ...] | None:
    settled = _gen_settled_positions(size, count)
    choices = []
    for positions in _gen_position_sets(size, count):
        unsettled = positions != settled
        gap_sizes = [
            positions[i + 1] - positions[i] - 1
