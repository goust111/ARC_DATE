            size,
            count,
            require_unsettled=col in unsettled_cols,
            require_internal_gap=col == internal_gap_col,
        )
        if positions is None:
            return None
        inp[list(positions), col] = color_by_col[col]
    return inp if np.array_equal(main(inp), out) else None


