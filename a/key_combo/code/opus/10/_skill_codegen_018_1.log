# Canvas and colors.
GEN_GRID_SHAPE = (10, 10)
GEN_BG_COLOR = Color.BLACK
GEN_MARKER_COLOR = Color.BLUE
GEN_NEIGHBORS = (
    (-1, 0, Color.RED), (0, -1, Color.ORANGE),
    (0, 1, Color.PINK), (1, 0, Color.TEAL),
)

