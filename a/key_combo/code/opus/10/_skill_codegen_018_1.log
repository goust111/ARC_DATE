        return None

    populated, packed_counts = random.choice(options)
    columns = random.sample(range(size), populated)
    counts = [0] * size
    shuffled_counts = list(packed_counts)
    random.shuffle(shuffled_counts)
    for col, count in zip(columns, shuffled_counts):
