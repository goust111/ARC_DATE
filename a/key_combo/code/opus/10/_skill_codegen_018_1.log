+
+    moved = np.count_nonzero((out == _FALLING) | (out == _LEFT_COLOR) | (out == _RIGHT_COLOR))
+    if moved != len(roles):
+        return False
+
+    if np.count_nonzero(out == _LEFT_COLOR) < 1:
+        return False
+    if np.count_nonzero(out == _RIGHT_COLOR) < 1:
+        return False
+    if np.count_nonzero(out == _FALLING) < 1:
