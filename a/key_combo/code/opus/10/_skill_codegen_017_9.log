    red_count = int(red.sum())
    if not WALL_COUNT_MIN <= red_count <= WALL_COUNT_MAX:
        return None
    if any(int(red[:, c].sum()) > MAX_RED_PER_COLUMN for c in range(GRID_SIZE)):
