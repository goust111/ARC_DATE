+def _neighbors8(coord: tuple[int, int]) -> Iterable[tuple[int, int]]:
+    r, c = coord
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
