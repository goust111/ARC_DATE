    gray_objects = find_components(
        g,
        bg=bg,
        colors=[Color.GREY],
        connectivity=4,
        return_format="dict",
    )
    assert gray_objects

    out = g.copy()
    blue_cells = {tuple(map(int, rc)) for rc in np.argwhere(g == Color.BLUE)}
