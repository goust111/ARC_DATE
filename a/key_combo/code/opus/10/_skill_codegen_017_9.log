    touches_left = bool(red[:, LOWER_LEFT[1]].any())
    touches_right = bool(red[:, LAST_IDX].any())
    touches_bottom = bool(red[LAST_IDX, :].any())
    if not ((touches_left and touches_right) or (touches_left and touches_bottom)):
