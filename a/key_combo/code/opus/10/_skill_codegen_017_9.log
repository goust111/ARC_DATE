from typing import Iterable

import numpy as np


TOP = 1
RIGHT = 2
BOTTOM = 3
LEFT = 4
GREY = 5
BLACK = 0

MOVE_PRIORITY = {TOP: 0, RIGHT: 1, BOTTOM: 2, LEFT: 3}
FRAME_COLORS = {TOP, RIGHT, BOTTOM, LEFT}
ALL_INPUT_COLORS = {BLACK, TOP, RIGHT, BOTTOM, LEFT, GREY}

