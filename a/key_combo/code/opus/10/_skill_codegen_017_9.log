+    occupied: set[tuple[int, int]] = set()
+    solved: list[tuple[tuple[int, int], int, tuple[int, int], tuple[int, int]]] = []
+    for start, color, key, target in movable:
+        dr, dc = _step(color)
+        r, c = start
+        while (r, c) != target:
+            nr, nc = r + dr, c + dc
+            if (nr, nc) in occupied:
+                break
+            r, c = nr, nc
+        occupied.add((r, c))
+        solved.append((start, color, key, (r, c)))
