+def _target_for(color: int, r: int, c: int, bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if color == TOP:
+        return r0 + 1, c
+    if color == RIGHT:
+        return r, c1 - 1
+    if color == BOTTOM:
+        return r1 - 1, c
+    if color == LEFT:
+        return r, c0 + 1
+    raise ValueError(f"unsupported movable color: {color}")
+
+
+def _sort_key(color: int, r: int, c: int, bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    if color == TOP:
+        return r - (r0 + 1), c
+    if color == RIGHT:
+        return (c1 - 1) - c, r
+    if color == BOTTOM:
+        return (r1 - 1) - r, c
+    if color == LEFT:
+        return c - (c0 + 1), r
+    raise ValueError(f"unsupported movable color: {color}")
+
+
+def _step(color: int) -> tuple[int, int]:
+    if color == TOP:
+        return -1, 0
+    if color == RIGHT:
+        return 0, 1
+    if color == BOTTOM:
+        return 1, 0
+    if color == LEFT:
+        return 0, -1
+    raise ValueError(f"unsupported movable color: {color}")
