+    r0 = _cell_origin(ri, cell_h)
+    c0 = _cell_origin(ci, cell_w)
+    rr = r0 + random.randint(0, cell_h - 1)
+    cc = c0 + random.randint(0, cell_w - 1)
+    grid[rr, cc] = color
