+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+MARKER_COLORS = (BLUE, GREEN, ORANGE)
+TABLE_SIZE = 3
+GEN_MAX_ATTEMPTS = 400
+
+_GEN_CALL_COUNT = 0
+_MARKER_PERMS = list(itertools.permutations(range(TABLE_SIZE)))
