+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _is_connected4(mask: np.ndarray) -> bool:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if not coords:
+        return False
+    h, w = mask.shape
+    seen = {coords[0]}
+    stack = [coords[0]]
+    while stack:
