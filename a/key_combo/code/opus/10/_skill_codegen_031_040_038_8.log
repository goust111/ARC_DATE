+    row_runs = _non_divider_runs(g.shape[0], row_dividers)
+    col_runs = _non_divider_runs(g.shape[1], col_dividers)
+    assert len(row_runs) == TABLE_SIZE
+    assert len(col_runs) == TABLE_SIZE
