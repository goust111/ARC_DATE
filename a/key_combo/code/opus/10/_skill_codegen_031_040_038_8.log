+
+
+def _gen_attempt(mode: int) -> np.ndarray | None:
+    cell_h, cell_w = _choose_cell_sizes(mode)
+    height = TABLE_SIZE * cell_h + (TABLE_SIZE - 1)
+    width = TABLE_SIZE * cell_w + (TABLE_SIZE - 1)
