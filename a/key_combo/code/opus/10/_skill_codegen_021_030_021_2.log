+        for shift in range(5)
+    }
+    assert len(set(signatures.values())) == 5
+
+    for c, color in enumerate(control):
+        sig = tuple(int(v) for v in out[:, c])
+        assert sig == signatures[SHIFT_BY_COLOR[int(color)]]
+
+    color_to_sig = {}
+    for c, color in enumerate(control):
