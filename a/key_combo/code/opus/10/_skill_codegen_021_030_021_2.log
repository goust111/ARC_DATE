+MAX_WIDTH = 15
+GENERATION_RETRIES = 300
+
+
+def _roll_column_manual(column: np.ndarray, shift: int) -> np.ndarray:
+    h = int(column.shape[0])
+    out = np.empty_like(column)
+    for r in range(h):
+        out[(r + shift) % h] = column[r]
+    return out
+
+
