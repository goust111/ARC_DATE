+    width = random.randint(MIN_WIDTH, MAX_WIDTH)
+
+    body = _make_stripe_body(stripe_height, width)
+    control = _sample_control_row(width)
+    grid = np.vstack([body, control[np.newaxis, :]])
+
+    _validate_semantics(grid)
