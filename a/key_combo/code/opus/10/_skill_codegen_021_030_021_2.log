+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+STRIPE_COLOR = 5
+SHIFT_BY_COLOR = {
+    0: 0,
+    1: 1,
+    2: 2,
+    3: 3,
+    4: 4,
+}
+
+MIN_STRIPE_HEIGHT = 9
+MAX_STRIPE_HEIGHT = 29
+MIN_WIDTH = 7
+MAX_WIDTH = 15
