+    nonzero = [int(value) for value in control if int(value) != 0]
+    assert len(nonzero) >= 3
+    assert len(set(nonzero)) >= 2
+    assert set(control).issuperset({0, 1, 2, 3, 4})
+
+    out = main(g)
+    expected = _manual_expected(g)
+    assert np.array_equal(out, expected)
+
+    base_column = body[:, 0]
+    signatures = {
