+    assert g.ndim == 2
+    assert g.shape[0] >= 2
+
+    body = g[:-1]
+    control = g[-1]
+    out = np.empty_like(body)
+    for c, color in enumerate(control):
+        shift = SHIFT_BY_COLOR.get(int(color))
+        assert shift is not None, "control row must use only colors 0..4"
+        out[:, c] = np.roll(body[:, c], shift=shift)
+    return out
+
