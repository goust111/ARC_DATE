_GEN_BLACK_COMPONENT_MIN_COUNT = 3
_GEN_BLACK_COMPONENT_MAX_COUNT = 5
_GEN_BLACK_COMPONENT_MIN_AREA = 2
_GEN_BLACK_COMPONENT_MAX_AREA = 110
