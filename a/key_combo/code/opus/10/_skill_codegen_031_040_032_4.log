+def _stamp_painted_cells(pattern: np.ndarray, top: int, left: int, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for r in range(pattern.shape[0]):
+        for c in range(pattern.shape[1]):
