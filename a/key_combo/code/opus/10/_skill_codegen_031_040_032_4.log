+    r0 = max(0, top)
+    c0 = max(0, left)
+    r1 = min(h - 1, top + height - 1)
+    c1 = min(w - 1, left + width - 1)
+    if r0 > r1 or c0 > c1:
+        return None
+    return (r0, c0, r1, c1)
