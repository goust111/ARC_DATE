+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+FRAME_COLORS = (BLUE, GREEN, ORANGE)
+PATTERN_COLORS = (RED, GREY)
+
+GRID_MIN = 20
+GRID_MAX = 27  # exclusive
+FRAME_COUNT_CHOICES = (2, 3)
+INTERIOR_SIZE_CHOICES = (3, 4, 5)
+MAX_RETRIES = 500
