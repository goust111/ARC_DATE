+        frontier = {(rr, cols[-1]) for rr in range(r0, r1 + 1)}
+        outward = (0, -1)
+    else:
+        start_flags = [int(g[hub_r0 + dr, hub_c0 + 3]) in PATHISH for dr in range(3)]
+        seg = _single_segment(start_flags)
