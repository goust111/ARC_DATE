+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+SEED_PALETTE = (BLUE, RED, YELLOW, ORANGE)
+PATHISH = {GREY, GREEN, MAROON}
+NON_SEED_COLORS = {BG, GREEN, GREY, MAROON}
