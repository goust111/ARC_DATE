+        r = hub_r0 + 3
+        while r < H and all(int(g[r, c]) in PATHISH for c in range(c0, c1 + 1)):
+            rows.append(r)
+            r += 1
+        assert rows
+        cells = {(rr, cc) for rr in rows for cc in range(c0, c1 + 1)}
+        frontier = {(rows[-1], cc) for cc in range(c0, c1 + 1)}
