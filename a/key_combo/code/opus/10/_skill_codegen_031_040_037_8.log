+
+
+def _place_seed(
+    grid: np.ndarray,
+    direction: str,
+    frontier: list[tuple[int, int]],
+    color: int,
+) -> set[tuple[int, int]] | None:
+    H, W = grid.shape
+    if direction in ("top", "bottom"):
+        base_axis = min(c for _r, c in frontier)
+        width = len(frontier)
+        adj_row = frontier[0][0] + (-1 if direction == "top" else 1)
+    else:
