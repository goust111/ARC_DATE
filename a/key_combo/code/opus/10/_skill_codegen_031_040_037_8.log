+
+def _component_of_color(grid: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    H, W = grid.shape
+    sr, sc = start
+    color = int(grid[sr, sc])
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < H and 0 <= nc < W and (nr, nc) not in seen and int(grid[nr, nc]) == color:
