+    if degree_multiset != expected:
+        return False
+    if max(depths.values()) != len(grey_components):
+        return False
+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return False
+    if not np.array_equal(out[grid == GREY], grid[grid == GREY]):
+        return False
