+def _render_candidate() -> np.ndarray | None:
+    layer_count = random.choices([2, 3], weights=[1, 5], k=1)[0]
+    height = random.randint(18 if layer_count == 3 else 16, 24)
+    width = random.randint(18 if layer_count == 3 else 16, 24)
