+    assert cols[1] == cols[0] + 1 and cols[2] == cols[1] + 1, "palette must be contiguous"
+    palette = [int(row[c]) for c in cols]
+    return palette, cols
+
+
+def _boundary_mask(filled: np.ndarray) -> np.ndarray:
+    h, w = filled.shape
+    boundary = np.zeros_like(filled, dtype=bool)
+    for r in range(h):
+        for c in range(w):
