_GEN_MAX_TAILS = 2
_GEN_MIN_TAIL_LENGTH = 1
_GEN_MIN_OPEN_PATH_LENGTH = 2
_GEN_MAX_PATH_CANDIDATES = 40
_GEN_COVER_BLUE_RETRIES = 6
