        degree = sum((r + dr, c + dc) in pts for dr, dc in GEN_DIRS4)
        if degree != 2:
            return None

    start = min(pts)
    neigh = sorted((start[0] + dr, start[1] + dc) for dr, dc in GEN_DIRS4 if (start[0] + dr, start[1] + dc) in pts)
    if len(neigh) != 2:
        return None
    path = [start]
    prev, cur = start, neigh[0]
    while cur != start:
        path.append(cur)
        nxt = [
