+        for c in range(w):
+            if not filled[r, c]:
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(filled.shape, nr, nc) or not filled[nr, nc]:
+                    boundary[r, c] = True
