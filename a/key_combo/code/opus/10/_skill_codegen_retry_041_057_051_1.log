+def _is_simple_cycle(mask: np.ndarray) -> bool:
+    labels, comps = _label_components(mask)
+    if len(comps) != 1:
+        return False
+    pts = comps[0]
+    for r, c in pts:
+        degree = 0
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds(mask.shape, nr, nc) and labels[nr, nc] == 1:
+                degree += 1
+        if degree != 2:
+            return False
+    return True
