+    grid[0, palette_start : palette_start + 3] = np.array(PALETTE_COLORS, dtype=int)
+
+    available = (2, 1, height - 2, width - 2)
+    irregular = False
+    for depth_idx in range(layer_count):
+        bbox = _pick_bbox(available, layer_count - depth_idx)
+        if bbox is None:
+            return None
