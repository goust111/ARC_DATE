+
+    for comp in bottom:
+        mirrored = frozenset(_mirror_across_separator(comp["coords"], sep))
+        match = top_by_coords.get(mirrored)
+        if match is None:
+            for r, c in comp["coords"]:
+                out[r, c] = bg
+            continue
