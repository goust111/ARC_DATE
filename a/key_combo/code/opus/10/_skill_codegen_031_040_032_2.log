+
+def _place_random(shape: list[Coord], row_lo: int, row_hi: int, W: int, reserved: np.ndarray) -> list[Coord] | None:
+    _, _, max_r, max_c = _bbox(shape)
+    h = max_r + 1
+    w = max_c + 1
