+
+    return out
+
+
+def _make_ring_shape() -> list[Coord]:
+    return [(r, c) for r in range(3) for c in range(3) if (r, c) != (1, 1)]
+
+
+def _make_polyomino() -> list[Coord] | None:
+    for _ in range(GEN_SHAPE_ATTEMPTS):
+        area = random.randint(3, 7)
+        cells = {(0, 0)}
