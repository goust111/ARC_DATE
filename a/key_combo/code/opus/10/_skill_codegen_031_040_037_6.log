+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+OCCLUDER = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+RETRY_LIMIT = 400
