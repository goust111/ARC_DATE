+            continue
+        if _strict_period(seq) != period:
+            continue
+        return seq
+    raise RuntimeError("failed to sample a non-degenerate periodic color sequence")
+
+
+def _occluder_candidates(
+    clean: np.ndarray,
+    offsets: tuple[int, ...],
+    row_start: int,
+    row_end: int,
+    period: int,
+    size: int,
