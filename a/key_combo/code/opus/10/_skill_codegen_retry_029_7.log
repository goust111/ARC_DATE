+    if set(map(int, np.unique(grid))) - {BLACK, BLUE, RED, GREEN}:
+        return False
+    if int(np.sum(grid == BLUE)) != 1 or int(np.sum(grid == RED)) != 2:
+        return False
+
+    box = bbox(grid != BLACK)
