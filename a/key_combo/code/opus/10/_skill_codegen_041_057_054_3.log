spec:
  grid:
    input: (2H+1) rows x W cols; H=3-6, W=3-6 [observed H=4, W=4]
    output: H rows x W cols
  separator:
    solid row of a single color at row H, spanning full width
    color appears nowhere else in grid; yellow(4) [observed]
  masks:
    upper (rows 0..H-1) and lower (rows H+1..2H) each have exactly 2 colors
    shared background color: black(0) [observed]
    upper foreground: blue(1) [observed]; lower foreground: red(2) [observed]
    all 3 non-separator colors are distinct and none is green
    foreground density per mask: 25-80% of cells
  output_rule:
    XOR of upper and lower foreground masks; green(3) where exactly one is foreground, bg elsewhere
  non_trivial:
    output has both green and bg cells (XOR is neither empty nor full)
    green density in output: 30-70%

generation_strategy:
  approach: output-first
  steps:
    1. Pick H in 3-6, W in 3-6 (default H=W=4 to match eval)
    2. Generate output mask M (H x W) with green density 30-70%; ensure at least 1 green and 1 bg cell
    3. Build upper and lower foreground boolean masks that XOR to M. For each cell pick one of the 4 valid (upper_fg, lower_fg) combos consistent with M[r,c]
    4. Ensure each mask has >=25% and <=80% foreground density; retry step 3 if violated
    5. Assemble input: upper mask (bg/blue), separator row (yellow), lower mask (bg/red)
