+        top, bottom = sorted([b1, b2], key=lambda b: (b[0], b[1]))
+        gap_r0 = top[2] + 1
+        gap_r1 = bottom[0] - 1
+        col0 = max(top[1], bottom[1])
+        col1 = min(top[3], bottom[3])
+        if gap_r0 <= gap_r1 and col0 <= col1:
