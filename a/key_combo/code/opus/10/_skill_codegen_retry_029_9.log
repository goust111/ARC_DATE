+def _green_rectangles(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    comps = _components_of_color(grid, GREEN)
+    assert len(comps) == 2, "expected exactly two green components"
+    boxes = []
+    for comp in comps:
