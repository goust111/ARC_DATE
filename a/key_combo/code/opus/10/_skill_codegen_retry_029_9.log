+    bridge = [(r, c) for r in range(r0, r0 + rect_h) for c in range(c1, c2)]
+    seed_side = random.choice(["left", "right"])
+    seed_r = random.randint(r0, r0 + rect_h - 1)
+    seed_c = c0 - 1 if seed_side == "left" else c2 + rect_w2
+    grid[seed_r, seed_c] = BLUE
+
