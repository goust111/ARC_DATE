+    return boxes
+
+
+def _bridge_info(grid: np.ndarray) -> tuple[str, list[tuple[int, int]], tuple[int, int, int, int], tuple[int, int, int, int]]:
+    b1, b2 = _green_rectangles(grid)
+
+    horizontal = None
+    bridge: list[tuple[int, int]] = []
+
