+    6: [
+        ("closed", np.array([[1, 1, 1], [1, 1, 1]], dtype=bool)),
+        ("open", np.array([[1, 1, 1], [0, 1, 0], [1, 1, 0]], dtype=bool)),
+        ("open", np.array([[1, 0, 0], [1, 1, 1], [0, 1, 1]], dtype=bool)),
