+
+    rendered = {}
+    for order in itertools.permutations(FRAME_COLORS):
+        rendered[order] = _render(inp.shape, visible_frames, stretched_full, order)
+    hashes = {grid.tobytes() for grid in rendered.values()}
+    if len(hashes) != 6:
+        return False
+    if not np.array_equal(rendered[intended_order], out):
+        return False
+    if np.array_equal(rendered[intended_order], rendered[frame_order]):
+        return False
+
+    border_union = visible_frames != BG
+    for color in FRAME_COLORS:
+        if not np.any((out == color) & ~border_union):
+            return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    shape = (random.randint(GRID_MIN, GRID_MAX), random.randint(GRID_MIN, GRID_MAX))
