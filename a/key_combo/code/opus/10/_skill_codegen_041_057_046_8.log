+        local = _stretch_sprite(sprite_specs[color]["mask"], (ir1 - ir0 + 1, ic1 - ic0 + 1))
+        full = np.zeros(shape, dtype=bool)
+        full[ir0 : ir1 + 1, ic0 : ic1 + 1] = local
+        full_masks[color] = full
+    return full_masks
