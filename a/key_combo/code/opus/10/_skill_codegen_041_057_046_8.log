+        sr0, sc0, sr1, sc1 = _bbox_coords(sprite_part)
+        sprite_mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+        sprite_mask[sprite_part[:, 0] - sr0, sprite_part[:, 1] - sc0] = True
