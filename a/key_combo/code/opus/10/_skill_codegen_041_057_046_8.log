+    _kind, mask = random.choice(options)
+    out = mask.copy()
+    out = np.rot90(out, random.randrange(4))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    return _crop_to_mask(out)
