+    bg = _get_bg(g)
+    assert bg == BG
+
+    frame_specs: dict[int, dict] = {}
+    sprite_specs: dict[int, dict] = {}
+    for color in _colors_present(g, exclude={bg}):
+        comps = _component_coords(g == color)
+        assert len(comps) == 2, "each color should form one frame and one sprite"
+
+        frame_part = None
+        sprite_part = None
+        for coords in comps:
+            frame_bbox = _rect_frame_bbox_from_coords(coords)
+            if frame_bbox is not None:
+                assert frame_part is None, "frame must be unique per color"
+                frame_part = (coords, frame_bbox)
+            else:
+                assert sprite_part is None, "sprite must be unique per color"
+                sprite_part = coords
+
+        assert frame_part is not None and sprite_part is not None
+        frame_coords, frame_bbox = frame_part
+        sr0, sc0, sr1, sc1 = _bbox_coords(sprite_part)
+        sprite_mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+        sprite_mask[sprite_part[:, 0] - sr0, sprite_part[:, 1] - sc0] = True
+
+        fr0, fc0, fr1, fc1 = frame_bbox
+        ir0, ic0, ir1, ic1 = fr0 + 1, fc0 + 1, fr1 - 1, fc1 - 1
+        assert ir0 <= ir1 and ic0 <= ic1
+
+        frame_specs[color] = {
+            "bbox": frame_bbox,
+            "interior_bbox": (ir0, ic0, ir1, ic1),
+            "coords": frame_coords,
+        }
+        sprite_specs[color] = {
+            "bbox": (sr0, sc0, sr1, sc1),
+            "mask": sprite_mask,
+            "area": int(len(sprite_part)),
+            "coords": sprite_part,
+        }
