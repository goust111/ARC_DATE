+    specs: dict[int, dict] = {}
+    for color, area in zip(colors, areas):
+        require_closed = True if color == closed_color else None
+        if require_closed and area not in (4, 6):
+            require_closed = None
+        mask = _random_pattern(area, require_closed=require_closed)
