+            top_min = max(1, anchor_r - ih + 1)
+            top_max = min(anchor_r, h - ih - 1)
+            left_min = max(1, anchor_c - iw + 1)
+            left_max = min(anchor_c, w - iw - 1)
+            if top_min > top_max or left_min > left_max:
+                break
