+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLORS = (5, 8, 9)
+GEN_ATTEMPTS = 500
+GRID_MIN = 16
+GRID_MAX = 20
+INTERIOR_MIN = 4
+INTERIOR_MAX = 7
+SPRITE_AREAS = (3, 4, 5, 6)
+
+PATTERNS: dict[int, list[tuple[str, np.ndarray]]] = {
