+def _candidate_sprite_positions(shape: tuple[int, int], patch_shape: tuple[int, int], corner: str, side: int = 7) -> list[tuple[int, int]]:
+    h, w = shape
+    ph, pw = patch_shape
+    if corner == "tl":
