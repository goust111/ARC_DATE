+def _draw_line(mask: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> None:
+    if r0 == r1:
+        c_start, c_stop = sorted((c0, c1))
+        mask[r0, c_start : c_stop + 1] = True
+        return
+    if c0 == c1:
+        r_start, r_stop = sorted((r0, r1))
+        mask[r_start : r_stop + 1, c0] = True
