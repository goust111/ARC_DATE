+
+def _sample_sprite_specs() -> dict[int, dict]:
+    colors = list(FRAME_COLORS)
+    random.shuffle(colors)
+    areas = random.sample(SPRITE_AREAS, 3)
+    closed_color = random.choice([color for color, area in zip(colors, areas) if area in (4, 6)])
