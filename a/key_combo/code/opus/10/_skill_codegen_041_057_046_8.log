+
+def _build_input(shape: tuple[int, int], frame_specs: dict[int, dict], sprite_specs: dict[int, dict], sprite_positions: dict[int, tuple[int, int]]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    frame_order = list(FRAME_COLORS)
+    random.shuffle(frame_order)
+    for color in frame_order:
+        spec = frame_specs[color]
+        r0, c0, r1, c1 = spec["bbox"]
+        grid[r0, c0 : c1 + 1] = color
+        grid[r1, c0 : c1 + 1] = color
+        grid[r0 : r1 + 1, c0] = color
+        grid[r0 : r1 + 1, c1] = color
