+def _interior_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    out = np.zeros(shape, dtype=bool)
+    out[r0 + 1 : r1, c0 + 1 : c1] = True
+    return out
