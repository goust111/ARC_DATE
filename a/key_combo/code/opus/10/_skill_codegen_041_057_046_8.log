+    for sr, sc in coords:
+        sr = int(sr)
+        sc = int(sc)
+        for nr, nc in ((sr + 1, sc), (sr, sc + 1)):
+            if (nr, nc) in mapped:
+                r0, c0 = mapped[(sr, sc)]
+                r1, c1 = mapped[(nr, nc)]
