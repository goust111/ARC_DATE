+        interior_shape = (ir1 - ir0 + 1, ic1 - ic0 + 1)
+        local = _stretch_sprite(sprite_specs[color]["mask"], interior_shape)
+        full = np.zeros_like(g, dtype=bool)
+        full[ir0 : ir1 + 1, ic0 : ic1 + 1] = local
+        stretched_full[color] = full
