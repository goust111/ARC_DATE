+        sr0, sc0, sr1, sc1 = _bbox_coords(sprite_coords)
+        outside = sr1 < fr0 or sr0 > fr1 or sc1 < fc0 or sc0 > fc1
+        if not outside:
+            continue
+        candidates.append((sprite_coords, frame_coords, frame_bbox))
