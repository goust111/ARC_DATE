+        assert ir0 <= ir1 and ic0 <= ic1
+
+        frame_specs[color] = {
+            "bbox": frame_bbox,
+            "interior_bbox": (ir0, ic0, ir1, ic1),
+            "coords": frame_coords,
+        }
+        sprite_specs[color] = {
+            "bbox": (sr0, sc0, sr1, sc1),
+            "mask": sprite_mask,
+            "area": int(len(sprite_part)),
+            "coords": sprite_part,
