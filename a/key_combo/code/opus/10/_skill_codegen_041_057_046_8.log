+    if not np.array_equal(rendered[intended_order], out):
+        return False
+
+    alt_orders = {
+        tuple(reversed(intended_order)),
+        frame_order,
+        numeric_order,
+        tuple(reversed(numeric_order)),
+    }
+    distinct = {rendered[intended_order].tobytes()}
+    for alt_order in alt_orders:
