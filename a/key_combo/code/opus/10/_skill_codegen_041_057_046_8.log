+def _place_stretched_full(shape: tuple[int, int], frame_specs: dict[int, dict], sprite_specs: dict[int, dict]) -> dict[int, np.ndarray]:
+    full_masks: dict[int, np.ndarray] = {}
+    for color in FRAME_COLORS:
