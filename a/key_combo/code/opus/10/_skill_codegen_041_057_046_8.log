+
+def _scaled_index(i: int, src_len: int, dst_len: int) -> int:
+    if src_len == 1:
+        assert dst_len == 1, "single-pixel source axis requires single-pixel target axis"
+        return 0
+    assert dst_len >= 2
+    return int(round(i * (dst_len - 1) / (src_len - 1)))
