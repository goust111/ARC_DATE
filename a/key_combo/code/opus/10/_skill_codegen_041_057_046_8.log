+        border_union = np.zeros(shape, dtype=bool)
+        for color in colors:
+            top = base_r + offsets[color][0]
+            left = base_c + offsets[color][1]
+            ih, iw = dims[color]
+            outer = (top - 1, left - 1, top + ih, left + iw)
+            if not _bbox_gap_ok(outer, sprite_zone, gap=0):
+                break
+            border = _border_mask(shape, outer)
+            if np.any(border & border_union):
+                break
+            border_union |= border
+            specs[color] = {
