+def _sprite_zone_bbox(shape: tuple[int, int], corner: str, side: int = 7) -> tuple[int, int, int, int]:
+    h, w = shape
+    if corner == "tl":
+        return 0, 0, side - 1, side - 1
+    if corner == "tr":
+        return 0, w - side, side - 1, w - 1
+    if corner == "bl":
+        return h - side, 0, h - 1, side - 1
+    return h - side, w - side, h - 1, w - 1
