+        cols = range(0, side - pw + 1)
+    elif corner == "tr":
+        rows = range(0, side - ph + 1)
+        cols = range(w - side, w - pw + 1)
+    elif corner == "bl":
+        rows = range(h - side, h - ph + 1)
+        cols = range(0, side - pw + 1)
+    else:
