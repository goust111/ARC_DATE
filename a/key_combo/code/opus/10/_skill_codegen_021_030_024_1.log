+    min_c = min(c for _, c in coords)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in coords))
+
+
+def _build_pattern_bank() -> tuple[tuple[tuple[int, int], ...], ...]:
+    cells = [(r, c) for r in range(3) for c in range(3)]
+    patterns = set()
+    for size in range(3, 6):
