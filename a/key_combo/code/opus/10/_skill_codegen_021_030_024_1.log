+
+
+def _sample_sprite_layout() -> tuple[int, tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]]:
+    while True:
+        cell_size = random.choice(CELL_SIZE_OPTIONS)
+        pattern = random.choice(PATTERN_BANK)
