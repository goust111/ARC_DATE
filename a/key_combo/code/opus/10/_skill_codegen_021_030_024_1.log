+
+def _frame_placements(cell_size: int, pattern: tuple[tuple[int, int], ...]) -> list[tuple[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]]]:
+    rows = [r for r, _ in pattern]
+    cols = [c for _, c in pattern]
