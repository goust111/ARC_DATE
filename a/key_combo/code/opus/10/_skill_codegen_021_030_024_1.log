+def _cell_manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
+
+def _sample_occupied_layout() -> tuple[list[tuple[int, int]], tuple[int, int]]:
