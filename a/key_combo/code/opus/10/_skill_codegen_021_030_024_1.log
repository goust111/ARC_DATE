+import itertools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+CELL_COUNT = 4
+CELL_SIZE_OPTIONS = (5, 6)
+MAX_GENERATION_ATTEMPTS = 400
