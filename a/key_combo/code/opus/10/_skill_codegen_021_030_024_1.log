+        return None
+
+    r0, c0 = red_coords.min(axis=0)
+    r1, c1 = red_coords.max(axis=0)
+    if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+        return None
+
+    expected = set()
+    for r in range(int(r0), int(r1) + 1):
