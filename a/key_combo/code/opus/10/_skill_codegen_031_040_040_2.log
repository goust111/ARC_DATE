+        h = bbox_h(box)
+        w = bbox_w(box)
+        rr0, cc0, rr1, cc1 = box
+        if comp["area"] != h * w:
+            return False
+        if not np.all(inp[rr0 : rr1 + 1, cc0 : cc1 + 1] == GREY):
+            return False
+        if (h, w) == (3, 3):
