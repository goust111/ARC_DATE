+
+    if not np.array_equal(pred, out):
+        return False
+
+    r0, c0, r1, c1 = target
+    if not np.array_equal(out[r0 : r1 + 1, c0 : c1 + 1], template):
+        return False
+
+    grey_rects = find_components(inp, color=GREY, connectivity=4)
+    near_match_seen = False
+    target_count = 0
+    for comp in grey_rects:
