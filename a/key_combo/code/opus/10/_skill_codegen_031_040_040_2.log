+def _compressed_template(
+    grid: np.ndarray,
+    box: tuple[int, int, int, int],
+    row_bands: list[tuple[int, int]],
+    col_bands: list[tuple[int, int]],
+) -> np.ndarray:
+    r_box, c_box = box[0], box[1]
+    template = np.zeros((3, 3), dtype=int)
+    for rr, (r0, r1) in enumerate(row_bands):
