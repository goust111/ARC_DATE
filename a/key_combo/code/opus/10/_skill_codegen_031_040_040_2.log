+    existing: list[tuple[int, int, int, int]] = []
+    max_rect_w = max(w for _, w in rect_sizes)
+    lattice_c_max = width - lattice.shape[1] - max_rect_w - 5
+    if lattice_c_max < 1:
+        return None
+
+    lattice_box = _place_box(
+        lattice.shape[0],
+        lattice.shape[1],
