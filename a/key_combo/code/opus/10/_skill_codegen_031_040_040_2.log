+    block_h = (lattice.shape[0] - 4) // 3
+    block_w = (lattice.shape[1] - 4) // 3
+    template = np.zeros((3, 3), dtype=int)
+    for r in range(3):
+        for c in range(3):
+            r0 = 1 + r * (block_h + 1)
+            c0 = 1 + c * (block_w + 1)
+            template[r, c] = _unique_majority(lattice[r0 : r0 + block_h, c0 : c0 + block_w])
+    return template
