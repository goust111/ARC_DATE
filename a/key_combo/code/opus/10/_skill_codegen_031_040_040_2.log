+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+MAJORITY_COLORS = (BLUE, RED, GREEN, YELLOW, PINK)
+DISTRACTOR_SIZES = (
+    (3, 2),
+    (2, 3),
+    (3, 4),
+    (4, 3),
+    (2, 2),
+    (4, 4),
+    (2, 5),
