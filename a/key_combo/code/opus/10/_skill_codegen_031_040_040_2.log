+    for idx, (rh, rw) in enumerate(rect_sizes):
+        right_start = lc1 + 3
+        if right_start > width - rw - 1:
+            return None
+        box = _place_box(
+            rh,
+            rw,
+            existing,
+            (1, height - rh - 1),
+            (right_start, width - rw - 1),
+            rng=rng,
+        )
+        if box is None:
+            return None
+        existing.append(box)
+        placements.append((idx, box))
