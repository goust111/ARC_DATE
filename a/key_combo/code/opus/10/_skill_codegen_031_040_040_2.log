+        return None
+    return rng.choice(candidates)
+
+
+def _make_template(rng: random.Random) -> np.ndarray:
+    while True:
+        template = np.array(
+            [rng.choice(MAJORITY_COLORS) for _ in range(9)],
+            dtype=int,
