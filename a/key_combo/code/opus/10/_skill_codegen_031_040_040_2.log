+        return None
+    return rng.choice(candidates)
+
+
+def _make_template(rng: random.Random) -> np.ndarray:
+    while True:
+        template = np.array(
+            [rng.choice(MAJORITY_COLORS) for _ in range(9)],
+            dtype=int,
+        ).reshape(3, 3)
+        distinct = len(set(map(int, template.reshape(-1))))
+        if distinct < 3:
+            continue
