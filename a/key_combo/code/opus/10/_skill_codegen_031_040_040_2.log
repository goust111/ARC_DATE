+    grey_rectangles = find_components(grid, color=GREY, connectivity=4)
+    assert len(grey_rectangles) >= 2, "expected multiple grey rectangles"
+    for comp in grey_rectangles:
+        box = comp["bbox"]
+        r0, c0, r1, c1 = box
+        h = bbox_h(box)
+        w = bbox_w(box)
