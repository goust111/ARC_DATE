+
+        row_bands = [(row_lines[i] + 1, row_lines[i + 1] - 1) for i in range(3)]
+        col_bands = [(col_lines[i] + 1, col_lines[i + 1] - 1) for i in range(3)]
+        candidates.append((box, row_bands, col_bands))
