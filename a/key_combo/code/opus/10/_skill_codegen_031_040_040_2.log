+PROBE_NAMES = ("top_left", "center", "bottom_right")
+PROBE_INDEX = {
+    "top_left": lambda h, w: (0, 0),
+    "center": lambda h, w: (h // 2, w // 2),
+    "bottom_right": lambda h, w: (h - 1, w - 1),
