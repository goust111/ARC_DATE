+
+
+def _render_case(
+    height: int,
+    width: int,
+    lattice: np.ndarray,
+    rect_sizes: list[tuple[int, int]],
+    *,
+    rng: random.Random,
+) -> tuple[np.ndarray, np.ndarray] | None:
