+    h = 3 * block_h + 4
+    w = 3 * block_w + 4
+    lattice = np.full((h, w), ORANGE, dtype=int)
+    probe_hits: set[str] = set()
+    probe_cells = {
+        "top_left": (0, 0),
+        "center": (1, 1),
+        "bottom_right": (2, 2),
+    }
+    for tr in range(3):
+        for tc in range(3):
+            r0 = 1 + tr * (block_h + 1)
+            c0 = 1 + tc * (block_w + 1)
+            forced_noise = None
