+
+
+def _make_rectangles(rng: random.Random) -> list[tuple[int, int]]:
+    total = rng.randint(2, 4)
+    distractor_count = total - 1
+    sizes = [rng.choice(((3, 2), (2, 3), (3, 4), (4, 3)))]
+    pool = [size for size in DISTRACTOR_SIZES if size != sizes[0]]
+    rng.shuffle(pool)
