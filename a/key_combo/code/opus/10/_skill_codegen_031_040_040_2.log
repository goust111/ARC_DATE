+        return None
+    existing.append(lattice_box)
+    lr0, lc0, lr1, lc1 = lattice_box
+    grid[lr0 : lr1 + 1, lc0 : lc1 + 1] = lattice
+
+    placements = []
+    for idx, (rh, rw) in enumerate(rect_sizes):
+        right_start = lc1 + 3
+        if right_start > width - rw - 1:
+            return None
+        box = _place_box(
+            rh,
+            rw,
+            existing,
+            (1, height - rh - 1),
+            (right_start, width - rw - 1),
+            rng=rng,
+        )
+        if box is None:
+            return None
+        existing.append(box)
+        placements.append((idx, box))
