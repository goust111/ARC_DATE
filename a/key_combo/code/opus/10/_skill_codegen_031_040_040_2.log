+    lattice_box, row_bands, col_bands = _extract_lattice(g)
+    template = _compressed_template(g, lattice_box, row_bands, col_bands)
+    target = _find_target_rect(g)
+
+    out = g.copy()
+    r0, c0, r1, c1 = target
+    out[r0 : r1 + 1, c0 : c1 + 1] = template
+    return out
