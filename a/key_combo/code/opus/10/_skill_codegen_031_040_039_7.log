    return feasible_dims


def _gen_oriented_patch(patch):
    variants = []
    for k in range(GEN_ROTATION_COUNT):
        candidate = np.rot90(patch, k)
        h, w = candidate.shape
        if (
            GEN_PATCH_HEIGHT_RANGE[0] <= h <= GEN_PATCH_HEIGHT_RANGE[1]
