+def _pinwheel(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    top = np.hstack((g, np.rot90(g, 1)))
+    bottom = np.hstack((np.rot90(g, -1), np.rot90(g, 2)))
+    return np.vstack((top, bottom))
