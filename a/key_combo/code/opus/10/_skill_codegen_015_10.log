{
  "type": "symmetry/pattern",
  "src": "grid with black mask pixels over a pattern symmetric by row reflection after a two-row prefix and by column reflection after a two-column prefix",
  "transform": "replace each black mask pixel with the unique nonblack color in its horizontal/vertical reflection orbit; preserve all visible pixels"
}
</annotation>
<generation_spec>
