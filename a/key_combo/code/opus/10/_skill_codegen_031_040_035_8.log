+        rr = random.randint(0, tile_h - 1)
+        cc = random.randint(0, tile_w - 1)
+        if (rr, cc) not in {(0, 0), (tile_h - 1, tile_w - 1)}:
+            seed[rr, cc] = BG
+    return seed
