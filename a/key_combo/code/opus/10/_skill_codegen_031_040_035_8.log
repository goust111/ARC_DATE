+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+SEPARATOR = 5
+START = 3
+BLOCKER = 8
+SEED_PALETTE = (1, 2, 4, 6, 7, 9)
+
+TURN_MIN = 2
+TURN_MAX = 5
+MAX_SEG_LEN = 5
+GEN_ATTEMPTS = 400
