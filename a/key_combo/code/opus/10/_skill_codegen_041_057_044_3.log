+
+def black_pockets_for_shape(shape: dict, side: str, portal: tuple[int, int]) -> set[tuple[int, int]]:
+    mirrored = set(mirror_local(shape["coords"], shape["h"], shape["w"], side))
+    target_only = list(mirrored - set(shape["coords"]))
