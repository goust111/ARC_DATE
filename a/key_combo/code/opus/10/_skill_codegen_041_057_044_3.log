  "type": "symmetry/pattern",
  "src": "multi-pixel foreground object s plus singleton marker pixels, each sharing exactly one row or column with one pixel of s",
  "dst": "reflected footprint of s through the axis midway between each marker and its aligned source pixel",
  "transform": "for row-aligned markers, horizontally reflect s and recolor it to the marker color; for column-aligned markers, vertically reflect s and recolor it to the marker color; preserve original pixels"
}
</annotation>
