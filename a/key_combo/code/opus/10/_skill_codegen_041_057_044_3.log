+
+def bbox_cells(top: int, left: int, h: int, w: int) -> set[tuple[int, int]]:
+    return {(r, c) for r in range(top, top + h) for c in range(left, left + w)}
+
+
+def moat_cells(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
