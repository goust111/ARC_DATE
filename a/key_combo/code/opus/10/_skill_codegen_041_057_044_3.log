+from __future__ import annotations
+
+from collections import deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+SEED = 2
+SPRITE = 5
+WALL = 8
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_STEP = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
