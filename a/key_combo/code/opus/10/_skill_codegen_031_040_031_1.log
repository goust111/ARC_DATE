+    if np.array_equal(mask, np.flipud(mask)):
+        kinds.add("horizontal")
+    if mask.shape[0] == mask.shape[1]:
+        if np.array_equal(mask, mask.T):
+            kinds.add("diagonal")
+        if np.array_equal(mask, _reflect_anti_diag(mask)):
+            kinds.add("anti_diagonal")
+    return kinds
+
