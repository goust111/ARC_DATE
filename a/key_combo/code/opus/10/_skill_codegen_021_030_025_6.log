+    solid_map = {idx: color for idx, color in solid_rows}
+    runs = []
+    r = 0
+    while r < grid.shape[0]:
+        if r not in solid_map:
+            r += 1
+            continue
+        color = solid_map[r]
+        r1 = r
+        while r1 + 1 < grid.shape[0] and solid_map.get(r1 + 1) == color:
+            r1 += 1
