+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+SEP = 5
+RESERVED_BLUE = 1
+PALETTE = (2, 3, 4, 6, 7, 8, 9)
+MAX_RETRIES = 400
