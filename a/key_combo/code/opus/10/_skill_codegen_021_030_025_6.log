+import numpy as np
+
+
+BG = 0
+SEP = 5
+RESERVED_BLUE = 1
+PALETTE = (2, 3, 4, 6, 7, 8, 9)
+MAX_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.reshape(-1))).most_common(1)[0][0])
