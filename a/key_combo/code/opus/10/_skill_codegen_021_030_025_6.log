+        [(0, tile_w - 2), (1, max(1, tile_w - 3))],
+        [(tile_h - 1, 1), (tile_h - 2, min(tile_w - 2, 2))],
+        [(tile_h - 1, tile_w - 2), (tile_h - 2, max(1, tile_w - 3))],
