+def _consensus_and_damage(blocks: np.ndarray, bg: int) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    block_rows, block_cols, tile_h, tile_w = blocks.shape
+    motif = np.empty((tile_h, tile_w), dtype=int)
