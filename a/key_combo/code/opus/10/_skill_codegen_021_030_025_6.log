+            border = np.zeros(sub.shape, dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if np.all(sub[border] == color) and np.any(sub[1:-1, 1:-1] != color):
