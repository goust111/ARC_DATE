            for _ in range(FRAME_LINK_ATTEMPTS):
                base = random.choice(frames)
                side = random.choice(FRAME_SIDES)
                new = _gen_shared_neighbor(base, side, random.choice(FRAME_SIZES))
                if new not in frames:
                    frames.append(new)
