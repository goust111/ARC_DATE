    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
    assert h == 1 or w == 1, "expected each gray source to be a one-cell-thick bar"

    if h == 1 and w > 1:
        return "horizontal"
    if w == 1 and h > 1:
        return "vertical"

    implied: set[str] = set()
