+        r0_b = r0_a + rect_a["h"] + gap
+        c0_b = c0_a + rect_a["w"] + gap
+
+        placed = [
+            {
+                "id": 0,
+                "color": rect_a["color"],
+                "r0": r0_a,
+                "c0": c0_a,
+                "h": rect_a["h"],
+                "w": rect_a["w"],
+                "area": rect_a["area"],
