+
+        candidate_b = {
+            "id": 1,
+            "color": rect_b["color"],
+            "r0": r0_b,
+            "c0": c0_b,
+            "h": rect_b["h"],
+            "w": rect_b["w"],
+            "area": rect_b["area"],
+        }
+        if not _candidate_ok(candidate_b, placed, height):
+            continue
+        placed.append(candidate_b)
