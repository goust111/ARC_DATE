+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+RAY_SPECS = (
+    ("nw", 0, 0, -1, -1),
+    ("ne", 0, -1, -1, 1),
+    ("sw", -1, 0, 1, -1),
+    ("se", -1, -1, 1, 1),
+)
+
+GEN_ATTEMPTS = 600
+GRID_RANGE = (18, 24)
+RECT_COUNT_WEIGHTS = ((2, 3), (3, 4), (4, 3))
+MODE_WEIGHTS = (("collision", 5), ("open", 3), ("mixed", 2))
+
