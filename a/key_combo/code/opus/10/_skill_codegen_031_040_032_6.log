+def _semantic_validation(inp: np.ndarray, moved_rects: list[dict], mode: str) -> bool:
+    expected, infos = _render_output_from_moved(inp.shape, moved_rects)
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
