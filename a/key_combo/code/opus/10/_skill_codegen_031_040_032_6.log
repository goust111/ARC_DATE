+def _build_mixed_scene(shape: tuple[int, int], specs: list[dict]) -> list[dict] | None:
+    if len(specs) < 3:
+        return _build_collision_scene(shape, specs)
+    placed = _build_collision_scene(shape, specs[:2] + specs[2:])
+    if placed is None:
