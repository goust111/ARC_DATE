+    metrics = _ray_metrics(infos)
+    filled_ratio = int(np.count_nonzero(actual)) / actual.size
+    if metrics["total_ray_cells"] < 12 or metrics["active_rects"] < 2 or filled_ratio > 0.35:
+        return False
