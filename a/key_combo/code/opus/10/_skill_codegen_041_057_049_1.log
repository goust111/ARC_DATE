+        assert not np.any(grid[coords[:, 0], coords[:, 1]] != BG)
+        grid[coords[:, 0], coords[:, 1]] = GREY
+    return grid
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    fragments: list[np.ndarray],
+    final_fragments: list[np.ndarray],
