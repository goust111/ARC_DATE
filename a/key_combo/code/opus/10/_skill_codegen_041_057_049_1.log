+
+    if np.any(out == GREY):
+        return False
+    if np.any(np.isin(out[:, 1:], [color for _r, _c, color in markers]) & (out[:, 1:] == BG)):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
