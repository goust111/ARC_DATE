+            return trial
+
+    if require_change:
+        return None
+    return fallback
+
+
+def _build_input_grid(
+    shape: tuple[int, int],
+    fragments: list[np.ndarray],
+    markers: list[tuple[int, int, int]],
+) -> np.ndarray:
