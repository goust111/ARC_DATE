+    blocked = np.zeros((h, w), dtype=bool)
+    blocked[:, 0] = True
+    for coords in fragments:
+        _mark_blocked(blocked, coords)
+    for coords in final_fragments:
+        blocked[coords[:, 0], coords[:, 1]] = True
+    cells = []
+    for r in range(h):
