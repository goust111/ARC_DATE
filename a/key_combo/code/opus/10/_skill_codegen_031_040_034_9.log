  22: def main(grid: np.ndarray) -> np.ndarray:
  23:     """
  24:     Stamp recolored copies of the foreground template in the order given by the marker pixels.
  25: 
  26:     Input structure
  27:     - A dominant background contains one multi-pixel foreground template color.
  28:     - Every other foreground color is a single marker pixel.
  29:     - The marker pixels lie on one common row or one common column.
  30: 
  31:     Rule
  32:     - Crop the template color to its bounding box and use it as a mask.
  33:     - Sort markers left-to-right when they share a row, or top-to-bottom when they share a column.
  34:     - For each sorted marker, make one copy of the template mask recolored to that marker color.
  35:     - Concatenate the copies horizontally for a marker row, or vertically for a marker column.
  36: 
  37:     Key insight
  38:     - The single pixels are an ordered palette; the larger foreground shape is a reusable stencil.
  39:     """
  40:     g = np.asarray(grid, dtype=int)
  41:     assert g.ndim == 2, "expected a 2D grid"
  42: 
  43:     bg = get_bg(g)
  44:     counts = Counter(map(int, g.ravel()))
  45:     foreground = [color for color in counts if color != bg]
  46:     template_colors = [color for color in foreground if counts[color] > 1]
  47:     assert len(template_colors) == 1, "expected exactly one multi-pixel template color"
  48:     template_color = int(template_colors[0])
