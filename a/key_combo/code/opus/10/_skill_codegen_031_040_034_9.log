+    top[0, :] = True
+    bottom = np.zeros((4, 4), dtype=bool)
+    bottom[3, :] = True
+    left = np.zeros((4, 4), dtype=bool)
+    left[:, 0] = True
+    right = np.zeros((4, 4), dtype=bool)
+    right[:, 3] = True
+
+    masks.extend(
+        [
+            top | left | right,
+            bottom | left | right,
