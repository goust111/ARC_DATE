spec:
  type: symmetry/pattern
  grid: 12-19 rows x 12-19 cols
  tile:
    size: 2x2 or 3x3 [observed, solver supports any NxM]
    colors: exactly 2 non-pink colors, both present in tile
    structure: not row-only or col-only stripes (minimum-area period must be unique)
    minority_color_fraction: 1/9 to 4/9 of tile cells
  output: grid filled by tiling the tile periodically (grid need not be exact multiple of tile)
  corruption:
    marker_color: 6 (pink), always absent from tile colors
    pixel_fraction: 15-25% of grid cells replaced with pink
    distribution: approximately uniform random scatter across grid (not clustered rectangles)
    both_tile_positions_affected: corruption hits cells of both tile colors
  transform: replace each pink pixel with the tile color at (row % tile_h, col % tile_c)

generation_strategy:
  approach: output-first
  steps:
    1. Pick 2 distinct colors c1, c2 from 0-9 excluding 6.
    2. Pick tile dimensions (2x2 or 3x3). Fill tile with c1/c2 ensuring both used, not a pure row/col stripe, and minimum-area period is unique.
    3. Pick grid dims H in [12,19], W in [12,19].
    4. Tile the grid periodically to get the output.
    5. Randomly select 15-25% of pixels and replace with 6 (pink) to get the input.
    6. Verify the corrupted grid still uniquely determines the tile (run solver as oracle).

--- END ---
