+        return None
+    if np.count_nonzero(input_grid == BLUE) not in (4, 5, 6):
+        return None
+    if np.any(np.argwhere(input_grid == BLUE)[:, 0] > (height - 1) // 2):
+        return None
+    if _count_blue_motion(input_grid, settled) <= 0:
