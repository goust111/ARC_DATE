+def _settle_blue(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+    out[out == BLUE] = BG
+
+    for c in range(w):
+        r = 0
+        while r < h:
+            while r < h and int(out[r, c]) != BG:
+                r += 1
+            start = r
+            while r < h and int(out[r, c]) == BG:
+                r += 1
+            end = r - 1
+            if start <= end:
+                count = int(np.count_nonzero(g[start : end + 1, c] == BLUE))
+                if count:
+                    out[end - count + 1 : end + 1, c] = BLUE
+    return out
