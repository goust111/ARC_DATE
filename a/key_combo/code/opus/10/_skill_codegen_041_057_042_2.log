+def _place_segment_obstacle(grid: np.ndarray, row: int) -> bool:
+    h, w = grid.shape
+    for _ in range(50):
+        length = 1 if random.random() < 0.45 else random.randint(2, min(3, w))
+        left = random.randint(0, w - length)
+        if np.all(grid[row, left : left + length] == BG):
