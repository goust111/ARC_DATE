0038:         connectivity=4,
0039:         monochromatic=True,
0040:         return_format="objects",
0041:     )
0042: 
0043:     # sort the regions from left to right using the coordinates of their bounding boxes
0044:     black_regions = sorted(black_regions, key=lambda region: bbox(region != bg)[1])
0045: 
0046:     # color every third black region yellow using flood fill
