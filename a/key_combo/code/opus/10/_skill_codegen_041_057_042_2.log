+def _consistent_tile(grid: np.ndarray, row_period: int, col_period: int) -> np.ndarray | None:
+    tile = np.full((row_period, col_period), -1, dtype=int)
+    for r, c in np.argwhere((grid == RED) | (grid == GREEN)):
+        rr = int(r) % row_period
+        cc = int(c) % col_period
+        value = int(grid[r, c])
+        if tile[rr, cc] == -1:
+            tile[rr, cc] = value
+        elif tile[rr, cc] != value:
+            return None
+    if np.any(tile == -1):
+        return None
+    return tile
