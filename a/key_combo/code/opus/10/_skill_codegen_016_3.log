            budget -= 1
    return widths


def _plan_totals(plan_pairs: list[tuple[int, int]]) -> tuple[int, int]:
    majority_total = sum(pair[0] for pair in plan_pairs)
    minority_total = sum(pair[1] for pair in plan_pairs)
    return majority_total, minority_total


