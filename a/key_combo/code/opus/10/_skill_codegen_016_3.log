+                candidates.append(coords)
+        random.shuffle(candidates)
+        if not candidates:
+            return False
+        chosen = candidates[0]
+        for r, c in chosen:
+            occupied.add((r, c))
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < h and left <= cc <= right:
