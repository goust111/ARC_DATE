+        if len(occupied_cols) < 2:
+            continue
+        stack_heights = [int(np.count_nonzero(grid[:, c] == RED)) for c in occupied_cols]
+        if len(set(stack_heights)) == 1:
+            continue
+
+        return grid
+
+    raise RuntimeError("failed to generate a valid ARC input for puzzle 5")

