+        assert 0 <= rr < grid.shape[0], "reflected pixel must stay in bounds"
+        reflected.append((int(rr), int(c), GREEN))
+
+    items = [(int(r), int(c), RED) for r, c in red_coords]
+    items.extend(reflected)
