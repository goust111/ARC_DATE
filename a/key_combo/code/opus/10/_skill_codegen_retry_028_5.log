    while int(mask.sum()) < target_count:
        frontier: set[tuple[int, int]] = set()
        for d, c in np.argwhere(mask):
            d = int(d)
            c = int(c)
            for nd, nc in ((d - 1, c), (d + 1, c), (d, c - 1), (d, c + 1)):
