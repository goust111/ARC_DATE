+        k += 1
+    return cells, indices, body_shape
+
+
+def _expanded(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    gh, gw = shape
+    out = set()
+    for r, c in cells:
