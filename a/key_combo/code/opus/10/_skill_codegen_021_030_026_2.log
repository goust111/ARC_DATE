+def _bbox_of_pixels(pixels: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in pixels]
+    cols = [c for _, c in pixels]
+    return min(rows), min(cols), max(rows), max(cols)
