+    start = next(iter(pixels))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in pixels and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
