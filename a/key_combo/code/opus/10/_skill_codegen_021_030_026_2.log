+        mr, mc = item["marker"]
+        grid[mr, mc] = int(item["marker_color"])
+    return grid
+
+
+def _mutate_spec(obj: dict, **updates) -> dict:
+    mutated = dict(obj)
+    mutated.update(updates)
+    return mutated
