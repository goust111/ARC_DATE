+    spans: list[tuple[int, int]] = []
+    sizes: list[int] = []
+    cursor = 0
+    for start, end in raw_intervals:
+        size = end - start
+        sizes.append(size)
+        spans.append((cursor, cursor + size))
+        cursor += size
+    return spans, sizes
+
+
+def _axis_block_index(coord: float, spans: list[tuple[int, int]]) -> int:
