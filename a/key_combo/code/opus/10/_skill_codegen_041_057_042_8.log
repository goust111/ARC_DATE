+            ordered = sorted(comp, key=lambda p: p[1])
+            axis_mid = (ordered[0][1] + ordered[-1][1]) / 2.0
+            mid_r = float(rows[0])
+            mid_c = axis_mid
+        else:
+            orientation = "v"
+            ordered = sorted(comp, key=lambda p: p[0])
+            axis_mid = (ordered[0][0] + ordered[-1][0]) / 2.0
+            mid_r = axis_mid
+            mid_c = float(cols[0])
