+def _fold_targets(rod: dict) -> list[tuple[int, int]]:
+    hinge_r, hinge_c = rod["hinge"]
+    h, w = rod["compressed_shape"]
+    tail_len = len(rod["moving"])
+    if rod["orientation"] == "h":
