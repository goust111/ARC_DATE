+
+def _build_axis_map(sizes: tuple[int, int, int, int]) -> tuple[list[int], list[int]]:
+    comp_to_raw: list[int] = []
+    separators: list[int] = []
+    raw = 0
+    comp = 0
+    for idx, size in enumerate(sizes):
+        for _ in range(size):
+            comp_to_raw.append(raw)
+            raw += 1
+            comp += 1
+        if idx != len(sizes) - 1:
+            separators.append(raw)
+            raw += 1
