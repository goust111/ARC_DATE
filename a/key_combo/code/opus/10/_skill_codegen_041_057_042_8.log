+    else:
+        lo = int(np.floor(r))
+        hi = int(np.ceil(r))
+        rr = (row_map[lo] + row_map[hi]) / 2.0
+    if abs(c - round(c)) < 1e-9:
+        cc = col_map[int(round(c))]
+    else:
+        lo = int(np.floor(c))
+        hi = int(np.ceil(c))
+        cc = (col_map[lo] + col_map[hi]) / 2.0
+    return float(rr), float(cc)
+
+
+def _place_rods():
