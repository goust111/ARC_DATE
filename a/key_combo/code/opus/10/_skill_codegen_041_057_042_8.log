+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+HINGE = 2
+ROD = 3
+ANCHOR = 7
+
+MAX_GENERATION_ATTEMPTS = 500
+LOCAL_PLACEMENT_ATTEMPTS = 250
+SIDE_PAIRS_BY_LENGTH = {
+    4: ((1, 2), (2, 1)),
+    5: ((1, 3), (3, 1)),
+    6: ((1, 4), (4, 1), (2, 3), (3, 2)),
