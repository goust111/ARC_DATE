+
+def _separator_intervals(lines: list[int], length: int) -> list[tuple[int, int]]:
+    bounds = [-1, *sorted(lines), length]
+    return [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
