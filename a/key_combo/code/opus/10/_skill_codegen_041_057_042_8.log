+    cursor = 0
+    for size in sizes:
+        spans.append((cursor, cursor + size))
+        cursor += size
+    return spans
+
+
+def _expand_4(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    out = set(cells)
+    for r, c in list(cells):
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
