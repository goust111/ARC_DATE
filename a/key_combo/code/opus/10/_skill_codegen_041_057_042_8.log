+        if len(left_side) > len(right_side):
+            moving = left_side
+            fixed = [hinge, *right_side]
+        else:
+            moving = right_side
+            fixed = [*left_side, hinge]
+
+        rods.append(
+            {
+                "orientation": orientation,
+                "ordered": ordered,
+                "hinge": hinge,
+                "moving": moving,
+                "fixed": fixed,
+                "selected": selected,
+                "dh": dh,
+                "dv": dv,
+                "anchor_center": (anchor_r, anchor_c),
+                "compressed_shape": compressed.shape,
+                "keep_rows": keep_rows,
+                "keep_cols": keep_cols,
+            }
