+    "top": "ur",
+    "bottom": "ll",
+    "left": "ul",
+    "right": "lr",
+}
+
+ADJACENT_PAIR_TO_CORNER = {
+    frozenset({"top", "left"}): "ul",
+    frozenset({"top", "right"}): "ur",
+    frozenset({"bottom", "left"}): "ll",
+    frozenset({"bottom", "right"}): "lr",
