+
+def _mode(values: list[int], *, prefer: str = "min") -> int:
+    counts = Counter(values)
+    best = max(counts.values())
+    candidates = [v for v, cnt in counts.items() if cnt == best]
+    return min(candidates) if prefer == "min" else max(candidates)
