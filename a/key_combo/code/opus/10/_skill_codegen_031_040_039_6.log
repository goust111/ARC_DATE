+        elif side == "bottom":
+            if kind == "tab":
+                grid[bottom + 1, pos] = BLUE
+            else:
+                grid[bottom, pos] = BG
+        elif side == "left":
+            if kind == "tab":
+                grid[pos, left - 1] = BLUE
+            else:
+                grid[pos, left] = BG
+        else:
+            if kind == "tab":
+                grid[pos, right + 1] = BLUE
+            else:
+                grid[pos, right] = BG
+
+
+def _clear_for_blob(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
