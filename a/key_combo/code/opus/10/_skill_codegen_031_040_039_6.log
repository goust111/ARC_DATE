+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbor_count(mask: np.ndarray, r: int, c: int) -> int:
+    total = 0
+    for dr, dc in DIRS4:
+        rr, cc = r + dr, c + dc
+        if _in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):
