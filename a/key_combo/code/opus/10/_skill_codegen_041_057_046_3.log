+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
