0017: def main(input_grid):
0018:     """
0019:     Collapse a separator grid into one color per region, then mirror the compact grid left-to-right.
0020: 
0021:     Input structure:
0022:     - The input is divided into uniformly colored cells by horizontal and vertical separator bars.
0023:     - Each region between separators has a single color.
0024:     - The separator color forms a connected partition spanning the full canvas.
0025: 
0026:     Rule:
0027:     - Identify the separator color and extract all separator-delimited regions.
0028:     - Replace each region with one pixel of its region color, preserving row and column order.
0029:     - Mirror the compact region-color grid horizontally.
0030: 
0031:     Key insight:
0032:     - The large chessboard-like image is an enlarged region map; the final step is a left-right
0033:       reflection of that compressed map.
0034:     """
0035:     # Plan:
0036:     # 1. Determine the color of the separator between the regions
0037:     # 2. Extract all the regions separated by the separator color
0038:     # 3. Find the region positions and their possible X/Y positions
0039:     # 4. Create the output grid so that one pixel represents the original region, preserving X/Y ordering
0040:     # 5. Mirror the output grid by x-axis
0041: 
0042:     H, W = input_grid.shape
0043: 
0044:     # 1. Determine the separator color.
0045:     # Mirror the legacy seed approach: find the monochromatic component (non-black)
0046:     # whose bbox spans the whole canvas.
0047:     bg = Color.BLACK
0048:     sep_objs = find_components(input_grid, bg=bg, connectivity=4, monochromatic=True, return_format="objects")
0049:     sep_candidates = [obj for obj in sep_objs if bbox(obj != bg) == (0, 0, H - 1, W - 1)]
0050:     assert len(sep_candidates) == 1, "There should be exactly 1 separator partitioning the input"
0051:     separator_color = colors_present(sep_candidates[0], exclude={bg})[0]
0052: 
0053:     # 2. Extract all regions separated by the separator color.
0054:     regions = find_components(
0055:         input_grid,
0056:         bg=int(separator_color),
0057:         connectivity=4,
0058:         monochromatic=True,
0059:         return_format="dict",
0060:     )
0061: 
0062:     # 3/4. Build the downscaled grid (one pixel per region), preserving row/col ordering.
0063:     r_positions = sorted({int(reg["bbox"][0]) for reg in regions})
0064:     c_positions = sorted({int(reg["bbox"][1]) for reg in regions})
0065:     r_to_i = {r: i for i, r in enumerate(r_positions)}
0066:     c_to_j = {c: j for j, c in enumerate(c_positions)}
0067: 
0068:     output_grid = np.full((len(r_positions), len(c_positions)), Color.BLACK, dtype=int)
0069:     for reg in regions:
0070:         r0, c0, _r1, _c1 = reg["bbox"]
0071:         output_grid[r_to_i[int(r0)], c_to_j[int(c0)]] = int(reg["color"])
0072: 
0073:     # 5. Mirror the downscaled grid horizontally (left-right).
0074:     output_grid = np.fliplr(output_grid)
0075: 
0076:     return output_grid
