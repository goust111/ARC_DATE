0013: def main(input_grid):
0014:     """
0015:     Rotate the filled template region into each following empty region.
0016: 
0017:     Input structure:
0018:     - Gray divider lines split the grid into same-sized regions.
0019:     - Exactly one region contains a non-black, non-gray template.
0020:     - Later regions are black slots for rotated copies.
0021: 
0022:     Rule:
0023:     - Locate full gray row or column dividers and derive the region slices.
0024:     - Find the first region containing template pixels.
0025:     - Fill each subsequent region with the next 90-degree clockwise rotation.
0026: 
0027:     Key insight:
0028:     - The dividers define ordered slots; the template supplies the repeated rotation sequence.
0029:     """
0030:     divider = Color.GREY
0031:     bg = Color.BLACK
0032:     H, W = input_grid.shape
0033: 
0034:     # Identify divider lines (either full columns or full rows of divider color).
0035:     col_divs = [c for c in range(W) if np.all(input_grid[:, c] == divider)]
0036:     row_divs = [r for r in range(H) if np.all(input_grid[r, :] == divider)]
0037: 
0038:     output_grid = input_grid.copy()
0039: 
