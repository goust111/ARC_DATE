+        candidates.append((edge_dist, random.random(), cell))
+    if not candidates:
+        return None
+    candidates.sort(key=lambda item: (item[0], item[1]))
+    return candidates[0][2]
+
+
+def _semantic_ok(
+    inp: np.ndarray,
+    expected_out: np.ndarray,
+    planned_rods: list[dict[str, object]],
+    overlap_cells: set[tuple[int, int]],
+) -> bool:
