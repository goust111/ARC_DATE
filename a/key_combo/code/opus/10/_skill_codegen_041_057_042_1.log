+        parsed = _parse_rods(inp)
+        anchors = np.argwhere(inp == ANCHOR)
+        if len(anchors) != 1:
+            return False
+        anchor = tuple(map(int, anchors[0]))
+        fold_dirs = [_pick_fold_dir(inp, rod, anchor) for rod in parsed]
