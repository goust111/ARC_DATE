+        fixed_red_len = random.randint(1, min(3, 5 - tail_len))
+    else:
+        total = random.randint(5, 7)
+        low_tail = max(1, total - 5)
+        high_tail = min(4, total - 2)
+        tail_len = random.randint(low_tail, high_tail)
