+
+
+def _choose_anchor(grid: np.ndarray, rods: list[dict[str, object]]) -> tuple[int, int] | None:
+    reachable_sets = [_reachable_region(grid, rod["chosen_start"]) for rod in rods]  # type: ignore[arg-type]
