+def _sample_overlap_pair(shape: tuple[int, int]) -> tuple[list[dict[str, object]], set[tuple[int, int]]] | None:
+    h, w = shape
+    for _ in range(PAIR_ATTEMPTS):
+        overlap = (random.randint(4, h - 5), random.randint(4, w - 5))
+        rods: list[dict[str, object]] = []
