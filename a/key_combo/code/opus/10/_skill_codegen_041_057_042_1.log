+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+WALL = 6
+ANCHOR = 7
+
+ROD_COLORS = (BLUE, GREEN)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_H_RANGE = (13, 18)
+GRID_W_RANGE = (13, 18)
+ROD_COUNT_CHOICES = (3, 4)
+MAX_GENERATION_ATTEMPTS = 600
+PAIR_ATTEMPTS = 250
+EXTRA_ROD_ATTEMPTS = 300
