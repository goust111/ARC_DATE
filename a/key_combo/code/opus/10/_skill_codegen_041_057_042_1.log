+    rod_cells = set()
+    for rod in rods:
+        rod_cells.update(rod["input_cells"])  # type: ignore[arg-type]
+
+    candidates = []
+    for cell in common:
+        if cell in rod_cells:
+            continue
+        if any(nb in rod_cells for nb in _neighbors4(*cell)):
+            continue
