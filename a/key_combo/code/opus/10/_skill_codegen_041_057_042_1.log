+    for rod, fold_dir in zip(parsed, fold_dirs):
+        blocked_start = _add(rod["free_end"], _opposite(fold_dir))  # type: ignore[arg-type]
+        if not _in_bounds(inp.shape, *blocked_start) or int(inp[blocked_start]) != WALL:
+            return False
