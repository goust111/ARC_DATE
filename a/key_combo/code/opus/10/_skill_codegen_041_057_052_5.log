+def _shape_neighborhood(shape: tuple[int, int], cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    h, w = shape
+    expanded: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if 0 <= nr < h and 0 <= nc < w:
+                    expanded.add((nr, nc))
