+def _layer_coords(top: int, left: int, rect_h: int, rect_w: int, depth: int) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    r0 = top + depth
+    c0 = left + depth
+    r1 = top + rect_h - 1 - depth
