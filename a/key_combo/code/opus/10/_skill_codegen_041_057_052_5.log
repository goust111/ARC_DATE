+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MARKER = 7
+RING_COLOR_POOL = [1, 2, 3, 4, 5, 6, 8, 9]
+
+GEN_RETRIES = 400
+GRID_SIZE_RANGE = (13, 22)
+DEPTH_RANGE = (3, 5)
+COMPONENT_SIZE_RANGE = (2, 4)
+EXTRA_NOISE_RANGE = (0, 3)
