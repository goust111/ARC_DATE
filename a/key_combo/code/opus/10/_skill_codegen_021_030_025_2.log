+    c0: int,
+    box_h: int,
+    box_w: int,
+    pad: int = 1,
+) -> None:
+    for rr in range(max(0, r0 - pad), min(h, r0 + box_h + pad)):
+        for cc in range(max(0, c0 - pad), min(w, c0 + box_w + pad)):
+            reserved.add((rr, cc))
+
+
+def _bbox_free(
+    reserved: set[tuple[int, int]],
+    h: int,
+    w: int,
+    r0: int,
+    c0: int,
+    box_h: int,
+    box_w: int,
+    pad: int = 1,
