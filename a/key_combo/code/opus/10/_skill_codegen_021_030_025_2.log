   347	                    continue
   348	                if 0 <= rr < h and 0 <= cc < w:
   349	                    grid[rr, cc] = int(stamp_color)
   350	    return grid
   351	
   352	
   353	def _build_legend(h: int, w: int, groups: list[dict]) -> list[dict] | None:
   354	    corner = random.choice(["tl", "tr", "bl", "br"])
   355	    entries = []
   356	    entry_specs = []
   357	    for group in groups:
