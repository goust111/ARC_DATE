   405	        "filled_origins": tuple(filled_origins),
   406	        "sprite": tuple(sorted(sprite)),
   407	        "sprite_origin": tuple(sprite_origin),
   408	    }
   409	
   410	
   411	def _generate_case() -> dict | None:
   412	    h = random.randint(*GRID_SIZE_RANGE)
