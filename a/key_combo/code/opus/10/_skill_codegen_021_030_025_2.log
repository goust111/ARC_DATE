+            group["color"],
+            group["target"],
+            group["size"],
+            group["filled"],
+            group["bbox_origin"],
+            group["sprite"],
+            group["sprite_origin"],
+        )
+        for group in groups
+    ]
+    return {"shape": (h, w), "bg": 0, "groups": payload_groups, "legend": legend}
