255: 
256:                 elif cen in xs:
257:                     col, _ = xs[cen]
258:                     if col in comp_colors:
259:                         continue
260:                     dir_in = (-odr, -odc)
261:                     end, dd = _trace_wire(comp, ep, dir_in, h, w, rects_9)
