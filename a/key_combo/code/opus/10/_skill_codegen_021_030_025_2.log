+    bbox_origin: tuple[int, int],
+    sprite: tuple[tuple[int, int], ...],
+    sprite_origin: tuple[int, int],
+) -> dict:
+    r0, c0 = bbox_origin
+    missing = []
+    filled_origins = []
+    for br in range(2):
+        for bc in range(2):
+            origin = (r0 + br * size, c0 + bc * size)
+            if (br, bc) in filled:
