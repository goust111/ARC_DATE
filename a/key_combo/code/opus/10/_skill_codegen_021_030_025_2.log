def bg(grid):
    return Counter(map(int, grid.ravel())).most_common(1)[0][0]


def neigh(r, c, conn):
    if conn == 4:
        return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]
    out = []
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr or dc:
                out.append((r+dr,c+dc))
    return out


def comps(mask, conn):
    h,w = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            cur=[]
            while stack:
                rr,cc=stack.pop()
                cur.append((rr,cc))
                for nr,nc in neigh(rr,cc,conn):
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True
                        stack.append((nr,nc))
            out.append(cur)
    return out


def bbox(coords):
    rs=[r for r,_ in coords]
    cs=[c for _,c in coords]
    return min(rs), min(cs), max(rs), max(cs)


def norm(coords):
    r0,c0,_,_=bbox(coords)
    return tuple(sorted((r-r0,c-c0) for r,c in coords))

