    assert len(set(sprites.values())) == len(sprites)
    assert len(set(legend.values())) == len(legend)
    assert not (set(motifs) & set(legend.values()))
    if len(motifs) > 1:
        assert len({motif['filled'] for motif in motifs.values()}) >= 2

    # Legend preserved exactly.
