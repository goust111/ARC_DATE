+        tgt = int(scene["legend_map"][color])
+        for base_r, base_c in motif["missing_origins"]:
+            for dr, dc in sprite["shape"]:
+                rr = base_r + dr
+                cc = base_c + dc
+                if rr >= base_r + motif["size"] or cc >= base_c + motif["size"]:
+                    continue
+                if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+                    out[rr, cc] = tgt
