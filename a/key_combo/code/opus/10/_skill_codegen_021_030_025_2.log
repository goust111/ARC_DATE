   373	        colors = [group["color"], group["target"]] if order == "st" else [group["target"], group["color"]]
   374	        entries.append({"cells": [(pos[0][0], pos[0][1], colors[0]), (pos[1][0], pos[1][1], colors[1])]})
   375	        row += entry_h + 1
   376	    return entries
   377	
   378	
   379	def _make_group_payload(
   380	    color: int,
   381	    target: int,
   382	    size: int,
   383	    filled: tuple[tuple[int, int], tuple[int, int]],
   384	    bbox_origin: tuple[int, int],
