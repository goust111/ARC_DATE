+        remainder = total - maj
+        if others == 0:
+            return [maj]
+        cuts = sorted(random.sample(range(1, remainder), others - 1)) if others > 1 else []
+        pieces = []
+        prev = 0
+        for cut in cuts + [remainder]:
+            pieces.append(cut - prev)
+            prev = cut
+        if any(piece <= 0 for piece in pieces):
+            continue
+        if any(piece >= maj for piece in pieces):
