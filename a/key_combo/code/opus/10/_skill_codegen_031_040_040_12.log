+                out[rr, cc] = majority
+            rr += dr
+            cc += dc
+
+    assert active >= 1, "expected at least one active ray"
+    return out
+
+
+def _relation(frame_box: tuple[int, int, int, int], rect_box: tuple[int, int, int, int]) -> str:
+    fr0, fc0, fr1, fc1 = frame_box
+    rr0, cc0, rr1, cc1 = rect_box
+    vertical = "mid"
+    horizontal = "mid"
