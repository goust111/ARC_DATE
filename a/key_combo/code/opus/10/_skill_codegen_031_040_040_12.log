+    counts = _split_counts(total, len(colors), majority_index)
+    if counts is None:
+        return None
+
+    r0, c0, r1, c1 = frame_box
+    cells = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+    chosen = random.sample(cells, total)
