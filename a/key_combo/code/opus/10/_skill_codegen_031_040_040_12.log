+    candidates: list[dict[str, object]] = []
+    for rr0 in range(h - side + 1):
+        for cc0 in range(w - side + 1):
+            rect_box = (rr0, cc0, rr0 + side - 1, cc0 + side - 1)
+            if _rect_intersects_frame(rect_box, frame_box):
