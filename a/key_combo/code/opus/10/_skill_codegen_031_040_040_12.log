+    horizontal = "mid"
+    if rr1 < fr0:
+        vertical = "top"
+    elif rr0 > fr1:
+        vertical = "bottom"
+    if cc1 < fc0:
+        horizontal = "left"
+    elif cc0 > fc1:
+        horizontal = "right"
+    if vertical == "mid":
+        return horizontal
+    if horizontal == "mid":
+        return vertical
+    return f"{vertical}-{horizontal}"
+
+
+def _rect_intersects_frame(rect_box: tuple[int, int, int, int], frame_box: tuple[int, int, int, int]) -> bool:
