+    if candidate is None:
+        return None
+
+    rect_box = candidate["rect_box"]
+    statuses = candidate["statuses"]
+    counts = candidate["counts"]
+
+    inp = np.zeros((h, w), dtype=int)
+    inp[_frame_border_mask((h, w), frame_box)] = GRAY
