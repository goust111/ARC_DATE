    out = np.zeros((_GEN_GRID_SIZE, _GEN_GRID_SIZE), dtype=int)
    for tile_type, cells in placements:
        color = _GEN_TILE_PATTERNS[tile_type][1]
        for r, c in cells:
            out[r, c] = color
    return out


