    structure: each object bbox is 3x6 (horizontal) or 6x3 (vertical)
    marker_block: |
      fixed 4-pixel shape in one 3x3 half, rotated per direction:
        left:  1..|.11|1..   right: ..1|11.|..1
        top:   1.1|.1.|.1.   bottom: .1.|.1.|1.1
