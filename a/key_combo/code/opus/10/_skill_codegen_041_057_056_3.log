+
+
+def _choose_counts() -> tuple[int, int]:
+    return random.choice(((2, 2), (2, 3), (3, 2), (3, 3)))
+
+
+def _choose_hole_specs(n_holes: int) -> tuple[list[dict], tuple[int, int], tuple[int, int, int]] | None:
