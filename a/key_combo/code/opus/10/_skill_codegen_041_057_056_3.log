        inp[r0 : r0 + height, c0 : c0 + width] = patch
        expected[r0 : r0 + height, c0 : c0 + width] = np.flipud(patch)
        r0 += height

    if r0 != n - BORDER_SIZE:
        return None
    return inp, expected


