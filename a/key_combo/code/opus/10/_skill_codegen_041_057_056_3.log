def bbox_coords(coords):
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0); return int(r0),int(c0),int(r1),int(c1)

def has_hole(mask):
    coords=np.argwhere(mask)
    r0,c0,r1,c1=bbox_coords(coords)
    local=mask[r0:r1+1,c0:c1+1]
    H,W=local.shape
    seen=np.zeros((H,W),bool)
