            q=deque([(r,c)]); seen[r,c]=True; touch = r in (0,H-1) or c in (0,W-1)
            while q:
                rr,cc=q.popleft()
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
