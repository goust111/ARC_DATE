+        variants = [cand for cand in _unique_variants(HOLE_TEMPLATE_MASKS[index]) if _has_enclosed_hole(cand) and _mask_changes_under_vertical_mirror(cand)]
+        chosen.append({"mask": random.choice(variants).copy(), "kind": "hole"})
