+    b_mirror = np.zeros_like(mask_b, dtype=bool)
+    bm = _mirror_coords(np.argwhere(mask_b), (0, 0, mask_b.shape[0] - 1, mask_b.shape[1] - 1))
+    b_mirror[bm[:, 0], bm[:, 1]] = True
+    bm_coords = np.argwhere(b_mirror)
