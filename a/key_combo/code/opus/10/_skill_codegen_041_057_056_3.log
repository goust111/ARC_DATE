+        if not _place_remaining(specs, (height, width), occupied):
+            continue
+
+        grid = _render_specs((height, width), specs)
+        if _semantic_checks(specs, grid):
+            return grid
+
+    raise RuntimeError("failed to generate a valid input for puzzle 3")

