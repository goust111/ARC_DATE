+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_SIZE_RANGE = (15, 18)
+MAX_GENERATION_ATTEMPTS = 400
+
+
+HOLE_TEMPLATE_MASKS = (
+    np.array(
+        [
+            [1, 1, 1],
+            [1, 0, 1],
+            [1, 1, 1],
+            [0, 1, 0],
+        ],
+        dtype=bool,
+    ),
+    np.array(
