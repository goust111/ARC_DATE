+def _mirror_coords(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, _c0, r1, _c1 = bbox
+    mirrored = coords.copy()
+    mirrored[:, 0] = r0 + r1 - mirrored[:, 0]
+    return mirrored
