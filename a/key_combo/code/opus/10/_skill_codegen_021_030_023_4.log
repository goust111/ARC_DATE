+    used_shape_ids: set[int] = set()
+    for slot, same_branch in zip(chosen_slots, branches):
+        spec = _make_frame_and_sprite(slot, same_branch, used_shape_ids)
+        if spec is None:
+            return None
+        frame_specs.append(spec)
