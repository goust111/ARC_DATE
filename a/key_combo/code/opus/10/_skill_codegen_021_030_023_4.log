+    row_labels = _random_labels(h - 1)
+    col_labels = _random_labels(w - 1)
+    for spec in frame_specs:
+        r, c = ((spec["frame_bbox"][0] + spec["frame_bbox"][2]) // 2, (spec["frame_bbox"][1] + spec["frame_bbox"][3]) // 2)
