+    for frame in frames:
+        color = frame["row_label"] if frame["match"] else SPRITE_COLOR
+        rr = frame["reflected_coords"][:, 0]
+        cc = frame["reflected_coords"][:, 1]
+        out[rr, cc] = int(color)
+    return out
