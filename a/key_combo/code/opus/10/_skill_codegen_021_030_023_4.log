+
+def _frame_border_coords(bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    coords = []
+    for r in range(r0, r1 + 1):
+        coords.append((r, c0))
+        coords.append((r, c1))
+    for c in range(c0 + 1, c1):
+        coords.append((r0, c))
+        coords.append((r1, c))
+    return np.array(sorted(set(coords)), dtype=int)
