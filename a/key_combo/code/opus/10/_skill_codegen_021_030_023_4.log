+            c0_min = slot_c0 + gap + sw
+            c0_max = slot_c1 - frame_size
+            if c0_min > c0_max:
+                return None
+            c0 = random.randint(c0_min, c0_max)
+        else:
+            c0_min = slot_c0
+            c0_max = slot_c1 - frame_size - gap - sw
+            if c0_min > c0_max:
