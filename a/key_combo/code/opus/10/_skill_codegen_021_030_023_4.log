+def _reflect_into_frame(
+    sprite_coords: np.ndarray,
+    sprite_bbox: tuple[int, int, int, int],
+    frame_bbox: tuple[int, int, int, int],
+    axis: str,
+) -> np.ndarray:
+    r0, c0, r1, c1 = frame_bbox
