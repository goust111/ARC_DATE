    return safe[1] - safe[0] + 1


def _gen_choose_counts(
    regions: list[dict[str, int | str]], split_type: str, rng: np.random.Generator
) -> list[int] | None:
    options = []
    for counts in _GEN_COUNT_OPTIONS:
        ok = True
