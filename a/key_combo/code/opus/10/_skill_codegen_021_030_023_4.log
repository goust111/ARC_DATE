+def _analyze_input(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] >= 8 and g.shape[1] >= 8
+    assert np.all(np.isin(g[:-1, -1], LABEL_COLORS))
+    assert np.all(np.isin(g[-1, :-1], LABEL_COLORS))
+    assert int(g[-1, -1]) in LABEL_COLORS
