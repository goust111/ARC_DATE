+    for coords_local in frame_components:
+        coords = coords_local.copy()
+        bbox = _bbox(coords)
+        assert _is_frame(interior, coords)
+        rc = (bbox[0] + bbox[2]) // 2
+        cc = (bbox[1] + bbox[3]) // 2
+        row_label = int(g[rc, -1])
+        col_label = int(g[-1, cc])
+        frames.append(
+            {
+                "coords": coords,
+                "bbox": bbox,
+                "center": (rc, cc),
+                "row_label": row_label,
+                "col_label": col_label,
+            }
+        )
