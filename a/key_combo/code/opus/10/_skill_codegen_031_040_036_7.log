            if left<1 or right>W-2: continue
            if any(abs(left-u)<=0 or abs(right-u)<=0 for u in used): continue
            r0=random.randint(2,H-h-3)
            if np.any(grid[r0:r0+h,left]) or np.any(grid[r0:r0+h,right]): continue
            grid[r0:r0+h,left]=color; grid[r0:r0+h,right]=color
            used.extend([left,right])
            break
        else:
            return None
    return grid

