from collections import defaultdict, Counter, deque
import numpy as np

BLACK=0; BLUE=1; RED=2; GREEN=3; YELLOW=4; PINK=6
COLORS=[BLUE,RED,YELLOW]

def outoff(row,r0,r1,h):
    if row<r0: return ((r0-1-row)//h)+1
    if row>r1: return ((row-r1-1)//h)+1
    return 0

def expand(grid):
    H,W=grid.shape
    claims=defaultdict(set)
    for color in [c for c in np.unique(grid) if c"'!=0]:
        pts=np.argwhere(grid==color)
        cols=sorted(set(map(int,pts[:,1])))
        if len(cols)!=2:
            return None
        rows_by=[]
        for col in cols:
            rows=sorted(map(int,pts[pts[:,1]==col,0]))
            if rows!=list(range(rows[0],rows[-1]+1)): return None
            rows_by.append(rows)
        if rows_by[0][0]!=rows_by[1][0] or rows_by[0][-1]!=rows_by[1][-1]: return None
        r0,r1=rows_by[0][0],rows_by[0][-1]
        h=r1-r0+1
        for r in range(H):
            off=outoff(r,r0,r1,h)
            lc=cols[0]-off
            rc=cols[1]+off
            if 0<=lc<W: claims[(r,lc)].add(int(color))
            if 0<=rc<W: claims[(r,rc)].add(int(color))
    out=np.zeros_like(grid)
    for (r,c), colors in claims.items():
        out[r,c]= next(iter(colors)) if len(colors)==1 else PINK
    return out

def comps(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    res=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=True; comp=[]
            while q:
                x,y=q.popleft(); comp.append((x,y))
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=True; q.append((nx,ny))
            res.append(comp)
    return res

def green_comps(out):
    regions=comps(out==0)
    green=0
    black=0
    for comp in regions:
        s=set(comp)
        has=False
        for r,c in comp:
            if all((r+dr,c+dc) in s for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))):
                has=True; break
        green+=has; black+=not has
    return len(regions), green, black

def random_grid():
