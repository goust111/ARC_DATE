import random
from collections import defaultdict, deque, Counter
import numpy as np
BLACK=0; BLUE=1; RED=2; GREEN=3; YELLOW=4; PINK=6
COLORS=[BLUE,RED,YELLOW]

def off(row,r0,r1,h):
    if row<r0: return ((r0-1-row)//h)+1
    if row>r1: return ((row-r1-1)//h)+1
    return 0

def expand(grid):
    H,W=grid.shape
    claims=defaultdict(set)
    for color in [c for c in np.unique(grid) if c"'!=0]:
        pts=np.argwhere(grid==color)
        cols=sorted(set(map(int,pts[:,1])))
        rows=[sorted(map(int,pts[pts[:,1]==col,0])) for col in cols]
        r0,r1=rows[0][0],rows[0][-1]; h=r1-r0+1
        for r in range(H):
            k=off(r,r0,r1,h)
            for col,d in ((cols[0],-1),(cols[1],1)):
                cc=col+d*k
                if 0<=cc<W: claims[(r,cc)].add(int(color))
    out=np.zeros_like(grid)
    for (r,c),cs in claims.items():
        out[r,c]=next(iter(cs)) if len(cs)==1 else PINK
    return out

def comps(mask):
    H,W=mask.shape; vis=np.zeros_like(mask,dtype=bool); res=[]
    for r in range(H):
      for c in range(W):
        if not mask[r,c] or vis[r,c]: continue
        q=deque([(r,c)]); vis[r,c]=1; comp=[]
        while q:
          x,y=q.popleft(); comp.append((x,y))
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
        res.append(comp)
    return res

def analyze(out):
    regs=comps(out==0)
    fill=[]; keep=[]
    for comp in regs:
        s=set(comp)
        has=any(all((r+dr,c+dc) in s for dr,dc in ((1,0),(-1,0),(0,1),(0,-1))) for r,c in comp)
        (fill if has else keep).append(len(comp))
    return dict(regions=len(regs), fill=fill, keep=keep, pink=int(np.count_nonzero(out==PINK)), density=float(np.count_nonzero(out))/out.size)

def sample():
    H=random.randint(18,24); W=random.randint(18,24)
    n=random.choice([2,3])
