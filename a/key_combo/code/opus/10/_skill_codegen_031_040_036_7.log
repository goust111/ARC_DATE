    cnt[(reg,gr,bk)] += 1
    if reg>=3 and gr>=1 and bk>=1:
        examples.append((g.shape,np.count_nonzero(out==PINK),reg,gr,bk,g,out))
print('patterns', cnt.most_common(20)[:10])
print('good', len(examples))
if examples:
    ex=examples[0]
    print('sample', ex[:5])
    print(ex[5])
    print(ex[6])
