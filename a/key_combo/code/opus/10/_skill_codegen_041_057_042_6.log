+    if pattern == "bottom_right":
+        choices = ((h - 4, w - 4), (h - 4, w - 5), (h - 5, w - 4))
+    elif pattern == "bottom_left":
+        choices = ((h - 4, 1), (h - 4, 2), (h - 5, 1))
+    elif pattern == "top_right":
+        choices = ((1, w - 4), (1, w - 5), (2, w - 4))
