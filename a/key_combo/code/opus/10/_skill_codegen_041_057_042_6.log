+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _marker_offset(side: str, marker_coords: np.ndarray, cross_r0: int, cross_c0: int) -> int:
+    if side in {"left", "right"}:
