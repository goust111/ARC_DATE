+    if np.all(marker_coords[:, 1] == cross_c0 - 1):
+        side = "left"
+    elif np.all(marker_coords[:, 1] == cross_c0 + 3):
+        side = "right"
+    elif np.all(marker_coords[:, 0] == cross_r0 - 1):
