+    normalized = np.zeros((3, 3), dtype=bool)
+    normalized[cross_coords[:, 0] - r0, cross_coords[:, 1] - c0] = True
+    assert np.array_equal(normalized, CROSS_MASK), "cross pixels must form a plus shape"
+    return r0, c0
