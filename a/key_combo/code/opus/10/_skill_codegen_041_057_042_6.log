+    if move == "down":
+        return h - 3, int(ortho)
+    return 0, int(ortho)
+
+
+def _pair_orthogonals(shape: tuple[int, int], pattern: str) -> tuple[int, int]:
+    h, w = shape
+    if pattern == "bottom_right":
+        return h - 4, w - 4
+    elif pattern == "bottom_left":
+        return h - 4, 1
+    elif pattern == "top_right":
