+
+def _input_components_well_separated(shape: tuple[int, int], objects: list[dict]) -> bool:
+    canvas = np.zeros(shape, dtype=int)
+    for idx, obj in enumerate(objects, start=1):
+        for r, c, _ in _object_cells(obj, transformed=False):
+            if canvas[r, c] != 0:
