+
+def _random_cross_block(center_color: int) -> np.ndarray:
+    block = np.zeros((3, 3), dtype=int)
+    block[1, 1] = center_color
+    arms = random.sample(list(ARM_COLORS), 4)
+    for color, (r, c) in zip(arms, ARM_ORDER):
+        block[r, c] = color
+    return block
