+
+def _render_input(shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    inp = np.zeros(shape, dtype=int)
+    for obj in objects:
+        for r, c, color in _object_cells(obj, transformed=False):
+            inp[r, c] = color
+    return inp
+
+
+def _overlap_stats(objects: list[dict]) -> tuple[int, int]:
+    counts: dict[tuple[int, int], int] = {}
+    for obj in objects:
+        for r, c, _ in _object_cells(obj, transformed=True):
+            counts[(r, c)] = counts.get((r, c), 0) + 1
