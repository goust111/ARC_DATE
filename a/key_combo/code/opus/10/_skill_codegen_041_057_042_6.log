+
+    directions = [*pair_moves, *extra_moves]
+    distances = _sample_unique_distances(len(directions), shape)
+    center_colors = random.sample(list(CENTER_COLORS), len(directions))
+
+    pair_ortho_a, pair_ortho_b = _pair_orthogonals(shape, pattern)
+    final_positions: list[tuple[str, tuple[int, int]]] = [
+        (pair_moves[0], _final_cross_for_move(shape, pair_moves[0], pair_ortho_a)),
+        (pair_moves[1], _final_cross_for_move(shape, pair_moves[1], pair_ortho_b)),
+    ]
+    temp_pair = [
+        {
+            "move": move,
+            "side": MOVE_TO_SIDE[move],
+            "cross_top_left": cross,
+            "distance": 5,
+            "marker_offset": random.randint(0, 1),
+            "center_color": center_colors[i],
+            "cross_block": _random_cross_block(center_colors[i]),
+        }
+        for i, (move, cross) in enumerate(final_positions)
