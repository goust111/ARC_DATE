+    max_stack = max(counts.values())
+    return overlap_cells, max_stack
+
+
+def _intended_signature(objects: list[dict]) -> dict[int, tuple]:
+    sig: dict[int, tuple] = {}
+    for obj in objects:
+        sig[obj["center_color"]] = (
+            obj["side"],
+            obj["move"],
+            obj["distance"],
+            obj["marker_offset"],
+            obj["cross_top_left"],
