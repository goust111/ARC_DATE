+        candidate = {
+            "move": move,
+            "side": MOVE_TO_SIDE[move],
+            "cross_top_left": cross,
+            "distance": 5,
+            "marker_offset": random.randint(0, 1),
+            "center_color": center_colors[len(temp_pair)],
+            "cross_block": _random_cross_block(center_colors[len(temp_pair)]),
