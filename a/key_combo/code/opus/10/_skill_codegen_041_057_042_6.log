+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 5
+CENTER_COLORS = (1, 3, 4, 9)
+ARM_COLORS = (2, 6, 7, 8)
+CROSS_MASK = np.array(
+    [
+        [False, True, False],
+        [True, True, True],
+        [False, True, False],
