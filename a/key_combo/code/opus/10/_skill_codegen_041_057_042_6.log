+        for c in range(shape[1]):
+            if canvas[r, c] == 0:
+                continue
+            for nr, nc in _neighbors8(r, c):
+                if 0 <= nr < shape[0] and 0 <= nc < shape[1]:
+                    if canvas[nr, nc] not in {0, canvas[r, c]}:
