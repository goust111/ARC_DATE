+            obj["move"],
+            obj["distance"],
+            obj["marker_offset"],
+            obj["cross_top_left"],
+            tuple(map(int, obj["cross_block"].flat)),
+        )
+    return sig
+
+
+def _parsed_signature(objects: list[dict]) -> dict[int, tuple]:
+    sig: dict[int, tuple] = {}
+    for obj in objects:
+        sig[obj["center_color"]] = (
+            obj["side"],
+            obj["move"],
+            obj["distance"],
+            obj["marker_offset"],
+            obj["cross_top_left"],
+            tuple(map(int, obj["cross_block"].flat)),
+        )
+    return sig
+
+
+def _validate_generation(inp: np.ndarray, objects: list[dict]) -> bool:
