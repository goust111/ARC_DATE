+def _marker_cells(cross_r: int, cross_c: int, side: str, offset: int) -> list[tuple[int, int]]:
+    if side == "left":
+        return [(cross_r + offset, cross_c - 1), (cross_r + offset + 1, cross_c - 1)]
+    if side == "right":
