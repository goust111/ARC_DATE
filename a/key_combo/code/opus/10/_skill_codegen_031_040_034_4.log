+
+
+def _pair_relations(rectangles: list[dict]) -> list[dict]:
+    relations = []
+    for i in range(len(rectangles)):
+        ar0, ac0, ar1, ac1 = rectangles[i]["bbox"]
+        for j in range(i + 1, len(rectangles)):
