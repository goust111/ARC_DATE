            if (
                new_area_sum > _GEN_MAX_TOTAL_AREA
                or new_area_sum + _GEN_MAX_RECT_AREA * remaining < _GEN_MIN_TOTAL_AREA
            ):
                continue
            chosen.append((h, w))
            result = rec(i + 1, new_width_sum, new_area_sum)
            if result is not None:
                return result
            chosen.pop()
        return None

    return rec(0, 0, 0)

