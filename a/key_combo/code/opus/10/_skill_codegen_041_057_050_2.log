+            for r, c in fragment:
+                grid[int(r), int(c)] = WALL
+
+    for row in particle_rows:
+        if int(grid[row, 0]) != BG:
+            return None
+        grid[int(row), 0] = PARTICLE
+
+    if not _validate_input(grid, bboxes, particle_rows):
+        return None
+    return grid
