+def _trace_particle(
+    walls: np.ndarray, start: tuple[int, int]
+) -> dict[str, object]:
+    h, w = walls.shape
+    r, c = map(int, start)
+    direction = 0
+    path = [(r, c)]
+    collisions = 0
+    first_collision: str | None = None
+    stopped_after_turn = False
+
