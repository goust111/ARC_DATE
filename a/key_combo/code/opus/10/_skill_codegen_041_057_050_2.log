+def _merge_fragment_groups(components: list[dict]) -> list[dict]:
+    groups = [{"coords": comp["coords"].copy(), "bbox": comp["bbox"]} for comp in components]
+    changed = True
+    while changed:
+        changed = False
+        for i in range(len(groups)):
+            if changed:
