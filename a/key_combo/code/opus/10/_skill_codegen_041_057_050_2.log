+            path.append((r, c))
+            continue
+
+        collisions += 1
+        if first_collision is None:
+            first_collision = "boundary" if hit_boundary else "wall"
+
+        direction = 1 - direction
+        dr, dc = _DIRS[direction]
+        nr, nc = r + dr, c + dc
