+
+        bboxes = []
+        for r0, c0, hh, ww in zip(row_starts, col_starts, heights, widths):
+            bboxes.append((int(r0), int(c0), int(r0 + hh - 1), int(c0 + ww - 1)))
+
+        ok = True
+        for a, b in combinations(bboxes, 2):
+            if _bboxes_share_row_or_col(a, b):
