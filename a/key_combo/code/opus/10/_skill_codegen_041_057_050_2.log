+    if need > total:
+        return None
+    extra = total - need
+    extras = _random_partition(extra, len(lengths) + 1)
+
+    positions: list[int] = []
+    cur = lead_min + extras[0]
+    for i, length in enumerate(lengths):
+        positions.append(int(cur))
+        cur += int(length)
+        if i < len(lengths) - 1:
+            cur += between_min + extras[i + 1]
