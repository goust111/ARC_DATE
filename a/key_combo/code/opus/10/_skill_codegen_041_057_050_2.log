+
+
+def _group_fragments(bbox: tuple[int, int, int, int]) -> list[list[tuple[int, int]]]:
+    r0, c0, r1, c1 = map(int, bbox)
+    return [
+        [(r0, c0)],
+        [(r0, c1)],
+        [(r1, c0)],
+        [(r1, c1)],
+    ]
+
+
+def _particle_rows_for_layout(
