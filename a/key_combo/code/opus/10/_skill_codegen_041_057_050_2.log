+        dr, dc = _DIRS[direction]
+        nr, nc = r + dr, c + dc
+        hit_boundary = not (0 <= nr < h and 0 <= nc < w)
+        blocked = hit_boundary or bool(walls[nr, nc])
+        if not blocked:
