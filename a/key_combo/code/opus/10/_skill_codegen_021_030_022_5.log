+                shape = rng.randrange(3)
+                bend0 = _random_bend(rng, prefer_wrap=True)
+                bend1 = rng.choice([b for b in range(6) if b % 3 != bend0 % 3])
+                specs = [{"shape": shape, "bends": bend0}, {"shape": shape, "bends": bend1}]
