+ZONE = 13
+TEMPLATE_EVEN = {
+    0: [(6, 3), (6, 9)],
+    2: [(6, 3), (6, 7), (4, 7), (4, 9)],
+    4: [(6, 3), (6, 5), (4, 5), (4, 8), (8, 8), (8, 9)],
