+    metas: list[dict[str, object]] = []
+    for idx, origin in enumerate(origins):
+        if idx < active_count:
+            spec = specs[idx]
+            meta = _place_wire(
+                grid,
+                origin,
+                int(spec["bends"]),
+                int(spec["shape"]),
+                colors[idx],
+                rng,
+            )
+        else:
+            meta = _place_wire(grid, origin, _random_bend(rng, prefer_wrap=True), None, None, rng)
+        metas.append(meta)
+
+    if not _semantic_checks(grid, metas, active_count):
+        return None
+
+    expected = _expected_output(grid, metas)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if np.array_equal(actual, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid bend-coded token transmission input")

