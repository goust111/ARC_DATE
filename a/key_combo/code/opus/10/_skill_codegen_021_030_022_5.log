+
+
+def _wire_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen: set[tuple[int, int]] = set()
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
