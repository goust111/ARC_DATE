+    start = min(endpoints)
+    path = [start]
+    prev = None
+    cur = start
+    while True:
+        nxts = [p for p in _neighbors4(*cur) if p in pts and p != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "wire may not branch"
+        nxt = nxts[0]
+        path.append(nxt)
+        prev, cur = cur, nxt
+    assert len(path) == len(comp), "wire path must visit every wire cell exactly once"
+    return path
