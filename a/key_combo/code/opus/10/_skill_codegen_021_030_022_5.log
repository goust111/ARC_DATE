+TEMPLATE_ODD = {
+    1: [(6, 3), (6, 9), (3, 9)],
+    3: [(6, 3), (6, 7), (5, 7), (5, 9), (3, 9)],
+    5: [(6, 3), (6, 7), (4, 7), (4, 5), (8, 5), (8, 9), (3, 9)],
