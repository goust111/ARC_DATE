+    if prefer_wrap:
+        weights = [1, 1, 1, 2, 2, 2]
+        return rng.choices(choices, weights=weights, k=1)[0]
+    return rng.choice(choices)
+
+
+def _sample_active_specs(active_count: int, rng: random.Random) -> list[dict[str, int]]:
+    specs: list[dict[str, int]]
