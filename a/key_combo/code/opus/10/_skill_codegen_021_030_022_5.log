+    meta: dict[str, object] = {
+        "path": global_path,
+        "bends": bends,
+        "source_shape": token_shape,
+        "token_color": token_color,
+        "source_center": None,
+        "target_center": None,
+    }
+    if token_shape is None or token_color is None:
+        return meta
