+        dst = ends[1] if ends[0] is src else ends[0]
+        token = src["token"]
+        assert token is not None
+        dst_shape = (int(token["shape"]) + int(wire["bends"])) % 3
+        _draw_shape(out, dst["center"], int(token["color"]), dst_shape)
