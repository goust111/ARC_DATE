+
+def _bend_count(path: list[tuple[int, int]]) -> int:
+    bends = 0
+    prev_dir = None
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        step = (r1 - r0, c1 - c0)
+        if prev_dir is not None and step != prev_dir:
+            bends += 1
+        prev_dir = step
+    return bends
+
+
+def _parse_scene(grid: np.ndarray) -> list[dict[str, object]]:
