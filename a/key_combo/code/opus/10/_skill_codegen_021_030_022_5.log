+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            sub = grid[r - 1 : r + 2, c - 1 : c + 2]
+            values = sorted({int(v) for v in sub.flatten()} - {BLACK})
+            if len(values) != 1:
