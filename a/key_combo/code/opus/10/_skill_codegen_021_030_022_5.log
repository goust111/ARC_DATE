+
+def _expand_vertices(vertices: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    cells = [vertices[0]]
+    for (r0, c0), (r1, c1) in zip(vertices, vertices[1:]):
+        dr = 0 if r0 == r1 else (1 if r1 > r0 else -1)
+        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
