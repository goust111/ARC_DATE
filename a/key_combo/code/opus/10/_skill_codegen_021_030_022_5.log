+    while True:
+        transform = TRANSFORMS[rng.randrange(len(TRANSFORMS))]
+        path = _expand_vertices([transform(p) for p in vertices])
+        if len(set(path)) == len(path):
+            return path
+
+
+def _random_bend(rng: random.Random, *, prefer_wrap: bool) -> int:
