+    return origins[:n_wires], (height, width)
+
+
+def _place_wire(
+    grid: np.ndarray,
+    origin: tuple[int, int],
+    bends: int,
+    token_shape: int | None,
+    token_color: int | None,
+    rng: random.Random,
