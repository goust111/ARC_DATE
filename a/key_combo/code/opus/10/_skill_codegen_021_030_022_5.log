+            bend1_options = [b for b in range(6) if b % 3 != bend0 % 3]
+            bend1 = rng.choice(bend1_options)
+            specs.extend(
+                [
+                    {"shape": base_shape, "bends": bend0},
+                    {"shape": base_shape, "bends": bend1},
