+def _place_wire(
+    grid: np.ndarray,
+    origin: tuple[int, int],
+    bends: int,
+    token_shape: int | None,
+    token_color: int | None,
+    rng: random.Random,
+) -> dict[str, object]:
+    local_path = _make_local_path(bends, rng)
+    global_path = [(origin[0] + r, origin[1] + c) for r, c in local_path]
+    for r, c in global_path:
+        grid[r, c] = GREY
