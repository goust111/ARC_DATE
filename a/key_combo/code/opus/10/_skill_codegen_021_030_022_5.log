+    empty_lines = 0
+    for wire in parsed:
+        present = [end for end in wire["ends"] if end["token"] is not None]
+        if len(present) == 1:
+            token_lines.append(
+                {
+                    "shape": int(present[0]["token"]["shape"]),
+                    "bends": int(wire["bends"]),
+                    "target": (int(present[0]["token"]["shape"]) + int(wire["bends"])) % 3,
