+        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
+        assert dr == 0 or dc == 0
+        cr, cc = r0, c0
+        while (cr, cc) != (r1, c1):
+            cr += dr
+            cc += dc
+            cells.append((cr, cc))
+    return cells
+
+
+def _make_local_path(bends: int, rng: random.Random) -> list[tuple[int, int]]:
