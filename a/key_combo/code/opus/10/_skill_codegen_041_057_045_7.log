+        sprite_meta[color] = {
+            "anchor": anchor,
+            "bar_anchor": bar_anchor,
+            "side": side,
+            "step": (bar_anchor[0] - anchor[0], bar_anchor[1] - anchor[1]),
+            "bar_bbox": bar_bbox,
+            "expected": set(_template_cells(anchor)),
