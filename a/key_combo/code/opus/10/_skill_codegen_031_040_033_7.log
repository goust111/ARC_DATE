def _gen_rect_perimeter_cells(h, w):
    cells = set()
    for c in range(w):
        cells.add((0, c))
        cells.add((h - 1, c))
    for r in range(h):
        cells.add((r, 0))
        cells.add((r, w - 1))
    return cells


def _gen_closed_patch(color, closed_count):
    for _ in range(CLOSED_PATCH_ATTEMPTS):
        h_bounds, w_bounds = CLOSED_SIZE_BY_COUNT[min(closed_count, 3)]
        h = random.randint(*h_bounds)
