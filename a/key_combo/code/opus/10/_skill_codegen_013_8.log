+
+def _count_region_markers(region: np.ndarray, marker_color: int) -> tuple[int, int]:
+    mask = np.asarray(region, dtype=int) == int(marker_color)
+    valid = 0
+    isolated = 0
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        has_neighbor = any(
