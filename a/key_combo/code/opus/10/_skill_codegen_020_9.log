+        chosen = random.sample(range(area), n_red)
+        mask = np.zeros((seed_size, seed_size), dtype=bool)
+        mask.reshape(-1)[chosen] = True
+        expanded = _expanded_tile_mask(mask)
+        repeated = np.tile(mask, (seed_size, seed_size))
