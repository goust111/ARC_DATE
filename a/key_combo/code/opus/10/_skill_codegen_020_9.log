    candidates = []
    for a in _GEN_SCATTER_CELLS:
        ar, ac = a
        for dr, dc in _GEN_PAIR_DIRS:
            b = (ar + dr, ac + dc)
            if b not in _GEN_SCATTER_SET:
                continue
            if not _gen_is_clear_scatter_cell(a, occupied):
                continue
            if not _gen_is_clear_scatter_cell(b, occupied):
                continue
            candidates.append((a, b))
