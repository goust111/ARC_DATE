    assignments: dict[tuple[int, int], int] = {}
    remaining_cells = list(cells)

    if _GEN_BRACKET_COLOR in counts:
        safe_cells = [
            cell for cell in remaining_cells if cell not in _GEN_BRACKET_TOUCH_CELLS
