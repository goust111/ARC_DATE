                tiled = np.tile(tile, ((rh + ph - 1) // ph, (cw + pw - 1) // pw))[:rh, :cw]
                region[:, :] = tiled

                # Add small noise (flip a few cells) so reconstruction does real work.
                n_noise = int(np.random.randint(0, max(1, (rh * cw) // 20)))
