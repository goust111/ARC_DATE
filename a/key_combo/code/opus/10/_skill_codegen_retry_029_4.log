+BG = 0
+FG = 3
+SPRITE_SIZE = 3
+ATLAS_SIZE = 7
+QUADRANT_ORDER = ("UL", "UR", "LL", "LR")
+ATLAS_TOP_LEFT = {
+    "UL": (0, 0),
+    "UR": (0, 4),
+    "LL": (4, 0),
+    "LR": (4, 4),
+}
+CW_TURNS = {
+    "UL": 0,
+    "UR": 1,
+    "LR": 2,
+    "LL": 3,
+}
