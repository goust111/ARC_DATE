+
+
+def _gap_1d(a0: int, a1: int, b0: int, b1: int) -> int:
+    if a1 < b0:
+        return b0 - a1 - 1
+    if b1 < a0:
+        return a0 - b1 - 1
+    return -1
+
+
+def _boxes_have_clearance(
+    placements: dict[str, tuple[int, int]],
+    *,
+    min_empty_gap: int = 2,
+) -> bool:
+    boxes = {
