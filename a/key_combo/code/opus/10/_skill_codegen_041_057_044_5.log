+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+CONTOUR = 7
+MAROON = 9
+PAIR_MAP = {
+    1: 4,
+    4: 1,
+    2: 3,
+    3: 2,
+    5: 6,
+    6: 5,
+    7: 8,
+    8: 7,
+}
+CONTROL_PALETTE = [1, 2, 3, 4, 5, 6]
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _component_masks(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp = np.zeros_like(mask, dtype=bool)
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            comp[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        comp[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _touches_edge(mask: np.ndarray) -> bool:
+    return bool(mask[0].any() or mask[-1].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def _draw_rect_outline(grid: np.ndarray, rect: tuple[int, int, int, int], color: int) -> None:
+    r0, c0, r1, c1 = rect
+    grid[r0, c0 : c1 + 1] = color
+    grid[r1, c0 : c1 + 1] = color
+    grid[r0 : r1 + 1, c0] = color
+    grid[r0 : r1 + 1, c1] = color
+
+
+def _strict_interior_mask(shape: tuple[int, int], rect: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = rect
+    mask = np.zeros(shape, dtype=bool)
+    if r1 - r0 >= 2 and c1 - c0 >= 2:
+        mask[r0 + 1 : r1, c0 + 1 : c1] = True
+    return mask
