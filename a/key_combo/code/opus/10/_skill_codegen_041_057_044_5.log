+            if np.any(mask_i & mask_j):
+                return None
+
+    expected = grid.copy()
+    for mask, color in intended_regions:
+        expected[mask] = color
+
+    if not _semantic_check(grid, expected, intended_regions):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
