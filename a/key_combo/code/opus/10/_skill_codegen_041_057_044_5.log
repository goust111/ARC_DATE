+
+
+def _count_contour_crossings(grid: np.ndarray, col: int, stop_row: int) -> int:
+    col_mask = grid[:stop_row, col] == CONTOUR
+    if stop_row <= 0:
+        return 0
+    starts = col_mask & np.concatenate(([True], ~col_mask[:-1]))
+    return int(starts.sum())
+
