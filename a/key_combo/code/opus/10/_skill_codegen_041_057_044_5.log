from __future__ import annotations

from collections import deque
import random

import numpy as np


BG = 0
CONTOUR = 7
MAROON = 9
PAIR_MAP = {
    1: 4,
    4: 1,
    2: 3,
    3: 2,
    5: 6,
    6: 5,
    7: 8,
