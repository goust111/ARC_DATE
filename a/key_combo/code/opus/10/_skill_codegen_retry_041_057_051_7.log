152:def _gen_trace_cycle(mask):
153:    pts = {tuple(map(int, p)) for p in np.argwhere(mask)}
154:    if len(pts) < GEN_PERIMETER_RANGE[0]:
155:        return None
156:    for r, c in pts:
157:        degree = sum((r + dr, c + dc) in pts for dr, dc in GEN_DIRS4)
158:        if degree != 2:
159:            return None
160:
161:    start = min(pts)
162:    neigh = sorted((start[0] + dr, start[1] + dc) for dr, dc in GEN_DIRS4 if (start[0] + dr, start[1] + dc) in pts)
163:    if len(neigh) != 2:
164:        return None
165:    path = [start]
166:    prev, cur = start, neigh[0]
167:    while cur != start:
168:        path.append(cur)
169:        nxt = [
170:            (cur[0] + dr, cur[1] + dc)
171:            for dr, dc in GEN_DIRS4
172:            if (cur[0] + dr, cur[1] + dc) in pts
173:            and (cur[0] + dr, cur[1] + dc) != prev
174:        ]
175:        if len(nxt) != 1 or len(path) > len(pts):
176:            return None
177:        prev, cur = cur, nxt[0]
178:    return path if len(path) == len(pts) else None
