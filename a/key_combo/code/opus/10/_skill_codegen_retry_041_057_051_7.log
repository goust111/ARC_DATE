190:def _neighbors4(r: int, c: int, height: int, width: int):
191:    for dr, dc in NEIGHBOR_OFFSETS_4:
192:        nr, nc = r + dr, c + dc
193:        if 0 <= nr < height and 0 <= nc < width:
194:            yield nr, nc
