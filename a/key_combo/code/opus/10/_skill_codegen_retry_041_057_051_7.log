142:def _has_symmetry(mask: np.ndarray) -> bool:
143:    return (
144:        np.array_equal(mask, np.fliplr(mask))
145:        or np.array_equal(mask, np.flipud(mask))
146:        or np.array_equal(mask, np.rot90(mask, 2))
147:    )
