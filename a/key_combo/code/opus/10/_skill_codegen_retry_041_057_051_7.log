197:def _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:
198:    comps = [
199:        [tuple(map(int, rc)) for rc in coords]
200:        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)
201:        if len(coords) >= size
202:    ]
203:    if not comps:
204:        return None
205:
206:    comp = random.choice(comps)
207:    comp_set = set(comp)
208:    seed = random.choice(comp)
209:    blob = {seed}
210:    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}
211:
212:    while len(blob) < size:
213:        if not frontier:
214:            return None
215:        cell = random.choice(tuple(frontier))
216:        frontier.remove(cell)
217:        blob.add(cell)
218:        for nb in _neighbors4(*cell, *allowed.shape):
219:            if nb in comp_set and nb not in blob:
220:                frontier.add(nb)
221:
222:    return blob
