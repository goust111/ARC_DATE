        if motif_below_r + h <= GEN_CANVAS_SIZE:
            pairs.append((frame_r, motif_below_r))
    return pairs


def _gen_draw_frame(
    grid: np.ndarray, top: int, left: int, h: int, w: int, left_color: int, right_color: int
