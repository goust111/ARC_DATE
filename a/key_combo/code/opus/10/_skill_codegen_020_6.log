MIN_CONTENT_DOTS = 3
MIN_CONTENT_DENSITY, MAX_CONTENT_DENSITY = 0.08, 0.25
ROW_GAP_MIN, ROW_GAP_MAX = 1, 3
COLUMN_SPAN_TRIES, MAX_COLUMN_SPANS = 30, 4

