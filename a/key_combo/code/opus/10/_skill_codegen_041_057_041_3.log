+
+    template = _random_template()
+    top_t = h // 2 - 2
+    left_t = w // 2 - 2
+    grid[top_t : top_t + TEMPLATE_SIZE, left_t : left_t + TEMPLATE_SIZE][template] = TEMPLATE_COLOR
+
+    blocked = np.zeros((h, w), dtype=bool)
