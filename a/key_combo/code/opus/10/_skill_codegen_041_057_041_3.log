+    assert len(seen_rotations) >= 3
+    expected = _manual_output(grid, template, placements)
+    actual = main(grid)
+    assert np.array_equal(actual, expected)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = int(_RNG.integers(18, 25))
+    w = int(_RNG.integers(18, 25))
