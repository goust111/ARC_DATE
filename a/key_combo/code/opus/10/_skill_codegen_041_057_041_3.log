+    for partial_coords, bbox in partials:
+        r0, c0, r1, c1 = bbox
+        assert (r1 - r0 + 1, c1 - c0 + 1) == (TEMPLATE_SIZE, TEMPLATE_SIZE)
+        observed = np.zeros((TEMPLATE_SIZE, TEMPLATE_SIZE), dtype=bool)
+        observed[partial_coords[:, 0] - r0, partial_coords[:, 1] - c0] = True
