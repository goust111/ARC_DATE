+            for r, c in controls:
+                grid[r, c] = CONTROL_COLOR
+            reserve_cells = [(r, c) for r in range(top, top + TEMPLATE_SIZE) for c in range(left, left + TEMPLATE_SIZE)]
+            reserve_cells.extend(controls)
+            _reserve(blocked, reserve_cells)
