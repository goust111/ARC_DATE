+    while len(pairs) < count:
+        a, b = random.sample(PALETTE, 2)
+        key = frozenset((a, b))
+        if key in used:
+            continue
+        used.add(key)
+        pairs.append((a, b))
+    random.shuffle(pairs)
+    return pairs
