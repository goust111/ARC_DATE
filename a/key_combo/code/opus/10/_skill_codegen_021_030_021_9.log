   186	    major_color, minor_color = (color_minor, color_major) if swapped else (color_major, color_minor)
   187	    for _ in range(SPRITE_ATTEMPTS):
   188	        h = random.randint(3, 4)
   189	        w = random.randint(3, 4)
   190	        if area > h * w or area < 5:
   191	            continue
   192	        mask = _random_connected_mask(h, w, area)
   193	        h2, w2 = mask.shape
   194	        if h2 > 4 or w2 > 4:
   195	            continue
