+
+    prepared: list[tuple[int, np.ndarray]] = []
+    for rec in records:
+        assert rec["colors"] in ref_map, "every sprite color pair must appear in the reference bar"
+        standard_major, standard_minor = ref_map[rec["colors"]]
+        if rotate_mode == "always":
