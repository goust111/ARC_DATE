+    hh, ww = occ.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    for r in range(r0, r0 + h):
+        for c in range(c0, c0 + w):
+            if int(patch[r - r0, c - c0]) == BG:
+                continue
+            for rr in range(max(0, r - 1), min(hh, r + 2)):
+                for cc in range(max(0, c - 1), min(ww, c + 2)):
+                    if occ[rr, cc]:
+                        return False
