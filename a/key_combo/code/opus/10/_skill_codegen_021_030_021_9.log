+
+    max_sprite_h = max(p.shape[0] for p in patches)
+    total_bbox_area = sum(p.shape[0] * p.shape[1] for p in patches)
+    if max_sprite_h > body_h - 1 or total_bbox_area > width * (body_h - 1):
