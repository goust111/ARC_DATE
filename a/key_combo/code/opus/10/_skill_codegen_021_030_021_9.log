+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+SPRITE_ATTEMPTS = 80
+PLACEMENT_ATTEMPTS = 80
