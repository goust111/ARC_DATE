+    color_major, color_minor = standard_pair
+    major_color, minor_color = (color_minor, color_major) if swapped else (color_major, color_minor)
+    for _ in range(SPRITE_ATTEMPTS):
+        h = random.randint(3, 4)
+        w = random.randint(3, 4)
