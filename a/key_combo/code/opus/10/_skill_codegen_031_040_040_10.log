+    for size in range(1, max_size):
+        next_shapes: set[tuple[tuple[int, int], ...]] = set()
+        for shape in shapes[size]:
+            cells = set(shape)
+            for r, c in shape:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) in cells:
