+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+PALETTE = (BLUE, RED, GREEN)
+MAX_ATTEMPTS = 400
+CELL_SIZE_RANGE = (4, 5)
+SHAPE_SIZE_RANGE = (2, 5)
+MAIN_ROWS = 3
+MAIN_COLS = 3
+DICT_ROWS = 1
+DICT_COLS = 3
