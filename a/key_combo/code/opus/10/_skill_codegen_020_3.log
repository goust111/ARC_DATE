+            raise AssertionError("each carrier band must contain exactly one diagonal segment")
+        local_coords = comps[0]
+        coords = local_coords.copy()
+        coords[:, 0] += r0
+        segment_color = int(g[coords[0, 0], coords[0, 1]])
