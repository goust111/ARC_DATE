+            cols = np.arange(length - 1, -1, -1, dtype=int)
+    return np.column_stack([rows, cols])
+
+
+def _shift_input_coords(moved: np.ndarray, carrier: int, gap: int) -> np.ndarray:
+    coords = moved.copy()
+    if carrier == BLUE:
+        coords[:, 1] -= int(gap)
+    else:
+        coords[:, 1] += int(gap)
+    return coords
+
