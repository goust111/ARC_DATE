+def _band_fill_mask(
+    r0: int,
+    r1: int,
+    width: int,
+    slope: str,
+    phase: int,
+) -> np.ndarray:
+    mask = np.zeros((r1 - r0 + 1, width), dtype=bool)
+    for rr, r in enumerate(range(r0, r1 + 1)):
+        cols = np.arange(width)
+        if slope == "down_right":
