+    h, w = g.shape
+    row_carriers = _row_carriers(g)
+    bands = _bands_from_rows(row_carriers)
+    out = g.copy()
+
+    global_slope: str | None = None
+    band_payloads: list[tuple[int, int, int, int, np.ndarray, str]] = []
+
+    for r0, r1, carrier in bands:
+        band = g[r0 : r1 + 1, :]
