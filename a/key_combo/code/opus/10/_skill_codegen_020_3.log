+    color_count = len({int(v) for v in np.unique(grid)} - {BLUE, TEAL})
+    return color_count == len(segments)
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+
+    for _ in range(400):
+        band_count = int(rng.integers(3, 5))
