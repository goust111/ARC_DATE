+        if carrier == BLUE:
+            cols = np.arange(width - length, width, dtype=int)
+        else:
+            cols = np.arange(0, length, dtype=int)
+    else:
+        if carrier == BLUE:
+            cols = np.arange(width - 1, width - length - 1, -1, dtype=int)
+        else:
+            cols = np.arange(length - 1, -1, -1, dtype=int)
+    return np.column_stack([rows, cols])
