+from __future__ import annotations
+
+import numpy as np
+
+
+BLUE = 1
+TEAL = 8
+NON_CARRIER_COLORS = (2, 3, 4, 5, 6, 7, 9)
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
