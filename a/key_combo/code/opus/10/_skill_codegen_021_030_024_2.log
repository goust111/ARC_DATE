+            if bar["color"] == BLUE:
+                blue_cov[r, c] += 1
+            else:
+                red_cov[r, c] += 1
+    out = np.full((h, w), BLACK, dtype=int)
+    out[(blue_cov > 0) & (red_cov == 0)] = BLUE
+    out[(red_cov > 0) & (blue_cov == 0)] = RED
+    out[(blue_cov > 0) & (red_cov > 0)] = GREEN
+    return out
