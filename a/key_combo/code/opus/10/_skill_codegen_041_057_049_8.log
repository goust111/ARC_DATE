+                if len(cells) < 2:
+                    continue
+                pairs = [(a, b) for i, a in enumerate(cells) for b in cells[i + 1 :] if abs(a[0] - b[0]) + abs(a[1] - b[1]) > 1]
+                random.shuffle(pairs)
