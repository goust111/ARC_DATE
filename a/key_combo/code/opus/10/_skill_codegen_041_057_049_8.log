+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in steps:
+                    nr = rr + dr
+                    nc = cc + dc
