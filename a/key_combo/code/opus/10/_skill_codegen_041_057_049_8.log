    per_color_pixels: 1-6 isolated single pixels (no two same-color pixels 4-adjacent)
    total_pixels: 2-14
    placement: scattered across grid, never on or 4-adjacent to grey object
  distance_rule:
    metric: minimum squared Euclidean distance from any marker pixel of that color to any grey pixel
    winner: unique color with smallest distance; gap to second-best >= 2
