+    h = int(pts[:, 0].max()) + 1
+    w = int(pts[:, 1].max()) + 1
+    patch = np.full((h, w), int(bg), dtype=int)
+    patch[pts[:, 0], pts[:, 1]] = int(color)
+    return patch
