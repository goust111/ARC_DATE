+
+def _candidate_source_invariants(shape: tuple[int, int], orientation: str) -> list[int]:
+    h, w = shape
+    if orientation == "main":
+        values = range(-(w - 1), h)
+    else:
+        values = range(h + w - 1)
+
+    candidates = []
+    for invariant in values:
