+            cr, cc2 = stack.pop()
+            comp.append((cr, cc2))
+            for dr, dc in _NEIGHBORS4:
+                nr = cr + dr
+                nc = cc2 + dc
+                if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
