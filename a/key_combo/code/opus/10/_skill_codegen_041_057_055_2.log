+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+MARKER = 6
+
+CANDIDATES = {
+    "A": {"minor": 1, "major": 2},
+    "B": {"minor": 4, "major": 7},
+}
+
+BLOCK_SIZE_CHOICES = (3, 4)
+BLOCK_ROWS_RANGE = (3, 5)
+BLOCK_COLS_RANGE = (3, 5)
