+            "block_rows": block_rows,
+            "block_cols": block_cols,
+            "block_size": block_size,
+            "categories": categories,
+            "sprites": sprites,
+            "target": target,
+            "all_target_damaged": all_target_damaged,
+            "grid_shape": grid.shape,
