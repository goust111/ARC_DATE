+            block_rows,
+            block_cols,
+            block_size,
+            categories,
+            sprites,
+            marked_copies,
+            add_separator_marks,
+        )
+        if not _has_unique_least_marker(grid):
+            continue
+
+        meta = {
+            "block_rows": block_rows,
+            "block_cols": block_cols,
+            "block_size": block_size,
+            "categories": categories,
+            "sprites": sprites,
+            "target": target,
+            "all_target_damaged": all_target_damaged,
