+    meta = {
+        "template_count": template_count,
+        "has_size_ambiguity": any(
+            a["size"] == b["size"] and a["border"] != b["border"]
+            for i, a in enumerate(chosen)
+            for b in chosen[i + 1 :]
+        ),
+        "has_color_ambiguity": any(
+            a["border"] == b["border"] and a["size"] != b["size"]
+            for i, a in enumerate(chosen)
+            for b in chosen[i + 1 :]
