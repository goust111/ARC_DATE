+    th, tw = template["size"]
+    candidates = []
+    for orow, ocol, side in template["openings"]:
+        gr = rect_r + orow
+        gc = rect_c + ocol
+        if side == "left":
+            mr, mc = gr, gc - 2
+        elif side == "right":
+            mr, mc = gr, gc + 2
+        elif side == "top":
+            mr, mc = gr - 2, gc
+        else:
