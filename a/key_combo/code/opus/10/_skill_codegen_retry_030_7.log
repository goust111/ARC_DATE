    pockets = _gen_extract_pockets(grid, top)
    if len(pockets) != arch_count:
        return None
    if any(
        len(pocket) < GEN_POCKET_CELLS_MIN or len(pocket) > GEN_POCKET_CELLS_MAX
        for pocket in pockets
    ):
        return None
    return grid, top, pockets



