+
+def _validate_semantics(
+    inp: np.ndarray,
+    out: np.ndarray,
+    templates: list[dict],
+    chamber_rects: list[tuple[tuple[int, int, int, int], dict]],
+    meta: dict,
+) -> bool:
+    baseline = _flood_only_input(inp)
+    if np.array_equal(baseline, out):
