+    for rect_box, _tpl in chamber_rects:
+        r0, c0, r1, c1 = rect_box
+        if np.array_equal(baseline[r0 : r1 + 1, c0 : c1 + 1], out[r0 : r1 + 1, c0 : c1 + 1]):
