+
+def _flood_only_input(grid: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    h, w = out.shape
+    for sr, sc in np.argwhere(out == MARKER):
+        sr = int(sr)
+        sc = int(sc)
+        queue = deque([(sr, sc)])
+        seen = {(sr, sc)}
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in neighbors(r, c, 4):
+                if not (0 <= nr < h and 0 <= nc < w):
