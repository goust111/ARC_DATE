+    if chamber_count <= len(templates):
+        rng.shuffle(idxs)
+        return idxs[:chamber_count]
+    pick = idxs[:]
+    pick.append(rng.choice(idxs))
+    rng.shuffle(pick)
+    return pick
+
+
+def _marker_position(
+    chamber_h: int,
+    chamber_w: int,
+    rect_r: int,
+    rect_c: int,
+    template: dict,
+    rng: random.Random,
+) -> tuple[int, int] | None:
+    th, tw = template["size"]
+    candidates = []
+    for orow, ocol, side in template["openings"]:
+        gr = rect_r + orow
+        gc = rect_c + ocol
+        if side == "left":
+            mr, mc = gr, gc - 2
+        elif side == "right":
+            mr, mc = gr, gc + 2
+        elif side == "top":
+            mr, mc = gr - 2, gc
+        else:
