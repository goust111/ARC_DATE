+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+WALL = 5
+MARKER = 6
+CATALOG_BG = 9
+
+PALETTE = (1, 2, 3, 4, 7, 8)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+DIR8 = DIR4 + ((1, 1), (1, -1), (-1, 1), (-1, -1))
+RETRY_LIMIT = 400
