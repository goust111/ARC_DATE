    path_fill: GREY (5)
  frame:
    shape: 3x3 ring of YELLOW with control-color center
    placement: center at least 1 cell from every edge; not adjacent to path (min gap >= 3 cells)
  path:
    structure: 4-axis-connected chain from a control-color pixel to a lone YELLOW pixel, with GREY pixels between
    length: 6-10 cells total (including both colored endpoints)
    turns: 0-2 direction changes; each segment is a cardinal straight run
    no overlap with frame; no adjacency to frame [observed]
  displacement:
    vector: (endpoint_row - control_row, endpoint_col - control_col); manhattan magnitude 4-9
    can be negative (frame moves up/left) or positive
  output:
    fill entire grid with control color
    place 3x3 YELLOW frame at (frame_center + displacement); center stays control color
    draw 4 diagonal YELLOW rays from frame corners outward to grid edges
  constraints:
    translated frame center must be >=1 cell from all edges
    exactly 2 control-color pixels, exactly 1 lone YELLOW pixel outside frame, >=1 GREY pixel

generation_strategy:
  approach: output-first
  steps:
