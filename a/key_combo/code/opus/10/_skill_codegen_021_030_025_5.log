+    col_choices = list(range(max_bar_col + 4, width - 3))
+    if not col_choices:
+        return None
+
+    above = [r for r in range(1, selected["top"] - 1)]
+    below = [r for r in range(selected["top"] + 2, height - 3)]
+    row_pools = [pool for pool in (above, below) if pool]
+    if not row_pools:
+        return None
