+    for color, coords in pieces:
+        grid[coords[:, 0], coords[:, 1]] = int(color)
+    return grid
+
+
+def _semantic_validate(grid: np.ndarray, *, want_out_of_bounds: bool, want_small_overlap: bool) -> bool:
+    try:
