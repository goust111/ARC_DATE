+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    axis_kind = rng.choice(["horizontal", "vertical"])
+    want_out_of_bounds = rng.random() < 0.5
+    want_small_overlap = rng.random() < 0.5
