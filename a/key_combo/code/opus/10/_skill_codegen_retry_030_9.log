+    assert np.all(grid[:, -1] == BLUE)
+    assert set(map(int, np.unique(grid))).issubset({BLACK, BLUE, RED, GREEN, GREY})
+
+    chambers = _component_stats(grid)
+    assert 4 <= len(chambers) <= 6
