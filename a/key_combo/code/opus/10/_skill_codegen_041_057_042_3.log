  grid: 7-17 rows x 7-17 cols, square, odd side length [observed]
  background: 8 [observed]
  base_line:
    color: 6 [observed]; single horizontal line spanning full grid width at row H//2
    composition: base_color fills all cells not occupied by bars on this row
  bars:
    count: 3-5 rectangular monochrome vertical bars, each crossing the base line
    shape: axis-aligned rectangle, width 1 or odd [observed], height 1-11
    symmetry: each bar UD-symmetric about base row (equal extent above/below) [observed, test_0 has one asymmetric bar]
    colors: each bar a distinct non-bg non-base color; two bars MAY share color if at different columns
    placement: bars occupy disjoint column ranges; gap >= 1 base-color column between adjacent bars
    height constraint: all bars fit within grid (max half-height < H//2)
    heights need not be all distinct (ties broken by size then position in solver)
  rule:
    sort bars by height (ascending); sort slots (bar positions) left-to-right
    assign i-th shortest bar shape to i-th leftmost slot, recoloring to slot's original color
    base line preserved; background fills the rest

generation_strategy:
  approach: output-first
  steps:
    1. Pick odd grid size N in [7,17]. Set H=W=N, base_row=N//2, bg=8, base_color=6.
    2. Choose num_bars in [3,5]. Pick that many distinct column anchors spaced >= 2 apart
       (to ensure gap >= 1 between width-1 bars). For wider bars, increase spacing.
