+            labels[r, c] = next_label
+            coords: list[tuple[int, int]] = []
+            touches = False
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                if cr in (0, h - 1) or cc in (0, w - 1):
