    edge_regions, enclosed_regions = _split_regions_by_edge(black_regions)
    if not (_range_ok(len(edge_regions), EDGE_REGION_RANGE) and _range_ok(len(enclosed_regions), ENCLOSED_REGION_RANGE)):
