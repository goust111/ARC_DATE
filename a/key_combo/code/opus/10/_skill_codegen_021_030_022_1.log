+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+TEMPLATE_SIZE = 3
+OUTER_RING_SIZE = 7
+MAX_GENERATION_ATTEMPTS = 400
+GRID_MIN = 17
+GRID_MAX = 20
+RING_COUNT_OPTIONS = (2, 3)
