MAX_DISTINCT_COLORS = 7
MAX_COLOR_REPEATS = 4

# Assignment scoring and retry limits.
CHEB_COST_WEIGHT = 10_000
KIND_COST_WEIGHT = 100
UNREACHABLE_COST = 10**9
