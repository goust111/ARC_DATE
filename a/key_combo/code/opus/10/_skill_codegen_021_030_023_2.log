+        stack = [(r0, c0)]
+        seen[r0, c0] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for nr, nc in _neighbors4(r, c):
