+
+
+def _frame_candidate(grid: np.ndarray, coords: np.ndarray, color: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != w or h < 4:
+        return None
+    if int(coords.shape[0]) != 4 * h - 4:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    perimeter = np.zeros_like(patch, dtype=bool)
+    perimeter[0, :] = True
+    perimeter[-1, :] = True
+    perimeter[:, 0] = True
+    perimeter[:, -1] = True
+    inner = patch[1:-1, 1:-1]
+    if inner.size == 0:
+        return None
+    if not np.all(patch[perimeter] == color):
+        return None
+    if np.any(inner == BG) or np.any(inner == color):
+        return None
+    if len(np.unique(inner)) < 2:
+        return None
+    return {
+        "color": int(color),
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "tile": inner.copy(),
+        "top": int(r0),
+        "left": int(c0),
+    }
