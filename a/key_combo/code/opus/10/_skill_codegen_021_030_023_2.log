+def _diamond_mask(shape: tuple[int, int], row: int, c0: int, c1: int) -> np.ndarray:
+    h, w = shape
+    length = int(c1 - c0 + 1)
+    radius = (length - 1) // 2
+    mask = np.zeros((h, w), dtype=bool)
+    for offset in range(radius + 1):
+        left = int(c0 + offset)
+        right = int(c1 - offset)
+        if left > right:
+            continue
+        for rr in (row - offset, row + offset):
+            if 0 <= rr < h:
+                mask[rr, left : right + 1] = True
+    return mask
+
