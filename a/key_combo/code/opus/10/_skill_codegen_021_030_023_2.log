+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    perimeter = np.zeros_like(patch, dtype=bool)
+    perimeter[0, :] = True
+    perimeter[-1, :] = True
+    perimeter[:, 0] = True
+    perimeter[:, -1] = True
+    inner = patch[1:-1, 1:-1]
+    if inner.size == 0:
+        return None
+    if not np.all(patch[perimeter] == color):
