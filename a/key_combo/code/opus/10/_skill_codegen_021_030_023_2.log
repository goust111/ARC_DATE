+    left_outer = max((outer_sizes[i] for i, corner in enumerate(corner_choices) if corner in {"tl", "bl"}), default=0)
+    right_outer = max((outer_sizes[i] for i, corner in enumerate(corner_choices) if corner in {"tr", "br"}), default=0)
