+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BOUNDARY = 5
+BAR_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    starts = np.argwhere(mask)
+    for r0, c0 in starts:
+        r0 = int(r0)
+        c0 = int(c0)
+        if seen[r0, c0]:
+            continue
+        stack = [(r0, c0)]
+        seen[r0, c0] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            r, c = stack.pop()
+            coords.append((r, c))
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bar_candidate(grid: np.ndarray, coords: np.ndarray, color: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h != 1 or w < 3 or int(coords.shape[0]) != w:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(patch == color):
+        return None
+    cells = {(int(r), int(c)) for r, c in coords}
+    gh, gw = grid.shape
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if not (0 <= nr < gh and 0 <= nc < gw):
+                continue
+            if (nr, nc) in cells:
+                continue
+            if int(grid[nr, nc]) != BG:
+                return None
+    return {"color": int(color), "row": int(r0), "c0": int(c0), "c1": int(c1), "length": int(w)}
+
+
+def _frame_candidate(grid: np.ndarray, coords: np.ndarray, color: int) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
