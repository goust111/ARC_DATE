+    inp, expected = built
+    scene = _extract_scene(inp)
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
+        return None
+    try:
+        _semantic_validate(inp, actual, scene)
+    except Exception:
+        return None
+    return inp
