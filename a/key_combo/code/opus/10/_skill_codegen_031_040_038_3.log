+def _semantic_output(grid: np.ndarray) -> np.ndarray:
+    legend, legend_mask = _find_legend(grid)
+    completed = _complete_gaps(grid, legend_mask)
+    out = completed.copy()
+    for region in _enclosed_regions(completed):
