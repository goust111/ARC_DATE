def _gen_path_is_valid(path, width):
    cells = set(path)
    degrees = [_gen_degree(cells, r, c, width) for r, c in cells]
    if any(deg < 1 or deg > 2 for deg in degrees):
        return False
    if degrees.count(1) != 2:
        return False

