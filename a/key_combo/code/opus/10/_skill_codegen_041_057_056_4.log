+                candidate = _place_related_rect(prev, new_h, new_w, corner, overlap_h, overlap_w)
+                r0, c0, h0, w0 = candidate
+                if r0 < 0 or c0 < 0 or r0 + h0 > grid_h or c0 + w0 > grid_w:
+                    continue
+                cells = _rect_cells(candidate)
+                if cells & forbidden:
