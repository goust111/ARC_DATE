+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+BRACKET_ORIENTATIONS = ("tl", "tr", "bl", "br")
+GEN_ATTEMPTS = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).flatten())).most_common(1)[0][0])
+
+
+def colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, np.unique(np.asarray(grid, dtype=int))))
+    if exclude:
+        colors -= set(exclude)
+    return sorted(colors)
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    if connectivity == 4:
+        nbrs = DIRS4
+    else:
+        nbrs = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in nbrs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _rect_cells(rect: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, h, w = rect
+    return {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+
+
+def _rect_intersection(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> tuple[int, int]:
+    ar0, ac0, ah, aw = a
+    br0, bc0, bh, bw = b
+    r0 = max(ar0, br0)
+    c0 = max(ac0, bc0)
+    r1 = min(ar0 + ah, br0 + bh)
+    c1 = min(ac0 + aw, bc0 + bw)
+    return max(0, r1 - r0), max(0, c1 - c0)
+
+
+def _place_related_rect(
+    base: tuple[int, int, int, int],
+    new_h: int,
+    new_w: int,
+    corner: str,
+    overlap_h: int,
+    overlap_w: int,
+) -> tuple[int, int, int, int]:
+    r0, c0, h, w = base
+    if corner == "tl":
+        nr = r0 - new_h + overlap_h
+        nc = c0 - new_w + overlap_w
+    elif corner == "tr":
+        nr = r0 - new_h + overlap_h
+        nc = c0 + w - overlap_w
+    elif corner == "bl":
+        nr = r0 + h - overlap_h
+        nc = c0 - new_w + overlap_w
+    elif corner == "br":
