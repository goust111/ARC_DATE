+
+def place_random_internal(shape: tuple[int, int], blocked: np.ndarray) -> dict | None:
+    h, w = shape
+    for _ in range(INTERNAL_RETRY_LIMIT):
+        local = sample_internal_shape(for_conflict=False)
+        lh, lw = local.shape
+        if h - lh - 1 < 1 or w - lw - 1 < 1:
+            continue
