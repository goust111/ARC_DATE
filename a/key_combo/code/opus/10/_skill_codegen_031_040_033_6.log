+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+ORANGE = 7
+TEAL = 8
+
+EDGE_RETRY_LIMIT = 120
+INTERNAL_RETRY_LIMIT = 180
+GEN_RETRY_LIMIT = 400
