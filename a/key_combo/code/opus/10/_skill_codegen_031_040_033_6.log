+        bottom = np.flatnonzero(obj_mask[bbox_coords(coords)[2], :])
+        left = np.flatnonzero(obj_mask[:, bbox_coords(coords)[1]])
+        right = np.flatnonzero(obj_mask[:, bbox_coords(coords)[3]])
+        if min(len(top), len(bottom), len(left), len(right)) < 3:
+            return False
+        ext_union |= ext
