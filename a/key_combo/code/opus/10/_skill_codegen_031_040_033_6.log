+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    fg_mask = g == TEAL
+    comps = _sorted_components(components_mask(fg_mask))
+    assert 3 <= len(comps) <= 5, "expected 3-5 teal objects"
+
+    out = np.zeros((h, w), dtype=int)
+    moving: list[np.ndarray] = []
+    stationary: list[np.ndarray] = []
+
+    for coords in comps:
