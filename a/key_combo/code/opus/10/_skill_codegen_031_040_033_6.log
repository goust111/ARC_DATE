+    if np.any(rows == h - 1):
+        sides.append("bottom")
+    if np.any(cols == 0):
+        sides.append("left")
+    if np.any(cols == w - 1):
+        sides.append("right")
+    if not sides:
+        return None
+    assert len(sides) == 1, "touching-edge objects must touch exactly one edge"
+    return sides[0]
