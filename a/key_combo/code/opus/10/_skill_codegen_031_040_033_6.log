+    ext_union = np.zeros(grid.shape, dtype=bool)
+    trail_union = np.zeros(grid.shape, dtype=bool)
+    conflict = np.zeros(grid.shape, dtype=bool)
+    for coords in internal_objs:
+        side = touching_edge_side(coords, grid.shape)
+        if side is not None:
