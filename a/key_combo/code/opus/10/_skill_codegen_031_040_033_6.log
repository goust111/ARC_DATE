+        dst = (r0, w - rect_w, r1, w - 1)
+        trail = np.zeros(shape, dtype=bool)
+        trail[r0 : r1 + 1, 0 : w - rect_w] = True
+    else:
+        assert side == "right"
+        dst = (r0, 0, r1, rect_w - 1)
+        trail = np.zeros(shape, dtype=bool)
+        trail[r0 : r1 + 1, rect_w:w] = True
