0031: def main(grid: np.ndarray) -> np.ndarray:
0032:     """Crop the main rectangle and orient it so its internal markers match the external marker arrangement.
0033: 
0034:     Input structure
0035:     A background canvas contains one filled rectangle of the dominant foreground color. Some non-base colors
0036:     are inside that rectangle; orientation marker colors occur exactly once inside the rectangle and exactly
0037:     once as an external pixel.
0038: 
0039:     Rule
0040:     Remove the background and external marker pixels by cropping to the base rectangle. Return the unique
0041:     rotation/reflection of that crop whose marker-color coordinates, normalized by their top-left marker
0042:     position, equal the normalized coordinates of the external marker pixels with the same colors.
0043: 
0044:     Key insight
0045:     The outside pixels are not copied into the output; their relative layout is an orientation legend for
0046:     the matching singleton colors embedded in the rectangle.
0047:     """
0048:     g = np.asarray(grid, dtype=int)
0049:     bg = get_bg(g)
0050: 
0051:     fg_counts = Counter(int(x) for x in g.ravel() if int(x) != bg)
0052:     assert fg_counts
0053:     largest = max(fg_counts.values())
0054:     base_colors = [color for color, count in fg_counts.items() if count == largest]
0055:     assert len(base_colors) == 1
0056:     base = base_colors[0]
0057: 
0058:     rect = bbox(g == base)
0059:     assert rect is not None
0060:     r0, c0, r1, c1 = rect
0061:     crop = g[r0 : r1 + 1, c0 : c1 + 1].copy()
0062:     assert crop.size > 0
0063:     assert not np.any(crop == bg)
0064: 
0065:     marker_inside: dict[int, tuple[int, int]] = {}
0066:     marker_outside: dict[int, tuple[int, int]] = {}
0067:     for color in colors_present(g, exclude={bg, base}):
0068:         inside = []
0069:         outside = []
0070:         for rr, cc in np.argwhere(g == color):
0071:             r = int(rr)
0072:             c = int(cc)
0073:             if r0 <= r <= r1 and c0 <= c <= c1:
0074:                 inside.append((r - r0, c - c0))
0075:             else:
0076:                 outside.append((r, c))
0077: 
0078:         if len(inside) == 1 and len(outside) == 1:
0079:             marker_inside[color] = inside[0]
0080:             marker_outside[color] = outside[0]
0081:         else:
0082:             assert len(outside) == 0
0083: 
0084:     assert len(marker_inside) >= 3
0085:     target_layout = _normalized(marker_outside)
0086: 
0087:     matches = []
0088:     for oriented in _orientations(crop):
0089:         oriented_markers = {}
0090:         for color in marker_inside:
0091:             locs = np.argwhere(oriented == color)
0092:             assert len(locs) == 1
0093:             oriented_markers[color] = (int(locs[0, 0]), int(locs[0, 1]))
0094:         if _normalized(oriented_markers) == target_layout:
0095:             matches.append(oriented)
0096: 
0097:     assert len(matches) == 1
0098:     return matches[0].copy()
0099: 
