0090: GEN_BACKGROUND_COLOR = 0
0091: GEN_FOREGROUND_COLORS, GEN_CYCLE_COUNTS = [1, 3, 5, 6, 7, 8, 9], [2, 3]
0092: GEN_CANVAS_ROW_RANGE, GEN_CANVAS_COL_RANGE = (12, 15), (13, 16)
0093: GEN_THREE_CYCLE_COUNT = 3
0094: 
