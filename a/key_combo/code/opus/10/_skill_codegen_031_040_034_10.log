+
+def _reserve(reserved: np.ndarray, top: int, left: int, h: int, w: int, pad: int) -> None:
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(reserved.shape[0], top + h + pad)
+    c1 = min(reserved.shape[1], left + w + pad)
