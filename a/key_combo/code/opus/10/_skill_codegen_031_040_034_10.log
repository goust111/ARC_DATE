0042:     # extracting a mask for the black region is tricky, because black is also the color of the background
0043:     # get the black region inside the object by getting the interior mask, then just the black pixels
0044:     interior_black_regions = [ object_interior(obj, background=Color.BLACK) & (obj == Color.BLACK)
0045:                                for obj in grey_objects ]
0046: 
0047:     not_grey_input = input_grid.copy()
0048:     not_grey_input[input_grid == Color.GREY] = Color.BLACK
0049:     not_grey_objects = find_components(not_grey_input, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0050: 
0051:     # Get the sprites
0052:     not_grey_sprites = []
0053:     for obj in not_grey_objects:
