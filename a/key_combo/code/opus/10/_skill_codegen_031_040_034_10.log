0061: def main(grid: np.ndarray) -> np.ndarray:
0062:     """
0063:     Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.
0064: 
0065:     Input structure
0066:     The grid is partitioned by black separator rows and columns into equal-size
0067:     square blocks. Each block is either a copy of one two-color sprite or a
0068:     uniform blank block of the sprite's minority color; grey pixels are erased
0069:     cells that act as wildcards.
0070: 
0071:     Rule
0072:     Infer the repeated sprite from fully visible mixed-color blocks. Replace a
0073:     block matching that sprite, ignoring grey erasures, with a solid block of
0074:     the sprite's majority color. Replace a uniform blank block with the sprite.
0075:     Separator rows and columns, including grey erasures on them, become black.
0076: 
0077:     Key insight
0078:     The small sprite is a block-level code for one macro-cell state, and the
0079:     uniform minority-color block is the other state; the output renders the
0080:     opposite code in each macro-cell while cleaning erased pixels.
0081:     """
0082:     g = np.asarray(grid, dtype=int)
0083:     H, W = g.shape
0084: 
0085:     row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]
0086:     col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]
0087:     row_intervals = _regular_intervals(row_separators, H)
0088:     col_intervals = _regular_intervals(col_separators, W)
0089:     block_heights = {r1 - r0 for r0, r1 in row_intervals}
0090:     block_widths = {c1 - c0 for c0, c1 in col_intervals}
