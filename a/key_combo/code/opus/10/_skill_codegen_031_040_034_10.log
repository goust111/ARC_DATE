+MARKER_TO_COLOR = {
+    (0, 0): GREEN,   # top-left missing
+    (0, 1): TEAL,    # top-right missing
+    (1, 0): YELLOW,  # bottom-left missing
+    (1, 1): PINK,    # bottom-right missing
