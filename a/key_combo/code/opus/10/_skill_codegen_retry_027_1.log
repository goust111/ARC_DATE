+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_dict(coords: list[tuple[int, int]]) -> dict | None:
+    r0, c0, r1, c1 = _bbox(coords)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if not (3 <= height <= 6 and 3 <= width <= 6):
+        return None
+    border = {
+        (r0, c) for c in range(c0, c1 + 1)
+    } | {
+        (r1, c) for c in range(c0, c1 + 1)
+    } | {
+        (r, c0) for r in range(r0, r1 + 1)
+    } | {
+        (r, c1) for r in range(r0, r1 + 1)
+    }
+    coord_set = set(coords)
+    if coord_set != border:
+        return None
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "border": border,
+        "height": height,
+        "width": width,
+    }
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    frames = []
+    for comp in _find_components_of_color(grid, FRAME):
+        frame = _frame_dict(comp)
+        if frame is None:
+            continue
+        frames.append(frame)
+    frames.sort(key=lambda frame: frame["bbox"])
+    return frames
+
