+            if frame_idx is None:
+                return None
+            if path:
+                endpoint = path[-1]
+            else:
+                endpoint = start
+            return {
+                "start": start,
+                "side": side,
+                "direction": (dr, dc),
+                "hit_cell": (rr, cc),
+                "frame_idx": frame_idx,
+                "distance": len(path),
+                "endpoint": endpoint,
+                "path": tuple(path),
