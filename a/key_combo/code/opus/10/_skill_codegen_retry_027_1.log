+    return markers
+
+
+def _ray_direction(shape: tuple[int, int], start: tuple[int, int]) -> tuple[int, int, str]:
+    h, w = shape
+    r, c = start
+    if r == 0:
+        return 1, 0, "top"
+    if r == h - 1:
+        return -1, 0, "bottom"
