spec:
  grid: 11-15 rows x 12-17 cols
  background: single dominant color (not black)
  body_color: one non-bg color with exactly 7*N pixels (N = number of markers)
  markers:
    count: 1-3, each a distinct singleton non-bg non-body color; black (0) never used in input
    directions: each marker has a unique cardinal direction; at most 4 markers
  sprite_shape: |
    fixed 7-body-pixel arrow around the marker center (M), 4 rotations:
      UP(-1,0):  ##M##    DOWN(1,0): .###.    LEFT(0,-1): #.    RIGHT(0,1): .#
                 .###.                ##M##                ##                  ##
                                                           M#                  #M
                                                           ##                  ##
                                                           #.                  .#
    body center-of-mass offset points AWAY from the ray direction
  placement:
    sprites do not overlap each other
    entire ray path (every cell from marker to boundary) must be bg
    target boundary row/col must be entirely bg
    sprite bbox must be >=1 cell from all 4 grid edges [observed]
  output_rule:
    paint marker color on every 2nd cell from marker outward (skip 1, paint 1) to boundary
    fill entire reached boundary row/col with marker color
    corners shared by two painted boundaries become black (0)
    original sprites unchanged

generation_strategy:
  approach: output-first
  steps:
    1. pick grid H x W in [11..15] x [12..17], bg color (non-black), body color (non-bg, non-black)
    2. pick N in [1..3]; choose N distinct non-bg non-body non-black marker colors and N distinct cardinal directions
