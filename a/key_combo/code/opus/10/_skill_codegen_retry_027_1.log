+    r, c = start
+    rr, cc = r + dr, c + dc
+    path: list[tuple[int, int]] = []
+    while 0 <= rr < h and 0 <= cc < w:
+        if int(grid[rr, cc]) == FRAME:
+            frame_idx = frame_at.get((rr, cc))
+            if frame_idx is None:
+                return None
+            if path:
+                endpoint = path[-1]
+            else:
+                endpoint = start
+            return {
+                "start": start,
+                "side": side,
+                "direction": (dr, dc),
+                "hit_cell": (rr, cc),
+                "frame_idx": frame_idx,
+                "distance": len(path),
+                "endpoint": endpoint,
+                "path": tuple(path),
+            }
