+    for snake in snakes:
+        color = int(snake["color"])
+        cells = snake["cells"]
+        for endpoint in _simple_path_endpoints(cells):
+            for ray in _endpoint_rays(g, cells, endpoint):
+                hit = ray["hit"]
+                if hit is None:
+                    continue
+                for rr, cc in ray["segment"]:
+                    out[rr, cc] = color
+                hr, hc = hit
+                out[hr, hc] = color
+                prev = hits.get(hit)
+                assert prev is None or prev == color
+                hits[hit] = color
