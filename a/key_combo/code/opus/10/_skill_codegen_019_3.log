+    for (hr, hc), color in hits.items():
+        r0 = max(0, hr - 1)
+        r1 = min(h, hr + 2)
+        c0 = max(0, hc - 1)
+        c1 = min(w, hc + 2)
+        out[r0:r1, c0:c1] = BAR
+        out[hr, hc] = color
