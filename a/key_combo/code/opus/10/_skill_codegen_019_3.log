_GEN_CAVITY_START_GAP = 3
_GEN_MIN_CAVITY_AREA = min(h * w for h, w in _GEN_CAVITY_DIMS)
_GEN_MAX_CAVITY_AREA = max(h * w for h, w in _GEN_CAVITY_DIMS)
_GEN_CAVITY_WIDTH_WEIGHT_POWER = 2

