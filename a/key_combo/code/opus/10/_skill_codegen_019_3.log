+BG = 0
+BAR = 5
+SNAKE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_ATTEMPTS = 400
