def _gen_attempt() -> np.ndarray | None:
    cell_rows, cell_cols = CELL_LAYOUTS[int(np.random.randint(0, len(CELL_LAYOUTS)))]
    first_r = int(np.random.randint(0, FIRST_MARKER_STOP))
