+    if kind == "H":
+        if width < 5:
+            return None
+        row = random.choice(usable_rows)
+        h_steps = random.randint(4, min(9, width - 1))
+        path = [(row, start_c)]
+        _append_line(path, 0, hdir, h_steps)
+        return path
+
+    if len(usable_rows) < 2:
+        return None
+
