+    v_steps = abs(row_b - row_a)
+    v_dir = 1 if row_b > row_a else -1
+
+    if kind in {"HV", "VH"}:
+        low = max(2, 4 - v_steps)
+        high = min(width - 1, 9 - v_steps)
+        if low > high:
+            return None
+        h_steps = random.randint(low, high)
