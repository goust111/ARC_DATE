+def _is_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if cells.size == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    seen = {start}
+    queue = deque([start])
+    h, w = mask.shape
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
