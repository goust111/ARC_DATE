+    if _is_degenerate(centered_patch):
+        return None
+
+    grid = _render_input(size, visible)
+    _validate_input_semantics(grid, active, half_h, half_w)
+
+    expected = _expected_output(size, local_masks)
+    actual = main(grid)
+    _validate_output_semantics(actual, expected)
+    return grid
