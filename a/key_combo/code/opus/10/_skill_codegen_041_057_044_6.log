        dest[nr0 : nr1 + 1, nc0 : nc1 + 1] = True
        assert not np.any(moved & dest), "translated slider rectangles must not overlap"
        moved |= dest
        out[nr0 : nr1 + 1, nc0 : nc1 + 1] = color

