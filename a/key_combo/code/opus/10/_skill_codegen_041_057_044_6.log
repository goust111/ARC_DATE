+    elif quadrant == "tr":
+        sub = grid[:center_r, center_c + 1 :] == BLUE
+    elif quadrant == "bl":
+        sub = grid[center_r + 1 :, :center_c] == BLUE
+    elif quadrant == "br":
+        sub = grid[center_r + 1 :, center_c + 1 :] == BLUE
+    else:
+        raise ValueError(f"unknown quadrant {quadrant}")
