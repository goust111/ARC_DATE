+
+    grid = np.full((height, width), BACKGROUND, dtype=int)
+    for top_left, branch in zip(positions, _branch_assignment(ring_count)):
+        corners, sides = _sample_groups(branch)
+        _place_ring(grid, top_left, corners, sides)
