    filled_mask = centers == filled
    counts = filled_mask.sum(axis=0)
    assert len(set(map(int, counts))) == n_cols, "expected unique filled-center counts"
    order = np.argsort(-counts)

    out = g.copy()
    out[np.ix_(center_rows, center_cols)] = centers[:, order]
    return out

