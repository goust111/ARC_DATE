def _gen_grid_from_centers(center_matrix: np.ndarray) -> np.ndarray:
    n = int(center_matrix.shape[0])
    h, w = ROW_STRIDE * n + GRID_EXTRA_ROWS, COL_STRIDE * n + GRID_EXTRA_COLS
