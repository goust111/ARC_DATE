    if b is None:
        return out
    r0, c0, r1, c1 = b
    out[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True
    return out


def bbox_union(bboxes: Iterable[BBox]) -> BBox | None:
    """Union of bboxes, or None for empty input."""
    bbs = list(bboxes)
    if not bbs:
