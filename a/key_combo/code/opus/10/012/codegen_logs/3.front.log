+    for rr in range(max(0, r - distance), min(h - 1, r + distance) + 1):
+        for cc in range(max(0, c - distance), min(w - 1, c + distance) + 1):
+            if max(abs(rr - r), abs(cc - c)) == distance:
+                cells.add((rr, cc))
