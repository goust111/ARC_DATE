+
+def _sample_distances(count: int, mode: str) -> list[int]:
+    def sample_extra() -> int:
+        return random.choices(DISTANCE_VALUES, weights=(4, 4, 3, 2), k=1)[0]
+
+    if mode == "same_distance_overlap":
