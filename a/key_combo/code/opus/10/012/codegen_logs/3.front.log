+        distances = [shared, shared]
+    elif mode == "different_distance_overlap":
+        distances = list(random.choice(((2, 3), (2, 4), (3, 4), (3, 5), (4, 5))))
+    else:
+        distances = []
+    distances.extend(sample_extra() for _ in range(count - len(distances)))
+    return distances
