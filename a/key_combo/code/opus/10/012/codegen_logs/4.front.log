_GEN_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
_GEN_COUNT_PAIRS = [
    (r, d)
    for r in range(_GEN_MAX_RIM_OBJECTS + 1)
    for d in range(_GEN_MAX_DISTRACTOR_OBJECTS + 1)
    if _GEN_MIN_TOTAL_OBJECTS <= r + d <= _GEN_MAX_TOTAL_OBJECTS
