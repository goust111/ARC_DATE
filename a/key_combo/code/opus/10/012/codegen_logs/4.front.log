# Placement and validation.
_GEN_RIM_SEPARATION_RADIUS = 2
_GEN_DISTRACTOR_SEPARATION_RADIUS = 1
_GEN_MIN_BLUE_PIXELS = 1
_GEN_MAX_BLUE_DENSITY_NUMERATOR = 1
_GEN_MAX_BLUE_DENSITY_DENOMINATOR = 2
