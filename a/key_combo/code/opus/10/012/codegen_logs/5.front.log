+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+GREY = 5
+OBJECT_COLORS = tuple(color for color in range(1, 10) if color != GREY)
+
+GRID_MIN = 13
+GRID_MAX = 18
+OBJECT_COUNT_CHOICES = (3, 4)
+EXPANDED_SIDE_MIN = 4
+EXPANDED_SIDE_MAX = 8
+DOT_COUNT_MIN = 2
+DOT_COUNT_MAX = 4
+WINNER_GREY_MAX = 2
+OTHER_GREY_MAX = 6
