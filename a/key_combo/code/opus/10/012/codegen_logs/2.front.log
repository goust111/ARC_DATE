  86:         assert shifted[prev_right_row, 0] != bg
  87:         out[:, c : c + group.shape[1]] = shifted
  88:         prev_right_row = _endpoint_row(shifted, bg, "right")
  89:         c += group.shape[1]
  90: 
  91:     return out
