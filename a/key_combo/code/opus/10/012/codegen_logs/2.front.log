  "summary": "Connect each same-colored pair of foreground pixels by filling the 45-degree diagonal segment between them.",
  "type": "move_along_path",
  "src": "pairs of same-colored foreground endpoint pixels s",
  "path": "strict 45-degree diagonal segment between the two endpoints of s",
  "trajectory": "paint s.color on every cell along the segment",
  "transform": "preserve all original pixels; only background cells on each path are filled"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10x10 [observed]
  background: 0
  endpoint_pairs:
    count: 3-5 distinct foreground colors, each appearing exactly twice
    colors: distinct non-zero colors
    diagonal: the two pixels of each color form a strict 45-degree diagonal (|dr|==|dc|, dr!=0)
    diagonal_length: 2-6 cells (distance = |dr|)
    direction: SE or SW (roughly equal mix) [observed]
  constraints:
    no_crossing: diagonal paths of different colors must not share any cell
    all_intermediate_cells_bg: every cell on each diagonal between endpoints is background in input
  output:
    same grid with each diagonal segment fully painted in its color (endpoints + all intermediate cells)

generation_strategy:
  approach: output-first (place full diagonals, then erase intermediates to get input)
  steps:
    1. Create 10x10 grid of background (0).
    2. Choose N=3-5 distinct non-zero colors.
    3. For each color, pick a random diagonal direction (SE or SW), length L=2-6.
    4. Place the full diagonal segment on the grid. Use rejection/retry per segment
       to ensure it stays in-bounds and does not overlap any previously placed segment.
    5. Record the output grid (all diagonals filled).
    6. To create the input, erase (set to background) all intermediate cells of each
       diagonal, keeping only the two endpoints per color.
```
