+            if count > q_height:
+                continue
+        else:
+            if branch != "vertical":
+                continue
+            if count > q_height:
+                continue
+
+        out = main(grid)
+        if np.array_equal(grid, out):
+            continue
+        if np.count_nonzero(out == GREY) != np.count_nonzero(grid == GREY):
+            continue
+        if int(fg_mask.sum()) != count:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle 9 input")

