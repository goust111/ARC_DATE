+        row_side = random.choice(["top", "bottom"])
+        quadrant = ("t" if row_side == "top" else "b") + ("l" if side == "left" else "r")
+        grid = _build_grid(height, width, sep_r, sep_c, quadrant, count)
+        if grid is not None:
+            return grid
+    return None
