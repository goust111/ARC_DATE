+        bbox_c1 = c + box_w - 1
+        row_gap_ok = bbox_r1 <= sep_r - 2 if quadrant in ("tl", "tr") else r >= sep_r + 2
+        col_gap_ok = bbox_c1 <= sep_c - 2 if quadrant in ("tl", "bl") else c >= sep_c + 2
