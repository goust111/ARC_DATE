+        col = _middle(c0, c1)
+        if quadrant in ("tl", "tr"):
+            rows = np.arange(sep_r - count, sep_r)
+        else:
+            rows = np.arange(sep_r + 1, sep_r + count + 1)
+        mirror_rows = 2 * sep_r - rows
