+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        branch = random.choice(["horizontal", "vertical"])
+        grid = _gen_horizontal_case() if branch == "horizontal" else _gen_vertical_case()
+        if grid is None:
