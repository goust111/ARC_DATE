+    rows, cols = np.where(comp_mask)
+    for r0, c0 in zip(rows, cols):
+        r, c = int(r0), int(c0)
+        if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+            continue
+        if comp_mask[r - 1 : r + 2, c - 1 : c + 2].all():
+            support.add((r, c))
+    return support
