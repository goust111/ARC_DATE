# Colors used by the fixed 692cd3b6 object/corridor vocabulary.
GEN_BG, GEN_FRAME, GEN_MARKER, GEN_FILL = Color.BLACK, Color.RED, Color.GREY, Color.YELLOW

# Canvas and frame geometry.
