+
+def _fill_triangle(
+    canvas_size: int,
+    corner: str,
+    bg: int,
+    outline_color: int,
+    motif: np.ndarray,
+    horiz_len: int,
+    vert_len: int,
+) -> np.ndarray:
+    outline, _h_end, _v_end = _triangle_outline(canvas_size, corner, horiz_len, vert_len)
+    out = np.full((canvas_size, canvas_size), int(bg), dtype=int)
+    for r, c in outline:
