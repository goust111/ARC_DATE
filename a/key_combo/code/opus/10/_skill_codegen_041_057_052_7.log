+    if corner == "TR":
+        return 0, size - 1
+    if corner == "BL":
+        return size - 1, 0
+    assert corner == "BR"
+    return size - 1, size - 1
+
+
+def _oriented_offsets(corner: str, size: int, r: int, c: int) -> tuple[int, int]:
+    vr, vc = _corner_vertex(corner, size)
+    if corner == "TL":
+        return r - vr, c - vc
+    if corner == "TR":
+        return r - vr, vc - c
+    if corner == "BL":
