+def _interior_mask(size: int, outline: set[tuple[int, int]]) -> np.ndarray:
+    exterior = np.zeros((size, size), dtype=bool)
+    blocked = np.zeros((size, size), dtype=bool)
+    for r, c in outline:
+        blocked[r, c] = True
+
+    q: deque[tuple[int, int]] = deque()
+    for r in range(size):
+        for c in (0, size - 1):
+            if not blocked[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+    for c in range(size):
+        for r in (0, size - 1):
+            if not blocked[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < size and 0 <= nc < size and not blocked[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                q.append((nr, nc))
