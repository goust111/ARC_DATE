+        assert np.all(grid[:vert, w - 1] == color) and np.all(grid[0, : w - horiz] == bg)
+        expected = np.zeros_like(grid, dtype=bool)
+        expected[0, w - horiz :] = True
+        expected[:vert, w - 1] = True
+    elif corner == "BL":
