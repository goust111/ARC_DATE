+def _build_input(
+    size: int,
+    corner: str,
+    l_color: int,
+    horiz_len: int,
+    vert_len: int,
+    motif: np.ndarray,
+    motif_r0: int,
+    motif_c0: int,
+) -> np.ndarray:
