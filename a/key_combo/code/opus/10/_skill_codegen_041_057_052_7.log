+        vert = int(np.count_nonzero(grid[:, w - 1] == color))
+        assert np.all(grid[h - 1, w - horiz :] == color) and np.all(grid[: h - vert, w - 1] == bg)
+        assert np.all(grid[h - vert :, w - 1] == color) and np.all(grid[h - 1, : w - horiz] == bg)
