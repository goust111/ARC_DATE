+    side_v = 2 * vert_len
+    vr, vc = _corner_vertex(corner, canvas_size)
+
+    if corner == "TL":
+        h_end = (vr, vc + side_h)
+        v_end = (vr + side_v, vc)
+        leg_h = {(vr, c) for c in range(vc, vc + side_h + 1)}
+        leg_v = {(r, vc) for r in range(vr, vr + side_v + 1)}
