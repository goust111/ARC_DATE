+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+WALL = 6
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TARGET_COLORS = (BLUE, RED)
