+    reachable: dict[tuple[int, int], tuple[int, ...]] = {}
+    assigned: dict[tuple[int, int], int] = {}
+    for cell in candidates + isolated:
+        r, c = cell
+        lab = int(labels[r, c])
+        reach = []
+        if lab >= 0:
