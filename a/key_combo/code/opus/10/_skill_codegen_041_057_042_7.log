+    grid[blue_wall_r, : wall_c + 1] = WALL
+    grid[red_wall_r, wall_c:] = WALL
+
+    for center, color in ((blue_center, BLUE), (red_center, RED)):
+        cr, cc = center
+        grid[cr, cc] = color
