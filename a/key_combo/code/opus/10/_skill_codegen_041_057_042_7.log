+            continue
+        d_self = abs(cell[0] - centers[color][0]) + abs(cell[1] - centers[color][1])
+        d_other = abs(cell[0] - centers[other[color]][0]) + abs(cell[1] - centers[other[color]][1])
+        if d_other < d_self:
