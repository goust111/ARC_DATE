+
+def grow_blob(
+    grid: np.ndarray,
+    allowed: set[tuple[int, int]],
+    size: int,
+    *,
+    seed_pool: set[tuple[int, int]] | None = None,
+    tries: int = 80,
+) -> list[tuple[int, int]] | None:
+    if seed_pool is None:
+        seed_pool = allowed
+    starts = [cell for cell in seed_pool if free_for_blob(grid, cell[0], cell[1], set())]
