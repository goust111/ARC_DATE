+def free_for_blob(grid: np.ndarray, r: int, c: int, blob: set[tuple[int, int]]) -> bool:
+    if grid[r, c] != BLACK:
+        return False
+    for nr, nc in neighbors4(r, c):
+        if in_bounds(grid.shape, nr, nc) and grid[nr, nc] == GREEN and (nr, nc) not in blob:
+            return False
+    return True
