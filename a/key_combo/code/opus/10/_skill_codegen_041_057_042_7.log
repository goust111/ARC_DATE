+
+def region_sets(
+    grid: np.ndarray,
+) -> tuple[
+    dict[int, tuple[int, int]],
+    dict[str, set[tuple[int, int]]],
+    dict[tuple[int, int], tuple[int, ...]],
+]:
+    centers = detect_targets(grid)
+    slots_by_color = {color: set(target_slots(center)) for color, center in centers.items()}
+    passable = grid == BLACK
