+def sorted_cells(
+    cells: set[tuple[int, int]],
+    center: tuple[int, int],
+) -> list[tuple[int, int]]:
+    return sorted(cells, key=lambda cell: (abs(cell[0] - center[0]) + abs(cell[1] - center[1]), cell[0], cell[1]))
