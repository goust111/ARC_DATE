            if size >= far_budget:
                far_sizes = [far_budget]
                near_sizes[i] = size - far_budget
                break
    near_sizes = [size for size in near_sizes if size > 0]
    return near_sizes, far_sizes

for _ in range(300):
    grid = mod.build_layout()
    centers, regions, _reach_by_cell = mod.region_sets(grid)
    blue_only = regions['blue_only']
    red_only = regions['red_only']
    both = regions['both']
    neither = regions['neither']
    if len(blue_only) < 20 or len(red_only) < 20:
        ctr['small_regions'] += 1
        continue
    blue_cross = {
        cell
        for cell in blue_only
        if cell[1] > centers[mod.RED][1] - 1
        and abs(cell[0] - centers[mod.RED][0]) + abs(cell[1] - centers[mod.RED][1])
        < abs(cell[0] - centers[mod.BLUE][0]) + abs(cell[1] - centers[mod.BLUE][1])
    }
    red_cross = {
        cell
        for cell in red_only
        if cell[1] < centers[mod.BLUE][1] + 1
        and abs(cell[0] - centers[mod.BLUE][0]) + abs(cell[1] - centers[mod.BLUE][1])
        < abs(cell[0] - centers[mod.RED][0]) + abs(cell[1] - centers[mod.RED][1])
    }
    if len(blue_cross) < 4 or len(red_cross) < 4:
        ctr['cross_shortage'] += 1
        continue
    blue_sorted = mod.sorted_cells(blue_only, centers[mod.BLUE])
    red_sorted = mod.sorted_cells(red_only, centers[mod.RED])
    blue_far = set(blue_sorted[max(8, len(blue_sorted) // 2):])
    red_far = set(red_sorted[max(8, len(red_sorted) // 2):])
    blue_near = set(blue_sorted[:max(20, len(blue_sorted) // 2)])
    red_near = set(red_sorted[:max(20, len(red_sorted) // 2)])
    blue_total = random.choice([8, 9, 10])
    red_total = random.choice([8, 9, 10])
    if blue_total == 8 and red_total == 8:
        if random.random() < 0.5:
            blue_total = 9
        else:
            red_total = 9
    blue_sizes = mod.random_partition(blue_total - 2)
    red_sizes = mod.random_partition(red_total - 2)
    if blue_sizes is None or red_sizes is None:
        ctr['partition'] += 1
        continue
    random.shuffle(blue_sizes)
    random.shuffle(red_sizes)
    blob = mod.grow_blob(grid, blue_cross, 2, seed_pool=blue_cross)
    if blob is None:
        ctr['blue_cross_blob'] += 1
        continue
    for r,c in blob:
        grid[r,c] = mod.GREEN
    blob = mod.grow_blob(grid, red_cross, 2, seed_pool=red_cross)
    if blob is None:
        ctr['red_cross_blob'] += 1
        continue
    for r,c in blob:
        grid[r,c] = mod.GREEN
    blue_near_sizes, blue_far_sizes = split_sizes(blue_sizes, 2 if blue_total > 8 else 0)
    red_near_sizes, red_far_sizes = split_sizes(red_sizes, 2 if red_total > 8 else 0)
    if mod.place_blob_group(grid, blue_near_sizes, blue_near, blue_only) is None:
        ctr['blue_near_place'] += 1
        continue
    if mod.place_blob_group(grid, red_near_sizes, red_near, red_only) is None:
        ctr['red_near_place'] += 1
        continue
    if mod.place_blob_group(grid, blue_far_sizes, blue_far, blue_only) is None:
        ctr['blue_far_place'] += 1
        continue
    if mod.place_blob_group(grid, red_far_sizes, red_far, red_only) is None:
        ctr['red_far_place'] += 1
        continue
    near_iso_candidates = sorted(
        [cell for cell in blue_only | red_only | both if min(abs(cell[0]-centers[mod.BLUE][0])+abs(cell[1]-centers[mod.BLUE][1]), abs(cell[0]-centers[mod.RED][0])+abs(cell[1]-centers[mod.RED][1])) <= 4],
        key=lambda cell: (min(abs(cell[0]-centers[mod.BLUE][0])+abs(cell[1]-centers[mod.BLUE][1]), abs(cell[0]-centers[mod.RED][0])+abs(cell[1]-centers[mod.RED][1])), cell[0], cell[1])
    )
    if not mod.place_isolated(grid, near_iso_candidates, 1):
        ctr['near_iso'] += 1
        continue
    all_black = [(r,c) for r in range(grid.shape[0]) for c in range(grid.shape[1]) if grid[r,c] == mod.BLACK]
    random.shuffle(all_black)
    if not mod.place_isolated(grid, all_black, random.choice([2,3])):
        ctr['other_iso'] += 1
        continue
    out = mod.main(grid)
    if mod.semantic_checks(grid, out):
        ctr['success'] += 1
    else:
        ctr['semantic_fail'] += 1
print(ctr)
