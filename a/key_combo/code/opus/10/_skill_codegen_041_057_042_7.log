+    for color in TARGET_COLORS:
+        center = centers[color]
+        chosen_by_color[color].sort(
+            key=lambda cell: (
+                abs(cell[0] - center[0]) + abs(cell[1] - center[1]),
+                cell[0],
+                cell[1],
+            )
+        )
