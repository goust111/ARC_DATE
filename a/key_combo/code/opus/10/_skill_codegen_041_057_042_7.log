+def analyze_candidates(
+    grid: np.ndarray,
+) -> tuple[
+    dict[int, tuple[int, int]],
+    dict[int, list[tuple[int, int]]],
+    list[tuple[int, int]],
+    dict[tuple[int, int], tuple[int, ...]],
+    dict[tuple[int, int], int],
+]:
