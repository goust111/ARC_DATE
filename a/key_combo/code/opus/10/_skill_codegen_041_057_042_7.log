+    random.shuffle(stub_choices)
+    for sr, sc, axis, length in stub_choices[: random.randint(1, 3)]:
+        for k in range(length):
+            rr = sr + (k if axis == 0 else 0)
+            cc = sc + (0 if axis == 0 else k)
