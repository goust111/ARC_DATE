+def neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def target_slots(center: tuple[int, int]) -> list[tuple[int, int]]:
+    cr, cc = center
+    slots = []
+    for r in range(cr - 1, cr + 2):
+        for c in range(cc - 1, cc + 2):
+            if (r, c) != center:
+                slots.append((r, c))
+    return slots
+
+
+def component_coords(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def label_passable(mask: np.ndarray) -> tuple[np.ndarray, dict[int, list[tuple[int, int]]]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    groups: dict[int, list[tuple[int, int]]] = {}
+    nxt = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] >= 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = nxt
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] < 0:
+                        labels[nr, nc] = nxt
+                        q.append((nr, nc))
+            groups[nxt] = cells
+            nxt += 1
+    return labels, groups
+
