+        (bottom_gap - 1, wall_c - 3, 0, random.randint(2, 3)),
+        (blue_wall_r - 2, max(1, wall_c - 4), 1, random.randint(2, 3)),
+        (red_wall_r + 1, min(w - 2, wall_c + 4), 1, random.randint(2, 3)),
