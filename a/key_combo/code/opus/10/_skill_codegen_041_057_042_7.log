+    return grid
+
+
+def region_sets(
+    grid: np.ndarray,
+) -> tuple[
+    dict[int, tuple[int, int]],
+    dict[str, set[tuple[int, int]]],
+    dict[tuple[int, int], tuple[int, ...]],
+]:
