+def random_partition(total: int, *, lo: int = 2, hi: int = 4) -> list[int] | None:
+    if total == 0:
+        return []
+
+    options: list[list[int]] = []
+
+    def rec(rem: int, current: list[int]) -> None:
+        if rem == 0:
+            options.append(current[:])
+            return
+        for size in range(lo, hi + 1):
+            if size > rem:
+                continue
+            if rem - size == 1:
+                continue
+            current.append(size)
+            rec(rem - size, current)
+            current.pop()
