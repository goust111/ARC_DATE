+                break
+            if grid[rr, cc] != BLACK:
+                break
+            blocked = False
+            for center in (blue_center, red_center):
+                if abs(rr - center[0]) <= 1 and abs(cc - center[1]) <= 1:
+                    blocked = True
+                    break
+            if blocked:
+                break
+            grid[rr, cc] = WALL
+
