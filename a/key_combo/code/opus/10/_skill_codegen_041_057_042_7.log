+def semantic_checks(inp: np.ndarray, out: np.ndarray) -> bool:
+    centers, slots_by_color, isolated, reachable, assigned = analyze_candidates(inp)
+    if len(isolated) < 3:
+        return False
+
+    for color, center in centers.items():
+        if inp[center] != color:
