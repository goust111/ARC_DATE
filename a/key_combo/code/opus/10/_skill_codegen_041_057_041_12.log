+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            color = int(grid[r, c])
+            if color in (BLACK, GREY):
+                continue
+            groups[color].append((r, c))
+    return groups
+
+
