+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+
+
+def _dash_period(length: int) -> int:
+    return 2 + (int(length) % 3)
+
+
