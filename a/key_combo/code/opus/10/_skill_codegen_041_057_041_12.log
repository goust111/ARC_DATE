+        elif c1 == c2 and {r1, r2} == {0, h - 1} and np.all(g[1 : h - 1, c1] == BLACK):
+            corridors.append(
+                {
+                    "color": int(color),
+                    "axis": 1,  # vertical
+                    "anchor": int(c1),
+                    "length": int(h - 2),
+                }
+            )
+    return corridors
