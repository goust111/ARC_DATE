+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    corridors: list[dict[str, int]] = []
+    for color, coords in sorted(_border_marker_groups(g).items()):
+        if len(coords) != 2:
+            continue
+        (r1, c1), (r2, c2) = sorted(coords)
+        if r1 == r2 and {c1, c2} == {0, w - 1} and np.all(g[r1, 1 : w - 1] == BLACK):
