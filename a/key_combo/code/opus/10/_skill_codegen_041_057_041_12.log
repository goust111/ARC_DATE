+    h, w = map(int, shape)
+    free = np.ones((h, w), dtype=bool)
+    free[0, :] = False
+    free[h - 1, :] = False
+    free[:, 0] = False
+    free[:, w - 1] = False
+    for r in rows:
+        free[r, 1 : w - 1] = False
+    for c in cols:
+        free[1 : h - 1, c] = False
+    return free
+
