+    for color, coords in sorted(_border_marker_groups(g).items()):
+        if len(coords) != 2:
+            continue
+        (r1, c1), (r2, c2) = sorted(coords)
+        if r1 == r2 and {c1, c2} == {0, w - 1} and np.all(g[r1, 1 : w - 1] == BLACK):
+            corridors.append(
+                {
+                    "color": int(color),
+                    "axis": 0,  # horizontal
+                    "anchor": int(r1),
+                    "length": int(w - 2),
+                }
+            )
+        elif c1 == c2 and {r1, r2} == {0, h - 1} and np.all(g[1 : h - 1, c1] == BLACK):
+            corridors.append(
+                {
+                    "color": int(color),
+                    "axis": 1,  # vertical
+                    "anchor": int(c1),
+                    "length": int(h - 2),
+                }
+            )
