  "type": "symmetry/pattern",
  "src": "colored marker pixels placed in two or more grid corners",
  "transform": "fill each cell from its unique nearest marker by squared Euclidean distance; tied cells stay background, and uniquely owned cells take the marker color only on even Chebyshev-distance square rings"
}
</annotation>
<generation_spec>
