+def _trace_cycle(coords: np.ndarray) -> list[tuple[int, int]]:
+    pts = {tuple(map(int, cell)) for cell in coords}
+    for r, c in pts:
+        degree = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        assert degree == 2, (r, c, degree)
