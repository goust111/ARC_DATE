+    _append_line(path, 0, width - 1, height - 1, width - 1)
+    _append_line(path, height - 1, width - 1, height - 1, 0)
+    _append_line(path, height - 1, 0, 0, 0)
+    if path[-1] == path[0]:
+        path.pop()
+    return path
