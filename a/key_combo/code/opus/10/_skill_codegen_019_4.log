+
+    loop_components = _extract_components(patch == GREY)
+    assert len(loop_components) == 1
+    actual_count = _convex_corner_count(_trace_cycle(loop_components[0]))
+    assert actual_count == convex_count, (actual_count, convex_count)
+
+    return patch
