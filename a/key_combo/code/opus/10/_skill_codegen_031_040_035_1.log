   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Fill the empty upper half with a vertical mirror of the lower-half pattern.
  11: 
  12:     Input structure
  13:     The grid has even height. The upper half is entirely background, and the
  14:     lower half contains the foreground pattern to be completed.
  15: 
  16:     Rule
  17:     Copy the lower half into the upper half after reversing its row order.
  18:     Leave the original lower half unchanged.
  19: 
  20:     Key insight
  21:     The blank upper region is the missing reflected counterpart of the visible
  22:     lower region.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     assert g.ndim == 2, "expected a 2D grid"
  26:     height, _ = g.shape
  27:     assert height % 2 == 0, "expected an even-height grid"
  28: 
  29:     bg = get_bg(g)
  30:     mid = height // 2
  31:     assert np.all(g[:mid] == bg), "expected the upper half to be background"
  32:     assert np.any(g[mid:] != bg), "expected a nonempty lower-half pattern"
  33: 
  34:     out = g.copy()
  35:     out[:mid] = g[mid:][::-1]
  36:     return out
  37: 
  38: # --------------- generator (o5x) ---------------
  39: # Canvas/object size bounds.
  40: HEIGHT_CHOICES, WIDTH_MIN, WIDTH_MAX, BACKGROUND = [6, 8, 10, 12, 14], 3, 5, 0
  41: # Color assignment bounds.
  42: FOREGROUND_COLORS, COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE = np.arange(1, 10), 3, 5
  43: # Secondary-color mutation bounds.
  44: SECONDARY_COL_MAX, SECONDARY_DEPTH_MAX = 2, 2
  45: # Retry limit.
  46: MAX_ATTEMPTS = 300
  47: 
  48: def _sample_layout():
  49:     """Return dimensions and shuffled distinct lower-half bar heights."""
  50:     height = int(np.random.choice(HEIGHT_CHOICES))
  51:     half = height // 2
  52:     width = int(np.random.randint(WIDTH_MIN, min(WIDTH_MAX, half) + 1))
  53:     heights = list(np.random.choice(np.arange(1, half), size=width - 1, replace=False))
  54:     heights.append(half)
  55:     return height, half, width, [int(v) for v in np.random.permutation(heights)]
  56: 
  57: def _assign_primary_colors(width):
  58:     """Return primary colors by column plus unused colors needing coverage."""
  59:     color_count = int(np.random.randint(COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE))
  60:     colors = [int(v) for v in np.random.choice(FOREGROUND_COLORS, size=color_count, replace=False)]
  61:     cols = [int(v) for v in np.random.permutation(width)]
  62:     primary = [None] * width
  63:     for col, color in zip(cols, colors):
  64:         primary[col] = color
  65:     if width >= color_count:
  66:         for col in cols[color_count:]:
  67:             primary[col] = int(np.random.choice(colors))
  68:         return primary, colors, []
  69:     return primary, colors, colors[width:]
  70: 
  71: def _paint_lower_half(half, width, heights, primary, colors, unused_colors):
  72:     """Render the lower half, or return None when constraints cannot fit."""
  73:     lower = np.zeros((half, width), dtype=int)
  74:     for col, bar_height in enumerate(heights):
  75:         lower[half - bar_height :, col] = primary[col]
  76:     eligible = [col for col, bar_height in enumerate(heights) if 2 <= bar_height < half]
  77:     max_two_color = min(SECONDARY_COL_MAX, (width - 1) // 2, len(eligible))
  78:     need_two_color = 1 if unused_colors else 0
  79:     if max_two_color < need_two_color:
  80:         return None
  81:     two_color_count = int(np.random.randint(need_two_color, max_two_color + 1))
  82:     if not two_color_count:
  83:         return lower
  84:     two_color_cols = [int(v) for v in np.random.choice(eligible, size=two_color_count, replace=False)]
  85:     shared_second = unused_colors[0] if unused_colors else int(np.random.choice(colors))
  86:     for col in two_color_cols:
  87:         choices = [c for c in colors if c != primary[col]]
  88:         second = shared_second if shared_second != primary[col] else int(np.random.choice(choices))
  89:         depth = int(np.random.randint(1, min(SECONDARY_DEPTH_MAX, heights[col] - 1) + 1))
  90:         lower[half - depth :, col] = second
  91:     return lower
  92: 
  93: def _gen_attempt() -> np.ndarray | None:
  94:     height, half, width, heights = _sample_layout()
  95:     primary, colors, unused_colors = _assign_primary_colors(width)
  96:     lower = _paint_lower_half(half, width, heights, primary, colors, unused_colors)
  97:     if lower is None:
  98:         return None
  99:     out = np.zeros((height, width), dtype=int)
 100:     out[half:], out[:half] = lower, lower[::-1]
 101:     inp = out.copy()
 102:     inp[:half] = BACKGROUND
 103:     return inp if np.array_equal(main(inp), out) else None
 104: 
 105: def generate_input() -> np.ndarray:
 106:     for _ in range(MAX_ATTEMPTS):
 107:         grid = _gen_attempt()
 108:         if grid is not None:
 109:             return grid
 110:     raise RuntimeError(f"generate_input: failed after {MAX_ATTEMPTS} attempts")
