+def _mirror_complete(clean: np.ndarray) -> np.ndarray:
+    out = np.asarray(clean, dtype=int).copy()
+    mask = out == RED
+    box = _bbox(mask)
+    if box is None:
+        return out
+    _r0, left, _r1, right = box
+    coords = np.argwhere(mask)
+    for r, c in coords:
