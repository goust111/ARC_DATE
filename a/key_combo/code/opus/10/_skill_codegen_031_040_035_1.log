   7: # concepts:
   8: # denoising, topology
   9: 
  10: # description:
  11: # In the input you will see a black background with large rectangles of the same color, and random "noise" pixels added at random locations, in the same color as the rectangles.
  12: # To make the output, remove the noise pixels, leaving only the big rectangles.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Remove isolated same-color noise pixels while leaving large rectangles intact.
  17: 
  18:     Input structure:
  19:     - The input is a black grid with large rectangles.
  20:     - Rectangles and noise pixels share the same non-black color.
  21:     - Noise pixels have weak local support compared with rectangle pixels.
  22: 
  23:     Rule:
  24:     - Visit every non-black pixel.
  25:     - Count its non-black 4-neighbors.
  26:     - Keep pixels with at least two colored neighbors and turn the rest black.
  27: 
  28:     Key insight:
  29:     - Rectangle pixels have enough adjacent support, while isolated random noise does not.
  30:     """
  31:     # Plan:
  32:     # 1. Find the neighbors of each pixel
  33:     # 2. If its neighbors are mostly colored (>=2 neighbors), it's part of a rectangle
  34:     # 3. Otherwise, it's noise, so delete it
  35: 
  36:     output_grid = np.copy(input_grid)
  37: 
  38:     for r, c in np.argwhere(input_grid != Color.BLACK):
  39:         # Turn this single pixel into an object, and get its neighbors
  40:         obj = np.full(input_grid.shape, Color.BLACK)
  41:         obj[r, c] = input_grid[r, c]
  42:         neighbors_mask = object_neighbors(obj, connectivity=4, background=Color.BLACK)
  43: 
  44:         # If the object has at least 2 colored neighbors, then it is part of a rectangle. Otherwise, it is noise, so delete it.
  45:         colors_of_neighbors = input_grid[neighbors_mask]
  46:         if np.sum(colors_of_neighbors != Color.BLACK) >= 2:
  47:             # has at least 2 colored neighbors, so it's part of a rectangle
  48:             pass
  49:         else:
  50:             # doesn't have at least 2 colored neighbors, so delete it
  51:             output_grid[r, c] = Color.BLACK
  52: 
  53:     return output_grid
  54: 
  55: 
  56: def generate_input():
  57:     w, h = np.random.randint(15, 25, size=2)
  58:     grid = np.full((w, h), Color.BLACK)
  59: 
  60:     color = np.random.choice(Color.NOT_BLACK)
  61:     n_rectangles = np.random.randint(2, 4)
  62: 
  63:     for _ in range(n_rectangles):
  64:         rw, rh = np.random.randint(3, 2*w//3), np.random.randint(3, 2*h//3)
  65:         sprite = np.full((rw, rh), color) # Can also do: random_sprite(rw, rh, color_palette=[rectangle_color], density=1)
  66:         try:
  67:             r, c = random_free_location(grid, sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
  68:         except ValueError:
  69:             break
  70:         paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
  71:     
  72:     n_noise_pixels = np.random.randint(8, 16)
  73:     for _ in range(n_noise_pixels):
  74:         r, c = np.random.randint(w), np.random.randint(h)
  75:         grid[r, c] = color
  76:     
  77:     return grid
