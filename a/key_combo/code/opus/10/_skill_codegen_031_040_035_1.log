 212: def _gen_boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
 213:     return a[0] <= b[2] and b[0] <= a[2] and a[1] <= b[3] and b[1] <= a[3]
 214: 
 215: 
 216: def _gen_nonoverlap_reflections(r0: int, c0: int) -> int:
 217:     last = _GEN_GRID_SIZE - 1
 218:     r1 = r0 + _GEN_OCCLUDER_SIZE - 1
 219:     c1 = c0 + _GEN_OCCLUDER_SIZE - 1
 220:     box = (r0, c0, r1, c1)
 221:     reflected = [
 222:         (r0, last - c1, r1, last - c0),
 223:         (last - r1, c0, last - r0, c1),
 224:         (last - r1, last - c1, last - r0, last - c0),
 225:     ]
 226:     return sum(not _gen_boxes_overlap(box, other) for other in reflected)
 227: 
