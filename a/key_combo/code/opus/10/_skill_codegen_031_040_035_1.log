  32: def main(grid: np.ndarray) -> np.ndarray:
  33:     """Recover the pattern hidden by the unique solid square occluder using mirror symmetry.
  34: 
  35:     Input structure
  36:     - The input is a square scene with one unique largest solid monochrome square occluder.
  37:     - The occluder's color appears only in that square, and the rest of the scene is mirror-symmetric.
  38: 
  39:     Rule
  40:     - Reflect the occluder's bbox across the vertical axis, horizontal axis, and both axes.
  41:     - Ignore reflected regions that still contain the occluder color because they overlap the hidden square.
  42:     - Transform each usable reflected region back into the occluder orientation and return that recovered square.
  43: 
  44:     Key insight
  45:     - The task asks for only the occluded square, not the full repaired scene; every unoccluded mirror counterpart yields the same patch.
  46:     """
  47:     g = np.asarray(grid, dtype=int)
  48:     H, W = g.shape
  49:     assert H == W, "expected a square input grid"
  50: 
  51:     occluder = _largest_solid_square(g)
  52:     color = int(occluder["color"])
  53:     r0, c0, r1, c1 = occluder["bbox"]
  54:     h = bbox_h(occluder["bbox"])
  55:     w = bbox_w(occluder["bbox"])
  56:     assert np.count_nonzero(g == color) == h * w, "occluder color must occur only in the occluder"
  57: 
  58:     reflections = [
  59:         (r0, W - 1 - c1, r1, W - 1 - c0, np.fliplr),
  60:         (H - 1 - r1, c0, H - 1 - r0, c1, np.flipud),
  61:         (H - 1 - r1, W - 1 - c1, H - 1 - r0, W - 1 - c0, lambda a: np.rot90(a, 2)),
  62:     ]
  63: 
  64:     recovered = []
  65:     for rr0, cc0, rr1, cc1, transform in reflections:
  66:         assert 0 <= rr0 <= rr1 < H and 0 <= cc0 <= cc1 < W
  67:         patch = g[rr0 : rr1 + 1, cc0 : cc1 + 1]
  68:         assert patch.shape == (h, w)
  69:         if not np.any(patch == color):
  70:             recovered.append(transform(patch))
  71: 
  72:     assert recovered, "expected at least one unoccluded mirror counterpart"
  73:     assert all(np.array_equal(recovered[0], patch) for patch in recovered[1:]), "mirror counterparts must agree"
  74:     return recovered[0].copy()
