 225: def _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:
 226:     if target <= 0:
 227:         return np.zeros_like(allowed, dtype=bool)
 228: 
 229:     want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY
 230:     if want_two:
 231:         for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):
 232:             first_size = random.randint(1, target - 1)
 233:             first = _grow_blob(allowed, first_size)
 234:             if first is None:
 235:                 continue
 236: 
 237:             blocked = set(first)
 238:             for r, c in tuple(first):
 239:                 blocked.update(_neighbors4(r, c, *allowed.shape))
 240: 
 241:             allowed_second = allowed.copy()
 242:             for r, c in blocked:
 243:                 allowed_second[r, c] = False
 244: 
 245:             second = _grow_blob(allowed_second, target - first_size)
 246:             if second is None:
 247:                 continue
 248: 
 249:             mask = np.zeros_like(allowed, dtype=bool)
 250:             for r, c in first | second:
 251:                 mask[r, c] = True
 252:             return mask
 253: 
 254:     one = _grow_blob(allowed, target)
 255:     if one is None:
 256:         return None
 257: 
 258:     mask = np.zeros_like(allowed, dtype=bool)
 259:     for r, c in one:
 260:         mask[r, c] = True
