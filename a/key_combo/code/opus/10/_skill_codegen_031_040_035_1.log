 171: def _gen_make_q(bg: int, fg: list[int]) -> np.ndarray:
 172:     q = np.full((_GEN_QUAD_SIZE, _GEN_QUAD_SIZE), bg, dtype=int)
 173:     mode = random.choice(_GEN_Q_MODES)
 174: 
 175:     if mode in ("pixel", "mixed"):
 176:         bg_p = random.uniform(*_GEN_PIXEL_BG_PROB_RANGE)
 177:         for r in range(_GEN_QUAD_SIZE):
 178:             for c in range(r, _GEN_QUAD_SIZE):
 179:                 color = bg if random.random() < bg_p else random.choice(fg)
 180:                 _gen_set_q_orbit(q, r, c, color)
 181: 
 182:     if mode in ("blocks", "mixed"):
 183:         for _ in range(random.randint(*_GEN_BLOCK_COUNT_RANGE)):
 184:             h = random.randint(*_GEN_BLOCK_SIDE_RANGE)
 185:             w = random.randint(*_GEN_BLOCK_SIDE_RANGE)
 186:             if random.random() < _GEN_LARGE_BLOCK_PROB:
 187:                 h = random.randint(*_GEN_LARGE_BLOCK_SIDE_RANGE)
 188:             if random.random() < _GEN_LARGE_BLOCK_PROB:
 189:                 w = random.randint(*_GEN_LARGE_BLOCK_SIDE_RANGE)
 190:             r0 = random.randint(0, _GEN_QUAD_SIZE - h)
 191:             c0 = random.randint(0, _GEN_QUAD_SIZE - w)
 192:             _gen_paint_q_rect(q, r0, c0, h, w, random.choice(fg))
 193: 
 194:         for _ in range(random.randint(*_GEN_NOISE_COUNT_RANGE)):
 195:             r = random.randint(0, _GEN_QUAD_SIZE - 1)
 196:             c = random.randint(r, _GEN_QUAD_SIZE - 1)
 197:             _gen_set_q_orbit(q, r, c, bg if random.random() < _GEN_NOISE_BG_PROB else random.choice(fg))
 198: 
 199:     _gen_force_palette(q, [bg] + fg)
 200:     _gen_balance_bg(q, bg, fg)
 201:     if not _gen_break_uniform_5x5(q, [bg] + fg):
 202:         return q
 203:     _gen_force_palette(q, [bg] + fg)
 204:     _gen_balance_bg(q, bg, fg)
 205:     return q
