 229: def _gen_occluder_position() -> tuple[int, int]:
 230:     crossing = []
 231:     noncrossing = []
 232:     for r0 in range(_GEN_GRID_SIZE - _GEN_OCCLUDER_SIZE + 1):
 233:         for c0 in range(_GEN_GRID_SIZE - _GEN_OCCLUDER_SIZE + 1):
 234:             row_cross = _gen_crosses_axis(r0)
 235:             col_cross = _gen_crosses_axis(c0)
 236:             if row_cross and col_cross:
 237:                 continue
 238:             if _gen_nonoverlap_reflections(r0, c0) < _GEN_MIN_NONOVERLAP_REFLECTIONS:
 239:                 continue
 240:             if row_cross or col_cross:
 241:                 crossing.append((r0, c0))
 242:             else:
 243:                 noncrossing.append((r0, c0))
 244:     if crossing and (not noncrossing or random.random() < _GEN_CROSSING_POSITION_PROB):
 245:         return random.choice(crossing)
 246:     return random.choice(noncrossing)
