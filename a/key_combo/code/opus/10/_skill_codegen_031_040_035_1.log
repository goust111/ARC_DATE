+
+BLACK = 0
+RED = 2
+MAX_GENERATION_ATTEMPTS = 500
+
+_CASE_ORDER = [
+    ("odd", "left", "left", "right"),
+    ("odd", "right", "right", "left"),
+    ("even", "left", "right", "left"),
+    ("even", "right", "left", "right"),
