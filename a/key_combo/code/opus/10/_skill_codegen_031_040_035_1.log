  91: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]
  92: NUM_COLORS = 10                   # palette 0-9
  93: 
  94: # ── CFG: component shapes ───────────────────────────────────────────
  95: BBOX_MAX = 5                      # max h or w of a component bbox
  96: AREA_RANGE = (3, 13)              # component area in [3, 12]
  97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w
  98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes
