  47: def _paste_checked(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
  48:     h, w = patch.shape
  49:     target = out[int(r0) : int(r0) + h, int(c0) : int(c0) + w]
  50:     assert target.shape == patch.shape, "target patch must fit in the grid"
  51:     assert not bool(np.any((target != int(bg)) & (patch != int(bg)))), "moved objects must not overlap"
  52:     paste(out, patch, int(r0), int(c0), transparent=int(bg))
