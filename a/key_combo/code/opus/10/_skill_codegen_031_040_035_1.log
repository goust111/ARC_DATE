 108: def _gen_expand_q(q: np.ndarray) -> np.ndarray:
 109:     top = np.concatenate([q, np.fliplr(q)], axis=1)
 110:     return np.concatenate([top, np.flipud(top)], axis=0)
 111: 
 112: 
 113: def _gen_set_q_orbit(q: np.ndarray, r: int, c: int, color: int) -> None:
 114:     q[r, c] = color
 115:     q[c, r] = color
 116: 
 117: 
 118: def _gen_paint_q_rect(q: np.ndarray, r0: int, c0: int, h: int, w: int, color: int) -> None:
 119:     q[r0 : r0 + h, c0 : c0 + w] = color
 120:     q[c0 : c0 + w, r0 : r0 + h] = color
 121: 
 122: 
 123: def _gen_force_palette(q: np.ndarray, colors: list[int]) -> None:
 124:     used = set(int(x) for x in q.flat)
 125:     spots = [(r, c) for r in range(_GEN_QUAD_SIZE) for c in range(r, _GEN_QUAD_SIZE)]
 126:     random.shuffle(spots)
 127:     for color in colors:
 128:         if color not in used and spots:
 129:             r, c = spots.pop()
 130:             _gen_set_q_orbit(q, r, c, color)
 131:             used.add(color)
 132: 
 133: 
 134: def _gen_balance_bg(q: np.ndarray, bg: int, fg: list[int]) -> None:
 135:     for _ in range(_GEN_BG_BALANCE_STEPS):
 136:         counts = {color: int(np.count_nonzero(q == color)) for color in [bg] + fg}
 137:         if counts[bg] >= max(counts[color] for color in fg) + _GEN_BG_DOMINANCE_MARGIN:
 138:             return
 139:         color = max(fg, key=lambda x: counts[x])
 140:         coords = [(int(r), int(c)) for r, c in np.argwhere(q == color) if counts[color] > _GEN_MIN_COLOR_CELLS_TO_REPAINT]
 141:         if not coords:
 142:             return
 143:         r, c = random.choice(coords)
 144:         _gen_set_q_orbit(q, r, c, bg)
 145: 
