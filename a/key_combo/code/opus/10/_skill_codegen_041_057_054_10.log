+    end_dir = (last[0] - prev[0], last[1] - prev[1])
+    start_dir = (0 if start_dir[0] == 0 else start_dir[0] // abs(start_dir[0]), 0 if start_dir[1] == 0 else start_dir[1] // abs(start_dir[1]))
