+def _expand_path(coarse: list[tuple[int, int]]) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    coarse_h = max(r for r, _ in coarse) + 1
+    coarse_w = max(c for _, c in coarse) + 1
+    h = 4 * coarse_h
+    w = 4 * coarse_w
