+def _turn_count(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    for i in range(1, len(path) - 1):
+        a = path[i - 1]
+        b = path[i]
+        c = path[i + 1]
+        d1 = (b[0] - a[0], b[1] - a[1])
+        d2 = (c[0] - b[0], c[1] - b[1])
