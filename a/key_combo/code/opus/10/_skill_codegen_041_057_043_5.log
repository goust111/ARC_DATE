+def _piece_patch(grid: np.ndarray, coords: np.ndarray, color: int) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        patch[int(r) - r0, int(c) - c0] = int(color)
+    return patch
