  "dst": "row-span interior d of an 8-connected outline object",
  "match_cond": "|s| == cell_count(d)",
  "transform": "erase s from original locations and fill d with s.color"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 13-16 rows x 13-16 cols, single background color (any), exactly 2 foreground colors
  outline_objects:
    count: exactly 2, 8-connected monochromatic components of the outline color
    shape: open containers with exactly one row-span cavity (bg cells strictly between leftmost/rightmost outline pixels per row)
    cavity_sizes: two distinct positive integers; one matches source pixel count, the other does not
    pixel_count_per_comp: 3-8
    bbox: 2-3 rows x 1-5 cols, non-overlapping between comps
    structure: each row has 1-4 outline pixels; at least one row has >=2 pixels to create cavity gap
  source:
    color: the other foreground color (not outline)
    pixel_count: equals one outline comp's cavity size (1-4 observed)
