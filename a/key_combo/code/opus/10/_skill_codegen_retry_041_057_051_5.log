+    if anchor_count == 3:
+        names = ["U", "R", "D", "L"]
+        random.shuffle(names)
+        return names[:3]
+    pair_bank = [
+        ["U", "R"],
+        ["R", "D"],
+        ["D", "L"],
+        ["L", "U"],
+        ["U", "D"],
+        ["R", "L"],
+    ]
+    return random.choice(pair_bank).copy()
