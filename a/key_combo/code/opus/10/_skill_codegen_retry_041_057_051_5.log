+        for rr, cc in coords:
+            out[rr, cc] = STAIR
+            if not ignore_stair_collisions:
+                occupied[rr, cc] = True
+
+    prefill = out.copy()
+    filled = _fill_closed_regions(out)
+    meta = {
+        "anchors": anchors,
+        "directions": directions,
+        "arm_paths": arm_paths,
+        "stop_reasons": stop_reasons,
+    }
+    return filled, prefill, meta
