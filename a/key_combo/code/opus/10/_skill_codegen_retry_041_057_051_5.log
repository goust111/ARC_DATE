+                continue
+            dr, dc = {
+                "U": (-1, 0),
+                "R": (0, 1),
+                "D": (1, 0),
+                "L": (0, -1),
+            }[direction_name]
+            hr, hc = r + dr, c + dc
+            if not (0 <= hr < h and 0 <= hc < w):
+                continue
+            if occupied[r, c] or occupied[hr, hc]:
+                continue
+            found = (r, c, direction_name)
+            occupied[r, c] = True
+            occupied[hr, hc] = True
+            break
+        if found is None:
+            return None
+        placed.append(found)
+    return placed
+
