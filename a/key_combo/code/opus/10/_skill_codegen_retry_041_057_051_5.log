+
+    border_touch = (
+        np.any(prefill[0] != BG)
+        or np.any(prefill[-1] != BG)
+        or np.any(prefill[:, 0] != BG)
+        or np.any(prefill[:, -1] != BG)
+    )
+    if not border_touch:
