+
+def _trace_arm(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    steps: tuple[tuple[int, int], tuple[int, int]],
+    occupied: np.ndarray,
+    *,
+    straight: bool = False,
+    swap_order: bool = False,
