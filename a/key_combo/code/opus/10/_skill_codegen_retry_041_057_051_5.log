import random, numpy as np
from collections import deque
BLACK, RED, GREY, TEAL = 0,2,5,8
DIRS = {'U':[(-1,0),(0,1)],'R':[(0,1),(1,0)],'D':[(1,0),(0,-1)],'L':[(0,-1),(-1,0)]}
CAP_OFF = {'U':(-1,0),'R':(0,1),'D':(1,0),'L':(0,-1)}
