+def _simulate(
+    grid: np.ndarray,
+    *,
+    erase_hats: bool = True,
+    straight: bool = False,
+    swap_order: bool = False,
+    ignore_stair_collisions: bool = False,
+) -> tuple[np.ndarray, np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
