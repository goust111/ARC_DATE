+    anchors = _place_anchors(h, w, direction_names, broad_search=(anchor_count == 2))
+    if anchors is None:
+        return None
+    grid = _make_input_from_anchors(h, w, anchors)
+    if not _semantic_checks(grid):
+        return None
+    return grid
