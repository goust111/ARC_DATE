+    (-1, 0): ((-1, 0), (0, 1)),   # cap above: up then right
+    (0, 1): ((0, 1), (1, 0)),     # cap right: right then down
+    (1, 0): ((1, 0), (0, -1)),    # cap below: down then left
+    (0, -1): ((0, -1), (-1, 0)),  # cap left: left then up
