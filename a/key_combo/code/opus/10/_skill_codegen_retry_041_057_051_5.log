+def _make_input_from_anchors(h: int, w: int, anchors: list[tuple[int, int, str]]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    name_to_cap = {
+        "U": (-1, 0),
+        "R": (0, 1),
+        "D": (1, 0),
+        "L": (0, -1),
+    }
+    for r, c, direction_name in anchors:
+        dr, dc = name_to_cap[direction_name]
+        grid[r, c] = ANCHOR
+        grid[r + dr, c + dc] = STAIR
+    return grid
+
+
