+def generate_input() -> np.ndarray:
+    global GEN_CALL_INDEX
+    preferred = GEN_COUNT_CYCLE[GEN_CALL_INDEX % len(GEN_COUNT_CYCLE)]
+    GEN_CALL_INDEX += 1
