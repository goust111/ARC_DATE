def trace(shape, anchor, d, occ):
    H,W=shape; r,c=anchor; out=[]; phase=0
    while True:
        dr,dc=DIRS[d][phase]
        for _ in range(2):
            nr,nc=r+dr,c+dc
            if not (0<=nr<H and 0<=nc<W): return out
            if occ[nr,nc]: return out
            out.append((nr,nc)); r,c=nr,nc
            if r in (0,H-1) or c in (0,W-1): return out
        phase "'^= 1

def solve(inp, order='"'row'):
    g=inp.copy(); H,W=g.shape; anchors=[]; hats=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]==TEAL:
                found=[]
                for d,(dr,dc) in CAP_OFF.items():
                    rr,cc=r+dr,c+dc
