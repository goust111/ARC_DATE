    seq=sorted(anchors) if order=='"'row' else sorted(anchors, reverse=True)
    for r,c,d in seq:
        pts=trace(g.shape,(r,c),d,occ)
        for rr,cc in pts:
            g[rr,cc]=GREY; occ[rr,cc]=True
    mask=g==BLACK; seen=np.zeros_like(mask,bool)
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            q=deque([(r,c)]); seen[r,c]=True; comp=[]; touch=False
            while q:
                rr,cc=q.popleft(); comp.append((rr,cc))
                if rr in (0,H-1) or cc in (0,W-1): touch=True
