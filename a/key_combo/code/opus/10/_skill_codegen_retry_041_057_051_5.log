        H=W=random.randint(16,24); n=random.randint(2,4); g=np.zeros((H,W),int); choices=[]
        ok=True
        for _ in range(n):
            placed=False
            for _ in range(200):
                r=random.randint(3,H-4); c=random.randint(3,W-4); d=random.choice('URDL')
                if all(abs(r-r0)+abs(c-c0)>=7 and max(abs(r-r0),abs(c-c0))>=5 for r0,c0,_ in choices):
                    dr,dc=CAP_OFF[d]; rr,cc=r+dr,c+dc
