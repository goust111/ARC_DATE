+    out, _prefill, _meta = _simulate(grid, ignore_stair_collisions=True)
+    return out
+
+
+def _wrong_keep_hats(grid: np.ndarray) -> np.ndarray:
+    out, _prefill, _meta = _simulate(grid, erase_hats=False)
+    return out
+
