+
+    red_count = int(np.count_nonzero(out == FILL))
+    if red_count == 0 or red_count > grid.size // 3:
+        return False
+
+    if np.count_nonzero(prefill == STAIR) < 12:
+        return False
+
+    if np.array_equal(out, _wrong_straight(grid)):
