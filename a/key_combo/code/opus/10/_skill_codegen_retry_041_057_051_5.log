/bin/bash -lc "python - <<'PY'
import random, numpy as np
from collections import deque

BLACK, RED, GREY, TEAL = 0,2,5,8
DIRS = {
    'U': [(-1,0),(0,1)],
    'R': [(0,1),(1,0)],
    'D': [(1,0),(0,-1)],
    'L': [(0,-1),(-1,0)],
}
CAP_OFF = {'U':(-1,0),'R':(0,1),'D':(1,0),'L':(0,-1)}

def trace(shape, anchor, d, occ):
    H,W = shape
    r,c=anchor
    out=[]
    phase=0
    while True:
        dr,dc = DIRS[d][phase]
        progressed=False
        for _ in range(2):
            nr,nc = r+dr,c+dc
            if not (0<=nr<H and 0<=nc<W):
                return out
            if occ[nr,nc]:
                return out
            out.append((nr,nc))
            r,c = nr,nc
            progressed=True
            if r in (0,H-1) or c in (0,W-1):
                return out
        if not progressed:
            return out
        phase "'^= 1

def solve(inp, order='"'row'):
    g=inp.copy()
    H,W=g.shape
    anchors=[]
    hats=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]==TEAL:
                found=[]
                for d,(dr,dc) in CAP_OFF.items():
                    rr,cc=r+dr,c+dc
                    if 0<=rr<H and 0<=cc<W and g[rr,cc]==GREY:
                        found.append((d,(rr,cc)))
                if len(found)"'!=1:
                    return None
                d,hat = found[0]
                anchors.append((r,c,d))
                hats.append(hat)
    for r,c in hats:
        g[r,c]=BLACK
    occ = g!=BLACK
    seq=sorted(anchors) if order=='"'row' else sorted(anchors, reverse=True)
    for r,c,d in seq:
        pts=trace(g.shape,(r,c),d,occ)
        for rr,cc in pts:
            g[rr,cc]=GREY
            occ[rr,cc]=True
    # fill closed 0 components not touching border
    mask = g==BLACK
    seen=np.zeros_like(mask,dtype=bool)
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)]); seen[r,c]=True; comp=[]; touch=False
            while q:
                rr,cc=q.popleft(); comp.append((rr,cc))
                if rr in (0,H-1) or cc in (0,W-1): touch=True
                for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True;q.append((nr,nc))
            if not touch:
                for rr,cc in comp: g[rr,cc]=RED
    return g

def rand_case():
    H=W=random.randint(16,24)
    n=random.randint(2,4)
    g=np.zeros((H,W),int)
    choices=[]
    for _ in range(n):
        for _ in range(200):
            r=random.randint(3,H-4); c=random.randint(3,W-4)
            if all(abs(r-r0)+abs(c-c0)>=7 and max(abs(r-r0),abs(c-c0))>=5 for r0,c0,_ in choices):
                d=random.choice('URDL')
                dr,dc=CAP_OFF[d]
                rr,cc=r+dr,c+dc
                if g[rr,cc]==0:
                    choices.append((r,c,d)); g[r,c]=TEAL; g[rr,cc]=GREY; break
        else:
            return None
    return g

success=0
same=0
for i in range(5000):
    inp=rand_case()
    if inp is None: continue
    a=solve(inp,'row')
    b=solve(inp,'rev')
    if a is None or b is None: continue
    reda=np.count_nonzero(a==RED)
    if reda>0:
        success+=1
        if np.array_equal(a,b):
            same+=1
            if same<=5:
                print('example',i, inp.shape, reda, np.count_nonzero(inp==TEAL), sorted({tuple(x) for x in np.argwhere(inp==TEAL)}))
print('success red',success,'same',same)
