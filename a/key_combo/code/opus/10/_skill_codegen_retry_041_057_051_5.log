+            hr, hc = r + dr, c + dc
+            if not (0 <= hr < h and 0 <= hc < w):
+                continue
+            if occupied[r, c] or occupied[hr, hc]:
+                continue
+            found = (r, c, direction_name)
+            occupied[r, c] = True
+            occupied[hr, hc] = True
+            break
+        if found is None:
+            return None
+        placed.append(found)
+    return placed
+
+
+def _make_input_from_anchors(h: int, w: int, anchors: list[tuple[int, int, str]]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
