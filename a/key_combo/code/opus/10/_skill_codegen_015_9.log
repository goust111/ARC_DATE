+    return None
+
+
+def _touching(a: np.ndarray, b: np.ndarray) -> bool:
+    cells_b = {(int(r), int(c)) for r, c in b}
+    for r, c in a:
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (rr + dr, cc + dc) in cells_b:
+                    return True
+    return False
+
+
+def _input_order(objects: list[dict]) -> list[int]:
+    indexed = list(enumerate(objects))
+    indexed.sort(key=lambda item: _bottom_row(item[1]["coords"]), reverse=True)
+    return [int(idx) for idx, _obj in indexed]
+
+
+def _supports_collision(settled: list[dict], shape: tuple[int, int]) -> bool:
+    occ = _occupancy(shape, settled)
+    h, _w = shape
+    for idx, obj in enumerate(settled):
+        coords = np.asarray(obj["coords"], dtype=int)
+        mask_occ = np.where(occ == idx, -1, occ)
+        floor, supporters = _support_info(coords, mask_occ, h)
+        if not floor and supporters:
+            return True
+    return False
