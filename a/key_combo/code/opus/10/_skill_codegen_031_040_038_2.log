+BACKGROUND = 0
+MAX_GENERATION_ATTEMPTS = 2000
+
+
+def _extract_seeds(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    coords = np.argwhere(grid != BACKGROUND)
