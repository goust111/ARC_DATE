    profile = top if side == "top" else bottom
    options = []
    if height < GEN_MIN_NOTCH_CANVAS_SIDE or width < GEN_MIN_NOTCH_CANVAS_SIDE or max_depth < GEN_MIN_NOTCH_DEPTH:
