+    counts: list[int], seeds: list[tuple[int, int, int]], order: list[int]
+) -> np.ndarray:
+    height = max(counts)
+    width = len(seeds)
+    out = np.zeros((height, width), dtype=int)
+    for col, seed_idx in enumerate(order):
+        color = seeds[seed_idx][2]
+        count = counts[seed_idx]
+        out[height - count :, col] = color
+    return out
