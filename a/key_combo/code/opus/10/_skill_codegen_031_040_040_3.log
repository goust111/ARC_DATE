+    return True
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        marker_coords, axis_col = _marker_info(grid)
+        actual = main(grid)
+    except Exception:
+        return False
+
+    if not _rows_have_both_sides(grid, axis_col):
