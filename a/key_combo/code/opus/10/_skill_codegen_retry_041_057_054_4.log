+BACKGROUND = 0
+ORANGE = 7
+MASK = 9
+PATTERN_PALETTE = (1, 2, 3, 4, 5, 6, 8)
+SIZE_CHOICES = (11, 13, 15)
+GEN_RETRIES = 500
