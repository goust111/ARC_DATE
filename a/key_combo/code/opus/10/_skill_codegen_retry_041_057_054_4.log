+def _h_partner(width: int, r: int, c: int) -> tuple[int, int]:
+    return r, width - 1 - c
+
+
+def _v_partner(height: int, r: int, c: int) -> tuple[int, int]:
+    return height - 1 - r, c
+
+
+def _d_partner(height: int, width: int, r: int, c: int) -> tuple[int, int]:
