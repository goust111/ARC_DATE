+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    frames = _find_frames(g)
+    for frame in frames:
+        bbox = frame["bbox"]  # type: ignore[assignment]
+        top, left, bottom, right = bbox
+        direction = direction_override or str(frame["direction"])
