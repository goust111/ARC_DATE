+BLACK = 0
+BLUE = 1
+GREY = 5
+MARKER_COLORS = (2, 3, 4, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_RANGE_BY_FRAME_COUNT = {
+    2: ((20, 25), (20, 25)),
