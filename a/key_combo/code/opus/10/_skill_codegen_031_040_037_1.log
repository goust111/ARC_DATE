+        blues = [
+            (int(r), int(c))
+            for r, c in np.argwhere(g[top + 1 : bottom, left + 1 : right] == BLUE)
+            for _ in (None,)
+            for r, c in [(int(r + top + 1), int(c + left + 1))]
+        ]
+        obstacles = set()
+        if not ignore_obstacles:
+            obstacles = {
+                (int(r + top + 1), int(c + left + 1))
+                for r, c in np.argwhere(g[top + 1 : bottom, left + 1 : right] == GREY)
+            }
