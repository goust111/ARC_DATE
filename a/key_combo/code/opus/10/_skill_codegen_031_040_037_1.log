+def _corner_cells(top: int, left: int, bottom: int, right: int) -> set[tuple[int, int]]:
+    return {
+        (top, left),
+        (top, left + 1),
+        (top + 1, left),
+        (top, right - 1),
+        (top, right),
+        (top + 1, right),
+        (bottom - 1, left),
+        (bottom, left),
+        (bottom, left + 1),
+        (bottom - 1, right),
+        (bottom, right - 1),
+        (bottom, right),
+    }
+
