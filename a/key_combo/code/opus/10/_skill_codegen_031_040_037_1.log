+
+    for r, c in blue_cells:
+        grid[r, c] = BLUE
+    for r, c in obstacle_cells:
+        grid[r, c] = GREY
+    return True
+
+
+def _populate_tall_frame(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
