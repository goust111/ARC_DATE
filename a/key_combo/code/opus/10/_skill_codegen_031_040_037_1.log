+    (hmin, hmax), (wmin, wmax) = GRID_RANGE_BY_FRAME_COUNT[frame_count]
+    H = random.randint(hmin, hmax)
+    W = random.randint(wmin, wmax)
+    grid = np.zeros((H, W), dtype=int)
