+def _detect_bars(grid: np.ndarray) -> list[dict]:
+    bars: list[dict] = []
+    for coords in _components_of_color(grid, BAR):
+        r0, c0, r1, c1 = _bbox(coords)
+        if c0 != c1:
+            continue
+        if len(coords) != r1 - r0 + 1:
