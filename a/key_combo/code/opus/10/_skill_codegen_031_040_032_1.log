+        hit_row = None
+        for r in range(int(bar["top"]) - 1, -1, -1):
+            value = int(grid[r, col])
+            if value not in (BG, BAR):
+                hit_row = r
+                break
+        if hit_row is None:
+            continue
+        idx = lookup.get((int(hit_row), col))
+        if idx is not None:
+            counts[idx] += 1
+    return counts
+
