+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _detect_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in (BG, BAR)):
+        for coords in _components_of_color(grid, color):
+            r0, c0, r1, c1 = _bbox(coords)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 4 or w < 4:
+                continue
+            if len(coords) != 2 * (h + w) - 4:
+                continue
+            local = np.zeros((h, w), dtype=bool)
+            local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.array_equal(local, border):
+                continue
+            frames.append(
+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
