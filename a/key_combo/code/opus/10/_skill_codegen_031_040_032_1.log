+            local = np.zeros((h, w), dtype=bool)
+            local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.array_equal(local, border):
+                continue
+            frames.append(
+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                }
+            )
+    frames.sort(key=lambda item: (item["bbox"][1], item["bbox"][0], item["color"]))
+    return frames
