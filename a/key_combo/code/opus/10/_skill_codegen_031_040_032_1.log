+    if min_width_total > 30:
+        return None
+    width = random.randint(max(18, min_width_total), min(30, min_width_total + 4))
+
+    height = random.randint(max(18, max(heights) + 11), 24)
+    if height > 30:
+        return None
+
+    extra = width - min_width_total
+    slack = [0] * (frame_count + 1)
