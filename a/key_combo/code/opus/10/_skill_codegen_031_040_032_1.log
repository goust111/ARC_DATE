+def _docked_bar_counts(grid: np.ndarray, frames: list[dict], bars: list[dict]) -> list[int]:
+    lookup: dict[tuple[int, int], int] = {}
+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        for c in range(c0, c1 + 1):
+            lookup[(r1, c)] = idx
