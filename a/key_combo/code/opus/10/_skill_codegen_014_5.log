+def _trace_first_hit(
+    vertex: Coord,
+    direction: Coord,
+    shooter_id: int,
+    cell_to_sprite: dict[Coord, int],
+    shape: tuple[int, int],
+) -> tuple[int | None, int | None, list[Coord]]:
+    h, w = shape
+    vr, vc = vertex
+    dr, dc = direction
+    r, c = vr + dr, vc + dc
+    path: list[Coord] = []
+    while 0 <= r < h and 0 <= c < w:
