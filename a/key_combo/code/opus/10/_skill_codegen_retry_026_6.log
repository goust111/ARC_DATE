+    add_frontier(seed)
+    while len(selected) < area:
+        if not frontier:
+            return _grow_connected_mask(rng, h, w, area)
+        cell = rng.choice(tuple(frontier))
+        frontier.remove(cell)
+        selected.add(cell)
+        add_frontier(cell)
+
+    rows = [r for r, _ in selected]
+    cols = [c for _, c in selected]
+    mask[min(rows) : max(rows) + 1, min(cols) : max(cols) + 1] = False
+    for r, c in selected:
