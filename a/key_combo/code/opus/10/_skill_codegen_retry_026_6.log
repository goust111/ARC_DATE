def _max_independent_size(mask: np.ndarray) -> int:
    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
    best = 0
    for bits in range(1 << len(coords)):
        chosen: list[tuple[int, int]] = []
        ok = True
