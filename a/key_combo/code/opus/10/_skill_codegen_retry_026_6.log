    for c in range(width - 1):
        _gen_append_segment(path, top[c], c, top[c], c + 1)
        _gen_append_segment(path, top[c], c + 1, top[c + 1], c + 1)
    _gen_append_segment(path, top[-1], width - 1, bottom[-1], width - 1)
