+def _make_sprite(rng: random.Random) -> np.ndarray:
+    for _ in range(500):
+        h = rng.randint(3, 5)
+        w = rng.randint(3, 5)
+        area = rng.randint(6, min(8, h * w - 1))
+        mask = _grow_connected_mask(rng, h, w, area)
