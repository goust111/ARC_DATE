    max_size = min(10, len(target_pairs), 2 * (_max_independent_size(np.array([[0]])) + 10))
    for need in rng.sample(list(range(6, min(10, len(target_pairs)) + 1)), k=min(5, max(1, min(10, len(target_pairs)) - 5))):
        for _ in range(150):
            anchors = _isolated_anchor_subset(rng, target_pairs, need, half)
            if anchors is None:
                continue

