+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SPRITE_COLORS = (1, 2)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _extract_sprite_and_anchors(grid: np.ndarray) -> tuple[np.ndarray, set[tuple[int, int]], list[tuple[int, int, int]]]:
+    comps = _components(grid != BG)
+    assert comps, "expected foreground"
+    comps.sort(key=len, reverse=True)
+    sprite_coords = comps[0]
+    assert len(sprite_coords) > 1, "expected a multi-pixel sprite"
+    for comp in comps[1:]:
