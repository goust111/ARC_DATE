+def _choose_anchor_subset(
+    rng: random.Random,
+    target: dict[str, object],
+    candidates: list[dict[str, object]],
+    half: int,
+    require_counterexample: bool,
+) -> list[tuple[int, int, int]] | None:
+    target_pairs = list(target["all_pairs"])
