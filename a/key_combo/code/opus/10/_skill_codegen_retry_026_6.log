+    pairs: set[tuple[tuple[int, int], int]] = set()
+    for rr, cc in np.argwhere(patch != BG):
+        pairs.add(((r0 + int(rr), c0 + int(cc)), int(patch[rr, cc])))
+    return pairs
+
