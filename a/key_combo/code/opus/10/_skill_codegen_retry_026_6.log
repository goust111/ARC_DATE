+    H, _W = grid_shape
+    mirror_r0 = H - r0 - h
+    top_pairs = _pairs_from_patch(variant, r0, c0)
+    bottom_pairs = _pairs_from_patch(np.flipud(variant), mirror_r0, c0)
+    all_pairs = top_pairs | bottom_pairs
+    return {
+        "variant": variant,
+        "r0": int(r0),
+        "c0": int(c0),
+        "top_pairs": top_pairs,
