+    left = [0, 1] if W - w >= 1 else [0]
+    bottom = [H - h, H - h - 1] if H - h - 1 >= 0 else [H - h]
+    right = [W - w, W - w - 1] if W - w - 1 >= 0 else [W - w]
+    positions = [
+        (top[0], left[0]),
+        (top[-1], right[0]),
+        (bottom[0], left[-1]),
