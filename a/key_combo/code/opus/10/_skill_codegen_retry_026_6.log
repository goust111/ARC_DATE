+                continue
+            for other in chosen:
+                if abs(cell[0] - other[0]) + abs(cell[1] - other[1]) == 1:
+                    ok = False
+                    break
+            if not ok:
+                break
+            chosen.append(cell)
+        if ok:
+            best = max(best, len(chosen))
+    return best
