0019: def canonical_shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:
0020:     """Canonicalize a boolean mask up to rotation and horizontal reflection."""
0021:     canon = np.asarray(mask, dtype=bool)
0022:     best = (canon.tobytes(), tuple(map(int, canon.shape)))
0023:     for _ in range(4):
0024:         canon = np.rot90(canon)
0025:         for v in (canon, np.fliplr(canon)):
0026:             key = (v.tobytes(), tuple(map(int, v.shape)))
0027:             if key < best:
0028:                 best = key
0029:     return best
