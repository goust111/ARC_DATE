0049:     anchor_candidates = [
0050:         color
0051:         for color in common
0052:         if color != skeleton and all(cnt.get(color, 0) == 1 for cnt in counts)
0053:     ]
0054:     assert len(anchor_candidates) == 1, "anchor color must appear once in every motif"
0055:     anchor = anchor_candidates[0]
0056:     return skeleton, anchor, fg_colors - {skeleton, anchor}
