0017: def _dihedral_variants(patch: np.ndarray) -> list[np.ndarray]:
0018:     variants: list[np.ndarray] = []
0019:     seen: set[tuple[tuple[int, int], bytes]] = set()
0020:     for k in range(4):
0021:         rotated = np.rot90(patch, k)
0022:         for variant in (rotated, np.fliplr(rotated)):
0023:             key = (variant.shape, variant.tobytes())
0024:             if key not in seen:
0025:                 seen.add(key)
0026:                 variants.append(variant.copy())
0027:     return variants
0028: 
