0009: def _enclosed_region_coords(wall_coords: np.ndarray, box: tuple[int, int, int, int]) -> list[np.ndarray]:
0010:     r0, c0, r1, c1 = map(int, box)
0011:     h, w = r1 - r0 + 1, c1 - c0 + 1
0012: 
0013:     wall = np.zeros((h, w), dtype=bool)
0014:     local = wall_coords - np.array([r0, c0])
0015:     wall[local[:, 0], local[:, 1]] = True
0016:     passable = ~wall
0017: 
0018:     outside = np.zeros((h, w), dtype=bool)
0019:     q: deque[tuple[int, int]] = deque()
0020:     for rr in range(h):
0021:         for cc in (0, w - 1):
0022:             if passable[rr, cc] and not outside[rr, cc]:
0023:                 outside[rr, cc] = True
0024:                 q.append((rr, cc))
