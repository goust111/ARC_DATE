0034: def _infer_role_colors(g: np.ndarray, comps: list[dict], bg: int) -> tuple[int, int, set[int]]:
0035:     counts = [
0036:         Counter(int(g[int(r), int(c)]) for r, c in comp["coords"])
0037:         for comp in comps
0038:     ]
0039:     fg_colors = {int(v) for v in np.unique(g) if int(v) != int(bg)}
0040:     common = [color for color in fg_colors if all(cnt.get(color, 0) > 0 for cnt in counts)]
0041:     assert len(common) >= 2, "motifs must share a skeleton color and an anchor color"
0042: 
0043:     totals = {color: sum(cnt.get(color, 0) for cnt in counts) for color in common}
