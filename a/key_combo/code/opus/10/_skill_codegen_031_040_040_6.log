+def _contiguous_run(mask: np.ndarray) -> tuple[int, int]:
+    rows = np.flatnonzero(mask)
+    assert rows.size > 0, "expected a non-empty edge bar"
+    start = int(rows[0])
+    end = int(rows[-1])
+    assert end - start + 1 == int(rows.size), "edge bar must be contiguous"
+    return start, end
