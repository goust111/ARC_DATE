+    assert int(expected[parsed_top + meta["productive"], grid.shape[1] - 2]) == GREEN, "wedge must start beside the right bar"
+    return expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
