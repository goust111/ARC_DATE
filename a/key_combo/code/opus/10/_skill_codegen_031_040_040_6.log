0013: def _trace_cycle(coords: np.ndarray) -> list[tuple[int, int]]:
0014:     pts = {tuple(map(int, p)) for p in coords}
0015:     for r, c in pts:
0016:         degree = sum((nr, nc) in pts for nr, nc in neighbors4(r, c))
0017:         assert degree == 2, (r, c, degree)
0018: 
0019:     start = min(pts)
0020:     neighbors = sorted((nr, nc) for nr, nc in neighbors4(*start) if (nr, nc) in pts)
0021:     assert len(neighbors) == 2
0022: 
0023:     path = [start]
0024:     prev = start
0025:     cur = neighbors[0]
0026:     while cur != start:
0027:         path.append(cur)
0028:         next_cells = [
0029:             (nr, nc)
0030:             for nr, nc in neighbors4(*cur)
0031:             if (nr, nc) in pts and (nr, nc) != prev
0032:         ]
0033:         assert len(next_cells) == 1, (cur, next_cells)
0034:         prev, cur = cur, next_cells[0]
0035:         assert len(path) <= len(pts)
0036: 
0037:     assert len(path) == len(pts)
0038:     return path
0039: 
