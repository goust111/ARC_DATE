+        expected = _semantic_checks(grid, meta)
+        try:
+            actual = main(grid)
+        except AssertionError:
+            continue
+        if np.array_equal(actual, expected):
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

