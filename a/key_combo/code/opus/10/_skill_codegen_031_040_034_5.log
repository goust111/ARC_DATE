+def _repeat_coarse(coarse: np.ndarray, row_runs: list[int], col_runs: list[int]) -> np.ndarray:
+    expanded = np.repeat(coarse, row_runs, axis=0)
+    expanded = np.repeat(expanded, col_runs, axis=1)
+    return expanded
