+BG = 0
+LEGEND_BG = 5
+ANGLES = (0, 90, 180, 270)
+ANGLE_TO_MARKER = {
+    0: (1, 0),
+    90: (1, 1),
+    180: (0, 0),
+    270: (0, 1),
+}
+MARKER_TO_ANGLE = {v: k for k, v in ANGLE_TO_MARKER.items()}
+COLOR_POOL = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GEN_ATTEMPTS = 400
