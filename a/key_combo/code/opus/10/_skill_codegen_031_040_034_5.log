+def _stretch_pattern(pattern: np.ndarray, target_shape: tuple[int, int]) -> np.ndarray:
+    stretched = _resize_axis(pattern, target_shape[0], axis=0)
+    stretched = _resize_axis(stretched, target_shape[1], axis=1)
+    return stretched
