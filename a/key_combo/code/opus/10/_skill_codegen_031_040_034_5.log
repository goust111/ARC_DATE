+def _rect_ok(occ: np.ndarray, top: int, left: int, shape: tuple[int, int], gap: int = 1) -> bool:
+    h, w = shape
+    h0, w0 = occ.shape
+    if top < 0 or left < 0 or top + h > h0 or left + w > w0:
+        return False
+    r0 = max(0, top - gap)
+    c0 = max(0, left - gap)
+    r1 = min(h0, top + h + gap)
+    c1 = min(w0, left + w + gap)
