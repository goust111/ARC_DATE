+        return False
+
+    overlap_ratio = stats["overlap_cells"] / max(1, covered_cells)
+    if overlap_ratio > 0.48:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+    _GEN_CALL_COUNT += 1
+    mode = (_GEN_CALL_COUNT - 1) % 3
+
+    for _ in range(_GEN_ATTEMPTS):
