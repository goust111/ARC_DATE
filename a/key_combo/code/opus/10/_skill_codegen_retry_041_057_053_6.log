+def _rect_conflicts(
+    candidate: tuple[int, int, int, int],
+    placed: list[tuple[int, int, int, int]],
+    gap: int = PLACEMENT_GAP,
+) -> bool:
+    r0, c0, h, w = candidate
+    for or0, oc0, oh, ow in placed:
+        separated = (
+            r0 + h + gap <= or0
+            or or0 + oh + gap <= r0
+            or c0 + w + gap <= oc0
+            or oc0 + ow + gap <= c0
+        )
+        if not separated:
+            return True
+    return False
