+def _zone_shapes(side: int) -> list[tuple[int, int]]:
+    n = side * side
+    base = [
+        (side, side + 1),
+        (side + 1, side),
+        (side + 1, side + 1),
+        (side, side + 2),
+        (side + 2, side),
+    ]
+    if side == 1:
+        base.extend([(1, 3), (2, 2), (2, 3)])
+    out = []
+    for h, w in base:
+        if h * w >= n + 1:
+            out.append((h, w))
+    return sorted(set(out))
