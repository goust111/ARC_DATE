+def _mask_is_solid_rectangle(mask: np.ndarray) -> bool:
+    b = bbox(mask)
+    assert b is not None
+    r0, c0, r1, c1 = b
+    return int(mask.sum()) == (r1 - r0 + 1) * (c1 - c0 + 1)
