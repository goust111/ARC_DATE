+            if cell in shared:
+                continue
+            dist = min(abs(r - sr) + abs(c - sc) for sr, sc in shared)
+            if 1 <= dist <= 4:
+                out.append(cell)
+    return out
+
+
+def _grow_blob(
+    shared: set[tuple[int, int]],
+    exclusive: tuple[int, int],
+    reserved_exclusives: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
