+
+    if not (3 <= len(cells) <= 8):
+        return None
+    if not _is_connected(cells, GRID_H, PANEL_W):
+        return None
+    return cells
+
+
+def _cells_to_panel(
+    cells: set[tuple[int, int]],
+    color: int,
+    marker_count: int,
