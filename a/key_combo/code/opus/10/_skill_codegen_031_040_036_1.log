+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PANEL_COLORS = (1, 2, 3, 4)
+SEPARATOR = 5
+MARKER = 7
+
+GRID_H = 12
+PANEL_W = 4
+PANEL_COUNT = 4
