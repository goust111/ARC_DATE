+    if path is None:
+        return None
+
+    cells = set(path) | set(shared)
+    if len(cells) > 8:
+        return None
+
+    target = random.randint(max(3, len(cells)), 8)
+    while len(cells) < target:
+        frontier = []
+        for r, c in cells:
+            for nxt in _neighbors4(r, c, GRID_H, PANEL_W):
+                if nxt not in cells and nxt not in blocked:
