                ok=False; break
            last=(r,c); r+=dr; c+=dc
    if len(hits)!=1: return None
    (dr,dc),start=hits[0]
    turns=[(dr,-1),(dr,1)] if dr else [(-1,dc),(1,dc)]
    paths=[]
    for tr,tc in turns:
        path=[start]
        r,c=start
        while True:
            nr,nc=r+tr,c+tc
            if not inb(g.shape,nr,nc) or g[nr,nc]!=BG or not adj_ob(g,(nr,nc)):
                break
            path.append((nr,nc)); r,c=nr,nc
        paths.append(path)
    lens=[len(p)-1 for p in paths]
    if lens[0]==lens[1]: return None
    path=paths[0] if lens[0]>lens[1] else paths[1]
