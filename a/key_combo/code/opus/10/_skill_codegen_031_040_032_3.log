 239:     out[dest] = marker
 240: 
 241:     rotations = random.randrange(4)
 242:     mirror = random.random() < 0.5
 243:     inp = _gen_transform(inp, rotations, mirror)
 244:     out = _gen_transform(out, rotations, mirror)
 245: 
 246:     if not np.array_equal(main(inp), out):
 247:         return None
 248:     return inp
 249: 
 250: 
 251: def generate_input() -> np.ndarray:
