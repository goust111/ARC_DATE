  40:     for dr, dc in dirs:
  41:         r, c = sr + dr, sc + dc
  42:         previous_bg: Coord | None = None
  43:         while in_bounds(g.shape, r, c):
  44:             color = int(g[r, c])
  45:             if color == obstacle:
  46:                 assert previous_bg is not None, "marker should not touch obstacle directly"
  47:                 hits.append(((dr, dc), previous_bg))
  48:                 break
  49:             assert color == bg, "sightline should cross only background before obstacle"
  50:             previous_bg = (r, c)
  51:             r += dr
  52:             c += dc
  53: 
  54:     assert len(hits) == 1, "expected one cardinal sightline from marker to obstacle"
  55:     return hits[0]
  56: 
  57: 
  58: def _walk_contour(g: np.ndarray, start: Coord, direction: Coord, obstacle: int, bg: int) -> Coord:
  59:     dr, dc = direction
  60:     if dr:
  61:         turns = [(dr, -1), (dr, 1)]
  62:     else:
  63:         turns = [(-1, dc), (1, dc)]
  64: 
  65:     paths: list[tuple[int, Coord]] = []
  66:     for tr, tc in turns:
  67:         r, c = start
  68:         length = 0
  69:         while True:
  70:             nr, nc = r + tr, c + tc
  71:             if not in_bounds(g.shape, nr, nc):
  72:                 break
  73:             if int(g[nr, nc]) != bg:
  74:                 break
  75:             if not _adjacent_to_color(g, (nr, nc), obstacle):
  76:                 break
  77:             r, c = nr, nc
  78:             length += 1
  79:         paths.append((length, (r, c)))
  80: 
  81:     max_len = max(length for length, _ in paths)
  82:     endpoints = {pos for length, pos in paths if length == max_len}
  83:     assert len(endpoints) == 1, "contour walk should have one structural endpoint"
  84:     return endpoints.pop()
  85: 
  86: 
  87: def main(grid: np.ndarray) -> np.ndarray:
  88:     """
  89:     Move the single marker to the endpoint reached by sliding along the obstacle contour.
  90: 
  91:     Input structure:
  92:     - A dominant background color fills the canvas.
  93:     - One single-pixel marker sits away from a connected obstacle region of the
  94:       remaining color.
  95:     - The marker has exactly one horizontal or vertical sightline to the obstacle.
  96: 
  97:     Rule:
  98:     - Find the last background pixel before the obstacle along that sightline.
  99:     - From that pixel, try the two diagonal turns that continue around the
 100:       obstacle boundary.
 101:     - Move the marker to the endpoint of the turn that remains 4-adjacent to the
 102:       obstacle for the longest distance.
 103: 
 104:     Key insight:
 105:     The marker is not placed by distance to the obstacle; it first points to the
 106:     obstacle, then follows the visible outside contour until that contour segment ends.
 107:     """
 108:     g = np.asarray(grid, dtype=int)
 109:     bg = get_bg(g)
 110:     marker = _unique_marker_color(g, bg)
 111:     obstacle = _obstacle_color(g, bg, marker)
 112: 
 113:     marker_coords = np.argwhere(g == marker)
 114:     assert marker_coords.shape == (1, 2), "expected exactly one marker pixel"
 115:     marker_pos = tuple(map(int, marker_coords[0]))
 116: 
 117:     direction, contour_start = _sightline_to_obstacle(g, marker_pos, obstacle, bg)
 118:     assert _adjacent_to_color(g, contour_start, obstacle), "contour must start next to obstacle"
 119:     dest = _walk_contour(g, contour_start, direction, obstacle, bg)
 120:     assert int(g[dest]) == bg, "destination should be background"
===== lines 120-260 =====
 120:     assert int(g[dest]) == bg, "destination should be background"
 121: 
 122:     out = g.copy()
 123:     out[marker_pos] = bg
 124:     out[dest] = marker
 125:     return out
 126: 
 127: # --------------- generator (att2) ---------------
 128: 
 129: BG_COLOR = 7
 130: GEN_RETRIES = 300
 131: 
 132: # Obstacle shape bounds.
 133: OBSTACLE_HEIGHT_RANGE = (4, 8)
 134: OBSTACLE_WIDTH_RANGE = (3, 8)
 135: OBSTACLE_AREA_RANGE = (6, 33)
 136: MAX_BOUNDARY_LEFT = 7
 137: BOUNDARY_STEP_PROB = 0.55
 138: 
 139: # Marker sightline and contour-walk bounds.
 140: WALK_LEN_RANGE = (1, 4)
 141: SIGHTLINE_GAP_RANGE = (2, 5)
 142: CANVAS_SIZE_RANGE = (6, 16)
 143: 
 144: 
 145: def _gen_boundary(h: int, start_row: int, walk_len: int, start_left: int) -> list[int]:
 146:     lefts = [0] * h
 147:     lefts[start_row] = start_left
 148: 
 149:     for r in range(start_row - 1, -1, -1):
 150:         if lefts[r + 1] == 0:
 151:             lefts[r] = 0
 152:         else:
 153:             lefts[r] = lefts[r + 1] - random.randint(0, 1)
 154: 
 155:     for i in range(1, walk_len + 1):
 156:         lefts[start_row + i] = start_left + i
 157: 
 158:     stop_row = start_row + walk_len + 1
 159:     if stop_row < h:
 160:         lefts[stop_row] = lefts[stop_row - 1]
 161:         for r in range(stop_row + 1, h):
 162:             if lefts[r - 1] < MAX_BOUNDARY_LEFT and random.random() < BOUNDARY_STEP_PROB:
 163:                 lefts[r] = lefts[r - 1] + 1
 164:             else:
 165:                 lefts[r] = lefts[r - 1]
 166: 
 167:     return lefts
 168: 
 169: 
 170: def _gen_transform(g: np.ndarray, rotations: int, mirror: bool) -> np.ndarray:
 171:     out = np.rot90(g, rotations)
 172:     if mirror:
 173:         out = np.fliplr(out)
 174:     return out.copy()
 175: 
 176: 
 177: def _gen_attempt() -> np.ndarray | None:
 178:     bg = BG_COLOR
 179:     colors = [c for c in range(10) if c != bg]
 180:     obstacle = random.choice(colors)
 181:     marker = random.choice([c for c in colors if c != obstacle])
 182: 
 183:     h = random.randint(*OBSTACLE_HEIGHT_RANGE)
 184:     walk_len = random.randint(WALK_LEN_RANGE[0], min(WALK_LEN_RANGE[1], h - 3))
 185:     start_row = random.randint(1, h - walk_len - 2)
 186:     gap = random.randint(*SIGHTLINE_GAP_RANGE)
 187: 
 188:     max_start_left = min(gap, MAX_BOUNDARY_LEFT - walk_len)
 189:     if max_start_left < 1:
 190:         return None
 191:     start_left = random.randint(1, max_start_left)
 192: 
 193:     lefts = _gen_boundary(h, start_row, walk_len, start_left)
 194:     min_left = min(lefts)
 195:     max_left = max(lefts)
 196:     sum_lefts = sum(lefts)
 197: 
 198:     w_min = max(
 199:         OBSTACLE_WIDTH_RANGE[0],
 200:         max_left + 1,
 201:         min_left + 3,
 202:         (OBSTACLE_AREA_RANGE[0] + sum_lefts + h - 1) // h,
 203:     )
 204:     w_max = min(OBSTACLE_WIDTH_RANGE[1], (OBSTACLE_AREA_RANGE[1] + sum_lefts) // h)
 205:     if w_min > w_max:
 206:         return None
 207:     w = random.randint(w_min, w_max)
 208:     area = h * w - sum_lefts
 209:     if not (OBSTACLE_AREA_RANGE[0] <= area <= OBSTACLE_AREA_RANGE[1]):
 210:         return None
 211: 
 212:     c0 = gap - start_left + 1
 213:     min_cols = max(CANVAS_SIZE_RANGE[0], c0 + w)
 214:     possible_cols = [
 215:         cols
 216:         for cols in range(min_cols, CANVAS_SIZE_RANGE[1] + 1)
 217:         if max(CANVAS_SIZE_RANGE[0], h, (2 * area + 2 + cols - 1) // cols) <= CANVAS_SIZE_RANGE[1]
 218:     ]
 219:     if not possible_cols:
 220:         return None
 221:     cols = random.choice(possible_cols)
 222:     min_rows = max(CANVAS_SIZE_RANGE[0], h, (2 * area + 2 + cols - 1) // cols)
 223:     rows = random.randint(min_rows, CANVAS_SIZE_RANGE[1])
 224:     r0 = random.randint(0, rows - h)
 225: 
 226:     out = np.full((rows, cols), bg, dtype=int)
 227:     for rr, left in enumerate(lefts):
 228:         out[r0 + rr, c0 + left : c0 + w] = obstacle
 229: 
 230:     contour_start = (r0 + start_row, gap)
 231:     dest = (contour_start[0] + walk_len, contour_start[1] + walk_len)
 232:     marker_pos = (contour_start[0], 0)
 233: 
 234:     if out[dest] != bg or out[marker_pos] != bg:
 235:         return None
 236: 
 237:     inp = out.copy()
