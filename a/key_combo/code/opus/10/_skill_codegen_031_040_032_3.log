            if inb(g.shape,rr,cc) and g[rr,cc]==BG and not seen[rr,cc]: seen[rr,cc]=1; q.append((rr,cc))
    return seen

def main_like(g):
    pos=tuple(map(int,np.argwhere(g==RED)[0]))
    dirs=[(-1,0),(1,0),(0,-1),(0,1)]
    hits=[]
    for dr,dc in dirs:
        r,c=pos[0]+dr,pos[1]+dc
        last=None
        ok=True
        while inb(g.shape,r,c):
            if g[r,c]==GRN:
                if last is not None: hits.append(((dr,dc),last))
                break
