    h, w = g.shape

    candidates: list[np.ndarray] = []
    if w % 2 == 0:
        left = g[:, : w // 2]
        right = g[:, w // 2 :]
        if np.array_equal(left, right):
            candidates.append(left)

    if h % 2 == 0:
        top = g[: h // 2, :]
        bottom = g[h // 2 :, :]
        if np.array_equal(top, bottom):
            candidates.append(top)

    assert len(candidates) == 1
    return candidates[0].copy()

