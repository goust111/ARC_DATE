    if len(components) != fragment_count:
        return None
    groups = _merged_fragment_groups(components)
    if len(groups) != 1 or tuple(groups[0]["bbox"]) != (0, 0, RECT_HEIGHT - 1, width - 1):
        return None
    return labels > 0


def _gen_bboxes():
