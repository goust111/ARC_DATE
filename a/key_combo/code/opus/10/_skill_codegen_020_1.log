+    residue_counts = _residue_counts(clean.shape[0], clean.shape[1], period)
+    order = [preferred_kind, "diag", "row", "col"]
+    seen: set[str] = set()
+    for kind in order:
+        if kind in seen:
+            continue
+        seen.add(kind)
+        pairs = _candidate_marker_pairs(clean, period, residue_counts, kind)
+        if pairs:
