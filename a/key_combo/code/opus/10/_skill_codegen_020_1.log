+def _full_separator_indices(grid: np.ndarray, color: int) -> tuple[list[int], list[int]]:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == color)]
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == color)]
+    return rows, cols
