+        if np.count_nonzero(tile == BACKGROUND) < period:
+            continue
+        if np.count_nonzero(tile == color) < period:
+            continue
+        if any(np.all(tile[r, :] == tile[r, 0]) for r in range(period)):
+            continue
+        if any(np.all(tile[:, c] == tile[0, c]) for c in range(period)):
