+    out = g.copy()
+    sep_rows, sep_cols = _full_separator_indices(g, SEPARATOR)
+    row_ranges = _intervals(g.shape[0], sep_rows)
+    col_ranges = _intervals(g.shape[1], sep_cols)
+
+    for r0, r1 in row_ranges:
+        for c0, c1 in col_ranges:
