+    h, w = clean.shape
+    residue_counts = _residue_counts(h, w, period)
+    forbidden = {
+        markers[0],
+        markers[1],
+    }
+    forbidden_residues = {
+        (markers[0][0] % period, markers[0][1] % period),
+        (markers[1][0] % period, markers[1][1] % period),
