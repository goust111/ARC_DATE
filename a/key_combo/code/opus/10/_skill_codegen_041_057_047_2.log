+    index = {rc: i for i, rc in enumerate(nodes)}
+    adj = [[] for _ in nodes]
+    for i, (r, c) in enumerate(nodes):
+        for nr, nc in _neighbors4(r, c):
+            j = index.get((nr, nc))
