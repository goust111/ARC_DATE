+import numpy as np
+
+
+BG = 0
+GREY = 5
+BAR = 2
+PATH = 3
+SQUARE = 8
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+INF = 10**9
+
