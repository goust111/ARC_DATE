+
+    for v, mask in enumerate(node_term_mask):
+        sub = mask
+        while sub:
+            if 1 < dist[sub][v]:
+                dist[sub][v] = 1
+                parent[sub][v] = ("init",)
+            sub = (sub - 1) & mask
+
+    for mask in range(1, full_mask + 1):
+        sub = (mask - 1) & mask
+        while sub:
+            other = mask ^ sub
+            if sub <= other:
+                dv = dist[sub]
+                ov = dist[other]
+                mv = dist[mask]
+                pv = parent[mask]
+                for v in range(n):
+                    cand = dv[v] + ov[v] - 1
+                    if cand < mv[v]:
