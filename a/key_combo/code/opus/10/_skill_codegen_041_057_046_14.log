+        children, segment = _apply_split(region, orientation, pos)
+        regions.extend(children)
+        segments.append(segment)
+        orientations_used.add(orientation)
+
+    areas = [(r1 - r0 + 1) * (c1 - c0 + 1) for r0, c0, r1, c1 in regions]
