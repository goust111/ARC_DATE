+    scene = g[sep_row:, :]
+    scene[scene == BLACK] = GREY
+
+    meta = {
+        "sep_row": sep_row,
+        "stop_reason": stop_reason,
+        "collision_pos": collision_pos,
+        "path": tuple(path),
+        "bounce_events": tuple(bounce_events),
