+    right_patch = grid[dict_r0 : dict_r0 + 3, sep_col + 1 : sep_col + 4]
+    left_mask = left_patch == LEFT_GLYPH_COLOR
+    right_mask = right_patch == RIGHT_GLYPH_COLOR
