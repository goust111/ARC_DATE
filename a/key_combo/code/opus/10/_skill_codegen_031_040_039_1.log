+
+
+def _stamp(grid: np.ndarray, center_r: int, center_c: int, color: int, mask: np.ndarray) -> None:
+    for dr in range(-1, 2):
+        for dc in range(-1, 2):
+            if not bool(mask[dr + 1, dc + 1]):
+                continue
+            rr = center_r + dr
+            cc = center_c + dc
+            if _in_bounds(grid.shape, rr, cc):
