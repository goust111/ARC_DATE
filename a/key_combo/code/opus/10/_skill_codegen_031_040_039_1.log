+        if enable_collision and int(g[nr, nc]) not in (BLACK, GREEN):
+            collision_pos = (nr, nc)
+            stop_reason = "collision"
+            break
+
+        g[nr, nc] = GREEN
+        r, c = nr, nc
+        path.append((r, c))
