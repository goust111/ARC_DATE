+    glyphs: list[np.ndarray] = []
+    for bits in range(1 << 9):
+        mask = np.array([(bits >> i) & 1 for i in range(9)], dtype=bool).reshape(3, 3)
+        area = int(mask.sum())
+        if not (3 <= area <= 6):
+            continue
+        if _is_connected(mask):
+            glyphs.append(mask)
+    return tuple(glyphs)
+
+
