+        sign = int(detour_rule(int(obstacle["color"]), str(obstacle["half"])))
+        assert sign in (-1, 1)
+
+        raw_target_r = int(obstacle["r0"]) - 1 if sign < 0 else int(obstacle["r1"]) + 1
+        target_r = raw_target_r + sign if raw_target_r == divider else raw_target_r
