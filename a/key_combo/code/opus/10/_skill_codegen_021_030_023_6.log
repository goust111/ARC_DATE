+
+    return lane, plan
+
+
+def _wrong_rule_changes_output(grid: np.ndarray, correct_out: np.ndarray, detour_rule: DetourRule) -> bool:
+    try:
+        wrong_out, _ = _solve(grid, detour_rule)
+    except AssertionError:
+        return True
