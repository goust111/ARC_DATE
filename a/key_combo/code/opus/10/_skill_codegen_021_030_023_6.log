    else:
        if min_axis >= MAX_COLS_EXCL:
            return None
        w = int(np.random.randint(min_axis, MAX_COLS_EXCL))
        h_choices = [h for h in range(MIN_ROWS, MAX_ROWS_EXCL) if h != w]
        h = int(np.random.choice(h_choices))
    return h, w


