+            (UPPER, GREEN, lambda x: _gen_upper_green_cross(x, divider)),
+            (LOWER, BLUE, lambda x: _gen_lower_blue(x, divider, height)),
+            (LOWER, GREEN, lambda x: _gen_lower_green_cross(x, divider, height)),
+        )
+    else:
