+            while r + 1 < h and int(grid[r + 1, c]) == color:
+                r += 1
+            r1 = r
+
+            assert r1 > r0, "obstacle bars must have length >= 2"
+            assert r1 < divider or r0 > divider, "obstacles must stay on one side of the divider"
+            half = UPPER if r1 < divider else LOWER
