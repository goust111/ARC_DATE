+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        height, width, offsets, row_separator = _sample_layout()
+        grid = np.zeros((height, width), dtype=int)
+
+        if row_separator is not None:
+            grid[row_separator, :] = GREY
+
+        used_offsets = set(offsets)
+        for offset in offsets:
+            _paint_emergent_pair(grid, offset, row_separator)
+
+        available_counterexamples = [j for j in _candidate_pair_offsets(width) if j not in used_offsets]
+        if not available_counterexamples:
+            continue
+        _paint_counterexample_pair(grid, random.choice(available_counterexamples), row_separator)
+
+        blocked_cols = {j for j in used_offsets}
+        blocked_cols |= {width - 1 - j for j in used_offsets}
+        blocked_cols |= {j for j in available_counterexamples if np.all(grid[:, j] == GREY)}
+        blocked_cols |= {width - 1 - j for j in available_counterexamples if np.all(grid[:, width - 1 - j] == GREY)}
