+        plans = list(zip(pairs, side_choices))
+        band_widths = _column_band_widths(width, plans)
+        if any(b <= 0 for b in band_widths):
+            continue
+        if len(set(band_widths)) != len(band_widths):
+            continue
+
+        if not has_row_separator:
