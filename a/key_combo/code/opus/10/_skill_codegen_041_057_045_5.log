+    h, w = grid.shape
+    candidates = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if grid[r, c] == 0 and r != row_separator and c not in blocked_cols
+    ]
+    random.shuffle(candidates)
+    for r, c in candidates[: random.randint(0, max_count)]:
