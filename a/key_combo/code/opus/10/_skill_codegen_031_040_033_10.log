82: def _gen_grow_parts(total, n):
83:     n_twos = total - n
84:     parts = [2] * n_twos + [1] * (n - n_twos)
85:     random.shuffle(parts)
86:     return parts
87: 
88: def _gen_drop_parts(total, n):
89:     if n == 0:
90:         return []
91:     n_twos = random.randint(max(0, total - n), min(total // 2, n))
92:     n_ones = total - 2 * n_twos
93:     parts = [2] * n_twos + [1] * n_ones + [0] * (n - n_twos - n_ones)
94:     random.shuffle(parts)
95:     return parts
96: 
97: def _gen_widths(height, max_width):
98:     start = random.randint(START_WIDTH_MIN, START_WIDTH_MAX)
99:     diff = max_width - start
100:     grow_steps = random.randint((diff + 1) // 2, min(diff, height - 1))
101:     widths = [start]
102:     for inc in _gen_grow_parts(diff, grow_steps):
103:         widths.append(widths[-1] + inc)
104: 
105:     remaining = height - len(widths)
106:     min_end = max(1, max_width - 2 * remaining)
107:     end_width = random.randint(min_end, max_width)
108:     for dec in _gen_drop_parts(max_width - end_width, remaining):
109:         widths.append(widths[-1] - dec)
110:     return widths
111: 
112: def _gen_intervals(widths):
113:     left, right = 0, widths[0] - 1
114:     intervals = [(left, right)]
115:     for prev_width, width in zip(widths, widths[1:]):
116:         delta = width - prev_width
117:         if delta == 2:
