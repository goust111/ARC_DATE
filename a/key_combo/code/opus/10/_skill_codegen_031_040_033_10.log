358: def _paint_shadow(out: np.ndarray, shape_color: int, shadow_color: int, offset: tuple[int, int]) -> None:
359:     """Paint the shape-shaped shadow at `offset`, background cells only."""
360:     dr, dc = offset
361:     h, w = out.shape
362:     src = (out == shape_color)
363:     # Shift `src` by `offset` into a same-sized buffer (bounds via slicing).
364:     shifted = np.zeros_like(src)
365:     r_src = slice(max(0, -dr), h - max(0, dr))
366:     c_src = slice(max(0, -dc), w - max(0, dc))
367:     r_dst = slice(max(0, dr), h - max(0, -dr))
368:     c_dst = slice(max(0, dc), w - max(0, -dc))
369:     shifted[r_dst, c_dst] = src[r_src, c_src]
370:     mask = shifted & (out == BG)
371:     out[mask] = shadow_color
