51:                            for x1 in range(width - sprites[0].shape[0] + 1)
52:                            for x2 in range(width - sprites[1].shape[0] + 1)
53:                            for y1 in range(height - sprites[0].shape[1] + 1)
54:                            for y2 in range(height - sprites[1].shape[1] + 1) 
55:                            if not collision(object1=sprites[0], object2=sprites[1], r1=x1, r2=x2, c1=y1, c2=y2) ]
