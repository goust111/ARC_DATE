+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "coord_set": set(coords),
+                    "bbox": bbox,
+                    "cols": tuple(cols),
+                    "height": bbox[2] - bbox[0] + 1,
+                    "width": bbox[3] - bbox[1] + 1,
+                }
+            )
