+def _distance_and_side(obj: dict, left: int, right: int) -> tuple[int, str]:
+    center_col = (obj["bbox"][1] + obj["bbox"][3]) // 2
+    dist_left = abs(center_col - left)
+    dist_right = abs(center_col - right)
+    if dist_left < dist_right:
