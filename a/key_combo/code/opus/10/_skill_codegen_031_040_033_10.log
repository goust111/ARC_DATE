13: def main(grid: np.ndarray) -> np.ndarray:
14:     """
15:     Extend the central bottom bar color into the flanking columns as an upward stepped outline.
16: 
17:     Input structure
18:     - The grid has a background and exactly two foreground colors.
19:     - The bottom row is all foreground: one color forms a single interior contiguous bar, and the other color flanks it.
20:     - The interior bottom bar color is the color that gets extended; the flanking color remains unchanged.
21: 
22:     Rule
23:     - Keep the input unchanged, then add one bottom-bar-colored pixel in every bottom-row flanking column.
24:     - For each flanking column, compute its horizontal distance to the nearest end of the interior bar.
25:     - Place the new pixel in that same column, one row above the bottom for each distance step, with an additional one-row gap above the bottom row.
26: 
27:     Key insight
28:     - The bottom row is a ruler: distance from the central bar determines how high the matching color is lifted in each side column.
29:     """
30:     g = np.asarray(grid, dtype=int)
31:     assert g.ndim == 2, "expected a 2D grid"
32:     height, width = map(int, g.shape)
33: 
34:     bg = get_bg(g)
35:     colors = colors_present(g, exclude={bg})
36:     assert len(colors) == 2, "expected exactly two foreground colors"
37: 
38:     bottom = g[height - 1, :]
39:     assert np.all(bottom != bg), "expected a fully foreground bottom row"
40: 
41:     extension_candidates = []
42:     for color in colors:
43:         cols = np.flatnonzero(bottom == color)
44:         if _is_contiguous(cols) and 0 < int(cols[0]) and int(cols[-1]) < width - 1:
45:             extension_candidates.append(int(color))
46: 
47:     assert len(extension_candidates) == 1, "expected exactly one interior bottom bar color"
48:     extension_color = extension_candidates[0]
49:     flanking_color = [int(color) for color in colors if int(color) != extension_color]
50:     assert len(flanking_color) == 1, "expected one flanking color"
51:     flanking_color = flanking_color[0]
52: 
53:     bar_cols = np.flatnonzero(bottom == extension_color)
54:     assert _is_contiguous(bar_cols), "extension color must form one bottom bar"
55:     left = int(bar_cols[0])
56:     right = int(bar_cols[-1])
57: 
58:     out = g.copy()
59:     for col_raw in np.flatnonzero(bottom == flanking_color):
60:         col = int(col_raw)
61:         assert col < left or col > right, "flanking columns must lie outside the extension bar"
62:         distance = left - col if col < left else col - right
63:         row = height - distance - 2
64:         assert 0 <= row < height - 1, "computed extension pixel must be above the bottom row"
65:         assert int(out[row, col]) == bg, "extension target must be background"
66:         out[row, col] = extension_color
67: 
68:     return out
69: 
