+        bbox = _bbox(list(coords))
+
+        objects.append(
+            {
+                "shape": shape["name"],
+                "color": None,
+                "coords": coords,
+                "bbox": bbox,
+                "cols": tuple(sorted({c for _, c in coords})),
+                "distance": distance,
+                "side": side,
+                "height": shape_h,
+                "width": shape_w,
+                "require_overlap": role["require_overlap"],
