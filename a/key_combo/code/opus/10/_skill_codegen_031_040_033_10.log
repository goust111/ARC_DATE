100:         if int((g[int(r)] != int(bg)).sum()) >= 2:
101:             ctrl_r = int(r)
102:             break
103:     assert not (ctrl_r is None)
104: 
105:     ctrl = [int(g[int(ctrl_r), int(c)]) for c in range(int(W)) if int(g[int(ctrl_r), int(c)]) != int(bg)]
