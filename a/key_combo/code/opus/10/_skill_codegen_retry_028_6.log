+    w_b = random.randint(5, 8)
+    h_c = random.randint(5, 8)
+    w_c = random.randint(5, 8)
+    gap_ab = random.randint(2, 4)
+    delta = random.randint(1, min(2, w_b - 3, w_c - 3))
+
+    a = (h_b - 3, 0, h_b + 4, w_a - 1)
+    b = (0, w_a + gap_ab, h_b - 1, w_a + gap_ab + w_b - 1)
