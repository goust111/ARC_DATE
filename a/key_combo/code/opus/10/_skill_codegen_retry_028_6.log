+def _mst_edges(edges: list[dict], n_nodes: int) -> list[dict]:
+    if n_nodes <= 1:
+        return []
+
+    parent = list(range(n_nodes))
+
+    def find(x: int) -> int:
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
