+def _tree_weight(edge_subset: Iterable[int], edges: list[dict], n_nodes: int) -> int | None:
+    subset = list(edge_subset)
+    if len(subset) != n_nodes - 1:
+        return None
+    parent = list(range(n_nodes))
+
+    def find(x: int) -> int:
+        while parent[x] != x:
+            parent[x] = parent[parent[x]]
+            x = parent[x]
+        return x
