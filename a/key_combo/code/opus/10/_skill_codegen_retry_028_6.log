+        out[r1, c0 : c1 + 1] = color
+        if r0 == r1:
+            out[r0, left[3]] = BG
+            out[r0, right[1]] = BG
+        elif r0 + 1 <= r1 - 1:
+            out[r0 + 1 : r1, left[3]] = BG
+            out[r0 + 1 : r1, right[1]] = BG
+    else:
+        upper = frames[edge["a"]]["bbox"]
+        lower = frames[edge["b"]]["bbox"]
+        out[r0 : r1 + 1, c0] = color
+        out[r0 : r1 + 1, c1] = color
+        if c0 == c1:
+            out[upper[2], c0] = BG
+            out[lower[0], c0] = BG
+        elif c0 + 1 <= c1 - 1:
+            out[upper[2], c0 + 1 : c1] = BG
+            out[lower[0], c0 + 1 : c1] = BG
