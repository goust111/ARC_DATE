+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+LEGEND_SEQ = (RED, GREEN, BLUE)
+COUNT_TO_COLOR = {1: RED, 2: GREEN, 3: BLUE}
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
