+        assert np.all(np.isin(interior, [BG, ORANGE])), "frame interior must contain only bg/markers"
+        count = int(np.sum(interior == ORANGE))
+        assert 1 <= count <= 3, f"marker count out of range: {count}"
+        rel = np.argwhere(interior == ORANGE)
