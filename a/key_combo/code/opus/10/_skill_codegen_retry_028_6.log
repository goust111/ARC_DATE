+                else:
+                    upper_i, lower_i, upper, lower = j, i, b, a
+                overlap0 = max(upper[1], lower[1])
+                overlap1 = min(upper[3], lower[3])
+                if overlap1 - overlap0 + 1 >= 3:
+                    c0 = overlap0 + 1
+                    c1 = overlap1 - 1
+                    r0 = upper[2] + 1
+                    r1 = lower[0] - 1
+                    if c0 <= c1 and r0 <= r1 and np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == BG):
+                        edges.append(
+                            {
+                                "kind": "v",
+                                "a": upper_i,
+                                "b": lower_i,
+                                "gap": r1 - r0 + 1,
+                                "r0": r0,
+                                "r1": r1,
+                                "c0": c0,
+                                "c1": c1,
+                            }
