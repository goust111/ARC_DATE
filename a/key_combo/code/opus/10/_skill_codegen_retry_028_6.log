+    h, w = patch_h, patch_w
+    for _ in range(turns):
+        rotated = []
+        for r0, c0, r1, c1 in current:
+            corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
+            rc = [(c, h - 1 - r) for r, c in corners]
+            rs = [p[0] for p in rc]
+            cs = [p[1] for p in rc]
+            rotated.append((min(rs), min(cs), max(rs), max(cs)))
+        current = rotated
+        h, w = w, h
+    return current, h, w
