+def _apply_edge(out: np.ndarray, frames: list[dict], color: int, edge: dict) -> None:
+    r0, r1, c0, c1 = edge["r0"], edge["r1"], edge["c0"], edge["c1"]
+    if edge["kind"] == "h":
+        left = frames[edge["a"]]["bbox"]
+        right = frames[edge["b"]]["bbox"]
