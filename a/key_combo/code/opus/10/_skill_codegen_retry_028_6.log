+    patch_w = max(a[3], b[3], c[3]) + 1
+    turns = random.randrange(4)
+    boxes, patch_h, patch_w = _rotate_boxes([a, b, c], patch_h, patch_w, turns)
+    return {
+        "boxes": boxes,
+        "counts": [count, count, count],
+        "patch_h": patch_h,
+        "patch_w": patch_w,
+    }
