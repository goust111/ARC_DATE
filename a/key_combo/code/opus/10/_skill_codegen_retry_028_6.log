+    orange_cover = np.zeros(grid.shape, dtype=int)
+    for coords in grey_comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        h, w = patch.shape
+        if h < 5 or w < 5:
