+    assert coords.size > 0, "expected foreground"
+    return coords
+
+
+def _ordered_simple_path(grid: np.ndarray, bg: int) -> list[tuple[int, int]]:
+    pts = {tuple(map(int, rc)) for rc in np.argwhere(grid != bg)}
+    assert pts, "expected foreground"
