+    r_max, c_max = fg.max(axis=0)
+    min_side = int(max(r_max - r_min + 1, c_max - c_min + 1))
+    if min_side % 2 == 0:
+        min_side += 1
+
+    candidates: list[dict] = []
+    rotation_kinds = [
+        ("quarter_turn", (0, 1, 2, 3)),
+        ("half_turn", (0, 2)),
+    ]
