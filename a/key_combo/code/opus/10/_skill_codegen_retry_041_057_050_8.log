+
+    if chosen["kind"] != "half_turn":
+        return None
+
+    if np.array_equal(_naive_reverse_input_only(grid, 0), chosen["output"]):
+        return None
+
+    if chosen["side"] < 7:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
