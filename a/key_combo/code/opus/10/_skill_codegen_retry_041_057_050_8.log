+    path = [endpoints[0]]
+    prev = None
+    cur = endpoints[0]
+    while cur != endpoints[1]:
+        nxts = [nb for nb in _neighbors4(*cur) if nb in pts and nb != prev]
+        assert len(nxts) == 1, "path traversal must be unique"
+        prev, cur = cur, nxts[0]
