+    start = min(pts)
+    seen = set()
+    q = deque([start])
+    seen.add(start)
+    while q:
+        cur = q.popleft()
+        for nxt in _neighbors4(*cur):
+            if nxt in pts and nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
