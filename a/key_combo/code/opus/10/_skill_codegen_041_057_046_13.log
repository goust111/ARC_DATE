84: 
85:     for color in colors:
86:         # Randomly choose the width of the rectangle, should not be too short and should be odd
87:         w, h = np.random.randint(2, 6) * 2 + 1, 3
88:         rectangle_sprite = np.full((w, h), color)
89: 
90:         # randomly flipped to create different orientations
91:         if np.random.rand() < 0.5:
92:             rectangle_sprite = np.rot90(rectangle_sprite, k=-1)
93: 
94:         # Randomly choose the position of the rectangle
95:         try:
96:             _loc = first_free_location(grid, rectangle_sprite, transparent=Color.BLACK, border=0, padding=1, padding_connectivity=8)
