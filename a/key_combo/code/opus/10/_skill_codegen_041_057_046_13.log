14: def main(input_grid):
15:     """
16:     Return the smaller object from the pair that has the same shape at different scales.
17: 
18:     Input structure:
19:     - The grid has a most-common background color.
20:     - Three colored objects are present, one of them a distractor.
21:     - Two objects share shape but differ in color and scale, and the larger may be clipped.
22: 
23:     Rule:
24:     - Split candidate objects by color against the background.
25:     - Compare object masks after scaling smaller candidates by factors of 2 or 3.
26:     - Crop and return the unique smaller object that matches a larger scaled object.
27: 
28:     Key insight:
29:     - Shape matching ignores color and allows the scaled larger object to be partially outside the canvas.
30:     """
31:     # Plan:
32:     # 1. Find the background color
33:     # 2. Extract objects by color
34:     # 3. Define a helper function to check if two objects are the same shape but different color/scale, remembering that the bigger one might be partially out of the canvas
35:     # 4. Iterate all candidate objects and check if they are the same shape but different color/scale
36:     # 5. Return what we find
37: 
38:     # Determine the background color, which is the most common color in the grid
39:     colors = np.unique(input_grid)
40:     background = colors[np.argmax([np.sum(input_grid == c) for c in colors])]
41:     object_colors = [c for c in colors if c != background]
42: 
43:     # Extract the objects, each of which is a different color.
44:     # This means we can split the canvas by color, instead of using connected components.
45:     objects = []
46:     for color in object_colors:
47:         object = np.copy(input_grid)
48:         object[input_grid != color] = background
49:         objects.append(object)
50:     
51:     # Define a helper function for checking if two objects are different color/scale but same shape
52:     # This has to handle the case where the bigger object is partially outside the grid
53:     def same_shape_different_color_different_scale(obj1, obj2):
54:         # obj1 is the smaller object
55:         if np.sum(obj1 != background) > np.sum(obj2 != background): return False
56: 
57:         b1 = bbox(obj1 != background)
58:         b2 = bbox(obj2 != background)
59:         if b1 is None or b2 is None:
60:             return False
61:         mask1 = (crop_bbox(obj1, b1) != background)
62:         mask2 = (crop_bbox(obj2, b2) != background)
63: 
64:         # Loop through all possible scale factors
65:         for scale_factor in range(2, 4):
66:             scaled_mask1 = scale_sprite(mask1, scale_factor)
67:             # loop over all possible places that we might put mask2, which starts anywhere in the scaled_mask1
68:             # note that we are only doing this because there can be objects that fall outside of the canvas
69:             # otherwise we would just compare the two masks directly
70:             for dr, dc in np.ndindex(scaled_mask1.shape):
71:                 if np.array_equal(scaled_mask1[dr : dr + mask2.shape[0], dc : dc + mask2.shape[1]], mask2):
72:                     return True
73:         return False
74:     
75:     output_grid_candidates = []
76:     # Iterate all candidate objects
77:     for obj in objects:
78:         other_objects = [o for o in objects if o is not obj]
79:         if any( same_shape_different_color_different_scale(obj, other_obj) for other_obj in other_objects ):
80:             output_grid_candidates.append(obj)
81: 
82:     # Check if the generated input grid is valid
83:     assert len(output_grid_candidates) == 1, f"Should only have one output grid candidate, have {len(output_grid_candidates)}"
84: 
85:     _b = bbox(output_grid_candidates[0] != background)
86:     assert _b is not None
87:     output_grid = crop_bbox(output_grid_candidates[0], _b)
88: 
89:     return output_grid
90: 
