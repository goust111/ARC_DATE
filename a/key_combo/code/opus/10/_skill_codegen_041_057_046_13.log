13: def main(input_grid):
14:     """
15:     Rotate the filled template region into each following empty region.
16: 
17:     Input structure:
18:     - Gray divider lines split the grid into same-sized regions.
19:     - Exactly one region contains a non-black, non-gray template.
20:     - Later regions are black slots for rotated copies.
21: 
22:     Rule:
23:     - Locate full gray row or column dividers and derive the region slices.
24:     - Find the first region containing template pixels.
25:     - Fill each subsequent region with the next 90-degree clockwise rotation.
26: 
27:     Key insight:
28:     - The dividers define ordered slots; the template supplies the repeated rotation sequence.
29:     """
30:     divider = Color.GREY
31:     bg = Color.BLACK
32:     H, W = input_grid.shape
33: 
34:     # Identify divider lines (either full columns or full rows of divider color).
35:     col_divs = [c for c in range(W) if np.all(input_grid[:, c] == divider)]
36:     row_divs = [r for r in range(H) if np.all(input_grid[r, :] == divider)]
37: 
38:     output_grid = input_grid.copy()
39: 
40:     if col_divs and not row_divs:
41:         cuts = [-1] + sorted(col_divs) + [W]
42:         regions = []
43:         for i in range(len(cuts) - 1):
44:             c0 = cuts[i] + 1
45:             c1 = cuts[i + 1] - 1
46:             if c0 <= c1:
47:                 regions.append((0, c0, H, c1 + 1))
48:     else:
49:         cuts = [-1] + sorted(row_divs) + [H]
50:         regions = []
51:         for i in range(len(cuts) - 1):
52:             r0 = cuts[i] + 1
53:             r1 = cuts[i + 1] - 1
54:             if r0 <= r1:
55:                 regions.append((r0, 0, r1 + 1, W))
56: 
57:     # Find the template region: the one containing non-black, non-divider pixels.
58:     template_idx = None
59:     template = None
60:     for idx, (r0, c0, r1, c1) in enumerate(regions):
61:         sub = input_grid[r0:r1, c0:c1]
62:         if np.any((sub != bg) & (sub != divider)):
63:             template_idx = idx
64:             template = sub.copy()
65:             break
66:     assert template is not None and template_idx is not None
67: 
68:     # Fill each subsequent region with successive 90° clockwise rotations.
69:     rot = template
70:     for (r0, c0, r1, c1) in regions[template_idx + 1 :]:
71:         rot = np.rot90(rot, k=-1)
72:         output_grid[r0:r1, c0:c1] = rot
73:     return output_grid
74: 
