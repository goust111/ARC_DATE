+def _place_template(
+    grid: np.ndarray,
+    seed_row: int,
+    base_col: int,
+    offsets: set[tuple[int, int]],
+) -> bool:
+    h, w = grid.shape
+    for dr, dc in offsets:
+        r = seed_row + dr
+        c = base_col + dc
