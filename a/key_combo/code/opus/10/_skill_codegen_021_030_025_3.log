+    assert remaining >= 0
+    if remaining == 0:
+        return []
+
+    choices = [parts for parts in (2, 3, 4) if parts <= max_parts]
+    random.shuffle(choices)
+    for extra_colors in choices:
+        if extra_colors > remaining:
+            continue
+        for _ in range(200):
