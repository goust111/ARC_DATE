+        height = int(code_counts[color])
+        if sep_r - height < 0:
+            return False
+        if np.any(grid[sep_r - height : sep_r, c] != BG):
+            return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(16, 22)
+    w = random.randint(18, 24)
+    lower_gap = random.randint(3, 5)
+    sep_r = h - lower_gap - 2
+    if sep_r < 9:
+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    grid[sep_r, :] = SEP
