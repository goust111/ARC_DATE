+    total_colors = len(chosen_counts) + len(nonmatch_parts)
+    assert total_colors <= len(available_colors)
+    colors = random.sample(available_colors, total_colors)
+
+    row_values = []
+    color_cursor = 0
+    for freq in chosen_counts:
+        color = colors[color_cursor]
+        color_cursor += 1
