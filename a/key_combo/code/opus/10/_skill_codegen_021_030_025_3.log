+        "activated": activated,
+        "branches": branch_count,
+        "local_hits": local_hit_count,
+        "painted": painted,
+        "direct_row_hits": direct_row_hits,
+        "complex": branch_count > 0 or local_hit_count > 0,
+    }
+
