+
+    def hit_obstacle(
+        r: int,
+        c: int,
+        *,
+        full: bool,
+        blocked_entries: frozenset[tuple[int, int]] = frozenset(),
+    ) -> list[tuple[int, int, frozenset[tuple[int, int]]]]:
+        nonlocal branch_count, local_hit_count
+
+        key = (r, c, tuple(sorted(blocked_entries)))
