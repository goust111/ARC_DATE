+    return _solve_details(grid, write_output=True)["output"]
+
+
+TEMPLATES = {
+    "simple1": {(0, 0)},
+    "wake2u": {(0, 0), (-1, 1)},
+    "wake2d": {(0, 0), (1, 1)},
+    "split3": {(0, 0), (-1, 1), (1, 1)},
+    "split4u": {(0, 0), (-1, 1), (1, 1), (-2, 2)},
+    "split4d": {(0, 0), (-1, 1), (1, 1), (2, 2)},
+    "blocked2": {(0, 0), (-1, -1), (1, 1)},
