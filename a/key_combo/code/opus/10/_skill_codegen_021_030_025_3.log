+    choices = [2, 3, 4]
+    random.shuffle(choices)
+    for extra_colors in choices:
+        if extra_colors > remaining:
+            continue
+        for _ in range(200):
+            cuts = sorted(random.sample(range(1, remaining), extra_colors - 1)) if extra_colors > 1 else []
