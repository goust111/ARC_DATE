  "dst": "cell d of the marker block",
  "match_cond": "s and d occupy the same relative quadrant around the marker block: upper-left, upper-right, lower-left, or lower-right",
  "transform": "clear all original foreground pixels; write each singleton color into its matched marker-block cell"
}
</annotation>
