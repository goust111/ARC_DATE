            slice(col_starts[-1], w),
        ),
        (
            rows - 1,
            0,
            slice(row_starts[-1], h),
            slice(0, col_starts[0] + col_widths[0]),
        ),
        (
            rows - 1,
            cols - 1,
            slice(row_starts[-1], h),
            slice(col_starts[-1], w),
        ),
    ]
    random.shuffle(corner_specs)

    out = sprite.copy()
