def _gen_connected_hole_mask(cell_h, cell_w, area):
    cells = {(random.randrange(cell_h), random.randrange(cell_w))}
    frontier = set()
    for r, c in cells:
        for dr, dc in _GEN_NEIGHBORS_4:
            nr, nc = r + dr, c + dc
