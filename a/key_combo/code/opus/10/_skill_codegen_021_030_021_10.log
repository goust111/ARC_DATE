    r0 = random.randint(EDGE_MARGIN, h - EDGE_MARGIN - MARKER_SIZE)
    c0 = random.randint(EDGE_MARGIN, w - EDGE_MARGIN - MARKER_SIZE)
    colors = random.sample(FOREGROUND_COLORS, MARKER_COLOR_COUNT)
