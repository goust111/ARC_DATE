+    assert int(r1) == int(r0) + 1 and int(c1) == int(c0) + 1, "marker must be a 2x2 block"
+
+    block = g[int(r0) : int(r0) + MARKER_SIZE, int(c0) : int(c0) + MARKER_SIZE]
