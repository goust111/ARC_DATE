+    assert np.count_nonzero(g[r0 + 2 :, :]) == 0
+    assert np.count_nonzero(g[r0 : r0 + 2, :c0]) == 0
+    assert np.count_nonzero(g[r0 : r0 + 2, c0 + 2 :]) == 0
