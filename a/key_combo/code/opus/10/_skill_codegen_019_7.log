def _gen_paint_ring(grid: np.ndarray, offset: int, color: int) -> None:
    n = int(grid.shape[0])
    r0 = c0 = offset
    r1 = c1 = n - 1 - offset
    grid[r0, c0 : c1 + 1] = color
