+    coords = [(r0, c) for c in range(c0, c1 + 1)]
+    coords.extend((r, c1) for r in range(r0 + 1, r1 + 1))
+    if r1 > r0:
+        coords.extend((r1, c) for c in range(c1 - 1, c0 - 1, -1))
+    if c1 > c0:
+        coords.extend((r, c0) for r in range(r1 - 1, r0, -1))
+    return coords
