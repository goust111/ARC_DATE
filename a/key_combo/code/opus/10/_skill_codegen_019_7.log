+def _ring_coords(shape: tuple[int, int], layer: int) -> list[tuple[int, int]]:
+    height, width = map(int, shape)
+    r0 = c0 = int(layer)
+    r1 = height - 1 - int(layer)
+    c1 = width - 1 - int(layer)
+    assert 0 <= r0 <= r1 < height
+    assert 0 <= c0 <= c1 < width
