  frame: single non-bg color; forms 1-cell-thick border on all 4 edges of left panel plus full-width separator rows between bands
  left_panel:
    structure: frame with 1 hole per band; hole is 4-connected bg region
    hole_bbox: spans full band height; width <= band_inner_width (panel_width - 2)
