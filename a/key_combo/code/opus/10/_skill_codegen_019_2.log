+                "area": int(area),
+                "mask": mask.copy(),
+                "top": top,
+                "left": left,
+                "port_row": port_row,
+                "lane_row": int(lane_row),
+                "left_port": int(row_cols.min()),
+                "right_port": int(row_cols.max()),
