                start = int(left_hole["placed_left"] + left_hole["right_port"] + 1)
                stop = int(right_hole["placed_left"] + right_hole["left_port"] - 1)
                assert start <= stop, "bridge must contain at least one path cell"
                grid[row, start : stop + 1] = BLACK

