+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+RANK_TO_COLOR = {
+    1: BLUE,
+    2: RED,
+    3: GREEN,
+    4: YELLOW,
+}
+
+GROUP_LAYOUTS = [
+    [3, 2, 1],
+    [3, 2, 1, 1],
+    [2, 2, 1],
+    [2, 2, 1, 1],
+    [3, 3, 1],
+    [2, 2, 2, 1],
+]
+
+GROUP_AREA_OPTIONS = {
+    2: [(4, 6), (4, 7), (6, 7), (6, 8), (7, 8)],
+    3: [(4, 6, 7), (4, 6, 8), (4, 7, 8), (6, 7, 8)],
+}
+
+AREA_POOL = (4, 6, 7, 8)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bridge_decomposition(mask: np.ndarray) -> tuple[list[np.ndarray], dict[tuple[int, int], int], list[np.ndarray]]:
+    """Split black cells into cycle-rich hole components and bridge-path components."""
+    mask = np.asarray(mask, dtype=bool)
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    if not cells:
+        return [], {}, []
+
+    index_of = {cell: i for i, cell in enumerate(cells)}
+    adj = [[] for _ in cells]
+    for i, (r, c) in enumerate(cells):
+        for nr, nc in _neighbors4(r, c):
+            j = index_of.get((nr, nc))
+            if j is not None:
+                adj[i].append(j)
+
+    tin = [-1] * len(cells)
+    low = [0] * len(cells)
+    timer = 0
+    bridges: set[tuple[int, int]] = set()
+
+    def dfs(v: int, parent: int) -> None:
+        nonlocal timer
+        tin[v] = low[v] = timer
+        timer += 1
+        for to in adj[v]:
+            if to == parent:
+                continue
+            if tin[to] != -1:
+                low[v] = min(low[v], tin[to])
+                continue
+            dfs(to, v)
+            low[v] = min(low[v], low[to])
+            if low[to] > tin[v]:
+                bridges.add((v, to) if v < to else (to, v))
+
+    for start in range(len(cells)):
+        if tin[start] == -1:
+            dfs(start, -1)
+
+    seen = [False] * len(cells)
+    holes: list[np.ndarray] = []
+    hole_of: dict[tuple[int, int], int] = {}
+
+    for start in range(len(cells)):
+        if seen[start]:
+            continue
+        q = deque([start])
+        seen[start] = True
+        comp = []
+        while q:
+            v = q.popleft()
+            comp.append(cells[v])
+            for to in adj[v]:
+                edge = (v, to) if v < to else (to, v)
+                if edge in bridges or seen[to]:
+                    continue
+                seen[to] = True
+                q.append(to)
+        if len(comp) >= 2:
+            hid = len(holes)
+            coords = np.array(comp, dtype=int)
+            holes.append(coords)
+            for cell in comp:
+                hole_of[cell] = hid
+
+    bridge_mask = mask.copy()
+    for cell in hole_of:
+        bridge_mask[cell] = False
+    bridge_components = _find_components(bridge_mask)
+    return holes, hole_of, bridge_components
+
+
+def _hole_groups(
+    shape: tuple[int, int], holes: list[np.ndarray], hole_of: dict[tuple[int, int], int], bridge_components: list[np.ndarray]
+) -> list[list[int]]:
+    graph = [set() for _ in holes]
+    h, w = shape
+    for coords in bridge_components:
+        neighbor_holes = set()
+        for r, c in coords:
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < h and 0 <= nc < w:
+                    hid = hole_of.get((int(nr), int(nc)))
+                    if hid is not None:
+                        neighbor_holes.add(int(hid))
+        if len(neighbor_holes) == 2:
+            a, b = sorted(neighbor_holes)
+            graph[a].add(b)
+            graph[b].add(a)
+
+    groups: list[list[int]] = []
+    seen: set[int] = set()
+    for start in range(len(holes)):
+        if start in seen:
+            continue
+        q = deque([start])
+        seen.add(start)
+        group = []
+        while q:
+            cur = q.popleft()
+            group.append(cur)
+            for nxt in sorted(graph[cur]):
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+        groups.append(group)
+    return groups
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
