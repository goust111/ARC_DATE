+
+
+def _has_diagonal_neighbor_pair(centers: list[tuple[int, int]]) -> bool:
+    ordered = sorted(centers, key=lambda rc: (rc[1], rc[0]))
+    for (r0, c0), (r1, c1) in zip(ordered, ordered[1:]):
