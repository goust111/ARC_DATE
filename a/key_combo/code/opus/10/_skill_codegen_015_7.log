+    if use_dilation:
+        new_grey: set[tuple[int, int]] = set()
+        for coords in sprites:
+            for r_raw, c_raw in coords:
+                r = int(r_raw)
+                c = int(c_raw)
+                for nr, nc in _neighbors4(r, c):
+                    if _in_bounds(g.shape, nr, nc) and int(g[nr, nc]) == BLACK:
+                        new_grey.add((nr, nc))
+        for r, c in new_grey:
+            out[r, c] = GREY
