+def _candidate_grid() -> np.ndarray | None:
+    h = random.randint(*GRID_SIZE_RANGE)
+    w = random.randint(*GRID_SIZE_RANGE)
+
+    max_radius = min(DIAMOND_RADIUS_RANGE[1], (h - 3) // 2, (w - 3) // 2)
+    if max_radius < DIAMOND_RADIUS_RANGE[0]:
+        return None
+    radius = random.randint(DIAMOND_RADIUS_RANGE[0], max_radius)
+
+    cr = random.randint(radius + 1, h - radius - 2)
+    cc = random.randint(radius + 1, w - radius - 2)
+    grid = _diamond_outline((h, w), cr, cc, radius)
+
+    rel_centers, orientations = random.choice(SPRITE_LAYOUTS)
+    shift_r = random.randint(-1, 1)
+    shift_c = random.randint(-1, 1)
+    centers = [(cr + shift_r + dr, cc + shift_c + dc) for dr, dc in rel_centers]
+    sprite_cells = [_place_sprite_cells(center, shape_name) for center, shape_name in zip(centers, orientations)]
+
+    for cells in sprite_cells:
+        for r, c in cells:
+            if not _inside_outline(grid.shape, cr, cc, radius, r, c):
+                return None
+    if not _sprites_are_disjoint(sprite_cells):
+        return None
+
+    for cells in sprite_cells:
+        for r, c in cells:
+            grid[r, c] = GREY
+
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _candidate_grid()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid scanline-blocker ARC input")

