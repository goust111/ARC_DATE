+        ordered = sorted(sprites, key=lambda coords: (_bbox_center(coords)[1], _bbox_center(coords)[0]))
+        centers = [_bbox_center(coords) for coords in ordered]
+        for (r0, c0), (r1, c1) in zip(centers, centers[1:]):
