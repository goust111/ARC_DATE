+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_SIZE_RANGE = (15, 18)
+DIAMOND_RADIUS_RANGE = (5, 7)
+
+SPRITE_SHAPES = {
+    "h3": ((0, -1), (0, 0), (0, 1)),
+    "v3": ((-1, 0), (0, 0), (1, 0)),
+}
+
+SPRITE_LAYOUTS = (
+    (((0, 0), (3, 3)), ("h3", "v3")),
+    (((0, 0), (-3, 3)), ("v3", "h3")),
+    (((0, 0), (2, 2), (0, 4)), ("h3", "v3", "h3")),
+    (((0, 0), (-2, 2), (0, 4)), ("v3", "h3", "v3")),
+)
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_center(coords: np.ndarray) -> tuple[int, int]:
+    r0 = int(coords[:, 0].min())
+    r1 = int(coords[:, 0].max())
+    c0 = int(coords[:, 1].min())
+    c1 = int(coords[:, 1].max())
+    return (r0 + r1) // 2, (c0 + c1) // 2
+
+
+def _bresenham_points(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    points: list[tuple[int, int]] = []
+    dr = abs(r1 - r0)
+    dc = abs(c1 - c0)
+    sr = 1 if r0 < r1 else -1
+    sc = 1 if c0 < c1 else -1
+    err = dc - dr
+    r, c = r0, c0
+    while True:
+        points.append((r, c))
+        if r == r1 and c == c1:
+            break
+        e2 = 2 * err
+        if e2 > -dr:
+            err -= dr
+            c += sc
+        if e2 < dc:
+            err += dc
+            r += sr
+    return points
+
+
+def _draw_polyline(grid: np.ndarray, vertices: list[tuple[int, int]], color: int) -> None:
+    for (r0, c0), (r1, c1) in zip(vertices, vertices[1:]):
+        for r, c in _bresenham_points(r0, c0, r1, c1):
+            grid[r, c] = color
+
+
+def _scanline_fill(base: np.ndarray, working: np.ndarray) -> np.ndarray:
+    out = working.copy()
+    h, w = out.shape
+    for r in range(h):
+        cols = np.flatnonzero(base[r] == GREEN)
+        for left, right in zip(cols, cols[1:]):
+            if right - left <= 1:
+                continue
+            c = int(left) + 1
+            stop = int(right)
+            while c < stop:
+                while c < stop and out[r, c] != BLACK:
+                    c += 1
+                start = c
+                while c < stop and out[r, c] == BLACK:
+                    c += 1
+                if start < c:
+                    out[r, start:c] = RED
