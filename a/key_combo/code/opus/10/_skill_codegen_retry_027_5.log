+        target_idx = next(iter(touched_targets))
+        legend_idx = next(iter(touched_legends))
+        assert target_idx not in bindings, "a target may be bound by only one path"
+        bindings[target_idx] = (
+            legends[legend_idx]["replacement"],
+            legends[legend_idx]["source"],
