+def _place_patch(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    patch: np.ndarray,
+    row_range: tuple[int, int],
+    col_range: tuple[int, int],
+    padding: int,
+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    r_lo, r_hi = row_range
+    c_lo, c_hi = col_range
+    candidates = []
+    for top in range(r_lo, r_hi - h + 1):
+        for left in range(c_lo, c_hi - w + 1):
+            if _can_place(occ, patch, top, left, padding):
