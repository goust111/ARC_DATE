+            return None
+        frontier = sorted(set(frontier), key=lambda rc: (abs(rc[0] - start[0]) + abs(rc[1] - start[1]), rc))
+        chosen.add(random.choice(frontier[: max(3, min(8, len(frontier)))]))
+    return chosen
