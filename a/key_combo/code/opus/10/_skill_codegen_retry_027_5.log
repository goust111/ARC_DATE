+    if top < 0 or left < 0 or top + h > mask.shape[0] or left + w > mask.shape[1]:
+        return False
+    r0 = max(0, top - padding)
+    c0 = max(0, left - padding)
+    r1 = min(mask.shape[0], top + h + padding)
+    c1 = min(mask.shape[1], left + w + padding)
