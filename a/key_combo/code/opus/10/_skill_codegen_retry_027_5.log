+def _route_pair(
+    shape: tuple[int, int],
+    start_candidates: list[tuple[int, int]],
+    end_candidates: list[tuple[int, int]],
+    neutral: set[tuple[int, int]],
+    existing_paths: list[list[tuple[int, int]]],
