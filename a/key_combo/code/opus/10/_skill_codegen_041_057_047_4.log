+    if len(big_components) != big_count:
+        return None
+    nonred_smalls = [obj for obj in components if obj["area"] <= 4 and obj["color"] != RED]
+    if len(nonred_smalls) < sum(len(big["erasers"]) for big in bigs) + 1:
+        return None
+
+    for big in bigs:
