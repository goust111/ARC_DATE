+        built = _build_big_object(bh, bw, eraser_count)
+        if built is None:
+            return None
+
+        body_mask = built["body_mask"]
+        grid[r0 : r1 + 1, c0 : c1 + 1][body_mask] = color
+        for rr, cc in built["reds_local"]:
