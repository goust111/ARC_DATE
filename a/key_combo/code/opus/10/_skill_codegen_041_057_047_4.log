+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+BIG_COLORS = (BLUE, GREEN, YELLOW)
+SMALL_COLORS = (PINK, ORANGE, TEAL)
