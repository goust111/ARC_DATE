+                continue
+            nd = int(dist[r, c]) + 1
+            if int(dist[nr, nc]) == -1:
+                dist[nr, nc] = nd
+                ways[nr, nc] = ways[r, c]
+                q.append((nr, nc))
+            elif int(dist[nr, nc]) == nd:
