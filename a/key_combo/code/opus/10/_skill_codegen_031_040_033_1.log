+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    shape = (
+        int(rng.integers(15, 20)),
+        int(rng.integers(15, 20)),
+    )
+
+    path = _build_polyline_path(rng, shape)
+    if path is None or _turn_count(path) < 2 or len(path) - 1 < 5:
+        return None
