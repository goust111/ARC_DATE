+    return cells
+
+
+def _grow_branches(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    open_set: set[tuple[int, int]],
+    main_path_set: set[tuple[int, int]],
+    target_open: int,
+) -> bool:
+    h, w = map(int, shape)
+    while len(open_set) < target_open:
+        frontier: list[tuple[tuple[int, int], tuple[int, int], float]] = []
+        for r in range(1, h - 1):
