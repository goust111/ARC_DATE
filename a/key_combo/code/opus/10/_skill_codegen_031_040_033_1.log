+    counts = np.zeros(g.shape, dtype=int)
+
+    for r, c in markers:
+        hit = np.zeros(g.shape, dtype=bool)
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            while _in_bounds(g.shape, nr, nc) and int(g[nr, nc]) != BLUE:
+                if int(g[nr, nc]) == BLACK and (nr, nc) not in path_set:
+                    hit[nr, nc] = True
+                nr += dr
+                nc += dc
+        masks.append(hit)
+        counts += hit.astype(int)
+    return masks, counts
