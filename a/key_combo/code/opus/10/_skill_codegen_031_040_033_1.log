+        if seg_idx == n_segments:
+            return path
+
+        if prev_dir is None:
+            directions = DIRS4.copy()
+        else:
+            if prev_dir[0] != 0:
+                directions = [(0, -1), (0, 1)]
+            else:
+                directions = [(-1, 0), (1, 0)]
+        rng.shuffle(directions)
