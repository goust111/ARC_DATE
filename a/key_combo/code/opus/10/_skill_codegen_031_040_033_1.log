+    current = path[-1]
+    new_cells: list[tuple[int, int]] = []
+    combined = set(occupied)
+    for _ in range(length):
+        nr, nc = current[0] + dr, current[1] + dc
+        nxt = (nr, nc)
+        if not _interior(shape, nxt) or nxt in combined:
+            return None
+        if _open_neighbor_count(combined, nxt) != 1:
