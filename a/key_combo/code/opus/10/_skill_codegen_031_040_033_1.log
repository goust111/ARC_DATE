+    q = deque([start])
+    dist[start] = 0
+    ways[start] = 1
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds((h, w), nr, nc) or int(grid[nr, nc]) == BLUE:
+                continue
+            nd = int(dist[r, c]) + 1
+            if int(dist[nr, nc]) == -1:
+                dist[nr, nc] = nd
+                ways[nr, nc] = ways[r, c]
+                q.append((nr, nc))
+            elif int(dist[nr, nc]) == nd:
+                ways[nr, nc] = min(2, int(ways[nr, nc]) + int(ways[r, c]))
