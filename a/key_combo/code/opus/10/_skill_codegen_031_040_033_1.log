+        dr = door[0] - parent[0]
+        dc = door[1] - parent[1]
+        depths = list(range(3, 11))
+        widths = list(range(3, 11))
+        depths.sort(reverse=True)
+        widths.sort(reverse=True)
+
+        for depth in depths:
+            for width in widths:
+                rects: list[set[tuple[int, int]]] = []
