+    for r, c in np.argwhere(mask):
+        rr, cc = int(r), int(c)
+        if seen[rr, cc]:
+            continue
+        count += 1
+        q = deque([(rr, cc)])
+        seen[rr, cc] = True
+        while q:
+            cr, cc = q.popleft()
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
