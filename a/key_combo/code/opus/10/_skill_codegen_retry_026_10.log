0006: # patterns, positioning, copying
0007: 
0008: # description:
0009: # In the input you will see a pattern of pixels in the top left corner of the grid, the top right corner of the grid, the bottom left corner of the grid, and the bottom right corner of the grid. All the pixels are the same color, and the patterns are in square regions.
0010: # To make the output, copy the pattern in each corner of the input to the corresponding corner of the output. The output grid is one pixel larger in each dimension than the maximum pattern side length.
0011: 
0012: def main(input_grid):
0013:     """
0014:     Copy the four corner patterns into a minimal square output frame.
0015: 
0016:     Input structure:
0017:     - Same-color patterns occupy square regions in the four input corners.
0018:     - Black cells separate the corner regions.
0019:     - At least one foreground pixel is present.
0020: 
0021:     Rule:
0022:     - Assign foreground pixels to their nearest input corner.
0023:     - Infer the largest needed corner square side length.
0024:     - Copy each corner square into the corresponding corner of an output one cell larger.
0025: 
0026:     Key insight:
0027:     - The task preserves each pattern's corner-relative offsets while shrinking the canvas.
0028:     """
0029:     bg = Color.BLACK
0030:     H, W = input_grid.shape
0031: 
0032:     # Infer the square "corner region" side length k from the farthest non-black pixel
0033:     # in each corner, after assigning pixels to their nearest corner.
0034:     coords = np.argwhere(input_grid != bg)
0035:     assert coords.size > 0
0036: 
0037:     # Corner assignments by Manhattan distance to each corner.
0038:     # corner order: TL, TR, BL, BR
0039:     d_tl = coords[:, 0] + coords[:, 1]
0040:     d_tr = coords[:, 0] + (W - 1 - coords[:, 1])
0041:     d_bl = (H - 1 - coords[:, 0]) + coords[:, 1]
0042:     d_br = (H - 1 - coords[:, 0]) + (W - 1 - coords[:, 1])
0043:     ds = np.stack([d_tl, d_tr, d_bl, d_br], axis=1)
0044:     corner_idx = ds.argmin(axis=1)
0045: 
0046:     k_candidates: list[int] = []
0047:     for i in range(4):
0048:         pts = coords[corner_idx == i]
0049:         if pts.size == 0:
0050:             continue
0051:         rs = pts[:, 0]
0052:         cs = pts[:, 1]
0053:         if i == 0:  # TL
0054:             k_i = max(int(rs.max() + 1), int(cs.max() + 1))
0055:         elif i == 1:  # TR
0056:             k_i = max(int(rs.max() + 1), int(W - cs.min()))
0057:         elif i == 2:  # BL
0058:             k_i = max(int(H - rs.min()), int(cs.max() + 1))
0059:         else:  # BR
0060:             k_i = max(int(H - rs.min()), int(W - cs.min()))
0061:         k_candidates.append(int(k_i))
0062: 
0063:     k = max(k_candidates)
0064:     n = m = int(k) + 1
0065:     output_grid = np.full((n, m), bg, dtype=int)
0066: 
0067:     # Copy each kxk corner region into the corresponding corner of the output,
0068:     # preserving the pattern's internal offset within that corner square.
0069:     tl = input_grid[0:k, 0:k]
0070:     tr = input_grid[0:k, W - k : W]
0071:     bl = input_grid[H - k : H, 0:k]
0072:     br = input_grid[H - k : H, W - k : W]
0073: 
0074:     output_grid = paste(output_grid, tl, 0, 0, transparent=bg)
0075:     output_grid = paste(output_grid, tr, 0, m - k, transparent=bg)
0076:     output_grid = paste(output_grid, bl, n - k, 0, transparent=bg)
0077:     output_grid = paste(output_grid, br, n - k, m - k, transparent=bg)
0078:     return output_grid
0079:     
0080: 
0081: def generate_input():
0082:     # make a random sized grid with black background
0083:     n = np.random.randint(5, 8)
0084:     m = np.random.randint(5, 8)
0085:     grid = np.zeros((n, m), dtype=int)
0086: 
0087:     # select a color for the patterns
0088:     color = np.random.choice(list(Color.NOT_BLACK))
0089: 
0090:     # select a size for the patterns so that there will be space between the patterns after they are in their corners
0091:     size = np.random.randint(2, (min(n, m) + 1) // 2)
0092: 
0093: 
0094:     # make a random pattern in the top left corner of the specified size
0095:     grid[:size, :size] = [[np.random.choice([color, Color.BLACK]) for _ in range(size)] for _ in range(size)]
0096: 
0097:     # make a random pattern in the top right corner of the specified size
0098:     grid[:size, -size:] = [[np.random.choice([color, Color.BLACK]) for _ in range(size)] for _ in range(size)]
0099: 
0100:     # make a random pattern in the bottom left corner of the specified size
0101:     grid[-size:, :size] = [[np.random.choice([color, Color.BLACK]) for _ in range(size)] for _ in range(size)]
0102: 
0103:     # make a random pattern in the bottom right corner of the specified size
0104:     grid[-size:, -size:] = [[np.random.choice([color, Color.BLACK]) for _ in range(size)] for _ in range(size)]
0105: 
