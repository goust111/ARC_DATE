0065:     # Border (we recolor halves afterwards, so edges get the correct split).
0066:     draw_line(output_grid, r=0, c=0, direction=(0, 1), length=None, color=top_color)        # top edge
0067:     draw_line(output_grid, r=0, c=0, direction=(1, 0), length=None, color=top_color)        # left edge
0068:     draw_line(output_grid, r=H - 1, c=0, direction=(0, 1), length=None, color=bottom_color) # bottom edge
