+                    "step": step,
+                    "lattice": (step, sign * step),
+                    "top_left": (sr, sc),
+                    "partial": (sr + h > H) or (sc < 0) or (sc + w > W),
+                    "mark_local": (mr, mc),
+                    "mark_abs": (ar, ac),
+                    "mark_visible": _in_bounds((H, W), ar, ac),
+                }
+            )
+            step += 1
+    return infos
+
+
+def _render_output(H: int, W: int, r0: int, c0: int, h: int, w: int) -> tuple[np.ndarray, list[dict]]:
+    out = np.full((H, W), BG, dtype=int)
+    infos = _enumerate_copies(H, W, r0, c0, h, w)
+    for info in infos:
+        sr, sc = info["top_left"]
+        _paste_rect(out, sr, sc, h, w, RECT)
+        if info["mark_visible"]:
+            ar, ac = info["mark_abs"]
+            out[ar, ac] = MARK
+    return out, infos
+
+
+def _count_components(mask: np.ndarray) -> int:
+    H, W = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    total = 0
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            total += 1
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+    return total
+
