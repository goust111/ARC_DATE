+    infos = _enumerate_copies(H, W, r0, c0, h, w)
+    for info in infos:
+        sr, sc = info["top_left"]
+        _paste_rect(out, sr, sc, h, w, RECT)
+        if info["mark_visible"]:
+            ar, ac = info["mark_abs"]
+            out[ar, ac] = MARK
+    return out, infos
