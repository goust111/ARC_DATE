0015: 
0016: 
0017: def main(input_grid):
0018:     """
0019:     Draw horizontal lines through two colored pixels and split the border color by their vertical order.
0020: 
0021:     Input structure:
0022:     - The input is a black grid with exactly two colored single pixels.
0023:     - One pixel lies in the upper half and the other in the lower half.
0024:     - The grid height is even so the final border split has a clear midpoint.
0025: 
0026:     Rule:
0027:     - Sort the two pixels from top to bottom.
0028:     - Draw a full horizontal line through each pixel in its own color.
0029:     - Draw the border, then recolor all non-black border and line pixels in the top half to the top color and in the bottom half to the bottom color.
0030: 
0031:     Key insight:
0032:     - The two pixels define both the line rows and the two-color frame: vertical order decides which
0033:       color owns each half of the output.
0034:     """
0035:     # Plan:
0036:     # 1. Parse the input and determine which pixel is top in which is bottom
0037:     # 2. Draw horizontal lines
0038:     # 3. Draw border, colored appropriately
0039: 
0040:     background = Color.BLACK
0041: 
0042:     # 1. Input parsing: find the two single-pixel components and sort by row (top -> bottom).
0043:     pixels = find_components(
0044:         input_grid,
0045:         bg=background,
0046:         connectivity=4,
0047:         monochromatic=True,
0048:         return_format="dict",
0049:     )
0050:     pixels.sort(key=lambda d: int(d["bbox"][0]))  # r0
0051:     assert len(pixels) == 2
0052: 
0053:     # 2. Draw horizontal lines across the row of each pixel, in that pixel's color.
0054:     output_grid = np.full_like(input_grid, background)
0055:     H, W = output_grid.shape
