def components(mask):
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            seen[r, c] = True
            q = deque([(r, c)])
            coords = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(coords)
    return out


for i in range(150):
    inp = mod.generate_input()
    out = mod.main(inp)
    h, w = inp.shape

    assert np.array_equal(out[:-1, -1], inp[:-1, -1])
    assert np.array_equal(out[-1, :-1], inp[-1, :-1])
    assert int(out[-1, -1]) == int(inp[-1, -1])

    grey = inp == 5
    grey[-1, :] = False
    grey[:, -1] = False
    comps = components(grey)
    assert len(comps) == 1
    comp = comps[0]
    rows = [r for r, _ in comp]
    cols = [c for _, c in comp]
    assert min(rows) == max(rows)
    bar_row = rows[0]
    c0, c1 = min(cols), max(cols)
    assert len(comp) == c1 - c0 + 1
    length = c1 - c0 + 1
    assert length in (7, 9)
    radius = (length - 1) // 2
    center = (c0 + c1) // 2

    rr, cc = np.indices(inp.shape)
    dist = np.abs(rr - bar_row) + np.abs(cc - center)
    diamond = dist <= radius
    boundary = dist == radius
    bar = (rr == bar_row) & (cc >= c0) & (cc <= c1)
    strict = diamond & ~boundary & ~bar
    diamond[-1, :] = False
    diamond[:, -1] = False
    boundary[-1, :] = False
    boundary[:, -1] = False
    bar[-1, :] = False
    bar[:, -1] = False
    strict[-1, :] = False
    strict[:, -1] = False

    row_labels = inp[:-1, -1]
    col_labels = inp[-1, :-1]
    same = row_labels[:, None] == col_labels[None, :]

    expected = inp.copy()
    expected[boundary] = 5
    fill = strict[:-1, :-1] & same
    expected[:-1, :-1] = np.where(fill, row_labels[:, None], expected[:-1, :-1])
    expected[bar] = 5
    assert np.array_equal(out, expected), f'semantic mismatch at sample {i}'

    inside_same = int((strict[:-1, :-1] & same).sum())
    outside_same = int((~diamond[:-1, :-1] & same).sum())
    blocked_same = int(((boundary[:-1, :-1] | bar[:-1, :-1]) & same).sum())
    inside_diff = int((strict[:-1, :-1] & ~same).sum())
    assert inside_same >= 2
    assert outside_same >= 1
    assert blocked_same >= 1
    assert inside_diff >= 2

print('semantic_checks', 150)
