+    coords = comps[0]
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    assert int(rows.min()) == int(rows.max()), "grey object must be horizontal"
+    bar_row = int(rows[0])
+    c0 = int(cols.min())
+    c1 = int(cols.max())
