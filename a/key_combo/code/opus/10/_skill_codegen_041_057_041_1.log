+    strip_col = frame_left + outer_w + strip_gap
+    strip_row = strip_top
+    cursor = strip_row
+    for color, seg_h in zip(strip_colors, strip_heights):
+        grid[cursor : cursor + seg_h, strip_col] = color
+        cursor += seg_h
+    strip_bbox = (strip_row, strip_col, cursor - 1, strip_col)
