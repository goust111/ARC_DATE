+    for i, box in enumerate(boxes):
+        child = boxes[i + 1] if i + 1 < len(boxes) else None
+        r0, c0, r1, c1 = box
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1):
+                if child is not None:
+                    cr0, cc0, cr1, cc1 = child
+                    if cr0 <= r <= cr1 and cc0 <= c <= cc1:
+                        continue
+                if out[r, c] == _BG:
+                    out[r, c] = seq[i]
