+    outer_h = outer_r1 - outer_r0 + 1
+    outer_w = outer_c1 - outer_c0 + 1
+
+    strip_heights = [random.randint(*_STRIP_SEGMENT_HEIGHT_RANGE) for _ in range(depth)]
+    strip_h = sum(strip_heights)
