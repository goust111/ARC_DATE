        weights = []
        lo = max(-amp, last - WALK_STEP_MAX)
        hi = min(amp, last + WALK_STEP_MAX)
        for nxt in range(lo, hi + 1):
            weight = _gen_walk_count(
                width,
                amp,
                pos + 1,
                nxt,
                score_left - abs(nxt),
                pos_count + int(nxt > 0),
                neg_count + int(nxt < 0),
            )
            if weight:
                choices.append(nxt)
                weights.append(weight)
        nxt = _gen_weighted_choice(choices, weights)
        offsets.append(nxt)
        pos += 1
        last = nxt
        score_left -= abs(nxt)
        pos_count += int(nxt > 0)
        neg_count += int(nxt < 0)
    return np.array(offsets, dtype=int)


