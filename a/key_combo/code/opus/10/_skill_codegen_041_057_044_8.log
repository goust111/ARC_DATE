+    return out
+
+
+def distinct_orientations(mask: np.ndarray) -> list[np.ndarray]:
+    return [variant for _cost, variant in orientation_table(mask).values()]
+
+
+def canonical_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
