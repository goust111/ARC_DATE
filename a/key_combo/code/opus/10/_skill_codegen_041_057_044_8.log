    return candidates[0]


def _blocks(g: np.ndarray, color: int, bg: int) -> list[tuple[int, int]]:
    comps = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        return_format="dict",
