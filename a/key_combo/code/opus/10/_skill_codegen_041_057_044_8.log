+    sprites = []
+    for comp in find_components(outside, bg=bg, connectivity=4):
+        sr0, sc0, sr1, sc1 = comp["bbox"]
+        rel = comp["coords"] - np.array([sr0, sc0])
+        mask = np.zeros((sr1 - sr0 + 1, sc1 - sc0 + 1), dtype=bool)
+        mask[rel[:, 0], rel[:, 1]] = True
+        sprites.append(
+            {
