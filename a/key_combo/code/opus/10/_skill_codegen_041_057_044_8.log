+def _find_frame(grid: np.ndarray, bg: int) -> dict:
+    grey_components = find_components(grid, bg=bg, connectivity=4, colors=[FRAME])
+    if grey_components:
+        candidates = grey_components
+    else:
+        candidates = find_components(grid, bg=bg, connectivity=4)
