+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+COLOR_SWAP = {1: 4, 4: 1, 2: 3, 3: 2}
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def mask_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return tuple(map(int, mask.shape)), mask.astype(bool).tobytes()
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dirs = DIRS4 if connectivity == 4 else DIRS8
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+    colors: list[int] | None = None,
+) -> list[dict]:
+    if colors is None:
+        colors = sorted(int(v) for v in np.unique(grid) if int(v) != int(bg))
+    comps: list[dict] = []
+    for color in colors:
+        for coords in components_mask(grid == int(color), connectivity=connectivity):
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
