+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+PARTIAL_COLORS = [BLUE, GREEN, YELLOW, TEAL, MAROON]
+MAX_ATTEMPTS = 400
