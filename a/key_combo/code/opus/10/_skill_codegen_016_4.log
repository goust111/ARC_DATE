+def _stamp_clipped(canvas: np.ndarray, sprite: np.ndarray, top: int, left: int) -> None:
+    ch, cw = canvas.shape
+    sh, sw = sprite.shape
+    src_r0 = max(0, -top)
+    src_c0 = max(0, -left)
+    dst_r0 = max(0, top)
+    dst_c0 = max(0, left)
