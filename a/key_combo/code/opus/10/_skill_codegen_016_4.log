+    for fr in range(fh):
+        for fc in range(fw):
+            if not frame_mask[fr, fc]:
+                continue
+            r0 = fr * mh
+            c0 = fc * mw
+            composite[r0 : r0 + mh, c0 : c0 + mw][full_mask] = RED
