+    return matches[0]
+
+
+def _recover_mask(left: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    colors = [int(c) for c in np.unique(left) if int(c) != BLACK]
+    assert 3 <= len(colors) <= 4, "expected 3-4 partial copies"
+    partials: list[np.ndarray] = []
