+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+BODY_COLORS = (BLUE, GREEN, GREY, ORANGE)
+DIR_TO_STEP = {
+    0: (-1, 0),  # up
+    1: (0, 1),   # right
+    2: (1, 0),   # down
+    3: (0, -1),  # left
+}
+SIDE_TO_CONNECTOR = {
+    "top": (3, 5),
+    "right": (5, 7),
+    "bottom": (7, 5),
+    "left": (5, 3),
+}
+BODY_ZONE_ORIGIN = (4, 4)
+BODY_SIDE_SUPPORT = {
+    "top": (0, 1),
+    "right": (1, 2),
+    "bottom": (2, 1),
+    "left": (1, 0),
+}
+BODY_TEMPLATES = (
+    {
+        "mask": np.array(
+            [
+                [1, 1, 0],
+                [0, 1, 1],
+                [0, 1, 0],
+            ],
+            dtype=bool,
+        ),
+        "supports": {"top", "right", "bottom"},
+    },
+    {
+        "mask": np.array(
+            [
+                [0, 1, 0],
+                [1, 1, 1],
+                [1, 0, 0],
+            ],
+            dtype=bool,
+        ),
+        "supports": {"top", "right", "left"},
+    },
+    {
+        "mask": np.array(
+            [
+                [1, 0, 0],
+                [1, 1, 1],
+                [0, 1, 0],
+            ],
+            dtype=bool,
+        ),
+        "supports": {"right", "bottom", "left"},
+    },
+    {
+        "mask": np.array(
+            [
+                [0, 1, 0],
+                [1, 1, 0],
+                [0, 1, 1],
+            ],
+            dtype=bool,
+        ),
+        "supports": {"top", "bottom", "left"},
+    },
