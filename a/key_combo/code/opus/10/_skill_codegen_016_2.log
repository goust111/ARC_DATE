+    "right": (1, 2),
+    "bottom": (2, 1),
+    "left": (1, 0),
+}
+BODY_TEMPLATES = (
+    {
+        "mask": np.array(
+            [
+                [1, 1, 0],
+                [0, 1, 1],
+                [0, 1, 0],
+            ],
+            dtype=bool,
+        ),
+        "supports": {"top", "right", "bottom"},
+    },
+    {
+        "mask": np.array(
+            [
+                [0, 1, 0],
+                [1, 1, 1],
+                [1, 0, 0],
