def _scatter_input(
    sprites: list[dict],
    assembled_positions: list[tuple[int, int]],
    grid_shape: tuple[int, int],
    rng: random.Random,
) -> np.ndarray | None:
    h, w = grid_shape
    grid = np.zeros((h, w), dtype=int)
    placed_boxes: list[tuple[int, int, int, int]] = []

    anchor = sprites[0]["input_crop"]
    atop, aleft = assembled_positions[0]
    anchor_res = _overlay_with_counts(grid, anchor, atop, aleft, {}, require_overlap=False)
    if anchor_res is None:
        return None
    grid, _ = anchor_res
    placed_boxes.append((atop, aleft, atop + anchor.shape[0] - 1, aleft + anchor.shape[1] - 1))

    for idx in range(1, len(sprites)):
        piece = sprites[idx]["input_crop"]
        ph, pw = piece.shape
        out_top, out_left = assembled_positions[idx]
        candidates = []
        for top in range(h - ph + 1):
            for left in range(w - pw + 1):
                if abs(top - out_top) + abs(left - out_left) < 6:
                    continue
                box = (top, left, top + ph - 1, left + pw - 1)
                if not all(_bbox_gap_ok(box, old_box, gap=1) for old_box in placed_boxes):
                    continue
                candidates.append((top, left))
        if not candidates:
            return None
        rng.shuffle(candidates)
        top, left = candidates[0]
        placed = _overlay_with_counts(grid, piece, top, left, {}, require_overlap=False)
        if placed is None:
            return None
        grid, _ = placed
        placed_boxes.append((top, left, top + ph - 1, left + pw - 1,))  # type: ignore[list-item]
    return grid


def _assembled_positions_from_output(
    output_grid: np.ndarray,
    sprites: list[dict],
) -> list[tuple[int, int]]:
    positions: list[tuple[int, int]] = [(-1, -1) for _ in sprites]
    anchor = sprites[0]["rotated"]
    for top in range(output_grid.shape[0] - anchor.shape[0] + 1):
        for left in range(output_grid.shape[1] - anchor.shape[1] + 1):
            sub = output_grid[top : top + anchor.shape[0], left : left + anchor.shape[1]]
            mask = anchor != BLACK
            if np.array_equal(sub[mask], anchor[mask]):
                positions[0] = (top, left)
                break
        if positions[0] != (-1, -1):
            break
    assert positions[0] != (-1, -1)

    remaining = output_grid.copy()
    mask = anchor != BLACK
    top, left = positions[0]
    remaining[top : top + anchor.shape[0], left : left + anchor.shape[1]][mask] = BLACK
    for idx in range(1, len(sprites)):
        piece = sprites[idx]["rotated"]
        found = False
        for r in range(output_grid.shape[0] - piece.shape[0] + 1):
            for c in range(output_grid.shape[1] - piece.shape[1] + 1):
                sub = output_grid[r : r + piece.shape[0], c : c + piece.shape[1]]
                mask = piece != BLACK
                if np.all(sub[mask] == piece[mask]):
                    positions[idx] = (r, c)
                    found = True
                    break
            if found:
                break
        assert found
    return positions


def _main_without_rotation(grid: np.ndarray) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    sprites = _extract_sprites(g)
    pieces = []
    for sprite in sprites:
        rotated = sprite["crop"] if not sprite["is_anchor"] else sprite["crop"]
        pieces.append(
            {
                "bbox": sprite["bbox"],
                "is_anchor": sprite["is_anchor"],
                "rotated": rotated,
                "reds": _red_coords(rotated),
            }
        )
    return _assemble_from_rotated_pieces(pieces, g.shape)


def _make_instance(rng: random.Random) -> np.ndarray | None:
    piece_count = rng.randint(4, 6)
    parents = _choose_tree(piece_count, rng)
    children = _children_of(parents)
    grid_side = rng.randint(24, 28)
    grid_shape = (grid_side, grid_side)

    internal_nodes = [idx for idx in range(1, piece_count) if children[idx]]
    if not internal_nodes:
        return None
    must_rotate = rng.choice(internal_nodes)

    sprites: list[dict] = []
    for idx in range(piece_count):
        degree = len(children[idx]) + (0 if idx == 0 else 1)
        angle = 0
        if idx != 0:
            angle = rng.randrange(4)
        if idx == must_rotate:
            angle = rng.choice((1, 2, 3))
        sprite = _build_sprite(is_anchor=(idx == 0), angle=angle, connector_count=degree, rng=rng)
        sprites.append(sprite)

    if sum(1 for idx in range(1, piece_count) if sprites[idx]["angle"] != 0) < 2:
        extra = [idx for idx in range(1, piece_count) if idx != must_rotate]
        if not extra:
            return None
        tweak = rng.choice(extra)
        degree = len(children[tweak]) + 1
        sprites[tweak] = _build_sprite(is_anchor=False, angle=rng.choice((1, 2, 3)), connector_count=degree, rng=rng)

    anchor_piece = sprites[0]["rotated"]
    anchor_top = rng.randint(6, grid_shape[0] - anchor_piece.shape[0] - 6)
    anchor_left = rng.randint(6, grid_shape[1] - anchor_piece.shape[1] - 6)
    output_grid = _place_assembled_output(sprites, parents, grid_shape, anchor_top, anchor_left, rng)
    if output_grid is None:
        return None

    assembled_positions = _assembled_positions_from_output(output_grid, sprites)
    input_grid = _scatter_input(sprites, assembled_positions, grid_shape, rng)
    if input_grid is None:
        return None

    parsed = _extract_sprites(input_grid)
    if len(parsed) != piece_count:
        return None

    solved = main(input_grid)
    if not np.array_equal(solved, output_grid):
        return None

    try:
        shortcut = _main_without_rotation(input_grid)
    except AssertionError:
        shortcut = None
    if shortcut is not None and np.array_equal(shortcut, output_grid):
        return None

    return input_grid


def generate_input() -> np.ndarray:
    for _ in range(400):
        seed = random.randrange(1 << 30)
        rng = random.Random(seed)
        candidate = _make_instance(rng)
        if candidate is not None:
            return candidate
    raise RuntimeError("failed to generate a valid clock-rotation connector-assembly instance")

