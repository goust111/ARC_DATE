+        for c0 in range(w - 2):
+            if np.all(crop[r0 : r0 + 3, c0 : c0 + 3] == YELLOW):
+                return True
+    return False
+
+
+def _red_coords(arr: np.ndarray) -> list[tuple[int, int]]:
+    return [tuple(map(int, rc)) for rc in np.argwhere(arr == RED)]
+
+
+def _extract_sprites(grid: np.ndarray) -> list[dict]:
