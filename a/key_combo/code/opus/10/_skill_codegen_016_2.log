+
+
+def _neighbors(r: int, c: int, connectivity: int) -> Iterable[tuple[int, int]]:
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+        return
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors(cr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _tight_crop(arr: np.ndarray, bg: int = BLACK) -> np.ndarray:
+    coords = np.argwhere(arr != bg)
+    if coords.size == 0:
+        return arr[:0, :0].copy()
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _rotate_clockwise(arr: np.ndarray, steps: int) -> np.ndarray:
+    return np.rot90(arr, (-steps) % 4).copy()
+
+
+def _dilate_once(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        r0 = max(0, int(r) - 1)
+        r1 = min(h, int(r) + 2)
+        c0 = max(0, int(c) - 1)
+        c1 = min(w, int(c) + 2)
+        out[r0:r1, c0:c1] = True
