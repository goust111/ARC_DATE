import itertools, numpy as np

def norm(coords):
    arr=np.array(coords,dtype=int)
    r0,c0=arr.min(axis=0)
    arr=arr-[r0,c0]
    return tuple(sorted(map(tuple,arr.tolist())))

def rot(coords,k):
    arr=np.array(coords,dtype=int)
    r0,c0=arr.min(axis=0)
    r1,c1=arr.max(axis=0)
    h,w=r1-r0+1,c1-c0+1
    patch=np.zeros((h,w),dtype=int)
    for r,c in arr:
        patch[r-r0,c-c0]=1
    rr=np.rot90(patch,-k)
    pts=np.argwhere(rr==1)
    return tuple(sorted(map(tuple,pts.tolist())))

def canon(coords):
    return min(rot(coords,k) for k in range(4))

def conn(coords):
    s=set(coords)
    stack=[next(iter(s))]
    seen=set(stack)
    while stack:
        r,c=stack.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (nr,nc) in s and (nr,nc) not in seen:
                seen.add((nr,nc)); stack.append((nr,nc))
    return len(seen)==len(s)

cells=[(r,c) for r in range(3) for c in range(3)]
seen=set(); out=[]
for k in range(3,7):
