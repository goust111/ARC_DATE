+    assert all((sprite["bbox"][2] - sprite["bbox"][0] + 1) <= 3 for sprite in sprites)
+    assert all((sprite["bbox"][3] - sprite["bbox"][1] + 1) <= 3 for sprite in sprites)
+    assert all(sprite["bbox"][2] <= h - 4 for sprite in sprites)
