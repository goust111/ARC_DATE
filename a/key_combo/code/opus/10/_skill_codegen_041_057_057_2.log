+    center_c = (c0 + c1) / 2.0
+    rotated = []
+    for r, c in coords:
+        dr = float(r) - center_r
+        dc = float(c) - center_c
+        if k == 1:
+            ndr, ndc = dc, -dr
+        elif k == 2:
+            ndr, ndc = -dr, -dc
+        else:
