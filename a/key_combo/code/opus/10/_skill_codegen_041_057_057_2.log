+        support_arr = np.array(support, dtype=int)
+        for k in range(4):
+            rotated = _rotate_coords(support_arr, k)
+            assert rotated[:, 0].min() >= 0 and rotated[:, 0].max() <= 2
+            assert rotated[:, 1].min() >= 0 and rotated[:, 1].max() <= 2
