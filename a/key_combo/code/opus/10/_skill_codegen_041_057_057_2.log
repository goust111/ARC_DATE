+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(len(cells)),
+                }
+            )
+    return out
+
+
+def _extract_bars(grid: np.ndarray, bg: int) -> list[dict]:
+    h, _ = grid.shape
+    bars = []
+    for comp in _components(grid, bg):
+        r0, c0, r1, c1 = comp["bbox"]
+        if c0 != c1 or r1 != h - 1:
+            continue
+        height = r1 - r0 + 1
+        if not (1 <= height <= 4 and comp["area"] == height):
+            continue
+        bars.append(
+            {
+                "color": int(comp["color"]),
+                "col": int(c0),
+                "height": int(height),
+                "coords": comp["coords"],
+            }
+        )
+    bars.sort(key=lambda bar: bar["col"])
+    return bars
+
+
+def _extract_sprites(grid: np.ndarray, bg: int) -> list[dict]:
+    h, _ = grid.shape
+    sprites = []
+    for comp in _components(grid, bg):
+        r0, c0, r1, c1 = comp["bbox"]
+        bbox_h = r1 - r0 + 1
+        bbox_w = c1 - c0 + 1
+        if r1 == h - 1 and bbox_w == 1 and comp["area"] == bbox_h:
+            continue
