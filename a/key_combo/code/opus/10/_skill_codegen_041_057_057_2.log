+    norm = np.array(_normalize(coords), dtype=int)
+    r1 = int(norm[:, 0].max())
+    c1 = int(norm[:, 1].max())
+    patch = np.zeros((r1 + 1, c1 + 1), dtype=int)
+    patch[norm[:, 0], norm[:, 1]] = 1
