+def _rotate_coords(coords: np.ndarray, k: int) -> np.ndarray:
+    k %= 4
+    if k == 0:
+        return coords.copy()
+
+    r0, c0, r1, c1 = _bbox(coords)
+    center_r = (r0 + r1) / 2.0
+    center_c = (c0 + c1) / 2.0
+    rotated = []
+    for r, c in coords:
+        dr = float(r) - center_r
+        dc = float(c) - center_c
+        if k == 1:
+            ndr, ndc = dc, -dr
+        elif k == 2:
+            ndr, ndc = -dr, -dc
+        else:
+            ndr, ndc = -dc, dr
