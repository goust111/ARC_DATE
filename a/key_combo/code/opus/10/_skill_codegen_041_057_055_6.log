+def _band_partition(rect_count: int, tie_case: bool) -> list[int]:
+    if rect_count == 3:
+        options = ([2, 1], [1, 1, 1])
+    else:
+        options = ([2, 2], [2, 1, 1], [1, 1, 1, 1])
