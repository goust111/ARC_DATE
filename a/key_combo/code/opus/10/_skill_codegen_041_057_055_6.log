+        band_c = random.randint(min_c, max_c)
+        c = int(band_c)
+        for j in range(int(band_size)):
+            specs.append({"r0": int(r_cursor), "c0": int(c), "h": int(rect_h), "w": int(widths[j]), "color": int(rect_colors[idx])})
