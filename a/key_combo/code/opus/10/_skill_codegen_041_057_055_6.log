+
+def _transform_rect_specs(rects: list[dict], h: int, w: int, flip_v: bool, flip_h: bool) -> list[dict]:
+    out: list[dict] = []
+    for rect in rects:
+        r0 = int(rect["r0"])
+        c0 = int(rect["c0"])
+        rh = int(rect["h"])
+        rw = int(rect["w"])
+        if flip_v:
+            r0 = int(h - r0 - rh)
+        if flip_h:
+            c0 = int(w - c0 - rw)
