    output = np.tile(column_colors, (int(mask_h), 1))
    output[~mask] = int(hole_color)
    mask = output != int(hole_color)
    grid = _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color)
    if np.array_equal(main(grid), output):
        return grid
    return None


