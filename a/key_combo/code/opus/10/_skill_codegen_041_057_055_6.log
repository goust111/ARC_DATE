+def _expected_from_specs(
+    rects: list[dict],
+    axis_r: int,
+    axis_c: int,
+    main_vertical: bool,
+    palette_colors: np.ndarray,
+) -> np.ndarray:
+    ordered = sorted(
+        rects,
+        key=lambda rect: _rect_key(
+            (int(rect["r0"]), int(rect["c0"]), int(rect["r0"] + rect["h"] - 1), int(rect["c0"] + rect["w"] - 1)),
+            axis_r,
+            axis_c,
+            main_vertical,
+        ),
+    )
