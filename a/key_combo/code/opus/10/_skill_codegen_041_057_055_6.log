+    for rect in ordered:
+        arr = np.full((int(rect["h"]), int(rect["w"])), int(rect["color"]), dtype=int)
+        if main_vertical:
+            arr = np.rot90(arr, k=1)
+        arrays.append(arr)
+    return _stack_and_recolor(arrays, palette_colors)
