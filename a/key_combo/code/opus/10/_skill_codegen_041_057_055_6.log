+def _rect_key(box: tuple[int, int, int, int], axis_r: int, axis_c: int, main_vertical: bool) -> tuple[int, int]:
+    r0, c0, r1, c1 = map(int, box)
+    center_r2 = int(r0 + r1)
+    center_c2 = int(c0 + c1)
+    if main_vertical:
+        return abs(center_c2 - 2 * int(axis_c)), abs(center_r2 - 2 * int(axis_r))
