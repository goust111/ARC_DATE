+def _axis_info(grid: np.ndarray) -> tuple[int, int, int, int, bool]:
+    marker_cells = np.argwhere(grid == MAGENTA)
+    assert marker_cells.shape[0] == 1, "expected a unique axis marker"
+    axis_r, axis_c = map(int, marker_cells[0])
