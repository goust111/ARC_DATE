+def _pair_regions(components: list[dict], shape: tuple[int, int]) -> list[int]:
+    h, w = shape
+    labels = np.full((h, w), -1, dtype=int)
+    for idx, comp in enumerate(components):
+        labels[comp["coords"][:, 0], comp["coords"][:, 1]] = idx
