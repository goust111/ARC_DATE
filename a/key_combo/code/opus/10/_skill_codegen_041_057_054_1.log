+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _make_candidate()
+        if grid is None:
+            continue
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        if out.shape != grid.shape:
+            continue
+        if not _semantic_checks(grid):
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

