+                left = _left_index(i, j, components)
+                fill = int(components[left]["seed"])
+            else:
+                fill = seed_i if comp_i["area"] > comp_j["area"] else seed_j
+
+        out[comp_i["coords"][:, 0], comp_i["coords"][:, 1]] = fill
+        out[comp_j["coords"][:, 0], comp_j["coords"][:, 1]] = fill
+
+    return out
