+    i = 0
+    n = len(line)
+    while i < n:
+        if int(line[i]) == BLACK:
+            i += 1
+            continue
+
+        red_positions: list[int] = []
+        j = i
+        while j < n and int(line[j]) != BLACK:
+            if int(line[j]) == RED:
+                red_positions.append(j)
+            j += 1
+
+        if len(red_positions) >= 2:
+            spans.append(red_positions[-1] - red_positions[0] + 1)
+        i = j
+    return spans
+
+
+def _infer_radius(grid: np.ndarray) -> int:
+    spans: list[int] = []
