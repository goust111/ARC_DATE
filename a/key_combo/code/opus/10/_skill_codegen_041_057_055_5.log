+    if not (radius <= r < h - radius and radius <= c < w - radius):
+        return ()
+    cells = [(r, cc) for cc in range(c - radius, c + radius + 1)]
+    cells.extend((rr, c) for rr in range(r - radius, r + radius + 1) if rr != r)
+    return tuple(cells)
