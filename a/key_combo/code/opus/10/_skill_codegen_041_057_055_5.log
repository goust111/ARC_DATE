+
+
+def _reserved_rows_cols(red_map: dict[tuple[int, int], set[tuple[int, int]]]) -> tuple[set[int], set[int]]:
+    rows = {r for cells in red_map.values() for r, _ in cells}
+    cols = {c for cells in red_map.values() for _, c in cells}
