+GRID_SIDE_RANGE = (15, 21)
+RADIUS_CHOICES = (2, 3)
+EVEN_COUNTS = (2, 4)
+ODD_COUNTS = (3,)
+TARGET_FILL_RANGE = (0.42, 0.58)
