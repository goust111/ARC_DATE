+    row_red = sum(int(grid[r, cc]) == RED for cc in range(c - radius, c + radius + 1))
+    col_red = sum(int(grid[rr, c]) == RED for rr in range(r - radius, r + radius + 1))
+    if row_red < 2 or col_red < 2:
