   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """Paint alternating square rings from each colored corner marker, clipped to cells uniquely nearest to that marker.
   8: 
   9:     Input structure
  10:     - The grid is background except for colored marker pixels in two or more corners.
  11: 
  12:     Rule
  13:     - For every cell, compare squared Euclidean distance to each corner marker.
  14:     - Cells tied between markers remain background.
  15:     - A uniquely owned cell takes its marker color exactly when its Chebyshev distance
  16:       from that marker is even.
  17: 
  18:     Key insight
  19:     - The output is not made from lines between corners; it is the set of even
  20:       square-distance rings around each active corner, cut by nearest-marker
  21:       boundaries.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2
  25:     h, w = g.shape
  26:     bg = get_bg(g)
  27: 
  28:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
  29:     marker_coords = np.argwhere(g != bg)
  30:     assert len(marker_coords) >= 2
  31: 
  32:     markers: list[tuple[int, int, int]] = []
  33:     seen: set[tuple[int, int]] = set()
  34:     for coord in marker_coords:
  35:         r, c = map(int, coord)
  36:         assert (r, c) in corners
  37:         assert (r, c) not in seen
  38:         seen.add((r, c))
  39:         markers.append((r, c, int(g[r, c])))
  40: 
  41:     out = np.full_like(g, bg)
  42:     for r in range(h):
  43:         for c in range(w):
  44:             distances = [
  45:                 (r - r0) * (r - r0) + (c - c0) * (c - c0)
