  input_grid:
    shape: (2R+1) x (2C+1) where R, C each from {1,2,3,4,6,8}
    observed_range: R in 2-4, C in 1-4 [observed]
    background: 0
    structure: |
      Even rows/cols are all-bg spacers; odd rows/cols hold the lattice dots.
