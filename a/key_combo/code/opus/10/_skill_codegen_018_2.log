+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+START_COLOR = 1
+WALL_COLOR = 2
+COLOR_POOL = [3, 4, 5, 6, 7, 8, 9]
+
+GEN_HEIGHT_RANGE = (16, 20)
+GEN_WIDTH_RANGE = (16, 20)
+GEN_CYCLE_LEN_RANGE = (2, 4)
+GEN_MAX_ATTEMPTS = 400
