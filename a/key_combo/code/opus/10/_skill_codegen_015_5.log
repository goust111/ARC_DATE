+    (1, 1): (0, 0),
+    (1, 5): (0, 4),
+    (5, 1): (4, 0),
+    (5, 5): (4, 4),
+}
+QUADRANT_CW_TURNS = {
+    (1, 1): 0,
+    (1, 5): 1,
+    (5, 5): 2,
+    (5, 1): 3,
+}
