+
+SELECTOR_SIZE = 7
+SPRITE_SIZE = 3
+INNER_SIZE = 7
+OUTPUT_SIZE = 9
+
+MARKER_POSITIONS = ((1, 1), (1, 5), (5, 1), (5, 5))
