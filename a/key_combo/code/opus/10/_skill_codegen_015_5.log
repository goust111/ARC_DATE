+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FRAME = 1
+MARKER_COLORS = (2, 3, 4, 6)
+SELECTOR_COLOR = 9
+
+SELECTOR_SIZE = 7
+SPRITE_SIZE = 3
+INNER_SIZE = 7
+OUTPUT_SIZE = 9
+
+MARKER_POSITIONS = ((1, 1), (1, 5), (5, 1), (5, 5))
+QUADRANT_ANCHORS = {
+    (1, 1): (0, 0),
+    (1, 5): (0, 4),
+    (5, 1): (4, 0),
+    (5, 5): (4, 4),
+}
+QUADRANT_CW_TURNS = {
+    (1, 1): 0,
+    (1, 5): 1,
+    (5, 5): 2,
+    (5, 1): 3,
+}
+
+INPUT_ROWS_RANGE = (16, 19)
+INPUT_COLS_RANGE = (16, 19)
+PLACEMENT_GAP = 1
+MAX_GENERATION_ATTEMPTS = 400
+SPRITE_AREA_RANGE = (4, 7)
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> list[tuple[int, int]]:
+    if connectivity == 4:
+        return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors(cr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
