+def _solidify_sparse_coords(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    rel = coords - np.array([r0, c0])
+    assert np.all(rel % 2 == 0), "sparse sprite pixels must lie on a two-step lattice"
