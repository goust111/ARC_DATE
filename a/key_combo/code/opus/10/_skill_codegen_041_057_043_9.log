    grid = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)
    grid[ODD_ANCHOR_START::LATTICE_STEP, ODD_ANCHOR_START::LATTICE_STEP] = lattice_color
    _stamp_sparse_frame(grid, frame_bbox, frame_color)

