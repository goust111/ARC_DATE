+    grid[r0 : r1 + 1 : 2, c1] = FRAME_COLOR
+    grid[r0, c0 : c1 + 1 : 2] = FRAME_COLOR
+    grid[r1, c0 : c1 + 1 : 2] = FRAME_COLOR
