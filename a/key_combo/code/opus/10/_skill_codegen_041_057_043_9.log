+    col_anchors = _choose_col_anchors(rank_sprites, W, frame_bbox, row_anchors)
+    if col_anchors is None:
+        return None
+
+    inp = _build_input(H, W, frame_bbox, rank_sprites, row_anchors, col_anchors)
