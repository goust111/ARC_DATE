+    logical_h = (r1 - r0) // 2 + 1
+    logical_w = (c1 - c0) // 2 + 1
+    logical = np.zeros((logical_h, logical_w), dtype=bool)
+    for dr, dc in rel:
+        logical[int(dr) // 2, int(dc) // 2] = True
