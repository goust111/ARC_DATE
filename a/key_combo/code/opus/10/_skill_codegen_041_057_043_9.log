+def _solidify_logical(logical: np.ndarray) -> np.ndarray:
+    logical = np.asarray(logical, dtype=bool)
+    return np.kron(logical, np.ones((2, 2), dtype=bool))[: 2 * logical.shape[0] - 1, : 2 * logical.shape[1] - 1]
