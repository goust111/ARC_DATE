+    assert _sparse_rect_perimeter_ok(coords), "orange pixels must form one sparse rectangular perimeter"
+    bbox = _bbox(coords)
+    assert (bbox[2] - bbox[0]) > (bbox[3] - bbox[1]), "frame must be taller than it is wide"
+    return bbox
