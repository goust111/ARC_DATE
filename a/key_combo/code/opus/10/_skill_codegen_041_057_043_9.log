+    total_h = sum(mask.shape[0] for mask in rotated_masks)
+    slack = interior_h - total_h
+    assert slack > 0 and slack % (len(sprites) + 1) == 0, "frame height must yield equal vertical gaps"
+    gap = slack // (len(sprites) + 1)
