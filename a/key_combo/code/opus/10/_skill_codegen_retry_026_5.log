+
+
+def _pick_spread_cells(
+    candidates: list[tuple[int, int]],
+    count: int,
+    chosen: list[tuple[int, int]] | None = None,
+) -> list[tuple[int, int]] | None:
+    selected = [] if chosen is None else list(chosen)
+    random.shuffle(candidates)
