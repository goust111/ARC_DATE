+            if len(selected) == original_len + count:
+                return selected[original_len:]
+    for cell in candidates:
+        if cell not in selected:
+            selected.append(cell)
+            if len(selected) == original_len + count:
+                return selected[original_len:]
+    return None
+
+
+def _build_expected(
