+def _move_body(
+    body: set[tuple[int, int]],
+    direction: tuple[int, int],
+    length: int,
+) -> set[tuple[int, int]]:
+    dr, dc = direction
+    return {(r + dr * length, c + dc * length) for r, c in body}
+
+
+def _cast_rays(
+    out: np.ndarray,
+    moved_body: set[tuple[int, int]],
+    anchor: set[tuple[int, int]],
+) -> np.ndarray:
+    h, w = out.shape
+    blockers = set(moved_body)
+    for r, c in sorted(moved_body):
