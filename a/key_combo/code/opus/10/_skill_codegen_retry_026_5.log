+    {"cells": {(0, 0), (0, 1), (1, 1)}, "attach": (0, 1)},
+    {"cells": {(0, 1), (1, 0), (1, 1)}, "attach": (1, 1)},
+    {"cells": {(0, 1), (1, 0), (1, 1), (2, 1)}, "attach": (1, 1)},
+    {"cells": {(0, 0), (1, 0), (1, 1), (2, 0), (2, 1)}, "attach": (1, 1)},
+    {"cells": {(0, 1), (1, 0), (1, 1), (2, 0), (2, 1)}, "attach": (1, 1)},
