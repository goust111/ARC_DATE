+            while _in_bounds((h, w), nr, nc):
+                if (nr, nc) in body:
+                    break
+                if (nr, nc) in anchor:
+                    blocked = True
+                    nr += dr
+                    nc += dc
+                    continue
+                if blocked:
+                    shadow.add((nr, nc))
+                else:
+                    path.add((nr, nc))
