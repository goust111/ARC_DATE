+                "stem": stem,
+                "direction": direction,
+                "stem_length": stem_length,
+                "moved_body": moved_body,
+                "anchor": anchor,
+                "hit_markers": set(hit_markers),
+                "blocked_marker": set(blocked_marker),
+                "miss_markers": set(miss_markers),
