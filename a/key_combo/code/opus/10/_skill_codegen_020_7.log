+
+        grid = np.full((height, width), BLACK, dtype=int)
+        grid[0, :] = top_row
+        grid[1, :] = GREY
+        for anchor, missing_index in zip(anchors, missing_indices):
+            _render_l(grid, anchor, missing_index)
+
+        try:
