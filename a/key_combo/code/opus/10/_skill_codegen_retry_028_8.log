+def _draw_paths(out: np.ndarray, moved: list[dict], bg: int) -> np.ndarray:
+    fixed = out != int(bg)
+    for item in sorted(
+        moved,
+        key=lambda obj: (
+            -int(obj["distance"]),
+            int(obj["color"]),
+            int(obj["original"][:, 0].min()),
+            int(obj["original"][:, 1].min()),
+        ),
+    ):
+        shift = int(item["shift"])
+        for r_raw, c_raw in item["original"]:
+            r = int(r_raw)
+            c0 = int(c_raw)
+            c1 = c0 + shift
+            lo, hi = sorted((c0, c1))
