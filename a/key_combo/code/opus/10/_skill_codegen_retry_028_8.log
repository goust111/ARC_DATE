    mask = np.zeros((h, w), dtype=bool)
    for r, c in coords:
        mask[r, c] = True
    if random.choice([False, True]):
        mask = np.flipud(mask)
    if random.choice([False, True]):
        mask = np.fliplr(mask)
    return mask.copy()


def _gen_mask_coords(mask: np.ndarray, r0: int, c0: int) -> np.ndarray:
    return np.argwhere(mask) + np.array([int(r0), int(c0)])


