                distance = h - 2 - r0
        else:
            assert c0 == c1, "all non-wall objects must be vertical segments"
            assert area == r1 - r0 + 1, "segment must be a solid one-cell-thick bar"
            if edge == "left":
                fill_bbox = (r0, 1, r1, c0)
                distance = c0 - 1
            else:
