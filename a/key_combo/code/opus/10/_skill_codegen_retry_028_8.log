+    out[:, w - 1] = right_color
+
+    occupied = out != int(bg)
+    for item in moved:
+        landed = item["landed"]
+        assert not np.any(occupied[landed[:, 0], landed[:, 1]])
+        out[landed[:, 0], landed[:, 1]] = int(item["color"])
+        occupied[landed[:, 0], landed[:, 1]] = True
+
+    return _draw_paths(out, moved, bg)
