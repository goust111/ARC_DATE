+        expected = _expected_output((height, width), specs)
+        if not _validate_scene(inp, expected, specs):
+            continue
+        if not np.array_equal(main(inp), expected):
+            continue
+        return inp
+    raise RuntimeError("failed to generate a valid puzzle instance")

