+MARKER = 3
+FILL = 4
+FRAME = 5
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LENGTH_FAMILIES = (
+    (2, 4),
+    (3, 6),
+    (2, 3, 5),
+    (2, 4, 5),
+    (2, 3, 6),
+    (2, 4, 6),
+    (3, 5, 6),
