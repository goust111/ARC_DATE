+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BAR_COLOR_POOL = (1, 2, 6, 7, 8, 9)
+MARKER = 3
+FILL = 4
+FRAME = 5
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+LENGTH_FAMILIES = (
+    (2, 4),
+    (3, 6),
+    (2, 3, 5),
