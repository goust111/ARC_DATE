+    ext0, ext1 = placements[0]["exterior"], placements[1]["exterior"]
+    if abs(ext0[0] - ext1[0]) < 3 or abs(ext0[1] - ext1[1]) < 3:
+        return False
+
+    for frame in placements:
+        for rr, cc in frame["pixels"]:
+            grid[rr, cc] = FRAME
+        cr, cc = frame["center"]
+        grid[cr, cc] = MARKER
+        gr, gc = frame["gap"]
+        grid[gr, gc] = BG
+    return True
+
+
+def _validate_instance(grid: np.ndarray) -> bool:
+    info = _analyze(grid)
