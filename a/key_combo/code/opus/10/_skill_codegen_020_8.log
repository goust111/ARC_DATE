+    out = base.copy()
+    painted = np.zeros_like(base, dtype=bool)
+    for bar in bars:
+        mask = channel & (dist >= 0) & (dist % bar["length"] == 0) & ~painted
+        out[mask] = bar["color"]
+        painted |= mask
+    out[channel & ~painted] = FILL
+    return out
+
