+        center_ranges = _center_ranges(h, w, bar_edge, bar_row)
+        if not _valid_center_ranges(center_ranges):
+            continue
+
+        centers = _sample_centers(rng, h, w, bar_edge, bar_row)
+        if not _place_frames(rng, grid, centers):
+            continue
