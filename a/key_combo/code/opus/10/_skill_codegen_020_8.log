+    (2, 3, 6),
+    (2, 4, 6),
+    (3, 5, 6),
+)
+MAX_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _sign(n: int) -> int:
+    if n > 0:
+        return 1
+    if n < 0:
+        return -1
+    return 0
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
