+def _paint_periodic(
+    base: np.ndarray, bars: list[dict], channel: np.ndarray, dist: np.ndarray
+) -> np.ndarray:
+    out = base.copy()
+    painted = np.zeros_like(base, dtype=bool)
+    for bar in bars:
