  tile:
    size: 8x8 (fixed); grid = 3 full repeats + 3 extra in each axis
    colors: 2-8 non-black colors; black (0) never appears in tile
    last_row: all blue (1) [observed]
    last_col: all blue (1) [observed]
    no symmetry required [observed]
  output: perfect tiling of the 8x8 tile across the 27x27 grid
  holes:
    count: 4-5 connected regions of black (0) cells
    shape: mostly axis-aligned rectangles; occasionally L-shaped (two abutting rectangles)
