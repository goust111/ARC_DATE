OUTER_H_RANGE = (4, 12)
OUTER_W_RANGE = (5, 12)
LARGEST_MIN_AREA = 18
LARGEST_RATIO_DEN, LARGEST_RATIO_NUM = 10, 19

# Fill density ranges.
INTERIOR_FILL_RANGE = (0.25, 0.35)
OUTSIDE_FILL_RANGE = (0.29, 0.33)


