+    candidates = _small_period_candidates(grid, max_period=max_period)
+    if not candidates:
+        return None
+    min_area = min(rp * cp for rp, cp in candidates)
+    smallest = [(rp, cp) for rp, cp in candidates if rp * cp == min_area]
+    if len(smallest) != 1:
+        return None
+    return smallest[0]
+
