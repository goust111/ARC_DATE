    if len(choices) == 1:
        return choices[0]
    return random.choice(choices)


def _gen_block_cells(r0: int, c0: int, k: int, h: int, w: int) -> set[Cell]:
    rr0, cc0 = max(0, r0), max(0, c0)
    rr1, cc1 = min(h, r0 + k), min(w, c0 + k)
    return {(r, c) for r in range(rr0, rr1) for c in range(cc0, cc1)}


