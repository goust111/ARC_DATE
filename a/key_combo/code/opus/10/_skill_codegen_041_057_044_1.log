+
+def _make_group(rng: random.Random, color: int, layers: int) -> tuple[list[Frame], tuple[int, int], list[set[tuple[int, int]]]]:
+    for _ in range(180):
+        directions = [rng.choice(list(DIRS)) for _ in range(layers)]
