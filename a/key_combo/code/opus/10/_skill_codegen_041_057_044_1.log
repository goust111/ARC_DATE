+    r0, c0, r1, c1 = _bbox(coords)
+    local = coords - np.array([r0, c0], dtype=int)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    cells = {tuple(map(int, rc)) for rc in local}
