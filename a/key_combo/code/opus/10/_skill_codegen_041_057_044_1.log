+    frames: list[Frame] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != 0):
+        for comp in _components(g == color):
+            frame = _detect_frame(comp, color)
+            if frame is None:
+                raise ValueError("found non-frame component")
+            frames.append(frame)
