+
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+
+COLOR_POOL = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+GRID_SIZE_RANGE = (20, 26)
+GEN_ATTEMPTS = 500
+
+
+@dataclass(frozen=True)
+class Frame:
+    color: int
+    bbox: tuple[int, int, int, int]
