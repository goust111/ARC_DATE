+        profile = [2, 2, 3]
+        rng.shuffle(profile)
+        return profile
+    return [rng.choice([2, 3]) for _ in range(3)]
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
