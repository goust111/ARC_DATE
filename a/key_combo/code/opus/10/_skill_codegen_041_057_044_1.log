+        moved = _ring_cells(_shift_bbox(frame.bbox, dr * frame.depth, dc * frame.depth))
+        bucket = per_color.setdefault(frame.color, set())
+        if bucket & moved:
+            return True
+        bucket |= moved
+    return False
+
+
+def _layers_profile(rng: random.Random, n_groups: int) -> list[int]:
+    if n_groups == 2:
+        if rng.random() < 0.55:
+            profile = [2, 3]
+            rng.shuffle(profile)
+            return profile
+        return [2, 2] if rng.random() < 0.9 else [3, 3]
+    if rng.random() < 0.75:
+        return [2, 2, 2]
+    else:
+        profile = [2, 2, 3]
+        rng.shuffle(profile)
+        return profile
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+    want_clip = (_GEN_COUNTER % 3) == 0
