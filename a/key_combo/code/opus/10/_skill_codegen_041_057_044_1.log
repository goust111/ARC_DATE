+    depths: list[int] = []
+    for frame in frames:
+        r0, c0, r1, c1 = frame.bbox
+        containers = 0
+        for other in frames:
+            if other is frame:
+                continue
+            R0, C0, R1, C1 = other.bbox
+            if R0 < r0 and C0 < c0 and r1 < R1 and c1 < C1:
