+        dr, dc = DIRS[frame.direction]
+        moved = _ring_cells(_shift_bbox(frame.bbox, dr * frame.depth, dc * frame.depth))
+        for r, c in moved:
+            if not (0 <= r < h and 0 <= c < w):
