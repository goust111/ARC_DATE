+            continue
+        if layers == 3 and max(outer_h, outer_w) > 15:
+            continue
+        local = np.zeros(shape, dtype=int)
+        for layer_cells in cells:
+            for r, c in layer_cells:
+                if local[r, c] != 0:
+                    break
+                local[r, c] = color
+            else:
+                continue
+            break
+        else:
