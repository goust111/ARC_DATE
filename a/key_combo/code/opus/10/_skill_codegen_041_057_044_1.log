+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    cells = {tuple(map(int, rc)) for rc in local}
+    row_counts = [sum(1 for rr, _cc in cells if rr == row) for row in range(h)]
+    col_counts = [sum(1 for _rr, cc in cells if cc == col) for col in range(w)]
