+
+
+def _place_groups(
+    rng: random.Random,
+    grid_shape: tuple[int, int],
+    groups: list[tuple[list[Frame], tuple[int, int], list[set[tuple[int, int]]]]],
+) -> tuple[np.ndarray, list[Frame]]:
