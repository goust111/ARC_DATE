+    for frame in frames:
+        dr, dc = DIRS[frame.direction]
+        shift = frame.depth
+        moved = _ring_cells(_shift_bbox(frame.bbox, dr * shift, dc * shift))
+        if any(not (0 <= r < h and 0 <= c < w) for r, c in moved):
+            return True
+    return False
+
