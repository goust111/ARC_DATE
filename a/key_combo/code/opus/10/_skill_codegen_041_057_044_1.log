+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _tail_cells(bbox: tuple[int, int, int, int], direction: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    mr = (r0 + r1) // 2
+    mc = (c0 + c1) // 2
+    if direction == "U":
+        return [(r0 - 1, mc), (r0 - 2, mc)]
+    if direction == "D":
+        return [(r1 + 1, mc), (r1 + 2, mc)]
+    if direction == "L":
+        return [(mr, c0 - 1), (mr, c0 - 2)]
+    if direction == "R":
+        return [(mr, c1 + 1), (mr, c1 + 2)]
+    raise ValueError(direction)
