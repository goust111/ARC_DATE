+
+        try:
+            grid, placed_frames = _place_groups(rng, (h, w), groups)
+        except RuntimeError:
+            continue
+
+        clip_target = rng.random() < 0.35
+        clipped = _has_clipping((h, w), placed_frames)
+        if clipped != clip_target:
+            continue
+        if _different_group_overlap((h, w), placed_frames):
+            continue
+        if _self_overlap(placed_frames):
+            continue
+
+        try:
+            parsed = _parse_frames(grid)
+        except ValueError:
+            continue
+        parsed_signature = sorted((f.color, f.bbox, f.direction, f.depth) for f in parsed)
