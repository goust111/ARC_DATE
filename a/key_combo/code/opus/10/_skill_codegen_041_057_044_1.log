+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _ring_cells(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _tail_cells(bbox: tuple[int, int, int, int], direction: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    mr = (r0 + r1) // 2
+    mc = (c0 + c1) // 2
+    if direction == "U":
+        return [(r0 - 1, mc), (r0 - 2, mc)]
+    if direction == "D":
+        return [(r1 + 1, mc), (r1 + 2, mc)]
+    if direction == "L":
+        return [(mr, c0 - 1), (mr, c0 - 2)]
+    if direction == "R":
+        return [(mr, c1 + 1), (mr, c1 + 2)]
+    raise ValueError(direction)
+
+
+def _shift_bbox(bbox: tuple[int, int, int, int], dr: int, dc: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 + dr, c0 + dc, r1 + dr, c1 + dc
