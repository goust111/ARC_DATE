+    cells_per_frame: list[set[tuple[int, int]]] = []
+    all_cells: list[tuple[int, int]] = []
+    for frame in frames:
+        cells = _ring_cells(frame.bbox) | set(_tail_cells(frame.bbox, frame.direction))
+        cells_per_frame.append(cells)
+        all_cells.extend(cells)
