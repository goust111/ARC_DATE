+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND_COLORS = {1, 3}
+OCCLUDER_COLORS = (2, 4, 6, 7)
+FRAME_COLOR = 5
+TEMPLATE_COLOR = 9
+
+MATCH_DIMS = ((2, 3), (3, 2))
+DISTRACTOR_DIMS = ((2, 4), (4, 2), (3, 3), (2, 5), (5, 2), (3, 4), (4, 3))
