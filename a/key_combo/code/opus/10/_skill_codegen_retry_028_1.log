+    random.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    for r, c in candidates:
+        if all(max(abs(r - rr), abs(c - cc)) >= 2 for rr, cc in chosen):
+            chosen.append((r, c))
+            if len(chosen) == count:
