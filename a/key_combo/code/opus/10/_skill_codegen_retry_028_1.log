spec:
  grid: 13-30 rows x 16-30 cols
  background: single dominant color
  foreground_colors: 1-3 distinct colors, each != background
  per_color:
    rectangle: exactly 1 solid filled rectangle, min dimension >= 2, max dimension 2-11
    markers: 1-3 isolated single-pixel markers of same color
    marker_alignment: each marker is axis-aligned with rectangle bbox (shares row-span XOR col-span), outside the bbox
    marker_offset: marker's aligned coord is >= 1 from both edges of the rect span (room for 3-cell cap)
    marker_distance: 3-10 cells from nearest rect edge to marker
    same_side_spacing: same-side markers need aligned-coord diff >= 3 (non-overlapping caps)
  clearance: entire protrusion area (path + caps + 1-cell-beyond) must be background in input; no overlap across colors
  output_rule: |
    Per marker, draw 1-wide path from rect side to 1 cell beyond marker.
    Add 3-cell perpendicular cap at rect side and 2-cell cap flanking marker.
    Clear original marker pixel to background.

generation_strategy:
