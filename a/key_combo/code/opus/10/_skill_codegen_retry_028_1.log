  colors: exactly 3 — one background (dominant, color 7 observed) + two foreground
  walls:
    left column: solid foreground color A
    right column: solid foreground color B (A != B)
  objects:
    definition: 8-connected components of wall color, excluding the wall column itself
    per_wall_color: 2-3 components
    size: 1-7 pixels each
    bbox: 1x1 to 5x3, density 0.56-1.0
    total_inner_foreground: 15-23 pixels, fill ~25-37% of inner area
    placement: scattered in interior (cols 1..W-2), at least 1 col gap from own wall
    same-color components may share rows (blocking each other when settling)
    different-color components may share rows (must not collide after settling)
  rule: |
    Slide each object horizontally toward its same-colored wall until it touches
    the wall or a previously settled same-color object. Process nearest-to-wall
    first within each color. Walls stay fixed. Object shapes preserved.
  output_invariants:
    - all settled objects touch their wall (directly or via chain of same-color objects)
    - no overlap between any two settled objects or between objects and opposite wall
    - pixel counts per color preserved exactly

generation_strategy:
