+    direction = COUNT_TO_DIRECTION[marker_count]
+    n_objects = random.choice((2, 3))
+    shapes = [_random_shape(random.randint(3, 6)) for _ in range(n_objects)]
+    colors = random.sample(list(OBJECT_COLORS), n_objects)
