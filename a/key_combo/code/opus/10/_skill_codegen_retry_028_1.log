+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+MARKER = 5
+SEPARATOR = 6
+OBJECT_COLORS = (BLUE, RED, GREEN)
+
+COUNT_TO_DIRECTION = {
+    1: "down",
+    2: "right",
+    3: "up",
+    4: "left",
+}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(cnts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(grid: np.ndarray, *, bg: int = BG) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color == bg:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _component_order_key(coords: np.ndarray, direction: str) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    if direction == "down":
+        return (-r1, c0, r0, c1)
+    if direction == "up":
+        return (r0, c0, r1, c1)
+    if direction == "right":
+        return (-c1, r0, c0, r1)
+    assert direction == "left"
+    return (c0, r0, c1, r1)
+
+
+def _shift_coords(coords: np.ndarray, dr: int, dc: int, steps: int) -> np.ndarray:
+    return coords + np.array([dr * steps, dc * steps], dtype=int)
+
+
+def _settle_panel(panel: np.ndarray, direction: str, *, return_meta: bool = False):
+    comps = _find_components(panel, bg=BG)
+    comps.sort(key=lambda comp: _component_order_key(comp["coords"], direction))
+
+    h, w = panel.shape
+    settled = np.full((h, w), BG, dtype=int)
+    occupied = np.zeros((h, w), dtype=bool)
+    move = {
+        "down": (1, 0),
+        "up": (-1, 0),
+        "right": (0, 1),
+        "left": (0, -1),
+    }[direction]
+
+    meta: list[dict] = []
+    for comp in comps:
