+    panels = [
+        g[:panel_h, :].copy(),
+        g[r1 + 1 : r2, :].copy(),
+        g[r2 + 1 :, :].copy(),
+    ]
+
+    out = np.full((panel_h, w), BG, dtype=int)
+    for panel in panels:
+        marker_count = int(np.count_nonzero(panel == MARKER))
+        assert marker_count in COUNT_TO_DIRECTION, f"unsupported marker count: {marker_count}"
