+
+def _build_input(
+    rows: int,
+    cols: int,
+    template_rel: list[tuple[int, int]],
+    template_size: tuple[int, int],
+    offsets: list[tuple[int, int]],
+) -> tuple[np.ndarray, np.ndarray] | None:
