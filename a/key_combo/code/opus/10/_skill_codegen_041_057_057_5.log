+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+GRID_ROWS_RANGE = (14, 18)
+GRID_COLS_RANGE = (14, 18)
+MARKER_COUNT_RANGE = (4, 6)
+MAX_GENERATION_ATTEMPTS = 400
+TEMPLATE_RETRIES = 120
