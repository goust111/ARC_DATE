    found: dict[tuple[int, int], tuple[int, tuple[int, int]]] = {}

    mask = np.zeros((3, 3), dtype=bool)
    for rr, cc in [(0, 0), (0, 2), (1, 1), (2, 0), (2, 2)]:
        mask[rr, cc] = True

    for r0 in range(h - 2):
        for c0 in range(w - 2):
            sub = g[r0 : r0 + 3, c0 : c0 + 3]
            col = int(sub[0, 0])  # top-left must be colored for an X
            if col == bg:
                continue
            if np.any(sub[mask] != col) or np.any(sub[~mask] != bg):
                continue
            # Ensure the X is isolated (no 4-neigh same-color outside the 3x3).
            isolated = True
            for dr0, dc0 in _X_OFF:
                rr, cc = r0 + 1 + dr0, c0 + 1 + dc0
                for nr, nc in neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and not (r0 <= nr < r0 + 3 and c0 <= nc < c0 + 3):
                        if int(g[nr, nc]) == col:
                            isolated = False
                            break
                if not isolated:
                    break
            if not isolated:
                continue
            found[(r0 + 1, c0 + 1)] = (col, (r0, c0))
    return found


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    return [[(int(r), int(c)) for r, c in comp] for comp in components_mask(mask, connectivity=4)]


def _find_9rects(g: np.ndarray) -> list[tuple[set, dict]]:
    """Find color-9 rectangular blocks and their wire connections per face."""
    mask9 = g == 9
    if not mask9.any():
        return []
    h, w = g.shape
    rects = []
    for comp9 in components_mask(mask9, connectivity=4):
        cells = set((int(r), int(c)) for r, c in comp9)
        rs = [r for r, _ in cells]; cs = [c for _, c in cells]
        r0, r1, c0, c1 = min(rs), max(rs), min(cs), max(cs)
        faces: dict[str, list] = {}
        for r, c in cells:
            for nr, nc in neighbors4(r, c):
                if (nr, nc) not in cells and 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) in (5, 8):
                    face = "N" if nr < r0 else "S" if nr > r1 else "W" if nc < c0 else "E"
                    faces.setdefault(face, []).append((nr, nc))
        rects.append((cells, faces))
    return rects


_OPP = {"N": "S", "S": "N", "E": "W", "W": "E"}
_DIR2FACE = {(1, 0): "N", (-1, 0): "S", (0, 1): "W", (0, -1): "E"}
_FACE2DIR = {"S": (1, 0), "N": (-1, 0), "E": (0, 1), "W": (0, -1)}


def _trace_wire(
    comp: set[tuple[int, int]],
    start: tuple[int, int],
    dir0: tuple[int, int],
    h: int,
    w: int,
    rects_9: list[tuple[set, dict]],
) -> tuple[tuple[int, int], tuple[int, int]]:
    """
    Greedy wire following with 9-rect pass-through.

    At a color-9 rectangle: exit from opposite face (aligned with entry column/row).
    If no opposite exit, assert exactly one other exit face and use that.
    """
    cur, d, prev = start, dir0, None
    visited: set[tuple[tuple[int, int], tuple[int, int]]] = set()
    for _ in range(h * w * 4):
        if (cur, d) in visited:
            assert False, "wire trace looped — should not happen with 9-rect pass-through"
        visited.add((cur, d))

        # 9-rect pass-through
        jumped = False
        for cells9, faces9 in rects_9:
            if cur in cells9:
                entry_face = _DIR2FACE[d]
                opp = _OPP[entry_face]
                if opp in faces9:
                    exit_face = opp
                else:
                    others = [f for f in faces9 if f != entry_face]
                    assert len(others) == 1
                    exit_face = others[0]
                pts = faces9[exit_face]
                er, ec = cur
                if entry_face in ("N", "S"):
                    exit_cell = min(pts, key=lambda p: abs(p[1] - ec))
                else:
                    exit_cell = min(pts, key=lambda p: abs(p[0] - er))
                cur, d, prev = exit_cell, _FACE2DIR[exit_face], None
                jumped = True
                break
        if jumped:
            continue

        r, c = cur
        opts = [((nr, nc), nr - r, nc - c) for nr, nc in neighbors4(r, c) if (nr, nc) in comp]
        if not opts:
            return cur, d

        rev = (-d[0], -d[1])
        nonrev = [o for o in opts if (o[1], o[2]) != rev]
        opts2 = nonrev if nonrev else opts

        straight = [o for o in opts2 if (o[1], o[2]) == d]
        if straight:
            p, dr, dc = straight[0]
        else:
            perp = [o for o in opts2 if o[1] * d[0] + o[2] * d[1] == 0]
            if perp:
                p, dr, dc = sorted(perp, key=lambda x: (x[1], x[2]))[0]
            else:
                p, dr, dc = opts2[0]

        if p == prev:
            return cur, d

        prev = cur
        cur = p
        d = (dr, dc)

    assert False, "wire trace exceeded step limit"


def main(grid: np.ndarray) -> np.ndarray:
    """
    Transmit colored tokens along wire networks, converting each to its complementary 3×3 pattern.

    Input structure:
    - bg = background. Non-bg cells form wire networks and 3×3 tokens (solid blocks or X/diagonal patterns) near wire endpoints.

    Rule:
    - Every solid 3×3 token is replaced in-place by a diamond (center + 4 cardinal neighbors).
    - Each token near a wire endpoint sends its complement to the opposite endpoint: solid emits X, X emits diamond.

    Key insight: Token shape cycles solid → X → diamond; wires route each complement to the far end.
    """
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    bg = get_bg(g)

    solids = _find_solid_3x3(g, bg)  # center -> (color, (r0,c0))
    xs = _find_x_3x3(g, bg)  # center -> (color, (r0,c0))

    # Build track mask: non-bg minus token cells.
    track_mask = g != bg
    for (cr, cc), (_, (r0, c0)) in solids.items():
        track_mask[r0 : r0 + 3, c0 : c0 + 3] = False
    for (cr, cc) in xs.keys():
        for dr, dc in _X_OFF:
            rr, cc2 = cr + dr, cc + dc
            if 0 <= rr < h and 0 <= cc2 < w:
                track_mask[rr, cc2] = False

    comps = _components(track_mask)
    rects_9 = _find_9rects(g)

    out = g.copy()

    # Solid tokens become diamonds in place.
    for (cr, cc), (col, (r0, c0)) in solids.items():
        out[r0 : r0 + 3, c0 : c0 + 3] = bg
        for dr, dc in _DIAMOND_OFF:
            rr, cc2 = cr + dr, cc + dc
            if 0 <= rr < h and 0 <= cc2 < w:
                out[rr, cc2] = col

    # Route tokens across each track component.

====SPEC====
spec:
  grid: 19-26 rows x 22-26 cols
  palette:
    bg: 0
    wire: 8 (main segments), 5 (crossing markers, see crossings below), 9 (rectangular filled blocks embedded in wire)
    token_colors: 4-5 distinct colors from {1,2,3,4,6,7}, one per channel
  layout: N=4-5 channels; tokens on opposite sides of grid (top/bottom [observed 3/4] or left/right); uniform column spacing 4-5 between channel centers
  tokens:
    shapes: solid 3x3 block, X-pattern (diags+center, 5 cells), diamond (4 cardinal no center, 4 cells)
    input: each color appears at most once as solid or X; 0-2 X tokens, rest solid; X channel far-end is usually empty (~67%, diamond generated by solver routing) or has pre-placed diamond (~33%)
    output: every channel has diamond on one side and X on the other; same color pairs linked by wire routing
  wire_network:
    composition: 1 connected component (rarely 2 for vertical layout [observed]); 50-160 cells total
    structure: orthogonal segments of color 8; color-9 rectangular blocks (0-4 blocks, 2x2 to 5x4) embedded in wire as wide junctions; each rect has 1-3 wires passing through (50% 1-wire, 38% 2-wire, 12% 3-wire); wires pass straight through (entry face → opposite face); exception: when rect has exactly 1 entry + 1 exit on adjacent (not opposite) faces, wire turns inside
    crossings (color 5): each perpendicular wire intersection is bracketed by a pair of 5-cells on the through-wire, one cell before and after the crossing point, marking "continue straight, do not turn"
    endpoints: each channel contributes 1 endpoint per side; endpoint is degree-1 cell; token center is 2 cells outward from endpoint in cardinal exit direction
    routing: wire implements a permutation of channels; at least some channels must cross (non-identity permutation) [observed]
  transform: |
    solid: becomes diamond in-place + X emitted to far endpoint via wire
    X: unchanged + diamond emitted to far endpoint via wire
    diamond: unchanged (already at rest)

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid H,W in [20,26]. Pick N in {4,5} channel columns with uniform spacing 4-5, centered in grid. Token rows at row 2 (top) and row H-4 to H-3 (bottom).
    2. Assign N distinct token colors. Choose a random permutation P of channels (non-identity). For each channel i, diamond of color i at top, X of color P(i) at bottom (output state).
    3. Build wire network connecting top endpoints to bottom endpoints implementing permutation P. Use manhattan routing with vertical column segments and horizontal crossover segments. At each perpendicular wire crossing, place a pair of color-5 cells on the through-wire flanking the intersection. Embed 0-3 color-9 rectangular blocks (2x2 to 5x4) along wire segments: pick a contiguous rectangle of existing wire cells (color 8) that covers 1-3 parallel wires, replace those cells with color 9. Each wire entering the rect must exit from the opposite face (straight pass-through). Exception: if the rect has exactly 1 entry + 1 exit on adjacent faces, the wire turns inside.
    4. Derive input from output -- for each channel, randomly choose which side gets the input token. Most tokens are solid (reverses diamond to solid at that position). Pick 0-2 channels to have X input token instead; for X channels, far-end is usually left empty (~67%) or has pre-placed diamond (~33%). Remaining non-X far-end positions are left empty (bg).
    5. Oracle -- run solver, verify output matches expected.

