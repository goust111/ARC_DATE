+    for color in layer_colors:
+        coords = np.argwhere(grid == color)
+        dist = min(abs(r - int(rr)) + abs(c - int(cc)) for rr, cc in coords)
+        if best is None or dist < best:
+            best = dist
+            winners = {int(color)}
+        elif dist == best:
+            winners.add(int(color))
+    if len(winners) == 1:
