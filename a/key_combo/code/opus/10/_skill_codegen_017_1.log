    return [(r, c1) for r in range(r0, r1 + 1)]


def _infer_layers(grid: np.ndarray) -> list[dict[str, int | Rect]]:
    colors = sorted(int(v) for v in np.unique(grid) if int(v) not in (BACKGROUND, MARKER))
