+    expected = np.full(shape, BACKGROUND, dtype=int)
+    winner_idx = max(range(3), key=lambda idx: counts[idx])
+    wr0, wc0, wr1, wc1 = rects[winner_idx]
+    expected[wr0 : wr1 + 1, wc0 : wc1 + 1] = colors[winner_idx]
