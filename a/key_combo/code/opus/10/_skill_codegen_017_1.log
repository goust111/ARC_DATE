def _gen_choose_centers() -> list[tuple[int, int]]:
    top_r = _gen_randint(*GEN_TOP_ROWS)
    bot_r = _gen_randint(max(GEN_BOT_ROWS[0], top_r + GEN_MIN_SEP), GEN_BOT_ROWS[1])

