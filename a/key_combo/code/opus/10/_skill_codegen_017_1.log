+        outer[1] + outer_gap_c,
+        outer[2] - outer_gap_r,
+        outer[3] - outer_gap_c,
+    )
+    inner = (
+        middle[0] + inner_gap_r,
+        middle[1] + inner_gap_c,
+        middle[2] - inner_gap_r,
