+            if any(abs(r - rr) + abs(c - cc) <= 1 for rr, cc in chosen):
+                continue
+            chosen.append(cell)
+            if len(chosen) == count:
+                return chosen
+        if len(chosen) == count:
+            return chosen
+    return None
+
+
