+def _nearest_side(
+    bbox: tuple[int, int, int, int], shape: tuple[int, int]
+) -> str | None:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    center_r2 = r0 + r1
+    center_c2 = c0 + c1
+    distances = {
+        "top": center_r2,
+        "right": 2 * (w - 1) - center_c2,
+        "bottom": 2 * (h - 1) - center_r2,
+        "left": center_c2,
+    }
+    best = min(distances.values())
+    winners = [side for side, value in distances.items() if value == best]
+    if len(winners) != 1:
+        return None
+    return winners[0]
+
