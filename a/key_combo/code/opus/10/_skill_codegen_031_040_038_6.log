+MARKER_COLORS = (1, 2, 3, 6)
+SIDE_ORDER = ("top", "right", "bottom", "left")
+FIXED_SIDE_COLORS = {"top": 4, "right": 7, "bottom": 5, "left": 9}
+ORIENTATIONS = ("TLBR", "TRBL")
+GEN_MAX_ATTEMPTS = 500
