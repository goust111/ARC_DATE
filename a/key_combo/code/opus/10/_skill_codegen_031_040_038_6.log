+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _intersection_area(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
+) -> int:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return 0
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _nearest_side(
+    bbox: tuple[int, int, int, int], shape: tuple[int, int]
+) -> str:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    center_r2 = r0 + r1
+    center_c2 = c0 + c1
+    distances = {
+        "top": center_r2,
+        "right": 2 * (w - 1) - center_c2,
+        "bottom": 2 * (h - 1) - center_r2,
+        "left": center_c2,
+    }
+    best = min(distances.values())
+    winners = [side for side, value in distances.items() if value == best]
+    assert len(winners) == 1, "rectangle center must have a unique nearest side"
+    return winners[0]
+
+
+def _marker_points(
+    bbox: tuple[int, int, int, int], orientation: str
+) -> tuple[tuple[int, int], tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if orientation == "TLBR":
+        return (r0, c0), (r1, c1)
+    assert orientation == "TRBL"
+    return (r0, c1), (r1, c0)
