def _choose_shape(edge: str, nonempty: int) -> tuple[int, int]:
    """Choose dimensions whose lane count satisfies the active-lane ratio."""
    lane_lengths = [
        n
        for n in range(SIZE_MIN, SIZE_MAX + 1)
