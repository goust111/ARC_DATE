+
+def _edge_midpoints(shape: tuple[int, int]) -> dict[str, tuple[int, int]]:
+    h, w = shape
+    return {
+        "top": (0, w // 2),
+        "right": (h // 2, w - 1),
+        "bottom": (h - 1, w // 2),
+        "left": (h // 2, 0),
+    }
+
+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _intersection_area(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
+) -> int:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return 0
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
