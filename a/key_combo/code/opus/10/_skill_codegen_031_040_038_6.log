                tail_total, tail_count, _GEN_MIN_TAIL_LENGTH
            ):
                remaining = append_total - sum(tail_lengths)
                for open_count in range(
                    0, min(max_open, remaining // _GEN_MIN_OPEN_PATH_LENGTH) + 1
                ):
