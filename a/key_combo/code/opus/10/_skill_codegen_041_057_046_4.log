+            fg = (cell != BG) & (cell != sep)
+            ncomp = _component_count(fg)
+            if ncomp == 1:
+                out[r0:r1, c0:c1] = np.flipud(cell)
+            elif ncomp == 2:
+                out[r0:r1, c0:c1] = np.fliplr(cell)
+            else:
