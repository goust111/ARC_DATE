+def _bands(size: int, separators: list[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for pos in sorted(int(x) for x in separators):
+        if start < pos:
+            bands.append((start, pos))
+        start = pos + 1
+    if start < size:
+        bands.append((start, size))
+    return bands
