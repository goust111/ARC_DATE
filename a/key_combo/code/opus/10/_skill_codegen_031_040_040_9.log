+RED = 2
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+L_CORNERS = {(0, 0), (0, 1), (1, 0), (1, 1)}
+MISSING_CORNERS = [(0, 0), (0, 1), (1, 0), (1, 1)]
+
+GEN_ATTEMPTS = 400
