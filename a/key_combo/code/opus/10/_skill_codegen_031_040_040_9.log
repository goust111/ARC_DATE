+    if config["mode"] == "vertical":
+        if config["side"] == -1:
+            rect_r1 = tri_r0 - 2
+            rect_r0 = rect_r1 - rect_h + 1
+        else:
+            rect_r0 = tri_r0 + 3
+            rect_r1 = rect_r0 + rect_h - 1
