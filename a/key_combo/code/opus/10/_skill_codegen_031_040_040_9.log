+
+def _tile_value(parity: int, inverse: bool) -> int:
+    return BLUE if (parity == 0) ^ inverse else YELLOW
+
+
+def _build_background(h: int, w: int, inverse: bool) -> tuple[np.ndarray, np.ndarray]:
+    tile = np.empty((2, 2), dtype=int)
+    for r in range(2):
+        for c in range(2):
