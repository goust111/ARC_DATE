+
+
+def _can_place_seed(
+    seeds: set[tuple[int, int]],
+    r: int,
+    c: int,
+    h: int,
+    w: int,
+    reserved: set[tuple[int, int]],
+) -> bool:
+    if not (2 <= r <= h - 3 and 2 <= c <= w - 3):
+        return False
+    if (r, c) in seeds or (r, c) in reserved:
+        return False
+    for sr, sc in seeds:
