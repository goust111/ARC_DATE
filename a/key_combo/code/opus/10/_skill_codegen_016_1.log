+            return False
+    return True
+
+
+def _place_extra_isolated(
+    rng: np.random.Generator,
+    seeds: set[tuple[int, int]],
+    h: int,
+    w: int,
+    row_min: int,
+    reserved: set[tuple[int, int]],
+) -> bool:
+    for _ in range(GEN_EXTRA_PLACEMENT_ATTEMPTS):
+        r = int(rng.integers(row_min, h - 2))
+        c = int(rng.integers(2, w - 2))
+        if (r, w - 1 - c) in seeds:
