+    grid[1, :] = SEPARATOR_COLOR
+    grid[2, : len(palette2)] = palette2
+    for r, c in seeds:
+        grid[r, c] = int(palette1[0])
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_MAX_ATTEMPTS):
