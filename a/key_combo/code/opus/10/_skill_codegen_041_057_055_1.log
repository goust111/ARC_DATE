+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+SEED_PALETTE = (BLUE, YELLOW, ORANGE)
+FORBIDDEN_SEED_COLORS = {BLACK, GREEN, GREY, RED, TEAL}
+POST_OFFSETS = ((-1, -2), (-1, 2), (0, -2), (0, 2), (1, -2), (1, 2))
