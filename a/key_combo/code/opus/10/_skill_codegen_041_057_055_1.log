                degree += 1
        if degree == 1:
            rows.append(r)
    assert len(rows) == 1
    return rows[0]


def _shift_group(group: np.ndarray, bg: int, dr: int) -> np.ndarray:
    h, _ = group.shape
    shifted = np.full_like(group, bg)
    coords = np.argwhere(group != bg)
    for r, c in coords:
        nr = r + dr
        assert 0 <= nr < h
        shifted[nr, c] = group[r, c]
    return shifted


