+    assert 2 <= len(markers) <= 3, "expected 2-3 markers"
+    cols = [c for _r, c, _color in markers]
+    assert len(set(cols)) == len(cols), "marker columns must be distinct"
+    return sorted(markers, key=lambda item: (item[1], item[0], item[2]))
+
