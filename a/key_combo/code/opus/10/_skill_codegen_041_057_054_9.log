+def generate_input() -> np.ndarray:
+    global _NEXT_SAME_MAJORITY
+
+    _NEXT_SAME_MAJORITY = not _NEXT_SAME_MAJORITY
+    target_same_majority = _NEXT_SAME_MAJORITY
