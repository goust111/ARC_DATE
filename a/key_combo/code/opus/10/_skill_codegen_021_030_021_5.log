+    controls: list[tuple[int, int, int]],
+    axis: int,
+    reducer,
+    name: str,
+) -> tuple[int, int, int]:
+    value = reducer(ctrl[axis] for ctrl in controls)
+    matches = [ctrl for ctrl in controls if ctrl[axis] == value]
+    assert len(matches) == 1, f"expected a unique {name} control"
+    return matches[0]
