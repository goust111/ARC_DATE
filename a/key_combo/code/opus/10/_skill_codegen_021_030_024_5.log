def _consume_alias(kwargs: dict, primary: str, aliases: Sequence[str]):
    """
    Consume a keyword argument by primary name or any alias, ensuring no conflicts.

    Returns:
        (value, used_name) or (None, None) if not found.
    """
    used = None
