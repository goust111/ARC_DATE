+                forced.append((pos[0], pos[1], color))
+
+        if w % 2 == 1 and int(g[r, w // 2]) == MASK:
+            groups.append({"positions": ((r, w // 2),), "weight": 1})
+
+    return g, ranked_colors, base_counts, forced, groups
+
+
+def _solve_ranked_groups(
+    ranked_colors: list[int],
