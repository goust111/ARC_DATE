+                solutions.append(tuple(assignment))
+            return
+
+        weight = weights[i]
+        for color in ranked_colors:
+            idx = color_to_index[color]
+            increments[idx] += weight
+            assignment.append(color)
+            dfs(i + 1)
+            assignment.pop()
+            increments[idx] -= weight
+            if len(solutions) >= limit:
+                return
