   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """Pack all pixels into color-frequency runs along bottom-up columns.
   8: 
   9:     Input structure
  10:     The input is a rectangular grid whose colors are all foreground material;
  11:     only the number of pixels of each color matters. In the observed task
  12:     instances, every present color has a distinct pixel count.
  13: 
  14:     Rule
  15:     Count the pixels of each color and order the colors from most frequent to
  16:     least frequent. Rewrite a same-size grid by placing each color's full count
  17:     as one contiguous run while scanning columns from left to right and, within
  18:     each column, from bottom to top.
  19: 
  20:     Key insight
  21:     The output preserves the multiset of colors but discards all original
  22:     positions, turning the grid into a frequency-sorted column packing.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     assert g.ndim == 2
  26: 
  27:     counts = Counter(map(int, g.ravel()))
  28:     assert len(set(counts.values())) == len(counts), "color counts must have a unique rank"
  29: 
  30:     colors = sorted(counts, key=lambda color: -counts[color])
  31:     out = np.empty_like(g)
  32:     height, width = g.shape
  33: 
  34:     scan = ((r, c) for c in range(width) for r in range(height - 1, -1, -1))
  35:     for color in colors:
  36:         for _ in range(counts[color]):
  37:             r, c = next(scan)
  38:             out[r, c] = color
  39: 
