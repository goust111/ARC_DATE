+    for segment in red_segments:
+        for r, c in segment:
+            grid[r, c] = RED
+    for segment in blue_segments:
+        for r, c in segment:
+            grid[r, c] = BLUE
+    r, c = template_center
+    for dr, dc in RING_OFFSETS:
+        grid[r + dr, c + dc] = GREEN
+    return grid
