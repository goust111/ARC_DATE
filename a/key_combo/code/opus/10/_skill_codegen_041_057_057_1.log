def _gen_table_value(r: int, c: int, cycle: list[int]) -> int:
    near = min(r, c)
    dist = abs(r - c)
    if dist == 0:
        return cycle[0]
    if dist <= near + 1:
        return cycle[-1]
    return cycle[((dist - (near + 2)) // (near + 2)) % len(cycle)]


