+    orbits: list[list[tuple[int, int]]] = []
+    for r in range(n):
+        for c in range(n):
+            if (r, c) in seen:
+                continue
+            orbit: list[tuple[int, int]] = []
+            cur = (r, c)
+            while cur not in orbit:
+                orbit.append(cur)
+                cur = (cur[1], n - 1 - cur[0])
+            for cell in orbit:
+                seen.add(cell)
+            orbits.append(orbit)
+    return orbits
