+def _ring_mask(size: int, dist: int) -> np.ndarray:
+    center = size // 2
+    rr = np.arange(size)[:, None]
+    cc = np.arange(size)[None, :]
+    return np.maximum(np.abs(rr - center), np.abs(cc - center)) == dist
