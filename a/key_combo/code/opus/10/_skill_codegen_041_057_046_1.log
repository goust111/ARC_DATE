+def _seed_cells(grid: np.ndarray) -> set[tuple[int, int]]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(np.asarray(grid) == BLUE)]
+    assert 2 <= len(coords) <= 3, "expected a 2-3 pixel blue seed"
+    seed = set(coords)
