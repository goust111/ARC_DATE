+    same_main_diag = len({r - c for r, c in seed}) == 1
+    same_anti_diag = len({r + c for r, c in seed}) == 1
+    assert same_main_diag or same_anti_diag, "seed must lie on one diagonal"
+
+    if same_main_diag:
