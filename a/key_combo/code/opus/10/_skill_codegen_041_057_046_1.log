+    g = np.asarray(grid, dtype=int)
+    seed = _seed_cells(g)
+    h, w = g.shape
+
+    if len({r - c for r, c in seed}) == 1:
+        dirs = ((1, 1), (-1, -1))
+    else:
+        dirs = ((1, -1), (-1, 1))
+
+    candidates: list[tuple[int, int, int, int]] = []
+    n = len(seed)
+    for dr, dc in dirs:
+        for r, c in seed:
+            seq = [(r + k * dr, c + k * dc) for k in range(n)]
+            if set(seq) != seed:
