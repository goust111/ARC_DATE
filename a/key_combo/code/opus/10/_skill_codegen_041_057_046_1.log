spec:
  grid: 10x10 [observed]
  colors: bg=0, wall=5, two marker colors (1 and 2 in all examples) [observed]
  wall_structure:
    wall_rows: 3-4 rows including row 0 and row H-1; gaps between consecutive wall rows 3-5
    wall_cols: 2 interior columns (never col 0 or col W-1); gap between them 3-5
    composition: every cell on a wall row or wall col is wall(5) or marker; no bg(0) on wall lines
    intersections: wall row/col intersections are always wall color (5)
  markers:
