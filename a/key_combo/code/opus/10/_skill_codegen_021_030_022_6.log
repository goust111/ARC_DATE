+    if not dims:
+        return None
+    for _ in range(240):
+        height, width = dims[int(_RNG.integers(len(dims)))]
+        top = int(_RNG.integers(0, cell_rows - height + 1))
+        left = int(_RNG.integers(0, cell_cols - width + 1))
+        rect = (top, left, top + height - 1, left + width - 1)
