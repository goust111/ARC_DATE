+def _interiors_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _sample_free_rect(
+    count: int,
+    cell_rows: int,
+    cell_cols: int,
+    existing: list[tuple[int, int, int, int]],
