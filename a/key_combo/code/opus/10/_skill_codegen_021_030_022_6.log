+    cells = [cell for cell in _rect_cells(rect) if cell not in used_cells]
+    if len(cells) < count:
+        return None
+
+    valid: list[tuple[tuple[int, int], ...]] = []
+    for combo in itertools.combinations(cells, count):
+        rows = [r for r, _c in combo]
