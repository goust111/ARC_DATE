    containing = [(a, b) for a, b in zip(bounds, bounds[1:]) if a < x < b]
    assert len(containing) == 1, "marker must lie on or inside the scaffold lattice"
    return containing[0]


def _centers_between(bounds: list[int], lo: int, hi: int) -> list[int]:
