# Canvas/color model.
_GEN_GRID_SHAPE = (3, 3)
_GEN_BG_COLOR, _GEN_INPUT_COLOR, _GEN_OUTPUT_COLOR = Color.BLACK, Color.BLUE, Color.RED
# Count/retry controls.
