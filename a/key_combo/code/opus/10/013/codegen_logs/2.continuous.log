import random
from collections import deque
import numpy as np
BG=7; BLACK=0
DIRS=[(-1,-1),(-1,1),(1,-1),(1,1)]
N4=[(-1,0),(1,0),(0,-1),(0,1)]

def stats(pos,H=15,W=15):
    colors=[1,2,3][:len(pos)]
    g=np.full((H,W),BG,dtype=int)
    for (r,c),col in zip(pos,colors): g[r,c]=col
    srcs=[(r,c,col) for (r,c),col in zip(pos,colors)]
    owners=[[set() for _ in range(W)] for _ in range(H)]
    for idx,(r,c,_) in enumerate(srcs):
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            while 0<=nr<H and 0<=nc<W:
                owners[nr][nc].add(idx); nr+=dr; nc+=dc
    ray=np.array([[bool(owners[r][c]) for c in range(W)] for r in range(H)])
    seen=np.zeros((H,W),bool)
    regions=[]
    for r in range(H):
      for c in range(W):
       if not ray[r,c] and not seen[r,c]:
        q=deque([(r,c)]); seen[r,c]=1; comp=[]
        while q:
         x,y=q.popleft(); comp.append((x,y))
         for dx,dy in N4:
          nx,ny=x+dx,y+dy
          if 0<=nx<H and 0<=ny<W and not ray[nx,ny] and not seen[nx,ny]: seen[nx,ny]=1; q.append((nx,ny))
        s=set()
        for x,y in comp:
         for dx,dy in N4:
          nx,ny=x+dx,y+dy
          if 0<=nx<H and 0<=ny<W and ray[nx,ny]: s|=owners[nx][ny]
        regions.append((len(comp),sorted(s)))
    cross=sum(1 for r in range(1,H-1) for c in range(1,W-1) if len(owners[r][c])>=2)
    return cross, regions, ray.mean()

# brute-force some 2-source interesting
H=W=15
best=[]
for a in [(r,c) for r in range(2,13) for c in range(2,13)]:
  for b in [(r,c) for r in range(2,13) for c in range(2,13)]:
    if a>=b: continue
    if a[0]==b[0] or a[1]==b[1] or abs(a[0]-b[0])==abs(a[1]-b[1]): continue
    cross,regions,d=stats([a,b],H,W)
    singles=[area for area,s in regions if len(s)==1]
    mixed=[area for area,s in regions if len(s)>=2]
    if cross>=2 and singles and mixed:
      print('found',a,b,'cross',cross,'singlemax',max(singles),'mixedmax',max(mixed),'regions',regions[:8])
