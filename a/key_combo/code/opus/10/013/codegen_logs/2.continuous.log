                nr+=dr; nc+=dc
    out=g.copy()
    ray=np.zeros((H,W),dtype=bool)
    for r in range(H):
        for c in range(W):
            if owners[r][c]:
                ray[r,c]=True
                out[r,c]=BLACK
    def comps(mask):
        seen=np.zeros_like(mask,dtype=bool)
        res=[]
        for r in range(H):
            for c in range(W):
                if mask[r,c] and not seen[r,c]:
                    q=deque([(r,c)])
                    seen[r,c]=True
                    comp=[]
                    while q:
                        x,y=q.popleft(); comp.append((x,y))
                        for dx,dy in N4:
