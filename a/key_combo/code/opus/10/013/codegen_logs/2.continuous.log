from collections import deque
import numpy as np, random
BG=7
DIRS=[(-1,-1),(-1,1),(1,-1),(1,1)]
N4=[(-1,0),(1,0),(0,-1),(0,1)]

S=5

def bresenham_line(a,b):
    (x0,y0),(x1,y1)=a,b
    dx=abs(x1-x0); dy=abs(y1-y0)
    sx=1 if x0<x1 else -1
    sy=1 if y0<y1 else -1
    err=dx-dy
    pts=[]
    while True:
        pts.append((x0,y0))
        if x0==x1 and y0==y1: break
        e2=2*err
        if e2>-dy:
            err-=dy; x0+=sx
        if e2<dx:
            err+=dx; y0+=sy
    return pts

def analyze(pos,H=15,W=15):
    HH,WW=H*S,W*S
    owners=[[set() for _ in range(WW)] for _ in range(HH)]
    for idx,(r,c) in enumerate(pos):
        cr,cc=r*S+S//2,c*S+S//2
        for dr,dc in DIRS:
            rr,cc2=r,c
            while True:
                nr,nc=rr+dr,cc2+dc
                if not (0<=nr<H and 0<=nc<W): break
                for x,y in bresenham_line((rr*S+S//2,cc2*S+S//2),(nr*S+S//2,nc*S+S//2))[1:]:
                    owners[x][y].add(idx)
                rr,cc2=nr,nc
    line=np.array([[bool(owners[r][c]) for c in range(WW)] for r in range(HH)])
    seen=np.zeros((HH,WW),bool)
    regs=[]
    for r in range(HH):
      for c in range(WW):
        if line[r,c] or seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; comp=[]
        while q:
          x,y=q.popleft(); comp.append((x,y))
          for dx,dy in N4:
            nx,ny=x+dx,y+dy
            if 0<=nx<HH and 0<=ny<WW and not line[nx,ny] and not seen[nx,ny]: seen[nx,ny]=1; q.append((nx,ny))
        boundary=[]
        cells=set()
        for x,y in comp:
          cells.add((x//S,y//S))
          for dx,dy in N4:
            nx,ny=x+dx,y+dy
            if 0<=nx<HH and 0<=ny<WW and line[nx,ny]: boundary.append(owners[nx][ny])
        union=set().union(*boundary) if boundary else set()
        inter=set(boundary[0]) if boundary else set()
        for s in boundary[1:]: inter &= s
        regs.append((len(cells),union,inter))
    return regs

