                if 0<=nr<H and 0<=nc<W and ray[nr,nc]:
                    s |= owners[nr][nc]
        regstats.append((len(comp),set(s)))
        if len(s)==1:
            idx=next(iter(s))
            color=srcs[idx][2]
            for r,c in comp:
                out[r,c]=color
    return out,srcs,owners,ray,regstats

def sample():
    H=random.randint(13,17); W=random.randint(13,17)
    n=random.choice([2,3])
