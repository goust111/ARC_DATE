def build(grid):
    g=grid.copy()
    H,W=g.shape
    srcs=[]
    for r,c in np.argwhere((g"'!=BG)&(g!=BLACK)):
        srcs.append((int(r),int(c),int(g[r,c])))
    owners=[[set() for _ in range(W)] for _ in range(H)]
    for idx,(r,c,_) in enumerate(srcs):
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            while 0<=nr<H and 0<=nc<W:
