+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+MAROON = 9
+RECT_COLORS = (1, 2, 3, 4, 6, 7)
+MAX_GENERATION_ATTEMPTS = 400
