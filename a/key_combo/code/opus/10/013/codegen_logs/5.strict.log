+
+    maroon_count = random.randint(2, 4)
+    maroons: set[tuple[int, int]] = set()
+    source_end = source["c0"] + source["w"] - 1
+    path_rows = [source["r0"] + i for i in range(source["h"])]
+    if random.random() < 0.8:
