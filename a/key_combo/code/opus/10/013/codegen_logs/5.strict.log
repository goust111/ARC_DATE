+    for order, rect_id in enumerate(ranked):
+        r0, c0, r1, c1 = rectangles[rect_id]["bbox"]
+        if order == 0:
+            continue
+        fill = GREY if order == 1 else BG
+        out[r0 : r1 + 1, c0 : c1 + 1] = fill
+    return out
