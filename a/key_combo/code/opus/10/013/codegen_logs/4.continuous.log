GRID_SHAPE = (20, 20)
BG_COLOR = 0
LATTICE_COLOR = 1
MARKER_COLORS = [2, 3, 4, 5, 6, 7, 8, 9]
# Lattice/marker geometry.
LATTICE_PERIOD = 3
PHASE_OPTIONS = [1, 2]
MARKER_SIZE = 2
# Retry guard.
MAX_GENERATION_ATTEMPTS = 300


def _gen_width2_band_starts(mask: np.ndarray) -> list[int]:
    starts = []
    i = 0
    while i < len(mask):
        if not mask[i]:
            i += 1
            continue
        j = i
        while j < len(mask) and mask[j]:
            j += 1
        if j - i == MARKER_SIZE:
            starts.append(i)
