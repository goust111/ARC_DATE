+) -> None:
+    r0, c0, r1, c1 = box
+    interior = [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+    scatter = _scatter_colors(border_color, stretch, rng)
+    positions = rng.sample(interior, len(scatter))
+    for (r, c), color in zip(positions, scatter):
+        grid[r, c] = color
