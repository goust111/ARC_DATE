+
+def _corridor_cells(box: tuple[int, int, int, int], direction: str, marker: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    mr, mc = marker
+    pts = {(mr, mc)}
+    if direction == "up":
+        for r in range(mr + 1, r0):
+            pts.add((r, mc))
+    elif direction == "down":
+        for r in range(r1 + 1, mr):
+            pts.add((r, mc))
+    elif direction == "left":
+        for c in range(mc + 1, c0):
+            pts.add((mr, c))
+    else:
+        for c in range(c1 + 1, mc):
+            pts.add((mr, c))
+    return pts
+
+
