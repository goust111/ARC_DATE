+    r0, c0, r1, c1 = box
+    if direction == "up":
+        return r0 - dist, rng.randint(c0 + 1, c1 - 1)
+    if direction == "down":
+        return r1 + dist, rng.randint(c0 + 1, c1 - 1)
+    if direction == "left":
+        return rng.randint(r0 + 1, r1 - 1), c0 - dist
+    return rng.randint(r0 + 1, r1 - 1), c1 + dist
