+            w = rng.randint(5, 8)
+            marker_dist = rng.randint(1, 3)
+            rmin, cmin, rmax, cmax = _candidate_box_bounds(h, w, direction, stretch, marker_dist, (rows, cols))
+            if rmin > rmax or cmin > cmax:
