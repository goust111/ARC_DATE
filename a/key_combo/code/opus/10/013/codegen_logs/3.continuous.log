+def _boxes_intersect(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    return not (
+        a[2] + pad < b[0]
+        or b[2] + pad < a[0]
+        or a[3] + pad < b[1]
+        or b[3] + pad < a[1]
+    )
+
+
+def _intersection_area(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    r0 = max(a[0], b[0])
+    c0 = max(a[1], b[1])
+    r1 = min(a[2], b[2])
+    c1 = min(a[3], b[3])
+    if r0 > r1 or c0 > c1:
+        return 0
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _corridor_cells(box: tuple[int, int, int, int], direction: str, marker: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    mr, mc = marker
+    pts = {(mr, mc)}
+    if direction == "up":
+        for r in range(mr + 1, r0):
+            pts.add((r, mc))
+    elif direction == "down":
+        for r in range(r1 + 1, mr):
+            pts.add((r, mc))
+    elif direction == "left":
+        for c in range(mc + 1, c0):
+            pts.add((mr, c))
+    else:
+        for c in range(c1 + 1, mc):
+            pts.add((mr, c))
