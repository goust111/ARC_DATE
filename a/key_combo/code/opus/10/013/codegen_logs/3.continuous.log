+        if any(or0 <= r <= or1 and oc0 <= c <= oc1 for r, c in corridor):
+            return False
+        r0, c0, r1, c1 = box
+        if any(r0 <= r <= r1 and c0 <= c <= c1 for r, c in other["corridor"]):
