+            marker = _choose_marker(box, direction, marker_dist, rng)
+            candidate = {
+                "bbox": box,
+                "direction": direction,
+                "stretch": stretch,
+                "color": border_color,
+                "marker_color": marker_color,
+                "marker": marker,
+                "corridor": _corridor_cells(box, direction, marker),
