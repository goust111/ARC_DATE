+
+def _choose_marker(box: tuple[int, int, int, int], direction: str, dist: int, rng: random.Random) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    if direction == "up":
+        return r0 - dist, rng.randint(c0 + 1, c1 - 1)
+    if direction == "down":
