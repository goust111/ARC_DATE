+    colors = rng.sample(palette, k)
+    total = rng.randint(max(2, k), 6)
+    scatter = list(colors)
+    while len(scatter) < total:
+        scatter.append(rng.choice(colors))
+    rng.shuffle(scatter)
+    return scatter
