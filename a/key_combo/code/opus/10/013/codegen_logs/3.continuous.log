+        return max(stretch, marker_dist), 0, rows - h, cols - w
+    if direction == "down":
+        return 0, 0, rows - h - max(stretch, marker_dist), cols - w
+    if direction == "left":
+        return 0, max(stretch, marker_dist), rows - h, cols - w
+    return 0, 0, rows - h, cols - w - max(stretch, marker_dist)
+
