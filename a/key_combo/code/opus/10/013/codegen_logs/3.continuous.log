+    return 0, 0, rows - h, cols - w - max(stretch, marker_dist)
+
+
+def _valid_candidate(candidate: dict, placed: list[dict]) -> bool:
+    box = candidate["bbox"]
+    marker = candidate["marker"]
+    corridor = candidate["corridor"]
