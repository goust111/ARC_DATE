+def _stretch_box(box: tuple[int, int, int, int], direction: str, amount: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    if direction == "up":
+        return r0 - amount, c0, r1, c1
+    if direction == "down":
+        return r0, c0, r1 + amount, c1
+    if direction == "left":
