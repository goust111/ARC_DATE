            if (cur[0] + dr, cur[1] + dc) in pts
            and (cur[0] + dr, cur[1] + dc) != prev
        ]
        if len(nxt) != 1 or len(path) > len(pts):
            return None
        prev, cur = cur, nxt[0]
    return path if len(path) == len(pts) else None


