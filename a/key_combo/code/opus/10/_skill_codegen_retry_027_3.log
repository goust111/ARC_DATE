+def _object_sort_key(obj: dict) -> tuple[int, int, int, int]:
+    coords = obj["coords"]
+    bottom = int(coords[:, 0].max())
+    left = int(coords[:, 1].min())
+    top = int(coords[:, 0].min())
+    color = int(obj["color"])
+    return (-bottom, left, top, color)
