+    objects = _extract_objects(g)
+    landed_mask = np.zeros_like(obstacle_mask, dtype=bool)
+    landed: list[dict] = []
+    for idx, obj in enumerate(objects):
+        final_coords = _drop_object(obj["coords"], obstacle_mask | landed_mask)
+        if final_coords is None:
