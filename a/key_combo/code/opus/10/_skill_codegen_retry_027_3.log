+        expected_count=len(settled),
+        expected_majority=majority_color,
+        require_stack=require_stack,
+        require_pixel_counterexample=require_pixel_counterexample,
+    ):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
