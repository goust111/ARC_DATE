+    out = np.full_like(g, BG)
+    _paint_triangle(out, corner, side, fill_color)
+    return out
+
+
+def _sample_counts(n_objects: int) -> tuple[dict[int, int], int]:
+    majority = random.choice(MOVABLE_COLORS)
+    counts = {color: 0 for color in MOVABLE_COLORS}
