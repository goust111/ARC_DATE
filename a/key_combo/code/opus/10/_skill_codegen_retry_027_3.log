+    for k in range(4):
+        rotated = np.rot90(shape, k)
+        for candidate in (rotated, np.fliplr(rotated)):
+            key = tuple(tuple(int(v) for v in row) for row in candidate.astype(int))
+            if key not in seen:
+                seen.add(key)
