+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    comps = find_components(
+        grid,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=MOVABLE_COLORS,
+        return_format="dict",
+    )
+    objects = []
+    for comp in comps:
