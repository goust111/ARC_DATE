+        shifted = coords + np.array([offset + 1, 0], dtype=int)
+        if int(shifted[:, 0].max()) >= h:
+            return None
+        if np.any(blocked[shifted[:, 0], shifted[:, 1]]):
+            return coords + np.array([offset, 0], dtype=int)
+        offset += 1
