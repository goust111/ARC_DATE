+
+def _generate_obstacles(h: int, w: int, corner: str) -> np.ndarray | None:
+    for _ in range(200):
+        bottom_prob = random.uniform(0.45, 0.72)
+        bottom = np.random.random(w) < bottom_prob
+        if corner == "BL":
+            bottom[0] = False
+        if corner == "BR":
+            bottom[-1] = False
+        if int(bottom.sum()) < max(4, w // 3) or int(bottom.sum()) > w - 2:
+            continue
