+def _build_settled_scene(
+    h: int,
+    w: int,
+    obstacle_mask: np.ndarray,
+    colors: list[int],
+    areas: list[int],
+    require_stack: bool,
+) -> list[dict] | None:
+    occupied = obstacle_mask.copy()
+    placed: list[dict] = []
