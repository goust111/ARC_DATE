  grid: 10x10
  colors: black background, one foreground color (not red)
  foreground_objects: exactly 5 connected components of the foreground color
  targets:
    count: exactly 2
    shape: 3x3 hollow square (8 fg pixels surrounding 1 bg center)
    placement: center at r,c with r in [1..H-2], c in [1..W-2]; non-overlapping 3x3 windows
  distractors:
    count: exactly 3
    types: small blobs of 2-5 fg pixels; observed shapes include plus (3x3, 5 cells), 2x2 block, 1x2 bar, L-shape
    constraint: no distractor pixel falls inside any target's 3x3 bounding box
  transform:
    for each target 3x3 hollow square, replace in place with a red plus sign:
      corners -> background, center + 4 orthogonal neighbors -> red
    all other pixels unchanged

generation_strategy:
