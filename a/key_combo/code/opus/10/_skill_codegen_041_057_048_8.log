    if not _add_noise(rng, grid, protected, expected, num_pairs):
        return None
    return grid if _passes_oracle(grid, expected) else None

def generate_input() -> np.ndarray:
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
