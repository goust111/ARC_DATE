+        for r, c in tail:
+            grid[r, c] = int(record["marker_color"])
+    return grid
+
+
+def _semantic_checks(inp: np.ndarray, expected_out: np.ndarray, records: list[dict]) -> bool:
+    if np.array_equal(inp, expected_out):
+        return False
+    if len({record["distance"] for record in records}) < 2:
