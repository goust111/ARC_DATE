+def _ray_to_blocker(start: Coord, ray_dir: Coord, grid: np.ndarray, bg: int) -> list[Coord]:
+    h, w = grid.shape
+    dr, dc = ray_dir
+    r, c = start
+    cells: list[Coord] = []
+    r += dr
+    c += dc
