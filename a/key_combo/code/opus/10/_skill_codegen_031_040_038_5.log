035: def main(grid: np.ndarray) -> np.ndarray:
036:     """
037:     Add a green outside outline around the foreground shapes and fill their enclosed holes yellow.
038: 
039:     Input structure:
040:     - The grid has one dominant background color and exactly one foreground color.
041:     - The foreground pixels form blocky objects that may enclose background holes.
042:     - Green and yellow are absent from the input and are reserved for the added marks.
043: 
044:     Rule:
045:     - Keep all foreground pixels unchanged.
046:     - Recolor every background pixel in an enclosed hole to yellow.
047:     - Recolor every exterior background pixel that 8-touches the foreground to green.
048: 
049:     Key insight:
050:     - The two new colors separate background by region: unreachable-from-border background is hole fill, while border-reachable background adjacent to the foreground is the outside outline.
051:     """
052:     g = np.asarray(grid, dtype=int)
053:     assert g.ndim == 2, "expected a 2D grid"
054: 
055:     bg = get_bg(g)
056:     foreground_colors = colors_present(g, exclude={bg})
057:     assert len(foreground_colors) == 1, "expected exactly one foreground color"
058:     assert Color.GREEN not in foreground_colors and Color.YELLOW not in foreground_colors
059:     assert bg not in (Color.GREEN, Color.YELLOW), "green/yellow are output-only colors"
060: 
061:     foreground = g != bg
062:     assert np.any(foreground), "expected foreground pixels"
063: 
064:     exterior = _exterior_background(g, bg)
065:     holes = (g == bg) & ~exterior
066: 
067:     outline = np.zeros(g.shape, dtype=bool)
068:     for r, c in np.argwhere(exterior):
069:         if any(in_bounds(g.shape, nr, nc) and foreground[nr, nc] for nr, nc in neighbors8(int(r), int(c))):
070:             outline[int(r), int(c)] = True
071: 
072:     assert not np.any(outline & holes), "hole fill and outside outline must be disjoint"
073:     assert np.any(outline), "expected at least one outside outline cell"
074: 
075:     out = g.copy()
076:     out[outline] = Color.GREEN
077:     out[holes] = Color.YELLOW
078:     return out
