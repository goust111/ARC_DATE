054:     )
055:     frames: list[tuple[int, int, int]] = []
056: 
057:     for r0, r1 in row_runs:
058:         for c0, c1 in col_runs:
059:             block = g[r0 : r1 + 1, c0 : c1 + 1]
060:             colors = set(map(int, block[block != bg]))
061:             assert len(colors) == 1
062:             color = colors.pop()
063:             assert np.all(block[0, :] == color)
064:             assert np.all(block[-1, :] == color)
065:             assert np.all(block[:, 0] == color)
066:             assert np.all(block[:, -1] == color)
067: 
068:             masks_by_color[color] |= block == color
069:             frames.append((r0, c0, color))
