016: def main(input_grid):
017:     """
018:     Grow each green rectangle outward from its red border indicator to the canvas edge.
019: 
020:     Input structure:
021:     - Each foreground object is a green rectangle with one red pixel on its border.
022:     - Objects sit on a black background.
023:     - The red pixel indicates the side from which growth should extend.
024: 
025:     Rule:
026:     - Find each rectangle-and-indicator component.
027:     - Extend a green band from the rectangle toward the canvas edge on the indicator side.
028:     - Draw a red line from the indicator pixel to that same edge.
029: 
030:     Key insight:
031:     - The indicator side controls direction, while the rectangle thickness controls the grown band.
032:     """
033:     # Initialize the output grid
034:     output_grid = np.copy(input_grid)
035:     
036:     rectangle_color = Color.GREEN
037:     indicator_color = Color.RED
038:     background = Color.BLACK
039: 
040:     # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
041:     objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
042:     for obj in objects:
043:         # find the red indicator
044:         for red_r, red_c in np.argwhere(obj == indicator_color):
045:             break
046: 
047:         # Get the dimensions of the object, and its position
048:         _b = bbox(obj != background)
049:         assert _b is not None
050:         r, c, _r1, _c1 = _b
051:         width = _r1 - r + 1
052:         height = _c1 - c + 1
053: 
054:         # depending on which side of the rectangle that the indicator is on, we draw in different directions
055:         # left edge: draw to the left
056:         if red_r == r:
057:             # Extend the green rectangle to the left until it reaches the border
058:             output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
059:             # Draw the red line from the red pixel to the border
060:             draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
061:         elif red_r == r + width - 1:
062:             # Extend the green rectangle to the right until it reaches the border
063:             output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
064:             # Draw the red line from the red pixel to the border
065:             draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
066:         elif red_c == c:
067:             # Extend the green rectangle to the top until it reaches the border
068:             output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
069:             # Draw the red line from the red pixel to the border
070:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
071:         elif red_c == c + height - 1:
072:             # Extend the green rectangle to the bottom until it reaches the border
073:             output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
074:             # Draw the red line from the red pixel to the border
075:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
076:         else:
077:             assert False, "The red pixel is not on the border of the rectangle"
078: 
079:     return output_grid
