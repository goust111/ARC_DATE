+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    return _transform(g, cleanup=True)
+
+
+def _red_segments(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    segments: list[tuple[int, int, int]] = []
+    h, w = g.shape
+    for r in range(h):
