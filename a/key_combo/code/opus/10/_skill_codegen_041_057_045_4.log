+            if any(max(abs(r - br), abs(c - bc)) <= 1 for br, bc in blue_coords):
+                continue
+            if any(max(abs(r - rr), abs(c - rc)) <= 1 for rr, rc in red_coords):
+                continue
+            candidates.append((r, c))
