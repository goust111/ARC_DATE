+def _pick_layout() -> tuple[int, int, str | None, str | None]:
+    h = random.randint(*GEN_HEIGHT_RANGE)
+    w = random.randint(*GEN_WIDTH_RANGE)
+    options = [
+        ("up", None),
+        ("down", None),
+        (None, "left"),
+        (None, "right"),
+        ("up", "left"),
+        ("up", "right"),
+        ("down", "left"),
+        ("down", "right"),
+    ]
+    return h, w, *random.choice(options)
+
