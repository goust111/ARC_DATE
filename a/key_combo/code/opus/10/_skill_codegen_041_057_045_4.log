+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+
+GEN_HEIGHT_RANGE = (15, 18)
+GEN_WIDTH_RANGE = (15, 18)
+GEN_EXTRA_MARKERS = (1, 2)
+GEN_RETRY_LIMIT = 500
