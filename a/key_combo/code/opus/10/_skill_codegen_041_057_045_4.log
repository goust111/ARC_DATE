+    out = g.copy()
+    for row, cols in row_to_cols.items():
+        if len(cols) >= 2:
+            _draw_horizontal_connection(out, g, row, cols[0], cols[-1])
+
+    for col, rows in col_to_rows.items():
+        if len(rows) >= 2:
