+    w = random.randint(*GEN_WIDTH_RANGE)
+    options = [
+        ("up", None),
+        ("down", None),
+        (None, "left"),
+        (None, "right"),
+        ("up", "left"),
+        ("up", "right"),
+        ("down", "left"),
+        ("down", "right"),
+    ]
