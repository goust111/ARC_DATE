+def _render(shape: tuple[int, int], frames: list[dict]) -> np.ndarray:
+    size_counts = Counter(frame["size_key"] for frame in frames)
+    boundary_mask = np.zeros(shape, dtype=bool)
+    out = np.full(shape, BLACK, dtype=int)
