+        "name": name,
+        "r0": int(r0),
+        "c0": int(c0),
+        "r1": int(r0 + h - 1),
+        "c1": int(c0 + w - 1),
+        "h": int(h),
+        "w": int(w),
+        "area": int(h * w),
+        "size_key": (int(w), int(h)),
+    }
