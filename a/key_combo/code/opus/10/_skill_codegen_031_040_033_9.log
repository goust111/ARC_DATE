+    unique_size = unique_sizes[0]
+    transposed_match = any(unique_size == (h, w) for (w, h) in repeated_sizes)
+    overlap_count = sum(bool(_interior_overlap_cells(a, b)) for i, a in enumerate(extracted) for b in extracted[i + 1 :])
