+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RNG = random.Random()
+MAX_GENERATION_ATTEMPTS = 500
