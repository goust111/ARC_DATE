+    order = list(range(len(specs)))
+    rng.shuffle(order)
+    order.sort(key=lambda idx: (0 if specs[idx]["mode"] == "unique" else 1, 0 if specs[idx]["mode"] == "reroute_tie" else 1))
+
+    final_spans = []
+    cursor = 0
+    for idx in order:
+        spec = specs[idx]
+        cols = _candidate_cols(spec["mode"], spec["mask"], bracket, w)
+        if not cols:
+            return False
+        rng.shuffle(cols)
