+    return {
+        "coords": coords,
+        "bbox": (r0, c0, h - 1, c1),
+        "width": width,
+        "interior_left": c0 + 1,
+        "interior_right": c1 - 1,
+    }
+
+
+def _occupied_cols(mask: np.ndarray, c0: int) -> set[int]:
+    cols = set()
+    for rr, cc in np.argwhere(mask):
+        cols.add(int(c0 + cc))
