+    order = sorted(
+        range(len(specs)),
+        key=lambda idx: (
+            0 if specs[idx]["mode"] == "unique" else 1,
+            0 if specs[idx]["mode"] == "reroute_tie" else 1,
+            specs[idx]["mask"].shape[1],
+        ),
+    )
