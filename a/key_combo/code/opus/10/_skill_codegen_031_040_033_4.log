+                cols.append(c0)
+        elif mode == "no_right":
+            if c0 > b1:
+                cols.append(c0)
+        elif mode == "reroute_left":
+            if meta["overlaps"] and meta["chosen_side"] == "left" and not meta["tie"]:
+                cols.append(c0)
+        elif mode == "reroute_right":
+            if meta["overlaps"] and meta["chosen_side"] == "right":
+                cols.append(c0)
+        elif mode == "reroute_tie":
