+def _assign_modes(rng: random.Random, repeated_count: int, profile: str) -> list[str]:
+    if profile == "mixed":
+        base = ["reroute_left", "no_right"]
+        pool = ["reroute_left", "reroute_right", "no_left", "no_right"]
+    elif profile == "tie_case":
+        base = ["reroute_tie", "reroute_right"]
+        pool = ["reroute_left", "reroute_right", "no_left", "no_right"]
+    else:
+        base = ["reroute_left", "reroute_right"]
+        pool = ["reroute_left", "reroute_right", "reroute_tie", "no_left"]
+    modes = []
+    for i in range(repeated_count):
+        if i < len(base):
