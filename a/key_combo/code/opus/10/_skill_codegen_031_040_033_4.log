+
+def _drop_until_blocked(coords: np.ndarray, occupied: np.ndarray) -> np.ndarray:
+    moved = np.asarray(coords, dtype=int).copy()
+    h, w = occupied.shape
+    while True:
+        nxt = _translate(moved, dr=1)
