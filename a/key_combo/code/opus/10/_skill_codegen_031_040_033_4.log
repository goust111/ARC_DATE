+def _route_metadata(mask: np.ndarray, c0: int, bracket: dict, width: int) -> dict:
+    bbox_w = int(mask.shape[1])
+    left_target = int(bracket["bbox"][1]) - bbox_w
+    right_target = int(bracket["bbox"][3]) + 1
