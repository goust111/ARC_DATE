+
+def _build_bracket(grid: np.ndarray, c0: int, width: int) -> dict:
+    h = grid.shape[0]
+    r0 = h - 2
+    c1 = c0 + width - 1
+    grid[r0, c0] = BRACKET
+    grid[r0, c1] = BRACKET
+    grid[h - 1, c0:c1 + 1] = BRACKET
