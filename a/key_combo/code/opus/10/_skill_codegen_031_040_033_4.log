+    mh, mw = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + mh > h or c0 + mw > w:
+        return False
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h, r0 + mh + 1)
+    cc1 = min(w, c0 + mw + 1)
+    if occupied[rr0:rr1, cc0:cc1].any():
+        return False
+    return True
