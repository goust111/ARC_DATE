+
+    cursor = 0
+    for idx in order:
+        spec = specs[idx]
+        cols = _candidate_cols(spec["mode"], spec["mask"], bracket, w)
+        if not cols:
+            return False
+        r0 = cursor + rng.randint(0, 1)
+        if r0 + spec["mask"].shape[0] - 1 > h - 3:
+            return False
+        spec["r0"] = int(r0)
+        spec["c0"] = int(rng.choice(cols))
+        cursor = spec["r0"] + spec["mask"].shape[0] + rng.randint(1, 2)
+
+    return True
+
+
