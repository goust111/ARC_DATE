+    for _ in range(120):
+        target = rng.randint(min_cells, max_cells)
+        cells = {(0, 0)}
+        frontier = {(0, 1), (1, 0), (-1, 0), (0, -1)}
+        while len(cells) < target and frontier:
+            cell = rng.choice(tuple(frontier))
+            frontier.remove(cell)
+            cells.add(cell)
+            for dr, dc in DIR4:
