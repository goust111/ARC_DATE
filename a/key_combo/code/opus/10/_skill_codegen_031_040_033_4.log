+        return False
+    keys = [_shape_key(comp["coords"]) for comp in comps]
+    counts = Counter(keys)
+    if sum(v == 1 for v in counts.values()) != 1:
+        return False
+    if not any(v > 1 for v in counts.values()):
+        return False
