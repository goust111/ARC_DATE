  "src": "monochromatic foreground object s whose bbox columns match the lower bracket interior",
  "dst": "bottom-aligned slot d in the upper bracket interior column span",
  "match_cond": "s.width == d.width; lower bracket gives the source lane and upper bracket gives d.columns",
  "transform": "clear s; translate it unchanged into d with s.bbox.bottom aligned to the grid bottom"
}
</annotation>
<generation_spec>
```yaml
spec:
  type: move_to_match
  grid: 8-9 rows x 8-9 cols
  background: 7 (orange)
  brackets:
    color: 4 (yellow) [observed]
    count: exactly 2 connected components of bracket_color
    shape: |
      top bracket: flush to row 0, 2 rows tall, width W (3-4).
        row 0 is solid across W cols; row 1 has only the two endpoint cols.
      bottom bracket: flush to bottom row, 2 rows tall, same width W.
        bottom row is solid; row above has only the two endpoint cols.
    interior_width: W-2 (1-2); both brackets share the same interior width
    placement: brackets on horizontally opposite halves; zero column overlap
  mover:
    color: any non-bg non-bracket color; exactly 1 connected component
    cells: 1-4
    bbox_width: equals bracket interior_width
    bbox_height: 1-3
    position: columns align with bottom bracket interior; rows between the two brackets
    density: 0.67-1.0 (may have holes)
  output:
    mover removed from original position
    mover pasted at top bracket interior columns, bottom-aligned to grid bottom
    shape and color preserved; destination cells must be bg in input

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid H x W (8-9 each), bg=7, bracket_color=4, mover_color from remaining.
    2. Pick bracket total_width BW in {3,4}; interior_width = BW-2.
    3. Place top bracket at row 0 on one horizontal half; place bottom bracket at bottom row on the opposite half. Ensure no column overlap.
    4. Create mover sprite: bbox width = interior_width, height 1-3, cells 1 to h*w, ensuring connectivity.
    5. Place mover bottom-aligned to grid bottom at top bracket interior columns (output position). Verify no overlap with brackets or grid edge.
    6. Record output grid. Then move mover to bottom bracket interior columns at a random row between brackets (must fit and not overlap). Clear output position to get input grid.
