+    for idx, comp in enumerate(comps):
+        kind = "unique" if idx in unique_indices else "repeat"
+        color = UNIQUE if kind == "unique" else REPEATED
+        objects.append(
+            {
+                "coords": comp["coords"].copy(),
+                "bbox": comp["bbox"],
+                "kind": kind,
+                "color": color,
+            }
+        )
