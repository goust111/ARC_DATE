+
+def _normalize_coords(coords: np.ndarray) -> np.ndarray:
+    out = np.asarray(coords, dtype=int).copy()
+    out[:, 0] -= int(out[:, 0].min())
+    out[:, 1] -= int(out[:, 1].min())
