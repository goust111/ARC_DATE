    assert g.ndim == 2, "expected a 2D grid"

    bg = int(get_bg(g))
    foreground = g != bg
    crop_box = bbox(foreground)
    assert crop_box is not None, "expected at least one foreground pixel"

    out = crop_bbox(g, crop_box)
