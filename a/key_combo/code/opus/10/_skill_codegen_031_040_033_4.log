+    for obj in order:
+        coords = obj["coords"]
+        routed = False
+        route_side = None
+        tie = False
+        if obj["kind"] == "repeat" and _needs_reroute(coords, bracket):
+            coords, route_side, tie = _reroute_repeat(coords, bracket, w)
+            routed = True
