+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    ext = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque()
+    for r in range(h):
+        for c in range(w):
