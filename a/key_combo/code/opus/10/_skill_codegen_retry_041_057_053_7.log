+            {
+                "id": idx,
+                "color": int(comp["color"]),
+                "bbox": comp["bbox"],
+                "mask": mask,
+                "has_hole": has_hole,
+                "direction": -1 if has_hole else 1,
+                "input_top": int(r0),
+                "input_left": int(c0),
+                "input_top_edge": int(r0),
+                "input_bottom_edge": int(r1),
+                "input_area": int(comp["area"]),
