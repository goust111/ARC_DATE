spec:
  grid: 3-11 rows x 3-11 cols; mostly square [observed]
  background: black (color 0); fills all cells except the two markers
  markers:
    green: exactly 1 pixel (color 3) — the source that moves
    yellow: exactly 1 pixel (color 4) — the fixed destination
  alignment: green and yellow lie on the same row, column, or exact 45-degree diagonal
  direction_types: horizontal, vertical, or diagonal (all three appear)
