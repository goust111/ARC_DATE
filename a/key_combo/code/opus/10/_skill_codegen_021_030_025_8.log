+    comps: list[dict] = []
+    for color in colors:
+        submask = g[row_start:, :] == int(color)
+        for coords in _components_from_mask(submask):
+            full = coords.copy()
+            full[:, 0] += int(row_start)
+            rows = full[:, 0]
+            cols = full[:, 1]
+            comps.append(
