+                    "color": int(color),
+                    "coords": full,
+                    "bbox": (
+                        int(rows.min()),
+                        int(cols.min()),
+                        int(rows.max()),
+                        int(cols.max()),
+                    ),
+                    "area": int(len(full)),
+                }
+            )
+    return comps
