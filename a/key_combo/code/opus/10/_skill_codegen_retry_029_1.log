+
+def _make_wall_grid(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(13, 20)
+    w = rng.randint(13, 20)
+    template = rng.choices(
+        [_wall_cross, _wall_tee, _wall_elbow, _wall_snake],
+        weights=[3, 3, 2, 2],
+        k=1,
+    )[0]
+    wall_mask = template(h, w, rng)
