+    if rng.random() < 0.35:
+        extra = np.zeros_like(wall_mask)
+        if rng.random() < 0.5:
+            c = rng.choice([rng.randint(1, max(1, w // 3)), rng.randint(max(1, 2 * w // 3), w - 2)])
+            r0 = 0 if rng.random() < 0.5 else h - rng.randint(3, max(3, h // 2))
+            r1 = rng.randint(max(r0 + 2, 2), h - 1) if r0 == 0 else h - 1
