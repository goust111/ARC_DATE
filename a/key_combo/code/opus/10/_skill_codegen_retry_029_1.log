+def _all_ring_cells(shape: tuple[int, int], center: tuple[int, int], d: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    radius = d
+    while True:
+        ring = _ring_cells(shape, center, radius)
+        if not ring:
