+    seen = np.zeros((h, w), dtype=bool)
+    reach = np.zeros((h, w), dtype=bool)
+    q = deque([center])
+    seen[center] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(grid.shape, nr, nc) or seen[nr, nc]:
+                continue
+            seen[nr, nc] = True
+            if grid[nr, nc] != BLACK:
+                continue
+            reach[nr, nc] = True
+            q.append((nr, nc))
+    return reach
