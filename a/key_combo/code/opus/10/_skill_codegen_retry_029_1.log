+        c = rng.randint(4, w - 4)
+        r = rng.randint(3, h - 5)
+        _paint_polyline(mask, [(0, c), (r, c), (r, 0)])
+    elif variant == "br":
+        c = rng.randint(3, w - 5)
+        r = rng.randint(4, h - 4)
+        _paint_polyline(mask, [(h - 1, c), (r, c), (r, w - 1)])
+    else:
+        c = rng.randint(4, w - 4)
+        r = rng.randint(4, h - 4)
+        _paint_polyline(mask, [(h - 1, c), (r, c), (r, 0)])
+    return mask
+
+
+def _wall_snake(h: int, w: int, rng: random.Random) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
