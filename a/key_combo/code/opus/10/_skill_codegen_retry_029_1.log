+
+
+def _oracle_output(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    center, d, _sign, _seeds = _find_seed_info(g)
+    reach = _reachable_black(g, center)
+    out = g.copy()
+    radius = d
+    while True:
+        ring = _ring_cells(g.shape, center, radius)
+        if not ring:
