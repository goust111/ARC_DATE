+        c0 = rng.randint(2, w - 3)
+        c1 = rng.randint(2, w - 3)
+        c2 = rng.randint(2, w - 3)
+        r1 = rng.randint(3, h // 2)
+        r2 = rng.randint(r1 + 2, h - 4)
