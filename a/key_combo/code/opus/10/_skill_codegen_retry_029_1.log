+def _ring_cells(shape: tuple[int, int], center: tuple[int, int], radius: int) -> list[tuple[int, int]]:
+    cr, cc = center
+    cells: list[tuple[int, int]] = []
+    seen = set()
+    for c in range(cc - radius, cc + radius + 1):
+        for r in (cr - radius, cr + radius):
