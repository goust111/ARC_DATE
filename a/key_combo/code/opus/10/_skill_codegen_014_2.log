+
+
+def _pick_yellow_cell(side: str, cell_rows: int, cell_cols: int) -> tuple[int, int]:
+    if side == "top":
+        return 0, random.randrange(cell_cols)
+    if side == "bottom":
+        return cell_rows - 1, random.randrange(cell_cols)
+    if side == "left":
+        return random.randrange(cell_rows), 0
