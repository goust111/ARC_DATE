+
+
+def _validate_candidate(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    line_rows: list[int],
+    line_cols: list[int],
+    green_cell: tuple[int, int],
+    yellow_cell: tuple[int, int],
