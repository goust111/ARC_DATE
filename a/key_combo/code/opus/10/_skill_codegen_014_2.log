+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+MAX_GENERATION_ATTEMPTS = 400
+LINE_COUNT_CHOICES = (3, 4)
