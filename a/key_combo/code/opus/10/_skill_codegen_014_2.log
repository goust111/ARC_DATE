    out = completed.copy()
    regions = _enclosed_regions(completed)
    for region in regions:
        fill = YELLOW if _region_boundary_touches(completed, region, RED) else GREEN
        out[region[:, 0], region[:, 1]] = fill
    return out, completed, regions


