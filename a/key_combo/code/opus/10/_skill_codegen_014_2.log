+    for segment in segments:
+        cells = _segment_cells(line_rows, line_cols, segment)
+        gap_cells = _choose_gap_slice(cells)
+        if any(cell in used for cell in gap_cells):
+            continue
+        used.update(gap_cells)
+        for r, c in gap_cells:
+            grid[r, c] = BLACK
