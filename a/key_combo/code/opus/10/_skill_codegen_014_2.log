+    if side == "top":
+        r = line_rows[i]
+        return [(r, c) for c in range(line_cols[j] + 1, line_cols[j + 1])]
+    if side == "bottom":
+        r = line_rows[i + 1]
+        return [(r, c) for c in range(line_cols[j] + 1, line_cols[j + 1])]
+    if side == "left":
+        c = line_cols[j]
+        return [(r, c) for r in range(line_rows[i] + 1, line_rows[i + 1])]
