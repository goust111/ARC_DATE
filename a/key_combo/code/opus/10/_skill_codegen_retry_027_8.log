+        cleaned = tile.copy()
+        cleaned[cleaned == MARKER] = BACKGROUND
+        rotated.append(_rotate_cw(cleaned, turns))
+
+    return np.block([[rotated[0], rotated[1]], [rotated[2], rotated[3]]]).astype(int)
