    used_count = random.randint(2, min(len(sources), room_count))
    used_sources = random.sample(sources, used_count)
    seeds = used_sources[:]
    while len(seeds) < room_count:
        seeds.append(random.choice(used_sources))
    random.shuffle(seeds)
    return seeds


