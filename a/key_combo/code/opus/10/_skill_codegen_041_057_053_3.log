            assert src not in mapping, "source colors must be unique"
            mapping[src] = dst
    assert len(mapping) >= 2, "expected at least two mapping pairs"
    return mapping


def _transform_bottom(bottom: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
    h, w = bottom.shape
