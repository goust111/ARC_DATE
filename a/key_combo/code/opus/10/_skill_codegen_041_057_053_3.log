    rooms: list[dict[str, object]] = []
    for box, seed_color in zip(room_boxes, seed_colors):
        r0, c0, r1, c1 = box
        main[r0 : r1 + 1, c0] = GREY
        main[r0 : r1 + 1, c1] = GREY
        main[r0, c0 : c1 + 1] = GREY
        main[r1, c0 : c1 + 1] = GREY

