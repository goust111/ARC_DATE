+def _occupied_band_width(anchors: Sequence[Tuple[int, int]], band: Tuple[int, int], axis: int) -> int:
+    vals = sorted({coord[axis] for coord in anchors if band[0] <= coord[axis] <= band[1]})
+    if not vals:
+        return 0
+    return vals[-1] - vals[0] + 1
