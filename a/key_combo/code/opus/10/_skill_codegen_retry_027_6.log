+    for i in range(count_matrix.shape[0]):
+        rows = list(range(row_spans[i][0], row_spans[i][1] + 1))
+        for j in range(count_matrix.shape[1]):
+            need = int(count_matrix[i, j])
+            if need == 0:
+                continue
+            cols = list(range(col_spans[j][0], col_spans[j][1] + 1))
