   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Count same-color patterns per frame and represent the tally as dots inside.
   9: 
  10:     Input structure:
  11:     - bg = most common color.
  12:     - Hollow rectangular frames in various colors.
  13:     - Small monochrome pattern sprites scattered outside frames.
  14: 
  15:     Rule:
  16:     - Remove all small patterns from the grid.
  17:     - For each frame of color C, count how many patterns share color C.
  18:     - Draw that many dots along the frame's center row, spaced by 2, starting from the right.
  19: 
  20:     Key insight: Frames act as tally displays — scattered same-color patterns are "absorbed" and their count is shown as interior dots.
  21:     """
  22:     g = np.array(grid, dtype=int)
  23:     out = g.copy()
  24:     bg = int(get_bg(g))
  25: 
  26:     regions = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
  27: 
  28:     frames: list[dict] = []
  29:     patterns: list[dict] = []
  30:     for comp in regions:
  31:         b = comp["bbox"]
  32:         h = bbox_h(b)
  33:         w = bbox_w(b)
  34:         area = int(comp["area"])
  35:         is_frame = (h >= 5) and (w >= 5) and (area < (h * w * 0.7))
  36:         if is_frame:
  37:             frames.append(comp)
  38:         else:
  39:             patterns.append(comp)
  40: 
  41:     # Remove patterns from output.
  42:     for p in patterns:
  43:         for r, c in p["coords"]:
  44:             out[int(r), int(c)] = bg
  45: 
  46:     # For each frame, count matching patterns and draw dots.
  47:     for f in frames:
  48:         col = int(f["color"])
  49:         num_patterns = sum(1 for p in patterns if int(p["color"]) == col)
  50:         if num_patterns <= 0:
  51:             continue
  52: 
  53:         r0, c0, r1, c1 = map(int, f["bbox"])
  54:         r_mid = (r0 + r1) // 2
  55:         for i in range(int(num_patterns)):
  56:             cc = int(c1 - 2 - 2 * i)
  57:             if cc > int(c0):
  58:                 out[int(r_mid), int(cc)] = col
  59: 
  60:     return out
