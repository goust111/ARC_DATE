+    if parsed_cols != list(map(int, col_counts)):
+        return None
+
+    if not np.any(actual != BLACK):
+        return None
+    if max(actual.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
