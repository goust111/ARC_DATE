        rotate = bool(spec["rotate"])
        sh = int(cavity["w"]) if rotate else int(cavity["h"])
        sw = int(cavity["h"]) if rotate else int(cavity["w"])
        patch = _sprite_patch(sh, sw, int(spec["area"]), color)
