GRID_MIN, GRID_MAX = 15, 25           # grid dimension range
THICK_MIN, THICK_MAX = 7, 10          # template strip thickness
OUTER_GAP = 8                         # min outer-region width for sprite placement
SPRITE_COUNT_MIN, SPRITE_COUNT_MAX = 7, 15
