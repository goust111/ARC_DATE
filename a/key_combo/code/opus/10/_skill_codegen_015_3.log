+        c1 = c0 + cavity["w"] - 1
+        frame[r0 : r1 + 1, c0 : c1 + 1] = BG
+        item = dict(cavity)
+        item.update({"r0": r0, "c0": c0, "r1": r1, "c1": c1})
+        placed.append(item)
