+        col = idx % 2
+        slot_r0 = 1 + sum(row_heights[:row]) + row
+        slot_c0 = 1 + sum(col_widths[:col]) + col
+        slack_r = row_heights[row] - cavity["h"]
+        slack_c = col_widths[col] - cavity["w"]
+        r0 = slot_r0 + random.randint(0, slack_r)
+        c0 = slot_c0 + random.randint(0, slack_c)
