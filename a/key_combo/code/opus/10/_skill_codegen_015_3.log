+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 6
+ORANGE = 7
+TEAL = 8
+SPRITE_COLORS = (1, 2, 3, 4, 5, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 400
+MARKER_BOX = 4
