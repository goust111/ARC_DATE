+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+VISIBLE_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+
+GEN_ATTEMPTS = 400
+HOLE_SHAPES = (
+    np.array([[1, 1], [1, 0]], dtype=bool),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=bool),
+    np.array([[1, 1, 1], [1, 1, 0]], dtype=bool),
+    np.array([[1, 1, 1], [1, 0, 1]], dtype=bool),
+    np.array([[1, 1, 1], [1, 1, 0], [1, 0, 0]], dtype=bool),
+)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _component_coords(mask: np.ndarray):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray):
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box):
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _red_object_and_pieces(grid: np.ndarray):
+    comps = _component_coords(grid != BLACK)
+    assert comps, "expected at least one foreground component"
+    red_candidates = []
+    pieces = []
+    for coords in comps:
+        colors = {int(grid[r, c]) for r, c in coords}
+        rec = {"coords": coords, "bbox": _bbox(coords)}
+        if colors == {RED}:
+            red_candidates.append(rec)
+        else:
+            pieces.append(rec)
