+    return out
+
+
+def _choose_dimensions():
+    if random.random() < 0.5:
+        h = random.randint(11, 15)
+        w = random.randint(8, min(13, h))
+        if w > h:
+            w = h
+    else:
+        w = random.randint(11, 15)
+        h = random.randint(8, min(13, w - 1))
+        if h >= w:
