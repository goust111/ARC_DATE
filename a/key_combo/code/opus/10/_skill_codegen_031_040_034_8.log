+        r0, c0, _r1, _c1 = hole["bbox"]
+        for rr in range(matched.shape[0]):
+            for cc in range(matched.shape[1]):
+                color = int(matched[rr, cc])
+                if color not in (BLACK, RED):
+                    out[r0 + rr, c0 + cc] = color
