        if right < w - 1 and random.random() < 0.35:
            out[r, right] = False
        if not out[r].any():
            out[r, left:right + 1] = True
    return out


def _canonical_mask(box_h: int, box_w: int) -> np.ndarray:
    half_h = box_h // 2
    side = random.choice(["left", "right"])
    top_w = random.randint(1, box_w - 1)
    bot_w = random.randint(1, box_w - 1)
    top = _jitter_half(_wedge_half(half_h, box_w, top_w, side, toward_split=True))
    bottom = _jitter_half(_wedge_half(half_h, box_w, bot_w, random.choice(["left", "right"]), toward_split=False))

    if not np.any(top[-1] & bottom[0]):
        overlap_col = 0 if side == "left" else box_w - 1
        top[-1, overlap_col] = True

