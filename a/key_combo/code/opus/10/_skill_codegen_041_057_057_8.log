+
+def _crop_to_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _rotate_cw(patch: np.ndarray, turns: int) -> np.ndarray:
+    t = int(turns) % 4
+    if t == 0:
+        return patch.copy()
+    return np.rot90(patch, k=(4 - t) % 4)
