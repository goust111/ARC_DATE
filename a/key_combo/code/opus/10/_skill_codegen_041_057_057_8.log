            for dr in (-1, 1)
            for dc in (-1, 1)
        }
        l_marker_coords = square_corners - {sprite_corner_coord}
        if not l_marker_coords.issubset(marker_set):
            continue

        remaining_markers = marker_set - l_marker_coords
        if len(remaining_markers) != 1:
