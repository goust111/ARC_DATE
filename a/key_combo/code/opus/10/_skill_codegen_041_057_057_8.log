+    side, marker_color = CASE_ORDER[_CASE_INDEX % len(CASE_ORDER)]
+    _CASE_INDEX += 1
+
+    for _ in range(400):
+        grid = _attempt_case(side, marker_color)
+        if grid is not None:
+            return grid
