+        box_b = (r0, c0 + hw, r1, c1) if side == "left" else (r0, c0, r1, c0 + hw - 1)
+        patch_a = patch[:, :hw] if side == "left" else patch[:, hw:]
+        patch_b = patch[:, hw:] if side == "left" else patch[:, :hw]
