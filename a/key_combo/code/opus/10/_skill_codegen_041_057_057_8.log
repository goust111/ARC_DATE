+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+OBJ_COLORS = (1, 2)
+MARKER_TO_TURNS = {
+    3: (1, 0),  # A cw90, B identity
+    4: (2, 1),  # A cw180, B cw90
