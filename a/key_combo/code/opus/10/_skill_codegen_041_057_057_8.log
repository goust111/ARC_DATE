+
+
+def _jitter_half(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    h, w = out.shape
+    for r in range(1, h - 1):
+        row = np.flatnonzero(out[r])
+        if row.size == 0:
+            continue
+        left = int(row.min())
+        right = int(row.max())
+        if left > 0 and random.random() < 0.35:
+            out[r, left] = False
+        if right < w - 1 and random.random() < 0.35:
+            out[r, right] = False
+        if not out[r].any():
