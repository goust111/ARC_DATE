+def _place_canonical_case(rows: int, cols: int, box_h: int, box_w: int, marker_color: int) -> np.ndarray:
+    mask = _canonical_mask(box_h, box_w)
+    patch = _asymmetric_coloring(mask)
+    top_margin = 4
+    side_margin = 4
