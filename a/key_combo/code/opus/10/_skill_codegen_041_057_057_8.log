+    alpha_den = count - 1
+    left = round((start[0] * (alpha_den - alpha_num) + end[0] * alpha_num) / alpha_den)
+    right = round((start[1] * (alpha_den - alpha_num) + end[1] * alpha_num) / alpha_den)
