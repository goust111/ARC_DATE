+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+OBJ_COLORS = (1, 2)
+MARKER_TO_TURNS = {
+    3: (1, 0),  # A cw90, B identity
+    4: (2, 1),  # A cw180, B cw90
+}
+DIR_TO_SIDE = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+CASE_ORDER = [
+    ("up", 3),
+    ("down", 3),
+    ("left", 3),
+    ("right", 3),
+    ("up", 4),
+    ("down", 4),
+    ("left", 4),
+    ("right", 4),
+]
+_CASE_INDEX = 0
