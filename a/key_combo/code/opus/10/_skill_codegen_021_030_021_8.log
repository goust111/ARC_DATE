_GEN_BACKGROUND_COLOR = Color.BLACK
_GEN_OBJECT_HEIGHT_RANGE = (3, 9)
_GEN_OBJECT_WIDTH_RANGE = (3, 7)
_GEN_HOLE_SHAPES = ((1, 1), (1, 2), (2, 1), (2, 2))
