+
+
+def _in_bounds(pos: Cell) -> bool:
+    r, c = pos
+    return 0 <= r < CELL_COUNT and 0 <= c < CELL_COUNT
+
+
+def _valid_targets(pos: Cell, offsets: list[Offset]) -> list[Cell]:
