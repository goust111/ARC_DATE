+                continue
+            r0, c0 = _block_origin(br, bc)
+            cells = [
+                (r0 + dr, c0 + dc)
+                for dr in range(BLOCK_SIZE)
+                for dc in range(BLOCK_SIZE)
+                if (r0 + dr, c0 + dc) not in reserved
+            ]
+            red_count = int(rng.integers(1, 4))
