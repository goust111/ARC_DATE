+
+def _anchor_cells(center: tuple[int, int]) -> list[tuple[int, int]]:
+    cr, cc = center
+    return [(r, c) for r in range(cr - 1, cr + 2) for c in range(cc - 1, cc + 2)]
+
+
+def _find_anchor(grid: np.ndarray) -> tuple[int, int]:
+    h, w = grid.shape
+    anchors: list[tuple[int, int]] = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
