    lines_only, _ = _render_lines(grid)
    regions = sorted(_background_components(lines_only), key=_region_key)
    if len(regions) < MIN_REGION_COUNT:
        return False
    if any(len(coords) < MIN_REGION_AREA for coords in regions):
