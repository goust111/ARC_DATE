+
+BACKGROUND = 0
+UP_COLOR = 1
+DOWN_COLOR = 3
+SEGMENT_COLOR = 5
+REFERENCE_PALETTE = (2, 4, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
