+            continue
+        if len(set(map(int, row))) < 3:
+            continue
+        return row
+    raise RuntimeError("failed to build a varied reference row")
+
+
+def _choose_lengths(width: int, n_segments: int) -> list[int] | None:
+    max_length = min(6, width - 1)
