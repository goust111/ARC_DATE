0035:         has_right_mate = c + 2 < width and g[r, c + 2] == Color.BLUE
0036:         assert has_left_mate or has_right_mate, "every blue pixel must be part of a dashed horizontal bar"
0037: 
0038:     fill_mask = np.zeros((height, width), dtype=bool)
