+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+
+
+PALETTE = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK)
+GEN_ATTEMPTS = 600
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            part: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                part.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(part)
+    return parts
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _box_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> tuple[int, int]:
+    row_gap = max(0, b[0] - a[2] - 1, a[0] - b[2] - 1)
+    col_gap = max(0, b[1] - a[3] - 1, a[1] - b[3] - 1)
+    return row_gap, col_gap
+
+
+def _indicator_of(rect: dict) -> tuple[int, int]:
+    r0, c0, h, w, direction = rect["r0"], rect["c0"], rect["h"], rect["w"], rect["dir"]
+    if direction == "left":
+        return r0 + 1, c0
+    if direction == "right":
+        return r0 + 1, c0 + w - 1
+    if direction == "up":
+        return r0, c0 + 1
+    return r0 + h - 1, c0 + 1
+
+
+def _line_from_object(obj: dict, shape: tuple[int, int]) -> dict:
+    h, w = shape
+    r0, c0, r1, c1 = obj["bbox"]
+    ir, ic = obj["indicator"]
+    direction = obj["dir"]
+    if direction == "left":
+        return {
+            "axis": "h",
+            "dir": direction,
+            "color": obj["color"],
+            "freq": obj["freq"],
+            "fixed": ir,
+            "start": c0 - 1,
+            "end": 0,
+            "anchor": (ir, 0),
+        }
+    if direction == "right":
+        return {
+            "axis": "h",
+            "dir": direction,
+            "color": obj["color"],
+            "freq": obj["freq"],
+            "fixed": ir,
+            "start": c1 + 1,
+            "end": w - 1,
+            "anchor": (ir, c1 + 1),
+        }
+    if direction == "up":
+        return {
+            "axis": "v",
+            "dir": direction,
+            "color": obj["color"],
+            "freq": obj["freq"],
+            "fixed": ic,
+            "start": r0 - 1,
+            "end": 0,
+            "anchor": (0, ic),
+        }
+    return {
+        "axis": "v",
+        "dir": direction,
+        "color": obj["color"],
+        "freq": obj["freq"],
+        "fixed": ic,
+        "start": r1 + 1,
+        "end": h - 1,
+        "anchor": (r1 + 1, ic),
+    }
+
+
+def _iter_line(line: dict):
+    if line["axis"] == "h":
+        step = -1 if line["dir"] == "left" else 1
+        dist = 1
+        c = line["start"]
+        while True:
+            yield line["fixed"], c, dist
+            if c == line["end"]:
+                break
+            c += step
+            dist += 1
+    else:
+        step = -1 if line["dir"] == "up" else 1
+        dist = 1
+        r = line["start"]
+        while True:
+            yield r, line["fixed"], dist
+            if r == line["end"]:
+                break
+            r += step
+            dist += 1
+
+
+def _analyze_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
