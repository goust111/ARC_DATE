+    if not _has_ordinary_gap(out):
+        return None
+    if np.array_equal(grid, out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
