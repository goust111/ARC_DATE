+
+def _has_ordinary_gap(output: np.ndarray) -> bool:
+    h, w = output.shape
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(output[r, c]) != Color.BLACK:
+                continue
+            left = int(output[r, c - 1])
+            right = int(output[r, c + 1])
+            up = int(output[r - 1, c])
