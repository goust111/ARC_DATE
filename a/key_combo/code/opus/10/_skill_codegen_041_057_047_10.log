+    if kind == "vertical_track":
+        return [(0, 0), (1, 0), (2, 0)]
+    return [[(0, 0), (1, 1), (2, 2)], [(0, 2), (1, 1), (2, 0)]]
+
+
+def _track_candidates(mask: np.ndarray, top: int, left: int, zone_h: int, zone_w: int, kind: str):
