+            out = np.zeros((zone_h, zone_w), dtype=int)
+            out[top : top + h, left : left + w] = _transform_patch(patch, kind)
+
+            return {
+                "input": inp,
+                "output": out,
+                "mask": mask,
+                "bbox": (top, left, top + h - 1, left + w - 1),
+                "track": track,
+                "kind": kind,
+                "color": int(color),
+            }
+    return None
+
+
+def _bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
