+            np.fliplr(mask).tobytes(),
+            np.rot90(mask, 2).tobytes(),
+        }
+        if len(variants) != 4:
+            continue
+        return mask
+    raise RuntimeError("failed to generate a non-degenerate sprite mask")
+
+
+def _line_steps(kind: str):
+    if kind == "horizontal_track":
