+    out = g.copy()
+    sprites, tracks, matches = _parse_scene(g)
+
+    out[out == TRACK] = BG
+    for si, ti in matches:
+        sprite = sprites[si]
+        track = tracks[ti]
+        r0, c0, r1, c1 = sprite["bbox"]
+        transformed = _transform_patch(sprite["patch"], track["kind"])
+        out[r0 : r1 + 1, c0 : c1 + 1] = transformed
