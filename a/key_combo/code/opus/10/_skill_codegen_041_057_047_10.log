+    for steps in step_sets:
+        max_r = max(dr for dr, _ in steps)
+        max_c = max(dc for _, dc in steps)
+        for r0 in range(zone_h - max_r):
+            for c0 in range(zone_w - max_c):
+                coords = [(r0 + dr, c0 + dc) for dr, dc in steps]
