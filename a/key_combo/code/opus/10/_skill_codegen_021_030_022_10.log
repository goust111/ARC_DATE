+        gap_len = 2 if len(cells) >= 3 and random.random() < 0.45 else 1
+        start = random.randint(0, len(cells) - gap_len)
+        for r, c in cells[start : start + gap_len]:
+            inp[r, c] = BLACK
+
+    if len(chosen_edges) == 1:
