+    room_ids = np.full((h, w), -1, dtype=int)
+    rid = 0
+    for rr in range(room_rows):
+        for cc in range(room_cols):
+            rs, cs = _room_cells(rr, cc, row_period, col_period)
+            room_ids[rs, cs] = rid
+            rid += 1
+    return wall_mask, room_ids
+
