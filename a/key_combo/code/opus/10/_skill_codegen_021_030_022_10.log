+            return None
+        if marker_vals.size == 1:
+            marked_components += 1
+            if _touches_edge(coords, repaired.shape):
+                return None
+            if int(np.count_nonzero(vals == BLACK)) == 0:
+                return None
+            fill_color = int(marker_vals[0])
+            black_cells = coords[vals == BLACK]
+            out[black_cells[:, 0], black_cells[:, 1]] = fill_color
