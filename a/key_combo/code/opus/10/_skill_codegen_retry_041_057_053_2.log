  segments:
    count: exactly w-1 (one per length 1..w-1)
    lengths: exactly {1, 2, ..., w-1}, all unique
    each_segment: single-row horizontal contiguous bar, one cell thick
    colors: each segment has a distinct non-0 non-8 color; all colors unique
    placement: scattered above the stripe, each on its own row, at arbitrary horizontal position
