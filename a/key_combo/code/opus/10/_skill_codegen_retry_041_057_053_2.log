+    if n_rectangles == 2 and random.random() < 0.5:
+        shared = random.choice([0, 1])
+        value = lengths[0][shared]
+        other = list(lengths[1])
+        if shared == 0 and value != other[1]:
+            other[0] = value
+        elif shared == 1 and value != other[0]:
+            other[1] = value
