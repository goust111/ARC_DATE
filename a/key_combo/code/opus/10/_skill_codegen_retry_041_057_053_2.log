+
+def _sample_pair_lengths(count: int, rect_lengths: Iterable[int]) -> list[int]:
+    pair_lengths = [random.randint(MIN_LINE_LENGTH, MAX_LINE_LENGTH) for _ in range(count)]
+    rect_lengths = list(rect_lengths)
