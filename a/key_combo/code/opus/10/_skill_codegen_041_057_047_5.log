  "match_cond": "s.bbox row/column rank in the sprite layout == d row/column rank in the legend",
  "transform": "recolor every pixel of s to d.color; keep the legend and background unchanged",
  "symbol_instructions": "compact legend mask gives the color for each corresponding sprite-layout position"
}
</annotation>
