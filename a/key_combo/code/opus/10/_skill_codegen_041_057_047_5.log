+            np.fliplr(tile),
+            np.flipud(tile),
+            np.rot90(tile, 2),
+        )
+        if len({arr.tobytes() for arr in transforms}) != 4:
+            continue
+        return tile
+    raise RuntimeError("failed to sample a non-degenerate tile")
+
