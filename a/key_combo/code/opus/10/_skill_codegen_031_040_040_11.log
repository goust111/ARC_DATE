+    h, w = mask.shape
+    seen = set()
+    stack = [tuple(map(int, coords[0]))]
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
