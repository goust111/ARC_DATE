+
+    assert len(region) >= 2
+    assert bbox_keepers
+    must_keep = {random.choice(bbox_keepers)}
+    optional = [cell for cell in region if cell not in must_keep]
+    if not optional:
+        raise RuntimeError("damage region has no removable cells")
+    remove_min = 1
+    remove_max = len(optional)
+    for _ in range(120):
+        k = random.randint(remove_min, remove_max)
+        removed = set(random.sample(optional, k))
