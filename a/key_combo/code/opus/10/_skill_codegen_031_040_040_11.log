+            dc = spec["dc"]
+            h, w = vis.shape
+            max_r = height - h
+            max_c = width - (w + dc)
+            if max_r < 0 or max_c < 0:
+                return None
+            choices = [(r, c) for r in range(max_r + 1) for c in range(max_c + 1)]
+            random.shuffle(choices)
