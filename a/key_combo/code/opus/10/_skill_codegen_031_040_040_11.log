+        else:
+            seg_cols = [c for c in range(w) if full_mask[2, c]]
+            if len(seg_cols) <= 1:
+                raise RuntimeError("not enough second-strip cells")
+            keep_col = random.choice(seg_cols)
+            removable = [c for c in seg_cols if c != keep_col]
+            cut = random.randint(1, len(removable))
+            for c in random.sample(removable, cut):
+                visible[2, c] = False
+        if not _mask_connected(visible):
