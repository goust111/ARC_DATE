    right_c = _gen_randint(*GEN_RIGHT_COLS)
    left_c = _gen_randint(GEN_LEFT_COLS[0], min(GEN_LEFT_COLS[1], right_c - GEN_MIN_SEP))
    return [(top_r, right_c), (bot_r, left_c)]


