spec:
  grid:
    input: 10-19 rows x 15-18 cols
    background: 0 (black)
  foreground_masks:
    count: 3-5 distinct non-background colors
    bbox_heights: all mutually distinct, each 1-6
    bbox_widths: 4-12 each
    fill_ratio: 0.57-1.0 (pixels / bbox area); not necessarily solid rectangles
    connectivity: each mask is 1-2 connected components [observed]
    placement: scattered across the grid; bounding boxes may overlap between colors
    total_fg_ratio: ~0.2-0.4 of grid cells are foreground [observed]
  output:
    rows: max(bbox_heights), cols: count(foreground_colors)
    columns sorted left-to-right by decreasing bbox_height
