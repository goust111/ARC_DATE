    bot_r = _gen_randint(max(GEN_BOT_ROWS[0], top_r + GEN_MIN_SEP), GEN_BOT_ROWS[1])

    if _gen_randint(*GEN_ORIENTATION_RANGE) == GEN_TL_BR_ORIENTATION:
