BASE_COLORS = {Color.BLACK, Color.BLUE}


def _best_marker_color(
    g: np.ndarray, coords: np.ndarray, markers: dict[tuple[int, int], int]
) -> int:
    contacts: dict[tuple[int, int], int] = defaultdict(int)
    for r, c in coords:
