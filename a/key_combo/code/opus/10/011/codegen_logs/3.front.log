+
+def _find_gray_rectangles(grid: np.ndarray) -> list[Rect]:
+    g = np.asarray(grid, dtype=int)
+    mask = g == GREY
+    seen = np.zeros_like(mask, dtype=bool)
+    rectangles: list[Rect] = []
+    h, w = g.shape
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
