+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+TOP_BAND_LAST_ROW = 9
+MAX_GENERATION_ATTEMPTS = 600
+AREA_DIMS: dict[int, tuple[tuple[int, int], ...]] = {
+    4: ((2, 2),),
+    6: ((2, 3), (3, 2)),
+    8: ((2, 4), (4, 2)),
+    9: ((3, 3),),
+    10: ((2, 5), (5, 2)),
+    12: ((3, 4), (4, 3)),
