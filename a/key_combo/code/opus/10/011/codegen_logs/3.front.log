+@dataclass(frozen=True)
+class Rect:
+    r0: int
+    c0: int
+    h: int
+    w: int
+    area: int
+
+    @property
+    def r1(self) -> int:
+        return self.r0 + self.h - 1
+
+    @property
+    def c1(self) -> int:
+        return self.c0 + self.w - 1
+
+    @property
+    def final_top(self) -> int:
+        return self.r0 + self.area
+
+    @property
+    def final_bottom(self) -> int:
+        return self.final_top + self.h - 1
+
