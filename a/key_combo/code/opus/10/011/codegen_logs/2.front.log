+
+    row_choices = list(range(max(4, h // 2 - 2), min(h - 5, h // 2 + 1) + 1))
+    col_choices = list(range(max(4, w // 2 - 2), min(w - 5, w // 2 + 1) + 1))
+    if not row_choices or not col_choices:
+        return None
