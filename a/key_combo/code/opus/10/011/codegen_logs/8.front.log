+            shapes.append(
+                {
+                    "inner_h": inner_h,
+                    "inner_w": inner_w,
+                    "outer_h": inner_h + 2,
+                    "outer_w": inner_w + 2,
+                    "area": inner_h * inner_w,
+                    "pixels": pixels,
+                }
+            )
+    return shapes
+
