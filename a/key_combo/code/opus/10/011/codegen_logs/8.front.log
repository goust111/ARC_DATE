+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _monochrome_components(grid: np.ndarray) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if (
+                        0 <= nr < h
+                        and 0 <= nc < w
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _enclosed_area(component: np.ndarray) -> int:
+    r0 = int(component[:, 0].min())
+    c0 = int(component[:, 1].min())
+    r1 = int(component[:, 0].max())
+    c1 = int(component[:, 1].max())
+
+    wall = np.zeros((r1 - r0 + 3, c1 - c0 + 3), dtype=bool)
+    for r, c in component:
+        wall[int(r - r0 + 1), int(c - c0 + 1)] = True
+
+    seen = np.zeros_like(wall, dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < wall.shape[0] and 0 <= nc < wall.shape[1]:
