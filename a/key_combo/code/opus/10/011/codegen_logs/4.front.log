+    target_rect = (
+        target_top,
+        target_left,
+        target_top + target_patch.shape[0] - 1,
+        target_left + target_patch.shape[1] - 1,
+    )
+    if target_rect[0] < 0 or target_rect[1] < 0 or target_rect[2] >= h or target_rect[3] >= w:
