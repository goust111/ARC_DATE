            continue
        coords = comp["coords"]
        r0, c0, _r1, _c1 = comp["bbox"]
        rel = coords - np.array([r0, c0])
        sprites.append(
            {
                "color": int(comp["color"]),
                "coords": coords,
                "rel": [tuple(map(int, rc)) for rc in rel.tolist()],
                "area": int(comp["area"]),
            }
        )

    assert sprites
    tiling = _unique_tiling(sprites, holes)

