+def _select_repeated_color(grid: np.ndarray, bg: int) -> tuple[int, np.ndarray]:
+    components = find_components(
+        grid,
+        bg=int(bg),
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
