+    marker_cols = tuple(sorted(int(c) for c in np.where(g[h - 1] == GRAY)[0]))
+    assert 2 <= len(marker_cols) <= 4, "expected 2-4 bottom markers"
+
+    template_mask = (g != BG) & (g != GRAY)
+    template_box = _bbox(template_mask)
