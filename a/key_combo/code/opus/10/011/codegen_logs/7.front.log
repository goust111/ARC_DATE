+            value = int(patch[rr, cc])
+            if value == BG:
+                continue
+            dr = r0 + rr
+            dc = c0 + cc
+            if preserve_existing and int(dst[dr, dc]) != BG:
+                continue
+            dst[dr, dc] = value
+
+
