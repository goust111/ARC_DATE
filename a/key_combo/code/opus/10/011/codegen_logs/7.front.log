+    intervals = [(offset + c * scale, offset + (c + 1) * scale - 1) for c in occupied_cols]
+    covered = [False] * len(intervals)
+    for marker in marker_cols:
+        hit = False
+        for idx, (lo, hi) in enumerate(intervals):
