+    gap = random.randint(2, 4)
+
+    min_h = max(15, rotated.shape[0] * scale + 5, tr + size + 1)
+    max_h = 24
+    if min_h > max_h:
+        return None
+    height = random.randint(min_h, max_h)
+
+    min_w = max(16, tc + size + gap + rotated.shape[1] * scale + 1)
+    max_w = 26
+    if min_w > max_w:
+        return None
