    # Multicolor components = label foreground as a whole
    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
    if colors_set is None:
        fg_mask = (grid != bg)
    else:
        fg_mask = (grid != bg) & np.isin(grid, list(colors_set))

