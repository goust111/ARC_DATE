+        return int(rng.choice(rows)), int(rng.choice(cols))
+    return None
+
+
+def _pick_free_center(
+    shape: tuple[int, int],
+    blocked: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[int, int] | None:
+    h, w = shape
+    for _ in range(160):
+        r = int(rng.integers(2, h - 2))
+        c = int(rng.integers(2, w - 2))
+        if np.any(blocked[r - 1 : r + 2, c - 1 : c + 2]):
