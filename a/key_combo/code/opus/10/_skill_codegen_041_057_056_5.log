  background: black (0)
  colors: one clutter color (any except green and black) + green in output only
  corridor:
    shape: cross formed by one vertical bar and one horizontal bar, intersecting
    vertical_bar:
      true_width: 4-10 cols (including 1-pixel clutter-free margin on each side)
      interior_width: 2-8 cols (green in output, = true_width - 2 unless touching grid edge)
      height: spans 80-100% of grid rows; at least one end touches grid edge [observed]
    horizontal_bar:
      true_height: 3-12 rows (including 1-pixel margin on top/bottom)
      interior_height: 1-10 rows (green in output)
      width: extends from V-bar to at least one grid edge (left or right or both)
      segments: 1-2 contiguous H-bar segments per example [observed]
    intersection: bars share overlapping column/row ranges
    margin: exactly 1 pixel of clutter-free bg surrounds the corridor on all non-edge sides
    constraint: each bar's post-erosion major axis >= 15 (= grid_side // 2)
  clutter:
    placement: scattered randomly OUTSIDE the corridor + margin region
    density: 40-52% of non-corridor-margin pixels are clutter [observed]
    pattern: independent per-pixel random; no clutter anywhere inside corridor or its 1px margin
  output_rule: |
    Recolor corridor bg pixels to green. Corridor = bg pixels whose 3x3 neighborhood
