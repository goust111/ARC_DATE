+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid corridor-parity ARC input")

