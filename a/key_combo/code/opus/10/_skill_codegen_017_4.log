+            halo_c0 = max(0, c - 1)
+            halo_r1 = min(h, r + 4)
+            halo_c1 = min(w, c + 4)
+            halo = mask[halo_r0:halo_r1, halo_c0:halo_c1].copy()
+            halo[r - halo_r0 : r - halo_r0 + 3, c - halo_c0 : c - halo_c0 + 3] = False
