+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_H_RANGE)
+    width = random.randint(*GRID_W_RANGE)
+    n_anchors = random.choice(ANCHOR_COUNT_OPTIONS)
