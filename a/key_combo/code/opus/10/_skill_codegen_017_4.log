+        selected: list[dict[str, object]] = []
+        used_lines: set[str] = set()
+
+        for step_index in range(count):
+            candidates: list[dict[str, object]] = []
+            for line in lines:
+                line_id = str(line["id"])
+                cells = list(line["cells"])
+                if step_index < min(2, count - 1):
+                    random.shuffle(cells)
+                for cell in cells:
