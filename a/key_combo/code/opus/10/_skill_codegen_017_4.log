+def _anchor_cells(anchor: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = anchor
+    return [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)]
