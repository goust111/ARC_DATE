+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _mask_from_coords(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _has_flanked_gap(line: np.ndarray) -> bool:
+    for idx in range(1, len(line) - 1):
+        if not line[idx] and line[:idx].any() and line[idx + 1 :].any():
+            return True
+    return False
+
+
+def _notch_directions(mask: np.ndarray) -> list[str]:
+    directions: list[str] = []
+    if _has_flanked_gap(mask[0, :]):
+        directions.append("up")
+    if _has_flanked_gap(mask[-1, :]):
+        directions.append("down")
+    if _has_flanked_gap(mask[:, 0]):
+        directions.append("left")
+    if _has_flanked_gap(mask[:, -1]):
+        directions.append("right")
+    return directions
+
+
+def _axis_size(mask: np.ndarray, direction: str) -> int:
+    return mask.shape[1] if direction in {"left", "right"} else mask.shape[0]
+
+
+def _final_origin(
+    shape: tuple[int, int],
+    direction: str,
+    start_r0: int,
+    start_c0: int,
+    grid_shape: tuple[int, int],
+) -> tuple[int, int]:
+    h, w = shape
+    H, W = grid_shape
+    if direction == "left":
+        assert 2 * w <= W
+        return start_r0, w
+    if direction == "right":
+        assert 2 * w <= W
+        return start_r0, W - 2 * w
+    if direction == "up":
+        assert 2 * h <= H
+        return h, start_c0
+    assert direction == "down"
+    assert 2 * h <= H
+    return H - 2 * h, start_c0
