+import numpy as np
+
+
+BG = 4
+BLUE = 1
+RED = 2
+GREEN = 3
+
+DIRS = ("up", "down", "left", "right")
+GEN_RETRIES = 500
+GRID_SIZE_RANGE = (13, 16)
+OBJECT_COUNT_CHOICES = (2, 3, 3)
