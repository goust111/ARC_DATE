+
+
+def _dilate_chebyshev1(coords: set[tuple[int, int]], grid_shape: tuple[int, int]) -> set[tuple[int, int]]:
+    H, W = grid_shape
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < H and 0 <= cc < W:
