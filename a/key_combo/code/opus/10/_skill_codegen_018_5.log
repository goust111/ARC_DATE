+def _grid_signature(grid: np.ndarray) -> str:
+    payload = f"{grid.shape[0]}x{grid.shape[1]}|".encode() + grid.astype(np.uint8, copy=False).tobytes()
+    return hashlib.sha1(payload).hexdigest()
