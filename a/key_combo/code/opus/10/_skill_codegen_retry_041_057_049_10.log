+def _generate_blocking_left_group(colors: list[int]) -> dict | None:
+    layers = 3
+    gaps = [1, 1]
+    inner_h = random.randint(5, 6)
+    inner_w = random.randint(5, 6)
+    boxes = _build_group_frames(layers, inner_h, inner_w, gaps)
+    direction = DIRECTIONS[(layers - 1) % 4]  # left
+
+    for _ in range(180):
+        shapes = [_random_shape(), _random_shape()]
+        _a0, _b0, ar1, ac1 = _bbox(shapes[0])
+        sh1 = ar1 + 1
+        sw1 = ac1 + 1
+        first_rows = list(range(0, inner_h - sh1 + 1))
+        random.shuffle(first_rows)
+        first = None
+        for row in first_rows:
+            first = _translate(shapes[0], row, 0)
+            break
+        if first is None:
+            continue
+
+        occupied = set(first)
+        second_candidates: list[tuple[tuple[tuple[int, int], ...], int]] = []
+        _c0, _d0, br1, bc1 = _bbox(shapes[1])
+        sh2 = br1 + 1
+        sw2 = bc1 + 1
+        for row in range(0, inner_h - sh2 + 1):
+            for col in range(1, inner_w - sw2 + 1):
+                coords = _translate(shapes[1], row, col)
+                if any(cell in occupied for cell in coords):
+                    continue
+                shifted_left = {(r, c - 1) for r, c in coords}
+                if not shifted_left & occupied:
