+    inp, out, placements = _layout_groups(groups)
+    _validate_generated(inp, out, groups, placements)
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            inp, _out = _generate_case()
+        except Exception:
+            continue
+        return inp
