+        opts1 = _backshift_options(first, direction, inner_h, inner_w)
+        opts2 = _backshift_options(second, direction, inner_h, inner_w)
+        random.shuffle(opts1)
+        random.shuffle(opts2)
+        for _d1, coords1, dist1 in opts1:
