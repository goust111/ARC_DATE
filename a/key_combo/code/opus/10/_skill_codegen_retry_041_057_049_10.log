+            candidates = [cand for cand in candidates if not (_coords_with_margin(cand[0], 0) & occupied)]
+            if not candidates:
+                ok = False
+                break
+            coords, _base = random.choice(candidates)
+            finals.append(coords)
+            occupied.update(coords)
+        if not ok:
+            continue
+
+        back1 = _backshift_options(finals[0], direction, inner_h, inner_w)
+        back2 = _backshift_options(finals[1], direction, inner_h, inner_w)
+        by_distance_1 = {}
+        by_distance_2 = {}
+        for _d, coords, dist in back1:
+            by_distance_1.setdefault(dist, []).append(coords)
+        for _d, coords, dist in back2:
+            by_distance_2.setdefault(dist, []).append(coords)
+        shared = list(set(by_distance_1) & set(by_distance_2))
+        random.shuffle(shared)
+        for dist in shared:
+            for coords1 in by_distance_1[dist]:
+                halo1 = _coords_with_margin(coords1, 1)
+                for coords2 in by_distance_2[dist]:
+                    if halo1 & set(coords2):
+                        continue
+                    b1 = _bbox(coords1)
+                    b2 = _bbox(coords2)
+                    if (b1[0], b1[1]) == (b2[0], b2[1]):
+                        continue
