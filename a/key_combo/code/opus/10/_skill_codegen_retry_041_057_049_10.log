+    ordered = sorted(sprites, key=lambda item: (item["distance"], item["bbox"][0], item["bbox"][1]))
+    for sprite in ordered:
+        coords = sprite["coords"].astype(int).copy()
+        dr, dc = sprite["direction"]
+        step = np.array([dr, dc], dtype=int)
+        while True:
