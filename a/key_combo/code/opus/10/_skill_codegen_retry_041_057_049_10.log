+    dr, dc = direction
+    arr = _coords_array(final_coords)
+    if (dr, dc) == (1, 0):
+        max_back = min(r for r, _ in final_coords) - 1
+        step = (-1, 0)
+    elif (dr, dc) == (0, -1):
