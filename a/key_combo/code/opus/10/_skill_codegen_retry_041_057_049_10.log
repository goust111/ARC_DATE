+
+def _inside_margin(coords: tuple[tuple[int, int], ...], ih: int, iw: int, gap: int = 1) -> bool:
+    return all(gap <= r <= ih - 1 - gap and gap <= c <= iw - 1 - gap for r, c in coords)
