+def _is_hollow_rectangle(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 < 2 or c1 - c0 < 2:
+        return False
+    expected: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
