+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SPRITE_COLOR = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRECTIONS = ((0, 1), (1, 0), (0, -1), (-1, 0))  # right, down, left, up
+SHAPES = (
