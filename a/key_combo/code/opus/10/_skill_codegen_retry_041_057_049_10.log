+def _settled_candidates(
+    shape: tuple[tuple[int, int], ...],
+    ih: int,
+    iw: int,
+    direction: tuple[int, int],
+    occupied: set[tuple[int, int]],
+) -> list[tuple[tuple[tuple[int, int], ...], int]]:
