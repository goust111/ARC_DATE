+    colors = random.sample(BAR_COLORS, h_count + v_count)
+    bars: list[dict] = []
+    for row in rows:
+        bars.append({"orient": "H", "pos": int(row), "color": int(colors.pop())})
+    for col in cols:
+        bars.append({"orient": "V", "pos": int(col), "color": int(colors.pop())})
