+
+    unique_outputs = {int(expected[r0, c0]) for r0, c0, _r1, _c1 in (ch["bbox"] for ch in chambers)}
+    if len(unique_outputs) < 3:
+        return None
+    if np.count_nonzero(inp == MARK) != len(marked):
+        return None
+    return inp
+
