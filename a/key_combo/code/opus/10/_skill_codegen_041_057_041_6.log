+    sr, sc = map(int, anchor)
+    color = int(g[sr, sc])
+    assert color not in {BG, FRAME_COLOR, TEMPLATE_COLOR, *OP_COLORS}
+    q = deque([(sr, sc)])
+    seen = {anchor}
+    coords = []
+    while q:
+        r, c = q.popleft()
+        coords.append((r, c))
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(g.shape, nr, nc):
+                continue
+            if (nr, nc) in seen or int(g[nr, nc]) != color:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
