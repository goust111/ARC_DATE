+        op = item["op"]
+        if op in {TRANSLATE_COLOR, ERASE_COLOR}:
+            out[coords[:, 0], coords[:, 1]] = BG
+        elif op == RECOLOR_COLOR:
+            out[coords[:, 0], coords[:, 1]] = RECOLOR_COLOR
