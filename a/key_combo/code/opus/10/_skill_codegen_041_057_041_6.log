+    assert g.ndim == 2
+
+    frame = rectangular_frame(g)
+    frame_bbox = frame["bbox"]
+    templates = parse_templates(g)
+    markers = parse_corner_markers(g, frame_bbox)
+
+    actions: dict[str, tuple[dict, int]] = {}
+    for corner, comp in markers.items():
