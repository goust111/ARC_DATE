+    assert templates, "expected at least one template"
+    return templates
+
+
+def parse_corner_markers(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> dict[str, dict]:
+    markers: dict[str, dict] = {}
+    seen: set[tuple[int, int]] = set()
