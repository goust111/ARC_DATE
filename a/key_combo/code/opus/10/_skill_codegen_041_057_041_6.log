def _gen_widths(n: int, k: int) -> list[int] | None:
    total_cell_width = n - GEN_LATTICE_GAP_WIDTH * (k - 1)
    n3 = total_cell_width - GEN_CELL_WIDTH_MIN * k
    if n3 < 0 or n3 > k:
        return None
    widths = [GEN_CELL_WIDTH_MAX] * n3 + [GEN_CELL_WIDTH_MIN] * (k - n3)
