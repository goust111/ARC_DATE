+
+def get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    colors: tuple[int, ...] | list[int] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g) if bg is None else int(bg)
+    if colors is None:
+        palette = sorted(set(map(int, g.flatten())) - {bg})
+    else:
+        palette = [int(c) for c in colors if int(c) != bg]
+
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for color in palette:
+        cells = np.argwhere((g == color) & ~seen)
+        for r, c in cells:
+            r = int(r)
+            c = int(c)
+            if seen[r, c] or int(g[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds(g.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def normalized_shape(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0, c0, _r1, _c1 = bbox_coords(coords)
