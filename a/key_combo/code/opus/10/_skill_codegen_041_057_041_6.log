+import numpy as np
+
+
+BG = 0
+MARKER_COLORS = (1, 2, 3, 4)
+FRAME_COLOR = 5
+TEMPLATE_COLOR = 6
+TRANSLATE_COLOR = 7
+ERASE_COLOR = 8
+RECOLOR_COLOR = 9
+OP_COLORS = (TRANSLATE_COLOR, ERASE_COLOR, RECOLOR_COLOR)
