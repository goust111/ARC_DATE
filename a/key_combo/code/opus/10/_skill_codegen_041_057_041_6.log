+        for r, c in cells:
+            r = int(r)
+            c = int(c)
+            if seen[r, c] or int(g[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds(g.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
