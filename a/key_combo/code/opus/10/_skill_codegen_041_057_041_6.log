+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLORS = (1, 2, 3, 4)
+FRAME_COLOR = 5
+TEMPLATE_COLOR = 6
+TRANSLATE_COLOR = 7
+ERASE_COLOR = 8
+RECOLOR_COLOR = 9
+OP_COLORS = (TRANSLATE_COLOR, ERASE_COLOR, RECOLOR_COLOR)
+
+SHAPE_LIBRARY = {
+    "h3": {"kind": "h", "length": 3},
+    "v4": {"kind": "v", "length": 4},
+    "h5": {"kind": "h", "length": 5},
+}
+
+CORNER_ORDER = ("tl", "tr", "bl", "br")
+CORNER_ANCHOR_OFFSETS = {
+    "tl": (1, 1),
+    "tr": (1, -1),
+    "bl": (-1, 1),
+    "br": (-1, -1),
+}
+CORNER_TRANSLATIONS = {
+    "tl": (-2, -2),
+    "tr": (-2, 2),
+    "bl": (2, -2),
+    "br": (2, 2),
+}
+
+GEN_RETRIES = 400
