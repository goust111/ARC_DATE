+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    colors: tuple[int, ...] | list[int] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g) if bg is None else int(bg)
+    if colors is None:
+        palette = sorted(set(map(int, g.flatten())) - {bg})
+    else:
+        palette = [int(c) for c in colors if int(c) != bg]
