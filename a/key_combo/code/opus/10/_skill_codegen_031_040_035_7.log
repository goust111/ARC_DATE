    color: teal(8)
    size: 4-5 cells, single 8-connected component
    bbox: fits in 2x3 or 3x3
    dihedral_variants: 1-8 distinct orientations
  copies:
    count: 1-3 non-overlapping green(3) copies of template under dihedral group
    embedded: copies sit among scattered green noise pixels, not isolated
    total_candidates: may exceed selected count due to overlaps; greedy row-major picks first
  noise:
