                rr = moved_r - 1
                cc = c + dc
                while 0 <= rr < H and 0 <= cc < W:
                    paint.add((rr, cc))
                    rr -= 1
                    cc += dc

    for r, c in paint:
        assert out[r, c] == bg, "painted cells must be background after clearing moving pixels"
        out[r, c] = moving_color

    return out

