+        rows = sorted(set(rows))
+        rowset = set(rows)
+        for i, r0 in enumerate(rows):
+            for r1 in rows[i + 1 :]:
+                step = r1 - r0
+                r2 = r1 + step
+                if r2 not in rowset:
