+    for lh in range(3, min(h, 6) + 1):
+        for lw in range(3, min(w, 6) + 1):
+            if not np.all(g[lh - 1, :lw] == LEGEND_BORDER):
+                continue
+            if not np.all(g[:lh, lw - 1] == LEGEND_BORDER):
