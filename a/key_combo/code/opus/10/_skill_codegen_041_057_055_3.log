+import numpy as np
+
+
+BG = 0
+RAY = 2
+MARKER = 3
+LEGEND_BORDER = 9
+OBSTACLE_PALETTE = (1, 4, 5, 6, 7, 8)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
