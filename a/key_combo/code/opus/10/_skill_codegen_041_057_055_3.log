+BG = 0
+RAY = 2
+MARKER = 3
+LEGEND_BORDER = 9
+OBSTACLE_PALETTE = (1, 4, 5, 6, 7, 8)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
