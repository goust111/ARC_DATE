+            path = [(r, c0 + (3 + k) * step) for k in range(future_count)]
+        else:
+            r0 = h - 1 - (future_count + 2) * step
+            if r0 < 0:
+                continue
+            c = random.randint(0, w - 1)
+            markers = [(r0 + k * step, c) for k in range(3)]
+            path = [(r0 + (3 + k) * step, c) for k in range(future_count)]
