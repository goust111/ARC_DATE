+        if not placed:
+            return None
+
+    for triplet in triplets:
+        for r, c in triplet["markers"]:
+            if grid[r, c] != BG:
+                return None
+            grid[r, c] = MARKER
+
+    try:
+        _semantic_checks(grid, targets, components, triplets)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

