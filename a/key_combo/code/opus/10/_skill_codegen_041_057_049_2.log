+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+DIVIDER = 1
+WALL = 5
+OUTPUT = 6
+PANEL_H = 12
+PANEL_W = 12
+DIVIDER_W = 1
+INPUT_SHAPE = (PANEL_H, PANEL_W * 2 + DIVIDER_W)
+OUTPUT_SHAPE = (PANEL_H - 1, PANEL_W)
+PALETTE = (2, 3, 4, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 600
