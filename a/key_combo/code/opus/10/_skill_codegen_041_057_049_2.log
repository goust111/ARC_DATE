+            return None
+        _mark_blocked(blocked, cells)
+        rows = [r for r, _ in cells]
+        cols = {c for _, c in cells}
+        placed.append({"color": color, "coords": np.array(cells, dtype=int), "bottom": max(rows), "cols": cols})
