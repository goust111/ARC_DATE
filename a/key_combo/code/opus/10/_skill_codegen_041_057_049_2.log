+def _generation_ranges(want_overlap: bool) -> tuple[tuple[int, int], tuple[int, int]]:
+    if want_overlap:
+        start = random.randint(1, 4)
+        span = random.randint(6, 7)
+        end = min(PANEL_W - 1, start + span - 1)
