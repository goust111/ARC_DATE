+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(panel[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        queue.append((nr, nc))
