+        right_range,
+        prefer_tie=want_tie and tie_side == "right",
+        prefer_stack=stack_side == "right",
+    )
+    if right is None:
+        return None
+
+    grid = _assemble_grid(left, right)
+    if not _semantic_check(grid, want_overlap=want_overlap, want_tie=want_tie):
+        return None
+    return grid
