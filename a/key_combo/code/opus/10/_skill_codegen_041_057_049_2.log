+            coords = np.array(cells, dtype=int)
+            assert coords.shape[0] == 2, "every moving object must be a domino"
+            (r0, c0), (r1, c1) = coords
+            assert abs(int(r0) - int(r1)) + abs(int(c0) - int(c1)) == 1, "domino must be 4-connected"
+            dominoes.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": (
+                        int(coords[:, 0].min()),
+                        int(coords[:, 1].min()),
+                        int(coords[:, 0].max()),
+                        int(coords[:, 1].max()),
+                    ),
+                }
+            )
