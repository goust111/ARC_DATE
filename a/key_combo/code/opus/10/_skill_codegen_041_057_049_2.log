+def _assemble_grid(left_panel: np.ndarray, right_panel: np.ndarray) -> np.ndarray:
+    grid = np.full(INPUT_SHAPE, BG, dtype=int)
+    grid[:, :PANEL_W] = left_panel
+    grid[:, PANEL_W] = DIVIDER
+    grid[:, PANEL_W + 1 :] = right_panel
+    return grid
+
