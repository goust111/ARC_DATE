+
+def _union_from_settled(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    mask = _moving_mask(left[:-1, :]) | _moving_mask(right[:-1, :])
+    out = np.full(mask.shape, BG, dtype=int)
+    out[mask] = OUTPUT
+    return out
