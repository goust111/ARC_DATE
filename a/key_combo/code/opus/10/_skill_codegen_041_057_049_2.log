def _gen_assignment_counts(area: int, union_count: int) -> tuple[int, int] | None:
    min_panel = (area + MIN_PANEL_FILL_DIVISOR - 1) // MIN_PANEL_FILL_DIVISOR
    max_panel = (MAX_PANEL_FILL_PERCENT * area) // PERCENT_DENOMINATOR
