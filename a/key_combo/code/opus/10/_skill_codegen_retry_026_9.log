spec:
  grid: 13-17 rows x 13-17 cols, background black (0)
  colors: exactly 2 foreground colors -- frame_color and marker_color
  frames:
    count: 2-3 non-overlapping, non-nested rectangular 1px-thick hollow frames, all frame_color
    frame_color forms ONLY complete rectangular frames (no stray pixels)
