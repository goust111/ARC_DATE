        out[r, c] = int(color)

    inp = np.full(GEN_INPUT_SHAPE, GEN_BACKGROUND_COLOR, dtype=int)
    columns = sorted(np.random.choice(GEN_INPUT_SHAPE[1], size=n_markers, replace=False).tolist())
    rows = _sample_marker_rows(columns)
