0156: def _sprite_cells(apex: tuple[int, int], direction: tuple[int, int]) -> tuple[tuple[int, int], ...]:
0157:     """Return the 3 pixel coords of a triangle sprite with given apex and firing direction.
0158: 
0159:     Diagonal dir -> L-shape occupying 3 corners of a 2x2 (missing the corner opposite dir).
0160:     Axis dir -> V-shape with apex + 2 diagonal legs pointing opposite dir.
0161:     """
0162:     ar, ac = apex
0163:     dr, dc = direction
0164:     if abs(dr) + abs(dc) == 2:
0165:         return ((ar, ac), (ar - dr, ac), (ar, ac - dc))
0166:     if dr != 0:
0167:         return ((ar, ac), (ar - dr, ac - 1), (ar - dr, ac + 1))
0168:     return ((ar, ac), (ar - 1, ac - dc), (ar + 1, ac - dc))
0169: 
0170: 
0171: def _in_bounds_cells(cells: tuple[tuple[int, int], ...]) -> bool:
0172:     return all(0 <= r < H and 0 <= c < W for r, c in cells)
0173: 
0174: 
0175: def _halo(cells: tuple[tuple[int, int], ...]) -> frozenset[tuple[int, int]]:
0176:     """Cell + 8-neighborhood, clipped to grid. Used to enforce Chebyshev>=2 separation."""
0177:     return frozenset(
0178:         (rr, cc)
0179:         for r, c in cells
0180:         for rr in range(max(0, r - 1), min(H, r + 2))
0181:         for cc in range(max(0, c - 1), min(W, c + 2))
0182:     )
0183: 
0184: 
0185: def _build_placements() -> tuple[list[dict], dict[tuple[int, int], list[dict]]]:
0186:     """Precompute all (apex, dir) placements whose sprite and landing cell are in-bounds."""
0187:     placements: list[dict] = []
0188:     by_dest: dict[tuple[int, int], list[dict]] = defaultdict(list)
0189:     for ar in range(H):
0190:         for ac in range(W):
0191:             for dr, dc in ALL_DIRS:
0192:                 dest = (ar + PROJECTILE_DIST * dr, ac + PROJECTILE_DIST * dc)
0193:                 if not (0 <= dest[0] < H and 0 <= dest[1] < W):
0194:                     continue
0195:                 cells = _sprite_cells((ar, ac), (dr, dc))
0196:                 if not _in_bounds_cells(cells):
0197:                     continue
0198:                 placement = {
0199:                     "apex": (ar, ac),
0200:                     "dir": (dr, dc),
0201:                     "dest": dest,
0202:                     "cells": cells,
0203:                     "cell_set": frozenset(cells),
0204:                     "halo": _halo(cells),
0205:                 }
0206:                 placements.append(placement)
