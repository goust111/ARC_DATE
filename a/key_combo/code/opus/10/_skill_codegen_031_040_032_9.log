0041:     assert len(panel_shapes) == 1
0042:     height, width = next(iter(panel_shapes))
0043: 
0044:     out = np.full((height, width), blank, dtype=int)
0045:     for r0, c0, r1, c1 in boxes:
0046:         patch = g[r0 : r1 + 1, c0 : c1 + 1]
0047:         assert patch.shape == (height, width)
0048:         assert np.all(patch != separator)
0049: 
0050:         mark_mask = patch != blank
0051:         assert np.any(mark_mask)
0052:         assert not np.any((out != blank) & mark_mask)
