0143: DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]  # L-shape fires diagonally
0144: AXIS_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]    # V-shape fires axis-aligned
