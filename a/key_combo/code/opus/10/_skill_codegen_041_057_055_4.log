+def _anchors_far_enough(anchors: list[tuple[int, int]], candidate: tuple[int, int]) -> bool:
+    for anchor in anchors:
+        if max(abs(int(anchor[0] - candidate[0])), abs(int(anchor[1] - candidate[1]))) < 2:
+            return False
+    return True
