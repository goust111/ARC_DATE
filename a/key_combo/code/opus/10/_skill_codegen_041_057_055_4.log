+        "patch": patch,
+        "anchor_color": anchor_color,
+        "anchor_pos": anchor_pos,
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "area": int(coords.shape[0]),
+        "cells": [tuple(map(int, cell)) for cell in cells],
+    }
