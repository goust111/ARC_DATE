+    src_inner = grid[sr + 1 : sr + src_h - 1, sc + 1 : sc + src_w - 1]
+    for item in source_placements:
+        _stamp_into_inner(src_inner, item["sprite"]["patch"], int(item["top"]), int(item["left"]))
