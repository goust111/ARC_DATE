+    dst_inner = grid[dr + 1 : dr + dst_h - 1, dc + 1 : dc + dst_w - 1]
+    for marker in target_markers:
+        mr, mc = map(int, marker["pos"])
+        dst_inner[mr, mc] = int(marker["color"])
