+def _chebyshev_path_cells(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc = start
+    er, ec = end
+    r, c = int(sr), int(sc)
+    step_r = _sign(er - sr)
+    step_c = _sign(ec - sc)
+    cells: list[tuple[int, int]] = []
+    while r != er and c != ec:
+        r += step_r
+        c += step_c
+        if (r, c) != (er, ec):
+            cells.append((r, c))
+    while r != er:
+        r += step_r
+        if (r, c) != (er, ec):
+            cells.append((r, c))
+    while c != ec:
+        c += step_c
+        if (r, c) != (er, ec):
+            cells.append((r, c))
+    return cells
