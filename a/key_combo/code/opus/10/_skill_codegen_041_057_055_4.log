+
+
+def _place_source_sprites(sprites: list[dict], inner_h: int, inner_w: int) -> list[dict] | None:
+    for _ in range(300):
+        order = sprites[:]
+        random.shuffle(order)
+        occupied: set[tuple[int, int]] = set()
+        placements: list[dict] = []
+        success = True
+        for sprite in order:
