    # Build expected output manually and compare
    expected = grid.copy()
    for a, (pr, pc) in zip(assemblies, placements):
        oh, ow = a['outer_h'], a['outer_w']
        hs = a['head_side']
        steps = a['steps']
        inner_h, inner_w = a['inner_h'], a['inner_w']
        initial_orange = a['initial_orange']
