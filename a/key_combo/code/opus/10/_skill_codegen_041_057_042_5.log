    half = axis_gap // 2
    slots.append({
        'r0': cur_r, 'col_offset': -(half + w),
        'shape_dst': dst_L, 'shape_src': src_L, 'pair_id': pair_id,
    })
    slots.append({
        'r0': cur_r, 'col_offset': half + 1,
        'shape_dst': dst_R, 'shape_src': src_R, 'pair_id': pair_id,
