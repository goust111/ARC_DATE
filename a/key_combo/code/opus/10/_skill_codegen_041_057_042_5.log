_GEN_CAVITY_WIDTH_OPTIONS = (6, 8, 9, 10, 12, 15)
_GEN_CAVITY_DIMS = [(h, w) for h in _GEN_CAVITY_HEIGHT_OPTIONS for w in _GEN_CAVITY_WIDTH_OPTIONS]
_GEN_BORDER_WALL_THICKNESS = 2
_GEN_CAVITY_START_GAP = 3
