spec:
  input:
    grid: exactly 3x3
    colors: black background + exactly 1 non-black foreground color (any of 1-9)
    black_count_b: 3-8 (number of black pixels); determines output grid side in slots
    fg_count_f: 1-6 (= 9 - b); determines number of sprite copies
    constraint: f <= b^2 (always true for b >= 3)
    fg_pixel_arrangement: arbitrary within the 3x3; no connectivity or symmetry required
  output:
    grid: (3b) x (3b) square
    structure: b x b grid of 3x3 slots; first f slots (row-major order) contain the input sprite, remaining slots are all-black

generation_strategy:
