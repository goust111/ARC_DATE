+def _normalize_coords(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    arr = np.asarray(points, dtype=int)
+    arr -= arr.min(axis=0)
+    return [tuple(map(int, p)) for p in arr]
+
+
+def _transform_points(
+    points: list[tuple[int, int]],
+    *,
+    transpose: bool,
+    flip_r: bool,
+    flip_c: bool,
