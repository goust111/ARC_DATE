+def _strict_interior_mask(shape: tuple[int, int], cycle: list[tuple[int, int]]) -> np.ndarray:
+    h, w = map(int, shape)
+    mask = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            mask[r, c] = _inside_convex_polygon((r, c), cycle)
+    return mask
+
