+    arr = np.asarray(points, dtype=int)
+    if transpose:
+        arr = arr[:, ::-1]
+    arr -= arr.min(axis=0)
+    if flip_r:
+        arr[:, 0] = arr[:, 0].max() - arr[:, 0]
+    if flip_c:
+        arr[:, 1] = arr[:, 1].max() - arr[:, 1]
+    arr -= arr.min(axis=0)
+    return [tuple(map(int, p)) for p in arr]
