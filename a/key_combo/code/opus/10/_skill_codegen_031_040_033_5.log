+        max_w = min(19, 30)
+        if min_h > max_h or min_w > max_w:
+            return None
+        canvas_shape = (
+            random.randint(min_h, max_h),
+            random.randint(min_w, max_w),
+        )
+        inp, _offset = _embed_patch(input_patch, canvas_shape)
