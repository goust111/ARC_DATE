+def _inside_convex_polygon(cell: tuple[int, int], cycle: list[tuple[int, int]]) -> bool:
+    x = float(cell[1])
+    y = float(-cell[0])
+    sign = 0
+    n = len(cycle)
+    for i in range(n):
+        r0, c0 = cycle[i]
+        r1, c1 = cycle[(i + 1) % n]
+        x0, y0 = float(c0), float(-r0)
+        x1, y1 = float(c1), float(-r1)
+        cross = (x1 - x0) * (y - y0) - (y1 - y0) * (x - x0)
+        if abs(cross) < 1e-9:
+            return False
+        cur = 1 if cross > 0 else -1
+        if sign == 0:
+            sign = cur
+        elif cur != sign:
