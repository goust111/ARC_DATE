+def _make_pentagon(wide: bool) -> list[tuple[int, int]]:
+    bevel = random.randint(2, 3)
+    stem = random.randint(2, 5)
+    run = random.randint(max(3, stem + 1), stem + 5)
+    points = [(0, 0), (0, run), (bevel, bevel + run), (bevel + stem, bevel + run), (bevel + stem, 0)]
