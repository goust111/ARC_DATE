def _gen_rects_clear(
    box: tuple[int, int, int, int], placed: list[tuple[int, int, int, int]]
) -> bool:
    r0, c0, r1, c1 = box
    for pr0, pc0, pr1, pc1 in placed:
        if not (r1 + 1 < pr0 or pr1 + 1 < r0 or c1 + 1 < pc0 or pc1 + 1 < c0):
            return False
    return True


def _gen_place_rectangles(
