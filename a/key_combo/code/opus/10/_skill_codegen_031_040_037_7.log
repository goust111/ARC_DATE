+    outer_bbox: tuple[int, int, int, int],
+    gap_rows: list[int],
+    gap_cols: list[int],
+) -> list[tuple[int, int, int, int]]:
+    boxes = [outer_bbox]
+    r0, c0, r1, c1 = outer_bbox
+    for dr, dc in zip(gap_rows, gap_cols):
+        r0 += dr
+        c0 += dc
+        r1 -= dr
+        c1 -= dc
+        boxes.append((r0, c0, r1, c1))
+    return boxes
+
+
