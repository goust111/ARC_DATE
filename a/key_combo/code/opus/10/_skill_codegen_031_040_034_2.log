+    th, tw = mask.shape
+    out = np.full((th * len(marker_colors), tw), int(bg), dtype=int)
+    for i, color in enumerate(marker_colors):
+        patch = np.full(mask.shape, int(bg), dtype=int)
+        patch[mask] = int(color)
