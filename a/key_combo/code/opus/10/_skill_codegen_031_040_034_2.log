+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+BAR_COLORS = (Color.TEAL, Color.RED)
+MARKER_POOL = (Color.BLUE, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.MAROON)
+HEIGHT_VALUES = tuple(range(2, 8))
+GEN_RETRY_LIMIT = 400
