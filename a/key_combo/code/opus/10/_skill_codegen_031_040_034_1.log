+def _sample_gap_sides(count: int, rng: np.random.Generator) -> list[str]:
+    sides = [
+        str(rng.choice(np.array(["top", "bottom"], dtype=object))),
+        str(rng.choice(np.array(["left", "right"], dtype=object))),
