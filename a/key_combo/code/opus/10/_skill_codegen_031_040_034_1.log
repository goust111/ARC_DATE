  56: def _gen_force_asymmetry(grid: np.ndarray, palette: list[int]) -> set[tuple[int, int]]:
  57:     h, w = grid.shape
  58:     a, b = np.random.choice(np.array(palette, dtype=int), size=2, replace=False)
  59: 
  60:     lr_pairs = [((r, c), (r, w - 1 - c)) for r in range(h) for c in range(w // 2)]
  61:     ud_pairs = [((r, c), (h - 1 - r, c)) for r in range(h // 2) for c in range(w)]
  62:     pair_options = [
  63:         (lr_pair, ud_pair)
  64:         for lr_pair in lr_pairs
  65:         for ud_pair in ud_pairs
  66:         if set(lr_pair).isdisjoint(set(ud_pair))
  67:     ]
