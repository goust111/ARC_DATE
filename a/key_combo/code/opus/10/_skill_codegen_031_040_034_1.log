+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1]))
+    w = int(rng.integers(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1]))
