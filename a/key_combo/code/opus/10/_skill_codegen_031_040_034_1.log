+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]  # type: ignore[misc]
+        gap = frame["gap"]  # type: ignore[assignment]
+        if out[gap] != BLUE:
+            return False
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
