+    grid = np.zeros((h, w), dtype=int)
+    for frame in frames:
+        bbox = frame["bbox"]  # type: ignore[assignment]
+        side = frame["side"]  # type: ignore[assignment]
+        gap = _gap_position(bbox, side, rng)
+        _draw_frame(grid, bbox, gap)
