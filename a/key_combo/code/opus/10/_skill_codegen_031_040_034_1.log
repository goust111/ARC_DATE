   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Recolor the sparse foreground pixels in scan order along their longer spread, cycling red, teal, and grey.
  12: 
  13:     Input structure:
  14:     - The dominant color is the background.
  15:     - Every foreground object is a single isolated 4-connected pixel.
  16:     - The foreground pixel set has a rectangular bbox whose row or column extent defines the scan direction.
  17: 
  18:     Rule:
  19:     - Keep the background unchanged.
  20:     - If the foreground bbox is at least as tall as it is wide, order foreground pixels row-major; otherwise order them column-major.
  21:     - Recolor the ordered pixels by repeating red, teal, grey from the first pixel onward.
  22: 
  23:     Key insight:
  24:     - The original foreground colors are only markers; the output color depends on each marker's ordinal position in the dominant scan direction.
  25:     """
  26:     g = np.asarray(grid, dtype=int)
  27:     bg = int(get_bg(g))
  28:     assert bg not in _CYCLE, "background must be distinct from the output color cycle"
  29: 
  30:     fg = g != bg
  31:     coords = coords_where(fg)
  32:     assert len(coords) > 0, "expected at least one foreground marker"
  33: 
  34:     coords_list = [(int(r), int(c)) for r, c in coords]
  35:     for r, c in coords_list:
  36:         assert all(
  37:             not in_bounds(g.shape, nr, nc) or int(g[nr, nc]) == bg
