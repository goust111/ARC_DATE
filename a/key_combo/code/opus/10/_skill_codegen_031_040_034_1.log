  72:     grid[r1, c1] = b
  73:     protected = {(r0, c0), (r1, c1)}
  74: 
  75:     (r0, c0), (r1, c1) = ud_pair
  76:     grid[r0, c0] = a
  77:     grid[r1, c1] = b
  78:     protected.update({(r0, c0), (r1, c1)})
