  83:     h, w = grid.shape
  84:     present = {int(grid[r, c]) for r, c in protected}
  85:     required = [c for c in palette if c not in present]
  86:     coords = [(r, c) for r in range(h) for c in range(w) if (r, c) not in protected]
  87:     np.random.shuffle(coords)
  88:     if len(required) > len(coords):
  89:         return False
  90:     for color, (r, c) in zip(required, coords):
  91:         grid[r, c] = color
  92:     for r, c in coords[len(required) :]:
  93:         grid[r, c] = int(np.random.choice(np.array(palette, dtype=int)))
  94:     return True
  95: 
