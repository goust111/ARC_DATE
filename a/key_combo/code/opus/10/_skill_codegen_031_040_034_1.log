  46:     else:
  47:         ordered = sorted(coords_list, key=lambda rc: (rc[1], rc[0]))
  48: 
  49:     out = g.copy()
  50:     for i, (r, c) in enumerate(ordered):
  51:         out[r, c] = _CYCLE[i % len(_CYCLE)]
