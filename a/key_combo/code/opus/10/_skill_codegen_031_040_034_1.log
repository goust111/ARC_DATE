+    if not _validate_generated_input(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
