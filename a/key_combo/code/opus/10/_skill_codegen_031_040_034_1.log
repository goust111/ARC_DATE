+        r0, c0, r1, c1 = bbox
+        axis = _mirror_axis_from_side(side)
+        pattern = _build_pattern(r1 - r0 - 1, c1 - c0 - 1, axis, rng)
+        interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+        interior[pattern] = RED
