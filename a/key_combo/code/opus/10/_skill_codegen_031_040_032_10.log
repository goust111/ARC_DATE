+def _main_bbox(grid: np.ndarray, keys: set[int]) -> tuple[int, int, int, int]:
+    mask = np.isin(grid, list(keys))
+    mask[:, :2] = False
+    coords = np.argwhere(mask)
+    assert coords.size > 0, "main mask must contain legend key colors"
+    return _bbox(coords)
