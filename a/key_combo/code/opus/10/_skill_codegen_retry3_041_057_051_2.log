+    output_closed = _enclosed_black_regions(moved_grid)
+    to_fill = [region for region in output_closed if frozenset(region) not in input_closed]
+    out = moved_grid.copy()
+    for region in to_fill:
+        for r, c in region:
+            out[r, c] = YELLOW
+    return out, to_fill
+
+
