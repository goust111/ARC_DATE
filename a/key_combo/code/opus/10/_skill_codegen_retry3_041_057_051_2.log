+    "west": {(1, -2), (2, -2), (3, -2), (2, -1)},
+}
+
+
+def _rotate_coords(
+    coords: set[tuple[int, int]], shape: tuple[int, int], turns: int
+) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    h, w = shape
+    out = set(coords)
+    turns %= 4
