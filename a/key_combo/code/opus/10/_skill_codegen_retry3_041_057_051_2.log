                        sides=sides_of(obj, marker)
                        if len(sides)"'!=1: continue
                        side=next(iter(sides))
                        moved=shift(obj, side)
                        if moved & marker: continue
                        ein=set(enclosed(marker|obj))
                        eout=set(enclosed(marker|moved))
                        if any(comp not in ein for comp in eout):
                            print('"'marker',sorted(marker))
                            print('obj',sorted(obj))
                            print('side',side)
                            print('moved',sorted(moved))
                            print('ein',[sorted(x) for x in ein])
                            print('eout',[sorted(x) for x in eout])
                            raise SystemExit
print('none')
