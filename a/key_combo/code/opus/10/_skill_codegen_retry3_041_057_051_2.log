+
+
+BLACK = 0
+BLUE = 1
+YELLOW = 4
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DELTA = {
+    "north": (-1, 0),
+    "south": (1, 0),
+    "west": (0, -1),
+    "east": (0, 1),
+}
+DELTA_TO_SIDE = {v: k for k, v in SIDE_TO_DELTA.items()}
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _component_sets(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
