from collections import deque
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]
H,W=8,8
# fixed marker template from current design
marker={(2,1),(3,1),(4,1),(4,2),(4,3)}
pts=[(r,c) for r in range(H) for c in range(W)]

def conn(cells):
    s=set(cells)
    q=deque([next(iter(s))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIR4:
            p=(r+dr,c+dc)
            if p in s and p not in seen:
                seen.add(p); q.append(p)
    return len(seen)==len(s)

def side_set(obj):
    sides=set()
    for r,c in obj:
        if (r+1,c) in marker: sides.add('north')
        if (r-1,c) in marker: sides.add('south')
        if (r,c+1) in marker: sides.add('west')
        if (r,c-1) in marker: sides.add('east')
    return sides

def shift(obj, side):
    rows=[r for r,c in obj]; cols=[c for r,c in obj]
    if side=='north': amt=-min(rows); dr,dc=-1,0
    elif side=='south': amt=(H-1)-max(rows); dr,dc=1,0
    elif side=='west': amt=-min(cols); dr,dc=0,-1
    else: amt=(W-1)-max(cols); dr,dc=0,1
    return {(r+dr*amt,c+dc*amt) for r,c in obj}

def enclosed(blocked):
    seen=set(); comps=[]
    for r in range(H):
        for c in range(W):
            if (r,c) in blocked or (r,c) in seen: continue
            q=deque([(r,c)]); seen.add((r,c)); comp={(r,c)}; touch=False
            while q:
                rr,cc=q.popleft()
                if rr in (0,H-1) or cc in (0,W-1): touch=True
                for dr,dc in DIR4:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and (nr,nc) not in blocked and (nr,nc) not in seen:
                        seen.add((nr,nc)); q.append((nr,nc)); comp.add((nr,nc))
            if not touch: comps.append(frozenset(comp))
    return comps

cand_pts=[(r,c) for r in range(0,6) for c in range(0,6)]
for size in range(3,6):
    for cells in combinations(cand_pts, size):
        obj=set(cells)
        if obj & marker or not conn(obj):
            continue
        sides=side_set(obj)
        if len(sides)"'!=1:
            continue
        side=next(iter(sides))
        moved=shift(obj, side)
        if moved & marker:
            continue
        ein=set(enclosed(marker|obj))
        eout=set(enclosed(marker|moved))
        new=[comp for comp in eout if comp not in ein]
        if new:
            print('"'side',side,'obj',sorted(obj),'moved',sorted(moved),'new',sorted(list(new[0]))[:20])
            raise SystemExit
print('none')
