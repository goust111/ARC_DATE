+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+    out, _ = _expected_output(g)
+    return out
+
+
+MARKER_TEMPLATE = {
+    (1, 1),
+    (2, 1),
+    (3, 1),
+    (3, 2),
+    (3, 3),
+}
+PRIMARY_OBJECT_TEMPLATE = {
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 2),
+    (2, 2),
+}
+AUXILIARY_TEMPLATES = {
