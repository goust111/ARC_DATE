+    elif dr == 1:
+        amount = (h - 1) - max(rows)
+    elif dc == -1:
+        amount = min(cols)
+    else:
+        amount = (w - 1) - max(cols)
+    return {(r + dr * amount, c + dc * amount) for r, c in obj}
