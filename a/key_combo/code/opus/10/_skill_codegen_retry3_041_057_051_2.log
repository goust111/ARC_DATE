+MARKER_TEMPLATE = {
+    (1, 1),
+    (2, 1),
+    (3, 1),
+    (3, 2),
+    (3, 3),
+}
+PRIMARY_OBJECT_TEMPLATE = {
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 2),
+    (2, 2),
+}
+AUXILIARY_TEMPLATES = {
+    "south": {(4, 1), (5, 0), (5, 1), (5, 2)},
+    "west": {(1, -2), (2, -2), (3, -2), (2, -1)},
+}
+
+
+def _rotate_coords(
+    coords: set[tuple[int, int]], shape: tuple[int, int], turns: int
+) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    h, w = shape
+    out = set(coords)
+    turns %= 4
+    for _ in range(turns):
