+SIDE_TO_DELTA = {
+    "north": (-1, 0),
+    "south": (1, 0),
+    "west": (0, -1),
+    "east": (0, 1),
+}
+DELTA_TO_SIDE = {v: k for k, v in SIDE_TO_DELTA.items()}
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
