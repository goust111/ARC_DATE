+
+def _paint(
+    grid: np.ndarray, coords: set[tuple[int, int]], color: int
+) -> None:
+    for r, c in coords:
+        grid[r, c] = color
+
+
+def _build_canonical_scene(rng: random.Random) -> np.ndarray:
+    h = rng.randint(10, 14)
+    w = rng.randint(10, 14)
+    grid = np.zeros((h, w), dtype=int)
