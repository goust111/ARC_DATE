from collections import deque
DIR4=[(1,0),(-1,0),(0,1),(0,-1)]
H,W=8,8

def norm(cells):
    mr=min(r for r,c in cells); mc=min(c for r,c in cells)
    return tuple(sorted((r-mr,c-mc) for r,c in cells))

def gen_poly(max_cells, boxh, boxw):
    by_size={1:{frozenset({(0,0)})}}
    for size in range(2,max_cells+1):
        out=set()
        for shape in by_size[size-1]:
            frontier=set()
            for r,c in shape:
                for dr,dc in DIR4:
                    p=(r+dr,c+dc)
                    if p not in shape:
                        frontier.add(p)
            for p in frontier:
                ns=norm(set(shape)|{p})
                if max(r for r,c in ns) < boxh and max(c for r,c in ns) < boxw:
                    out.add(frozenset(ns))
        by_size[size]=out
    return {k:[set(x) for x in v] for k,v in by_size.items()}

def enclosed(blocked):
    seen=set(); comps=[]
    for r in range(H):
      for c in range(W):
        if (r,c) in blocked or (r,c) in seen: continue
        q=deque([(r,c)]); seen.add((r,c)); comp={(r,c)}; touch=False
        while q:
            rr,cc=q.popleft()
            if rr in (0,H-1) or cc in (0,W-1): touch=True
            for dr,dc in DIR4:
                nr,nc=rr+dr,cc+dc
                if 0<=nr<H and 0<=nc<W and (nr,nc) not in blocked and (nr,nc) not in seen:
                    seen.add((nr,nc)); q.append((nr,nc)); comp.add((nr,nc))
        if not touch: comps.append(frozenset(comp))
    return comps

def sides_of(obj, marker):
    sides=set()
    for r,c in obj:
        if (r+1,c) in marker: sides.add('north')
        if (r-1,c) in marker: sides.add('south')
        if (r,c+1) in marker: sides.add('west')
        if (r,c-1) in marker: sides.add('east')
    return sides

def shift(obj, side):
    rows=[r for r,c in obj]; cols=[c for r,c in obj]
    if side=='north': amt=min(rows); dr,dc=-1,0
    elif side=='south': amt=(H-1)-max(rows); dr,dc=1,0
    elif side=='west': amt=min(cols); dr,dc=0,-1
    else: amt=(W-1)-max(cols); dr,dc=0,1
    return {(r+dr*amt,c+dc*amt) for r,c in obj}

markers=[]
for size,shapes in gen_poly(8,4,4).items():
    if 4<=size<=8:
        markers += shapes
objs=[]
for size,shapes in gen_poly(5,4,4).items():
    if 3<=size<=5:
        objs += shapes
print('counts',len(markers),len(objs))
for mshape in markers:
    mh=max(r for r,c in mshape)+1; mw=max(c for r,c in mshape)+1
    for mr in range(1,H-mh-1):
        for mc in range(1,W-mw-1):
            marker={(r+mr,c+mc) for r,c in mshape}
            for oshape in objs:
