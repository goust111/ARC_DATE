+
+def _analyze_choice(shape: tuple[int, int], top_cups: list[dict], left_cups: list[dict], top_counts: tuple[int, ...], left_counts: tuple[int, ...]) -> dict:
+    h, w = shape
+    vertical = np.zeros((h, w), dtype=int)
+    for cup, count in zip(top_cups, top_counts):
