) -> list[tuple[tuple[int, int], tuple[int, int]]]:
    h, w = clean.shape
    cells = []
    for r in range(1, h - 1):
        for c in range(1, w - 1):
            if int(clean[r, c]) != BACKGROUND:
                continue
            if int(residue_counts[r % period, c % period]) < 3:
                continue
            cells.append((r, c))

