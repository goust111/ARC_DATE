+
+    collisions = (vertical > 0) & (horizontal > 0)
+    yellow = ((vertical > 0) | (horizontal > 0)) & ~collisions
+    out[collisions & (out == BACKGROUND)] = ORANGE
+    out[yellow & (out == BACKGROUND)] = YELLOW
