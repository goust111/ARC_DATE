+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_RANGE)
+    w = random.randint(*GRID_RANGE)
+    top_count = random.choice(COUNT_OPTIONS)
+    left_count = random.choice(COUNT_OPTIONS)
+    total = top_count + left_count
