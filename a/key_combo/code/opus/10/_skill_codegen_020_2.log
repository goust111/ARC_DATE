+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+YELLOW = 4
+ORANGE = 7
+DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+BORDER_COLORS = (1, 2, 3, 5, 6, 8, 9)
+GRID_RANGE = (12, 15)
+COUNT_OPTIONS = (2, 3)
