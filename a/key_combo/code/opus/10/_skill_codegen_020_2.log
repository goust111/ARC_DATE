+
+
+def _expected_output(inp: np.ndarray, top_cups: list[dict], left_cups: list[dict], top_counts: tuple[int, ...], left_counts: tuple[int, ...], chosen_content: dict[tuple[int, int], list[tuple[int, int]]]) -> np.ndarray:
