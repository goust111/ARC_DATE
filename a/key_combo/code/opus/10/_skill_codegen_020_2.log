def _make_cup_defs(count: int, orientation: str, colors: list[int]) -> list[dict]:
    defs = []
    for color in colors[:count]:
        interior_h = random.randint(1, 2)
        interior_w = random.randint(1, 2)
        tail_col = random.randint(1, interior_w)
