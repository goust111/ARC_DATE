            if dr + dc != period:
                continue
            if kind == "row" and dr != 0:
                continue
            if kind == "col" and dc != 0:
                continue
            if kind == "diag" and (dr == 0 or dc == 0):
                continue
            residue_b = (rb % period, cb % period)
            if residue_a == residue_b:
                continue
            pairs.append((a, (rb, cb)))
    random.shuffle(pairs)
    return pairs


