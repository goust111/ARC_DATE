+    r0, c0, r1, c1 = box
+
+    fill_mask = np.zeros_like(red_mask, dtype=bool)
+    fill_mask[r0 : r1 + 1, c0 : c1 + 1] = out[r0 : r1 + 1, c0 : c1 + 1] == BG
+    out[fill_mask] = YELLOW
+
+    openings = _candidate_openings(red_mask, box)
