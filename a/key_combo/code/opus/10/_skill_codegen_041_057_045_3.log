def neighbors4(r: int, c: int) -> Iterator[Coord]:
    """4-neighborhood of (r,c)."""
    r = int(r)
    c = int(c)
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1

===== def flood =====
def flood_fill(grid: np.ndarray, r: int, c: int, color: int, *, connectivity: int = 4) -> None:
    """Flood fill region containing (r,c) with `color` (in-place)."""
    H, W = grid.shape
    r0 = int(r)
    c0 = int(c)
    if not (0 <= r0 < H and 0 <= c0 < W):
        return
    new_col = int(color)
    old_col = int(grid[r0, c0])
    if old_col == new_col:
        return
    if int(connectivity) == 4:
        def nbrs(rr: int, cc: int):
            yield rr - 1, cc
            yield rr + 1, cc
            yield rr, cc - 1
            yield rr, cc + 1
    else:
        def nbrs(rr: int, cc: int):
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    yield rr + dr, cc + dc
    stack: list[Coord] = [(r0, c0)]
    while stack:
        rr, cc = stack.pop()
        if not (0 <= rr < H and 0 <= cc < W):
            continue
        if int(grid[rr, cc]) != old_col:
            continue
        grid[rr, cc] = new_col
        for nr, nc in nbrs(rr, cc):
            stack.append((nr, nc))


