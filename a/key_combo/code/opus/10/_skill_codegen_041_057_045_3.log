+    bottom_margin = random.randint(1, 6 if active_side != "bottom" else 8)
+    left_margin = random.randint(1, 6 if active_side != "left" else 8)
+    right_margin = random.randint(1, 6 if active_side != "right" else 8)
+    h = outer_h + top_margin + bottom_margin
+    w = outer_w + left_margin + right_margin
+    if h > 30 or w > 30:
+        return None
+
+    mr = top_margin + extent_r
+    mc = left_margin + extent_c
+    ring = _build_ring_mask((h, w), (mr, mc), extent_r, extent_c, gap_axis)
+    fragment = _extract_quadrant_fragment(ring, (mr, mc), quadrant)
+    if not (5 <= int(fragment.sum()) <= 8):
+        return None
+    if _component_count(fragment) != 1:
+        return None
+
+    inp = np.full((h, w), BG, dtype=int)
+    inp[fragment] = RED
+    inp[mr : mr + 2, mc : mc + 2] = MARKER
+
+    rows, cols = np.argwhere(inp == RED).T
+    if not (
+        (quadrant[0] == "top" and int(rows.max()) < mr)
+        or (quadrant[0] == "bottom" and int(rows.min()) > mr + 1)
+    ):
+        return None
+    if not (
+        (quadrant[1] == "left" and int(cols.max()) < mc)
+        or (quadrant[1] == "right" and int(cols.min()) > mc + 1)
+    ):
+        return None
+
+    if not _semantic_check(inp, gap_axis, active_side):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

