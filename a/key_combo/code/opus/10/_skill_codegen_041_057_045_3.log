+
+
+_EXTENTS = [(2, 3), (3, 2), (2, 4), (4, 2), (3, 3), (3, 4), (4, 3), (4, 4)]
+
+
+def _build_ring_mask(shape, marker_rc, extent_r, extent_c, gap_axis):
+    h, w = shape
+    mr, mc = marker_rc
+    r0 = mr - extent_r
+    r1 = mr + 1 + extent_r
+    c0 = mc - extent_c
+    c1 = mc + 1 + extent_c
+    mask = np.zeros((h, w), dtype=bool)
