+    dr, dc = SIDE_TO_DIR[active_side]
+
+    for r, c in openings[active_side]:
+        rr = r + dr
+        cc = c + dc
+        while 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1] and out[rr, cc] == BG:
+            out[rr, cc] = YELLOW
+            rr += dr
+            cc += dc
+
+    return out
+
+
+_EXTENTS = [(3, 3), (3, 4), (4, 3), (4, 4), (3, 5), (5, 3), (4, 5), (5, 4)]
+_QUADRANTS = {
+    ("top", "left"): lambda rr, cc, mr, mc: rr < mr and cc < mc,
+    ("top", "right"): lambda rr, cc, mr, mc: rr < mr and cc > mc + 1,
+    ("bottom", "left"): lambda rr, cc, mr, mc: rr > mr + 1 and cc < mc,
+    ("bottom", "right"): lambda rr, cc, mr, mc: rr > mr + 1 and cc > mc + 1,
+}
+
+
+def _build_ring_mask(shape, marker_rc, extent_r, extent_c, gap_axis):
+    h, w = shape
+    mr, mc = marker_rc
+    r0 = mr - extent_r
+    r1 = mr + 1 + extent_r
+    c0 = mc - extent_c
+    c1 = mc + 1 + extent_c
+    mask = np.zeros((h, w), dtype=bool)
+    if gap_axis == "tb":
+        mask[r0 : r1 + 1, c0] = True
+        mask[r0 : r1 + 1, c1] = True
+        mask[r0, c0 : c1 + 1] = True
+        mask[r1, c0 : c1 + 1] = True
+        mask[r0, mc : mc + 2] = False
+        mask[r1, mc : mc + 2] = False
+    else:
+        mask[r0, c0 : c1 + 1] = True
+        mask[r1, c0 : c1 + 1] = True
+        mask[r0 : r1 + 1, c0] = True
+        mask[r0 : r1 + 1, c1] = True
+        mask[mr : mr + 2, c0] = False
+        mask[mr : mr + 2, c1] = False
+    return mask
+
+
+def _extract_quadrant_fragment(full_mask: np.ndarray, marker_rc, quadrant):
+    mr, mc = marker_rc
+    selector = _QUADRANTS[quadrant]
+    frag = np.zeros_like(full_mask, dtype=bool)
+    for r, c in np.argwhere(full_mask):
+        r = int(r)
+        c = int(c)
+        if selector(r, c, mr, mc):
+            frag[r, c] = True
+    return frag
+
+
