+        elif sector == ("top", "right"):
+            frag[rt, mc + 2 : cr + 1] = True
+            frag[rt : mr + 1, cr] = True
+        elif sector == ("bottom", "left"):
+            frag[rb, cl:mc] = True
+            frag[mr + 1 : rb + 1, cl] = True
+        else:
+            frag[rb, mc + 2 : cr + 1] = True
+            frag[mr + 1 : rb + 1, cr] = True
+    else:
+        if sector == ("top", "left"):
+            frag[rt:mr, cl] = True
+            frag[rt, cl : mc + 1] = True
+        elif sector == ("top", "right"):
+            frag[rt:mr, cr] = True
+            frag[rt, mc + 1 : cr + 1] = True
