+        return False
+    if not np.any(out[r0 : r1 + 1, c0 : c1 + 1] == YELLOW):
+        return False
+
+    dr, dc = SIDE_TO_DIR[intended_side]
+    has_external_ray = False
+    for r, c in openings[intended_side]:
+        rr = r + dr
+        cc = c + dc
+        while 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+            if out[rr, cc] == YELLOW:
+                has_external_ray = True
+                break
+            if out[rr, cc] != BG:
+                break
+            rr += dr
+            cc += dc
+        if has_external_ray:
