  "type": "move_along_path",
  "src": "yellow line on edge",
  "path": "straight line",
  "trajectory": "YYGYYG...",
  "dst": "the opposite edge",
  "type2": "move_in_order",
  "src2": "green line",
  "path2": "foreground pixels in the same row/col",
  "trajectory2": "intermittent",
  "dst2": "no more fg pixels ahead"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 25-30 rows × 22-30 cols
  colors:
    bg: any color not in {3, 4}, must be most common in grid
    fg: single color, not in {3, 4, bg}
  yellow_segment:
    color: 4
    edge: top, bottom, left, or right border
    length: 3-8 cells
    position: ≥1 cell from nearest grid corner on the edge
  foreground_blobs:
    count: 5-9 connected components (4-connectivity)
    per-blob pixels: 5-70
    shape: amorphous (not_symmetric)
    placement: ≥1 cell from all grid edges, mutual padding ≥1
    not on yellow segment's edge row/col [observed]
  transformation:
    march from yellow segment toward opposite edge, stride 2
    color cycle per stripe: Y(4), Y(4), G(3), repeating
    Y-stripes: paint only within segment's column/row span
    G-stripes: recolor all non-bg pixels on full row/col to green(3), plus paint span
    1-cell gap between stripes cleared to bg within span

generation_strategy:
  approach: input-first — construct input directly, verify with main()
  steps:
    1. Sample H∈[25,30], W∈[22,30]
    2. Sample bg, fg from {0..9}\{3,4}, bg≠fg
    3. Sample edge ∈ {top,bottom,left,right} and segment length ∈ [3,8]
    4. Compute valid start position on edge (≥1 from corner, segment fits within edge)
    5. Fill H×W grid with bg, paint yellow segment on chosen edge
    6. Scatter 5-9 amorphous fg blobs via random_sprite (bbox 2-10 per dim, density 0.4-0.85)
    7. Place blobs with border=1, padding=1; skip any whose pixels land on segment's edge row/col
    8. Verify ≥5 blobs placed and bg remains most common color
    9. Oracle check: main(input) runs without error
```
