+                "bbox": comp["bbox"],
+                "center_color": int(comp["color"]),
+                "marker_colors": marker_colors,
+                "uniform": len(set(marker_colors)) == 1,
+                "marker_color": marker_colors[0],
+            }
+        )
+    return statuses
+
