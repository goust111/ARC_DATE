+    best: List[dict] | None = None
+
+    def dfs(remaining: set[Coord], chosen: List[int]) -> None:
+        nonlocal best
+        if not remaining:
+            if best is None or len(chosen) < len(best):
+                best = [candidates[i] for i in chosen]
+            return
+        if best is not None and len(chosen) >= len(best):
