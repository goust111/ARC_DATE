+            )
+    return options
+
+
+def _overlay_marker(grid: np.ndarray, boxes: Dict[str, BBox], placement: dict) -> dict:
+    center = _placement_center(boxes, placement)
+    stem, diag1, diag2 = _marker_cells(center, placement["direction"])
+    for r, c in (stem, diag1, diag2):
