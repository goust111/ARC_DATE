+Coord = Tuple[int, int]
+BBox = Tuple[int, int, int, int]
+
+BLUE = 1
+PALETTE = (1, 2, 3, 4)
+NON_BLUE = (2, 3, 4)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+HALF_REGIONS = ("lt", "lb", "c", "rt", "rb")
+HALF_EDGES = ((0, 1), (0, 2), (1, 2), (2, 3), (2, 4), (3, 4))
