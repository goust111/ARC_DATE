+def _marker_cells(center: Coord, direction: Coord) -> Tuple[Coord, Coord, Coord]:
+    r, c = center
+    (p1r, p1c), (p2r, p2c) = _perpendiculars(direction)
+    dr, dc = direction
+    stem = (r + dr, c + dc)
+    diag1 = (r - dr + p1r, c - dc + p1c)
+    diag2 = (r - dr + p2r, c - dc + p2c)
+    return stem, diag1, diag2
+
