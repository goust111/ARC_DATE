+def _label_mask(mask: np.ndarray) -> Tuple[np.ndarray, List[List[Coord]]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    components: List[List[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] >= 0:
+                continue
+            cid = len(components)
+            q = deque([(r, c)])
+            labels[r, c] = cid
+            cells: List[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
