+    return {"center": center, "direction": placement["direction"], "cells": {stem, diag1, diag2}}
+
+
+def _assemble_case() -> Tuple[np.ndarray, dict]:
+    for _ in range(400):
+        height = random.choice([12, 14, 16, 18])
+        width = random.randint(12, 18)
+        half_h = height // 2
+        widths = _random_partition(width, 3, 3)
