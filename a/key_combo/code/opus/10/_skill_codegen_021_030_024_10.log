+    if direction == (1, 0):
+        c = random.randint(max(sc0, tc0) + 1, min(sc1, tc1) - 1)
+        return sr1, c
+    c = random.randint(max(sc0, tc0) + 1, min(sc1, tc1) - 1)
+    return sr0, c
