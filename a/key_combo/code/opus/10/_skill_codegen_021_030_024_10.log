+def _placement_center(boxes: Dict[str, BBox], placement: dict) -> Coord:
+    source = placement["source"]
+    target = placement["target"]
+    direction = placement["direction"]
+    sr0, sc0, sr1, sc1 = boxes[source]
+    tr0, tc0, tr1, tc1 = boxes[target]
