+            if sc1 + 1 != tc0 or sc1 - sc0 + 1 < 3 or tc1 - tc0 + 1 < 2:
+                return
+            lo, hi = max(sr0, tr0) + 1, min(sr1, tr1) - 1
+            if lo > hi:
+                return
+        elif direction == (0, -1):
