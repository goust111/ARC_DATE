+
+    add("lt", "c", (0, 1))
+    add("c", "lt", (0, -1))
+    add("lb", "c", (0, 1))
+    add("c", "lb", (0, -1))
+    add("c", "rt", (0, 1))
+    add("rt", "c", (0, -1))
+    add("c", "rb", (0, 1))
+    add("rb", "c", (0, -1))
+    add("lt", "lb", (1, 0))
+    add("lb", "lt", (-1, 0))
+    add("rt", "rb", (1, 0))
+    add("rb", "rt", (-1, 0))
+    return placements
