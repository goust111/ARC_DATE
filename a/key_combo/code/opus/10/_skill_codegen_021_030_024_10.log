+    mid = recolored.shape[0] // 2
+    top_color = _dominant_detail(recolored[:mid, :])["color"]
+    bottom_color = _dominant_detail(recolored[mid:, :])["color"]
+    return _draw_split_border(recolored, top_color, bottom_color)
