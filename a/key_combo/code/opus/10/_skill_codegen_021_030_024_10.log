+            lo, hi = max(sr0, tr0) + 1, min(sr1, tr1) - 1
+            if lo > hi:
+                return
+        elif direction == (1, 0):
+            if sr1 + 1 != tr0 or sr1 - sr0 + 1 < 3 or tr1 - tr0 + 1 < 2:
+                return
+            lo, hi = max(sc0, tc0) + 1, min(sc1, tc1) - 1
+            if lo > hi:
+                return
+        else:
+            if tr1 + 1 != sr0 or sr1 - sr0 + 1 < 3 or tr1 - tr0 + 1 < 2:
+                return
+            lo, hi = max(sc0, tc0) + 1, min(sc1, tc1) - 1
+            if lo > hi:
