+            out[teal_r, c] = TEAL
+    for r in range(height):
+        if not _is_corner(r, teal_c, height, width) and out[r, teal_c] != ORANGE:
+            out[r, teal_c] = TEAL
+
+    for r, c in ((orange_r, teal_c), (teal_r, orange_c)):
