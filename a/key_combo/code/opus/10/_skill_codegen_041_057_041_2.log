+    if side == "top":
+        max_r = min(panel_h - patch_h, patch_h // 2 - 1)
+        return range(0, max_r + 1), range(0, panel_w - patch_w + 1)
+    if side == "bottom":
+        min_r = max(0, panel_h - patch_h - (patch_h // 2 - 1))
+        return range(min_r, panel_h - patch_h + 1), range(0, panel_w - patch_w + 1)
