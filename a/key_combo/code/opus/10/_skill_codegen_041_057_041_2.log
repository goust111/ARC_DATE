+def _remnant_mask(outline: np.ndarray, side: str) -> np.ndarray:
+    h, w = outline.shape
+    if side == "left":
+        return outline[:, : w // 2 + 1]
+    if side == "right":
+        return outline[:, w // 2 :]
+    if side == "top":
