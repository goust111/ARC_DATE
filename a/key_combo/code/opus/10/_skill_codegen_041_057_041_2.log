+        else:
+            w = random.randint(5, 7)
+            h = random.choice((5, 7))
+            max_indent = (h - 3) // 2
+            indents = [random.randint(0, max_indent)]
+            for _col in range(1, w):
+                prev = indents[-1]
+                lo = max(0, prev - 1)
+                hi = min(max_indent, prev + 1)
