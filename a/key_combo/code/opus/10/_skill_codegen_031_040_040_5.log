+    assert np.all(g[:PATTERN_SIZE, :PATTERN_SIZE][mask == 0] == BLACK), "pattern uses only blue on black"
+    fg_count = int(mask.sum())
+    assert MIN_FOREGROUND <= fg_count <= MAX_FOREGROUND, "foreground count must stay within 2..7"
