+    marker_row = int(np.flatnonzero(grid[:, -1] == RED)[0])
+    mask = (grid[:PATTERN_SIZE, :PATTERN_SIZE] == BLUE).astype(int)
+    out = _output_from_mask(mask, marker_row)
+    scale = marker_row + 1
+    tile = _resize_nn(1 - mask, scale).astype(int)
