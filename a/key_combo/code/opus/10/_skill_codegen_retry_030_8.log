+        for step in (-1, 1):
+            c = mid + step
+            while 0 <= c < w:
+                if (r, c) in ghost_blockers:
+                    break
+                if not claimed[r, c]:
+                    out[r, c] = color
+                    claimed[r, c] = True
+                c += step
+
+    return out
+
