+            base[merge] = BG
+    elif k == 2:
+        branch = rng.random()
+        if branch < 0.34:
+            base = _lattice(1, 2)
+        elif branch < 0.68:
+            base = _lattice(2, 1)
+        else:
+            base = _lattice(2, 2)
+            if rng.random() < 0.5:
+                opened = rng.sample(range(4), 2)
+                for chamber in opened:
+                    opening = rng.choice(_full_2x2_opening_options()[chamber])
+                    base[opening] = BG
+            else:
