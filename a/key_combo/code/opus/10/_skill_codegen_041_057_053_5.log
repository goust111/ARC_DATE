+def _lattice(cell_rows: int, cell_cols: int) -> np.ndarray:
+    grid = np.ones((2 * cell_rows + 1, 2 * cell_cols + 1), dtype=int)
+    grid[1::2, 1::2] = BG
+    return grid
+
