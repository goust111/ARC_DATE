+    return [
+        [(0, 1), (1, 0)],
+        [(0, 3), (1, 4)],
+        [(4, 1), (3, 0)],
+        [(4, 3), (3, 4)],
+    ]
+
+
+def _full_2x2_merge_options() -> list[tuple[int, int]]:
+    return [(1, 2), (2, 1), (2, 3), (3, 2)]
