+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+FG_COLORS = (1, 4, 5, 6, 7, 8, 9)
+GEN_RETRIES = 400
+_GEN_CALL_COUNT = 0
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
