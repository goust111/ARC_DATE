+            assert np.all(block == fill)
+
+    assert red_components == expected_k
+    assert np.all(out[0, :] != BG)
+    assert np.all(out[-1, :] != BG)
+    assert np.all(out[:, 0] != BG)
+    assert np.all(out[:, -1] != BG)
+
