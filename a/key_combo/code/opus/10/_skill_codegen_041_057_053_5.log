+                base[merge] = BG
+                chamber = rng.randrange(4)
+                opening = rng.choice(_full_2x2_opening_options()[chamber])
+                base[opening] = BG
+    else:
+        raise ValueError(f"unsupported hole count {k}")
+
+    embedded = _embed_with_margin(base, rng)
+    return _rotate_and_flip(embedded, rng)
+
