+def _embed_with_margin(base: np.ndarray, rng: random.Random) -> np.ndarray:
+    bh, bw = base.shape
+    total_pad_h = rng.randint(2, 7 - bh)
+    total_pad_w = rng.randint(2, 7 - bw)
