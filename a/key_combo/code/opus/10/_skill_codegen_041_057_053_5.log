+    out = np.array(grid, copy=True)
+    out = np.rot90(out, rng.randrange(4))
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    if rng.random() < 0.5:
+        out = np.flipud(out)
+    return np.asarray(out, dtype=int)
+
+
+def _build_binary_pattern(k: int, rng: random.Random) -> np.ndarray:
+    if k == 4:
+        base = _lattice(2, 2)
+    elif k == 3:
+        base = _lattice(2, 2)
