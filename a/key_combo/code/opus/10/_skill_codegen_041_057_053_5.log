+def _full_2x2_opening_options() -> list[list[tuple[int, int]]]:
+    return [
+        [(0, 1), (1, 0)],
+        [(0, 3), (1, 4)],
+        [(4, 1), (3, 0)],
+        [(4, 3), (3, 4)],
