+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[Coord] = []
+            while q:
