+        if any(not (1 <= comp["area"] <= 3) for comp in comps):
+            return None
+        merged = _merged_fragment_groups(comps)
+        if len(merged) != 1:
+            return None
+
+    if not _explicit_semantic_checks(inp, order, bboxes, witness_cells):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_TRIES):
