+        options.append(("horizontal", [(r, cc) for cc in range(c + 1, c0)]))
+    if c > c1 and r0 <= r <= r1:
+        options.append(("horizontal", [(r, cc) for cc in range(c1 + 1, c)]))
+    if r < r0 and c0 <= c <= c1:
+        options.append(("vertical", [(rr, c) for rr in range(r + 1, r0)]))
+    if r > r1 and c0 <= c <= c1:
