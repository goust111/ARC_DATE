+
+def _corner_specs(rect: tuple[int, int, int, int]) -> list[dict]:
+    r0, c0, r1, c1 = rect
+    return [
+        {
+            "name": "top_left",
+            "cross": (r0 - 1, c0 - 1),
+            "horizontal_side": "left",
+            "vertical_side": "top",
+        },
+        {
+            "name": "top_right",
+            "cross": (r0 - 1, c1 + 1),
+            "horizontal_side": "right",
+            "vertical_side": "top",
+        },
+        {
+            "name": "bottom_left",
+            "cross": (r1 + 1, c0 - 1),
+            "horizontal_side": "left",
+            "vertical_side": "bottom",
+        },
+        {
+            "name": "bottom_right",
+            "cross": (r1 + 1, c1 + 1),
+            "horizontal_side": "right",
+            "vertical_side": "bottom",
+        },
