+from __future__ import annotations
+
+import numpy as np
+
+
+LEFT_PANEL = 1
+RIGHT_PANEL = 2
+MARKER_COLORS = (3, 4, 6, 7)
+GREY = 5
+GUIDE = 8
+
+GEN_ATTEMPTS = 600
+HEIGHT_RANGE = (15, 22)
+WIDTH_CHOICES = (15, 17, 19, 21)
+RECT_SIZE_CHOICES = (3, 4, 5)
+MARKER_COUNT_CHOICES = (3, 4)
