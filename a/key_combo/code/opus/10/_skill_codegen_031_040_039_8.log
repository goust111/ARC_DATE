+    for c in range(c0 - 1, c1 + 2):
+        if not (0 <= c < width):
+            continue
+        for r in range(1, r0 - 1):
+            if _line_cells_for_candidate(rect, (r, c)) is not None:
+                positions["top"].append((r, c))
+        for r in range(r1 + 2, height - 1):
+            if _line_cells_for_candidate(rect, (r, c)) is not None:
+                positions["bottom"].append((r, c))
