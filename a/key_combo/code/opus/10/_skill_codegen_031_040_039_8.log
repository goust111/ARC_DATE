+    if result is None:
+        return None
+    orientation, raw_path = result
+    if any(int(grid[cell]) not in {LEFT_PANEL, RIGHT_PANEL} for cell in raw_path):
+        return None
+    return {
+        "coord": coord,
+        "orientation": orientation,
+        "path": raw_path,
+        "panel": "left" if coord[1] < divider_col else "right",
