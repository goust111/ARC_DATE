+
+def _line_cells_for_candidate(
+    rect: tuple[int, int, int, int], coord: tuple[int, int]
+) -> tuple[str, list[tuple[int, int]]] | None:
+    options = _path_options(coord, rect)
+    if len(options) != 1 or not options[0][1]:
