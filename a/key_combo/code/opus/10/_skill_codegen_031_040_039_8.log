            y1 = 0 if Y == 0 else vertical_endpoints[Y-1]
            y2 = vertical_endpoints[Y] if Y < len(vertical_endpoints) else sprite_h

            sprite[x1:x2, y1:y2] = colors[X, Y]
    
    # Randomly place the sprite in the grid
