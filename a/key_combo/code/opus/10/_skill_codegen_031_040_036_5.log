+    return out
+
+
+def _paint_shape(grid: np.ndarray, shape: tuple[tuple[int, int], ...], top: int, left: int, color: int) -> list[tuple[int, int]]:
+    coords = [(top + r, left + c) for r, c in shape]
+    for r, c in coords:
+        grid[r, c] = int(color)
