+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+BASE_SHAPES = [
+    ((0, 0), (1, 0), (1, 1)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (0, 1), (1, 1), (2, 1)),
+    ((0, 1), (0, 2), (1, 0), (1, 1)),
+    ((0, 0), (0, 1), (1, 1), (2, 1), (2, 2)),
+    ((0, 0), (1, 0), (1, 1), (2, 1), (2, 2)),
