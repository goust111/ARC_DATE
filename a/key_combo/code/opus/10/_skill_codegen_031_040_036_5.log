+def _dilate_mask(shape: tuple[int, int], coords: list[tuple[int, int]], pad: int = 1) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in coords:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    mask[rr, cc] = True
