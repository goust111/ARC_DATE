+    h, w = blocked.shape
+    sh, sw = _shape_dims(shape_key)
+    axis_col = axis_cols[axis_idx]
+    candidates = []
+    for top in range(h - sh + 1):
+        for left in range(w - sw + 1):
+            if side == "left" and left + sw - 1 >= axis_col:
+                continue
+            if side == "right" and left <= axis_col:
