+
+
+def _reserve(blocked: np.ndarray, coords: list[tuple[int, int]]) -> None:
+    blocked |= _dilate_mask(blocked.shape, coords, 1)
+
+
+def _make_instance() -> tuple[np.ndarray, dict]:
+    for _ in range(500):
+        h = random.randint(15, 22)
+        w = random.randint(18, 26)
