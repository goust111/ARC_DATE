+def _random_shape_choice() -> tuple[int, tuple[tuple[int, int], ...]]:
+    base_idx = random.randrange(len(SHAPE_VARIANTS))
+    return base_idx, random.choice(SHAPE_VARIANTS[base_idx])
+
