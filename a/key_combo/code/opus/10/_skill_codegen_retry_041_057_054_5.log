+        r0 = random.randint(candidate_floor, r0_max)
+        color = int(colors[idx])
+        _paint_mask(grid, option["mask"], r0, c0, color)
+        if option["branch"] == "match":
+            planned_matches.add(color)
+
+    if _candidates_touch(grid, colors):
