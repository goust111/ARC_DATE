+BLACK = 0
+BLUE = 1
+RED = 2
+CANDIDATE_COLORS = (3, 4, 6, 7, 8)
+
+MAX_ATTEMPTS = 400
+GRID_H_RANGE = (16, 23)
+GRID_W_RANGE = (18, 25)
+BAND_HEIGHTS = (4, 5)
+POCKET_COUNT_RANGE = (2, 4)
