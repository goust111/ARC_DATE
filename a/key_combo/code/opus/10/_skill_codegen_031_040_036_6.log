+        (r, width - 1 - c),
+        (height - 1 - r, c),
+        (height - 1 - r, width - 1 - c),
+    ]
+    orbit: list[Coord] = []
+    seen: set[Coord] = set()
+    for coord in candidates:
+        if coord not in seen:
+            seen.add(coord)
+            orbit.append(coord)
+    return tuple(orbit)
+
+
+def _reflection_orbits(shape: tuple[int, int]) -> list[Orbit]:
+    height, width = map(int, shape)
+    seen: set[frozenset[Coord]] = set()
+    orbits: list[Orbit] = []
+    for r in range(height):
+        for c in range(width):
+            orbit = _orbit_members(shape, r, c)
+            key = frozenset(orbit)
+            if key in seen:
+                continue
+            seen.add(key)
+            orbits.append(orbit)
+    return orbits
+
+
+def _candidate_markers(grid: np.ndarray, orbits: list[Orbit]) -> list[int]:
+    colors = sorted({int(value) for value in grid.flatten()})
+    candidates: list[int] = []
+    for color in colors:
