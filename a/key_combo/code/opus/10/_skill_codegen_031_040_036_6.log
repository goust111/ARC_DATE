+    choices: list[list[int]] = []
+    if len(spiral_idxs) == 1:
+        choices.extend([spiral_idxs, off_idxs])
+    else:
+        choices.extend([spiral_idxs, off_idxs])
+    return random.choice(random.choice(choices))
