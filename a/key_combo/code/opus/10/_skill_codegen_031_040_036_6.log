+    height, width = map(int, shape)
+    mask = np.zeros((height, width), dtype=bool)
+    r = c = 0
+    dr, dc = 0, 1
+    mask[r, c] = True
+
+    while True:
+        nr, nc = r + dr, c + dc
+        if not (0 <= nr < height and 0 <= nc < width):
+            dr, dc = _turn_clockwise(dr, dc)
+            continue
+        if mask[nr, nc]:
+            break
+
+        ar, ac = r + 2 * dr, c + 2 * dc
+        if 0 <= ar < height and 0 <= ac < width and mask[ar, ac]:
+            dr, dc = _turn_clockwise(dr, dc)
+            continue
