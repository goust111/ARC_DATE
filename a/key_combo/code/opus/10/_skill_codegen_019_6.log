+    grid = np.full((height, width), BLACK, dtype=int)
+    grid[r0 : r1 + 1, c0 : c1 + 1] = GREY
+    for quad, color in marker_colors.items():
+        mr, mc = _marker_positions(r0, c0, r1, c1)[quad]
+        grid[mr, mc] = color
+    for r, c in controls:
+        grid[r, c] = ORANGE
+    return grid
+
