+def _tile_alternating_reflections(grid: np.ndarray) -> np.ndarray:
+    middle = np.concatenate((np.fliplr(grid), grid), axis=1)
+    flipped = np.flipud(middle)
+    return np.concatenate((flipped, middle, flipped), axis=0)
