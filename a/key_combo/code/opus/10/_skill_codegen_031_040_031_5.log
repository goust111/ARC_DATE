+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+PALETTE = np.array([1, 2, 4, 5, 6, 7, 8, 9], dtype=int)
+HEIGHT_CHOICES = tuple(range(3, 11))  # 3 * H <= 30
+WIDTH_CHOICES = tuple(range(3, 9))  # 2 * W <= 30
+GENERATION_RETRIES = 400
