    if missing:
        return None
    return out, dominoes


def _gen_mark_blocked_top(
    blocked: np.ndarray, cells: tuple[tuple[int, int], ...]
) -> None:
    H, W = blocked.shape
    for r, c in cells:
        for dr, dc in _GEN_BLOCK_OFFSETS:
            rr, cc = r + dr, c + dc
            if 0 <= rr < H and 0 <= cc < W:
