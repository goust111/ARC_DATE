+    inp[:n, :] = top_input
+    inp[n, :] = DIVIDER
+    inp[n + 1 :, :] = bottom_input
+    return inp, expected, expected_top, cross_conflicts, inner_conflicts
+
+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    n = random.randint(6, 9)
+    k = random.choice((2, 3))
