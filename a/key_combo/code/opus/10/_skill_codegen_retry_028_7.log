+def _overlay_panels(top: np.ndarray, bottom: np.ndarray, angles: dict[int, int]) -> np.ndarray:
+    assert top.shape == bottom.shape
+    out = np.zeros_like(top)
+    h, w = top.shape
+    for r in range(h):
+        for c in range(w):
