+
+def _board_layer_valid(mask: np.ndarray) -> bool:
+    if int(mask.sum()) < 4:
+        return False
+    if np.any(mask[0, :]) or np.any(mask[-1, :]) or np.any(mask[:, 0]) or np.any(mask[:, -1]):
+        return False
