+            if panel is bottom and any(top_board[r, c] or top[r, c] for r, c in coords):
+                continue
+            for r, c in coords:
+                panel[r, c] = color
+            occ |= coords
+            placed = True
+            break
+        if not placed:
+            return None
+    return top, bottom
+
