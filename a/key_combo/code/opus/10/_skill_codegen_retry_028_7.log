+
+def _candidate_cue_shapes(n: int, size: int, *, allow_bottom: bool) -> list[set[tuple[int, int]]]:
+    out: list[set[tuple[int, int]]] = []
+    if size == 1:
+        for r in range(n):
+            out.append({(r, n - 1)})
+        if allow_bottom:
+            for c in range(n):
+                out.append({(n - 1, c)})
+    elif size == 2:
+        for r in range(n - 1):
+            out.append({(r, n - 1), (r + 1, n - 1)})
+        for c in range(n - 1):
+            out.append({(c, n - 2), (c, n - 1)})
+        if allow_bottom:
