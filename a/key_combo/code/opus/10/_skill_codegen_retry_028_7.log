+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _mono_components(grid: np.ndarray, colors: set[int] | None = None) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            if colors is not None and color not in colors:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "area": int(len(coords)),
+                    "touch_right": bool(np.any(arr[:, 1] == w - 1)),
+                    "touch_bottom": bool(np.any(arr[:, 0] == h - 1)),
+                }
+            )
+    return comps
+
+
+def _component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+    return count
+
+
+def _extract_cues(panel: np.ndarray, *, allow_bottom: bool) -> tuple[dict[int, int], np.ndarray]:
+    stripped = panel.copy()
+    cues: dict[int, int] = {}
+    for comp in _mono_components(panel):
+        is_cue = comp["area"] <= 3 and (comp["touch_right"] or (allow_bottom and comp["touch_bottom"]))
+        if not is_cue:
+            continue
+        color = int(comp["color"])
+        assert color not in cues, f"duplicate cue color {color}"
+        cues[color] = int(comp["area"])
+        rr, cc = comp["coords"].T
+        stripped[rr, cc] = BG
+    return cues, stripped
