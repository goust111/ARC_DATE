+
+def _same_panel_conflicts(resolved_source: dict[int, np.ndarray]) -> int:
+    acc = np.zeros(next(iter(resolved_source.values())).shape, dtype=int)
+    for mask in resolved_source.values():
+        acc += mask.astype(int)
+    return int(np.count_nonzero(acc > 1))
