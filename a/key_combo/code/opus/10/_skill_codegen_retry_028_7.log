+
+def _inverse_rotate_masks(rotated: dict[int, np.ndarray], angles: dict[int, int]) -> dict[int, np.ndarray]:
+    return {
+        color: np.rot90(mask, int(angles[color]) % 4)
+        for color, mask in rotated.items()
