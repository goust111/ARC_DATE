+            b = int(bottom[r, c])
+            if a == BG:
+                out[r, c] = b
+            elif b == BG:
+                out[r, c] = a
+            else:
+                aa = int(angles.get(a, 0)) % 4
+                bb = int(angles.get(b, 0)) % 4
+                out[r, c] = a if aa >= bb else b
