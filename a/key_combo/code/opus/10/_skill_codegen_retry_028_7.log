+    top_cues, top_board = _extract_cues(top, allow_bottom=False)
+    bottom_cues, bottom_board = _extract_cues(bottom, allow_bottom=True)
+    cue_sizes = dict(top_cues)
+    for color, size in bottom_cues.items():
+        if color in cue_sizes:
