+
+    top_input = top_board.copy()
+    bottom_input = bottom_board.copy()
+    top_input[top_cues != BG] = top_cues[top_cues != BG]
+    bottom_input[bottom_cues != BG] = bottom_cues[bottom_cues != BG]
