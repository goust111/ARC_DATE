+def _nonoverlap_panel(masks: dict[int, np.ndarray]) -> bool:
+    acc = np.zeros(next(iter(masks.values())).shape, dtype=int)
+    for mask in masks.values():
+        acc += mask.astype(int)
+    return bool(np.max(acc) <= 1)
