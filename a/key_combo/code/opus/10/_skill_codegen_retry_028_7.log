+                    frontier.append((nr, nc))
+        assert frontier
+        frontier.sort(key=lambda rc: abs(rc[0] - center) + abs(rc[1] - center))
+        pick = frontier[random.randrange(min(len(frontier), 6))]
+        cells.add(pick)
+    mask = np.zeros((n, n), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
