+    else:
+        for r in range(n - 2):
+            out.append({(r, n - 1), (r + 1, n - 1), (r + 2, n - 1)})
+        for r in range(n - 1):
+            out.append({(r, n - 1), (r + 1, n - 1), (r + 1, n - 2)})
+        for r in range(n - 1):
