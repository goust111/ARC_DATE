+                if 1 <= nr < mask.shape[0] - 1 and 1 <= nc < mask.shape[1] - 1 and not mask[nr, nc]:
+                    off.append((nr, nc))
+        if off:
+            nr, nc = random.choice(off)
+            mask[nr, nc] = True
+            rr, cc = random.choice(on)
