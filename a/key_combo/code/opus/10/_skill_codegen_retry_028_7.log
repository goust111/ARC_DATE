+def _build_input_from_case(
+    n: int,
+    colors: list[int],
+    cue_sizes: dict[int, int],
+    rotated_top: dict[int, np.ndarray],
+    rotated_bottom: dict[int, np.ndarray],
+) -> tuple[np.ndarray, np.ndarray, np.ndarray, int, int] | None:
