+def _random_rotated_layers(n: int, colors: list[int]) -> dict[int, np.ndarray]:
+    base = _grow_connected_mask(n, random.randint(4, min(6, (n - 2) * (n - 2) - 1)))
+    layers = {colors[0]: base}
