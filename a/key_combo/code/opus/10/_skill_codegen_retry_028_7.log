+    raise AssertionError("failed to build a valid case")
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        inp, _expected = _generate_case()
+        return inp
+    raise AssertionError("failed to generate a valid input")

