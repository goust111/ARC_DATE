+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    height, width = mask.shape
+    stack = [tuple(map(int, coords[0]))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c, height, width):
+            if mask[nr, nc] and (nr, nc) not in seen:
