    segment_min, _ = _GEN_SEGMENTS_PER_BAND_RANGE
    dominant_min, dominant_max = _GEN_DOMINANT_LEN_RANGE
    if segments == segment_min:
        return np.full(_GEN_GRID_SIZE, dominant_color, dtype=int)

