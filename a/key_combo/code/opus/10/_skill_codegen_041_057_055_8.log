+
+def _sample_role_sequence(width: int, role_count: int) -> list[int]:
+    roles = list(range(role_count))
+    seq = roles[:]
+    while len(seq) < width:
+        seq.append(random.randrange(role_count))
+    random.shuffle(seq)
+    return [int(v) for v in seq]
