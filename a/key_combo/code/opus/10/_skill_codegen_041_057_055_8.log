+
+
+def _render_case() -> tuple[np.ndarray, np.ndarray]:
+    side = random.randint(*FRAME_SIDE_RANGE)
+    inner_size = side - 2
+    role_count = 3 if random.random() < 0.75 else 2
+
+    colors = list(range(1, 10))
