+    height, width = shape
+    boxes: list[tuple[int, int, int, int]] = [legend_box]
+    placements: list[tuple[int, int, int, int] | None] = [None] * len(specs)
+    order = sorted(
+        range(len(specs)),
+        key=lambda idx: (specs[idx]["inner_h"] + 2) * (specs[idx]["inner_w"] + 2),
+        reverse=True,
+    )
