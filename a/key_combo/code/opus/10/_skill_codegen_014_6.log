+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "inner_shape": (height - 2, width - 2),
+                }
+            )
+    assert frames, "expected at least one rectangular frame"
+    return frames
+
+
+def _parse_legend(
+    grid: np.ndarray,
+    bg: int,
+    frame_boxes: list[tuple[int, int, int, int]],
+) -> dict[int, np.ndarray]:
