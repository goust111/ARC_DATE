+
+def _extract_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        mask = grid == color
+        if not np.any(mask):
+            continue
