+        controls = [c0, c0, c1]
+        sizes = [size_a, size_b, size_a]
+        if random.random() < 0.5:
+            controls.append(c1)
+            sizes.append(size_b)
+    else:
+        c0, c1, c2 = marker_colors
+        controls = [c0, c0, c1, c2]
+        sizes = [size_a, size_b, size_a, random.choice((size_b, size_c))]
