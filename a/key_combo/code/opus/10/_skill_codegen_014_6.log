        grid[r0 : r1 + 1, c0] = color
        grid[r0 : r1 + 1, c1] = color

        ctrl_r = random.randint(r0 + 1, r1 - 1)
        ctrl_c = random.randint(c0 + 1, c1 - 1)
        grid[ctrl_r, ctrl_c] = spec["control_color"]
        spec["bbox"] = (r0, c0, r1, c1)
        spec["control_pos"] = (ctrl_r, ctrl_c)

