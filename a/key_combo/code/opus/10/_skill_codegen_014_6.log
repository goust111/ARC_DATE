+    for idx in order:
+        outer_h = specs[idx]["inner_h"] + 2
+        outer_w = specs[idx]["inner_w"] + 2
+        candidates = []
+        for r0 in range(height - outer_h + 1):
+            for c0 in range(width - outer_w + 1):
+                box = (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)
