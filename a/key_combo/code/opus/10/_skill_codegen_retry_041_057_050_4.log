+import random
+from collections import Counter
+
+import numpy as np
+
+
+GRID_SIZE = 9
+BG = 0
+OBSTACLE = 1
+SPIRAL = 2
+BASE_STEP_LIMIT = 4
+GEN_ATTEMPTS = 500
+MAX_COMPONENTS = 2
+MAX_COMPONENT_SIZE = 2
+MAX_SKIP = MAX_COMPONENTS * MAX_COMPONENT_SIZE
+START_POSITIONS = (
+    (0, 2),
+    (2, 0),
+    (2, 2),
+    (2, 4),
+    (4, 2),
+)
+DIRS = ((-1, 0), (0, 1), (1, 0), (0, -1))
