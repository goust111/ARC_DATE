+from __future__ import annotations
+
+import random
+from collections import deque
+from typing import Iterable
+
+import numpy as np
+
+
+BACKGROUND = 0
+SPRITE_COLOR = 5
+FRAME_COLOR_POOL = (1, 2, 3, 4)
+MAX_GENERATION_ATTEMPTS = 400
