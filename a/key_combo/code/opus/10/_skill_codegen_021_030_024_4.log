+        sprite_mask[gray_comp[:, 0], gray_comp[:, 1]] = 1
+        sprite_crop = _crop_nonzero(sprite_mask)
+
+        groups.append(
+            {
+                "color": int(color),
+                "depth": len(frame_components),
+                "outer_bbox": bboxes[-1],
+                "sprite": sprite_crop,
+            }
