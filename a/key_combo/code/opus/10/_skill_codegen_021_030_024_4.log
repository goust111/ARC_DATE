+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp = _component_from_mask(mask, (r, c))
+            seen[comp[:, 0], comp[:, 1]] = True
+            comps.append(comp)
+    return comps
