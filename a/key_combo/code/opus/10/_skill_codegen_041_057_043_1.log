+            continue
+        stack = [(rr, cc)]
+        seen.add((rr, cc))
+        cells: list[tuple[int, int]] = []
+        while stack:
+            cr, cc2 = stack.pop()
+            cells.append((cr, cc2))
+            for nr, nc in _neighbors4(cr, cc2):
+                if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == BLUE and (nr, nc) not in seen:
