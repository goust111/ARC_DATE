    if len(starts)"'!=1 or len(ends)!=1:
        return None
    start, end = starts[0], ends[0]
    # find blocks by bbox from blue comps (assume rect disjoint)
    seen=set()
    blocks=[]
    for r,c in np.argwhere(g==1):
        r=int(r); c=int(c)
        if (r,c) in seen: continue
        q=[(r,c)]; seen.add((r,c)); pts=[]
        while q:
            rr,cc=q.pop(); pts.append((rr,cc))
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=rr+dr,cc+dc
                if 0<=nr<H and 0<=nc<W and g[nr,nc]==1 and (nr,nc) not in seen:
                    seen.add((nr,nc)); q.append((nr,nc))
        rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
        r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
        holes=[(rr,cc) for rr in range(r0+1,r1) for cc in range(c0+1,c1) if g[rr,cc]==0]
        ports=[]; mp=block_ports(r0,c0,r1-r0+1,H,W)
        for side,pos in mp.items():
            if g[pos]==0 or pos in (start,end):
                ports.append(pos)
        blocks.append((holes,ports))
    passable=(g!=1)
    port_to_blocks=defaultdict(list)
    for i,(_holes,ports) in enumerate(blocks):
        for p in ports:
            port_to_blocks[p].append(i)
    caps=tuple(len(h) for h,_ in blocks)
    zero=tuple(0 for _ in blocks)
    dq=deque([((start,zero))])
    dist={(start,zero):0}
    cnt={(start,zero):1}
    parent={}
    goal_dist=None
    goals=[]
    while dq:
        pos,used=dq.popleft(); d=dist[(pos,used)]
        if goal_dist is not None and d>goal_dist: break
        if pos==end:
            goal_dist=d; goals.append((pos,used)); continue
        r,c=pos
        nbrs=[]
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and passable[nr,nc]:
                nbrs.append(((nr,nc),used))
        for bi in port_to_blocks.get(pos,[]):
            if used[bi] >= caps[bi]:
                continue
            holes,ports = blocks[bi]
            for q in ports:
                if q==pos: continue
                nu=list(used); nu[bi]+=1; nu=tuple(nu)
                nbrs.append((q,nu))
        for ns in nbrs:
            if ns not in dist:
                dist[ns]=d+1; cnt[ns]=cnt[(pos,used)]; parent[ns]=(pos,used); dq.append(ns)
            elif dist[ns]==d+1:
