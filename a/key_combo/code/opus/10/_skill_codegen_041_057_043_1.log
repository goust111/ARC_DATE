+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox
+    rm = (r0 + r1) // 2
+    cm = (c0 + c1) // 2
+    ports = []
+    for rr, cc in ((rm, c0 - 1), (rm, c1 + 1), (r0 - 1, cm), (r1 + 1, cm)):
+        if 0 <= rr < h and 0 <= cc < w and grid[rr, cc] != BLUE:
+            ports.append((rr, cc))
+    return ports
+
+
+def _find_blocks(grid: np.ndarray) -> list[dict]:
+    blocks: list[dict] = []
