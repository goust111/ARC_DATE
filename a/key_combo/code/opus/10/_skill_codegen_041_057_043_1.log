from collections import deque, defaultdict
import itertools, random, numpy as np


def ports(r,c,s,H,W):
    mid=2
    cand=[(r+mid,c-1),(r+mid,c+s),(r-1,c+mid),(r+s,c+mid)]
    return [p for p in cand if 0<=p[0]<H and 0<=p[1]<W]

def make(H,W,blocks,markers):
    g=np.zeros((H,W),dtype=int)
