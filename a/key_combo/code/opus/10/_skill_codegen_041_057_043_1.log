def side_ports(r0,c0,s,H,W):
    r1=r0+s-1; c1=c0+s-1
    ps=[]
    for c in range(c0,c1+1):
        if r0-1>=0: ps.append((r0-1,c))
        if r1+1<H: ps.append((r1+1,c))
    for r in range(r0,r1+1):
        if c0-1>=0: ps.append((r,c0-1))
        if c1+1<W: ps.append((r,c1+1))
    out=[]; seen=set()
    for p in ps:
        if p not in seen:
            seen.add(p); out.append(p)
    return out

def make(H,W,blocks,markers):
    g=np.zeros((H,W),dtype=int)
    for r,c,s,h in blocks:
        g[r:r+s,c:c+s]=1
        ints=[(rr,cc) for rr in range(r+1,r+s-1) for cc in range(c+1,c+s-1)]
        for rr,cc in ints[:h]: g[rr,cc]=0
    for r,c in markers: g[r,c]=2
    return g

def solve(g):
    H,W=g.shape
    starts=[tuple(x) for x in np.argwhere((g==2) & (np.arange(W)==0))]
    ends=[tuple(x) for x in np.argwhere((g==2) & (np.arange(W)==W-1))]
    if len(starts)"'!=1 or len(ends)!=1: return None
    start, end = starts[0], ends[0]
    seen=set(); blocks=[]
    for r,c in np.argwhere(g==1):
        r=int(r); c=int(c)
        if (r,c) in seen: continue
        q=[(r,c)]; seen.add((r,c)); pts=[]
        while q:
            rr,cc=q.pop(); pts.append((rr,cc))
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nr,nc=rr+dr,cc+dc
                if 0<=nr<H and 0<=nc<W and g[nr,nc]==1 and (nr,nc) not in seen:
                    seen.add((nr,nc)); q.append((nr,nc))
        rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
        r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
        hs=[(rr,cc) for rr in range(r0+1,r1) for cc in range(c0+1,c1) if g[rr,cc]==0]
        ps=[p for p in side_ports(r0,c0,r1-r0+1,H,W) if g[p]!=1]
        blocks.append((hs,ps))
    passable=(g!=1)
    p2b=defaultdict(list)
    for i,(_,ps) in enumerate(blocks):
        for p in ps: p2b[p].append(i)
    caps=tuple(len(h) for h,_ in blocks)
    zero=tuple(0 for _ in blocks)
    q=deque([(start,zero)])
    dist={(start,zero):0}; cnt={(start,zero):1}
    goald=None; goals=[]
    while q:
        pos,used=q.popleft(); d=dist[(pos,used)]
        if goald is not None and d>goald: break
        if pos==end:
            goald=d; goals.append((pos,used)); continue
        r,c=pos
        nbr=[]
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and passable[nr,nc]: nbr.append(((nr,nc),used))
        for bi in p2b.get(pos,[]):
            if used[bi]>=caps[bi]: continue
            for p in blocks[bi][1]:
                if p==pos: continue
                nu=list(used); nu[bi]+=1; nu=tuple(nu)
                nbr.append((p,nu))
        for ns in nbr:
            if ns not in dist:
                dist[ns]=d+1; cnt[ns]=cnt[(pos,used)]; q.append(ns)
            elif dist[ns]==d+1:
                cnt[ns]=min(2,cnt[ns]+cnt[(pos,used)])
    if goald is None: return None
    total=min(2,sum(cnt[s] for s in goals if dist[s]==goald))
    # find any goal state with max usage
    best=max((s[1] for s in goals if dist[s]==goald), key=max, default=None)
    return goald,total,best

