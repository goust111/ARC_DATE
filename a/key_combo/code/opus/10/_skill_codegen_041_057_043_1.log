        hs=[(rr,cc) for rr in range(r0+1,r1) for cc in range(c0+1,c1) if g[rr,cc]==0]
        ps=[p for p in ports(r0,c0,r1-r0+1,H,W) if g[p]!=1]
        blocks.append((hs,ps,(r0,c0,r1,c1)))
    passable=(g!=1)
    p2b=defaultdict(list)
    for i,(_,ps,_) in enumerate(blocks):
        for p in ps: p2b[p].append(i)
    caps=tuple(len(h) for h,_,_ in blocks)
    zero=tuple(0 for _ in blocks)
    q=deque([(start,zero)])
    dist={(start,zero):0}; cnt={(start,zero):1}; par={}
    goald=None; goals=[]
    while q:
        st=q.popleft(); pos,used=st; d=dist[st]
        if goald is not None and d>goald: break
