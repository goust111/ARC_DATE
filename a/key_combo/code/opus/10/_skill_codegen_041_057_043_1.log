import numpy as np
import random


def block_ports(r,c,s,H,W):
    mid = 2
    cand = {
        'left': (r+mid, c-1),
        'right': (r+mid, c+s),
        'top': (r-1, c+mid),
        'bottom': (r+s, c+mid),
    }
    return {k:v for k,v in cand.items() if 0<=v[0]<H and 0<=v[1]<W}


def make_grid(H,W,blocks,markers):
    g = np.zeros((H,W),dtype=int)
    for i,(r,c,s,holes) in enumerate(blocks):
        g[r:r+s,c:c+s]=1
        # simple holes in fixed row-major interior positions
        interior=[(rr,cc) for rr in range(r+1,r+s-1) for cc in range(c+1,c+s-1)]
        for rr,cc in interior[:holes]:
            g[rr,cc]=0
    for r,c in markers:
        g[r,c]=2
    return g


