+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+FOREGROUND_COLORS = tuple(range(1, 10))
+GEN_ATTEMPTS = 400
+HALF_HEIGHT_RANGE = (6, 12)
+WIDTH_RANGE = (14, 24)
+LANE_COUNT_CHOICES = (3, 4)
+LANE_HEIGHT_RANGE = (1, 3)
