+        if base > half_h:
+            continue
+
+        slack = half_h - base
+        extras = [0] * (lane_count + 1)
+        for _ in range(slack):
+            extras[random.randrange(lane_count + 1)] += 1
+
+        lanes: list[tuple[int, int]] = []
+        r = extras[0]
+        for i, height in enumerate(heights):
+            lanes.append((r, r + height - 1))
+            r += height
+            if i < lane_count - 1:
+                r += MIN_LANE_GAP + extras[i + 1]
+        return lanes
+    return None
