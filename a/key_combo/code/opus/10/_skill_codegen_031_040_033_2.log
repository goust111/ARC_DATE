+                    ok = False
+                    break
+                prev = random.choice(candidates)
+                intervals[idx] = prev
+            if not ok:
+                break
+
+        if not ok:
+            continue
+
+        built = [interval for interval in intervals if interval is not None]
+        assert len(built) == row_count
+        if len(set(built)) == 1 and len(set(widths)) == 1:
