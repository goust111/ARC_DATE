+    grid = np.zeros((rows, cols), dtype=int)
+    cr, cc = rows // 2, cols // 2
+    grid[cr, cc] = RED
+    top_row = cr - len(intervals) // 2
+    for offset, (start, end) in enumerate(intervals):
+        r = top_row + offset
+        grid[r, start : end + 1] = BLUE
+    return grid
+
