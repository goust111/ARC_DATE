+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+MARKER = 5
+OBJECT_COLORS = (1, 2, 3, 4, 7)
+DIMENSIONS = (
+    (2, 3),
+    (3, 2),
+    (2, 4),
+    (4, 2),
+    (2, 5),
+    (5, 2),
+    (3, 4),
+    (4, 3),
