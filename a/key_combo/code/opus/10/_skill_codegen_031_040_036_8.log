+                "r0": r0,
+                "c0": c0,
+                "h": height,
+                "w": width,
+                "k": int(np.count_nonzero(patch == MARKER)),
+                "color": int(next(iter(fill_colors))),
+            }
+        )
+    assert rects
+    return rects
+
