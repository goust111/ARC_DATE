+    kept_blocks = []
+    for rank, block in enumerate(sorted_blocks, start=1):
+        coords = block["coords"]
+        if rank % 2 == 1:
+            kept_blocks.append(block)
+        else:
+            out[coords[:, 0], coords[:, 1]] = BLACK
+
