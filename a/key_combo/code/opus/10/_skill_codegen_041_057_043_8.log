+    rebuilt, segments = _render_output_from_parsed(inp, sorted_blocks, top_marker, bottom_marker)
+    assert np.array_equal(out, rebuilt), "output must match the parsed rule"
+
+    kept_masks = set()
+    erased_masks = set()
