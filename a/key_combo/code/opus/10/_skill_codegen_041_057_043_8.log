+    bottom_offset = (2, 0, -2)[(branch_id // 3) % 3]
+    top_marker_col = int(np.clip(first_anchor + top_offset, 0, width - 1))
+    bottom_marker_col = int(np.clip(last_anchor + bottom_offset, 0, width - 1))
