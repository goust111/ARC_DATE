+    r0, c0, _r1, _c1 = map(int, block["bbox"])
+    return int(r0 + 1), int(c0 + 1)
+
+
+def _walk_vertical_then_horizontal(
+    start: tuple[int, int], end: tuple[int, int]
+) -> list[tuple[int, int]]:
+    r, c = map(int, start)
+    tr, tc = map(int, end)
+    walked: list[tuple[int, int]] = []
+
+    while r != tr:
+        r += _sign(tr - r)
+        walked.append((int(r), int(c)))
+    while c != tc:
+        c += _sign(tc - c)
+        walked.append((int(r), int(c)))
+    return walked
