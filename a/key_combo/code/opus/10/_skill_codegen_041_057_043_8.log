+    top_marker_col: int,
+    bottom_marker_col: int,
+) -> np.ndarray:
+    grid = np.full((int(height), int(width)), BLACK, dtype=int)
+    for top, left in zip(top_rows, left_cols):
+        grid[int(top) : int(top) + 2, int(left) : int(left) + 2] = GREEN
