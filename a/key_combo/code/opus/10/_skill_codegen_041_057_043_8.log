+            return None
+        anchors = []
+        for idx in range(kept_count):
+            pool = low if idx % 2 == 0 else high
+            anchors.append(int(np.random.choice(pool)))
+        return [anchor - 1 for anchor in anchors]
+
+    anchor_min = BLOCK_TOP_MIN + 1
+    anchor_max = height - 3
