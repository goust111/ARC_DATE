+def _random_polyomino(area: int, max_h: int, max_w: int) -> tuple[tuple[int, int], ...]:
+    for _ in range(200):
+        cells = {(0, 0)}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            random.shuffle(frontier)
