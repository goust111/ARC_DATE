+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BLACK:
+                continue
+            key = (r % row_period, c % col_period)
+            if key in tile and tile[key] != color:
+                return None
+            tile[key] = color
