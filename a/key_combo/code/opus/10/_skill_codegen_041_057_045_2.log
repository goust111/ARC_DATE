+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PALETTE = [BLUE, RED, GREEN, YELLOW]
+DIRECTIONS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
