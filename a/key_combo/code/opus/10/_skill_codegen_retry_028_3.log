+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_for_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    mask = grid == int(color)
+    visited = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or visited[r, c]:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not visited[nr, nc]:
+                        visited[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _ring_bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    if len(coords) < 8:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return None
+    boundary = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    pts = set(coords)
+    if pts != boundary:
+        return None
+    return r0, c0, r1, c1
+
+
+def _marker_partition(
+    marker_coords: list[tuple[int, int]],
+    seed: tuple[int, int],
+    direction: str,
+) -> tuple[int, int, int]:
+    sr, sc = seed
+    directional = 0
+    aligned_ignored = 0
+    opposite_ignored = 0
+    for r, c in marker_coords:
+        if direction == "up":
+            if r < sr:
+                directional += 1
+            elif r == sr:
+                aligned_ignored += 1
+            else:
+                opposite_ignored += 1
+        elif direction == "down":
+            if r > sr:
+                directional += 1
+            elif r == sr:
+                aligned_ignored += 1
+            else:
+                opposite_ignored += 1
+        elif direction == "left":
+            if c < sc:
+                directional += 1
+            elif c == sc:
+                aligned_ignored += 1
+            else:
+                opposite_ignored += 1
+        else:
+            if c > sc:
+                directional += 1
+            elif c == sc:
+                aligned_ignored += 1
+            else:
