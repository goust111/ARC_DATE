+        assert len({frame["frame_color"] for frame in frames}) == len(frames), "frame colors must be unique"
+        if np.any(g == GREY):
+            assert np.all(marker_cover[g == GREY] == 1), "every gray marker must belong to exactly one frame"
+    return frames
