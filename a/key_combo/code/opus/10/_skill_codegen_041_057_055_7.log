+    grid = np.zeros((h, w), dtype=int)
+    group_occ: set[tuple[int, int]] = set()
+    for group in groups:
+        for r, c in group["points"]:
+            grid[r, c] = int(group["color"])
+        group_occ |= set(group["points"])
+        group_occ |= set(group["path"])
