+def _paste_clip(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    for rr in range(h):
+        for cc in range(w):
+            dr = r0 + rr
+            dc = c0 + cc
