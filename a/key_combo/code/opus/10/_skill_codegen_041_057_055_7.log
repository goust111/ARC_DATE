+from __future__ import annotations
+
+import itertools
+import math
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLORS = (1, 2)
+RECT_COLORS = (3, 4, 5, 6, 7, 8, 9)
