+                {
+                    "color": color,
+                    "points": pts,
+                    "cells": frozenset(pts),
+                    "step": (dr1, dc1),
+                    "path": path,
+                    "length": len(path),
+                    "orientation": "h" if dr1 == 0 else "v",
+                }
+            )
+    return candidates
+
+
+def _extract_groups(grid: np.ndarray) -> list[dict]:
