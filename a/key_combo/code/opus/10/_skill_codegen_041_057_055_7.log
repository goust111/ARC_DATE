+def _enumerate_group_slots(h: int, w: int) -> list[dict]:
+    slots: list[dict] = []
+    for step in GROUP_STEPS:
+        for r in range(h):
+            for c0 in range(w - 2 * step):
+                pts = [(r, c0), (r, c0 + step), (r, c0 + 2 * step)]
+                path = []
+                cc = c0 + 3 * step
+                while cc < w:
+                    path.append((r, cc))
+                    cc += step
+                if not path:
+                    continue
+                occ = set(pts) | set(path)
+                slots.append(
+                    {
+                        "points": pts,
+                        "path": path,
+                        "length": len(path),
+                        "orientation": "h",
+                        "occupied": occ,
+                    }
+                )
+        for c in range(w):
+            for r0 in range(h - 2 * step):
+                pts = [(r0, c), (r0 + step, c), (r0 + 2 * step, c)]
+                path = []
+                rr = r0 + 3 * step
+                while rr < h:
+                    path.append((rr, c))
+                    rr += step
+                if not path:
+                    continue
+                occ = set(pts) | set(path)
+                slots.append(
