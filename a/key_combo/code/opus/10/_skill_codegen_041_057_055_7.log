+    h, w = shape
+    for r, c in list(cells):
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
+
+
+def _marker_candidates(grid: np.ndarray) -> list[dict]:
