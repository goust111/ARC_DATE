+
+def _analyze_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
+    groups = _extract_groups(g)
+    rects = _extract_rectangles(g)
+    if not (2 <= len(groups) <= 3 and 2 <= len(rects) <= 3):
