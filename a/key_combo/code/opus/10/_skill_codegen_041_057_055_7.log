+    center2 = (r0 + r1, c0 + c1)
+    dists = []
+    for idx, group in enumerate(groups):
+        best = min(abs(center2[0] - 2 * r) + abs(center2[1] - 2 * c) for r, c in group["points"])
+        dists.append((best, idx))
+    dists.sort()
+    if len(dists) > 1 and dists[0][0] == dists[1][0]:
+        raise ValueError("rectangle-governor tie")
