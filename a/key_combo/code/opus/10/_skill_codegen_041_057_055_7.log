+                out_bbox = (nr0, nc0, nr0 + rot_patch.shape[0] - 1, nc0 + rot_patch.shape[1] - 1)
+                full_in = (
+                    0 <= nr0
+                    and 0 <= nc0
+                    and nr0 + rot_patch.shape[0] <= h
+                    and nc0 + rot_patch.shape[1] <= w
+                )
+                clipped = not full_in
+                if clip_mode == "must" and not clipped:
