+        required = [0, 1] + ([int(np.random.randint(2))] if n_groups == 3 else [])
+        np.random.shuffle(required)
+        chosen: list[dict] = []
+        blocked: set[tuple[int, int]] = set()
+        for parity in required:
+            candidates = [
+                slot
+                for slot in slots
+                if slot["length"] % 2 == parity
+                and not (slot["occupied"] & blocked)
+            ]
