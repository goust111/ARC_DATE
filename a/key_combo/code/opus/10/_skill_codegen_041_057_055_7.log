+from __future__ import annotations
+
+import itertools
+import math
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLORS = (1, 2)
+RECT_COLORS = (3, 4, 5, 6, 7, 8, 9)
+RECT_DIMS = (
+    (2, 3),
+    (2, 4),
+    (2, 5),
+    (3, 4),
+    (3, 5),
+    (4, 3),
+    (4, 5),
+)
+GROUP_STEPS = (2, 3, 4)
+GEN_MAX_ATTEMPTS = 600
