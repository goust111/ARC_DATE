+                        "bbox": bbox,
+                        "out_bbox": out_bbox,
+                        "patch_shape": (int(rect_h), int(rect_w)),
+                        "clipped": clipped,
+                        "margin": margin,
+                        "best": best,
+                        "anchor_dist": anchor_dist,
+                    }
