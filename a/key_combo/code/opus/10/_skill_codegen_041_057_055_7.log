+def _centered_top_left(
+    bbox: tuple[int, int, int, int],
+    new_shape: tuple[int, int],
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    new_h, new_w = new_shape
+    nr0 = math.floor(((r0 + r1) - (new_h - 1)) / 2)
+    nc0 = math.floor(((c0 + c1) - (new_w - 1)) / 2)
+    return nr0, nc0
