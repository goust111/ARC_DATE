+    max_period = min(5, inner_size - 1)
+    for _ in range(300):
+        period = int(rng.integers(2, max_period + 1))
+        offset = int(rng.integers(0, period))
+        positions = list(range(offset, inner_size, period))
+        if 2 <= len(positions) < inner_size:
+            return positions
