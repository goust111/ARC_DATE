            return False

    visible = inner_out[inner_out != RED]
    if visible.size == 0 or len(set(map(int, visible))) < 2:
        return False
    if np.array_equal(out[0, :], np.full(out.shape[1], RED, dtype=int)) is False:
        return False
    return True


