        if h_count >= 2 and len(set(horiz)) >= 2:
            reverse_sensitive = True
        if v_count >= 2 and len(set(vert)) >= 2:
            reverse_sensitive = True
        if not reverse_sensitive:
            continue

        return areas
    return None


