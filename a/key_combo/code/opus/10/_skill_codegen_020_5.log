) -> list[int] | None:
    total = h_count + v_count
    for _ in range(200):
        areas = [_randint(rng, 3, 7) for _ in range(total)]
        colors = [AREA_TO_COLOR[a] for a in areas]
        horiz = colors[:h_count]
        vert = colors[h_count:]

        if len(set(colors)) < 3:
