+    grid[frame_r0, frame_c0 : frame_c0 + frame_side] = RED
+    grid[frame_r0 + frame_side - 1, frame_c0 : frame_c0 + frame_side] = RED
+    grid[frame_r0 : frame_r0 + frame_side, frame_c0] = RED
