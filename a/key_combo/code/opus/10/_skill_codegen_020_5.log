+def _semantic_checks(
+    inp: np.ndarray,
+    out: np.ndarray,
+    pattern: np.ndarray,
+    inner_size: int,
+    axis: str,
+    positions: list[int],
+) -> bool:
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+    if out.shape != (inner_size + 2, inner_size + 2):
+        return False
+
+    expected = _scale_sprite(pattern, inner_size // int(pattern.shape[0]))
