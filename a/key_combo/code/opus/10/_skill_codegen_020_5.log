+        for row in positions:
+            grid[frame_r0 + 1 + row, frame_c0 + 1 : frame_c0 + 1 + inner_size] = BLUE
+    else:
+        for col in positions:
+            grid[frame_r0 + 1 : frame_r0 + 1 + inner_size, frame_c0 + 1 + col] = BLUE
