+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+PATTERN_COLORS = (GREEN, YELLOW, GREY, PINK, ORANGE, TEAL, MAROON)
+PATTERN_SCALE_CHOICES = (
+    (2, 3),
+    (2, 4),
+    (3, 2),
+    (3, 3),
+    (3, 4),
+    (4, 2),
+    (4, 3),
