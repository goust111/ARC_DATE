+        stack = [(r, c)]
+        seen[r, c] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for dr, dc in neigh:
+                nr, nc = cr + dr, cc + dc
+                if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and not seen[nr, nc]:
