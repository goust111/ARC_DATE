+            if not np.all(patch[4, 1:4] == HUB_COLORS["bottom"]):
+                continue
+            if not np.all(patch[1:4, 0] == HUB_COLORS["left"]):
+                continue
+            if not np.all(patch[1:4, 4] == HUB_COLORS["right"]):
+                continue
+            score = abs((r + 2) - center[0]) + abs((c + 2) - center[1])
+            if best is None or score < best[0]:
