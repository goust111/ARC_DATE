+
+    H, W = inp.shape
+    for color, side in color_to_side.items():
+        markers = _marker_cells(side, int(marker_info[color]["index"]), H, W)
+        for r, c in markers:
+            assert int(inp[r, c]) == color
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        H = random.randint(17, 23)
+        W = random.randint(17, 23)
