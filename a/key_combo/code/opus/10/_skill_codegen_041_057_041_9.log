+        (r1, c1), (r2, c2) = coords
+        if r1 == 0 and r2 == H - 1 and c1 == c2:
+            col = int(c1)
+            assert np.all(grid[1 : H - 1, col] == bg), "vertical corridor must be unobstructed"
