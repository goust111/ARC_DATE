+    if side == "left":
+        return list(np.flatnonzero(mask[:, -1]))
+    assert side == "right"
+    return list(np.flatnonzero(mask[:, 0]))
+
+
+def _indices_are_contiguous(values: list[int]) -> bool:
+    return bool(values) and values == list(range(values[0], values[-1] + 1))
+
