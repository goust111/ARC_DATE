+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        return None
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
