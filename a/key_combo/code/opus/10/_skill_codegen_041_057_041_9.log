+def _boundary_marker_pairs(grid: np.ndarray, bg: int, hub_r: int, hub_c: int) -> dict[int, dict[str, int | str]]:
+    H, W = grid.shape
+    center_r = hub_r + 2
+    center_c = hub_c + 2
