+def _paint_hub(canvas: np.ndarray, hub_r: int, hub_c: int) -> None:
+    canvas[hub_r, hub_c + 1 : hub_c + 4] = HUB_COLORS["top"]
+    canvas[hub_r + 4, hub_c + 1 : hub_c + 4] = HUB_COLORS["bottom"]
+    canvas[hub_r + 1 : hub_r + 4, hub_c] = HUB_COLORS["left"]
