+CANONICAL_TOP_TEMPLATES = [
+    ["..#..", ".###.", "##.##", ".###."],
+    [".#.#.", "#####", ".###.", ".###."],
+    ["..#..", "#####", ".###.", ".###."],
+    [".#.", "###", ".#.", "###", "###"],
+    [".#.#.", "#####", ".###.", ".#.#.", ".###."],
