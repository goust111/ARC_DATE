+
+
+def _place_scattered_sprite(
+    canvas: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    forbidden_rows: set[int],
+    forbidden_cols: set[int],
+    occupied: set[tuple[int, int]],
+) -> None:
+    H, W = canvas.shape
+    for _ in range(400):
