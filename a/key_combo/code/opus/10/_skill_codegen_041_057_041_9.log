+        left = random.randint(1, W - mask.shape[1] - 1)
+        if not _fits(mask, top, left, H, W):
+            continue
+        coords = _patch_coords(mask, top, left)
+        if any(r in forbidden_rows or c in forbidden_cols for r, c in coords):
