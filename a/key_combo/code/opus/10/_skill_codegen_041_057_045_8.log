+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+OBSTACLE = 2
+
+GRID_RANGE = (14, 16)
+TOP_BAND_CHOICES = (3, 4, 5)
+MAX_GENERATION_ATTEMPTS = 600
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+Coord = tuple[int, int]
