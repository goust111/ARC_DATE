+        if min(b - a for a, b in zip(cols, cols[1:])) >= 2 and cols[2] - cols[0] >= 4:
+            return cols
+    return None
+
+
+def _pick_free_obstacle(shape: tuple[int, int], forbidden: set[Coord], forbidden_cols: set[int]) -> Coord | None:
+    h, w = shape
