                by_key.setdefault((2, lengths), []).append((first, second))

    choices = []
    for count in GEN_OBSTACLE_COUNTS:
        length_keys = [key for key in by_key if key[0] == count]
        if not length_keys:
            continue
        key = random.choice(length_keys)
        choices.append(random.choice(by_key[key]))
