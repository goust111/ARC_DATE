+            frontier = set()
+            for r, c in np.argwhere(mask):
+                for nr, nc in _neighbors4(int(r), int(c)):
+                    if 0 <= nr < 3 and 0 <= nc < 3 and not mask[nr, nc]:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            nr, nc = random.choice(tuple(frontier))
+            mask[nr, nc] = True
