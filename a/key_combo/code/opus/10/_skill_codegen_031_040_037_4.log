+            c0 = col_lines[ci] + 1
+            r1 = row_lines[ri + 1] - 1
+            c1 = col_lines[ci + 1] - 1
+            assert r1 - r0 == 2 and c1 - c0 == 2, "each cavity must be 3x3"
+            cavities.append(
+                {
+                    "index": (ri, ci),
+                    "bbox": (r0, c0, r1, c1),
+                    "nw_cross": (row_lines[ri], col_lines[ci]),
+                }
+            )
+    return cavities
