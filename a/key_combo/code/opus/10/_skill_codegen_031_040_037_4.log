+
+BLACK = 0
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+ROTATION_K = {
+    "up": 0,
+    "right": -1,  # 90 degrees clockwise
+    "down": 2,
+    "left": 1,    # 270 degrees clockwise
+}
+
