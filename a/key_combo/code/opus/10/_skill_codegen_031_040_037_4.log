+def _line_indices(grid: np.ndarray, axis: int) -> list[int]:
+    valid = {TEAL, YELLOW}
+    if axis == 0:
+        return [r for r in range(grid.shape[0]) if all(int(v) in valid for v in grid[r, :])]
+    return [c for c in range(grid.shape[1]) if all(int(v) in valid for v in grid[:, c])]
