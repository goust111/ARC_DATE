+
+
+def _build_lattice(margin: int) -> tuple[np.ndarray, list[int]]:
+    size = 2 * margin + 13
+    lines = [margin + 4 * i for i in range(4)]
+    grid = np.zeros((size, size), dtype=int)
+    grid[lines, :] = TEAL
+    grid[:, lines] = TEAL
