+def _cavity_bbox(lines: list[int], rc_index: tuple[int, int]) -> tuple[int, int, int, int]:
+    ri, ci = rc_index
+    return lines[ri] + 1, lines[ci] + 1, lines[ri + 1] - 1, lines[ci + 1] - 1
+
+
