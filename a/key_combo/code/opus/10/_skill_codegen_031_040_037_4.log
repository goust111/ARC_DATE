+
+    red_count = int(np.count_nonzero(sprite == RED))
+    assert 3 <= red_count <= 5, "sprite must contain 3-5 red cells"
+    assert not np.any((sprite != BLACK) & (sprite != RED)), "source cavity may only contain black and red"
+
