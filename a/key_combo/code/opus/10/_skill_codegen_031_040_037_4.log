  "type": "transform_in_place",
  "src": "non-black marker pixels at northwest corner gaps of 5x5 teal lattice tiles",
  "transform": "erase each marker; fill the 12 black pixels in the adjacent down-right cavity with marker color",
  "notes": "a teal marker is an extra teal pixel in a gap that the lattice template otherwise leaves black"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: (5N+1) x (5M+1) where N,M in 3-4; gives NxM tile cavities
  lattice:
    color: teal (8), always the most frequent color
    tile: 5x5 repeating unit with 12 lattice cells and 13 empty cells
    structure: |
      G L L L L    G=corner gap (normally black), L=lattice, C=cavity (black)
      L L C C L
      L C C C C
      L C C C C
      L L C C L
    boundary_corners: positions (5N, *) and (*, 5M) are always black (0)
  markers:
    placement: at corner-gap positions (5i, 5j) for i in 0..N-1, j in 0..M-1
    count: 1-9 markers across NxM valid positions; at least 1 unmarked tile [observed]
    color: either lattice (8) or a non-bg/non-lattice color (1-7, 9)
    distinct_non_lattice_colors: 0-3
  transform:
    rule: erase marker to black; fill the 12 cavity cells of that tile with marker color
    lattice_marker_effect: cavity becomes solid lattice color (merges visually with frame)
    unmarked_tiles: remain unchanged (cavity stays black)

generation_strategy:
  approach: output-first
  steps:
    1. Pick N in [3,4], M in [3,4]; grid = (5N+1) x (5M+1)
    2. Decide marker assignment for the NxM tile grid -- for each tile (i,j) choose empty (black=0) or a marker color; ensure >=1 marker and >=1 unmarked tile
    3. Pick 1-3 distinct non-lattice colors (from {1-7,9}); optionally include lattice-color (8) markers; assign chosen colors to marked tiles
    4. Build output: lay down full lattice template; fill each marked tile cavity with its color; all corners = 0
    5. Derive input: copy output; for each marked tile, restore cavity to black (0) and write marker color at corner gap (5i, 5j)
```
