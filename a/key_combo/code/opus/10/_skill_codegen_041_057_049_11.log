+    frame_right = width - 1
+    grid = np.full((height, width), BG, dtype=int)
+    grid[:, divider_col] = DIVIDER
+    grid[:, frame_left] = FRAME
+    grid[:, frame_right] = FRAME
+    grid[0, frame_left : frame_right + 1] = FRAME
+    grid[height - 1, frame_left : frame_right + 1] = FRAME
