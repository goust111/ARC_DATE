+    if painted_pixels < 12 or painted_pixels > (interior_h * interior_w) // 2:
+        return None
+
+    edge_targets = sum(
+        any(r in (0, interior_h - 1) for r in row_marks[color]) or any(c in (0, interior_w - 1) for c in col_marks[color])
+        for color in colors
