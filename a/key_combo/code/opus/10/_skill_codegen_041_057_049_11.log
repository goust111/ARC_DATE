+        cols = _pick_positions(interior_w, cc, used_cols, min_gap=2)
+        if rows is None or cols is None:
+            return None
+        row_marks[color] = rows
+        col_marks[color] = cols
+        used_rows.update(rows)
+        used_cols.update(cols)
