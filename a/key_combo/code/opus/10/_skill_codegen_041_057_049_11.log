+def _stamp(out: np.ndarray, patch: np.ndarray, center: tuple[int, int], color: int) -> None:
+    cr, cc = center
+    for pr, pc in np.argwhere(patch == color):
+        rr = int(cr + pr - 1)
+        cc2 = int(cc + pc - 1)
+        if 0 <= rr < out.shape[0] and 0 <= cc2 < out.shape[1]:
+            out[rr, cc2] = int(color)
+
