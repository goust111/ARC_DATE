+def _pick_sprite_tops(height: int, count: int) -> list[int] | None:
+    starts = list(range(0, height - 2))
+    for _ in range(200):
+        picks = sorted(random.sample(starts, count))
+        if all(b - a >= 4 for a, b in zip(picks, picks[1:])):
