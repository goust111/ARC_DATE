+from __future__ import annotations
+
+from itertools import product
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+A_COLORS = (1, 2)
+B_COLORS = (3, 4)
+_RNG = np.random.default_rng()
+
+GRID_ROWS_RANGE = (11, 16)  # stop-exclusive for integers()
+GRID_COLS_RANGE = (11, 16)
+MAX_ATTEMPTS = 400
