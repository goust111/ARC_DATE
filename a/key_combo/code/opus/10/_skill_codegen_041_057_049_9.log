+        b_only = int(_RNG.integers(4, 6))
+        a_only = b_only + 1
+        return branch, shared, a_only, b_only, "B"
+    if branch == "b_top_same_visible":
+        shared = int(_RNG.integers(2, 4))
+        a_only = int(_RNG.integers(3, 6))
+        b_only = a_only + int(_RNG.integers(1, 3))
+        return branch, shared, a_only, b_only, "B"
