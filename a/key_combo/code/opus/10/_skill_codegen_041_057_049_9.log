  14: def main(input_grid):
  15:     """
  16:     Recover the black occluded rectangle from a translationally symmetric pattern.
  17: 
  18:     Input structure:
  19:     - The input is a repeated color pattern with no true background color.
  20:     - A black rectangle masks part of the pattern.
  21:     - Non-black cells elsewhere reveal the translational symmetry.
  22: 
  23:     Rule:
  24:     - Treat black cells as the occlusion mask.
  25:     - Detect translational symmetries while ignoring black.
  26:     - Fill each black cell from a non-black cell in its symmetry orbit, then crop the filled rectangle.
  27: 
  28:     Key insight:
  29:     - Symmetry orbits provide equivalent unoccluded samples for each missing cell, and
  30:       the answer is only the reconstructed occluded region.
  31:     """
  32:     # Plan:
  33:     # 1. Find the black rectangle
  34:     # 2. Find the symmetry
  35:     # 3. Fill in the missing part
  36:     # 4. Extract the part that you filled in, which is the final output
  37: 
  38:     # Find the black rectangle and save where it is
  39:     # Do this first because we will need to know where it was after we fill it in
  40:     occlusion_color = Color.BLACK
  41:     black_rectangle_mask = (input_grid == occlusion_color)
  42: 
  43:     # Find the symmetry. Notice that black is not the background, but instead is the occlusion color. In fact there is no well-defined background color.
  44:     symmetries = detect_translational_symmetry(input_grid, ignore_colors=[occlusion_color], background=None)
  45: 
  46:     # Fill in the missing part
  47:     for occluded_r, occluded_c in np.argwhere(black_rectangle_mask):
  48:         for sym_r, sym_c in orbit(input_grid, int(occluded_r), int(occluded_c), symmetries):
  49:             if int(input_grid[sym_r, sym_c]) != occlusion_color:
  50:                 input_grid[int(occluded_r), int(occluded_c)] = input_grid[sym_r, sym_c]
  51:                 break
  52:     
  53:     # Extract the region that we filled in, ultimately as a 2D sprite
  54:     # first, get just the part of the final image which corresponds to what used to be included
  55:     filled_in_region = np.full_like(input_grid, occlusion_color)
  56:     filled_in_region[black_rectangle_mask] = input_grid[black_rectangle_mask]
  57:     # then, crop it to obtain the sprite
  58:     b = bbox(filled_in_region != occlusion_color)
  59:     assert b is not None
  60:     filled_in_region = crop_bbox(filled_in_region, b)
  61: 
  62:     return filled_in_region
