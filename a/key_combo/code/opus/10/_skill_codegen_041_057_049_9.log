+    for ks in product((1, 2, 3), repeat=shared_count):
+        shown_a = int(sum(ks))
+        visible_a = int(size_a - overlap + shown_a)
+        visible_b = int(size_b - shown_a)
+        if 10 * visible_a < 7 * size_a or 10 * visible_b < 7 * size_b:
