+    target_size = int(target_size)
+    if not 1 <= target_size <= len(allowed):
+        return None
+
+    ordered = sorted(allowed)
+    shape = {ordered[int(_RNG.integers(0, len(ordered)))]}
+    while len(shape) < target_size:
+        frontier = sorted(
