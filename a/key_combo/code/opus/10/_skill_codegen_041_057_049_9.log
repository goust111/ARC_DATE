+        if visible_winner == "A" and visible_a <= visible_b:
+            continue
+        if visible_winner == "B" and visible_b <= visible_a:
+            continue
+        candidates.append(tuple(int(k) for k in ks))
+    if not candidates:
+        return None
+    return candidates[int(_RNG.integers(0, len(candidates)))]
+
+
+def _paint_input(
