+
+
+def _render_layer(
+    h: int, w: int, shape: set[tuple[int, int]], color_map: dict[tuple[int, int], int]
+) -> np.ndarray:
+    layer = np.zeros((h, w), dtype=int)
+    for rep in shape:
+        color = int(color_map[rep])
+        for rr, cc in _orbit_members(h, w, rep[0], rep[1]):
