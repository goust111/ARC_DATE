+    if branch == "a_top_same_visible":
+        shared = int(_RNG.integers(2, 4))
+        b_only = int(_RNG.integers(3, 6))
+        a_only = b_only + int(_RNG.integers(1, 3))
+        return branch, shared, a_only, b_only, "A"
+    if branch == "a_top_opposite_visible":
