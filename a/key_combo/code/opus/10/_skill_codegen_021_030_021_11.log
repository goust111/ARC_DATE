+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
