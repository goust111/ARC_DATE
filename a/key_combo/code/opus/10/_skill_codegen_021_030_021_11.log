+    mid_w = sep_cols[1] - sep_cols[0] - 1
+    right_w = w - sep_cols[1] - 1
+    assert left_w == mid_w == right_w
+    pw = left_w
+    panels = [
+        g[:, :pw],
+        g[:, sep_cols[0] + 1 : sep_cols[1]],
+        g[:, sep_cols[1] + 1 :],
