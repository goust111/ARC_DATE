+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _component_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+    return count
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    r0, c0, r1, c1 = _bbox(mask)
+    cropped = mask[r0 : r1 + 1, c0 : c1 + 1]
+    h, w = cropped.shape
+    bg = ~cropped
+    seen = np.zeros_like(bg, dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            queue: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = r in (0, h - 1) or c in (0, w - 1)
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_border = True
+                        queue.append((nr, nc))
+            if not touches_border:
