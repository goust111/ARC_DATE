+    candidates = []
+    for start in range(1, h - 2):
+        suffix = row_codes[start:]
+        if any(code is None for code in suffix):
+            continue
+        if any(suffix[i] == suffix[i + 1] for i in range(len(suffix) - 1)):
+            continue
