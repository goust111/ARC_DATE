+    components: list[tuple[int, np.ndarray]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(g[r, c]) == bg:
+                continue
+            color = int(g[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[Coord] = []
+            while stack:
