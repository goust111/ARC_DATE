+    cells: set[Coord] = set()
+    row_start = max(0, cr - radius)
+    row_stop = min(h - 1, cr + radius)
+    for r in range(row_start, row_stop + 1):
+        dc = radius - abs(r - cr)
+        left = cc - dc
+        right = cc + dc
+        if 0 <= left < w:
+            cells.add((r, left))
+        if 0 <= right < w:
+            cells.add((r, right))
