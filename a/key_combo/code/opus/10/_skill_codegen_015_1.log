+def _split_horizontal_symmetry(cells: set[Coord], cr: int) -> tuple[set[Coord], set[Coord]]:
+    symmetric: set[Coord] = set()
+    asymmetric: set[Coord] = set()
+    for r, c in cells:
+        mirror = (2 * cr - r, c)
+        if mirror in cells:
