+def _diamond_outline(shape: tuple[int, int], cr: int, cc: int, radius: int) -> set[Coord]:
+    h, w = shape
+    if radius == 0:
+        if 0 <= cr < h and 0 <= cc < w:
+            return {(cr, cc)}
+        return set()
