  objects:
    count: exactly 4, 8-connected components of the single foreground color
    symmetric: 3 objects whose tight-bbox foreground mask is LR-symmetric
    asymmetric: exactly 1 object whose tight-bbox foreground mask is NOT LR-symmetric (the target)
    bbox_size: 3-7 rows x 4-9 cols per object; area 15-36 cells
    fill_density: 0.40-0.66
    none_are_UD_symmetric: true [observed]
