+
+def _render_pairs(
+    shape_order: list[dict],
+    target_order: list[dict],
+    mapping: list[int],
+    shape_order_indices: list[int] | None = None,
+    mirror_override: bool | None = None,
+    shape: tuple[int, int] | None = None,
