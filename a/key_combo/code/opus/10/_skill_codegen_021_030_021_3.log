    49	            shape_to_color[key] = int(color)
    50	
    51	    out = g.copy()
    52	    blue_components = find_components(g, bg=bg, colors=[Color.BLUE], connectivity=4, monochromatic=True)
    53	    assert blue_components, "expected at least one blue placeholder object"
    54	    for component in blue_components:
    55	        key = _normalized_shape(component["coords"])
    56	        assert key in shape_to_color, "each blue object must match a colored template shape"
