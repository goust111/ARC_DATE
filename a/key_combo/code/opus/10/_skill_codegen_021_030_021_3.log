+                    (sr, sc, sr + h - 1, sc + w - 1),
+                    (lr, lc, lr + h - 1, lc + w - 1),
+                ]
+            )
+            success = True
+            break
+        if not success:
+            return None
+
+    grid = np.zeros((H, W), dtype=int)
+    for rec in records:
+        lr, lc = rec["large_pos"]
+        sr, sc = rec["small_pos"]
+        _paste_nonblack(grid, rec["large_patch"], lr, lc)
+        _paste_nonblack(grid, rec["small_patch"], sr, sc)
+
+    if not _semantic_validate(grid):
+        return None
+    return grid
+
