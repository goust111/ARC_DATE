+    return larges, smalls
+
+
+def _pair_components(components: list[dict]) -> tuple[list[dict], list[dict], list[tuple[dict, dict]]]:
+    larges, smalls = _partition_components(components)
+    small_by_key: dict[tuple[tuple[int, int], ...], dict] = {}
+    for comp in smalls:
