    35	    output_grid = input_grid.copy()
    36	
    37	    objects = detect_objects(grid=input_grid, monochromatic=False, connectivity=8)
    38	    pixels: list[np.ndarray] = []
    39	    patterns: list[np.ndarray] = []
    40	
    41	    for obj in objects:
    42	        b = bbox(obj != bg)
