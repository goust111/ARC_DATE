    32	    assert g.ndim == 2, "expected a 2D grid"
    33	
    34	    bg = get_bg(g)
    35	    assert bg != Color.BLUE, "blue must be a placeholder foreground color"
    36	
    37	    colors = colors_present(g, exclude={bg})
    38	    assert Color.BLUE in colors, "expected at least one blue placeholder object"
    39	    template_colors = [color for color in colors if color != Color.BLUE]
    40	    assert template_colors, "expected at least one non-blue colored template"
