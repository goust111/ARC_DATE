+
+def _component_crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _extract_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    mask = g != BLACK
+    seen = np.zeros_like(mask, dtype=bool)
+    H, W = g.shape
+    comps: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.asarray(cells, dtype=int)
+            bbox = _bbox_from_coords(coords)
+            crop = _component_crop(g, bbox)
+            colors = {int(v) for v in crop[crop != BLACK]}
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": bbox,
+                    "crop": crop,
+                    "colors": colors,
+                    "area": int(coords.shape[0]),
+                    "shape_key": _shape_key(coords),
+                }
+            )
+    return comps
+
