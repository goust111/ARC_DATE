+@dataclass(frozen=True)
+class ParsedInput:
+    grid: np.ndarray
+    row_tiles: tuple[tuple[int, ...], ...]
+    col_tiles: tuple[tuple[int, ...], ...]
+    separator_color: int
+    base_color: int
+    paths: dict[int, PathInfo]
+    intersection_tiles: frozenset[tuple[int, int]]
