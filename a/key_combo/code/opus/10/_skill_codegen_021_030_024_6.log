+def _runs_between_stops(length: int, stops: list[int]) -> tuple[tuple[int, ...], ...]:
+    runs = []
+    prev = -1
+    for stop in [*sorted(stops), length]:
+        if stop - prev > 1:
+            runs.append(tuple(range(prev + 1, stop)))
+        prev = stop
+    return tuple(runs)
