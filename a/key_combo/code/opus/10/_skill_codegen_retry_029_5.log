+    # Require both collision families to appear so the grey semantics are visible.
+    if not np.any((out == GREY) & diag_ad):
+        return False
+    if not np.any((out == GREY) & diag_bc):
+        return False
+
+    if mode == "square":
+        if h != w:
+            return False
+        # In square cases the two grey diagonals should have matching population.
+        if int(np.count_nonzero((out == GREY) & diag_ad)) != int(np.count_nonzero((out == GREY) & diag_bc)):
+            return False
+    elif mode == "wide":
+        if not (w > h):
+            return False
+    else:
+        if not (h > w):
+            return False
+
+    # Keep at least one non-grey interior cell so learners can see both "filled" and "collision" behavior.
+    if h > 2 and w > 2 and not np.any(out[1:-1, 1:-1] != GREY):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+
+    modes = ("square", "wide", "tall")
+    mode = modes[_GEN_COUNTER % len(modes)]
+    edge_bias = (_GEN_COUNTER // len(modes)) % 2 == 1
+    _GEN_COUNTER += 1
+
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        inp = _build_input(mode=mode, edge_bias=edge_bias)
+        if _accept(inp, mode):
+            return inp
+    raise RuntimeError(f"failed to generate a valid sample for mode={mode!r}")

