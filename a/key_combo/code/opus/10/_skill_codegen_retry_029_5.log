+    assert int(out[0, w - 1]) == corner_colors[1]
+    assert int(out[h - 1, 0]) == corner_colors[2]
+    assert int(out[h - 1, w - 1]) == corner_colors[3]
+
+    for r in range(h):
+        for c in range(w):
