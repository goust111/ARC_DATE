+
+
+def _paint_cells(grid: np.ndarray, cells: set[tuple[int, int]], color: int) -> None:
+    for r, c in cells:
+        grid[r, c] = int(color)
+
+
+def _bbox_of_cells(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    coords = np.asarray(sorted(cells), dtype=int)
+    return _bbox(coords)
