+        right_start = c1 + 1
+        for c in range(1, left_end + 1):
+            origins.append((0, c))
+        for c in range(right_start, cols - w):
+            origins.append((0, c))
+    elif side == "bottom":
+        left_end = c0 - w
+        right_start = c1 + 1
