+    assert not np.array_equal(grid, out), "transform must change the grid"
+
+
+def _generate_attempt(rng: random.Random) -> np.ndarray | None:
+    rows = rng.choice((15, 17, 19))
+    cols = rng.choice((15, 17, 19))
