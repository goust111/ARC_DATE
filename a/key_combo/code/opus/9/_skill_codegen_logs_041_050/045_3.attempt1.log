+
+
+def _candidate_origins(
+    side: str,
+    shape: tuple[tuple[int, int], ...],
+    grid_shape: tuple[int, int],
+    x_bbox: tuple[int, int, int, int],
+) -> list[tuple[int, int]]:
+    h, w = _shape_size(shape)
+    rows, cols = grid_shape
+    r0, c0, r1, c1 = x_bbox
+    origins: list[tuple[int, int]] = []
+    if side == "top":
