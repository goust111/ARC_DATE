+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert np.any(g == BACKGROUND)
+    x_bbox = _find_x_bbox(g)
+    instructions = _instruction_colors(g, x_bbox)
+    sprites = _sprite_components(g, x_bbox)
