  background: 0
  x_pattern:
    positions: all 9 cells on main diagonal and anti-diagonal (both diags of a 5x5)
    all_other_cells: background (0)
    colors: 5 distinct non-zero colors; center color unique, other 4 each appear twice
    symmetry: 180-degree rotational -- pixel(r,c) == pixel(4-r, 4-c)
  transform: |
    Fold X arms onto 3x3 perimeter + center:
      NW arm: (0,0)->(0,0), (1,1)->(0,1)
