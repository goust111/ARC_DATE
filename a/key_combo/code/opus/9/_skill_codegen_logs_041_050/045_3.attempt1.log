+    center = int(folded[1, 1])
+    edge_pairs = {
+        "top": (int(folded[0, 0]), int(folded[0, 1])),
+        "right": (int(folded[0, 2]), int(folded[1, 2])),
+        "left": (int(folded[1, 0]), int(folded[2, 0])),
+        "bottom": (int(folded[2, 1]), int(folded[2, 2])),
+    }
