+    elif side == "left":
+        top_end = r0 - h
+        bottom_start = r1 + 1
+        for r in range(1, top_end + 1):
+            origins.append((r, 0))
+        for r in range(bottom_start, rows - h):
+            origins.append((r, 0))
+    else:
+        top_end = r0 - h
+        bottom_start = r1 + 1
+        for r in range(1, top_end + 1):
+            origins.append((r, cols - w))
+        for r in range(bottom_start, rows - h):
+            origins.append((r, cols - w))
+    return origins
+
+
+def _all_non_background_except(grid: np.ndarray, own: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    blocked = set()
