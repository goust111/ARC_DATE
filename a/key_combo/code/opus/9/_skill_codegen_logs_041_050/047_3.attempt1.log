+def _normalized_signature(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    coords = np.argwhere(mask)
+    shifted = coords - coords.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in shifted))
