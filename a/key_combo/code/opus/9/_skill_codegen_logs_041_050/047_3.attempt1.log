OBJECT_COUNT_RANGE, HOLE_OBJECT_COUNT_RANGE = (2, 7), (1, 3)
NOHOLE_OBJECT_MAX = 4
HOLE_OBJECT_MIN_AREA, OBJECT_MAX_AREA = 8, 17
FOREGROUND_DENSITY_RANGE = (0.18, 0.30)

