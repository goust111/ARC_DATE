+
+def _planned_output(clean: np.ndarray, sep_rows: np.ndarray, sep_cols: np.ndarray, statuses: np.ndarray) -> np.ndarray:
+    out = clean.copy()
+    for ri, row in enumerate(sep_rows):
+        for ci, col in enumerate(sep_cols):
