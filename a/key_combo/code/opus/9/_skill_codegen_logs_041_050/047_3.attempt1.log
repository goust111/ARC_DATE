spec:
  grid: 9x9 [observed]
  background: single color (7 in eval) [observed]
  foreground: single placeholder color (6 in eval) forming all objects [observed]
  shapes:
    legend: |
      6 fixed translation-normalized shapes, each mapped to a unique output color:
        domino (2 cells) -> 9
        L-triomino (3 cells: (0,0)(0,1)(1,1)) -> 4
        vertical-3 (3 cells: (0,0)(1,0)(2,0)) -> 2
        S-tetromino (4 cells: (0,0)(0,1)(1,1)(1,2)) -> 8
        plus pentomino (5 cells) -> 3
        2x3 rectangle (6 cells) -> 5
    orientation: shapes appear in exactly their canonical normalized form (no rotations/reflections)
  objects:
    count: 6-8 (all 6 distinct shapes appear at least once; 0-2 duplicates from any shape)
    placement: non-overlapping bounding boxes; min chebyshev distance between any two objects >= 1
    total_fg_cells: 23-29 (~28-36% of grid)
  output: replace each placeholder object with its shape-assigned color; background unchanged

generation_strategy:
  approach: direct placement (input == output structure minus recoloring)
  steps:
    1. Choose grid 9x9, pick background color and placeholder color
    2. Decide object count 6-8; assign each of the 6 canonical shapes at least once, pick 0-2 duplicates randomly
    3. Place objects one by one on the grid using rejection per object (try random top-left positions); ensure 4-connected cells stay within bounds and bounding boxes do not overlap with any already-placed object's bounding box
    4. Fill all placed object cells with the placeholder color; rest is background
    5. Output is derived by replacing each object's cells with its shape's assigned color
```
