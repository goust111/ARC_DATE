        for c in range(w):
            if mask[r, c] or forbidden[r, c]:
                continue
            if sum(bool(mask[rr, cc]) for rr, cc in _gen_neighbors(mask, r, c)) == 1:
                cells.append((r, c))
    return cells


def _gen_patch_from_mask(mask, bg, fg):
