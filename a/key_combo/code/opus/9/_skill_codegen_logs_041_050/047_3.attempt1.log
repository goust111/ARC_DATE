+    line_mask[sep_rows, :] = True
+    line_mask[:, sep_cols] = True
+    cleaned[(cleaned == Color.RED) & line_mask] = Color.BLUE
+    cleaned[(cleaned == Color.RED) & ~line_mask] = Color.BLACK
+    return cleaned
