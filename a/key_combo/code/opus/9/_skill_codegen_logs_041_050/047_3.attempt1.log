    n_groups = random.choice(GROUP_COUNT_CHOICES)
    colors = [random.randint(COLOR_MIN, COLOR_MAX) for _ in range(n_groups)]
    groups = _gen_build_output_groups(colors)
    out = _gen_render_groups(groups, separator_width=0)

