        if not mask[r, c]:
            continue
        degree = 0
        for rr, cc in neighbors4(r, c):
            if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
                degree += 1
        if degree == 1:
            rows.append(r)
    assert len(rows) == 1
    return rows[0]


def _shift_group(group: np.ndarray, bg: int, dr: int) -> np.ndarray:
    h, _ = group.shape
