+            expected,
+            sep_rows,
+            sep_cols,
+            statuses,
+            colors,
+            placed_sigs,
+            line_noise_count,
+            interior_noise_count,
+        )
+    except Exception:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_MAX_ATTEMPTS):
+        sample = _attempt_generate(rng)
