PATCH_CANVAS_SHAPE = (9, 7)
HOLE_BOX_ROWS_RANGE, HOLE_BOX_COLS_RANGE = (3, 9), (3, 7)
HOLE_SIZE_RANGE = (1, 8)
NEIGHBOR_OFFSETS = ((-1, 0), (1, 0), (0, -1), (0, 1))

