+    statuses = np.zeros((len(sep_rows) - 1, len(sep_cols) - 1), dtype=bool)
+    for ri, ci, r0, r1, c0, c1 in _cell_bounds(sep_rows, sep_cols):
+        has_hole, _color, _sig = _analyze_cell(cleaned, r0, r1, c0, c1)
+        statuses[ri, ci] = has_hole
