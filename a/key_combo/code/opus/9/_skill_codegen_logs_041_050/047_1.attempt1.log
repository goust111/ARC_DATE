    while int(mask.sum()) < target_area:
        cells = _gen_frontier(mask)
        random.shuffle(cells)
        chosen = None
        for r, c in cells:
            trial = mask.copy()
            trial[r, c] = True
            cropped = _gen_crop_mask(trial)
            if cropped.shape[0] <= PATCH_CANVAS_SHAPE[0] and cropped.shape[1] <= PATCH_CANVAS_SHAPE[1]:
