+    objects = _components(grid == GREY)
+    if len(objects) != len(placed):
+        return False
+
+    hole_counts = sorted(int(len(_object_holes(grid, obj))) for obj in objects)
+    if 0 not in hole_counts or 1 not in hole_counts or max(hole_counts) < 2:
+        return False
