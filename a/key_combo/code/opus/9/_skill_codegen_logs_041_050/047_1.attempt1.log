+    return None
+
+
+def _materialize_expected(input_grid: np.ndarray, placed: list[dict]) -> np.ndarray:
+    out = input_grid.copy()
+    for item in placed:
+        top = int(item["top"])
+        left = int(item["left"])
+        patch = item["patch"]
+        meta = item["meta"]
+        grey_coords = np.argwhere(patch == GREY)
