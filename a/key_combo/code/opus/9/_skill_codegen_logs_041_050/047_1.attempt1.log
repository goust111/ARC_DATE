+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 400
