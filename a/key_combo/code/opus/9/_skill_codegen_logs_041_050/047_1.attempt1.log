+
+def _can_place(occupied: np.ndarray, patch: np.ndarray, top: int, left: int, pad: int = 1) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return False
+    pts = np.argwhere(patch != BLACK)
+    for pr, pc in pts:
+        gr = top + int(pr)
+        gc = left + int(pc)
