+
+
+def _masked_stamp(template: np.ndarray, excluded_rows: set[int], excluded_cols: set[int]) -> np.ndarray:
+    stamped = template.copy()
+    if excluded_rows:
+        stamped[np.array(sorted(excluded_rows)), :] = BLACK
+    if excluded_cols:
+        stamped[:, np.array(sorted(excluded_cols))] = BLACK
