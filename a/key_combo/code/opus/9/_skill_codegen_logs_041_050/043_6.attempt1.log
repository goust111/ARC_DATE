+
+def _cell_bounds(row_spans: list[tuple[int, int]], col_spans: list[tuple[int, int]], row_idx: int, col_idx: int) -> tuple[int, int, int, int]:
+    r0, r1 = row_spans[row_idx]
+    c0, c1 = col_spans[col_idx]
