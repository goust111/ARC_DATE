+def _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for stop in [*separators, length]:
+        spans.append((start, stop - 1))
+        start = stop + 1
+    return spans
