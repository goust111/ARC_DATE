+def _split_spans(size: int, dividers: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for idx in dividers:
+        if start < idx:
+            spans.append((start, idx - 1))
+        start = idx + 1
+    if start < size:
+        spans.append((start, size - 1))
+    return spans
