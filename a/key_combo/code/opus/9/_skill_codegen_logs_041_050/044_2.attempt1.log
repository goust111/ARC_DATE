+
+def _run_start_indices(lines: np.ndarray) -> list[int]:
+    keep = [0]
+    for i in range(1, lines.shape[0]):
+        if not np.array_equal(lines[i], lines[i - 1]):
+            keep.append(i)
+    return keep
