+def _draw_rect_loop(grid: np.ndarray, top: int, left: int, inner_h: int, inner_w: int) -> tuple[int, int, int, int]:
+    bottom = top + inner_h + 1
+    right = left + inner_w + 1
+    grid[top, left : right + 1] = CONTOUR
+    grid[bottom, left : right + 1] = CONTOUR
