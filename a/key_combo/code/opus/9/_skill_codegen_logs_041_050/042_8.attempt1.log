+    width: int,
+    area: int,
+    forbidden: set[tuple[int, int]],
+) -> np.ndarray | None:
+    allowed = [(r, c) for r in range(height) for c in range(width) if (r, c) not in forbidden]
+    if len(allowed) < area:
+        return None
+    mask = np.zeros((height, width), dtype=bool)
+    start = allowed[int(rng.integers(len(allowed)))]
+    mask[start] = True
