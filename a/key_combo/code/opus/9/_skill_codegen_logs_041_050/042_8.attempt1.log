+    accent_count = int(rng.integers(1, min(4, len(coords)) + 1))
+    accent_idx = rng.choice(len(coords), size=accent_count, replace=False)
+    for idx in np.atleast_1d(accent_idx):
+        r, c = coords[int(idx)]
