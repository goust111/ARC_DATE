+def _row_starts_cumulative(offsets: list[int]) -> list[int]:
+    rows = [0]
+    for off in offsets:
+        rows.append(rows[-1] + int(off))
+    return rows
+
+
+def _row_starts_direct(offsets: list[int]) -> list[int]:
+    rows = [0] + [int(off) for off in offsets]
+    shift = -min(rows)
+    return [r + shift for r in rows]
+
