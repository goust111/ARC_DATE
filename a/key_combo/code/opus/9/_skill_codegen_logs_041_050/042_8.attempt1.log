+    assert coords.shape == (2, 2), "glyph must contain exactly two grey pixels"
+    rows = {int(r) for r, _c in coords}
+    cols = {int(c) for _r, c in coords}
+    if len(rows) == 1:
+        return 0
+    if len(cols) == 1:
+        return 1
+    return -1
