+            assert _mask_key(patch_out) == _mask_key(patch)
+            assert comp_in["bbox"][0] == int(obj["row_in"])
+            assert comp_in["bbox"][1] == int(obj["col_in"])
+            assert comp_out["bbox"][0] == int(obj["row_out"])
+            assert comp_out["bbox"][1] == int(obj["col_out"])
+            assert comp_out["bbox"][0] >= comp_in["bbox"][0]
+            if int(obj["col_in"]) != int(obj["col_out"]):
