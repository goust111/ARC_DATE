+    "l4": _patch_from_lines(("#..", "###")),
+    "j4": _patch_from_lines(("..#", "###")),
+    "z4": _patch_from_lines(("##.", ".##")),
+    "u5": _patch_from_lines(("#.#", "###")),
+    "plus5": _patch_from_lines((".#.", "###", ".#.")),
