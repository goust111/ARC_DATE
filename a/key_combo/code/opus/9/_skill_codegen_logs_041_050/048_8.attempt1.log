0136:         return mask
0137:     if w == 1:
0138:         mask[:, 0] = True
0139:         return mask
0140:     steps = max(h, w)
0141:     for i in range(steps):
0142:         r = int(round(i * (h - 1) / (steps - 1)))
0143:         c = int(round(i * (w - 1) / (steps - 1)))
0144:         mask[r, c] = True
