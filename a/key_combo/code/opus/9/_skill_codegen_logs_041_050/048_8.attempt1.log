+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _paste_patch(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
