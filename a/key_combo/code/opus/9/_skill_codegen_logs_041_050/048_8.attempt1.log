+    expected_bottom = inp[:band_h_in, :][::-1, :]
+    assert np.array_equal(expected[-band_h_in:, :], expected_bottom)
+
+    plan_by_color: dict[int, list[dict]] = {}
+    in_by_color: dict[int, list[dict]] = {}
+    out_by_color: dict[int, list[dict]] = {}
+    for obj in objects:
