0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Mirror the full-width colored top band into the bottom rows while leaving the original band and middle background unchanged.
0010: 
0011:     Input structure
0012:     - The background is the most common color.
0013:     - All foreground pixels form a contiguous band of complete rows starting at the top edge.
0014:     - Every row below that top band is background.
0015: 
0016:     Rule
0017:     - Copy the top band into the same-width bottom rows, reversing the row order vertically.
0018:     - Preserve the original top band and the background gap between the two bands.
0019: 
0020:     Key insight
0021:     - The output is a vertical edge reflection of the input's top colored row band, not a recoloring or resizing.
0022:     """
0023:     g = np.asarray(grid, dtype=int)
0024:     bg = get_bg(g)
0025: 
0026:     row_has_fg = np.any(g != bg, axis=1)
0027:     assert row_has_fg.size > 0
0028:     assert row_has_fg[0]
0029: 
0030:     top_h = 0
0031:     for has_fg in row_has_fg:
0032:         if not has_fg:
0033:             break
0034:         top_h += 1
0035: 
0036:     assert top_h > 0
0037:     assert top_h * 2 <= g.shape[0]
0038:     assert not np.any(row_has_fg[top_h:])
0039: 
0040:     top_band = g[:top_h, :]
0041:     assert np.all(top_band != bg)
0042:     assert np.all(g[top_h:, :] == bg)
0043: 
0044:     out = g.copy()
0045:     out[-top_h:, :] = top_band[::-1, :]
0046:     return out
