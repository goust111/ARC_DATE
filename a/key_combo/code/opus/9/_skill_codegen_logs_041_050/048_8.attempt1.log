+                    abs(c0 - center_c0),
+                    random.random(),
+                )
+                candidates.append((score, c0))
+        if not candidates:
+            return None
+        candidates.sort(reverse=True)
+        _, c0 = candidates[0]
+        obj["col_in"] = int(c0)
+        obj["col_out"] = int(center_c0)
+        if _crosses_segment(obj["segment"], c0, w):
+            actual_crosses += 1
+        _paste_patch(grid, patch, r0, c0, BG)
