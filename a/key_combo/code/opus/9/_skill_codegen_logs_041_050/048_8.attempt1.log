+    segments = []
+    c = 0
+    while c < row.size:
+        color = int(row[c])
+        c1 = c
+        while c1 + 1 < row.size and int(row[c1 + 1]) == color:
+            c1 += 1
+        segments.append({"color": color, "start": int(c), "end": int(c1)})
+        c = c1 + 1
+    return segments
