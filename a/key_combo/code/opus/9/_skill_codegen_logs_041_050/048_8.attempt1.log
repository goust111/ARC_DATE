+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    visited = np.zeros((H, W), dtype=bool)
+    comps = []
+    if int(connectivity) == 4:
+        nbrs = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        nbrs = [
