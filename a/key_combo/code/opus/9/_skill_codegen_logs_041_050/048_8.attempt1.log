+    for seg in segments:
+        row[seg["start"] : seg["end"] + 1] = int(seg["color"])
+    return np.repeat(row[None, :], band_h, axis=0)
+
+
+def _expected_output(shape: tuple[int, int], band: np.ndarray, objects: list[dict]) -> np.ndarray:
+    H, W = shape
+    band_h = band.shape[0]
+    out = np.zeros((H, W), dtype=int)
+    out[:band_h, :] = band
+    out[H - band_h :, :] = band[::-1, :]
