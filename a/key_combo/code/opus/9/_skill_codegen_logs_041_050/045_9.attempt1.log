+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to build a valid puzzle instance")

