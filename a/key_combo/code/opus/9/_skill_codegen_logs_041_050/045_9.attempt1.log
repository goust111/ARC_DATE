+            return False
+        if color == BLUE and not (int(above["area"]) < int(below["area"])):
+            return False
+        if color == GREEN and not (int(above["area"]) == int(below["area"])):
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is not None:
