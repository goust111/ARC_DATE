+        out[coords[:, 0], coords[:, 1]] = int(obj["color"])
+        shifted_objects.append(
+            {
+                "color": int(obj["color"]),
+                "coords": coords,
+                "bbox": bbox_coords(coords),
+                "area": int(coords.shape[0]),
+                "source_rank": rank + 1,
+            }
+        )
+
+    return out, shifted_objects
