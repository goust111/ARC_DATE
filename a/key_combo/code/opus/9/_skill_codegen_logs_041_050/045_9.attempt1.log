+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+OBJECT_COLORS = (4, 5, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
