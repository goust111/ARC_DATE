+
+def _row_columns(coords: np.ndarray, which: str) -> set[int]:
+    rr = coords[:, 0]
+    target_row = int(rr.min()) if which == "top" else int(rr.max())
+    return {int(c) for r, c in coords if int(r) == target_row}
+
