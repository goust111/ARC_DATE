+    if expected_colors != found_colors:
+        return False
+
+    if len(set(found_colors)) < min(2, len(found_colors)):
+        return False
+
+    shifted = analysis["shifted_grid"]
+    out = main(g)
+    diff_rows = [r for r in range(g.shape[0]) if not np.array_equal(out[r], shifted[r])]
