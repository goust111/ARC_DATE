+        coords = {(0, 0), (0, 1), (1, 0), (2, 0), (2, 1)}
+        if outcome == "up":
+            coords.add((0, 2))
+        elif outcome == "down":
+            coords.add((2, 2))
+        elif random.random() < 0.5:
+            coords |= {(0, 2), (2, 2)}
+    else:
+        coords = {(0, 1), (0, 2), (1, 2), (2, 1), (2, 2)}
+        if outcome == "up":
+            coords.add((0, 0))
+        elif outcome == "down":
+            coords.add((2, 0))
+        elif random.random() < 0.5:
