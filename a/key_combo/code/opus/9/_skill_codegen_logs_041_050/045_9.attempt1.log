+    return out
+
+
+def _shifted_color_from_outcome(outcome: str) -> int:
+    if outcome == "up":
+        return RED
+    if outcome == "down":
+        return BLUE
+    return GREEN
+
+
+def _split_shape(direction: str, outcome: str) -> np.ndarray:
+    if direction == "left":
+        coords = {(0, 0), (0, 1), (1, 0), (2, 0), (2, 1)}
+        if outcome == "up":
+            coords.add((0, 2))
+        elif outcome == "down":
+            coords.add((2, 2))
+        elif random.random() < 0.5:
+            coords |= {(0, 2), (2, 2)}
+    else:
+        coords = {(0, 1), (0, 2), (1, 2), (2, 1), (2, 2)}
+        if outcome == "up":
+            coords.add((0, 0))
+        elif outcome == "down":
+            coords.add((2, 0))
+        elif random.random() < 0.5:
