+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+    monochromatic: bool = True,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == int(bg):
+                continue
+
+            color = int(g[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or int(g[nr, nc]) == int(bg):
+                        continue
+                    if monochromatic and int(g[nr, nc]) != color:
+                        continue
+                    if connectivity == 4 or abs(nr - rr) + abs(nc - cc) == 1:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            arr = np.asarray(coords, dtype=int)
+            out.append(
+                {
+                    "color": color if monochromatic else None,
+                    "coords": arr,
+                    "bbox": bbox_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+
+    return out
+
+
+def _shift_ordered_objects(
+    objects: list[dict], shape: tuple[int, int], bg: int
+) -> tuple[np.ndarray, list[dict]]:
+    h, w = shape
+    out = np.full(shape, bg, dtype=int)
+    occupied = np.zeros(shape, dtype=bool)
+    shifted_objects = []
+
