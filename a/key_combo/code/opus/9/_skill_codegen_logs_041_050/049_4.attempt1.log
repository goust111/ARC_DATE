+    ph, pw = pattern.shape
+    expected = _expected_fill_widths(ph)
+    assert any(width > 0 for width in expected), "must have at least one filled row"
+    assert any(width == 0 for width in expected), "must cover the no-gap branch as well"
+
+    out, left_mask, right_mask = _render_transformation(grid)
