+            left_edge = int(np.flatnonzero(left_mask[row])[-1])
+            right_edge = int(np.flatnonzero(right_mask[row])[0])
+            assert fill_cols[0] == left_edge + 1
+            assert fill_cols[-1] == right_edge - 1
+
