from __future__ import annotations

from collections import deque
import itertools
import random

import numpy as np


BLACK = 0
BLUE = 1
NON_BLUE_NON_BLACK = tuple(range(2, 10))

_CORNER_ROLES = {
    ((0, 0), (0, 1), (1, 0)): "TL",
    ((0, 0), (0, 1), (1, 1)): "TR",
    ((0, 0), (1, 0), (1, 1)): "BL",
    ((0, 1), (1, 0), (1, 1)): "BR",
}
_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
_GEN_ATTEMPTS = 400


def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                pts.append((rr, cc))
                for dr, dc in _DIRS4:
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(np.array(pts, dtype=int))
    return out


def _legend_info(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    h, w = grid.shape
    assert h >= 4 and w >= 4
    top_row = grid[h - 2]
    bottom_row = grid[h - 1]
    active = np.flatnonzero((top_row != BLACK) & (bottom_row != BLACK))
    assert active.size >= 2
    c0 = int(active[0])
    c1 = int(active[-1])
    assert np.array_equal(active, np.arange(c0, c1 + 1))
    assert np.all(grid[h - 2 :, :c0] == BLACK)
    assert np.all(grid[h - 2 :, c1 + 1 :] == BLACK)

    legend_mask = np.zeros_like(grid, dtype=bool)
    legend_mask[h - 2 : h, c0 : c1 + 1] = True
    legend = grid[h - 2 : h, c0 : c1 + 1].copy()
    assert np.all(legend != BLACK)
    assert np.all(legend != BLUE)
    return legend_mask, legend[0], legend[1]


def _role_for_component(coords: np.ndarray) -> tuple[str, tuple[int, int]]:
    assert coords.shape == (3, 2)
    r0, c0, r1, c1 = _bbox_coords(coords)
    assert (r1 - r0, c1 - c0) == (1, 1)
    rel = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
    assert rel in _CORNER_ROLES
    role = _CORNER_ROLES[rel]
    if role == "TL":
        return role, (r0, c0)
    if role == "TR":
        return role, (r0, c1)
    if role == "BL":
        return role, (r1, c0)
    return role, (r1, c1)


def _find_frames(grid: np.ndarray, legend_mask: np.ndarray) -> list[dict]:
    fg_colors = sorted(set(int(v) for v in grid[~legend_mask].flat) - {BLACK, BLUE})
    frames = []
    for color in fg_colors:
        comps = _components((grid == color) & (~legend_mask))
        assert len(comps) == 4
        roles: dict[str, tuple[int, int]] = {}
        for comp in comps:
            role, anchor = _role_for_component(comp)
            assert role not in roles
            roles[role] = anchor
        assert set(roles) == {"TL", "TR", "BL", "BR"}
        top, left = roles["TL"]
        top2, right = roles["TR"]
        bottom, left2 = roles["BL"]
        bottom2, right2 = roles["BR"]
        assert top == top2 and left == left2 and bottom == bottom2 and right == right2
        assert bottom > top and right > left
        frames.append(
            {
                "color": int(color),
                "bbox": (int(top), int(left), int(bottom), int(right)),
            }
        )
    frames.sort(key=lambda frame: (frame["bbox"][1], frame["bbox"][0]))
    return frames


def _mirror_point(
    r: int,
    c: int,
    bbox: tuple[int, int, int, int],
    axis: str,
) -> tuple[int, int]:
    r0, c0, r1, c1 = bbox
    if axis == "vertical":
        return int(r), int(c0 + c1 - c)
    return int(r0 + r1 - r), int(c)


def _solve(
    grid: np.ndarray,
    *,
    axis_mode: str = "aspect",
    legend_mode: str = "aspect",
    order_mode: str = "left",
) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    legend_mask, wide_row, tall_row = _legend_info(g)
    frames = _find_frames(g, legend_mask)
    assert 2 <= len(frames) <= 3
    if order_mode == "reverse":
        frames = list(reversed(frames))

    out = g.copy()
    out[g == BLUE] = BLACK

    for idx, frame in enumerate(frames):
        r0, c0, r1, c1 = frame["bbox"]
        height = r1 - r0 + 1
        width = c1 - c0 + 1
        aspect_axis = "vertical" if width > height else "horizontal"
        axis = aspect_axis if axis_mode == "aspect" else axis_mode
        if legend_mode == "aspect":
            fill = int(wide_row[idx] if width > height else tall_row[idx])
        elif legend_mode == "top":
            fill = int(wide_row[idx])
        else:
            fill = int(tall_row[idx])

        region = np.argwhere(
            (g == BLUE)
            & (np.arange(g.shape[0])[:, None] >= r0)
            & (np.arange(g.shape[0])[:, None] <= r1)
            & (np.arange(g.shape[1])[None, :] >= c0)
            & (np.arange(g.shape[1])[None, :] <= c1)
        )
        assert region.size > 0

        painted: set[tuple[int, int]] = set()
        for r, c in region:
            painted.add((int(r), int(c)))
            painted.add(_mirror_point(int(r), int(c), frame["bbox"], axis))

        for r, c in painted:
            out[r, c] = fill

    return out


def main(grid: np.ndarray) -> np.ndarray:
    """Use each corner-marked rectangle's aspect ratio to choose both a mirror axis and a legend row, then recolor the mirrored blue motif and erase outside blue noise.

    Input structure:
    - A black grid contains 2-3 rectangular frames, each defined by four same-color 2x2 L-triomino corner markers.
    - Every frame encloses a small blue 4-connected motif located on one side of the frame interior.
    - The bottom edge contains a 2-row legend whose columns correspond to the frames sorted by left-to-right frame position.
    - Extra blue pixels may appear outside all frames as noise.

    Rule:
    - Detect each rectangle from its four corner markers.
    - If a frame is wider than tall, mirror its internal blue pixels left-right and use the legend's top row for that frame's fill color.
    - If a frame is tall or square, mirror its internal blue pixels top-bottom and use the legend's bottom row for that frame's fill color.
    - Recolor every blue pixel inside each frame after mirroring, keep markers and legend unchanged, and erase all blue pixels outside the frames.

    Key insight:
    - The rectangle aspect ratio is a double switch: it simultaneously selects the geometric mirror axis and which legend row supplies the recoloring color.
    """
    return _solve(grid)


def _draw_frame(grid: np.ndarray, bbox: tuple[int, int, int, int], color: int) -> None:
    r0, c0, r1, c1 = bbox
    grid[r0, c0] = color
    grid[r0, c0 + 1] = color
    grid[r0 + 1, c0] = color

    grid[r0, c1 - 1] = color
    grid[r0, c1] = color
    grid[r0 + 1, c1] = color

    grid[r1 - 1, c0] = color
    grid[r1, c0] = color
    grid[r1, c0 + 1] = color

    grid[r1 - 1, c1] = color
    grid[r1, c1 - 1] = color
    grid[r1, c1] = color


def _expanded(box: tuple[int, int, int, int], pad: int, shape: tuple[int, int]) -> tuple[int, int, int, int]:
    h, w = shape
    r0, c0, r1, c1 = box
    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)


def _boxes_clear(boxes: list[tuple[int, int, int, int]], box: tuple[int, int, int, int]) -> bool:
    r0, c0, r1, c1 = box
    for rr0, cc0, rr1, cc1 in boxes:
        if not (r1 < rr0 - 1 or rr1 < r0 - 1 or c1 < cc0 - 1 or cc1 < c0 - 1):
            return False
    return True


