+LEFT_MARGIN_RANGE = (1, 5)
+RIGHT_MARGIN_EXTRA_MAX = 5
+COLOR_COUNT_CHOICES = (2, 3)
+FILL_MODES = ("noise", "row_runs", "column_bands", "diagonal_bands")
+
