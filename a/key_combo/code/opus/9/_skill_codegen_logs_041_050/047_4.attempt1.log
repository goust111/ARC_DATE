+    for r in range(inner_h):
+        for c in range(inner_w):
+            distance = max(abs(r - mr), abs(c - mc))
+            if distance == 0:
+                interior[r, c] = RED
+            elif distance % 2 == 1:
+                interior[r, c] = YELLOW
+            else:
