+        max_h = min(FRAME_MAX, canvas_h - 2 * CANVAS_MARGIN)
+        max_w = min(FRAME_MAX, canvas_w - 2 * CANVAS_MARGIN)
+        if max_h < FRAME_MIN or max_w < FRAME_MIN:
