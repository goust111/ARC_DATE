+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        canvas_h = random.randint(GRID_MIN, GRID_MAX)
+        canvas_w = random.randint(GRID_MIN, GRID_MAX)
+        target_count = random.choice([1, 2])
