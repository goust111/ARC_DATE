+
+    gap_budget = width - total_w - 2
+    if gap_budget < 3:
+        return None
+
+    # Four gaps: left margin, three internal gaps, right margin.
+    cuts = sorted(random.sample(range(gap_budget + 3), 3))
+    parts = [cuts[0], cuts[1] - cuts[0], cuts[2] - cuts[1], gap_budget + 3 - cuts[2]]
+    gaps = [p + 1 for p in parts]
+    left_margin = gaps[0]
+    inner_gaps = gaps[1:]
+
+    grid = np.full((height, width), BG, dtype=int)
+    base_center = random.randint(max_size // 2 + 2, height - (max_size // 2) - 3)
+    col = left_margin
+    for idx, rec in enumerate(order):
