+        return []
+    cells = [(r, c) for r in range(1, size - 1) for c in range(1, size - 1)]
+    combos = []
+    for seed_cells in itertools.combinations(cells, hole_count):
+        ok = True
+        for i, (r0, c0) in enumerate(seed_cells):
+            for r1, c1 in seed_cells[i + 1 :]:
+                if abs(r0 - r1) + abs(c0 - c1) <= 1:
+                    ok = False
+                    break
+            if not ok:
+                break
+        if ok:
+            combos.append(seed_cells)
+    return random.choice(combos) if combos else None
+
+
+def _generate_mask(hole_count: int, size: int) -> np.ndarray | None:
+    min_area = max(7, size + hole_count + 2)
+    for _ in range(SHAPE_ATTEMPTS):
+        seeds = _pick_isolated_holes(size, hole_count)
+        if seeds is None:
+            continue
+
+        mask = np.ones((size, size), dtype=bool)
+        for r, c in seeds:
+            mask[r, c] = False
+        if not _valid_square_mask(mask, hole_count):
+            continue
+
+        target_steps = random.randint(max(1, hole_count), max(2, size + hole_count))
+        for _step in range(target_steps):
+            candidates = [(r, c) for r, c in np.argwhere(mask)]
+            random.shuffle(candidates)
+            changed = False
+            for r, c in candidates:
+                trial = mask.copy()
+                trial[r, c] = False
+                if trial.sum() < min_area:
+                    continue
+                if not _valid_square_mask(trial, hole_count):
+                    continue
+                mask = trial
+                changed = True
+                break
+            if not changed:
+                break
+
+        if hole_count == 0:
+            if np.array_equal(mask, np.rot90(mask, 1)) or np.array_equal(mask, np.rot90(mask, 2)):
+                continue
+        else:
+            if np.array_equal(mask, np.rot90(mask, -hole_count)):
+                continue
+
+        return mask
+    return None
+
+
+def _render_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    return np.where(mask, int(color), BG).astype(int)
+
+
+def _rotated_patch(mask: np.ndarray, color: int, hole_count: int) -> np.ndarray:
+    patch = _render_patch(mask, color)
+    rotated = np.rot90(patch, -hole_count)
+    return _tight_crop(rotated, BG)
+
+
+def _concat_top_aligned(patches: list[np.ndarray]) -> np.ndarray:
+    max_h = max(int(p.shape[0]) for p in patches)
+    total_w = sum(int(p.shape[1]) for p in patches)
+    out = np.full((max_h, total_w), BG, dtype=int)
+    c0 = 0
+    for patch in patches:
+        h, w = patch.shape
+        out[:h, c0 : c0 + w] = patch
+        c0 += w
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Rotate each sprite by 90 degrees times its hole count, then pack the rotated crops left-to-right.
+
+    Input structure
+    - Black (0) is the background.
+    - Exactly four separated 4-connected monochrome sprites of distinct non-black colors appear on the canvas.
+    - Each sprite has a tight square bounding box and encloses 0, 1, 2, or 3 black hole components.
+
+    Rule
+    - For each sprite, count its enclosed 4-connected black hole regions.
+    - Rotate that sprite clockwise by hole_count * 90 degrees around the center of its square bounding box.
+    - Crop the rotated sprite to its tight bounding box, sort sprites by their original left bbox edge, and concatenate the crops horizontally with top alignment and black padding below shorter crops.
+
+    Key insight
+    - The rotation angle is encoded by topology: the number of enclosed holes, not the color, size, or a fixed orientation.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+
+    components = _find_components(g, bg)
+    assert len(components) == 4
+
+    items = []
+    hole_counts = []
+    for comp in components:
+        color = int(comp["color"])
+        box = tuple(int(x) for x in comp["bbox"])
+        r0, c0, r1, c1 = box
+        assert (r1 - r0) == (c1 - c0)
+        patch = _crop_bbox(g, box)
+        mask = patch == color
+        holes = _count_holes(mask)
+        hole_counts.append(holes)
+        rotated_crop = _tight_crop(np.rot90(patch, -holes), bg)
+        items.append((c0, rotated_crop))
+
+    assert sorted(hole_counts) == [0, 1, 2, 3]
+    ordered = [patch for _, patch in sorted(items, key=lambda item: item[0])]
+    return _concat_top_aligned(ordered)
+
+
+def _build_expected(records: list[dict]) -> np.ndarray:
+    ordered = sorted(records, key=lambda rec: rec["col"])
+    patches = [_rotated_patch(rec["mask"], rec["color"], rec["holes"]) for rec in ordered]
+    return _concat_top_aligned(patches)
+
+
+def _build_wrong_rotation(records: list[dict]) -> np.ndarray:
+    ordered = sorted(records, key=lambda rec: rec["col"])
+    patches = [_render_patch(rec["mask"], rec["color"]) for rec in ordered]
+    return _concat_top_aligned(patches)
+
+
+def _build_wrong_order(records: list[dict]) -> np.ndarray:
+    ordered = sorted(records, key=lambda rec: rec["holes"])
+    patches = [_rotated_patch(rec["mask"], rec["color"], rec["holes"]) for rec in ordered]
+    return _concat_top_aligned(patches)
+
+
+def _validate_instance(grid: np.ndarray, records: list[dict]) -> bool:
+    expected = _build_expected(records)
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+
+    if np.array_equal(expected, _build_wrong_rotation(records)):
+        return False
+    if np.array_equal(expected, _build_wrong_order(records)):
+        return False
+
+    components = _find_components(grid, BG)
+    if len(components) != 4:
+        return False
+
+    holes = []
+    colors_by_x = []
+    holes_by_x = []
+    heights = set()
+    row_centers = []
+    for comp in sorted(components, key=lambda comp: comp["bbox"][1]):
+        color = int(comp["color"])
+        box = tuple(int(x) for x in comp["bbox"])
+        r0, c0, r1, c1 = box
+        if (r1 - r0) != (c1 - c0):
+            return False
+        patch = _crop_bbox(grid, box)
+        mask = patch == color
+        hole_count = _count_holes(mask)
+        if hole_count > 0 and np.array_equal(mask, np.rot90(mask, -hole_count)):
+            return False
+        holes.append(hole_count)
+        colors_by_x.append(color)
+        holes_by_x.append(hole_count)
+        heights.add(_rotated_patch(mask, color, hole_count).shape[0])
+        row_centers.append((r0 + r1) / 2.0)
+
+    if sorted(holes) != [0, 1, 2, 3]:
+        return False
+    if holes_by_x in ([0, 1, 2, 3], [3, 2, 1, 0]):
+        return False
+    if colors_by_x == sorted(colors_by_x) or colors_by_x == sorted(colors_by_x, reverse=True):
+        return False
+    if len(heights) < 2:
+        return False
+    if max(row_centers) - min(row_centers) > 4.0:
+        return False
+    return True
+
+
+def _place_records(records: list[dict]) -> np.ndarray | None:
+    order = records[:]
+    random.shuffle(order)
+    holes_by_x = [rec["holes"] for rec in order]
+    if holes_by_x in ([0, 1, 2, 3], [3, 2, 1, 0]):
+        return None
+
+    sizes = [rec["mask"].shape[0] for rec in order]
+    total_w = sum(sizes)
+    min_w = total_w + 9
+    max_w = min(30, total_w + 14)
+    if min_w > max_w:
+        return None
+    width = random.randint(min_w, max_w)
+
+    max_size = max(sizes)
+    height = random.randint(max(14, max_size + 7), min(22, max_size + 11))
+
+    margin_total = width - total_w
+    if margin_total < 5:
+        return None
+
+    # Five positive gaps: left margin, three internal gaps, right margin.
+    cuts = sorted(random.sample(range(1, margin_total), 4))
+    pieces = [
+        cuts[0],
+        cuts[1] - cuts[0],
+        cuts[2] - cuts[1],
+        cuts[3] - cuts[2],
+        margin_total - cuts[3],
+    ]
+    if min(pieces) <= 0:
+        return None
+    left_margin = pieces[0]
+    inner_gaps = pieces[1:4]
+
+    grid = np.full((height, width), BG, dtype=int)
+    base_center = random.randint(max_size // 2 + 2, height - (max_size // 2) - 3)
+    col = left_margin
+    for idx, rec in enumerate(order):
+        size = rec["mask"].shape[0]
+        jitter = random.randint(-2, 2)
+        row = min(max(1, base_center - size // 2 + jitter), height - size - 1)
+        patch = _render_patch(rec["mask"], rec["color"])
+        if np.any(grid[row : row + size, col : col + size] != BG):
+            return None
+        grid[row : row + size, col : col + size] = patch
+        rec["row"] = row
+        rec["col"] = col
+        col += size
+        if idx < 3:
+            col += inner_gaps[idx]
+    return grid
+
+
+def _generate_records() -> list[dict] | None:
+    colors = list(PALETTE)
+    random.shuffle(colors)
+    records = []
+    used_sizes = set()
+    for hole_count in range(4):
+        size = random.choice(SIZE_OPTIONS[hole_count])
+        mask = _generate_mask(hole_count, size)
+        if mask is None:
+            return None
+        used_sizes.add(size)
+        records.append(
+            {
+                "holes": hole_count,
+                "color": colors[hole_count],
+                "mask": mask,
+                "row": None,
+                "col": None,
+            }
+        )
+
+    if len(used_sizes) < 2:
+        return None
+    return records
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        records = _generate_records()
+        if records is None:
+            continue
+        colors_by_hole = [rec["color"] for rec in sorted(records, key=lambda rec: rec["holes"])]
+        if colors_by_hole == sorted(colors_by_hole) or colors_by_hole == sorted(colors_by_hole, reverse=True):
+            continue
+
+        for _placement in range(PLACEMENT_ATTEMPTS):
+            placed = [
+                {
+                    "holes": rec["holes"],
+                    "color": rec["color"],
+                    "mask": rec["mask"].copy(),
+                    "row": None,
+                    "col": None,
+                }
+                for rec in records
+            ]
+            grid = _place_records(placed)
+            if grid is None:
+                continue
+            if _validate_instance(grid, placed):
+                return grid
+    raise RuntimeError("failed to generate valid input")

