+def _place_records(records: list[dict]) -> np.ndarray | None:
+    order = records[:]
+    random.shuffle(order)
+    holes_by_x = [rec["holes"] for rec in order]
+    if holes_by_x in ([0, 1, 2, 3], [3, 2, 1, 0]):
+        return None
+
+    sizes = [rec["mask"].shape[0] for rec in order]
+    total_w = sum(sizes)
+    min_w = total_w + 9
+    max_w = min(30, total_w + 14)
+    if min_w > max_w:
+        return None
+    width = random.randint(min_w, max_w)
+
+    max_size = max(sizes)
+    height = random.randint(max(14, max_size + 7), min(22, max_size + 11))
+
+    margin_total = width - total_w
+    if margin_total < 5:
+        return None
+
+    # Five positive gaps: left margin, three internal gaps, right margin.
+    cuts = sorted(random.sample(range(1, margin_total), 4))
+    pieces = [
+        cuts[0],
+        cuts[1] - cuts[0],
+        cuts[2] - cuts[1],
+        cuts[3] - cuts[2],
+        margin_total - cuts[3],
+    ]
+    if min(pieces) <= 0:
+        return None
+    left_margin = pieces[0]
+    inner_gaps = pieces[1:4]
+
+    grid = np.full((height, width), BG, dtype=int)
+    base_center = random.randint(max_size // 2 + 2, height - (max_size // 2) - 3)
+    col = left_margin
+    for idx, rec in enumerate(order):
+        size = rec["mask"].shape[0]
+        jitter = random.randint(-2, 2)
+        row = min(max(1, base_center - size // 2 + jitter), height - size - 1)
+        patch = _render_patch(rec["mask"], rec["color"])
+        if np.any(grid[row : row + size, col : col + size] != BG):
+            return None
+        grid[row : row + size, col : col + size] = patch
+        rec["row"] = row
+        rec["col"] = col
+        col += size
+        if idx < 3:
+            col += inner_gaps[idx]
+    return grid
+
+
+def _generate_records() -> list[dict] | None:
+    colors = list(PALETTE)
+    random.shuffle(colors)
+    records = []
+    used_sizes = set()
+    for hole_count in range(4):
+        size = random.choice(SIZE_OPTIONS[hole_count])
+        mask = _generate_mask(hole_count, size)
+        if mask is None:
+            return None
+        used_sizes.add(size)
+        records.append(
+            {
+                "holes": hole_count,
+                "color": colors[hole_count],
+                "mask": mask,
+                "row": None,
+                "col": None,
+            }
+        )
+
+    if len(used_sizes) < 2:
+        return None
+    return records
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        records = _generate_records()
+        if records is None:
+            continue
+        colors_by_hole = [rec["color"] for rec in sorted(records, key=lambda rec: rec["holes"])]
+        if colors_by_hole == sorted(colors_by_hole) or colors_by_hole == sorted(colors_by_hole, reverse=True):
+            continue
+
+        for _placement in range(PLACEMENT_ATTEMPTS):
+            placed = [
+                {
+                    "holes": rec["holes"],
+                    "color": rec["color"],
+                    "mask": rec["mask"].copy(),
+                    "row": None,
+                    "col": None,
+                }
+                for rec in records
+            ]
+            grid = _place_records(placed)
+            if grid is None:
+                continue
+            if _validate_instance(grid, placed):
+                return grid
+    raise RuntimeError("failed to generate valid input")

