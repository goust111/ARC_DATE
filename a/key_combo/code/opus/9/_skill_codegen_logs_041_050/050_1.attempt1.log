+    if holes_by_x in ([0, 1, 2, 3], [3, 2, 1, 0]):
+        return False
+    if colors_by_x == sorted(colors_by_x) or colors_by_x == sorted(colors_by_x, reverse=True):
+        return False
+    if len(heights) < 2:
+        return False
+    if max(row_centers) - min(row_centers) > 4.0:
