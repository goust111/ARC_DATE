+        mask = patch == color
+        hole_count = _count_holes(mask)
+        if hole_count > 0 and np.array_equal(mask, np.rot90(mask, -hole_count)):
+            return False
+        holes.append(hole_count)
+        colors_by_x.append(color)
+        holes_by_x.append(hole_count)
+        heights.add(_rotated_patch(mask, color, hole_count).shape[0])
+        row_centers.append((r0 + r1) / 2.0)
