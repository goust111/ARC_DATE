+        return False
+
+    holes = []
+    colors_by_x = []
+    holes_by_x = []
+    heights = set()
+    row_centers = []
+    for comp in sorted(components, key=lambda comp: comp["bbox"][1]):
+        color = int(comp["color"])
+        box = tuple(int(x) for x in comp["bbox"])
+        r0, c0, r1, c1 = box
