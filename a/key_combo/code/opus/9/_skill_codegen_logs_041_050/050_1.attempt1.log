+
+    sizes = [rec["mask"].shape[0] for rec in order]
+    total_w = sum(sizes)
+    min_w = total_w + 9
+    max_w = min(30, total_w + 14)
+    if min_w > max_w:
+        return None
+    width = random.randint(min_w, max_w)
+
+    max_size = max(sizes)
