+from __future__ import annotations
+
+from collections import Counter, deque
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4)
+SIZE_OPTIONS = {
+    0: (3, 4, 5, 6),
+    1: (3, 4, 5, 6),
+    2: (4, 5, 6),
+    3: (5, 6),
+}
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 300
+PLACEMENT_ATTEMPTS = 120
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(mask: np.ndarray):
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box):
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _tight_crop(grid: np.ndarray, bg: int = BG) -> np.ndarray:
+    box = _bbox(grid != bg)
+    assert box is not None
+    return _crop_bbox(grid, box)
+
+
+def _components_of_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    comps = []
+    for color in sorted(int(x) for x in np.unique(grid) if int(x) != bg):
+        for coords in _components_of_mask(grid == color):
+            box = _bbox((grid == color) & _coords_to_mask(grid.shape, coords))
+            assert box is not None
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": box,
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+def _coords_to_mask(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    if coords.size:
+        mask[coords[:, 0], coords[:, 1]] = True
+    return mask
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    return len(_components_of_mask(mask)) == 1
+
+
+def _count_holes(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _valid_square_mask(mask: np.ndarray, hole_count: int) -> bool:
+    if mask.ndim != 2 or mask.shape[0] != mask.shape[1]:
+        return False
+    if not mask.any():
+        return False
+    box = _bbox(mask)
+    if box != (0, 0, mask.shape[0] - 1, mask.shape[1] - 1):
+        return False
+    if not _is_connected(mask):
+        return False
+    if _count_holes(mask) != hole_count:
+        return False
+    return True
+
+
+def _pick_isolated_holes(size: int, hole_count: int):
+    if hole_count == 0:
+        return []
+    cells = [(r, c) for r in range(1, size - 1) for c in range(1, size - 1)]
+    combos = []
+    for seed_cells in itertools.combinations(cells, hole_count):
+        ok = True
+        for i, (r0, c0) in enumerate(seed_cells):
+            for r1, c1 in seed_cells[i + 1 :]:
+                if abs(r0 - r1) + abs(c0 - c1) <= 1:
+                    ok = False
+                    break
+            if not ok:
+                break
+        if ok:
+            combos.append(seed_cells)
+    return random.choice(combos) if combos else None
+
+
+def _generate_mask(hole_count: int, size: int) -> np.ndarray | None:
+    min_area = max(7, size + hole_count + 2)
+    for _ in range(SHAPE_ATTEMPTS):
+        seeds = _pick_isolated_holes(size, hole_count)
+        if seeds is None:
+            continue
+
+        mask = np.ones((size, size), dtype=bool)
+        for r, c in seeds:
+            mask[r, c] = False
+        if not _valid_square_mask(mask, hole_count):
+            continue
+
+        target_steps = random.randint(max(1, hole_count), max(2, size + hole_count))
+        for _step in range(target_steps):
+            candidates = [(r, c) for r, c in np.argwhere(mask)]
+            random.shuffle(candidates)
+            changed = False
+            for r, c in candidates:
+                trial = mask.copy()
+                trial[r, c] = False
+                if trial.sum() < min_area:
+                    continue
+                if not _valid_square_mask(trial, hole_count):
+                    continue
+                mask = trial
+                changed = True
+                break
+            if not changed:
+                break
+
+        if hole_count == 0:
+            if np.array_equal(mask, np.rot90(mask, 1)) or np.array_equal(mask, np.rot90(mask, 2)):
+                continue
+        else:
+            if np.array_equal(mask, np.rot90(mask, -hole_count)):
+                continue
+
+        return mask
+    return None
+
+
+def _render_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    return np.where(mask, int(color), BG).astype(int)
+
+
+def _rotated_patch(mask: np.ndarray, color: int, hole_count: int) -> np.ndarray:
+    patch = _render_patch(mask, color)
+    rotated = np.rot90(patch, -hole_count)
+    return _tight_crop(rotated, BG)
+
+
+def _concat_top_aligned(patches: list[np.ndarray]) -> np.ndarray:
+    max_h = max(int(p.shape[0]) for p in patches)
+    total_w = sum(int(p.shape[1]) for p in patches)
+    out = np.full((max_h, total_w), BG, dtype=int)
+    c0 = 0
+    for patch in patches:
+        h, w = patch.shape
+        out[:h, c0 : c0 + w] = patch
+        c0 += w
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Rotate each sprite by 90 degrees times its hole count, then pack the rotated crops left-to-right.
+
+    Input structure
+    - Black (0) is the background.
+    - Exactly four separated 4-connected monochrome sprites of distinct non-black colors appear on the canvas.
+    - Each sprite has a tight square bounding box and encloses 0, 1, 2, or 3 black hole components.
+
+    Rule
+    - For each sprite, count its enclosed 4-connected black hole regions.
+    - Rotate that sprite clockwise by hole_count * 90 degrees around the center of its square bounding box.
+    - Crop the rotated sprite to its tight bounding box, sort sprites by their original left bbox edge, and concatenate the crops horizontally with top alignment and black padding below shorter crops.
+
+    Key insight
+    - The rotation angle is encoded by topology: the number of enclosed holes, not the color, size, or a fixed orientation.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+
+    components = _find_components(g, bg)
+    assert len(components) == 4
+
+    items = []
+    hole_counts = []
+    for comp in components:
+        color = int(comp["color"])
+        box = tuple(int(x) for x in comp["bbox"])
+        r0, c0, r1, c1 = box
+        assert (r1 - r0) == (c1 - c0)
+        patch = _crop_bbox(g, box)
+        mask = patch == color
