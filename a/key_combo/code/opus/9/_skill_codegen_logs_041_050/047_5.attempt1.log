            search(
                unused_sprites - {sprite_index},
                remaining_cells - cells,
                [*assignments, (sprite_index, cells)],
            )

    search(frozenset(range(len(sprites))), all_hole_cells, [])
    assert len(solutions) == 1
    return solutions[0]


