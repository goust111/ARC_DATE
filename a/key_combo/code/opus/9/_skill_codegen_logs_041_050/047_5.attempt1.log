+    meta_objects.sort(key=lambda item: item["bbox"])
+    meta = {
+        "objects": meta_objects,
+        "has_wrong_side_decoy": has_wrong_side_decoy,
+        "has_same_side_mismatch": has_same_side_mismatch,
+    }
+
+    try:
