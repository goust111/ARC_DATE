+BG = 0
+LEFT_WALL = 1
+RIGHT_WALL = 2
+FRAME = 5
+
+DIR_BY_COLOR = {LEFT_WALL: -1, RIGHT_WALL: 1}
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
