+    captures: dict[int, dict] = {}
+    used_frames: set[int] = set()
+    for idx, obj in enumerate(scene["objects"]):
+        frame = _capture_frame_for_object(obj, scene["frames"])
+        if frame is None:
+            continue
+        assert frame["index"] not in used_frames
+        captures[idx] = frame
+        used_frames.add(frame["index"])
