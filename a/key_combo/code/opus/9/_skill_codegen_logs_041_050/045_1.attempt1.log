    inp[SOURCE_ROWS, SOURCE_COLS] = np.where(source_mask, SOURCE_COLOR, BG_COLOR)
    inp[MARKER_ROWS, MARKER_COLS] = np.where(MARKER_MASKS[go_left], MARKER_COLOR, BG_COLOR)
    return inp

