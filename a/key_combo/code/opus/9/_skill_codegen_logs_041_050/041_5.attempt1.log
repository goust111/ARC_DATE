+    proto_cols = sorted(set(map(int, vertex_coords[:, 1])))
+    anchor_rows = np.flatnonzero(anchor_mask.any(axis=1)).astype(int).tolist()
+    anchor_cols = np.flatnonzero(anchor_mask.any(axis=0)).astype(int).tolist()
