# Canvas and background bounds.
BG_COLOR = 0
CANVAS_MIN_SIZE = 11
CANVAS_MAX_SIZE = 13

# Sprite geometry bounds.
SPRITE_MIN_HEIGHT = 1
SPRITE_MAX_HEIGHT = 5
SPRITE_MIN_WIDTH = 1
SPRITE_MAX_WIDTH = 3
SPRITE_MIN_AREA = 3
SPRITE_MAX_AREA = 6

