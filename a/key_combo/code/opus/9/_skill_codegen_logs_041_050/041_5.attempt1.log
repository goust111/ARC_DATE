+
+    return vertices, edges
+
+
+def _paint_line_interior(out: np.ndarray, a: tuple[int, int], b: tuple[int, int], color: int) -> None:
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        c0, c1 = sorted((ac, bc))
+        if c1 - c0 > 1:
+            out[ar, c0 + 1 : c1] = int(color)
+        return
+    assert ac == bc
+    r0, r1 = sorted((ar, br))
+    if r1 - r0 > 1:
+        out[r0 + 1 : r1, ac] = int(color)
+
+
