def _randint(bounds: tuple[int, int]) -> int:
    return random.randint(bounds[0], bounds[1])


def _gen_count_for_fraction(total: int, lo: float, hi: float) -> int:
    low = int(np.ceil(total * lo))
    high = int(np.floor(total * hi))
