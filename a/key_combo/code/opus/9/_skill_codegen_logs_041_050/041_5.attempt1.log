+    else:
+        if len(guide_cols) != 2 or guide_rows:
+            return False
+
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
