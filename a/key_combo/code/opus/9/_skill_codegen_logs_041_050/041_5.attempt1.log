+def _build_prototype() -> np.ndarray | None:
+    for _ in range(300):
+        node_h = random.randint(4, 5)
+        node_w = random.randint(4, 5)
+        segment_count = random.randint(4, 5)
+        segments = _build_polyline_segments(node_h, node_w, segment_count)
