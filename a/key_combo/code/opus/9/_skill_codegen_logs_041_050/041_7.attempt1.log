+def _draw_centered_ring(canvas: np.ndarray, size: int, color: int) -> None:
+    n = canvas.shape[0]
+    inset = (n - size) // 2
+    hi = inset + size - 1
+    canvas[inset, inset : hi + 1] = color
+    canvas[hi, inset : hi + 1] = color
+    canvas[inset : hi + 1, inset] = color
+    canvas[inset : hi + 1, hi] = color
+
