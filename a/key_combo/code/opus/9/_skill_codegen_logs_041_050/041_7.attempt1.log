+        return [(0, 0)]
+    coords: list[tuple[int, int]] = []
+    hi = size - 1
+    for c in range(size):
+        coords.append((0, c))
+        coords.append((hi, c))
+    for r in range(1, hi):
+        coords.append((r, 0))
+        coords.append((r, hi))
