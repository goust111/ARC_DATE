+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+GAP_COLOR = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_size(mask: np.ndarray) -> int:
+    box = _bbox(mask)
+    assert box is not None
+    r0, c0, r1, c1 = box
+    return max(int(r1 - r0 + 1), int(c1 - c0 + 1))
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _count_components(mask: np.ndarray, connectivity: int = 4) -> int:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    steps = _neighbors4 if connectivity == 4 else None
+    assert steps is not None
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            count += 1
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in steps(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+    return count
+
+
+def _ring_coords(size: int) -> list[tuple[int, int]]:
+    if size == 1:
+        return [(0, 0)]
+    coords: list[tuple[int, int]] = []
+    hi = size - 1
+    for c in range(size):
+        coords.append((0, c))
+        coords.append((hi, c))
+    for r in range(1, hi):
+        coords.append((r, 0))
+        coords.append((r, hi))
+    return coords
+
