+        size = outer_size - 2 * layer * gap
+        if size <= 0:
+            continue
+        _draw_centered_ring(out, size, int(color))
+    return out
+
+
+def _rebuild_using_observed_sizes(sorted_layers: list[tuple[int, int]]) -> np.ndarray:
