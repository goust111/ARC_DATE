+from __future__ import annotations
+
+from collections import deque
+import hashlib
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+PINK = 6
+TEAL = 8
+
+GRID_WIDTH = 10
+HALF_WIDTH = 5
+HEIGHT_RANGE = (12, 24)
+MARKER_ROWS = (0, 2)
+MARKER_COL_IN_HALF = 3
+MAX_GENERATION_ATTEMPTS = 2000
+
+_USED_OUTPUT_SIGNATURES: set[bytes] = set()
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _neighbors8(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    )
+
+
+def _component_coords(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    neigh = _neighbors4 if connectivity == 4 else _neighbors8
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neigh(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _coords_to_mask(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[coords[:, 0], coords[:, 1]] = True
+    return mask
+
+
+def _interior_holes(mask: np.ndarray, coords: np.ndarray) -> list[np.ndarray]:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    holes: list[np.ndarray] = []
+    for hole in _component_coords(~sub, connectivity=4):
+        touches_edge = np.any(
+            (hole[:, 0] == 0)
+            | (hole[:, 1] == 0)
+            | (hole[:, 0] == sub.shape[0] - 1)
+            | (hole[:, 1] == sub.shape[1] - 1)
+        )
+        if not touches_edge:
+            shifted = hole.copy()
+            shifted[:, 0] += r0
+            shifted[:, 1] += c0
+            holes.append(shifted)
+    return holes
+
+
+def _outline_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    outline = np.zeros_like(mask, dtype=bool)
+    rows, cols = np.where(mask)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = rows + dr
+            cc = cols + dc
+            ok = (0 <= rr) & (rr < h) & (0 <= cc) & (cc < w)
+            outline[rr[ok], cc[ok]] = True
+    outline &= ~mask
+    return outline
+
+
+def _tile_seed(seed: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    reps_r = (h + seed.shape[0] - 1) // seed.shape[0]
+    reps_c = (w + seed.shape[1] - 1) // seed.shape[1]
+    tiled = np.tile(seed, (reps_r, reps_c))
+    return tiled[:h, :w]
+
+
+def _select_marked_half(grid: np.ndarray) -> np.ndarray:
+    marker = np.argwhere(grid == RED)
+    assert marker.shape == (2, 2), "expected exactly two red marker pixels"
+    assert int(marker[0, 1]) == int(marker[1, 1]), "markers must share one column"
+    half_w = grid.shape[1] // 2
+    if np.all(marker[:, 1] < half_w):
+        return grid[:, :half_w]
+    if np.all(marker[:, 1] >= half_w):
+        return grid[:, half_w:]
+    raise AssertionError("marker column must lie fully in one half")
+
+
+def _crop_seed_from_half(half: np.ndarray) -> np.ndarray:
+    row_has_fg = np.any(half != BLACK, axis=1)
+    assert np.any(row_has_fg), "selected half must contain non-background cells"
+    rows = np.flatnonzero(row_has_fg)
+    return half[int(rows[0]) : int(rows[-1]) + 1].copy()
+
+
+def _transform_tiled_blue_grid(tiled: np.ndarray) -> np.ndarray:
+    out = tiled.copy()
+    blue_mask = tiled == BLUE
+    for coords in _component_coords(blue_mask, connectivity=4):
+        comp_mask = _coords_to_mask(tiled.shape, coords)
+        holes = _interior_holes(comp_mask, coords)
+        solid = comp_mask.copy()
+        if holes:
+            out[comp_mask] = TEAL
+            for hole in holes:
+                out[hole[:, 0], hole[:, 1]] = PINK
+                solid[hole[:, 0], hole[:, 1]] = True
+        outline = _outline_mask(solid)
+        out[outline & (out == BLACK)] = RED
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Crop the marker-selected half, tile it across the canvas, then recolor outlined components based on emergent holes.
+
+    Input structure:
+    - The grid has black background, two red marker pixels in one column, and blue foreground pixels in both left and right 5-column halves.
+    - The two red markers both lie in the same half and identify which half to keep.
+    - In the marked half, the non-black rows form a compact 5-column seed patch; blue figures inside that seed have no holes before tiling.
+
+    Rule:
+    - Keep the half containing the two red markers, crop it to the marked half's non-black row span, and erase the red markers to black.
+    - Periodically repeat that cropped 5-column seed vertically and horizontally from the top-left until it fills the original grid size.
+    - For each blue 4-connected component in the tiled result, detect enclosed 4-connected background holes inside its bounding box.
+    - Hole-free components stay blue and receive a one-cell red 8-neighborhood outline on background cells only.
+    - Components with holes are recolored teal, their holes are filled magenta, and the same red outline is drawn around the solid-plus-hole region.
+
+    Key insight:
+    - The chosen seed itself is not hollow, but repeating it can make vertically adjacent copies join and create new enclosed holes at the seams, so hole detection must happen after tiling rather than on the cropped seed alone.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[1] % 2 == 0
+
+    seed_half = _select_marked_half(g)
+    seed = _crop_seed_from_half(seed_half)
+    seed[seed == RED] = BLACK
+    tiled = _tile_seed(seed, g.shape)
+    return _transform_tiled_blue_grid(tiled)
+
+
+def _special_component_emerges(mask: np.ndarray) -> bool:
+    if mask.shape[1] != HALF_WIDTH:
+        return False
+    comps = _component_coords(mask, connectivity=4)
+    if len(comps) != 1:
+        return False
+    coords = comps[0]
+    if not mask[0].any() or not mask[-1].any():
+        return False
+    if _interior_holes(mask, coords):
+        return False
+
+    tiled = np.tile(mask, (3, 1))
+    for comp in _component_coords(tiled, connectivity=4):
+        comp_mask = _coords_to_mask(tiled.shape, comp)
+        holes = _interior_holes(comp_mask, comp)
+        if holes:
+            r0, _, r1, _ = _bbox_coords(comp)
+            if r1 - r0 + 1 > mask.shape[0]:
+                return True
+    return False
+
+
+def _enumerate_base_special_components() -> list[np.ndarray]:
+    bases: list[np.ndarray] = []
+    for bits in range(1, 1 << 12):
+        small = np.array([(bits >> i) & 1 for i in range(12)], dtype=bool).reshape(4, 3)
+        if len(_component_coords(small, connectivity=4)) != 1:
+            continue
+        seed = np.zeros((4, HALF_WIDTH), dtype=bool)
+        seed[:, :3] = small
+        if _special_component_emerges(seed):
+            bases.append(seed)
+    assert bases, "failed to build special seed library"
+    return bases
+
+
+_BASE_SPECIAL_COMPONENTS = _enumerate_base_special_components()
+
+
+def _make_selected_seed(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        seed = _BASE_SPECIAL_COMPONENTS[int(rng.integers(len(_BASE_SPECIAL_COMPONENTS)))].copy()
+        h = seed.shape[0]
+        aux_rows = (h // 2 - 1, h // 2)
+        seed[aux_rows[0], HALF_WIDTH - 1] = True
+        seed[aux_rows[1], HALF_WIDTH - 1] = True
+        if _seed_has_required_branches(seed):
+            return seed.astype(int)
+    raise RuntimeError("failed to build a valid selected seed")
+
+
+def _other_half_shapes() -> list[np.ndarray]:
+    return [
+        np.array(
+            [
+                [1, 1, 0],
+                [1, 0, 0],
+                [1, 0, 0],
+            ],
+            dtype=int,
+        ),
+        np.array(
+            [
+                [1, 1, 1],
+                [0, 1, 0],
+            ],
+            dtype=int,
+        ),
+        np.array(
+            [
+                [1, 0],
+                [1, 1],
+                [0, 1],
+            ],
+            dtype=int,
+        ),
+        np.array(
+            [
+                [1, 1, 0],
+                [0, 1, 1],
+            ],
+            dtype=int,
+        ),
+    ]
+
+
+_OTHER_HALF_SHAPES = _other_half_shapes()
+
+
+def _place_patch(dst: np.ndarray, patch: np.ndarray, top: int, left: int, color: int) -> None:
+    rr, cc = np.where(patch != 0)
+    dst[top + rr, left + cc] = color
+
+
+def _seed_has_required_branches(seed: np.ndarray) -> bool:
+    comps = _component_coords(seed == BLUE, connectivity=4)
+    if len(comps) < 2:
+        return False
+    if any(_interior_holes(_coords_to_mask(seed.shape, c), c) for c in comps):
+        return False
+
+    tiled = _tile_seed(seed, (12, GRID_WIDTH))
+    holeful = 0
+    holefree = 0
+    seam_hole = False
+    for comp in _component_coords(tiled == BLUE, connectivity=4):
+        comp_mask = _coords_to_mask(tiled.shape, comp)
+        holes = _interior_holes(comp_mask, comp)
+        if holes:
+            holeful += 1
+            r0, _, r1, _ = _bbox_coords(comp)
+            if r1 - r0 + 1 > seed.shape[0]:
+                seam_hole = True
+        else:
+            holefree += 1
+    return holeful >= 1 and holefree >= 1 and seam_hole
+
+
+def _validate_generated_example(grid: np.ndarray) -> bool:
+    if grid.shape[1] != GRID_WIDTH:
+        return False
+    if not np.array_equal(np.unique(grid), np.array(sorted(set(np.unique(grid))), dtype=grid.dtype)):
+        return False
+
+    markers = np.argwhere(grid == RED)
+    if markers.shape != (2, 2) or int(markers[0, 1]) != int(markers[1, 1]):
+        return False
+
+    selected_half = _select_marked_half(grid)
+    seed = _crop_seed_from_half(selected_half)
+    if seed.shape[1] != HALF_WIDTH:
+        return False
+    seed = seed.copy()
+    seed[seed == RED] = BLACK
+    if not _seed_has_required_branches(seed):
+        return False
+
+    out = main(grid)
+    colors = set(map(int, np.unique(out)))
+    if not {BLUE, RED, PINK, TEAL}.issubset(colors):
+        return False
+
+    tiled = _tile_seed(seed, grid.shape)
+    if np.array_equal(tiled, out):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        seed = _make_selected_seed(rng)
+        seed_h = seed.shape[0]
+        height = int(rng.integers(max(HEIGHT_RANGE[0], seed_h * 3), HEIGHT_RANGE[1] + 1))
+        grid = np.zeros((height, GRID_WIDTH), dtype=int)
+
+        selected_side = int(rng.integers(2))
+        other_side = 1 - selected_side
+        selected_left = selected_side * HALF_WIDTH
+        other_left = other_side * HALF_WIDTH
+
+        _place_patch(grid, seed, 0, selected_left, BLUE)
+        marker_col = selected_left + MARKER_COL_IN_HALF
+        grid[MARKER_ROWS[0], marker_col] = RED
+        grid[MARKER_ROWS[1], marker_col] = RED
+
+        other = _OTHER_HALF_SHAPES[int(rng.integers(len(_OTHER_HALF_SHAPES)))]
+        other_top = int(rng.integers(max(1, height - other.shape[0] - 3), height - other.shape[0] + 1))
+        other_left_offset = int(rng.integers(0, HALF_WIDTH - other.shape[1] + 1))
+        _place_patch(grid, other, other_top, other_left + other_left_offset, BLUE)
+
+        if not _validate_generated_example(grid):
+            continue
+
+        out = main(grid)
+        sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).digest()
+        if sig in _USED_OUTPUT_SIGNATURES:
+            continue
+        _USED_OUTPUT_SIGNATURES.add(sig)
+        return grid
+
+    raise RuntimeError("failed to generate a valid input for puzzle 5")

