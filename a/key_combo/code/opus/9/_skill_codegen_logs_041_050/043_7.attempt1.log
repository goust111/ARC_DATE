+                coords = {(r0 + int(dr), c0 + int(dc)) for dr, dc in np.argwhere(mask != 0)}
+                infos.append(
+                    {
+                        "bbox": (r0, c0, r0 + mh - 1, c0 + mw - 1),
+                        "coords": sorted(coords),
+                        "coord_set": coords,
