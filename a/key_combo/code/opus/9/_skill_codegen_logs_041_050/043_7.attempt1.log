+    counts = {}
+    for idx, touch in enumerate(touch_infos):
+        cnt = 0
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in touch["coord_set"]:
+                    cnt += 1
