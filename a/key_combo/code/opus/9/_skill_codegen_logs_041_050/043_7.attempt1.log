+            did_place = False
+            for r0, c0 in positions:
+                cells = {(r0 + int(dr), c0 + int(dc)) for dr, dc in np.argwhere(mask != 0)}
+                if cells & occupied:
+                    continue
+                if any((nr, nc) in occupied for r, c in cells for nr, nc in _neighbors4(r, c)):
+                    continue
+                for r, c in cells:
+                    src[r, c] = color
