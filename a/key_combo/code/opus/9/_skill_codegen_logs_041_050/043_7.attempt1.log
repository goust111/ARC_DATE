+    return candidates
+
+
+def _infer_rule(src: np.ndarray, dst: np.ndarray) -> tuple[str, dict[int, int]]:
+    candidates = _infer_rule_candidates(src, dst)
+    if len(candidates) != 1:
+        raise AssertionError(f"expected unique rule, got {candidates}")
