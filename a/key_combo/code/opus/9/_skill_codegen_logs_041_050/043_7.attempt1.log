+def _frame_canvas(h: int, w: int, color: int, inner: np.ndarray) -> np.ndarray:
+    out = np.zeros((h, w), dtype=int)
+    out[0, :] = color
+    out[-1, :] = color
+    out[:, 0] = color
+    out[:, -1] = color
+    out[1:-1, 1:-1] = inner
+    return out
