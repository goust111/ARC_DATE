+                    winner, tied = _winner_from_counts(counts, touch_infos)
+                    seen_cells.add(key)
+                    candidates.append(
+                        {
+                            "cells": cells,
+                            "bbox": (r0, c0, r0 + mh - 1, c0 + mw - 1),
+                            "counts": counts,
+                            "contributors": contributors,
+                            "winner": winner,
+                            "tied": tied,
+                        }
+                    )
