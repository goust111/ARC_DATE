+    return {
+        "bbox": (r0, c0, r1, c1),
+        "patch": moved,
+        "coords": coords,
+        "coord_set": set(coords),
+        "color": colors[0] if len(colors) == 1 else None,
+        "colors": colors,
+    }
+
+
+def _winner_for_non_touch(comp: dict, touch_infos: list[dict]) -> tuple[int, dict]:
+    counts = {}
+    for idx, touch in enumerate(touch_infos):
+        count = 0
+        for r, c in comp["coords"]:
