+
+        grid = np.zeros((canvas_h, canvas_w), dtype=int)
+        r_train = 1
+        c_train_a = side_gap - 1
+        c_train_b = canvas_w - side_gap - train_b.shape[1] + 1
+        r_test = train_a.shape[0] + top_gap
+        c_test = (canvas_w - test_patch.shape[1]) // 2
+        try:
