+BASE_TOUCH_SHAPES = [
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=int),
+    np.array([[1, 1, 1], [0, 0, 1]], dtype=int),
+    np.array([[1, 1, 0, 0], [0, 1, 1, 0], [0, 0, 1, 0]], dtype=int),
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 0]], dtype=int),
