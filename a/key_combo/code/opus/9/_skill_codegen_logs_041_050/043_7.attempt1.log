+    occupied = set().union(*(touch["coord_set"] for touch in touch_infos))
+    candidates: list[dict] = []
+    seen_cells: set[frozenset[tuple[int, int]]] = set()
+    for base in INTERNAL_SHAPES:
+        variants = []
+        for k in range(4):
+            rot = np.rot90(base, k)
+            key = rot.tobytes()
+            if all(key != v.tobytes() for v in variants):
