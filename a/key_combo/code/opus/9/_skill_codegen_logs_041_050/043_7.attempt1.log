+            if not any(cand["contributors"] >= 2 for cand in chosen):
+                return None
+            return [cand.copy() for cand in chosen]
+        if idx >= len(candidates):
+            return None
+        for j in range(idx, len(candidates)):
+            cand = candidates[j]
+            if not _non_touch_compatible(chosen, cand):
