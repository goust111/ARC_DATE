+                )
+
+        flip_matters = False
+        idx = 0
+        for info in infos:
+            if info["touch"]:
+                continue
+            winner_no_flip, _meta = _winner_for_non_touch(info, no_flip_touch_infos)
+            if winner_no_flip != true_winners[idx][0]:
+                flip_matters = True
+                break
+            if any(true_winners[idx][1][k] != _meta["counts"][k] for k in true_winners[idx][1]):
+                flip_matters = True
+                break
+            idx += 1
+        if not flip_matters:
+            continue
+
+        if not np.array_equal(main(_wrap_test_only(inp_inner)), out_inner):
+            continue
+        return inp_inner, out_inner
+    return None
+
+
+def _frame_canvas(h: int, w: int, color: int, inner: np.ndarray) -> np.ndarray:
+    out = np.zeros((h, w), dtype=int)
+    out[0, :] = color
+    out[-1, :] = color
+    out[:, 0] = color
+    out[:, -1] = color
+    out[1:-1, 1:-1] = inner
+    return out
+
+
+def _paste_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
