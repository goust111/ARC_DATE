GEN_NOTCH_INTERVAL_GAP, GEN_NOTCH_FLAT_PAD, GEN_NOTCH_CLEARANCE_PAD = 2, 2, 1
GEN_PROFILE_CLEARANCE = 2
GEN_NOTCH_CAPACITY_WIDTH_OFFSET, GEN_NOTCH_CAPACITY_STRIDE = 3, 4
