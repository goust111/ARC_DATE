+def _paste_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    if np.any(grid[r0 : r0 + h, c0 : c0 + w] != 0):
+        raise AssertionError("patch overlap")
+    grid[r0 : r0 + h, c0 : c0 + w] = patch
