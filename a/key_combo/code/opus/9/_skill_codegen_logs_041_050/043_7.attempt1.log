+        for a, b in zip(moved.ravel(), dst.ravel()):
+            a = int(a)
+            b = int(b)
+            if a == 0:
+                if b != 0:
+                    ok = False
+                    break
+                continue
+            if b == 0:
+                ok = False
+                break
