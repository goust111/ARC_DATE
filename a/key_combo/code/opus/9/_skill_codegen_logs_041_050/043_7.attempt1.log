+    cells = {(r0 + int(dr), c0 + int(dc)) for dr in range(h) for dc in range(w)}
+    if occupied & cells:
+        return False
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in occupied:
