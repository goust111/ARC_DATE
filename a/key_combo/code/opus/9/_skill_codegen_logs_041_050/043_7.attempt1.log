+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+GREY = 5
+TRANSFORMS = ("hflip", "vflip")
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _label_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _apply_transform(arr: np.ndarray, kind: str) -> np.ndarray:
+    if kind == "hflip":
+        return np.fliplr(arr)
+    if kind == "vflip":
+        return np.flipud(arr)
+    raise ValueError(kind)
+
+
+def _recolor(arr: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    out = arr.copy()
+    for src, dst in mapping.items():
+        out[arr == src] = dst
+    return out
+
+
+def _inverse_mapping(mapping: dict[int, int]) -> dict[int, int]:
+    return {v: k for k, v in mapping.items()}
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    frames: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(g) if int(v) != 0):
+        for comp in _label_components(g == color):
+            r0, c0, r1, c1 = _bbox(comp)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h != w or h < 4:
+                continue
+            if len(comp) != 2 * (h + w) - 4:
+                continue
+            patch = g[r0 : r1 + 1, c0 : c1 + 1]
+            if not (
+                np.all(patch[0, :] == color)
+                and np.all(patch[-1, :] == color)
+                and np.all(patch[:, 0] == color)
+                and np.all(patch[:, -1] == color)
+            ):
+                continue
+            if np.any(patch[1:-1, 1:-1] == color):
+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "inner": patch[1:-1, 1:-1].copy(),
+                }
+            )
