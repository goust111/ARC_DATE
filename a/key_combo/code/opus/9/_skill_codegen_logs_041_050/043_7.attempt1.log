GEN_THREE_CYCLE_PATCH_HEIGHT_RANGE, GEN_THREE_CYCLE_PATCH_WIDTH_RANGE = (3, 7), (3, 9)
GEN_PERIMETER_RANGE, GEN_CONVEX_RANGE, GEN_CONCAVE_RANGE = (8, 42), (4, 12), (0, 8)
GEN_CONVEX_CONCAVE_DELTA = 4

