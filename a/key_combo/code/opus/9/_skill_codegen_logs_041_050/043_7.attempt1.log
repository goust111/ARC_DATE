+        return [np.flipud(shape) for shape in BASE_TOUCH_SHAPES]
+    if side == "left":
+        return [shape.T for shape in BASE_TOUCH_SHAPES]
+    return [np.fliplr(shape.T) for shape in BASE_TOUCH_SHAPES]
