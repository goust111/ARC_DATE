+
+def _swap_mapping(palette: list[int]) -> dict[int, int]:
+    shuffled = palette[:]
+    random.shuffle(shuffled)
+    mapping = {}
+    for i in range(0, len(shuffled), 2):
+        a = shuffled[i]
+        b = shuffled[i + 1]
+        mapping[a] = b
+        mapping[b] = a
+    return mapping
