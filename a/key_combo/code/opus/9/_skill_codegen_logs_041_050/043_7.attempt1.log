+        colors = sorted({int(inner[r, c]) for r, c in comp})
+        r0, c0, r1, c1 = _bbox(comp)
+        infos.append(
+            {
+                "coords": comp,
+                "coord_set": set(comp),
+                "bbox": (r0, c0, r1, c1),
+                "colors": colors,
+                "touch": any(r in (0, inner.shape[0] - 1) or c in (0, inner.shape[1] - 1) for r, c in comp),
