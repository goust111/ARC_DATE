+def _transform_component(inner: np.ndarray, info: dict, kind: str, mapping: dict[int, int]) -> dict:
+    r0, c0, r1, c1 = info["bbox"]
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
