+def _build_training_pair(kind: str, mapping: dict[int, int], palette: list[int], size: int) -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(120):
+        src = np.zeros((size, size), dtype=int)
+        occupied: set[tuple[int, int]] = set()
+        colors = palette[:]
+        random.shuffle(colors)
