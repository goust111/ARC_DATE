+def _wrap_test_only(inner: np.ndarray) -> np.ndarray:
+    patch = _frame_canvas(inner.shape[0] + 2, inner.shape[1] + 2, GREY, inner)
+    return patch
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
