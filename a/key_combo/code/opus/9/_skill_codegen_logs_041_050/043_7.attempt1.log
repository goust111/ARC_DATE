+    random.shuffle(colors)
+    touch_colors = colors[: len(sides)]
+    if len(set(touch_colors)) < 2:
+        return None
+    side = sides[0]
+    shapes_a = _oriented_touch_shapes(mode, side)
+    shapes_b = _oriented_touch_shapes(mode, side)
