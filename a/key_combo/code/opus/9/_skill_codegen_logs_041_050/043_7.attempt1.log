+def _counts_for_cells(cells: set[tuple[int, int]], touch_infos: list[dict]) -> dict[int, int]:
+    counts = {}
+    for idx, touch in enumerate(touch_infos):
+        cnt = 0
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in touch["coord_set"]:
+                    cnt += 1
