+        w_max = random.randint(min_w, 9)
+        widths = [w_max] * h
+        current = w_max
+        reduced = False
+        for r in range(seed_h, h):
+            if current > seed_w + 2 and random.random() < 0.45:
+                current -= 1
+                reduced = True
+            widths[r] = current
+        if not reduced:
+            cut = random.randint(seed_h, h - 1)
+            if widths[cut] > seed_w + 2:
