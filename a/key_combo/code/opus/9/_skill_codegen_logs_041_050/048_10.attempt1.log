+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+CONTOUR_COLOR = 5
+DISTRACTOR_COLOR = 9
+SEED_COLOR_POOL = (1, 2, 3, 4, 6, 7, 8)
+
+GRID_H_RANGE = (20, 28)
+GRID_W_RANGE = (20, 28)
+REGION_COUNT_OPTIONS = (2, 3)
+REGION_AREA_RANGE = (25, 60)
+SEED_SIZE_OPTIONS = ((2, 2), (2, 3), (3, 2), (3, 3))
+OUTSIDE_NOISE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).flatten())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def label_mask(mask: np.ndarray, connectivity: int = 4) -> tuple[np.ndarray, int]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    n = 0
+    deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    if int(connectivity) == 8:
+        deltas += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            n += 1
+            q = deque([(r, c)])
+            labels[r, c] = n
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in deltas:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = n
+                        q.append((nr, nc))
+    return labels, n
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _component_count(mask: np.ndarray) -> int:
+    _, n = label_mask(mask, connectivity=4)
+    return int(n)
+
+
+def _periodic_match(pattern: np.ndarray, ph: int, pw: int) -> bool:
+    h, w = pattern.shape
+    base = pattern[:ph, :pw]
+    tiled = np.tile(base, (h // ph, w // pw))
+    return bool(np.array_equal(pattern, tiled))
+
+
+def _has_full_period(pattern: np.ndarray) -> bool:
+    h, w = pattern.shape
+    for ph in range(1, h + 1):
+        if h % ph:
+            continue
+        for pw in range(1, w + 1):
+            if w % pw:
+                continue
+            if ph == h and pw == w:
+                continue
+            if _periodic_match(pattern, ph, pw):
+                return False
+    return True
+
+
+def _seed_origin(seed_mask: np.ndarray) -> tuple[int, int]:
+    coords = np.argwhere(seed_mask)
+    order = np.lexsort((coords[:, 1], coords[:, 0]))
+    r0, c0 = coords[order[0]]
+    return int(r0), int(c0)
+
+
+def _detect_seed(grid: np.ndarray, region_mask: np.ndarray) -> tuple[tuple[int, int], np.ndarray, np.ndarray]:
+    allowed = region_mask & (~np.isin(grid, [BG_COLOR, CONTOUR_COLOR, DISTRACTOR_COLOR]))
+    assert bool(allowed.any()), "region must contain a seed"
+    r0, c0 = _seed_origin(allowed)
+
+    w = 0
+    while c0 + w < grid.shape[1] and allowed[r0, c0 + w]:
+        w += 1
+    h = 0
+    while r0 + h < grid.shape[0] and allowed[r0 + h, c0]:
+        h += 1
+
+    seed_mask = np.zeros_like(region_mask, dtype=bool)
+    seed_mask[r0 : r0 + h, c0 : c0 + w] = True
+    assert bool(np.all(allowed[seed_mask])), "seed rectangle must be filled"
+    assert not bool((allowed & ~seed_mask).any()), "seed must be the only non-distractor motif inside its region"
+    return (r0, c0), grid[r0 : r0 + h, c0 : c0 + w].copy(), seed_mask
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    bg_lab, n_bg = label_mask(g == bg, connectivity=4)
+    assert n_bg >= 2, "expected an exterior background component and enclosed regions"
+    sizes = {k: int((bg_lab == k).sum()) for k in range(1, n_bg + 1)}
+    exterior_id = max(sizes, key=sizes.get)
+
+    passable_lab, _ = label_mask(g != CONTOUR_COLOR, connectivity=4)
+    records: list[dict] = []
+    seen_passable: set[int] = set()
+    for bg_id in range(1, n_bg + 1):
+        if bg_id == exterior_id:
+            continue
+        coords = np.argwhere(bg_lab == bg_id)
+        assert coords.size > 0
+        pr, pc = map(int, coords[0])
+        pass_id = int(passable_lab[pr, pc])
+        if pass_id in seen_passable:
+            continue
+        seen_passable.add(pass_id)
+        region_mask = passable_lab == pass_id
+        origin, seed, seed_mask = _detect_seed(g, region_mask)
+        records.append(
+            {
+                "mask": region_mask,
+                "seed_origin": origin,
+                "seed": seed,
+                "seed_mask": seed_mask,
+                "bbox": bbox_coords(np.argwhere(region_mask)),
+            }
+        )
+
+    records.sort(key=lambda rec: rec["bbox"])
+    return records
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Tile each enclosed region with its top-left seed motif while preserving maroon distractors.
+
+    Input structure:
+    - Black background surrounds several grey one-cell contour loops.
+    - Every loop encloses one irregular interior region containing one small top-left
+      rectangular seed motif and 1-3 maroon distractor pixels.
+    - Foreground noise may also appear outside the contour loops and must be ignored.
+
+    Rule:
+    - Treat all non-background pixels as barriers and find 4-connected background
+      components; the largest is the exterior, while the others identify enclosed regions.
+    - For each enclosed region, recover the unique top-left rectangular seed made of
+      non-background, non-grey, non-maroon cells.
+    - Repeat that seed periodically from its own top-left corner across the whole
+      contour-bounded region, clipping to the region and leaving maroon distractors unchanged.
+
+    Key insight:
+    - The contour decides which area belongs to each independent tiling problem, and
+      the seed's anchored top-left position fixes the phase of the repeated motif.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    for record in _extract_regions(g):
+        region_mask = record["mask"]
+        seed = record["seed"]
+        r0, c0 = record["seed_origin"]
+        sh, sw = seed.shape
+        for r, c in np.argwhere(region_mask):
+            rr = int(r)
+            cc = int(c)
+            if int(g[rr, cc]) == DISTRACTOR_COLOR:
+                continue
+            out[rr, cc] = int(seed[(rr - r0) % sh, (cc - c0) % sw])
+    return out
