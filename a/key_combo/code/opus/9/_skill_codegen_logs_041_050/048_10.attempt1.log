+        w_max = random.randint(min_w, 9)
+        widths = [w_max] * h
+        current = w_max
+        reduced = False
+        for r in range(seed_h, h):
+            if current > seed_w + 2 and random.random() < 0.45:
+                current -= 1
+                reduced = True
+            widths[r] = current
+        if not reduced:
+            cut = random.randint(seed_h, h - 1)
+            if widths[cut] > seed_w + 2:
+                for r in range(cut, h):
+                    widths[r] -= 1
+                reduced = True
+        area = sum(widths)
+        if not reduced:
+            continue
+        if not (REGION_AREA_RANGE[0] <= area <= REGION_AREA_RANGE[1]):
+            continue
+        if seed_h * seed_w > (h * w_max) / 4.0:
+            continue
+        return widths
+    return None
+
+
+def _interior_mask_from_widths(widths: list[int]) -> np.ndarray:
+    h = len(widths)
+    w = max(widths)
+    mask = np.zeros((h + 2, w + 2), dtype=bool)
+    for r, width in enumerate(widths):
+        mask[1 + r, 1 : 1 + width] = True
+    return mask
+
+
+def _contour_mask(interior: np.ndarray) -> np.ndarray:
+    contour = np.zeros_like(interior, dtype=bool)
+    h, w = interior.shape
+    for r, c in np.argwhere(interior):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and not interior[nr, nc]:
+                contour[nr, nc] = True
+    return contour
+
+
+def _pick_distractors(interior: np.ndarray, seed_mask: np.ndarray, target_count: int) -> list[tuple[int, int]] | None:
+    current_blocked = seed_mask.copy()
+    if _component_count(interior & ~current_blocked) != 1:
+        return None
+
+    candidates = [(int(r), int(c)) for r, c in np.argwhere(interior & ~seed_mask)]
+    random.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    for r, c in candidates:
+        if len(chosen) >= target_count:
+            break
+        trial = current_blocked.copy()
+        trial[r, c] = True
+        if _component_count(interior & ~trial) == 1:
+            current_blocked = trial
+            chosen.append((r, c))
+    if len(chosen) != target_count:
+        return None
+    return chosen
+
+
+def _build_region_patch(seed: np.ndarray, widths: list[int]) -> tuple[np.ndarray, dict] | None:
+    interior = _interior_mask_from_widths(widths)
+    contour = _contour_mask(interior)
+    patch = np.full(interior.shape, BG_COLOR, dtype=int)
+    patch[contour] = CONTOUR_COLOR
+
+    sh, sw = seed.shape
+    patch[1 : 1 + sh, 1 : 1 + sw] = seed
+    seed_mask = np.zeros_like(interior, dtype=bool)
+    seed_mask[1 : 1 + sh, 1 : 1 + sw] = True
+
+    distractor_count = random.randint(1, 3)
+    distractors = _pick_distractors(interior, seed_mask, distractor_count)
+    if distractors is None:
+        return None
+    for r, c in distractors:
+        patch[r, c] = DISTRACTOR_COLOR
+
+    bg_inside = interior & (patch == BG_COLOR)
+    if _component_count(bg_inside) != 1:
+        return None
+
+    row_lengths = [int(np.count_nonzero(interior[1 + r])) for r in range(len(widths))]
+    meta = {
+        "irregular": len(set(row_lengths)) > 1,
+        "area": int(interior.sum()),
+        "seed_shape": seed.shape,
+        "distractor_count": distractor_count,
+        "local_region_mask": interior.copy(),
+    }
+    return patch, meta
+
+
+def _boxes_far_enough(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    if ar1 + gap < br0 or br1 + gap < ar0:
+        return True
+    if ac1 + gap < bc0 or bc1 + gap < ac0:
+        return True
+    return False
+
+
+def _place_regions(grid_h: int, grid_w: int, patches: list[np.ndarray]) -> list[tuple[int, int]] | None:
+    order = sorted(range(len(patches)), key=lambda i: int(np.count_nonzero(patches[i])), reverse=True)
+    placements: list[tuple[int, int] | None] = [None] * len(patches)
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        patch = patches[idx]
+        ph, pw = patch.shape
+        candidates = []
+        for r0 in range(1, grid_h - ph):
+            for c0 in range(1, grid_w - pw):
+                box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+                if all(_boxes_far_enough(box, other, 2) for other in boxes):
+                    candidates.append((r0, c0, box))
+        if not candidates:
+            return None
+        r0, c0, box = random.choice(candidates)
+        placements[idx] = (r0, c0)
+        boxes.append(box)
+
+    return [(int(r0), int(c0)) for r0, c0 in placements]
+
+
+def _compose_grid(grid_h: int, grid_w: int, patches: list[np.ndarray], placements: list[tuple[int, int]]) -> np.ndarray:
+    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)
+    for patch, (r0, c0) in zip(patches, placements):
+        ph, pw = patch.shape
+        view = grid[r0 : r0 + ph, c0 : c0 + pw]
+        mask = patch != BG_COLOR
+        view[mask] = patch[mask]
+    return grid
+
+
+def _add_outside_noise(grid: np.ndarray) -> None:
+    if random.random() < 0.35:
+        return
+    count = random.randint(1, 3)
+    h, w = grid.shape
+    candidates = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if grid[r, c] != BG_COLOR:
+                continue
+            neighborhood = grid[r - 1 : r + 2, c - 1 : c + 2]
+            if np.count_nonzero(neighborhood) == 0:
+                candidates.append((r, c))
+    random.shuffle(candidates)
+    for r, c in candidates[:count]:
+        grid[r, c] = random.choice(OUTSIDE_NOISE_COLORS)
+
+
+def _solid_fill_shortcut(grid: np.ndarray, regions: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for record in regions:
+        color = int(record["seed"][0, 0])
+        for r, c in np.argwhere(record["mask"]):
+            rr = int(r)
+            cc = int(c)
+            if int(out[rr, cc]) == DISTRACTOR_COLOR:
+                continue
+            out[rr, cc] = color
+    return out
+
+
+def _overwrite_distractors_shortcut(grid: np.ndarray, regions: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for record in regions:
+        seed = record["seed"]
+        r0, c0 = record["seed_origin"]
+        sh, sw = seed.shape
+        for r, c in np.argwhere(record["mask"]):
+            rr = int(r)
+            cc = int(c)
+            out[rr, cc] = int(seed[(rr - r0) % sh, (cc - c0) % sw])
+    return out
+
+
+def _validate_grid(inp: np.ndarray, expected_regions: int) -> bool:
+    try:
+        out = main(inp)
+        regions = _extract_regions(inp)
+    except Exception:
+        return False
+
+    if len(regions) != expected_regions:
+        return False
+    if np.array_equal(inp, out):
+        return False
+
+    irregular_regions = 0
+    total_internal_distractors = 0
+    changed_pixels = 0
+    for record in regions:
+        region_mask = record["mask"]
+        seed = record["seed"]
+        bbox = record["bbox"]
+        r0, c0, r1, c1 = bbox
+        area = int(region_mask.sum())
+        if not (REGION_AREA_RANGE[0] <= area <= REGION_AREA_RANGE[1]):
+            return False
+        sh, sw = seed.shape
+        if (sh, sw) not in SEED_SIZE_OPTIONS:
+            return False
+        if not _has_full_period(seed):
+            return False
+        if len(set(map(int, seed.flatten()))) < 2:
+            return False
+        if sh * sw > ((r1 - r0 + 1) * (c1 - c0 + 1)) / 4.0:
+            return False
+
+        bbox_mask = np.zeros_like(region_mask, dtype=bool)
+        bbox_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+        if not np.array_equal(region_mask, bbox_mask):
+            irregular_regions += 1
+
+        distractor_count = int(np.count_nonzero(region_mask & (inp == DISTRACTOR_COLOR)))
+        if not (1 <= distractor_count <= 3):
+            return False
+        total_internal_distractors += distractor_count
+
+        bg_inside = region_mask & (inp == BG_COLOR)
+        if _component_count(bg_inside) != 1:
+            return False
+
+        changed_pixels += int(np.count_nonzero(region_mask & (inp != out)))
+
+        visible_colors = set(map(int, out[region_mask & (out != DISTRACTOR_COLOR)]))
+        if len(visible_colors) < 2:
+            return False
+
+    if irregular_regions < 1 or total_internal_distractors < expected_regions or changed_pixels <= 6:
+        return False
+    if np.array_equal(out, _solid_fill_shortcut(inp, regions)):
+        return False
+    if np.array_equal(out, _overwrite_distractors_shortcut(inp, regions)):
+        return False
+    return True
+
+
+def _generate_example() -> np.ndarray | None:
+    region_count = random.choice(REGION_COUNT_OPTIONS)
+    colors = random.sample(SEED_COLOR_POOL, 2 * region_count)
+
+    patches: list[np.ndarray] = []
+    metas: list[dict] = []
+    for i in range(region_count):
+        seed_h, seed_w = random.choice(SEED_SIZE_OPTIONS)
+        seed = _make_seed(seed_h, seed_w, (colors[2 * i], colors[2 * i + 1]))
+        if seed is None:
+            return None
+        widths = _make_width_profile(seed_h, seed_w)
+        if widths is None:
+            return None
+        built = _build_region_patch(seed, widths)
+        if built is None:
+            return None
+        patch, meta = built
+        patches.append(patch)
+        metas.append(meta)
+
+    if not any(meta["irregular"] for meta in metas):
+        return None
+
+    grid_h = random.randint(*GRID_H_RANGE)
+    grid_w = random.randint(*GRID_W_RANGE)
+    placements = _place_regions(grid_h, grid_w, patches)
+    if placements is None:
+        return None
+
+    grid = _compose_grid(grid_h, grid_w, patches, placements)
+    _add_outside_noise(grid)
+
+    if not _validate_grid(grid, region_count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_example()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid enclosed-tiling ARC input")

