+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG_COLOR = 0
+CONTOUR_COLOR = 5
+DISTRACTOR_COLOR = 9
+SEED_COLOR_POOL = (1, 2, 3, 4, 6, 7, 8)
+
+GRID_H_RANGE = (20, 28)
+GRID_W_RANGE = (20, 28)
+REGION_COUNT_OPTIONS = (2, 3)
+REGION_AREA_RANGE = (25, 60)
+SEED_SIZE_OPTIONS = ((2, 2), (2, 3), (3, 2), (3, 3))
+OUTSIDE_NOISE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).flatten())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def label_mask(mask: np.ndarray, connectivity: int = 4) -> tuple[np.ndarray, int]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    n = 0
+    deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    if int(connectivity) == 8:
+        deltas += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            n += 1
+            q = deque([(r, c)])
+            labels[r, c] = n
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in deltas:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = n
+                        q.append((nr, nc))
+    return labels, n
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _component_count(mask: np.ndarray) -> int:
+    _, n = label_mask(mask, connectivity=4)
+    return int(n)
+
+
+def _periodic_match(pattern: np.ndarray, ph: int, pw: int) -> bool:
+    h, w = pattern.shape
+    base = pattern[:ph, :pw]
+    tiled = np.tile(base, (h // ph, w // pw))
+    return bool(np.array_equal(pattern, tiled))
+
+
+def _has_full_period(pattern: np.ndarray) -> bool:
+    h, w = pattern.shape
+    for ph in range(1, h + 1):
+        if h % ph:
+            continue
+        for pw in range(1, w + 1):
+            if w % pw:
+                continue
+            if ph == h and pw == w:
+                continue
+            if _periodic_match(pattern, ph, pw):
+                return False
+    return True
+
+
+def _seed_origin(seed_mask: np.ndarray) -> tuple[int, int]:
+    coords = np.argwhere(seed_mask)
+    order = np.lexsort((coords[:, 1], coords[:, 0]))
+    r0, c0 = coords[order[0]]
+    return int(r0), int(c0)
+
+
+def _detect_seed(grid: np.ndarray, region_mask: np.ndarray) -> tuple[tuple[int, int], np.ndarray, np.ndarray]:
+    allowed = region_mask & (~np.isin(grid, [BG_COLOR, CONTOUR_COLOR, DISTRACTOR_COLOR]))
+    assert bool(allowed.any()), "region must contain a seed"
+    r0, c0 = _seed_origin(allowed)
+
+    w = 0
+    while c0 + w < grid.shape[1] and allowed[r0, c0 + w]:
+        w += 1
+    h = 0
+    while r0 + h < grid.shape[0] and allowed[r0 + h, c0]:
+        h += 1
+
+    seed_mask = np.zeros_like(region_mask, dtype=bool)
+    seed_mask[r0 : r0 + h, c0 : c0 + w] = True
+    assert bool(np.all(allowed[seed_mask])), "seed rectangle must be filled"
+    assert not bool((allowed & ~seed_mask).any()), "seed must be the only non-distractor motif inside its region"
+    return (r0, c0), grid[r0 : r0 + h, c0 : c0 + w].copy(), seed_mask
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    bg_lab, n_bg = label_mask(g == bg, connectivity=4)
+    assert n_bg >= 2, "expected an exterior background component and enclosed regions"
+    sizes = {k: int((bg_lab == k).sum()) for k in range(1, n_bg + 1)}
+    exterior_id = max(sizes, key=sizes.get)
+
+    passable_lab, _ = label_mask(g != CONTOUR_COLOR, connectivity=4)
+    records: list[dict] = []
+    seen_passable: set[int] = set()
+    for bg_id in range(1, n_bg + 1):
+        if bg_id == exterior_id:
+            continue
+        coords = np.argwhere(bg_lab == bg_id)
+        assert coords.size > 0
+        pr, pc = map(int, coords[0])
+        pass_id = int(passable_lab[pr, pc])
+        if pass_id in seen_passable:
+            continue
+        seen_passable.add(pass_id)
+        region_mask = passable_lab == pass_id
+        origin, seed, seed_mask = _detect_seed(g, region_mask)
+        records.append(
+            {
+                "mask": region_mask,
+                "seed_origin": origin,
+                "seed": seed,
+                "seed_mask": seed_mask,
+                "bbox": bbox_coords(np.argwhere(region_mask)),
+            }
+        )
+
+    records.sort(key=lambda rec: rec["bbox"])
+    return records
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Tile each enclosed region with its top-left seed motif while preserving maroon distractors.
+
+    Input structure:
+    - Black background surrounds several grey one-cell contour loops.
+    - Every loop encloses one irregular interior region containing one small top-left
+      rectangular seed motif and 1-3 maroon distractor pixels.
+    - Foreground noise may also appear outside the contour loops and must be ignored.
+
+    Rule:
+    - Treat all non-background pixels as barriers and find 4-connected background
+      components; the largest is the exterior, while the others identify enclosed regions.
+    - For each enclosed region, recover the unique top-left rectangular seed made of
+      non-background, non-grey, non-maroon cells.
+    - Repeat that seed periodically from its own top-left corner across the whole
+      contour-bounded region, clipping to the region and leaving maroon distractors unchanged.
+
+    Key insight:
+    - The contour decides which area belongs to each independent tiling problem, and
+      the seed's anchored top-left position fixes the phase of the repeated motif.
+    """
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    for record in _extract_regions(g):
+        region_mask = record["mask"]
+        seed = record["seed"]
+        r0, c0 = record["seed_origin"]
+        sh, sw = seed.shape
+        for r, c in np.argwhere(region_mask):
+            rr = int(r)
+            cc = int(c)
+            if int(g[rr, cc]) == DISTRACTOR_COLOR:
+                continue
+            out[rr, cc] = int(seed[(rr - r0) % sh, (cc - c0) % sw])
+    return out
+
+
+def _make_seed(seed_h: int, seed_w: int, colors: tuple[int, int]) -> np.ndarray | None:
+    for _ in range(80):
+        seed = np.array(
+            [[random.choice(colors) for _ in range(seed_w)] for _ in range(seed_h)],
+            dtype=int,
+        )
+        seed[0, 0] = colors[0]
+        if len(set(map(int, seed.flatten()))) < 2:
+            continue
+        if _has_full_period(seed):
+            return seed
+    return None
+
+
+def _make_width_profile(seed_h: int, seed_w: int) -> list[int] | None:
+    min_h = max(6, seed_h + 3)
+    min_w = max(6, seed_w + 3)
+    for _ in range(120):
+        h = random.randint(min_h, 8)
+        w_max = random.randint(min_w, 9)
+        widths = [w_max] * h
+        current = w_max
+        reduced = False
+        for r in range(seed_h, h):
+            if current > seed_w + 2 and random.random() < 0.45:
+                current -= 1
+                reduced = True
+            widths[r] = current
+        if not reduced:
+            cut = random.randint(seed_h, h - 1)
+            if widths[cut] > seed_w + 2:
+                for r in range(cut, h):
+                    widths[r] -= 1
+                reduced = True
+        area = sum(widths)
+        if not reduced:
+            continue
+        if not (REGION_AREA_RANGE[0] <= area <= REGION_AREA_RANGE[1]):
+            continue
+        if seed_h * seed_w > (h * w_max) / 4.0:
+            continue
+        return widths
+    return None
+
+
+def _interior_mask_from_widths(widths: list[int]) -> np.ndarray:
+    h = len(widths)
+    w = max(widths)
+    mask = np.zeros((h + 2, w + 2), dtype=bool)
+    for r, width in enumerate(widths):
+        mask[1 + r, 1 : 1 + width] = True
+    return mask
+
+
+def _contour_mask(interior: np.ndarray) -> np.ndarray:
+    contour = np.zeros_like(interior, dtype=bool)
+    h, w = interior.shape
+    for r, c in np.argwhere(interior):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and not interior[nr, nc]:
+                contour[nr, nc] = True
+    return contour
+
+
+def _pick_distractors(interior: np.ndarray, seed_mask: np.ndarray, target_count: int) -> list[tuple[int, int]] | None:
+    current_blocked = seed_mask.copy()
+    if _component_count(interior & ~current_blocked) != 1:
+        return None
+
+    candidates = [(int(r), int(c)) for r, c in np.argwhere(interior & ~seed_mask)]
+    random.shuffle(candidates)
+    chosen: list[tuple[int, int]] = []
+    for r, c in candidates:
+        if len(chosen) >= target_count:
+            break
+        trial = current_blocked.copy()
+        trial[r, c] = True
+        if _component_count(interior & ~trial) == 1:
+            current_blocked = trial
+            chosen.append((r, c))
+    if len(chosen) != target_count:
+        return None
+    return chosen
+
+
+def _build_region_patch(seed: np.ndarray, widths: list[int]) -> tuple[np.ndarray, dict] | None:
+    interior = _interior_mask_from_widths(widths)
+    contour = _contour_mask(interior)
+    patch = np.full(interior.shape, BG_COLOR, dtype=int)
+    patch[contour] = CONTOUR_COLOR
+
+    sh, sw = seed.shape
+    patch[1 : 1 + sh, 1 : 1 + sw] = seed
+    seed_mask = np.zeros_like(interior, dtype=bool)
+    seed_mask[1 : 1 + sh, 1 : 1 + sw] = True
+
+    distractor_count = random.randint(1, 3)
+    distractors = _pick_distractors(interior, seed_mask, distractor_count)
+    if distractors is None:
+        return None
+    for r, c in distractors:
+        patch[r, c] = DISTRACTOR_COLOR
+
+    bg_inside = interior & (patch == BG_COLOR)
+    if _component_count(bg_inside) != 1:
+        return None
+
+    row_lengths = [int(np.count_nonzero(interior[1 + r])) for r in range(len(widths))]
+    meta = {
+        "irregular": len(set(row_lengths)) > 1,
+        "area": int(interior.sum()),
+        "seed_shape": seed.shape,
+        "distractor_count": distractor_count,
+        "local_region_mask": interior.copy(),
+    }
+    return patch, meta
+
+
+def _boxes_far_enough(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    if ar1 + gap < br0 or br1 + gap < ar0:
+        return True
+    if ac1 + gap < bc0 or bc1 + gap < ac0:
+        return True
+    return False
+
+
+def _place_regions(grid_h: int, grid_w: int, patches: list[np.ndarray]) -> list[tuple[int, int]] | None:
+    order = sorted(range(len(patches)), key=lambda i: int(np.count_nonzero(patches[i])), reverse=True)
+    placements: list[tuple[int, int] | None] = [None] * len(patches)
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for idx in order:
+        patch = patches[idx]
+        ph, pw = patch.shape
+        candidates = []
+        for r0 in range(1, grid_h - ph):
+            for c0 in range(1, grid_w - pw):
+                box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+                if all(_boxes_far_enough(box, other, 2) for other in boxes):
+                    candidates.append((r0, c0, box))
+        if not candidates:
+            return None
+        r0, c0, box = random.choice(candidates)
+        placements[idx] = (r0, c0)
+        boxes.append(box)
+
+    return [(int(r0), int(c0)) for r0, c0 in placements]
+
+
+def _compose_grid(grid_h: int, grid_w: int, patches: list[np.ndarray], placements: list[tuple[int, int]]) -> np.ndarray:
+    grid = np.full((grid_h, grid_w), BG_COLOR, dtype=int)
+    for patch, (r0, c0) in zip(patches, placements):
+        ph, pw = patch.shape
+        view = grid[r0 : r0 + ph, c0 : c0 + pw]
+        mask = patch != BG_COLOR
+        view[mask] = patch[mask]
+    return grid
+
+
+def _add_outside_noise(grid: np.ndarray) -> None:
+    if random.random() < 0.35:
+        return
+    count = random.randint(1, 3)
+    h, w = grid.shape
+    candidates = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if grid[r, c] != BG_COLOR:
+                continue
+            neighborhood = grid[r - 1 : r + 2, c - 1 : c + 2]
+            if np.count_nonzero(neighborhood) == 0:
+                candidates.append((r, c))
+    random.shuffle(candidates)
+    for r, c in candidates[:count]:
+        grid[r, c] = random.choice(OUTSIDE_NOISE_COLORS)
+
+
+def _solid_fill_shortcut(grid: np.ndarray, regions: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for record in regions:
+        color = int(record["seed"][0, 0])
+        for r, c in np.argwhere(record["mask"]):
+            rr = int(r)
+            cc = int(c)
+            if int(out[rr, cc]) == DISTRACTOR_COLOR:
+                continue
+            out[rr, cc] = color
+    return out
+
+
+def _overwrite_distractors_shortcut(grid: np.ndarray, regions: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for record in regions:
+        seed = record["seed"]
+        r0, c0 = record["seed_origin"]
+        sh, sw = seed.shape
+        for r, c in np.argwhere(record["mask"]):
+            rr = int(r)
+            cc = int(c)
+            out[rr, cc] = int(seed[(rr - r0) % sh, (cc - c0) % sw])
+    return out
+
+
+def _validate_grid(inp: np.ndarray, expected_regions: int) -> bool:
+    try:
+        out = main(inp)
+        regions = _extract_regions(inp)
+    except Exception:
+        return False
+
+    if len(regions) != expected_regions:
+        return False
+    if np.array_equal(inp, out):
+        return False
+
+    irregular_regions = 0
+    total_internal_distractors = 0
+    changed_pixels = 0
+    for record in regions:
+        region_mask = record["mask"]
+        seed = record["seed"]
+        bbox = record["bbox"]
+        r0, c0, r1, c1 = bbox
+        area = int(region_mask.sum())
+        if not (REGION_AREA_RANGE[0] <= area <= REGION_AREA_RANGE[1]):
+            return False
+        sh, sw = seed.shape
+        if (sh, sw) not in SEED_SIZE_OPTIONS:
+            return False
+        if not _has_full_period(seed):
+            return False
+        if len(set(map(int, seed.flatten()))) < 2:
+            return False
+        if sh * sw > ((r1 - r0 + 1) * (c1 - c0 + 1)) / 4.0:
+            return False
+
+        bbox_mask = np.zeros_like(region_mask, dtype=bool)
+        bbox_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+        if not np.array_equal(region_mask, bbox_mask):
+            irregular_regions += 1
+
+        distractor_count = int(np.count_nonzero(region_mask & (inp == DISTRACTOR_COLOR)))
+        if not (1 <= distractor_count <= 3):
+            return False
+        total_internal_distractors += distractor_count
+
+        bg_inside = region_mask & (inp == BG_COLOR)
+        if _component_count(bg_inside) != 1:
+            return False
+
+        changed_pixels += int(np.count_nonzero(region_mask & (inp != out)))
+
+        visible_colors = set(map(int, out[region_mask & (out != DISTRACTOR_COLOR)]))
+        if len(visible_colors) < 2:
+            return False
+
+    if irregular_regions < 1 or total_internal_distractors < expected_regions or changed_pixels <= 6:
+        return False
+    if np.array_equal(out, _solid_fill_shortcut(inp, regions)):
+        return False
+    if np.array_equal(out, _overwrite_distractors_shortcut(inp, regions)):
+        return False
+    return True
+
+
+def _generate_example() -> np.ndarray | None:
+    region_count = random.choice(REGION_COUNT_OPTIONS)
+    colors = random.sample(SEED_COLOR_POOL, 2 * region_count)
+
+    patches: list[np.ndarray] = []
+    metas: list[dict] = []
+    for i in range(region_count):
+        seed_h, seed_w = random.choice(SEED_SIZE_OPTIONS)
+        seed = _make_seed(seed_h, seed_w, (colors[2 * i], colors[2 * i + 1]))
+        if seed is None:
+            return None
+        widths = _make_width_profile(seed_h, seed_w)
+        if widths is None:
+            return None
+        built = _build_region_patch(seed, widths)
+        if built is None:
+            return None
+        patch, meta = built
+        patches.append(patch)
+        metas.append(meta)
+
+    if not any(meta["irregular"] for meta in metas):
+        return None
+
+    grid_h = random.randint(*GRID_H_RANGE)
+    grid_w = random.randint(*GRID_W_RANGE)
+    placements = _place_regions(grid_h, grid_w, patches)
+    if placements is None:
+        return None
+
+    grid = _compose_grid(grid_h, grid_w, patches, placements)
+    _add_outside_noise(grid)
+
+    if not _validate_grid(grid, region_count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_example()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid enclosed-tiling ARC input")

