+def _generate_example() -> np.ndarray | None:
+    region_count = random.choice(REGION_COUNT_OPTIONS)
+    colors = random.sample(SEED_COLOR_POOL, 2 * region_count)
+
+    patches: list[np.ndarray] = []
+    metas: list[dict] = []
+    for i in range(region_count):
+        seed_h, seed_w = random.choice(SEED_SIZE_OPTIONS)
+        seed = _make_seed(seed_h, seed_w, (colors[2 * i], colors[2 * i + 1]))
+        if seed is None:
+            return None
+        widths = _make_width_profile(seed_h, seed_w)
+        if widths is None:
+            return None
+        built = _build_region_patch(seed, widths)
+        if built is None:
+            return None
+        patch, meta = built
+        patches.append(patch)
+        metas.append(meta)
+
+    if not any(meta["irregular"] for meta in metas):
+        return None
+
+    grid_h = random.randint(*GRID_H_RANGE)
+    grid_w = random.randint(*GRID_W_RANGE)
+    placements = _place_regions(grid_h, grid_w, patches)
+    if placements is None:
+        return None
+
+    grid = _compose_grid(grid_h, grid_w, patches, placements)
+    _add_outside_noise(grid)
+
+    if not _validate_grid(grid, region_count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_example()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid enclosed-tiling ARC input")

