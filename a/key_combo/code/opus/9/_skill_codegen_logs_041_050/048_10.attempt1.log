+def _make_seed(seed_h: int, seed_w: int, colors: tuple[int, int]) -> np.ndarray | None:
+    for _ in range(80):
+        seed = np.array(
+            [[random.choice(colors) for _ in range(seed_w)] for _ in range(seed_h)],
+            dtype=int,
+        )
+        seed[0, 0] = colors[0]
+        if len(set(map(int, seed.flatten()))) < 2:
+            continue
