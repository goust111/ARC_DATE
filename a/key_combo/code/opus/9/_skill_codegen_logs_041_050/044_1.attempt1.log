+def _choose_present_tiles(mask: np.ndarray) -> np.ndarray:
+    n = mask.shape[0]
+    total = n * n
+    fg = {int(x) for x in np.flatnonzero(mask.reshape(-1))}
+    bg = {int(x) for x in np.flatnonzero((~mask).reshape(-1))}
