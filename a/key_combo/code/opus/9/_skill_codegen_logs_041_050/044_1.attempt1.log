+    extra_steps = int(_RNG.integers(0, k + 1))
+    for _ in range(extra_steps):
+        frontier = set()
+        for r, c in np.argwhere(block):
+            rr = int(r)
+            cc = int(c)
+            for dr, dc in _N8:
+                nr = rr + dr
+                nc = cc + dc
+                if 0 <= nr < k and 0 <= nc < k and not block[nr, nc]:
+                    frontier.add((nr, nc))
