+        required[top_cell].add((0, int(_RNG.integers(0, k))))
+        required[bottom_cell].add((k - 1, int(_RNG.integers(0, k))))
+        required[left_cell].add((int(_RNG.integers(0, k)), 0))
+        required[right_cell].add((int(_RNG.integers(0, k)), k - 1))
