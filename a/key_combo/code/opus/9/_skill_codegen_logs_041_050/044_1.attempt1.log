+    if not points:
+        points.add((int(_RNG.integers(0, k)), int(_RNG.integers(0, k))))
+    targets = list(points)
+    anchor = targets[int(_RNG.integers(0, len(targets)))]
+
+    connected = {anchor}
+    for target in targets:
+        rr, cc = anchor
+        while (rr, cc) != target:
+            rr += _sign(target[0] - rr)
+            cc += _sign(target[1] - cc)
+            connected.add((rr, cc))
