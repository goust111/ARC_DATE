OBJECT_COUNT_RANGE = (3, 7)
H_COUNT_OPTIONS = (2, 3)
V_COUNT_OPTIONS = (1, 2)
D_COUNT_OPTIONS = (0, 1, 2)
AREA_MIN = 6
AREA_MAX = 28
