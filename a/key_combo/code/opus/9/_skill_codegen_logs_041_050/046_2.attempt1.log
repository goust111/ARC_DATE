+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+PALETTE = (BLUE, RED, GREEN)
+SLOT_BY_KIND = {"H": 0, "V": 1, "D": 2}
+KIND_ORDER = ("H", "V", "D")
+GEN_ATTEMPTS = 400
