            continue

        cols = coords[:, 1]
        if np.all(cols < axis_col):
            side = -1
        elif np.all(cols > axis_col):
            side = 1
        else:
            continue

        touches_axis = any(
            int(r) in axis_rows and int(c) - side == axis_col
            for r, c in coords
