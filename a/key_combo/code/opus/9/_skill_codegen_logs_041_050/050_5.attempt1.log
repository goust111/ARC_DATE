+from __future__ import annotations
+
+import itertools
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GUIDE = 1
+FILL = 3
+FRAME = 4
+
+GEN_HEIGHT_RANGE = (17, 25)
+GEN_WIDTH_RANGE = (17, 25)
+GEN_FRAME_COUNT_CHOICES = (3, 4)
+GEN_LAYOUT_CHOICES = ((2, 0), (0, 2), (1, 1), (2, 1), (1, 2))
+GEN_FRAME_SIDE_RANGE = (4, 9)
+GEN_FRAME_MARGIN = 2
+GEN_FRAME_GAP = 1
+GEN_LINE_GAP = 3
+GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _find_frames(grid: np.ndarray) -> list[dict[str, tuple[int, int, int, int]]]:
+    frames: list[dict[str, tuple[int, int, int, int]]] = []
+    for coords in _connected_components(grid == FRAME):
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        if h < 4 or w < 4:
+            continue
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border_mask = np.zeros((h, w), dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
+        if np.count_nonzero(patch == FRAME) != (2 * h + 2 * w - 4):
+            continue
+        if not np.all(patch[border_mask] == FRAME):
+            continue
+        if not np.all(patch[1:-1, 1:-1] == BG):
+            continue
+        frames.append(
+            {
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "interior": (int(r0 + 1), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+            }
+        )
+    frames.sort(key=lambda frame: frame["bbox"])
+    return frames
+
+
+def _guide_rows_cols(grid: np.ndarray) -> tuple[list[int], list[int]]:
+    h, w = grid.shape
+    rows = [r for r in range(1, h - 1) if grid[r, 0] == GUIDE and grid[r, w - 1] == GUIDE]
+    cols = [c for c in range(1, w - 1) if grid[0, c] == GUIDE and grid[h - 1, c] == GUIDE]
+    return rows, cols
+
+
+def _draw_guides(base: np.ndarray, rows: list[int], cols: list[int]) -> np.ndarray:
+    out = base.copy()
+    frame_mask = out == FRAME
+    for r in rows:
+        row_mask = ~frame_mask[r]
+        out[r, row_mask] = GUIDE
+    for c in cols:
+        col_mask = ~frame_mask[:, c]
+        out[col_mask, c] = GUIDE
+    return out
+
+
+def _frame_is_hit(frame: dict[str, tuple[int, int, int, int]], rows: list[int], cols: list[int]) -> bool:
+    r0, c0, r1, c1 = frame["interior"]
+    return any(r0 <= r <= r1 for r in rows) or any(c0 <= c <= c1 for c in cols)
+
+
+def _frame_is_graze_only(
+    frame: dict[str, tuple[int, int, int, int]], rows: list[int], cols: list[int]
+) -> bool:
+    if _frame_is_hit(frame, rows, cols):
+        return False
+    r0, c0, r1, c1 = frame["bbox"]
+    graze_rows = {r0 - 1, r0, r1, r1 + 1}
+    graze_cols = {c0 - 1, c0, c1, c1 + 1}
+    return any(r in graze_rows for r in rows) or any(c in graze_cols for c in cols)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Draw blue guide lines from opposite-edge markers and fill only the hollow yellow frames whose interiors are pierced.
+
+    Input structure:
+    - Black is the background.
+    - Blue singleton markers appear on opposite borders as left-right row pairs and/or top-bottom column pairs.
+    - Yellow objects are single-pixel-thick hollow rectangles with black interiors.
+
+    Rule:
+    - Each left-right blue pair defines a full horizontal blue guide line on that row, and each top-bottom pair defines a full vertical blue guide line on that column.
+    - Guide lines are drawn through the whole row or column except that yellow frame-border pixels stay yellow.
+    - For each hollow yellow frame, inspect only its strict interior rectangle; if any blue guide pixel lies there, fill that entire interior green, otherwise leave it black.
+
+    Key insight:
+    - Filling depends on guide-line penetration into the enclosed interior space, not on merely touching or grazing the outside of the frame.
+    """
+    g = np.asarray(grid, dtype=int)
+    rows, cols = _guide_rows_cols(g)
+    out = _draw_guides(g, rows, cols)
+    for frame in _find_frames(g):
+        ir0, ic0, ir1, ic1 = frame["interior"]
+        if np.any(out[ir0 : ir1 + 1, ic0 : ic1 + 1] == GUIDE):
+            out[ir0 : ir1 + 1, ic0 : ic1 + 1] = FILL
+    return out
+
+
+def _sample_spaced_positions(rng: np.random.Generator, lo: int, hi: int, count: int) -> list[int] | None:
+    values = list(range(lo, hi + 1))
+    if count == 0:
+        return []
+    if count == 1:
+        return [int(values[int(rng.integers(len(values)))])]
+    combos = [
+        combo
+        for combo in itertools.combinations(values, count)
+        if all(combo[i + 1] - combo[i] >= GEN_LINE_GAP for i in range(len(combo) - 1))
+    ]
+    if not combos:
+        return None
+    choice = combos[int(rng.integers(len(combos)))]
+    return [int(v) for v in choice]
+
+
+def _classify_box(
+    box: tuple[int, int, int, int], rows: list[int], cols: list[int]
+) -> str:
+    r0, c0, r1, c1 = box
+    interior_hit = any(r0 < r < r1 for r in rows) or any(c0 < c < c1 for c in cols)
+    if interior_hit:
+        return "hit"
+    graze_rows = {r0 - 1, r0, r1, r1 + 1}
+    graze_cols = {c0 - 1, c0, c1, c1 + 1}
+    if any(r in graze_rows for r in rows) or any(c in graze_cols for c in cols):
+        return "graze"
+    return "far"
+
+
+def _boxes_conflict(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = GEN_FRAME_GAP) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0)
+
+
+def _candidate_boxes(
+    h: int, w: int, rows: list[int], cols: list[int]
+) -> dict[str, list[tuple[int, int, int, int]]]:
+    out: dict[str, list[tuple[int, int, int, int]]] = {"hit": [], "graze": [], "far": []}
+    for rh in range(*GEN_FRAME_SIDE_RANGE):
+        for cw in range(*GEN_FRAME_SIDE_RANGE):
+            for r0 in range(GEN_FRAME_MARGIN, h - rh - GEN_FRAME_MARGIN + 1):
+                r1 = r0 + rh - 1
+                for c0 in range(GEN_FRAME_MARGIN, w - cw - GEN_FRAME_MARGIN + 1):
+                    c1 = c0 + cw - 1
+                    box = (int(r0), int(c0), int(r1), int(c1))
+                    out[_classify_box(box, rows, cols)].append(box)
+    return out
+
+
+def _pick_boxes(
+    rng: np.random.Generator,
+    candidates: dict[str, list[tuple[int, int, int, int]]],
+    n_frames: int,
+) -> list[tuple[int, int, int, int]] | None:
+    extra_label = str(rng.choice(np.array(["hit", "graze", "far"], dtype=object)))
+    labels = ["hit", "graze", "far"] + ([extra_label] if n_frames == 4 else [])
+    rng.shuffle(labels)
+
+    pools: dict[str, list[tuple[int, int, int, int]]] = {}
+    for label, boxes in candidates.items():
+        if label in labels and not boxes:
+            return None
+        if len(boxes) <= 500:
+            pools[label] = boxes.copy()
+        else:
+            idx = rng.choice(len(boxes), size=500, replace=False)
+            pools[label] = [boxes[int(i)] for i in idx]
+        rng.shuffle(pools[label])
+
+    chosen: list[tuple[int, int, int, int]] = []
+
+    def backtrack(i: int) -> bool:
+        if i == len(labels):
+            return True
+        label = labels[i]
+        for box in pools[label]:
+            if any(_boxes_conflict(box, other) for other in chosen):
+                continue
+            chosen.append(box)
+            if backtrack(i + 1):
+                return True
+            chosen.pop()
+        return False
+
+    return chosen if backtrack(0) else None
+
+
+def _paint_frame(grid: np.ndarray, box: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = box
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
+
+
+def _build_input(
+    h: int, w: int, rows: list[int], cols: list[int], boxes: list[tuple[int, int, int, int]]
+) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    for r in rows:
+        grid[r, 0] = GUIDE
+        grid[r, w - 1] = GUIDE
+    for c in cols:
+        grid[0, c] = GUIDE
+        grid[h - 1, c] = GUIDE
+    for box in boxes:
+        _paint_frame(grid, box)
+    return grid
+
+
+def _validate_semantics(inp: np.ndarray, out: np.ndarray) -> bool:
+    if inp.ndim != 2 or out.ndim != 2 or inp.shape != out.shape:
+        return False
+    rows, cols = _guide_rows_cols(inp)
+    if len(rows) + len(cols) not in (2, 3):
+        return False
+    frames = _find_frames(inp)
+    if len(frames) not in (3, 4):
+        return False
+    if not rows and not cols:
+        return False
+
+    hit_flags = [_frame_is_hit(frame, rows, cols) for frame in frames]
+    graze_flags = [_frame_is_graze_only(frame, rows, cols) for frame in frames]
+    if not any(hit_flags):
+        return False
+    if not any(not flag for flag in hit_flags):
+        return False
+    if not any(graze_flags):
+        return False
+
+    yellow_mask = inp == FRAME
+    expected_guides = _draw_guides(inp, rows, cols)
+    if not np.all(out[yellow_mask] == FRAME):
+        return False
+
+    for frame, is_hit in zip(frames, hit_flags):
+        ir0, ic0, ir1, ic1 = frame["interior"]
+        interior = out[ir0 : ir1 + 1, ic0 : ic1 + 1]
+        if is_hit:
+            if not np.all(interior == FILL):
+                return False
+        else:
+            if not np.all(interior == BG):
+                return False
+
+    expected = expected_guides.copy()
+    for frame, is_hit in zip(frames, hit_flags):
+        if is_hit:
+            ir0, ic0, ir1, ic1 = frame["interior"]
+            expected[ir0 : ir1 + 1, ic0 : ic1 + 1] = FILL
+    return np.array_equal(out, expected)
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(*GEN_HEIGHT_RANGE))
+    w = int(rng.integers(*GEN_WIDTH_RANGE))
+    h_count, v_count = GEN_LAYOUT_CHOICES[int(rng.integers(len(GEN_LAYOUT_CHOICES)))]
+    rows = _sample_spaced_positions(rng, 1, h - 2, h_count)
+    cols = _sample_spaced_positions(rng, 1, w - 2, v_count)
+    if rows is None or cols is None:
