+        border_mask = np.zeros((h, w), dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
+        if np.count_nonzero(patch == FRAME) != (2 * h + 2 * w - 4):
+            continue
+        if not np.all(patch[border_mask] == FRAME):
+            continue
+        if not np.all(patch[1:-1, 1:-1] == BG):
