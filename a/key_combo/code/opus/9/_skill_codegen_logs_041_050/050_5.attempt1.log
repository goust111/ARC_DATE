+    candidates = _candidate_boxes(h, w, rows, cols)
+    n_frames = int(rng.choice(np.array(GEN_FRAME_COUNT_CHOICES, dtype=int)))
+    boxes = _pick_boxes(rng, candidates, n_frames)
+    if boxes is None:
