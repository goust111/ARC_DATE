+
+
+def _validate_generated(grid: np.ndarray) -> None:
+    out, traces, frames = _solve_with_traces(grid)
+    seeds = _find_seeds(grid)
+    assert 2 <= len(frames) <= 3
+    assert 3 <= len(seeds) <= 5
+    assert len(set(color for _, _, color in seeds)) >= 2
