+        if hit == (frame.r0, frame.c0):
+            start = (frame.r0 + 1, frame.c0 + 1)
+        elif hit == (frame.r0, frame.c1):
+            start = (frame.r0 + 1, frame.c1 - 1)
+        elif hit == (frame.r1, frame.c1):
