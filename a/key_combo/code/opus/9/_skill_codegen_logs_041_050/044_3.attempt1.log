+        "frame": frame,
+        "incoming": (dr, dc),
+        "wall_side": wall_side,
+        "hit": hit,
+        "outer": outer,
+        "inner": inner,
+        "corner": corner,
+    }
+
+
+def _solve_with_traces(grid: np.ndarray) -> tuple[np.ndarray, list[dict], list[Frame]]:
+    g = np.asarray(grid, dtype=int)
+    frames = _find_frames(g)
+    seeds = _find_seeds(g)
+
+    out = g.copy()
