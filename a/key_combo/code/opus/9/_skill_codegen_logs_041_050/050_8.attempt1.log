+        elif c0 == c1 and {r0, r1} == {0, H - 1}:
+            pairs.append({"color": color, "orientation": "v", "a": (min(r0, r1), c0), "b": (max(r0, r1), c1)})
+        else:
+            raise ValueError(f"color {color} is not placed on opposite edges")
