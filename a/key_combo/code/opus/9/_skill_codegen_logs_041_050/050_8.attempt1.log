+                multi_any = True
+        else:
+            empty_any = True
+            if np.any(interior != BG):
+                decoy_any = True
+
+    return inside_any and outside_any and empty_any and decoy_any and (multi_any or not require_multi)
+
+
+def generate_input() -> np.ndarray:
+    return _generate_case()
