+def _validate_generated_grid(grid: np.ndarray, require_multi: bool) -> bool:
+    try:
+        pairs = _find_edge_pairs(grid)
+        frames = _find_frames(grid)
+    except ValueError:
+        return False
+    if not (2 <= len(pairs) <= 3 and 3 <= len(frames) <= 4):
+        return False
+    if len({p["color"] for p in pairs}) != len(pairs):
