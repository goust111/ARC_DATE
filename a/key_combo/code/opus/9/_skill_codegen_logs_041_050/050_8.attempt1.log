+
+
+def _candidate_single_fill(
+    boxes: list[tuple[int, int, int, int]], rows: list[int], target_row: int, mc: int
+) -> list[tuple[int, int, int, int]]:
+    other_rows = {r for r in rows if r != target_row}
+    out = []
+    for r0, c0, r1, c1 in boxes:
