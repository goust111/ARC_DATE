+    for frame in _find_frames(g):
+        r0, c0, r1, c1 = frame["bbox"]
+        inside = [m for m in meetings if r0 < m["pos"][0] < r1 and c0 < m["pos"][1] < c1]
+        if not inside:
+            continue
+        out[r0 + 1 : r1, c0 + 1 : c1] = _choose_frame_color(frame, inside)
