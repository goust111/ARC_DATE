+    pairs: list[dict] = []
+    for color, coords in sorted(by_color.items()):
+        if len(coords) != 2:
+            raise ValueError(f"color {color} does not form exactly one edge pair")
+        (r0, c0), (r1, c1) = coords
+        if r0 == r1 and {c0, c1} == {0, W - 1}:
