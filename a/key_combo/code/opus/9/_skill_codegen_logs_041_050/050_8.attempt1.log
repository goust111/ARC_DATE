+        if gap % 2 == 1:
+            return r0, (c0 + c1) // 2
+        candidates = [(r0, c0 + gap // 2), (r0, c0 + gap // 2 + 1)]
+    else:
+        gap = r1 - r0 - 1
+        if gap % 2 == 1:
+            return (r0 + r1) // 2, c0
+        candidates = [(r0 + gap // 2, c0), (r0 + gap // 2 + 1, c0)]
