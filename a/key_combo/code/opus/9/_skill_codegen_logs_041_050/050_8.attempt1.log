+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _gray_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(H):
+        for c in range(W):
+            if int(grid[r, c]) != FRAME or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) == FRAME:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for comp in _gray_components(grid):
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4:
+            continue
+        border = {
+            (r0, c) for c in range(c0, c1 + 1)
+        } | {
+            (r1, c) for c in range(c0, c1 + 1)
+        } | {
+            (r, c0) for r in range(r0, r1 + 1)
+        } | {
+            (r, c1) for r in range(r0, r1 + 1)
+        }
+        comp_set = set(comp)
+        if comp_set != border:
+            continue
+        if r0 == 0 or c0 == 0 or r1 == grid.shape[0] - 1 or c1 == grid.shape[1] - 1:
+            continue
