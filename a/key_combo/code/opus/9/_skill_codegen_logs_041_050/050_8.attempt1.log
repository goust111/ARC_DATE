+def _candidate_multi_fill(
+    boxes: list[tuple[int, int, int, int]], rows: list[int], target_rows: tuple[int, int], mc: int
+) -> list[tuple[int, int, int, int]]:
+    target = set(target_rows)
+    other_rows = {r for r in rows if r not in target}
+    out = []
+    for bbox in boxes:
