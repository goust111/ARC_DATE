+
+
+def _all_frame_bboxes(H: int, W: int) -> list[tuple[int, int, int, int]]:
+    boxes = []
+    for h in range(4, min(8, H - 2) + 1):
+        for w in range(4, min(8, W - 2) + 1):
+            for r0 in range(1, H - h):
+                for c0 in range(1, W - w):
+                    boxes.append((r0, c0, r0 + h - 1, c0 + w - 1))
