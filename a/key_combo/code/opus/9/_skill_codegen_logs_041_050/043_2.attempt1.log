+        seed = (random.randrange(h), random.randrange(w))
+        cells = {seed}
+        mask[seed] = True
+        while len(cells) < area:
+            frontier = set()
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.add((nr, nc))
+            if not frontier:
