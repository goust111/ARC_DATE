+
+
+def _make_template_sprite(tile_size: int) -> np.ndarray | None:
+    for _ in range(200):
+        mask = _random_connected_mask(
+            min_area=4,
+            max_area=8,
+            max_h=min(4, tile_size),
+            max_w=min(4, tile_size),
+            reject_full_rectangle=False,
