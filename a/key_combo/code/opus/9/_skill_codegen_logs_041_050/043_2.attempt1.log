    block matching that sprite, ignoring grey erasures, with a solid block of
    the sprite's majority color. Replace a uniform blank block with the sprite.
    Separator rows and columns, including grey erasures on them, become black.

    Key insight
    The small sprite is a block-level code for one macro-cell state, and the
    uniform minority-color block is the other state; the output renders the
    opposite code in each macro-cell while cleaning erased pixels.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape

    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]
    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]
    row_intervals = _regular_intervals(row_separators, H)
    col_intervals = _regular_intervals(col_separators, W)
    block_heights = {r1 - r0 for r0, r1 in row_intervals}
    block_widths = {c1 - c0 for c0, c1 in col_intervals}
    assert block_heights == block_widths, "encoded blocks must be square"

    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})
    assert len(payload_colors) == 2, "expected exactly two non-separator payload colors"
    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)
    foreground, blank = _foreground_and_blank(sprite, payload_colors)

    out = np.zeros_like(g)
    for r0, r1 in row_intervals:
        for c0, c1 in col_intervals:
            block = g[r0:r1, c0:c1]
            known = block != ERASED
            assert known.any(), "each block must expose at least one non-grey cell"
            matches_sprite = bool(np.all(block[known] == sprite[known]))
            matches_blank = bool(np.all(block[known] == blank))
            assert matches_sprite != matches_blank, "each block must unambiguously match the sprite or blank state"
            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite

    return out

# --------------- generator (att2) ---------------

# Canvas and palette bounds.
GRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)
PAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
PAYLOAD_COLOR_COUNT = 2
GEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)

# Sprite composition constraints.
SPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)
SPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2

# Macro-cell state constraints.
MIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2

# Grey overlay constraints.
GREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25
GREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30
GREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300

NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _separator_indices(n: int, block_size: int) -> set[int]:
    return {(i + 1) * block_size + i for i in range(n - 1)}


def _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:
    return br * (block_size + 1), bc * (block_size + 1)


def _has_symmetry(mask: np.ndarray) -> bool:
    return (
        np.array_equal(mask, np.fliplr(mask))
        or np.array_equal(mask, np.flipud(mask))
        or np.array_equal(mask, np.rot90(mask, 2))
    )


def _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:
    area = block_size * block_size
    min_num, min_den = SPRITE_FG_MIN_RATIO
    max_num, max_den = SPRITE_FG_MAX_RATIO
    fg_min = math.ceil(area * min_num / min_den)
    fg_max = math.floor(area * max_num / max_den)
    if fg_min > fg_max:
        fg_min = fg_max = round(area * min_num / min_den)
    fg_count = random.randint(fg_min, fg_max)
    blank_count = area - fg_count

    for _ in range(SPRITE_ATTEMPTS):
        mask = np.ones((block_size, block_size), dtype=bool)
        if block_size == TINY_BLOCK_SIZE:
            blanks = [random.randrange(area)]
        else:
            cols = list(range(block_size))
            random.shuffle(cols)
            blanks = [r * block_size + cols[r] for r in range(block_size)]
            extra = blank_count - block_size
            if extra > 0:
                pool = [i for i in range(area) if i not in blanks]
                blanks.extend(random.sample(pool, extra))

        for idx in blanks:
            mask[idx // block_size, idx % block_size] = False

        if block_size > TINY_BLOCK_SIZE:
            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))
            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))
            if not row_mixed or not col_mixed:
                continue
        if _has_symmetry(mask):
            continue

        sprite = np.where(mask, foreground, blank).astype(int)
        return sprite
    return None


def _neighbors4(r: int, c: int, height: int, width: int):
    for dr, dc in NEIGHBOR_OFFSETS_4:
        nr, nc = r + dr, c + dc
        if 0 <= nr < height and 0 <= nc < width:
            yield nr, nc


def _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:
    comps = [
        [tuple(map(int, rc)) for rc in coords]
        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)
        if len(coords) >= size
    ]
    if not comps:
        return None

    comp = random.choice(comps)
    comp_set = set(comp)
    seed = random.choice(comp)
    blob = {seed}
    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}

    while len(blob) < size:
        if not frontier:
            return None
        cell = random.choice(tuple(frontier))
        frontier.remove(cell)
        blob.add(cell)
        for nb in _neighbors4(*cell, *allowed.shape):
            if nb in comp_set and nb not in blob:
                frontier.add(nb)
def generate_input() -> np.ndarray:
    for _ in range(GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste

# concepts:
# growing

# description:
# In the input you will see a grid with some green rectangles. Each rectangle has one red pixel on one of its borders.
# To make the output, you should extend the green region of each rectangle to the border of the grid in the direction of the red pixel, with the extent of the line increasing with the extent of the rectangle.
# Also you should draw a red line from the red pixel to the border of the grid.


def main(input_grid):
    """
    Grow each green rectangle outward from its red border indicator to the canvas edge.

    Input structure:
    - Each foreground object is a green rectangle with one red pixel on its border.
    - Objects sit on a black background.
    - The red pixel indicates the side from which growth should extend.

    Rule:
    - Find each rectangle-and-indicator component.
    - Extend a green band from the rectangle toward the canvas edge on the indicator side.
    - Draw a red line from the indicator pixel to that same edge.

    Key insight:
    - The indicator side controls direction, while the rectangle thickness controls the grown band.
    """
    # Initialize the output grid
    output_grid = np.copy(input_grid)
    
    rectangle_color = Color.GREEN
    indicator_color = Color.RED
    background = Color.BLACK

    # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
    objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
    for obj in objects:
        # find the red indicator
        for red_r, red_c in np.argwhere(obj == indicator_color):
            break

        # Get the dimensions of the object, and its position
        _b = bbox(obj != background)
        assert _b is not None
        r, c, _r1, _c1 = _b
        width = _r1 - r + 1
        height = _c1 - c + 1

        # depending on which side of the rectangle that the indicator is on, we draw in different directions
        # left edge: draw to the left
        if red_r == r:
            # Extend the green rectangle to the left until it reaches the border
            output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
        elif red_r == r + width - 1:
            # Extend the green rectangle to the right until it reaches the border
            output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
        elif red_c == c:
            # Extend the green rectangle to the top until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
        elif red_c == c + height - 1:
            # Extend the green rectangle to the bottom until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
        else:
            assert False, "The red pixel is not on the border of the rectangle"

    return output_grid

def generate_input():
    # Create the background grid
    n, m = np.random.randint(20, 30), np.random.randint(20, 30)
    grid = np.full((m, n), Color.BLACK)

    rectangle_num = 2
    rectangle_color = Color.GREEN
    indicator_color = Color.RED

    # Draw rectangles on the grid
    for i in range(rectangle_num):
        width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        # The width should be twice smaller than the height
        while (width * 2 + 2) >= height:
            width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        green_rectangle = np.full((width, height), rectangle_color)

        # Place one indicator pixel on one random border of the rectangle
        # Spare enough space for the extend line with the same size of width - 1
        r_coord = np.random.choice([0, width - 1])
        c_coord = np.random.choice(range(width + 1, height - (width + 1)))
        green_rectangle[r_coord, c_coord] = indicator_color
        # Randomly rotate the object so that we get a variety of orientations
        if np.random.choice([True, False]):
            green_rectangle = np.rot90(green_rectangle, k=-1)
            r_coord, c_coord = c_coord, r_coord

        # Place the rectangle on the grid
        try:
            _loc = first_free_location(grid, green_rectangle, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        # Check if there is no space for the rectangle
        except:
            return generate_input()
        paste(grid, green_rectangle, r, c, transparent=Color.BLACK, clip=True)

    # Check if the generated grid is valid
    transformed_grid = main(grid)
    objects = find_components(transformed_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")

    # After transformation, the two objects should not touch each other
    if len(objects) != rectangle_num:
        # Regenerate the grid
        return generate_input()

    return grid

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, bbox_anchor, crop_bbox, draw_line, find_components, first_free_location, paste

# concepts:
# pixel patterns, expansion, color sequence

# description:
# In the input you will see a grid with a cross pattern. Each pixel in the cross has a different color.
# To make the output, you should expand the cross right/left/top/bottom following the original color sequence of the cross.

def main(input_grid):
    """
    Extend a multicolor cross across the canvas by repeating its color sequences.

    Input structure:
    - The grid contains one connected multicolor cross on a black background.
    - One full row and one full column of the cropped sprite meet at the cross center.
    - The row and column colors form the sequences to repeat.

    Rule:
    - Crop the cross and locate the row and column that pass through its center.
    - Copy the input grid as the output canvas.
    - Paste the center column and center row sequences repeatedly in both directions.

    Key insight:
    - The cross is a seed for periodic extension: its central row and column are reused
      at intervals equal to their own lengths.
    """
    # Plan:
    # 1. Parse the input and create output canvas to draw on top of
    # 2. Extract the vertical and horizontal parts of the cross, and make note of the coordinate of the middle
    # 3. Expand the horizontal part to the right and left, aligned with the middle y coordinate
    # 4. Expand the vertical part to the top and bottom, aligned with the middle x coordinate    

    # 1. Input parsing
    # Extract the cross, which has many colors and so is not monochromatic.
    objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
    assert len(objects) == 1, "exactly one cross expected"
    obj = objects[0]
    _b = bbox(obj != Color.BLACK)
    assert _b is not None
    cross_r, cross_c = bbox_anchor(_b, anchor="upper left")

    # Create output grid, which we are going to draw on top of, so we start with the input grid
    output_grid = input_grid.copy()
    width, height = input_grid.shape

    # 2. Cross analysis: Extract subsprites, get the middle
    # Extract the horizontal/vertical parts of the cross sprite by figuring out where its middle is (where the horizontal and vertical lines meet)
    _b = bbox(obj != Color.BLACK)
    assert _b is not None
    sprite = crop_bbox(obj, _b)
    cross_width, cross_height = sprite.shape
    # Middle is where they meet
    cross_middle_r = next( r for r in range(cross_width) if np.all(sprite[r, :] != Color.BLACK) )
    cross_middle_c = next( c for c in range(cross_height) if np.all(sprite[:, c] != Color.BLACK) )
    # Extract the horizontal and vertical parts of the cross
    vertical_sprite = sprite[cross_middle_r:cross_middle_r+1, :]
    horizontal_sprite = sprite[:, cross_middle_c:cross_middle_c+1]

    # 3. Expand the horizontal line to the right and left
    r_start, c_start, len_line = cross_r, cross_c + cross_middle_c, cross_width
    for i in range(r_start, width, len_line):
        paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
    for i in range(r_start, -(len_line), -len_line):
        paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
    
    # 4. Expand the vertical line to the top and bottom
    r_start, c_start, len_line = cross_r + cross_middle_r, cross_c, cross_height
    for i in range(c_start, height, len_line):
        paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
    for i in range(c_start, -(len_line), -len_line):
        paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
        
    return output_grid

def generate_input():
    # Generate the background grid
    width, height = np.random.randint(20, 30, size=2)
    grid = np.full((width, height), Color.BLACK)

    # Randomly choose the number of colors
    num_colors = np.random.randint(2, 5)
    colors = np.random.choice(Color.NOT_BLACK, size=num_colors, replace=False)

    # Generate a line with these colors in sequence
    line = np.full((num_colors, 1), Color.BLACK)
    for i in range(num_colors):
        line[i, 0] = colors[i]

    # form a cross pattern randomly
    cross_points = random.randint(0, num_colors - 1)
    sprite = np.full((num_colors, num_colors), Color.BLACK)
    line_t = np.transpose(line)
    paste(sprite, line, 0, cross_points, transparent=Color.BLACK, clip=True)
    paste(sprite, line_t, cross_points, 0, transparent=Color.BLACK, clip=True)

    # Randomly rotate the pattern
    sprite = np.rot90(sprite, k=-(np.random.randint(4)))

    # Randomly place the pattern on the grid
    _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
    if _loc is None:
        raise ValueError("no placement")
    r, c = _loc
    paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)

    return grid

