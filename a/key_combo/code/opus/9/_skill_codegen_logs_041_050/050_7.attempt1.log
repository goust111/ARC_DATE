+        out[r0 : r0 + h, :w] = tile
+        r0 += h + 1
+    return out
+
+
+def _dims_for_orientation(orientation: str) -> tuple[int, int]:
+    if orientation == "tall":
+        return 5, 4
+    if orientation == "square":
+        side = int(_RNG.integers(4, 6))
+        return side, side
+    options = [(3, 4), (3, 5), (3, 6), (4, 5), (4, 6), (5, 6)]
+    return options[int(_RNG.integers(len(options)))]
+
+
