+                trimmed = _trim_binary(flipped.astype(bool))
+                sig = trimmed.astype(np.uint8).tobytes() + str(trimmed.shape).encode()
+                if sig in seen:
+                    continue
+                seen.add(sig)
+                masks.append(trimmed.astype(int))
+    pick = masks[int(_RNG.integers(len(masks)))]
+    return pick.copy()
+
+
+def _choose_three_sprites() -> list[np.ndarray]:
+    masks = []
+    sigs = set()
+    for _ in range(100):
+        mask = _random_sprite_mask()
+        sig = mask.astype(np.uint8).tobytes() + str(mask.shape).encode()
+        if sig in sigs:
+            continue
+        sigs.add(sig)
+        masks.append(mask)
+        if len(masks) == 3:
+            break
+    if len(masks) != 3:
+        raise RuntimeError("failed to sample distinct sprite masks")
+    _RNG.shuffle(masks)
+    return masks
+
+
+def _build_expected(sprite_specs: list[dict], factors: list[int]) -> np.ndarray:
+    scaled = []
+    for spec, factor in zip(sprite_specs, factors):
+        crop = np.where(spec["mask"] == 1, spec["color"], BG)
+        scaled.append(_scale(crop, factor))
+    out_h = sum(tile.shape[0] for tile in scaled) + (len(scaled) - 1)
+    out_w = max(tile.shape[1] for tile in scaled)
+    out = np.zeros((out_h, out_w), dtype=int)
+    r0 = 0
+    for tile in scaled:
+        h, w = tile.shape
+        out[r0 : r0 + h, :w] = tile
+        r0 += h + 1
+    return out
+
+
+def _sample_count_order() -> list[int]:
+    if _RNG.random() < 0.7:
+        orders = ([0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1])
+    else:
+        orders = ([0, 1, 2], [2, 1, 0])
+    return list(orders[int(_RNG.integers(len(orders)))])
