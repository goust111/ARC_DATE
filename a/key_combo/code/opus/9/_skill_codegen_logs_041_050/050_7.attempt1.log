MIN_MARKER_TOTAL, MAX_MARKER_TOTAL = 2, 5
MIN_MARKED_REGIONS, MAX_UNMARKED_REGIONS = 2, 1
MIN_MARKERS_PER_REGION, MAX_MARKERS_PER_REGION = 0, 2
MARKER_EDGE_PADDING = 1

