+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+_RNG = np.random.default_rng()
+_SPRITE_COLORS = (BLUE, GREEN, YELLOW)
+_ORTHO_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_ORIENTATION_PATTERNS = (
+    ("wide", "tall", "square"),
+    ("square", "wide", "tall"),
+    ("tall", "square", "wide"),
+    ("wide", "wide", "tall"),
+    ("wide", "square", "square"),
+    ("tall", "wide", "wide"),
+)
+_SHAPE_LIBRARY = (
+    np.array([[1, 1], [1, 0]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=int),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=int),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=int),
+    np.array([[1, 1], [1, 1]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 1]], dtype=int),
+    np.array([[1, 1, 1], [1, 1, 0]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 0], [0, 1, 0]], dtype=int),
+)
+
+
+def _components_of_mask(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in _ORTHO_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _trim_binary(mask: np.ndarray) -> np.ndarray:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    return mask[rows[0] : rows[-1] + 1, cols[0] : cols[-1] + 1]
+
+
+def _scale(tile: np.ndarray, factor: int) -> np.ndarray:
+    return np.kron(tile, np.ones((factor, factor), dtype=tile.dtype))
+
+
+def _parse_rectangles(grid: np.ndarray) -> list[dict]:
+    mask = (grid == GREY) | (grid == RED)
+    rects = []
+    for coords in _components_of_mask(mask):
+        box = _bbox(coords)
+        patch = _crop(grid, box)
+        if not np.all((patch == GREY) | (patch == RED)):
+            continue
+        h, w = patch.shape
+        if not (3 <= h <= 5 and 4 <= w <= 6):
+            continue
+        if coords.shape[0] != h * w:
+            continue
+        rects.append({"bbox": box, "patch": patch})
+    rects.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return rects
+
+
+def _parse_sprites(grid: np.ndarray) -> list[dict]:
+    sprites = []
+    for color in _SPRITE_COLORS:
+        for coords in _components_of_mask(grid == color):
+            box = _bbox(coords)
+            patch = _crop(grid, box)
+            if not (3 <= coords.shape[0] <= 5):
+                continue
+            if np.count_nonzero(patch == color) != coords.shape[0]:
+                continue
+            sprites.append({"bbox": box, "crop": patch, "color": color})
+    sprites.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return sprites
+
+
+def _split_count(rect_patch: np.ndarray) -> int:
+    marker_coords = np.argwhere(rect_patch == RED)
+    h, w = rect_patch.shape
+    if marker_coords.size == 0:
+        return 0
+    if h > w:
+        return len({int(r) for r, _c in marker_coords})
+    return len({int(c) for _r, c in marker_coords})
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Decode each left rectangle's divider count into a scaling factor and enlarge the paired right sprite.
+
+    Input structure:
+    - The grid has black background.
+    - The left half contains three solid grey rectangles, each optionally containing 0, 1, or 2 red marker pixels.
+    - The right half contains three small monochrome 4-connected sprites in blue, green, and yellow, ordered from top to bottom.
+
+    Rule:
+    - In each rectangle, markers expand along the rectangle's short axis: tall rectangles use full rows, wide or square rectangles use full columns.
+    - The number of resulting divider lines is the rectangle's code d, so its paired sprite uses scaling factor d+1.
+    - Pair the k-th rectangle and k-th sprite by top-to-bottom order, crop each sprite to its tight bbox, scale it by the decoded factor, and stack the scaled sprites vertically with one black row between them.
+
+    Key insight:
+    - The red marks inside the grey rectangles are not output directly; their count after aspect-ratio-based line interpretation becomes a numeric scale code for separate sprites on the right.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    rects = _parse_rectangles(g)
+    sprites = _parse_sprites(g)
+    assert len(rects) == 3
+    assert len(sprites) == 3
+
+    scaled = []
+    factors = []
+    for rect, sprite in zip(rects, sprites):
+        d = _split_count(rect["patch"])
+        factor = d + 1
+        factors.append(factor)
+        scaled.append(_scale(sprite["crop"], factor))
+
+    assert sorted(factors) == [1, 2, 3]
+
+    out_h = sum(tile.shape[0] for tile in scaled) + (len(scaled) - 1)
+    out_w = max(tile.shape[1] for tile in scaled)
+    out = np.zeros((out_h, out_w), dtype=int)
+
+    r0 = 0
+    for tile in scaled:
+        h, w = tile.shape
+        out[r0 : r0 + h, :w] = tile
+        r0 += h + 1
+    return out
+
+
+def _dims_for_orientation(orientation: str) -> tuple[int, int]:
+    if orientation == "tall":
+        return 5, 4
+    if orientation == "square":
+        side = int(_RNG.integers(4, 6))
+        return side, side
+    options = [(3, 4), (3, 5), (3, 6), (4, 5), (4, 6), (5, 6)]
+    return options[int(_RNG.integers(len(options)))]
+
+
+def _sample_markers(h: int, w: int, count: int) -> list[tuple[int, int]]:
+    if count == 0:
+        return []
+    rows = list(range(1, h - 1))
+    cols = list(range(1, w - 1))
+    if h > w:
+        chosen_rows = _RNG.choice(rows, size=count, replace=False)
+        chosen_cols = _RNG.choice(cols, size=count, replace=True)
+    else:
+        chosen_rows = _RNG.choice(rows, size=count, replace=True)
+        chosen_cols = _RNG.choice(cols, size=count, replace=False)
+    return [(int(r), int(c)) for r, c in zip(chosen_rows, chosen_cols)]
+
+
+def _random_sprite_mask() -> np.ndarray:
+    seen: set[bytes] = set()
+    masks = []
+    for base in _SHAPE_LIBRARY:
+        for rot in range(4):
+            cur = np.rot90(base, rot)
+            for flipped in (cur, np.fliplr(cur)):
+                trimmed = _trim_binary(flipped.astype(bool))
+                sig = trimmed.astype(np.uint8).tobytes() + str(trimmed.shape).encode()
+                if sig in seen:
+                    continue
+                seen.add(sig)
+                masks.append(trimmed.astype(int))
+    pick = masks[int(_RNG.integers(len(masks)))]
+    return pick.copy()
+
+
+def _choose_three_sprites() -> list[np.ndarray]:
+    masks = []
+    sigs = set()
+    for _ in range(100):
+        mask = _random_sprite_mask()
+        sig = mask.astype(np.uint8).tobytes() + str(mask.shape).encode()
+        if sig in sigs:
+            continue
+        sigs.add(sig)
+        masks.append(mask)
+        if len(masks) == 3:
+            break
+    if len(masks) != 3:
+        raise RuntimeError("failed to sample distinct sprite masks")
+    _RNG.shuffle(masks)
+    return masks
+
+
+def _build_expected(sprite_specs: list[dict], factors: list[int]) -> np.ndarray:
+    scaled = []
+    for spec, factor in zip(sprite_specs, factors):
+        crop = np.where(spec["mask"] == 1, spec["color"], BG)
+        scaled.append(_scale(crop, factor))
+    out_h = sum(tile.shape[0] for tile in scaled) + (len(scaled) - 1)
+    out_w = max(tile.shape[1] for tile in scaled)
+    out = np.zeros((out_h, out_w), dtype=int)
+    r0 = 0
+    for tile in scaled:
+        h, w = tile.shape
+        out[r0 : r0 + h, :w] = tile
+        r0 += h + 1
+    return out
