+    ("wide", "tall", "square"),
+    ("square", "wide", "tall"),
+    ("tall", "square", "wide"),
+    ("wide", "wide", "tall"),
+    ("wide", "square", "square"),
+    ("tall", "wide", "wide"),
+)
+_SHAPE_LIBRARY = (
+    np.array([[1, 1], [1, 0]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=int),
+    np.array([[1, 1, 1], [1, 0, 0]], dtype=int),
+    np.array([[1, 1, 0], [0, 1, 1]], dtype=int),
+    np.array([[1, 1], [1, 1]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 1]], dtype=int),
+    np.array([[1, 1, 1], [1, 1, 0]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 0], [0, 1, 0]], dtype=int),
+)
+
+
+def _components_of_mask(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in _ORTHO_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
