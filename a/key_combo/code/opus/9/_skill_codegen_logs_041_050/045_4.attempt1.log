+        if info["axis"] == "row":
+            idx = info["index"]
+            crop[idx + 1 :, :] = _rotate_tight_bbox(crop[idx + 1 :, :])
+            tight_shortcut[r0 : r1 + 1, c0 : c1 + 1] = crop
