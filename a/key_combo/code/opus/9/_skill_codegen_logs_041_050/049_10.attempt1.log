+in_bounds = _ARC_UTILS.in_bounds
+
+
+BG = Color.BLACK
+OBJ = Color.RED
+STRIPE = Color.GREEN
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+TOP_BAND = 5
+LEFT_BAND = 5
+GRID_RANGE = (10, 15)
+MAX_ATTEMPTS = 400
+_BRANCH_SCHEDULE = [
+    ("horizontal", 2),
+    ("vertical", 1),
+    ("vertical", 2),
+    ("horizontal", 1),
+    ("horizontal", 3),
+    ("vertical", 3),
+]
+_BRANCH_CURSOR = 0
+_SEEN_INPUTS: set[tuple[tuple[int, int], bytes]] = set()
+_SEEN_OUTPUTS: set[tuple[tuple[int, int], bytes]] = set()
+
+
+def _sig(arr: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return tuple(map(int, arr.shape)), np.asarray(arr, dtype=np.uint8).tobytes()
+
+
+def _normalize_cells(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return {(r - r0, c - c0) for r, c in cells}
+
+
+def _cells_to_mask(cells: set[tuple[int, int]]) -> np.ndarray:
+    h = 1 + max(r for r, _ in cells)
+    w = 1 + max(c for _, c in cells)
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _transform_mask(mask: np.ndarray, orientation: str, count: int) -> np.ndarray:
+    if orientation == "horizontal":
+        return np.rot90(mask, -int(count)).copy()
+    if int(count) % 2 == 1:
+        return np.fliplr(mask).copy()
+    return np.flipud(mask).copy()
+
+
+def _analyze_stripes(grid: np.ndarray) -> tuple[str, list[dict]]:
+    comps = find_components(
+        grid,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[STRIPE],
+        return_format="dict",
+    )
+    assert 1 <= len(comps) <= 3, "expected 1-3 green stripe components"
+
+    orientation = None
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        if h == 1 and 2 <= w <= 3 and int(comp["area"]) == w:
+            kind = "horizontal"
+        elif w == 1 and 2 <= h <= 3 and int(comp["area"]) == h:
+            kind = "vertical"
+        else:
+            raise AssertionError("green components must be short straight stripes")
+        if orientation is None:
+            orientation = kind
+        assert orientation == kind, "all stripes must share the same orientation"
+
+    assert orientation is not None
+    return orientation, comps
+
+
+def _red_bbox_and_mask(grid: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    comps = find_components(
+        grid,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[OBJ],
+        return_format="dict",
+    )
+    assert len(comps) == 1, "expected exactly one red 4-connected object"
+    comp = comps[0]
+    box = tuple(map(int, comp["bbox"]))
+    mask = crop_bbox(grid == OBJ, box)
+    assert 5 <= int(mask.sum()) <= 10, "red object area out of expected range"
+    return box, mask
+
+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> None:
+    for rr, cc in np.argwhere(mask):
+        r = int(top + rr)
+        c = int(left + cc)
+        if in_bounds(grid.shape, r, c):
+            grid[r, c] = int(color)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Use the green stripe direction and count to choose a rotation or mirror for the red object, then erase the stripes.
+
+    Input structure:
+    - The background is black.
+    - One irregular red 4-connected object appears away from the green instruction stripes.
+    - The green markers are 1-3 short parallel stripes, each either horizontal or vertical.
+
+    Rule:
+    - Detect the green stripes, determine whether they are horizontal or vertical, and count them as K.
+    - Crop the red object to its minimal bounding box.
+    - If the stripes are horizontal, rotate the cropped object clockwise by 90 degrees times K.
+    - If the stripes are vertical, mirror the cropped object left-right when K is odd and top-bottom when K is even.
+    - Erase all green stripe pixels, clear the original red object, and place the transformed red object back with the same bounding-box top-left corner, clipping any out-of-bounds part.
+
+    Key insight:
+    - The stripes are an instruction code: their orientation selects the transformation family and their count selects the parameter inside that family.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert int(get_bg(g)) == BG, "expected black background"
+
+    orientation, stripes = _analyze_stripes(g)
+    count = len(stripes)
+    box, obj_mask = _red_bbox_and_mask(g)
+    transformed = _transform_mask(obj_mask, orientation, count)
+
+    out = g.copy()
+    out[out == STRIPE] = BG
+    out[out == OBJ] = BG
+    _paint_mask(out, transformed, box[0], box[1], OBJ)
+    return out
+
+
+def _distinct_transforms(mask: np.ndarray) -> bool:
+    variants = [mask]
+    variants.extend(_transform_mask(mask, "horizontal", k) for k in (1, 2, 3))
+    variants.append(_transform_mask(mask, "vertical", 1))
+    variants.append(_transform_mask(mask, "vertical", 2))
+    return len({_sig(v.astype(np.uint8)) for v in variants}) == len(variants)
+
+
+def _random_object_mask() -> np.ndarray:
+    for _ in range(200):
+        area = random.randint(5, 10)
+        cells = {(random.randint(0, 4), random.randint(0, 4))}
+        while len(cells) < area:
+            frontier: set[tuple[int, int]] = set()
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    rr, cc = r + dr, c + dc
+                    if 0 <= rr < 5 and 0 <= cc < 5 and (rr, cc) not in cells:
+                        frontier.add((rr, cc))
+            if not frontier:
+                break
+            cells.add(random.choice(tuple(frontier)))
+
+        norm = _normalize_cells(cells)
+        mask = _cells_to_mask(norm)
+        h, w = map(int, mask.shape)
+        if not (3 <= h <= 5 and 3 <= w <= 5):
+            continue
+        if h == w:
+            continue
+        if not _distinct_transforms(mask):
+            continue
+        return mask
+    raise RuntimeError("failed to build a non-degenerate red object")
+
+
+def _branch_choice() -> tuple[str, int]:
+    global _BRANCH_CURSOR
+    choice = _BRANCH_SCHEDULE[_BRANCH_CURSOR % len(_BRANCH_SCHEDULE)]
+    _BRANCH_CURSOR += 1
+    return choice
+
+
+def _choose_position(
+    grid_shape: tuple[int, int],
+    mask: np.ndarray,
+    region: str,
+    orientation: str,
+    count: int,
+    clip_case: bool,
+) -> tuple[int, int] | None:
+    h, w = map(int, mask.shape)
+    th, tw = map(int, _transform_mask(mask, orientation, count).shape)
+    H, W = map(int, grid_shape)
+    row_min = TOP_BAND if region == "top" else 1
+    col_min = LEFT_BAND if region == "left" else 1
+    row_max = H - h
+    col_max = W - w
+    if row_min > row_max or col_min > col_max:
+        return None
+
+    target_r = (H - h) / 2.0
+    target_c = (W - w) / 2.0
+    candidates: list[tuple[float, int, int]] = []
+    for r0 in range(row_min, row_max + 1):
+        for c0 in range(col_min, col_max + 1):
+            clipped = r0 + th > H or c0 + tw > W
+            if clipped != clip_case:
+                continue
+            score = abs(r0 - target_r) + abs(c0 - target_c) + random.random() * 0.2
+            candidates.append((score, r0, c0))
+    if not candidates:
+        return None
+    candidates.sort(key=lambda item: item[0])
+    _, r0, c0 = random.choice(candidates[: min(6, len(candidates))])
+    return int(r0), int(c0)
+
+
+def _paint_horizontal_stripes(grid: np.ndarray, region: str, count: int) -> None:
+    H, W = map(int, grid.shape)
+    if region == "top":
+        rows = random.sample([0, 2, 4], count)
+        for r in rows:
+            length = random.randint(2, 3)
+            c0 = random.randint(0, W - length)
+            grid[r, c0 : c0 + length] = STRIPE
+    else:
+        rows = random.sample(list(range(0, H, 2)), count)
+        for r in rows:
+            length = random.randint(2, 3)
+            c0 = random.randint(0, LEFT_BAND - length)
+            grid[r, c0 : c0 + length] = STRIPE
+
+
+def _paint_vertical_stripes(grid: np.ndarray, region: str, count: int) -> None:
+    H, W = map(int, grid.shape)
+    if region == "left":
+        cols = random.sample([0, 2, 4], count)
+        for c in cols:
+            length = random.randint(2, 3)
+            r0 = random.randint(0, H - length)
+            grid[r0 : r0 + length, c] = STRIPE
+    else:
+        cols = random.sample(list(range(0, W, 2)), count)
+        for c in cols:
+            length = random.randint(2, 3)
+            r0 = random.randint(0, TOP_BAND - length)
+            grid[r0 : r0 + length, c] = STRIPE
+
+
+def _render_expected(
+    grid_shape: tuple[int, int],
+    obj_mask: np.ndarray,
+    top: int,
+    left: int,
+    orientation: str,
+    count: int,
+) -> np.ndarray:
+    out = np.zeros(grid_shape, dtype=int)
+    transformed = _transform_mask(obj_mask, orientation, count)
+    _paint_mask(out, transformed, top, left, OBJ)
+    return out
+
+
+def _validate_semantics(grid: np.ndarray, meta: dict) -> bool:
+    try:
+        orientation, stripes = _analyze_stripes(grid)
+        if orientation != meta["orientation"] or len(stripes) != meta["count"]:
+            return False
+
+        box, obj_mask = _red_bbox_and_mask(grid)
+        if box[:2] != (meta["top"], meta["left"]):
+            return False
+        if _sig(obj_mask.astype(np.uint8)) != _sig(meta["mask"].astype(np.uint8)):
+            return False
+        if not _distinct_transforms(obj_mask):
+            return False
+
+        expected = _render_expected(
+            grid.shape,
+            meta["mask"],
+            meta["top"],
+            meta["left"],
+            meta["orientation"],
+            meta["count"],
+        )
+        actual = main(grid)
+        if not np.array_equal(actual, expected):
+            return False
+        if np.array_equal(actual, grid):
+            return False
+        if np.any(actual == STRIPE):
+            return False
+        out_red = find_components(
+            actual,
+            bg=BG,
+            connectivity=4,
+            monochromatic=True,
+            colors=[OBJ],
+            return_format="dict",
+        )
+        if len(out_red) != 1:
+            return False
+        return True
+    except Exception:
+        return False
+
+
+def _attempt_generate() -> np.ndarray | None:
+    orientation, count = _branch_choice()
+    region = random.choice(["top", "left"])
+    H = random.randint(*GRID_RANGE)
+    W = random.randint(*GRID_RANGE)
+    mask = _random_object_mask()
+
+    clip_case = False
+    if orientation == "horizontal" and count in (1, 3):
+        clip_case = random.random() < 0.35
+
+    pos = _choose_position((H, W), mask, region, orientation, count, clip_case)
+    if pos is None and clip_case:
+        pos = _choose_position((H, W), mask, region, orientation, count, False)
+    if pos is None:
+        return None
+
+    grid = np.zeros((H, W), dtype=int)
+    top, left = pos
+    _paint_mask(grid, mask, top, left, OBJ)
+    if orientation == "horizontal":
+        _paint_horizontal_stripes(grid, region, count)
+    else:
+        _paint_vertical_stripes(grid, region, count)
+
+    meta = {
+        "orientation": orientation,
+        "count": count,
+        "mask": mask.copy(),
+        "top": int(top),
+        "left": int(left),
+    }
+    if not _validate_semantics(grid, meta):
+        return None
+
+    inp_sig = _sig(grid)
+    out_sig = _sig(main(grid))
+    if inp_sig in _SEEN_INPUTS or out_sig in _SEEN_OUTPUTS:
+        return None
+    _SEEN_INPUTS.add(inp_sig)
+    _SEEN_OUTPUTS.add(out_sig)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for task 10")

