spec:
  grid: 3x3 [observed]; could generalize to 2-5 rows x 2-5 cols
  background: single dominant color (black/0 in all examples) [observed]
  foreground:
    count: exactly 3 pixels [observed]; solver requires >=1
    colors: each FG pixel has a distinct non-background color
    positions: sparse within the grid; no two FG pixels share the same diagonal (r-c), ensuring no color conflict when diagonal traces overlap
  output:
    size: 2*H x 2*W
    rule: for each FG pixel at (r,c) with color C, paint C at (r+k, c+k) for k=0,1,...,min(2H-1-r, 2W-1-c); all unpainted cells are background
    diagonal_no_conflict: pixels on the same r-c diagonal must have the same color (guaranteed by distinct-diagonal constraint above)

generation_strategy:
