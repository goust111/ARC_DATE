+        r_cut = h
+        while r_cut > 0 and bool(rows_all[r_cut - 1]):
+            r_cut -= 1
+        c_cut = w
+        while c_cut > 0 and bool(cols_all[c_cut - 1]):
+            c_cut -= 1
+
+        if c_cut == 0:
+            continue
+        expected = np.zeros((h, w), dtype=bool)
+        if r_cut < h:
+            expected[r_cut:, :] = True
+        if c_cut < w:
+            expected[:, c_cut:] = True
+        if c_cut < w and np.array_equal(g == color, expected):
+            candidates.append((color, r_cut, c_cut))
