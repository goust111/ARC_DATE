+
+def _global_majority_cell(cells: list[np.ndarray]) -> np.ndarray:
+    sigs = [cell.tobytes() for cell in cells]
+    counts = Counter(sigs)
+    majority_sig = counts.most_common(1)[0][0]
+    return next(cell.copy() for cell in cells if cell.tobytes() == majority_sig)
