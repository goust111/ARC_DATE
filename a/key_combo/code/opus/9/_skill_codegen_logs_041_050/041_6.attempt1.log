+    out = np.full((h, cell_size + 2), int(bg), dtype=int)
+    out[:, 0] = int(lattice)
+    out[:, -1] = int(lattice)
+    for ra, _rb in comp_r_slices:
+        out[ra - 1, :] = int(lattice)
+    out[-1, :] = int(lattice)
+    for (ra, rb), cell in zip(comp_r_slices, odd_cells, strict=True):
+        out[ra:rb, 1:-1] = cell
