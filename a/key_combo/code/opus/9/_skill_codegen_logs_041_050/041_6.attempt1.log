+    random.shuffle(candidates)
+    for r, c in candidates:
+        out = base.copy()
+        out[r, c] = sp2 if int(out[r, c]) == sp1 else sp1
+        if np.array_equal(out, base):
+            continue
+        if visible_change:
+            if np.array_equal(out[:, : c + 1], base[:, : c + 1]):
+                continue
+        return out
+    return None
