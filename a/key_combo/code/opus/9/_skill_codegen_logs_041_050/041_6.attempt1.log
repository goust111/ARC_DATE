+    out[-1, :] = int(lattice)
+    for (ra, rb), cell in zip(r_slices, odd_cells, strict=True):
+        out[ra:rb, 1:-1] = cell
+    return out
+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    full: np.ndarray,
