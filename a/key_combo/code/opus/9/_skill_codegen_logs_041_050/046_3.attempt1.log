+
+
+def _expected_output_from_xor(xor_mask: np.ndarray) -> np.ndarray:
+    h, w = xor_mask.shape
+    out = np.zeros((h, w), dtype=int)
+    lines = _line_mask_from_xor(xor_mask)
+    out[lines] = YELLOW
