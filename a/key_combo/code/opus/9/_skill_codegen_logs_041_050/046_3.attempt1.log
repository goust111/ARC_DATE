+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+GEN_RETRIES = 400
+BASE_SIZE_RANGE = (3, 5)
+HALF_HEIGHT_RANGE = (5, 8)
