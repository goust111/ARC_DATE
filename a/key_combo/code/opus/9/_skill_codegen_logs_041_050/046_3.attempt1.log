+                [(0, c) for c in range(1, w - 1)]
+                + [(h - 1, c) for c in range(1, w - 1)]
+            )
+        random.shuffle(secondary_pool)
+        _add_if_compatible(secondary_pool, positions)
+
+    if random.random() < 0.3:
+        extra_boundary = (
+            [(0, c) for c in range(w)]
+            + [(h - 1, c) for c in range(w)]
