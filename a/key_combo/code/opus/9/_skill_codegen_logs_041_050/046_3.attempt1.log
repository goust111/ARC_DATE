+    bottom = g[half:]
+    if not set(np.unique(top)).issubset({BLACK, BLUE}):
+        return False
+    if not set(np.unique(bottom)).issubset({BLACK, GREEN}):
+        return False
+
+    top_mask = top == BLUE
+    bottom_mask = bottom == GREEN
