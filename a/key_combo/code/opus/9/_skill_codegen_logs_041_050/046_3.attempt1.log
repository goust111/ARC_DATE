+        if not _add_if_compatible(interior_pool, positions):
+            return None
+
+    if len(positions) > 8:
+        return None
+    boundary_count = sum(_boundary_kind(p, h, w) != "interior" for p in positions)
+    interior_count = len(positions) - boundary_count
+    if boundary_count < 1 or interior_count < 2:
