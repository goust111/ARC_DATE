+    lines = np.zeros((h, w), dtype=bool)
+    for r, c in np.argwhere(xor_mask):
+        r = int(r)
+        c = int(c)
+        if r == 0 or r == h - 1:
+            lines[:, c] = True
+        if c == 0 or c == w - 1:
+            lines[r, :] = True
+    return lines
+
+
+def _expected_output_from_xor(xor_mask: np.ndarray) -> np.ndarray:
+    h, w = xor_mask.shape
