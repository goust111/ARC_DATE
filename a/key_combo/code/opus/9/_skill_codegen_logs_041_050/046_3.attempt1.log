+        for rr in range(1, h - 1):
+            for cc in range(max(1, c - 1), min(w - 2, c + 1) + 1):
+                out.add((rr, cc))
+    if c in (0, w - 1):
+        for cc in range(1, w - 1):
+            for rr in range(max(1, r - 1), min(h - 2, r + 1) + 1):
+                out.add((rr, cc))
