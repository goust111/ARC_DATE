+        else:
+            bottom[target] = GREEN
+
+    grid = np.vstack([top, bottom])
+    return grid
+
+
+def _analyze_sample(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    half = g.shape[0] // 2
+    top = g[:half] == BLUE
+    bottom = g[half:] == GREEN
+    xor_mask = top ^ bottom
+    overlap = top & bottom
