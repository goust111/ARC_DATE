+            + [(h - 1, c) for c in range(w)]
+            + [(r, 0) for r in range(1, h - 1)]
+            + [(r, w - 1) for r in range(1, h - 1)]
+        )
+        random.shuffle(extra_boundary)
+        _add_if_compatible(extra_boundary, positions)
