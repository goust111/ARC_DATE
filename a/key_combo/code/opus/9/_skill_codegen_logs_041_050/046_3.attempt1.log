+    occupied: set[tuple[int, int]] = set()
+    assignments = _assign_sides(len(markers))
+
+    order = sorted(
+        range(len(markers)),
+        key=lambda i: (_boundary_kind(markers[i], h, w) == "interior", markers[i]),
+    )
+
