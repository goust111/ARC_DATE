+    if (r, c) in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)):
+        return "corner"
+    if r == 0:
+        return "top"
+    if r == h - 1:
+        return "bottom"
+    if c == 0:
+        return "left"
+    if c == w - 1:
+        return "right"
+    return "interior"
