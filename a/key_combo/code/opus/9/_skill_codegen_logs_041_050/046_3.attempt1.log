+        bases[idx] = base
+        occupied |= base
+        occupied.add(target)
+
+    for idx, target in enumerate(markers):
+        base = bases[idx]
+        assert base is not None
+        for r, c in base:
+            top[r, c] = BLUE
+            bottom[r, c] = GREEN
