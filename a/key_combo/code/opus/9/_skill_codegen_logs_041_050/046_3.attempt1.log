+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox(cells: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _is_irregular_component(cells: set[tuple[int, int]]) -> bool:
+    if len(cells) < 3:
+        return False
+    r0, c0, r1, c1 = _bbox(cells)
+    if r0 == r1 or c0 == c1:
+        return False
+    bbox_area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    return bbox_area > len(cells)
+
+
+def _components4(mask: np.ndarray) -> list[set[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[set[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: set[tuple[int, int]] = set()
+            q = deque([(r, c)])
+            seen[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                comp.add((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _xor_mask(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    half = g.shape[0] // 2
+    top_fg = g[:half] == BLUE
+    bottom_fg = g[half:] == GREEN
+    return top_fg ^ bottom_fg
+
+
+def _line_mask_from_xor(xor_mask: np.ndarray) -> np.ndarray:
+    h, w = xor_mask.shape
+    lines = np.zeros((h, w), dtype=bool)
+    for r, c in np.argwhere(xor_mask):
+        r = int(r)
+        c = int(c)
+        if r == 0 or r == h - 1:
+            lines[:, c] = True
+        if c == 0 or c == w - 1:
+            lines[r, :] = True
+    return lines
+
+
+def _expected_output_from_xor(xor_mask: np.ndarray) -> np.ndarray:
+    h, w = xor_mask.shape
+    out = np.zeros((h, w), dtype=int)
+    lines = _line_mask_from_xor(xor_mask)
+    out[lines] = YELLOW
