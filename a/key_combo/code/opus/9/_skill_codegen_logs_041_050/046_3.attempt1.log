+            cells = {seed}
+            while len(cells) < target_size:
+                frontier = set()
+                for r, c in cells:
+                    for nr, nc in _neighbors4(r, c):
+                        candidate = (nr, nc)
+                        if candidate in cells:
+                            continue
+                        if _cell_available(candidate, target, shape, reserved_targets, occupied):
+                            frontier.add(candidate)
