+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+GEN_RETRIES = 400
+BASE_SIZE_RANGE = (3, 5)
+HALF_HEIGHT_RANGE = (5, 8)
+WIDTH_RANGE = (6, 10)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
