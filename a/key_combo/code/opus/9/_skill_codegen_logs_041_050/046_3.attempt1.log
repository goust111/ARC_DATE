+    reserved_targets = set(markers)
+    occupied: set[tuple[int, int]] = set()
+    assignments = _assign_sides(len(markers))
+
+    order = sorted(
+        range(len(markers)),
+        key=lambda i: (_boundary_kind(markers[i], h, w) == "interior", markers[i]),
+    )
+
+    bases: list[set[tuple[int, int]] | None] = [None] * len(markers)
+    for idx in order:
+        target = markers[idx]
+        base = _grow_base_component(target, (h, w), reserved_targets, occupied)
+        if base is None:
+            return None
+        bases[idx] = base
+        occupied |= base
+        occupied.add(target)
+
+    for idx, target in enumerate(markers):
+        base = bases[idx]
+        assert base is not None
+        for r, c in base:
+            top[r, c] = BLUE
+            bottom[r, c] = GREEN
+        if assignments[idx]:
+            top[target] = BLUE
+        else:
+            bottom[target] = GREEN
+
+    grid = np.vstack([top, bottom])
+    return grid
+
+
+def _analyze_sample(grid: np.ndarray) -> dict[str, object]:
+    g = np.asarray(grid, dtype=int)
+    half = g.shape[0] // 2
+    top = g[:half] == BLUE
+    bottom = g[half:] == GREEN
+    xor_mask = top ^ bottom
+    overlap = top & bottom
