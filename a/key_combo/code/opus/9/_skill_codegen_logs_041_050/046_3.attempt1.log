+    g = np.asarray(grid, dtype=int)
+    half = g.shape[0] // 2
+    top_fg = g[:half] == BLUE
+    bottom_fg = g[half:] == GREEN
+    return top_fg ^ bottom_fg
+
+
+def _line_mask_from_xor(xor_mask: np.ndarray) -> np.ndarray:
