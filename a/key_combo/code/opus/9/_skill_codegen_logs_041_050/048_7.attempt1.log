+    assert template_bbox is not None, "missing grey template"
+    mask = crop_bbox(g == TEMPLATE_COLOR, template_bbox)
+    assert 4 <= mask.shape[0] <= 5 and 4 <= mask.shape[1] <= 5, "template bbox must be 4x4 to 5x5"
+    assert len(components_mask(mask, connectivity=4)) == 1, "template must be 4-connected"
+
+    markers: list[tuple[int, int, int]] = []
+    counts = Counter(map(int, g.ravel()))
+    for color, count in counts.items():
+        if color in (BG, TEMPLATE_COLOR):
+            continue
+        assert count == 1, "every marker color must appear exactly once"
+        r, c = map(int, np.argwhere(g == color)[0])
