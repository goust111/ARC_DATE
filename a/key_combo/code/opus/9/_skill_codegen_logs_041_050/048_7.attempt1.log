+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Concatenate recolored copies of a gray template, with enclosed holes flipping foreground and background roles.
+
+    Input structure:
+    - A black background contains one gray multi-pixel template in the upper area.
+    - The gray template is a 4-connected 4x4 to 5x5 shape, and its cropped bbox may or may not contain one enclosed 4-connected black hole.
+    - A lower marker row contains 3-5 distinct single-pixel colors on the same row.
