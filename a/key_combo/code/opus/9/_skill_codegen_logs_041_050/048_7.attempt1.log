+    out = np.full((h, w * len(marker_colors)), BG, dtype=int)
+    for i, color in enumerate(marker_colors):
+        patch = np.full(mask.shape, BG, dtype=int)
+        patch[paint_mask] = int(color)
+        out[:, i * w : (i + 1) * w] = patch
+    return out
