+    for n in range(4, 8):
+        for v in range(1, n):
+            if v % 2 != (n - 1) % 2 or n - v < 2:
+                continue
+            for verticals in itertools.combinations(range(n - 1), v - 1):
+                vertical_set = set(verticals) | {n - 1}
+                for dirs in itertools.product([-1, 1], repeat=n - v):
+                    glyphs: list[int | None] = []
+                    dir_idx = 0
