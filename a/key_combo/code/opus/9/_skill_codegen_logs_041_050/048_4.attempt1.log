+import itertools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+MAROON = 9
+PALETTE = [1, 2, 3, 6, 7, 8]
+
+GEN_ATTEMPTS = 1200
+GRID_SIDE_RANGE = (18, 22)
+MARKER_COUNT_CHOICES = [2, 3]
+RADIUS_CHOICES = [3, 4, 5]
+PROTECTED_OUTPUT = {YELLOW, GREY}
