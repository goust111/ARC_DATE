+    skip = set() if skip_colors is None else {int(x) for x in skip_colors}
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if seen[r, c] or color in skip:
+                continue
+            seen[r, c] = True
+            stack = [(r, c)]
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(coords)
+            comps.append(
