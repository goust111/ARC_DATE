+
+
+def _overlay_centered_patch(out: np.ndarray, patch: np.ndarray, center: tuple[int, int]) -> None:
+    r, c = map(int, center)
+    for rr in range(3):
+        for cc in range(3):
+            val = int(patch[rr, cc])
+            if val == BLACK:
+                continue
+            gr = r + rr - 1
+            gc = c + cc - 1
+            if int(out[gr, gc]) not in PROTECTED_OUTPUT:
+                out[gr, gc] = val
+
+
+def _classify_seed_and_cue_components(grid: np.ndarray) -> tuple[list[dict], dict[int, dict]]:
+    g = np.asarray(grid, dtype=int)
+    comps = _find_mono_components(g, skip_colors={BLACK, YELLOW, GREY})
+    seed_comps: list[dict] = []
+    cue_by_color: dict[int, dict] = {}
+    for comp in comps:
+        color = int(comp["color"])
+        r0, c0, r1, c1 = comp["bbox"]
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if comp["touches_edge"]:
+            assert color not in cue_by_color, f"multiple cue sprites for color {color}"
+            cue_by_color[color] = comp
+            continue
+        assert (h, w) == (3, 3), f"non-edge color {color} must be a 3x3 seed"
+        seed_comps.append(comp)
+    return _sort_lr_components(seed_comps), cue_by_color
+
+
+def _transform(grid: np.ndarray, seed_comps: list[dict], cue_by_color: dict[int, dict]) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    markers = _sort_lr_points([tuple(x) for x in np.argwhere(g == YELLOW)])
+    blockers = np.argwhere(g == GREY)
+    assert 2 <= len(markers) <= 3, "expected 2-3 yellow markers"
+    assert len(seed_comps) == len(markers), "marker / seed count mismatch"
+    assert len(cue_by_color) == len(seed_comps), "seed / cue count mismatch"
+    assert len(blockers) >= len(markers), "too few blockers"
+
+    out = g.copy()
+    blocker_arr = np.asarray(blockers, dtype=int)
+    for center in markers:
+        distances = np.maximum(np.abs(blocker_arr[:, 0] - center[0]), np.abs(blocker_arr[:, 1] - center[1]))
+        radius = int(distances.min()) - 1
+        assert radius >= 3, "square radius must be at least 3"
+        _fill_square_background_only(out, center, radius)
+
+    for center, seed_comp in zip(markers, seed_comps):
+        color = int(seed_comp["color"])
+        assert color in cue_by_color, f"missing cue for seed color {color}"
+        patch = _crop_patch(g, seed_comp["bbox"])
+        cue_area = int(cue_by_color[color]["area"])
+        rot_k = cue_area % 4
+        rotated = np.rot90(patch, -rot_k)
+        _overlay_centered_patch(out, rotated, center)
+
+    for seed_comp in seed_comps:
+        rr, cc = seed_comp["coords"][:, 0], seed_comp["coords"][:, 1]
+        out[rr, cc] = BLACK
+    for cue_comp in cue_by_color.values():
+        rr, cc = cue_comp["coords"][:, 0], cue_comp["coords"][:, 1]
+        out[rr, cc] = BLACK
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Draw blocker-limited maroon squares around yellow markers and place rotated seed sprites at their centers.
+
+    Input structure:
+    - A black background contains 2-3 yellow marker pixels and several grey blocker pixels.
+    - For each marker there is one non-edge 3x3 monochrome seed sprite, and one same-color monochrome cue sprite touching a grid edge.
+    - Seed colors are distinct and markers / seeds are paired by left-to-right order.
+
+    Rule:
+    - For each yellow marker, compute the minimum Chebyshev distance to any grey blocker and fill the centered square of radius one less than that distance with maroon, changing only black cells.
+    - Sort markers left-to-right, sort seed sprites left-to-right, and pair them in that order.
+    - For each paired seed, find the same-color cue sprite; rotate the seed's 3x3 bbox clockwise by `(cue pixel count mod 4) * 90` and place it centered on the marker without overwriting yellow or grey pixels.
+    - Erase the original seed sprites and cue sprites to black while preserving yellow markers and grey blockers.
+
+    Key insight:
+    - Square size is controlled locally by grey blockers, while the seed orientation is controlled globally by same-color edge cues, so both mechanisms must be combined on the same target square.
+    """
+    g = np.asarray(grid, dtype=int)
+    seeds, cue_by_color = _classify_seed_and_cue_components(g)
+    return _transform(g, seeds, cue_by_color)
+
+
+def _ring_cells(center: tuple[int, int], dist: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    H, W = shape
+    r, c = center
+    cells = []
+    for rr in range(r - dist, r + dist + 1):
+        for cc in range(c - dist, c + dist + 1):
+            if 0 <= rr < H and 0 <= cc < W and max(abs(rr - r), abs(cc - c)) == dist:
+                cells.append((rr, cc))
+    random.shuffle(cells)
+    return cells
+
+
+def _square_cells(center: tuple[int, int], radius: int, shape: tuple[int, int], pad: int = 0) -> set[tuple[int, int]]:
+    H, W = shape
+    r, c = center
+    out = set()
+    for rr in range(max(0, r - radius - pad), min(H, r + radius + pad + 1)):
+        for cc in range(max(0, c - radius - pad), min(W, c + radius + pad + 1)):
+            out.add((rr, cc))
+    return out
+
+
+def _sample_marker_centers(H: int, W: int, radii: list[int]) -> list[tuple[int, int]] | None:
+    centers: list[tuple[int, int]] = []
+    placed: list[tuple[tuple[int, int], int]] = []
+    for radius in radii:
+        candidates = []
+        for r in range(radius + 1, H - radius - 1):
+            for c in range(radius + 1, W - radius - 1):
+                if any(c == pc for (_, pc), _ in placed):
+                    continue
+                if all(_chebyshev((r, c), other_center) > radius + other_radius + 1 for other_center, other_radius in placed):
+                    candidates.append((r, c))
+        if not candidates:
+            return None
+        center = random.choice(candidates)
+        centers.append(center)
+        placed.append((center, radius))
+    centers.sort(key=lambda rc: (rc[1], rc[0]))
+    return centers
+
+
+def _rotation_area(rot_k: int) -> int:
+    choices = {0: [4], 1: [1, 5], 2: [2, 6], 3: [3, 7]}
+    return random.choice(choices[int(rot_k)])
+
+
+def _grow_connected_mask(rows: int, cols: int, area: int) -> np.ndarray | None:
+    cells = [(r, c) for r in range(rows) for c in range(cols)]
+    for _ in range(80):
+        chosen = {random.choice(cells)}
+        while len(chosen) < area:
+            frontier = []
+            for r, c in chosen:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in chosen:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            chosen.add(random.choice(frontier))
+        if len(chosen) != area:
+            continue
+        mask = np.zeros((rows, cols), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+        coords = np.argwhere(mask)
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        cropped = mask[r0 : r1 + 1, c0 : c1 + 1]
+        return cropped
+    return None
+
+
+def _random_cue_patch(color: int, area: int) -> np.ndarray:
+    for _ in range(200):
+        mask = _grow_connected_mask(4, 4, area)
+        if mask is None:
+            continue
+        patch = np.zeros(mask.shape, dtype=int)
+        patch[mask] = int(color)
+        return patch
+    raise RuntimeError("failed to build cue patch")
+
+
+def _visible_mask(mask: np.ndarray) -> np.ndarray:
+    vis = np.asarray(mask, dtype=bool).copy()
+    vis[1, 1] = False
+    return vis
+
+
+def _random_seed_mask() -> np.ndarray:
+    for _ in range(400):
+        area = random.choice([4, 5, 6])
+        mask = _grow_connected_mask(3, 3, area)
+        if mask is None or mask.shape != (3, 3):
+            continue
+        if any(np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3)):
+            continue
+        vis = _visible_mask(mask)
+        if vis.sum() < 3:
+            continue
+        if any(np.array_equal(vis, np.rot90(vis, k)) for k in (1, 2, 3)):
+            continue
+        return mask
+    raise RuntimeError("failed to build seed mask")
+
+
+def _place_blockers(centers: list[tuple[int, int]], radii: list[int], shape: tuple[int, int]) -> list[tuple[int, int]] | None:
+    blockers: list[tuple[int, int]] = []
+    reserved = set(centers)
+    for i, (center, radius) in enumerate(zip(centers, radii)):
+        dist = radius + 1
+        exact_candidates = []
+        for cell in _ring_cells(center, dist, shape):
+            if cell in reserved:
+                continue
+            ok = True
+            for j, other in enumerate(centers):
+                other_limit = radii[j] + 1
+                if i == j:
+                    continue
+                if _chebyshev(cell, other) <= other_limit:
+                    ok = False
+                    break
+            if ok:
+                exact_candidates.append(cell)
+        if not exact_candidates:
+            return None
+        first = random.choice(exact_candidates)
+        blockers.append(first)
+        reserved.add(first)
+        if len(exact_candidates) > 1 and random.random() < 0.45:
+            second_pool = [cell for cell in exact_candidates if cell != first]
+            second = random.choice(second_pool)
+            blockers.append(second)
+            reserved.add(second)
+
+    H, W = shape
+    extra_cells = []
+    for r in range(H):
+        for c in range(W):
+            cell = (r, c)
+            if cell in reserved:
+                continue
+            if all(_chebyshev(cell, center) > radius + 1 for center, radius in zip(centers, radii)):
+                extra_cells.append(cell)
+    random.shuffle(extra_cells)
+    extra_count = random.randint(0, 3)
+    blockers.extend(extra_cells[:extra_count])
+    return blockers
+
+
+def _stamp_patch(grid: np.ndarray, patch: np.ndarray, top_left: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = top_left
+    coords = []
+    for rr in range(patch.shape[0]):
+        for cc in range(patch.shape[1]):
+            val = int(patch[rr, cc])
+            if val != BLACK:
+                grid[r0 + rr, c0 + cc] = val
+                coords.append((r0 + rr, c0 + cc))
+    return coords
+
+
+def _seed_candidate_positions(shape: tuple[int, int], forbidden: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    H, W = shape
+    candidates = []
+    for r0 in range(1, H - 3):
+        for c0 in range(1, W - 3):
+            cells = {(r, c) for r in range(r0 - 1, r0 + 4) for c in range(c0 - 1, c0 + 4)}
+            if not cells & forbidden:
+                candidates.append((r0, c0))
+    random.shuffle(candidates)
+    return candidates
+
+
+def _cue_sort_key(edge: str, pos: tuple[int, int]) -> tuple[int, int]:
+    r0, c0 = pos
+    if edge in ("top", "bottom"):
+        return c0, r0
+    return r0, c0
+
+
+def _place_cues(
+    H: int,
+    W: int,
+    edge: str,
+    cue_patches: list[np.ndarray],
+    cue_order: list[int],
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    positions: list[tuple[int, int]] = [(-1, -1)] * len(cue_patches)
+    occupied: set[tuple[int, int]] = set()
+    order_sizes = [(idx, cue_patches[idx].shape) for idx in cue_order]
+    for idx, (h, w) in order_sizes:
+        options = []
+        if edge == "top":
+            r0 = 0
+            for c0 in range(0, W - w + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        elif edge == "bottom":
+            r0 = H - h
+            for c0 in range(0, W - w + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        elif edge == "left":
+            c0 = 0
+            for r0 in range(0, H - h + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        else:
+            c0 = W - w
+            for r0 in range(0, H - h + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        if not options:
+            return None
+        pos = random.choice(options)
+        positions[idx] = pos
+        r0, c0 = pos
+        for r in range(r0, r0 + h):
+            for c in range(c0, c0 + w):
+                occupied.add((r, c))
+    return positions
+
+
+def _render_from_meta(meta: dict, seed_perm: tuple[int, ...] | None = None, rot_perm: list[int] | None = None) -> np.ndarray:
+    out = meta["input"].copy()
+    for center, radius in zip(meta["markers"], meta["radii"]):
+        _fill_square_background_only(out, center, radius)
+
+    if seed_perm is None:
+        seed_perm = tuple(range(len(meta["seeds"])))
+    if rot_perm is None:
+        rot_perm = [meta["rot_by_color"][seed["color"]] for seed in meta["seeds"]]
+
+    for marker_idx, marker in enumerate(meta["markers"]):
+        seed = meta["seeds"][seed_perm[marker_idx]]
+        color = int(seed["color"])
+        patch = np.zeros((3, 3), dtype=int)
+        patch[np.asarray(seed["mask"], dtype=bool)] = color
+        rotated = np.rot90(patch, -int(rot_perm[marker_idx]))
+        _overlay_centered_patch(out, rotated, marker)
+
+    for seed in meta["seeds"]:
+        for r, c in seed["coords"]:
+            out[r, c] = BLACK
+    for cue in meta["cues"]:
+        for r, c in cue["coords"]:
+            out[r, c] = BLACK
+    return out
+
+
+def _nearest_marker_indices(meta: dict) -> list[int]:
+    markers = meta["markers"]
+    out = []
+    for seed in meta["seeds"]:
+        sr = seed["pos"][0] + 1
+        sc = seed["pos"][1] + 1
+        dists = [abs(sr - mr) + abs(sc - mc) for mr, mc in markers]
+        out.append(int(np.argmin(dists)))
+    return out
+
+
+def _validate_meta(meta: dict) -> bool:
+    grid = meta["input"]
+    expected = _render_from_meta(meta)
+    if not np.array_equal(main(grid), expected):
+        return False
+
+    if len(set(meta["radii"])) < 2:
+        return False
+
+    if all(rot == 0 for rot in meta["rot_by_color"].values()):
+        return False
+
+    no_rotation = _render_from_meta(meta, rot_perm=[0] * len(meta["markers"]))
+    if np.array_equal(no_rotation, expected):
+        return False
+
+    nearest = _nearest_marker_indices(meta)
+    if nearest == list(range(len(meta["markers"]))):
+        return False
+
+    for perm in itertools.permutations(range(len(meta["seeds"]))):
+        if perm != tuple(range(len(meta["seeds"]))):
+            wrong = _render_from_meta(meta, seed_perm=perm)
+            if np.array_equal(wrong, expected):
+                return False
+
+    cue_order = sorted(range(len(meta["cues"])), key=lambda i: _cue_sort_key(meta["edge"], meta["cues"][i]["pos"]))
+    if cue_order == list(range(len(meta["cues"]))):
+        return False
+    cue_order_rots = [meta["cues"][idx]["rot"] for idx in cue_order]
+    cue_order_wrong = _render_from_meta(meta, rot_perm=cue_order_rots)
+    if np.array_equal(cue_order_wrong, expected):
+        return False
+
+    sigs = []
+    for seed in meta["seeds"]:
+        patch = np.zeros((3, 3), dtype=int)
+        patch[np.asarray(seed["mask"], dtype=bool)] = 1
+        rot = meta["rot_by_color"][seed["color"]]
+        sigs.append(np.rot90(_visible_mask(patch == 1), -rot).astype(int).tobytes())
+    if len(set(sigs)) != len(sigs):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    H = random.randint(*GRID_SIDE_RANGE)
+    W = random.randint(*GRID_SIDE_RANGE)
+    count = random.choice(MARKER_COUNT_CHOICES)
+    colors = random.sample(PALETTE, count)
+    edge = random.choice(EDGES)
+
+    for _ in range(100):
+        radii = [random.choice(RADIUS_CHOICES) for _ in range(count)]
+        if len(set(radii)) >= 2:
+            break
+    else:
+        return None
+
+    centers = _sample_marker_centers(H, W, radii)
+    if centers is None:
+        return None
+
+    markers_and_radii = sorted(zip(centers, radii), key=lambda item: (item[0][1], item[0][0]))
+    centers = [item[0] for item in markers_and_radii]
+    radii = [item[1] for item in markers_and_radii]
+
+    blockers = _place_blockers(centers, radii, (H, W))
+    if blockers is None:
+        return None
+
+    seeds = []
+    seed_forbidden = set()
+    for center, radius in zip(centers, radii):
+        seed_forbidden |= _square_cells(center, radius, (H, W), pad=1)
+    for cell in blockers:
+        for rr in range(max(0, cell[0] - 1), min(H, cell[0] + 2)):
+            for cc in range(max(0, cell[1] - 1), min(W, cell[1] + 2)):
+                seed_forbidden.add((rr, cc))
+
+    seed_positions = []
+    for pos in _seed_candidate_positions((H, W), seed_forbidden):
+        if any(abs(pos[1] - other[1]) < 2 for other in seed_positions):
+            continue
+        if any(abs(pos[0] - other[0]) < 4 and abs(pos[1] - other[1]) < 4 for other in seed_positions):
+            continue
+        seed_positions.append(pos)
+        if len(seed_positions) == count:
+            break
+    if len(seed_positions) != count:
+        return None
+    seed_positions.sort(key=lambda rc: (rc[1], rc[0]))
+
+    rot_values = [random.randrange(4) for _ in range(count)]
+    if all(rot == 0 for rot in rot_values) or len(set(rot_values)) < 2:
+        return None
+
+    cue_patches = []
+    cues_meta = []
+    rot_by_color = {}
+    for color, rot in zip(colors, rot_values):
+        rot_by_color[color] = rot
+        cue_patch = _random_cue_patch(color, _rotation_area(rot))
+        cue_patches.append(cue_patch)
+        cues_meta.append({"color": color, "rot": rot})
+
+    cue_forbidden = set(seed_forbidden)
+    for r0, c0 in seed_positions:
+        for rr in range(max(0, r0 - 1), min(H, r0 + 4)):
+            for cc in range(max(0, c0 - 1), min(W, c0 + 4)):
+                cue_forbidden.add((rr, cc))
+
+    cue_order = list(range(count))
+    random.shuffle(cue_order)
+    if cue_order == list(range(count)):
+        cue_order = cue_order[::-1]
+    cue_positions = _place_cues(H, W, edge, cue_patches, cue_order, cue_forbidden)
+    if cue_positions is None:
+        return None
+
+    grid = np.zeros((H, W), dtype=int)
+    for r, c in centers:
+        grid[r, c] = YELLOW
+    for r, c in blockers:
+        grid[r, c] = GREY
+
+    for idx, (color, pos) in enumerate(zip(colors, seed_positions)):
+        mask = _random_seed_mask()
+        patch = np.zeros((3, 3), dtype=int)
+        patch[mask] = color
+        coords = _stamp_patch(grid, patch, pos)
+        seeds.append({"color": color, "mask": mask, "pos": pos, "coords": coords})
+
+    for idx, patch in enumerate(cue_patches):
+        pos = cue_positions[idx]
+        coords = _stamp_patch(grid, patch, pos)
+        cues_meta[idx]["pos"] = pos
+        cues_meta[idx]["coords"] = coords
+
+    meta = {
+        "input": grid,
+        "markers": centers,
+        "radii": radii,
+        "blockers": blockers,
+        "seeds": sorted(seeds, key=lambda seed: (seed["pos"][1], seed["pos"][0])),
+        "cues": cues_meta,
+        "rot_by_color": rot_by_color,
+        "edge": edge,
+    }
+
+    if not _validate_meta(meta):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle input")

