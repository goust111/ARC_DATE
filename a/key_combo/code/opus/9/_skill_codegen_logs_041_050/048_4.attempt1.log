+    positions: list[tuple[int, int]] = [(-1, -1)] * len(cue_patches)
+    occupied: set[tuple[int, int]] = set()
+    order_sizes = [(idx, cue_patches[idx].shape) for idx in cue_order]
+    for idx, (h, w) in order_sizes:
+        options = []
+        if edge == "top":
+            r0 = 0
+            for c0 in range(0, W - w + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        elif edge == "bottom":
+            r0 = H - h
+            for c0 in range(0, W - w + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        elif edge == "left":
+            c0 = 0
+            for r0 in range(0, H - h + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+                halo = {(r, c) for r in range(max(0, r0 - 1), min(H, r0 + h + 1)) for c in range(max(0, c0 - 1), min(W, c0 + w + 1))}
+                if cells & occupied or cells & forbidden or halo & occupied:
+                    continue
+                options.append((r0, c0))
+        else:
+            c0 = W - w
+            for r0 in range(0, H - h + 1):
+                cells = {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
