+    blockers = np.argwhere(g == GREY)
+    assert 2 <= len(markers) <= 3, "expected 2-3 yellow markers"
+    assert len(seed_comps) == len(markers), "marker / seed count mismatch"
+    assert len(cue_by_color) == len(seed_comps), "seed / cue count mismatch"
+    assert len(blockers) >= len(markers), "too few blockers"
