+def _place_blockers(centers: list[tuple[int, int]], radii: list[int], shape: tuple[int, int]) -> list[tuple[int, int]] | None:
+    blockers: list[tuple[int, int]] = []
+    reserved = set(centers)
+    for i, (center, radius) in enumerate(zip(centers, radii)):
+        dist = radius + 1
+        exact_candidates = []
+        for cell in _ring_cells(center, dist, shape):
+            if cell in reserved:
+                continue
+            ok = True
+            for j, other in enumerate(centers):
+                other_limit = radii[j] + 1
+                if i == j:
+                    continue
+                if _chebyshev(cell, other) <= other_limit:
+                    ok = False
+                    break
+            if ok:
+                exact_candidates.append(cell)
+        if not exact_candidates:
+            return None
+        first = random.choice(exact_candidates)
+        blockers.append(first)
+        reserved.add(first)
+        if len(exact_candidates) > 1 and random.random() < 0.45:
+            second_pool = [cell for cell in exact_candidates if cell != first]
+            second = random.choice(second_pool)
+            blockers.append(second)
+            reserved.add(second)
+
+    H, W = shape
+    extra_cells = []
+    for r in range(H):
+        for c in range(W):
+            cell = (r, c)
+            if cell in reserved:
+                continue
+            if all(_chebyshev(cell, center) > radius + 1 for center, radius in zip(centers, radii)):
+                extra_cells.append(cell)
