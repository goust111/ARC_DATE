+def _ring_cells(center: tuple[int, int], dist: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    H, W = shape
+    r, c = center
+    cells = []
+    for rr in range(r - dist, r + dist + 1):
+        for cc in range(c - dist, c + dist + 1):
+            if 0 <= rr < H and 0 <= cc < W and max(abs(rr - r), abs(cc - c)) == dist:
+                cells.append((rr, cc))
+    random.shuffle(cells)
+    return cells
+
+
+def _square_cells(center: tuple[int, int], radius: int, shape: tuple[int, int], pad: int = 0) -> set[tuple[int, int]]:
+    H, W = shape
+    r, c = center
+    out = set()
+    for rr in range(max(0, r - radius - pad), min(H, r + radius + pad + 1)):
+        for cc in range(max(0, c - radius - pad), min(W, c + radius + pad + 1)):
+            out.add((rr, cc))
+    return out
+
+
+def _sample_marker_centers(H: int, W: int, radii: list[int]) -> list[tuple[int, int]] | None:
+    centers: list[tuple[int, int]] = []
+    placed: list[tuple[tuple[int, int], int]] = []
+    for radius in radii:
+        candidates = []
+        for r in range(radius + 1, H - radius - 1):
+            for c in range(radius + 1, W - radius - 1):
+                if any(c == pc for (_, pc), _ in placed):
+                    continue
+                if all(_chebyshev((r, c), other_center) > radius + other_radius + 1 for other_center, other_radius in placed):
+                    candidates.append((r, c))
+        if not candidates:
+            return None
+        center = random.choice(candidates)
+        centers.append(center)
+        placed.append((center, radius))
+    centers.sort(key=lambda rc: (rc[1], rc[0]))
+    return centers
+
+
+def _rotation_area(rot_k: int) -> int:
+    choices = {0: [4], 1: [1, 5], 2: [2, 6], 3: [3, 7]}
+    return random.choice(choices[int(rot_k)])
+
+
+def _grow_connected_mask(rows: int, cols: int, area: int) -> np.ndarray | None:
+    cells = [(r, c) for r in range(rows) for c in range(cols)]
+    for _ in range(80):
+        chosen = {random.choice(cells)}
+        while len(chosen) < area:
+            frontier = []
+            for r, c in chosen:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in chosen:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            chosen.add(random.choice(frontier))
+        if len(chosen) != area:
+            continue
+        mask = np.zeros((rows, cols), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+        coords = np.argwhere(mask)
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        cropped = mask[r0 : r1 + 1, c0 : c1 + 1]
+        return cropped
+    return None
+
+
+def _random_cue_patch(color: int, area: int) -> np.ndarray:
+    for _ in range(200):
+        mask = _grow_connected_mask(4, 4, area)
+        if mask is None:
+            continue
+        patch = np.zeros(mask.shape, dtype=int)
+        patch[mask] = int(color)
+        return patch
+    raise RuntimeError("failed to build cue patch")
+
+
+def _visible_mask(mask: np.ndarray) -> np.ndarray:
+    vis = np.asarray(mask, dtype=bool).copy()
+    vis[1, 1] = False
+    return vis
+
+
+def _random_seed_mask() -> np.ndarray:
+    for _ in range(400):
+        area = random.choice([4, 5, 6])
+        mask = _grow_connected_mask(3, 3, area)
+        if mask is None or mask.shape != (3, 3):
+            continue
+        if any(np.array_equal(mask, np.rot90(mask, k)) for k in (1, 2, 3)):
+            continue
+        vis = _visible_mask(mask)
+        if vis.sum() < 3:
+            continue
+        if any(np.array_equal(vis, np.rot90(vis, k)) for k in (1, 2, 3)):
+            continue
+        return mask
+    raise RuntimeError("failed to build seed mask")
