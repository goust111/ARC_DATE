+            (depth, depth + 1, horizontal_colors[depth]),
+            (depth + 1, depth, vertical_colors[depth]),
+        ):
+            r, c = _corner_coord(local_r, local_c, flip_r, flip_c, lattice_n)
+            grid[r, c] = int(color)
+    return grid
+
