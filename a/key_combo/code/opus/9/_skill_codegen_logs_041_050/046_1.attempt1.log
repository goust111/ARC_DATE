+def _sample_marker_depths(layers: int) -> list[int]:
+    options = [depth for depth in range(1, layers + 1)]
+    if layers == 3:
+        count = random.choices([2, 3], weights=[1, 4])[0]
+    else:
+        count = random.choices([2, 3, 4], weights=[1, 3, 2])[0]
+    for _ in range(50):
