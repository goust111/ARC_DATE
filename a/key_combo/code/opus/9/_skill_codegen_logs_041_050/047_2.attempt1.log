# Canvas, palette, and retry budget.
GRID_HEIGHT_RANGE, GRID_WIDTH_RANGE = (20, 30), (10, 20)
COLOR_POOL = range(1, 10)
GENERATION_RETRIES = 300

# Segment structure.
