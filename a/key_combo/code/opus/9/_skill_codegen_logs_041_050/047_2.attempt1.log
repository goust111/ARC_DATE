+def _build_input_from_seeds(height: int, width: int, marker_top: int, marker_left: int, seeds: dict[int, tuple[int, int]], obstacles: set[tuple[int, int]]) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
