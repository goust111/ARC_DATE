+    assert coords.shape == (4, 2)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    assert (int(r1 - r0 + 1), int(c1 - c0 + 1)) == (2, 2)
+    assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == GREEN)
+    return int(r0), int(c0), int(r1), int(c1)
