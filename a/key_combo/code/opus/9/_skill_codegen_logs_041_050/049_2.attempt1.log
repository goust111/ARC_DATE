+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Rect = tuple[int, int, int, int]  # r0, c0, h, w
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)
+
+
+def _d4_orbit(r: int, c: int, n: int) -> tuple[Coord, ...]:
+    last = n - 1
+    pts = {
+        (r, c),
+        (r, last - c),
+        (last - r, c),
+        (last - r, last - c),
+        (c, r),
+        (c, last - r),
+        (last - c, r),
+        (last - c, last - r),
+    }
+    return tuple(sorted(pts))
+
+
+def _same_color_components(g: np.ndarray) -> list[tuple[int, list[Coord]]]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, list[Coord]]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[Coord] = deque([(r, c)])
+            cells: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append((color, cells))
+    return comps
+
+
+def _token_cells(g: np.ndarray) -> list[tuple[int, int, int]]:
+    comps = _same_color_components(g)
+    multi_colors = {color for color, cells in comps if len(cells) > 1}
+    tokens: list[tuple[int, int, int]] = []
+    for color, cells in comps:
+        if len(cells) == 1 and color not in multi_colors:
+            r, c = cells[0]
+            tokens.append((r, c, color))
+    assert tokens, "expected at least one isolated token"
+    return sorted(tokens)
+
+
+def _prefix_sum(mask: np.ndarray) -> np.ndarray:
+    pref = mask.astype(int).cumsum(axis=0).cumsum(axis=1)
+    return np.pad(pref, ((1, 0), (1, 0)))
+
+
+def _rect_sum(pref: np.ndarray, r0: int, c0: int, h: int, w: int) -> int:
+    r1 = r0 + h
+    c1 = c0 + w
+    return int(pref[r1, c1] - pref[r0, c1] - pref[r1, c0] + pref[r0, c0])
+
+
+def _orbit_fill_value(g: np.ndarray, r: int, c: int, blocked: set[Coord], token_mask: np.ndarray) -> int | None:
+    vals = {
+        int(g[rr, cc])
+        for rr, cc in _d4_orbit(r, c, g.shape[0])
+        if (rr, cc) not in blocked and not token_mask[rr, cc] and int(g[rr, cc]) != 0
+    }
+    if len(vals) != 1:
+        return None
+    return next(iter(vals))
+
+
+def _find_missing_rect(g: np.ndarray, token_mask: np.ndarray) -> Rect:
+    h, w = g.shape
+    zero_pref = _prefix_sum(g == 0)
+    candidates: list[Rect] = []
+    best_area = 0
+    for r0 in range(h):
+        for c0 in range(w):
+            if int(g[r0, c0]) != 0:
+                continue
+            for rect_h in range(2, h - r0 + 1):
+                for rect_w in range(2, w - c0 + 1):
+                    area = rect_h * rect_w
+                    if area < best_area:
+                        continue
+                    if _rect_sum(zero_pref, r0, c0, rect_h, rect_w) != area:
+                        continue
+                    blocked = {
+                        (rr, cc)
+                        for rr in range(r0, r0 + rect_h)
+                        for cc in range(c0, c0 + rect_w)
+                    }
+                    ok = True
+                    for rr in range(r0, r0 + rect_h):
+                        for cc in range(c0, c0 + rect_w):
+                            if _orbit_fill_value(g, rr, cc, blocked, token_mask) is None:
+                                ok = False
+                                break
+                        if not ok:
+                            break
+                    if not ok:
+                        continue
+                    if area > best_area:
+                        best_area = area
+                        candidates = [(r0, c0, rect_h, rect_w)]
+                    elif area == best_area:
+                        candidates.append((r0, c0, rect_h, rect_w))
+    assert best_area > 0, "failed to locate the missing rectangle"
+    unique = sorted(set(candidates))
+    assert len(unique) == 1, "missing rectangle must be unique"
+    return unique[0]
+
+
+def _repair_missing(g: np.ndarray, rect: Rect, token_mask: np.ndarray) -> np.ndarray:
+    out = np.array(g, dtype=int, copy=True)
+    r0, c0, rect_h, rect_w = rect
+    blocked = {
+        (rr, cc)
+        for rr in range(r0, r0 + rect_h)
+        for cc in range(c0, c0 + rect_w)
+    }
+    for rr in range(r0, r0 + rect_h):
+        for cc in range(c0, c0 + rect_w):
+            fill = _orbit_fill_value(out, rr, cc, blocked, token_mask)
+            assert fill is not None, "each missing cell must be uniquely recoverable"
+            out[rr, cc] = fill
+    return out
+
+
+def _restore_token_background(g: np.ndarray, tokens: list[tuple[int, int, int]], token_mask: np.ndarray) -> np.ndarray:
+    out = np.array(g, dtype=int, copy=True)
+    for r, c, _color in tokens:
+        vals = {
+            int(out[rr, cc])
+            for rr, cc in _d4_orbit(r, c, out.shape[0])
+            if not token_mask[rr, cc] or (rr == r and cc == c)
+        }
+        vals.discard(int(out[r, c]))
+        if not vals:
+            vals = {
+                int(out[rr, cc])
+                for rr, cc in _d4_orbit(r, c, out.shape[0])
+                if not token_mask[rr, cc]
+            }
+        assert len(vals) == 1, "token cell must have one symmetric background value"
+        out[r, c] = next(iter(vals))
+    return out
+
+
+def _drop_tokens(base: np.ndarray, tokens: list[tuple[int, int, int]]) -> np.ndarray:
+    out = np.array(base, dtype=int, copy=True)
+    for r, c, color in sorted(tokens, key=lambda item: item[0], reverse=True):
+        rr = r
+        while rr + 1 < out.shape[0] and int(out[rr + 1, c]) == 0:
+            rr += 1
+        out[rr, c] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Rebuild the missing D4-symmetric ground patch, then let the isolated tokens settle downward onto the restored terrain.
+
+    Input structure:
+    - The input is a square grid whose intended terrain pattern is D4-symmetric under horizontal, vertical, and diagonal reflections.
+    - One all-black rectangular patch has been erased from that terrain, and the erased cells can be recovered from their symmetry orbits.
+    - Several isolated single-pixel tokens use colors outside the terrain palette and sit in the upper half on otherwise empty cells.
+
+    Rule:
+    - Identify the token pixels as isolated singleton-color cells, and identify the all-black rectangle whose cells each have one unique non-black value elsewhere in the same D4 orbit.
+    - Reconstruct that rectangle by copying the unique non-black orbit value into every missing cell, restoring the full terrain.
+    - Replace each token's original cell by its own symmetric terrain value, then process tokens from lower row to higher row: each token falls straight down until the next cell would be non-black or the bottom edge is reached.
+    - Return the repaired terrain together with the settled token positions.
+
+    Key insight:
+    - The hidden rectangle is part of the landing surface, so gravity must be simulated on the repaired symmetric terrain rather than on the raw input.
+    """
