+    corner_block = [(1, 1), (1, 2), (2, 1), (2, 2)]
+    _paint_orbit_cells(g, corner_block, terrain_colors[1])
+
+    if len(terrain_colors) == 3:
+        plus_cells = [
+            (center, center),
+            (center - 1, center),
+            (center + 1, center),
+            (center, center - 1),
+            (center, center + 1),
+        ]
+        _paint_orbit_cells(g, plus_cells, terrain_colors[2])
+
+    miss_h = rng.choice([3, 4])
+    miss_w = 3
+    miss_r0 = pad_r0
+    miss_c0 = pad_c0 + 1
+    rect = (miss_r0, miss_c0, miss_h, miss_w)
+    return g, rect, set(terrain_colors)
+
+
+def _drop_end_row(g: np.ndarray, r: int, c: int) -> int:
+    rr = r
+    while rr + 1 < g.shape[0] and int(g[rr + 1, c]) == 0:
+        rr += 1
+    return rr
+
