+def _paint_orbit_cells(g: np.ndarray, cells: list[Coord], color: int) -> None:
+    n = g.shape[0]
+    for r, c in cells:
+        for rr, cc in _d4_orbit(r, c, n):
+            g[rr, cc] = color
+
+
+def _build_full_terrain(n: int, rng: random.Random) -> tuple[np.ndarray, Rect, set[int]]:
+    center = n // 2
