+
+    token_cols = {c for _r, c, _color in tokens}
+    if len(token_cols) != len(tokens):
+        return None
+
+    if len(set(token_colors)) != len(token_colors):
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(500):
+        grid = _generate_once(rng)
+        if grid is not None:
