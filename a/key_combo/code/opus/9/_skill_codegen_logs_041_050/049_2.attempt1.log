+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Rect = tuple[int, int, int, int]  # r0, c0, h, w
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)
+
+
+def _d4_orbit(r: int, c: int, n: int) -> tuple[Coord, ...]:
+    last = n - 1
+    pts = {
+        (r, c),
+        (r, last - c),
+        (last - r, c),
+        (last - r, last - c),
+        (c, r),
+        (c, last - r),
+        (last - c, r),
+        (last - c, last - r),
+    }
+    return tuple(sorted(pts))
+
+
+def _same_color_components(g: np.ndarray) -> list[tuple[int, list[Coord]]]:
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, list[Coord]]] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q: deque[Coord] = deque([(r, c)])
+            cells: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append((color, cells))
+    return comps
+
+
+def _token_cells(g: np.ndarray) -> list[tuple[int, int, int]]:
+    comps = _same_color_components(g)
+    multi_colors = {color for color, cells in comps if len(cells) > 1}
+    tokens: list[tuple[int, int, int]] = []
+    for color, cells in comps:
+        if len(cells) == 1 and color not in multi_colors:
+            r, c = cells[0]
+            tokens.append((r, c, color))
+    assert tokens, "expected at least one isolated token"
+    return sorted(tokens)
+
+
+def _prefix_sum(mask: np.ndarray) -> np.ndarray:
+    pref = mask.astype(int).cumsum(axis=0).cumsum(axis=1)
+    return np.pad(pref, ((1, 0), (1, 0)))
+
+
+def _rect_sum(pref: np.ndarray, r0: int, c0: int, h: int, w: int) -> int:
+    r1 = r0 + h
+    c1 = c0 + w
+    return int(pref[r1, c1] - pref[r0, c1] - pref[r1, c0] + pref[r0, c0])
+
+
+def _orbit_fill_value(g: np.ndarray, r: int, c: int, blocked: set[Coord], token_mask: np.ndarray) -> int | None:
+    vals = {
+        int(g[rr, cc])
+        for rr, cc in _d4_orbit(r, c, g.shape[0])
+        if (rr, cc) not in blocked and not token_mask[rr, cc] and int(g[rr, cc]) != 0
+    }
+    if len(vals) != 1:
+        return None
+    return next(iter(vals))
+
+
+def _find_missing_rect(g: np.ndarray, token_mask: np.ndarray) -> Rect:
+    h, w = g.shape
+    zero_pref = _prefix_sum(g == 0)
+    candidates: list[Rect] = []
+    best_area = 0
+    for r0 in range(h):
+        for c0 in range(w):
+            if int(g[r0, c0]) != 0:
+                continue
+            for rect_h in range(2, h - r0 + 1):
+                for rect_w in range(2, w - c0 + 1):
+                    area = rect_h * rect_w
+                    if area < best_area:
+                        continue
+                    if _rect_sum(zero_pref, r0, c0, rect_h, rect_w) != area:
+                        continue
+                    blocked = {
+                        (rr, cc)
+                        for rr in range(r0, r0 + rect_h)
+                        for cc in range(c0, c0 + rect_w)
+                    }
+                    ok = True
+                    for rr in range(r0, r0 + rect_h):
+                        for cc in range(c0, c0 + rect_w):
+                            if _orbit_fill_value(g, rr, cc, blocked, token_mask) is None:
+                                ok = False
+                                break
+                        if not ok:
+                            break
+                    if not ok:
+                        continue
+                    if area > best_area:
+                        best_area = area
+                        candidates = [(r0, c0, rect_h, rect_w)]
+                    elif area == best_area:
+                        candidates.append((r0, c0, rect_h, rect_w))
+    assert best_area > 0, "failed to locate the missing rectangle"
+    unique = sorted(set(candidates))
+    assert len(unique) == 1, "missing rectangle must be unique"
+    return unique[0]
+
+
+def _repair_missing(g: np.ndarray, rect: Rect, token_mask: np.ndarray) -> np.ndarray:
+    out = np.array(g, dtype=int, copy=True)
+    r0, c0, rect_h, rect_w = rect
+    blocked = {
+        (rr, cc)
+        for rr in range(r0, r0 + rect_h)
+        for cc in range(c0, c0 + rect_w)
+    }
+    for rr in range(r0, r0 + rect_h):
+        for cc in range(c0, c0 + rect_w):
+            fill = _orbit_fill_value(out, rr, cc, blocked, token_mask)
+            assert fill is not None, "each missing cell must be uniquely recoverable"
+            out[rr, cc] = fill
+    return out
+
+
+def _restore_token_background(g: np.ndarray, tokens: list[tuple[int, int, int]], token_mask: np.ndarray) -> np.ndarray:
+    out = np.array(g, dtype=int, copy=True)
+    for r, c, _color in tokens:
+        vals = {
+            int(out[rr, cc])
+            for rr, cc in _d4_orbit(r, c, out.shape[0])
+            if not token_mask[rr, cc] or (rr == r and cc == c)
+        }
+        vals.discard(int(out[r, c]))
+        if not vals:
+            vals = {
+                int(out[rr, cc])
+                for rr, cc in _d4_orbit(r, c, out.shape[0])
+                if not token_mask[rr, cc]
+            }
+        assert len(vals) == 1, "token cell must have one symmetric background value"
+        out[r, c] = next(iter(vals))
+    return out
+
+
+def _drop_tokens(base: np.ndarray, tokens: list[tuple[int, int, int]]) -> np.ndarray:
+    out = np.array(base, dtype=int, copy=True)
+    for r, c, color in sorted(tokens, key=lambda item: item[0], reverse=True):
+        rr = r
+        while rr + 1 < out.shape[0] and int(out[rr + 1, c]) == 0:
+            rr += 1
+        out[rr, c] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Rebuild the missing D4-symmetric ground patch, then let the isolated tokens settle downward onto the restored terrain.
+
+    Input structure:
+    - The input is a square grid whose intended terrain pattern is D4-symmetric under horizontal, vertical, and diagonal reflections.
+    - One all-black rectangular patch has been erased from that terrain, and the erased cells can be recovered from their symmetry orbits.
+    - Several isolated single-pixel tokens use colors outside the terrain palette and sit in the upper half on otherwise empty cells.
+
+    Rule:
+    - Identify the token pixels as isolated singleton-color cells, and identify the all-black rectangle whose cells each have one unique non-black value elsewhere in the same D4 orbit.
+    - Reconstruct that rectangle by copying the unique non-black orbit value into every missing cell, restoring the full terrain.
+    - Replace each token's original cell by its own symmetric terrain value, then process tokens from lower row to higher row: each token falls straight down until the next cell would be non-black or the bottom edge is reached.
+    - Return the repaired terrain together with the settled token positions.
+
+    Key insight:
+    - The hidden rectangle is part of the landing surface, so gravity must be simulated on the repaired symmetric terrain rather than on the raw input.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.shape[0] == g.shape[1], "expected a square 2D grid"
+    token_list = _token_cells(g)
+    token_mask = np.zeros(g.shape, dtype=bool)
+    for r, c, _color in token_list:
+        token_mask[r, c] = True
+    rect = _find_missing_rect(g, token_mask)
+    repaired = _repair_missing(g, rect, token_mask)
+    terrain = _restore_token_background(repaired, token_list, token_mask)
+    return _drop_tokens(terrain, token_list)
+
+
+def _paint_orbit_cells(g: np.ndarray, cells: list[Coord], color: int) -> None:
+    n = g.shape[0]
+    for r, c in cells:
+        for rr, cc in _d4_orbit(r, c, n):
+            g[rr, cc] = color
+
+
+def _build_full_terrain(n: int, rng: random.Random) -> tuple[np.ndarray, Rect, set[int]]:
+    # Fix the board size and keep the support structures sparse so that some
+    # upper-half token columns are affected by the missing bottom patch.
+    n = 15
+    center = n // 2
+    terrain_colors = rng.sample([1, 3, 5, 6, 7, 8, 9], k=2)
+    main_color, accent_color = terrain_colors
+    g = np.zeros((n, n), dtype=int)
+
+    pad_h = 5
+    pad_w = 7
+    pad_r0 = n - pad_h
+    pad_c0 = center - pad_w // 2
+    bottom_pad = [(r, c) for r in range(pad_r0, n) for c in range(pad_c0, pad_c0 + pad_w)]
+    _paint_orbit_cells(g, bottom_pad, main_color)
+
+    center_square = [
+        (r, c)
+        for r in range(center - 1, center + 2)
+        for c in range(center - 1, center + 2)
+    ]
+    _paint_orbit_cells(g, center_square, accent_color)
+
+    miss_h = 3
+    miss_w = 3
+    miss_r0 = pad_r0
+    miss_c0 = rng.choice([pad_c0, pad_c0 + pad_w - miss_w])
+    rect = (miss_r0, miss_c0, miss_h, miss_w)
+    return g, rect, set(terrain_colors)
+
+
+def _drop_end_row(g: np.ndarray, r: int, c: int) -> int:
+    rr = r
+    while rr + 1 < g.shape[0] and int(g[rr + 1, c]) == 0:
+        rr += 1
+    return rr
+
+
+def _is_isolated_zero(g: np.ndarray, r: int, c: int) -> bool:
+    if int(g[r, c]) != 0:
+        return False
+    for nr, nc in _neighbors4(r, c):
+        if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and int(g[nr, nc]) != 0:
+            return False
+    return True
+
+
+def _expected_output(full: np.ndarray, tokens: list[tuple[int, int, int]]) -> np.ndarray:
+    return _drop_tokens(full, tokens)
+
+
+def _candidate_tokens(
+    full: np.ndarray,
+    raw_terrain: np.ndarray,
+    rect: Rect,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    n = full.shape[0]
+    center = n // 2
+    r0, c0, h, w = rect
+    rect_cols = set(range(c0, c0 + w))
+    rect_rows = set(range(r0, r0 + h))
+    critical: list[tuple[int, int]] = []
+    visible: list[tuple[int, int]] = []
+    for r in range(1, center):
+        for c in range(1, n - 1):
+            if int(raw_terrain[r, c]) != 0:
+                continue
+            full_end = _drop_end_row(full, r, c)
+            raw_end = _drop_end_row(raw_terrain, r, c)
+            if full_end == r:
+                continue
+            support_row = full_end + 1
+            if support_row in rect_rows and c in rect_cols and raw_end != full_end:
+                critical.append((r, c))
+            elif raw_end == full_end:
+                visible.append((r, c))
+    return critical, visible
+
+
+def _orbits_do_not_conflict(points: list[tuple[int, int]], rect: Rect, n: int) -> bool:
+    rect_cells = {
+        (r, c)
+        for r in range(rect[0], rect[0] + rect[2])
+        for c in range(rect[1], rect[1] + rect[3])
+    }
+    used: set[Coord] = set()
+    for r, c in points:
+        orbit = set(_d4_orbit(r, c, n))
+        if orbit & rect_cells:
+            return False
+        if orbit & used:
+            return False
+        used |= orbit
+    return True
+
+
+def _select_token_positions(
+    critical: list[tuple[int, int]],
+    visible: list[tuple[int, int]],
+    rect: Rect,
+    n: int,
+    target: int,
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    rect_cells = {
+        (r, c)
+        for r in range(rect[0], rect[0] + rect[2])
+        for c in range(rect[1], rect[1] + rect[3])
+    }
+    rng.shuffle(critical)
+    rng.shuffle(visible)
+
+    selected: list[tuple[int, int]] = []
+    used_cols: set[int] = set()
+    used_orbit_cells: set[Coord] = set()
+
+    def try_add(pos: tuple[int, int]) -> bool:
+        r, c = pos
+        orbit = set(_d4_orbit(r, c, n))
+        if c in used_cols or orbit & rect_cells or orbit & used_orbit_cells:
+            return False
+        selected.append(pos)
+        used_cols.add(c)
+        used_orbit_cells.update(orbit)
+        return True
+
+    for pos in critical:
+        if try_add(pos):
+            break
+    if not selected:
+        return []
+
+    for pos in critical + visible:
+        try_add(pos)
+        if len(selected) >= target:
+            break
+    return selected
+
+
+def _terrain_has_non_singleton_uses(g: np.ndarray, terrain_colors: set[int]) -> bool:
+    counts = Counter()
+    for color, cells in _same_color_components(g):
+        if color in terrain_colors and len(cells) > 1:
+            counts[color] += 1
+    return terrain_colors <= set(counts)
+
+
+def _generate_once(rng: random.Random, n: int) -> np.ndarray | None:
+    full, rect, terrain_colors = _build_full_terrain(n, rng)
+    raw_terrain = full.copy()
+    r0, c0, h, w = rect
+    raw_terrain[r0 : r0 + h, c0 : c0 + w] = 0
+
+    critical, visible = _candidate_tokens(full, raw_terrain, rect)
+    if not critical or len(visible) < 2:
+        return None
+
+    token_positions = _select_token_positions(critical, visible, rect, n, rng.choice([3, 4, 5]), rng)
+    if len(token_positions) < 3:
+        return None
+
+    if any(int(full[r, c]) != 0 for r, c in token_positions):
+        return None
+
+    token_palette = [color for color in range(1, 10) if color not in terrain_colors]
+    if len(token_palette) < len(token_positions):
+        return None
+    token_colors = rng.sample(token_palette, k=len(token_positions))
+    tokens = [(r, c, color) for (r, c), color in zip(token_positions, token_colors)]
+
+    inp = raw_terrain.copy()
+    for r, c, color in tokens:
+        inp[r, c] = color
+
+    if not _terrain_has_non_singleton_uses(full, terrain_colors):
+        return None
+
+    out = _expected_output(full, tokens)
+    if np.array_equal(inp, out):
+        return None
+
+    if not any(_drop_end_row(full, r, c) != _drop_end_row(raw_terrain, r, c) for r, c, _color in tokens):
+        return None
+
+    token_cols = {c for _r, c, _color in tokens}
+    if len(token_cols) != len(tokens):
+        return None
+
+    if len(set(token_colors)) != len(token_colors):
+        return None
+
+    try:
+        actual = main(inp)
+    except Exception:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(500):
+        sizes = [13, 15]
+        if rng.random() < 0.5:
+            sizes.reverse()
+        for n in sizes:
+            grid = _generate_once(rng, n)
+            if grid is not None:
+                return grid
+    raise RuntimeError("failed to generate a valid input for the symmetry-gravity puzzle")

