+
+def _drop_end_row(g: np.ndarray, r: int, c: int) -> int:
+    rr = r
+    while rr + 1 < g.shape[0] and int(g[rr + 1, c]) == 0:
+        rr += 1
+    return rr
+
+
+def _is_isolated_zero(g: np.ndarray, r: int, c: int) -> bool:
+    if int(g[r, c]) != 0:
+        return False
+    for nr, nc in _neighbors4(r, c):
+        if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and int(g[nr, nc]) != 0:
+            return False
+    return True
+
+
+def _expected_output(full: np.ndarray, tokens: list[tuple[int, int, int]]) -> np.ndarray:
+    return _drop_tokens(full, tokens)
+
+
+def _candidate_tokens(
+    full: np.ndarray,
+    raw_terrain: np.ndarray,
+    rect: Rect,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    n = full.shape[0]
+    center = n // 2
+    r0, c0, h, w = rect
+    rect_cols = set(range(c0, c0 + w))
+    rect_rows = set(range(r0, r0 + h))
+    critical: list[tuple[int, int]] = []
+    visible: list[tuple[int, int]] = []
+    for r in range(1, center):
+        for c in range(1, n - 1):
+            if int(raw_terrain[r, c]) != 0:
+                continue
+            full_end = _drop_end_row(full, r, c)
+            raw_end = _drop_end_row(raw_terrain, r, c)
+            if full_end == r:
+                continue
+            support_row = full_end + 1
+            if support_row in rect_rows and c in rect_cols and raw_end != full_end:
+                critical.append((r, c))
+            elif raw_end == full_end:
+                visible.append((r, c))
+    return critical, visible
+
+
+def _orbits_do_not_conflict(points: list[tuple[int, int]], rect: Rect, n: int) -> bool:
+    rect_cells = {
+        (r, c)
+        for r in range(rect[0], rect[0] + rect[2])
+        for c in range(rect[1], rect[1] + rect[3])
+    }
+    used: set[Coord] = set()
+    for r, c in points:
+        orbit = set(_d4_orbit(r, c, n))
+        if orbit & rect_cells:
+            return False
+        if orbit & used:
+            return False
+        used |= orbit
+    return True
+
+
+def _select_token_positions(
+    critical: list[tuple[int, int]],
+    visible: list[tuple[int, int]],
+    rect: Rect,
+    n: int,
+    target: int,
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    rect_cells = {
+        (r, c)
+        for r in range(rect[0], rect[0] + rect[2])
+        for c in range(rect[1], rect[1] + rect[3])
+    }
+    rng.shuffle(critical)
+    rng.shuffle(visible)
+
+    selected: list[tuple[int, int]] = []
+    used_cols: set[int] = set()
+    used_orbit_cells: set[Coord] = set()
+
+    def try_add(pos: tuple[int, int]) -> bool:
+        r, c = pos
+        orbit = set(_d4_orbit(r, c, n))
+        if c in used_cols or orbit & rect_cells or orbit & used_orbit_cells:
+            return False
+        selected.append(pos)
+        used_cols.add(c)
+        used_orbit_cells.update(orbit)
+        return True
+
+    for pos in critical:
+        if try_add(pos):
+            break
+    if not selected:
+        return []
+
+    for pos in critical + visible:
+        try_add(pos)
+        if len(selected) >= target:
+            break
+    return selected
+
+
+def _terrain_has_non_singleton_uses(g: np.ndarray, terrain_colors: set[int]) -> bool:
+    counts = Counter()
+    for color, cells in _same_color_components(g):
+        if color in terrain_colors and len(cells) > 1:
+            counts[color] += 1
+    return terrain_colors <= set(counts)
+
+
+def _generate_once(rng: random.Random) -> np.ndarray | None:
+    n = rng.choice([13, 15])
+    full, rect, terrain_colors = _build_full_terrain(n, rng)
+    raw_terrain = full.copy()
+    r0, c0, h, w = rect
+    raw_terrain[r0 : r0 + h, c0 : c0 + w] = 0
+
+    critical, visible = _candidate_tokens(full, raw_terrain, rect)
+    if not critical or len(visible) < 2:
+        return None
+
+    token_positions = _select_token_positions(critical, visible, rect, n, rng.choice([3, 4, 5]), rng)
+    if len(token_positions) < 3:
+        return None
+
+    if any(int(full[r, c]) != 0 for r, c in token_positions):
+        return None
+
+    token_palette = [color for color in range(1, 10) if color not in terrain_colors]
+    if len(token_palette) < len(token_positions):
+        return None
+    token_colors = rng.sample(token_palette, k=len(token_positions))
+    tokens = [(r, c, color) for (r, c), color in zip(token_positions, token_colors)]
+
+    inp = raw_terrain.copy()
+    for r, c, color in tokens:
+        inp[r, c] = color
+
+    if not _terrain_has_non_singleton_uses(full, terrain_colors):
+        return None
+
+    out = _expected_output(full, tokens)
+    if np.array_equal(inp, out):
+        return None
+
+    if not any(_drop_end_row(full, r, c) != _drop_end_row(raw_terrain, r, c) for r, c, _color in tokens):
