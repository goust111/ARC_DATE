+    if len(terrain_colors) == 3:
+        ring_radius = 2 if n == 13 else rng.choice([2, 3])
+        ring_cells: list[Coord] = []
+        for r in range(n):
+            for c in range(n):
+                dr = abs(r - center)
+                dc = abs(c - center)
+                if dr + dc == ring_radius + 1:
+                    ring_cells.append((r, c))
+        _paint_orbit_cells(g, ring_cells, terrain_colors[2])
