+    token_mask = np.zeros(g.shape, dtype=bool)
+    for r, c, _color in token_list:
+        token_mask[r, c] = True
+    rect = _find_missing_rect(g, token_mask)
+    repaired = _repair_missing(g, rect, token_mask)
+    terrain = _restore_token_background(repaired, token_list, token_mask)
+    return _drop_tokens(terrain, token_list)
