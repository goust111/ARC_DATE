+        for i in range(right_count):
+            start_col = block_starts[left_count + 1 + i]
+            segments.append(
+                {
+                    "diag_sum": diag_sum,
+                    "start_col": start_col,
+                    "end_col": start_col + majority_len - 1,
+                    "length": majority_len,
+                    "color": majority_color,
