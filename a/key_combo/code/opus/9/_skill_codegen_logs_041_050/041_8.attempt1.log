+        for r, c in outlier["coords"]:
+            expected[int(r), int(c)] = bg
+        for r, c in _segment_cells(int(diag_sum), int(outlier["end_col"]) + 1, int(outlier["length"]) + 1):
+            if not (0 <= r < expected.shape[0] and 0 <= c < expected.shape[1]):
+                return False
