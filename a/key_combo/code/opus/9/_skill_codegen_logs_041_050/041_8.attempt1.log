  "type": "move_to_match",
  "src": "square s with a unique inner sprite in its row",
  "dst": "place into slot d in a column of slots",
  "match_cond": "s.pos.row == d.pos.row",
  "grid_shape": "tight crop"
}
</annotation>
<generation_spec>
```yaml
spec:
  task: Per-row odd-one-out extraction from a lattice grid into a single-column lattice.
  colors: exactly 3 distinct -- lattice L, background bg, sprite sp
  lattice:
    gridline_width: 1
    cell_rows: 3-4
    cell_cols: 3-4 (must be >= 3 so majority is unambiguous)
    cell_size: 5x5 or 6x6 (square, uniform across grid)
  cell_interior:
    border: 1px bg padding on all four sides of each cell
    inner_sprite: drawn in sp color on bg, within the (cell_size-2)x(cell_size-2) inner area
    fill_density: 40-90% of inner area [observed]
  row_structure:
    base_sprite: one base sprite pattern shared by ALL rows in the grid
    majority_cells: all non-unique cells in a row are exact copies of the base sprite
    unique_cell: exactly 1 per row, differs from base by 1-6 inner pixels (sp<->bg flips only)
    unique_cells_differ: each row has a different unique variant
  unique_position: column index of unique cell varies per row; may repeat across rows
  output:
    single-column lattice preserving row heights; width = cell_size + 2
    contains only the unique cell from each row, framed by L gridlines

generation_strategy:
  approach: output-first
  steps:
    1. Pick 3 colors (L, bg, sp) and cell_size S in {5, 6}.
    2. Pick grid dimensions R (3-4 rows) and C (3-4 cols).
    3. Generate a random base sprite on an (S-2)x(S-2) inner grid with 40-90% fill density.
    4. For each of R rows, create a distinct unique variant by flipping 1-3 inner pixels (sp<->bg),
       ensuring each variant differs from base and from every other variant.
    5. Build the output as a single-column lattice of R unique cells framed by L gridlines.
    6. Build the input by tiling each row with C copies of the base sprite, then replacing one
       random column position with that row's unique variant.
```
