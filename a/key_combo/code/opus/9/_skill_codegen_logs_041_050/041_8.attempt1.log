+                    "diag_sum": diag_sum,
+                    "start_col": start_col,
+                    "end_col": prev_col,
+                    "length": length,
+                    "color": color,
+                    "coords": _segment_cells(diag_sum, start_col, length),
+                }
+            )
+            start_col = col
+            prev_col = col
+            color = new_color
+        length = prev_col - start_col + 1
+        segments.append(
