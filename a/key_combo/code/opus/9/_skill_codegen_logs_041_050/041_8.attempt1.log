+            "start_col": outlier_block_start,
+            "end_col": outlier_block_start + outlier_len - 1,
+            "length": outlier_len,
+            "color": outlier_color,
+            "coords": _segment_cells(diag_sum, outlier_block_start, outlier_len),
+            "role": "outlier",
+        }
+        segments.append(outlier_segment)
