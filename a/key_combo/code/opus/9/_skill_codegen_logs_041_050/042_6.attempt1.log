+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS = ((0, 1), (1, 0), (0, -1), (-1, 0))
+OBSTACLE_COLORS = (BLUE, RED, YELLOW, PINK, ORANGE, TEAL, MAROON)
+
+MIN_SIZE = 12
+MAX_SIZE = 15
+MIN_OBSTACLES = 2
+MAX_OBSTACLES = 4
+MAX_GEN_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int, shape: tuple[int, int]):
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr, nc = r + dr, c + dc
+        if _in_bounds(shape, nr, nc):
+            yield nr, nc
+
+
+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != -1:
+                continue
+            idx = len(components)
+            labels[r, c] = idx
+            q = deque([(r, c)])
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, mask.shape):
+                    if mask[nr, nc] and labels[nr, nc] == -1:
+                        labels[nr, nc] = idx
+                        q.append((nr, nc))
+            components.append(cells)
+    return labels, components
+
+
+def _paint_enclosed_black(grid: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    h, w = out.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if out[r, c] == BLACK and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if out[r, c] == BLACK and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, out.shape):
+            if out[nr, nc] == BLACK and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    enclosed = (out == BLACK) & (~outside)
+    out[enclosed] = GREY
+    return out
+
+
+def _simulate(
+    grid: np.ndarray,
+    *,
+    recolor_segments: bool = True,
+    fill_enclosed: bool = True,
