+            if out[r, c] == BLACK and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if out[r, c] == BLACK and not outside[r, c]:
+                outside[r, c] = True
