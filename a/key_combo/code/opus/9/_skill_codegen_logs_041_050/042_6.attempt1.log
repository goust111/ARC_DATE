+def _paint_enclosed_black(grid: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    h, w = out.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if out[r, c] == BLACK and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
