+    r = c = 0
+    dir_idx = 0
+    out[r, c] = GREEN
+    path_mask[r, c] = True
+    step_index[r, c] = 0
+    segment_progress[r, c] = 0
+    path = [(r, c)]
+    current_segment = [(r, c)]
+    progress_in_segment = 0
+    turns: list[dict] = []
+    stagnant_turns = 0
+
+    while len(path) <= h * w * 2:
+        dr, dc = DIRS[dir_idx]
+        nr, nc = r + dr, c + dc
+
+        if not _in_bounds(g.shape, nr, nc):
+            turns.append(
+                {
+                    "reason": "boundary",
+                    "segment": tuple(current_segment),
+                    "segment_len": len(current_segment),
+                    "at": (r, c),
+                    "dir_idx": dir_idx,
+                    "obstacle_id": None,
+                    "obstacle_color": None,
+                }
+            )
+            current_segment = []
+            progress_in_segment = 0
+            dir_idx = (dir_idx + 1) % 4
+            stagnant_turns += 1
+            if stagnant_turns >= 4:
+                stop_reason = "trapped"
+                break
+            continue
+
+        if path_mask[nr, nc]:
+            stop_reason = "path"
+            break
+
+        if obstacle_mask[nr, nc]:
+            obstacle_id = int(obstacle_ids[nr, nc])
+            obstacle_color = int(g[nr, nc])
+            if recolor_segments:
+                for sr, sc in current_segment:
+                    out[sr, sc] = obstacle_color
+            turns.append(
+                {
+                    "reason": "obstacle",
+                    "segment": tuple(current_segment),
+                    "segment_len": len(current_segment),
+                    "at": (r, c),
+                    "dir_idx": dir_idx,
+                    "hit_cell": (nr, nc),
+                    "obstacle_id": obstacle_id,
+                    "obstacle_color": obstacle_color,
+                }
+            )
+            current_segment = []
+            progress_in_segment = 0
+            dir_idx = (dir_idx + 1) % 4
+            stagnant_turns += 1
+            if stagnant_turns >= 4:
+                stop_reason = "trapped"
+                break
+            continue
+
+        fr, fc = nr + dr, nc + dc
+        if _in_bounds(g.shape, fr, fc) and path_mask[fr, fc]:
+            turns.append(
+                {
+                    "reason": "lookahead",
+                    "segment": tuple(current_segment),
+                    "segment_len": len(current_segment),
+                    "at": (r, c),
+                    "dir_idx": dir_idx,
+                    "obstacle_id": None,
+                    "obstacle_color": None,
+                }
+            )
+            current_segment = []
+            progress_in_segment = 0
+            dir_idx = (dir_idx + 1) % 4
+            stagnant_turns += 1
+            if stagnant_turns >= 4:
+                stop_reason = "trapped"
+                break
+            continue
