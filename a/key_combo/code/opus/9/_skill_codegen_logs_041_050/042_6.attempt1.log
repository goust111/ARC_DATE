+            obstacle_color = int(g[nr, nc])
+            if recolor_segments:
+                for sr, sc in current_segment:
+                    out[sr, sc] = obstacle_color
+            turns.append(
+                {
+                    "reason": "obstacle",
+                    "segment": tuple(current_segment),
+                    "segment_len": len(current_segment),
+                    "at": (r, c),
+                    "dir_idx": dir_idx,
+                    "hit_cell": (nr, nc),
+                    "obstacle_id": obstacle_id,
+                    "obstacle_color": obstacle_color,
+                }
+            )
+            current_segment = []
+            progress_in_segment = 0
+            dir_idx = (dir_idx + 1) % 4
+            stagnant_turns += 1
+            if stagnant_turns >= 4:
+                stop_reason = "trapped"
+                break
+            continue
+
+        fr, fc = nr + dr, nc + dc
+        if _in_bounds(g.shape, fr, fc) and path_mask[fr, fc]:
+            turns.append(
+                {
+                    "reason": "lookahead",
+                    "segment": tuple(current_segment),
+                    "segment_len": len(current_segment),
+                    "at": (r, c),
+                    "dir_idx": dir_idx,
+                    "obstacle_id": None,
+                    "obstacle_color": None,
+                }
+            )
+            current_segment = []
+            progress_in_segment = 0
+            dir_idx = (dir_idx + 1) % 4
+            stagnant_turns += 1
+            if stagnant_turns >= 4:
+                stop_reason = "trapped"
+                break
+            continue
+
+        stagnant_turns = 0
+        r, c = nr, nc
+        progress_in_segment += 1
+        path.append((r, c))
+        out[r, c] = GREEN
+        path_mask[r, c] = True
+        step_index[r, c] = len(path) - 1
+        segment_progress[r, c] = progress_in_segment
+        current_segment.append((r, c))
+    else:
+        stop_reason = "guard"
+
