+    for cells in components:
+        if len(cells) not in (1, 2):
+            return False
+        colors = {int(g[r, c]) for r, c in cells}
+        if len(colors) != 1 or next(iter(colors)) not in OBSTACLE_COLORS:
+            return False
+    return True
