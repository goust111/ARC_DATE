+        if idx == 0:
+            want_size_two = want_size_two and random.random() < 0.6
+        placed = _place_one_obstacle(grid, color, want_size_two, min_step)
+        if placed is None:
+            return None
+        grid, min_step = placed
+
+    if not _semantic_checks(grid):
+        return None
+    return grid
