+                {
+                    "reason": "obstacle",
+                    "segment": tuple(current_segment),
+                    "segment_len": len(current_segment),
+                    "at": (r, c),
+                    "dir_idx": dir_idx,
+                    "hit_cell": (nr, nc),
+                    "obstacle_id": obstacle_id,
+                    "obstacle_color": obstacle_color,
+                }
+            )
+            current_segment = []
+            progress_in_segment = 0
+            dir_idx = (dir_idx + 1) % 4
+            stagnant_turns += 1
+            if stagnant_turns >= 4:
+                stop_reason = "trapped"
+                break
+            continue
