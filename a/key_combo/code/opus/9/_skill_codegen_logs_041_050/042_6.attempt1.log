+def _neighbors4(r: int, c: int, shape: tuple[int, int]):
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        nr, nc = r + dr, c + dc
+        if _in_bounds(shape, nr, nc):
+            yield nr, nc
+
