+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(H, r0 + h + pad)
+    cc1 = min(W, c0 + w + pad)
+    used[rr0:rr1, cc0:cc1] = True
