+
+def _touches_all_bbox_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _is_frame_like_mask(mask: np.ndarray) -> bool:
