+        areas[inv + 1] = right_area
+
+        used = {left_area, right_area}
+        ok = True
+        for idx, (lo, hi) in enumerate(ranges):
+            if areas[idx] is not None:
+                continue
+            choices = [value for value in range(lo, hi + 1) if value not in used]
+            if not choices:
+                ok = False
+                break
+            value = rng.choice(choices)
+            areas[idx] = value
