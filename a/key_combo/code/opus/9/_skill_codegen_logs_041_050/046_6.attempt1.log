+        r0, c0, r1, c1 = component["bbox"]
+        patch = _crop_bbox(g, component["bbox"])
+        if _is_frame_component(g, component, bg=bg):
+            side = int(r1 - r0 + 1)
+            frames.append(
+                {
+                    **component,
+                    "outer_side": side,
+                    "inner_side": side - 2,
+                    "inner_bbox": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+                    "patch": patch,
