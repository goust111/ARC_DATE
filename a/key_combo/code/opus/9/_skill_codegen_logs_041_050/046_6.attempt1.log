+def _row_major_order(positions: list[tuple[int, int]]) -> tuple[int, ...]:
+    return tuple(sorted(range(len(positions)), key=lambda i: (positions[i][0], positions[i][1])))
+
+
+def _make_case(rng: random.Random) -> np.ndarray | None:
