+                "outer_side": int(frame_outer_sides[idx]),
+                "inner_bbox": (fr + 1, fc + 1, fr + frame_inner_sizes[idx], fc + frame_inner_sizes[idx]),
+                "bbox": (fr, fc, fr + frame_outer_sides[idx] - 1, fc + frame_outer_sides[idx] - 1),
+                "patch": frame_patch,
