+                "color": int(sprite_colors[idx]),
+                "bbox_side": int(sprite_sizes[idx]),
+                "pixel_area": int(target_areas[idx]),
+                "bbox": (sr, sc, sr + sprite_sizes[idx] - 1, sc + sprite_sizes[idx] - 1),
+                "coords": coords,
