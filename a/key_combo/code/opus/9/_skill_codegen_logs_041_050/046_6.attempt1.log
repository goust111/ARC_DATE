+def _is_frame_like_mask(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if h != w or h < 3:
+        return False
+    border = np.zeros_like(mask, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
