+    if len({sprite["bbox_side"] for sprite in parsed_sprites}) != k:
+        return None
+
+    pixel_order = tuple(sorted(range(k), key=lambda idx: sprite_records[idx]["pixel_area"]))
+    if pixel_order == tuple(range(k)):
