+def _outward_offset(row: int, r0: int, r1: int, step: int) -> int:
+    if row < r0:
+        return ((r0 - 1 - row) // step) + 1
+    if row > r1:
+        return ((row - r1 - 1) // step) + 1
+    return 0
+
