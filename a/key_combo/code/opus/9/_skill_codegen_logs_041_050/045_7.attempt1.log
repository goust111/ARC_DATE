+            if 0 <= right < width:
+                claims[(row, right)].add(int(pair["color"]))
+
+    out = np.full_like(g, BLACK)
+    for (row, col), colors in claims.items():
+        out[row, col] = next(iter(colors)) if len(colors) == 1 else PINK
+    out[g == GREY] = GREY
+    return out
