+                "color": int(color),
+                "r0": int(bars[0]["r0"]),
+                "r1": int(bars[0]["r1"]),
+                "height": int(bars[0]["r1"] - bars[0]["r0"] + 1),
+                "left_col": int(bars[0]["col"]),
+                "right_col": int(bars[1]["col"]),
