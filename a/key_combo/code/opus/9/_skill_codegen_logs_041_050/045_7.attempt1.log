+    else:
+        pair_count = random.choice([count for count in PAIR_COUNT_CHOICES if count >= selected_count + 1])
+    want_overlap = bool(random.random() < 0.55)
+    if selected_count == 3:
+        want_overlap = False
+
+    if want_overlap and selected_count < 2:
