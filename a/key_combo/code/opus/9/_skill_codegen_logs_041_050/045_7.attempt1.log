+def _bar_cells(spec: dict) -> set[tuple[int, int]]:
+    return {(r, spec["left_col"]) for r in range(spec["r0"], spec["r1"] + 1)} | {
+        (r, spec["right_col"]) for r in range(spec["r0"], spec["r1"] + 1)
