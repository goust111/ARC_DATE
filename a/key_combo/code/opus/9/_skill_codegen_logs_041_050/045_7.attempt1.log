+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PINK = 6
+BAR_COLORS = (1, 2, 3, 4, 7, 8, 9)
+
+GRID_ROWS_RANGE = (20, 24)
+GRID_COLS_RANGE = (18, 24)
+PAIR_COUNT_CHOICES = (4, 5)
+SELECTED_COUNT_CHOICES = (2, 3)
+BAR_HEIGHT_CHOICES = (2, 3, 4)
