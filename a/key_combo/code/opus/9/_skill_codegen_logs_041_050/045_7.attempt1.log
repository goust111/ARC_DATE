+    for spec in specs:
+        cells |= _bar_cells(spec)
+    return cells
+
+
+def _candidate_valid(spec: dict, specs: list[dict]) -> bool:
+    cand = _bar_cells(spec)
+    for other in specs:
+        other_cells = _bar_cells(other)
