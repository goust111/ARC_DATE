+        return False
+    if decoy_idx is not None and touch_counts[decoy_idx] != 1:
+        return False
+    untouched = [idx for idx in range(len(specs)) if idx not in selected and idx != decoy_idx and touch_counts[idx] == 0]
+    if not untouched:
+        return False
