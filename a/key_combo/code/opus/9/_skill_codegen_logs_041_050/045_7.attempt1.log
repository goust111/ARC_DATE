+def _touch_counts(path: set[tuple[int, int]], specs: list[dict]) -> list[int]:
+    counts = []
+    for spec in specs:
+        bar_counts = 0
+        for bar_col in (spec["left_col"], spec["right_col"]):
+            touched = False
+            for row in range(spec["r0"], spec["r1"] + 1):
+                for nr, nc in _neighbors8(row, bar_col):
+                    if (nr, nc) in path:
