                "r1": row0 + bar_height - 1,
                "left_col": spec_a["right_col"] + 2,
                "right_col": spec_a["right_col"] + 2 + gap2,
            }
            if spec_b["right_col"] > width - 3:
                continue
            specs.extend([spec_a, spec_b])

        while len(specs) < pair_count:
            spec = _random_pair(height, width, bar_height)
            if _candidate_valid(spec, specs):
                specs.append(spec)

        if len(specs) != pair_count:
            continue

        if want_overlap:
            selected = list(range(selected_count))
        else:
            selected = sorted(random.sample(range(pair_count), selected_count))

        if want_overlap and not {0, 1}.issubset(selected):
            continue

        return specs, selected
    return None, None


def _build_path(height: int, width: int, specs: list[dict], selected: list[int], decoy_idx: int | None):
    bar_cells = _all_bar_cells(specs)
    touched_bars: list[tuple[int, int]] = []
    for idx in selected:
        touched_bars.append((idx, 0))
        touched_bars.append((idx, 1))
    if decoy_idx is not None:
        touched_bars.append((decoy_idx, random.randint(0, 1)))

    for _ in range(PATH_RETRIES):
        pair_rows = {idx: random.randint(specs[idx]["r0"], specs[idx]["r1"]) for idx, _ in touched_bars}
        min_row = min(pair_rows.values())
        max_row = max(pair_rows.values())
        t0 = random.randint(max(1, width // 2 - 3), min(width - 2, width // 2 + 2))
        t1 = max(1, min(width - 2, t0 + random.choice((-2, -1, 0, 1, 2))))
        bend_row = random.randint(min_row, max_row)

        path: set[tuple[int, int]] = set()
        for row in range(min_row, bend_row + 1):
            path.add((row, t0))
        for row in range(bend_row, max_row + 1):
            path.add((row, t1))
        for col in range(min(t0, t1), max(t0, t1) + 1):
            path.add((bend_row, col))

        ok = True
        for idx, which_bar in touched_bars:
            spec = specs[idx]
            row = pair_rows[idx]
            bar_col = spec["left_col"] if which_bar == 0 else spec["right_col"]
            trunk_col = t0 if row <= bend_row else t1
            if trunk_col == bar_col:
                ok = False
                break
            anchor_col = bar_col + (1 if trunk_col > bar_col else -1)
            if not (0 <= anchor_col < width):
                ok = False
                break
            if (row, anchor_col) in bar_cells:
                ok = False
                break
            for col in range(min(trunk_col, anchor_col), max(trunk_col, anchor_col) + 1):
                path.add((row, col))

        if not ok or any(cell in bar_cells for cell in path):
            continue

        labels, n_comp = _label_components(np.array([[cell in path for cell in range(width)] for _ in range(0)], dtype=bool))
        # dummy line above kept for symmetry with solver edits; actual connectivity is checked below.
        if not path:
            continue

        path_mask = np.zeros((height, width), dtype=bool)
        for r, c in path:
            path_mask[r, c] = True
        _, n_path = _label_components(path_mask)
        if n_path != 1:
            continue
        return path
    return None


def _touch_counts(path: set[tuple[int, int]], specs: list[dict]) -> list[int]:
    counts = []
    for spec in specs:
        bar_counts = 0
        for bar_col in (spec["left_col"], spec["right_col"]):
            touched = False
            for row in range(spec["r0"], spec["r1"] + 1):
                for nr, nc in _neighbors8(row, bar_col):
                    if (nr, nc) in path:
                        touched = True
                        break
                if touched:
                    break
            if touched:
                bar_counts += 1
        counts.append(bar_counts)
    return counts


def _specs_to_grid(height: int, width: int, specs: list[dict], colors: list[int], path: set[tuple[int, int]]) -> np.ndarray:
    grid = np.zeros((height, width), dtype=int)
    for spec, color in zip(specs, colors, strict=True):
        grid[spec["r0"] : spec["r1"] + 1, spec["left_col"]] = int(color)
        grid[spec["r0"] : spec["r1"] + 1, spec["right_col"]] = int(color)
        spec["color"] = int(color)
        spec["height"] = int(spec["r1"] - spec["r0"] + 1)
    for r, c in path:
        grid[r, c] = GREY
    return grid


def _claims_for_pair(pair: dict, step: int, shape: tuple[int, int]) -> set[tuple[int, int]]:
    height, width = shape
    claims: set[tuple[int, int]] = set()
    for row in range(height):
        offset = _outward_offset(row, pair["r0"], pair["r1"], step)
        left = pair["left_col"] - offset
        right = pair["right_col"] + offset
        if 0 <= left < width:
            claims.add((row, left))
        if 0 <= right < width:
            claims.add((row, right))
    return claims


def _validate_instance(
    grid: np.ndarray,
    specs: list[dict],
    selected: list[int],
    bar_height: int,
    decoy_idx: int | None,

