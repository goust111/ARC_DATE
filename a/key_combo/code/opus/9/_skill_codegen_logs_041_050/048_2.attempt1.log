import random, numpy as np

def choose_reds(W,k,mode):
    cols = list(range(1,W))
    if mode==0:
        random.shuffle(cols)
        cols=sorted(cols[:k])
    elif mode==1:
        run=min(random.randint(2,min(3,k)), W-1)
        start=random.randint(1, W-run)
        chosen=set(range(start,start+run))
        while len(chosen)<k:
            chosen.add(random.randint(1,W-1))
        cols=sorted(chosen)
    elif mode==2:
        chosen={1}
        while len(chosen)<k:
            chosen.add(random.randint(1,W-1))
        cols=sorted(chosen)
    else:
        chosen={W-1}
        while len(chosen)<k:
            chosen.add(random.randint(1,W-1))
        cols=sorted(chosen)
    return cols

def choose_rows(H,k,m,mode):
    max_start=H-1-k
    pool=list(range(1,max_start+1))
    if len(pool)<m: return None
    if mode%2==0:
        rows=sorted(random.sample(pool,m))
    else:
        start=random.randint(1,max_start-m+1)
        rows=list(range(start,start+m)) if random.random()<0.5 else sorted(random.sample(pool,m))
    return rows

def build(H,W,rows,reds,variant):
    g=np.zeros((H,W),int); g[rows,0]=8; g[0,reds]=2
    out=g.copy(); redset=set(reds)
    for r0 in rows:
        r=r0
        out[r,0]=8
        for c in range(1,W):
            if variant=='straight':
                out[r,c]=8
                continue
            if c in redset:
                if variant=='connected':
                    if r+1>=H:return None
                    out[r,c]=8
                    r+=1
                    out[r,c]=8
                else:
                    r+=1
                    if r>=H:return None
                    out[r,c]=8
            else:
                out[r,c]=8
    return out

def cnt(arr):
    mask=arr==0; H,W=arr.shape
    seen=np.zeros((H,W),bool); n=0
    for r in range(H):
      for c in range(W):
        if not mask[r,c] or seen[r,c]: continue
        n+=1; stack=[(r,c)]; seen[r,c]=True
        while stack:
          x,y=stack.pop()
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
              seen[nx,ny]=True; stack.append((nx,ny))
    return n
