+def _crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _neighbors4(r: int, c: int) -> Iterable[Coord]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    monochromatic: bool,
+    colors: set[int] | None = None,
+) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color == bg:
+                continue
+            if colors is not None and color not in colors:
+                continue
+
+            coords: list[Coord] = []
+            stack = [(r, c)]
+            visited[r, c] = True
+            seed = color
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc]:
+                        continue
+                    value = int(grid[nr, nc])
+                    if value == bg:
+                        continue
+                    if colors is not None and value not in colors:
+                        continue
+                    if monochromatic and value != seed:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+
+            components.append(
+                {
+                    "color": seed if monochromatic else None,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
