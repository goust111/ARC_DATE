+            rr0 = sr + SPRITE_SIZE * copies + overlap
+            rc0 = sc + _pick_offset(col_offsets)
+        else:
+            sc = random.randint(0, w - SPRITE_SIZE)
+            col_offsets = [d for d in range(-rect_w + 1, 3) if 0 <= sc + d <= w - rect_w]
+            if not col_offsets:
