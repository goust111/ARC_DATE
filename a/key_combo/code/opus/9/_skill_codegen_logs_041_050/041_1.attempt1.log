+
+
+def _render_pair(grid: np.ndarray, sprite_bbox: BBox, rect_bbox: BBox, body_color: int, key_color: int) -> None:
+    sr, sc, _, _ = sprite_bbox
+    rr0, rc0, rr1, rc1 = rect_bbox
