+            sc = random.randint(sc_min, w - SPRITE_SIZE)
+            rr0 = sr + _pick_offset(row_offsets)
+            rc0 = sc - SPRITE_SIZE * copies + overlap - rect_w + 1
+        elif direction == (1, 0):
