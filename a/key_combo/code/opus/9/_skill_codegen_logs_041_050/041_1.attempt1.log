+    scene = _analyze_scene(g)
+    out = g.copy()
+    for item in scene:
+        patch = np.array(item["patch"], copy=True)
+        patch[1, 1] = DIR_TO_COLOR[item["direction"]]
+        for r, c in item["copies"]:
+            _paste(out, patch, r, c)
