def _frontier_cells(mask: np.ndarray) -> list[tuple[int, int]]:
    frontier = []
    last = SPRITE_SIZE - 1
    for r in range(SPRITE_SIZE):
        for c in range(SPRITE_SIZE):
            if mask[r, c]:
                continue
            if (
                (r > 0 and mask[r - 1, c])
                or (r < last and mask[r + 1, c])
                or (c > 0 and mask[r, c - 1])
                or (c < last and mask[r, c + 1])
