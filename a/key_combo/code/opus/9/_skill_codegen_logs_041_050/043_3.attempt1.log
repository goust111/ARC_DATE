+        blocked = set(reserved)
+
+        motif = random.choice(motifs)
+        anchors = []
+        for base in range(size - 1):
+            placed = {(base + r, base + c) for r, c in motif}
+            if all(0 <= r < size and 0 <= c < size and (r, c) not in blocked for r, c in placed):
