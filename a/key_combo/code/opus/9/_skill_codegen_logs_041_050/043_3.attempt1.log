+    for tile_r in range(2):
+        for tile_c in range(2):
+            tile = (tile_r, tile_c)
+            tile_reserved = reserved if tile == marker_tile else set()
+            mask = _build_tile_mask(size, sym_layout[tile], tile_reserved, is_target=(tile == target_tile))
+            if mask is None:
