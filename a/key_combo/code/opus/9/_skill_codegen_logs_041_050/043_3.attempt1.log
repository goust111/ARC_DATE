    paste(inp, sprite, target_r + dr, target_c + dc, transparent=BACKGROUND_COLOR)

    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
