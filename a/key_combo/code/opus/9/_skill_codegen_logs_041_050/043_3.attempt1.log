    try:
        out = main(inp)
    except Exception:
        return None
    if out.shape != inp.shape:
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate fd4b2b02 input")

