+        "winner_same_color_types": len(color_to_shapes[int(winner_key[0])]),
+        "winner_same_shape_types": len(shape_to_colors[winner_key[1]]),
+    }
+
+
+def _semantic_checks(grid: np.ndarray, expected_counts: list[int]) -> bool:
