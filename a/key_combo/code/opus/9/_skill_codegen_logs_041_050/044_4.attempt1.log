            if min_cavity_area <= _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area) and max_cavity_area >= _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area):
                choices.append((rows, cols))
    if not choices:
