+    assert len(types) == k
+    shape_keys = {_mask_key(mask) for mask, _ in types}
+    colors = {int(color) for _, color in types}
+    assert len(shape_keys) < k and len(colors) < k
+    return types
+
+
+def _render_sprite(mask: np.ndarray, color: int) -> np.ndarray:
+    sprite = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=int)
+    sprite[mask] = int(color)
+    return sprite
+
+
+def _place_sprites(
+    height: int,
+    width: int,
+    sprite_instances: list[tuple[np.ndarray, int]],
+) -> np.ndarray | None:
+    grid = np.zeros((height, width), dtype=int)
+    reserved = np.zeros((height, width), dtype=bool)
+    candidates = [(r, c) for r in range(height - SPRITE_SIZE + 1) for c in range(width - SPRITE_SIZE + 1)]
+
+    for mask, color in sprite_instances:
+        valid: list[tuple[int, int]] = []
+        for r0, c0 in candidates:
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(height, r0 + SPRITE_SIZE + 1)
+            cc1 = min(width, c0 + SPRITE_SIZE + 1)
