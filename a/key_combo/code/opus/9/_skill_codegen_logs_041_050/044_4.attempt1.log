+            r0, c0, r1, c1 = _bbox_from_coords(coord_arr)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            rel = coord_arr - np.array([r0, c0], dtype=int)
+            mask[rel[:, 0], rel[:, 1]] = True
+            components.append(
