+                    "color": color,
+                    "coords": coord_arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": mask,
+                }
+            )
+    return components
+
+
+def _normalize_type(component: dict) -> tuple[tuple[int, tuple[tuple[int, ...], ...]], np.ndarray]:
