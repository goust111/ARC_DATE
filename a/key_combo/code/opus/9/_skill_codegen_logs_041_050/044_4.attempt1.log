+    height: int,
+    width: int,
+    sprite_instances: list[tuple[np.ndarray, int]],
+) -> np.ndarray | None:
+    grid = np.zeros((height, width), dtype=int)
+    reserved = np.zeros((height, width), dtype=bool)
+    candidates = [(r, c) for r in range(height - SPRITE_SIZE + 1) for c in range(width - SPRITE_SIZE + 1)]
+
+    for mask, color in sprite_instances:
+        valid: list[tuple[int, int]] = []
+        for r0, c0 in candidates:
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(height, r0 + SPRITE_SIZE + 1)
+            cc1 = min(width, c0 + SPRITE_SIZE + 1)
+            if reserved[rr0:rr1, cc0:cc1].any():
+                continue
+            valid.append((r0, c0))
+        if not valid:
+            return None
+        r0, c0 = random.choice(valid)
+        grid[r0 : r0 + SPRITE_SIZE, c0 : c0 + SPRITE_SIZE] = _render_sprite(mask, color)
+        reserved[max(0, r0 - 1) : min(height, r0 + SPRITE_SIZE + 1), max(0, c0 - 1) : min(width, c0 + SPRITE_SIZE + 1)] = True
+    return grid
+
