+        groups[key].append(component)
+        color_to_shapes[color].add(shape_key)
+        shape_to_colors[shape_key].add(color)
+
+    counts = {key: len(items) for key, items in groups.items()}
+    winner_key = max(counts, key=counts.get)
+    return {
