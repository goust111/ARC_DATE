+    points = np.argwhere(mask)
+    if points.size == 0:
+        return False
+    start = tuple(int(v) for v in points[0])
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors8(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                if (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    q.append((nr, nc))
+    return len(seen) == len(points)
