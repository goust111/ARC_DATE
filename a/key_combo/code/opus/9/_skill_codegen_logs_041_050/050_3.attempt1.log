+import random
+from collections import deque
+
+import numpy as np
+
+
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+INPUT_COLORS = (1, 4, 5, 6, 7, 8, 9)
+TEMPLATES = (
+    np.array(
+        [
+            [1, 1, 1, 0],
+            [1, 0, 1, 0],
+            [1, 1, 1, 2],
+            [0, 2, 2, 2],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [1, 1, 1, 2],
+            [1, 0, 1, 2],
+            [1, 1, 1, 2],
+            [3, 3, 3, 0],
+        ],
+        dtype=int,
+    ),
+)
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _find_components(grid: np.ndarray):
+    grid = np.asarray(grid, dtype=int)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rs = [rr for rr, _ in coords]
+            cs = [cc for _, cc in coords]
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set(coords),
+                    "bbox": (min(rs), min(cs), max(rs), max(cs)),
+                }
+            )
+    return components
+
+
+def _component_has_hole(grid: np.ndarray, component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    patch = np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+    comp_mask = np.zeros_like(patch, dtype=bool)
+    for r, c in component["coords"]:
+        comp_mask[r - r0, c - c0] = True
+
+    h, w = patch.shape
+    seen = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if int(patch[r, c]) != 0 or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            enclosed_by_component = True
+            while q:
+                rr, cc = q.popleft()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        enclosed_by_component = False
+                        continue
+                    if int(patch[nr, nc]) == 0:
+                        if not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            q.append((nr, nc))
+                    elif not comp_mask[nr, nc]:
+                        enclosed_by_component = False
+            if not touches_border and enclosed_by_component:
+                return True
+    return False
+
+
+def _classify_components(grid: np.ndarray):
+    hollow = []
+    solid = []
+    for comp in _find_components(grid):
+        if _component_has_hole(grid, comp):
+            hollow.append(comp)
+        else:
+            solid.append(comp)
+    return hollow, solid
+
+
+def _detect_axis_period(grid: np.ndarray, axis: int) -> int:
+    grid = np.asarray(grid, dtype=int)
+    h, w = grid.shape
+    limit = h if axis == 0 else w
+    for period in range(1, limit):
+        support = 0
+        ok = True
+        if axis == 0:
+            for r in range(h - period):
+                row_a = grid[r]
+                row_b = grid[r + period]
+                mask = (row_a != 0) & (row_b != 0)
+                if np.any(mask):
+                    support += int(np.count_nonzero(mask))
+                    if np.any(row_a[mask] != row_b[mask]):
+                        ok = False
+                        break
+        else:
+            for c in range(w - period):
+                col_a = grid[:, c]
+                col_b = grid[:, c + period]
+                mask = (col_a != 0) & (col_b != 0)
+                if np.any(mask):
+                    support += int(np.count_nonzero(mask))
+                    if np.any(col_a[mask] != col_b[mask]):
+                        ok = False
+                        break
+        if ok and support > 0:
+            return period
+    raise ValueError("no supported translational period found")
+
+
+def _detect_period(grid: np.ndarray) -> tuple[int, int]:
+    return _detect_axis_period(grid, 0), _detect_axis_period(grid, 1)
+
+
+def _repair_grid(grid: np.ndarray, period: tuple[int, int]) -> np.ndarray:
+    pr, pc = map(int, period)
+    repaired = np.array(grid, dtype=int, copy=True)
+    h, w = repaired.shape
+    for r in range(h):
+        for c in range(w):
+            if int(repaired[r, c]) != 0:
+                continue
+            colors = set()
+            for rr in range(r % pr, h, pr):
+                for cc in range(c % pc, w, pc):
+                    value = int(repaired[rr, cc])
+                    if value != 0:
+                        colors.add(value)
+            if len(colors) == 1:
+                repaired[r, c] = colors.pop()
+    return repaired
+
+
+def _recolor_by_topology(grid: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(grid)
+    hollow, solid = _classify_components(grid)
+    for comp in hollow:
+        for r, c in comp["coords"]:
+            out[r, c] = 3
+    for comp in solid:
+        for r, c in comp["coords"]:
+            out[r, c] = 2
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Restore a damaged periodic tiling, then recolor each repaired component by whether it encloses a black hole.
+
+    Input structure:
+    - The grid is a black-background translational tiling with a hidden 4x4 period.
+    - Non-black pixels form multiple monochromatic 4-connected components, including hollow and solid ones.
+    - Some foreground pixels were replaced by black, so black cells can mean either true background or periodic damage.
+
+    Rule:
+    - Detect the smallest row and column periods from visible non-black overlaps only.
+    - For each black cell, inspect all cells in its translational orbit; if the orbit shows one non-black color, repair that black cell with that color.
+    - On the repaired grid, find every monochromatic 4-connected foreground component and test whether it encloses at least one black 4-connected hole.
+    - Recolor hollow components green (3), recolor solid components red (2), and keep the background black.
+
+    Key insight:
+    - The black damage destroys exactly the boundary evidence needed for hole detection, so the periodic inpainting step must happen before the topological recoloring step.
+    """
+    g = np.asarray(grid, dtype=int)
+    period = _detect_period(g)
+    repaired = _repair_grid(g, period)
+    return _recolor_by_topology(repaired)
+
+
+def _transform_tile(tile: np.ndarray) -> np.ndarray:
+    out = np.array(tile, dtype=int, copy=True)
+    out = np.rot90(out, random.randrange(4))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    return out
+
+
+def _instantiate_template() -> np.ndarray:
+    base = _transform_tile(random.choice(TEMPLATES))
+    roles = sorted(set(int(v) for v in np.unique(base) if int(v) != 0))
+    chosen = random.sample(INPUT_COLORS, k=len(roles))
+    mapping = {role: color for role, color in zip(roles, chosen)}
+    out = np.zeros_like(base)
+    for role, color in mapping.items():
+        out[base == role] = color
+    return out
+
+
+def _local_components(tile: np.ndarray):
+    return _find_components(tile)
+
+
+def _articulation_cells(tile: np.ndarray, component: dict):
+    coords = component["coords"]
+    coord_set = component["coord_set"]
+    if len(coords) < 3:
+        return []
+    out = []
+    for removed in coords:
+        remaining = coord_set - {removed}
+        start = next(iter(remaining))
+        seen = {start}
+        q = deque([start])
+        while q:
+            r, c = q.popleft()
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in remaining and (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    q.append((nr, nc))
+        if len(seen) != len(remaining):
+            out.append(removed)
+    return out
+
+
+def _choose_damage_plan(tile: np.ndarray):
+    hollow_cells = []
+    solid_breaks = []
+    for comp in _local_components(tile):
+        if _component_has_hole(tile, comp):
+            hollow_cells.extend(comp["coords"])
+        else:
+            articulation = _articulation_cells(tile, comp)
+            if articulation:
+                solid_breaks.extend(articulation)
+    if not hollow_cells or not solid_breaks:
+        return None
+    return random.choice(hollow_cells), random.choice(solid_breaks)
+
+
+def _tile_grid(tile: np.ndarray, nr: int, nc: int) -> np.ndarray:
+    return np.tile(tile, (nr, nc))
+
+
+def _orbit_positions(shape: tuple[int, int], period: tuple[int, int], orbit_cell: tuple[int, int]):
+    h, w = shape
+    pr, pc = period
+    r0, c0 = orbit_cell
+    return [(r, c) for r in range(r0, h, pr) for c in range(c0, w, pc)]
+
+
+def _apply_damage(full: np.ndarray, period: tuple[int, int], mandatory: list[tuple[int, int]], target: int) -> np.ndarray:
+    damaged = np.array(full, dtype=int, copy=True)
+    h, w = full.shape
+    pr, pc = period
+    orbit_counts = {}
+    for r in range(pr):
+        for c in range(pc):
+            if int(full[r, c]) != 0:
+                orbit_counts[(r, c)] = len(_orbit_positions((h, w), period, (r, c)))
+
+    damaged_per_orbit = {orbit: 0 for orbit in orbit_counts}
+    used = set()
+    for cell in mandatory:
+        damaged[cell] = 0
+        orbit = (cell[0] % pr, cell[1] % pc)
+        damaged_per_orbit[orbit] += 1
+        used.add(cell)
+
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            if int(full[r, c]) == 0 or (r, c) in used:
+                continue
+            orbit = (r % pr, c % pc)
+            if damaged_per_orbit[orbit] >= orbit_counts[orbit] - 1:
+                continue
+            candidates.append((r, c))
+    random.shuffle(candidates)
+
+    for r, c in candidates:
+        if len(used) >= target:
+            break
+        orbit = (r % pr, c % pc)
+        if damaged_per_orbit[orbit] >= orbit_counts[orbit] - 1:
+            continue
+        damaged[r, c] = 0
+        damaged_per_orbit[orbit] += 1
+        used.add((r, c))
+    return damaged
+
+
+def _semantic_checks(inp: np.ndarray, complete: np.ndarray, period: tuple[int, int], touched_hole: tuple[int, int], touched_solid: tuple[int, int]) -> bool:
+    if _detect_period(inp) != period:
+        return False
+    repaired = _repair_grid(inp, period)
+    if not np.array_equal(repaired, complete):
+        return False
+
+    hollow, solid = _classify_components(complete)
+    if not hollow or not solid:
+        return False
+
+    if int(inp[touched_hole]) != 0 or int(inp[touched_solid]) != 0:
+        return False
+
+    hole_block_r = touched_hole[0] // period[0]
+    hole_block_c = touched_hole[1] // period[1]
+    solid_block_r = touched_solid[0] // period[0]
+    solid_block_c = touched_solid[1] // period[1]
+    r0 = hole_block_r * period[0]
