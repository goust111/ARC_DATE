+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+INPUT_COLORS = (1, 4, 5, 6, 7, 8, 9)
+TEMPLATES = (
+    np.array(
+        [
+            [1, 1, 1, 0],
+            [1, 0, 1, 0],
+            [1, 1, 1, 2],
+            [0, 2, 2, 2],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [1, 1, 1, 2],
+            [1, 0, 1, 2],
+            [1, 1, 1, 2],
+            [3, 3, 3, 0],
+        ],
+        dtype=int,
+    ),
