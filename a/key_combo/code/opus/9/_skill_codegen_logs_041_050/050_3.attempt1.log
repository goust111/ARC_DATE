+    damaged_per_orbit = {orbit: 0 for orbit in orbit_counts}
+    used = set()
+    for cell in mandatory:
+        damaged[cell] = 0
+        orbit = (cell[0] % pr, cell[1] % pc)
+        damaged_per_orbit[orbit] += 1
+        used.add(cell)
+
+    candidates = []
+    for r in range(h):
+        for c in range(w):
+            if int(full[r, c]) == 0 or (r, c) in used:
+                continue
+            orbit = (r % pr, c % pc)
+            if damaged_per_orbit[orbit] >= orbit_counts[orbit] - 1:
+                continue
+            candidates.append((r, c))
+    random.shuffle(candidates)
+
+    for r, c in candidates:
+        if len(used) >= target:
+            break
+        orbit = (r % pr, c % pc)
+        if damaged_per_orbit[orbit] >= orbit_counts[orbit] - 1:
+            continue
+        damaged[r, c] = 0
+        damaged_per_orbit[orbit] += 1
+        used.add((r, c))
+    return damaged
