+        return None
+    _SEEN_OUTPUTS.add(output_sig)
+    _GEN_CALL_COUNT += 1
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
