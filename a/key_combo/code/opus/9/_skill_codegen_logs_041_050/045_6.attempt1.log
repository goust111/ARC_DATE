+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+GRID_SIZE = 20
+FRAME_LEFT = 1
+FRAME_RIGHT = 16
+INTERIOR_LEFT = FRAME_LEFT + 1
+INTERIOR_RIGHT = FRAME_RIGHT - 1
