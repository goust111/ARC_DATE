+        output_used |= cand["output_cells"]
+        jobs_seen.add((cand["dst_color"], cand["anchor_row"]))
+
+    return selected
+
+
+def _pick_invalid_objects(
+    rng: random.Random,
+    glyph_cells: set[tuple[int, int]],
+    selected: list[dict],
+    total_objects: int,
+) -> list[dict] | None:
+    need = total_objects - len(selected)
+    if need <= 0:
