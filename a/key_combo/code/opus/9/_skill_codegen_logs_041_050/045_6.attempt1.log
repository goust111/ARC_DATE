+    if not np.array_equal(parsed_mask, glyph_mask):
+        return None
+    if parsed_jobs != jobs:
+        return None
+    if len(parsed_triominoes) != total_objects:
+        return None
+    if len({job[0] for job in jobs}) == 1 and total_objects == 3 and rng.random() < 0.35:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
