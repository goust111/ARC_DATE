+GRID_SIDE_RANGE = (15, 20)
+PLACEHOLDER_COUNT_CHOICES = (2, 3, 3)
+MASK_DIMS = ((3, 3), (3, 4), (4, 3), (4, 4))
+MASK_PIXELS = (6, 7, 8, 9, 10)
+PADDING = 1
+MAX_ATTEMPTS = 500
