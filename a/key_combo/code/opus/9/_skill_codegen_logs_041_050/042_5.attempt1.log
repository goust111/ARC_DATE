    assert blocks, "expected at least one 2x2 block"
    return sorted(blocks)


def _ray_path(g: np.ndarray, start: tuple[int, int], direction: tuple[int, int], block_color: int) -> list[tuple[int, int]]:
    h, w = g.shape
    dr, dc = direction
    r, c = start
    path: list[tuple[int, int]] = []
