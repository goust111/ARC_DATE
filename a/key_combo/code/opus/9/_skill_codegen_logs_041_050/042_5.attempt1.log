+        key = _mask_key(mask)
+        if key in by_mask:
+            assert np.array_equal(by_mask[key], patch), "ambiguous color mapping for symmetric source shape"
+            continue
+        by_mask[key] = patch.copy()
+        variants.append({"id": idx, "patch": patch.copy(), "mask_key": key})
+    return variants
+
