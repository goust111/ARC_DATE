+    if r1 + 1 < h and np.any(grid[r1 + 1, c0 : c1 + 1] == MARKER):
+        hits.append("bottom")
+    if c0 > 0 and np.any(grid[r0 : r1 + 1, c0 - 1] == MARKER):
+        hits.append("left")
+    if c1 + 1 < w and np.any(grid[r0 : r1 + 1, c1 + 1] == MARKER):
