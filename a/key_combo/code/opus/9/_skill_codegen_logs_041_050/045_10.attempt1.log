+    yellow_end = rays[YELLOW]["last"][1]
+    if scenario["merge"] and red_end != yellow_end:
+        return False
+    if scenario["separate"] and red_end == yellow_end:
+        return False
+    if scenario["multi"] and max(rays[RED]["bounces"], rays[YELLOW]["bounces"]) < 2:
