+def _trace_ray(grid: np.ndarray, marker: tuple[int, int], max_bounces: int = 3) -> dict:
+    h, w = grid.shape
+    dr, dc = _center_direction((h, w), marker)
+    r, c = marker
+    last = (r, c)
+    path: list[tuple[int, int]] = []
+    hits: list[dict] = []
+    bounces = 0
+    seen_states = set()
+
+    while True:
+        state = (r, c, dr, dc, bounces)
+        if state in seen_states:
+            break
+        seen_states.add(state)
