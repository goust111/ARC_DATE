+    if row_ok:
+        anchor = row_matches[0]
+        ac = anchor[1]
+        target = {(r, mc + ac - c) for r, c in source_coords}
+        axis = "row"
+    else:
+        anchor = col_matches[0]
+        ar = anchor[0]
+        target = {(mr + ar - r, c) for r, c in source_coords}
+        axis = "col"
