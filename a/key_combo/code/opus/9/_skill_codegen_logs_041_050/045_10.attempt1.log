+                    if not all(_in_bounds(shape, r, c) and r < h - 1 for r, c in target):
+                        continue
+                    if not source_set.isdisjoint(target):
+                        continue
+                    if _touches_with_gap(source_set, target, gap=1):
+                        continue
+                    options.append(
