+def _center_direction(shape: tuple[int, int], marker: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    mr, mc = marker
+    center_r = (h - 1) / 2.0
+    center_c = (w - 1) / 2.0
+    dr = 1 if mr < center_r else -1
+    dc = 1 if mc < center_c else -1
+    return dr, dc
