+    yellow_col = ray_info[YELLOW]["last"][1]
+    if red_col == yellow_col:
+        out[h - 1, red_col] = PINK
+    else:
+        out[h - 1, red_col] = RED
+        out[h - 1, yellow_col] = YELLOW
+
+    return {
+        "output": out,
+        "scene": scene,
+        "source": source_set,
+        "markers": marker_pos,
+        "reflections": reflections,
+        "rays": ray_info,
+    }
