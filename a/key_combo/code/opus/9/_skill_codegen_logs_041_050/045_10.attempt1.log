+def _render(shape: tuple[int, int], cells_by_color: dict[int, set[tuple[int, int]]]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for color, cells in cells_by_color.items():
+        for r, c in cells:
+            grid[r, c] = color
