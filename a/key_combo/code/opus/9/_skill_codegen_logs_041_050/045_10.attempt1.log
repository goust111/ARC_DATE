+        {"axes": ("row", "col"), "merge": False, "separate": True, "multi": False},
+        {"axes": ("col", "row"), "merge": False, "separate": True, "multi": False},
+        {"axes": None, "merge": True, "separate": False, "multi": False},
+        {"axes": None, "merge": False, "separate": True, "multi": True},
