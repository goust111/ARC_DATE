def _rotate_ring(out: np.ndarray, g: np.ndarray, r0: int, c0: int) -> None:
    patch = g[r0 : r0 + 3, c0 : c0 + 3]

    out[r0 + 0, c0 + 0] = patch[0, 2]
    out[r0 + 0, c0 + 1] = patch[1, 0]
    out[r0 + 0, c0 + 2] = patch[2, 2]
    out[r0 + 1, c0 + 0] = patch[2, 1]
