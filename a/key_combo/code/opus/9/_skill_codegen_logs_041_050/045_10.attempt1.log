+    sh = max(r for r, _ in shape) + 1
+    sw = max(c for _, c in shape) + 1
+
+    max_r = h - sh - 2
+    max_c = w - sw - 1
+    if max_r < 1 or max_c < 1:
+        return None
+
+    for _ in range(30):
