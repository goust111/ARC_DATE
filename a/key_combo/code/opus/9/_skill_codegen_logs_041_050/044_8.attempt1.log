+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+_ROTATION_TO_AREAS = {
+    0: (4, 8),
+    1: (5,),
+    2: (6,),
+    3: (3, 7),
