+    for r, c in np.argwhere(g == RED):
+        up_hits = np.where(grey[: int(r), int(c)])[0]
+        down_hits = np.where(grey[int(r) + 1 :, int(c)])[0]
+        r0 = int(up_hits.max() + 1) if len(up_hits) else 0
+        r1 = int(r + 1 + down_hits.min()) if len(down_hits) else h
+        out[r0:r1, int(c)] = RED
