+    return tuple(tuple(int(x) for x in row) for row in mask.astype(int))
+
+
+def _connected4(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    seen = set()
+    stack = [tuple(map(int, coords[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
