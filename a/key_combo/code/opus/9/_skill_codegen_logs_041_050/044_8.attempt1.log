        inp = np.fliplr(inp).copy()
        out = np.fliplr(out).copy()
    return inp, out


def _gen_object(fg):
    if random.choice(BINARY_CHOICES):
        return _gen_horizontal_object(fg)
    return _gen_vertical_object(fg)


