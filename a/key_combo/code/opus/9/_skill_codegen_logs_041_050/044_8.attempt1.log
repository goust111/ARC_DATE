+def _connected4(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    seen = set()
+    stack = [tuple(map(int, coords[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                stack.append((nr, nc))
