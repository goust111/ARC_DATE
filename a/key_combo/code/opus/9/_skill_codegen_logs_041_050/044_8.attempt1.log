+        above = grey_rows[grey_rows < int(r)]
+        below = grey_rows[grey_rows > int(r)]
+        top = int(above.max() + 1) if len(above) else 0
+        bottom = int(below.min()) if len(below) else g.shape[0]
+        return "v", top, bottom
