+def _place_mask(grid: np.ndarray, mask: np.ndarray, color: int, r0: int, c0: int) -> np.ndarray:
+    out = grid.copy()
+    h, w = mask.shape
+    out[r0 : r0 + h, c0 : c0 + w][mask] = int(color)
+    return out
