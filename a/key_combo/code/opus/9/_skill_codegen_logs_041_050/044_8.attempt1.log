+_GEN_RETRY_LIMIT = 500
+_GRID_SIZE_RANGE = (10, 12)
+_SEED_COUNT_CHOICES = (2, 3, 4)
+_SPRITE_COLORS = (GREY,)
+_HORIZONTAL_COLORS = (GREEN, BLUE)
