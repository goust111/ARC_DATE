+def _expand(coords: set[tuple[int, int]], h: int, w: int, radius: int = 1) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
