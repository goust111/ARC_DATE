+
+def _parse_objects(grid: np.ndarray) -> tuple[dict, list[dict], list[dict]]:
+    shape_components = []
+    mask = np.isin(grid, [BODY, INDICATOR])
+    for cells in _components_from_mask(mask, connectivity=4):
