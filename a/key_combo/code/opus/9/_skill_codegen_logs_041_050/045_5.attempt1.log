+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        q = deque([(r, c)])
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while q:
+            cr, cc = q.popleft()
+            comp.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
