+
+def _steps_to_edge(shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]) -> int:
+    r, c = start
+    dr, dc = direction
+    row_steps = shape[0] - 1 - r if dr > 0 else r
+    col_steps = shape[1] - 1 - c if dc > 0 else c
+    return min(row_steps, col_steps)
