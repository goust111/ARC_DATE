+def _marker_cells(top_left: tuple[int, int]) -> dict[str, tuple[int, int, int]]:
+    r, c = top_left
+    return {
+        kind: (r + dr, c + dc, color)
+        for kind, (color, (dr, dc)) in MARKER_INFO.items()
+    }
