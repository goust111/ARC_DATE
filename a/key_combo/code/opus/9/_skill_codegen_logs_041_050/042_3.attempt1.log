+
+def _label_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                if connectivity == 4:
+                    nbrs = neighbors4(rr, cc)
+                else:
+                    nbrs = (
+                        (rr + dr, cc + dc)
+                        for dr in (-1, 0, 1)
+                        for dc in (-1, 0, 1)
+                        if dr or dc
+                    )
+                for nr, nc in nbrs:
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _find_components(grid: np.ndarray, bg: int, *, skip: np.ndarray | None = None) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if skip is not None:
+        seen |= skip
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
