+        cc = int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if (nr, nc) in target:
+                return True
+    return False
+
+
+def _slide_right_until_contact(
+    coords: np.ndarray,
+    occupied: set[tuple[int, int]],
+    width: int,
+) -> tuple[np.ndarray, int]:
+    dx = 0
+    while True:
+        can_advance = True
+        for r, c in coords:
+            nr = int(r)
+            nc = int(c) + dx + 1
+            if nc >= width or (nr, nc) in occupied:
+                can_advance = False
