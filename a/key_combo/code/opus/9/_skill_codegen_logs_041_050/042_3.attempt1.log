+    return shifted, dx
+
+
+def _sorted_objects(components: list[dict], *, mode: str, anchor_left: int) -> list[dict]:
+    if mode == "area":
+        return sorted(components, key=lambda obj: (obj["area"], obj["bbox"][0], obj["bbox"][1]))
+    if mode == "distance":
