+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+ANCHOR = 4
+PALETTE = [1, 2, 3, 5, 6, 7, 8]
+MAX_ATTEMPTS = 600
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _label_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                if connectivity == 4:
+                    nbrs = neighbors4(rr, cc)
+                else:
+                    nbrs = (
+                        (rr + dr, cc + dc)
+                        for dr in (-1, 0, 1)
+                        for dc in (-1, 0, 1)
+                        if dr or dc
+                    )
+                for nr, nc in nbrs:
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(pts, dtype=int))
+    return comps
+
+
+def _find_components(grid: np.ndarray, bg: int, *, skip: np.ndarray | None = None) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if skip is not None:
+        seen |= skip
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.asarray(pts, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "area": int(len(pts)),
+                    "bbox": bbox_coords(coords),
+                }
+            )
+    return comps
+
+
+def _anchor_component(grid: np.ndarray) -> tuple[np.ndarray, set[tuple[int, int]], tuple[int, int, int, int]]:
+    comps = _label_mask(grid == ANCHOR, connectivity=4)
+    matches = []
+    for coords in comps:
+        if coords.shape[0] != 4:
+            continue
+        r0, c0, r1, c1 = bbox_coords(coords)
+        if r1 - r0 == 1 and c1 - c0 == 1:
+            box = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+            pts = {tuple(map(int, p)) for p in coords}
+            if pts == box:
+                matches.append((coords, pts, (r0, c0, r1, c1)))
+    assert len(matches) == 1, "expected exactly one yellow 2x2 anchor"
+    return matches[0]
+
+
+def _touches_set(coords: np.ndarray, target: set[tuple[int, int]]) -> bool:
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in neighbors4(rr, cc):
+            if (nr, nc) in target:
+                return True
+    return False
+
+
+def _slide_right_until_contact(
+    coords: np.ndarray,
+    occupied: set[tuple[int, int]],
+    width: int,
+) -> tuple[np.ndarray, int]:
+    dx = 0
