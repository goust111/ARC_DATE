+def _normalize(coords: set[tuple[int, int]] | list[tuple[int, int]]) -> np.ndarray:
+    arr = np.asarray(list(coords), dtype=int)
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    arr = arr[np.lexsort((arr[:, 1], arr[:, 0]))]
+    return arr
+
