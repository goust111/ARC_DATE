+def _alternative_swap_all(sprite: np.ndarray) -> np.ndarray:
+    n = int(sprite.shape[0])
+    out = np.zeros((n * n, n * n), dtype=int)
+    swapped = _swap_colors(sprite)
+    for r in range(n):
