+        if h > 6 or w > 6:
+            continue
+        if h == 1 or w == 1:
+            continue
+        bbox_area = h * w
+        if area == bbox_area and min(h, w) >= 2:
+            continue
+        if h == 2 and w == 2 and area == 3:
+            return cells
+        perimeter_like = sum(
+            1
+            for r, c in cells
+            if sum((nr, nc) in cells for nr, nc in _neighbors4(r, c)) <= 2
+        )
+        if perimeter_like < max(2, area // 3):
+            continue
+        return cells
+    raise RuntimeError(f"failed to grow shape of area {area}")
+
+
+def _place_objects(
+    height: int,
+    width: int,
+    shapes: list[set[tuple[int, int]]],
+    colors: list[int],
+    legend_start_col: int,
+    rng: random.Random,
+) -> np.ndarray | None:
+    grid = np.zeros((height, width), dtype=int)
+    blocked = np.zeros((height, width), dtype=bool)
+
+    reserved_r0 = 0
+    reserved_r1 = min(height - 1, 2)
+    reserved_c0 = max(0, legend_start_col - 1)
+    blocked[reserved_r0 : reserved_r1 + 1, reserved_c0:width] = True
+
+    order = sorted(range(len(shapes)), key=lambda i: len(shapes[i]), reverse=True)
+    for idx in order:
+        shape = shapes[idx]
+        color = int(colors[idx])
+        shape_h, shape_w = _bbox(shape)
+        placed = False
+        for _ in range(PLACEMENT_ATTEMPTS):
+            r0 = rng.randint(3, height - shape_h)
+            c0 = rng.randint(0, width - shape_w)
+            coords = [(r0 + r, c0 + c) for r, c in shape]
+            if any(blocked[r, c] for r, c in coords):
+                continue
+            for r, c in coords:
+                grid[r, c] = color
+            for r, c in coords:
+                for rr in range(r - 1, r + 2):
+                    for cc in range(c - 1, c + 2):
+                        if 0 <= rr < height and 0 <= cc < width:
+                            blocked[rr, cc] = True
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
+
+def _validate_example(grid: np.ndarray) -> None:
+    mapping, legend_mask, legend_top, legend_bottom = _detect_legend(grid)
+    objects = _find_components(grid, blocked_mask=legend_mask)
+    assert len(objects) == len(mapping)
+    assert {int(obj["color"]) for obj in objects} == set(mapping)
+
+    areas = [int(obj["area"]) for obj in objects]
+    assert len(set(areas)) == len(areas)
+    assert set(legend_top) == {int(obj["color"]) for obj in objects}
+    assert set(legend_bottom).isdisjoint(legend_top)
+
+    ordered = sorted(objects, key=lambda obj: int(obj["area"]), reverse=True)
+    correct_sequence = [int(mapping[int(obj["color"])]) for obj in ordered]
+    assert len(set(correct_sequence)) == len(correct_sequence)
+
+    original_sequence = [int(obj["color"]) for obj in ordered]
+    assert correct_sequence != original_sequence, "mapping must affect the output"
+
+    by_legend_key = [int(mapping[c]) for c in legend_top]
+    assert correct_sequence != by_legend_key, "area ordering must affect the output"
+    assert correct_sequence != legend_bottom, "legend value order alone must not solve the task"
+
+    out = main(grid)
+    assert out.shape == (2 * len(objects) - 1, 2 * len(objects) - 1)
+    assert np.array_equal(out, _ring_output(correct_sequence))
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n = rng.choice(OBJECT_COUNT_CHOICES)
+    height = rng.randint(*GRID_HEIGHT_RANGE)
+    width = rng.randint(max(GRID_WIDTH_RANGE[0], n + 7), GRID_WIDTH_RANGE[1])
+
+    palette = list(range(1, 10))
+    rng.shuffle(palette)
+    object_colors = palette[:n]
+    mapped_colors = palette[n : 2 * n]
+    if len(mapped_colors) < n:
+        return None
+
+    areas = sorted(rng.sample(AREA_VALUES, n), reverse=True)
+    legend_key_order = object_colors[:]
+    rng.shuffle(legend_key_order)
+
+    mapping_items = list(zip(legend_key_order, rng.sample(mapped_colors, n)))
+    mapping = dict(mapping_items)
+
+    ordered_object_colors = [color for color, _area in sorted(zip(object_colors, areas), key=lambda x: x[1], reverse=True)]
+    correct_sequence = [mapping[color] for color in ordered_object_colors]
+    if correct_sequence == ordered_object_colors:
+        return None
+    if correct_sequence == [mapping[c] for c in legend_key_order]:
+        return None
+    if correct_sequence == [value for _, value in mapping_items]:
+        return None
+
+    try:
+        shapes = [_grow_shape(area, rng) for area in areas]
+    except RuntimeError:
+        return None
+
+    legend_start_col = width - n
+    obj_grid = _place_objects(height, width, shapes, object_colors, legend_start_col, rng)
+    if obj_grid is None:
+        return None
+
+    grid = obj_grid.copy()
+    grid[0, legend_start_col:width] = np.array(legend_key_order, dtype=int)
+    grid[1, legend_start_col:width] = np.array([mapping[c] for c in legend_key_order], dtype=int)
+
+    try:
+        _validate_example(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

