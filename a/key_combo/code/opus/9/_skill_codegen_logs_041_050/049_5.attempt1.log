+            if any(blocked[r, c] for r, c in coords):
+                continue
+            for r, c in coords:
+                grid[r, c] = color
+            for r, c in coords:
+                for rr in range(r - 1, r + 2):
+                    for cc in range(c - 1, c + 2):
+                        if 0 <= rr < height and 0 <= cc < width:
+                            blocked[rr, cc] = True
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
