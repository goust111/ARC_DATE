    areas: all mutually distinct, each 1-9 pixels
    connectivity: each color forms exactly one 4-connected component
    separation: no two objects are 4-adjacent (gap >= 1 bg cell)
    shapes: arbitrary connected blobs; no special symmetry required
  output:
    side: 2 * object_count - 1 (square)
    structure: concentric 1-cell-thick square rings
    ordering: outermost ring = color with largest area, each inner ring = next smaller area, center pixel = smallest area

generation_strategy:
