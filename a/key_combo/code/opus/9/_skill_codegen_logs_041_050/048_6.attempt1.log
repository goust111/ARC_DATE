+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+WAVE_COLOR = 5
+PALETTE_CHOICES = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GEN_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise AssertionError("expected a non-empty mask")
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(arr: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return arr[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(int(a[0]), int(b[0])) <= min(int(a[1]), int(b[1]))
+
+
+def _extract_palette(
+    grid: np.ndarray, bg: int, wave_c0: int
+) -> tuple[list[int], list[int]]:
+    palette_cols: list[int] = []
+    palette: list[int] = []
+    for c in range(int(wave_c0)):
+        col = grid[:, c]
+        if np.all(col == col[0]) and int(col[0]) not in (int(bg), WAVE_COLOR):
+            palette_cols.append(int(c))
+            palette.append(int(col[0]))
+
+    if not palette_cols:
+        raise AssertionError("missing palette columns")
+    if palette_cols != list(range(palette_cols[0], palette_cols[-1] + 1)):
+        raise AssertionError("palette columns must form one contiguous block")
+    if len(set(palette)) != len(palette):
+        raise AssertionError("palette colors must be distinct")
+    return palette_cols, palette
+
+
+def _column_spans(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    spans: list[tuple[int, int]] = []
+    for c in range(w):
+        rows = np.flatnonzero(mask[:, c])
+        if rows.size == 0:
+            raise AssertionError("every wave column must contain a segment")
+        r0, r1 = int(rows[0]), int(rows[-1])
+        if rows.size != r1 - r0 + 1:
+            raise AssertionError("each wave column must be one contiguous segment")
+        spans.append((r0, r1))
+
+    for c in range(w - 1):
+        if not _intervals_overlap(spans[c], spans[c + 1]):
+            raise AssertionError("adjacent wave columns must share at least one row")
+    if h < 2:
+        raise AssertionError("wave height must be at least 2")
+    return spans
+
+
+def _parse_grid(
+    grid: np.ndarray,
+) -> tuple[np.ndarray, int, list[int], list[int], tuple[int, int, int, int], np.ndarray, list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2:
+        raise AssertionError("expected a 2D grid")
+    bg = _get_bg(g)
+
+    wave_mask = g == WAVE_COLOR
+    if not wave_mask.any():
+        raise AssertionError("missing wave pattern")
+    wave_bbox = _bbox(wave_mask)
+    seed_mask = _crop(wave_mask, wave_bbox)
+    spans = _column_spans(seed_mask)
+
+    palette_cols, palette = _extract_palette(g, bg, wave_bbox[1])
+    if len(palette) != seed_mask.shape[1]:
+        raise AssertionError("palette count must equal wave width")
+
+    allowed = np.zeros_like(g, dtype=bool)
+    allowed[wave_mask] = True
+    allowed[:, palette_cols] = True
+    if np.any((g != bg) & (~allowed)):
+        raise AssertionError("unexpected extra foreground objects")
+    if np.any(g[:, palette_cols] == bg) or np.any(g[:, palette_cols] == WAVE_COLOR):
+        raise AssertionError("palette columns must be solid non-wave colors")
+
+    return g, bg, palette_cols, palette, wave_bbox, seed_mask, spans
+
+
+def _paint_layer(mask: np.ndarray, palette: list[int], reverse_palette: bool) -> np.ndarray:
+    h, w = mask.shape
+    colors = list(reversed(palette)) if reverse_palette else list(palette)
+    layer = np.full((h, w), BG, dtype=int)
+    for c, color in enumerate(colors):
+        layer[mask[:, c], c] = int(color)
+    return layer
+
+
+def _build_output(
+    grid_width: int, wave_c0: int, seed_mask: np.ndarray, palette: list[int], bg: int
+) -> np.ndarray:
+    h, w = seed_mask.shape
+    out = np.full((4 * h - 3, int(grid_width)), int(bg), dtype=int)
+    for i in range(4):
+        geom = seed_mask if i % 2 == 0 else np.flipud(seed_mask)
+        patch = _paint_layer(geom, palette, reverse_palette=bool(i % 2))
+        r0 = i * (h - 1)
+        view = out[r0 : r0 + h, wave_c0 : wave_c0 + w]
+        fill = (patch != bg) & (view == bg)
+        view[fill] = patch[fill]
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Stack a right-side wave four times while recoloring each layer from the left palette, reversing palette order on flipped layers.
+
+    Input structure:
+    - Black background surrounds one contiguous block of full-height palette columns on the left and one gray wave pattern on the right.
+    - The palette columns are single-color, adjacent, distinct, and their count equals the number of wave columns.
+    - Inside the wave bbox, each column contains exactly one contiguous vertical gray segment, and neighboring columns share at least one row.
+
+    Rule:
+    - Read the palette colors from left to right.
+    - Crop the gray wave to its tight bbox and stack four copies with one-row overlaps: original, vertically flipped, original, vertically flipped.
+    - Recolor each layer column-by-column from left to right: even layers use the palette in forward order, odd layers use it in reverse order.
+    - Keep the wave in its original column band, expand the output vertically to fit the four-layer stack, erase the palette to background, and keep the upper layer on overlap rows.
+
+    Key insight:
+    - The flipped layers are coupled to the palette direction: geometry flips vertically, and the visible color order flips horizontally through reversed palette assignment.
+    """
+    g, bg, _palette_cols, palette, wave_bbox, seed_mask, _spans = _parse_grid(grid)
+    _r0, wave_c0, _r1, _c1 = wave_bbox
+    return _build_output(g.shape[1], wave_c0, seed_mask, palette, bg)
+
+
+def _all_spans(height: int) -> list[tuple[int, int]]:
+    spans = []
+    for r0 in range(height):
+        for r1 in range(r0 + 1, height):
+            spans.append((r0, r1))
+    return spans
+
+
+def _generate_spans(width: int, height: int) -> list[tuple[int, int]] | None:
+    candidates = _all_spans(height)
+    non_middle = {j for j in range(width) if j != width - 1 - j}
+    for _ in range(200):
+        spans = [random.choice(candidates)]
+        for _col in range(1, width):
+            prev = spans[-1]
+            local = [
+                span
+                for span in candidates
+                if _intervals_overlap(prev, span)
+                and abs(span[0] - prev[0]) <= 2
+                and abs(span[1] - prev[1]) <= 2
+            ]
+            if not local:
+                local = [span for span in candidates if _intervals_overlap(prev, span)]
+            spans.append(random.choice(local))
+
+        if len(set(spans)) < 2:
+            continue
+        if all(span == (0, height - 1) for span in spans):
+            continue
+        if not any(spans[j][0] == 0 and j in non_middle for j in range(width)):
+            continue
+        if not any(spans[j][1] == height - 1 and j in non_middle for j in range(width)):
+            continue
+        if not any(span[0] > 0 or span[1] < height - 1 for span in spans):
+            continue
+        return spans
+    return None
+
+
+def _seed_from_spans(spans: list[tuple[int, int]], height: int) -> np.ndarray:
+    seed = np.zeros((height, len(spans)), dtype=bool)
+    for c, (r0, r1) in enumerate(spans):
+        seed[r0 : r1 + 1, c] = True
+    return seed
+
+
+def _conflict_columns(spans: list[tuple[int, int]], height: int) -> tuple[list[int], list[int]]:
+    width = len(spans)
+    top_cols = [j for j, (r0, _r1) in enumerate(spans) if r0 == 0 and j != width - 1 - j]
+    bottom_cols = [j for j, (_r0, r1) in enumerate(spans) if r1 == height - 1 and j != width - 1 - j]
+    return top_cols, bottom_cols
+
+
+def _validate_semantics(grid: np.ndarray) -> None:
+    g, bg, palette_cols, palette, wave_bbox, seed_mask, spans = _parse_grid(grid)
+    wave_c0 = int(wave_bbox[1])
+    h, w = seed_mask.shape
+    top_cols, bottom_cols = _conflict_columns(spans, h)
+
+    if not (3 <= len(palette) <= 5):
+        raise AssertionError("palette width out of range")
+    if not top_cols or not bottom_cols:
+        raise AssertionError("need top-touch and bottom-touch non-middle columns")
+    if g.shape[0] > 30 or g.shape[1] > 30:
+        raise AssertionError("input exceeds ARC bounds")
+
+    out = main(g)
+    if out.shape != (4 * h - 3, g.shape[1]):
+        raise AssertionError("unexpected output shape")
+    if out.shape[0] > 30 or out.shape[1] > 30:
+        raise AssertionError("output exceeds ARC bounds")
+    if np.any(out[:, palette_cols[0] : palette_cols[-1] + 1] != bg):
+        raise AssertionError("palette area must be erased in output")
+
+    def layer_color(layer_idx: int, col_idx: int) -> int:
+        return int(palette[col_idx] if layer_idx % 2 == 0 else palette[w - 1 - col_idx])
+
+    for j in bottom_cols:
+        if layer_color(0, j) == layer_color(1, j):
+            raise AssertionError("bottom overlap must create a real color conflict")
+        if int(out[h - 1, wave_c0 + j]) != layer_color(0, j):
+            raise AssertionError("upper layer must win on first overlap row")
+        if int(out[3 * (h - 1), wave_c0 + j]) != layer_color(2, j):
+            raise AssertionError("upper layer must win on third overlap row")
+
+    for j in top_cols:
+        if layer_color(1, j) == layer_color(2, j):
+            raise AssertionError("middle overlap must create a real color conflict")
+        if int(out[2 * (h - 1), wave_c0 + j]) != layer_color(1, j):
+            raise AssertionError("upper flipped layer must win on middle overlap row")
+
+    if np.array_equal(_paint_layer(seed_mask, palette, False), _paint_layer(seed_mask, palette, True)):
+        raise AssertionError("reverse palette must change visible colors")
+
+
+def _generate_one() -> np.ndarray | None:
+    palette_width = random.randint(3, 5)
+    wave_height = random.randint(4, 5)
+    spans = _generate_spans(palette_width, wave_height)
+    if spans is None:
+        return None
+
+    palette = random.sample(PALETTE_CHOICES, palette_width)
+    palette_start = random.randint(0, 1)
+    gap = random.randint(1, 3)
+    wave_c0 = palette_start + palette_width + gap
+    right_pad = random.randint(0, 3)
+    width = wave_c0 + palette_width + right_pad
+
+    input_height = random.randint(wave_height + 1, min(10, wave_height + 4))
+    wave_r0 = random.randint(0, input_height - wave_height)
+    if width > 30 or input_height > 30:
+        return None
+
+    seed = _seed_from_spans(spans, wave_height)
+    grid = np.full((input_height, width), BG, dtype=int)
+    for i, color in enumerate(palette):
+        grid[:, palette_start + i] = int(color)
+    wave_view = grid[wave_r0 : wave_r0 + wave_height, wave_c0 : wave_c0 + palette_width]
+    wave_view[seed] = WAVE_COLOR
+
+    occupied = int(np.count_nonzero(grid != BG))
+    if occupied * 2 >= grid.size:
+        return None
+
+    _validate_semantics(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _generate_one()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

