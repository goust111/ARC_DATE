116: def _gen_bounded_sum(bounds: list[tuple[int, int]], total: int) -> list[int] | None:
117:     """Return a shuffled random allocation that sums to total within per-slot bounds."""
118:     values: list[int | None] = [None] * len(bounds)
119:     order = list(range(len(bounds)))
120:     random.shuffle(order)
121:     remaining = total
122:     for pos, idx in enumerate(order):
123:         rest = order[pos + 1 :]
124:         rest_min = sum(bounds[j][0] for j in rest)
125:         rest_max = sum(bounds[j][1] for j in rest)
126:         lo, hi = bounds[idx]
127:         v_min = max(lo, remaining - rest_max)
128:         v_max = min(hi, remaining - rest_min)
129:         if v_min > v_max:
130:             return None
131:         value = random.randint(v_min, v_max)
132:         values[idx] = value
133:         remaining -= value
134:     if remaining != 0:
135:         return None
136:     return [int(v) for v in values]
