398: def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
399:     """List of components from a boolean mask, each as an (N,2) coords array."""
400:     lab, n = label_mask(mask, connectivity=connectivity)
401:     return [np.argwhere(lab == k) for k in range(1, n + 1)]
402: 
