+    for c in range(int(wave_c0)):
+        col = grid[:, c]
+        if np.all(col == col[0]) and int(col[0]) not in (int(bg), WAVE_COLOR):
+            palette_cols.append(int(c))
+            palette.append(int(col[0]))
+
+    if not palette_cols:
+        raise AssertionError("missing palette columns")
+    if palette_cols != list(range(palette_cols[0], palette_cols[-1] + 1)):
+        raise AssertionError("palette columns must form one contiguous block")
+    if len(set(palette)) != len(palette):
+        raise AssertionError("palette colors must be distinct")
+    return palette_cols, palette
+
+
+def _column_spans(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    spans: list[tuple[int, int]] = []
+    for c in range(w):
+        rows = np.flatnonzero(mask[:, c])
+        if rows.size == 0:
+            raise AssertionError("every wave column must contain a segment")
+        r0, r1 = int(rows[0]), int(rows[-1])
+        if rows.size != r1 - r0 + 1:
+            raise AssertionError("each wave column must be one contiguous segment")
+        spans.append((r0, r1))
