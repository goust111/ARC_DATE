+        rows = np.flatnonzero(mask[:, c])
+        if rows.size == 0:
+            raise AssertionError("every wave column must contain a segment")
+        r0, r1 = int(rows[0]), int(rows[-1])
+        if rows.size != r1 - r0 + 1:
