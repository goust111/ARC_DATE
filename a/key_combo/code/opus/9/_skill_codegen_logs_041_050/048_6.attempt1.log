42:         r1, c1 = pts.max(axis=0)
43:         r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
44:         h = int(r1 - r0 + 1)
45:         w = int(c1 - c0 + 1)
46:         if h < 3 or w < 3:
47:             continue
48: 
49:         t = None
50:         inner_col = None
51:         for tt in range(1, int(min(h, w) // 2) + 1):
52:             inner = g[int(r0 + tt) : int(r1 - tt) + 1, int(c0 + tt) : int(c1 - tt) + 1]
53:             if inner.size == 0:
54:                 continue
55:             if bool((inner == int(border)).any()):
56:                 continue
57:             u = set(map(int, inner.flatten()))
58:             if len(u) != 1:
59:                 continue
60: 
61:             ok = True
62:             if not bool((g[int(r0) : int(r0 + tt), int(c0) : int(c1) + 1] == int(border)).all()):
63:                 ok = False
64:             if not bool((g[int(r1 - tt) + 1 : int(r1) + 1, int(c0) : int(c1) + 1] == int(border)).all()):
65:                 ok = False
66:             if not bool((g[int(r0) : int(r1) + 1, int(c0) : int(c0 + tt)] == int(border)).all()):
67:                 ok = False
68:             if not bool((g[int(r0) : int(r1) + 1, int(c1 - tt) + 1 : int(c1) + 1] == int(border)).all()):
69:                 ok = False
70:             if not ok:
