    return 0 <= r < GEN_GRID_H and 0 <= c < GEN_GRID_W


def _gen_span(cells: set[tuple[int, int]]) -> tuple[int, int]:
    rows = [r for r, _ in cells]
    cols = [c for _, c in cells]
