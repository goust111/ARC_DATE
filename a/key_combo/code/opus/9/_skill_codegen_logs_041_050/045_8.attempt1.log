+        if placed is None:
+            return None
+
+        occupied_input |= {tuple(map(int, cell)) for cell in placed["coords"].tolist()}
+        occupied_output |= {tuple(map(int, cell)) for cell in placed["moved"].tolist()}
+        blocked_sweeps |= placed["swept"]
+        placements.append(placed)
+    return placements
+
