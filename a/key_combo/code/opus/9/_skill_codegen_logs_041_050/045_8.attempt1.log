+    if side == "top":
+        max_row = r0 - 3 - shape_h + 1
+        col_lo = max(0, target_c - shape_w - 2)
+        col_hi = min(w - shape_w, target_c + 2)
+        for rr in range(max_row + 1):
+            for cc in range(col_lo, col_hi + 1):
