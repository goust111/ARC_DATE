+
+
+def _candidate_anchors(
+    side: str,
+    shape_h: int,
+    shape_w: int,
+    target_rc: tuple[int, int],
+    central_bbox: tuple[int, int, int, int],
+    grid_shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = grid_shape
+    r0, c0, r1, c1 = central_bbox
+    target_r, target_c = target_rc
+    anchors: list[tuple[int, int]] = []
