+        central_coords = np.argwhere(grid != BLACK)
+        _stretched, border_cells = _stretch_border(grid, central_bbox)
+        placements = _place_satellites(
+            grid.shape,
+            central_bbox,
+            border_cells,
+            target_info,
+            central_coords,
+            side_commands,
