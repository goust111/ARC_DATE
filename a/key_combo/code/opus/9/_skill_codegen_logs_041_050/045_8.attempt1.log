+
+
+def _stretch_border(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+) -> tuple[np.ndarray, list[tuple[int, int, int]]]:
+    out = grid.copy()
+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox
