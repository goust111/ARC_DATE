+    out[r0 : r1 + 1, c1 + 1] = grid[r0 : r1 + 1, c1]
+    out[r0 - 1, c0 - 1] = BLACK
+    out[r0 - 1, c1 + 1] = BLACK
+    out[r1 + 1, c0 - 1] = BLACK
+    out[r1 + 1, c1 + 1] = BLACK
