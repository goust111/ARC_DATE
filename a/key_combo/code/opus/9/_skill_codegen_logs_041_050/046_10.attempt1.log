+    depth = _depth_grid(_bbox_h(box), _bbox_w(box))
+    patch = np.zeros((_bbox_h(box), _bbox_w(box)), dtype=int)
+    for layer, color in enumerate(colors):
+        patch[depth == layer] = color
+    grid[r0 : r1 + 1, c0 : c1 + 1] = patch
