            elif side=='bot': rr=H-1
            elif side=='inttop': rr=random.randint(1,r-1)
            else: rr=random.randint(r+1,H-2)
            reds.append((rr,cc))
    else:
        c=random.randint(3,W-4)
        lo=random.randint(0,3)
        hi=random.randint(H-4,H-1)
        reds=[(lo,c),(hi,c)]
        rows=random.sample(range(lo+1,hi), random.randint(3,6))
        for rr in rows:
            side=random.choice(['left','right','intleft','intright'])
            if side=='left': cc=0
            elif side=='right': cc=W-1
            elif side=='intleft': cc=random.randint(1,c-1)
