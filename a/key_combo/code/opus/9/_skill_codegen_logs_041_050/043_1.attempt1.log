def find_trunk(reds):
    rows=defaultdict(list); cols=defaultdict(list)
    for r,c in reds:
        rows[r].append(c); cols[c].append(r)
    rs=[(r,sorted(cs)) for r,cs in rows.items() if len(cs)==2]
    cs=[(c,sorted(rs)) for c,rs in cols.items() if len(rs)==2]
    if len(rs)+len(cs)"'!=1:return None
    if rs:
        r,cols2=rs[0]; return ('"'row',r,cols2[0],cols2[1])
    c,rows2=cs[0]; return ('col',c,rows2[0],rows2[1])

def solve(inp):
    reds=[tuple(map(int,x)) for x in np.argwhere(inp==RED)]
    t=find_trunk(reds)
    if t is None:return None
    axis,fixed,lo,hi=t
    out=inp.copy()
    if axis=='row':
        for c in range(lo+1,hi): out[fixed,c]=GREEN
        for r,c in reds:
            if r==fixed: continue
            if not lo<=c<=hi:return None
            a,b=sorted((r,fixed))
            for rr in range(a+1,b): out[rr,c]=GREEN
    else:
        for r in range(lo+1,hi): out[r,fixed]=GREEN
        for r,c in reds:
            if c==fixed: continue
            if not lo<=r<=hi:return None
            a,b=sorted((c,fixed))
            for cc in range(a+1,b): out[r,cc]=GREEN
    rs=[r for r,_ in reds]; cs=[c for _,c in reds]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    H,W=out.shape
    vis=np.zeros((H,W),bool)
    ks=[]
    for r in range(r0+1,r1):
      for c in range(c0+1,c1):
        if out[r,c]"'!=0 or vis[r,c]: continue
        st=[(r,c)]; vis[r,c]=1; pts=[]; adj=set()
        while st:
          x,y=st.pop(); pts.append((x,y))
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if r0 < nx < r1 and c0 < ny < c1:
              if out[nx,ny]==0 and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
              elif out[nx,ny]==RED: adj.add((nx,ny))
            else:
              # bbox wall, ignore
              pass
        if pts:
          ks.append(len(adj))
    return sorted(ks)

