import numpy as np

RED, GREEN, BG = 2,3,0

def draw(shape, reds):
    H,W=shape
    g=np.zeros((H,W),dtype=int)
    for r,c in reds:g[r,c]=RED
    rows=defaultdict(list); cols=defaultdict(list)
    for r,c in reds:
        rows[r].append(c); cols[c].append(r)
    pairs=[('row',r,sorted(cs)) for r,cs in rows.items() if len(cs)==2]+[('col',c,sorted(rs)) for c,rs in cols.items() if len(rs)==2]
    if len(pairs)"'!=1:return None
    axis,fixed,ab=pairs[0]
    lo,hi=ab
    out=g.copy()
    if axis=='"'row':
        r=fixed
        for c in range(lo+1,hi): out[r,c]=GREEN
        for rr,cc in reds:
            if rr==r: continue
            if not lo<=cc<=hi:return None
            a,b=sorted((rr,r))
            for x in range(a+1,b):
                if out[x,cc]==0: out[x,cc]=GREEN
    else:
        c=fixed
        for r in range(lo+1,hi): out[r,c]=GREEN
        for rr,cc in reds:
            if cc==c: continue
            if not lo<=rr<=hi:return None
            a,b=sorted((cc,c))
            for x in range(a+1,b):
                if out[rr,x]==0: out[rr,x]=GREEN
    return out

def comps(out):
    H,W=out.shape
    vis=np.zeros((H,W),bool)
    rs=[]
    for r in range(H):
      for c in range(W):
        if out[r,c]"'!=0 or vis[r,c]: continue
        st=[(r,c)]; vis[r,c]=1; pts=[]; touch=False; adj=set()
        while st:
          x,y=st.pop(); pts.append((x,y))
          if x in (0,H-1) or y in (0,W-1): touch=True
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W:
              if out[nx,ny]==0 and not vis[nx,ny]: vis[nx,ny]=1; st.append((nx,ny))
              elif out[nx,ny]==RED: adj.add((nx,ny))
        rs.append((pts,touch,len(adj),adj))
    return rs

H=W=15
