+def _find_trunk(red_coords: list[tuple[int, int]]) -> tuple[str, int, int, int]:
+    rows: dict[int, list[int]] = defaultdict(list)
+    cols: dict[int, list[int]] = defaultdict(list)
+    for r, c in red_coords:
