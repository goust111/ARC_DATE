+        cols[c].append(r)
+
+    row_trunks = [(r, sorted(cs)) for r, cs in rows.items() if len(cs) == 2]
+    col_trunks = [(c, sorted(rs)) for c, rs in cols.items() if len(rs) == 2]
+    assert len(row_trunks) + len(col_trunks) == 1, "expected exactly one aligned red pair"
