def _gen_attempt():
    rng = np.random.default_rng()
    h = int(rng.integers(*GRID_HEIGHT_RANGE))
    w = int(rng.integers(*GRID_WIDTH_RANGE))

    guide_pair = _gen_guide_masks(rng, h, w)
    if guide_pair is None:
