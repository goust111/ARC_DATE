def _gen_template_two_markers() -> TemplateInfo | None:
    if random.random() < TWO_MARKER_HORIZONTAL_PROB:
        th, tw = random.randint(TEMPLATE_MIN_HEIGHT_FOR_WIDTH3, TEMPLATE_HEIGHT_RANGE[1]), 4
        row = random.randrange(th)
