    source = _gen_grow_source(seed, markers, th, tw, source_n)
    if source is None:
        return None

    canvas = np.zeros((th, tw), dtype=int)
    for r, c in source:
        canvas[r, c] = SOURCE_COLOR
    for marker in markers:
        canvas[marker] = MARKER_COLOR
