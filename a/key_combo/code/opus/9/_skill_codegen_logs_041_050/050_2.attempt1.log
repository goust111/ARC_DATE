+def _render_input(shape: tuple[int, int], marker_map: dict[tuple[int, int], int], frames: list[dict]) -> np.ndarray:
+    g = np.zeros(shape, dtype=int)
+    for (r, c), color in marker_map.items():
+        g[r, c] = int(color)
+    for frame in frames:
+        for r, c in frame["border"]:
+            g[r, c] = GREY
+    return g
+
+
+def _find_marker_map(grid: np.ndarray) -> dict[tuple[int, int], int]:
+    coords = np.argwhere((grid != BG) & (grid != GREY))
+    assert coords.shape[0] == 3, "expected exactly three colored corner markers"
+    marker_map = {}
+    for r, c in coords:
+        marker_map[(int(r), int(c))] = int(grid[r, c])
+    return marker_map
+
+
+def _infer_square(marker_map: dict[tuple[int, int], int]):
+    coords = list(marker_map)
+    rows = sorted({r for r, _ in coords})
+    cols = sorted({c for _, c in coords})
+    assert len(rows) == 2 and len(cols) == 2, "markers must occupy three corners of an axis-aligned square"
+    r0, r1 = rows
+    c0, c1 = cols
+    side = r1 - r0
+    assert side == c1 - c0 and side >= 6 and side % 2 == 0, "marker square must have even side >= 6"
+    corners = {(r, c) for r in rows for c in cols}
+    assert set(coords) < corners, "markers must occupy exactly three of the four corners"
+    center = ((r0 + r1) // 2, (c0 + c1) // 2)
+    assert center[0] * 2 == r0 + r1 and center[1] * 2 == c0 + c1
+
+    corner_dirs = {
+        "NW": (r0, c0),
+        "NE": (r0, c1),
+        "SE": (r1, c1),
+        "SW": (r1, c0),
+    }
+    missing_name = next(name for name, pos in corner_dirs.items() if pos not in marker_map)
+    present_names = [name for name in corner_dirs if name != missing_name]
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "center": center,
+        "side": side,
+        "missing_dir": missing_name,
+        "present_dirs": present_names,
+        "corner_dirs": corner_dirs,
+    }
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    seen = np.zeros(g.shape, dtype=bool)
+    frames = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            if g[r, c] != GREY or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(g.shape, nr, nc) and not seen[nr, nc] and g[nr, nc] == GREY:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            h, w = r1 - r0 + 1, c1 - c0 + 1
+            assert h >= 3 and w >= 3
+            expected = _frame_from_bbox(r0, c0, h, w)
+            assert set(cells) == expected["border"], "grey component must be a single hollow rectangular frame"
+            assert np.all(g[r0 + 1 : r1, c0 + 1 : c1] == BG), "frame interior must be black"
+            frames.append(expected)
+    assert len(frames) == 3, "expected exactly three grey frames"
+    return frames
+
+
+def _trace_rays(shape: tuple[int, int], center: tuple[int, int], blockers: np.ndarray):
+    ray_by_dir: dict[str, list[tuple[int, int]]] = {}
+    obstacle_by_dir: dict[str, tuple[int, int] | None] = {}
+    for name, (dr, dc) in ALL_DIRS.items():
+        r, c = center
+        cells = []
+        while True:
+            nr = r + dr
+            nc = c + dc
+            if not _in_bounds(shape, nr, nc):
+                obstacle_by_dir[name] = None
+                break
+            if blockers[nr, nc]:
+                obstacle_by_dir[name] = (nr, nc)
+                break
+            cells.append((nr, nc))
+            r, c = nr, nc
+        ray_by_dir[name] = cells
+    return ray_by_dir, obstacle_by_dir
+
+
+def _touch_data(frames: list[dict], ray_by_dir: dict[str, list[tuple[int, int]]]):
+    ray_sets = {name: set(cells) for name, cells in ray_by_dir.items()}
+    union = set().union(*ray_sets.values()) if ray_sets else set()
+    touched = []
+    touch_dirs = []
+    diag_only_flags = []
+    for frame in frames:
+        border = frame["border"]
+        dirs = set()
+        has_diag_only = False
+        for name, cells in ray_sets.items():
+            for r, c in border:
+                if any((nr, nc) in cells for nr, nc in _neighbors4(r, c)):
+                    dirs.add(name)
+                    break
+                if any((nr, nc) in cells for nr, nc in _neighbors8(r, c)):
+                    has_diag_only = True
+            if name in dirs:
+                continue
+        touched.append(bool(dirs))
+        touch_dirs.append(dirs)
+        diag_only_flags.append(has_diag_only and not bool(dirs))
+    return {
+        "ray_union": union,
+        "touched": touched,
+        "touch_dirs": touch_dirs,
+        "diag_only": diag_only_flags,
+    }
+
+
+def _oracle_output(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    marker_map = _find_marker_map(g)
+    sq = _infer_square(marker_map)
+    frames = _find_frames(g)
+
+    center = sq["center"]
+    blockers = g != BG
+    ray_by_dir, obstacle_by_dir = _trace_rays(g.shape, center, blockers)
+    touch = _touch_data(frames, ray_by_dir)
+
+    out = g.copy()
+    out[center] = RED
+    for cells in ray_by_dir.values():
+        for r, c in cells:
+            out[r, c] = RED
+    for frame, is_touched in zip(frames, touch["touched"]):
+        if not is_touched:
+            continue
+        r0, c0, r1, c1 = frame["bbox"]
+        out[r0 + 1 : r1, c0 + 1 : c1] = YELLOW
+    return out, {
+        "marker_map": marker_map,
+        "square": sq,
+        "frames": frames,
+        "ray_by_dir": ray_by_dir,
+        "obstacle_by_dir": obstacle_by_dir,
+        "touch": touch,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Infer a square center from three corner markers, emit red rays from that center, and fill only the touched grey frames.
+
+    Input structure:
+    - Black background contains exactly three colored singleton markers and exactly three grey hollow rectangular frames.
+    - The three markers occupy three corners of one axis-aligned square with even side length, leaving one corner missing.
+    - Frames are single-pixel-thick grey outlines with black interiors and do not overlap the marker square region.
+
+    Rule:
+    - Infer the missing square corner and the square center from the three marker coordinates.
+    - Paint the center red, then emit red rays from that center in all eight compass directions.
+    - Each ray advances cell by cell and stops before the next occupied input cell or before leaving the grid.
+    - After all rays are drawn, inspect each grey frame: if any outline pixel is 4-neighbor adjacent to any ray pixel, fill only that frame's interior with yellow.
+    - Keep the original markers and grey outlines unchanged.
+
+    Key insight:
+    - The markers do not name the center directly; the center must be reconstructed from square geometry, and the final fill depends on 4-neighbor contact with obstacle-limited rays rather than on simple alignment.
+    """
+    out, _ = _oracle_output(np.asarray(grid, dtype=int))
+    return out
+
+
+def _line_steps(center: tuple[int, int], shape: tuple[int, int], dir_name: str) -> list[tuple[int, int]]:
+    dr, dc = ALL_DIRS[dir_name]
+    r, c = center
+    steps = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return steps
+        steps.append((r, c))
+
+
+def _frame_valid(frame: dict, shape: tuple[int, int], square_bbox: tuple[int, int, int, int], placed: list[dict]) -> bool:
+    r0, c0, r1, c1 = frame["bbox"]
+    if not (0 <= r0 and 0 <= c0 and r1 < shape[0] and c1 < shape[1]):
+        return False
+    if not _box_separated(frame["bbox"], square_bbox, gap=1):
+        return False
+    return all(_box_separated(frame["bbox"], other["bbox"], gap=1) for other in placed)
+
+
+def _border_line_steps(frame: dict, center: tuple[int, int], dir_name: str) -> list[int]:
+    dr, dc = ALL_DIRS[dir_name]
+    out = []
+    for r, c in frame["border"]:
+        rr = r - center[0]
+        cc = c - center[1]
+        if dr == 0:
+            if rr == 0 and cc * dc > 0:
+                out.append(abs(cc))
+        elif dc == 0:
+            if cc == 0 and rr * dr > 0:
+                out.append(abs(rr))
+        else:
+            if rr == cc * dr * dc and rr * dr > 0 and abs(rr) == abs(cc):
+                out.append(abs(rr))
+    return sorted(set(out))
+
+
+def _analyze_layout(shape: tuple[int, int], marker_map: dict[tuple[int, int], int], frames: list[dict]) -> dict:
+    grid = _render_input(shape, marker_map, frames)
+    sq = _infer_square(marker_map)
+    center = sq["center"]
+    blockers = grid != BG
+    ray_by_dir, obstacle_by_dir = _trace_rays(shape, center, blockers)
+    touch = _touch_data(frames, ray_by_dir)
+    label = np.zeros(shape, dtype=int)
+    for pos in marker_map:
+        label[pos] = -1
+    for idx, frame in enumerate(frames, start=1):
+        for r, c in frame["border"]:
+            label[r, c] = idx
+    first_blocker_label = {}
+    for name, obstacle in obstacle_by_dir.items():
+        if obstacle is None:
+            first_blocker_label[name] = 0
+        else:
+            first_blocker_label[name] = int(label[obstacle])
+    return {
+        "grid": grid,
+        "info": {
+            "square": sq,
+            "frames": frames,
+            "ray_by_dir": ray_by_dir,
+            "obstacle_by_dir": obstacle_by_dir,
+            "touch": touch,
+        },
+        "first_blocker_label": first_blocker_label,
+    }
+
+
+def _random_frame_sizes(rng: np.random.Generator) -> tuple[int, int]:
+    return int(rng.integers(FRAME_MIN, FRAME_MAX + 1)), int(rng.integers(FRAME_MIN, FRAME_MAX + 1))
+
+
+def _try_cardinal_blocker(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    half: int,
+    square_bbox: tuple[int, int, int, int],
+    marker_map: dict[tuple[int, int], int],
+    placed: list[dict],
+    dir_name: str,
+):
+    cr, cc = center
+    for _ in range(120):
+        h, w = _random_frame_sizes(rng)
+        if dir_name == "N":
+            max_dist = cr - h + 1
+            if max_dist < half + 2:
+                continue
+            dist = int(rng.integers(half + 2, max_dist + 1))
+            r0 = cr - dist - h + 1
+            c0_lo = max(0, cc - w + 1)
+            c0_hi = min(cc, shape[1] - w)
+            if c0_lo > c0_hi:
+                continue
+            c0 = int(rng.integers(c0_lo, c0_hi + 1))
+        elif dir_name == "S":
+            max_dist = shape[0] - 1 - cr - h + 1
+            if max_dist < half + 2:
+                continue
+            dist = int(rng.integers(half + 2, max_dist + 1))
+            r0 = cr + dist
+            c0_lo = max(0, cc - w + 1)
+            c0_hi = min(cc, shape[1] - w)
+            if c0_lo > c0_hi:
+                continue
+            c0 = int(rng.integers(c0_lo, c0_hi + 1))
+        elif dir_name == "W":
+            max_dist = cc - w + 1
+            if max_dist < half + 2:
+                continue
+            dist = int(rng.integers(half + 2, max_dist + 1))
+            c0 = cc - dist - w + 1
+            r0_lo = max(0, cr - h + 1)
+            r0_hi = min(cr, shape[0] - h)
+            if r0_lo > r0_hi:
+                continue
+            r0 = int(rng.integers(r0_lo, r0_hi + 1))
+        else:
+            max_dist = shape[1] - 1 - cc - w + 1
+            if max_dist < half + 2:
+                continue
+            dist = int(rng.integers(half + 2, max_dist + 1))
+            c0 = cc + dist
+            r0_lo = max(0, cr - h + 1)
+            r0_hi = min(cr, shape[0] - h)
+            if r0_lo > r0_hi:
+                continue
+            r0 = int(rng.integers(r0_lo, r0_hi + 1))
+
+        frame = _frame_from_bbox(r0, c0, h, w)
+        if not _frame_valid(frame, shape, square_bbox, placed):
+            continue
+        analysis = _analyze_layout(shape, marker_map, placed + [frame])
+        idx = len(placed)
+        if analysis["info"]["touch"]["touched"][idx] and analysis["first_blocker_label"][dir_name] == idx + 1:
+            return frame
+    return None
+
+
+def _try_same_ray_occluded(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    square_bbox: tuple[int, int, int, int],
+    marker_map: dict[tuple[int, int], int],
+    placed: list[dict],
+    dir_name: str,
+    blocker_frame: dict,
+):
+    blocker_steps = _border_line_steps(blocker_frame, center, dir_name)
+    if not blocker_steps:
+        return None
+    min_blocker = min(blocker_steps)
+    cr, cc = center
+    for _ in range(140):
+        h, w = _random_frame_sizes(rng)
+        if dir_name == "N":
+            max_dist = cr - h + 1
+            if max_dist <= min_blocker + 1:
+                continue
+            dist = int(rng.integers(min_blocker + 2, max_dist + 1))
+            r0 = cr - dist - h + 1
+            c0_lo = max(0, cc - w + 1)
+            c0_hi = min(cc, shape[1] - w)
+            if c0_lo > c0_hi:
+                continue
+            c0 = int(rng.integers(c0_lo, c0_hi + 1))
+        elif dir_name == "S":
+            max_dist = shape[0] - 1 - cr - h + 1
+            if max_dist <= min_blocker + 1:
+                continue
+            dist = int(rng.integers(min_blocker + 2, max_dist + 1))
+            r0 = cr + dist
+            c0_lo = max(0, cc - w + 1)
+            c0_hi = min(cc, shape[1] - w)
+            if c0_lo > c0_hi:
+                continue
+            c0 = int(rng.integers(c0_lo, c0_hi + 1))
+        elif dir_name == "W":
+            max_dist = cc - w + 1
+            if max_dist <= min_blocker + 1:
+                continue
+            dist = int(rng.integers(min_blocker + 2, max_dist + 1))
+            c0 = cc - dist - w + 1
+            r0_lo = max(0, cr - h + 1)
+            r0_hi = min(cr, shape[0] - h)
+            if r0_lo > r0_hi:
+                continue
+            r0 = int(rng.integers(r0_lo, r0_hi + 1))
+        else:
+            max_dist = shape[1] - 1 - cc - w + 1
+            if max_dist <= min_blocker + 1:
+                continue
+            dist = int(rng.integers(min_blocker + 2, max_dist + 1))
+            c0 = cc + dist
+            r0_lo = max(0, cr - h + 1)
+            r0_hi = min(cr, shape[0] - h)
+            if r0_lo > r0_hi:
+                continue
+            r0 = int(rng.integers(r0_lo, r0_hi + 1))
+
+        frame = _frame_from_bbox(r0, c0, h, w)
+        if not _frame_valid(frame, shape, square_bbox, placed):
+            continue
+        analysis = _analyze_layout(shape, marker_map, placed + [frame])
+        idx = len(placed)
+        steps = _border_line_steps(frame, center, dir_name)
+        if steps and min(steps) > min_blocker and not analysis["info"]["touch"]["touched"][idx]:
+            return frame
+    return None
+
+
+def _try_marker_occluded(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    half: int,
+    square_bbox: tuple[int, int, int, int],
+    marker_map: dict[tuple[int, int], int],
+    placed: list[dict],
+    dir_name: str,
+):
+    dr, dc = ALL_DIRS[dir_name]
+    steps = _line_steps(center, shape, dir_name)
+    start = half + 2
+    if start >= len(steps):
+        return None
+    for _ in range(140):
+        h, w = _random_frame_sizes(rng)
+        k = int(rng.integers(start, len(steps)))
+        pr, pc = steps[k]
+        if dir_name == "NE":
+            r0, c0 = pr - h + 1, pc
+        elif dir_name == "NW":
+            r0, c0 = pr - h + 1, pc - w + 1
+        elif dir_name == "SE":
+            r0, c0 = pr, pc
+        else:
+            r0, c0 = pr, pc - w + 1
+        frame = _frame_from_bbox(r0, c0, h, w)
+        if not _frame_valid(frame, shape, square_bbox, placed):
+            continue
+        analysis = _analyze_layout(shape, marker_map, placed + [frame])
+        idx = len(placed)
+        if not analysis["info"]["touch"]["touched"][idx] and _border_line_steps(frame, center, dir_name):
+            return frame
+    return None
+
+
+def _try_missing_diagonal_touch(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    half: int,
+    square_bbox: tuple[int, int, int, int],
+    marker_map: dict[tuple[int, int], int],
+    placed: list[dict],
+    dir_name: str,
+):
+    dr, dc = ALL_DIRS[dir_name]
+    steps = _line_steps(center, shape, dir_name)
+    start = half + 2
+    if start >= len(steps):
+        return None
+    for _ in range(180):
+        h, w = _random_frame_sizes(rng)
+        k = int(rng.integers(start, len(steps)))
+        pr, pc = steps[k]
+        if rng.random() < 0.5:
+            if dr == 1:
+                r0 = pr - h + 1
+            else:
+                r0 = pr
+            if dc == 1:
+                c0 = pc + 1
+            else:
+                c0 = pc - w
+        else:
+            if dr == 1:
+                r0 = pr + 1
+            else:
+                r0 = pr - h
+            if dc == 1:
+                c0 = pc - w + 1
+            else:
+                c0 = pc
+        frame = _frame_from_bbox(r0, c0, h, w)
+        if not _frame_valid(frame, shape, square_bbox, placed):
+            continue
+        analysis = _analyze_layout(shape, marker_map, placed + [frame])
+        idx = len(placed)
+        touched = analysis["info"]["touch"]["touched"][idx]
+        touch_dirs = analysis["info"]["touch"]["touch_dirs"][idx]
+        if touched and dir_name in touch_dirs and not _border_line_steps(frame, center, dir_name):
+            return frame
+    return None
+
+
+def _try_diagonal_false(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    half: int,
+    square_bbox: tuple[int, int, int, int],
+    marker_map: dict[tuple[int, int], int],
+    placed: list[dict],
+):
+    choices = ["N", "E", "S", "W"]
+    for _ in range(220):
+        dir_name = random.choice(choices)
+        steps = _line_steps(center, shape, dir_name)
+        if half + 2 >= len(steps):
+            continue
+        pr, pc = steps[int(rng.integers(half + 2, len(steps)))]
+        h, w = _random_frame_sizes(rng)
+        if dir_name == "E":
+            if rng.random() < 0.5:
+                r0, c0 = pr + 1, pc + 1
+            else:
+                r0, c0 = pr - h, pc + 1
+        elif dir_name == "W":
+            if rng.random() < 0.5:
+                r0, c0 = pr + 1, pc - w
+            else:
+                r0, c0 = pr - h, pc - w
+        elif dir_name == "S":
+            if rng.random() < 0.5:
+                r0, c0 = pr + 1, pc + 1
+            else:
+                r0, c0 = pr + 1, pc - w
+        else:
+            if rng.random() < 0.5:
+                r0, c0 = pr - h, pc + 1
+            else:
+                r0, c0 = pr - h, pc - w
+        frame = _frame_from_bbox(r0, c0, h, w)
+        if not _frame_valid(frame, shape, square_bbox, placed):
+            continue
+        analysis = _analyze_layout(shape, marker_map, placed + [frame])
+        idx = len(placed)
+        if analysis["info"]["touch"]["diag_only"][idx]:
+            return frame
+    return None
+
+
+def _try_far_untouched(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    square_bbox: tuple[int, int, int, int],
+    marker_map: dict[tuple[int, int], int],
+    placed: list[dict],
+):
+    for _ in range(250):
+        h, w = _random_frame_sizes(rng)
+        r0 = int(rng.integers(0, shape[0] - h + 1))
+        c0 = int(rng.integers(0, shape[1] - w + 1))
+        frame = _frame_from_bbox(r0, c0, h, w)
+        if not _frame_valid(frame, shape, square_bbox, placed):
+            continue
+        analysis = _analyze_layout(shape, marker_map, placed + [frame])
+        idx = len(placed)
+        if not analysis["info"]["touch"]["touched"][idx] and not analysis["info"]["touch"]["diag_only"][idx]:
+            return frame
+    return None
+
+
+def _sample_layout(rng: np.random.Generator):
+    h = int(rng.integers(20, 30))
+    w = int(rng.integers(20, 30))
+    cr = int(rng.integers(8, h - 8))
+    cc = int(rng.integers(8, w - 8))
+    max_half = min(cr, cc, h - 1 - cr, w - 1 - cc, 5)
+    if max_half < 3:
+        return None
+    half = int(rng.choice(np.arange(3, max_half + 1)))
+    side = half * 2
+    corners = {
+        "NW": (cr - half, cc - half),
+        "NE": (cr - half, cc + half),
+        "SE": (cr + half, cc + half),
+        "SW": (cr + half, cc - half),
+    }
+    missing_dir = random.choice(list(corners))
+    colors = rng.permutation(np.array([BLUE, GREEN, YELLOW], dtype=int))
+    marker_map = {}
+    i = 0
+    for name in ("NW", "NE", "SE", "SW"):
+        if name == missing_dir:
+            continue
+        marker_map[corners[name]] = int(colors[i])
+        i += 1
+    return {
+        "shape": (h, w),
+        "center": (cr, cc),
+        "half": half,
+        "side": side,
+        "corners": corners,
+        "missing_dir": missing_dir,
+        "marker_map": marker_map,
+        "square_bbox": (cr - half, cc - half, cr + half, cc + half),
+    }
+
+
+def _build_case(rng: np.random.Generator):
+    layout = _sample_layout(rng)
+    if layout is None:
+        return None
+    shape = layout["shape"]
+    center = layout["center"]
+    half = layout["half"]
+    marker_map = layout["marker_map"]
+    square_bbox = layout["square_bbox"]
+    present_dirs = [name for name in DIAGONAL_DIRS if name != layout["missing_dir"]]
+    missing_dir = layout["missing_dir"]
+
+    scenario = random.choice(
+        [
+            "cardinal_chain_markertrap",
+            "diag_touch_chain",
+            "cardinal_diagfalse_markertrap",
+            "diag_touch_far_cardinal",
+        ]
+    )
+    frames: list[dict] = []
+    meta: dict = {"scenario": scenario}
+
+    if scenario == "cardinal_chain_markertrap":
+        blocker_dir = random.choice(list(CARDINAL_DIRS))
+        f0 = _try_cardinal_blocker(rng, shape, center, half, square_bbox, marker_map, frames, blocker_dir)
+        if f0 is None:
+            return None
+        frames.append(f0)
+        f1 = _try_same_ray_occluded(rng, shape, center, square_bbox, marker_map, frames, blocker_dir, f0)
+        if f1 is None:
+            return None
+        frames.append(f1)
+        trap_dir = random.choice(present_dirs)
+        f2 = _try_marker_occluded(rng, shape, center, half, square_bbox, marker_map, frames, trap_dir)
+        if f2 is None:
+            return None
+        frames.append(f2)
+        meta.update({"blocker_dir": blocker_dir, "trap_dir": trap_dir})
+
+    elif scenario == "diag_touch_chain":
+        f0 = _try_missing_diagonal_touch(rng, shape, center, half, square_bbox, marker_map, frames, missing_dir)
+        if f0 is None:
+            return None
+        frames.append(f0)
+        blocker_dir = random.choice(list(CARDINAL_DIRS))
+        f1 = _try_cardinal_blocker(rng, shape, center, half, square_bbox, marker_map, frames, blocker_dir)
+        if f1 is None:
+            return None
+        frames.append(f1)
+        f2 = _try_same_ray_occluded(rng, shape, center, square_bbox, marker_map, frames, blocker_dir, f1)
+        if f2 is None:
+            return None
+        frames.append(f2)
+        meta.update({"blocker_dir": blocker_dir})
+
+    elif scenario == "cardinal_diagfalse_markertrap":
+        blocker_dir = random.choice(list(CARDINAL_DIRS))
+        f0 = _try_cardinal_blocker(rng, shape, center, half, square_bbox, marker_map, frames, blocker_dir)
+        if f0 is None:
+            return None
+        frames.append(f0)
+        f1 = _try_diagonal_false(rng, shape, center, half, square_bbox, marker_map, frames)
+        if f1 is None:
+            return None
+        frames.append(f1)
+        trap_dir = random.choice(present_dirs)
+        f2 = _try_marker_occluded(rng, shape, center, half, square_bbox, marker_map, frames, trap_dir)
+        if f2 is None:
+            return None
+        frames.append(f2)
+        meta.update({"blocker_dir": blocker_dir, "trap_dir": trap_dir})
+
+    else:
+        f0 = _try_missing_diagonal_touch(rng, shape, center, half, square_bbox, marker_map, frames, missing_dir)
+        if f0 is None:
+            return None
+        frames.append(f0)
+        f1 = _try_far_untouched(rng, shape, center, square_bbox, marker_map, frames)
+        if f1 is None:
+            return None
+        frames.append(f1)
+        blocker_dir = random.choice(list(CARDINAL_DIRS))
+        f2 = _try_cardinal_blocker(rng, shape, center, half, square_bbox, marker_map, frames, blocker_dir)
+        if f2 is None:
+            return None
+        frames.append(f2)
+        meta.update({"blocker_dir": blocker_dir})
+
+    grid = _render_input(shape, marker_map, frames)
+    return grid, meta
+
+
+def _validate_case(grid: np.ndarray, meta: dict) -> bool:
+    try:
+        oracle, info = _oracle_output(grid)
+    except Exception:
+        return False
+    if not np.array_equal(main(grid), oracle):
+        return False
+
+    sq = info["square"]
+    touch = info["touch"]
+    touched_count = sum(touch["touched"])
+    untouched_count = len(touch["touched"]) - touched_count
+    if touched_count < 1 or untouched_count < 1:
+        return False
+    if not np.any(oracle == RED) or not np.any(oracle == YELLOW):
+        return False
+
+    scenario = meta["scenario"]
+    if scenario == "cardinal_chain_markertrap":
+        if touched_count != 1:
+            return False
+        blocker_dir = meta["blocker_dir"]
+        trap_dir = meta["trap_dir"]
+        frames = info["frames"]
+        if blocker_dir not in touch["touch_dirs"][0]:
+            return False
+        if touch["touched"][1]:
+            return False
+        if touch["touched"][2]:
+            return False
+        if not _border_line_steps(frames[1], sq["center"], blocker_dir):
+            return False
+        if not _border_line_steps(frames[2], sq["center"], trap_dir):
+            return False
+
+    elif scenario == "diag_touch_chain":
+        if touched_count != 2:
+            return False
+        if sq["missing_dir"] not in touch["touch_dirs"][0]:
+            return False
+        if touch["touched"][2]:
+            return False
+
+    elif scenario == "cardinal_diagfalse_markertrap":
+        if touched_count != 1:
+            return False
+        if not info["touch"]["diag_only"][1]:
+            return False
+        if touch["touched"][1] or touch["touched"][2]:
+            return False
+
+    elif scenario == "diag_touch_far_cardinal":
+        if touched_count != 2:
+            return False
+        if sq["missing_dir"] not in touch["touch_dirs"][0]:
+            return False
+        if touch["touched"][1]:
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRIES):
+        built = _build_case(rng)
+        if built is None:
+            continue
+        grid, meta = built
+        if _validate_case(grid, meta):
+            return grid
+    raise RuntimeError("failed to generate a valid input")

