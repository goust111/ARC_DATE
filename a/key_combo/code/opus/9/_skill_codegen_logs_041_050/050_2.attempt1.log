        origin_r, origin_c = inst["origin"]
        scale = inst["scale"]
        for rel_r, rel_c in marker_rel:
            group_ids.append(len(records))
            records.append((scale, origin_r + rel_r * scale, origin_c + rel_c * scale, gi))
        expected.add(frozenset(group_ids))

