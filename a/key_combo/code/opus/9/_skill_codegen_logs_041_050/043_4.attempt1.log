spec:
  grid: 6-10 rows x 9 cols [observed]
  background:
    colors: BLACK(0) and PINK(6) only, roughly balanced random fill
  yellow_markers:
    count: 1-3 pairs on exactly one axis (row OR column)
    row_axis: YELLOW at (r,0) and (r,w-1) for each selected row
    col_axis: YELLOW at (0,c) and (h-1,c) for each selected column
    position: never on first/last index of the marker axis; min spacing >=2
    no_other_yellow: all YELLOW pixels are paired markers, none elsewhere
  segment_interior:
    cells: strict interior between marker pair (excluding the YELLOW endpoints)
    input_colors: each cell is BLACK(0) or PINK(6), same palette as background
    note: one example (train_0) uses ORANGE(7)/TEAL(8) instead, which is the pre-toggled state
  transform:
    toggle: BLACK(0)<->TEAL(8) and PINK(6)<->ORANGE(7) on segment interiors
    unchanged: YELLOW markers and all non-segment cells

generation_strategy:
  approach: direct construction (input is the constrained object, output derived by toggle)
  steps:
    1. Pick grid dims h in [6,10], w=9 (or vary w in [6,12] for diversity).
    2. Choose axis (row or col) and pick 1-3 marker indices, not on first/last index, min spacing >=2.
    3. Fill entire grid with random BLACK/PINK.
    4. Place YELLOW markers at the two opposite-edge endpoints of each selected row/col.
    5. Optionally (with low probability) replace segment interior cells with ORANGE/TEAL instead of BLACK/PINK to represent the pre-toggled variant.
    6. Build output by toggling segment interior cells (0<->8, 6<->7); copy everything else.
