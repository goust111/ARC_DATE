+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+INTERIOR_COLORS = (2, 3, 4, 5, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+SIDE_DELTAS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
