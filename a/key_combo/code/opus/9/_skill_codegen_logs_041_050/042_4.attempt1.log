+        grid[r0, c0 : c1 + 1] = BLUE
+        grid[r1, c0 : c1 + 1] = BLUE
+        grid[r0 : r1 + 1, c0] = BLUE
+        grid[r0 : r1 + 1, c1] = BLUE
+        gr, gc = spec["gap"]
+        grid[gr, gc] = BLACK
+        for r, c in spec["visible"]:
+            grid[r, c] = spec["color"]
+    return grid
+
+
+def _expected_output(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    for spec in specs:
