spec:
  grid: 28x28 (fixed)
  outer_frame:
    region: rows 0-1 and cols 0-1 (2-pixel L-shaped border)
    color: 1 [observed, always blue]
  inner_frame:
    region: row 2 (cols>=2) and col 2 (rows>=2), single-pixel border
    color: 4 [observed, always yellow]
  main_field:
    region: rows 3-27, cols 3-27 (25x25)
    anti_diagonal_rule: every cell (r,c) gets color f(r+c); sums range 6-54
    preamble: sums 6,7,8 always map to colors 3,2,1 [observed]
    periodic_from_sum_9: colors repeat with period K=4-9 and constant step +2 (mod wrap)
    palette: K distinct colors forming an arithmetic sequence with step 1 or 2, values in 1-9
    exceptional_cell: (4,4) may have a different color than its anti-diagonal; never masked
  mask:
    color: 0 (black), replaces some cells in input; output restores them
    count: 82-126 pixels (10-16% of grid)
    connected_regions: 2-3 blobs, each roughly rectangular (fill ratio >=0.64)
    region_sizes: 3x4 to 12x9 bounding boxes
    some_span_frames: 0-2 regions may overlap outer/inner frame areas
    constraint: every anti-diagonal (sums 6-54) retains >=1 visible non-(4,4) cell
    constraint: outer and inner frames each retain >=1 visible cell

generation_strategy:
  approach: output-first
  steps:
    1. Choose K in 4-9; build palette as K values from 1-9 with arithmetic step 1 or 2
    2. Build periodic color sequence for anti-diag sums 9-54 by cycling palette with +2 step
    3. Set preamble sums 6,7,8 = colors 3,2,1; fill 25x25 main field via f(r+c)
    4. Set cell (4,4) to a color different from f(8), chosen from palette
    5. Fill outer frame with color 1, inner frame with color 4 to complete the 28x28 output
    6. Place 2-3 rectangular mask blobs (randomize positions/sizes within observed ranges)
    7. Ensure no blob fully covers any anti-diagonal, cell (4,4), or all of outer/inner frame
    8. Zero out masked cells in the output to produce the input
