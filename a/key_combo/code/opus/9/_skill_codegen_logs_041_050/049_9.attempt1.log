0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Replace the outlined object with the outside contour of that outline in the marker color.
0020: 
0021:     Input structure:
0022:     - A dominant background surrounds one 8-connected foreground outline.
0023:     - The outline is the unique largest foreground color.
0024:     - One or more smaller interior colors are inside the outline; the marker color
0025:       is the unique smallest non-outline color.
0026: 
0027:     Rule:
0028:     - Erase all original foreground pixels to background.
0029:     - Paint every background pixel that is 4-adjacent to the outline with the
0030:       marker color.
0031:     - Keep the grid shape unchanged.
0032: 
0033:     Key insight: The colored interior marker supplies the paint color, while the
0034:     largest outline supplies only the contour whose outside edge is traced.
0035:     """
0036:     g = np.asarray(grid, dtype=int)
0037:     bg = int(get_bg(g))
0038: 
0039:     counts = Counter(map(int, g.flatten()))
0040:     foreground_colors = [color for color in counts if color != bg]
0041:     assert len(foreground_colors) >= 2, "expected an outline color and a marker color"
0042: 
0043:     frame_count = max(counts[color] for color in foreground_colors)
0044:     frame_color = _unique_color_with_count(counts, foreground_colors, frame_count)
0045:     assert len(components_mask(g == frame_color, connectivity=8)) == 1, "outline must be 8-connected"
0046: 
0047:     marker_candidates = [color for color in foreground_colors if color != frame_color]
0048:     marker_count = min(counts[color] for color in marker_candidates)
0049:     marker_color = _unique_color_with_count(counts, marker_candidates, marker_count)
0050: 
0051:     out = np.full_like(g, bg)
0052:     contour: set[tuple[int, int]] = set()
0053:     for r, c in np.argwhere(g == frame_color):
0054:         for nr, nc in neighbors4(int(r), int(c)):
0055:             if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:
0056:                 contour.add((int(nr), int(nc)))
0057:     assert contour, "expected outline to touch background contour cells"
0058: 
0059:     for r, c in contour:
0060:         out[r, c] = marker_color
0061:     return out
