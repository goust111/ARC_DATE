0138: 
0139: # CFG: palette and canvas bounds.
0140: _COLORS = tuple(range(10))
0141: _BG_COLOR_RANGE = (1, 8)
0142: _GRID_HEIGHT_RANGE = (10, 22)
0143: _GRID_WIDTH_RANGE = (8, 22)
0144: 
0145: # CFG: placement isolation and anchor location.
0146: _NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
0147: _INNER_BORDER_GAP = 1
0148: _ANCHOR_EDGE_MARGIN = 2
0149: _ISOLATION_RADIUS = 1
0150: 
0151: # CFG: anchor, sprite, and retry counts.
0152: _ANCHOR_COUNT_RANGE = (1, 3)
