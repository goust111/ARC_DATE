+        dc = 1 if c0 == 0 else -1
+        for step in range(1, min(3, h - 1, w - 1)):
+            mask[r0 + dr * step, c0] = False
+            mask[r0, c0 + dc * step] = False
+        mask[r0, c0] = False
+    elif pattern == "double_corner":
+        pairs = [((0, 0), (h - 1, w - 1)), ((0, w - 1), (h - 1, 0))]
+        for r0, c0 in rng.choice(pairs):
+            dr = 1 if r0 == 0 else -1
+            dc = 1 if c0 == 0 else -1
+            mask[r0, c0] = False
+            mask[r0 + dr, c0] = False
+            mask[r0, c0 + dc] = False
+    elif pattern == "side_dent":
+        if rng.random() < 0.5:
+            row = rng.randrange(1, h - 1)
+            side = rng.choice([0, w - 1])
+            dc = 1 if side == 0 else -1
+            span = 2 if w >= 7 else 1
+            for off in range(span):
