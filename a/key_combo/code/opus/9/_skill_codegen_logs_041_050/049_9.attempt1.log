index 0000000000000000000000000000000000000000..7cbb7cb2f25738ae18266a3352374a8c22edd465
--- /dev/null
+++ b/a/key_combo/code/opus/9/049/9.py
@@ -0,0 +1,455 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _component_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[Coord] = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _color_components(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    return _component_from_mask(grid == int(color))
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _touches_boundary(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 0] == h - 1)
+        or np.any(coords[:, 1] == 0)
+        or np.any(coords[:, 1] == w - 1)
+    )
+
+
+def _adjacent_color_counts(grid: np.ndarray, coords: np.ndarray) -> Counter:
+    h, w = grid.shape
+    ctr: Counter = Counter()
+    for r, c in coords:
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w:
+                val = int(grid[nr, nc])
+                if val != 0:
+                    ctr[val] += 1
+    return ctr
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
+
+
+def _extract_structure(grid: np.ndarray) -> tuple[np.ndarray, int, list[tuple[int, int]]]:
+    holes = []
+    for comp in _component_from_mask(grid == 0):
+        if _touches_boundary(comp, grid.shape):
+            continue
+        adj = _adjacent_color_counts(grid, comp)
+        if not adj:
+            continue
+        border_color, border_support = max(adj.items(), key=lambda kv: (int(kv[1]), int(kv[0])))
+        holes.append((int(comp.shape[0]), int(border_support), comp, int(border_color)))
+    assert holes, "expected one enclosed black cavity"
+
+    holes.sort(key=lambda item: (item[0], item[1]), reverse=True)
+    cavity = holes[0][2]
+    border_color = holes[0][3]
+    cavity_set = {tuple(map(int, rc)) for rc in cavity}
+
+    border_comp = None
+    for comp in _color_components(grid, border_color):
+        if any(
+            (nr, nc) in cavity_set
+            for r, c in comp
+            for nr, nc in _neighbors4(int(r), int(c))
+        ):
+            border_comp = comp
+            break
+    assert border_comp is not None, "failed to recover enclosing border"
+
+    border_cells = {tuple(map(int, rc)) for rc in border_comp}
+    objects: list[tuple[int, int]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != 0):
+        for comp in _color_components(grid, color):
+            comp_cells = {tuple(map(int, rc)) for rc in comp}
+            if comp_cells == border_cells:
+                continue
+            objects.append((int(comp.shape[0]), int(color)))
+    assert 2 <= len(objects) <= 4, "expected 2-4 outer objects"
+
+    areas = [area for area, _color in objects]
+    assert len(areas) == len(set(areas)), "outer object areas must be distinct"
+    ordered = sorted(objects, key=lambda item: item[0], reverse=True)
+    return cavity, border_color, ordered
+
+
+def _apply_ring_fill(grid: np.ndarray, cavity: np.ndarray, ordered: list[tuple[int, int]]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    n = len(ordered)
+    colors = [color for _area, color in ordered]
+    r0, c0, r1, c1 = _bbox(cavity)
+    cr = (r0 + r1) // 2
+    cc = (c0 + c1) // 2
+    for r, c in cavity:
+        dist = max(abs(int(r) - cr), abs(int(c) - cc))
+        if dist < n:
+            out[int(r), int(c)] = colors[n - 1 - dist]
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill the hollow sprite's cavity with area-coded concentric square rings clipped to the cavity shape.
+
+    Input structure:
+    - Black `0` is the background.
+    - One large monochrome hollow sprite encloses a single black cavity that does not touch the grid boundary.
+    - Outside that sprite sit 2-4 monochrome 4-connected objects of distinct colors and distinct pixel counts.
+
+    Rule:
+    - Locate the enclosed black cavity and recover the surrounding sprite border color from the cavity's adjacent cells.
+    - Collect every other non-black monochrome component outside the border and sort them by decreasing area.
+    - Use the cavity bbox center as the center of a concentric odd-sized square-ring pattern: largest-area object gives the outer ring, next gives the next ring, and the smallest gives the center.
+    - Paint only cavity cells whose Chebyshev distance from that center lies on one of those rings; cavity cells outside the outermost square stay black, and all non-cavity pixels stay unchanged.
+
+    Key insight:
+    - The cavity shape supplies the clipping mask, while the external objects supply only the outside-to-inside color order through their areas.
+    """
+    g = np.asarray(grid, dtype=int)
+    cavity, _border_color, ordered = _extract_structure(g)
+    return _apply_ring_fill(g, cavity, ordered)
+
+
+def _random_blob(area: int, rng: random.Random) -> np.ndarray:
+    cells = {(0, 0)}
+    frontier = [(0, 0)]
+    while len(cells) < area:
+        br, bc = rng.choice(frontier)
+        neigh = [(br + dr, bc + dc) for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1))]
+        rng.shuffle(neigh)
+        placed = False
+        for nr, nc in neigh:
+            if (nr, nc) not in cells:
+                cells.add((nr, nc))
+                frontier.append((nr, nc))
+                placed = True
+                break
+        if not placed:
+            frontier = list(cells)
+
+    pts = np.array(sorted(cells), dtype=int)
+    pts[:, 0] -= pts[:, 0].min()
+    pts[:, 1] -= pts[:, 1].min()
+
+    for _ in range(rng.randrange(4)):
+        pts = np.stack([pts[:, 1], -pts[:, 0]], axis=1)
+        pts[:, 0] -= pts[:, 0].min()
+        pts[:, 1] -= pts[:, 1].min()
+    if rng.random() < 0.5:
+        pts[:, 0] = pts[:, 0].max() - pts[:, 0]
+    if rng.random() < 0.5:
+        pts[:, 1] = pts[:, 1].max() - pts[:, 1]
+    pts[:, 0] -= pts[:, 0].min()
+    pts[:, 1] -= pts[:, 1].min()
+    return pts
+
+
+def _rect_with_bites(h: int, w: int, rng: random.Random) -> np.ndarray:
+    mask = np.ones((h, w), dtype=bool)
+    pattern = rng.choice(["rect", "corner", "double_corner", "side_dent"])
+    if h * w <= 25:
+        pattern = rng.choice(["corner", "side_dent"])
+
+    if pattern == "corner":
+        corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
+        r0, c0 = rng.choice(corners)
+        dr = 1 if r0 == 0 else -1
+        dc = 1 if c0 == 0 else -1
+        for step in range(1, min(3, h - 1, w - 1)):
+            mask[r0 + dr * step, c0] = False
+            mask[r0, c0 + dc * step] = False
+        mask[r0, c0] = False
+    elif pattern == "double_corner":
+        pairs = [((0, 0), (h - 1, w - 1)), ((0, w - 1), (h - 1, 0))]
+        for r0, c0 in rng.choice(pairs):
+            dr = 1 if r0 == 0 else -1
+            dc = 1 if c0 == 0 else -1
+            mask[r0, c0] = False
+            mask[r0 + dr, c0] = False
+            mask[r0, c0 + dc] = False
+    elif pattern == "side_dent":
+        if rng.random() < 0.5:
+            row = rng.randrange(1, h - 1)
+            side = rng.choice([0, w - 1])
+            dc = 1 if side == 0 else -1
+            span = 2 if w >= 7 else 1
+            for off in range(span):
+                mask[row, side + dc * off] = False
+                if 1 <= row + 1 < h - 1 and rng.random() < 0.5:
+                    mask[row + 1, side + dc * off] = False
+        else:
+            col = rng.randrange(1, w - 1)
+            side = rng.choice([0, h - 1])
+            dr = 1 if side == 0 else -1
+            span = 2 if h >= 7 else 1
+            for off in range(span):
+                mask[side + dr * off, col] = False
+                if 1 <= col + 1 < w - 1 and rng.random() < 0.5:
+                    mask[side + dr * off, col + 1] = False
+    return mask
+
+
+def _transform_mask(mask: np.ndarray, rng: random.Random) -> np.ndarray:
+    out = mask.copy()
+    for _ in range(rng.randrange(4)):
+        out = np.rot90(out)
+    if rng.random() < 0.5:
+        out = np.flipud(out)
+    if rng.random() < 0.5:
+        out = np.fliplr(out)
+    return np.array(out, dtype=bool, copy=True)
+
+
+def _candidate_cavities(n_objects: int, rng: random.Random) -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+
+    m = np.ones((5, 5), dtype=bool)
+    masks.append(m)
+
+    m = np.ones((5, 5), dtype=bool)
+    m[0, 0] = False
+    m[0, 1] = False
+    masks.append(m)
+
+    m = np.ones((5, 7), dtype=bool)
+    masks.append(m)
+
+    m = np.ones((5, 7), dtype=bool)
+    m[0, 0] = False
+    m[0, 1] = False
+    m[1, 0] = False
+    masks.append(m)
+
+    if n_objects >= 4:
+        m = np.ones((7, 7), dtype=bool)
+        bites = [
+            (0, 0), (0, 1), (1, 0),
+            (0, 5), (0, 6), (1, 6),
+            (5, 0), (6, 0), (6, 1),
+            (5, 6), (6, 5), (6, 6),
+        ]
+        for r, c in bites:
+            m[r, c] = False
+        masks.append(m)
+
+        m = np.ones((7, 7), dtype=bool)
+        for r, c in bites:
+            m[r, c] = False
+        m[3, 0] = False
+        m[3, 1] = False
+        masks.append(m)
+
+    rng.shuffle(masks)
+    return [_transform_mask(mask, rng) for mask in masks]
+
+
+def _valid_cavity(mask: np.ndarray, n_objects: int) -> bool:
+    comps = _component_from_mask(mask)
+    if len(comps) != 1:
+        return False
+    area = int(mask.sum())
+    if area < 20 or area > 40:
+        return False
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h % 2 == 0 or w % 2 == 0:
+        return False
+    if min(h, w) < 2 * n_objects - 1:
+        return False
+    return True
+
+
+def _place_shape(
+    grid: np.ndarray,
+    pts: np.ndarray,
+    color: int,
+    forbidden: np.ndarray,
+    rng: random.Random,
+    attempts: int = 200,
+) -> bool:
+    h, w = grid.shape
+    ph = int(pts[:, 0].max()) + 1
+    pw = int(pts[:, 1].max()) + 1
+    if ph > h or pw > w:
+        return False
+    for _ in range(attempts):
+        r0 = rng.randrange(0, h - ph + 1)
+        c0 = rng.randrange(0, w - pw + 1)
+        cells = pts + np.array([r0, c0], dtype=int)
+        if np.any(forbidden[cells[:, 0], cells[:, 1]]):
+            continue
+        grid[cells[:, 0], cells[:, 1]] = int(color)
+        for r, c in cells:
+            forbidden[int(r), int(c)] = True
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < h and 0 <= nc < w:
+                    forbidden[nr, nc] = True
+        return True
+    return False
+
+
+def _expected_from_parts(
+    inp: np.ndarray,
+    cavity_global: np.ndarray,
+    object_specs: list[tuple[int, int]],
+) -> np.ndarray:
+    ordered = sorted(object_specs, key=lambda item: item[0], reverse=True)
+    return _apply_ring_fill(inp, cavity_global, ordered)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_objects = rng.randint(2, 4)
+    min_side = 2 * n_objects - 1
+
+    cavity_mask = None
+    cavity_h = cavity_w = 0
+    for candidate in _candidate_cavities(n_objects, rng):
+        cavity_h, cavity_w = candidate.shape
+        if _valid_cavity(candidate, n_objects):
+            cavity_mask = candidate
+            break
+    if cavity_mask is None:
+        return None
+
+    cavity_core = cavity_mask
+    cavity_mask = np.zeros((cavity_h + 2, cavity_w + 2), dtype=bool)
+    cavity_mask[1:-1, 1:-1] = cavity_core
+    border_mask = np.zeros_like(cavity_mask, dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    carved = ~cavity_core
+    border_mask[1:-1, 1:-1] |= carved
+    border_comps = _component_from_mask(border_mask)
+    if len(border_comps) != 1:
+        return None
+
+    border_h, border_w = border_mask.shape
+
+    h = rng.randint(max(16, border_h + 7), min(24, border_h + 13))
+    w = rng.randint(max(16, border_w + 7), min(24, border_w + 13))
+    if h > 30 or w > 30:
+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    colors = list(range(1, 10))
+    rng.shuffle(colors)
+    border_color = colors.pop()
+    object_colors = colors[:n_objects]
+
+    max_r0 = h - border_h - 2
+    max_c0 = w - border_w - 2
+    if max_r0 < 2 or max_c0 < 2:
+        return None
+    border_r0 = rng.randint(2, max_r0)
+    border_c0 = rng.randint(2, max_c0)
+
+    border_pts = np.argwhere(border_mask) + np.array([border_r0, border_c0], dtype=int)
+    cavity_pts = np.argwhere(cavity_mask) + np.array([border_r0, border_c0], dtype=int)
+    grid[border_pts[:, 0], border_pts[:, 1]] = border_color
+
+    forbidden = np.zeros_like(grid, dtype=bool)
+    for r, c in border_pts:
+        forbidden[int(r), int(c)] = True
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w:
+                forbidden[nr, nc] = True
+
+    areas = rng.sample(list(range(2, 11)), n_objects)
+    rng.shuffle(areas)
+    object_specs: list[tuple[int, int]] = []
+    for color, area in zip(object_colors, areas):
+        blob = _random_blob(int(area), rng)
+        if not _place_shape(grid, blob, int(color), forbidden, rng):
+            return None
+        object_specs.append((int(area), int(color)))
+
+    expected = _expected_from_parts(grid, cavity_pts, object_specs)
+    if np.array_equal(expected, grid):
+        return None
+
+    cavity_out = expected[cavity_pts[:, 0], cavity_pts[:, 1]]
+    visible_colors = {int(v) for v in cavity_out if int(v) != 0}
+    if visible_colors != {color for _area, color in object_specs}:
+        return None
+
+    irregular = int(cavity_mask.sum()) != cavity_h * cavity_w
+    roomy = min(cavity_h, cavity_w) > min_side
+    if not irregular and not roomy:
+        return None
+
+    solved = main(grid)
+    if not np.array_equal(solved, expected):
+        return None
+
+    cavity2, border_color2, ordered2 = _extract_structure(grid)
+    if border_color2 != border_color:
+        return None
+    if sorted(object_specs, reverse=True) != ordered2:
+        return None
+    cavity_set_1 = {tuple(map(int, rc)) for rc in cavity_pts}
+    cavity_set_2 = {tuple(map(int, rc)) for rc in cavity2}
+    if cavity_set_1 != cavity_set_2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    base_seed = random.getrandbits(63)
+    for seed in range(600):
+        rng = random.Random(base_seed + (seed + 1) * 104729)
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 9")

