+    compact = [opt for opt in options if opt[0] * opt[1] <= best_area + 2]
+    n_rows, n_cols, min_h, _tag = compact[int(rng.integers(len(compact)))]
+    min_w = radius + (n_cols - 1) * step + radius + 1
