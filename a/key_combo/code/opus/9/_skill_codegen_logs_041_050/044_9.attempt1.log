+    extra_w = int(rng.integers(0, min(5, 30 - min_w) + 1))
+    row_shift = int(rng.integers(0, extra_h + 1))
+    col_shift = int(rng.integers(0, extra_w + 1))
+    h = min_h + extra_h
+    w = min_w + extra_w
