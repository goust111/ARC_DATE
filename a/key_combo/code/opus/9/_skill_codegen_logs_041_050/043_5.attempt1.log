+    col_order = random.sample(range(n), n)
+    symbol_order = random.sample(list(colors), n)
+    table = base[row_order, :][:, col_order]
+    out = np.empty((n, n), dtype=int)
+    for r in range(n):
+        for c in range(n):
+            out[r, c] = symbol_order[int(table[r, c])]
