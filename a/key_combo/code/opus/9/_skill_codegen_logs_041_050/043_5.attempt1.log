+def _parse_legend(legend: np.ndarray, n: int) -> tuple[tuple[int, ...], dict[int, np.ndarray]]:
+    assert legend.shape == (_grid_size_from_order(n), LEGEND_WIDTH)
+    palette: list[int] = []
+    mapping: dict[int, np.ndarray] = {}
