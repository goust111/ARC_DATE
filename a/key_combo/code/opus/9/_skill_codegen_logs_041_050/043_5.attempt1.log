    assert marker_color in _MARKER_TO_STENCIL, "encountered an unknown dominant marker color"

    mask = np.array(_MARKER_TO_STENCIL[marker_color], dtype=bool)
    out = np.zeros((3, 3), dtype=int)
    out[mask] = Color.TEAL
    return out

