+    for r in range(n):
+        for c in range(n):
+            r0 = r * (CELL_SIZE + GAP)
+            c0 = c * (CELL_SIZE + GAP)
+            block = right[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
+            clues = np.argwhere(block != BLACK)
+            if len(clues) == 0:
+                continue
+            assert len(clues) == 1, "a clue cell must contain exactly one colored pixel"
