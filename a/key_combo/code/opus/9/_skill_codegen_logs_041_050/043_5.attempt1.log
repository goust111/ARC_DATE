+            r0 = r * (CELL_SIZE + GAP)
+            c0 = c * (CELL_SIZE + GAP)
+            rr = r0 + random.randrange(CELL_SIZE)
+            cc = c0 + random.randrange(CELL_SIZE)
+            right[rr, cc] = color
