+    arr = _shape_array(coords)
+    if random.random() < 0.5:
+        arr = np.fliplr(arr)
+    arr = np.rot90(arr, random.randint(0, 3))
+    coords2 = [tuple(map(int, rc)) for rc in np.argwhere(arr)]
