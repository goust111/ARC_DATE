+BG = 0
+GREY = 5
+TEAL = 8
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 9)
+PAIR_COUNT_OPTIONS = (3, 4)
+MAX_ATTEMPTS = 400
+
+
+BASE_SHAPES = (
+    ((0, 0), (1, 0), (1, 1)),
+    ((0, 0), (1, 0), (1, 1), (2, 1)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (1, 0), (1, 1), (1, 2)),
+    ((0, 0), (0, 1), (1, 1), (2, 1), (2, 2)),
+    ((0, 0), (1, 0), (2, 0), (2, 1), (2, 2)),
+    ((0, 0), (1, 0), (1, 1), (2, 1), (2, 2), (2, 3)),
+    ((0, 1), (1, 1), (2, 1), (2, 0), (3, 0)),
