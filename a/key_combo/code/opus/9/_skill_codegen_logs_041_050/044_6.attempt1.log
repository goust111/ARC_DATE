+from __future__ import annotations
+
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+DEFECT = 7
+RECT_COLORS = (1, 3, 4, 5)
+DIR_BY_MOD = {
+    0: (-1, 0),   # up
+    1: (0, 1),    # right
+    2: (1, 0),    # down
+    3: (0, -1),   # left
+}
+THREE_RECT_SUBSETS = (
+    (1, 2, 3),
+    (1, 2, 4),
+    (1, 3, 4),
+    (2, 3, 4),
+)
+GEN_ATTEMPTS = 500
+
+_GEN_COUNTER = 0
+_SEEN_OUTPUTS: set[tuple[tuple[int, int], bytes]] = set()
