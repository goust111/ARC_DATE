EDGES = ["top", "bottom", "left", "right"]
EDGE_DIRECTIONS = {
    "top": (-1, 0),
    "bottom": (1, 0),
    "left": (0, -1),
    "right": (0, 1),
}

# Canvas, palette, and edge cue bounds.
