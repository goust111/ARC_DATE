+
+    side = random.randint(8, 11)
+    table, _reveal_indices = _masked_table(cycle, side)
+
+    left_h, left_w = map(int, left_patch.shape)
+    H = max(left_h, side) + random.randint(4, 8)
+    left_r = random.randint(1, H - left_h - 1)
