+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+BLANK = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+# 5x5 diamond outline, following the shared ARC (r, c) convention from arc_utils.
+DIAMOND = (
+    (0, 2),
+    (1, 1),
+    (1, 3),
+    (2, 0),
+    (2, 4),
+    (3, 1),
+    (3, 3),
+    (4, 2),
+)
+OVERLAP_STEPS = ((1, 0), (0, 1), (1, 1))
+MAX_ATTEMPTS = 400
