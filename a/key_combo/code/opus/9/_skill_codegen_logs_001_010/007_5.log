+    r0, c0 = top_left
+    return [(int(r0 + dr), int(c0 + dc)) for dr, dc in DIAMOND]
+
+
+def _candidate_translations(
+    grid: np.ndarray, coords: np.ndarray, left_limit: int
+) -> list[tuple[int, int]]:
+    pts = {tuple(map(int, rc)) for rc in coords}
+    min_r, min_c = coords.min(axis=0)
+    H, W = grid.shape
