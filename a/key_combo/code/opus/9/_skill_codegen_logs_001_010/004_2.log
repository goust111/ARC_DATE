+                return False
+            movers.append(comp)
+
+    if len(movers) != 3 or blocker_mask.sum() not in (1, 2):
+        return False
+
+    movers = _sorted_movers(movers)
+    actual, _ = _simulate(
+        grid.shape,
+        movers,
+        blocker_mask,
+        interior,
+        use_diamond_boundary=True,
+        use_blockers=True,
+        use_collisions=True,
+    )
+    rectangular, _ = _simulate(
+        grid.shape,
+        movers,
+        blocker_mask,
+        interior,
+        use_diamond_boundary=False,
+        use_blockers=True,
+        use_collisions=True,
+    )
+    no_blockers, _ = _simulate(
+        grid.shape,
+        movers,
+        blocker_mask,
+        interior,
+        use_diamond_boundary=True,
+        use_blockers=False,
+        use_collisions=True,
+    )
+    no_collisions, _ = _simulate(
+        grid.shape,
+        movers,
+        blocker_mask,
+        interior,
+        use_diamond_boundary=True,
+        use_blockers=True,
+        use_collisions=False,
+    )
+
+    if all(_same_shifts(actual, rectangular)):
+        return False
+    if all(_same_shifts(actual, no_blockers)):
