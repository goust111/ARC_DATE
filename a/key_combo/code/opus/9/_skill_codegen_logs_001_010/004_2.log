+    for k in range(4):
+        rotated = pts.copy()
+        for _ in range(k):
+            rotated = np.stack([rotated[:, 1], -rotated[:, 0]], axis=1)
+        for flip in (False, True):
+            cur = rotated.copy()
+            if flip:
+                cur[:, 1] *= -1
+            cur = _normalize(cur)
+            key = tuple(sorted(map(tuple, cur.tolist())))
+            if key not in seen:
