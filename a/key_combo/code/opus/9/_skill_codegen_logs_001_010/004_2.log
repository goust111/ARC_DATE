+            interior,
+            use_diamond_boundary=False,
+            use_blockers=False,
+            use_collisions=True,
+        )
+        if actual[0]["shift"] >= 3 and actual[0]["shift"] < rect[0]["shift"] and "boundary" in actual[0]["reasons"]:
