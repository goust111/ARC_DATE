+    def valid(next_coords: np.ndarray) -> tuple[bool, set[str]]:
+        reasons: set[str] = set()
+        in_bounds = (
+            (next_coords[:, 0] >= 0)
+            & (next_coords[:, 0] < h)
+            & (next_coords[:, 1] >= 0)
+            & (next_coords[:, 1] < w)
