+        if use_blockers and np.any(occupied_blockers[next_coords[:, 0], next_coords[:, 1]]):
+            reasons.add("blocker")
+        if use_collisions and np.any(settled[next_coords[:, 0], next_coords[:, 1]]):
+            reasons.add("collision")
+        return not reasons, reasons
