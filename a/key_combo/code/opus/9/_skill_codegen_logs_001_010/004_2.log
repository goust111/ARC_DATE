+            forbidden_ab,
+            b_shape,
+            row_min=1,
+            row_max=int(a_coords[:, 0].min()) - b_h - 2,
+            col_min=max(1, min(a_cols) - b_w + 1),
+            col_max=min(size - b_w - 1, max(a_cols)),
