+        return None
+    return _RNG.choice(candidates)
+
+
+def _draw_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    view = grid[top : top + h, left : left + w]
+    mask = patch != BG
+    view[mask] = patch[mask]
+
+
