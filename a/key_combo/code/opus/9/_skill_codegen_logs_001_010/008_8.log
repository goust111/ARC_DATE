+
+def _place_patch(
+    grid: np.ndarray,
+    patch: np.ndarray,
+    placed_boxes: list[tuple[int, int, int, int]],
+    padding: int,
+) -> tuple[int, int] | None:
+    h, w = patch.shape
+    candidates = []
+    for r0 in range(grid.shape[0] - h + 1):
+        for c0 in range(grid.shape[1] - w + 1):
