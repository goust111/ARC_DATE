+    blue_box = _bbox(np.isin(g, [BLUE, GREEN]))
+    red_box = _bbox(g == RED)
+    assert blue_box is not None and red_box is not None
+
+    blue_patch = _crop_bbox(g, blue_box)
+    red_patch = _crop_bbox(g, red_box)
+    assert np.count_nonzero(blue_patch == GREEN) == 1
+    assert np.all(np.isin(blue_patch, [BG, BLUE, GREEN]))
+    assert np.all(np.isin(red_patch, [BG, RED]))
