+
+def _packing_beats_bbox_touch(blue: np.ndarray, red: np.ndarray, best_area: int) -> bool:
+    naive_area = None
+    hb, wb = blue.shape
+    hr, wr = red.shape
+    candidates = []
+    for dc in range(-wr + 1, wb):
+        candidates.append((-hr, dc))
+        candidates.append((hb, dc))
+    for dr in range(-hr + 1, hb):
