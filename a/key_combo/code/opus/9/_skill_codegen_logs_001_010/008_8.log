+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 5
+BLUE = 1
+RED = 2
+GREEN = 3
+WINDOW = 7
+INTERNAL_BG = 0
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+_RNG = random.Random()
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return Counter(map(int, grid.ravel())).most_common(1)[0][0]
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    parts = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _shape_bbox(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _render_coords(coords: set[tuple[int, int]], color: int) -> np.ndarray:
+    r0, c0, r1, c1 = _shape_bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        out[r - r0, c - c0] = color
+    return out
+
+
+def _is_connected(coords: set[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    start = next(iter(coords))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nb = (r + dr, c + dc)
+            if nb in coords and nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return len(seen) == len(coords)
+
+
+def _is_irregular(coords: set[tuple[int, int]]) -> bool:
+    r0, c0, r1, c1 = _shape_bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    return h >= 2 and w >= 2 and len(coords) < h * w
+
+
+def _mask_contacts_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                continue
+            neighbors = 0
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                    neighbors += 1
+            if neighbors >= 2:
+                return True
+    return False
+
+
+def _piece_patch(coords: set[tuple[int, int]], color: int, *, marker: tuple[int, int] | None = None) -> np.ndarray:
+    patch = np.full(_render_coords(coords, color).shape, BG, dtype=int)
+    r0, c0, _, _ = _shape_bbox(coords)
+    for r, c in coords:
+        patch[r - r0, c - c0] = color
