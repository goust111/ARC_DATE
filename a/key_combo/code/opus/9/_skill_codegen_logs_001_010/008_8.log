+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            ok = True
+            for ar0, ac0, ar1, ac1 in placed_boxes:
+                if not (
+                    box[2] + padding < ar0
+                    or ar1 + padding < box[0]
+                    or box[3] + padding < ac0
+                    or ac1 + padding < box[1]
