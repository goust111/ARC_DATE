+
+BG = 5
+BLUE = 1
+RED = 2
+GREEN = 3
+WINDOW = 7
+INTERNAL_BG = 0
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+_RNG = random.Random()
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return Counter(map(int, grid.ravel())).most_common(1)[0][0]
