+    assert len(coords) >= 2, "each fragment must have at least two pixels"
+    H, W = grid.shape
+    seen: set[tuple[int, int]] = set()
+    candidates: list[frozenset[tuple[int, int]]] = []
+
+    for r, c in coords:
+        for dr, dc in offsets:
+            top = (r - dr, c - dc)
+            if top in seen:
+                continue
+            seen.add(top)
+            full = _placement_cells(top, offsets)
