+
+def _room_dims(template: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    max_r = max(r for r, _ in template) + 1
+    max_c = max(c for _, c in template) + 1
+    inner_h = random.randint(max_r + 1, max_r + 3)
+    inner_w = random.randint(max_c + 1, max_c + 3)
