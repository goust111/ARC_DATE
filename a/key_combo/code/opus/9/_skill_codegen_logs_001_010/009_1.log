+    grid[r0 : r1 + 1, c1] = WALL_COLOR
+
+
+def _sample_rooms(H: int, W: int, template: tuple[tuple[int, int], ...]) -> tuple[list[tuple[int, int, int, int]], str] | None:
+    side = random.choice(SIDE_CHOICES)
