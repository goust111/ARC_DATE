+def _shift_boxes_into_grid(boxes: list[tuple[int, int, int, int]]) -> tuple[tuple[int, int], list[tuple[int, int, int, int]]] | None:
+    union_h = max(box[2] for box in boxes) + 1
+    union_w = max(box[3] for box in boxes) + 1
