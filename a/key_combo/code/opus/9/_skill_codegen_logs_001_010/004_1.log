+    width = random.randint(min_w, max_w)
+    dr = random.randint(pad, height - union_h - pad)
+    dc = random.randint(pad, width - union_w - pad)
+    shifted = [(r0 + dr, c0 + dc, r1 + dr, c1 + dc) for r0, c0, r1, c1 in boxes]
+    return (height, width), shifted
