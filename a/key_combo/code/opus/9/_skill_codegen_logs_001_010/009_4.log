+GRID_H = 12
+PANEL_W = 12
+GRID_W = PANEL_W * 2
+OUTPUT_H = GRID_H - 1
+
+LEFT_FG = int(Color.BLUE)
+RIGHT_FG = int(Color.RED)
+LEFT_CTRL = int(Color.GREEN)
+RIGHT_CTRL = int(Color.YELLOW)
+OUT_MARK = int(Color.GREY)
+BG = int(Color.BLACK)
+
+LEFT_CELL_RANGE = [(r, c) for r in range(1, GRID_H) for c in range(PANEL_W)]
+
+GEN_RETRIES = 400
+PANEL_RETRIES = 120
+
