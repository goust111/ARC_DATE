+        for gr, gc in cup["gap_cells"]:
+            rr, cc = gr, gc
+            dist = 0
+            while _in_bounds(shape, rr, cc):
+                candidates.setdefault((rr, cc), []).append(
+                    (dist, r0, c0, idx, int(cup["color"]))
+                )
+                rr += dr
+                cc += dc
+                dist += 1
