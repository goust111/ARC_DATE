+
+
+def _valid_gap(indices: list[int], edge_len: int) -> bool:
+    if len(indices) not in (1, 2):
+        return False
+    if indices != list(range(indices[0], indices[0] + len(indices))):
+        return False
+    if indices[0] == 0 or indices[-1] == edge_len - 1:
