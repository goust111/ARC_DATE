+        winner = min(values)
+        winner_map[cell] = winner
+        if len(values) > 1:
+            best_dist = winner[0]
+            if sum(1 for value in values if value[0] == best_dist) > 1:
+                tie_cells.append(cell)
+            else:
+                strict_cells.append(cell)
