+                "color": int(cup["color"]),
+                "bbox": _bbox_from_cells(body),
+                "opening": _rotate_dir(cup["opening"], k),
+                "gap_cells": tuple(sorted(gap)),
+                "body_cells": body,
+                "fill_cells": fill,
+            }
