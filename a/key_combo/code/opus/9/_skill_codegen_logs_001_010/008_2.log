+    rotated = []
+    for cup in cups:
+        body = {_rotate_coord(cell, shape, k) for cell in cup["body_cells"]}
+        fill = {_rotate_coord(cell, shape, k) for cell in cup["fill_cells"]}
+        gap = {_rotate_coord(cell, shape, k) for cell in cup["gap_cells"]}
+        rotated.append(
