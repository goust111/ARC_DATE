+
+
+def _rotate_dir(name: str, k: int) -> str:
+    out = name
+    for _ in range(k % 4):
+        out = ROTATE_DIR[out]
+    return out
+
+
+def _rotate_cups(cups: list[dict], shape: tuple[int, int], k: int) -> tuple[list[dict], tuple[int, int]]:
