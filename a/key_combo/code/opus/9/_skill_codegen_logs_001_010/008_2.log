+        for item in items:
+            uniq[item[3]] = min(item, uniq.get(item[3], item))
+        values = list(uniq.values())
+        if len(values) > 1:
+            collision_cells.append(cell)
+        winner = min(values)
+        winner_map[cell] = winner
+        if len(values) > 1:
