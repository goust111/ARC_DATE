+def _rotate_coord(coord: tuple[int, int], shape: tuple[int, int], k: int) -> tuple[int, int]:
+    r, c = coord
+    h, w = shape
+    k %= 4
+    if k == 0:
+        return r, c
+    if k == 1:
+        return w - 1 - c, r
+    if k == 2:
+        return h - 1 - r, w - 1 - c
+    return c, h - 1 - r
