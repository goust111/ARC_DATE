+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+DIRS4 = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+ROTATE_DIR = {
+    "up": "left",
+    "left": "down",
+    "down": "right",
+    "right": "up",
+}
