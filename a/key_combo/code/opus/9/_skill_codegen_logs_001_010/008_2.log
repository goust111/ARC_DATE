+
+def _rotate_cups(cups: list[dict], shape: tuple[int, int], k: int) -> tuple[list[dict], tuple[int, int]]:
+    new_shape = np.rot90(np.zeros(shape, dtype=int), k).shape
+    rotated = []
+    for cup in cups:
+        body = {_rotate_coord(cell, shape, k) for cell in cup["body_cells"]}
