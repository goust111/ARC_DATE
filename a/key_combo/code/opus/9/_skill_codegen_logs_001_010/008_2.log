+    body = {(r, c) for r, c in comp["cells"]}
+    gap = {(r0 + rr, c0 + cc) for rr, cc in gap_rel}
+    fill = {(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)}
