+        "collision_cells": collision_cells,
+        "tie_cells": tie_cells,
+        "strict_cells": strict_cells,
+        "ray_cells": ray_cells,
+        "cleaned_cells": cleaned,
+        "solid_cells": solid_cells,
+    }
