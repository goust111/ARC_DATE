+OUTER_FRAME_SIZE = 6
+MAX_ATTEMPTS = 400
+GRID_SIZE_RANGE = (18, 25)
+COLOR_POOL = tuple(range(1, 10))
+MIN_SEPARATION_DIFF_COLOR = 4
+MIN_SEPARATION_SAME_COLOR_FAR = 4
