+def _build_grid(objects: list[dict], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for obj in objects:
+        color = int(obj["color"])
+        for r, c in obj["coords"]:
+            grid[int(r), int(c)] = color
+    return grid
+
