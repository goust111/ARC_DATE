+def _normalize_coords(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    arr = np.asarray(coords, dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
