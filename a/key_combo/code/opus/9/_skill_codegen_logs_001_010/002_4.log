+                    {
+                        "i": i,
+                        "j": j,
+                        "color": comps[i]["color"],
+                        "p_a": p_a,
+                        "p_b": p_b,
+                        "path": _path_points(p_a, p_b),
+                    }
+                )
+    return {"components": comps, "hole_mask": hole_mask, "pairs": pairs}
