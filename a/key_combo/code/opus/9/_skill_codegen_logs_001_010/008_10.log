+BG = Color.BLACK
+SOURCE = Color.GREY
+TARGET = Color.ORANGE
+PATH_COLORS = (Color.BLUE, Color.RED, Color.GREEN)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+TARGET_SIZE = 8
+TARGET_SLOTS = ((1, 1), (1, 4), (4, 1), (4, 4))
+HOLE_BANK = (
+    ((0, 0), (1, 0), (1, 1)),
+    ((0, 1), (1, 0), (1, 1), (1, 2)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (0, 1), (1, 1), (1, 2)),
+    ((0, 1), (1, 0), (1, 1), (2, 1)),
+    ((0, 0), (0, 1), (1, 0), (1, 1), (2, 0)),
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
