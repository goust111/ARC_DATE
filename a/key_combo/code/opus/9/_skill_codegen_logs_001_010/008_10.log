+        targets.append(target_info)
+
+    source_records: list[dict] = []
+    source_bands = [(1, h // 3 - 2), (h // 3 + 1, 2 * h // 3 - 2), (2 * h // 3 + 1, h - 5)]
+    rng.shuffle(source_bands)
+
+    available_hole_refs: dict[int, list[int]] = {
