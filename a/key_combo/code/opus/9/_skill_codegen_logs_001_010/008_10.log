+    for dr, dc in shape:
+        rr, cc = top + int(dr), left + int(dc)
+        grid[rr, cc] = int(color)
+        coords.add((rr, cc))
+    return coords
+
+
+def _component_coord_set(comp: dict) -> set[tuple[int, int]]:
+    return {(int(r), int(c)) for r, c in comp["coords"]}
