+
+    linked = _analyze_connected_sources(grid)
+    if len(linked) != len(case["sources"]):
+        return False
+
+    real_pairs = {(src["shape"], src["path_color"]) for src in case["sources"]}
+    if set(linked) != real_pairs:
+        return False
+
+    for target in case["targets"]:
