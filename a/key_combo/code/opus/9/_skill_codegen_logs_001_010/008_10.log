+    for sr, sc in np.argwhere(black):
+        sr = int(sr)
+        sc = int(sc)
+        if seen[sr, sc]:
+            continue
+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        region: list[tuple[int, int]] = []
+        touches_border = False
+        while stack:
+            r, c = stack.pop()
+            region.append((r, c))
