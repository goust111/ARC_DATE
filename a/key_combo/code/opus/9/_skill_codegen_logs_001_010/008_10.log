+def _target_adjacency_map(targets: list[dict], shape: tuple[int, int]) -> np.ndarray:
+    owner = np.full(shape, -1, dtype=int)
+    for idx, target in enumerate(targets):
+        for r, c in _component_coord_set(target):
+            owner[r, c] = idx
+    return owner
