+
+def _can_place_nonbg(
+    grid: np.ndarray,
+    coords: set[tuple[int, int]],
+    *,
+    padding: int,
+) -> bool:
+    own = set(coords)
+    for r, c in own:
+        if not in_bounds(grid.shape, r, c) or grid[r, c] != BG:
+            return False
+        for rr in range(r - padding, r + padding + 1):
+            for cc in range(c - padding, c + padding + 1):
+                if not in_bounds(grid.shape, rr, cc):
+                    continue
+                if (rr, cc) in own:
+                    continue
+                if grid[rr, cc] != BG:
+                    return False
