+
+def _adjacent_non_object_cells(grid: np.ndarray, coords: set[tuple[int, int]]) -> list[tuple[int, int, int]]:
+    out: list[tuple[int, int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for r, c in coords:
