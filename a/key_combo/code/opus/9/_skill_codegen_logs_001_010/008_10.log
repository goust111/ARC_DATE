+            color
+            for _r, _c, color in _adjacent_non_object_cells(grid, coords)
+            if color not in {BG, SOURCE, TARGET}
+        ]
+        if len(neighbors) == 1:
+            linked.append((_norm_coords(coords), int(neighbors[0])))
+        else:
+            assert len(neighbors) == 0
+    return linked
