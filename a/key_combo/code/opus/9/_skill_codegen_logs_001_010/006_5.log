+            seen[row, col] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((int(r), int(c)))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
