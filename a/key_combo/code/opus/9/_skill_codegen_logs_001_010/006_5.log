+        out_v, infos_v, _seeds_v, _waypoints_v = _solve_details(g, horizontal_first=False)
+    except Exception:
+        return False
+
+    if np.array_equal(out_h, out_v):
+        return False
+    if infos_h[0]["seed_index"] == infos_v[0]["seed_index"]:
+        return False
+
+    waypoint_set = set(waypoints_h)
+    seed_cells = {
+        tuple(map(int, coord))
+        for seed in seeds_h
