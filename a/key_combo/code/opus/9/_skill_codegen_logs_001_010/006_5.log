+
+
+def _make_vertical_seed(bottom_row: int, col: int, rng: random.Random) -> list[tuple[int, int]]:
+    if rng.random() < 0.5:
+        return [(int(bottom_row - 1), int(col)), (int(bottom_row), int(col))]
+    return [(int(bottom_row - 2), int(col)), (int(bottom_row - 1), int(col)), (int(bottom_row), int(col))]
+
+
+def _expected_seed_winners(grid: np.ndarray) -> tuple[list[int], list[int], list[int], list[tuple[int, int]]]:
+    out_h, infos_h, seeds_h, waypoints_h = _solve_details(grid, horizontal_first=True)
+    out_v, infos_v, _seeds_v, _waypoints_v = _solve_details(grid, horizontal_first=False)
+    winners_h = [int(info["seed_index"]) for info in infos_h]
+    winners_v = [int(info["seed_index"]) for info in infos_v]
+    distances_h = [int(info["distance"]) for info in infos_h]
