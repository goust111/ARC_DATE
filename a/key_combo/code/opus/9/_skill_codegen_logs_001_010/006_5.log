+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    height, width = mask.shape
+    seen = np.zeros((height, width), dtype=bool)
+    comps: list[np.ndarray] = []
