def _largest_solid_rectangles(mask: np.ndarray) -> list[tuple[int, int, int, int]]:
    h, w = mask.shape
    rects: list[tuple[int, int, int, int, int]] = []
    for r0 in range(h):
        for r1 in range(r0, h):
            for c0 in range(w):
                for c1 in range(c0, w):
