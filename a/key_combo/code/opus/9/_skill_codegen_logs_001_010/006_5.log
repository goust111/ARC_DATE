+    a_center = rng.randint(inner_lo, inner_hi)
+    a_cells = _make_horizontal_seed(rows[0] - 1, a_center, delta, rng)
+    if not _seed_cells_ok(a_cells, grid.shape, waypoint_set, occupied):
