+def _segment_seed_distance(path: list[tuple[int, int]], seed_coords: np.ndarray) -> int:
+    path_arr = np.array(path, dtype=int)
+    diffs = np.abs(path_arr[:, None, :] - seed_coords[None, :, :]).sum(axis=2)
+    return int(diffs.min())
