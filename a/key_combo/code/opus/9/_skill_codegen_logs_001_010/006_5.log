+    if rows is None or rows[1] - rows[0] < 4:
+        return None
+
+    left_col = rng.randint(3, max(3, width // 2 - 2))
+    right_lo = left_col + 6
+    right_hi = width - 4
+    if right_lo > right_hi:
+        return None
+    right_col = rng.randint(right_lo, right_hi)
+
+    start_left = rng.random() < 0.5
