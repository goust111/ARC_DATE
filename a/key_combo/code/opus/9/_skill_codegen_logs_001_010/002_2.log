+    other = color_b if tl_uses_first else color_a
+
+    g = np.zeros((h, w), dtype=int)
+    g[r_min, c_min] = tl_color
+    g[r_max, c_max] = tl_color
+    g[r_min, c_max] = other
+    g[r_max, c_min] = other
+    return g
+
