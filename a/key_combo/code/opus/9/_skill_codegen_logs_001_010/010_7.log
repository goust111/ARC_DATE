+        coords = info["bars"][idx]["coords"]
+        out[coords[:, 0], coords[:, 1]] = RED
+    return out
+
+
+def _random_partition(total: int, parts: int, rng: random.Random) -> list[int]:
+    cuts = sorted(rng.sample(range(total + parts - 1), parts - 1)) if parts > 1 else []
