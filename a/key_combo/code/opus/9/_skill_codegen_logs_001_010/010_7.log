+    r, c = marker
+    row_gap = abs(r - bar["row"])
+    if c < bar["col"]:
+        col_gap = bar["col"] - c
+    elif c > bar["end_col"]:
+        col_gap = c - bar["end_col"]
+    else:
+        col_gap = 0
+    return max(row_gap, col_gap)
+
