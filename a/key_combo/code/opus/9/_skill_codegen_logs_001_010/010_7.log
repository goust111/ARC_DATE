+    if int(grid[r, c]) != BLACK:
+        return False
+    h, w = grid.shape
+    for rr in range(max(0, r - 1), min(h, r + 2)):
+        for cc in range(max(0, c - 1), min(w, c + 2)):
+            if int(grid[rr, cc]) == TEAL:
+                return False
+    for mr, mc in markers:
+        if max(abs(r - mr), abs(c - mc)) <= 1:
+            return False
+    return True
