+def _build_scaffold(n_rows: int, n_cols: int) -> tuple[np.ndarray, list[int], list[int]]:
+    height = 4 * int(n_rows) - 1
+    width = 4 * int(n_cols) - 1
+    grid = np.zeros((height, width), dtype=int)
