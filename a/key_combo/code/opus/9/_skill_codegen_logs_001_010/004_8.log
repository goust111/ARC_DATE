+def _vertical_specs(row_starts: list[int], col_starts: list[int]) -> list[dict]:
+    specs: list[dict] = []
+    for cj, c0 in enumerate(col_starts):
+        for edge in (0, 2):
+            c = c0 + edge
+            for r_lo in range(len(row_starts) - 1):
