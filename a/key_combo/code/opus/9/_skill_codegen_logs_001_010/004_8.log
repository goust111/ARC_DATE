+def _point_on_spec(point: tuple[int, int], spec: dict) -> bool:
+    r, c = point
+    if spec["orientation"] == "h":
+        return r == spec["fixed"] and spec["lo"] <= c <= spec["hi"]
+    return c == spec["fixed"] and spec["lo"] <= r <= spec["hi"]
+
