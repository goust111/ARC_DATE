+        for edge in (0, 2):
+            c = c0 + edge
+            for r_lo in range(len(row_starts) - 1):
+                for r_hi in range(r_lo + 1, len(row_starts)):
+                    specs.append(
+                        {
+                            "orientation": "v",
+                            "col_index": cj,
+                            "fixed": c,
+                            "lo": row_starts[r_lo],
+                            "hi": row_starts[r_hi] + 2,
+                            "endpoints": ((row_starts[r_lo], c), (row_starts[r_hi] + 2, c)),
+                            "frames": {(ri, cj) for ri in range(r_lo, r_hi + 1)},
+                        }
+                    )
+    return specs
