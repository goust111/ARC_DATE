+
+    return out, {
+        "bg": bg,
+        "scaffold_color": scaffold_color,
+        "row_starts": row_starts,
+        "col_starts": col_starts,
+        "pairs": pairs,
+        "frame_centers": frame_centers,
+        "center_roles": center_roles,
+        "pair_paint_counts": pair_paint_counts,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
