+                            "orientation": "h",
+                            "row_index": ri,
+                            "fixed": r,
+                            "lo": col_starts[c_lo],
+                            "hi": col_starts[c_hi] + 2,
+                            "endpoints": ((r, col_starts[c_lo]), (r, col_starts[c_hi] + 2)),
+                            "frames": {(ri, cj) for cj in range(c_lo, c_hi + 1)},
