+        return None
+
+    colors = random.sample(list(MARKER_COLORS), len(specs))
+    inp = _render_input(base, specs, colors)
+    if not _validate_generated(inp):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_ATTEMPTS):
