+            assert c1 in frame_edge_cols and r1 in frame_edge_rows and r2 in frame_edge_rows
+            pairs.append(
+                {
+                    "color": int(color),
+                    "orientation": "v",
+                    "fixed": int(c1),
+                    "lo": int(lo),
+                    "hi": int(hi),
