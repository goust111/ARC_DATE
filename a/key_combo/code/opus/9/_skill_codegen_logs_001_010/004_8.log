+    col_starts: list[int],
+) -> list[dict]:
+    pairs: list[dict] = []
+    frame_edge_rows = {r for r0 in row_starts for r in (r0, r0 + 2)}
+    frame_edge_cols = {c for c0 in col_starts for c in (c0, c0 + 2)}
