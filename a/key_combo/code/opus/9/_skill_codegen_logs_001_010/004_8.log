+
+    if not any(tuple(center) not in roles for center in centers):
+        return False
+
+    if len({int(out[center]) for center in roles}) < 2:
+        return False
+
+    for center in conflicts:
+        if int(out[center]) != int(roles[center]["h"]):
+            return False
+
+    return True
