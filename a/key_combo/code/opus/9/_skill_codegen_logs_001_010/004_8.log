+    out = g.copy()
+    center_roles: dict[tuple[int, int], dict[str, int]] = {}
+    frame_centers = {(r0 + 1, c0 + 1) for r0 in row_starts for c0 in col_starts}
+    pair_paint_counts: dict[int, int] = {}
