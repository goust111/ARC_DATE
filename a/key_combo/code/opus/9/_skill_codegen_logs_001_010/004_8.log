+def _render_input(base: np.ndarray, specs: list[dict], colors: list[int]) -> np.ndarray:
+    grid = base.copy()
+    for spec, color in zip(specs, colors):
+        for r, c in spec["endpoints"]:
+            assert grid[r, c] == SCAFFOLD_COLOR
+            grid[r, c] = int(color)
+    return grid
