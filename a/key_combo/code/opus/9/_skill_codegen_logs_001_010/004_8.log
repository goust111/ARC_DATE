+def _horizontal_specs(row_starts: list[int], col_starts: list[int]) -> list[dict]:
+    specs: list[dict] = []
+    for ri, r0 in enumerate(row_starts):
+        for edge in (0, 2):
+            r = r0 + edge
+            for c_lo in range(len(col_starts) - 1):
+                for c_hi in range(c_lo + 1, len(col_starts)):
+                    specs.append(
