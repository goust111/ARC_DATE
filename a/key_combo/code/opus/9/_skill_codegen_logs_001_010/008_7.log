    inp = _gen_render((height, width), sprites, _gen_input_placements(height, width))
    return inp if _gen_matches_solver(inp, expected) else None


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
