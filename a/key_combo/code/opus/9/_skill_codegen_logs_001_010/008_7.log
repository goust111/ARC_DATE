        (r, c)
        for r, c in gray_offsets
        if 0 < r < bh - 1 and 0 < c < bw - 1
    ]
    support = interior_gray or gray_offsets
    if not support:
        assert np.all(sprite == RED), "unsupported stamp should fill its bbox"

    h, w = g.shape
    out = g.copy()
    painted = 0
