+        anchor_c0 = random.randint(slot_c0, slot_c0 + w - 2)
+        paste(inp, np.full((1, 2), RED, dtype=int), anchor_r0, anchor_c0)
+        expected[inp == RED] = BG
+        dst_r0 = anchor_r0 - (h - 1) if side == "top" else anchor_r0
+        dst_c0 = slot_c0
