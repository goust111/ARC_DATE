    flip = np.fliplr if side in {"left", "right"} else np.flipud
    flipped = flip(sprite)

    if side == "left":
        sr, sc = pr, pc                     # sprite at pair origin
        mr, mc = sr, sc + w                  # mirror right of sprite
        anchor_r = random.randint(sr, sr + h - ANCHOR_SIZE)
        anchor_c = sc + w
        input_r, input_c = sr, sc - gap
    elif side == "right":
