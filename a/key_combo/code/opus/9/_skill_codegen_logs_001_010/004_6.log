+    if target.shape != green.shape:
+        return None
+    if not bool(np.all((target == BG) | (green == BG))):
+        return None
+    paste(expected, green, dst_r0, dst_c0, transparent=BG)
+
+    if not _semantic_checks(inp, expected):
+        return None
+    return inp
+
