+        r0, c0, r1, c1 = _bbox_coords(global_coords)
+        assert r1 == r0 + 2 and c1 == c0 + 2
+        assert len(coords) == 8
+        assert g[r0 + 1, c0 + 1] == BG
+        for dr in range(3):
+            for dc in range(3):
+                rr, cc = r0 + dr, c0 + dc
+                if (dr, dc) == (1, 1):
+                    assert g[rr, cc] == BG
+                else:
+                    assert g[rr, cc] in RING_COLORS
+        entries.append((r0, c0))
