+    g[sep_row, :] = GREY
+
+    lower_r0 = sep_row + 1
+    for gr in range(3):
+        for gc in range(3):
+            r0 = lower_r0 + gr * RING_STEP
+            c0 = left_pad + gc * RING_STEP
