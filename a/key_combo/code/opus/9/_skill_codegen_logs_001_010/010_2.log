+        unique_count = random.randint(2, 4)
+        chosen = random.sample(RING_COLORS, unique_count)
+        values = chosen + [random.choice(chosen) for _ in range(8 - unique_count)]
+        random.shuffle(values)
+        corners = values[:4]
+        sides = values[4:]
