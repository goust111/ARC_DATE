+def _random_mask() -> np.ndarray:
+    while True:
+        ones = random.randint(2, 7)
+        bits = [1] * ones + [0] * (9 - ones)
+        random.shuffle(bits)
+        mask = np.asarray(bits, dtype=int).reshape(3, 3)
+        if np.count_nonzero(mask == 1) >= 2 and np.count_nonzero(mask == 0) >= 2:
+            return mask
+
+
