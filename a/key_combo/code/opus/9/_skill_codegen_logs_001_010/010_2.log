+    assert g.ndim == 2
+
+    sep_row, instr_col, mapping = _ring_layout(g)
+    mask = _decode_mask(g, sep_row, instr_col)
+
+    out = g.copy()
+    for gr in range(3):
+        for gc in range(3):
+            r0, c0 = mapping[(gr, gc)]
