+    cols = sorted({c for _r, c in entries})
+    assert len(rows) == 3 and len(cols) == 3
+    assert rows[1] - rows[0] == RING_STEP and rows[2] - rows[1] == RING_STEP
+    assert cols[1] - cols[0] == RING_STEP and cols[2] - cols[1] == RING_STEP
