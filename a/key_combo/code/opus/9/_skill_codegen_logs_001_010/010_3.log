+        rr = bg_coords[:, 0]
+        cc = bg_coords[:, 1]
+        touches_outer = np.any(
+            (rr == 0)
+            | (rr == padded.shape[0] - 1)
+            | (cc == 0)
+            | (cc == padded.shape[1] - 1)
+        )
+        if not touches_outer:
+            holes += 1
+    return holes
