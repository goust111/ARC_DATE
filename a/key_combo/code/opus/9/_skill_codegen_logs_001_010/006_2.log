+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+GREY = 5
+BG = 0
+PALETTE = (1, 2, 3, 4)
+DIR_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_TO_SIDE = {
+    "up": "top",
+    "down": "bottom",
+    "left": "left",
+    "right": "right",
+}
+SIDE_TO_DIR = {
+    "top": "up",
+    "bottom": "down",
+    "left": "left",
+    "right": "right",
+}
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
