Shape = tuple[tuple[int, int], ...]


def _norm_shape(cells) -> Shape:
    r0 = min(r for r, _c in cells)
    c0 = min(c for _r, c in cells)
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in cells))


def _connected(shape: Shape) -> bool:
    cells = set(shape)
