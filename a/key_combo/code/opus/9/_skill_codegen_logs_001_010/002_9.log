+from arc_utils import Color, components_mask
+
+
+BLACK = Color.BLACK
+GREY = Color.GREY
+ORANGE = Color.ORANGE
+ENDPOINT_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.TEAL, Color.MAROON)
