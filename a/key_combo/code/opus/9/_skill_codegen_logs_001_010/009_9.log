+        gaps.append((c1 - c0 - 1, r, c0, c1))
+    min_gap = min(gap for gap, _r, _c0, _c1 in gaps)
+    for gap, r, c0, c1 in gaps:
+        if gap == min_gap:
+            out[r, c0 : c1 + 1] = RED
+    return out
+
