+    min_gap = min(gap for gap, _r, _c0, _c1 in row_gaps)
+    for gap, r, c0, c1 in row_gaps:
+        if gap == min_gap:
+            out[r, c0 : c1 + 1] = RED
+
+    # Guard against a degenerate implementation that ignores the extension step.
