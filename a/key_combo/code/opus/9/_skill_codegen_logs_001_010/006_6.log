0104:         color = int(component["color"])
0105:         pointed, opposite = _sprite_endpoints(g, component["coords"])
0106: 
0107:         for coord, value in ((pointed, color), (opposite, Color.BLACK)):
0108:             assert int(g[coord]) == frame, "sprite endpoints must land on frame pixels"
0109:             assert coord not in assignments, "frame endpoint assignments must not overlap"
0110:             assignments[coord] = int(value)
0111: 
0112:     out = g.copy()
0113:     for (r, c), value in assignments.items():
0114:         out[r, c] = value
0115:     return out
