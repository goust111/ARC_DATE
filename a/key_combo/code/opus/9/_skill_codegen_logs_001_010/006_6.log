+    same_overlaps = []
+    for cell, rays in info["candidates"].items():
+        copy_ranks = {int(ray["copy_rank"]) for ray in rays}
+        if len(copy_ranks) > 1:
+            cross_overlaps.append(cell)
+        elif len(rays) > 1:
+            same_overlaps.append(cell)
