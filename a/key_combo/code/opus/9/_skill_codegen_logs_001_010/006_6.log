+def _diagonal_copy(grid: np.ndarray) -> np.ndarray:
+    h, w = map(int, grid.shape)
+    out = np.full((2 * h, 2 * w), BG, dtype=int)
+    _paste(out, grid, 0, 0)
+    _paste(out, grid, h, w)
+    return out
