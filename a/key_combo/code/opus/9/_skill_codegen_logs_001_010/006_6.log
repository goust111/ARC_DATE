+
+def _validate_generated(grid: np.ndarray, mode: str) -> bool:
+    arrows = _find_arrows(grid)
+    if not (1 <= len(arrows) <= 3):
+        return False
+    if len({int(a["color"]) for a in arrows}) != len(arrows):
+        return False
