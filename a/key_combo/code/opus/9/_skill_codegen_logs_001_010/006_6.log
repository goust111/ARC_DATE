+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import itertools
+import numpy as np
+
+
+BG = 0
+ARROW_COLORS = (1, 2, 3, 4)
+DECO_COLORS = (5, 6, 7, 8, 9)
+GEN_ATTEMPTS = 500
+
+
+ARROW_SPECS = {
+    "left": {
+        "shape": (3, 4),
