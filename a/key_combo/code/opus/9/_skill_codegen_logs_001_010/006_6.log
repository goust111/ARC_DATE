+    if {da, db} == {"up", "left"}:
+        up = a if da == "up" else b
+        left = a if db == "left" else b
+        cell = (int(left["tip"][0]), int(up["tip"][1]))
+        return (
+            int(left["tip"][1]) > int(up["tip"][1])
+            and int(left["tip"][0]) < int(up["tip"][0])
+            and cell not in up["cells"]
+            and cell not in left["cells"]
