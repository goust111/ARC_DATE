+    "up": {
+        "shape": (4, 3),
+        "cells": {(0, 1), (1, 1), (2, 1), (3, 1), (1, 0), (1, 2)},
+        "tip": (0, 1),
+        "dir": (-1, 0),
+    },
+    "down": {
+        "shape": (4, 3),
+        "cells": {(0, 1), (1, 1), (2, 1), (3, 1), (2, 0), (2, 2)},
+        "tip": (3, 1),
+        "dir": (1, 0),
