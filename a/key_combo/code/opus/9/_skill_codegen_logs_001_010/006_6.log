0159: def _try_place_sprite(grid, color, orientation, axis, placed_endpoints) -> bool:
0160:     """Sample one sprite's direction/start and paste it if pixels/endpoints are free."""
0161:     direction = random.choice(DIRECTIONS[orientation])
0162:     bar_start = random.randint(BAR_START_MIN, BAR_START_MAX)
0163:     if orientation == "H":
0164:         top, left = axis - CROSSBAR_MID, bar_start
0165:         near_frame, far_frame = (axis, 0), (axis, LAST)
0166:     else:
0167:         top, left = bar_start, axis - CROSSBAR_MID
0168:         near_frame, far_frame = (0, axis), (LAST, axis)
0169:     pointed_frame, opposite_frame = (near_frame, far_frame) if direction == DIRECTIONS[orientation][0] else (far_frame, near_frame)
0170:     if pointed_frame in placed_endpoints or opposite_frame in placed_endpoints:
0171:         return False
0172: 
0173:     patch = _make_sprite(color, orientation, direction)
0174:     view = grid[top : top + patch.shape[0], left : left + patch.shape[1]]
0175:     mask = patch != TRANSPARENT
0176:     if view.shape != patch.shape or np.any(view[mask] != BACKGROUND_COLOR):
0177:         return False
0178: 
0179:     paste(grid, patch, top, left, transparent=TRANSPARENT)
0180:     placed_endpoints[pointed_frame] = color
0181:     placed_endpoints[opposite_frame] = Color.BLACK
0182:     return True
