+            return None
+        direction = "up" if up_dist < down_dist else "down"
+        tip = (line_rows[0] if direction == "up" else line_rows[-1], axis_c)
+        return {"direction": direction, "tip": tip, "bbox": bbox, "dirvec": ARROW_SPECS[direction]["dir"]}
