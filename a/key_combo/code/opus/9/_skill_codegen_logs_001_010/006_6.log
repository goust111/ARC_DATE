+
+def _render_from_candidates(base: np.ndarray, candidates: dict[tuple[int, int], list[dict[str, object]]], key_fn) -> np.ndarray:
+    out = base.copy()
+    for cell, rays in candidates.items():
+        winner = min(rays, key=key_fn)
+        out[cell] = int(winner["color"])
+    return out
