+BLUE = 1
+RED = 2
+WIDTH = 10
+FULL_HEIGHT = 10
+_RNG = np.random.default_rng()
+
+
+def _shift_row_right(row: np.ndarray, shift: int) -> np.ndarray:
+    out = np.zeros_like(row)
+    if shift < row.size:
+        out[shift:] = row[:-shift]
+    return out
+
+
