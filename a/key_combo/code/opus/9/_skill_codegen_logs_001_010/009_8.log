+        return False
+
+    if np.count_nonzero(out == BG) == 0:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        specs = _sample_specs()
+        if specs is None:
