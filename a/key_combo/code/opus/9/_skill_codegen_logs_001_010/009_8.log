+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
