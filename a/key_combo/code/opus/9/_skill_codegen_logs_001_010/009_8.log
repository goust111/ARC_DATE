+                corner = (r in (0, h - 1)) and (c in (0, w - 1))
+                middle_edge = on_edge and not corner
+                if want_notch:
+                    return (2 if middle_edge else 1 if on_edge else 0, random.random())
+                return (2 if corner else 1 if not on_edge else 0, random.random())
+
+            best_score = max(score(cell) for cell in candidates)
+            best = [cell for cell in candidates if score(cell)[:1] == best_score[:1]]
+            r, c = random.choice(best)
+            mask[r, c] = False
