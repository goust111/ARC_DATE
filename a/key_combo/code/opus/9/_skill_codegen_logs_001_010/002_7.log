+        try:
+            _validate_semantics(out)
+        except AssertionError:
+            continue
+        return out
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid symbol-decoding ray-cast input")

