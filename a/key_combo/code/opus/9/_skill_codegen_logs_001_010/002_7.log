+
+def _compatible(candidate: dict, chosen: list[dict]) -> bool:
+    r, c = candidate["control"]
+    for other in chosen:
+        rr, cc = other["control"]
+        if c == cc:
+            return False
+        if abs(r - rr) <= 1 and abs(c - cc) <= 1:
+            return False
