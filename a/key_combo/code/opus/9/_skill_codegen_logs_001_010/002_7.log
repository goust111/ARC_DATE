+    random.shuffle(spots)
+    chosen: list[tuple[int, int]] = []
+    for r, c in spots:
+        box = (r, c, r + 2, c + 2)
+        ok = True
+        for rr, cc in chosen:
+            other = (rr, cc, rr + 2, cc + 2)
+            if not (box[2] + 1 < other[0] or other[2] + 1 < box[0] or box[3] + 1 < other[1] or other[3] + 1 < box[1]):
+                ok = False
+                break
