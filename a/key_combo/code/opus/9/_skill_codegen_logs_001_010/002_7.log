+    candidates: list[dict] = []
+    for r0 in range(1, height - 3):
+        for c0 in range(0, width - 2):
+            window = grid[r0 : r0 + 3, c0 : c0 + 3]
+            if not set(map(int, np.unique(window))) <= {Color.BLACK, Color.GREY}:
+                continue
