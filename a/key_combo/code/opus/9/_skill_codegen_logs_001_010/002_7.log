+        "direction": "up" if going_up else "down",
+        "tie": d_top == d_bot,
+        "color": color,
+        "paint": painted,
+        "blocked": len(painted) < distance,
+        "blocked_by_panel": blocker == Color.GREY,
+        "blocker": blocker,
