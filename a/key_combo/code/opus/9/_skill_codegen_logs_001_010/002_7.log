+    panel_cells = set().union(*(panel["window_cells"] for panel in panels))
+
+    painted: list[tuple[int, int]] = []
+    blocker = None
+    for step in range(1, distance + 1):
+        nr = r + dr * step
+        nc = c
+        if not (0 <= nr < grid.shape[0]):
+            break
+        if (nr, nc) in panel_cells:
+            blocker = Color.GREY
+            break
