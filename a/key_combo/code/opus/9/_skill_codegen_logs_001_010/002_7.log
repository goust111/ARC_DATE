+    best = min(dists)
+    nearest = [idx for idx, dist in enumerate(dists) if dist == best]
+    assert len(nearest) == 1, "each control must have a unique nearest panel"
+    panel_idx = nearest[0]
+    panel = panels[panel_idx]
+    distance = int(panel["count"])
