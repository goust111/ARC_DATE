+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    RED = 2
+    GREEN = 3
+    GREY = 5
+    ORANGE = 7
+
+
+PANEL_PATTERNS: dict[int, tuple[np.ndarray, ...]] = {
+    2: (
+        np.array([[1, 0, 0], [0, 0, 0], [0, 0, 1]], dtype=int),
