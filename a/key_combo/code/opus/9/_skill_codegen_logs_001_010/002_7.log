+            options = [spec for spec in candidates if pred(spec) and _compatible(spec, chosen)]
+            if not options:
+                feasible = False
+                break
+            chosen.append(random.choice(options))
+        if not feasible:
+            continue
+
+        while len(chosen) < n_controls:
