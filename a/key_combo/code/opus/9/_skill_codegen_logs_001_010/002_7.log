+
+            def score(spec: dict) -> tuple[int, float]:
+                value = 0
+                if spec["panel_index"] not in panels_used:
+                    value += 4
+                if spec["distance"] not in distances_used:
+                    value += 3
+                if spec["blocked_by_panel"] and not any(x["blocked_by_panel"] for x in chosen):
