+    d_top = r
+    d_bot = (grid.shape[0] - 1) - r
+    going_up = d_top <= d_bot
+    dr = -1 if going_up else 1
+    color = Color.RED if going_up else Color.GREEN
+
+    painted: list[tuple[int, int]] = []
+    blocker = None
+    for step in range(1, distance + 1):
+        nr = r + dr * step
+        nc = c
+        if not (0 <= nr < grid.shape[0]):
+            break
