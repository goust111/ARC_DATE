+    def backtrack(start: int, chosen: list[dict]) -> list[dict] | None:
+        if len(chosen) == n_controls:
+            return chosen.copy() if _meets_selection_constraints(chosen, require_tie) else None
+        if len(candidates) - start < n_controls - len(chosen):
+            return None
+        for idx in range(start, len(candidates)):
+            cand = candidates[idx]
+            if not _compatible(cand, chosen):
+                continue
+            chosen.append(cand)
+            result = backtrack(idx + 1, chosen)
+            if result is not None:
+                return result
+            chosen.pop()
+        return None
