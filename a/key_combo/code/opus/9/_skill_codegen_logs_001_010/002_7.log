+        random.shuffle(candidates)
+        chosen: list[dict] = []
+        required_preds = [
+            lambda spec: spec["blocked_by_panel"],
+            lambda spec: not spec["blocked"],
+            lambda spec: spec["direction"] == "up",
+            lambda spec: spec["direction"] == "down",
