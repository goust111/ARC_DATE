+
+
+def _generate_attempt() -> np.ndarray | None:
+    height = random.randint(19, 25)
+    width = random.randint(18, 24)
+    n_panels = random.randint(3, 5)
+    n_controls = random.randint(3, 5)
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[0, :] = Color.RED
+    grid[-1, :] = Color.GREEN
