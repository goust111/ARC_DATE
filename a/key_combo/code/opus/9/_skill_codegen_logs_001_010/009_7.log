+
+
+def _reachable_cells(
+    graph: dict[tuple[int, int], set[tuple[int, int]]],
+    start_cell: tuple[int, int],
+) -> set[tuple[int, int]]:
+    seen = {start_cell}
+    queue: deque[tuple[int, int]] = deque([start_cell])
+    while queue:
+        cell = queue.popleft()
+        for nxt in graph[cell]:
