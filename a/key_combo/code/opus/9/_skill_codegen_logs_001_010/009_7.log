+    divider_cols = [c for c in range(w) if int(np.count_nonzero(grid[:, c] == DIVIDER)) >= h // 2]
+    assert len(divider_rows) in (3, 4) and len(divider_cols) in (3, 4)
+    return divider_rows, divider_cols
