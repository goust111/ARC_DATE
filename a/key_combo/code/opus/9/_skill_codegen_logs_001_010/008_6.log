        rr1 = min(shape[0], r0 + h + 1)
        cc1 = min(shape[1] - 1, c0 + w + 1)
        mask[rr0:rr1, cc0:cc1] = True
    return mask


def _add_gray_clutter(grid: np.ndarray, protected: np.ndarray) -> None:
