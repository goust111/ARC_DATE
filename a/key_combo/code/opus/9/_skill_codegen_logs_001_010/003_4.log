+    patterns = _sample_patterns(nrows * TABLE_COLS)
+    table_patterns = np.empty((nrows, TABLE_COLS, INNER_SIZE, INNER_SIZE), dtype=int)
+    idx = 0
+    for r in range(nrows):
+        for c in range(TABLE_COLS):
+            table_patterns[r, c] = patterns[idx]
+            idx += 1
