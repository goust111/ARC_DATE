+    table_c0 = sep_c + 4
+    for rr in range(nrows + 1):
+        grid[top + 4 * rr, table_c0 : table_c0 + 13] = Color.PINK
+    for cc in range(TABLE_COLS + 1):
+        grid[top : top + table_h, table_c0 + 4 * cc] = Color.PINK
+    for r in range(nrows):
