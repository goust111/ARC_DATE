+    grid[r0 : r0 + FRAME_SIZE, c0 : c0 + FRAME_SIZE][FRAME_BORDER_MASK] = Color.GREY
+    grid[r0 + 1 : r0 + 4, c0 + 1 : c0 + 4] = pattern
