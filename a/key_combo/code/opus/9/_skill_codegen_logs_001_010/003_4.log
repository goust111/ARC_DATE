+        r0, c0, r1, c1 = frame["bbox"]
+        if not np.all(out[r0 + 1 : r1, c0 + 1 : c1] == fill_color):
+            return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        built = _build_instance()
+        if built is None:
