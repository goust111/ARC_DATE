+from __future__ import annotations
+
+from fractions import Fraction
+from itertools import permutations
+import random
+
+import numpy as np
+
+
+BBox = tuple[int, int, int, int]
+Coord = tuple[int, int]
+
+
+BG = 0
+LEGEND = 5
+PLACEHOLDER = 7
+MARKER_COLORS = (1, 2, 3, 4)
+GEN_ATTEMPTS = 400
