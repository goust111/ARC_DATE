+    r0, c0, r1, c1 = box
+    patch = g[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all(patch[0, :] == LEGEND)
+    assert np.all(patch[-1, :] == LEGEND)
+    assert np.all(patch[:, 0] == LEGEND)
+    assert np.all(patch[:, -1] == LEGEND)
+
+    markers: list[tuple[Coord, int]] = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            color = int(g[r, c])
+            if color != LEGEND:
+                markers.append(((r, c), color))
