+def _alignment(block: BBox, pixel: Coord) -> tuple[str, int] | None:
+    r, c = pixel
+    r0, c0, r1, c1 = block
+    options: list[tuple[str, int]] = []
+    if r0 <= r <= r1 and c < c0:
+        options.append(("left", r))
+    if r0 <= r <= r1 and c > c1:
+        options.append(("right", r))
+    if c0 <= c <= c1 and r < r0:
+        options.append(("up", c))
+    if c0 <= c <= c1 and r > r1:
+        options.append(("down", c))
