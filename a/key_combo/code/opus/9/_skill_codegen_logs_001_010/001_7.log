+        cols = random.sample(col_slots, n)
+        perm = random.sample(range(n), n)
+        boxes: list[BBox] = []
+        for i in range(n):
+            bh = random.randint(2, 3)
+            bw = random.randint(2, 3)
+            r0 = rows[i]
+            c0 = cols[perm[i]]
+            box = (r0, c0, r0 + bh - 1, c0 + bw - 1)
+            if box[2] >= h - 1 or box[3] >= w - 1:
