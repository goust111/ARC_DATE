+        path: list[tuple[int, int]] = []
+        states: set[tuple[int, int, int]] = set()
+        r, c, d = start_r, start_c, direction
+        turns = 0
+        while _in_bounds(out.shape, r, c):
+            state = (r, c, d)
+            if state in states:
+                break
+            states.add(state)
+
+            if out[r, c] == BLACK:
+                out[r, c] = TEAL
+                path.append((r, c))
+
+            dr, dc = DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(out.shape, nr, nc):
