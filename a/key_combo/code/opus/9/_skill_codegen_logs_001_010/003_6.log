+        if grid is None:
+            continue
+        if _case_is_valid(grid, target_gap=target_gap):
+            return grid
+    for fallback_gap in (True, False):
+        for _ in range(GEN_RETRIES):
+            grid = _make_random_case()
+            if grid is None:
+                continue
+            if _case_is_valid(grid, target_gap=fallback_gap):
+                return grid
