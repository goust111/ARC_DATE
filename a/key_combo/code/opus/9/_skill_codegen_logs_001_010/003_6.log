        for cc in range(c0,c1+1): mp[(rr,cc)]=obs[-1]
  return obs,mp

def launch(d,ob):
  r0,c0,r1,c1,col=ob
  nd=turn(d,r1-r0+1,c1-c0+1)
  if d==DN:
    fr=r1; fc=c0 if nd==DW else c1; gap=(r1+1,fc)
  elif d==DS:
