+    h, w = mask.shape
+    queue = deque([start])
+    seen[start] = True
+    cells: list[tuple[int, int]] = []
+    while queue:
+        r, c = queue.popleft()
+        cells.append((r, c))
+        for nr, nc in _neighbors4(r, c):
