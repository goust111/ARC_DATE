+        force_orientation = random.randint(0, 1)
+    while True:
+        if force_orientation == 0:
+            shape = (random.randint(3, 6), random.randint(2, 3))
+        else:
+            shape = (random.randint(2, 3), random.randint(3, 6))
+        if shape[0] != shape[1]:
