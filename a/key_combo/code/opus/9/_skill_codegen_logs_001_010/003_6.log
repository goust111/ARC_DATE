+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _component_from_mask(mask: np.ndarray, start: tuple[int, int], seen: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    queue = deque([start])
+    seen[start] = True
+    cells: list[tuple[int, int]] = []
+    while queue:
+        r, c = queue.popleft()
+        cells.append((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
+    return cells
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_source(grid: np.ndarray) -> tuple[int, int]:
+    teal = grid == TEAL
+    seen = np.zeros_like(teal, dtype=bool)
+    candidates: list[tuple[int, int]] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not teal[r, c] or seen[r, c]:
+                continue
+            cells = _component_from_mask(teal, (r, c), seen)
+            if len(cells) != 4:
+                continue
