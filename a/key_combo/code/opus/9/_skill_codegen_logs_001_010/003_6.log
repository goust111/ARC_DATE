+    if direction == NORTH:
+        face_r = r1
+        face_c = c0 if turned == WEST else c1
+        gap = (r1 + 1, face_c)
+    elif direction == SOUTH:
+        face_r = r0
+        face_c = c1 if turned == EAST else c0
+        gap = (r0 - 1, face_c)
+    elif direction == EAST:
