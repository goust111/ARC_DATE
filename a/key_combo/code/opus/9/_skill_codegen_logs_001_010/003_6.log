+    gap_regions = sum(count == 1 for count in info["gap_counts"])
+    secondary_len = sum(len(seg) for seg in info["secondary_segments"])
+    if target_gap:
+        if gap_regions != 1 or secondary_len < 1:
+            return False
+    else:
+        if gap_regions != 0 or secondary_len != 0:
+            return False
+
+    return True
