+    painted: list[tuple[int, int]] = []
+    if _in_bounds(board.shape, r, c) and board[r, c] == BLACK:
+        board[r, c] = GREY
+        painted.append((r, c))
+        nr, nc = r + dr, c + dc
+        r, c = nr, nc
+    else:
+        r, c = r + dr, c + dc
+    while _in_bounds(board.shape, r, c) and board[r, c] == BLACK:
+        board[r, c] = GREY
+        painted.append((r, c))
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(board.shape, nr, nc) or board[nr, nc] != BLACK:
