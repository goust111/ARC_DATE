+    return candidates[0]
+
+
+def _find_obstacles(grid: np.ndarray) -> tuple[list[dict], dict[tuple[int, int], dict]]:
+    fg = (grid != BLACK) & (grid != TEAL)
+    seen = np.zeros_like(fg, dtype=bool)
+    h, w = grid.shape
+    obstacles: list[dict] = []
+    cell_to_obstacle: dict[tuple[int, int], dict] = {}
+    for r in range(h):
+        for c in range(w):
