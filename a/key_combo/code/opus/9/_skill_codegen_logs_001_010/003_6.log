+
+
+def _candidate_gap_events(
+    primary: np.ndarray,
+    region: list[tuple[int, int]],
+    turn_events: list[dict],
+) -> list[dict]:
+    region_set = set(region)
+    candidates: list[dict] = []
+    seen_keys: set[tuple[int, int, int]] = set()
