+
+    nonempty_rays = sum(1 for ray in info["ray_details"] if ray["path"])
+    turning_rays = sum(1 for ray in info["ray_details"] if ray["turns"] > 0)
+    if nonempty_rays < 2 or turning_rays < 1:
