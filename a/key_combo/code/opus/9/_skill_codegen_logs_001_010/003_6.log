+    gh, gw = grid.shape
+    if r0 < 1 or c0 < 1 or r0 + h >= gh or c0 + w >= gw:
+        return False
+    if np.any(grid[r0 - 1 : r0 + h + 1, c0 - 1 : c0 + w + 1] != BLACK):
+        return False
+    grid[r0 : r0 + h, c0 : c0 + w] = color
