+    turn_events: list[dict] = []
+    ray_details: list[dict] = []
+    for start_r, start_c, direction in _ray_starts(src_r0, src_c0):
+        path: list[tuple[int, int]] = []
+        states: set[tuple[int, int, int]] = set()
