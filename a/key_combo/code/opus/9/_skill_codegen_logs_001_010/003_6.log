+def _region_touching_rays(region: list[tuple[int, int]], ray_details: list[dict]) -> int:
+    region_set = set(region)
+    touch_count = 0
+    for ray in ray_details:
+        path = ray["path"]
+        if not path:
+            continue
+        path_set = set(path)
+        touched = False
+        for r, c in region_set:
+            if any((nr, nc) in path_set for nr, nc in _neighbors8(r, c)):
