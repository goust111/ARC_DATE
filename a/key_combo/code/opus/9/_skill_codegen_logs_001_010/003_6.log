+def _trace_primary_rays(grid: np.ndarray) -> tuple[np.ndarray, list[dict], list[dict]]:
+    out = np.array(grid, dtype=int, copy=True)
+    src_r0, src_c0 = _find_source(out)
+    _obstacles, obstacle_map = _find_obstacles(out)
