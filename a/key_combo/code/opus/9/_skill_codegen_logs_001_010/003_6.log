+    # the source's top-left, top-right, bottom-right, and bottom-left boundary cells.
+    return [
+        (src_r0 - 1, src_c0, NORTH),
+        (src_r0, src_c0 + 2, EAST),
+        (src_r0 + 2, src_c0 + 1, SOUTH),
+        (src_r0 + 1, src_c0 - 1, WEST),
+    ]
