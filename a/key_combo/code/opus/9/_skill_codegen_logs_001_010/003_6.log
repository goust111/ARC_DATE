+
+
+def _transform(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    primary, ray_details, turn_events = _trace_primary_rays(grid)
+    out = primary.copy()
+
+    regions = _enclosed_black_regions(primary)
+    for region in regions:
