+
+            dr, dc = DIRS[d]
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(out.shape, nr, nc):
+                break
+            if out[nr, nc] == TEAL:
+                break
+
+            obstacle = obstacle_map.get((nr, nc))
+            if obstacle is not None:
+                d, (r, c), gap = _turn_launch(d, obstacle)
+                turn_events.append({"gap": gap, "direction": d})
