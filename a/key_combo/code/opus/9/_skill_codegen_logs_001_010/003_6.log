+def _enclosed_black_regions(board: np.ndarray) -> list[list[tuple[int, int]]]:
+    black = board == BLACK
+    seen = np.zeros_like(black, dtype=bool)
+    h, w = board.shape
+    regions: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
