+            out[r, c] = GREY
+
+    secondary_segments: list[list[tuple[int, int]]] = []
+    gap_counts: list[int] = []
+    for region in regions:
+        candidates = _candidate_gap_events(primary, region, turn_events)
+        gap_counts.append(len(candidates))
