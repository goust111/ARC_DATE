        q=deque([(r,c)]); seen[r,c]=1; pts=[]; edge=False
        while q:
          rr,cc=q.popleft(); pts.append((rr,cc))
          if rr in (0,H-1) or cc in (0,W-1): edge=True
          for dr,dc in DIRS:
            nr,nc=rr+dr,cc+dc
            if 0<=nr<H and 0<=nc<W and board[nr,nc]==0 and not seen[nr,nc]:
              seen[nr,nc]=1; q.append((nr,nc))
        if not edge: regs.append(pts)
    return regs

def gap_assoc(regs,gaps,shape):
    H,W=shape; regsets=[set(r) for r in regs]; hit=[]
    for i,(gap,d) in enumerate(gaps):
      r,c=gap
      if not (0<=r<H and 0<=c<W): continue
      if any((r+dr,c+dc) in s for s in regsets for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc):
        hit.append((gap,d))
    return hit

def place_rect(g,r0,c0,h,w,col):
    H,W=g.shape
    if r0<1 or c0<1 or r0+h>=H or c0+w>=W: return False
    if np.any(g[r0-1:r0+h+1,c0-1:c0+w+1]!=0): return False
    g[r0:r0+h,c0:c0+w]=col
    return True

def show(g):
    return '"'\\n'.join(''.join(str(x) for x in row) for row in g)

for attempt in range(50000):
