+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+TEAL = 8
+
+NORTH, EAST, SOUTH, WEST = range(4)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+OBSTACLE_COLORS = [1, 2, 3, 4, 6, 7, 9]
+
+MAX_PRIMARY_TURNS = 12
+GEN_RETRIES = 800
