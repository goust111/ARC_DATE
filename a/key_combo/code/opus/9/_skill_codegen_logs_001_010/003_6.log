import numpy as np, random
from collections import deque
BLACK=0; TEAL=8
DN,DE,DS,DW=range(4)
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]

def inb(shape,r,c): h,w=shape; return 0<=r<h and 0<=c<w

def neigh8(r,c):
