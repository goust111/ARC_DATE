+                bbox_v = _bbox_from_gap(gap_v, v_corner, vh, vw)
+        else:
+            gap_r_choices = list(range(vh - 1, min(cross_r - 1, H - MIN_RAY_PIXELS) + 1))
+            bbox_v = None
+            if gap_r_choices and cross_c - vw + 1 >= 0:
+                gap_v = (rng.choice(gap_r_choices), cross_c)
+                bbox_v = _bbox_from_gap(gap_v, v_corner, vh, vw)
