INNER_CORE_COL_PROB, ORTHOGONAL_STEPS = 0.7, ((1, 0), (-1, 0), (0, 1), (0, -1))

# Cluster growth weighting.
ROW_BIAS_CENTER, COL_BIAS_CENTER = 5, 4
ROW_BIAS_SCALE, COL_BIAS_SCALE = 0.35, 0.45

