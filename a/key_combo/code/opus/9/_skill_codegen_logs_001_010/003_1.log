+
+def _ray_corridor(shape: tuple[int, int], obj: dict) -> list[tuple[int, int]]:
+    dr, dc = CORNER_TO_DIR[obj["missing_corner"]]
+    r, c = obj["gap"]
+    path = []
+    while in_bounds(shape, r, c):
+        path.append((int(r), int(c)))
+        r += dr
+        c += dc
+    return path
+
