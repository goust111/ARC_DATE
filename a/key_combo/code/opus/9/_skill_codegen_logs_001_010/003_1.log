+
+def _intersection_pixels(paths: list[list[tuple[int, int]]]) -> set[tuple[int, int]]:
+    counts: dict[tuple[int, int], int] = {}
+    for path in paths:
+        for pt in path:
+            counts[pt] = counts.get(pt, 0) + 1
