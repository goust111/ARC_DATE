+    if intersections:
+        for pt in intersections:
+            contenders = [obj for obj, path in zip(objects, paths, strict=True) if pt in set(path)]
+            winner = min(contenders, key=lambda obj: obj["area"])
+            if out[pt] != winner["color"]:
+                return False
