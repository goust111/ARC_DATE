+def _choose_size(rng: random.Random, used_areas: set[int]) -> tuple[int, int] | None:
+    candidates = [(h, w) for h, w in SIZE_CHOICES if h * w not in used_areas]
+    if not candidates:
+        return None
+    return rng.choice(candidates)
+
+
+def _sample_random_object(
