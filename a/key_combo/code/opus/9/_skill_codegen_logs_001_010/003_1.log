+    (h, w)
+    for h in range(4, 9)
+    for w in range(4, 9)
+)
+GRID_H_RANGE = (18, 27)
+GRID_W_RANGE = (18, 27)
+OBJECT_COUNT_RANGE = (2, 4)
+MIN_BBOX_GAP = 2
+MIN_RAY_PIXELS = 3
+MAX_GENERATION_ATTEMPTS = 600
+CROSSING_PROBABILITY = 0.72
+EXTRA_BOX_ATTEMPTS = 160
