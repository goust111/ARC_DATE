+    objects: list[dict] = []
+    used_areas: set[int] = set()
+    next_color_index = 0
+
+    if require_crossing:
+        pair = _sample_cross_pair(rng, shape, colors[:2])
+        if pair is None:
+            return None
+        objects.extend(pair)
+        used_areas.update(int(obj["area"]) for obj in pair)
+        next_color_index = 2
