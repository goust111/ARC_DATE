+def _corner_points(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {
+        "tl": (r0, c0),
+        "tr": (r0, c1),
+        "br": (r1, c1),
+        "bl": (r1, c0),
+    }
+
+
+def _corner_from_markers(
+    bbox: tuple[int, int, int, int],
+    markers: set[tuple[int, int]],
