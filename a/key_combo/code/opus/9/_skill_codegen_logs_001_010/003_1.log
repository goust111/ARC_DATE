+def _render_input(shape: tuple[int, int], objects: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for obj in objects:
+        for r, c in obj["markers"]:
+            grid[r, c] = obj["color"]
+    return grid
