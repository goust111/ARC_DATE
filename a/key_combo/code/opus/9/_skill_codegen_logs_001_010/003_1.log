+        h_size = _choose_size(rng, used_areas)
+        if h_size is None:
+            return None
+        hh, hw = h_size
+
+        if v_corner == "tl":
+            gap_r_choices = list(range(max(cross_r + 2, MIN_RAY_PIXELS - 1), H - vh + 1))
+            bbox_v = None
