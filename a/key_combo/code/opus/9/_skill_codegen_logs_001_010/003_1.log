+                bbox_h = _bbox_from_gap(gap_h, h_corner, hh, hw)
+        else:
+            gap_c_choices = list(range(max(cross_c + 2, MIN_RAY_PIXELS - 1), W - hw + 1))
+            bbox_h = None
