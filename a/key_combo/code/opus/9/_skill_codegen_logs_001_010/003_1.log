+
+def _sample_cross_pair(
+    rng: random.Random,
+    shape: tuple[int, int],
+    colors: tuple[int, int],
+) -> list[dict] | None:
+    H, W = shape
+    for _ in range(220):
+        used_areas: set[int] = set()
+        cross_r = rng.randint(4, H - 5)
+        cross_c = rng.randint(4, W - 5)
+
+        v_corner = rng.choice(("tl", "br"))
+        h_corner = rng.choice(("tr", "bl"))
