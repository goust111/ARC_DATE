            neighbor_labels = {int(labels[nr, nc]) for nr, nc in _gen_neighbors4(r, c) if labels[nr, nc] > 0}
            if len(neighbor_labels) == 1:
                opts.append((r, c))
    return opts


def _gen_add_unpaired_noise(rng, grid, count, component_count):
    for _ in range(component_count):
