        max_len = min(MAX_SEGMENT_LEN, n, remaining_fg - MIN_SEGMENT_LEN * remaining_segments)
        length = random.randint(MIN_SEGMENT_LEN, max_len)
        lengths.append(length)
        remaining_fg -= length
    random.shuffle(lengths)
    return lengths


