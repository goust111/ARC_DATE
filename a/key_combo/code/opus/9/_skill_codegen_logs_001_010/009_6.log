+def _pool_blocks(mask: np.ndarray, factor: int) -> np.ndarray | None:
+    h, w = mask.shape
+    k = int(factor)
+    if h % k != 0 or w % k != 0:
+        return None
+    pooled = mask.reshape(h // k, k, w // k, k).any(axis=(1, 3))
+    return pooled
+
