+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _build_instance()
+        if grid is None:
+            continue
+        try:
+            _semantic_checks(grid)
+        except Exception:
+            continue
+        return grid
