+SPRITE_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW)
+DOMINO_COLOR = Color.RED
+MIRROR_COLOR = Color.ORANGE
+BG_COLOR = Color.BLACK
+
+GRID_MIN = 12
+GRID_MAX = 18
+GROUP_COUNT_CHOICES = (2, 3)
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
+PADDING = 1
