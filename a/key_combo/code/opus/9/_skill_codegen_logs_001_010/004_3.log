+        for area in range(3, min(7, total) + 1):
+            for cells in itertools.combinations(range(total), area):
+                mask = np.zeros((h, w), dtype=bool)
+                for cell in cells:
+                    mask[cell // w, cell % w] = True
+                if not _touches_all_bbox_sides(mask):
+                    continue
