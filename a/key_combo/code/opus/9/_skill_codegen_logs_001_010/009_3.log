        elif i==len(rows)-1:
            left=min(cols[i], t0[1]); right=max(cols[i], t0[1])
        else:
            left=min(cols[i], cols[i+1]); right=max(cols[i], cols[i+1])
        if left-1 >= 2: final[r,2:left]=True
        if right+1 <= W-2: final[r,right+1:W-2]=True
    inp=np.zeros_like(final)
    for i in range(1,len(rows)):
        r0=rows[i-1]+1; r1=rows[i]-1; c=cols[i]
        if c-2>=2: inp[r0:r1+1,0:c-1]=True
        if c+2<=W-3: inp[r0:r1+1,c:W-2]=True
    for i,r in enumerate(rows):
        if i==0:
            left=min(s0[1], cols[1]); right=max(s0[1], cols[1])
        elif i==len(rows)-1:
            left=min(cols[i], t0[1]); right=max(cols[i], t0[1])
        else:
            left=min(cols[i], cols[i+1]); right=max(cols[i], cols[i+1])
        if left-1 >= 2: inp[r,0:left-1]=True
        if right+1 <= W-2: inp[r,right-1:W-2]=True
    return inp,final

