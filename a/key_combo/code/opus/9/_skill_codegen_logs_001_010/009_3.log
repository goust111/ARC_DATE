def bfs_count(block,s,t):
    H,W=block.shape
    dist=np.full((H,W),-1,int)
    ways=np.zeros((H,W),dtype=object)
    prev={s:None}
    q=deque([s]); dist[s]=0; ways[s]=1
    while q:
        r,c=q.popleft()
