    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and not block[nr,nc]:
                if dist[nr,nc]==-1:
                    dist[nr,nc]=dist[r,c]+1; ways[nr,nc]=ways[r,c]; q.append((nr,nc))
                elif dist[nr,nc]==dist[r,c]+1:
                    ways[nr,nc]+=ways[r,c]
    return dist[t], ways[t]

