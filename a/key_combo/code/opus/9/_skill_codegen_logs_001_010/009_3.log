from collections import deque
import random, numpy as np
random.seed(0)

def bfs(block,s,t):
    H,W=block.shape
    dist=np.full((H,W),-1,int)
    ways=np.zeros((H,W),dtype=object)
    parent={s:None}
    q=deque([s]); dist[s]=0; ways[s]=1
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and not block[nr,nc]:
                if dist[nr,nc]==-1:
                    dist[nr,nc]=dist[r,c]+1; ways[nr,nc]=ways[r,c]; parent[(nr,nc)]=(r,c); q.append((nr,nc))
                elif dist[nr,nc]==dist[r,c]+1:
                    ways[nr,nc]+=ways[r,c]
    if dist[t]==-1: return None
    path=[]; cur=t
    while cur is not None:
        path.append(cur); cur=parent[cur]
    path.reverse()
    return dist[t], ways[t], path

for attempt in range(5000):
    H=random.randint(16,22); W=random.randint(16,22)
    n=random.randint(3,5)
    hs=[random.randint(3,5) for _ in range(n)]
    total=sum(hs)+(n-1)*1
    if total>H-6: continue
    extra=H-6-total
    gaps=[1]*(n+1)
    for _ in range(extra): gaps[random.randrange(n+1)] +=1
    starts=[]; r=gaps[0]+1
    for i,h in enumerate(hs):
        starts.append(r); r+=h+gaps[i+1]
    rects=[]
    ok=True
    prevc=None
    for i,(r0,h) in enumerate(zip(starts,hs)):
        width=random.randint(max(4,W//2), W-4)
        c0=random.randint(2, W-width-2)
        # encourage zigzag
        if prevc is not None and abs(c0-prevc)<3:
            ok=False; break
        rects.append((r0,r0+h-1,c0,c0+width-1))
        prevc=c0
    if not ok: continue
    inp=np.zeros((H,W),bool); final=np.zeros((H,W),bool)
    bad=False
    for r0,r1,c0,c1 in rects:
        if inp[r0:r1+1,c0:c1+1].any(): bad=True; break
        inp[r0:r1+1,c0:c1+1]=True
        final[r0:r1+1,c0+2:c1+1]=True
    if bad: continue
    s=(1,1); t=(H-2,W-2)
    if inp[s] or inp[t] or final[s] or final[t]: continue
    ri=bfs(inp,s,t)
    rf=bfs(final,s,t)
    if ri is None and rf is not None and rf[1]==1:
        print('found',attempt,'shape',H,W,'rects',rects,'dist',rf[0])
        break
else:
    print('none')
