import numpy as np
from collections import Counter

def solve(n):
    g=np.zeros((n,n),dtype=int);g[:,0]=1
    out=g.copy()
    for r in range(n-1):
        out[r,n-1-r]=2
    out[n-1,1:]=3
    bg=(out==0)
    from collections import deque
    ext=np.zeros((n,n),dtype=bool)
    q=deque()
    for r in range(n):
        for c in range(n):
            if r in (0,n-1) or c in (0,n-1):
                if bg[r,c] and not ext[r,c]:
                    ext[r,c]=True;q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<n and 0<=cc<n and bg[rr,cc] and not ext[rr,cc]:
                ext[rr,cc]=True;q.append((rr,cc))
    interior=bg & ~ext
    blue=np.argwhere(out==1); red=np.argwhere(out==2); green=np.argwhere(out==3)
    cnt=Counter()
    for r,c in np.argwhere(interior):
        db=np.min(np.abs(blue[:,0]-r)+np.abs(blue[:,1]-c))
        dr=np.min(np.abs(red[:,0]-r)+np.abs(red[:,1]-c))
        dg=np.min(np.abs(green[:,0]-r)+np.abs(green[:,1]-c))
        if db<=dr and db<=dg: color=1
        elif dr<=dg: color=2
        else: color=3
        cnt[color]+=1
    return interior.sum(), cnt

for n in range(4,31):
    area,cnt=solve(n)
    print(n, area, dict(cnt))
