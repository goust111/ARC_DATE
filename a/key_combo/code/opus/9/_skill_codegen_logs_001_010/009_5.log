+def _frame_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    assert r1 - r0 + 1 >= 3 and c1 - c0 + 1 >= 3, "frames must be at least 3x3"
