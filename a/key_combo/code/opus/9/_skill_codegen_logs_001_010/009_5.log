+    left_cols = [c0 for _r0, c0, _r1, _c1 in boxes]
+    bottom_rows = [r1 for _r0, _c0, r1, _c1 in boxes]
+    right_cols = [c1 for _r0, _c0, _r1, c1 in boxes]
