+def _block_partitions(total: int, cells_per_axis: int, skew: bool) -> tuple[int, ...]:
+    interior = total - (cells_per_axis - 1)
+    assert interior >= 2 * cells_per_axis
+    if cells_per_axis == 2 and skew:
