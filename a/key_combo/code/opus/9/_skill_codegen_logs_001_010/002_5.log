DST_HEIGHT_RANGE, DST_WIDTH_RANGE, DST_MAX_AREA = (9, 13), (5, 16), 195
SOURCE_COUNT_RANGE, SRC_HEIGHT_RANGE, SRC_WIDTH_RANGE = (1, 2), (3, 8), (3, 9)
SRC_DST_MARGIN = 1
DST_SIZE_OPTIONS = tuple(
