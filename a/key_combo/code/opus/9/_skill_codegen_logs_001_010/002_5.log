+            r0 = row_seps[br + 1] + 1
+            c0 = col_seps[bc + 1] + 1
+            grid[r0 : r0 + block_h, c0 : c0 + block_w] = block
+
+    first_pos = _first_occurrence(grid)
+    expected = _oracle_output_from_spec(block_reps, mapping, first_pos)
