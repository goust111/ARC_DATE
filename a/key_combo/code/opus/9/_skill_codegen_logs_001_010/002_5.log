+def _tie_matrix(target: int, loser: int) -> np.ndarray:
+    reps = np.array([[target, loser], [loser, target]], dtype=int)
+    if random.random() < 0.5:
+        reps = reps[:, ::-1]
+    if random.random() < 0.5:
+        reps = reps[::-1, :]
+    return reps
