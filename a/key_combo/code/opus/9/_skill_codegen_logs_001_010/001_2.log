+    coords: set[tuple[int, int]] = set()
+    if len(rows) == 3:
+        pattern = [(rows[0], col), (rows[1], col), (rows[1], col + 1), (rows[2], col + 1)]
+    elif len(rows) == 4:
+        pattern = [
+            (rows[0], col),
+            (rows[1], col),
+            (rows[1], col + 1),
+            (rows[2], col + 1),
+            (rows[3], col + 1),
+        ]
+    else:
+        pattern = [
+            (rows[0], col),
+            (rows[1], col),
+            (rows[1], col + 1),
+            (rows[2], col + 1),
+            (rows[3], col + 1),
+            (rows[4], col + 1),
+        ]
+    if mirror:
+        pattern = [(r, edge["c0"] + edge["c1"] - c) for r, c in pattern]
