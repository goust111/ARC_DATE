+def _draw_frame(grid: np.ndarray, rect: Frame) -> None:
+    r0, c0, r1, c1 = rect
+    grid[r0, c0 : c1 + 1] = Color.BLUE
+    grid[r1, c0 : c1 + 1] = Color.BLUE
+    grid[r0 : r1 + 1, c0] = Color.BLUE
+    grid[r0 : r1 + 1, c1] = Color.BLUE
