+    row = random.randint(edge["r0"] + 1, edge["r1"] - 2)
+    mirror = random.random() < 0.5
+    coords: set[tuple[int, int]] = set()
+    if len(cols) == 3:
+        pattern = [(row, cols[0]), (row, cols[1]), (row + 1, cols[1]), (row + 1, cols[2])]
+    elif len(cols) == 4:
+        pattern = [
+            (row, cols[0]),
+            (row, cols[1]),
+            (row + 1, cols[1]),
+            (row + 1, cols[2]),
+            (row + 1, cols[3]),
+        ]
+    else:
+        pattern = [
+            (row, cols[0]),
+            (row, cols[1]),
+            (row + 1, cols[1]),
+            (row + 1, cols[2]),
+            (row + 1, cols[3]),
+            (row + 1, cols[4]),
