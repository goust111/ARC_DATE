+def _apply_edge(out: np.ndarray, frame_color: int, rects: list[Frame], edge: dict) -> None:
+    for route in edge["routes"]:
+        for r, c in route:
+            if int(out[r, c]) != Color.RED:
+                out[r, c] = frame_color
