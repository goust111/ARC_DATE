+        gap_v = random.randint(GEN_SMALL_GAP_MIN, GEN_SMALL_GAP_MAX)
+        primary_kind = "v"
+
+    a = (0, 0, h_top - 1, w_left - 1)
+    b = (0, w_left + gap_h, h_top - 1, w_left + gap_h + w_right - 1)
+    c = (h_top + gap_v, 0, h_top + gap_v + h_bottom - 1, w_left - 1)
+    d = (
+        h_top + gap_v,
+        w_left + gap_h,
