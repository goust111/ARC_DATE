GenRect = tuple[int, int, int, int]


def _gen_size(max_dim: int, small_rate: float) -> tuple[int, int]:
    if random.random() < small_rate:
        return (
            random.randint(GEN_SMALL_ROOM_MIN, GEN_SMALL_ROOM_MAX),
