+        if ph > h or pw > w:
+            return None
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
+            top = rng.randint(0, h - ph)
+            left = rng.randint(0, w - pw)
+            rect = (top, left, top + ph - 1, left + pw - 1)
+            if any(not _rects_far_enough(rect, other, gap=1) for other in placed_rects):
