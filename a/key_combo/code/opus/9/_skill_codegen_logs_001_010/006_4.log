+                continue
+            frames.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "frame_mask": frame_mask,
+                    "interior": interior,
+                    "halo": halo,
+                    "count": len(grey_components),
