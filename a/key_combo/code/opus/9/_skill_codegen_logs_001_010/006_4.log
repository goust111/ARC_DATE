+        (bbox[0] - 1, bbox[1] - 1),
+        (bbox[0] - 1, bbox[3] + 1),
+        (bbox[2] + 1, bbox[1] - 1),
+        (bbox[2] + 1, bbox[3] + 1),
+    }
+    bbox_corner_halo = {(r, c) for r, c in bbox_corner_halo if 0 <= r < scene.shape[0] and 0 <= c < scene.shape[1]}
