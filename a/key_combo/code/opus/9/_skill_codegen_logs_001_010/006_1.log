+def _normalize_shape(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    coords = coords - coords.min(axis=0)
+    h = int(coords[:, 0].max()) + 1
+    w = int(coords[:, 1].max()) + 1
+    out = np.zeros((h, w), dtype=bool)
+    out[coords[:, 0], coords[:, 1]] = True
+    return out
