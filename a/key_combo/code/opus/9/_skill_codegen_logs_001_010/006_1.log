+            return None
+        row = rng.randint(2, row_hi)
+        col_a = rng.randint(2, max(2, w // 2 - wa - 2))
+        col_b = rng.randint(max(col_a + wa + 3, w // 2 + 1), w - wb - 3)
+        return (row, col_a), (row, col_b)
