+def _segment_labels(blocked: np.ndarray, axis: int) -> np.ndarray:
+    h, w = map(int, blocked.shape)
+    labels = np.full((h, w), -1, dtype=int)
+    sid = 0
+    if axis == 1:
+        for r in range(h):
+            c = 0
+            while c < w:
+                if bool(blocked[r, c]):
+                    c += 1
