+        if col_hi < 2 or 2 > h // 2 - ha - 2 or h // 2 + 1 > h - hb - 3:
+            return None
+        col = rng.randint(2, col_hi)
+        row_a = rng.randint(2, max(2, h // 2 - ha - 2))
+        row_b = rng.randint(max(row_a + ha + 3, h // 2 + 1), h - hb - 3)
+        return (row_a, col), (row_b, col)
