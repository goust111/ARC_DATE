+def _functional_blockers(
+    grid: np.ndarray,
+    seed_a: list[tuple[int, int]],
+    seed_b: list[tuple[int, int]],
+    rng: random.Random,
+) -> bool:
+    h, w = map(int, grid.shape)
+    r0a, c0a, r1a, c1a = _seed_bbox(seed_a)
+    r0b, c0b, r1b, c1b = _seed_bbox(seed_b)
