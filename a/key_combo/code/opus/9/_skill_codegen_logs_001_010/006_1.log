+                while c < w and not bool(blocked[r, c]):
+                    labels[r, c] = sid
+                    c += 1
+                sid += 1
+    else:
+        for c in range(w):
+            r = 0
+            while r < h:
+                if bool(blocked[r, c]):
+                    r += 1
