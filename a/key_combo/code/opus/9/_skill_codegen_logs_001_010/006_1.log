+    row_a_hi = h // 2 - ha - 2
+    col_a_hi = w // 2 - wa - 2
+    row_b_lo = h // 2 + 1
+    col_b_lo = w // 2 + 1
+    if row_a_hi < 2 or col_a_hi < 2 or row_b_lo > h - hb - 3 or col_b_lo > w - wb - 3:
