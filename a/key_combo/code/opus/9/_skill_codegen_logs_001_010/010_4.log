+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _make_attempt()
+        if _validate_generated(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid legend-crossing recolor puzzle")

