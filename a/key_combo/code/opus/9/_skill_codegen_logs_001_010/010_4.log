    for r in h_rows:
        c0, c1 = _gen_span(cols)
        h_segments.append({"color": colors[color_i], "r": r, "c0": c0, "c1": c1})
        color_i += 1
    for c in v_cols:
        r0, r1 = _gen_span(rows)
        v_segments.append({"color": colors[color_i], "c": c, "r0": r0, "r1": r1})
        color_i += 1
