    out[r0 + 1, c0 + 2] = patch[0, 1]
    out[r0 + 2, c0 + 0] = patch[0, 0]
    out[r0 + 2, c0 + 1] = patch[1, 2]
    out[r0 + 2, c0 + 2] = patch[2, 0]


