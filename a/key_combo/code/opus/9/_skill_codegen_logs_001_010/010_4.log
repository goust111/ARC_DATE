        start = int(np.random.randint(INTERIOR_MIN, limit - length))
    else:
        lo = max(INTERIOR_MIN, int(include) - length + 1)
        hi = min(int(include), limit - length - INTERIOR_PAD)
        start = int(np.random.randint(lo, hi + 1))
