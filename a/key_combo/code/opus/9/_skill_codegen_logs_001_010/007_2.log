        preds=[p for p in n4(*cur) if p in dist and dist[p]==dist[cur]-1 and g[p] not in (1,3)]
        if len(preds)!=1: return None
        cur=preds[0]
        if cur!=s: path.append(cur)
    return path[::-1]

