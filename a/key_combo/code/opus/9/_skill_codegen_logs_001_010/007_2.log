import numpy as np
from collections import deque, Counter

def cycle(H,W):
    path=[(0,0)]
    for c in range(1,W): path.append((0,c))
    for r in range(1,H):
        if r%2==1:
            path.append((r,W-1))
            for c in range(W-2,0,-1): path.append((r,c))
        else:
            path.append((r,1))
            for c in range(2,W): path.append((r,c))
    for r in range(H-1,0,-1): path.append((r,0))
    return path

def check(path,H,W):
    s=set(path)
    print('len',len(path),H*W,'uniq',len(s)==len(path))
    def neigh(p):
        r,c=p; return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]
