import numpy as np
from collections import deque, Counter

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def path_to_mask(path,shape=(15,15)):
    g=np.zeros(shape,dtype=bool)
    for p in path: g[p]=1
    return g

def addseg(path,a,b):
    r0,c0=a; r1,c1=b
    if r0==r1:
        step=1 if c1>=c0 else -1
        cells=[(r0,c) for c in range(c0,c1+step,step)]
    else:
        step=1 if r1>=r0 else -1
        cells=[(r,c0) for r in range(r0,r1+step,step)]
    if path and cells and path[0]==cells[-1] and len(cells)>1:
        path.extend(cells[:-1])
    elif path and path[-1]==cells[0]:
        path.extend(cells[1:])
    else:
        path.extend(cells)

def build(points,shape=(20,20)):
    path=[]
