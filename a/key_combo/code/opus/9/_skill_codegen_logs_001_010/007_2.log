+        nr, nc = path[(i + 1) % n]
+        incoming = (r - pr, c - pc)
+        outgoing = (nr - r, nc - c)
+        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
+        if cross == 0:
+            continue
+        sign = 1 if cross > 0 else -1
+        counts[sign] += 1
+        turn_signs[(r, c)] = sign
