+def _turn_partition(path: list[tuple[int, int]]) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    counts: Counter[int] = Counter()
+    turn_signs: dict[tuple[int, int], int] = {}
+    n = len(path)
+    for i, (r, c) in enumerate(path):
