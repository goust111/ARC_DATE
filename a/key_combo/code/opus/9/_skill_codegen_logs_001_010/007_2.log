    for i,(r,c) in enumerate(path):
        pr,pc=path[i-1]; nr,nc=path[(i+1)%n]
        a=(r-pr,c-pc); b=(nr-r,nc-c)
        cross=a[0]*b[1]-a[1]*b[0]
        if cross:
            s=1 if cross>0 else -1
            turns[(r,c)]=s; cnt[s]+=1
    convex=1 if cnt[1]>cnt[-1] else -1
    return turns, convex, cnt

def comp(mask, start):
    H,W=mask.shape
