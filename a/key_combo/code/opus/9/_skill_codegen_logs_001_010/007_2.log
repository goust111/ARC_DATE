    outside=flood(~g,(0,0)); inside=[p for p in map(tuple,np.argwhere(~g)) if p not in outside]
    out2=flood(~m,(0,0))
    print('cnt',cnt,'inside',len(inside),'reachable',sum(p in out2 for p in inside))

for H,W in [(6,6),(7,6),(8,6),(8,8)]:
