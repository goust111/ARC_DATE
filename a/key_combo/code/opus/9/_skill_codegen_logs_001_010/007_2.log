from collections import deque, Counter

def neighbors4(r,c): return [(r+1,c),(r-1,c),(r,c+1),(r,c-1)]

def rect(h,w):
    p=[]
    for c in range(w): p.append((0,c))
    for r in range(1,h): p.append((r,w-1))
    for c in range(w-2,-1,-1): p.append((h-1,c))
    for r in range(h-2,0,-1): p.append((r,0))
    return p

def valid(path):
    s=set(path)
    if len(s)"'!=len(path): return False
    n=len(path)
    for i,p in enumerate(path):
        if abs(p[0]-path[i-1][0])+abs(p[1]-path[i-1][1])!=1: return False
        if abs(p[0]-path[(i+1)%n][0])+abs(p[1]-path[(i+1)%n][1])!=1: return False
        if sum(nb in s for nb in neighbors4(*p))!=2: return False
    return True

def bump(path):
    n=len(path); s=set(path)
    ids=list(range(n)); random.shuffle(ids)
    for i in ids:
        p=path[i]; q=path[(i+1)%n]
        dr=q[0]-p[0]; dc=q[1]-p[1]
        for er,ec in random.sample([(-dc,dr),(dc,-dr)],2):
            a=(p[0]+er,p[1]+ec); b=(q[0]+er,q[1]+ec)
            if a in s or b in s: continue
            ok=True
            for x,allowed in [(a,{p,b}),(b,{a,q})]:
                for nb in neighbors4(*x):
                    if nb in s and nb not in allowed:
                        ok=False
            if not ok: continue
            cand=path[:i+1]+[a,b]+path[i+1:]
            if valid(cand): return cand
    return None

def maybe_shrink(path):
    n=len(path)
