            cells=[(r,c0) for r in range(r0,r1+step,step)]
        if not path: path.extend(cells)
        elif path[-1]==cells[0]: path.extend(cells[1:])
        else: path.extend(cells)
    if path[0]==path[-1]: path.pop()
    rs=[r for r,c in path]; cs=[c for r,c in path]
    offr=pad-min(rs); offc=pad-min(cs)
    path=[(r+offr,c+offc) for r,c in path]
    H=max(r for r,c in path)+pad+1; W=max(c for r,c in path)+pad+1
    g=np.zeros((H,W),dtype=int)
    for r,c in path: g[r,c]=3
    return g,path

