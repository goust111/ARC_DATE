    for i in range(n):
        p=path[i]; q=path[(i+1)%n]
        if abs(p[0]-q[0])+abs(p[1]-q[1])"'!=1:
            print('"'jump',i,p,q); break

def flood(mask,start):
    H,W=mask.shape; q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for nr,nc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]:
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return seen

def test(H,W):
    p=cycle(H,W); check(p,H,W)
    g=np.zeros((H+2,W+2),dtype=bool)
