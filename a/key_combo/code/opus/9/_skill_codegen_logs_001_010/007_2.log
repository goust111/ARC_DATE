from collections import deque, Counter

H=W=7
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]
start=(1,1)
max_len=26
seen_shapes=set()


def flood(openmask,start):
    H=len(openmask); W=len(openmask[0])
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and openmask[nr][nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return seen

def bridge_property(path):
    pts=set(path)
    # canonical shift-free grid with border
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    off_r=1-min(rs); off_c=1-min(cs)
    HH=max(rs)-min(rs)+3; WW=max(cs)-min(cs)+3
    p2=[(r+off_r,c+off_c) for r,c in path]
    pts2=set(p2)
    g=[[False]*WW for _ in range(HH)]
    for r,c in pts2: g[r][c]=True
    n=len(p2)
    cnt=Counter(); turns={}
    for i,(r,c) in enumerate(p2):
        pr,pc=p2[i-1]; nr,nc=p2[(i+1)%n]
        a=(r-pr,c-pc); b=(nr-r,nc-c)
        cross=a[0]*b[1]-a[1]*b[0]
        if cross:
            s=1 if cross>0 else -1
            turns[(r,c)]=s; cnt[s]+=1
    if not cnt or cnt[1]==cnt[-1]: return False
    convex=1 if cnt[1]>cnt[-1] else -1
    m=[row[:] for row in g]
    for p,s in turns.items():
        if s==convex: m[p[0]][p[1]]=False
    bg=[[not x for x in row] for row in g]
    outside=flood(bg,(0,0))
    inside=[(r,c) for r in range(HH) for c in range(WW) if bg[r][c] and (r,c) not in outside]
    if not inside: return False
    out2=flood([[not x for x in row] for row in m], (0,0))
    return any(p in out2 for p in inside)


def canonical(path):
    pts=path[:]
    variants=[]
    for seq in (pts, pts[::-1]):
        for k in range(len(seq)):
            rot=seq[k:]+seq[:k]
            coords=rot
            for t in range(8):
                arr=[]
                for r,c in coords:
                    if t==0: x,y=r,c
                    elif t==1: x,y=r,-c
                    elif t==2: x,y=-r,c
                    elif t==3: x,y=-r,-c
                    elif t==4: x,y=c,r
                    elif t==5: x,y=c,-r
                    elif t==6: x,y=-c,r
