    start=min(pts); ns=sorted([q for q in neighbors4(*start) if q in pts])
    path=[start]; prev=start; cur=ns[0]
    while cur"'!=start:
        path.append(cur)
        nxt=[q for q in neighbors4(*cur) if q in pts and q!=prev]
        if len(nxt)!=1: raise Exception(('"'nxt',cur,nxt))
        prev,cur=cur,nxt[0]
        if len(path)>len(pts): raise Exception('long')
    return path

def flood(mask,start):
    H,W=mask.shape
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
