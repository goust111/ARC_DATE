from collections import Counter, deque
import numpy as np, random

def n4(r,c): return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def make_loop(H,W,a,b,d):
    pts=[(1,1),(1,a),(d,a),(d,b),(1,b),(1,W),(H,W),(H,1),(1,1)]
    path=[]
    for u,v in zip(pts,pts[1:]):
        r0,c0=u; r1,c1=v
        if r0==r1:
            step=1 if c1>=c0 else -1; cells=[(r0,c) for c in range(c0,c1+step,step)]
        else:
            step=1 if r1>=r0 else -1; cells=[(r,c0) for r in range(r0,r1+step,step)]
        if not path:path.extend(cells)
        elif path[-1]==cells[0]: path.extend(cells[1:])
        else: path.extend(cells)
    if path[0]==path[-1]: path.pop()
    g=np.zeros((H+2,W+2),dtype=int)
    for r,c in path: g[r,c]=3
    # validate
    ptsset=set(path)
    if any(sum(q in ptsset for q in n4(*p))"'!=2 for p in ptsset): return None
    return g

def trace(mask):
    pts={tuple(p) for p in np.argwhere(mask)}
    for p in pts:
        if sum(q in pts for q in n4(*p))!=2: return None
    s=min(pts); ns=sorted([q for q in n4(*s) if q in pts]); path=[s]; prev=s; cur=ns[0]
    while cur!=s:
        path.append(cur); nxt=[q for q in n4(*cur) if q in pts and q!=prev]
        if len(nxt)!=1: return None
        prev,cur=cur,nxt[0]
        if len(path)>len(pts): return None
    return path

def transform(g):
    path=trace(g==3)
    cnt=Counter(); turns={}; n=len(path)
    for i,(r,c) in enumerate(path):
        pr,pc=path[i-1]; nr,nc=path[(i+1)%n]
        a=(r-pr,c-pc); b=(nr-r,nc-c); cross=a[0]*b[1]-a[1]*b[0]
        if cross: sg=1 if cross>0 else -1; cnt[sg]+=1; turns[(r,c)]=sg
    convex=1 if cnt[1]>cnt[-1] else -1
    out=g.copy(); deleted=set()
    for (r,c),sg in turns.items():
        if sg==convex: out[r,c]=0; deleted.add((r,c))
    return out, deleted

def shortest(g):
    reds=[tuple(p) for p in np.argwhere(g==2)]
    if len(reds)!=2:return None
    s,t=reds; H,W=g.shape; dist={s:0}; ways={s:1}; q=deque([s])
    while q:
        r,c=q.popleft()
        for nr,nc in n4(r,c):
            if 0<=nr<H and 0<=nc<W and g[nr,nc] not in (1,3):
                nd=dist[(r,c)]+1
                if (nr,nc) not in dist:
                    dist[(nr,nc)]=nd; ways[(nr,nc)]=ways[(r,c)]; q.append((nr,nc))
                elif dist[(nr,nc)]==nd: ways[(nr,nc)] += ways[(r,c)]
    if t not in dist or ways[t]!=1: return None
    cur=t; path=[]
    while cur!=s:
        preds=[p for p in n4(*cur) if p in dist and dist[p]==dist[cur]-1 and g[p] not in (1,3)]
        if len(preds)!=1: return None
        cur=preds[0]
        if cur!=s: path.append(cur)
    return path[::-1]

success=0
for trial in range(100):
    H=random.randint(10,14); W=random.randint(10,14)
    a=random.randint(3,5); b=random.randint(a+2,min(W-3,a+4)); d=random.randint(H//2,H-3)
    base=make_loop(H,W,a,b,d)
    if base is None: continue
    # search endpoints/obstacles
    empty=[tuple(p) for p in np.argwhere(base==0)]
    for _ in range(2000):
        g=base.copy(); s,t=random.sample(empty,2)
        if abs(s[0]-t[0])+abs(s[1]-t[1])<8: continue
        g[s]=2; g[t]=2
        cands=[]
        for r,c in empty:
            if (r,c) in (s,t): continue
            if any(0<=nr<g.shape[0] and 0<=nc<g.shape[1] and base[nr,nc]==3 for nr,nc in n4(r,c)): continue
            cands.append((r,c))
        random.shuffle(cands)
        for r,c in cands[:random.randint(3,12)]: g[r,c]=1
        aft,deleted=transform(g)
        p=shortest(aft)
        if p is None or len(p)<6: continue
        if not any(cell in deleted for cell in p): continue
        bef=shortest(g)
        if bef is not None and len(bef)<=len(p): continue
        success+=1
        print('"'succ',trial,'shape',base.shape,'params',H,W,a,b,d,'after',len(p),'before',None if bef is None else len(bef))
        break
print('successes',success)
