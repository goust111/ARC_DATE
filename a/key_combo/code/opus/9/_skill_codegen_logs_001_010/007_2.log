from collections import deque, Counter

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def trace(mask):
    pts={tuple(p) for p in np.argwhere(mask)}
    start=min(pts)
    ns=sorted([q for q in neighbors4(*start) if q in pts])
    path=[start]; prev=start; cur=ns[0]
    while cur"'!=start:
        path.append(cur)
        nxt=[q for q in neighbors4(*cur) if q in pts and q!=prev]
