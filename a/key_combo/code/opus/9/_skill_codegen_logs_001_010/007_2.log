import random, numpy as np
from collections import Counter, deque

def neighbors4(r,c): return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def path_to_mask(path):
    rs=[r for r,c in path]; cs=[c for r,c in path]
    rmin,rmax=min(rs),max(rs); cmin,cmax=min(cs),max(cs)
    H=rmax-rmin+5; W=cmax-cmin+5
    offr=2-rmin; offc=2-cmin
    g=np.zeros((H,W),dtype=bool)
    for r,c in path: g[r+offr,c+offc]=1
    return g

def rect(h,w):
    p=[]
    for c in range(w): p.append((0,c))
    for r in range(1,h): p.append((r,w-1))
    for c in range(w-2,-1,-1): p.append((h-1,c))
    for r in range(h-2,0,-1): p.append((r,0))
    return p

def valid(path):
    s=set(path)
    if len(s)"'!=len(path): return False
    n=len(path)
    for i,p in enumerate(path):
        q=path[(i-1)%n]; r=path[(i+1)%n]
        if abs(p[0]-q[0])+abs(p[1]-q[1])!=1: return False
        if abs(p[0]-r[0])+abs(p[1]-r[1])!=1: return False
        deg=sum(nb in s for nb in neighbors4(*p))
        if deg!=2: return False
    return True

def bump(path):
    n=len(path); s=set(path)
    idxs=list(range(n)); random.shuffle(idxs)
    for i in idxs:
        p=path[i]; q=path[(i+1)%n]
        dr=q[0]-p[0]; dc=q[1]-p[1]
        opts=[(-dc,dr),(dc,-dr)]
        random.shuffle(opts)
        for er,ec in opts:
            a=(p[0]+er,p[1]+ec); b=(q[0]+er,q[1]+ec)
            if a in s or b in s: continue
            # no unintended adjacency for new cells
            ok=True
            allowedA={p,b}; allowedB={a,q}
            for x,allowed in [(a,allowedA),(b,allowedB)]:
                for nb in neighbors4(*x):
                    if nb in s and nb not in allowed:
                        ok=False
                # diagonal/touch not relevant, only 4-neigh
            if not ok: continue
            new=path[:i+1]+[a,b]+path[i+1:]
            if valid(new): return new
    return None

def trace(mask):
    pts={tuple(p) for p in np.argwhere(mask)}
    start=min(pts); ns=sorted([q for q in neighbors4(*start) if q in pts])
    path=[start]; prev=start; cur=ns[0]
    while cur!=start:
        path.append(cur)
        nxt=[q for q in neighbors4(*cur) if q in pts and q!=prev]
        if len(nxt)!=1: return None
        prev,cur=cur,nxt[0]
        if len(path)>len(pts): return None
    return path

def flood(mask,start):
    H,W=mask.shape
    q=deque([start]); seen={start}
    while q:
        r,c=q.popleft()
        for nr,nc in neighbors4(r,c):
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return seen

def success(path):
    mask=path_to_mask(path)
    t=trace(mask)
    if t is None: return False, None
    cnt=Counter(); turns={}; n=len(t)
    for i,(r,c) in enumerate(t):
        pr,pc=t[i-1]; nr,nc=t[(i+1)%n]
        a=(r-pr,c-pc); b=(nr-r,nc-c); cross=a[0]*b[1]-a[1]*b[0]
        if cross:
            s=1 if cross>0 else -1; turns[(r,c)]=s; cnt[s]+=1
    if not cnt or cnt[1]==cnt[-1]: return False, mask
    convex=1 if cnt[1]>cnt[-1] else -1
    m=mask.copy()
    for p,s in turns.items():
        if s==convex: m[p]=0
    outside=flood(~mask,(0,0))
    inside=[p for p in map(tuple,np.argwhere(~mask)) if p not in outside]
    if not inside: return False, mask
    out2=flood(~m,(0,0))
    if any(p in out2 for p in inside):
        return True, mask
    return False, mask

for trial in range(2000):
    p=rect(random.randint(6,10), random.randint(6,10))
    for _ in range(random.randint(8,30)):
        q=bump(p)
        if q is None: break
        p=q
    ok,mask=success(p)
    if ok:
        print('"'found',trial,len(p),mask.shape)
        print(mask.astype(int))
        break
else:
    print('none')
