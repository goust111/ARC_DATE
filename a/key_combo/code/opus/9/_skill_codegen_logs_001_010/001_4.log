    hidden_counts = np.zeros((p, p), dtype=int)

    for h, w in rects:
        choices = []
        for r0 in range(GRID_SIZE + 1 - h):
            for c0 in range(GRID_SIZE + 1 - w):
                if hidden[r0 : r0 + h, c0 : c0 + w].any():
                    continue
                add_counts = _gen_residue_counts_29ec7d0e(h, w, r0, c0, p)
