+    w = tile.shape[1]
+    for q in range(1, w + 1):
+        ok = True
+        for c in range(w):
+            if not np.array_equal(tile[:, c], tile[:, c % q]):
+                ok = False
+                break
+        if ok:
+            return q
+    raise AssertionError("unreachable")
