+def _minimal_row_period(tile: np.ndarray) -> int:
+    h = tile.shape[0]
+    for p in range(1, h + 1):
+        ok = True
+        for r in range(h):
+            if not np.array_equal(tile[r], tile[r % p]):
+                ok = False
