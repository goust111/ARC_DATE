+
+BAR_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE)
+SIDES = ("top", "right", "bottom", "left")
+OVERLAP_QUADRANTS = {
+    "NE": (("top", 1), ("right", -1)),
+    "NW": (("top", -1), ("left", -1)),
+    "SE": (("bottom", 1), ("right", 1)),
+    "SW": (("bottom", -1), ("left", 1)),
