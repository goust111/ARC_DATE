+    assert 2 <= len(bars) <= 4
+    assert len({bar["color"] for bar in bars}) == len(bars)
+    assert len({bar["length"] for bar in bars}) == len(bars)
+    assert len({bar["side"] for bar in bars}) == len(bars)
+
+    bars.sort(key=lambda bar: (bar["bbox"][0], bar["bbox"][1], bar["color"]))
+    for bar in bars:
