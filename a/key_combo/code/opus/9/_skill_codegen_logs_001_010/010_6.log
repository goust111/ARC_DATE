+def _bar_step(template_bbox: tuple[int, int, int, int], bar_bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    tr, tc = _bbox_center(template_bbox)
+    br, bc = _bbox_center(bar_bbox)
+    dr = int(np.sign(br - tr))
+    dc = int(np.sign(bc - tc))
+    assert dr != 0 or dc != 0
+    return dr, dc
