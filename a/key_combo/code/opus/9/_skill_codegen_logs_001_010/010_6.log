+        for k in range(1, bar["length"] + 1):
+            top = r0 + k * dr * h
+            left = c0 + k * dc * w
+            for rr, cc in np.argwhere(scene["template_mask"]):
+                gr = int(top + rr)
+                gc = int(left + cc)
+                assert 0 <= gr < g.shape[0] and 0 <= gc < g.shape[1], "generated copy fell outside the grid"
+                if (gr, gc) in template_set:
