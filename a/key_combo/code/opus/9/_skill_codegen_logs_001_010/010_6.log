+            return False
+    else:
+        if overlap_cells and random.random() < 0.5:
+            return False
+
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    mask = _random_connected_mask()
+    require_overlap = random.random() < 0.7
+    bars = _choose_bar_specs(mask, require_overlap=require_overlap)
+    if bars is None:
