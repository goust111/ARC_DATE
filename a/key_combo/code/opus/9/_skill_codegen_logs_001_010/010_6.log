+def _bar_length(comp: dict) -> int:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    area = int(comp["area"])
+    assert h == 1 or w == 1, "expected one-cell-thick control bars"
+    assert area == max(h, w), "expected a solid straight bar"
+    return area
+
