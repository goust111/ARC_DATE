+    if any(len(cells) == 0 for cells in winners_by_bar.values()):
+        return False
+
+    for order, bar in enumerate(scene["bars"]):
+        modified = grid.copy()
+        coords = bar["coords"]
+        modified[coords[:, 0], coords[:, 1]] = Color.BLACK
+        if np.array_equal(main(modified), expected):
+            return False
