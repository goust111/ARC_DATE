+from __future__ import annotations
+
+import itertools
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_DIR) not in sys.path:
