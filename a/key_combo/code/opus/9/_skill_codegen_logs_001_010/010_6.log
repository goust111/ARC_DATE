+                        winners_by_bar[previous_order].discard((gr, gc))
+                    best[(gr, gc)] = (priority, bar["color"])
+                    winners_by_bar[order].add((gr, gc))
+
+    for cell, candidates in seen_candidates.items():
+        if len(candidates) >= 2:
+            overlap_cells.append(cell)
