+    grid = _build_input(mask, bars)
+    if grid is None:
+        return None
+    if not _check_semantics(grid, require_overlap=require_overlap):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
