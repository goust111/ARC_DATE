+
+def _make_rectangle(r0: int, c0: int, h: int, w: int) -> set[tuple[int, int]]:
+    return {(r, c) for r in range(r0, r0 + h) for c in range(c0, c0 + w)}
+
+
+def _can_place_cells(
+    grid: np.ndarray,
+    coords: set[tuple[int, int]],
+    *,
