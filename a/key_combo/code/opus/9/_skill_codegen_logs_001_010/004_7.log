+            return True
+        if c >= c1 + 2 and _clear_segment(grid[r, c1 + 1 : c]):
+            return True
+    if c0 <= c <= c1:
+        if r <= r0 - 2 and _clear_segment(grid[r + 1 : r0, c]):
