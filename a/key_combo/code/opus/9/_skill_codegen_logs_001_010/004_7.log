+    h, w = grid.shape
+    shapes = list(_SMALL_SHAPES)
+    random.shuffle(shapes)
+    rect_rows = {r for r0, _c0, r1, _c1 in rectangle_boxes for r in range(r0, r1 + 1)}
+    rect_cols = {c for _r0, c0, _r1, c1 in rectangle_boxes for c in range(c0, c1 + 1)}
