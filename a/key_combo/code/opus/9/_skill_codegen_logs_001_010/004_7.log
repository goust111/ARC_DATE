+def _adjacency_count(noise_coords: np.ndarray, rect_mask: np.ndarray) -> int:
+    total = 0
+    h, w = rect_mask.shape
+    for r, c in noise_coords:
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIR4:
