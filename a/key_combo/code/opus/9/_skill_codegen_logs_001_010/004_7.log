+RECT_COLORS = (Color.BLUE, Color.GREEN)
+NOISE_COLOR = Color.ORANGE
+DISTRACTOR_COLOR = Color.RED
+WEAK_COLOR = Color.GREY
+BG = Color.BLACK
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIGHT_TRANSPARENT = {BG, DISTRACTOR_COLOR}
