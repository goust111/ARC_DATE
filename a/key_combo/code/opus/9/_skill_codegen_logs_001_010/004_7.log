+        return None
+
+    h, w = grid.shape
+    for _ in range(80):
+        rect_h = random.randint(3, 4)
+        rect_w = random.randint(3, 5)
+        r0 = random.randint(0, h - rect_h)
+        c0 = random.randint(0, w - rect_w)
+        bbox = (r0, c0, r0 + rect_h - 1, c0 + rect_w - 1)
