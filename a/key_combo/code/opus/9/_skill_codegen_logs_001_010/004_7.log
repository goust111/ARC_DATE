+        rel_cols = [c for _, c in shape]
+        max_r = h - max(rel_rows) - 1
+        max_c = w - max(rel_cols) - 1
+        candidates = [(r0, c0) for r0 in range(max_r + 1) for c0 in range(max_c + 1)]
