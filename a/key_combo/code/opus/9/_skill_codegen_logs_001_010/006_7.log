+
+    bucket_ids = list(range(4))
+    rng.shuffle(bucket_ids)
+    chosen = bucket_ids[: min(4, n_cols)]
+    while len(chosen) < n_cols:
+        chosen.append(rng.choice(bucket_ids))
+    totals = [rng.randint(BUCKETS[idx][0], BUCKETS[idx][1]) for idx in chosen]
