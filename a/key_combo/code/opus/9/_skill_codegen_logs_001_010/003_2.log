+        near_pool = [r for r in range(max(0, guide_r - 3), guide_r)]
+        far_pool = [r for r in range(0, max(0, guide_r - 3))]
+    else:
+        available = list(range(guide_r + 1, grid.shape[0]))
+        near_pool = [r for r in range(guide_r + 1, min(grid.shape[0], guide_r + 4))]
