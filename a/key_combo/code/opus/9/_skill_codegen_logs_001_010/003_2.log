+    out = np.zeros_like(g)
+    out[guide_r] = guide_row
+
+    top_row = np.zeros(w, dtype=int)
+    bottom_row = np.zeros(w, dtype=int)
+    for c in range(w):
+        top_row[c] = _project_column(g, guide_r, c, "top", choose)
+        bottom_row[c] = _project_column(g, guide_r, c, "bottom", choose)
+
+    if apply_periodic:
+        keep = np.array([(c % step) == phase for c in range(w)], dtype=bool)
+        top_row[~keep] = BG
+        bottom_row[~keep] = BG
+
+    if apply_gap:
+        gaps = guide_row == BG
+        top_row[gaps] = BG
+        bottom_row[gaps] = BG
+
+    if apply_recolor:
+        for c in range(w):
+            a = int(top_row[c])
+            b = int(bottom_row[c])
+            if a == BG or b == BG:
+                continue
+            if a == b:
