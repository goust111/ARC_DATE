        assert int(segment["area"]) == int(c1 - c0 + 1), "foreground components must be solid horizontal segments"

    mask = g == fg
    shifted = np.zeros_like(mask, dtype=bool)
    shifted[:, :-1] = mask[:, 1:]

    out = np.full(g.shape, Color.GREY, dtype=int)
    out[shifted] = fg
    return out

