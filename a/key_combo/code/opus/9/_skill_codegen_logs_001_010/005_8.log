+def _embed(local_mask: np.ndarray, grid_size: int, top: int, left: int) -> np.ndarray:
+    mask = np.zeros((grid_size, grid_size), dtype=bool)
+    h, w = local_mask.shape
+    mask[top : top + h, left : left + w] = local_mask
+    return mask
+
