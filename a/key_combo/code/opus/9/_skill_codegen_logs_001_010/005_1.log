+def _component_sizes(frame_count: int, edges: list[tuple[int, int]]) -> dict[int, int]:
+    graph = {idx: set() for idx in range(frame_count)}
+    for a, b in edges:
+        graph[a].add(b)
+        graph[b].add(a)
+
+    sizes: dict[int, int] = {}
+    seen = set()
+    for start in range(frame_count):
+        if start in seen:
+            continue
+        stack = [start]
+        comp = []
+        seen.add(start)
+        while stack:
+            node = stack.pop()
+            comp.append(node)
+            for nxt in graph[node]:
+                if nxt not in seen:
+                    seen.add(nxt)
+                    stack.append(nxt)
+        size = len(comp)
+        for node in comp:
+            sizes[node] = size
+    return sizes
