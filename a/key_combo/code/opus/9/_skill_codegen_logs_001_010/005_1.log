+    for group in sorted(groups, key=lambda g: g["shape"][0] * g["shape"][1], reverse=True):
+        gh, gw = group["shape"]
+        if gh > h or gw > w:
+            return None
+        positions = [(r0, c0) for r0 in range(h - gh + 1) for c0 in range(w - gw + 1)]
+        random.shuffle(positions)
