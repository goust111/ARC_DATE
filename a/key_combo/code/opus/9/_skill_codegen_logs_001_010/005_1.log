+    sizes: dict[int, int] = {}
+    seen = set()
+    for start in range(frame_count):
+        if start in seen:
+            continue
+        stack = [start]
+        comp = []
+        seen.add(start)
+        while stack:
+            node = stack.pop()
+            comp.append(node)
+            for nxt in graph[node]:
+                if nxt not in seen:
+                    seen.add(nxt)
+                    stack.append(nxt)
+        size = len(comp)
+        for node in comp:
+            sizes[node] = size
+    return sizes
