+    b0, b1, b2, b3 = frame_b["bbox"]
+    if ra == rb:
+        if ca > cb:
+            frame_a, frame_b = frame_b, frame_a
+            (ra, ca), (rb, cb) = frame_a["center"], frame_b["center"]
+            a0, a1, a2, a3 = frame_a["bbox"]
+            b0, b1, b2, b3 = frame_b["bbox"]
+        row = ra
+        return [(row, c) for c in range(a3 + 1, b1)]
+    if ca == cb:
+        if ra > rb:
