+def _fill_concentric(out: np.ndarray, bbox: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = bbox
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            dist = min(r - (r0 + 1), (r1 - 1) - r, c - (c0 + 1), (c1 - 1) - c)
+            out[r, c] = RED if dist % 2 == 0 else BLUE
