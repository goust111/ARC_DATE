+    edges = sorted({bridge["edge"] for bridge in bridges})
+    comp_sizes = _component_sizes(len(frames), edges)
+    return {
+        "frames": frames,
+        "frame_map": frame_map,
+        "bridges": bridges,
+        "edges": edges,
+        "component_sizes": comp_sizes,
