+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        cr, cc = frame["center"]
+        norm_frames.append(
+            {
+                "center": (cr - min_r, cc - min_c),
+                "size": frame["size"],
+                "bbox": (r0 - min_r, c0 - min_c, r1 - min_r, c1 - min_c),
+            }
+        )
+    norm_cells = {(r - min_r, c - min_c) for r, c in cells}
+    max_r = max(r for r, _ in norm_cells)
+    max_c = max(c for _, c in norm_cells)
+    return {
