+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+TEAL = 8
+
+GEN_ATTEMPTS = 500
+ODD_SIZES_SMALL = (5, 7)
+ODD_SIZES_MEDIUM = (5, 7, 9)
+ODD_SIZES_ALL = (5, 7, 9, 11)
