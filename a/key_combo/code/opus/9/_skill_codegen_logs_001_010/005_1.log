+def _bridge_endpoint_frame_ids(cell: tuple[int, int], frame_map: np.ndarray) -> set[int]:
+    h, w = frame_map.shape
+    out = set()
+    r, c = cell
+    for nr, nc in _neighbors4(r, c):
+        if 0 <= nr < h and 0 <= nc < w and frame_map[nr, nc] >= 0:
+            out.add(int(frame_map[nr, nc]))
+    return out
