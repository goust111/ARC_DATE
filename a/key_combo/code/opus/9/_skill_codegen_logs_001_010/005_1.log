+def _frame_from_center(center: tuple[int, int], size: int) -> dict:
+    cr, cc = center
+    half = size // 2
+    bbox = (cr - half, cc - half, cr + half, cc + half)
+    return {
+        "center": (int(cr), int(cc)),
+        "size": int(size),
+        "bbox": bbox,
+    }
+
