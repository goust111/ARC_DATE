+    return connectors[0]
+
+
+def _guide_neighbors(local: np.ndarray, r: int, c: int, color: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in PATH_STEPS:
+        rr = r + dr
+        cc = c + dc
+        if _in_bounds(local.shape, rr, cc) and int(local[rr, cc]) == color:
+            out.append((rr, cc))
