+CHECKER_PATTERNS = (
+    np.array(((ORANGE, BLACK, ORANGE), (BLACK, ORANGE, BLACK), (ORANGE, BLACK, ORANGE)), dtype=int),
+    np.array(((BLACK, ORANGE, BLACK), (ORANGE, BLACK, ORANGE), (BLACK, ORANGE, BLACK)), dtype=int),
+)
+
