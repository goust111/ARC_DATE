+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+NON_SPECIAL_COLORS = (1, 2, 3, 4, 6, 8, 9)
+QUADRANT_NAMES = ("lu", "ru", "lb", "rb")
+LAYER_ORDER = ("lb", "ru", "lu", "rb")
