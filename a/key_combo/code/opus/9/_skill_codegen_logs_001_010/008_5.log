+
+def _is_chain_path(path: list[tuple[int, int]]) -> bool:
+    path_set = set(path)
+    if len(path_set) != len(path):
+        return False
+    degrees = []
+    for r, c in path:
+        deg = sum((r + dr, c + dc) in path_set for dr, dc in PATH_STEPS)
+        if deg > 2:
+            return False
+        degrees.append(deg)
+    return degrees.count(1) == 2 and all(deg in {1, 2} for deg in degrees)
