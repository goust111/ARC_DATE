+
+    for _ in range(250):
+        checker_pos = random.choice(positions)
+        target_choices = [
+            pos
+            for pos in positions
+            if pos != checker_pos and _expanded_boxes_separate(pos, checker_pos, pad=1)
+        ]
+        if not target_choices:
