+PATH_STEPS = ((-2, 0), (2, 0), (0, -2), (0, 2))
+SIDE_TO_OFFSET = {
+    "U": (-1, 1),
+    "D": (3, 1),
+    "L": (1, -1),
+    "R": (1, 3),
+}
