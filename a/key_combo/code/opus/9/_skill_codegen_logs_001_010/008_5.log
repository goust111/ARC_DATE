+
+def _candidate_object_positions(q: int, row_parity: int, col_parity: int) -> list[tuple[int, int]]:
+    rows = [r for r in range(1, q - 2) if r % 2 == row_parity]
+    cols = [c for c in range(1, q - 2) if c % 2 == col_parity]
