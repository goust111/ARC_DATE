+
+def _follow_path(local: np.ndarray, start: tuple[int, int], color: int) -> tuple[int, int]:
+    seen = {start}
+    prev: tuple[int, int] | None = None
+    cur = start
+
+    while True:
+        nbrs = _guide_neighbors(local, cur[0], cur[1], color)
