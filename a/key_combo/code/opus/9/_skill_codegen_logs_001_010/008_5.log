+
+    quadrants = {
+        "lu": g[:mid_r, :mid_c],
+        "ru": g[:mid_r, mid_c + 1 :],
+        "lb": g[mid_r + 1 :, :mid_c],
+        "rb": g[mid_r + 1 :, mid_c + 1 :],
+    }
