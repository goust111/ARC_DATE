+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+NON_SPECIAL_COLORS = (1, 2, 3, 4, 6, 8, 9)
+QUADRANT_NAMES = ("lu", "ru", "lb", "rb")
+LAYER_ORDER = ("lb", "ru", "lu", "rb")
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+PATH_STEPS = ((-2, 0), (2, 0), (0, -2), (0, 2))
