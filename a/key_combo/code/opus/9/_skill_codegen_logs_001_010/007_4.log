    inp = mod._draw_scene(h,w,pairs)
    if len(mod.np.argwhere(inp == mod.RED)) < count:
        reasons['too_few_red'] += 1
        continue
    if not mod._validate_generated(inp):
        reasons['validate_fail'] += 1
        continue
    reasons['success'] += 1
print(reasons)
