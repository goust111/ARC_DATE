+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
