+                if val == line_color:
+                    right = cc
+                    break
+                if val not in (BLACK, RED):
+                    break
+            assert left is not None and right is not None and left < c < right
+            g[r, left + 1 : right] = line_color
+        else:
+            up = None
+            down = None
+            for rr in range(r - 1, -1, -1):
+                val = int(g[rr, c])
+                if val == line_color:
+                    up = rr
+                    break
+                if val not in (BLACK, RED):
