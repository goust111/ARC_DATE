+def _line_lookup(lines: list[dict]) -> dict[tuple[int, int], int]:
+    lookup: dict[tuple[int, int], int] = {}
+    for idx, comp in enumerate(lines):
+        for r, c in map(tuple, comp["coords"]):
+            lookup[(int(r), int(c))] = idx
+    return lookup
