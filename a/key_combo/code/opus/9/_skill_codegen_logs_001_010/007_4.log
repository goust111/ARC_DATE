+        for coords in _components_of_mask(grid == color):
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
