+
+def _apply_moves(repaired: np.ndarray, objects: list[dict], moves: dict[int, tuple[tuple[int, int], int, int]]) -> np.ndarray:
+    out = repaired.copy()
+    ordered = sorted(objects, key=lambda comp: (int(comp["bbox"][0]), int(comp["bbox"][1]), int(comp["color"])))
+    for obj in ordered:
+        color = int(obj["color"])
