  44:     for comp in components:
  45:         coords = comp["coords"]
  46:         assert _is_straight_bar(coords)
  47:         bars.append((int(comp["area"]), int(comp["color"])))
  48: 
  49:     lengths = [length for length, _ in bars]
  50:     assert len(lengths) == len(set(lengths))
  51: 
  52:     side = max(lengths)
  53:     assert len(bars) == (side + 1) // 2
  54: 
  55:     layers = sorted(bars, key=lambda bar: bar[0], reverse=True)
  56:     out = np.empty((side, side), dtype=int)
  57:     for layer, (_, color) in enumerate(layers):
  58:         out[layer : side - layer, layer : side - layer] = color
  59: 
  60:     return out
