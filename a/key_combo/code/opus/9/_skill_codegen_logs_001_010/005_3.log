+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+TEAL = 8
+
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 300
