+    cr, cc = center
+    pts = []
+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        pts.append((cr + dr, cc + dc))
+        if dc != 0:
+            pts.append((cr + dr, cc - dc))
+    return pts
+
