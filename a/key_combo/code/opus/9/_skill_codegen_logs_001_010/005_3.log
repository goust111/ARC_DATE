        b = bbox(obj != Color.BLACK)
        if b is None:
            continue
        r0, c0, r1, c1 = b
        sprite = crop_bbox(obj, b)

        # Identify the black hole(s) inside the grey object.
        hole_mask = (sprite == Color.BLACK) & object_interior(sprite, background=Color.BLACK)

        hb = bbox(hole_mask)
        if hb is not None:
