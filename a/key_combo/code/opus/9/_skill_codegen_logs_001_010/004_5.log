+
+def generate_input() -> np.ndarray:
+    for _ in range(RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ray-vote rectangle input")

