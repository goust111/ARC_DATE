+        votes.append(
+            {
+                "bbox": frame["bbox"],
+                "winner": int(winner),
+                "counts": counts,
+                "contributors": contributors,
+                "blockers": [(r, c) for r, c in blockers if r0 < r < r1 and c0 < c < c1],
