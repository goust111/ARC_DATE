+        pw = rng.randint(*PANEL_SIZE_RANGE)
+        r0 = rng.randint(1, h - ph - 2)
+        c0 = rng.randint(1, w - pw - 2)
+        box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
