+
+
+def _intended_chain_length(rng: random.Random, panel_count: int) -> int:
+    if panel_count == 2:
+        return 2
+    return 3 if rng.random() < 0.35 else 2
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(22, 28)
+    w = rng.randint(22, 28)
