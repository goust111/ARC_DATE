+    start: tuple[int, int],
+    visited: set[tuple[int, int]],
+    *,
+    monochromatic: bool,
+) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    sr, sc = start
+    start_val = int(grid[sr, sc])
+    q = deque([start])
+    visited.add(start)
