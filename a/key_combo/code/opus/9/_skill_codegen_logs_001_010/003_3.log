+    counts = _contact_counts(copy_coords, panels)
+    best = max(counts.values())
+    if best == 0:
+        return sprite_color, counts
+    side = next(side for side in SIDE_ORDER if counts[side] == best)
+    return SIDE_TO_COLOR[side], counts
