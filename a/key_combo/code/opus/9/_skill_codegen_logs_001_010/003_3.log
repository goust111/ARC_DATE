+BLACK = 0
+SIDE_TO_COLOR = {"top": 2, "bottom": 1, "left": 4, "right": 3}
+SIDE_ORDER = ("top", "bottom", "left", "right")
+PANEL_SIZE_RANGE = (6, 8)
+PANEL_COLORS = [5, 6, 7, 8, 9]
