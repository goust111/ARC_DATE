+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+SPRITE_COLOR_POOL = (1, RED, GREEN, YELLOW, PINK, ORANGE, TEAL)
