0077: def main(grid: np.ndarray) -> np.ndarray:
0078:     """
0079:     Complete each 2-by-2 lattice-cell quartet by adding its missing reflected sprite.
0080: 
0081:     Input structure:
0082:     - The background is the most common color.
0083:     - One non-background color forms complete horizontal and vertical divider
0084:       lines, partitioning the grid into rectangular cells.
0085:     - Every occupied cell away from the dividers contains pixels of exactly one
0086:       non-background, non-divider color.
0087:     - For each sprite color, occupied cells occur as connected three-cell groups
0088:       inside a 2-by-2 block of equal-sized cells.
0089: 
0090:     Rule:
0091:     - Split the grid at the divider rows and columns.
0092:     - For each three-cell monochrome group in a 2-by-2 cell block, find the one
0093:       empty cell in that block.
0094:     - Reflect each of the three present cell-local sprites vertically and/or
0095:       horizontally according to its relative position to the missing cell; all
0096:       three reflections must produce the same mask.
0097:     - Paint that agreed reflected sprite into the missing cell, leaving dividers
0098:       and all existing cells unchanged.
0099: 
0100:     Key insight:
0101:     - The sprites are mirror variants around the center of a 2-by-2 block of
0102:       lattice cells, so any three visible variants uniquely determine the fourth.
0103:     """
0104:     g = np.asarray(grid, dtype=int)
0105:     bg = get_bg(g)
0106:     divider, divider_rows, divider_cols = _divider_grid(g, bg)
0107:     row_ranges = _ranges_between(g.shape[0], divider_rows)
0108:     col_ranges = _ranges_between(g.shape[1], divider_cols)
0109:     assert len(row_ranges) >= 2 and len(col_ranges) >= 2, "expected at least one 2-by-2 cell block"
0110: 
0111:     cells = _cell_colors(g, row_ranges, col_ranges, bg, divider)
0112:     out = g.copy()
