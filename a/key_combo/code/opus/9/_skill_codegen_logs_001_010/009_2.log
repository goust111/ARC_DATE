0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """
0011:     Count the two upper quadrant control regions to size an output made from the lower quadrant pattern.
0012: 
0013:     Input structure:
0014:     - The grid is an even square split into four equal quadrants.
0015:     - Black is the background.
0016:     - The upper-left and upper-right quadrants are control regions.
0017:     - The lower-left quadrant is a color source tile; the lower-right quadrant is either a stencil tile or empty.
0018: 
0019:     Rule:
0020:     - Output height is the number of non-background pixels in the upper-left quadrant.
0021:     - Output width is the number of non-background pixels in the upper-right quadrant.
0022:     - If the lower-right stencil has foreground pixels, tile it over the output; each stencil background pixel is filled from the lower-left quadrant cell at the corresponding coarse tile position.
0023:     - If the lower-right stencil is empty, tile the lower-left quadrant directly over the output.
0024: 
0025:     Key insight:
0026:     - The top quadrants specify only dimensions, while the bottom quadrants specify a two-level repeated pattern: a fine stencil and coarse fill colors.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     assert g.ndim == 2
0030:     h, w = g.shape
0031:     assert h == w and h % 2 == 0 and w % 2 == 0
0032: 
0033:     bg = int(Color.BLACK)
0034:     qh, qw = h // 2, w // 2
0035:     upper_left = g[:qh, :qw]
0036:     upper_right = g[:qh, qw:]
0037:     fill_tile = g[qh:, :qw]
0038:     stencil = g[qh:, qw:]
0039: 
0040:     out_h = int(np.count_nonzero(upper_left != bg))
0041:     out_w = int(np.count_nonzero(upper_right != bg))
0042:     assert out_h > 0 and out_w > 0
0043: 
0044:     out = np.empty((out_h, out_w), dtype=int)
0045:     if not np.any(stencil != bg):
0046:         for r in range(out_h):
0047:             for c in range(out_w):
0048:                 value = int(fill_tile[r % qh, c % qw])
0049:                 assert value != bg
0050:                 out[r, c] = value
0051:         return out
0052: 
0053:     for r in range(out_h):
0054:         for c in range(out_w):
0055:             value = int(stencil[r % qh, c % qw])
0056:             if value == bg:
0057:                 fill_r = r // qh
0058:                 fill_c = c // qw
0059:                 assert fill_r < qh and fill_c < qw
0060:                 value = int(fill_tile[fill_r, fill_c])
0061:                 assert value != bg
0062:             out[r, c] = value
0063: 
0064:     return out
0065: 
