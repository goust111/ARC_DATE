0114:     for color in colors_present(g, exclude={bg, divider}):
0115:         for comp in components_mask(cells == color, connectivity=4):
0116:             assert comp.shape[0] == 3, "each sprite-color group must contain three occupied cells"
0117:             group_r0, group_c0 = map(int, comp.min(axis=0))
0118:             group_r1, group_c1 = map(int, comp.max(axis=0))
0119:             assert group_r1 - group_r0 == 1 and group_c1 - group_c0 == 1, (
0120:                 "each sprite-color group must fit one 2-by-2 cell block"
0121:             )
0122: 
0123:             block = {
0124:                 (r, c)
0125:                 for r in (group_r0, group_r1)
0126:                 for c in (group_c0, group_c1)
0127:             }
0128:             have = {(int(r), int(c)) for r, c in comp}
0129:             missing_cells = block - have
0130:             assert len(missing_cells) == 1, "expected one missing cell in the 2-by-2 block"
0131:             missing = next(iter(missing_cells))
0132:             missing_r, missing_c = missing
0133:             assert cells[missing_r, missing_c] == -1, "missing quartet cell must be empty"
0134: 
0135:             heights = {row_ranges[r][1] - row_ranges[r][0] + 1 for r, _ in block}
0136:             widths = {col_ranges[c][1] - col_ranges[c][0] + 1 for _, c in block}
0137:             assert len(heights) == 1 and len(widths) == 1, "quartet cells must be equal-sized"
0138: 
0139:             pred = _reflected_to_missing(g, row_ranges, col_ranges, have, missing)
0140:             assert set(map(int, pred.ravel())) <= {bg, int(color)}, (
0141:                 "reflected sprite must contain only background and its color"
0142:             )
