0080:     r_size, c_size = np.random.randint(6, m-6), np.random.randint(6, n-6)
0081: 
0082:     quadrants = [ grid[:r_size, :c_size],
0083:                   grid[:r_size, c_size:],
0084:                   grid[r_size:, :c_size],
0085:                   grid[r_size:, c_size:] ]
0086:     unique_quadrant = random.choice(quadrants)
0087:     for quadrant in quadrants:
0088:         target_color = popular_color if quadrant is not unique_quadrant else unique_color
0089:         # fill a random 70% of the quadrant with the target color
0090:         for i in range(quadrant.shape[0]):
0091:             for j in range(quadrant.shape[1]):
0092:                 if random.random() < 0.7:
0093:                     quadrant[i, j] = target_color
0094:         
0095:     # add black separators
0096:     separator_width, separator_height = np.random.randint(2, 4), np.random.randint(2, 4)
0097:     grid[r_size:r_size+separator_width, :] = Color.BLACK
0098:     grid[:, c_size:c_size+separator_height] = Color.BLACK
0099: 
0100:     return grid

