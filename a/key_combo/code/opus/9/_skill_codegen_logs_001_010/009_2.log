0014: def main(input_grid: np.ndarray) -> np.ndarray:
0015:     """
0016:     Extract the only quadrant whose foreground color differs from the other three.
0017: 
0018:     Input structure:
0019:     - The input is split into four black-separated quadrants.
0020:     - Each quadrant contains sparse pixels of exactly one non-black color.
0021:     - Three quadrants share one color and one quadrant has a unique color.
0022: 
0023:     Rule:
0024:     - Locate the first all-black separator row and column.
0025:     - Compare the non-black color present in each quadrant.
0026:     - Return the cropped contents of the uniquely colored quadrant.
0027: 
0028:     Key insight:
0029:     - The common-color quadrants are distractors; the answer is the outlier quadrant cropped down
0030:       to its non-black extent.
0031:     """
0032:     # break the input up into quadrants
0033:     # remember they are different sizes, but they are all separated by at least 2 rows/columns of black
0034:     # we do this by computing the x, y coordinates of separators
0035:     for i in range(input_grid.shape[0]):
0036:         if np.all(input_grid[i, :] == Color.BLACK):
0037:             r_separator = i
0038:             break
0039:     for i in range(input_grid.shape[1]):
0040:         if np.all(input_grid[:, i] == Color.BLACK):
0041:             c_separator = i
0042:             break
0043:     
0044:     quadrants = [ input_grid[:r_separator, :c_separator],
0045:                   input_grid[:r_separator, c_separator:],
0046:                   input_grid[r_separator:, :c_separator],
0047:                   input_grid[r_separator:, c_separator:] ]
0048:     
0049:     # check that each of them is monochromatic (only one color that isn't black)
0050:     colors = [ np.unique(quadrant[quadrant != Color.BLACK]) for quadrant in quadrants ]
0051:     for color in colors:
0052:         assert len(color) == 1, "Quadrant has more than one color"
0053: 
0054:     for color, quadrant in zip(colors, quadrants):
0055:         color_frequency = sum(other_color == color for other_color in colors)
0056:         if color_frequency == 1:
0057:             output_grid = quadrant
0058: 
0059:             # we have to crop the output grid to remove any extraneous black rows/columns
0060:             _b = bbox(output_grid != Color.BLACK)
0061:             assert _b is not None
0062:             output_grid = crop_bbox(output_grid, _b)
0063: 
0064:             break
0065: 
0066:     return output_grid
0067: 
0068: 
