+        return {"tip": tuple(map(int, tip[0])), "axis": "col", "line": int(tip[0, 1]), "cross": [(outer_row, c) for c in cols], "step": (1, 0)}
+    if side == "left":
+        tip = coords[coords[:, 1] == coords[:, 1].max()]
+        if tip.shape[0] != 1:
+            raise AssertionError("left object must have a unique inward tip")
