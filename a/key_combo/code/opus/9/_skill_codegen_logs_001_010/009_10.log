+                np.array([[1, 1], [0, 1], [1, 1], [0, 1]], dtype=bool),
+                np.array([[1, 0], [1, 1], [0, 1], [1, 1]], dtype=bool),
+            ]
+        )
+    if side % 3 == 0:
