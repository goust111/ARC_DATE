+    color = int(patch[0, 0])
+    window = out[rr0:rr1, cc0:cc1]
+    assert np.all((window == int(bg)) | (window == color)), "tiling bars must not conflict"
+    paste(out, patch, int(r0), int(c0), clip=True)
