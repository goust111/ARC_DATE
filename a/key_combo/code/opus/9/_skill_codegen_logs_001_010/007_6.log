        np.arange(SEGMENT_LENGTH_MIN, side), size=num_segments - 1, replace=False
    ).astype(int).tolist()
    lengths = [side, *shorter_lengths]
    perm = np.random.permutation(num_segments)
    return [(int(lengths[i]), int(colors[i])) for i in perm]


