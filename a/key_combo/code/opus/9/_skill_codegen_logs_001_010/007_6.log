def _gen_layered_output(side: int, bars: list[tuple[int, int]]) -> np.ndarray:
    out = np.empty((side, side), dtype=int)
    for layer, (_, color) in enumerate(sorted(bars, key=lambda bar: bar[0], reverse=True)):
