+def _extract_markers(grid: np.ndarray, seed: dict) -> dict[tuple[int, int], int]:
+    markers: dict[tuple[int, int], int] = {}
+    seed_cells = {tuple(map(int, rc)) for rc in seed["coords"]}
+    for r, c in np.argwhere(grid != int(Color.BLACK)):
