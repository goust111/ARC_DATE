+def _stamp_solid(out: np.ndarray, patch: np.ndarray, r0: int, c0: int, bg: int) -> None:
+    h, w = map(int, patch.shape)
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(out.shape[0], int(r0) + h)
+    cc1 = min(out.shape[1], int(c0) + w)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return
