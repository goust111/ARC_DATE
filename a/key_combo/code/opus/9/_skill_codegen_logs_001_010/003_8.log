+    assert total >= 4
+    occupied_count = rng.randint(3, total - 1)
+
+    allowed_map = {point: _allowed_dirs(point, lower_shape, red_cells) for point in points}
+    for _ in range(200):
+        chosen = rng.sample(points, occupied_count)
