+def _analyze_input(grid: np.ndarray) -> dict:
+    sep = _find_separator_row(grid)
+    top = grid[:sep, :]
+    lower = grid[sep + 1 :, :]
+    sprite = _extract_sprite(top)
+    anchor, sv, sh = _period_markers(lower)
+    points = _placement_points(lower.shape, anchor, sv, sh)
