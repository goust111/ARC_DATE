+    else:
+        main_h = last_r + sprite_h + rng.randint(0, 2)
+    if clip_col:
+        main_w = rng.randint(last_c + 1, last_c + sprite_w - 1)
+    else:
+        main_w = last_c + sprite_w + rng.randint(0, 2)
