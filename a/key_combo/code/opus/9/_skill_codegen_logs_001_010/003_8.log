+def _companion_rotation(lower: np.ndarray, point: tuple[int, int]) -> int | None:
+    r, c = map(int, point)
+    found = []
+    for rotation, (dr, dc) in enumerate(DIRS):
+        nr, nc = r + dr, c + dc
