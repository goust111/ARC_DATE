def _has_enclosed_bg_hole(region: np.ndarray, color: int, bg: int) -> bool:
    assert np.all((region == color) | (region == bg)), "object bbox must contain only object and background colors"

    border = np.zeros(region.shape, dtype=bool)
    border[0, :] = True
