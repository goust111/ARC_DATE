+      whose mirrored marker coincides with another sprite's marker, so the marker
+      acts as a gate on whether the mirrored copy becomes visible.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
