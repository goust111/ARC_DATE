+
+
+def _touching_or_overlapping(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    if a & b:
+        return True
+    for r, c in a:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (r + dr, c + dc) in b:
