+def _fg_neighbors(mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (dr, dc)
+        for dr, dc in DIRS4
+        if in_bounds(mask.shape, r + dr, c + dc) and bool(mask[r + dr, c + dc])
+    ]
