+
+def _gen_attempt() -> np.ndarray | None:
+    frame_h = int(_GEN_RNG.integers(_GEN_FRAME_MIN, _GEN_FRAME_MAX + 1))
+    frame_w = int(_GEN_RNG.integers(_GEN_FRAME_MIN, _GEN_FRAME_MAX + 1))
+    inner_h, inner_w = frame_h - 2, frame_w - 2
+    rect_h, rect_w = _GEN_RECT_SIZES[int(_GEN_RNG.integers(len(_GEN_RECT_SIZES)))]
+    if rect_h > inner_h - 2 or rect_w > inner_w - 2:
+        return None
+
+    vertical = [("top", pos) for pos in range(1, rect_w - 1)] + [("bottom", pos) for pos in range(1, rect_w - 1)]
+    horizontal = [("left", pos) for pos in range(1, rect_h - 1)] + [("right", pos) for pos in range(1, rect_h - 1)]
+    all_features = vertical + horizontal
+    all_axes = {_feature_axis(side, pos) for side, pos in all_features}
+    if len(all_axes) < 4:
+        return None
+
+    n_tabs = int(_GEN_RNG.integers(2, 4))
+    n_notches = int(_GEN_RNG.integers(2, 4))
+    if n_tabs + n_notches > len(all_axes):
+        return None
+
+    axes = list(all_axes)
+    _GEN_RNG.shuffle(axes)
+    tab_axes = axes[:n_tabs]
+    notch_axes = axes[n_tabs : n_tabs + n_notches]
+    if not any(axis[0] == "col" for axis in tab_axes + notch_axes):
+        return None
+    if not any(axis[0] == "row" for axis in tab_axes + notch_axes):
+        return None
+
+    tabs: list[tuple[str, int]] = []
+    notches: list[tuple[str, int]] = []
+    for axis_kind, pos in tab_axes:
+        side = ("top", "bottom")[int(_GEN_RNG.integers(2))] if axis_kind == "col" else ("left", "right")[int(_GEN_RNG.integers(2))]
+        tabs.append((side, pos))
+    for axis_kind, pos in notch_axes:
+        side = ("top", "bottom")[int(_GEN_RNG.integers(2))] if axis_kind == "col" else ("left", "right")[int(_GEN_RNG.integers(2))]
+        notches.append((side, pos))
+
+    top_margin = 2 if any(side == "top" for side, _ in tabs) else 1
+    bottom_margin = 2 if any(side == "bottom" for side, _ in tabs) else 1
+    left_margin = 2 if any(side == "left" for side, _ in tabs) else 1
+    right_margin = 2 if any(side == "right" for side, _ in tabs) else 1
+
+    top_min = top_margin
+    top_max = inner_h - bottom_margin - rect_h
+    left_min = left_margin
+    left_max = inner_w - right_margin - rect_w
+    if top_min > top_max or left_min > left_max:
+        return None
+
+    top = int(_GEN_RNG.integers(top_min, top_max + 1))
+    left = int(_GEN_RNG.integers(left_min, left_max + 1))
+    crop = _apply_feature_layout(inner_h, inner_w, rect_h, rect_w, tabs, notches, top, left)
+
+    if not (15 <= int(np.count_nonzero(crop == BLUE)) <= 25):
+        return None
+    if np.any(crop[0] == BLUE) or np.any(crop[-1] == BLUE) or np.any(crop[:, 0] == BLUE) or np.any(crop[:, -1] == BLUE):
+        return None
+    if not _valid_component(crop):
+        return None
+
+    mask = crop == BLUE
+    detected_tabs = _collect_tabs(mask)
+    tab_cells = {cell for cell, _direction, _target in detected_tabs}
+    detected_notches = _collect_notches(mask, tab_cells)
+    expected_tab_cells = {_source_cell(side, pos, top, left, rect_h, rect_w, "tab") for side, pos in tabs}
+    expected_notch_cells = {_source_cell(side, pos, top, left, rect_h, rect_w, "notch") for side, pos in notches}
+    if {cell for cell, _direction, _target in detected_tabs} != expected_tab_cells:
+        return None
+    if {cell for cell, _direction, _target in detected_notches} != expected_notch_cells:
+        return None
+
+    expected = _expected_from_layout(crop, rect_h, rect_w, tabs, notches, top, left)
+    recolored = np.where(crop != BLACK, RED, BLACK)
+    if int(np.count_nonzero(expected != recolored)) != len(tabs) + len(notches):
+        return None
+
+    grid = _build_grid(crop)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for ARC task 4")

