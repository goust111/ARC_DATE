BLUE = Color.BLUE
RED = Color.RED
GREY = Color.GREY
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

_GEN_RNG = np.random.default_rng()
_GEN_ATTEMPTS = 500
_GEN_CANVAS_MIN = 13
_GEN_CANVAS_MAX = 18
_SAFE_LAYOUTS = (
