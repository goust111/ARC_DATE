    (8, 8, 2, 2, (("top", 1), ("left", 1)), (("bottom", 2), ("left", 2))),
    (8, 8, 2, 2, (("top", 1), ("left", 1)), (("bottom", 2), ("right", 2))),
    (8, 8, 2, 1, (("top", 1), ("right", 1)), (("top", 2), ("left", 2))),
