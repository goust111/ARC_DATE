+SHAPES_BY_AREA = _shape_library()
+AREA_PATTERNS_2 = ((2, 3), (2, 4), (3, 4))
+AREA_PATTERNS_3 = ((2, 3, 3), (2, 4, 4), (3, 4, 4), (2, 3, 4))
