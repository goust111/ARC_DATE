+    return True
+
+
+def _render_blocks(shape: tuple[int, int], specs: list[dict]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    for spec in specs:
+        r0, c0, _r1, _c1 = spec["bbox"]
+        paste(grid, spec["block_patch"], int(r0), int(c0))
