+    return {
+        "id": index,
+        "key": _canonical_key(base_shape),
+        "color": int(color),
+        "area": area,
+        "block_patch": patch,
+        "template_mask": template_mask,
+        "expanded_h": block_h + 2 * area,
+        "expanded_w": block_w + 2 * area,
+    }
