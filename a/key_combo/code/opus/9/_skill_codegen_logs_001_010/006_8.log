+def _place_expanded_boxes(shape: tuple[int, int], specs: list[dict]) -> bool:
+    canvas = np.zeros(shape, dtype=int)
+    order = sorted(specs, key=lambda spec: spec["expanded_h"] * spec["expanded_w"], reverse=True)
