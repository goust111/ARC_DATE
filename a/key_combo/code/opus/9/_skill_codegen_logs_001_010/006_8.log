+    rel = coords - np.array([r0, c0])
+    mask = np.zeros((int(r1 - r0 + 1), int(c1 - c0 + 1)), dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _extract_blocks(grid: np.ndarray) -> list[dict]:
