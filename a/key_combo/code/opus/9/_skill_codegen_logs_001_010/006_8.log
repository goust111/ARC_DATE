+
+def _sample_base_shapes(count: int) -> list[np.ndarray]:
+    if count == 2:
+        areas = random.choice(AREA_PATTERNS_2)
+    else:
+        areas = random.choice(AREA_PATTERNS_3)
+
+    selected: list[np.ndarray] = []
