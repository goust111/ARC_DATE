+            distances.append((dist, template["id"]))
+        distances.sort()
+        min_dist = distances[0][0]
+        nearest_ids = [idx for dist, idx in distances if dist == min_dist]
+        if len(nearest_ids) != 1 or nearest_ids[0] != spec["id"]:
