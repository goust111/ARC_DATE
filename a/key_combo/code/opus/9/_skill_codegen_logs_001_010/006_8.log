+    for area in areas:
+        candidates = [shape for shape in SHAPES_BY_AREA[area] if _canonical_key(shape) not in used]
+        choice = random.choice(candidates).copy()
+        used.add(_canonical_key(choice))
+        selected.append(choice)
+    random.shuffle(selected)
+    return selected
