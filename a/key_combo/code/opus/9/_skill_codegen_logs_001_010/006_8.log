+    for spec in specs:
+        block = {"bbox": spec["bbox"], "patch": spec["block_patch"], "key": spec["key"]}
+        template = {"color": spec["color"], "area": spec["area"], "key": spec["key"]}
+        matches.append((block, template))
+    return _render_output(shape, matches, BG)
