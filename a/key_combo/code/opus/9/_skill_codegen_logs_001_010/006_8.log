+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    blocks = _extract_blocks(g)
+    templates = _extract_templates(g, bg)
+    matches = _match_blocks_to_templates(blocks, templates)
+    return _render_output(g.shape, matches, bg)
