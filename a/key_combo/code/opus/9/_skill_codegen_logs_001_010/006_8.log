+            except ValueError:
+                ok = False
+                break
+            paste(grid, patch, r0, c0, transparent=BG)
+            placed.append(
+                {
+                    "id": spec["id"],
+                    "key": spec["key"],
+                    "color": spec["color"],
+                    "area": spec["area"],
+                    "bbox": (int(r0), int(c0), int(r0 + mask.shape[0] - 1), int(c0 + mask.shape[1] - 1)),
