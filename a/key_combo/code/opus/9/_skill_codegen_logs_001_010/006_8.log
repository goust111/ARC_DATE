+    for spec in order:
+        patch = np.full((spec["expanded_h"], spec["expanded_w"]), 9, dtype=int)
+        try:
+            er0, ec0 = random_free_location(canvas, patch, transparent=BG, border=1, padding=1, padding_connectivity=8)
+        except ValueError:
+            return False
+        paste(canvas, patch, er0, ec0)
