+    center, l_markers = _l_group(dst_corner, sprite_bbox)
+    singleton = _outside_corner(src_corner, _corners_from_bbox(sprite_bbox)[src_corner])
+    cells = {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
