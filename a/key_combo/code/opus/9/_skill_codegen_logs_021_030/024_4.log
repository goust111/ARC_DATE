+        top, left, _bottom, _right = _scaled_bbox(obj["bbox"], actual_scale)
+        _paste(out, scaled, top, left, clip=True)
+        centers.append((obj["center"], obj["marker_color"]))
+    for (r, c), color in centers:
+        if 0 <= r < h and 0 <= c < w:
+            out[r, c] = color
