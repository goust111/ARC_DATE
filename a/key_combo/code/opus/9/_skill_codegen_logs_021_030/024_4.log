spec:
  grid: square, odd side length 2k+1 where k=1-4, so 3-9
  layout: |
    Row 0..k-1: source region (k rows)
    Row k:      separator row (single uniform color)
    Row k+1..2k: result region (k rows, uniform background)
  separator: single color filling entire row; always 5 [observed]
  background: single color filling result region; always 0 [observed]
  source_region:
    colors: 2-8 distinct colors, none equal to separator or background color
    majority: exactly one color has strictly highest count
    pixel_fill: every cell filled with a non-bg non-sep color (no blanks)
  transform:
    action: paint bottom-center cell (row 2k, col k) with majority color
    all other cells unchanged

generation_strategy:
  approach: direct construction (task is simple enough)
  steps:
    1. pick k in 1-4, set grid size to (2k+1) x (2k+1)
    2. choose sep_color (5 observed) and bg_color (0 observed); they must differ
    3. pick n_colors in 2-8 from palette excluding sep_color and bg_color
    4. fill source region (k x (2k+1) pixels) randomly from chosen colors,
       ensuring exactly one color has strictly the highest count (e.g. boost
       one color by +1 if tied)
    5. fill separator row with sep_color
    6. fill result region with bg_color
    7. output = copy input, set cell (2k, k) to the majority color
