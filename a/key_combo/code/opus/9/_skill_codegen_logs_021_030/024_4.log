+                "patch": patch,
+                "src_corner": src_corner,
+                "dst_corner": dst_corner,
+                "marker_color": marker_colors[idx],
+                "occupied_input": _occupied_cells_for_input(chosen, src_corner, dst_corner),
+                "center": _l_group(dst_corner, chosen)[0],
