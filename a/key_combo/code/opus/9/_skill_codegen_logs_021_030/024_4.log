+        if want_clip:
+            edge_bias = []
+            interior = []
+            for bbox in bbox_candidates:
+                raw = _scaled_bbox(bbox, scale)
+                if _clip_bbox(raw, (h, w)) != raw:
+                    edge_bias.append(bbox)
+                else:
