+    new_cells = _occupied_cells_for_input(new_bbox, src_corner, dst_corner)
+    new_visible_out = _clip_bbox(_scaled_bbox(new_bbox, scale), shape)
+    new_center, _ = _l_group(dst_corner, new_bbox)
