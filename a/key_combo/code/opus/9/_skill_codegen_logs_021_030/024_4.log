+def _scaled_bbox(sprite_bbox: tuple[int, int, int, int], scale: int) -> tuple[int, int, int, int]:
+    r0, c0, _r1, _c1 = sprite_bbox
+    center_r = r0 + 1
+    center_c = c0 + 1
+    side = SPRITE_SIZE * scale
+    top = center_r - side // 2
+    left = center_c - side // 2
+    return top, left, top + side - 1, left + side - 1
