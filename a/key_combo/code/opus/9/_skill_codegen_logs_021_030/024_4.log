+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(dh, r0 + h)
+    cc1 = min(dw, c0 + w)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return
+    pr0 = rr0 - r0
+    pc0 = cc0 - c0
+    dst[rr0:rr1, cc0:cc1] = patch[pr0 : pr0 + (rr1 - rr0), pc0 : pc0 + (cc1 - cc0)]
