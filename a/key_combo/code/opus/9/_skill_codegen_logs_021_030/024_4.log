+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            colors: set[int] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                colors.add(int(grid[rr, cc]))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(
+                {
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                    "colors": colors,
+                }
+            )
+    return components
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, clip: bool = False) -> None:
+    h, w = patch.shape
+    dh, dw = dst.shape
+    if not clip:
+        if r0 < 0 or c0 < 0 or r0 + h > dh or c0 + w > dw:
+            raise ValueError("patch out of bounds")
+        dst[r0 : r0 + h, c0 : c0 + w] = patch
+        return
+
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(dh, r0 + h)
+    cc1 = min(dw, c0 + w)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return
+    pr0 = rr0 - r0
+    pc0 = cc0 - c0
+    dst[rr0:rr1, cc0:cc1] = patch[pr0 : pr0 + (rr1 - rr0), pc0 : pc0 + (cc1 - cc0)]
+
+
+def _corners_from_bbox(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    return {
+        "NW": (r0, c0),
+        "NE": (r0, c1),
+        "SW": (r1, c0),
+        "SE": (r1, c1),
+    }
