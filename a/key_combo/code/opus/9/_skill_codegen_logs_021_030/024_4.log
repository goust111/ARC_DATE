+                        {
+                            "bbox": bbox,
+                            "patch": sprite["patch"],
+                            "src_corner": src_corner,
+                            "dst_corner": dst_corner,
+                            "marker_color": marker_color,
+                            "marker_coords": set([singleton, *l_markers]),
