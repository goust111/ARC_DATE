+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SPRITE_SIZE = 3
+SPRITE_AREA = 9
+SPRITE_COLORS_PER_OBJECT = 2
+CORNERS = ("NW", "NE", "SW", "SE")
+OUTWARD = {
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SW": (1, -1),
+    "SE": (1, 1),
+}
+ROTATED_CORNER = {
+    0: {"NW": "NW", "NE": "NE", "SW": "SW", "SE": "SE"},
+    1: {"NW": "SW", "NE": "NW", "SW": "SE", "SE": "NE"},
+    2: {"NW": "SE", "NE": "SW", "SW": "NE", "SE": "NW"},
+    3: {"NW": "NE", "NE": "SE", "SW": "NW", "SE": "SW"},
+}
+SPRITE_PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+GEN_RETRIES = 400
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            colors: set[int] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                colors.add(int(grid[rr, cc]))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(
+                {
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                    "colors": colors,
+                }
+            )
+    return components
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, clip: bool = False) -> None:
+    h, w = patch.shape
+    dh, dw = dst.shape
