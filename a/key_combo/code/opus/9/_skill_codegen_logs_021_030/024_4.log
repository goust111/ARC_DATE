+def _clip_bbox(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> tuple[int, int, int, int] | None:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(h - 1, r1)
+    cc1 = min(w - 1, c1)
+    if rr0 > rr1 or cc0 > cc1:
+        return None
+    return rr0, cc0, rr1, cc1
