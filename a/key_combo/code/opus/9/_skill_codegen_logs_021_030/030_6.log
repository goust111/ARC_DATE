                    cc = int(np.random.randint(0, cw))
                    if int(region[rr, cc]) != int(bg):
                        region[rr, cc] = int(pal[int(np.random.randint(0, len(pal)))])

            g[int(r0) : int(r0 + rh), int(c0) : int(c0 + cw)] = region
            c0 += int(cw) + 1
        r0 += int(rh) + 1

    return g


