+BG = 0
+YELLOW = 4
+GREY = 5
+NON_SPECIAL_COLORS = [1, 2, 3, 6, 7, 8, 9]
+BAR_INTERIOR_HEIGHT = 3
+BAR_INTERIOR_WIDTH = 5
+FRAME_HEIGHT = BAR_INTERIOR_HEIGHT + 2
+FRAME_WIDTH = BAR_INTERIOR_WIDTH + 2
+MAX_GENERATION_ATTEMPTS = 500
