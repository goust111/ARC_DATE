+    for _ in range(total):
+        placed = False
+        random.shuffle(candidate_cells)
+        for r, c in candidate_cells:
+            if grid[r, c] != BG:
+                continue
+            isolated = True
+            for nr in range(r - 1, r + 2):
+                for nc in range(c - 1, c + 2):
+                    if 0 <= nr < upper_h and 0 <= nc < w and (nr, nc) in occupied:
+                        isolated = False
+                        break
+                if not isolated:
+                    break
+            if not isolated:
+                continue
+            grid[r, c] = random.choice(colors)
+            occupied.add((r, c))
