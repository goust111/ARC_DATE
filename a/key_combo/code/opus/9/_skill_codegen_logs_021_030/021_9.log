+def _first_appearance_order(grid: np.ndarray, top_limit: int) -> list[int]:
+    seen: set[int] = set()
+    order: list[int] = []
+    for r in range(top_limit):
+        for c in range(grid.shape[1]):
+            color = int(grid[r, c])
+            if color in (BG, YELLOW, GREY) or color in seen:
