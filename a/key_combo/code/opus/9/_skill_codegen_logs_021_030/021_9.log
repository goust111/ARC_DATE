+    slot_rows, slot_cols = random.choice(choices)
+    upper_h = random.randint(max(10, 4 * slot_rows), min(18, 4 * slot_rows + 3))
+    width = random.randint(max(14, 4 * slot_cols), min(24, 4 * slot_cols + 3))
