+            break
+        if not placed:
+            return
+
+
+def _build_chart(
+    grid: np.ndarray,
+    colors: list[int],
+    thresholds: dict[int, int],
+    upper_h: int,
+    frame_top: int,
+    frame_left: int,
+) -> None:
+    assert frame_top >= upper_h + 2
+    assert frame_top + FRAME_HEIGHT <= grid.shape[0]
+    assert 0 <= frame_left <= grid.shape[1] - FRAME_WIDTH
