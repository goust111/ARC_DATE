    def rec(chosen, pos):
        if len(chosen) == count:
            out.append(chosen[:])
            return
        for i in range(pos, len(intervals)):
            start, end = intervals[i]
            if chosen and start - (chosen[-1][1] + 1) < GEN_NOTCH_INTERVAL_GAP:
                continue
            chosen.append((start, end))

