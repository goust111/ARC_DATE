+    choices = list(range(start, end + 1))
+    return min(choices, key=lambda v: (abs(v - ctr0) + abs(v - ctr1), v))
+
+
+def _bridge_cells_between(frame_a: dict, frame_b: dict) -> tuple[set[tuple[int, int]], str]:
