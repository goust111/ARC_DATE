+    kept.sort(key=lambda marker: marker["center"][1])
+    erased = [marker for marker in markers if int(marker["color"]) not in valid_colors]
+    return {
+        "frames": frames,
+        "markers": markers,
+        "counts": counts,
+        "valid_colors": valid_colors,
+        "kept_markers": kept,
+        "erased_markers": erased,
+        "frame_by_color": frame_by_color,
