        else:
            grid[r, c] = int(arm_assignments[np.random.randint(len(arm_assignments))])


def _gen_passes_oracle(grid, answer):
    expected = np.array([[answer]], dtype=int)
    try:
        return np.array_equal(main(grid), expected)
    except AssertionError:
        return False


