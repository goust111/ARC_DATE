+
+
+def _find_markers(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    markers: list[dict] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if int(g[r, c]) != YELLOW:
+                continue
+            arms = [int(g[r - 1, c]), int(g[r + 1, c]), int(g[r, c - 1]), int(g[r, c + 1])]
+            if len(set(arms)) != 1:
