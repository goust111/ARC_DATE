+            if patch.shape != (3, 3):
+                continue
+            border = patch.copy()
+            border[1, 1] = FRAME
+            inner = int(patch[1, 1])
+            if inner in (BACKGROUND, YELLOW, FRAME):
+                continue
+            if np.all(border == FRAME):
+                center = (r0 + 1, c0 + 1)
+                if center in seen_centers:
