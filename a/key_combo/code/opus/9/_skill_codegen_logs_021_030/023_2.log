+    tail_output_cells: set[tuple[int, int]] = set()
+
+    for cc in range(endpoint_col, hinge_col + step, step):
+        cell = (row, cc)
+        fixed_cells.add(cell)
+        input_colors[cell] = ROD
+        output_colors[cell] = ROD
