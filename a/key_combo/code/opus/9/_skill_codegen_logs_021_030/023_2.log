+def _simulate_path(
+    folded: np.ndarray,
+    owner_map: dict[tuple[int, int], tuple[int, str]],
+    segments: dict[tuple[int, str], tuple[tuple[int, int], ...]],
+    kind_override: dict[tuple[int, int], str] | None = None,
