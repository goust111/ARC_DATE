+        orientation="v",
+        endpoint=(endpoint_row, col),
+        hinge=(hinge_row, col),
+        input_colors=input_colors,
+        output_colors=output_colors,
+        fixed_cells=frozenset(fixed_cells),
+        tail_input_cells=frozenset(tail_input_cells),
+        tail_output_cells=frozenset(tail_output_cells),
+        hit_kind=hit_kind,
+        tie_fold=tie_fold,
