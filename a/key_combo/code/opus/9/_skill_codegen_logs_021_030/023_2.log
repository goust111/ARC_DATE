+def _add_segment(cells: set[tuple[int, int]], a: tuple[int, int], b: tuple[int, int]) -> None:
+    if a[0] == b[0]:
+        step = 1 if b[1] >= a[1] else -1
+        for cc in range(a[1], b[1] + step, step):
+            cells.add((a[0], cc))
+    else:
+        step = 1 if b[0] >= a[0] else -1
+        for rr in range(a[0], b[0] + step, step):
+            cells.add((rr, a[1]))
