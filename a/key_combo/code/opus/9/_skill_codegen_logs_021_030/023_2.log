+    out = g.copy()
+    starts = np.argwhere(g == PATH)
+    assert starts.shape == (1, 2), "expected one red border marker"
+    r, c = map(int, starts[0])
+    h, w = g.shape
+    if r == 0:
+        dr, dc = 1, 0
+    elif r == h - 1:
+        dr, dc = -1, 0
+    elif c == 0:
+        dr, dc = 0, 1
+    elif c == w - 1:
+        dr, dc = 0, -1
+    else:
+        raise AssertionError("marker must lie on the border")
+
+    hit_kinds: list[str] = []
+    hit_rods: list[int] = []
+
+    def paint(rr: int, cc: int) -> None:
+        if int(out[rr, cc]) == BG:
+            out[rr, cc] = PATH
+
+    paint(r, c)
+    while True:
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(g.shape, nr, nc):
+            break
+        if (nr, nc) not in owner_map:
+            r, c = nr, nc
+            paint(r, c)
+            continue
