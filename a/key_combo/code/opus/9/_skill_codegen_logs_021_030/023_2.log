+                "orientation": orientation,
+                "endpoint": endpoint,
+                "hinge": hinge,
+                "fixed_cells": tuple(fixed_cells),
+                "tail_input_cells": tuple(tail_input_cells),
+                "tail_output_cells": tuple(tail_output_cells),
+            }
+        )
