+        paint(r, c)
+        while _projection(r, c, dr, dc) < target_proj:
+            r += dr
+            c += dc
+            assert _in_bounds(g.shape, r, c), "detour forward step left the grid"
+            paint(r, c)
+        r -= lateral[0]
+        c -= lateral[1]
+        assert _in_bounds(g.shape, r, c), "detour must be able to return"
+        paint(r, c)
