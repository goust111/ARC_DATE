+import numpy as np
+
+
+BG = 0
+PATH = 2
+ROD = 3
+END = 5
+HINGE = 7
+
+FIXED = "fixed"
+TAIL = "tail"
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
