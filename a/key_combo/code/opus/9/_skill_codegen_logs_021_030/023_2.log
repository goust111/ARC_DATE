+
+
+def _apply_rods(shape: tuple[int, int], rods: list[RodSpec], lane: int) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.full(shape, BG, dtype=int)
+    out = np.full(shape, BG, dtype=int)
