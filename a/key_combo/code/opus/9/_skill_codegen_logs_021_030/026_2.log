+        if not any(np.array_equal(rot, old) for old in rots):
+            rots.append(rot)
+    return rots
+
+
+def _shape_preserves_blue_connectivity(mask: np.ndarray) -> bool:
+    local_blue = ~mask
+    if not local_blue.any():
+        return True
+    h, w = mask.shape
+    for comp in _components(local_blue):
+        touches_outer_blue = (
+            np.any(comp[:, 0] == 0)
+            or np.any(comp[:, 1] == 0)
+            or np.any(comp[:, 1] == w - 1)
