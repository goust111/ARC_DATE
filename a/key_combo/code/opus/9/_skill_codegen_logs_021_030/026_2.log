+def _boundary_cells(mask: np.ndarray, direction: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    dr, dc = direction
+    cells = []
+    for r, c in np.argwhere(mask):
+        nr = int(r) + dr
+        nc = int(c) + dc
