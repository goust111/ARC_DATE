+        patch = np.zeros((bh + rod_len, bw), dtype=int)
+        patch[rod_len:, :] = body_mask.astype(int) * GREY
+        ar, ac = attach
+        for k in range(rod_len):
+            patch[rod_len - 1 - k, ac] = GREY
+    elif rod_dir == (1, 0):
+        patch = np.zeros((bh + rod_len, bw), dtype=int)
+        patch[:bh, :] = body_mask.astype(int) * GREY
