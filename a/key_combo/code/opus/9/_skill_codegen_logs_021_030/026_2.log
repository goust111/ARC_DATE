+    h, w = mask.shape
+    for comp in _components(local_blue):
+        touches_outer_blue = (
+            np.any(comp[:, 0] == 0)
+            or np.any(comp[:, 1] == 0)
+            or np.any(comp[:, 1] == w - 1)
