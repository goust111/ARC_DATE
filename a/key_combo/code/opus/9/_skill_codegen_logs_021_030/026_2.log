+        for k in range(rod_len):
+            patch[bh + k, ac] = GREY
+    elif rod_dir == (0, -1):
+        patch = np.zeros((bh, bw + rod_len), dtype=int)
+        patch[:, rod_len:] = body_mask.astype(int) * GREY
+        ar, ac = attach
+        for k in range(rod_len):
+            patch[ar, rod_len - 1 - k] = GREY
+    else:
+        patch = np.zeros((bh, bw + rod_len), dtype=int)
+        patch[:, :bw] = body_mask.astype(int) * GREY
