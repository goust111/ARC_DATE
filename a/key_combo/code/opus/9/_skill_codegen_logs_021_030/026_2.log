+            }
+        )
+        candidates.append(
+            {
+                "coords": coords,
+                "body_mask": parsed["body_mask"],
+                "rotation_q": parsed["rotation_q"],
+                "direction": parsed["direction"],
+                "directed_match": directed_match,
+                "any_rotation_matches": any_rotation_matches,
