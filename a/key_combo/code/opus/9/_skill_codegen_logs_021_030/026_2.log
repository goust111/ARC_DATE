+    grid = np.zeros((h, w), dtype=int)
+    grid[top : top + band_h, left : left + band_w] = BLUE
+
+    x = left + side_margin
+    pocket_boxes = []
+    for idx, mask in enumerate(shapes):
+        ph, pw = mask.shape
+        r0 = top + band_h - ph
+        c0 = x
+        coords = np.argwhere(mask)
+        for rr, cc in coords:
+            grid[r0 + rr, c0 + cc] = BLACK
