+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_TO_ROT = {
+    (-1, 0): 0,   # up
+    (0, 1): 1,    # right
+    (1, 0): 2,    # down
