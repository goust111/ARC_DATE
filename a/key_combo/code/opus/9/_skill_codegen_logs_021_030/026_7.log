  grid: 29x29 (input and output same size)
  output_pattern:
    description: 2D periodic color field tiling the grid, no black pixels
    lattice_vectors: two oblique generators v1 (shorter) and v2 (longer)
    v1_norm: 2.8-6.7 (strictly shortest lattice vector)
    v2_norm: 4.5-9.0 (strictly longer than v1)
    tile_area: 12-54 (|det(v1,v2)|)
    n_colors: 5-7 (non-black, drawn from 1-9)
    each equivalence class under v1 alone has exactly one color
  black_mask:
    description: 2-4 connected black blobs erasing parts of the periodic pattern
    total_coverage: 7-13% of pixels
    n_components: 2-4 (4-connected)
