+    def key(p: tuple[int, int]) -> tuple[float, float, int, int]:
+        r, c = p
+        angle = math.atan2(-(r - cr), c - cc) % (2.0 * math.pi)
+        radius = (r - cr) ** 2 + (c - cc) ** 2
+        return (angle, radius, r, c)
