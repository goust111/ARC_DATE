+    for threshold in distances:
+        seen = [False] * len(points)
+        comps: list[list[tuple[int, int]]] = []
+        for i in range(len(points)):
+            if seen[i]:
+                continue
+            stack = [i]
+            seen[i] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cur = stack.pop()
+                comp.append(points[cur])
+                for j in range(len(points)):
