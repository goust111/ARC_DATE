+        [(2, 4), (1, 3), (1, 1), (2, 0), (3, 1), (3, 3)],
+    ]
+
+
+def _paint_points(shape: tuple[int, int], coords: list[tuple[int, int]]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    for r, c in coords:
+        grid[int(r), int(c)] = RED
