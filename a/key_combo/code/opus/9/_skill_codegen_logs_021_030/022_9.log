+def _ordered_pixels(pixels: list[dict[str, int]], *, reverse_distance: bool = False) -> list[dict[str, int]]:
+    side_rank = {-1: 0, 1: 1}
+    return sorted(
+        pixels,
+        key=lambda pixel: (
+            -pixel["dist"] if reverse_distance else pixel["dist"],
+            side_rank[pixel["side"]],
+            pixel["col"],
+            pixel["row"],
+            pixel["color"],
+        ),
+    )
