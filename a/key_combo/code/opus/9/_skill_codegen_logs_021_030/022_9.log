+    pixels: list[dict[str, int]] = []
+    coords = np.argwhere((grid != BG) & (grid != BAR))
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        side = -1 if rr < bar_row else 1
+        assert rr != bar_row, "colored pixels cannot lie on the bar row"
+        pixels.append(
+            {
+                "row": rr,
+                "col": cc,
+                "color": int(grid[rr, cc]),
+                "side": side,
+                "dist": abs(rr - bar_row) - 1,
+            }
+        )
+    return pixels
+
