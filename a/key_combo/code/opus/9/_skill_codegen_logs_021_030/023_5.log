+    colors = [int(color) for color in np.unique(grid) if int(color) != BG]
+    raw: set[tuple[int, int, int, int, int]] = set()
+
+    for color in colors:
+        ps = _prefix_sum(grid == color)
+        for r0 in range(h):
+            for c0 in range(w):
+                if int(grid[r0, c0]) != color:
+                    continue
+                for r1 in range(r0 + 2, h):
