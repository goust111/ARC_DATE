    if edge == "top":
        cells = [(0, c) for c in range(w)]
    elif edge == "bottom":
        cells = [(h - 1, c) for c in range(w)]
    elif edge == "left":
        cells = [(r, 0) for r in range(h)]
    else:
        cells = [(r, w - 1) for r in range(h)]
    cells = [p for p in cells if p != forbidden]
    return random.choice(cells)


