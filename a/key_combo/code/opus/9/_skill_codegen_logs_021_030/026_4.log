+            grid[r0 : r0 + rh, c0 : c0 + rw] = rect["patch"]
+
+        expected = _expected_output(rects, positions)
+        columns = {tuple(expected[:, col]) for col in range(expected.shape[1])}
+        if len(columns) != expected.shape[1]:
