+    out = np.full((max_layers, len(ordered)), bg, dtype=int)
+    for col, rect in enumerate(ordered):
+        for offset, color in enumerate(reversed(rect["layers"])):
+            out[max_layers - 1 - offset, col] = int(color)
+    return out
+
+
