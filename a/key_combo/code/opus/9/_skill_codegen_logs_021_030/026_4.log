+
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+BACKGROUND = 0
+GRID_MIN = 18
+GRID_MAX = 28
+RECT_COUNT_RANGE = (3, 5)
+LAYER_COUNT_RANGE = (2, 5)
+MAX_GENERATION_ATTEMPTS = 500
