+            "colors": colors,
+            "layers": list(colors),
+            "thicknesses": tuple(thicknesses),
+            "inner_shape": (inner_h, inner_w),
+            "patch": rect,
+            "shape": rect.shape,
+        }
+    return None
+
+
+def _choose_layer_counts(n_rects: int) -> list[int]:
+    while True:
+        counts = [random.randint(*LAYER_COUNT_RANGE) for _ in range(n_rects)]
+        if len(set(counts)) >= 2:
+            return counts
+
+
