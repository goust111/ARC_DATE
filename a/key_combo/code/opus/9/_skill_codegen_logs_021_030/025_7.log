def _gen_chamber_has_marker(grid, rows, cols, color, wall_rows_set, wall_cols_set):
    for c in cols:
        for r in (rows[0] - 1, rows[-1] + 1):
            if (r in wall_rows_set) ^ (c in wall_cols_set):
                if 0 <= r < GRID_SIZE and 0 <= c < GRID_SIZE and int(grid[r, c]) == color:
                    return True
