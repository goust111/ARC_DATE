+    col_span = int(rng.choice(col_span_options))
+    return row_span, col_span
+
+
+def _column_slots(line_rows: list[int], line_col_left: int, line_col_right: int) -> list[list[tuple[int, int]]]:
+    slots: list[list[tuple[int, int]]] = []
