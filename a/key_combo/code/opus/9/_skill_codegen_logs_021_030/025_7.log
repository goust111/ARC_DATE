        if target[i][col_idx] != target[i][col_idx + 1]:
            continue
        color = target[i][col_idx]
        for r in rows:
            out.append((r, wall_cols[col_idx], color))
    random.shuffle(out)
    return out


def _gen_place_from_candidates(grid, candidates, count, wall_rows_set, wall_cols_set, row_counts, col_counts):
    placed = 0
