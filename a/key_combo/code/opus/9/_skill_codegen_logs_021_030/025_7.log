spec:
  grid: 20-27 rows x 22-24 cols
  output: 1x1 grid containing the answer color
  background: single solid color filling 60-73% of grid; any color except 0 (black) and 4 (yellow)
  markers:
    count: 3-6 yellow-centered plus signs (5 pixels each)
    structure: center pixel is yellow (4); 4 orthogonal arms share one color
    arm_colors: each marker has a unique or repeated non-bg, non-yellow, non-black arm color
    constraint: exactly one arm color appears on exactly 2 markers; all others appear once
    placement: center at least 1 cell from grid edge; min Chebyshev distance between centers >=5
  noise:
    density: 24-34% of grid cells are non-bg noise pixels
    primary_color: black (0) dominates noise (70-100% of noise pixels)
    secondary: arm colors may also appear scattered in noise [observed]
    connectivity: mostly clustered (70-80% of noise pixels have at least one noise neighbor)
  colors_used: 4-8 distinct colors total including bg, yellow, black, and arm colors

