+
+
+def _line_positions(n_lines: int) -> list[int]:
+    return [2 + LINE_STEP * i for i in range(n_lines)]
+
+
+def _sample_spans(rng: np.random.Generator, n_h_lines: int, n_v_lines: int) -> tuple[int, int]:
