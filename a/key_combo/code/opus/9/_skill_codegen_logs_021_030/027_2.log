+                weights.append(1 + int(touch_count))
+            chosen = random.choices(candidates, weights=weights, k=1)[0]
+            mask[chosen] = True
+        if int(mask.sum()) != area:
+            continue
+        tight = _tight_mask(mask)
+        if tight.shape[0] > 4 or tight.shape[1] > 4:
