+    assert len({r1 - r0 + 1 for r0, r1 in row_runs}) == 1, "tile rows must be equal height"
+    assert len({c1 - c0 + 1 for c0, c1 in col_runs}) == 1, "tile cols must be equal width"
+    assert {r1 - r0 + 1 for r0, r1 in row_runs} == {TILE_SIZE}
