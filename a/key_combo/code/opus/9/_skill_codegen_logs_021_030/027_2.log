+def _tile_bounds(tile_index: int) -> tuple[int, int]:
+    tile_r, tile_c = divmod(tile_index, 3)
+    return tile_r * (TILE_SIZE + 1), tile_c * (TILE_SIZE + 1)
+
+
+def _render_input_from_plan(
