+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+SHAPE_COLORS = (1, 2, 3, 4, 5)
+MARKER_COLORS = (7, 8, 9)
+TILE_SIZE = 5
+GRID_SIZE = 17
+DIVIDERS = (5, 11)
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+CLASS_SIZE_OPTIONS = {
+    2: ((4, 5),),
