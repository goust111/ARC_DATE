+    masks: list[np.ndarray] = []
+    signatures: set[tuple[str, ...]] = set()
+    for area in area_plan:
+        for _ in range(200):
+            candidate = _random_connected_mask(area)
+            if candidate is None:
+                continue
+            signature = _shape_signature(candidate)
+            if signature in signatures:
