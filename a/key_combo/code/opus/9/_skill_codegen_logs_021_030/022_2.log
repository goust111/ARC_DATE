+    rotated_legend = legend[1:] + legend[:1]
+    alt = grid.copy()
+    alt[0, : len(legend)] = np.array(rotated_legend, dtype=int)
+    alt_out = main(alt)
+    if not np.any(alt_out[1:] != out[1:]):
