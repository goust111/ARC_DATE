    picked, remaining = [], candidates[:]
    random.shuffle(remaining)
    while len(picked) < count:
        valid = [
            (r, c)
            for r, c in remaining
            if all(max(abs(r - rr), abs(c - cc)) >= MIN_SCATTER_CHEBYSHEV for rr, cc in occupied)
