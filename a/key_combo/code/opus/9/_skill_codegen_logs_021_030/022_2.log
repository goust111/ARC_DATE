        if not valid:
            return None
        cell = random.choice(valid)
        picked.append(cell)
        occupied.add(cell)
        remaining = [
            (r, c)
            for r, c in remaining
            if (r, c) != cell and max(abs(r - cell[0]), abs(c - cell[1])) >= MIN_SCATTER_CHEBYSHEV
