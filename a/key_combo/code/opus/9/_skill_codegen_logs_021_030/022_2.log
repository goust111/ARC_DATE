+    base_grid: np.ndarray,
+    legend: list[int],
+    seed: tuple[int, int],
+    blockers: set[tuple[int, int]],
+) -> np.ndarray:
+    out = np.asarray(base_grid, dtype=int).copy()
+    legend_len = len(legend)
+    for step_index, r, c, inside in _spiral_steps(out.shape, seed):
+        if not inside:
