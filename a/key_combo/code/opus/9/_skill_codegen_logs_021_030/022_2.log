+    return grid if _passes_semantic_checks(grid) else None
+
+
+def _passes_semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        legend = _parse_legend(grid)
+        seed = _seed_coord(grid)
+        blockers = _blockers(grid)
+    except AssertionError:
+        return False
