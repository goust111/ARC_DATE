+    output_gray = _components(out == GREY)
+    if len(output_gray) != 2:
+        return False
+
+    anchor_masks = []
+    for anchor in anchors:
+        mask = np.zeros(inp.shape, dtype=bool)
+        for r, c in anchor["coords_set"]:
+            mask[r, c] = True
+        anchor_masks.append(mask)
