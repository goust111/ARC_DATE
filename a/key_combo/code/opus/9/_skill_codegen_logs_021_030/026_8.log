+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        h = random.randint(17, 22)
+        w = random.randint(17, 22)
+        anchors = _place_anchors(h, w)
+        if anchors is None:
+            continue
