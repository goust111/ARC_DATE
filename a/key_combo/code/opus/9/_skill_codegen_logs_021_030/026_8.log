+def _slider_candidate(
+    anchor_idx: int,
+    anchor: dict,
+    anchors: list[dict],
+    input_gray: set[tuple[int, int]],
+    output_gray: set[tuple[int, int]],
+    h: int,
+    w: int,
+) -> list[dict]:
+    r0, c0, r1, c1 = anchor["bbox"]
+    candidates = []
+    for bh, bw in BODY_SIZES:
+        for length in range(2, 6):
+            for side in SIDES:
