+def _render_input(h: int, w: int, anchors: list[dict], sliders: list[dict]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for anchor in anchors:
+        r0, c0, r1, c1 = anchor["bbox"]
+        grid[r0 : r1 + 1, c0 : c1 + 1] = anchor["patch"]
