+def _boundary_color(rect: np.ndarray, top: int, bottom: int, left: int, right: int) -> int:
+    parts = [
+        rect[top, left:right],
+        rect[bottom - 1, left:right],
+        rect[top + 1 : bottom - 1, left],
+        rect[top + 1 : bottom - 1, right - 1],
+    ]
