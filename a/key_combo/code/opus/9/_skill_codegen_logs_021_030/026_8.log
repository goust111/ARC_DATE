+                            body_out = {(rr, cc) for rr in range(out_r, out_r + bh) for cc in range(out_c, out_c + bw)}
+                            stem = {(rr, attach_c) for rr in range(out_r, out_r + length)}
+                            far_end = (out_r, attach_c)
+                            candidates.append(
+                                {
+                                    "side": side,
+                                    "length": length,
+                                    "body_in": body_in,
+                                    "body_out": body_out,
+                                    "stem": stem,
+                                    "far_end": far_end,
+                                }
+                            )
