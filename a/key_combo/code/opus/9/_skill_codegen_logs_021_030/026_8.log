+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ANCHOR_COLORS = (1, 2, 3, 4, 6, 7)
+BODY_SIZES = ((2, 2), (2, 3))
+SIDES = ("left", "right", "top", "bottom")
+MAX_GEN_ATTEMPTS = 500
