+    unique_rows = sorted(set(map(int, rows)))
+    unique_cols = sorted(set(map(int, cols)))
+
+    if len(unique_rows) == 1:
+        row = unique_rows[0]
+        cs = sorted(map(int, cols))
+        assert cs == list(range(cs[0], cs[-1] + 1))
+        assert r0 <= row <= r1
+        if cs[-1] < c0:
+            return 0, -1, c0 - cs[0], (row, cs[0])
