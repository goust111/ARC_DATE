+    r, c = sr, sc
+    path: list[tuple[int, int]] = []
+    for _ in range(min(row_dist, col_dist)):
+        r += step_r
+        c += step_c
+        path.append((r, c))
+    if row_dist > col_dist:
+        for _ in range(row_dist - col_dist):
+            r += step_r
+            path.append((r, c))
+    else:
+        for _ in range(col_dist - row_dist):
+            c += step_c
+            path.append((r, c))
+    assert path and path[-1] == end
+    return path
+
