+    if not np.all(local_grid[r0 - 1, c0 : c1 + 1] == GREY):
+        return None
+    if not np.all(local_grid[r1 + 1, c0 : c1 + 1] == GREY):
+        return None
+    if not np.all(local_grid[r0 : r1 + 1, c0 - 1] == GREY):
+        return None
+    if not np.all(local_grid[r0 : r1 + 1, c1 + 1] == GREY):
+        return None
