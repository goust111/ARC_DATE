+        rr, cc = random.choice(candidates)
+        grid[rr : rr + ph, cc : cc + pw] = patch
+        occupied[rr : rr + ph, cc : cc + pw] = True
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
