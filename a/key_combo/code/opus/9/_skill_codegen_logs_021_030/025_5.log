+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+BODY_COLORS = (BLUE, RED, GREEN)
+SIZE_OPTIONS = (
+    (2, 3),
+    (3, 2),
