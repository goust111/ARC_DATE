+def _chebyshev_path(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc = start
+    er, ec = end
+    step_r = _sign(er - sr)
+    step_c = _sign(ec - sc)
+    row_dist = abs(er - sr)
+    col_dist = abs(ec - sc)
