+
+def _parse_grid(grid: np.ndarray) -> tuple[tuple[int, int, int, int], list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    grey_coords = np.argwhere(g == GREY)
+    assert grey_coords.size > 0, "template frame missing"
