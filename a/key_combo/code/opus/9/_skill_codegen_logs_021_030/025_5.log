+
+    outside_mask = (g != BLACK) & (g != GREY)
+    outside_mask[r0 : r1 + 1, c0 : c1 + 1] = False
+    sprites: list[dict] = []
+    for comp in _components(outside_mask, connectivity=4):
+        sr0, sc0, sr1, sc1 = _bbox(comp)
