+            row_max = h - ph - 1
+            col_min = c1 + 2
+            col_max = w - pw - 1
+        else:
+            row_min = r1 + 2
+            row_max = h - ph - 1
+            col_min = 1
+            col_max = w - pw - 1
+        if row_min > row_max or col_min > col_max:
+            return False
+
+        candidates: list[tuple[int, int]] = []
+        for rr in range(row_min, row_max + 1):
+            for cc in range(col_min, col_max + 1):
+                rr0 = max(0, rr - 1)
+                cc0 = max(0, cc - 1)
+                rr1 = min(h, rr + ph + 1)
+                cc1 = min(w, cc + pw + 1)
+                if occupied[rr0:rr1, cc0:cc1].any():
