+    corr1 = c0 + corridor[1]
+    grid[r0 : r1 + 1, corr0 : corr1 + 1] = BLACK
+    for cavity in cavities_local:
+        cr0, cc0, cr1, cc1 = cavity["bbox"]
+        grid[r0 + cr0 : r0 + cr1 + 1, c0 + cc0 : c0 + cc1 + 1] = BLACK
