+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in deltas:
+                    nr = rr + dr
+                    nc = cc + dc
