+                mask_a = masks[a]
+                mask_b = masks[b]
+                if not np.array_equal(mask_a | mask_b, dst_mask):
+                    continue
+                if not (np.any(mask_a & ~mask_b) and np.any(mask_b & ~mask_a)):
