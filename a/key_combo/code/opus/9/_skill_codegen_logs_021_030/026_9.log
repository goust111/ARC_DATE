+def _find_union_candidates(masks: list[np.ndarray]) -> list[tuple[int, int, int]]:
+    candidates: list[tuple[int, int, int]] = []
+    for dst, dst_mask in enumerate(masks):
+        for a in range(len(masks)):
+            if a == dst:
+                continue
+            for b in range(a + 1, len(masks)):
+                if b == dst:
