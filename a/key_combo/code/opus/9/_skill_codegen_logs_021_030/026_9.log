+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+CELL = 4
+CELL_GAP = 1
+ARRAY_ROWS = 2
+ARRAY_COLS = 3
+ARRAY_H = ARRAY_ROWS * CELL + (ARRAY_ROWS - 1) * CELL_GAP
+ARRAY_W = ARRAY_COLS * CELL + (ARRAY_COLS - 1) * CELL_GAP
+TOP_CELL_ORIGINS = (
+    (0, 0),
+    (0, 5),
+    (0, 10),
+    (5, 0),
+    (5, 5),
+    (5, 10),
+)
+
+GEN_RETRY_LIMIT = 400
