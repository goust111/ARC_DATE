def _gen_masks_are_valid(masks: list[np.ndarray]) -> bool:
    counts = [int(np.sum(mask)) for mask in masks]
    if any(count < _GEN_MIN_PIXELS or count > _GEN_MAX_PIXELS for count in counts):
