+            return False
+
+        actual = main(inp)
+        return np.array_equal(actual, expected)
+    except Exception:
+        return False
+
+
+def _generate_case(rng: np.random.Generator) -> np.ndarray | None:
+    mask_pack = _make_mask_assignment(rng)
+    if mask_pack is None:
+        return None
+    masks_by_pos, meta = mask_pack
+
+    for _ in range(120):
