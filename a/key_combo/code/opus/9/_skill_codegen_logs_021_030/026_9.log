+
+        candidates = _find_union_candidates(parsed_masks)
+        selected = _select_union_candidate(candidates)
+        if selected != (int(meta["a_idx"]), int(meta["b_idx"]), int(meta["d_idx"])):
+            return False
+
+        if bool(meta["duplicate_branch"]):
+            if len(candidates) != 2:
+                return False
+        else:
+            if len(candidates) != 1:
