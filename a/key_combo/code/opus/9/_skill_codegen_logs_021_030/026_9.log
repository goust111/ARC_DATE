+        top_cols = _active_runs(np.any(inp == RED, axis=0))
+        d_r = top_rows[0][0] + TOP_CELL_ORIGINS[d_idx][0]
+        d_c = top_cols[0][0] + TOP_CELL_ORIGINS[d_idx][1]
+        if not np.all(expected[d_r : d_r + CELL, d_c : d_c + CELL][masks_by_pos[d_idx]] == YELLOW):
+            return False
