+CELL_GAP = 1
+ARRAY_ROWS = 2
+ARRAY_COLS = 3
+ARRAY_H = ARRAY_ROWS * CELL + (ARRAY_ROWS - 1) * CELL_GAP
+ARRAY_W = ARRAY_COLS * CELL + (ARRAY_COLS - 1) * CELL_GAP
