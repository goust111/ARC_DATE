+def _render_cell(tile: np.ndarray, corner: str) -> np.ndarray:
+    out = np.rot90(tile, CORNER_TO_ROT90[corner]).copy()
+    mark_r, mark_c = _corner_coord(corner, out.shape[0])
+    out[mark_r, mark_c] = MARK
