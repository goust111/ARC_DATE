+
+
+def _scenery_candidates(
+    forbidden: np.ndarray,
+    lane: int,
+    preferred_rows: set[int],
+) -> tuple[list[tuple[int, int, int]], list[tuple[int, int, int]]]:
+    h, w = forbidden.shape
+    preferred: list[tuple[int, int, int]] = []
+    others: list[tuple[int, int, int]] = []
