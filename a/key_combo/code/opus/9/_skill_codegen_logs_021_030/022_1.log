+        "records": records,
+        "visited": visited,
+        "visited_order": visited_order,
+        "inbounds_path": inbounds_path,
+        "inbounds_to_record": inbounds_to_record,
+        "stop_cell": stop_cell,
+        "components": comps,
+        "touched": touched,
