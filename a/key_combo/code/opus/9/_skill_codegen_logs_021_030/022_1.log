+        if len(picked) == count:
+            return picked
+    return None
+
+
+def _pick_anchor_roles(
+    prefix: list[tuple[int, int]],
+    suffix: list[tuple[int, int]],
+    reach_count: int,
+    unreach_count: int,
+    *,
+    tie_mode: bool,
+) -> dict | None:
+    usable_prefix = [p for p in prefix if _edge_distance((prefix[-1][0] * 0 + len(prefix), len(prefix)), p) >= 0]
+    del usable_prefix  # silence lint in py_compile-free environment
+    return None
+
+
+def _grow_component(
+    shape: tuple[int, int],
+    anchor: tuple[int, int],
+    area: int,
+    blocked: set[tuple[int, int]],
+    banned_path_cells: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    if anchor in blocked:
+        return None
+
+    for radius in (3, 4, 5):
+        for _ in range(60):
+            cells = {anchor}
+            while len(cells) < area:
