+
+def _place_components(
+    grid: np.ndarray,
+    path_cells: list[tuple[int, int]],
+    specs: list[dict],
+    reserved: set[tuple[int, int]],
+) -> list[dict] | None:
+    colors = random.sample(COMPONENT_COLORS, len(specs))
+    banned_path_all = set(path_cells)
+    placed: list[dict] = []
+    blocked = set(reserved)
