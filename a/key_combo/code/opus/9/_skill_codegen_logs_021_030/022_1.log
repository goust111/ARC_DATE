+def _build_component_specs(
+    prefix: list[tuple[int, int]],
+    suffix: list[tuple[int, int]],
+    shape: tuple[int, int],
+    reach_count: int,
+    unreach_count: int,
+    tie_mode: bool,
+) -> list[dict] | None:
