+
+
+def _select_component(components: list[dict]) -> dict:
+    return min(
+        components,
+        key=lambda comp: (
+            -int(comp["area"]),
+            int(comp["bbox"][1]),
+            int(comp["bbox"][0]),
+        ),
+    )
+
+
+def _analyze_grid(grid: np.ndarray, *, stop_on_obstacle: bool) -> dict:
