+        chosen_prefix = [early_anchor, winning_anchor]
+        remaining_prefix = [p for p in usable_prefix if p not in chosen_prefix]
+        if reach_count > 2:
+            extra = _pick_separated_positions(
+                remaining_prefix,
+                reach_count - 2,
+                min_chebyshev=4,
+                banned=set(chosen_prefix),
