+    left_mask = (category_grid == 1) | (category_grid == 3)
+    right_mask = (category_grid == 2) | (category_grid == 3)
+
+    grid = np.zeros(INPUT_SHAPE, dtype=int)
+    grid[:, :PANEL_SIZE][left_mask] = BLUE
+    grid[:, PANEL_SIZE:][right_mask] = RED
+    return grid
+
