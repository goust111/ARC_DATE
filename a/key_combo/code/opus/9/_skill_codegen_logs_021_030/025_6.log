+    assert int(overlap.sum()) >= 1
+    assert 3 <= int(union_mask.sum()) <= 6
+    assert not np.array_equal(union_mask, left_mask)
+    assert not np.array_equal(union_mask, right_mask)
+    return left_mask, right_mask
