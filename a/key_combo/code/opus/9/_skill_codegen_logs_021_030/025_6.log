+
+            block = np.zeros((PANEL_SIZE, PANEL_SIZE), dtype=int)
+            block[union_mask] = category
+            rr = r * PANEL_SIZE
+            cc = c * PANEL_SIZE
+            expected[rr : rr + PANEL_SIZE, cc : cc + PANEL_SIZE] = block
+
+    union_count = int(union_mask.sum())
