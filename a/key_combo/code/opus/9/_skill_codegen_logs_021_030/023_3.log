+    return False
+
+
+def _compatible_with_chosen(
+    cand: dict,
+    chosen: list[dict],
+    *,
+    allow_share: bool,
+) -> bool:
+    union_pink = set().union(*(entry["pink"] for entry in chosen)) if chosen else set()
+    union_yellow = set().union(*(entry["yellow"] for entry in chosen)) if chosen else set()
+
+    if cand["yellow"] & union_yellow:
+        return False
+    if cand["yellow"] & union_pink:
+        return False
+    if cand["pink"] & union_yellow:
+        return False
+
+    shared = cand["pink"] & union_pink
+    if shared:
+        if not allow_share or len(shared) != 1:
+            return False
+        if _pink_touches(cand["pink"] - shared, union_pink - shared):
+            return False
+    else:
+        if _pink_touches(cand["pink"], union_pink):
+            return False
+    return True
+
+
+def _choose_placements(candidates: list[dict], count: int, want_clip: bool, want_share: bool) -> list[dict] | None:
+    def search(chosen: list[dict], clip_done: bool, share_done: bool) -> list[dict] | None:
+        if len(chosen) == count:
+            return chosen if clip_done and share_done else None
+
+        need_clip_now = want_clip and not clip_done
+        need_share_now = want_share and not share_done and len(chosen) >= 1
+
+        pool = candidates[:]
+        random.shuffle(pool)
+        pool.sort(
+            key=lambda cand: (
+                0 if need_share_now and bool(cand["pink"] & set().union(*(e["pink"] for e in chosen))) else 1,
+                0 if need_clip_now and cand["clipped"] else 1,
+                random.random(),
+            )
+        )
+
+        for cand in pool:
+            if any(cand["key"] == entry["key"] for entry in chosen):
+                continue
