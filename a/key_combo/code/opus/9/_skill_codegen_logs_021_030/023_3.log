+    for placement in placements:
+        for r, c in placement["pink"]:
+            inp[r, split + c] = PINK
+
+    expected_out = _paint_expected_right(inp, variants, placements)
+    if not _validate_semantics(inp, template, placements, expected_out):
+        return None
+    return inp
+
