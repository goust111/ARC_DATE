+
+    all_pink = set().union(*(entry["pink"] for entry in placements))
+    if {tuple(map(int, rc)) for rc in np.argwhere(inp[:, split:] == PINK)} != all_pink:
+        return False
+
+    all_yellow = [entry["yellow"] for entry in placements]
