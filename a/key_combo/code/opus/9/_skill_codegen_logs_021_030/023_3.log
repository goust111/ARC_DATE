+        top = placement["top"]
+        left = placement["left"]
+        for r, c in _cells_of_color(variants[vid], YELLOW):
+            rr = top + r
+            cc = left + c
+            if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1] - split and int(out[rr, split + cc]) == BLACK:
