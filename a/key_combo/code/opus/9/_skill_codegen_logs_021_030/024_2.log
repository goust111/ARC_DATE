        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)
        descriptors.append(
            {
                "kind": "multi",
                "width": width,
                "height": height,
                "bar_row": random.randint(0, height - ADJACENT_ROW_OFFSET),
                "spine_col": random.randrange(width),
