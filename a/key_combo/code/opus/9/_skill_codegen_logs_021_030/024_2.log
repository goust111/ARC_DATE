+        if desc["kind"] == "single":
+            out[divider_r, int(desc["landed_tl"][1])] = BG
+    final_order = _ordered_ids(descs, "landed_tl")
+    color_map = _color_map_from_order(final_order)
+    for desc in descs:
+        color = color_map[int(desc["id"])]
+        coords = desc["landed_coords"]
+        out[coords[:, 0], coords[:, 1]] = color
+    return out
