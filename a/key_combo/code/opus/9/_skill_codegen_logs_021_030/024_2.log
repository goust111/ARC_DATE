+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SPRITE = 1
+RED = 2
+GREY = 5
+DIVIDER = 7
+TEAL = 8
+CYCLE = (RED, TEAL, GREY)
+
+MAX_ATTEMPTS = 500
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _unique_widest_row(coords: np.ndarray) -> int:
+    best_width = -1
+    best_row = -1
+    seen_best = False
+    for row in sorted(set(map(int, coords[:, 0]))):
+        cols = np.sort(coords[coords[:, 0] == row, 1])
+        if cols.size > 1:
+            expected = np.arange(int(cols[0]), int(cols[-1]) + 1)
+            assert np.array_equal(cols, expected), "each occupied row must form one contiguous segment"
+        width = int(cols.size)
+        if width > best_width:
+            best_width = width
+            best_row = int(row)
+            seen_best = False
+        elif width == best_width:
+            seen_best = True
+    assert best_width > 1, "multi-column sprites must have a widest row longer than 1"
+    assert not seen_best, "multi-column sprites must have a unique widest row"
+    return best_row
+
