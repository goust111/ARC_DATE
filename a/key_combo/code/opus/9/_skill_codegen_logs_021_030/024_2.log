+    grid = np.full((h, w), BG, dtype=int)
+    grid[divider_r, :] = DIVIDER
+    for desc in descs:
+        coords = desc["orig_coords"]
+        grid[coords[:, 0], coords[:, 1]] = SPRITE
+    return grid
+
+
+def _render_expected_output(h: int, w: int, divider_r: int, descs: list[dict]) -> np.ndarray:
