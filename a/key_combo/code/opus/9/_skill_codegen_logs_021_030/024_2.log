+        return False
+    if len(set(map(tuple, [d["landed_tl"] for d in descs]))) != len(descs):
+        return False
+
+    actual = main(inp)
+    return bool(np.array_equal(actual, expected) and not np.array_equal(inp, expected))
+
+
+def _gen_attempt(final_direction: str) -> np.ndarray | None:
