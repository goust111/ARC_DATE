+            shift = divider_r - 1 - widest_r
+        moved = coords.copy()
+        moved[:, 0] += shift
+        assert moved[:, 0].min() >= 0 and moved[:, 0].max() < h
+        assert moved[:, 1].min() >= 0 and moved[:, 1].max() < w
