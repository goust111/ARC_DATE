+    else:
+        ordered = sorted(landed, key=lambda item: (item["tl"][0], item["tl"][1], item["id"]))
+
+    for i, item in enumerate(ordered):
+        color = int(CYCLE[i % len(CYCLE)])
+        coords = item["coords"]
+        out[coords[:, 0], coords[:, 1]] = color
