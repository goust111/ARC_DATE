+        if lr1 >= divider_r - 1:
+            return False
+        width = lc1 - lc0 + 1
+        widths.append(width)
+        if width == 1:
+            single_count += 1
+        else:
+            multi_count += 1
+        if np.any(desc["landed_coords"][:, 0] >= divider_r):
+            crossed_divider += 1
