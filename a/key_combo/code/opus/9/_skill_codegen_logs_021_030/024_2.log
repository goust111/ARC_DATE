+            starts.append(c)
+            c += width
+            if i < len(widths) - 1:
+                c += 1
+        return starts
+
+    gaps = _composition(extra, len(widths) + 1)
+    starts = []
+    c = gaps[0]
+    for i, width in enumerate(widths):
+        starts.append(c)
+        c += width
+        if i < len(widths) - 1:
+            c += 1 + gaps[i + 1]
+    return starts
+
