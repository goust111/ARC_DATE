+    area = int(local.shape[0])
+    assert 3 <= area <= 8
+    return {
+        "id": sprite_id,
+        "kind": "multi",
+        "height": height,
+        "width": width,
+        "bar_row": bar_row,
+        "spine_col": spine_col,
+        "local": local,
+    }
+
