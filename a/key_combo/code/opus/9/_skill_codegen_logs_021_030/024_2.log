+def _sprite_descriptor(sprite_id: int, kind: str, target_direction: str) -> dict:
+    if kind == "single":
+        if target_direction == "row":
+            height = random.randint(3, 8)
+        else:
+            height = random.randint(4, 6)
+        local = _single_local(height)
+        return {
