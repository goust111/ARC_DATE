+
+def _sprite_descriptor(sprite_id: int, kind: str, target_direction: str) -> dict:
+    if kind == "single":
+        if target_direction == "row":
+            height = random.randint(3, 8)
+        else:
+            height = random.randint(4, 6)
+        local = _single_local(height)
+        return {
+            "id": sprite_id,
+            "kind": "single",
+            "height": height,
+            "width": 1,
+            "bar_row": None,
+            "spine_col": 0,
+            "local": local,
+        }
+
+    width = random.choice((2, 3))
+    if target_direction == "row":
+        height = random.randint(3, 6)
+        if random.random() < 0.5:
+            bar_row = 0
+        else:
+            bar_row = height - 1
+    else:
+        height = random.randint(3, 5)
+        bar_row = random.randint(1 if height > 3 else 0, min(height - 1, 2))
+    spine_col = random.randrange(width)
