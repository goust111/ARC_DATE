+        return None
+    a_pos, b_pos, u1_pos, u2_pos = base
+
+    seeds: List[Seed] = []
+    color_b = legend[0]
+    color_c = legend[1]
+    color_a = legend[-1]
+    unmatched_colors = random.sample(unmatched_pool, 2)
