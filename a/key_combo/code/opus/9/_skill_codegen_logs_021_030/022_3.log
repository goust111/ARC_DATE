+    used = [(r, c) for r, c, _ in seeds]
+    edge_candidates = _candidate_edge_positions(
+        height, width, used, prefer_unique_axes=True
+    )
+    if not edge_candidates:
+        return None
+    c_pos = edge_candidates.pop()
+    seeds.append((c_pos[0], c_pos[1], color_c))
+    used.append(c_pos)
