+    unmatched = [(r, c, color) for r, c, color in seeds if color not in info["legend_map"]]
+    if len(matched) < 3 or len(unmatched) < 2:
+        return False
+    if len({color for _, _, color in seeds}) != len(seeds):
+        return False
+    if not _all_far_enough([(r, c) for r, c, _ in seeds]):
