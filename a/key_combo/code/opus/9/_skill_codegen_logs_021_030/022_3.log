+import random
+from typing import Dict, Iterable, List, Sequence, Set, Tuple
+
+import numpy as np
+
+
+Coord = Tuple[int, int]
+Seed = Tuple[int, int, int]
+
+BLACK = 0
+RED = 2
+PALETTE = [1, 3, 4, 5, 6, 7, 8, 9]
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
