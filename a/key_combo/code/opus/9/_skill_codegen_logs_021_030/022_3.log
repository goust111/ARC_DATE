+        "legend_map": legend_map,
+        "legend_len": legend_len,
+        "seeds": seeds,
+        "intents": intents,
+        "paths": per_seed_paths,
+        "red_cells": red_cells,
+        "blocked_by_obstacle": blocked_by_obstacle,
+        "blocked_by_boundary": blocked_by_boundary,
+    }
