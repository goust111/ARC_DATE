+    return grid
+
+
+def _build_oracle_from_spec(spec: dict) -> np.ndarray:
+    out = np.zeros((2 * spec["max_h"] + 1, 2 * spec["max_w"] + 1), dtype=int)
+    for corner in CORNERS:
