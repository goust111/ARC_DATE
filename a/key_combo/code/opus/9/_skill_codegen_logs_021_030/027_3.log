+            return None
+        br_cols = [c for c in ranges["br"][1] if c != left_c]
+        tl_rows = [r for r in ranges["tl"][0] if r != bot_r]
+        if not br_cols or not tl_rows:
+            return None
+        tl_r = random.choice(tl_rows)
+        br_c = random.choice(br_cols)
