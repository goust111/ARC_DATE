+    rows = defaultdict(int)
+    cols = defaultdict(int)
+    for r, c in orange_positions:
+        rows[r] += 1
+        cols[c] += 1
+    if not (any(v >= 2 for v in rows.values()) or any(v >= 2 for v in cols.values())):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        built = _make_attempt()
+        if built is not None:
+            return built[0]
