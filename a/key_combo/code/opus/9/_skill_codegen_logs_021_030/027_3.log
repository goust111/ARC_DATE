+    if contracted.shape != (2 * max_h + 1, 2 * max_w + 1):
+        return False
+
+    orange_positions = [tuple(map(int, rc)) for rc in np.argwhere(contracted == ORANGE)]
+    pair_count = _count_alignment_pairs(contracted)
