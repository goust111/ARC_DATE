+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREEN = 3
+ORANGE = 7
+FOREGROUND = {BLUE, GREEN, ORANGE}
+CORNERS = ("tl", "tr", "bl", "br")
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in NEIGHBORS4:
+        yield r + dr, c + dc
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    fg = grid != BLACK
+    seen = np.zeros_like(fg, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not fg[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and fg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _corner_from_center(center_r: float, center_c: float, h: int, w: int) -> str:
+    top = center_r < h / 2.0
+    left = center_c < w / 2.0
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and left:
+        return "bl"
+    return "br"
+
+
+def _extract_corner_data(grid: np.ndarray) -> dict[str, dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    comps = _components(g)
+    assert len(comps) == 4, "expected four corner components"
+
+    out: dict[str, dict] = {}
+    h, w = g.shape
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox(coords)
+        center_r = (r0 + r1) / 2.0
+        center_c = (c0 + c1) / 2.0
+        corner = _corner_from_center(center_r, center_c, h, w)
+        assert corner not in out, "components must occupy distinct quadrants"
+
+        patch = _crop_bbox(g, (r0, c0, r1, c1))
+        data = {
+            "coords": coords,
+            "bbox": (r0, c0, r1, c1),
+            "patch": patch,
+            "height": r1 - r0 + 1,
+            "width": c1 - c0 + 1,
+            "orange_local": [(rr - r0, cc - c0) for rr, cc in coords if int(g[rr, cc]) == ORANGE],
+        }
+        if corner == "tl":
+            data["top_offset"] = r0
+            data["left_offset"] = c0
+        elif corner == "tr":
+            data["top_offset"] = r0
+            data["right_offset"] = w - 1 - c1
+        elif corner == "bl":
+            data["bottom_offset"] = h - 1 - r1
+            data["left_offset"] = c0
+        else:
+            data["bottom_offset"] = h - 1 - r1
+            data["right_offset"] = w - 1 - c1
+        out[corner] = data
+
