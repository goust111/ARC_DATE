+
+def _spiral_corners(seed: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = seed
+    corners: list[tuple[int, int]] = []
+    leg_length = 2
+    direction_index = 0
+    consecutive_oob = 0
+    while True:
+        dr, dc = SPIRAL_DIRS[direction_index]
+        r += dr * leg_length
+        c += dc * leg_length
