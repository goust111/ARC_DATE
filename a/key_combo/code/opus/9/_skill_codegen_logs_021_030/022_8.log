from __future__ import annotations

import numpy as np

from arc_utils import Color, colors_present, components_mask
import math
import random


ERASED = Color.GREY
SEPARATOR = Color.BLACK


def _is_separator_line(line: np.ndarray) -> bool:
    return set(map(int, line)).issubset({SEPARATOR, ERASED})


def _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:
    assert separators, "expected at least one separator line"
    bounds = [-1, *separators, int(length)]
    intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
    sizes = [end - start for start, end in intervals]
    assert min(sizes) > 0, "separators must leave non-empty blocks"
    assert len(set(sizes)) == 1, "all encoded blocks must have the same size"
    return intervals


def _find_sprite(
    g: np.ndarray,
    row_intervals: list[tuple[int, int]],
    col_intervals: list[tuple[int, int]],
    payload_colors: list[int],
) -> np.ndarray:
    payload = set(payload_colors)
    sprites = []

    for r0, r1 in row_intervals:
        for c0, c1 in col_intervals:
            block = g[r0:r1, c0:c1]
            block_colors = set(colors_present(block, exclude={ERASED}))
            assert SEPARATOR not in block_colors, "block interiors cannot contain separator color"
            if ERASED not in set(map(int, block.flat)) and block_colors == payload:
                sprites.append(block.copy())

    assert sprites, "expected at least one fully visible sprite block"
    sprite = sprites[0]
    for candidate in sprites:
        assert np.array_equal(candidate, sprite), "fully visible sprite blocks must match"
    return sprite


def _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:
    counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}
    assert counts[payload_colors[0]] != counts[payload_colors[1]], "sprite colors must have a majority/minority split"
    foreground = max(payload_colors, key=lambda color: counts[color])
    blank_colors = [color for color in payload_colors if color != foreground]
    assert len(blank_colors) == 1
    return int(foreground), int(blank_colors[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.

    Input structure
    The grid is partitioned by black separator rows and columns into equal-size
    square blocks. Each block is either a copy of one two-color sprite or a
    uniform blank block of the sprite's minority color; grey pixels are erased
    cells that act as wildcards.

    Rule
    Infer the repeated sprite from fully visible mixed-color blocks. Replace a
    block matching that sprite, ignoring grey erasures, with a solid block of
    the sprite's majority color. Replace a uniform blank block with the sprite.
    Separator rows and columns, including grey erasures on them, become black.

    Key insight
    The small sprite is a block-level code for one macro-cell state, and the
    uniform minority-color block is the other state; the output renders the
    opposite code in each macro-cell while cleaning erased pixels.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape

    row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]
    col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]
    row_intervals = _regular_intervals(row_separators, H)
    col_intervals = _regular_intervals(col_separators, W)
    block_heights = {r1 - r0 for r0, r1 in row_intervals}
    block_widths = {c1 - c0 for c0, c1 in col_intervals}
    assert block_heights == block_widths, "encoded blocks must be square"

    payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})
    assert len(payload_colors) == 2, "expected exactly two non-separator payload colors"
    sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)
    foreground, blank = _foreground_and_blank(sprite, payload_colors)

    out = np.zeros_like(g)
    for r0, r1 in row_intervals:
        for c0, c1 in col_intervals:
            block = g[r0:r1, c0:c1]
            known = block != ERASED
            assert known.any(), "each block must expose at least one non-grey cell"
            matches_sprite = bool(np.all(block[known] == sprite[known]))
            matches_blank = bool(np.all(block[known] == blank))
            assert matches_sprite != matches_blank, "each block must unambiguously match the sprite or blank state"
            out[r0:r1, c0:c1] = foreground if matches_sprite else sprite

    return out

# --------------- generator (att2) ---------------

# Canvas and palette bounds.
GRID_COUNT_RANGE, BLOCK_SIZE_RANGE = (2, 4), (2, 4)
PAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
PAYLOAD_COLOR_COUNT = 2
GEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)

# Sprite composition constraints.
SPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)
SPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2

# Macro-cell state constraints.
MIN_BLANK_BLOCKS, MAX_BLANK_BLOCK_DENOMINATOR = 1, 2

# Grey overlay constraints.
GREY_MIN_FRACTION, GREY_MAX_FRACTION = 0.05, 0.25
GREY_TWO_COMPONENT_PROBABILITY, GREY_TWO_COMPONENT_ATTEMPTS = 0.5, 30
GREY_CONNECTIVITY, GENERATION_ATTEMPTS = 4, 300

NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _separator_indices(n: int, block_size: int) -> set[int]:
    return {(i + 1) * block_size + i for i in range(n - 1)}


def _block_origin(br: int, bc: int, block_size: int) -> tuple[int, int]:
    return br * (block_size + 1), bc * (block_size + 1)


def _has_symmetry(mask: np.ndarray) -> bool:
    return (
        np.array_equal(mask, np.fliplr(mask))
        or np.array_equal(mask, np.flipud(mask))
        or np.array_equal(mask, np.rot90(mask, 2))
    )


def _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:
    area = block_size * block_size
    min_num, min_den = SPRITE_FG_MIN_RATIO
    max_num, max_den = SPRITE_FG_MAX_RATIO
    fg_min = math.ceil(area * min_num / min_den)
    fg_max = math.floor(area * max_num / max_den)
    if fg_min > fg_max:
        fg_min = fg_max = round(area * min_num / min_den)
    fg_count = random.randint(fg_min, fg_max)
    blank_count = area - fg_count

    for _ in range(SPRITE_ATTEMPTS):
        mask = np.ones((block_size, block_size), dtype=bool)
        if block_size == TINY_BLOCK_SIZE:
            blanks = [random.randrange(area)]
        else:
            cols = list(range(block_size))
            random.shuffle(cols)
            blanks = [r * block_size + cols[r] for r in range(block_size)]
            extra = blank_count - block_size
            if extra > 0:
                pool = [i for i in range(area) if i not in blanks]
                blanks.extend(random.sample(pool, extra))

        for idx in blanks:
            mask[idx // block_size, idx % block_size] = False

        if block_size > TINY_BLOCK_SIZE:
            row_mixed = all(0 < np.count_nonzero(mask[r]) < block_size for r in range(block_size))
            col_mixed = all(0 < np.count_nonzero(mask[:, c]) < block_size for c in range(block_size))
            if not row_mixed or not col_mixed:
                continue
        if _has_symmetry(mask):
            continue

        sprite = np.where(mask, foreground, blank).astype(int)
        return sprite
    return None


def _neighbors4(r: int, c: int, height: int, width: int):
    for dr, dc in NEIGHBOR_OFFSETS_4:
        nr, nc = r + dr, c + dc
        if 0 <= nr < height and 0 <= nc < width:
            yield nr, nc


def _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:
    comps = [
        [tuple(map(int, rc)) for rc in coords]
        for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)
        if len(coords) >= size
    ]
    if not comps:
        return None

    comp = random.choice(comps)
    comp_set = set(comp)
    seed = random.choice(comp)
    blob = {seed}
    frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}

    while len(blob) < size:
        if not frontier:
            return None
        cell = random.choice(tuple(frontier))
        frontier.remove(cell)
        blob.add(cell)
        for nb in _neighbors4(*cell, *allowed.shape):
            if nb in comp_set and nb not in blob:
                frontier.add(nb)

    return blob


def _make_grey_mask(allowed: np.ndarray, target: int) -> np.ndarray | None:
    if target <= 0:
        return np.zeros_like(allowed, dtype=bool)

    want_two = target >= 2 and random.random() < GREY_TWO_COMPONENT_PROBABILITY
    if want_two:
        for _ in range(GREY_TWO_COMPONENT_ATTEMPTS):
            first_size = random.randint(1, target - 1)
            first = _grow_blob(allowed, first_size)
            if first is None:
                continue

            blocked = set(first)
            for r, c in tuple(first):
                blocked.update(_neighbors4(r, c, *allowed.shape))

            allowed_second = allowed.copy()
            for r, c in blocked:
                allowed_second[r, c] = False

            second = _grow_blob(allowed_second, target - first_size)
            if second is None:
                continue

            mask = np.zeros_like(allowed, dtype=bool)
            for r, c in first | second:
                mask[r, c] = True
            return mask

    one = _grow_blob(allowed, target)
    if one is None:
        return None

    mask = np.zeros_like(allowed, dtype=bool)
    for r, c in one:
        mask[r, c] = True
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, colors_present, find_components, get_bg, neighbors4
import random
from functools import lru_cache
from itertools import combinations


Ray = tuple[tuple[int, int], int, list[tuple[int, int]]]

CORNER_OFFSETS = {
    "NW": (-1, -1),
    "NE": (-1, 2),
    "SW": (2, -1),
    "SE": (2, 2),
}

DIAGONAL_DIRS = {
    "NW": (-1, -1),
    "NE": (-1, 1),
    "SW": (1, -1),
    "SE": (1, 1),
}

ROTATED_SOURCE = {
    "NW": "SW",
    "NE": "NW",
    "SE": "NE",
    "SW": "SE",
}


def _block_color(g: np.ndarray, bg: int) -> int:
    candidates: list[int] = []
    for color in colors_present(g, exclude={bg}):
        comps = find_components(
            g,
            bg=bg,
            connectivity=4,
            monochromatic=True,
            colors=[color],
            return_format="dict",
        )
        if comps and all(
            int(comp["area"]) == 4
            and bbox_h(comp["bbox"]) == 2
            and bbox_w(comp["bbox"]) == 2
            for comp in comps
        ):
            candidates.append(int(color))

    assert len(candidates) == 1, "expected exactly one color forming solid 2x2 blocks"
    return candidates[0]


def _blocks(g: np.ndarray, color: int, bg: int) -> list[tuple[int, int]]:
    comps = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        return_format="dict",
    )
    blocks: list[tuple[int, int]] = []
    for comp in comps:
        b = comp["bbox"]
        assert int(comp["area"]) == 4 and bbox_h(b) == 2 and bbox_w(b) == 2
        blocks.append((int(b[0]), int(b[1])))

    assert blocks, "expected at least one 2x2 block"
    return sorted(blocks)


def _ray_path(g: np.ndarray, start: tuple[int, int], direction: tuple[int, int], block_color: int) -> list[tuple[int, int]]:
    h, w = g.shape
    dr, dc = direction
    r, c = start
    path: list[tuple[int, int]] = []
    while 0 <= r < h and 0 <= c < w and int(g[r, c]) != block_color:
        path.append((r, c))
        r += dr
        c += dc

    assert path, "expected every corner ray to start in bounds outside the block"
    return path


def main(grid: np.ndarray) -> np.ndarray:
    """
    Rotate each 2x2 block's four diagonal corner colors clockwise, then extend the rotated colors outward as diagonal rays.

    Input structure
    - The background is the dominant color.
    - One foreground color forms one or more solid 2x2 blocks.
    - Each block has four non-background, non-block corner pixels diagonally adjacent to it.

    Rule
    - Around every block, move the NW corner color to NE, NE to SE, SE to SW, and SW to NW.
    - From each rotated corner, paint along the outward diagonal until the grid edge or another 2x2 block is reached.
    - If a ray reaches a same-colored outgoing corner of another block that has its own visible continuation, stop the incoming ray at that junction.

    Key insight
    - The 2x2 blocks are color rotators and ray blockers; the corner pixels are not independent dots but the four ports of each block.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = int(get_bg(g))
    block_color = _block_color(g, bg)

    rays: list[Ray] = []
    h, w = g.shape
    for r0, c0 in _blocks(g, block_color, bg):
        corner_colors: dict[str, int] = {}
        for corner, (dr, dc) in CORNER_OFFSETS.items():
            r = r0 + dr
            c = c0 + dc
            assert 0 <= r < h and 0 <= c < w, "expected all four block corners in bounds"
            color = int(g[r, c])
            assert color != bg and color != block_color, "expected colored corner ports around each block"
            corner_colors[corner] = color

        for corner, offset in CORNER_OFFSETS.items():
            start = (r0 + offset[0], c0 + offset[1])
            color = corner_colors[ROTATED_SOURCE[corner]]
            path = _ray_path(g, start, DIAGONAL_DIRS[corner], block_color)
            rays.append((start, color, path))

    starts_by_color: dict[int, set[tuple[int, int]]] = {}
    path_len: dict[tuple[int, tuple[int, int]], int] = {}
    for start, color, path in rays:
        starts_by_color.setdefault(color, set()).add(start)
        path_len[(color, start)] = len(path)

    planned: dict[tuple[int, int], int] = {}
    for start, color, path in rays:
        keep = len(path)
        other_starts = starts_by_color[color] - {start}
        for i, cell in enumerate(path):
            if i == 0:
                continue
            for nr, nc in neighbors4(*cell):
                other_start = (int(nr), int(nc))
                if other_start in other_starts and path_len[(color, other_start)] > 1:
                    keep = i + 1
                    break
            if keep != len(path):
                break

        for cell in path[:keep]:
            previous = planned.get(cell)
            assert previous is None or previous == color, "conflicting rays must not overlap"
            planned[cell] = color

    out = g.copy()
    for (r, c), color in planned.items():
        out[r, c] = color
    return out

# --------------- generator (o5x) ---------------

# Canvas, layout, and retry bounds.
_GEN_GRID_SIZE_RANGE = (8, 12)
_GEN_BLOCK_COUNT_RANGE = (1, 3)
_GEN_MAX_ATTEMPTS = 300
# Block geometry and palette.
_GEN_BACKGROUND_COLOR = 0
_GEN_BLOCK_COLOR = 2
_GEN_BLOCK_SIZE = 2
_GEN_BOX_SIZE = 4
_GEN_BOX_TO_BLOCK_OFFSET = 1
_GEN_CORNER_COLORS = (3, 6, 7, 8)
_GEN_CORNER_OFFSETS = ((-1, -1), (-1, 2), (2, -1), (2, 2))
_GEN_DIAGONAL_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
# Acceptance checks.
_GEN_MIN_LONG_RAY_LENGTH = 2

def _gen_boxes_disjoint(a: tuple[int, int], b: tuple[int, int]) -> bool:
    ar, ac = a
    br, bc = b
    last = _GEN_BOX_SIZE - 1
    return ar + last < br or br + last < ar or ac + last < bc or bc + last < ac

@lru_cache(maxsize=None)
def _gen_valid_box_sets(n: int, k: int) -> tuple[tuple[tuple[int, int], ...], ...]:
    positions = tuple((r, c) for r in range(n - _GEN_BOX_SIZE + 1) for c in range(n - _GEN_BOX_SIZE + 1))
    valid: list[tuple[tuple[int, int], ...]] = []
    for combo in combinations(positions, k):
        if all(_gen_boxes_disjoint(a, b) for a, b in combinations(combo, 2)):
            valid.append(combo)
    return tuple(valid)


def _gen_has_long_ray(g: np.ndarray, block_tops: list[tuple[int, int]]) -> bool:
    h, w = g.shape
    for r0, c0 in block_tops:
        for (orow, ocol), (drow, dcol) in zip(_GEN_CORNER_OFFSETS, _GEN_DIAGONAL_DIRS):
            r, c = r0 + orow, c0 + ocol
            length = 0
            while 0 <= r < h and 0 <= c < w and int(g[r, c]) != _GEN_BLOCK_COLOR:
                length += 1
                if length >= _GEN_MIN_LONG_RAY_LENGTH:
                    return True
                r += drow
                c += dcol
    return False

def _gen_render_grid(n: int, box_set: tuple[tuple[int, int], ...]) -> tuple[np.ndarray, list[tuple[int, int]]]:
    """Render one chosen box layout and return the 2x2 block top-left cells."""
    g = np.full((n, n), _GEN_BACKGROUND_COLOR, dtype=int)
    block_tops: list[tuple[int, int]] = []
    for box_r, box_c in box_set:
        r0, c0 = box_r + _GEN_BOX_TO_BLOCK_OFFSET, box_c + _GEN_BOX_TO_BLOCK_OFFSET
        block_tops.append((r0, c0))
        g[r0 : r0 + _GEN_BLOCK_SIZE, c0 : c0 + _GEN_BLOCK_SIZE] = _GEN_BLOCK_COLOR
        for color, (dr, dc) in zip(random.sample(_GEN_CORNER_COLORS, 4), _GEN_CORNER_OFFSETS):
            g[r0 + dr, c0 + dc] = color
    return g, block_tops

def _gen_passes_oracle(g: np.ndarray) -> bool:
    """Accept only grids whose solver result is deterministic and non-conflicting."""
    try:
        out = main(g)
        return bool(np.array_equal(main(g.copy()), out))
    except Exception:
        return False

def _gen_attempt() -> np.ndarray | None:
    n = random.randint(*_GEN_GRID_SIZE_RANGE)
    k = random.randint(*_GEN_BLOCK_COUNT_RANGE)
    box_sets = _gen_valid_box_sets(n, k)
    if not box_sets:
        return None

    g, block_tops = _gen_render_grid(n, random.choice(box_sets))
    if not _gen_has_long_ray(g, block_tops) or not _gen_passes_oracle(g):
        return None

    return g

def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        g = _gen_attempt()
        if g is not None:
            return g
    raise RuntimeError("failed to generate valid 85fa5666 input")

import numpy as np
from typing import *
import random
from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste

# concepts:
# growing

# description:
# In the input you will see a grid with some green rectangles. Each rectangle has one red pixel on one of its borders.
# To make the output, you should extend the green region of each rectangle to the border of the grid in the direction of the red pixel, with the extent of the line increasing with the extent of the rectangle.
# Also you should draw a red line from the red pixel to the border of the grid.


def main(input_grid):
    """
    Grow each green rectangle outward from its red border indicator to the canvas edge.

    Input structure:
    - Each foreground object is a green rectangle with one red pixel on its border.
    - Objects sit on a black background.
    - The red pixel indicates the side from which growth should extend.

    Rule:
    - Find each rectangle-and-indicator component.
    - Extend a green band from the rectangle toward the canvas edge on the indicator side.
    - Draw a red line from the indicator pixel to that same edge.

    Key insight:
    - The indicator side controls direction, while the rectangle thickness controls the grown band.
    """
    # Initialize the output grid
    output_grid = np.copy(input_grid)
    
    rectangle_color = Color.GREEN
    indicator_color = Color.RED
    background = Color.BLACK

    # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
    objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
    for obj in objects:
        # find the red indicator
        for red_r, red_c in np.argwhere(obj == indicator_color):
            break

        # Get the dimensions of the object, and its position
        _b = bbox(obj != background)
        assert _b is not None
        r, c, _r1, _c1 = _b
        width = _r1 - r + 1
        height = _c1 - c + 1

        # depending on which side of the rectangle that the indicator is on, we draw in different directions
        # left edge: draw to the left
        if red_r == r:
            # Extend the green rectangle to the left until it reaches the border
            output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
        elif red_r == r + width - 1:
            # Extend the green rectangle to the right until it reaches the border
            output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
        elif red_c == c:
            # Extend the green rectangle to the top until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
        elif red_c == c + height - 1:
            # Extend the green rectangle to the bottom until it reaches the border
            output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
            # Draw the red line from the red pixel to the border
            draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
        else:
            assert False, "The red pixel is not on the border of the rectangle"

    return output_grid

def generate_input():
    # Create the background grid
    n, m = np.random.randint(20, 30), np.random.randint(20, 30)
    grid = np.full((m, n), Color.BLACK)

    rectangle_num = 2
    rectangle_color = Color.GREEN
    indicator_color = Color.RED

    # Draw rectangles on the grid
    for i in range(rectangle_num):
        width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        # The width should be twice smaller than the height
        while (width * 2 + 2) >= height:
            width, height = np.random.randint(3, 20), np.random.randint(3, 20)

        green_rectangle = np.full((width, height), rectangle_color)

        # Place one indicator pixel on one random border of the rectangle
        # Spare enough space for the extend line with the same size of width - 1
        r_coord = np.random.choice([0, width - 1])
        c_coord = np.random.choice(range(width + 1, height - (width + 1)))
        green_rectangle[r_coord, c_coord] = indicator_color
        # Randomly rotate the object so that we get a variety of orientations
        if np.random.choice([True, False]):
            green_rectangle = np.rot90(green_rectangle, k=-1)
            r_coord, c_coord = c_coord, r_coord

        # Place the rectangle on the grid
        try:
            _loc = first_free_location(grid, green_rectangle, transparent=Color.BLACK, border=0, padding=2, padding_connectivity=8)
            if _loc is None:
                raise ValueError("no placement")
            r, c = _loc
        # Check if there is no space for the rectangle
        except:
            return generate_input()
        paste(grid, green_rectangle, r, c, transparent=Color.BLACK, clip=True)

    # Check if the generated grid is valid
    transformed_grid = main(grid)
    objects = find_components(transformed_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")

    # After transformation, the two objects should not touch each other
    if len(objects) != rectangle_num:
        # Regenerate the grid
        return generate_input()

    return grid

