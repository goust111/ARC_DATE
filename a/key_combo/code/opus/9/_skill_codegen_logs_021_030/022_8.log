+
+
+def _stamp_cells(sprite: np.ndarray, center: tuple[int, int]) -> list[tuple[int, int, int]]:
+    h, w = sprite.shape
+    anchor_r = h // 2
+    anchor_c = w // 2
+    cr, cc = center
