@@ -0,0 +1,490 @@
+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+SEED_COLOR = PINK
+OBSTACLE_COLOR = GREY
+
+SPIRAL_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+SAFE_MASKS = [
+    np.array([[1, 0, 0], [1, 1, 0], [0, 1, 0]], dtype=bool),
+    np.array([[0, 1, 0], [1, 1, 0], [1, 0, 0]], dtype=bool),
+    np.array([[1, 1, 0], [0, 1, 0], [0, 1, 0]], dtype=bool),
+    np.array([[1, 0, 0], [1, 1, 0], [1, 0, 0]], dtype=bool),
+    np.array([[0, 1, 0], [1, 1, 0], [0, 1, 0]], dtype=bool),
+]
+BODY_COLORS = [BLUE, YELLOW, ORANGE, TEAL, MAROON]
+
+GEN_ATTEMPTS = 500
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> Iterable[tuple[int, int]]:
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+        return
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, connectivity):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_component(grid: np.ndarray, coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    rr = coords[:, 0] - r0
+    cc = coords[:, 1] - c0
