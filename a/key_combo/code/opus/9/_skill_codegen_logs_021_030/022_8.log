+
+def _paste_sprite(grid: np.ndarray, sprite: np.ndarray, center: tuple[int, int]) -> None:
+    for r, c, color in _stamp_cells(sprite, center):
+        if color != BG and _in_bounds(grid.shape, r, c):
+            grid[r, c] = color
