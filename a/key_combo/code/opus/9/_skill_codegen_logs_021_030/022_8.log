+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    rr = coords[:, 0] - r0
+    cc = coords[:, 1] - c0
+    out[rr, cc] = grid[coords[:, 0], coords[:, 1]]
+    return out
