+
+def _hits_obstacle(sprite: np.ndarray, center: tuple[int, int], grid: np.ndarray) -> bool:
+    for r, c, color in _stamp_cells(sprite, center):
+        if color != BG and _in_bounds(grid.shape, r, c) and int(grid[r, c]) == OBSTACLE_COLOR:
