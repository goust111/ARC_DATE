+
+
+def _stamp_coord_set(sprite: np.ndarray, center: tuple[int, int], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    return {
+        (r, c)
+        for r, c, color in _stamp_cells(sprite, center)
+        if color != BG and _in_bounds(shape, r, c)
