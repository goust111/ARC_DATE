+
+def _make_sprite(marker_color: int) -> np.ndarray:
+    mask = random.choice(SAFE_MASKS)
+    sprite = np.zeros_like(mask, dtype=int)
+    occupied = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
