                for sr, sc in np.argwhere(sprite != BG)
            }
            if cells & forbidden:
                continue
            for sr, sc in np.argwhere(sprite != BG):
                grid[r0 + int(sr), c0 + int(sc)] = int(sprite[sr, sc])
            return True

