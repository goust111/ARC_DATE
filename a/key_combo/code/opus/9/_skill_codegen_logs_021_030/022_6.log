+
+def _candidate_marker_coords(
+    shape: tuple[int, int],
+    sprite: np.ndarray,
+    color: int,
+    array_left: int,
+    *,
+    allow_clip: bool,
+) -> list[tuple[int, int]]:
+    h, w = shape
+    sh, sw = sprite.shape
+    ar, ac = _anchor_for_color(sprite, color)
+    coords: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(array_left):
