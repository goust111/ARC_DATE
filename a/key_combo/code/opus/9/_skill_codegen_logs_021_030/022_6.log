+    colors: list[int],
+    array_left: int,
+) -> list[tuple[int, int, int]] | None:
+    clip_color = rng.choice(colors) if rng.random() < 0.45 else None
+    occupancy = np.zeros(shape, dtype=bool)
+    markers: list[tuple[int, int, int]] = []
+    for color in rng.sample(colors, len(colors)):
