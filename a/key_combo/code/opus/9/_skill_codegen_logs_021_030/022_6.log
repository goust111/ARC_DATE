+    return False
+
+
+def _sprite_connected(mask: np.ndarray) -> bool:
+    comps = _components_mask(mask, connectivity=8)
+    return len(comps) == 1
+
+
+def _generate_sprite(rng: random.Random) -> tuple[np.ndarray, list[int]]:
+    for _ in range(300):
