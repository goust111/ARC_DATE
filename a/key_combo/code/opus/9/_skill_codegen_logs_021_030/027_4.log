+        h, w = r1 - r0 + 1, c1 - c0 + 1
+        if h < 5 or w < 5:
+            continue
+        local = np.zeros((h, w), dtype=bool)
+        local[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        if np.array_equal(local, _perimeter_mask(h, w)):
+            rects.append(Rect((r0, c0, r1, c1), grid[r0 : r1 + 1, c0 : c1 + 1].copy()))
