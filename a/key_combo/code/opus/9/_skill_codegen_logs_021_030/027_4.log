+    lines = pattern if axis == 0 else pattern.T
+    runs = []
+    start = 0
+    for i in range(1, len(lines) + 1):
+        if i == len(lines) or not np.array_equal(lines[i], lines[start]):
+            runs.append((start, i, tuple(map(int, lines[start]))))
