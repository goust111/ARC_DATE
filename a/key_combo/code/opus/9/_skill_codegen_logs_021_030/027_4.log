+        shapes = [tuple(exemplar.shape)] + [(h, w) for h, w, _mh, _mw in target_specs]
+        grid_h = random.randint(max(18, max(h for h, _w in shapes) + 4), 26)
+        grid_w = random.randint(max(18, max(w for _h, w in shapes) + 4), 26)
+        anchor = (random.randint(1, 2), random.randint(1, 2))
+        placements = _search_layout(shapes, (grid_h, grid_w), anchor)
+        if placements is None:
+            continue
