+    out = g.copy()
+    defects: list[tuple[int, int]] = []
+    for rect in rects:
+        if rect.bbox == exemplar.bbox:
+            continue
+        expected = _stretch_patch(exemplar.patch, rect.patch.shape)
+        mismatch = rect.patch != expected
+        r0, c0, r1, c1 = rect.bbox
