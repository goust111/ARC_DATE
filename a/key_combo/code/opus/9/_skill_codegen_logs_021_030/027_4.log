+    max_count = max(color_counts)
+    candidates = [i for i, count in enumerate(color_counts) if count == max_count]
+    if len(candidates) == 1:
+        return candidates[0]
+    lengths = [end - start for start, end, _line in runs]
+    max_len = max(lengths[i] for i in candidates)
