+    h, w = map(int, shape)
+    inner = exemplar[1:-1, 1:-1]
+    row_idx = _axis_indices(inner, 0, h - 2)
+    col_idx = _axis_indices(inner, 1, w - 2)
+    out = np.full((h, w), int(exemplar[0, 0]), dtype=int)
+    out[1:-1, 1:-1] = inner[np.ix_(row_idx, col_idx)]
+    return out
