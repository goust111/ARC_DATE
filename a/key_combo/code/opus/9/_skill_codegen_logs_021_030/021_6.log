+GRID_MIN = 13
+GRID_MAX = 16
+OBJECT_COUNT_OPTIONS = (5, 7)
+SIZE_CHOICES = tuple(range(2, 11))
+HIT_COUNT_OPTIONS = (2, 3)
+GEN_ATTEMPTS = 500
+SHAPE_ATTEMPTS = 120
+MIN_RAY_LENGTH = 6
