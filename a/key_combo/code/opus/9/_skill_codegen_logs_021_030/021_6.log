PATTERN_CELL_SIZES = (1, 2)

# Macro stencil size and density ranges.
MACRO_H_RANGE = (2, 3)
MACRO_W_RANGE = (3, 6)
STAMP_TEAL_FRACTION = (0.40, 0.60)
SELECTOR_TEAL_FRACTION = (0.25, 0.50)

# Input layout padding and inter-object gaps.
TOP_PAD_RANGE = (1, 2)
LEFT_PAD_RANGE = (1, 2)
RIGHT_PAD_RANGE = (1, 3)
BOTTOM_PAD_RANGE = (1, 3)
