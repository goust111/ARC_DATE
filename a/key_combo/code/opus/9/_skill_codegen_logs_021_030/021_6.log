+
+def _choose_ray_anchors(ray_cells: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    usable = ray_cells[1:-1] if len(ray_cells) > 3 else ray_cells[:]
+    if len(usable) < count:
