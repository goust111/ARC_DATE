+    objs.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
+    return objs
+
+
+def _analyze(grid: np.ndarray) -> dict:
+    center, step = _parse_marker(grid)
+    ray = set(_ray_cells(grid.shape, center, step))
+    blue_objects = _blue_objects(grid)
