    for _ in range(np.random.randint(2,6)):
        _loc = first_free_location(grid, blue_square, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
        if _loc is None:
            raise ValueError("no placement")
        r, c = _loc
