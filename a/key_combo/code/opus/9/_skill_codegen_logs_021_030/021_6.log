+    hit = sorted(hit)
+    unhit = sorted([s for s in sizes if s not in hit])
+    if not any(s < median for s in hit):
+        return None
+    if not any(s >= median for s in hit):
+        return None
+    if not any(s < median for s in unhit):
+        return None
+    if not any(s > median for s in unhit):
+        return None
