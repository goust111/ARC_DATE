+    if len(specs) < 3 or len(specs) > 5:
+        return False
+    parities = [int(spec["parity"]) for spec in specs]
+    if not (0 in parities and 1 in parities):
+        return False
+    if not any(spec["parity"] == 0 and spec["phase_shifted"] for spec in specs):
