+BG = 0
+MARKER = 5
+BOUNDARY = 7
+SEED_PALETTE = (1, 2, 3, 4, 6)
+NEUTRAL_OWNER = -2
+BOUNDARY_OWNER = -1
+
+GRID_ROWS = (13, 17)
