+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 5
+BOUNDARY = 7
+SEED_PALETTE = (1, 2, 3, 4, 6)
+NEUTRAL_OWNER = -2
+BOUNDARY_OWNER = -1
+
