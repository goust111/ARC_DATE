+    vectors: list[tuple[int, ...]] = []
+
+    def rec(idx: int, remaining: int, current: list[int]) -> None:
+        if idx == n_regions:
+            if remaining != 0:
+                return
+            if sum(v > 0 for v in current) < support_min:
+                return
+            if current[winner] < 2:
