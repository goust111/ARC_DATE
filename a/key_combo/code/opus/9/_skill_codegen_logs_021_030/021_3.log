+    final = grown.copy()
+    final[absorb] = int(regions[winner]["color"])
+    meta.update(
+        final=final,
+        votes=votes,
+        winner=winner,
+        absorbed_count=int(absorb.sum()),
+        remaining_boundary_count=int(np.sum(final == BOUNDARY)),
