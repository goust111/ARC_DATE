+    top_vote = max(votes.values())
+    winners = [rid for rid, count in votes.items() if count == top_vote]
+    assert len(winners) == 1, "vote winner must be unique"
+    winner = winners[0]
+
+    absorb = np.zeros_like(owner, dtype=bool)
+    for r, c in boundary_cells:
