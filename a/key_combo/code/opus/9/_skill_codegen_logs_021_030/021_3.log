spec:
  grid: 16-18 rows x 13-19 cols
  output: 1x1 grid containing the winning region color
  regions:
    count: 3-4 distinct solid-color rectangular regions
    partition: BSP-tree of 2-3 axis-aligned cuts that perfectly tile the grid (no gaps/overlaps)
    colors: distinct non-black colors, all different from marker color
    min_dimension: >=4 in each axis [observed]
  markers:
    count: 3-11 single pixels of a unique rare color scattered across regions
    isolation: no two markers are 4-adjacent; none on grid border [observed]
    color: exactly one color with strictly smallest pixel count in the grid
    distribution: >=2 regions contain markers; exactly one region has strictly the most markers (no ties)
  rule: |
    Find the unique least-frequent color (markers). For each marker, identify its
    containing region via 4-neighbors. Output the region color with the most markers.

generation_strategy:
