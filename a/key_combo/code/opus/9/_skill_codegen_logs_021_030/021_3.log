+
+    regions = []
+    for color in colors:
+        comps = _component_cells(grid, color)
+        assert len(comps) == 1, "each seed color must form exactly one connected seed object"
+        cells = comps[0]
+        assert 2 <= len(cells) <= 3, "each seed object must have size 2 or 3"
