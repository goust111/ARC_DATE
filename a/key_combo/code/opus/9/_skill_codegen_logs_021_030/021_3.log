+def _seed_separation_ok(seed_cells: list[list[tuple[int, int]]], new_cells: list[tuple[int, int]]) -> bool:
+    for cell in new_cells:
+        for other_seed in seed_cells:
+            for other in other_seed:
+                if _manhattan(cell, other) < 4:
+                    return False
+    return True
