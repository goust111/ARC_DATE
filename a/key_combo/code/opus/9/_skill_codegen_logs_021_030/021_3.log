+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _manhattan(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
