    starts_by_color: dict[int, set[tuple[int, int]]] = {}
    path_len: dict[tuple[int, tuple[int, int]], int] = {}
    for start, color, path in rays:
        starts_by_color.setdefault(color, set()).add(start)
        path_len[(color, start)] = len(path)

