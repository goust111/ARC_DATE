spec:
  grid: 9-18 rows x 9-18 cols, bg=0
  source_objects:
    count: 2-3 identical-bbox-shape 4-connected components of a single color
    color: 6 (magenta) [observed]
    bbox: 4x4 in all examples [observed]; solver requires all same shape
    fill: 7-10 pixels per 4x4 bbox (44-62%); shapes differ between objects
    placement: non-overlapping bboxes, min bbox gap >= 3 cells, no edge touching
  markers:
    count: same as source_objects count; one per marker color
    size: exactly 1 pixel each, distinct non-bg non-source colors
    proximity: Manhattan distance 2 from nearest source bbox [observed]; unambiguously closest to exactly one source object (gap to 2nd nearest >= 2)
  packing_axis:
    determined by marker positions; row_span vs col_span of markers must be strictly unequal
    markers must have unique coordinates along the dominant-span axis
  output:
    shape: bbox_h * N along packing axis, bbox_w on other axis (e.g. 4x8 for 2 horizontal, 12x4 for 3 vertical)
    content: N concatenated crops, each crop = source mask recolored with matched marker color, ordered by marker position on packing axis

generation_strategy:
  approach: output-first
  steps:
    1. Pick N=2-3, choose packing axis (vertical or horizontal)
    2. Generate N distinct 4x4 sprites (4-connected, 7-10 filled pixels each) as the output crops
    3. Assign N distinct non-bg non-6 colors as marker colors; concatenate recolored crops along axis to form output
    4. Choose grid size large enough to place N non-overlapping 4x4 bboxes with gaps >= 3
    5. Place each source object (sprite recolored to color 6) at scattered positions on the grid
    6. Place each marker pixel at Manhattan distance 2 from its matched source bbox, ensuring unambiguous nearest-neighbor assignment
    7. Set marker positions so dominant-axis span > other-axis span and all markers have unique coords on dominant axis
