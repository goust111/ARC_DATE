+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "bbox": _bbox(cells),
+                    "first": min(cells),
+                    "shape": _normalize_shape(cells),
+                }
+            )
+    return comps
+
+
+def _find_separator_row(grid: np.ndarray) -> tuple[int, int]:
+    bg = _most_common_color(grid)
+    h, w = grid.shape
+    candidates = []
+    for r in range(h):
+        row = grid[r]
+        if int(row[0]) == bg:
+            continue
+        if np.all(row == row[0]) and r > 0 and r < h - 1 and r == h - 1 - r:
+            candidates.append(r)
