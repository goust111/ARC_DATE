+                    grown.add(nxt)
+                    variants = _shape_variants(_normalize_shape(grown))
+                    cur.add(min(variants, key=_shape_key))
+        by_area[area] = cur
+    out: list[tuple[tuple[int, int], ...]] = []
+    for area in range(2, 6):
+        out.extend(sorted(by_area[area], key=_shape_key))
