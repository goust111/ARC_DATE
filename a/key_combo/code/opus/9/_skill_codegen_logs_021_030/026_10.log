+            body_attach = cells[cross_edges[0][0]]
+            path_start = cells[cross_edges[0][1]]
+            if len(path) == 1:
+                endpoint = path_start
+            else:
+                if path_start not in ends:
+                    continue
+                endpoint = ends[0] if ends[1] == path_start else ends[1]
+
