+    return specs
+
+
+def _random_anchor_mask() -> set[Coord]:
+    for _ in range(100):
+        mask = _core_family_mask(int(np.random.randint(1, 4)))
+        h, w = _mask_dimensions(mask)
+        if len(mask) != h * w:
