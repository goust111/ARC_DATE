+
+def _attachment_specs(mask: set[Coord]) -> list[tuple[int, int, int, int, bool]]:
+    key = _normalize(mask)
+    if key in _ATTACHMENT_CACHE:
+        return _ATTACHMENT_CACHE[key]
+
