+        if not candidates:
+            return False
+
+        top, left, dr, dc, attach, end, path = candidates[int(np.random.randint(len(candidates)))]
+        obj["input_top"] = top
+        obj["input_left"] = left
+        obj["attach"] = attach
+        obj["endpoint"] = end
+        obj["path"] = path
+        obj["delta"] = (dr, dc)
+        obj["moved_top"] = top + dr
+        obj["moved_left"] = left + dc
