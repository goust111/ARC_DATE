+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[set[Coord]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        q = deque([(rr, cc)])
+        seen[rr, cc] = True
+        comp: set[Coord] = set()
+        while q:
