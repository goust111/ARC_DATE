+def _split_component_sizes(total: int, parts: int) -> list[int]:
+    cuts = sorted(random.sample(range(1, total), parts - 1))
+    prev = 0
+    out = []
+    for cut in cuts + [total]:
+        out.append(cut - prev)
+        prev = cut
+    random.shuffle(out)
