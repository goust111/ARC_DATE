+            grid[r0 : r1 + 1, c0 : c1 + 1][mask] = input_colors[(rr, cc)]
+
+    if not _validate_output_semantics(grid, ranks, expected_counts):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_RETRIES):
