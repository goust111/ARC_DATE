+        "tr": (r0 + 1, c1 - 1),
+        "bl": (r1 - 1, c0 + 1),
+        "br": (r1 - 1, c1 - 1),
+    }
+
+
+def _destinations(info: FrameInfo) -> dict[str, tuple[int, int]]:
