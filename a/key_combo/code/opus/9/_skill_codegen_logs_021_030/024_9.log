  87: def _force_unique_majority(counts):
  88:     """Pick a max count and transfer from tied maxima until it is unique."""
  89:     tied_max = np.flatnonzero(counts == counts.max())
  90:     majority_index = int(np.random.choice(tied_max))
  91:     while np.count_nonzero(counts == counts.max()) > 1:
  92:         tied_others = [
  93:             int(i) for i in np.flatnonzero(counts == counts.max()) if i != majority_index
  94:         ]
  95:         counts[tied_others[0]] -= 1
  96:         counts[majority_index] += 1
  97:     return counts
