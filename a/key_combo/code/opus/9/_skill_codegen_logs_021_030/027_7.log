+
+    order = random.sample(list(RECT_COLORS), k=4)
+    boxes = {order[i]: depth_boxes[i] for i in range(4)}
+    grid = _render_input((n, n), order, boxes)
+
+    if any(np.count_nonzero(grid == color) == 0 for color in RECT_COLORS):
