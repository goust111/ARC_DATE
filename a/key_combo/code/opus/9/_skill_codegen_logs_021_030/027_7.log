# Colors.
_GEN_BG = 0
_GEN_MASK_COLOR = 1
_GEN_DIVIDER = 4
_GEN_MARKER_COLORS = [2, 3, 5, 6, 7, 8, 9]

# Layout choices: (marker-mask pairs, cell size), limited by the 7-11 grid bound.
