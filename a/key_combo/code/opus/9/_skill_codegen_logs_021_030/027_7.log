+        if random.random() < 0.5 and _bbox_h(tuple(front)) < MAX_H and front[0] > 0:
+            front[0] -= 1
+        elif _bbox_w(tuple(front)) < MAX_W and front[3] < n - 1:
+            front[3] += 1
