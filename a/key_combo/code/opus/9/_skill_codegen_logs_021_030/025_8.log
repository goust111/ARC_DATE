+        if center not in motif_by_center:
+            return False
+        found = motif_by_center[center]
+        if int(found["shell_color"]) != int(motif["shell_color"]):
+            return False
+        if not np.array_equal(found["shell_mask"], _shell_mask_from_offsets(motif["offsets"])):
+            return False
