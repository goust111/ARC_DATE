+                    "row": row,
+                    "start": start,
+                    "cols": cols,
+                    "gap_cols": tuple(col + 1 for col in cols[:-1]),
+                    "mid_coord": mid_coord,
+                    "distance": best,
+                    "bias": mid_bias,
