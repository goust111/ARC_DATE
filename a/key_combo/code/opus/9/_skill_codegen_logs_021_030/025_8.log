+        row = int(segment["row"])
+        fill_color = int(motifs[segment["target_motif_index"]]["shell_color"])
+        for col in segment["cols"]:
+            out[row, col] = int(segment["color"])
+        for col in segment["gap_cols"]:
+            out[row, col] = fill_color
+    return out
