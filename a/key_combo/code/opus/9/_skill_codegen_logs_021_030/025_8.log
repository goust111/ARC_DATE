+            "color": int(dash_color),
+            "cols": tuple(chosen["cols"]),
+            "gap_cols": tuple(chosen["gap_cols"]),
+            "mid_coord": tuple(chosen["mid_coord"]),
+            "target_motif_index": int(target_motif_index),
