+                rr += dr
+                cc += dc
+    return owners
+
+
+def _quadrant_of(r: int, c: int, mid: int) -> str | None:
+    if r == mid or c == mid:
+        return None
+    if r < mid and c < mid:
+        return "TL"
+    if r < mid and c > mid:
+        return "TR"
+    if r > mid and c < mid:
+        return "BL"
+    return "BR"
+
+
+def _analyze_sources(
+    shape: tuple[int, int], sources: list[tuple[int, int, int]]
+) -> dict[str, object]:
