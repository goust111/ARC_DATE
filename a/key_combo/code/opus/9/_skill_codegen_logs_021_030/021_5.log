+    removed_input: set[tuple[int, int]] = set()
+    persistent_removed: set[tuple[int, int]] = set()
+    non_sym_segments = 0
+    sym_segments = 0
+
+    target_non_sym = int(rng.integers(2, 5))
+    target_sym = int(rng.integers(1, 3))
