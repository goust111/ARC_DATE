+    base = np.full_like(input_grid, BLACK)
+    base[repaired_frame] = GREY
+    marker_mask = (input_grid == BLUE) | (input_grid == RED)
+    base[marker_mask] = input_grid[marker_mask]
+    return _fill_regions(base, repaired_frame, bbox)
