+) -> None:
+    n_rows = len(row_lines) - 1
+    n_cols = len(col_lines) - 1
+    cells = [(rr, cc) for rr in range(n_rows) for cc in range(n_cols)]
+    rng.shuffle(cells)
+    marked_cells = int(rng.integers(2, min(len(cells), 7)))
