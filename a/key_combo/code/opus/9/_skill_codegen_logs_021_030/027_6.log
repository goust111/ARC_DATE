  "src": "main colored objects plus right-edge singleton color legend",
  "dst": "2x2-labeled pairwise relation table in legend order",
  "transform": "normalize each object's mask; red-fill off-diagonal table cells for object pairs with the same shape under rotation/flip, grey-fill all other off-diagonal cells; diagonal cells and separators remain background",
  "grid_shape": "square table with side length 3 * legend length + 2"
}
</annotation>
<generation_spec>
