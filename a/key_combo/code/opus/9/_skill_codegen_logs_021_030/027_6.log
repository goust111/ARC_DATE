+        for c in range(W):
+            if seen[r, c]:
+                continue
+            if int(grid[r, c]) == int(bg):
+                continue
+            if color is not None and int(grid[r, c]) != int(color):
+                continue
+            target = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < H and 0 <= nc < W):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) == int(bg):
