+    for _bracket, ref in placements:
+        out[ref["coords"][:, 0], ref["coords"][:, 1]] = int(bg)
+    for _bracket, mover in placements:
+        out[mover["coords"][:, 0], mover["coords"][:, 1]] = int(bg)
