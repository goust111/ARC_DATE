+        for variant in (rotated, np.fliplr(rotated)):
+            key = (tuple(map(int, variant.shape)), variant.astype(np.uint8).tobytes())
+            if key not in seen:
+                seen.add(key)
+                variants.append(variant.copy())
+    return variants
