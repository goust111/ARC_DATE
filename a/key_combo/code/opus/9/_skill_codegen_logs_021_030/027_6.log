+    for record in sorted(records, key=lambda rec: int(rec["bracket_start"])):
+        patch = record["mover_patch"]
+        dest_r = current_top - patch.shape[0]
+        dest_c = record["bracket_start"] + 1 + (record["inner_width"] - patch.shape[1]) // 2
