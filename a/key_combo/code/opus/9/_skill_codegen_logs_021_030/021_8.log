+        for rr in (anchor_r, anchor_r + 1)
+        for cc in (anchor_c, anchor_c + 1)
+    )
+
+
+def _is_adjacent_to_anchor(r: int, c: int, anchor_r: int, anchor_c: int) -> bool:
