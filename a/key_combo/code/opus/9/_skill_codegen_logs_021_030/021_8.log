+    components: dict[int, np.ndarray] = {}
+    next_id = 1
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            labels[r, c] = next_id
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        _in_bounds(mask.shape, nr, nc)
+                        and mask[nr, nc]
+                        and labels[nr, nc] == 0
+                    ):
+                        labels[nr, nc] = next_id
