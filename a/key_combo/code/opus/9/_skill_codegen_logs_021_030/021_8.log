spec:
  grid: 10x10 [observed]
  background: 0
  block:
    shape: filled 2x2
    color: any non-bg color (2 in all eval) [observed]
    position: >=1 cell from every edge so all 12 ring cells exist; margins >=2 on each side [observed]
  markers:
    color: a second non-bg color, distinct from block color
    count: 3-4
    placement: each marker lies on one of the 12 rays extending from the 12 ring cells of the block
    ray_types: cardinal (N/S rows aligned with bc0 or bc1; E/W rows aligned with br0 or br1) or diagonal (exact 45-degree from a ring corner)
    distance_to_ring: 1-6 (cells from marker to its ring destination)
    uniqueness: each marker targets a distinct ring cell (no two share the same destination)
  output:
    block: unchanged
    markers: each moved inward along its ray to the adjacent ring cell; original position cleared

generation_strategy:
  approach: output-first
  steps:
    1. Choose 10x10 grid, pick block_color and marker_color (two distinct non-bg colors).
    2. Place 2x2 block with margins >=2 from every edge.
    3. Pick 3-4 distinct ring cells from the 12 surrounding the block as marker destinations.
    4. For each chosen ring cell, determine its outward ray direction and pick a distance 2-6 for the marker. Compute marker position along that ray; verify it stays in-bounds and is on an empty cell.
    5. Build the input grid with block + markers at their distant positions (output has them at ring positions).
```
