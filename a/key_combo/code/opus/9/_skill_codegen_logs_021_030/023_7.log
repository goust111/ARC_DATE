+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+HINGE = 7
+MAIN_COLORS = [1, 2, 3, 4, 6, 8, 9]
+
+NORTH = (-1, 0)
+EAST = (0, 1)
+SOUTH = (1, 0)
+WEST = (0, -1)
+DIRS = (NORTH, EAST, SOUTH, WEST)
+
+TEMPLATE_LIBRARY = [
+    {
