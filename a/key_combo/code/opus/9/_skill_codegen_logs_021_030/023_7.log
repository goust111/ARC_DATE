+        r0, c0 = pad_r, pad_c
+    elif corner == "ne":
+        r0, c0 = pad_r, gw - outer_w - pad_c
+    elif corner == "sw":
+        r0, c0 = gh - outer_h - pad_r, pad_c
+    else:
+        r0, c0 = gh - outer_h - pad_r, gw - outer_w - pad_c
