+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all(patch[0, :] == FRAME):
+            continue
+        if not np.all(patch[-1, :] == FRAME):
+            continue
+        if not np.all(patch[:, 0] == FRAME):
+            continue
+        if not np.all(patch[:, -1] == FRAME):
+            continue
+        if not np.all(patch[1:-1, 1:-1] == BG):
+            continue
