+    for r in range(gh):
+        for c in range(gw):
+            endpoint, _fixed_mid, _tail, actual, envelope = _rod_cells((r, c), piece)
+            if any(not _in_bounds(grid_shape, rr, cc) for rr, cc in envelope):
