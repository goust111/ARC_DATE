+def _place_frame(grid: np.ndarray, inner_shape: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = map(int, inner_shape)
+    outer_h, outer_w = h + 2, w + 2
+    gh, gw = grid.shape
+    corner = random.choice(["nw", "ne", "sw", "se"])
