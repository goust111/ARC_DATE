+
+def _normalize_coords(coords: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = np.asarray(sorted(coords), dtype=int)
+    pts = pts - pts.min(axis=0)
