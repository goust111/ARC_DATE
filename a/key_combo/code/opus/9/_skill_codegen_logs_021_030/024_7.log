# Colors and canvas bounds.
BACKGROUND_COLOR = 0
SOURCE_COLOR = 6
MARKER_COLORS = [1, 2, 3, 4, 5, 7, 8, 9]
GRID_SIZE_RANGE = (9, 18)
MIN_AXIS_DIM_BY_COUNT = {2: 9, 3: 12}
EDGE_MARGIN = 1

