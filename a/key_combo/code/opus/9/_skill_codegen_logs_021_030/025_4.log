    "bottom": {"start_min": 3, "start_stop_margin": 3, "end_stop_margin": 2},
}

# Placement and retry limits.
GEN_PLACEMENT_MARGIN = 1
GEN_RETRY_LIMIT = 300
GEN_DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
