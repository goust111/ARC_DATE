spec:
  grid:
    input: NxN square, N in 3-5
    output: (N*N) x (N*N)
  colors:
    count: 2-3 distinct non-black foreground colors
    black (0) is reserved for output background only; never appears in input
    each color occupies >=2 cells [observed]
  mask_pattern:
    no color fills the entire grid (each mask has both on and off cells) [observed]
    colors are not required to be connected; multi-component regions are common
  symmetry: none required; all examples are asymmetric [observed]
  transform: |
    For each input pixel at (r,c) with color C, place an NxN block at
    output rows [r*N..(r+1)*N), cols [c*N..(c+1)*N). Inside the block,
    copy color C wherever the original input has C; fill 0 elsewhere.

generation_strategy:
  approach: direct random (input-only; transform is deterministic)
  steps:
    1. Pick N uniformly from {3, 4, 5}.
    2. Pick K = number of colors, uniformly from {2, 3}.
    3. Sample K distinct colors from 1-9.
    4. Fill the NxN grid randomly so every color appears >=2 times and
       no single color fills all N*N cells.
    5. Output is computed deterministically by the solver.
```
