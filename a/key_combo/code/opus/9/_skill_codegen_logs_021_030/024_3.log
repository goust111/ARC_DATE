+    if len(side_rows) == 1:
+        row = side_rows[0]
+        others = [candidate for candidate in all_gap_rows if abs(candidate - row) >= 4]
+        others.sort(key=lambda candidate: (-abs(candidate - row), candidate))
+        if others:
