+    region[teal] = TEAL
+
+
+def _render_input(
+    row_sizes: list[int],
+    col_sizes: list[int],
+    sources: list[tuple[int, int]],
+    parent: dict[tuple[int, int], tuple[int, int]],
+    source_colors: dict[tuple[int, int], int],
+    rng: random.Random,
