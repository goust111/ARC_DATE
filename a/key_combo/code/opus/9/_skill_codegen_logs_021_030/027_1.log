+        r = rng.randrange(1, h)
+        orange = (r, c)
+        teal = (r - 1, c)
+    elif dr == 1:
+        c = rng.randrange(w)
+        r = rng.randrange(h - 1)
+        orange = (r, c)
+        teal = (r + 1, c)
+    elif dc == -1:
+        r = rng.randrange(h)
+        c = rng.randrange(1, w)
+        orange = (r, c)
+        teal = (r, c - 1)
+    else:
+        assert dc == 1
+        r = rng.randrange(h)
+        c = rng.randrange(w - 1)
+        orange = (r, c)
+        teal = (r, c + 1)
+
