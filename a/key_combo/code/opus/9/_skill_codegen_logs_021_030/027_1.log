    for coords in red_objects:
        carrier = _carrier_color(g, coords)
        base[coords[:, 0], coords[:, 1]] = carrier
        objects.append((coords, carrier))

    out = base.copy()
    occupied = np.zeros(g.shape, dtype=bool)
    H, W = g.shape

    for coords, carrier in objects:
