+
+def _connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(coords[0])}
+    stack = [tuple(coords[0])]
+    wanted = {tuple(coord) for coord in coords.tolist()}
