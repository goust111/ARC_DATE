+        assert 3 <= int(comp["area"]) <= 7, "template area must be 3..7"
+        assert color not in templates, "each color must have exactly one template"
+        patch = np.full((3, 3), int(bg), dtype=int)
+        coords = comp["coords"]
+        patch[coords[:, 0] - r0, coords[:, 1] - c0] = color
