# Canvas and legend geometry.
BACKGROUND, NEUTRAL_COLOR, INPUT_ROWS = 0, 5, 15
SWATCH_SIZE, SWATCH_STRIDE, STENCIL_GAP = 2, 3, 1

# Structural size and palette bounds.
