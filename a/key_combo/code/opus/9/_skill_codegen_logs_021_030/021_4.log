+    runs: list[tuple[int, int]] = []
+    start: int | None = None
+    for idx, value in enumerate(mask.tolist()):
+        if value and start is None:
+            start = idx
+        elif not value and start is not None:
+            runs.append((start, idx - 1))
+            start = None
+    if start is not None:
+        runs.append((start, len(mask) - 1))
+    return runs
