+
+
+def _quadrant_slices(shape: tuple[int, int], quadrant: str) -> tuple[slice, slice]:
+    h, w = shape
+    mid_r = h // 2
+    mid_c = w // 2
+    r0 = 0 if quadrant[0] == "T" else mid_r
