0150: def _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:
0151:     area = block_size * block_size
0152:     min_num, min_den = SPRITE_FG_MIN_RATIO
0153:     max_num, max_den = SPRITE_FG_MAX_RATIO
0154:     fg_min = math.ceil(area * min_num / min_den)
0155:     fg_max = math.floor(area * max_num / max_den)
0156:     if fg_min > fg_max:
0157:         fg_min = fg_max = round(area * min_num / min_den)
0158:     fg_count = random.randint(fg_min, fg_max)
0159:     blank_count = area - fg_count
