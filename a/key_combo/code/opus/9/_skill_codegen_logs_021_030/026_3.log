0011: def _component_crop(grid: np.ndarray, coords: np.ndarray, bg: int) -> np.ndarray:
0012:     r0, c0, r1, c1 = bbox_coords(coords)
0013:     crop = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
0014:     rr = coords[:, 0] - r0
0015:     cc = coords[:, 1] - c0
0016:     crop[rr, cc] = grid[coords[:, 0], coords[:, 1]]
0017:     return crop
