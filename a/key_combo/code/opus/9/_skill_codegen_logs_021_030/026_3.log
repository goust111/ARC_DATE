+
+def _quadrant_relation(src: str, dst: str) -> str:
+    if src == dst:
+        return "same"
+    if src[0] == dst[0]:
+        return "E" if src[1] == "L" else "W"
+    if src[1] == dst[1]:
+        return "S" if src[0] == "T" else "N"
