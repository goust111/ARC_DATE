+def _reachable_targets(quadrant: str) -> list[str]:
+    out = [quadrant]
+    if quadrant[0] == "T":
+        out.append("B" + quadrant[1])
+    else:
+        out.append("T" + quadrant[1])
+    if quadrant[1] == "L":
+        out.append(quadrant[0] + "R")
+    else:
+        out.append(quadrant[0] + "L")
+    return out
