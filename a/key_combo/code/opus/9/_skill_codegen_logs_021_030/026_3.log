0001: from __future__ import annotations
0002: 
0003: import numpy as np
0004: 
0005: from arc_utils import Color, colors_present, components_mask
0006: import math
0007: import random
0008: 
0009: 
0010: ERASED = Color.GREY
0011: SEPARATOR = Color.BLACK
0012: 
0013: 
0014: def _is_separator_line(line: np.ndarray) -> bool:
0015:     return set(map(int, line)).issubset({SEPARATOR, ERASED})
0016: 
0017: 
0018: def _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:
0019:     assert separators, "expected at least one separator line"
0020:     bounds = [-1, *separators, int(length)]
0021:     intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
0022:     sizes = [end - start for start, end in intervals]
0023:     assert min(sizes) > 0, "separators must leave non-empty blocks"
0024:     assert len(set(sizes)) == 1, "all encoded blocks must have the same size"
0025:     return intervals
0026: 
0027: 
0028: def _find_sprite(
0029:     g: np.ndarray,
0030:     row_intervals: list[tuple[int, int]],
0031:     col_intervals: list[tuple[int, int]],
0032:     payload_colors: list[int],
0033: ) -> np.ndarray:
0034:     payload = set(payload_colors)
0035:     sprites = []
0036: 
0037:     for r0, r1 in row_intervals:
0038:         for c0, c1 in col_intervals:
0039:             block = g[r0:r1, c0:c1]
0040:             block_colors = set(colors_present(block, exclude={ERASED}))
0041:             assert SEPARATOR not in block_colors, "block interiors cannot contain separator color"
0042:             if ERASED not in set(map(int, block.flat)) and block_colors == payload:
0043:                 sprites.append(block.copy())
0044: 
0045:     assert sprites, "expected at least one fully visible sprite block"
0046:     sprite = sprites[0]
0047:     for candidate in sprites:
0048:         assert np.array_equal(candidate, sprite), "fully visible sprite blocks must match"
0049:     return sprite
0050: 
0051: 
0052: def _foreground_and_blank(sprite: np.ndarray, payload_colors: list[int]) -> tuple[int, int]:
0053:     counts = {color: int(np.count_nonzero(sprite == color)) for color in payload_colors}
0054:     assert counts[payload_colors[0]] != counts[payload_colors[1]], "sprite colors must have a majority/minority split"
0055:     foreground = max(payload_colors, key=lambda color: counts[color])
0056:     blank_colors = [color for color in payload_colors if color != foreground]
0057:     assert len(blank_colors) == 1
0058:     return int(foreground), int(blank_colors[0])
