0774: def random_sprite(
0775:     m,
0776:     n,
0777:     *,
0778:     density: float = 0.5,
0779:     symmetry: str | None = None,
0780:     color_palette: list[int] | None = None,
0781:     connectivity: int = 4,
0782:     background: int = Color.BLACK,
0783:     no_repeated_colors: bool = False,
0784: ) -> np.ndarray:
0785:     """Generate a contiguous sprite of shape (m,n) with random symmetry and palette (for puzzle generation)."""
0786:     if isinstance(m, range):
0787:         m = list(m)
0788:     if isinstance(n, range):
0789:         n = list(n)
0790:     if not isinstance(m, list):
0791:         m = [m]
0792:     if not isinstance(n, list):
0793:         n = [n]
0794: 
0795:     m_original, n_original = m, n
0796:     density_original, symmetry_original = density, symmetry
0797:     palette_original, conn_original, bg_original = color_palette, connectivity, background
0798: 
0799:     can_be_square = any(m_ == n_ for m_ in m for n_ in n)
0800:     symmetry_types = ["horizontal", "vertical", "not_symmetric", "mirror"]
0801:     if can_be_square:
0802:         symmetry_types += ["diagonal", "radial"]
0803:     symmetry = symmetry or random.choice(symmetry_types)
0804: 
0805:     has_to_be_square = symmetry in ("diagonal", "radial")
0806:     if has_to_be_square:
0807:         m, n = random.choice([(m_, n_) for m_ in m_original for n_ in n_original if m_ == n_])
0808:     else:
0809:         m = random.choice(m)
0810:         n = random.choice(n)
0811: 
0812:     if m == 1 or n == 1:
0813:         density = 1.0
0814:     elif m == 2 or n == 2:
0815:         density = max(float(density), 0.6)
0816:     elif m == 3 or n == 3:
0817:         density = max(float(density), 0.5)
0818:     else:
0819:         density = max(0.4, min(0.95, random.gauss(float(density), 0.1)))
0820: 
0821:     sprite = generate_sprite(
0822:         n=int(m),
0823:         m=int(n),
0824:         symmetry_type=symmetry,
0825:         color_palate=color_palette,
0826:         fill_percentage=density,
0827:         connectivity=connectivity,
0828:         background=background,
