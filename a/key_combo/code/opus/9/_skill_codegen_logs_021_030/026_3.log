0116: PAYLOAD_COLOR_COUNT = 2
0117: GEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)
0118: 
0119: # Sprite composition constraints.
0120: SPRITE_FG_MIN_RATIO, SPRITE_FG_MAX_RATIO = (2, 3), (3, 4)
0121: SPRITE_ATTEMPTS, TINY_BLOCK_SIZE = 80, 2
