0718: def first_free_location(
0719:     canvas: np.ndarray,
0720:     patch: np.ndarray,
0721:     *,
0722:     transparent: int,
0723:     border: int = 0,
0724:     padding: int = 0,
0725:     padding_connectivity: int = 8,
0726: ) -> Coord | None:
0727:     """
0728:     Find the first (top-left) location where `patch` fits without overlap.
0729: 
0730:     Args:
0731:         transparent: color treated as transparent in both `canvas` and `patch`
0732:         border: keep at least this many empty cells to the canvas border
0733:         padding: if > 0, treat `canvas` occupancy as dilated by `padding` pixels.
0734:                  (useful for “leave a gap” placement constraints)
0735:         padding_connectivity: 4 or 8 for the dilation neighborhood
0736: 
0737:     Returns:
0738:         (r0,c0) or None if no placement exists.
0739:     """
0740:     H, W = canvas.shape
0741:     h, w = patch.shape
0742:     border = int(border)
0743:     padding = int(padding)
0744:     bg = int(transparent)
0745: 
0746:     if h <= 0 or w <= 0:
0747:         return None
0748:     if H - h + 1 - border <= border or W - w + 1 - border <= border:
0749:         return None
0750: 
0751:     # Occupancy of the canvas (optionally dilated to enforce padding).
0752:     occ = (canvas != bg)
0753:     if padding > 0:
0754:         if int(padding_connectivity) == 4:
0755:             struct = STRUCT4
0756:         elif int(padding_connectivity) == 8:
0757:             struct = STRUCT8
0758:         else:
0759:             raise ValueError("first_free_location: padding_connectivity must be 4 or 8")
0760:         occ = ndimage.binary_dilation(occ, iterations=padding, structure=struct)
0761: 
0762:     patch_mask = (patch != bg)
0763:     if not bool(patch_mask.any()):
0764:         # Empty patch: any in-bounds location works; choose first.
0765:         return int(border), int(border)
0766: 
0767:     for r0 in range(border, H - h + 1 - border):
0768:         for c0 in range(border, W - w + 1 - border):
0769:             if not bool((occ[r0 : r0 + h, c0 : c0 + w] & patch_mask).any()):
0770:                 return int(r0), int(c0)
0771:     return None
0772: 
