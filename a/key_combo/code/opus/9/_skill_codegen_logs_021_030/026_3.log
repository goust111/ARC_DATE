    color: 6 in all examples [observed]; any non-bg color allowed by solver
    shape: 1px-thick perfect rectangular border, h>=3 w>=3
    size: 3-8 per side; always square [observed]
    interior: all background; dims 1-6 per side
    position: anywhere on grid; may touch grid edges
  sprite:
    color: any non-bg, non-frame color
