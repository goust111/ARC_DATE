0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Erase all distractor pixels and expand the single red control pixel into the grid quadrant that contains it.
0011: 
0012:     Input structure:
0013:     - The grid has one dominant background color.
0014:     - Exactly one red pixel is the control pixel.
0015:     - Other non-background pixels are distractors.
0016: 
0017:     Rule:
0018:     - Clear the canvas to the background color.
0019:     - Split the grid into equal top/bottom and left/right halves.
0020:     - Fill the quadrant containing the red control pixel with red.
0021: 
0022:     Key insight:
0023:     - The red control pixel selects a whole half-grid quadrant by its row half and column half; all other foreground pixels are noise.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     H, W = g.shape
0027:     assert H % 2 == 0 and W % 2 == 0, "grid must split into equal quadrants"
0028: 
0029:     bg = get_bg(g)
0030:     marker_color = Color.RED
0031:     marker_coords = coords_where(g == marker_color)
0032:     assert len(marker_coords) == 1, "expected exactly one red control pixel"
0033: 
0034:     half_h = H // 2
0035:     half_w = W // 2
0036:     marker_r, marker_c = map(int, marker_coords[0])
0037:     r0 = 0 if marker_r < half_h else half_h
0038:     c0 = 0 if marker_c < half_w else half_w
0039: 
0040:     out = np.full_like(g, bg)
0041:     out[r0 : r0 + half_h, c0 : c0 + half_w] = marker_color
0042:     return out
