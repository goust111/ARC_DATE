+    else:
+        out.append(quadrant[0] + "L")
+    return out
+
+
+def _bbox_disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1]
+
+
+def _parse_scene(grid: np.ndarray) -> list[dict]:
