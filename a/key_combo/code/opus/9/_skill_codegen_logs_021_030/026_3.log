+        target = obj["control_quadrant"] if use_control_quadrant else obj["object_quadrant"]
+        rs, cs = _quadrant_slices(g.shape, target)
+        patch = out[rs, cs]
+        paintable = np.ones_like(patch, dtype=bool)
+        if protect_fixed:
+            paintable &= ~fixed[rs, cs]
+        patch[paintable] = obj["color"]
