0014: def main(input_grid):
0015:     """
0016:     Extend a multicolor cross across the canvas by repeating its color sequences.
0017: 
0018:     Input structure:
0019:     - The grid contains one connected multicolor cross on a black background.
0020:     - One full row and one full column of the cropped sprite meet at the cross center.
0021:     - The row and column colors form the sequences to repeat.
0022: 
0023:     Rule:
0024:     - Crop the cross and locate the row and column that pass through its center.
0025:     - Copy the input grid as the output canvas.
0026:     - Paste the center column and center row sequences repeatedly in both directions.
0027: 
0028:     Key insight:
0029:     - The cross is a seed for periodic extension: its central row and column are reused
0030:       at intervals equal to their own lengths.
0031:     """
0032:     # Plan:
0033:     # 1. Parse the input and create output canvas to draw on top of
0034:     # 2. Extract the vertical and horizontal parts of the cross, and make note of the coordinate of the middle
0035:     # 3. Expand the horizontal part to the right and left, aligned with the middle y coordinate
0036:     # 4. Expand the vertical part to the top and bottom, aligned with the middle x coordinate    
0037: 
0038:     # 1. Input parsing
0039:     # Extract the cross, which has many colors and so is not monochromatic.
0040:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
0041:     assert len(objects) == 1, "exactly one cross expected"
0042:     obj = objects[0]
0043:     _b = bbox(obj != Color.BLACK)
0044:     assert _b is not None
0045:     cross_r, cross_c = bbox_anchor(_b, anchor="upper left")
0046: 
0047:     # Create output grid, which we are going to draw on top of, so we start with the input grid
0048:     output_grid = input_grid.copy()
0049:     width, height = input_grid.shape
0050: 
0051:     # 2. Cross analysis: Extract subsprites, get the middle
0052:     # Extract the horizontal/vertical parts of the cross sprite by figuring out where its middle is (where the horizontal and vertical lines meet)
0053:     _b = bbox(obj != Color.BLACK)
0054:     assert _b is not None
0055:     sprite = crop_bbox(obj, _b)
0056:     cross_width, cross_height = sprite.shape
0057:     # Middle is where they meet
0058:     cross_middle_r = next( r for r in range(cross_width) if np.all(sprite[r, :] != Color.BLACK) )
0059:     cross_middle_c = next( c for c in range(cross_height) if np.all(sprite[:, c] != Color.BLACK) )
0060:     # Extract the horizontal and vertical parts of the cross
0061:     vertical_sprite = sprite[cross_middle_r:cross_middle_r+1, :]
0062:     horizontal_sprite = sprite[:, cross_middle_c:cross_middle_c+1]
0063: 
0064:     # 3. Expand the horizontal line to the right and left
0065:     r_start, c_start, len_line = cross_r, cross_c + cross_middle_c, cross_width
