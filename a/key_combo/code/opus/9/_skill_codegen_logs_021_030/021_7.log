+        a, b = distractor
+        plus_centers.extend([a, b])
+        plus_shapes.extend([_plus_cells(a), _plus_cells(b)])
+        blocked |= _plus_cells(a)
+        blocked |= _plus_cells(b)
+
+        if branch["extra_isolated"]:
