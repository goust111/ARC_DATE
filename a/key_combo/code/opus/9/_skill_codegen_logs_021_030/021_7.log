+
+
+def _place_distractor_pair(
+    shape: tuple[int, int],
+    orientation: str,
+    line_values: set[int],
+    blocked: set[tuple[int, int]],
+    existing_pluses: list[set[tuple[int, int]]],
+) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    candidates = []
+    for r in range(1, shape[0] - 1):
+        for c in range(1, shape[1] - 1):
