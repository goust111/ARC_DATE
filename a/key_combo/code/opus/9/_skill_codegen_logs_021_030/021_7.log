+
+
+def _place_inactive_guide(
+    shape: tuple[int, int],
+    orientation: str,
+    line_value: int,
+    delta_offset: int,
+    blocked: set[tuple[int, int]],
+) -> tuple[set[tuple[int, int]], tuple[int, int]] | None:
+    line = _line_cells(shape, orientation, line_value)
+    candidates = [
