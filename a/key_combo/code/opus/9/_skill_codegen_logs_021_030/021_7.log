+
+
+def generate_input() -> np.ndarray:
+    branch_choices = [
+        {"guides": 2, "active": 1, "extra_isolated": False},
+        {"guides": 3, "active": 1, "extra_isolated": True},
+        {"guides": 3, "active": 2, "extra_isolated": False},
+    ]
+
+    for _attempt in range(600):
