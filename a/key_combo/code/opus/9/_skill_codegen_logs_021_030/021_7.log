+        else:
+            r0, c0 = tr, tc
+            for i in range(size):
+                for j in range(size):
+                    if i + j <= size - 1:
+                        cells.add((r0 + i, c0 + j))
+    return cells
+
+
+def _cells_in_bounds(shape: tuple[int, int], cells: set[tuple[int, int]]) -> bool:
+    h, w = shape
+    return all(0 <= r < h and 0 <= c < w for r, c in cells)
+
+
+def _cells_touch(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
