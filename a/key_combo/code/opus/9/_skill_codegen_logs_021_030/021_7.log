        continue
    line_values = {base_value} | {base_value + d for d in deltas}
    distractor = mod._place_distractor_pair(shape, orientation, line_values, blocked, plus_shapes)
    if distractor is None:
        counts['distractor']=counts.get('distractor',0)+1
        continue
    a,b = distractor
    plus_shapes.extend([mod._plus_cells(a), mod._plus_cells(b)])
