+            return a, b
+    return None
+
+
+def _place_isolated_plus(
+    shape: tuple[int, int],
+    orientation: str,
+    used_values: set[int],
+    blocked: set[tuple[int, int]],
+    existing_pluses: list[set[tuple[int, int]]],
+) -> tuple[int, int] | None:
+    candidates = []
+    for r in range(1, shape[0] - 1):
