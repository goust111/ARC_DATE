+        return False
+    for other in existing_pluses:
+        if _cells_touch(cells, other):
+            return False
+    return True
+
+
+def _shuffled(seq: list) -> list:
+    out = list(seq)
+    random.shuffle(out)
+    return out
+
+
+def _choose_base_value(shape: tuple[int, int], orientation: str) -> int:
+    h, w = shape
+    if orientation == DIAG_DOWN:
