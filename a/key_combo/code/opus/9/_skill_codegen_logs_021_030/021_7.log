+        guides: list[set[tuple[int, int]]] = []
+        plus_centers: list[tuple[int, int]] = []
+        plus_shapes: list[set[tuple[int, int]]] = []
+        line_values = {base_value}
+
+        failed = False
+        for delta_offset in _shuffled(list(active_deltas)):
+            new_value = base_value + delta_offset
+            placed = _place_active_guide(shape, orientation, new_value, delta_offset, blocked, plus_shapes)
+            if placed is None:
+                failed = True
+                break
+            guide, _tip, left, right = placed
+            guides.append(guide)
+            blocked |= guide
+            line_values.add(new_value)
+            plus_centers.extend([left, right])
+            plus_shapes.extend([_plus_cells(left), _plus_cells(right)])
+            blocked |= _plus_cells(left)
+            blocked |= _plus_cells(right)
+        if failed:
+            continue
+
+        for delta_offset in _shuffled([d for d in deltas if d not in active_deltas]):
+            new_value = base_value + delta_offset
+            placed = _place_inactive_guide(shape, orientation, new_value, delta_offset, blocked)
+            if placed is None:
+                failed = True
+                break
+            guide, _tip = placed
+            guides.append(guide)
+            blocked |= guide
+            line_values.add(new_value)
+        if failed:
+            continue
+
+        distractor = _place_distractor_pair(shape, orientation, line_values, blocked, plus_shapes)
+        if distractor is None:
+            continue
+        a, b = distractor
+        plus_centers.extend([a, b])
+        plus_shapes.extend([_plus_cells(a), _plus_cells(b)])
+        blocked |= _plus_cells(a)
+        blocked |= _plus_cells(b)
+
+        if branch["extra_isolated"]:
+            used_values = {_diag_value(center, orientation) for center in plus_centers}
+            extra = _place_isolated_plus(shape, orientation, used_values, blocked, plus_shapes)
+            if extra is None:
+                continue
+            plus_centers.append(extra)
+            plus_shapes.append(_plus_cells(extra))
+            blocked |= _plus_cells(extra)
+
+        grid = _render_input(shape, orientation, base_value, guides, plus_centers)
+        summary = _semantic_summary(grid)
+
+        if not (4 <= len(summary["centers"]) <= 6):
+            continue
+        if len(summary["active_new_values"]) < 1:
+            continue
+        if not summary["red_cells"]:
+            continue
+        if not summary["participants"]:
+            continue
+        if len(summary["participants"]) >= len(summary["centers"]):
+            continue
+        if not summary["off_line_clear_pairs"]:
+            continue
+        if len(summary["connected_pairs"]) < branch["active"]:
+            continue
+
+        output = summary["output"]
+        if not np.any(output == RED):
+            continue
+        if not np.any(output == ORANGE):
+            continue
+        if not np.any(output == BLUE):
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

