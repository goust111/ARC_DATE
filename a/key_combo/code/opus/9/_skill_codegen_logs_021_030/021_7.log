+def _solve_pairs(base: np.ndarray, orientation: str, line_values: set[int], centers: list[tuple[int, int]]) -> tuple[set[tuple[int, int]], set[tuple[int, int]], list[tuple[tuple[int, int], tuple[int, int]]]]:
