+
+
+def _guide_cells(orientation: str, delta: int, tip: tuple[int, int]) -> set[tuple[int, int]]:
+    size = abs(delta)
+    tr, tc = tip
+    cells: set[tuple[int, int]] = set()
+    if orientation == DIAG_DOWN:
+        if delta > 0:
+            r0, c0 = tr - size + 1, tc
+            for i in range(size):
+                for j in range(i + 1):
+                    cells.add((r0 + i, c0 + j))
+        else:
+            r0, c0 = tr, tc - size + 1
+            for i in range(size):
+                for j in range(i, size):
