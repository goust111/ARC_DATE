+
+    return {
+        "orientation": orientation,
+        "base_value": base_value,
+        "line_values": line_values,
+        "centers": centers,
+        "tips": tips,
+        "red_cells": red_cells,
+        "participants": participants,
+        "connected_pairs": connected_pairs,
+        "active_new_values": active_new_values,
+        "off_line_clear_pairs": off_line_clear_pairs,
