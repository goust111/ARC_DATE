+        for cell in line
+        if 1 <= cell[0] < shape[0] - 1 and 1 <= cell[1] < shape[1] - 1
+    ]
+    random.shuffle(candidates)
+    for tip in candidates:
+        guide = _guide_cells(orientation, delta_offset, tip)
+        if _cells_in_bounds(shape, guide) and not (guide & blocked):
