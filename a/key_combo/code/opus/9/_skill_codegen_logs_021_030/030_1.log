  grid: 7x7 square [observed]; solver requires square >= 3
  structure: |
    (0,0)=corner, row 0 cols 1..N-1=top_band, col 0 rows 1..N-1=left_band
    rows 1..N-1 x cols 1..N-1 = payload (6x6)
  control_bands:
    marker: one color appearing exactly once in top_band AND once in left_band
    filler: one other color filling the rest of both bands
    corner: a third color at (0,0), distinct from marker, filler, and all payload colors
  payload:
    colors: 6 distinct colors partitioning all 36 cells (no background/zero)
    per_color_size: 4-9 cells [observed]
    connectivity: each color mostly forms 1 connected component (occasionally 2) [observed]
