+    row_ids = np.arange(h)[:, None] % tile.shape[0]
+    col_ids = np.arange(w)[None, :] % tile.shape[1]
+    return tile[row_ids, col_ids]
+
+
+def _sample_full_period_tile(th: int, tw: int, colors: tuple[int, int]) -> np.ndarray:
