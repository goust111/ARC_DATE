+    row_ids = np.arange(g.shape[0])[:, None] % tile_h
+    col_ids = np.arange(g.shape[1])[None, :] % tile_w
+    predicted = tile[row_ids, col_ids]
+
+    out = g.copy()
+    missing = g == MISSING
