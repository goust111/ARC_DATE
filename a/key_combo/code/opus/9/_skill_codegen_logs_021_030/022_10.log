+
+
+def _partition_total(total: int, parts: int, minimum: int) -> list[int]:
+    cuts = sorted(random.sample(range(1, total - parts * minimum + parts), parts - 1))
+    shifted = [0] + cuts + [total - parts * minimum + parts]
