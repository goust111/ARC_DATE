+TILE_DIMS = [(2, 2), (2, 3), (3, 2), (3, 3)]
+MISSING_FRACTION_RANGE = (0.20, 0.40)
+BLOB_COUNT_CHOICES = (2, 3, 4)
+MIN_BLOB_SIZE = 4
+MAX_GEN_ATTEMPTS = 600
+SHAPE_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 120
+COLOR_POOL = tuple(range(1, 10))
