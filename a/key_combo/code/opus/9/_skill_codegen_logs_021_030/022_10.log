+
+
+def _touches_existing(mask: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    h, w = map(int, mask.shape)
+    for r, c in cells:
+        if bool(mask[r, c]):
+            return True
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]):
