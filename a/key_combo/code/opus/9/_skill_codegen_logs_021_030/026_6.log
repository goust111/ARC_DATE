+
+def _sprite_positions(
+    rows: int,
+    cols: int,
+    frame_bboxes: list[tuple[int, int, int, int]],
+    sprite_shapes: list[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    placed_rects = frame_bboxes[:]
