+        mask = _frame_mask_from_bbox((rows, cols), bbox)
+        grid[mask] = color
+    for color, sprite, (r0, c0) in zip(FRAME_COLORS, sprites, sprite_positions):
+        view = grid[r0 : r0 + sprite.shape[0], c0 : c0 + sprite.shape[1]]
+        view[sprite] = color
+    return grid
