+RECT_W_RANGE = (6, 9)
+MARGIN_RANGE = (1, 3)
+COLOR_COUNT_OPTIONS = (3, 4)
+TIE_BRANCH_PROB = 0.55
+MAX_ATTEMPTS = 500
+
+
+def _parity_cell_counts(h: int, w: int) -> tuple[int, int]:
+    area = h * w
+    return (area + 1) // 2, area // 2
+
