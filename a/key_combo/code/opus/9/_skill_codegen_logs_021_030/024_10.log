        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "rectangle must be monochrome"

        interior = out[r0 + 1 : r1, c0 + 1 : c1]
        rows, cols = np.indices(interior.shape)
        interior[(rows + cols) % 2 == 0] = bg

