spec:
  grid: 6-9 rows x 8-12 cols
  background: any color except red(2), teal(8), grey(5); orange(7) [observed]
  markers:
    count: 6-10 isolated single-pixel foreground dots
    isolation: every marker has only background in its 4-connected neighbors
    colors: 3-4 distinct non-background colors, randomly assigned; may overlap with output cycle
    density: ~0.09-0.15 of total cells
