+def _gray_component(grid: np.ndarray) -> set[tuple[int, int]]:
+    pts = [tuple(map(int, rc)) for rc in np.argwhere(grid == CHEVRON)]
+    assert pts, "expected one gray chevron"
+    start = pts[0]
