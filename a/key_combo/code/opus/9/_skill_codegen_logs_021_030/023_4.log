+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _find_segments(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    segments: list[dict] = []
+    mask = (grid != BG) & (grid != CHEVRON)
+    for r in range(h):
+        c = 0
+        while c < w:
+            if not mask[r, c]:
+                c += 1
+                continue
+            color = int(grid[r, c])
+            c0 = c
+            while c + 1 < w and int(grid[r, c + 1]) == color:
+                c += 1
+            c1 = c
+            assert c1 > c0, "horizontal line segments must be length >= 2"
+            segments.append(
+                {
+                    "row": int(r),
+                    "start": int(c0),
+                    "end": int(c1),
+                    "length": int(c1 - c0 + 1),
+                    "color": color,
+                }
+            )
+            c += 1
+    segments.sort(key=lambda seg: seg["row"])
+    return segments
+
+
+def _bottom_gray_by_col(grid: np.ndarray) -> dict[int, int]:
+    cols: dict[int, int] = {}
+    h, w = grid.shape
+    for c in range(w):
+        rows = np.flatnonzero(grid[:, c] == CHEVRON)
+        if len(rows) > 0:
+            cols[int(c)] = int(rows.max())
+    return cols
