+
+    min_top = rows[-1] + 3
+    min_height = min_top + arm_len + 1
+    if min_height > 26:
+        return None
+    height = random.randint(max(18, min_height), 26)
+    chevron_top = random.randint(min_top, height - arm_len - 1)
+    orientation = random.choice(("caret", "vee"))
