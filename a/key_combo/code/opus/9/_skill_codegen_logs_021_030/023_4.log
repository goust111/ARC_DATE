+    if orientation == "caret":
+        center = left + arm_len - 1
+        for k in range(arm_len):
+            cells.add((top + k, center - k))
+            cells.add((top + k, center + k))
+    else:
+        center = left + arm_len - 1
+        for k in range(arm_len):
+            offset = arm_len - 1 - k
+            cells.add((top + k, center - offset))
+            cells.add((top + k, center + offset))
+    return sorted(cells)
