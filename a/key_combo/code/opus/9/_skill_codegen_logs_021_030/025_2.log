+STEP_LIMIT = 200
+INTERIOR_SIZES = (3, 5, 7)
+GEN_ATTEMPTS = 400
+
+
+def _point_in_bbox(point: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = point
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
+
