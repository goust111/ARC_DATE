+def _on_ring(point: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = point
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1 and (r in (r0, r1) or c in (c0, c1))
