+    comps: list[list[tuple[int, int]]] = []
+    for r in range(height):
+        for c in range(width):
+            if seen[r, c] or int(grid[r, c]) != GREY:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
