+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+
+GRID_ROWS = (18, 26)
+GRID_COLS = (18, 26)
+GROUP_COUNT_OPTIONS = (3, 4)
+STEP_RANGE = (2, 4)
