0057: def main(grid: np.ndarray) -> np.ndarray:
0058:     """List the colors of overlaid straight lines in their only possible bottom-to-top crossing order.
0059: 
0060:     Input structure
0061:     The background is the dominant color. Every foreground color is the visible part
0062:     of one full one-cell-thick horizontal, vertical, or 45-degree diagonal line.
0063:     Higher lines may hide pixels of lower lines at crossings.
0064: 
0065:     Rule
0066:     Recover each full line from its visible collinear pixels. At any cell where
0067:     multiple recovered lines cross, the visible color is above every other line
0068:     through that cell. Return the unique ordering of all line colors that respects
0069:     those above/below constraints and whose consecutive colors are lines that
0070:     geometrically cross.
0071: 
0072:     Key insight
0073:     The visible crossing colors give a partial layer order, and the intended answer
0074:     is the unique Hamiltonian chain through the line-intersection graph from the
0075:     bottom layer to the top layer.
0076:     """
0077:     g = np.asarray(grid, dtype=int)
0078:     assert g.ndim == 2
0079: 
0080:     bg = get_bg(g)
0081:     lines = _infer_lines(g, bg)
0082:     colors = list(lines)
0083:     below_edges: set[tuple[int, int]] = set()
0084:     intersects: dict[int, set[int]] = {color: set() for color in colors}
0085: 
0086:     for r in range(g.shape[0]):
0087:         for c in range(g.shape[1]):
0088:             covering = [color for color, cells in lines.items() if (r, c) in cells]
0089:             visible = int(g[r, c])
0090: 
0091:             if visible == bg:
0092:                 assert not covering
0093:                 continue
0094: 
0095:             assert visible in covering
0096:             if len(covering) < 2:
0097:                 continue
0098: 
0099:             for a, b in combinations(covering, 2):
0100:                 intersects[a].add(b)
0101:                 intersects[b].add(a)
0102:             for color in covering:
0103:                 if color != visible:
0104:                     below_edges.add((color, visible))
0105: 
0106:     def is_valid_order(order: tuple[int, ...]) -> bool:
0107:         positions = {color: i for i, color in enumerate(order)}
0108:         if any(positions[below] >= positions[above] for below, above in below_edges):
0109:             return False
0110:         return all(order[i + 1] in intersects[order[i]] for i in range(len(order) - 1))
0111: 
0112:     valid_orders = [order for order in permutations(colors) if is_valid_order(order)]
0113:     assert len(valid_orders) == 1
0114:     return np.array([valid_orders[0]], dtype=int)
