+
+def _ring_cells_at_radius(
+    shape: tuple[int, int],
+    center: tuple[int, int],
+    radius: int,
+) -> set[tuple[int, int]]:
+    h, w = shape
+    r0, c0 = center
+    q = int(radius)
+    cells: set[tuple[int, int]] = set()
+
+    for c in range(c0 - q, c0 + q + 1):
+        if 0 <= r0 - q < h and 0 <= c < w:
+            cells.add((r0 - q, c))
+        if 0 <= r0 + q < h and 0 <= c < w:
+            cells.add((r0 + q, c))
+    for r in range(r0 - q, r0 + q + 1):
+        if 0 <= r < h and 0 <= c0 - q < w:
+            cells.add((r, c0 - q))
+        if 0 <= r < h and 0 <= c0 + q < w:
+            cells.add((r, c0 + q))
+    return cells
+
+
