0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Replace the outlined object with the outside contour of that outline in the marker color.
0020: 
0021:     Input structure:
0022:     - A dominant background surrounds one 8-connected foreground outline.
0023:     - The outline is the unique largest foreground color.
0024:     - One or more smaller interior colors are inside the outline; the marker color
0025:       is the unique smallest non-outline color.
0026: 
0027:     Rule:
0028:     - Erase all original foreground pixels to background.
0029:     - Paint every background pixel that is 4-adjacent to the outline with the
0030:       marker color.
0031:     - Keep the grid shape unchanged.
0032: 
0033:     Key insight: The colored interior marker supplies the paint color, while the
0034:     largest outline supplies only the contour whose outside edge is traced.
0035:     """
0036:     g = np.asarray(grid, dtype=int)
0037:     bg = int(get_bg(g))
