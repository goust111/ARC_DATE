+    assert (endpoints[1][0] - center[0], endpoints[1][1] - center[1]) == (-dr, -dc)
+    diag = 1 if dr * dc > 0 else -1
+    step = abs(dr)
+    seeds = _seed_triplet(center, step, diag)
+    assert seeds == set(pts), "seed spacing must be equal on both sides of the center"
+    return {
