+    for r, c in cells:
+        grid[r, c] = int(color)
+
+
+def _render_from_order(
+    shape: tuple[int, int],
+    bg: int,
+    groups: list[dict],
+    order: list[int],
+) -> np.ndarray:
+    out = np.full(shape, int(bg), dtype=int)
+    by_color = {group["color"]: group for group in groups}
+
