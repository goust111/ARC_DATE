0138: def _gen_line_cells(S, kind, value):
0139:     """Return set of (r,c) for a line of given kind/value on an SxS grid."""
0140:     if kind == 'H':
0141:         return {(value, c) for c in range(S)}
0142:     if kind == 'V':
0143:         return {(r, value) for r in range(S)}
0144:     if kind == 'D':  # diag_down: r - c = value
0145:         return {(r, r - value) for r in range(S) if 0 <= r - value < S}
0146:     if kind == 'U':  # diag_up: r + c = value
0147:         return {(r, value - r) for r in range(S) if 0 <= value - r < S}
0148:     raise ValueError(kind)
