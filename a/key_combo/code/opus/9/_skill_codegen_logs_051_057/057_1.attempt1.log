+    order: list[int] = []
+    frontier = sorted(color for color in colors if indegree[color] == 0)
+    while frontier:
+        if len(frontier) != 1:
+            return None
+        color = frontier.pop()
+        order.append(color)
+        for nxt in sorted(outgoing[color]):
