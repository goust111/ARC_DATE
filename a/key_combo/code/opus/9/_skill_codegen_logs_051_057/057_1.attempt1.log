0151: def _lines_cross(S, k1, v1, k2, v2):
0152:     """Check if two lines cross within an SxS grid."""
0153:     if k1 == k2:
0154:         return False  # same-kind lines are parallel
0155:     c1 = _gen_line_cells(S, k1, v1)
0156:     c2 = _gen_line_cells(S, k2, v2)
0157:     return bool(c1 & c2)
