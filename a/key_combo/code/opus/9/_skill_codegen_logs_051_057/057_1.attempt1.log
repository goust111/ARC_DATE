+def _seed_triplet(center: tuple[int, int], step: int, diag: int) -> set[tuple[int, int]]:
+    r, c = center
+    d = int(step)
+    s = int(diag)
+    return {
+        (r, c),
+        (r - d, c - s * d),
+        (r + d, c + s * d),
+    }
