+    r, c = center
+    d = int(step)
+    s = int(diag)
+    return {
+        (r, c),
+        (r - d, c - s * d),
+        (r + d, c + s * d),
+    }
+
+
+def _infer_group(color: int, coords: np.ndarray) -> dict:
