+    comps = find_components(
+        grid,
+        bg=BG,
+        colors=fg_colors,
+        connectivity=4,
+        monochromatic=False,
+        return_format="dict",
+    )
+    matches = []
+    for comp in comps:
+        b = tuple(map(int, comp["bbox"]))
+        r0, c0, r1, c1 = b
+        h, w = _bbox_dims(b)
+        if int(comp["area"]) != h * w:
+            continue
+        if not ((r0 == 0 and c0 == 0) or (r1 == H - 1 and c1 == W - 1)):
+            continue
