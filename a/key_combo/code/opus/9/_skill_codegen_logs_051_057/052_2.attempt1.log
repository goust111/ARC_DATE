+def _find_template_component(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    H, W = grid.shape
+    fg_colors = [int(c) for c in np.unique(grid) if c not in (BG, OCCLUDER)]
+    comps = find_components(
+        grid,
+        bg=BG,
+        colors=fg_colors,
+        connectivity=4,
+        monochromatic=False,
