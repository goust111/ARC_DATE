+def _dihedral_variants(template: np.ndarray) -> list[dict]:
+    variants: list[dict] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rotated = np.rot90(template, k)
+        for reflected, arr in ((False, rotated), (True, np.fliplr(rotated))):
+            key = (arr.shape, arr.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(
+                {
+                    "array": arr.copy(),
+                    "rot": k,
+                    "reflected": reflected,
+                    "shape": arr.shape,
+                }
+            )
+    return variants
+
+
+def _border_signature(arr: np.ndarray) -> tuple:
+    h, w = arr.shape
+    coords = []
+    for c in range(w):
+        coords.append((0, c))
+    for r in range(1, h - 1):
+        coords.append((r, w - 1))
+    if h > 1:
+        for c in range(w - 1, -1, -1):
+            coords.append((h - 1, c))
+    if w > 1:
+        for r in range(h - 2, 0, -1):
+            coords.append((r, 0))
+    return (arr.shape, tuple(int(arr[r, c]) for r, c in coords))
+
