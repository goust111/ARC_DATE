+        rotated = np.rot90(template, k)
+        for reflected, arr in ((False, rotated), (True, np.fliplr(rotated))):
+            key = (arr.shape, arr.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(
+                {
+                    "array": arr.copy(),
+                    "rot": k,
+                    "reflected": reflected,
+                    "shape": arr.shape,
+                }
+            )
+    return variants
