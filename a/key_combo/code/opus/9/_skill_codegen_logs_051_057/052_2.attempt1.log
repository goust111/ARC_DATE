+    random.shuffle(pool)
+    unoccluded_ids = pool[:unoccluded_count]
+    if len(unoccluded_ids) < unoccluded_count:
+        while len(unoccluded_ids) < unoccluded_count:
+            candidate = random.randrange(len(variants))
+            if candidate not in unoccluded_ids:
