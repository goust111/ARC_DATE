+        h, w = arr.shape
+        row_lo = max(0, br1 - h + 2)
+        row_hi = min(br0 - 1, H - h)
+        col_lo = max(0, bc1 - w + 2)
+        col_hi = min(bc0 - 1, W - w)
+        if row_lo > row_hi or col_lo > col_hi:
+            continue
+        for r0 in range(row_lo, row_hi + 1):
