            if _GEN_APPEND_TOTAL_MIN <= _gen_target - _gen_base <= _GEN_APPEND_TOTAL_MAX:
                _gen_options.append(_gen_combo)
    _GEN_COMBOS_BY_TOTAL[_gen_target] = tuple(_gen_options)


