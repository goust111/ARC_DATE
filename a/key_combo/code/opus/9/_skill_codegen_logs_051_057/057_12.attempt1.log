+                    choices.remove(int(band_colors[r - 1, c]))
+                if c > 0 and band_colors[r, c - 1] in choices:
+                    choices.remove(int(band_colors[r, c - 1]))
+                if not choices:
+                    break
+                band_colors[r, c] = random.choice(choices)
+            else:
+                continue
+            break
+        else:
