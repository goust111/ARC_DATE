# Missing-mask dimensions and occupancy.
MISSING_H_RANGE = (2, 4)
MISSING_W_RANGE = (6, 10)
MISSING_CELL_RANGE = (6, 13)
SINGLE_MISSING_MAX_W = 8
SINGLE_MISSING_PROB = 0.35

