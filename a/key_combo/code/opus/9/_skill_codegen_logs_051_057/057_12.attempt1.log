+def _validate_grid(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    assert isinstance(grid, np.ndarray)
+    assert grid.ndim == 2
+    h, w = grid.shape
+    assert h % 2 == 0 and 1 <= h <= 30 and 1 <= w <= 30
+    assert np.all(grid != BLACK), "input must be dense non-black"
+
