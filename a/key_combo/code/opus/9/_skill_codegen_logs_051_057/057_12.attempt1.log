+        for cell in cells:
+            if all(abs(cell[0] - r) + abs(cell[1] - c) != 1 for r, c in chosen):
+                chosen.append(cell)
+                if len(chosen) == count:
+                    break
+        if len(chosen) != count:
+            continue
+
+        mask = np.zeros((mask_h, mask_w), dtype=bool)
+        for r, c in chosen:
+            mask[r, c] = True
+
+        if _bbox(mask) != (0, 0, mask_h - 1, mask_w - 1):
