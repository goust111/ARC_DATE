+    for stripe_color, segs in by_color.items():
+        assert len(segs) == 2, f"expected exactly one segment pair for stripe color {stripe_color}"
+        for r, c in _pair_fill_cells(segs[0], segs[1], out.shape):
+            if out[r, c] != ORANGE:
+                out[r, c] = RED
+    return out
