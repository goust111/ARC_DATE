+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+ORANGE = 7
+RED = 2
+STRIPE_PALETTE = (1, 3, 4, 6, 8, 9)
+NOISE_PALETTE = (1, 3, 4, 5, 6, 8, 9)
+
+GRID_H_RANGE = (16, 22)
+GRID_W_RANGE = (16, 22)
+STRIPE_COUNT_RANGE = (3, 5)
