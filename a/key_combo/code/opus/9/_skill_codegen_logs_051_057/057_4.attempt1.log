+
+def _propose_pair(stripe: dict, *, by_rows: bool, height: int, width: int) -> tuple[dict, dict, set[tuple[int, int]]] | None:
+    span = int(stripe["width"])
+    shifts = [shift for shift in (2, 3) if shift <= span - 2]
+    if not shifts:
+        return None
+    shift = random.choice(shifts)
