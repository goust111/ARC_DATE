+    assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == MARKER_COLOR), "gray marker must be solid"
+    assert int(np.count_nonzero(grid == MARKER_COLOR)) == height * width, "gray marker must be unique"
+    return height, marker_box
