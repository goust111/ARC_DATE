+
+    grid[sprite_r : sprite_r + SPRITE_SIZE, sprite_c : sprite_c + SPRITE_SIZE] = sprite
+    grid[marker_r : marker_r + scale, marker_c : marker_c + scale] = MARKER_COLOR
