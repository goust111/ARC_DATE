import numpy as np
from collections import deque,defaultdict

def path(H,W,s):
    r,c=H-1,s
    dc=1
    pts=[]
    while 0<=r<H and 0<=c<W:
        pts.append((r,c))
        nr=r-1; nc=c+dc
        if nr<0: break
        if nc<0 or nc>=W:
            dc=-dc
            nc=c+dc
        r,c=nr,nc
    return pts

def comps(mask):
    H,W=mask.shape
    lab=np.zeros((H,W),int)
    k=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and lab[r,c]==0:
          k+=1
          q=deque([(r,c)])
          lab[r,c]=k
          while q:
            x,y=q.popleft()
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              xx,yy=x+dx,y+dy
              if 0<=xx<H and 0<=yy<W and mask[xx,yy] and lab[xx,yy]==0:
                lab[xx,yy]=k; q.append((xx,yy))
    return lab,k

def analyze(H,W,s):
    pts=path(H,W,s)
    wall=np.zeros((H,W),bool)
    for r,c in pts: wall[r,c]=True
    lab,n=comps(~wall)
    g=defaultdict(set)
    for r,c in pts:
      adj={lab[rr,cc] for rr,cc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)) if 0<=rr<H and 0<=cc<W and lab[rr,cc]>0}
      for a in adj:
        for b in adj:
          if a<b:
            g[a].add(b); g[b].add(a)
    deg=sorted(len(g[i]) for i in range(1,n+1))
    return len(pts),n,deg,{i:sorted(g[i]) for i in range(1,n+1)}

for H in [15,17,19,21]:
  for W in [7,9,11]:
    if H<=W or W%2==0: continue
    for s in range(1,W-1):
      L,n,deg,g=analyze(H,W,s)
      ok=deg.count(1)==2 and deg.count(2)==n-2 if n>1 else False
      if n>=3:
        print('HWS',H,W,s,'regions',n,'deg',deg,'pathgraph',ok)
    print('---')
