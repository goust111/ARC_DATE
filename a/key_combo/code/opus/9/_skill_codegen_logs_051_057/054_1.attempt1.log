+def _trace_path(shape: tuple[int, int], start: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = start
+    dc = 1
+    path: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
