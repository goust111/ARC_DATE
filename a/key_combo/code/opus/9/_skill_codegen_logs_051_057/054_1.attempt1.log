import numpy as np
from collections import deque,defaultdict

def path(H,W,s):
    r,c=H-1,s
    dc=1
    pts=[]
    while 0<=r<H and 0<=c<W:
        pts.append((r,c))
        nr=r-1; nc=c+dc
        if nr<0: break
        if nc<0 or nc>=W:
            dc=-dc
            nc=c+dc
        r,c=nr,nc
    return pts

def comps(mask):
    H,W=mask.shape
    lab=np.zeros((H,W),int)
    k=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and lab[r,c]==0:
          k+=1
          q=deque([(r,c)])
          lab[r,c]=k
          while q:
            x,y=q.popleft()
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              xx,yy=x+dx,y+dy
              if 0<=xx<H and 0<=yy<W and mask[xx,yy] and lab[xx,yy]==0:
                lab[xx,yy]=k; q.append((xx,yy))
    return lab,k

def analyze(H,W,s):
    pts=path(H,W,s)
    wall=np.zeros((H,W),bool)
    for r,c in pts: wall[r,c]=True
    lab,n=comps(~wall)
    g=defaultdict(set)
    for (r1,c1),(r2,c2) in zip(pts, pts[1:]):
      dr=r2-r1; dc=c2-c1
      if dr==-1 and dc==1:
        a=(r2,c1)
        b=(r1,c2)
      elif dr==-1 and dc==-1:
        a=(r2,c1)
        b=(r1,c2)
      else:
        raise
      la=lab[a] if 0<=a[0]<H and 0<=a[1]<W else 0
      lb=lab[b] if 0<=b[0]<H and 0<=b[1]<W else 0
      if la>0 and lb>0 and la"'!=lb:
        g[la].add(lb); g[lb].add(la)
    deg=sorted(len(g[i]) for i in range(1,n+1))
    return n,deg,{i:sorted(g[i]) for i in range(1,n+1)}

for H,W,s in [(15,9,1),(15,9,3),(17,9,4),(19,11,5),(21,7,5)]:
    n,deg,g=analyze(H,W,s)
    ok=deg.count(1)==2 and deg.count(2)==n-2 if n>1 else False
    print((H,W,s),'"'regions',n,'deg',deg,'pathgraph',ok,'graph',g)
