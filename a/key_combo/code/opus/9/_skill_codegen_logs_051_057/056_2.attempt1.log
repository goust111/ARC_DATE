+    if direction == "up":
+        edge_distance = r0
+        for j, other in enumerate(rects):
+            if j == idx:
+                continue
+            if other["r1"] < r0 and _overlap_1d(c0, c1, other["c0"], other["c1"]):
+                dist = r0 - other["r1"] - 1
+                if blocker is None or dist < blocker[0]:
+                    blocker = (dist, j)
