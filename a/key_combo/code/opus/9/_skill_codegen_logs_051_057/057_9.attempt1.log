+            _nearest_layer(max(abs(int(r) - center[0]), abs(int(c) - center[1])), spacing)
+            for r, c in np.argwhere((grid != BLACK) & (grid != RED))
+        }
+    ):
+        if k <= 0:
+            continue
+        colors = [
+            int(grid[r, c])
+            for r, c in np.argwhere((grid != BLACK) & (grid != RED))
+            if _nearest_layer(max(abs(int(r) - center[0]), abs(int(c) - center[1])), spacing) == k
+        ]
