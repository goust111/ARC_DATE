+    grid: np.ndarray, wall_color: int, container: dict[str, int], col: int
+) -> bool:
+    if not (container["inner_left"] <= col <= container["inner_right"]):
+        return False
+    return bool(np.all(grid[1 : container["bottom"], col] != wall_color))
+
