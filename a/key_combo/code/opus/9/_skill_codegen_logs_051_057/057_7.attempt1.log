+        "original_containers": original_containers,
+        "shifted_containers": shifted_containers,
+        "before": before,
+        "after": after,
+        "shifted_no_markers": shifted_no_markers,
+    }
+
+
+def _valid_generated_scene(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
