+            inner_right = min(right_cols) - 1
+            if inner_left > inner_right:
+                continue
+            if not np.all(grid[top:bottom, inner_left : inner_right + 1] == bg):
+                continue
+
+            key = (top, bottom, left, right, inner_left)
+            if key in seen:
+                continue
+            seen.add(key)
+            containers.append(
+                {
+                    "top": int(top),
+                    "bottom": int(bottom),
+                    "left": int(left),
+                    "right": int(right),
+                    "inner_left": int(inner_left),
+                    "inner_right": int(inner_right),
