+
+
+def _container_columns_after_wave(left: int, right: int, depth: int) -> tuple[list[int], list[int], int, int]:
+    left_cols: list[int] = []
+    right_cols: list[int] = []
+    for d in range(depth, 0, -1):
+        shift = _wave_shift(d)
+        left_cols.append(left + shift)
+        right_cols.append(right + shift)
