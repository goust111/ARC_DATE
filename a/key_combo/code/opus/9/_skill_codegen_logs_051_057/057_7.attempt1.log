+        gaps = [random.randint(3, 5) for _ in range(num_containers - 1)]
+        width_cap = 24
+        extra_slack = 8
+        min_canvas = 15
+    else:
+        widths = [random.randint(3, 4) for _ in range(num_containers)]
+        gaps = [random.randint(3, 4) for _ in range(num_containers - 1)]
+        width_cap = 28
+        extra_slack = 7
+        min_canvas = 18
