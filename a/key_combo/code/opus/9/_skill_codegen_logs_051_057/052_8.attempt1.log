+            continue
+        match = _match_copy(frame["patch"], variants)
+        r0, c0, r1, c1 = frame["bbox"]
+        rr, cc = match["local_pos"]
+        color = match["correct_color"]
+        out[r0 + rr, c0 + cc] = color
+        out[r0 + 1 : r1, c0 + 1 : c1] = color
