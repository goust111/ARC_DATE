+            rr, cc = match["local_pos"]
+            h, w = frame["patch"].shape
+            if (rr, cc) in {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}:
+                return False
+
+        if len(matches) != len(set(matches)):
+            return False
+        if len(set(fill_colors)) < 2:
+            return False
+        if len(shapes) < 2:
+            return False
+        if flips != {False, True}:
+            return False
+
+        out = main(grid)
+        if out.shape != grid.shape:
+            return False
