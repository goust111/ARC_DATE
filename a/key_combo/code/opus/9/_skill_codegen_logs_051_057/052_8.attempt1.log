+    def search(i: int) -> bool:
+        if i == len(order):
+            return True
+        idx = order[i]
+        ph, pw = shapes[idx]
+        candidates = [(r, c) for r in range(h - ph + 1) for c in range(w - pw + 1)]
+        random.shuffle(candidates)
+        for r, c in candidates:
