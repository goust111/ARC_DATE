+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _border_mask(shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _border_coords(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    coords: list[tuple[int, int]] = []
+    for c in range(w):
+        coords.append((0, c))
+    for r in range(1, h - 1):
+        coords.append((r, w - 1))
+    for c in range(w - 1, -1, -1):
+        coords.append((h - 1, c))
+    for r in range(h - 2, 0, -1):
+        coords.append((r, 0))
+    return coords
+
+
+def _noncorner_border_coords(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
+    return [pos for pos in _border_coords(shape) if pos not in corners]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
