+ORANGE = 7
+ACCENT_COLORS = (RED, GREEN, ORANGE)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (16, 23)
+GRID_W_RANGE = (16, 23)
+COPY_COUNT_OPTIONS = (3, 4)
+TEMPLATE_SHAPES = ((4, 5), (5, 4))
+PLACEMENT_GAP = 1
+MAX_TEMPLATE_ATTEMPTS = 300
+MAX_LAYOUT_ATTEMPTS = 200
+MAX_GENERATION_ATTEMPTS = 600
