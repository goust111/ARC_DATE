+        if positions is None:
+            continue
+        order = list(range(len(patches)))
+        random.shuffle(order)
+        grid = np.zeros((h, w), dtype=int)
+        for idx in order:
+            patch = patches[idx]
+            r0, c0 = positions[idx]
+            ph, pw = patch.shape
+            if np.any(grid[r0 : r0 + ph, c0 : c0 + pw] != BLACK):
