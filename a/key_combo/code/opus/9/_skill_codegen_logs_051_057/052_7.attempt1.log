+        if not off_route_fills:
+            continue
+        if stats["painted"] < 2:
+            continue
+        if branch == "clean" and stats["obstacles"] == 0:
+            return base, markers
+        if branch == "blocked" and stats["continuations"] >= 1:
+            return base, markers
+    raise RuntimeError("failed to construct a coarse case")
