+    for r0, c0, ph, pw in piece_rects:
+        piece = masked[r0 : r0 + ph, c0 : c0 + pw]
+        if np.all(piece == BLUE):
+            rr = r0 + ph // 2
+            cc = c0 + pw // 2
+            masked[rr, cc] = original[rr, cc]
