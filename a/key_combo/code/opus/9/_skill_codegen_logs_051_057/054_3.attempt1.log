+        r0, c0 = random.choice(positions)
+        _paste(canvas, patch, r0, c0)
+    return canvas
+
+
+def _attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    rect_h = random.randint(6, 11)
+    rect_w = random.randint(6, 11)
