+    ordered: list[tuple[int, int]] = []
+    for dim in dims:
+        if dim not in seen:
+            seen.add(dim)
+            ordered.append(dim)
+    ordered.sort(key=lambda x: (-x[0] * x[1], -x[0], -x[1]))
+    return ordered
+
+
+def _solve_stats_from_pieces(
+    pieces: list[np.ndarray],
+    canvas_shape: tuple[int, int],
+    missing: tuple[int, int],
+    corner: str,
