+    expected = _cycle_recolor(_fill_and_validate_rings(masked)[0], ring_colors)
+    if not np.array_equal(solved, expected):
+        return None
+    if not np.array_equal(main(scattered), expected):
+        return None
+
+    return scattered, expected
