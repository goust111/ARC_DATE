+
+def _pick_two_distinct(lo: int, hi: int) -> tuple[int, int]:
+    a, b = sorted(random.sample(range(lo, hi + 1), 2))
+    return int(a), int(b)
+
+
+def _build_attempt() -> tuple[np.ndarray, dict[str, object]] | None:
