+
+
+def _simulate_seed_drop(grid: np.ndarray, col: int) -> tuple[int, int]:
+    h = grid.shape[0]
+    c = int(col)
+    r = 0
+    while r + 1 < h and int(grid[r + 1, c]) == BG:
+        r += 1
+    return int(r), c
+
+
+def _solve_details(grid: np.ndarray) -> dict[str, object]:
