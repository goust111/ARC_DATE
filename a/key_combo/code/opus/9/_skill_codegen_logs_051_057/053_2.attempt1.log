    return cols


def _dilate_occupied(occupied: np.ndarray) -> np.ndarray:
    """Return a mask that is True wherever occupied or any 8-neighbor is occupied."""
    dilated = occupied.copy()
    dilated[1:, :] |= occupied[:-1, :]
