+    for color, delta in ((BLUE, -1), (RED, 1)):
+        group = [rec for rec in records if rec["color"] == color]
+        group.sort(
+            key=lambda rec: (
+                float(rec["distance_to_edge"]),
+                float(rec["centroid"]),
+                int(rec["bbox"][0]),
+                int(rec["bbox"][1]),
+                int(rec["area"]),
