+    if expect_collision != blocked_colors:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    scenario = random.choices(
+        [
+            "blue_collision",
+            "red_collision",
+            "both_collision",
+            "no_collision",
+        ],
+        weights=[3, 3, 2, 2],
+        k=1,
