+
+def _well_separated(a: np.ndarray, b: np.ndarray, shape: tuple[int, int]) -> bool:
+    return _coords_with_margin(a, shape).isdisjoint(_coords_set(b))
+
+
+def _blue_or_red(coords: np.ndarray, half_h: int) -> int:
