+    built = _build_input_from_common(common_records, half_h, w)
+    if built is None:
+        return None
+    inp, _meta = built
+    if not _validate(inp, expect_collision):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
