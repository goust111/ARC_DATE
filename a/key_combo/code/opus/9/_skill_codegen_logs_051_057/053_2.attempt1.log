+        "blue_collision": [(BLUE, True), (RED, False)],
+        "red_collision": [(BLUE, False), (RED, True)],
+        "both_collision": [(BLUE, True), (RED, True)],
+        "no_collision": [(BLUE, False), (RED, False), (random.choice([BLUE, RED]), False)],
