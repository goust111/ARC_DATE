+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+FG_COLORS = (BLUE, RED, GREEN)
+
+CARDINAL_STEPS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIAGONAL_STEPS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+ALL8_STEPS = CARDINAL_STEPS + DIAGONAL_STEPS
