+    return _stamp_output(tile, lower.shape, blocks, visibility)
+
+
+def _sample_tile_shape() -> tuple[int, int]:
+    mode = random.choice(("odd_h", "odd_w", "both_odd"))
+    odd_h = (3, 5, 7)
