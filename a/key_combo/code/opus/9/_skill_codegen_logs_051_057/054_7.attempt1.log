+
+
+def _stamp_output(
+    tile: np.ndarray,
+    lower_shape: tuple[int, int],
+    blocks: list[tuple[int, int]],
+    visibility: np.ndarray,
+) -> np.ndarray:
+    tile_h, tile_w = tile.shape
