+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+
+    sep_rows = _full_grey_rows(g)
+    assert len(sep_rows) == 1, "expected exactly one full grey separator row"
+    sep = int(sep_rows[0])
+
+    top = g[:sep]
