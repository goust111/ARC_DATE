spec:
  grid: 13x13 [observed, all examples identical]
  base_colors: black (0) and blue (1) fill entire grid except marker pixels
  blue_walls:
    role: 4-connected path/chain structures that partition the black background into regions
    components: 1-5, total 43-50 cells (25-30% of grid)
    topology: mostly degree-2 chains (78-95%), endpoints 2-10, branch points 0-2
  black_regions:
    count: 3-5 components via 4-connectivity
    size_range: 2-110 cells; one large exterior region + smaller interior pockets
  markers:
    count: 3-7 pixels total, 3-6 distinct colors from {2..9}
