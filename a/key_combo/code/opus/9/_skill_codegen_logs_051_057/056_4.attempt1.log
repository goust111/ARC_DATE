+        insets[r] = min(max_inset, insets[r + 1] + int(rng.choice([0, 0, 1])))
+    for r in range(center + extra_center + 1, h):
+        insets[r] = min(max_inset, insets[r - 1] + int(rng.choice([0, 0, 1])))
