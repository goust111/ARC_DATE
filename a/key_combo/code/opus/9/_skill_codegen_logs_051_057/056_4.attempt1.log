+def _find_monochrome_components(grid: np.ndarray, colors: tuple[int, ...]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    wanted = set(map(int, colors))
+    seen = np.zeros((H, W), dtype=bool)
+    components = []
+
+    for r0 in range(H):
+        for c0 in range(W):
+            color = int(g[r0, c0])
+            if color not in wanted or seen[r0, c0]:
+                continue
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords = []
+            while q:
