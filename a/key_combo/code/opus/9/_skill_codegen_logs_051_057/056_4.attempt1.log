+def _find_monochrome_components(grid: np.ndarray, colors: tuple[int, ...]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    wanted = set(map(int, colors))
+    seen = np.zeros((H, W), dtype=bool)
+    components = []
+
