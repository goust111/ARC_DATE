+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    return _bbox_from_coords(coords)
+
+
+def _find_monochrome_components(grid: np.ndarray, colors: tuple[int, ...]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    wanted = set(map(int, colors))
+    seen = np.zeros((H, W), dtype=bool)
+    components = []
+
+    for r0 in range(H):
+        for c0 in range(W):
+            color = int(g[r0, c0])
+            if color not in wanted or seen[r0, c0]:
+                continue
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            coords = []
+            while q:
+                r, c = q.popleft()
+                coords.append((r, c))
+                for dr, dc in DIR4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox_from_coords(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return components
+
+
+def _is_filled_rectangle(grid: np.ndarray, component: dict) -> bool:
