+    H = int(rng.integers(GEN_GRID_SIDE[0], GEN_GRID_SIDE[1]))
+    W = int(rng.integers(GEN_GRID_SIDE[0], GEN_GRID_SIDE[1]))
+    obj_h_min = max(GEN_OBJECT_H[0], occ_h + 3)
+    obj_w_min = max(GEN_OBJECT_W[0], min(W - 4, 9))
