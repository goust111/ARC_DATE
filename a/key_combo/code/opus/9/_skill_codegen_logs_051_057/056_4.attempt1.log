+GEN_LARGE_OCCLUDERS = [(4, 4), (4, 5), (5, 5)]
+GEN_SURVIVOR_PATTERNS = {
+    2: [[(3, 3), (2, 5)], [(2, 5), (3, 4)], [(3, 4), (3, 5)]],
+    3: [[(3, 3), (3, 3), (2, 5)], [(2, 5), (3, 4), (3, 4)], [(3, 4), (3, 4), (3, 5)]],
