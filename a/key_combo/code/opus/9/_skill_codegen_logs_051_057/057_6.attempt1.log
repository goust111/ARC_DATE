+        raise AssertionError("grey counts must differ")
+    winner_idx = 0 if sprites[0]["grey_count"] > sprites[1]["grey_count"] else 1
+    loser_idx = 1 - winner_idx
+    return sprites[winner_idx], sprites[loser_idx]
+
