+def _mark_rect(mask: np.ndarray, r0: int, c0: int, h: int, w: int, pad: int = 1) -> None:
+    H, W = mask.shape
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(H, r0 + h + pad)
+    cc1 = min(W, c0 + w + pad)
+    mask[rr0:rr1, cc0:cc1] = True
