+        raise AssertionError("expected eight candidate sprites")
+    for side, comps in grouped.items():
+        if len(comps) != 2:
+            raise AssertionError(f"need exactly two components for {side}")
+        if sorted(comp["grey_count"] for comp in comps) != [1, 2]:
