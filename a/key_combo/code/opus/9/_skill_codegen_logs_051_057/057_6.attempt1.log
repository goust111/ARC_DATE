+        valids = _valid_rotations(patch, place_side, target, bg=0)
+        if len(valids) != 1:
+            raise AssertionError("template lost unique rotation after coloring")
+        sprites.append({"patch": patch, "grey_count": grey_count, "place_side": place_side})
