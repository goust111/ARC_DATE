+    top = int(_RNG.integers(1, 8))
+    bottom = int(_RNG.integers(1, 9))
+    left = int(_RNG.integers(1, 5))
+    right = int(_RNG.integers(1, 5))
+
+    height = top + sprite_h + bottom
