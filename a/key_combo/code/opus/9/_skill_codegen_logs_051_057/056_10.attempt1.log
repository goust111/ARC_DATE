+import heapq
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+PINK = 6
+CYAN = 8
+COLORS = (RED, GREEN)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+SENTINEL_BEND = (-1, -1)
+GEN_ATTEMPTS = 400
