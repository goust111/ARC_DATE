+    assert pts.shape[0] == 2, "expected exactly two control markers"
+    (r0, c0), (r1, c1) = [tuple(map(int, p)) for p in pts]
+    h, w = grid.shape
+    forbidden = np.zeros((h, w), dtype=bool)
+    if c0 == c1:
+        phase = min(r0, r1)
+        period = abs(r0 - r1)
+        assert period >= 1
+        for r in range(h):
+            if (r - phase) % period == 0:
+                forbidden[r, :] = True
+        kind = "rows"
+    else:
+        assert r0 == r1, "control markers must share a row or a column"
+        phase = min(c0, c1)
+        period = abs(c0 - c1)
+        assert period >= 1
+        for c in range(w):
+            if (c - phase) % period == 0:
+                forbidden[:, c] = True
+        kind = "cols"
+    return {"kind": kind, "period": period, "forbidden": forbidden}
+
+
+def _step_state(state, ndir):
+    r, c, prev_dir, turns, bend_r, bend_c = state
+    dr, dc = DIRS[ndir]
+    nr, nc = r + dr, c + dc
+    if prev_dir == -1:
