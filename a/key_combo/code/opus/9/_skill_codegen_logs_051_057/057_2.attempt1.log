+        ref_left = out[2 * line_row - bottom : 2 * line_row - top + 1, left]
+        ref_right = out[2 * line_row - bottom : 2 * line_row - top + 1, right]
+        ref_bottom = out[2 * line_row - bottom, left : right + 1]
