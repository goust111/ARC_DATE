  marker:
    count: exactly 1 pixel, on row 0
  wall_structures:
    total_components: 1-3 connected components of wall color
    closed_U: 0 or 1 U-shaped container; two vertical side-bars + continuous bottom segment, empty bg interior
    broken_U: 0-1 incomplete sibling branch; two vertical sides or a side-bar fragment with a bottom segment that has a gap or missing side, so it cannot hold the falling marker
    interior_size: 2-3 rows x 1-5 cols
