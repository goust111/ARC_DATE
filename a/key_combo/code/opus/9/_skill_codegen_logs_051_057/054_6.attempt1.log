+                    if blocked[tr, tc]:
+                        ok = False
+                        break
+                if ok:
+                    valid.append((r0, c0))
+        if not valid:
+            return None
+        top, left = random.choice(valid)
+        placed_shape = dict(shape)
+        placed_shape["top"] = top
+        placed_shape["left"] = left
+        placed.append(placed_shape)
+        for rr, cc in shape["padded"]:
+            blocked[top + rr, left + cc] = True
+        for rr, cc in shape["filled"]:
+            occupied[top + rr, left + cc] = True
+
+    return placed, occupied, blocked
+
+
+def _build_grid(
+    shape: tuple[int, int],
+    placements: list[dict],
+    outline_colors: list[int],
+    fill_specs: list[dict],
+    noise: list[tuple[int, int, int]],
+) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.zeros(shape, dtype=int)
+    expected = np.zeros(shape, dtype=int)
+
+    for placed, outline_color, spec in zip(placements, outline_colors, fill_specs):
+        top = placed["top"]
+        left = placed["left"]
+        for rr, cc in placed["outline"]:
+            inp[top + rr, left + cc] = outline_color
+            expected[top + rr, left + cc] = outline_color
+        for rr, cc in placed["interior"]:
+            expected[top + rr, left + cc] = spec["winner"]
+        for (rr, cc), color in spec["markers"]:
+            inp[top + rr, left + cc] = color
+
+    for r, c, color in noise:
+        inp[r, c] = color
+
+    return inp, expected
