+
+def _pick_fill_specs(placements: list[dict], marker_pool: list[int]) -> list[dict] | None:
+    if len(marker_pool) < len(placements) + 2:
+        return None
+
+    winners = random.sample(marker_pool, len(placements))
+    specs: list[dict] = []
+    for idx, placed in enumerate(placements):
+        interior = placed["interior"]
+        color_count = random.choice([2, 3])
+        available = [c for c in marker_pool if c != winners[idx]]
+        others = random.sample(available, color_count - 1)
+        colors = [winners[idx], *others]
+
+        max_markers = min(len(interior) - MIN_INTERIOR_BLACK_CELLS, 7)
+        if max_markers < color_count + 2:
+            return None
+        winner_low = max(color_count + 1, 3)
+        winner_high = min(5, max_markers - (color_count - 1))
+        if winner_high < winner_low:
+            return None
+        winner_count = random.randint(winner_low, winner_high)
+        other_counts: list[int] = []
+        remaining = max_markers - winner_count
+        for other_idx in range(color_count - 1):
+            slots_left = color_count - 2 - other_idx
+            high = min(winner_count - 1, remaining - slots_left)
+            if high < 1:
+                return None
+            count = random.randint(1, high)
+            other_counts.append(count)
+            remaining -= count
