+    pinch_weights = [2 if idx in (0, height - 1) else 3 for idx in pinch_choices]
+    pinch_row = random.choices(pinch_choices, weights=pinch_weights, k=1)[0]
+
+    left = [0] * height
+    right = [0] * height
+    left[pinch_row] = 0
+    right[pinch_row] = 1
