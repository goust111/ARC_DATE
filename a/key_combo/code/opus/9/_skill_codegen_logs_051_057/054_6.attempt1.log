+        random.shuffle(chosen_cells)
+        markers: list[tuple[tuple[int, int], int]] = []
+        cursor = 0
+        for color, count in zip(colors, counts):
+            for cell in chosen_cells[cursor : cursor + count]:
+                markers.append((cell, color))
+            cursor += count
+
+        specs.append(
