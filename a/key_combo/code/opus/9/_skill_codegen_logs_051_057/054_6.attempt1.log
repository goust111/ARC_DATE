+    for step in (-1, 1):
+        prev = pinch_row
+        row = prev + step
+        while 0 <= row < height:
+            left[row] = left[prev] - random.choice([0, 1, 1])
+            right[row] = right[prev] + random.choice([0, 1, 1])
+            prev = row
+            row += step
