+        counts: Counter[int] = Counter()
+        spans: list[tuple[int, int, int]] = []
+        for r, c0, c1 in obj["rows"]:
+            if c1 - c0 > 1:
+                inner = g[r, c0 + 1 : c1]
+                for value in inner:
+                    value = int(value)
+                    if value != 0 and value != color:
