+    blocked: set[tuple[int, int]] = set()
+    for cell in shuffled:
+        if cell in blocked:
+            continue
+        chosen.append(cell)
+        r, c = cell
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
