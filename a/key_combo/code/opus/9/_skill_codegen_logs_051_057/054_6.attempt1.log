+            valid = True
+            interior_cells: list[tuple[int, int]] = []
+            for r in rows:
+                cols = sorted(int(c) for c in coords[coords[:, 0] == r, 1])
+                if len(cols) != 2:
+                    valid = False
+                    break
+                c0, c1 = cols
+                if c1 <= c0:
+                    valid = False
+                    break
