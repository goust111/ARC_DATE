+        placed_shape = dict(shape)
+        placed_shape["top"] = top
+        placed_shape["left"] = left
+        placed.append(placed_shape)
+        for rr, cc in shape["padded"]:
+            blocked[top + rr, left + cc] = True
+        for rr, cc in shape["filled"]:
+            occupied[top + rr, left + cc] = True
