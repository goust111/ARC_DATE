+
+    for shape in sorted(shapes, key=lambda item: len(item["filled"]), reverse=True):
+        valid: list[tuple[int, int]] = []
+        row_min = 1 if h - shape["height"] >= 2 else 0
+        row_max = h - shape["height"] - (1 if h - shape["height"] >= 2 else 0)
+        col_min = 1 if w - shape["width"] >= 2 else 0
+        col_max = w - shape["width"] - (1 if w - shape["width"] >= 2 else 0)
+        for r0 in range(row_min, row_max + 1):
+            for c0 in range(col_min, col_max + 1):
+                ok = True
+                for rr, cc in shape["padded"]:
+                    tr, tc = r0 + rr, c0 + cc
+                    if not (0 <= tr < h and 0 <= tc < w):
+                        ok = False
+                        break
