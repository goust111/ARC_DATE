+    if len(interior_cells) < MIN_INTERIOR_CELLS:
+        return None
+    if max(right[r] - left[r] - 1 for r in range(height)) < 2:
+        return None
+    if len(interior_cells) - 4 < MIN_INTERIOR_BLACK_CELLS:
+        return None
