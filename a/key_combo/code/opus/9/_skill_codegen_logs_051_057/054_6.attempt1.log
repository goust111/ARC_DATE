+OUTLINE_COUNT_WEIGHTS = [2, 3]
+OUTLINE_HEIGHT_RANGE_BY_COUNT = {2: (4, 8), 3: (4, 7)}
+MIN_INTERIOR_CELLS = 8
+MIN_INTERIOR_BLACK_CELLS = 2
+GEN_ATTEMPTS = 400
