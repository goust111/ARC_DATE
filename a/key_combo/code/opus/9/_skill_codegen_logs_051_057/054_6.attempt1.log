+    if random.random() < 0.35:
+        return []
+
+    candidates = [(r, c) for r in range(h) for c in range(w) if not blocked[r, c]]
+    losers = [
+        color
+        for spec in fill_specs
+        for color in spec["counts"]
+        if color != int(spec["winner"])
+    ]
+    if losers:
