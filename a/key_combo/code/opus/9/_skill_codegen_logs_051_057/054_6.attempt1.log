+OUTLINE_COUNT_WEIGHTS = [1, 3]
+OUTLINE_HEIGHT_RANGE_BY_COUNT = {2: (4, 8), 3: (4, 6)}
+MIN_INTERIOR_CELLS = 8
+MIN_INTERIOR_BLACK_CELLS = 2
+GEN_ATTEMPTS = 400
