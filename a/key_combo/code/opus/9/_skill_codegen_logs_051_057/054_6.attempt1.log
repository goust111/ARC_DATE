+    return None
+
+
+def _place_in_zones(outline_count: int, zones: list[tuple[int, int, int, int]]) -> list[dict] | None:
+    placements: list[dict] = []
+    height_range = OUTLINE_HEIGHT_RANGE_BY_COUNT[outline_count]
+    for zone_r, zone_c, zone_h, zone_w in zones:
+        placed = None
+        max_height = min(height_range[1], zone_h - 2)
+        if max_height < height_range[0] or zone_w < 6:
+            return None
+        for _ in range(80):
+            shape = _make_outline_shape((height_range[0], max_height))
+            if shape is None:
+                continue
+            if shape["height"] > zone_h - 2 or shape["width"] > zone_w - 2:
+                continue
+            top = zone_r + random.randint(1, zone_h - shape["height"] - 1)
+            left = zone_c + random.randint(1, zone_w - shape["width"] - 1)
+            placed = dict(shape)
+            placed["top"] = top
+            placed["left"] = left
+            break
+        if placed is None:
+            return None
+        placements.append(placed)
+    return placements
+
+
+def _blocked_from_placements(grid_shape: tuple[int, int], placements: list[dict]) -> np.ndarray:
+    h, w = grid_shape
+    blocked = np.zeros((h, w), dtype=bool)
+    for placed in placements:
+        top = placed["top"]
+        left = placed["left"]
+        for rr, cc in placed["filled"]:
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    tr, tc = top + rr + dr, left + cc + dc
+                    if 0 <= tr < h and 0 <= tc < w:
+                        blocked[tr, tc] = True
+    return blocked
+
+
+def _choose_isolated_cells(cells: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    shuffled = cells[:]
+    random.shuffle(shuffled)
+    chosen: list[tuple[int, int]] = []
+    blocked: set[tuple[int, int]] = set()
+    for cell in shuffled:
+        if cell in blocked:
+            continue
+        chosen.append(cell)
+        r, c = cell
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                blocked.add((r + dr, c + dc))
+        if len(chosen) == count:
+            return chosen
+    return None
+
+
+def _place_shapes(
+    grid_shape: tuple[int, int], shapes: list[dict]
+) -> tuple[list[dict], np.ndarray, np.ndarray] | None:
+    h, w = grid_shape
+    blocked = np.zeros((h, w), dtype=bool)
+    occupied = np.zeros((h, w), dtype=bool)
+    placed: list[dict] = []
+
+    for shape in sorted(shapes, key=lambda item: len(item["filled"]), reverse=True):
+        valid: list[tuple[int, int]] = []
+        row_min = 1 if h - shape["height"] >= 2 else 0
+        row_max = h - shape["height"] - (1 if h - shape["height"] >= 2 else 0)
+        col_min = 1 if w - shape["width"] >= 2 else 0
+        col_max = w - shape["width"] - (1 if w - shape["width"] >= 2 else 0)
+        for r0 in range(row_min, row_max + 1):
+            for c0 in range(col_min, col_max + 1):
+                ok = True
+                for rr, cc in shape["padded"]:
+                    tr, tc = r0 + rr, c0 + cc
+                    if not (0 <= tr < h and 0 <= tc < w):
+                        ok = False
