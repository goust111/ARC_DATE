+    fill_changed_black = False
+    loser_present = False
+    for placed, outline_color, spec in zip(placements, outline_colors, fill_specs):
+        top = placed["top"]
+        left = placed["left"]
+        row_pairs = {}
+        for rr, cc in placed["outline"]:
+            row_pairs.setdefault(top + rr, []).append(left + cc)
+        for cols in row_pairs.values():
