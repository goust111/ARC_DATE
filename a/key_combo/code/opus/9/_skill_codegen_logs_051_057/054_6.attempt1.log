+    fill_specs = _pick_fill_specs(placements, marker_pool)
+    if fill_specs is None:
+        return None
+
+    noise = _pick_noise((grid_h, grid_w), blocked, fill_specs, marker_pool)
+    if noise is None:
+        return None
