+    filled_set = set(filled_cells)
+    padded_set: set[tuple[int, int]] = set()
+    for r, c in filled_set:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                padded_set.add((r + dr, c + dc))
+
+    return {
+        "height": height,
+        "width": width,
+        "outline": outline_cells,
+        "interior": interior_cells,
+        "filled": filled_cells,
+        "padded": padded_set,
+    }
