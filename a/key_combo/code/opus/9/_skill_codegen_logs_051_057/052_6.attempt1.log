        {"pairs": [(2, 3, 6), (3, 5, 4)], "extra_width": 2},
        {"pairs": [(2, 4, 7), (3, 6, 5)], "extra_width": 2},
        {"pairs": [(2, 5, 7), (3, 6, 4)], "extra_width": 3},
