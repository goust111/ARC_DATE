    touching: dict[int, set[tuple[int, int]]] = {}
    for r, c in region:
        for nr, nc in _neighbors4(int(r), int(c)):
            if not _in_bounds(grid.shape, nr, nc):
                continue
            color = int(grid[nr, nc])
            if color in (BLACK, GREY):
