            if g[r, c] != BLACK or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts = []
            touches_edge = False
            while q:
                rr, cc = q.popleft()
                pts.append((rr, cc))
                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
