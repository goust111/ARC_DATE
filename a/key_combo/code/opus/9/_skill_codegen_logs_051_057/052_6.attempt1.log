    c0 = cl + 1 - (width - span)
    r0 = rt - 1 if top_bridge else rt
    return int(r0), int(c0)


def _wall_left_min(widths: list[int], span: int) -> int:
    return max(2 * w - span - 1 for w in widths)


def _build_attempt() -> tuple[np.ndarray, np.ndarray] | None:
    templates = [
