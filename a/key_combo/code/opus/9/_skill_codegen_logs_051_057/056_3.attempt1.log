+        6: [(0, 0), (0, 1), (1, 1), (1, 0), (2, 0), (2, 2), (3, 2)],
+        7: [(0, 0), (0, 1), (1, 1), (1, 0), (2, 0), (2, 2), (3, 2), (3, 3)],
