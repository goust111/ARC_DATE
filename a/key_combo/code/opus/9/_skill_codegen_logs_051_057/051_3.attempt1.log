@lru_cache(maxsize=None)
def _gen_valid_box_sets(n: int, k: int) -> tuple[tuple[tuple[int, int], ...], ...]:
    positions = tuple((r, c) for r in range(n - _GEN_BOX_SIZE + 1) for c in range(n - _GEN_BOX_SIZE + 1))
