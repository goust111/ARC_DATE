+            for c0 in (c - 1, c):
+                tile = _tile_from_anchor("square", r0, c0)
+                if all(rc in remaining for rc in tile):
+                    out.add(tile)
+        for c0 in (c - 2, c - 1, c):
+            tile = _tile_from_anchor("hbar", r, c0)
+            if all(rc in remaining for rc in tile):
+                out.add(tile)
+        for r0 in (r - 2, r - 1, r):
+            tile = _tile_from_anchor("vbar", r0, c)
+            if all(rc in remaining for rc in tile):
+                out.add(tile)
