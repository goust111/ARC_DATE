+
+
+def _tile_kind(tile: tuple[tuple[int, int], ...]) -> str:
+    rows = sorted({r for r, _ in tile})
+    cols = sorted({c for _, c in tile})
+    h = rows[-1] - rows[0] + 1
+    w = cols[-1] - cols[0] + 1
