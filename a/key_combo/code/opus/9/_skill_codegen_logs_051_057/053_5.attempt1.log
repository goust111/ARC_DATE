_GEN_COLORS = tuple(range(1, 10))
_GEN_MARKER_AVOID_FILL_PROB = 0.8
_GEN_FILL_COUNT_BOUNDS = (2, 3)

# Sparse square motifs observed in the task examples.
_GEN_MOTIF_TEMPLATES = [
