  unreached_black_regions:
    count: 4-20 components in output
    total unreached: 5-45 cells (3-18% of grid)
  transform:
    flood-fill 4-connected from all blue seeds through black cells
    reached black cells become blue; all other cells unchanged

generation_strategy:
