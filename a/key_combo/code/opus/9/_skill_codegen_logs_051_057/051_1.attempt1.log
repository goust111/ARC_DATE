+            q: deque[tuple[int, int]] = deque([(sr, sc)])
+            seen[sr, sc] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                cells.append((r, c))
+                for nr, nc in neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
