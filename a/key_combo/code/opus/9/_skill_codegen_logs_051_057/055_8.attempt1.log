def _trace_path(
    occupied: np.ndarray,
    tip: tuple[int, int],
    direction: tuple[int, int],
) -> tuple[list[tuple[int, int]], str]:
    H, W = occupied.shape
    dr, dc = direction
    r, c = tip
    path: list[tuple[int, int]] = []
    step = 1
    while True:
        nr = r + dr * step
        nc = c + dc * step
        if not (0 <= nr < H and 0 <= nc < W):
            return path, "boundary"
        if int(occupied[nr, nc]) != BG:
            return path, "obstacle"
        path.append((nr, nc))
        step += 1


