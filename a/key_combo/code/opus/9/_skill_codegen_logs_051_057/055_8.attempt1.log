+def _candidate_top_lefts(H: int, W: int, orientation: str) -> list[tuple[int, int]]:
+    rel_rows = [r for r, _ in SPRITES[orientation]["cells"]]
+    rel_cols = [c for _, c in SPRITES[orientation]["cells"]]
+    h = max(rel_rows) + 1
+    w = max(rel_cols) + 1
