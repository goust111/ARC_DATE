+    for parts in _partitions(width, group_count):
+        col = 0
+        ok = True
+        for group_width in parts:
+            left = col
+            right = col + group_width - 1
+            if left % COL_PERIOD == stem_col or right % COL_PERIOD == stem_col:
+                ok = False
+                break
+            col += group_width
+        if ok:
