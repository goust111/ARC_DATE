+    assembled_col = 0
+    input_to_assembled: dict[int, int] = {}
+    input_col = 0
+    for group in groups:
+        for k in range(group.shape[1]):
+            input_to_assembled[input_col + k] = assembled_col + k
+        input_col += group.shape[1] + 1
+        assembled_col += group.shape[1]
