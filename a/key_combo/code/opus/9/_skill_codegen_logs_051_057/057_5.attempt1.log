+
+    max_erased = max(1, min(len(candidates), np.count_nonzero(target) // 5))
+    erased_goal = random.randint(1, max_erased)
+    erased = 0
+    for r, c, key in candidates:
+        if visible_per_input_col[c] <= 1:
+            continue
+        if class_counts[key] <= 1:
+            continue
+        input_grid[r, c] = BG
+        class_counts[key] -= 1
+        visible_per_input_col[c] -= 1
