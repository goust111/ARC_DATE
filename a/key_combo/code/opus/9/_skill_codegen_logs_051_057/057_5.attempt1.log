+    return True
+
+
+def _partitions(total: int, count: int) -> list[list[int]]:
+    results: list[list[int]] = []
+
+    def rec(remaining: int, groups_left: int, prefix: list[int]) -> None:
+        if groups_left == 1:
+            if GEN_GROUP_WIDTH_MIN <= remaining <= GEN_GROUP_WIDTH_MAX:
