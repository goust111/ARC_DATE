+def _erase_cells(
+    input_grid: np.ndarray, groups: list[np.ndarray], spans: list[tuple[int, int]], target: np.ndarray
+) -> bool:
+    assembled_col = 0
+    input_to_assembled: dict[int, int] = {}
+    input_col = 0
+    for group in groups:
