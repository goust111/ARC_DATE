+    h, w = mask.shape
+    return sum(
+        0 <= nr < h and 0 <= nc < w and mask[nr, nc]
+        for nr, nc in _neighbors4(r, c)
+    )
+
+
+def _split_column_groups(grid: np.ndarray, bg: int) -> list[np.ndarray]:
+    nonempty = np.any(grid != bg, axis=0)
+    groups: list[np.ndarray] = []
+    c = 0
