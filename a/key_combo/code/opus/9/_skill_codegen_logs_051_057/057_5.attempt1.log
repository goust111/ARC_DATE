+    for group in groups[1:]:
+        if mode == "endpoint":
+            dr = prev_endpoint - _endpoint_row(group, bg, "left")
+        elif mode == "top":
+            dr = prev_top - _top_row(group, bg)
+        elif mode == "none":
+            dr = 0
+        else:
+            raise ValueError(f"unknown assemble mode: {mode}")
