+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+ROW_PERIOD = 4
+COL_PERIOD = 4
+GEN_HEIGHT = 6
+GEN_BAR_ROW = 3
+GEN_STEM_ROW_OPTIONS = ((1, 2, 3), (0, 2, 3))
+GEN_STEM_COL_OPTIONS = (1, 2, 3)
+GEN_GROUP_COUNT_OPTIONS = (3, 4)
