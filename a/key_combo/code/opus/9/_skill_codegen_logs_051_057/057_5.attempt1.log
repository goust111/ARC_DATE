import random, numpy as np
from collections import deque


def get_bg(g):
    vals, counts = np.unique(g, return_counts=True)
    return int(vals[counts.argmax()])

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def comp_count(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    n=0
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            n+=1
            q=[(r,c)]; seen[r,c]=True
            while q:
                rr,cc=q.pop()
                for nr,nc in neighbors4(rr,cc):
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
    return n

def degree(mask,r,c):
    H,W=mask.shape
    return sum(0<=nr<H and 0<=nc<W and mask[nr,nc] for nr,nc in neighbors4(r,c))

def endpoint_rows(group,bg=0):
    mask=group"'!=bg
    out=[]
    for side,c in [('"'L',0),('R',group.shape[1]-1)]:
        rows=[]
        for r in range(group.shape[0]):
            if mask[r,c] and degree(mask,r,c)==1:
                rows.append(r)
        out.append(rows)
    return out

def group_valid(group,bg=0):
    mask=group"'!=bg
    if not np.any(mask): return False
    if np.any(~np.any(mask,axis=0)): return False
    if comp_count(mask)!=1: return False
    lr=endpoint_rows(group,bg)
    return len(lr[0])==1 and len(lr[1])==1

def valid_partitions(W,n,minw=2,maxw=5):
    ans=[]
    def rec(rem,k,cur):
        if k==1:
            if minw<=rem<=maxw: ans.append(cur+[rem])
            return
        for w in range(minw,maxw+1):
            if rem-w < (k-1)*minw or rem-w > (k-1)*maxw: continue
            rec(rem-w,k-1,cur+[w])
    rec(W,n,[])
    return ans

def period_candidates(g,bg=0):
    H,W=g.shape
    out=[]
    for pr in range(1,H+1):
        for pc in range(1,W+1):
            mp={}
            ok=True
