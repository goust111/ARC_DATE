+def _assemble_groups(
+    groups: list[np.ndarray], bg: int, mode: str = "endpoint"
+) -> np.ndarray:
+    h = groups[0].shape[0]
+    w = sum(group.shape[1] for group in groups)
+    out = np.full((h, w), bg, dtype=int)
