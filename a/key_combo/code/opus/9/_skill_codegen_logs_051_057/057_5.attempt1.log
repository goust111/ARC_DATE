+                    if key in residue_colors and residue_colors[key] != color:
+                        ok = False
+                        break
+                    residue_colors[key] = color
+                if not ok:
+                    break
+            if ok:
+                candidates.append((row_period, col_period, residue_colors))
+    return candidates
