    return g

def rand_classes(pr,pc):
    # random walk on torus
    nodes=[(r,c) for r in range(pr) for c in range(pc)]
    start=random.choice(nodes)
    order=[start]
    used={start}
    target=random.randint(pr+pc-1,min(pr*pc, pr+pc+3))
    while len(order)<target:
        frontier=[]
        for r,c in order:
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                nr=(r+dr)%pr; nc=(c+dc)%pc
                if (nr,nc) not in used:
