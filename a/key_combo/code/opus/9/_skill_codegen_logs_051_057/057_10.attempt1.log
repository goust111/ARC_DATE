def _gen_mask_from_cells(h: int, w: int, cells: set[tuple[int, int]], col_offset: int = 0) -> np.ndarray:
    mask = np.zeros((h, w), dtype=bool)
    for r, c in cells:
        mask[r, c + col_offset] = True
