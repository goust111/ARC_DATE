+def _reachable_area(grid: np.ndarray, seed: tuple[int, int], separator_row: int) -> int:
+    q = deque([seed])
+    seen = {seed}
+    area = 0
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if not (0 <= nr < separator_row and 0 <= nc < grid.shape[1]):
+                continue
+            if (nr, nc) in seen or int(grid[nr, nc]) != BLACK:
+                continue
+            seen.add((nr, nc))
+            q.append((nr, nc))
+            area += 1
