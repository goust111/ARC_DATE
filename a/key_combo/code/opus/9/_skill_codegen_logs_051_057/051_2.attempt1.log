+def _transform_cells(cells: list[tuple[int, int]], rotation: int, mirror: bool) -> list[tuple[int, int]]:
+    out = []
+    for r, c in cells:
+        if mirror:
+            c = -c
+        for _ in range(rotation % 4):
+            r, c = c, -r
+        out.append((r, c))
+    return out
