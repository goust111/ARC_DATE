+            stamp = np.rot90(template, CORNER_TO_ROT_K[(pr, pc)])
+            rr = br * SLOT_STRIDE
+            cc = bc * SLOT_STRIDE
+            out[rr : rr + SLOT_SIZE, cc : cc + SLOT_SIZE] = np.where(stamp, color, BG)
