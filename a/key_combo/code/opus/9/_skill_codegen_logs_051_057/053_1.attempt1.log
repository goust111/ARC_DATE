+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+CONTROL_COLORS = (1, 2, 3, 4)
+SLOT_SIZE = 3
+SLOT_STRIDE = 4
+GEN_MAX_ATTEMPTS = 400
+
+CORNER_TO_ROT_K = {
+    (0, 0): 0,
+    (0, 2): -1,
+    (2, 2): 2,
+    (2, 0): 1,
+}
+CORNER_POSITIONS = tuple(CORNER_TO_ROT_K)
+NON_CORNER_POSITIONS = ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1))
+VALID_SLOT_DIMS = ((2, 4), (4, 2), (3, 3), (3, 4), (4, 3), (4, 4))
