+BG = 0
+GREY = 5
+CONTROL_COLORS = (1, 2, 3, 4)
+SLOT_SIZE = 3
+SLOT_STRIDE = 4
+GEN_MAX_ATTEMPTS = 400
+
+CORNER_TO_ROT_K = {
+    (0, 0): 0,
