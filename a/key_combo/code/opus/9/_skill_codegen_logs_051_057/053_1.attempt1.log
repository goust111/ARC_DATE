+            rr, cc = np.where(mask)
+            if rr.min() != 0 or rr.max() != SLOT_SIZE - 1 or cc.min() != 0 or cc.max() != SLOT_SIZE - 1:
+                continue
+            rotations = {np.rot90(mask, k).tobytes() for k in range(4)}
+            if len(rotations) != 4:
+                continue
