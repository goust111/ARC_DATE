+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BODY = 1
+GREY = 5
+RAY_COLORS = (2, 3, 4, 7)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 500
+
+
+def _in_bounds(shape, r, c):
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _component_coords(grid, bg=BG):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _transform_coord(coord, h, w, flip, rot):
+    r, c = coord
+    if flip:
+        c = w - 1 - c
+    if rot == 0:
+        return r, c
+    if rot == 1:
+        return c, h - 1 - r
+    if rot == 2:
+        return h - 1 - r, w - 1 - c
+    return w - 1 - c, r
+
+
+def _transform_dir(direction, flip, rot):
+    dr, dc = direction
+    if flip:
+        dc = -dc
+    if rot == 0:
+        return dr, dc
+    if rot == 1:
+        return dc, -dr
+    if rot == 2:
+        return -dr, -dc
+    return -dc, dr
+
+
+def _all_transforms(h, w):
+    out = []
+    seen = set()
+    for flip in (False, True):
+        for rot in range(4):
+            mapping = tuple(_transform_coord((r, c), h, w, flip, rot) for r in range(h) for c in range(w))
+            if mapping in seen:
+                continue
+            seen.add(mapping)
+            out_shape = (h, w) if rot % 2 == 0 else (w, h)
+            out.append(
+                {
+                    "flip": flip,
+                    "rot": rot,
+                    "shape": out_shape,
+                    "map_coord": lambda coord, f=flip, k=rot, hh=h, ww=w: _transform_coord(coord, hh, ww, f, k),
+                    "map_dir": lambda direction, f=flip, k=rot: _transform_dir(direction, f, k),
+                }
+            )
