+        spec["direction"] = ray_direction
+    return grid
+
+
+def _target_patch(shape, embedded_local, color):
+    patch = np.full(shape, BODY, dtype=int)
+    patch[embedded_local] = color
+    return patch
+
+
+def _top_left_candidates(scene_shape, patch_shape):
