+            if color == BODY:
+                ok = False
+                break
+            length = 0
+            cells = []
+            while _in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == color:
+                cells.append((rr, cc))
+                covered.add((rr, cc))
+                length += 1
+                rr += dr
+                cc += dc
+            if length < 2:
