+
+def _place_patch_checked(scene, patch, top_left, tip=None, tip_color=None):
+    out = scene.copy()
+    r0, c0 = top_left
+    h, w = patch.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(patch[r, c])
+            gr = r0 + r
+            gc = c0 + c
+            if not _in_bounds(out.shape, gr, gc):
