+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BODY = 1
+GREY = 5
+RAY_COLORS = (2, 3, 4, 7)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 500
+
+
+def _in_bounds(shape, r, c):
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
