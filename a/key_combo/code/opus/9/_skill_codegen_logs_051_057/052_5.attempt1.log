+                    "transform": transform,
+                    "embedded_local": embedded_local,
+                    "patch_shape": patch_shape,
+                    "patch": patch,
+                    "top_left": top_left,
+                    "color": ray["color"],
+                    "matched_index": matched_index,
+                }
+            )
