  "type": "move_along_path",
  "src": "single-pixel control markers labeling active-edge cells of rectangular sprites",
  "path": "outward normal ray from the corresponding active-edge cell of every transformed sprite",
  "trajectory": "continuous through bg cells",
  "dst": "grid edge or first foreground blocker",
  "transform": "copy marker labels by dihedral template position across all matching rectangular sprites"
}
</annotation>
<generation_spec>
