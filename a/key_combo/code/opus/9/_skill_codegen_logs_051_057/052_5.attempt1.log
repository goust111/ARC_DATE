+        "shape": (h, w),
+        "color": color,
+        "embedded_global": embedded,
+        "embedded_local": (embedded[0] - r0, embedded[1] - c0),
+        "patch": patch,
+        "coords": comp,
+    }
+
+
+def _parse_scene(grid):
+    comps = _component_coords(grid, BG)
