+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        candidate = _attempt_generate()
+        if candidate is not None:
+            return candidate[0]
+    raise RuntimeError("failed to generate a valid puzzle input")

