+
+def _can_place_shape(
+    grid: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+    anchor: tuple[int, int],
+    forbidden: np.ndarray,
+) -> bool:
+    h, w = grid.shape
+    cells = [(anchor[0] + dr, anchor[1] + dc) for dr, dc in shape]
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if forbidden[r, c] or int(grid[r, c]) != BLACK:
