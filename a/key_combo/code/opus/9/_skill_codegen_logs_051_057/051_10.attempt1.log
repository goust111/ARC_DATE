+    forbidden = np.zeros((h, w), dtype=bool)
+    for r, c in controls:
+        left = max(0, min(c - 2, c - extent) - 1)
+        right = min(w - 1, max(c + 2, c + extent) + 1)
+        top = max(0, r - 3)
+        bottom = min(h - 1, r + 3)
