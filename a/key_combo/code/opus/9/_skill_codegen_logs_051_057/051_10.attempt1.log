+        out[r - 1, c] = GREY
+        for rr in (r - 1, r, r + 1):
+            out[rr, c - 2] = RED
+            out[rr, c + 2] = RED
+        by_row[r + 2].append(c)
+
+    width = out.shape[1]
+    for row, centers in by_row.items():
+        counts = _baseline_counts(width, centers, n_squares)
+        out[row, counts > 0] = RED
+        for c in centers:
+            for cc in range(c - 2, c + 3):
+                if 0 <= cc < width and counts[cc] == 1:
+                    out[row, cc] = TEAL
