+def _baseline_counts(width: int, centers: list[int], extent: int) -> np.ndarray:
+    counts = np.zeros(width, dtype=int)
+    for c in centers:
+        left = max(0, c - extent)
+        right = min(width, c + extent + 1)
+        counts[left:right] += 1
+    return counts
