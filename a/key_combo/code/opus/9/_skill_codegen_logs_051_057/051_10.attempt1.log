+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    return max(rows) + 1, max(cols) + 1
+
+
+def _can_place_shape(
+    grid: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+    anchor: tuple[int, int],
+    forbidden: np.ndarray,
