GEN_MARKER_COUNT_RANGE = (1, 3)
GEN_HEIGHT_BY_MARKER_COUNT = {1: (10, 17), 2: (12, 17), 3: 17}
GEN_WIDTH_RANGE = (10, 19)
GEN_MARKER_MARGIN = 3
GEN_MIN_ROW_SEPARATION = 5

