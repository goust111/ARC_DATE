+def _attempt_generate() -> tuple[np.ndarray, str] | None:
+    height = random.randint(GRID_MIN, GRID_MAX)
+    width = random.randint(GRID_MIN, GRID_MAX)
+    n_squares = random.randint(1, 4)
+    control_count = random.randint(1, 2)
