            continue

        min_r = min(r for r, _, _, _ in frames)
        min_c = min(c for _, c, _, _ in frames)
        max_r = max(r + h - 1 for r, _, h, _ in frames)
        max_c = max(c + w - 1 for _, c, _, w in frames)
