+
+def _branch_counts(branch: str) -> tuple[int, int]:
+    if branch == "s_gt_r":
+        return random.choice([(2, 1), (3, 1)])
+    if branch == "r_gt_s":
+        return random.choice([(1, 2), (1, 3), (1, 4)])
