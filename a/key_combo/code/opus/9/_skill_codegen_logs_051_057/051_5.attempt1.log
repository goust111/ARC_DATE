+    if rect_count == 1:
+        rects = [random.choice(["rect_h", "rect_v"])]
+    elif rect_count >= 2:
+        if random.random() < 0.7:
+            rects = ["rect_h", "rect_v"] + [random.choice(["rect_h", "rect_v"]) for _ in range(rect_count - 2)]
+        else:
