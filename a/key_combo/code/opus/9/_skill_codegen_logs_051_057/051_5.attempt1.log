+RED = 2
+YELLOW = 4
+GREY = 5
+TEAL = 8
+
+SHAPES = {
+    "square": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "rect_h": ((0, 0), (0, 1), (0, 2)),
+    "rect_v": ((0, 0), (1, 0), (2, 0)),
