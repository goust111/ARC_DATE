+    actual = main(grid)
+    assert np.array_equal(actual, expected), "generated truth and solver output must match"
+
+    out_quadrants = set()
+    colored_coords = np.argwhere((expected == TEAL) | (expected == YELLOW))
+    for r, c in colored_coords:
