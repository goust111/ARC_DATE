+def _route_edge(
+    pos_a: tuple[int, int],
+    pos_b: tuple[int, int],
+    box_a: tuple[int, int],
+    box_b: tuple[int, int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    top_a, left_a = box_a
+    top_b, left_b = box_b
+    if pos_a[0] == pos_b[0]:
+        if pos_a[1] > pos_b[1]:
+            pos_a, pos_b = pos_b, pos_a
+            top_a, left_a, top_b, left_b = top_b, left_b, top_a, left_a
+        start = (int(top_a + 1), int(left_a + NODE_SIZE))
