+    points: list[tuple[int, int, int]] = []
+    occupied: set[tuple[int, int]] = set()
+    used_diagonals: set[int] = set()
+    for length, color in specs:
+        placed = False
+        for _ in range(80):
+            sr = int(rng.integers(0, height - length + 1))
+            sc = int(rng.integers(0, width - length + 1))
+            diag_id = sc - sr
