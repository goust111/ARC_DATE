GRID_SIZES = (7, 8, 9)
GRID_SIZES_FOR_THREE_WALLS = (8, 9)
WALL_COUNT_RANGE = (1, 3)
MAX_GENERATION_ATTEMPTS = 300
BACKGROUND_COLOR = Color.ORANGE
WALL_COLOR = Color.RED

# Wall geometry constraints.
WALL_LENGTH_RANGE = (4, 13)
WALL_TURN_RANGE = (1, 5)
ENDPOINT_SPACING = 2
MAX_STAIR_PARTS = 3
