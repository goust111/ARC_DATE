+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+YELLOW = 4
+GREY = 5
+
+INPUT_FILL_COLORS = [1, 3, 6, 7, 8, 9]
+INPUT_MARKER_COLORS = [1, 3, 6, 7, 8, 9]
+
+GRID_RANGES = {
