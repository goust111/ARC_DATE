+
+def _attempt_generate() -> np.ndarray | None:
+    rng = random.Random()
+    n_rectangles = rng.choice([2, 3, 4])
+    (lo_h, hi_h), (lo_w, hi_w) = GRID_RANGES[n_rectangles]
+    height = rng.randint(lo_h, hi_h)
+    width = rng.randint(lo_w, hi_w)
