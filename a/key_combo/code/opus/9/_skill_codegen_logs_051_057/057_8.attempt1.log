+        can_left = start > 0
+        can_right = stop < width - 1
+        step_left = 1 if can_left and random.random() < 0.75 else 0
+        step_right = 1 if can_right and random.random() < 0.75 else 0
+        if step_left == 0 and step_right == 0:
+            if can_left and can_right:
+                if random.random() < 0.5:
+                    step_left = 1
+                else:
+                    step_right = 1
+            elif can_left:
+                step_left = 1
+            elif can_right:
+                step_right = 1
+        next_start = start - step_left
+        next_stop = stop + step_right
+        if next_start == 0 and next_stop == width - 1:
