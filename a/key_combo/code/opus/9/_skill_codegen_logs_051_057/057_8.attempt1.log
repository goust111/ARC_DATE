+    intervals: dict[int, tuple[int, int]] = {}
+    for r, interval in zip(rows_above_empty, upper):
+        intervals[int(r)] = interval
+    for r, interval in zip(reversed(rows_below_empty), lower_from_bottom):
+        intervals[int(r)] = interval
+
