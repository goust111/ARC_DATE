+        elif top < r < bottom:
+            start, stop = 0, width - 1
+        elif r < top:
+            start, stop = intervals[top]
+        else:
+            start, stop = intervals[bottom]
+        mask[r, start : stop + 1] = True
+
+    return {
+        "marker_row": marker_row,
+        "marker_col": marker_col,
+        "intervals": intervals,
+        "mask": mask,
+        "top_mode": top_mode,
+        "bottom_mode": bottom_mode,
+    }
+
