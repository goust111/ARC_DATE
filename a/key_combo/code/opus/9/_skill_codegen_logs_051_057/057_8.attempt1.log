+                    next_start = start
+                else:
+                    next_stop = stop
+            elif step_left:
+                next_start = start
+            else:
+                next_stop = stop
+        out.append((next_start, next_stop))
+    return out
+
+
+def _build_half_profile(
+    height: int,
+    width: int,
+    wall_rows: tuple[int, ...],
+    empty_rows: tuple[int, ...],
