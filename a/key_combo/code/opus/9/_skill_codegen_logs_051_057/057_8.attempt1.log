+    return random.choice(((mid - 1, mid), (mid, mid + 1)))
+
+
+def _sample_mode() -> str:
+    return random.choices(
+        ["both", "left_only", "right_only"],
+        weights=[5, 2, 2],
+        k=1,
+    )[0]
+
+
+def _sample_endpoint_interval(width: int, marker_col: int, mode: str) -> tuple[int, int]:
+    if mode == "both":
+        choices = [
