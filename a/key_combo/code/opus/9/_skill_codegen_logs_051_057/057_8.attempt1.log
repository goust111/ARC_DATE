+    return {
+        "marker_row": marker_row,
+        "marker_col": marker_col,
+        "intervals": intervals,
+        "mask": mask,
+        "top_mode": top_mode,
+        "bottom_mode": bottom_mode,
+    }
+
+
+def _render_half(
+    height: int,
+    width: int,
+    profile: dict[str, object],
+    marker_color: int,
