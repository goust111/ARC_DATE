+    mask = np.zeros((height, width), dtype=bool)
+    top = min(wall_rows)
+    bottom = max(wall_rows)
+    for r in range(height):
+        if r in intervals:
+            start, stop = intervals[r]
+        elif top < r < bottom:
+            start, stop = 0, width - 1
+        elif r < top:
+            start, stop = intervals[top]
+        else:
+            start, stop = intervals[bottom]
+        mask[r, start : stop + 1] = True
