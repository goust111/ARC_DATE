    h, _ = group.shape
    shifted = np.full_like(group, bg)
    coords = np.argwhere(group != bg)
    for r, c in coords:
        nr = r + dr
        assert 0 <= nr < h
        shifted[nr, c] = group[r, c]
    return shifted


def main(grid: np.ndarray) -> np.ndarray:
