+BASE_COLOR = 1
+CONNECTOR_COLOR = 2
+CANDIDATE_COLORS = [3, 4, 5, 6, 7, 8, 9]
+
+TYPE_FLIPLR = "horizontal_reflection"
+TYPE_FLIPUD = "vertical_reflection"
+TYPE_ROT180 = "rot180"
+
+TYPE_TO_DELTA = {
+    TYPE_FLIPLR: (0, 1),
+    TYPE_FLIPUD: (1, 0),
+    TYPE_ROT180: (-1, 0),
+}
+
+TYPE_TO_SIDES = {
+    TYPE_FLIPLR: ("right", "left"),
+    TYPE_FLIPUD: ("bottom", "top"),
+    TYPE_ROT180: ("top", "bottom"),
