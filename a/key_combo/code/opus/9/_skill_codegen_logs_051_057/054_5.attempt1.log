   259	def main(grid: np.ndarray) -> np.ndarray:
   260	    """
   261	    Select the uniquely symmetric plug sprite, dock it in the direction encoded by its symmetry, and tight-crop the merge.
   262	
   263	    Input structure:
   264	    - The grid has black background, one largest blue base sprite, and 3-4 smaller candidate sprites.
   265	    - Every sprite is a 4-connected monochromatic body with exactly one red connector pixel on its edge.
   266	    - Candidate sprites are separated from one another and from the base.
   267	
   268	    Rule:
   269	    - Detect all non-black 4-connected components and identify the base as the unique largest body.
   270	    - Crop each candidate to its tight bounding box and test the occupied shape for exactly one of: left-right reflection, up-down reflection, or 180-degree rotation.
   271	    - Keep the unique symmetric candidate, translate it so its connector lands one cell right / down / up of the base connector according to that symmetry type, then discard the other candidates.
   272	    - Recolor both connector pixels to the plug's body color and return the tight crop of the merged base-plus-plug object.
   273	
   274	    Key insight:
   275	    - The same symmetry property both selects which candidate matters and encodes the docking direction, so shape analysis is needed twice but with the same evidence.
   276	    """
   277	    g = np.asarray(grid, dtype=int)
   278	    if g.ndim != 2:
   279	        raise AssertionError("expected a 2D grid")
   280	
   281	    infos = [_component_info_from_grid(g, coords) for coords in _component_coords(g, bg=BG)]
   282	    if len(infos) < 4:
   283	        raise AssertionError("expected one base and multiple candidates")
   284	
   285	    max_body = max(info["body_area"] for info in infos)
   286	    bases = [info for info in infos if info["body_area"] == max_body]
   287	    if len(bases) != 1:
   288	        raise AssertionError("expected a unique largest base")
   289	    base = bases[0]
