+    H, _W = g.shape
+    rails = _rail_segments(g)
+    assert len(rails) == 2, "expected exactly two grey vertical rails"
+    (top_l, col_l, bot_l), (top_r, col_r, bot_r) = rails
+    assert col_l < col_r, "rails must be in distinct columns"
