+    assert 4 <= line_union <= 8
+
+    intervals = [
+        (start, end)
+        for start in range(line_union - 3)
+        for end in range(start + 3, line_union)
+    ]
+    covering_pairs = [
+        (left, right)
+        for left in intervals
+        for right in intervals
+        if min(left[0], right[0]) == 0 and max(left[1], right[1]) == line_union - 1
+    ]
