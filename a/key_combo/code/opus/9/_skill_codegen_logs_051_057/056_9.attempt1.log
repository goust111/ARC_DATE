+    try:
+        _semantic_checks(grid, k)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        rng = np.random.default_rng()
+        generated = _generate_attempt(rng)
