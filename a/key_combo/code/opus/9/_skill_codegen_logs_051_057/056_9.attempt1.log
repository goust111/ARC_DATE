NON_BG_COLORS = np.arange(1, 10)
TWO_COLOR_SPLITS = ((3, 6), (4, 5))
COIN_FLIP_PROBABILITY = 0.5
COLOR_OVERLAP_PROBABILITY = 0.2
THREE_COLOR_CUT_COUNT = 2
THREE_COLOR_CUT_POSITIONS = np.arange(1, BLOCK_CELL_COUNT)
