+            row_heights = random.choice(ROW_OPTIONS)
+            col_widths = random.choice(COL_OPTIONS)
+            frame_h = sum(row_heights) + SLOT_ROWS + 1
+            frame_w = sum(col_widths) + SLOT_COLS + 1
