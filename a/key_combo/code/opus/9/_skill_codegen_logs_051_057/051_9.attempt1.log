+    out = np.zeros(mask.shape, dtype=int)
+    need = len(palette)
+    for (r, c), color in zip(coords[:need], palette):
+        out[int(r), int(c)] = int(color)
+    for r, c in coords[need:]:
+        out[int(r), int(c)] = int(palette[int(_RNG.integers(0, len(palette)))])
