+    g = np.asarray(grid, dtype=int)
+    cell_to_covering: dict[tuple[int, int], list[int]] = defaultdict(list)
+    ordered = sorted(records, key=lambda rec: _coord_key(rec["draw_key"]))
+    for rec in ordered:
+        for cell in rec["path"]:
