+        coords = [tuple(map(int, rc)) for rc in np.argwhere(g == color)]
+        coords.sort(key=_coord_key)
+        a, b = coords
+        path = _segment_cells(a, b)
+        records.append(
+            {
+                "color": int(color),
+                "markers": (a, b),
+                "first_key": min(a, b),
+                "draw_key": max(a, b),
+                "path": path,
+                "path_set": frozenset(path),
+            }
+        )
+    assert len(records) == len(colors)
+    return records
