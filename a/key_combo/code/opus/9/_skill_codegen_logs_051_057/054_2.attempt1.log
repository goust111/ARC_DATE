+import random
+from collections import Counter
+
+import numpy as np
+
+
+COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+FREQ_PATTERNS = {
+    3: [
+        (1, 2, 4),
+        (1, 2, 5),
+        (1, 3, 4),
+        (1, 3, 5),
+        (1, 4, 5),
+        (2, 3, 4),
+        (2, 3, 5),
