+    if any(np.count_nonzero(painted == color) == 0 for color in freq):
+        return False
+    if not stats["events"]:
+        return False
+
+    kept_cover_event = False
+    for event in stats["events"]:
+        if np.count_nonzero(painted == event["color"]) == 0:
