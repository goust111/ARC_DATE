+    width = random.randint(max(20, total_points // 2 + 16), 26)
+
+    grid = _build_input_grid(freq_by_color, height, width)
+    if grid is None:
+        return None
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
