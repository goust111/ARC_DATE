+def _paint_output(shape: tuple[int, int], settled: list[dict], path: list[tuple[int, int]]) -> np.ndarray:
+    out = _render_bars(shape, settled, recolor_blue=True)
+    for r, c in path:
+        out[r, c] = GREEN
+    return out
