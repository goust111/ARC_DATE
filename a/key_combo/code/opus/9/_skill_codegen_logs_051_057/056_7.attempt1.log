+def _settle_bars(bars: list[dict], shape: tuple[int, int]) -> tuple[list[dict], list[str]]:
+    h, w = shape
+    occupied = np.zeros((h, w), dtype=bool)
+    settled: list[dict] = []
+    reasons: list[str] = []
+    for bar in sorted(bars, key=_bar_sort_key):
