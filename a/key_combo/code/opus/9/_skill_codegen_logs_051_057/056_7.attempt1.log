+def _sample_columns(rng: random.Random, low: int, high: int, count: int, gap: int) -> list[int] | None:
+    pool = list(range(low, high + 1))
+    rng.shuffle(pool)
+    chosen: list[int] = []
+    for col in pool:
+        if all(abs(col - prev) >= gap for prev in chosen):
+            chosen.append(col)
+        if len(chosen) == count:
+            return sorted(chosen)
+    return None
+
