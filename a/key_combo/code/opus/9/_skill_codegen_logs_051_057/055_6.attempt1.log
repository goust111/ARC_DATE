+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+AXIS_COLOR = 5
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+MAX_GENERATION_ATTEMPTS = 400
+
+SHAPE_LIBRARY = [
+    np.array([[1, 1]], dtype=int),
+    np.array([[1], [1]], dtype=int),
+    np.array([[1, 1, 1]], dtype=int),
+    np.array([[1], [1], [1]], dtype=int),
+    np.array([[1, 0], [1, 1]], dtype=int),
+    np.array([[0, 1], [1, 1]], dtype=int),
+    np.array([[1, 1], [1, 0]], dtype=int),
+    np.array([[1, 1], [0, 1]], dtype=int),
+    np.array([[1, 1], [1, 1]], dtype=int),
+    np.array([[1, 1, 1], [0, 1, 0]], dtype=int),
+    np.array([[0, 1, 0], [1, 1, 1]], dtype=int),
+    np.array([[1, 0], [1, 1], [1, 0]], dtype=int),
+    np.array([[0, 1], [1, 1], [0, 1]], dtype=int),
+]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _components_of_mask(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    neigh = DIR4 if connectivity == 4 else DIR8
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in neigh:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _monochrome_components(grid: np.ndarray, ignored: set[int]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color in ignored or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIR8:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords_arr = np.array(coords, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": _bbox(coords_arr),
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
