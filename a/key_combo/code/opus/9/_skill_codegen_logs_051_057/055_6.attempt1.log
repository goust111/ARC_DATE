+    for lr, lc in np.argwhere(scaled != bg):
+        rr = top + int(lr)
+        cc = left + int(lc)
+        mc = 2 * axis_col - cc
+        assert 0 <= rr < out.shape[0] and 0 <= mc < out.shape[1], "mirror paint out of bounds"
