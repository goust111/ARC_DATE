+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+Color = int
+Coord = tuple[int, int]
+Box = tuple[int, int, int, int]
+
+BG = 0
+PALETTE = (1, 2, 3, 4)
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+PAIR_COUNT_OPTIONS = (3, 4)
+PAIR_COUNT_WEIGHTS = (3, 5)
+RECT_SIZE_OPTIONS = (2, 3)
+GAP_RANGE = (2, 5)
+MIN_BBOX_GAP = 2
+MAX_GENERATION_ATTEMPTS = 800
+RAY_DIRS = (
+    (-1, 0, "up"),
+    (1, 0, "down"),
+    (0, -1, "left"),
+    (0, 1, "right"),
