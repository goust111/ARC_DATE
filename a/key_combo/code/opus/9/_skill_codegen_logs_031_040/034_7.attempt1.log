+            if _can_place(input_center, spec["side"], occupied_input):
+                _occupy(input_center, spec["side"], occupied_input)
+                objects.append(
+                    {
+                        "side": spec["side"],
+                        "final_center": spec["final_center"],
+                        "input_center": input_center,
+                        "final_arms": final_arms,
+                        "input_arms": input_arms,
