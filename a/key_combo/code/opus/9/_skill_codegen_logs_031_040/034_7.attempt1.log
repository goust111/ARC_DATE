+        side_v, half_c = "bottom", "left"
+    elif corner == "TR":
+        side_h, half_r = "left", "top"
+        side_v, half_c = "bottom", "right"
+    elif corner == "BL":
+        side_h, half_r = "right", "bottom"
+        side_v, half_c = "top", "left"
