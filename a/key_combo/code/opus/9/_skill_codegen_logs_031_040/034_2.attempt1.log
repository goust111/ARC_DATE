+    seen = np.zeros_like(grid, dtype=bool)
+    q = deque([seed])
+    seen[sr, sc] = True
+
+    def inside_window(r: int, c: int) -> bool:
+        return r0 < r < r1 and c0 < c <= c1
+
+    while q:
+        r, c = q.popleft()
