+def _find_wall_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    wall_mask = grid == WALL
+    r0, c0, r1, c1 = _bbox_of(wall_mask)
+    assert r1 - r0 >= 5 and c1 - c0 >= 4
