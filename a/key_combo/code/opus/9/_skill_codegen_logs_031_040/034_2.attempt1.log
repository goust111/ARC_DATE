+
+    grid = _build_input_from_params((h, w), frame_bbox, wall_bbox, seed, obstacles)
+    expected = _expected_from_params(grid, frame_bbox, wall_bbox)
+    if not _semantic_checks(grid, expected, frame_bbox, wall_bbox, blocked_rows):
+        return None
