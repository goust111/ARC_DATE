+    h, w = grid.shape
+    touches: dict[int, set[tuple[int, int]]] = {}
+    for r, c in region:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w:
+                color = int(grid[nr, nc])
+                if color not in (BLACK, GRAY):
