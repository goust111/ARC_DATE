+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _enclosed_regions(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    black = grid == BLACK
+    exterior = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    def add(r: int, c: int) -> None:
+        if black[r, c] and not exterior[r, c]:
+            exterior[r, c] = True
+            q.append((r, c))
+
+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w:
+                add(nr, nc)
+
+    return _components(black & ~exterior)
+
+
+def _find_bars(grid: np.ndarray) -> list[dict]:
+    bars: list[dict] = []
+    for color in sorted(set(map(int, np.unique(grid))) - {BLACK, GRAY}):
+        coords = np.argwhere(grid == color)
+        assert len(coords) > 0, f"missing pixels for color {color}"
+        cols = np.unique(coords[:, 1])
+        assert len(cols) == 1, "each colored object must stay in one column"
+        rows = np.sort(coords[:, 0])
+        assert np.all(np.diff(rows) == 1), "each colored object must be a contiguous vertical bar"
+        bars.append(
+            {
+                "color": int(color),
+                "col": int(cols[0]),
+                "top": int(rows[0]),
+                "bottom": int(rows[-1]),
+                "height": int(len(rows)),
+            }
+        )
+    return bars
