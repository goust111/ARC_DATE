+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+
+BAR_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, ORANGE)
+GEN_ATTEMPTS = 400
