        a0, b0, a1, b1, side = opt
        if side == "top":
            g[:a0, b0] = GEN_RED
            g[:a1, b1] = GEN_RED
        elif side == "bottom":
            g[a0 + 1 :, b0] = GEN_RED
            g[a1 + 1 :, b1] = GEN_RED
        elif side == "left":
            g[a0, :b0] = GEN_RED
            g[a1, :b1] = GEN_RED
        else:
            g[a0, b0 + 1 :] = GEN_RED
            g[a1, b1 + 1 :] = GEN_RED
        return True
    return False

