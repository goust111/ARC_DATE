+    if side == "left" and left1 < 2:
+        return None
+    boxes.append((top1, left1, bottom1, right1))
+    markers.extend(
+        _place_split_chamber(
+            grid,
+            side,
+            top1,
+            left1,
+            main_h,
+            main_w,
+            split_row,
+            colors.pop(),
+            colors.pop(),
