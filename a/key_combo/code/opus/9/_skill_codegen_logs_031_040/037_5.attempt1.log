+    right = left + width - 1
+    if side == "right":
+        _draw_segment(grid, top, left, top, right - 1)
+        _draw_segment(grid, bottom, left, bottom, right)
+        _draw_segment(grid, top, left, bottom, left)
+        _draw_segment(grid, top - 4, right - 1, top - 4, right + 1)
+        _draw_segment(grid, top - 3, right - 2, top - 1, right - 2)
+        _draw_segment(grid, top - 3, right + 2, top - 1, right + 2)
+        marker = {"row": top - 2, "col": right, "color": color_vertical}
+    else:
+        _draw_segment(grid, top, left + 1, top, right)
+        _draw_segment(grid, bottom, left, bottom, right)
+        _draw_segment(grid, top, right, bottom, right)
+        _draw_segment(grid, top - 4, left - 1, top - 4, left + 1)
+        _draw_segment(grid, top - 3, left - 2, top - 1, left - 2)
