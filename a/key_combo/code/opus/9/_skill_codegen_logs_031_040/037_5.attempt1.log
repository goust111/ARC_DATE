+        return chamber_h, chamber_w, split_delta
+    chamber_h, chamber_w, split_delta = random.choice(choices)
+    return chamber_h, chamber_w, abs(split_delta)
+
+
+def _build_candidate() -> tuple[np.ndarray, bool] | None:
+    h = random.randint(15, 17)
