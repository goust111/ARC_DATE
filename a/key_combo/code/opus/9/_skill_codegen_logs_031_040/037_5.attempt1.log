+
+
+def _place_simple_chamber(
+    grid: np.ndarray,
+    side: str,
+    top: int,
+    left: int,
+    height: int,
+    width: int,
+    color_vertical: int,
+) -> list[dict]:
+    bottom = top + height - 1
+    right = left + width - 1
