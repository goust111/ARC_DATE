+
+
+def _place_useless_markers(
+    grid: np.ndarray,
+    markers: list[dict],
+    boxes: list[tuple[int, int, int, int]],
+    colors: list[int],
+    count: int,
+) -> bool:
+    h, w = grid.shape
+    candidate_rows, candidate_cols = _safe_lines(h, w, boxes, markers)
+    used_rows = {int(m["row"]) for m in markers}
+    used_cols = {int(m["col"]) for m in markers}
+
+    options = [
