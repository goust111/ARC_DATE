+
+    for marker in markers:
+        r, c = int(marker["row"]), int(marker["col"])
+        if not (0 <= r < h and 0 <= c < w):
+            return None
+        if grid[r, c] != BLACK:
+            return None
+        grid[r, c] = int(marker["color"])
+
+    if not _validate_generated_input(grid, want_tie):
+        return None
+    return grid, want_tie
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
