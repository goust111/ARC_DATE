+    queue: deque[tuple[int, int]] = deque()
+
+    def add(r: int, c: int) -> None:
+        if mask_black[r, c] and not exterior[r, c]:
+            exterior[r, c] = True
+            queue.append((r, c))
+
+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w:
+                add(nr, nc)
+    return exterior
