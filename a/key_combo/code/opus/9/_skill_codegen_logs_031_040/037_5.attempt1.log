+    if side == "right":
+        left1 = random.randint(1, 2)
+    else:
+        left1 = w - main_w - random.randint(2, 3)
+    bottom1 = top1 + main_h - 1
+    if bottom1 >= h - 3:
+        return None
+    split_row = top1 + split_delta
+    right1 = left1 + main_w - 1
