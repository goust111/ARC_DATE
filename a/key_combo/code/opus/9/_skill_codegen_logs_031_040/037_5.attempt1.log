+def _grey_only_enclosed_count(grid: np.ndarray) -> int:
+    grey_mask = np.asarray(grid == GREY, dtype=bool)
+    black_mask = ~grey_mask
+    enclosed = black_mask & ~_exterior_black(black_mask)
+    return len(_components(enclosed))
