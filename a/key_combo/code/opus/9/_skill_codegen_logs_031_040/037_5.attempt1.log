+def _min_manhattan_to_grey(grey_cells: list[tuple[int, int]], r: int, c: int) -> int:
+    if not grey_cells:
+        return 10**9
+    return min(abs(r - rr) + abs(c - cc) for rr, cc in grey_cells)
