+
+
+def _shape8_halo(cells: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    halo: set[tuple[int, int]] = set()
+    for r, c in cells:
+        halo.add((r, c))
+        for dr, dc in NEIGHBORS8:
+            halo.add((r + dr, c + dc))
+    return halo
+
+
+def _place_objects(
+    grid: np.ndarray,
+    rng: random.Random,
+    counts_by_color: dict[int, int],
