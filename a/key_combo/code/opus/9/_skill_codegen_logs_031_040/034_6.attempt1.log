+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(800):
+        counts = rng.sample([1, 2, 3, 4, 5, 6], 4)
+        counts_by_color = {color: count for color, count in zip(KEY_COLORS, counts)}
+        if list(counts) == sorted(counts):
