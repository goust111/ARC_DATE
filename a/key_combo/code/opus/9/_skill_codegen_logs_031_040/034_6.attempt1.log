+    unsorted = _meta_unsorted_output(
+        grid.shape,
+        base_r,
+        legend_bbox,
+        list(meta["key_rows"]),
+        int(meta["key_col"]),
+        slot_cols,
+        initial_colors,
+        counts_by_color,
+    )
+    if np.array_equal(actual, unsorted):
+        return False
+    return True
+
