+
+        try:
+            objects = _place_objects(grid, rng, counts_by_color, forbidden, base_r)
+        except RuntimeError:
+            continue
+
+        meta = {
+            "base_r": base_r,
+            "legend_bbox": legend_bbox,
+            "slot_cols": slot_cols,
+            "slot_colors": list(KEY_COLORS),
+            "initial_heights": initial_heights,
+            "counts_by_color": counts_by_color,
