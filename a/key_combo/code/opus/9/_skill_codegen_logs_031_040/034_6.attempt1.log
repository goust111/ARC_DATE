+            if slot_start + 3 * gap + legend_w + right_margin + 2 <= 30
+        ]
+        if not feasible_gaps:
+            continue
+        slot_gap = rng.choice(feasible_gaps)
+        slot_cols = [slot_start + i * slot_gap for i in range(4)]
+
+        min_w = slot_cols[-1] + legend_w + right_margin + 2
+        if min_w > 30:
