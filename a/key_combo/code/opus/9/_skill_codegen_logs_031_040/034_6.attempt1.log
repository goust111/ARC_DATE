+
+        legend_bbox = (legend_r0, legend_c0, legend_r0 + legend_h - 1, legend_c0 + legend_w - 1)
+        r0, c0, r1, c1 = legend_bbox
+        grid[r0, c0 : c1 + 1] = GREY
+        grid[r1, c0 : c1 + 1] = GREY
+        grid[r0 : r1 + 1, c0] = GREY
+        grid[r0 : r1 + 1, c1] = GREY
+
+        key_col = c0 + 1
