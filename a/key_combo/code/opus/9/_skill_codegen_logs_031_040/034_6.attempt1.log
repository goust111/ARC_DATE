+        right_margin = rng.randint(1, 2)
+
+        slot_start = rng.randint(2, 4)
+        feasible_gaps = [
+            gap
+            for gap in (3, 4, 5)
+            if slot_start + 3 * gap + legend_w + right_margin + 2 <= 30
+        ]
+        if not feasible_gaps:
