+        return False
+    if [int(bar["color"]) for bar in parsed_bars] != initial_colors:
+        return False
+    parsed_counts = {
+        int(color): _count_color_objects(grid, int(color), parsed_legend, parsed_bars)
+        for color in KEY_COLORS
