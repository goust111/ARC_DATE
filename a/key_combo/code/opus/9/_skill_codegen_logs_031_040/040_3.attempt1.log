0303:     out = _solve_unrotated(g)
0304:     l9 = _find_l9_orientation(g)
0305:     if l9 == 'top_right':
0306:         return np.rot90(out, 1)
0307:     if l9 == 'top_left':
0308:         return np.rot90(out, 3)
0309:     return out
