0127: def main(grid: np.ndarray) -> np.ndarray:
0128:     """
0129:     Paint the maze corridor and framed rooms lying on shortest paths between the two colored endpoint components.
0130: 
0131:     Input structure
0132:     - The grid has a dominant background, one wall color forming thin orthogonal frames, and one endpoint/fill color.
0133:     - The endpoint/fill color forms exactly two 4-connected solid rectangular components; their larger side lengths define the framed room sizes.
0134: 
0135:     Rule
0136:     - Treat wall pixels as blocked and every other pixel as passable.
0137:     - Find every passable pixel that lies on a shortest 4-connected path between the two endpoint components.
0138:     - Also fill any framed square room of an endpoint-derived size that intersects that shortest-path mask.
0139: 
0140:     Key insight
0141:     - Shortest paths identify the route through open connector corridors, while the wall-bordered square rooms need to be expanded from the route centerline to their full interior.
0142:     """
0143:     g = np.asarray(grid, dtype=int)
0144:     assert g.ndim == 2
0145: 
0146:     bg = get_bg(g)
0147:     counts = Counter(map(int, g.flat))
0148: 
0149:     non_bg = colors_present(g, exclude={bg})
0150:     assert len(non_bg) == 2
0151:     assert counts[bg] > max(counts[color] for color in non_bg)
0152:     non_bg_counts = {color: int(np.count_nonzero(g == color)) for color in non_bg}
0153:     wall_count = max(non_bg_counts.values())
0154:     wall_candidates = [color for color, count in non_bg_counts.items() if count == wall_count]
0155:     assert len(wall_candidates) == 1
0156:     wall = wall_candidates[0]
0157:     paint_candidates = [color for color in non_bg if color != wall]
0158:     assert len(paint_candidates) == 1
0159:     paint = paint_candidates[0]
0160:     assert non_bg_counts[wall] > non_bg_counts[paint]
0161: 
0162:     endpoints = find_components(g, bg=bg, colors=[paint], connectivity=4)
0163:     assert len(endpoints) == 2
0164:     endpoint_coords = [component["coords"] for component in endpoints]
0165: 
0166:     room_sizes: set[int] = set()
0167:     for coords in endpoint_coords:
0168:         r0, c0, r1, c1 = bbox_coords(coords)
0169:         bh = r1 - r0 + 1
0170:         bw = c1 - c0 + 1
0171:         assert coords.shape[0] == bh * bw
0172:         room_sizes.add(max(bh, bw))
0173: 
0174:     passable = g != wall
0175:     dist0 = _distances_from(endpoint_coords[0], passable)
0176:     dist1 = _distances_from(endpoint_coords[1], passable)
0177:     endpoint_distances = [int(dist0[r, c]) for r, c in endpoint_coords[1]]
0178:     reachable_distances = [d for d in endpoint_distances if d >= 0]
0179:     assert len(reachable_distances) == len(endpoint_distances)
0180:     shortest = min(reachable_distances)
0181: 
0182:     route = (dist0 >= 0) & (dist1 >= 0) & (dist0 + dist1 == shortest)
0183:     assert np.any(route)
0184: 
0185:     fill = route.copy()
0186:     rooms = _framed_square_rooms(g, wall, room_sizes)
0187:     assert rooms
0188:     for r, c, n in rooms:
0189:         if np.any(route[r : r + n, c : c + n]):
0190:             fill[r : r + n, c : c + n] = True
0191: 
0192:     room_mask = np.zeros_like(fill, dtype=bool)
0193:     for r, c, n in rooms:
0194:         room_mask[r : r + n, c : c + n] = True
0195:     open_fill = fill & (g == bg) & ~room_mask
0196:     for r0, c0, r1, c1, area in _component_bboxes(open_fill):
0197:         if r1 > r0 and c1 > c0 and area >= 20:
0198:             assert _middle_fill_bounded_by_side_rooms(
0199:                 (r0, c0, r1, c1),
0200:                 rooms,
0201:             ), "middle fill must stay within the facing room-frame spans"
0202: 
0203:     H, W = g.shape
0204:     for r, c, n in rooms:
0205:         has_doorway = False
0206:         if r > 0:
0207:             has_doorway = has_doorway or np.any(g[r - 1, c : c + n] != wall)
0208:         if r + n < H:
0209:             has_doorway = has_doorway or np.any(g[r + n, c : c + n] != wall)
0210:         if c > 0:
0211:             has_doorway = has_doorway or np.any(g[r : r + n, c - 1] != wall)
0212:         if c + n < W:
0213:             has_doorway = has_doorway or np.any(g[r : r + n, c + n] != wall)
0214:         if has_doorway:
0215:             assert np.any(fill[r : r + n, c : c + n]), "rooms with doorways must be on the shortest path"
0216: 
0217:     out = g.copy()
0218:     out[fill & (g == bg)] = paint
0219:     return out
