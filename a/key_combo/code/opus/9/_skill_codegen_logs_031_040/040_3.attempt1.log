+    arr = np.asarray(values, dtype=int).reshape(-1)
+    width = int(arr.size)
+    assert width > 0
+    for period in range(1, width + 1):
+        if np.array_equal(arr, arr[np.arange(width) % period]):
+            return period
+    raise AssertionError("period not found")
+
