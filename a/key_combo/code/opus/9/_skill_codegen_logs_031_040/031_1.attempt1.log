def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()
    height = int(rng.integers(_GEN_CANVAS_MIN, _GEN_CANVAS_MAX_EXCLUSIVE))
    width = int(rng.integers(_GEN_CANVAS_MIN, _GEN_CANVAS_MAX_EXCLUSIVE))
