        if max_gap < 1:
            return False
        gap = int(rng.integers(1, max_gap + 1))
        in_c0 = out_c0 - gap if color == _GEN_BLUE else out_c0 + gap

        out[r0 : r0 + h, out_c0 : out_c0 + w] = _GEN_RED
        inp[r0 : r0 + h, in_c0 : in_c0 + w] = _GEN_RED
    return True


