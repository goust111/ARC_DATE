+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            return _build_instance()
+        except RuntimeError:
+            continue
+    raise RuntimeError("failed to generate a valid ARC instance")

