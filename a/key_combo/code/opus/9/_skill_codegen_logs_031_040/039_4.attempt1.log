+
+def _render_nested(colors: list[int]) -> np.ndarray:
+    size = 2 * len(colors) - 1
+    out = np.zeros((size, size), dtype=int)
+    for layer, color in enumerate(colors):
+        end = size - layer - 1
+        out[layer : end + 1, layer] = int(color)
+        out[layer : end + 1, end] = int(color)
