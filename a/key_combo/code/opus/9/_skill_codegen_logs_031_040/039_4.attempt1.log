+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _reconstruct_walls(local_mask: np.ndarray) -> np.ndarray:
+    h, w = local_mask.shape
+    walls = np.zeros((h, w), dtype=bool)
+    row_threshold = (w + 1) // 2
+    col_threshold = (h + 1) // 2
+
+    row_counts = local_mask.sum(axis=1)
+    col_counts = local_mask.sum(axis=0)
+
+    for r in range(h):
+        if int(row_counts[r]) >= row_threshold:
+            walls[r, :] = True
+    for c in range(w):
+        if int(col_counts[c]) >= col_threshold:
+            walls[:, c] = True
+    return walls
+
+
+def _count_rooms(walls: np.ndarray) -> int:
+    h, w = walls.shape
+    bg = ~walls
+    seen = np.zeros((h, w), dtype=bool)
+    rooms = 0
+
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
