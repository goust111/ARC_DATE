+    if expected is None:
+        return None
+
+    box_size = int(RNG.choice([5, 6]))
+    gap = 1
+    left = int(RNG.choice([1, 2]))
+    top = 1
+    height = top + count * box_size + (count - 1) * gap + 1
+    if height > 30:
+        return None
+
+    right_gap = int(RNG.choice([2, 3, 4]))
+    right_width = int(RNG.choice([5, 6, 7]))
+    right_margin = int(RNG.choice([1, 2]))
