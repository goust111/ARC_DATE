+    input_sig = _sig(grid)
+    output_sig = _sig(expected)
+    if input_sig in _SEEN_INPUT_SIGNATURES or output_sig in _SEEN_OUTPUT_SIGNATURES:
+        return None
+
+    sources = _extract_sources(grid)
+    shape_to_id = {record["shape"]: record["id"] for record in records}
