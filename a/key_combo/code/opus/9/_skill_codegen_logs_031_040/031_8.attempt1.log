+    shape_to_color = {src["shape"]: src["color"] for src in sources}
+    recovered_order = [shape_to_color[tpl["shape"]] for tpl in templates]
+    intended_order = [src["color"] for src in sorted(sources, key=lambda item: template_order_ids.index(item.get("record_id", -1)))]
+    if len(recovered_order) != len(intended_order):
+        return False
+
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return False
+    return True
+
+
+def _annotate_sources_with_ids(grid: np.ndarray, records: list[dict]) -> None:
+    sources = _extract_sources(grid)
+    by_shape = {record["shape"]: record["id"] for record in records}
+    for src in sources:
+        src["record_id"] = by_shape[src["shape"]]
+
+
+def _generate_attempt() -> np.ndarray | None:
+    count = int(RNG.choice([3, 4]))
+    areas = tuple(int(v) for v in RNG.choice(AREA_PATTERNS[count]))
+    records = _choose_shapes(areas)
+
+    template_order_ids = list(RNG.permutation([record["id"] for record in records]))
+    template_records = [next(record for record in records if record["id"] == rid) for rid in template_order_ids]
