    pairs = _gen_repetition_pairs(n, side)
    if not pairs:
        return None

    a, b = random.choice(pairs)
    colors = random.sample(_GEN_COLORS, n - 1)
    repeated = colors[0]
    others = colors[1:]

    top = [None] * n
    top[a] = repeated
    top[b] = repeated
    for c in range(n):
        if top[c] is None:
            top[c] = others.pop()

    grid = _gen_empty_grid(top)
    _gen_fill_free_body(grid)
