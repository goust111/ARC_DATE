+            for k in range(1, length + 1):
+                rr = -k if side == "N" else base_h - 1 + k
+                cells.add((rr, anchor))
+        else:
+            anchor = int(rng.integers(1, base_h - 1))
+            for k in range(1, length + 1):
+                cc = -k if side == "W" else base_w - 1 + k
+                cells.add((anchor, cc))
