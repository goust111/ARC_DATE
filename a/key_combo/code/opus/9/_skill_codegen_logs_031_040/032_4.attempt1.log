+            vals, counts = np.unique(patch, return_counts=True)
+            if BACKGROUND in vals or len(vals) != 2:
+                continue
+            if RED not in vals:
+                continue
+            if int(counts[vals.tolist().index(RED)]) != 1:
+                continue
