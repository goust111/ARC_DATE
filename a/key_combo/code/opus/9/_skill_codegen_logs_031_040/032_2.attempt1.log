+                continue
+            clipped = [cand for cand in candidates if cand["clipped"]]
+            plain = [cand for cand in candidates if not cand["clipped"]]
+            pool = candidates
+            if clipped_pref and clipped:
+                pool = clipped
+            elif plain_pref and plain:
+                pool = plain
+            elif clipped and plain:
