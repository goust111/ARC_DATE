+def _effective_color(original: int, depth: int, recolor: bool) -> int:
+    if not recolor:
+        return int(original)
+    return int(DEPTH_RECOLOR.get(int(depth), int(original)))
+
+
+def _solve_variant(
+    grid: np.ndarray,
+    *,
+    apply_shear: bool,
+    apply_recolor: bool,
+    use_true_depth: bool,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
