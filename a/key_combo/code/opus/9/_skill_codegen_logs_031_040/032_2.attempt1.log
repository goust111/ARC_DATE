+        _mark_mask(shifted, occupied_out)
+        sprite_meta.append(
+            {
+                "depth": depth,
+                "color": color,
+                "coords": coords,
+                "shifted": shifted,
+                "clipped": bool(chosen["clipped"]),
+            }
+        )
