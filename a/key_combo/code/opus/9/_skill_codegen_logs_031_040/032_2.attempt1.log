+    color_idx = 0
+    for depth, count in enumerate(counts_by_depth, start=1):
+        for _ in range(count):
+            sprite_specs.append({"depth": depth, "color": colors[color_idx]})
+            color_idx += 1
+    random.shuffle(sprite_specs)
