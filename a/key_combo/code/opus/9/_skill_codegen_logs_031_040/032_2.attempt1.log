+def _components_of_colors(
+    grid: np.ndarray, colors: set[int]
+) -> list[dict[str, object]]:
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[dict[str, object]] = []
+    for r in range(H):
+        for c in range(W):
