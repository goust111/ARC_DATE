+    else:
+        if side == "top":
+            rows = range(0, inner_h // 2)
+        else:
+            rows = range((inner_h + 1) // 2, inner_h)
+        cells = [(r, c) for r in rows for c in range(inner_w)]
+    return np.array(cells, dtype=int)
