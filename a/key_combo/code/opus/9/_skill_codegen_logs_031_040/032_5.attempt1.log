+def _focus_candidates(specs: list[dict]) -> list[dict]:
+    frames = []
+    for spec in specs:
+        dummy = {"bbox": (spec["r0"], spec["c0"], spec["r1"], spec["c1"]), **spec}
+        frames.append(dummy)
