+            raw_a, raw_b, raw_color = _winner_color(left, right, row0, row1, completed=False)
+            count_a, count_b, fill_color = _winner_color(left, right, row0, row1, completed=True)
+            pairs.append(
+                {
+                    "i": i,
+                    "j": j,
+                    "row0": row0,
+                    "row1": row1,
+                    "gap0": gap0,
+                    "gap1": gap1,
+                    "blocked": blocked,
+                    "raw_a": raw_a,
+                    "raw_b": raw_b,
+                    "raw_color": raw_color,
