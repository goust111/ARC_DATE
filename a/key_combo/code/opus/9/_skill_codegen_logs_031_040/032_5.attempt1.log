+    r1, c1 = int(frame["r1"]), int(frame["c1"])
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+
+
+def _attempt_generate(require_tie: bool) -> np.ndarray | None:
+    specs = _sample_specs()
