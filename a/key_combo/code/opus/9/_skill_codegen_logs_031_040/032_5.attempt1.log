+            row0 = max(int(left["r0"]), int(right["r0"]))
+            row1 = min(int(left["r1"]), int(right["r1"]))
+            if row0 > row1:
+                continue
+
+            gap0 = int(left["c1"]) + 1
+            gap1 = int(right["c0"]) - 1
+            blocked = False
