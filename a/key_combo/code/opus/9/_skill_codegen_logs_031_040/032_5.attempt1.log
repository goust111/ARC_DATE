    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    changed += int((out "'!= inp).sum())
print('"'variants', len(sigs), 'avg_changed', changed / 100)
assert len(sigs) >= 20

# tie check
G = np.zeros((8, 16), dtype=int)
# left square frame
G[1:7, 1] = G[1:7, 6] = 5
G[1, 1:7] = G[6, 1:7] = 5
G[2, 2] = G[3, 2] = G[4, 2] = 1
# right square frame
G[1:7, 10] = G[1:7, 15] = 5
G[1, 10:16] = G[6, 10:16] = 5
G[2, 11] = G[3, 11] = G[4, 11] = 2
O = mod.main(G)
