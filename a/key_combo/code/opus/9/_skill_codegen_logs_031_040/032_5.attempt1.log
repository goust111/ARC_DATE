+    out = g.copy()
+    for frame in frames:
+        rr = frame["completed_abs"][:, 0]
+        cc = frame["completed_abs"][:, 1]
+        out[rr, cc] = int(frame["color"])
+
+    for pair in pairs:
+        if pair["blocked"]:
+            continue
+        out[pair["row0"] : pair["row1"] + 1, pair["gap0"] : pair["gap1"] + 1] = int(pair["fill_color"])
+
+    return out
