+def _in_bounds(shape, r, c):
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r, c):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8_including_self(r, c):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            yield r + dr, c + dc
+
+
+def _chebyshev(a, b):
+    return max(abs(a[0] - b[0]), abs(a[1] - b[1]))
+
+
+def _bbox(points):
+    rows = [p[0] for p in points]
+    cols = [p[1] for p in points]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _build_graph(cells):
+    cells = set(cells)
+    graph = defaultdict(list)
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells:
+                graph[(r, c)].append((nr, nc))
+    return graph
+
+
+def _count_simple_paths(cells, start, end, limit=2):
+    graph = _build_graph(cells)
+    if start not in graph and start != end:
+        return 0
+    count = 0
+    seen = {start}
+
+    def dfs(node):
+        nonlocal count
+        if count >= limit:
+            return
+        if node == end:
+            count += 1
+            return
+        for nxt in graph[node]:
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            dfs(nxt)
+            seen.remove(nxt)
+            if count >= limit:
+                return
+
+    dfs(start)
+    return count
+
+
+def _unique_simple_path(cells, start, end):
+    cells = set(cells)
+    graph = _build_graph(cells)
+    if start not in cells or end not in cells:
+        return None
+    found = []
+    path = [start]
+    seen = {start}
+
+    def dfs(node):
+        if len(found) > 1:
+            return
+        if node == end:
+            found.append(path.copy())
+            return
+        for nxt in graph[node]:
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            path.append(nxt)
+            dfs(nxt)
+            path.pop()
+            seen.remove(nxt)
+            if len(found) > 1:
+                return
+
+    dfs(start)
+    if len(found) != 1:
+        return None
+    return found[0]
+
+
+def _forbidden_mask(grid):
+    forbidden = np.zeros(grid.shape, dtype=bool)
+    for r, c in np.argwhere(grid == ORANGE):
+        for nr, nc in _neighbors8_including_self(int(r), int(c)):
+            if _in_bounds(grid.shape, nr, nc):
+                forbidden[nr, nc] = True
