+    out = np.zeros((n * n, n * n), dtype=int)
+    mask = template == MAROON
+    for br, bc in np.argwhere(mask):
+        rs = int(br) * n
+        cs = int(bc) * n
+        out[rs : rs + n, cs : cs + n][mask] = MAROON
+    return out
