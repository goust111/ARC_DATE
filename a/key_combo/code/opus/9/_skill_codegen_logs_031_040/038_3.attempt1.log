        assert _path_reaches_marker(g, parking[0], marker, path_color, {gate})

        for r, c in coords:
            if int(g[r, c]) in (path_color, marker_color):
                out[r, c] = bg
        out[gate] = path_color
        out[parking[0]] = marker_color

    return out

