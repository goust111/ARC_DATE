+def _template_from_path(path):
+    r0, c0, r1, c1 = _bbox(path)
+    n_rows = r1 - r0 + 1
+    n_cols = c1 - c0 + 1
+    if n_rows != n_cols:
+        raise ValueError("path bbox must be square")
+    template = np.zeros((n_rows, n_cols), dtype=int)
+    for r, c in path:
+        template[r - r0, c - c0] = MAROON
+    return template
