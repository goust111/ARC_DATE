+def _build_graph(cells):
+    cells = set(cells)
+    graph = defaultdict(list)
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells:
+                graph[(r, c)].append((nr, nc))
+    return graph
+
+
+def _count_simple_paths(cells, start, end, limit=2):
+    graph = _build_graph(cells)
+    if start not in graph and start != end:
+        return 0
+    count = 0
+    seen = {start}
+
+    def dfs(node):
+        nonlocal count
+        if count >= limit:
+            return
+        if node == end:
+            count += 1
+            return
+        for nxt in graph[node]:
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            dfs(nxt)
+            seen.remove(nxt)
+            if count >= limit:
+                return
