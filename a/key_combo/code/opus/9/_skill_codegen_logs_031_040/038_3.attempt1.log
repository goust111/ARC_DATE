+    r, c = coord
+    if flip:
+        c = n - 1 - c
+    for _ in range(rot % 4):
+        r, c = c, n - 1 - r
+    return r, c
+
+
+def _transform_path(seq, n):
+    rot = random.randrange(4)
+    flip = bool(random.randrange(2))
+    return [_transform_coord(coord, n, rot, flip) for coord in seq]
