+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+SEED_COLORS = (BLUE, GREEN, YELLOW, ORANGE)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
