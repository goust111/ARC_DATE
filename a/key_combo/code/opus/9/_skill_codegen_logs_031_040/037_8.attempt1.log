GEN_MOVING_PAIRS = ((1, 8), (4, 7))
MOVING_PAIR_SETS = {frozenset(pair) for pair in GEN_MOVING_PAIRS}
FOREGROUND_COLORS = range(1, 10)
DISTRACTOR_PAIRS = tuple(
