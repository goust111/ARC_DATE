    found: list[tuple[int, int]] = []
    sample_h, sample_w = sample.shape
    for r in range(g.shape[0] - sample_h + 1):
        for c in range(g.shape[1] - sample_w + 1):
            if np.array_equal(g[r : r + sample_h, c : c + sample_w], sample):
                found.append((r, c))
    return found


