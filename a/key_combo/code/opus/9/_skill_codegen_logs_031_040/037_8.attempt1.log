) -> bool:
    sample_h, sample_w = sample.shape
    for dr in range(sample_h):
        for dc in range(sample_w):
            got = value if (wr + dr == rr and wc + dc == cc) else g[wr + dr, wc + dc]
            if got != sample[dr, dc]:
                return False
    return True


def _gen_safe_values_for_cell(
    g: np.ndarray,
    sample: np.ndarray,
    rr: int,
    cc: int,
    expected_matches: set[tuple[int, int]],
) -> list[int]:
