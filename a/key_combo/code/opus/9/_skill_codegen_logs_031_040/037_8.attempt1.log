+        _mask_to_cells(("101", "111")),
+        _mask_to_cells(("010", "111", "101")),
+        _mask_to_cells(("111", "010", "101")),
+    ]
+    variants = []
+    seen_shapes = set()
+    for orient in ("v", "h"):
+        for base in base_vertical:
