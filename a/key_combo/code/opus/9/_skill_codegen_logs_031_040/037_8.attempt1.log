+    kind, axis_sum = axis
+    other_kind = "h" if kind == "v" else "v"
+    other_axis_sum = (_bbox(full_cells)[0] + _bbox(full_cells)[2]) if other_kind == "h" else (_bbox(full_cells)[1] + _bbox(full_cells)[3])
+    if _axis_score(target["cells"], kind, axis_sum) <= _axis_score(target["cells"], other_kind, other_axis_sum):
+        return False
+    if not np.array_equal(main(inp), out):
