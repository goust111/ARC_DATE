        return pair[1], pair[0]
    return pair


def _separated_columns(cols: int, max_gap: int) -> tuple[int, int]:
    gap = int(_RNG.integers(1, min(max_gap, cols - 2) + 1))
    c0 = int(_RNG.integers(0, cols - gap - 1))
    return c0, c0 + gap + 1


