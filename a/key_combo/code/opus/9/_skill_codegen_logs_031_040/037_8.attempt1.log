from itertools import combinations

def neighbors4(cell):
    r,c=cell
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def bbox(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    return min(rs),min(cs),max(rs),max(cs)

def normalize(cells):
    r0,c0,_,_=bbox(cells)
    return frozenset((r-r0,c-c0) for r,c in cells)

def connected(cells):
    cells=set(cells)
    start=next(iter(cells))
    seen={start}; stack=[start]
    while stack:
        x=stack.pop()
        for nb in neighbors4(x):
            if nb in cells and nb not in seen:
                seen.add(nb); stack.append(nb)
    return len(seen)==len(cells)

def sym_axes(cells):
    r0,c0,r1,c1=bbox(cells)
    out=[]
    for kind,s in [('v',c0+c1),('h',r0+r1)]:
        ok=True
        for r,c in cells:
            m=(r,s-c) if kind=='v' else (s-r,c)
            if m not in cells:
                ok=False; break
        if ok: out.append((kind,s))
    return out

def mirror(cell, kind, s):
    r,c=cell
    return (r,s-c) if kind=='v' else (s-r,c)

allcells=[(r,c) for r in range(5) for c in range(5)]
