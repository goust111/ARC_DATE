+    r0, c0, r1, c1 = _bbox(occluder)
+    frame_cells = set()
+    for r in range(r0 - 1, r1 + 2):
+        frame_cells.add((r, c0 - 1))
+        frame_cells.add((r, c1 + 1))
+    for c in range(c0 - 1, c1 + 2):
+        frame_cells.add((r0 - 1, c))
+        frame_cells.add((r1 + 1, c))
+    for r, c in frame_cells:
