+            variants.append(
+                {
+                    "cells": cells,
+                    "shape": shape,
+                    "axis": axes[0],
+                    "size": len(cells),
+                    "bbox": _bbox(cells),
+                    "placements": placements,
+                }
+            )
+    return variants
+
+
+VARIANTS = _build_variants()
+
