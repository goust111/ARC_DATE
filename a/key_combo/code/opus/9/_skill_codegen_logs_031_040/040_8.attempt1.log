+    def paint_row(row: int, lo: int, hi: int) -> None:
+        if not 0 <= int(row) < height:
+            return
+        for col in range(int(lo), int(hi) + 1):
+            if 0 <= col < width and not blocked[int(row), col]:
+                out[int(row), col] = True
