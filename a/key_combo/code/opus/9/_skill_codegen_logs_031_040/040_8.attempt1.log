+            r0 = cross_r - distances[role] - (shape["h"] - 1)
+            c0 = cross_c - info["center"]
+        else:
+            r0 = cross_r + distances[role]
+            c0 = cross_c - info["center"]
+        placements[role] = (int(r0), int(c0))
+
+    pixels = []
+    bboxes = []
+    for role in roles:
+        shape = shapes[role]
+        r0, c0 = placements[role]
+        if r0 < 0 or c0 < 0 or r0 + shape["h"] > height or c0 + shape["w"] > width:
+            return None
+        pix = _object_pixels(shape["mask"], r0, c0)
+        pixels.append(pix)
+        bboxes.append(_placed_bbox(shape, r0, c0))
+
+    for i in range(len(pixels)):
+        for j in range(i + 1, len(pixels)):
+            if pixels[i] & pixels[j]:
+                return None
+            if _min_pixel_distance(pixels[i], pixels[j]) < 2:
+                return None
+
+    for role in roles:
+        shape = shapes[role]
+        r0, c0 = placements[role]
+        _paint_object(grid, shape["mask"], r0, c0)
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        candidate = _build_candidate()
+        if candidate is None:
+            continue
+        if _validate_example(candidate):
+            return candidate
+    raise RuntimeError("failed to generate a valid non-degenerate ARC input")

