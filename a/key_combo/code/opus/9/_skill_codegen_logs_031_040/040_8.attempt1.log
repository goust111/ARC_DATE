+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    components = find_components(
+        g,
+        bg=Color.BLACK,
+        colors=[Color.TEAL],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    components.sort(key=lambda comp: tuple(map(int, comp["bbox"])))
+    return components
