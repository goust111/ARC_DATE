+        spans = _side_spans(mask)
+        if min(hi - lo + 1 for lo, hi in spans.values()) < 3:
+            continue
+        coords = np.argwhere(mask)
+        bbox = (
+            int(coords[:, 0].min()),
+            int(coords[:, 1].min()),
+            int(coords[:, 0].max()),
+            int(coords[:, 1].max()),
+        )
+        side_info = {}
+        for side, (lo, hi) in spans.items():
+            length = int(hi) - int(lo) + 1
+            side_info[side] = {
+                "lo": int(lo),
+                "hi": int(hi),
+                "length": length,
+                "reach": (length - 1) // 2,
+                "center": (int(lo) + int(hi)) // 2,
+                "odd": length % 2 == 1,
+            }
+        catalog.append(
+            {
+                "name": name,
+                "mask": mask,
+                "bbox": bbox,
+                "h": int(mask.shape[0]),
+                "w": int(mask.shape[1]),
+                "area": area,
+                "side_info": side_info,
+                "is_rect": area == int(mask.shape[0] * mask.shape[1]),
+            }
+        )
+    return catalog
