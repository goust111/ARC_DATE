+                        pix = _object_pixels(shape["mask"], r0, c0)
+                        if occupied & pix:
+                            continue
+                        if min(_min_pixel_distance(pix, prev) for prev in core_pixels) < 4:
+                            continue
+                        _paint_object(grid, shape["mask"], r0, c0)
+                        return grid
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
