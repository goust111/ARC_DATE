+    if len(trace) < 2:
+        return False
+    if not any(event["created_seed_cols"] for event in trace):
+        return False
+    if not _has_chain_interaction(trace):
+        return False
+    if np.array_equal(forward, reverse):
+        return False
+    if not np.any(forward == RED):
