+
+def _shortest_random_path(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    out = [(r, c)]
+    while (r, c) != (tr, tc):
+        moves = []
+        if r < tr:
+            moves.append((1, 0))
+        elif r > tr:
+            moves.append((-1, 0))
+        if c < tc:
+            moves.append((0, 1))
+        elif c > tc:
+            moves.append((0, -1))
+        dr, dc = random.choice(moves)
+        r += dr
+        c += dc
+        out.append((r, c))
+    return out
+
+
+def _is_connected_cells(cells: set[tuple[int, int]]) -> bool:
