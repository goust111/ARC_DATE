+    required = {
+        (0, 0),
+        (height - 1, width - 1),
+        (height - 1, cut),
+        (0, cut - 1),
+        (0, cut + 1),
+        (0, width - 1),
+    }
+    mask = _grow_mask(height, width, required)
+    if mask is None or not mask[:, cut].any() or not mask[:, width - 1].any():
+        return None
+    return {
+        "kind": "coupled",
+        "left": left,
+        "width": width,
+        "height": height,
+        "mask": mask,
