+    bboxes = []
+    for comp in comps:
+        area = len(comp)
+        r0, c0, r1, c1 = _bbox(comp)
+        if not 6 <= area <= 12:
+            return False
+        if r0 == 0 or r1 == grid.shape[0] - 1:
+            return False
+        if c1 - c0 + 1 < 3:
+            return False
+        if (r1 - r0) == (c1 - c0):
+            return False
+        crossings = sum(c0 <= c <= c1 for c in seed_cols)
+        if crossings > 1:
+            return False
+        bboxes.append((r0, c0, r1, c1))
