+    else:
+        height = random.choice([5, 6])
+    if width >= height and orientation == "tall":
+        height = width + random.choice([1, 2])
+    if width == height:
+        height += 1
+    left = path_col - cut
+    required = {
+        (0, 0),
+        (height - 1, width - 1),
+        (height - 1, cut),
+        (0, cut - 1),
+        (0, cut + 1),
