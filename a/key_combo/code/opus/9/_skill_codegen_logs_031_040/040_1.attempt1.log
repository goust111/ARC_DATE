+    for seed_order, seed_col in enumerate(process_cols):
+        r = g.shape[0] - 1
+        c = int(seed_col)
+        while r > 0:
+            above = int(g[r - 1, c])
+            if above == BLACK:
+                r -= 1
+                g[r, c] = RED
