+def _connect_groups(
+    grid: np.ndarray,
+    row_runs: list[tuple[int, int]],
+    col_runs: list[tuple[int, int]],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    groups = _extract_endpoint_groups(out, row_runs, col_runs)
+    assert groups, "expected at least one endpoint group"
