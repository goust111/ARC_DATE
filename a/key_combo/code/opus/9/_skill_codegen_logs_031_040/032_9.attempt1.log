+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+ENDPOINT_COLORS = (BLUE, RED, ORANGE)
+TILE_ROWS = 4
+TILE_COLS = 4
+TILE_SIZE = 3
+STRIDE = 4
+GRID_SHAPE = (STRIDE * TILE_ROWS + 1, STRIDE * TILE_COLS + 1)
+SUBCELLS = tuple((dr, dc) for dr in range(TILE_SIZE) for dc in range(TILE_SIZE))
