+    groups: list[dict[str, object]] = []
+    used_endpoint_tiles: set[tuple[int, int]] = set()
+    for color, subcell, kind in zip(colors, subcells, kinds):
+        points = None
+        for _ in range(100):
+            candidate = _sample_group_points(kind)
+            if used_endpoint_tiles & set(candidate):
