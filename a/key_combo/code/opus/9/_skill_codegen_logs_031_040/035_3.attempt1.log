+    inp = repaired_with_red.copy()
+    for r, c in masks:
+        inp[r, c] = GREY
+    return inp if _validate_case(inp) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid symmetric-ray ARC input")

