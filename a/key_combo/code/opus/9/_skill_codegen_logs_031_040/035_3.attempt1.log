+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+GRID_SIZE = 13
+CENTER = GRID_SIZE // 2
+
+Coord = tuple[int, int]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _rot90_ccw(coord: Coord, center: int) -> Coord:
+    r, c = coord
+    dr = r - center
+    dc = c - center
+    return center - dc, center + dr
+
+
+def _orbit(coord: Coord, center: int) -> list[Coord]:
+    cells = [coord]
+    for _ in range(3):
+        cells.append(_rot90_ccw(cells[-1], center))
+    return cells
+
+
+def _sign(x: int) -> int:
+    return 0 if x == 0 else (1 if x > 0 else -1)
+
+
+def _ray_direction(r: int, c: int, center: int) -> Coord:
+    dr0 = _sign(r - center)
+    dc0 = _sign(c - center)
+    if dr0 != 0 and dc0 != 0:
+        return dr0, dc0
+    if dr0 == 0 and dc0 != 0:
+        # Center-row tie-break: follow the adjacent CCW orbit quadrant.
+        return -dc0, dc0
