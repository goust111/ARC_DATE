+        if paint:
+            out[nr, nc] = ORANGE
+        path.append((nr, nc))
+        r, c = nr, nc
+
+
+def _solve(grid: np.ndarray, *, paint_rays: bool) -> tuple[np.ndarray, np.ndarray, list[dict], list[Coord]]:
