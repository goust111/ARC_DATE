+        nr, nc = r + dr, c + dc
+        if not _in_bounds(out.shape, nr, nc):
+            return {
+                "path": path,
+                "reflections": reflections,
+                "reason": "boundary",
+                "seed": seed,
+                "direction": direction,
+            }
