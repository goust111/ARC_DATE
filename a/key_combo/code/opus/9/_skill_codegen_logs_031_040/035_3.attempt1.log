+        cell = int(out[nr, nc])
+        if cell == RED:
+            orientation = mirrors.get((nr, nc))
+            assert orientation is not None
+            if orientation == "horizontal":
+                dr = -dr
+            else:
+                dc = -dc
+            reflections += 1
+            continue
