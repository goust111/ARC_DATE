+BG = 0
+SPRITE_COLORS = {1, 8}
+MARKER_COLOR = 1
+ANCHOR_COLOR = 1
+CONTROL_COLORS = (2, 3, 4, 7)
+MAX_GEN_ATTEMPTS = 500
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_to_bbox(grid: np.ndarray, coords: np.ndarray, fill: int = BG) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), int(fill), dtype=int)
+    rr = coords[:, 0] - r0
+    cc = coords[:, 1] - c0
+    out[rr, cc] = grid[coords[:, 0], coords[:, 1]]
+    return out
+
+
+def components_of_colors(
+    grid: np.ndarray, allowed: set[int], connectivity: int = 4
+) -> list[np.ndarray]:
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[np.ndarray] = []
+    if connectivity == 4:
+        steps = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
+        steps = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
+        )
+
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or int(grid[r, c]) not in allowed:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in steps:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) in allowed:
