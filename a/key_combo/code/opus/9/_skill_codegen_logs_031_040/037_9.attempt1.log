+    r0, c0, r1, c1 = bbox_coords(coords)
+    out = np.full((r1 - r0 + 1, c1 - c0 + 1), int(fill), dtype=int)
+    rr = coords[:, 0] - r0
+    cc = coords[:, 1] - c0
+    out[rr, cc] = grid[coords[:, 0], coords[:, 1]]
+    return out
