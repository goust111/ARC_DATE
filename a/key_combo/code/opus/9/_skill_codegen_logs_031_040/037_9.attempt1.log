+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[np.ndarray] = []
+    if connectivity == 4:
+        steps = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
+        steps = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
+        )
+
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or int(grid[r, c]) not in allowed:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in steps:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) in allowed:
