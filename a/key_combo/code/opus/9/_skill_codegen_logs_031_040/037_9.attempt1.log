+def components_of_colors(
+    grid: np.ndarray, allowed: set[int], connectivity: int = 4
+) -> list[np.ndarray]:
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[np.ndarray] = []
+    if connectivity == 4:
+        steps = ((1, 0), (-1, 0), (0, 1), (0, -1))
+    else:
+        steps = tuple(
+            (dr, dc)
+            for dr in (-1, 0, 1)
+            for dc in (-1, 0, 1)
+            if not (dr == 0 and dc == 0)
