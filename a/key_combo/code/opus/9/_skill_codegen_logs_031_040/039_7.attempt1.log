import numpy as np
from collections import deque, defaultdict

templates = {
'A':['##.','.##','..#'],
'B':['##.','###','..#'],
'C':['###.','..##','...#'],
'D':['###.','..#.','..##'],
'E':['##..','.###','..#.'],
'F':['##..','.###','...#'],
}

def parse(rows):
    a=np.array([[ch=='#' for ch in row] for row in rows],dtype=bool)
    return a

def all_transforms(mask):
    outs=[]
    for k in range(4):
        arr=np.rot90(mask,k)
        for flip in [False,True]:
            b=np.fliplr(arr) if flip else arr.copy()
            pts=np.argwhere(b)
            r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
            tight=b[r0:r1+1,c0:c1+1]
            if not any(np.array_equal(tight,x) for x in outs):
                outs.append(tight)
    return outs

def no_hole(mask):
    H,W=mask.shape; bg=~mask; seen=np.zeros((H,W),bool); q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
