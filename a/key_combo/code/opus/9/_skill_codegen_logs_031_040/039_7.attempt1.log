import itertools, numpy as np
from collections import deque, defaultdict

sizes=[5,6,7]

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    q=[tuple(map(int,pts[0]))]
    seen={q[0]}
    H,W=mask.shape
    while q:
        r,c=q.pop()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc));q.append((nr,nc))
    return len(seen)==len(pts)

def no_hole(mask):
    H,W=mask.shape
    bg=~mask
    seen=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1; q.append((nr,nc))
    return not np.any(bg & ~seen)

def analyze(mask):
    H,W=mask.shape
    tiled=np.tile(mask,(3,3))
    fg=tiled
    outline=np.zeros_like(fg)
    HH,WW=fg.shape
    for r in range(HH):
        for c in range(WW):
            if fg[r,c]:
                continue
            ok=False
            for dr in (-1,0,1):
                for dc in (-1,0,1):
                    if dr==0 and dc==0: continue
                    nr,nc=r+dr,c+dc
                    if 0<=nr<HH and 0<=nc<WW and fg[nr,nc]: ok=True
            outline[r,c]=ok
    allowed=(~fg)&(~outline)
    seen=np.zeros_like(fg)
    q=deque()
    for r in range(HH):
        for c in [0,WW-1]:
            if allowed[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    for c in range(WW):
        for r in [0,HH-1]:
            if allowed[r,c] and not seen[r,c]: seen[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<HH and 0<=nc<WW and allowed[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1; q.append((nr,nc))
    holes=allowed & ~seen
    comps=[]
    seen2=np.zeros_like(fg)
    for r in range(HH):
        for c in range(WW):
            if holes[r,c] and not seen2[r,c]:
                qq=[(r,c)]; seen2[r,c]=1; area=0
                while qq:
                    rr,cc=qq.pop(); area+=1
                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<HH and 0<=nc<WW and holes[nr,nc] and not seen2[nr,nc]:
                            seen2[nr,nc]=1; qq.append((nr,nc))
                comps.append(area)
    return sorted(comps)

def canonical(cells):
    pts=np.array(cells)
    pts=pts-pts.min(axis=0)
    forms=[]
    for k in range(4):
        arr=pts.copy()
        for _ in range(k):
            arr=np.stack([arr[:,1],-arr[:,0]],axis=1)
            arr=arr-arr.min(axis=0)
        for flip in [False,True]:
            b=arr.copy()
            if flip:
                b[:,1]=-b[:,1]
                b=b-b.min(axis=0)
            forms.append(tuple(map(tuple,sorted(map(tuple,b.tolist())))))
    return min(forms)

seen=set(); found=[]
for n in range(3,7):
    for h in sizes:
        for w in sizes:
            cells=[(r,c) for r in range(h) for c in range(w)]
            for comb in itertools.combinations(cells,n):
                if not conn(np.array([[ (r,c) in comb for c in range(w)] for r in range(h)],dtype=bool)):
                    continue
                key=canonical(comb)
                if key in seen: continue
                seen.add(key)
                pts=np.array(comb)
                sh=pts[:,0].max()-pts[:,0].min()+1
                sw=pts[:,1].max()-pts[:,1].min()+1
                if sh>4 or sw>4: # keep small archetypes
