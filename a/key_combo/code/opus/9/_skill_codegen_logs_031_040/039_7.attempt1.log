+        for c in (0, w - 1):
+            if background[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if background[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(mask.shape, nr, nc) and background[nr, nc] and not reachable[nr, nc]:
+                reachable[nr, nc] = True
