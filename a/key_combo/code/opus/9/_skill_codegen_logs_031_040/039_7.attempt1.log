        cand=[]
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and (nr,nc) not in pts:
                cand.append((nr,nc))
        if not cand: return None
        pts.add(random.choice(cand))
    return pts

