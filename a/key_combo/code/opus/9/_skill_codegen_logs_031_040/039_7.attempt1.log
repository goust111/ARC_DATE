+    unique_areas = tuple(sorted(set(area_signature)))
+    if unique_areas != target_areas:
+        return False
+    counts_by_area = {area: area_signature.count(area) for area in unique_areas}
+    if any(counts_by_area[area] < 2 for area in unique_areas):
+        return False
