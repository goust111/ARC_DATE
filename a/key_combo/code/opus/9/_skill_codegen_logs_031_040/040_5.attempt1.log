+CM_DIMS = [
+    (2, 4),
+    (2, 5),
+    (2, 6),
+    (2, 7),
+    (3, 4),
+    (4, 2),
+    (5, 2),
+    (6, 2),
+    (7, 2),
+    (4, 3),
+]
+
+CF_DIMS = [
+    (2, 5),
+    (2, 6),
+    (2, 7),
+    (2, 8),
+    (2, 9),
+    (3, 4),
+    (3, 5),
+    (3, 6),
+    (4, 3),
+    (4, 4),
+    (5, 2),
+    (5, 3),
+    (6, 2),
+]
