 104: # --------------- generator (o5x) ---------------
 105: 
 106: # Canvas, palette, and retry budget.
 107: BACKGROUND_COLOR = 0
 108: FOREGROUND_COLORS = tuple(range(1, 10))
 109: MAX_GRID_SIZE = 19
 110: MIN_GRID_SIZE_BY_COUNT = (8, 8, 10, 12, 14, 16, 18, 19)
 111: GENERATION_RETRIES = 300
 112: 
 113: # Object counts, dimensions, and orientations.
 114: MIN_OBJECT_COUNT = 1
 115: MAX_OBJECT_COUNT = 7
 116: SHORT_SIDE_SIZES = (2, 3, 4, 5, 6)
 117: LONG_SIDE_FACTOR = 2
 118: WIDE = "wide"
 119: TALL = "tall"
 120: ORIENTATIONS = [WIDE, TALL]
 121: 
 122: # Dense layouts try smaller rectangles first while preserving random tie order.
 123: DENSE_COUNT_THRESHOLD = 6
 124: DENSE_PREFERRED_MAX_SHORT_SIDE = 3
 125: PACKED_COUNT_THRESHOLD = 4
 126: PACKED_PREFERRED_MAX_SHORT_SIDE = 4
 127: 
 128: # Placement and retry constraints.
 129: SHIFT_PADDING = 1
 130: MIN_CHEB_GAP = 2
 131: 
 132: BBox = tuple[int, int, int, int]
 133: Location = tuple[int, int]
 134: ObjectSpec = tuple[int, int, int, str]
 135: 
 136: 
 137: def _interval_sep(a0: int, a1: int, b0: int, b1: int) -> int:
 138:     if a1 < b0:
 139:         return b0 - a1
 140:     if b1 < a0:
 141:         return a0 - b1
 142:     return 0
 143: 
 144: 
 145: def _cheb_gap_at_least_2(a: BBox, b: BBox) -> bool:
 146:     dr = _interval_sep(a[0], a[2], b[0], b[2])
 147:     dc = _interval_sep(a[1], a[3], b[1], b[3])
 148:     return max(dr, dc) >= MIN_CHEB_GAP
 149: 
 150: 
 151: def _overlap(a: BBox, b: BBox) -> bool:
 152:     return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
 153: 
 154: 
 155: def _expanded_bbox(r: int, c: int, h: int, w: int) -> BBox:
 156:     if w > h:
 157:         return r, c - SHIFT_PADDING, r + h - 1, c + w - 1 + SHIFT_PADDING
 158:     return r - SHIFT_PADDING, c, r + h - 1 + SHIFT_PADDING, c + w - 1
 159: 
 160: 
 161: def _object_dims(short_side: int, orient: str) -> tuple[int, int]:
 162:     if orient == WIDE:
 163:         return short_side, LONG_SIDE_FACTOR * short_side
 164:     return LONG_SIDE_FACTOR * short_side, short_side
 165: 
 166: 
 167: def _locations(n: int, h: int, w: int, originals: list[BBox], expanded: list[BBox]) -> list[Location]:
 168:     if w > h:
 169:         row_range = range(0, n - h + 1)
 170:         col_range = range(SHIFT_PADDING, n - w - SHIFT_PADDING + 1)
 171:     else:
 172:         row_range = range(SHIFT_PADDING, n - h - SHIFT_PADDING + 1)
 173:         col_range = range(0, n - w + 1)
 174: 
 175:     locs: list[Location] = []
 176:     for r in row_range:
 177:         for c in col_range:
 178:             orig = (r, c, r + h - 1, c + w - 1)
 179:             exp = _expanded_bbox(r, c, h, w)
 180:             if any(not _cheb_gap_at_least_2(orig, old) for old in originals):
 181:                 continue
 182:             if any(_overlap(exp, old) for old in expanded):
 183:                 continue
 184:             locs.append((r, c))
 185:     random.shuffle(locs)
 186:     return locs
 187: 
 188: 
 189: def _draw_object(grid: np.ndarray, expected: np.ndarray, r: int, c: int, s: int, orient: str, body: int, marker: int) -> None:
 190:     h, w = _object_dims(s, orient)
 191:     grid[r : r + h, c : c + w] = body
 192:     bits = [0, 1] + [random.randrange(2) for _ in range(s - 2)]
 193:     random.shuffle(bits)
 194: 
 195:     if orient == WIDE:
 196:         rows = r + np.arange(s)
 197:         marker_cols = c + s - 1 + np.asarray(bits)
 198:         grid[rows, marker_cols] = marker
 199:         for row, marker_c in zip(rows, marker_cols):
 200:             expected[row, c - SHIFT_PADDING : marker_c - SHIFT_PADDING] = body
 201:             expected[row, marker_c + SHIFT_PADDING + 1 : c + w + SHIFT_PADDING] = body
 202:     else:
 203:         cols = c + np.arange(s)
 204:         marker_rows = r + s - 1 + np.asarray(bits)
 205:         grid[marker_rows, cols] = marker
 206:         for col, marker_r in zip(cols, marker_rows):
 207:             expected[r - SHIFT_PADDING : marker_r - SHIFT_PADDING, col] = body
 208:             expected[marker_r + SHIFT_PADDING + 1 : r + h + SHIFT_PADDING, col] = body
 209: 
 210: 
 211: def _size_order(count: int) -> list[int]:
 212:     sizes = list(SHORT_SIDE_SIZES)
 213:     random.shuffle(sizes)
 214:     if count >= DENSE_COUNT_THRESHOLD:
 215:         return sorted(sizes, key=lambda s: (s > DENSE_PREFERRED_MAX_SHORT_SIDE, random.random()))
 216:     if count >= PACKED_COUNT_THRESHOLD:
 217:         return sorted(sizes, key=lambda s: (s > PACKED_PREFERRED_MAX_SHORT_SIDE, random.random()))
 218:     return sizes
