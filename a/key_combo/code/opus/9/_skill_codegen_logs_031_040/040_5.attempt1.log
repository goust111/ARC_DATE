+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        built = _build_case()
+        if built is None:
+            continue
+        inp, expected = built
+        if _validate_case(inp, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid input after many attempts")

