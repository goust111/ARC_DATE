+        crack_r = next(iter(crack_rows))
+        for r, c in body:
+            rr = int(r)
+            cc = int(c)
+            shifted = (rr - 1 if rr < crack_r else rr + 1, cc)
+            if _in_bounds(out.shape, shifted[0], shifted[1]):
+                out[shifted] = medium
