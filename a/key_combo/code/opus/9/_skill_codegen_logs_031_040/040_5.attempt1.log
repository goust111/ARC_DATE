+def _components_by_color(grid: np.ndarray, colors: set[int], *, monochromatic: bool) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
