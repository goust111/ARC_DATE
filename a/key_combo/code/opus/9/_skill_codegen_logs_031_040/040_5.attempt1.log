  94: def _gen_spanning_mask(h: int, w: int, target_area: int) -> np.ndarray:
  95:     mask = np.zeros((h, w), dtype=bool)
  96:     bend_budget = max(0, target_area - (h + w - 1))
  97: 
  98:     if random.random() < VERTICAL_SPINE_PROB:
  99:         c = random.randrange(w)
 100:         mask[0, c] = True
 101:         bends_used = 0
 102:         for r in range(1, h):
 103:             prev_c = c
 104:             choices = [0]
 105:             if bends_used < bend_budget:
 106:                 if c > 0:
 107:                     choices.append(-1)
 108:                 if c + 1 < w:
 109:                     choices.append(1)
 110:             step = random.choice(choices)
 111:             c = prev_c + step
 112:             mask[r, prev_c] = True
 113:             mask[r, c] = True
 114:             bends_used += int(step != 0)
 115:         mask[random.randrange(INTERIOR_MARGIN, h - INTERIOR_MARGIN), :] = True
 116:     else:
 117:         r = random.randrange(INTERIOR_MARGIN, h - INTERIOR_MARGIN)
 118:         mask[r, 0] = True
 119:         bends_used = 0
 120:         for c in range(1, w):
 121:             prev_r = r
 122:             choices = [0]
 123:             if bends_used < bend_budget:
 124:                 if r > 1:
 125:                     choices.append(-1)
 126:                 if r + 2 < h:
 127:                     choices.append(1)
 128:             step = random.choice(choices)
 129:             r = prev_r + step
 130:             mask[prev_r, c] = True
 131:             mask[r, c] = True
 132:             bends_used += int(step != 0)
 133:         mask[:, random.randrange(INTERIOR_MARGIN, w - INTERIOR_MARGIN)] = True
 134: 
 135:     while int(mask.sum()) < target_area:
 136:         frontier = []
 137:         for r, c in np.argwhere(mask):
 138:             for dr, dc in NEIGHBOR_OFFSETS:
 139:                 nr, nc = int(r + dr), int(c + dc)
 140:                 if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
 141:                     frontier.append((nr, nc))
 142:         if not frontier:
 143:             break
 144:         r, c = random.choice(frontier)
 145:         mask[r, c] = True
