 293: def _interior_fill_order(inner_h: int, inner_w: int, head_side: int) -> list[tuple[int, int]]:
 294:     """Return interior cell coords (local to inner rect) in fill order from head-facing side inward.
 295:     Matches the solver's grey sort keys exactly."""
 296:     cells = [(r, c) for r in range(inner_h) for c in range(inner_w)]
 297:     if head_side == 3:    # right, direction (0,1): key (-col, row)
 298:         cells.sort(key=lambda p: (-p[1], p[0]))
 299:     elif head_side == 2:  # left, direction (0,-1): key (col, -row)
 300:         cells.sort(key=lambda p: (p[1], -p[0]))
 301:     elif head_side == 1:  # bottom, direction (1,0): key (-row, -col)
 302:         cells.sort(key=lambda p: (-p[0], -p[1]))
 303:     else:                 # top, direction (-1,0): key (row, col)
 304:         cells.sort(key=lambda p: (p[0], p[1]))
 305:     return cells
