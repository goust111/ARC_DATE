   6: def main(grid: np.ndarray) -> np.ndarray:
   7:     """
   8:     Expand the three-color corner-and-cross motif into a 10x10 ordered pattern table.
   9: 
  10:     Input structure:
  11:     - The input is a 5x5 grid with three colors.
  12:     - The rarest color occupies exactly the four corners.
  13:     - The middle-frequency color is the centered plus; the most common color is the background.
  14: 
  15:     Rule:
  16:     - Keep the input as the top-left 5x5 block.
  17:     - Form the role sequence [corner color, plus color, background color, corner color, plus color].
  18:     - Copy that sequence across every row of the top-right block and down every row of the bottom-left block.
  19:     - Fill the bottom-right block by taking the later row/column sequence entry off the diagonal, and the next color-role entry on the diagonal.
  20: 
  21:     Key insight:
  22:     - The output pattern is fixed once the three colors are renamed by their motif roles.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     assert g.shape == (5, 5), "expected a 5x5 motif"
  26: 
  27:     colors, counts = np.unique(g, return_counts=True)
  28:     assert colors.size == 3, "expected exactly three colors"
  29:     assert len(set(map(int, counts))) == 3, "color frequencies must identify roles"
  30:     by_frequency = np.argsort(counts)
  31:     corner, plus, bg = [int(colors[i]) for i in by_frequency]
  32: 
  33:     corner_mask = np.zeros((5, 5), dtype=bool)
  34:     corner_mask[0, 0] = True
  35:     corner_mask[0, 4] = True
  36:     corner_mask[4, 0] = True
  37:     corner_mask[4, 4] = True
  38: 
  39:     plus_mask = np.zeros((5, 5), dtype=bool)
  40:     plus_mask[1:4, 2] = True
  41:     plus_mask[2, 1:4] = True
  42: 
  43:     assert np.array_equal(g == corner, corner_mask), "rarest color must be only the four corners"
  44:     assert np.array_equal(g == plus, plus_mask), "middle-frequency color must be the centered plus"
  45:     assert np.array_equal(g == bg, ~(corner_mask | plus_mask)), "most common color must fill the remaining cells"
  46: 
  47:     role_seq = np.array([corner, plus, bg, corner, plus], dtype=int)
  48:     next_role = {corner: plus, plus: bg, bg: corner}
  49: 
  50:     out = np.empty((10, 10), dtype=int)
  51:     out[:5, :5] = g
  52:     out[:5, 5:] = role_seq
  53:     out[5:, :5] = role_seq[:, None]
  54: 
  55:     for r in range(5):
