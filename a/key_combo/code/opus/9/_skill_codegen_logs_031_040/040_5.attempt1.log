   9: def _role_colors(g: np.ndarray, bg: int) -> tuple[int, int]:
  10:     fg = colors_present(g, exclude={bg})
  11:     assert len(fg) == 2, "expected exactly two foreground colors"
  12: 
  13:     counts = {color: int(np.count_nonzero(g == color)) for color in fg}
  14:     marker_count = min(counts.values())
  15:     body_count = max(counts.values())
  16:     markers = [color for color, count in counts.items() if count == marker_count]
  17:     bodies = [color for color, count in counts.items() if count == body_count]
  18:     assert marker_count < body_count, "fracture marker color must be the minority foreground color"
  19:     assert len(markers) == 1 and len(bodies) == 1, "foreground roles must be unique"
  20:     return markers[0], bodies[0]
  21: 
  22: 
  23: def _set_body(out: np.ndarray, r: int, c: int, color: int) -> None:
  24:     assert in_bounds(out.shape, r, c), "shifted object pixel must stay in bounds"
  25:     assert int(out[r, c]) != int(color), "shifted object pixels must not collide"
  26:     out[r, c] = int(color)
  27: 
  28: 
  29: def main(grid: np.ndarray) -> np.ndarray:
  30:     """
  31:     Remove each fracture marker line and push the surrounding object pixels one cell away from it.
  32: 
  33:     Input structure
  34:     - A background grid with 8-connected foreground objects made from a body color and a rarer marker color.
  35:     - Each object has a non-square bbox; the marker pixels form one complete fracture line across the shorter bbox axis.
  36: 
  37:     Rule
  38:     - Erase all marker pixels.
  39:     - For a wide object, each row has one marker; body pixels left of it shift one cell left and body pixels right of it shift one cell right.
  40:     - For a tall object, each column has one marker; body pixels above it shift one cell up and body pixels below it shift one cell down.
  41: 
  42:     Key insight
  43:     - The marker line is a crack through the object, so the two sides separate by one pixel perpendicular to the crack.
  44:     """
  45:     g = np.asarray(grid, dtype=int)
  46:     assert g.ndim == 2, "expected a 2D grid"
  47: 
  48:     bg = get_bg(g)
  49:     marker, body = _role_colors(g, bg)
  50:     out = np.full_like(g, bg)
  51: 
  52:     objects = find_components(
  53:         g,
  54:         bg=bg,
  55:         connectivity=8,
  56:         monochromatic=False,
  57:         colors=[marker, body],
  58:     )
  59:     assert objects, "expected at least one fractured object"
  60: 
  61:     for obj in objects:
  62:         coords = obj["coords"]
  63:         r0, c0, r1, c1 = obj["bbox"]
  64:         height = int(r1 - r0 + 1)
  65:         width = int(c1 - c0 + 1)
  66:         assert height != width, "fractured object bbox must determine an orientation"
  67: 
  68:         vals = g[coords[:, 0], coords[:, 1]]
  69:         assert bool(np.any(vals == marker)), "each object must contain marker pixels"
  70:         assert bool(np.any(vals == body)), "each object must contain body pixels"
  71: 
  72:         marker_coords = coords[vals == marker]
  73:         if width > height:
  74:             marker_by_row: dict[int, list[int]] = {}
  75:             for r, c in marker_coords:
  76:                 marker_by_row.setdefault(int(r), []).append(int(c))
  77:             assert set(marker_by_row) == set(range(r0, r1 + 1)), "wide object needs one marker in each row"
  78:             assert all(len(cols) == 1 for cols in marker_by_row.values()), "wide object marker row must be unique"
  79: 
  80:             for r, c in coords[vals == body]:
  81:                 rr = int(r)
  82:                 cc = int(c)
  83:                 marker_c = marker_by_row[rr][0]
  84:                 assert cc != marker_c, "body pixel cannot occupy the marker column"
  85:                 shifted_c = cc - 1 if cc < marker_c else cc + 1
  86:                 _set_body(out, rr, shifted_c, body)
  87:         else:
  88:             marker_by_col: dict[int, list[int]] = {}
  89:             for r, c in marker_coords:
  90:                 marker_by_col.setdefault(int(c), []).append(int(r))
  91:             assert set(marker_by_col) == set(range(c0, c1 + 1)), "tall object needs one marker in each column"
  92:             assert all(len(rows) == 1 for rows in marker_by_col.values()), "tall object marker column must be unique"
  93: 
  94:             for r, c in coords[vals == body]:
  95:                 rr = int(r)
  96:                 cc = int(c)
  97:                 marker_r = marker_by_col[cc][0]
  98:                 assert rr != marker_r, "body pixel cannot occupy the marker row"
  99:                 shifted_r = rr - 1 if rr < marker_r else rr + 1
 100:                 _set_body(out, shifted_r, cc, body)
 101: 
 102:     return out
