 161: def _gen_colored_patch(mask: np.ndarray, colors: list[int]) -> np.ndarray:
 162:     coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
 163:     random.shuffle(coords)
 164:     values = []
 165:     for color, count in zip(colors, _gen_color_counts(len(coords))):
