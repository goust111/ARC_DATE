+
+def _choose_cf_specs(cm_total: int) -> list[dict] | None:
+    counts = [2, 3]
+    random.shuffle(counts)
+    for n_cf in counts:
+        tries = 80
+        while tries > 0:
+            tries -= 1
+            dims = [random.choice(CF_DIMS) for _ in range(n_cf)]
+            total = sum(h * w for h, w in dims)
+            if total < cm_total + 5:
