+            dims[random.randrange(n_cm)] = random.choice([d for d in CM_DIMS if d[1] > d[0]])
+        if not has_tall:
+            dims[random.randrange(n_cm)] = random.choice([d for d in CM_DIMS if d[0] > d[1]])
