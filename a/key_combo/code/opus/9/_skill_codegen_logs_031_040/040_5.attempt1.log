 150: def _gen_color_counts(total: int) -> list[int]:
 151:     counts = [MIN_PIXELS_PER_COLOR] * LEGEND_CELLS
 152:     remaining = total - sum(counts)
 153:     while remaining > 0:
 154:         choices = [i for i, count in enumerate(counts) if count < MAX_PIXELS_PER_COLOR]
 155:         idx = random.choice(choices)
 156:         counts[idx] += 1
 157:         remaining -= 1
 158:     return counts
