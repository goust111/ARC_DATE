+def _choose_cm_specs() -> list[dict]:
+    n_cm = random.randint(2, 3)
+    dims = [random.choice(CM_DIMS) for _ in range(n_cm)]
+    if n_cm == 2 and random.random() < 0.7:
+        has_wide = any(w > h for h, w in dims)
+        has_tall = any(h > w for h, w in dims)
