+def _pad_bbox(bbox: tuple[int, int, int, int], pad: int, h: int, w: int) -> tuple[int, int, int, int] | None:
+    return _clip_bbox((bbox[0] - pad, bbox[1] - pad, bbox[2] + pad, bbox[3] + pad), h, w)
