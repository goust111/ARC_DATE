+        parity = (rr + cc + random.randint(0, 1)) % 2
+        border = (rr == 0) | (rr == height - 1) | (cc == 0) | (cc == width - 1)
+        weights = 0.8 + parity.astype(float) * 1.4 + border.astype(float) * 0.8
+    weights += np.random.random((height, width)) * 0.05
