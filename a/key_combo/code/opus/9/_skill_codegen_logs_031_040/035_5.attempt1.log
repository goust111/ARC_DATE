+    intervals: list[tuple[int, int]] = []
+    cursor = 0
+    for start, end in runs:
+        if start > cursor:
+            intervals.append((cursor, start))
+        cursor = end + 1
+    if cursor < size:
+        intervals.append((cursor, size))
+    return intervals
+
