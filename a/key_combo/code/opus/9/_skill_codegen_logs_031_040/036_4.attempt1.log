GEN_NOTCH_CAPACITY_WIDTH_OFFSET, GEN_NOTCH_CAPACITY_STRIDE = 3, 4
GEN_NOTCH_INTERVAL_RULES = {
    "top": {"start_min": 2, "start_stop_margin": 4, "end_stop_margin": 3},
    "bottom": {"start_min": 3, "start_stop_margin": 3, "end_stop_margin": 2},
}

