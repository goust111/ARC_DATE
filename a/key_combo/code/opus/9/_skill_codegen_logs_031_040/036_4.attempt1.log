    ]
    patch = _gen_patch(cells)
    combo_colors = {_GEN_ANCHOR_COLOR, _GEN_SKELETON_COLOR}
    return len({_gen_colored_key(v, combo_colors) for v in _gen_dihedral_variants(patch)})


