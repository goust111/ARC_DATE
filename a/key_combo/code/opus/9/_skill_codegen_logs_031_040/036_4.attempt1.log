        path = _trace_cycle(coords)
        turn_signs: dict[tuple[int, int], int] = {}
        counts: Counter[int] = Counter()
        n = len(path)
        for i, (r, c) in enumerate(path):
            pr, pc = path[i - 1]
            nr, nc = path[(i + 1) % n]
            incoming = (r - pr, c - pc)
            outgoing = (nr - r, nc - c)
            cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
