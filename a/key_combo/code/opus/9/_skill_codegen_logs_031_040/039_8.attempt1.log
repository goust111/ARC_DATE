+    mr0, mc0, mr1, mc1 = mask_box
+    if int(grey.sum()) == (mr1 - mr0 + 1) * (mc1 - mc0 + 1):
+        return False
+    if _min_manhattan(blue_coords, grey_coords) < 2:
+        return False
+    if rect_top_left[0] + h > H // 2:
+        return False
+    if grey_coords[:, 0].mean() < H * 0.48:
