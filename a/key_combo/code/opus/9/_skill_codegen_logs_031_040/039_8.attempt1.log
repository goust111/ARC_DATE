+def _stamp_positions(
+    shape: tuple[int, int], rect_top_left: tuple[int, int], rect_hw: tuple[int, int]
+) -> list[tuple[int, int]]:
+    H, W = shape
+    r0, c0 = rect_top_left
+    h, w = rect_hw
+    seen = {(int(r0), int(c0))}
+    for sr in (-1, 1):
+        for sc in (-1, 1):
+            k = 1
+            while True:
