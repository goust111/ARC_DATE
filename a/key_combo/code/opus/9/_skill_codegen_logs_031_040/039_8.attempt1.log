+    branch = random.choice(["left", "right"])
+    clipped = random.random() < 0.35
+
+    max_r0 = min(H // 2 - h, H - 5 * h)
+    if max_r0 < 0:
+        return None
+    r_candidates = list(range(max_r0 + 1))
+    if not r_candidates:
+        return None
+
+    if branch == "left":
+        if clipped:
+            c_min = 3 * w
+            c_max = min(4 * w - 1, W - w)
+        else:
+            c_min = 4 * w
+            c_max = W - w
+    else:
+        if clipped:
+            c_min = max(0, W - 5 * w + 1)
+            c_max = min(W - 4 * w, W - w)
+        else:
+            c_min = 0
+            c_max = W - 5 * w
+    if c_min > c_max:
+        return None
+
+    r0 = random.choice(r_candidates)
+    c0 = random.randint(c_min, c_max)
+
+    if branch == "left":
+        starts = [(r0 + 2 * h, c0 - 2 * w), (r0 + 3 * h, c0 - 3 * w), (r0 + 4 * h, c0 - 4 * w)]
+    else:
+        starts = [(r0 + 2 * h, c0 + 2 * w), (r0 + 3 * h, c0 + 3 * w), (r0 + 4 * h, c0 + 4 * w)]
+
+    grey_mask = _build_chain_mask(
+        (H, W),
+        starts,
+        branch,
+        (h, w),
+        clipped=clipped,
+        variant=random.randint(0, 1),
+        add_tail=random.random() < 0.5,
+    )
+    if grey_mask is None:
+        return None
+
+    grid = np.zeros((H, W), dtype=int)
+    grid[r0 : r0 + h, c0 : c0 + w] = BLUE
+    grid[grey_mask] = GREY
+
+    if not _validate_semantics(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 8")

