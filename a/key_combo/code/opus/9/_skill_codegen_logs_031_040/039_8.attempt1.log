+            [(0, j) for j in range(w)] + [(i, 0) for i in range(1, h)]
+            if variant == 0
+            else [(i, w - 1) for i in range(h)] + [(h - 1, j) for j in range(w - 1)]
+        )
+        last = [(0, w - 1), (1, w - 1)] if clipped or variant == 0 else [(0, w - 1), (0, w - 2)]
