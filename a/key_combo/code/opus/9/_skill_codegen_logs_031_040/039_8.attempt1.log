+    if not add_global(starts[0], first):
+        return None
+    if not add_global(starts[1], middle):
+        return None
+    if not add_global(starts[2], last):
+        return None
+    for rr, cc in bridges:
+        if not (0 <= rr < H and 0 <= cc < W):
