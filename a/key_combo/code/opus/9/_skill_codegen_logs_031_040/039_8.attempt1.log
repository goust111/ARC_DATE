+    if grey_coords.shape[0] < 8 or grey_coords.shape[0] > 15:
+        return False
+    if out_coords.shape[0] < 5 or out_coords.shape[0] > 10:
+        return False
+    if np.any((out != BLACK) & (out != RED)):
