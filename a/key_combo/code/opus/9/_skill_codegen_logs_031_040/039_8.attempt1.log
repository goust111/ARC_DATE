+    h, w = rect_hw
+    mask = np.zeros((H, W), dtype=bool)
+    for rr, cc in _stamp_positions(shape, rect_top_left, rect_hw):
+        rs = max(0, rr)
+        re = min(H, rr + h)
+        cs = max(0, cc)
+        ce = min(W, cc + w)
+        if rs < re and cs < ce:
