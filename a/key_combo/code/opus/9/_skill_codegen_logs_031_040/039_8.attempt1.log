+    off_stamp = grey & ~stamped
+    if int(off_stamp.sum()) < 2:
+        return False
+
+    contrib = _contributing_stamps(grid.shape, rect_top_left, rect_hw, grey)
+    if len(contrib) < 3:
+        return False
+    if not any(0 < count < h * w for count in contrib.values()):
+        return False
+
+    full_red_rects = 0
+    for rr, cc in contrib:
+        rs = max(0, rr)
+        re = min(H, rr + h)
+        cs = max(0, cc)
+        ce = min(W, cc + w)
+        if rs >= re or cs >= ce:
