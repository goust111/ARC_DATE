+            (starts[0][0] + h, starts[0][1]),
+            (starts[1][0] + h, starts[1][1]),
+        ]
+        tail = (bridges[0][0], bridges[0][1] + 1) if variant == 0 else (bridges[1][0], bridges[1][1] + 1)
