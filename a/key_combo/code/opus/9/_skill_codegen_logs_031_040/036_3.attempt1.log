1203: class MirrorSymmetry(Symmetry):
1204:     """Mirror symmetry across horizontal and/or vertical axis (in pixel coordinates)."""
1205: 
1206:     def __init__(self, mirror_r: float | None, mirror_c: float | None, **kwargs):
1207:         # Legacy keyword aliases (deprecated): mirror_x->mirror_r, mirror_y->mirror_c
1208:         mx, used_mx = _consume_alias(kwargs, "mirror_r", ["mirror_x"])
1209:         my, used_my = _consume_alias(kwargs, "mirror_c", ["mirror_y"])
1210:         if mirror_r is None and mx is not None:
1211:             if used_mx == "mirror_x":
1212:                 warnings.warn("MirrorSymmetry: 'mirror_x' is deprecated; use 'mirror_r'", DeprecationWarning, stacklevel=2)
1213:             mirror_r = mx
1214:         if mirror_c is None and my is not None:
1215:             if used_my == "mirror_y":
1216:                 warnings.warn("MirrorSymmetry: 'mirror_y' is deprecated; use 'mirror_c'", DeprecationWarning, stacklevel=2)
1217:             mirror_c = my
1218:         if kwargs:
1219:             raise TypeError(f"MirrorSymmetry: unexpected keyword arguments: {sorted(kwargs.keys())}")
1220:         self.mirror_r, self.mirror_c = mirror_r, mirror_c
1221: 
1222:     def apply(self, r, c, iters: int = 1):
1223:         if int(iters) % 2 == 0:
1224:             return r, c
1225:         if self.mirror_r is not None:
1226:             r = 2 * self.mirror_r - r
1227:         if self.mirror_c is not None:
1228:             c = 2 * self.mirror_c - c
1229:         if isinstance(r, np.ndarray):
1230:             r = r.astype(int)
1231:         if isinstance(c, np.ndarray):
1232:             c = c.astype(int)
1233:         if isinstance(r, float):
1234:             r = int(round(r))
1235:         if isinstance(c, float):
1236:             c = int(round(c))
1237:         return r, c
1238: 
1239:     def __repr__(self):
1240:         return f"MirrorSymmetry(mirror_r={self.mirror_r}, mirror_c={self.mirror_c})"
1241: 
1242:     def __str__(self):
1243:         return self.__repr__()
1244: 
1245:     def _iter_range(self, grid_shape: tuple[int, int]):
1246:         return (0, 2)
1247: 
1248: 
1249: def detect_mirror_symmetry(
1250:     grid: np.ndarray,
1251:     ignore_colors: list[int] | None = None,
1252:     background: int | None = None,
1253: ) -> list[Symmetry]:
1254:     """Detect mirror symmetries. Returns a list (possibly empty)."""
1255:     if ignore_colors is None:
1256:         ignore_colors = [Color.BLACK]
1257:     ignore_colors = [int(c) for c in ignore_colors]
1258: 
1259:     n, m = grid.shape
1260:     rc_poss = [MirrorSymmetry(mirror_r=rc + z, mirror_c=cc + z) for rc in range(n) for cc in range(m) for z in (0, 0.5)]
1261:     r_poss = [MirrorSymmetry(mirror_r=rc + z, mirror_c=None) for rc in range(n) for z in (0, 0.5)]
1262:     c_poss = [MirrorSymmetry(mirror_r=None, mirror_c=cc + z) for cc in range(m) for z in (0, 0.5)]
1263: 
1264:     best, best_score = [], 0.0
1265:     for sym in r_poss + c_poss + rc_poss:
1266:         perfectly_preserved, outside_canvas, conflict = _score_symmetry(grid, sym, ignore_colors, background=background)
1267:         score = perfectly_preserved - 0.01 * outside_canvas - 10000 * conflict
1268:         if conflict > 0 or perfectly_preserved == 0:
1269:             continue
1270:         if score > best_score:
1271:             best = [sym]
1272:             best_score = score
1273:         elif score == best_score:
1274:             best.append(sym)
1275:     return best
1276: 
