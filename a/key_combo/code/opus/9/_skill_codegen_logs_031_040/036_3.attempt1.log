0102: def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
0103:     """Return True iff (r,c) is within a grid of shape (H,W)."""
0104:     H, W = map(int, shape)
0105:     return 0 <= int(r) < H and 0 <= int(c) < W
