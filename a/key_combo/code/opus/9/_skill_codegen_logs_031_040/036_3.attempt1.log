0050: def main(grid: np.ndarray) -> np.ndarray:
0051:     """
0052:     Complete each marked object by mirroring its trusted side across the yellow axis.
0053: 
0054:     Input structure:
0055:     - The background is black.
0056:     - Each transformed object has one non-yellow foreground color plus yellow
0057:       pixels.
0058:     - Its yellow pixels contain one contiguous horizontal or vertical mirror
0059:       axis and at least one off-axis yellow control pixel.
0060: 
0061:     Rule:
0062:     - For every object with a yellow axis, use the side containing the off-axis
0063:       yellow control pixel as the source side.
0064:     - Reflect the whole rectangular source half of the object's bounding box
0065:       across the axis, copying both foreground and background pixels onto the
0066:       opposite side.
0067:     - Leave the source side, the axis, and unrelated pixels unchanged unless
0068:       they fall inside a reflected target half.
0069: 
0070:     Key insight:
0071:     - The extra yellow pixel is not another object detail; it marks which half
0072:       of the pattern is correct and should overwrite the other half by symmetry.
0073:     """
0074:     g = np.asarray(grid, dtype=int)
0075:     assert g.ndim == 2, "expected a 2D grid"
0076:     bg = get_bg(g)
0077:     assert bg == Color.BLACK, "expected black background"
0078: 
0079:     out = g.copy()
0080:     processed = 0
0081:     for coords in components_mask(g != bg, connectivity=4):
0082:         if not np.any(g[coords[:, 0], coords[:, 1]] == Color.YELLOW):
0083:             continue
0084: 
0085:         colors = set(map(int, g[coords[:, 0], coords[:, 1]]))
0086:         object_colors = colors - {int(Color.YELLOW)}
0087:         assert len(object_colors) == 1, "each marked object must have one non-yellow color"
0088: 
0089:         orient, axis, yellow = _mirror_axis(g, coords)
0090:         r0, c0, r1, c1 = bbox_coords(coords)
