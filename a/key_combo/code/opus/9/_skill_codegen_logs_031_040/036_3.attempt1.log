0053:             tile = g[r0:r1, c0:c1]
0054:             assert set(map(int, tile.ravel())) <= {Color.BLUE, Color.RED}
0055:             blue_count = int(np.count_nonzero(tile == Color.BLUE))
0056:             tiles.append((blue_count, tile.copy()))
