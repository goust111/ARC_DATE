0092: 
0093:         if orient == "h":
0094:             source_side = _single_side({-1 if r < axis else 1 for r, _ in yellow if r != axis})
0095:             rows = range(r0, axis) if source_side < 0 else range(axis + 1, r1 + 1)
0096:             for src_r in rows:
0097:                 dst_r = 2 * axis - src_r
0098:                 assert 0 <= dst_r < g.shape[0], "reflected row must stay in bounds"
0099:                 out[dst_r, c0 : c1 + 1] = g[src_r, c0 : c1 + 1]
0100:         else:
0101:             source_side = _single_side({-1 if c < axis else 1 for _, c in yellow if c != axis})
0102:             cols = range(c0, axis) if source_side < 0 else range(axis + 1, c1 + 1)
0103:             for src_c in cols:
0104:                 dst_c = 2 * axis - src_c
0105:                 assert 0 <= dst_c < g.shape[1], "reflected column must stay in bounds"
0106:                 out[r0 : r1 + 1, dst_c] = g[r0 : r1 + 1, src_c]
