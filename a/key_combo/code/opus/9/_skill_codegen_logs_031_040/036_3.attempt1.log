{
  "type": "symmetry/pattern",
  "src": "each foreground object containing a contiguous yellow horizontal or vertical axis and an off-axis yellow control pixel",
  "dst": "opposite half of the same object region across the yellow axis",
  "transform": "use the side containing the off-axis yellow control pixel as the source; reflect that rectangular half across the axis, copying background too so conflicting pixels on the other side are erased"
}
</annotation>
