   1: def main(grid: np.ndarray) -> np.ndarray:
   2:     """
   3:     Rotate each 2x2 block's four diagonal corner colors clockwise, then extend the rotated colors outward as diagonal rays.
   4: 
   5:     Input structure
   6:     - The background is the dominant color.
   7:     - One foreground color forms one or more solid 2x2 blocks.
   8:     - Each block has four non-background, non-block corner pixels diagonally adjacent to it.
   9: 
  10:     Rule
  11:     - Around every block, move the NW corner color to NE, NE to SE, SE to SW, and SW to NW.
  12:     - From each rotated corner, paint along the outward diagonal until the grid edge or another 2x2 block is reached.
  13:     - If a ray reaches a same-colored outgoing corner of another block that has its own visible continuation, stop the incoming ray at that junction.
  14: 
  15:     Key insight
  16:     - The 2x2 blocks are color rotators and ray blockers; the corner pixels are not independent dots but the four ports of each block.
  17:     """
  18:     g = np.asarray(grid, dtype=int)
  19:     assert g.ndim == 2
  20:     bg = int(get_bg(g))
  21:     block_color = _block_color(g, bg)
  22: 
  23:     rays: list[Ray] = []
  24:     h, w = g.shape
  25:     for r0, c0 in _blocks(g, block_color, bg):
  26:         corner_colors: dict[str, int] = {}
  27:         for corner, (dr, dc) in CORNER_OFFSETS.items():
  28:             r = r0 + dr
  29:             c = c0 + dc
  30:             assert 0 <= r < h and 0 <= c < w, "expected all four block corners in bounds"
  31:             color = int(g[r, c])
  32:             assert color != bg and color != block_color, "expected colored corner ports around each block"
  33:             corner_colors[corner] = color
  34: 
  35:         for corner, offset in CORNER_OFFSETS.items():
  36:             start = (r0 + offset[0], c0 + offset[1])
  37:             color = corner_colors[ROTATED_SOURCE[corner]]
  38:             path = _ray_path(g, start, DIAGONAL_DIRS[corner], block_color)
  39:             rays.append((start, color, path))
  40: 
  41:     starts_by_color: dict[int, set[tuple[int, int]]] = {}
  42:     path_len: dict[tuple[int, tuple[int, int]], int] = {}
  43:     for start, color, path in rays:
  44:         starts_by_color.setdefault(color, set()).add(start)
  45:         path_len[(color, start)] = len(path)
  46: 
  47:     planned: dict[tuple[int, int], int] = {}
  48:     for start, color, path in rays:
  49:         keep = len(path)
  50:         other_starts = starts_by_color[color] - {start}
  51:         for i, cell in enumerate(path):
