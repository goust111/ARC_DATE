   1: def main(grid: np.ndarray) -> np.ndarray:
   2:     """
   3:     Fill the frame interior with two marker colors arranged in matching 2x2 diagonal quadrants.
   4: 
   5:     Input structure:
   6:     - The dominant background contains one solid one-pixel-thick rectangular frame.
   7:     - The frame has an even-height and even-width empty interior.
   8:     - Exactly two one-pixel markers of different colors sit outside the frame.
   9: 
  10:     Rule:
  11:     - A marker in the northwest or southeast side of the frame center supplies the
  12:       main diagonal quadrants of the interior.
  13:     - A marker in the northeast or southwest side supplies the other two quadrants.
  14:     - Split the frame interior into row and column halves and fill each cell by
  15:       the diagonal class of its half-position.
  16: 
  17:     Key insight:
  18:     - The marker colors are not copied from their exact rows or columns; their
  19:       coarse position relative to the frame center selects one of the two diagonal
  20:       quadrant masks.
  21:     """
  22:     g = np.asarray(grid, dtype=int)
  23:     assert g.ndim == 2, "expected a 2D grid"
  24: 
  25:     bg = get_bg(g)
  26:     counts = Counter(map(int, g.flat))
  27:     foreground_colors = [color for color in counts if color != bg]
  28:     frame_colors = [color for color in foreground_colors if counts[color] > 1]
  29:     assert len(frame_colors) == 1, "expected one non-background frame color"
  30:     frame_color = int(frame_colors[0])
  31: 
  32:     frame_bbox = bbox(g == frame_color)
  33:     assert frame_bbox is not None, "expected a frame"
  34:     r0, c0, r1, c1 = frame_bbox
  35:     assert r1 - r0 >= 2 and c1 - c0 >= 2, "frame must enclose an interior"
  36:     expected_frame = _rectangular_border_mask(g.shape, frame_bbox)
  37:     assert np.array_equal(g == frame_color, expected_frame), "frame must be a rectangular border"
  38: 
  39:     marker_coords = np.argwhere((g != bg) & (g != frame_color))
  40:     assert marker_coords.shape == (2, 2), "expected exactly two marker pixels"
  41:     marker_colors = [int(g[r, c]) for r, c in marker_coords]
  42:     assert len(set(marker_colors)) == 2, "marker colors must be distinct"
  43: 
  44:     center_r2 = r0 + r1
  45:     center_c2 = c0 + c1
  46:     diagonal_color: dict[str, int] = {}
  47:     for r, c in marker_coords:
  48:         assert not (r0 <= r <= r1 and c0 <= c <= c1), "markers must be outside the frame"
  49:         assert 2 * int(r) != center_r2 and 2 * int(c) != center_c2, (
