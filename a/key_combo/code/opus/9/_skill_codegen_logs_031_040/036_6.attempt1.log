+                    out.append((r, c))
+            except ValueError:
+                pass
+    return out
+
+
+def _dilated(coords: Iterable[tuple[int, int]], n: int) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in coords:
+        out.add((r, c))
+        out.update(_neighbors8(r, c, n))
+    return out
+
+
