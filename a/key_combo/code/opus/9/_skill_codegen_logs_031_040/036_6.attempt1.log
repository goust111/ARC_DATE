--- main ---
   1: def main(grid: np.ndarray) -> np.ndarray:
   2:     """
   3:     Clean each color layer by enforcing vertical mirror symmetry.
   4: 
   5:     Input structure:
   6:     - bg = background. Several non-bg colors, each forming a nearly-symmetric pattern about some vertical axis.
   7:     - Some pixels in each color are "noise" that breaks the symmetry.
   8: 
   9:     Rule:
  10:     - For each non-bg color, find the vertical axis that best explains its pixel layout.
  11:     - Remove any pixel that lacks a same-color mirror counterpart across that axis.
  12: 
  13:     Key insight: Each color has its own independent symmetry axis; the task is per-color denoising, not whole-grid symmetry.
  14:     """
  15:     g = np.array(grid, dtype=int)
  16:     bg = int(get_bg(g))
  17:     H, W = g.shape
  18: 
  19:     out = g.copy()
  20:     colors = colors_present(g, exclude={bg})
  21:     assert colors, "grid must contain at least one non-background color"
  22: 
  23:     # Search all possible vertical axes: k in [0, 2*(W-1)] corresponds to axis at c = k/2.
  24:     for col in colors:
  25:         pts = np.argwhere(g == int(col))
  26:         if pts.size == 0:
  27:             continue
  28: 
  29:         best_score = -1
  30:         best_k = 0
  31:         for k in range(0, 2 * (W - 1) + 1):
  32:             score = 0
  33:             for r, c in pts:
  34:                 cc = int(k) - int(c)
  35:                 if 0 <= cc < W and int(g[int(r), cc]) == int(col):
  36:                     score += 1
  37:             if score > best_score:
  38:                 best_score = int(score)
  39:                 best_k = int(k)
  40: 
  41:         # Delete unpaired pixels under the chosen vertical axis.
  42:         k = int(best_k)
  43:         for r, c in pts:
  44:             rr = int(r)
  45:             cc = int(k) - int(c)
  46:             if not (0 <= cc < W and int(g[rr, cc]) == int(col)):
  47:                 out[rr, int(c)] = int(bg)
  48: 
  49:     return out
