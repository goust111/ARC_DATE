+    if np.array_equal(inp, expected_out):
+        return False
+
+    colors = [int(v) for v in np.unique(expected_out) if int(v) not in (BACKGROUND, MARKER)]
+    if len(colors) < 2:
+        return False
+    return True
+
+
+def _gen_attempt(case_name: str) -> np.ndarray | None:
