+    mr, mc = map(int, marker_coords[0])
+    case_name = _case_from_marker(mr, mc, n)
+    return _solve_with_case(g, case_name)
+
+
+def _sector_cells(n: int, sector: str) -> list[tuple[int, int]]:
+    out = []
+    for r in range(n):
+        for c in range(n):
+            try:
