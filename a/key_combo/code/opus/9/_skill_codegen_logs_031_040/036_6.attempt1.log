   1: def main(grid: np.ndarray) -> np.ndarray:
   2:     """
   3:     Decode a block-grid image by swapping each sprite-coded cell with a solid cell and each blank cell with the sprite.
   4: 
   5:     Input structure
   6:     The grid is partitioned by black separator rows and columns into equal-size
   7:     square blocks. Each block is either a copy of one two-color sprite or a
   8:     uniform blank block of the sprite's minority color; grey pixels are erased
   9:     cells that act as wildcards.
  10: 
  11:     Rule
  12:     Infer the repeated sprite from fully visible mixed-color blocks. Replace a
  13:     block matching that sprite, ignoring grey erasures, with a solid block of
  14:     the sprite's majority color. Replace a uniform blank block with the sprite.
  15:     Separator rows and columns, including grey erasures on them, become black.
  16: 
  17:     Key insight
  18:     The small sprite is a block-level code for one macro-cell state, and the
  19:     uniform minority-color block is the other state; the output renders the
  20:     opposite code in each macro-cell while cleaning erased pixels.
  21:     """
  22:     g = np.asarray(grid, dtype=int)
  23:     H, W = g.shape
  24: 
  25:     row_separators = [r for r in range(H) if _is_separator_line(g[r, :])]
  26:     col_separators = [c for c in range(W) if _is_separator_line(g[:, c])]
  27:     row_intervals = _regular_intervals(row_separators, H)
  28:     col_intervals = _regular_intervals(col_separators, W)
  29:     block_heights = {r1 - r0 for r0, r1 in row_intervals}
  30:     block_widths = {c1 - c0 for c0, c1 in col_intervals}
  31:     assert block_heights == block_widths, "encoded blocks must be square"
  32: 
  33:     payload_colors = colors_present(g, exclude={SEPARATOR, ERASED})
  34:     assert len(payload_colors) == 2, "expected exactly two non-separator payload colors"
  35:     sprite = _find_sprite(g, row_intervals, col_intervals, payload_colors)
  36:     foreground, blank = _foreground_and_blank(sprite, payload_colors)
  37: 
  38:     out = np.zeros_like(g)
  39:     for r0, r1 in row_intervals:
  40:         for c0, c1 in col_intervals:
  41:             block = g[r0:r1, c0:c1]
  42:             known = block != ERASED
  43:             assert known.any(), "each block must expose at least one non-grey cell"
  44:             matches_sprite = bool(np.all(block[known] == sprite[known]))
  45:             matches_blank = bool(np.all(block[known] == blank))
  46:             assert matches_sprite != matches_blank, "each block must unambiguously match the sprite or blank state"
  47:             out[r0:r1, c0:c1] = foreground if matches_sprite else sprite
  48: 
  49:     return out
