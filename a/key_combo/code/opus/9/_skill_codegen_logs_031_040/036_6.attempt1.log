   1: def main(input_grid):
   2:     """
   3:     Grow each green rectangle outward from its red border indicator to the canvas edge.
   4: 
   5:     Input structure:
   6:     - Each foreground object is a green rectangle with one red pixel on its border.
   7:     - Objects sit on a black background.
   8:     - The red pixel indicates the side from which growth should extend.
   9: 
  10:     Rule:
  11:     - Find each rectangle-and-indicator component.
  12:     - Extend a green band from the rectangle toward the canvas edge on the indicator side.
  13:     - Draw a red line from the indicator pixel to that same edge.
  14: 
  15:     Key insight:
  16:     - The indicator side controls direction, while the rectangle thickness controls the grown band.
  17:     """
  18:     # Initialize the output grid
  19:     output_grid = np.copy(input_grid)
  20:     
  21:     rectangle_color = Color.GREEN
  22:     indicator_color = Color.RED
  23:     background = Color.BLACK
  24: 
  25:     # get all the green rectangles on the grid. because of the red pixel on the border of the rectangle, they are not monochromatic.
  26:     objects = find_components(input_grid, bg=background, connectivity=4, monochromatic=False, return_format="objects")
  27:     for obj in objects:
  28:         # find the red indicator
  29:         for red_r, red_c in np.argwhere(obj == indicator_color):
  30:             break
  31: 
  32:         # Get the dimensions of the object, and its position
  33:         _b = bbox(obj != background)
  34:         assert _b is not None
  35:         r, c, _r1, _c1 = _b
  36:         width = _r1 - r + 1
  37:         height = _c1 - c + 1
  38: 
  39:         # depending on which side of the rectangle that the indicator is on, we draw in different directions
  40:         # left edge: draw to the left
  41:         if red_r == r:
  42:             # Extend the green rectangle to the left until it reaches the border
  43:             output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
  44:             # Draw the red line from the red pixel to the border
  45:             draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
  46:         elif red_r == r + width - 1:
  47:             # Extend the green rectangle to the right until it reaches the border
  48:             output_grid[red_r:, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
  49:             # Draw the red line from the red pixel to the border
  50:             draw_line(output_grid, r=red_r, c=red_c, direction=(1, 0), color=indicator_color)
  51:         elif red_c == c:
  52:             # Extend the green rectangle to the top until it reaches the border
  53:             output_grid[red_r-(height-1) : red_r+(height-1)+1, 0:red_c] = rectangle_color
  54:             # Draw the red line from the red pixel to the border
  55:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, -1), color=indicator_color)
  56:         elif red_c == c + height - 1:
  57:             # Extend the green rectangle to the bottom until it reaches the border
  58:             output_grid[red_r-(height-1) : red_r+(height-1)+1, red_c:] = rectangle_color
  59:             # Draw the red line from the red pixel to the border
  60:             draw_line(output_grid, r=red_r, c=red_c, direction=(0, 1), color=indicator_color)
  61:         else:
  62:             assert False, "The red pixel is not on the border of the rectangle"
  63: 
  64:     return output_grid
