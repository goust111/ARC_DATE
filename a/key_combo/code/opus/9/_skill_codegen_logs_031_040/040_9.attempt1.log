+    center_color: int,
+    obj: dict,
+) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    top_pad, bottom_pad = random.choice(PADDING_CHOICES)
+    left_pad, right_pad = random.choice(PADDING_CHOICES)
+    patch = np.zeros(
