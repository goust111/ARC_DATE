+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start_r, start_c = map(int, coords[0])
+    seen = {(start_r, start_c)}
+    stack = [(start_r, start_c)]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
