+def _tile_fill(shape: tuple[int, int], tile: np.ndarray) -> np.ndarray:
+    h, w = tile.shape
+    row_idx = np.arange(shape[0]) % h
+    col_idx = np.arange(shape[1]) % w
+    return tile[row_idx[:, None], col_idx[None, :]]
