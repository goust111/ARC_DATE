GEN_WIDTH_BOUNDS = (6, 10)
GEN_HEIGHT_BOUNDS = (3, 8)
GEN_MIN_FULL_REPEATS = 2
# Active-row and color constraints.
GEN_ROW_COUNT_BOUNDS = (1, 3)
GEN_COLOR_VALUES = np.arange(1, 10)
GEN_COLOR_COUNT = 2
# Rejection sampling budget.
