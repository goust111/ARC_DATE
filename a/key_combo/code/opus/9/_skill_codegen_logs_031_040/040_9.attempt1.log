+    random.shuffle(other_colors)
+    center_colors: list[int] = [0] * n_clusters
+    for idx in range(n_clusters):
+        if idx == target_idx:
+            center_colors[idx] = marker_colors[idx]
+        else:
+            center_colors[idx] = other_colors.pop()
