+    if coords.size == 0:
+        return False
+    start_r, start_c = map(int, coords[0])
+    seen = {(start_r, start_c)}
+    stack = [(start_r, start_c)]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
