+        height = random.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])
+        width = random.randint(GRID_SIZE_RANGE[0], GRID_SIZE_RANGE[1])
+        clipped = (height % tile_h != 0) or (width % tile_w != 0)
+        if require_clip and not clipped:
