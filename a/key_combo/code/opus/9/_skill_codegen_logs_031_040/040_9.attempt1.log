+    if target_tile.shape[0] not in range(2, 5) or target_tile.shape[1] not in range(2, 5):
+        return False
+    if not (target_tile == BG).any():
+        return False
+    if require_clip and grid.shape[0] % target_tile.shape[0] == 0 and grid.shape[1] % target_tile.shape[1] == 0:
+        return False
