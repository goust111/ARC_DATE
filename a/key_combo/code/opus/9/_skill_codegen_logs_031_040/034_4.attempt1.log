+    if np.array_equal(grid, out):
+        raise AssertionError("input and output must differ")
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        h = int(rng.integers(14, 19))
+        w = int(rng.integers(14, 19))
