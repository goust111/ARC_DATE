+        mirror_region = out[mr0 : mr0 + mh, mc0 : mc0 + mw]
+        expected_mirror = np.full((mh, mw), int(entity["indicator_color"]), dtype=int)
+        if not np.array_equal(mirror_region, expected_mirror):
