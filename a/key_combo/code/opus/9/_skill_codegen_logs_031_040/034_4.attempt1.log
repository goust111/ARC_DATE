+        overlap = seen_mirror[mr0 : mr0 + mh, mc0 : mc0 + mw]
+        if overlap.any():
+            raise AssertionError("generator should keep mirrored zones separated for clarity")
+        seen_mirror[mr0 : mr0 + mh, mc0 : mc0 + mw] = True
