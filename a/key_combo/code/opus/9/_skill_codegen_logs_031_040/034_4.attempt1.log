+        if spec["side"] == "top":
+            indicator = (r0 - 1, c0 + ac)
+        elif spec["side"] == "bottom":
+            indicator = (r0 + ar + 1, c0 + ac)
+        elif spec["side"] == "left":
+            indicator = (r0 + ar, c0 - 1)
+        else:
+            indicator = (r0 + ar, c0 + ac + 1)
+        grid[indicator] = int(spec["indicator_color"])
