def _is_corner_bracket(component: dict) -> bool:
    coords = {tuple(map(int, p)) for p in component["coords"]}
    r0, c0, r1, c1 = component["bbox"]
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    if h < 2 or w < 2 or component["area"] != h + w - 1:
