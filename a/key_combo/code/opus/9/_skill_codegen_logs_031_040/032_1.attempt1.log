+    normal_hits = 0
+    overlaps = 0
+    shared_orange = 0
+    seen_orange_hits: set[tuple[int, int]] = set()
+    for r0, c0, color, step in markers:
+        r = r0 + step[0]
+        c = c0 + step[1]
+        traversed: list[tuple[int, int]] = []
+        hit = None
+        while _in_bounds(current.shape, r, c):
