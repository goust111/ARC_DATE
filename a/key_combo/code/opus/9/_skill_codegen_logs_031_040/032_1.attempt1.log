+
+def _simulate_candidate(
+    base_grid: np.ndarray,
+    frames: list[dict],
+    start: tuple[int, int],
+    step: tuple[int, int],
+) -> dict | None:
+    h, w = base_grid.shape
+    r = start[0] + step[0]
+    c = start[1] + step[1]
