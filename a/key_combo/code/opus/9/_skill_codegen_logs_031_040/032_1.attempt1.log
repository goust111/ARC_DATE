+        info["original_red"] = set(motif)
+        mirrored: set[tuple[int, int]] = set()
+        for r, c in motif:
+            rr = r
+            cc = ic0 + ic1 - c if vertical else c
+            if not vertical:
+                rr = ir0 + ir1 - r
+            if (rr, cc) not in info["original_red"]:
