+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MARKER_COLORS = (BLUE, GREEN, YELLOW)
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GEN_RETRIES = 400
