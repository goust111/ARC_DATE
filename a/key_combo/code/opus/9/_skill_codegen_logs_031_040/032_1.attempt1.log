+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_infos(grid: np.ndarray) -> list[dict]:
+    infos = []
+    for comp in _components_of_color(grid, GREY):
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+        infos.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "inner": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+            }
+        )
+    infos.sort(key=lambda item: item["bbox"])
+    return infos
+
