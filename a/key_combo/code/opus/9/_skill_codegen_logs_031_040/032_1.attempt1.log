+def _mirror_step(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    out = np.array(grid, dtype=int, copy=True)
+    infos = _frame_infos(out)
+    for info in infos:
+        ir0, ic0, ir1, ic1 = info["inner"]
+        inner_h = ir1 - ir0 + 1
+        inner_w = ic1 - ic0 + 1
