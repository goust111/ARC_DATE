def _gen_place_initial_block(rng, mask, target_area, block_goal):
    hmax, wmax = mask.shape
    desired = max(GEN_BLOCK_MIN_AREA, target_area / max(1, block_goal))
    choices = _gen_block_candidates(hmax, wmax, desired)
    if not choices:
