+
+def _ordered_markers(grid: np.ndarray) -> list[tuple[int, int, int, tuple[int, int]]]:
+    h, w = grid.shape
+    ordered: list[tuple[int, int, int, tuple[int, int]]] = []
+    seen: set[tuple[int, int]] = set()
+
+    def add(r: int, c: int, step: tuple[int, int]) -> None:
+        if (r, c) in seen:
+            return
