+def _intersects_bbox_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    step: tuple[int, int],
+    bbox: tuple[int, int, int, int],
+) -> bool:
+    h, w = shape
+    r, c = start[0] + step[0], start[1] + step[1]
+    r0, c0, r1, c1 = bbox
+    while 0 <= r < h and 0 <= c < w:
+        if r0 <= r <= r1 and c0 <= c <= c1:
+            return True
+        r += step[0]
+        c += step[1]
+    return False
