+def _shape_is_connected(cells: set[tuple[int, int]]) -> bool:
+    start = next(iter(cells))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
+    return len(seen) == len(cells)
