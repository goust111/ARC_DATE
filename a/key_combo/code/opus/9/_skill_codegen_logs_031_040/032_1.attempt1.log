+            if vertical:
+                lines = sorted({c for _, c in motif_set} | {inner_w - 1 - c for _, c in motif_set})
+            else:
+                lines = sorted({r for r, _ in motif_set} | {inner_h - 1 - r for r, _ in motif_set})
+            if not lines:
