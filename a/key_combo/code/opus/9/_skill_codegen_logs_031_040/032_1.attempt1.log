+        options = [p for p in frontier if p in cells and p not in chosen]
+        if not options:
+            return None
+        cell = random.choice(options)
+        chosen.add(cell)
+        frontier.discard(cell)
+        for dr, dc in DIRS4:
+            nxt = (cell[0] + dr, cell[1] + dc)
+            if nxt in cells and nxt not in chosen:
+                frontier.add(nxt)
