+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    if np.any(interior == GREY):
+        return False
+    red_inside = {(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1) if int(grid[r, c]) == RED}
