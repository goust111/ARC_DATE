+    patch[-1, (inner_w + 1) // 2] = BG
+    patch[(inner_h + 1) // 2, 0] = BG
+    patch[(inner_h + 1) // 2, -1] = BG
+    return patch
+
+
+def _random_connected_shape(cells: list[tuple[int, int]], size: int) -> list[tuple[int, int]] | None:
