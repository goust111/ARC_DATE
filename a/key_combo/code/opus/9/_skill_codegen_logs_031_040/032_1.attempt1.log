+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            q = deque([(r, c)])
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_candidate_ok(
+    grid: np.ndarray,
+    comp_set: set[tuple[int, int]],
+    bbox: tuple[int, int, int, int],
+) -> bool:
+    r0, c0, r1, c1 = bbox
+    if r1 - r0 < 4 or c1 - c0 < 4:
+        return False
+    top = grid[r0, c0 : c1 + 1]
+    bottom = grid[r1, c0 : c1 + 1]
+    left = grid[r0 : r1 + 1, c0]
+    right = grid[r0 : r1 + 1, c1]
+    sides = (top, bottom, left, right)
+    for side in sides:
+        bad = [int(v) for v in side if int(v) not in (BG, GREY)]
+        if bad:
+            return False
+        if np.count_nonzero(side == GREY) < len(side) - 1:
+            return False
