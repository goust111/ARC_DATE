def _gen_frontier_cells(mask: np.ndarray, forbidden: tuple[int, int] | None = None) -> set[tuple[int, int]]:
    """Return unfilled 8-neighbor cells around the current mask."""
    h, w = mask.shape
    candidates = set()
    for r, c in np.argwhere(mask):
