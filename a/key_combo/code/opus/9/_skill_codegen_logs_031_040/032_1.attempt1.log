+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MARKER_COLORS = (BLUE, GREEN, YELLOW)
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GEN_RETRIES = 400
+GEN_GRID_ROWS = (14, 19)
+GEN_GRID_COLS = (18, 24)
+GEN_FRAME_COUNT = (2, 4)
+GEN_MARKER_COUNT = (3, 6)
+GEN_GAP = 2
