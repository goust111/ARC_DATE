+
+def _simulate_candidate(
+    base_grid: np.ndarray,
+    frames: list[dict],
+    start: tuple[int, int],
+    step: tuple[int, int],
+) -> dict | None:
+    h, w = base_grid.shape
+    r = start[0] + step[0]
+    c = start[1] + step[1]
+    traversed: list[tuple[int, int]] = []
+    crossed_frames = {
+        i
+        for i, info in enumerate(frames)
+        if _intersects_bbox_path((h, w), start, step, info["bbox"])
