+def _marker_axes(
+    grid: np.ndarray, inner_color: int, box: tuple[int, int, int, int]
+) -> tuple[list[int], list[int], list[tuple[int, int]]]:
+    r0, c0, r1, c1 = box
+    rows: set[int] = set()
+    cols: set[int] = set()
+    markers: list[tuple[int, int]] = []
