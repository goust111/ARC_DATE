+def _segments(start: int, end: int, cuts: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    cur = start
+    for cut in cuts:
+        spans.append((cur, cut - 1))
+        cur = cut + 1
