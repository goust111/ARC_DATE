+def _choose_colors() -> tuple[int, int]:
+    if random.random() < 0.4:
+        shared = random.choice([0, 1])
+        other = random.choice([c for c in NON_BLACK if c not in (GREEN, YELLOW)])
+        return (GREEN, other) if shared == 0 else (other, GREEN)
