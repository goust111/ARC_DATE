+                out[r0 + blue_cell[0], c0 + blue_cell[1]] = RED
+                out[r0 + red_cell[0], c0 + red_cell[1]] = BLUE
+            else:
+                out[r0 + blue_cell[0], c0 + blue_cell[1]] = BLUE
+                out[r0 + red_cell[0], c0 + red_cell[1]] = RED
