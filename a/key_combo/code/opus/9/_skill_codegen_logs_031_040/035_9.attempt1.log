+        while len({pair_grid[i, j] for i in range(LATTICE_ROWS) for j in range(LATTICE_COLS)}) < 4:
+            pos = empties.pop()
+            pair_grid[pos] = PAIR_POOL[int(rng.integers(0, len(PAIR_POOL)))]
