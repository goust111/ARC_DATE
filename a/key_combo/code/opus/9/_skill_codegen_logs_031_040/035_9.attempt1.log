def _gen_regions(height: int, width: int, split_type: str, cut: int) -> list[dict[str, int | str]]:
    if split_type == "horizontal":
        return [
            {"side": "top", "r0": 0, "r1": cut - 1, "c0": 0, "c1": width - 1},
            {"side": "bottom", "r0": cut, "r1": height - 1, "c0": 0, "c1": width - 1},
