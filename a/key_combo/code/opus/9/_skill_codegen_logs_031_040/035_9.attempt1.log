+            pair_grid[i, j] = pair
+            distinct_needed.add(pair)
+
+    if len(distinct_needed) < 4:
+        empties = [(i, j) for i in range(LATTICE_ROWS) for j in range(LATTICE_COLS) if (i, j) not in {gpos, ypos}]
