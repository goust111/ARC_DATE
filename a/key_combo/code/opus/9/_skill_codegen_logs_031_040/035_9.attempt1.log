+
+
+PAIR_POOL = _pair_pool()
+
+
+def _pair_to_cells(pair: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    blue_idx, red_idx = pair
+    return divmod(blue_idx, CELL_SIZE), divmod(red_idx, CELL_SIZE)
