+
+def _sample_layout(rng: np.random.Generator) -> tuple[tuple[int, int], tuple[int, int], tuple[int, int]]:
+    h = int(rng.integers(*GRID_H_RANGE))
+    w = int(rng.integers(*GRID_W_RANGE))
