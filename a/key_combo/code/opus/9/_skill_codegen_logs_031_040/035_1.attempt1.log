+def _bboxes_far_apart(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
+    return a[2] + margin < b[0] or b[2] + margin < a[0] or a[3] + margin < b[1] or b[3] + margin < a[1]
