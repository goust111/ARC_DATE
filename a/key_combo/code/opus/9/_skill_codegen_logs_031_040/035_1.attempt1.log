+
+        if _validate_generated_grid(grid, require_unassigned=require_unassigned):
+            return grid
+    return None
+
+
+def _validate_generated_grid(grid: np.ndarray, require_unassigned: bool) -> bool:
+    try:
+        details = _analyze(grid)
+    except AssertionError:
