GEN_MAX_NOTCHES, GEN_MIN_NOTCH_DEPTH = 4, 1
GEN_MIN_NOTCH_CANVAS_SIDE, GEN_MIN_MULTI_NOTCH_HEIGHT = 4, 5
GEN_MULTI_NOTCH_THRESHOLD = 2
