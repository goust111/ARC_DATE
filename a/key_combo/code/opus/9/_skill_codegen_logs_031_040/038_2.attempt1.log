+    elif side == "left":
+        reflected[:, 1] = 2 * c0 - 1 - reflected[:, 1]
+    elif side == "down":
+        reflected[:, 0] = 2 * r1 + 1 - reflected[:, 0]
+    elif side == "up":
+        reflected[:, 0] = 2 * r0 - 1 - reflected[:, 0]
