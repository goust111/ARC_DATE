+    assert cup_inside.any()
+    assert 1 <= int(np.count_nonzero(cup_inside[0, :] if opening == "up" else cup_inside[-1, :] if opening == "down" else cup_inside[:, 0] if opening == "left" else cup_inside[:, -1])) <= 2
