+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        height = int(rng.integers(12, 19))
+        width = int(rng.integers(16, 23))
+        grid = np.zeros((height, width), dtype=int)
