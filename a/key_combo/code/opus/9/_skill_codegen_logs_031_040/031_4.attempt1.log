def region_count(h,w,K,marks):
    blocked=np.zeros((h,w),dtype=bool)
    blocked[0,:K]=True  # legend excluded from region search
    for r,c in marks:
        for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:
            rr,cc=r,c
            while 0<=rr<h and 0<=cc<w:
