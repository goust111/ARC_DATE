+BLUE = 1
+RED = 2
+GREEN = 3
+PINK = 6
+ORANGE = 7
+
+LEGEND_PALETTE = (BLUE, GREEN, ORANGE, PINK)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
