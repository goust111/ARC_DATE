+    offsets_c = [0, 1] if width - outer_w >= 1 else [0]
+    positions = []
+    for dr in offsets_r:
+        for dc in offsets_c:
+            positions.extend(
+                [
+                    (dr, dc),
+                    (dr, width - outer_w - dc),
+                    (height - outer_h - dr, dc),
+                    (height - outer_h - dr, width - outer_w - dc),
+                ]
+            )
+    return sorted(set(positions))
