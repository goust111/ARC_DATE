+def _template_positions(height: int, width: int, outer_h: int, outer_w: int) -> list[tuple[int, int]]:
+    offsets_r = [0, 1] if height - outer_h >= 1 else [0]
+    offsets_c = [0, 1] if width - outer_w >= 1 else [0]
