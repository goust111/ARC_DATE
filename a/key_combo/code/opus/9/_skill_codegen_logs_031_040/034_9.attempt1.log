+
+
+def _make_tile(size: int, pattern_kind: str) -> np.ndarray:
+    tile = np.zeros((size, size), dtype=int)
+    for r in range(size):
+        for c in range(size):
+            if pattern_kind == "checker":
+                idx = (r + c) % 2
+            elif pattern_kind == "horizontal":
+                idx = r % 2
+            else:
