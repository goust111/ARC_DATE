+    target = random.randint(1, min(6, len(cells)))
+    random.shuffle(cells)
+    chosen = cells[:target]
+    edge_ids = set()
+    r0, c0, r1, c1 = rect
+    for r, c in chosen:
+        if r == r0:
+            edge_ids.add("top")
+        elif r == r1:
+            edge_ids.add("bottom")
+        elif c == c0:
