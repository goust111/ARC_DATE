+    for c in range(c0, c1 + 1):
+        if int(out[r0, c]) != OBSTACLE_COLOR:
+            out[r0, c] = RECT_COLOR
+        if int(out[r1, c]) != OBSTACLE_COLOR:
+            out[r1, c] = RECT_COLOR
