    """Generate a random 8-connected component with the given area and color."""
    dims = _feasible_dims(area)
    irregular_dims = [d for d in dims if d[0] * d[1] > area]
    if irregular_dims and _RNG.random() < IRREGULAR_PROB:
        dims = irregular_dims
