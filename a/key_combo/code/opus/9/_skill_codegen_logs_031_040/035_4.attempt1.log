    canon = np.asarray(mask, dtype=bool)
    best = (canon.tobytes(), tuple(map(int, canon.shape)))
    for _ in range(4):
        canon = np.rot90(canon)
        for v in (canon, np.fliplr(canon)):
            key = (v.tobytes(), tuple(map(int, v.shape)))
            if key < best:
