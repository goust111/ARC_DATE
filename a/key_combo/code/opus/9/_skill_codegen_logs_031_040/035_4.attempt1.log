+    left = c < mid_c
+    if top and left:
+        return "TL"
+    if top and not left:
+        return "TR"
+    if not top and not left:
+        return "BR"
+    return "BL"
+
+
+def _unique_least_marker_color(grid: np.ndarray) -> int:
