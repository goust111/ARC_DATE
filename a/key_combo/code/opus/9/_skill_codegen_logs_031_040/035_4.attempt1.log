+        rows = _quadrant_ranges(h, quadrant in ("TL", "TR"), ph)
+        cols = _quadrant_ranges(w, quadrant in ("TL", "BL"), pw)
+        cells: list[tuple[int, int]] = []
+        for r in rows:
+            for c in cols:
