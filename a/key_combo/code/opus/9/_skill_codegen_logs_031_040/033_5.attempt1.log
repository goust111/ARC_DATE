+    out = np.zeros_like(g)
+    for marker in markers:
+        transformed = QUADRANT_TO_TRANSFORM[marker["quadrant"]](template)
+        _stamp_into_corner(out, transformed, marker["quadrant"], marker["color"])
+    return out
