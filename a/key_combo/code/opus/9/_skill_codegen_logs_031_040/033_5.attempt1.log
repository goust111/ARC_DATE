+        cs = slice(0, w)
+    elif quadrant == "top_right":
+        rs = slice(0, h)
+        cs = slice(gw - w, gw)
+    elif quadrant == "bottom_left":
+        rs = slice(gh - h, gh)
+        cs = slice(0, w)
+    else:
+        rs = slice(gh - h, gh)
+        cs = slice(gw - w, gw)
+    out[rs, cs][mask] = color
