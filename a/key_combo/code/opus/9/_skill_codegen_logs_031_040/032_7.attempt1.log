  "path": "from each red corner, diagonal ray in the matching corner direction",
  "trajectory": "copy a filled 2x2 square of the paint color one cell at a time along each ray, clipped at the grid boundary",
  "transform": "red seed pixels become the paint color; all painted cells use the seed's non-red color"
}
</annotation>
<generation_spec>
