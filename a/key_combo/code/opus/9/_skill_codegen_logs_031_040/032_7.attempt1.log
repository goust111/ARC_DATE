+    extra_c = np.random.randint(0, 3)
+    if tr == 0:
+        r1 = min(2 * size - 1, r1 + extra_r)
+    else:
+        r0 = max(0, r0 - extra_r)
+    if tc == 0:
+        c1 = min(2 * size - 1, c1 + extra_c)
+    else:
