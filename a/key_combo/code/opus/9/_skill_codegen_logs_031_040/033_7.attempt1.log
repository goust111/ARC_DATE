+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+FOREGROUND = 9
+SINGLE_OVERLAP_COLOR = 2
+TRIPLE_OVERLAP_COLOR = 3
