+    if not 2 <= len(centers) <= 4:
+        return False
+    if any(r < 2 or r > grid.shape[0] - 3 or c < 2 or c > grid.shape[1] - 3 for r, c in centers):
+        return False
+    if not _intended_overlap_exists(centers):
