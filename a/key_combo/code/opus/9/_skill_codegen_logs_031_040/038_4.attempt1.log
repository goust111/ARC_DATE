+    anchors = [_find_anchor(g, color) for color in ANCHOR_COLORS]
+    gray_cells = [tuple(map(int, cell)) for cell in np.argwhere(g == GREY)]
+    assert GRAY_COUNT_MIN <= len(gray_cells) <= GRAY_COUNT_MAX
