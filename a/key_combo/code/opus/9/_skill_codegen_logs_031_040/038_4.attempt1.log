+        if packed is None:
+            continue
+
+        special_ray = active_special[int(rng.integers(0, len(active_special)))]
+
+        options_by_ray = {}
+        failed = False
+        for ray in active_rays:
+            force_special = ray == special_ray
+            options = _ray_options(candidates[ray], counts[ray], force_special, rng)
+            if not options:
