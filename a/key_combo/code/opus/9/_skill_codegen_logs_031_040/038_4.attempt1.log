+    r0, c0 = anchor["top_left"]
+    r1, c1 = r0 + 1, c0 + 1
+    if r < r0 and c < c0 and (r0 - r) == (c0 - c):
+        return "NW", r0 - r
+    if r < r0 and c > c1 and (r0 - r) == (c - c1):
+        return "NE", r0 - r
+    if r > r1 and c < c0 and (r - r1) == (c0 - c):
