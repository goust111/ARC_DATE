+
+
+def _sample_anchors(
+    shape: tuple[int, int], rng: np.random.Generator
+) -> list[dict[str, object]]:
+    h, w = shape
+    layout = str(rng.choice(["tl_br", "tr_bl"]))
+    color_order = list(ANCHOR_COLORS)
