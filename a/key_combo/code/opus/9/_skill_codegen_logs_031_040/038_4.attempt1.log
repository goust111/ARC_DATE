+def _sample_anchor_top_left(
+    shape: tuple[int, int], quadrant: str, rng: np.random.Generator
+) -> tuple[int, int]:
+    h, w = shape
+    top_rows = (2, h // 2 - 3)
+    bottom_rows = (h // 2 + 1, h - 4)
+    left_cols = (2, w // 2 - 3)
+    right_cols = (w // 2 + 1, w - 4)
