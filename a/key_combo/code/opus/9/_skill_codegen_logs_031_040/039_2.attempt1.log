import numpy as np
from collections import deque

def bbox(coords):
    rows=[r for r,c in coords]; cols=[c for r,c in coords]
    return min(rows),min(cols),max(rows),max(cols)

def local(coords):
    r0,c0,r1,c1=bbox(coords)
    m=np.zeros((r1-r0+1,c1-c0+1),bool)
    for r,c in coords: m[r-r0,c-c0]=1
