import numpy as np
from collections import deque
shapes={
'Uopen':((0,0),(0,1),(0,2),(1,0),(2,0),(2,1),(2,2)),
'bracket':((0,0),(0,1),(0,2),(1,0),(2,0),(2,1)),
'C4':((0,0),(0,1),(0,2),(1,0),(2,0),(2,1),(2,2),(1,2)),
}

def local(pts):
    r0=min(r for r,c in pts); c0=min(c for r,c in pts)
    r1=max(r for r,c in pts); c1=max(c for r,c in pts)
    m=np.zeros((r1-r0+1,c1-c0+1),bool)
    for r,c in pts: m[r-r0,c-c0]=1
    return m

def holes(mask):
    h,w=mask.shape; bg=~mask; vis=np.zeros((h,w),bool); ans=0
    for r in range(h):
      for c in range(w):
        if not bg[r,c] or vis[r,c]: continue
        q=deque([(r,c)]); vis[r,c]=1; touch=False
        while q:
          rr,cc=q.popleft()
          if rr in (0,h-1) or cc in (0,w-1): touch=True
          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<h and 0<=nc<w and bg[nr,nc] and not vis[nr,nc]: vis[nr,nc]=1; q.append((nr,nc))
        if not touch: ans+=1
    return ans

def normalize(coords):
    r0=min(r for r,c in coords); c0=min(c for r,c in coords)
    return tuple(sorted((r-r0,c-c0) for r,c in coords))

def scene(coords,axis=False):
    coords=normalize(coords)
    maxc=max(c for r,c in coords); ax=maxc+2
    pts=list(coords)+[(r,2*ax-c) for r,c in coords]
    if axis:
      rs=[r for r,c in pts]
      for r in range(min(rs), max(rs)+1): pts.append((r,ax))
    return local(pts)
for name,s in shapes.items():
    print(name,'orig holes',holes(local(s)))
    for ax in [False,True]:
        m=scene(s,axis=ax)
        print('axis',ax,'holes',holes(m))
        for row in m.astype(int): print(''.join('#' if x else '.' for x in row))
        print()
