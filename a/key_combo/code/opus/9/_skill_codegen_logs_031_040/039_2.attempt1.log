+    return len(recolor_colors) >= 2
+
+
+def _choose_sprite_holes(count: int) -> list[int]:
+    holes = [0, 2]
+    while len(holes) < count:
+        holes.append(random.choice((0, 2)))
+    random.shuffle(holes)
+    return holes
+
+
+def _attempt_generate() -> np.ndarray | None:
