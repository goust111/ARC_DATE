+        cur_r += patch.shape[0] + 1
+    return boxes
+
+
+def _component_box(coords: tuple[tuple[int, int], ...], r0: int, c0: int) -> tuple[int, int, int, int]:
+    rows = [r0 + r for r, _ in coords]
+    cols = [c0 + c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
