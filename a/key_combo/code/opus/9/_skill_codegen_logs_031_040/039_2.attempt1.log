from collections import deque

def conn(coords):
    s=set(coords)
    q=[next(iter(s))]; vis={q[0]}
    while q:
        r,c=q.pop()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            p=(r+dr,c+dc)
            if p in s and p not in vis:
                vis.add(p); q.append(p)
    return len(vis)==len(s)

