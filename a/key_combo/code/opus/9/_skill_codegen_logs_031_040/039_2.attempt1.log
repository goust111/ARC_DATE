from collections import deque

def normalize(coords):
    r0=min(r for r,c in coords); c0=min(c for r,c in coords)
    return tuple(sorted((r-r0,c-c0) for r,c in coords))

def local(coords):
    r0=min(r for r,c in coords); c0=min(c for r,c in coords)
    r1=max(r for r,c in coords); c1=max(c for r,c in coords)
    m=np.zeros((r1-r0+1,c1-c0+1),bool)
    for r,c in coords: m[r-r0,c-c0]=1
    return m

def holes(mask):
    h,w=mask.shape; bg=~mask; vis=np.zeros((h,w),bool); ans=0
    for r in range(h):
      for c in range(w):
        if not bg[r,c] or vis[r,c]: continue
        q=deque([(r,c)]); vis[r,c]=1; touch=False
        while q:
          rr,cc=q.popleft()
          if rr in (0,h-1) or cc in (0,w-1): touch=True
