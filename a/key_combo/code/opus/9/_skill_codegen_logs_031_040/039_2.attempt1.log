+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == BLUE)]
+    assert len(cols) == 1, "expected exactly one full blue reflection axis"
+    axis_c = int(cols[0])
+    assert axis_c == grid.shape[1] // 2, "axis must be the center column"
+    return axis_c
