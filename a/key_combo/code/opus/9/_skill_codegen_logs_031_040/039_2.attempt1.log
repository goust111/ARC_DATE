+        mirrored = _mirror_coords(coords, axis_c)
+        color = legend[_merged_hole_count(coords, axis_c)]
+        out[coords[:, 0], coords[:, 1]] = color
+        out[mirrored[:, 0], mirrored[:, 1]] = color
