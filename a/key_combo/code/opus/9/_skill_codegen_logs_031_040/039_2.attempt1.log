+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(sorted(coords), dtype=int))
+    parts.sort(key=lambda pts: (int(pts[:, 0].min()), int(pts[:, 1].min()), len(pts)))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
+
+
+def _local_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def _hole_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
