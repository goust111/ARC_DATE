import itertools, numpy as np
from collections import deque

def conn(coords):
    s=set(coords)
    q=[next(iter(s))]; vis={q[0]}
    while q:
        r,c=q.pop()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            p=(r+dr,c+dc)
            if p in s and p not in vis:
                vis.add(p); q.append(p)
    return len(vis)==len(s)

def normalize(coords):
    r0=min(r for r,c in coords); c0=min(c for r,c in coords)
    return tuple(sorted((r-r0,c-c0) for r,c in coords))

def local(coords):
    r0=min(r for r,c in coords); c0=min(c for r,c in coords)
    r1=max(r for r,c in coords); c1=max(c for r,c in coords)
    m=np.zeros((r1-r0+1,c1-c0+1),bool)
    for r,c in coords: m[r-r0,c-c0]=1
    return m

def holes(mask):
    h,w=mask.shape; bg=~mask; vis=np.zeros((h,w),bool); ans=0
    for r in range(h):
      for c in range(w):
        if not bg[r,c] or vis[r,c]: continue
        q=deque([(r,c)]); vis[r,c]=1; touch=False
        while q:
          rr,cc=q.popleft()
          if rr in (0,h-1) or cc in (0,w-1): touch=True
          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<h and 0<=nc<w and bg[nr,nc] and not vis[nr,nc]: vis[nr,nc]=1; q.append((nr,nc))
        if not touch: ans+=1
    return ans

def mirror_union(coords,gap=1):
    coords=normalize(coords)
    maxc=max(c for r,c in coords)
    ax=maxc+gap+1
    pts=list(coords)+[(r,2*ax-c) for r,c in coords]
    return local(pts)

def asym(coords):
    coords=normalize(coords)
    maxc=max(c for r,c in coords)
    mir=normalize([(r,maxc-c) for r,c in coords])
    return coords"'!=mir

seen=set(); found=[]
for h in range(2,8):
  for w in range(2,6):
    cells=[(r,c) for r in range(h) for c in range(w)]
    for k in range(4,9):
      for comb in itertools.combinations(cells,k):
        if not conn(comb):
          continue
        n=normalize(comb)
        if n in seen or not asym(n):
          continue
        seen.add(n)
        if holes(local(n)) != 0:
          continue
        hc = holes(mirror_union(n,1))
        if hc == 2:
          found.append(n)
          print(n)
          m=mirror_union(n,1)
          for row in m.astype(int):
            print('"''.join('#' if x else '.' for x in row))
          print()
          if len(found) >= 6:
            raise SystemExit
print('count',len(found))
