+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _frame_bbox(top_left: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, c0 = top_left
+    return r0, c0, r0 + FRAME_SIZE - 1, c0 + FRAME_SIZE - 1
+
+
