+    b: tuple[int, int, int, int],
+    margin: int = 0,
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + margin < br0
+        or br1 + margin < ar0
+        or ac1 + margin < bc0
+        or bc1 + margin < ac0
+    )
+
+
+def _coord_in_expanded_bbox(coord: tuple[int, int], bbox: tuple[int, int, int, int], margin: int) -> bool:
+    r, c = coord
