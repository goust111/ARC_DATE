+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+FRAME_SIZE = 5
+FRAME_CENTER_OFFSET = 2
+INNER_SLICE = slice(1, 4)
+OPENINGS = ("up", "down", "left", "right")
+DIR_VECTORS = {
