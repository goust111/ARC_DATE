+
+def _path_connected(grid: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> bool:
+    g = np.asarray(grid, dtype=int)
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
