+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DIR_VECS = {
+    BLUE: (-1, 0),   # up
+    RED: (1, 0),     # down
+    GREEN: (0, -1),  # left
+    YELLOW: (0, 1),  # right
