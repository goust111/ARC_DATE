0012: # Each rectangular region/partition/chessboard cell is filled with a single color, and has a different size.
0013: # To make the output, make a grid with one pixel for each cell of the chessboard.
0014: 
0015: def main(input_grid):
0016:     """
0017:     Downscale a colored rectangular partition grid to one pixel per partition.
0018: 
0019:     Input structure:
0020:     - A multicolored chessboard-like sprite sits on a black background.
0021:     - Each cell is a monochromatic rectangle and cell sizes may vary.
0022:     - Component upper-left corners define the row and column partition positions.
0023: 
0024:     Rule:
0025:     - Detect the non-black rectangular components.
0026:     - Collect sorted unique top-left row and column positions.
0027:     - Sample the input color at each position to build the compact output grid.
0028: 
0029:     Key insight:
0030:     - The output is the partition coordinate skeleton, not a proportional resize.
0031:     """
0032:     # Plan:
0033:     # 1. Find the colored regions in the input grid
0034:     # 2. Get the coordinates of the chessboard pattern, which are the x/y positions of the regions
0035:     # 3. Draw the output grid with one pixel for each region (cell of the chessboard)
0036: 
0037:     # 1. Input parsing
0038:     # Find the colored objects in the input grid
0039:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0040: 
0041:     # 2. Figuring out the chessboard pattern
0042:     # Get the position of the objects
0043:     positions = []
0044:     for obj in objects:
0045:         _b = bbox(obj != Color.BLACK)
0046:         assert _b is not None
0047:         positions.append(bbox_anchor(_b, anchor="upper left"))
0048:     r_position_list = [r for r, _c in positions]
0049:     c_position_list = [c for _r, c in positions]
