+        return int(rows.min()), int(cols.min())
+    if direction == RED:
+        return -int(rows.max()), int(cols.min())
+    if direction == GREEN:
+        return int(cols.min()), int(rows.min())
+    if direction == YELLOW:
+        return -int(cols.max()), int(rows.min())
+    raise ValueError(f"unsupported direction color: {direction}")
