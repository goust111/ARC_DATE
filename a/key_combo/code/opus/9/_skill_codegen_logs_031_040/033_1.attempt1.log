+        new_coords = np.array(sorted(cells), dtype=int)
+        comp["coords"] = new_coords
+        traces.append(
+            {
+                "id": int(comp["id"]),
+                "color": color,
+                "steps": int(steps),
+                "block_reason": block_reason,
+                "blockers": set(blockers),
+                "coords": new_coords.copy(),
