+def _fits(coords: np.ndarray, h: int, w: int) -> bool:
+    return bool(np.all(coords[:, 0] >= 0) and np.all(coords[:, 0] < h) and np.all(coords[:, 1] >= 0) and np.all(coords[:, 1] < w))
