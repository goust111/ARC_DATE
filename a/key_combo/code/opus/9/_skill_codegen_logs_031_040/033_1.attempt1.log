+        cells = {(int(r), int(c)) for r, c in comp["coords"].tolist()}
+        while True:
+            nxt = [(r + dr, c + dc) for r, c in cells]
+            if any(not (0 <= nr < h and 0 <= nc < w) for nr, nc in nxt):
