+            counterfactual = [{"id": int(c["id"]), "color": (alt if c["id"] == comp["id"] else int(c["color"])), "coords": np.array(c["coords"], dtype=int)} for c in recolored_comps]
+            altered_grid = np.zeros_like(recolored)
