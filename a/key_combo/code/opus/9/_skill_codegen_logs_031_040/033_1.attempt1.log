+    for comp in ordered:
+        color = int(comp["color"])
+        dr, dc = DIR_VECS[color]
+        cells = {(int(r), int(c)) for r, c in comp["coords"].tolist()}
+        steps = 0
+        block_reason = "edge"
+        blockers: set[int] = set()
+
+        while True:
+            nxt = [(r + dr, c + dc) for r, c in cells]
+            if any(not (0 <= nr < h and 0 <= nc < w) for nr, nc in nxt):
+                block_reason = "edge"
