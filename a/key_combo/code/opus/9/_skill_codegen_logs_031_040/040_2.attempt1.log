    bar_r = random.randint(MIN_BAR_ROW, max_bar_r)
    count = random.randint(MIN_SOURCE_COUNT, min(MAX_SOURCE_COUNT, width))

    output = np.full((height, width), BG_COLOR, dtype=int)
