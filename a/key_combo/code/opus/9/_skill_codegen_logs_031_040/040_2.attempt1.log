+    for i, gi in enumerate(groups):
+        r0, c0, r1, c1 = gi["bbox"]
+        assert r1 - r0 == c1 - c0
+        assert SIDE_RANGE[0] <= gi["side"] <= SIDE_RANGE[1]
+        for j in range(i + 1, len(groups)):
+            assert _bbox_gap_at_least_two(gi["bbox"], groups[j]["bbox"])
