spec:
  grid: 6-12 rows x 3-8 cols
  background: 0 (black)
  bar:
    color: 2 (red) [observed]
    shape: single full-width horizontal row, exactly one per grid
    position: row 3-9; at least 1 row above and 0-8 rows below; bar_row >= 1
  src:
    color: 4 (yellow) [observed]; distinct from bg and bar color
    count: 1-5 isolated single pixels
    placement: |
      - not on the bar row
      - not on bar_row-1 (would shift into bar)
      - not on last row if below bar (must have room to shift down)
      - all in distinct columns [observed]
      - shifted positions (r+1, c) must not collide with each other or with bar
      - can be above or below the bar; 0-1 pixels below bar
  trajectory:
    rule: |
      - each pixel shifts down 1 row (erase original, paint at r+1)
      - if shifted pixel lands at bar_row-1, emit two upward diagonal rays
        (up-left and up-right) from (bar_row-2, c +/- 1) until grid edge
      - diagonal rays must not collide with other shifted pixels or bar
    splash_count: 0-1 splashing pixels per example (exactly 2 rows above bar)
    ray_length: 0-4 cells per diagonal direction

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid dims H (6-12), W (3-8) and bar_row (1 to H-2)
    2. Fill bar row with bar_color=2
    3. Pick 1-5 distinct columns for moving pixels; for each decide position
    4. Optionally pick one column for the splash pixel; place it at bar_row-2 in output; draw both diagonal rays upward from (bar_row-2, col +/- 1)
    5. Place remaining (non-splash) pixels at arbitrary rows not on bar, not at bar_row-1, with room to shift down; these are already shifted positions in output
    6. Verify no painted cells overlap each other or the bar
    7. Derive input by un-shifting: move each pixel up 1 row, remove diagonal rays
