+        "tr": (min(r, other_r), max(c, other_c)),
+        "bl": (max(r, other_r), min(c, other_c)),
+        "br": (max(r, other_r), max(c, other_c)),
+    }
+    markers = tuple(corners[name] for name in ("tl", "tr", "bl", "br") if name != kind)
+    bbox = (
+        min(r, other_r),
+        min(c, other_c),
+        max(r, other_r),
+        max(c, other_c),
+    )
