+def _bbox_gap_at_least_two(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_gap = max(0, br0 - ar1 - 1, ar0 - br1 - 1)
