+    blue_ratio = float(mask.mean())
+    assert 0.20 <= blue_ratio <= 0.70
+    assert all(int(grid[r, c]) == BLACK for r, c in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)))
