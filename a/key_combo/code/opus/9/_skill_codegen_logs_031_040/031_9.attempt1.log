+        fh = int(RNG.integers(1, 4))
+        max_r0 = max(2, cr - h_half - fh + 1)
+        r0 = int(RNG.integers(1, max_r0))
+        r1 = r0 + fh - 1
+        c1 = cc - v_half
+        c0 = max(1, c1 - fw + 1)
+        _paint_orbit_rect(mask, (r0, c0, r1, c1))
