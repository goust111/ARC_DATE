+    axes = [axis for axis in range(limit) if _blue_symmetric_visible(grid, axis, horizontal)]
+    assert len(axes) == 1, f"expected unique {'horizontal' if horizontal else 'vertical'} axis, got {axes}"
+    return int(axes[0])
