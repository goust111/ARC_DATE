+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+PINK = 6
+
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_MIN = 13
+GRID_MAX = 19
+MARKER_SIZES = (3, 4)
