+
+
+def _place_boxes(height: int, width: int, sizes: list[tuple[int, int]], margin: int) -> list[BBox] | None:
+    order = sorted(range(len(sizes)), key=lambda idx: sizes[idx][0] * sizes[idx][1], reverse=True)
+    placed: dict[int, BBox] = {}
+    current: list[BBox] = []
+
+    for idx in order:
