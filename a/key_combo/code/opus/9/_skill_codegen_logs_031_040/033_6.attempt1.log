+    odd_color, even_color = SCHEMES[depth]
+    r0, c0, r1, c1 = bbox
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            layer = min(r - r0, r1 - r, c - c0, c1 - c)
+            if layer == 0:
+                out[r, c] = FRAME
+            elif layer % 2 == 1:
+                out[r, c] = odd_color
+            else:
+                out[r, c] = even_color
