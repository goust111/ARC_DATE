  grid: 11-17 rows x 11-17 cols
  colors:
    input: exactly 2 colors -- bg=0(black) and fg=1(blue)
    output: bg unchanged; rect border stays fg; interior layers recolored to red(2) and green(3)
  rectangles:
    count: 2-3 solid filled axis-aligned rectangles of color fg
    dimensions: each at least 3x3; individual side 3-11; at least one rect with min(h,w) >= 5 [observed]
    placement: non-overlapping, 4-connected separated (min 1 bg cell gap between any two)
    may touch grid edges [observed]
    coverage: ~40-55% of grid area [observed]
  transform:
    for each rectangle, compute depth = min distance to rectangle border
    depth 0 (border) -> keep fg (blue=1)
    depth odd (1,3,...) -> red (2)
    depth even >0 (2,4,...) -> green (3)

generation_strategy:
  approach: direct construction (input-only; transform is deterministic)
