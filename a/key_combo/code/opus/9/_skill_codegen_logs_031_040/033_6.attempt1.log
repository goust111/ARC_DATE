+def _extract_rectangles(grid: np.ndarray) -> list[BBox]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    assert set(np.unique(g).tolist()) <= {BG, FRAME}
