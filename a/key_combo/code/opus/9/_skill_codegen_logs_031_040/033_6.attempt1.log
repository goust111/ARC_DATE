+    rectangles: list[BBox] = []
+    for coords in _components_mask(g == FRAME):
+        bbox = _bbox_coords(coords)
+        r0, c0, r1, c1 = bbox
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert h >= 5 and w >= 5
