import itertools

def cheb_adj(a,b): return max(abs(a[0]-b[0]),abs(a[1]-b[1]))<=1

def build(lengths,types,d=(1,1), allow_revisit=False):
    dr,dc=d
    arr={(0,-dc),(-dr,0),(-dr,-dc)}
    cur=(0,0); path=[(0,0)]; segs=[[(0,0)]]; walls=[]
    for i,t in enumerate(types):
        need=lengths[i]-(1 if i==0 else 0)
        for step in range(need):
            # no unintended existing-wall bounce before planned bounce
            if (cur[0]+dr,cur[1]+dc) in walls:
                return None
            nr,nc=cur[0]+dr,cur[1]+dc
            if (nr,nc) in arr or (nr,nc) in walls or ((nr,nc) in path and not allow_revisit):
                return None
            cur=(nr,nc); path.append(cur); segs[-1].append(cur)
            if step < need-1 and ((cur[0]+dr,cur[1]) in walls or (cur[0],cur[1]+dc) in walls or (cur[0]+dr,cur[1]+dc) in walls):
                return None
        if t=='front':
            w=(cur[0]+dr,cur[1]+dc); nd=(-dr,-dc); forb=[(cur[0]+dr,cur[1]),(cur[0],cur[1]+dc)]
        elif t=='flip_r':
            w=(cur[0]+dr,cur[1]); nd=(-dr,dc); forb=[(cur[0]+dr,cur[1]+dc),(cur[0],cur[1]+dc)]
        else:
            w=(cur[0],cur[1]+dc); nd=(dr,-dc); forb=[(cur[0]+dr,cur[1]+dc),(cur[0]+dr,cur[1])]
        if w in arr or w in walls or any(f in walls for f in forb):
            return None
        walls.append(w); dr,dc=nd; segs.append([])
    for step in range(lengths[-1]):
        if (cur[0]+dr,cur[1]+dc) in walls:
            return None
        nr,nc=cur[0]+dr,cur[1]+dc
