+    return 0 <= r < h and 0 <= c < w
+
+
+def _chebyshev_adj(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(abs(int(a[0] - b[0])), abs(int(a[1] - b[1]))) <= 1
