+
+    return {
+        "segments": segments,
+        "path_sequence": path_sequence,
+        "walls": walls,
+        "arrow_cells": arrow_cells,
+        "end": current,
+    }
+
+
+def _transform_point(point: tuple[int, int], swap: bool, row_sign: int, col_sign: int) -> tuple[int, int]:
+    r, c = point
+    if swap:
+        r, c = c, r
+    return int(row_sign * r), int(col_sign * c)
