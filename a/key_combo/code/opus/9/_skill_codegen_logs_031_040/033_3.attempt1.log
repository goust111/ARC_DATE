+    min_h = max(14, span_h)
+    min_w = max(14, span_w)
+    max_h = min(18, span_h + 4)
+    max_w = min(18, span_w + 4)
+    h = random.randint(min_h, max_h)
+    w = random.randint(min_w, max_w)
+
