+            wall = (current[0] + dr, current[1] + dc)
+            dr, dc = -dr, -dc
+        elif bounce == "flip_r":
+            wall = (current[0] + dr, current[1])
+            dr = -dr
+        else:
+            wall = (current[0], current[1] + dc)
+            dc = -dc
