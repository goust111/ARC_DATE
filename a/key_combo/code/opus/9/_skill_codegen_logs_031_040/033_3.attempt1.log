+
+def _trace_ray(
+    grid: np.ndarray,
+) -> tuple[list[list[tuple[int, int]]], list[str]]:
+    arrow_cells, start, direction = _find_arrow(grid)
+    walls = {tuple(map(int, rc)) for rc in np.argwhere(grid == RED)}
+    current = start
+    dr, dc = direction
