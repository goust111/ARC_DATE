def _gen_tile(rng: np.random.Generator, tile_h: int, tile_w: int, color: int, count: int) -> np.ndarray:
    if rng.integers(0, 2) == 0:
        required = {(0, 0), (tile_h - 1, tile_w - 1)}
    else:
