+def _build_relative_plan(lengths: tuple[int, ...], bounces: tuple[str, ...], allow_revisit: bool) -> dict:
+    current = (0, 0)
+    dr, dc = 1, 1
+    arrow_cells = _arrow_cells_from_start(current, (dr, dc))
