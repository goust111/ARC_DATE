    right_pad = _randint(RIGHT_PAD_RANGE)
    bottom_pad = _randint(BOTTOM_PAD_RANGE)

    top_h = max(stamp.shape[0], pattern.shape[0])
    top_w = stamp.shape[1] + OBJECT_GAP + pattern.shape[1]
