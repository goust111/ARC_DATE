+]
+
+FRONT_TEMPLATES = [
+    {"lengths": (3, 4, 2, 5), "bounces": ("flip_r", "front", "flip_r"), "allow_revisit": True},
+    {"lengths": (3, 4, 2, 5), "bounces": ("flip_r", "front", "flip_c"), "allow_revisit": True},
