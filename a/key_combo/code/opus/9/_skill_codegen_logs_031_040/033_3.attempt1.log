+def _span(points: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(points)
+    rows = [p[0] for p in pts]
+    cols = [p[1] for p in pts]
+    return min(rows), max(rows), min(cols), max(cols)
