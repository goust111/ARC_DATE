    return path,segs,walls,arr,cur

def iso(walls,arr):
    for i,a in enumerate(walls):
        for b in walls[i+1:]:
            if cheb_adj(a,b): return False
    for w in walls:
        if any(cheb_adj(w,a) for a in arr): return False
    return True

