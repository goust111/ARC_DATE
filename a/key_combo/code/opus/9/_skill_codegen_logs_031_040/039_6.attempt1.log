+def _paint_guides(shape: tuple[int, int], markers: list[tuple[int, int, int]]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    marker_map = {(r, c): color for r, c, color in markers}
+    for r, c, color in markers:
