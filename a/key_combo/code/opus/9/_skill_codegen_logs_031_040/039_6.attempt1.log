+    marker_map = {(r, c): color for r, c, color in markers}
+    for r, c, color in markers:
+        out[r, :] = color
+        out[:, c] = color
+        out[r, c] = color
+
+    for r, _c, _color in markers:
+        for _r, c, _other_color in markers:
