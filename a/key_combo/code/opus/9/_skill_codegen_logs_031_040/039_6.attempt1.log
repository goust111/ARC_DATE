+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREEN = 3
+GREY = 5
+MARKER_COLORS = (1, 4, 6, 7, 8)
+
+MIN_SIDE = 12
+MAX_SIDE = 18
+MIN_MARKERS = 3
+MAX_MARKERS = 5
