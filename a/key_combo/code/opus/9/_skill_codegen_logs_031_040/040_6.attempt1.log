+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+
+
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+_GEN_GRID_MIN = 22
+_GEN_GRID_MAX = 30
+_GEN_BBOX_MIN = 5
+_GEN_BBOX_MAX = 6
+_GEN_GROUPS = [3, 4]  # total matching groups, including the original one
+_GEN_MARKER_COUNTS = [2, 3]
+_GEN_BBOX_GAP = 8
+_GEN_RETRIES = 400
