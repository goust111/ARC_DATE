+        boxes.append((int(first[0]), int(first[1]), int(first[0]) + h - 1, int(first[1]) + w - 1))
+
+    for r, c in positions:
+        if len(anchors) >= group_count:
+            break
+        box = (int(r), int(c), int(r) + h - 1, int(c) + w - 1)
+        if _far_enough(boxes, box):
+            anchors.append((int(r), int(c)))
+            boxes.append(box)
