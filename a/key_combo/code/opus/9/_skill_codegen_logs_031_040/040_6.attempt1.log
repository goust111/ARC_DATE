+    bottom = _longest_span(np.flatnonzero(body_mask[-1]))
+    left = _longest_span(np.flatnonzero(body_mask[:, 0]))
+    right = _longest_span(np.flatnonzero(body_mask[:, -1]))
+    return {"top": top, "bottom": bottom, "left": left, "right": right}
