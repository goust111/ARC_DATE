+    for _ in range(_GEN_RETRIES):
+        h = random.randint(_GEN_BBOX_MIN, _GEN_BBOX_MAX)
+        w = random.randint(_GEN_BBOX_MIN, _GEN_BBOX_MAX)
+        random.shuffle(corner_options)
