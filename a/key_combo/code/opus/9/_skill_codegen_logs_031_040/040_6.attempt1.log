+def _candidate_groups(
+    red_cells: set[tuple[int, int]],
+    offsets: tuple[tuple[int, int], ...],
+    shape: tuple[int, int],
+) -> list[dict]:
+    h, w = shape
+    max_r = max(r for r, _ in offsets)
+    max_c = max(c for _, c in offsets)
