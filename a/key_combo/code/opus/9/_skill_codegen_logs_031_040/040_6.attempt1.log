+        chosen = tuple(sorted(random.sample(candidates, count)))
+        rows = {r for r, _ in chosen}
+        cols = {c for _, c in chosen}
+        if len(rows) == 1 or len(cols) == 1:
+            continue
+        blue_only = body_mask.copy()
+        for r, c in chosen:
+            blue_only[int(r), int(c)] = False
