spec:
  grid: 6-10 rows x 6-12 cols
  background: black
  colors: input uses only red on black; output replaces some red with pink
  objects:
    type: 4-connected red components on black background
    total_count: 6-9
    small_objects:
      count: 4-6
      area: 1-3 each
    large_objects:
      count: 1-3
      area: 4-8 each
    shapes: freeform polyominoes; no symmetry constraint
    placement: may touch grid border; may be diagonally adjacent (8-connected) to other objects
  red_density: 14-36% of cells [observed]
  transform:
    rule: recolor every 4-connected red object with area >= 4 to pink; keep smaller objects and background unchanged
    output_size: same as input

generation_strategy:
