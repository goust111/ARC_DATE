+
+def _render_stacked(
+    shape: tuple[int, int], objects: list[dict], blockers: list[tuple[int, int]]
+) -> np.ndarray:
+    h, w = shape
+    out = np.full((h, w), BACKGROUND, dtype=int)
+    out[-1, :] = GROUND
+    for r, c in blockers:
+        out[r, c] = BLOCKER
