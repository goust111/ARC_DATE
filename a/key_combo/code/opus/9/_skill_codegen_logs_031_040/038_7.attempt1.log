+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    cells = [tuple(map(int, p)) for p in np.argwhere(mask)]
+    if not cells:
+        return False
+    seen = {cells[0]}
+    q = deque([cells[0]])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _enumerate_shapes() -> dict[int, list[np.ndarray]]:
+    out: dict[int, list[np.ndarray]] = {2: [], 3: []}
+    for h in (2, 3):
+        seen = set()
+        for w in (1, 2, 3):
+            total = h * w
+            for bits in range(1 << total):
+                area = bits.bit_count()
+                if not (4 <= area <= 6):
+                    continue
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in range(total):
+                    if bits & (1 << idx):
+                        mask[idx // w, idx % w] = True
+                if not np.all(mask.any(axis=1)):
+                    continue
+                if not np.all(mask.any(axis=0)):
+                    continue
+                if not _is_connected(mask):
+                    continue
+                key = tuple(tuple(int(v) for v in row) for row in mask)
+                if key in seen:
+                    continue
+                seen.add(key)
