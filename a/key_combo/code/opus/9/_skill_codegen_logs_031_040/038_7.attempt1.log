+    for obj in objects:
+        obj["transformed"] = _sheared_coords(obj["mask"], obj["top"], w)
+        obj["unsheared"] = _right_aligned_coords(obj["mask"], obj["top"], w)
+        for r, c in obj["transformed"]:
+            assert 0 <= r < h - 1 and 0 <= c < w, "sheared object must stay in bounds"
