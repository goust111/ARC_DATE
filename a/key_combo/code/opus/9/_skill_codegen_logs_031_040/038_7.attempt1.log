+                "id": idx,
+                "top": top,
+                "bottom": top + mask.shape[0] - 1,
+                "height": mask.shape[0],
+                "width": mask.shape[1],
+                "area": int(mask.sum()),
+                "mask": mask.copy(),
+                "color": color,
+                "transformed": _sheared_coords(mask, top, w),
+            }
