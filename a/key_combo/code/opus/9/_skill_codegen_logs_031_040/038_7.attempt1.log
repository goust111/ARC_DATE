+    for obj_id in order:
+        obj = by_id[obj_id]
+        new_top = current_bottom - obj["height"] + 1
+        if new_top < 0:
+            return out
+        for r, c in _sheared_coords(obj["mask"], new_top, w):
+            if out[r, c] != BACKGROUND:
