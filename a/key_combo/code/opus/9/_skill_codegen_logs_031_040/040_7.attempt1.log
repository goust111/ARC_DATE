+            region = out[top + 1 : bottom, left + 1 : right]
+            seeds = np.argwhere((region != BLACK) & (region != BLUE))
+            assert seeds.shape[0] in (0, 1), "each region must have at most one seed"
+            if seeds.shape[0] == 1:
