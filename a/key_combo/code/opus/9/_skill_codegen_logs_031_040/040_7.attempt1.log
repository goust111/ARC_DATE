+    out = np.array(grid, dtype=int, copy=True)
+    r0, c0, r1, c1 = box
+    for r in rows:
+        span = out[r, c0 : c1 + 1]
+        span[span == BLACK] = BLUE
+    for c in cols:
+        span = out[r0 : r1 + 1, c]
+        span[span == BLACK] = BLUE
+    return out
