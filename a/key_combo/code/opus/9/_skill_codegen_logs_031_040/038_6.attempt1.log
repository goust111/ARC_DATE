                if (_gen_r, _gen_cc) not in _gen_sources:
                    _gen_stamp_blue_ring(_gen_out, _gen_r, _gen_cc)

    return _gen_out


def _gen_derive_input(
    _gen_out: np.ndarray,
    _gen_horizontal: bool,
    _gen_guides: list[int],
    _gen_centers: list[tuple[int, int]],
) -> np.ndarray:
