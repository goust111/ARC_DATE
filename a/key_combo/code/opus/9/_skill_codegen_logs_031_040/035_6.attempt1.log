+    return out
+
+
+def _find_rectangular_frames(grid_after_fill: np.ndarray) -> list[tuple[int, int, int, int]]:
+    red = grid_after_fill == RED
+    frames: list[tuple[int, int, int, int]] = []
+    for coords in _components(red):
+        if coords.shape[0] < 8:
+            continue
