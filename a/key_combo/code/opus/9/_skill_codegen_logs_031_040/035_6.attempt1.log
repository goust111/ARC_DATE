+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+GRID_ROWS_RANGE = (13, 18)
+GRID_COLS_RANGE = (13, 18)
+FRAME_COUNT_CHOICES = (1, 2)
+FRAME_SIDE_RANGE = (5, 9)  # inclusive-exclusive for randint helper below
+FRAME_GAP = 2
+OUTSIDE_GAP = 1
+EXTRA_EDGE_MARKERS_PROB = 0.6
+GEN_ATTEMPTS = 400
+
+
+def _randint(lo: int, hi: int) -> int:
+    return int(np.random.randint(lo, hi + 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _ring_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
+    mask[r0 : r1 + 1, c0] = True
+    mask[r0 : r1 + 1, c1] = True
+    return mask
+
+
+def _span_fill_red(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    red = g == RED
+    h, w = g.shape
+
+    for r in range(h):
