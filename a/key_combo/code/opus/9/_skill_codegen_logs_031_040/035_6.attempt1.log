        frame[r0, c0 : c1 + 1] = True
        frame[r1, c0 : c1 + 1] = True
        frame[r0 : r1 + 1, c0] = True
        frame[r0 : r1 + 1, c1] = True
        if np.array_equal(mask, frame):
            candidates.append((color, box))

    assert len(candidates) == 1
    frame_color, box = candidates[0]
