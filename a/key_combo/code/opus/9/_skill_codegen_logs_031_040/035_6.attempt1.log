+def _outside_positions(h: int, w: int, boxes: list[tuple[int, int, int, int]]) -> list[tuple[int, int]]:
+    positions: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            inside_frame = False
+            on_border = False
+            for r0, c0, r1, c1 in boxes:
+                if r0 < r < r1 and c0 < c < c1:
+                    inside_frame = True
+                    break
+                if r0 <= r <= r1 and c0 <= c <= c1:
