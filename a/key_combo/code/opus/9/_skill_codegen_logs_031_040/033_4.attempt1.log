156:def _sprite_cells(apex: tuple[int, int], direction: tuple[int, int]) -> tuple[tuple[int, int], ...]:
157:    """Return the 3 pixel coords of a triangle sprite with given apex and firing direction.
158:
159:    Diagonal dir -> L-shape occupying 3 corners of a 2x2 (missing the corner opposite dir).
160:    Axis dir -> V-shape with apex + 2 diagonal legs pointing opposite dir.
161:    """
162:    ar, ac = apex
163:    dr, dc = direction
164:    if abs(dr) + abs(dc) == 2:
165:        return ((ar, ac), (ar - dr, ac), (ar, ac - dc))
166:    if dr != 0:
167:        return ((ar, ac), (ar - dr, ac - 1), (ar - dr, ac + 1))
168:    return ((ar, ac), (ar - 1, ac - dc), (ar + 1, ac - dc))
169:
170:
171:def _in_bounds_cells(cells: tuple[tuple[int, int], ...]) -> bool:
172:    return all(0 <= r < H and 0 <= c < W for r, c in cells)
173:
174:
175:def _halo(cells: tuple[tuple[int, int], ...]) -> frozenset[tuple[int, int]]:
176:    """Cell + 8-neighborhood, clipped to grid. Used to enforce Chebyshev>=2 separation."""
177:    return frozenset(
178:        (rr, cc)
179:        for r, c in cells
180:        for rr in range(max(0, r - 1), min(H, r + 2))
181:        for cc in range(max(0, c - 1), min(W, c + 2))
182:    )
183:
184:
185:def _build_placements() -> tuple[list[dict], dict[tuple[int, int], list[dict]]]:
186:    """Precompute all (apex, dir) placements whose sprite and landing cell are in-bounds."""
187:    placements: list[dict] = []
188:    by_dest: dict[tuple[int, int], list[dict]] = defaultdict(list)
189:    for ar in range(H):
190:        for ac in range(W):
191:            for dr, dc in ALL_DIRS:
192:                dest = (ar + PROJECTILE_DIST * dr, ac + PROJECTILE_DIST * dc)
193:                if not (0 <= dest[0] < H and 0 <= dest[1] < W):
194:                    continue
195:                cells = _sprite_cells((ar, ac), (dr, dc))
196:                if not _in_bounds_cells(cells):
197:                    continue
198:                placement = {
199:                    "apex": (ar, ac),
200:                    "dir": (dr, dc),
201:                    "dest": dest,
202:                    "cells": cells,
203:                    "cell_set": frozenset(cells),
204:                    "halo": _halo(cells),
205:                }
206:                placements.append(placement)

