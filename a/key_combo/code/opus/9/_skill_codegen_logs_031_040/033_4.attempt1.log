+    grid[r0 : r1 + 1, c0 : c1 + 1] = BLACK
+
+
+def _generation_attempt() -> np.ndarray | None:
+    H, W, proto_r0, proto_c0, frames = _sample_layout()
+    base_tile = _sample_base_tile()
