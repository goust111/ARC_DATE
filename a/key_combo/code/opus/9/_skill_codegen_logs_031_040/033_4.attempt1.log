91:def _gen_blob_cells(h, w, size, occupied):
92:    """Grow one connected mark inside the panel, avoiding already-used cells."""
93:    free = [(r, c) for r in range(h) for c in range(w) if (r, c) not in occupied]
94:    if len(free) < size:
95:        return None
96:
97:    blob = {random.choice(free)}
98:    frontier = {
99:        nbr
100:        for cell in blob
101:        for nbr in _gen_neighbors4(*cell, h, w)
102:        if nbr not in occupied and nbr not in blob
103:    }
104:    while len(blob) < size:
105:        if not frontier:
106:            return None
107:        cell = random.choice(tuple(frontier))
108:        frontier.remove(cell)
109:        blob.add(cell)
110:        blocked = occupied | blob
111:        for nbr in _gen_neighbors4(cell[0], cell[1], h, w):
112:            if nbr not in blocked:
113:                frontier.add(nbr)
114:    return blob
