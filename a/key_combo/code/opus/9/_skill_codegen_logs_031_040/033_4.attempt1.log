67:def main(grid: np.ndarray) -> np.ndarray:
68:    """
69:    Fire projectiles from 3-pixel triangle sprites; mark collisions with maroon or blue.
70:
71:    Input structure:
72:    - bg = most common color. Non-bg 3-pixel sprites shaped as axis-aligned L's or diagonal V's.
73:
74:    Rule:
75:    - Each triangle has an apex and an emission direction determined by its shape: L-shapes fire diagonally away from the missing corner; V-shapes fire along the axis away from the open side.
76:    - A projectile lands exactly 5 cells from the apex in the emission direction.
77:    - If it hits an existing sprite, that entire sprite is recolored to maroon (9).
78:    - If two projectiles land on the same empty cell, that cell becomes blue (1); a lone projectile on empty bg paints maroon (9).
79:
80:    Key insight: The triangle's orientation encodes both direction and target; dual-projectile collisions on open bg produce blue, not maroon.
81:    """
82:    g = np.asarray(grid, dtype=int)
83:    h, w = g.shape
84:    bg = _bg_color(g)
85:
86:    # Find all monochrome components for each non-bg color.
87:    comps: list[list[tuple[int, int]]] = []
88:    cell_to_comp: dict[tuple[int, int], int] = {}
89:    for col in sorted(set(int(v) for v in np.unique(g)) - {bg}):
90:        for comp in _cc8(g == col):
91:            cid = len(comps)
92:            comps.append(comp)
93:            for rc in comp:
94:                cell_to_comp[rc] = cid
95:
96:    # Each triangle emits a projectile. The visible effect is at the collision location only.
97:    # From training, the collision location is 5 cells away from the apex in its emission direction.
98:    dest_to_shooters: dict[tuple[int, int], list[int]] = {}
99:    for cid, comp in enumerate(comps):
100:        ad = _triangle_apex_and_dir(comp)
101:        if ad is None:
102:            continue
103:        (ar, ac), (dr, dc) = ad
104:        rr = ar + 5 * dr
105:        cc = ac + 5 * dc
106:        if 0 <= rr < h and 0 <= cc < w:
107:            dest_to_shooters.setdefault((rr, cc), []).append(cid)
108:
109:    hit_components: set[int] = set()
110:    for dest in dest_to_shooters:
111:        if dest in cell_to_comp:
112:            hit_components.add(cell_to_comp[dest])
113:
114:    out = g.copy()
115:
116:    # Projectile hitting a sprite recolors the entire sprite to maroon (9).
117:    for cid in hit_components:
118:        for r, c in comps[cid]:
119:            out[r, c] = 9
120:
121:    # Projectile collision locations on empty background.
122:    for (r, c), shooters in dest_to_shooters.items():
123:        if (r, c) in cell_to_comp:
124:            continue
125:        if len(shooters) >= 2:
126:            out[r, c] = 1
127:        else:
128:            out[r, c] = 9
129:
130:    return out
