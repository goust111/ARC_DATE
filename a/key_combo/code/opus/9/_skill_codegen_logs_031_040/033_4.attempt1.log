+    expected_output = crop_bbox(restored, (winner_frame[0] + 1, winner_frame[1] + 1, winner_frame[2] - 1, winner_frame[3] - 1))
+    if not np.array_equal(output, expected_output):
+        return None
+    if np.array_equal(input_grid, restored):
+        return None
+    return input_grid
