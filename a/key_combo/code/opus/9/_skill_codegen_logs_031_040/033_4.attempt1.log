+    raise RuntimeError("failed to place a border-breaking occluder")
+
+
+def _random_background_occluder(shape: tuple[int, int], forbidden: set[tuple[int, int]]) -> tuple[int, int, int, int] | None:
+    H, W = shape
+    for _ in range(120):
