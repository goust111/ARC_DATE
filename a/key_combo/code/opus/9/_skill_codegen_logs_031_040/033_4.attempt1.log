+    return counts, frames[winner_idx], marker_cells
+
+
+def _occluder_for_frame(frame: tuple[int, int, int, int], forbidden: set[tuple[int, int]], shape: tuple[int, int]) -> tuple[tuple[int, int, int, int], list[tuple[int, int]]]:
