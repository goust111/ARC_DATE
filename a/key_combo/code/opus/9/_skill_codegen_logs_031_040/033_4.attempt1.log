+def _rect_sum(ps: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
+    if r0 > r1 or c0 > c1:
+        return 0
+    total = int(ps[r1, c1])
+    if r0 > 0:
+        total -= int(ps[r0 - 1, c1])
+    if c0 > 0:
+        total -= int(ps[r1, c0 - 1])
+    if r0 > 0 and c0 > 0:
+        total += int(ps[r0 - 1, c0 - 1])
+    return total
