+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BACKGROUND = 5
+FRAME = 1
+MARKER_COLORS = (2, 3, 4)
+
+MIN_INNER = 3
+MAX_INNER = 6
+MIN_OUTER = MIN_INNER + 2
+MAX_OUTER = MAX_INNER + 2
