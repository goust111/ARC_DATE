    valid_frame_w = list(range(frame_min, min(frame_max, w - 2 * FRAME_MARGIN) + 1, FRAME_SIZE_STEP))
    if not valid_frame_h or not valid_frame_w:
        return None

    fh = int(np.random.choice(valid_frame_h))
