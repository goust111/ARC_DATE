+def _assign_markers(border_grid: np.ndarray, rects: list[Rect]) -> dict[Rect, tuple[tuple[int, int], int]] | None:
+    colors = random.sample(list(MARKER_COLORS), len(rects))
+    marker_info: dict[Rect, tuple[tuple[int, int], int]] = {}
