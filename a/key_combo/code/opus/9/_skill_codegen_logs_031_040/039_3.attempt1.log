+    mask[-1, :] = True
+    if h >= 3 and w >= 3:
+        mask[-2, 1:] = True
+    return mask
+
+
+def choose_control(mask: np.ndarray) -> tuple[int, int]:
+    coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
