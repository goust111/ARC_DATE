+def apply_rays(base: np.ndarray, sources: list[tuple[int, int]], left_red: tuple[int, int]) -> np.ndarray:
+    out = base.copy()
+    all_red = {left_red}
+    for source in sources:
+        all_red.add(source)
+        for direction in DIRS4:
+            all_red.update(ray_cells(base, source, direction))
