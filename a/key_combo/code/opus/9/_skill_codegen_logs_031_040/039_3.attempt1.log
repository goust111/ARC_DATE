MARKER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]

# Rectangle sizing and placement.
RECT_COUNT, RECT_MIN_ROW = 3, 2
RECT_HEIGHTS = range(2, 8)
RECT_WIDTHS = range(2, 6)
MAX_TOTAL_RECT_AREA = 48
RECT_TOUCH_OFFSET = 1

# Retry limits.
MAX_GENERATION_ATTEMPTS = 300

