+def ray_cells(base: np.ndarray, source: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = source
+    dr, dc = direction
+    rr, cc = r + dr, c + dc
+    cells: list[tuple[int, int]] = []
+    while in_bounds(base.shape, rr, cc) and base[rr, cc] == BLACK:
+        cells.append((rr, cc))
+        rr += dr
+        cc += dc
+    return cells
+
