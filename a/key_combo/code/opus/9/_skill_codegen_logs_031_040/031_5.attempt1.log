+def _covers_bbox(cells: tuple[tuple[int, int], ...], h: int, w: int) -> bool:
+    rows = {r for r, _ in cells}
+    cols = {c for _, c in cells}
+    return 0 in rows and h - 1 in rows and 0 in cols and w - 1 in cols
