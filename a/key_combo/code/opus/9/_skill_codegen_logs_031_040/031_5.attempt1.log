        if ok:
            g[:, :] = temp
            return True
    return False


def _gen_integer_parts(total: int, count: int, minimum: int) -> list[tuple[int, ...]]:
    if count == 0:
        return [()] if total == 0 else []
    out = []
    max_first = total - minimum * (count - 1)
