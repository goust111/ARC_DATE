+        return False
+    coord_set = {tuple(map(int, pt)) for pt in coords}
+    if len(coord_set) != 2 * (h + w) - 4:
+        return False
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            on_border = r in (r0, r1) or c in (c0, c1)
+            if on_border != ((r, c) in coord_set):
