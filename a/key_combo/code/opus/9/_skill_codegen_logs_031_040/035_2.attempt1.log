+                rect_w = int(np.random.randint(RECT_MIN_SIDE, region_w + 1))
+                top = int(np.random.randint(0, region_h - rect_h + 1))
+                left = int(np.random.randint(0, region_w - rect_w + 1))
+                metas.append(
