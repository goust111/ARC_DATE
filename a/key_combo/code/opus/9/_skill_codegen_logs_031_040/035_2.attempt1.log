+                        "region_slice": (rs, re, cs, ce),
+                        "rect_local": (top, left, top + rect_h - 1, left + rect_w - 1),
+                        "bbox_global": (rs + top, cs + left, rs + top + rect_h - 1, cs + left + rect_w - 1),
+                        "area": int(rect_h * rect_w),
+                        "perimeter": int(2 * (rect_h + rect_w) - 4),
