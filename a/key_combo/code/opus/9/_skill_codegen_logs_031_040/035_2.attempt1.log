+    intervals: list[tuple[int, int]] = []
+    i = 0
+    n = int(is_divider.shape[0])
+    while i < n:
+        if bool(is_divider[i]):
+            i += 1
+            continue
+        j = i
+        while j < n and not bool(is_divider[j]):
+            j += 1
+        intervals.append((i, j))
+        i = j
+    return intervals
+
