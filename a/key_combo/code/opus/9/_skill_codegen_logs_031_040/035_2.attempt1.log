+def _is_chain_like(components: list[np.ndarray]) -> bool:
+    if len(components) < 3:
+        return False
+    graph = _overlap_graph(components)
+    seen = {0}
+    stack = [0]
+    while stack:
+        cur = stack.pop()
+        for nxt in graph[cur]:
