+from __future__ import annotations
+
+import random
+from typing import Literal
+
+import numpy as np
+
+
+BG = 0
+SEP = 5
+WORK_TOP = 2
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_H_RANGE = (15, 19)
+GRID_W_RANGE = (15, 19)
+PALETTE_LEN_RANGE = (4, 7)
+SEED_COUNT_RANGE = (2, 4)
+EXTRA_OBS_RANGE = (6, 12)
+MIN_FALL = 2
+GEN_ATTEMPTS = 600
