        remaining_cells = [cell for cell in remaining_cells if cell not in chosen]

    return assignments


def _gen_base_grid(marker_color: int) -> np.ndarray:
    grid = np.full(_GEN_SHAPE, _GEN_BG, dtype=int)
    for r, c in _GEN_BRACKET_CELLS:
