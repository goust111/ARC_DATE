+    if not np.array_equal(out1, out2):
+        return False
+
+    wrong = _wrong_stride_output(grid)
+    if np.array_equal(out1, wrong):
+        return False
+    if np.array_equal(out1, grid):
+        return False
+    return True
+
+
+def _build_grid(
+    H: int,
+    W: int,
+    square_specs: list[tuple[int, bool]],
+    distractor_count: int,
