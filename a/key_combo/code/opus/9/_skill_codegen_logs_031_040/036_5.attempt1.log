+def _count_components4(mask: np.ndarray) -> int:
+    """Count 4-connected True components in a small boolean mask."""
+    mask = np.asarray(mask, dtype=bool)
+    seen = np.zeros_like(mask, dtype=bool)
+    count = 0
+    for r in range(mask.shape[0]):
