+def _marker_cells(bbox: tuple[int, int, int, int], side: str, count: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        cells = [(r0 - 1, c) for c in range(c0, c1 + 1)]
+    elif side == "bottom":
+        cells = [(r1 + 1, c) for c in range(c0, c1 + 1)]
+    elif side == "left":
+        cells = [(r, c0 - 1) for r in range(r0, r1 + 1)]
+    elif side == "right":
