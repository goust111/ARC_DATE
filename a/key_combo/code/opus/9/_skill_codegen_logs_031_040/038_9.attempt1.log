+    global _GEN_CALL_COUNT
+    while True:
+        base = ["right", "bottom", "left", "top"]
+        side = base[_GEN_CALL_COUNT % len(base)]
+        _GEN_CALL_COUNT += 1
+        yield side
+
+
+_SIDE_STREAM = _side_cycle()
+
