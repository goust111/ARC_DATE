+
+        compressed_first = _compress(raw_crop)
+        if _matching_rotations(compressed_first, target_layout, marker_colors):
+            return False
+    except Exception:
+        return False
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    built = _make_core()
+    if built is None:
+        return None
