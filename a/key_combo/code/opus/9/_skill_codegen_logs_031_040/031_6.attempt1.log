+    grid[rr : rr + raw_crop.shape[0], rc : rc + raw_crop.shape[1]] = raw_crop
+    _place_markers(grid, ext_origin, target_layout)
+
+    if not _validate_instance(grid, core, marker_colors, target_layout, raw_crop):
+        return None
+    return grid
