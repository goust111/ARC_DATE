+        points[int(color)] = (int(locs[0, 0]), int(locs[0, 1]))
+    return points
+
+
+def _matching_rotations(
+    crop: np.ndarray, target_layout: dict[int, tuple[int, int]], colors: list[int]
+) -> list[int]:
+    matches: list[int] = []
+    for k in range(4):
