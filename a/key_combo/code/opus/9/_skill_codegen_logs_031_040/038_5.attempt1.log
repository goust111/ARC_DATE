+        assert len(anchor_cells) == 1, "each sprite must contain exactly one anchor"
+        anchor_r, anchor_c = map(int, anchor_cells[0])
+        shape = frozenset((int(r - anchor_r), int(c - anchor_c)) for r, c in coords)
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        sprites.append(
