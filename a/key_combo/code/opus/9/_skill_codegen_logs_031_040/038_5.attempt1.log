+    mask = np.zeros_like(grid, dtype=bool)
+    mask[:stripe_row] = np.isin(grid[:stripe_row], [SPRITE, ANCHOR])
+    comps = _components(mask)
+    assert 3 <= len(comps) <= 4, "expected 3-4 sprites"
