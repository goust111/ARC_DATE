    grid = np.full((_GEN_GRID_SIZE, _GEN_GRID_SIZE), _GEN_BG, dtype=int)
    grid[-1, :] = _GEN_STRIPE
    for mask, top, c0, area, color in objects:
        _gen_paste_shape(grid, mask, top + shift_down * area, c0, color)
