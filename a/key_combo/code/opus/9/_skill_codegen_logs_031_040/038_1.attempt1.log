+    for seg in segments:
+        coords = seg["coords"]
+        safe = int(np.sum(~forbidden[coords[:, 0], coords[:, 1]]))
+        covered = int(seg["length"] - safe)
+        seg["safe_length"] = safe
+        seg["covered_count"] = covered
+        safe_lengths.append(safe)
+        covered_counts.append(covered)
