+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BACKGROUND = 0
+STRIPE = 1
+OBSTACLE = 7
+SEGMENT_COLORS = (2, 3, 4, 5, 6, 9)
+
+MIN_SEGMENTS = 4
+MAX_SEGMENTS = 5
+MIN_OBSTACLES = 2
+MAX_OBSTACLES = 3
+MIN_HEIGHT = 14
+MAX_HEIGHT = 18
+MIN_WIDTH = 13
+MAX_WIDTH = 18
+MIN_LENGTH = 3
+MAX_LENGTH = 8
+MAX_GENERATION_ATTEMPTS = 500
