+    candidates = _candidate_obstacles(grid, segments)
+    if len(candidates) < n_obstacles:
+        return None
+
+    for _ in range(250):
+        chosen = []
+        for cand in candidates:
+            if all(_chebyshev(cand["pos"], prev["pos"]) >= 3 for prev in chosen):
+                chosen.append(cand)
+                if len(chosen) == n_obstacles:
