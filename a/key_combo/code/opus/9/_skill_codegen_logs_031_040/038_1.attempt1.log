spec:
  grid: 8x8 [observed]
  background: 7
  stripe:
    position: last row (row h-1), full-width, single solid color
    color: 8 [observed]; any non-bg color works per solver
  objects:
    count: 2-4 monochrome 4-connected components above the stripe
    colors: each object has a distinct color, different from bg and stripe color
    placement: every object rests with its bottom edge on row h-2 (directly above stripe)
    column_disjoint: no two objects share any column (guarantees no post-move overlap)
    column_gap: >=1 empty column between adjacent objects
    height: 1-3 rows
    area: 1-6 pixels; constrained by area <= (h-2) - (height-1) so displaced shape stays on grid
    shape: arbitrary 4-connected within bbox; no symmetry required
  empty_space: all cells above the topmost object pixel are background
  rule: each object moves straight up by exactly its area (pixel count); stripe unchanged

generation_strategy:
