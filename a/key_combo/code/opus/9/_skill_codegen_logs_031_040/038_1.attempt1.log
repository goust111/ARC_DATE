+import numpy as np
+
+
+BACKGROUND = 0
+STRIPE = 1
+OBSTACLE = 7
+SEGMENT_COLORS = (2, 3, 4, 5, 6, 9)
+
+MIN_SEGMENTS = 4
+MAX_SEGMENTS = 5
+MIN_OBSTACLES = 2
+MAX_OBSTACLES = 3
