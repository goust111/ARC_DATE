+def _sample_spaced_rows(lo: int, hi: int, count: int, min_gap: int) -> list[int]:
+    usable = hi - lo + 1 - (min_gap - 1) * (count - 1)
+    assert usable >= count
+    base = sorted(random.sample(range(usable), count))
+    return [lo + base[i] + i * (min_gap - 1) for i in range(count)]
+
