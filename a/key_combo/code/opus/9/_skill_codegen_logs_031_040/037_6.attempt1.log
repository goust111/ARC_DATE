+        _paste(grid, repeat_obj["sprite"], rep_pos[0], rep_pos[1])
+        _paste(grid, normal_obj["sprite"], tgt_pos[0], tgt_pos[1])
+        placed.extend([rep_box, tgt_box])
+        pairs.append(
