+def _corridor_box(rep_box: tuple[int, int, int, int], tgt_box: tuple[int, int, int, int], direction: str) -> tuple[int, int, int, int]:
+    rr0, rc0, rr1, rc1 = rep_box
+    tr0, tc0, tr1, tc1 = tgt_box
