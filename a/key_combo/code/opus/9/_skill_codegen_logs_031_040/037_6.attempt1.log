+def _decode_direction_and_depth(pos: tuple[int, int], shape: tuple[int, int]) -> tuple[str, int]:
+    r, c = pos
+    h, w = shape
+    top = 2 * r <= h - 1
+    left = 2 * c <= w - 1
+    if top and left:
+        return "up", r + 1
+    if top and not left:
+        return "right", w - c
+    if not top and not left:
+        return "down", h - r
+    return "left", c + 1
