+def _recolor_interior(interior: np.ndarray, direction: str, depth: int, color: int) -> np.ndarray:
+    out = interior.copy()
+    h, w = out.shape
+    depth = int(depth)
+    if direction in {"up", "down"}:
+        depth = min(depth, h)
+        rows = slice(0, depth) if direction == "up" else slice(h - depth, h)
