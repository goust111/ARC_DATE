+        return tr1 + 1, max(rc0, tc0), rr0 - 1, min(rc1, tc1)
+    if direction == "down":
+        return rr1 + 1, max(rc0, tc0), tr0 - 1, min(rc1, tc1)
+    if direction == "left":
+        return max(rr0, tr0), tc1 + 1, min(rr1, tr1), rc0 - 1
+    return max(rr0, tr0), rc1 + 1, min(rr1, tr1), tc0 - 1
+
