+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRS = ("up", "right", "down", "left")
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop(g: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return g[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _ring_area(h: int, w: int) -> int:
+    return 2 * (h + w) - 4
+
+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    comps = _components(grid == GREY)
+    objects = []
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4:
+            continue
+        sprite = _crop(grid, (r0, c0, r1, c1))
+        border = np.zeros_like(sprite, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if int(np.count_nonzero(sprite == GREY)) != _ring_area(h, w):
+            continue
+        if not np.all(sprite[border] == GREY):
+            continue
+        interior = sprite[1:-1, 1:-1].copy()
+        objects.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "sprite": sprite,
+                "interior": interior,
+            }
+        )
+    objects.sort(key=lambda obj: obj["bbox"])
+    return objects
+
+
+def _repeat_axis(interior: np.ndarray) -> str | None:
+    h, w = interior.shape
+    axes: list[str] = []
+    if w >= 2:
+        half = w // 2
+        if half > 0 and np.array_equal(interior[:, :half], interior[:, w - half :]):
+            axes.append("lr")
+    if h >= 2:
+        half = h // 2
+        if half > 0 and np.array_equal(interior[:half, :], interior[h - half :, :]):
+            axes.append("ud")
+    if len(axes) == 1:
+        return axes[0]
+    return None
+
+
+def _first_half(interior: np.ndarray, axis: str) -> np.ndarray:
+    h, w = interior.shape
+    if axis == "lr":
+        return interior[:, : w // 2].copy()
+    return interior[: h // 2, :].copy()
+
