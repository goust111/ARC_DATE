+def _repeat_axis(interior: np.ndarray) -> str | None:
+    h, w = interior.shape
+    axes: list[str] = []
+    if w >= 2:
+        half = w // 2
+        if half > 0 and np.array_equal(interior[:, :half], interior[:, w - half :]):
+            axes.append("lr")
+    if h >= 2:
+        half = h // 2
+        if half > 0 and np.array_equal(interior[:half, :], interior[h - half :, :]):
+            axes.append("ud")
+    if len(axes) == 1:
+        return axes[0]
+    return None
