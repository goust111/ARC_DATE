spec:
  task: extract the single repeated tile from a grid made of two identical adjacent copies
  tile:
    rows: 2-5
    cols: 2-5
    colors: 3-4 distinct non-black colors (no color 0)
    not_self_duplicable: tile must NOT have equal top/bottom halves AND must NOT have equal left/right halves (ensures exactly one valid split axis on the input)
  input:
    construction: tile duplicated once, either horizontally (side-by-side) or vertically (top-to-bottom)
    horizontal: H rows x 2W cols (tile cols W is even or odd)
    vertical: 2H rows x W cols (tile rows H is even or odd)
    exactly_one_split: only one axis yields identical halves (guaranteed by not_self_duplicable constraint)
  output: the tile itself (first half along the unique split axis)

generation_strategy:
