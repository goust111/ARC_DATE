+    seen = np.zeros((h, w), dtype=bool)
+    dirs = DIR4 if connectivity == 4 else DIR8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
