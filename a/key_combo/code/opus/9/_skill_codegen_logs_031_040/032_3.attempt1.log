+    def rec(remaining: int, slots: int, acc: list[int]) -> None:
+        if slots == 0:
+            if remaining == 0:
+                out.append(tuple(acc))
+            return
+        lo = max(1, remaining - 4 * (slots - 1))
+        hi = min(4, remaining - (slots - 1))
+        for value in range(lo, hi + 1):
