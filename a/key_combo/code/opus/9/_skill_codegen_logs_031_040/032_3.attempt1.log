+
+def _components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dirs = DIR4 if connectivity == 4 else DIR8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _grow_polyomino(size: int) -> np.ndarray:
+    cells = {(0, 0)}
+    frontier = {(1, 0), (-1, 0), (0, 1), (0, -1)}
+    while len(cells) < size:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
+        cells.add(cell)
+        r, c = cell
+        for dr, dc in DIR4:
+            nxt = (r + dr, c + dc)
+            if nxt not in cells:
+                frontier.add(nxt)
+
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    norm = sorted((r - min_r, c - min_c) for r, c in cells)
+    return np.array(norm, dtype=int)
+
+
+def _choose_bar_colors(count: int) -> list[int]:
+    colors = list(BAR_COLORS)
+    if count == 4:
+        chosen = colors
+    elif random.random() < 0.7:
+        chosen = [YELLOW] + random.sample([c for c in colors if c != YELLOW], count - 1)
+    else:
+        chosen = random.sample(colors, count)
+    random.shuffle(chosen)
+    return chosen
+
