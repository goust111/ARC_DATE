+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+USABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            parts.append(coords)
+    return parts
+
+
+def _coords_bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = box
+    out[r0, c0 : c1 + 1] = True
+    out[r1, c0 : c1 + 1] = True
+    out[r0 : r1 + 1, c0] = True
+    out[r0 : r1 + 1, c1] = True
+    return out
+
+
+def _find_frame_and_inner_colors(
+    grid: np.ndarray,
+) -> tuple[int, int, tuple[int, int, int, int]]:
+    colors = sorted(int(x) for x in np.unique(grid) if int(x) not in (BLACK, GREY))
+    assert len(colors) == 2, "expected exactly two non-black non-grey colors"
+
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for color in colors:
+        mask = grid == color
+        box = _bbox(mask)
+        if box is None:
+            continue
+        r0, c0, r1, c1 = box
+        if r1 - r0 < 2 or c1 - c0 < 2:
