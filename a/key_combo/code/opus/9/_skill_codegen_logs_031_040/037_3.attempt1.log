+        cell = (axis, c0 - 1) if side == "left" else (axis, c1 + 1)
+        if cell in used_leaf_cells:
+            return None
+        used_leaf_cells.add(cell)
+        leaves.append(cell)
+
+    return v_axes, h_axes, assignments, leaves
