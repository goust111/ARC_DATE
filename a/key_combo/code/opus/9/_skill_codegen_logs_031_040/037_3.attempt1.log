) -> np.ndarray:
    r1 = r0 + rect_h - 1
    c1 = c0 + rect_w - 1
    out = np.zeros((height, width), dtype=int)

    out[r0 : r1 + 1, c0 : c1 + 1] = outer_color
    out[r0 + FRAME_WIDTH : r1 - FRAME_WIDTH + 1, c0 + FRAME_WIDTH : c1 - FRAME_WIDTH + 1] = inner_color

