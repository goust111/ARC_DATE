        out[r0 : r1 + 1, col] = outer_color
        out[r1 + 1 :, col] = inner_color

    for row in selected_rows:
        out[row, :c0] = inner_color
        out[row, c0 : c1 + 1] = outer_color
        out[row, c1 + 1 :] = inner_color

    return out


