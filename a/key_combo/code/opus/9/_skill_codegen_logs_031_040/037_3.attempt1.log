+
+def _sample_axes_for_regions(
+    frame_box: tuple[int, int, int, int],
+    region_boxes: list[tuple[int, int, int, int]],
+) -> tuple[list[int], list[int], list[tuple[str, int]], list[tuple[int, int]]] | None:
+    r0, c0, r1, c1 = frame_box
