+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp: list[tuple[int, int]] = []
+            stack = [(r, c)]
+            seen[r, c] = True
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _normalize_coords(coords: list[tuple[int, int]]) -> tuple[tuple[tuple[int, int], ...], tuple[int, int, int, int]]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    r0, r1 = min(rs), max(rs)
+    c0, c1 = min(cs), max(cs)
+    rel = tuple(sorted((r - r0, c - c0) for r, c in coords))
+    return rel, (r0, c0, r1, c1)
+
+
+def _shape_mask(rel: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = max(r for r, _ in rel) + 1
+    w = max(c for _, c in rel) + 1
+    mask = np.zeros((h, w), dtype=int)
+    for r, c in rel:
+        mask[r, c] = 1
+    return mask
