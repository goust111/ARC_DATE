+        spec_a["marker"] = _marker_position(_sprite_bbox(spec_a), dir_a)
+        spec_b = {"color": color_b, "shape": rel_b, "origin": (r0_b, c0_b), "size": (hb, wb), "direction": dir_b}
+        spec_b["marker"] = _marker_position(_sprite_bbox(spec_b), dir_b)
