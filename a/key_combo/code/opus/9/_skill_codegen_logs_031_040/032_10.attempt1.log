+        checked = _validate_specs(shape, [spec_a, spec_b, {
+            "color": 8,
+            "shape": ((0, 0), (0, 1), (1, 0)),
+            "origin": (2, 0),
+            "size": (2, 2),
+            "direction": "down",
+            "marker": (4, 1),
+        }], require_zero=False)
+        if checked is None:
+            continue
+
+        if spec_a["origin"][1] == spec_b["origin"][1]:
+            continue
+
+        _, counts = checked
+        if counts[0] <= 0 or counts[1] <= 0:
+            continue
