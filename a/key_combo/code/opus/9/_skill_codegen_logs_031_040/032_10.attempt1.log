+
+
+def _random_spec(shape: tuple[int, int], color: int, used_shapes: set[tuple[tuple[int, int], ...]]) -> dict:
+    rel = _sample_shape(used_shapes, rich=None)
+    hh, ww = _bbox_dims(rel)
