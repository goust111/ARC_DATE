+    out: set[tuple[int, int]] = set()
+    k = 0
+    while True:
+        placed = [(r0 + r + dr * k, c0 + c + dc * k) for r, c in spec["shape"]]
+        if any(r < 1 or r >= h or c < 0 or c >= w for r, c in placed):
