+                return True
+    return False
+
+
+def _spec_valid_in_bounds(spec: dict, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = _sprite_bbox(spec)
+    mr, mc = spec["marker"]
+    return 1 <= r0 <= r1 < h and 0 <= c0 <= c1 < w and 1 <= mr < h and 0 <= mc < w
