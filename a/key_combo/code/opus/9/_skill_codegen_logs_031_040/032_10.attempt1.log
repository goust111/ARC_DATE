+        return None
+    return inp, counts
+
+
+def _pair_spec(
+    shape: tuple[int, int],
+    color_a: int,
+    color_b: int,
+    used_shapes: set[tuple[tuple[int, int], ...]],
+) -> list[dict] | None:
