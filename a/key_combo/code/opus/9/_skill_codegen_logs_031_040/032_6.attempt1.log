+def _attempt_generate() -> np.ndarray | None:
+    h = random.randint(_GRID_MIN, _GRID_MAX)
+    w = random.randint(_GRID_MIN, _GRID_MAX)
+    shape = random.choice(_BBOX_CHOICES)
