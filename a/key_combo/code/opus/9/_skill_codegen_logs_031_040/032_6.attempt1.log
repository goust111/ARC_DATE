+def _place_sprites(h: int, w: int, shape: tuple[int, int], colors: list[int], counts: dict[int, int]) -> list[dict] | None:
+    bh, bw = shape
+    positions = [
+        (r0, c0)
+        for r0 in range(_EDGE_GAP, h - bh - _EDGE_GAP + 1)
+        for c0 in range(_EDGE_GAP, w - bw - _EDGE_GAP + 1)
