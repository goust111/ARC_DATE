+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r + dr, c + dc) for dr, dc in _DIR4]
+
+
+def _bbox(coords: list[Coord]) -> BBox:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _bbox_shape(b: BBox) -> tuple[int, int]:
+    r0, c0, r1, c1 = b
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _bbox_distance_to_point(b: BBox, cell: Coord) -> int:
+    r0, c0, r1, c1 = b
+    r, c = cell
+    dr = 0 if r0 <= r <= r1 else min(abs(r - r0), abs(r - r1))
+    dc = 0 if c0 <= c <= c1 else min(abs(c - c0), abs(c - c1))
+    return int(dr + dc)
+
+
+def _find_components(grid: np.ndarray, bg: int | None = None) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    if bg is None:
+        bg = _get_bg(g)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords.sort()
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": len(coords),
+                }
+            )
+    comps.sort(key=lambda comp: (int(comp["color"]), comp["bbox"], comp["coords"]))
+    return comps
+
+
+def _mask_in_bbox(coords: list[Coord], bbox: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in coords:
+        mask[r - r0, c - c0] = True
+    return mask
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
