+        if len(same_color_hits) != 1 or same_color_hits[0]["bbox"] != sprite["bbox"]:
+            continue
+        record = dict(info)
+        record["cell"] = cell
+        out.append(record)
+    random.shuffle(out)
+    return out
+
+
+def _far_single_candidates(grid: np.ndarray, sprites: list[dict], color: int) -> list[Coord]:
+    h, w = grid.shape
+    out: list[Coord] = []
+    for r in range(h):
