+    for bits in itertools.product([0, 1], repeat=total):
+        area = sum(bits)
+        if not (4 <= area <= 8):
+            continue
+        mask = np.array(bits, dtype=bool).reshape(h, w)
+        if not mask[0].any() or not mask[-1].any() or not mask[:, 0].any() or not mask[:, -1].any():
