+                    "rel": (rr, cc),
+                    "bbox_dist": bbox_dist,
+                    "pixel_dist": pixel_dist,
+                    "bbox_only": pixel_dist > bbox_dist,
+                }
+            )
+    random.shuffle(out)
+    return out
+
+
+def _analyze_scene(grid: np.ndarray) -> dict:
