+            continue
+        candidates = _relative_marker_positions(mask)
+        if not candidates or not any(info["bbox_only"] for info in candidates):
+            continue
+        masks.append(mask)
+    _TEMPLATE_CACHE[shape] = [mask.copy() for mask in masks]
+    return [mask.copy() for mask in masks]
