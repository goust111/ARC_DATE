+_GRID_MIN = 16
+_GRID_MAX = 22
+_BBOX_CHOICES = [(2, 3), (3, 2), (3, 3)]
+_COLOR_POOL = list(range(1, 10))
+_EDGE_GAP = 2
+_SPRITE_GAP = 2
+_COUNT_RANGE = (2, 4)
+_GEN_RETRIES = 500
+_TEMPLATE_CACHE: dict[tuple[int, int], list[np.ndarray]] = {}
