+    for r, c in comp:
+        patch[r - r0, c - c0] = int(grid[r, c])
+    return {
+        "anchor": anchor_by_color[marker_color],
+        "marker_color": marker_color,
+        "marker_abs": marker_pos,
+        "marker_rel": (marker_pos[0] - r0, marker_pos[1] - c0),
+        "bbox": (r0, c0, r1, c1),
