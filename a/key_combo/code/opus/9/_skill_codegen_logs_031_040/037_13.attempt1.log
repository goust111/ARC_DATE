+                edge, axis, group, idx = classify_anchor(r, c, h, w)
+                anchors.append(
+                    {
+                        "pos": (r, c),
+                        "color": color,
+                        "edge": edge,
+                        "axis": axis,
+                        "order_key": (group, idx),
+                    }
+                )
+    anchors.sort(key=lambda a: a["order_key"])
+    return anchors
+
