+                    if not valid_patch_tl(shape, patch, input_tl):
+                        continue
+                    input_cells = nonzero_cells(patch, input_tl[0], input_tl[1])
+                    base_cells = nonzero_cells(patch, settled_tl[0], settled_tl[1])
+                    copy_cells = nonzero_cells(flipped, copy_tl[0], copy_tl[1])
+                    input_coords = coord_set(input_cells)
+                    output_coords = coord_set(base_cells) | coord_set(copy_cells)
+                    anchor_block = anchor_neighbor_block(anchor, shape)
+                    if input_coords & input_forbidden:
+                        continue
+                    if output_coords & output_forbidden:
+                        continue
+                    if input_coords & anchor_block:
+                        continue
+                    if output_coords & anchor_block:
