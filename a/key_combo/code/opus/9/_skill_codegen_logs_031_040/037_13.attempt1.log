+    if c == w - 1:
+        return "right", "v", 1, r
+    if r == h - 1 and c not in (0, w - 1):
+        return "bottom", "h", 2, c
+    return "left", "v", 3, r
+
+
+def detect_anchors(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    anchors = []
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            color = int(grid[r, c])
+            if color == BG:
+                continue
