+    for idx, (edge, marker_color, body_color, sign) in enumerate(zip(edges, marker_colors, body_colors, signs)):
+        rec = place_record(
+            shape,
+            edge,
+            body_color,
+            marker_color,
+            sign,
+            idx == corner_index,
+            existing_anchors,
+            input_forbidden,
+            output_forbidden,
+        )
