+                        "edge": edge,
+                        "axis": axis,
+                        "anchor": {
+                            "pos": anchor,
+                            "color": marker_color,
+                            "edge": edge,
+                            "axis": axis,
+                            "order_key": classify_anchor(anchor[0], anchor[1], shape[0], shape[1])[2:],
+                        },
+                        "patch": patch,
+                        "copy_patch": flipped,
+                        "marker_rel": marker_rel,
+                        "settled_tl": settled_tl,
+                        "copy_tl": copy_tl,
+                        "input_tl": input_tl,
+                        "sign": sign,
+                        "mag": mag,
