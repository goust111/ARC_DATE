+            if idx == 0:
+                color = matched_colors[int(rng.integers(len(matched_colors)))]
+            else:
+                color = int(rng.choice(SPRITE_COLORS))
+            sprites.append(
+                {
+                    "patch": _sprite_from_shape(shape, color, anchor),
+                    "shape": shape,
+                    "anchor": anchor,
+                    "color": color,
+                    "matched": False,
+                }
