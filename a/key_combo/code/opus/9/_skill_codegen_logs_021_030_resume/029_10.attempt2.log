  "type": "move_along_path",
  "src": "the solid teal rectangular object",
  "path": "cast horizontal rays from each source row and vertical rays from each source column; stop at a blue object or the grid edge",
  "trajectory": "paint every crossed non-blue, non-teal pixel yellow",
  "transform": "preserve the teal source and blue blockers; leave all off-ray pixels unchanged"
}
</annotation>
