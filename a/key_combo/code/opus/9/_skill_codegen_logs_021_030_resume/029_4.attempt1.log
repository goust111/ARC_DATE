  "transform": "extend the same diagonal offsets and periodic color/background gaps through the larger canvas",
  "grid_shape": "input height and width multiplied by 2"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: NxN square, N in 5-12
  background: 0
  band:
    direction: down-right (\) or down-left (/), either is valid
    offsets: centered on main diagonal; band_width 1 or 3 (offsets {0} or {-1,0,1} in canonical down-right form) [observed]
    period: row-repeating period P in 2-4; N >= 2*P required so pattern is learnable
    tile: P x band_width matrix of colors (each cell is a fg color or 0=bg)
    fg_colors: 2-4 distinct non-zero colors; each appears at least once in the tile
    bg_in_tile: 0 to 2 cells in the tile may be bg (gaps in the band) [observed]
    non_trivial: tile rows are not all identical (period is the true minimal period)
  placement: band runs corner-to-corner along one diagonal of the NxN grid; all cells outside the band's diagonal offsets are bg
  output: 2N x 2N grid; same periodic diagonal band extended to fill the larger canvas

generation_strategy:
  approach: output-first
  steps:
    1. Pick N in [5,12], P in [2,4] with N >= 2*P
    2. Pick band_width from {1, 3} and direction from {down-right, down-left}
    3. Choose 2-4 distinct non-zero colors for the tile
    4. Build a P x band_width tile of colors (including possible bg=0 gaps), ensuring the minimal period is exactly P (no shorter sub-period)
    5. Paint the 2N x 2N output by repeating the tile along the chosen diagonal
    6. Crop the top-left NxN quadrant (after canonical flip if direction is down-left) as the input
```
