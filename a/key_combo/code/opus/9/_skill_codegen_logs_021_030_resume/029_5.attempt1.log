+
+def _sample_tie_pattern(
+    h: int,
+    w: int,
+    sources: list[tuple[int, int]],
+    required_holes: set[tuple[int, int]],
+    protected_anchors: set[tuple[int, int]],
+) -> tuple[str, tuple[int, int]] | None:
+    modes = ["horizontal", "vertical"]
+    random.shuffle(modes)
+    for mode in modes:
+        candidates = [
+            (r, c)
+            for r in range(1, h - 1)
+            for c in range(1, w - 1)
+            if _is_isolated((r, c), set(sources))
+        ]
+        random.shuffle(candidates)
+        for r, c in candidates:
+            if mode == "horizontal":
+                holes = {(r, c), (r - 1, c), (r + 1, c)}
+                anchors = {(r, c - 1), (r, c + 1)}
+            else:
+                holes = {(r, c), (r, c - 1), (r, c + 1)}
+                anchors = {(r - 1, c), (r + 1, c)}
+            if not all(0 <= rr < h and 0 <= cc < w for rr, cc in holes | anchors):
+                continue
+            if holes & protected_anchors:
+                continue
+            sources.append((r, c))
+            required_holes.update(holes)
+            protected_anchors.update(anchors)
+            return mode, (r, c)
+    return None
+
+
+def _sample_conflict_pattern(
+    h: int,
+    w: int,
+    sources: list[tuple[int, int]],
+    required_holes: set[tuple[int, int]],
+    protected_anchors: set[tuple[int, int]],
+) -> tuple[str, tuple[int, int]] | None:
+    modes = ["equal", "distance"]
+    random.shuffle(modes)
+    source_set = set(sources)
+    for mode in modes:
+        if mode == "equal":
+            centers = [
+                (r, c)
+                for r in range(1, h - 1)
+                for c in range(2, w - 2)
+            ]
+        else:
+            centers = [
+                (r, c)
+                for r in range(1, h - 1)
+                for c in range(2, w - 4)
+            ]
+        random.shuffle(centers)
+        for r, c in centers:
+            if mode == "equal":
+                srcs = [(r, c - 1), (r, c + 1)]
+                holes = {
+                    (r, c - 2),
+                    (r - 1, c - 1),
+                    (r + 1, c - 1),
+                    (r, c - 1),
+                    (r, c + 1),
+                    (r, c + 2),
+                    (r - 1, c + 1),
+                    (r + 1, c + 1),
+                }
+            else:
+                srcs = [(r, c - 1), (r, c + 2)]
+                holes = {
+                    (r, c - 2),
+                    (r - 1, c - 1),
+                    (r + 1, c - 1),
+                    (r, c - 1),
+                    (r, c + 1),
+                    (r, c + 2),
+                    (r, c + 3),
+                    (r - 1, c + 2),
+                    (r + 1, c + 2),
+                }
+            anchor = (r, c)
+            if not all(0 <= rr < h and 0 <= cc < w for rr, cc in holes | {anchor} | set(srcs)):
+                continue
+            if anchor in required_holes:
+                continue
+            if holes & protected_anchors:
+                continue
+            if any(not _is_isolated(src, source_set) for src in srcs):
+                continue
+            if _chebyshev(srcs[0], srcs[1]) <= 1:
+                continue
+            for src in srcs:
+                if not _is_isolated(src, source_set | (set(srcs) - {src})):
+                    break
+            else:
+                sources.extend(srcs)
+                source_set.update(srcs)
+                required_holes.update(holes)
+                protected_anchors.add(anchor)
+                return mode, anchor
+    return None
+
+
+def _sample_extra_sources(
+    h: int,
+    w: int,
+    count: int,
+    sources: list[tuple[int, int]],
+    required_holes: set[tuple[int, int]],
+    protected_anchors: set[tuple[int, int]],
+) -> bool:
+    source_set = set(sources)
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    for cell in cells:
+        if len(sources) >= count:
+            return True
+        if cell in protected_anchors:
+            continue
+        if not _is_isolated(cell, source_set):
+            continue
+        sources.append(cell)
+        source_set.add(cell)
+        required_holes.add(cell)
+    return len(sources) == count
+
+
+def _assign_required_holes(
+    h: int,
+    w: int,
+    required_holes: set[tuple[int, int]],
+    top_target: int,
+    mid_target: int,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
+    ordered = sorted(required_holes, key=lambda cell: sum(_chebyshev(cell, other) == 1 for other in required_holes), reverse=True)
+
+    def fits(cell: tuple[int, int], chosen: set[tuple[int, int]]) -> bool:
+        return _is_isolated(cell, chosen)
+
+    def search(
+        index: int,
+        top_fg: set[tuple[int, int]],
+        mid_fg: set[tuple[int, int]],
+    ) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
+        if len(top_fg) > top_target or len(mid_fg) > mid_target:
+            return None
+        remaining = len(ordered) - index
+        if len(top_fg) + remaining < min(top_target, len(top_fg) + remaining) and len(mid_fg) + remaining < min(mid_target, len(mid_fg) + remaining):
+            return None
+        if index == len(ordered):
+            return top_fg, mid_fg
+
+        cell = ordered[index]
+        choices = [0, 1]
+        random.shuffle(choices)
+        for side in choices:
+            if side == 0:
+                if fits(cell, top_fg):
+                    out = search(index + 1, top_fg | {cell}, mid_fg)
+                    if out is not None:
+                        return out
+            else:
+                if fits(cell, mid_fg):
+                    out = search(index + 1, top_fg, mid_fg | {cell})
+                    if out is not None:
+                        return out
+        return None
+
+    return search(0, set(), set())
+
+
+def _fill_panel_extras(
+    h: int,
+    w: int,
+    target: int,
+    existing: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    chosen = set(existing)
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    for cell in cells:
+        if len(chosen) >= target:
+            return chosen
+        if cell in forbidden:
+            continue
+        if cell in chosen:
+            continue
+        if not _is_isolated(cell, chosen):
+            continue
+        chosen.add(cell)
+    return chosen if len(chosen) == target else None
+
+
+def _anchors_from_sets(
+    h: int,
+    w: int,
+    top_fg: set[tuple[int, int]],
+    mid_fg: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    anchors = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) not in top_fg and (r, c) not in mid_fg:
+                anchors.append((r, c))
+    return anchors
+
+
+def _build_panels(
+    h: int,
+    w: int,
+    required_holes: set[tuple[int, int]],
+    protected_anchors: set[tuple[int, int]],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
+    top_target = random.randint(*GEN_TOP_COUNT_RANGE)
+    mid_target = random.randint(*GEN_MID_COUNT_RANGE)
+    if len(required_holes) > top_target + mid_target:
+        return None
+
+    assigned = _assign_required_holes(h, w, required_holes, top_target, mid_target)
+    if assigned is None:
+        return None
+    top_fg, mid_fg = assigned
+
+    top_fg = _fill_panel_extras(h, w, top_target, top_fg, protected_anchors)
+    if top_fg is None:
+        return None
+    mid_fg = _fill_panel_extras(h, w, mid_target, mid_fg, protected_anchors)
+    if mid_fg is None:
+        return None
+
+    anchors = _anchors_from_sets(h, w, top_fg, mid_fg)
+    if len(anchors) < 3:
+        return None
+    return top_fg, mid_fg
+
+
+def _render_input(
+    h: int,
+    w: int,
+    top_fg: set[tuple[int, int]],
+    mid_fg: set[tuple[int, int]],
+    sources: list[tuple[int, int]],
+    source_colors: list[int],
+    top_margin: int,
+    bottom_margin: int,
+) -> np.ndarray:
+    total_h = top_margin + h + 1 + h + 1 + h + bottom_margin
+    grid = np.zeros((total_h, w), dtype=int)
+    sep0 = top_margin + h
