+                    (r - 1, c - 1),
+                    (r + 1, c - 1),
+                    (r, c - 1),
+                    (r, c + 1),
+                    (r, c + 2),
+                    (r - 1, c + 1),
+                    (r + 1, c + 1),
+                }
+            else:
+                srcs = [(r, c - 1), (r, c + 2)]
+                holes = {
+                    (r, c - 2),
+                    (r - 1, c - 1),
+                    (r + 1, c - 1),
+                    (r, c - 1),
+                    (r, c + 1),
+                    (r, c + 2),
+                    (r, c + 3),
+                    (r - 1, c + 2),
+                    (r + 1, c + 2),
