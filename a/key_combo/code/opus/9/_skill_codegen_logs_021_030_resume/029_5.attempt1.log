+        if tie is None:
+            return None
+        tie_mode, _ = tie
+        expected_tie = True
+
+    if scenario in {"conflict", "both"}:
+        conflict = _sample_conflict_pattern(h, w, sources, required_holes, protected_anchors)
+        if conflict is None:
+            return None
+        conflict_mode, _ = conflict
