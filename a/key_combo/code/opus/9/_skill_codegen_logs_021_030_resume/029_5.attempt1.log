+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+
+LOWER_COLORS = (GREEN, YELLOW, MAGENTA)
+DIRS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
