+
+    sources: list[tuple[int, int]] = []
+    required_holes: set[tuple[int, int]] = set()
+    protected_anchors: set[tuple[int, int]] = set()
+    expected_tie = False
+    expected_conflict = False
+    tie_mode = None
+    conflict_mode = None
+
+    if scenario in {"tie", "both"}:
