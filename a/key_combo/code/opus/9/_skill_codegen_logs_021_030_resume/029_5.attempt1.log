+    w: int,
+    sources: list[tuple[int, int]],
+    required_holes: set[tuple[int, int]],
+    protected_anchors: set[tuple[int, int]],
+) -> tuple[str, tuple[int, int]] | None:
+    modes = ["horizontal", "vertical"]
+    random.shuffle(modes)
+    for mode in modes:
+        candidates = [
