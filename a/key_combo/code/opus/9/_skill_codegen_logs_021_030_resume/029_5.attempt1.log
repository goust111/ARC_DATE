+    top_fg = _fill_panel_extras(h, w, top_target, top_fg, protected_anchors)
+    if top_fg is None:
+        return None
+    mid_fg = _fill_panel_extras(h, w, mid_target, mid_fg, protected_anchors)
+    if mid_fg is None:
+        return None
