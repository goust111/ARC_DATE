+def _sample_conflict_pattern(
+    h: int,
+    w: int,
+    sources: list[tuple[int, int]],
+    required_holes: set[tuple[int, int]],
+    protected_anchors: set[tuple[int, int]],
+) -> tuple[str, tuple[int, int]] | None:
+    modes = ["equal", "distance"]
+    random.shuffle(modes)
+    source_set = set(sources)
+    for mode in modes:
+        if mode == "equal":
+            centers = [
+                (r, c)
+                for r in range(1, h - 1)
+                for c in range(2, w - 2)
+            ]
+        else:
+            centers = [
+                (r, c)
+                for r in range(1, h - 1)
+                for c in range(2, w - 4)
+            ]
+        random.shuffle(centers)
+        for r, c in centers:
+            if mode == "equal":
+                srcs = [(r, c - 1), (r, c + 1)]
+                holes = {
+                    (r, c - 2),
+                    (r - 1, c - 1),
+                    (r + 1, c - 1),
+                    (r, c - 1),
+                    (r, c + 1),
+                    (r, c + 2),
+                    (r - 1, c + 1),
+                    (r + 1, c + 1),
+                }
+            else:
+                srcs = [(r, c - 1), (r, c + 2)]
+                holes = {
+                    (r, c - 2),
+                    (r - 1, c - 1),
+                    (r + 1, c - 1),
+                    (r, c - 1),
+                    (r, c + 1),
+                    (r, c + 2),
+                    (r, c + 3),
+                    (r - 1, c + 2),
+                    (r + 1, c + 2),
+                }
+            anchor = (r, c)
+            if not all(0 <= rr < h and 0 <= cc < w for rr, cc in holes | {anchor} | set(srcs)):
+                continue
+            if anchor in required_holes:
