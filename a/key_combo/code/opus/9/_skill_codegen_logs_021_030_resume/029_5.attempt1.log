+def _best_anchor(
+    src: dict[str, int], anchors: list[tuple[int, int]]
+) -> tuple[tuple[int, int], int, int]:
+    best_anchor = None
+    best_key = None
+    min_dist = None
+    min_count = 0
+    for anchor in anchors:
+        dist = abs(src["row"] - anchor[0]) + abs(src["col"] - anchor[1])
+        key = (dist, anchor[1], anchor[0])
+        if min_dist is None or dist < min_dist:
