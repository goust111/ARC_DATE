+
+def _fill_panel_extras(
+    h: int,
+    w: int,
+    target: int,
+    existing: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    chosen = set(existing)
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    for cell in cells:
