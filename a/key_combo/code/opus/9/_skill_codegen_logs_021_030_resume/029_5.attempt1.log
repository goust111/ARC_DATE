+) -> tuple[dict[tuple[int, int], dict[str, int]], list[dict[str, object]]]:
+    proposed: list[dict[str, object]] = []
+    for index, src in enumerate(sources):
+        anchor, dist, min_count = _best_anchor(src, anchors)
+        proposed.append(
