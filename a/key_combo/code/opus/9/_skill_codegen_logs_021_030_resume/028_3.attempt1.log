def _gen_apply_notch(cells, h, w, side, depth_limit):
    depth_limit = max(1, int(depth_limit))
    if side in ("top", "bottom"):
        span = random.randint(NOTCH_SPAN[0], min(NOTCH_SPAN[1], w - 3))
