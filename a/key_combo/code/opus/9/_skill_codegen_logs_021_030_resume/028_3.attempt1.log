+    out = np.zeros_like(right_half, dtype=int)
+    both = (left_proj == 1) & (right_half == 1)
+    right_only = (left_proj == 0) & (right_half == 1)
+    left_only = (left_proj == 1) & (right_half == 0)
+    out[both] = 1
+    out[right_only] = 2
+    out[left_only] = 3
+    return out
