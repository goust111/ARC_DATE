+    return {
+        "left_root": left_root,
+        "left_child": left_child,
+        "middle_root": middle_root,
+        "middle_left": middle_left,
+        "middle_right": middle_right,
+        "right_root": right_root,
+        "right_pass": right_pass,
+        "right_center": right_center,
+        "right_left_leaf": right_left_leaf,
