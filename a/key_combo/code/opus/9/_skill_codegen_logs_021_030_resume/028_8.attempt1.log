+    marker_cols = np.flatnonzero(grid[0, :] != BG)
+    for c in marker_cols:
+        if int(out[0, c]) != int(grid[0, c]):
+            return False
+
+    present = set(map(int, np.unique(out)))
+    if not {4, 7, 9}.issubset(present):
+        return False
+
+    if np.array_equal(out, grid):
+        return False
+
+    return True
