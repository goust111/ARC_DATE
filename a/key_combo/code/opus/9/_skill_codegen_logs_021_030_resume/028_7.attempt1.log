+    assert np.all(out[0, :] == container["color"])
+    assert np.all(out[-1, :] == container["color"])
+    assert np.all(out[:, 0] == container["color"])
+    assert np.all(out[:, -1] == container["color"])
+    assert np.array_equal(out[1:-1, 1:-1], expected_interior)
