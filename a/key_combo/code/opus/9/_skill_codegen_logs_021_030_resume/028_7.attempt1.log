+    source_interior = _inner_patch(g, source)
+    pattern_bbox = _bbox(source_interior == PATTERN_COLOR)
+    assert pattern_bbox is not None
+    pr0, pc0, pr1, pc1 = pattern_bbox
+    assert 0 <= pr0 <= pr1 < sh and 0 <= pc0 <= pc1 < sw
