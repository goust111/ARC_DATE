+def _choose_shape(max_h: int, max_w: int, *, prefer_smaller: bool, prefer_holey: bool) -> tuple[tuple[int, int], ...]:
+    candidates = [shape for shape in SHAPES if _shape_dims(shape)[0] <= max_h and _shape_dims(shape)[1] <= max_w]
