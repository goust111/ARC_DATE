0061:         m = mask_from_coords(rel_coords, patch.shape)
0062:         pat = np.full_like(patch, bg)
0063:         pat[m] = patch[m]
0064: 
0065:         extracted.append(
0066:             {
0067:                 "c0": int(c0),
0068:                 "pat": pat,
0069:                 "shape_key": canonical_shape_key(m),
0070:             }
0071:         )
0072: 
0073:     freq = Counter(d["shape_key"] for d in extracted)
0074:     out = np.full((H, W), int(bg), dtype=int)
