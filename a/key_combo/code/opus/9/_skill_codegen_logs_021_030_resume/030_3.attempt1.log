+def _sample_partition(total: int, parts: int) -> list[int]:
+    cuts = sorted(_RNG.sample(range(1, total), parts - 1))
+    points = [0, *cuts, total]
+    return [points[i + 1] - points[i] for i in range(parts)]
+
