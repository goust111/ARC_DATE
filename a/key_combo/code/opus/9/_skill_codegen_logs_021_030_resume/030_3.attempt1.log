  "transform": "recolor each interior cell to the shared label color when its row label equals its column label; otherwise leave it background; keep the border labels unchanged",
  "symbol_instructions": "the right edge gives the row color sequence and the bottom edge gives the column color sequence"
}
</annotation>
<generation_spec>
