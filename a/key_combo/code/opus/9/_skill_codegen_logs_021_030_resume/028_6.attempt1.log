+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ORTH_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _expand_markers(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    markers = np.argwhere(out == BLUE)
+    for r, c in markers:
+        for rr in range(max(0, int(r) - 1), min(out.shape[0], int(r) + 2)):
+            for cc in range(max(0, int(c) - 1), min(out.shape[1], int(c) + 2)):
+                if int(out[rr, cc]) == BLACK:
+                    out[rr, cc] = BLUE
+    return out
+
