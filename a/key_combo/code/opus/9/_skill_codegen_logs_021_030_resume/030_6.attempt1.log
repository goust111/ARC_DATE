+            c0 = rng.randint(1, canvas_w - patch_w - 1)
+            box = (r0, c0, r0 + patch_h - 1, c0 + patch_w - 1)
+            if any(_rectangles_overlap(box, other, pad=1) for other in occupied):
+                continue
+            found = (r0, c0)
+            occupied.append(box)
+            break
