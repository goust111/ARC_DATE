+        candidates.append(3)
+    tile_w = rng.choice(candidates)
+    while True:
+        tile = np.zeros((2, tile_w), dtype=int)
+        fill_colors = rng.sample(NON_FRAME_COLORS, k=rng.randint(2, min(4, len(NON_FRAME_COLORS))))
