+
+
+def _choose_control_layout(rng: random.Random, count: int) -> tuple[int, int]:
+    if count == 4:
+        return rng.choice([(2, 2), (1, 4), (4, 1)])
+    if count == 5:
+        return rng.choice([(1, 5), (5, 1)])
+    if count == 6:
