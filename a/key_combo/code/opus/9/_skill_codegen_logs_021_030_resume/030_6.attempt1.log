+        if _touches_edge(coords, height, width):
+            continue
+        box = _bbox(coords)
+        r0, c0, r1, c1 = box
+        if coords.shape[0] != (r1 - r0 + 1) * (c1 - c0 + 1):
+            continue
+        regions.append(
+            {
+                "bbox": box,
+                "window": grid[r0 : r1 + 1, c0 : c1 + 1].copy(),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return regions
+
