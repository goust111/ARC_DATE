+    if len(ctrl_regions) != main_count:
+        return None
+    absolute_ctrl_boxes = []
+    for region in ctrl_regions:
+        r0, c0, r1, c1 = region["bbox"]
+        absolute_ctrl_boxes.append((ctrl_r + r0, ctrl_c + c0, ctrl_r + r1, ctrl_c + c1))
