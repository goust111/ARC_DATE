+
+
+def _assemble_example(rng: random.Random) -> tuple[np.ndarray, np.ndarray, dict] | None:
+    main_count = rng.choice([4, 4, 5, 5, 6])
+    mode_order = ["empty", "selective", "preserve_only"]
