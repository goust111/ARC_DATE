+                "output": region_out,
+            }
+            for patch, region_out, (r0, c0) in zip(main_patches, main_outputs, placements[:-1])
+        ],
+        key=_row_major_key,
+    )
+
+    ctrl_regions = sorted(
+        _enclosed_regions(grid[ctrl_r : ctrl_r + control_patch.shape[0], ctrl_c : ctrl_c + control_patch.shape[1]]),
