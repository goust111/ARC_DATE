+        if coords.shape[0] != (r1 - r0 + 1) * (c1 - c0 + 1):
+            continue
+        regions.append(
+            {
+                "bbox": box,
+                "window": grid[r0 : r1 + 1, c0 : c1 + 1].copy(),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return regions
+
