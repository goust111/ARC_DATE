+    elif mode == "selective":
+        noise_count = 2
+        r0, c0 = positions[0]
+        control_color = _pick_wrong_color(rng, int(clean[r0, c0]), allow_black=False)
+        damaged[r0, c0] = control_color
+        r1, c1 = positions[1]
+        other = _pick_wrong_color(rng, int(clean[r1, c1]), allow_black=True)
+        if other == control_color:
