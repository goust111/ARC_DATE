+
+
+def _assemble_grid(cell_h: int, cell_w: int, cells: list[np.ndarray]) -> np.ndarray:
+    grid_h = 3 * cell_h + 2
+    grid_w = 3 * cell_w + 2
+    grid = np.full((grid_h, grid_w), GREY, dtype=int)
