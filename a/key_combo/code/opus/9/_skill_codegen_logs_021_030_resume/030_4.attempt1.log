+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    sizes = [int(v) for v in rng.choice(np.array([3, 4, 5, 6], dtype=int), size=3, replace=False)]
+    shapes: dict[str, tuple[tuple[int, int], ...]] = {}
