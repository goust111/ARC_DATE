+        while len(coords) < size:
+            base = tuple(int(v) for v in rng.choice(np.array(list(coords), dtype=int)))
+            dr, dc = DIR4[int(rng.integers(0, len(DIR4)))]
+            coords.add((base[0] + dr, base[1] + dc))
