  grid:
    panel_rows: 3 [observed, solver requires >=2]
    panel_cols: 3-4
    panel_size: 5-7, always square (NxN, N>=5)
    input_size: (R*(N+1)+1) rows x (C*(N+1)+1) cols, with bg separator rows/cols
  colors:
    bg: any single color (always 8 [observed]); most-common in grid
    border: single uniform color for all panel frames, distinct from bg
    mask: single color used in all template interiors, distinct from bg/border
    row_labels: R distinct colors in leftmost column, each constant per panel row, all distinct from bg/border/mask
    swatches: C distinct colors (one per panel column), all solid interiors, disjoint from all above
  structure:
    leftmost_column: col 0 holds row-label color repeated for each panel row height
    panels: R x C grid of framed panels; frame = 1-cell border of border-color; interior = (N-2)x(N-2)
    per_column: exactly 1 solid swatch panel (interior filled with one swatch color) + (R-1) identical mask panels
    mask_panels: interior uses mask-color on bg; fill density 30-70%; 1-2 connected components; each column has a distinct mask pattern
    solid_panel: interior entirely one swatch color (not bg)
  output:
    shape: N rows x (C*N + C-1) cols
    one rebuilt panel per column separated by 1 bg column
    frame_color = row_label of the swatch's row; interior = mask pattern filled with swatch color

generation_strategy:
  approach: output-first
