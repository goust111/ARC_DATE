    assert len(markers) == 1, "expected one marker inside the bracket"

    marker = markers[0]
    marker_color = int(g[marker])
    assert marker_color != bg and marker_color != int(bracket["color"])

    out = g.copy()
    out[out == marker_color] = bg
    out[marker] = marker_color
    return out

