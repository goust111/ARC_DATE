    arc_color = Color.RED if red_arc else Color.TEAL
    other_color = Color.TEAL if red_arc else Color.RED

    for k, (r, c) in enumerate(loop):
        in_arc = (k - i) % len(loop) < (j - i) % len(loop)
        out[r, c] = arc_color if in_arc else other_color


