42:def main(grid: np.ndarray) -> np.ndarray:
43:    """
44:    Paint yellow the background cells on the unobstructed shortest monotone corridor between two doorway frames.
45:
46:    Input structure
47:    - The grid has a background, two small frame objects in one foreground color, and one center marker in each frame.
48:    - Each marker has exactly one background 4-neighbor, the doorway gap; the next cell outward is the exterior doorway cell.
49:
50:    Rule
51:    - Treat all existing foreground cells as blockers.
52:    - Between the two exterior doorway cells, allow only row/column steps that move toward the other exterior cell.
53:    - Paint every background cell that lies on some such path from one exterior cell to the other, plus the two doorway gaps, yellow.
54:
55:    Key insight
56:    - The output is not a single chosen route: it is the union of all shortest monotone paths that can pass between the two frames.
57:    """
58:    g = np.asarray(grid, dtype=int)
59:    bg = get_bg(g)
60:    counts = Counter(map(int, g.ravel()))
61:    fg_colors = [color for color in counts if color != bg]
62:    assert len(fg_colors) == 2
63:
64:    marker_colors = [color for color in fg_colors if counts[color] == 2]
65:    assert len(marker_colors) == 1
66:    marker_color = marker_colors[0]
67:    frame_colors = [color for color in fg_colors if color != marker_color]
68:    assert len(frame_colors) == 1
69:    frame_color = frame_colors[0]
70:
71:    doors: list[tuple[tuple[int, int], tuple[int, int]]] = []
72:    for r0, c0 in zip(*np.where(g == marker_color)):
73:        r, c = int(r0), int(c0)
74:        neighbors = []
75:        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
76:            rr, cc = r + dr, c + dc
77:            assert in_bounds(g.shape, rr, cc)
78:            neighbors.append((int(g[rr, cc]), dr, dc, rr, cc))
79:
80:        gaps = [item for item in neighbors if item[0] == bg]
81:        frame_neighbors = [item for item in neighbors if item[0] == frame_color]
82:        assert len(gaps) == 1
83:        assert len(frame_neighbors) == 3
84:
85:        _, dr, dc, gap_r, gap_c = gaps[0]
86:        ext_r, ext_c = r + 2 * dr, c + 2 * dc
87:        assert in_bounds(g.shape, ext_r, ext_c)
88:        assert g[ext_r, ext_c] == bg
89:        doors.append(((gap_r, gap_c), (ext_r, ext_c)))
90:
91:    assert len(doors) == 2
92:    start = doors[0][1]
93:    end = doors[1][1]
94:    row_step = _sign(end[0] - start[0])
95:    col_step = _sign(end[1] - start[1])
96:    assert row_step != 0 or col_step != 0
97:
98:    moves = []
99:    if row_step:
100:        moves.append((row_step, 0))
101:    if col_step:
102:        moves.append((0, col_step))
103:
104:    r0, r1 = sorted([start[0], end[0]])
105:    c0, c1 = sorted([start[1], end[1]])
106:    bounds = (r0, c0, r1, c1)
107:    forward = _reachable(g, bg, start, moves, bounds)
108:    backward = _reachable(g, bg, end, [(-dr, -dc) for dr, dc in moves], bounds)
109:    path = forward & backward
110:    assert path[start]
111:    assert path[end]
112:
113:    out = g.copy()
114:    out[path] = Color.YELLOW
115:    for gap, _ in doors:
116:        assert g[gap] == bg
117:        out[gap] = Color.YELLOW
118:    return out
