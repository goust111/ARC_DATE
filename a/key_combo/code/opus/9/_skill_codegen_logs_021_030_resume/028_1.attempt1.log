+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+FRAME = 5
+WALL = 9
+
+GEN_ATTEMPTS = 400
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _label_mask(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    label = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] >= 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = label
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] < 0:
+                        labels[nr, nc] = label
+                        q.append((nr, nc))
+            label += 1
+    return labels, label
+
