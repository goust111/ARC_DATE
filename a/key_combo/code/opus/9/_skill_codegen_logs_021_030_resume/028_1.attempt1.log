+    if len(set(signature)) < 2:
+        return None
+    if any(len(group) == 1 for group in groups.values()) and YELLOW not in signature:
+        return None
+    if sum(len(group) > 1 for group in groups.values()) >= 2 and sum(color == BLUE for color in signature) < 2:
