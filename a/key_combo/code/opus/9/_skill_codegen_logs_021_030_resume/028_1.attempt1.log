+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+FRAME = 5
+WALL = 9
+
+GEN_ATTEMPTS = 400
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _label_mask(mask: np.ndarray) -> tuple[np.ndarray, int]:
+    h, w = mask.shape
+    labels = np.full((h, w), -1, dtype=int)
+    label = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] >= 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = label
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] < 0:
+                        labels[nr, nc] = label
+                        q.append((nr, nc))
+            label += 1
+    return labels, label
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    labels, count = _label_mask(grid == color)
+    return [np.argwhere(labels == idx) for idx in range(count)]
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _border_coords(r0: int, c0: int, r1: int, c1: int) -> list[tuple[int, int]]:
+    cells = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _frame_exterior_cells(grid: np.ndarray, frame: dict) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    r0, c0, r1, c1 = frame["bbox"]
+    cells = set()
+    if r0 > 0:
+        for c in range(c0, c1 + 1):
+            if grid[r0 - 1, c] == BG:
+                cells.add((r0 - 1, c))
+    if r1 + 1 < h:
+        for c in range(c0, c1 + 1):
+            if grid[r1 + 1, c] == BG:
+                cells.add((r1 + 1, c))
+    if c0 > 0:
+        for r in range(r0, r1 + 1):
+            if grid[r, c0 - 1] == BG:
+                cells.add((r, c0 - 1))
+    if c1 + 1 < w:
+        for r in range(r0, r1 + 1):
+            if grid[r, c1 + 1] == BG:
+                cells.add((r, c1 + 1))
+    return sorted(cells)
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    frames = []
+    for coords in _components_of_color(grid, FRAME):
+        r0, c0, r1, c1 = _bbox(coords)
