+    ring = np.zeros((height, width), dtype=bool)
+    ring[0, :] = True
+    ring[-1, :] = True
+    ring[:, 0] = True
+    ring[:, -1] = True
+    assert np.array_equal(patch, ring), "each blue object must be a complete 1-pixel rectangular frame"
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "height": height,
+        "width": width,
+        "area": height * width,
+        "center_r2": r0 + r1,
+        "center_c2": c0 + c1,
