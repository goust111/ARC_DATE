+
+BLACK = 0
+BLUE = 1
+DEPTH_TO_COLOR = {0: 2, 1: 3, 2: 4, 3: 5}
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_GENERATION_ATTEMPTS = 500
