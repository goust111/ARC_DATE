+
+def _build_two_roots_four(rng: np.random.Generator) -> list[tuple[int, int, int, int]]:
+    child1_size = _rand_hw(rng, 3, 5, 3, 5)
+    child2_size = _rand_hw(rng, 3, 5, 3, 5)
