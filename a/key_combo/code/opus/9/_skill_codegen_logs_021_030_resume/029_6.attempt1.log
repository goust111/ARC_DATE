+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components of a boolean mask as coordinate arrays."""
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _frame_from_coords(grid: np.ndarray, coords: np.ndarray) -> dict:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    r0, c0, r1, c1 = map(int, (r0, c0, r1, c1))
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    assert height >= 3 and width >= 3, "frames must be at least 3x3"
+
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    ring = np.zeros((height, width), dtype=bool)
+    ring[0, :] = True
+    ring[-1, :] = True
+    ring[:, 0] = True
+    ring[:, -1] = True
+    assert np.array_equal(patch == BLUE, ring), "each blue object must be a complete 1-pixel rectangular frame"
+
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "height": height,
+        "width": width,
+        "area": height * width,
+        "center_r2": r0 + r1,
+        "center_c2": c0 + c1,
+    }
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
