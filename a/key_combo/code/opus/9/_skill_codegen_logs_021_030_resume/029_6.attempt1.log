+    root2 = (
+        canvas_h - root2_size[0] - 1,
+        canvas_w - root2_size[1] - 1,
+        canvas_h - 2,
+        canvas_w - 2,
+    )
+    child1 = _place_child(rng, root1, child1_size, "tr")
+    child2 = _place_child(rng, root2, child2_size, "bl")
