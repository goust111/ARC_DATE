+
+def _build_left_region(
+    template: tuple[tuple[int, int], ...],
+    height: int,
+) -> np.ndarray | None:
+    th, tw = _shape_dims(template)
+    left_w = random.randint(max(6, tw + 2), max(8, tw + 3))
+    if left_w > 10 or height < th + 2:
+        return None
+
+    region = np.zeros((height, left_w), dtype=int)
