+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+SEP = 5
+MAGENTA = 6
+CYAN = 8
+
+RIGHT_COLORS = (BLUE, GREEN, MAGENTA)
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
