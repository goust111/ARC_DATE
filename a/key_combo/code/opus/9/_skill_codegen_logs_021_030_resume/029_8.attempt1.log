+            continue
+        if exact_dims is not None and (h, w) != exact_dims:
+            continue
+        if shape in reject:
+            continue
+        return shape
+    return None
+
+
+def _random_symmetric_template() -> tuple[tuple[int, int], ...]:
+    for _ in range(500):
+        height = random.randint(3, 6)
+        top_rows = (height + 1) // 2
+        left = 0
+        right = random.randint(1, 3)
