+        pair = tuple(sorted(((r, c), partner)))
+        if pair not in seen:
+            seen.add(pair)
+            pairs.append(pair)
+    return pairs
+
+
+def _random_connected_shape(
+    area: int,
+    *,
+    max_h: int = 6,
+    max_w: int = 6,
+    exact_dims: tuple[int, int] | None = None,
+    reject: set[tuple[tuple[int, int], ...]] | None = None,
