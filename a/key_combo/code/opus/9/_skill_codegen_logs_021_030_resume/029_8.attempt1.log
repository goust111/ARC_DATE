+
+
+def _count_matches_in_region(region: np.ndarray, target_shape: tuple[tuple[int, int], ...]) -> int:
+    comps = _connected_components(region != BG, connectivity=4)
+    return sum(_normalize_coords(comp) == target_shape for comp in comps)
