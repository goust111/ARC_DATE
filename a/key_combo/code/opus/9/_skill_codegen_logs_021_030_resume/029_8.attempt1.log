+    match_colors = set()
+    mismatch_colors = set()
+    for comp in right_comps:
+        vals = {int(right[r, c]) for r, c in comp}
+        assert len(vals) == 1
+        color = vals.pop()
+        assert color in RIGHT_COLORS
+        colors.append(color)
+        if _normalize_coords(comp) == template:
+            match_colors.add(color)
+        else:
+            mismatch_colors.add(color)
