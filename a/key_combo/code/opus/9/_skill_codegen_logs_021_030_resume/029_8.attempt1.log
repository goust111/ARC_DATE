    choices = GEN_PATTERN_WEIGHTS[width]
    total = sum(w for _pat, w in choices)
    pick = random.randrange(total)
    for pat, weight in choices:
        if pick < weight:
            return pat
        pick -= weight
    return choices[-1][0]


