+    h, w = _shape_dims(shape)
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in shape:
+        patch[r, c] = int(color)
+    return patch
+
+
+def _connected_components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
