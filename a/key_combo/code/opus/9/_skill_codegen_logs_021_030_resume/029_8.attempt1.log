+
+
+def _semantic_check(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30
+
+    sep_cols = [c for c in range(g.shape[1]) if np.all(g[:, c] == SEP)]
