        spans.append((pos, pos + width))
        seq.extend(pat)
        pos += width
        if i != len(widths) - 1:
            seq.append(GEN_LATTICE_TYPE)
            pos += GEN_LATTICE_GAP_WIDTH
    return seq, spans


