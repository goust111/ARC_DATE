            assert 0 <= r < out.shape[0] and 0 <= c < out.shape[1], "stamped marker leaves the grid"
            assert int(out[r, c]) in (int(bg), int(color)), "stamped marker conflicts with existing content"
            out[r, c] = int(color)

    return out

