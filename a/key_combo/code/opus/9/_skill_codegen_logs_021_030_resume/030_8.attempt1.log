+    random.shuffle(all_cells)
+
+    if prefer_adjacent_to:
+        near = []
+        far = []
+        for cell in all_cells:
+            touching = any(nbr in prefer_adjacent_to for nbr in _neighbors4(*cell))
+            (near if touching else far).append(cell)
