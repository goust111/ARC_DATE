+        return True
+
+    prev = path[-2] if len(path) >= 2 else None
+    cur = path[-1]
+    for nxt in _candidate_next_cells(shape, cur, prev, occupied, path_set):
+        path.append(nxt)
+        path_set.add(nxt)
+        if _dfs_path(shape, target_len, occupied, path, path_set):
+            return True
