+            next_dir = (nr - cur[0], nc - cur[1])
+            if next_dir != prev_dir:
+                score -= 0.35
+        if nr in (0, shape[0] - 1) or nc in (0, shape[1] - 1):
+            score += 0.2
+        candidates.append((score, (nr, nc)))
