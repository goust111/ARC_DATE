+    return [cell for _, cell in candidates]
+
+
+def _dfs_path(
+    shape: tuple[int, int],
+    target_len: int,
+    occupied: set[tuple[int, int]],
+    path: list[tuple[int, int]],
+    path_set: set[tuple[int, int]],
+) -> bool:
