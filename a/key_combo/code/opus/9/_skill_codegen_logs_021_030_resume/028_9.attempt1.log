+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+REPEATED_OUT = 1
+UNIQUE_OUT = 2
+INPUT_FG = 5
+MAX_GENERATION_ATTEMPTS = 500
+GROUP_PATTERNS = ((3,), (4,), (2, 2), (3, 2))
