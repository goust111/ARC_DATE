+def _chebyshev_far_enough(existing: list[tuple[int, int]], new_cells: list[tuple[int, int]]) -> bool:
+    for r, c in new_cells:
+        for rr, cc in existing:
+            if max(abs(int(r) - int(rr)), abs(int(c) - int(cc))) < 3:
