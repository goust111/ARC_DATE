+def _rect_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + 1 < br0 - 1 or br1 + 1 < ar0 - 1 or ac1 + 1 < bc0 - 1 or bc1 + 1 < ac0 - 1
+
