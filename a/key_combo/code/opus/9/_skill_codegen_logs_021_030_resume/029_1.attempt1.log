+def _stop_column_from_left(row: int, rects: Iterable[tuple[int, int, int, int]]) -> tuple[int, int]:
+    hits = [(c0, idx) for idx, (r0, c0, r1, _c1) in enumerate(rects) if r0 <= row <= r1]
