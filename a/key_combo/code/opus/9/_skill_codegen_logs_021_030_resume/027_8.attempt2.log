+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+
+GEN_RETRY_LIMIT = 400
+FRAME_SIZES = (10, 12)
+CONTROL_PATTERNS = [
