+    assert np.all(frame[-1, :] == GRAY)
+    assert np.all(frame[:, 0] == GRAY)
+    assert np.all(frame[:, -1] == GRAY)
+    assert not np.any(frame[1:-1, 1:-1] == GRAY)
+    return box
+
