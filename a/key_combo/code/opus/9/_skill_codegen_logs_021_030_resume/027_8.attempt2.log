+    assert green_box is not None, "expected one 2x2 green block"
+    gr0, gc0, gr1, gc1 = green_box
+    assert (gr1 - gr0 + 1, gc1 - gc0 + 1) == (2, 2)
+    assert np.all(grid[gr0 : gr1 + 1, gc0 : gc1 + 1] == GREEN)
+    return green_box
