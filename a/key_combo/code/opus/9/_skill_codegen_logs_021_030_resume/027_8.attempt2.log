    if kind == "L":
        return h + w - 1
    if orient in ("top", "bottom"):
        return 2 * h + w - 2
    return h + 2 * w - 2


def _gen_configs():
    configs = []
    for n in range(GRID_N_MIN, GRID_N_MAX + 1):
        for h in range(FRAME_H_MIN, FRAME_H_MAX + 1):
            for w in range(FRAME_W_MIN, FRAME_W_MAX + 1):
