_GEN_GREEN_COUNT_RANGE = (2, 5)
_GEN_LEFT_FG_COUNT_RANGE = (3, 6)
_GEN_RIGHT_FG_COUNT_RANGE = (4, 8)
_GEN_COMPONENT_COUNT_RANGE = (1, 3)


def _gen_component_count(panel: np.ndarray) -> int:
