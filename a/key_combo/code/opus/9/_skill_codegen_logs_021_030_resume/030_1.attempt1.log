    right = np.full(_GEN_PANEL_SHAPE, _GEN_BG, dtype=int)

    split_a = both_count
    split_b = left_count

    for r, c in active[:split_a]:
        left[r, c] = _GEN_LEFT
        right[r, c] = _GEN_RIGHT
    for r, c in active[split_a:split_b]:
        left[r, c] = _GEN_LEFT
    for r, c in active[split_b:]:
        right[r, c] = _GEN_RIGHT
    return left, right


