            row_boxes.append((r, c, r + h - 1, c + w - 1))
            c += w + layout["v_lines"][cc + 1]
        boxes.append(row_boxes)
        r += h + layout["h_lines"][rr + 1]
    return boxes


def _draw_table(grid: np.ndarray, layout: dict) -> None:
    top = layout["top"]
    left = layout["left"]
    table_h = sum(layout["row_heights"]) + sum(layout["h_lines"])

