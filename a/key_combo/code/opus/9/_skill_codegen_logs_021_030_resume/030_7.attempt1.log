+    field_start = layout["left"] + sum(layout["col_widths"]) + sum(layout["v_lines"]) + layout["gap"]
+    full[:, field_start:] = field_in
+
+    expected = _expected_from_meta(full, field_start, assignments)
+    if not np.array_equal(expected, field_out):
