+                if cells is None:
+                    ok = False
+                    break
+            elif kind == "pair_lr":
+                cells = _choose_pair_lr(n, occupied)
+                if cells is None:
+                    ok = False
+                    break
+            else:
+                cells = _choose_center(n, occupied)
+                if cells is None:
+                    ok = False
+                    break
