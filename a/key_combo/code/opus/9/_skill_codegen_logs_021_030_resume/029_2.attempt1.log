+        start = next(iter(remain))
+        stack = [start]
+        seen = {start}
+        while stack:
+            cur = stack.pop()
+            for nxt in _neighbors4_of(cur):
+                if nxt in remain and nxt not in seen:
+                    seen.add(nxt)
+                    stack.append(nxt)
