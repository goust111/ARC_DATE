+
+
+_FREE_TEMPLATES = [
+    _mask(("###",)),
+    _mask(("#.", "##")),
+    _mask((".#", "##")),
+    _mask(("###", ".#.")),
+    _mask((".#.", "###")),
+    _mask(("##.", ".##")),
+    _mask(("#..", "###")),
+    _mask(("##", "##")),
+    _mask((".#.", "###", ".#.")),
+    _mask(("###", "##.")),
+]
+
+_VERTICAL_TEMPLATES = [
+    _mask(("###",)),
+    _mask((".#.", "###")),
+    _mask(("###", ".#.")),
+    _mask((".#.", "###", ".#.")),
+    _mask(("..#..", ".###.")),
+    _mask((".###.", "..#..")),
+    _mask(("#####",)),
+    _mask(("..#..", "#####")),
+]
+
+_CENTER_TEMPLATES = [
+    _mask(("###",)),
+    _mask((".#.", ".#.", ".#.")),
+    _mask((".#.", "###", ".#.")),
+    _mask(("..#..", "#####", "..#..")),
+    _mask((".#.", ".#.", "###", ".#.", ".#.")),
