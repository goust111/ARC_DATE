+    return {(c, max_r - r) for r, c in coords}
+
+
+def _flip_coords(coords: set[Coord]) -> set[Coord]:
+    max_c = max(c for _, c in coords)
+    return {(r, max_c - c) for r, c in coords}
+
+
+def _unique_variants(mask: np.ndarray) -> list[np.ndarray]:
