+def _mask(lines: tuple[str, ...]) -> np.ndarray:
+    return np.array([[ch == "#" for ch in row] for row in lines], dtype=bool)
+
+
+_FREE_TEMPLATES = [
+    _mask(("###",)),
+    _mask(("#.", "##")),
+    _mask((".#", "##")),
+    _mask(("###", ".#.")),
+    _mask((".#.", "###")),
+    _mask(("##.", ".##")),
+    _mask(("#..", "###")),
+    _mask(("##", "##")),
+    _mask((".#.", "###", ".#.")),
+    _mask(("###", "##.")),
+]
+
+_VERTICAL_TEMPLATES = [
+    _mask(("###",)),
+    _mask((".#.", "###")),
+    _mask(("###", ".#.")),
+    _mask((".#.", "###", ".#.")),
+    _mask(("..#..", ".###.")),
+    _mask((".###.", "..#..")),
+    _mask(("#####",)),
+    _mask(("..#..", "#####")),
+]
+
+_CENTER_TEMPLATES = [
+    _mask(("###",)),
+    _mask((".#.", ".#.", ".#.")),
+    _mask((".#.", "###", ".#.")),
+    _mask(("..#..", "#####", "..#..")),
+    _mask((".#.", ".#.", "###", ".#.", ".#.")),
+]
