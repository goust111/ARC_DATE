+            c -= 1
+            steps += 1
+            flags.append("both_open_left")
+            continue
+        if left_open:
+            r += 1
+            c -= 1
+            steps += 1
+            flags.append("left_only")
+            continue
+        if right_open:
+            r += 1
+            c += 1
+            steps += 1
+            flags.append("right_only")
