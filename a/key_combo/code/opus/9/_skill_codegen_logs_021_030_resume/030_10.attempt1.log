+            and (red_info["flags"] or blue_info["flags"])
+        )
+
+    if red_wins == 0 or blue_wins == 0:
+        return False
+    if not nontrivial_conflict or not any_diagonal:
+        return False
+    if require_both_open and not any_both_open:
