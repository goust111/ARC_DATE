+    any_diagonal = False
+    any_both_open = False
+    red_wins = 0
+    blue_wins = 0
+    for spec in pair_specs:
+        red_info = top_by_source.get(spec["red"]["source"])
+        blue_info = bottom_by_source.get(spec["blue"]["source"])
+        if red_info is None or blue_info is None:
+            return False
+        if red_info["final"] != blue_info["final"]:
+            return False
+        if red_info["steps"] == blue_info["steps"]:
+            return False
+        if red_info["steps"] > blue_info["steps"]:
+            red_wins += 1
+        else:
+            blue_wins += 1
+        any_diagonal = any_diagonal or bool(red_info["flags"]) or bool(blue_info["flags"])
+        any_both_open = any_both_open or ("both_open_left" in red_info["flags"]) or ("both_open_left" in blue_info["flags"])
+        same_row_diff = red_info["source"][0] == blue_info["source"][0]
+        reversal = (
+            (red_info["source"][0] > blue_info["source"][0] and red_info["steps"] > blue_info["steps"])
+            or (blue_info["source"][0] > red_info["source"][0] and blue_info["steps"] > red_info["steps"])
+        )
+        anti_shortcut = anti_shortcut or same_row_diff or reversal
+
+    if red_wins == 0 or blue_wins == 0:
+        return False
+    if not anti_shortcut or not any_diagonal:
+        return False
+    if require_both_open and not any_both_open:
+        return False
+    return True
