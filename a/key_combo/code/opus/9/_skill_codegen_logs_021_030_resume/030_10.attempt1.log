+def _ascending_profile(length: int, low: int, high: int) -> list[int]:
+    diff = int(high - low)
+    assert 0 <= diff <= length
+    incs = [1] * diff + [0] * (length - diff)
+    random.shuffle(incs)
+    vals = [int(low)]
+    cur = int(low)
+    for inc in incs:
+        cur += int(inc)
+        vals.append(int(cur))
+    return vals
