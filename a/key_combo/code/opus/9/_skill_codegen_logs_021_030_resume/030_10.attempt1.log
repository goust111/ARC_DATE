+            continue
+        if cand["source"] in used_starts or cand["final"] in used_finals:
+            continue
+        if any(abs(cand["final"][1] - fc[1]) < 3 for fc in used_finals):
+            continue
+        target = "red" if len(chosen["red"]) <= len(chosen["blue"]) else "blue"
