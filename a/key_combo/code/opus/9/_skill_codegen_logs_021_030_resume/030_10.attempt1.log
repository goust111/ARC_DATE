+        top[r, c] = RED
+    for r, c in blue_starts:
+        assert bottom[r, c] == BLACK
+        bottom[r, c] = BLUE
+    separator = np.full((1, obstacle_panel.shape[1]), YELLOW, dtype=int)
+    return np.vstack([top, separator, bottom])
