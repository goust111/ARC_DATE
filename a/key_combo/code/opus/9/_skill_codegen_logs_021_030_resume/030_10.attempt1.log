+    assert sep * 2 + 1 == g.shape[0], "separator must split two equal-height panels"
+    top = g[:sep, :].copy()
+    bottom = g[sep + 1 :, :].copy()
+    assert top.shape == bottom.shape
+    assert np.array_equal(top == GREY, bottom == GREY), "panels must share the same obstacle layout"
