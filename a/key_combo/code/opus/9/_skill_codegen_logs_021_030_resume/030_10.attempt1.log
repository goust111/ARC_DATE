MAX_FG_NUM, MAX_FG_DEN = 3, 4
UNIQUE_DIFF_COUNTS = (1, 2)
DIFF_DELTA_STEP, DIFF_BALANCE_DEN = 2, 2
MAX_GRID_FG_DEN, BG_MAJORITY_MARGIN = 2, 1
