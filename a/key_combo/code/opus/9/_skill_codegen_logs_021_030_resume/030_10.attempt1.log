+        if i:
+            ridge_w = random.randint(1, 2)
+            ridge_h = random.randint(max(3, panel_h - 3), panel_h - 2)
+            parts.extend([ridge_h] * ridge_w)
+        parts.extend(_make_basin_profile(panel_h))
