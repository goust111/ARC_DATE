+
+def _separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == YELLOW)]
+    assert len(rows) == 1, "expected one yellow separator row"
+    return int(rows[0])
+
