+        options.append({"final": final, "pairs": pair_options})
+
+    options.sort(key=lambda item: item["pairs"][0]["score"], reverse=True)
+    return options, all_candidates
+
+
+def _choose_conflicts(group_options: list[dict]) -> list[dict] | None:
