                rr, cc = opts[0]
                continue

            # Horizontal slide only when supported.
            if rr + 1 < H and int(g[rr + 1, cc]) != int(bg):
                # Empty run [L,R] in this row
                L = int(cc)
                while L - 1 >= 0 and int(g[rr, L - 1]) == int(bg):
                    L -= 1
                R = int(cc)
                while R + 1 < W and int(g[rr, R + 1]) == int(bg):
