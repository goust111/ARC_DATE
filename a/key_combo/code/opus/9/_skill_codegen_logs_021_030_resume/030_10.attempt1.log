+    bottom = obstacle_panel.copy()
+    for r, c in red_starts:
+        assert top[r, c] == BLACK
+        top[r, c] = RED
+    for r, c in blue_starts:
+        assert bottom[r, c] == BLACK
+        bottom[r, c] = BLUE
