  "type": "move_along_path",
  "src": "blue pixels",
  "path": "flow along neighboring bg cells to left/right/down (like water)",
  "dst": "lowest postion possible (into basin)",
  "multi_step": "iteratively move blue pixels whose left or right side is bg"
}
</annotation>
