+GRID_RANGE = (14, 18)
+OBSTACLE_COUNT_CHOICES = (3, 4)
+RECT_SIDE_RANGE = (2, 4)
+BRACKET_SHAPES = ((2, 2), (2, 3), (3, 2))
+GEN_ATTEMPTS = 500
