+def _exact_periods(tile: np.ndarray) -> tuple[int, int]:
+    pr, pc = tile.shape
+    row_period = next(
+        p for p in range(1, pr + 1) if all(np.array_equal(tile[r], tile[(r + p) % pr]) for r in range(pr))
