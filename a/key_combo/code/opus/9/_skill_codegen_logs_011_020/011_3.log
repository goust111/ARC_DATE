+def _rotationally_distinct(mask: np.ndarray) -> bool:
+    base = mask.astype(int)
+    for turns in (1, 2, 3):
+        rot = np.rot90(base, turns)
+        if base.shape == rot.shape and np.array_equal(base, rot):
+            return False
+    return True
