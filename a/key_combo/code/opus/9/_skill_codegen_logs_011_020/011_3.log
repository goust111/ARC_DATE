+    panel_h = random.randint(*PANEL_SIDE_RANGE)
+    panel_w = random.randint(*PANEL_SIDE_RANGE)
+    chosen_panel = random.randrange(4)
+    chosen_direction = random.choice(list(DIR_TO_TURNS))
+    panel_colors = random.sample(PANEL_COLORS, 4)
