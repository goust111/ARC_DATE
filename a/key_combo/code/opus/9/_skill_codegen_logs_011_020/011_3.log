+
+    panels: list[np.ndarray] = []
+    expected = None
+    other_i = 0
+    selected_sprite = None
+    selected_direction = None
+    for idx in range(4):
+        marker_count = 1 if idx == chosen_panel else other_counts[other_i]
+        if idx != chosen_panel:
+            other_i += 1
+        desired = chosen_direction if idx == chosen_panel else None
