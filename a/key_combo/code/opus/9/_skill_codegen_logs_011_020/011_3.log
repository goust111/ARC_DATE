def _grow_shape(h: int, w: int, area: int) -> np.ndarray | None:
    start = (random.randrange(h), random.randrange(w))
    cells = {start}
    frontier = set(_neighbors4_in_box(start[0], start[1], h, w))
    while len(cells) < area and frontier:
