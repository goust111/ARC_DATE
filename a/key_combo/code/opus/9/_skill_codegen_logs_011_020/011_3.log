+        crop = crop_bbox(mask.astype(int), bbox_coords(coords)).astype(bool)
+        if min(crop.shape) < 2:
+            continue
+        if int(crop.sum()) == crop.size:
+            continue
+        if not _rotationally_distinct(crop):
