def _find_dividers(grid: np.ndarray) -> tuple[int, int]:
    full_rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == Color.GREY)]
    full_cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == Color.GREY)]
