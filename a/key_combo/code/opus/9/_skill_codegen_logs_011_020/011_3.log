+    blocked = mask.copy()
+    blocked[1:, :] |= mask[:-1, :]
+    blocked[:-1, :] |= mask[1:, :]
+    blocked[:, 1:] |= mask[:, :-1]
+    blocked[:, :-1] |= mask[:, 1:]
+    return blocked
