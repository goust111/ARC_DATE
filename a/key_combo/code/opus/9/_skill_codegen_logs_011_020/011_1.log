+    assert len(winners) == 1, "rectangle with most markers must be unique"
+    return _render_with_center(g, winners[0]["center"])
+
+
+GRID_SIDE_RANGE = (15, 20)
+RECT_COUNT_RANGE = (3, 5)
+RECT_SIDE_RANGE = (3, 6)
+MAX_MARKERS = 4
+GENERATION_ATTEMPTS = 600
