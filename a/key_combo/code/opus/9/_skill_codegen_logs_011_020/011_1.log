+    winner_count = counts[winner_idx]
+
+    conditions = []
+    conditions.append(any(
+        ((box[2] - box[0] + 1) * (box[3] - box[1] + 1)) > winner_area
+        for i, box in enumerate(boxes)
+        if i != winner_idx
