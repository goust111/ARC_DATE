            if any(_gen_too_close(box, old) for old in chosen):
                continue
            remaining = [
                other
                for other in next_candidates[i + 1 :]
                if not _gen_too_close(other, box)
            ]
            result = rec(remaining, chosen + [box])
            if result is not None:
                return result
        return None

    return rec(order, [])


