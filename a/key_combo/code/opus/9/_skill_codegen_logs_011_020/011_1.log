+def _border_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _rect_border_coords(box: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = box
+    coords: list[Coord] = []
+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        if r1 != r0:
+            coords.append((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c0))
+        if c1 != c0:
