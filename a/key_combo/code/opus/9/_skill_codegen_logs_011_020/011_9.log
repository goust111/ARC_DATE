0001: from __future__ import annotations
0002: import math
0003: from collections import Counter
0004: import numpy as np
0005: from arc_utils import bbox_h, bbox_w, find_components, get_bg
0006: import random
0007: 
0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Stamp translated copies of a monochrome template guided by a singleton pixel layout.
0011: 
0012:     Input structure:
0013:     - bg = background. A large monochrome shape (template, color T).
0014:     - Singleton pixels elsewhere: exactly one is color T (layout origin); the rest share color O (overlap color).
0015:     - Singletons sit on a uniform-spacing lattice.
0016: 
0017:     Rule:
0018:     - Convert each singleton's offset from the origin into coarse lattice units.
0019:     - Place a template copy at each offset, scaled by template height/width.
0020:     - The origin's copy is painted O instead of T.
0021:     - Any pixel covered by two or more copies is also recolored to O.
0022: 
0023:     Key insight: The single T-colored singleton identifies both the origin position and the "self" copy, which is uniquely recolored.
0024:     """
0025:     g = np.array(grid, dtype=int)
0026:     bg = int(get_bg(g))
0027:     H, W = g.shape
0028: 
0029:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=False, return_format="dict")
0030:     assert not (not comps)
0031: 
0032:     template = max(comps, key=lambda d: int(d["area"]))
0033:     templ_coords = template["coords"]
0034:     templ_col = int(g[int(templ_coords[0, 0]), int(templ_coords[0, 1])])
0035:     r0, c0, r1, c1 = map(int, template["bbox"])
0036:     h = int(bbox_h((r0, c0, r1, c1)))
0037:     w = int(bbox_w((r0, c0, r1, c1)))
0038: 
0039:     templ_rel = [(int(r) - int(r0), int(c) - int(c0)) for r, c in templ_coords]
0040: 
0041:     # Singleton layout points (excluding the template component).
0042:     singletons: list[tuple[int, int, int]] = []
0043:     for comp in comps:
0044:         if comp is template:
0045:             continue
0046:         if int(comp["area"]) != 1:
0047:             continue
0048:         rr, cc = map(int, comp["coords"][0])
0049:         singletons.append((int(rr), int(cc), int(g[int(rr), int(cc)])))
0050: 
0051:     origin = [(r, c) for (r, c, col) in singletons if int(col) == int(templ_col)]
0052:     assert not (len(origin) != 1)
0053:     orr, orc = origin[0]
0054: 
0055:     other_cols = [int(col) for (_r, _c, col) in singletons if int(col) != int(templ_col)]
0056:     assert not (not other_cols)
0057:     overlap_col = int(Counter(other_cols).most_common(1)[0][0])
0058: 
0059:     deltas = [(int(r - orr), int(c - orc), int(col)) for (r, c, col) in singletons]
0060:     gcd_vals = [abs(int(x)) for dr, dc, _ in deltas for x in (dr, dc) if int(x) != 0]
0061:     assert gcd_vals
0062:     gunit = int(math.gcd(*gcd_vals))
0063:     gunit = max(1, int(gunit))
0064:     deltas = [(int(dr // gunit), int(dc // gunit), int(col)) for dr, dc, col in deltas]
0065: 
0066:     total = np.zeros((H, W), dtype=int)
0067:     center = np.zeros((H, W), dtype=int)  # coverage count from the origin singleton
0068: 
0069:     for dr, dc, col in deltas:
0070:         off_r = int(dr * h)
0071:         off_c = int(dc * w)
0072:         is_origin = int(col) == int(templ_col)
0073:         for rr, cc in templ_rel:
0074:             R = int(r0 + off_r + rr)
0075:             C = int(c0 + off_c + cc)
0076:             if 0 <= R < H and 0 <= C < W:
0077:                 total[R, C] += 1
0078:                 if is_origin:
0079:                     center[R, C] += 1
0080: 
0081:     out = np.full((H, W), int(bg), dtype=int)
0082:     out[total > 0] = int(templ_col)
0083:     out[(total == 1) & (center > 0)] = int(overlap_col)
0084:     out[total >= 2] = int(overlap_col)
0085:     return out

