0058: def main(grid: np.ndarray) -> np.ndarray:
0059:     """
0060:     Replace each pink masked pixel with the color from its matching square-symmetry orbit.
0061: 
0062:     Input structure:
0063:     - The grid is square and fully colored.
0064:     - Pink pixels are masks covering missing cells; every other pixel is part of the completed pattern.
0065:     - The completed pattern obeys main-diagonal symmetry and reflected square symmetry in a slightly larger hidden frame.
0066: 
0067:     Rule:
0068:     - Infer the reflected square frame whose visible symmetry orbits make all non-pink cells agree.
0069:     - For each pink pixel, collect all visible cells related by diagonal, horizontal, vertical, and rotated reflections in that frame.
0070:     - Recolor the pink pixel to the unique non-pink color already present in its orbit.
0071: 
0072:     Key insight:
0073:     Pink is not an object color; it hides entries of one globally D4-symmetric color table, so each missing value is copied from its symmetry orbit.
0074:     """
0075:     g = np.asarray(grid, dtype=int)
0076:     assert g.ndim == 2 and g.shape[0] == g.shape[1], "input must be a square grid"
0077:     assert np.any(g == MASK), "input must contain pink masked pixels"
0078: 
0079:     n = g.shape[0]
0080:     symmetry_sum = _symmetry_sum(g)
0081:     out = g.copy()
0082:     for r, c in zip(*np.where(g == MASK)):
0083:         vals = {int(g[rr, cc]) for rr, cc in _orbit(int(r), int(c), symmetry_sum, n) if g[rr, cc] != MASK}
0084:         assert len(vals) == 1, f"masked cell {(int(r), int(c))} must have one known orbit color"
0085:         out[r, c] = vals.pop()
0086: 
0087:     assert not np.any(out == MASK), "all masked pixels must be filled"
0088:     return out
0089: 
