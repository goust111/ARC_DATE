+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RECT = 1
+MARK = 2
+ARC_MAX = 30
+GAP = 1
+MAX_GENERATION_ATTEMPTS = 500
+
+MIN_RECTS = 4
+MAX_RECTS = 6
+MIN_SURVIVORS = 2
+MAX_SURVIVORS = 4
+
+CELL_MIN = 6
+CELL_GAP = 1
+CELL_BORDER = 1
