0008: 
0009: def _unique_max_color(counts: dict[int, int], message: str) -> int:
0010:     assert counts, message
0011:     max_count = max(counts.values())
0012:     winners = [color for color, count in counts.items() if count == max_count]
0013:     assert len(winners) == 1, message
0014:     return int(winners[0])
0015: 
0016: 
0017: def _boundary_background(g: np.ndarray) -> int:
0018:     boundary = np.concatenate((g[0, :], g[-1, :], g[:, 0], g[:, -1]))
0019:     return _unique_max_color(Counter(map(int, boundary)), "expected a unique boundary background color")
0020: 
0021: 
0022: def _half_index(marker_lo: int, marker_hi: int, panel_lo: int, panel_hi: int) -> int:
0023:     marker_center2 = marker_lo + marker_hi
0024:     panel_center2 = panel_lo + panel_hi
0025:     assert marker_center2 != panel_center2, "marker must lie clearly in one half of the panel"
0026:     return 0 if marker_center2 < panel_center2 else 1
