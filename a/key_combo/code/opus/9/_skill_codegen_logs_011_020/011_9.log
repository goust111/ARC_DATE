0178: def _scaled_patch(patch: np.ndarray, qb: int, qr: int, target_size: int) -> np.ndarray:
0179:     """Reflect and scale the source patch for a given quadrant and target anchor size."""
0180:     p = patch
0181:     if qr:
0182:         p = np.fliplr(p)
0183:     if qb:
0184:         p = np.flipud(p)
0185:     ratio = target_size / SOURCE_ANCHOR_SIZE
0186:     h = max(1, int(round(p.shape[0] * ratio)))
0187:     w = max(1, int(round(p.shape[1] * ratio)))
0188:     return _resize_nn(p, h, w)
