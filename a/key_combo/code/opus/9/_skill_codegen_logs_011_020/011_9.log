0128: def _spanning_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
0129:     """Polyomino of *n* cells that spans exactly rows x cols (touches all 4 edges)."""
0130:     for _ in range(SPANNING_RETRIES):
0131:         cells = _random_polyomino(n, rows, cols)
0132:         if cells is None:
0133:             continue
0134:         rs = [r for r, c in cells]
0135:         cs = [c for r, c in cells]
0136:         if min(rs) == 0 and max(rs) == rows - 1 and min(cs) == 0 and max(cs) == cols - 1:
0137:             return cells
0138:     return None
