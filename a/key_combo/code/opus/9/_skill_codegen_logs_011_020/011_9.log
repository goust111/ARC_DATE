0015: def _mirror_axis(g: np.ndarray, coords: np.ndarray) -> tuple[str, int, list[tuple[int, int]]]:
0016:     yellow = [(int(r), int(c)) for r, c in coords if int(g[r, c]) == Color.YELLOW]
0017:     assert yellow, "expected a yellow mirror marker"
0018: 
0019:     candidates: list[tuple[str, int, int]] = []
0020:     row_counts = Counter(r for r, _ in yellow)
0021:     col_counts = Counter(c for _, c in yellow)
0022: 
0023:     for row, count in row_counts.items():
0024:         if count < 2:
0025:             continue
0026:         cols = sorted(c for r, c in yellow if r == row)
0027:         if _contiguous(cols):
0028:             candidates.append(("h", int(row), len(cols)))
0029: 
0030:     for col, count in col_counts.items():
0031:         if count < 2:
0032:             continue
0033:         rows = sorted(r for r, c in yellow if c == col)
0034:         if _contiguous(rows):
0035:             candidates.append(("v", int(col), len(rows)))
0036: 
0037:     assert candidates, "expected a contiguous yellow mirror axis"
