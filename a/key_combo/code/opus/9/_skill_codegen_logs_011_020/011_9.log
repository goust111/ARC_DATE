0031: def main(grid: np.ndarray) -> np.ndarray:
0032:     """
0033:     Pack each solid foreground rectangle twice: wide across the top and tall from the bottom.
0034: 
0035:     Input structure
0036:     The grid has one background color and one foreground color; the foreground forms
0037:     separate solid rectangles, ordered from left to right.
0038: 
0039:     Rule
0040:     Build a 10-row background canvas whose width is the packed width of the wide
0041:     versions of the rectangles. For each source rectangle, paint a top-aligned
0042:     rectangle of shape min(h,w) by max(h,w), with one background column between
0043:     consecutive rectangles. Then, starting again from the left edge, paint a
0044:     bottom-aligned rectangle of shape max(h,w) by min(h,w) for each source rectangle,
0045:     again separated by one background column.
0046: 
0047:     Key insight
0048:     The input rectangles are not copied in their original orientations; each object
0049:     contributes one horizontal-facing and one vertical-facing normalized rectangle,
0050:     preserving left-to-right object order.
0051:     """
0052:     g = np.asarray(grid, dtype=int)
0053:     bg = get_bg(g)
0054:     fg_colors = colors_present(g, exclude={bg})
0055:     assert len(fg_colors) == 1
0056:     fg = fg_colors[0]
0057: 
0058:     components = find_components(g, bg=bg, connectivity=4, colors=[fg])
0059:     assert components
0060:     components = sorted(components, key=lambda obj: (obj["bbox"][1], obj["bbox"][0]))
0061: 
0062:     dims: list[tuple[int, int]] = []
0063:     for obj in components:
0064:         r0, c0, r1, c1 = obj["bbox"]
0065:         h = r1 - r0 + 1
0066:         w = c1 - c0 + 1
0067:         assert obj["area"] == h * w
0068:         dims.append((h, w))
0069: 
0070:     out_h = 10
0071:     out_w = sum(max(h, w) for h, w in dims) + len(dims) - 1
0072:     _assert_output_footprints_disjoint(dims)
0073:     out = np.full((out_h, out_w), bg, dtype=int)
0074: 
0075:     c = 0
0076:     for h, w in dims:
0077:         short, long = min(h, w), max(h, w)
0078:         assert long <= out_h
0079:         out[:short, c : c + long] = fg
0080:         c += long + 1
0081: 
0082:     c = 0
0083:     for h, w in dims:
0084:         short, long = min(h, w), max(h, w)
0085:         assert long <= out_h
0086:         out[out_h - long : out_h, c : c + short] = fg
0087:         c += short + 1
0088: 
0089:     return out
