0191: def _grow_4conn(h: int, w: int, seeds: set[tuple[int, int]], n_fill: int) -> set[tuple[int, int]]:
0192:     """Grow a 4-connected region from seeds until it has n_fill cells."""
0193:     filled = set(seeds)
0194:     frontier = set()
0195:     for r, c in seeds:
0196:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
0197:             nr, nc = r + dr, c + dc
0198:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
0199:                 frontier.add((nr, nc))
0200:     while len(filled) < n_fill and frontier:
0201:         cell = random.choice(list(frontier))
0202:         filled.add(cell)
0203:         frontier.discard(cell)
0204:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
0205:             nr, nc = cell[0] + dr, cell[1] + dc
0206:             if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in filled:
0207:                 frontier.add((nr, nc))
0208:     return filled
