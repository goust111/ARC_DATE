0106: def _random_polyomino(n: int, rows: int, cols: int) -> list[tuple[int, int]] | None:
0107:     """Grow a random 4-connected polyomino of *n* cells in a rows x cols grid."""
0108:     start = (random.randint(0, rows - 1), random.randint(0, cols - 1))
0109:     cells = {start}
0110:     frontier = []
0111:     for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
0112:         nr, nc = start[0] + dr, start[1] + dc
0113:         if 0 <= nr < rows and 0 <= nc < cols:
0114:             frontier.append((nr, nc))
0115:     while len(cells) < n and frontier:
0116:         cell = random.choice(frontier)
0117:         frontier.remove(cell)
0118:         if cell in cells:
0119:             continue
0120:         cells.add(cell)
0121:         for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
0122:             nr, nc = cell[0] + dr, cell[1] + dc
0123:             if 0 <= nr < rows and 0 <= nc < cols and (nr, nc) not in cells:
0124:                 frontier.append((nr, nc))
0125:     return list(cells) if len(cells) == n else None
