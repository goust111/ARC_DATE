+def _sample_dims(shape_type: str, max_h: int, max_w: int) -> tuple[int, int] | None:
+    if shape_type == "square":
+        side = random.randint(2, min(4, max_h, max_w))
+        return side, side
+
+    short_max = min(4, max_h, max_w)
+    long_max = min(6, max(max_h, max_w))
+    if short_max < 2:
+        return None
+
