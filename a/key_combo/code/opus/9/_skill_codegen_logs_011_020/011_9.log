0170: def _resize_nn(img: np.ndarray, new_h: int, new_w: int) -> np.ndarray:
0171:     """Nearest-neighbor resize supporting fractional scale ratios."""
0172:     src_h, src_w = img.shape
0173:     rr = np.clip(np.floor(np.arange(new_h) * src_h / new_h).astype(int), 0, src_h - 1)
0174:     cc = np.clip(np.floor(np.arange(new_w) * src_w / new_w).astype(int), 0, src_w - 1)
0175:     return img[rr[:, None], cc[None, :]]
