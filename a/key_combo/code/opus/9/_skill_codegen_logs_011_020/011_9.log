0044:     # Each object gets pink bars at its center, but these are going to be drawn over the object, which we have to undo later by redrawing the objects
0045:     out = input_grid.copy()
0046:     for obj in objects:
0047:         b = bbox(obj != background)
0048:         if b is None:
0049:             continue
0050:         center_r, center_c = bbox_anchor(b, anchor="center")
0051:         out[center_r, :] = Color.PINK
0052:         out[:, center_c] = Color.PINK
0053:     
0054:     # Redraw the objects
0055:     for obj in objects:
0056:         out = paste(out, obj, 0, 0, transparent=background)
0057:     
0058:     return out
