0001: import numpy as np
0002: 
0003: from arc_utils import crop_bbox, find_components
0004: import math
0005: import random
0006: 
0007: 
0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """Crop out the foreground rectangle that contains the most marker pixels.
0010: 
0011:     Input structure
0012:     - The upper-left cell is background.
0013:     - The foreground consists of multiple 4-connected solid rectangles made from
0014:       a common fill color, with a rarer marker color replacing some cells.
0015: 
0016:     Rule
0017:     - Treat the rarer of the two foreground colors as the marker color.
0018:     - Count marker pixels inside each foreground rectangle.
0019:     - Return the exact bounding-box crop of the unique rectangle with the largest
0020:       marker count.
0021: 
0022:     Key insight
0023:     - The output is not redrawn or recolored; it is one existing input rectangle
0024:       selected by the count of its marker pixels.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027: 
0028:     bg = int(g[0, 0])
0029:     fg_pixels = g[g != bg]
0030:     colors, counts = np.unique(fg_pixels, return_counts=True)
0031:     assert len(colors) == 2
0032: 
0033:     min_count = int(counts.min())
0034:     marker_candidates = colors[counts == min_count]
0035:     assert len(marker_candidates) == 1
0036:     marker = int(marker_candidates[0])
0037:     foreground_colors = set(map(int, colors))
0038: 
0039:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0040:     assert len(components) >= 2
0041: 
0042:     scored = []
0043:     for comp in components:
0044:         box = comp["bbox"]
0045:         crop = crop_bbox(g, box)
0046:         assert np.all(crop != bg)
0047:         assert set(map(int, np.unique(crop))).issubset(foreground_colors)
0048:         marker_count = int(np.count_nonzero(crop == marker))
0049:         assert marker_count > 0
0050:         scored.append((marker_count, box))
0051: 
0052:     best_count = max(marker_count for marker_count, _box in scored)
0053:     winners = [box for marker_count, box in scored if marker_count == best_count]
0054:     assert len(winners) == 1
0055:     return crop_bbox(g, winners[0])
0056: 
