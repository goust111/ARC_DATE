+            if ci not in col_offsets:
+                col_offsets[ci] = random.randint(0, max_dc)
+            dc = min(col_offsets[ci], max_dc)
+        else:
+            dc = random.randint(0, max_dc)
+        dr = random.randint(0, max_dr)
