0007: def _find_dividers(g: np.ndarray, bg: int) -> tuple[int, int]:
0008:     """
0009:     Return the unique full-row/full-col quadrant divider: (mid_row, mid_col).
0010:     """
0011:     h, w = g.shape
0012:     full_rows = [(r, int(g[r, 0])) for r in range(h) if np.all(g[r, :] == g[r, 0]) and int(g[r, 0]) != bg]
0013:     full_cols = [(c, int(g[0, c])) for c in range(w) if np.all(g[:, c] == g[0, c]) and int(g[0, c]) != bg]
0014:     matches = []
0015:     for r, vr in full_rows:
0016:         for c, vc in full_cols:
0017:             if vr == vc:
0018:                 matches.append((int(r), int(c)))
0019:     assert len(matches) == 1, "grid must have exactly one matching full-row/full-col divider"
0020:     return matches[0]
