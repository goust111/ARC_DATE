+    survivor_specs = [
+        {"shape_type": "tall", "marker_count": 1},
+        {"shape_type": random.choice(["wide", "square"]), "marker_count": 0},
+    ]
+    while len(survivor_specs) < n_survivors:
+        survivor_specs.append(
