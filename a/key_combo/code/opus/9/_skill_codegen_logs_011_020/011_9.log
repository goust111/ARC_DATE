0023: def main(grid: np.ndarray) -> np.ndarray:
0024:     """
0025:     Replicate a motif across quadrants with scaling and reflection keyed to red anchor blocks.
0026: 
0027:     Input structure:
0028:     - Grid divided into four quadrants by a full-row and full-column divider of a single non-bg color.
0029:     - Each quadrant contains a red (2) square anchor block of varying size.
0030:     - The top-left quadrant also has a colored motif attached to its red anchor.
0031: 
0032:     Rule:
0033:     - Use the top-left quadrant's motif as the source pattern.
0034:     - For each other quadrant, scale the motif by the ratio of that quadrant's red block size to the source red block size.
0035:     - Reflect horizontally for right-side quadrants, vertically for bottom quadrants (both for bottom-right).
0036:     - Align the scaled/reflected motif so its red region overlaps the target anchor, then stamp non-bg pixels.
0037: 
0038:     Key insight: Red block size encodes the scale factor; quadrant position encodes the reflection axes.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     h, w = g.shape
0042:     out = g.copy()
0043: 
0044:     bg = get_bg(g)
0045:     mid_r, mid_c = _find_dividers(g, bg)
0046: 
0047:     # Find red anchor blocks (color 2) in each quadrant.
0048:     red = components_mask(g == 2, connectivity=4)
0049:     assert red, "grid must contain red (color 2) anchor blocks"
0050: 
0051:     # Quadrant key: (top/bottom, left/right)
