0211: def _assign_colors(filled: set[tuple[int, int]], red_cells: set[tuple[int, int]],
0212:                    h: int, w: int) -> np.ndarray | None:
0213:     """Assign random colors to filled cells; returns None if coverage is incomplete."""
0214:     rows = {r for r, _ in filled}
0215:     cols = {c for _, c in filled}
0216:     if rows != set(range(h)) or cols != set(range(w)):
0217:         return None
0218:     non_red = [p for p in filled if p not in red_cells]
0219:     random.shuffle(non_red)
0220:     max_colors = min(MOTIF_COLORS_MAX, len(non_red) + 1)
0221:     if max_colors < MOTIF_COLORS_MIN:
0222:         return None
0223:     n_colors = random.randint(MOTIF_COLORS_MIN, max_colors)
0224:     pool = COLOR_POOL[:]
0225:     random.shuffle(pool)
0226:     extras = pool[: n_colors - 1]
0227:     grid = np.full((h, w), BG, dtype=int)
0228:     for r, c in red_cells:
0229:         grid[r, c] = RED
0230:     for i, (r, c) in enumerate(non_red):
0231:         grid[r, c] = extras[i] if i < len(extras) else random.choice(extras)
0232:     return grid
