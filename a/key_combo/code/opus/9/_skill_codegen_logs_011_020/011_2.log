+def _overlap(a: dict[str, int], b: dict[str, int]) -> bool:
+    return not (
+        a["r"] + a["side"] <= b["r"]
+        or b["r"] + b["side"] <= a["r"]
+        or a["c"] + a["side"] <= b["c"]
