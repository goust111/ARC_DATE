+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+COLOR_CYCLE = (BLUE, RED, YELLOW, ORANGE)
+MAX_GENERATION_ATTEMPTS = 600
