+    g = info["grid"]
+    h, _w = g.shape
+    seed = info["seed"]
+    seed_col = seed["col"]
+    seed_height = seed["height"]
+    left_wall_col = info["left_wall"]["col"]
+    right_wall_col = info["right_wall"]["col"]
