+            if c in bar_cols:
+                continue
+            candidates.append((r, c))
+
+    extra_count = random.randint(*GUIDE_EXTRA_COUNT_RANGE)
+    random.shuffle(candidates)
+    for pt in candidates:
+        points.add(pt)
+        if len(points) >= 4 + extra_count:
