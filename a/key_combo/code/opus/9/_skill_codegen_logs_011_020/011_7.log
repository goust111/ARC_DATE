+        if right_mode == "wall_first":
+            deltas[seed_idx] = 4
+            if seed_height < 9:
+                return None
+        else:
+            natural_stop_d = (seed_height + 1) // 2
+            deltas[seed_idx] = random.randint(max(4, natural_stop_d + 1), 6)
