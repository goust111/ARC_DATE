+BAR_COUNT_RANGE = (4, 6)
+BAR_HEIGHT_RANGE = (3, 10)
+GRID_W_MAX = 28
+BAR_DELTA_RANGE = (4, 6)  # column distance between consecutive bars
+MARGIN_RANGE = (1, 3)
+GUIDE_EXTRA_COUNT_RANGE = (1, 6)
+GEN_ATTEMPTS = 400
