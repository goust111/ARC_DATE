+        cols = [left_margin]
+        for delta in deltas:
+            cols.append(cols[-1] + delta)
+        return width, cols
+    return None
+
+
+def _guide_pixels(
+    shape: tuple[int, int],
+    bar_cols: set[int],
+    seed_col: int,
+    seed_height: int,
+    left_wall_col: int,
+    right_wall_col: int,
