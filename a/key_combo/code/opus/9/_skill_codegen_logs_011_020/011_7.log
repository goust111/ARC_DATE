+    h, _w = shape
+    left_extent = random.randint(1, seed_col - left_wall_col - 1)
+    right_extent = random.randint(1, right_wall_col - seed_col - 1)
+    left = seed_col - left_extent
+    right = seed_col + right_extent
+    bottom = random.randint(seed_height - 1, h - 1)
