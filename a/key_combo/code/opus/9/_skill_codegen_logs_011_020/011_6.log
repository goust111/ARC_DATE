        return None
    outer = random.choice(feasible_outer)
    total = outer - inner
    starts = [lo for lo in range(margin_min, margin_max + 1) if margin_min <= total - lo <= margin_max]
    if not starts:
        return None
    before = random.choice(starts)
    return before, total - before


