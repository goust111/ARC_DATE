+    random.shuffle(targets)
+    starts = [cell for cell in _random_edge_cells(shape) if cell not in blocked]
+    for target_len in targets:
+        for start in starts[: min(len(starts), 24)]:
+            path = [start]
+
+            def dfs() -> bool:
