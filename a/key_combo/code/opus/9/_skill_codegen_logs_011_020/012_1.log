+def _random_edge_cells(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    cells = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if _is_border(shape, (r, c))
+    ]
+    random.shuffle(cells)
+    return cells
