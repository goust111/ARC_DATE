+
+
+def _build_input(
+    shape: tuple[int, int],
+    template: np.ndarray,
+    template_top_left: tuple[int, int],
+    lattice_cells: list[tuple[int, int]],
+    origin_cell: tuple[int, int],
+    step_r: int,
