+        target_count = random.randint(MARKER_COUNT_RANGE[0], min(MARKER_COUNT_RANGE[1], len(all_cells)))
+        origin = random.choice(all_cells)
+        chosen = set(random.sample(all_cells, target_count))
+        chosen.add(origin)
