+        paste(patch, motif, 0, motif_c, transparent=BG)
+        patch[mh + gap : mh + gap + anchor_side, anchor_c : anchor_c + anchor_side] = ANCHOR
+    else:
+        patch_h = max(mh, anchor_side)
