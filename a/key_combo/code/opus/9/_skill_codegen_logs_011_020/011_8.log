+def _distractor_candidates(side: int) -> list[tuple[tuple[int, int], ...]]:
+    candidates: list[tuple[tuple[int, int], ...]] = [
+        ((-1, -1),),
+        ((-1, side),),
+        ((side, -1),),
+        ((side, side),),
