+        seed = (random.randrange(h), random.randrange(w))
+        mask[seed] = True
+        frontier = set()
+        for r, c in [seed]:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    frontier.add((nr, nc))
+        while int(mask.sum()) < target_cells and frontier:
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            if mask[cell]:
