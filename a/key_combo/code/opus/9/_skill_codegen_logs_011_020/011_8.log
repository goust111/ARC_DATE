+        anchor_r = random.randint(0, patch_h - anchor_side)
+        paste(patch, motif, motif_r, 0, transparent=BG)
+        patch[anchor_r : anchor_r + anchor_side, mw + gap : mw + gap + anchor_side] = ANCHOR
