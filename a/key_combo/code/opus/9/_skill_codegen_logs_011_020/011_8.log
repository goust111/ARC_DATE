+    if random.random() < 0.5:
+        patch_h = mh + gap + anchor_side
+        patch_w = max(mw, anchor_side)
+        patch = np.zeros((patch_h, patch_w), dtype=int)
+        motif_c = random.randint(0, patch_w - mw)
+        anchor_c = random.randint(0, patch_w - anchor_side)
