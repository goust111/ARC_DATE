+def _bbox_chebyshev_distance(a, b):
+    ar0, ac0, ar1, ac1 = map(int, a)
+    br0, bc0, br1, bc1 = map(int, b)
+    row_gap = max(0, br0 - ar1 - 1, ar0 - br1 - 1)
