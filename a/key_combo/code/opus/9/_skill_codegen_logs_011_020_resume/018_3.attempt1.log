+
+    for i, (r0, r1) in enumerate(row_segments):
+        for j, (c0, c1) in enumerate(col_segments):
+            patch = consensus[r0:r1, c0:c1]
+            color = int(patch[0, 0])
+            assert bool(np.all(patch == color)), "each logical cell must scale to one solid rectangle"
+            out[i, j] = color
