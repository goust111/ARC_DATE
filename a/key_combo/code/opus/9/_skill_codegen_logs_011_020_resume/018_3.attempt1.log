+    row_ends = [*[r + 1 for r in row_changes], bh]
+    col_starts = [0, *[c + 1 for c in col_changes]]
+    col_ends = [*[c + 1 for c in col_changes], bw]
+    row_segments = list(zip(row_starts, row_ends))
+    col_segments = list(zip(col_starts, col_ends))
+
