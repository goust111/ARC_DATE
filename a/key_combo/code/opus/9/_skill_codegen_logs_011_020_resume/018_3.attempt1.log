+    rng: np.random.Generator,
+    logical: np.ndarray,
+    scale_r: int,
+    scale_c: int,
+) -> tuple[list[tuple[int, int]], set[tuple[int, int]]] | None:
+    candidates = [tuple(map(int, rc)) for rc in np.argwhere(logical != BLACK)]
+    if len(candidates) < 2:
+        return None
+
+    cell_area = int(scale_r * scale_c)
+    max_per_cell = max(1, (cell_area - 1) // 2)
