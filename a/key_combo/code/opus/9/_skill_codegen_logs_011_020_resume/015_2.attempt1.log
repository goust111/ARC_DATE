+
+    for c in range(w):
+        for color in marker_colors:
+            rows = np.flatnonzero(grid[:, c] == color)
+            assert len(rows) <= 2
+            if len(rows) != 2:
+                continue
+            r0, r1 = map(int, sorted(rows))
+            for r in range(r0 + 1, r1):
