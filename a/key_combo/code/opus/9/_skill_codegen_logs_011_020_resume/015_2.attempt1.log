+
+BG = 0
+GREY = 5
+LINE_COLORS = (1, 2, 3, 4)
+REGION_DIMS = (
+    (2, 3),
+    (2, 4),
+    (2, 5),
+    (3, 2),
+    (3, 3),
+    (3, 4),
