+def _draw_paired_lines(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    marker_colors = [int(v) for v in np.unique(grid) if int(v) not in (BG, GREY)]
+    h, w = out.shape
+
