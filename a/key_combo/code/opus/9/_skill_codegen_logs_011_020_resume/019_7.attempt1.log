+    norm = np.zeros((3, 3), dtype=int)
+    palette = [frame_color]
+    others = [color for color in PALETTE if color != frame_color]
+    rng.shuffle(others)
+    palette.extend(others[: int(rng.integers(1, 3))])
+    cells = np.argwhere(mask == 1)
+    for r, c in cells:
+        norm[r, c] = int(palette[int(rng.integers(0, len(palette)))])
+    return norm
