+    pool = _FULL_SPAN_MASKS[count] if full_span else _MASKS_BY_COUNT[count]
+    if not pool:
+        pool = _MASKS_BY_COUNT[count]
+    idx = int(rng.integers(0, len(pool)))
+    return pool[idx].copy()
