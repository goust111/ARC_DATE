+def _extract_sprites(grid: np.ndarray) -> list[tuple[tuple[int, int, int, int], int]]:
+    bg = int(get_bg(grid))
+    candidates = []
+    seen = set()
+    for comp in find_components(grid, bg=bg, connectivity=8, monochromatic=True, return_format="dict"):
