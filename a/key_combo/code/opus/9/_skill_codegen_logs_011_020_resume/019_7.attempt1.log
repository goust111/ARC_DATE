+    items = []
+    for box, frame_color in sprites:
+        patch = crop_bbox(g, box)
+        inner = _normalize_inner(patch[1:-1, 1:-1], bg)
+        icon = _make_icon(frame_color, inner, bg)
+        items.append((int(np.count_nonzero(inner != bg)), box[0], box[1], icon))
