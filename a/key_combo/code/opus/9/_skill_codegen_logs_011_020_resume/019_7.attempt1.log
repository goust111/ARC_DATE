+    order = sorted(range(n), key=lambda idx: patches[idx].shape[0], reverse=True)
+    for idx in order:
+        patch = patches[idx]
+        ph, pw = patch.shape
+        placed = False
+        for _ in range(PLACE_ATTEMPTS):
+            r0 = int(rng.integers(0, height - ph + 1))
+            c0 = int(rng.integers(0, width - pw + 1))
