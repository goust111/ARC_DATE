+                stack = [(r, c)]
+                visited[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for dr, dc in steps:
+                        nr, nc = rr + dr, cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and ok(nr, nc):
