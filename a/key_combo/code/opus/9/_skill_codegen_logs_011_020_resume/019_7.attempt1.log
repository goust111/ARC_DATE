+def _normalize_inner(interior: np.ndarray, bg: int) -> np.ndarray:
+    box = bbox(interior != bg)
+    assert box is not None, "expected a non-empty interior motif"
+    motif = crop_bbox(interior, box)
+    h, w = map(int, motif.shape)
+    if h <= 3 and w <= 3:
