+    rng.shuffle(frame_colors)
+
+    small_idx = counts.index(count_small)
+    dense_idx = counts.index(count_dense)
+    sparse_idx = counts.index(count_sparse)
+
+    patches = []
+    norm_icons = []
+    modes = []
+    sizes = []
+    for idx, (count, frame_color) in enumerate(zip(counts, frame_colors)):
+        if idx == small_idx:
