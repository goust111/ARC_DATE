        assert len(gates) == 1
        gate_r, gate_c, dr, dc = gates[0]
        gate = (gate_r, gate_c)
        gate_ends = {(gate_r - dr, gate_c - dc), (gate_r + dr, gate_c + dc)}
        coords_set = {tuple(map(int, coord)) for coord in coords}

        parking = []
        for nr, nc in neighbors4(gate_r, gate_c):
