+            rr1 = min(height, r0 + ph + 1)
+            cc0 = max(0, c0 - 1)
+            cc1 = min(width, c0 + pw + 1)
+            if blocked[rr0:rr1, cc0:cc1].any():
+                continue
+            grid[r0 : r0 + ph, c0 : c0 + pw] = patch
+            blocked[r0 : r0 + ph, c0 : c0 + pw] = True
+            positions[idx] = (r0, c0)
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid, positions
