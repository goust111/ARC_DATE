  19: def main(grid: np.ndarray) -> np.ndarray:
  20:     """
  21:     Carve color-matched motifs into solid blocks and pack them into a compact grid.
  22: 
  23:     Input structure:
  24:     - bg = most common color.
  25:     - Several solid 5×5 monochrome blocks, each a distinct non-bg color.
  26:     - For each block color, a small same-colored motif sprite elsewhere on the grid.
  27: 
  28:     Rule:
  29:     - Match each motif to its same-colored 5×5 block.
  30:     - Center the motif within the block and recolor those cells to bg (punching holes).
  31:     - Pack all carved blocks into an output grid preserving their original row/column order, separated by 1-cell gaps and a 1-cell outer border.
  32: 
  33:     Key insight: The motif acts as a stencil — it's not stamped onto the block but carved out of it as background holes.
  34:     """
  35:     g = np.array(grid, dtype=int)
  36:     bg = int(get_bg(g))
  37:     H, W = g.shape
  38: 
  39:     # STEP 1) Identify destination blocks: solid 5x5 monochrome squares.
  40:     blocks: list[dict[str, int]] = []
  41:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
  42:     for comp in comps:
  43:         b = comp["bbox"]
  44:         if bbox_h(b) != 5 or bbox_w(b) != 5:
  45:             continue
  46:         col = int(comp["color"])
  47:         patch = crop_bbox(g, b)
  48:         if bool((patch == int(col)).all()):
  49:             r0, c0, _r1, _c1 = map(int, b)
  50:             blocks.append({"col": int(col), "r0": int(r0), "c0": int(c0)})
  51: 
  52:     assert not (not blocks)
  53: 
  54:     # STEP 2) For each block color, identify its motif:
  55:     # the smallest same-colored component that is NOT one of the 5x5 blocks.
  56:     motifs: dict[int, np.ndarray] = {}
  57:     block_colors = {int(b["col"]) for b in blocks}
  58:     for bcol in block_colors:
  59:         candidates: list[tuple[int, int, int, int, np.ndarray]] = []  # (area, bbox_area, r0, c0, mask)
  60: 
  61:         comps_col = find_components(g, bg=bg, connectivity=8, monochromatic=True, colors=[int(bcol)], return_format="dict")
  62:         for comp in comps_col:
  63:             b = comp["bbox"]
  64:             if bbox_h(b) == 5 and bbox_w(b) == 5:
  65:                 patch = crop_bbox(g, b)
  66:                 if bool((patch == int(bcol)).all()):
  67:                     continue  # skip the big 5x5 blocks
  68: 
  69:             r0, c0, r1, c1 = map(int, b)
  70:             h = int(r1 - r0 + 1)
  71:             w = int(c1 - c0 + 1)
  72: 
  73:             rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp["coords"]]
  74:             m = mask_from_coords(rel_coords, (h, w))
  75:             candidates.append((int(comp["area"]), int(h * w), int(r0), int(c0), m))
  76: 
  77:         if candidates:
  78:             candidates.sort(key=lambda t: (t[0], t[1], t[2], t[3]))
  79:             motifs[int(bcol)] = candidates[0][4]
  80: 
  81:     # STEP 3) Carve each 5x5 tile:
  82:     # center the motif mask within the 5x5 and repaint those mask cells to bg.
  83:     carved: dict[tuple[int, int], np.ndarray] = {}
  84:     for b in blocks:
  85:         col = int(b["col"])
  86:         tile = np.full((5, 5), int(col), dtype=int)
  87:         mm = motifs.get(int(col))
  88:         if mm is not None:
  89:             mh, mw = map(int, mm.shape)
  90:             off_r = (5 - mh) // 2
  91:             off_c = (5 - mw) // 2
  92:             for rr, cc in np.argwhere(mm):
  93:                 tr = int(off_r + int(rr))
  94:                 tc = int(off_c + int(cc))
  95:                 if 0 <= tr < 5 and 0 <= tc < 5:
  96:                     tile[tr, tc] = int(bg)
  97:         carved[(int(b["r0"]), int(b["c0"]))] = tile
  98: 
  99:     # STEP 4) Pack carved 5x5 tiles into a compact grid.
 100:     rs = sorted({int(b["r0"]) for b in blocks})
 101:     cs = sorted({int(b["c0"]) for b in blocks})
 102:     r_index = {int(r): int(i) for i, r in enumerate(rs)}
 103:     c_index = {int(c): int(j) for j, c in enumerate(cs)}
 104: 
 105:     out_h = int(1 + len(rs) * 5 + (len(rs) - 1) * 1 + 1)
 106:     out_w = int(1 + len(cs) * 5 + (len(cs) - 1) * 1 + 1)
 107:     out = np.full((out_h, out_w), int(bg), dtype=int)
 108: 
 109:     step = 6  # 5 block + 1 gap
 110:     for b in blocks:
 111:         r0 = int(b["r0"])
 112:         c0 = int(b["c0"])
 113:         i = int(r_index[int(r0)])
 114:         j = int(c_index[int(c0)])
 115:         rr = int(1 + i * step)
 116:         cc = int(1 + j * step)
 117:         out[rr : rr + 5, cc : cc + 5] = carved[(int(r0), int(c0))]
 118: 
 119:     return out
 120: 
