  61:     _assert_path_single_component(g, path_color)
  62: 
  63:     # Detect the repeating cycle from 2x2 blocks in the top-left region.
  64:     pattern: list[int] = []
  65:     pat_cells: list[tuple[int, int]] = []
  66:     seen: set[tuple[int, int]] = set()
  67:     for r in range(min(6, H - 1)):
  68:         for c in range(min(25, W - 1)):
  69:             if (int(r), int(c)) in seen:
  70:                 continue
  71:             v = int(g[int(r), int(c)])
  72:             if v == int(template_bg) or v == int(path_color):
  73:                 continue
  74:             if int(g[int(r + 1), int(c)]) == v and int(g[int(r), int(c + 1)]) == v and int(g[int(r + 1), int(c + 1)]) == v:
  75:                 pattern.append(int(v))
  76:                 for rr, cc in [(r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1)]:
  77:                     seen.add((int(rr), int(cc)))
  78:                     pat_cells.append((int(rr), int(cc)))
  79: 
  80:     # Detect end color block (2x2).
  81:     end_color = None
  82:     end_pos = None
  83:     pat_set = set(map(int, pattern))
  84:     for r in range(H - 1):
  85:         for c in range(W - 1):
  86:             v = int(g[int(r), int(c)])
  87:             if v == int(template_bg) or v == int(path_color) or v in pat_set:
  88:                 continue
  89:             if int(g[int(r + 1), int(c)]) == v and int(g[int(r), int(c + 1)]) == v and int(g[int(r + 1), int(c + 1)]) == v:
  90:                 end_color = int(v)
  91:                 end_pos = (int(r), int(c))
  92:                 break
  93:         if end_pos is not None:
  94:             break
  95: 
  96:     # Detect start markers: isolated pattern-color pixels adjacent to the path.
  97:     markers: list[tuple[int, int, int]] = []
  98:     for r in range(H):
  99:         for c in range(W):
 100:             v = int(g[int(r), int(c)])
 101:             if v not in pat_set:
 102:                 continue
 103:             same = 0
 104:             has_path = False
 105:             for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
 106:                 rr = int(r + dr)
 107:                 cc = int(c + dc)
 108:                 if 0 <= rr < H and 0 <= cc < W:
 109:                     if int(g[rr, cc]) == v:
 110:                         same += 1
 111:                     if int(g[rr, cc]) == int(path_color):
 112:                         has_path = True
 113:             if same == 0 and has_path:
 114:                 markers.append((int(r), int(c), int(v)))
 115: 
 116:     _assert_marker_embedded_in_path(g, markers, int(path_color))
 117: 
 118:     out = g.copy()
 119:     # Erase template pattern blocks and the end block.
 120:     for r, c in pat_cells:
 121:         out[int(r), int(c)] = int(template_bg)
 122:     if end_pos is not None:
 123:         er, ec = end_pos
 124:         out[int(er) : int(er + 2), int(ec) : int(ec + 2)] = int(template_bg)
 125: 
 126:     # Initial direction preference (matches examples).
 127:     dir_order = [(0, 1), (1, 0), (0, -1), (-1, 0)]  # R, D, L, U
 128: 
 129:     per_marker_cells: list[set[tuple[int, int]]] = []
 130:     for sr, sc, sv in markers:
 131:         init = None
 132:         for dr, dc in dir_order:
 133:             rr = int(sr + dr)
 134:             cc = int(sc + dc)
 135:             if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(path_color):
 136:                 init = (int(dr), int(dc))
 137:                 break
 138:         if init is None or not pattern:
 139:             per_marker_cells.append(set())
 140:             continue
 141: 
 142:         r, c = int(sr), int(sc)
 143:         dr, dc = init
 144:         idx = int(pattern.index(int(sv))) if int(sv) in pattern else 0
 145:         hits = 0  # collision count so far
 146:         visited: set[tuple[int, int, int, int, int, int]] = set()
 147:         my_cells: set[tuple[int, int]] = set()
 148: 
 149:         for _ in range(H * W * 4):
 150:             state = (int(r), int(c), int(dr), int(dc), int(idx), int(hits & 1))
 151:             if state in visited:
 152:                 break
 153:             visited.add(state)
 154: 
 155:             nr = int(r + dr)
 156:             nc = int(c + dc)
 157:             if not (0 <= nr < H and 0 <= nc < W):
 158:                 break
 159: 
 160:             if int(g[nr, nc]) == int(path_color):
 161:                 idx = int((idx + 1) % len(pattern))
 162:                 out[nr, nc] = int(pattern[idx])
 163:                 my_cells.add((int(nr), int(nc)))
 164:                 r, c = nr, nc
 165:                 continue
 166: 
 167:             # Collision with non-path.
 168:             if int(g[nr, nc]) == int(template_bg) and end_color is not None:
 169:                 out[nr, nc] = int(end_color)
 170: 
 171:             # Strict alternating turn: no fallback if blocked.
 172:             left = (-int(dc), int(dr))  # CCW
 173:             right = (int(dc), -int(dr))  # CW
 174:             tdr, tdc = left if (int(hits) % 2 == 0) else right
 175:             rr = int(r + tdr)
 176:             cc = int(c + tdc)
 177:             if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(path_color):
 178:                 dr, dc = int(tdr), int(tdc)
 179:                 hits += 1
 180:                 continue
 181:             break
 182: 
 183:         per_marker_cells.append(my_cells)
 184: 
 185:     # Trajectories must be pairwise disjoint (bg islands separate them).
 186:     for i in range(len(per_marker_cells)):
 187:         for j in range(i + 1, len(per_marker_cells)):
 188:             overlap = per_marker_cells[i] & per_marker_cells[j]
 189:             assert not overlap, (
 190:                 f"marker trajectories {i},{j} overlap on {len(overlap)} cell(s)"
 191:             )
 192: 
 193:     return out
 194: 
