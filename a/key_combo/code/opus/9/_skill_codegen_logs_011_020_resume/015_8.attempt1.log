+            sc0 = random.randint(EDGE_MARGIN, w - tile_w - EDGE_MARGIN)
+            br0 = sr0 + tile_h + gap
+            sprite_bbox = (sr0, sc0, sr0 + tile_h - 1, sc0 + tile_w - 1)
+            bar_bbox = (br0, sc0, br0, sc0 + tile_w - 1)
+            output_bbox = (sr0, sc0, sr0 + copies * tile_h - 1, sc0 + tile_w - 1)
+        elif direction == "up":
