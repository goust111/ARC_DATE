+    groups: list[dict] = []
+    for color in sorted(by_color):
+        items = by_color[color]
+        sprite_candidates = []
+        bar_candidates = []
+        motif_candidates = []
+        for comp in items:
+            r0, c0, r1, c1 = map(int, comp["bbox"])
