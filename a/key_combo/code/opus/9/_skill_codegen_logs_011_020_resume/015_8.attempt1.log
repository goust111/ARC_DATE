+        groups.append(
+            {
+                "color": int(color),
+                "sprite_bbox": tuple(map(int, sprite["bbox"])),
+                "bar_bbox": tuple(map(int, bar["bbox"])),
+                "motif_bbox": tuple(map(int, motif["bbox"])),
+                "motif_mask": motif_mask.astype(bool),
+                "direction": direction,
+            }
