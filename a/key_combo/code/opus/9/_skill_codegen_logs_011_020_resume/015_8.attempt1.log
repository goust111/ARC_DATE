+                anchors.append((int(r), int(sc0)))
+                r += tile_h
+    else:
+        assert (br0, br1) == (sr0, sr1)
+        if bc0 < sc0:
+            direction = "left"
+            c = sc0
+            while c + tile_w - 1 >= bc0:
+                anchors.append((int(sr0), int(c)))
+                c -= tile_w
+        else:
+            direction = "right"
+            c = sc0
+            while c <= bc0:
+                anchors.append((int(sr0), int(c)))
+                c += tile_w
