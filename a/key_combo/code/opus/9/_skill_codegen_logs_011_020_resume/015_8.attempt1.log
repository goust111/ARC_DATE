+    tile = np.full((tile_h, tile_w), int(color), dtype=int)
+    direction, anchors = _tile_anchors(sprite_bbox, bar_bbox)
+    off_r, off_c = _hole_offsets(tile_h, tile_w, motif_h, motif_w, direction)
