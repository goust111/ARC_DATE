+    for group in groups:
+        br0, bc0, br1, bc1 = group["bar_bbox"]
+        mr0, mc0, mr1, mc1 = group["motif_bbox"]
+        out[br0 : br1 + 1, bc0 : bc1 + 1] = int(bg)
+        out[mr0 : mr1 + 1, mc0 : mc1 + 1] = int(bg)
