+    br0, bc0, br1, bc1 = map(int, bar_bbox)
+    tile_h = sr1 - sr0 + 1
+    tile_w = sc1 - sc0 + 1
+
+    anchors: list[tuple[int, int]] = []
+    if br0 == br1:
+        assert (bc0, bc1) == (sc0, sc1)
+        if br0 < sr0:
+            direction = "up"
+            r = sr0
+            while r + tile_h - 1 >= br0:
+                anchors.append((int(r), int(sc0)))
+                r -= tile_h
+        else:
+            direction = "down"
