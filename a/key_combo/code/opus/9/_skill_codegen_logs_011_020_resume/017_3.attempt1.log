        else:
            r_split = random.randint(int(H*0.4), int(H*0.6))
            ctrl_pts.append((r_split, 0 if edge == 'left' else W-1))
            has_h = True

    def pick_dest(hs, vs):
        if r_split is not None: dh = hs
        elif 'top' in E and 'bottom' not in E: dh = 'T'
