+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 8
+BLOCK = 3
+MOTIF_BLOCKS = 3
+MOTIF_SIZE = BLOCK * MOTIF_BLOCKS
+EXPANDED_BLOCKS = 5
+EXPANDED_SIZE = BLOCK * EXPANDED_BLOCKS
+PALETTE = (1, 2, 3, 4, 5, 6)
