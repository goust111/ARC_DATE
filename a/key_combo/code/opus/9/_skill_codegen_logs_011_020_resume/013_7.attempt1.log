+    (0, 1): ((4, 1), (4, 2), (4, 3)),
+    (0, 2): ((4, 0),),
+    (1, 0): ((1, 4), (2, 4), (3, 4)),
+    (1, 2): ((1, 0), (2, 0), (3, 0)),
+    (2, 0): ((0, 4),),
+    (2, 1): ((0, 1), (0, 2), (0, 3)),
+    (2, 2): ((0, 0),),
