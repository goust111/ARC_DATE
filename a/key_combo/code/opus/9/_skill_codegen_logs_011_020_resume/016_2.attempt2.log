+def _neighbors8_of_coords(coords: np.ndarray) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                out.add((rr + dr, cc + dc))
+    return out
