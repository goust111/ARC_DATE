+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr = rr + dr
+            nc = cc + dc
+            if (nr, nc) in own:
+                continue
+            if 0 <= nr < occ.shape[0] and 0 <= nc < occ.shape[1] and occ[nr, nc] >= 0:
