+BOTTOM = "bottom"
+LEFT = "left"
+RIGHT = "right"
+SIDES = (TOP, BOTTOM, LEFT, RIGHT)
+SIDE_TO_VEC = {
+    TOP: (-1, 0),
+    BOTTOM: (1, 0),
+    LEFT: (0, -1),
+    RIGHT: (0, 1),
+}
