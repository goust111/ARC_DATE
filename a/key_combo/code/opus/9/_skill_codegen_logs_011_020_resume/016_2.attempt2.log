+        tops = [0]
+        lefts = range(0, w - shp_w + 1)
+    elif side == BOTTOM:
+        tops = [h - shp_h]
+        lefts = range(0, w - shp_w + 1)
+    elif side == LEFT:
+        tops = range(0, h - shp_h + 1)
+        lefts = [0]
+    else:
+        tops = range(0, h - shp_h + 1)
+        lefts = [w - shp_w]
