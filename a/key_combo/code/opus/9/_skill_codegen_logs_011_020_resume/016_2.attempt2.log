+            comps.append(np.array(comp, dtype=int))
+    return comps
+
+
+def _detect_frame(grid: np.ndarray) -> dict:
+    mask = (grid != BG) & (grid != OBJ)
+    coords = np.argwhere(mask)
+    assert coords.size > 0, "frame not found"
+    fr0, fc0, fr1, fc1 = _bbox(coords)
