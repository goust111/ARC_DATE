+        np.all(coords[:, 0] >= 0)
+        and np.all(coords[:, 0] < h)
+        and np.all(coords[:, 1] >= 0)
+        and np.all(coords[:, 1] < w)
+    )
+
+
+def _coords_key(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
