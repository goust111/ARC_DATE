+    g[-1, 1:-1] = SIDE_TO_COLOR[BOTTOM]
+    g[1:-1, 0] = SIDE_TO_COLOR[LEFT]
+    g[1:-1, -1] = SIDE_TO_COLOR[RIGHT]
