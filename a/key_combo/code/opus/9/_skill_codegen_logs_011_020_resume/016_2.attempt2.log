+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _place(shape: tuple[tuple[int, int], ...], top: int, left: int) -> np.ndarray:
