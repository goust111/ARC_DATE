+    for comp in comps:
+        near = _nearest_side(comp, inner_top, inner_bottom, inner_left, inner_right)
+        assert near is not None, "each object must have a unique nearest side"
+        side, dist, dists = near
+        objects.append(
+            {
+                "coords": comp.copy(),
+                "bbox": _bbox(comp),
+                "side": side,
+                "dist": dist,
+                "dists": dists,
+                "color": int(frame["colors"][side]),
+            }
+        )
