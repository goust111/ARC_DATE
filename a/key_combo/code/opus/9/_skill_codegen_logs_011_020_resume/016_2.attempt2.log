+def _transform(shape: tuple[tuple[int, int], ...], rot: int, flip: bool) -> tuple[tuple[int, int], ...]:
+    pts = [(r, -c) if flip else (r, c) for r, c in shape]
+    for _ in range(rot % 4):
+        pts = [(-c, r) for r, c in pts]
+    return _normalize(pts)
