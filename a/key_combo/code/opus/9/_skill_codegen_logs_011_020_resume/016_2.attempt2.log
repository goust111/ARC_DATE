+    sides = [anchor_side, dependent_side]
+    remaining_distinct = [side for side in SIDES if side not in sides]
+    random.shuffle(remaining_distinct)
+    while len(set(sides)) < distinct_target:
+        sides.append(remaining_distinct.pop())
