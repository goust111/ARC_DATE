+    objects.sort(
+        key=lambda obj: (
+            int(round(obj["dist"] * 2)),
+            SIDES.index(obj["side"]),
+            obj["bbox"][0],
+            obj["bbox"][1],
+            obj["bbox"][2],
+            obj["bbox"][3],
+        )
+    )
