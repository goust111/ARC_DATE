+            nxt = _move(coords, dr, dc)
+            in_bounds = _inside(nxt, g.shape[0], g.shape[1])
+            if not in_bounds:
+                stop_reason = "wall"
+                blocker_ids = set()
+                break
+            hits = occ_kind[nxt[:, 0], nxt[:, 1]]
+            if np.any(hits != -2):
+                block_vals = {int(v) for v in hits if int(v) != -2}
+                if -1 in block_vals:
+                    stop_reason = "wall"
+                    blocker_ids = set()
+                else:
+                    stop_reason = "object"
+                    blocker_ids = block_vals
