+
+def _move(coords: np.ndarray, dr: int, dc: int, steps: int = 1) -> np.ndarray:
+    return coords + np.array([dr * steps, dc * steps], dtype=int)
+
+
+def _inside(coords: np.ndarray, h: int, w: int) -> bool:
