+    dists = _side_distances(coords, inner_top, inner_bottom, inner_left, inner_right)
+    best = min(dists.values())
+    winners = [side for side, dist in dists.items() if abs(dist - best) < 1e-9]
+    if len(winners) != 1:
+        return None
+    return winners[0], best, dists
