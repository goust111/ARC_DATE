+        "colors": {
+            TOP: next(iter(top_vals)),
+            BOTTOM: next(iter(bottom_vals)),
+            LEFT: next(iter(left_vals)),
+            RIGHT: next(iter(right_vals)),
+        },
+        "mask": mask,
+    }
