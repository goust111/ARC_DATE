+
+def _spans_overlap(a: np.ndarray, b: np.ndarray, axis: int) -> bool:
+    a0 = int(a[:, axis].min())
+    a1 = int(a[:, axis].max())
+    b0 = int(b[:, axis].min())
+    b1 = int(b[:, axis].max())
+    return max(a0, b0) <= min(a1, b1)
