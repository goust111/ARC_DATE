+    bottom_vals = set(map(int, grid[fr1, fc0 + 1 : fc1]))
+    left_vals = set(map(int, grid[fr0 + 1 : fr1, fc0]))
+    right_vals = set(map(int, grid[fr0 + 1 : fr1, fc1]))
+    assert len(top_vals) == len(bottom_vals) == len(left_vals) == len(right_vals) == 1
