+def _side_distances(coords: np.ndarray, inner_top: int, inner_bottom: int, inner_left: int, inner_right: int) -> dict[str, float]:
+    r0, c0, r1, c1 = _bbox(coords)
+    cr = (r0 + r1) / 2.0
+    cc = (c0 + c1) / 2.0
+    return {
+        TOP: cr - inner_top,
+        BOTTOM: inner_bottom - cr,
+        LEFT: cc - inner_left,
+        RIGHT: inner_right - cc,
