+            coords = nxt
+
+        out[coords[:, 0], coords[:, 1]] = obj["color"]
+        occ_kind[coords[:, 0], coords[:, 1]] = obj_idx
+        record = dict(obj)
+        record["final_coords"] = coords
+        record["stop_reason"] = stop_reason
+        record["blocker_ids"] = blocker_ids
