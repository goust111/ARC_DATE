+    def dfs(pos: int) -> bool:
+        if pos == len(search_order):
+            return chosen[anchor_id]["dist_key"] < chosen[dependent_id]["dist_key"]
+        obj = search_order[pos]
+        oid = obj["id"]
+        for opt in options[oid]:
