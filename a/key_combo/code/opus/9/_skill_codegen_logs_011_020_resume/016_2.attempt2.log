+def _draw_frame(frame_h: int, frame_w: int) -> np.ndarray:
+    g = np.zeros((frame_h, frame_w), dtype=int)
+    g[0, 1:-1] = SIDE_TO_COLOR[TOP]
+    g[-1, 1:-1] = SIDE_TO_COLOR[BOTTOM]
+    g[1:-1, 0] = SIDE_TO_COLOR[LEFT]
+    g[1:-1, -1] = SIDE_TO_COLOR[RIGHT]
+    return g
