+
+
+def _neighbors8_of_coords(coords: np.ndarray) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
