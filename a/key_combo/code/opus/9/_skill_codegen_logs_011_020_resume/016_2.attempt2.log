+def _candidate_wall_positions(shape: tuple[tuple[int, int], ...], side: str, h: int, w: int, occ: np.ndarray) -> list[np.ndarray]:
+    shp_h = max(r for r, _ in shape) + 1
+    shp_w = max(c for _, c in shape) + 1
