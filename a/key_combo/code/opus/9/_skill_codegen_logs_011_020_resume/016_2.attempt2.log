+    shp_w = max(c for _, c in shape) + 1
+    if side == TOP:
+        tops = [0]
+        lefts = range(0, w - shp_w + 1)
+    elif side == BOTTOM:
+        tops = [h - shp_h]
+        lefts = range(0, w - shp_w + 1)
+    elif side == LEFT:
+        tops = range(0, h - shp_h + 1)
+        lefts = [0]
+    else:
+        tops = range(0, h - shp_h + 1)
+        lefts = [w - shp_w]
+
+    out = []
+    for top in tops:
+        for left in lefts:
+            coords = _place(shape, top, left)
+            if np.any(occ[coords[:, 0], coords[:, 1]] >= 0):
+                continue
+            if _touching_ids(coords, occ):
+                continue
+            near = _nearest_side(coords, 0, h - 1, 0, w - 1)
+            if near is None or near[0] != side:
+                continue
+            out.append(coords)
+    random.shuffle(out)
+    return out
+
+
+def _candidate_blocked_positions(
+    shape: tuple[tuple[int, int], ...],
+    side: str,
+    h: int,
+    w: int,
+    occ: np.ndarray,
+    blocker_id: int,
+) -> list[np.ndarray]:
+    shp_h = max(r for r, _ in shape) + 1
+    shp_w = max(c for _, c in shape) + 1
+    dr, dc = SIDE_TO_VEC[side]
+    out = []
+    for top in range(0, h - shp_h + 1):
+        for left in range(0, w - shp_w + 1):
+            coords = _place(shape, top, left)
+            if np.any(occ[coords[:, 0], coords[:, 1]] >= 0):
+                continue
+            near = _nearest_side(coords, 0, h - 1, 0, w - 1)
+            if near is None or near[0] != side:
+                continue
+            nxt = _move(coords, dr, dc)
+            if not _inside(nxt, h, w):
+                continue
+            hits = {int(v) for v in occ[nxt[:, 0], nxt[:, 1]] if int(v) >= 0}
+            if hits != {blocker_id}:
+                continue
+            touching = _touching_ids(coords, occ)
+            if touching - {blocker_id}:
+                continue
+            out.append(coords)
+    random.shuffle(out)
+    return out
+
+
+def _all_shift_options(obj: dict, h: int, w: int) -> list[dict]:
+    side = obj["side"]
+    dr, dc = SIDE_TO_VEC[side]
+    out = []
+    for steps in range(1, max(h, w) + 1):
+        coords = _move(obj["final_coords"], -dr, -dc, steps)
+        if not _inside(coords, h, w):
+            break
+        near = _nearest_side(coords, 0, h - 1, 0, w - 1)
+        if near is None or near[0] != side:
+            continue
+        dist = near[1]
+        out.append(
+            {
+                "steps": steps,
+                "coords": coords,
+                "dist_key": int(round(dist * 2)),
+                "dist": dist,
+            }
+        )
+    random.shuffle(out)
+    out.sort(key=lambda item: (item["dist_key"], item["steps"]))
+    return out
+
+
+def _choose_initial_positions(objects: list[dict], h: int, w: int, anchor_id: int, dependent_id: int) -> dict[int, dict] | None:
+    options = {obj["id"]: _all_shift_options(obj, h, w) for obj in objects}
+    if any(not vals for vals in options.values()):
+        return None
+
+    search_order = sorted(objects, key=lambda obj: (len(options[obj["id"]]), random.random()))
+    chosen: dict[int, dict] = {}
+    used_dist: set[int] = set()
+    blocked8: set[tuple[int, int]] = set()
+
+    def dfs(pos: int) -> bool:
+        if pos == len(search_order):
+            return chosen[anchor_id]["dist_key"] < chosen[dependent_id]["dist_key"]
+        obj = search_order[pos]
+        oid = obj["id"]
+        for opt in options[oid]:
+            if opt["dist_key"] in used_dist:
+                continue
+            coords = opt["coords"]
+            if any((int(r), int(c)) in blocked8 for r, c in coords):
+                continue
+            chosen[oid] = opt
+            used_dist.add(opt["dist_key"])
+            added = _neighbors8_of_coords(coords)
+            blocked8.update(added)
+            if dfs(pos + 1):
+                return True
+            for cell in added:
+                if cell in blocked8:
+                    blocked8.remove(cell)
+            used_dist.remove(opt["dist_key"])
+            del chosen[oid]
+            for prev_opt in chosen.values():
+                blocked8.update(_neighbors8_of_coords(prev_opt["coords"]))
+        return False
+
+    if dfs(0):
+        return chosen
+    return None
+
+
+def _build_side_list(count: int, anchor_side: str, dependent_side: str) -> list[str]:
+    distinct_target = 4 if count >= 5 and random.random() < 0.7 else 3
+    sides = [anchor_side, dependent_side]
+    remaining_distinct = [side for side in SIDES if side not in sides]
+    random.shuffle(remaining_distinct)
+    while len(set(sides)) < distinct_target:
+        sides.append(remaining_distinct.pop())
+    while len(sides) < count:
+        sides.append(random.choice(list(set(sides))))
+    random.shuffle(sides[2:])
+    return sides
+
+
+def _make_layout() -> tuple[np.ndarray, np.ndarray] | None:
+    inner_h = random.randint(10, 16)
+    inner_w = random.randint(10, 16)
+    frame_h = inner_h + 2
+    frame_w = inner_w + 2
+    if frame_h > 24 or frame_w > 24:
+        return None
+
+    pair = random.choice(
+        [
+            (LEFT, TOP),
+            (LEFT, BOTTOM),
+            (RIGHT, TOP),
+            (RIGHT, BOTTOM),
+            (TOP, LEFT),
+            (TOP, RIGHT),
+            (BOTTOM, LEFT),
+            (BOTTOM, RIGHT),
+        ]
+    )
+    anchor_side, dependent_side = pair
+    count = random.randint(4, 7)
+    side_list = _build_side_list(count, anchor_side, dependent_side)
+    side_list[0] = anchor_side
+    side_list[1] = dependent_side
+
+    occ = np.full((inner_h, inner_w), -1, dtype=int)
+    objects: list[dict] = []
+
+    def add_object(side: str, final_coords: np.ndarray, stop_kind: str) -> None:
+        oid = len(objects)
+        occ[final_coords[:, 0], final_coords[:, 1]] = oid
+        objects.append(
+            {
+                "id": oid,
+                "side": side,
+                "final_coords": final_coords,
+                "stop_kind": stop_kind,
+            }
+        )
+
+    anchor_shape_choices = random.sample(SHAPES, min(len(SHAPES), 18))
+    anchor_done = False
+    for shape in anchor_shape_choices:
+        for coords in _candidate_wall_positions(shape, anchor_side, inner_h, inner_w, occ):
+            add_object(anchor_side, coords, "wall")
+            anchor_done = True
+            break
+        if anchor_done:
+            break
+    if not anchor_done:
+        return None
+
+    dep_shape_choices = random.sample(SHAPES, min(len(SHAPES), 24))
+    dep_done = False
+    for shape in dep_shape_choices:
+        for coords in _candidate_blocked_positions(shape, dependent_side, inner_h, inner_w, occ, blocker_id=0):
+            add_object(dependent_side, coords, "object")
+            dep_done = True
+            break
+        if dep_done:
+            break
+    if not dep_done:
+        return None
+
+    for side in side_list[2:]:
+        placed = False
+        for shape in random.sample(SHAPES, min(len(SHAPES), 20)):
+            cands = _candidate_wall_positions(shape, side, inner_h, inner_w, occ)
+            if not cands:
+                continue
+            add_object(side, cands[0], "wall")
+            placed = True
+            break
+        if not placed:
+            return None
+
+    initial = _choose_initial_positions(objects, inner_h, inner_w, anchor_id=0, dependent_id=1)
+    if initial is None:
+        return None
+
+    expected = _draw_frame(frame_h, frame_w)
+    for obj in objects:
+        coords = obj["final_coords"] + np.array([1, 1], dtype=int)
+        expected[coords[:, 0], coords[:, 1]] = SIDE_TO_COLOR[obj["side"]]
+
+    max_row_margin = max(1, (30 - frame_h) // 2)
+    max_col_margin = max(1, (30 - frame_w) // 2)
+    top_margin = random.randint(1, max_row_margin)
+    left_margin = random.randint(1, max_col_margin)
+    bottom_margin = random.randint(1, 30 - frame_h - top_margin)
+    right_margin = random.randint(1, 30 - frame_w - left_margin)
+    inp = np.zeros((top_margin + frame_h + bottom_margin, left_margin + frame_w + right_margin), dtype=int)
+    frame = _draw_frame(frame_h, frame_w)
+    inp[top_margin : top_margin + frame_h, left_margin : left_margin + frame_w] = frame
+    for obj in objects:
+        coords = initial[obj["id"]]["coords"] + np.array([top_margin + 1, left_margin + 1], dtype=int)
+        inp[coords[:, 0], coords[:, 1]] = OBJ
+
+    out, meta = _solve(inp, trace=True)
+    if not np.array_equal(out, expected):
+        return None
+
+    dkeys = [int(round(obj["dist"] * 2)) for obj in meta["objects"]]
+    if len(set(dkeys)) != len(dkeys):
+        return None
+    side_set = {obj["side"] for obj in meta["objects"]}
+    if len(side_set) < 3:
+        return None
+    blocker_ok = False
+    for obj in meta["objects"]:
+        if obj["stop_reason"] != "object":
+            continue
+        if not obj["blocker_ids"]:
+            continue
+        blocker_sides = {meta["objects"][bid]["side"] for bid in obj["blocker_ids"]}
+        if any(side != obj["side"] for side in blocker_sides):
+            blocker_ok = True
+            break
+    if not blocker_ok:
+        return None
+
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        sample = _make_layout()
+        if sample is not None:
+            return sample[0]
+    raise RuntimeError("failed to generate a valid puzzle instance")

