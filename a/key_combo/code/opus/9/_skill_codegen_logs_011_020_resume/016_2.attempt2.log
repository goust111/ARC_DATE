+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
