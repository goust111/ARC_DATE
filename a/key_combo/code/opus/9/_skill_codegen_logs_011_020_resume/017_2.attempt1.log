+def _wrong_same_column_inversion(grid: np.ndarray) -> np.ndarray:
+    sep, left, right = _split_panels(grid)
+    out = grid.copy()
+    same_col = np.where(left == RED, BLACK, BLUE)
+    out[:, sep + 1 :] = np.where(right == MAGENTA, same_col, right)
+    return out
