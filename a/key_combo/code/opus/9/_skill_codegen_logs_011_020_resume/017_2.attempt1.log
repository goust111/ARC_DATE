+    if not paired_signatures:
+        return []
+
+    total_damage = random.randrange(*DAMAGE_COUNT_RANGE)
+    chosen: list[tuple[int, int]] = []
+
+    def can_add(pos: tuple[int, int]) -> bool:
+        return all(max(abs(pos[0] - rr), abs(pos[1] - cc)) > 1 for rr, cc in chosen)
