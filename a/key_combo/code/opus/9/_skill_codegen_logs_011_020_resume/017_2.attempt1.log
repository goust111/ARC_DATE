    assert np.array_equal(out, mod._filled_output(inp)), i
print('precheck ok')

sigs = set()
for i in range(100):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert isinstance(inp, np.ndarray)
    assert isinstance(out, np.ndarray)
