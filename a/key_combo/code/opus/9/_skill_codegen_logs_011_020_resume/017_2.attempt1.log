+def _wrong_all_constant(grid: np.ndarray, color: int) -> np.ndarray:
+    sep, _left, right = _split_panels(grid)
+    out = grid.copy()
+    out[:, sep + 1 :] = np.where(right == MAGENTA, color, right)
+    return out
