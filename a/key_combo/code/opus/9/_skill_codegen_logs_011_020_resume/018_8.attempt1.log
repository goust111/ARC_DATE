+def build_input(
+    h: int,
+    w: int,
+    pluses: list[dict],
+    markers: list[dict],
+    guides: list[dict],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for plus in pluses:
+        for r, c in plus["cells"]:
+            grid[r, c] = PLUS_COLOR
+    for marker in markers:
+        for r, c in marker["seed"]:
+            grid[r, c] = int(marker["color"])
+    for guide in guides:
+        r, c = guide["pos"]
+        grid[r, c] = int(guide["color"])
