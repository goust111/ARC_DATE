   309	def marker_seed_cells(center: tuple[int, int], arm: int, direction: tuple[int, int], length: int) -> list[tuple[int, int]]:
   310	    r, c = center
   311	    if direction == (-1, 0):
   312	        return [(r - arm - offset, c) for offset in range(length, 0, -1)]
   313	    if direction == (1, 0):
   314	        return [(r + arm + offset, c) for offset in range(1, length + 1)]
   315	    if direction == (0, -1):
   316	        return [(r, c - arm - offset) for offset in range(length, 0, -1)]
   317	    if direction == (0, 1):
   318	        return [(r, c + arm + offset) for offset in range(1, length + 1)]
   319	    raise ValueError("bad direction")
