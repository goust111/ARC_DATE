+def choose_guides(
+    rng: np.random.Generator,
+    h: int,
+    w: int,
+    pluses: list[dict],
+) -> list[dict] | None:
+    corners = [(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)]
