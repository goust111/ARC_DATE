   191	            r = int(r)
   192	            c = int(c)
   193	            for nr, nc in neighbors4(r, c):
   194	                if 0 <= nr < h and 0 <= nc < w and plus_id_map[nr, nc] >= 0:
   195	                    plus_hits.add(int(plus_id_map[nr, nc]))
   196	                    side_hits.add((r - nr, c - nc))
   197	        if len(plus_hits) != 1 or len(side_hits) != 1:
   198	            raise AssertionError("marker must attach to exactly one plus on one side")
   199	        direction = next(iter(side_hits))
   200	        r0, c0, r1, c1 = bbox_coords(coords)
   201	        if direction[0] != 0:
   202	            if c0 != c1 or (r1 - r0 + 1) != len(coords):
   203	                raise AssertionError("vertical marker shape mismatch")
