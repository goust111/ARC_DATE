   252	def main(grid: np.ndarray) -> np.ndarray:
   253	    """
   254	    Recolor each plus's attached marker blocks from corner guides, then extend them as repeating rays.
   255	
   256	    Input structure:
   257	    - The background is black.
   258	    - Several large monochrome thin '+' shapes share one main color and do not touch.
   259	    - Small 1- or 2-pixel monochrome marker blocks sit immediately above, below, left, or right of a plus arm.
   260	    - Two or three single guide pixels occupy grid corners and are not the plus color.
   261	
   262	    Rule:
   263	    - Find every guide pixel and assign it to the unique nearest plus center by Manhattan distance.
   264	    - Recolor all marker blocks attached to a targeted plus with that guide color; if multiple guides target the same plus, use the closer guide.
   265	    - Remove the guide pixels to background.
   266	    - Marker blocks on untargeted pluses keep their original color.
   267	    - For every marker block, determine which side of its plus it touches and repeat the whole marker tile periodically away from that plus until the grid edge, never overwriting plus pixels.
   268	
   269	    Key insight:
   270	    - The corner guides are only remote color sources: they first choose a plus by nearest-center distance, and that transferred marker color then controls the outward ray color.
   271	    """
   272	    info = analyze_grid(np.array(grid, dtype=int))
   273	    g = np.array(grid, dtype=int)
   274	    out = g.copy()
   275	    bg = int(info["bg"])
   276	    plus_color = int(info["plus_color"])
   277	
   278	    for guide in info["guides"]:
   279	        rr, cc = guide["pos"]
   280	        out[rr, cc] = bg
   281	
   282	    for marker in info["markers"]:
   283	        color = int(info["target_color"].get(marker["plus_id"], marker["color"]))
   284	        for r, c in marker["coords"]:
   285	            out[int(r), int(c)] = color
   286	
   287	    for marker in info["markers"]:
   288	        r0, c0, r1, c1 = marker["bbox"]
   289	        tile = crop_bbox(out, (r0, c0, r1, c1))
   290	        extend_repeating_tile(
   291	            out,
   292	            tile,
   293	            r0,
   294	            c0,
   295	            marker["direction"],
   296	            bg=bg,
   297	            protect={plus_color},
   298	        )
   299	    return out
