+    for marker in info["markers"]:
+        r0, c0, r1, c1 = marker["bbox"]
+        tile = crop_bbox(out, (r0, c0, r1, c1))
+        extend_repeating_tile(
+            out,
+            tile,
+            r0,
+            c0,
+            marker["direction"],
+            bg=bg,
+            protect={plus_color},
+        )
+    return out
