+        r, c = pos
+        dists = [abs(r - pr) + abs(c - pc) for pr, pc in (plus["center"] for plus in pluses)]
+        best = min(dists)
+        if dists.count(best) != 1:
+            continue
+        infos.append(
+            {
+                "pos": pos,
+                "plus_index": int(dists.index(best)),
+                "distance": int(best),
+            }
