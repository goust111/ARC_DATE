   302	def plus_cells(center: tuple[int, int], arm: int) -> set[tuple[int, int]]:
   303	    r, c = center
   304	    cells = {(r, cc) for cc in range(c - arm, c + arm + 1)}
   305	    cells.update({(rr, c) for rr in range(r - arm, r + arm + 1)})
   306	    return cells
