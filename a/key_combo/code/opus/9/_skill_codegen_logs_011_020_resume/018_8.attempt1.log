+def choose_markers(
+    rng: np.random.Generator,
+    h: int,
+    w: int,
+    pluses: list[dict],
+) -> list[dict] | None:
+    n = len(pluses)
+    counts = [1] * n
+    if n == 3 and rng.random() < 0.8:
+        counts[int(rng.integers(0, n))] = 2
+    total = sum(counts)
