_GEN_N = 3
_GEN_SHAPE = (21, 21)
_GEN_BG = 0
_GEN_MARKER = 5
_GEN_BASE = 9
_GEN_BAR_COLORS = [1, 2, 3, 4, 6, 7, 8]

_GEN_FIRST_BAR_ROWS = (1, 2)
