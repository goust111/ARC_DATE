        if (nr, c) not in own and occupied[nr, c]:
            return True
    return False


def _gen_stable_candidates_top(
    H: int, W: int, occupied: np.ndarray, allowed: tuple[str, ...]
) -> list[tuple[str, tuple[tuple[int, int], ...]]]:
    candidates = []
