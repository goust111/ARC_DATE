+
+def _render_without_move(
+    grid: np.ndarray,
+    markers: list[tuple[int, int, int]],
+    frame: tuple[int, int, int, int],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    ir0, ic0, ir1, ic1 = _interior_bbox(frame)
+    out[ir0 : ir1 + 1, ic0 : ic1 + 1] = BG
