+
+def _sample_marker_columns(width: int) -> tuple[int, int] | None:
+    options = []
+    for left_c in range(6, width - 11):
+        for right_c in range(left_c + 6, width - 6):
+            if (left_c - 2) >= 4 and (width - (right_c + 2)) >= 4:
