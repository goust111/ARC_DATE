+    rects = _extract_rectangles(g)
+    counts = [rect["marker_count"] for rect in rects]
+    gaps = [counts[(idx + 1) % RECT_COUNT] for idx in range(RECT_COUNT)]
+    return _apply_rule(g, rects, gaps)
+
+
+def _build_rectangle(
+    h: int,
+    w: int,
+    frame_color: int,
