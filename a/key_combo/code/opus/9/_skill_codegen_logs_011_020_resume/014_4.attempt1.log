+    assert all(sep_cols[i + 1] - sep_cols[i] > 1 for i in range(len(sep_cols) - 1))
+
+    starts = [0] + [c + 1 for c in sep_cols]
+    ends = [c - 1 for c in sep_cols] + [grid.shape[1] - 1]
+    bounds = [(int(s), int(e)) for s, e in zip(starts, ends) if s <= e]
