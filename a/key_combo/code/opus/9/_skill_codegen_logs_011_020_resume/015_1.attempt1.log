+BACKGROUND = 1
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (2, 3, 4, 6, 7, 8, 9)
+SECTORS = ("up", "down", "left", "right")
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
