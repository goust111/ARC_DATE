+        expected, _info = _independent_expected(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        candidate = _build_candidate()
