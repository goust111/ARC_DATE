+        gbest = min(global_d2)
+        if global_d2.count(gbest) == 1:
+            gidx = global_d2.index(gbest)
+            if all_markers[gidx][2] != winner[2] and gbest < best:
+                firewall_case = True
+
+        objects_info.append(
+            {
+                "coords": coords,
+                "sector": sector,
+                "winner_color": int(winner[2]),
+                "winner_d2": int(best),
