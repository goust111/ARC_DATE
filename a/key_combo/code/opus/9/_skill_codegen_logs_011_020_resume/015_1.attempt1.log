+    expected = np.full_like(g, BACKGROUND)
+    expected[:] = g
+    for info in objects_info:
+        coords = info["coords"]
+        expected[coords[:, 0], coords[:, 1]] = info["winner_color"]
+    for r, c, _color, _sector in markers:
