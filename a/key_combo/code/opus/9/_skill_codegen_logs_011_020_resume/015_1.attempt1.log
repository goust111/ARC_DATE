+        winner_idx = distances.index(best)
+        winner = candidates[winner_idx]
+        winner_colors.append(int(winner[2]))
+
+        all_markers = [(mr, mc, color, sec) for sec, items in markers_by_sector.items() for mr, mc, color in items]
