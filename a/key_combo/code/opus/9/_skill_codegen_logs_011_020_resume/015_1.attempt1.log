+import numpy as np
+
+
+BACKGROUND = 1
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (2, 3, 4, 6, 7, 8, 9)
+SECTORS = ("up", "down", "left", "right")
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _sector_of(r: int, c: int, anchor_r: int, anchor_c: int) -> str | None:
+    dr = int(r) - int(anchor_r)
+    dc = int(c) - int(anchor_c)
+    if dr == 0 and dc == 0:
+        return None
+    adr = abs(dr)
+    adc = abs(dc)
+    if adr == adc:
+        return None
+    if adr < adc:
+        return "right" if dc > 0 else "left"
+    return "down" if dr > 0 else "up"
+
+
+def _ray_cells(shape: tuple[int, int], anchor_r: int, anchor_c: int) -> set[tuple[int, int]]:
+    cells = {(int(anchor_r), int(anchor_c))}
+    h, w = shape
+    for dr, dc in DIAGONALS:
+        rr, cc = anchor_r, anchor_c
+        while True:
+            rr += dr
+            cc += dc
+            if not (0 <= rr < h and 0 <= cc < w):
+                break
+            cells.add((int(rr), int(cc)))
+    return cells
+
+
+def _draw_rays(out: np.ndarray, anchor_r: int, anchor_c: int) -> None:
+    out[anchor_r, anchor_c] = BLACK
+    for dr, dc in DIAGONALS:
+        rr, cc = anchor_r, anchor_c
+        while True:
+            rr += dr
+            cc += dc
+            if not _in_bounds(out.shape, rr, cc):
+                break
+            out[rr, cc] = BLACK
