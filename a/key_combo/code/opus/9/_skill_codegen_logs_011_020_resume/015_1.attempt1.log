+
+
+def _sector_of(r: int, c: int, anchor_r: int, anchor_c: int) -> str | None:
+    dr = int(r) - int(anchor_r)
+    dc = int(c) - int(anchor_c)
+    if dr == 0 and dc == 0:
+        return None
+    adr = abs(dr)
+    adc = abs(dc)
+    if adr == adc:
+        return None
+    if adr < adc:
+        return "right" if dc > 0 else "left"
+    return "down" if dr > 0 else "up"
+
