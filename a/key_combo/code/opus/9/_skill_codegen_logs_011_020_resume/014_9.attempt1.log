        return None
    return [
        _gen_line(0, 0, 1, R - 1),
        _gen_line(1, 2 * R - 3, -1, R - 2),
    ]


def _gen_four_arm(R):
    if R > FOUR_ARM_MAX_ROWS:
        return None
    inner_max = min(FOUR_ARM_INNER_MAX, R - 1)
    return [
        _gen_line(0, 0, -1, R - 1),
