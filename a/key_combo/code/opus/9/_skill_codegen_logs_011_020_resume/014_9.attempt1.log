+    return sorted(lines)
+
+
+def _pair_mask(points: list[tuple[int, int]], shape: tuple[int, int]) -> tuple[np.ndarray, str, list[int]]:
+    h, w = shape
+    assert len(points) == 2
+    horizontal = any(_touches_border(pt, shape) for pt in points)
