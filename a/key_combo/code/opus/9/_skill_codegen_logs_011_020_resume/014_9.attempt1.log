    ]
    if merge_r < R - 1:
        segments.append(_gen_line(merge_r, merge_r, random.choice(DIAGONAL_DIRECTIONS), R - 1 - merge_r))
    return segments


def _gen_parallel_pair(R):
    sep = random.randint(*PARALLEL_SEP_RANGE)
