0047:     assert len(brackets) == 1, "expected exactly one corner bracket"
0048: 
0049:     bracket = brackets[0]
0050:     bracket_coords = {tuple(map(int, p)) for p in bracket["coords"]}
0051:     r0, c0, r1, c1 = bracket["bbox"]
0052:     markers = [
0053:         (r, c)
0054:         for r in range(r0, r1 + 1)
0055:         for c in range(c0, c1 + 1)
0056:         if (r, c) not in bracket_coords and g[r, c] != bg
0057:     ]
0058:     assert len(markers) == 1, "expected one marker inside the bracket"
0059: 
0060:     marker = markers[0]
0061:     marker_color = int(g[marker])
0062:     assert marker_color != bg and marker_color != int(bracket["color"])
0063: 
0064:     out = g.copy()
0065:     out[out == marker_color] = bg
0066:     out[marker] = marker_color
0067:     return out
