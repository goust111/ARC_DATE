+    row_spans = [(row_bars[i] + 1, row_bars[i + 1] - 1) for i in range(len(row_bars) - 1)]
+    col_spans = [(col_bars[i] + 1, col_bars[i + 1] - 1) for i in range(len(col_bars) - 1)]
