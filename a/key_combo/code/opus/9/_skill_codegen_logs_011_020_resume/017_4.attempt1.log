    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    axis_color, axis_r, axis_c = _find_cross_axes(g, bg)

    marker_coords = np.argwhere((g != bg) & (g != axis_color))
    assert marker_coords.size > 0, "expected sparse markers off the cross"

    out = g.copy()
