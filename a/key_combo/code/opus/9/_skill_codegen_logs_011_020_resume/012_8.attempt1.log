+        if grid is None:
+            continue
+        if _validate_case(grid, expected_output, expected_patches, piece_rots, hole_rots):
+            return grid, expected_output
+    raise AssertionError("failed to build valid layout")
+
+
+def generate_input() -> np.ndarray:
