+    "_arc_utils_task_8", "/home/lixinyu/snap/new/solvers/arc_utils.py"
+).load_module()
+Color = _ARC.Color
+bbox = _ARC.bbox
+components_mask = _ARC.components_mask
+crop_bbox = _ARC.crop_bbox
+find_components = _ARC.find_components
+paste = _ARC.paste
