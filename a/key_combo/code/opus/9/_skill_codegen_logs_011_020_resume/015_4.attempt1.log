0741:     h, w = patch.shape
0742:     border = int(border)
0743:     padding = int(padding)
0744:     bg = int(transparent)
0745: 
0746:     if h <= 0 or w <= 0:
0747:         return None
0748:     if H - h + 1 - border <= border or W - w + 1 - border <= border:
