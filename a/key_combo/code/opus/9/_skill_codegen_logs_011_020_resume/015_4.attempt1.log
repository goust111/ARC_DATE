0044: def main(grid: np.ndarray) -> np.ndarray:
0045:     """
0046:     Slide every foreground object horizontally to the right until it settles against the border or another settled object.
0047: 
0048:     Input structure
0049:     - The grid has a dominant background color and several separate 4-connected foreground objects.
0050:     - Each foreground object is a small multicolor rectangle-like sprite on the same canvas.
0051:     - Objects may overlap in their row ranges, so rightward movement can make a left object stop behind a right object.
0052: 
0053:     Rule
0054:     - Treat each 4-connected foreground object as a rigid sprite.
0055:     - Simultaneously move every sprite one column right whenever its next cells are inside the grid and not blocked by a sprite that cannot move.
0056:     - Repeat the simultaneous move until no sprite can move; preserve each sprite's internal colors and shape.
0057: 
0058:     Key insight
0059:     - The output is the terminal state of eastward gravity on the foreground sprites, not a recoloring or per-row sort.
0060:     """
0061:     g = np.asarray(grid, dtype=int)
0062:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0063: 
0064:     bg = get_bg(g)
0065:     components = components_mask(g != bg, connectivity=4)
0066:     assert components, "expected at least one foreground object"
0067: 
0068:     objects = []
0069:     for coords in components:
0070:         coords = coords.astype(int)
0071:         values = g[coords[:, 0], coords[:, 1]].astype(int)
0072:         objects.append((coords.copy(), values))
