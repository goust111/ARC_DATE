0025: def main(grid: np.ndarray) -> np.ndarray:
0026:     """Assemble the foreground objects by docking equal-colored boundary markers edge-to-edge.
0027: 
0028:     Input structure
0029:     The grid has a dominant background color and several 4-connected multicolor foreground
0030:     objects.  One foreground color is the body color; the less frequent foreground colors are
0031:     boundary connector markers, and each marker color appears once as a free end or twice as a
0032:     matched docking pair.
0033: 
0034:     Rule
0035:     Crop each foreground object to its bounding box and translate the objects so that the two
0036:     occurrences of every paired connector color touch on their exposed boundary sides.  Preserve
0037:     each object's orientation and colors, then return the tight crop around the assembled
0038:     foreground on the original background color.
0039: 
0040:     Key insight
0041:     The colored marker pixels are ports: matching colors specify which objects must touch, and
0042:     the marker's side of its object determines the direction of the translation.
0043:     """
0044:     g = np.asarray(grid, dtype=int)
0045:     bg = get_bg(g)
0046: 
0047:     fg = g[g != bg]
0048:     assert fg.size > 0
0049:     values, counts = np.unique(fg, return_counts=True)
0050:     max_count = int(counts.max())
0051:     body_candidates = [int(v) for v, n in zip(values, counts) if int(n) == max_count]
0052:     assert len(body_candidates) == 1
0053:     body = body_candidates[0]
0054:     marker_colors = {int(v) for v in values if int(v) != body}
0055:     assert marker_colors
0056: 
0057:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
0058:     assert len(components) >= 2
0059: 
0060:     sprites: list[np.ndarray] = []
0061:     marker_occurrences: dict[int, list[tuple[int, tuple[int, int], tuple[int, int]]]] = defaultdict(list)
0062:     for idx, comp in enumerate(components):
0063:         sprite = crop_bbox(g, comp["bbox"])
0064:         sprites.append(sprite)
0065:         marker_locs = np.argwhere(np.isin(sprite, list(marker_colors)))
0066:         assert marker_locs.size > 0
0067:         for rr, cc in marker_locs:
0068:             r, c = int(rr), int(cc)
0069:             direction = _connector_dir(sprite, r, c)
0070:             marker_occurrences[int(sprite[r, c])].append((idx, (r, c), direction))
0071: 
0072:     adjacency: list[list[tuple[int, tuple[int, int]]]] = [[] for _ in sprites]
0073:     paired_markers = 0
0074:     for occurrences in marker_occurrences.values():
0075:         assert len(occurrences) in (1, 2)
0076:         if len(occurrences) == 1:
0077:             continue
0078:         (a_idx, a_pos, a_dir), (b_idx, b_pos, b_dir) = occurrences
0079:         assert a_idx != b_idx
0080:         assert b_dir == (-a_dir[0], -a_dir[1])
0081:         delta = (a_pos[0] + a_dir[0] - b_pos[0], a_pos[1] + a_dir[1] - b_pos[1])
0082:         adjacency[a_idx].append((b_idx, delta))
0083:         adjacency[b_idx].append((a_idx, (-delta[0], -delta[1])))
0084:         paired_markers += 1
0085:     assert paired_markers == len(sprites) - 1
0086: 
0087:     placements: dict[int, tuple[int, int]] = {0: (0, 0)}
0088:     queue = deque([0])
0089:     while queue:
0090:         idx = queue.popleft()
0091:         base_r, base_c = placements[idx]
0092:         for nbr, (dr, dc) in adjacency[idx]:
0093:             pos = (base_r + dr, base_c + dc)
0094:             if nbr in placements:
0095:                 assert placements[nbr] == pos
0096:             else:
0097:                 placements[nbr] = pos
0098:                 queue.append(nbr)
0099:     assert len(placements) == len(sprites)
0100: 
