0014: def main(input_grid: np.ndarray) -> np.ndarray:
0015:     """
0016:     Complete each divided square by comparing it with the top-left template pattern.
0017: 
0018:     Input structure:
0019:     - A 3 by 3 layout of equal squares is separated by full divider lines of one color.
0020:     - The top-left square contains the complete pattern.
0021:     - Other squares contain black omissions from that same pattern.
0022: 
0023:     Rule:
0024:     - Detect the divider color and split the grid into square regions.
0025:     - Use the top-left region as the template.
0026:     - In every other region, fill template cells that are missing or different with the divider color.
0027: 
0028:     Key insight:
0029:     - The first region supplies the reference mask, and missing pattern cells are marked with
0030:       the separator color instead of recreating the original pattern color.
0031:     """
0032:     # Create a copy of the input grid to avoid modifying the original
0033:     output_grid = np.copy(input_grid)  
0034: 
0035:     # Detect the color of the lines
0036:     for r, row in enumerate(output_grid):
0037:         # Find the line
0038:         all_equal = np.unique(row).size == 1
0039:         if all_equal:
0040:             line_color = row[0]
0041:             break
0042:     
0043:     # Get all the squares seperated by lines in the grid
0044:     squares = find_components(output_grid, bg=line_color, connectivity=4, monochromatic=False, return_format="objects")
0045: 
0046:     # Get all squares' bounding box and cropped pattern
0047:     cropped_squares  = []
0048:     for obj in squares:
0049:         _b = bbox(obj != line_color)
0050:         assert _b is not None
0051:         r, c, _r1, _c1 = _b
0052:         width = _r1 - r + 1
0053:         height = _c1 - c + 1
0054:         _b = bbox(obj != line_color)
0055:         assert _b is not None
0056:         square = crop_bbox(obj, _b)
0057:         cropped_squares.append({'x': r, 'y': c, 'len': width, 'pattern': square})
0058: 
0059:     # Sort the squares by their position
0060:     cropped_squares = sorted(cropped_squares, key=lambda r: (r['x'], r['y']))
0061: 
0062:     # The top-left square contains the original pattern
0063:     template_pattern = cropped_squares[0]['pattern']
0064:     other_patterns = cropped_squares[1:]
0065: 
0066:     # Fill the missing pattern compared to template square with line color
0067:     for square in other_patterns:
0068:         r, c = square['x'], square['y']
0069:         square_pattern = square['pattern']
0070: 
0071:         # Fill the missing pattern compared to template square with line color
0072:         for i, j in np.argwhere(template_pattern != Color.BLACK):
0073:             if template_pattern[i, j] != square_pattern[i, j]:
0074:                 square_pattern[i, j] = line_color
0075: 
0076:         # Place the reconstructed pattern on the output grid
0077:         output_grid = paste(output_grid, square_pattern, r, c, transparent=Color.BLACK, clip=True)
0078: 
0079:     return output_grid
