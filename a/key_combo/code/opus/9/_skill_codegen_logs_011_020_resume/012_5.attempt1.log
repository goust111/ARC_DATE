+    ordered = sorted(counts.items(), key=lambda item: item[1])
+    out = np.full((len(ordered), max(counts.values())), BACKGROUND, dtype=int)
+    for r, (color, count) in enumerate(ordered):
+        out[r, :count] = color
+    return out
+
