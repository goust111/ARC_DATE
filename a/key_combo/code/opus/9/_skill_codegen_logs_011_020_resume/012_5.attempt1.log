+    items = list(zip(colors, counts))
+    random.shuffle(items)
+    for color, count in items:
+        for cell in cells[cursor : cursor + count]:
+            final_grid[cell] = int(color)
+            cell_color[cell] = int(color)
+            cell_source[cell] = source_layer[int(color)]
