def _gen_correlated_base() -> np.ndarray:
    """Return the free 16x16 domain before shifted reflections are applied."""
    coarse = np.random.choice(_GEN_PATTERN_COLORS, size=(_GEN_COARSE_SIZE, _GEN_COARSE_SIZE))
