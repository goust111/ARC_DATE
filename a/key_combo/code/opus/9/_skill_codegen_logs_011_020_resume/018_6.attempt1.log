+def _validate_input(grid: np.ndarray) -> tuple[int, int, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    cross_color, center = _find_cross(g)
+    assert cross_color in INPUT_CROSS_COLORS
+
