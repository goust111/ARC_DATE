+    box: tuple[int, int, int, int],
+    sep_r: int,
+    markers: list[tuple[int, int, int]],
+) -> bool:
+    r0, c0, r1, c1 = box
+    top = [m for m in markers if m[0] < sep_r]
+    bottom = [m for m in markers if m[0] > sep_r]
