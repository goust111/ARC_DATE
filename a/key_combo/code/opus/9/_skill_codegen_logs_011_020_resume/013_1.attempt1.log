+    if not np.array_equal(actual, oracle):
+        return None
+    if not _semantic_checks(inp, oracle, box, sep_r, markers):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
