+    grid_w = random.randint(frame_w + 2, min(30, frame_w + 8))
+
+    r0 = random.randint(1, grid_h - frame_h - 1)
+    c0 = random.randint(1, grid_w - frame_w - 1)
+    return grid_h, grid_w, r0, c0, top_h, bot_h
