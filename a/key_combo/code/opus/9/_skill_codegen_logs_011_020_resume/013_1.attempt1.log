+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    box = _frame_bbox(g)
+    sep_r = _separator_row(g, box)
+    markers = _markers(g, box, sep_r)
+    out = _apply_spec(g, box, sep_r, markers)
