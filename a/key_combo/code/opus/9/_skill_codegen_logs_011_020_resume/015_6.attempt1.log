+        r0, c0, r1, c1 = bbox
+        border_coords = [(r0 + rr, c0 + cc) for rr, cc in np.argwhere(border)]
+        frames.append(
+            {
+                "id": idx,
+                "bbox": bbox,
+                "inner_bbox": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+                "inner_h": ph - 2,
+                "inner_w": pw - 2,
+                "border_coords": border_coords,
+            }
+        )
