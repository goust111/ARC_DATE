+        ph, pw = patch.shape
+        if ph < 3 or pw < 3:
+            continue
+        border = np.ones((ph, pw), dtype=bool)
+        border[1:-1, 1:-1] = False
+        if not np.all(patch[border] == FRAME):
+            continue
+        if not np.all(patch[~border] == BG):
+            continue
