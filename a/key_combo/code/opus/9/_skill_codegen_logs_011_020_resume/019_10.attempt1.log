+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+_RNG = np.random.default_rng()
+_PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+_GEN_RETRIES = 400
+
+
+def _full_span_bars(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
