+    colors, counts = np.unique(values, return_counts=True)
+    order = np.argsort(-counts)
+    if len(order) >= 2 and int(counts[order[0]]) == int(counts[order[1]]):
+        raise ValueError("line majority is not unique")
+    return int(colors[order[0]])
+
