from __future__ import annotations
import numpy as np
from arc_utils import colors_present, crop_bbox, find_components, get_bg, paste, random_free_location
from arc_utils import find_components, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.

    Input structure:
    - bg = background color.
    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).

    Rule:
    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).

    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    # Find multicolor connected components of the foreground as a whole.
    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
    assert not (len(comps) != 2)

    infos = []
    for comp in comps:
        patch = crop_bbox(g, comp["bbox"])
        cols = colors_present(patch, exclude={bg})
        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})

    # Building block is the component with >=2 colors (or more unique colors), preferring square.
    infos.sort(
        key=lambda d: (
            len(d["cols"]) >= 2,
            len(d["cols"]),
            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
        ),
        reverse=True,
    )
    block = infos[0]["patch"]
    ctrl = infos[1]["patch"]

    bh, bw = map(int, block.shape)
    ch, cw = map(int, ctrl.shape)

    ctrl_cols = colors_present(ctrl, exclude={bg})
    if not ctrl_cols:
        return np.full((0, 0), int(bg), dtype=int)

    ctrl_col = int(ctrl_cols[0])
    mask = (ctrl == int(ctrl_col))

    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if bool(mask[r, c]):
                paste(out, block, r * bh, c * bw)
    return out

# --------------- generator (Codex#3) ---------------

def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
    seen: set[tuple[int, int]] = set()
    out: list[tuple[list[tuple[int, int]], bool]] = []
    s = int(size)
    for r in range(s):
        for c in range(s):
            if (r, c) in seen:
                continue
            orbit = {
                (r, c),
                (c, s - 1 - r),
                (s - 1 - r, s - 1 - c),
                (s - 1 - c, r),
                (r, s - 1 - c),
                (s - 1 - r, c),
                (c, r),
                (s - 1 - c, s - 1 - r),
            }
            cells = sorted(orbit)
            seen.update(cells)
            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
            out.append((cells, border))
    return out


def _make_tile(bg: int, fg_colors: list[int], rng: np.random.Generator) -> np.ndarray:
    size = int(rng.integers(3, 6))
    n_tile_colors = int(rng.integers(2, 4))
    tile_colors = list(rng.choice(fg_colors, size=n_tile_colors, replace=False))
    orbits = _dihedral_orbits(size)
    rng.shuffle(orbits)

    tile = np.full((size, size), int(bg), dtype=int)
    assignments: dict[int, int] = {}
    for i, color in enumerate(tile_colors):
        assignments[i] = int(color)

    interior_idxs = [i for i, (_cells, border) in enumerate(orbits) if not border and i not in assignments]
    if interior_idxs and rng.random() < 0.25:
        assignments[int(rng.choice(interior_idxs))] = int(bg)

    for i, (_cells, border) in enumerate(orbits):
        if i not in assignments:
            palette = tile_colors if border else tile_colors + ([bg] if interior_idxs else [])
            assignments[i] = int(rng.choice(palette))

    for i, (cells, _border) in enumerate(orbits):
        for r, c in cells:
            tile[r, c] = assignments[i]
    return tile


def _neighbors8(h: int, w: int, r: int, c: int) -> list[tuple[int, int]]:
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            rr = r + dr
            cc = c + dc
            if 0 <= rr < h and 0 <= cc < w:
                out.append((rr, cc))
    return out


def _make_ctrl(bg: int, color: int, rng: np.random.Generator) -> np.ndarray:
    h = int(rng.integers(3, 6))
    w = int(rng.integers(3, 6))
    area = h * w
    min_fill = (area + 1) // 2
    max_fill = int(np.floor(0.72 * area))
    target = int(rng.integers(min_fill, max_fill + 1))

    ar = int(rng.integers(0, h))
    ac = int(rng.integers(0, w))
    mask = np.zeros((h, w), dtype=bool)
    mask[:, ac] = True
    mask[ar, :] = True

    while int(mask.sum()) < target:
        frontier = []
        for r in range(h):
            for c in range(w):
                if mask[r, c]:
                    continue
                if any(mask[rr, cc] for rr, cc in _neighbors8(h, w, r, c)):
                    frontier.append((r, c))
        pick = frontier[int(rng.integers(len(frontier)))]
        mask[pick] = True

    ctrl = np.full((h, w), int(bg), dtype=int)
    ctrl[mask] = int(color)
    return ctrl


def _compose_output(tile: np.ndarray, ctrl: np.ndarray, bg: int) -> np.ndarray:
    th, tw = tile.shape
    ch, cw = ctrl.shape
    out = np.full((ch * th, cw * tw), int(bg), dtype=int)
    for r in range(ch):
        for c in range(cw):
            if ctrl[r, c] != bg:
                paste(out, tile, r * th, c * tw)
    return out


def _make_input(tile: np.ndarray, ctrl: np.ndarray, bg: int, rng: np.random.Generator) -> np.ndarray:
    horizontal = bool(rng.integers(0, 2))
    gap = 1

    if horizontal:
        if rng.random() < 0.5:
            left_obj, right_obj = tile, ctrl
        else:
            left_obj, right_obj = ctrl, tile
        lh, lw = left_obj.shape
        rh, rw = right_obj.shape
        H = int(rng.integers(max(10, max(lh, rh)), 19))
        W = int(rng.integers(max(10, lw + rw + gap), 19))
        slack = W - (lw + rw + gap)
        c_left = int(rng.integers(0, slack + 1))
        c_right = int(rng.integers(c_left + lw + gap, W - rw + 1))
        r_left = int(rng.integers(0, H - lh + 1))
        r_right = int(rng.integers(0, H - rh + 1))
        if left_obj is tile:
            tile_pos = (r_left, c_left)
            ctrl_pos = (r_right, c_right)
        else:
            ctrl_pos = (r_left, c_left)
            tile_pos = (r_right, c_right)
    else:
        if rng.random() < 0.5:
            top_obj, bot_obj = tile, ctrl
        else:
            top_obj, bot_obj = ctrl, tile
        th, tw = top_obj.shape
        bh, bw = bot_obj.shape
        H = int(rng.integers(max(10, th + bh + gap), 19))
        W = int(rng.integers(max(10, max(tw, bw)), 19))
        slack = H - (th + bh + gap)
        r_top = int(rng.integers(0, slack + 1))
        r_bot = int(rng.integers(r_top + th + gap, H - bh + 1))
        c_top = int(rng.integers(0, W - tw + 1))
        c_bot = int(rng.integers(0, W - bw + 1))
        if top_obj is tile:
            tile_pos = (r_top, c_top)
            ctrl_pos = (r_bot, c_bot)
        else:
            ctrl_pos = (r_top, c_top)
            tile_pos = (r_bot, c_bot)

    grid = np.full((H, W), int(bg), dtype=int)
    paste(grid, tile, *tile_pos)
    paste(grid, ctrl, *ctrl_pos, transparent=bg)
    return grid


from __future__ import annotations

import numpy as np

from arc_utils import Color, bbox, components_mask, crop_bbox, get_bg, paste, random_free_location
import random


def _template_window(g: np.ndarray, fill_color: int) -> np.ndarray:
    template_bbox = bbox(g == fill_color)
    assert template_bbox is not None, "expected a fill-color template"
    template = crop_bbox(g, template_bbox)
    assert template.shape == (3, 3), "expected a 3x3 template bbox"
    return template


def main(grid: np.ndarray) -> np.ndarray:
    """
    Complete each partial copy of the yellow-marked 3x3 template by adding the template's yellow cells.

    Input structure
    - A black background contains scattered blue/teal distractors and one full 3x3 sprite whose yellow pixels mark the cells to add.
    - The yellow pixels' bounding box is the full template window.
    - Partial copies elsewhere already contain the template's non-yellow pixels in the same relative positions.

    Rule
    - Use the yellow bounding box as the 3x3 template.
    - Search every 3x3 window for an exact match to the template's non-yellow pixels.
    - At each matching window, paint yellow into the positions that are yellow in the template.

    Key insight
    - Yellow is not a target marker; it identifies the missing-cell mask to transfer onto every same-layout partial copy.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = int(get_bg(g))
    fill_color = int(Color.YELLOW)
    assert fill_color != bg, "fill color must differ from background"

    template = _template_window(g, fill_color)
    assert np.all(template != bg), "template window should be fully occupied"
    fill_mask = template == fill_color
    support_mask = template != fill_color
    assert np.any(fill_mask), "template must contain fill cells"
    assert np.any(support_mask), "template must contain support cells"

    height, width = map(int, g.shape)
    th, tw = map(int, template.shape)
    origins: list[tuple[int, int]] = []
    partial_count = 0
    for r in range(height - th + 1):
        for c in range(width - tw + 1):
            window = g[r : r + th, c : c + tw]
            if not np.array_equal(window[support_mask], template[support_mask]):
                continue
            if not np.all(np.isin(window[fill_mask], [bg, fill_color])):
                continue
            origins.append((r, c))
            if np.any(window[fill_mask] == bg):
                partial_count += 1

    assert origins, "expected at least the source template to match"
    assert partial_count >= 1, "expected at least one partial copy to complete"

    out = g.copy()
    for r, c in origins:
        patch = out[r : r + th, c : c + tw]
        patch[fill_mask] = fill_color
    return out

# --------------- generator (o5x) ---------------

# Canvas/template structure.
GRID_SHAPE = (22, 22)
TEMPLATE_SIZE = 3
EMPTY_COLOR, FILL_COLOR = 0, int(Color.YELLOW)
SUPPORT_COLORS = (int(Color.BLUE), int(Color.TEAL))
FILL_COUNT_RANGE, PARTIAL_COPY_RANGE = (4, 6), (1, 2)

# Distractor sampling.
DISTRACTOR_TOTAL_RANGE = (47, 85)
DISTRACTOR_CLUSTER_MAX, DISTRACTOR_MISS_LIMIT, DISTRACTOR_CONNECTIVITY = 7, 80, 8
SINGLE_CELL_CLUSTER_PROB = 0.68
ORTHOGONAL_STEPS = ((1, 0), (-1, 0), (0, 1), (0, -1))

# Retry policy.
GENERATION_ATTEMPTS = 300


def _gen_template() -> tuple[np.ndarray, np.ndarray]:
    fill_count = random.randint(*FILL_COUNT_RANGE)
    fill = {
        (0, random.randrange(TEMPLATE_SIZE)),
        (TEMPLATE_SIZE - 1, random.randrange(TEMPLATE_SIZE)),
        (random.randrange(TEMPLATE_SIZE), 0),
        (random.randrange(TEMPLATE_SIZE), TEMPLATE_SIZE - 1),
    }
    remaining = [(r, c) for r in range(TEMPLATE_SIZE) for c in range(TEMPLATE_SIZE) if (r, c) not in fill]
    random.shuffle(remaining)
    for coord in remaining[: fill_count - len(fill)]:
        fill.add(coord)

    template = np.zeros((TEMPLATE_SIZE, TEMPLATE_SIZE), dtype=int)
    fill_mask = np.zeros((TEMPLATE_SIZE, TEMPLATE_SIZE), dtype=bool)
    for r, c in fill:
        fill_mask[r, c] = True
        template[r, c] = FILL_COLOR

    support = [(r, c) for r in range(TEMPLATE_SIZE) for c in range(TEMPLATE_SIZE) if not fill_mask[r, c]]
    support_colors = list(SUPPORT_COLORS)
    support_colors += [random.choice(SUPPORT_COLORS) for _ in range(len(support) - 2)]
    random.shuffle(support_colors)
    for (r, c), color in zip(support, support_colors):
        template[r, c] = color
    return template, fill_mask


def _gen_support_match_origins(
    grid: np.ndarray, template: np.ndarray, intended_origins: set[tuple[int, int]]
) -> list[tuple[int, int]]:
    support_mask = template != FILL_COLOR
    bad: list[tuple[int, int]] = []
    for r in range(grid.shape[0] - TEMPLATE_SIZE + 1):
        for c in range(grid.shape[1] - TEMPLATE_SIZE + 1):
            if (r, c) in intended_origins:
                continue
            window = grid[r : r + TEMPLATE_SIZE, c : c + TEMPLATE_SIZE]
            if np.array_equal(window[support_mask], template[support_mask]):
                bad.append((r, c))
    return bad


def _gen_cluster_offsets(size: int) -> list[tuple[int, int]]:
    cells = [(0, 0)]
    while len(cells) < size:
        r, c = random.choice(cells)
        dr, dc = random.choice(ORTHOGONAL_STEPS)
        nxt = (r + dr, c + dc)
        if nxt not in cells:
            cells.append(nxt)
    min_r = min(r for r, _ in cells)
    min_c = min(c for _, c in cells)
    return [(r - min_r, c - min_c) for r, c in cells]


def _gen_try_place_distractor_cluster(
    grid: np.ndarray,
    offsets: list[tuple[int, int]],
    intended_origins: set[tuple[int, int]],
    reserved_mask: np.ndarray,
    template: np.ndarray,
) -> int:
    colors = [random.choice(SUPPORT_COLORS) for _ in offsets]
    max_r = grid.shape[0] - max(r for r, _ in offsets)
    max_c = grid.shape[1] - max(c for _, c in offsets)
    anchors = [(r, c) for r in range(max_r) for c in range(max_c)]
    random.shuffle(anchors)

    for r0, c0 in anchors:
        coords = [(r0 + dr, c0 + dc) for dr, dc in offsets]
        if any(grid[r, c] != EMPTY_COLOR for r, c in coords):
            continue
        trial = grid.copy()
        for (r, c), color in zip(coords, colors):
            trial[r, c] = color
        if _gen_support_match_origins(trial, template, intended_origins):
            continue
        distractor_mask = (trial != EMPTY_COLOR) & ~reserved_mask
        if any(
            len(comp) > DISTRACTOR_CLUSTER_MAX
            for comp in components_mask(distractor_mask, connectivity=DISTRACTOR_CONNECTIVITY)
        ):
            continue
        grid[:, :] = trial
        return len(coords)
    return 0


def _gen_add_distractors(
    grid: np.ndarray,
    template: np.ndarray,
    intended_origins: set[tuple[int, int]],
    reserved_mask: np.ndarray,
    target: int,
) -> bool:
    placed = 0
    misses = 0
    while placed < target and misses < DISTRACTOR_MISS_LIMIT:
        remaining = target - placed
        if remaining == 1 or random.random() < SINGLE_CELL_CLUSTER_PROB:
            size = 1
        else:
            size = random.randint(2, min(DISTRACTOR_CLUSTER_MAX, remaining))
        offsets = _gen_cluster_offsets(size)
        added = _gen_try_place_distractor_cluster(grid, offsets, intended_origins, reserved_mask, template)
        if added:
            placed += added
            misses = 0
        else:
            misses += 1
    return placed == target


def _gen_place_template_copies(
    grid: np.ndarray, template: np.ndarray
) -> tuple[tuple[int, int], list[tuple[int, int]]]:
    """Place the source template, then output-state copies to hide later."""
    source_origin = random_free_location(grid, template, transparent=EMPTY_COLOR)
    paste(grid, template, *source_origin)

    partial_origins: list[tuple[int, int]] = []
    for _ in range(random.randint(*PARTIAL_COPY_RANGE)):
        origin = random_free_location(grid, template, transparent=EMPTY_COLOR)
        paste(grid, template, *origin)
        partial_origins.append(origin)
    return source_origin, partial_origins


