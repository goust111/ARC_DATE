+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+FG_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+MAX_RETRIES = 400
+
+SEEDS = (
+    ((0, 0), (0, 1), (1, 0)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (0, 1), (1, 1), (2, 1)),
+    ((0, 1), (1, 0), (1, 1), (2, 1), (2, 2)),
+)
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _mask_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    comps = _mask_components(grid != WALL)
+    regions: list[dict] = []
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        assert len(comp) == hh * ww, "expected every wall-bounded region to be rectangular"
+        regions.append({"bbox": (r0, c0, r1, c1), "h": hh, "w": ww})
+    regions.sort(key=lambda item: item["bbox"])
+    return regions
+
+
+def _region_kind(h: int, w: int) -> str:
+    if h == w:
+        return "rot"
+    if w == 2 * h:
+        return "hmirror"
+    if h == 2 * w:
+        return "vmirror"
+    raise AssertionError(f"unsupported region ratio {(h, w)}")
+
+
+def _transform_coords(coords: set[tuple[int, int]], h: int, w: int, kind: str) -> set[tuple[int, int]]:
+    out = set(coords)
+    if kind == "rot":
+        for r, c in list(coords):
+            out.add((c, h - 1 - r))
+            out.add((h - 1 - r, w - 1 - c))
+            out.add((w - 1 - c, r))
+    elif kind == "hmirror":
+        for r, c in list(coords):
+            out.add((r, w - 1 - c))
+    elif kind == "vmirror":
+        for r, c in list(coords):
+            out.add((h - 1 - r, c))
+    elif kind == "hflip":
+        for r, c in list(coords):
+            out.add((r, w - 1 - c))
+    elif kind == "vflip":
+        for r, c in list(coords):
+            out.add((h - 1 - r, c))
+    elif kind == "rot180":
+        for r, c in list(coords):
+            out.add((h - 1 - r, w - 1 - c))
+    else:
+        raise AssertionError(f"unknown transform {kind}")
+    return {(r, c) for r, c in out if 0 <= r < h and 0 <= c < w}
