+GRID_H_RANGE = (6, 10)
+GRID_W_RANGE = (8, 12)
+GEN_RETRIES = 400
+
+L_CORNERS = ((0, 0), (0, 1), (1, 0), (1, 1))
+DISTRACTOR_SHAPES = (
+    ((0, 0), (0, 1), (0, 2), (1, 1)),  # top T
+    ((0, 1), (1, 0), (1, 1), (1, 2)),  # bottom T
+    ((0, 0), (1, 0), (2, 0), (1, 1)),  # left T
+    ((0, 1), (1, 0), (1, 1), (2, 1)),  # right T
+    ((0, 0), (0, 1), (1, 1), (1, 2)),  # zig-zag
+    ((0, 0), (1, 0), (2, 0), (2, 1)),  # hook
+    ((0, 0), (0, 1), (0, 2)),          # line
+    ((0, 0), (1, 0), (2, 0)),          # line
