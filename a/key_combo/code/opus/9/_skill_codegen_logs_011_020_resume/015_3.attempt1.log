+def _gen_attempt() -> np.ndarray | None:
+    num_rects = random.choice([3, 4])
+    base_w = random.choice([5, 6])
+    widths = [base_w]
+    for _ in range(num_rects - 1):
+        widths.append(random.choice([base_w, min(base_w + 1, 7)]))
