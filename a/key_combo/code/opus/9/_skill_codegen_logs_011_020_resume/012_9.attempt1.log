# Expansion/markers: 2-3 left/right/bottom controls, no top expansion.
EXPANDABLE_SIDES = ["left", "right", "bottom"]
SIDE_COUNT_RANGE = (2, 3)
EXPANSION_RANGE = (1, 6)
