+    grid[:, :panel_w] = BLUE
+    grid[:, panel_w + 1 :] = GREEN
+    grid[left_coords[:, 0], left_coords[:, 1]] = RED
+    grid[right_coords[:, 0], panel_w + 1 + right_coords[:, 1]] = YELLOW
