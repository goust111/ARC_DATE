+def _endpoint_cells(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int, int]]]:
+    reds = [tuple(map(int, rc)) for rc in np.argwhere(grid == RED)]
+    others: list[tuple[int, int, int]] = []
