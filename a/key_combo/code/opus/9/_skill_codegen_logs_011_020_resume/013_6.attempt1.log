+                        prev = rc.get((gr, gc), 0)
+                        if prev >= 2:
+                            ok = False
+                            break
+                        if (gr, gc) in open_set:
+                            overlap += 1
+                    if ok:
+                        moves.append((idx, top, left, overlap))
