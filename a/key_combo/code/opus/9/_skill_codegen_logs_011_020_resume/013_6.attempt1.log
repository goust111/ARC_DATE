+
+    a = (outer_r0, inner_c0)
+    b = (outer_r0, inner_c0 + 1)
+    path = _perimeter_path(outer_box)
+    idx_a = path.index(a)
+    idx_b = path.index(b)
+    long_chain = [path[(idx_b + step) % len(path)] for step in range(len(path))]
+    while long_chain[-1] != a:
+        long_chain.pop()
