+        pieces = []
+        lengths = []
+        valid = True
+        for i, start in enumerate(cut_idxs):
+            end = cut_idxs[(i + 1) % len(cut_idxs)]
+            arc = (end - start) % len(path)
+            if not (4 <= arc <= 11):
