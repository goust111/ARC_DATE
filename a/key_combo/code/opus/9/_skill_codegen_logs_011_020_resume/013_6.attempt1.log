+        (outer_r0, outer_c0),
+        (outer_r0, outer_c1),
+        (outer_r1, outer_c1),
+        (outer_r1, outer_c0),
+    }
+    outer_piece_paths = _split_open_chain(long_chain, outer_corners)
+    if outer_piece_paths is None:
