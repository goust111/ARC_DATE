+
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        instance = _instance_attempt()
+        if instance is not None:
+            return instance[0]
+    raise RuntimeError("failed to generate a valid nested-frame connector puzzle")

