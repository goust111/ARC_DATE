+        piece_patches.append(patch)
+        piece_final_tops.append((box[0], box[1]))
+
+    pre_local = np.full(local_shape, BG, dtype=int)
+    _draw_frame(pre_local, outer_box, outer_color)
+    _draw_frame(pre_local, inner_box, inner_color)
+    for r, c in yellow_cells:
+        pre_local[r, c] = YELLOW
+    out_local = _recolor_by_outermost(pre_local, _find_frames(pre_local))
+    if np.array_equal(pre_local, out_local):
+        return None
+
+    local_mask = pre_local != BG
+    local_bbox = bbox_coords(np.argwhere(local_mask))
+    bbox_h = local_bbox[2] - local_bbox[0] + 1
+    bbox_w = local_bbox[3] - local_bbox[1] + 1
+
+    height = random.randint(max(20, bbox_h + 8), 28)
+    width = random.randint(max(20, bbox_w + 8), 28)
+    if height > 30 or width > 30:
+        return None
+
+    assembly_top = random.randint(1, height - local_shape[0] - 1)
+    assembly_left = random.randint(1, width - local_shape[1] - 1)
+
+    expected = np.full((height, width), BG, dtype=int)
+    rr, cc = np.argwhere(pre_local != BG).T
+    expected[rr + assembly_top, cc + assembly_left] = out_local[rr, cc]
+
+    reserved = np.zeros((height, width), dtype=bool)
+    rr0 = max(0, assembly_top + local_bbox[0] - 1)
+    cc0 = max(0, assembly_left + local_bbox[1] - 1)
+    rr1 = min(height - 1, assembly_top + local_bbox[2] + 1)
+    cc1 = min(width - 1, assembly_left + local_bbox[3] + 1)
+    reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+    inp = np.full((height, width), BG, dtype=int)
+    anchor_patch = piece_patches[anchor_idx]
+    anchor_top = assembly_top + piece_final_tops[anchor_idx][0]
+    anchor_left = assembly_left + piece_final_tops[anchor_idx][1]
+    paste(inp, anchor_patch, anchor_top, anchor_left)
+
+    def can_place(patch: np.ndarray, top: int, left: int) -> bool:
+        coords = np.argwhere(patch != BG)
+        for pr, pc in coords:
+            gr = top + int(pr)
+            gc = left + int(pc)
+            if reserved[gr, gc] or inp[gr, gc] != BG:
+                return False
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
