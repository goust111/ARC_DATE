+SEP = 5
+EDGE = 2
+BLOCK = 5
+INNER_COLORS = [1, 3, 4, 6, 7, 8]
+SIGNATURE_POOL = [
+    (0,),
+    (1,),
+    (2,),
+    (3,),
+    (4,),
+    (0, 2),
+    (0, 3),
+    (0, 4),
+    (1, 3),
+    (1, 4),
+    (2, 4),
+    (0, 1, 3),
+    (0, 2, 4),
