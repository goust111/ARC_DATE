+    for rows in range(1, n + 1):
+        if n % rows != 0:
+            continue
+        cols = n // rows
+        h = rows * BLOCK + rows - 1
+        w = cols * BLOCK + cols - 1
+        if h <= 30 and w <= 30:
+            pairs.append((rows, cols))
+    return pairs
+
+
+def _assemble_grid(blocks: list[np.ndarray], rows: int, cols: int, placement: list[int]) -> np.ndarray:
+    h = rows * BLOCK + rows - 1
+    w = cols * BLOCK + cols - 1
+    grid = np.full((h, w), SEP, dtype=int)
