+    color = int(colors[0])
+    mask = block == color
+    assert mask[1:4, 1:4].any()
+    assert not mask[0, :].any()
+    assert not mask[-1, :].any()
+    assert not mask[:, 0].any()
+    assert not mask[:, -1].any()
+    return color, mask
