+
+
+def _distinct_shape_count(blocks: list[np.ndarray]) -> int:
+    patterns = set()
+    for block in blocks:
+        _color, mask = _inner_mask_info(block)
+        patterns.add(tuple(map(int, mask[1:4, 1:4].flatten().tolist())))
+    return len(patterns)
+
+
