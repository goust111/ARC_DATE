+    block = np.full((BLOCK, BLOCK), BG, dtype=int)
+    for r in left_sig:
+        block[int(r), 0] = EDGE
+    for r in right_sig:
+        block[int(r), BLOCK - 1] = EDGE
+    for c in top_sig:
+        block[0, int(c)] = EDGE
+    for c in bottom_sig:
+        block[BLOCK - 1, int(c)] = EDGE
