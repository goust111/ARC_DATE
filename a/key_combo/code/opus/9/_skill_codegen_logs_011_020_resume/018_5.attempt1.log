+    ordered = [blocks[idx].copy() for idx in chain]
+    strip_without_rotation = np.full_like(out, SEP)
+    for idx, block in enumerate(ordered):
+        c0 = idx * (BLOCK + 1)
+        strip_without_rotation[:, c0 : c0 + BLOCK] = block
