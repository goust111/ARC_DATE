+        dr, dc, _score = random.choice(far[: max(1, min(10, len(far)))])
+        return (tr, tc), targets, (dr, dc)
+    return None
+
+
+def _distractor_relation(
+    patch: np.ndarray, template: np.ndarray, swapped: np.ndarray
+) -> str | None:
+    if np.array_equal(patch, template):
