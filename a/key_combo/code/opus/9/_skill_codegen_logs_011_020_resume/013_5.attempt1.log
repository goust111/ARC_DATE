+    objects: list[dict] = []
+    for coords in comps:
+        box = bbox_coords(coords)
+        h = bbox_h(box)
+        w = bbox_w(box)
+        if int(coords.shape[0]) != int(h * w):
+            continue
+        patch = crop_bbox(grid, box)
+        colors = sorted(set(map(int, patch.reshape(-1))))
+        objects.append(
+            {
+                "coords": coords,
+                "bbox": box,
+                "shape": (int(h), int(w)),
