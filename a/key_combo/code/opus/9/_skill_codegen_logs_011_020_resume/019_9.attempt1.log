+    if not coords:
+        return False
+    return _bbox_from_coords(coords) == (0, 0, 2, 2)
+
+
+def _marker_candidates_inside(full_mask: np.ndarray, marker_count: int) -> list[np.ndarray]:
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(full_mask)]
