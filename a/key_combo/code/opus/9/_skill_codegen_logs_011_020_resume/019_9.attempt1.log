def _frame_patch(h: int, w: int) -> np.ndarray:
    assert h >= 6 and w >= 6
    assert h % 2 == 0 and w % 2 == 0

    patch = np.full((h, w), 4, dtype=int)
    mid_r = h // 2
    mid_c = w // 2

    patch[:2, :mid_c] = 6
    patch[:2, mid_c:] = 1
    patch[h - 2 :, :mid_c] = 2
    patch[h - 2 :, mid_c:] = 3

    patch[2:mid_r, :2] = 6
    patch[2:mid_r, w - 2 :] = 1
    patch[mid_r : h - 2, :2] = 2
    patch[mid_r : h - 2, w - 2 :] = 3

    return patch


