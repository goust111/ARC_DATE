+def _grid_structure(g: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    h, w = g.shape
+    row_seps = [r for r in range(h) if _is_separator_line(g[r, :])]
+    col_seps = [c for c in range(w) if _is_separator_line(g[:, c])]
