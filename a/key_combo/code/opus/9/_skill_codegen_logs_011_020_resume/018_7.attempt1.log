+    col_spans = _regular_intervals(col_seps, w)
+    assert len(row_spans) == 3 and len(col_spans) == 3
+    block_h = {r1 - r0 for r0, r1 in row_spans}
+    block_w = {c1 - c0 for c0, c1 in col_spans}
