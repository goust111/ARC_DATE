+    bounds = [-1, *separators, int(length)]
+    spans = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
+    sizes = [b - a for a, b in spans]
+    assert spans and min(sizes) > 0
+    assert len(set(sizes)) == 1
+    return spans
+
