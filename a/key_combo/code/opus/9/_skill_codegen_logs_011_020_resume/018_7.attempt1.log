def paste(
    dst: np.ndarray,
    patch: np.ndarray,
    r0: int,
    c0: int,
    *,
    transparent: int | None = None,
    mask: np.ndarray | None = None,
    overwrite: bool = True,
    clip: bool = False,
) -> np.ndarray:
    """
