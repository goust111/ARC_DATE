EDGE_CONTACT_OFFSETS = [1, 2, 3]  # valid shared-edge contact rows/cols (interior only)
FILLER_ROWS = [1, 3]            # fallback interior rows for minimum-area seed

GRID_LAYOUT_PROB = 0.5          # probability of 2x2 grid layout when n=4
