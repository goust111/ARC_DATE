+        monochromatic: bool = True,
+        colors: list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        if return_format != "dict":
+            raise ValueError("fallback find_components only supports return_format='dict'")
+        if bg is None:
