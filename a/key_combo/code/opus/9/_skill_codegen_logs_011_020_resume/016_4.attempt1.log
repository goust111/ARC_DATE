+        bg = int(bg)
+        wanted = None if colors is None else {int(c) for c in colors if int(c) != bg}
+        h, w = grid.shape
+        seen = np.zeros((h, w), dtype=bool)
+        if connectivity == 4:
+            neighbors = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        else:
