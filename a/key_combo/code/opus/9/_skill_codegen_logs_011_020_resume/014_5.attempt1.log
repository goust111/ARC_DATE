+
+def _find_separator_row(grid: np.ndarray) -> int:
+    yellow_rows = np.flatnonzero(np.all(grid == YELLOW, axis=1))
+    assert len(yellow_rows) == 1, "expected exactly one full-width yellow separator row"
+    sep = int(yellow_rows[0])
