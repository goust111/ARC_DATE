+        dest_corner = OPPOSITE[source_corner]
+        sizes[dest_corner] = (int(mask.shape[0]) * TILE_SIZE, int(mask.shape[1]) * TILE_SIZE)
+    return sizes
+
+
+def _non_overlapping_targets(sizes: dict[str, tuple[int, int]], height: int, width: int) -> bool:
