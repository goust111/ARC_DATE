    g: np.ndarray, coords: np.ndarray, path_color: int, end_color: int
) -> list[tuple[int, int, int, int]]:
    coords_set = {tuple(map(int, coord)) for coord in coords}
    gates: list[tuple[int, int, int, int]] = []
    for r, c in coords_set:
