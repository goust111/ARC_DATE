+    return sizes
+
+
+def _non_overlapping_targets(sizes: dict[str, tuple[int, int]], height: int, width: int) -> bool:
+    tl_h, tl_w = sizes["tl"]
+    tr_h, tr_w = sizes["tr"]
+    bl_h, bl_w = sizes["bl"]
+    br_h, br_w = sizes["br"]
+    return (
+        tl_w + tr_w <= width
+        and bl_w + br_w <= width
+        and tl_h + bl_h <= height
+        and tr_h + br_h <= height
