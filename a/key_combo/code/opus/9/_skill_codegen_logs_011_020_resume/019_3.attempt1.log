+    padded[1:, :] |= occ[:-1, :]
+    padded[:, :-1] |= occ[:, 1:]
+    padded[:, 1:] |= occ[:, :-1]
+    padded[:-1, :-1] |= occ[1:, 1:]
+    padded[:-1, 1:] |= occ[1:, :-1]
+    padded[1:, :-1] |= occ[:-1, 1:]
+    padded[1:, 1:] |= occ[:-1, :-1]
+    return padded
