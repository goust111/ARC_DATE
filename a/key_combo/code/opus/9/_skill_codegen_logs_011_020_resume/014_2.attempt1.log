+                continue
+            if (r, c) in path_set or int(inp[r, c]) in (RED, TEAL):
+                continue
+            out[r, c] = BG
+    return out
+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    out: np.ndarray,
