+def _scatter_extra_blockers(
+    grid: np.ndarray,
+    reserved: set[tuple[int, int]],
+    count: int,
+) -> None:
+    h, w = grid.shape
+    eligible = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in reserved or grid[r, c] != BG:
+                continue
+            if any((r + dr, c + dc) in reserved for dr, dc in DIRS4 if in_bounds(grid.shape, r + dr, c + dc)):
