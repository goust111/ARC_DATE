+
+
+def _expected_output(
+    inp: np.ndarray,
+    path: list[tuple[int, int]],
+    red_r0: int,
+    red_c0: int,
+) -> np.ndarray:
+    out = inp.copy()
+    path_set = set(path)
+    for r, c in path:
+        out[r, c] = GREEN
+    rows = {red_r0, red_r0 + 1}
+    cols = {red_c0, red_c0 + 1}
+    for r in range(inp.shape[0]):
+        for c in range(inp.shape[1]):
