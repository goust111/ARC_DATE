+    grid = np.full((height, width), WALL, dtype=int)
+    for rect in rects:
+        r0, c0, r1, c1 = rect
+        grid[r0 : r1 + 1, c0 : c1 + 1] = BG
+    return grid, sorted(rects)
+
+
+def _region_capacity(rect: tuple[int, int, int, int]) -> int:
+    h, w = _rect_size(rect)
+    return (h * w + 1) // 2
+
