+BG = 0
+WALL = 5
+FG_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_RETRIES = 400
+MIN_REGION = 5
+GRID_RANGE = (17, 26)
