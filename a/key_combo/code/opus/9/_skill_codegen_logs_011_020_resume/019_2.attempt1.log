+    if counts[winner_idx] != max(counts) or counts.count(max(counts)) != 1:
+        return None
+
+    colors = random.sample(FG_COLORS, len(rects))
+    for idx, rect in enumerate(rects):
+        mode = "plain"
+        if idx == winner_idx:
+            mode = winner_mode
+        coords = _paint_region_points(grid, rect, colors[idx], counts[idx], mode)
+        if coords is None:
+            return None
+
+    try:
