+    out = g.copy()
+    candidates = _collect_candidates(g, winner["sources"], int(winner["color"]))
+    for cell, options in candidates.items():
+        best = min(options, key=lambda option: option["priority"])
+        out[cell] = int(best["color"])
+    return out
