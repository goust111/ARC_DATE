+    ra, ca = a
+    rb, cb = b
+    if ra == rb or ca == cb:
+        return False, False
+
+    dist_a = h - ra if rb > ra else ra + 1
+    dist_b = cb + 1 if ca < cb else w - cb
+    if dist_a == dist_b:
+        return True, True
+
+    dist_c = w - ca if cb > ca else ca + 1
+    dist_d = rb + 1 if ra < rb else h - rb
+    if dist_c == dist_d:
