+def _solve_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    regions = _extract_regions(g)
+    winner = regions[_winner_index(regions)]
+    if winner["count"] == 0:
+        return g.copy()
