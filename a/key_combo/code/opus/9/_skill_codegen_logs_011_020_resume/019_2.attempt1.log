+def _find_seed_pair(h: int, w: int, tie_mode: bool) -> list[tuple[int, int]] | None:
+    cells = [(r, c) for r in range(h) for c in range(w)]
+    random.shuffle(cells)
+    fallback: list[tuple[int, int]] | None = None
+    for a in cells:
+        for b in cells:
+            if a == b:
+                continue
+            if abs(a[0] - b[0]) + abs(a[1] - b[1]) == 1:
