+
+
+def _random_mirrored_grid() -> np.ndarray:
+    for _ in range(100):
+        turn_count = random.randint(1, 3)
+        rows = random.sample(range(COARSE_SIZE), turn_count + 1)
+        cols = sorted(random.sample([2, 3, 4], turn_count), reverse=True)
