+    turn_count = _trace_turn_count(trace)
+    if len(painted) < MIN_PATH_CELLS or not (MIN_TURNS <= turn_count <= MAX_TURNS):
+        return None
+
+    if int(np.count_nonzero(pruned == Color.TEAL)) < MIN_OBSTACLES:
+        return None
+
+    if not _mirror_needed(pruned, mirrored_out):
+        return None
