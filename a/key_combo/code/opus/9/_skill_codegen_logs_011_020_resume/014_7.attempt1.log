+def _successors(grid: np.ndarray, state: tuple[int, int, int, int]) -> list[tuple[int, int, int, int]]:
+    if _is_goal_state(grid, state):
+        return []
+
+    r, c, dr, dc = state
+    nr, nc = int(r + dr), int(c + dc)
+    if not in_bounds(grid.shape, nr, nc):
+        return []
+
+    nxt = int(grid[nr, nc])
+    if nxt == Color.BLACK:
