+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+try:
+    ROOT = Path(__file__).resolve().parents[6]
+    ARC_UTILS_DIR = ROOT / "new" / "solvers"
+    if str(ARC_UTILS_DIR) not in sys.path:
