+
+
+def _compress_partition_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+
+    sep_rows = [r for r in range(h) if np.all(g[r, :] == Color.RED)]
