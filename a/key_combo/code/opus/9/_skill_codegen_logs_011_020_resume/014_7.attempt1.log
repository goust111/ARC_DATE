+    grid = np.zeros((COARSE_SIZE, COARSE_SIZE), dtype=int)
+    start_r = random.randrange(COARSE_SIZE)
+    end_r = random.randrange(COARSE_SIZE)
+    grid[start_r, COARSE_SIZE - 1] = Color.GREEN
+    grid[end_r, 0] = Color.YELLOW
