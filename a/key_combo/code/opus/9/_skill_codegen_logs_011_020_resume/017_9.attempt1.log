+    grid[sep, :] = Color.GREY
+
+    for idx, ((c0, c1), color) in enumerate(zip(cols, colors)):
+        width = c1 - c0 + 1
+        top_mask = _sample_mask(top_h, width, upper_counts[idx], ensure_every_col=upper_counts[idx] >= width and random.random() < 0.65)
