+        if not np.any(~top_mask):
+            return None
+        if not np.any(~bottom_mask):
+            return None
+        grid[:top_h, c0 : c1 + 1][top_mask] = color
+        grid[sep + 1 :, c0 : c1 + 1][bottom_mask] = color
