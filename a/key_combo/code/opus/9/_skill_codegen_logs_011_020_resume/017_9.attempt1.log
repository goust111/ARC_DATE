+
+
+def _build_case() -> np.ndarray | None:
+    band_count = random.choice(BAND_COUNT_OPTIONS)
+    top_h = random.randint(*TOP_HEIGHT_RANGE)
+    bottom_h = random.randint(*BOTTOM_HEIGHT_RANGE)
