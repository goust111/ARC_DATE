+    return upper_counts, lower_counts
+
+
+def _band_columns(widths: list[int], gaps: list[int], left_margin: int) -> list[tuple[int, int]]:
+    cols = []
+    cursor = left_margin
+    for idx, width in enumerate(widths):
+        cols.append((cursor, cursor + width - 1))
+        cursor += width
+        if idx < len(gaps):
+            cursor += gaps[idx]
