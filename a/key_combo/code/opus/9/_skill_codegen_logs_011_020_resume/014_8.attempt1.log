+        if nxt == Color.TEAL:
+            out[nr, nc] = Color.GREEN
+            r, c = nr, nc
+            state = (int(r), int(c), int(dr), int(dc))
+            assert state not in seen_states, "path should not revisit the same state"
+            seen_states.add(state)
+            states.append(state)
