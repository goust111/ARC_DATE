+    start_dir = _edge_direction(start, (h, w))
+    start_cell = (int(start[0]), int(start[1]))
+
+    def cell_free(
+        cell: tuple[int, int],
+        visited: set[tuple[int, int]],
+        blocked: set[tuple[int, int]],
+    ) -> bool:
