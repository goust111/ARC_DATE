+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 500
+PANEL_RETRIES = 400
+PANEL_HEIGHT_RANGE = (5, 7)
+PANEL_WIDTH_RANGE = (7, 9)
+SCENE_HEIGHT_RANGE = (20, 28)
