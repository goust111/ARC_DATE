+            for r_raw, c_raw in np.argwhere((g == color) & (~seen)):
+                r = int(r_raw)
+                c = int(c_raw)
+                q = deque([(r, c)])
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while q:
