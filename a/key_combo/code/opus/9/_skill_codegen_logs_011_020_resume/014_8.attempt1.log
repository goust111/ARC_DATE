def _partition_spans(length: int, separators: list[int]) -> list[tuple[int, int]]:
    cuts = [-1] + sorted(int(v) for v in separators) + [int(length)]
    spans: list[tuple[int, int]] = []
    for left, right in zip(cuts, cuts[1:]):
