+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            bg = int(Counter(map(int, g.flatten())).most_common(1)[0][0])
+        assert monochromatic and connectivity == 4 and return_format == "dict"
+        if colors is None:
