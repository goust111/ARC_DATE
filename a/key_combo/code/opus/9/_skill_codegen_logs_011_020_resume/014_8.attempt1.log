+        max_len = 0
+        while cell_free((r + (max_len + 1) * dr, c + (max_len + 1) * dc), visited, blocked):
+            max_len += 1
+        lengths = list(range(1, max_len + 1))
+        random.shuffle(lengths)
+
+        if turns_done == turn_target:
