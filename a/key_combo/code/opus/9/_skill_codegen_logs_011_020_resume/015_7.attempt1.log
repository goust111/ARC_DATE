+        r1, c1 = map(int, seam["p1"])
+        r2, c2 = map(int, seam["p2"])
+        color = int(seam["color"])
+        layers[int(seam["a"])][r1, c1] = color
+        layers[int(seam["b"])][r2, c2] = color
+    return layers
+
+
+def _oracle_output_from_labels(labels: np.ndarray, seams: list[dict]) -> np.ndarray:
