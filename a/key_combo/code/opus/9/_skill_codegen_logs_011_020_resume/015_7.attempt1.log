+    if len(comps) != n:
+        return False
+
+    marker_counts = defaultdict(int)
+    for comp in comps:
+        sprite = crop_bbox(inp, comp["bbox"])
+        body_area = int(np.sum(sprite == BODY))
+        if not (8 <= body_area <= 15):
+            return False
+        marks = np.argwhere((sprite != BG) & (sprite != BODY))
+        if len(marks) not in (1, 2):
