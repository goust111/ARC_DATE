+    seam_points += [tuple(map(int, seam["p2"])) + (int(seam["color"]),) for seam in seams]
+    forbidden_cells = {tuple(map(int, seam["anchor1"])) for seam in seams} | {
+        tuple(map(int, seam["anchor2"])) for seam in seams
+    }
+
+    chosen: list[tuple[int, int]] = []
+    work = labels.copy()
+    for _ in range(extra_count):
+        candidates = []
+        for r in range(h):
+            for c in range(w):
+                if work[r, c] < 0 or (r, c) in forbidden_cells:
+                    continue
+                region = int(work[r, c])
+                if np.sum(work == region) <= 8:
+                    continue
+                test = work.copy()
+                test[r, c] = -2
+                if not _mask_connected(test == region):
+                    continue
+                dists = sorted(abs(r - sr) + abs(c - sc) for sr, sc, _ in seam_points)
+                if len(dists) >= 2 and dists[0] == dists[1]:
+                    continue
+                if any(abs(r - rr) + abs(c - cc) <= 1 for rr, cc in chosen):
+                    continue
+                candidates.append((r, c))
+        if not candidates:
+            return None, None
+        pick = random.choice(candidates)
+        work[pick] = -2
+        chosen.append(pick)
