+def _random_partition(total: int, parts: int, low: int, high: int) -> list[int] | None:
+    values = [low] * parts
+    remaining = total - low * parts
+    if remaining < 0:
+        return None
+    while remaining > 0:
+        choices = [i for i, v in enumerate(values) if v < high]
+        if not choices:
+            return None
+        idx = random.choice(choices)
+        values[idx] += 1
+        remaining -= 1
+    random.shuffle(values)
+    return values
