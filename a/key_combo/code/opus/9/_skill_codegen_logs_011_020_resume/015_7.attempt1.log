+            if not frontier:
+                continue
+            seed_r, seed_c = seeds[idx]
+            ranked = sorted(frontier, key=lambda p: (abs(p[0] - seed_r) + abs(p[1] - seed_c), random.random()))
+            pick = random.choice(ranked[: min(4, len(ranked))])
+            labels[pick] = idx
+            sizes[idx] += 1
+            progressed = True
+        if not progressed:
+            return None
+
+    if np.any(labels == -1):
+        return None
+    for idx in range(n):
+        if not _mask_connected(labels == idx):
+            return None
