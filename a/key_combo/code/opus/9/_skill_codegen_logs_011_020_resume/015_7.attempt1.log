+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = [tuple(map(int, p)) for p in np.argwhere(mask)]
+    if not coords:
+        return False
+    start = coords[0]
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c, mask.shape):
+            if mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
+    return len(seen) == len(coords)
+
