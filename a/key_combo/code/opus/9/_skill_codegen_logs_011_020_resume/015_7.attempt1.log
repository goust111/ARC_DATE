+    for rr, cc in np.argwhere(out == BG):
+        r, c = int(rr), int(cc)
+        best = None
+        best_color = None
+        for sr, sc, color in ordered_points:
+            dist = abs(r - sr) + abs(c - sc)
+            key = (dist, sr, sc, color)
+            if best is None or key < best:
+                best = key
+                best_color = color
+        out[r, c] = int(best_color)
+    return out
