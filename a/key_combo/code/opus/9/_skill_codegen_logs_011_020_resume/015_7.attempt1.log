+def _neighbors4(r: int, c: int, shape: tuple[int, int]):
+    h, w = shape
+    for dr, dc in DIR4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
