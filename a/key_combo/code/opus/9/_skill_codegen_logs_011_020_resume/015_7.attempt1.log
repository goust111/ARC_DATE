+    seam_points += [tuple(map(int, seam["p2"])) + (int(seam["color"]),) for seam in seams]
+    forbidden_cells = {tuple(map(int, seam["anchor1"])) for seam in seams} | {
+        tuple(map(int, seam["anchor2"])) for seam in seams
+    }
