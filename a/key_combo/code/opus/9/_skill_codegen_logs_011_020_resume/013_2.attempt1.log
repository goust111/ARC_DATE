+    for frame in frames:
+        rr = frame["coords"][:, 0]
+        cc = frame["coords"][:, 1]
+        out[rr, cc] = frame["color"]
+
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        indices = [
+            idx for idx, (r, c) in enumerate(path)
+            if r0 < r < r1 and c0 < c < c1
