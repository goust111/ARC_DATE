+def _line_exclusive(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = start
+    r1, c1 = end
+    out: list[tuple[int, int]] = []
+    if r0 == r1:
+        step = 1 if c1 > c0 else -1
+        for c in range(c0 + step, c1 + step, step):
+            out.append((r0, c))
+    else:
