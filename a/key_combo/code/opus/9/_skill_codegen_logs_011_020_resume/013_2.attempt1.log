+    comp = comps[0]
+    coord_set = {tuple(map(int, x)) for x in comp.tolist()}
+
+    degrees: dict[tuple[int, int], int] = {}
+    for r, c in coord_set:
+        deg = sum((nr, nc) in coord_set for nr, nc in _neighbors4(r, c))
+        assert deg <= 2, "expected a branch-free path"
+        degrees[(r, c)] = deg
+
