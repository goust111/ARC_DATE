+    coords.extend((r, 1) for r in range(1, h - 1))
+    coords.extend((h - 2, c) for c in range(2, w - 1))
+    coords.extend((r, w - 2) for r in range(h - 3, 0, -1))
+    coords.extend((1, c) for c in range(w - 3, 2, -1))
+    coords.append((0, 3))
