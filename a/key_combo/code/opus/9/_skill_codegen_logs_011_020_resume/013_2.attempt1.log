+
+    grid_h = random.randint(max(16, max(heights) + 4), 22)
+    frames: list[dict] = []
+    c0 = left_margin
+    for idx in range(n_frames):
+        h = heights[idx]
+        w = widths[idx]
+        top = random.randint(2, grid_h - h - 2)
+        local_path, interior_local, opening_local = _frame_path_local(h, w)
+        frames.append(
