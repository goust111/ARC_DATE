+        assert len(indices) >= 5, "each frame must contain a substantial path segment"
+        local_colors = [int(active_colors[idx]) for idx in indices]
+        fill = _choose_fill_color(local_colors)
+        out[r0 + 1:r1, c0 + 1:c1] = fill
