+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PATH_COLORS = (1, 2, 3)
+FRAME_COLOR_POOL = (4, 5, 6, 7, 8, 9)
+GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
