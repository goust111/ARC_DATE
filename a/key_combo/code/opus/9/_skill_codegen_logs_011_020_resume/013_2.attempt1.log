+        gap_next = (nr0 + next_frame["path_local"][0][0], nc0 + next_frame["path_local"][0][1])
+        mid_col = random.randint(gap_now[1] + 1, gap_next[1] - 1)
+        path.extend(_connector(gap_now, gap_next, mid_col))
