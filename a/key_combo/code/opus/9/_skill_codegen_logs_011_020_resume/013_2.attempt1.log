+    start = (fr0 + start_gap[0], 0)
+    entry = (fr0 + start_gap[0], fc0 + start_gap[1])
+    path.extend([(start[0], c) for c in range(start[1], entry[1] + 1)])
+
+    for idx, frame in enumerate(frames):
