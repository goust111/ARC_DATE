+def _connector(start: tuple[int, int], end: tuple[int, int], mid_col: int) -> list[tuple[int, int]]:
+    cur = start
+    out: list[tuple[int, int]] = []
+    if cur[1] != mid_col:
+        nxt = (cur[0], mid_col)
+        out.extend(_line_exclusive(cur, nxt))
+        cur = nxt
+    if cur[0] != end[0]:
+        nxt = (end[0], cur[1])
+        out.extend(_line_exclusive(cur, nxt))
+        cur = nxt
+    if cur[1] != end[1]:
+        out.extend(_line_exclusive(cur, end))
+    return out
