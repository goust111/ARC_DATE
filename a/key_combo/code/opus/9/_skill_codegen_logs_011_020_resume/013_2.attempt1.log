+    assert len(endpoints) == 2, "expected exactly two path endpoints"
+    start = endpoints[0]
+
+    order = [start]
+    prev = None
+    cur = start
+    while True:
+        nxts = [p for p in _neighbors4(*cur) if p in coord_set and p != prev]
+        if not nxts:
+            break
+        assert len(nxts) == 1, "expected a unique next step along the path"
+        nxt = nxts[0]
+        order.append(nxt)
+        prev, cur = cur, nxt
