+def _find_frames(grid: np.ndarray) -> list[dict]:
+    frames: list[dict] = []
+    for color in sorted(set(map(int, grid.flatten())) - {BG, *PATH_COLORS}):
+        comps = _components_from_mask(grid == color)
+        for comp in comps:
