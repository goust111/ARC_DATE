+
+def _orbit_key(cell: tuple[int, int], size: int) -> tuple[tuple[int, int], ...]:
+    bbox = (0, 0, size - 1, size - 1)
+    return tuple(_orbit_cells(cell[0], cell[1], bbox))
+
+
+def _paint_orbit(patch: np.ndarray, cell: tuple[int, int], value: int) -> None:
