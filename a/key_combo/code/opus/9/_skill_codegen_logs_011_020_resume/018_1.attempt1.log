+    if len(specs) != target:
+        return None
+
+    dists = [
+        _distance_for_side(grid_size, bbox_origin, patch.shape[0], spec["side"], spec["line"])
+        for spec in specs
+    ]
+    if len(dists) != len(set(dists)):
