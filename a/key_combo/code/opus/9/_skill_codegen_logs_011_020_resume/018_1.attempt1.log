+                final = prev
+                out[final] = absorb
+                placed[final] = absorb
+                details.append(
+                    {
+                        "start": (r, c),
+                        "side": marker["side"],
+                        "final": final,
+                        "blocked": (rr, cc),
+                        "blocked_type": "marker" if (rr, cc) in placed else "pattern",
+                        "absorbed": absorb,
+                    }
+                )
+                break
+            prev = (rr, cc)
+            rr += dr
+            cc += dc
