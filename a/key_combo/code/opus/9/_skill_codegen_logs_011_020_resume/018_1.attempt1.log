+    target = 3 if scenario.endswith("3") else 2
+    candidates = _simple_candidates(patch)
+    rng.shuffle(candidates)
+    for cand in candidates:
+        if len(specs) >= target:
+            break
+        if not _compatible_marker_specs(specs, cand, patch):
+            continue
+        specs.append(cand)
