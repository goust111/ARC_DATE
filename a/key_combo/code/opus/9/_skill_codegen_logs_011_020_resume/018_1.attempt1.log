+
+def _place_specs_on_grid(
+    patch: np.ndarray,
+    grid_size: int,
+    bbox_origin: tuple[int, int],
+    specs: list[dict],
+    occlusions: list[tuple[int, int]],
+    rng: random.Random,
+) -> np.ndarray:
+    grid = np.zeros((grid_size, grid_size), dtype=int)
+    r0, c0 = bbox_origin
+    size = patch.shape[0]
+    grid[r0 : r0 + size, c0 : c0 + size] = patch
