+
+
+def _simulate_from_completed(
+    completed: np.ndarray,
+    markers: list[dict],
+    bbox: tuple[int, int, int, int],
+    *,
+    reverse_order: bool = False,
+) -> tuple[np.ndarray, list[dict]]:
+    r0, c0, r1, c1 = bbox
