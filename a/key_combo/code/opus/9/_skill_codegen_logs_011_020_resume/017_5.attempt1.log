+
+
+def _place_shapes(shape_specs: list[tuple[np.ndarray, int]]) -> tuple[np.ndarray, list[dict]] | tuple[None, None]:
+    h = random.randint(GEN_GRID_MIN, GEN_GRID_MAX)
