def comp_count(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    n=0
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]: continue
            n+=1
            q=deque([(r,c)]); seen[r,c]=1
            while q:
                x,y=q.popleft()
                for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=1; q.append((nx,ny))
    return n

def holes(mask):
    bg=~mask; H,W=mask.shape; seen=np.zeros_like(bg,dtype=bool); n=0
    for r in range(H):
      for c in range(W):
        if not bg[r,c] or seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; touch=False
        while q:
          x,y=q.popleft(); touch |= x in (0,H-1) or y in (0,W-1)
          for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W and bg[nx,ny] and not seen[nx,ny]:
              seen[nx,ny]=1; q.append((nx,ny))
        if not touch: n+=1
    return n

def crop(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(0); r1,c1=pts.max(0)
    return mask[r0:r1+1,c0:c1+1]

def mutate(mask,target):
    m=np.pad(mask,1)
    for _ in range(20):
        if random.random()<0.7:
            cand=[]
            H,W=m.shape
            for r in range(H):
                for c in range(W):
                    if m[r,c]: continue
                    adj=False
                    for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nx,ny=r+dx,c+dy
                        if 0<=nx<H and 0<=ny<W and m[nx,ny]: adj=True
                    if adj: cand.append((r,c))
            random.shuffle(cand)
            for r,c in cand:
                mm=m.copy(); mm[r,c]=1
                if holes(mm)==target:
                    m=mm; break
        if random.random()<0.7:
            cand=list(map(tuple,np.argwhere(m)))
            random.shuffle(cand)
            for r,c in cand:
                mm=m.copy(); mm[r,c]=0
                if comp_count(mm)==1 and holes(mm)==target:
                    m=mm; break
    return crop(m)

def chain(k):
