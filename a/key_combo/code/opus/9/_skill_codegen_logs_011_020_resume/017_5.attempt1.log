+    dup_row_order = [rec["bbox"] for rec in sorted(dup, key=lambda rec: rec["bbox"][0])]
+    dup_col_order = [rec["bbox"] for rec in sorted(dup, key=lambda rec: rec["bbox"][1])]
+    if dup_row_order == dup_col_order:
