+def _count_holes(mask: np.ndarray) -> int:
+    bg = ~mask
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
