+    template_shape, cup_shapes = _choose_shapes(rng, cup_count)
+
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    blocked = np.zeros((grid_h, grid_w), dtype=bool)
+    reserved_paths = np.zeros((grid_h, grid_w), dtype=bool)
+
