+
+def _semantic_ok(grid: np.ndarray, expected: np.ndarray, template_shape: tuple[tuple[int, int], ...], cups_meta: list[dict]) -> bool:
+    try:
+        template = _extract_template(grid, 0)
+        cups = _extract_cups(grid, 0)
+    except Exception:
