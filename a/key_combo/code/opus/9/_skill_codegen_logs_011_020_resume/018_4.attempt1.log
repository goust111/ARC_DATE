+        for r, c in cup["content_cells"]:
+            out[r, c] = bg
+        if cup["shape"] != template["shape"]:
+            continue
+        for r, c in cup["path_cells"]:
+            out[r, c] = cup["content_color"]
+
+    for r, c in template["erase_cells"]:
+        out[r, c] = bg
+    return out
