+    elif direction == "L":
+        c_min = length + 1
+        c_max = min(grid_w - patch_w - 1, max(c_min, grid_w // 3))
+        r_min, r_max = 1, grid_h - patch_h - 1
+        for r0 in range(r_min, r_max + 1):
+            for c0 in range(c_min, c_max + 1):
