+def _path_to_edge(spike_global: tuple[int, int], direction: str, grid_h: int, grid_w: int) -> list[tuple[int, int]]:
+    dr, dc = DIR4[direction]
+    r, c = spike_global
+    out = []
+    while True:
+        r += dr
+        c += dc
+        if not (0 <= r < grid_h and 0 <= c < grid_w):
