+def _build_canonical_cup(left_arm: int, right_arm: int, left_wall: int, right_wall: int, color: int) -> tuple[np.ndarray, tuple[int, int]]:
+    width = left_arm + right_arm + 1
+    height = max(left_arm + left_wall, right_arm + right_wall) + 1
