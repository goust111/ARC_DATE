+        r0, c0, r1, c1 = _bbox_coords(comp)
+        frame = {(int(r), int(c)) for r, c in comp}
+        expected = {(r, c1) for r in range(r0, r1 + 1)} | {(r1, c) for c in range(c0, c1 + 1)}
+        if frame != expected:
