+
+def _cells_with_margin(r0: int, c0: int, h: int, w: int, grid_h: int, grid_w: int) -> list[tuple[int, int]]:
+    cells = []
+    for r in range(max(0, r0 - 1), min(grid_h, r0 + h + 1)):
+        for c in range(max(0, c0 - 1), min(grid_w, c0 + w + 1)):
+            cells.append((r, c))
