+        sr, sc = cup["spike_global"]
+        dr, dc = DIR4[cup["direction"]]
+        for step in range(1, len(cup["content_cells"]) + 1):
+            rr = sr + dr * step
+            cc = sc + dc * step
+            if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
