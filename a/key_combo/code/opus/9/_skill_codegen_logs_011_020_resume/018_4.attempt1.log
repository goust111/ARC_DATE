+
+def _candidate_origins(
+    direction: str,
+    grid_h: int,
+    grid_w: int,
+    patch_h: int,
+    patch_w: int,
+    spike: tuple[int, int],
+    length: int,
+) -> list[tuple[int, int]]:
+    sr, sc = spike
+    origins = []
+    if direction == "U":
+        r_min = length + 1
+        r_max = min(grid_h - patch_h - 1, max(r_min, grid_h // 3))
+        c_min, c_max = 1, grid_w - patch_w - 1
+        for r0 in range(r_min, r_max + 1):
+            for c0 in range(c_min, c_max + 1):
