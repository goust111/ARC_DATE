+    return (
+        int(outer[0]) < int(inner[0])
+        and int(outer[1]) < int(inner[1])
+        and int(outer[2]) > int(inner[2])
+        and int(outer[3]) > int(inner[3])
+    )
+
+
+def _point_in_open_bbox(point: tuple[int, int], box: tuple[int, int, int, int]) -> bool:
