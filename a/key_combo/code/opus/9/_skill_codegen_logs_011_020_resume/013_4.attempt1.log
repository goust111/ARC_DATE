def _frontier_cuts(count: int, limit: int) -> list[int]:
    cut = random.randint(1, limit - 1)
    cuts = []
    for _ in range(count):
        cut = max(1, min(limit - 1, cut + random.choice(FRONTIER_STEPS)))
        cuts.append(cut)
