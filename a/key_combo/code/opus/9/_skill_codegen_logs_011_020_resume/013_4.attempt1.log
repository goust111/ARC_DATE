+
+    wrong = _wrong_deepest_frame_output(grid)
+    if np.array_equal(actual, wrong):
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_groups = random.choice([2, 3])
+    if n_groups == 2:
