+
+# Coordinate convention follows arc_utils: grids are indexed as (r, c).
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+N_CELLS = 5
+CELL_SIZE = 3
+STRIDE = CELL_SIZE + 1
+GRID_SIZE = N_CELLS * CELL_SIZE + (N_CELLS + 1)
