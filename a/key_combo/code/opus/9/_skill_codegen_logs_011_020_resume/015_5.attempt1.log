/bin/bash -lc "python - <<'PY'
N=5
inner={(r,c) for r in range(1,4) for c in range(1,4)}
ORDER=['U','R','D','L']
DIRS={'U':(-1,0),'R':(0,1),'D':(1,0),'L':(0,-1)}
def turn(d,left):
    i=ORDER.index(d)
    return ORDER[(i-1)%4] if left else ORDER[(i+1)%4]

def blocked(a,b):
    return (a in inner)"'!=(b in inner)

def step(start,d):
    pos=start; visited=[pos]; collisions=[]
    while True:
        r,c=pos; dr,dc=DIRS[d]; nr,nc=r+dr,c+dc
        if not (0<=nr<N and 0<=nc<N):
            reason='"'wall'
        elif blocked(pos,(nr,nc)):
            reason='zone'
        elif (nr,nc) in visited:
            return tuple(visited), tuple(collisions), 'painted'
        else:
            pos=(nr,nc); visited.append(pos); continue
        collisions.append((pos,d,reason,pos in inner))
        nd=turn(d, pos in inner)
        dr,dc=DIRS[nd]; nr,nc=pos[0]+dr,pos[1]+dc
        if not (0<=nr<N and 0<=nc<N):
            return tuple(visited), tuple(collisions), 'wall-after-turn'
        if blocked(pos,(nr,nc)):
            return tuple(visited), tuple(collisions), 'zone-after-turn'
        if (nr,nc) in visited:
            return tuple(visited), tuple(collisions), 'painted-after-turn'
        d=nd; pos=(nr,nc); visited.append(pos)

states=[]
for s in [(r,c) for r in range(N) for c in range(N) if (r,c)"'!=(0,0)]:
  for d in ORDER:
    vis,col,stop=step(s,d)
    if len(vis)>=6 and len(col)>=3:
      zone='"'inner' if s in inner else 'outer'
      zone_hits=sum(1 for x in col if x[2]=='zone')
      states.append((s,d,zone,len(vis),len(col),zone_hits,stop,vis))
print('states',len(states))
uniq={st[-1] for st in states}
print('uniq outputs',len(uniq))
from collections import Counter
print(Counter((st[2],st[6]) for st in states))
