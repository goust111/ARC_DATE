+        for dc in range(3):
+            out |= padded[dr : dr + h, dc : dc + w]
+    return out
+
+
+def component_masks(mask: np.ndarray) -> list[np.ndarray]:
+    mask = mask.astype(bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = np.zeros((h, w), dtype=bool)
+            comp[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        comp[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def mask_touches_edge(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() or mask[-1, :].any() or mask[:, 0].any() or mask[:, -1].any())
+
+
+def bbox_of(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def count_closed_background(mask: np.ndarray) -> int:
+    bg = ~mask
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _pair_channels(grid: np.ndarray):
+    orange_comps = component_masks(grid == ORANGE)
+    assert len(orange_comps) >= 2 and len(orange_comps) % 2 == 0, "expected an even number of orange path components"
+
+    candidates: dict[int, list[tuple[int, np.ndarray]]] = {i: [] for i in range(len(orange_comps))}
+    for i in range(len(orange_comps)):
+        for j in range(i + 1, len(orange_comps)):
+            channel = dilate8(orange_comps[i]) & dilate8(orange_comps[j]) & ~(grid == ORANGE)
+            if channel.any():
+                candidates[i].append((j, channel))
+                candidates[j].append((i, channel))
+
+    used: set[int] = set()
+    pairs = []
+    for i in range(len(orange_comps)):
+        if i in used:
+            continue
+        assert len(candidates[i]) == 1, "orange path pairing must be unique"
+        j, channel = candidates[i][0]
+        assert len(candidates[j]) == 1 and candidates[j][0][0] == i, "orange path pairing must be mutual"
+        used.add(i)
+        used.add(j)
+        pairs.append((orange_comps[i], orange_comps[j], channel))
+    assert len(used) == len(orange_comps), "every orange component must belong to exactly one pair"
+    return pairs
+
+
+def _segment_hole_count(seg: np.ndarray, path_a: np.ndarray, path_b: np.ndarray, grey_mask: np.ndarray) -> int:
+    walls = path_a | path_b | grey_mask | seg
+    r0, c0, r1, c1 = bbox_of(walls)
+    r0 = max(0, r0 - 1)
+    c0 = max(0, c0 - 1)
+    r1 = min(walls.shape[0] - 1, r1 + 1)
+    c1 = min(walls.shape[1] - 1, c1 + 1)
+    crop = walls[r0 : r1 + 1, c0 : c1 + 1]
+    return count_closed_background(crop)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor interior middle-channel segments by the number of closed background holes they enclose.
+
+    Input structure:
+    - The background is black.
+    - Orange pixels form 3-4 pairs of 4-connected path components; each pair defines one middle channel by intersecting the two 8-neighborhood dilations.
+    - Some channel cells are gray blockers, and different channel pairs are separated so their dilated overlaps do not mix.
+
+    Rule:
+    - For each orange component pair, intersect the two 8-neighborhood dilations and remove the orange path cells to obtain the channel mask.
+    - Treat gray cells inside that channel as blockers; remove them and split the remaining channel into 4-connected segments.
+    - Any segment touching the outer grid border stays unchanged.
+    - For every non-edge segment, count how many 4-connected background regions are closed off by that segment together with the two orange path walls and the gray blockers.
+    - Recolor the whole segment by the hole-count mapping: 1->blue, 2->red, 3->green, 4->yellow. Leave the orange paths, gray blockers, edge-connected segments, and background unchanged.
+
+    Key insight:
+    - The colored object is not drawn directly: it is the geometric overlap channel between two orange paths, and its final color depends on the enclosed topology of each blocker-split segment rather than on size or position.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    out = g.copy()
+    grey_mask = g == GREY
+
+    for path_a, path_b, channel in _pair_channels(g):
+        blockers = channel & grey_mask
+        passable = channel & ~grey_mask
+        for seg in component_masks(passable):
+            if mask_touches_edge(seg):
+                continue
+            holes = _segment_hole_count(seg, path_a, path_b, blockers)
+            assert holes in HOLE_TO_COLOR, f"unsupported hole count: {holes}"
+            out[seg] = HOLE_TO_COLOR[holes]
+
+    return out
+
+
+def _left(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return -dc, dr
+
+
+def _right(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return dc, -dr
+
+
+def _base_spiral_path() -> list[tuple[int, int]]:
+    path: list[tuple[int, int]] = []
+    top = left = 0
+    bottom = right = 4
+    while left <= right and top <= bottom:
+        for c in range(left, right + 1):
+            path.append((top, c))
+        top += 2
+        if top > bottom:
+            break
+        for r in range(top - 1, bottom + 1):
+            path.append((r, right))
+        right -= 2
+        if left > right:
+            break
+        for c in range(right + 1, left - 1, -1):
+            path.append((bottom, c))
+        bottom -= 2
+        if top > bottom:
+            break
+        for r in range(bottom + 1, top - 1, -1):
+            path.append((r, left))
+        left += 2
+
+    out: list[tuple[int, int]] = []
+    for cell in path:
+        if not out or out[-1] != cell:
+            out.append(cell)
+    return out
+
+
+def _paths_from_centerline(path: list[tuple[int, int]], margin: int = 2) -> tuple[np.ndarray, np.ndarray]:
+    rows = [r for r, _ in path]
+    cols = [c for _, c in path]
+    rmin, rmax = min(rows), max(rows)
+    cmin, cmax = min(cols), max(cols)
+    h = rmax - rmin + 1 + 2 * margin
+    w = cmax - cmin + 1 + 2 * margin
+    shifted = [(r - rmin + margin, c - cmin + margin) for r, c in path]
+    left_path = np.zeros((h, w), dtype=bool)
+    right_path = np.zeros((h, w), dtype=bool)
+
+    def add(mask: np.ndarray, cell: tuple[int, int]) -> None:
+        r, c = cell
+        if 0 <= r < h and 0 <= c < w:
+            mask[r, c] = True
+
+    for i in range(len(shifted) - 1):
+        r0, c0 = shifted[i]
+        r1, c1 = shifted[i + 1]
+        direction = (r1 - r0, c1 - c0)
+        assert abs(direction[0]) + abs(direction[1]) == 1
+        dl = _left(direction)
+        dr = _right(direction)
+        add(left_path, (r0 + dl[0], c0 + dl[1]))
+        add(left_path, (r1 + dl[0], c1 + dl[1]))
+        add(right_path, (r0 + dr[0], c0 + dr[1]))
+        add(right_path, (r1 + dr[0], c1 + dr[1]))
+
+    for i in range(1, len(shifted) - 1):
+        rp, cp = shifted[i - 1]
+        r, c = shifted[i]
+        rn, cn = shifted[i + 1]
+        prev_dir = (r - rp, c - cp)
+        next_dir = (rn - r, cn - c)
+        if prev_dir == next_dir:
+            continue
+        lp = _left(prev_dir)
+        ln = _left(next_dir)
+        rp2 = _right(prev_dir)
+        rn2 = _right(next_dir)
+        add(left_path, (r + lp[0] + ln[0], c + lp[1] + ln[1]))
+        add(right_path, (r + rp2[0] + rn2[0], c + rp2[1] + rn2[1]))
+
+    assert not np.any(left_path & right_path)
+    assert len(component_masks(left_path)) == 1
+    assert len(component_masks(right_path)) == 1
+    return left_path, right_path
+
+
+def _make_spiral_template(prefix_len: int, blocker: tuple[int, int]) -> np.ndarray:
+    path = _base_spiral_path()[:prefix_len]
+    left_path, right_path = _paths_from_centerline(path)
+    channel = dilate8(left_path) & dilate8(right_path) & ~(left_path | right_path)
+    assert channel[blocker], "blocker must lie in the computed channel"
+    g = np.zeros(channel.shape, dtype=int)
+    g[left_path | right_path] = ORANGE
+    g[blocker] = GREY
+    return g
+
+
+SPIRAL_TEMPLATE_A = _make_spiral_template(8, (2, 1))
+SPIRAL_TEMPLATE_B = _make_spiral_template(10, (2, 1))
+
+
+def _edge_template(length: int, vertical: bool) -> np.ndarray:
+    if vertical:
+        g = np.zeros((length, 3), dtype=int)
+        g[:, 0] = ORANGE
+        g[:, 2] = ORANGE
+        return g
+    g = np.zeros((3, length), dtype=int)
+    g[0, :] = ORANGE
+    g[2, :] = ORANGE
+    return g
+
+
+def _transforms(grid: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    for k in range(4):
+        rot = np.rot90(grid, k)
+        variants.append(rot)
+        variants.append(np.fliplr(rot))
+    unique: list[np.ndarray] = []
+    seen: set[bytes] = set()
+    for arr in variants:
+        sig = arr.tobytes() + str(arr.shape).encode()
+        if sig not in seen:
+            seen.add(sig)
+            unique.append(arr.copy())
+    return unique
+
+
+def _can_place(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, pad: int = 2) -> bool:
+    h, w = patch.shape
+    hh, ww = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    active = patch != BG
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
+    return not np.any(grid[rr0:rr1, cc0:cc1] != BG)
+
+
+def _place_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    sub = grid[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BG
+    sub[mask] = patch[mask]
+
+
+def _analysis(grid: np.ndarray):
+    out = main(grid)
+    recolored = (out != grid) & np.isin(out, [BLUE, RED, GREEN, YELLOW])
+    pairs = _pair_channels(grid)
+    edge_segments = 0
+    inner_segments = 0
+    hole_values: list[int] = []
+    for path_a, path_b, channel in pairs:
+        blockers = channel & (grid == GREY)
+        for seg in component_masks(channel & ~(grid == GREY)):
+            if mask_touches_edge(seg):
+                edge_segments += 1
+            else:
+                inner_segments += 1
+                hole_values.append(_segment_hole_count(seg, path_a, path_b, blockers))
+    return {
+        "out": out,
+        "recolored": int(recolored.sum()),
+        "edge_segments": edge_segments,
+        "inner_segments": inner_segments,
+        "hole_values": hole_values,
+        "pair_count": len(pairs),
+    }
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(22, 30)
+    w = random.randint(22, 30)
+    grid = np.zeros((h, w), dtype=int)
+
+    pair_count = random.choice([3, 4])
+    interior_templates = [SPIRAL_TEMPLATE_A, SPIRAL_TEMPLATE_B]
+    if pair_count == 4:
+        interior_templates.append(random.choice([SPIRAL_TEMPLATE_A, SPIRAL_TEMPLATE_B]))
+    random.shuffle(interior_templates)
+
+    vertical_edge = random.random() < 0.5
+    edge_patch = _edge_template(random.randint(8, 14), vertical=vertical_edge)
+    if vertical_edge:
+        c0 = random.randint(0, w - edge_patch.shape[1])
+        r0 = 0 if random.random() < 0.5 else h - edge_patch.shape[0]
+    else:
+        r0 = random.randint(0, h - edge_patch.shape[0])
+        c0 = 0 if random.random() < 0.5 else w - edge_patch.shape[1]
+    if not _can_place(grid, edge_patch, r0, c0, pad=3):
+        return None
+    _place_patch(grid, edge_patch, r0, c0)
+
+    for base in interior_templates:
+        patch = random.choice(_transforms(base))
+        placed = False
+        for _ in range(80):
+            rr = random.randint(2, h - patch.shape[0] - 2)
+            cc = random.randint(2, w - patch.shape[1] - 2)
+            if _can_place(grid, patch, rr, cc, pad=3):
+                _place_patch(grid, patch, rr, cc)
+                placed = True
+                break
+        if not placed:
+            return None
+
+    try:
+        info = _analysis(grid)
+    except AssertionError:
+        return None
+
+    if info["pair_count"] != pair_count:
+        return None
+    if info["recolored"] == 0 or info["inner_segments"] == 0 or info["edge_segments"] == 0:
+        return None
+    if not set(info["hole_values"]).issubset({1, 2, 3, 4}):
+        return None
+    if pair_count == 4 and len(info["hole_values"]) < 4:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

