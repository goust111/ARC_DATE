import numpy as np
from collections import deque
from itertools import combinations

def neighbors4(r,c): return ((r-1,c),(r+1,c),(r,c-1),(r,c+1))

def compcount(mask):
    H,W=mask.shape; vis=np.zeros((H,W),bool); n=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not vis[r,c]:
          n+=1; q=deque([(r,c)]); vis[r,c]=1
          while q:
            x,y=q.popleft()
            for nx,ny in neighbors4(x,y):
              if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
    return n

def dil8(mask):
    H,W=mask.shape; p=np.pad(mask,1); out=np.zeros_like(mask)
    for dr in range(3):
      for dc in range(3): out |= p[dr:dr+H,dc:dc+W]
    return out

def count_closed(mask):
    bg=~mask; H,W=bg.shape; vis=np.zeros((H,W),bool); cnt=0
    for r in range(H):
      for c in range(W):
        if bg[r,c] and not vis[r,c]:
          q=deque([(r,c)]); vis[r,c]=1; touch=False
          while q:
            x,y=q.popleft(); touch|=x in (0,H-1) or y in (0,W-1)
            for nx,ny in neighbors4(x,y):
              if 0<=nx<H and 0<=ny<W and bg[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
          if not touch: cnt+=1
    return cnt

def add_rect(mask,r0,c0,r1,c1,gaps):
    mask[r0,c0:c1+1]=1; mask[r1,c0:c1+1]=1; mask[r0:r1+1,c0]=1; mask[r0:r1+1,c1]=1
    for cell in gaps: mask[cell]=0

def build(k):
  tops=[4+6*i for i in range(k)]
  H=tops[-1]+8; W=12; x=4
  A=np.zeros((H,W),bool); B=np.zeros((H,W),bool)
  bridge_rows={t+5 for t in tops[:-1]}
  for t in tops:
    add_rect(A,t-1,x-1,t+5,x+5,{(r,x+1) for r in bridge_rows})
    add_rect(B,t+1,x+1,t+3,x+3,set())
  for r in range(tops[0], tops[-1]+4): A[r,x-1]=1; B[r,x+1]=1
  return A,B

for k in [1,2,3,4]:
  A,B=build(k)
  touches=[('A',tuple(rc)) for rc in np.argwhere(A) if any(0<=nr<A.shape[0] and 0<=nc<A.shape[1] and B[nr,nc] for nr,nc in neighbors4(*rc))]
  touches += [('B',tuple(rc)) for rc in np.argwhere(B) if any(0<=nr<B.shape[0] and 0<=nc<B.shape[1] and A[nr,nc] for nr,nc in neighbors4(*rc))]
  print('k',k,'touch count',len(touches),'union',compcount(A|B),'holes',count_closed(A|B|(dil8(A)&dil8(B)&~(A|B))))
  found=False
  for m in range(1,6):
    for combo in combinations(range(len(touches)), m):
      A2=A.copy(); B2=B.copy()
      for idx in combo:
        side,(r,c)=touches[idx]
        if side=='A': A2[r,c]=0
        else: B2[r,c]=0
      if compcount(A2)==1 and compcount(B2)==1 and compcount(A2|B2)==2:
        holes=count_closed(A2|B2|(dil8(A2)&dil8(B2)&~(A2|B2)))
        if holes==k:
          print(' found m',m,[touches[i] for i in combo])
          found=True
          break
    if found: break
  print('done',found)
