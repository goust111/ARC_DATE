+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    padded = np.pad(mask.astype(bool), 1)
+    out = np.zeros_like(mask, dtype=bool)
+    for dr in range(3):
+        for dc in range(3):
