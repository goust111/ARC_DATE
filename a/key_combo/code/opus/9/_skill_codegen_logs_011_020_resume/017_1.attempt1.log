    r0=max(0,r0-1); c0=max(0,c0-1); r1=min(C.shape[0]-1,r1+1); c1=min(C.shape[1]-1,c1+1)
    hs.append(count_closed(walls[r0:r1+1,c0:c1+1]))
  print('hole counts',sorted(hs))
  for row in G:
    print(''.join('.' if v==0 else 'G' if v==5 else 'O' for v in row))

