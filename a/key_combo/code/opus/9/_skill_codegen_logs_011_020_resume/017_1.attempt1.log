import numpy as np
from collections import deque

def neighbors4(r,c): return ((r-1,c),(r+1,c),(r,c-1),(r,c+1))

def comps(mask):
    H,W=mask.shape; vis=np.zeros((H,W),bool); n=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not vis[r,c]:
          n+=1; q=deque([(r,c)]); vis[r,c]=1
          while q:
            x,y=q.popleft()
            for nx,ny in neighbors4(x,y):
              if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
    return n

def dil8(mask):
    H,W=mask.shape; p=np.pad(mask,1); out=np.zeros_like(mask)
    for dr in range(3):
      for dc in range(3): out |= p[dr:dr+H,dc:dc+W]
    return out

def left(d): dr,dc=d; return (-dc,dr)

def right(d): dr,dc=d; return (dc,-dr)

def spiral():
  path=[]; top=left=0; bottom=right=4
  while left<=right and top<=bottom:
    for c in range(left,right+1): path.append((top,c))
    top+=2
    if top>bottom: break
    for r in range(top-1,bottom+1): path.append((r,right))
    right-=2
    if left>right: break
    for c in range(right+1,left-1,-1): path.append((bottom,c))
    bottom-=2
    if top>bottom: break
    for r in range(bottom+1,top-1,-1): path.append((r,left))
    left+=2
  out=[]
  for p in path:
    if not out or out[-1]"'!=p: out.append(p)
  return out

def scale_path(path,k=2):
  out=[(path[0][0]*k, path[0][1]*k)]
  for (r0,c0),(r1,c1) in zip(path,path[1:]):
    dr=r1-r0; dc=c1-c0
    for s in range(1,k+1):
      out.append((r0*k+dr*s, c0*k+dc*s))
  return out

def build(path,margin=3):
  rs=[r for r,c in path]; cs=[c for r,c in path]
  rmin,cmin,rmax,cmax=min(rs),min(cs),max(rs),max(cs)
  H=rmax-rmin+1+2*margin; W=cmax-cmin+1+2*margin
  path=[(r-rmin+margin,c-cmin+margin) for r,c in path]
  L=np.zeros((H,W),bool); R=np.zeros((H,W),bool)
  def add(mask,cell):
    r,c=cell
    if 0<=r<H and 0<=c<W: mask[r,c]=1
  for i in range(len(path)-1):
    r0,c0=path[i]; r1,c1=path[i+1]; d=(r1-r0,c1-c0); ld=left(d); rd=right(d)
    add(L,(r0+ld[0],c0+ld[1])); add(L,(r1+ld[0],c1+ld[1]))
    add(R,(r0+rd[0],c0+rd[1])); add(R,(r1+rd[0],c1+rd[1]))
  for i in range(1,len(path)-1):
    rp,cp=path[i-1]; r,c=path[i]; rn,cn=path[i+1]
    dp=(r-rp,c-cp); dn=(rn-r,cn-c)
    if dp!=dn:
      lp=left(dp); ln=left(dn); rp2=right(dp); rn2=right(dn)
      add(L,(r+lp[0]+ln[0],c+lp[1]+ln[1]))
      add(R,(r+rp2[0]+rn2[0],c+rp2[1]+rn2[1]))
  return L,R,dil8(L)&dil8(R)&~(L|R)

base=spiral()[:8]
for k in [2,3]:
  path=scale_path(base,k)
  L,R,C=build(path)
  print('"'k',k,'comps L',comps(L),'R',comps(R),'union',comps(L|R),'touch',np.any(L&R),'shape',L.shape,'channel cells',C.sum())
  for row in (L.astype(int)+2*R.astype(int)+4*C.astype(int)):
    print(''.join('.' if v==0 else 'L' if v==1 else 'R' if v==2 else 'x' if v==4 else '*' for v in row))
  print()
