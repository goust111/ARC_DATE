+
+
+def _can_place(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int, pad: int = 2) -> bool:
+    h, w = patch.shape
+    hh, ww = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > hh or c0 + w > ww:
+        return False
+    active = patch != BG
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(hh, r0 + h + pad)
+    cc1 = min(ww, c0 + w + pad)
