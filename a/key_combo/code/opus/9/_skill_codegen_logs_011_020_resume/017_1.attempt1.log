    for r in range(H):
      for c in range(W):
        if bg[r,c] and not vis[r,c]:
          q=deque([(r,c)]); vis[r,c]=1; touch=False
          while q:
            x,y=q.popleft(); touch|=x in (0,H-1) or y in (0,W-1)
            for nx,ny in neighbors4(x,y):
              if 0<=nx<H and 0<=ny<W and bg[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
          if not touch: cnt+=1
    return cnt

def bbox(mask):
  coords=np.argwhere(mask); r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0); return r0,c0,r1,c1

def dil8(mask):
    H,W=mask.shape; p=np.pad(mask,1); out=np.zeros_like(mask)
    for dr in range(3):
      for dc in range(3): out |= p[dr:dr+H,dc:dc+W]
    return out

def left(d): dr,dc=d; return (-dc,dr)

def right(d): dr,dc=d; return (dc,-dr)

def spiral():
  path=[]; top=left=0; bottom=right=4
  while left<=right and top<=bottom:
    for c in range(left,right+1): path.append((top,c))
    top+=2
    if top>bottom: break
    for r in range(top-1,bottom+1): path.append((r,right))
    right-=2
    if left>right: break
    for c in range(right+1,left-1,-1): path.append((bottom,c))
    bottom-=2
    if top>bottom: break
    for r in range(bottom+1,top-1,-1): path.append((r,left))
    left+=2
  out=[]
  for p in path:
    if not out or out[-1]"'!=p: out.append(p)
  return out

def build(path,margin=2):
  rs=[r for r,c in path]; cs=[c for r,c in path]
  rmin,cmin,rmax,cmax=min(rs),min(cs),max(rs),max(cs)
  H=rmax-rmin+1+2*margin; W=cmax-cmin+1+2*margin
  path=[(r-rmin+margin,c-cmin+margin) for r,c in path]
  L=np.zeros((H,W),bool); R=np.zeros((H,W),bool)
  def add(mask,cell):
    r,c=cell
    if 0<=r<H and 0<=c<W: mask[r,c]=1
  for i in range(len(path)-1):
    r0,c0=path[i]; r1,c1=path[i+1]; d=(r1-r0,c1-c0); ld=left(d); rd=right(d)
    add(L,(r0+ld[0],c0+ld[1])); add(L,(r1+ld[0],c1+ld[1]))
    add(R,(r0+rd[0],c0+rd[1])); add(R,(r1+rd[0],c1+rd[1]))
