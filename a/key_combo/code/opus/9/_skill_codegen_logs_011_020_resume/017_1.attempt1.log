    rp,cp=path[i-1]; r,c=path[i]; rn,cn=path[i+1]
    dp=(r-rp,c-cp); dn=(rn-r,cn-c)
    if dp!=dn:
      lp=left(dp); ln=left(dn); rp2=right(dp); rn2=right(dn)
      add(L,(r+lp[0]+ln[0],c+lp[1]+ln[1]))
      add(R,(r+rp2[0]+rn2[0],c+rp2[1]+rn2[1]))
  return L,R

def analyze(prefix, cuts, blocker):
  L,R=build(spiral()[:prefix])
  for side,r,c in cuts:
    if side=='"'L': L[r,c]=0
    else: R[r,c]=0
  print('comp L,R,union',len(comps(L)),len(comps(R)),len(comps(L|R)))
