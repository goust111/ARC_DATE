+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+HOLE_TO_COLOR = {1: BLUE, 2: RED, 3: GREEN, 4: YELLOW}
