+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = np.zeros((h, w), dtype=bool)
+            comp[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        comp[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
