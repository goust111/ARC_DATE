+CHAIN_TEMPLATE_2 = _make_loop_chain_template(2)
+CHAIN_TEMPLATE_3 = _make_loop_chain_template(3)
+CHAIN_TEMPLATE_4 = _make_loop_chain_template(4)
+
+
+def _edge_template(length: int, vertical: bool) -> np.ndarray:
