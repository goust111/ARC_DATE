+        top += 2
+        if top > bottom:
+            break
+        for r in range(top - 1, bottom + 1):
+            path.append((r, right))
+        right -= 2
+        if left > right:
+            break
+        for c in range(right + 1, left - 1, -1):
+            path.append((bottom, c))
+        bottom -= 2
+        if top > bottom:
+            break
+        for r in range(bottom + 1, top - 1, -1):
+            path.append((r, left))
+        left += 2
