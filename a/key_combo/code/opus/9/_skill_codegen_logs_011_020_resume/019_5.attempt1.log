+    groups = _group_records(records)
+    groups.sort(
+        key=lambda group: (
+            float(group["avg_distance"]),
+            tuple(map(int, group["first_marker"])),
+        ),
+        reverse=True,
+    )
+    for group in groups:
+        color = int(group["color"])
+        for r, c in group["frame_pixels"]:
+            out[r, c] = color
+    return out
