+    assert c1 - c0 + 1 >= 3
+    pixels: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        pixels.add((r0, c))
+        pixels.add((r1, c))
+    for r in range(r0, r1 + 1):
