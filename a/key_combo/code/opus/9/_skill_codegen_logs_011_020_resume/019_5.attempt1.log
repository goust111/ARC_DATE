def _full_edge_bar(g: np.ndarray, bg: int) -> tuple[str, int]:
    h, w = g.shape
    edge_values = [
        ("top", g[0, :]),
        ("bottom", g[h - 1, :]),
        ("left", g[:, 0]),
        ("right", g[:, w - 1]),
    ]

    candidates: list[tuple[str, int]] = []
