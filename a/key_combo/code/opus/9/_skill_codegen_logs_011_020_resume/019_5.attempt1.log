+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert int(get_bg(g)) == BG
+    records = _parse_components(g)
+    groups = _group_records(records)
+    assert 2 <= len(groups) <= 3
