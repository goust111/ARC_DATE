+
+
+def _build_group_specs(h: int, w: int) -> list[dict[str, object]]:
+    num_groups = 2 if int(_RNG.integers(0, 2)) == 0 else 3
+    colors = list(map(int, _RNG.choice(MARKER_POOL, size=num_groups, replace=False)))
+    types = ["LR", "TB"]
