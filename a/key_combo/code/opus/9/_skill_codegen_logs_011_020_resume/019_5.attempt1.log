+DISTANCE_SUM_BUCKETS: dict[int, list[tuple[int, int, int, int]]] = {}
+for combo in DISTANCE_SETS:
+    DISTANCE_SUM_BUCKETS.setdefault(sum(combo), []).append(combo)
+TIE_DISTANCE_PAIRS = [
