+    r1 = max(rows) - 1
+    c0 = min(cols) + 1
+    c1 = max(cols) - 1
+    assert r1 - r0 + 1 >= 3
+    assert c1 - c0 + 1 >= 3
+    pixels: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        pixels.add((r0, c))
+        pixels.add((r1, c))
+    for r in range(r0, r1 + 1):
+        pixels.add((r, c0))
+        pixels.add((r, c1))
+    return pixels
