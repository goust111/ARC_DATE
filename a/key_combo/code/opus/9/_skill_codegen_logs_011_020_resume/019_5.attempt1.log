+        marker = (r, distance + 1)
+    elif side == "R":
+        gate = (r, w - 1)
+        path_cells = [(r, cc) for cc in range(w - distance - 1, w - 1)]
+        marker = (r, w - distance - 2)
+    elif side == "T":
