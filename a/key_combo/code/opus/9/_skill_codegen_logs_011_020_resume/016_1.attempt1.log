+                    continue
+                if out[rr, ec] == color:
+                    visible = True
+                    break
+        if not visible:
+            return False
+
+    mixed_rows = any(pair["axis"] == "row" for pair in pairs)
+    mixed_cols = any(pair["axis"] == "col" for pair in pairs)
+    if mixed_rows and mixed_cols:
