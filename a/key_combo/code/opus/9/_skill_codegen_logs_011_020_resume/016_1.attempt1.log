+
+
+BG = int(Color.BLACK)
+BARRIER = int(Color.GREY)
+CENTER = int(Color.PINK)
+MARKER_COLORS = (int(Color.BLUE), int(Color.RED), int(Color.GREEN), int(Color.YELLOW))
+
+_GEN_SHAPES = (
