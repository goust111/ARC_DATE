+def _render_from_pairs(shape: tuple[int, int], barrier_mask: np.ndarray, pairs: list[dict]) -> np.ndarray:
+    H, W = map(int, shape)
+    out = np.full((H, W), BG, dtype=int)
+    out[barrier_mask] = BARRIER
