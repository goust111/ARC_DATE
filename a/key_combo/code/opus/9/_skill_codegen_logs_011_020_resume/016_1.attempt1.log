+def _cells_with_halo(cells: list[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    H, W = shape
+    halo = set()
+    for r, c in cells:
+        halo.add((r, c))
+        for rr, cc in _neighbors8(r, c):
