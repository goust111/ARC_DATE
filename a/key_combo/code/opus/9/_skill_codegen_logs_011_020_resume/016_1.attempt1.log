+
+def _place_extra_h(
+    shape: tuple[int, int],
+    count: int,
+    barrier: np.ndarray,
+    halo_used: set[tuple[int, int]],
+) -> bool:
+    H, W = shape
+    vertical_rows = {int(r) for r in np.flatnonzero(barrier.any(axis=1) & (~(barrier.sum(axis=1) > 1)))}
+    blocked_cols = {int(c) for c in np.flatnonzero(barrier.any(axis=0))}
+    for _ in range(count):
+        placed = False
+        for _attempt in range(120):
