+
+
+def _place_extra_v(
+    shape: tuple[int, int],
+    count: int,
+    barrier: np.ndarray,
+    halo_used: set[tuple[int, int]],
+) -> bool:
+    H, W = shape
+    blocked_cols = {int(c) for c in np.flatnonzero(barrier.any(axis=0))}
+    blocked_rows = {int(r) for r in np.flatnonzero(barrier.any(axis=1))}
+    for _ in range(count):
+        placed = False
+        for _attempt in range(120):
