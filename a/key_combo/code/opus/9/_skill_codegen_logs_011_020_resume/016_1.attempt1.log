+        if not visible_override:
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _attempt in range(_GEN_RETRIES):
+        H = random.randint(16, 24)
+        W = random.randint(16, 24)
+        grid = np.full((H, W), BG, dtype=int)
+        barrier = np.zeros((H, W), dtype=int)
