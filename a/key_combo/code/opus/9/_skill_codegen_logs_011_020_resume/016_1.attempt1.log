+            length = random.randint(3, min(6, H - 2))
+            r0 = random.randint(1, H - length - 1)
+            r1 = r0 + length - 1
+            if any(r in blocked_rows for r in range(r0, r1 + 1)):
+                continue
+            cells = _vertical_cells(c, r0, r1)
+            if not _segment_clear(cells, halo_used, shape):
