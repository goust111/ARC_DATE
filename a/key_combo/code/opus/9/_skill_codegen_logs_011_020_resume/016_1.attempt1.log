+        right_choices = [c for c in safe_cols if c1 + 2 <= c <= grid.shape[1] - 2 and c not in used_cols]
+        if not left_choices or not right_choices:
+            return None
+        lc = random.choice(left_choices)
+        rc = random.choice(right_choices)
+        used_cols.update((lc, rc))
