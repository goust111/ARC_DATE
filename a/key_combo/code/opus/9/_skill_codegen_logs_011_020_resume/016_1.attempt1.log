+            r = random.randint(2, H - 3)
+            length = random.randint(3, min(6, W - 4))
+            c0 = random.randint(2, W - length - 2)
+            c1 = c0 + length - 1
+            left_center = c0 - 1
+            right_center = c1 + 1
+            if left_center in center_cols or right_center in center_cols:
