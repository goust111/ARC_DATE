+            top_dst = (int(r1) + 1, int(c))
+            bottom_dst = (int(r0) - 1, int(c))
+            assert top_dst[0] > r1 and bottom_dst[0] < r0
+            emitters.append({"pos": bottom_dst, "ray_color": int(pair["bottom_color"])})
+            emitters.append({"pos": top_dst, "ray_color": int(pair["top_color"])})
