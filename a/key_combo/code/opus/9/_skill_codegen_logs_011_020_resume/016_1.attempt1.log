+            right_dst = (int(r), int(c0) - 1)
+            assert in_bounds((r + 1, c1 + 2), *left_dst)
+            assert left_dst[1] > c1 and right_dst[1] < c0
+            emitters.append({"pos": right_dst, "ray_color": int(pair["right_color"])})
