+            right_dst = (int(r), int(c0) - 1)
+            assert left_dst[1] > c1 and right_dst[1] < c0
+            emitters.append({"pos": left_dst, "ray_color": int(pair["right_color"])})
+            emitters.append({"pos": right_dst, "ray_color": int(pair["left_color"])})
+        else:
