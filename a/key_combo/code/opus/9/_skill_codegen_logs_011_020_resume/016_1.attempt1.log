+    n_iso = random.choices([0, 1, 2][: max_iso + 1], weights=[2, 5, 3][: max_iso + 1], k=1)[0]
+    placed = 0
+    for color, (r, c) in zip(extra_colors, cells):
+        if placed >= n_iso:
