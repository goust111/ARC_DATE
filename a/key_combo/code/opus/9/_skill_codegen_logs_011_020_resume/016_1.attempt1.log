+def _pair_signature(pairs: list[dict]) -> set[tuple]:
+    out = set()
+    for pair in pairs:
+        if pair["axis"] == "row":
+            pts = tuple(sorted((pair["left"], pair["right"])))
+            out.add(("row", pair["barrier"], pts))
+        else:
