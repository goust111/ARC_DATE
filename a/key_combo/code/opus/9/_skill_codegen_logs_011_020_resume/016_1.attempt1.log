+                    "axis": "row",
+                    "left": (lr, lc),
+                    "right": (rr, rc),
+                    "left_color": int(g[lr, lc]),
+                    "right_color": int(g[rr, rc]),
+                    "barrier": (r, c0, c1),
+                }
+            )
+
+    for c in range(W):
+        runs = _gray_runs(g[:, c])
+        if len(runs) != 1:
+            continue
+        r0, r1 = runs[0]
+        top = [(r, c) for r in range(r0) if (r, c) in markers]
+        bottom = [(r, c) for r in range(r1 + 1, H) if (r, c) in markers]
+        if len(top) == 1 and len(bottom) == 1:
+            (tr, tc), (br, bc) = top[0], bottom[0]
