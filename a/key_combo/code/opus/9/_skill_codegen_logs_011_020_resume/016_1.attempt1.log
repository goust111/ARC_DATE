    n_row_pairs, n_col_pairs = mod._pick_shape()
    n_pairs = n_row_pairs+n_col_pairs
    n_extra = random.randint(0,max(0,4-n_pairs))
    n_extra_h = random.randint(0,n_extra); n_extra_v=n_extra-n_extra_h
    row_pairs = mod._place_row_pairs((H,W), n_row_pairs, barrier, halo)
    if row_pairs is None:
        ctr['row_pairs']+=1; continue
    col_pairs = mod._place_col_pairs((H,W), n_col_pairs, barrier, halo, {pair['row'] for pair in row_pairs})
    if col_pairs is None:
        ctr['col_pairs']+=1; continue
    if not mod._place_extra_h((H,W), n_extra_h, barrier, halo):
        ctr['extra_h']+=1; continue
    if not mod._place_extra_v((H,W), n_extra_v, barrier, halo):
        ctr['extra_v']+=1; continue
    grid[barrier == mod.BARRIER] = mod.BARRIER
    pair_colors = mod._pick_pair_colors(n_pairs)
    placed = mod._place_pair_markers(grid, row_pairs, col_pairs, pair_colors)
    if placed is None:
        ctr['place_markers']+=1; continue
    planned_pairs, counts = placed
    n_isolates = mod._place_isolates(grid, counts)
    if any(count > 2 for count in counts.values()):
        ctr['color_count']+=1; continue
    if len(np.unique(grid)) < 4:
        ctr['few_colors']+=1; continue
    if not mod._semantic_checks(grid, planned_pairs, n_isolates):
        ctr['semantic']+=1; continue
    ctr['success']+=1
print(ctr)
