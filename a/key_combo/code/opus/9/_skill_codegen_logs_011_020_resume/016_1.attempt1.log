+    blocked_rows = {int(r) for r in np.flatnonzero(barrier.any(axis=1))}
+    for _ in range(count):
+        placed = False
+        for _attempt in range(120):
+            r = random.randint(1, H - 2)
+            if r in blocked_rows:
