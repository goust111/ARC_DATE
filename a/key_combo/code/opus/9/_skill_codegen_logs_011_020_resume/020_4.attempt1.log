    col_bias = sum(dc for _dr, dc in rel)
    assert (row_bias == 0) != (col_bias == 0)

    if row_bias != 0:
        assert abs(row_bias) == 3 and col_bias == 0
        return (-1 if row_bias > 0 else 1, 0)

    assert abs(col_bias) == 3 and row_bias == 0
    return (0, -1 if col_bias > 0 else 1)


