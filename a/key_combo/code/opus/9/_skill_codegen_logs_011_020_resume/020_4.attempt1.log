        rr += 2 * dr
        cc += 2 * dc

    if direction == (-1, 0):
        out[0, :] = marker_color
    elif direction == (1, 0):
        out[H - 1, :] = marker_color
    elif direction == (0, -1):
        out[:, 0] = marker_color
    else:
        out[:, W - 1] = marker_color


