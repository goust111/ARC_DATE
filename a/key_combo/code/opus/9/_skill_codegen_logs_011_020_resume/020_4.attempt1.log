    out: np.ndarray, marker_color: int, r: int, c: int, direction: tuple[int, int],
) -> None:
    """Paint the dotted ray and fill the target boundary row/col."""
    H, W = out.shape
    dr, dc = direction
    rr, cc = r + 2 * dr, c + 2 * dc
    while 0 <= rr < H and 0 <= cc < W:
