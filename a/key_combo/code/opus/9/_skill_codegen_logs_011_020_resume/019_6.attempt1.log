+    rr0 = r0 + off_r
+    cc0 = c0 + off_c
+    patch = grid[rr0 : rr0 + mask.shape[0], cc0 : cc0 + mask.shape[1]]
+    patch[mask.astype(bool)] = int(color)
+
+
+def _valid_split_choices(rect: tuple[int, int, int, int]) -> list[tuple[str, int]]:
+    r0, c0, r1, c1 = map(int, rect)
+    choices: list[tuple[str, int]] = []
+    if r1 - r0 + 1 >= 2 * MIN_REGION_SIDE + 1:
+        choices.append(("h", rng_range_len(r0 + MIN_REGION_SIDE, r1 - MIN_REGION_SIDE)))
+    if c1 - c0 + 1 >= 2 * MIN_REGION_SIDE + 1:
+        choices.append(("v", rng_range_len(c0 + MIN_REGION_SIDE, c1 - MIN_REGION_SIDE)))
+    return choices
+
+
+def rng_range_len(lo: int, hi: int) -> int:
+    return int(hi - lo + 1)
+
+
+def _split_regions(shape: tuple[int, int], target_regions: int, rng: random.Random) -> tuple[list[tuple[int, int, int, int]], list[tuple[str, int, int, int]]]:
+    H, W = map(int, shape)
+    rects = [(0, 0, H - 1, W - 1)]
