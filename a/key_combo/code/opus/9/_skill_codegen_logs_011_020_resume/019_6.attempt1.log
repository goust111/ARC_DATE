+    return rng.randint(20, 28), rng.randint(20, 28)
+
+
+def _gen_attempt(case_id: int) -> np.ndarray | None:
+    rng = random.Random((case_id + 1) * 1009)
+    target_regions = 4 if case_id % 3 == 0 else 5
+    common_holes = 1 if case_id % 2 == 0 else 2
