    holes = [info['holes'] for info in infos]
    region_counts[len(infos)] += 1
    outlier_holes[holes[idx]] += 1
    common = [h for i, h in enumerate(holes) if i "'!= idx]
    common_holes[common[0]] += 1
    assert len(set(common)) == 1
