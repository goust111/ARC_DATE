+        obj = _single_object(region_patch)
+        holes = _count_holes_from_bg(region_patch)
+        completed = _complete_rotational_symmetry(region_patch)
+        regions.append(
+            {
+                "bbox": tuple(map(int, region["bbox"])),
+                "patch": region_patch,
