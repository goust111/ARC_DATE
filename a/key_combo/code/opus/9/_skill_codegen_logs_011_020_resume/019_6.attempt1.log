+        choices.append(("h", rng_range_len(r0 + MIN_REGION_SIDE, r1 - MIN_REGION_SIDE)))
+    if c1 - c0 + 1 >= 2 * MIN_REGION_SIDE + 1:
+        choices.append(("v", rng_range_len(c0 + MIN_REGION_SIDE, c1 - MIN_REGION_SIDE)))
