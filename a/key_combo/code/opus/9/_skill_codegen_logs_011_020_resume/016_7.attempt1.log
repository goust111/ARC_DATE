+        if len(cells) != area:
+            continue
+        if all(r == anchor_row for r, _ in cells):
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        if np.array_equal(mask, np.fliplr(mask)):
+            continue
+        if np.array_equal(mask, np.flipud(mask)):
+            continue
+        if np.array_equal(mask, np.rot90(mask, 2)):
+            continue
