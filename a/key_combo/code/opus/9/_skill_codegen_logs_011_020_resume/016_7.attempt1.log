+        for src_dir in _source_dir_candidates(allowed_dirs, outward_dir, source_mode):
+            rotated_offsets = [_rot_from_east(offset, src_dir) for offset in base_offsets]
+            src_template = {
+                (source_ep[0] + dr, source_ep[1] + dc)
