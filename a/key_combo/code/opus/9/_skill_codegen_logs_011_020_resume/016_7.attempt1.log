+def _random_with_gap(lo: int, hi: int, count: int, gap: int) -> list[int]:
+    values = list(range(int(lo), int(hi) + 1))
+    random.shuffle(values)
+    picked: list[int] = []
+    for value in values:
+        if all(abs(value - other) >= int(gap) for other in picked):
+            picked.append(int(value))
+            if len(picked) == count:
+                break
