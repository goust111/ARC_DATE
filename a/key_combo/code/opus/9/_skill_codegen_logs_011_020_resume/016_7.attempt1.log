+    for _ in range(500):
+        if orientation == "h":
+            left_hi = min(8, w - 14)
+            if left_hi < 5:
+                continue
+            left_c = random.randint(5, left_hi)
+            right_lo = left_c + 8
+            right_hi = w - 6
+            if right_lo > right_hi:
