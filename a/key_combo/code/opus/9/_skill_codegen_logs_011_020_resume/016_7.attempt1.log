+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(sorted(frontier)))
+
+        if len(cells) != area:
+            continue
+        if all(r == anchor_row for r, _ in cells):
+            continue
+
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        if np.array_equal(mask, np.fliplr(mask)):
