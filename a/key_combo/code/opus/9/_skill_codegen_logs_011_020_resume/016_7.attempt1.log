+        sr, sc = spec["source_marker"]
+        assert int(out[sr, sc]) == BG, "source marker must be erased"
+        rr, rc = spec["remote_marker"]
+        assert int(out[rr, rc]) == spec["remote_color"], "remote marker must remain"
+        for r, c in spec["template_cells"]:
