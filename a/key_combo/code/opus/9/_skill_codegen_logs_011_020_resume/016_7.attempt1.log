+def _make_template_shape() -> tuple[set[Coord], int]:
+    for _ in range(300):
+        h = random.choice((3, 4))
+        w = random.choice((3, 4))
+        anchor_row = random.randrange(h)
+        area = random.randint(4, min(7, h * w - 1))
+        cells: set[Coord] = {(anchor_row, 0), (anchor_row, 1)}
+        while len(cells) < area:
+            frontier: set[Coord] = set()
+            for r, c in cells:
