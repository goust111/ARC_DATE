+def _endpoint_allowed_dirs(orientation: str, endpoint_side: str) -> tuple[list[str], str]:
+    if orientation == "h":
+        if endpoint_side == "left":
+            return ["N", "S", "W"], "W"
+        return ["N", "S", "E"], "E"
+    if endpoint_side == "top":
