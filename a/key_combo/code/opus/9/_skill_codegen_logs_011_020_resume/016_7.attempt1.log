+        specs: list[dict] = []
+        occupied_input: set[Coord] = set()
+        reserved_future: set[Coord] = set()
+        ok = True
+        try:
+            for axis_pos, source_mode in zip(axes, source_modes):
+                spec = _make_network_spec(
+                    (height, width),
+                    orientation,
+                    axis_pos,
+                    occupied_input,
+                    reserved_future,
+                    source_mode,
