+    pool = [outward, outward] + orthogonal + orthogonal[:]
+    random.shuffle(pool)
+    seen: list[str] = []
+    for item in pool:
+        if item not in seen:
+            seen.append(item)
+    for item in allowed:
+        if item not in seen:
+            seen.append(item)
+    return seen
