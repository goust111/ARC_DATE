+
+
+def _rot_from_east(offset: Coord, direction: str) -> Coord:
+    dr, dc = map(int, offset)
+    if direction == "E":
+        return dr, dc
+    if direction == "S":
+        return dc, -dr
+    if direction == "W":
+        return -dr, -dc
+    if direction == "N":
