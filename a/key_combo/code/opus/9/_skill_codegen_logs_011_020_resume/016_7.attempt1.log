+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: set[Coord] = set()
+            while q:
+                rr, cc = q.popleft()
+                comp.add((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _degree_in_component(cell: Coord, comp: set[Coord]) -> int:
+    r, c = cell
+    return sum((nr, nc) in comp for nr, nc in _neighbors4(r, c))
+
+
+def _rot_from_east(offset: Coord, direction: str) -> Coord:
+    dr, dc = map(int, offset)
+    if direction == "E":
+        return dr, dc
+    if direction == "S":
+        return dc, -dr
+    if direction == "W":
+        return -dr, -dc
+    if direction == "N":
+        return -dc, dr
+    raise ValueError(direction)
+
