+Coord = tuple[int, int]
+DIRS4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR_VEC: dict[str, Coord] = {"N": (-1, 0), "S": (1, 0), "W": (0, -1), "E": (0, 1)}
+MARKER_COLORS = {1, 2, 3, 4}
+WIRE = 5
