+                            placements.append([(r, c), (nr, nc)])
+        if not placements:
+            return False
+        cells = random.choice(placements)
+        for r, c in cells:
+            grid[r, c] = RED
+        for r, c in cells:
+            rr0 = max(0, r - 1)
+            rr1 = min(h, r + 2)
+            cc0 = max(0, c - 1)
+            cc1 = min(w, c + 2)
+            blocked[rr0:rr1, cc0:cc1] = True
