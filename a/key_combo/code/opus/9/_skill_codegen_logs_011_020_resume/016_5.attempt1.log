+            copy_coords, copy_color = copy_info
+            if np.any(occupied_all[copy_coords[:, 0], copy_coords[:, 1]]):
+                continue
+            if np.any(reserved_copy[copy_coords[:, 0], copy_coords[:, 1]]):
+                continue
+            candidates.append(
