+_GEN_ROWS = (18, 24)
+_GEN_COLS = (18, 24)
+_GEN_COUNTS = (2, 3, 4)
+_GEN_COUNT_WEIGHTS = (2, 4, 3)
+_GEN_SIDES = ("top", "bottom", "left", "right")
+_GEN_TAB_SIDES = ("left", "right", "top", "bottom")
+_GEN_RETRIES = 400
+_N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
