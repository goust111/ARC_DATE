+
+def _mark_with_gap(blocked: np.ndarray, coords: np.ndarray) -> None:
+    h, w = map(int, blocked.shape)
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        blocked[rr, cc] = True
+        for dr, dc in _N4:
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < h and 0 <= nc < w:
