+            prev = coords + np.array([-1, 0], dtype=int)
+            if not np.any(occupied_all[prev[:, 0], prev[:, 1]]):
+                continue
+            supported = bool(np.any(occupied_green[prev[:, 0], prev[:, 1]]))
+            if require_supported and not supported:
