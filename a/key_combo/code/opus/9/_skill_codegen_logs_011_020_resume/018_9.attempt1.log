+    assert patch.shape[0] >= 5 and patch.shape[1] >= 5
+    assert np.all(patch[:, 0] == FRAME)
+    assert np.all(patch[:, -1] == FRAME)
+    assert np.all(patch[-1, :] == FRAME)
+    assert np.all(np.isin(patch[0, :], [FRAME, GREEN]))
+    assert np.count_nonzero(patch[0, :] == GREEN) >= 1
