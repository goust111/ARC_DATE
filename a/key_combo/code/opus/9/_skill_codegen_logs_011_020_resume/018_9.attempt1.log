+        return None
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt()
+        if grid is not None:
+            return grid
