    return comps


def _matched_scaled_mask(templates: list[np.ndarray], seed_mask: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
    ih, iw = map(int, shape)
    matches: list[np.ndarray] = []
    for template in templates:
        th, tw = template.shape
        if ih % th != 0 or iw % tw != 0:
            continue
        sh = ih // th
        sw = iw // tw
