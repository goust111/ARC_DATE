# Generator configuration.
GRID_SIZE_RANGE = (15, 19)
EDGES = ("top", "bottom", "left", "right")
HORIZONTAL_EDGES = {"top", "bottom"}
BACKGROUND_COLOR = 0
WALL_COLOR = 5
SEGMENT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
SEGMENT_COUNT_RANGE = (3, 4)

