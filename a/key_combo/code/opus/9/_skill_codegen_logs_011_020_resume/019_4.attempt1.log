    c_max = W - border - w
    if r_max < r_min or c_max < c_min:
        raise ValueError("random_free_location: patch cannot fit (border too large or patch too big)")

    occ = (canvas != bg)
    if padding > 0:
        struct = STRUCT4 if pad_conn == 4 else STRUCT8

