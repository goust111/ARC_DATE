+def _marker_pattern(count: int, rng: np.random.Generator) -> np.ndarray:
+    cells = [(0, 0), (0, 1), (1, 0), (1, 1)]
+    rng.shuffle(cells)
+    marker = np.zeros((4, 2), dtype=bool)
+    for r, c in cells[:count]:
+        marker[r + 1, c] = True
+    return marker
