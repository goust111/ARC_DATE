def _random_transform(mask: np.ndarray) -> np.ndarray:
    """Apply a random rotation (0-3) and optional horizontal flip to a mask."""
    mask = np.rot90(mask, int(_RNG.integers(0, 4)))
    if bool(_RNG.integers(0, 2)):
