        h = bbox_h(rect["bbox"])
        w = bbox_w(rect["bbox"])
        assert int(rect["area"]) == h * w
        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == 8)
        out[r0 : r1 + 1, c0 : c1 + 1] = _frame_patch(h, w)

    return out

