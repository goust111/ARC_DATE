        (edge == "top" and r0 == r1 == 0 and c0 == 0 and c1 == w - 1)
        or (edge == "bottom" and r0 == r1 == h - 1 and c0 == 0 and c1 == w - 1)
        or (edge == "left" and c0 == c1 == 0 and r0 == 0 and r1 == h - 1)
        or (edge == "right" and c0 == c1 == w - 1 and r0 == 0 and r1 == h - 1)
    )


