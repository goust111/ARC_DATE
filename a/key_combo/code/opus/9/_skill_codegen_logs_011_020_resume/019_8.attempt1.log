+def _stamp_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    ar, ac = a
+    br, bc = b
+    return not (ar + 3 < br or br + 3 < ar or ac + 3 < bc or bc + 3 < ac)
