        "TR": (0, W - 1),
        "BL": (H - 1, 0),
        "BR": (H - 1, W - 1),
    }


def _gen_control_pool(grid, motif_mask, blocked_mask):
    H, W = grid.shape
    near_motif = _gen_dilate8(motif_mask)
    pool = []
    corners = set(_gen_corner_cells((H, W)).values())
    for r in range(H):
        for c in range(W):
            if (r, c) in corners:
                continue
            if grid[r, c] != 0 or near_motif[r, c] or blocked_mask[r, c]:
                continue
            pool.append((r, c))
    return pool


