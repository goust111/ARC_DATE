            return "TL"
        if patch[n - 1, n - 1] and not patch[0, 0]:
            return "BR"
    if anti_ok:
        if patch[0, n - 1] and not patch[n - 1, 0]:
            return "TR"
        if patch[n - 1, 0] and not patch[0, n - 1]:
            return "BL"
    return None


def _gen_symmetric_motif_patch(max_h, max_w):
    candidates = []
