  grid: 10 rows x 3-6 cols [observed rows=10 in all examples]
  background: 0
  top_band:
    location: contiguous full-width rows starting at row 0
    height: 2-3 (must satisfy band_h * 2 <= grid_rows)
    content: every pixel is non-background; each row is a single solid color
    distinct_colors: 2 [observed]
    row_pattern: consecutive rows may repeat colors (not required to alternate)
  gap: all rows below the band are background; gap_height = grid_rows - band_h, gap >= band_h
  transform:
    copy top band to bottom rows in vertically reversed row order
    top band and middle gap are preserved unchanged

generation_strategy:
