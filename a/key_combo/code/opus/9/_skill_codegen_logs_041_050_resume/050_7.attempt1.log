    return int(rng.integers(low, canvas_high))

def _gen_axis_starts(rng, n, length):
    if n == 2:
        base_steps = np.array([PAIR_AXIS_STEP], dtype=int)
    else:
        base_steps = np.full(n - 1, MULTI_AXIS_STEP, dtype=int)
