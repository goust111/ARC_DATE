            extra_steps[forced_i] += forced
            slack -= forced
        for _ in range(slack):
            bucket = int(rng.integers(0, n + 1))
            if bucket == 0:
                lead += 1
            elif bucket < n:
                extra_steps[bucket - 1] += 1

    starts = [EDGE_MARGIN + lead]
    for step in base_steps + extra_steps:
