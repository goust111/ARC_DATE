def _sample_count_order() -> list[int]:
    if _RNG.random() < 0.7:
        orders = ([0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1])
    else:
        orders = ([0, 1, 2], [2, 1, 0])
    return list(orders[int(_RNG.integers(len(orders)))])


def _validate_semantics(inp: np.ndarray, expected: np.ndarray) -> bool:
    rects = _parse_rectangles(inp)
    sprites = _parse_sprites(inp)
    if len(rects) != 3 or len(sprites) != 3:
        return False

    counts = [_split_count(rect["patch"]) for rect in rects]
    if sorted(counts) != [0, 1, 2]:
        return False

    orientations = []
    for rect in rects:
        h, w = rect["patch"].shape
        orientations.append("tall" if h > w else "square" if h == w else "wide")
    if len(set(orientations)) < 2:
        return False

    if max(expected.shape) > 30:
        return False
    if not np.array_equal(main(inp), expected):
        return False
    return True


def _gen_attempt() -> tuple[np.ndarray, np.ndarray] | None:
    count_order = _sample_count_order()
    orientation_order = list(_ORIENTATION_PATTERNS[int(_RNG.integers(len(_ORIENTATION_PATTERNS)))])
    sprite_masks = _choose_three_sprites()
    color_order = list(_RNG.permutation(np.array(_SPRITE_COLORS, dtype=int)))

    rect_specs = []
    sprite_specs = []
    rect_cursor = int(_RNG.integers(1, 3))
    sprite_cursor = int(_RNG.integers(1, 3))
    rect_xs = []
    sprite_xs = []

    for i in range(3):
        rh, rw = _dims_for_orientation(orientation_order[i])
        rect_specs.append({"h": rh, "w": rw, "count": count_order[i]})
        rect_xs.append(int(_RNG.integers(1, 4)))
        rect_specs[-1]["r0"] = rect_cursor
        rect_cursor += rh + int(_RNG.integers(1, 4))

        mask = sprite_masks[i]
        sh, sw = mask.shape
        sprite_specs.append({"mask": mask, "h": sh, "w": sw, "color": int(color_order[i])})
        sprite_specs[-1]["r0"] = sprite_cursor
        sprite_cursor += sh + int(_RNG.integers(1, 5))

    h = max(rect_cursor, sprite_cursor) + int(_RNG.integers(0, 2))
    if h > 28:
        return None

    w = int(_RNG.integers(15, 20))
    min_sprite_x = max(w // 2 + 1, 9)
    max_sprite_w = max(spec["w"] for spec in sprite_specs)
    if min_sprite_x + max_sprite_w > w - 1:
        return None

    for spec in sprite_specs:
        max_x = w - spec["w"] - 1
        if min_sprite_x > max_x:
            return None
        sprite_xs.append(int(_RNG.integers(min_sprite_x, max_x + 1)))

    grid = np.zeros((h, w), dtype=int)

    for spec, x in zip(rect_specs, rect_xs):
        r0 = spec["r0"]
        c0 = x
        rh, rw = spec["h"], spec["w"]
        if c0 + rw >= w // 2 + 1:
            return None
        grid[r0 : r0 + rh, c0 : c0 + rw] = GREY
        for rr, cc in _sample_markers(rh, rw, spec["count"]):
            grid[r0 + rr, c0 + cc] = RED

    for spec, x in zip(sprite_specs, sprite_xs):
        r0 = spec["r0"]
        c0 = x
        sh, sw = spec["h"], spec["w"]
        patch = np.where(spec["mask"] == 1, spec["color"], BG)
        if c0 < w // 2:
            return None
        region = grid[r0 : r0 + sh, c0 : c0 + sw]
        if region.shape != patch.shape or np.any(region != BG):
            return None
        grid[r0 : r0 + sh, c0 : c0 + sw] = patch

    factors = [count + 1 for count in count_order]
    expected = _build_expected(sprite_specs, factors)
    if not _validate_semantics(grid, expected):
        return None
    return grid, expected


def generate_input() -> np.ndarray:
    for _ in range(400):
        result = _gen_attempt()
        if result is not None:
            return result[0]
    raise RuntimeError("failed to generate a valid input for puzzle 7")

