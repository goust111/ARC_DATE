    ((0, 0), (0, 2), (2, 0), (2, 2)),
    ((0, 1), (2, 1)), ((1, 0), (1, 2)), ((1, 1),),
)
PATTERN_GROUP_CHOICES = ((1, 2), (0, 3), (1, 2, 3), (0, 1, 3), (0, 2, 3))
# Layout spacing constraints.
PAIR_AXIS_MIN_LENGTH = 10
PAIR_AXIS_STEP = 5
MULTI_AXIS_STEP = 4
MAX_CROSS_SPAN = 4
