            area = height * width
            min_count = max(GEN_FG_COUNT_MIN, (min_num * area + min_den - 1) // min_den)
            max_count = min(GEN_FG_COUNT_MAX, (max_num * area) // max_den)
            if min_count <= fg_count <= max_count:
