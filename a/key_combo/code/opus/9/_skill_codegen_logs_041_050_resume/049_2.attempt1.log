+def _seed_forced_orbits(
+    n: int,
+    rect: tuple[int, int, int, int],
+    pattern_colors: tuple[int, ...],
+    rng: random.Random,
+) -> dict[tuple[int, int], int]:
+    r0, c0, h, w = rect
+    phase = rng.randrange(len(pattern_colors))
+    color_by_rep: dict[tuple[int, int], int] = {}
+    lookup = _orbit_lookup(n)
+    for r in range(r0, r0 + h):
+        for c in range(c0, c0 + w):
+            rep = min(lookup[(r, c)])
+            if rep not in color_by_rep:
+                idx = (rep[0] + 2 * rep[1] + phase) % len(pattern_colors)
+                color_by_rep[rep] = int(pattern_colors[idx])
+    return color_by_rep
+
+
+def _expand_cluster(
+    n: int,
+    seed: tuple[int, int],
+    size: int,
+    forbidden: set[tuple[int, int]],
+    rng: random.Random,
+) -> set[tuple[int, int]]:
+    lookup = _orbit_lookup(n)
+    cluster: set[tuple[int, int]] = set()
+    frontier = [seed]
+    while frontier and len(cluster) < size:
+        rep = frontier.pop(rng.randrange(len(frontier)))
+        if rep in cluster or rep in forbidden:
+            continue
+        cluster.add(rep)
+        rr, cc = rep
+        for dr, dc in NEIGHBORS8:
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < n and 0 <= nc < n:
+                frontier.append(min(lookup[(nr, nc)]))
+    return cluster
+
+
