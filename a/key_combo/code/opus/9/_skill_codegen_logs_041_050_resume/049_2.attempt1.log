+
+def _expand_cluster(
+    n: int,
+    seed: tuple[int, int],
+    size: int,
+    forbidden: set[tuple[int, int]],
+    rng: random.Random,
+) -> set[tuple[int, int]]:
+    lookup = _orbit_lookup(n)
+    cluster: set[tuple[int, int]] = set()
+    frontier = [seed]
+    while frontier and len(cluster) < size:
+        rep = frontier.pop(rng.randrange(len(frontier)))
+        if rep in cluster or rep in forbidden:
+            continue
+        cluster.add(rep)
+        rr, cc = rep
+        for dr, dc in NEIGHBORS8:
+            nr = rr + dr
+            nc = cc + dc
+            if 0 <= nr < n and 0 <= nc < n:
+                frontier.append(min(lookup[(nr, nc)]))
+    return cluster
+
+
