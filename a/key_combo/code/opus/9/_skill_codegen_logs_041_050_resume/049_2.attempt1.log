+def _repair_pattern(grid: np.ndarray, token_colors: set[int]) -> tuple[np.ndarray, np.ndarray]:
+    repaired = np.array(grid, dtype=int, copy=True)
+    missing = _missing_mask(repaired, token_colors)
+    for r_raw, c_raw in np.argwhere(missing):
+        r = int(r_raw)
+        c = int(c_raw)
+        vals = _orbit_values(
+            repaired,
+            r,
+            c,
+            ignore_colors=token_colors,
+            allow_zero=False,
+        )
+        assert len(vals) == 1
+        repaired[r, c] = next(iter(vals))
+    return repaired, missing
 
 
