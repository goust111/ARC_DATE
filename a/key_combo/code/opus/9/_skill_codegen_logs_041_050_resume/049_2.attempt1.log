        max_drop = max(max_drop, full_hit - r - 1)

    if dep_hits < 1 or ind_hits < 1 or max_drop < 2:
        return False

    expected = _drop_tokens(full, _token_records_for_drop(tokens))
    try:
        actual = main(inp)
    except AssertionError:
        return False
    return np.array_equal(actual, expected)


def _generate_attempt(rng: random.Random) -> np.ndarray | None:
    n = rng.choice(GRID_SIZES)
    rect = _choose_missing_rect(n, rng)
    pattern_colors = _choose_pattern_colors(rng)
    full = _build_full_pattern(n, rect, pattern_colors, rng)

    used_pattern = sorted(int(color) for color in np.unique(full) if int(color) != 0)
    if len(used_pattern) < 2 or len(used_pattern) > 3:
        return None
    if any(int(np.count_nonzero(full == color)) <= 2 for color in used_pattern):
        return None

    dependent, independent = _candidate_tokens(full, rect)
    tokens = _pick_tokens(dependent, independent, rng)
    if not tokens:
        return None

    r0, c0, h, w = rect
    inp = full.copy()
    inp[r0 : r0 + h, c0 : c0 + w] = 0
    for r, c, color, _kind in tokens:
        if int(inp[r, c]) != 0:
            return None
        inp[r, c] = color

    if not _validate_instance(inp, full, rect, tokens):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _generate_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid symmetric-rebuild gravity instance")

