        kind = 1 if (r, c) in dependent_set else 0
        tokens.append((r, c, color, kind))
    return sorted(tokens, key=lambda item: (item[0], item[1]), reverse=True)


def _token_records_for_drop(tokens: list[tuple[int, int, int, int]]) -> list[tuple[int, int, int, int]]:
    return [(r, c, color, 0) for r, c, color, _kind in tokens]


