+    n: int,
+    rect: tuple[int, int, int, int],
+    pattern_colors: tuple[int, ...],
+    rng: random.Random,
+) -> np.ndarray:
+    lookup = _orbit_lookup(n)
+    color_by_rep = _seed_forced_orbits(n, rect, pattern_colors, rng)
+    forbidden = set(color_by_rep)
+    reps = [rep for rep in _canonical_reps(n) if len(lookup[rep]) >= 4]
 
