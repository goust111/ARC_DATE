+    pattern_w = c1 - c0 + 1
+    h, w = mask.shape
+    max_top = (pattern_h - 2 * h - 1) // 2
+    max_left = (pattern_w - 2 * w - 1) // 2
+    if max_top < 1 or max_left < 1:
+        return None
 
