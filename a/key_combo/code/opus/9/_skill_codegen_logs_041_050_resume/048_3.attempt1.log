+def _place_family(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    pattern_bbox: tuple[int, int, int, int],
+    mask: np.ndarray,
+    color: int,
+    rng: random.Random,
+) -> set[tuple[int, int]] | None:
+    r0, c0, r1, c1 = pattern_bbox
