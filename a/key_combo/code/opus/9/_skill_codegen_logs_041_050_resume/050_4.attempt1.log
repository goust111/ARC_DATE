MAX_GENERATION_ATTEMPTS = 300


def _gen_wall_rows():
    if random.random() < THREE_WALL_ROW_PROB:
        return [0, random.choice(THREE_WALL_ROW_MIDDLES), GRID_LAST]
    return list(FOUR_WALL_ROWS)


def _gen_wall_cols():
    return list(random.choice(WALL_COL_PAIRS))


