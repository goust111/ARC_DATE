+    shape: tuple[int, int], coord: tuple[int, int], rotations: int, flip_lr: bool
+) -> tuple[int, int]:
+    h, w = map(int, shape)
+    r, c = map(int, coord)
+    for _ in range(rotations % 4):
+        r, c = c, h - 1 - r
+        h, w = w, h
+    if flip_lr:
+        c = w - 1 - c
+    return int(r), int(c)
 
 
