-        return False
-
-    if int(inp[touched_hole]) != 0 or int(inp[touched_solid]) != 0:
-        return False
-
-    hole_block_r = touched_hole[0] // period[0]
-    hole_block_c = touched_hole[1] // period[1]
-    solid_block_r = touched_solid[0] // period[0]
-    solid_block_c = touched_solid[1] // period[1]
-    r0 = hole_block_r * period[0]
-    c0 = hole_block_c * period[1]
-    rr0 = solid_block_r * period[0]
-    cc0 = solid_block_c * period[1]
-    raw_hole_tile = inp[r0 : r0 + period[0], c0 : c0 + period[1]]
-    raw_solid_tile = inp[rr0 : rr0 + period[0], cc0 : cc0 + period[1]]
-
-    raw_hollow, _ = _classify_components(raw_hole_tile)
-    if raw_hollow:
-        return False
-
-    complete_solid_components = [comp for comp in _find_components(complete[rr0 : rr0 + period[0], cc0 : cc0 + period[1]]) if not _component_has_hole(complete[rr0 : rr0 + period[0], cc0 : cc0 + period[1]], comp)]
