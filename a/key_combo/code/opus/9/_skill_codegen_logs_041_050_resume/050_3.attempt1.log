def _local_components(tile: np.ndarray):
    return _find_components(tile)


def _articulation_cells(tile: np.ndarray, component: dict):
    coords = component["coords"]
    coord_set = component["coord_set"]
    if len(coords) < 3:
        return []
    out = []
    for removed in coords:
        remaining = coord_set - {removed}
        start = next(iter(remaining))
        seen = {start}
        q = deque([start])
        while q:
            r, c = q.popleft()
            for nr, nc in _neighbors4(r, c):
                if (nr, nc) in remaining and (nr, nc) not in seen:
                    seen.add((nr, nc))
                    q.append((nr, nc))
        if len(seen) != len(remaining):
            out.append(removed)
    return out


def _choose_damage_plan(tile: np.ndarray):
    hollow_cells = []
    solid_breaks = []
    for comp in _local_components(tile):
        if _component_has_hole(tile, comp):
            hollow_cells.extend(comp["coords"])
        else:
            articulation = _articulation_cells(tile, comp)
            if articulation:
                solid_breaks.extend(articulation)
    if not hollow_cells or not solid_breaks:
        return None
    return random.choice(hollow_cells), random.choice(solid_breaks)


def _tile_grid(tile: np.ndarray, nr: int, nc: int) -> np.ndarray:
    return np.tile(tile, (nr, nc))


def _orbit_positions(shape: tuple[int, int], period: tuple[int, int], orbit_cell: tuple[int, int]):
    h, w = shape
    pr, pc = period
    r0, c0 = orbit_cell
    return [(r, c) for r in range(r0, h, pr) for c in range(c0, w, pc)]


def _apply_damage(full: np.ndarray, period: tuple[int, int], mandatory: list[tuple[int, int]], target: int) -> np.ndarray:
    damaged = np.array(full, dtype=int, copy=True)
    h, w = full.shape
    pr, pc = period
    orbit_counts = {}
    for r in range(pr):
        for c in range(pc):
            if int(full[r, c]) != 0:
                orbit_counts[(r, c)] = len(_orbit_positions((h, w), period, (r, c)))

    damaged_per_orbit = {orbit: 0 for orbit in orbit_counts}
    used = set()
    for cell in mandatory:
        damaged[cell] = 0
        orbit = (cell[0] % pr, cell[1] % pc)
        damaged_per_orbit[orbit] += 1
        used.add(cell)

    candidates = []
    for r in range(h):
        for c in range(w):
            if int(full[r, c]) == 0 or (r, c) in used:
                continue
            orbit = (r % pr, c % pc)
            if damaged_per_orbit[orbit] >= orbit_counts[orbit] - 1:
                continue
            candidates.append((r, c))
    random.shuffle(candidates)

    for r, c in candidates:
        if len(used) >= target:
            break
        orbit = (r % pr, c % pc)
        if damaged_per_orbit[orbit] >= orbit_counts[orbit] - 1:
            continue
        damaged[r, c] = 0
        damaged_per_orbit[orbit] += 1
        used.add((r, c))
    return damaged


def _semantic_checks(inp: np.ndarray, complete: np.ndarray, period: tuple[int, int], touched_hole: tuple[int, int], touched_solid: tuple[int, int]) -> bool:
    if _detect_period(inp) != period:
        return False
    repaired = _repair_grid(inp, period)
    if not np.array_equal(repaired, complete):
        return False

    hollow, solid = _classify_components(complete)
    if not hollow or not solid:
        return False

    if int(inp[touched_hole]) != 0 or int(inp[touched_solid]) != 0:
        return False

    hole_block_r = touched_hole[0] // period[0]
    hole_block_c = touched_hole[1] // period[1]
    solid_block_r = touched_solid[0] // period[0]
    solid_block_c = touched_solid[1] // period[1]
    r0 = hole_block_r * period[0]
    c0 = hole_block_c * period[1]
    rr0 = solid_block_r * period[0]
    cc0 = solid_block_c * period[1]
    raw_hole_tile = inp[r0 : r0 + period[0], c0 : c0 + period[1]]
    raw_solid_tile = inp[rr0 : rr0 + period[0], cc0 : cc0 + period[1]]

    raw_hollow, _ = _classify_components(raw_hole_tile)
    if raw_hollow:
        return False

    complete_solid_components = [comp for comp in _find_components(complete[rr0 : rr0 + period[0], cc0 : cc0 + period[1]]) if not _component_has_hole(complete[rr0 : rr0 + period[0], cc0 : cc0 + period[1]], comp)]
    raw_solid_components = _find_components(raw_solid_tile)
    if not complete_solid_components:
        return False
    if len(raw_solid_components) == len(complete_solid_components):
        same_sizes = sorted(len(comp["coords"]) for comp in raw_solid_components) == sorted(len(comp["coords"]) for comp in complete_solid_components)
        if same_sizes:
            return False

    expected = _recolor_by_topology(complete)
    actual = main(inp)
    return np.array_equal(expected, actual)


def generate_input() -> np.ndarray:
    for _ in range(500):
        tile = _instantiate_template()
        period = tuple(map(int, tile.shape))
        damage_plan = _choose_damage_plan(tile)
        if damage_plan is None:
            continue
        hole_local, solid_local = damage_plan

        nr = random.randint(3, 5)
        nc = random.randint(3, 5)
        complete = _tile_grid(tile, nr, nc)

        max_damage = int(0.3 * complete.size)
        non_black = int(np.count_nonzero(complete))
        if max_damage < 2 or non_black < 6:
            continue

        hole_copy = (random.randrange(nr), random.randrange(nc))
        solid_copy = (random.randrange(nr), random.randrange(nc))
        hole_cell = (hole_copy[0] * period[0] + hole_local[0], hole_copy[1] * period[1] + hole_local[1])
        solid_cell = (solid_copy[0] * period[0] + solid_local[0], solid_copy[1] * period[1] + solid_local[1])
        if hole_cell == solid_cell:
            continue

        target_damage = random.randint(2, min(max_damage, max(4, non_black // 6)))
        inp = _apply_damage(complete, period, [hole_cell, solid_cell], target_damage)
        if _semantic_checks(inp, complete, period, hole_cell, solid_cell):
            return inp

    raise RuntimeError("failed to generate a valid input")

