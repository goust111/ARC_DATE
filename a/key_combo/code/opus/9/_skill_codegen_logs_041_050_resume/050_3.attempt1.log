-    if not complete_solid_components:
-        return False
-    if len(raw_solid_components) == len(complete_solid_components):
-        same_sizes = sorted(len(comp["coords"]) for comp in raw_solid_components) == sorted(len(comp["coords"]) for comp in complete_solid_components)
-        if same_sizes:
-            return False
-
-    expected = _recolor_by_topology(complete)
-    actual = main(inp)
-    return np.array_equal(expected, actual)
-
-
-def generate_input() -> np.ndarray:
-    for _ in range(500):
-        tile = _instantiate_template()
-        period = tuple(map(int, tile.shape))
-        damage_plan = _choose_damage_plan(tile)
-        if damage_plan is None:
-            continue
-        hole_local, solid_local = damage_plan
-
-        nr = random.randint(3, 5)
-        nc = random.randint(3, 5)
-        complete = _tile_grid(tile, nr, nc)
-
-        max_damage = int(0.3 * complete.size)
-        non_black = int(np.count_nonzero(complete))
-        if max_damage < 2 or non_black < 6:
-            continue
-
-        hole_copy = (random.randrange(nr), random.randrange(nc))
-        solid_copy = (random.randrange(nr), random.randrange(nc))
-        hole_cell = (hole_copy[0] * period[0] + hole_local[0], hole_copy[1] * period[1] + hole_local[1])
-        solid_cell = (solid_copy[0] * period[0] + solid_local[0], solid_copy[1] * period[1] + solid_local[1])
-        if hole_cell == solid_cell:
-            continue
-
-        target_damage = random.randint(2, min(max_damage, max(4, non_black // 6)))
-        inp = _apply_damage(complete, period, [hole_cell, solid_cell], target_damage)
-        if _semantic_checks(inp, complete, period, hole_cell, solid_cell):
-            return inp
-
-    raise RuntimeError("failed to generate a valid input")

