    if num_rects == 4:
        hole_counts.append(random.choice((0, 1, 2)))
    colors = random.sample(list(RECT_COLORS), num_rects)
    patches = [_make_rectangle(colors[i], hole_counts[i]) for i in range(num_rects)]

    grid = np.full((h_grid, w_grid), BG, dtype=int)
    rect_specs = []

    pair_a = patches[0]
    pair_b = patches[1]
    pair_h = max(pair_a.shape[0], pair_b.shape[0])
    top_band = max(1, h_grid // 4)
    r_pair = random.randint(1, max(1, top_band))
    max_pair_width = pair_a.shape[1] + 1 + pair_b.shape[1]
    c_pair = random.randint(1, max(1, w_grid - max_pair_width - 2))
    _paste(grid, pair_a, r_pair, c_pair)
    rect_specs.append({"bbox": (r_pair, c_pair, r_pair + pair_a.shape[0] - 1, c_pair + pair_a.shape[1] - 1), "holes": hole_counts[0]})
    c_b = c_pair + pair_a.shape[1] + 1
    _paste(grid, pair_b, r_pair, c_b)
    rect_specs.append({"bbox": (r_pair, c_b, r_pair + pair_b.shape[0] - 1, c_b + pair_b.shape[1] - 1), "holes": hole_counts[1]})

    slots = [
        (h_grid // 2 + 1, 1, h_grid - 1, w_grid // 2 - 2),
        (h_grid // 2 + 1, w_grid // 2 + 1, h_grid - 1, w_grid - 1),
    ]
    if num_rects == 3:
        random.shuffle(slots)
        slots = slots[:1]

    for idx, patch in enumerate(patches[2:], start=2):
        placed = False
        slot_choices = slots[:] if num_rects == 4 else [
            (h_grid // 2, 1, h_grid - 1, w_grid - 2),
            (1, max(c_b + pair_b.shape[1] + 2, w_grid // 2), h_grid - 2, w_grid - 2),
            (h_grid // 2, max(c_b + 2, w_grid // 2), h_grid - 2, w_grid - 2),
        ]
        random.shuffle(slot_choices)
        for rmin, cmin, rmax, cmax in slot_choices:
            h, w = patch.shape
            r_lo = max(1, rmin)
            c_lo = max(1, cmin)
            r_hi = min(h_grid - h - 1, rmax - h)
            c_hi = min(w_grid - w - 1, cmax - w)
            if r_lo > r_hi or c_lo > c_hi:
                continue
            candidates = [(r, c) for r in range(r_lo, r_hi + 1) for c in range(c_lo, c_hi + 1)]
            random.shuffle(candidates)
            for r0, c0 in candidates:
                footprint = grid[max(0, r0 - 2) : min(h_grid, r0 + h + 2), max(0, c0 - 2) : min(w_grid, c0 + w + 2)]
                if np.any(footprint != BG):
                    continue
                _paste(grid, patch, r0, c0)
                rect_specs.append({"bbox": (r0, c0, r0 + h - 1, c0 + w - 1), "holes": hole_counts[idx]})
                placed = True
                break
            if placed:
                break
        if not placed:
            return None
    return grid, rect_specs


def _touches_rectangles(grid: np.ndarray, input_coords):
    touched = set()
    for r, c in input_coords:
        for nr, nc in _neighbors4(r, c):
            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and int(grid[nr, nc]) in RECT_COLORS:
                touched.add((nr, nc))
    return touched


def _enumerate_bar_candidates(grid: np.ndarray):
    rects, rect_holes, _bars, _info = _analyze_grid(grid, require_bars=False)
    rect_id_map = np.full(grid.shape, -1, dtype=int)
    for idx, rect in enumerate(rects):
        rect_id_map[rect["coords"][:, 0], rect["coords"][:, 1]] = idx

    candidates = []
    for length in BAR_LENGTHS:
        half = length // 2
        for orient in ("H", "V"):
            for r in range(half, grid.shape[0] - half):
                for c in range(half, grid.shape[1] - half):
                    input_coords = _line_coords(r, c, length, orient)
                    if any(int(grid[rr, cc]) != BG for rr, cc in input_coords):
                        continue
                    adjacent = set()
                    for rr, cc in input_coords:
                        for nr, nc in _neighbors4(rr, cc):
                            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
                                rect_id = int(rect_id_map[nr, nc])
                                if rect_id >= 0:
                                    adjacent.add(rect_id)
                    if not adjacent:
                        continue
                    hole_sum = sum(rect_holes[idx] for idx in adjacent)
                    out_coords = input_coords if hole_sum % 2 == 0 else _rotated_line_coords(r, c, length, orient)
                    if any(int(grid[rr, cc]) in RECT_COLORS for rr, cc in out_coords):
                        continue
                    input_set = set(input_coords)
                    out_set = set(out_coords)
                    candidates.append(
                        {
                            "input": input_set,
                            "output": out_set,
                            "adjacent": adjacent,
                            "hole_sum": hole_sum,
                            "rotates": bool(hole_sum % 2),
                            "center": (r, c),
                            "length": length,
                            "orient": orient,
                        }
                    )
    return candidates


def _sets_touch(a, b):
    if a & b:
        return True
    for r, c in a:
        for nr, nc in _neighbors4(r, c):
            if (nr, nc) in b:
                return True
    return False

