            continue
        odd = any(c['rotates'] for c in combo)
        even = any(not c['rotates'] for c in combo)
        multi = any(len(c['adjacent']) >= 2 for c in combo)
        even_nonzero = any((not c['rotates']) and c['hole_sum'] > 0 for c in combo)
        single = any(len(c['adjacent']) == 1 for c in combo)
        if odd and even and multi and even_nonzero and single:
            found_basic += 1
            both_orients = len({c['orient'] for c in combo}) >= 2
            same_orient_mixed = any(a['orient']==b['orient'] and a['rotates'] "'!= b['"'rotates'] for i,a in enumerate(combo) for b in combo[i+1:])
            if both_orients and same_orient_mixed:
                found_strict += 1
        if found_basic and found_strict:
            break
    print('holes', holes, 'basic', found_basic, 'strict', found_strict)
