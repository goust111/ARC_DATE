-                continue
-            q = deque([(r, c)])
-            seen[r, c] = True
-            cells = []
-            while q:
-                rr, cc = q.popleft()
-                cells.append((rr, cc))
-                for nr, nc in _neighbors4(rr, cc):
-                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
-                        seen[nr, nc] = True
-                        q.append((nr, nc))
-            coords = np.array(cells, dtype=int)
-            comps.append(
-                {
-                    "color": color,
-                    "coords": coords,
-                    "bbox": _bbox_from_coords(coords),
-                    "area": int(coords.shape[0]),
