-def main(grid: np.ndarray) -> np.ndarray:
-    """Rotate each magenta thin bar iff the total hole count of its 4-neighbor rectangles is odd.
-
-    Input structure:
-    - Black is background.
-    - Non-magenta foreground objects are colored axis-aligned rectangles with optional enclosed black holes.
-    - Magenta foreground objects are one-pixel-thick horizontal or vertical bars of odd length.
-
-    Rule:
-    - Identify every magenta bar and every colored rectangle.
-    - For each bar, collect all rectangles that are 4-neighbor adjacent to at least one bar pixel.
-    - Count each adjacent rectangle's enclosed black hole components and sum them.
-    - Keep the bar unchanged when the sum is even; rotate it 90 degrees around its center pixel when the sum is odd.
-    - Leave every rectangle, including its holes, unchanged.
-
-    Key insight:
-    - The bar's own shape does not determine the move; the decision comes from aggregating topological hole counts across neighboring rectangles.
-    """
-    g = np.asarray(grid, dtype=int)
-    rects, _rect_holes, bars, bar_info = _analyze_grid(g)
-
-    out = g.copy()
-    for bar in bars:
-        coords = bar["coords"]
-        out[coords[:, 0], coords[:, 1]] = BG
-
-    occupied = set()
-    rect_mask = np.zeros(g.shape, dtype=bool)
-    for rect in rects:
-        coords = rect["coords"]
-        rect_mask[coords[:, 0], coords[:, 1]] = True
-
-    for info in bar_info:
-        for r, c in info["out_coords"]:
-            if not (0 <= r < g.shape[0] and 0 <= c < g.shape[1]):
-                raise AssertionError("rotated bar left the grid")
-            if rect_mask[r, c]:
-                raise AssertionError("rotated bar overlaps a rectangle")
-            if (r, c) in occupied:
-                raise AssertionError("bars overlap after transformation")
-            occupied.add((r, c))
-            out[r, c] = BAR_COLOR
-    return out
-
-
-def _choose_holes(h: int, w: int, hole_count: int):
