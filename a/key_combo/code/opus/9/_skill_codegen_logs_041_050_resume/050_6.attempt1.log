-    if hole_count == 0:
-        return []
-    if hole_count == 1:
-        return [random.choice(interior)]
-    random.shuffle(interior)
-    for i, a in enumerate(interior):
-        for b in interior[i + 1 :]:
-            if abs(a[0] - b[0]) + abs(a[1] - b[1]) > 1:
-                return [a, b]
-    raise ValueError("cannot place two separated holes")
