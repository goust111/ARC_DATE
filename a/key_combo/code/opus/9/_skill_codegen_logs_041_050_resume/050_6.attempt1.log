import random
from collections import deque

import numpy as np


BG = 0
BAR_COLOR = 6
RECT_COLORS = (1, 3, 4, 7)
BAR_LENGTHS = (3, 5, 7)
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _neighbors4(r: int, c: int):
    for dr, dc in DIRS4:
