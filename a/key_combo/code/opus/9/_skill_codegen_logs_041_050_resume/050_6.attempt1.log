def _compatible_with_chosen(chosen, cand):
    for other in chosen:
        if _sets_touch(other["input"], cand["input"]):
            return False
        if other["output"] & cand["output"]:
            return False
    return True


def _select_bars(candidates):
    multi_even = [c for c in candidates if len(c["adjacent"]) >= 2 and not c["rotates"] and c["hole_sum"] > 0]
    odd_single = [c for c in candidates if c["rotates"] and len(c["adjacent"]) == 1]
    even_any = [c for c in candidates if not c["rotates"]]
    single_even_holey = [c for c in candidates if len(c["adjacent"]) == 1 and not c["rotates"] and c["hole_sum"] > 0]
    all_cands = candidates[:]
    random.shuffle(multi_even)
    random.shuffle(odd_single)
    random.shuffle(even_any)
    random.shuffle(single_even_holey)
    random.shuffle(all_cands)

    target_count = random.choice((3, 4))
    for first in multi_even:
        chosen = [first]
        second = next((c for c in odd_single if _compatible_with_chosen(chosen, c)), None)
        if second is None:
            continue
        chosen.append(second)

        preferred = single_even_holey + all_cands
        for cand in preferred:
            if cand in chosen or not _compatible_with_chosen(chosen, cand):
                continue
            chosen.append(cand)
            if len(chosen) == target_count:
                break

        if len(chosen) < 3:
            continue

        if len(chosen) < target_count:
            for cand in all_cands:
                if cand in chosen or not _compatible_with_chosen(chosen, cand):
                    continue
                chosen.append(cand)
                if len(chosen) == target_count:
                    break

        odd_count = sum(int(c["rotates"]) for c in chosen)
        even_count = len(chosen) - odd_count
        if odd_count >= 1 and even_count >= 1 and any(len(c["adjacent"]) >= 2 for c in chosen):
            return chosen
    return None


def _validate_instance(inp: np.ndarray):
    out = main(inp)
    rects, rect_holes, bars, bar_info = _analyze_grid(inp)
    if not (3 <= len(rects) <= 4):
        raise AssertionError("wrong rectangle count")
    if not (3 <= len(bars) <= 4):
        raise AssertionError("wrong bar count")
    if not any(info["rotates"] for info in bar_info):
        raise AssertionError("missing rotating bar")
    if not any(not info["rotates"] for info in bar_info):
        raise AssertionError("missing non-rotating bar")
    if not any(len(info["adjacent"]) >= 2 for info in bar_info):
        raise AssertionError("missing multi-rectangle bar")
    if not any((not info["rotates"]) and info["hole_sum"] > 0 for info in bar_info):
        raise AssertionError("missing even bar with nonzero hole sum")
    if any(not (0 <= holes <= 2) for holes in rect_holes):
        raise AssertionError("rectangle hole count out of range")
    for i, info_a in enumerate(bar_info):
        for info_b in bar_info[i + 1 :]:
            if _sets_touch(info_a["coords"], info_b["coords"]):
                raise AssertionError("input bars touch")
            if info_a["out_coords"] & info_b["out_coords"]:
                raise AssertionError("output bars overlap")
    if np.array_equal(inp, out):
        raise AssertionError("transformation is degenerate")
    return out


def _gen_attempt():
    layout = _build_layout()
    if layout is None:
        return None
    grid, _rect_specs = layout
    candidates = _enumerate_bar_candidates(grid)
    if not candidates:
        return None
    chosen = _select_bars(candidates)
    if chosen is None:
        return None
    inp = grid.copy()
    for cand in chosen:
        for r, c in cand["input"]:
            inp[r, c] = BAR_COLOR
    try:
        _validate_instance(inp)
    except AssertionError:
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(500):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid puzzle instance")

