import random
from collections import deque

import numpy as np


BG = 0
OBJECT_COUNT_CHOICES = (3, 4)
GRID_HEIGHT_RANGE = (12, 16)
GRID_WIDTH_RANGE = (13, 17)
AREA_VALUES = tuple(range(3, 16))
GEN_ATTEMPTS = 400
SHAPE_ATTEMPTS = 200
PLACEMENT_ATTEMPTS = 200


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def _normalize(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
    min_r = min(r for r, _ in cells)
    min_c = min(c for _, c in cells)
    return {(r - min_r, c - min_c) for r, c in cells}


def _bbox(cells: set[tuple[int, int]]) -> tuple[int, int]:
    max_r = max(r for r, _ in cells)
    max_c = max(c for _, c in cells)
    return max_r + 1, max_c + 1


def _find_components(grid: np.ndarray, blocked_mask: np.ndarray | None = None) -> list[dict]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    objects: list[dict] = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or grid[r, c] == BG:
                continue
            if blocked_mask is not None and blocked_mask[r, c]:
                continue
            color = int(grid[r, c])
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                cr, cc = q.popleft()
                coords.append((cr, cc))
                for nr, nc in _neighbors4(cr, cc):
                    if not (0 <= nr < h and 0 <= nc < w):
                        continue
                    if seen[nr, nc] or grid[nr, nc] != color:
                        continue
                    if blocked_mask is not None and blocked_mask[nr, nc]:
                        continue
                    seen[nr, nc] = True
                    q.append((nr, nc))
            arr = np.array(coords, dtype=int)
            objects.append(
                {
                    "color": color,
                    "coords": arr,
                    "area": int(arr.shape[0]),
                }
            )
    return objects


def _detect_legend(grid: np.ndarray) -> tuple[dict[int, int], np.ndarray, list[int], list[int]]:
    h, w = grid.shape
    assert h >= 3 and w >= 3
    c = w - 1
    while c >= 0 and grid[0, c] != BG and grid[1, c] != BG:
        c -= 1
    c0 = c + 1
    n = w - c0
    assert 3 <= n <= 5, "legend width must equal object count"
    legend = grid[0:2, c0:w]
    assert legend.shape == (2, n)
    assert np.all(legend != BG), "legend must be a full 2xN rectangle"
    if h > 2:
        assert np.all(grid[2, c0:w] == BG), "legend must be isolated from objects below"

    top = [int(v) for v in legend[0]]
    bottom = [int(v) for v in legend[1]]
    assert len(set(top)) == n
    assert len(set(bottom)) == n
    assert set(top).isdisjoint(bottom)

    mask = np.zeros_like(grid, dtype=bool)
    mask[0:2, c0:w] = True
    return dict(zip(top, bottom)), mask, top, bottom


def _ring_output(colors: list[int]) -> np.ndarray:
    side = 2 * len(colors) - 1
    out = np.full((side, side), int(colors[0]), dtype=int)
    for layer, color in enumerate(colors[1:], start=1):
        out[layer : side - layer, layer : side - layer] = int(color)
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Redraw scattered objects as concentric square rings whose order comes from area and whose colors come from a corner legend.

    Input structure:
    - A black background contains 3-5 monochromatic 4-connected foreground objects with distinct colors and distinct areas.
    - A strict 2xN legend sits in the top-right corner; its top row lists the object colors and its bottom row lists replacement colors.
    - The legend is not part of the sortable objects and the replacement colors do not appear on the objects themselves.

    Rule:
    - Identify the top-right 2xN legend and build an object-color -> output-color mapping column by column.
    - Excluding the legend, find all foreground objects and sort them by decreasing area.
    - Create a square output of side 2N-1 and draw concentric 1-cell-thick square rings from outside to inside using the mapped color of each object in that area order; the smallest object becomes the center pixel.

    Key insight:
    - Each object contributes two independent pieces of information: its area decides which ring it owns, while its visible color only serves as a key into the legend that decides the ring's final color.
    """
    g = np.asarray(grid, dtype=int)
    mapping, legend_mask, _legend_top, _legend_bottom = _detect_legend(g)
    objects = _find_components(g, blocked_mask=legend_mask)
    assert len(objects) == len(mapping), "legend and object counts must match"

    object_colors = {int(obj["color"]) for obj in objects}
    assert object_colors == set(mapping), "legend keys must match object colors"

    areas = [int(obj["area"]) for obj in objects]
    assert len(set(areas)) == len(areas), "object areas must be unique"

    ordered = sorted(objects, key=lambda obj: int(obj["area"]), reverse=True)
    colors = [int(mapping[int(obj["color"])]) for obj in ordered]
    return _ring_output(colors)


def _grow_shape(area: int, rng: random.Random) -> set[tuple[int, int]]:
    for _ in range(SHAPE_ATTEMPTS):
        cells = {(0, 0)}
        while len(cells) < area:
            frontier = []
            for r, c in cells:
                for nr, nc in _neighbors4(r, c):
                    if (nr, nc) not in cells:
                        frontier.append((nr, nc))
            rng.shuffle(frontier)
            cells.add(frontier[0])
        cells = _normalize(cells)
        h, w = _bbox(cells)
        if h > 6 or w > 6:
            continue
        if h == 1 or w == 1:
            continue
        bbox_area = h * w
        if area == bbox_area and min(h, w) >= 2:
            continue
        if h == 2 and w == 2 and area == 3:
            return cells
        perimeter_like = sum(
            1
            for r, c in cells
            if sum((nr, nc) in cells for nr, nc in _neighbors4(r, c)) <= 2
        )
        if perimeter_like < max(2, area // 3):
            continue
        return cells
    raise RuntimeError(f"failed to grow shape of area {area}")


def _place_objects(
    height: int,
    width: int,
    shapes: list[set[tuple[int, int]]],
    colors: list[int],
    legend_start_col: int,
    rng: random.Random,
) -> np.ndarray | None:
    grid = np.zeros((height, width), dtype=int)
    blocked = np.zeros((height, width), dtype=bool)

    reserved_r0 = 0
    reserved_r1 = min(height - 1, 2)
    reserved_c0 = max(0, legend_start_col - 1)
    blocked[reserved_r0 : reserved_r1 + 1, reserved_c0:width] = True

    order = sorted(range(len(shapes)), key=lambda i: len(shapes[i]), reverse=True)
    for idx in order:
        shape = shapes[idx]
        color = int(colors[idx])
        shape_h, shape_w = _bbox(shape)
        placed = False
        for _ in range(PLACEMENT_ATTEMPTS):
            r0 = rng.randint(3, height - shape_h)
            c0 = rng.randint(0, width - shape_w)
            coords = [(r0 + r, c0 + c) for r, c in shape]
            if any(blocked[r, c] for r, c in coords):
                continue
            for r, c in coords:
                grid[r, c] = color
            for r, c in coords:
                for rr in range(r - 1, r + 2):
                    for cc in range(c - 1, c + 2):
                        if 0 <= rr < height and 0 <= cc < width:
                            blocked[rr, cc] = True
            placed = True
            break
        if not placed:
            return None
    return grid


def _validate_example(grid: np.ndarray) -> None:
    mapping, legend_mask, legend_top, legend_bottom = _detect_legend(grid)
    objects = _find_components(grid, blocked_mask=legend_mask)
    assert len(objects) == len(mapping)
    assert {int(obj["color"]) for obj in objects} == set(mapping)

    areas = [int(obj["area"]) for obj in objects]
    assert len(set(areas)) == len(areas)
    assert set(legend_top) == {int(obj["color"]) for obj in objects}
    assert set(legend_bottom).isdisjoint(legend_top)

    ordered = sorted(objects, key=lambda obj: int(obj["area"]), reverse=True)
    correct_sequence = [int(mapping[int(obj["color"])]) for obj in ordered]
    assert len(set(correct_sequence)) == len(correct_sequence)

    original_sequence = [int(obj["color"]) for obj in ordered]
    assert correct_sequence != original_sequence, "mapping must affect the output"

    by_legend_key = [int(mapping[c]) for c in legend_top]
    assert correct_sequence != by_legend_key, "area ordering must affect the output"
    assert correct_sequence != legend_bottom, "legend value order alone must not solve the task"

    out = main(grid)
    assert out.shape == (2 * len(objects) - 1, 2 * len(objects) - 1)
    assert np.array_equal(out, _ring_output(correct_sequence))


