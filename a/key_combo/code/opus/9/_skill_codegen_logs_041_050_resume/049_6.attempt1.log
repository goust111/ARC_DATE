from __future__ import annotations

from itertools import combinations
import hashlib

import numpy as np


BACKGROUND = 0
CROSS_COLOR = 4
INPUT_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
MIN_SEGMENT_LEN = 3
MAX_SEGMENT_LEN = 5
MIN_OBJECTS = 2
MAX_OBJECTS = 4
MIN_GRID_SIZE = 13
MAX_GRID_SIZE = 17
MAX_ATTEMPTS = 800

_SEEN_INPUT_SIGS: set[str] = set()
