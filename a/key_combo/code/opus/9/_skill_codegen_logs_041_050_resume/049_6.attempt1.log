134:def _gen_choose_cavity_dims(rng: np.random.Generator, rows: int, cols: int, count: int) -> list[tuple[int, int]] | None:
135:    area = rows * cols
136:    min_area = _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area)
137:    max_area = _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area)
138:    max_h = rows - 2 * _GEN_BORDER_WALL_THICKNESS
139:    max_w = cols - 2 * _GEN_BORDER_WALL_THICKNESS
140:    options = [(h, w) for h, w in _GEN_CAVITY_DIMS if h <= max_h and w <= max_w]
141:    combos: list[tuple[tuple[int, int], ...]] = []
142:
143:    def rec(start: list[tuple[int, int]], area: int) -> None:
144:        if len(start) == count:
145:            if min_area <= area <= max_area:
146:                combos.append(tuple(start))
147:            return
148:        remaining = count - len(start)
149:        if area + remaining * _GEN_MIN_CAVITY_AREA > max_area:
150:            return
151:        if area + remaining * _GEN_MAX_CAVITY_AREA < min_area:
152:            return
153:        order = rng.permutation(len(options))
154:        for idx in order:
155:            h, w = options[int(idx)]
156:            rec(start + [(h, w)], area + h * w)
157:
158:    rec([], 0)
159:    if not combos:
160:        return None
161:    weights = np.array([(sum(w for _, w in combo) / count) ** _GEN_CAVITY_WIDTH_WEIGHT_POWER for combo in combos], dtype=float)
162:    weights /= weights.sum()
163:    return list(combos[int(rng.choice(len(combos), p=weights))])
