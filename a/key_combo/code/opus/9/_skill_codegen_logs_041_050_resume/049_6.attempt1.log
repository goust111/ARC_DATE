115:def _gen_factor_options(length: int, lo: int, hi: int) -> list[int]:
116:    rep_min, rep_max = _GEN_REPS_PER_AXIS_RANGE
117:    return [d for d in range(lo, hi + 1) if length % d == 0 and rep_min <= length // d <= rep_max]
