148:        return sprite
149:
150:    random.shuffle(coords)
151:    split = random.randint(1, len(coords) - 1)
152:    first = np.array(coords[:split], dtype=int)
153:    second = np.array(coords[split:], dtype=int)
154:    sprite[first[:, 0], first[:, 1]] = cols[0]
155:    sprite[second[:, 0], second[:, 1]] = cols[1]
156:    return sprite
