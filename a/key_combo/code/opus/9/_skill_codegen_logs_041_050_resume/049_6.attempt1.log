spec:
  grid: 6x6 [observed]
  background: single color filling the canvas (always BLACK [observed])
  bars:
    count: exactly 2 foreground colors, each forming one contiguous 1-cell-thick bar segment
    h_bar: horizontal, length 2 [observed], anchored to left or right grid edge [observed]
    v_bar: vertical, length 2 [observed], anchored to top grid edge [observed]
    colors: one bar uses RED (2), the other AZURE (8) [observed]; h_bar is RED, v_bar is AZURE [observed]
    no_overlap: the h_bar row must not be in the v_bar row range, and the v_bar col must not be in the h_bar col range
    crossing_cell: cell at (h_row, v_col) is background in input
  output:
    extend: h_bar color fills its entire row; v_bar color fills its entire column
    crossing: the single cell where extended row and column intersect is recolored YELLOW (4)
    rest: all other cells unchanged

generation_strategy:
  approach: direct construction (task is simple enough)
  steps:
    1. Pick grid size (6x6 observed; vary to 5-8 for diversity).
    2. Pick background color, h_color, v_color (3 distinct non-YELLOW colors).
    3. Pick v_col in [0, W-1] and h_row in [0, H-1] for the crossing point.
    4. Place v_bar as 2 contiguous cells in v_col anchored to top edge (rows 0-1).
       Ensure h_row >= 2 so bars don't overlap vertically.
    5. Place h_bar as 2 contiguous cells in h_row anchored to left or right edge.
       Ensure v_col is outside h_bar's col range so bars don't overlap horizontally.
    6. Fill rest with background. Verify crossing cell (h_row, v_col) is background.
