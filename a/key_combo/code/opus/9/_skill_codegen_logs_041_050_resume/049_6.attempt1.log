190:def _gen_tile_specs(rng: np.random.Generator, cavity_h: int, cavity_w: int) -> tuple[int, int, int] | None:
191:    groups: dict[int, list[tuple[int, int, int]]] = {}
192:    for tile_h in _gen_factor_options(cavity_h, *_GEN_TILE_HEIGHT_RANGE):
193:        for tile_w in _gen_factor_options(cavity_w, *_GEN_TILE_WIDTH_RANGE):
194:            area = tile_h * tile_w
195:            min_pixels = _gen_ceil_percent(_GEN_TILE_DENSITY_PCT_RANGE[0], area)
196:            max_pixels = _gen_floor_percent(_GEN_TILE_DENSITY_PCT_RANGE[1], area)
197:            for count in range(min_pixels, max_pixels + 1):
198:                density_key = int(round(_GEN_PERCENT_DENOM * count / area))
199:                groups.setdefault(density_key, []).append((tile_h, tile_w, count))
200:    if not groups:
201:        return None
202:    density_key = list(groups)[int(rng.integers(0, len(groups)))]
203:    choices = groups[density_key]
204:    return choices[int(rng.integers(0, len(choices)))]
