125:def _gen_cd3c21df_color_sets(palette: list[int]) -> list[tuple[int, ...]]:
126:    colors = palette[:]
127:    random.shuffle(colors)
128:    sets = [{colors[i]} for i in range(BASE_SPRITE_COUNT)]
129:    for color in colors[BASE_SPRITE_COUNT:]:
130:        choices = [i for i, s in enumerate(sets) if len(s) < MAX_COLORS_PER_SPRITE]
131:        sets[random.choice(choices)].add(color)
132:    for s in sets:
133:        if len(s) < MAX_COLORS_PER_SPRITE and random.random() < EXTRA_COLOR_PROB:
134:            choices = [color for color in palette if color not in s]
135:            if choices:
136:                s.add(random.choice(choices))
137:    random.shuffle(sets)
138:    return [tuple(sorted(s)) for s in sets]
