8:def main(grid: np.ndarray) -> np.ndarray:
9:    """
10:    Extend each colored marker rightward to the grid edge, then downward on the right edge until the next marker row.
11:
12:    Input structure
13:    - The grid is a non-empty rectangle with a dominant background color.
14:    - Every foreground cell is a single colored marker pixel.
15:    - Each active row contains exactly one marker.
16:
17:    Rule
18:    - Sort the marker pixels from top to bottom.
19:    - For each marker, paint its row from the marker column through the right edge with the marker color.
20:    - Then paint the rightmost column from that marker row down to one row before the next lower marker, or to the bottom for the last marker.
21:
22:    Key insight
23:    - The markers are row-start controls for right-turning paths, and the next marker below is the stopping boundary for the vertical edge segment.
24:    """
25:    g = np.asarray(grid, dtype=int)
26:    assert g.ndim == 2, "expected a 2D grid"
27:    H, W = g.shape
28:    assert H > 0 and W > 0, "expected a non-empty grid"
29:
30:    bg = int(get_bg(g))
31:    marker_coords = np.argwhere(g != bg)
32:    assert len(marker_coords) > 0, "expected at least one marker pixel"
33:
34:    markers = [(int(r), int(c), int(g[r, c])) for r, c in marker_coords]
35:    marker_rows = [r for r, _c, _color in markers]
36:    assert len(marker_rows) == len(set(marker_rows)), "expected exactly one marker per active row"
37:    markers.sort(key=lambda marker: marker[0])
38:
39:    out = g.copy()
40:    for i, (r, c, color) in enumerate(markers):
41:        end_r = markers[i + 1][0] if i + 1 < len(markers) else H
42:        assert r < end_r <= H, "marker rows must be strictly increasing"
43:
44:        out[r, c:W] = color
45:        out[r:end_r, W - 1] = color
46:
47:    return out
