229:    rows, cols = grid_dims
230:
231:    dims = _gen_choose_cavity_dims(rng, rows, cols, count)
232:    if dims is None:
233:        return None
234:    rects = _gen_place_cavities(rng, rows, cols, dims)
235:    if rects is None:
