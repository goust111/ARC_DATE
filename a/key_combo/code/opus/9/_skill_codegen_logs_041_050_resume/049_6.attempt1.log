22:def main(grid: np.ndarray) -> np.ndarray:
23:    """
24:    Replace each teal macro-cell in the upper-right pattern with the teal mask from the left control sprite.
25:
26:    Input structure:
27:    - The black background contains three 4-connected foreground components.
28:    - A left control sprite is a full rectangle of red and teal pixels.
29:    - An upper-right pattern is a full rectangle of the main color and teal pixels, arranged as uniform macro-cells.
30:    - A lower solid rectangle of the main color gives the final output size.
31:
32:    Rule:
33:    - Compress the upper-right pattern into macro-cells, using the lower rectangle size divided by the control
34:      sprite size to determine the compressed pattern dimensions.
35:    - Make an output filled with the main color.
36:    - For each teal macro-cell, paste the control sprite's teal mask into the corresponding output block, turning
37:      the control sprite's red pixels into the main color.
38:
39:    Key insight:
40:    - The upper-right object is not copied directly; it is a coarse stencil whose teal cells are substituted by
41:      the entire teal mask from the separate red/teal control sprite.
42:    """
43:    g = np.asarray(grid, dtype=int)
44:    assert g.ndim == 2, "expected a 2D grid"
45:
46:    bg = _border_bg(g)
47:    colors = set(map(int, np.unique(g)))
48:    main_colors = colors - {bg, Color.RED, Color.TEAL}
49:    assert len(main_colors) == 1, f"expected one varying main color, got {main_colors}"
50:    main = next(iter(main_colors))
51:
52:    raw_components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
53:    components = []
54:    for comp in raw_components:
55:        coords = comp["coords"]
56:        comp_colors = set(map(int, np.unique(g[coords[:, 0], coords[:, 1]])))
57:        components.append((comp_colors, comp["bbox"]))
