163:def _gen_cd3c21df_locations(reserved: np.ndarray, sprite_shape: tuple[int, int]) -> list[tuple[int, int]]:
164:    h, w = sprite_shape
165:    H, W = reserved.shape
166:    locs: list[tuple[int, int]] = []
167:    for r in range(H - h + 1):
168:        for c in range(W - w + 1):
169:            r0 = max(0, r - PLACEMENT_PADDING)
170:            c0 = max(0, c - PLACEMENT_PADDING)
171:            r1 = min(H, r + h + PLACEMENT_PADDING)
172:            c1 = min(W, c + w + PLACEMENT_PADDING)
173:            if not bool(reserved[r0:r1, c0:c1].any()):
174:                locs.append((r, c))
175:    random.shuffle(locs)
176:    if random.random() < INTERIOR_PLACEMENT_FIRST_PROB:
177:        locs.sort(key=lambda rc: 0 if 0 < rc[0] and 0 < rc[1] and rc[0] + h < H and rc[1] + w < W else 1)
178:    return locs
