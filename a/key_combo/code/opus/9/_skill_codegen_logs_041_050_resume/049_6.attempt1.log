109:def _gen_floor_percent(percent: int, value: int) -> int: return (percent * value) // _GEN_PERCENT_DENOM
110:
111:
112:def _gen_ceil_percent(percent: int, value: int) -> int: return (percent * value + _GEN_PERCENT_DENOM - 1) // _GEN_PERCENT_DENOM
