8:def main(grid: np.ndarray) -> np.ndarray:
9:    """
10:    Move bordered containers toward same-colored destination markers, charging gray cells to orange.
11:
12:    Input structure:
13:    - bg = 6 (magenta). Black-bordered (0) rectangles with gray (5) / orange (7) interiors.
14:    - A head sprite (9) sits adjacent to one container edge; a matching destination sprite lies along the movement axis.
15:
16:    Rule:
17:    - Each container translates toward its destination along the head-to-dest axis.
18:    - Steps = min(head-to-dest distance, number of gray interior cells).
19:    - Gray cells become orange from the head-facing side inward, one per step.
20:
21:    Key insight: Gray cell count caps movement — a container stops short if it runs out of gray cells to charge.
22:    """
23:    g = np.array(grid, dtype=int)
24:    H, W = g.shape
25:
26:    BORDER = 0
27:    GREY = 5
28:    FILL = 7
29:    DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
30:
31:    # True background is dominant non-border color (border can dominate in some cases).
32:    cnt = Counter(map(int, g.flatten()))
33:    bg = int(max((c for c in cnt.keys() if int(c) != int(BORDER)), key=lambda c: int(cnt[int(c)])))
34:
35:    def rect_border_coords(r0: int, c0: int, r1: int, c1: int):
36:        for c in range(c0, c1 + 1):
37:            yield (r0, c)
38:            yield (r1, c)
39:        for r in range(r0 + 1, r1):
40:            yield (r, c0)
41:            yield (r, c1)
42:
43:    # --- detect containers as rectangles enclosing GREY/FILL with BORDER frame ---
44:    containers = []
45:    for pts in components_mask((g == GREY) | (g == FILL), connectivity=4):
46:        if pts.size == 0:
47:            continue
48:        ir0, ic0, ir1, ic1 = bbox_coords(pts)
49:        r0, c0, r1, c1 = int(ir0 - 1), int(ic0 - 1), int(ir1 + 1), int(ic1 + 1)
50:        if r0 < 0 or c0 < 0 or r1 >= H or c1 >= W:
51:            continue
52:        if any(int(g[r, c]) != BORDER for r, c in rect_border_coords(r0, c0, r1, c1)):
53:            continue
54:        inner = g[r0 + 1 : r1, c0 + 1 : c1]
55:        if inner.size == 0 or not bool(np.isin(inner, [GREY, FILL]).all()):
56:            continue
57:        containers.append({"box": (r0, c0, r1, c1)})
58:
59:    assert not (not containers)
60:
61:    # head + destination are in some non-bg, non-border color (not GREY/FILL)
62:    out = g.copy()
63:
64:    all_head_colors = [c for c in colors_present(g, exclude={bg, BORDER, GREY, FILL})]
65:
66:    # Precompute components for each head color.
67:    comp_by_color: dict[int, list[dict]] = defaultdict(list)
68:    for col in all_head_colors:
69:        labc, nc = label(g == int(col), structure=STRUCT4)
70:        for k in range(1, int(nc) + 1):
71:            coords = np.argwhere(labc == int(k))
72:            if coords.size == 0:
73:                continue
74:            r0, c0, r1, c1 = bbox_coords(coords)
75:            pts = {(int(r), int(c)) for r, c in coords}
76:            shape = {(int(r - r0), int(c - c0)) for r, c in pts}
77:            comp_by_color[int(col)].append({"pts": pts, "shape": shape, "tl": (int(r0), int(c0))})
78:
79:    def pick_head_for_container(box_):
80:        r0, c0, r1, c1 = box_
81:        head_seeds = []
82:        for r, c in rect_border_coords(r0, c0, r1, c1):
83:            for dr, dc in DIR4:
84:                rr, cc = r + dr, c + dc
85:                if 0 <= rr < H and 0 <= cc < W:
86:                    val = int(g[rr, cc])
87:                    if val not in (int(bg), int(BORDER), int(GREY), int(FILL)):
88:                        head_seeds.append((rr, cc, val))
89:        if not head_seeds:
90:            return None
91:
92:        hc = int(Counter(val for _r, _c, val in head_seeds).most_common(1)[0][0])
93:        seed_pts = {(r, c) for r, c, val in head_seeds if int(val) == int(hc)}
94:        cands = comp_by_color.get(hc, [])
95:        comp0 = None
96:        for comp in cands:
97:            if comp["pts"] & seed_pts:
98:                comp0 = comp
99:                break
100:        if comp0 is None:
101:            return None
102:
103:        # Split head vs destination even if same-color pixels touch:
104:        # head pixels are those with minimal manhattan distance to this container border.
105:        border_pts = list(rect_border_coords(r0, c0, r1, c1))
106:        best_d = None
107:        dist = {}
108:        for pr, pc in comp0["pts"]:
109:            d = min(abs(int(pr - br)) + abs(int(pc - bc)) for br, bc in border_pts)
110:            dist[(int(pr), int(pc))] = int(d)
111:            if best_d is None or d < best_d:
