120:def _gen_choose_grid(rng: np.random.Generator, count: int) -> tuple[int, int] | None:
121:    choices = []
122:    min_cavity_area = _GEN_MIN_CAVITY_AREA * count
123:    max_cavity_area = _GEN_MAX_CAVITY_AREA * count
124:    for rows in _GEN_GRID_ROWS:
125:        for cols in _GEN_GRID_COLS:
126:            area = rows * cols
127:            if min_cavity_area <= _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area) and max_cavity_area >= _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area):
128:                choices.append((rows, cols))
129:    if not choices:
130:        return None
131:    return choices[int(rng.integers(0, len(choices)))]
