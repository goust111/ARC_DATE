10:def main(grid: np.ndarray) -> np.ndarray:
11:    """
12:    Crop the 4-connected foreground sprite whose colored pattern occurs only once among otherwise duplicated sprites.
13:
14:    Input structure
15:    - The background is the dominant color.
16:    - Foreground pixels form several separated 4-connected sprites.
17:    - Every distractor sprite has an identical colored bounding-box crop elsewhere in the grid.
18:
19:    Rule
20:    - Crop each 4-connected foreground sprite to its bounding box.
21:    - Compare the exact colored crops, including background pixels inside each crop.
22:    - Return the only crop whose exact pattern occurs once.
23:
24:    Key insight
25:    - The answer is the outlier sprite by repetition count, not by position, color id, or size alone.
26:    """
27:    g = np.asarray(grid, dtype=int)
28:    bg = get_bg(g)
29:    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)
30:
31:    assert len(objects) >= 2
32:
33:    crops: list[tuple[tuple[tuple[int, ...], ...], np.ndarray]] = []
34:    for obj in objects:
35:        crop = crop_bbox(g, obj["bbox"])
36:        assert int(np.sum(crop != bg)) == int(obj["area"])
37:        signature = tuple(tuple(map(int, row)) for row in crop)
38:        crops.append((signature, crop))
39:
40:    counts = Counter(signature for signature, _ in crops)
41:    assert len(counts) >= 2
42:    assert any(n > 1 for n in counts.values())
43:
44:    unique_signatures = [signature for signature, n in counts.items() if n == 1]
45:    assert len(unique_signatures) == 1
46:
47:    matches = [crop for signature, crop in crops if signature == unique_signatures[0]]
48:    assert len(matches) == 1
49:    return matches[0].copy()
