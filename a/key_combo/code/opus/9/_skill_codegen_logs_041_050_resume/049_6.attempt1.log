166:def _gen_rect_is_clear(rect: tuple[int, int, int, int], placed: list[tuple[int, int, int, int]]) -> bool:
167:    r0, c0, r1, c1 = rect
168:    for pr0, pc0, pr1, pc1 in placed:
169:        separated = r1 + _GEN_CAVITY_START_GAP <= pr0 or pr1 + _GEN_CAVITY_START_GAP <= r0 or c1 + _GEN_CAVITY_START_GAP <= pc0 or pc1 + _GEN_CAVITY_START_GAP <= c0
170:        if not separated:
171:            return False
172:    return True
