120:        if hc1 < c0:
121:            direction = (0, -1)
122:        elif hc0 > c1:
123:            direction = (0, 1)
124:        elif hr1 < r0:
125:            direction = (-1, 0)
126:        elif hr0 > r1:
127:            direction = (1, 0)
128:        else:
129:            direction = (0, 0)
130:
131:        # normalized head shape + top-left
132:        r00, c00 = int(hr0), int(hc0)
133:        head_shape = {(int(r - r00), int(c - c00)) for r, c in head_pts}
134:        return {
135:            "color": hc,
136:            "head_pts": head_pts,
137:            "head_shape": head_shape,
138:            "head_tl": (r00, c00),
139:            "comp_pts": set(comp0["pts"]),
140:            "dir": direction,
141:        }
142:
143:    for cont in containers:
144:        box_ = cont["box"]
145:        r0, c0, r1, c1 = box_
146:
147:        head_info = pick_head_for_container(box_)
148:        if head_info is None:
149:            continue
150:        hc = int(head_info["color"])
151:        head_pts = set(head_info["head_pts"])
152:        head_shape = head_info["head_shape"]
153:        head_tl = head_info["head_tl"]
154:        comp_pts = set(head_info["comp_pts"])
155:        direction = head_info["dir"]
156:        if direction == (0, 0):
157:            continue
158:
159:        # destination candidates
160:        dests = []
161:        for d in comp_by_color.get(hc, []):
162:            if d["shape"] != head_shape:
163:                continue
164:            if d["pts"] == comp_pts:
165:                continue
166:            dests.append(d)
167:
168:        # add split-from-same-component destinations (when dest touches head by color)
169:        rem = comp_pts - head_pts
170:        if rem:
171:            mask_rem = np.zeros((H, W), dtype=bool)
172:            for rr, cc in rem:
173:                mask_rem[int(rr), int(cc)] = True
174:            labr, nr = label(mask_rem, structure=STRUCT4)
175:            for k in range(1, int(nr) + 1):
176:                pts = {(int(r), int(c)) for r, c in np.argwhere(labr == int(k))}
177:                if not pts:
178:                    continue
179:                # reject if adjacent to BORDER
180:                adj = False
181:                for r, c in pts:
182:                    for dr, dc in DIR4:
183:                        rr, cc = int(r + dr), int(c + dc)
184:                        if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) == int(BORDER):
185:                            adj = True
186:                            break
187:                    if adj:
188:                        break
189:                if adj:
190:                    continue
191:                rs = [r for r, _c in pts]
192:                cs = [c for _r, c in pts]
193:                r00, c00 = int(min(rs)), int(min(cs))
194:                shp = {(int(r - r00), int(c - c00)) for r, c in pts}
195:                if shp != head_shape:
196:                    continue
197:                dests.append({"pts": pts, "shape": shp, "tl": (r00, c00)})
198:
199:        if not dests:
200:            continue
201:
202:        best = None
203:        best_dest = None
204:        for d in dests:
205:            tr0 = int(d["tl"][0] - head_tl[0])
206:            tc0 = int(d["tl"][1] - head_tl[1])
207:            if direction[0] != 0 and tc0 != 0:
208:                continue
209:            if direction[1] != 0 and tr0 != 0:
210:                continue
211:            if direction[0] == 1 and tr0 <= 0:
212:                continue
213:            if direction[0] == -1 and tr0 >= 0:
214:                continue
215:            if direction[1] == 1 and tc0 <= 0:
216:                continue
217:            if direction[1] == -1 and tc0 >= 0:
