207:def _gen_tile(rng: np.random.Generator, tile_h: int, tile_w: int, color: int, count: int) -> np.ndarray:
208:    if rng.integers(0, 2) == 0:
209:        required = {(0, 0), (tile_h - 1, tile_w - 1)}
210:    else:
211:        required = {(0, tile_w - 1), (tile_h - 1, 0)}
212:    coords = [(r, c) for r in range(tile_h) for c in range(tile_w) if (r, c) not in required]
213:    extra = count - len(required)
214:    if extra > 0:
215:        chosen = rng.choice(len(coords), size=extra, replace=False)
216:        required.update(coords[int(i)] for i in np.atleast_1d(chosen))
217:
218:    tile = np.full((tile_h, tile_w), _GEN_EMPTY, dtype=int)
219:    for r, c in required:
220:        tile[r, c] = color
221:    return tile
