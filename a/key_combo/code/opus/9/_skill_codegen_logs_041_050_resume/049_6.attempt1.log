141:def _gen_cd3c21df_colorize(mask: np.ndarray, colors: tuple[int, ...]) -> np.ndarray:
142:    sprite = np.zeros(mask.shape, dtype=int)
143:    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
144:    cols = list(colors)
145:    random.shuffle(cols)
146:    if len(cols) == 1:
