175:def _gen_place_cavities(rng: np.random.Generator, rows: int, cols: int, dims: list[tuple[int, int]]) -> list[tuple[int, int, int, int]] | None:
176:    placed: list[tuple[int, int, int, int]] = []
177:    for h, w in sorted(dims, key=lambda x: x[0] * x[1], reverse=True):
178:        positions: list[tuple[int, int, int, int]] = []
179:        for r0 in range(_GEN_BORDER_WALL_THICKNESS, rows - h - _GEN_BORDER_WALL_THICKNESS + 1):
180:            for c0 in range(_GEN_BORDER_WALL_THICKNESS, cols - w - _GEN_BORDER_WALL_THICKNESS + 1):
181:                rect = (r0, c0, r0 + h - 1, c0 + w - 1)
182:                if _gen_rect_is_clear(rect, placed):
183:                    positions.append(rect)
184:        if not positions:
185:            return None
186:        placed.append(positions[int(rng.integers(0, len(positions)))])
187:    return placed
