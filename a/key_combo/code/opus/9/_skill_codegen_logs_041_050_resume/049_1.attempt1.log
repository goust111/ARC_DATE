        for a in range(max(lo, base), hi + 1)
        if (a - base) % MIRROR_ORBIT_PAIR_WEIGHT == 0
    ]
    if not targets:
        return None

    target = random.choice(targets)
    if not _gen_grow_half(half, w, target):
