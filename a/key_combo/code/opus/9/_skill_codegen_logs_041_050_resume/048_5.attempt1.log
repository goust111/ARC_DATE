    """Build one full skeleton+anchor+marker patch before dihedral expansion."""
    skeleton_size = random.randint(*_GEN_SKELETON_SIZE_RANGE)
    skeleton = set(random.choice(_gen_skeleton_pool(skeleton_size)))

