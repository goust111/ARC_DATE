CUE_BOARD_DIST = 4               # min Chebyshev distance from cue bbox to board bbox
CUE_INTER_DIST = 4               # min Chebyshev distance between cue bboxes
OUTER_AREA_PAD = 4               # outer min_area = mid_area + this

