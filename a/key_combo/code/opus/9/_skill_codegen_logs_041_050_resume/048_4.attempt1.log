+        norm = {(r - r0, c - c0) for r, c in cells}
+        h = max(r for r, _ in norm) + 1
+        w = max(c for _, c in norm) + 1
+        if h > max_side or w > max_side:
+            continue
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in norm:
+            mask[r, c] = True
+        key = (mask.shape, mask.tobytes())
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(mask)
