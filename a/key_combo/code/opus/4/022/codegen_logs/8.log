+    - Extract the black holes inside the grey frame and the palette row below the frame.
+    - Match every outside piece to exactly one hole by exact shape under the 8 dihedral transforms.
+    - Rank the holes by area from smallest to largest, read palette colors from left to right, and assign the k-th palette color to the k-th smallest hole.
+    - Return only the frame crop, keeping grey cells unchanged and filling each hole with its assigned palette color.
+
+    Key insight:
+    - Piece colors only identify the movable shapes; the output colors come exclusively from area ordering of the frame holes and the external palette row.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    _frame_comp, frame_bbox = _find_frame(g)
+    fr0, fc0, fr1, fc1 = frame_bbox
+    frame_crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1].copy()
+    holes = _extract_holes(frame_crop)
+    comps = _outside_components(g, frame_bbox)
+    palette_row, palette_colors, palette_comps = _extract_palette(comps, frame_bbox, len(holes))
+    assert palette_row > fr1, "palette must be below the frame"
+    pieces = _extract_pieces(comps, palette_comps)
+    _match_pieces_to_holes(pieces, holes)
+    return _fill_holes(frame_crop, holes, palette_colors)
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[:-1, :] |= mask[1:, :]
+    out[1:, :] |= mask[:-1, :]
+    out[:, :-1] |= mask[:, 1:]
+    out[:, 1:] |= mask[:, :-1]
+    out[:-1, :-1] |= mask[1:, 1:]
+    out[:-1, 1:] |= mask[1:, :-1]
+    out[1:, :-1] |= mask[:-1, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
+    return out
+
+
+def _random_connected_shape(area: int) -> np.ndarray:
+    assert 4 <= area <= 12
+    for _ in range(300):
+        cells = {(0, 0)}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) in cells:
+                        continue
+                    trial = cells | {(nr, nc)}
+                    rs = [pt[0] for pt in trial]
+                    cs = [pt[1] for pt in trial]
+                    if max(rs) - min(rs) + 1 <= 5 and max(cs) - min(cs) + 1 <= 5:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != area:
+            continue
+        rs = [pt[0] for pt in cells]
+        cs = [pt[1] for pt in cells]
+        r0, c0 = min(rs), min(cs)
+        norm = sorted((r - r0, c - c0) for r, c in cells)
+        h = max(r for r, _ in norm) + 1
+        w = max(c for _, c in norm) + 1
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in norm:
+            mask[r, c] = True
+        if h == 1 or w == 1:
+            continue
+        if mask.sum() == h * w and area not in (6, 8, 10, 12):
+            continue
+        return mask
+    raise RuntimeError(f"failed to create shape of area {area}")
+
+
+def _place_masks_on_interior(shapes: list[np.ndarray], interior_h: int, interior_w: int) -> list[tuple[np.ndarray, int, int]] | None:
+    placements: list[tuple[np.ndarray, int, int]] = []
+    forbidden = np.zeros((interior_h, interior_w), dtype=bool)
+    for base in shapes:
+        placed = None
+        variants = _dihedral_variants(base)
+        random.shuffle(variants)
+        for _ in range(160):
+            mask = random.choice(variants)
+            h, w = mask.shape
+            if h > interior_h or w > interior_w:
+                continue
+            r0 = random.randint(0, interior_h - h)
+            c0 = random.randint(0, interior_w - w)
+            cell_mask = np.zeros((interior_h, interior_w), dtype=bool)
+            cell_mask[r0 : r0 + h, c0 : c0 + w] = mask
+            if np.any(forbidden & cell_mask):
+                continue
+            placed = (mask.copy(), int(r0), int(c0))
+            forbidden |= _dilate8(cell_mask)
+            break
+        if placed is None:
+            return None
+        placements.append(placed)
+    return placements
+
+
+def _random_location(canvas: np.ndarray, patch: np.ndarray, allowed: np.ndarray, padding: int = 1) -> tuple[int, int]:
+    ph, pw = patch.shape
+    occ = canvas != BG
+    for _ in range(padding):
+        occ = _dilate8(occ)
+    mask = patch != BG
+    candidates = []
+    for r0 in range(canvas.shape[0] - ph + 1):
+        for c0 in range(canvas.shape[1] - pw + 1):
+            if not allowed[r0 : r0 + ph, c0 : c0 + pw][mask].all():
+                continue
+            if np.any(occ[r0 : r0 + ph, c0 : c0 + pw] & mask):
+                continue
+            candidates.append((r0, c0))
+    if not candidates:
+        raise ValueError("no free location")
+    return random.choice(candidates)
+
+
+def _paint_patch(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    mask = patch != BG
+    view = canvas[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+    view[mask] = patch[mask]
+
+
+def _wrong_position_output(frame_crop: np.ndarray, holes: list[dict], palette: list[int]) -> np.ndarray:
+    out = frame_crop.copy()
+    order = sorted(
+        holes,
+        key=lambda item: (
+            item["bbox"][0],
+            item["bbox"][1],
+            item["bbox"][2] - item["bbox"][0],
+            item["bbox"][3] - item["bbox"][1],
+        ),
+    )
+    for idx, hole in enumerate(order):
+        r0, c0, r1, c1 = hole["bbox"]
+        view = out[r0 : r1 + 1, c0 : c1 + 1]
+        view[hole["mask"]] = int(palette[idx])
+    return out
+
+
+def _wrong_piece_color_output(frame_crop: np.ndarray, holes: list[dict], pieces: list[dict], match: dict[int, int]) -> np.ndarray:
+    out = frame_crop.copy()
+    for pi, hi in match.items():
+        hole = holes[hi]
+        r0, c0, r1, c1 = hole["bbox"]
+        view = out[r0 : r1 + 1, c0 : c1 + 1]
+        view[hole["mask"]] = int(pieces[pi]["color"])
+    return out
+
+
+def _build_instance() -> np.ndarray | None:
+    hole_count = random.randint(3, 5)
+    areas = random.sample(list(range(4, 13)), hole_count)
+    shapes = [_random_connected_shape(area) for area in areas]
+
+    placements = None
+    for _ in range(80):
+        interior_h = random.randint(10, 15)
+        interior_w = random.randint(10, 15)
+        random.shuffle(shapes)
+        placements = _place_masks_on_interior(shapes, interior_h, interior_w)
+        if placements is not None:
+            break
+    if placements is None:
+        return None
+
+    frame_h = interior_h + 2
+    frame_w = interior_w + 2
+    canvas_h = random.randint(max(frame_h + 5, 20), 28)
+    canvas_w = random.randint(max(frame_w + 6, 20), 28)
+    max_top = canvas_h - frame_h - 3
+    max_left = canvas_w - frame_w - 2
+    if max_top < 1 or max_left < 1:
+        return None
+    frame_top = random.randint(1, min(6, max_top))
+    frame_left = random.randint(1, max_left)
+    palette_row = frame_top + frame_h + 1
+    if palette_row >= canvas_h:
+        return None
+
+    frame_crop = np.full((frame_h, frame_w), FRAME, dtype=int)
+    holes = []
+    piece_shapes: list[np.ndarray] = []
+    transformed_visibly = False
+    for hole_mask, hr, hc in placements:
+        frame_crop[1 + hr : 1 + hr + hole_mask.shape[0], 1 + hc : 1 + hc + hole_mask.shape[1]][hole_mask] = BG
+        coords = np.argwhere(hole_mask) + np.array([1 + hr, 1 + hc])
+        tight, bbox = _tight_mask(coords)
+        holes.append({"coords": coords, "bbox": bbox, "mask": tight, "area": int(tight.sum())})
+        variants = _dihedral_variants(hole_mask)
+        if len(variants) > 1:
+            alt = [variant for variant in variants if variant.shape != hole_mask.shape or not np.array_equal(variant, hole_mask)]
+            if alt and (not transformed_visibly or random.random() < 0.7):
+                piece_mask = random.choice(alt)
+                transformed_visibly = True
+            else:
+                piece_mask = random.choice(variants)
+        else:
+            piece_mask = hole_mask.copy()
+        piece_shapes.append(piece_mask)
+    if not transformed_visibly:
+        return None
+
+    area_sorted = sorted(range(hole_count), key=lambda idx: holes[idx]["area"])
+    raster_sorted = sorted(range(hole_count), key=lambda idx: (holes[idx]["bbox"][0], holes[idx]["bbox"][1]))
+    if area_sorted == raster_sorted:
+        return None
+
+    piece_colors = random.sample(USABLE_COLORS, hole_count)
+    while True:
+        palette_colors = random.sample(USABLE_COLORS, hole_count)
+        if any(piece_colors[area_sorted.index(i)] != palette_colors[k] for k, i in enumerate(area_sorted)):
+            break
+
+    canvas = np.zeros((canvas_h, canvas_w), dtype=int)
+    canvas[frame_top : frame_top + frame_h, frame_left : frame_left + frame_w] = frame_crop
+
+    palette_start_min = frame_left + 1
+    palette_start_max = frame_left + frame_w - hole_count - 1
+    if palette_start_max < palette_start_min:
+        return None
+    palette_start = random.randint(palette_start_min, palette_start_max)
+    for idx, color in enumerate(palette_colors):
+        canvas[palette_row, palette_start + idx] = int(color)
+
+    allowed = np.ones_like(canvas, dtype=bool)
+    pad_r0 = max(0, frame_top - 1)
+    pad_r1 = min(canvas_h, frame_top + frame_h + 1)
+    pad_c0 = max(0, frame_left - 1)
+    pad_c1 = min(canvas_w, frame_left + frame_w + 1)
+    allowed[pad_r0:pad_r1, pad_c0:pad_c1] = False
+    allowed[max(0, palette_row - 1) : min(canvas_h, palette_row + 2), :] = False
+
+    pieces = []
+    for color, mask in zip(piece_colors, piece_shapes):
+        patch = np.zeros(mask.shape, dtype=int)
+        patch[mask] = int(color)
+        try:
+            r0, c0 = _random_location(canvas, patch, allowed, padding=1)
+        except ValueError:
+            return None
+        _paint_patch(canvas, patch, r0, c0)
+        coords = np.argwhere(mask) + np.array([r0, c0])
+        tight, bbox = _tight_mask(coords)
+        pieces.append({"coords": coords, "bbox": bbox, "mask": tight, "area": int(tight.sum()), "color": int(color)})
+
+    expected = _fill_holes(frame_crop, holes, palette_colors)
+    wrong_position = _wrong_position_output(frame_crop, holes, palette_colors)
+    if np.array_equal(expected, wrong_position):
+        return None
+    match = _match_pieces_to_holes(pieces, holes)
+    wrong_piece = _wrong_piece_color_output(frame_crop, holes, pieces, match)
+    if np.array_equal(expected, wrong_piece):
+        return None
+
+    try:
+        actual = main(canvas)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _build_instance()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

diff --git a/arc_task_8.py b/arc_task_8.py
new file mode 100644
index 0000000000000000000000000000000000000000..83f8001c12ff3e0f93f70a02fcb660a7545b60a6
--- /dev/null
+++ b/arc_task_8.py
@@ -0,0 +1,456 @@
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+FRAME = 5
+USABLE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _tight_mask(coords: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    out[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return out, (r0, c0, r1, c1)
+
+
+def _dihedral_variants(mask: np.ndarray) -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for candidate in (rot, np.fliplr(rot)):
+            key = (tuple(map(int, candidate.shape)), candidate.tobytes())
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(candidate.copy())
+    return variants
+
+
+def _find_frame(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    comps = _components(grid == FRAME)
+    assert comps, "expected a grey frame"
+    largest = max(comps, key=lambda pts: int(pts.shape[0]))
+    bbox = _bbox_coords(largest)
+    return largest, bbox
+
+
+def _extract_holes(frame_crop: np.ndarray) -> list[dict]:
+    holes = []
+    for coords in _components(frame_crop == BG):
+        if np.any(coords[:, 0] == 0) or np.any(coords[:, 0] == frame_crop.shape[0] - 1):
+            continue
+        if np.any(coords[:, 1] == 0) or np.any(coords[:, 1] == frame_crop.shape[1] - 1):
+            continue
+        mask, bbox = _tight_mask(coords)
+        holes.append(
+            {
+                "coords": coords,
+                "bbox": bbox,
+                "mask": mask,
+                "area": int(mask.sum()),
+            }
+        )
+    assert 3 <= len(holes) <= 5, f"expected 3-5 holes, got {len(holes)}"
+    areas = [hole["area"] for hole in holes]
+    assert len(set(areas)) == len(areas), "hole areas must be unique"
+    return holes
+
+
+def _outside_components(grid: np.ndarray, frame_bbox: tuple[int, int, int, int]) -> list[dict]:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    comps: list[dict] = []
+    for color in sorted(set(map(int, grid.ravel())) - {BG, FRAME}):
+        for coords in _components(grid == color):
+            r0, c0, r1, c1 = _bbox_coords(coords)
+            if r0 >= fr0 and r1 <= fr1 and c0 >= fc0 and c1 <= fc1:
+                continue
+            mask, bbox = _tight_mask(coords)
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox,
+                    "mask": mask,
+                    "area": int(mask.sum()),
+                }
+            )
+    return comps
+
+
+def _extract_palette(comps: list[dict], frame_bbox: tuple[int, int, int, int], hole_count: int) -> tuple[int, list[int], list[dict]]:
+    _fr0, _fc0, fr1, _fc1 = frame_bbox
+    row_groups: dict[int, list[dict]] = defaultdict(list)
+    for comp in comps:
+        r0, c0, r1, c1 = comp["bbox"]
+        if comp["area"] == 1 and r0 == r1 and c0 == c1 and r0 > fr1:
+            row_groups[r0].append(comp)
+    candidates = []
+    for row, group in row_groups.items():
+        if len(group) == hole_count:
+            candidates.append((row, sorted(group, key=lambda item: item["bbox"][1])))
+    assert len(candidates) == 1, f"expected one palette row, got {len(candidates)}"
+    row, group = candidates[0]
+    colors = [int(comp["color"]) for comp in group]
+    assert len(set(colors)) == len(colors), "palette colors must be distinct"
+    return int(row), colors, group
+
+
+def _extract_pieces(comps: list[dict], palette_comps: list[dict]) -> list[dict]:
+    palette_ids = {id(comp) for comp in palette_comps}
+    pieces = [comp for comp in comps if id(comp) not in palette_ids and comp["area"] > 1]
+    assert pieces, "expected external pieces"
+    return pieces
+
+
+def _match_pieces_to_holes(pieces: list[dict], holes: list[dict]) -> dict[int, int]:
+    matches: dict[int, int] = {}
+    used_holes: set[int] = set()
+    for pi, piece in enumerate(pieces):
+        candidates = []
+        for hi, hole in enumerate(holes):
+            if piece["area"] != hole["area"]:
+                continue
+            if any(
+                variant.shape == hole["mask"].shape and np.array_equal(variant, hole["mask"])
+                for variant in _dihedral_variants(piece["mask"])
+            ):
+                candidates.append(hi)
+        assert len(candidates) == 1, f"piece {pi} must match exactly one hole"
+        matches[pi] = int(candidates[0])
+        used_holes.add(int(candidates[0]))
+    assert len(used_holes) == len(holes) == len(pieces), "piece-hole matching must be bijective"
+    return matches
+
+
+def _fill_holes(frame_crop: np.ndarray, holes: list[dict], colors: list[int]) -> np.ndarray:
+    out = frame_crop.copy()
+    for rank, hole in enumerate(sorted(holes, key=lambda item: int(item["area"]))):
+        color = int(colors[rank])
+        r0, c0, r1, c1 = hole["bbox"]
+        view = out[r0 : r1 + 1, c0 : c1 + 1]
+        view[hole["mask"]] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fit each outside piece into the matching frame hole, then recolor by hole-area rank.
+
+    Input structure:
+    - Black background with one solid grey rectangular frame whose interior contains 3-5 black 4-connected holes.
+    - Outside the frame are the same number of monochrome pieces, one per hole, each matching a hole up to rotation or horizontal flip.
+    - Below the frame is one row of distinct colored single pixels forming the palette sequence.
+
+    Rule:
+    - Extract the black holes inside the grey frame and the palette row below the frame.
+    - Match every outside piece to exactly one hole by exact shape under the 8 dihedral transforms.
+    - Rank the holes by area from smallest to largest, read palette colors from left to right, and assign the k-th palette color to the k-th smallest hole.
+    - Return only the frame crop, keeping grey cells unchanged and filling each hole with its assigned palette color.
+
+    Key insight:
+    - Piece colors only identify the movable shapes; the output colors come exclusively from area ordering of the frame holes and the external palette row.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    _frame_comp, frame_bbox = _find_frame(g)
+    fr0, fc0, fr1, fc1 = frame_bbox
+    frame_crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1].copy()
+    holes = _extract_holes(frame_crop)
+    comps = _outside_components(g, frame_bbox)
+    palette_row, palette_colors, palette_comps = _extract_palette(comps, frame_bbox, len(holes))
+    assert palette_row > fr1, "palette must be below the frame"
+    pieces = _extract_pieces(comps, palette_comps)
+    _match_pieces_to_holes(pieces, holes)
+    return _fill_holes(frame_crop, holes, palette_colors)
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[:-1, :] |= mask[1:, :]
+    out[1:, :] |= mask[:-1, :]
+    out[:, :-1] |= mask[:, 1:]
+    out[:, 1:] |= mask[:, :-1]
+    out[:-1, :-1] |= mask[1:, 1:]
+    out[:-1, 1:] |= mask[1:, :-1]
+    out[1:, :-1] |= mask[:-1, 1:]
+    out[1:, 1:] |= mask[:-1, :-1]
+    return out
+
+
+def _random_connected_shape(area: int) -> np.ndarray:
+    assert 4 <= area <= 12
+    for _ in range(300):
+        cells = {(0, 0)}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) in cells:
+                        continue
+                    trial = cells | {(nr, nc)}
+                    rs = [pt[0] for pt in trial]
+                    cs = [pt[1] for pt in trial]
+                    if max(rs) - min(rs) + 1 <= 5 and max(cs) - min(cs) + 1 <= 5:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != area:
+            continue
+        rs = [pt[0] for pt in cells]
+        cs = [pt[1] for pt in cells]
+        r0, c0 = min(rs), min(cs)
+        norm = sorted((r - r0, c - c0) for r, c in cells)
+        h = max(r for r, _ in norm) + 1
+        w = max(c for _, c in norm) + 1
+        mask = np.zeros((h, w), dtype=bool)
+        for r, c in norm:
+            mask[r, c] = True
+        if h == 1 or w == 1:
+            continue
+        if mask.sum() == h * w and area not in (6, 8, 10, 12):
+            continue
+        return mask
+    raise RuntimeError(f"failed to create shape of area {area}")
+
+
+def _place_masks_on_interior(shapes: list[np.ndarray], interior_h: int, interior_w: int) -> list[tuple[np.ndarray, int, int]] | None:
+    placements: list[tuple[np.ndarray, int, int]] = []
+    forbidden = np.zeros((interior_h, interior_w), dtype=bool)
+    for base in shapes:
+        placed = None
+        variants = _dihedral_variants(base)
+        random.shuffle(variants)
+        for _ in range(160):
+            mask = random.choice(variants)
+            h, w = mask.shape
+            if h > interior_h or w > interior_w:
+                continue
