+    canvas_w = random.randint(max(frame_w + 6, 20), 28)
+    max_top = canvas_h - frame_h - 3
+    max_left = canvas_w - frame_w - 2
+    if max_top < 1 or max_left < 1:
+        return None
+    frame_top = random.randint(1, min(6, max_top))
