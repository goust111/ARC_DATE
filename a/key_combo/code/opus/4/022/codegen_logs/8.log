+    wrong_position = _wrong_position_output(frame_crop, holes, palette_colors)
+    if np.array_equal(expected, wrong_position):
+        return None
+    match = _match_pieces_to_holes(pieces, holes)
+    wrong_piece = _wrong_piece_color_output(frame_crop, holes, pieces, match)
+    if np.array_equal(expected, wrong_piece):
+        return None
+
+    try:
+        actual = main(canvas)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return canvas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _build_instance()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

