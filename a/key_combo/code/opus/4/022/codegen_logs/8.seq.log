+    piece_colors, palette = _choose_piece_and_palette_colors(n_holes)
+    rank_to_piece_color = [piece_colors[item["index"]] for item in ranked]
+    if all(int(pc) == int(pp) for pc, pp in zip(rank_to_piece_color, palette)):
+        return None
