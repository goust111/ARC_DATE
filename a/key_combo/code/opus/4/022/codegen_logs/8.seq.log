+        palette_rows.append((r, row_comps))
+    assert len(palette_rows) == 1, f"expected one palette row, found {len(palette_rows)}"
+    _palette_r, palette_comps = palette_rows[0]
+    palette = [int(comp["color"]) for comp in palette_comps]
