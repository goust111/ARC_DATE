+    palette_cells = {tuple(map(int, comp["coords"][0])) for comp in palette_comps}
+    pieces: list[dict] = []
+    for comp in comps:
+        coords_list = [tuple(map(int, rc)) for rc in comp["coords"]]
+        if len(coords_list) == 1 and coords_list[0] in palette_cells:
+            continue
+        r0, c0, r1, c1 = comp["bbox"]
