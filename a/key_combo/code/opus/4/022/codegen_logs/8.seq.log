+            continue
+        mask = _shape_from_cells(cells)
+        if mask.shape[0] > 5 or mask.shape[1] > 5:
+            continue
+        if mask.shape[0] < 2 or mask.shape[1] < 2:
+            continue
+        if not mask[0, :].any() or not mask[-1, :].any() or not mask[:, 0].any() or not mask[:, -1].any():
