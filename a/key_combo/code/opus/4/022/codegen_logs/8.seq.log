+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BG = 0
+FRAME = 5
+COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_ATTEMPTS = 400
