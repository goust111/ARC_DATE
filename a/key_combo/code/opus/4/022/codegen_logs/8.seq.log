+        for c in range(w):
+            if not bool(mask[r, c]) or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in nbrs:
+                    nr, nc = rr + dr, cc + dc
