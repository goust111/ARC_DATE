+    for rank, item in enumerate(ranked):
+        color = int(palette[rank])
+        top = int(item["top"]) + 1
+        left = int(item["left"]) + 1
+        mask = item["shape"]
+        expected[top : top + mask.shape[0], left : left + mask.shape[1]][mask] = color
