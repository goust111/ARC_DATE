    g: np.ndarray,
    out: np.ndarray,
    bg: int,
    start: tuple[int, int],
    direction: tuple[int, int],
    odd_axis: str,
    odd_order: str,
) -> None:
    r, c = start
    dr, dc = direction
    step = 0
    while True:
