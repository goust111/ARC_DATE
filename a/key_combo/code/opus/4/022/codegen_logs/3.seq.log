            r = h - 1 - length
            if 1 <= r <= h - 2:
                candidates.append((AXIS_HORIZONTAL, (r, c), (1, 0), (r - 1, c)))

        for r in range(BAR_CENTER_MARGIN, h - BAR_CENTER_MARGIN):
