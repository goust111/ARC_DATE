+                candidates = [c for c in stripe_colors if c != main_color]
+                grid[rr, cc] = int(rng.choice(candidates))
+                placed += 1
+                break
+
+
+def _expected_from_spec(
+    grid: np.ndarray,
+    row_lines: list[int],
+    col_lines: list[int],
+    top_idx: int,
+    bottom_idx: int,
+    left_idx: int,
+    right_idx: int,
+) -> np.ndarray:
+    r0, r1 = row_lines[top_idx], row_lines[bottom_idx]
+    c0, c1 = col_lines[left_idx], col_lines[right_idx]
+    crop = crop_bbox(grid, (r0, c0, r1, c1))
+    local_rows = [int(v - r0) for v in row_lines[top_idx : bottom_idx + 1]]
+    local_cols = [int(v - c0) for v in col_lines[left_idx : right_idx + 1]]
+    return _reorder_crop(crop, local_rows, local_cols)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_band_rows = rng.randint(4, 6)
+    n_stripes = rng.randint(5, 6)
+    height = 1 + n_band_rows * STEP
+    width = 1 + n_stripes * STEP
+    if max(height, width) > 30:
+        return None
+
+    grid = np.zeros((height, width), dtype=int)
+    row_lines = [i * STEP for i in range(n_band_rows + 1)]
+    col_lines = [i * STEP for i in range(n_stripes + 1)]
+    grid[row_lines, :] = GREY
+    grid[:, col_lines] = GREY
+
+    stripe_colors = rng.sample(PALETTE, n_stripes)
+    _fill_stripes(grid, row_lines, col_lines, stripe_colors)
+
+    crop_rows = rng.randint(2, n_band_rows - 1)
+    crop_cols = rng.randint(3, n_stripes - 1)
+    top_idx = rng.randint(0, n_band_rows - crop_rows)
+    left_idx = rng.randint(0, n_stripes - crop_cols)
+    bottom_idx = top_idx + crop_rows
+    right_idx = left_idx + crop_cols
+
+    crop_colors = stripe_colors[left_idx:right_idx]
+    target_colors = _permute_colors(rng, crop_colors)
+
+    missing = [
+        (row_lines[top_idx], col_lines[left_idx]),
+        (row_lines[top_idx], col_lines[right_idx]),
+        (row_lines[bottom_idx], col_lines[left_idx]),
+        (row_lines[bottom_idx], col_lines[right_idx]),
+    ]
+    for r, c in missing:
+        grid[r, c] = BLACK
+
+    marker_r = row_lines[top_idx] + 1 + CELL // 2
+    for offset, marker_color in enumerate(target_colors):
+        stripe_idx = left_idx + offset
+        marker_c = col_lines[stripe_idx] + 1 + CELL // 2
+        grid[marker_r, marker_c] = int(marker_color)
+
+    crop_band_rows = list(range(top_idx, bottom_idx))
+    crop_stripe_cols = list(range(left_idx, right_idx))
+    _place_noise(rng, grid, row_lines, col_lines, stripe_colors, top_idx, crop_band_rows, crop_stripe_cols)
+
+    expected = _expected_from_spec(grid, row_lines, col_lines, top_idx, bottom_idx, left_idx, right_idx)
+    if expected.shape[0] <= 1 or expected.shape[1] <= 1:
+        return None
+
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+
+    if np.array_equal(actual, crop_bbox(grid, (row_lines[top_idx], col_lines[left_idx], row_lines[bottom_idx], col_lines[right_idx]))):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input failed after {GEN_RETRIES} attempts")

