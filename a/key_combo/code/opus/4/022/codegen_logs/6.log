+crop_bbox = _ARC.crop_bbox
+
+BLACK = 0
+GREY = 5
+CELL = 3
+STEP = CELL + 1
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+NOISE_OFFSETS = [(0, 0), (0, 2), (1, 0), (1, 2), (2, 0), (2, 2)]
+
+
+def _grid_lines(grid: np.ndarray, axis: int) -> list[int]:
+    grey = grid == GREY
+    counts = grey.sum(axis=1 if axis == 0 else 0)
+    limit = (grid.shape[1 - axis] - 2)
+    lines = [int(i) for i, count in enumerate(counts) if int(count) >= limit]
+    assert len(lines) >= 4, "expected at least four grid lines"
+    gaps = [b - a for a, b in zip(lines, lines[1:])]
+    assert len(set(gaps)) == 1 and gaps[0] > 1, "grid lines must be evenly spaced"
+    return lines
+
+
+def _missing_corners(grid: np.ndarray, row_lines: list[int], col_lines: list[int]) -> tuple[int, int, int, int]:
+    missing = [(r, c) for r in row_lines for c in col_lines if int(grid[r, c]) == BLACK]
+    assert len(missing) == 4, "expected exactly four missing intersections"
+    rows = sorted({r for r, _ in missing})
+    cols = sorted({c for _, c in missing})
+    assert len(rows) == 2 and len(cols) == 2, "missing intersections must define a rectangle"
+    assert set(missing) == set(itertools.product(rows, cols)), "missing intersections must be rectangle corners"
+    return rows[0], cols[0], rows[1], cols[1]
+
+
