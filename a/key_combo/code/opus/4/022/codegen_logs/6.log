+        ce = col_lines[stripe_idx + 1]
+        for band_idx in range(len(row_lines) - 1):
+            rs = row_lines[band_idx] + 1
+            re = row_lines[band_idx + 1]
+            grid[rs:re, cs:ce] = int(color)
