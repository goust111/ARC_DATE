+from __future__ import annotations
+
+from collections import Counter
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+import itertools
+import random
+
+import numpy as np
+
+
+def _load_arc_utils():
+    path = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
+    spec = spec_from_file_location("arc_utils_022_6", path)
+    if spec is None or spec.loader is None:
+        raise ImportError(f"cannot load arc_utils from {path}")
+    module = module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+_ARC = _load_arc_utils()
+crop_bbox = _ARC.crop_bbox
+
+BLACK = 0
+GREY = 5
+CELL = 3
+STEP = CELL + 1
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
+NOISE_OFFSETS = [(0, 0), (0, 2), (1, 0), (1, 2), (2, 0), (2, 2)]
+
+
+def _grid_lines(grid: np.ndarray, axis: int) -> list[int]:
+    grey = grid == GREY
+    counts = grey.sum(axis=1 if axis == 0 else 0)
+    limit = (grid.shape[1 - axis] - 2)
+    lines = [int(i) for i, count in enumerate(counts) if int(count) >= limit]
+    assert len(lines) >= 4, "expected at least four grid lines"
+    gaps = [b - a for a, b in zip(lines, lines[1:])]
+    assert len(set(gaps)) == 1 and gaps[0] > 1, "grid lines must be evenly spaced"
+    return lines
+
+
+def _missing_corners(grid: np.ndarray, row_lines: list[int], col_lines: list[int]) -> tuple[int, int, int, int]:
+    missing = [(r, c) for r in row_lines for c in col_lines if int(grid[r, c]) == BLACK]
+    assert len(missing) == 4, "expected exactly four missing intersections"
+    rows = sorted({r for r, _ in missing})
+    cols = sorted({c for _, c in missing})
+    assert len(rows) == 2 and len(cols) == 2, "missing intersections must define a rectangle"
+    assert set(missing) == set(itertools.product(rows, cols)), "missing intersections must be rectangle corners"
+    return rows[0], cols[0], rows[1], cols[1]
+
+
+def _line_positions_within(start: int, end: int, lines: list[int]) -> list[int]:
+    inside = [int(v - start) for v in lines if start <= v <= end]
+    assert len(inside) >= 2
+    return inside
+
+
+def _stripe_spans(col_lines: list[int]) -> list[tuple[int, int]]:
+    spans = [(col_lines[i] + 1, col_lines[i + 1]) for i in range(len(col_lines) - 1)]
+    assert spans and all(end - start == CELL for start, end in spans)
+    return spans
+
+
+def _dominant_payload_color(patch: np.ndarray) -> int:
+    values = [int(v) for v in patch.ravel() if int(v) not in (BLACK, GREY)]
+    assert values, "stripe patch must contain payload colors"
+    return int(Counter(values).most_common(1)[0][0])
+
+
+def _marker_sequence(subgrid: np.ndarray, row_lines: list[int], col_lines: list[int]) -> list[int]:
+    assert len(row_lines) >= 2
+    center_r = (row_lines[0] + row_lines[1]) // 2
+    seq = []
+    for left, right in zip(col_lines, col_lines[1:]):
+        center_c = (left + right) // 2
+        seq.append(int(subgrid[center_r, center_c]))
+    return seq
+
+
+def _reorder_crop(subgrid: np.ndarray, row_lines: list[int], col_lines: list[int]) -> np.ndarray:
+    spans = _stripe_spans(col_lines)
+    main_colors = [_dominant_payload_color(subgrid[:, start:end]) for start, end in spans]
+    assert len(set(main_colors)) == len(main_colors), "stripe dominant colors must be unique"
+
+    target = _marker_sequence(subgrid, row_lines, col_lines)
+    assert Counter(target) == Counter(main_colors), "marker sequence must permute stripe colors"
+
+    source_by_color = {color: i for i, color in enumerate(main_colors)}
+    out = subgrid.copy()
+    for dest_idx, color in enumerate(target):
+        src_idx = source_by_color[color]
+        src_start, src_end = spans[src_idx]
+        dst_start, dst_end = spans[dest_idx]
+        out[:, dst_start:dst_end] = subgrid[:, src_start:src_end]
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Crop the rectangle defined by four missing grid intersections, then reorder its vertical stripes by top-row marker colors.
+
+    Input structure:
+    - Black background with a regular grey lattice of 1-pixel grid lines at uniform spacing.
+    - Exactly four grid intersections are missing: those grey crossing pixels are replaced with black and form an axis-aligned rectangle.
+    - Cell interiors are filled by vertical color-major stripes; inside the crop's top cell row, one central marker pixel appears in each stripe.
+
+    Rule:
+    - Detect the grey grid lines and locate the four missing intersections.
+    - Crop the subgrid spanning that rectangle, including its grey border lines.
+    - Within the crop, identify each vertical stripe by the dominant non-black, non-grey color between adjacent vertical grid lines.
+    - Read the top-row marker pixels from left to right; their colors give a permutation of the stripe dominant colors.
+    - Rearrange whole stripe contents into that target color order while keeping the crop's grid framework unchanged.
+
+    Key insight:
+    - The missing intersections choose both the output window and the subset of stripes that participate; the marker colors inside that crop encode the permutation by color matching, not by marker position.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    row_lines = _grid_lines(g, axis=0)
+    col_lines = _grid_lines(g, axis=1)
+    r0, c0, r1, c1 = _missing_corners(g, row_lines, col_lines)
+    sub = crop_bbox(g, (r0, c0, r1, c1))
+
+    local_rows = _line_positions_within(r0, r1, row_lines)
+    local_cols = _line_positions_within(c0, c1, col_lines)
+    return _reorder_crop(sub, local_rows, local_cols)
+
+
+def _permute_colors(rng: random.Random, colors: list[int]) -> list[int]:
+    sorted_colors = sorted(colors)
+    reverse_sorted = list(reversed(sorted_colors))
+    for _ in range(100):
+        seq = colors[:]
+        rng.shuffle(seq)
+        if seq == colors:
+            continue
+        if seq == sorted_colors or seq == reverse_sorted:
+            continue
+        return seq
+    raise RuntimeError("failed to find a non-degenerate marker permutation")
+
+
+def _fill_stripes(grid: np.ndarray, row_lines: list[int], col_lines: list[int], stripe_colors: list[int]) -> None:
+    for stripe_idx, color in enumerate(stripe_colors):
+        cs = col_lines[stripe_idx] + 1
+        ce = col_lines[stripe_idx + 1]
+        for band_idx in range(len(row_lines) - 1):
+            rs = row_lines[band_idx] + 1
+            re = row_lines[band_idx + 1]
+            grid[rs:re, cs:ce] = int(color)
+
+
+def _place_noise(
+    rng: random.Random,
+    grid: np.ndarray,
+    row_lines: list[int],
+    col_lines: list[int],
+    stripe_colors: list[int],
+    top_band: int,
+    crop_band_rows: list[int],
+    crop_stripe_cols: list[int],
+) -> None:
+    for stripe_idx, main_color in enumerate(stripe_colors):
+        chosen_rows = list(range(len(row_lines) - 1))
+        rng.shuffle(chosen_rows)
+        markers_to_place = 1 + int(stripe_idx in crop_stripe_cols and len(crop_band_rows) > 1 and rng.random() < 0.7)
+        placed = 0
+        for band_idx in chosen_rows:
+            if placed >= markers_to_place:
+                break
+            offsets = NOISE_OFFSETS[:]
+            rng.shuffle(offsets)
+            for dr, dc in offsets:
+                rr = row_lines[band_idx] + 1 + dr
+                cc = col_lines[stripe_idx] + 1 + dc
+                if band_idx == top_band and dr == 1:
+                    continue
+                if int(grid[rr, cc]) != int(main_color):
+                    continue
+                candidates = [c for c in stripe_colors if c != main_color]
+                grid[rr, cc] = int(rng.choice(candidates))
+                placed += 1
+                break
+
+
+def _expected_from_spec(
+    grid: np.ndarray,
+    row_lines: list[int],
+    col_lines: list[int],
+    top_idx: int,
+    bottom_idx: int,
+    left_idx: int,
+    right_idx: int,
+) -> np.ndarray:
+    r0, r1 = row_lines[top_idx], row_lines[bottom_idx]
+    c0, c1 = col_lines[left_idx], col_lines[right_idx]
+    crop = crop_bbox(grid, (r0, c0, r1, c1))
+    local_rows = [int(v - r0) for v in row_lines[top_idx : bottom_idx + 1]]
+    local_cols = [int(v - c0) for v in col_lines[left_idx : right_idx + 1]]
+    return _reorder_crop(crop, local_rows, local_cols)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n_band_rows = rng.randint(4, 6)
+    n_stripes = rng.randint(5, 6)
+    height = 1 + n_band_rows * STEP
+    width = 1 + n_stripes * STEP
+    if max(height, width) > 30:
+        return None
+
+    grid = np.zeros((height, width), dtype=int)
+    row_lines = [i * STEP for i in range(n_band_rows + 1)]
+    col_lines = [i * STEP for i in range(n_stripes + 1)]
+    grid[row_lines, :] = GREY
+    grid[:, col_lines] = GREY
+
+    stripe_colors = rng.sample(PALETTE, n_stripes)
+    _fill_stripes(grid, row_lines, col_lines, stripe_colors)
+
+    crop_rows = rng.randint(2, n_band_rows - 1)
+    crop_cols = rng.randint(3, n_stripes - 1)
+    top_idx = rng.randint(0, n_band_rows - crop_rows)
+    left_idx = rng.randint(0, n_stripes - crop_cols)
+    bottom_idx = top_idx + crop_rows
+    right_idx = left_idx + crop_cols
+
+    crop_colors = stripe_colors[left_idx:right_idx]
+    target_colors = _permute_colors(rng, crop_colors)
+
+    missing = [
+        (row_lines[top_idx], col_lines[left_idx]),
+        (row_lines[top_idx], col_lines[right_idx]),
+        (row_lines[bottom_idx], col_lines[left_idx]),
+        (row_lines[bottom_idx], col_lines[right_idx]),
+    ]
+    for r, c in missing:
+        grid[r, c] = BLACK
+
+    marker_r = row_lines[top_idx] + 1 + CELL // 2
+    for offset, marker_color in enumerate(target_colors):
+        stripe_idx = left_idx + offset
+        marker_c = col_lines[stripe_idx] + 1 + CELL // 2
+        grid[marker_r, marker_c] = int(marker_color)
+
+    crop_band_rows = list(range(top_idx, bottom_idx))
+    crop_stripe_cols = list(range(left_idx, right_idx))
+    _place_noise(rng, grid, row_lines, col_lines, stripe_colors, top_idx, crop_band_rows, crop_stripe_cols)
+
+    expected = _expected_from_spec(grid, row_lines, col_lines, top_idx, bottom_idx, left_idx, right_idx)
+    if expected.shape[0] <= 1 or expected.shape[1] <= 1:
+        return None
+
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+
+    if np.array_equal(actual, crop_bbox(grid, (row_lines[top_idx], col_lines[left_idx], row_lines[bottom_idx], col_lines[right_idx]))):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"generate_input failed after {GEN_RETRIES} attempts")

