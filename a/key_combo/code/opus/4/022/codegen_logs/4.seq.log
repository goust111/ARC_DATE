   406	def _gen_attempt(rng: random.Random) -> np.ndarray | None:
   407	    h = rng.randint(13, 16)
   408	    w = rng.randint(13, 16)
   409	    seed = (rng.randint(3, h - 4), rng.randint(3, w - 4))
   410	    object_count = rng.randint(4, 6)
   411	
   412	    candidate_rows = [r for r in range(1, h - 1) if r not in {seed[0] - 1, seed[0], seed[0] + 1}]
   413	    if len(candidate_rows) < object_count:
   414	        return None
   415	    rows = sorted(rng.sample(candidate_rows, object_count))
   416	
   417	    blocker_specs = _pick_blocker_specs(rng, rows, seed, w)
   418	    if blocker_specs is None:
   419	        return None
   420	
   421	    blockers_by_rank = {int(spec["rank"]): dict(spec) for spec in blocker_specs}
   422	    for spec in blockers_by_rank.values():
   423	        spec["length"] = rng.randint(3, int(spec["max_len"]))
   424	
   425	    input_occupied: set[tuple[int, int]] = set()
   426	    shifted_occupied: set[tuple[int, int]] = set()
   427	    object_cells_by_rank: dict[int, set[tuple[int, int]]] = {}
   428	
   429	    for rank, row in enumerate(rows, start=1):
   430	        if rank in blockers_by_rank:
   431	            cells = _blocker_cells_for_spec(blockers_by_rank[rank])
   432	        else:
   433	            cells = _random_distractor_cells(
   434	                rng,
   435	                row=row,
   436	                rank=rank,
   437	                shape=(h, w),
   438	                seed=seed,
   439	                input_occupied=input_occupied,
   440	                shifted_occupied=shifted_occupied,
   441	            )
   442	            if cells is None:
   443	                return None
   444	
   445	        shifted = _cells_with_offset(cells, _shift_value(rank))
   446	        if any(not in_bounds((h, w), r, c) for r, c in cells | shifted):
   447	            return None
   448	        if _touches_existing(cells, input_occupied) or _touches_existing(shifted, shifted_occupied):
   449	            return None
   450	        if _touches_seed(seed, cells):
   451	            return None
   452	        if len(cells) < 3 or len(cells) > 8:
   453	            return None
   454	
   455	        input_occupied |= cells
   456	        shifted_occupied |= shifted
   457	        object_cells_by_rank[rank] = cells
   458	
   459	    grid = np.zeros((h, w), dtype=int)
   460	    for cells in object_cells_by_rank.values():
   461	        for r, c in cells:
   462	            grid[r, c] = BLUE
   463	    grid[seed] = RED
   464	
   465	    provisional = main(grid)
   466	    rays = _rays_from_output(provisional, seed)
   467	    path_cells = [cell for path in rays.values() for cell in path]
   468	    if len(path_cells) < 2:
   469	        return None
   470	
   471	    grey_total = rng.randint(2, 3)
   472	    path_candidates = [cell for cell in path_cells if grid[cell] == BG and not _touches_seed(seed, {cell})]
   473	    rng.shuffle(path_candidates)
   474	    if not path_candidates:
   475	        return None
   476	
   477	    grey_cells: list[tuple[int, int]] = [path_candidates[0]]
   478	    free_cells = [
   479	        (r, c)
   480	        for r in range(1, h - 1)
   481	        for c in range(1, w - 1)
   482	        if grid[r, c] == BG and (r, c) != seed
   483	    ]
   484	    rng.shuffle(free_cells)
   485	    for cell in free_cells:
   486	        if len(grey_cells) >= grey_total:
   487	            break
   488	        if cell in grey_cells:
   489	            continue
   490	        if any(max(abs(cell[0] - b[0]), abs(cell[1] - b[1])) <= 1 for b in input_occupied):
   491	            continue
   492	        if max(abs(cell[0] - seed[0]), abs(cell[1] - seed[1])) <= 1:
   493	            continue
   494	        grey_cells.append(cell)
   495	    if len(grey_cells) != grey_total:
   496	        return None
   497	
   498	    for cell in grey_cells:
   499	        grid[cell] = GREY
   500	
   501	    if not _validate_instance(grid):
   502	        return None
   503	    return grid
