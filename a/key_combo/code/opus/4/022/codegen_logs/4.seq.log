   113	def main(grid: np.ndarray) -> np.ndarray:
   114	    """
   115	    Shift blue objects in alternating top-to-bottom order, then redraw diagonal red rays using their shifted positions as blockers.
   116	
   117	    Input structure:
   118	    - Black background with 4-6 blue 4-connected objects whose top bbox rows are all distinct.
   119	    - Exactly one isolated red seed pixel sits away from the outer border.
   120	    - Two or three isolated grey singleton pixels may appear as visual decoys.
   121	
   122	    Rule:
   123	    - Sort the blue objects by increasing top bbox row.
   124	    - Shift ranks 1,3,5,... one column left and ranks 2,4,6,... one column right.
   125	    - Erase every grey pixel.
   126	    - From the red seed, extend red rays one cell at a time along NE, NW, SE, and SW; stop before a shifted blue pixel or before stepping onto the outer border.
   127	    - Keep only the shifted blue objects, the red seed, and the painted red ray cells.
   128	
   129	    Key insight:
   130	    - The real blockers are the blue objects after the alternating shift; grey pixels only mimic blockers visually and must be ignored and erased.
   131	    """
   132	    g = np.asarray(grid, dtype=int)
   133	    shifted_objects = _shifted_blue_cells(g)
   134	    blocker_cells = {
   135	        (int(r), int(c))
   136	        for coords in shifted_objects
   137	        for r, c in coords
   138	    }
   139	    return _build_output(g, shifted_objects=shifted_objects, blocker_cells=blocker_cells)
