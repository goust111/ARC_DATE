+
+def _touches_existing(cells: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    if cells & occupied:
+        return True
+    for cell in cells:
+        for nb in _neighbor4(cell):
+            if nb in occupied:
