+    ranks = list(candidates)
+    if len(ranks) < 2:
+        return None
+    rank_parity = {rank: rank % 2 for rank in ranks}
+    sizes = [3, 2, 2]
+    for desired in sizes:
+        for _ in range(160):
+            chosen_ranks = rng.sample(ranks, k=min(desired, len(ranks)))
+            if len({rank_parity[r] for r in chosen_ranks}) < 2:
