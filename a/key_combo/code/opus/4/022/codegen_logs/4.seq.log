+def _neighbor4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _neighbor8(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr != 0 or dc != 0
+    ]
