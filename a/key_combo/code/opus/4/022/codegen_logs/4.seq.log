+
+
+def _pick_blocker_specs(rng: random.Random, rows: list[int], seed: tuple[int, int], width: int) -> list[dict] | None:
+    candidates = _candidate_blockers(rows, seed, width)
+    ranks = list(candidates)
+    if len(ranks) < 2:
