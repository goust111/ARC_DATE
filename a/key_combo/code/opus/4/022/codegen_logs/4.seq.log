   268	    seed: tuple[int, int],
   269	    input_occupied: set[tuple[int, int]],
   270	    shifted_occupied: set[tuple[int, int]],
   271	) -> set[tuple[int, int]] | None:
   272	    h, w = shape
   273	    dc_shift = _shift_value(rank)
   274	    templates = DISTRACTOR_SHAPES[:]
   275	    rng.shuffle(templates)
   276	    for rel in templates:
   277	        rel_rows = [r for r, _ in rel]
   278	        rel_cols = [c for _, c in rel]
   279	        height = max(rel_rows) + 1
   280	        width = max(rel_cols) + 1
   281	        if row + height > h:
   282	            continue
   283	        cols = list(range(0, w - width + 1))
   284	        rng.shuffle(cols)
   285	        for c0 in cols:
   286	            cells = {(row + dr, c0 + dc) for dr, dc in rel}
   287	            shifted = _cells_with_offset(cells, dc_shift)
   288	            if any(not in_bounds(shape, r, c) for r, c in shifted):
   289	                continue
   290	            if _touches_existing(cells, input_occupied):
   291	                continue
   292	            if _touches_existing(shifted, shifted_occupied):
   293	                continue
   294	            if _touches_seed(seed, cells):
   295	                continue
   296	            if any(_is_on_seed_diagonal(seed, cell) for cell in cells):
   297	                continue
   298	            if any(_is_on_seed_diagonal(seed, cell) for cell in shifted):
   299	                continue
   300	            return cells
   301	    return None
   302	
   303	
   304	def _rays_from_output(out: np.ndarray, seed: tuple[int, int]) -> dict[str, list[tuple[int, int]]]:
   305	    rays = {}
   306	    for name, (dr, dc) in DIAGONALS.items():
   307	        path = []
   308	        r, c = seed
   309	        while True:
   310	            r += dr
   311	            c += dc
   312	            if not in_bounds(out.shape, r, c):
   313	                break
   314	            if out[r, c] != RED:
   315	                break
   316	            path.append((r, c))
   317	        rays[name] = path
   318	    return rays
   319	
   320	
   321	def _wrong_output_original_blockers(grid: np.ndarray) -> np.ndarray:
   322	    shifted_objects = _shifted_blue_cells(grid)
   323	    original_objects = _ordered_blue_objects(grid)
   324	    blocker_cells = {
   325	        (int(r), int(c))
   326	        for obj in original_objects
   327	        for r, c in np.asarray(obj["coords"], dtype=int)
   328	    }
   329	    return _build_output(grid, shifted_objects=shifted_objects, blocker_cells=blocker_cells)
   330	
   331	
   332	def _wrong_output_grey_blockers(grid: np.ndarray) -> np.ndarray:
   333	    shifted_objects = _shifted_blue_cells(grid)
   334	    blocker_cells = {
   335	        (int(r), int(c))
   336	        for coords in shifted_objects
   337	        for r, c in coords
   338	    }
   339	    grey_cells = {(int(r), int(c)) for r, c in np.argwhere(grid == GREY)}
   340	    return _build_output(grid, shifted_objects=shifted_objects, blocker_cells=blocker_cells | grey_cells)
   341	
   342	
   343	def _validate_instance(grid: np.ndarray) -> bool:
   344	    if grid.ndim != 2 or max(grid.shape) > 30:
   345	        return False
   346	
   347	    red_cells = np.argwhere(grid == RED)
   348	    grey_cells = np.argwhere(grid == GREY)
   349	    if red_cells.shape != (1, 2) or not (2 <= len(grey_cells) <= 3):
   350	        return False
   351	
   352	    seed = tuple(map(int, red_cells[0]))
   353	    if seed[0] in {0, grid.shape[0] - 1} or seed[1] in {0, grid.shape[1] - 1}:
   354	        return False
   355	
   356	    try:
   357	        ordered = _ordered_blue_objects(grid)
   358	        shifted = _shifted_blue_cells(grid)
   359	    except AssertionError:
   360	        return False
   361	
   362	    if any(not (3 <= len(obj["coords"]) <= 8) for obj in ordered):
   363	        return False
   364	
   365	    input_blue = {(int(r), int(c)) for obj in ordered for r, c in np.asarray(obj["coords"], dtype=int)}
   366	    for cell in grey_cells:
   367	        if any(max(abs(int(cell[0]) - r), abs(int(cell[1]) - c)) <= 1 for r, c in input_blue):
   368	            return False
   369	    if any(max(abs(seed[0] - r), abs(seed[1] - c)) <= 1 for r, c in input_blue):
   370	        return False
   371	
   372	    out = main(grid)
   373	    wrong_original = _wrong_output_original_blockers(grid)
   374	    wrong_grey = _wrong_output_grey_blockers(grid)
   375	    if np.array_equal(out, wrong_original) or np.array_equal(out, wrong_grey):
   376	        return False
   377	
   378	    rays = _rays_from_output(out, seed)
   379	    ray_lengths = [len(path) for path in rays.values()]
   380	    if max(ray_lengths) < 1:
   381	        return False
   382	    if not any(length >= 2 for length in ray_lengths):
   383	        return False
   384	
   385	    shifted_cells = {(int(r), int(c)) for coords in shifted for r, c in coords}
   386	    blocked = 0
   387	    open_dirs = 0
   388	    for name, path in rays.items():
   389	        dr, dc = DIAGONALS[name]
   390	        terminal = (seed[0] + dr * (len(path) + 1), seed[1] + dc * (len(path) + 1))
   391	        if in_bounds(grid.shape, *terminal) and terminal[0] not in {0, grid.shape[0] - 1} and terminal[1] not in {0, grid.shape[1] - 1}:
   392	            if terminal in shifted_cells:
