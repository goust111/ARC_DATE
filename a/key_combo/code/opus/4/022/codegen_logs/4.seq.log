+    if dc_shift == -1:
+        return {(row, c) for c in range(target_c + 1, target_c + length + 1)}
+    return {(row, c) for c in range(target_c - length, target_c)}
+
+
+def _random_distractor_cells(
+    rng: random.Random,
+    *,
+    row: int,
+    rank: int,
+    shape: tuple[int, int],
+    seed: tuple[int, int],
+    input_occupied: set[tuple[int, int]],
