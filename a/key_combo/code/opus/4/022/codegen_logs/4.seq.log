+    dc_shift = _shift_value(rank)
+    templates = DISTRACTOR_SHAPES[:]
+    rng.shuffle(templates)
+    for rel in templates:
+        rel_rows = [r for r, _ in rel]
+        rel_cols = [c for _, c in rel]
