+            good = True
+            for rank in chosen_ranks:
+                options = candidates[rank][:]
+                rng.shuffle(options)
+                pick = next((opt for opt in options if opt["dir_name"] not in used_dirs), None)
+                if pick is None:
+                    good = False
+                    break
+                specs.append(pick)
+                used_dirs.add(pick["dir_name"])
+            if not good:
+                continue
+            if not any(spec["distance"] >= 3 for spec in specs):
