+
+def _ray_paths(seed: tuple[int, int], blockers: set[tuple[int, int]], shape: tuple[int, int]) -> dict[str, list[tuple[int, int]]]:
+    h, w = shape
+    rays: dict[str, list[tuple[int, int]]] = {}
