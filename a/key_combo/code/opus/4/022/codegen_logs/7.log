+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    inner = crop[1:-1, 1:-1]
+    placeholder_coords = np.argwhere((inner != bg) & (inner != frame_color))
+    assert 2 <= len(placeholder_coords) <= 3, "expected 2 or 3 placeholders"
