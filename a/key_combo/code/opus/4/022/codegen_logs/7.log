+def _candidate_positions(inner_shape: tuple[int, int], tie_mode: bool, clip_mode: bool) -> list[list[tuple[int, int]]]:
+    ih, iw = inner_shape
+    candidates: list[list[tuple[int, int]]] = []
+    if tie_mode:
+        patterns = [
+            [(0, 0), (4, 0), (1, 3)],
+            [(0, 0), (4, 0), (3, 3)],
+            [(0, 1), (4, 1), (2, 4)],
+            [(0, 3), (4, 3), (1, 0)],
+            [(0, 3), (4, 3), (3, 0)],
+        ]
+        for pattern in patterns:
+            max_r = max(r for r, _ in pattern)
+            max_c = max(c for _, c in pattern)
+            for dr in range(0, ih - max_r):
+                for dc in range(0, iw - max_c):
+                    placed = [(r + dr, c + dc) for r, c in pattern]
+                    if clip_mode and min(r for r, _ in placed) > 1 and min(c for _, c in placed) > 1:
+                        continue
+                    candidates.append(placed)
+    else:
+        patterns = [
+            [(0, 0), (1, 3)],
+            [(0, 0), (2, 3)],
+            [(0, 1), (1, 4)],
+            [(0, 0), (1, 3), (4, 1)],
+            [(0, 0), (2, 3), (4, 0)],
+            [(0, 1), (1, 4), (5, 1)],
+            [(0, 0), (2, 3), (3, 5)],
