+
+def _sample_sprites(n: int, tie_mode: bool) -> tuple[dict[int, dict], tuple[int, int], list[np.ndarray]]:
+    h, w = random.choice([(5, 4), (5, 5)]) if tie_mode else random.choice([(4, 4), (4, 5), (5, 4), (5, 5)])
+    variants = []
+    for base in _SPRITE_LIBRARY[(h, w)]:
+        variants.append(base)
+        variants.append(np.fliplr(base))
+        variants.append(np.flipud(base))
+        if h == w:
+            variants.append(np.rot90(base))
+            variants.append(np.rot90(base, 2))
+            variants.append(np.rot90(base, 3))
+    uniq = []
+    seen = set()
+    for mask in variants:
+        key = mask.tobytes()
+        if key not in seen:
+            seen.add(key)
+            uniq.append(mask.copy())
+    while True:
+        masks = random.sample(uniq, k=n)
+        if n == 1 or len({mask.tobytes() for mask in masks}) >= 2:
+            break
+    sprite_defs = {}
+    for mask in masks:
+        coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+        sprite_defs[len(sprite_defs)] = {"coords": coords, "shape": (h, w)}
+    return sprite_defs, (h, w), masks
