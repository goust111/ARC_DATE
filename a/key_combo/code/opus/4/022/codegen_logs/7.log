+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+FRAME_COLOR = 5
+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    candidates = []
+    for color in sorted(set(map(int, g.ravel())) - {bg}):
+        for coords in _components(g == color):
+            r0, c0, r1, c1 = _bbox_coords(coords)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[~border] == color):
+                continue
+            if int(np.count_nonzero(sub == color)) != int(border.sum()):
+                continue
+            candidates.append((int(color), (r0, c0, r1, c1)))
+    assert len(candidates) == 1, f"expected one frame, found {len(candidates)}"
+    return candidates[0]
+
+
+def _extract_problem(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frame_color, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)
+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    inner = crop[1:-1, 1:-1]
+    placeholder_coords = np.argwhere((inner != bg) & (inner != frame_color))
+    assert 2 <= len(placeholder_coords) <= 3, "expected 2 or 3 placeholders"
+
+    placeholders: dict[int, tuple[int, int]] = {}
+    for rr, cc in placeholder_coords:
+        color = int(inner[rr, cc])
+        assert color not in placeholders, "placeholder colors must be distinct"
+        placeholders[color] = (int(rr), int(cc))
+
+    outside_mask = np.ones(g.shape, dtype=bool)
+    outside_mask[fr0 : fr1 + 1, fc0 : fc1 + 1] = False
+
+    comps_by_color: dict[int, list[dict]] = defaultdict(list)
+    singletons: dict[tuple[int, int], int] = {}
+    for color in sorted(set(map(int, g.ravel())) - {bg, frame_color}):
+        for coords in _components((g == color) & outside_mask):
+            bbox = _bbox_coords(coords)
+            comp = {
+                "color": int(color),
+                "coords": coords,
+                "bbox": bbox,
+                "area": int(coords.shape[0]),
+            }
+            comps_by_color[int(color)].append(comp)
+            if int(coords.shape[0]) == 1:
+                singletons[(int(coords[0, 0]), int(coords[0, 1]))] = int(color)
+
+    color_map: dict[int, int] = {}
+    for src_color in sorted(placeholders):
+        tops = []
+        for comp in comps_by_color[src_color]:
+            if comp["area"] != 1:
+                continue
+            r, c = map(int, comp["coords"][0])
+            if (r + 1, c) not in singletons:
+                continue
+            tgt = singletons[(r + 1, c)]
+            if tgt in (bg, frame_color) or tgt in placeholders:
+                continue
+            tops.append((r, c, tgt))
+        assert len(tops) == 1, f"expected one legend entry for color {src_color}, found {len(tops)}"
+        color_map[src_color] = int(tops[0][2])
+    assert len(set(color_map.values())) == len(color_map), "output colors must be distinct"
+
+    sprites: dict[int, dict] = {}
+    bbox_dims = set()
+    for src_color in sorted(placeholders):
+        sprite_comps = [comp for comp in comps_by_color[src_color] if comp["area"] > 1]
+        assert len(sprite_comps) == 1, f"expected one sprite for color {src_color}, found {len(sprite_comps)}"
+        comp = sprite_comps[0]
+        r0, c0, r1, c1 = comp["bbox"]
+        rel = [(int(r - r0), int(c - c0)) for r, c in comp["coords"]]
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        bbox_dims.add((h, w))
+        sprites[src_color] = {"coords": rel, "shape": (h, w)}
+    assert len(bbox_dims) == 1, "all sprites must share the same bbox size"
+
+    return {
+        "bg": bg,
+        "frame_color": frame_color,
+        "crop": crop,
+        "inner_shape": inner.shape,
+        "placeholders": placeholders,
+        "color_map": color_map,
+        "sprites": sprites,
+    }
+
+
+def _stamp_analysis(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+) -> dict:
+    ih, iw = map(int, inner_shape)
+    placements = []
+    for color in sorted(placeholders):
+        pr, pc = placeholders[color]
+        h, w = sprites[color]["shape"]
+        ar = (h - 1) // 2
+        ac = (w - 1) // 2
+        top = int(pr - ar)
+        left = int(pc - ac)
+        kept = []
+        clipped = 0
+        full = []
+        for sr, sc in sprites[color]["coords"]:
+            rr = top + int(sr)
+            cc = left + int(sc)
+            full.append((rr, cc))
+            if 0 <= rr < ih and 0 <= cc < iw:
+                kept.append((rr, cc))
+            else:
+                clipped += 1
+        placements.append(
+            {
+                "color": int(color),
+                "placeholder": (int(pr), int(pc)),
+                "cells": kept,
+                "full_cells": full,
+                "shape": (h, w),
+                "clipped": int(clipped),
+            }
+        )
+
+    cover: dict[tuple[int, int], list[int]] = defaultdict(list)
+    for idx, placement in enumerate(placements):
+        for cell in placement["cells"]:
+            cover[cell].append(idx)
+
+    winners: dict[tuple[int, int], int] = {}
+    overlap_pairs: dict[tuple[int, int], set[int]] = defaultdict(set)
+    tie_cells = []
+    ambiguous = False
+    for cell, idxs in cover.items():
+        r, c = cell
+        costs = []
+        for idx in idxs:
+            pr, pc = placements[idx]["placeholder"]
+            dist = max(abs(r - pr), abs(c - pc))
+            costs.append((int(dist), int(pr), idx))
+        costs.sort()
+        if len(costs) > 1 and costs[0][:2] == costs[1][:2]:
+            ambiguous = True
+        winner = costs[0][2]
+        winners[cell] = winner
+        for i in range(len(idxs)):
+            for j in range(i + 1, len(idxs)):
+                a, b = sorted((idxs[i], idxs[j]))
+                overlap_pairs[(a, b)].add(winner)
+        best_dist = costs[0][0]
+        tied = [item for item in costs if item[0] == best_dist]
+        if len(tied) > 1:
+            tie_cells.append((cell, [t[2] for t in tied], winner))
+
+    unique_counts = [0 for _ in placements]
+    for idxs in cover.values():
+        if len(idxs) == 1:
+            unique_counts[idxs[0]] += 1
+
+    mixed_winner = any(len(winner_set) >= 2 for winner_set in overlap_pairs.values())
+
+    return {
+        "placements": placements,
+        "cover": cover,
+        "winners": winners,
+        "tie_cells": tie_cells,
+        "ambiguous": ambiguous,
+        "mixed_winner": mixed_winner,
+        "unique_counts": unique_counts,
+    }
+
+
+def _render_crop(problem: dict) -> np.ndarray:
+    crop = np.asarray(problem["crop"], dtype=int)
+    out = crop.copy()
+    out[1:-1, 1:-1] = problem["bg"]
+    analysis = _stamp_analysis(problem["inner_shape"], problem["placeholders"], problem["sprites"])
+    assert not analysis["ambiguous"], "valid inputs must have a unique tie-break outcome"
+    for (rr, cc), winner_idx in analysis["winners"].items():
+        src_color = analysis["placements"][winner_idx]["color"]
+        out[rr + 1, cc + 1] = int(problem["color_map"][src_color])
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Stamp recolored sprites into a grey frame and resolve overlaps by nearest placeholder.
+
+    Input structure:
+    - A black background contains one grey 1-pixel-thick rectangular frame.
+    - Inside the frame are 2 or 3 differently colored placeholder pixels.
+    - Outside the frame are one monochrome 4-connected sprite for each placeholder color and a set of vertical 2-pixel legend pairs whose top pixel is a placeholder color and bottom pixel is its output color.
+
+    Rule:
+    - Find the frame, the placeholder pixels, the matching same-color sprites, and the legend color mapping.
+    - Stamp each sprite into the frame interior by aligning the floor-centered sprite bbox center to its placeholder, then recolor that whole stamp with the legend output color.
+    - Clip stamped pixels to the frame interior; when multiple stamps cover one cell, keep the one whose placeholder is Chebyshev-nearest, breaking equal-distance ties by the smaller placeholder row.
+    - Return only the cropped frame region, with the grey border preserved and untouched interior cells left black.
+
+    Key insight:
+    - Overlap cells are not decided by stamp order; they form a placeholder-centered Voronoi partition inside the frame, while the external legend independently fixes each stamp's output color.
+    """
+    return _render_crop(_extract_problem(np.asarray(grid, dtype=int)))
+
+
+def _grow_connected_mask(h: int, w: int, area: int) -> np.ndarray:
+    while True:
+        mask = np.zeros((h, w), dtype=bool)
+        core = {(h // 2, w // 2)}
+        if h >= 2:
+            core.add((max(0, h // 2 - 1), w // 2))
+        if w >= 2:
+            core.add((h // 2, max(0, w // 2 - 1)))
+        chosen = set(random.sample(sorted(core), k=min(len(core), area)))
+        frontier = set()
+        for r, c in chosen:
+            frontier.update({(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)})
+        while len(chosen) < area and frontier:
+            options = [(r, c) for r, c in frontier if 0 <= r < h and 0 <= c < w and (r, c) not in chosen]
+            if not options:
+                break
+            cell = random.choice(options)
+            chosen.add(cell)
+            frontier.discard(cell)
+            r, c = cell
+            frontier.update({(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)})
+        if len(chosen) != area:
+            continue
+        rows = {r for r, _ in chosen}
+        cols = {c for _, c in chosen}
+        if len(rows) < 2 or len(cols) < 2:
+            continue
+        if 0 not in rows or (h - 1) not in rows or 0 not in cols or (w - 1) not in cols:
+            continue
+        for r, c in chosen:
+            mask[r, c] = True
+        return mask
+
+
+def _sample_sprites(n: int, tie_mode: bool) -> tuple[dict[int, dict], tuple[int, int], list[np.ndarray]]:
+    while True:
+        if tie_mode:
+            h, w = random.choice([(5, 4), (5, 5)])
+        else:
+            h, w = random.choice([(4, 4), (4, 5), (5, 4), (5, 5)])
+        masks = []
+        for _ in range(n):
+            area = random.randint(6, min(8, h * w - 1))
+            masks.append(_grow_connected_mask(h, w, area))
+        shape_keys = {mask.tobytes() for mask in masks}
+        if n == 1 or len(shape_keys) >= 2:
+            break
+    sprite_defs = {}
+    for mask in masks:
+        coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+        sprite_defs[len(sprite_defs)] = {"coords": coords, "shape": (h, w)}
+    return sprite_defs, (h, w), masks
+
+
+def _candidate_positions(inner_shape: tuple[int, int], tie_mode: bool, clip_mode: bool) -> list[list[tuple[int, int]]]:
+    ih, iw = inner_shape
+    candidates: list[list[tuple[int, int]]] = []
+    if tie_mode:
+        patterns = [
+            [(0, 0), (4, 0), (1, 3)],
+            [(0, 0), (4, 0), (3, 3)],
+            [(0, 1), (4, 1), (2, 4)],
+            [(0, 3), (4, 3), (1, 0)],
+            [(0, 3), (4, 3), (3, 0)],
+        ]
+        for pattern in patterns:
+            max_r = max(r for r, _ in pattern)
+            max_c = max(c for _, c in pattern)
+            for dr in range(0, ih - max_r):
+                for dc in range(0, iw - max_c):
+                    placed = [(r + dr, c + dc) for r, c in pattern]
+                    if clip_mode and min(r for r, _ in placed) > 1 and min(c for _, c in placed) > 1:
+                        continue
+                    candidates.append(placed)
+    else:
+        patterns = [
+            [(0, 0), (1, 3)],
+            [(0, 0), (2, 3)],
+            [(0, 1), (1, 4)],
+            [(0, 0), (1, 3), (4, 1)],
+            [(0, 0), (2, 3), (4, 0)],
+            [(0, 1), (1, 4), (5, 1)],
+            [(0, 0), (2, 3), (3, 5)],
+        ]
+        for pattern in patterns:
+            max_r = max(r for r, _ in pattern)
+            max_c = max(c for _, c in pattern)
+            for dr in range(0, ih - max_r):
+                for dc in range(0, iw - max_c):
+                    placed = [(r + dr, c + dc) for r, c in pattern]
+                    if clip_mode and min(r for r, _ in placed) > 1 and min(c for _, c in placed) > 1:
+                        continue
+                    candidates.append(placed)
+    random.shuffle(candidates)
+    return candidates
+
+
+def _render_input_grid(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+    color_map: dict[int, int],
+) -> np.ndarray | None:
+    ih, iw = inner_shape
+    frame_h = ih + 2
+    frame_w = iw + 2
+    margin = max(6, max(max(sprite["shape"]) for sprite in sprites.values()) + 3)
+    grid_h = min(30, frame_h + margin * 2 + random.randint(0, 2))
+    grid_w = min(30, frame_w + margin * 2 + random.randint(0, 2))
+    if grid_h <= frame_h + 4 or grid_w <= frame_w + 4:
+        return None
+
+    g = np.zeros((grid_h, grid_w), dtype=int)
+    fr0 = random.randint(2, grid_h - frame_h - 2)
+    fc0 = random.randint(2, grid_w - frame_w - 2)
+    g[fr0 : fr0 + frame_h, fc0 : fc0 + frame_w] = BACKGROUND
+    g[fr0, fc0 : fc0 + frame_w] = FRAME_COLOR
+    g[fr0 + frame_h - 1, fc0 : fc0 + frame_w] = FRAME_COLOR
+    g[fr0 : fr0 + frame_h, fc0] = FRAME_COLOR
+    g[fr0 : fr0 + frame_h, fc0 + frame_w - 1] = FRAME_COLOR
+
+    for color, (rr, cc) in placeholders.items():
+        g[fr0 + 1 + rr, fc0 + 1 + cc] = int(color)
+
+    occupied = np.zeros_like(g, dtype=bool)
+    pad = 1
+    r0 = max(0, fr0 - pad)
+    c0 = max(0, fc0 - pad)
+    r1 = min(grid_h, fr0 + frame_h + pad)
+    c1 = min(grid_w, fc0 + frame_w + pad)
+    occupied[r0:r1, c0:c1] = True
+
+    def place_rect(h: int, w: int) -> tuple[int, int] | None:
+        spots = []
+        for rr in range(1, grid_h - h - 1):
+            for cc in range(1, grid_w - w - 1):
+                if occupied[rr - 1 : rr + h + 1, cc - 1 : cc + w + 1].any():
+                    continue
+                spots.append((rr, cc))
+        if not spots:
+            return None
+        rr, cc = random.choice(spots)
+        occupied[rr - 1 : rr + h + 1, cc - 1 : cc + w + 1] = True
+        return rr, cc
+
+    order = list(placeholders)
+    random.shuffle(order)
+    for color in order:
+        sh, sw = sprites[color]["shape"]
+        pos = place_rect(sh, sw)
+        if pos is None:
+            return None
+        rr, cc = pos
+        for dr, dc in sprites[color]["coords"]:
+            g[rr + dr, cc + dc] = int(color)
+
+    legend_order = list(placeholders)
+    random.shuffle(legend_order)
+    for color in legend_order:
+        pos = place_rect(2, 1)
+        if pos is None:
+            return None
+        rr, cc = pos
+        g[rr, cc] = int(color)
+        g[rr + 1, cc] = int(color_map[color])
+
+    return g
+
+
+def _build_expected(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+    color_map: dict[int, int],
+) -> tuple[np.ndarray, dict]:
+    problem = {
+        "bg": BACKGROUND,
+        "frame_color": FRAME_COLOR,
+        "crop": np.pad(np.zeros(inner_shape, dtype=int), 1, constant_values=FRAME_COLOR),
+        "inner_shape": inner_shape,
+        "placeholders": placeholders,
+        "color_map": color_map,
+        "sprites": sprites,
+    }
+    analysis = _stamp_analysis(inner_shape, placeholders, sprites)
+    out = np.full((inner_shape[0] + 2, inner_shape[1] + 2), FRAME_COLOR, dtype=int)
+    out[1:-1, 1:-1] = BACKGROUND
+    if analysis["ambiguous"]:
+        return out, analysis
+    for (rr, cc), winner_idx in analysis["winners"].items():
+        src = analysis["placements"][winner_idx]["color"]
+        out[rr + 1, cc + 1] = int(color_map[src])
+    return out, analysis
+
+
+def _valid_semantics(
+    analysis: dict,
+    tie_mode: bool,
+    clip_mode: bool,
+) -> bool:
+    if analysis["ambiguous"]:
+        return False
+    if not any(len(idxs) >= 2 for idxs in analysis["cover"].values()):
+        return False
+    if min(analysis["unique_counts"]) < 2:
+        return False
+    if not (analysis["mixed_winner"] or analysis["tie_cells"]):
+        return False
+    if tie_mode and not analysis["tie_cells"]:
+        return False
+    if clip_mode and not any(p["clipped"] > 0 for p in analysis["placements"]):
+        return False
+    overlap_area = sum(1 for idxs in analysis["cover"].values() if len(idxs) >= 2)
+    painted_area = len(analysis["cover"])
+    if overlap_area * 3 > painted_area * 2:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    tie_mode = random.random() < 0.4
+    clip_mode = random.random() < 0.4
+    inner_shape = (random.randint(8, 11), random.randint(8, 11))
+
+    n = 3 if tie_mode else random.choice([2, 3])
+    placeholder_colors = random.sample(PALETTE, n)
+    output_colors = random.sample([c for c in PALETTE if c not in placeholder_colors], n)
+    color_map = {src: tgt for src, tgt in zip(placeholder_colors, output_colors)}
+
+    raw_sprites, _shape, _masks = _sample_sprites(n, tie_mode)
+    sprites = {
+        color: {"coords": raw_sprites[i]["coords"], "shape": raw_sprites[i]["shape"]}
+        for i, color in enumerate(placeholder_colors)
+    }
+
+    for pos_list in _candidate_positions(inner_shape, tie_mode, clip_mode):
+        if len(pos_list) != n:
+            continue
+        rows = [r for r, _ in pos_list]
+        if len(set(rows)) != len(rows):
+            continue
+        ok = True
+        for i in range(n):
+            for j in range(i + 1, n):
+                dist = max(abs(pos_list[i][0] - pos_list[j][0]), abs(pos_list[i][1] - pos_list[j][1]))
+                if not (3 <= dist <= 5):
+                    ok = False
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        placeholders = {color: tuple(pos_list[i]) for i, color in enumerate(placeholder_colors)}
+        expected, analysis = _build_expected(inner_shape, placeholders, sprites, color_map)
+        if not _valid_semantics(analysis, tie_mode=tie_mode, clip_mode=clip_mode):
+            continue
+
+        naive_sorted = sorted(analysis["placements"], key=lambda p: p["placeholder"][0])
+        order_map = {p["color"]: idx for idx, p in enumerate(naive_sorted)}
+        wrong = np.full_like(expected, FRAME_COLOR)
+        wrong[1:-1, 1:-1] = BACKGROUND
+        paint_order = sorted(analysis["placements"], key=lambda p: order_map[p["color"]])
+        for placement in paint_order:
+            out_color = color_map[placement["color"]]
+            for rr, cc in placement["cells"]:
+                wrong[rr + 1, cc + 1] = out_color
+        if np.array_equal(wrong, expected):
+            continue
+
+        grid = _render_input_grid(inner_shape, placeholders, sprites, color_map)
+        if grid is None:
+            continue
+        try:
+            solved = main(grid)
+        except Exception:
+            continue
+        if not np.array_equal(solved, expected):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to build a valid instance")

diff --git a/arc_task_022_7.py b/arc_task_022_7.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e5c87e0868725ba1068de0672b71fddd353347d
--- /dev/null
+++ b/arc_task_022_7.py
@@ -0,0 +1,554 @@
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+FRAME_COLOR = 5
+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    candidates = []
+    for color in sorted(set(map(int, g.ravel())) - {bg}):
+        for coords in _components(g == color):
+            r0, c0, r1, c1 = _bbox_coords(coords)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[~border] == color):
+                continue
+            if int(np.count_nonzero(sub == color)) != int(border.sum()):
+                continue
+            candidates.append((int(color), (r0, c0, r1, c1)))
+    assert len(candidates) == 1, f"expected one frame, found {len(candidates)}"
+    return candidates[0]
+
+
+def _extract_problem(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frame_color, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)
+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    inner = crop[1:-1, 1:-1]
+    placeholder_coords = np.argwhere((inner != bg) & (inner != frame_color))
+    assert 2 <= len(placeholder_coords) <= 3, "expected 2 or 3 placeholders"
+
+    placeholders: dict[int, tuple[int, int]] = {}
+    for rr, cc in placeholder_coords:
+        color = int(inner[rr, cc])
+        assert color not in placeholders, "placeholder colors must be distinct"
+        placeholders[color] = (int(rr), int(cc))
+
+    outside_mask = np.ones(g.shape, dtype=bool)
+    outside_mask[fr0 : fr1 + 1, fc0 : fc1 + 1] = False
+
+    comps_by_color: dict[int, list[dict]] = defaultdict(list)
+    singletons: dict[tuple[int, int], int] = {}
+    for color in sorted(set(map(int, g.ravel())) - {bg, frame_color}):
+        for coords in _components((g == color) & outside_mask):
+            bbox = _bbox_coords(coords)
+            comp = {
+                "color": int(color),
+                "coords": coords,
+                "bbox": bbox,
+                "area": int(coords.shape[0]),
+            }
+            comps_by_color[int(color)].append(comp)
+            if int(coords.shape[0]) == 1:
+                singletons[(int(coords[0, 0]), int(coords[0, 1]))] = int(color)
+
+    color_map: dict[int, int] = {}
+    for src_color in sorted(placeholders):
+        tops = []
+        for comp in comps_by_color[src_color]:
+            if comp["area"] != 1:
+                continue
+            r, c = map(int, comp["coords"][0])
+            if (r + 1, c) not in singletons:
+                continue
+            tgt = singletons[(r + 1, c)]
+            if tgt in (bg, frame_color) or tgt in placeholders:
+                continue
+            tops.append((r, c, tgt))
+        assert len(tops) == 1, f"expected one legend entry for color {src_color}, found {len(tops)}"
+        color_map[src_color] = int(tops[0][2])
+    assert len(set(color_map.values())) == len(color_map), "output colors must be distinct"
+
+    sprites: dict[int, dict] = {}
+    bbox_dims = set()
+    for src_color in sorted(placeholders):
+        sprite_comps = [comp for comp in comps_by_color[src_color] if comp["area"] > 1]
+        assert len(sprite_comps) == 1, f"expected one sprite for color {src_color}, found {len(sprite_comps)}"
+        comp = sprite_comps[0]
+        r0, c0, r1, c1 = comp["bbox"]
+        rel = [(int(r - r0), int(c - c0)) for r, c in comp["coords"]]
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
+        bbox_dims.add((h, w))
+        sprites[src_color] = {"coords": rel, "shape": (h, w)}
+    assert len(bbox_dims) == 1, "all sprites must share the same bbox size"
+
+    return {
+        "bg": bg,
+        "frame_color": frame_color,
+        "crop": crop,
+        "inner_shape": inner.shape,
+        "placeholders": placeholders,
+        "color_map": color_map,
+        "sprites": sprites,
+    }
+
+
+def _stamp_analysis(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+) -> dict:
+    ih, iw = map(int, inner_shape)
+    placements = []
+    for color in sorted(placeholders):
+        pr, pc = placeholders[color]
+        h, w = sprites[color]["shape"]
+        ar = (h - 1) // 2
+        ac = (w - 1) // 2
+        top = int(pr - ar)
+        left = int(pc - ac)
+        kept = []
+        clipped = 0
+        full = []
+        for sr, sc in sprites[color]["coords"]:
+            rr = top + int(sr)
+            cc = left + int(sc)
+            full.append((rr, cc))
+            if 0 <= rr < ih and 0 <= cc < iw:
+                kept.append((rr, cc))
+            else:
+                clipped += 1
+        placements.append(
+            {
+                "color": int(color),
+                "placeholder": (int(pr), int(pc)),
+                "cells": kept,
+                "full_cells": full,
+                "shape": (h, w),
+                "clipped": int(clipped),
+            }
+        )
+
+    cover: dict[tuple[int, int], list[int]] = defaultdict(list)
+    for idx, placement in enumerate(placements):
+        for cell in placement["cells"]:
+            cover[cell].append(idx)
+
+    winners: dict[tuple[int, int], int] = {}
+    overlap_pairs: dict[tuple[int, int], set[int]] = defaultdict(set)
+    tie_cells = []
+    ambiguous = False
+    for cell, idxs in cover.items():
+        r, c = cell
+        costs = []
+        for idx in idxs:
+            pr, pc = placements[idx]["placeholder"]
+            dist = max(abs(r - pr), abs(c - pc))
+            costs.append((int(dist), int(pr), idx))
+        costs.sort()
+        if len(costs) > 1 and costs[0][:2] == costs[1][:2]:
+            ambiguous = True
+        winner = costs[0][2]
+        winners[cell] = winner
+        for i in range(len(idxs)):
+            for j in range(i + 1, len(idxs)):
+                a, b = sorted((idxs[i], idxs[j]))
+                overlap_pairs[(a, b)].add(winner)
+        best_dist = costs[0][0]
+        tied = [item for item in costs if item[0] == best_dist]
+        if len(tied) > 1:
+            tie_cells.append((cell, [t[2] for t in tied], winner))
+
+    unique_counts = [0 for _ in placements]
+    for idxs in cover.values():
+        if len(idxs) == 1:
+            unique_counts[idxs[0]] += 1
+
+    mixed_winner = any(len(winner_set) >= 2 for winner_set in overlap_pairs.values())
+
+    return {
+        "placements": placements,
+        "cover": cover,
+        "winners": winners,
+        "tie_cells": tie_cells,
+        "ambiguous": ambiguous,
+        "mixed_winner": mixed_winner,
+        "unique_counts": unique_counts,
+    }
+
+
+def _render_crop(problem: dict) -> np.ndarray:
+    crop = np.asarray(problem["crop"], dtype=int)
+    out = crop.copy()
+    out[1:-1, 1:-1] = problem["bg"]
+    analysis = _stamp_analysis(problem["inner_shape"], problem["placeholders"], problem["sprites"])
+    assert not analysis["ambiguous"], "valid inputs must have a unique tie-break outcome"
+    for (rr, cc), winner_idx in analysis["winners"].items():
+        src_color = analysis["placements"][winner_idx]["color"]
+        out[rr + 1, cc + 1] = int(problem["color_map"][src_color])
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Stamp recolored sprites into a grey frame and resolve overlaps by nearest placeholder.
+
+    Input structure:
+    - A black background contains one grey 1-pixel-thick rectangular frame.
+    - Inside the frame are 2 or 3 differently colored placeholder pixels.
+    - Outside the frame are one monochrome 4-connected sprite for each placeholder color and a set of vertical 2-pixel legend pairs whose top pixel is a placeholder color and bottom pixel is its output color.
+
+    Rule:
+    - Find the frame, the placeholder pixels, the matching same-color sprites, and the legend color mapping.
+    - Stamp each sprite into the frame interior by aligning the floor-centered sprite bbox center to its placeholder, then recolor that whole stamp with the legend output color.
+    - Clip stamped pixels to the frame interior; when multiple stamps cover one cell, keep the one whose placeholder is Chebyshev-nearest, breaking equal-distance ties by the smaller placeholder row.
+    - Return only the cropped frame region, with the grey border preserved and untouched interior cells left black.
+
+    Key insight:
+    - Overlap cells are not decided by stamp order; they form a placeholder-centered Voronoi partition inside the frame, while the external legend independently fixes each stamp's output color.
+    """
+    return _render_crop(_extract_problem(np.asarray(grid, dtype=int)))
+
+
+def _grow_connected_mask(h: int, w: int, area: int) -> np.ndarray:
+    while True:
+        mask = np.zeros((h, w), dtype=bool)
+        core = {(h // 2, w // 2)}
+        if h >= 2:
+            core.add((max(0, h // 2 - 1), w // 2))
+        if w >= 2:
+            core.add((h // 2, max(0, w // 2 - 1)))
+        chosen = set(random.sample(sorted(core), k=min(len(core), area)))
+        frontier = set()
+        for r, c in chosen:
+            frontier.update({(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)})
+        while len(chosen) < area and frontier:
+            options = [(r, c) for r, c in frontier if 0 <= r < h and 0 <= c < w and (r, c) not in chosen]
+            if not options:
+                break
+            cell = random.choice(options)
+            chosen.add(cell)
+            frontier.discard(cell)
+            r, c = cell
+            frontier.update({(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)})
+        if len(chosen) != area:
+            continue
+        rows = {r for r, _ in chosen}
+        cols = {c for _, c in chosen}
+        if len(rows) < 2 or len(cols) < 2:
+            continue
+        if 0 not in rows or (h - 1) not in rows or 0 not in cols or (w - 1) not in cols:
+            continue
+        for r, c in chosen:
+            mask[r, c] = True
+        return mask
+
+
+def _sample_sprites(n: int, tie_mode: bool) -> tuple[dict[int, dict], tuple[int, int], list[np.ndarray]]:
+    while True:
+        if tie_mode:
+            h, w = random.choice([(5, 4), (5, 5)])
+        else:
+            h, w = random.choice([(4, 4), (4, 5), (5, 4), (5, 5)])
+        masks = []
+        for _ in range(n):
+            area = random.randint(6, min(8, h * w - 1))
+            masks.append(_grow_connected_mask(h, w, area))
+        shape_keys = {mask.tobytes() for mask in masks}
+        if n == 1 or len(shape_keys) >= 2:
+            break
+    sprite_defs = {}
+    for mask in masks:
+        coords = [(int(r), int(c)) for r, c in np.argwhere(mask)]
+        sprite_defs[len(sprite_defs)] = {"coords": coords, "shape": (h, w)}
+    return sprite_defs, (h, w), masks
+
+
+def _candidate_positions(inner_shape: tuple[int, int], tie_mode: bool, clip_mode: bool) -> list[list[tuple[int, int]]]:
+    ih, iw = inner_shape
+    candidates: list[list[tuple[int, int]]] = []
+    if tie_mode:
+        patterns = [
+            [(0, 0), (4, 0), (1, 3)],
+            [(0, 0), (4, 0), (3, 3)],
+            [(0, 1), (4, 1), (2, 4)],
+            [(0, 3), (4, 3), (1, 0)],
+            [(0, 3), (4, 3), (3, 0)],
+        ]
+        for pattern in patterns:
+            max_r = max(r for r, _ in pattern)
+            max_c = max(c for _, c in pattern)
+            for dr in range(0, ih - max_r):
+                for dc in range(0, iw - max_c):
+                    placed = [(r + dr, c + dc) for r, c in pattern]
+                    if clip_mode and min(r for r, _ in placed) > 1 and min(c for _, c in placed) > 1:
+                        continue
+                    candidates.append(placed)
+    else:
+        patterns = [
+            [(0, 0), (1, 3)],
+            [(0, 0), (2, 3)],
+            [(0, 1), (1, 4)],
+            [(0, 0), (1, 3), (4, 1)],
+            [(0, 0), (2, 3), (4, 0)],
+            [(0, 1), (1, 4), (5, 1)],
+            [(0, 0), (2, 3), (3, 5)],
+        ]
+        for pattern in patterns:
+            max_r = max(r for r, _ in pattern)
+            max_c = max(c for _, c in pattern)
+            for dr in range(0, ih - max_r):
+                for dc in range(0, iw - max_c):
+                    placed = [(r + dr, c + dc) for r, c in pattern]
+                    if clip_mode and min(r for r, _ in placed) > 1 and min(c for _, c in placed) > 1:
+                        continue
+                    candidates.append(placed)
+    random.shuffle(candidates)
+    return candidates
+
+
+def _render_input_grid(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+    color_map: dict[int, int],
+) -> np.ndarray | None:
+    ih, iw = inner_shape
+    frame_h = ih + 2
+    frame_w = iw + 2
+    margin = max(6, max(max(sprite["shape"]) for sprite in sprites.values()) + 3)
+    grid_h = min(30, frame_h + margin * 2 + random.randint(0, 2))
+    grid_w = min(30, frame_w + margin * 2 + random.randint(0, 2))
+    if grid_h <= frame_h + 4 or grid_w <= frame_w + 4:
+        return None
+
+    g = np.zeros((grid_h, grid_w), dtype=int)
+    fr0 = random.randint(2, grid_h - frame_h - 2)
+    fc0 = random.randint(2, grid_w - frame_w - 2)
+    g[fr0 : fr0 + frame_h, fc0 : fc0 + frame_w] = BACKGROUND
+    g[fr0, fc0 : fc0 + frame_w] = FRAME_COLOR
+    g[fr0 + frame_h - 1, fc0 : fc0 + frame_w] = FRAME_COLOR
+    g[fr0 : fr0 + frame_h, fc0] = FRAME_COLOR
+    g[fr0 : fr0 + frame_h, fc0 + frame_w - 1] = FRAME_COLOR
+
+    for color, (rr, cc) in placeholders.items():
+        g[fr0 + 1 + rr, fc0 + 1 + cc] = int(color)
+
+    occupied = np.zeros_like(g, dtype=bool)
+    pad = 1
+    r0 = max(0, fr0 - pad)
+    c0 = max(0, fc0 - pad)
+    r1 = min(grid_h, fr0 + frame_h + pad)
+    c1 = min(grid_w, fc0 + frame_w + pad)
+    occupied[r0:r1, c0:c1] = True
+
+    def place_rect(h: int, w: int) -> tuple[int, int] | None:
+        spots = []
+        for rr in range(1, grid_h - h - 1):
+            for cc in range(1, grid_w - w - 1):
+                if occupied[rr - 1 : rr + h + 1, cc - 1 : cc + w + 1].any():
+                    continue
+                spots.append((rr, cc))
+        if not spots:
+            return None
+        rr, cc = random.choice(spots)
+        occupied[rr - 1 : rr + h + 1, cc - 1 : cc + w + 1] = True
+        return rr, cc
+
+    order = list(placeholders)
+    random.shuffle(order)
+    for color in order:
+        sh, sw = sprites[color]["shape"]
+        pos = place_rect(sh, sw)
+        if pos is None:
+            return None
+        rr, cc = pos
+        for dr, dc in sprites[color]["coords"]:
+            g[rr + dr, cc + dc] = int(color)
+
+    legend_order = list(placeholders)
+    random.shuffle(legend_order)
+    for color in legend_order:
+        pos = place_rect(2, 1)
+        if pos is None:
+            return None
+        rr, cc = pos
+        g[rr, cc] = int(color)
+        g[rr + 1, cc] = int(color_map[color])
+
+    return g
+
+
+def _build_expected(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+    color_map: dict[int, int],
+) -> tuple[np.ndarray, dict]:
+    problem = {
+        "bg": BACKGROUND,
+        "frame_color": FRAME_COLOR,
+        "crop": np.pad(np.zeros(inner_shape, dtype=int), 1, constant_values=FRAME_COLOR),
+        "inner_shape": inner_shape,
+        "placeholders": placeholders,
+        "color_map": color_map,
+        "sprites": sprites,
+    }
+    analysis = _stamp_analysis(inner_shape, placeholders, sprites)
+    out = np.full((inner_shape[0] + 2, inner_shape[1] + 2), FRAME_COLOR, dtype=int)
+    out[1:-1, 1:-1] = BACKGROUND
+    if analysis["ambiguous"]:
+        return out, analysis
+    for (rr, cc), winner_idx in analysis["winners"].items():
+        src = analysis["placements"][winner_idx]["color"]
+        out[rr + 1, cc + 1] = int(color_map[src])
+    return out, analysis
+
+
+def _valid_semantics(
+    analysis: dict,
+    tie_mode: bool,
+    clip_mode: bool,
+) -> bool:
+    if analysis["ambiguous"]:
+        return False
+    if not any(len(idxs) >= 2 for idxs in analysis["cover"].values()):
+        return False
+    if min(analysis["unique_counts"]) < 2:
+        return False
+    if not (analysis["mixed_winner"] or analysis["tie_cells"]):
+        return False
+    if tie_mode and not analysis["tie_cells"]:
+        return False
+    if clip_mode and not any(p["clipped"] > 0 for p in analysis["placements"]):
+        return False
+    overlap_area = sum(1 for idxs in analysis["cover"].values() if len(idxs) >= 2)
+    painted_area = len(analysis["cover"])
+    if overlap_area * 3 > painted_area * 2:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    tie_mode = random.random() < 0.4
+    clip_mode = random.random() < 0.4
+    inner_shape = (random.randint(8, 11), random.randint(8, 11))
+
+    n = 3 if tie_mode else random.choice([2, 3])
+    placeholder_colors = random.sample(PALETTE, n)
+    output_colors = random.sample([c for c in PALETTE if c not in placeholder_colors], n)
+    color_map = {src: tgt for src, tgt in zip(placeholder_colors, output_colors)}
+
+    raw_sprites, _shape, _masks = _sample_sprites(n, tie_mode)
+    sprites = {
+        color: {"coords": raw_sprites[i]["coords"], "shape": raw_sprites[i]["shape"]}
+        for i, color in enumerate(placeholder_colors)
+    }
+
+    for pos_list in _candidate_positions(inner_shape, tie_mode, clip_mode):
+        if len(pos_list) != n:
+            continue
+        rows = [r for r, _ in pos_list]
+        if len(set(rows)) != len(rows):
+            continue
+        ok = True
+        for i in range(n):
+            for j in range(i + 1, n):
+                dist = max(abs(pos_list[i][0] - pos_list[j][0]), abs(pos_list[i][1] - pos_list[j][1]))
+                if not (3 <= dist <= 5):
+                    ok = False
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        placeholders = {color: tuple(pos_list[i]) for i, color in enumerate(placeholder_colors)}
+        expected, analysis = _build_expected(inner_shape, placeholders, sprites, color_map)
+        if not _valid_semantics(analysis, tie_mode=tie_mode, clip_mode=clip_mode):
+            continue
+
+        naive_sorted = sorted(analysis["placements"], key=lambda p: p["placeholder"][0])
+        order_map = {p["color"]: idx for idx, p in enumerate(naive_sorted)}
+        wrong = np.full_like(expected, FRAME_COLOR)
+        wrong[1:-1, 1:-1] = BACKGROUND
+        paint_order = sorted(analysis["placements"], key=lambda p: order_map[p["color"]])
+        for placement in paint_order:
+            out_color = color_map[placement["color"]]
+            for rr, cc in placement["cells"]:
+                wrong[rr + 1, cc + 1] = out_color
+        if np.array_equal(wrong, expected):
+            continue
+
+        grid = _render_input_grid(inner_shape, placeholders, sprites, color_map)
+        if grid is None:
+            continue
+        try:
+            solved = main(grid)
+        except Exception:
+            continue
+        if not np.array_equal(solved, expected):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to build a valid instance")

diff --git a/arc_task_022_7.py b/arc_task_022_7.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e5c87e0868725ba1068de0672b71fddd353347d
--- /dev/null
+++ b/arc_task_022_7.py
@@ -0,0 +1,554 @@
+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+FRAME_COLOR = 5
+BACKGROUND = 0
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    candidates = []
+    for color in sorted(set(map(int, g.ravel())) - {bg}):
+        for coords in _components(g == color):
+            r0, c0, r1, c1 = _bbox_coords(coords)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[~border] == color):
+                continue
+            if int(np.count_nonzero(sub == color)) != int(border.sum()):
+                continue
+            candidates.append((int(color), (r0, c0, r1, c1)))
+    assert len(candidates) == 1, f"expected one frame, found {len(candidates)}"
+    return candidates[0]
+
+
+def _extract_problem(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frame_color, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)
+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    inner = crop[1:-1, 1:-1]
+    placeholder_coords = np.argwhere((inner != bg) & (inner != frame_color))
+    assert 2 <= len(placeholder_coords) <= 3, "expected 2 or 3 placeholders"
+
+    placeholders: dict[int, tuple[int, int]] = {}
+    for rr, cc in placeholder_coords:
+        color = int(inner[rr, cc])
+        assert color not in placeholders, "placeholder colors must be distinct"
+        placeholders[color] = (int(rr), int(cc))
+
+    outside_mask = np.ones(g.shape, dtype=bool)
+    outside_mask[fr0 : fr1 + 1, fc0 : fc1 + 1] = False
+
