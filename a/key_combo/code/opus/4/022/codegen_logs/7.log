+                continue
+            tops.append((r, c, tgt))
+        assert len(tops) == 1, f"expected one legend entry for color {src_color}, found {len(tops)}"
+        color_map[src_color] = int(tops[0][2])
+    assert len(set(color_map.values())) == len(color_map), "output colors must be distinct"
