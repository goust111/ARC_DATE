+
+def _extract_problem(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frame_color, (fr0, fc0, fr1, fc1) = _find_frame(g, bg)
+    crop = g[fr0 : fr1 + 1, fc0 : fc1 + 1]
+    inner = crop[1:-1, 1:-1]
+    placeholder_coords = np.argwhere((inner != bg) & (inner != frame_color))
+    assert 2 <= len(placeholder_coords) <= 3, "expected 2 or 3 placeholders"
+
+    placeholders: dict[int, tuple[int, int]] = {}
+    for rr, cc in placeholder_coords:
+        color = int(inner[rr, cc])
+        assert color not in placeholders, "placeholder colors must be distinct"
+        placeholders[color] = (int(rr), int(cc))
+
+    outside_mask = np.ones(g.shape, dtype=bool)
+    outside_mask[fr0 : fr1 + 1, fc0 : fc1 + 1] = False
+
+    comps_by_color: dict[int, list[dict]] = defaultdict(list)
+    singletons: dict[tuple[int, int], int] = {}
+    for color in sorted(set(map(int, g.ravel())) - {bg, frame_color}):
+        for coords in _components((g == color) & outside_mask):
+            bbox = _bbox_coords(coords)
+            comp = {
+                "color": int(color),
+                "coords": coords,
+                "bbox": bbox,
+                "area": int(coords.shape[0]),
+            }
+            comps_by_color[int(color)].append(comp)
+            if int(coords.shape[0]) == 1:
+                singletons[(int(coords[0, 0]), int(coords[0, 1]))] = int(color)
+
+    color_map: dict[int, int] = {}
+    for src_color in sorted(placeholders):
+        tops = []
+        for comp in comps_by_color[src_color]:
+            if comp["area"] != 1:
+                continue
+            r, c = map(int, comp["coords"][0])
+            if (r + 1, c) not in singletons:
+                continue
+            tgt = singletons[(r + 1, c)]
+            if tgt in (bg, frame_color) or tgt in placeholders:
+                continue
+            tops.append((r, c, tgt))
+        assert len(tops) == 1, f"expected one legend entry for color {src_color}, found {len(tops)}"
+        color_map[src_color] = int(tops[0][2])
+    assert len(set(color_map.values())) == len(color_map), "output colors must be distinct"
