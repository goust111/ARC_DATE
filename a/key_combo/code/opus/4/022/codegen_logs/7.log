+def _render_input_grid(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+    color_map: dict[int, int],
+) -> np.ndarray | None:
+    ih, iw = inner_shape
+    frame_h = ih + 2
+    frame_w = iw + 2
+    margin = max(6, max(max(sprite["shape"]) for sprite in sprites.values()) + 3)
+    grid_h = min(30, frame_h + margin * 2 + random.randint(0, 2))
+    grid_w = min(30, frame_w + margin * 2 + random.randint(0, 2))
+    if grid_h <= frame_h + 4 or grid_w <= frame_w + 4:
+        return None
+
+    g = np.zeros((grid_h, grid_w), dtype=int)
+    fr0 = random.randint(2, grid_h - frame_h - 2)
+    fc0 = random.randint(2, grid_w - frame_w - 2)
+    g[fr0 : fr0 + frame_h, fc0 : fc0 + frame_w] = BACKGROUND
+    g[fr0, fc0 : fc0 + frame_w] = FRAME_COLOR
+    g[fr0 + frame_h - 1, fc0 : fc0 + frame_w] = FRAME_COLOR
+    g[fr0 : fr0 + frame_h, fc0] = FRAME_COLOR
+    g[fr0 : fr0 + frame_h, fc0 + frame_w - 1] = FRAME_COLOR
+
+    for color, (rr, cc) in placeholders.items():
+        g[fr0 + 1 + rr, fc0 + 1 + cc] = int(color)
+
+    occupied = np.zeros_like(g, dtype=bool)
+    pad = 1
+    r0 = max(0, fr0 - pad)
+    c0 = max(0, fc0 - pad)
