+        assert len(sprite_comps) == 1, f"expected one sprite for color {src_color}, found {len(sprite_comps)}"
+        comp = sprite_comps[0]
+        r0, c0, r1, c1 = comp["bbox"]
+        rel = [(int(r - r0), int(c - c0)) for r, c in comp["coords"]]
+        h = int(r1 - r0 + 1)
+        w = int(c1 - c0 + 1)
