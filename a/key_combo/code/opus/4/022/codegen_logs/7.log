+    random.shuffle(legend_order)
+    for color in legend_order:
+        pos = place_rect(2, 1)
+        if pos is None:
+            return None
+        rr, cc = pos
+        g[rr, cc] = int(color)
+        g[rr + 1, cc] = int(color_map[color])
+
+    return g
+
+
+def _build_expected(
+    inner_shape: tuple[int, int],
+    placeholders: dict[int, tuple[int, int]],
+    sprites: dict[int, dict],
+    color_map: dict[int, int],
+) -> tuple[np.ndarray, dict]:
+    problem = {
+        "bg": BACKGROUND,
+        "frame_color": FRAME_COLOR,
+        "crop": np.pad(np.zeros(inner_shape, dtype=int), 1, constant_values=FRAME_COLOR),
+        "inner_shape": inner_shape,
+        "placeholders": placeholders,
+        "color_map": color_map,
+        "sprites": sprites,
+    }
+    analysis = _stamp_analysis(inner_shape, placeholders, sprites)
+    out = np.full((inner_shape[0] + 2, inner_shape[1] + 2), FRAME_COLOR, dtype=int)
+    out[1:-1, 1:-1] = BACKGROUND
+    if analysis["ambiguous"]:
+        return out, analysis
+    for (rr, cc), winner_idx in analysis["winners"].items():
+        src = analysis["placements"][winner_idx]["color"]
+        out[rr + 1, cc + 1] = int(color_map[src])
+    return out, analysis
+
+
+def _valid_semantics(
+    analysis: dict,
+    tie_mode: bool,
+    clip_mode: bool,
+) -> bool:
+    if analysis["ambiguous"]:
+        return False
+    if not any(len(idxs) >= 2 for idxs in analysis["cover"].values()):
+        return False
+    if min(analysis["unique_counts"]) < 2:
+        return False
+    if not (analysis["mixed_winner"] or analysis["tie_cells"]):
+        return False
+    if tie_mode and not analysis["tie_cells"]:
+        return False
+    if clip_mode and not any(p["clipped"] > 0 for p in analysis["placements"]):
+        return False
+    overlap_area = sum(1 for idxs in analysis["cover"].values() if len(idxs) >= 2)
+    painted_area = len(analysis["cover"])
+    if overlap_area * 3 > painted_area * 2:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    tie_mode = random.random() < 0.4
+    clip_mode = random.random() < 0.4
+    inner_shape = (random.randint(8, 11), random.randint(8, 11))
+
+    n = 3 if tie_mode else random.choice([2, 3])
+    placeholder_colors = random.sample(PALETTE, n)
+    output_colors = random.sample([c for c in PALETTE if c not in placeholder_colors], n)
+    color_map = {src: tgt for src, tgt in zip(placeholder_colors, output_colors)}
+
+    raw_sprites, _shape, _masks = _sample_sprites(n, tie_mode)
+    sprites = {
+        color: {"coords": raw_sprites[i]["coords"], "shape": raw_sprites[i]["shape"]}
+        for i, color in enumerate(placeholder_colors)
+    }
+
+    for pos_list in _candidate_positions(inner_shape, tie_mode, clip_mode):
+        if len(pos_list) != n:
+            continue
+        rows = [r for r, _ in pos_list]
+        if len(set(rows)) != len(rows):
+            continue
+        ok = True
+        for i in range(n):
+            for j in range(i + 1, n):
+                dist = max(abs(pos_list[i][0] - pos_list[j][0]), abs(pos_list[i][1] - pos_list[j][1]))
+                if not (3 <= dist <= 5):
+                    ok = False
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        placeholders = {color: tuple(pos_list[i]) for i, color in enumerate(placeholder_colors)}
+        expected, analysis = _build_expected(inner_shape, placeholders, sprites, color_map)
+        if not _valid_semantics(analysis, tie_mode=tie_mode, clip_mode=clip_mode):
+            continue
+
+        naive_sorted = sorted(analysis["placements"], key=lambda p: p["placeholder"][0])
+        order_map = {p["color"]: idx for idx, p in enumerate(naive_sorted)}
+        wrong = np.full_like(expected, FRAME_COLOR)
+        wrong[1:-1, 1:-1] = BACKGROUND
+        paint_order = sorted(analysis["placements"], key=lambda p: order_map[p["color"]])
+        for placement in paint_order:
+            out_color = color_map[placement["color"]]
+            for rr, cc in placement["cells"]:
+                wrong[rr + 1, cc + 1] = out_color
+        if np.array_equal(wrong, expected):
+            continue
+
+        grid = _render_input_grid(inner_shape, placeholders, sprites, color_map)
+        if grid is None:
+            continue
+        try:
+            solved = main(grid)
+        except Exception:
+            continue
+        if not np.array_equal(solved, expected):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to build a valid instance")

