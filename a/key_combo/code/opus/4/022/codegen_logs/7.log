+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Stamp recolored sprites into a grey frame and resolve overlaps by nearest placeholder.
+
+    Input structure:
+    - A black background contains one grey 1-pixel-thick rectangular frame.
+    - Inside the frame are 2 or 3 differently colored placeholder pixels.
+    - Outside the frame are one monochrome 4-connected sprite for each placeholder color and a set of vertical 2-pixel legend pairs whose top pixel is a placeholder color and bottom pixel is its output color.
+
+    Rule:
+    - Find the frame, the placeholder pixels, the matching same-color sprites, and the legend color mapping.
+    - Stamp each sprite into the frame interior by aligning the floor-centered sprite bbox center to its placeholder, then recolor that whole stamp with the legend output color.
+    - Clip stamped pixels to the frame interior; when multiple stamps cover one cell, keep the one whose placeholder is Chebyshev-nearest, breaking equal-distance ties by the smaller placeholder row.
+    - Return only the cropped frame region, with the grey border preserved and untouched interior cells left black.
+
+    Key insight:
+    - Overlap cells are not decided by stamp order; they form a placeholder-centered Voronoi partition inside the frame, while the external legend independently fixes each stamp's output color.
+    """
+    return _render_crop(_extract_problem(np.asarray(grid, dtype=int)))
