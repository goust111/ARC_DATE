+
+
+def _render_crop(problem: dict) -> np.ndarray:
+    crop = np.asarray(problem["crop"], dtype=int)
+    out = crop.copy()
+    out[1:-1, 1:-1] = problem["bg"]
+    analysis = _stamp_analysis(problem["inner_shape"], problem["placeholders"], problem["sprites"])
