+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_frame(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int, int, int]]:
+    g = np.asarray(grid, dtype=int)
+    candidates = []
+    for color in sorted(set(map(int, g.ravel())) - {bg}):
+        for coords in _components(g == color):
+            r0, c0, r1, c1 = _bbox_coords(coords)
+            h = r1 - r0 + 1
+            w = c1 - c0 + 1
+            if h < 3 or w < 3:
+                continue
+            sub = g[r0 : r1 + 1, c0 : c1 + 1]
+            border = np.zeros((h, w), dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if not np.all(sub[border] == color):
+                continue
+            if np.any(sub[~border] == color):
+                continue
+            if int(np.count_nonzero(sub == color)) != int(border.sum()):
+                continue
+            candidates.append((int(color), (r0, c0, r1, c1)))
+    assert len(candidates) == 1, f"expected one frame, found {len(candidates)}"
+    return candidates[0]
