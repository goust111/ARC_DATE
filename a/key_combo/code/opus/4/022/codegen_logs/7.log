+        patterns = [
+            [(0, 0), (1, 3)],
+            [(0, 0), (2, 3)],
+            [(0, 1), (1, 4)],
+            [(0, 0), (1, 3), (4, 1)],
+            [(0, 0), (2, 3), (4, 0)],
+            [(0, 1), (1, 4), (5, 1)],
+            [(0, 0), (2, 3), (3, 5)],
