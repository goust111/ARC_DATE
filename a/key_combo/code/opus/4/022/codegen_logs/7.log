+            [(0, 0), (3, 2)],
+            [(0, 1), (3, 4)],
+            [(0, 0), (3, 3), (4, 0)],
+            [(0, 0), (3, 3), (1, 5)],
+            [(0, 1), (3, 4), (5, 1)],
