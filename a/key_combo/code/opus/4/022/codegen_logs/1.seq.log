+        for c in range(w):
+            color = int(g[r, c])
+            if color not in colors or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ORTHO4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(g[nr, nc]) == color:
+                        visited[nr, nc] = True
+                        q.append((nr, nc))
+            bbox = _bbox_of_cells(cells)
+            r0, c0, _, _ = bbox
+            local = _normalize_coords([(rr - r0, cc - c0) for rr, cc in cells])
+            comps.append(
+                {
+                    "color": color,
+                    "cells": tuple(sorted(cells)),
+                    "cell_set": set(cells),
+                    "bbox": bbox,
+                    "local": local,
+                    "size": len(cells),
+                    "symmetric": _is_transpose_symmetric(local),
+                }
+            )
+    return comps
