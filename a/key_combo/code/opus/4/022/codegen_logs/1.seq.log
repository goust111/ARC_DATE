+    obstacle_cells = {(int(r), int(c)) for r, c in np.argwhere(g == OBSTACLE)}
+    trace = _trace_rays(g.shape, emitters, obstacle_cells, block_obstacles=True, block_emitters=True)
+    ray_map = trace["ray_map"]
