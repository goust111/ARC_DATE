+    emitter_cells = set().union(*(e["cell_set"] for e in emitters))
+    ray_records: list[dict] = []
+    ray_cells_by_color: dict[tuple[int, int], int] = {}
+    ray_color_sets: dict[tuple[int, int], set[int]] = {}
