+        for c in range(w):
+            color = int(g[r, c])
+            if color not in colors or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ORTHO4:
