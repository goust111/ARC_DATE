+                    w,
+                    shape,
+                    used_bboxes,
+                    sprite_cells,
+                    obstacle_cells,
+                    ray_map,
+                    require_hit=True,
+                )
+            )
+            if candidates:
+                break
+        if not candidates:
+            return None
+        choice = random.choice(candidates)
+        passives.append(choice)
+        used_bboxes.append(choice["bbox"])
+        sprite_cells.update(choice["cells"])
+
+    for _ in range(safe_needed):
+        candidates = []
+        shapes = ASYMMETRIC_SHAPES[:]
+        random.shuffle(shapes)
+        for shape in shapes:
