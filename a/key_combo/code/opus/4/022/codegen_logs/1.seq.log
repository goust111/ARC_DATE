+def _choose_emitter_pair(h: int, w: int) -> list[dict] | None:
+    for _ in range(200):
+        s1 = random.choice(SYMMETRIC_SHAPES)
+        s2 = random.choice(SYMMETRIC_SHAPES)
+        p1 = random.choice(s1)
+        p2 = random.choice(s2)
