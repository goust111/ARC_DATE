+def _find_components_of_colors(grid: np.ndarray, colors: tuple[int, ...] = SPRITE_COLORS) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    visited = np.zeros((h, w), dtype=bool)
