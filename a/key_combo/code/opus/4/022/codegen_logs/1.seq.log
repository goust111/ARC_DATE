+def _coords_to_mask(coords: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = max(r for r, _ in coords) + 1
+    w = max(c for _, c in coords) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[r, c] = True
+    return mask
