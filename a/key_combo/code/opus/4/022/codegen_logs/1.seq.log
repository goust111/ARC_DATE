+        s2 = random.choice(SYMMETRIC_SHAPES)
+        p1 = random.choice(s1)
+        p2 = random.choice(s2)
+        delta = random.randint(4, 6)
+        dh = p1[0] - p2[0] + delta
+        dw = p1[1] - p2[1] + delta
+        h1, w1 = _shape_size(s1)
+        h2, w2 = _shape_size(s2)
+
