+                continue
+            if idx >= len(rec["path"]) - 1:
+                continue
+            if _chebyshev_adjacent_to_any(cell, emitter_cells):
+                continue
+            seen_clip.add(cell)
+            clip_candidates.append(cell)
+    if not clip_candidates:
+        return None
+
