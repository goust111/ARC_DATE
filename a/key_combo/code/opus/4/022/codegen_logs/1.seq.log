+            continue
+
+        top1 = random.randint(r_lo, r_hi)
+        left1 = random.randint(c_lo, c_hi)
+        top2 = top1 + dh
+        left2 = left1 + dw
+        cells1 = _place_shape(s1, top1, left1)
+        cells2 = _place_shape(s2, top2, left2)
