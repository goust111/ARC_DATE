+
+def _bbox_of_cells(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in cells]
+    cs = [c for _, c in cells]
+    return min(rs), min(cs), max(rs), max(cs)
+
