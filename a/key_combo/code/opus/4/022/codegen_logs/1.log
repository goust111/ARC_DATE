        assert not bool(np.any(occupied[shifted[:, 0], shifted[:, 1]])), "shifted objects must not overlap"

        out[shifted[:, 0], shifted[:, 1]] = int(obj["color"])
        occupied[shifted[:, 0], shifted[:, 1]] = True

    return out

