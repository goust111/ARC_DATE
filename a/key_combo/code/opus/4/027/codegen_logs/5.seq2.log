+def normalize_coords(coords: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = sorted((int(r), int(c)) for r, c in coords)
+    r0, c0, _, _ = bbox(pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
+
