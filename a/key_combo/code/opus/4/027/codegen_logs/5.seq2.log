+def coords_to_mask(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> np.ndarray:
+    pts = normalize_coords(list(coords))
+    h = max(r for r, _ in pts) + 1
+    w = max(c for _, c in pts) + 1
+    out = np.zeros((h, w), dtype=bool)
+    for r, c in pts:
+        out[r, c] = True
+    return out
