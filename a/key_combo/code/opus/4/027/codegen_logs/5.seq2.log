+        for r, c in hole["coords"]:
+            out[r, c] = fill
+    return out
+
+
+def transform_shape(shape: tuple[tuple[int, int], ...], rot: int = 0, flip: bool = False) -> tuple[tuple[int, int], ...]:
+    pts = [(r, -c) if flip else (r, c) for r, c in shape]
+    for _ in range(rot % 4):
