+def shift_coords(coords: tuple[tuple[int, int], ...], dr: int, dc: int) -> list[tuple[int, int]]:
+    return [(r + dr, c + dc) for r, c in coords]
+
+
+def can_place(occupied: np.ndarray, coords: list[tuple[int, int]], pad: int) -> bool:
+    h, w = occupied.shape
