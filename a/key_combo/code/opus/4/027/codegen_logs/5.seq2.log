+def locate_palette(grid: np.ndarray) -> tuple[dict[int, int], tuple[int, int, int, int]]:
+    h, w = grid.shape
+    matches: list[tuple[int, int, int, int]] = []
+    for r in range(h - 1):
+        for c in range(w - 2):
