+    return mapping, (r0, c0, r1, c1)
+
+
+def analyze_grid(grid: np.ndarray):
+    mapping, pal_box = locate_palette(grid)
+    pr0, pc0, pr1, pc1 = pal_box
+    palette_mask = np.zeros_like(grid, dtype=bool)
+    palette_mask[pr0 : pr1 + 1, pc0 : pc1 + 1] = True
