+    for name, shape in BASE_SHAPES.items()
+}
+
+
+def make_ring(hole_shape: tuple[tuple[int, int], ...]) -> tuple[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]]:
+    hole = set(hole_shape)
