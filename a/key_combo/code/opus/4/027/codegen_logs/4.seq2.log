+    )
+    wrong_right = _mask_to_patch(
+        _mirror_complete(originals[right_kind] == MOTIF, "horizontal" if right_kind == "wide" else "vertical")
+    )
+    wrong_outputs = [
+        _stamped_output(height, width, bottom_row, [wrong_left, patches[1]], sorted(marker_global, key=lambda rc: (rc[1], rc[0]))),
