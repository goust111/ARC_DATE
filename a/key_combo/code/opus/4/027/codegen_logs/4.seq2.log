+        allowed = [(r, c) for r in range(inner_h) for c in range(axis + 1)]
+    else:
+        axis = inner_h // 2
+        allowed = [(r, c) for r in range(axis + 1) for c in range(inner_w)]
+    chosen = _grow_connected_cells(allowed, count)
+    if chosen is None:
+        return None
+    for r, c in chosen:
+        mask[r, c] = True
