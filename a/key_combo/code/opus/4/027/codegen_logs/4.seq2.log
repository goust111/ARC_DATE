+def _paint_frame(grid: np.ndarray, top: int, left: int, outer_h: int, outer_w: int) -> None:
+    grid[top, left : left + outer_w] = FRAME
+    grid[top + outer_h - 1, left : left + outer_w] = FRAME
+    grid[top : top + outer_h, left] = FRAME
