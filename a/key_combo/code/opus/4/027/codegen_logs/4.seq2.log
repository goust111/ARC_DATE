+    if np.array_equal(correct, _stamped_output(height, width, bottom_row, original_patches, sorted(marker_global, key=lambda rc: (rc[1], rc[0])))):
+        return None
+    if np.array_equal(correct, _stamped_output(height, width, bottom_row, list(reversed(patches)), sorted(marker_global, key=lambda rc: (rc[1], rc[0])))):
+        return None
+
+    wrong_left = _mask_to_patch(
