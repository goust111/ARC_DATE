+    q = deque([int(start)])
+    dist = {int(start): 0}
+    ways = {int(start): 1}
+    parent = {int(start): None}
+
+    while q:
+        u = int(q.popleft())
+        for v in sorted(adj[u]):
+            if v not in dist:
+                dist[v] = dist[u] + 1
+                ways[v] = ways[u]
+                parent[v] = u
+                q.append(v)
+            elif dist[v] == dist[u] + 1:
+                ways[v] += ways[u]
