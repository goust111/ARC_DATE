+        row_offsets, col_offsets = offset_plan
+
+        placeholder_colors = {cell: NODE_COLORS[idx % len(NODE_COLORS)] for idx, cell in enumerate(sorted(selected))}
+        placeholder = _render_grid(
+            row_bases,
+            col_bases,
+            selected,
+            row_offsets,
+            col_offsets,
+            placeholder_colors,
+            (height, width),
