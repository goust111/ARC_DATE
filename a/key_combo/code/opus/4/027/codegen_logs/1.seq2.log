+
+def _trace_hits(
+    occ: np.ndarray, start_r: int, start_c: int, dr: int, dc: int, source_id: int
+) -> list[int]:
+    hits = []
+    last = None
+    r, c = int(start_r), int(start_c)
+    h, w = occ.shape
+    while 0 <= r < h and 0 <= c < w:
