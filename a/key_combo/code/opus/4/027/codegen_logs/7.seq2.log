    orient: str, h: int, w: int, side: str
) -> tuple[list[tuple[tuple[int, int], ...]], list[tuple[tuple[int, int], ...]]]:
    singles: list[tuple[tuple[int, int], ...]] = []
    pairs: list[tuple[tuple[int, int], ...]] = []

    if orient == "V":
