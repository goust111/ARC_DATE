CAP_HALF_SPAN, BAR_OFFSET, WALL_INSET = 1, 1, 2

# Motif counts and safe interior positions.
MOTIF_SIDES = ("near", "far")
MOTIF_PIXEL_RANGE = (4, 9)
MOTIF_SIDE_INSET, MOTIF_AXIS_MARGIN = 3, 2
