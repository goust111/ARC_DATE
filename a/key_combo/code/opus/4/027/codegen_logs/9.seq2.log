+TARGET_COLORS = (Color.YELLOW, Color.PINK, Color.GREY)
+PALETTE_MAPPING = dict(zip(BODY_COLORS, TARGET_COLORS, strict=True))
+ORIENTATIONS = ("dr", "dl", "ur", "ul")
+LEG_CHOICES = ((2, 2), (2, 3), (2, 4), (3, 2), (3, 3), (4, 2))
