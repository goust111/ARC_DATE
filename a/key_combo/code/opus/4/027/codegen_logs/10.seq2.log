+BACKGROUND = Color.BLACK
+MARKER = Color.TEAL
+MAIN_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.ORANGE)
+SPRITE_SIZE = 4
+GRID_SIZE_RANGE = (14, 20)
