+        chosen = rng.sample(range(SPRITE_SIZE * SPRITE_SIZE), int(marker_count))
+        for idx in chosen:
+            sprite[idx // SPRITE_SIZE, idx % SPRITE_SIZE] = int(MARKER)
+        marker_mask = sprite == int(MARKER)
+        if _all_row_rolls_distinct(marker_mask):
