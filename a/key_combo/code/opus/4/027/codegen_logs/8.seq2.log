+    border_set = sprite["border_set"]
+    candidates = []
+
+    holes = sprite["hole_cells"][:]
+    rng.shuffle(holes)
+    sides = list(SECTOR_SIDES[sprite["sector"]])
+    rng.shuffle(sides)
+
+    for side in sides:
