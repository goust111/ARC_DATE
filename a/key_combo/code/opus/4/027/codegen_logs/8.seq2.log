    patch[0, cap] = color
    patch[BAR_OFFSET, :] = color
    patch[BAR_OFFSET, mid] = BG_COLOR
    patch[WALL_INSET : h - WALL_INSET, 0] = color
    patch[WALL_INSET : h - WALL_INSET, w - 1] = color
    patch[h - 1 - BAR_OFFSET, :] = color
    patch[h - 1 - BAR_OFFSET, mid] = BG_COLOR
    patch[h - 1, cap] = color
    return patch


