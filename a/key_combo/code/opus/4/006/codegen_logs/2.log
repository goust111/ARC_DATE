+def _normalize(coords) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
