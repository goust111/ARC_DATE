+    area_order = [obj["id"] for obj in sorted(objects, key=lambda obj: (obj["area"], obj["perimeter"]))]
+    bbox_order = [obj["id"] for obj in sorted(objects, key=lambda obj: (obj["bbox_perimeter"], obj["area"], obj["perimeter"]))]
