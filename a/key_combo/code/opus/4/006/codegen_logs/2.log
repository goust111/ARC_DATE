+
+def _shape_bbox(shape: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    return min(rows), min(cols), max(rows), max(cols)
+
