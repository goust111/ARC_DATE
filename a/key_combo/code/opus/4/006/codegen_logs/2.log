+    ranked = sorted(objects, key=lambda obj: obj["perimeter"])
+    for rank, obj in enumerate(ranked, start=1):
+        fill_color = obj["marker_color"] if rank % 2 == 1 else ranked[rank - 2]["marker_color"]
+        for r, c in obj["grey_coords"]:
+            out[r, c] = fill_color
