+    raise RuntimeError("failed to choose object specs")
+
+
+def _valid_offsets(shape: tuple[tuple[int, int], ...], blocked: set[tuple[int, int]], h: int, w: int) -> list[tuple[int, int]]:
+    sh, sw = _shape_dims(shape)
