+        if len(specs) != count:
+            continue
+
+        rank_order = [spec["canonical"] for spec in sorted(specs, key=lambda spec: spec["perimeter"])]
+        area_order = [spec["canonical"] for spec in sorted(specs, key=lambda spec: (spec["area"], spec["perimeter"]))]
+        bbox_order = [
+            spec["canonical"]
