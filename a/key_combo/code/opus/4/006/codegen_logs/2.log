+        out.append(_normalize(coords))
+        out.append(_normalize([(r, -c) for r, c in coords]))
+        coords = [(c, -r) for r, c in coords]
+    unique = []
+    seen = set()
+    for candidate in out:
+        if candidate not in seen:
+            seen.add(candidate)
+            unique.append(candidate)
+    return unique
