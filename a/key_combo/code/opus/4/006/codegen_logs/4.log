+}
+
+GEN_RETRIES = 400
+GRID_H_RANGE = (18, 28)
+GRID_W_RANGE = (18, 28)
+NOISE_RANGE = (1, 4)
+
+
+def get_bg(grid: np.ndarray) -> int:
