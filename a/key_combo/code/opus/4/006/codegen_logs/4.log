+    if not noise:
+        return None
+
+    meta = {"shape": (h, w), "items": meta_items, "noise": noise}
+    grid = render_input(meta)
+    if np.array_equal(grid, build_expected_output(meta)):
+        return None
+    try:
+        validate_example(grid, meta)
+    except AssertionError:
+        return None
