+    if random.random() < 0.5:
+        base = base.T
+    mask = mirror_to_kind(base, dominant_kind)
+    assert 3 <= int(mask.sum()) <= 10
+    assert sprite_side(mask) == side
+    assert dominant_quadrant(mask) == dominant_kind
+    assert is_nonsymmetric(mask)
+    assert len(components_mask(mask, connectivity=4)) == 1
