+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+SPRITE = 2
+FRAME = 4
+
+CORNER_SIGNS = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
+SIGN_TO_CORNER = {sign: corner for corner, sign in CORNER_SIGNS.items()}
