+            corners = square_corners(r0, c0, side)
+            missing = corners[missing_kind]
+            s_rect = stamp_rect(missing, missing_kind, sprite_shape)
+            sr0, sc0, sr1, sc1 = s_rect
+            if sr0 < 0 or sc0 < 0 or sr1 >= h or sc1 >= w:
+                continue
