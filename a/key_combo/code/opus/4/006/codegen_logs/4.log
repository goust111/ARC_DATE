+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert connectivity == 4
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def square_corners(r0: int, c0: int, side: int) -> dict[str, tuple[int, int]]:
+    return {
+        "tl": (r0, c0),
+        "tr": (r0, c0 + side),
+        "bl": (r0 + side, c0),
+        "br": (r0 + side, c0 + side),
+    }
+
+
+def dominant_quadrant(mask: np.ndarray) -> str:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    h, w = mask.shape
+    counts: Counter[tuple[int, int]] = Counter()
+    for r, c in coords:
+        vr = -1 if 2 * int(r) <= h - 1 else 1
+        hc = -1 if 2 * int(c) <= w - 1 else 1
+        counts[(vr, hc)] += 1
+    best = max(counts.values())
+    winners = [sign for sign, value in counts.items() if value == best]
+    if len(winners) > 1:
+        mean_r, mean_c = coords.mean(axis=0)
+        fallback = (-1 if 2 * mean_r <= h - 1 else 1, -1 if 2 * mean_c <= w - 1 else 1)
+        if fallback in winners:
+            return SIGN_TO_CORNER[fallback]
+        winners = sorted(winners)
+    return SIGN_TO_CORNER[winners[0]]
