+
+
+def quadrant_for_flip(missing_kind: str, flip_v: bool, flip_h: bool) -> str:
+    m_v, m_h = CORNER_SIGNS[missing_kind]
+    return SIGN_TO_CORNER[(-m_v if flip_v else m_v, -m_h if flip_h else m_h)]
