+                missing_kind = next(kind for kind, pos in corners.items() if pos not in present)
+                key = (side, missing_kind, present)
+                if key in seen:
+                    continue
+                seen.add(key)
+                out.append(
+                    {
+                        "side": side,
+                        "missing_kind": missing_kind,
+                        "missing": corners[missing_kind],
+                        "markers": present,
+                    }
