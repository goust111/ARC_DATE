+
+
+def stamp_rect(missing: tuple[int, int], missing_kind: str, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, c0 = stamp_origin(missing, missing_kind, shape)
+    h, w = map(int, shape)
