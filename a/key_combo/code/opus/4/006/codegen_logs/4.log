+def candidate_bbox_positions(guard: np.ndarray, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = guard.shape
+    ph, pw = map(int, shape)
+    out = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            if guard[max(0, r0 - 1) : min(h, r0 + ph + 1), max(0, c0 - 1) : min(w, c0 + pw + 1)].any():
+                continue
+            out.append((r0, c0))
+    random.shuffle(out)
+    return out
