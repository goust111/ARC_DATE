+def frame_candidates(grid: np.ndarray) -> list[dict]:
+    coords = [tuple(map(int, p)) for p in np.argwhere(grid == FRAME)]
+    coord_set = set(coords)
+    rows = sorted({r for r, _ in coords})
+    cols = sorted({c for _, c in coords})
+    seen = set()
+    out = []
+    for r0 in rows:
+        for r1 in rows:
+            if r1 <= r0:
