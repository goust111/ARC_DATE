+            out.append((r0, c0))
+    random.shuffle(out)
+    return out
+
+
+def render_input(meta: dict) -> np.ndarray:
+    h, w = meta["shape"]
+    grid = np.full((h, w), BG, dtype=int)
+    for item in meta["items"]:
+        paint_frame_markers(grid, item)
+    for item in meta["items"]:
