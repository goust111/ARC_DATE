+def candidate_frame_placements(h: int, w: int, item: dict) -> list[dict]:
+    side = item["side"]
+    sprite_shape = item["sprite"].shape
+    missing_kind = item["missing_kind"]
+    candidates = []
+    for r0 in range(h - side):
+        for c0 in range(w - side):
