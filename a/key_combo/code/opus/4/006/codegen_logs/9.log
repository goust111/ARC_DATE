def _gen_source_sprite(n: int, source_sign: tuple[int, int], sprite_color: int, bg: int) -> np.ndarray:
    if n == _GEN_HOLLOW_ALWAYS_SIZE or random.random() < _GEN_HOLLOW_BORDER_PROB:
