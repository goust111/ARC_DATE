+        panel = np.where(crop_bbox(grid, box) == GREY, GREY, BG)
+        key = _pattern_key(panel)
+        assert key in SYMBOL_TO_COLOR, "unknown symbol pattern"
+        decoded.append(SYMBOL_TO_COLOR[key])
+    return decoded
