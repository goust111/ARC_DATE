+    assert best_union is not None, "no non-overlapping packing found"
+    union, min_r, min_c, height, width = best_union
+    out = np.full((height, width), BG, dtype=int)
+    for r, c in union:
+        out[r - min_r, c - min_c] = color
+    return out
