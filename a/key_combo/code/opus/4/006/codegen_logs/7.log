+
+def _extract_symbols(grid: np.ndarray) -> list[dict]:
+    yellow_components = components_mask(grid == YELLOW, connectivity=4)
+    symbols: list[dict] = []
+    for comp in yellow_components:
+        if comp.shape[0] != 3:
+            continue
+        bbox = _bbox_from_coords(comp)
+        r0, c0, r1, c1 = bbox
+        if (r1 - r0 + 1, c1 - c0 + 1) != (2, 2):
