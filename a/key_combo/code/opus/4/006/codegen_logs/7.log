+
+def _place_obstacle(mask: np.ndarray, margin_top: int, margin_left: int, shape: tuple[int, int]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    h, w = mask.shape
+    grid[margin_top : margin_top + h, margin_left : margin_left + w][mask] = GREY
+    return grid
