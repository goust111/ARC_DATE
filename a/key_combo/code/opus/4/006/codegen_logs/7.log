+        values, counts = np.unique(grid, return_counts=True)
+        return int(values[np.argmax(counts)])
+
+    def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+        h, w = shape
+        return 0 <= r < h and 0 <= c < w
+
+    def neighbors4(r: int, c: int):
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+
+    def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+        assert connectivity == 4
+        h, w = mask.shape
+        seen = np.zeros((h, w), dtype=bool)
+        out: list[np.ndarray] = []
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c] or not mask[r, c]:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in neighbors4(rr, cc):
+                        if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                out.append(np.array(coords, dtype=int))
+        return out
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MARKER_COLORS = (RED, GREEN, BLUE, ORANGE)
+
+COLOR_TO_PATTERN: dict[int, tuple[tuple[int, int], tuple[int, int]]] = {
+    RED: ((0, YELLOW), (YELLOW, YELLOW)),
+    GREEN: ((YELLOW, 0), (YELLOW, YELLOW)),
+    BLUE: ((YELLOW, YELLOW), (0, YELLOW)),
+    ORANGE: ((YELLOW, YELLOW), (YELLOW, 0)),
+}
+PATTERN_TO_COLOR = {pattern: color for color, pattern in COLOR_TO_PATTERN.items()}
+
+_SIDE_ORDER = ("west", "north", "east", "south")
+_GEN_COUNTER = 0
+
+
+def _bbox_from_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _turn_left(direction: Coord) -> Coord:
+    dr, dc = direction
+    return -dc, dr
+
+
+def _turn_right(direction: Coord) -> Coord:
+    dr, dc = direction
+    return dc, -dr
+
+
+def _turn_back(direction: Coord) -> Coord:
+    dr, dc = direction
+    return -dr, -dc
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[Coord] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
