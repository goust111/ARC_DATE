+        "west": (west_r, 0, west_r + 1, 1),
+        "north": (0, top_c, 1, top_c + 1),
+        "east": (east_r, local_w - 2, east_r + 1, local_w - 1),
+        "south": (local_h - 2, bottom_c, local_h - 1, bottom_c + 1),
