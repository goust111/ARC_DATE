+
+def _adjacent_to_bbox(pos: Coord, bbox: BBox) -> bool:
+    r, c = pos
+    r0, c0, r1, c1 = bbox
+    return (
+        (r0 <= r <= r1 and (c == c0 - 1 or c == c1 + 1))
+        or (c0 <= c <= c1 and (r == r0 - 1 or r == r1 + 1))
+    )
