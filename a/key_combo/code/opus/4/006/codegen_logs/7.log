+        for second in symbols[i + 1 :]:
+            sr0, sc0, sr1, sc1 = second["bbox"]
+            disjoint = fr1 < sr0 or sr1 < fr0 or fc1 < sc0 or sc1 < fc0
+            assert disjoint, "symbols should not overlap"
