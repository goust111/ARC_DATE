+
+
+def _sightline_to_obstacle(mask: np.ndarray, start: Coord) -> tuple[Coord, Coord]:
+    hits: list[tuple[Coord, Coord]] = []
+    sr, sc = start
+    for direction in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+        dr, dc = direction
+        r, c = sr + dr, sc + dc
+        previous_bg: Coord | None = None
+        while in_bounds(mask.shape, r, c):
