+        r0, c0, r1, c1 = bbox
+        out[side] = (r0 + top, c0 + left, r1 + top, c1 + left)
+    return out
+
+
+def _build_marker_position(side: str, index: int, top: int, left: int, local_h: int, local_w: int, gap: int) -> Coord:
+    if side == "west":
