+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    assert len(components_mask(mask, connectivity=4)) == 1, "expected one restored obstacle region"
+    assert not _has_hole(mask), "restored obstacle should be hole-free"
+    return mask
