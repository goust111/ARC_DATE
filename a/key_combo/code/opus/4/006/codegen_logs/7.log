        sprite_mask = oriented == sprite_color
        target = out[paste_r : paste_r + sprite_h, paste_c : paste_c + sprite_w]
        assert np.all((target[sprite_mask] == bg) | (target[sprite_mask] == sprite_color))
        target[sprite_mask] = sprite_color


