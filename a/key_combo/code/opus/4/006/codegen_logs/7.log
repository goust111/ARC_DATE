+def _has_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[Coord] = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if in_bounds(mask.shape, nr, nc) and not mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                stack.append((nr, nc))
