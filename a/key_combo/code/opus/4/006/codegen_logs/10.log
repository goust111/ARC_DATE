+            out.append(((r, c), move["landing"]))
+    random.shuffle(out)
+    return out
+
+
+def _validate_generated_case(
+    grid: np.ndarray,
+    *,
+    rescue_fragment: set[tuple[int, int]],
+    doomed_fragments: list[set[tuple[int, int]]],
+    room_cells: set[tuple[int, int]],
