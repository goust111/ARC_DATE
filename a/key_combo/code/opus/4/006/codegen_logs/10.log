        v=int(g[rr,cc])
        if v"'!=BG:
          if v==BLUE:
            axis=0 if dr==0 else 1
            hits.append((d,axis,ORDER[(dr,dc)],dr,dc,(rr,cc)))
          break
        rr+=dr; cc+=dc; d+=1
    if not hits: return None
    hits.sort()
    best=(hits[0][0],hits[0][1])
    if sum((h[0],h[1])==best for h in hits)>1:
      return None
    d,axis,ordr,dr,dc,(wr,wc)=hits[0]
    stop=(wr-dr,wc-dc)
    if stop==pos: return None
    return stop

def flood(g,start):
  h,w=g.shape
  q=deque([start]); vis={start}
  while q:
    r,c=q.popleft()
    for dr,dc in DIRS:
      nr,nc=r+dr,c+dc
      if 0<=nr<h and 0<=nc<w and (nr,nc) not in vis and g[nr,nc]!=BLUE:
        vis.add((nr,nc)); q.append((nr,nc))
  return vis

def solve(inp):
