+    return True
+
+
+def _place_doomed_fragments(
+    grid: np.ndarray,
+    reserved: set[tuple[int, int]],
+) -> list[set[tuple[int, int]]] | None:
+    doomed: list[set[tuple[int, int]]] = []
+    want = 1 + (1 if random.random() < 0.45 else 0)
