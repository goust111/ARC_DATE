    for c in range(w):
      if base[r,c]==BG:
        mv=best_move(base,(r,c))
        if mv is not None: allc.append(((r,c),mv))
  # prioritize moving sources near fragment vicinity and distinct landings
  allc=sorted(allc,key=lambda item:(abs(item[1][0]-sum(r for r,_ in fragcells)/len(fragcells))+abs(item[1][1]-sum(c for _,c in fragcells)/len(fragcells))))
  allc=allc[:50]
