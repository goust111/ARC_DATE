+
+
+def generate_input() -> np.ndarray:
+    for _attempt in range(GEN_ATTEMPTS):
+        h = random.randint(14, 18)
+        w = random.randint(14, 18)
+        grid = np.zeros((h, w), dtype=int)
+
+        top = random.randint(2, 3)
