import numpy as np, random, itertools
from collections import deque
BG=0; BLUE=1; RED=2; MAG=6; ORANGE=7
DIRS=[(0,-1),(0,1),(-1,0),(1,0)]
ORDER={(0,-1):0,(0,1):1,(-1,0):2,(1,0):3}

def comps(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if mask[r,c] and not seen[r,c]:
                q=[(r,c)]; seen[r,c]=1; pts=[]
                for rr,cc in q:
                    pts.append((rr,cc))
                    for dr,dc in DIRS:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=1; q.append((nr,nc))
                out.append(pts)
    return out

def best_move(g,pos):
    h,w=g.shape; r,c=pos
    hits=[]
    for dr,dc in DIRS:
        rr,cc=r+dr,c+dc; d=1
        while 0<=rr<h and 0<=cc<w:
            v=int(g[rr,cc])
            if v"'!=BG:
                if v==BLUE:
                    axis=0 if dr==0 else 1
                    hits.append((d,axis,ORDER[(dr,dc)],dr,dc,(rr,cc)))
                break
            rr+=dr; cc+=dc; d+=1
    if not hits: return None
    hits.sort()
    d,axis,order,dr,dc,(wr,wc)=hits[0]
    stop=(wr-dr,wc-dc)
    if stop==pos: return None
    # reject same-axis same-distance ambiguity
    best=(d,axis)
    nbest=sum((h[0],h[1])==best for h in hits)
    if nbest>1: return None
    return stop

def flood(g,start):
    h,w=g.shape
    q=deque([start]); vis={start}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and (nr,nc) not in vis and g[nr,nc]!=BLUE:
                vis.add((nr,nc)); q.append((nr,nc))
    return vis

def transform(inp):
