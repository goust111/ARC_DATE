+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid edge-strip square-gating puzzle")

