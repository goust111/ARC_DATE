+def _distractor_marker_cells(placed: list[dict], active_cols: set[int]) -> list[tuple[int, int]]:
+    preferred_cols: list[int] = []
+    for obj in placed:
+        if obj["fake_square"]:
+            preferred_cols.extend(c for c in range(obj["bbox"][1], obj["bbox"][3] + 1) if c not in active_cols)
