+    nonsquare = [obj for obj in objects if not obj["complete"]]
+    assert complete and nonsquare
+    assert any((obj["bbox"][2] - obj["bbox"][0]) == (obj["bbox"][3] - obj["bbox"][1]) for obj in nonsquare)
+
+    active_cols = set()
+    for obj in complete:
+        _, c0, _, c1 = obj["bbox"]
+        active_cols.update(range(c0, c1 + 1))
