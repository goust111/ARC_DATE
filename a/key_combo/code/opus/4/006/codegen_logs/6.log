+        box = bbox(mask)
+        assert box is not None
+        r0, c0, r1, c1 = box
+        side_h = r1 - r0 + 1
+        side_w = c1 - c0 + 1
+        assert side_h == side_w and side_h % 2 == 1
+        patch = np.where(crop_bbox(local, box) == color, color, BG)
+        layers.append(
