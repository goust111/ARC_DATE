+                visible_selected += 1
+        else:
+            assert np.array_equal(actual_layer, layer["patch"])
+    assert visible_selected >= 1
+    return scene
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
