+            ([(side - 2, 0), (side - 1, 0)], (side - 2, 0), "v"),
+        ]
+    if corner == "br":
+        return [
+            ([(side - 1, side - 2), (side - 1, side - 1)], (side - 1, side - 2), "h"),
+            ([(side - 2, side - 1), (side - 1, side - 1)], (side - 2, side - 1), "v"),
+        ]
+    raise ValueError(corner)
+
