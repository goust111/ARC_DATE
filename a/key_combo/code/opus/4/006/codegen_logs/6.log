+    layers = _extract_layers(local)
+    assert len(layers) in (3, 4)
+    outer_color = layers[0]["color"]
+
+    indicator_coords = None
+    for comp in fg_comps:
+        if len(comp) != 2:
+            continue
+        box = bbox_coords(comp)
