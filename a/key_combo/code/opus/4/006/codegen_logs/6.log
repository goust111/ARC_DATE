+                    stack.append((nr, nc))
+        comps.append(np.array(comp, dtype=int))
+    return comps
+
+
+def _mirror_patch(patch: np.ndarray, axis: str) -> np.ndarray:
+    if axis == "vertical":
+        return patch[:, ::-1].copy()
+    if axis == "horizontal":
+        return patch[::-1, :].copy()
+    raise ValueError(f"unknown axis {axis}")
+
