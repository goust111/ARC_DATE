+        stack = [(sr, sc)]
+        seen[sr, sc] = True
+        comp = []
+        while stack:
+            r, c = stack.pop()
+            comp.append((r, c))
+            for dr, dc in steps:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
