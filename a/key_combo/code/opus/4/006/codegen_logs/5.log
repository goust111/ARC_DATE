+
+def _branch_coords(center: tuple[int, int], direction: str, length: int) -> list[tuple[int, int]]:
+    cr, cc = center
+    dr, dc = DIR_DELTA[direction]
+    r = cr + 2 * dr
+    c = cc + 2 * dc
+    coords = []
+    for _ in range(length):
+        coords.append((r, c))
+        r += dr
+        c += dc
+    return coords
+
