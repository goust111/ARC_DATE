+        "shape": (h, w),
+        "center": center,
+        "directions": directions,
+        "template_dir": template_dir,
+        "lengths": lengths,
+        "pattern": pattern,
+        "pairs": pairs,
+    }
+
+
+def generate_input() -> np.ndarray:
