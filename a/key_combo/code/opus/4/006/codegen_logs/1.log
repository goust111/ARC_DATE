+    ph, pw = patch_shape
+    candidates = []
+    for r0 in range(gh - ph + 1):
+        r1 = r0 + ph - 1
+        for c0 in range(gw - pw + 1):
+            c1 = c0 + pw - 1
+            if blocked[r0 : r1 + 1, c0 : c1 + 1].any():
+                continue
+            candidates.append((r0, c0))
