+        if r0 > 0 and grid[r0 - 1, c] == BG:
+            contacts.add((r0 - 1, c))
+        if r1 + 1 < h and grid[r1 + 1, c] == BG:
+            contacts.add((r1 + 1, c))
+    for r in range(r0, r1 + 1):
+        if c0 > 0 and grid[r, c0 - 1] == BG:
+            contacts.add((r, c0 - 1))
+        if c1 + 1 < w and grid[r, c1 + 1] == BG:
+            contacts.add((r, c1 + 1))
