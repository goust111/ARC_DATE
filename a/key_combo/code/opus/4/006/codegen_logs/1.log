+    for size, candidates in by_size.items():
+        assert candidates, f"no cavity found for size {size}"
+        best = min(
+            candidates,
+            key=lambda rect: (
+                _outside_zero_contacts(template, rect),
+                rect[0],
+                rect[1],
+            ),
+        )
+        cavities.append(best)
