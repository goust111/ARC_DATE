+        return None
+
+    frame = np.full((frame_h, frame_w), WALL, dtype=int)
+    for room in rooms:
+        r0, c0, r1, c1 = room["rect_local"]
+        frame[r0 : r1 + 1, c0 : c1 + 1] = BG
+
