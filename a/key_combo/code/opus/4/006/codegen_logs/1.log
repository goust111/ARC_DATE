        OBSTACLE_WIDTH_RANGE[0],
        max_left + 1,
        min_left + 3,
        (OBSTACLE_AREA_RANGE[0] + sum_lefts + h - 1) // h,
    )
    w_max = min(OBSTACLE_WIDTH_RANGE[1], (OBSTACLE_AREA_RANGE[1] + sum_lefts) // h)
    if w_min > w_max:
        return None
    w = random.randint(w_min, w_max)
