+    stub_row = random.choice([1, h - 2])
+    c_shape = _coords_from_pairs(
+        [(0, c) for c in range(w)]
+        + [(h - 1, c) for c in range(w)]
+        + [(r, 0) for r in range(1, h - 1)]
