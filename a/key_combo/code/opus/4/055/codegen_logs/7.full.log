+
+
+def _enclosed_regions(grid: np.ndarray, bg: int) -> list[np.ndarray]:
+    holes = []
+    h, w = grid.shape
+    for coords in components_mask(grid == bg, connectivity=4):
+        if any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in coords):
+            continue
+        holes.append(coords)
+    return holes
