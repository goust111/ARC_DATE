+def _placeable(existing: list[np.ndarray], candidate: np.ndarray) -> bool:
+    pts = {tuple(map(int, p)) for obj in existing for p in obj.tolist()}
+    for r, c in candidate.tolist():
+        rr = int(r)
+        cc = int(c)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
