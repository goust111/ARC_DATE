+    bottom = _coords_from_pairs([(h - 1, c) for c in range(w)])
+    left = _coords_from_pairs([(r, 0) for r in range(1, h - 1)] + [(left_stub, -1), (left_stub, -2)])
+    right = _coords_from_pairs([(r, w - 1) for r in range(1, h - 1)] + [(right_stub, w), (right_stub, w + 1)])
