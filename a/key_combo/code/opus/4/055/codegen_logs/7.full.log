+    objects_input = []
+    for coords in objects_final:
+        width = _bbox(coords)[3] - _bbox(coords)[1] + 1
+        src = _shift_object_coords(coords, -width)
+        if not bool((0 <= src[:, 0]).all() and (src[:, 0] < WORK_SHAPE[0]).all()):
