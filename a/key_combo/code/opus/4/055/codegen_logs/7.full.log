+                for dc in (-1, 0, 1):
+                    if dr == 0 and dc == 0:
+                        continue
+                    rr = r + dr
+                    cc = c + dc
+                    if 0 <= rr < shape[0] and 0 <= cc < shape[1] and id_grid[rr, cc] >= 0:
