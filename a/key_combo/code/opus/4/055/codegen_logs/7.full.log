+    for _ in range(distractor_count):
+        shape = _random_distractor()
+        placed = None
+        for _ in range(80):
+            br0, bc0, br1, bc1 = _bbox(shape)
+            dr = random.randint(1, WORK_SHAPE[0] - (br1 - br0 + 1) - 2)
