        assert bool((0 <= dst[:, 1]).all() and (dst[:, 1] < w).all())
        assert not bool(occupied[dst[:, 0], dst[:, 1]].any())
        out[dst[:, 0], dst[:, 1]] = g[obj["coords"][:, 0], g[obj["coords"][:, 1]]]
        occupied[dst[:, 0], dst[:, 1]] = True
    return out


