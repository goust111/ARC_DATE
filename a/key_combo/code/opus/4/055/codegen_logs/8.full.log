+    out_w = sum(sprite.shape[1] for sprite in sprites) + len(sprites) - 1
+    out = np.full((out_h, out_w), BG_COLOR, dtype=int)
+
+    cursor = 0
+    for sprite in sprites:
+        rr = out_h - sprite.shape[0]
