+        if _is_hollow_rect_frame(comp)
+    ]
+    assert frame_components, "expected grey hollow rectangle frames"
+
+    sprite_components = find_components(
+        grid,
+        bg=BG_COLOR,
+        connectivity=4,
+        monochromatic=True,
+        colors=[SPRITE_COLOR],
+    )
+    assert sprite_components, "expected maroon sprites"
