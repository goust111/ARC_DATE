+        return None
+    if not _depth_area_inversion(groups):
+        return None
+
+    grid = _place_groups_on_canvas(groups)
+    if grid is None:
+        return None
+
+    try:
+        _semantic_checks(grid, groups)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_candidate()
+        if grid is not None:
+            return grid
