+def _is_hollow_rect_frame(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    if int(component["area"]) != 2 * h + 2 * w - 4:
