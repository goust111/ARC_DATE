+    inner_h = random.randint(min_inner_h, inner_h_max)
+    inner_w = random.randint(min_inner_w, inner_w_max)
+    cur_h = inner_h
+    cur_w = inner_w
+    sprite_r = 1 + random.randint(0, inner_h - 2 - sh)
+    sprite_c = 1 + random.randint(0, inner_w - 2 - sw)
