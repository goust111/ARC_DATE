def _gen_is_isolated(grid: np.ndarray, r: int, c: int) -> bool:
    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
        if 0 <= nr < GRID_SIZE and 0 <= nc < GRID_SIZE and int(grid[nr, nc]) != BG_COLOR:
            return False
    return True


