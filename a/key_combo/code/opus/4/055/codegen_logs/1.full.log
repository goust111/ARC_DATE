+            {
+                "bbox": bbox,
+                "perimeter": int(coords.shape[0]),
+                "concave": _concave_count(coords),
+                "sprite_color": sprite_color,
+                "sprite_area": int(sprite_coords.shape[0]),
+                "sprite_crop": _crop(local_grid, sprite_bbox),
+            }
