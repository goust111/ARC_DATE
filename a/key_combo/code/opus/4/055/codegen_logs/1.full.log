+    max_r = max(r + patch.shape[0] for patch, (r, _c) in zip(patches, positions))
+    max_c = max(c + patch.shape[1] for patch, (_r, c) in zip(patches, positions))
+    grid = np.zeros((max_r, max_c), dtype=int)
