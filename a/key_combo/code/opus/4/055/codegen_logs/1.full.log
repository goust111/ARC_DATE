+def _assemble_output(records: list[dict]) -> np.ndarray:
+    keep = [rec for rec in records if rec["concave"] > 0]
+    assert len(keep) >= 2
+    counts = [rec["concave"] for rec in keep]
+    assert len(set(counts)) == len(counts)
