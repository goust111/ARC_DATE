+        path = _path_from_vertices(vertices)
+        coords = np.array(path, dtype=int)
+        patch_mask = np.zeros((height, width), dtype=bool)
+        patch_mask[coords[:, 0], coords[:, 1]] = True
+        comps = _components_from_mask(patch_mask)
+        if len(comps) != 1:
