+                intervals = []
+                for _k in range(notch_count):
+                    span = random.randint(3, 4)
+                    start = random.randint(2, width - span - 2)
+                    end = start + span - 1
+                    if all(end + 2 < prev_start or start > prev_end + 2 for prev_start, prev_end in intervals):
