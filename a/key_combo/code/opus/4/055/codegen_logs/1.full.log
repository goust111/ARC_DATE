+                continue
+            base_w = row_widths[row]
+            extra_w = grid_w - base_w
+            gaps = [0] * (len(items) + 1)
+            for _ in range(extra_w):
+                gaps[random.randrange(len(gaps))] += 1
+
+            c_cursor = gaps[0]
+            for i, idx in enumerate(items):
