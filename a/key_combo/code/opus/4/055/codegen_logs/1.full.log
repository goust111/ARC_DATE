+def _pack_patches(patches: list[np.ndarray]) -> list[tuple[int, int]] | None:
+    count = len(patches)
+    for _ in range(PACK_ATTEMPTS):
+        row_count = 2 if count <= 4 else random.choice([2, 3])
+        row_items = [[] for _ in range(row_count)]
