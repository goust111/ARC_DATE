+            ranked = sorted(range(row_count), key=lambda r: (row_widths[r], row_heights[r], random.random()))
+            row = ranked[0]
+            row_items[row].append(idx)
+            row_widths[row] += w + (2 if len(row_items[row]) > 1 else 0)
