+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+LOOP_COLOR = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SPRITE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 400
+PATCH_ATTEMPTS = 120
+PACK_ATTEMPTS = 120
+SPRITE_ATTEMPTS = 80
