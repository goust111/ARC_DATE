+def _sprite_crop_from_patch(patch: np.ndarray) -> np.ndarray:
+    mask = (patch != BG) & (patch != LOOP_COLOR)
+    comps = _components_from_mask(mask)
+    assert len(comps) == 1
+    return _crop(patch, _bbox_coords(comps[0]))
