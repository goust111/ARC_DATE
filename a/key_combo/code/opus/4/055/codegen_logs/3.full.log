            hi = min(HOLE_MAX_WIDTH, HOLE_MAX_AREA // h, prev_w - 1)
            lo = remaining + 1
            if lo > hi:
                ok = False
                break
            w = int(np.random.randint(lo, hi + 1))
            dims.append((int(h), w))

