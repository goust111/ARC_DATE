+    pivot_set = set(pivots)
+    anchor_cells = {
+        (r, c)
+        for r in range(anchor_bbox[0], anchor_bbox[2] + 1)
+        for c in range(anchor_bbox[1], anchor_bbox[3] + 1)
+    }
