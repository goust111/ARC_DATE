+def _layout_ok(shape: tuple[int, int], anchor_bbox: BBox, pairs: list[dict]) -> bool:
+    if not pairs:
+        return False
+    aligned = sum(1 for pair in pairs if pair["aligned"])
+    if aligned == 0 or aligned == len(pairs):
+        return False
+
+    inp = _build_input(shape, anchor_bbox, pairs)
