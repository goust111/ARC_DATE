+
+def _rotate_ccw_about_pivot(source: Coord, pivot: Coord) -> Coord:
+    sr, sc = source
+    pr, pc = pivot
+    dr, dc = sr - pr, sc - pc
+    return pr - dc, pc + dr
+
+
+def _inverse_source_from_target(target: Coord, pivot: Coord) -> Coord:
+    tr, tc = target
+    pr, pc = pivot
+    dr, dc = tr - pr, tc - pc
+    return pr + dc, pc - dr
+
