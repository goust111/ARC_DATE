+
+_RNG = np.random.default_rng()
+
+GRID_H_RANGE = (13, 20)
+GRID_W_RANGE = (13, 20)
+PAIR_COUNT_RANGE = (3, 6)
+ROTATION_DISTANCE_RANGE = (2, 5)
+GEN_ATTEMPTS = 500
