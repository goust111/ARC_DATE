+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS_DIR) not in sys.path:
+    sys.path.insert(0, str(_UTILS_DIR))
