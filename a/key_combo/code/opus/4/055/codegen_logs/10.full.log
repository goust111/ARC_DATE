  "dst": "equal-gap interior slots d inside the large sparse rectangular frame, ordered along the frame long axis",
  "match_cond": "rank(s) == rank(d)",
  "transform": "clear the original sprite pixels; replace the sparse frame by a solid one-pixel border; expand each sprite's two-step mask to a contiguous mask before stamping"
}
</annotation>
