+                    continue
+                choices.append((rr, cc))
+        if not choices:
+            return False
+        rr, cc = random.choice(choices)
+        patch = np.full((h, w), colors[idx], dtype=int)
+        paste(grid, patch, rr, cc)
+        occupied[rr : rr + h, cc : cc + w] = True
+    return True
