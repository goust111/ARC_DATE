+def _can_tile_region(sprite_crop: np.ndarray, region_shape: tuple[int, int]) -> bool:
+    rh, rw = region_shape
+    sh, sw = sprite_crop.shape
+    if rh % sh != 0 or rw % sw != 0:
+        return False
+    tiled = np.tile(sprite_crop, (rh // sh, rw // sw))
+    return bool(np.all(tiled != BG))
