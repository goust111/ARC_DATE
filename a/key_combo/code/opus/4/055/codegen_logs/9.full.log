+    def search(i: int, used: set[int], assignment: list[int]) -> None:
+        if len(solutions) > 1:
+            return
+        if i == n:
+            solutions.append(assignment.copy())
+            return
+        best = None
+        best_options = None
+        for sprite_idx in range(n):
