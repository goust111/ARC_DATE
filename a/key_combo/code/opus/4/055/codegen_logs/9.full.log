+    for _ in range(500):
+        if placed >= count:
+            return
+        rr = random.randrange(grid.shape[0])
+        cc = random.randrange(grid.shape[1])
+        if rr in anchor_rows or cc in anchor_cols:
+            continue
+        if grid[rr, cc] != BG:
