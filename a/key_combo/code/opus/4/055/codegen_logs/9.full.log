/bin/bash -lc "python - <<'PY'
from itertools import combinations, permutations
C=[(1,3),(3,1),(1,4),(4,1),(1,5),(5,1),(1,6),(6,1),(1,7),(7,1),(1,8),(8,1),(2,2),(2,3),(3,2),(2,4),(4,2)]

def compat(s,r):
    sh,sw=s; rh,rw=r
    return rh%sh==0 and rw%sw==0

def uniq(regions,n):
    best=[]
    for combo in combinations(C,n):
        M=[[compat(s,r) for r in regions] for s in combo]
        if any(not any(row) for row in M):
            continue
        if any(not any(M[i][j] for i in range(n)) for j in range(n)):
            continue
        sols=[]
        for perm in permutations(range(n)):
            if all(M[i][perm[i]] for i in range(n)):
                sols.append(perm)
        if len(sols)==1:
            score=sum(sum(row) for row in M)
            areas=[a*b for a,b in combo]
            score+=5*(len(areas)-len(set(areas)))
            best.append((score,combo,M,sols[0]))
    best.sort(reverse=True,key=lambda x:x[0])
    return best[:5]

samples=[[(7,5),(10,5)],[(8,6),(9,6)],[(7,5),(7,1),(10,5)],[(8,6),(7,1),(9,6)],[(8,5),(7,1),(9,5)]]
for regs in samples:
    print('regions',regs)
    res=uniq(regs,len(regs))
    for score,combo,M,sol in res[:3]:
        print(score,combo,sol,M)
    print()
