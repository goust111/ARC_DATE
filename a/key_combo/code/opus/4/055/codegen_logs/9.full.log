+def _open_regions(rayed_grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    mask = rayed_grid != GREY
+    rectangles: list[dict] = []
+    other: list[dict] = []
+    for coords in components_mask(mask, connectivity=4):
+        bbox = bbox_coords(coords)
