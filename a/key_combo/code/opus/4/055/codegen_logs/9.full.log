+def _marker_role(coord: tuple[int, int], anchor_bbox: tuple[int, int, int, int]) -> tuple[str, tuple[int, int]] | None:
+    r, c = coord
+    r0, c0, r1, c1 = anchor_bbox
+    if r0 <= r <= r1 and c < c0:
+        return "left", (r, c0 - 1)
+    if r0 <= r <= r1 and c > c1:
+        return "right", (r, c1 + 1)
+    if c0 <= c <= c1 and r < r0:
