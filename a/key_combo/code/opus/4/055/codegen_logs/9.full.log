+        region = rectangles[region_idx]
+        r0, c0, r1, c1 = region["bbox"]
+        rh, rw = region["shape"]
+        sh, sw = sprite["crop"].shape
+        expected = np.tile(sprite["crop"], (rh // sh, rw // sw))
+        assert np.array_equal(out[r0 : r1 + 1, c0 : c1 + 1], expected)
+
