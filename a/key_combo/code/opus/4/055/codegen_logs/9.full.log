   298	def _choose_sprite_dims(region_shapes: list[tuple[int, int]]) -> tuple[list[tuple[int, int]], list[int]]:
   299	    best_score = None
   300	    best_choice = None
   301	    for dims in combinations(SPRITE_DIMS, len(region_shapes)):
   302	        count, assignment, compat = _count_unique_matchings(region_shapes, list(dims))
   303	        if count != 1 or assignment is None:
   304	            continue
   305	        areas = [h * w for h, w in dims]
   306	        duplicate_areas = len(areas) - len(set(areas))
   307	        edge_count = sum(sum(row) for row in compat)
   308	        ambiguous_rows = sum(sum(row) > 1 for row in compat)
   309	        ambiguous_cols = sum(sum(compat[r][c] for r in range(len(dims))) > 1 for c in range(len(region_shapes)))
   310	        score = duplicate_areas * 100 + edge_count * 10 + ambiguous_rows * 4 + ambiguous_cols * 4
   311	        if best_score is None or score > best_score:
   312	            best_score = score
   313	            best_choice = (list(dims), assignment)
   314	    if best_choice is None:
   315	        raise ValueError(f"no unique sprite tiling set for regions {region_shapes}")
   316	    return best_choice
