+        return False
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+        return False
+    mask = _frame_mask(grid.shape, (r0, c0, r1, c1))
+    return np.array_equal(np.argwhere(mask & (grid == color)), coords[np.lexsort((coords[:, 1], coords[:, 0]))])
