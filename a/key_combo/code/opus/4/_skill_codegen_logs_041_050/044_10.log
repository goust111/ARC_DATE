_GEN_DOMINO_AREA = 2
_GEN_DOMINO_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
_GEN_COUNTS = (5, 6, 7, 8, 9, 10, 11)
_GEN_COUNT_WEIGHTS = (1, 2, 3, 5, 10, 18, 28)
_GEN_ORIENTATIONS = ("h", "v")
