+def _validate_instance(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    frame_meta: list[dict[str, int]],
+    domino_meta: list[dict[str, int | bool]],
+) -> bool:
+    h, w = grid.shape
+    wall_row = h - 1
+    if max(grid.shape) > 30 or max(expected.shape) > 30:
+        return False
+    if not np.all(grid[wall_row, :] == WALL_COLOR):
+        return False
