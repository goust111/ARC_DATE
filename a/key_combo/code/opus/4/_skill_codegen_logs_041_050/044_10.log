+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = np.where(patch != BG, patch, dst[r0 : r0 + h, c0 : c0 + w])
