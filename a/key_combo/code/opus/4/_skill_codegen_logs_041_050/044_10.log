+    domino_meta: list[dict[str, int | bool]] = []
+    color_to_frame = {int(item["color"]): item for item in frame_meta}
+    domino_items = list(zip(colors, depths, orientations))
+    random.shuffle(domino_items)
+    for color, depth, vertical in domino_items:
+        bottom_row = wall_row - depth
+        patch = _domino_patch(color, vertical)
+        r0 = bottom_row - (1 if vertical else 0)
+        candidates = [
+            c0
+            for c0 in range(1, width - patch.shape[1])
+            if _can_place(occupied, patch, r0, c0, padding=1)
+        ]
