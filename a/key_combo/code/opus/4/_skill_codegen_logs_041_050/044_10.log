+        out[r0 : r0 + patch.shape[0], int(item["col"]) : int(item["col"]) + patch.shape[1]] = BG
+    frames_sorted = sorted(frame_meta, key=lambda item: int(item["col"]) + int(item["width"]) / 2.0)
