+    def backtrack(pos: int, used: set[int]) -> bool:
+        if pos == len(order):
+            has_full = any(chosen[i] == inner_heights[i] for i in range(len(chosen)))
+            has_partial = any(chosen[i] < inner_heights[i] for i in range(len(chosen)))
