+        c0 = int(item["col"])
+        out[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = BG
+    for frame in frame_meta:
+        dom = by_color[int(frame["color"])]
+        depth = int(wall_row - int(dom["row"]))
+        r0 = int(frame["row"])
+        c0 = int(frame["col"])
+        h = int(frame["height"])
+        w = int(frame["width"])
+        out[r0 + h - 1 - depth : r0 + h - 1, c0 + 1 : c0 + w - 1] = int(frame["color"])
+    return out
+
+
+def _make_instance() -> tuple[np.ndarray, np.ndarray, list[dict[str, int]], list[dict[str, int | bool]]]:
+    height = random.randint(18, 24)
+    width = random.randint(19, 26)
+    wall_row = height - 1
+    grid = np.zeros((height, width), dtype=int)
+    grid[wall_row, :] = WALL_COLOR
+    occupied = np.zeros_like(grid, dtype=bool)
+    occupied[wall_row, :] = True
+
+    frame_count = random.choice((3, 4))
+    colors = random.sample(FRAME_COLORS, frame_count)
+
+    frame_meta: list[dict[str, int]] = []
+    top_limit = min(10, height // 2)
+    dims_bank: list[tuple[int, int]] = []
+    inner_heights: list[int] = []
+    while len(dims_bank) < frame_count:
+        fh = random.choice((4, 5, 6, 7))
+        fw = random.choice((4, 5, 6, 7))
+        dims_bank.append((fh, fw))
+    random.shuffle(dims_bank)
+    if len({fh - 2 for fh, _ in dims_bank}) == frame_count:
+        i, j = random.sample(range(frame_count), 2)
+        dims_bank[j] = (dims_bank[i][0], dims_bank[j][1])
