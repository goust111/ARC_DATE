# Canvas and wall bounds.
_GEN_BG = 0
_GEN_WALL_COLOR = 2
_GEN_ROW_BOUNDS = (5, 10)
_GEN_COL_BOUNDS = (5, 11)
_GEN_WALL_THICKNESS = 1
_GEN_SIDES = ("top", "bottom", "left", "right")

