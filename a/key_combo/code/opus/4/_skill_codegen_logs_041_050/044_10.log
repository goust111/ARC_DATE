+    orientations = [False] * frame_count
+    orientations[vertical_partial_pick] = True
+    others = [i for i in range(frame_count) if i != vertical_partial_pick]
+    if others:
+        orientations[random.choice(others)] = False
+    if frame_count >= 3:
+        flip_candidates = [i for i in others if not orientations[i]]
+        if flip_candidates:
+            orientations[random.choice(flip_candidates)] = True
+    for i in range(frame_count):
