+    expected = _build_expected_from_meta(grid, frame_meta, domino_meta, wall_row)
+    return grid, expected, frame_meta, domino_meta
+
+
+def _validate_instance(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    frame_meta: list[dict[str, int]],
+    domino_meta: list[dict[str, int | bool]],
+) -> bool:
+    h, w = grid.shape
+    wall_row = h - 1
