+        r0 = int(item["row"]) - (1 if bool(item["vertical"]) else 0)
+        c0 = int(item["col"])
+        out[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = BG
+    for frame in frame_meta:
