+
+def _frame_patch(height: int, width: int, color: int) -> np.ndarray:
+    patch = np.zeros((height, width), dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    return patch
