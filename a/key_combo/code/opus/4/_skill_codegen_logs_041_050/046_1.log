+def _build_grid(
+    shape: tuple[int, int],
+    chain: list[tuple[int, int, int, int]],
+    controls: list[ControlInfo],
+    colors: list[int],
+) -> np.ndarray:
+    grid = np.full(shape, BG_COLOR, dtype=int)
