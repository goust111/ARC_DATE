+from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, in_bounds
+
+
+FRAME_COLOR = Color.GREY
+CONTROL_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW, Color.ORANGE)
+BG_COLOR = Color.BLACK
+GEN_RETRIES = 400
