+        "up": row - r0,
+        "down": r1 - row,
+        "left": col - c0,
+        "right": c1 - col,
+    }
+
+
+def _direction_step(name: str) -> tuple[int, int]:
+    return {
+        "up": (-1, 0),
+        "down": (1, 0),
+        "left": (0, -1),
+        "right": (0, 1),
