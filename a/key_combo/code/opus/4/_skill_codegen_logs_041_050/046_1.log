+        row=row,
+        col=col,
+        color=color,
+        depth=depth,
+        direction_name=direction_name,
+        direction=direction,
+        ray=tuple(ray),
+        nearest_distance=int(distances[direction_name]),
+        crosses_frame=depth >= int(distances[direction_name]),
