+def _distances_to_edges(bbox: tuple[int, int, int, int], row: int, col: int) -> dict[str, int]:
+    r0, c0, r1, c1 = bbox
+    return {
+        "up": row - r0,
+        "down": r1 - row,
+        "left": col - c0,
+        "right": c1 - col,
+    }
