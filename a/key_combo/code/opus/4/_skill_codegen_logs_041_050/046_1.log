+def _sample_chain(rng: np.random.Generator, height: int, width: int, frame_count: int) -> list[tuple[int, int, int, int]] | None:
+    min_outer_h = 5 + 4 * (frame_count - 1)
+    min_outer_w = 5 + 4 * (frame_count - 1)
