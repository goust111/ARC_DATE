+
+
+@dataclass(frozen=True)
+class ControlInfo:
+    row: int
+    col: int
+    color: int
+    depth: int
+    direction_name: str
+    direction: tuple[int, int]
+    ray: tuple[tuple[int, int], ...]
+    nearest_distance: int
+    crosses_frame: bool
+    differs_from_outer: bool
