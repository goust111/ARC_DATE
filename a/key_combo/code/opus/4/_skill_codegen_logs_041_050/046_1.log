+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    height = int(rng.integers(15, 23))
+    width = int(rng.integers(15, 23))
+    frame_count = int(rng.choice(np.array([2, 3], dtype=int), p=np.array([0.45, 0.55])))
