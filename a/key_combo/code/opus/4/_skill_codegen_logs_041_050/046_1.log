+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        rng = np.random.default_rng()
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate a valid nested-depth ray puzzle after {GEN_RETRIES} attempts")

