+def _extract_controls(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    comps = find_components(
+        grid,
+        bg=BG_COLOR,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    controls: list[tuple[int, int, int]] = []
+    for comp in comps:
