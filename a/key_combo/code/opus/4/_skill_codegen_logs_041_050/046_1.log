+        h = bbox_h(bbox)
+        w = bbox_w(bbox)
+        assert h >= 3 and w >= 3, "frame bbox must have an interior"
+        patch = crop_bbox(grid, bbox)
+        expected = _rect_frame_mask(bbox)
+        assert np.array_equal(patch == FRAME_COLOR, expected), "grey component must be a hollow rectangle"
+        bboxes.append(bbox)
