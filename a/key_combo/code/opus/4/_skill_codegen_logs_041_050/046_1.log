+def _rect_frame_mask(bbox: tuple[int, int, int, int]) -> np.ndarray:
+    h = bbox_h(bbox)
+    w = bbox_w(bbox)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _extract_frames(grid: np.ndarray) -> list[Frame]:
+    comps = find_components(
+        grid,
+        bg=BG_COLOR,
+        colors=[FRAME_COLOR],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    assert 2 <= len(comps) <= 3, "expected 2 or 3 grey frame components"
+
+    bboxes: list[tuple[int, int, int, int]] = []
+    for comp in comps:
+        bbox = tuple(map(int, comp["bbox"]))
+        h = bbox_h(bbox)
+        w = bbox_w(bbox)
+        assert h >= 3 and w >= 3, "frame bbox must have an interior"
+        patch = crop_bbox(grid, bbox)
+        expected = _rect_frame_mask(bbox)
+        assert np.array_equal(patch == FRAME_COLOR, expected), "grey component must be a hollow rectangle"
+        bboxes.append(bbox)
