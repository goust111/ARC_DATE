+
+            r0, c0, r1, c1 = current
+            child = (r0 + top_gap, c0 + left_gap, r1 - bottom_gap, c1 - right_gap)
+            if bbox_h(child) < min_child_h or bbox_w(child) < min_child_w:
+                continue
+            chain.append(child)
+            current = child
