+            colors[-1] = int(rng.choice([color for color in CONTROL_COLORS if color != colors[0]]))
+    return [int(color) for color in colors]
+
+
+def _build_grid(
+    shape: tuple[int, int],
+    chain: list[tuple[int, int, int, int]],
+    controls: list[ControlInfo],
+    colors: list[int],
+) -> np.ndarray:
