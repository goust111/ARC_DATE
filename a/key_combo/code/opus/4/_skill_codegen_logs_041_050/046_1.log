+        assert int(comp["area"]) == 1, "each control must be an isolated single pixel"
+        row, col = map(int, comp["coords"][0])
+        controls.append((row, col, color))
+    assert controls, "expected at least one control pixel"
+    controls.sort()
+    return controls
