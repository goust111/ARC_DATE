+            if backtrack(index + 1):
+                return True
+            chosen.pop()
+            used_controls.remove(pos)
+            for cell in candidate.ray:
+                if all(cell not in other.ray for other in chosen):
+                    used_ray.discard(cell)
+        return False
+
+    return chosen if backtrack(0) else None
