        offset = n * period

        _stamp_solid(out, original, r0 + offset, c0 + offset, bg)
        _stamp_solid(out, original, r0 + offset, c0 - offset, bg)

        _stamp_solid(out, rotated, r0 + h + offset, c0 + w + offset, bg)
        _stamp_solid(out, rotated, r0 + h + offset, c0 - h - offset, bg)

    return out

