+            return False
+    for pos in enabled - symmetric:
+        if not np.all(_macro_patch(out, pos) == RED):
+            return False
+    return True
+
+
+def _generate_case() -> np.ndarray | None:
+    size = random.choice(GRID_MACRO_OPTIONS)
+    base = _connected_corner_shape(size)
