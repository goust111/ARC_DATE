+    cluster = {random.choice(tuple(candidates))}
+
+    while len(cluster) < target:
+        frontier = []
+        for r, c in cluster:
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                nxt = (r + dr, c + dc)
+                if nxt in candidates and nxt not in cluster:
