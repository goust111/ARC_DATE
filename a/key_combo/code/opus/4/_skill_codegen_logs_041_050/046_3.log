+    return tuple(_rotate_pos(pos, size, turns) for turns in range(4))
+
+
+def _paint_block(grid: np.ndarray, pos: tuple[int, int], color: int) -> None:
+    mr, mc = map(int, pos)
+    r0 = mr * MACRO
+    c0 = mc * MACRO
+    grid[r0 : r0 + MACRO, c0 : c0 + MACRO] = int(color)
+
+
