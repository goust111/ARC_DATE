+
+def _rect_border_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = bbox
+    out[r0 : r1 + 1, c0] = True
+    out[r0 : r1 + 1, c1] = True
+    out[r0, c0 : c1 + 1] = True
+    out[r1, c0 : c1 + 1] = True
+    return out
