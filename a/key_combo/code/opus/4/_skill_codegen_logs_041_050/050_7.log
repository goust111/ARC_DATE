+
+        col_leaves = []
+        used_cols: set[int] = set()
+        for color in col_colors:
+            _sh, sw = _shape_dims(shapes[color])
+            candidates = [c for c in range(c0 + 1, c1 - sw + 1) if c not in used_cols]
+            if not candidates:
