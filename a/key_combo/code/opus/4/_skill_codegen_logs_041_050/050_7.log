+            return None
+        rr, cc = random.choice(candidates)
+        for dr, dc in np.argwhere(patch == int(color)):
+            grid[rr + int(dr), cc + int(dc)] = int(color)
+        occupied = grid != BG
+
+    return grid
+
+
+def _expected_output(
+    inp: np.ndarray,
+    valid_points: list[tuple[int, int, int]],
+    shapes: dict[int, np.ndarray],
+) -> np.ndarray:
