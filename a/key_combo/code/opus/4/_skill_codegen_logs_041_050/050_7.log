def _gen_choose_dims(n_rects: int) -> list[tuple[int, int]]:
    lo_budget, hi_budget = _GEN_AREA_BUDGET_BY_COUNT[n_rects]
    area_budget = random.randint(lo_budget, hi_budget)
    dims: list[tuple[int, int]] = []
