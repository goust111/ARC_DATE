+            cc = int(col + dc)
+            if out[rr, cc] == FILL:
+                out[rr, cc] = int(color)
+    return out
+
+
+def _generate_one() -> np.ndarray | None:
+    h = random.randint(20, 24)
+    w = random.randint(20, 24)
+    frame_h = random.randint(10, 13)
+    frame_w = random.randint(10, 13)
