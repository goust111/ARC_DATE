+    extras = _fill_missing_bends(rng, start, shapes, (H, W), next_id)
+    if extras is None:
+        return None
+    shapes.extend(extras)
+
+    grid = _render_input((H, W), start, shapes)
+    if not _semantic_checks(grid):
+        return None
+    return grid
