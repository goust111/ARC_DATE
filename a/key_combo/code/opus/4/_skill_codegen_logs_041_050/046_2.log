+def _render_input(shape: tuple[int, int], start: dict, shapes: list[dict]) -> np.ndarray:
+    grid = np.full(shape, INPUT_BG, dtype=int)
+    sr, sc = map(int, start["coords"][0])
+    grid[sr, sc] = INPUT_START
+    for shape_obj in shapes:
