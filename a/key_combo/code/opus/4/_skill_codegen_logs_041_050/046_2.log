+    g = np.asarray(grid, dtype=int)
+    bg, start, shapes = _parse_input(g)
+    out = g.copy()
+    current = start
+    unvisited = [shape.copy() for shape in shapes]
+    steps = []
+
+    while True:
+        candidates = []
+        for shape in unvisited:
+            step = _visible_step(g, bg, current, shape)
+            if step is None:
