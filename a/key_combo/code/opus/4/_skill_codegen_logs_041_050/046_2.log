+            extra = _place_shape(rng, current, bend, axis, GAP_OPTIONS_NEAR + GAP_OPTIONS_FAR, occupied, grid_shape, shape_id)
+            if extra is None:
+                continue
+            occupied.append(extra)
+            out.append(extra)
+            current = extra
+            shape_id += 1
+            break
+        else:
+            return None
+    return out
+
+
+def _generate_attempt() -> np.ndarray | None:
+    rng = random.Random()
