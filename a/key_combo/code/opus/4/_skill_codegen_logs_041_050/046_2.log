+    if np.array_equal(_nearest_visible_output(grid), out):
+        return False
+    if np.array_equal(_orange_only_output(grid), out):
+        return False
+    if np.array_equal(_recolor_only_output(grid), out):
+        return False
+    if len(multi_colors_visited) < 2:
+        return False
+    return True
