+                return None
+            occupied.append(competitor)
+            shapes.append(competitor)
+            next_id += 1
+
+        if idx == 1:
+            comp_axis = "v" if prev_axis == "h" else "h"
+            competitor = _place_shape(rng, current, competitor1_bend, comp_axis, GAP_OPTIONS_FAR, occupied, (H, W), next_id)
