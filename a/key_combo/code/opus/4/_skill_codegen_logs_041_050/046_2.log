+        if placed is None:
+            return None
+        occupied.append(placed)
+        shapes.append(placed)
+        next_id += 1
+
+        if idx == 0:
+            comp_axis = "v" if prev_axis == "h" else "h"
+            competitor = _place_shape(rng, current, competitor0_bend, comp_axis, GAP_OPTIONS_NEAR, occupied, (H, W), next_id)
