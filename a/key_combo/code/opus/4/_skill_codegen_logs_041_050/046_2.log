+            candidates.append({
+                "shape": shape,
+                "axis": step["axis"],
+                "band": step["band"],
+                "gap_len": step["gap_len"],
+                "distance": step["distance"],
+                "bend": int(shape["bend"]),
+                "bbox": tuple(map(int, shape["bbox"])),
+                "id": int(shape["id"]),
+            })
+
+        if not candidates:
+            break
+
+        if choose_by_bend:
+            candidates.sort(key=lambda item: (item["bend"], item["distance"], item["bbox"], item["id"]))
+        else:
