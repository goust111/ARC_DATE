+    for idx, bend in enumerate(path_bends):
+        axis_choices = ["h", "v"] if prev_axis is None else ([prev_axis, "v" if prev_axis == "h" else "h"] if rng.random() < 0.35 else ["v" if prev_axis == "h" else "h", prev_axis])
