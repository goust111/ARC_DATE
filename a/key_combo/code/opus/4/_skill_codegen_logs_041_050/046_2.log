+def _coord_distance(a: dict, b: dict) -> int:
+    da = a["coords"][:, None, :]
+    db = b["coords"][None, :, :]
+    return int(np.abs(da - db).sum(axis=2).min())
+
+
+def _center_r(node: dict) -> float:
+    r0, _c0, r1, _c1 = node["bbox"]
+    return (r0 + r1) / 2.0
+
+
+def _center_c(node: dict) -> float:
+    _r0, c0, _r1, c1 = node["bbox"]
+    return (c0 + c1) / 2.0
