+def _bbox_separated(a0: int, a1: int, b0: int, b1: int) -> tuple[int, int] | None:
+    if a1 < b0:
+        return int(a1 + 1), int(b0 - 1)
+    if b1 < a0:
+        return int(b1 + 1), int(a0 - 1)
+    return None
