+    dists = [_distance_map(passable, role["seed"]) for role in roles]
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            d0 = int(dists[0][r, c])
+            d1 = int(dists[1][r, c])
+            if d0 < 0 and d1 < 0:
