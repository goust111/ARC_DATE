+def _carve_box_area(grid: np.ndarray, bbox: tuple[int, int, int, int], pad: int = 1) -> None:
+    r0, c0, r1, c1 = bbox
+    rr0 = max(1, r0 - pad)
+    cc0 = max(1, c0 - pad)
+    rr1 = min(grid.shape[0] - 2, r1 + pad)
+    cc1 = min(grid.shape[1] - 2, c1 + pad)
+    grid[rr0 : rr1 + 1, cc0 : cc1 + 1] = BG
