+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _canonical_attempt()
+        if grid is not None and _validate_grid(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid maze-fill ARC input")

