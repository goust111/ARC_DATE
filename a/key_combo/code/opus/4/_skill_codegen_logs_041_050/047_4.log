+                        "color": int(color),
+                        "seed": (sr, sc),
+                        "frame_coords": frame,
+                        "bbox": bbox,
+                        "inner_black_area": int(np.sum(grid[r0 + 1 : r1, c0 + 1 : c1] == BG)),
