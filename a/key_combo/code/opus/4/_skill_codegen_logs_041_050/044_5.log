+
+def _transform_shape(shape: tuple[tuple[int, int], ...], rot: int, flip: bool) -> tuple[tuple[int, int], ...]:
+    pts = list(shape)
+    for _ in range(rot % 4):
+        pts = [(-c, r) for r, c in pts]
+    if flip:
+        pts = [(r, -c) for r, c in pts]
+    return _normalize(tuple(pts))
