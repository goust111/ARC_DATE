+def _normalize(shape: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    r0 = min(r for r, _ in shape)
+    c0 = min(c for _, c in shape)
+    return tuple(sorted((r - r0, c - c0) for r, c in shape))
