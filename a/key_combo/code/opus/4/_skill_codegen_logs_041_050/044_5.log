+def _validate_grid(grid: np.ndarray) -> bool:
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2:
+        return False
+    n, w = grid.shape
+    if n not in PANEL_SIZES or w != 2 * n:
+        return False
