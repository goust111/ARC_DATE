    ]
    if n == 5:
        options.extend([[4, 3, 1], [3, 2, 2, 1], [3, 3, 1, 1]])
    return list(RNG.choice(options))


def _can_place(cells: list[tuple[int, int]], occupied: set[tuple[int, int]], n: int) -> bool:
    cell_set = set(cells)
    if (0, 0) in cell_set:
