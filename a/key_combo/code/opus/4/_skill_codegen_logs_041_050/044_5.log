+    rep = RNG.choice(LEFT_COLORS)
+    other_colors = [c for c in LEFT_COLORS if c != rep]
+    mixed = force_mixed_top_left or RNG.random() < 0.6
+
+    if not mixed:
+        return {cell: rep for cell in cells}, rep
+
+    layout = {cell: rep for cell in cells}
