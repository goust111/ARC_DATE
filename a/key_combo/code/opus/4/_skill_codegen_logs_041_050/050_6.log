+    loser = q1 if winner == q0 else q0
+    _paint_cells(out, _cross_cells(results[winner]["final_center"]), BLUE)
+    _paint_cells(out, _cross_cells(results[loser]["final_center"]), GREEN)
+    return out, {"active": active, "results": results}
