+        quad = _quadrant_of(center, cross_r, cross_c)
+        assert quad not in sprites, "expected one sprite per quadrant"
+        sprites[quad] = {
+            "color": int(obj["color"]),
+            "coords": tuple(tuple(map(int, rc)) for rc in coords.tolist()),
+            "center": center,
+        }
