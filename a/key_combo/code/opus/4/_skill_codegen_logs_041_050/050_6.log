+    meta = {
+        "shape": shape,
+        "cross": cross,
+        "axis": axis,
+        "markers": markers,
+        "sprites": sprites,
+        "obstacles": {quad: set() for quad in QUADS},
+    }
+    if not _choose_active_obstacles(meta):
