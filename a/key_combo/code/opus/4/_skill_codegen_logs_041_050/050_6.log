+    if totals[0] != totals[1] and _sign(counts[0] - counts[1]) == _sign(totals[0] - totals[1]):
+        return False
+    if not (step_hits[0] < counts[0] or step_hits[1] < counts[1]):
+        return False
+    if not (totals[0] > counts[0] or totals[1] > counts[1]):
+        return False
