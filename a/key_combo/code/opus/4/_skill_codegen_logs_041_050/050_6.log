+get_bg = _ARC_UTILS.get_bg
+
+
+BG = 0
+BLUE = 1
+GREEN = 3
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+GRID_SHAPE = (14, 14)
+CROSS_ROW = 7
+CROSS_COL = 7
+SPRITE_COLORS = [2, 4, 6, 8]
+QUADS = ("TL", "TR", "BL", "BR")
+CROSS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+SLIDE_DIR = {
+    "TL": (1, 1),
+    "TR": (1, -1),
+    "BL": (-1, 1),
+    "BR": (-1, -1),
+}
+ACTIVE_BY_AXIS = {
+    "horizontal": ("TL", "BR"),
+    "vertical": ("TR", "BL"),
+}
+MAX_GEN_ATTEMPTS = 400
