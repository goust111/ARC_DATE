+
+def _step_targets(
+    center: tuple[int, int],
+    quad: str,
+    cross_r: int,
+    cross_c: int,
+    shape: tuple[int, int],
+) -> list[tuple[tuple[int, int], ...]]:
+    dr, dc = SLIDE_DIR[quad]
+    cur_r, cur_c = center
+    steps: list[tuple[tuple[int, int], ...]] = []
