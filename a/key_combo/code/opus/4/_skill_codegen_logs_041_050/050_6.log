+    return sim_meta["axis"] == meta["axis"]
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        meta = _meta_for_attempt()
+        if meta is None:
+            continue
+        if _validate_meta(meta):
