+    out = g.copy()
+    for info in analysis["free_infos"]:
+        coords = info["coords"]
+        rr = coords[:, 0]
+        cc = coords[:, 1]
+        if info["survives"]:
+            out[rr, cc] = int(info["dict_color"])
+        else:
+            out[rr, cc] = _BG
+    return out
