+            specs.append({"shape": ref["shape"], "permit": ref_color, "role": mode})
+        elif mode == "mismatch":
+            wrong = random.choice([color for color in ref_colors if color != ref_color])
+            specs.append({"shape": ref["shape"], "permit": wrong, "role": mode})
