    assert interior_h % 2 == 0 and interior_w % 2 == 0, "interior must split into equal halves"
    assert np.all(g[r0 + 1 : r1, c0 + 1 : c1] == bg), "frame interior must start empty"

    out = g.copy()
    for r in range(r0 + 1, r1):
