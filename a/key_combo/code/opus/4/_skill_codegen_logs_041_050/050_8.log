+        )
+    refs.sort(key=lambda item: item["bbox"])
+    return refs
+
+
+def _analyze_grid(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    refs = _extract_reference_entries(g)
+    assert 2 <= len(refs) <= 3, f"expected 2-3 reference frames, got {len(refs)}"
