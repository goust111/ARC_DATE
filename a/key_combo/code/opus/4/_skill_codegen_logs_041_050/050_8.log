+    out = g.copy()
+    for info in analysis["free_infos"]:
+        coords = info["coords"]
+        rr = coords[:, 0]
+        cc = coords[:, 1]
+        if info["survives"]:
+            out[rr, cc] = int(info["dict_color"])
+        else:
+            out[rr, cc] = _BG
+    return out
+
+
+def _rect_ok(rect: tuple[int, int, int, int], occupied: list[tuple[int, int, int, int]], pad: int = _PLACEMENT_PAD) -> bool:
