+        patch_border = np.zeros_like(patch, dtype=bool)
+        patch_border[0, :] = True
+        patch_border[-1, :] = True
+        patch_border[:, 0] = True
+        patch_border[:, -1] = True
+        if not np.all(patch[patch_border] == _GREY):
+            continue
+        if np.any(patch[1:-1, 1:-1] == _GREY):
+            continue
