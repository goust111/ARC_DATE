+_BG = 0
+_GREY = 5
+_REF_PALETTE = (1, 2, 3)
+_FREE_PALETTE = (4, 6, 7, 8, 9)
+_MAX_ATTEMPTS = 400
+_CONTROL_MIN_GAP = 5
+_PLACEMENT_PAD = 1
+_ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
