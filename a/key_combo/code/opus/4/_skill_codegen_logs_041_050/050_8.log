+    h, w = sprite.shape
+    patch = np.full((h + 2, w + 2), _BG, dtype=int)
+    patch[0, :] = _GREY
+    patch[-1, :] = _GREY
+    patch[:, 0] = _GREY
+    patch[:, -1] = _GREY
