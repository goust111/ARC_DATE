+
+
+def _paste_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    region = grid[top : top + h, left : left + w]
+    mask = patch != _BG
+    region[mask] = patch[mask]
