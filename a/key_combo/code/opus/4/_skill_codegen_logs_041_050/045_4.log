+    rows = np.unique(coords[:, 0])
+    if len(rows) != 1:
+        return None
+    cols = np.sort(coords[:, 1])
+    if int(cols[-1]) - int(cols[0]) + 1 != len(cols):
+        return None
+    if side == "left" and int(cols[0]) == 0:
+        return int(rows[0])
+    if side == "right" and int(cols[-1]) == patch.shape[1] - 1:
+        return int(rows[0])
+    return None
