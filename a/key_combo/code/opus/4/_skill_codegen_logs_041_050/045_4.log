+    c0, c1 = col_spans[cc]
+    return grid[r0 : r1 + 1, c0 : c1 + 1]
+
+
+def _marker_cell(
+    grid: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+) -> tuple[int, int]:
