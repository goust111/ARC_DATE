+
+
+def _bridge_segments(
+    sym_grid: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    bridges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    n_rows = len(row_spans)
