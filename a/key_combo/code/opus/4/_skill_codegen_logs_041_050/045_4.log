+    if coords.size == 0:
+        return None
+    cols = np.unique(coords[:, 1])
+    if len(cols) != 1:
+        return None
+    rows = np.sort(coords[:, 0])
+    if int(rows[-1]) - int(rows[0]) + 1 != len(rows):
+        return None
+    if side == "top" and int(rows[0]) == 0:
+        return int(cols[0])
+    if side == "bottom" and int(rows[-1]) == patch.shape[0] - 1:
