+        return None
+    if side == "left" and int(cols[0]) == 0:
+        return int(rows[0])
+    if side == "right" and int(cols[-1]) == patch.shape[1] - 1:
+        return int(rows[0])
+    return None
+
+
+def _facing_col(patch: np.ndarray, side: str) -> int | None:
