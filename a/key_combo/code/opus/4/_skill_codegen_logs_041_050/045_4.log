+
+def _cell_view(
+    grid: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    cr: int,
+    cc: int,
+) -> np.ndarray:
+    r0, r1 = row_spans[cr]
+    c0, c1 = col_spans[cc]
