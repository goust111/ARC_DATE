+            out[r0, lo : hi + 1] = RED
+        else:
+            lo, hi = sorted((r0, r1))
+            out[lo : hi + 1, c0] = RED
+    return out
+
+
+def _solve_with_debug(grid: np.ndarray) -> tuple[np.ndarray, dict]:
