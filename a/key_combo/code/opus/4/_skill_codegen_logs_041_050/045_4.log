+def _partition_spans(full_sep: np.ndarray) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for idx in np.flatnonzero(full_sep):
+        idx = int(idx)
+        if start <= idx - 1:
+            spans.append((start, idx - 1))
+        start = idx + 1
+    if start <= len(full_sep) - 1:
+        spans.append((start, len(full_sep) - 1))
+    return spans
