+def _orbit(cell: tuple[int, int], marker: tuple[int, int]) -> list[tuple[int, int]]:
+    cr, cc = cell
+    mr, mc = marker
+    return [
+        (cr, cc),
+        (cr, 2 * mc - cc),
+        (2 * mr - cr, cc),
+        (2 * mr - cr, 2 * mc - cc),
