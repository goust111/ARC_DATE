+    marker_rc = _marker_cell(g, row_spans, col_spans)
+    sym_grid = _apply_symmetry(g, row_spans, col_spans, marker_rc)
+    bridges = _bridge_segments(sym_grid, row_spans, col_spans)
+    out = _paint_bridges(sym_grid, bridges)
+    debug = {
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "marker_rc": marker_rc,
+        "sym_grid": sym_grid,
+        "bridges": bridges,
+    }
+    return out, debug
