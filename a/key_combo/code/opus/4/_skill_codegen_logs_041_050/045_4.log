+            coords = np.argwhere(patch == GREEN)
+            if coords.shape[0] != 4:
+                continue
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            if r1 - r0 == 1 and c1 - c0 == 1 and np.all(patch[r0 : r1 + 1, c0 : c1 + 1] == GREEN):
+                candidates.append((cr, cc))
+    assert len(candidates) == 1
+    return candidates[0]
