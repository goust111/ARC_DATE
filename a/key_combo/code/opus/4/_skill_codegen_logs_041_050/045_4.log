+        for top in range(n_rows):
+            top_patch = _cell_view(sym_grid, row_spans, col_spans, top, cc)
+            local_c = _facing_col(top_patch, "bottom")
+            if local_c is None:
+                continue
+            for bottom in range(top + 1, n_rows):
