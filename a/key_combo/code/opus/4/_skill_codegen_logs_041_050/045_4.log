+            (2 * mr - cr, cc, True, False),
+            (2 * mr - cr, 2 * mc - cc, True, True),
+        ]
+        for tr, tc, flip_ud, flip_lr in targets:
+            if not (0 <= tr < len(row_spans) and 0 <= tc < len(col_spans)):
