+from __future__ import annotations
+
+from importlib.machinery import SourceFileLoader
+from pathlib import Path
+import random
+
+import numpy as np
+
+
+_ARC_UTILS = SourceFileLoader(
+    "_shared_arc_utils_for_050_3",
+    str(Path("/home/lixinyu/snap/new/solvers/arc_utils.py")),
+).load_module()
+
+crop_bbox = _ARC_UTILS.crop_bbox
+find_components = _ARC_UTILS.find_components
+get_bg = _ARC_UTILS.get_bg
+paste = _ARC_UTILS.paste
+
+
+BG = 0
+MARKER = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+BOX_OPTIONS = [(4, 4), (4, 5), (5, 4), (5, 5)]
+AREA_MIN = 8
+AREA_MAX = 15
+MAX_GEN_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _interior_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if not mask[r, c]:
+                continue
+            if all(mask[nr, nc] for nr, nc in _neighbors4(r, c)):
+                cells.append((r, c))
+    return cells
+
+
+def _vertical_groups(mask: np.ndarray) -> list[list[tuple[int, int]]]:
