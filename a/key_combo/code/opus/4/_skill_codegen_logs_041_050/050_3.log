+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if not (dr == 0 and dc == 0)
+    ]
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    stack = [start]
+    seen = {start}
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def _touches_all_sides(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _interior_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    cells = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if not mask[r, c]:
+                continue
+            if all(mask[nr, nc] for nr, nc in _neighbors4(r, c)):
+                cells.append((r, c))
+    return cells
+
+
+def _vertical_groups(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    groups: list[list[tuple[int, int]]] = []
+    seen = set()
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or r not in {0, h - 1} and c not in {0, w - 1}:
+                continue
+            if (r, c) in seen:
+                continue
+            mc = w - 1 - c
+            group = sorted({(r, c), (r, mc)})
+            for cell in group:
+                seen.add(cell)
+            groups.append(group)
+    return groups
+
+
+def _border_cells(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] and (r in {0, h - 1} or c in {0, w - 1}):
+                out.append((r, c))
+    return out
