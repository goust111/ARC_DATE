+    for dr, dc in coords:
+        r = int(r0 + dr)
+        c = int(c0 + dc)
+        r1 = max(0, r - padding)
+        r2 = min(H, r + padding + 1)
+        c1 = max(0, c - padding)
+        c2 = min(W, c + padding + 1)
+        if np.any(occupied[r1:r2, c1:c2]):
