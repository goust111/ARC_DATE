+                group = groups.pop()
+                if int(mask.sum()) - len(group) < area:
+                    continue
+                test = mask.copy()
+                for r, c in group:
+                    test[r, c] = False
+                if not _touches_all_sides(test):
+                    continue
+                if not _mask_connected(test):
+                    continue
+                if len(_interior_cells(test)) < min_markers:
+                    continue
+                mask = test
+                removed += len(group)
