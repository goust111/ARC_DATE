+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or r not in {0, h - 1} and c not in {0, w - 1}:
+                continue
+            if (r, c) in seen:
+                continue
+            mc = w - 1 - c
+            group = sorted({(r, c), (r, mc)})
+            for cell in group:
+                seen.add(cell)
+            groups.append(group)
+    return groups
+
