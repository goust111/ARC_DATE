+                    (r, c)
+                    for r in range(H - obj["shape"][0] - 4, H - obj["shape"][0] - 1)
+                    for c in range(1, 5)
+                ]
+            else:
+                candidates = [
+                    (r, c)
+                    for r in range(H - obj["shape"][0] - 4, H - obj["shape"][0] - 1)
+                    for c in range(W - obj["shape"][1] - 5, W - obj["shape"][1] - 1)
+                ]
+        random.shuffle(candidates)
+        for r, c in candidates:
