+                if not _touches_all_sides(test):
+                    continue
+                if not _mask_connected(test):
+                    continue
+                if len(_interior_cells(test)) < min_markers:
+                    continue
+                mask = test
+                removed += len(group)
+            if int(mask.sum()) != area or removed == 0:
