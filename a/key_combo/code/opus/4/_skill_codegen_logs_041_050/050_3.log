+    out = g.copy()
+    erased_coords = erased["coords"]
+    out[erased_coords[:, 0], erased_coords[:, 1]] = bg
+
+    protected = out != bg
+    survivors = sorted(
+        [obj for obj in candidates if obj is not erased],
+        key=lambda obj: (obj["top_left"][0], obj["top_left"][1]),
+    )
