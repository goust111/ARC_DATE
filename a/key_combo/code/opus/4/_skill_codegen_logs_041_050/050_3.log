+def _can_place(occupied: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int = 1) -> bool:
+    h, w = patch.shape
+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    coords = np.argwhere(patch != BG)
+    for dr, dc in coords:
+        r = int(r0 + dr)
+        c = int(c0 + dc)
+        r1 = max(0, r - padding)
+        r2 = min(H, r + padding + 1)
+        c1 = max(0, c - padding)
+        c2 = min(W, c + padding + 1)
