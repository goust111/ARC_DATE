+    objects = []
+    for obj in find_components(g, bg=bg, connectivity=4, monochromatic=False):
+        coords = np.asarray(obj["coords"], dtype=int)
+        colors = sorted({int(g[r, c]) for r, c in coords if int(g[r, c]) != MARKER})
