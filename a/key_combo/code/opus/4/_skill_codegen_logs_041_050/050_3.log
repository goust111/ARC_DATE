+crop_bbox = _ARC_UTILS.crop_bbox
+find_components = _ARC_UTILS.find_components
+get_bg = _ARC_UTILS.get_bg
+paste = _ARC_UTILS.paste
+
+
+BG = 0
+MARKER = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+BOX_OPTIONS = [(4, 4), (4, 5), (5, 4), (5, 5)]
+AREA_MIN = 8
+AREA_MAX = 15
+MAX_GEN_ATTEMPTS = 400
