+def _scene_is_valid(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    motif_coords: set[tuple[int, int]],
+    motif_color: int,
+    stripe_cols: list[int],
+    stripe_color: int,
+    period: int,
+    corner_name: str,
+    controls: dict[tuple[int, int], int],
+) -> bool:
