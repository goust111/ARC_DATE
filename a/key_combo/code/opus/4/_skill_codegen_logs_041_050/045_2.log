+    max_count = max(counts.values())
+    tied = [color for color, count in counts.items() if count == max_count]
+    if len(tied) == 1:
+        return int(tied[0])
+
+    first_pos = {}
+    for color in tied:
+        positions = [(r, c) for r, c, col in points if col == color]
