+def _corner_coord(shape: tuple[int, int], name: str) -> tuple[int, int]:
+    h, w = shape
+    if name == "TL":
+        return 0, 0
+    if name == "TR":
+        return 0, w - 1
+    if name == "BL":
+        return h - 1, 0
+    if name == "BR":
+        return h - 1, w - 1
+    raise ValueError(f"unknown corner name: {name}")
