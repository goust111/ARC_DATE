+
+def _stripe_columns(width: int, start_col: int, period: int) -> list[int]:
+    if start_col == 0:
+        return list(range(0, width, period))
+    return list(range(width - 1, -1, -period))
+
+
+def _render_output(
+    shape: tuple[int, int],
