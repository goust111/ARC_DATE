+def _frame_dimensions(qsize: int) -> tuple[int, int]:
+    height_choices = [6]
+    width_choices = [9]
+    if qsize >= 13:
+        height_choices.append(7)
+        width_choices.append(11)
+    return random.choice(height_choices), random.choice(width_choices)
+
