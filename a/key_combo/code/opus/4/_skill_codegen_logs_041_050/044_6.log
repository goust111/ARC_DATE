+        return False
+    if int(comp["area"]) != 2 * (h + w) - 4:
+        return False
+    patch = quad_grid[r0 : r1 + 1, c0 : c1 + 1]
+    border = _frame_border_mask(h, w)
+    if not np.all(patch[border] == color):
+        return False
+    if h > 2 and w > 2 and np.any(patch[1:-1, 1:-1] == color):
+        return False
+    return True
