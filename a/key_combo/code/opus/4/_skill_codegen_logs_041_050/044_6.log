+
+def _normalized_shape(shape: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    min_r = min(r for r, _ in shape)
+    min_c = min(c for _, c in shape)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in shape))
