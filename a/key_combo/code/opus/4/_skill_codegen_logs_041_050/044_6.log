+    gc0 = cs.start + frame_c0
+    gr1 = rs.start + frame_r1
+    gc1 = cs.start + frame_c1
+    return {
+        "quad": quad,
+        "color": color,
+        "count": len(sprites),
+        "frame_bbox": (gr0, gc0, gr1, gc1),
+        "frame_bbox_local": (frame_r0, frame_c0, frame_r1, frame_c1),
+        "sprites": sprites,
+        "quad_slice": (rs, cs),
+        "quad_grid": quad_grid,
