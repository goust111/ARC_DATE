+        r0, c0, r1, c1 = info["frame_bbox"]
+        inner_r0, inner_c0 = r0 + 1, c0 + 1
+        inner_r1, inner_c1 = r1 - 1, c1 - 1
+        inner_h = inner_r1 - inner_r0 + 1
+        inner_w = inner_c1 - inner_c0 + 1
