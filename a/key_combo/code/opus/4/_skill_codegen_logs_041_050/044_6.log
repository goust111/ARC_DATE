+def _analyze_quadrant(grid: np.ndarray, mid_r: int, mid_c: int, quad: tuple[int, int], bg: int) -> dict:
+    rs, cs = _quadrant_slice(grid.shape, mid_r, mid_c, quad)
+    quad_grid = grid[rs, cs]
