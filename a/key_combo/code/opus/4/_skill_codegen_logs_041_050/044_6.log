+    for sprite in sprites:
+        sr0, sc0, sr1, sc1 = map(int, sprite["bbox"])
+        assert not (frame_r0 <= sr0 <= frame_r1 and frame_c0 <= sc0 <= frame_c1), "sprite cannot lie inside frame bbox"
