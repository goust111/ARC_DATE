+def _pyramid_patch(height: int, color: int, flip_h: bool, flip_v: bool) -> np.ndarray:
+    patch = np.zeros((height, 2 * height - 1), dtype=int)
+    center = height - 1
+    for r in range(height):
+        half = r
+        patch[r, center - half : center + half + 1] = color
+    if flip_h:
+        patch = np.fliplr(patch)
+    if flip_v:
