+            return False
+        (_, _), chosen = random.choice(candidates)
+        cells = np.array(chosen, dtype=int)
+        anchor = random.choice([cand for cand in candidates if cand[1] == chosen])[0]
+        for dr, dc in chosen:
+            rr = anchor[0] + dr
+            cc = anchor[1] + dc
+            quad[rr, cc] = color
