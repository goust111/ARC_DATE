+def _quadrant_slice(shape: tuple[int, int], mid_r: int, mid_c: int, quad: tuple[int, int]) -> tuple[slice, slice]:
+    h, w = shape
+    qb, qr = quad
+    rs = slice(0, mid_r) if qb == 0 else slice(mid_r + 1, h)
+    cs = slice(0, mid_c) if qr == 0 else slice(mid_c + 1, w)
+    return rs, cs
