+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for nr in range(rr - 1, rr + 2):
+            for nc in range(cc - 1, cc + 2):
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
