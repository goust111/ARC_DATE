+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        out[rr, cc] = True
+        for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
