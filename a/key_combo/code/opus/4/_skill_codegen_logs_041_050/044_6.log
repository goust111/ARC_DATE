+    for info in infos:
+        rs, cs = info["quad_slice"]
+        quad_out = out[rs, cs]
+        color = int(info["color"])
+        fr0, fc0, fr1, fc1 = info["frame_bbox_local"]
+        outside = np.ones_like(quad_out, dtype=bool)
+        outside[fr0 : fr1 + 1, fc0 : fc1 + 1] = False
+        if np.any(quad_out[outside] == color):
