+def _frame_is_centered(quad_grid: np.ndarray, info: dict) -> bool:
+    r0, c0, r1, c1 = info["frame_bbox_local"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    expected_r0 = (quad_grid.shape[0] - h) // 2
+    expected_c0 = (quad_grid.shape[1] - w) // 2
+    return r0 == expected_r0 and c0 == expected_c0
