+    fr0, fc0, fr1, fc1 = frame_bbox
+    blocked[fr0 : fr1 + 1, fc0 : fc1 + 1] = True
+    blocked = _dilate8(blocked)
+    placed_mask = np.zeros_like(quad, dtype=bool)
