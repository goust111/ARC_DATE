+def random_polyomino(rng: random.Random, size: int) -> list[tuple[int, int]]:
+    cells = {(0, 0)}
+    while len(cells) < size:
+        frontier = set()
+        for r, c in cells:
+            for nr, nc in neighbors4(r, c):
+                if (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        cells.add(rng.choice(sorted(frontier)))
