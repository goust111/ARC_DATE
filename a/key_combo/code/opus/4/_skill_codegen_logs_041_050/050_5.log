+                block_w = col_band[1] - col_band[0] + 1
+                try:
+                    patch = _generate_pattern(block_h, block_w)
+                except RuntimeError:
+                    ok = False
+                    break
+                grid[row_band[0] : row_band[1] + 1, col_band[0] : col_band[1] + 1] = patch
+            if not ok:
+                break
+        if not ok:
+            continue
+
+        try:
+            _semantic_check(grid)
+        except AssertionError:
