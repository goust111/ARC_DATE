+    claimed = np.zeros_like(g, dtype=bool)
+    if sep_rows:
+        claimed[sep_rows, :] = True
+    if sep_cols:
+        claimed[:, sep_cols] = True
+    assert np.array_equal(g == sep_color, claimed), "separator pixels must form full rows/columns"
