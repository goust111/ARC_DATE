+def _drop_objects(grid: np.ndarray, objects: list[dict]) -> tuple[np.ndarray, list[dict]]:
+    out = np.asarray(grid, dtype=int).copy()
+    for obj in objects:
+        coords = obj["coords"]
+        out[coords[:, 0], coords[:, 1]] = BG
