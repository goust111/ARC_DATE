+
+def _is_channel(component: dict) -> bool:
+    if int(component["color"]) != FRAME:
+        return False
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 2 or w < 4:
+        return False
+    expected = {(r1, c) for c in range(c0, c1 + 1)}
+    for r in range(r0, r1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    return _coord_set(component["coords"]) == expected
