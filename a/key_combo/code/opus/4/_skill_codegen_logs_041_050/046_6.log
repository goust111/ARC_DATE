    for n in range(-limit, limit + 1):
        offset = n * period
        add_stamp(0, h, w, r0 + offset, c0 + offset, 0)
        add_stamp(1, h, w, r0 + offset, c0 - offset, 0)
        add_stamp(0, w, h, r0 + h + offset, c0 + w + offset, 1)
        add_stamp(1, w, h, r0 + h + offset, c0 - h - offset, 1)

