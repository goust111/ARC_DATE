+        return False
+    expected = {(r1, c) for c in range(c0, c1 + 1)}
+    for r in range(r0, r1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    return _coord_set(component["coords"]) == expected
+
+
+def _detect_channels(grid: np.ndarray) -> list[dict]:
+    channels = [
