+
+
+def _build_instance(rng: random.Random) -> np.ndarray | None:
+    laid_out = _layout(rng)
+    if laid_out is None:
+        return None
+    height, width, channels = laid_out
+    areas, smallest_survives = _choose_areas(rng)
