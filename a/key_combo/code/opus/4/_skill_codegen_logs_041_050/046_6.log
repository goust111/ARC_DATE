+
+def _match_channels(objects: list[dict], channels: list[dict]) -> list[tuple[dict, dict]]:
+    pairs: list[tuple[dict, dict]] = []
+    used = set()
+    for obj in objects:
+        _r0, oc0, _r1, oc1 = map(int, obj["bbox"])
+        candidates = []
