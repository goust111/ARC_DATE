+def _duplicate_partitions(duplicate_total: int) -> list[tuple[int, ...]]:
+    parts = set()
+    for first in (2, 3):
+        if first == duplicate_total:
+            parts.add((first,))
+        for second in (2, 3):
+            if first + second == duplicate_total:
