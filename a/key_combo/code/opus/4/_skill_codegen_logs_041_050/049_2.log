+def _mask_from_relative_coords(coords: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in coords:
+        mask[int(r), int(c)] = True
+    return mask
