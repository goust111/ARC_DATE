+        cols = [c for _, c in cells]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        cropped = {(r - r0, c - c0) for r, c in cells}
+        if len({r for r, _ in cropped}) == 1 or len({c for _, c in cropped}) == 1:
+            continue
+        hh = r1 - r0 + 1
+        ww = c1 - c0 + 1
+        mask = np.zeros((hh, ww), dtype=bool)
