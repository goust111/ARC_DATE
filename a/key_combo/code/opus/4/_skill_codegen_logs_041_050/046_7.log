+    out = np.zeros(shape, dtype=int)
+
+    sr, sc = source_anchor
+    inp[sr, sc] = ANCHOR
+    for (dr, dc), color in offsets.items():
+        rr = sr + dr
+        cc = sc + dc
+        inp[rr, cc] = color
