+def _is_connected(nodes: set[tuple[int, int]]) -> bool:
+    if not nodes:
+        return False
+    todo = [next(iter(nodes))]
+    seen = set()
+    while todo:
+        cur = todo.pop()
+        if cur in seen:
+            continue
+        seen.add(cur)
+        for nxt in _neighbors4(cur):
+            if nxt in nodes and nxt not in seen:
+                todo.append(nxt)
+    return seen == nodes
