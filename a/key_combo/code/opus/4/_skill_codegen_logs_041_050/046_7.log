+        colored = coords[(vals != BG) & (vals != ANCHOR)]
+        assert colored.shape[0] >= 1, "each anchor region must contain at least one colored pixel"
+        offsets = {}
+        for r, c in colored:
+            rr = int(r)
+            cc = int(c)
+            offsets[(rr - anchor_r, cc - anchor_c)] = int(grid[rr, cc])
