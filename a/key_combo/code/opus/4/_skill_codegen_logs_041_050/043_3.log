        (0xF0, 0x12, 0xBE),  # 6 magenta/pink
        (0xFF, 0x85, 0x1B),  # 7 orange
        (0x7F, 0xDB, 0xFF),  # 8 teal/azure
        (0x87, 0x0C, 0x25),  # 9 maroon
        (0xFF, 0xFF, 0xFF),  # 10 white
        (0x00, 0x00, 0x00),  # 11 pad fallback
