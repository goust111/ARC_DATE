+
+def _transform_cell(cell: tuple[int, int], name: str) -> tuple[int, int]:
+    r, c = cell
+    if name == "identity":
+        return r, c
+    if name == "flip_lr":
+        return r, GRID_SIDE - 1 - c
+    if name == "flip_ud":
+        return GRID_SIDE - 1 - r, c
+    if name == "rot180":
+        return GRID_SIDE - 1 - r, GRID_SIDE - 1 - c
+    raise ValueError(name)
