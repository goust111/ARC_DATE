+def _build_grid(cell_h: int, cell_w: int) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    h = GRID_SIDE * cell_h + 3
+    w = GRID_SIDE * cell_w + 3
