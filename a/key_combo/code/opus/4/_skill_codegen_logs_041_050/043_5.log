+def _place_marker(grid: np.ndarray, row_spans: list[tuple[int, int]], col_spans: list[tuple[int, int]], cell: tuple[int, int], color: int) -> None:
+    cr, cc = cell
+    r0, r1 = row_spans[cr]
+    c0, c1 = col_spans[cc]
+    rr = random.randint(r0, r1 - 1)
+    cc0 = random.randint(c0, c1 - 1)
+    grid[rr, cc0] = color
+
