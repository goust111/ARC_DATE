+    cr, cc = cell
+    r0, r1 = row_spans[cr]
+    c0, c1 = col_spans[cc]
+    cell_h = r1 - r0
+    cell_w = c1 - c0
+    mh, mw = mask.shape
+    assert mh <= cell_h and mw <= cell_w
+    off_r = random.randint(0, cell_h - mh)
+    off_c = random.randint(0, cell_w - mw)
