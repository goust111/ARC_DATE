+    template, sprites, shape = _parse_scene(grid)
+    aligned_sets = [
+        {
+            "color": sprite["color"],
+            "distance": _center_manhattan_twice(sprite["bbox"], template["bbox"]),
+            "coords": _aligned_coords(template, sprite, shape, align=True),
+        }
+        for sprite in sprites
