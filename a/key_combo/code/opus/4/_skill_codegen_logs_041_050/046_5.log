+        rect_h = rng.randint(4, max_h)
+        rect_w = rng.randint(4, max_w)
+        r0 = rng.randint(1, H - rect_h - 1)
+        c0 = rng.randint(1, W - rect_w - 1)
+        r1 = r0 + rect_h - 1
+        c1 = c0 + rect_w - 1
+        crosses_line = any(r0 <= rr <= r1 for rr in orange_rows) or any(c0 <= cc <= c1 for cc in orange_cols)
