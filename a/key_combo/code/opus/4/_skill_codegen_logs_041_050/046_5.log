+    return grid
+
+
+def _occlude(grid: np.ndarray, rect: tuple[int, int, int, int]) -> np.ndarray:
+    out = grid.copy()
+    r0, c0, r1, c1 = rect
+    for rr in range(r0, r1 + 1):
+        for cc in range(c0, c1 + 1):
+            if int(out[rr, cc]) != ORANGE:
+                out[rr, cc] = GREY
+    return out
+
+
+def _validate_instance(inp: np.ndarray) -> bool:
