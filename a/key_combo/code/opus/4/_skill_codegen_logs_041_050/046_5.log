+    hidden = [orbit for orbit in candidates if orbit["hidden_total"] > 0]
+    visible = [orbit for orbit in candidates if orbit["hidden_total"] == 0]
+    hidden_regions = {region for orbit in hidden for region in orbit["hidden_counts"]}
+    if len(hidden) < 4 or len(visible) < 8 or len(hidden_regions) < 2:
+        return None
+
+    rng.shuffle(hidden)
+    rng.shuffle(visible)
+    pool = hidden[:8] + visible[:12]
+    rng.shuffle(pool)
+
+    inp = _search_input(H, W, orange_rows, orange_cols, rect, pool, rng)
+    if inp is None or not _validate_instance(inp):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid mirrored-occlusion partition instance")

