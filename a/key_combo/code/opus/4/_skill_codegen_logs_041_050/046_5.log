+            lambda orbit, reg=region, color=alt: (
+                4 * orbit["region_counts"][reg]
+                + sum(orbit["region_counts"][other] for other in orbit["region_counts"] if targets[other] == color)
+            ),
+        )
+        if visible_pick is not None:
+            add_assignment(visible_pick, alt)
+
+    goal = 3 if len(regions) >= 12 else 4
+    for _ in range(40):
+        deficits = [
+            (goal - counts_rest[region][targets[region]], region)
+            for region in regions
+            if counts_rest[region][targets[region]] < goal
+        ]
+        if not deficits:
+            break
+        deficits.sort(reverse=True)
+
+        placed = False
+        for _deficit, region in deficits:
+            target = targets[region]
+            pick = _pick_best_candidate(
+                remaining,
+                lambda orbit, reg=region: reg in orbit["region_counts"],
+                lambda orbit, reg=region, color=target: (
+                    4 * orbit["region_counts"][reg]
+                    + 2 * orbit["hidden_counts"].get(reg, 0)
+                    + sum(2 * orbit["region_counts"][other] for other in orbit["region_counts"] if targets[other] == color)
+                    - sum(orbit["region_counts"][other] for other in orbit["region_counts"] if targets[other] != color)
+                ),
+            )
+            if pick is None:
+                continue
+            add_assignment(pick, target)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+        if len(assignments) >= 24:
+            break
+
+    if any(counts_rest[region][targets[region]] < goal for region in regions):
+        return None
+
+    extra_budget = rng.randint(3, 7)
+    for _ in range(extra_budget):
+        if not remaining or len(assignments) >= 28:
+            break
+        orbit = _pick_best_candidate(
+            remaining,
+            lambda _orbit: True,
+            lambda orbit: 3 * orbit["hidden_total"] + len(orbit["region_counts"]),
+        )
+        if orbit is None:
+            break
+
+        touched = list(orbit["region_counts"].keys())
+        focus = rng.choice(touched)
+        if rng.random() < 0.6:
+            color = targets[focus]
+        else:
+            color = rng.choice([c for c in PATTERN_COLORS if c != targets[focus]])
+        add_assignment(orbit, color)
+
+    full = _render_pattern((H, W), orange_rows, orange_cols, assignments)
+    inp = _occlude(full, rect)
+    if not _validate_instance(inp):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid mirrored-occlusion partition instance")

