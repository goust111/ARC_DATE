+def _dominant(counter: Counter) -> tuple[int | None, bool]:
+    if not counter:
+        return None, False
+    best = counter.most_common()
+    top = best[0][1]
+    winners = [color for color, count in best if count == top]
+    if len(winners) != 1:
+        return None, False
+    return int(winners[0]), True
