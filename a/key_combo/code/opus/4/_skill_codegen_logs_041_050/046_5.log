+            cells = _orbit_cells(H, W, r, c)
+            if any(rr in orange_rows or cc in orange_cols for rr, cc in cells):
+                continue
+
+            hidden = tuple(_in_rect(rect, rr, cc) for rr, cc in cells)
+            if sum(hidden) == 4:
+                continue
+            recoverable = True
+            for (rr, cc), is_hidden in zip(cells, hidden):
+                if not is_hidden:
