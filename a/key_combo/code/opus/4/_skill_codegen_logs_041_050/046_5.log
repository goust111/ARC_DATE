+    out = g.copy()
+    for rr, cc in np.argwhere(g == GREY):
+        rr = int(rr)
+        cc = int(cc)
+        if rr in orange_rows or cc in orange_cols:
+            continue
+        partners = ((rr, W - 1 - cc), (H - 1 - rr, cc), (H - 1 - rr, W - 1 - cc))
+        for pr, pc in partners:
+            color = int(g[pr, pc])
+            if color not in (GREY, ORANGE):
+                out[rr, cc] = color
+                break
