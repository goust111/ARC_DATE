+            colors = [int(v) for v in patch[valid].flat if int(v) in PATTERN_COLORS]
+            counts[(ri, ci)] = Counter(colors)
+    return counts, row_spans, col_spans
+
+
+def _dominant(counter: Counter) -> tuple[int | None, bool]:
+    if not counter:
