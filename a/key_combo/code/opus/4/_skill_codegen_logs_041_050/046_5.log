+            region_counts: Counter = Counter()
+            hidden_counts: Counter = Counter()
+            for (rr, cc), is_hidden in zip(cells, hidden):
+                region = _region_id(rr, cc, orange_rows, orange_cols)
+                assert region is not None
+                region_counts[region] += 1
+                if is_hidden:
