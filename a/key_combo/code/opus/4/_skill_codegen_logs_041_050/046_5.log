+    if best_input is not None and best_penalty == 0:
+        return best_input
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    H = rng.choice((17, 19, 21, 23))
+    W = rng.choice((17, 19, 21, 23))
+
+    orange_rows = _sample_lines(H, rng)
+    orange_cols = _sample_lines(W, rng)
+    if orange_rows is None or orange_cols is None:
+        return None
+
+    rect = _sample_rect(H, W, orange_rows, orange_cols, rng)
+    if rect is None:
+        return None
+
+    candidates = _build_candidates(H, W, orange_rows, orange_cols, rect)
+    if len(candidates) < 16:
+        return None
+
+    hidden = [orbit for orbit in candidates if orbit["hidden_total"] > 0]
+    visible = [orbit for orbit in candidates if orbit["hidden_total"] == 0]
+    hidden_regions = {region for orbit in hidden for region in orbit["hidden_counts"]}
