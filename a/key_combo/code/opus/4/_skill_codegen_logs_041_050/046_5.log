    rect=(r0,c0,r0+rect_h-1,c0+rect_w-1)
    orows=set(orange_rows); ocols=set(orange_cols)
    center_r, center_c = H//2, W//2
    def inrect(r,c): return rect[0]<=r<=rect[2] and rect[1]<=c<=rect[3]
    def region_id(r,c):
        if r in orows or c in ocols: return None
