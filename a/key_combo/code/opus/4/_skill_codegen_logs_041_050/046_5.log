+BLUE = Color.BLUE
+RED = Color.RED
+GREEN = Color.GREEN
+YELLOW = Color.YELLOW
+GREY = Color.GREY
+ORANGE = Color.ORANGE
+PATTERN_COLORS = (BLUE, RED, GREEN, YELLOW)
+GEN_RETRIES = 500
