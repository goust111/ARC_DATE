+def _region_counts(
+    grid: np.ndarray,
+    orange_rows: list[int],
+    orange_cols: list[int],
+    *,
+    ignore_grey: bool,
+) -> tuple[dict[tuple[int, int], Counter], list[tuple[int, int]], list[tuple[int, int]]]:
