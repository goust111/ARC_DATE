      if len(best)"'!=1: good=False; break
      reps.append(best[0])
      v2=vis[reg]; m2=max(v2.values()); best2=[c for c,v in v2.items() if v==m2 and v>0]
      if len(best2)!=1 or best2[0]!=best[0]: changed+=1
    if good and changed>=1 and len(set(reps))>=2:
