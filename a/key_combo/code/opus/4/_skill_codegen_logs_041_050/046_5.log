        if isinstance(c, float):
            c = int(round(c))
        return r, c

    def __repr__(self):
        return f"MirrorSymmetry(mirror_r={self.mirror_r}, mirror_c={self.mirror_c})"

    def __str__(self):
        return self.__repr__()

