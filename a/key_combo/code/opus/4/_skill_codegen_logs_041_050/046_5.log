+    for orbit in remaining:
+        if predicate(orbit):
+            scored.append((score_fn(orbit), random.random(), orbit))
+    if not scored:
+        return None
+    scored.sort(key=lambda item: (item[0], item[1]), reverse=True)
+    return scored[0][2]
