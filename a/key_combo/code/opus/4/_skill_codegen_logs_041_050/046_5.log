+
+
+def _sample_rect(
+    H: int,
+    W: int,
+    orange_rows: list[int],
+    orange_cols: list[int],
+    rng: random.Random,
+) -> tuple[int, int, int, int] | None:
+    max_h = min(8, H - 2)
+    max_w = min(8, W - 2)
