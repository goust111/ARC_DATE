import random, numpy as np

COLORS=[1,2,3,4]
for trial in range(50):
    H=W=random.choice([15,17,19,21])
    orange_rows=sorted(random.sample(range(2,H-2), random.choice([2,3])))
    orange_cols=sorted(random.sample(range(2,W-2), random.choice([2,3])))
    # ensure gaps >=3 and regions >=3x3
    def ok(lines,n):
        pts=[-1]+sorted(lines)+[n]
        lens=[pts[i+1]-pts[i]-1 for i in range(len(pts)-1)]
        return len(lens)>=3 and min(lens)>=2
    if not ok(orange_rows,H) or not ok(orange_cols,W):
        continue
    rect_h=random.randint(4,7); rect_w=random.randint(4,7)
