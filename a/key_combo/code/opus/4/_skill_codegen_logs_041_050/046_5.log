            blue_gate.add(pos)
    for pos in outside[1:]:
        if len(distractors) >= 4:
            break
        if random.random() < 0.28:
            distractors.add(pos)

    enabled = blue_gate | distractors
    assert blue_gate
    assert blocked not in enabled
    assert distractors - symmetric
    return enabled


