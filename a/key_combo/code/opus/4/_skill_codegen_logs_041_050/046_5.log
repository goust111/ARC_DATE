+def _intervals(lines: list[int], length: int) -> list[tuple[int, int]]:
+    pts = [-1, *sorted(map(int, lines)), int(length)]
+    spans = []
+    for left, right in zip(pts, pts[1:]):
+        if left + 1 <= right - 1:
+            spans.append((left + 1, right - 1))
+    return spans
