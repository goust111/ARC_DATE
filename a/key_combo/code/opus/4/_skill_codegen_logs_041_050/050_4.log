+        marker_col = marker_cols[spec["marker_idx"]]
+        c0 = marker_col - frame_w // 2
+        c1 = marker_col + frame_w // 2
+        grid[r0, c0 : c1 + 1] = GREY
+        grid[r1, c0 : c1 + 1] = GREY
+        grid[r0 : r1 + 1, c0] = GREY
+        grid[r0 : r1 + 1, c1] = GREY
