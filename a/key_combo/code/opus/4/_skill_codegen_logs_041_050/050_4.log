+        frame = {
+            "kind": spec["kind"],
+            "marker_idx": int(spec["marker_idx"]),
+            "marker_col": int(marker_col),
+            "r0": int(r0),
+            "c0": int(c0),
+            "r1": int(r1),
+            "c1": int(c1),
