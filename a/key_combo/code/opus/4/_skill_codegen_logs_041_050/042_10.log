+
+GEN_ATTEMPTS = 600
+GRID_SIDE_RANGE = (22, 28)
+BLOCK_COUNT_CHOICES = (3, 4)
+BLOCK_TOPLEFT_MARGIN = 2
+MIN_BLOCK_CHEBYSHEV = 8
+BLOCKED_RAY_DISTANCE_RANGE = (6, 10)
