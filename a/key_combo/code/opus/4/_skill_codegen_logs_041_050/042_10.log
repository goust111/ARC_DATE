+    grid = _assign_markers(base, obstacles)
+    if grid is None:
+        return None
+    if not _generator_checks(grid, require_block_stop):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
