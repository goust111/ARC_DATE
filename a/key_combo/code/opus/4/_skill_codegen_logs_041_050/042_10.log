+                    return False
+
+        expected = _render_output(grid, rays, obstacles)
+        actual = main(grid)
+        return bool(np.array_equal(actual, expected))
+    except Exception:
+        return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    shape = (
+        random.randint(*GRID_SIDE_RANGE),
+        random.randint(*GRID_SIDE_RANGE),
