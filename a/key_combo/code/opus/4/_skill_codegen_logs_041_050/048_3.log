+    sep_rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == SEP)]
+    assert len(sep_rows) == 2, "expected exactly two full-width grey separator rows"
+    top_h = sep_rows[0]
+    mid_h = sep_rows[1] - sep_rows[0] - 1
+    bot_h = g.shape[0] - sep_rows[1] - 1
