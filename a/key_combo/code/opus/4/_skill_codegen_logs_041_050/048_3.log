+    panel_h, panel_w = panels[0].shape
+    grid = np.zeros((panel_h * PANEL_COUNT + 2, panel_w), dtype=int)
+    grid[:panel_h, :] = panels[0]
+    grid[panel_h, :] = SEP
+    grid[panel_h + 1 : 2 * panel_h + 1, :] = panels[1]
+    grid[2 * panel_h + 1, :] = SEP
+    grid[2 * panel_h + 2 :, :] = panels[2]
+    return grid
