+    (4, 1), (4, 2), (5, 2), (5, 1),
+    (4, 0), (5, 0), (2, 1), (1, 1),
+]
+_B_ORDER = [
+    (1, 2), (1, 3), (1, 4), (2, 4),
+    (0, 4), (0, 5), (1, 5), (2, 5),
+    (0, 3), (0, 6), (1, 6), (2, 6),
