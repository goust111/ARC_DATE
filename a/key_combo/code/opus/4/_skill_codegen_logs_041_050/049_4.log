+    dc = int(b[1] - a[1])
+    if abs(dr) != abs(dc):
+        return []
+    sr = _sign(dr)
+    sc = _sign(dc)
+    return [(a[0] + k * sr, a[1] + k * sc) for k in range(1, abs(dr))]
