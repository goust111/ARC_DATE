+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+RNG = np.random.default_rng()
+
+
+def _sign(x: int) -> int:
+    return 0 if x == 0 else (1 if x > 0 else -1)
+
+
