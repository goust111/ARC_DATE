+def _closed_background_regions(grid: np.ndarray, bg: int) -> list[np.ndarray]:
+    regions = components_mask(grid == bg, connectivity=4)
+    h = grid.shape[0]
+    closed = []
+    for coords in regions:
+        rows = coords[:, 0]
+        if not np.any((rows == 0) | (rows == h - 1)):
+            closed.append(coords)
+    return closed
