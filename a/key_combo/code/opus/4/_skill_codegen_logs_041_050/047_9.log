+    red_top = None
+    red_bottom = None
+
+    for blue_gap in blue_gap_choices:
+        blue_top = _place_bridge(grid, existing, BLUE, top_blue_mask, top_blue_barrier, top_row, blue_gap)
+        if blue_top is None:
