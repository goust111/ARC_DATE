+    return True
+
+
+def _validate_output(inp: np.ndarray, out: np.ndarray) -> bool:
+    closed = _closed_background_regions(out, BLACK)
+    if not closed:
+        return False
+    if not np.any(out == YELLOW):
+        return False
+    if not np.any(out == BLACK):
+        return False
+    if np.array_equal(inp, out):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(*HEIGHT_RANGE)
+    w = random.randint(*WIDTH_RANGE)
+    interior = w - 2
+
+    pair_options = [(lb, rr) for lb in range(3, 8) for rr in range(3, 8) if lb + rr >= interior]
+    if not pair_options:
+        return None
+
+    top_row = random.randint(2, max(2, h // 2 - 2))
+    bottom_row = random.randint(min(h - 3, top_row + 3), h - 3)
