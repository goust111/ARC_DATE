+        grid[blue_top[2][:, 0], blue_top[2][:, 1]] = BLACK
+        existing.pop()
+        blue_top = None
+    if blue_top is None or blue_bottom is None:
+        return None
+
+    for red_gap in red_gap_choices:
+        red_top = _place_bridge(grid, existing, RED, top_red_mask, top_red_barrier, top_row, red_gap)
+        if red_top is None:
