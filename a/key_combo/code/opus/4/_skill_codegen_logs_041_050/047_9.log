+    bottom_red_mask, bottom_red_barrier = _make_bridge_mask("right", bottom_red_len)
+
+    blue_gap_choices = [g for g in range(2, min(6, w - 4) + 1)]
+    red_gap_choices = [g for g in range(2, min(6, w - 4) + 1)]
+    random.shuffle(blue_gap_choices)
+    random.shuffle(red_gap_choices)
+
+    blue_top = None
