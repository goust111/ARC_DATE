+    attach_row = 1 - barrier_row
+    if side == "left":
+        mask[attach_row, :extra] = True
+    else:
+        mask[attach_row, run_len - extra :] = True
+    return mask, barrier_row
+
+
+def _place_bridge(
+    grid: np.ndarray,
+    existing: list[np.ndarray],
+    color: int,
+    mask: np.ndarray,
+    barrier_row: int,
+    anchor_row: int,
+    gap_from_wall: int,
+) -> tuple[int, int, np.ndarray] | None:
+    h, w = grid.shape
+    ph, pw = mask.shape
+    r0 = int(anchor_row - barrier_row)
+    if r0 < 1 or r0 + ph > h - 1:
+        return None
+
+    if color == BLUE:
+        c0 = int(gap_from_wall)
+    else:
+        c0 = int(w - pw - gap_from_wall)
+
+    coords = _coords_from_mask(mask, r0, c0)
+    if _touches_existing(coords, existing, grid.shape):
+        return None
+
+    _paint_mask(grid, mask, r0, c0, color)
+    existing.append(coords)
+    return r0, c0, coords
+
+
+def _row_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(a[0], b[0]) <= min(a[1], b[1])
+
+
+def _place_extra(
+    grid: np.ndarray,
+    existing: list[np.ndarray],
+    color: int,
+    target_rows: tuple[int, int],
+    wall_near_col: int,
+) -> bool:
+    h, w = grid.shape
+    size = random.randint(3, 5)
+    mask = _random_connected_mask(size)
+    ph, pw = mask.shape
+
+    row_candidates = list(range(1, h - ph))
+    random.shuffle(row_candidates)
+
+    if color == BLUE:
+        col_lo = wall_near_col + 3
+        col_hi = w - pw - 2
+    else:
+        col_lo = 2
+        col_hi = wall_near_col - pw - 3
+    if col_lo > col_hi:
+        return False
+
+    col_candidates = list(range(col_lo, col_hi + 1))
+    random.shuffle(col_candidates)
+
+    for r0 in row_candidates:
+        rows = (r0, r0 + ph - 1)
+        if not _row_overlap(rows, target_rows):
+            continue
+        for c0 in col_candidates:
+            coords = _coords_from_mask(mask, r0, c0)
+            if _touches_existing(coords, existing, grid.shape):
+                continue
+            _paint_mask(grid, mask, r0, c0, color)
+            existing.append(coords)
+            return True
+    return False
+
+
+def _movable_components(grid: np.ndarray, color: int, side_col: int) -> list[np.ndarray]:
+    mask = (grid == color)
+    mask[:, side_col] = False
+    return components_mask(mask, connectivity=4)
+
+
+def _validate_input(grid: np.ndarray) -> bool:
+    h, w = grid.shape
+    if not np.all(grid[:, 0] == BLUE) or not np.all(grid[:, w - 1] == RED):
+        return False
+
+    all_objects = _movable_components(grid, BLUE, 0) + _movable_components(grid, RED, w - 1)
+    if len(_movable_components(grid, BLUE, 0)) < 2 or len(_movable_components(grid, RED, w - 1)) < 2:
+        return False
+    for coords in all_objects:
+        if not (3 <= int(coords.shape[0]) <= 7):
+            return False
+        if np.any(coords[:, 0] <= 0) or np.any(coords[:, 0] >= h - 1):
+            return False
+        if np.any(coords[:, 1] <= 1) or np.any(coords[:, 1] >= w - 2):
+            return False
+
+    for i, a in enumerate(all_objects):
+        for b in all_objects[i + 1 :]:
+            dr = np.abs(a[:, None, 0] - b[None, :, 0])
+            dc = np.abs(a[:, None, 1] - b[None, :, 1])
+            if bool(np.any((dr <= 1) & (dc <= 1))):
+                return False
+
+    if _closed_background_regions(grid, BLACK):
+        return False
+    return True
+
+
+def _validate_output(inp: np.ndarray, out: np.ndarray) -> bool:
+    closed = _closed_background_regions(out, BLACK)
+    if not closed:
+        return False
+    if not np.any(out == YELLOW):
+        return False
+    if not np.any(out == BLACK):
+        return False
+    if np.array_equal(inp, out):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(*HEIGHT_RANGE)
+    w = random.randint(*WIDTH_RANGE)
+    interior = w - 2
+
+    pair_options = [(lb, rr) for lb in range(3, 8) for rr in range(3, 8) if lb + rr >= interior]
+    if not pair_options:
+        return None
+
+    top_row = random.randint(2, max(2, h // 2 - 2))
+    bottom_row = random.randint(min(h - 3, top_row + 3), h - 3)
+    if bottom_row - top_row < 3:
+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    grid[:, 0] = BLUE
+    grid[:, w - 1] = RED
+
+    existing: list[np.ndarray] = []
+
+    top_blue_len, top_red_len = random.choice(pair_options)
+    bottom_blue_len, bottom_red_len = random.choice(pair_options)
+
+    top_blue_mask, top_blue_barrier = _make_bridge_mask("left", top_blue_len)
+    top_red_mask, top_red_barrier = _make_bridge_mask("right", top_red_len)
+    bottom_blue_mask, bottom_blue_barrier = _make_bridge_mask("left", bottom_blue_len)
+    bottom_red_mask, bottom_red_barrier = _make_bridge_mask("right", bottom_red_len)
+
+    blue_gap_choices = [g for g in range(2, min(6, w - 4) + 1)]
+    red_gap_choices = [g for g in range(2, min(6, w - 4) + 1)]
+    random.shuffle(blue_gap_choices)
+    random.shuffle(red_gap_choices)
+
+    blue_top = None
+    blue_bottom = None
+    red_top = None
+    red_bottom = None
+
+    for blue_gap in blue_gap_choices:
+        blue_top = _place_bridge(grid, existing, BLUE, top_blue_mask, top_blue_barrier, top_row, blue_gap)
+        if blue_top is None:
+            continue
+        blue_bottom = _place_bridge(grid, existing, BLUE, bottom_blue_mask, bottom_blue_barrier, bottom_row, blue_gap)
+        if blue_bottom is not None:
+            break
+        grid[blue_top[2][:, 0], blue_top[2][:, 1]] = BLACK
+        existing.pop()
+        blue_top = None
+    if blue_top is None or blue_bottom is None:
+        return None
+
+    for red_gap in red_gap_choices:
+        red_top = _place_bridge(grid, existing, RED, top_red_mask, top_red_barrier, top_row, red_gap)
+        if red_top is None:
+            continue
+        red_bottom = _place_bridge(grid, existing, RED, bottom_red_mask, bottom_red_barrier, bottom_row, red_gap)
+        if red_bottom is not None:
+            break
+        grid[red_top[2][:, 0], red_top[2][:, 1]] = BLACK
+        existing.pop()
+        red_top = None
+    if red_top is None or red_bottom is None:
+        return None
+
+    if random.random() < 0.6:
+        target = random.choice([blue_top, blue_bottom])
+        target_rows = (target[0], target[0] + (top_blue_mask.shape[0] if target is blue_top else bottom_blue_mask.shape[0]) - 1)
+        if not _place_extra(grid, existing, BLUE, target_rows, target[1]):
+            return None
+
+    if random.random() < 0.6:
+        target = random.choice([red_top, red_bottom])
+        target_rows = (target[0], target[0] + (top_red_mask.shape[0] if target is red_top else bottom_red_mask.shape[0]) - 1)
+        if not _place_extra(grid, existing, RED, target_rows, target[1]):
+            return None
+
+    if not _validate_input(grid):
+        return None
+
+    out = main(grid)
+    if not _validate_output(grid, out):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid gravity-compression enclosure input")

