                cc += 1
        return out

    def _split_blocks() -> list[np.ndarray]:
        """Return list of 5x5 blocks (order doesn't matter; we will match by connect)."""
        rows = _full_sep_rows(g)
        cols = _full_sep_cols(g)
        if rows and cols:
            r = int(rows[0])
            c = int(cols[0])
            return [
                g[:r, :c],
