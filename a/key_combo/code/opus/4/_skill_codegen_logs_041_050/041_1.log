+
+    for a, b, cell01 in first_pairs[:300]:
+        set0 = ordered_sets[0][a]
+        set1 = ordered_sets[1][b]
+        for c, path_c in enumerate(ordered[2]):
+            set2 = ordered_sets[2][c]
+            if set0 & set2:
+                continue
+            inter12 = set1 & set2
+            if len(inter12) != 1:
