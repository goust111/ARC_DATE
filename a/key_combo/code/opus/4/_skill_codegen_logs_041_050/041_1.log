def _wholly_in_three_sided_cavity(container: dict, inner: dict) -> bool:
    r0, c0, r1, c1 = container["bbox"]
    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
    coords = container["coords"]
    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True

