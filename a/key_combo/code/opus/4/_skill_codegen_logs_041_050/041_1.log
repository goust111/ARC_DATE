import random
from itertools import permutations

CYCLES=[((0,1,3,2), ((0,1),(1,3),(2,3),(0,2))), ((0,2,1,3), ((0,2),(1,2),(1,3),(0,3)))]

def frame_bbox(r,c,s): return (r,c,r+s-1,c+s-1)

def ext_points(b):
    r0,c0,r1,c1=b
    pts=[]
    for c in range(c0+1,c1): pts.append((r0-1,c))
    for c in range(c0+1,c1): pts.append((r1+1,c))
    for r in range(r0+1,r1): pts.append((r,c0-1))
    for r in range(r0+1,r1): pts.append((r,c1+1))
    return pts

def bresenham(p,q):
    x0,y0=p[1],p[0]; x1,y1=q[1],q[0]
    pts=[]; dx=abs(x1-x0); sx=1 if x0<x1 else -1; dy=-abs(y1-y0); sy=1 if y0<y1 else -1; err=dx+dy
    while True:
        pts.append((y0,x0))
        if x0==x1 and y0==y1: break
        e2=2*err
        if e2>=dy: err+=dy; x0+=sx
        if e2<=dx: err+=dx; y0+=sy
    return tuple(pts)

def nbr8(p):
    r,c=p
    return {(r+dr,c+dc) for dr in(-1,0,1) for dc in(-1,0,1) if dr or dc}

def candidates(boxes, edge):
    u,v=edge
    framecells=[]
    for b in boxes:
        r0,c0,r1,c1=b
        fc={(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)}
        framecells.append(fc)
    allframe=set().union(*framecells)
    out=[]
    for p in ext_points(boxes[u]):
        for q in ext_points(boxes[v]):
            path=bresenham(p,q)
            if len(path)<6: continue
            ps=set(path)
            if ps & allframe: continue
            ok=True
            for idx,cell in enumerate(path):
                adj=[i for i,fc in enumerate(framecells) if nbr8(cell) & fc]
                if idx==0:
                    ok = adj==[u]
                elif idx==len(path)-1:
                    ok = adj==[v]
                else:
                    ok = not adj
                if not ok: break
            if ok: out.append(path)
    uniq=[]; seen=set()
    for p in out:
        key=(p[0],p[-1]) if p[0]<=p[-1] else (p[-1],p[0])
        if key not in seen:
            seen.add(key); uniq.append(p)
    return uniq

def inter(a,b): return set(a)&set(b)

def find_chain(cands, order):
    # order over edge indices 0..3, need crossings only between consecutive ordered lines
    ordered=[cands[i] for i in order]
    samp=[lst[:80] if len(lst)>80 else lst for lst in ordered]
    # shuffle copies
    samp=[random.sample(lst, len(lst)) for lst in samp]
    for p0 in samp[0]:
        s0=set(p0)
        for p1 in samp[1]:
            i01=s0&set(p1)
            if len(i01)"'!=1 or i01 & {p0[0],p0[-1],p1[0],p1[-1]}: continue
            for p2 in samp[2]:
                s2=set(p2)
                if s0&s2: continue
                i12=set(p1)&s2
                if len(i12)!=1 or i12 & {p1[0],p1[-1],p2[0],p2[-1]}: continue
                if i01==i12: continue
                for p3 in samp[3]:
                    s3=set(p3)
                    if s0&s3: continue
                    if set(p1)&s3: continue
                    i23=s2&s3
                    if len(i23)!=1 or i23 & {p2[0],p2[-1],p3[0],p3[-1]}: continue
                    if i23 in (i01,i12): continue
                    return [p0,p1,p2,p3]
    return None

