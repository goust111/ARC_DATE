        if rhi-s<rlo or chi-s<clo: ok=False; break
        boxes.append(frame_bbox(random.randint(rlo,rhi-s), random.randint(clo,chi-s), s))
    if not ok: continue
    for perm,edges in random.sample(CYCLES,len(CYCLES)):
        cands=[candidates(boxes,e) for e in edges]
        if min(map(len,cands))==0: continue
        base=[0,1,2,3] if random.random()<0.5 else [0,3,2,1]
        k=random.randrange(4)
        order=base[k:]+base[:k]
        chain=find_chain(cands, order)
        if chain:
            success+=1
            print('"'success',attempt,'boxes',boxes,'edges',edges,'order',order,'cand lens',list(map(len,cands)))
            raise SystemExit
