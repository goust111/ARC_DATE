    return out


def _extract_frames(grid: np.ndarray) -> list[dict]:
    comps = components_mask(grid == FRAME, connectivity=4)
    assert len(comps) == 4
    frames: list[dict] = []
    for coords in comps:
        r0, c0, r1, c1 = bbox_coords(coords)
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        assert h == w == FRAME_SIZE
        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
        border = np.zeros((h, w), dtype=bool)
        border[0, :] = True
        border[-1, :] = True
        border[:, 0] = True
        border[:, -1] = True
        assert np.all(patch[border] == FRAME)
        assert int(border.sum()) == int(coords.shape[0])
        interior = patch[1:-1, 1:-1]
        colors = sorted(set(map(int, interior.flatten())) - {BG})
        assert len(colors) == 1
        color = colors[0]
        mask = interior == color
        assert mask.any()
        frames.append(
            {
                "bbox": (int(r0), int(c0), int(r1), int(c1)),
                "center": ((r0 + r1) / 2.0, (c0 + c1) / 2.0),
                "color": int(color),
                "mask": mask,
