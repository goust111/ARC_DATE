+            if cell12 in {ordered[1][b][0], ordered[1][b][-1], path_c[0], path_c[-1]}:
+                continue
+            for d, path_d in enumerate(ordered[3]):
+                set3 = ordered_sets[3][d]
+                if set0 & set3:
