SHAPE_TEMPLATES = {
    "domino": {(0, 0), (0, 1)},
    "line3": {(0, 0), (0, 1), (0, 2)},
    "ell3": {(0, 0), (1, 0), (1, 1)},
    "square": {(0, 0), (0, 1), (1, 0), (1, 1)},
    "tee": {(0, 1), (1, 0), (1, 1), (1, 2)},
}


def _bresenham(start: tuple[int, int], end: tuple[int, int]) -> list[tuple[int, int]]:
    r0, c0 = map(int, start)
    r1, c1 = map(int, end)
    x0, y0 = c0, r0
    x1, y1 = c1, r1
    dx = abs(x1 - x0)
    sx = 1 if x0 < x1 else -1
    dy = -abs(y1 - y0)
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    out: list[tuple[int, int]] = []
    while True:
        out.append((int(y0), int(x0)))
        if x0 == x1 and y0 == y1:
            return out
        e2 = 2 * err
        if e2 >= dy:
            err += dy
            x0 += sx
        if e2 <= dx:
            err += dx
            y0 += sy


def _neighbors8(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = map(int, cell)
    out = []
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            out.append((r + dr, c + dc))
    return out


def _frame_cell_sets(frames: list[dict]) -> list[set[tuple[int, int]]]:
    sets: list[set[tuple[int, int]]] = []
    for frame in frames:
        r0, c0, r1, c1 = frame["bbox"]
        cells = {
            (r, c)
            for r in range(int(r0), int(r1) + 1)
            for c in range(int(c0), int(c1) + 1)
        }
        sets.append(cells)
    return sets


def _adjacent_frame_ids(
    cell: tuple[int, int], frame_sets: list[set[tuple[int, int]]]
) -> list[int]:
    nbrs = set(_neighbors8(cell))
    out = []
    for frame_id, frame_cells in enumerate(frame_sets):
        if nbrs & frame_cells:
