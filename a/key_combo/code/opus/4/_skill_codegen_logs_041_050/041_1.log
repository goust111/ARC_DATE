+
+def _draw_frame(
+    grid: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    interior_color: int,
+    mask: np.ndarray,
+) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0, c0 : c1 + 1] = FRAME
+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
