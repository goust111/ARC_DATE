+    grid[r1, c0 : c1 + 1] = FRAME
+    grid[r0 : r1 + 1, c0] = FRAME
+    grid[r0 : r1 + 1, c1] = FRAME
+    interior = grid[r0 + 1 : r1, c0 + 1 : c1]
+    interior[mask] = int(interior_color)
