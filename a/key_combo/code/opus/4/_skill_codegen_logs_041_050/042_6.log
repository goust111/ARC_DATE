+
+
+def _coords_from_mask(mask: np.ndarray, top: tuple[int, int]) -> np.ndarray:
+    r0, c0 = map(int, top)
+    pts = np.argwhere(mask)
+    pts[:, 0] += r0
+    pts[:, 1] += c0
