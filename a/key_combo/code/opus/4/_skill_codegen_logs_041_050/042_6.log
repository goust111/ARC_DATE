  88:     row_starts = sorted({r0 for r0, _c0, _r1, _c1 in blocks})
  89:     col_starts = sorted({c0 for _r0, c0, _r1, _c1 in blocks})
  90:     block_by_start = {(r0, c0): (r0, c0, r1, c1) for r0, c0, r1, c1 in blocks}
  91:     assert len(block_by_start) == len(row_starts) * len(col_starts), "slot blocks must form a full array"
