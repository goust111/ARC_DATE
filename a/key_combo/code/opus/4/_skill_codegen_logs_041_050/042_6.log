+            return None
+    return placements
+
+
+def _shared_outline_exists(grid: np.ndarray, repeated: list[dict], bg: int) -> bool:
+    exterior = _exterior_background_mask(grid, bg)
+    seen: Counter = Counter()
+    for item in repeated:
+        touched = set()
+        for r, c in item["coords"]:
