  57: def main(grid: np.ndarray) -> np.ndarray:
  58:     """Restore masked cells by completing the full mirror-and-rotation symmetry of the square pattern.
  59: 
  60:     Input structure
  61:     - A square grid whose visible non-mask pixels are invariant under all eight symmetries of the square.
  62:     - Exactly one color acts as a mask: ignoring it leaves each symmetry orbit with one visible color.
  63: 
  64:     Rule
  65:     - Copy the input and replace each mask pixel with the unique visible color from its eight-way symmetry orbit.
  66:     - Preserve every non-mask pixel.
  67: 
  68:     Key insight
  69:     - Some masked cells hide all horizontal/vertical counterparts, so the needed orbit also includes diagonal reflections and quarter-turn rotations.
  70:     """
  71:     g = np.asarray(grid, dtype=int)
  72:     assert g.ndim == 2, "expected a 2D grid"
  73:     n, w = g.shape
  74:     assert n == w, "expected a square grid"
  75: 
  76:     mask_color = _mask_color(g)
  77:     out = g.copy()
  78: 
