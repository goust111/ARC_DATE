+DOWN_RIGHT = "down_right"
+DOWN_LEFT = "down_left"
+ORIENTATIONS = (DOWN_RIGHT, DOWN_LEFT)
+PALETTE = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW)
