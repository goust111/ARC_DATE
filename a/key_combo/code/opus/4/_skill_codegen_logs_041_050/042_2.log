+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border_mask = np.zeros_like(sub, dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
+        if not np.all(sub[border_mask] == RED):
+            continue
+        if np.any(sub[~border_mask] == RED):
+            continue
