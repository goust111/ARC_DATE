+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4 or h != w:
+            continue
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        border_mask = np.zeros_like(sub, dtype=bool)
+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
