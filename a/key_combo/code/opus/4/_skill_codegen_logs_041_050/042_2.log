+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+PATTERN_COLORS = (BLUE, RED, GREEN)
+NON_CORNER_CELLS = (1, 3, 4, 5, 7)
+NEAR_SQUARE_DIMS = ((1, 1), (1, 2), (2, 1), (2, 2), (2, 3), (3, 2), (3, 3), (3, 4), (4, 3), (4, 4))
+GEN_RETRIES = 400
