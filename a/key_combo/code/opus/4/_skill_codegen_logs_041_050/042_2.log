+    cells: list[np.ndarray] = []
+    for br in range(3):
+        for bc in range(3):
+            cell = grid[rows[br] + 1 : rows[br + 1], cols[bc] + 1 : cols[bc + 1]].copy()
+            cells.append(cell)
+    return cells
