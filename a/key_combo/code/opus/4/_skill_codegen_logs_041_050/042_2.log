+    assert tuple(map(int, bbox(diff_mask))) == diff_box
+    assert scale in (2, 3)
+
+    patch = crop_bbox(np.where(diff_mask, outlier_tile, BG), diff_box)
+    naive_crop = crop_bbox(outlier_tile, diff_box)
