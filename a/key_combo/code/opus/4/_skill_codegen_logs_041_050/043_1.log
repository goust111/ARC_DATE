+def _assignment_vote_map(selected: list[dict], colors: tuple[int, ...], n_contours: int) -> dict[int, list[tuple[int, int, int, int, int]]]:
+    votes_by_contour = {contour_id: [] for contour_id in range(1, n_contours + 1)}
