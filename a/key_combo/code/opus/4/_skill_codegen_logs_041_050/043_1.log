+def _markers_compatible(selected: list[dict], candidate: dict) -> bool:
+    r, c = candidate["pos"]
+    for other in selected:
+        rr, cc = other["pos"]
+        if max(abs(r - rr), abs(c - cc)) <= 1:
+            return False
+    return True
+
