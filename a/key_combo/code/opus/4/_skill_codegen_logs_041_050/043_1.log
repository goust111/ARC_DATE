+def _iter_color_assignments(n_markers: int) -> itertools.product:
+    counts = {color: 0 for color in MARKER_COLORS}
+    current = [0] * n_markers
+
+    def rec(i: int):
+        if i == n_markers:
+            yield tuple(current)
+            return
+        colors = list(MARKER_COLORS)
+        random.shuffle(colors)
+        for color in colors:
+            if counts[color] >= 2:
+                continue
+            counts[color] += 1
+            current[i] = int(color)
+            yield from rec(i + 1)
+            counts[color] -= 1
+
+    return rec(0)
