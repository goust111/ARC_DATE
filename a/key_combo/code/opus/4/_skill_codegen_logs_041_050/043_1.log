+    hits: list[tuple[int, int, int]] = []
+    r0, c0 = pos
+    for dr, dc in DIAGONALS:
+        r = r0 + dr
+        c = c0 + dc
+        while in_bounds(shape, r, c):
+            contour_id = int(label_grid[r, c])
+            if contour_id > 0:
+                hits.append((contour_id, int(r), int(c)))
+                break
+            r += dr
+            c += dc
