                for coords in comps:
                    if int(coords.shape[0]) < int(min_area):
                        continue
                    out.append(
                        {
                            "color": int(col),
                            "coords": coords,
                            "bbox": bbox_coords(coords),
                            "area": int(coords.shape[0]),
                        }
                    )
            return out

        objs: list[np.ndarray] = []
        struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
        for col in colors_iter:
