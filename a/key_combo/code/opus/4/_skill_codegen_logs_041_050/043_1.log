+
+BLACK = Color.BLACK
+WALL = Color.GREY
+MARKER_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+
+GRID_BOUNDS = (15, 20)
+OUTLINE_COUNT_RANGE = (3, 4)
+MARKER_COUNT_RANGE = (4, 6)
+GEN_ATTEMPTS = 400
+SUBSET_ATTEMPTS = 200
+PATCH_ATTEMPTS = 120
+PLACEMENT_ATTEMPTS = 100
+TIE_MODE_PROB = 0.5
