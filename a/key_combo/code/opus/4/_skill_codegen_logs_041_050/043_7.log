+    for idx, c in enumerate(bottom_slots):
+        grid[h - 1, c] = int(colors[idx % len(colors)])
+    for idx, r in enumerate(right_slots):
+        grid[r, w - 1] = int(colors[(idx + 1) % len(colors)])
