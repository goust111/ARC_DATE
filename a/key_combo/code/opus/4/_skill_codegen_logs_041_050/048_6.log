+
+
+def _place_mask(grid: np.ndarray, occupied: np.ndarray, mask: np.ndarray, color: int, top: int, left: int) -> None:
+    for r, c in np.argwhere(mask):
+        rr = top + int(r)
+        cc = left + int(c)
+        grid[rr, cc] = color
+    expanded = _expanded_mask(mask, pad=1)
+    for r, c in np.argwhere(expanded):
+        rr = top + int(r)
+        cc = left + int(c)
+        occupied[rr, cc] = True
+
+
+def _place_sprites(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    placements: list[tuple[int, int, np.ndarray, int]],
+) -> bool:
+    H, W = grid.shape
+    order = list(range(len(placements)))
+    random.shuffle(order)
+    placed_tops_lefts: list[tuple[int, int]] = []
+    for idx in order:
