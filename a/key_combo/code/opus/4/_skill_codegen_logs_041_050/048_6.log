+
+def _shape_array(area: int) -> np.ndarray:
+    for _ in range(80):
+        cells = _grow_shape(area)
+        h = max(r for r, _c in cells) + 1
+        w = max(c for _r, c in cells) + 1
+        arr = np.zeros((h, w), dtype=int)
+        for r, c in cells:
+            arr[r, c] = 1
