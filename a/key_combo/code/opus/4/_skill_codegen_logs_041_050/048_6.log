+def _place_sprites(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    placements: list[tuple[int, int, np.ndarray, int]],
+) -> bool:
+    H, W = grid.shape
+    order = list(range(len(placements)))
+    random.shuffle(order)
+    for idx in order:
+        _area, _color, mask, _row = placements[idx]
