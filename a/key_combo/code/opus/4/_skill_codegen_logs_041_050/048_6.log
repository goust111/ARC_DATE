FRAME = 5
BG = 0
BAR_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
GENERATION_RETRIES = 400
DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
DIRS8 = (
    (-1, -1),
    (-1, 0),
    (-1, 1),
    (0, -1),
    (0, 0),
