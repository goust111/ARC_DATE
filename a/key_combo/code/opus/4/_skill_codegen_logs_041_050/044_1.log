+    dominoes = find_components(
+        g,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=list(DOMINO_COLORS),
+        return_format="dict",
+    )
+    assert dominoes, "expected at least one domino"
+    for domino in dominoes:
+        assert int(domino["area"]) == 2, "every foreground non-center object must be a domino"
