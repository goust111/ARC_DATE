    r0, c0, r1, c1 = comp["bbox"]
    if dr == -1:
        return (r0, c0, c1, r1)
    if dr == 1:
        return (-r1, c0, c1, r0)
    if dc == -1:
        return (c0, r0, r1, c1)
    assert dc == 1
    return (-c1, r0, r1, c0)


