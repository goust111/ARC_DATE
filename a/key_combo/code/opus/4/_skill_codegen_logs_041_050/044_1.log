+    counts = {ray: 1 for ray in chosen}
+    remaining = movable_count - ray_count
+    while remaining > 0:
+        options = [ray for ray in chosen if counts[ray] < capacities[ray]]
+        if not options:
+            return None
+        pick = random.choice(options)
+        counts[pick] += 1
+        remaining -= 1
