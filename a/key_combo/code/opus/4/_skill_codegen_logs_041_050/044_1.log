+    block_mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1] = True
+    assert np.all(grid[block_mask] == CENTER_COLOR), "center block must be solid"
+    return (int(r0 + 1), int(c0 + 1)), block_mask
