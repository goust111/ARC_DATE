+def _reserve(blocked: np.ndarray, cells: list[tuple[int, int]]) -> None:
+    h, w = blocked.shape
+    for r, c in cells:
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if 0 <= rr < h and 0 <= cc < w:
+                    blocked[rr, cc] = True
