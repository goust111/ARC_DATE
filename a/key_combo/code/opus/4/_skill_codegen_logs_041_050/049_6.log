+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+PANEL_SIZE = 4
+MIN_TEMPLATE_AREA = 6
+MAX_TEMPLATE_AREA = 12
+MAX_MISSING = 3
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int).copy()
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and bool(mask[nr, nc]):
+                nxt = (int(nr), int(nc))
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+    return len(seen) == int(mask.sum())
+
+
+def _bits_to_mask(bits: int) -> np.ndarray:
+    mask = np.zeros((PANEL_SIZE, PANEL_SIZE), dtype=bool)
+    for idx in range(PANEL_SIZE * PANEL_SIZE):
+        if (bits >> idx) & 1:
+            r, c = divmod(idx, PANEL_SIZE)
+            mask[r, c] = True
+    return mask
+
+
+_PANEL_MASKS: list[tuple[int, int]] | None = None
+
+
+def _panel_masks() -> list[tuple[int, int]]:
+    global _PANEL_MASKS
+    if _PANEL_MASKS is not None:
+        return _PANEL_MASKS
+
+    masks: list[tuple[int, int]] = []
+    for bits in range(1, 1 << (PANEL_SIZE * PANEL_SIZE)):
+        area = bits.bit_count()
+        if not 3 <= area <= 8:
+            continue
+        mask = _bits_to_mask(bits)
+        box = _bbox(mask)
+        if box is None:
+            continue
+        r0, c0, r1, c1 = box
+        if r0 != 0 or c0 != 0:
