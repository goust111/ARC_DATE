+
+
+def _rectangles_separated(origins: list[tuple[int, int]], r0: int, c0: int) -> bool:
+    r1 = r0 + PANEL_SIZE - 1
+    c1 = c0 + PANEL_SIZE - 1
+    for rr0, cc0 in origins:
