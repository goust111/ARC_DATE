+            base_labels,
+            quadrant_labels,
+            no_visible_label,
+            changed_visible_labels,
+            winner_color,
+        )
+    except AssertionError:
+        return None
+    assert winner_color != loser_color
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for seed in range(GEN_ATTEMPTS):
+        rng = random.Random(random.randrange(1 << 30) + seed)
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
