+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _d4_orbit(n: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    pts = {
+        (r, c),
+        (c, n - 1 - r),
+        (n - 1 - r, n - 1 - c),
+        (n - 1 - c, r),
+        (r, n - 1 - c),
+        (n - 1 - r, c),
+        (c, r),
+        (n - 1 - c, n - 1 - r),
+    }
+    return tuple(sorted(pts))
+
+
+def _label_black_regions(grid: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = grid.shape
+    labels = np.zeros((h, w), dtype=int)
+    regions: list[np.ndarray] = []
+    next_label = 1
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != 0 or labels[r, c] != 0:
+                continue
+            stack = [(r, c)]
+            labels[r, c] = next_label
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if not _in_bounds(grid.shape, nr, nc):
+                        continue
+                    if int(grid[nr, nc]) != 0 or labels[nr, nc] != 0:
+                        continue
+                    labels[nr, nc] = next_label
+                    stack.append((nr, nc))
+            regions.append(np.array(coords, dtype=int))
+            next_label += 1
+    return labels, regions
+
+
+def _region_votes(grid: np.ndarray, regions: list[np.ndarray]) -> list[Counter]:
+    votes: list[Counter] = []
+    for coords in regions:
+        seen: set[tuple[int, int]] = set()
+        counts: Counter = Counter()
+        for r, c in coords:
+            for dr, dc in DIR8:
