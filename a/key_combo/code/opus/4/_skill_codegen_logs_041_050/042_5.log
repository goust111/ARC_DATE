+    base_labels: np.ndarray,
+    center_label: int,
+    quadrant_labels: list[int],
+) -> tuple[list[dict], list[dict]]:
+    n = wall_grid.shape[0]
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    outer: list[dict] = []
+    central: list[dict] = []
