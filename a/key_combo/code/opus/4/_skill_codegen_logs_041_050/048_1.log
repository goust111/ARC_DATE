+def _render_input(spec: dict) -> np.ndarray:
+    h, w = spec["shape"]
+    cr, cc = spec["center"]
+    horiz_seq = spec["horiz_seq"]
+    vert_seq = spec["vert_seq"]
+    horiz_extent = spec["horiz_extent"]
