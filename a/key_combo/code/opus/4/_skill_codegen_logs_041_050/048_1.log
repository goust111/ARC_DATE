+        distance = 1
+        while True:
+            r = cr + dr * distance
+            c = cc + dc * distance
+            if not (0 <= r < h and 0 <= c < w):
+                break
+            if cross_mask[r, c]:
+                distance += 1
+                continue
+            if g[r, c] != Color.BLACK:
