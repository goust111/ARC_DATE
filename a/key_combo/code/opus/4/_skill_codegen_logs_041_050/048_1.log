+
+DIRS = {
+    "left": (0, -1),
+    "right": (0, 1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
+
+HORIZONTAL_DIRS = {"left", "right"}
+VERTICAL_DIRS = {"up", "down"}
+GENERATION_RETRIES = 400
