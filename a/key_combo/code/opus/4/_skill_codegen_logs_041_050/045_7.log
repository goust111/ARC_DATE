+    counts: Counter = Counter()
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in neighbors4(rr, cc):
+            color = marker_map.get((nr, nc))
+            if color is not None:
+                counts[int(color)] += 1
