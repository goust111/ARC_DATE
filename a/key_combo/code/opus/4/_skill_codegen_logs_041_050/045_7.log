+            and max(frag["contact_counts"].values()) >= 2
+            and len(frag["contact_counts"]) >= 2
+            for frag in analysis["fragments"]
+        ):
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
