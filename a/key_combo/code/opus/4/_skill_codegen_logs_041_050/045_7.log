+            combos.append(picked[:])
+            return
+        if idx >= len(seq):
+            return
+        for j in range(idx, len(seq)):
+            value = seq[j]
+            if picked and abs(value - picked[-1]) <= 1:
+                continue
+            picked.append(value)
+            dfs(j + 1, picked)
+            picked.pop()
+
+    dfs(0, [])
+    if not combos:
+        return None
+    return random.choice(combos)
