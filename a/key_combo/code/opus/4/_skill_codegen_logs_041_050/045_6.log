+            keep.append(r)
+    return keep
+
+
+def _col_keep_indices(grid: np.ndarray) -> list[int]:
+    keep = [0]
+    for c in range(1, grid.shape[1]):
+        if not np.array_equal(grid[:, c], grid[:, c - 1]):
+            keep.append(c)
+    return keep
+
