+        for c in range(cols):
+            r0 = r * rows
+            c0 = c * cols
+            if int(core[r, c]) == RED:
+                paste(out, core, r0, c0)
+            else:
+                out[r0 : r0 + rows, c0 : c0 + cols] = int(core[r, c])
+
