+def _bipartite_parity(graph: list[set[int]], start_region: int) -> list[int]:
+    parity = [-1] * len(graph)
+    parity[start_region] = 0
+    q = deque([start_region])
+
+    while q:
+        region = q.popleft()
+        for neighbor in graph[region]:
+            expected = 1 - parity[region]
+            if parity[neighbor] == -1:
