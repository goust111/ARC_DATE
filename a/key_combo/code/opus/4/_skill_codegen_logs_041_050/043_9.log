+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 2
+GREEN = 3
+YELLOW = 4
+FRAME = 5
+
+GEN_ATTEMPTS = 400
+ROW_CELL_COUNTS = (3, 4, 5)
+COL_CELL_COUNTS = (3, 4, 5)
+CELL_SIZE_MIN = 2
+CELL_SIZE_MAX = 4
+OPEN_PROBABILITY = 0.28
