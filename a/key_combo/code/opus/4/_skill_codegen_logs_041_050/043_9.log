+                        continue
+                    if not np.all(grid[bottom, left : right + 1] == WALL):
+                        continue
+                    if not np.all(grid[top : bottom + 1, left] == WALL):
+                        continue
+                    if not np.all(grid[top : bottom + 1, right] == WALL):
+                        continue
+
