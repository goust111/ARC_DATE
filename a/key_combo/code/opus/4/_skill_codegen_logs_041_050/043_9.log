+    b_inside = _region_strictly_inside(b_coords, frame_box)
+    return a_inside != b_inside
+
+
+def _has_same_color_cross_frame_edge(
+    regions: list[np.ndarray],
+    graph: list[set[int]],
+    parity: list[int],
+    inside: set[int],
+    frame_box: tuple[int, int, int, int],
+) -> bool:
