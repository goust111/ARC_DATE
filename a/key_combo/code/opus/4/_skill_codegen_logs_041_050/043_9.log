+    grid: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    wall_rows: list[int],
+    wall_cols: list[int],
+) -> None:
+    for col in wall_cols:
+        for r0, r1 in row_spans:
+            if random.random() < OPEN_PROBABILITY:
+                grid[r0 : r1 + 1, col] = BG
+
+    for row in wall_rows:
+        for c0, c1 in col_spans:
+            if random.random() < OPEN_PROBABILITY:
+                grid[row, c0 : c1 + 1] = BG
+
+
