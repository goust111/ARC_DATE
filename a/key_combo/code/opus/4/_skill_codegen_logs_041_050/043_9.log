+def _region_strictly_inside(coords: np.ndarray, frame_box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = frame_box
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return int(rows.min()) > r0 and int(rows.max()) < r1 and int(cols.min()) > c0 and int(cols.max()) < c1
+
