+    frame[r1, c0 : c1 + 1] = True
+    frame[r0 : r1 + 1, c0] = True
+    frame[r0 : r1 + 1, c1] = True
+    assert np.array_equal(mask, frame), "gray pixels must form exactly one 1-pixel rectangular frame"
+    return r0, c0, r1, c1
