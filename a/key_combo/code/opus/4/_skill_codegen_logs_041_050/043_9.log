+    assert (r1 - r0) != (c1 - c0), "frame must be non-square"
+    assert 0 < r0 < r1 < grid.shape[0] - 1, "frame cannot lie on the outer border"
+    assert 0 < c0 < c1 < grid.shape[1] - 1, "frame cannot lie on the outer border"
