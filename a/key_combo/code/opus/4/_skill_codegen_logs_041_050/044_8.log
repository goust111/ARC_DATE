            out[r - offset, left : right + 1] = ENVELOPE_COLOR
            out[r + offset, left : right + 1] = ENVELOPE_COLOR
    else:
        inp[r : r + length, c] = BAR_COLOR
        out[r : r + length, c] = BAR_COLOR
        for offset in range(1, radius + 1):
            top = r + offset
            bottom = r + length - 1 - offset
            out[top : bottom + 1, c - offset] = ENVELOPE_COLOR
            out[top : bottom + 1, c + offset] = ENVELOPE_COLOR


