+        right_count = int(spec["right_count"])
+
+        assert r - left_count >= 0 and r + right_count < height, "rays must stay within the grid"
+        for dist in range(1, left_count + 1):
+            if dist % 2 == 1:
+                out[r - dist, c] = color
+        for dist in range(1, right_count + 1):
+            if dist % 2 == 1:
+                out[r + dist, c] = color
