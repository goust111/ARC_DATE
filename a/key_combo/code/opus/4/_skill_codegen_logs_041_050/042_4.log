_GEN_ORBIT_LIMITS = None
_GEN_AREA_BAG = []


def _gen_symmetry_data():
    """Cache D4 orbits, cell-to-orbit ids, and each orbit's mask cap."""
    global _GEN_ORBITS, _GEN_ORBIT_INDEX, _GEN_ORBIT_LIMITS
    if _GEN_ORBITS is not None:
