+    if len(by_identity) != 4 or len(sequence) != 3 or len(bridges) != 2:
+        return False
+    if len({bridge["direction"] for bridge in bridges}) != 2:
+        return False
+    if len({bridge["color"] for bridge in bridges}) != 2:
+        return False
