+    return grid if _generator_checks(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_TRIES):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ARC input")

