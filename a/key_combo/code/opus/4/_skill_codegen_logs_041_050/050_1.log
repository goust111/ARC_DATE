+_BASE_TEMPLATE_PATCHES = [
+    _build_shape({(0, 0), (1, 0), (2, 0), (2, 1)}),
+    _build_shape({(0, 0), (0, 1), (1, 0), (2, 0), (2, 1)}),
+    _build_shape({(0, 0), (1, 0), (2, 0), (0, 1), (0, 2)}),
