    ordered_dims = sorted(dims, key=lambda x: x[0] * x[1], reverse=True)
    desired_edge_touches = random.randint(_GEN_EDGE_TOUCH_MIN, min(_GEN_EDGE_TOUCH_MAX, len(ordered_dims)))
