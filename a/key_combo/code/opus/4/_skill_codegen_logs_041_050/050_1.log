+            right_idx = _dir_after(dir_idx, 1)
+            for sign, cand_idx in [(-1, left_idx), (1, right_idx)]:
+                rr, cc = current[0] + DIRS[cand_idx][0], current[1] + DIRS[cand_idx][1]
