def contact(
    *,
    object1: np.ndarray,
    object2: np.ndarray,
    r1: int = 0,
    c1: int = 0,
    r2: int = 0,
    c2: int = 0,
    background: int = Color.BLACK,
    connectivity: int = 4,
) -> bool:
    """Return True iff objects touch (share edge/diagonal) or overlap."""
    bg = int(background)
