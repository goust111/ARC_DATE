+def _start_state(shape: tuple[int, int]):
+    h, w = shape
+    side = random.choice([0, 1, 2, 3])  # top, right, bottom, left
+    if side == 0:
+        edge = (0, random.randint(4, w - 5))
+        inner = (1, edge[1])
+        dir_idx = 2
+    elif side == 1:
+        edge = (random.randint(4, h - 5), w - 1)
+        inner = (edge[0], w - 2)
+        dir_idx = 3
+    elif side == 2:
+        edge = (h - 1, random.randint(4, w - 5))
+        inner = (h - 2, edge[1])
+        dir_idx = 0
+    else:
+        edge = (random.randint(4, h - 5), 0)
+        inner = (edge[0], 1)
+        dir_idx = 1
+    return edge, inner, dir_idx
+
+
+def _choose_template_and_corner(
+    shape: tuple[int, int],
+    path_cells: set[tuple[int, int]],
+    blockers: set[tuple[int, int]],
+    turnpoints: list[tuple[int, int]],
+    turn_signs: list[int],
+):
+    h, w = shape
+    occupied_input = set(path_cells) | set(blockers)
+    for patch in random.sample(TEMPLATE_VARIANTS, len(TEMPLATE_VARIANTS)):
+        stamp_sets, stamp_cells, _path_set = _output_stamp_cells(sorted(path_cells), turnpoints, turn_signs, patch)
+        if any(not all(_in_bounds(shape, r, c) for r, c in cells) for cells in stamp_sets):
+            continue
+        if stamp_cells & occupied_input:
+            continue
+        total_stamp_area = sum(len(cells) for cells in stamp_sets)
+        if len(stamp_cells) != total_stamp_area:
+            continue
+        angles = []
+        cumulative = 0
+        for sign in turn_signs:
+            cumulative = (cumulative + sign) % 4
+            angles.append(cumulative)
+        if len(set(angles)) < 2:
+            continue
+        if not any(angle != (1 if sign == 1 else 3) for angle, sign in zip(angles, turn_signs)):
+            continue
+
+        corners = [(0, 0), (0, w - 3), (h - 3, 0), (h - 3, w - 3)]
+        random.shuffle(corners)
+        for r0, c0 in corners:
+            tpl_cells = {(r0 + int(r), c0 + int(c)) for r, c in _patch_cells(patch)}
+            if tpl_cells & occupied_input:
+                continue
+            if tpl_cells & stamp_cells:
+                continue
+            return patch, (r0, c0)
+    return None
+
+
+def _manual_render(shape: tuple[int, int], edge: tuple[int, int], inner: tuple[int, int], blockers: set[tuple[int, int]], patch: np.ndarray, corner: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    grid = np.zeros((h, w), dtype=int)
+    grid[edge] = GREEN
+    grid[inner] = GREEN
+    for r, c in blockers:
+        grid[r, c] = GREY
+    r0, c0 = corner
+    for pr, pc in np.argwhere(patch != BG):
+        grid[r0 + int(pr), c0 + int(pc)] = RED
+    return grid
+
+
+def _semantic_check(inp: np.ndarray) -> bool:
+    try:
+        out = main(inp)
+    except AssertionError:
+        return False
+
+    path, turnpoints, turn_signs = _trace_path(inp)
+    if len(turnpoints) < MIN_TURNS or len(turnpoints) > MAX_TURNS:
+        return False
+    if set(turn_signs) != {-1, 1}:
+        return False
+
+    template_patch, template_coords = _find_template_patch(inp)
+    stamp_sets, stamp_cells, path_set = _output_stamp_cells(path, turnpoints, turn_signs, template_patch)
+    if stamp_cells & path_set:
+        return False
+    blocker_cells = {tuple(map(int, rc)) for rc in np.argwhere(inp == GREY)}
+    if stamp_cells & blocker_cells:
+        return False
+    if len(stamp_cells) != sum(len(s) for s in stamp_sets):
+        return False
+    if not np.all(out[template_coords[:, 0], template_coords[:, 1]] == BG):
+        return False
+    if not all(out[r, c] == RED for r, c in stamp_cells):
+        return False
+    if np.count_nonzero(out == RED) < len(stamp_cells):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        h = random.randint(18, 24)
+        w = random.randint(18, 24)
+        shape = (h, w)
+        turns = random.randint(MIN_TURNS, MAX_TURNS)
+
+        edge, inner, dir_idx = _start_state(shape)
+        result = _search_path(
+            shape=shape,
+            current=inner,
+            dir_idx=dir_idx,
+            turns_left=turns,
+            used_path={edge, inner},
+            blockers=set(),
+            turnpoints=[],
+            turn_signs=[],
+        )
+        if result is None:
+            continue
+        if set(result["turn_signs"]) != {-1, 1}:
+            continue
+
+        choice = _choose_template_and_corner(
+            shape=shape,
+            path_cells=result["path"],
+            blockers=result["blockers"],
+            turnpoints=result["turnpoints"],
+            turn_signs=result["turn_signs"],
+        )
+        if choice is None:
+            continue
+        patch, corner = choice
+        grid = _manual_render(shape, edge, inner, result["blockers"], patch, corner)
+        if _semantic_check(grid):
+            return grid
+
+    raise RuntimeError("failed to generate a valid corridor-stamp-rotation input")

