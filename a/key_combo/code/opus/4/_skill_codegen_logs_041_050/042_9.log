+        for h1 in (1, 2, 3)
+        for h2 in (1, 2, 3)
+        for w1 in (1, 2, 3, 4)
+        for w2 in (1, 2, 3, 4)
+        if h1 != h2 and w1 != w2 and len({h1 * w1, h1 * w2, h2 * w1, h2 * w2}) == 4
+    ]
+    h1, h2, w1, w2 = random.choice(options)
+    h = h1 + h2 + 3
+    w = w1 + w2 + 3
+    patch = np.zeros((h, w), dtype=int)
+    patch[0, :] = BLUE
+    patch[-1, :] = BLUE
+    patch[:, 0] = BLUE
+    patch[:, -1] = BLUE
+    patch[h1 + 1, 1:-1] = BLUE
+    patch[1:-1, w1 + 1] = BLUE
+    return patch
+
+
+def _shape_patch_three() -> np.ndarray:
+    options = [
+        (h1, h2, w_left, w_right)
+        for h1 in (1, 2, 3)
+        for h2 in (1, 2, 3)
+        for w_left in (1, 2, 3)
+        for w_right in (1, 2, 3, 4)
+        if len({h1 * w_left, h2 * w_left, (h1 + h2 + 1) * w_right}) == 3
+    ]
+    h1, h2, w_left, w_right = random.choice(options)
+    h = h1 + h2 + 3
+    w = w_left + w_right + 3
+    patch = np.zeros((h, w), dtype=int)
+    patch[0, :] = BLUE
+    patch[-1, :] = BLUE
+    patch[:, 0] = BLUE
+    patch[:, -1] = BLUE
