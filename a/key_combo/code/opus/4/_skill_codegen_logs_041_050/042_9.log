 148: def _grow_polyomino(size, rng):
 149:     """Grow a 4-connected polyomino of given size, normalized to (0, 0)."""
 150:     cells = {(0, 0)}
 151:     frontier = [(0, 0)]
 152:     while len(cells) < size:
 153:         r, c = rng.choice(frontier)
 154:         nbrs = [(r-1, c), (r+1, c), (r, c-1), (r, c+1)]
 155:         rng.shuffle(nbrs)
 156:         grown = False
 157:         for nr, nc in nbrs:
 158:             if (nr, nc) not in cells:
 159:                 cells.add((nr, nc))
 160:                 frontier.append((nr, nc))
 161:                 grown = True
 162:                 break
 163:         if not grown:
 164:             frontier.remove((r, c))
 165:             if not frontier:
 166:                 break
 167: 
 168:     min_r = min(r for r, c in cells)
 169:     min_c = min(c for r, c in cells)
 170:     return [(r - min_r, c - min_c) for r, c in cells]
