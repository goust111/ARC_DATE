+def _solve(grid: np.ndarray, *, clean: bool) -> np.ndarray:
+    g = _clean_supported_pixels(grid) if clean else np.asarray(grid, dtype=int).copy()
+    blue_comps = find_components(
+        g,
+        bg=Color.BLACK,
