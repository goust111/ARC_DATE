+    for hole in holes:
+        sig = _shape_signature(hole)
+        matches = [sprite for sprite in sprites if sig in sprite["rot_sigs"]]
+        if clean:
+            assert len(matches) == 1, "each cleaned hole must match exactly one cleaned sprite"
+        if len(matches) == 1:
