+def _shape_signature(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    coords = np.asarray(coords, dtype=int)
+    if coords.size == 0:
+        return ()
+    mins = coords.min(axis=0)
+    norm = coords - mins
+    return tuple(sorted((int(r), int(c)) for r, c in norm))
