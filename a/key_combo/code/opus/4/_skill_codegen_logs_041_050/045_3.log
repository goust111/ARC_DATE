+    "block2": np.array([[1, 1], [1, 1]], dtype=bool),
+    "rect23": np.array([[1, 1, 1], [1, 1, 1]], dtype=bool),
+    "rect24": np.array([[1, 1, 1, 1], [1, 1, 1, 1]], dtype=bool),
+    "corner8": np.array([[0, 1, 1], [1, 1, 1], [1, 1, 1]], dtype=bool),
+}
