+def _collect_sprites(grid: np.ndarray) -> list[dict]:
+    mask = (grid != Color.BLACK) & (grid != Color.BLUE)
+    sprite_grid = np.where(mask, Color.RED, Color.BLACK)
+    comps = find_components(
+        sprite_grid,
+        bg=Color.BLACK,
+        connectivity=4,
+        monochromatic=True,
+        colors=[Color.RED],
+        return_format="dict",
+    )
+    sprites = []
+    for comp in comps:
