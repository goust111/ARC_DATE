+def _random_black_rect(
+    grid: np.ndarray,
+    *,
+    height: int,
+    width: int,
+    forbidden: set[tuple[int, int]],
+    color: int,
+) -> bool:
+    height = int(height)
+    width = int(width)
+    rows = list(range(grid.shape[0] - height + 1))
+    cols = list(range(grid.shape[1] - width + 1))
+    random.shuffle(rows)
+    random.shuffle(cols)
