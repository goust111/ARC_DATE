def _gen_dimension_options(N: int) -> list[tuple[int, int]]:
    opts = []
    for h in range(BAR_DIM_MIN, BAR_DIM_MAX + 1):
        for w in range(BAR_DIM_MIN, BAR_DIM_MAX + 1):
            short, long = min(h, w), max(h, w)
