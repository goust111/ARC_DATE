+def _trace_branches(shape: tuple[int, int], start_c: int, walls: list[dict], frame: dict) -> tuple[set[tuple[int, int]], list[tuple[int, int]], list[dict]]:
+    height, width = shape
+    assert 0 <= start_c < width
