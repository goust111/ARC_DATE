+    hit_counts = {int(v) for v in hit.values()}
+    if len(hit_counts) != 1:
+        return None
+    next_count = hit_counts.pop() + 1
+    new_active = dict(outside)
+    for gap_col in wall["holes"]:
+        if gap_col in new_active:
+            return None
+        new_active[int(gap_col)] = int(next_count)
+    return new_active
