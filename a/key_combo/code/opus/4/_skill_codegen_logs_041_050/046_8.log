+def _validate_generated_case(grid: np.ndarray, expected_arrivals: list[tuple[int, int]]) -> bool:
+    try:
+        _marker_r, marker_c = _find_marker(grid)
+        walls = _extract_walls(grid)
+        frame = _find_frame(grid)
