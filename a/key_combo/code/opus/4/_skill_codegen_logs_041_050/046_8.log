+        k = len(subset)
+        span = cols[-1] - cols[0] + 1
+        inner_min = max(span, 2 * k)
+        inner_candidates = [w for w in range(inner_min, grid_w - 2) if w % k == 0]
+        rng.shuffle(inner_candidates)
