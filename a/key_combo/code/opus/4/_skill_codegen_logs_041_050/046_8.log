+def _render_input(
+    height: int,
+    width: int,
+    marker_c: int,
+    walls: list[dict],
+    frame: dict,
+) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    grid[0, marker_c] = RED
+    for wall in walls:
+        row = wall["row"]
+        grid[row, wall["c0"] : wall["c1"] + 1] = GRAY
+        for gap_col in wall["holes"]:
