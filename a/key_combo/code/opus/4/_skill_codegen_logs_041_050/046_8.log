    sprite[anchor] = MARKER_COLOR
    return sprite, anchor


def _gen_cells(mask: np.ndarray, r0: int, c0: int) -> set[tuple[int, int]]:
    return {(int(r0 + rr), int(c0 + cc)) for rr, cc in np.argwhere(mask)}


def _gen_place_pair(
    rng,
