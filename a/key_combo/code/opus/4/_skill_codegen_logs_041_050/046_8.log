+            if any(col in (c0, c1) for col, _count in items):
+                continue
+            return {"c0": int(c0), "c1": int(c1), "top_holes": tuple(cols)}, subset
+    return None
+
+
+def _render_input(
+    height: int,
+    width: int,
+    marker_c: int,
+    walls: list[dict],
+    frame: dict,
+) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
