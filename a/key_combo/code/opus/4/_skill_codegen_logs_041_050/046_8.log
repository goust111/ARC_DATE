+
+
+def _choose_rectangle(
+    rng: random.Random,
+    final_active: dict[int, int],
+    grid_w: int,
+    prefer_mixed: bool,
+    prefer_non_monotone: bool,
+) -> tuple[dict, list[tuple[int, int]]] | None:
