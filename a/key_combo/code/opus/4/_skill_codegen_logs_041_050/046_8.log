+    arrivals_by_col: dict[int, int] = {}
+    wall_stats = [
+        {"row": wall["row"], "hit_columns": set(), "hit_counts": set(), "spawn_count": 0}
+        for wall in walls
+    ]
+    wall_stats_by_row = {item["row"]: item for item in wall_stats}
+
+    stack = [(0, start_c, 0)]
+    seen_counts: dict[tuple[int, int], int] = {}
+    while stack:
