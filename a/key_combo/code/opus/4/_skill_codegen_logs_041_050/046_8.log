+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+ORANGE = 7
+
+COUNT_TO_COLOR = {1: BLUE, 2: GREEN, 3: ORANGE}
+GEN_RETRIES = 500
