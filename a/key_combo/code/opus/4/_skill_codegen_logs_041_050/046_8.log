+
+def _build_next_wall(rng: random.Random, active: dict[int, int], grid_w: int) -> tuple[dict, dict[int, int]] | None:
+    cols = sorted(active)
+    width_options = list(range(max(10, grid_w - 8), grid_w - 2))
+    rng.shuffle(width_options)
