+    r1, c1 = coords.max(axis=0)
+    r0 = int(r0)
+    c0 = int(c0)
+    r1 = int(r1)
+    c1 = int(c1)
+    assert r1 - r0 >= 3 and c1 - c0 >= 3, "frame must have a non-empty interior"
+    assert np.all(grid[r0 : r1 + 1, c0] == YELLOW)
+    assert np.all(grid[r0 : r1 + 1, c1] == YELLOW)
+    assert np.all(grid[r1, c0 : c1 + 1] == YELLOW)
