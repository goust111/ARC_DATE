+                full_box,
+                transparent=0,
+                padding=1,
+                padding_connectivity=8,
+            )
+        except ValueError:
+            return None
+
+        paste(occupied, full_box, r0, c0)
+        paste(grid, patch, r0, c0)
+        placed.append({"color": color, "length": bar_len, "bbox": (r0, c0, r0 + outer_h - 1, c0 + outer_w - 1)})
+
+    try:
+        infos = _extract_infos(grid)
+    except AssertionError:
+        return None
+
+    if len(infos) != n_frames:
+        return None
+    if not _passes_shortcut_checks(grid):
+        return None
+
+    out = main(grid)
+    if out.shape != (2 * n_frames - 1, 2 * n_frames - 1):
+        return None
+
+    expected = _render_nested([info["color"] for info in sorted(infos, key=lambda info: info["length"])])
+    if not np.array_equal(out, expected):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {MAX_ATTEMPTS} attempts")

