+        predecessors = [
+            (nr, nc)
+            for nr, nc in neighbors4(r, c)
+            if in_bounds((h, w), nr, nc)
+            and bool(passable[nr, nc])
+            and int(dist[nr, nc]) == int(dist[r, c]) - 1
+        ]
