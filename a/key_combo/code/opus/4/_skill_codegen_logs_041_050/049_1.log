+def _paint_parity_maze(
+    grid: np.ndarray,
+    frame_bbox: tuple[int, int, int, int],
+    control: tuple[int, int],
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    r0, c0, r1, c1 = frame_bbox
