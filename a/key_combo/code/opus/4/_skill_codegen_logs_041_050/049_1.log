+
+    expected = filled.copy()
+    for r, c in path[1:-1]:
+        expected[r, c] = PATH_COLOR
+    if not np.array_equal(out, expected):
+        return False
+
+    return True
+
+
+def _sample_frame() -> tuple[int, int, int, int, int, int]:
