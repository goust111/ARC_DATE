+                {
+                    "cell": cell,
+                    "dist": _chebyshev(cell, control),
+                    "sig": _direction_signature(cell, control),
+                    "on_corridor": on_corridor,
+                    "adj_count": len(adj),
+                }
+            )
+    random.shuffle(infos)
+    return infos
