+def _sample_frame() -> tuple[int, int, int, int, int, int]:
+    h = random.randint(*CANVAS_H_RANGE)
+    w = random.randint(*CANVAS_W_RANGE)
+    frame_h = random.randint(FRAME_H_RANGE[0], min(FRAME_H_RANGE[1], h - 2 * FRAME_MARGIN))
