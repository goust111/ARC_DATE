+    center_c = (c0 + c1) / 2
+    candidates = []
+    for r in range(r0 + 1, r1):
+        for c in range(c0 + 1, c1):
+            if abs(r - center_r) < 1e-9 and abs(c - center_c) < 1e-9:
+                continue
+            up = r - (r0 + 1)
+            down = (r1 - 1) - r
+            left = c - (c0 + 1)
+            right = (c1 - 1) - c
+            if max(up, down, left, right) < 3:
+                continue
+            if max(up, down, left, right) - min(up, down, left, right) < 2:
+                continue
+            candidates.append((r, c))
