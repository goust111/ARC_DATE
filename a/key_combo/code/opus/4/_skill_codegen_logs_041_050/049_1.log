+        mask = np.zeros((r1 + 1, c1 + 1), dtype=bool)
+        found = False
+        for r in range(r0 + 1, r1):
+            for c in range(c0 + 1, c1):
+                if _chebyshev((r, c), control) == dist:
+                    mask[r, c] = True
+                    found = True
+        if not found:
+            continue
