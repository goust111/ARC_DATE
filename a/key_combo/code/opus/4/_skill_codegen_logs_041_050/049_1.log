+CONTROL_COLOR = int(Color.GREEN)
+CHANNEL_COLOR = int(Color.YELLOW)
+FRAME_COLOR = int(Color.GREY)
+
+GEN_RETRIES = 500
+CANVAS_H_RANGE = (12, 19)
+CANVAS_W_RANGE = (12, 19)
+FRAME_H_RANGE = (9, 17)
+FRAME_W_RANGE = (9, 17)
