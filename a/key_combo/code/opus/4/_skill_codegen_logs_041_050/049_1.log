+def _free_space_path_length(
+    frame_bbox: tuple[int, int, int, int],
+    control: tuple[int, int],
+    endpoints: tuple[tuple[int, int], tuple[int, int]],
+    shape: tuple[int, int],
+) -> int:
+    r0, c0, r1, c1 = frame_bbox
