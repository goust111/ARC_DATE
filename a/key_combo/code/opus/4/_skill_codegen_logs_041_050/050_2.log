+            if len(set(ring)) != 1:
+                continue
+            border = ring[0]
+            if border == bg or border == center:
+                continue
+            frames.append(
+                {
+                    "top": r,
+                    "left": c,
+                    "center": (r + 1, c + 1),
+                    "border_color": border,
+                    "center_color": center,
