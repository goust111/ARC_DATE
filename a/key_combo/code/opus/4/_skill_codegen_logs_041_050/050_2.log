+def _mark_forbidden(forbidden: np.ndarray, coords: np.ndarray, pad: int = 1) -> None:
+    h, w = forbidden.shape
+    for r, c in coords:
+        rr, cc = int(r), int(c)
+        r0 = max(0, rr - pad)
+        r1 = min(h, rr + pad + 1)
+        c0 = max(0, cc - pad)
+        c1 = min(w, cc + pad + 1)
+        forbidden[r0:r1, c0:c1] = True
