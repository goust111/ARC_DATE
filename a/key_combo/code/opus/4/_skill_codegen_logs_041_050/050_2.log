0006: def main(grid: np.ndarray) -> np.ndarray:
0007:     """Extract the color enclosed by the unique 3x3 monochrome frame and return it as a 1x1 grid.
0008: 
0009:     Input structure
0010:     - A background canvas contains scattered foreground pixels in two visible colors.
0011:     - Exactly one 3x3 window has all eight border pixels in one foreground color and its center in a different foreground color.
0012: 
0013:     Rule
0014:     - Find that window and output a 1x1 grid containing the center pixel color.
0015: 
0016:     Key insight
0017:     - The complete 3x3 frame marks the meaningful sample; the scattered pixels of the same colors are distractors.
0018:     """
0019:     g = np.asarray(grid, dtype=int)
0020:     assert g.ndim == 2
0021:     h, w = g.shape
0022:     assert h >= 3 and w >= 3
0023: 
0024:     bg = get_bg(g)
0025:     candidates = []
0026:     for r in range(1, h - 1):
0027:         for c in range(1, w - 1):
0028:             center = int(g[r, c])
0029:             if center == bg:
0030:                 continue
0031:             patch = g[r - 1 : r + 2, c - 1 : c + 2]
0032:             ring = np.array(
0033:                 [
0034:                     patch[0, 0],
0035:                     patch[0, 1],
0036:                     patch[0, 2],
0037:                     patch[1, 0],
0038:                     patch[1, 2],
0039:                     patch[2, 0],
0040:                     patch[2, 1],
0041:                     patch[2, 2],
0042:                 ],
0043:                 dtype=int,
0044:             )
0045:             ring_colors = set(map(int, ring))
0046:             if len(ring_colors) != 1:
0047:                 continue
0048:             ring_color = next(iter(ring_colors))
0049:             if ring_color != bg and ring_color != center:
0050:                 candidates.append(center)
0051: 
0052:     assert len(candidates) == 1
0053:     return np.array([[candidates[0]]], dtype=int)
