0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Recolor each grey object by the colored top-row marker whose column passes through it.
0010: 
0011:     Input structure
0012:     - The grid has a dominant background, grey rectangular 4-connected objects,
0013:       and colored singleton control pixels in the top row.
0014:     - Each grey rectangle has exactly one control-pixel column inside its horizontal span.
0015: 
0016:     Rule
0017:     - Keep the background and top-row control pixels unchanged.
0018:     - For each 4-connected grey rectangle, find its bounding-box column range.
0019:     - Recolor the whole object with the unique control-pixel color whose column
0020:       lies inside that range.
0021: 
0022:     Key insight
0023:     - The markers act as vertical labels for grey regions: horizontal-span
0024:       containment, not distance or object size, determines the fill color.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     assert g.ndim == 2, "expected a 2D grid"
0028: 
0029:     bg = get_bg(g)
0030:     grey = Color.GREY
0031:     control_mask = (g != bg) & (g != grey)
0032:     control_coords = np.argwhere(control_mask)
0033:     assert control_coords.size > 0, "expected top-row control pixels"
0034:     assert np.all(control_coords[:, 0] == 0), "control pixels must be in the top row"
0035: 
0036:     marker_by_col = {int(c): int(g[0, c]) for _r, c in control_coords}
0037:     assert len(marker_by_col) == len(control_coords), "expected one control pixel per column"
0038: 
0039:     grey_objects = components_mask(g == grey, connectivity=4)
0040:     assert len(grey_objects) == len(marker_by_col), "expected one grey object per control pixel"
0041: 
0042:     out = g.copy()
0043:     for obj in grey_objects:
0044:         r0, c0, r1, c1 = bbox_coords(obj)
0045:         assert obj.shape[0] == (r1 - r0 + 1) * (c1 - c0 + 1), "expected solid grey rectangles"
0046:         matches = [color for c, color in marker_by_col.items() if c0 <= c <= c1]
0047:         assert len(matches) == 1, "each grey object must contain exactly one marker column"
0048:         out[obj[:, 0], obj[:, 1]] = matches[0]
0049: 
0050:     return out
