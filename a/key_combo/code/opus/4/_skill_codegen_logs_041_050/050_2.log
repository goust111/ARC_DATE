+def _detect_frames(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    frames = []
+    for r in range(h - 2):
+        for c in range(w - 2):
+            patch = grid[r : r + 3, c : c + 3]
+            center = int(patch[1, 1])
+            if center == bg:
+                continue
+            ring = [
+                int(patch[0, 0]),
+                int(patch[0, 1]),
+                int(patch[0, 2]),
+                int(patch[1, 0]),
+                int(patch[1, 2]),
+                int(patch[2, 0]),
+                int(patch[2, 1]),
+                int(patch[2, 2]),
+            ]
+            if len(set(ring)) != 1:
+                continue
+            border = ring[0]
+            if border == bg or border == center:
+                continue
+            frames.append(
+                {
+                    "top": r,
+                    "left": c,
+                    "center": (r + 1, c + 1),
+                    "border_color": border,
+                    "center_color": center,
+                    "cells": _frame_cells(r, c),
+                }
+            )
