+from arc_utils import Color, bbox_coords, find_components, get_bg
+
+
+BG = Color.BLACK
+BLUE = Color.BLUE
+RED = Color.RED
+NOISE_COLORS = (Color.GREEN, Color.YELLOW, Color.GREY, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON)
+SIDES = ("up", "down", "left", "right")
+GEN_ATTEMPTS = 500
