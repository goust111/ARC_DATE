+            target = source + np.array([dr, dc], dtype=int)
+            if int(target[:, 0].min()) < 0 or int(target[:, 1].min()) < 0:
+                continue
+            if int(target[:, 0].max()) >= h or int(target[:, 1].max()) >= w:
