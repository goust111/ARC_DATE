+        grid[cell] = random.choice(NOISE_COLORS)
+        current += 1
+
+    pool = [(r, c) for r in range(grid.shape[0]) for c in range(grid.shape[1]) if int(grid[r, c]) == BG and (r, c) not in reserved_black]
