+    r0, c0, r1, c1 = map(int, bbox)
+    sides: list[str] = []
+    if bool(np.any(target[:, 0] == r0)):
+        sides.append("up")
+    if bool(np.any(target[:, 0] == r1)):
+        sides.append("down")
+    if bool(np.any(target[:, 1] == c0)):
+        sides.append("left")
+    if bool(np.any(target[:, 1] == c1)):
+        sides.append("right")
