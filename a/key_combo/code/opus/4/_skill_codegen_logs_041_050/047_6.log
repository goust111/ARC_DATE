+    must_stay_black |= hole_cells
+    must_stay_black -= {tuple(map(int, rc)) for rc in np.vstack([source, anchor])}
+
+    preferred_noise: list[tuple[int, int]] = []
+    for r0, c0 in spec["holes"]:
