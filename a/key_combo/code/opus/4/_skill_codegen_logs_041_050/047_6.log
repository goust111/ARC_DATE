+
+    blocked_by_holes = [cand for cand in blocked_prefill if cand["target_set"] & hole_cells]
+    if not blocked_by_holes:
+        return None
+
+    must_stay_black = {tuple(map(int, rc)) for rc in np.vstack([source, anchor])}
