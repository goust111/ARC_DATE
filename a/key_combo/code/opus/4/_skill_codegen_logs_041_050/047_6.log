+                continue
+            seen_targets.add(target_key)
+            candidates.append(
+                {
+                    "dr": int(dr),
+                    "dc": int(dc),
+                    "side": side,
+                    "target": target,
+                    "target_set": target_set,
+                    "bbox": bbox,
+                }
+            )
+    return candidates
+
+
+def main(grid: np.ndarray) -> np.ndarray:
