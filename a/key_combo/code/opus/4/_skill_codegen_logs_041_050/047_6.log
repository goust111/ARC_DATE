+            desired_shift = (ar, ac - 1)
+
+        anchor = _bar_coords(length, vertical=True) + np.array([ar, ac], dtype=int)
+        source_row_choices = [r for r in range(1, h - length - 1) if r + length - 1 < ar - 1 or r > ar + length]
+        if not source_row_choices:
