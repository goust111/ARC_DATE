    if np.any(target[:,0]==r1): sides.append('down')
    if np.any(target[:,1]==c0): sides.append('left')
    if np.any(target[:,1]==c1): sides.append('right')
    return sides[0] if len(sides)==1 else None

def search(source_coords, anchor_coords, H=18,W=18):
    anchor_set=set(map(tuple,anchor_coords))
    ans=[]
    for dr in range(-H+1,H):
      for dc in range(-W+1,W):
        if dr==0 and dc==0: continue
        tgt=source_coords + [dr,dc]
        if tgt[:,0].min()<0 or tgt[:,1].min()<0 or tgt[:,0].max()>=H or tgt[:,1].max()>=W: continue
        u=np.array(list(anchor_set | set(map(tuple,tgt))),dtype=int)
