+def _trace_channel(
+    channel: np.ndarray,
+    markers: dict[tuple[int, int], int],
+    start: tuple[int, int] | None = None,
+    *,
+    collect_opportunities: bool = False,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
