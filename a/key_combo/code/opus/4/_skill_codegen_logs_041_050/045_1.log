+                cell
+                for cell in unvisited
+                if (cell[0] - r, cell[1] - c) == direction
+            ]
+            perpendicular = [
+                cell
+                for cell in unvisited
+                if (cell[0] - r) * direction[0] + (cell[1] - c) * direction[1] == 0
+            ]
+            if collect_opportunities and straight and perpendicular:
+                opportunities.append(current)
