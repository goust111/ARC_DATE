+
+    Key insight:
+    - The orange components define the walkable geometry, but the marker colors decide whether the ray passes straight through or makes a forced 90-degree turn inside that geometry.
+    """
+    g = np.asarray(grid, dtype=int)
+    channel, _ = _channel_from_grid(g)
+    markers = _marker_dict(g, channel)
+    start = _select_start(markers)
+    visited, _ = _trace_channel(channel, markers, start)
+
+    out = g.copy()
+    for r, c in visited:
+        out[r, c] = CYAN
+    return out
+
+
+def _turn_effective(
+    channel: np.ndarray,
+    start: tuple[int, int],
+    markers: dict[tuple[int, int], int],
+    cell: tuple[int, int],
+) -> tuple[bool, list[tuple[int, int]]]:
+    trial = dict(markers)
+    trial[cell] = GREEN
+    path, _ = _trace_channel(channel, trial, start)
+    base_path, _ = _trace_channel(channel, markers, start)
+    return set(path) != set(base_path), path
+
+
+def _find_endpoint(mask: np.ndarray, *, topmost: bool) -> tuple[int, int] | None:
+    h, w = mask.shape
+    endpoints = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        degree = sum(
+            1
+            for nr, nc in _neighbors4(r, c)
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]
+        )
+        if degree <= 1 and 0 < r < h - 1 and 0 < c < w - 1:
+            endpoints.append((r, c))
+    if not endpoints:
+        return None
+    key = (lambda rc: (rc[0], rc[1])) if topmost else (lambda rc: (-rc[0], rc[1]))
+    return min(endpoints, key=key)
+
+
+def _build_serpentine_paths() -> tuple[np.ndarray, np.ndarray] | None:
+    shape = (20, 22)
+    height, width = shape
+
+    for _ in range(_GEOM_ATTEMPTS):
+        top = random.randint(2, 4)
+        r1, r2, r3 = sorted(random.sample(range(top + 3, 16), 3))
+        bottom = random.randint(r3 + 2, 18)
+
+        c_l0 = random.randint(3, 7)
+        c_r0 = c_l0 + 2
+        c_l1 = random.randint(2, 10)
+        c_r1 = random.randint(c_l1 + 2, min(c_l1 + 8, 16))
+        c_l2 = random.randint(2, 10)
+        c_r2 = random.randint(c_l2 + 2, min(c_l2 + 8, 16))
+
+        left_points = [(top, c_l0), (r1, c_l0), (r1, c_l1), (r2, c_l1), (r2, c_l2), (bottom, c_l2)]
+        right_points = [(top, c_r0), (r1, c_r0), (r1, c_r1), (r3, c_r1), (r3, c_r2), (bottom, c_r2)]
+
+        if random.random() < 0.5:
+            left_points = [(r, width - 1 - c) for r, c in left_points]
+            right_points = [(r, width - 1 - c) for r, c in right_points]
+
+        left_mask = _polyline_mask(shape, left_points)
+        right_mask = _polyline_mask(shape, right_points)
+        if np.any(left_mask & right_mask):
+            continue
+
+        touching = False
+        for r, c in np.argwhere(left_mask):
+            r = int(r)
+            c = int(c)
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < height and 0 <= nc < width and right_mask[nr, nc]:
+                    touching = True
+                    break
+            if touching:
+                break
+        if touching:
+            continue
+
+        grid0 = np.zeros(shape, dtype=int)
+        grid0[left_mask] = ORANGE
+        grid0[right_mask] = ORANGE
+        channel, _ = _channel_from_grid(grid0)
+        if len(_component_masks(channel)) != 1 or not (14 <= int(channel.sum()) <= 60):
+            continue
+
+        start = _find_endpoint(channel, topmost=True)
+        if start is None:
+            continue
+        base_path, base_ops = _trace_channel(channel, {start: RED}, start, collect_opportunities=True)
+        if len(base_path) < 10 or not base_ops:
+            continue
+        if not any(
+            _turn_effective(channel, start, {start: RED}, cell)[0]
+            for cell in base_ops
+        ):
+            continue
+        return left_mask, right_mask
+    return None
+
+
+def _choose_markers(channel: np.ndarray) -> dict[tuple[int, int], int] | None:
+    start = _find_endpoint(channel, topmost=True)
+    if start is None:
+        return None
+
+    markers: dict[tuple[int, int], int] = {start: RED}
+    base_path, base_ops = _trace_channel(channel, markers, start, collect_opportunities=True)
+    if len(base_path) < 14 or not base_ops:
+        return None
+
+    green1_candidates: list[tuple[tuple[int, int], list[tuple[int, int]]]] = []
+    for cell in base_ops:
+        effective, path = _turn_effective(channel, start, markers, cell)
+        if effective and 10 <= len(path) < int(channel.sum()) - 1:
+            green1_candidates.append((cell, path))
+    if not green1_candidates:
+        return None
+
+    green1, _ = random.choice(green1_candidates)
+    markers[green1] = GREEN
+    path_after_green1, ops_after_green1 = _trace_channel(
+        channel, markers, start, collect_opportunities=True
+    )
+
+    want_second_green = random.random() < 0.35
+    if want_second_green:
+        green2_candidates: list[tuple[tuple[int, int], list[tuple[int, int]]]] = []
+        for cell in ops_after_green1:
+            if cell in markers:
+                continue
+            effective, path = _turn_effective(channel, start, markers, cell)
+            if effective and 10 <= len(path) < int(channel.sum()) - 1:
+                green2_candidates.append((cell, path))
+        if green2_candidates:
+            green2, _ = random.choice(green2_candidates)
+            markers[green2] = GREEN
+
+    final_path, final_ops = _trace_channel(channel, markers, start, collect_opportunities=True)
+    if len(final_path) < 10 or len(final_path) >= int(channel.sum()):
+        return None
+
+    want_second_red = random.random() < 0.55
+    if want_second_red:
+        red_candidates = []
+        for cell in final_ops:
+            if cell in markers:
+                continue
+            trial = dict(markers)
+            trial[cell] = GREEN
+            alt_path, _ = _trace_channel(channel, trial, start)
+            if set(alt_path) != set(final_path):
+                red_candidates.append(cell)
+        if red_candidates:
+            markers[random.choice(red_candidates)] = RED
+
+    # Optional untouched marker to show that unvisited markers remain unchanged.
+    if random.random() < 0.35:
+        used_colors = list(markers.values())
+        extra_color = GREEN if used_colors.count(GREEN) < 2 else RED
+        if used_colors.count(extra_color) < 2:
+            off_path = [
+                (int(r), int(c))
+                for r, c in np.argwhere(channel)
+                if (int(r), int(c)) not in markers
+                and (int(r), int(c)) not in final_path
+                and int(r) > start[0]
+            ]
+            off_path = [
+                cell
+                for cell in off_path
+                if all(abs(cell[0] - mr) + abs(cell[1] - mc) >= 3 for mr, mc in markers)
+            ]
+            if off_path:
+                markers[random.choice(off_path)] = extra_color
+
+    red_count = sum(color == RED for color in markers.values())
+    green_count = sum(color == GREEN for color in markers.values())
+    if not (1 <= red_count <= 2 and 1 <= green_count <= 2):
+        return None
+    if _select_start(markers) != start:
+        return None
+    return markers
+
+
+def _pad_grid(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    pad_top = random.randint(0, 3)
+    pad_bottom = random.randint(0, min(5, 30 - h - pad_top))
+    pad_left = random.randint(0, 3)
+    pad_right = random.randint(0, min(5, 30 - w - pad_left))
+    out = np.zeros((h + pad_top + pad_bottom, w + pad_left + pad_right), dtype=int)
+    out[pad_top : pad_top + h, pad_left : pad_left + w] = grid
+    return out
+
+
+def _grid_from_masks(
+    left_mask: np.ndarray,
+    right_mask: np.ndarray,
+    markers: dict[tuple[int, int], int],
+) -> np.ndarray:
+    grid = np.zeros(left_mask.shape, dtype=int)
+    grid[left_mask] = ORANGE
+    grid[right_mask] = ORANGE
+    for (r, c), color in markers.items():
+        grid[r, c] = color
+    return grid
+
+
+def _semantic_checks(grid: np.ndarray) -> bool:
+    channel, comps = _channel_from_grid(grid)
+    if len(comps) != 2:
+        return False
+    if len(_component_masks(channel)) != 1:
+        return False
+
+    markers = _marker_dict(grid, channel)
+    start = _select_start(markers)
+    if markers[start] != RED:
+        return False
+
+    visited, ops = _trace_channel(channel, markers, start, collect_opportunities=True)
+    if len(visited) < 10 or len(visited) >= int(channel.sum()):
+        return False
+    if not ops:
+        return False
+
+    # Green markers must matter semantically.
+    green_cells = [cell for cell, color in markers.items() if color == GREEN]
+    if not green_cells:
+        return False
+    all_red = {cell: (RED if color == GREEN else color) for cell, color in markers.items()}
+    path_all_red, _ = _trace_channel(channel, all_red, start)
+    if set(path_all_red) == set(visited):
+        return False
+
+    # Any extra red marker should sit at a branch where green would alter the path.
+    red_cells = [cell for cell, color in markers.items() if color == RED and cell != start]
+    for red_cell in red_cells:
+        trial = dict(markers)
+        trial[red_cell] = GREEN
+        alt_path, _ = _trace_channel(channel, trial, start)
+        if set(alt_path) == set(visited):
+            return False
+
+    out = main(grid)
+    cyan_count = int(np.sum(out == CYAN))
+    if cyan_count != len(visited):
+        return False
+    if np.any((grid == ORANGE) & (out != ORANGE)):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    built = _build_serpentine_paths()
+    if built is None:
+        return None
+    left_mask, right_mask = built
+    grid0 = np.zeros(left_mask.shape, dtype=int)
+    grid0[left_mask] = ORANGE
+    grid0[right_mask] = ORANGE
+
+    channel, comps = _channel_from_grid(grid0)
+    if len(comps) != 2 or len(_component_masks(channel)) != 1:
+        return None
+    if int(channel.sum()) < 16 or int(channel.sum()) > 60:
+        return None
+
+    markers = _choose_markers(channel)
+    if markers is None:
+        return None
+    grid = _grid_from_masks(left_mask, right_mask, markers)
+    grid = _pad_grid(grid)
+    if not _semantic_checks(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ray-in-channel puzzle")

