+        left_points = [
+            (top, c0),
+            (r1, c0),
+            (r1, c0 - left_out),
+            (r1 + 1, c0 - left_out),
+            (r1 + 1, c0 + left_back),
+            (bottom, c0 + left_back),
+        ]
+        right_points = [
+            (top, c0 + 2),
+            (r1, c0 + 2),
+            (r1, c0 + 2 + right_step),
+            (r2, c0 + 2 + right_step),
+            (r2, c0 + 2 + right_step + right_out),
+            (bottom, c0 + 2 + right_step + right_out),
