+            src = mask[
+                max(0, -dr) : h - max(0, dr),
+                max(0, -dc) : w - max(0, dc),
+            ]
+            dst = out[
+                max(0, dr) : h - max(0, -dr),
+                max(0, dc) : w - max(0, -dc),
+            ]
+            dst |= src
+    return out
