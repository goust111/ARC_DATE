+def _marker_dict(grid: np.ndarray, channel: np.ndarray) -> dict[tuple[int, int], int]:
+    markers: dict[tuple[int, int], int] = {}
+    for r, c in np.argwhere((grid == RED) | (grid == GREEN)):
+        r = int(r)
+        c = int(c)
