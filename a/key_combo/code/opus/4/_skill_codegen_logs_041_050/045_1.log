+        if current in visited_set:
+            break
+        visited.append(current)
+        visited_set.add(current)
+        r, c = current
+        if r == 0 or r == h - 1 or c == 0 or c == w - 1:
+            break
+
+        unvisited = [
+            (nr, nc)
+            for nr, nc in _neighbors4(r, c)
+            if 0 <= nr < h and 0 <= nc < w and channel[nr, nc] and (nr, nc) not in visited_set
