+    for red_cell in red_cells:
+        trial = dict(markers)
+        trial[red_cell] = GREEN
+        alt_path, _ = _trace_channel(channel, trial, start)
+        if set(alt_path) == set(visited):
+            return False
+
+    out = main(grid)
+    cyan_count = int(np.sum(out == CYAN))
+    if cyan_count != len(visited):
+        return False
+    if np.any((grid == ORANGE) & (out != ORANGE)):
+        return False
+    return True
