+def _find_endpoint(mask: np.ndarray, *, topmost: bool) -> tuple[int, int] | None:
+    h, w = mask.shape
+    endpoints = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
