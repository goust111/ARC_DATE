+        perpendicular: list[tuple[int, int]] = []
+        if direction is not None:
+            straight = [
+                cell
+                for cell in unvisited
+                if (cell[0] - r, cell[1] - c) == direction
+            ]
+            perpendicular = [
+                cell
+                for cell in unvisited
+                if (cell[0] - r) * direction[0] + (cell[1] - c) * direction[1] == 0
+            ]
