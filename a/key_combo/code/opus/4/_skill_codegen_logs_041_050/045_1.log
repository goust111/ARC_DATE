+def _polyline_mask(shape: tuple[int, int], points: list[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for (r0, c0), (r1, c1) in zip(points, points[1:]):
+        if r0 == r1:
+            c_lo, c_hi = sorted((c0, c1))
+            mask[r0, c_lo : c_hi + 1] = True
+        else:
