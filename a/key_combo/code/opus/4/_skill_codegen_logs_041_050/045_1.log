+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            rr, cc = stack.pop()
+            coords.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
