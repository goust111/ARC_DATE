+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+ORANGE = 7
+CYAN = 8
+
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_GEN_ATTEMPTS = 400
