+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _component_masks(mask: np.ndarray) -> list[np.ndarray]:
+    """Minimal 4-connected component helper using the arc_utils (r,c) convention."""
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            rr, cc = stack.pop()
+            coords.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comp = np.zeros_like(mask, dtype=bool)
+        rows, cols = zip(*coords)
+        comp[rows, cols] = True
+        components.append(comp)
+    return components
+
+
+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    h, w = mask.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            src = mask[
+                max(0, -dr) : h - max(0, dr),
+                max(0, -dc) : w - max(0, dc),
+            ]
+            dst = out[
+                max(0, dr) : h - max(0, -dr),
+                max(0, dc) : w - max(0, -dc),
+            ]
+            dst |= src
+    return out
+
+
+def _polyline_mask(shape: tuple[int, int], points: list[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for (r0, c0), (r1, c1) in zip(points, points[1:]):
+        if r0 == r1:
+            c_lo, c_hi = sorted((c0, c1))
+            mask[r0, c_lo : c_hi + 1] = True
+        else:
