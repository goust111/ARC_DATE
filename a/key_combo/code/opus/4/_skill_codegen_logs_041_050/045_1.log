+        left_back = right_step + random.choice([0, 0, 1])
+        right_out = random.randint(3, 5)
+
+        left_points = [
+            (top, c0),
+            (r1, c0),
+            (r1, c0 - left_out),
+            (r1 + 1, c0 - left_out),
+            (r1 + 1, c0 + left_back),
+            (bottom, c0 + left_back),
