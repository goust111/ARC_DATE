    return out

def exterior(obst):
    H,W=obst.shape
    bg=~obst
    ext=np.zeros_like(obst,bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
