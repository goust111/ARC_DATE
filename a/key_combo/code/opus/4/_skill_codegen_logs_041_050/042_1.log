                if not all(0<=r<H and 0<=c<W for r,c in rot): continue
                overlap=len(coords & rot)
                if overlap==0 or overlap>=len(coords): continue
                areas=enclosed_regions(coords,rot,H,W,(pr,pc))
                if len(areas)>=2 and len(set(areas))>=2 and min(areas)>=1:
                    if any(a<=2 for a in areas) and any(3<=a<=5 for a in areas) and any(a>=6 for a in areas):
                        return H,W,coords,(pr,pc),areas
                    return H,W,coords,(pr,pc),areas
    return None

ok=0
for i in range(200):
