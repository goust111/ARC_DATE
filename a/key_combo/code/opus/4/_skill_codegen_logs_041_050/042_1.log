+        "name": "comb_wide",
+        "mask": _comb_mask(6, 6, 2, 4, 6, 5, 4),
+        "pivot": (3, 2),
+        "weight": 3,
+    },
+    {
+        "name": "spiral_mid",
+        "mask": _spiral_mask(6, 6, 5, 6, 3),
+        "pivot": (1, 1),
+        "weight": 2,
