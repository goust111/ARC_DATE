+
+
+def _validate_shape(mask: np.ndarray) -> None:
+    assert 10 <= int(mask.sum()) <= 18
+    assert len(_components(mask, connectivity=8)) == 1
+    assert not _has_hole(mask)
+    assert _has_indentation(mask)
