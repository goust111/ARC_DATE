import random, numpy as np
from collections import deque

H=W=15

def nbr8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr or dc:
                yield r+dr,c+dc

def nbr4(r,c):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        yield r+dr,c+dc

def comps(mask,conn=4):
    H,W=mask.shape
    seen=np.zeros_like(mask,bool)
    out=[]
    dirs=[(-1,0),(1,0),(0,-1),(0,1)] if conn==4 else [(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                q=[(r,c)]; seen[r,c]=1; pts=[]
                for rr,cc in q:
                    pts.append((rr,cc))
                    for dr,dc in dirs:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=1; q.append((nr,nc))
                out.append(pts)
    return out

def has_hole(mask):
    H,W=mask.shape
    bg=~mask
    ext=np.zeros_like(mask,bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in nbr4(r,c):
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=1; q.append((nr,nc))
    return bool((bg & ~ext).any())

def indent(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    box=mask[r0:r1+1,c0:c1+1]
    for r in range(1,box.shape[0]-1):
        for c in range(1,box.shape[1]-1):
            if not box[r,c]:
                cnt=sum(box[r+dr,c+dc] for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)])
                if cnt>=2:
                    return True
    return False

def gen_shape():
    h=random.randint(5,7); w=random.randint(5,7)
    area=random.randint(10,18)
    mask=np.zeros((h,w),bool)
    r=random.randrange(h); c=random.randrange(w); mask[r,c]=1
    frontier={(r,c)}
    while mask.sum()<area:
        cells=list(zip(*np.where(mask)))
        rr,cc=random.choice(cells)
        cand=[]
        for nr,nc in nbr8(rr,cc):
            if 0<=nr<h and 0<=nc<w and not mask[nr,nc]:
                cand.append((nr,nc))
        if not cand: break
        nr,nc=random.choice(cand)
        mask[nr,nc]=1
    if len(comps(mask,8))"'!=1: return None
    if has_hole(mask): return None
    if not indent(mask): return None
    if np.array_equal(mask, np.rot90(mask,2)): return None
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    return mask[r0:r1+1,c0:c1+1]

def rotate(coords,p):
    pr,pc=p
    return {(2*pr-r,2*pc-c) for r,c in coords}

def enclosed_regions(orig,rot,H,W,pivot):
    obst=np.zeros((H,W),bool)
    for r,c in orig|rot|{pivot}: obst[r,c]=1
    bg=~obst
    ext=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in nbr4(r,c):
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=1; q.append((nr,nc))
    enclosed=bg & ~ext
    return [len(x) for x in comps(enclosed,4)]

def find_valid(mask):
    mh,mw=mask.shape
    for _ in range(200):
        H=random.randint(max(12,mh+4),15)
        W=random.randint(max(12,mw+4),15)
        r0=random.randint(1,H-mh-2)
        c0=random.randint(1,W-mw-2)
        coords={(r0+r,c0+c) for r,c in zip(*np.where(mask))}
