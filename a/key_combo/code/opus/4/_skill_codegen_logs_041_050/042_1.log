                seen[r,c]=1; q=[(r,c)]; pts=[]
                for rr,cc in q:
                    pts.append((rr,cc))
                    for dr,dc in dirs:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=1; q.append((nr,nc))
                out.append(pts)
    return out

def exterior(mask):
    H,W=mask.shape
    bg=~mask
    ext=np.zeros_like(mask,bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=1; q.append((nr,nc))
    return ext

def has_hole(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    crop=mask[r0:r1+1,c0:c1+1]
    return bool(((~crop) & (~exterior(crop))).any())

def indent(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    crop=mask[r0:r1+1,c0:c1+1]
