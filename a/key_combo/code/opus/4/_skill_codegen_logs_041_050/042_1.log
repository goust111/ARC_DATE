+    return {
+        "overlap": int(sum((int(r), int(c)) in blue_set for r, c in red)),
+        "input_holes": len(_enclosed_components(obstacle_in)),
+        "areas": areas,
+        "cats": cats,
+    }
+
+
+_TEMPLATES = [
+    {
+        "name": "comb_small",
+        "mask": _comb_mask(6, 5, 2, 4, 4, 4, 2),
+        "pivot": (3, 2),
+        "weight": 2,
+    },
+    {
+        "name": "comb_wide",
+        "mask": _comb_mask(6, 6, 2, 4, 6, 5, 4),
+        "pivot": (3, 2),
+        "weight": 3,
+    },
+    {
+        "name": "spiral_cut",
+        "mask": _mask_without(_spiral_mask(7, 7, 6, 6, 5), (0, 5)),
+        "pivot": (1, 2),
+        "weight": 2,
+    },
+    {
+        "name": "spiral_tall",
+        "mask": _spiral_mask(7, 6, 5, 6, 5),
+        "pivot": (1, 2),
+        "weight": 2,
+    },
+    {
+        "name": "spiral_large",
+        "mask": _spiral_mask(7, 7, 6, 6, 5),
+        "pivot": (1, 2),
+        "weight": 3,
+    },
+]
+
+for _template in _TEMPLATES:
+    _validate_shape(_template["mask"])
+
+
+def _render_input(template: dict, op: int, height: int, width: int, top: int, left: int) -> np.ndarray:
+    mask, pivot = _orient(template["mask"], template["pivot"], op)
+    norm_mask, norm_pivot, _red = _normalize_layout(mask, pivot)
