+
+def _orient(mask: np.ndarray, pivot: tuple[int, int], op: int) -> tuple[np.ndarray, tuple[int, int]]:
+    canvas, _ = _tight_canvas(mask, pivot)
+    arr = canvas
+    if op >= 4:
+        arr = np.fliplr(arr)
+    arr = np.rot90(arr, op % 4)
