+    obstacle_in = (inp == BLUE) | (inp == GREY)
+    obstacle_out = obstacle_in.copy()
+    obstacle_out[red[:, 0], red[:, 1]] = True
+    comps = _enclosed_components(obstacle_out)
+    areas = sorted(int(comp.shape[0]) for comp in comps)
+    cats = {_fill_color(area) for area in areas}
+    return {
+        "overlap": int(sum((int(r), int(c)) in {(int(rr), int(cc)) for rr, cc in blue} for r, c in red)),
+        "input_holes": len(_enclosed_components(obstacle_in)),
+        "areas": areas,
+        "cats": cats,
+    }
+
+
+_TEMPLATES = [
+    {
+        "name": "comb_small",
+        "mask": _comb_mask(6, 5, 2, 4, 4, 4, 2),
+        "pivot": (3, 2),
+        "weight": 2,
+    },
+    {
+        "name": "comb_wide",
+        "mask": _comb_mask(6, 6, 2, 4, 6, 5, 4),
+        "pivot": (3, 2),
+        "weight": 3,
+    },
+    {
+        "name": "spiral_mid",
+        "mask": _spiral_mask(6, 6, 5, 6, 3),
+        "pivot": (1, 1),
+        "weight": 2,
+    },
+    {
+        "name": "spiral_tall",
+        "mask": _spiral_mask(7, 6, 5, 6, 5),
+        "pivot": (1, 2),
+        "weight": 2,
+    },
+    {
+        "name": "spiral_large",
+        "mask": _spiral_mask(7, 7, 6, 6, 5),
+        "pivot": (1, 2),
+        "weight": 3,
+    },
