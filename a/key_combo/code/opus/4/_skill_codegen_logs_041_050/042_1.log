            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=1; q.append((nr,nc))
    return ext

def enclosed(obst):
    return (~obst)&(~exterior(obst))

def areas(obst):
    return tuple(sorted(len(x) for x in comps(enclosed(obst),4)))

def has_hole(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    crop=mask[r0:r1+1,c0:c1+1]
    return bool(areas(crop.astype(bool)))

def indent(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    crop=mask[r0:r1+1,c0:c1+1]
