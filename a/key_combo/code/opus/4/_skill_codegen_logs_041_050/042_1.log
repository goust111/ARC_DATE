        if enclosed_areas_from_obst(inp_obst):
            continue
        rot={(2*pr-r,2*pc-c) for r,c in coords}
        if not all(0<=r<H and 0<=c<W for r,c in rot): continue
        overlap=len(coords & rot)
        if overlap<=0 or overlap>=len(coords): continue
        out_obst=inp_obst.copy()
        for r,c in rot: out_obst[r,c]=1
        areas=enclosed_areas_from_obst(out_obst)
