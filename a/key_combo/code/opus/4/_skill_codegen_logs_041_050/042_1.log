+_TEMPLATES = [
+    {
+        "name": "comb_small",
+        "mask": _comb_mask(6, 5, 2, 4, 4, 4, 2),
+        "pivot": (3, 2),
+        "weight": 2,
+    },
+    {
+        "name": "comb_wide",
+        "mask": _comb_mask(6, 6, 2, 4, 6, 5, 4),
+        "pivot": (3, 2),
+        "weight": 3,
+    },
+    {
+        "name": "spiral_mid",
+        "mask": _spiral_mask(6, 6, 5, 6, 3),
+        "pivot": (1, 1),
+        "weight": 2,
+    },
+    {
+        "name": "spiral_tall",
+        "mask": _spiral_mask(7, 6, 5, 6, 5),
+        "pivot": (1, 2),
+        "weight": 2,
+    },
+    {
+        "name": "spiral_large",
+        "mask": _spiral_mask(7, 7, 6, 6, 5),
+        "pivot": (1, 2),
+        "weight": 3,
+    },
+]
+
+for _template in _TEMPLATES:
