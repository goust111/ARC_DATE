+    h, w = g.shape
+    assert np.all((0 <= red[:, 0]) & (red[:, 0] < h) & (0 <= red[:, 1]) & (red[:, 1] < w)), "rotated copy left the grid"
+
+    out = g.copy()
+    for r, c in red:
+        rr = int(r)
+        cc = int(c)
+        if out[rr, cc] in (BLUE, GREY):
+            continue
+        out[rr, cc] = RED
+
+    obstacle = out != BLACK
+    for comp in _enclosed_components(obstacle):
+        color = _fill_color(int(comp.shape[0]))
+        out[comp[:, 0], comp[:, 1]] = color
