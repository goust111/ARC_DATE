+    return norm, pivot2, red2
+
+
+def _has_hole(mask: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(mask)
+    crop = mask[r0 : r1 + 1, c0 : c1 + 1]
+    exterior = _exterior_background(crop)
