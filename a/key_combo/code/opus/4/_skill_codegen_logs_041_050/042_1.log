            if sum(crop[r+dr,c+dc] for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)])>=2:
                return True
    return False

def enclosed_areas(placed,rot,H,W,pivot):
    obst=np.zeros((H,W),bool)
