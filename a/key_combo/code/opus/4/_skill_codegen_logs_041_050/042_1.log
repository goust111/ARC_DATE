import numpy as np, random
from collections import deque

def comps(mask,conn=4):
    H,W=mask.shape
    seen=np.zeros_like(mask,bool)
    dirs=[(-1,0),(1,0),(0,-1),(0,1)] if conn==4 else [(dr,dc) for dr in (-1,0,1) for dc in (-1,0,1) if dr or dc]
    out=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                seen[r,c]=1; q=[(r,c)]; pts=[]
                for rr,cc in q:
                    pts.append((rr,cc))
                    for dr,dc in dirs:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=1; q.append((nr,nc))
                out.append(pts)
    return out

def exterior(obst):
    H,W=obst.shape
    bg=~obst
    ext=np.zeros_like(obst,bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=1; q.append((nr,nc))
    return ext

def enclosed_areas_from_obst(obst):
    mask=(~obst)&(~exterior(obst))
    return tuple(sorted(len(x) for x in comps(mask,4)))

def has_hole(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    crop=mask[r0:r1+1,c0:c1+1]
    return bool(enclosed_areas_from_obst(crop.astype(bool)))

def indent(mask):
    ys,xs=np.where(mask)
    r0,c0,r1,c1=ys.min(),xs.min(),ys.max(),xs.max()
    crop=mask[r0:r1+1,c0:c1+1]
    H,W=crop.shape
    for r in range(1,H-1):
        for c in range(1,W-1):
            if crop[r,c]: continue
            if sum(crop[r+dr,c+dc] for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)])>=2:
                return True
    return False

def comb(h,w,m1,m2,l0,l1,l2):
    m=np.zeros((h,w),bool)
    m[:,0]=1; m[0,:l0]=1; m[m1,:l1]=1; m[m2,:l2]=1
    return m

def spiral(h,w,top_len,right_height,low_row):
    m=np.zeros((h,w),bool)
    m[0,:top_len]=1
    m[:right_height,top_len-1]=1
    m[right_height-1,1:top_len]=1
    m[2:right_height,1]=1
    m[low_row,1:w-1]=1
    return m

def search(mask,name):
    if len(comps(mask,8))"'!=1 or has_hole(mask) or not indent(mask) or np.array_equal(mask,np.rot90(mask,2)):
        return None
    H=W=18; off=(5,5)
    coords={(off[0]+r,off[1]+c) for r,c in zip(*np.where(mask))}
    ys=[r for r,c in coords]; xs=[c for r,c in coords]
    for pr in range(min(ys)-4,max(ys)+5):
      for pc in range(min(xs)-4,max(xs)+5):
        if (pr,pc) in coords: continue
        inp_obst=np.zeros((H,W),bool)
        for r,c in coords: inp_obst[r,c]=1
