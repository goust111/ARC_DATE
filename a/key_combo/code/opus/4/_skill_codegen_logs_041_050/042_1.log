+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+BLACK = 0
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                nbrs = neighbors4 if connectivity == 4 else neighbors8
+                for nr, nc in nbrs(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rotate180(coords: np.ndarray, pivot: tuple[int, int]) -> np.ndarray:
+    pr, pc = map(int, pivot)
+    out = np.empty_like(coords)
+    out[:, 0] = 2 * pr - coords[:, 0]
+    out[:, 1] = 2 * pc - coords[:, 1]
+    return out
+
+
+def _exterior_background(obstacle: np.ndarray) -> np.ndarray:
+    h, w = obstacle.shape
+    bg = ~obstacle
+    exterior = np.zeros_like(bg, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if bool(bg[r, c]) and not bool(exterior[r, c]):
+                exterior[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bool(bg[r, c]) and not bool(exterior[r, c]):
+                exterior[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(bg[nr, nc]) and not bool(exterior[nr, nc]):
+                exterior[nr, nc] = True
+                q.append((nr, nc))
