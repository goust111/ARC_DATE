0098:         for bc, c0 in enumerate(col_starts):
0099:             assert (r0, c0) in block_by_start, "every row/column slot position must exist"
0100:             tile = g[r0 : r0 + 2, c0 : c0 + 2]
0101:             control_colors = set(map(int, tile.ravel())) - {bg, slot_color}
0102:             assert len(control_colors) <= 1, "a slot may contain at most one control color"
0103:             if not control_colors:
