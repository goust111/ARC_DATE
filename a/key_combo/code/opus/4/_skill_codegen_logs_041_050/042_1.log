+    mask[:, 0] = True
+    mask[0, :len_top] = True
+    mask[row_a, :len_mid] = True
+    mask[row_b, :len_low] = True
+    return mask
+
+
+def _spiral_mask(h: int, w: int, top_len: int, right_height: int, low_row: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
