                    max(0, c - MARKER_CLEARANCE) : min(w, c + MARKER_CLEARANCE + 1),
                ] = True
            comps.append({"group": group, "shape": shape, "coords": coords})
    return comps


def _axis_starts(lo: int, hi: int, size: int, limit: int) -> range:
    start_min = max(SRC_DST_MARGIN, hi - size + 1)
