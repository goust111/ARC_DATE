+    final_ok = False
+    for leaf_rels in final_options:
+        direction_map = {rel: _relative_dir(incoming, rel) for rel in leaf_rels}
+        placed, next_occ = _choose_assignment(occupied, mshape, current, direction_map)
+        if placed is None:
