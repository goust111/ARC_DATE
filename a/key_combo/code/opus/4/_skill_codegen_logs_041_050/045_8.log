+import random
+from itertools import combinations, product
+
+import numpy as np
+
+
+BG = 0
+WIRE = 7
+TOKEN_COLORS = (1, 2, 3)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L
+DIR_TO_INDEX = {d: i for i, d in enumerate(DIRS)}
+RELATIVE_DIRS = ("R", "S", "L")
+SHAPE_ORDER = ("solid", "x", "diamond")
+SHAPE_MASKS = {
+    "solid": np.ones((3, 3), dtype=bool),
+    "x": np.array(
