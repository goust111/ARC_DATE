+PAIR_B2 = [(1, 3), (2, 2), (2, 3)]
+PAIR_B3 = [(1, 1, 3), (1, 2, 2), (2, 1, 2), (1, 2, 3), (2, 1, 3), (2, 2, 2)]
+GEN_ATTEMPTS = 400
+
+
+def _add(a, b):
+    return a[0] + b[0], a[1] + b[1]
+
+
+def _scale(d, k):
+    return d[0] * k, d[1] * k
