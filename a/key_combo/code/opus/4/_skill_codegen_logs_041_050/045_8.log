+    out = np.asarray(grid, dtype=int).copy()
+    start_shape_idx = _shape_to_index(info["token"]["shape"])
+    color = info["token"]["color"]
+    visited = set()
+    trace = {}
+
+    def dfs(node, parent, incoming, shape_idx):
+        if node in visited:
+            return
+        visited.add(node)
