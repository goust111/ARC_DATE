+    side = random.choice(("top", "bottom", "left", "right"))
+    if side == "top":
+        return (0, random.randint(1, mw - 2)), (1, 0), (-1, 0)
+    if side == "bottom":
+        return (mh - 1, random.randint(1, mw - 2)), (-1, 0), (1, 0)
+    if side == "left":
