+    occupied = {root}
+    segments = []
+    leaves = []
+    branch_nodes = []
+
+    first_len = random.choice((1, 2))
+    first_path = _reserve_path(occupied, mshape, root, trunk_dir, first_len)
+    if first_path is None:
+        return None
+    occupied.update(first_path)
+    first_branch = first_path[-1]
+    segments.append((root, first_branch))
