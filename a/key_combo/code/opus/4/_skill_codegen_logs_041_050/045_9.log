+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+CYAN = 8
+PAIR_COLORS = (BLUE, RED, YELLOW)
+
+_ORIENTATIONS = {
+    "down": ((1, -1), (1, 1)),
+    "up": ((-1, -1), (-1, 1)),
+    "left": ((-1, -1), (1, -1)),
