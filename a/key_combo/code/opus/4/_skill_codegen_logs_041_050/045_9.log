 162: def _connected(shape: Shape) -> bool:
 163:     cells = set(shape)
 164:     seen = {next(iter(cells))}
 165:     stack = list(seen)
 166:     while stack:
 167:         r, c = stack.pop()
 168:         for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
 169:             if (nr, nc) in cells and (nr, nc) not in seen:
 170:                 seen.add((nr, nc))
 171:                 stack.append((nr, nc))
 172:     return len(seen) == len(cells)
