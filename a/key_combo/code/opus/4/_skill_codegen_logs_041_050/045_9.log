+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+CYAN = 8
+PAIR_COLORS = (BLUE, RED, YELLOW)
+
+_ORIENTATIONS = {
+    "down": ((1, -1), (1, 1)),
+    "up": ((-1, -1), (-1, 1)),
+    "left": ((-1, -1), (1, -1)),
+    "right": ((-1, 1), (1, 1)),
+}
+
+_GEN_ATTEMPTS = 600
+_WEDGE_ATTEMPTS = 160
+_GRID_SIDE_MIN = 15
+_GRID_SIDE_MAX = 22
