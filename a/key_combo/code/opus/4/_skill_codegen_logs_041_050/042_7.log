+def _prefix_len(row: np.ndarray, bg: int = BG) -> int:
+    nz = np.flatnonzero(row != bg)
+    assert nz.size >= 2, "each active row must contain a visible prefix"
+    assert int(nz[0]) == 0, "every prefix must start at the left edge"
+    return int(nz[-1] + 1)
