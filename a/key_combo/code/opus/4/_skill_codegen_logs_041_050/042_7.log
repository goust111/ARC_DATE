        sr, sc = divmod(idx, cols)
        color = random.choice(marker_colors)
        slot_controls[(sr, sc)] = color
        rr = sr * SLOT_STRIDE
        cc = sc * SLOT_STRIDE
        out[rr : rr + TILE_SIZE, cc : cc + TILE_SIZE] = np.where(mask_by_color[color], color, BG_COLOR)
