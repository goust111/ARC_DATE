/bin/bash -lc "python - <<'PY'
import numpy as np, itertools
LEFT_W=12
bg=0

def ext(prefix,b=2):
    L=len(prefix)
    row=np.zeros(LEFT_W,dtype=int)
    row[:L]=prefix
    out=row.copy(); s=L-1
    out[L:LEFT_W-s]=prefix[0]; out[LEFT_W-s:]=prefix[1:]
    return tuple(out)

def holes(grid):
    g=np.array(grid)
    H,W=g.shape
    extm=np.zeros((H,W),bool)
    from collections import deque
    q=deque()
    for r in range(H):
      for c in [0,W-1]:
        if g[r,c]==0 and not extm[r,c]: extm[r,c]=1;q.append((r,c))
    for c in range(W):
      for r in [0,H-1]:
        if g[r,c]==0 and not extm[r,c]: extm[r,c]=1;q.append((r,c))
    while q:
      r,c=q.popleft()
      for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
        if 0<=nr<H and 0<=nc<W and g[nr,nc]==0 and not extm[nr,nc]: extm[nr,nc]=1;q.append((nr,nc))
    rem=(g==0)&~extm
    n=0
    for r in range(H):
      for c in range(W):
        if rem[r,c]:
          n+=1
          q=deque([(r,c)]); rem[r,c]=0
          while q:
            rr,cc=q.popleft()
            for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
              if 0<=nr<H and 0<=nc<W and rem[nr,nc]: rem[nr,nc]=0;q.append((nr,nc))
    return n

patterns=[]
for L in range(3,7):
  for vals in itertools.product([0,3], repeat=L-2):
    p=(2,*vals,2)
    patterns.append(p)
solid=(2,3,2)
interesting=[]
for p in patterns:
  h=holes([ext(solid),ext(p),ext(solid)])
  if h:
    interesting.append((p,h,ext(p)))
print('interesting single-band types:')
for x in interesting:
  print(x[0],x[1],x[2])

rows=[ext(solid)] + [ext(p) for p in patterns] + [ext(solid)]
# search compositions with 2 bands separated by solid row
seqs=[]
for p in patterns:
  for q in patterns:
    g=[ext(solid),ext(p),ext(solid),ext(q),ext(solid)]
    n=holes(g)
    if n in (2,3,4):
      seqs.append((n,p,q,g))
print('found',len(seqs),'seqs')
for n,p,q,g in seqs[:60]:
  print('n',n,'p',p,'q',q)
