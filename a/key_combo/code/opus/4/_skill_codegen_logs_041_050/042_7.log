    foreground = grid != bg
    exterior = _exterior_background(grid, bg)
    holes = (grid == bg) & ~exterior
    outline = exterior & _neighbors8_mask(foreground)

    out = grid.copy()
    out[outline] = Color.GREEN
    out[holes] = Color.YELLOW
    return out

