    return patch

def _gen_rect_patches(bg: int, fg: int) -> list[np.ndarray]:
    """Sample three rectangles, then order larger footprints first for placement."""
    hole_count = random.randint(_GEN_HOLE_COUNT_MIN, _GEN_HOLE_COUNT_MAX)
