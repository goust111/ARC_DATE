import numpy as np
from collections import Counter
LEFT_W=12
bg=0

def extend_row(prefix):
    L=len(prefix)
    row=np.zeros(LEFT_W,dtype=int)
    row[:L]=prefix
    out=row.copy()
    suffix=L-1
    out[L:LEFT_W-suffix]=prefix[0]
    out[LEFT_W-suffix:]=prefix[1:]
    return out

def holes(rows):
    g=np.array(rows)
    H,W=g.shape
    bg=0
    seen=np.zeros((H,W),bool)
    from collections import deque
    q=deque()
    for r in range(H):
      for c in [0,W-1]:
        if g[r,c]==bg and not seen[r,c]: seen[r,c]=1;q.append((r,c))
    for c in range(W):
      for r in [0,H-1]:
        if g[r,c]==bg and not seen[r,c]: seen[r,c]=1;q.append((r,c))
    while q:
      r,c=q.popleft()
      for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
        if 0<=nr<H and 0<=nc<W and g[nr,nc]==bg and not seen[nr,nc]:
          seen[nr,nc]=1;q.append((nr,nc))
    rem=(g==bg)&~seen
    n=0
    for r in range(H):
      for c in range(W):
        if rem[r,c]:
          n+=1
          q=deque([(r,c)]); rem[r,c]=0
          while q:
            rr,cc=q.popleft()
            for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
              if 0<=nr<H and 0<=nc<W and rem[nr,nc]: rem[nr,nc]=0;q.append((nr,nc))
    return n

patterns=[]
for L in range(3,7):
  for bits in range(1<<(L-2)):
    prefix=[2]
    for i in range(L-2):
      prefix.append(0 if bits>>i &1 else 3)
    prefix.append(2)
    patterns.append(tuple(prefix))
print('patterns',len(patterns))
for p in patterns:
  print(p, extend_row(p))

# search short constructions using cap row + band rows
solid=(2,3,2)
for p in patterns:
  if 0 not in p[1:-1]:
    continue
  for band in range(1,5):
    rows=[extend_row(solid)] + [extend_row(p)]*band + [extend_row(solid)]
    print('band',p,band,'holes',holes(rows))
