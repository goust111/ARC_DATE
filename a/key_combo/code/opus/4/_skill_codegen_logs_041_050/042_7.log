+        if target == 2:
+            band_mask = random.choice(PAIR_MASKS)
+            band_height = random.randint(1, 3)
+            core_masks = [random.choice(NEUTRAL_MASKS), *([band_mask] * band_height), random.choice(NEUTRAL_MASKS)]
