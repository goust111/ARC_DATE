    H, W = shape
    dr, dc = direction
    assert (dr == 0) != (dc == 0), "movement direction must be cardinal"
    if dr < 0:
        return int(coords[:, 0].min())
    if dr > 0:
        return int(H - 1 - coords[:, 0].max())
    if dc < 0:
