    fg_bbox = bbox(fg_mask)
    assert fg_bbox is not None, "expected foreground pixels"
    r0, _c0, r1, _c1 = fg_bbox
    height = r1 - r0 + 1
    assert height % 2 == 0, "foreground bounding box height must split evenly"

    split_row = r0 + height // 2
