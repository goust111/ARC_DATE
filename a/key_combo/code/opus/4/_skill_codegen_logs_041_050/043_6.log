+    return None
+
+
+def _place_crossing(
+    shape: tuple[int, int], color: int, size: tuple[int, int, int], frames: list[dict]
+) -> dict | None:
+    inner_h, inner_w, _ = size
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    larger_targets = [frame for frame in frames if frame["area"] > size[2]]
+    random.shuffle(larger_targets)
