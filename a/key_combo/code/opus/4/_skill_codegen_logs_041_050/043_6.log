+    big_h, big_w, big_area = random.choice(BIG_OPTIONS)
+    small_choices = [
+        option
+        for option in SIZE_OPTIONS
+        if option[2] < big_area and option[0] + 2 <= big_h and option[1] + 2 <= big_w
