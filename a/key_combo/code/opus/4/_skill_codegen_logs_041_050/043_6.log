+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+PALETTE = [1, 2, 3, 4]
+SIZE_OPTIONS = [
+    (2, 3, 6),
+    (2, 4, 8),
+    (3, 3, 9),
+    (2, 5, 10),
+    (3, 4, 12),
+    (3, 5, 15),
+    (4, 4, 16),
+    (3, 6, 18),
+    (4, 5, 20),
+    (4, 6, 24),
+    (5, 5, 25),
+]
+BIG_OPTIONS = [(4, 5, 20), (4, 6, 24), (5, 5, 25)]
+MAX_GENERATION_ATTEMPTS = 500
