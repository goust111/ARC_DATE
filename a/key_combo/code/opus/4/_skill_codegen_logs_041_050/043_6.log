+                    if any(candidate["interior"] & frame["interior"] for frame in others):
+                        continue
+                    if any(candidate["perimeter"] & frame["interior"] for frame in others):
+                        continue
+                    if any(candidate["interior"] & frame["perimeter"] for frame in others):
+                        continue
