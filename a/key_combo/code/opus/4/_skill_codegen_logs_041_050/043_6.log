+    return {(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)}
+
+
+def _incremental_fill_coords(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    height = r1 - r0 - 1
+    width = c1 - c0 - 1
