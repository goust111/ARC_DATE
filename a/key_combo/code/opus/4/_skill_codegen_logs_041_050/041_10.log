+    mask: set[tuple[int, int]] = set()
+    for r0, c0 in origins:
+        for rr, cc in np.argwhere(patch != BG):
+            ar = int(r0 + rr)
+            ac = int(c0 + cc)
+            if 0 <= ar < shape[0] and 0 <= ac < shape[1]:
+                mask.add((ar, ac))
+    return mask
