    assert sprite_bbox is not None, "expected a foreground sprite"
    sprite = crop_bbox(g, sprite_bbox)
    assert sprite.shape == (3, 3), "expected a 3x3 foreground bbox"

    return np.concatenate((sprite, sprite), axis=1)

