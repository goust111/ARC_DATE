+        bbox_a = (final_a[0], final_a[1], final_a[0] + h_a - 1, final_a[1] + w_a - 1)
+        bbox_b = (final_b[0], final_b[1], final_b[0] + h_b - 1, final_b[1] + w_b - 1)
