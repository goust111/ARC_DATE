+BAR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GRID_SIDE_RANGE = (17, 24)
+SPRITE_AREA_RANGE = (4, 6)
+GENERATION_RETRIES = 400
+LEFT_SIDE_WEIGHT = 0.8
+TOP_SIDE_WEIGHT = 0.86
