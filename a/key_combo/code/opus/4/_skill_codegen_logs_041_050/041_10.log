+
+def _colorize_shape(mask_patch: np.ndarray, main_color: int, marker_color: int) -> np.ndarray:
+    patch = np.zeros_like(mask_patch, dtype=int)
+    patch[mask_patch == 1] = int(main_color)
+    patch[mask_patch == 2] = int(marker_color)
+    return patch
