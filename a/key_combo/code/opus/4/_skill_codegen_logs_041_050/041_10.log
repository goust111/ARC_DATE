+        if not ((r0 == 0 or r1 == H - 1 or c0 == 0 or c1 == W - 1) and ((r0 == r1) ^ (c0 == c1))):
+            continue
+        edge = _edge_name(g.shape, int(r0 if c0 == c1 else r0), int(c0 if r0 == r1 else c0))
