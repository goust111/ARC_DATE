+
+def _signed_step(edge: str, patch_shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = map(int, patch_shape)
+    if edge == "left":
+        return -h, 0
+    if edge == "right":
+        return h, 0
+    if edge == "top":
+        return 0, -w
+    if edge == "bottom":
+        return 0, w
