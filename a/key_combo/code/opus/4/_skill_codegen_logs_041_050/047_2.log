+            return None
+        grid[coords[:, 0], coords[:, 1]] = SPRITE_COLOR
+
+    if not _valid_instance(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
