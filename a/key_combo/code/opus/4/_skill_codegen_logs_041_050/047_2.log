+            raw_coords[idx] = None
+        return False
+
+    if not backtrack(0):
+        return None
+    return [coords for coords in raw_coords if coords is not None]
+
+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randint(*GRID_HEIGHT_RANGE)
