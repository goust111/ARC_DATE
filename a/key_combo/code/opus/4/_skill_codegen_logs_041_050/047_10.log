75: def _gen_valid_positions(height, used_filled):
76:     """Return shuffled placements whose filled spans do not overlap used cells."""
77:     width = 2 * (height - 1)
78:     positions = []
79:     for r0 in range(CANVAS_SIZE + 1 - height):
80:         for c0 in range(CANVAS_SIZE + 1 - width):
81:             boundary, filled = _gen_outline_cells(r0, c0, height)
82:             if all(not used_filled[r, c] for r, c in filled):
83:                 positions.append((r0, c0, boundary, filled))
84:     random.shuffle(positions)
85:     return positions
86: 
87: def _place_outlines(heights, order):
88:     """Backtrack over shuffled valid positions; return placements or None."""
89:     placements = [None] * len(heights)
90:     used_filled = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)
91: 
92:     def place_from(pos):
93:         if pos == len(order):
94:             return True
95: 
96:         idx = order[pos]
97:         for r0, c0, boundary, filled in _gen_valid_positions(heights[idx], used_filled):
98:             for r, c in filled:
99:                 used_filled[r, c] = True
100:             placements[idx] = (r0, c0, boundary, filled)
101: 
102:             if place_from(pos + 1):
103:                 return True
104: 
105:             placements[idx] = None
106:             for r, c in filled:
107:                 used_filled[r, c] = False
108: 
109:         return False
110: 
111:     return placements if place_from(0) else None
