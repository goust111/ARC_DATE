+def _detect_separator(grid: np.ndarray) -> int:
+    colors: list[int] = []
+    for r in range(grid.shape[0]):
+        row = grid[r, :]
+        if bool(np.all(row == row[0])) and int(row[0]) != BLACK:
+            colors.append(int(row[0]))
+    for c in range(grid.shape[1]):
