59: def _gen_outline_cells(r0, c0, height):
60:     """Return boundary cells and filled row spans for one V outline."""
61:     width = 2 * (height - 1)
62:     boundary = []
63:     filled = []
64:     for k in range(height):
65:         side_k = min(k, height - 2)
66:         r = r0 + k
67:         c_left = c0 + side_k
68:         c_right = c0 + width - 1 - side_k
69:         boundary.append((r, c_left))
70:         boundary.append((r, c_right))
71:         for c in range(c_left, c_right + 1):
72:             filled.append((r, c))
73:     return boundary, filled
