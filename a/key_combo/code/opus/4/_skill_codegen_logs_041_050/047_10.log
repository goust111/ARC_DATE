67:     draw_diagonal(grid, np.random.choice(range(7)), np.random.choice(range(7)), c3)
68: 
69:     # make sure that the output is completely filled up with the pattern meaning it doesn't contain any black pixels
70:     if np.any(main(grid) == Color.BLACK):
71:         return generate_input()
72:     
