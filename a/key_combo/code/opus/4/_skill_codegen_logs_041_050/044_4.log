+        if not all(1 <= gap <= 4 for gap in gaps):
+            return False
+        for bar in bars:
+            if ref[:, min(bar.col, 1)].size and bar.col in (0, 1):
+                return False
+
+        boxes = [_stamp_bbox((h - 2, bar.col), h - 2 - bar.bottom) for bar in bars]
