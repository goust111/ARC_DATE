+            r0, c0, r1, c1 = box
+            if r0 < 0 or c0 < 0 or r1 >= h - 1 or c1 >= w:
+                return False
+        for i in range(len(boxes)):
+            for j in range(i + 1, len(boxes)):
+                if _boxes_overlap(boxes[i], boxes[j]):
