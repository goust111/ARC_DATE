+
+    if not backtrack(0):
+        return None
+    cols = [0] * len(distances)
+    for i, col in chosen:
+        cols[i] = col
+    return cols
+
+
+def _generate_instance() -> np.ndarray | None:
+    h = random.randint(18, 26)
+    w = random.randint(18, 26)
+    n_bars = random.choice([3, 4])
+    distances = sorted(random.sample([1, 2, 3, 4], k=n_bars))
