+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = False,
+        return_format: str = "dict",
+        **_: object,
+    ) -> list[dict]:
+        if bg is None:
+            values, counts = np.unique(grid, return_counts=True)
+            bg = int(values[counts.argmax()])
+        assert connectivity == 4
+        assert not monochromatic
+        assert return_format == "dict"
+
+        h, w = grid.shape
+        seen = np.zeros((h, w), dtype=bool)
+        out: list[dict] = []
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c] or int(grid[r, c]) == bg:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                arr = np.array(coords, dtype=int)
+                out.append({"coords": arr, "bbox": bbox_coords(arr), "area": int(arr.shape[0]), "color": None})
+        return out
+
+
+BG = Color.BLACK
+INDICATOR = Color.RED
+BODY_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW, Color.ORANGE)
+ENVELOPE = Color.TEAL
+SIDES = ("top", "bottom", "left", "right")
+GRID_H_RANGE = (22, 28)
+GRID_W_RANGE = (24, 28)
+RECT_COUNT_WEIGHTS = ((2, 2), (3, 3), (4, 2))
+MAX_GEN_ATTEMPTS = 400
+MIN_MARGIN = 6
