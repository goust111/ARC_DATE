+        rects.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "h": h,
+                "w": w,
+                "area": h * w,
+                "body": int(body),
+                "side": candidates[0],
+                "indicator": (rr, cc),
+            }
+        )
