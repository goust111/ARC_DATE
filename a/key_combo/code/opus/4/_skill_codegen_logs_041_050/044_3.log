            placed = False
            for _ in range(PLACEMENT_ATTEMPTS):
                candidate = _random_bbox(rng, size, min_dim, max_dim)
                if _perimeters_overlap(candidate, bboxes[ordering[i - 1]]):
                    bboxes[color] = candidate
