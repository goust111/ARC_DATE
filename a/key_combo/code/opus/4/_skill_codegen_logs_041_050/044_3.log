def _edge_mask(shape: tuple[int, int], side: str) -> np.ndarray:
    H, W = shape
    mask = np.zeros((H, W), dtype=bool)
    if side == "top":
        mask[0, :] = True
    elif side == "bottom":
        mask[H - 1, :] = True
    elif side == "left":
        mask[:, 0] = True
    elif side == "right":
        mask[:, W - 1] = True
    else:
        raise ValueError(f"unknown side: {side}")
    return mask


