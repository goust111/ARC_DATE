+    class Color:
+        BLACK = 0
+        BLUE = 1
+        RED = 2
+        GREEN = 3
+        YELLOW = 4
+        ORANGE = 7
+        TEAL = 8
+
+    def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        return int(r0), int(c0), int(r1), int(c1)
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = False,
+        return_format: str = "dict",
+        **_: object,
+    ) -> list[dict]:
+        if bg is None:
+            values, counts = np.unique(grid, return_counts=True)
+            bg = int(values[counts.argmax()])
+        assert connectivity == 4
+        assert not monochromatic
+        assert return_format == "dict"
+
+        h, w = grid.shape
+        seen = np.zeros((h, w), dtype=bool)
+        out: list[dict] = []
+        for r in range(h):
+            for c in range(w):
+                if seen[r, c] or int(grid[r, c]) == bg:
+                    continue
+                stack = [(r, c)]
+                seen[r, c] = True
+                coords = []
+                while stack:
+                    rr, cc = stack.pop()
+                    coords.append((rr, cc))
+                    for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) != bg:
+                            seen[nr, nc] = True
+                            stack.append((nr, nc))
+                arr = np.array(coords, dtype=int)
+                out.append({"coords": arr, "bbox": bbox_coords(arr), "area": int(arr.shape[0]), "color": None})
+        return out
+
+
+BG = Color.BLACK
+INDICATOR = Color.RED
+BODY_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW, Color.ORANGE)
+ENVELOPE = Color.TEAL
+SIDES = ("top", "bottom", "left", "right")
+GRID_H_RANGE = (22, 28)
+GRID_W_RANGE = (24, 28)
+RECT_COUNT_WEIGHTS = ((2, 2), (3, 3), (4, 2))
+MAX_GEN_ATTEMPTS = 400
+MIN_MARGIN = 6
+
+
+def _segments(base_len: int) -> list[tuple[int, int]]:
+    assert base_len >= 1
+    lo = 0
+    hi = base_len - 1
+    out = []
+    if base_len % 2 == 1:
+        while lo <= hi:
+            out.append((lo, hi))
+            lo += 1
+            hi -= 1
+    else:
+        step = 0
+        while lo <= hi:
+            out.append((lo, hi))
+            if step % 2 == 0:
+                hi -= 1
+            else:
+                lo += 1
+            step += 1
+    return out
+
+
+def _indicator_offset(size: int) -> int:
+    return (size - 1) // 2
+
+
+def _indicator_coord(rect: dict) -> tuple[int, int]:
