+    side_kinds = {rect["side"] in {"top", "bottom"} for rect in rects}
+    if len(rects) >= 2 and len(side_kinds) < 2:
+        return False
+    parities = {
+        (rect["w"] if rect["side"] in {"top", "bottom"} else rect["h"]) % 2
+        for rect in rects
+    }
+    if len(rects) >= 2 and len(parities) < 2:
+        return False
+    return True
