+
+
+def _sort_key(rect: dict) -> tuple[int, int, int]:
+    r0, c0, _r1, _c1 = rect["bbox"]
+    area = int(rect.get("area", int(rect["h"]) * int(rect["w"])))
+    return (-area, int(c0), int(r0))
+
+
+def _oracle_from_rects(grid: np.ndarray, rects: list[dict]) -> np.ndarray:
