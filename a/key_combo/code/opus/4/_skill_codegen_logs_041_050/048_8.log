+    row_lines = np.where(np.all(grid == GREY, axis=1))[0]
+    col_lines = np.where(np.all(grid == GREY, axis=0))[0]
+    row_ranges, cell_h = _line_ranges(row_lines, grid.shape[0])
+    col_ranges, cell_w = _line_ranges(col_lines, grid.shape[1])
