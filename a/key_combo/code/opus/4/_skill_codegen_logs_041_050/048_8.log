+    cell = np.zeros((cell_size, cell_size), dtype=int)
+    if count == 0:
+        return cell
+    positions = random.sample([(r, c) for r in range(cell_size) for c in range(cell_size)], k=count)
+    for r, c in positions:
+        cell[r, c] = RED
