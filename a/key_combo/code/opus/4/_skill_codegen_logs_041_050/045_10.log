def _gen_expected_output(grid: np.ndarray, r0: int, c0: int, side: int) -> np.ndarray:
    out = grid.copy()
    rows = np.arange(side)[:, None]
    cols = np.arange(side)[None, :]
    edge_dist = np.minimum(
        np.minimum(rows, side - 1 - rows),
        np.minimum(cols, side - 1 - cols),
