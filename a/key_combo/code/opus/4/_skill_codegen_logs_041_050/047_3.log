+    min_grid_h = max(9, 2 * obj_h + 2 if side in {"top", "bottom"} else obj_h + 2)
+    min_grid_w = max(9, 2 * obj_w + 2 if side in {"left", "right"} else obj_w + 2)
+    max_grid_h = min(18, max(min_grid_h, min_grid_h + random.randint(2, 6)))
