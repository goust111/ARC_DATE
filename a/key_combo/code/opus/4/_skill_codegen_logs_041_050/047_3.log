import itertools, numpy as np
DIRS=((1,0),(-1,0),(0,1),(0,-1))

def comp_count(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); n=0
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                n+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    rr,cc=st.pop()
                    for dr,dc in DIRS:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
    return n

def side_conn(arr,side):
    rs,cs=np.where(arr)
    r0,r1=rs.min(),rs.max(); c0,c1=cs.min(),cs.max()
    if side=='right': edge={(r,c) for r,c in zip(rs,cs) if c==c1}
    elif side=='left': edge={(r,c) for r,c in zip(rs,cs) if c==c0}
    elif side=='top': edge={(r,c) for r,c in zip(rs,cs) if r==r0}
    else: edge={(r,c) for r,c in zip(rs,cs) if r==r1}
    if not edge: return False
    vis={next(iter(edge))}; st=list(vis)
    while st:
        r,c=st.pop()
        for dr,dc in DIRS:
            q=(r+dr,c+dc)
            if q in edge and q not in vis: vis.add(q); st.append(q)
    return len(vis)==len(edge)

def regions_in_grid(arr,side,H,W,r0,c0):
    obj=np.argwhere(arr)
    pts=obj+[r0,c0]
    g=np.zeros((H,W),bool)
    for r,c in pts: g[r,c]=1
    if comp_count(~g)"'!=1: return None
    rs=pts[:,0]; cs=pts[:,1]
    rr0,rr1,cc0,cc1=rs.min(),rs.max(),cs.min(),cs.max()
    if side=='"'right': axis=cc1+1; mir=np.array([(r,2*axis-c) for r,c in pts])
