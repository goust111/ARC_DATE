+        c_range = (1, grid_w - obj_w - 1)
+    elif side == "top":
+        r_range = (obj_h + 1, grid_h - obj_h - 1)
+        c_range = (1, grid_w - obj_w - 1)
+    else:
+        raise ValueError(f"unknown side: {side}")
+    assert r_range[0] <= r_range[1] and c_range[0] <= c_range[1]
+    return r_range, c_range
+
