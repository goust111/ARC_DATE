  39: # Fill pattern controls.
  40: FILL_MODES = ("noise", "row_runs", "column_bands", "diagonal_bands")
  41: MAX_ROW_RUN_CUTS = 3
  42: COLUMN_NOISE_PROB = 0.5
  43: MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND = 1, 3
  44: DIAGONAL_FLIP_PROB = 0.5
