        rc=region_count(shape, side)
        if rc>=3:
            print('FOUND attempt',attempt,'area',n,'side',side,'bbox',max(rs)+1,max(cs)+1,'regions',rc, flush=True)
            arr=np.zeros((max(rs)+1,max(cs)+1),int)
            for r,c in shape: arr[r,c]=1
            print(arr, flush=True)
            raise SystemExit
print('none')
