    elif side=='left': pts={(r,c) for r,c in zip(rs,cs) if c==c0}
    elif side=='top': pts={(r,c) for r,c in zip(rs,cs) if r==r0}
    else: pts={(r,c) for r,c in zip(rs,cs) if r==r1}
