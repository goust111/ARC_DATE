+        mirrored = [(r, 2 * axis - c) for r, c in object_coords.tolist()]
+    elif side == "right":
+        axis = c1 + 1
+        mirrored = [(r, 2 * axis - c) for r, c in object_coords.tolist()]
+    elif side == "top":
+        axis = r0 - 1
+        mirrored = [(2 * axis - r, c) for r, c in object_coords.tolist()]
+    elif side == "bottom":
