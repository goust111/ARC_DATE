+
+    object_coords = _extract_single_component(g, ORANGE)
+    marker_coords = _extract_single_component(g, RED)
+    side = _detect_marker_side(object_coords, marker_coords)
+    r0, c0, r1, c1 = _bbox_from_coords(object_coords)
