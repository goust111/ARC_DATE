        for r,c in shape:
            for dr,dc in DIRS:
                q=(r+dr,c+dc)
                if q not in shape: frontier.append(q)
        shape.add(random.choice(frontier))
    shape=norm(shape)
    rs=[r for r,c in shape]; cs=[c for r,c in shape]
    if max(max(rs)+1,max(cs)+1) < 5:
