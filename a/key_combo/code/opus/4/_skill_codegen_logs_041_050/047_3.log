import random, numpy as np
DIRS=((1,0),(-1,0),(0,1),(0,-1))

def comp_count(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); n=0
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                n+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    rr,cc=st.pop()
                    for dr,dc in DIRS:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                            seen[nr,nc]=1; st.append((nr,nc))
    return n

def region_count(shape, side):
    pts=set(shape)
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    out=set(pts)
    if side=='right': axis=c1+1; out|={(r,2*axis-c) for r,c in pts}
    elif side=='left': axis=c0-1; out|={(r,2*axis-c) for r,c in pts}
    elif side=='top': axis=r0-1; out|={(2*axis-r,c) for r,c in pts}
    else: axis=r1+1; out|={(2*axis-r,c) for r,c in pts}
    rs=[r for r,c in out]; cs=[c for r,c in out]
    H=max(rs)-min(rs)+5; W=max(cs)-min(cs)+5; offr=2-min(rs); offc=2-min(cs)
    mask=np.ones((H,W),bool)
    for r,c in out: mask[r+offr,c+offc]=False
    return comp_count(mask)

def bg_single(shape):
    pts=set(shape)
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    H=max(rs)-min(rs)+5; W=max(cs)-min(cs)+5; offr=2-min(rs); offc=2-min(cs)
    mask=np.ones((H,W),bool)
    for r,c in pts: mask[r+offr,c+offc]=False
    return comp_count(mask)==1

def conn(shape):
    pts=set(shape); st=[next(iter(pts))]; vis={st[0]}
    while st:
        r,c=st.pop()
        for dr,dc in DIRS:
            q=(r+dr,c+dc)
            if q in pts and q not in vis:
                vis.add(q); st.append(q)
    return len(vis)==len(pts)

def norm(shape):
    mr=min(r for r,c in shape); mc=min(c for r,c in shape)
    return {(r-mr,c-mc) for r,c in shape}

def side_edge_connected(shape, side):
    rs=[r for r,c in shape]; cs=[c for r,c in shape]
    r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
    if side=='right': pts={(r,c) for r,c in shape if c==c1}
    elif side=='left': pts={(r,c) for r,c in shape if c==c0}
    elif side=='top': pts={(r,c) for r,c in shape if r==r0}
    else: pts={(r,c) for r,c in shape if r==r1}
    if not pts: return False
    st=[next(iter(pts))]; vis={st[0]}
    while st:
        r,c=st.pop()
        for dr,dc in DIRS:
            q=(r+dr,c+dc)
            if q in pts and q not in vis:
                vis.add(q); st.append(q)
    return len(vis)==len(pts)

