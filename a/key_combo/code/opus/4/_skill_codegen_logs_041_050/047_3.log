+
+def _base_sprite(template: np.ndarray) -> np.ndarray:
+    h, w = template.shape
+    sprite = np.zeros((h, w + 1), dtype=int)
+    sprite[:, :w][template] = ORANGE
+    right_rows = np.where(template[:, w - 1])[0]
