    seen=np.zeros_like(mask,bool); n=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not seen[r,c]:
          n+=1; st=[(r,c)]; seen[r,c]=1
          while st:
            rr,cc=st.pop()
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
              nr,nc=rr+dr,cc+dc
              if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1; st.append((nr,nc))
    return n

def conn(pts):
    st=[next(iter(pts))]; vis={st[0]}
    while st:
        r,c=st.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            q=(r+dr,c+dc)
            if q in pts and q not in vis:
                vis.add(q); st.append(q)
    return len(vis)==len(pts)

def bg_single(pts):
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    H=max(rs)-min(rs)+5; W=max(cs)-min(cs)+5; offr=2-min(rs); offc=2-min(cs)
    mask=np.ones((H,W),bool)
    for r,c in pts: mask[r+offr,c+offc]=False
    seen=np.zeros_like(mask,bool); n=0
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not seen[r,c]:
          n+=1; st=[(r,c)]; seen[r,c]=1
          while st:
            rr,cc=st.pop()
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
              nr,nc=rr+dr,cc+dc
              if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1; st.append((nr,nc))
    return n==1

def norm(pts):
    mr=min(r for r,c in pts); mc=min(c for r,c in pts)
    return {(r-mr,c-mc) for r,c in pts}

start={(0,0),(0,1),(0,2),(1,0),(1,2),(1,3),(2,0),(2,2),(3,0),(3,1),(3,2),(3,3)}
pts=norm(start)
best=(max(count_regions(pts,s) for s in ('right','left','top','bottom')), pts)
print('start',best[0])
for t in range(50000):
    cur=set(best[1]) if random.random()<0.3 else set(pts)
    if random.random()<0.5 and len(cur)>8:
        # remove a random cell and maybe add another
        cand=list(cur)
        random.shuffle(cand)
        moved=False
        for p in cand:
            ns=set(cur); ns.remove(p)
            if conn(ns):
                cur=ns; moved=True; break
        if not moved: continue
    else:
        frontier=set()
        for r,c in cur:
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                q=(r+dr,c+dc)
                if q not in cur: frontier.add(q)
        if not frontier: continue
        cur.add(random.choice(tuple(frontier)))
        if len(cur)>15:
