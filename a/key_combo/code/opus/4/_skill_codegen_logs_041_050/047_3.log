import random, numpy as np
DIRS=((1,0),(-1,0),(0,1),(0,-1))

def comps(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); out=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                st=[(r,c)]; seen[r,c]=1; cur=[]
                while st:
                    rr,cc=st.pop(); cur.append((rr,cc))
                    for dr,dc in DIRS:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
                out.append(cur)
    return out

def rand_connected(h,w,n):
    start=(random.randrange(h),random.randrange(w))
    cells={start}
    while len(cells)<n:
        frontier=[]
        for r,c in cells:
            for dr,dc in DIRS:
                q=(r+dr,c+dc)
                if 0<=q[0]<h and 0<=q[1]<w and q not in cells: frontier.append(q)
        if not frontier: return None
        cells.add(random.choice(frontier))
    arr=np.zeros((h,w),bool)
    for r,c in cells: arr[r,c]=1
    rs,cs=np.where(arr)
    return arr[rs.min():rs.max()+1, cs.min():cs.max()+1]

def side_edge_connected(arr, side):
    rs,cs=np.where(arr)
