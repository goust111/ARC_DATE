            if not moved: continue
    cur=norm(cur)
    rs=[r for r,c in cur]; cs=[c for r,c in cur]
    if max(max(rs)-min(rs)+1,max(cs)-min(cs)+1)<4: continue
    if not bg_single(cur): continue
    score=max(count_regions(cur,s) for s in ('right','left','top','bottom'))
    if score>best[0]:
        best=(score,cur)
        print('best',score,'area',len(cur),'bbox',max(rs)+1,max(cs)+1)
        arr=np.zeros((max(rs)+1,max(cs)+1),int)
        for r,c in cur: arr[r,c]=1
        print(arr)
        if score>=4: break
    pts=cur
print('final best',best[0])
arr=np.zeros((max(r for r,c in best[1])+1,max(c for r,c in best[1])+1),int)
for r,c in best[1]: arr[r,c]=1
