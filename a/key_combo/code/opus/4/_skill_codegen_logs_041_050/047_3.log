   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Fill each colored outline by painting the horizontal row spans enclosed by its paired boundary pixels.
  10: 
  11:     Input structure
  12:     - The grid has a dominant background and one or more monochromatic 8-connected foreground outlines.
  13:     - Each outline has exactly two pixels on every row it occupies; those pixels are the left and right boundary of that row.
  14: 
  15:     Rule
  16:     - For each foreground outline, process only the rows touched by that outline.
  17:     - On each touched row, recolor the whole interval between the two boundary pixels to the outline color.
  18:     - Keep all other pixels unchanged.
  19: 
  20:     Key insight
  21:     - The sparse diagonal sides already mark the row-by-row horizontal fill limits of the solid shape.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2, "expected a 2D grid"
  25: 
  26:     bg = get_bg(g)
  27:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=True, return_format="dict")
  28:     assert objects, "expected at least one foreground outline"
  29: 
  30:     out = g.copy()
  31:     for obj in objects:
  32:         color = int(obj["color"])
  33:         coords = obj["coords"]
  34:         rows = sorted({int(r) for r in coords[:, 0]})
  35:         assert rows, "expected each object to occupy at least one row"
  36: 
  37:         for r in rows:
  38:             row_cols = coords[coords[:, 0] == r, 1]
  39:             assert row_cols.size == 2, "expected exactly two boundary pixels per occupied row"
  40:             c0 = int(row_cols.min())
  41:             c1 = int(row_cols.max())
  42: 
  43:             span = g[r, c0 : c1 + 1]
  44:             assert np.all((span == bg) | (span == color)), "row span must contain only background and the outline color"
  45:             out[r, c0 : c1 + 1] = color
  46: 
  47:     return out
  48: 
