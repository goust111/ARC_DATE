+    if side == "right":
+        r_range = (1, grid_h - obj_h - 1)
+        c_range = (1, grid_w - 2 * obj_w - 1)
+    elif side == "left":
+        r_range = (1, grid_h - obj_h - 1)
+        c_range = (obj_w + 1, grid_w - obj_w - 1)
+    elif side == "bottom":
+        r_range = (1, grid_h - 2 * obj_h - 1)
+        c_range = (1, grid_w - obj_w - 1)
+    elif side == "top":
