+    max_grid_h = min(18, max(min_grid_h, min_grid_h + random.randint(2, 6)))
+    max_grid_w = min(18, max(min_grid_w, min_grid_w + random.randint(2, 6)))
+    if min_grid_h > max_grid_h or min_grid_w > max_grid_w:
