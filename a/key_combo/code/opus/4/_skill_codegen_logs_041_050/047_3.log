    if mir[:,0].min()<0 or mir[:,1].min()<0 or mir[:,0].max()>=H or mir[:,1].max()>=W: return None
    g2=np.zeros((H,W),bool)
    for r,c in pts: g2[r,c]=1
    for r,c in mir: g2[r,c]=1
    return comp(~g2), g2

best=0
bestarr=None
for w in range(5,9):
  for rows in itertools.product(range(1<<w), repeat=3):
    arr=np.array([[ (rows[r]>>c)&1 for c in range(w)] for r in range(3)],dtype=bool)
