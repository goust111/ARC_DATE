+        wrong_regions = _sorted_regions(wrong)
+        for i, region in enumerate(wrong_regions):
+            if i % 3 == 0:
+                _paint(wrong, region, YELLOW)
+        assert not np.array_equal(wrong, solved)
+    assert feasible_wrong >= 1
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
