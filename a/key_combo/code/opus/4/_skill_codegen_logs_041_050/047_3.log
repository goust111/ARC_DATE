+    sprite[right_rows, w] = RED
+    return sprite
+
+
+def _apply_transform(sprite: np.ndarray) -> np.ndarray:
+    out = sprite.copy()
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    k = random.randrange(4)
+    return np.rot90(out, k=k)
+
+
+def _target_bbox_ranges(
+    grid_h: int, grid_w: int, obj_h: int, obj_w: int, side: str
