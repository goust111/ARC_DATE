DIRS=((1,0),(-1,0),(0,1),(0,-1))

def comp(mask):
    H,W=mask.shape; seen=np.zeros_like(mask,bool); n=0
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                n+=1; st=[(r,c)]; seen[r,c]=1
                while st:
                    rr,cc=st.pop()
                    for dr,dc in DIRS:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
    return n

def regions(arr, side='top', H=12, W=14):
    ah,aw=arr.shape
    r0=ah+1 if side=='top' else 2
    c0=(W-aw)//2
    obj=np.argwhere(arr)
    pts=obj+[r0,c0]
    g=np.zeros((H,W),bool)
    for r,c in pts: g[r,c]=1
    if comp(~g)"'!=1: return None
    rs=pts[:,0]; cs=pts[:,1]
    rr0,rr1,cc0,cc1=rs.min(),rs.max(),cs.min(),cs.max()
    if side=='"'top': axis=rr0-1; mir=np.array([(2*axis-r,c) for r,c in pts])
    elif side=='bottom': axis=rr1+1; mir=np.array([(2*axis-r,c) for r,c in pts])
    elif side=='left': axis=cc0-1; mir=np.array([(r,2*axis-c) for r,c in pts])
