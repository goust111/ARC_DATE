+def _validate_instance(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and max(g.shape) <= 30
+    assert set(np.unique(g)).issubset({BLACK, RED, ORANGE})
