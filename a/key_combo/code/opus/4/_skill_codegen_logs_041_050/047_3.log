  59: def _gen_outline_cells(r0, c0, height):
  60:     """Return boundary cells and filled row spans for one V outline."""
  61:     width = 2 * (height - 1)
  62:     boundary = []
  63:     filled = []
  64:     for k in range(height):
  65:         side_k = min(k, height - 2)
  66:         r = r0 + k
  67:         c_left = c0 + side_k
  68:         c_right = c0 + width - 1 - side_k
  69:         boundary.append((r, c_left))
  70:         boundary.append((r, c_right))
  71:         for c in range(c_left, c_right + 1):
  72:             filled.append((r, c))
  73:     return boundary, filled
  74: 
  75: def _gen_valid_positions(height, used_filled):
  76:     """Return shuffled placements whose filled spans do not overlap used cells."""
  77:     width = 2 * (height - 1)
  78:     positions = []
  79:     for r0 in range(CANVAS_SIZE + 1 - height):
  80:         for c0 in range(CANVAS_SIZE + 1 - width):
  81:             boundary, filled = _gen_outline_cells(r0, c0, height)
  82:             if all(not used_filled[r, c] for r, c in filled):
  83:                 positions.append((r0, c0, boundary, filled))
  84:     random.shuffle(positions)
  85:     return positions
  86: 
  87: def _place_outlines(heights, order):
  88:     """Backtrack over shuffled valid positions; return placements or None."""
  89:     placements = [None] * len(heights)
  90:     used_filled = np.zeros((CANVAS_SIZE, CANVAS_SIZE), dtype=bool)
  91: 
  92:     def place_from(pos):
  93:         if pos == len(order):
  94:             return True
  95: 
  96:         idx = order[pos]
  97:         for r0, c0, boundary, filled in _gen_valid_positions(heights[idx], used_filled):
  98:             for r, c in filled:
  99:                 used_filled[r, c] = True
 100:             placements[idx] = (r0, c0, boundary, filled)
 101: 
 102:             if place_from(pos + 1):
 103:                 return True
 104: 
 105:             placements[idx] = None
 106:             for r, c in filled:
 107:                 used_filled[r, c] = False
 108: 
 109:         return False
 110: 
 111:     return placements if place_from(0) else None
 112: 
 113: def _render_grids(colors, placements):
 114:     """Render sparse input and its filled oracle target."""
 115:     inp = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
 116:     expected = np.full((CANVAS_SIZE, CANVAS_SIZE), BACKGROUND, dtype=int)
 117:     for color, placement in zip(colors, placements):
 118:         _, _, boundary, filled = placement
 119:         for r, c in boundary:
 120:             inp[r, c] = color
 121:         for r, c in filled:
 122:             expected[r, c] = color
 123:     return inp, expected
