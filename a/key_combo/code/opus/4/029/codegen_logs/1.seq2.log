+    grid[top : bottom + 1, right] = FRAME
+    grid[top, left : right + 1] = FRAME
+    grid[bottom, left : right + 1] = FRAME
+
+
+def _marker_pairs(grid: np.ndarray, bbox: BBox, orientation: str) -> list[tuple[Coord, Coord]]:
