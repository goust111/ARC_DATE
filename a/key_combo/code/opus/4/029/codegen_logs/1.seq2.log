+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    out: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[Coord] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while q:
