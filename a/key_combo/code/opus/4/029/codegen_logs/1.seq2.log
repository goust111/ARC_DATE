+
+
+def _split_from_markers(grid: np.ndarray) -> tuple[BBox, BBox]:
+    markers = np.argwhere(grid == MARKER)
+    assert markers.shape == (2, 2), "expected exactly two red markers"
+    h, w = grid.shape
+    (r0, c0), (r1, c1) = markers
+    if int(r0) == int(r1):
+        mid = w // 2
+        in_left = int(c0) < mid and int(c1) < mid
