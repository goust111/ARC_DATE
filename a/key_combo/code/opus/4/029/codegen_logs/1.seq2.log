+
+
+def _frame_positions(h: int, w: int, bbox: BBox, inner_h: int, inner_w: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    fh, fw = inner_h + 2, inner_w + 2
