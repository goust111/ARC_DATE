+    dynamic_map: dict[int, tuple[list[Coord | None], Coord]],
+) -> list[np.ndarray]:
+    frames = [np.full((panel_h, panel_w), Color.BLACK, dtype=int) for _ in range(3)]
+    for color, pos in static_map.items():
+        for frame in frames:
+            frame[pos] = color
