+    for _ in range(MAX_COMPONENT_ATTEMPTS):
+        candidate = build_side_walk(side_axis, opposite_sign, far_len, forbidden)
+        if candidate is None:
+            continue
+        if candidate != far_target:
+            far_input = candidate
+            break
+    if far_input is None:
+        return None
