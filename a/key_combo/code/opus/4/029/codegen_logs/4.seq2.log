+    far_target = [((-approach_sign, 0) if side_axis == 0 else (0, -approach_sign))]
+    cur = far_target[0]
+    for step in outward_steps:
+        dr, dc = mirror_step(step, axis_name)
+        cur = (cur[0] + dr, cur[1] + dc)
+        far_target.append(cur)
