+def relative_dirs(first_lateral: bool, side_axis: int) -> list[Coord]:
+    lateral = [(0, 1), (0, -1)] if side_axis == 0 else [(1, 0), (-1, 0)]
+    axial = [(1, 0), (-1, 0)] if side_axis == 0 else [(0, 1), (0, -1)]
