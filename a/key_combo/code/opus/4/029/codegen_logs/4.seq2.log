+        axis = "vertical"
+        side_axis = 0
+        gate_ends = {(0, -1), (0, 1)}
+    else:
+        axis = "horizontal"
+        side_axis = 1
+        gate_ends = {(-1, 0), (1, 0)}
+
+    approach_sign = random.choice([-1, 1])
+    near_len = random.randint(*SIDE_POINTS_RANGE)
