    if not possible_sizes:
        return None
    size = random.choice(possible_sizes)
    choices = [shape for shape in _GEN_SHAPES_BY_SIZE[size] if shape not in used_shapes]
    shape = random.choice(choices)
    used_shapes.add(shape)
    return shape


