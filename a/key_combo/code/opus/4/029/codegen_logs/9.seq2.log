    grid[GEN_TEMPLATE_SPAN, 0:GEN_FRAME_SPAN] = GEN_FRAME_COLOR
    grid[0:GEN_FRAME_SPAN, GEN_TEMPLATE_SPAN] = GEN_FRAME_COLOR


