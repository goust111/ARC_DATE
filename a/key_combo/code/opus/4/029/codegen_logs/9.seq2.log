def _gen_shape_patch(shape, color):
    h = max(r for r, _c in shape) + 1
    w = max(c for _r, c in shape) + 1
    patch = np.zeros((h, w), dtype=int)
    for r, c in shape:
        patch[r, c] = int(color)
