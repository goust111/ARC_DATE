+        rects.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "layers": [
+                    {
+                        "bbox": (
+                            r0 + lr0,
+                            c0 + lc0,
+                            r0 + lr1,
+                            c0 + lc1,
+                        ),
+                        "color": layer["color"],
+                    }
+                    for layer in layers
+                    for (lr0, lc0, lr1, lc1) in [layer["bbox_local"]]
