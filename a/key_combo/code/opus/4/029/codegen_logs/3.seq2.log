    return None


def _split_bar_lengths(total_gray, n_bars):
    min_len, max_len = BAR_LENGTH_RANGE
    if n_bars == 2 and total_gray >= 2:
        lo_b1 = max(min_len, total_gray - max_len)
        hi_b1 = min(total_gray - min_len, max_len)
        if lo_b1 > hi_b1:
