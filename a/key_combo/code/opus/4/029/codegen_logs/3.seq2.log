+def _is_frame_component(grid: np.ndarray, comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    mask = _component_mask(comp["coords"], comp["bbox"])
+    frame = np.zeros_like(mask)
+    frame[0, :] = True
+    frame[-1, :] = True
+    frame[:, 0] = True
+    frame[:, -1] = True
