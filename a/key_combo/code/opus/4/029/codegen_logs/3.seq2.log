+OBJECT_COLORS = (Color.BLUE, Color.RED, Color.GREEN)
+OBJECT_COLOR_SET = set(OBJECT_COLORS)
+MIN_GRID_ROWS = 16
+MAX_GRID_ROWS = 28
+MIN_GRID_COLS = 20
+MAX_GRID_COLS = 30
+MAX_ATTEMPTS = 400
