+        enclosed = True
+        for r, c in coords:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                if local[nr, nc] != color:
+                    enclosed = False
+                    break
+            if not enclosed:
+                break
+        if enclosed:
+            holes += 1
+    return holes
