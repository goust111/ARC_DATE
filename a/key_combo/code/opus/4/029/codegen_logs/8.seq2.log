+    out_sig = _grid_sig(out)
+    if out_sig in _SEEN_OUTPUT_SIGNATURES:
+        return None
+    _SEEN_OUTPUT_SIGNATURES.add(out_sig)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
