+    call_index = _GEN_COUNTER
+    for attempt in range(_MAX_GEN_ATTEMPTS):
+        grid = _make_case(call_index + attempt)
+        if grid is not None:
+            _GEN_COUNTER = call_index + attempt + 1
+            return grid
