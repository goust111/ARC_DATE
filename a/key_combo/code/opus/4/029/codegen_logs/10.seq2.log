0025:     h, w = g.shape
0026:     out = g.copy()
0027:     bg = get_bg(g)
0028: 
0029:     comps = components_mask(g != bg, connectivity=4)
0030:     singles: list[tuple[int, int, int]] = []
0031:     blocks: list[tuple[int, int, int, int]] = []  # (r0,c0,size,color)
0032:     for pts in comps:
0033:         if len(pts) == 1:
0034:             r, c = pts[0]
0035:             singles.append((int(r), int(c), int(g[r, c])))
0036:             continue
0037:         r0, c0, r1, c1 = bbox_coords(pts)
0038:         hh, ww = r1 - r0 + 1, c1 - c0 + 1
0039:         if hh != ww or hh < 2:
0040:             continue
0041:         sub = g[r0 : r1 + 1, c0 : c1 + 1]
0042:         col = int(sub[0, 0])
0043:         if col == bg:
0044:             continue
0045:         if np.all(sub == col) and sub.size == len(pts):
0046:             blocks.append((int(r0), int(c0), int(hh), col))
0047: 
0048:     assert singles and blocks, "grid must contain legend pixels and main blocks"
