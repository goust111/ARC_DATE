0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """Flood-fill black background regions connected to original blue pixels, turning them blue while leaving blockers unchanged.
0011: 
0012:     Input structure:
0013:     - A rectangular grid has black background cells, one or more blue seed pixels, and other non-black colors acting as blockers.
0014:     Rule:
0015:     - Starting from every original blue pixel, traverse 4-neighbor black cells and recolor each reached black cell blue.
0016:     - Leave every non-black pixel unchanged.
0017:     Key insight:
0018:     - Black cells remain black exactly when no orthogonal path of black cells connects them to an original blue seed.
0019:     """
0020:     g = np.asarray(grid, dtype=int)
0021:     assert g.ndim == 2
0022:     assert get_bg(g) == Color.BLACK
0023: 
0024:     seeds = [tuple(map(int, rc)) for rc in np.argwhere(g == Color.BLUE)]
0025:     assert seeds
0026: 
0027:     out = g.copy()
0028:     seen = np.zeros(g.shape, dtype=bool)
0029:     q: deque[tuple[int, int]] = deque()
0030:     for r, c in seeds:
0031:         seen[r, c] = True
0032:         q.append((r, c))
0033: 
0034:     while q:
0035:         r, c = q.popleft()
0036:         for rr, cc in neighbors4(r, c):
0037:             if not in_bounds(g.shape, rr, cc) or seen[rr, cc] or g[rr, cc] != Color.BLACK:
0038:                 continue
0039:             seen[rr, cc] = True
0040:             out[rr, cc] = Color.BLUE
0041:             q.append((rr, cc))
0042: 
0043:     return out
