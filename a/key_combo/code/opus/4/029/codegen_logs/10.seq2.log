+
+def _random_sprite_mask() -> np.ndarray:
+    mask = random.choice(_SPRITE_SHAPES).copy()
+    mask = np.rot90(mask, random.randint(0, 3))
+    if random.random() < 0.5:
+        mask = np.fliplr(mask)
+    if random.random() < 0.5:
+        mask = np.flipud(mask)
+    return np.ascontiguousarray(mask, dtype=bool)
