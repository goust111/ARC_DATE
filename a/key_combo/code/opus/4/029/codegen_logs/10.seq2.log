+    return {
+        "grid": g,
+        "rect_bbox": (rr0, rc0, rr1, rc1),
+        "red": red,
+        "teal": teal,
+        "frame_bbox": frame_bbox,
+        "inner_bbox": inner_bbox,
+        "sprite_coords": sprite_comp["coords"],
+        "sprite_patch": sprite_patch,
+    }
