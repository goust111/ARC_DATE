0058:     cs = sorted({c for _, c, _ in legend})
0059:     drs = [rs[i + 1] - rs[i] for i in range(len(rs) - 1)]
0060:     dcs = [cs[i + 1] - cs[i] for i in range(len(cs) - 1)]
0061:     stepL = reduce(gcd, drs + dcs)
