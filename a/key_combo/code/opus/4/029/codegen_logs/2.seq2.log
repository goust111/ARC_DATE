+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def neighbors4(r: int, c: int):
+    yield int(r) - 1, int(c)
+    yield int(r) + 1, int(c)
+    yield int(r), int(c) - 1
+    yield int(r), int(c) + 1
