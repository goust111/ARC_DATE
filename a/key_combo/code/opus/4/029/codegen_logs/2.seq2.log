+    sh, sw = shape_dims(shape)
+    candidates = []
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            coords = [(r0 + dr, c0 + dc) for dr, dc in shape]
+            if not all(allowed[r, c] and not blocked[r, c] for r, c in coords):
+                continue
+            ok = True
+            for r, c in coords:
+                for rr, cc in object_cells:
