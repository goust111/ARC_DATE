+
+def outside_objects(grid: np.ndarray, frame_bbox: BBox) -> list[dict]:
+    r0, c0, r1, c1 = frame_bbox
+    out = []
+    for comp in find_components(grid, list(OUTSIDE_COLORS) + [GREEN]):
+        rows = comp["coords"][:, 0]
+        cols = comp["coords"][:, 1]
+        inside = (r0 <= rows) & (rows <= r1) & (c0 <= cols) & (cols <= c1)
+        if np.any(inside):
+            continue
+        out.append(comp)
+    return out
