+        BLACK = 0
+        BLUE = 1
+        RED = 2
+        GREEN = 3
+        YELLOW = 4
+        GREY = 5
+        PINK = 6
+        ORANGE = 7
+        TEAL = 8
+        MAROON = 9
+
+    def get_bg(grid: np.ndarray) -> int:
+        return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
