+        if len({tuple(map(int, row)) for row in tile}) < 2:
+            continue
+        if len({tuple(map(int, tile[:, c])) for c in range(period_w)}) < 2:
+            continue
+        if any(not np.any(row != Color.BLACK) for row in tile):
