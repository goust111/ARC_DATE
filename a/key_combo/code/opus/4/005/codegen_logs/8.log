+            for r in range(1, h - 1)
+            for c in range(1, w - 1)
+            if c not in source_cols and (r, c) not in slot and r != divider and _can_place_orange(grid, r, c)
+        ]
+        random.shuffle(candidates)
+        for r, c in candidates[: random.randint(0, 2)]:
+            grid[r, c] = ORANGE
