+        {"axis": dominant_axis, "d": other_d},
+    ]
+    while len(specs) < n_blocks:
+        specs.append({"axis": random.choice(("h", "v")), "d": random.choice(_DISTANCES)})
+
+    random.shuffle(specs)
+    return specs
+
+
+def _can_place(used: np.ndarray, r0: int, c0: int, h: int, w: int) -> bool:
+    rr0 = max(0, r0 - 1)
