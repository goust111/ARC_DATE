+        assert 0 <= er0 <= er1 < shape[0]
+        assert 0 <= ec0 <= ec1 < shape[1]
+        assert not bool(np.any(occupied[er0 : er1 + 1, ec0 : ec1 + 1])), "expanded boxes must be disjoint"
