+        er0, ec0, er1, ec1 = _expanded_box(block)
+        out[er0 : er1 + 1, ec0 : ec1 + 1] = int(block["color"])
+    for block in blocks:
+        paste(out, block["patch"], int(block["r0"]), int(block["c0"]))
+    return out
+
+
