+        count += 1
+        queue = deque([(r, c)])
+        seen[r, c] = True
+        while queue:
+            cr, cc = queue.popleft()
+            for nr, nc in neighbors4(cr, cc):
+                if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
