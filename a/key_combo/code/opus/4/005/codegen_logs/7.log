except Exception:
    class Color:
        BLACK = 0
        BLUE = 1
        RED = 2
        GREEN = 3

    def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
        h, w = shape
        return 0 <= r < h and 0 <= c < w

    def neighbors4(r: int, c: int):
        yield r - 1, c
        yield r + 1, c
        yield r, c - 1
        yield r, c + 1

    def scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
        return np.kron(sprite, np.ones((factor, factor), dtype=sprite.dtype))


CHECKER_BLOCK = np.array(
    [[Color.BLUE, Color.RED], [Color.RED, Color.BLUE]],
    dtype=int,
)

GEN_MAX_ATTEMPTS = 300


def _component_count(mask: np.ndarray) -> int:
    mask = np.asarray(mask, dtype=bool)
    seen = np.zeros_like(mask, dtype=bool)
    count = 0
    for r, c in np.argwhere(mask):
        r = int(r)
        c = int(c)
        if seen[r, c]:
            continue
        count += 1
        queue = deque([(r, c)])
        seen[r, c] = True
        while queue:
            cr, cc = queue.popleft()
            for nr, nc in neighbors4(cr, cc):
                if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
                    seen[nr, nc] = True
                    queue.append((nr, nc))
    return count


def _enclosed_region(boundary_mask: np.ndarray) -> np.ndarray:
    boundary_mask = np.asarray(boundary_mask, dtype=bool)
    h, w = map(int, boundary_mask.shape)
    exterior = np.zeros((h, w), dtype=bool)
    queue: deque[tuple[int, int]] = deque()

    for r in range(h):
        for c in (0, w - 1):
            if not boundary_mask[r, c] and not exterior[r, c]:
                exterior[r, c] = True
                queue.append((r, c))
    for c in range(w):
        for r in (0, h - 1):
            if not boundary_mask[r, c] and not exterior[r, c]:
                exterior[r, c] = True
                queue.append((r, c))

    while queue:
        r, c = queue.popleft()
        for nr, nc in neighbors4(r, c):
            if in_bounds((h, w), nr, nc) and not boundary_mask[nr, nc] and not exterior[nr, nc]:
                exterior[nr, nc] = True
                queue.append((nr, nc))

    return (~boundary_mask) & (~exterior)


