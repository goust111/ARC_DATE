import numpy as np
from collections import deque

def neighbors4(r,c):
    yield r-1,c; yield r+1,c; yield r,c-1; yield r,c+1

def in_bounds(shape,r,c): return 0<=r<shape[0] and 0<=c<shape[1]

def enclosed(boundary):
    H,W = boundary.shape
    ext = np.zeros((H,W), bool)
    q = deque()
    for r in range(H):
        for c in (0, W-1):
            if not boundary[r,c] and not ext[r,c]:
                ext[r,c]=True; q.append((r,c))
    for c in range(W):
        for r in (0, H-1):
            if not boundary[r,c] and not ext[r,c]:
                ext[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for rr,cc in neighbors4(r,c):
            if in_bounds((H,W), rr, cc) and not boundary[rr,cc] and not ext[rr,cc]:
                ext[rr,cc]=True; q.append((rr,cc))
    return (~boundary) & (~ext)

def comps(mask):
    H,W = mask.shape
    seen = np.zeros_like(mask, bool)
    cnt=0
    for r,c in np.argwhere(mask):
        if seen[r,c]: continue
        cnt+=1
        q=deque([(int(r),int(c))]); seen[r,c]=True
        while q:
            x,y=q.popleft()
            for xx,yy in neighbors4(x,y):
                if in_bounds((H,W), xx, yy) and mask[xx,yy] and not seen[xx,yy]:
                    seen[xx,yy]=True; q.append((xx,yy))
    return cnt

def notch(h,w,r1,r2,d):
    m=np.zeros((h,w), bool)
    m[0,:]=1; m[h-1,:]=1; m[:,w-1]=1
    m[:r1+1,0]=1
    m[r2:,0]=1
    m[r1, :d+1]=1
    m[r2, :d+1]=1
    m[r1:r2+1, d]=1
    return m

