GEN_SHAPE = (29, 29)
GEN_HEIGHT, GEN_WIDTH = GEN_SHAPE
GEN_BACKGROUND = Color.BLACK
GEN_NON_BLACK_COLORS = range(1, 10)
GEN_COLOR_COUNT_RANGE = (5, 7)

# Lattice vector search bounds.
GEN_V1_COORD_RANGE = range(-6, 7)
