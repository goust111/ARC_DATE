+                if rr == fixed:
+                    clear += 1
+                    assert visible >= 1, "clear rays must visibly reach the spine"
+                    break
+                rr += step
+        else:
+            if c == fixed:
+                continue
+            assert lo <= r <= hi
+            step = 1 if c < fixed else -1
+            visible = 0
+            cc = c + step
+            while True:
+                if int(g[r, cc]) == Color.GREY:
+                    blocked += 1
+                    assert visible >= 1, "blocked rays must visibly stop at a scaffold line"
+                    break
+                if cc != fixed:
+                    visible += 1
+                if cc == fixed:
+                    clear += 1
+                    assert visible >= 1, "clear rays must visibly reach the spine"
+                    break
+                cc += step
