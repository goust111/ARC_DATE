def _gen_choose_spine_length(parallel_dim: int, branch_count: int) -> int | None:
    min_len = max(_GEN_SPINE_LEN_CELLS[0], int(np.ceil(_GEN_SPINE_LEN_FRAC[0] * parallel_dim)), branch_count + 2)
