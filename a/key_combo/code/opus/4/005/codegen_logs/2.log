92:             for c in range(c0, c1):
93:                 union(r * w + c, rr * w + c + dc)
94: 
95:     colors_by_root: dict[int, set[int]] = {}
96:     for r in range(h):
97:         for c in range(w):
98:             color = int(g[r, c])
