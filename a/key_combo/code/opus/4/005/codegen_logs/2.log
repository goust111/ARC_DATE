68:     missing_color = Color.BLACK
69:     assert np.any(g == missing_color)
70: 
71:     h, w = g.shape
72:     shifts = _max_supported_translations(g, missing_color)
73: 
74:     parent = list(range(h * w))
75: 
76:     def find(x: int) -> int:
77:         while parent[x] != x:
78:             parent[x] = parent[parent[x]]
79:             x = parent[x]
80:         return x
81: 
82:     def union(a: int, b: int) -> None:
83:         ra = find(a)
84:         rb = find(b)
