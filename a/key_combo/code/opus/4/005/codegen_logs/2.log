8: def main(grid: np.ndarray) -> np.ndarray:
9:     """Repeat the bottom foreground motif upward until it fills the whole grid.
10: 
11:     Input structure
12:     - The background is the dominant color.
13:     - The only foreground pixels occupy a contiguous block of rows at the bottom.
14:     - That bottom block is the complete vertical motif, including its background cells.
15: 
16:     Rule
17:     - Copy the bottom motif rows repeatedly upward across the full grid.
18:     - Preserve horizontal alignment and vertical phase: the original first motif row remains at its input row.
19:     - The output shape is unchanged.
20: 
21:     Key insight
22:     The blank rows above the bottom foreground block are missing repetitions of the same row motif, not empty space.
23:     """
24:     g = np.asarray(grid, dtype=int)
25:     bg = int(get_bg(g))
26: 
27:     row_has_fg = np.any(g != bg, axis=1)
28:     assert np.any(row_has_fg), "expected a bottom foreground motif"
29:     top = int(np.flatnonzero(row_has_fg)[0])
30:     assert top > 0, "expected background rows above the motif"
31:     assert np.all(row_has_fg[top:]), "motif rows must be contiguous through the bottom"
32: 
33:     motif = g[top:].copy()
34:     motif_h = int(motif.shape[0])
35: 
36:     out = np.empty_like(g)
37:     for r in range(g.shape[0]):
38:         out[r] = motif[(int(r) - top) % motif_h]
39:     return out
