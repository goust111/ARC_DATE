+    out[r0 - step : r0, c0 : c1 + 1] = int(outer_color)
+    out[r1 + 1 : r1 + 1 + step, c0 : c1 + 1] = int(outer_color)
+    out[r0 : r1 + 1, c0 - step : c0] = int(outer_color)
+    out[r0 : r1 + 1, c1 + 1 : c1 + 1 + step] = int(outer_color)
