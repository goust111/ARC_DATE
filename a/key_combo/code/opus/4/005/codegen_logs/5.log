+    return _render_expected(input_grid, cell_rows, cell_cols, {}, vertical)
+
+
+def _validate_case(
+    input_grid: np.ndarray,
+    cell_rows: int,
+    cell_cols: int,
+    horizontal: dict[int, int],
+    vertical: dict[int, int],
+    marker_cells: list[tuple[int, list[tuple[int, int]]]],
+) -> bool:
