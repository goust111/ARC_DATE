# Canvas and object size bounds.
GRID_SIZE_MIN = 13
GRID_SIZE_MAX = 17
SPRITE_SIZE_MIN = 3
SPRITE_SIZE_MAX = 5

# Object count ranges.
CLOSED_COUNT_MIN = 2
CLOSED_COUNT_MAX = 3
OPEN_COUNT_MIN = 2
OPEN_COUNT_MAX = 4

# Palette constraints.
COLOR_MIN = 1
COLOR_MAX = 9
DISTINCT_COLOR_MIN = 3
DISTINCT_COLOR_MAX = 4
MAX_OBJECTS_PER_COLOR = 2

# Layout constraints.
MIN_ZONE_GAP = 3
LANE_GAP = 1
SCATTER_EDGE_MARGIN = 1
SCATTER_MIDDLE_FIRST_PROB = 0.8

