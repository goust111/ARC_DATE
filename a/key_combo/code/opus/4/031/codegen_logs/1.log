+def _semantic_checks(grid: np.ndarray) -> bool:
+    correct, meta = _solve(grid, return_meta=True)
+    frames = meta["frames"]
+    if len(frames) != 2:
+        return False
+    if not all(meta["frame_hits"]):
+        return False
+
+    if np.array_equal(correct, grid):
