+    out = g.copy()
+    cups = _detect_cups(g)
+
+    for cup in cups:
+        for r, c in cup["content_cells"]:
+            out[r, c] = Color.BLACK
+
+    for cup in cups:
+        trail = _simulate_trail(g, cup["spike"], cup["tail_dir"], len(cup["content_cells"]))
+        for r, c in trail:
+            out[r, c] = Color.RED
+
+    return out
