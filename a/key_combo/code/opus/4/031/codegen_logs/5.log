+BORDER_COLORS = (Color.BLUE, Color.GREEN, Color.ORANGE)
+DIR_NAMES = ("U", "R", "D", "L")
+DIR_TO_VEC = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+STATIC_BLOCKERS = {Color.GRAY, Color.BLUE, Color.GREEN, Color.ORANGE}
