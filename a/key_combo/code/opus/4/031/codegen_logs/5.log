+    for action in actions:
+        dr, dc = DIR_TO_VEC[facing]
+        front = (current[0] + dr, current[1] + dc)
+        if action == "F":
+            if not in_bounds(shape, front[0], front[1]) or front in used or front in obstacles:
+                return None
+            current = front
+            trail.append(current)
