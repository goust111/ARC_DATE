+        for r, c in spec["content_abs"]:
+            out[r, c] = Color.BLACK
+    for spec in specs:
+        for r, c in spec["trail"]:
+            out[r, c] = Color.RED
+    return out
+
+
+def _validate_generated_case(grid: np.ndarray, specs: list[dict]) -> None:
