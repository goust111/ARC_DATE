+GRID_HEIGHT_RANGE = (14, 20)
+GRID_WIDTH_RANGE = (14, 20)
+NUM_CUPS_CHOICES = (2, 3)
+CONTENT_COUNT_RANGE = (2, 4)
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 150
