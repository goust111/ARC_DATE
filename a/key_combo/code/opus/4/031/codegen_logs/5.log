+def _simulate_actions(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    direction: str,
+    actions: tuple[str, ...],
+    occupied: set[tuple[int, int]],
+    obstacle_forbidden: set[tuple[int, int]],
+) -> tuple[tuple[int, int], str, list[tuple[int, int]], set[tuple[int, int]]] | None:
+    current = (int(start[0]), int(start[1]))
+    facing = str(direction)
+    used = set(occupied)
