0063: def _can_place(out: np.ndarray, obj: _Object, row: int, bg: int) -> bool:
0064:     _r0, c0, _r1, _c1 = obj.bbox
0065:     h, w = obj.patch.shape
0066:     mask = obj.patch != bg
0067:     region = out[row : row + h, c0 : c0 + w]
0068:     return bool(np.all(region[mask] == bg))
0069: 
