0015: def main(input_grid):
0016:     """
0017:     Fill the cup interior with yellow and emit yellow rays from its opening.
0018: 
0019:     Input structure:
0020:     - The grid contains one non-black cup shape on black background.
0021:     - The cup encloses black interior cells and has an opening on one side.
0022:     - The cup may be rotated to face any direction.
0023: 
0024:     Rule:
0025:     - Find the cup bounding box and the black cells inside it.
0026:     - Fill those interior cells yellow.
0027:     - Draw yellow straight out through the opening and diagonally from the opening endpoints until blocked.
0028: 
0029:     Key insight:
0030:     - The opening position relative to the cup center determines the outward direction of the fill.
0031:     """
0032:     # Plan:
0033:     # 1. Detect the cup
0034:     # 2. Find the mask of the inside of the cup
0035:     # 3. Find the mask of the opening of the cup (on one of its sides)
0036:     # 4. Fill the cup with yellow
0037:     # 5. Shoot pixels outward from the opening (straight out)
0038:     # 6. Shoot pixels outward from the opening (diagonally out, from the edges)
0039:     
0040:     # 1. Detect cup
0041:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0042:     assert len(objects) == 1, "There should be exactly one cup"
0043:     obj = list(objects)[0]
0044: 
0045:     output_grid = input_grid.copy()
0046: 
0047:     # 2. Extract what's inside the cup (as its own object), which is everything in the bounding box that is not the object itself
0048:     _b = bbox(obj != Color.BLACK)
0049:     assert _b is not None
0050:     cup_r, cup_c, _r1, _c1 = _b
0051:     cup_width = _r1 - cup_r + 1
0052:     cup_height = _c1 - cup_c + 1
0053:     inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
0054:     inside_cup_mask[cup_r:cup_r+cup_width, cup_c:cup_c+cup_height] = True
0055:     inside_cup_mask = inside_cup_mask & (obj == Color.BLACK)
0056: 
0057:     # 3. Extract the hole in the cup, which is what's inside and on the boundary of the bounding box
0058:     # what's inside...
0059:     hole_mask = inside_cup_mask.copy()
0060:     # ...and then we need to remove anything not on the boundary
0061:     hole_mask[cup_r+1 : cup_r+cup_width-1, cup_c+1 : cup_c+cup_height-1] = False
0062: 
0063:     # 4. Fill the cup with yellow
0064:     output_grid[inside_cup_mask] = Color.YELLOW
0065: 
0066:     # 5. Shoot pixels outward from the opening (straight out)
0067:     # Find the direction of the opening, which is the unit vector that points from the center of the cup to the hole
0068:     _b = bbox(hole_mask != Color.BLACK)
0069:     assert _b is not None
0070:     hole_r, hole_c = bbox_anchor(_b, anchor='center')
0071:     _b = bbox(obj != Color.BLACK)
0072:     assert _b is not None
0073:     cup_r, cup_c = bbox_anchor(_b, anchor='center')
0074:     direction = (int(np.sign(hole_r - cup_r)), int(np.sign(hole_c - cup_c)))
0075:     # Loop over every boundary pixel and shoot outward
0076:     for r, c in np.argwhere(hole_mask):
0077:         draw_line(output_grid, r, c, direction=direction, color=Color.YELLOW)
0078: 
0079:     # 6. Shoot pixels outward from the opening (diagonally out, from the edges)
0080:     # Find the two extremal points on the boundary of the hole, which are the points farthest away from each other
0081:     points_on_boundary = np.argwhere(hole_mask)
0082:     pt1, pt2 = max({ ( (x1,y1), (x2,y2) ) for x1,y1 in points_on_boundary for x2,y2 in points_on_boundary },
0083:                    key=lambda pair: np.linalg.norm(np.array(pair[0]) - np.array(pair[1])))
0084:     
0085:     # For each of those points, shoot diagonal lines in all directions, but stop as soon as you hit something that's not black
0086:     for pt in [pt1, pt2]:
0087:         for direction in [(-1, -1), (-1, 1), (1, -1), (1, 1)]:
0088:             draw_line(output_grid, pt[0]+direction[0], pt[1]+direction[1], direction=direction, color=Color.YELLOW, stop_at=Color.NOT_BLACK)
0089:     
0090:     return output_grid
0091: 
0092: def generate_input():
