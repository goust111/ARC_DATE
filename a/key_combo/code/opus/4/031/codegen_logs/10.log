import random
import numpy as np
from collections import deque

def tile(g):
    return np.block([[g, np.fliplr(g)], [np.flipud(g), np.flipud(np.fliplr(g))]])

def comps(mask):
    H,W = mask.shape
    seen = np.zeros_like(mask, dtype=bool)
    out=[]
    for r in range(H):
      for c in range(W):
        if mask[r,c] and not seen[r,c]:
          q=[(r,c)]; seen[r,c]=1; cur=[]
          while q:
            x,y=q.pop(); cur.append((x,y))
            for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
              nx,ny=x+dx,y+dy
              if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                seen[nx,ny]=1; q.append((nx,ny))
          out.append(cur)
    return out

def holes(g):
    H,W = g.shape
    out=[]
    for comp in comps(g==0):
      touch=any(r in (0,H-1) or c in (0,W-1) for r,c in comp)
      if not touch:
        out.append(comp)
    return out

def ok(inp):
    if holes(inp): return False
    out=tile(inp)
    hs=holes(out)
    if len(hs)<2: return False
    areas=sorted(len(h) for h in hs)
    return any(a%2==0 for a in areas) and any(a%2==1 for a in areas)

for H,W in [(5,5),(5,6),(6,6),(6,7),(7,7)]:
  for trial in range(200000):
    g=np.zeros((H,W),dtype=int)
    # random sparse strokes touching right/bottom edges more often
    n=random.randint((H*W)//4,(H*W)//2)
    cells=random.sample([(r,c) for r in range(H) for c in range(W)], n)
    for r,c in cells:
      g[r,c]=random.randint(1,3)
    # bias edge touches
    for r in range(H):
      if random.random()<0.4: g[r,W-1]=random.randint(1,3)
    for c in range(W):
      if random.random()<0.4: g[H-1,c]=random.randint(1,3)
    if ok(g):
      print('FOUND', (H,W), 'trial', trial)
      print(g)
      print('areas', [len(h) for h in holes(tile(g))])
      raise SystemExit
print('none found')
