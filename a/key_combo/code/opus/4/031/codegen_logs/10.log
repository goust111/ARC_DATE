0091: def main(grid: np.ndarray) -> np.ndarray:
0092:     """
0093:     Slide closed foreground objects upward and open foreground objects downward, keeping their columns and stacking on collision.
0094: 
0095:     Input structure
0096:     - The grid has a single background color and several monochromatic 4-connected foreground objects.
0097:     - Some objects are closed frames with at least one enclosed background hole inside their bounding box.
0098:     - The remaining objects are open line-like sprites with no enclosed hole.
0099: 
0100:     Rule
0101:     - Redraw every object on an empty background canvas without changing its color, shape, or horizontal position.
0102:     - Closed frame objects slide vertically upward to the first non-colliding position.
0103:     - Open objects slide vertically downward to the first non-colliding position.
0104:     - Within each direction, preserve the original vertical order so overlapping columns stack instead of crossing.
0105: 
0106:     Key insight
0107:     - The only role distinction is whether an object encloses a hole: hole objects pack against the top edge, while non-hole objects pack against the bottom edge.
0108:     """
0109:     g = np.asarray(grid, dtype=int)
0110:     bg = get_bg(g)
0111:     out = np.full_like(g, bg)
0112:     objects = _objects(g, bg)
0113: 
0114:     closed = [obj for obj in objects if obj.closed]
0115:     open_objects = [obj for obj in objects if not obj.closed]
0116:     assert closed, "expected at least one closed object"
0117:     assert open_objects, "expected at least one open object"
0118: 
0119:     for obj in sorted(closed, key=lambda o: (o.bbox[0], o.bbox[1], o.bbox[2], o.bbox[3])):
0120:         _slide_into_place(out, obj, bg, upward=True)
0121: 
0122:     for obj in sorted(open_objects, key=lambda o: (-o.bbox[2], o.bbox[1], -o.bbox[0], o.bbox[3])):
0123:         _slide_into_place(out, obj, bg, upward=False)
0124: 
0125:     return out
0126: 
