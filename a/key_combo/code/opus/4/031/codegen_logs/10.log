0076: def _slide_into_place(out: np.ndarray, obj: _Object, bg: int, upward: bool) -> None:
0077:     H = out.shape[0]
0078:     if upward:
0079:         rows = range(0, H - obj.height + 1)
0080:     else:
0081:         rows = range(H - obj.height, -1, -1)
0082: 
0083:     for row in rows:
0084:         if _can_place(out, obj, row, bg):
