0017: def _object_mask(coords: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
0018:     r0, c0, r1, c1 = bbox
0019:     mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
0020:     rel = coords - np.array([r0, c0])
0021:     mask[rel[:, 0], rel[:, 1]] = True
0022:     return mask
0023: 
0024: 
0025: def _has_enclosed_hole(mask: np.ndarray) -> bool:
0026:     h, w = mask.shape
0027:     exterior = np.zeros_like(mask, dtype=bool)
0028:     stack: list[tuple[int, int]] = []
0029: 
0030:     for r in range(h):
0031:         for c in range(w):
0032:             if (r in (0, h - 1) or c in (0, w - 1)) and not mask[r, c]:
0033:                 exterior[r, c] = True
0034:                 stack.append((r, c))
0035: 
0036:     while stack:
0037:         r, c = stack.pop()
0038:         for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
0039:             nr = r + dr
0040:             nc = c + dc
0041:             if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not exterior[nr, nc]:
0042:                 exterior[nr, nc] = True
0043:                 stack.append((nr, nc))
0044: 
0045:     return bool(np.any((~mask) & (~exterior)))
0046: 
