0048: def _objects(g: np.ndarray, bg: int) -> list[_Object]:
0049:     objects: list[_Object] = []
0050:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):
0051:         color = int(comp["color"])
0052:         bbox = tuple(map(int, comp["bbox"]))
0053:         coords = comp["coords"]
0054:         mask = _object_mask(coords, bbox)
0055:         patch = np.full(mask.shape, bg, dtype=int)
0056:         patch[mask] = color
0057:         objects.append(_Object(bbox, patch, _has_enclosed_hole(mask)))
0058: 
0059:     assert objects, "expected at least one foreground object"
0060:     return objects
0061: 
