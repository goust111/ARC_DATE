+        h2 = random.choice(FRAME_HEIGHT_CHOICES)
+        gap = random.randint(1, 2)
+        total = h1 + h2 + gap
+        if total > height:
+            continue
+
+        top = random.randint(0, height - total)
+        r0_a, r1_a = top, top + h1 - 1
+        r0_b, r1_b = r1_a + gap + 1, r1_a + gap + h2
+
