0015: def main(input_grid):
0016:     """
0017:     Mirror the inner pattern pieces outward across the two red frame halves.
0018: 
0019:     Input structure:
0020:     - The grid contains two red frame halves enclosing gray pattern pieces.
0021:     - The frame pair may be horizontal or vertical after rotation.
0022:     - The inner pattern lies between the red frame halves.
0023: 
0024:     Rule:
0025:     - Detect the red frame components and paste them into a blank output.
0026:     - Crop the full inner pattern and split it into two halves along the frame axis.
0027:     - Mirror each half across its corresponding frame line and paste it outside the frame.
0028: 
0029:     Key insight:
0030:     - The red frame halves are symmetry axes; the enclosed gray pattern is split and
0031:       reflected outward rather than copied in place.
0032:     """
0033:     # Extract the framework
0034:     frame_color = Color.RED
0035: 
0036:     # Create an empty grid
0037:     n, m = input_grid.shape
0038:     output_grid = np.zeros((n, m), dtype=int)
0039: 
0040:     # Get two frame that form the framework
0041:     frames = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0042:     frames = [frame for frame in frames if np.any(frame == frame_color)]
0043:     framework = []
0044:     for frame in frames:
0045:         # Get the frame and its position
0046:         _b = bbox(frame != Color.BLACK)
0047:         assert _b is not None
0048:         r, c, _r1, _c1 = _b
0049:         w = _r1 - r + 1
0050:         h = _c1 - c + 1
0051:         _b = bbox(frame != Color.BLACK)
0052:         assert _b is not None
0053:         cropped_frame = crop_bbox(frame, _b)
0054:         framework.append({"x": r, "y": c, "w": w, "h": h, "frame": cropped_frame})
0055:         # Place the frame in the output grid
0056:         output_grid = paste(output_grid, cropped_frame, r, c, transparent=Color.BLACK, clip=True)
0057: 
0058:     # Sort the framework by position
0059:     framework = sorted(framework, key=lambda r: r["x"])
0060:     framework = sorted(framework, key=lambda r: r["y"])
0061: 
0062:     # Get the inner pattern
0063:     _b = bbox(input_grid != Color.BLACK)
0064:     assert _b is not None
0065:     r_whole, c_whole, _r1, _c1 = _b
0066:     w_whole = _r1 - r_whole + 1
0067:     h_whole = _c1 - c_whole + 1
0068:     inner_pattern = input_grid[r_whole + 1 : r_whole + w_whole - 1, c_whole + 1 : c_whole + h_whole - 1]
0069: 
0070:     # Check if the framework is horizontal or vertical
0071:     if_horizontal = framework[0]["w"] > framework[0]["h"]
0072: 
0073:     if if_horizontal:
