    sprite = np.full((cup_width, cup_height), Color.BLACK)
    color = np.random.choice([ color for color in Color.NOT_BLACK if color != Color.YELLOW ])
    sprite[0, :] = color
    sprite[-1, :] = color
    sprite[:, 0] = color
    sprite[:, -1] = color

