+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "inner_bbox": (int(r0 + 1), int(c0 + 1), int(r1 - 1), int(c1 - 1)),
+                "marker": (int(r0 + 1 + marker_r), int(c0 + 1 + marker_c)),
+                "inner_shape": (int(interior.shape[0]), int(interior.shape[1])),
