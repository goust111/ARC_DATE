+
+FRAME_COLOR = Color.GREY
+MULTI_FILL = Color.PINK
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.ORANGE]
+MAX_GEN_ATTEMPTS = 400
