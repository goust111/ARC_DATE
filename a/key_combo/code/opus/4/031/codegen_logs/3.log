+            grid, frames, targets = _build_frames()
+        except ValueError:
+            continue
+
+        colors = random.sample(PALETTE, 4)
+        multi_idx = targets.index(3)
+        single_idx = targets.index(1)
+
+        if random.random() < 0.5:
+            multi_dirs = ["up", "up", "down"]
