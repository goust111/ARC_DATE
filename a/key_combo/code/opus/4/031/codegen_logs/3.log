+        ar = int(top + rr)
+        ac = int(left + cc)
+        if occupied[ar, ac]:
+            return False
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = ar + dr
+                nc = ac + dc
