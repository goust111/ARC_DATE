+    grid[frame.r1, frame.c0 : frame.c1 + 1] = FRAME_COLOR
+    grid[frame.r0 : frame.r1 + 1, frame.c0] = FRAME_COLOR
+    grid[frame.r0 : frame.r1 + 1, frame.c1] = FRAME_COLOR
