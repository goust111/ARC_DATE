+            return False
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = ar + dr
+                nc = ac + dc
+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and occupied[nr, nc]:
