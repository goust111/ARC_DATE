+def _has_enclosed_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    exterior = np.zeros_like(mask, dtype=bool)
+    stack: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if (r in (0, h - 1) or c in (0, w - 1)) and not mask[r, c]:
+                exterior[r, c] = True
+                stack.append((r, c))
