+        random.shuffle(plan)
+
+        per_frame: dict[int, list[tuple[str, np.ndarray]]] = {idx: [] for idx in range(len(frames))}
+        for frame_idx, direction, color in plan:
+            patch = _patch_closed(color) if direction == "up" else _patch_open(color)
