+
+def _safe_place(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    h, w = patch.shape
+    if top < 0 or left < 0 or top + h > grid.shape[0] or left + w > grid.shape[1]:
+        return False
+    mask = patch != Color.BLACK
+    occupied = grid != Color.BLACK
