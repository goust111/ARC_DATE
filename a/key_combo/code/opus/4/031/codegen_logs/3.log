+                    downs = [(direction, patch) for direction, patch in items if direction == "down"]
+
+                    up_rows = _rows_below(frame, len(ups), 3)
+                    down_rows = _rows_above(frame, len(downs), 3)
+
+                    if len(items) == 3:
