+        plan = [
+            (multi_idx, multi_dirs[0], colors[0]),
+            (multi_idx, multi_dirs[1], colors[1]),
+            (multi_idx, multi_dirs[2], colors[2]),
+            (single_idx, single_dir, colors[3]),
