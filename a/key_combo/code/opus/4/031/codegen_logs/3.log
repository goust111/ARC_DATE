+
+def _rows_above(frame: Frame, count: int, height: int) -> list[int]:
+    rows: list[int] = []
+    bottom = frame.r0 - 2
+    for _ in range(count):
+        top = bottom - height + 1
+        rows.append(top)
+        bottom = top - 2
+    return rows
+
+
+def _rows_below(frame: Frame, count: int, height: int) -> list[int]:
+    rows: list[int] = []
+    top = frame.r1 + 2
+    for _ in range(count):
+        rows.append(top)
+        top += height + 1
+    return rows
