+def _place_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    if not _safe_place(grid, patch, top, left):
+        raise ValueError("invalid placement")
+    paste(grid, patch, top, left, transparent=Color.BLACK)
