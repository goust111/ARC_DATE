+def _shape_from_bbox(height: int, width: int, rng: random.Random, corner: str | None = None) -> set[tuple[int, int]]:
+    if height == 1:
+        return {(0, c) for c in range(width)}
+    if width == 1:
+        return {(r, 0) for r in range(height)}
