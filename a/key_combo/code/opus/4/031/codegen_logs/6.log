+            if extra_box is not None:
+                boxes.append(extra_box)
+
+        rng.shuffle(boxes)
+        colors = list(COLOR_POOL)
+        rng.shuffle(colors)
+
+        for box, color in zip(boxes, colors):
+            h = box[2] - box[0] + 1
+            w = box[3] - box[1] + 1
+            _paint_shape(grid, box, color, _shape_from_bbox(h, w, rng))
+
+        if _validate_instance(grid):
