+        patch = component_patch(comp, bg, g.shape)
+        scaled = scale_sprite(crop_bbox(patch, (0, 0, patch.shape[0] - 1, patch.shape[1] - 1)), int(scales[idx]))
+        rr1 = min(out.shape[0], r0 + scaled.shape[0])
+        cc1 = min(out.shape[1], c0 + scaled.shape[1])
+        if rr1 <= r0 or cc1 <= c0:
