+    middle_w = inner_w + 2
+    outer_h = middle_h + 2
+    outer_w = middle_w + 2
+    return [(outer_h, outer_w), (middle_h, middle_w), (inner_h, inner_w)]
+
+
+def _place_nested_bbox(
+    outer: tuple[int, int, int, int],
+    inner_size: tuple[int, int],
