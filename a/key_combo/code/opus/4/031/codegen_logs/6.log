+    for box_h, box_w in sizes:
+        rows = list(range(0, h - box_h + 1))
+        cols = list(range(0, w - box_w + 1))
+        rng.shuffle(rows)
+        rng.shuffle(cols)
+        for r0 in rows:
+            for c0 in cols:
+                cand = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+                if all(bboxes_disjoint(cand, other) for other in existing_boxes):
+                    return cand
+    return None
