+        rr1 = min(out.shape[0], r0 + scaled.shape[0])
+        cc1 = min(out.shape[1], c0 + scaled.shape[1])
+        if rr1 <= r0 or cc1 <= c0:
+            continue
+        view = scaled[: rr1 - r0, : cc1 - c0]
+        mask = view != bg
+        out[r0:rr1, c0:cc1][mask] = view[mask]
