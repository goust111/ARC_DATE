+
+
+def _place_nested_bbox(
+    outer: tuple[int, int, int, int],
+    inner_size: tuple[int, int],
+    rng: random.Random,
+) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = outer
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    inner_h, inner_w = inner_size
+    top_margin = rng.randint(1, h - inner_h - 1)
+    left_margin = rng.randint(1, w - inner_w - 1)
+    max_top = h - inner_h - 1
+    max_left = w - inner_w - 1
+    top_margin = min(top_margin, max_top)
+    left_margin = min(left_margin, max_left)
+    inner_r0 = r0 + top_margin
+    inner_c0 = c0 + left_margin
+    return (inner_r0, inner_c0, inner_r0 + inner_h - 1, inner_c0 + inner_w - 1)
+
+
+def _search_disjoint_bbox(
+    canvas_shape: tuple[int, int],
+    existing_boxes: list[tuple[int, int, int, int]],
