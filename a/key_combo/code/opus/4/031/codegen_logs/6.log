+
+        rng.shuffle(boxes)
+        colors = list(COLOR_POOL)
+        rng.shuffle(colors)
+
+        for box, color in zip(boxes, colors):
+            h = box[2] - box[0] + 1
+            w = box[3] - box[1] + 1
