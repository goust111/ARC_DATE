64:     assert _b is not None
65:     r_whole, c_whole, _r1, _c1 = _b
66:     w_whole = _r1 - r_whole + 1
67:     h_whole = _c1 - c_whole + 1
68:     inner_pattern = input_grid[r_whole + 1 : r_whole + w_whole - 1, c_whole + 1 : c_whole + h_whole - 1]
69: 
70:     # Check if the framework is horizontal or vertical
