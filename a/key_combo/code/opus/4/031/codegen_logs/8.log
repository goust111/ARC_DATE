178: def _gen_color_labels(n: int) -> list[int]:
179:     min_k = max(DISTINCT_COLOR_MIN, (n + 1) // MAX_OBJECTS_PER_COLOR)
180:     k = random.randint(min_k, min(DISTINCT_COLOR_MAX, n))
181:     colors = random.sample(range(COLOR_MIN, COLOR_MAX + 1), k)
182:     counts = [1] * k
183:     for _ in range(n - k):
184:         choices = [i for i, count in enumerate(counts) if count < MAX_OBJECTS_PER_COLOR]
185:         counts[random.choice(choices)] += 1
186: 
187:     labels: list[int] = []
188:     for color, count in zip(colors, counts):
189:         labels.extend([color] * count)
190:     random.shuffle(labels)
191:     return labels
192: 
