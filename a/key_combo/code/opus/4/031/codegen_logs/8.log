+        rr = top + int(r)
+        cc = left + int(c)
+        if occupied[rr, cc]:
+            return False
+        for nr, nc in neighbors4(rr, cc):
+            if in_bounds(occupied.shape, nr, nc) and occupied[nr, nc]:
+                return False
