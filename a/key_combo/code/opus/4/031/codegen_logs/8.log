113: def _gen_monotone_path(start, end):
114:     r, c = start
115:     er, ec = end
116:     moves = []
117:     moves.extend([(1 if er > r else -1, 0)] * abs(er - r))
118:     moves.extend([(0, 1 if ec > c else -1)] * abs(ec - c))
119:     random.shuffle(moves)
120: 
121:     path = [(r, c)]
122:     for dr, dc in moves:
123:         r += dr
124:         c += dc
125:         path.append((r, c))
126:     return path
