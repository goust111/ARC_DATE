70:             corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
71: 
72:             # Candidate tail spikes: single border cell on a bbox edge, not at a corner.
73:             edges = (
74:                 ("U", [p for p in border_set if p[0] == r0]),
75:                 ("D", [p for p in border_set if p[0] == r1]),
76:                 ("L", [p for p in border_set if p[1] == c0]),
77:                 ("R", [p for p in border_set if p[1] == c1]),
78:             )
79:             candidates = [
80:                 (d, cells[0]) for d, cells in edges
81:                 if len(cells) == 1 and cells[0] not in corners
82:             ]
83:             if not candidates:
84:                 continue
85: 
86:             # Each candidate: flood from opposite bbox side; keep candidates whose flood
87:             # reaches content (non-bg, non-border) cells.
88:             passing = []
89:             for d, spike in candidates:
90:                 mouth = _flood_from_bbox_side(border_set, bbox, OPPOSITE[d])
91:                 cnt = Counter()
