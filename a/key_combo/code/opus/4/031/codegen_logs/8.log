+            l2 = _transform(left, rot, flip_lr)
+            r2 = _transform(right, rot, flip_lr)
+            key = l2.tobytes() + b"|" + r2.tobytes() + bytes(l2.shape) + bytes(r2.shape)
+            if key not in seen:
+                seen.add(key)
