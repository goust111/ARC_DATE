73: def main(grid: np.ndarray) -> np.ndarray:
74:     """
75:     Complete partial paths inside a framed rectangle by projecting external color traces inward.
76: 
77:     Input structure:
78:     - bg, a 1px rectangular frame (border color) with uniform interior fill.
79:     - Colored components outside the frame touching its edges.
80: 
81:     Rule:
82:     - Output = the frame's interior, filled with the fill color.
83:     - Map each outside component's frame-touch points into interior coordinates.
84:     - Monochrome components become solid Manhattan stripes between mapped endpoints.
85:     - Two-color components become alternating-color Manhattan paths.
86: 
87:     Key insight: Endpoint colors of two-color traces anchor the alternating phase deterministically.
88:     """
89:     g = np.array(grid, dtype=int)
90:     H, W = g.shape
91:     bg = int(get_bg(g))
92: 
93:     found = _find_framed_rect_uniform_fill(g, bg=int(bg))
94:     assert not (found is None)
95:     r0, c0, r1, c1, bc, fill = found
96:     outH = int(r1 - r0 - 1)
97:     outW = int(c1 - c0 - 1)
98:     out = np.full((outH, outW), int(fill), dtype=int)
99:     r_int0 = int(r0 + 1)
100:     c_int0 = int(c0 + 1)
101: 
102:     def map_to_out(rr: int, cc: int) -> tuple[int, int]:
103:         r = max(0, min(outH - 1, int(rr - r_int0)))
104:         c = max(0, min(outW - 1, int(cc - c_int0)))
105:         return int(r), int(c)
106: 
107:     def build_manhattan(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> list[tuple[int, int]]:
108:         (ra, ca), (rb, cb) = p1, p2
109:         if ra == rb:
110:             step = 1 if cb >= ca else -1
111:             return [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]
112:         if ca == cb:
113:             step = 1 if rb >= ra else -1
114:             return [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]
115:         if cornerA:
116:             step = 1 if rb >= ra else -1
117:             path = [(int(r), int(ca)) for r in range(int(ra), int(rb) + step, step)]
118:             step = 1 if cb >= ca else -1
119:             path += [(int(rb), int(c)) for c in range(int(ca) + step, int(cb) + step, step)]
120:             return path
121:         step = 1 if cb >= ca else -1
122:         path = [(int(ra), int(c)) for c in range(int(ca), int(cb) + step, step)]
123:         step = 1 if rb >= ra else -1
124:         path += [(int(r), int(cb)) for r in range(int(ra) + step, int(rb) + step, step)]
125:         return path
126: 
127:     def inside_corner(p1: tuple[int, int], p2: tuple[int, int], cornerA: bool) -> bool:
128:         (ra, ca), (rb, cb) = p1, p2
129:         if ra == rb or ca == cb:
130:             return True
131:         corner = (rb, ca) if cornerA else (ra, cb)
132:         rr, cc = corner
133:         return (0 < rr < outH - 1) and (0 < cc < outW - 1)
134: 
135:     # --- ring components (outside the frame) ---
136:     comp_mask = (g != int(bg)) & (g != int(fill)) & (g != int(bc))
137:     clab, cn = label(comp_mask, structure=STRUCT4)
138: 
139:     ring = set()
140:     for cc in range(c0, c1 + 1):
141:         for rr in (r0 - 1, r1 + 1):
142:             if 0 <= rr < H:
143:                 ring.add((int(rr), int(cc)))
144:     for rr in range(r0, r1 + 1):
145:         for cc in (c0 - 1, c1 + 1):
146:             if 0 <= cc < W:
147:                 ring.add((int(rr), int(cc)))
148: 
149:     # cid -> list of (mapped_r, mapped_c, color)
150:     comp_pts: dict[int, list[tuple[int, int, int]]] = defaultdict(list)
151:     for rr, cc in ring:
152:         cid = int(clab[rr, cc])
153:         if cid == 0:
154:             continue
155:         col = int(g[rr, cc])
156:         mr, mc = map_to_out(rr, cc)
157:         comp_pts[cid].append((mr, mc, col))
158: 
159:     # per-component color sets
160:     comp_cols: dict[int, list[int]] = {}
161:     for cid in range(1, int(cn) + 1):
162:         comp_cols[cid] = sorted(set(map(int, g[clab == int(cid)].flatten())))
163: 
164:     deferred: dict[int, set[tuple[int, int]]] = defaultdict(set)
165: 
166:     for cid, pts in comp_pts.items():
167:         if len(pts) < 2:
168:             continue
169:         cols = comp_cols.get(cid, [])
170:         if not cols:
171:             continue
172: 
173:         # build per-coordinate color histogram (clamp can merge multiple ring pixels)
174:         hist: dict[tuple[int, int], Counter] = defaultdict(Counter)
175:         for r, c, col in pts:
176:             hist[(int(r), int(c))][int(col)] += 1
177: 
178:         coords = list(hist.keys())
179: 
180:         if len(cols) == 1:
181:             colv = int(cols[0])
182:             uniq = coords
183:             rows = {r for r, _c in uniq}
184:             cols2 = {c for _r, c in uniq}
185:             if len(rows) == 1 or len(cols2) == 1:
