+            union = left_mask | right_mask
+            h, w = union.shape
+            anchors = [(r, c) for r in range(PANEL_SIZE - h + 1) for c in range(PANEL_SIZE - w + 1)]
+            random.shuffle(anchors)
+            for top, left in anchors:
+                if not _can_place(occupied, union, top, left):
+                    continue
