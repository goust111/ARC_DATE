+    labels = np.zeros((h, w), dtype=int)
+    infos: list[dict] = []
+    label_id = 0
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or labels[r, c] != 0:
+                continue
+            label_id += 1
+            q = deque([(r, c)])
+            labels[r, c] = label_id
+            coords = []
+            touches_edge = False
+            while q:
