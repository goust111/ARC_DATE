+        comp_mask = np.zeros((PANEL_SIZE, PANEL_SIZE), dtype=bool)
+        comp_mask[coords[:, 0], coords[:, 1]] = True
+        if (comp_mask & left_mask).any() and (comp_mask & right_mask).any() and _has_cross_panel_contact(comp_mask, left_mask, right_mask):
