+        return False
+
+    left_sizes = _component_sizes(left, LEFT_COLOR)
+    right_sizes = _component_sizes(right, RIGHT_COLOR)
+    if not (2 <= len(left_sizes) <= 3 and 2 <= len(right_sizes) <= 3):
