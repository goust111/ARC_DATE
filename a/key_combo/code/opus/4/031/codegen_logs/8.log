15: def main(input_grid):
16:     """
17:     Mirror the inner pattern pieces outward across the two red frame halves.
18: 
19:     Input structure:
20:     - The grid contains two red frame halves enclosing gray pattern pieces.
21:     - The frame pair may be horizontal or vertical after rotation.
22:     - The inner pattern lies between the red frame halves.
23: 
24:     Rule:
25:     - Detect the red frame components and paste them into a blank output.
26:     - Crop the full inner pattern and split it into two halves along the frame axis.
27:     - Mirror each half across its corresponding frame line and paste it outside the frame.
28: 
29:     Key insight:
30:     - The red frame halves are symmetry axes; the enclosed gray pattern is split and
31:       reflected outward rather than copied in place.
32:     """
33:     # Extract the framework
34:     frame_color = Color.RED
35: 
36:     # Create an empty grid
37:     n, m = input_grid.shape
38:     output_grid = np.zeros((n, m), dtype=int)
39: 
40:     # Get two frame that form the framework
