+_MAX_GEN_ATTEMPTS = 500
+
+_CUP_TEMPLATES = (
+    {
+        "name": "u",
+        "shape": np.array([[5, 5, 5], [5, 0, 5]], dtype=int),
+        "cavity": ((1, 1),),
+        "opening": (1, 1),
+    },
