+
+def _sample_nontrivial_heights(n: int) -> list[int]:
+    sampled = sorted(random.sample(_HEIGHT_POOL, n))
+    while True:
+        perm = random.sample(sampled, n)
+        if perm != sorted(perm) and perm != sorted(perm, reverse=True):
+            return perm
