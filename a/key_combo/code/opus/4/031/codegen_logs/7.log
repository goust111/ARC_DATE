+        "shape": np.array([[5, 5, 5], [5, 0, 5]], dtype=int),
+        "cavity": ((1, 1),),
+        "opening": (1, 1),
+    },
+    {
+        "name": "c_left",
+        "shape": np.array([[5, 5], [5, 0], [5, 0]], dtype=int),
+        "cavity": ((1, 1), (2, 1)),
+        "opening": (2, 1),
+    },
+    {
+        "name": "c_right",
+        "shape": np.array([[5, 5], [0, 5], [0, 5]], dtype=int),
+        "cavity": ((1, 0), (2, 0)),
+        "opening": (2, 0),
+    },
+)
