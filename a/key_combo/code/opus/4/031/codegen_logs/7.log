+def _sample_spaced_columns(candidates: list[int], count: int, min_gap: int) -> list[int] | None:
+    if len(candidates) < count:
+        return None
+    for _ in range(200):
+        cols = sorted(random.sample(candidates, count))
+        if all(b - a >= min_gap for a, b in zip(cols, cols[1:])):
