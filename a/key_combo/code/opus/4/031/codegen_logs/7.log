+    ranked_bars = sorted(bars, key=lambda item: (item["height"], item["col"]))
+    ranked_cups = sorted(cups, key=lambda item: (item["center2"], item["bbox"][1], item["bbox"][0]))
+    return bars, cups, list(zip(ranked_bars, ranked_cups))
+
