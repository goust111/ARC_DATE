+            if rr >= out.shape[0]:
+                break
+            if step > 0 and int(out[rr, start_c]) != Color.BLACK:
+                break
+            out[rr, start_c] = int(bar["color"])
+            actual_len = step + 1
+        ray_lengths.append(actual_len)
+
+    for bar in scene["bars"]:
+        for r, c in bar["coords"]:
+            out[r, c] = Color.BLACK
