+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GEN_ATTEMPTS):
+        built = _build_scene()
+        if built is None:
+            continue
+        grid, scene = built
+        if _validate_scene(grid, scene):
+            return grid
+    raise RuntimeError("failed to generate a valid input grid")

