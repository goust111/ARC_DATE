0043:     assert all(len(colors) == 1 for colors in panel_colors), "each panel must have exactly one foreground color"
0044:     assert len({colors[0] for colors in panel_colors}) == 4, "panel foreground colors must be distinct"
0045: 
0046:     out = np.full((panel_h, panel_w), bg, dtype=int)
0047:     for panel in (upper_left, lower_right, lower_left, upper_right):
