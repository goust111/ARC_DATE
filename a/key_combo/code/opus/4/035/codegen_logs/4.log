0053:     lower = fg & (row_ids >= split_row)
0054:     assert np.any(upper), "expected a nonempty upper half"
0055:     assert np.any(lower), "expected a nonempty lower half"
0056:     assert int(upper.sum()) == int(lower.sum()), "expected equal upper and lower areas"
