+        if not (PANEL_AREA_RANGE[0] <= int(mask.sum()) <= PANEL_AREA_RANGE[1]):
+            return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    panel_h = random.randint(*PANEL_SIDE_RANGE)
+    panel_w = random.randint(*PANEL_SIDE_RANGE)
+    panel_shape = (panel_h, panel_w)
+
