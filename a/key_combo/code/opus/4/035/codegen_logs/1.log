    objs: list[np.ndarray] = []
    for k in range(1, int(n) + 1):
        m = (lab == k)
        if int(m.sum()) < int(min_area):
            continue
        obj = np.full_like(grid, bg)
        obj[m] = grid[m]
        objs.append(obj)
    return objs


