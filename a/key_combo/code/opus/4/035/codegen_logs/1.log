+        for wall_c in range(c0 + MIN_ROOM_W, c1 - MIN_ROOM_W + 1):
+            options.append(("v", wall_c))
+    if height >= 2 * MIN_ROOM_H + 1:
+        for wall_r in range(r0 + MIN_ROOM_H, r1 - MIN_ROOM_H + 1):
+            options.append(("h", wall_r))
+    return options
+
