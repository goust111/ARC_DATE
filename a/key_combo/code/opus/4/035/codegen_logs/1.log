+def _partition_rooms(rng):
+    h = rng.randint(*GRID_H_RANGE)
+    w = rng.randint(*GRID_W_RANGE)
+    grid = np.zeros((h, w), dtype=int)
+    grid[0, :] = WALL
+    grid[-1, :] = WALL
