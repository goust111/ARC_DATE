+        candidates = [(idx, opts) for idx, opts in candidates if opts]
+        if not candidates:
+            return None, None
+        idx, options = rng.choice(candidates)
+        orientation, wall_pos = rng.choice(options)
+        r0, c0, r1, c1 = rooms.pop(idx)
+        if orientation == "v":
