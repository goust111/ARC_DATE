+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+DIR_BY_MARKER = {
+    RED: (1, 0),
+    GREEN: (-1, 0),
+    YELLOW: (0, -1),
+    ORANGE: (0, 1),
+}
+
+MARKER_COLORS = tuple(DIR_BY_MARKER)
+FREE_COLORS = (BLACK, BLUE)
+
+GRID_MIN = 18
+GRID_MAX = 24
+MIN_REGION_SPAN = 5
+GEN_RETRY_LIMIT = 500
