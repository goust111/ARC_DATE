+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def component_masks(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            comp = np.zeros((h, w), dtype=bool)
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            comp[r, c] = True
+            while queue:
+                rr, cc = queue.popleft()
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        comp[nr, nc] = True
+                        queue.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def is_connected(mask: np.ndarray) -> bool:
+    total = int(mask.sum())
+    if total == 0:
+        return False
+    return len(component_masks(mask)) == 1
+
+
+def free_region_masks(grid: np.ndarray) -> list[np.ndarray]:
+    return component_masks(np.isin(grid, FREE_COLORS))
+
