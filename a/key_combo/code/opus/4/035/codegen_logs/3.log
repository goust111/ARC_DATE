    bit_i = 0
    for _ in _GEN_EDGE_FREE_ROWS:
        for c in _GEN_EDGE_FREE_COLS:
            if bits & (1 << bit_i):
                cells += 1 if c == _GEN_TILE_SIZE // 2 else 2
            bit_i += 1
    return cells


_GEN_EDGE_BIT_CHOICES = tuple(
    bits
    for bits in range(_GEN_EDGE_BITS_MIN, _GEN_EDGE_BITS_STOP)
