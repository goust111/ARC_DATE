+        out[:, col] = GREY
+
+    for tile_c in range(3):
+        top = _complete_mask(top_masks[tile_c]) if complete else top_masks[tile_c]
+        bottom = _complete_mask(bottom_masks[tile_c]) if complete else bottom_masks[tile_c]
