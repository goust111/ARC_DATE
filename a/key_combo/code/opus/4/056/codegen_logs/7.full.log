+    dr1 = int(positions[1][0] - positions[0][0])
+    dc1 = int(positions[1][1] - positions[0][1])
+    dr2 = int(positions[2][0] - positions[1][0])
+    dc2 = int(positions[2][1] - positions[1][1])
