+        panel_left = idx * (panel_w - 1)
+        paste(grid, patch, 1 + pr, panel_left + 1 + pc, transparent=BG)
+        assert 0 <= pr <= panel_h - 2 - sh
+        assert 0 <= pc <= panel_w - 2 - sw
+
+    return grid
