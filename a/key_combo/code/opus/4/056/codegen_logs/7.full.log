+def _candidate_deltas(ih: int, iw: int, sh: int, sw: int) -> list[tuple[tuple[int, int], list[tuple[int, int]]]]:
+    max_r = ih - sh
+    max_c = iw - sw
+    candidates: list[tuple[tuple[int, int], list[tuple[int, int]]]] = []
+    for dr in range(-2, 3):
