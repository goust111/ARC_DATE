+
+    out = np.full((info["panel_h"], info["panel_w"]), BG, dtype=int)
+    out[0, :] = BORDER
+    out[-1, :] = BORDER
+    out[:, 0] = BORDER
+    out[:, -1] = BORDER
+
+    sprite = np.where(info["sprite_mask"], info["next_color"], BG).astype(int)
+    paste(out, sprite, 1 + info["next_pos"][0], 1 + info["next_pos"][1], transparent=BG)
+    return out
