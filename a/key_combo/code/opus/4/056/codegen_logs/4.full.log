+        walls[r0, c0 : c1 + 1] = Color.GREY
+        walls[r1, c0 : c1 + 1] = Color.GREY
+        walls[r0 : r1 + 1, c0] = Color.GREY
+        walls[r0 : r1 + 1, c1] = Color.GREY
+    return walls
+
+
+def _find_markers(grid: np.ndarray) -> dict[int, tuple[int, int]]:
+    markers: dict[int, tuple[int, int]] = {}
