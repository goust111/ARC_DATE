+    occupied: set[tuple[int, int]] = set()
+    sectors = ("nw", "ne", "south")
+    candidates = {
+        sector: _candidate_marker_cells(exterior, occupied, sector, union_bbox)
+        for sector in sectors
+    }
+    if any(not cells for cells in candidates.values()):
+        return None
+
