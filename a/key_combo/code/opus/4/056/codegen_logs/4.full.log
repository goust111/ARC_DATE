+        if grid is None:
+            return None
+        if _validate_generated(grid, rects, central_gap):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
