+        assert coords.shape == (1, 2), "expected exactly one marker of each color"
+        markers[int(color)] = (int(coords[0, 0]), int(coords[0, 1]))
+
+    marker_cells = list(markers.values())
+    for i, (r0, c0) in enumerate(marker_cells):
