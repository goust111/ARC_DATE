+def _row_intervals(row_mask: np.ndarray) -> list[tuple[int, int]]:
+    intervals: list[tuple[int, int]] = []
+    c = 0
+    width = int(row_mask.shape[0])
+    while c < width:
+        if not bool(row_mask[c]):
+            c += 1
+            continue
+        start = c
+        while c + 1 < width and bool(row_mask[c + 1]):
+            c += 1
+        intervals.append((start, c))
+        c += 1
+    return intervals
