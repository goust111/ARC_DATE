+    b: tuple[int, int, int, int],
+    *,
+    gap: int = 0,
+) -> bool:
+    return not (
+        int(a[2]) + gap < int(b[0])
+        or int(b[2]) + gap < int(a[0])
+        or int(a[3]) + gap < int(b[1])
+        or int(b[3]) + gap < int(a[1])
+    )
