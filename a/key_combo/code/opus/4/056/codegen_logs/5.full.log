+GRID_MAX = 24
+GENERATION_ATTEMPTS = 400
+
+
+def _bbox_hw(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    return int(box[2] - box[0] + 1), int(box[3] - box[1] + 1)
+
+
+def _boxes_touch_or_overlap(
