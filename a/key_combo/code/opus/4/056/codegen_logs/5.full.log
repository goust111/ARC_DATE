+
+def _visible_clipping(inverted_tile: np.ndarray, inner_h: int, inner_w: int) -> bool:
+    tile_h, tile_w = map(int, inverted_tile.shape)
+    r_rem = inner_h % tile_h
+    c_rem = inner_w % tile_w
