+    frames = _extract_frames(g)
+    assert 3 <= len(frames) <= 4, "expected 3 or 4 blue rectangular frames"
+    largest = max(frames, key=lambda item: item["bbox_area"])
+    largest_area = int(largest["bbox_area"])
