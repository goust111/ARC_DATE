            continue
        rr, cc = r + DOT_CENTER_OFFSET, c + DOT_CENTER_OFFSET
        if int(g[rr, cc]) != GEN_BLACK:
            continue
        neighbors = (g[rr - 1, cc], g[rr + 1, cc], g[rr, cc - 1], g[rr, cc + 1])
        if any(int(v) == GEN_RED for v in neighbors):
            continue
