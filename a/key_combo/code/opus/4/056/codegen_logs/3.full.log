+            continue
+        bbox = _bbox_coords(coords)
+        r0, c0, r1, c1 = bbox
+        frames.append(
+            {
+                "coords": coords,
+                "bbox": bbox,
+                "height": r1 - r0 + 1,
+                "width": c1 - c0 + 1,
+                "bbox_area": (r1 - r0 + 1) * (c1 - c0 + 1),
+            }
+        )
+    return frames
+
+
+def _marker_rotation_k(grid: np.ndarray, bbox: BBox) -> int:
