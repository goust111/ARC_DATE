+                "height": r1 - r0 + 1,
+                "width": c1 - c0 + 1,
+                "bbox_area": (r1 - r0 + 1) * (c1 - c0 + 1),
+            }
+        )
+    return frames
+
+
+def _marker_rotation_k(grid: np.ndarray, bbox: BBox) -> int:
+    markers = np.argwhere(grid == MARKER)
+    assert markers.shape == (1, 2), "expected one yellow marker pixel"
+    mr, mc = map(int, markers[0])
