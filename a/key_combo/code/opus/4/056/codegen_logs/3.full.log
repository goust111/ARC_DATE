+
+def _crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _is_rect_frame(grid: np.ndarray, coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return False
+    expected_area = 2 * (h + w) - 4
+    if int(coords.shape[0]) != expected_area:
+        return False
+    patch = _crop_bbox(grid, (r0, c0, r1, c1))
+    boundary = np.zeros_like(patch, dtype=bool)
+    boundary[0, :] = True
+    boundary[-1, :] = True
+    boundary[:, 0] = True
+    boundary[:, -1] = True
+    return bool(np.all(patch[boundary] == FRAME) and np.all(patch[~boundary] != FRAME))
