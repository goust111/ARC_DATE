TEMPLATE_FRAME_MIN_SIZE, TEMPLATE_PATTERN_BORDER_PROB = 3, 0.55
TEMPLATE_STYLES, TEMPLATE_PALETTE = ("frame", "pattern"), (1, 2, 4, 6, 7, 8)

# Workspace object counts and spacing.
TOTAL_OBJECT_COUNT_RANGE = (11, 16)

