+    if orientation == "tr":
+        return {(0, c) for c in range(width)} | {(r, width - 1) for r in range(height)}
+    if orientation == "bl":
+        return {(height - 1, c) for c in range(width)} | {(r, 0) for r in range(height)}
+    if orientation == "br":
