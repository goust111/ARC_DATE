+
+def _choose_pairs(shape: tuple[int, int], blocks: list[tuple[int, int]], rng: random.Random) -> list[dict] | None:
+    candidates = _landing_candidates(shape, blocks)
+    pairs = _pair_records(shape, blocks, candidates)
+    if not pairs:
+        return None
