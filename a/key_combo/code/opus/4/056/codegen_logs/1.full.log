+        out[r, c] = color
+        moved[color].append((r, c))
+    return out, moved
+
+
+def _draw_segment(
+    out: np.ndarray,
+    start: tuple[int, int],
+    end: tuple[int, int],
+    color: int,
+) -> None:
+    r0, c0 = start
+    r1, c1 = end
+    if r0 == r1:
+        for cc in range(min(c0, c1), max(c0, c1) + 1):
+            if int(out[r0, cc]) != RED:
+                out[r0, cc] = color
+        return
