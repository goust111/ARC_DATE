+    return candidates[0]
+
+
+def _slide_markers(
+    grid: np.ndarray,
+    blocks: list[tuple[int, int]],
+) -> tuple[np.ndarray, dict[int, list[tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
