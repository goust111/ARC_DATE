+        base_w = max(c for _r, c in base_cells) + 1
+        insert_h = max(r for r, _c in insert_cells) + 1
+        insert_w = max(c for _r, c in insert_cells) + 1
+
+        try:
+            (base_top, base_left), (insert_top, insert_left) = _non_touching_positions(
+                rng,
+                grid.shape,
+                (base_h, base_w),
+                (insert_h, insert_w),
