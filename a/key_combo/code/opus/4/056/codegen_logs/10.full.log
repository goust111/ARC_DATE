+def _enclosed_mask(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
