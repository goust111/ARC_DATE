+    assert 8 <= len(base_cells) <= 15
+    assert 8 <= len(insert_cells) <= 15
+    assert _hole_count(base_grid) == 0
+    assert _hole_count(insert_grid) == 0
+    holes = _hole_count(docked)
+    assert holes >= 1
