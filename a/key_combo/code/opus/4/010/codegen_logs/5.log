+PANEL_COUNT = 3
+HEIGHT_RANGE = (10, 14)
+PANEL_WIDTH_CHOICES = (8, 9)
+OBJECTS_PER_PANEL = (3, 4, 5)
+OBJECT_AREA_RANGE = (3, 8)
+PRESENCE_COUNT_WEIGHTS = ((3, 4, 5), (4, 4, 1))
+FREQ_WEIGHTS = ((1, 2, 3), (3, 4, 2))
+MAX_GENERATION_ATTEMPTS = 400
+SHAPE_RESTARTS = 60
+SHAPE_SEED_LIMIT = 80
+COMPACT_BIAS = 0.65
+COMPACT_TOP_K = 4
