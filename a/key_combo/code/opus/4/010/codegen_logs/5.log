+INPUT_COLORS = (GREEN, YELLOW, ORANGE, TEAL, MAROON)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if (dr, dc) != (0, 0)
+)
