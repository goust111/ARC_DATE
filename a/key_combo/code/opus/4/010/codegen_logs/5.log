+def _panel_frequencies(panels: list[np.ndarray]) -> dict[int, int]:
+    counts: dict[int, int] = {}
+    for colors in _panel_color_sets(panels):
+        for color in colors:
+            counts[color] = counts.get(color, 0) + 1
