+    count = random.randint(max(3, len(panel_colors)), max(5, len(panel_colors)))
+    colors = list(panel_colors)
+    while len(colors) < count:
+        colors.append(random.choice(panel_colors))
+    random.shuffle(colors)
+    return colors
