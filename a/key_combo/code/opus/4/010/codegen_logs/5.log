+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        height = random.randint(*HEIGHT_RANGE)
+        panel_width = random.choice(PANEL_WIDTH_CHOICES)
+        sampled = _sample_panel_presence()
+        if sampled is None:
