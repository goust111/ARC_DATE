+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+INPUT_COLORS = (GREEN, YELLOW, ORANGE, TEAL, MAROON)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
