+
+def _mirrored_coords_in_frame(sprite: dict[str, object], frame: dict[str, object]) -> list[tuple[int, int]]:
+    mask = np.asarray(sprite["mask"], dtype=bool)
+    sprite_h = int(sprite["h"])
+    sprite_w = int(sprite["w"])
