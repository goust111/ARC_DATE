+    mask = _mask_from_coords(coords)
+    return {
+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "mask": mask,
+        "area": int(coords.shape[0]),
+        "h": int(mask.shape[0]),
+        "w": int(mask.shape[1]),
