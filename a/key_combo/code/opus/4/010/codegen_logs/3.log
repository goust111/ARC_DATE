    assert len(set(panel_colors)) == len(panel_colors), "panel colors must be distinct"

    out = np.zeros((4, 4), dtype=int)
    filled = np.zeros((4, 4), dtype=bool)
    for panel_index in VISIBLE_ORDER:
        panel = panels[panel_index]
        mask = (panel != 0) & (~filled)
        out[mask] = panel[mask]
        filled |= mask

