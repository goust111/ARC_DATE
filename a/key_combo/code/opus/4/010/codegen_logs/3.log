+from arc_utils import Color, bbox_coords, components_mask, get_bg
+
+
+GREY = Color.GRAY
+RED = Color.RED
+BLUE = Color.BLUE
+BLACK = Color.BLACK
+_NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+_GEN_RETRY_LIMIT = 400
