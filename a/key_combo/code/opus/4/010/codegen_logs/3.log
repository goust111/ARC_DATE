+def _shape_neighbors(r: int, c: int, h: int, w: int) -> list[tuple[int, int]]:
+    out = []
+    for dr, dc in _NEIGHBORS4:
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
