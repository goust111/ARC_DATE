+    mask = _mask_from_coords(coords)
+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    assert np.array_equal(mask, border), "red object must be a 1-pixel hollow rectangle"
