+                    "inner_h": inner_h,
+                    "inner_w": inner_w,
+                    "inner_area": area,
+                    "h": inner_h + 2,
+                    "w": inner_w + 2,
+                }
+                return [frame] + rest
+            used.remove(area)
+        return None
