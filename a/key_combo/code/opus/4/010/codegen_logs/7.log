+def _render_panel(mask: np.ndarray, fg_color: int, mark_color: int, rect: tuple[int, int, int, int]) -> np.ndarray:
+    panel = np.where(mask, int(fg_color), BG).astype(int)
+    r0, c0, r1, c1 = rect
