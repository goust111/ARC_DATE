+    if not np.array_equal(main(inp), expected):
+        return False
+
+    left_panel = inp[:, : common_mask.shape[1]]
+    right_panel = inp[:, common_mask.shape[1] + 1 :]
+    naive = _naive_intersection(left_panel, right_panel)
+    if np.array_equal(naive, expected):
+        return False
