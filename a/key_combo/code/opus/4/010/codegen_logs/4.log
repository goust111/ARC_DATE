+def _missing_side_cells(frame: dict) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = frame["bbox"]
+    side = frame["missing_side"]
+    if side == "top":
+        return [(r0, c) for c in range(c0, c1 + 1)]
+    if side == "bottom":
