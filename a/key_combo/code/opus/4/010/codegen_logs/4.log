+    r, c = start
+    dr, dc = step
+    return [(int(r + dr * k), int(c + dc * k)) for k in range(length)]
+
+
+def _ray_from(origin: tuple[int, int], step: tuple[int, int], length: int) -> list[tuple[int, int]]:
+    r, c = origin
+    dr, dc = step
+    return [(int(r + dr * k), int(c + dc * k)) for k in range(1, length + 1)]
