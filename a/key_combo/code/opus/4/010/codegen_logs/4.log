+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+OPEN_SIDES = ("top", "bottom", "left", "right")
+VERTICAL_OPEN_SIDES = ("top", "bottom")
+HORIZONTAL_OPEN_SIDES = ("left", "right")
+VARIANTS = (
+    ("top", "left"),
+    ("top", "right"),
+    ("bottom", "left"),
+    ("bottom", "right"),
+    ("left", "top"),
+    ("left", "bottom"),
+    ("right", "top"),
+    ("right", "bottom"),
+)
+MAX_GENERATE_ATTEMPTS = 400
+GROUP_PLACEMENT_ATTEMPTS = 200
+GRID_SIZE_RANGE = (18, 26)
+GAP_LEN_RANGE = (3, 6)
+RECT_SPAN_RANGE = (3, 6)
+FIXED_LEN_RANGE = (2, 4)
+GROUP_COUNTS = (2, 3)
