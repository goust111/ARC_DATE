+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert connectivity == 4
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
