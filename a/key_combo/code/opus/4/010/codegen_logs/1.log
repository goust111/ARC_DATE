+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+_BG = 0
+_PALETTE = tuple(range(1, 10))
+_GRID_SIZE_RANGE = (12, 18)
+_MAX_OUTER_ATTEMPTS = 800
+_MAX_PLACEMENT_ATTEMPTS = 80
