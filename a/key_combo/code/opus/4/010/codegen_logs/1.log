+def _generate_case(*, with_meta: bool = False):
+    for _ in range(_MAX_OUTER_ATTEMPTS):
+        canvas_shape = (
+            random.randint(*_GRID_SIZE_RANGE),
+            random.randint(*_GRID_SIZE_RANGE),
