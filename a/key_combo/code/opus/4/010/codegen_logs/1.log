+    mask = np.zeros((h, int(full_width)), dtype=bool)
+    for r, row_width in enumerate(row_widths):
+        c0, c1 = _centered_row_bounds(int(full_width), int(row_width))
+        mask[r, c0 : c1 + 1] = True
+    return mask
+
+
