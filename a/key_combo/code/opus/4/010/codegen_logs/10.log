+    for _ in range(GEN_RETRIES):
+        height = random.randint(*PANEL_HEIGHT_RANGE)
+        width = random.randint(*PANEL_WIDTH_RANGE)
+        if PANEL_COUNT * width + 2 > 30:
+            continue
+        mask = _sample_shared_mask(height, width)
