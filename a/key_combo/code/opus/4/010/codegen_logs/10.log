+    h, w = panels[0].shape
+    out = np.zeros((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            values = tuple(int(panel[r, c]) for panel in panels)
+            out[r, c] = _vote_color(values)
+    return out
