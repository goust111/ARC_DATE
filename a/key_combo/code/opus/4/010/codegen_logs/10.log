+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+SEPARATOR = 5
+PALETTE = (1, 2, 3, 4, 7)
+
+PANEL_HEIGHT_RANGE = (7, 10)
+PANEL_WIDTH_RANGE = (7, 9)
