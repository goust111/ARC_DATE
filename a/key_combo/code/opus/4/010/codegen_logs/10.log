+            continue
+        panels = _sample_triples(mask)
+        grid = _render_input(panels)
+        try:
+            _validate_generated(grid)
+        except AssertionError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid three-panel voting puzzle")

