+            ties += 1
+            continue
+        output_colors.add(int(winner))
+        if copies == 3:
+            unanimous += 1
+            continue
+        majority += 1
+        minority = [i for i, color in enumerate(triplet) if color != winner]
+        assert len(minority) == 1
+        minority_panels.add(int(minority[0]))
