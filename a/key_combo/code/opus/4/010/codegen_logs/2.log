+    components: list[list[tuple[int, int]]] = []
+
+    for start_r in range(height):
+        for start_c in range(width):
+            if wall_mask[start_r, start_c] or labels[start_r, start_c] != -1:
+                continue
+
+            label = len(components)
+            queue = deque([(start_r, start_c)])
