+def _consistent_periods(grid: np.ndarray) -> list[tuple[int, int, int, np.ndarray]]:
+    g = np.asarray(grid, dtype=int)
+    wall_coords = np.argwhere(g == GREY)
+    open_coords = np.argwhere((g != BLACK) & (g != GREY))
