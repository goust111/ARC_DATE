+
+def _infer_wall_tile(grid: np.ndarray) -> tuple[int, int, np.ndarray]:
+    key = _grid_key(grid)
+    cached = _PERIOD_CACHE.get(key)
+    if cached is not None:
+        tile_h, tile_w, tile = cached
+        return tile_h, tile_w, tile.copy()
