+    tile_h, tile_w, tile = _infer_wall_tile(g)
+    row_phase = np.arange(g.shape[0])[:, None] % tile_h
+    col_phase = np.arange(g.shape[1])[None, :] % tile_w
+    should_be_wall = tile[row_phase, col_phase] == 1
