+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        sample = _make_instance()
+        if sample is not None:
+            return sample[0]
+    raise RuntimeError("failed to generate a valid periodic-wall chamber puzzle")

