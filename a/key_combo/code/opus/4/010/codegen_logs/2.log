+
+def _choose_door(candidates: list[dict[str, object]]) -> dict[str, object]:
+    ranked = sorted(
+        candidates,
+        key=lambda item: (
+            not bool(item["interior_phase"]),
+            bool(item["straight"]),
+            item["phase"],
+            item["cell"],
+        ),
+    )
+    best_rank = (
+        bool(ranked[0]["interior_phase"]),
+        bool(ranked[0]["straight"]),
+    )
+    best = [
+        item
+        for item in ranked
+        if (
+            bool(item["interior_phase"]),
+            bool(item["straight"]),
