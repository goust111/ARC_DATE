+    wall_phase_set = {
+        (int(r), int(c))
+        for r, c in np.argwhere(tile == 1)
+    }
+    visible_phase_set = {
+        (int(r) % tile_h, int(c) % tile_w)
+        for r, c in np.argwhere(inp == GREY)
+    }
