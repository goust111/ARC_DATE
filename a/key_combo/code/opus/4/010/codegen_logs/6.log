+    overlap_seen = False
+    for i in range(len(boxes)):
+        for j in range(i + 1, len(boxes)):
+            inter = _intersection(boxes[i], boxes[j])
+            if inter is None:
+                continue
+            r0, c0, r1, c1 = inter
+            patch = g[r0 : r1 + 1, c0 : c1 + 1]
+            if np.any(patch == BACKGROUND):
