+    h, w = map(int, shape)
+    r0, c0, r1, c1 = map(int, box)
+    return (
+        max(0, r0 - pad),
+        max(0, c0 - pad),
+        min(h - 1, r1 + pad),
+        min(w - 1, c1 + pad),
+    )
+
+
+def _intersection(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int]
+) -> tuple[int, int, int, int] | None:
