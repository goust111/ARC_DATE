+            box = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+            if all(_rect_separated(box, other, min_gap=2) for other in existing):
+                candidates.append(box)
+    if not candidates:
+        return None
+    return random.choice(candidates)
