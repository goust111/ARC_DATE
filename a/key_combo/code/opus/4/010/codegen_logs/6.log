+    mirrored_pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r, c in slots:
+        mate = (r, axis_sum - c)
+        points.add((r, c))
+        points.add(mate)
+        mirrored_pairs.append(((r, c), mate))
