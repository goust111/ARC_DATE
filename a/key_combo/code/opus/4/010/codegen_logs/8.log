+        c = int(item["c"])
+        cr, cc = item["corner"]  # type: ignore[misc]
+        r0, r1 = sorted((r, int(cr)))
+        c0, c1 = sorted((c, int(cc)))
+        if r0 <= marker[0] <= r1 and c0 <= marker[1] <= c1:
