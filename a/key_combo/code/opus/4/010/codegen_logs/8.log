+    if g.ndim != 2 or max(g.shape) > 30:
+        return False
+    marker_cells = np.argwhere(g == MAGENTA)
+    if marker_cells.shape != (1, 2):
+        return False
+    pixels = np.argwhere((g != BLACK) & (g != MAGENTA))
+    if pixels.shape[0] != 4:
