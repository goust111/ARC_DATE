+        cc = base[:, 1].max() + 1
+        arr = np.zeros((rr, cc), dtype=int)
+        arr[base[:, 0], base[:, 1]] = 1
+        variants = []
+        for flip in (False, True):
+            work = np.fliplr(arr) if flip else arr
+            for k in range(4):
