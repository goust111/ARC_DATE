+def _mask_with_padding(mask: np.ndarray) -> np.ndarray:
+    padded = mask.copy()
+    padded[1:, :] |= mask[:-1, :]
+    padded[:-1, :] |= mask[1:, :]
+    padded[:, 1:] |= mask[:, :-1]
+    padded[:, :-1] |= mask[:, 1:]
+    return padded
