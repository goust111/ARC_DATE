+def _scatter_patches(patches: list[np.ndarray]) -> np.ndarray | None:
+    max_h = max(int(patch.shape[0]) for patch in patches)
+    max_w = max(int(patch.shape[1]) for patch in patches)
+    min_side = max(18, max_h + 6, max_w + 6)
