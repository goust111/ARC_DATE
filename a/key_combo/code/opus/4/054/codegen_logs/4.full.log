+
+def _sample_kept_sizes(kept_counts: list[int]) -> list[tuple[int, int]] | None:
+    for _ in range(200):
+        sizes = []
+        used = set()
+        for count in kept_counts:
+            candidates = _candidate_sizes(int(count))
+            if count <= 2:
+                candidates = [size for size in candidates if max(size) <= 6]
+            elif count <= 4:
+                candidates = [size for size in candidates if 5 <= min(size) <= 8]
+            else:
