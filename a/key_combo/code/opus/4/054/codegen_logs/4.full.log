+def _candidate_sizes(count: int, *, h_max: int = 10, w_max: int = 10) -> list[tuple[int, int]]:
+    sizes = []
+    for h in range(4, h_max + 1):
+        for w in range(4, w_max + 1):
+            if _capacity_ok(h, w, count):
+                sizes.append((h, w))
