+def colors_present(grid: np.ndarray, *, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, np.unique(grid)))
+    if exclude is not None:
+        colors -= set(map(int, exclude))
+    return sorted(colors)
+
+
+def bbox_coords(coords: np.ndarray) -> BBox:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> np.ndarray:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = map(int, patch.shape)
+    dst_view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        dst_view[:] = patch
+    else:
+        mask = patch != int(transparent)
+        dst_view[mask] = patch[mask]
+    return dst
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    assert int(connectivity) == 4
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bool(mask[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
