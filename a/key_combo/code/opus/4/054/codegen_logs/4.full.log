+    if len(kept_counts) == 2:
+        ranked_modes = ["large", "large"]
+    else:
+        ranked_modes = ["medium", "large", "small"]
+    assigned = ["medium"] * len(kept_counts)
+    for rank, idx in enumerate(ordered):
+        assigned[idx] = ranked_modes[min(rank, len(ranked_modes) - 1)]
