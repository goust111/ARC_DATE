+def _full_bbox(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = bbox_coords(coords)
+    h, w = map(int, mask.shape)
+    return (r0, c0, r1, c1) == (0, 0, h - 1, w - 1)
