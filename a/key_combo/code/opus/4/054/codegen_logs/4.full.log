+def _contains_target(shape: np.ndarray, top: int, left: int, target: Coord | None) -> bool:
+    if target is None:
+        return True
+    tr, tc = map(int, target)
+    rr = top + shape[:, 0]
+    cc = left + shape[:, 1]
+    return bool(np.any((rr == tr) & (cc == tc)))
