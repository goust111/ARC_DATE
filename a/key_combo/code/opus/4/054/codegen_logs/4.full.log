+def _sample_skipped_layout(skip_count: int, used_sizes: set[tuple[int, int]]) -> dict | None:
+    choices = [layout for layout in _candidate_layouts(int(skip_count)) if tuple(layout["size"]) not in used_sizes]
+    if not choices:
