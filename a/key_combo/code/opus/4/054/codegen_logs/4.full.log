+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_example()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid frequency-overlay ARC input")

