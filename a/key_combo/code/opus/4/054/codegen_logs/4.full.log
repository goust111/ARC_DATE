+def _candidate_shapes(area_mode: str) -> list[np.ndarray]:
+    if area_mode == "large":
+        areas = (5, 6, 4)
+    elif area_mode == "medium":
+        areas = (4, 5, 3)
+    else:
+        areas = (3, 4, 5)
+    return [shape.copy() for area in areas for shape in SHAPES_BY_AREA.get(area, [])]
