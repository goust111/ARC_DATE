+def _candidate_layouts(count: int) -> list[dict]:
+    layouts = []
+    if count <= 6:
+        for h in range(7, 11):
+            for w in range(8, 11):
+                layouts.append({"family": "tall", "size": (h, w), "count": int(count)})
+        for h in range(8, 11):
