+
+
+def _build_example() -> np.ndarray | None:
+    n_colors = int(RNG.choice(np.array([3, 4], dtype=int)))
+    counts = _sample_counts(n_colors)
+    colors = list(map(int, RNG.choice(np.arange(1, 10, dtype=int), size=n_colors, replace=False)))
