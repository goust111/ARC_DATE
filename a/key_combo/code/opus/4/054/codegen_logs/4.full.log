+                "color": int(color),
+                "count": int(len(comps)),
+                "coords": coords,
+                "patch": patch,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "pixel_count": int(coords.shape[0]),
+                "component_areas": sorted(int(comp.shape[0]) for comp in comps),
