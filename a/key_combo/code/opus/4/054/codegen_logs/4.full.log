+    slots = []
+    rows_n = len(row_starts)
+    cols_n = len(col_starts)
+    for rr, top in enumerate(row_starts):
+        for cc, left in enumerate(col_starts):
+            slots.append(
+                {
+                    "id": rr * cols_n + cc,
+                    "top": int(top),
+                    "left": int(left),
+                    "bottom": int(top + box_h - 1),
+                    "right": int(left + box_w - 1),
+                    "row": rr,
+                    "col": cc,
