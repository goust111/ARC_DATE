+
+
+def _place_shape(mask: np.ndarray, shape: np.ndarray, top: int, left: int) -> None:
+    mask[top + shape[:, 0], left + shape[:, 1]] = True
+
+
+def _full_bbox(mask: np.ndarray) -> bool:
