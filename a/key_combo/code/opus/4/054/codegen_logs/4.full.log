+def _anchor_choices(
+    occ: np.ndarray,
+    shapes: list[np.ndarray],
+    mode: str,
+    target: Coord | None,
+) -> list[tuple[np.ndarray, int, int]]:
+    h, w = map(int, occ.shape)
+    choices = []
+    for shape in shapes:
+        sh, sw = _shape_size(shape)
+        if mode == "tl":
+            positions = [(0, 0)]
+        elif mode == "tr":
+            positions = [(0, w - sw)]
+        elif mode == "bl":
+            positions = [(h - sh, 0)]
+        elif mode == "br":
+            positions = [(h - sh, w - sw)]
+        elif mode == "target":
+            positions = [(r, c) for r in range(h - sh + 1) for c in range(w - sw + 1)]
+        elif mode == "tl_target":
+            positions = [(0, 0)]
+        elif mode == "tr_target":
+            positions = [(0, w - sw)]
+        elif mode == "bl_target":
+            positions = [(h - sh, 0)]
+        elif mode == "br_target":
+            positions = [(h - sh, w - sw)]
