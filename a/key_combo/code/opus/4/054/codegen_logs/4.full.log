+    ordered = sorted(range(len(kept_counts)), key=lambda idx: int(kept_counts[idx]))
+    base = ["large", "medium", "small"]
+    assigned = ["medium"] * len(kept_counts)
+    for rank, idx in enumerate(ordered):
