+from __future__ import annotations
+
+import itertools
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+RNG = np.random.default_rng()
+BG = 0
+MAX_GENERATION_ATTEMPTS = 600
+MAX_PATCH_ATTEMPTS = 200
+MAX_SCATTER_ATTEMPTS = 120
