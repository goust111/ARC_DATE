+def _centered_patch(patch: np.ndarray, out_shape: tuple[int, int]) -> np.ndarray:
+    out = np.zeros(out_shape, dtype=int)
+    ph, pw = map(int, patch.shape)
+    top = (int(out_shape[0]) - ph) // 2
+    left = (int(out_shape[1]) - pw) // 2
