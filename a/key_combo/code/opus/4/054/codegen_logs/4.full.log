+
+def _generate_patch(height: int, width: int, count: int, color: int, *, target: Coord | None, area_mode: str) -> np.ndarray | None:
+    shapes = _candidate_shapes(area_mode)
+    opposite_pairs = [("tl", "br"), ("tr", "bl")]
+    target_modes = {
+        "tl": "tl_target",
+        "tr": "tr_target",
+        "bl": "bl_target",
+        "br": "br_target",
