+def _slot_union_mask(layout: dict) -> np.ndarray:
+    info = _layout_slots(layout)
+    h, w = map(int, layout["size"])
+    mask = np.zeros((h, w), dtype=bool)
+    for slot in info["slots"]:
+        mask[slot["top"] : slot["bottom"] + 1, slot["left"] : slot["right"] + 1] = True
+    return mask
