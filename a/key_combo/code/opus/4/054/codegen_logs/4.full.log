+    skip_patch = _generate_patch(sh, sw, int(skip_count), skip_color, target=skip_target, area_mode=skip_area_mode)
+    if skip_patch is None:
+        return None
+    specs.append({"color": skip_color, "count": int(skip_count), "patch": skip_patch})
