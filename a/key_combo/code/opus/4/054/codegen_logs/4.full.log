+        tr, tc = map(int, target)
+        target_slots = [
+            int(slot["id"])
+            for slot in slots
+            if slot["top"] <= tr <= slot["bottom"] and slot["left"] <= tc <= slot["right"]
+        ]
+        if not target_slots:
+            return None
+    else:
+        target_slots = [-1]
