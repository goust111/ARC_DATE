+
+def _sample_skipped_size(skip_count: int, used: set[tuple[int, int]]) -> tuple[int, int] | None:
+    candidates = [size for size in _candidate_sizes(int(skip_count)) if size not in used]
+    if not candidates:
+        return None
+    return candidates[int(RNG.integers(len(candidates)))]
