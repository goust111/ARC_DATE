+        rect_specs = [{**spec, "patch": _rect_patch(spec["patch"].shape, spec["color"])} for spec in kept]
+        rect_out = _overlay_specs(rect_specs, order_key=lambda spec: int(spec["count"]))
+        if np.array_equal(actual, rect_out):
+            return False
+
