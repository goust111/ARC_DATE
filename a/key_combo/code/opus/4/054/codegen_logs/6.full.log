+    if not indices:
+        return runs
+    start = prev = int(indices[0])
+    for idx in indices[1:]:
+        idx = int(idx)
+        if idx == prev + 1:
+            prev = idx
+            continue
+        runs.append((start, prev))
+        start = prev = idx
+    runs.append((start, prev))
+    return runs
