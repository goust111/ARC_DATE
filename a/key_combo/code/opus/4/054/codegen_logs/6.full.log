LEGEND_COUNT_RANGE = range(1, 4)
LEGEND_LEN_RANGE = range(3, 7)
TOTAL_LEGEND_CELLS_RANGE = (6, 12)
MAX_LEGENDS_PER_EDGE = 2
EDGE_LEGEND_GAP = 7
LEGEND_COLOR_POOL = np.arange(1, 10, dtype=int)

