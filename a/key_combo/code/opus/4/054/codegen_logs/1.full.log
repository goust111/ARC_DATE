    positions = range(GEN_BLOCK_RADIUS, int(length) - GEN_BLOCK_RADIUS)
    valid = [
        combo
        for combo in itertools.combinations(positions, int(count))
        if all(abs(a - b) >= int(min_sep) for a, b in itertools.combinations(combo, 2))
    ]
