+    if r < r0 and c > c1:
+        return "ur"
+    if r > r1 and c < c0:
+        return "ll"
+    if r > r1 and c > c1:
+        return "lr"
+    raise AssertionError("seed must lie in a strict diagonal quadrant")
+
