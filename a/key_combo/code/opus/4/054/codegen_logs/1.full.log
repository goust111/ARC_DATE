    random.shuffle(chosen)
    return chosen


def _gen_neighbors4(row: int, col: int):
    yield row - 1, col
    yield row + 1, col
    yield row, col - 1
    yield row, col + 1


def _gen_in_bounds(shape: tuple[int, int], row: int, col: int) -> bool:
