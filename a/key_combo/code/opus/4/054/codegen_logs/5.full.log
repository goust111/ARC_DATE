+
+HEIGHT_RANGE = (14, 19)
+WIDTH_RANGE = (16, 21)
+BLOCK_COUNT_RANGE = (2, 4)
+LEGEND_COLOR_COUNT_RANGE = (2, 4)
+MIN_CENTER_ROW = 2
+MIN_CENTER_COL = 4
+MIN_CENTER_SEP = 3
+MAX_ATTEMPTS = 400
+ALL_COLORS = tuple(range(1, 10))
+
