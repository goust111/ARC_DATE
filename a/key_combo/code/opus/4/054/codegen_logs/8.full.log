0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Recenter each four-pixel color mask in a shared compact canvas.
0011: 
0012:     Input structure:
0013:     - The grid has one dominant background color.
0014:     - Every non-background color appears as exactly four pixels.
0015:     - Each color's four-pixel mask has an odd-compatible row and column center
0016:       when compared with the widest/tallest foreground mask.
0017: 
0018:     Rule:
0019:     - For each non-background color, take its four pixels relative to that color's bbox.
0020:     - Make the output background-colored with size equal to the maximum foreground
0021:       bbox height and width.
0022:     - Paste every relative color mask centered in that common output canvas.
0023: 
0024:     Key insight:
0025:     - The large input only separates the colored masks spatially; the desired image
0026:       is their center-aligned overlay after removing the surrounding background.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     assert g.ndim == 2, "expected a 2D grid"
0030: 
0031:     _, counts = np.unique(g, return_counts=True)
0032:     assert np.count_nonzero(counts == counts.max()) == 1, "expected a unique dominant background color"
0033:     bg = get_bg(g)
0034:     specs = []
0035:     for color in colors_present(g, exclude={bg}):
0036:         coords = np.argwhere(g == int(color))
0037:         assert coords.shape == (4, 2), "each foreground color must occur exactly four times"
0038:         r0, c0, r1, c1 = bbox_coords(coords)
0039:         specs.append((int(color), coords, r0, c0, r1 - r0, c1 - c0))
0040: 
0041:     assert specs, "expected at least one foreground color"
0042:     max_row_span = max(row_span for _color, _coords, _r0, _c0, row_span, _col_span in specs)
0043:     max_col_span = max(col_span for _color, _coords, _r0, _c0, _row_span, col_span in specs)
0044: 
0045:     out = np.full((max_row_span + 1, max_col_span + 1), bg, dtype=int)
0046:     occupied = np.zeros(out.shape, dtype=bool)
0047: 
0048:     for color, coords, r0, c0, row_span, col_span in specs:
0049:         row_extra = max_row_span - row_span
0050:         col_extra = max_col_span - col_span
0051:         assert row_extra % 2 == 0 and col_extra % 2 == 0, "masks must center on the output grid"
0052:         row_offset = row_extra // 2
0053:         col_offset = col_extra // 2
0054: 
0055:         for r, c in coords:
0056:             rr = int(r) - r0 + row_offset
0057:             cc = int(c) - c0 + col_offset
0058:             assert not occupied[rr, cc], "centered foreground masks must not overlap"
0059:             occupied[rr, cc] = True
0060:             out[rr, cc] = color
0061: 
0062:     return out
