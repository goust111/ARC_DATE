+
+
+def _render_output(
+    shape: tuple[int, int], trigger_row: int, red_coords: list[tuple[int, int]]
+) -> np.ndarray:
+    height, width = map(int, shape)
+    out = np.full((height, width), BACKGROUND, dtype=int)
+    out[int(trigger_row), :] = TRIGGER
+
+    left_count = 0
+    right_count = 0
+    moved_coords: list[tuple[int, int]] = []
