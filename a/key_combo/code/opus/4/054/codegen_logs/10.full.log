        assert obj["area"] == 4
        shape = _normalized_shape(obj["coords"])
        if shape == UP_T:
            up_count += 1
        elif shape == DOWN_T:
            down_count += 1
        else:
            raise AssertionError(f"unexpected red object shape: {sorted(shape)}")

