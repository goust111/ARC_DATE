    assert down_count <= len(TALLY_SLOTS)

    out = np.full((3, 6), Color.BLACK, dtype=int)
    for r, c in TALLY_SLOTS[:up_count]:
        out[r, c] = Color.GREEN
    for r, c in TALLY_SLOTS[:down_count]:
        out[r, c + 3] = Color.BLUE
    return out

