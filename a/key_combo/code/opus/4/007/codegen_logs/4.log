+    return box[2] - box[0] + 1
+
+
+def _box_width(box: tuple[int, int, int, int]) -> int:
+    return box[3] - box[1] + 1
+
+
+def _boxes_overlap(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0
+) -> bool:
+    return not (
