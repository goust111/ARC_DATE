+        k = _scale_from_rect(rect, template)
+        located.append(
+            {
+                "color": color,
+                "coords": coords,
+                "side": side,
+                "rect": rect,
+                "k": k,
+            }
+        )
+
+    out = g.copy()
+    for item in located:
+        for r, c in item["coords"]:
+            out[int(r), int(c)] = BLACK
