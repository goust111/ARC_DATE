+def _connected4(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    stack = [next(iter(cells))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS.values():
+            for rr, cc in ((r + dr, c + dc), (r - dr, c - dc)):
+                if (rr, cc) in cells and (rr, cc) not in seen:
+                    seen.add((rr, cc))
+                    stack.append((rr, cc))
+    return seen == cells
+
+
+def _enumerate_prototypes() -> list[dict]:
