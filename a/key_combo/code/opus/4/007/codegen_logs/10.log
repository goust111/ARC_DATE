+        "id": int(idx),
+        "scale": int(scale),
+        "top": int(top),
+        "left": int(left),
+        "bbox": (int(top), int(left), int(top + span - 1), int(left + span - 1)),
+        "red": red,
+        "seeds": seeds,
+    }
