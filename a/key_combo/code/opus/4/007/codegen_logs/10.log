                break
            assert val in (bg, red)
            rr += dr
            cc += dc

        if hit is None:
            last = (rr - dr, cc - dc)
            if (r, c) != last:
                paint_line((r + dr, c + dc), last)
            break

        hr, hc = hit
        turn_start = (hr - dr, hc - dc)
        if (r, c) != turn_start:
            paint_line((r + dr, c + dc), turn_start)

        comp = component_at[hit]
        color = int(comp["color"])
        normal = (-dc, dr) if color == blue else (dc, -dr)
        r0, c0, r1, c1 = comp["bbox"]
        if normal[0] < 0:
            side = (r0 - 1, hc)
        elif normal[0] > 0:
            side = (r1 + 1, hc)
        elif normal[1] < 0:
            side = (hr, c0 - 1)
        else:
