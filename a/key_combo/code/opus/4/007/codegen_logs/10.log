+    inp = _scene_input(scene)
+    if not np.array_equal(main(inp), _scene_expected_output(scene)):
+        return None
+    return scene
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        scene = _assemble_scene()
+        if scene is not None:
