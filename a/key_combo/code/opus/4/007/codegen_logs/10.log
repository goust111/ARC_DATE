+    source, target, red_block_dir = pair
+    instances = [source, target]
+    occupied = source["red"] | source["seeds"] | target["red"] | target["seeds"]
+
+    remaining_scales = [scale for scale in [2, 3] if scale != target_scale]
+    if random.random() < 0.55:
