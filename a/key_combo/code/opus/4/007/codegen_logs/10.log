+    for inst in scene["instances"]:
+        occupied |= inst["red"] | inst["seeds"]
+    for _report, _step, _top, cells in candidate_blocks:
+        free_cells = sorted(cells - occupied - scene["greys"])
+        if not free_cells:
+            continue
+        scene["greys"].add(random.choice(free_cells))
+        return True
+    return False
