+def _apply_shadow_copy(
+    grid: np.ndarray, instances: list[dict], active_dirs: tuple[str, ...]
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    obstacle = (grid == RED) | (grid == GREY)
