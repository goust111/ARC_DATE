+    g = np.asarray(grid, dtype=int)
+    instances = _red_components_with_scale(g)
+    if not instances:
+        return g.copy()
+    active_dirs = _active_dirs_from_smallest(g, instances[0])
+    if not active_dirs:
+        return g.copy()
+    return _apply_shadow_copy(g, instances, active_dirs)
