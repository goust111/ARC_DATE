+def _assemble_scene() -> dict | None:
+    shape = (random.randint(GRID_MIN, GRID_MAX), random.randint(GRID_MIN, GRID_MAX))
+    proto, active_dirs = _choose_prototype_and_dirs()
+    target_scale = random.choice([2, 3])
