+    if r0 < 0 or c0 < 0 or r1 >= h or c1 >= w:
+        return False
+    all_cells = inst["red"] | inst["seeds"]
+    if not _cells_in_bounds(shape, all_cells):
+        return False
+    if all_cells & occupied:
