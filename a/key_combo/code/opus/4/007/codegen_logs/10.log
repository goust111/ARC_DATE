    # Place two teal divider lines (a full row and a full column) so the top-left region is exactly 2x2.
    grid[2, :] = Color.TEAL
    grid[:, 2] = Color.TEAL

    # Randomly rotate the input grid.
    grid = np.rot90(grid,-(np.random.randint(0, 4)))
