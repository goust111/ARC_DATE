+    dirs = []
+    if c0 + 1 < w and int(grid[r0, c0 + 1]) == BLUE:
+        dirs.append("right")
+    if r0 + 1 < h and int(grid[r0 + 1, c0]) == BLUE:
+        dirs.append("down")
+    return tuple(dirs)
