+            if not _block_in_bounds(shape, block_top, block_left, 1):
+                continue
+            for rr, cc in preferred:
+                target = _instance_record(
+                    proto,
+                    (),
+                    target_scale,
+                    block_top - rr,
+                    block_left - cc,
+                    1,
+                )
+                occupied = source["red"] | source["seeds"]
+                if _can_place_instance(target, [source], occupied, shape):
+                    scene = {
