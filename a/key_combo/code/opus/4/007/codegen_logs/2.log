+    upper_margin = max(spec["upper_gap"] + spec["upper_mask"].shape[0] - 1 for spec in specs)
+    lower_margin = max(spec["lower_gap"] + spec["lower_mask"].shape[0] - 1 for spec in specs)
+    min_height = upper_margin + lower_margin + 1
