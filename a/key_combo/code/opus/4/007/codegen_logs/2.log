+    lower.sort(key=lambda comp: (comp["bbox"][1] + comp["bbox"][3], comp["bbox"][1], comp["bbox"][0]))
+
+    gates: list[dict] = []
+    for up, down in zip(upper, lower, strict=True):
+        up_sym = _is_axis_symmetric(up["mask"])
+        down_sym = _is_axis_symmetric(down["mask"])
+        if up_sym == down_sym:
