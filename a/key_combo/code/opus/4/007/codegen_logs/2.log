+def _validate_generated_grid(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    if set(map(int, np.unique(grid))) - {BG, PATH, SPRITE}:
+        return False
+
+    try:
