+            [(Color.GREEN, 1), (Color.GREEN, 2)],
+            [(Color.BLUE, 1), (Color.GREEN, 1)],
+            [(Color.BLUE, 2), (Color.GREEN, 2)],
+        ]
+        plan = random.choice(plans)
+    elif n_bars == 3:
+        drop = random.randrange(len(all_combos))
+        plan = [combo for i, combo in enumerate(all_combos) if i != drop]
+    else:
+        plan = all_combos[:]
