+    bars = meta["bars"]
+    detour_costs = [_bar_cost(meta["start_c"], bar) for bar in bars]
+    detour_colors = [meta["legend"][cost] for cost in detour_costs]
+    if len(set(detour_costs)) < 2:
+        return False
+    if len(set(detour_colors)) < 2:
