+def _find_bars(grid: np.ndarray, start_c: int, legend_row: int) -> list[dict[str, int]]:
+    h, w = grid.shape
+    bars: list[dict[str, int]] = []
+    for r in range(1, legend_row):
+        c = 0
+        while c < w:
+            val = int(grid[r, c])
+            if val in BAR_COLORS:
