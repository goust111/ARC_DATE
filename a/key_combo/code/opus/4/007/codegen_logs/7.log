+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+MARKER = 5
+PALETTE = (1, 2, 3, 4, 6)
+GRID_MIN = 16
+GRID_MAX = 22
+REGION_COUNT_RANGE = (3, 5)
