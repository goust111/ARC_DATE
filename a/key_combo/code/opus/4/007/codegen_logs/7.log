+    areas = random.sample(tuple(range(AREA_CHOICES[0], max_area + 1)), count)
+    specs = list(zip(colors, areas))
+    random.shuffle(specs)
+
+    regions: list[dict] = []
+    blocked: set[Coord] = set()
+    for color, area in specs:
+        placed = False
+        for _ in range(PLACEMENT_RETRIES):
