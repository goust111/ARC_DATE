+        out = base
+    elif mode == 1:
+        out = [(c, h - 1 - r) for r, c in base]
+    elif mode == 2:
+        out = [(h - 1 - r, w - 1 - c) for r, c in base]
+    elif mode == 3:
+        out = [(w - 1 - c, r) for r, c in base]
+    elif mode == 4:
+        out = [(r, w - 1 - c) for r, c in base]
+    elif mode == 5:
+        out = [(h - 1 - r, c) for r, c in base]
+    elif mode == 6:
+        out = [(c, r) for r, c in base]
+    elif mode == 7:
+        out = [(w - 1 - c, h - 1 - r) for r, c in base]
