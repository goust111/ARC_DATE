+            _, _, r1, c1 = bbox_coords(shape)
+            shape_h = r1 + 1
+            shape_w = c1 + 1
+            top = random.randint(2, h - shape_h)
+            left = random.randint(0, w - shape_w)
+            cells = [(top + r, left + c) for r, c in shape]
+            if any((r, c) in blocked for r, c in cells):
