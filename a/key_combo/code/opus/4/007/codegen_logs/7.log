+        if h > 5 or w > 6:
+            continue
+        if area == h * w:
+            continue
+        if len({r for r, _ in coords}) < 2 or len({c for _, c in coords}) < 2:
+            continue
+        return coords
+    raise RuntimeError(f"failed to grow a polyomino of area {area}")
