+BG = 0
+MARKER = 5
+PALETTE = (1, 2, 3, 4, 6)
+GRID_MIN = 16
+GRID_MAX = 22
+REGION_COUNT_RANGE = (3, 5)
+AREA_CHOICES = tuple(range(4, 13))
+GENERATION_RETRIES = 400
+PLACEMENT_RETRIES = 250
+SHAPE_RETRIES = 200
