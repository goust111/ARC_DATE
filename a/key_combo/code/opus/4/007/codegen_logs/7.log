+            if color in (BG, MARKER) or (r, c) in seen:
+                continue
+            stack = [(r, c)]
+            seen.add((r, c))
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and int(g[nr, nc]) == color:
+                        seen.add((nr, nc))
+                        stack.append((nr, nc))
