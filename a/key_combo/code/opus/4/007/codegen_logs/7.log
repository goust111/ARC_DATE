+    pos = {rid: i for i, rid in enumerate(order_b)}
+    seq = [pos[rid] for rid in order_a]
+    inv = 0
+    for i in range(len(seq)):
+        for j in range(i + 1, len(seq)):
+            if seq[i] > seq[j]:
