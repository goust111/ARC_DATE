+
+def _place_regions(h: int, w: int, count: int) -> list[dict] | None:
+    colors = random.sample(PALETTE, count)
+    areas = random.sample(AREA_CHOICES, count)
+    specs = list(zip(colors, areas))
+    random.shuffle(specs)
