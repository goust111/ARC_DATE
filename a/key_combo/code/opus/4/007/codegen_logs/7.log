+def _transform_coords(coords: Iterable[Coord], mode: int) -> list[Coord]:
+    pts = list(coords)
+    r0, c0, r1, c1 = bbox_coords(pts)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
