+                and int(rec["hits"]["up"]["color"]) != int(rec["hits"]["down"]["color"])
+            )
+        )
+        score = (split_blocks, axis_conflicts, cand["tile_h"] * cand["tile_w"], cand["rows"] * cand["cols"])
+        scored.append((score, cand))
+    scored.sort(key=lambda item: item[0], reverse=True)
+    return scored[0][1]
