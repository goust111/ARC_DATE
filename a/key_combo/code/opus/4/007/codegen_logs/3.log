+    if int(neg_hit["color"]) == int(pos_hit["color"]):
+        return int(neg_hit["color"])
+    if int(neg_hit["dist"]) <= int(pos_hit["dist"]):
+        return int(neg_hit["color"])
+    return int(pos_hit["color"])
