+def _make_motif(size: int) -> np.ndarray:
+    motif = np.full((size, size), GREY, dtype=int)
+    if size == 3:
+        motif[1, 1] = BLACK
+        return motif
+
+    holes = random.randint(1, 3)
+    cells = [(1, 1), (1, 2), (2, 1), (2, 2)]
+    for r, c in random.sample(cells, holes):
+        motif[r, c] = BLACK
+    return motif
