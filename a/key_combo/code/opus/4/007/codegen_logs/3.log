+    cc = start_c + dc
+    dist = 1
+    while _in_bounds(grid.shape, rr, cc):
+        val = int(grid[rr, cc])
+        if val not in (BLACK, GREY):
+            return {"color": val, "dist": dist, "pos": (rr, cc)}
+        rr += dr
+        cc += dc
+        dist += 1
+    return None
+
