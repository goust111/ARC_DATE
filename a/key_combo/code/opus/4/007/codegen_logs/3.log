+def _edge_sources_for_mode(
+    mode: str, row_centers: list[int], col_centers: list[int]
+) -> dict[str, tuple[int, int]]:
+    if mode == "vertical_cover":
+        selected_row = random.randrange(len(row_centers))
+        top_col, bottom_col = random.sample(range(2), 2)
+        return {
+            "top": (0, col_centers[top_col]),
+            "bottom": (row_centers[-1] + (row_centers[0] - 0) + (row_centers[-1] - row_centers[-2] if len(row_centers) > 1 else 0), col_centers[bottom_col]),
+            "left": (row_centers[selected_row], 0),
+            "right": (row_centers[selected_row], -1),
+        }
+    selected_col = random.randrange(len(col_centers))
+    left_row, right_row = random.sample(range(2), 2)
+    return {
+        "top": (0, col_centers[selected_col]),
+        "bottom": (-1, col_centers[selected_col]),
+        "left": (row_centers[left_row], 0),
+        "right": (row_centers[right_row], -1),
+    }
+
+
+def _place_grid(
+    motif: np.ndarray,
+    rows: int,
+    cols: int,
+    mode: str,
+    margins: tuple[int, int, int, int],
+    edge_colors: dict[str, int],
+) -> np.ndarray:
