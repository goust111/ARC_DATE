+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= r < h and 0 <= c < w
+
+
+def _ray_hit(
+    grid: np.ndarray, start_r: int, start_c: int, dr: int, dc: int
+) -> Optional[dict[str, object]]:
