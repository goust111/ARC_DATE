+            (top_margin, bottom_margin, left_margin, right_margin),
+            edge_colors,
+        )
+
+        try:
+            _validate_generated(grid)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid ray-visibility recoloring input")

