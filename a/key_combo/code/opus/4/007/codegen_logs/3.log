+        left_row_idx, right_row_idx = random.sample(range(2), 2)
+        positions = {
+            "top": (0, col_centers[selected_col]),
+            "bottom": (h - 1, col_centers[selected_col]),
+            "left": (row_centers[left_row_idx], 0),
+            "right": (row_centers[right_row_idx], w - 1),
+        }
