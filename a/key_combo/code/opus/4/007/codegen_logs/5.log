+        for dest in ordinary:
+            _apply_stamp(
+                out,
+                static_mask,
+                ordinary_patch,
+                dest,
+                center_mode=center_mode,
+                preserve_static=preserve_static,
+            )
+        for dest in collisions:
+            _apply_stamp(
+                out,
+                static_mask,
+                collision_patch,
+                dest,
+                center_mode=center_mode,
+                preserve_static=preserve_static,
