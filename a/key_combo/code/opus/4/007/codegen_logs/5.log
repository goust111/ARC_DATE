+        cc = ac + PROJECTILE_DIST * direction[1]
+        if not in_bounds((h, w), rr, cc):
+            continue
+        landings[(rr, cc)] = landings.get((rr, cc), 0) + 1
+        directions.append(direction)
+    return landings, directions
