+def _stamp_cells(
+    patch: np.ndarray,
+    center: tuple[int, int],
+    shape: tuple[int, int],
+    *,
+    center_mode: str = "upper_left",
+) -> set[tuple[int, int]]:
+    ph, pw = patch.shape
+    cr, cc = center
+    if center_mode == "upper_left":
+        top = cr - ph // 2
+        left = cc - pw // 2
+    elif center_mode == "lower_right":
+        top = cr - (ph - 1) // 2
+        left = cc - (pw - 1) // 2
+    else:
