+            if np.array_equal(crop, np.rot90(crop, 2)):
+                continue
+            h, w = crop.shape
+            r0, c0, _r1, _c1 = b
+            if not ((h % 2 == 0 or w % 2 == 0) and (r0 > 0 or c0 > 0 or h == 1 or w == 1)):
