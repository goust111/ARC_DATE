+    mask = patch != BLACK
+    if preserve_static:
+        allow = np.ones_like(mask, dtype=bool)
+        h, w = out.shape
+        for pr in range(ph):
+            for pc in range(pw):
+                rr = top + pr
+                cc2 = left + pc
+                if in_bounds((h, w), rr, cc2) and static_mask[rr, cc2]:
