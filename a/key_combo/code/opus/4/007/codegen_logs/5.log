+def _expand_cells(cells: set[tuple[int, int]], shape: tuple[int, int], radius: int = 1) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
+        for rr in range(r - radius, r + radius + 1):
+            for cc in range(c - radius, c + radius + 1):
+                if in_bounds(shape, rr, cc):
