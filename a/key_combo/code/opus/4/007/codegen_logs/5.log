+    chosen.append(special_ordinary)
+    occupied_cells |= special_ordinary["cell_set"]
+    reserved_dests.add(special_ordinary["dest"])
+    protected_cells |= special_ordinary_footprint
+    used_stamp_cells |= special_ordinary_footprint
