+    paste(out, patch, top, left, transparent=BLACK, mask=mask, clip=True)
+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    template_patch: np.ndarray | None = None,
+    rotate_collision: bool = True,
+    preserve_static: bool = True,
