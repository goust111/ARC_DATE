+    ph, pw = patch.shape
+    cr, cc = center
+    if center_mode == "upper_left":
+        top = cr - ph // 2
+        left = cc - pw // 2
+    else:
+        top = cr - (ph - 1) // 2
+        left = cc - (pw - 1) // 2
