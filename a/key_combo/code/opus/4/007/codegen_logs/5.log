+    for pr, pc in np.argwhere(patch != BLACK):
+        rr = top + int(pr)
+        cc2 = left + int(pc)
+        if in_bounds(shape, rr, cc2):
+            out.add((rr, cc2))
+    return out
+
+
+def _apply_stamp(
+    out: np.ndarray,
+    static_mask: np.ndarray,
+    patch: np.ndarray,
+    center: tuple[int, int],
+    *,
+    center_mode: str = "upper_left",
+    preserve_static: bool = True,
