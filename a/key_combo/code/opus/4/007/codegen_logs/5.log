+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    template_patch: np.ndarray | None = None,
+    rotate_collision: bool = True,
+    preserve_static: bool = True,
+    collision_after_ordinary: bool = True,
+    center_mode: str = "upper_left",
