+def _collision_pairs_for_dest(
+    dest: tuple[int, int],
+    by_dest: dict[tuple[int, int], list[dict]],
+    occupied_cells: set[tuple[int, int]],
+    reserved_dests: set[tuple[int, int]],
+    protected_cells: set[tuple[int, int]],
+) -> list[tuple[dict, dict]]:
