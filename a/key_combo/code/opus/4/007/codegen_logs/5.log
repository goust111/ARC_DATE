+    placements_by_dest = _build_placements((h, w), forbidden_triangle_cells)
+    if not placements_by_dest:
+        return None
+
+    scenario = random.choice(
+        [(4, 1), (4, 1), (5, 1), (5, 1), (5, 1), (3, 1), (5, 2)]
+    )
