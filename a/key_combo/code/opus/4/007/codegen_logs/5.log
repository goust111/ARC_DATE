index 0000000000000000000000000000000000000000..933bdf6fc6b7c48e5be151563f3eaabdecb31860
--- /dev/null
+++ b//home/lixinyu/snap/a/key_combo/code/opus/4/007/5.py
@@ -0,0 +1,667 @@
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+PROJECTILE_DIST = 5
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+GRID_H_RANGE = (18, 25)
+GRID_W_RANGE = (18, 25)
+GEN_RETRIES = 400
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, b: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = b
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+    mask: np.ndarray | None = None,
+    clip: bool = False,
+) -> np.ndarray:
+    h, w = dst.shape
+    ph, pw = patch.shape
+    if not clip:
+        if r0 < 0 or c0 < 0 or r0 + ph > h or c0 + pw > w:
+            raise ValueError("paste out of bounds")
+        rr0, cc0 = r0, c0
+        rr1, cc1 = r0 + ph, c0 + pw
+        pr0, pc0 = 0, 0
+    else:
+        rr0 = max(0, r0)
+        cc0 = max(0, c0)
+        rr1 = min(h, r0 + ph)
+        cc1 = min(w, c0 + pw)
+        if rr0 >= rr1 or cc0 >= cc1:
+            return dst
+        pr0 = rr0 - r0
+        pc0 = cc0 - c0
+    pr1 = pr0 + (rr1 - rr0)
+    pc1 = pc0 + (cc1 - cc0)
+    dst_view = dst[rr0:rr1, cc0:cc1]
+    patch_view = patch[pr0:pr1, pc0:pc1]
+    use = np.ones_like(patch_view, dtype=bool)
+    if mask is not None:
+        use &= mask[pr0:pr1, pc0:pc1].astype(bool)
+    if transparent is not None:
+        use &= patch_view != transparent
+    dst_view[use] = patch_view[use]
+    return dst
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dirs = DIR4 if connectivity == 4 else DIR8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _connected_cells(cells: set[tuple[int, int]], dirs: list[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    stack = [next(iter(cells))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in dirs:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
