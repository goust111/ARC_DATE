+
+def _template_red_cells(full_patch: np.ndarray, top_left: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0 = top_left
+    return {
+        (r0 + int(r), c0 + int(c))
+        for r, c in np.argwhere(full_patch == RED)
+    }
