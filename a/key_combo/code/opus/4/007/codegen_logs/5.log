+def _connected_cells(cells: set[tuple[int, int]], dirs: list[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    stack = [next(iter(cells))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in dirs:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return seen == cells
