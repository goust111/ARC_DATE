+
+def _build_placements(
+    shape: tuple[int, int],
+    forbidden_cells: set[tuple[int, int]],
+) -> dict[tuple[int, int], list[dict]]:
+    h, w = shape
+    by_dest: dict[tuple[int, int], list[dict]] = {}
