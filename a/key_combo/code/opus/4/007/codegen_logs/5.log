+def paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+    mask: np.ndarray | None = None,
+    clip: bool = False,
+) -> np.ndarray:
+    h, w = dst.shape
+    ph, pw = patch.shape
