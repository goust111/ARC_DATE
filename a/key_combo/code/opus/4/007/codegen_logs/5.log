+def _apply_stamp(
+    out: np.ndarray,
+    static_mask: np.ndarray,
+    patch: np.ndarray,
+    center: tuple[int, int],
+    *,
+    center_mode: str = "upper_left",
+    preserve_static: bool = True,
+) -> None:
+    ph, pw = patch.shape
+    cr, cc = center
+    if center_mode == "upper_left":
+        top = cr - ph // 2
+        left = cc - pw // 2
+    else:
+        top = cr - (ph - 1) // 2
+        left = cc - (pw - 1) // 2
