+    ordinary_events = n_sprites - 2 * collision_events
+
+    occupied_cells: set[tuple[int, int]] = set()
+    reserved_dests = set(template_box)
+    protected_cells = set(template_box)
+    used_stamp_cells: set[tuple[int, int]] = set()
