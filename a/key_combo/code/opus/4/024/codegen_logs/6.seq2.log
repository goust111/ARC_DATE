+def _make_patch(mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.full(mask.shape, INPUT_BG, dtype=int)
+    patch[mask] = color
+    return patch
+
+
+def _bbox_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (
