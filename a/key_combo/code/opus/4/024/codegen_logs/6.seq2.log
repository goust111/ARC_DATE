+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+INPUT_BG = 5
+OUTPUT_BG = 0
+OBJECT_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ROW_RANGE = (11, 16)
+GEN_COL_RANGE = (13, 18)
+GEN_OBJECT_COUNT = (3, 4)
+GEN_ATTEMPTS = 400
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
