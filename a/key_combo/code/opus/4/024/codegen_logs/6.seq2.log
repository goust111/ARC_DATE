+            view = grid[r0 : r0 + ph, c0 : c0 + pw]
+            if np.any(view != INPUT_BG):
+                continue
+            view[patch != INPUT_BG] = patch[patch != INPUT_BG]
+            reserved.append(bbox)
+            placed = True
+            break
+
+        if not placed:
+            return None
+
+    return grid
+
+
+def _object_summary(grid: np.ndarray) -> list[tuple[int, tuple[int, int, int, int], str, np.ndarray]]:
