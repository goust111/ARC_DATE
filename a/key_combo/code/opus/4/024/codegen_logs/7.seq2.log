+
+def _row_groups(grid: np.ndarray, bg: int = BG) -> list[tuple[int, int]]:
+    occupied = np.any(grid != bg, axis=1)
+    groups: list[tuple[int, int]] = []
+    r = 0
+    while r < grid.shape[0]:
+        if not occupied[r]:
