+def _column_states(block: np.ndarray, bg: int = BG) -> list[tuple[int, ...]]:
+    states: list[tuple[int, ...]] = []
+    for c in range(block.shape[1]):
+        states.append(tuple(int(r) for r in np.flatnonzero(block[:, c] != bg)))
+    return states
