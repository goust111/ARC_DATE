+def _all_far(cells: list[tuple[int, int]], used: list[tuple[int, int]]) -> bool:
+    for r0, c0 in cells:
+        for r1, c1 in used:
+            if max(abs(r0 - r1), abs(c0 - c1)) <= 1:
+                return False
+    return True
+
