+            for r in range(height)
+            for c in range(width)
+            if (r, c) not in used and _all_far([(r, c)], used)
+        ]
+    if not candidates:
+        return None
+    return candidates[int(RNG.integers(len(candidates)))]
+
+
+def _is_valid_input(grid: np.ndarray) -> bool:
