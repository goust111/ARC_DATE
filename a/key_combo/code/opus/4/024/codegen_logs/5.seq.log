    out_colors = set(_colors_present(brute, exclude={BG}))
    if out_colors != {INPUT_COLORS[0], INPUT_COLORS[1], CONFLICT}:
        return False

    yellow_count = int(np.count_nonzero(brute == CONFLICT))
    occupied_count = int(np.count_nonzero(brute != BG))
