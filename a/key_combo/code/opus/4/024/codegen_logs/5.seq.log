+    fg_coords = np.argwhere(g != BG)
+    for k in range(min(2 * height, 2 * width)):
+        for r, c in fg_coords:
+            rr = int(r) + k
+            cc = int(c) + k
+            if rr >= out.shape[0] or cc >= out.shape[1]:
+                continue
+            color = int(g[int(r), int(c)])
+            prev = int(out[rr, cc])
+            if prev == BG:
+                out[rr, cc] = color
+            elif prev == color or prev == CONFLICT:
+                continue
+            else:
+                out[rr, cc] = CONFLICT
+
+    return out
