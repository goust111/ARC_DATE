+    border = np.zeros((h, w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    assert np.array_equal(sub == Color.BLUE, border), "blue pixels must form one hollow rectangle"
+    return int(r0), int(c0), int(r1), int(c1)
