def _gen_touches_true_corner(r0: int, c0: int, h: int, w: int, n: int) -> bool:
    top = r0 == 0
    bottom = r0 + h - 1 == n - 1
    left = c0 == 0
    right = c0 + w - 1 == n - 1
    return (top and left) or (top and right) or (bottom and right) or (bottom and left)


def _gen_blob_patch(color: int) -> np.ndarray:
