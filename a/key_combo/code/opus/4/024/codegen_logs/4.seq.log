+            length = seg_idx + 2
+            dr, dc = _DIRS[seg_idx % 4]
+            color = horiz_color if dr == 0 else vert_color
+            blocked = False
+
+            for _ in range(length):
+                nr = current[0] + dr
+                nc = current[1] + dc
+                if not in_bounds(out.shape, nr, nc):
+                    stop_reason = "boundary"
+                    blocked = True
+                    break
