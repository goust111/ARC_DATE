+
+    if np.array_equal(expected, _alternative_output(grid, use_outer_starts=False)):
+        return False
+    if np.array_equal(expected, _alternative_output(grid, block_frame=False)):
+        return False
+    return True
+
+
+def _build_grid(
+    height: int,
+    width: int,
+    top: int,
+    bottom: int,
+    left: int,
+    right: int,
