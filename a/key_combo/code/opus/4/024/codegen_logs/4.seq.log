+        "TR": (r0 + 1, c1 - 1),
+        "BR": (r1 - 1, c1 - 1),
+        "BL": (r1 - 1, c0 + 1),
+    }
+
+
+def _outer_corners(frame_bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
+    r0, c0, r1, c1 = frame_bbox
+    return {
+        "TL": (r0 - 1, c0 - 1),
+        "TR": (r0 - 1, c1 + 1),
+        "BR": (r1 + 1, c1 + 1),
+        "BL": (r1 + 1, c0 - 1),
+    }
+
+
+def _validate_input(grid: np.ndarray) -> tuple[tuple[int, int, int, int], int, int]:
+    g = np.asarray(grid, dtype=int)
