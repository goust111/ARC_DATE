+    return _render_from_head(cycle)
+
+
+def _marker_patch(missing: str) -> np.ndarray:
+    patch = np.full((2, 2), GREY, dtype=int)
+    mr, mc = MISSING_OFFSETS[missing]
+    patch[mr, mc] = BLACK
