+def _touches_existing(cells: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in cells:
+        if (r, c) in occupied:
+            return True
+        for dr, dc in NEIGHBORS4:
+            if (r + dr, c + dc) in occupied:
+                return True
+    return False
+
