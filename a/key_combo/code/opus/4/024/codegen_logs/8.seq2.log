+
+def _place_corner_patch(grid: np.ndarray, corner: str, patch: np.ndarray) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    r0, c0 = _corner_anchor(corner, h, w, ph, pw)
