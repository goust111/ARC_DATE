+            dists = np.abs(coords[:, 0] - rr) + np.abs(coords[:, 1] - cc)
+            if int(np.sum(dists == dists.min())) >= 2:
+                return True
+    return False
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(11, 16)
+    w = random.randint(11, 16)
+    grid = np.zeros((h, w), dtype=int)
