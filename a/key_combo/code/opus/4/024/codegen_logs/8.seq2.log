+    distractors: list[dict] = []
+    for comp in comps:
+        corner = _bbox_corner(comp["bbox"], h, w)
+        if corner is None:
+            distractors.append(comp)
+        else:
+            corner_map[corner] = comp
+    return {"components": comps, "corners": corner_map, "distractors": distractors}
