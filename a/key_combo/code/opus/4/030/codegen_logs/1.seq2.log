+    right = np.zeros((MASK_SIZE, MASK_SIZE), dtype=int)
+    left[state == 1] = PANEL_ACTIVE
+    right[state == 2] = PANEL_ACTIVE
+    left[state == 3] = PANEL_ACTIVE
+    right[state == 3] = PANEL_ACTIVE
+
+    nor_mask = state == 0
+    if np.unique(state).size != 4:
+        return None
