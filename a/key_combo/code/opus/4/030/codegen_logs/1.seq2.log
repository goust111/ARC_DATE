+    if len(np.unique(sprite)) != color_count:
+        return _sample_sprite()
+    if len({tuple(row) for row in sprite}) == 1:
+        return _sample_sprite()
+    if len({tuple(col) for col in sprite.T}) == 1:
+        return _sample_sprite()
+    return sprite
