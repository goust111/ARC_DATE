+    top = grid[sep_r - MASK_H : sep_r, c0 : c1 + 1].copy()
+    bottom = grid[sep_r + 1 : sep_r + 1 + MASK_H, c0 : c1 + 1].copy()
+    valid_panel = {Color.BLACK, Color.RED}
+    assert set(map(int, np.unique(top))) <= valid_panel
