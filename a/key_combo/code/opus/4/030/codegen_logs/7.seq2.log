+def _mirror_coords(
+    coords: list[tuple[int, int]], cross_r: int, cross_c: int, flip_v: bool, flip_h: bool
+) -> list[tuple[int, int]]:
+    mirrored = []
+    for r, c in coords:
+        rr = 2 * cross_r - r if flip_v else r
+        cc = 2 * cross_c - c if flip_h else c
+        mirrored.append((rr, cc))
