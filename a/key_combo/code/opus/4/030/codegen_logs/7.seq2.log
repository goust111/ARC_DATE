+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _component_count(mask: np.ndarray) -> int:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return 0
+
+    cells = {tuple(map(int, rc)) for rc in coords}
+    count = 0
+    while cells:
+        count += 1
+        start = cells.pop()
+        queue = deque([start])
+        while queue:
+            r, c = queue.popleft()
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in cells:
+                    cells.remove((nr, nc))
+                    queue.append((nr, nc))
+    return count
+
