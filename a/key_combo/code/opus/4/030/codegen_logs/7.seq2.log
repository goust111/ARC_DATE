+    src = (lt != BG) & (lt != cross_color) & (lt != LEGEND_BORDER)
+    src[:3, :3] = False
+    mask[:cross_r, :cross_c] = src
+    assert np.any(src), "expected a source pattern in the upper-left quadrant"
+    return mask
+
