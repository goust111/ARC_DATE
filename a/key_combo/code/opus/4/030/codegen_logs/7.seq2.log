+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+LEGEND_BORDER = 5
+FILTER_PALETTE = (2, 3, 4, 6)
+CROSS_COLORS = (1, 8, 9)
+GRID_SIZES = (13, 15, 17, 19)
+MAX_RETRIES = 400
