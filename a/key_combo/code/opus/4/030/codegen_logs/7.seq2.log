+        return False
+    if np.any(expected[:3, :3] == LEGEND_BORDER) or np.any(np.isin(expected[:2, :2], targets)):
+        return False
+
+    if not np.array_equal(main(grid), expected):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
