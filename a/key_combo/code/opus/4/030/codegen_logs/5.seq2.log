+TOPOLOGIES = [
+    {
+        "name": "vertical_split",
+        "segments": [
+            ((0, 0), (0, 1)),
+            ((0, 1), (0, 2)),
+            ((1, 0), (1, 1)),
+            ((1, 1), (1, 2)),
+            ((0, 0), (1, 0)),
+            ((0, 1), (1, 1)),
+            ((0, 2), (1, 2)),
+        ],
+        "regions": [(0, 1, 0, 1), (0, 1, 1, 2)],
+        "equal_pair": (0, 1),
+        "compact_equal_axis": "cols",
+    },
+    {
+        "name": "horizontal_split",
+        "segments": [
+            ((0, 0), (0, 1)),
+            ((1, 0), (1, 1)),
