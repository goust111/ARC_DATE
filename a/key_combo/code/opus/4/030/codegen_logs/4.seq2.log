+        return None
+
+    top = random.randint(MARGIN_MIN, h - frame_h - MARGIN_MIN)
+    left = random.randint(MARGIN_MIN, w - frame_w - MARGIN_MIN)
+    frame_bbox = (top, left, top + frame_h - 1, left + frame_w - 1)
