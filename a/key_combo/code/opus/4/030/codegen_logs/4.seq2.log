+    if h == 3 and w in (3, 4):
+        col_sums = patch.sum(axis=0)
+        cross_cols = [idx for idx, total in enumerate(col_sums) if int(total) == 3]
+        if (
+            len(cross_cols) == 1
+            and np.all(patch[1, :])
+            and area == w + 2
+            and sorted(int(x) for x in col_sums) == [1] * (w - 1) + [3]
