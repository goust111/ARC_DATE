+def _oracle_from_plan(grid: np.ndarray, placements: list[dict]) -> np.ndarray:
+    out = grid.copy()
+    for item in placements:
+        out[item["hit"]] = item["color"]
+        out[item["opposite"]] = BACKGROUND
+        for point in item["ray_points"]:
