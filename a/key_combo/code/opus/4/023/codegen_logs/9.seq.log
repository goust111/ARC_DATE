+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+
+
+COLOR_BY_COUNT = {
+    0: Color.GREEN,
+    1: Color.YELLOW,
+    2: Color.RED,
+    3: Color.BLUE,
+}
