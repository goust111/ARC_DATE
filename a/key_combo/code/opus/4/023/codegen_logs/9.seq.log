+    total_frames = 3 if k == 3 else (3 if rng.random() < 0.7 else 2)
+    need_distractors = total_frames - k
+    require_multi_hit = need_distractors == 0
+    selected = _search_non_overlapping(
+        selected_pool,
+        k,
+        rng,
+        require_multi_hit=require_multi_hit,
