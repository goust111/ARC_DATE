+        return None
+
+    distractors: list[dict] = []
+    if need_distractors == 1:
+        pools = [old_pool, border_pool] if rng.random() < 0.5 else [border_pool, old_pool]
+        chosen = None
+        for pool in pools:
+            chosen = _search_non_overlapping(pool, 1, rng, blocked=selected)
+            if chosen is not None:
