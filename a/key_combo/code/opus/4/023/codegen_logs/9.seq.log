+        if chosen is None:
+            return None
+        distractors = chosen
+    elif need_distractors == 2:
+        first_old = _search_non_overlapping(old_pool, 1, rng, blocked=selected)
+        if first_old is not None:
+            second_border = _search_non_overlapping(border_pool, 1, rng, blocked=selected + first_old)
