+def _frame_border_set(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    border: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+    return border
+
