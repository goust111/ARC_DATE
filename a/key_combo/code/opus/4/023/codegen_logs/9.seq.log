+    frames = selected + distractors
+    grid = _build_grid((h, w), old_line, frames)
+    _semantic_checks(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt(rng)
+        if grid is not None:
