+def _far_enough(candidate: dict, chosen: list[dict]) -> bool:
+    return all(
+        max(abs(int(candidate["r"]) - int(other["r"])), abs(int(candidate["c"]) - int(other["c"]))) >= 2
+        for other in chosen
+    )
