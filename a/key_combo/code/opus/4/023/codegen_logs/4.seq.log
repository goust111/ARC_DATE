+def _ray_hits(obstacle_ids: np.ndarray, r: int, c: int) -> tuple[int, int, int, int]:
+    h, w = obstacle_ids.shape
+    hits = []
+    for dr, dc in DIAGONALS:
+        rr, cc = int(r) + dr, int(c) + dc
+        hit = 0
+        while 0 <= rr < h and 0 <= cc < w:
+            oid = int(obstacle_ids[rr, cc])
+            if oid:
