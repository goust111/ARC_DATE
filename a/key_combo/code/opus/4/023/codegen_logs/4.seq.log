+            cc0, cc1 = max(0, c0 - 1), min(w, c0 + ow + 1)
+            if blocked[rr0:rr1, cc0:cc1].any():
+                continue
+            grid[r0 : r0 + oh, c0 : c0 + ow] = OBSTACLE
+            ids[r0 : r0 + oh, c0 : c0 + ow] = oid
+            blocked[r0 : r0 + oh, c0 : c0 + ow] = True
