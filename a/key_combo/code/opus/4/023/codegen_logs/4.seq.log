+def _obstacle_ids(grid: np.ndarray) -> np.ndarray:
+    ids = np.zeros_like(grid, dtype=int)
+    for i, coords in enumerate(_components(grid == OBSTACLE), start=1):
+        ids[coords[:, 0], coords[:, 1]] = i
+    return ids
+
