+        assert int(coords.shape[0]) == h * w, "each obstacle must be solid"
+        assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == OBSTACLE), "obstacle bbox must be fully grey"
+        boxes.append(box)
