        cols = np.flatnonzero(inp[r] != BACKGROUND_COLOR)
        if cols.size == 0:
            return None

        c0, c1 = int(cols[0]), int(cols[-1])
        color = int(inp[r, c0])
        if (
            not np.all(inp[r, c0 : c1 + 1] == color)
            or np.any(inp[r, :c0] != BACKGROUND_COLOR)
            or np.any(inp[r, c1 + 1 :] != BACKGROUND_COLOR)
        ):
