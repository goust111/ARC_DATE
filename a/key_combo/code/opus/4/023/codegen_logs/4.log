        r1 = r + 1
        while r1 < inp.shape[0] and np.array_equal(inp[r1], inp[r]):
            r1 += 1

        if obj_i % RECOLOR_PERIOD == 0:
            out[r:r1, c0 : c1 + 1] = RECOLOR_COLOR

        r = r1
        obj_i += 1

