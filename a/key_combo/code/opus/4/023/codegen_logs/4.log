+from arc_utils import Color, bbox_coords, components_mask, in_bounds
+
+
+BACKGROUND = Color.BLACK
+LEGEND_COLORS = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW)
+OBSTACLE = Color.GREY
+SEED = Color.TEAL
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+
+GRID_H_RANGE = (14, 20)
+GRID_W_RANGE = (16, 22)
+LEGEND_LENGTHS = (3, 4)
+OBSTACLE_COUNT_RANGE = (3, 5)
+SEED_COUNT_RANGE = (3, 5)
+MAX_GENERATION_ATTEMPTS = 500
+MAX_PLACEMENT_ATTEMPTS = 120
+
+
+def _legend_info(grid: np.ndarray) -> tuple[int, tuple[int, ...]]:
+    row = np.asarray(grid[0], dtype=int)
+    nz = np.flatnonzero(row != BACKGROUND)
+    assert nz.size in LEGEND_LENGTHS, "legend must occupy 3 or 4 cells in the top row"
+    assert int(nz[-1] - nz[0] + 1) == int(nz.size), "legend must be contiguous"
+    c0 = int(nz[0])
+    colors = tuple(map(int, row[c0 : c0 + nz.size]))
+    assert colors == LEGEND_COLORS[: len(colors)], "legend colors must follow the fixed left-to-right order"
+    assert int((row != BACKGROUND).sum()) == len(colors), "top row must contain only the legend"
+    return c0, colors
+
+
+def _obstacle_bboxes(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    boxes: list[tuple[int, int, int, int]] = []
+    for coords in components_mask(grid == OBSTACLE, connectivity=4):
+        box = bbox_coords(coords)
+        r0, c0, r1, c1 = box
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        assert 2 <= h <= 3 and 2 <= w <= 4, "each obstacle must be a 2x2 to 3x4 rectangle"
+        assert int(coords.shape[0]) == h * w, "each obstacle must be solid"
+        assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == OBSTACLE), "obstacle bbox must be fully grey"
+        boxes.append(box)
+    assert OBSTACLE_COUNT_RANGE[0] <= len(boxes) <= OBSTACLE_COUNT_RANGE[1], "expected 3-5 obstacles"
+    return boxes
+
+
+def _seed_list(grid: np.ndarray) -> list[tuple[int, int]]:
+    seeds = [(int(r), int(c)) for r, c in np.argwhere(grid == SEED)]
+    assert SEED_COUNT_RANGE[0] <= len(seeds) <= SEED_COUNT_RANGE[1], "expected 3-5 seeds"
+    return seeds
+
+
+def _ray_hits_obstacle(grid: np.ndarray, start: tuple[int, int], direction: tuple[int, int]) -> int:
+    r, c = map(int, start)
+    dr, dc = map(int, direction)
+    while True:
+        r += dr
+        c += dc
+        if not in_bounds(grid.shape, r, c):
+            return 0
+        if int(grid[r, c]) == OBSTACLE:
+            return 1
+
+
+def _collision_count(grid: np.ndarray, seed: tuple[int, int]) -> int:
+    return sum(_ray_hits_obstacle(grid, seed, direction) for direction in DIAGONALS)
+
+
+def _expected_output(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    legend_c0, legend = _legend_info(g)
+    _obstacle_bboxes(g)
+    seeds = _seed_list(g)
+
+    out = g.copy()
+    out[0, legend_c0 : legend_c0 + len(legend)] = BACKGROUND
+
+    counts = []
+    for seed in seeds:
+        count = _collision_count(g, seed)
+        assert 1 <= count <= len(legend), "seed collision count must be a valid legend index"
+        counts.append(count)
+        r, c = seed
+        out[r, c] = legend[count - 1]
+
+    assert len(set(counts)) >= 2, "different seeds must realize at least two collision counts"
+    return out
+
+
+def _validate_scene(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+    assert max(g.shape) <= 30, "grid must fit ARC size bounds"
+    legend_c0, legend = _legend_info(g)
+    boxes = _obstacle_bboxes(g)
+    seeds = _seed_list(g)
+
+    allowed = set(legend) | {BACKGROUND, OBSTACLE, SEED}
+    assert set(map(int, np.unique(g))) <= allowed, "scene may only contain background, legend, obstacles, and seeds"
+    assert np.all(g[1:, legend_c0 : legend_c0 + len(legend)] != np.array(legend)[None, :]), "legend must be unique"
+
+    for r0, c0, r1, c1 in boxes:
+        assert r0 >= 2 and c0 >= 1 and r1 < g.shape[0] - 1 and c1 < g.shape[1] - 1, (
+            "obstacles should stay away from the outer border"
+        )
+
+    counts = []
+    for r, c in seeds:
+        assert r > 0, "seeds must not overlap the legend row"
+        assert int(g[r, c]) == SEED
+        count = _collision_count(g, (r, c))
+        assert 1 <= count <= len(legend), "every seed must have a non-zero in-range collision count"
+        counts.append(count)
+    assert len(set(counts)) >= 2, "scene must contain at least two different collision totals"
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each cyan seed by indexing the top-row legend with its diagonal-ray obstacle collision count.
+
+    Input structure:
+    - Black background fills the grid.
+    - The top row contains one contiguous horizontal legend of length 3 or 4 whose colors are blue, red, green, then optionally yellow.
+    - Elsewhere the grid contains several solid grey rectangular obstacles and several isolated cyan seed pixels.
+
+    Rule:
+    - For every cyan seed, cast four rays from that seed along the diagonal directions up-left, up-right, down-left, and down-right.
+    - Each ray advances cell by cell and stops at the first grey obstacle pixel it meets or when it leaves the grid; only obstacle stops count as collisions.
+    - Sum the four per-direction collisions to obtain a count C, use C as a 1-indexed position into the legend, and recolor the seed to that legend color.
+    - Do not draw the rays, keep every grey obstacle unchanged, and erase the legend back to black.
+
+    Key insight:
+    - The geometry of which diagonals reach an obstacle produces a small discrete count, and the legend converts that count into the output color.
+    """
+    g = np.asarray(grid, dtype=int)
+    legend_c0, legend = _legend_info(g)
+
+    out = g.copy()
+    out[0, legend_c0 : legend_c0 + len(legend)] = BACKGROUND
+    for r, c in np.argwhere(g == SEED):
+        count = _collision_count(g, (int(r), int(c)))
+        assert 1 <= count <= len(legend), "seed collision count must be a valid legend index"
+        out[r, c] = legend[count - 1]
+    return out
+
+
+def _touches_obstacle_cardinal(grid: np.ndarray, r: int, c: int) -> bool:
+    for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+        if in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == OBSTACLE:
+            return True
+    return False
+
+
+def _count_buckets(grid: np.ndarray, legend_len: int) -> dict[int, list[tuple[int, int]]]:
+    buckets = {count: [] for count in range(1, legend_len + 1)}
+    for r in range(1, grid.shape[0]):
+        for c in range(grid.shape[1]):
+            if int(grid[r, c]) != BACKGROUND:
+                continue
+            if _touches_obstacle_cardinal(grid, r, c):
+                continue
+            count = _collision_count(grid, (r, c))
+            if 1 <= count <= legend_len:
+                buckets[count].append((r, c))
+    return buckets
+
+
+def _far_enough(cell: tuple[int, int], chosen: list[tuple[int, int]], min_chebyshev: int = 2) -> bool:
+    return all(
+        max(abs(cell[0] - other[0]), abs(cell[1] - other[1])) >= min_chebyshev for other in chosen
+    )
+
+
+def _choose_seed_counts(available: list[int], n_seeds: int) -> list[int]:
+    high = max(available)
+    low = 1 if 1 in available else min(available)
+    counts = [high, low]
+
+    middle = [count for count in available if count not in {high, low}]
+    if middle and n_seeds >= 3:
+        counts.append(random.choice(middle))
+
+    weights = [count * count for count in available]
+    while len(counts) < n_seeds:
+        counts.append(random.choices(available, weights=weights, k=1)[0])
+    random.shuffle(counts)
+    return counts[:n_seeds]
+
+
+def _pick_seeds(buckets: dict[int, list[tuple[int, int]]], n_seeds: int) -> list[tuple[int, int]] | None:
+    available = [count for count, pts in buckets.items() if pts]
+    if len(available) < 2 or max(available) < 3 or 1 not in available:
+        return None
+
+    for _ in range(80):
+        chosen: list[tuple[int, int]] = []
+        targets = _choose_seed_counts(available, n_seeds)
+        local_buckets = {count: random.sample(pts, len(pts)) for count, pts in buckets.items()}
+
+        ok = True
+        for target in targets:
+            placed = False
+            for cell in local_buckets[target]:
+                if _far_enough(cell, chosen):
+                    chosen.append(cell)
+                    placed = True
+                    break
+            if not placed:
+                ok = False
+                break
+        if ok and len({targets[i] for i in range(len(chosen))}) >= 2:
+            return chosen
+    return None
+
+
+def _obstacle_quadrants(boxes: list[tuple[int, int, int, int]], H: int, W: int) -> set[tuple[int, int]]:
+    quads: set[tuple[int, int]] = set()
+    for r0, c0, r1, c1 in boxes:
+        cr = (r0 + r1) / 2.0
+        cc = (c0 + c1) / 2.0
+        quads.add((int(cr >= H / 2), int(cc >= W / 2)))
+    return quads
+
+
+def _place_obstacles(grid: np.ndarray, n_obstacles: int) -> list[tuple[int, int, int, int]] | None:
+    H, W = grid.shape
+    candidates = []
+    for h in (2, 3):
+        for w in (2, 3, 4):
+            for r0 in range(2, H - h - 1):
+                for c0 in range(1, W - w - 1):
+                    candidates.append((r0, c0, h, w))
+    random.shuffle(candidates)
+
+    reserved = np.zeros_like(grid, dtype=bool)
+    reserved[0, :] = True
+    boxes: list[tuple[int, int, int, int]] = []
+
+    for r0, c0, h, w in candidates:
+        r1 = r0 + h - 1
+        c1 = c0 + w - 1
+        rr0 = max(0, r0 - 1)
+        cc0 = max(0, c0 - 1)
+        rr1 = min(H - 1, r1 + 1)
+        cc1 = min(W - 1, c1 + 1)
+        if reserved[rr0 : rr1 + 1, cc0 : cc1 + 1].any():
+            continue
+        reserved[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+        grid[r0 : r1 + 1, c0 : c1 + 1] = OBSTACLE
+        boxes.append((r0, c0, r1, c1))
+        if len(boxes) == n_obstacles:
+            break
+
+    if len(boxes) != n_obstacles:
+        return None
+    if len(_obstacle_quadrants(boxes, H, W)) < 3:
+        return None
+    return boxes
+
+
+def _build_scene() -> np.ndarray | None:
+    H = random.randint(*GRID_H_RANGE)
+    W = random.randint(*GRID_W_RANGE)
+    legend_len = random.choice(LEGEND_LENGTHS)
+    n_obstacles = random.randint(*OBSTACLE_COUNT_RANGE)
+    n_seeds = random.randint(*SEED_COUNT_RANGE)
+
+    grid = np.full((H, W), BACKGROUND, dtype=int)
+    legend_c0 = random.randint(1, W - legend_len - 1)
+    grid[0, legend_c0 : legend_c0 + legend_len] = np.array(LEGEND_COLORS[:legend_len], dtype=int)
+
+    boxes = _place_obstacles(grid, n_obstacles)
+    if boxes is None:
+        return None
+
+    buckets = _count_buckets(grid, legend_len)
+    seeds = _pick_seeds(buckets, n_seeds)
+    if seeds is None:
+        return None
+
+    for r, c in seeds:
+        grid[r, c] = SEED
+
+    counts = [_collision_count(grid, seed) for seed in seeds]
+    if len(set(counts)) < 2 or min(counts) < 1 or max(counts) > legend_len:
+        return None
+    if max(counts) < 3:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _build_scene()
+        if grid is None:
+            continue
+        try:
+            _validate_scene(grid)
+            expected = _expected_output(grid)
+            actual = main(grid)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected) and not np.array_equal(grid, expected):
+            return grid
+    raise RuntimeError("failed to generate a valid ray-collision legend scene")

