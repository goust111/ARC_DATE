+    for top in row_choices:
+        mirrored_top = cell_h - shape_h - top
+        if top == mirrored_top:
+            continue
+        for left in col_choices:
+            mirrored_left = cell_w - shape_w - left
+            if left == mirrored_left:
+                continue
+            base = np.zeros((cell_h, cell_w), dtype=bool)
+            base[top : top + shape_h, left : left + shape_w] = shape
+            variants = [_map_to_position(base, (0, 0), pos) for pos in POSITIONS]
+            if len({variant.tobytes() for variant in variants}) == 4:
+                return base
+    return None
+
