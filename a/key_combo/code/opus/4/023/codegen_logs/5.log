+from __future__ import annotations
+
+from importlib.machinery import SourceFileLoader
+from pathlib import Path
+
+import numpy as np
+
+try:
+    from arc_utils import Color, bbox_coords, components_mask
+except Exception:
+    _ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
+    _ARC_UTILS = SourceFileLoader("_arc_utils_023_5", str(_ARC_UTILS_PATH)).load_module()
+    Color = _ARC_UTILS.Color
+    bbox_coords = _ARC_UTILS.bbox_coords
+    components_mask = _ARC_UTILS.components_mask
+
+
+BG = int(Color.BLACK)
+DIVIDER = int(Color.ORANGE)
+OBJECT_COLORS = (int(Color.BLUE), int(Color.RED), int(Color.GREEN))
+POSITIONS = ((0, 0), (0, 1), (1, 0), (1, 1))
+GEN_RETRIES = 400
+
+
+def _divider_indices(grid: np.ndarray) -> tuple[int, int]:
+    divider_rows = np.where(np.all(grid == DIVIDER, axis=1))[0]
+    divider_cols = np.where(np.all(grid == DIVIDER, axis=0))[0]
+    assert len(divider_rows) == 1 and len(divider_cols) == 1, "expected one full orange row and one full orange column"
+    return int(divider_rows[0]), int(divider_cols[0])
+
+
+def _cell_bounds(grid: np.ndarray) -> dict[tuple[int, int], tuple[int, int, int, int]]:
+    div_r, div_c = _divider_indices(grid)
+    assert 0 < div_r < grid.shape[0] - 1 and 0 < div_c < grid.shape[1] - 1, "divider must split the grid"
+    top_h = div_r
+    bot_h = grid.shape[0] - div_r - 1
+    left_w = div_c
+    right_w = grid.shape[1] - div_c - 1
+    assert top_h == bot_h and left_w == right_w, "the orange cross must split the grid into equal cells"
+    return {
+        (0, 0): (0, div_r, 0, div_c),
+        (0, 1): (0, div_r, div_c + 1, grid.shape[1]),
+        (1, 0): (div_r + 1, grid.shape[0], 0, div_c),
+        (1, 1): (div_r + 1, grid.shape[0], div_c + 1, grid.shape[1]),
+    }
+
+
+def _extract_cells(grid: np.ndarray) -> dict[tuple[int, int], np.ndarray]:
+    return {
+        pos: grid[r0:r1, c0:c1].copy()
+        for pos, (r0, r1, c0, c1) in _cell_bounds(grid).items()
+    }
+
+
+def _map_to_position(mask: np.ndarray, src: tuple[int, int], dst: tuple[int, int]) -> np.ndarray:
+    out = mask
+    if int(src[0]) != int(dst[0]):
+        out = np.flipud(out)
+    if int(src[1]) != int(dst[1]):
+        out = np.fliplr(out)
+    return out
+
+
+def _sprite_color(cell: np.ndarray) -> int | None:
+    colors = set(map(int, np.unique(cell))) - {BG, DIVIDER}
+    assert len(colors) <= 1, "each cell must contain at most one foreground color"
+    if not colors:
+        return None
+    return int(next(iter(colors)))
+
+
+def _cell_mask(cell: np.ndarray, color: int) -> np.ndarray:
+    mask = cell == int(color)
+    comps = components_mask(mask, connectivity=4)
+    assert len(comps) == 1, "each occupied cell must contain one connected sprite"
+    area = int(mask.sum())
+    assert 4 <= area <= 10, "sprite area must stay within the ARC task specification"
+    return mask
+
+
+def _infer_missing_mask(cells: dict[tuple[int, int], np.ndarray]) -> tuple[tuple[int, int], int, np.ndarray]:
+    present_masks: dict[tuple[int, int], np.ndarray] = {}
+    missing: tuple[int, int] | None = None
+    color: int | None = None
+    for pos, cell in cells.items():
+        cell_color = _sprite_color(cell)
+        if cell_color is None:
+            assert missing is None, "expected exactly one empty cell"
+            missing = pos
+            assert np.all(cell == BG), "the missing cell must be entirely black"
+            continue
+        assert cell_color in OBJECT_COLORS, "foreground color must be blue, red, or green"
+        if color is None:
+            color = cell_color
+        assert color == cell_color, "all present sprites must share one color"
+        present_masks[pos] = _cell_mask(cell, cell_color)
+
+    assert missing is not None and color is not None and len(present_masks) == 3, "expected three sprites and one empty cell"
+
+    predictions = [_map_to_position(mask, pos, missing) for pos, mask in present_masks.items()]
+    first = predictions[0]
+    for pred in predictions[1:]:
+        assert np.array_equal(pred, first), "all mirrored predictions for the missing cell must agree"
+    return missing, color, first
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete the missing mirrored sprite in a 2x2 orange-divided table, then compress the four cells to a 2x2 color summary.
+
+    Input structure:
+    - The background is black.
+    - A single full orange row and a single full orange column form a 2x2 table of equal-sized cells.
+    - Exactly three cells contain one connected monochrome sprite of area 4-10, and the fourth cell is entirely black.
+    - The three sprite colors are identical and come from blue, red, or green; their cell-local masks are horizontal and/or vertical mirror variants of one another.
+
+    Rule:
+    - Split the grid at the orange cross to obtain the four equal cells.
+    - Find the empty cell and mirror each present sprite into that cell's coordinate system by flipping vertically and/or horizontally according to relative cell position.
+    - The three mirrored predictions agree on one missing mask; paint that mask into the empty cell using the same color as the other three cells.
+    - Compress the now-complete 2x2 table to a 2x2 output whose entries are the unique non-black, non-orange colors of the four cells.
+
+    Key insight:
+    - The orange cross defines a mirror frame: three visible cell-local sprites determine the fourth by symmetry, and only after that completion does the compressed summary become fully non-black.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    cells = _extract_cells(g)
+    missing, color, inferred_mask = _infer_missing_mask(cells)
+
+    completed_cells = {pos: cell.copy() for pos, cell in cells.items()}
+    completed_cells[missing][inferred_mask] = int(color)
+
+    out = np.full((2, 2), BG, dtype=int)
+    for pos in POSITIONS:
+        summary = _sprite_color(completed_cells[pos])
+        assert summary is not None, "all cells must be non-empty after symmetry completion"
+        out[pos] = int(summary)
+    return out
+
+
+def _random_connected_shape(rng: np.random.Generator, max_h: int, max_w: int) -> np.ndarray | None:
+    max_h = min(int(max_h), 4)
+    max_w = min(int(max_w), 4)
+    if max_h < 2 or max_w < 2:
+        return None
+
+    for _ in range(80):
+        shape_h = int(rng.integers(2, max_h + 1))
+        shape_w = int(rng.integers(2, max_w + 1))
+        max_area = min(10, shape_h * shape_w)
+        if max_area < 4:
+            continue
+        area = int(rng.integers(4, max_area + 1))
+
+        cells = {(int(rng.integers(shape_h)), int(rng.integers(shape_w)))}
+        while len(cells) < area:
+            r, c = tuple(cells)[int(rng.integers(len(cells)))]
+            nbrs = []
+            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < shape_h and 0 <= cc < shape_w and (rr, cc) not in cells:
+                    nbrs.append((rr, cc))
+            if not nbrs:
+                break
+            cells.add(nbrs[int(rng.integers(len(nbrs)))])
+        if len(cells) != area:
+            continue
+
+        coords = np.array(sorted(cells), dtype=int)
+        r0, c0, r1, c1 = bbox_coords(coords)
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        if _is_asymmetric(mask):
+            return mask
+    return None
+
+
+def _is_asymmetric(mask: np.ndarray) -> bool:
+    return not (
+        np.array_equal(mask, np.flipud(mask))
+        or np.array_equal(mask, np.fliplr(mask))
+        or np.array_equal(mask, np.flipud(np.fliplr(mask)))
+    )
+
+
+def _embed_base_mask(
+    rng: np.random.Generator,
+    cell_h: int,
+    cell_w: int,
+) -> np.ndarray | None:
+    shape = _random_connected_shape(rng, cell_h - 2, cell_w - 2)
+    if shape is None:
+        return None
+
+    shape_h, shape_w = shape.shape
+    if cell_h - shape_h < 3 or cell_w - shape_w < 3:
+        return None
+
+    row_choices = list(range(1, cell_h - shape_h))
+    col_choices = list(range(1, cell_w - shape_w))
+    rng.shuffle(row_choices)
+    rng.shuffle(col_choices)
+
+    for top in row_choices:
+        mirrored_top = cell_h - shape_h - top
+        if top == mirrored_top:
+            continue
+        for left in col_choices:
+            mirrored_left = cell_w - shape_w - left
+            if left == mirrored_left:
+                continue
+            base = np.zeros((cell_h, cell_w), dtype=bool)
+            base[top : top + shape_h, left : left + shape_w] = shape
+            variants = [_map_to_position(base, (0, 0), pos) for pos in POSITIONS]
+            if len({variant.tobytes() for variant in variants}) == 4:
+                return base
+    return None
+
+
+def _build_grid(
+    cell_h: int,
+    cell_w: int,
+    color: int,
+    missing: tuple[int, int],
+    base_mask: np.ndarray,
+) -> np.ndarray:
+    grid = np.zeros((cell_h * 2 + 1, cell_w * 2 + 1), dtype=int)
+    grid[cell_h, :] = DIVIDER
+    grid[:, cell_w] = DIVIDER
+
+    bounds = _cell_bounds(grid)
+    for pos in POSITIONS:
+        if pos == missing:
+            continue
+        local = np.zeros((cell_h, cell_w), dtype=int)
+        local[_map_to_position(base_mask, (0, 0), pos)] = int(color)
+        r0, r1, c0, c1 = bounds[pos]
+        grid[r0:r1, c0:c1] = local
+    return grid
+
+
+def _naive_summary(grid: np.ndarray) -> np.ndarray:
+    cells = _extract_cells(grid)
+    out = np.full((2, 2), BG, dtype=int)
+    for pos in POSITIONS:
+        color = _sprite_color(cells[pos])
+        out[pos] = BG if color is None else int(color)
+    return out
+
+
+def _validate_instance(grid: np.ndarray) -> bool:
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+
+    try:
+        cells = _extract_cells(grid)
+        missing, color, inferred = _infer_missing_mask(cells)
+    except AssertionError:
+        return False
+
+    if color not in OBJECT_COLORS:
+        return False
+
+    present_masks = {}
+    for pos, cell in cells.items():
+        cell_color = _sprite_color(cell)
+        if cell_color is None:
+            continue
+        present_masks[pos] = _cell_mask(cell, cell_color)
+
+    if any(np.array_equal(mask, inferred) for mask in present_masks.values()):
+        return False
+
+    naive = _naive_summary(grid)
+    expected = np.full((2, 2), color, dtype=int)
+    if np.array_equal(naive, expected):
+        return False
+
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return False
+    return np.array_equal(actual, expected)
+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    cell_h = int(rng.integers(6, 11))
+    cell_w = int(rng.integers(6, 11))
+    color = int(rng.choice(np.array(OBJECT_COLORS, dtype=int)))
+    missing = POSITIONS[int(rng.integers(len(POSITIONS)))]
+
+    base_mask = _embed_base_mask(rng, cell_h, cell_w)
+    if base_mask is None:
+        return None
+
+    grid = _build_grid(cell_h, cell_w, color, missing, base_mask)
+    if _validate_instance(grid):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for ARC task 023/5")

