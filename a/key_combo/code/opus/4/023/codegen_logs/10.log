) -> list[int] | None:
    options = []
    for counts in _GEN_COUNT_OPTIONS:
        ok = True
        for region, count in zip(regions, counts):
            min_rows = count * _GEN_MIN_RECT_HEIGHT + (count - 1) * _GEN_MIN_ROW_GAP
            if _gen_region_capacity(region, split_type) < min_rows:
