+from __future__ import annotations
+
+import itertools
+
+import numpy as np
+
+
+BACKGROUND = 0
+DIVIDER = 6
+CELL_INTERIOR = 3
+COLOR_POOL = (1, 2, 3, 4, 5, 7, 8, 9)
+COUNT_TO_TURNS = {
+    0: 0,
+    1: 3,  # 90 degrees clockwise
+    2: 2,
+    4: 1,  # 90 degrees counterclockwise
+}
+GENERATION_RETRIES = 500
