+    vals = sorted(set(map(int, cell.ravel())) - {BACKGROUND})
+    assert DIVIDER not in vals, "divider color must not appear inside cells"
+    assert len(vals) == 1, "each cell must contain exactly one foreground color"
+    color = vals[0]
