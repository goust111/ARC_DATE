+            while q:
+                rr, cc = q.popleft()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and empty[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _foreground_objects(grid: np.ndarray) -> list[dict]:
+    objects = []
+    for color in sorted(int(x) for x in np.unique(grid) if x not in (BLACK, GREY)):
+        for coords in _components(grid == color):
+            box = _bbox(coords)
+            local = _crop(_mask_from_coords(grid.shape, coords), box)
+            objects.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": box,
+                    "holes": _hole_count(local),
+                }
+            )
+    return objects
+
+
+def _room_component(base: np.ndarray, coords: np.ndarray) -> np.ndarray:
+    room_mask = base != GREY
+    seed_r, seed_c = map(int, coords[0])
+    assert room_mask[seed_r, seed_c]
+    for comp in _components(room_mask):
+        if np.any((comp[:, 0] == seed_r) & (comp[:, 1] == seed_c)):
+            return comp
+    raise AssertionError("object room not found")
+
+
+def _slide_object(coords: np.ndarray, room_mask: np.ndarray, direction: tuple[int, int]) -> np.ndarray:
+    dr, dc = direction
+    moved = coords.copy()
+    h, w = room_mask.shape
+    while True:
+        trial = moved.copy()
+        trial[:, 0] += dr
+        trial[:, 1] += dc
+        if (
+            np.all((0 <= trial[:, 0]) & (trial[:, 0] < h) & (0 <= trial[:, 1]) & (trial[:, 1] < w))
+            and np.all(room_mask[trial[:, 0], trial[:, 1]])
+        ):
+            moved = trial
+        else:
+            return moved
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Slide each colored sprite through its grey-walled room in the direction encoded by the sprite's hole count.
+
+    Input structure:
+    - Black cells are background open floor and grey cells are single-cell walls that partition the canvas into rooms.
+    - Each occupied room contains exactly one 4-connected monochrome sprite in a unique non-black, non-grey color.
+    - Different sprites can have different numbers of enclosed black holes inside their own bounding boxes.
+
+    Rule:
+    - For each sprite, count its enclosed holes, where a hole is a black 4-connected region fully surrounded by that sprite inside the sprite's bounding box.
+    - Map hole count to slide direction: 0 -> up, 1 -> right, 2 -> down, 3 -> left.
+    - Erase the sprite's original cells to black, then slide the whole sprite step by step inside its own wall-bounded room until one more step would overlap a grey wall.
+    - Keep walls unchanged and place every moved sprite at its final stopping position.
+
+    Key insight:
+    - The motion signal is not carried by color; it is carried by topology, because the number of internal holes determines which way each sprite moves.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    objects = _foreground_objects(g)
+    assert objects, "expected at least one sprite"
+    assert all(obj["holes"] in HOLES_TO_DIRECTION for obj in objects), "unsupported hole count"
+
+    base = g.copy()
+    for obj in objects:
+        pts = obj["coords"]
+        base[pts[:, 0], pts[:, 1]] = BLACK
+
+    out = base.copy()
+    occupied = np.zeros(g.shape, dtype=bool)
+
+    for obj in objects:
+        room_coords = _room_component(base, obj["coords"])
+        room_mask = _mask_from_coords(g.shape, room_coords)
+        final_coords = _slide_object(obj["coords"], room_mask, HOLES_TO_DIRECTION[obj["holes"]])
+        assert not np.any(occupied[final_coords[:, 0], final_coords[:, 1]])
+        occupied[final_coords[:, 0], final_coords[:, 1]] = True
+        out[final_coords[:, 0], final_coords[:, 1]] = obj["color"]
+
+    return out
+
+
+TEMPLATES = {
+    0: [
+        ["111", "110"],
+        ["111", "010", "011"],
+        ["110", "011"],
+        ["1111", "0010"],
+    ],
+    1: [
+        ["111", "101", "111"],
+        ["1111", "1001", "1111"],
+        ["111", "101", "101", "111"],
+    ],
+    2: [
+        ["11111", "10101", "11111"],
+        ["11111", "10101", "10101", "11111"],
+        ["111111", "100101", "111111"],
+    ],
+    3: [
+        ["1111111", "1010101", "1111111"],
+        ["1111111", "1010101", "1010101", "1111111"],
+        ["11111111", "10010101", "11111111"],
+    ],
+}
+
+
+def _parse_template(rows: list[str]) -> np.ndarray:
+    return np.array([[1 if ch == "1" else 0 for ch in row] for row in rows], dtype=int)
+
+
+def _transform_shape(shape: np.ndarray, rng: np.random.Generator) -> np.ndarray:
+    out = shape.copy()
+    if rng.integers(2):
+        out = np.fliplr(out)
+    k = int(rng.integers(4))
+    out = np.rot90(out, k)
+    return out
+
+
+def _random_shape(hole_count: int, rng: np.random.Generator) -> np.ndarray:
+    base = _parse_template(TEMPLATES[hole_count][int(rng.integers(len(TEMPLATES[hole_count])))])
+    for _ in range(8):
+        shape = _transform_shape(base, rng)
+        if _hole_count(shape.astype(bool)) == hole_count:
+            return shape
+    return base
+
+
+def _place_shape(grid: np.ndarray, shape: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = shape.shape
+    patch = grid[top : top + h, left : left + w]
+    patch[shape.astype(bool)] = color
+
+
+def _rooms(h: int, w: int, split_r: int, split_c: int) -> list[tuple[int, int, int, int]]:
+    return [
+        (1, 1, split_r - 1, split_c - 1),
+        (1, split_c + 1, split_r - 1, w - 2),
+        (split_r + 1, 1, h - 2, split_c - 1),
+        (split_r + 1, split_c + 1, h - 2, w - 2),
+    ]
+
+
+def _sample_position(
+    room: tuple[int, int, int, int],
+    shape: np.ndarray,
+    direction: tuple[int, int],
+    rng: np.random.Generator,
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = room
+    sh, sw = shape.shape
+    max_top = r1 - sh + 1
+    max_left = c1 - sw + 1
+    assert max_top >= r0 and max_left >= c0
+
+    dr, dc = direction
+    if dr == -1:
+        top_lo, top_hi = r0 + 1, max_top
+        left_lo, left_hi = c0, max_left
+    elif dr == 1:
+        top_lo, top_hi = r0, max_top - 1
+        left_lo, left_hi = c0, max_left
+    elif dc == -1:
+        top_lo, top_hi = r0, max_top
+        left_lo, left_hi = c0 + 1, max_left
+    else:
+        top_lo, top_hi = r0, max_top
+        left_lo, left_hi = c0, max_left - 1
+
+    if top_lo > top_hi or left_lo > left_hi:
+        raise ValueError("room does not permit a non-zero slide for this shape")
+    top = int(rng.integers(top_lo, top_hi + 1))
+    left = int(rng.integers(left_lo, left_hi + 1))
+    return top, left
+
+
+def _build_roomed_grid(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(15, 24))
+    w = int(rng.integers(19, 29))
+    split_r = int(rng.integers(7, h - 6))
+    split_c = int(rng.integers(9, w - 8))
+
+    grid = np.zeros((h, w), dtype=int)
+    grid[0, :] = GREY
+    grid[-1, :] = GREY
+    grid[:, 0] = GREY
+    grid[:, -1] = GREY
+    grid[split_r, :] = GREY
+    grid[:, split_c] = GREY
+
+    room_boxes = _rooms(h, w, split_r, split_c)
+    assignment = list(rng.permutation(4))
+    colors = list(rng.permutation([BLUE, RED, GREEN, YELLOW]))
+
+    for room_index, hole_count in enumerate(assignment):
+        room = room_boxes[room_index]
+        placed = False
+        for _ in range(80):
+            shape = _random_shape(hole_count, rng)
+            room_h = room[2] - room[0] + 1
+            room_w = room[3] - room[1] + 1
+            if shape.shape[0] > room_h or shape.shape[1] > room_w:
+                continue
+            dr, dc = HOLES_TO_DIRECTION[hole_count]
+            if dr != 0 and room_h - shape.shape[0] < 1:
+                continue
+            if dc != 0 and room_w - shape.shape[1] < 1:
+                continue
+            try:
+                top, left = _sample_position(room, shape, (dr, dc), rng)
+            except ValueError:
+                continue
+            patch = grid[top : top + shape.shape[0], left : left + shape.shape[1]]
+            if np.any((patch != BLACK) & shape.astype(bool)):
+                continue
+            _place_shape(grid, shape, top, left, colors[room_index])
+            placed = True
+            break
+        if not placed:
+            raise RuntimeError("failed to place sprite")
+
+    return grid
+
+
+def _validate_semantics(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+
+    objects = _foreground_objects(grid)
+    if len(objects) != 4:
+        return False
+    if {obj["holes"] for obj in objects} != {0, 1, 2, 3}:
+        return False
+    if len({obj["color"] for obj in objects}) != 4:
+        return False
+
+    base = grid.copy()
+    for obj in objects:
+        pts = obj["coords"]
+        base[pts[:, 0], pts[:, 1]] = BLACK
+
+    all_rooms = _components(base != GREY)
+    if len(all_rooms) != 4:
+        return False
+
+    moved_any = False
+    for obj in objects:
+        room = _room_component(base, obj["coords"])
+        room_mask = _mask_from_coords(grid.shape, room)
+        final_coords = _slide_object(obj["coords"], room_mask, HOLES_TO_DIRECTION[obj["holes"]])
+        if np.array_equal(final_coords, obj["coords"]):
+            return False
+        moved_any = True
+
+        dr, dc = HOLES_TO_DIRECTION[obj["holes"]]
+        next_coords = final_coords.copy()
+        next_coords[:, 0] += dr
+        next_coords[:, 1] += dc
+        if np.all(room_mask[next_coords[:, 0], next_coords[:, 1]]):
+            return False
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    return moved_any and out.shape == grid.shape
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        try:
+            grid = _build_roomed_grid(rng)
+        except RuntimeError:
+            continue
+        if _validate_semantics(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid hole-navigation instance")
+
+
+if __name__ == "__main__":
+    target = Path(__file__)
+    mod = SourceFileLoader("self_test_arc_task", str(target)).load_module()
+    for _ in range(5):
+        sample = mod.generate_input()
+        result = mod.main(sample)
+        assert sample.shape == result.shape

