            group_r1, group_c1 = map(int, comp.max(axis=0))
            assert group_r1 - group_r0 == 1 and group_c1 - group_c0 == 1, (
                "each sprite-color group must fit one 2-by-2 cell block"
            )

            block = {
                (r, c)
                for r in (group_r0, group_r1)
                for c in (group_c0, group_c1)
