+        dr, dc = HOLES_TO_DIRECTION[obj["holes"]]
+        next_coords = final_coords.copy()
+        next_coords[:, 0] += dr
+        next_coords[:, 1] += dc
+        if np.all(room_mask[next_coords[:, 0], next_coords[:, 1]]):
+            return False
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    return moved_any and out.shape == grid.shape
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(400):
+        try:
+            grid = _build_roomed_grid(rng)
+        except RuntimeError:
+            continue
+        if _validate_semantics(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid hole-navigation instance")
+
+
+if __name__ == "__main__":
+    target = Path(__file__)
+    mod = SourceFileLoader("self_test_arc_task", str(target)).load_module()
+    for _ in range(5):
+        sample = mod.generate_input()
+        result = mod.main(sample)
+        assert sample.shape == result.shape

