+    left = int(rng.integers(left_lo, left_hi + 1))
+    return top, left
+
+
+def _build_roomed_grid(rng: np.random.Generator) -> np.ndarray:
+    h = int(rng.integers(15, 24))
+    w = int(rng.integers(19, 29))
