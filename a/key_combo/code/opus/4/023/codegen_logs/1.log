+            return False
+        moved_any = True
+
+        dr, dc = HOLES_TO_DIRECTION[obj["holes"]]
+        next_coords = final_coords.copy()
+        next_coords[:, 0] += dr
+        next_coords[:, 1] += dc
+        if np.all(room_mask[next_coords[:, 0], next_coords[:, 1]]):
+            return False
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    return moved_any and out.shape == grid.shape
