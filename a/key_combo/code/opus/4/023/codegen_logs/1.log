+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+HOLES_TO_DIRECTION = {
+    0: (-1, 0),  # up
+    1: (0, 1),   # right
+    2: (1, 0),   # down
+    3: (0, -1),  # left
+}
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _mask_from_coords(shape: tuple[int, int], coords: np.ndarray) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    out[coords[:, 0], coords[:, 1]] = True
+    return out
+
+
+def _crop(mask: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _hole_count(local_mask: np.ndarray) -> int:
+    h, w = local_mask.shape
+    empty = ~local_mask
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if not empty[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_border = True
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and empty[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_border:
+                holes += 1
+    return holes
+
+
+def _foreground_objects(grid: np.ndarray) -> list[dict]:
+    objects = []
+    for color in sorted(int(x) for x in np.unique(grid) if x not in (BLACK, GREY)):
+        for coords in _components(grid == color):
+            box = _bbox(coords)
+            local = _crop(_mask_from_coords(grid.shape, coords), box)
+            objects.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": box,
+                    "holes": _hole_count(local),
+                }
+            )
+    return objects
+
+
+def _room_component(base: np.ndarray, coords: np.ndarray) -> np.ndarray:
+    room_mask = base != GREY
+    seed_r, seed_c = map(int, coords[0])
+    assert room_mask[seed_r, seed_c]
+    for comp in _components(room_mask):
+        if np.any((comp[:, 0] == seed_r) & (comp[:, 1] == seed_c)):
+            return comp
+    raise AssertionError("object room not found")
+
+
+def _slide_object(coords: np.ndarray, room_mask: np.ndarray, direction: tuple[int, int]) -> np.ndarray:
+    dr, dc = direction
+    moved = coords.copy()
+    h, w = room_mask.shape
+    while True:
+        trial = moved.copy()
+        trial[:, 0] += dr
+        trial[:, 1] += dc
+        if (
+            np.all((0 <= trial[:, 0]) & (trial[:, 0] < h) & (0 <= trial[:, 1]) & (trial[:, 1] < w))
+            and np.all(room_mask[trial[:, 0], trial[:, 1]])
+        ):
+            moved = trial
+        else:
+            return moved
