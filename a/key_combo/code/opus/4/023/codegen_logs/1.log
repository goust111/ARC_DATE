+    assert all(obj["holes"] in HOLES_TO_DIRECTION for obj in objects), "unsupported hole count"
+
+    base = g.copy()
+    for obj in objects:
+        pts = obj["coords"]
+        base[pts[:, 0], pts[:, 1]] = BLACK
