+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+_GEN_CALL_COUNT = 0
+_BRANCH_CYCLE = ("no_overlap", "light_overlap", "heavy_overlap", "random")
+_HEIGHT_CHOICES = (12, 14, 16, 18, 20)
+_WIDTH_RANGE = (11, 18)
+_LENGTH_RANGE = (3, 5)
+_RADIUS_RANGE = (2, 5)
+_GEN_RETRIES = 400
+
+
