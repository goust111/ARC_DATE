+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+_GEN_CALL_COUNT = 0
+_BRANCH_CYCLE = ("no_overlap", "light_overlap", "heavy_overlap", "random")
+_HEIGHT_CHOICES = (12, 14, 16, 18, 20)
+_WIDTH_RANGE = (11, 18)
+_LENGTH_RANGE = (3, 5)
+_RADIUS_RANGE = (2, 5)
+_GEN_RETRIES = 400
+
+
+def _extract_segment(grid: np.ndarray) -> tuple[int, int, int]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert set(map(int, np.unique(g))) <= {BLACK, BLUE}, "input must contain only black and blue"
+
+    coords = np.argwhere(g == BLUE)
+    assert coords.size > 0, "expected one blue vertical segment"
+    cols = np.unique(coords[:, 1])
+    assert cols.size == 1, "blue pixels must occupy exactly one column"
+
+    col = int(cols[0])
+    rows = np.sort(coords[:, 0])
+    top = int(rows[0])
+    bottom = int(rows[-1])
+    assert rows.size == bottom - top + 1, "segment rows must be consecutive"
+
+    length = bottom - top + 1
+    assert _LENGTH_RANGE[0] <= length <= _LENGTH_RANGE[1], "segment length must be 3..5"
+    assert bottom < g.shape[0] // 2, "segment must stay in the upper half"
+    return top, bottom, col
+
+
+def _stripe_color(horizontal_distance: int, vertical_distance: int) -> int:
+    return BLUE if (horizontal_distance + vertical_distance) % 2 == 0 else GREEN
+
+
+def _build_original(shape: tuple[int, int], top: int, bottom: int, col: int) -> tuple[np.ndarray, np.ndarray]:
+    height, width = map(int, shape)
+    radius = min(col, width - 1 - col)
+    assert bottom + radius < height, "pyramid must fit below the base row"
+
+    mask = np.zeros((height, width), dtype=bool)
+    colors = np.zeros((height, width), dtype=int)
+
+    for row in range(top, bottom):
+        v = bottom - row
+        mask[row, col] = True
+        colors[row, col] = _stripe_color(0, v)
+
+    for v in range(radius + 1):
+        row = bottom + v
+        left = col - v
+        right = col + v
+        for cc in range(left, right + 1):
+            h = abs(cc - col)
+            mask[row, cc] = True
+            colors[row, cc] = _stripe_color(h, v)
+
+    return mask, colors
+
+
+def _paint_output(mask: np.ndarray, colors: np.ndarray) -> np.ndarray:
+    mirrored_mask = mask[::-1, :]
+    out = np.zeros_like(colors)
+
+    overlap = mask & mirrored_mask
+    original_only = mask & ~mirrored_mask
+    mirrored_only = mirrored_mask & ~mask
+
+    out[original_only] = colors[original_only]
+    out[mirrored_only] = GREY
+    out[overlap] = RED
+    return out
+
+
+def _render_from_segment(shape: tuple[int, int], top: int, bottom: int, col: int) -> np.ndarray:
+    mask, colors = _build_original(shape, top, bottom, col)
+    return _paint_output(mask, colors)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Expand the input vertical segment into a striped pyramid, mirror it across the horizontal midline, and recolor by overlap class.
+
+    Input structure:
+    - The background is black.
+    - Exactly one blue vertical line segment of length 3 to 5 appears in the upper half of the grid.
+    - All blue pixels lie in one column on consecutive rows, and the segment leaves enough room for the downward pyramid.
+
+    Rule:
+    - Treat the segment's bottom cell as the pyramid base row and its column as the center column.
+    - Keep the whole input segment as the pyramid's vertical spine, then extend downward: the base row has width 1 and each lower row widens by 2 while remaining centered, stopping at the largest width that stays inside the grid.
+    - Color each original-pyramid cell by its horizontal distance h from the center column plus its vertical distance v from the base row: blue when h+v is even, green when h+v is odd.
+    - Mirror the full original pyramid across the grid's horizontal midline; cells covered only by the mirrored copy become grey, and cells covered by both copies become red.
+
+    Key insight:
+    - The segment supplies three indispensable parameters at once: its column fixes the pyramid axis, its bottom row fixes the expansion origin and overlap amount, and its length fixes how tall the original spine remains before reflection.
+    """
+    g = np.asarray(grid, dtype=int)
+    top, bottom, col = _extract_segment(g)
+    return _render_from_segment(g.shape, top, bottom, col)
+
+
+def _make_input(height: int, width: int, top: int, bottom: int, col: int) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    grid[top : bottom + 1, col] = BLUE
+    return grid
+
+
+def _overlap_rows(height: int, top: int, bottom: int, col: int, width: int) -> int:
+    radius = min(col, width - 1 - col)
+    reach = bottom + radius
+    lo = max(top, height - 1 - reach)
+    hi = min(reach, height - 1 - top)
+    return max(0, hi - lo + 1)
+
+
+def _candidate_params(branch: str, rng: np.random.Generator) -> tuple[int, int, int, int, int] | None:
+    heights = list(_HEIGHT_CHOICES)
+    rng.shuffle(heights)
+    widths = list(range(*_WIDTH_RANGE))
+    rng.shuffle(widths)
+
+    for height in heights:
+        for width in widths:
+            candidates: list[tuple[int, int, int, int, int]] = []
+            for col in range(2, width - 2):
+                radius = min(col, width - 1 - col)
+                if not (_RADIUS_RANGE[0] <= radius <= _RADIUS_RANGE[1]):
+                    continue
+                for length in range(_LENGTH_RANGE[0], _LENGTH_RANGE[1] + 1):
+                    for bottom in range(length - 1, height // 2):
+                        top = bottom - length + 1
+                        if bottom + radius >= height:
+                            continue
+                        overlap_rows = _overlap_rows(height, top, bottom, col, width)
+                        if branch == "no_overlap" and overlap_rows != 0:
+                            continue
+                        if branch == "light_overlap" and not (1 <= overlap_rows <= 2):
+                            continue
+                        if branch == "heavy_overlap" and overlap_rows < 3:
+                            continue
+                        candidates.append((height, width, top, bottom, col))
+            if candidates:
+                return candidates[int(rng.integers(0, len(candidates)))]
+    return None
+
+
+def _next_branch() -> str:
+    global _GEN_CALL_COUNT
+    branch = _BRANCH_CYCLE[_GEN_CALL_COUNT % len(_BRANCH_CYCLE)]
+    _GEN_CALL_COUNT += 1
+    return branch
+
+
+def _semantic_checks(inp: np.ndarray) -> bool:
+    try:
+        top, bottom, col = _extract_segment(inp)
+        out = main(inp)
+        mask, colors = _build_original(inp.shape, top, bottom, col)
+    except AssertionError:
+        return False
+
+    mirrored_mask = mask[::-1, :]
+    overlap = mask & mirrored_mask
+    original_only = mask & ~mirrored_mask
+    mirrored_only = mirrored_mask & ~mask
+    background = ~(mask | mirrored_mask)
+
+    if not np.all(out[overlap] == RED):
+        return False
+    if not np.all(out[mirrored_only] == GREY):
+        return False
+    if not np.array_equal(out[original_only], colors[original_only]):
+        return False
+    if not np.all(out[background] == BLACK):
+        return False
+
+    counterfactual_diffs = 0
+    height, width = inp.shape
+    length = bottom - top + 1
+
+    if length > _LENGTH_RANGE[0]:
+        shorter = _make_input(height, width, top + 1, bottom, col)
+        counterfactual_diffs += int(not np.array_equal(out, main(shorter)))
+    if length < _LENGTH_RANGE[1] and top > 0:
+        longer = _make_input(height, width, top - 1, bottom, col)
+        counterfactual_diffs += int(not np.array_equal(out, main(longer)))
+    if col > 2:
+        shifted_left = _make_input(height, width, top, bottom, col - 1)
+        try:
+            counterfactual_diffs += int(not np.array_equal(out, main(shifted_left)))
+        except AssertionError:
+            return False
+    if bottom > length - 1:
+        lifted = _make_input(height, width, top - 1, bottom - 1, col)
+        try:
+            counterfactual_diffs += int(not np.array_equal(out, main(lifted)))
+        except AssertionError:
+            return False
+
+    return counterfactual_diffs >= 3
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(_GEN_RETRIES):
+        branch = _next_branch()
+        if branch == "random":
+            branch = rng.choice(["no_overlap", "light_overlap", "heavy_overlap"]).item()
+
+        params = _candidate_params(branch, rng)
+        if params is None:
+            continue
+        height, width, top, bottom, col = params
+        inp = _make_input(height, width, top, bottom, col)
+        if _semantic_checks(inp):
+            return inp
+    raise RuntimeError("generate_input failed to find a valid non-degenerate example")

