+def _build_original(shape: tuple[int, int], top: int, bottom: int, col: int) -> tuple[np.ndarray, np.ndarray]:
+    height, width = map(int, shape)
+    radius = min(col, width - 1 - col)
+    assert bottom + radius < height, "pyramid must fit below the base row"
+
+    mask = np.zeros((height, width), dtype=bool)
+    colors = np.zeros((height, width), dtype=int)
+
+    for row in range(top, bottom):
+        v = bottom - row
+        mask[row, col] = True
+        colors[row, col] = _stripe_color(0, v)
+
+    for v in range(radius + 1):
+        row = bottom + v
+        left = col - v
+        right = col + v
+        for cc in range(left, right + 1):
