+    top = int(rows[0])
+    bottom = int(rows[-1])
+    assert rows.size == bottom - top + 1, "segment rows must be consecutive"
+
+    length = bottom - top + 1
+    assert _LENGTH_RANGE[0] <= length <= _LENGTH_RANGE[1], "segment length must be 3..5"
+    assert bottom < g.shape[0] // 2, "segment must stay in the upper half"
+    return top, bottom, col
+
+
+def _stripe_color(horizontal_distance: int, vertical_distance: int) -> int:
+    return BLUE if (horizontal_distance + vertical_distance) % 2 == 0 else GREEN
+
+
