+def _reflect_to_missing(mask: np.ndarray, src: tuple[int, int], missing: tuple[int, int]) -> np.ndarray:
+    out = np.asarray(mask, dtype=bool).copy()
+    if src[0] != missing[0]:
+        out = out[::-1, :]
+    if src[1] != missing[1]:
