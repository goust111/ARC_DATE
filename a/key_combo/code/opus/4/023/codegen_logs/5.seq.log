# CFG: colors.
FRAME_COLOR = Color.YELLOW
PATH_COLOR = Color.GREY
CONTROL_COLORS = [Color.BLUE, Color.GREEN, Color.PINK, Color.ORANGE, Color.TEAL]

# CFG: canvas and frame placement.
ROW_RANGE, COL_RANGE = (12, 30), (13, 30)
