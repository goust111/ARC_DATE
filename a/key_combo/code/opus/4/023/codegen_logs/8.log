68: def main(grid: np.ndarray) -> np.ndarray:
69:     """
70:     Recolor grey shapes by matching their hole count to a color legend.
71: 
72:     Input structure:
73:     - bg = most common color; grey (5) sprites scattered across the grid.
74:     - Colored legend shapes (non-bg, non-grey, at least 2×2, not touching the outer border) near grid edge,
75:       each with a distinct number of enclosed holes.
76: 
77:     Rule:
78:     - Each colored legend shape defines a mapping: hole count → color.
79:     - For every grey sprite, count its holes (enclosed bg regions not touching the sprite's bounding-box border).
80:     - Recolor the grey sprite to the matching legend color; erase grey distractors with unlisted hole counts.
81: 
82:     Key insight: Shape identity is encoded by topology (number of holes), not geometry or size.
83:     """
84:     g = np.asarray(grid, dtype=int)
85:     bg = get_bg(g)
86:     grey = 5
87: 
88:     legend = _legend_mapping(g, bg, grey)
89:     assert legend, "legend mapping must be non-empty: grid must contain colored legend shapes"
90: 
91:     out = g.copy()
92:     for pts in components_mask(g == grey, connectivity=4):
93:         r0, c0, r1, c1 = bbox_coords(pts)
94:         sub = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
95:         for r, c in pts:
96:             sub[r - r0, c - c0] = True
97:         hc = _hole_count(sub)
98:         newc = int(legend[hc]) if hc in legend else bg
99:         for r, c in pts:
100:             out[r, c] = newc
101: 
102:     return out
