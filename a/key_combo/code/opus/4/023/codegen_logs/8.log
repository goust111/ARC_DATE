17: def main(grid: np.ndarray) -> np.ndarray:
18:     """
19:     Summarize the enclosed table slots by the single object color inside each slot, using the slot background color for empty slots.
20: 
21:     Input structure
22:     - The most common color forms the outer background and all enclosed slot
23:       backgrounds.
24:     - The enclosed background components form a complete rectangular array of
25:       slots, ordered by their positions.
26:     - Each slot contains either no other color or exactly one object color.
27: 
28:     Rule
29:     - Find all 4-connected components of the most common color that do not touch
30:       the input edge.
31:     - Sort their bounding boxes into row and column order to define the output
32:       table.
33:     - For each slot, output its unique non-background color if present; otherwise
34:       output the background color.
35: 
36:     Key insight
37:     - The large grid is an expanded table: the enclosed background components are
38:       the cells, and any colored object drawn inside a cell is that cell's summary
39:       value.
40:     """
41:     g = np.asarray(grid, dtype=int)
42:     assert g.ndim == 2, "expected a 2D grid"
43:     height, width = map(int, g.shape)
44: 
45:     bg = get_bg(g)
46:     slot_bboxes: list[tuple[int, int, int, int]] = []
47:     for coords in components_mask(g == bg, connectivity=4):
48:         if _touches_edge(coords, height, width):
49:             continue
50:         slot_bboxes.append(bbox_coords(coords))
51: 
52:     assert slot_bboxes, "expected enclosed background slots"
53:     row_starts = sorted({b[0] for b in slot_bboxes})
54:     col_starts = sorted({b[1] for b in slot_bboxes})
55:     assert len(slot_bboxes) == len(row_starts) * len(col_starts), (
56:         "expected a complete rectangular array of slots"
57:     )
58: 
59:     slot_by_anchor = {(b[0], b[1]): b for b in slot_bboxes}
60:     assert len(slot_by_anchor) == len(slot_bboxes), "slot anchors must be unique"
61: 
62:     out = np.full((len(row_starts), len(col_starts)), bg, dtype=int)
63:     for out_r, r0 in enumerate(row_starts):
64:         for out_c, c0 in enumerate(col_starts):
65:             assert (r0, c0) in slot_by_anchor, "missing slot in rectangular array"
66:             sr0, sc0, sr1, sc1 = slot_by_anchor[(r0, c0)]
67:             window = g[sr0 : sr1 + 1, sc0 : sc1 + 1]
68:             object_colors = np.unique(window[window != bg])
69:             assert object_colors.size <= 1, "each slot must contain at most one object color"
70:             if object_colors.size == 1:
71:                 out[out_r, out_c] = int(object_colors[0])
72: 
73:     return out
