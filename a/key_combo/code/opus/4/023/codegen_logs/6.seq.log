+    cells = {(0, 0)}
+    while len(cells) < area:
+        frontier = set()
+        for r, c in cells:
+            for nr, nc in neighbors4(r, c):
+                frontier.add((nr, nc))
+        frontier -= cells
+        cells.add(rng.choice(sorted(frontier)))
