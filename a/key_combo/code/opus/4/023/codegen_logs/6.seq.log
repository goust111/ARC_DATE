+
+
+def _side_extents(shape: np.ndarray, quadrant: str, side: str) -> tuple[int, int, int, int]:
+    h, w = map(int, shape.shape)
+    top = bottom = left = right = 0
+    if quadrant == "tl":
+        if side == "top":
+            top, left = h, w - 1
+        else:
+            top, left = h - 1, w
+    elif quadrant == "tr":
+        if side == "top":
+            top, right = h, w - 1
+        else:
+            top, right = h - 1, w
+    elif quadrant == "bl":
+        if side == "bottom":
+            bottom, left = h, w - 1
+        else:
+            bottom, left = h - 1, w
+    else:
+        if side == "bottom":
+            bottom, right = h, w - 1
+        else:
