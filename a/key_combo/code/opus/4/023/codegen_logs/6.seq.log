+def _validate_slide_path(
+    coords: np.ndarray,
+    delta: tuple[int, int],
+    color: int,
+    base_grid: np.ndarray,
+    anchor_mask: np.ndarray,
+) -> None:
+    dr, dc = delta
+    steps = max(abs(dr), abs(dc))
+    step_r = 0 if dr == 0 else (1 if dr > 0 else -1)
+    step_c = 0 if dc == 0 else (1 if dc > 0 else -1)
