+        hub_c = cross_col if cross_col is not None and random.random() < 0.7 else random.randrange(w)
+        hub = (int(hub_r), int(hub_c))
+
+        terminals = [
+            (0, random.randrange(w)),
+            (h - 1, random.randrange(w)),
+            (random.randrange(h), 0),
+            (random.randrange(h), w - 1),
+        ]
