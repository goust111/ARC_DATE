+        cut = 2 if np.any(coords[:, 1] >= c0 + 2) else 1
+        remove |= coords[:, 1] < c0 + cut
+    if vertical:
+        cut = 2 if np.any(coords[:, 0] >= r0 + 2) else 1
+        remove |= coords[:, 0] < r0 + cut
