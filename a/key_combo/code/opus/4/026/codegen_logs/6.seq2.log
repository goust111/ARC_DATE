        mask = _gen_bridge_mask(h, w)

    area = h * w
    lo = max(int(math.ceil(_GEN_YELLOW_DENSITY[0] * area)), int(mask.sum()))
    hi = int(math.floor(_GEN_YELLOW_DENSITY[1] * area))
    if lo > hi:
