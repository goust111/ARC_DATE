+def _path_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    out = [(int(r), int(c))]
+    while (r, c) != (tr, tc):
+        choices = []
+        if r < tr:
