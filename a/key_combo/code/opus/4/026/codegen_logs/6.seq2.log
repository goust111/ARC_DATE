+            random.shuffle(positions)
+            for top, left in positions:
+                cross_row = h_rows[spec["row_idx"]] - top if spec["row_idx"] is not None else None
+                cross_col = v_cols[spec["col_idx"]] - left if spec["col_idx"] is not None else None
