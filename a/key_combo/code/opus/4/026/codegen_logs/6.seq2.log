+    raise RuntimeError("failed to sample separated connector lines")
+
+
+def _path_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    out = [(int(r), int(c))]
