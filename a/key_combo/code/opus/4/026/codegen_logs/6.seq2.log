+
+    components = _object_components(grid, bg)
+    if not (5 <= len(components) <= 6):
+        return None
+
+    categories = {"h_only": 0, "v_only": 0, "both": 0, "none": 0}
+    touched = 0
+    unchanged = 0
+
+    for component in components:
