+def _path_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    out = [(int(r), int(c))]
+    while (r, c) != (tr, tc):
+        choices = []
+        if r < tr:
+            choices.append((r + 1, c))
+        elif r > tr:
+            choices.append((r - 1, c))
+        if c < tc:
+            choices.append((r, c + 1))
+        elif c > tc:
+            choices.append((r, c - 1))
+        r, c = random.choice(choices)
+        out.append((int(r), int(c)))
