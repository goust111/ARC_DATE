+def _marker_runs(values: np.ndarray) -> dict[int, list[int]]:
+    out: dict[int, list[int]] = {}
+    rows, cols = np.where(values == MARKER)
+    for r, c in zip(rows, cols):
+        out.setdefault(int(r), []).append(int(c))
+    return out
