+        for color in np.unique(grid)
+        if int(color) not in {int(bg), MARKER, LINE}
+    ]
+    return find_components(
+        grid,
+        bg=bg,
+        colors=colors,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+
+
+def _erase_component(
+    out: np.ndarray,
+    component: dict,
+    bg: int,
+    horizontal: bool,
+    vertical: bool,
+) -> None:
