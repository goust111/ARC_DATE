+
+def _erase_component(
+    out: np.ndarray,
+    component: dict,
+    bg: int,
+    horizontal: bool,
+    vertical: bool,
+) -> None:
+    coords = component["coords"]
+    r0, c0, _r1, _c1 = map(int, component["bbox"])
+    remove = np.zeros(len(coords), dtype=bool)
