+    for r, cols in row_markers.items():
+        cols = sorted(set(cols))
+        if len(cols) < 2:
+            continue
+        active_rows.append(int(r))
+        for c0, c1 in zip(cols, cols[1:]):
+            for c in range(c0 + 1, c1):
