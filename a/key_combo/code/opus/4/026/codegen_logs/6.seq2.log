+def _draw_lines(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray, list[int], list[int]]:
+    bg = int(get_bg(grid))
+    out = np.asarray(grid, dtype=int).copy()
+    hmask = np.zeros_like(out, dtype=bool)
+    vmask = np.zeros_like(out, dtype=bool)
