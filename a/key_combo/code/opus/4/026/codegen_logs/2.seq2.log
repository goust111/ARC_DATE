+    return (
+        (r0 <= r <= r1 and c0 <= c <= c1)
+        or (r0 <= r <= r1 and c in {c0 - 1, c1 + 1})
+        or (c0 <= c <= c1 and r in {r0 - 1, r1 + 1})
