+        paste(grid, patch, r0, c0, transparent=BG_COLOR)
+        occupied[r0 : r0 + ph, c0 : c0 + pw] |= mask
+        state["plan"]["isolated_colors"].append(int(color))
+        return True
+    return False
+
+
+def _add_dummy_markers(grid: np.ndarray, state: dict, count: int) -> bool:
