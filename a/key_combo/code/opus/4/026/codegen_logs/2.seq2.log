+        cols = sorted(cols)
+        for left, right in zip(cols, cols[1:]):
+            pixels = [(r, c) for c in range(left + 1, right) if int(grid[r, c]) == bg]
+            if pixels:
+                segments.append(
+                    {
+                        "orientation": "h",
+                        "start": pixels[0],
