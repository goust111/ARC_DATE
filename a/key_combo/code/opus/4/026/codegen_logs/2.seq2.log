_GEN_AXIS_HEIGHT = (3, 6)
_GEN_YELLOW_WIDTH = (2, 5)
_GEN_YELLOW_DENSITY = (0.40, 0.75)
_GEN_LADDER_PROBABILITY = 0.45
_GEN_WALK_STEPS = (-1, 0, 1)

