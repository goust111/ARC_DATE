+    if op == 0:
+        return r, c
+    if op == 1:
+        return c, LEFT_SIZE - 1 - r
+    if op == 2:
+        return LEFT_SIZE - 1 - r, LEFT_SIZE - 1 - c
+    if op == 3:
+        return LEFT_SIZE - 1 - c, r
+    if op == 4:
+        return r, LEFT_SIZE - 1 - c
+    if op == 5:
+        return LEFT_SIZE - 1 - r, c
+    if op == 6:
+        return c, r
+    if op == 7:
+        return LEFT_SIZE - 1 - c, LEFT_SIZE - 1 - r
+    raise ValueError("invalid symmetry op")
