+    r0, c0, r1, c1 = _bbox_coords(coords)
+    offsets = tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+    return (int(r1 - r0 + 1), int(c1 - c0 + 1)), offsets
