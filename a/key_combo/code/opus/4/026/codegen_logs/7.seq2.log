+
+
+def _render_right(holes: list[dict], colors: list[int]) -> np.ndarray:
+    right = np.zeros((RIGHT_SIZE, RIGHT_SIZE), dtype=int)
+    slots = random.sample(REFERENCE_SLOTS, len(holes))
