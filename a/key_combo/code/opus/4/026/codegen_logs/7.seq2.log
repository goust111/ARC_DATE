+            transformed = {_transform_point(r, c, op) for r, c in hole}
+            cand = _candidate_from_cells(transformed)
+            assert cand is not None, "four-hole library entry must stay valid under symmetry"
+            layout.append(cand)
+        key = tuple(sorted((cand["hole_set"] for cand in layout), key=lambda item: sorted(item)))
+        if key in seen:
+            continue
+        seen.add(key)
+        assert len({cand["fragment_key"] for cand in layout}) == 4, "four-hole library must keep unique fragments"
+        assert all(_holes_compatible(layout[i], layout[j]) for i in range(4) for j in range(i + 1, 4)), (
+            "four-hole library holes must stay separated"
+        )
+        layouts.append(layout)
+    return layouts
+
