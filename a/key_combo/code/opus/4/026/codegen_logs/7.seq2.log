+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+LEFT_SIZE = 9
+RIGHT_SIZE = 9
+GRID_SHAPE = (9, 18)
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SPIRAL_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
+CORNER_NODES = [(2, 2), (2, 6), (6, 2), (6, 6)]
+REFERENCE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+REFERENCE_SLOTS = [(0, 0), (0, 5), (5, 0), (5, 5)]
