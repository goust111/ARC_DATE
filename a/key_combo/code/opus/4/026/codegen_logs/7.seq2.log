    aset=a[0]; bset=b[0]
    # require no touching orthogonally? only overlapping/4-connected merge issue. holes can touch diagonally but not orthogonally.
    if aset & bset: return False
    for r,c in aset:
        for dr,dc in DIRS4:
            if (r+dr,c+dc) in bset: return False
    return True

