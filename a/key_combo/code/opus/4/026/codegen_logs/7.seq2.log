+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+LEFT_SIZE = 9
+RIGHT_SIZE = 9
+GRID_SHAPE = (9, 18)
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SPIRAL_DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # up, right, down, left
