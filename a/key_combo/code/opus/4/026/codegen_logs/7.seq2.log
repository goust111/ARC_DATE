+
+def _candidate_catalog(node: tuple[int, int], *, max_size: int) -> list[dict]:
+    uniq: dict[tuple[frozenset[tuple[int, int]], tuple[tuple[int, int], tuple[tuple[int, int], ...]]], dict] = {}
