+def _build_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    hole_count = random.choices([3, 4], weights=[5, 4], k=1)[0]
+    if hole_count == 4:
+        holes = list(FOUR_HOLE_LAYOUT)
+    else:
