import random
from collections import defaultdict
import itertools

DIRS4=[(-1,0),(1,0),(0,-1),(0,1)]
NODES=[(r,c) for r in (2,4,6) for c in (2,4,6)]
ALL_INNER=[(r,c) for r in range(1,8) for c in range(1,8)]

def spiral(node):
    sr,sc=node[0]//2,node[1]//2
    r,c=sr,sc
    step=1
    dir_i=0
    mids=[]
    for _ in range(8):
        for _ in range(2):
            dr,dc=[(-1,0),(0,1),(1,0),(0,-1)][dir_i%4]
            for _ in range(step):
                nr,nc=r+dr,c+dc
                if 0<=r<5 and 0<=c<5 and 0<=nr<5 and 0<=nc<5:
                    mids.append((r+nr,c+nc))
                r,c=nr,nc
            dir_i+=1
        step+=1
    return set(mids)

def comp(mask):
    seen=set(); comps=[]
    for p in mask:
        if p in seen: continue
        stack=[p]; seen.add(p); cur=[]
        while stack:
            x=stack.pop(); cur.append(x)
            for dr,dc in DIRS4:
                y=(x[0]+dr,x[1]+dc)
                if y in mask and y not in seen:
                    seen.add(y); stack.append(y)
        comps.append(cur)
    return comps

def shape(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    return (max(rs)-r0+1,max(cs)-c0+1),tuple(sorted((r-r0,c-c0) for r,c in cells))

def rand_hole(node):
    others={(r,c) for r,c in ALL_INNER if r%2==0 and c%2==0 and (r,c)"'!=node}
    allowed=[p for p in ALL_INNER if p not in others]
    cells={node}
    target=random.randint(5,12)
    while len(cells)<target:
        frontier=[]
        for r,c in list(cells):
            for dr,dc in DIRS4:
                q=(r+dr,c+dc)
                if q in cells or q not in allowed: continue
                frontier.append(q)
        if not frontier: return None
        cells.add(random.choice(frontier))
    if len(comp(cells))!=1: return None
    frag=cells & spiral(node)
    if not (3<=len(frag)<=8): return None
    sh=shape(frag)
    if sh[0][0]>4 or sh[0][1]>4: return None
    return cells,frag,sh

for node in NODES:
    shapes=defaultdict(int)
    for _ in range(5000):
        x=rand_hole(node)
        if x:
            shapes[x[2]]+=1
    print(node, len(shapes), sorted((cnt,sh[0],len(sh[1])) for sh,cnt in shapes.items())[-10:])
