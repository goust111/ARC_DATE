+    return cand
+
+
+def _holes_compatible(a: dict, b: dict) -> bool:
+    aset = a["hole_set"]
+    bset = b["hole_set"]
+    if aset & bset:
+        return False
+    for r, c in aset:
+        for dr, dc in DIRS4:
+            if (r + dr, c + dc) in bset:
+                return False
