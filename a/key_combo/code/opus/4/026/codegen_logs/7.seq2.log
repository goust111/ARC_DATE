+def _spiral_midpoints(node_rc: tuple[int, int]) -> frozenset[tuple[int, int]]:
+    node_r = node_rc[0] // 2
+    node_c = node_rc[1] // 2
+    r, c = node_r, node_c
+    midpoints: list[tuple[int, int]] = []
+    step = 1
+    dir_idx = 0
+
+    # A 5x5 node lattice is fully exhausted long before step 9.
+    for _ in range(9):
+        for _ in range(2):
