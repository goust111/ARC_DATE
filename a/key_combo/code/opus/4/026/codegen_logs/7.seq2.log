+
+    return {
+        "node": node,
+        "hole_coords": coords,
+        "hole_set": cell_set,
+        "hole_key": hole_key,
+        "fragment": fragment,
+        "fragment_key": frag_key,
+    }
+
+
+def _sample_hole_candidate(node: tuple[int, int], *, max_size: int) -> dict | None:
+    allowed = _candidate_allowed_cells(node)
+    cells = {node}
+    target = random.randint(5, max_size)
