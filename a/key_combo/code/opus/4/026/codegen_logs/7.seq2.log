+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        built = _build_instance()
+        if built is not None:
+            return built[0]
+    raise RuntimeError("failed to generate a valid spiral-hole matching instance")

