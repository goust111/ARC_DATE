+    ref_shapes = set(refs)
+    if len(ref_shapes) != len(refs):
+        return False
+
+    # Direct hole-shape matching must fail; the spiral step is required.
+    for coords in holes:
+        hole_key = _shape_key(coords)
+        if hole_key in ref_shapes:
