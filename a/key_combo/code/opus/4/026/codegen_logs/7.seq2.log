+def _candidate_allowed_cells(node: tuple[int, int]) -> set[tuple[int, int]]:
+    allowed: set[tuple[int, int]] = set()
+    for r in range(1, LEFT_SIZE - 1):
+        for c in range(1, LEFT_SIZE - 1):
