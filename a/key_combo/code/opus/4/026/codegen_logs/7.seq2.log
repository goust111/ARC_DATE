CORNERS=[(2,2),(2,6),(6,2),(6,6)]
ALL=[(r,c) for r in range(1,8) for c in range(1,8)]

def spiral(node):
    r,c=node[0]//2,node[1]//2
    mids=[]; step=1; di=0
    for _ in range(8):
        for _ in range(2):
            dr,dc=[(-1,0),(0,1),(1,0),(0,-1)][di%4]
            for _ in range(step):
                nr,nc=r+dr,c+dc
                if 0<=r<5 and 0<=c<5 and 0<=nr<5 and 0<=nc<5:
                    mids.append((r+nr,c+nc))
                r,c=nr,nc
            di+=1
        step+=1
    return set(mids)
SP={n:spiral(n) for n in CORNERS}


def shape(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    return (max(rs)-r0+1,max(cs)-c0+1),tuple(sorted((r-r0,c-c0) for r,c in cells))

def sample(node):
    others={(r,c) for r,c in ALL if r%2==0 and c%2==0 and (r,c)"'!=node}
    allowed=[p for p in ALL if p not in others]
    cells={node}
