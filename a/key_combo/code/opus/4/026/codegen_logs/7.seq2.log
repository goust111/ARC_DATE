+def _hole_components(left: np.ndarray) -> list[np.ndarray]:
+    holes = []
+    for coords in _components_from_mask(left == BLACK):
+        if np.all((coords[:, 0] > 0) & (coords[:, 0] < LEFT_SIZE - 1) & (coords[:, 1] > 0) & (coords[:, 1] < LEFT_SIZE - 1)):
+            holes.append(coords)
+    return holes
+
