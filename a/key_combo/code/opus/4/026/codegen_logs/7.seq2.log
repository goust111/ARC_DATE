+
+BASE_FOUR_HOLE_COORDS = [
+    [(1, 2), (1, 3), (1, 4), (2, 1), (2, 2), (3, 1), (4, 1)],
+    [(1, 6), (2, 5), (2, 6), (3, 4), (3, 5), (4, 5)],
