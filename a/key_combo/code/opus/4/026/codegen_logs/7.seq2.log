+            return True
+
+        node = ordered[idx]
+        candidates = catalogs[node][:]
+        random.shuffle(candidates)
+        for cand in candidates:
+            if cand["fragment_key"] in used_shapes:
+                continue
+            if all(_holes_compatible(cand, prev) for prev in chosen):
+                chosen.append(cand)
+                used_shapes.add(cand["fragment_key"])
+                if rec(idx + 1):
