+    segments.sort(key=lambda seg: seg["row"])
+    assert 4 <= len(segments) <= 6, "expected 4-6 horizontal segments"
+    rows = [seg["row"] for seg in segments]
+    assert len(set(rows)) == len(rows), "segment rows must be unique"
+
