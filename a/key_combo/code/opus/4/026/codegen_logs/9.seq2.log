+                    "c1": shape_c0 + length - 2,
+                    "length": length,
+                    "covered": [False] + [True] * (length - 1),
+                }
+            )
+        if shape_c1 + 1 < w and shape_c1 - length + 2 >= shape_c0:
+            options.append(
+                {
+                    "c0": shape_c1 - length + 2,
+                    "c1": shape_c1 + 1,
+                    "length": length,
+                    "covered": [True] * (length - 1) + [False],
