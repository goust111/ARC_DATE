+    for i in range(1, width):
+        prev_t = int(top[i - 1])
+        prev_b = int(bottom[i - 1])
+        candidates = []
+        for dt in (-2, -1, 0, 1, 2):
+            t = prev_t + dt
+            if not 1 <= t <= h - 8:
+                continue
+            for db in (-2, -1, 0, 1, 2):
+                b = prev_b + db
+                if b - t + 1 < 4 or b - t + 1 > 9:
+                    continue
+                if b > h - 5:
+                    continue
+                if max(t, prev_t) <= min(b, prev_b):
+                    candidates.append((t, b))
