+
+def _build_shape(h: int, w: int) -> tuple[np.ndarray, int, int, np.ndarray]:
+    width = random.randint(max(10, w - 8), min(w - 3, 15))
+    c0 = random.randint(1, w - width - 1)
+    c1 = c0 + width - 1
+
+    top = np.zeros(width, dtype=int)
+    bottom = np.zeros(width, dtype=int)
+    top[0] = random.randint(1, max(2, h // 4))
+    bottom[0] = min(h - 6, top[0] + random.randint(5, 8))
+
+    for i in range(1, width):
+        prev_t = int(top[i - 1])
+        prev_b = int(bottom[i - 1])
+        candidates = []
+        for dt in (-2, -1, 0, 1, 2):
+            t = prev_t + dt
+            if not 1 <= t <= h - 8:
+                continue
+            for db in (-2, -1, 0, 1, 2):
+                b = prev_b + db
+                if b - t + 1 < 4 or b - t + 1 > 9:
+                    continue
+                if b > h - 5:
+                    continue
+                if max(t, prev_t) <= min(b, prev_b):
+                    candidates.append((t, b))
+        if not candidates:
+            raise ValueError("failed to continue shape ribbon")
+        top[i], bottom[i] = random.choice(candidates)
+
+    mask = np.zeros((h, w), dtype=bool)
+    for i, c in enumerate(range(c0, c1 + 1)):
+        mask[top[i] : bottom[i] + 1, c] = True
+    area = int(mask.sum())
+    frac = area / float(h * w)
+    assert 0.22 <= frac <= 0.42
+    assert len(_components(mask)) == 1
+    return mask, c0, c1, top
+
+
+def _segment_candidates(shape_mask: np.ndarray, shape_c0: int, shape_c1: int) -> tuple[list[dict], list[dict]]:
+    h, w = shape_mask.shape
+    gray_min = np.full(w, h, dtype=int)
+    for c in range(w):
+        rows = np.flatnonzero(shape_mask[:, c])
+        if rows.size:
+            gray_min[c] = int(rows.min())
+
+    eligible = []
+    ineligible = []
+    for row in range(5, h - 2):
+        for length in range(2, 5):
+            for c0 in range(1, w - length):
+                c1 = c0 + length - 1
+                if np.any(shape_mask[row, c0 : c1 + 1]):
+                    continue
+                covered = [int(gray_min[c]) < row for c in range(c0, c1 + 1)]
+                if not any(covered):
+                    continue
+                seg = {
+                    "row": row,
+                    "c0": c0,
+                    "c1": c1,
+                    "length": length,
+                    "inside_span": c0 >= shape_c0 and c1 <= shape_c1,
+                    "covered": covered,
+                }
+                if all(covered):
+                    eligible.append(seg)
+                else:
+                    ineligible.append(seg)
+    return eligible, ineligible
+
+
+def _rows_compatible(chosen: list[dict], cand: dict) -> bool:
+    return all(abs(int(seg["row"]) - int(cand["row"])) >= 2 for seg in chosen)
+
+
+def _overlap_cols(a: dict, b: dict) -> bool:
+    return max(int(a["c0"]), int(b["c0"])) <= min(int(a["c1"]), int(b["c1"]))
+
+
+def _select_segments(shape_mask: np.ndarray, shape_c0: int, shape_c1: int) -> list[dict] | None:
+    eligible, ineligible = _segment_candidates(shape_mask, shape_c0, shape_c1)
+    pair_options = [
+        (a, b)
+        for a, b in combinations(eligible, 2)
+        if _rows_compatible([a], b) and _overlap_cols(a, b)
+    ]
+    if not pair_options:
+        return None
+
+    near_miss = [
+        seg for seg in ineligible if sum(seg["covered"]) == seg["length"] - 1
+    ]
+    if not near_miss:
+        return None
+
+    random.shuffle(pair_options)
+    total = random.randint(4, 6)
+    for first, second in pair_options:
+        chosen = [dict(first), dict(second)]
+        pool = near_miss[:]
+        random.shuffle(pool)
+        bad = next((seg for seg in pool if _rows_compatible(chosen, seg)), None)
+        if bad is None:
+            continue
+        chosen.append(dict(bad))
+
+        fillers = eligible + ineligible
+        random.shuffle(fillers)
+        for cand in fillers:
+            if len(chosen) >= total:
+                break
+            if any(
+                int(existing["row"]) == int(cand["row"])
+                and int(existing["c0"]) == int(cand["c0"])
+                and int(existing["c1"]) == int(cand["c1"])
+                for existing in chosen
+            ):
+                continue
+            if not _rows_compatible(chosen, cand):
+                continue
+            chosen.append(dict(cand))
+
+        if len(chosen) != total:
+            continue
+
+        chosen.sort(key=lambda seg: seg["row"])
+        n_eligible = sum(1 for seg in chosen if all(seg["covered"]))
+        n_ineligible = len(chosen) - n_eligible
+        if n_eligible < 2 or n_ineligible < 1:
+            continue
+        return chosen
+    return None
+
+
+def _render_input(h: int, w: int, shape_mask: np.ndarray, segments: list[dict]) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    grid[-1, :] = BAR
+    grid[shape_mask] = GRAY
+
+    colors = random.sample(SEGMENT_COLORS, len(segments))
+    for seg, color in zip(segments, colors):
+        seg["color"] = color
+        grid[int(seg["row"]), int(seg["c0"]) : int(seg["c1"]) + 1] = color
+    return grid
+
+
+def _all_projected_output(grid: np.ndarray) -> np.ndarray:
+    bg, _gray_coords, segments, _gray_rows_by_col = _analyze(grid)
+    return _paint_projections(grid, segments, bg)
+
+
+def _reverse_order_output(grid: np.ndarray) -> np.ndarray:
+    bg, _gray_coords, segments, gray_rows_by_col = _analyze(grid)
+    eligible, _ineligible = _eligible_segments(gray_rows_by_col, segments)
+    out = grid.copy()
+    h, _w = grid.shape
+    locked = grid != bg
+    for seg in sorted(eligible, key=lambda seg: seg["row"], reverse=True):
+        r0 = seg["row"] + 1
+        r1 = h - 2
+        if r0 > r1:
+            continue
+        view = out[r0 : r1 + 1, seg["c0"] : seg["c1"] + 1]
+        mask = ~locked[r0 : r1 + 1, seg["c0"] : seg["c1"] + 1]
+        view[mask] = int(seg["color"])
+    return out
+
+
+def _validate_instance(grid: np.ndarray) -> bool:
+    bg, gray_coords, segments, gray_rows_by_col = _analyze(grid)
+    eligible, ineligible = _eligible_segments(gray_rows_by_col, segments)
+    if len(eligible) < 2 or len(ineligible) < 1:
+        return False
+
+    if not any(_overlap_cols(a, b) for a, b in combinations(eligible, 2)):
+        return False
+
+    del gray_coords
+    if not any(sum(seg["covered"]) == len(seg["covered"]) - 1 for seg in ineligible):
+        return False
+
+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    if np.array_equal(out, _all_projected_output(grid)):
+        return False
+    if np.array_equal(out, _reverse_order_output(grid)):
+        return False
+
+    locked = grid != bg
+    if not np.array_equal(out[locked], grid[locked]):
+        return False
+
+    changed = (out != grid) & (~locked)
+    if int(changed.sum()) < 6:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 21)
+    w = random.randint(18, 21)
+    try:
+        shape_mask, shape_c0, shape_c1, _top = _build_shape(h, w)
+    except Exception:
+        return None
+
+    segments = _select_segments(shape_mask, shape_c0, shape_c1)
+    if segments is None:
+        return None
+
+    grid = _render_input(h, w, shape_mask, segments)
+    return grid if _validate_instance(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

