+def _detect_notch_side(patch: np.ndarray, fg: int, bg: int) -> str:
+    sides: list[str] = []
+    if _notch_indices(patch[0, :], fg, bg):
+        sides.append("up")
+    if _notch_indices(patch[:, -1], fg, bg):
+        sides.append("right")
+    if _notch_indices(patch[-1, :], fg, bg):
+        sides.append("down")
+    if _notch_indices(patch[:, 0], fg, bg):
+        sides.append("left")
