+        return None
+    inp = _render_input((h, w), placed)
+    if not _semantic_checks(inp, placed):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
