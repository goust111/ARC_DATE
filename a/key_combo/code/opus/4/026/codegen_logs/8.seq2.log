+from __future__ import annotations
+
+from importlib.machinery import SourceFileLoader
+from pathlib import Path
+import random
+
+import numpy as np
+
+
+_ARC_UTILS = SourceFileLoader(
+    "arc_utils_for_opus_4_026_8",
