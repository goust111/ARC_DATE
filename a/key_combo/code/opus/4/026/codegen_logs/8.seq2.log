+def _notch_indices(line: np.ndarray, fg: int, bg: int) -> list[int]:
+    return [
+        i
+        for i in range(1, len(line) - 1)
+        if int(line[i]) == bg and int(line[i - 1]) == fg and int(line[i + 1]) == fg
