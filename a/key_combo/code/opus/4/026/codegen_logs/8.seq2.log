+    fg_coords = np.argwhere(patch != bg)
+    for r0, c0 in _tile_positions(bbox, patch.shape, side, count):
+        abs_coords = fg_coords + np.array([r0, c0], dtype=int)
+        keep = (
+            (abs_coords[:, 0] >= 0)
