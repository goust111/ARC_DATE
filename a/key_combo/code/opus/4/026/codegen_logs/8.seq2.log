+        rows = [int(fixed_row)]
+    else:
+        rows = list(range(int(r0), int(r1) + 1))
+    if fixed_col is not None:
+        if not (c0 <= fixed_col <= c1):
+            return []
+        cols = [int(fixed_col)]
+    else:
