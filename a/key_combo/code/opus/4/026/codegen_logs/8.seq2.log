+    objects = _extract_objects(inp)
+    if len(objects) != len(specs):
+        return False
+
+    counts = [obj["count"] for obj in objects]
+    if len(set(counts)) != len(counts):
+        return False
+
+    by_color = {int(spec["color"]): spec for spec in specs}
+    for obj in objects:
+        spec = by_color.get(int(obj["color"]))
+        if spec is None:
+            return False
+        if obj["count"] != spec["count"] or obj["side"] != spec["side"]:
+            return False
+
+    footprints = {}
+    for spec in specs:
+        footprints[spec["color"]] = _footprint_mask(
+            inp.shape,
+            spec["bbox"],
+            spec["patch"],
+            spec["side"],
+            spec["count"],
+            bg,
+        )
+
+    overlaps = []
+    for i in range(len(specs)):
+        for j in range(i + 1, len(specs)):
+            a = specs[i]
+            b = specs[j]
+            inter = footprints[a["color"]] & footprints[b["color"]]
+            if inter.any():
+                overlaps.append((a, b, inter))
+    if not overlaps:
+        return False
+
+    if any(not np.any(out == spec["color"]) for spec in specs):
+        return False
+
+    if any(not np.any(footprints[spec["color"]] & ~np.logical_or.reduce([footprints[o["color"]] for o in specs if o["color"] != spec["color"]], initial=np.zeros(inp.shape, dtype=bool))) for spec in specs):
