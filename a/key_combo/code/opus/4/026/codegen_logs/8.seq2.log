+
+SIDE_TO_VEC = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+ROTATIONS_FROM_TOP = {"up": 0, "right": 3, "down": 2, "left": 1}
+SIDES = ("up", "right", "down", "left")
+GEN_COLORS = [1, 2, 3, 4]
