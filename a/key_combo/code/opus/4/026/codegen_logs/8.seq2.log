+
+    visible_overlap = False
+    for a, b, inter in overlaps:
+        top = a if a["count"] < b["count"] else b
+        if np.any(out[inter] == int(top["color"])):
+            visible_overlap = True
+            break
+    if not visible_overlap:
+        return False
+
+    return True
+
