+def _mask_signature(mask: np.ndarray) -> tuple[int, int, tuple[int, ...]]:
+    cropped = _crop_mask(mask)
+    return (
+        int(cropped.shape[0]),
+        int(cropped.shape[1]),
+        tuple(int(v) for v in cropped.astype(int).ravel()),
+    )
