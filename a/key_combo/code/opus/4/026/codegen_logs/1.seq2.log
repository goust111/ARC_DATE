+    for cell_info in cells:
+        if cell_info is key_cell:
+            continue
+        cell = cell_info["cell"]
+        mask = (cell != BLACK) & (cell != GREY)
+        color = palette[int(cell_info["orientation"])]
+        r0, r1, c0, c1 = cell_info["slice"]
+        patch = out[r0:r1, c0:c1]
+        patch[mask] = color
