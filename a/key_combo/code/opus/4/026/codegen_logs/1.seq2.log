+def _extract_cells(grid: np.ndarray) -> list[dict]:
+    row_bands, col_bands = _cell_bands(grid)
+    cells: list[dict] = []
+    for rr, (r0, r1) in enumerate(row_bands):
+        for cc, (c0, c1) in enumerate(col_bands):
+            cells.append(
+                {
+                    "grid_pos": (rr, cc),
+                    "slice": (r0, r1, c0, c1),
+                    "cell": grid[r0:r1, c0:c1].copy(),
+                }
+            )
+    return cells
