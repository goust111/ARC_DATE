+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PALETTE_COLORS = (BLUE, RED, GREEN, YELLOW)
+SPRITE_COLORS = (6, 7, 8, 9)
+CORNERS = ((0, 0), (0, 2), (2, 2), (2, 0))
+GRID_SIZE = 11
+CELL_SIZE = 3
+DIVIDERS = (3, 7)
