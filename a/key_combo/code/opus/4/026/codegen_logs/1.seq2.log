+    grid[DIVIDERS[0], :] = GREY
+    grid[DIVIDERS[1], :] = GREY
+    grid[:, DIVIDERS[0]] = GREY
+    grid[:, DIVIDERS[1]] = GREY
+
+    row_bands, col_bands = _cell_bands(grid)
+    family = _canonical_rotation_family(base_mask)
+    non_key_ptr = 0
