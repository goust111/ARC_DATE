+def _split_bands(length: int, dividers: list[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for divider in sorted(dividers):
+        if divider > start:
+            bands.append((start, divider))
+        start = divider + 1
+    if start < length:
+        bands.append((start, length))
+    return bands
