+def _parse_task(grid: np.ndarray) -> tuple[list[dict], dict, list[np.ndarray], list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    cells = _extract_cells(g)
