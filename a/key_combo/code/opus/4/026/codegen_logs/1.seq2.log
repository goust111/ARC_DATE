+    for bits in range(1 << 9):
+        area = bits.bit_count()
+        if area < 5 or area > 6:
+            continue
+        mask = np.zeros((CELL_SIZE, CELL_SIZE), dtype=bool)
+        for idx in range(9):
+            if (bits >> idx) & 1:
+                mask[idx // CELL_SIZE, idx % CELL_SIZE] = True
