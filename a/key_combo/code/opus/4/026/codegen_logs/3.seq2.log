+            "axis_h": int(axis_h),
+            "rect_w": int(rect_w),
+            "shape_h": int(h),
+            "shape_w": int(w),
+            "offset_r": int(offset_r),
+            "source_coords": source_coords,
+            "marker_on_reflected_shape": bool(reflected_mask[marker_local[0], marker_local[1]]),
