+import numpy as np
+
+
+BG = 0
+RED = 2
+YELLOW = 4
+MARKER_COLORS = (1, 3, 6, 7)
+DIRECTIONS = ("up", "down", "left", "right")
+HORIZONTAL_DIRECTIONS = {"left", "right"}
+VERTICAL_DIRECTIONS = {"up", "down"}
+
+GEN_GRID_H = (15, 22)
+GEN_GRID_W = (15, 22)
+GEN_OBJECT_COUNT = (3, 4)
+GEN_AXIS_H = (3, 5)
+GEN_MARKER_BIAS_OFFSHAPE = 0.75
+GEN_ATTEMPTS = 500
+GEN_UNIT_ATTEMPTS = 250
