    if not np.array_equal(actual, out):
        return None
    return inp


def generate_input():
    for _ in range(GENERATION_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("failed to generate valid 4acc7107 input")

