+        rr, cc = pos, c0
+        tr, tc = pos, c0 - 1
+    elif side == "right":
+        rr, cc = pos, c1
+        tr, tc = pos, c1 + 1
+    elif side == "top":
+        rr, cc = r0, pos
+        tr, tc = r0 - 1, pos
+    else:
+        rr, cc = r1, pos
+        tr, tc = r1 + 1, pos
