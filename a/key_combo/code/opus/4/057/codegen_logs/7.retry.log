+_ARC_UTILS_SPEC.loader.exec_module(_ARC_UTILS)
+
+Color = _ARC_UTILS.Color
+bbox_coords = _ARC_UTILS.bbox_coords
+bbox_w = _ARC_UTILS.bbox_w
+components_mask = _ARC_UTILS.components_mask
+crop_bbox = _ARC_UTILS.crop_bbox
