for miss in allcells:
    patterns.append(tuple(sorted([p for p in allcells if p"'!=miss])))
patterns=list(dict.fromkeys(patterns))

def place(specs):
    return [{(r0+r,c0+c) for r,c in pat} for r0,c0,pat in specs]

def mirror(cells,W):
    return {(r,W-1-c) for r,c in cells}

def mdist(a,b):
    return min(abs(r1-r2)+abs(c1-c2) for r1,c1 in a for r2,c2 in b)

def analyze(H,W,specs):
    cells_list=place(specs)
    for i in range(len(cells_list)):
        for j in range(i+1,len(cells_list)):
            if mdist(cells_list[i],cells_list[j])<2:return None
    fo=set().union(*cells_list)
    fm=mirror(fo,W)
    if fo & fm:return None
    g=np.zeros((H,W),dtype=bool)
    for r,c in fo|fm:
        if not (0<=r<H and 0<=c<W): return None
        g[r,c]=1
    lab,n=label(~g,STRUCT4)
    comps=[]
    for k in range(1,n+1):
        pts=np.argwhere(lab==k)
        r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
        comps.append((len(pts),(int(r0),int(c0),int(r1),int(c1)),pts))
    comps.sort(key=lambda x:(-x[0],x[1][0],x[1][1]))
    return comps

def outsig(comp):
    _,(r0,c0,r1,c1),pts=comp
    arr=np.zeros((r1-r0+1,c1-c0+1),dtype=np.uint8)
    for r,c in pts: arr[r-r0,c-c0]=5
    return (arr.shape, hashlib.md5(arr.tobytes()).hexdigest())

families=[
('"'four',[(2,5,((0,0),(1,0),(1,1))),(6,6,((0,0),(1,0))),(0,3,((0,0),(1,0),(1,1))),(4,10,((0,0),(0,1),(1,1)))],[(8,19)]),
('five',[(7,5,((0,0),(0,1),(1,1))),(6,3,((0,0),(0,1))),(0,2,((0,0),(0,1),(1,0))),(4,4,((0,1),(1,1))),(2,3,((0,0),(1,0),(1,1)))],[(9,W) for W in range(18,25)]),
('six',[(7,5,((0,0),(0,1),(1,1))),(3,7,((0,0),(0,1),(1,1))),(6,3,((0,0),(0,1))),(0,2,((0,0),(0,1),(1,0))),(4,4,((0,1),(1,1))),(2,3,((0,0),(1,0),(1,1)))],[(9,W) for W in range(18,25)]),
('tie',[(4,0,((0,0),(1,0),(1,1))),(4,2,((0,0),(0,1),(1,1))),(3,5,((1,0),(1,1))),(2,4,((0,0),(1,0))),(2,9,((1,0),(1,1))),(6,1,((0,1),(1,1)))],[(9,18),(11,18)]),
('backup1',[(4,0,((0,0),(1,0),(1,1))),(7,2,((0,0),(0,1))),(7,8,((0,0),(0,1))),(2,7,((0,1),(1,1))),(7,0,((1,0),(1,1))),(7,4,((1,0),(1,1)))],[(9,16)]),
]
for name,specs,shapes in families:
    for H,W in shapes:
        comps=analyze(H,W,specs)
        if comps is None: continue
        sizes=[c[0] for c in comps]
        if name=='tie':
            if not (len(comps)>=3 and sizes[0]==sizes[1]>sizes[2] and comps[0][1][0]"'!=comps[1][1][0]):
                continue
        else:
            if not (sizes[0]>sizes[1]):
                continue
        known.add(outsig(comps[0]))
print('"'known',len(known))
for trial in range(1200000):
    H=random.randint(8,11); W=random.randint(16,24); n=random.randint(4,6)
    positions=[(r,c) for r in range(H-1) for c in range(0,(2*W)//3 -1)]
    random.shuffle(positions)
    specs=[]; cells=[]
    for r0,c0 in positions:
        pat=random.choice(patterns)
        new={(r0+r,c0+c) for r,c in pat}
        if any(mdist(new,old)<2 for old in cells):
            continue
        fo=set().union(*cells,new)
        if fo & mirror(fo,W):
            continue
        specs.append((r0,c0,pat)); cells.append(new)
        if len(specs)==n: break
    if len(specs)"'!=n: continue
    comps=analyze(H,W,specs)
    if comps is None or len(comps)<3: continue
    sizes=[c[0] for c in comps]
    if not (sizes[0] > sizes[1] and len(set(sizes[:2]))==2):
        continue
    sig=outsig(comps[0])
    if sig in known: continue
    # all sprite removals matter
    ok=True
    for i in range(n):
        rc=analyze(H,W,specs[:i]+specs[i+1:])
        if rc is None or outsig(rc[0])==sig:
            ok=False; break
    if not ok: continue
    print('"'found',H,W,n,sizes[:4],comps[:3],specs)
    break
else:
    print('none')
