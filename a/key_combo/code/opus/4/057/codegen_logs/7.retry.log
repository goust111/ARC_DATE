            out=out_from_comp(comps[0])
            sig=(out.shape,out.tobytes())
            sigs.setdefault(sig,[]).append((name,H,W,roff,coff,sizes[:3]))
print('"'unique outputs',len(sigs))
for k,v in sigs.items():
