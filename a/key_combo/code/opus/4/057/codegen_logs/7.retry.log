        r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
        comps.append((len(pts),(int(r0),int(c0),int(r1),int(c1)),set(map(tuple,pts))))
    comps.sort(key=lambda x:(-x[0],x[1][0],x[1][1]))
    return comps[0]

for name,(H,W,specs) in TEMPLATES.items():
    base=select(H,W,specs)
    sig=(base[0],base[1],tuple(sorted(base[2])))
