'six':(9,20,[(7,5,((0,0),(0,1),(1,1))),(3,7,((0,0),(0,1),(1,1))),(6,3,((0,0),(0,1))),(0,2,((0,0),(0,1),(1,0))),(4,4,((0,1),(1,1))),(2,3,((0,0),(1,0),(1,1)))]),
