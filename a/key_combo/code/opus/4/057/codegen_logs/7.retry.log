    out=[]
    for r0,c0,pat in specs:
        out.append({(r0+r,c0+c) for r,c in pat})
    return out

def mirror(cells,W):
    return {(r,W-1-c) for r,c in cells}

def select(H,W,specs):
    occ=set().union(*place(specs))
    occ |= mirror(occ,W)
    g=np.zeros((H,W),dtype=bool)
