def place(specs,roff,coff):
    return [{(r0+roff+r,c0+coff+c) for r,c in pat} for r0,c0,pat in specs]

def mirror(cells,W):
    return {(r,W-1-c) for r,c in cells}

def mdist(a,b):
    return min(abs(r1-r2)+abs(c1-c2) for r1,c1 in a for r2,c2 in b)

def analyze(specs,H,W,roff,coff):
    cells_list=place(specs,roff,coff)
    for i in range(len(cells_list)):
        for j in range(i+1,len(cells_list)):
            if mdist(cells_list[i],cells_list[j])<2:return None
    fo=set().union(*cells_list)
    fm=mirror(fo,W)
    if fo & fm:return None
    g=np.zeros((H,W),dtype=bool)
    for r,c in fo|fm:
        if not (0<=r<H and 0<=c<W): return None
        g[r,c]=1
    lab,n=label(~g,STRUCT4)
    comps=[]
    for k in range(1,n+1):
        pts=np.argwhere(lab==k)
        r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
        comps.append((len(pts),(int(r0),int(c0),int(r1),int(c1)),pts))
    comps.sort(key=lambda x:(-x[0],x[1][0],x[1][1]))
    return comps

def out_from_comp(comp):
    _,(r0,c0,r1,c1),pts=comp
    out=np.zeros((r1-r0+1,c1-c0+1),dtype=int)
    for r,c in pts:
        out[r-r0,c-c0]=5
    return out

