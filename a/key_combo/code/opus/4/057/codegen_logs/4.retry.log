+        marker_cols = _marker_cols(axis_twice, width, cols)
+        if marker_cols is None:
+            continue
+
+        marker_row = int(rng.choice(rows))
+        markers = [(marker_row, int(marker_cols[0])), (marker_row, int(marker_cols[1]))]
