+    if not any(info["turns"] == 0 for info in infos):
+        return False
+    if not any(info["turns"] > 0 for info in infos):
+        return False
+    if not any(info["hits"] > 0 for info in infos):
+        return False
+    if np.count_nonzero(solved == FILL) == 0:
+        return False
+
+    profile = [count for count in _blue_profile(solved) if count > 0]
+    if len(set(profile)) < 2:
+        return False
