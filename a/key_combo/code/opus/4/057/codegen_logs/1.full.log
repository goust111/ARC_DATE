+            above = int(out[r - 1, c])
+            if ignore_blockers and above == BLOCKER:
+                above = BACKGROUND
+
+            if above == BACKGROUND:
+                r -= 1
+                out[r, c] = PATH
+                cells.append((r, c))
+                continue
+
+            if above == BLOCKER and not ignore_blockers:
+                hits += 1
+                nc = c + 1
+                if not in_bounds(out.shape, r, nc) or int(out[r, nc]) != BACKGROUND:
