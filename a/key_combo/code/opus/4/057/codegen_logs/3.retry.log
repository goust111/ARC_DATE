+    used_signatures = set()
+    for group in groups:
+        pr, pc, tile = _random_tile(rng, max(4, len(group) + 1))
+        signature = (pr, pc, tuple(map(int, tile.flatten())))
+        while signature in used_signatures:
+            pr, pc, tile = _random_tile(rng, max(4, len(group) + 1))
+            signature = (pr, pc, tuple(map(int, tile.flatten())))
+        used_signatures.add(signature)
+        for region in group:
