+
+def _primitive_period(tile: np.ndarray) -> Tuple[int, int]:
+    h, w = tile.shape
+    for pr in range(1, h + 1):
+        for pc in range(1, w + 1):
+            if h % pr != 0 or w % pc != 0:
+                continue
+            ok = True
+            for r in range(h):
+                for c in range(w):
+                    if tile[r, c] != tile[r % pr, c % pc]:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                return pr, pc
+    raise AssertionError("unreachable")
+
