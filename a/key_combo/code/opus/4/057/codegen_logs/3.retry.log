+
+
+def _apply_holes(
+    rng: random.Random,
+    full: np.ndarray,
+    spans: Sequence[Tuple[int, int]],
+    groups: Sequence[Sequence[int]],
+    region_tiles: Sequence[Tuple[int, int, np.ndarray]],
+    controls: Sequence[int],
+) -> np.ndarray:
