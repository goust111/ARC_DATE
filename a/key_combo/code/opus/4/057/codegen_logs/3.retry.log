+def _gen_attempt(rng: random.Random) -> Optional[np.ndarray]:
+    h, w, obstacle_cols, gap_rows, spans = _make_layout(rng)
+    controls, crossed_edges = _choose_controls(rng, spans, obstacle_cols)
