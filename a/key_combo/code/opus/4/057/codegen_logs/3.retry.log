+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+SPECIAL_COLORS = {BLACK, RED, GRAY}
+PATTERN_COLORS = [BLUE, GREEN, YELLOW, PINK, ORANGE, TEAL, MAROON]
