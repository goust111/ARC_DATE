+    if np.array_equal(inp, expected):
+        return None
+    if not _validate_instance(inp, expected, crossed_edges):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    seed = random.randrange(1 << 30)
+    rng = random.Random(seed)
+    for _ in range(GEN_ATTEMPTS):
