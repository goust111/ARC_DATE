+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+FRAME_COLOR = GREY
+START_COLOR = GREEN
+MARKER_COLORS = (BLUE, RED, GREEN)
