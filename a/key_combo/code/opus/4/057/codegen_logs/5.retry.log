    size = occupied.shape[0]
    choices = []
    for r0 in range(size - length):
        for c0 in range(size):
            c1 = c0 + step_c * length
            if not 0 <= c1 < size:
                continue
            cells = [(r0 + k, c0 + k * step_c) for k in range(length + 1)]
