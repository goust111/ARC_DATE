+        if seg & seen_segments:
+            return False
+        seen_segments |= seg
+
+    inp = _render_input(objects, shape)
+    orange_comps = _components(inp == ORANGE, connectivity=8)
+    if len(orange_comps) != len(objects) or any(comp.shape[0] != 2 for comp in orange_comps):
