    """Render one phase from placed tuples: 1 for output boxes, 2 for input boxes."""
    grid = np.full((GRID_SIZE, GRID_SIZE), BACKGROUND_COLOR, dtype=int)
    for item in placed:
        _draw_square(grid, item[0], item[box_index])
    return grid


def _gen_attempt():
