+    shape = (random.randint(*GRID_H_RANGE), random.randint(*GRID_W_RANGE))
+    objects = _build_objects(shape)
+    if objects is None:
+        return None
+    if not _validate_objects(objects, shape):
+        return None
+    return _render_input(objects, shape)
