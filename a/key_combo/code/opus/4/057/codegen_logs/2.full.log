+        return False
+
+    ranked = sorted(comps, key=lambda coords: (-int(coords.shape[0]), _bbox_coords(coords)[0], _bbox_coords(coords)[1]))
+    if len(ranked) < 2:
+        return False
+    top_area = int(ranked[0].shape[0])
+    second_area = int(ranked[1].shape[0])
+    if expect_tie:
+        if top_area != second_area:
