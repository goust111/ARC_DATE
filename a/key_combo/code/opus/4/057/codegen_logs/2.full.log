+            if overlap and (overlap & inter_i or overlap & {segments[j]["cells"][0], segments[j]["cells"][-1]}):
+                return False
+    return True
+
+
+def _has_cross_or_close_opposites(segments: list[dict]) -> bool:
+    for i, seg_a in enumerate(segments):
