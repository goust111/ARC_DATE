    right_steps = random.randint(SEGMENT_LEN_RANGE[0], R - 1)
    left_steps, right_steps = _force_one_arm_to_bottom(left_steps, right_steps, R - 1)
    return [
        _gen_line(0, 0, -1, left_steps),
        _gen_line(0, 0, 1, right_steps),
    ]


