    segments = [
        _gen_line(0, 0, 1, merge_r),
        _gen_line(0, 2 * merge_r, -1, merge_r),
    ]
    if merge_r < R - 1:
        segments.append(_gen_line(merge_r, merge_r, random.choice(DIAGONAL_DIRECTIONS), R - 1 - merge_r))
    return segments


