+            candidates.append(coord)
+
+    random.shuffle(candidates)
+    chosen: list[Coord] = []
+    for coord in candidates:
+        if any(max(abs(coord[0] - other[0]), abs(coord[1] - other[1])) <= 1 for other in chosen):
+            continue
+        chosen.append(coord)
+        if len(chosen) == arm:
+            return chosen
+    return None
+
