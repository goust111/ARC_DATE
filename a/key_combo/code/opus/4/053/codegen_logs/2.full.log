+    return pairs
+
+
+def _sample_red_points(
+    height: int,
+    width: int,
+    arm: int,
+    forbidden: set[Coord],
+    centers: list[Coord],
+) -> list[Coord] | None:
+    candidates = []
+    for r in range(height):
+        for c in range(width):
+            coord = (r, c)
+            if coord in forbidden:
+                continue
+            if any(max(abs(r - mr), abs(c - mc)) <= RED_SAFE_DISTANCE for mr, mc in centers):
+                continue
