+        endpoints = lambda span: ((r - span, c), (r + span, c))
+
+    candidates = list(range(min_halfspan, max_halfspan + 1))
+    random.shuffle(candidates)
+    for span in candidates:
+        a, b = endpoints(span)
+        if a in forbidden or b in forbidden:
+            continue
+        return span
+    return None
+
+
