+
+def _sample_centers(height: int, width: int, arm: int, pair_count: int) -> list[Coord] | None:
+    candidates = [
+        (r, c)
+        for r in range(arm, height - arm)
+        for c in range(arm, width - arm)
+    ]
+    random.shuffle(candidates)
