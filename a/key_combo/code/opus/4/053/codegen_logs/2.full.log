+    assert arm >= 1
+
+    blue_coords = [tuple(map(int, coord)) for coord in np.argwhere(g == BLUE)]
+    pairs = _solve_blue_pairs(blue_coords)
+    return _render_output_from_pairs(g, pairs, arm)
