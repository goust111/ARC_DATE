+    occupied: set[Coord] = set()
+    for center in candidates:
+        cells = _cross_cells(center, arm)
+        if occupied & cells:
+            continue
+        centers.append(center)
+        occupied |= cells
+        if len(centers) == pair_count:
+            return centers
+    return None
+
+
