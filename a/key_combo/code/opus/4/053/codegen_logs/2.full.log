+    if not np.array_equal(actual, expected):
+        return False
+
+    alt_arm = arm + 1 if arm < MAX_ARM else arm - 1
+    if alt_arm >= 1:
+        alt = _render_output_from_pairs(inp, list(actual_pairs), alt_arm)
