ANCHOR_COUNTS = (2, 3)
SINGLE_COPY_THREE_ANCHOR_PROB, MULTI_COPY_THREE_ANCHOR_PROB = 0.45, 0.50
MULTI_COPY_THREE_ANCHOR_AREA_THRESHOLD = 5

