        h_ok = ROTATED_HEIGHT_RANGE[0] <= rotated.shape[0] <= ROTATED_HEIGHT_RANGE[1]
        w_ok = ROTATED_WIDTH_RANGE[0] <= rotated.shape[1] <= ROTATED_WIDTH_RANGE[1]
