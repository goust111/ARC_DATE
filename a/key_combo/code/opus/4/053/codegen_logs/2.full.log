+
+def _solve_blue_pairs(blue_coords: list[Coord]) -> list[Pair]:
+    coords = sorted(_sorted_coord(coord) for coord in blue_coords)
+    assert MIN_PAIRS * 2 <= len(coords) <= MAX_PAIRS * 2 and len(coords) % 2 == 0
