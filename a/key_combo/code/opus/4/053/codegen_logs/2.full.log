+    if not np.array_equal(actual, expected):
+        return False
+
+    alt_candidates = [candidate for candidate in (arm - 1, arm + 1) if candidate >= 1]
+    alt_arm = next(
+        (
+            candidate
+            for candidate in alt_candidates
