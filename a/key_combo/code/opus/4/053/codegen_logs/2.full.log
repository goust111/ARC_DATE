+            gap = abs(a[1] - b[1])
+            if gap >= MIN_PAIR_GAP and gap % 2 == 0:
+                candidates.append(_canonical_pair(a, b))
+        elif a[1] == b[1]:
+            gap = abs(a[0] - b[0])
+            if gap >= MIN_PAIR_GAP and gap % 2 == 0:
