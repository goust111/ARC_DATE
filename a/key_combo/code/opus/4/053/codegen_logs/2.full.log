+        if np.array_equal(alt, expected):
+            return False
+
+    wrong_centers = [_pair_midpoint(pair) for pair in actual_pairs]
+    replacement = _wrong_center(wrong_centers[0], arm, inp.shape)
+    if replacement is None:
