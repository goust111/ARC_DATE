+        placed[idx] = pair
+        used_blue.update(pair)
+
+    for idx in range(len(centers)):
+        pairs.append(placed[idx])
+    return pairs
+
+
+def _sample_red_points(
+    height: int,
+    width: int,
+    arm: int,
+    forbidden: set[Coord],
+    centers: list[Coord],
+) -> list[Coord] | None:
