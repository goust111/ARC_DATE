+
+def _wrong_center(center: Coord, arm: int, shape: tuple[int, int]) -> Coord | None:
+    height, width = shape
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        nr = center[0] + dr
+        nc = center[1] + dc
