+    return None
+
+
+def _axes_for_mode(mode: str, pair_count: int) -> list[str]:
+    if mode == "horizontal":
+        return ["h"] * pair_count
+    if mode == "vertical":
+        return ["v"] * pair_count
+    axes = ["h", "v"]
+    if pair_count == 3:
+        axes.append(random.choice(["h", "v"]))
+    random.shuffle(axes)
+    return axes
+
+
+def _sample_halfspan(
+    center: Coord,
+    axis: str,
+    shape: tuple[int, int],
+    arm: int,
+    forbidden: set[Coord],
