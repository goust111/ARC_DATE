+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_HEIGHT_RANGE)
+    width = random.randint(*HALF_WIDTH_RANGE)
+    color_a, color_b = random.choice(FOREGROUND_PAIRS)
