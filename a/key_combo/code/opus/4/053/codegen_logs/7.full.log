+def _compose_grid(
+    left: np.ndarray,
+    color_a: int,
+    color_b: int,
+    diff_coords: list[tuple[int, int]],
+    left_only_coords: list[tuple[int, int]],
+    right_only_coords: list[tuple[int, int]],
