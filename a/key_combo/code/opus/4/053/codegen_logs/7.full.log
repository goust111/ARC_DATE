+    for _ in range(shape_count):
+        shape = random.choice(_ALL_SHAPE_VARIANTS)
+        placed = False
+        for _ in range(80):
+            r0 = random.randint(0, height - shape.shape[0])
+            c0 = random.randint(0, width - shape.shape[1])
+            if _can_place(mask, shape, r0, c0):
+                _stamp(mask, shape, r0, c0)
