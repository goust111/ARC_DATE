+        return False
+    cells = np.argwhere(shape)
+    for dr, dc in cells:
+        rr = int(r0 + dr)
+        cc = int(c0 + dc)
+        r1 = max(0, rr - 1)
+        r2 = min(mask.shape[0], rr + 2)
+        c1 = max(0, cc - 1)
+        c2 = min(mask.shape[1], cc + 2)
