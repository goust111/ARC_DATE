 140: def _gen_attempt() -> np.ndarray | None:
 141:     """Single attempt to generate a valid input for task 142ca369.
 142: 
 143:     Output-first: for each arrow, plan the full zigzag ray path (with 0-4 side-touch
 144:     bounces), place walls at bounce points, then derive the input (arrows + walls).
 145:     """
 146:     H, W = _rng.randint(18, 20), _rng.randint(18, 20)
 147:     n_arrows = _rng.randint(1, 7)
 148:     palette = list(range(1, 10))
 149:     _rng.shuffle(palette)
 150:     arrow_colors = palette[:n_arrows]
 151: 
 152:     grid = np.zeros((H, W), dtype=int)
 153:     out = np.zeros((H, W), dtype=int)
 154:     occupied: set[tuple[int, int]] = set()
 155: 
 156:     for ai in range(n_arrows):
 157:         color = arrow_colors[ai]
 158:         dr, dc = _rng.choice([-1, 1]), _rng.choice([-1, 1])
 159:         n_bounces = _rng.choices([0, 1, 2, 3, 4], weights=[2, 3, 3, 2, 1])[0]
 160: 
 161:         placed = False
 162:         for _ in range(60):
 163:             # Start position with room for the 2x2 arrow bbox
 164:             r_lo, r_hi = (1 if dr == -1 else 0), (H - 2 if dr == 1 else H - 1)
 165:             c_lo, c_hi = (1 if dc == -1 else 0), (W - 2 if dc == 1 else W - 1)
 166:             if r_lo > r_hi or c_lo > c_hi:
 167:                 continue
 168:             sr, sc = _rng.randint(r_lo, r_hi), _rng.randint(c_lo, c_hi)
 169: 
 170:             # Arrow = 3 corners of 2x2 bbox, missing corner opposite to fire direction
 171:             mr, mc = sr - dr, sc - dc
 172:             arrow_pts = [(r, c) for r in (mr, sr) for c in (mc, sc) if (r, c) != (mr, mc)]
 173:             if any(not (0 <= r < H and 0 <= c < W) or (r, c) in occupied for r, c in arrow_pts):
 174:                 continue
 175: 
 176:             # Trace ray path with planned bounces
 177:             cur_r, cur_c, cur_dr, cur_dc, cur_col = sr, sc, dr, dc, color
 178:             ray_cells: list[tuple[int, int, int]] = []
 179:             walls: list[tuple[list[tuple[int, int]], int]] = []
 180:             ray_set: set[tuple[int, int]] = set()
 181:             arrow_set = set(arrow_pts)
 182:             ok = True
 183:             bounces_left = n_bounces
 184: 
 185:             for seg_idx in range(n_bounces + 1):
 186:                 max_steps = min(
 187:                     (H - 1 - cur_r) if cur_dr == 1 else cur_r,
 188:                     (W - 1 - cur_c) if cur_dc == 1 else cur_c,
 189:                 )
 190:                 if seg_idx < n_bounces and bounces_left > 0:
 191:                     if max_steps < 4:
 192:                         bounces_left = 0
 193:                         seg_len = max_steps
 194:                     else:
 195:                         seg_len = _rng.randint(3, max(3, max_steps - 1))
 196:                 else:
 197:                     seg_len = max_steps
 198: 
 199:                 for _ in range(seg_len):
 200:                     nr, nc = cur_r + cur_dr, cur_c + cur_dc
 201:                     if not (0 <= nr < H and 0 <= nc < W):
 202:                         break
 203:                     if (nr, nc) in occupied or (nr, nc) in ray_set or (nr, nc) in arrow_set:
