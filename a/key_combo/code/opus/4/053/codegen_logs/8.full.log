  82: # Canvas and region geometry.
  83: MIN_GRID_SIZE, MAX_GRID_SIZE = 9, 16
  84: REGION_SIZE, INTERIOR_SIZE, REGION_GAP = 5, 3, 1
  85: 
  86: # Region count and interior-hole sampling.
  87: MIN_REGIONS, MAX_REGIONS = 1, 4
  88: MIN_TEAL_INTERIOR, MAX_TEAL_INTERIOR = 1, 6
  89: MAX_AREA_PER_REGION = 48
  90: 
  91: # Generation retry limit and colors.
  92: MAX_GENERATION_ATTEMPTS = 300
  93: GEN_BG, GEN_FG = Color.TEAL, Color.BLACK
  94: GEN_PATCH = np.full((REGION_SIZE, REGION_SIZE), GEN_FG, dtype=int)
  95: GEN_INTERIOR = [
  96:     (rr, cc) for rr in range(INTERIOR_SIZE) for cc in range(INTERIOR_SIZE)
  97: ]
