  10: def _nearest_non_overlapping_shift(coords: np.ndarray, occupied: np.ndarray) -> tuple[int, int]:
  11:     H, W = occupied.shape
  12: 
  13:     def valid(dr: int, dc: int) -> bool:
  14:         rr = coords[:, 0] + int(dr)
  15:         cc = coords[:, 1] + int(dc)
  16:         return (
  17:             int(rr.min()) >= 0
  18:             and int(cc.min()) >= 0
  19:             and int(rr.max()) < H
  20:             and int(cc.max()) < W
  21:             and not bool(occupied[rr, cc].any())
  22:         )
  23: 
  24:     if valid(0, 0):
  25:         return 0, 0
  26: 
  27:     candidates: list[tuple[int, int, int]] = []
  28:     for dr in range(-(H - 1), H):
  29:         for dc in range(-(W - 1), W):
  30:             if valid(dr, dc):
  31:                 candidates.append((abs(int(dr)) + abs(int(dc)), int(dr), int(dc)))
  32: 
  33:     assert candidates, "sprite must have a non-overlapping placement"
  34:     best_distance = min(dist for dist, _dr, _dc in candidates)
  35:     best = [(dr, dc) for dist, dr, dc in candidates if dist == best_distance]
  36:     assert len(best) == 1, "nearest non-overlapping placement must be unique"
  37:     return best[0]
  38: 
