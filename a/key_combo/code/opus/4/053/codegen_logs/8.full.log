  22: def main(grid: np.ndarray) -> np.ndarray:
  23:     """
  24:     Mark the center of each odd-sized solid square with the plus marker color, erasing the marker only when it is outside the marked-center field.
  25: 
  26:     Input structure:
  27:     - The dominant color is background.
  28:     - Exactly two foreground colors are present: one unique 3x3 plus marker and one color forming separated solid square objects.
  29: 
  30:     Rule:
  31:     - For every non-marker 4-connected object, assert it is a solid square.
  32:     - If the square side length is odd, recolor its center pixel to the plus marker color; even-sided squares stay unchanged.
  33:     - Preserve the plus marker when its center lies inside the bounding box of the odd-square centers; otherwise erase it to background.
  34: 
  35:     Key insight:
  36:     - Odd-sided solid squares have a single visible center pixel, and the plus supplies the color used to identify those centers.
  37:     """
  38:     g = np.asarray(grid, dtype=int)
  39:     bg = int(get_bg(g))
  40:     comps = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  41: 
  42:     markers = [comp for comp in comps if _is_plus_marker(comp)]
  43:     assert len(markers) == 1, "grid must contain exactly one 5-pixel plus marker"
  44:     marker = markers[0]
  45:     marker_color = int(marker["color"])
  46: 
  47:     fg_colors = set(map(int, g.flatten())) - {bg}
  48:     assert marker_color in fg_colors
  49:     object_colors = fg_colors - {marker_color}
  50:     assert len(object_colors) == 1, "all solid square objects must share one non-marker color"
  51:     object_color = object_colors.pop()
  52: 
  53:     out = g.copy()
  54:     odd_centers: list[tuple[int, int]] = []
  55: 
  56:     for comp in comps:
  57:         if comp is marker:
  58:             continue
  59:         assert int(comp["color"]) == object_color, "unexpected foreground object color"
  60:         r0, c0, r1, c1 = comp["bbox"]
  61:         h = int(r1 - r0 + 1)
  62:         w = int(c1 - c0 + 1)
  63:         assert h == w, "foreground objects must be square"
  64:         assert int(comp["area"]) == h * w, "foreground square objects must be solid"
  65:         if h % 2 == 1:
  66:             rr = int(r0 + h // 2)
  67:             cc = int(c0 + w // 2)
  68:             assert int(g[rr, cc]) == object_color
  69:             odd_centers.append((rr, cc))
  70:             out[rr, cc] = marker_color
  71: 
  72:     assert odd_centers, "at least one odd-sided square must be present"
