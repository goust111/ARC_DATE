  17: def main(grid: np.ndarray) -> np.ndarray:
  18:     """Expand each 3-pixel L marker into a same-color corner L on an empty background.
  19: 
  20:     Input structure
  21:     - The grid is an odd square with one dominant background color.
  22:     - Every foreground object is a monochromatic 4-connected 3-pixel L inside a
  23:       2x2 box.
  24: 
  25:     Rule
  26:     - Clear the grid to the background.
  27:     - For each marker, map its L orientation to the corresponding outer corner
  28:       and draw that corner L in the marker color with arm length half the grid.
  29: 
  30:     Key insight
  31:     - The small marker is a miniature corner; its orientation, not its position,
  32:       chooses which outer corner receives the expanded L.
  33:     """
  34:     g = np.asarray(grid, dtype=int)
  35:     assert g.ndim == 2
  36:     h, w = g.shape
  37:     assert h == w and h % 2 == 1
  38: 
  39:     bg = get_bg(g)
  40:     out = np.full_like(g, bg)
  41:     arm = h // 2
  42: 
  43:     seen_corners: set[str] = set()
  44:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
  45:     assert components
  46: 
  47:     for comp in components:
  48:         assert comp["area"] == 3
  49:         r0, c0, r1, c1 = comp["bbox"]
  50:         assert (r1 - r0, c1 - c0) == (1, 1)
  51: 
  52:         local = frozenset(
  53:             (int(r) - r0, int(c) - c0) for r, c in comp["coords"]
  54:         )
  55:         assert local in _LOCAL_TO_CORNER
  56:         corner = _LOCAL_TO_CORNER[local]
  57:         assert corner not in seen_corners
  58:         seen_corners.add(corner)
  59: 
  60:         color = int(comp["color"])
  61:         if corner == "top_left":
  62:             out[0, :arm] = color
  63:             out[:arm, 0] = color
  64:         elif corner == "top_right":
  65:             out[0, w - arm :] = color
  66:             out[:arm, w - 1] = color
  67:         elif corner == "bottom_left":
  68:             out[h - arm :, 0] = color
  69:             out[h - 1, :arm] = color
  70:         else:
  71:             assert corner == "bottom_right"
  72:             out[h - arm :, w - 1] = color
  73:             out[h - 1, w - arm :] = color
  74: 
  75:     assert seen_corners == set(_LOCAL_TO_CORNER.values())
  76:     return out
