   5: def main(grid: np.ndarray) -> np.ndarray:
   6:     """
   7:     Trace diagonal rays from triangular arrows, reflecting off colored wall pixels.
   8: 
   9:     Input structure:
  10:     - bg grid with monochrome 3-pixel L-shaped "arrows" (2x2 bbox missing one corner) and scattered colored wall pixels.
  11: 
  12:     Rule:
  13:     - Each arrow fires a ray diagonally away from its missing corner, painting bg cells in its color.
  14:     - A head-on wall hit reverses both axes; a side-touch wall hit flips the touched axis only.
  15:     - On any bounce the ray adopts the wall's color and recolors the contact cell.
  16:     - Ray stops when it exits the grid or reaches another arrow.
  17: 
  18:     Key insight: Two distinct reflection types (corner vs side-touch) plus color inheritance at each bounce drive the path geometry.
  19:     """
  20:     g = np.array(grid, dtype=int)
  21:     H, W = g.shape
  22:     bg = int(get_bg(g))
  23: 
  24:     def is_arrow_pts(pts: list[tuple[int, int]]) -> bool:
  25:         if len(pts) != 3:
  26:             return False
  27:         rs = [r for r, _c in pts]
  28:         cs = [c for _r, c in pts]
  29:         return (max(rs) - min(rs) == 1) and (max(cs) - min(cs) == 1)
  30: 
  31:     def arrow_dir_and_start(pts: list[tuple[int, int]]):
  32:         rs = [r for r, _c in pts]
  33:         cs = [c for _r, c in pts]
  34:         r0, r1 = min(rs), max(rs)
  35:         c0, c1 = min(cs), max(cs)
  36:         corners = [(r0, c0), (r0, c1), (r1, c0), (r1, c1)]
  37:         miss = [p for p in corners if p not in set(pts)]
  38:         if len(miss) != 1:
  39:             return None
  40:         mr, mc = miss[0]
  41:         # direction away from missing corner
  42:         dr = 1 if mr == r0 else -1
  43:         dc = 1 if mc == c0 else -1
  44: 
  45:         pts_set = set(pts)
  46:         deg = {p: 0 for p in pts}
  47:         for r, c in pts:
  48:             for rr, cc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
  49:                 if (rr, cc) in pts_set:
  50:                     deg[(r, c)] += 1
  51:         start = max(deg, key=lambda p: deg[p])  # right-angle corner
  52:         return (int(dr), int(dc)), (int(start[0]), int(start[1]))
  53: 
  54:     # Detect arrows per-color (cannot rely on global non-bg connectivity).
  55:     arrow_cells: set[tuple[int, int]] = set()
  56:     arrows: list[tuple[int, list[tuple[int, int]]]] = []
  57:     for col in colors_present(g, exclude={bg}):
  58:         for coords in components_mask(g == int(col), connectivity=4):
  59:             pts = [(int(r), int(c)) for r, c in coords]
  60:             if is_arrow_pts(pts):
  61:                 arrows.append((int(col), pts))
  62:                 arrow_cells |= set(pts)
  63: 
  64:     wall_cells: set[tuple[int, int]] = {
  65:         (int(r), int(c)) for r, c in np.argwhere(g != int(bg)) if (int(r), int(c)) not in arrow_cells
  66:     }
  67: 
  68:     out = g.copy()
  69: 
  70:     for start_col, pts in arrows:
  71:         info = arrow_dir_and_start(pts)
  72:         if info is None:
  73:             continue
  74:         (dr, dc), cur = info
  75:         cur_col = int(start_col)
  76:         seen = set()
  77: 
  78:         while True:
  79:             state = (cur, int(dr), int(dc), int(cur_col))
  80:             if state in seen:
  81:                 break
  82:             seen.add(state)
  83: 
  84:             nr = int(cur[0] + dr)
  85:             nc = int(cur[1] + dc)
