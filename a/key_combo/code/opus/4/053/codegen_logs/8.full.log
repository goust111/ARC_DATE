 222: def _gen_items(colors: list[int], masks: tuple[np.ndarray, np.ndarray], counts: tuple[int, int]) -> list[tuple[int, np.ndarray, np.ndarray]]:
 223:     color_a, color_b = colors
 224:     mask_a, mask_b = masks
 225:     count_a, count_b = counts
 226:     sep_mask = mask_a | mask_b
 227:     return [(color_a, mask_a, sep_mask)] * count_a + [(color_b, mask_b, sep_mask)] * count_b
