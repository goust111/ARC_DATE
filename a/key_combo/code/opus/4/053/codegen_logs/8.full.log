 106: def main(grid: np.ndarray) -> np.ndarray:
 107:     """
 108:     Complete every colored fragment into a translated copy of the unique largest foreground template.
 109: 
 110:     Input structure
 111:     - A uniform background contains one complete monochromatic template mask and smaller same-orientation fragments in other colors.
 112:     - A color may contain more than one separated fragment; each fragment has at least two pixels.
 113:     - All completed copies fit inside the grid and do not overlap other foreground pixels.
 114: 
 115:     Rule
 116:     - Use the unique foreground color with the most pixels as the template mask.
 117:     - For each other color, find the unique minimum set of translated template placements whose existing template cells cover that color's input pixels.
 118:     - Paint every cell of those placements with that color, leaving the template and background otherwise unchanged.
 119: 
 120:     Key insight
 121:     The incomplete colors are partial masks of the same template; their existing pixels act as anchors that determine where the missing cells must be filled.
 122:     """
 123:     g = np.asarray(grid, dtype=int)
 124:     bg = int(get_bg(g))
 125:     colors = [int(color) for color in np.unique(g) if int(color) != bg]
 126:     assert colors, "expected foreground colors"
 127: 
 128:     counts = {color: int(np.count_nonzero(g == color)) for color in colors}
 129:     template_area = max(counts.values())
 130:     template_colors = [color for color, area in counts.items() if area == template_area]
 131:     assert len(template_colors) == 1, "largest foreground template color must be unique"
 132:     template_color = template_colors[0]
