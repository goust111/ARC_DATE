  42: def main(grid: np.ndarray) -> np.ndarray:
  43:     """
  44:     Exchange the two foreground sprite masks while keeping every copy in its original bounding box.
  45: 
  46:     Input structure:
  47:     - The dominant color is the background.
  48:     - Exactly two foreground colors are present.
  49:     - Each foreground color forms one or more copies of a single 8-connected sprite mask.
  50:     - The two sprite masks have the same bounding-box size.
  51: 
  52:     Rule:
  53:     - Clear every sprite bounding box.
  54:     - In each cleared box, draw the other foreground color's template mask in that other color.
  55:     - Apply the replacements simultaneously, so all original boxes are cleared before any template is redrawn.
  56: 
  57:     Key insight:
  58:     The colors identify two reusable sprite templates, and each template is the replacement shape for the other color.
  59:     """
  60:     g = np.asarray(grid, dtype=int)
  61:     bg = get_bg(g)
  62:     colors = colors_present(g, exclude={bg})
  63:     assert len(colors) == 2, "expected exactly two foreground colors"
  64: 
  65:     copies = _sprite_copies_by_color(g, bg, colors)
  66:     templates = _templates(copies, colors)
  67: 
  68:     color_a, color_b = colors
  69:     assert templates[color_a].shape == templates[color_b].shape, "the two templates must fit the same bboxes"
  70:     other_color = {color_a: color_b, color_b: color_a}
  71: 
  72:     out = g.copy()
  73:     for color in colors:
  74:         for (r0, c0, r1, c1), _mask in copies[color]:
  75:             out[r0 : r1 + 1, c0 : c1 + 1] = bg
  76: 
  77:     for color in colors:
  78:         target_color = other_color[color]
  79:         target_mask = templates[target_color]
  80:         patch = np.full(target_mask.shape, bg, dtype=int)
  81:         patch[target_mask] = target_color
  82:         for (r0, c0, _r1, _c1), _mask in copies[color]:
  83:             paste(out, patch, r0, c0)
  84: 
  85:     return out
  86: 
