 176: def _gen_place_boxes(height: int, width: int, items, shape: tuple[int, int]):
 177:     """Place boxes without bbox overlap or same-color 8-touching cells."""
 178:     h, w = shape
 179:     positions = [
 180:         (r, c) for r in range(EDGE_GAP, height - h - EDGE_GAP + 1) for c in range(EDGE_GAP, width - w - EDGE_GAP + 1)
 181:     ]
 182:     random.shuffle(items)
 183:     counts = {color: sum(1 for item_color, _mask, _sep in items if item_color == color) for color, _mask, _sep in items}
 184:     items.sort(key=lambda item: -counts[item[0]])
 185:     placed: list[tuple[int, np.ndarray, np.ndarray, int, int, list[tuple[int, int]]]] = []
 186:     nodes = 0
 187: 
 188:     def search(idx: int) -> bool:
 189:         nonlocal nodes
 190:         nodes += 1
 191:         if nodes > PLACEMENT_NODE_LIMIT:
 192:             return False
 193:         if idx == len(items):
 194:             return True
 195: 
 196:         item = items[idx]
 197:         candidates = positions[:]
 198:         random.shuffle(candidates)
 199:         for r0, c0 in candidates:
 200:             color, mask, sep_mask = item
 201:             new_cells = _gen_cells(sep_mask, r0, c0)
 202:             if not _gen_can_place(placed, item, r0, c0, shape, new_cells):
 203:                 continue
 204:             placed.append((color, mask, sep_mask, r0, c0, new_cells))
 205:             if search(idx + 1):
 206:                 return True
 207:             placed.pop()
 208:         return False
 209: 
 210:     if not search(0):
 211:         return None
 212:     return [(color, mask, r0, c0) for color, mask, _sep, r0, c0, _cells in placed]
 213: 
