 211:                 if seg_idx >= n_bounces or bounces_left <= 0:
 212:                     continue
 213:                 bounces_left -= 1
 214: 
 215:                 # Collect feasible wall placements for this bounce
 216:                 options: list[tuple[list[tuple[int, int]], str]] = []
