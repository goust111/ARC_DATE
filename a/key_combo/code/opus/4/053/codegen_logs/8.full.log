 146: def _gen_rect_overlap(a: tuple[int, int], b: tuple[int, int], shape: tuple[int, int]) -> bool:
 147:     ar, ac = a
 148:     br, bc = b
 149:     h, w = shape
 150:     return not (ar + h <= br or br + h <= ar or ac + w <= bc or bc + w <= ac)
 151: 
 152: 
 153: def _gen_cells(mask: np.ndarray, r0: int, c0: int) -> list[tuple[int, int]]:
 154:     return [(int(r0 + r), int(c0 + c)) for r, c in np.argwhere(mask)]
 155: 
 156: 
 157: def _gen_touching(cells_a: list[tuple[int, int]], cells_b: list[tuple[int, int]]) -> bool:
 158:     for ar, ac in cells_a:
 159:         for br, bc in cells_b:
 160:             if abs(ar - br) <= 1 and abs(ac - bc) <= 1:
 161:                 return True
 162:     return False
 163: 
 164: 
 165: def _gen_can_place(placed, item, r0: int, c0: int, shape: tuple[int, int], new_cells) -> bool:
 166:     color = item[0]
 167:     for old_color, _old_mask, _old_sep, old_r, old_c, old_cells in placed:
 168:         if _gen_rect_overlap((r0, c0), (old_r, old_c), shape):
 169:             return False
 170:         if old_color == color:
 171:             if _gen_touching(new_cells, old_cells):
 172:                 return False
 173:     return True
 174: 
