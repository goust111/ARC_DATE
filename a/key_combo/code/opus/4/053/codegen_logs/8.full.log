  19: def main(grid: np.ndarray) -> np.ndarray:
  20:     """
  21:     Fill each black 5x5 region's missing interior positions with a fixed 3x3 positional color legend.
  22: 
  23:     Input structure
  24:     - The grid uses teal as the dominant background and black for one or more
  25:       5x5 regions.
  26:     - Each black region has a black one-pixel border and a 3x3 interior that
  27:       may already contain teal pixels.
  28: 
  29:     Rule
  30:     - Overlay the legend 1 7 6 / 4 8 5 / 2 9 3 on the 3x3 interior of every
  31:       5x5 black region.
  32:     - Wherever an interior non-center legend position is still black, recolor it
  33:       to the corresponding legend color; leave existing teal pixels, the center,
  34:       and the black border unchanged.
  35: 
  36:     Key insight
  37:     - The colored output pixels are not derived from the teal motif shape; they
  38:       are the fixed position labels for the missing cells of each 3x3 interior.
  39:     """
  40:     g = np.asarray(grid, dtype=int)
  41:     assert g.ndim == 2
  42: 
  43:     bg = get_bg(g)
  44:     assert bg == Color.TEAL
  45:     fg_colors = colors_present(g, exclude={bg})
  46:     assert fg_colors == [Color.BLACK]
  47: 
  48:     out = g.copy()
  49:     components = find_components(
  50:         g,
  51:         bg=bg,
  52:         connectivity=8,
  53:         monochromatic=True,
  54:         colors=[Color.BLACK],
  55:     )
