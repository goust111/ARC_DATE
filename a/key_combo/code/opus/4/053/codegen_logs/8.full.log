  58:     for component in components:
  59:         b = component["bbox"]
  60:         assert bbox_h(b) == 5 and bbox_w(b) == 5
  61:         r0, c0, _r1, _c1 = b
  62:         patch = crop_bbox(g, b)
  63:         assert np.all((patch == Color.BLACK) | (patch == bg))
  64:         assert np.all(patch[[0, -1], :] == Color.BLACK)
  65:         assert np.all(patch[:, [0, -1]] == Color.BLACK)
  66:         assert np.any(patch[1:4, 1:4] == bg)
  67: 
  68:         for rr in range(3):
  69:             for cc in range(3):
  70:                 color = int(LEGEND[rr, cc])
