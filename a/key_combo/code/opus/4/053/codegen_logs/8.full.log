 179: def _gen_is_asymmetric(mask: np.ndarray) -> bool:
 180:     if np.array_equal(mask, np.flipud(mask)):
 181:         return False
 182:     if np.array_equal(mask, np.fliplr(mask)):
 183:         return False
 184:     if mask.shape[0] == mask.shape[1]:
 185:         if np.array_equal(mask, mask.T):
 186:             return False
 187:         if np.array_equal(mask, np.rot90(mask)):
 188:             return False
 189:         if np.array_equal(mask, np.fliplr(mask).T):
 190:             return False
 191:     return True
 192: 
