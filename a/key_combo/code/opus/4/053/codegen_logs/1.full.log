+
+
+def _eligible_fragments(full_local, visible_local, hidden_local):
+    eligible = []
+    for subset in _connected_subsets(full_local, FRAGMENT_SIZE_RANGE[1]):
+        if len(subset) < FRAGMENT_SIZE_RANGE[0]:
