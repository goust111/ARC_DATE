+def _connected_subsets(coords, max_size: int):
+    cells = sorted((int(r), int(c)) for r, c in coords)
+    cell_set = set(cells)
+    seen = set()
+    for start in cells:
+        subset = frozenset([start])
+        if subset in seen:
+            continue
+        seen.add(subset)
+        stack = [subset]
+        while stack:
+            cur = stack.pop()
+            if 2 <= len(cur) <= max_size:
