+    assert len({arrow["dir"] for arrow in arrows}) == 2, "arrow directions must differ"
+    return arrows, walls, arrow_cells
+
+
+def _ray_state(arrow: dict) -> dict:
+    return {
+        "pos": tuple(arrow["start"]),
+        "dir": tuple(arrow["dir"]),
+        "color": int(arrow["color"]),
+        "trail": set(),
+        "moves": 0,
+        "wall_bounces": 0,
+        "boundary_bounces": 0,
+        "touched_walls": set(),
+        "seen": set(),
