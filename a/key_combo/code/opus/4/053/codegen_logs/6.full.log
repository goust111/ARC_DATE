+    next_state["dir"] = (dr, dc)
+
+    return {
+        "invalid": False,
+        "state": next_state,
+        "arrival": (nr, nc),
+        "paint": paint,
+        "wall_updates": wall_updates,
+    }
+
+
+def _simulate(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    arrows, wall_map, arrow_cells = _parse_grid(g)
+    out = g.copy()
+    states = [_ray_state(arrow) for arrow in arrows]
