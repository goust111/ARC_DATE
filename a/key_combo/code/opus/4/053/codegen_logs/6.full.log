+def _arrow_signature(coords: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    if len(coords) != 3:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if (r1 - r0, c1 - c0) != (1, 1):
+        return None
+
+    pts = set(coords)
+    corners = ((r0, c0), (r0, c1), (r1, c0), (r1, c1))
+    missing = [p for p in corners if p not in pts]
+    if len(missing) != 1:
+        return None
