+        "trail": set(state["trail"]),
+        "moves": int(state["moves"]),
+        "wall_bounces": int(state["wall_bounces"]),
+        "boundary_bounces": int(state["boundary_bounces"]),
+        "touched_walls": set(state["touched_walls"]),
