+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+WALL_COLORS = (4, 5, 6, 7, 8, 9)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+EDGE_NAMES = ("top", "bottom", "left", "right")
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _connected_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((cr, cc))
+            for nr, nc in _neighbors4(cr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _arrow_signature(coords: list[tuple[int, int]]) -> tuple[tuple[int, int], tuple[int, int]] | None:
+    if len(coords) != 3:
+        return None
+    r0, c0, r1, c1 = _bbox(coords)
+    if (r1 - r0, c1 - c0) != (1, 1):
+        return None
+
+    pts = set(coords)
+    corners = ((r0, c0), (r0, c1), (r1, c0), (r1, c1))
+    missing = [p for p in corners if p not in pts]
+    if len(missing) != 1:
+        return None
+
+    mr, mc = missing[0]
+    dr = 1 if mr == r0 else -1
+    dc = 1 if mc == c0 else -1
+
+    degrees = {}
+    for r, c in coords:
+        deg = 0
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in pts:
+                deg += 1
+        degrees[(r, c)] = deg
+    start = max(degrees, key=degrees.get)
+    return start, (dr, dc)
+
+
+def _parse_grid(grid: np.ndarray) -> tuple[list[dict], dict[tuple[int, int], int], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    arrows: list[dict] = []
+    walls: dict[tuple[int, int], int] = {}
+    arrow_cells: set[tuple[int, int]] = set()
