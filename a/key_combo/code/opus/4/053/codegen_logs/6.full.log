+    mr, mc = missing[0]
+    dr = 1 if mr == r0 else -1
+    dc = 1 if mc == c0 else -1
+
+    degrees = {}
+    for r, c in coords:
+        deg = 0
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in pts:
+                deg += 1
+        degrees[(r, c)] = deg
+    start = max(degrees, key=degrees.get)
+    return start, (dr, dc)
