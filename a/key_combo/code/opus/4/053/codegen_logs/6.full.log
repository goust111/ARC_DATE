+
+def _parse_grid(grid: np.ndarray) -> tuple[list[dict], dict[tuple[int, int], int], set[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    arrows: list[dict] = []
+    walls: dict[tuple[int, int], int] = {}
+    arrow_cells: set[tuple[int, int]] = set()
