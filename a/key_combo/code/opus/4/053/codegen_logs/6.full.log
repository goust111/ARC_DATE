+    for _tick in range(max_ticks):
+        proposals = []
+        for state in states:
+            prop = _advance_one(state, wall_map, arrow_cells, out)
+            if prop["invalid"]:
+                return {"ok": False, "reason": prop["reason"]}
+            proposals.append(prop)
