+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+WALL_COLORS = (4, 5, 6, 7, 8, 9)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+EDGE_NAMES = ("top", "bottom", "left", "right")
