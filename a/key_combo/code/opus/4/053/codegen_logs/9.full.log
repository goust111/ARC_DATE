+    for r in range(1, wedge_rows):
+        span_left = left + r
+        span_right = right - r
+        for c in range(span_left, span_right + 1):
+            color = int(intended[(r, c)])
+            dummy_color = WALL_COLORS[0]
+            _wall_color, affected = _trace_injection((r, c, dummy_color), intended, center)
