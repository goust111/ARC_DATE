def _groups(indices: np.ndarray) -> list[tuple[int, int]]:
    vals = [int(v) for v in np.asarray(indices, dtype=int).tolist()]
    if not vals:
        return []
    out = []
    start = prev = vals[0]
    for v in vals[1:]:
        if v == prev + 1:
            prev = v
            continue
        out.append((start, prev))
        start = prev = v
    out.append((start, prev))
    return out


