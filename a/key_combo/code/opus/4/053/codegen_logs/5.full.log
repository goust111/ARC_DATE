def _gen_separated(a, b):
    ar, ac = a
    br, bc = b
    row_gap = ar + REGION_SIZE < br or br + REGION_SIZE < ar
    col_gap = ac + REGION_SIZE < bc or bc + REGION_SIZE < ac
