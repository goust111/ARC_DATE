+    acc = 0
+    for run in runs:
+        starts.append(acc)
+        acc += int(run)
+    return starts
+
+
+def _map_box_to_expanded(
+    box: tuple[int, int, int, int],
+    row_runs: list[int],
+    col_runs: list[int],
+) -> tuple[int, int, int, int]:
+    row_starts = _run_starts(row_runs)
+    col_starts = _run_starts(col_runs)
