   235	def transform_mask(mask: np.ndarray) -> np.ndarray:
   236	    out = np.array(mask, dtype=int, copy=True)
   237	    for _ in range(random.randint(0, 3)):
   238	        out = np.rot90(out)
   239	    if random.random() < 0.5:
   240	        out = np.fliplr(out)
   241	    if random.random() < 0.5:
   242	        out = np.flipud(out)
   243	    rows, cols = np.where(out)
   244	    return out[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
