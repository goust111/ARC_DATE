+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+DIRS = ((0, 1), (1, 0), (0, -1), (-1, 0))
+LEGEND_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
