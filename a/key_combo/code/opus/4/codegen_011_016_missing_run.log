+    row_order = [idx for idx, _ in sorted(enumerate(segments), key=lambda x: x[1]["center"][0])]
+    col_order = [idx for idx, _ in sorted(enumerate(segments), key=lambda x: x[1]["center"][1])]
+    reversed_rank = list(reversed(rank_order))
