        if rc in obs: continue
        if any(max(abs(rc[0]-r),abs(rc[1]-c))<=1 for r,c in obs):
            continue
        obs.append(rc)
    if len(obs)<k: return None
    for r,c in obs: g[r,c]=5
    return g, set(obs)

ok=0
