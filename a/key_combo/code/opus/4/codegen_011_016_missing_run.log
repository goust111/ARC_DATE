+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+OBSTACLE = 5
+SOURCE_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 800
+GRID_H_RANGE = (12, 16)
+GRID_W_EXTRA_RANGE = (5, 9)
+SOURCE_COUNT_OPTIONS = [2, 3]
+OBSTACLE_COUNT_RANGE = (4, 7)
