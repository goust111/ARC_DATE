+        area = int(hh * ww)
+        if area not in used_areas:
+            used_areas.add(area)
+            return int(hh), int(ww)
+    return None
+
+
+def _place_inner(
+    outer: tuple[int, int, int, int],
+    inner_h: int,
+    inner_w: int,
+    side: str,
