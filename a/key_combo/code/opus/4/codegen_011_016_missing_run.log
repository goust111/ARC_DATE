+        elif side == "bottom":
+            mb = rng.randint(1, min(2, outer_h - inner_h - 1))
+            mt = outer_h - inner_h - mb
+            if mt < 1:
+                continue
+            ml = rng.randint(1, outer_w - inner_w - 1)
+        elif side == "left":
+            ml = rng.randint(1, min(2, outer_w - inner_w - 1))
+            mr = outer_w - inner_w - ml
+            if mr < 1:
+                continue
+            mt = rng.randint(1, outer_h - inner_h - 1)
+        else:
