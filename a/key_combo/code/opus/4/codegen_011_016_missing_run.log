   386	def validate_semantics(grid: np.ndarray, expected: np.ndarray) -> None:
   387	    info = analyze_grid(grid)
   388	    sprite = info["sprite"]
   389	    markers = info["markers"]
   390	    assert len(markers) >= 5
   391	    assert {m["color"] for m in markers} == set(MARKER_COLORS)
   392	    assert any(m["has_hole"] for m in markers)
   393	    assert any(not m["has_hole"] for m in markers)
   394	
   395	    status_by_color = {color: set() for color in MARKER_COLORS}
   396	    target_rects = []
   397	    valid_targets = []
   398	    sh, sw = sprite.shape
   399	    sr0, sc0, sr1, sc1 = info["sprite_bbox"]
   400	    source_rect = (sr0, sc0, sr1, sc1)
   401	    for marker in markers:
   402	        status_by_color[marker["color"]].add(bool(marker["has_hole"]))
   403	        if not marker["has_hole"]:
   404	            continue
   405	        r0, c0, _, _ = marker["bbox"]
   406	        dr, dc = MARKER_OFFSETS[marker["color"]]
   407	        tr, tc = r0 + dr, c0 + dc
   408	        rect = (tr, tc, tr + sh - 1, tc + sw - 1)
   409	        assert rect_in_bounds(rect, grid.shape)
   410	        assert not rect_overlap(rect, source_rect, pad=0)
   411	        assert all(not rect_overlap(rect, other, pad=0) for other in target_rects)
   412	        target_rects.append(rect)
   413	        valid_targets.append((tr, tc))
   414	    assert any(len(v) == 2 for v in status_by_color.values()), "need same-color hole and no-hole counterexample"
   415	    assert np.array_equal(main(grid), expected)
   416	
   417	    derived = build_expected(sprite, valid_targets, grid.shape)
   418	    assert np.array_equal(expected, derived)
   419	    assert int(np.count_nonzero(expected)) == int(np.count_nonzero(sprite)) * len(valid_targets)
