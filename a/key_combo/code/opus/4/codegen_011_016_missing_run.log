+        (r0, c0),
+        (r0, c1),
+        (r1, c0),
+        (r1, c1),
+        (r0, c0 + 2),
+        (r1, c0 + 2),
+        (r0 + 2, c0),
+        (r0 + 2, c1),
+    ]
