   288	def random_partition(total: int, parts: int, minimum: int) -> list[int]:
   289	    counts = [minimum] * parts
   290	    remaining = total - minimum * parts
   291	    for _ in range(remaining):
   292	        counts[random.randrange(parts)] += 1
   293	    random.shuffle(counts)
   294	    return counts
