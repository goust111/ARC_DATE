+
+def _semantic_checks(grid: np.ndarray, sprites: list[np.ndarray], legend: list[tuple[int, int]], expected: np.ndarray) -> bool:
+    sep = _separator_row(grid)
+    parsed_sprites = _extract_sprites(grid[:sep])
