+                "direction": random.choice(tuple(DIRS)),
+                "length": len4,
+                "color": colors[3],
+            }
+        )
+
+    for spec in specs:
+        spec["h"] = random.choice(BODY_HEIGHTS)
+        spec["w"] = random.choice(BODY_WIDTHS)
+        spec["mid_pick"] = random.randint(0, 1)
+
+    random.shuffle(specs)
