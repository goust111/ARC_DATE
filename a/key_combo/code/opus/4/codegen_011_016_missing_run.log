+            cells.append((r, c))
+        if not ok:
+            continue
+        for r, c in cells:
+            grid[r, c] = color
+        _mark_blocked(blocked, cells)
+        return True
+    return False
+
+
+def _generate_one() -> np.ndarray | None:
+    band_count = random.choice((4, 5))
+    heights = [18, 20, 22, 24, 26, 28]
