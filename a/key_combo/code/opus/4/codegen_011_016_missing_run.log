+
+def _generate_one() -> np.ndarray | None:
+    target_corner = random.choice(list(CORNER_ANCHORS))
+    side_count = random.choice([1, 2])
+    chosen_sides = tuple(random.sample(INWARD_SIDES[target_corner], side_count))
