+            break
+        tentative = set(current)
+        tentative.add(cell)
+        new_paths, _new_counts = _paths_from_layout(h, w, source_cols, tentative)
+        if _same_paths(new_paths, paths):
+            current = tentative
+
+    if len(current) < target_total:
+        return None
+    return current
