    98	def main(grid: np.ndarray) -> np.ndarray:
    99	    """Restore the occluded rectangles, then recolor every restored container rectangle to teal.
   100	
   101	    Input structure:
   102	    - The background is black.
   103	    - Each non-black, non-teal color belongs to one axis-aligned solid rectangle, but smaller rectangles may overlap and hide parts of larger ones.
   104	    - Every rectangle keeps enough visible extremal pixels that its full bbox can be recovered from the visible fragment.
   105	
   106	    Rule:
   107	    - For each foreground color, infer the rectangle's full bbox from the visible pixels' min/max row and column.
   108	    - Sort the inferred rectangles by decreasing bbox area and redraw them as solid rectangles on a blank black canvas, letting smaller rectangles overwrite larger ones.
   109	    - In that restored rectangle set, mark any rectangle whose bbox strictly contains at least one other rectangle's bbox as a container.
   110	    - Recolor only the finally visible pixels of those container rectangles to teal; keep all other visible pixels unchanged.
   111	
   112	    Key insight:
   113	    - Containment is defined on the hidden full rectangles rather than on the broken visible fragments, so the scene must be reconstructed from recovered bboxes before deciding what to recolor.
   114	    """
   115	    g = np.asarray(grid, dtype=int)
   116	    assert g.ndim == 2, "expected a 2D grid"
   117	    assert int(get_bg(g)) == BG, "expected black background"
   118	    assert TEAL not in set(map(int, g.ravel())), "teal must be output-only"
   119	
   120	    rects = _infer_rectangles(g)
   121	    assert 4 <= len(rects) <= 5, "expected 4-5 rectangles"
   122	
   123	    restored = _restore_scene(rects)
   124	    containers = _container_colors(rects)
   125	    assert containers, "expected at least one containing rectangle"
   126	    assert len(containers) < len(rects), "expected at least one non-container rectangle"
   127	
   128	    out = restored.copy()
   129	    for color in containers:
   130	        out[out == int(color)] = TEAL
   131	
   132	    assert np.any(out != g), "expected a visible transformation"
   133	    return out
