+        singles.append(info)
+        if c0 <= c <= c1 and r < r0:
+            top.append(info)
+        elif c0 <= c <= c1 and r > r1:
+            bottom.append(info)
+        elif r0 <= r <= r1 and (c < c0 or c > c1):
