+
+
+def validate_instance(inp: np.ndarray, fixed: np.ndarray, expected_errors: list[tuple[int, int]]) -> bool:
+    if not (inp.ndim == 2 and inp.shape[0] == inp.shape[1] and int(inp.shape[0]) <= 30):
