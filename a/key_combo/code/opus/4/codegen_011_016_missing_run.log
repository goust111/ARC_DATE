+
+
+def _tile_square(sprite: np.ndarray, k: int) -> np.ndarray:
+    return np.tile(sprite, (k, k))
+
+
+def _compose_output(sprites: list[np.ndarray], legend: list[tuple[int, int]]) -> np.ndarray:
