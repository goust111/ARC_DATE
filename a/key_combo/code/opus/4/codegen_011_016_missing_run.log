+        for c in range(w):
+            color = int(grid[r, c])
+            if color in banned or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            rows = [rr for rr, _ in cells]
+            cols = [cc for _, cc in cells]
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "r0": min(rows),
+                    "c0": min(cols),
+                    "r1": max(rows),
+                    "c1": max(cols),
+                }
+            )
+    return comps
+
