+
+        specs = marker_specs()
+        valid_specs = [spec for spec in specs if spec["has_hole"]]
+        invalid_specs = [spec for spec in specs if not spec["has_hole"]]
+        targets: list[tuple[int, int]] = []
+        ok = True
