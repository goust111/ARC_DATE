   117	def has_hole(mask: np.ndarray) -> bool:
   118	    mask = np.asarray(mask, dtype=bool)
   119	    h, w = mask.shape
   120	    exterior = np.zeros_like(mask, dtype=bool)
   121	    stack = []
   122	    for r in range(h):
   123	        for c in (0, w - 1):
   124	            if not mask[r, c] and not exterior[r, c]:
   125	                exterior[r, c] = True
   126	                stack.append((r, c))
   127	    for c in range(w):
   128	        for r in (0, h - 1):
   129	            if not mask[r, c] and not exterior[r, c]:
   130	                exterior[r, c] = True
   131	                stack.append((r, c))
   132	    while stack:
   133	        r, c = stack.pop()
   134	        for nr, nc in neighbors4(r, c):
   135	            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not exterior[nr, nc]:
   136	                exterior[nr, nc] = True
   137	                stack.append((nr, nc))
   138	    return bool(np.any((~mask) & (~exterior)))
