            r,c=nr,nc; moved=True; break
        if not moved: break
    return sum(sum(row) for row in painted)==(n-1)*n-len(obs) and trig==set(obs)

def refl_h(obs,n): return tuple(sorted((r,n-1-c) for r,c in obs))
def refl_v(obs,n): return tuple(sorted((n-2-r,c) for r,c in obs))
