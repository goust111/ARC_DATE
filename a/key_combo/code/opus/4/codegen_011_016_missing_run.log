   247	def random_connected_mask(height_range: tuple[int, int], width_range: tuple[int, int], area_range: tuple[int, int]) -> np.ndarray:
   248	    for _ in range(200):
   249	        h = random.randint(*height_range)
   250	        w = random.randint(*width_range)
   251	        min_area = max(area_range[0], 1)
   252	        max_area = min(area_range[1], h * w)
   253	        if min_area > max_area:
   254	            continue
   255	        target = random.randint(min_area, max_area)
   256	        mask = np.zeros((h, w), dtype=bool)
   257	        start = (random.randrange(h), random.randrange(w))
   258	        mask[start] = True
   259	        frontier = {start}
   260	        while int(mask.sum()) < target:
   260	        while int(mask.sum()) < target:
   261	            candidates = set()
