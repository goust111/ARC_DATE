+        [[color, color, color], [color, BG, color], [color, color, color]],
+        dtype=int,
+    )
+
+
+def _anchor_box(corner: str) -> tuple[int, int, int, int]:
+    r, c = CORNER_ANCHORS[corner]
+    return (r, c, r + 2, c + 2)
+
+
+def _guide_box_for_target(corner: str) -> tuple[int, int, int, int]:
