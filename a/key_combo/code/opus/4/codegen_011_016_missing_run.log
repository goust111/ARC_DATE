+    top = np.zeros((panel_h, panel_w), dtype=int)
+    service_row = panel_h // 2
+    positive_ranges: list[tuple[int, int]] = []
+
+    for pos, idx in enumerate(placement_order):
+        mask = masks[idx]
+        c0 = starts[pos]
+        top[:, c0 : c0 + mask.shape[1]][mask] = colors[idx]
