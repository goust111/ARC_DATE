+
+def _trace_path(obstacles: np.ndarray, source_col: int) -> tuple[list[tuple[int, int]], int]:
+    h, w = obstacles.shape
+    r, c = h - 2, int(source_col)
+    path: list[tuple[int, int]] = []
+    deflections = 0
+    while 0 <= r < h and 0 <= c < w:
+        if obstacles[r, c]:
