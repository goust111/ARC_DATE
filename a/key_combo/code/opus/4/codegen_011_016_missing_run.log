+def _obstacles_are_isolated(obstacles: Iterable[tuple[int, int]]) -> bool:
+    cells = list(obstacles)
+    for i, (r0, c0) in enumerate(cells):
+        for r1, c1 in cells[i + 1 :]:
+            if max(abs(r0 - r1), abs(c0 - c1)) <= 1:
+                return False
+    return True
+
