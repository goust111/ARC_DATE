+    side_votes = random.choice([1, min(2, rect_h)])
+    unaligned_count = 1 if side_votes == 1 and random.random() < 0.7 else 0
+    total_pixels = top_votes + bottom_votes + side_votes + unaligned_count
+    if total_pixels > len(PIXEL_COLORS):
+        return None
