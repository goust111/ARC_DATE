+
+def pack_bottom_aligned(sprites: list[np.ndarray]) -> np.ndarray:
+    height = max(sprite.shape[0] for sprite in sprites)
+    width = sum(sprite.shape[1] for sprite in sprites) + len(sprites) - 1
