+BG = 0
+TOP_COLORS = [1, 2, 3, 4]
+BOTTOM_COLORS = [5, 8]
+SEPARATOR = 6
+SPIRAL = (
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 2),
+    (2, 2),
+    (2, 1),
+    (2, 0),
+    (1, 0),
+)
