+    placements: list[tuple[int, int, int]] = []
+
+    vertical_cols = random.sample(list(range(rect_left, rect_right + 1)), top_votes + bottom_votes)
+    top_cols = vertical_cols[:top_votes]
+    bottom_cols = vertical_cols[top_votes:]
