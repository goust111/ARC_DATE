+    if len(path) < 4:
+        return []
+    candidates: list[tuple[int, int]] = []
+    for step_idx, (r, c) in enumerate(path[:-1]):
+        if step_idx == 0 or step_idx >= len(path) - 2:
+            continue
+        cell = (r - 1, c + 1)
+        if r <= 1:
