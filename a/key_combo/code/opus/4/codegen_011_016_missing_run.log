+                    gr = r0 + rr
+                    gc = c0 + cc
+                    r_lo = max(0, gr - padding)
+                    r_hi = min(h, gr + padding + 1)
+                    c_lo = max(0, gc - padding)
+                    c_hi = min(w, gc + padding + 1)
+                    if np.any(occupied[r_lo:r_hi, c_lo:c_hi]):
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                candidates.append((r0, c0))
