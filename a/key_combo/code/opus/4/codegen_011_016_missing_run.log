   422	def generate_input() -> np.ndarray:
   423	    for _ in range(MAX_GENERATION_ATTEMPTS):
   424	        h = random.randint(16, 19)
   425	        w = random.randint(16, 19)
   426	        grid = np.zeros((h, w), dtype=int)
   427	
   428	        sprite = generate_sprite()
   429	        sh, sw = sprite.shape
   430	        sr = random.randint(1, 2)
   431	        sc = random.randint(1, 2)
   432	        grid[sr : sr + sh, sc : sc + sw] = sprite
   433	        source_rect = (sr, sc, sr + sh - 1, sc + sw - 1)
   434	        input_reserved: list[tuple[int, int, int, int]] = [source_rect]
   435	        target_reserved: list[tuple[int, int, int, int]] = [source_rect]
   436	
   437	        specs = marker_specs()
   438	        valid_specs = [spec for spec in specs if spec["has_hole"]]
   439	        invalid_specs = [spec for spec in specs if not spec["has_hole"]]
   440	        targets: list[tuple[int, int]] = []
   441	        ok = True
   442	
