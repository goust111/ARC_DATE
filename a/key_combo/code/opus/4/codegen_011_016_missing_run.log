        c=av[0]; out.append(c); used.add(c)
        for x in above[c]: indeg[x]-=1
    return out


def infer(g, colors):
    masks={}
    for c in colors:
        pts=np.argwhere(g==c)
        if len(pts)==0: return None
        r0,c0=pts.min(axis=0); r1,c1=pts.max(axis=0)
        b=(int(r0),int(c0),int(r1),int(c1))
        masks[c]=frame_cells(b)
        for r,cc in pts:
            if (int(r),int(cc)) not in masks[c]: return None
    edges=set()
    H,W=g.shape
    for r in range(H):
        for c in range(W):
            cov=[col for col in colors if (r,c) in masks[col]]
            if len(cov)<2: continue
            top=int(g[r,c])
            if top not in cov: return None
            for col in cov:
                if col!=top: edges.add((col,top))
    return topo(colors,edges)


def gen_local(h,w,order,tries=3000):
    for _ in range(tries):
        target12=random.choice([2,4])
        target23=random.choice([2,4])
        target13=random.choice([0,2,4])
        b1=random_bbox(h,w); s1=frame_cells(b1)
        cand2=[]
        for _ in range(100):
            b2=random_bbox(h,w); s2=frame_cells(b2)
            if len(s1&s2)==target12 and b2!=b1:
                cand2.append((b2,s2))
        random.shuffle(cand2)
        for b2,s2 in cand2[:30]:
            for _ in range(300):
                b3=random_bbox(h,w); s3=frame_cells(b3)
                if b3 in (b1,b2):
                    continue
                if len(s2&s3)!=target23: continue
                if len(s1&s3)!=target13: continue
                g=np.zeros((h,w),dtype=int)
                for color,cells in zip(order,[s1,s2,s3]):
                    for r,c in cells: g[r,c]=color
                inferred=infer(g, order)
                if inferred==order:
                    return (target12,target23,target13), [b1,b2,b3], g
    return None

for h,w in [(7,7),(7,8),(8,8),(9,7),(9,9)]:
    ok=0
    for _ in range(200):
        order=[1,2,3]
        if gen_local(h,w,order): ok+=1
    print((h,w), ok)
