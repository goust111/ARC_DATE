+def candidate_positions(
+    canvas: np.ndarray,
+    patch: np.ndarray,
+    *,
+    padding: int,
+) -> list[tuple[int, int]]:
+    h, w = canvas.shape
+    ph, pw = patch.shape
+    occupied = canvas != 0
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(1, h - ph):
+        for c0 in range(1, w - pw):
+            ok = True
+            for rr in range(ph):
+                for cc in range(pw):
+                    if patch[rr, cc] == 0:
+                        continue
+                    gr = r0 + rr
+                    gc = c0 + cc
+                    r_lo = max(0, gr - padding)
+                    r_hi = min(h, gr + padding + 1)
