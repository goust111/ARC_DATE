+    out[out == GUIDE] = BG
+    return out
+
+
+def _validate_instance(
+    grid: np.ndarray,
+    base_grid: np.ndarray,
+    target_corner: str,
+    boxes: dict[str, tuple[int, int, int, int]],
+    row_runs: list[int],
+    col_runs: list[int],
