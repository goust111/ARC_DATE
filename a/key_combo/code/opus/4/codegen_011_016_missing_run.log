+    source_colors: list[int],
+    obstacles: set[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for r, c in obstacles:
+        grid[r, c] = OBSTACLE
+    for c, color in zip(source_cols, source_colors):
+        grid[h - 1, c] = color
