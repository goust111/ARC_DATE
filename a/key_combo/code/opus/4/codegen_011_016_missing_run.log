+def _closed_component_sets(grid: np.ndarray) -> list[set[tuple[int, int]]]:
+    result = []
+    for coords, touches_edge in _zero_components(grid):
+        if not touches_edge:
+            result.append({(int(r), int(c)) for r, c in coords})
