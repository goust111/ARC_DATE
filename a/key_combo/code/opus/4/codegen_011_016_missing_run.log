+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+TAIL_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+START_QUADRANT = {"U": 0, "R": 1, "D": 2, "L": 3}
