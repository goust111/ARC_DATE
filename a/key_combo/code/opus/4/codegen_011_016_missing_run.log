+                    continue
+                dr = nr - anchor[0]
+                dc = nc - anchor[1]
+                score = 0
+                for idx, vec in enumerate(preferred):
+                    score += (len(preferred) - idx) * (dr * vec[0] + dc * vec[1])
+                frontier.append((score, random.random(), (nr, nc)))
+        if not frontier:
