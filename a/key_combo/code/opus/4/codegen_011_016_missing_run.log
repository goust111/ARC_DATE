+        assert int(cols[1]) == int(cols[0]) + 1, "bar cells must be adjacent"
+        pair = (int(grid[r, cols[0]]), int(grid[r, cols[1]]))
+        assert set(pair) == BAR_COLORS, "each bar must use blue and red"
+        bars.append((r, int(cols[0]), pair))
