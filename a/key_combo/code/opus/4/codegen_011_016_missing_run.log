  56:     for index, (c0, c1, _color) in enumerate(bands):
  57:         fill_color = bands[(index + 1) % len(bands)][2]
  58:         band = out[:, c0 : c1 + 1]
  59:         band[band == bg] = fill_color
  60: 
  61:     return out
