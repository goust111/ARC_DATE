+
+    plan = [random.choice([1, 2]), random.choice([0, 1]), random.choice([0, 1, 2])]
+    if sum(plan) < 2:
+        plan[random.randrange(count)] += 1
+    if len(set(plan)) == 1:
+        plan[0] += 1
