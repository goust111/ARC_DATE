import random, sys
DIRS=[(0,1),(1,0),(0,-1),(-1,0)]

def simulate(n, obstacles):
    painted=[[False]*n for _ in range(n-1)]
    r=c=0; d=0; trig=set(); counts={'ob':0,'bd':0,'lg':0,'sf':0}
    while True:
        painted[r][c]=True
        moved=False
        for _ in range(4):
            dr,dc=DIRS[d]; nr,nc=r+dr,c+dc
            if not (0<=nr<n and 0<=nc<n): counts['bd']+=1; d=(d+1)%4; continue
