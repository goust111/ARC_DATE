import random, numpy as np

DIRS=[(0,1),(1,0),(0,-1),(-1,0)]
PALETTE=[1,2,3,4,6,7,8,9]

def parse_legend(g):
    pos=[c for c,v in enumerate(g[-1]) if v"'!=0]
    return [int(g[-1,c]) for c in pos]

def simulate(grid):
    g=np.asarray(grid,dtype=int)
    n=g.shape[0]
    legend=parse_legend(g)
    obstacles={(int(r),int(c)) for r,c in np.argwhere(g[:-1]==5)}
    out=g.copy()
    painted=np.zeros((n-1,n),dtype=bool)
    r=c=0
    d=0
    color_idx=0
    triggered=set()
    counts={k:0 for k in ['"'obstacle','boundary','legend','self']}
    colors={legend[0]}
    while True:
        out[r,c]=legend[color_idx]
        painted[r,c]=True
        moved=False
        for _ in range(4):
            dr,dc=DIRS[d]
            nr,nc=r+dr,c+dc
            if not (0<=nr<n and 0<=nc<n):
                counts['boundary']+=1
                d=(d+1)%4
                continue
            if nr==n-1:
                counts['legend']+=1
                d=(d+1)%4
