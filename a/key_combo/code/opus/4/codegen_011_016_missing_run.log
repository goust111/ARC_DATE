+            cols = [cc for _, cc in cells]
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "r0": min(rows),
+                    "c0": min(cols),
+                    "r1": max(rows),
+                    "c1": max(cols),
