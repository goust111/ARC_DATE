            if painted[nr,nc]:
                counts['self']+=1
                d=(d+1)%4
                continue
            r,c=nr,nc
            moved=True
            break
        if not moved:
            break
    return out, {'painted':int(painted.sum()),'triggered':triggered,'colors':colors,**counts}

def place_legend(n):
    for _ in range(100):
        k=random.randint(3,4)
        colors=random.sample(PALETTE,k)
        gaps=[random.randint(1,2) for _ in range(k-1)]
        width=k+sum(gaps)
        if width>n: continue
        start=random.randint(0,n-width)
        row=np.zeros(n,dtype=int)
        c=start
        row[c]=colors[0]
        for i,g in enumerate(gaps,1):
            c+=g+1
            row[c]=colors[i]
        return row
    return None

