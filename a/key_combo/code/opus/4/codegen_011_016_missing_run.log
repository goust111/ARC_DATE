+        r0, c0, _, _ = marker["bbox"]
+        dr, dc = MARKER_OFFSETS[marker["color"]]
+        tr, tc = r0 + dr, c0 + dc
+        rect = (tr, tc, tr + sh - 1, tc + sw - 1)
