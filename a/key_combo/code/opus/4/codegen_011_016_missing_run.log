+    _HEIGHT_CURSOR += 1
+    perm = _RNG.permutation(len(pattern))
+    return tuple(int(pattern[i]) for i in perm)
+
+
+def _build_input(sprites: list[np.ndarray], legend: list[tuple[int, int]], start_col: int) -> np.ndarray:
