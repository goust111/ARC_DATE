+    assert r0 < r1 and c0 < c1
+    out = np.zeros(shape, dtype=bool)
+    out[r0 : r1 + 1, c0] = True
+    out[r0 : r1 + 1, c1] = True
+    out[r0, c0 : c1 + 1] = True
+    out[r1, c0 : c1 + 1] = True
