+        else:
+            out[pix["r"], c1 + 1 : pix["c"] + 1] = pix["color"]
+
+
+def _spec_output(grid: np.ndarray) -> np.ndarray:
+    bg = _get_bg(grid)
+    rect = _find_rectangle(grid, bg)
+    top, bottom, side, _unaligned, _singles = _classify_singletons(grid, rect, bg)
