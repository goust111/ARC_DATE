+    if np.array_equal(repaired, solved):
+        return False
+    if not filled_info:
+        return False
+
+    try_fill_only, _ = fill_enclosed_regions(inp)
+    if np.array_equal(try_fill_only, solved):
+        return False
+
+    wrong_orbit_swap, _ = fill_enclosed_regions(swap_entire_mixed_orbits(inp))
