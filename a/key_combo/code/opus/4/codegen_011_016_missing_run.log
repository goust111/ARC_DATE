+
+
+def _area(box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = box
+    return int((r1 - r0 + 1) * (c1 - c0 + 1))
+
+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
