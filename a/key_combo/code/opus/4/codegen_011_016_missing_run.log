+
+    grid = np.full((h, w), BACKGROUND, dtype=int)
+    rect_left = 0 if left_wall else w - rect_w
+    rect_right = rect_left + rect_w - 1
+    rect_bottom = rect_top + rect_h - 1
+    grid[rect_top : rect_bottom + 1, rect_left : rect_right + 1] = RECT_COLOR
+
