+        assert colors, "band must contain foreground cells"
+        color, _ = Counter(colors).most_common(1)[0]
+        assert set(colors) == {color}, "each band must use exactly one foreground color"
+        bands.append({"c0": c0, "c1": c1, "color": int(color)})
