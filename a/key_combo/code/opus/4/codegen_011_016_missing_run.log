+        expanded[r, c] = GUIDE
+
+    compressed_expected = object_only.copy()
+    for r, c in core_cells:
+        compressed_expected[r, c] = GUIDE
+
+    if not _validate_instance(expanded, compressed_expected, target_corner, boxes, row_runs, col_runs):
+        return None
+    return expanded
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_one()
+        if grid is not None:
