+
+    if len(current) < target_total:
+        return None
+    return current
+
+
+def _choose_source_cols(h: int, w: int, count: int) -> list[int] | None:
+    headroom = random.randint(1, 3)
+    max_last = w - h + 1 - headroom
+    if max_last < 0:
