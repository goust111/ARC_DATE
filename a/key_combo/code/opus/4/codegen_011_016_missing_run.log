+    visible_container_colors = {
+        int(rect["color"])
+        for rect in rects
+        if np.any(restored == int(rect["color"])) and int(rect["color"]) in expected
+    }
+    if not visible_container_colors:
+        return False
+    if not np.any(out == TEAL):
+        return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
