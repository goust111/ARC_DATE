+
+
+def cell_ray_angles(center: tuple[int, int], r: int, c: int) -> set[int]:
+    cr, cc = center
+    if (r, c) == center:
+        return set()
+    hits: set[int] = set()
+    if c == cc:
+        hits.add(0 if r < cr else 180)
+    if r == cr:
+        hits.add(90 if c > cc else 270)
+    dr = r - cr
+    dc = c - cc
+    if abs(dr) == abs(dc):
+        if dr < 0 and dc > 0:
+            hits.add(45)
+        elif dr > 0 and dc > 0:
+            hits.add(135)
+        elif dr > 0 and dc < 0:
+            hits.add(225)
+        elif dr < 0 and dc < 0:
+            hits.add(315)
