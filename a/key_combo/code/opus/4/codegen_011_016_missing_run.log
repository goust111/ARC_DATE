   194	def main(grid: np.ndarray) -> np.ndarray:
   195	    """Stamp the multicolor source sprite at color-decoded offsets of hole-containing monochrome markers.
   196	
   197	    Input structure:
   198	    - Black is the background. One 4-connected multicolor source sprite sits in the upper-left region.
   199	    - Elsewhere, 4-connected monochrome marker objects use only orange, blue, maroon, or magenta.
   200	    - Some marker objects enclose a 4-connected black hole inside their bbox; others are hole-free distractors.
   201	
   202	    Rule:
   203	    - Detect the unique multicolor source sprite and every other monochrome foreground object.
   204	    - Keep only the marker objects whose mask contains an enclosed black hole; erase all hole-free markers.
   205	    - Decode each surviving marker color as an offset: orange=up 3, blue=right 3, maroon=down 3, magenta=left 3.
   206	    - For each surviving marker, add that offset to the marker bbox's upper-left corner and stamp the full source sprite there.
   207	    - Erase the original source sprite and all marker objects; the output contains only the stamped source copies.
   208	
   209	    Key insight:
   210	    - Topology gates which objects are active, while marker color independently encodes where the source copy lands; both cues are required before stamping.
   211	    """
   212	    info = analyze_grid(grid)
   213	    g = np.asarray(grid, dtype=int)
   214	    bg = int(info["bg"])
   215	    sprite = info["sprite"]
   216	    h, w = g.shape
   217	    out = np.full_like(g, bg)
   218	
   219	    targets = []
   220	    for marker in info["markers"]:
   221	        if not marker["has_hole"]:
   222	            continue
   223	        r0, c0, _, _ = marker["bbox"]
   224	        dr, dc = MARKER_OFFSETS[int(marker["color"])]
   225	        tr, tc = r0 + dr, c0 + dc
   226	        assert 0 <= tr and 0 <= tc
   227	        assert tr + sprite.shape[0] <= h and tc + sprite.shape[1] <= w
   228	        targets.append((int(tr), int(tc)))
   229	
   230	    for top in sorted(targets):
   231	        paste_sprite(out, sprite, top, bg)
   232	    return out
