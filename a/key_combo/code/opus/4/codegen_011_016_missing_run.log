+SIDE_NEIGHBOR = {
+    ("tl", "right"): "tr",
+    ("tl", "bottom"): "bl",
+    ("tr", "left"): "tl",
+    ("tr", "bottom"): "br",
+    ("bl", "right"): "br",
+    ("bl", "top"): "tl",
+    ("br", "left"): "bl",
+    ("br", "top"): "tr",
+}
