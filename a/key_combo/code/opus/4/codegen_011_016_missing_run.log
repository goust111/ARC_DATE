+    specs = [{"color": c, "has_hole": c in base_valid, "prefer_ring_like": False} for c in MARKER_COLORS]
+    extras = total - 4
+    if extras >= 1:
+        color = random.choice(tuple(base_valid))
+        specs.append({"color": color, "has_hole": False, "prefer_ring_like": True})
+    if extras >= 2:
