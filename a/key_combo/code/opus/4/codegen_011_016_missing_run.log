+        return None
+
+    if np.array_equal(grid, expected):
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+
+    changed_cols = 0
+    for c in range(w):
+        if not np.array_equal(grid[:, c], expected[:, c]):
+            changed_cols += 1
+    if changed_cols < 3:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
