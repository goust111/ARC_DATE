+            return None
+        base_grid[r, c] = GUIDE
+
+    if not _adjacent_rows_cols_are_unique(base_grid):
+        return None
+
+    row_runs = _pick_runs(BASE_SIZE)
+    col_runs = _pick_runs(BASE_SIZE)
+
