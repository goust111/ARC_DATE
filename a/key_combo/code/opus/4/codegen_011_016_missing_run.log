+        row = np.zeros(size, dtype=int)
+        col = rng.randint(0, size - span)
+        row[col] = colors[0]
+        for idx, gap in enumerate(gaps, start=1):
+            col += gap + 1
+            row[col] = colors[idx]
+        return row
+
