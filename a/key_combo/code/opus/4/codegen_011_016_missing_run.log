+def _build_component_mask(panel_h: int, area: int, overlap: int) -> np.ndarray | None:
+    service_row = panel_h // 2
+
+    for _ in range(200):
+        min_width = max(overlap if overlap > 0 else 2, 2, (area + 1) // 2)
