+def _same_paths(a: list[list[tuple[int, int]]], b: list[list[tuple[int, int]]]) -> bool:
+    return len(a) == len(b) and all(pa == pb for pa, pb in zip(a, b))
+
+
+def _add_safe_extra_obstacles(
