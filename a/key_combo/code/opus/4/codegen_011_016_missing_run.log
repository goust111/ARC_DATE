+            placed = path
+            break
+        if placed is None:
+            return None
+        p = placed[0]
+        q = placed[-1]
+        segments.append(
+            {
+                "endpoints": (p, q),
+                "path": placed,
+                "length": length,
+                "center": ((p[0] + q[0]) / 2.0, (p[1] + q[1]) / 2.0),
+            }
+        )
+        _add_blocked(placed, blocked, height, width)
+
+    inp = np.full((height, width), BG, dtype=int)
+    for entry in legend:
