    71	def components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
    72	    mask = np.asarray(mask, dtype=bool)
    73	    h, w = mask.shape
    74	    seen = np.zeros_like(mask, dtype=bool)
    75	    comps: list[np.ndarray] = []
    76	    for r in range(h):
    77	        for c in range(w):
    78	            if not mask[r, c] or seen[r, c]:
    79	                continue
    80	            stack = [(r, c)]
    81	            seen[r, c] = True
    82	            coords = []
    83	            while stack:
    84	                cr, cc = stack.pop()
    85	                coords.append((cr, cc))
    86	                for nr, nc in neighbors4(cr, cc):
    87	                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
    88	                        seen[nr, nc] = True
    89	                        stack.append((nr, nc))
    90	            comps.append(np.array(coords, dtype=int))
    91	    return comps
