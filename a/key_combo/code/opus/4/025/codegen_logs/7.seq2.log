+    noise_a_count = random.choices([0, 1, 2], weights=[1, 3, 3])[0]
+    noise_b_count = random.choices([0, 1, 2], weights=[1, 3, 3])[0]
+    noise_a = _pick_noise_points(
+        _noise_candidates(region_a, set(dents_a), dents_a), noise_a_count
