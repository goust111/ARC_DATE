+    frozenset({(0, 1), (1, 0), (1, 1), (1, 2), (2, 0)}),
+    frozenset({(0, 0), (0, 1), (1, 0), (1, 1), (2, 1)}),
+    frozenset({(0, 1), (1, 0), (1, 1), (1, 2), (2, 1), (2, 2)}),
+    frozenset({(0, 0), (0, 1), (1, 1), (1, 2), (2, 1), (2, 2)}),
+    frozenset({(0, 0), (1, 0), (1, 1), (2, 1), (2, 2), (3, 1)}),
