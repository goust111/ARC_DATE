+def _extract_visible_right(grid: np.ndarray, sep_c: int) -> list[dict]:
+    right = grid[:, sep_c + 1 :]
+    comps = _components_of_mask(right == GREY)
+    visibles = []
+    for comp in comps:
+        shape, origin = _normalize_coords(comp)
+        visibles.append({"shape": shape, "origin": origin, "coords": comp})
+    return visibles
