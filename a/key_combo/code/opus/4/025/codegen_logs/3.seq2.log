+
+def _bbox_coords(coords: list[tuple[int, int]] | set[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    pts = list(coords)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    return min(rows), min(cols), max(rows), max(cols)
+
