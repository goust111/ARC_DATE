+        perm = list(range(n))
+        random.shuffle(perm)
+
+        left_dims = [_shape_dims(refs[i]["shape"]) for i in range(n)]
+        right_dims = [_shape_dims(refs[i]["shape"]) for i in perm]
+
+        height = random.randint(16, 24)
+        left_w = random.randint(8, 11)
+        right_w = random.randint(10, 14)
