+def _is_connected(coords: set[tuple[int, int]] | frozenset[tuple[int, int]]) -> bool:
+    pts = set(coords)
+    if not pts:
+        return False
+    q = deque([next(iter(pts))])
+    seen = {q[0]}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in pts and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(pts)
