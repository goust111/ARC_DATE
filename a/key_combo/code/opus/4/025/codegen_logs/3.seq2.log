+                        continue
+                    visible = cells - hidden
+                    if len(visible) < 2 or not _is_connected(visible):
+                        continue
+                    visible_norm, _ = _normalize_coords(visible)
+                    matches = _all_matches(refs, visible_norm)
+                    if len(matches) != 1 or matches[0][0] != ref_idx:
+                        continue
+                    candidates.append(
