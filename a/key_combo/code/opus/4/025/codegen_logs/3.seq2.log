+        right_specs: list[dict] = []
+        for right_slot, ref_idx in enumerate(perm):
+            ref = refs[ref_idx]
+            occ = occlusions[ref_idx]
+            top = right_positions[right_slot]
+            color = ref["color"]
+            full_cells = {(top[0] + r, top[1] + c) for r, c in ref["shape"]}
+            rect_r, rect_c, rect_h, rect_w = occ["rect"]
