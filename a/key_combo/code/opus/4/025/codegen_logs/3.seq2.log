+def _paint_shape(grid: np.ndarray, shape: frozenset[tuple[int, int]], top: tuple[int, int], color: int) -> None:
+    r0, c0 = top
+    for dr, dc in shape:
+        grid[r0 + dr, c0 + dc] = color
