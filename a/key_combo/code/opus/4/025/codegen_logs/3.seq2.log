+            picks = [random.choice(opts) for opts in options]
+            visible_areas = [pick["visible_count"] for pick in picks]
+            if len(set(visible_areas)) == len(visible_areas):
+                continue
+            if max(pick["hidden_count"] for pick in picks) < 2:
