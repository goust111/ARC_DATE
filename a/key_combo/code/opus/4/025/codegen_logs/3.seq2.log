+def _occlusion_candidates(shape: frozenset[tuple[int, int]], refs: list[dict], ref_idx: int) -> list[dict]:
+    h, w = _shape_dims(shape)
+    cells = set(shape)
+    candidates: list[dict] = []
+    for rect_h in OCCLUDER_SIZES:
