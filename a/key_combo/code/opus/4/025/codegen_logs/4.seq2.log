+    grid[0, spec["v1_col"]] = BLUE
+    grid[h - 1, spec["v1_col"]] = BLUE
+    grid[spec["h2_row"], 0] = RED
+    grid[spec["h2_row"], w - 1] = RED
+    grid[0, spec["v3_col"]] = GREEN
+    grid[h - 1, spec["v3_col"]] = GREEN
+    grid[spec["h4_row"], 0] = YELLOW
+    grid[spec["h4_row"], w - 1] = YELLOW
+    return grid
