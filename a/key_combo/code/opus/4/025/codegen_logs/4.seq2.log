+def _side_counts(track_grid: np.ndarray, cont: dict) -> dict[str, int]:
+    h, w = track_grid.shape
+    r0, c0, r1, c1 = cont["outer"]
+    counts = {side: 0 for side in SIDE_PRIORITY}
+    if r0 - 1 >= 0:
