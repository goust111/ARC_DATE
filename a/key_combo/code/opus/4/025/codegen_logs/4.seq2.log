+
+    a_shape = random.choice(OUTER_SHAPES)
+    a_row_lo = 8 if top_split else 5
+    a_row_hi = h - a_shape[0] - 8 if not top_split else h - a_shape[0] - 5
+    a_col_lo = 7
+    a_col_hi = w - a_shape[1] - 8
