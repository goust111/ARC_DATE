+
+from arc_utils import Color, bbox_coords, components_mask
+
+
+BG = Color.BLACK
+BLUE = Color.BLUE
+RED = Color.RED
+GREEN = Color.GREEN
+YELLOW = Color.YELLOW
+GREY = Color.GREY
+MAGENTA = Color.PINK
+ORANGE = Color.ORANGE
+
+PAIR_COLORS = (BLUE, RED, GREEN, YELLOW)
+TRAIL_VALUES = {BLUE, RED, GREEN, YELLOW, MAGENTA}
+OUTER_SHAPES = ((4, 6), (6, 4))
+SIDE_PRIORITY = ("top", "right", "bottom", "left")
+GEN_RETRIES = 400
