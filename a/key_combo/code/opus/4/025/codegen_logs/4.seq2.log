+    rows = {h2_row, h4_row}
+    cols = {v1_col, v3_col}
+    if len(rows) != 2 or len(cols) != 2:
+        return None
+    if abs(h2_row - h4_row) < 2 or abs(v1_col - v3_col) < 2:
+        return None
+
+    spec = {
+        "shape": (h, w),
+        "containers": containers,
+        "v1_col": v1_col,
+        "h2_row": h2_row,
