+                met = True
+                met_mode = "into_stopped_b"
+                break
+            if active_b and (not active_a) and next_b == pos_a:
+                _mark_trail(out, trail_mask, pos_a, MAGENTA)
+                met = True
+                met_mode = "into_stopped_a"
+                break
