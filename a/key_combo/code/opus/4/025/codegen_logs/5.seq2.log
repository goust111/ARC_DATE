def _gen_component_count(mask: np.ndarray) -> int:
    return len(components_mask(mask.astype(bool), connectivity=FOUR_CONNECTIVITY))


def _gen_dilate4(mask: np.ndarray) -> np.ndarray:
    near = np.zeros(mask.shape, dtype=bool)
    near[1:, :] |= mask[:-1, :]
    near[:-1, :] |= mask[1:, :]
    near[:, 1:] |= mask[:, :-1]
    near[:, :-1] |= mask[:, 1:]
