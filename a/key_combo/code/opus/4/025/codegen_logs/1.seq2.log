+        seen_shapes: set[tuple[tuple[int, int], ...]] = set()
+        shapes = []
+        for kind, hint in (("horizontal", 1), ("horizontal", 1), ("vertical", 1), ("vertical", 1), ("l", 1), ("l", 1)):
