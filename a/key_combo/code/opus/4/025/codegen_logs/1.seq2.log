+def _shape_transform(
+    coords: set[tuple[int, int]],
+    rot: int,
+    flip: bool,
+) -> tuple[tuple[int, int], ...]:
+    pts = [(r, c) for r, c in coords]
+    h = max(r for r, _ in pts) + 1
+    w = max(c for _, c in pts) + 1
+    cur = pts
+    cur_h, cur_w = h, w
