+def _normalize(coords: set[tuple[int, int]] | list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = list(coords)
+    r0 = min(r for r, _ in pts)
+    c0 = min(c for _, c in pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
