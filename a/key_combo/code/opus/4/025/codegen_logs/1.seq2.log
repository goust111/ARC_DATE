+        forbidden: set[tuple[int, int]] = set()
+        pairs = []
+
+        builders = [
+            _make_horizontal_pair(shapes[0], shapes[1], colors[0], colors[1], h, w, forbidden),
+            None,
+        ]
+        if builders[0] is None:
