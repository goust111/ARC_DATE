+
+def _tile_bbox(row_seps: list[int], col_seps: list[int], tile_r: int, tile_c: int) -> tuple[int, int, int, int]:
+    return (
+        row_seps[tile_r] + 1,
+        col_seps[tile_c] + 1,
+        row_seps[tile_r + 1] - 1,
+        col_seps[tile_c + 1] - 1,
+    )
+
+
+def _detect_lattice(grid: np.ndarray) -> dict:
+    grey_coords = np.argwhere(grid == SEP)
