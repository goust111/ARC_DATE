+
+    separator_colors = {
+        int(out[r, c])
+        for vote in votes
+        for r, c in vote["cells"]
+    }
+    if len(separator_colors) < 2:
+        return False
+
+    if info["tile_rows"] < 3 or info["tile_cols"] < 3:
+        return False
+
+    return True
+
