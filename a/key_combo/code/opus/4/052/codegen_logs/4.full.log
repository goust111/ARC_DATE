+    gh, gw = grid.shape
+    h, w = patch.shape
+    if h > gh or w > gw:
+        return False
+    candidates = [(r, c) for r in range(gh - h + 1) for c in range(gw - w + 1)]
+    random.shuffle(candidates)
+    for r0, c0 in candidates:
+        if _can_place(grid, patch, r0, c0, bg):
+            _paste(grid, patch, r0, c0, bg)
+            return True
+    return False
