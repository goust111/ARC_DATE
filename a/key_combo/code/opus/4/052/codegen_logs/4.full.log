+    sep = groups[1]
+    patch = _group_patch(g, src, bg)
+    h, w = patch.shape
+    assert h % 2 == 1 and w % 2 == 1, "source bbox must be odd-sized"
+    return _output_from_patch(patch, int(sep["color"]), bg)
