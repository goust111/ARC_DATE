+    r0, c0, r1, c1 = largest["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    coords = largest["coords"]
+    patch[coords[:, 0] - r0, coords[:, 1] - c0] = int(largest["color"])
