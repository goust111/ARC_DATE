+    gap_rows = [r for r in range(h) if np.all(patch[r] == int(bg))]
+    assert len(gap_rows) == 1
+    assert 12 <= int(src["area"]) <= 20
+    assert 5 <= int(sep["area"]) <= 10
+    assert all(2 <= int(group["area"]) <= 4 for group in groups[2:])
