MIN_BLOB_SIZE = 1
MAX_BLOB_SIZE = 4
INTERIOR_MARGIN = 1
MIN_MARKER_COVERAGE = 0.25
MAX_MARKER_COVERAGE = 0.32
FALLBACK_MARKER_COVERAGE = 0.22
MARKER_CONNECTIVITY = 4

