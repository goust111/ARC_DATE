+    out = np.full((2 * h, 2 * w), int(bg), dtype=int)
+    out[:h, :w] = patch
+    out[h:, w:] = patch
+    gap_rows = [r for r in range(h) if np.all(patch[r] == int(bg))]
+    for row in gap_rows:
