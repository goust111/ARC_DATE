+    rows, cols = np.where(patch != int(bg))
+    for rr, cc in zip(rows, cols):
+        r = r0 + int(rr)
+        c = c0 + int(cc)
+        if int(grid[r, c]) != int(bg):
+            return False
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if 0 <= nr < gh and 0 <= nc < gw and int(grid[nr, nc]) != int(bg):
+                    return False
+    return True
