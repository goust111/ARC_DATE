+    out = main(grid)
+    oracle = _output_from_patch(patch, int(sep["color"]), bg)
+    assert np.array_equal(out, oracle)
+
+    plain = np.full_like(out, int(bg))
+    plain[:h, :w] = patch
+    plain[h:, w:] = patch
+    assert not np.array_equal(out, plain), "separator fill must affect the output"
