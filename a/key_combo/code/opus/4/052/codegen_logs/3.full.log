+    for obj in objects:
+        direction, distance = _direction_distance(obj["start"], gray_box)
+        obj["direction"] = direction
+        obj["distance"] = distance
+
+    objects.sort(
+        key=lambda obj: (int(obj["distance"]), int(obj["start"][0]), int(obj["start"][1])),
+        reverse=descending_order,
