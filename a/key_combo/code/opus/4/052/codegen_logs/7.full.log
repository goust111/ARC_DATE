+    keep_singletons: bool = False,
+    drop_gray: bool = True,
+) -> list[dict]:
+    comps = find_components(
+        np.asarray(grid, dtype=int),
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    out = []
+    for comp in comps:
+        color = int(comp["color"])
+        area = int(comp["area"])
+        if drop_gray and color == GRAY:
+            continue
+        if not keep_singletons and area == 1:
+            continue
+        out.append(
+            {
