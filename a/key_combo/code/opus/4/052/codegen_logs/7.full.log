+        np.asarray(grid, dtype=int),
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    out = []
+    for comp in comps:
+        color = int(comp["color"])
+        area = int(comp["area"])
+        if drop_gray and color == GRAY:
+            continue
+        if not keep_singletons and area == 1:
+            continue
+        out.append(
+            {
+                "color": color,
+                "area": area,
+                "coords": np.asarray(comp["coords"], dtype=int),
+            }
+        )
+    return out
