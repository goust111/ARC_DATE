+    full = _count_assemblies(
+        pieces,
+        dims=None,
+        require_symmetry=True,
+        require_no_touch=True,
+        limit=2,
+    )
+    assert len(full) == 1 and np.array_equal(full[0], expected)
+
+    no_touch = _count_assemblies(
+        pieces,
+        dims=tuple(map(int, expected.shape)),
+        require_symmetry=True,
+        require_no_touch=False,
+        limit=2,
+    )
