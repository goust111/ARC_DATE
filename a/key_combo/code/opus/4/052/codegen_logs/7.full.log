+def _pieces_to_types(pieces: list[dict]) -> list[dict]:
+    counts = Counter()
+    for piece in pieces:
+        counts[(int(piece["color"]), _piece_signature(piece["coords"]))] += 1
+
+    types = []
+    for (color, (h, w, coords)), count in sorted(
+        counts.items(),
+        key=lambda item: (-len(item[0][1][2]), -item[0][1][0], -item[0][1][1], item[0][0]),
+    ):
+        types.append(
+            {
+                "color": int(color),
+                "coords": tuple(coords),
+                "h": int(h),
+                "w": int(w),
+                "count": int(count),
+            }
+        )
