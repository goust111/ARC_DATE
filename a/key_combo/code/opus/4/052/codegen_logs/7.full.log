+def _scatter_scene(output: np.ndarray, noise_count: int) -> np.ndarray:
+    canvas_h = random.randint(12, 16)
+    canvas_w = random.randint(12, 16)
+    grid = np.zeros((canvas_h, canvas_w), dtype=int)
