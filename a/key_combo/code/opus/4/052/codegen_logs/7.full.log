+        color = random.choice(noise_palette)
+        noise = np.array([[color]], dtype=int)
+        r, c = random_free_location(grid, noise, transparent=BG, border=1, padding=1, padding_connectivity=8)
+        paste(grid, noise, r, c, transparent=BG)
