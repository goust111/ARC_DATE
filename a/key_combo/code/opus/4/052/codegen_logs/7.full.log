+    def place(type_index: int, r0: int, c0: int) -> list[tuple[int, int]]:
+        t = types[type_index]
+        color = int(t["color"])
+        changed = []
+        for dr, dc in t["coords"]:
+            r, c = r0 + dr, c0 + dc
+            board[r, c] = color
+            changed.append((r, c))
+        remaining[type_index] -= 1
+        return changed
+
+    def unplace(type_index: int, changed: list[tuple[int, int]]) -> None:
+        for r, c in changed:
+            board[r, c] = -1
+        remaining[type_index] += 1
