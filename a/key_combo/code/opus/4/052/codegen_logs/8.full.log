+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+MAROON = 9
+
+FRAME_COLOR = GREY
+MARKER_COLORS = (BLUE, RED, GREEN)
+OBJECT_COLORS = (YELLOW, PINK, ORANGE)
+DIRS = ("up", "down", "left", "right")
+MARKER_OFFSET = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+MOVE_TO_FRAME = {
+    "up": (1, 0),
+    "down": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
+
+FRAME_SIDE = 5
+GRID_MIN = 16
+GRID_MAX = 22
+GEN_RETRY_LIMIT = 400
