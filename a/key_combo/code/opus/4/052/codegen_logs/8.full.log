+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+MAROON = 9
+
+FRAME_COLOR = GREY
+MARKER_COLORS = (BLUE, RED, GREEN)
+OBJECT_COLORS = (YELLOW, PINK, ORANGE)
+DIRS = ("up", "down", "left", "right")
