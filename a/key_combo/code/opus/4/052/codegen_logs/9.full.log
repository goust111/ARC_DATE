+    h: int,
+    w: int,
+    h_rows: list[int],
+    v_cols: list[int],
+    direction: str,
+    marker_index: int,
+) -> np.ndarray:
+    grid = np.full((h, w), Color.BLACK, dtype=int)
+    for r in h_rows:
+        grid[r, :] = Color.BLUE
+    for c in v_cols:
+        grid[:, c] = Color.RED
+
+    if direction == "left":
