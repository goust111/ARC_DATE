+    if not np.any(out == Color.MAROON):
+        return None
+    if np.array_equal(out, swapped_only):
+        return None
+    if np.array_equal(out, wrong_no_swap):
+        return None
+    if np.array_equal(out, wrong_opposite_dir):
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
