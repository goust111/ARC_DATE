+    elif direction == "right":
+        grid[marker_index, w - 1] = Color.TEAL
+    elif direction == "up":
+        grid[0, marker_index] = Color.TEAL
+    else:
+        grid[h - 1, marker_index] = Color.TEAL
+    return grid
