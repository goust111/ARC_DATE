+        prev = barrier
+    segments.append((prev + 1, height - 1))
+    return segments
+
+
+def _row_mode_nonblack(row: np.ndarray) -> int:
+    values = [int(v) for v in row if int(v) != 0]
+    assert values, "non-uniform rows must contain at least one non-black cell"
