+    if np.random.random() < 0.35:
+        extra_budget += 1
+
+    for _ in range(extra_budget):
+        candidates: list[tuple[str, int, bool]] = []
+        for side in SIDES:
+            if side_counts[side] >= 2:
+                continue
+            for obj_idx in range(len(objects)):
+                candidates.append((side, obj_idx, False))
