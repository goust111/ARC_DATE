+def _expected_from_spec(inp: np.ndarray, objects: list[dict], markers: list[dict]) -> np.ndarray:
+    out = inp.copy()
+    matched_objects: set[int] = set()
+    planned: dict[tuple[int, int], int] = {}
+
+    for obj in objects:
+        for r, c in obj["body_cells"]:
+            out[r, c] = int(obj["color"])
