+                    "side": side,
+                    "coord": coord,
+                    "obj_idx": obj_idx,
+                    "is_match": is_match,
+                }
+            )
+        if not ok:
+            continue
+
+        colored = _solve_marker_colors(markers, objects, shape)
+        if colored is not None:
+            return colored
+
+    return None
+
+
