+
+def _analyze_objects(grid: np.ndarray) -> list[dict]:
+    objects = find_components(
+        grid,
+        bg=BACKGROUND,
+        colors=[OBJECT_COLOR],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    analyzed: list[dict] = []
+    for obj in objects:
