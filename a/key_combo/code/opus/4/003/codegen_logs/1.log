    elif n_seps == FORCE_TRUNCATED_SEP_COUNT:
        truncated = True
    else:
        truncated = bool(np.random.randint(*TRUNCATION_COIN_RANGE))
    side = CELL_SIZE + n_seps * CELL_STRIDE - (TRUNCATED_CROP if truncated else 0)
