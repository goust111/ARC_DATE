+            [(r0 + int(rr), c0 + int(cc)) for rr, cc in coords]
+            for coords in holes_local
+        ]
+        analyzed.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "coords": obj["coords"],
+                "hole_count": hole_count,
+                "fill_color": HOLE_TO_COLOR[hole_count],
+                "holes_global": holes_global,
+            }
