+        obj["bbox"] = (r0, c0, r0 + int(obj["h"]) - 1, c0 + int(obj["w"]) - 1)
+        obj["body_cells"] = [(r0 + r, c0 + c) for r, c in obj["body_local"]]
+        obj["hole_cells"] = [(r0 + r, c0 + c) for r, c in obj["hole_local"]]
+
