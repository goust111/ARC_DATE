+HOLE_TO_COLOR = {
+    1: Color.BLUE,
+    2: Color.RED,
+    3: Color.GREEN,
+}
+MARKER_COLORS = tuple(HOLE_TO_COLOR.values())
+SIDES = ("top", "bottom", "left", "right")
+
+GEN_MIN_SIDE = 15
+GEN_MAX_SIDE = 23
+GEN_EDGE_MARGIN = 2
+GEN_GAP = 2
