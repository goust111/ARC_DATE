def touches_all_sides(mask):
    coords=np.argwhere(mask)
    rs=set(coords[:,0]); cs=set(coords[:,1])
    h,w=mask.shape
    return 0 in rs and h-1 in rs and 0 in cs and w-1 in cs

def random_connected(h,w,area):
