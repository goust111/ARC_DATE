+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+TEMPLATE_COLOR = TEAL
+SEPARATOR_COLOR = GREY
+RIGHT_COLORS = (BLUE, RED, GREEN)
