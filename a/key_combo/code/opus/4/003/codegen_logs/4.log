+ALLOWED_TRANSFORMS: dict[str, tuple[tuple[int, bool], ...]] = {
+    "S0": tuple((k, flip) for k in range(4) for flip in (False, True)),
+    "S1": ((0, False), (0, True), (2, False), (2, True)),
+    "S2": ((0, False), (0, True), (2, False), (2, True)),
