+
+SHAPE_OFFSETS: dict[str, tuple[tuple[int, int], ...]] = {
+    "S0": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "S1": ((0, 0), (0, 1), (0, 2)),
+    "S2": ((0, 0), (1, 0), (2, 0)),
+}
