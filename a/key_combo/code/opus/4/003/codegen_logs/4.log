   290	    assert len(solutions) == 1, "expected one valid shape-to-gap assignment"
   291	    return {
   292	        "sep_col": sep_col,
   293	        "templates": templates,
   294	        "shapes": shapes,
   295	        "pair_options": pair_options,
   296	        "assignment": solutions[0],
   297	    }
   298	
   299	
   300	def main(grid: np.ndarray) -> np.ndarray:
   301	    """
   302	    Match the right-side missing pieces into the left templates, then recolor each template by its post-fill hole count.
   303	
   304	    Input structure:
   305	    - Black background dominates the canvas, and one full-height grey column splits the grid into left and right halves.
   306	    - The left half contains three separated teal 4-connected template bodies; each template has one boundary-adjacent missing piece shape and may also contain enclosed background holes.
   307	    - The right half contains three small monochrome shapes in blue, red, and green, and each normalized shape matches exactly one left-side missing piece.
   308	
   309	    Rule:
   310	    - Normalize each right-side shape and each possible boundary missing-piece placement within every template bbox by translating them to their top-left corner.
   311	    - Find the unique one-to-one assignment that fills one missing piece per template and yields three distinct post-fill hole counts 0, 1, and 2.
   312	    - Draw each matched right-side shape into its left-side missing piece using the shape's own color, erase the original right-side shapes and the grey separator, then recolor only the original teal template pixels by hole count: 0->orange, 1->yellow, 2->maroon.
   313	
   314	    Key insight:
   315	    - The right-side shapes identify which boundary gaps must be filled, and only after that fill can the template's enclosed-background topology be counted correctly.
   316	    """
   317	    g = np.asarray(grid, dtype=int)
   318	    solved = _solve(g)
   319	
   320	    out = g.copy()
   321	    out[:, solved["sep_col"]] = BG
   322	    for shape in solved["shapes"]:
   323	        for r, c in shape["coords"]:
   324	            out[r, c] = BG
   325	
   326	    for ti, template in enumerate(solved["templates"]):
   327	        fill = solved["assignment"][ti]
   328	        shape = solved["shapes"][fill["shape_idx"]]
   329	        r0, c0, _r1, _c1 = template["bbox"]
   330	        for dr, dc in fill["cells_local"]:
   331	            out[r0 + dr, c0 + dc] = shape["color"]
   332	        for r, c in template["coords"]:
   333	            out[r, c] = RECOLOR_BY_HOLES[fill["holes"]]
   334	
   335	    return out
   336	
   337	
   338	def _shape_patch(shape_kind: str, color: int) -> np.ndarray:
   339	    offsets = SHAPE_OFFSETS[shape_kind]
   340	    h, w = _shape_dims(offsets)
   341	    patch = np.zeros((h, w), dtype=int)
   342	    for r, c in offsets:
   343	        patch[r, c] = int(color)
   344	    return patch
   345	
   346	
   347	def _boxes_touch_or_overlap(
   348	    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1
   349	) -> bool:
   350	    ar0, ac0, ar1, ac1 = a
   351	    br0, bc0, br1, bc1 = b
   352	    return not (
   353	        ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0
   354	    )
   355	
   356	
   357	def _sample_right_boxes(
   358	    rng: random.Random, height: int, sep_col: int, width: int, kinds: list[str]
   359	) -> dict[str, tuple[int, int]]:
   360	    placements: dict[str, tuple[int, int]] = {}
   361	    boxes: list[tuple[int, int, int, int]] = []
   362	    order = kinds[:]
   363	    rng.shuffle(order)
   364	    for kind in order:
   365	        patch_h, patch_w = _shape_dims(SHAPE_OFFSETS[kind])
   366	        ok = False
   367	        for _ in range(400):
   368	            r0 = rng.randint(0, height - patch_h)
   369	            c0 = rng.randint(sep_col + 1, width - patch_w)
   370	            box = (r0, c0, r0 + patch_h - 1, c0 + patch_w - 1)
   371	            if any(_boxes_touch_or_overlap(box, other, pad=1) for other in boxes):
   372	                continue
   373	            placements[kind] = (r0, c0)
   374	            boxes.append(box)
   375	            ok = True
   376	            break
   377	        if not ok:
   378	            raise RuntimeError("failed to place right-side shapes")
   379	    return placements
   380	
   381	
   382	def _build_case(rng: random.Random) -> tuple[np.ndarray, np.ndarray]:
   383	    hole_counts = [0, 1, 2]
   384	    shape_kinds = list(SHAPE_OFFSETS)
   385	    rng.shuffle(shape_kinds)
   386	    kind_by_holes = {holes: kind for holes, kind in zip(hole_counts, shape_kinds)}
   387	
   388	    band_holes = hole_counts[:]
   389	    rng.shuffle(band_holes)
   390	
   391	    top_margin = rng.randint(1, 2)
   392	    bottom_margin = rng.randint(1, 2)
   393	    gap1 = rng.randint(2, 4)
   394	    gap2 = rng.randint(2, 4)
   395	    left_width = rng.randint(7, 9)
   396	    right_width = rng.randint(5, 7)
   397	
   398	    row_starts = [
   399	        top_margin,
   400	        top_margin + 5 + gap1,
   401	        top_margin + 10 + gap1 + gap2,
   402	    ]
   403	    height = row_starts[-1] + 5 + bottom_margin
   404	    width = left_width + 1 + right_width
   405	    sep_col = left_width
   406	
   407	    grid = np.zeros((height, width), dtype=int)
   408	    grid[:, sep_col] = SEPARATOR_COLOR
   409	
   410	    template_specs: list[dict] = []
   411	    for row0, holes in zip(row_starts, band_holes):
   412	        kind = kind_by_holes[holes]
   413	        base_mask = TEMPLATE_LIBRARY[(holes, kind)]
   414	        rotation, flip_lr = rng.choice(ALLOWED_TRANSFORMS[kind])
   415	        mask = _transform_mask(base_mask, rotation, flip_lr)
   416	        col0 = rng.randint(0, left_width - mask.shape[1])
   417	        local_candidates = _enumerate_fill_candidates(mask, SHAPE_OFFSETS[kind])
   418	        assert len(local_candidates) == 1
   419	        assert local_candidates[0]["holes"] == holes
   420	        for rr, cc in zip(*np.where(mask)):
   421	            grid[row0 + int(rr), col0 + int(cc)] = TEMPLATE_COLOR
   422	        template_specs.append(
   423	            {
   424	                "holes": holes,
   425	                "shape_kind": kind,
   426	                "row0": row0,
   427	                "col0": col0,
   428	                "mask": mask,
   429	                "gap_cells": local_candidates[0]["cells_local"],
   430	            }
   431	        )
   432	
   433	    colors = list(RIGHT_COLORS)
   434	    rng.shuffle(colors)
   435	    color_by_kind = {kind: color for kind, color in zip(shape_kinds, colors)}
   436	    right_positions = _sample_right_boxes(rng, height, sep_col, width, shape_kinds)
   437	    for kind in shape_kinds:
   438	        patch = _shape_patch(kind, color_by_kind[kind])
   439	        r0, c0 = right_positions[kind]
   440	        for rr, cc in zip(*np.where(patch)):
   441	            grid[r0 + int(rr), c0 + int(cc)] = int(patch[rr, cc])
   442	
   443	    expected = grid.copy()
   444	    expected[:, sep_col] = BG
   445	    for kind in shape_kinds:
   446	        patch = _shape_patch(kind, color_by_kind[kind])
   447	        r0, c0 = right_positions[kind]
   448	        for rr, cc in zip(*np.where(patch)):
   449	            expected[r0 + int(rr), c0 + int(cc)] = BG
   450	    for spec in template_specs:
   451	        for dr, dc in spec["gap_cells"]:
   452	            expected[spec["row0"] + dr, spec["col0"] + dc] = color_by_kind[spec["shape_kind"]]
   453	        for rr, cc in zip(*np.where(spec["mask"])):
   454	            expected[spec["row0"] + int(rr), spec["col0"] + int(cc)] = RECOLOR_BY_HOLES[
   455	                spec["holes"]
   456	            ]
   457	
   458	    return grid, expected
   459	
   460	
   461	def _semantic_ok(inp: np.ndarray, expected: np.ndarray) -> bool:
   462	    try:
   463	        solved = _solve(inp)
   464	        actual = main(inp)
   465	    except Exception:
   466	        return False
   467	    if not np.array_equal(actual, expected):
   468	        return False
   469	    if sorted(solved["assignment"][ti]["holes"] for ti in range(3)) != [0, 1, 2]:
   470	        return False
   471	    for ti in range(3):
   472	        matched = sum(1 for si in range(3) if solved["pair_options"][(ti, si)])
   473	        if matched != 1:
   474	            return False
   475	    for si in range(3):
   476	        matched = sum(1 for ti in range(3) if solved["pair_options"][(ti, si)])
   477	        if matched != 1:
   478	            return False
   479	    return True
   480	
   481	
   482	def generate_input() -> np.ndarray:
   483	    rng = random.Random()
   484	    for _ in range(400):
   485	        inp, expected = _build_case(rng)
   486	        if max(inp.shape) > 30 or max(expected.shape) > 30:
   487	            continue
   488	        if _semantic_ok(inp, expected):
   489	            return inp
   490	    raise RuntimeError("failed to generate a valid puzzle instance")

