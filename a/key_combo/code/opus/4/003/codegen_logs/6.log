+    per_bar = {spec["rank"]: _outline_cells(spec, shape) - body_cells for spec in specs}
+    return {
+        (ra, rb): len(per_bar[ra] & per_bar[rb])
+        for ra in per_bar
+        for rb in per_bar
+        if ra < rb
+    }
