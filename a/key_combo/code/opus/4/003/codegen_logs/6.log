+    specs = [_rank_spec(spec, rank) for rank, spec in enumerate(bars, start=1)]
+    out = main(grid)
+    expected = _render_from_specs(specs, grid.shape, BLACK)
+    assert np.array_equal(out, expected)
+    return {
