+    per_bar = [_outline_cells(spec, shape) - body_cells for spec in specs]
+    overlap: set[tuple[int, int]] = set()
+    for i in range(len(per_bar)):
+        for j in range(i + 1, len(per_bar)):
+            overlap |= per_bar[i] & per_bar[j]
+    return len(overlap)
