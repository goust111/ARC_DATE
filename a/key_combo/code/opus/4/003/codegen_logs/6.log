    if hi < lo:
        return None
    center = (long_dim - run) // 2
    lo = max(lo, center - POCKET_CENTER_JITTER)
    hi = min(hi, center + POCKET_CENTER_JITTER)
    return random.randint(lo, hi)


def _gen_pocket_params(height, width, edge):
