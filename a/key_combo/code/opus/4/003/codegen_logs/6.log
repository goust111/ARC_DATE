        if not _gen_coords_cover_origin(sprite_coords, r0, c0):
            placements.append((dr, dc, r0, c0))
    if not placements:
        return None

    dr, dc, r0, c0 = random.choice(placements)
    frames = [
        _gen_paint_sprite((height, width), sprite, r0 + t * dr, c0 + t * dc)
        for t in GEN_TRANSLATION_TIMES
