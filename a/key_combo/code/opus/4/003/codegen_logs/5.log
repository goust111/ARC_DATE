    col_triplets = _triplets(col_lo, col_hi, GLYPH_MIN_SEP)
    if not row_triplets or not col_triplets:
        return None

    return (
        height,
        width,
        template_r0,
        template_c0,
        row_triplets[int(np.random.randint(len(row_triplets)))],
        col_triplets[int(np.random.randint(len(col_triplets)))],

