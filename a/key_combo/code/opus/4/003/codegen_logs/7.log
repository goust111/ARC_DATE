+        return True
+    except Exception:
+        return False
+
+
+def _gen_attempt() -> np.ndarray | None:
+    radius = random.choice(RADIUS_CHOICES)
+    span = 2 * radius + 1
+
+    height = span + random.randint(2 * GRID_MARGIN_MIN, 2 * GRID_MARGIN_MAX)
+    width = span + random.randint(2 * GRID_MARGIN_MIN, 2 * GRID_MARGIN_MAX)
