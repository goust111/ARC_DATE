+def _filter_interior(
+    grid: np.ndarray,
+    bg: int,
+    frame_color: int,
+    center_r: int,
+    center_c: int,
+    radius: int,
+    keep_color: int,
+) -> tuple[np.ndarray, set[tuple[int, int]]]:
+    out = grid.copy()
+    erased: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(grid != bg):
