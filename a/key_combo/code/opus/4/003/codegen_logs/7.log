    if len(used_rows) < 2:
        mask[GEN_PREFIX_REPAIR_ROW, c0 + span // 2] = True

    inc_color, static_color = random.sample(GEN_PANEL_COLORS, 2)
    cols = np.broadcast_to(np.arange(width), (height, width))
    frames = []
    for front in fronts:
