+        if i < OBSERVED_FRAMES - 1:
+            out[row0 + panel_h, :] = SEPARATOR
+    return out
+
+
+def _semantic_checks(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    observed_panels: list[np.ndarray],
+    patches: list[np.ndarray],
+    positions: list[tuple[int, int]],
+    dr: int,
+    dc: int,
+) -> bool:
