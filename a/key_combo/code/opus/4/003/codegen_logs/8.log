    choices_by_size = {}
    for h in _GEN_BODY_HEIGHTS:
        for w in _GEN_BODY_WIDTHS:
            lo = max(
                _GEN_BODY_AREA_MIN, int(np.ceil(_GEN_BODY_DENSITY_MIN * h * w)), max(h, w)
            )
            hi = min(_GEN_BODY_AREA_MAX, int(np.floor(_GEN_BODY_DENSITY_MAX * h * w)))
            if lo > hi:
