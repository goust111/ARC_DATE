FOUR_BARRIER_HEIGHT_RANGE, FOUR_BARRIER_WIDTH = (8, 12), 12
FOUR_BARRIER_COLUMNS = (1, 4, 7, 10)
FOUR_BARRIER_NUB_DIRECTIONS, FOUR_BARRIER_REGION_COUNT = (-1, 1), 5
