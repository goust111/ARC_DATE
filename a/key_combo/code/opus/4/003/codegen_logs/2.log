    expected = grid.copy()
    expected[r0 + 1 : r0 + rect_h - 1, c0 + 1 : c0 + rect_w - 1] = Color.TEAL

    try:
        if np.array_equal(main(grid), expected):
            return grid
    except Exception:
        return None
    return None


