+            nr = center_r + rr
+            nc = center_c + cc
+            assert 0 <= nr < CELL_SIZE and 0 <= nc < CELL_SIZE
+            out[nr, nc] = STAMP
+    return out
+
+
+def _stamp_same_parity(
+    out: np.ndarray,
+    row_cells: list[tuple[int, int]],
+    col_cells: list[tuple[int, int]],
+    parity: tuple[int, int],
+    stamp_patch: np.ndarray,
+) -> None:
