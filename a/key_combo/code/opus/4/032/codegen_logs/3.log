+import itertools
+import random
+
+import numpy as np
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GRAY = 5
+    PINK = 6
+    ORANGE = 7
+
+
+PAIR_COLORS = [
+    Color.BLUE,
+    Color.RED,
+    Color.YELLOW,
+    Color.GRAY,
+    Color.PINK,
+    Color.ORANGE,
+]
