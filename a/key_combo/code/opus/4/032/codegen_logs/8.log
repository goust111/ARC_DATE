+
+
+def _expected_output(
+    rows: list[tuple[int, int]],
+    shape: tuple[int, int],
+    bars: list[tuple[tuple[int, int], tuple[int, int]]],
+    center: tuple[int, int],
+    target_col: int,
+) -> np.ndarray:
