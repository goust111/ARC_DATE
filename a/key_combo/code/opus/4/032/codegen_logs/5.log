+        if seen[sr, sc]:
+            continue
+        q = deque([(sr, sc)])
+        seen[sr, sc] = True
+        coords: list[tuple[int, int]] = []
+        while q:
+            r, c = q.popleft()
+            coords.append((r, c))
+            for dr, dc in dirs:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
