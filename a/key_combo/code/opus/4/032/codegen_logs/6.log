def any_cover(shape):
    cells=set(shape)
    pieces=[]
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    for r in range(min(rs)-2,max(rs)+1):
        for c in range(min(cs)-2,max(cs)+1):
            sq={(r,c),(r+1,c),(r,c+1),(r+1,c+1)}
            if sq<=cells: pieces.append(('sq',sq))
            h={(r,c+i) for i in range(3)}
            if h<=cells: pieces.append(('h',h))
            v={(r+i,c) for i in range(3)}
            if v<=cells: pieces.append(('v',v))
    # exact cover backtracking
    def bt(rem, chosen):
        if not rem: return chosen
        cell=min(rem)
        for name,p in pieces:
            if cell in p and p<=rem:
                ans=bt(rem-p, chosen+[(name,p)])
                if ans is not None: return ans
        return None
    return bt(cells,[])

