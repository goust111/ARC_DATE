+        "pattern": pattern,
+        "ray_distances": ray_distances,
+        "anchor_rel": anchor_rel,
+        "scatter_rel": scatter_rel,
+        "compressed_rel": compressed_rel,
+        "all_rel": all_rel,
+        "padded_rel": padded_rel,
+    }
+
