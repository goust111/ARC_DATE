+    min_r = -min(r for r, _ in padded_rel)
+    max_r = (h - 1) - max(r for r, _ in padded_rel)
+    min_c = -min(c for _, c in padded_rel)
+    max_c = (w - 1) - max(c for _, c in padded_rel)
