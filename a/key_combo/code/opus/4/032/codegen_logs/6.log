+def _parse_color_object(grid: np.ndarray, color: int) -> tuple[tuple[int, int], dict[tuple[int, int], list[int]]]:
+    comps = find_components(
+        grid,
+        bg=BG,
+        connectivity=8,
+        monochromatic=True,
+        colors=[color],
+        return_format="dict",
+    )
+    anchor_candidates = []
+    for comp in comps:
