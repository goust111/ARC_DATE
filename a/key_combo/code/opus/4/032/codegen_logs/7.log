0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """Fill a green-lined table by coloring its four corner cells and its fully internal cells.
0015: 
0016:     Input structure
0017:     - The input contains a black background and one foreground separator color forming complete horizontal and vertical grid lines.
0018:     - Those separator lines divide the canvas into rectangular background cells.
0019:     Rule
0020:     - Preserve the separator lines, fill the top-left/top-right/bottom-left/bottom-right cells with red/yellow/blue/teal, and fill every cell that is neither in an outer row band nor an outer column band with orange.
0021:     - Leave all other edge cells black.
0022:     Key insight
0023:     - The green scaffold is a table; output colors depend only on each cell's position in that table: corner, strict interior, or remaining edge.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     bg = get_bg(g)
0027:     assert bg == Color.BLACK
0028:     fg_colors = colors_present(g, exclude={bg})
0029:     assert len(fg_colors) == 1
0030:     line_color = fg_colors[0]
0031:     assert line_color == Color.GREEN
0032: 
0033:     full_rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == line_color)]
0034:     full_cols = [c for c in range(g.shape[1]) if np.all(g[:, c] == line_color)]
0035:     assert full_rows and full_cols
0036: 
0037:     line_mask = g == line_color
0038:     expected_line_mask = np.zeros(g.shape, dtype=bool)
0039:     expected_line_mask[full_rows, :] = True
0040:     expected_line_mask[:, full_cols] = True
0041:     assert np.array_equal(line_mask, expected_line_mask)
0042: 
0043:     row_regions = _regions_between(full_rows, g.shape[0])
0044:     col_regions = _regions_between(full_cols, g.shape[1])
0045:     assert len(row_regions) >= 2 and len(col_regions) >= 2
0046: 
0047:     out = g.copy()
0048:     last_row = len(row_regions) - 1
0049:     last_col = len(col_regions) - 1
0050:     for row_i, (r0, r1) in enumerate(row_regions):
0051:         for col_i, (c0, c1) in enumerate(col_regions):
0052:             fill = None
0053:             if row_i == 0 and col_i == 0:
0054:                 fill = Color.RED
0055:             elif row_i == 0 and col_i == last_col:
0056:                 fill = Color.YELLOW
0057:             elif row_i == last_row and col_i == 0:
0058:                 fill = Color.BLUE
