+    for info in analysis["clusters"]:
+        expected_len = len(analysis["assignments"][info["id"]])
+        ar, ac = info["anchor"]
+        drawn = 0
+        rr = ar + 1
+        while rr < out.shape[0] and out[rr, ac] == RED:
+            drawn += 1
+            rr += 1
+        if drawn != expected_len:
