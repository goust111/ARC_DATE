+    cells = list(meta)
+    tie_cells = [cell for cell in cells if meta[cell]["tie"]]
+    mismatch_cells = [cell for cell in cells if meta[cell]["owner"] != meta[cell]["anchor_owner"]]
+    if not tie_cells or not mismatch_cells:
+        return None
+
+    for _ in range(200):
