+    for info in analysis["clusters"]:
+        ray_len = len(analysis["assignments"][info["id"]])
+        ar, ac = info["anchor"]
+        for step in range(1, ray_len + 1):
+            rr = ar + step
+            if rr >= out.shape[0] or out[rr, ac] != BLACK:
