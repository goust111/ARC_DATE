+def _is_four_connected(coords: list[tuple[int, int]]) -> bool:
+    coord_set = set(coords)
+    stack = [coords[0]]
+    seen = {coords[0]}
+    while stack:
+        cur = stack.pop()
+        for nxt in _neighbors(cur, 4):
+            if nxt in coord_set and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
