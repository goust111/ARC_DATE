+def _paint_grid(h: int, w: int, clusters: list[list[tuple[int, int]]], singletons: list[tuple[int, int]]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for comp in clusters:
+        for r, c in comp:
