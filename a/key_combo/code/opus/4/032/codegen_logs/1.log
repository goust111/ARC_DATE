+
+def _touches_selected(cell: tuple[int, int], chosen: list[tuple[int, int]]) -> bool:
+    r, c = cell
+    for rr, cc in chosen:
+        if max(abs(r - rr), abs(c - cc)) <= 1:
+            return True
+    return False
+
+
+def _choose_singletons(
+    meta: dict[tuple[int, int], dict],
+    cluster_count: int,
+    rng: random.Random,
