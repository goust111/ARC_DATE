+    out = np.full((HEIGHT, WIDTH), Color.BLACK, dtype=int)
+    out[:top_h] = g[:top_h]
+    for row in range(top_h, HEIGHT):
+        out[row, blue_rows[row]] = Color.BLUE
+    out[g == Color.GREY] = Color.GREY
+    out[mark_row, mark_col] = Color.RED
+    return out
