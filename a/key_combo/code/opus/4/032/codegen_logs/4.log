+
+def _variant_sequential_from_cropped(details: dict) -> np.ndarray:
+    g = details["grid"]
+    top_h = details["top_h"]
+    period = details["period"]
+    shift = details["shift"]
+    mark_row, mark_col = details["marker"]
+    wall_rows = set(details["wall_rows"])
