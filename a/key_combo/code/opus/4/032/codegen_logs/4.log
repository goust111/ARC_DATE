+
+def _variant_without_cropping(details: dict) -> np.ndarray:
+    out = np.full((HEIGHT, WIDTH), Color.BLACK, dtype=int)
+    g = details["grid"]
+    top_h = details["top_h"]
+    out[:top_h] = g[:top_h]
+    for row in range(top_h, HEIGHT):
