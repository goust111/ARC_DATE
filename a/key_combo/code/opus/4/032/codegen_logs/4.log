+    mark_row, mark_col = details["marker"]
+    if np.array_equal(out, grid):
+        return False
+    if np.array_equal(out, _variant_without_cropping(details)):
+        return False
+    if np.array_equal(out, _variant_sequential_from_cropped(details)):
