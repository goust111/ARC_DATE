+            else:
+                vertical_count += 1
+        else:
+            nonrectangles.append(obj)
+
+    if horizontal_count < 1 or vertical_count < 1 or len(nonrectangles) < 1:
+        return False
+    if len(rectangles) < 2:
+        return False
+    if not _visible_overlap_exists(rectangles, grid.shape):
