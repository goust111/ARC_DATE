+    h_h, h_w = h_patch.shape
+    v_h, v_w = v_patch.shape
+
+    if h_edge == "top":
+        row_range = (2, h - h_h - v_h)
+    else:
+        row_range = (h_h, h - v_h - 2)
+    if v_edge == "left":
+        col_range = (2, w - v_w - h_w)
+    else:
+        col_range = (v_w, w - h_w - 2)
+
+    first = _try_place(
+        grid,
+        occupied,
+        h_patch,
+        colors[0],
+        h_edge,
+        rectangles=rectangles,
+        col_range=col_range,
+        require_destination_free=True,
