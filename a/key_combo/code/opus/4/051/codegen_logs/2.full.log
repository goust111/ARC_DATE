+TRAIL_COLOR = 7
+CROSS_COLOR = 2
+INPUT_COLOR_POOL = [1, 3, 4, 6, 8, 9]
+EDGES = ("top", "bottom", "left", "right")
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
