+            for nr in range(max(0, gr - 1), min(h, gr + 2)):
+                for nc in range(max(0, gc - 1), min(w, gc + 2)):
+                    if occupied[nr, nc]:
+                        return False
+    return True
+
+
+def _place_patch(grid: np.ndarray, patch: np.ndarray, color: int, r0: int, c0: int) -> dict:
+    coords = np.argwhere(patch).astype(int)
+    coords[:, 0] += int(r0)
