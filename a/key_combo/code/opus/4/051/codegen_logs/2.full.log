+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 5
+TRAIL_COLOR = 7
+CROSS_COLOR = 2
+INPUT_COLOR_POOL = [1, 3, 4, 6, 8, 9]
+EDGES = ("top", "bottom", "left", "right")
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, np.asarray(grid).ravel())).most_common(1)[0][0])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_hw(box: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _find_objects(grid: np.ndarray, bg: int) -> list[dict]:
+    objects: list[dict] = []
+    for coords in _components(grid != bg):
+        colors = {int(grid[r, c]) for r, c in coords}
+        if len(colors) != 1:
+            raise AssertionError("each object must be monochrome")
+        color = next(iter(colors))
+        objects.append(
+            {
+                "color": int(color),
+                "coords": coords,
+                "bbox": _bbox(coords),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return objects
+
+
+def _touching_edges(box: tuple[int, int, int, int], shape: tuple[int, int]) -> list[str]:
+    h, w = map(int, shape)
+    r0, c0, r1, c1 = box
+    edges: list[str] = []
+    if r0 == 0:
+        edges.append("top")
+    if r1 == h - 1:
+        edges.append("bottom")
+    if c0 == 0:
+        edges.append("left")
+    if c1 == w - 1:
+        edges.append("right")
+    return edges
+
+
+def _is_solid_rectangle(obj: dict) -> bool:
+    box = obj["bbox"]
+    h, w = _bbox_hw(box)
+    return int(obj["area"]) == h * w and (h >= 2 or w >= 2)
+
+
+def _trail_and_destination(
+    box: tuple[int, int, int, int], edge: str, shape: tuple[int, int]
+) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]]:
+    h, w = map(int, shape)
+    r0, c0, r1, c1 = box
+    obj_h, obj_w = _bbox_hw(box)
+    if edge == "top":
+        return (0, c0, h - 1, c1), (h - obj_h, c0, h - 1, c1)
+    if edge == "bottom":
+        return (0, c0, h - 1, c1), (0, c0, obj_h - 1, c1)
+    if edge == "left":
+        return (r0, 0, r1, w - 1), (r0, w - obj_w, r1, w - 1)
