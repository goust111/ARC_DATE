+    if edge == "left":
+        return [(r, 0) for r in range(1, h - ph)]
+    return [(r, w - pw) for r in range(1, h - ph)]
+
+
+def _can_place(occupied: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = occupied.shape
+    ph, pw = patch.shape
+    for rr in range(ph):
+        for cc in range(pw):
