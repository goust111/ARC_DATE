+    gaps: list[int] = []
+    for idx in range(seed_count - 1):
+        if block_start <= idx < block_start + block_len - 1:
+            gaps.append(2)
+        else:
+            gaps.append(random.choice(EXTRA_GAPS))
+
+    span = 1 + sum(gaps)
+    if span > width - 2:
+        return None
+
+    start_col = random.randint(1, width - span - 1)
+    cols = [start_col]
+    for gap in gaps:
+        cols.append(cols[-1] + gap)
+    return cols
