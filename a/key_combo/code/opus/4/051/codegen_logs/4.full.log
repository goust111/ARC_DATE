+            core = cols[1:-1]
+        else:
+            core = cols
+        for col in core:
+            obstacles = {(int(row), int(col))}
+            sim = _simulate_growth(seed_row, seed_cols, obstacles, shape)
+            if len(sim["actual_generations"]) < 2:
