+                out[child_row, int(col)] = HIT_COLOR
+            else:
+                out[child_row, int(col)] = color
+                survivors.append(int(col))
+
+        if not survivors:
+            break
+
+        active_cols = survivors
+        row = child_row
+        generation_index += 1
+
+    return out
