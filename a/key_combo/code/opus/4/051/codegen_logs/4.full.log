+
+    span = 1 + sum(gaps)
+    if span > width - 2:
+        return None
+
+    start_col = random.randint(1, width - span - 1)
+    cols = [start_col]
+    for gap in gaps:
+        cols.append(cols[-1] + gap)
+    return cols
+
+
+def _choose_primary_hit(
+    potential_generations: list[tuple[int, tuple[int, ...]]],
