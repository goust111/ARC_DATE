+def _choose_extra_hits(
+    current_obstacles: set[tuple[int, int]],
+    seed_row: int,
+    seed_cols: list[int],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
+    result = set(current_obstacles)
+    target_extra = random.randint(0, 2)
+    for _ in range(target_extra):
