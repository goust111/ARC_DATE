+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None and _validate_instance(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid control-quadrant rectangle-rotation input")

