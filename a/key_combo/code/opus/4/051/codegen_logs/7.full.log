+    if r0 == 0:
+        sides.append("top")
+    if r1 == h - 1:
+        sides.append("bottom")
+    if c0 == 0:
+        sides.append("left")
+    if c1 == w - 1:
+        sides.append("right")
+    assert len(sides) == 1, "each rectangle must touch exactly one outer edge"
+    return sides[0]
+
