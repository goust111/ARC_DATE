        choices = [r for r in range(h) if r != h - 1 - r]
        arm_row = random.choice(choices)
        mask[arm_row, :] = True
        mirror_row = h - 1 - arm_row
        forbidden.update(_gen_orbit("V", mask.shape, mirror_row, 0))
    else:
        for i in range(h):
            mask[i, i] = True
        for i in range(h - 1):
            mask[i, i + 1] = True
            mask[i + 1, i] = True

