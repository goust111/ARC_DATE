def _gen_base_area(kind, h, w):
    if kind == "H":
        return (1 if h % 2 else 2) * w + h - (1 if h % 2 else 2)
    if kind == "V":
        return (1 if w % 2 else 2) * h + w - (1 if w % 2 else 2)
    return 3 * h - 2


