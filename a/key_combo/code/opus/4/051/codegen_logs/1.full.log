+        mask = crop_bbox(g == color, bbox)
+        kind = _symmetry_kind(mask)
+        assert 3 <= int(obj["area"]) <= 6, "object size must be within 3-6 pixels"
+        parsed.append(
+            {
+                "color": color,
+                "coords": coords,
+                "bbox": bbox,
+                "mask": mask,
+                "kind": kind,
+            }
+        )
+
+    parsed.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
+
+    for i, left in enumerate(parsed):
