+    coords = np.asarray(obj["coords"], dtype=int)
+    if obj["kind"] == "H":
+        for c in sorted(set(map(int, coords[:, 1]))):
+            for r in range(h):
+                cells.add((r, c))
+    else:
+        for r in sorted(set(map(int, coords[:, 0]))):
+            for c in range(w):
+                cells.add((r, c))
+    return cells
+
+
