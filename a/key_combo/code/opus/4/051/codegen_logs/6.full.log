+def _choose_rows_cols(height: int, width: int, h_count: int, v_count: int) -> tuple[list[int], list[int]]:
+    rows = sorted(random.sample(range(1, height - 1), h_count))
+    cols = sorted(random.sample(range(1, width - 1), v_count))
