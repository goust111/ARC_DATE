+    r0, c0 = map(int, start)
+    r1, c1 = map(int, end)
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        canvas[r0, lo : hi + 1] = int(color)
+        rr = np.full(hi - lo + 1, r0, dtype=int)
+        cc = np.arange(lo, hi + 1, dtype=int)
+    elif c0 == c1:
