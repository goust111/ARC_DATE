+
+    return out
+
+
+def _template_ok(mask: np.ndarray) -> bool:
+    if mask.shape != (3, 3):
+        return False
+    if len(_components(mask.astype(bool))) != 1:
+        return False
+    rots = [np.rot90(mask, k=k) for k in (0, -1, 2)]
