+        return False
+    covers = [bool(rot[0, 0]) for rot in rots]
+    return any(covers) and not all(covers)
+
+
+def _wall_mask(opening: str, t: int, inner_h: int, inner_w: int) -> tuple[np.ndarray, tuple[int, int]]:
+    if opening in ("top", "bottom"):
+        h = inner_h + t
+        w = inner_w + 2 * t
+    else:
+        h = inner_h + 2 * t
+        w = inner_w + t
+
+    mask = np.zeros((h, w), dtype=bool)
+    if opening == "top":
+        mask[:, :t] = True
+        mask[:, w - t :] = True
+        mask[h - t :, :] = True
+        cavity_origin = (0, t)
+    elif opening == "bottom":
+        mask[:, :t] = True
+        mask[:, w - t :] = True
+        mask[:t, :] = True
+        cavity_origin = (t, t)
+    elif opening == "left":
+        mask[:t, :] = True
+        mask[h - t :, :] = True
+        mask[:, w - t :] = True
+        cavity_origin = (t, 0)
+    else:
+        mask[:t, :] = True
+        mask[h - t :, :] = True
+        mask[:, :t] = True
+        cavity_origin = (t, t)
+    return mask, cavity_origin
+
+
+def _corner_position(h: int, w: int, corner: str) -> tuple[int, int]:
+    if corner == "top_left":
+        return 0, 0
+    if corner == "top_right":
+        return 0, w - 3
+    if corner == "bottom_left":
