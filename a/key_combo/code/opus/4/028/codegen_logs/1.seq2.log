+def _cavity_slice(mask: np.ndarray, opening: str, t: int) -> tuple[slice, slice]:
+    h, w = mask.shape
+    if opening == "top":
+        return slice(0, h - t), slice(t, w - t)
+    if opening == "bottom":
+        return slice(t, h), slice(t, w - t)
+    if opening == "left":
+        return slice(t, h - t), slice(0, w - t)
+    return slice(t, h - t), slice(t, w)
+
+
