+def _paint_patch(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    ph, pw = patch.shape
+    view = dst[r0 : r0 + ph, c0 : c0 + pw]
+    view[patch == ORANGE] = ORANGE
