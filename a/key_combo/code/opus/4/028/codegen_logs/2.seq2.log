+    r, c = center
+    return {(rr, cc) for rr in range(r - 1, r + 2) for cc in range(c - 1, c + 2)}
+
+
+def _arrow_cells(center: tuple[int, int], direction: tuple[int, int], style: int) -> set[tuple[int, int]]:
+    r, c = center
+    mask = _arrow_mask(direction, style)
+    return {
+        (r - 1 + rr, c - 1 + cc)
+        for rr in range(3)
+        for cc in range(3)
