+    bbox_owner: dict[tuple[int, int], int] = {}
+    for idx, arrow in enumerate(arrows):
+        r0, c0, r1, c1 = arrow["bbox"]
+        for rr in range(r0, r1 + 1):
+            for cc in range(c0, c1 + 1):
+                bbox_owner[(rr, cc)] = idx
