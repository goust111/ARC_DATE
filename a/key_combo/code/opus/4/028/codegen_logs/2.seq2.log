+    available_centers = [
+        (r, c)
+        for r in row_lanes
+        for c in col_lanes
+        if (r, c) not in used_centers
+        and not (_bbox_cells((r, c)) & occupied_bboxes)
+        and not (_bbox_cells((r, c)) & used_ray_cells)
