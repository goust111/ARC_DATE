+            out[r, c] = RED
+        for r, c in _arrow_cells(dst["center"], dst["direction"], dst["style"]):
+            if out[r, c] != RED:
+                out[r, c] = BG
+        rr, cc = dst["center"]
+        view = out[rr - 1 : rr + 2, cc - 1 : cc + 2]
+        view[seed_mask] = RED
