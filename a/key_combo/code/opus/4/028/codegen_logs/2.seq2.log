+    shape: tuple[int, int],
+    source_center: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    rr, cc = source_center
+    path: list[tuple[int, int]] = []
+    while True:
