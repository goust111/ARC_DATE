+def _compose_output(
+    shape: tuple[int, int],
+    red_pt: tuple[int, int],
+    blue_pt: tuple[int, int],
+    green_cells: set[tuple[int, int]],
+    mask_cells: set[tuple[int, int]],
+) -> np.ndarray:
