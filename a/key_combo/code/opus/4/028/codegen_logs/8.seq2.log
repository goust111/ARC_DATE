+    left: int,
+    markers: dict[int, tuple[int, int]],
+    strategy: str,
+    mode: str,
+) -> None:
+    cells, _segments = build_paths(markers, strategy, mode)
+    for rr, cc in cells:
+        grid[top + 1 + rr, left + 1 + cc] = PATH_COLOR
+
+
+def build_scene(
