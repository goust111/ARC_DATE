+def draw_frame(grid: np.ndarray, top: int, left: int, side: int, color: int) -> None:
+    bottom = top + side - 1
+    right = left + side - 1
+    grid[top, left : right + 1] = color
+    grid[bottom, left : right + 1] = color
+    grid[top : bottom + 1, left] = color
+    grid[top : bottom + 1, right] = color
