+            r0, c0, r1, c1 = bbox_coords(comp)
+            hh = r1 - r0 + 1
+            ww = c1 - c0 + 1
+            if hh < 5 or ww < 5:
+                continue
+            expected_area = 2 * (hh + ww) - 4
+            if len(comp) != expected_area:
+                continue
+            border_ok = True
+            for rr in range(r0, r1 + 1):
+                for cc in range(c0, c1 + 1):
+                    on_border = rr in (r0, r1) or cc in (c0, c1)
+                    if on_border and int(grid[rr, cc]) != color:
