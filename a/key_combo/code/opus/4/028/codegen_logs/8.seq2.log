+        w = random.randint(22, 29)
+        r1 = random.randint(1, 3)
+        c1 = random.randint(1, 3)
+        r2_min = r1 + side + 2
+        c2_min = c1 + side + 2
+        if r2_min > h - side - 1 or c2_min > w - side - 1:
+            continue
+        r2 = random.randint(r2_min, h - side - 1)
+        c2 = random.randint(c2_min, w - side - 1)
+        slots = [(r1, c1), (r1, c2), (r2, c1), (r2, c2)]
+        return h, w, slots
