+    if len(grey_comps) != 2:
+        raise ValueError("expected two path components")
+    edges: list[frozenset[int]] = []
+    modes: list[str] = []
+    for comp in grey_comps:
+        comp_set = set(comp)
+        touched: set[int] = set()
+        for rr, cc in comp:
+            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                if 0 <= nr < inner.shape[0] and 0 <= nc < inner.shape[1]:
+                    cell = int(inner[nr, nc])
+                    if cell in MARKER_COLORS:
+                        touched.add(cell)
+        if len(touched) != 2:
+            raise ValueError("path must touch exactly two markers")
+        colors = sorted(touched)
+        edge = frozenset(colors)
+        expected_hv = set(route_cells(markers[colors[0]], markers[colors[1]], "hv"))
+        expected_vh = set(route_cells(markers[colors[0]], markers[colors[1]], "vh"))
+        if comp_set == expected_hv and comp_set != expected_vh:
+            modes.append("hv")
+        elif comp_set == expected_vh and comp_set != expected_hv:
+            modes.append("vh")
+        else:
