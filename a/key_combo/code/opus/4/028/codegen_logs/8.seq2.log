+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLORS = (1, 2, 3)
+MARKER_COLORS = (4, 7, 9)
+PATH_COLOR = 5
+SOURCE_STRATEGY = "col"
+SOURCE_MODE = "hv"
+TARGET_STRATEGIES = ("row", "sum")
+ROUTE_MODES = ("hv", "vh")
+ALL_STRATEGIES = ("col", "row", "sum")
