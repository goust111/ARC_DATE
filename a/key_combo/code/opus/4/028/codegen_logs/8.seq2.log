+    for _ in range(3000):
+        rows = random.sample(range(inner_size), 3)
+        cols = random.sample(range(inner_size), 3)
+        col_perm = random.sample((0, 1, 2), 3)
+        chosen = [(rows[i], cols[col_perm[i]]) for i in range(3)]
