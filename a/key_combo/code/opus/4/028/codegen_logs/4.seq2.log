+            return False
+        if rect["stretch"] != spec["stretch"]:
+            return False
+        if rect["stretch"] < min(spec["count"], spec["boundary_allowance"]):
+            overlap_hit = True
+        if spec["boundary_allowance"] < spec["count"] and rect["stretch"] == spec["boundary_allowance"]:
+            edge_hit = True
