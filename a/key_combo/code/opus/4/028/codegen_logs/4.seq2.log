+
+
+def _place_edge_rect(
+    shape: tuple[int, int],
+    blocked: np.ndarray,
+    existing_specs: list[dict],
+    color: int,
+) -> dict | None:
+    h, w = shape
+    for direction in random.sample(DIRS, k=4):
+        for _ in range(100):
+            rh = random.randint(4, 6)
+            rw = random.randint(4, 6)
+            if direction == "up":
+                if h - rh - 1 < 3:
+                    continue
+                r0 = 3
+                c0 = random.randint(0, w - rw)
+                marker_offset = random.randint(0, rw - 1)
+            elif direction == "down":
+                if h - rh - 1 < 3:
+                    continue
+                r0 = h - rh - 3
+                c0 = random.randint(0, w - rw)
+                marker_offset = random.randint(0, rw - 1)
+            elif direction == "left":
+                if w - rw - 1 < 3:
+                    continue
+                r0 = random.randint(0, h - rh)
+                c0 = 3
+                marker_offset = random.randint(0, rh - 1)
+            else:
+                if w - rw - 1 < 3:
+                    continue
+                r0 = random.randint(0, h - rh)
+                c0 = w - rw - 3
+                marker_offset = random.randint(0, rh - 1)
+            spec = {
+                "color": color,
+                "bbox": (r0, c0, r0 + rh - 1, c0 + rw - 1),
+                "direction": direction,
+                "count": 4,
+                "marker_gap": 3,
+                "marker_offset": marker_offset,
