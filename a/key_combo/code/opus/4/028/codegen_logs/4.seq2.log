    col_divs = [c for c in range(W) if np.all(input_grid[:, c] == divider)]
    row_divs = [r for r in range(H) if np.all(input_grid[r, :] == divider)]

    output_grid = input_grid.copy()

    if col_divs and not row_divs:
        cuts = [-1] + sorted(col_divs) + [W]
        regions = []
