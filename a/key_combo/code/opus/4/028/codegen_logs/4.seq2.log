+
+    counts = [random.randint(1, 4) for _ in range(n_rects)]
+    if len(set(counts)) == 1:
+        counts[random.randrange(n_rects)] = 1 + (counts[0] % 4)
+
+    blocked = np.zeros(shape, dtype=bool)
+    specs: list[dict] = []
+    remaining_colors = colors[:]
+    remaining_counts = counts[:]
+
+    if force_overlap:
