+        counts[random.randrange(n_rects)] = 1 + (counts[0] % 4)
+
+    blocked = np.zeros(shape, dtype=bool)
+    specs: list[dict] = []
+    remaining_colors = colors[:]
+    remaining_counts = counts[:]
+
+    if force_overlap:
+        pair = _place_overlap_pair(shape, blocked, remaining_colors[:2])
+        if pair is None:
+            return None
+        for spec in pair:
