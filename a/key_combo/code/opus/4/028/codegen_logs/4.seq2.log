+                return None
+        specs.extend(pair)
+        remaining_colors = remaining_colors[2:]
+        remaining_counts = remaining_counts[2:]
+
+    if force_edge and remaining_colors:
+        spec = _place_edge_rect(shape, blocked, remaining_colors[0])
+        if spec is None:
