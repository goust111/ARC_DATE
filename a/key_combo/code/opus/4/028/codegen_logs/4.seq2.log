+            {
+                "color": rect["color"],
+                "bbox": boxes[idx],
+                "final_bbox": final_box,
+                "direction": rect["direction"],
+                "marker": rect["marker"],
+                "sprite_count": desired,
+                "stretch": dist,
+                "boundary_allowance": boundary,
+                "overlap_allowance": no_overlap,
