+def _solve(grid: np.ndarray, *, return_debug: bool = False):
+    info = _analyze_grid(grid)
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    boxes = [tuple(rect["bbox"]) for rect in info["rectangles"]]
