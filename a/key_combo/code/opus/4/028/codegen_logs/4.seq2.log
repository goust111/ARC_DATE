+    want = {item["color"]: item for item in expected}
+    if set(got) != set(want):
+        return False
+    overlap_hit = False
+    edge_hit = False
+    for color, spec in want.items():
+        rect = got[color]
+        if rect["direction"] != spec["direction"]:
+            return False
+        if tuple(rect["marker"]) != tuple(_marker_from_spec(spec)):
