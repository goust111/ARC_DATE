+        "slots": slots,
+        "shape_groups": shape_groups,
+        "valid_pairs": valid_pairs,
+        "cross_row_illegal_pairs": cross_row_illegal_pairs,
+        "matched_slots": matched_slots,
+        "between_slots": between_slots,
