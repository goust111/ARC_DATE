+    for bits in range(1, 1 << 9):
+        mask = np.array([(bits >> i) & 1 for i in range(9)], dtype=int).reshape(3, 3)
+        if int(mask.sum()) > 5:
+            continue
+        if len(components_mask(mask.astype(bool), connectivity=4)) != 1:
+            continue
+        masks.append(mask.astype(bool))
