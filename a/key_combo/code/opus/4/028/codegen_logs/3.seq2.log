+    valid_pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    cross_row_illegal_pairs: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    matched_slots: set[tuple[int, int]] = set()
+    for positions in shape_groups.values():
