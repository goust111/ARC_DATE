+    col_intervals: list[tuple[int, int, int]] = []
+    for sc, rows in col_matches.items():
+        for top, bottom in zip(rows, rows[1:]):
+            if bottom - top > 1:
+                col_intervals.append((sc, top, bottom))
+                for sr in range(top + 1, bottom):
+                    between_slots.add((sr, sc))
