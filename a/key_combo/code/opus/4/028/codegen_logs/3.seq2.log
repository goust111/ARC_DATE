+    for i, a in enumerate(values):
+        for b in values[i + 1 :]:
+            if b - a < 2:
+                continue
+            p1 = (fixed_axis, a) if is_row else (a, fixed_axis)
+            p2 = (fixed_axis, b) if is_row else (b, fixed_axis)
+            if p1 in forbidden or p2 in forbidden:
+                continue
+            candidates.append((p1, p2))
