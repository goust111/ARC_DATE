+def _recolor_slot(out: np.ndarray, slot: dict, color: int) -> None:
+    rs, cs = slot["pixel_rc"]
+    sub = out[rs : rs + SLOT_SIZE, cs : cs + SLOT_SIZE]
+    sub[slot["mask"]] = int(color)
