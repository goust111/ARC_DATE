+            continue
+        if np.array_equal(crop, np.flipud(crop)):
+            continue
+        if np.array_equal(crop, np.fliplr(crop)):
+            continue
+        return crop
+
+    raise RuntimeError("failed to build a non-symmetric pattern crop")
+
+
