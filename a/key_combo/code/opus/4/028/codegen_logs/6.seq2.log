+        panel = np.full((h, w), int(panel_color), dtype=int)
+        max_r = interior_h - crop.shape[0]
+        max_c = interior_w - crop.shape[1]
+        off_r = random.randint(0, max_r)
+        off_c = random.randint(0, max_c)
+        paste(panel, crop, 1 + off_r, 1 + off_c)
