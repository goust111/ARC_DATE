+def _detect_marker_side(panel: np.ndarray, panel_color: int) -> tuple[str, int]:
+    sides = {
+        "top": panel[0, :],
+        "bottom": panel[-1, :],
+        "left": panel[:, 0],
+        "right": panel[:, -1],
+    }
