+    if len(details) < 2:
+        return False
+    if sum(int(d["final_fill"].sum()) for d in details) < 12:
+        return False
+    if any(int(d["final_fill"].sum()) < 3 for d in details):
+        return False
+    if sum(int(d["raw_fill"].sum() > d["final_fill"].sum()) for d in details) < 1:
