   299	                r0_min = max(r0_min, LOWER_START + 3)
   300	            elif direction == "down":
   301	                r0_max = min(r0_max, h - wh - 3)
   302	            elif direction == "left":
   303	                c0_min = max(c0_min, 3)
   304	            else:
   305	                c0_max = min(c0_max, w - ww - 3)
   306	            if r0_min > r0_max or c0_min > c0_max:
   307	                continue
   308	            r0 = random.randint(r0_min, r0_max)
   309	            c0 = random.randint(c0_min, c0_max)
   310	            r1 = r0 + wh - 1
   311	            c1 = c0 + ww - 1
   312	
   313	            if direction in ("up", "down"):
   314	                path_col = random.randint(c0 + 1, c1 - 1)
   315	                if direction == "up":
   316	                    seed_r = random.randint(max(r0 + 1, r1 - 2), r1 - 1)
   317	                else:
   318	                    seed_r = random.randint(r0 + 1, min(r1 - 1, r0 + 2))
   319	                seed_c = path_col
   320	                ray_key = path_col
   321	            else:
   322	                path_row = random.randint(r0 + 1, r1 - 1)
   323	                seed_r = path_row
   324	                seed_c = c0 + 1 if direction == "left" else c1 - 1
   325	                ray_key = path_row
   326	
   327	            return {
   328	                "bbox": (r0, c0, r1, c1),
   329	                "direction": direction,
   330	                "seed": (seed_r, seed_c),
   331	                "seed_color": int(seed_color),
   332	                "ray_key": int(ray_key),
   333	            }
   334	    return None
   335	
   336	
   337	def _place_obstacle(grid: np.ndarray, spec: dict) -> tuple[int, int] | None:
   338	    h, w = grid.shape
   339	    r0, c0, r1, c1 = spec["bbox"]
   340	    direction = spec["direction"]
   341	    if direction == "up":
   342	        rows = list(range(LOWER_START + 1, r0 - 1))
   343	        if not rows:
   344	            return None
   345	        return random.choice(rows), spec["ray_key"]
   346	    if direction == "down":
   347	        rows = list(range(r1 + 2, h - 1))
   348	        if not rows:
   349	            return None
   350	        return random.choice(rows), spec["ray_key"]
   351	    if direction == "left":
   352	        cols = list(range(1, c0 - 1))
   353	        if not cols:
   354	            return None
   355	        return spec["ray_key"], random.choice(cols)
   356	    cols = list(range(c1 + 2, w - 1))
   357	    if not cols:
   358	        return None
   359	    return spec["ray_key"], random.choice(cols)
   360	
   361	
   362	def _choose_active_columns(w: int, wall_specs: list[dict]) -> set[int] | None:
   363	    must_active = {int(spec["seed"][1]) for spec in wall_specs}
   364	    for spec in wall_specs:
   365	        r0, c0, r1, c1 = spec["bbox"]
   366	        if spec["direction"] in ("up", "down"):
   367	            must_active.add(int(spec["ray_key"]))
   368	        else:
   369	            must_active.add(c0 + 1 if spec["direction"] == "left" else c1 - 1)
   370	    if len(must_active) >= w:
   371	        return None
   372	
   373	    for _ in range(120):
   374	        target = random.randint(max(w // 2 + 1, len(must_active)), min(w - 1, max(w // 2 + 2, int(0.78 * w))))
   375	        active = set(must_active)
   376	        pool = [c for c in range(w) if c not in active]
   377	        random.shuffle(pool)
   378	        active.update(pool[: max(0, target - len(active))])
   379	        if len(active) < 3:
   380	            continue
   381	        if max(active) - min(active) + 1 < (w // 2 + 1):
   382	            continue
   383	
   384	        good = True
   385	        for spec in wall_specs:
   386	            _r0, c0, _r1, c1 = spec["bbox"]
   387	            interior_cols = set(range(c0 + 1, c1))
   388	            if not (active & interior_cols):
   389	                good = False
   390	                break
   391	            if interior_cols <= active:
   392	                good = False
   393	                break
   394	        if good:
   395	            return active
   396	    return None
   397	
   398	
   399	def _semantic_checks(grid: np.ndarray) -> bool:
   400	    out, details = _solve(grid, use_active=True, use_shadow=True, return_details=True, strict_conflicts=False)
   401	    out_nomask = _solve(grid, use_active=False, use_shadow=True, strict_conflicts=False)
   402	    out_noshadow, no_shadow_details = _solve(
   403	        grid, use_active=True, use_shadow=False, return_details=True, strict_conflicts=False
   404	    )
   405	
   406	    occupied = np.zeros_like(grid, dtype=int)
   407	    for d in details:
   408	        occupied += d["final_fill"].astype(int)
   409	    if np.any(occupied > 1):
   410	        return False
   411	
   412	    if np.array_equal(out, grid):
   413	        return False
   414	    if np.array_equal(out, out_nomask):
   415	        return False
   416	    if np.array_equal(out, out_noshadow):
   417	        return False
   418	    if int(np.sum(out[2] == PINK)) < 3:
   419	        return False
   420	    if len(details) < 2:
   421	        return False
   422	    if sum(int(d["final_fill"].sum()) for d in details) < 12:
   423	        return False
   424	    if any(int(d["final_fill"].sum()) < 3 for d in details):
   425	        return False
   426	    if sum(int(d["raw_fill"].sum() > d["final_fill"].sum()) for d in details) < 1:
   427	        return False
   428	
   429	    active_cols = {int(c) for c in np.where(grid[0] != BLACK)[0]}
   430	    for d, d_ns in zip(details, no_shadow_details):
   431	        _r0, c0, _r1, c1 = d["bbox"]
   432	        interior_cols = set(range(c0 + 1, c1))
   433	        if not (interior_cols & active_cols):
   434	            return False
   435	        if interior_cols <= active_cols:
   436	            return False
   437	        if int(d_ns["raw_fill"].sum()) <= int(d["final_fill"].sum()):
   438	            return False
   439	
   440	    lower_changed = out[LOWER_START:, :] != out_nomask[LOWER_START:, :]
   441	    if int(lower_changed.sum()) < 4:
   442	        return False
   443	    return True
