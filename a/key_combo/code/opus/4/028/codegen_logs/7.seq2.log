+        grid[r0:r1 + 1, c0] = GREY
+        grid[r0:r1 + 1, c1] = GREY
+        grid[r1, c0:c1 + 1] = GREY
+    elif direction == "down":
+        grid[r0:r1 + 1, c0] = GREY
+        grid[r0:r1 + 1, c1] = GREY
+        grid[r0, c0:c1 + 1] = GREY
+    elif direction == "left":
+        grid[r0, c0:c1 + 1] = GREY
+        grid[r1, c0:c1 + 1] = GREY
+        grid[r0:r1 + 1, c1] = GREY
+    else:
+        grid[r0, c0:c1 + 1] = GREY
+        grid[r1, c0:c1 + 1] = GREY
+        grid[r0:r1 + 1, c0] = GREY
+    sr, sc = spec["seed"]
+    grid[sr, sc] = spec["seed_color"]
