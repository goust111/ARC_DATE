+    counts = {
+        "up": int(local_wall[0, :].sum()),
+        "down": int(local_wall[-1, :].sum()),
+        "left": int(local_wall[:, 0].sum()),
+        "right": int(local_wall[:, -1].sum()),
+    }
+    return min(counts, key=lambda side: (counts[side], side))
