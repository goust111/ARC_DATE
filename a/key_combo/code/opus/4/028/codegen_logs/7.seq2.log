+            else:
+                c0_max = min(c0_max, w - ww - 3)
+            if r0_min > r0_max or c0_min > c0_max:
+                continue
+            r0 = random.randint(r0_min, r0_max)
+            c0 = random.randint(c0_min, c0_max)
