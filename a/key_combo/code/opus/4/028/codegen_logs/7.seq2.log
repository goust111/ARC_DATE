+    direction = spec["direction"]
+    if direction == "up":
+        rows = list(range(LOWER_START + 1, r0 - 1))
+        if not rows:
+            return None
+        return random.choice(rows), spec["ray_key"]
+    if direction == "down":
+        rows = list(range(r1 + 2, h - 1))
