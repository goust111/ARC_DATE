   446	def _gen_attempt() -> np.ndarray | None:
   447	    h = random.randint(18, 24)
   448	    w = random.randint(18, 24)
   449	    grid = np.full((h, w), BLACK, dtype=int)
   450	
   451	    control_color = random.choice(CONTROL_COLORS)
   452	    grid[1, 0] = control_color
   453	    grid[2, 0] = control_color
   454	    grid[DIVIDER_ROW, :] = GREY
   455	
   456	    slot_names = list(_slot_bounds(h, w))
   457	    random.shuffle(slot_names)
   458	    num_walls = random.choice([2, 3])
   459	    chosen_slots = slot_names[:num_walls]
   460	
   461	    seed_palette = [c for c in SEED_COLORS if c != control_color]
   462	    random.shuffle(seed_palette)
   463	    wall_specs = []
   464	    for slot in chosen_slots:
   465	        if not seed_palette:
   466	            return None
   467	        spec = _place_wall(h, w, slot, seed_palette.pop())
   468	        if spec is None:
   469	            return None
   470	        wall_specs.append(spec)
