+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OPEN_DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GEN_ATTEMPTS = 400
+DIVIDER_ROW = 3
+LOWER_START = DIVIDER_ROW + 1
