   472	    active_cols = _choose_active_columns(w, wall_specs)
   473	    if active_cols is None:
   474	        return None
   475	    for c in active_cols:
   476	        grid[0, c] = control_color
   477	
   478	    for spec in wall_specs:
   479	        _draw_wall(grid, spec)
   480	
   481	    obstacle_walls = random.sample(wall_specs, k=random.randint(1, min(2, len(wall_specs))))
   482	    for spec in obstacle_walls:
   483	        pos = _place_obstacle(grid, spec)
   484	        if pos is None:
   485	            return None
   486	        r, c = pos
   487	        if grid[r, c] != BLACK:
   488	            return None
   489	        grid[r, c] = MAROON
   490	
   491	    for spec in wall_specs:
   492	        r0, c0, r1, c1 = spec["bbox"]
   493	        if spec["seed"][1] not in active_cols:
   494	            return None
   495	        interior_cols = set(range(c0 + 1, c1))
   496	        if not (interior_cols & active_cols):
   497	            return None
   498	        if interior_cols <= active_cols:
   499	            return None
   500	
   501	    if not _semantic_checks(grid):
   502	        return None
   503	    return grid
