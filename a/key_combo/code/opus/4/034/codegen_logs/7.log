+    return panel, markers
+
+
+def _sample_rotations() -> dict[int, int]:
+    cue_count = random.randint(1, 3)
+    chosen = random.sample(list(QUADRANT_COLORS.values()), k=cue_count)
+    rotations = {int(color): 0 for color in QUADRANT_COLORS.values()}
