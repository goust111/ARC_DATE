+
+BG = Color.BLACK
+CROSS = Color.GREY
+QUADRANT_COLORS = {"tl": Color.BLUE, "tr": Color.RED, "bl": Color.GREEN, "br": Color.YELLOW}
+PATTERN_COLORS = (Color.ORANGE, Color.TEAL, Color.MAROON)
+GEN_ATTEMPTS = 400
