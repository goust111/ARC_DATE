+
+
+def _validate_generated(grid: np.ndarray, expected: np.ndarray) -> bool:
+    try:
+        if grid.ndim != 2 or max(grid.shape) > 30:
+            return False
+        if expected.ndim != 2 or max(expected.shape) > 30:
+            return False
+
+        solved = main(grid)
+        if not np.array_equal(solved, expected):
+            return False
