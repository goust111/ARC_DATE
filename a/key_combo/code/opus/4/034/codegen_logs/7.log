+
+
+def _build_output(panel: np.ndarray, source: np.ndarray, q: int, markers: dict[str, list[tuple[int, int, int]]], rotations: dict[int, int]) -> np.ndarray:
+    out = np.full_like(panel, BG)
+    out[q, :] = CROSS
+    out[:, q] = CROSS
