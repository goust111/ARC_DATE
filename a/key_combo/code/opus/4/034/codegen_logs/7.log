    H, W = canvas.shape
    h, w = patch.shape
    border = int(border)
    padding = int(padding)
    bg = int(transparent)

    if h <= 0 or w <= 0:
        return None
    if H - h + 1 - border <= border or W - w + 1 - border <= border:
        return None

    # Occupancy of the canvas (optionally dilated to enforce padding).
    occ = (canvas != bg)
    if padding > 0:
