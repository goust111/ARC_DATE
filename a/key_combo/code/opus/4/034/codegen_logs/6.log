+    mr0, _mc0, mr1, _mc1 = marked["bbox"]
+    assert pr0 > bars[-1][0] and mr0 > bars[-1][0]
+    assert max(pr0, mr0) <= min(pr1, mr1)
+    assert bbox_w(plain["bbox"]) >= bbox_w(marked["bbox"])
+
