+        if not np.all(sub != BG):
+            continue
+        colors = {int(x) for x in sub.reshape(-1)}
+        if colors <= {BASE_COLOR, MARKER_COLOR} and BASE_COLOR in colors:
+            rects.append({"bbox": bbox, "sub": sub, "colors": colors})
+    rects.sort(key=lambda item: item["bbox"])
+    return rects
