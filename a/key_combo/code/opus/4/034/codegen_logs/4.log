+    if corner == "tl":
+        return lambda r, c: r <= sr and c <= sc
+    if corner == "tr":
+        return lambda r, c: r <= sr and c >= sc
+    if corner == "br":
+        return lambda r, c: r >= sr and c >= sc
+    return lambda r, c: r >= sr and c <= sc
+
