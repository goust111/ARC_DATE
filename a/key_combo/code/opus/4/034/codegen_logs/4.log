+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _band_start(top: int, left: int, corner: str) -> tuple[int, int]:
+    starts = {
+        "tl": (top, left),
+        "tr": (top, left + 1),
+        "br": (top + 1, left + 1),
+        "bl": (top + 1, left),
+    }
+    return starts[corner]
+
