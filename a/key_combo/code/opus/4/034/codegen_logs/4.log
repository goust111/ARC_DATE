+    return {(int(r), int(c)) for r, c in cells if _in_bounds(shape, int(r), int(c))}
+
+
+def _forbidden_single_cells(gray_cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    forbidden = set(gray_cells)
