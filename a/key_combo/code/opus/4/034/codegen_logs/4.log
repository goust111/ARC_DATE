0015: def main(input_grid: np.ndarray) -> np.ndarray:
0016:     """
0017:     Slide each loose pixel until it touches the full bar with the same color, deleting unmatched pixels.
0018: 
0019:     Input structure:
0020:     - The input contains full horizontal or vertical bars and single colored pixels on black.
0021:     - Bars are monochromatic and span the full height or width.
0022:     - Some loose pixels share colors with bars and some may not.
0023: 
0024:     Rule:
0025:     - Copy all bars unchanged to the output.
0026:     - For each loose pixel with a matching-color bar, slide it in a cardinal direction until it contacts that bar.
0027:     - Drop any loose pixel whose color has no corresponding bar.
0028: 
0029:     Key insight:
0030:     - Bar color is the destination label: matching pixels move until first contact with their same-color
0031:       full-line anchor.
0032:     """
0033:     output_grid = np.zeros_like(input_grid)
0034: 
