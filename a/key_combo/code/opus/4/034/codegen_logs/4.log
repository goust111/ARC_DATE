+
+
+def _collect_band(gray_mask: np.ndarray, top: int, left: int, corner: str) -> set[tuple[int, int]]:
+    sr, sc = _band_start(top, left, corner)
+    pred = _corner_predicate(top, left, corner)
+    todo = deque([(sr, sc)])
+    seen: set[tuple[int, int]] = set()
+
+    while todo:
+        r, c = todo.popleft()
+        if (r, c) in seen:
