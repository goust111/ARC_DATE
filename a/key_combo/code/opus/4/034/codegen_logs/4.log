+            if (r, c) in forbidden:
+                continue
+            if r < top and c < left:
+                out["tl"].append((r, c))
+            elif r < top and c > left + 1:
+                out["tr"].append((r, c))
+            elif r > top + 1 and c < left:
+                out["bl"].append((r, c))
+            elif r > top + 1 and c > left + 1:
+                out["br"].append((r, c))
+
+    return out
+
+
+def _build_expected_output(
+    grid: np.ndarray,
+    top: int,
+    left: int,
+    band_cells: dict[str, set[tuple[int, int]]],
+    singles: dict[str, tuple[tuple[int, int], int]],
