+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid, meta = _build_case()
+        try:
+            _validate_case(grid, meta)
+        except AssertionError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid chamber-voting tiling input")

