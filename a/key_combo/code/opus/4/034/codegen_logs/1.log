+
+def _template_mask(template: dict) -> tuple[np.ndarray, tuple[int, int]]:
+    r0, c0, r1, c1 = template["bbox"]
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in template["coords"]:
+        mask[r - r0, c - c0] = True
