+
+    up_left_pad = random.randint(1, 3)
+    up_right_pad = random.randint(1, 3)
+    down_left_pad = random.randint(1, 3)
+    down_right_pad = random.randint(1, 3)
+    left_up_pad = random.randint(1, 3)
+    left_down_pad = random.randint(1, 3)
+    right_up_pad = random.randint(1, 3)
+    right_down_pad = random.randint(1, 3)
+
+    rooms = {
+        "up": (1, max(1, c0 - up_left_pad), r0 - 1, min(width - 2, c0 + tw - 1 + up_right_pad)),
+        "down": (r0 + th, max(1, c0 - down_left_pad), height - 2, min(width - 2, c0 + tw - 1 + down_right_pad)),
+        "left": (max(1, r0 - left_up_pad), 1, min(height - 2, r0 + th - 1 + left_down_pad), c0 - 1),
+        "right": (max(1, r0 - right_up_pad), c0 + tw, min(height - 2, r0 + th - 1 + right_down_pad), width - 2),
