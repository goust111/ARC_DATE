+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    step = bbox_h(template["bbox"]) if direction in ("up", "down") else bbox_w(template["bbox"])
+    dr, dc = DIRS[direction]
+    placements = []
+    k = 1
+    while True:
