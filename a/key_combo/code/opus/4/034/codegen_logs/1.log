+                    sub = grid[r0 : r0 + h, c0 : c0 + w]
+                    area = int((sub == BLACK).sum())
+                    if not 3 <= area <= 5:
+                        continue
+                    coord_set = {
+                        (int(r0 + rr), int(c0 + cc))
+                        for rr, cc in np.argwhere(sub == BLACK)
