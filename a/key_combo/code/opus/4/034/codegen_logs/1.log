+    assert len(candidates) == 1 or candidates[1]["dist2"] > template["dist2"], "template identification is ambiguous"
+    return template
+
+
+def _find_chambers(grid: np.ndarray, template: dict) -> list[dict]:
+    chambers = template.get("chambers")
+    if chambers is None:
