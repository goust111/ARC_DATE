+        counts = Counter(int(grid[r, c]) for r, c in marker_coords)
+        major_color, major_count = counts.most_common(1)[0]
+        tied = [color for color, cnt in counts.items() if cnt == major_count]
+        if len(tied) != 1:
+            return None
+        chambers.append(
