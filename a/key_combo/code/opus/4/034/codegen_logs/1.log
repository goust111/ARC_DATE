+    down_copies = random.randint(min_copies, max_copies)
+    left_copies = random.randint(min_copies, max_copies)
+    right_copies = random.randint(min_copies, max_copies)
+
+    r0 = 1 + up_copies * th
+    c0 = 1 + left_copies * tw
