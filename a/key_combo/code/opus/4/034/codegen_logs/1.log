+            nc = c0 + cc + k * step * dc
+            if not in_bounds(grid.shape, nr, nc):
+                valid = False
+                break
+            if int(grid[nr, nc]) == GREY or int(grid[nr, nc]) in MARKER_COLORS:
+                valid = False
+                break
