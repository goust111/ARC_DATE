+        box = bbox_coords(comp)
+        if bbox_h(box) * bbox_w(box) == area:
+            continue
+        if not _is_wall_adjacent(grid, coord_set):
+            continue
+        center = ((box[0] + box[2]) / 2.0, (box[1] + box[3]) / 2.0)
+        dist2 = (center[0] - (grid.shape[0] - 1) / 2.0) ** 2 + (center[1] - (grid.shape[1] - 1) / 2.0) ** 2
+        candidates.append(
