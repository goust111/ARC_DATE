+            grid[mr, mc] = int(color)
+            occupied_markers.add((mr, mc))
+            marker_records.append((direction, mr, mc, int(color)))
+
+    meta = {
+        "template_coords": template_coords,
+        "rooms": rooms,
+        "majorities": majorities,
+        "placements": placements,
+        "markers": marker_records,
