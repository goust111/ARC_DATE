+
+def _is_connected(coords: set[tuple[int, int]]) -> bool:
+    start = next(iter(coords))
+    seen = {start}
+    stack = [start]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in coords and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return len(seen) == len(coords)
