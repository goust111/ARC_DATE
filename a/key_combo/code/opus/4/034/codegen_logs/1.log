+
+def _direction_from_center(center: tuple[float, float], centroid: tuple[float, float]) -> str:
+    dr = float(centroid[0] - center[0])
+    dc = float(centroid[1] - center[1])
+    if abs(dr) > abs(dc):
+        return "down" if dr > 0 else "up"
+    return "right" if dc > 0 else "left"
