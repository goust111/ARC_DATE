+from arc_utils import bbox_coords, bbox_h, bbox_w, components_mask, in_bounds, neighbors4
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MARKER_COLORS = (BLUE, RED, GREEN, YELLOW)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
