+
+def _transform_coord(coord: tuple[int, int], rotation: int, flip: bool) -> tuple[int, int]:
+    r, c = map(int, coord)
+    if flip:
+        c = -c
+    for _ in range(int(rotation) % 4):
+        r, c = c, -r
+    return int(r), int(c)
+
+
+def _dihedral_variants(
+    skeleton_rel: frozenset[tuple[int, int]],
+    red_rel: frozenset[tuple[int, int]],
+) -> list[dict]:
+    variants = []
+    seen = set()
