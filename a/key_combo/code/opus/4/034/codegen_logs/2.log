+        for rotation in range(4):
+            skel = frozenset(_transform_coord(cell, rotation, flip) for cell in skeleton_rel)
+            reds = frozenset(_transform_coord(cell, rotation, flip) for cell in red_rel)
+            key = tuple(sorted(skel))
+            if key in seen:
+                continue
+            seen.add(key)
+            variants.append(
