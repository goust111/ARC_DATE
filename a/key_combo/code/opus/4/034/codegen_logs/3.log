+        return arr
+    raise RuntimeError("failed to generate a compact sprite")
+
+
+def _sample_unique_shapes() -> list[np.ndarray]:
+    shapes: list[np.ndarray] = []
+    sigs: set[frozenset[tuple[int, int]]] = set()
+    while len(shapes) < 4:
