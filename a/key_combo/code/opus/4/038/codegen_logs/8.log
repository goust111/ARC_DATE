+                RNG.shuffle(between)
+                for j in between:
+                    second_diag = diags[j]
+                    later_fresh = [l for l in range(k + 1, len(candidates)) if diags[l] not in {first_diag, second_diag}]
+                    RNG.shuffle(later_fresh)
+                    for l in later_fresh:
+                        banned = {first_diag, second_diag, diags[l]}
+                        later_repeat_diags = [
