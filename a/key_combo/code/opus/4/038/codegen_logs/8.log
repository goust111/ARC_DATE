+                            for diag, idxs in diag_to_indices.items()
+                            if diag not in banned and sum(idx > l for idx in idxs) >= 2
+                        ]
+                        RNG.shuffle(later_repeat_diags)
+                        for repeat_diag in later_repeat_diags:
