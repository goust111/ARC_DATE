+        markers = [(r1, c0), (r1, c1), (r0, c_mid)]
+    elif mode == COL_LEFT:
+        r_mid = random.randint(r0 + 1, r1 - 1)
+        markers = [(r0, c0), (r1, c0), (r_mid, c1)]
+    elif mode == COL_RIGHT:
