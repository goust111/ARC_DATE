+    elif mode == BOTH_TR:
+        markers = [(r0, c0), (r0, c1), (r1, c1)]
+    elif mode == BOTH_BL:
+        markers = [(r0, c0), (r1, c0), (r1, c1)]
+    elif mode == BOTH_BR:
