+import sys
+
+import numpy as np
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if _ARC_UTILS_DIR.exists() and str(_ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_ARC_UTILS_DIR))
