+    for _ in range(TILE_RETRIES):
+        size = rng.randint(min_size, max_size)
+        mask = _random_connected_mask(period_r, period_c, size, rng)
+        if not (mask[0].any() and mask[-1].any() and mask[:, 0].any() and mask[:, -1].any()):
+            continue
