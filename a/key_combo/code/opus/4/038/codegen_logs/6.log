+
+        for r in range(period_r):
+            if int(tile[r, 0]) == int(tile[r, -1]) != corridor_color:
+                choices = [color for color in other_colors if color != int(tile[r, 0])]
+                tile[r, -1] = rng.choice(choices)
+        for c in range(period_c):
