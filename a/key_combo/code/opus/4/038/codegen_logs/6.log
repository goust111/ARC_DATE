+
+
+def _hole_bounds(cell_count: int) -> tuple[int, int]:
+    hole_min = (15 * cell_count + 99) // 100
+    hole_max = (25 * cell_count) // 100
+    return hole_min, hole_max
+
+
+def _all_phases_visible(grid: np.ndarray, period_r: int, period_c: int) -> bool:
