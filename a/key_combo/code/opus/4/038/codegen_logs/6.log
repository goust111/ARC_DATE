import random
from collections import Counter
import numpy as np
BLACK=0; MAROON=9; POOL=[1,2,4,5,6,7,8]

def neighbors4(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
