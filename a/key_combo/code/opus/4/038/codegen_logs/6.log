    for r in range(h):
        for c in range(w):
            col=int(g[r,c])
            if col in (BLACK,MAROON):
                continue
            key=(r%pr,c%pc)
            prev=seen.get(key)
            if prev is not None and prev!=col:
                return False
            seen[key]=col
    return True

def infer(g):
    h,w=g.shape
    for pr in range(1,h+1):
        for pc in range(1,w+1):
            if consistent(g,pr,pc):
                return pr,pc

def rand_connected_mask(h,w,size):
    start=(random.randrange(h),random.randrange(w))
    cells={start}
    while len(cells)<size:
        r,c=random.choice(tuple(cells))
        nbrs=list(neighbors4(r,c,h,w)); random.shuffle(nbrs)
        for x in nbrs:
            cells.add(x); break
    mask=np.zeros((h,w),dtype=bool)
    for r,c in cells: mask[r,c]=True
    return mask

def gen_tile(pr,pc):
    palette=random.sample(POOL, random.choice([3,4]))
    target=palette[0]; others=palette[1:]
    for _ in range(1000):
        size=random.randint(max(4,min(pr,pc)+1), max(4,(pr*pc)//2))
        mask=rand_connected_mask(pr,pc,size)
        if not (mask[0].any() and mask[-1].any() and mask[:,0].any() and mask[:,-1].any()):
            continue
        tile=np.empty((pr,pc),dtype=int)
        tile[mask]=target
        for r in range(pr):
            for c in range(pc):
                if not mask[r,c]: tile[r,c]=random.choice(others)
        for r in range(pr):
            if tile[r,0]==tile[r,-1] and tile[r,0]!=target:
                opts=[x for x in others if x!=tile[r,0]]
                if opts: tile[r,-1]=random.choice(opts)
        for c in range(pc):
            if tile[0,c]==tile[-1,c] and tile[0,c]!=target:
                opts=[x for x in others if x!=tile[0,c]]
                if opts: tile[-1,c]=random.choice(opts)
        counts=Counter(tile.ravel())
        if min(counts.values())<2:
            continue
        return tile,target

def build():
    pr,pc=random.choice([(3,4),(4,3)])
    rep_r=random.randint(4,7); rep_c=random.randint(4,7)
    h,w=pr*rep_r,pc*rep_c
