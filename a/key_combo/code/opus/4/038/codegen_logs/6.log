+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GENERATION_RETRIES):
+        grid = _generate_candidate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

