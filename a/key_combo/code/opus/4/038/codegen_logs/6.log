            continue
        tile=np.empty((pr,pc),dtype=int)
        tile[mask]=target
        rem=np.argwhere(~mask)
        random.shuffle(rem.tolist() if False else [])
        for r in range(pr):
            for c in range(pc):
                if mask[r,c]:
                    continue
                tile[r,c]=random.choice(others)
        # force non-target seam mismatch
        for r in range(pr):
            if tile[r,0]==tile[r,-1] and tile[r,0]!=target:
                opts=[x for x in others if x!=tile[r,0]]
                tile[r,-1]=random.choice(opts)
        for c in range(pc):
            if tile[0,c]==tile[-1,c] and tile[0,c]!=target:
                opts=[x for x in others if x!=tile[0,c]]
                tile[-1,c]=random.choice(opts)
        if len(set(tile.ravel()))<3:
            continue
        counts=Counter(tile.ravel())
        if min(counts.values())<2:
            continue
        return tile,target


def gen_one():
    pr,pc=random.choice([(3,4),(4,3)])
    rep_r=random.randint(4,7)
    rep_c=random.randint(4,7)
    h,w=pr*rep_r,pc*rep_c
