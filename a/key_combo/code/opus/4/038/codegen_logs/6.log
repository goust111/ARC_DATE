+    return None
+
+
+def _phase_occurrences(height: int, width: int, period_r: int, period_c: int) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    phases: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r in range(height):
+        for c in range(width):
