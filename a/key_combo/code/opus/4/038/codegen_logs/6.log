    marker=(h-1,w-1)
    for _ in range(500):
        protected=set()
        for key,cells in phases.items():
            choices=[p for p in cells if p!=marker]
            protected.add(random.choice(choices))
        protected.add(marker)
        total=h*w-1
        holes=random.randint((15*total+99)//100, (25*total)//100)
        corridor_cells=[p for p in corridor if p not in protected and p!=marker]
        other_cells=[(r,c) for r in range(h) for c in range(w) if (r,c) not in protected and (r,c) not in corridor and (r,c)!=marker]
