        res=make_tile(pr,pc)
        if not res: continue
        tile,target=res
        full=np.tile(tile,(rep_r,rep_c))
        if infer(full)!=(pr,pc):
            continue
        spans=spanning_components(full)
        if len(spans)!=1 or spans[0][0]!=target:
            continue
        return pr,pc,tile,target,full,spans[0][1]
    return None

success=0
