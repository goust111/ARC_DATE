import random
from collections import defaultdict, deque, Counter
import numpy as np

POOL = [1,2,4,5,6,7,8]
BLACK=0
MAROON=9

def neighbors4(r,c,h,w):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def components(grid, color):
    h,w=grid.shape
    seen=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if grid[r,c]"'!=color or seen[r,c]:
                continue
            q=[(r,c)]
            seen[r,c]=True
            comp=[]
            while q:
                rr,cc=q.pop()
                comp.append((rr,cc))
                for nr,nc in neighbors4(rr,cc,h,w):
                    if not seen[nr,nc] and grid[nr,nc]==color:
                        seen[nr,nc]=True
                        q.append((nr,nc))
            out.append(comp)
    return out

def spanning_components(grid):
    h,w=grid.shape
    spans=[]
    for color in sorted(set(map(int, np.unique(grid))) - {BLACK, MAROON}):
        for comp in components(grid,color):
            rows={r for r,_ in comp}; cols={c for _,c in comp}
            if (0 in rows and h-1 in rows) or (0 in cols and w-1 in cols):
                spans.append((color, len(comp)))
    return spans

def consistent(g, pr, pc):
    seen={}
    h,w=g.shape
    for r in range(h):
        for c in range(w):
            col=int(g[r,c])
            if col in (BLACK, MAROON):
                continue
            key=(r%pr,c%pc)
            if key in seen and seen[key]!=col:
                return False
            seen[key]=col
    return True

def infer(g):
    h,w=g.shape
    for pr in range(1,h+1):
        for pc in range(1,w+1):
            if consistent(g,pr,pc):
                return pr,pc

def rand_connected_mask(h,w,size):
    cell=(random.randrange(h), random.randrange(w))
    cells={cell}
    while len(cells)<size:
        r,c=random.choice(tuple(cells))
        nbrs=list(neighbors4(r,c,h,w))
        random.shuffle(nbrs)
        for rr,cc in nbrs:
            cells.add((rr,cc))
            break
    mask=np.zeros((h,w),dtype=bool)
    for r,c in cells:
        mask[r,c]=True
    return mask


def make_tile(pr,pc):
    palette=random.sample(POOL, random.choice([3,4]))
    target=palette[0]
    others=palette[1:]
    for _ in range(500):
        size=random.randint(max(4,(pr*pc)//3), min(pr*pc-3, (pr*pc*2)//3))
        mask=rand_connected_mask(pr,pc,size)
