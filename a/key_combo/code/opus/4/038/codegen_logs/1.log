+        out[r0 + 1 : r0 + 4, c0 + 1 : c0 + 4] = int(spec["side_color"])
+    return out
+
+
+def _wrong_direction_from_specs(grid: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for spec in specs:
+        correct_step = 1 if spec["gap_idx"] in (0, 1) else -1
