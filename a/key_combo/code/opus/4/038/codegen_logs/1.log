    inp[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE] = block

    out = np.full((h, w), bg, dtype=int)
    out[[0, 0, h - 1, h - 1], [0, w - 1, 0, w - 1]] = block.ravel()
    return inp if np.array_equal(main(inp), out) else None


