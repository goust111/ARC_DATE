+    for spec in specs:
+        r0, c0 = spec["origin"]
+        for (dr, dc), color in zip(CORNER_POS, spec["corner_colors"]):
+            grid[r0 + dr, c0 + dc] = int(color)
+        for i, (dr, dc) in enumerate(SIDE_POS):
+            if i != spec["gap_idx"]:
