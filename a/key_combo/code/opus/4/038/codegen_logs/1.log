+    for i, (dr, dc) in enumerate(SIDE_POS):
+        out[r0 + dr, c0 + dc] = 0 if i == gap_idx else int(rotated_sides[i])
+
+    out[r0 + 1 : r0 + 4, c0 + 1 : c0 + 4] = int(side_color)
+
