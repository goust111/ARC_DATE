                    touching_other = any(labels[ar, ac] not in (-1, i) for ar, ac in _gen_neighbors4(nr, nc, h, w))
                    if not touching_other:
                        frontier.append((nr, nc))
            if frontier:
                nr, nc = random.choice(frontier)
                labels[nr, nc] = i
                sizes[i] += 1
                progressed = True
        if not progressed:
            return None

    return labels >= 0


