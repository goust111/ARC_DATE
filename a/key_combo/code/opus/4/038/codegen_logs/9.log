            for w in range(BBOX_SIZE_MIN, BBOX_SIZE_MAX_EXCLUSIVE):
                fill = count / (h * w)
                if not (FILL_RATIO_MIN <= fill <= FILL_RATIO_MAX):
                    continue
                if k == 1:
                    if count >= h + w - 1:
                        options.append((k, h, w))
                elif _gen_seed_sets(h, w, k):
                    options.append((k, h, w))
    return options


