+
+
+def _render_spec(spec: dict) -> np.ndarray:
+    grid = np.zeros((spec["H"], spec["W"]), dtype=int)
+    r0, c0, r1, c1 = spec["rect_bbox"]
+    grid[r0 : r1 + 1, c0 : c1 + 1] = TEAL
+    _place_template(grid, spec["template"], spec["corner"])
