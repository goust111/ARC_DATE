    Returns an array of shape (h*factor, w*factor).
    """
    k = int(factor)
    if k <= 0:
        raise ValueError("scale_sprite: factor must be >= 1")
    return np.kron(sprite, np.ones((k, k), dtype=sprite.dtype))


