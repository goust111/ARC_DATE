    assert h >= 2 and w >= 2

    out = np.full_like(g, bg)
    out[0, 0] = g[r0, c0]
    out[0, w - 1] = g[r0, c1]
    out[h - 1, 0] = g[r1, c0]
    out[h - 1, w - 1] = g[r1, c1]
    return out

