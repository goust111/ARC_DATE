def _cell_ranges(length: int, wall_indices: list[int]) -> list[tuple[int, int]]:
    ranges = []
    start = 0
    for wall in sorted(wall_indices):
        if start <= wall - 1:
            ranges.append((start, wall - 1))
        start = wall + 1
    if start <= length - 1:
        ranges.append((start, length - 1))
    return ranges


