+from __future__ import annotations
+
+import math
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+TRIANGLE_COLORS = (BLUE, RED, GREEN)
+DIRECTIONS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+BASE_LENGTHS = (3, 4)
+HEIGHTS = (3, 4, 5)
+GRID_MIN = 18
+GRID_MAX = 24
+YELLOW_COUNT_RANGE = (4, 8)
+GEN_ATTEMPTS = 600
