+        assert grid[r, c] == BACKGROUND
+        grid[r, c] = int(color)
+
+
+def _expected_from_params(
+    grid: np.ndarray,
+    *,
+    region_count: int,
+    chosen_corners: tuple[str, ...],
+    colors: list[int],
+) -> np.ndarray:
