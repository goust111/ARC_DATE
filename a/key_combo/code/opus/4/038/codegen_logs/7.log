+                inner_h = rng.randint(4, 8)
+                outer_h = inner_h + 2
+                outer_w = sum(segments) + (region_count - 1) + 2
+            else:
+                inner_w = rng.randint(4, 8)
+                outer_w = inner_w + 2
+                outer_h = sum(segments) + (region_count - 1) + 2
+
