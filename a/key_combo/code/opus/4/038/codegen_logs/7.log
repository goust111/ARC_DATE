+            orientation = "none"
+            inner_h = rng.randint(4, 8)
+            inner_w = rng.randint(4, 9)
+            segments = [inner_w]
+            outer_h = inner_h + 2
+            outer_w = inner_w + 2
+        else:
+            orientation = rng.choice(("vertical", "horizontal"))
+            segment_low = 2
+            segment_high = 4 if region_count == 2 else 3
