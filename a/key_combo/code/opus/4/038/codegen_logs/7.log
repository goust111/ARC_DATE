+        divider_c = left + 1
+        for seg in segments[:-1]:
+            divider_c += seg
+            grid[top : bottom + 1, divider_c] = FRAME_COLOR
+            divider_c += 1
+    elif orientation == "horizontal":
+        divider_r = top + 1
+        for seg in segments[:-1]:
