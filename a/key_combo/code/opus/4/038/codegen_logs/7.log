        assert len(set(starts)) == len(starts)
        ordered = sorted(items, key=lambda item: item[0][0])

        out = np.full((sprite_h * len(ordered), sprite_w), bg, dtype=int)
        for i, (_, crop) in enumerate(ordered):
            paste(out, crop, i * sprite_h, 0)

    return out

