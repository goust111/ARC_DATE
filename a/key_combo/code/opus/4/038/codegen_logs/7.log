+        region_count=region_count,
+        chosen_corners=chosen_corners,
+        colors=colors,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_COUNT
+
+    for _ in range(_GEN_RETRIES):
+        rng = random.Random()
+        grid = _generate_single(rng, _GEN_CALL_COUNT)
