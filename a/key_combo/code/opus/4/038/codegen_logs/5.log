+    rect_w = int(_RNG.integers(5, min(11, w - 1)))
+
+    center_r = h // 2
+    center_c = w // 2
+    r0 = _biased_start(h, rect_h, center_r)
+    c0 = _biased_start(w, rect_w, center_c)
