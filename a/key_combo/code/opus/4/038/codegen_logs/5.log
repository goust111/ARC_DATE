+
+def _shape_mask_from_spec(spec: dict, *, ignore_controls: bool = False) -> np.ndarray:
+    h, w = spec["shape"]
+    r0, c0, r1, c1 = spec["bbox"]
+    blocked = {side: set() for side in SIDES} if ignore_controls else _blocked_lines(spec)
