+
+def _blocked_lines(spec: dict) -> dict[str, set[int]]:
+    blocked = {side: set() for side in SIDES}
+    for r, c, side in spec["controls"]:
+        if side in ("top", "bottom"):
+            blocked[side].add(int(c))
+        else:
+            blocked[side].add(int(r))
+    return blocked
