            parsed["sep_cols"],
            parsed["sep_color"],
            parsed["row_tiles"],
            parsed["col_tiles"],
            parsed["offset"],
            col_major,
        ),
    ):
        return False

    marker_pixels = np.argwhere((grid != GREY) & (grid != BLACK))
    if marker_pixels.shape[0] != 6:
        return False

    return True


