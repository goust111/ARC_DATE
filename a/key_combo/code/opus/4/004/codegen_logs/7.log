+def _parse_lattice(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = map(int, g.shape)
+
+    candidates = []
+    for color in np.unique(g):
+        color = int(color)
