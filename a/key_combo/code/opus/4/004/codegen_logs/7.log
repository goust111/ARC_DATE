+def _adjacent(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return abs(int(a[0]) - int(b[0])) + abs(int(a[1]) - int(b[1])) == 1
+
+
+def _segment_tiles(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r1, c1 = map(int, a)
+    r2, c2 = map(int, b)
+    assert (r1, c1) != (r2, c2)
+    if r1 == r2:
