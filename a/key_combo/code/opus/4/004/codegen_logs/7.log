+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+CYCLE = (RED, BLUE, GREEN)
+TILE_GRID_SIZE = 4
+TILE_SIZE = 3
+SEPARATOR_WIDTH = 1
+LOCAL_OFFSETS = tuple((r, c) for r in range(TILE_SIZE) for c in range(TILE_SIZE))
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 300
+
+_RNG = np.random.default_rng()
+_PATH_SPECS = None
