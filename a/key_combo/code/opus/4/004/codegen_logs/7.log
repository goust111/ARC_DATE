+def _runs_between_stops(size: int, stops: list[int]) -> list[list[int]]:
+    runs = []
+    start = 0
+    for stop in sorted(int(x) for x in stops):
+        if start < stop:
+            runs.append(list(range(start, stop)))
+        start = stop + 1
+    if start < size:
+        runs.append(list(range(start, size)))
+    return runs
