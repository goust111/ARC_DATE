            parsed["grid"].shape,
            parsed["sep_rows"],
            parsed["sep_cols"],
            parsed["sep_color"],
            parsed["row_tiles"],
            parsed["col_tiles"],
            parsed["offset"],
            segments,
        ),
    ):
        return False

    row_major = sorted(path)
    col_major = sorted(path, key=lambda tile: (tile[1], tile[0]))
    if np.array_equal(
        out,
        _cycle_grid(
            parsed["grid"].shape,
            parsed["sep_rows"],
            parsed["sep_cols"],
            parsed["sep_color"],
            parsed["row_tiles"],
            parsed["col_tiles"],
            parsed["offset"],
            row_major,
        ),
    ):
        return False
