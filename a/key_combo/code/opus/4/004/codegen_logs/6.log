+
+def _downscale(sprite: np.ndarray, row_runs: list[tuple[int, ...]], col_runs: list[tuple[int, ...]]) -> np.ndarray:
+    compact = np.zeros((len(row_runs), len(col_runs)), dtype=int)
+    for i, rows in enumerate(row_runs):
