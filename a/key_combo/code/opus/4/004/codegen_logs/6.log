+        dominant_count = int(rng.choice([4, 5]))
+        cells = [dominant] * dominant_count
+        others = [color for color in FG_COLORS if color != dominant]
+        cells.extend(int(rng.choice(others)) for _ in range(9 - dominant_count))
+        rng.shuffle(cells)
