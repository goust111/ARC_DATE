+        "top_mirror": top_mirror,
+        "bottom_mirror": bottom_mirror,
+        "top_color": top_color,
+        "bottom_color": bottom_color,
+        "cell_size": cell_size,
+        "matched_rows_top": [bool(np.array_equal(top_left[r], top_right[r, ::-1])) for r in range(QUAD_CELLS)],
