+        top_left = compact[:QUAD_CELLS, :QUAD_CELLS]
+        top_right = compact[:QUAD_CELLS, QUAD_CELLS:]
+        bottom_left = compact[QUAD_CELLS:, :QUAD_CELLS]
+        bottom_right = compact[QUAD_CELLS:, QUAD_CELLS:]
