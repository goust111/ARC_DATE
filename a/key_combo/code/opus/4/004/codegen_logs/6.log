+    for start_row in (0, QUAD_CELLS):
+        left = compact[start_row : start_row + QUAD_CELLS, :QUAD_CELLS]
+        right = compact[start_row : start_row + QUAD_CELLS, QUAD_CELLS:]
+        if not _is_horizontal_mirror(left, right):
+            continue
