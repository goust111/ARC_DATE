+
+
+def _render_sprite(compact: np.ndarray, cell_size: int) -> tuple[np.ndarray, list[tuple[int, ...]], list[tuple[int, ...]], list[int], list[int]]:
+    row_runs: list[tuple[int, ...]] = []
