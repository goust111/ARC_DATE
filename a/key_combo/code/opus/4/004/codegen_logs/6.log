+
+    pos = 0
+    for idx in range(GRID_CELLS):
+        col_runs.append(tuple(range(pos, pos + cell_size)))
+        pos += cell_size
+        if idx < GRID_CELLS - 1:
+            width = 2 if idx == QUAD_CELLS - 1 else 1
+            sep_cols.extend(range(pos, pos + width))
+            pos += width
