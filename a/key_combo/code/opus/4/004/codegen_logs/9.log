    for cand in candidates:
        if _period_key(cand["period"]) < _period_key(period) and cand["loss"] <= MAX_REPAIRS:
            return False

    out = main(inp)
    if not np.array_equal(out, np.fliplr(clean)):
        return False
    if np.array_equal(out, np.fliplr(inp)):
        return False
    if np.array_equal(out, clean):
