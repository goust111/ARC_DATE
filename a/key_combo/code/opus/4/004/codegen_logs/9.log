    return g


def _validate_case(inp: np.ndarray, clean: np.ndarray, period: tuple[int, int]) -> bool:
    if inp.ndim != 2 or clean.ndim != 2 or inp.shape != clean.shape:
        return False
    if max(inp.shape) > 30:
