+    shape = plan["shape"]
+    notch_set = set(plan["notches"].values())
+    r, c = plan["notches"][side]
+    filled = {(r, c)}
+
+    if side in ("left", "right"):
+        for step in (-1, 1):
+            rr = r + step
+            while shape["hr0"] <= rr <= shape["hr1"]:
+                if (rr, c) in notch_set:
+                    break
+                filled.add((rr, c))
+                rr += step
+    else:
+        for step in (-1, 1):
+            cc = c + step
+            while shape["vc0"] <= cc <= shape["vc1"]:
