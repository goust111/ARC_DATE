+    if height - top_margin - bottom_margin < thickness + 4:
+        return None
+
+    c0 = left_margin
+    c1 = width - 1 - right_margin
+    r0 = top_margin
+    r1 = height - 1 - bottom_margin
+
+    vc0_lo = c0 + 1
+    vc0_hi = c1 - thickness
+    hr0_lo = r0 + 1
+    hr0_hi = r1 - thickness
