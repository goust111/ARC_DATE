+
+def _trace_control(
+    grid: np.ndarray,
+    footprint: np.ndarray,
+    notches: set[tuple[int, int]],
+    row_bounds: dict[int, tuple[int, int]],
+    col_bounds: dict[int, tuple[int, int]],
