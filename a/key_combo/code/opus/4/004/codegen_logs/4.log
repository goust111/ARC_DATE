+    horizontal_rows_rel = np.flatnonzero(row_counts > sub.shape[1] // 2)
+    vertical_cols_rel = np.flatnonzero(col_counts > sub.shape[0] // 2)
+    assert _contiguous(horizontal_rows_rel)
+    assert _contiguous(vertical_cols_rel)
