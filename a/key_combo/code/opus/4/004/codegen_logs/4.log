+def _fill_chain(
+    out: np.ndarray,
+    footprint: np.ndarray,
+    notches: set[tuple[int, int]],
+    notch: tuple[int, int],
+    color: int,
+    incident_axis: str,
+) -> None:
+    r, c = notch
+    out[r, c] = int(color)
+    directions = [(-1, 0), (1, 0)] if incident_axis == "horizontal" else [(0, -1), (0, 1)]
+
+    for dr, dc in directions:
+        rr, cc = r + dr, c + dc
+        while 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1] and footprint[rr, cc]:
+            if (rr, cc) in notches:
