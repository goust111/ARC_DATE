+def _validate_plan(plan: dict) -> bool:
+    shape = plan["shape"]
+    height = shape["height"]
+    width = shape["width"]
+    if max(height, width) > 30:
+        return False
+
+    notches = plan["notches"]
+    controls = plan["controls"]
