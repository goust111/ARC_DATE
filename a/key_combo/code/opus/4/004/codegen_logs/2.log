+def _analyze(grid: np.ndarray) -> tuple[list[dict], dict[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    components = _find_foreground_components(g, bg=BG)
+    assert len(components) == 4
