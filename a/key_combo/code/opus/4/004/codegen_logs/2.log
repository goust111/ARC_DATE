+            try:
+                if _validate_candidate(grid):
+                    return grid
+            except AssertionError:
+                continue
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
