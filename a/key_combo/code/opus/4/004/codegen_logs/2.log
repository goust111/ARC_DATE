+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) == bg:
+                continue
+            queue = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while queue:
+                rr, cc = queue.pop()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) != bg:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
