+def _search_plan(shapes: list[dict]) -> list[dict]:
+    overlaps = {
+        (i, j): _shape_overlap(shapes[i], shapes[j])
+        for i in range(len(shapes))
+        for j in range(len(shapes))
+        if i != j
+    }
+    plans = []
+
+    pairings = [((0, 1), (2, 3)), ((0, 2), (1, 3)), ((0, 3), (1, 2))]
+    for pair_a, pair_b in pairings:
