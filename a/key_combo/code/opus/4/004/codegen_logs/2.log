+    for idx, (shape, (r0, c0)) in enumerate(zip(shapes, placements)):
+        grid[r0 : r0 + shape["mask"].shape[0], c0 : c0 + shape["mask"].shape[1]][shape["mask"]] = shape["body_color"]
