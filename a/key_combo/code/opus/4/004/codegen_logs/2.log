+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in arr:
+        mask[int(r) - r0, int(c) - c0] = True
+    return mask
+
+
+def _find_foreground_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
