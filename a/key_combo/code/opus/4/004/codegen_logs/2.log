+    sprites: list[dict] = []
+    for idx, comp in enumerate(components):
+        bbox = comp["bbox"]
+        crop = crop_bbox(g, bbox)
+        colors = {int(g[r, c]) for r, c in comp["coords"]}
+        marker_set = tuple(sorted(color for color in marker_colors if color in colors))
