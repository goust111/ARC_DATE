+def _extract_quadrant_data(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    n, m = g.shape
+    assert n == m and n % 2 == 1
+    center = n // 2
+    assert np.all(g[center, :] == SEP)
+    assert np.all(g[:, center] == SEP)
