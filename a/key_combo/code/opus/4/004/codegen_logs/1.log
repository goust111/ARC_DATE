+        tile[rr, cc] = color
+        seen[rr, cc] = True
+
+    if not seen.all():
+        return None
+
+    full = _render_from_tile(tile, (height, width))
+    if np.any((observed != BLACK) & (observed != full)):
+        return None
+
+    min_pr, min_pc = _minimal_periods(full)
+    if (min_pr, min_pc) != (pr, pc):
+        return None
+
+    return {"pr": int(pr), "pc": int(pc), "tile": tile, "full": full}
