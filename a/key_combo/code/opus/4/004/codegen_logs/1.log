+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+TEAL = 8
+
+RNG = np.random.default_rng()
+MAX_ATTEMPTS = 600
+
+
+def _extract_stacked(grid: np.ndarray) -> np.ndarray:
+    rows = []
+    widths = set()
