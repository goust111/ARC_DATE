+    for r, c in np.argwhere(mask):
+        counts[int(r) % pr, int(c) % pc] += 1
+    return counts
+
+
+def _sample_observation(full: np.ndarray, pr: int, pc: int) -> np.ndarray | None:
+    height, width = full.shape
+    by_class: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for rr in range(pr):
+        for cc in range(pc):
