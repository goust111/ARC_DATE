+    for pr in range(1, height + 1):
+        if np.array_equal(full, full[row_ids % pr]):
+            break
+    for pc in range(1, width + 1):
+        if np.array_equal(full, full[:, col_ids % pc]):
+            break
+    return int(pr), int(pc)
+
+
