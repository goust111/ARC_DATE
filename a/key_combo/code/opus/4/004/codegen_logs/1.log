+            min_load = min(row_load[r] for r, _ in positions)
+            options = [(r, c) for r, c in positions if row_load[r] == min_load]
+            r, c = options[int(RNG.integers(len(options)))]
+            mask[r, c] = True
+            row_load[r] += 1
