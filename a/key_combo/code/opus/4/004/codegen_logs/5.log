+        by_diag[c - r].append((r, c))
+
+    tracks: list[list[tuple[int, int]]] = []
+    for cells in by_diag.values():
+        cells.sort()
+        run = [cells[0]]
+        for r, c in cells[1:]:
+            pr, pc = run[-1]
+            if r == pr + 1 and c == pc + 1:
