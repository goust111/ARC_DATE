+def _oracle_output(grid: np.ndarray) -> np.ndarray:
+    """Independent stepwise oracle used by the generator and semantic self-checks."""
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    for track in _extract_tracks(g):
+        info = _pair_info(g, track)
+        if info is None:
+            continue
