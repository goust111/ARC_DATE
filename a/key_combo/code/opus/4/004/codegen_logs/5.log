+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+PAIR_COLORS = (BLUE, RED, GREEN)
+
+MIN_TRACK_LEN = 7
+MAX_TRACKS = 6
+MAX_OCCUPIED_TRACKS = 4
