+    return candidates[0]
+
+
+def _read_legend(edge: np.ndarray, bg: int) -> tuple[int, list[int]]:
+    edge = np.asarray(edge, dtype=int)
+    nz = np.flatnonzero(edge != int(bg))
+    assert nz.size > 0, "legend column must contain non-background markers"
+
+    start = int(nz[0])
+    pos = start
+    run_len = 0
