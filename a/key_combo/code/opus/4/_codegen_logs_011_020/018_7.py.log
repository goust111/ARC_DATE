+    if int(get_bg(grid)) != int(BG):
+        return None
+    if np.count_nonzero(grid[:, :-1] == int(DEFECT)) != 1:
+        return None
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
