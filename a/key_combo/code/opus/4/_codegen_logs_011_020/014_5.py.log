+        return False
+    if not set(map(int, np.unique(g))) <= set(Color.ALLOWED):
+        return False
+
+    teal_comps = components_mask(g == Color.TEAL, connectivity=4)
+    if len(teal_comps) != 1:
+        return False
+    teal = teal_comps[0]
+    if not 8 <= len(teal) <= 15:
