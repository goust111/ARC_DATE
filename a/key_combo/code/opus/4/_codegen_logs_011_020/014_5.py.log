+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    ORANGE = 7
+    TEAL = 8
+
+    MARKERS = (BLUE, RED, GREEN, YELLOW, ORANGE)
+    ALLOWED = (BLACK, BLUE, RED, GREEN, YELLOW, GREY, ORANGE, TEAL)
+
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 400
