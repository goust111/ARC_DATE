+    markers = _extract_markers(g)
+    if not 1 <= len(markers) <= 3:
+        return False
+    if len({color for _, _, color in markers}) != len(markers):
+        return False
+    if any((r in (0, g.shape[0] - 1)) and (c in (0, g.shape[1] - 1)) for r, c, _ in markers):
+        return False
