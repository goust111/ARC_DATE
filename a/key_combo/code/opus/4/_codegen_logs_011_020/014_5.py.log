+        results.append(
+            {
+                "marker": (r, c, color),
+                "landing": landing,
+                "status": status,
+                "path": path,
+            }
+        )
+    return results
+
+
+def _valid_input(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
