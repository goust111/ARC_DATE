+    inner_w = int(spec["outer_w"]) - 2
+    seed_r, seed_c = map(int, spec["seed"])
+    up = seed_r
+    down = inner_h - seed_r - 1
+    left = seed_c
+    right = inner_w - seed_c - 1
+    return any((up == left, up == right, down == left, down == right))
