+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 6 or h > 8 or w < 6 or w > 8:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    shifted = coords - np.array([r0, c0], dtype=int)
+    local[shifted[:, 0], shifted[:, 1]] = True
+    return np.array_equal(local, _border_mask(h, w))
