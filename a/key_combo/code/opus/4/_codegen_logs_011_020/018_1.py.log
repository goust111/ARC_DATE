+            0 <= r0 < r1 < grid.shape[0]
+            and 0 <= c0 < c1 < grid.shape[1]
+        ):
+            return False
+        for other in specs[i + 1 :]:
+            if not _boxes_separate(bbox, other["bbox"]):
