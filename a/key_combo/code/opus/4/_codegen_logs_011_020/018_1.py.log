+SEED_COLORS = (Color.PINK, Color.ORANGE)
+
+TIE_OUTER_SHAPES = [(6, 7), (6, 8), (7, 6), (7, 8), (8, 6), (8, 7)]
+NO_TIE_OUTER_SHAPES = [(8, 8)]
