+def _make_frame_spec(require_tie: bool) -> dict:
+    shapes = TIE_OUTER_SHAPES if require_tie else NO_TIE_OUTER_SHAPES
+    outer_h, outer_w = random.choice(shapes)
+    inner_h = outer_h - 2
