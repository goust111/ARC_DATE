+        bottom_len = _sample_segment_len(grid.shape[0] - (cross1 + 1))
+        grid[cross0 - top_len : cross0, axis_pos] = Color.BLACK
+        grid[cross1 + 1 : cross1 + 1 + bottom_len, axis_pos] = Color.BLACK
+        return
