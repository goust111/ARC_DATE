+        cross0, cross1 = sr0, sr1
+    else:
+        cross0, cross1 = sc0, sc1
+
+    for idx, axis_pos in enumerate(gates):
+        _paint_gate_opening(out, orientation, cross0, cross1, axis_pos, GATE_CYCLE[idx % 3])
+
+    return out
