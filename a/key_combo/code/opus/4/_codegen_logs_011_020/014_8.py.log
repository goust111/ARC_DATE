+def _build_layout(branch: tuple[str, int, int]) -> dict | None:
+    orientation, direction, gate_count = branch
+    rect_h, rect_w = random.choice(RECT_SHAPES)
+    bg = random.choice(BACKGROUND_CHOICES)
+
+    if orientation == "horizontal":
+        move_len = rect_w
+        cross_len = rect_h
+    else:
