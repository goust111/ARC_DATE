+def _next_branch() -> tuple[str, int, int]:
+    global _GEN_CALL_COUNT
+    if _GEN_CALL_COUNT < len(BRANCH_PROGRAM):
+        branch = BRANCH_PROGRAM[_GEN_CALL_COUNT]
+    else:
+        branch = (
