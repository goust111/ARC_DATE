+def _can_place(coords: set[Coord], existing_boxes: list[BBox], h: int, w: int) -> bool:
+    if not coords:
+        return False
+    for r, c in coords:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+    box = _coords_bbox(coords)
+    return all(_boxes_separated(box, other) for other in existing_boxes)
