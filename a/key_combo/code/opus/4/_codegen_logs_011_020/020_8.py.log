+        bg=bg,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    scored = []
+    for comp in comps:
+        coords = comp["coords"]
+        comp = dict(comp)
+        comp["score"] = int(diff[coords[:, 0], coords[:, 1]].sum())
+        scored.append(comp)
