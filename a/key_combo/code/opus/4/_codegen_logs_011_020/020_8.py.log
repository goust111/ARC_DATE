+    winner_area = int(winner["area"])
+    winner_score = int(winner["score"])
+    if mode == "far_winner":
+        assert winner_score == winner_area
+        assert any(area > winner_area for area in areas if area != winner_area)
+    else:
+        assert winner_score < winner_area
+
+    return True
