+    comps = _solver_components_with_scores(grid)
+    assert 3 <= len(comps) <= 5
+
+    colors = [int(comp["color"]) for comp in comps]
+    assert len(set(colors)) == len(colors)
+    assert set(colors).issubset(set(PALETTE))
