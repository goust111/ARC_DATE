+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
+def _boxes_separated(a: BBox, b: BBox, gap: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
