+def _place_far(
+    existing_boxes: list[BBox],
+    h: int,
+    w: int,
+    area: int,
+    side: str,
+    rng: np.random.Generator,
+) -> dict | None:
+    for _ in range(MAX_PLACE_ATTEMPTS):
+        local = _make_connected_local(
+            area,
+            rng,
+            depth_range=range(2, 5),
+            width_range=range(2, 6),
+            seed_bottom=False,
