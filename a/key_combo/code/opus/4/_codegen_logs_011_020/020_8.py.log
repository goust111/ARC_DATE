+        box_h, box_w = _bbox_dims(box)
+        assert box_h >= 2 and box_w >= 2
+        crop = crop_bbox(grid, box)
+        allowed = {0, int(comp["color"])}
+        assert set(map(int, crop.flatten())).issubset(allowed)
