+
+def _solve(grid: np.ndarray) -> np.ndarray:
+    recolored, _source_bbox, _hidden = _apply_color_transfer(grid)
+    cut, controls = _draw_rays(recolored)
+    keep = _keep_partition_mask(cut, controls)
