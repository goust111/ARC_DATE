+            controls = [(0 if edge == "top" else height - 1, cut_c, edge)]
+            return {
+                "n_ctrl": 1,
+                "vertical_edge": edge,
+                "vertical_col": cut_c,
+                "horizontal_edge": None,
+                "horizontal_row": None,
