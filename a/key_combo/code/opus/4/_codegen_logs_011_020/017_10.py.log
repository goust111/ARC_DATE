+
+def _apply_color_transfer(
+    grid: np.ndarray,
+) -> tuple[np.ndarray, tuple[int, int, int, int], list[tuple[int, int, int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    frame_color, source_bbox = _find_source_frame(g)
+    r0, c0, r1, c1 = source_bbox
