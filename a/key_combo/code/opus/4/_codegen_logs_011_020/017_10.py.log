+    if config["n_ctrl"] == 2:
+        if not any(not _frame_has_green(out, bbox) for bbox in hidden_boxes):
+            return False
+
+    if cross_frame and not any(_frame_has_grey(out, bbox) for bbox in [source_bbox, *hidden_boxes]):
+        return False
