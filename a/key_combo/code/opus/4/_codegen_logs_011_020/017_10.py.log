+
+    keep_row = "TOP" if config["vertical_edge"] == "top" else "BOTTOM"
+    keep_col = "LEFT" if config["horizontal_edge"] == "left" else "RIGHT"
+    options = [f"VCROSS_{keep_row}", f"HCROSS_{keep_col}"]
+    random.shuffle(options)
