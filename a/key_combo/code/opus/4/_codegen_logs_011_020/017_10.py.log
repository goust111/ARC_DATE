+def _frame_has_green(out: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = bbox
+    return bool(np.any(out[r0 : r1 + 1, c0 : c1 + 1] == SRC))
+
+
+def _frame_has_grey(out: np.ndarray, bbox: tuple[int, int, int, int]) -> bool:
