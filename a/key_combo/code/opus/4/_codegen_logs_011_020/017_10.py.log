+    hidden: list[tuple[int, int, int, int]] = []
+    for r0 in range(grid.shape[0] - int(height) + 1):
+        for c0 in range(grid.shape[1] - int(width) + 1):
+            bbox = (int(r0), int(c0), int(r0 + height - 1), int(c0 + width - 1))
+            if bbox == source_bbox:
