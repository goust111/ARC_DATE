+    for comp in components_mask(passable, connectivity=4):
+        edges: set[str] = set()
+        if bool(np.any(comp[:, 0] == 0)):
+            edges.add("top")
+        if bool(np.any(comp[:, 0] == H - 1)):
+            edges.add("bottom")
+        if bool(np.any(comp[:, 1] == 0)):
+            edges.add("left")
+        if bool(np.any(comp[:, 1] == W - 1)):
+            edges.add("right")
+        if edges & control_edges:
+            keep[comp[:, 0], comp[:, 1]] = True
