+    kept, dropped = _kept_and_dropped_categories(config)
+    if n_windows == 2:
+        return [(_source_cross_category(config) if cross_frame else kept), dropped]
+    return [(_source_cross_category(config) if cross_frame else kept), dropped, kept]
