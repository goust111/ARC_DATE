+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(15, 19)
+    width = random.randint(15, 19)
+    frame_h = random.randint(4, 6)
+    frame_w = random.randint(4, 6)
+    n_hidden = random.choice([1, 2])
+    cross_frame = bool(random.random() < 0.55)
