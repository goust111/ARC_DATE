+
+        if not _place_blockers(grid, frame_h, frame_w, boxes, config["controls"]):
+            continue
+
+        out = _solve(grid)
+        if not _semantic_checks(grid, out, source_bbox, hidden_boxes, config, cross_frame):
+            continue
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
