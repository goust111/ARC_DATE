+from arc_utils import Color, bbox_coords, components_mask
+
+
+BG = int(Color.BLACK)
+SRC = int(Color.GREEN)
+CTRL = int(Color.RED)
+RAY = int(Color.GREY)
+BLOCK = int(Color.TEAL)
+
+GEN_ATTEMPTS = 400
