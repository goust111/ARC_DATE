+
+def _draw_rays(grid: np.ndarray) -> tuple[np.ndarray, list[tuple[int, int, str]]]:
+    g = np.asarray(grid, dtype=int).copy()
+    H, W = map(int, g.shape)
+    controls = _control_points(g)
+
+    for r, c, edge in controls:
+        if edge == "top":
+            for rr in range(1, H):
+                if int(g[rr, c]) != CTRL:
+                    g[rr, c] = RAY
+        elif edge == "bottom":
+            for rr in range(0, H - 1):
+                if int(g[rr, c]) != CTRL:
+                    g[rr, c] = RAY
+        elif edge == "left":
+            for cc in range(1, W):
+                if int(g[r, cc]) != CTRL:
+                    g[r, cc] = RAY
+        else:
+            for cc in range(0, W - 1):
+                if int(g[r, cc]) != CTRL:
+                    g[r, cc] = RAY
