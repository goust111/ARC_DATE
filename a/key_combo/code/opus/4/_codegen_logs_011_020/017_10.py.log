+def _boxes_separate(
+    a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1
+) -> bool:
+    return (
+        a[2] + int(pad) < b[0]
+        or b[2] + int(pad) < a[0]
+        or a[3] + int(pad) < b[1]
+        or b[3] + int(pad) < a[1]
+    )
