def _gen_camouflage_target(
    inp: np.ndarray,
    base: np.ndarray,
    target: _GenBox,
    border: np.ndarray,
    noise_colors: _GenNoiseColors,
    rng: np.random.Generator,
) -> None:
    tr0, tc0, tr1, tc1 = target
    target_input = inp[tr0 : tr1 + 1, tc0 : tc1 + 1]
    target_base = base[tr0 : tr1 + 1, tc0 : tc1 + 1]
