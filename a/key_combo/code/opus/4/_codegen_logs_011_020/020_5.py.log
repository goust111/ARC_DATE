+    assert g.ndim == 2
+    assert g.shape[0] % 2 == 0 and g.shape[0] > 0
+
+    half = g.shape[0] // 2
+    upper = g[:half, :]
+    lower = g[half:, :]
+
+    assert set(map(int, np.unique(upper))) <= {Color.BLACK, Color.GREEN}
+    assert set(map(int, np.unique(lower))) <= {Color.BLACK, Color.ORANGE}
+
+    return _solve_from_halves(upper, lower)
+
