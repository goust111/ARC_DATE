    cuts = np.sort(rng.choice(THREE_COLOR_CUT_POSITIONS, size=THREE_COLOR_CUT_COUNT, replace=False))
    counts = [int(cuts[0]), int(cuts[1] - cuts[0]), int(BLOCK_CELL_COUNT - cuts[1])]
    rng.shuffle(counts)
    return counts


