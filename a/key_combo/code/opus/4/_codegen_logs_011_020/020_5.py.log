def _dash_cell(pos: int, n: int) -> bool:
    """True if position `pos` gets a separator pip in the dashed pattern for tile size `n`."""
    k = pos % (n + 1)
    return k == n or k % 2 == 0


def _sep_count(length: int, n: int) -> int:
    """Count how many separator pips appear in a span of `length` cells."""
    return sum(1 for x in range(length) if _dash_cell(x, n))


def _raw_col(tile_col: int, local_c: int, n: int) -> int:
    """Map (tile column index, local column) to absolute grid column."""
    return tile_col * (n + 1) + local_c


def _sample_template(n: int, color: int) -> np.ndarray:
    """Generate a random NxN boolean template mask via random_sprite."""
    sprite = random_sprite(
        n, n,
        density=random.uniform(*_DENSITY_RANGE),
        symmetry=random.choice(_SYMMETRY_OPTIONS),
        color_palette=[color],
        connectivity=_TEMPLATE_CONNECTIVITY,
        background=_BG,
    )
    return sprite == color


def _build_expected(n: int, templates: list[np.ndarray], pcols: list[int],
                    placements: list[tuple[int, int, int]]) -> np.ndarray:
    """Render the expected output grid from stamp placements."""
    expected = np.full((n * n, n * n), _BG, dtype=int)
    for j, rr, cc in placements:
        tile = np.where(templates[j], pcols[j], _BG)
        paste(expected, tile, rr * n, cc * n)
    return expected


def _draw_separators(grid: np.ndarray, n: int, k: int, core_h: int, core_w: int) -> None:
    """Draw dashed horizontal and vertical separator lines in-place."""
    for r in (n, 2 * n + 1):
        for c in range(core_w):
            if _dash_cell(c, n):
                grid[r, c] = _SEP
    for i in range(k - 1):
        c = n + i * (n + 1)
        for r in range(core_h):
            if _dash_cell(r, n):
                grid[r, c] = _SEP


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(*_N_RANGE)
    k = random.randint(*_K_RANGE)
    tcols = random.sample(_AVAILABLE_COLORS, k)
    pcols = random.sample(_AVAILABLE_COLORS, k)

    # Grid dimensions with optional bg padding
    pal_h = random.choices(_PAL_H_CHOICES, weights=_PAL_H_WEIGHTS)[0]
    core_h = 2 * n + 2 + pal_h
    core_w = k * n + (k - 1)
    max_rpad = max(0, min(_MAX_ROW_PAD, 2 * _sep_count(core_h, n) + 1 - core_h))
    max_cpad = max(0, min(_MAX_COL_PAD, 2 * _sep_count(core_w, n) + 1 - core_w))
    h = core_h + random.randint(0, max_rpad)
    w = core_w + random.randint(0, max_cpad)

    templates = [_sample_template(n, col) for col in tcols]

    # Assign random slots to templates for marker placement
    all_slots = [(rr, cc) for rr in range(n) for cc in range(n)]
    random.shuffle(all_slots)
    min_marks = int(np.ceil(_MIN_SLOT_COVERAGE * n * n))
    mark_count = random.randint(min_marks, n * n)
    used_slots = all_slots[:mark_count]
    assign_pool = (list(range(k)) * ((mark_count + k - 1) // k))[:mark_count]
    random.shuffle(assign_pool)
    placements = [(j, rr, cc) for (rr, cc), j in zip(used_slots, assign_pool)]

    expected = _build_expected(n, templates, pcols, placements)

    # Assemble input grid
    grid = np.full((h, w), _BG, dtype=int)
    _draw_separators(grid, n, k, core_h, core_w)

    # Top band: templates
    for j, mask in enumerate(templates):
        paste(grid, np.where(mask, tcols[j], _BG), 0, j * (n + 1))

    # Middle band: markers (shuffled tile-column assignment)
    tile_assign = list(range(k))
    random.shuffle(tile_assign)
    for j, rr, cc in placements:
        grid[n + 1 + rr, _raw_col(tile_assign[j], cc, n)] = tcols[j]

    # Bottom band: palette swatches
    swatch_r = 2 * n + 2 + pal_h - 1
    for j, col in enumerate(pcols):
        start = j * (n + 1)
        size = 2 if random.random() < _SWATCH_DOUBLE_PROB else 1
        c0 = start + max(0, (n - size) // 2)
        grid[swatch_r, c0:c0 + size] = col

    # Oracle check
    try:
        if np.array_equal(main(grid), expected):
            return grid
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(_MAX_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 65b59efc input")
import numpy as np

from arc_utils import Color, crop_bbox, find_components
import random


def _glyphs(g: np.ndarray) -> list[int | None]:
    comps = find_components(g, bg=Color.BLACK, colors=[Color.RED], connectivity=4)
    comps = sorted(comps, key=lambda comp: comp["bbox"][1])

    glyphs: list[int | None] = []
    for comp in comps:
        r0, _c0, r1, _c1 = comp["bbox"]
        assert (r0, r1) == (0, 1)

        mask = crop_bbox(g == Color.RED, comp["bbox"])
        assert mask.shape[0] == 2
        assert mask.shape[1] in (1, 2)

        top_cols = np.flatnonzero(mask[0])
        bottom_cols = np.flatnonzero(mask[1])
        assert len(top_cols) == 1
        assert len(bottom_cols) in (1, 2)

        entry = int(top_cols[0])
        bottom = [int(c) for c in bottom_cols]
        assert entry in bottom

        if len(bottom) == 1:
            glyphs.append(None)
            continue

        exit_cols = [c for c in bottom if c != entry]
        assert len(exit_cols) == 1
        step = exit_cols[0] - entry
        assert abs(step) == 1
        glyphs.append(step)

    assert glyphs
    return glyphs


def main(grid: np.ndarray) -> np.ndarray:
    """Decode the two-row red glyph strip into a downward red trace starting from a centered green marker.

    Input structure
    - The input is a black 2-row strip containing 4-connected red glyphs, read left to right.
    - Each glyph spans both rows and has exactly one top red entry cell; its bottom row is either the same cell only or a two-cell elbow.
    Rule
    - Make a black output whose width is one more than half the input width and whose height is one marker row plus one row for each elbow and two rows for each vertical glyph.
    - Put a green marker in the center of the top row, then trace the glyphs downward: a vertical glyph paints two red cells in the current column; an elbow paints the two bottom cells as a horizontal red segment and moves the current column left or right.
    Key insight
    - The missing top cell of each 2x2 elbow tells whether the trace exits left or right; the glyphs are pipe instructions rather than shapes to copy literally.
    """
    g = np.asarray(grid, dtype=int)
    assert g.shape[0] == 2
    assert g.shape[1] % 2 == 0
    assert set(map(int, np.unique(g))) == {Color.BLACK, Color.RED}

    glyphs = _glyphs(g)
    out_h = 1 + sum(2 if step is None else 1 for step in glyphs)
    out_w = g.shape[1] // 2 + 1
    out = np.full((out_h, out_w), Color.BLACK, dtype=int)

    r = 0
    c = out_w // 2
    out[r, c] = Color.GREEN
    r += 1

    for step in glyphs:
        if step is None:
            assert r + 1 < out_h
            out[r : r + 2, c] = Color.RED
            r += 2
        else:
            next_c = c + step
            assert 0 <= next_c < out_w
            out[r, c] = Color.RED
            out[r, next_c] = Color.RED
            r += 1
            c = next_c

    assert r == out_h
    return out

# --------------- generator (o5x) ---------------
# Glyph sequence, canvas, and retry configuration.
GEN_GLYPH_COUNT = 5
GEN_NUM_VERTICAL = 2
GEN_STEP_CHOICES = (-1, 1)
GEN_INPUT_ROWS = 2
GEN_INPUT_WIDTH = 3 * GEN_GLYPH_COUNT - GEN_NUM_VERTICAL - 1
GEN_OUTPUT_WIDTH = GEN_INPUT_WIDTH // 2 + 1
GEN_RETRY_LIMIT = 300


def _sample_steps() -> list[int | None] | None:
    """Sample glyph instructions and reject paths that leave the output."""
    col = GEN_OUTPUT_WIDTH // 2
    vertical_positions = set(random.sample(range(GEN_GLYPH_COUNT), GEN_NUM_VERTICAL))
    steps: list[int | None] = []

    for pos in range(GEN_GLYPH_COUNT):
        if pos in vertical_positions:
            steps.append(None)
            continue

        choices = list(GEN_STEP_CHOICES)
        random.shuffle(choices)
        valid = [step for step in choices if 0 <= col + step < GEN_OUTPUT_WIDTH]
        if not valid:
            return None
        step = random.choice(valid)
        steps.append(step)
        col += step
    return steps


def _encode_input(steps: list[int | None]) -> np.ndarray:
    """Encode sampled instructions into the two-row glyph strip."""
    grid = np.full((GEN_INPUT_ROWS, GEN_INPUT_WIDTH), Color.BLACK, dtype=int)
    c = 0
    for step in steps:
        if step is None:
            grid[:, c] = Color.RED
            c += 1
        else:
            top_offset = 0 if step == 1 else 1
            grid[0, c + top_offset] = Color.RED
            grid[1, c : c + 2] = Color.RED
            c += 2
        if c < GEN_INPUT_WIDTH:
            c += 1
    return grid


def _render_expected(steps: list[int | None]) -> np.ndarray:
    """Render the decoded output used to validate the generated strip."""
    out_h = 1 + sum(2 if step is None else 1 for step in steps)
    expected = np.full((out_h, GEN_OUTPUT_WIDTH), Color.BLACK, dtype=int)
    r = 0
    col = GEN_OUTPUT_WIDTH // 2
    expected[r, col] = Color.GREEN
    r += 1
    for step in steps:
        if step is None:
            expected[r : r + 2, col] = Color.RED
            r += 2
        else:
            expected[r, col] = Color.RED
            expected[r, col + step] = Color.RED
            col += step
            r += 1
    return expected


def _gen_attempt() -> np.ndarray | None:
    steps = _sample_steps()
    if steps is None:
        return None
    grid = _encode_input(steps)
    return grid if np.array_equal(main(grid), _render_expected(steps)) else None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        if (grid := _gen_attempt()) is not None:
            return grid
    raise RuntimeError("failed to generate valid input")

