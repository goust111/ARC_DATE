+    H = random.randint(max(GRID_MIN, h + 2), max(GRID_MIN, min(GRID_MAX, h + 6)))
+    W = random.randint(max(GRID_MIN, w + 2), max(GRID_MIN, min(GRID_MAX, w + 6)))
