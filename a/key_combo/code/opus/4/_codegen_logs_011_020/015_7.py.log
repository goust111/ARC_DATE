+        seed_count = min(len(core), random.choice([1, 2]))
+        for coord in random.sample(core, k=seed_count):
+            cells.add(coord)
+
+        while len(cells) < total:
+            frontier = {
+                (r + dr, c + dc)
+                for r, c in cells
