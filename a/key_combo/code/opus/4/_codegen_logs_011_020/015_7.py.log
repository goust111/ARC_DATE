+    pair_count = 0
+    shared_coords: set[tuple[int, int]] = set()
+    for i in range(len(shapes)):
+        for j in range(i + 1, len(shapes)):
+            overlap = shapes[i] & shapes[j]
+            if overlap:
+                pair_count += 1
+                shared_coords |= overlap
+    return pair_count, shared_coords
+
+
