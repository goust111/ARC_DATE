+        if len(cells) != total:
+            continue
+        if not _is_connected(cells):
+            continue
+        r0, c0, r1, c1 = _shape_bbox(cells)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 3 or w < 3 or h % 2 == 0 or w % 2 == 0:
+            continue
+        if h > 7 or w > 7:
