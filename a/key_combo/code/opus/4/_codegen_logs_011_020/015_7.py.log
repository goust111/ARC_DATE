+
+
+def _shape_to_patch(color_cells: set[tuple[int, int]], color: int) -> np.ndarray:
+    cells = set(color_cells) | {(0, 0)}
+    r0, c0, r1, c1 = _shape_bbox(cells)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    for r, c in color_cells:
