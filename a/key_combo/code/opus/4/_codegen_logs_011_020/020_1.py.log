+
+def _shape_area(shape: tuple[tuple[int, ...], ...]) -> int:
+    return sum(sum(row) for row in shape)
+
+
+def _shape_width(shape: tuple[tuple[int, ...], ...]) -> int:
+    return len(shape[0])
