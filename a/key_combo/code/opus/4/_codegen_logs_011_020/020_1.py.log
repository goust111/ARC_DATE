+        instructions = [(int(_shape_area(shape)), int(color)) for shape, color in zip(shapes, colors)]
+        glyphs = [_shape_to_grid(shape, color) for shape, color in zip(shapes, colors)]
+        return glyphs, instructions, strip_width
