+def _shape_to_mask(shape: Shape) -> tuple[tuple[int, ...], ...]:
+    rows = max(r for r, _c in shape) + 1
+    cols = max(c for _r, c in shape) + 1
+    mask = np.zeros((rows, cols), dtype=int)
+    for r, c in shape:
