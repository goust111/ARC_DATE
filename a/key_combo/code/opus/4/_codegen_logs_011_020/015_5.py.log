+def _expanded_cells(cells: tuple[Coord, ...] | list[Coord], shape: tuple[int, int], pad: int = 1) -> set[Coord]:
+    height, width = shape
+    out: set[Coord] = set()
+    for r, c in cells:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width:
+                    out.add((rr, cc))
+    return out
