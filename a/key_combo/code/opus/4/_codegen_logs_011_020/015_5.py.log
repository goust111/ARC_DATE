+    for _ in range(rotation % 4):
+        mask = np.rot90(mask)
+    if flip_h:
+        mask = np.fliplr(mask)
+    if flip_v:
+        mask = np.flipud(mask)
+    return tuple(map(tuple, np.argwhere(mask > 0)))
