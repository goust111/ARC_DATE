+    ((0, 0), (0, 2), (1, 0), (1, 1), (1, 2)),
+    ((0, 0), (0, 1), (0, 2), (1, 0), (1, 2)),
+    ((0, 0), (0, 1), (1, 1), (2, 1), (2, 2)),
+    ((0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)),
+    ((0, 0), (1, 0), (2, 0), (0, 1), (1, 1), (2, 1)),
+)
+
+GRID_SIDE_RANGE = (16, 23)
+MAX_GENERATION_ATTEMPTS = 400
+MIN_MARKER_PATH = 1
