+    height, width = grid.shape
+    r, c = start
+    dr, dc = direction
+    path: list[Coord] = []
+    r += dr
+    c += dc
+    while 0 <= r < height and 0 <= c < width:
+        color = int(grid[r, c])
+        if color == Color.BLACK:
+            path.append((r, c))
+            r += dr
+            c += dc
+            continue
+        if color == Color.BLUE:
+            return blue_by_cell[(r, c)], tuple(path), (r, c)
+        return None
+    return None
