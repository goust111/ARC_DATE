        (area, height)
        for height in range(1, _GEN_MAX_HEIGHT + 1)
        for area in range(1, _GEN_MAX_AREA + 1)
        if height <= area
        and area + height <= _GEN_GRID_SIZE - 1
        and area <= height * span_width
