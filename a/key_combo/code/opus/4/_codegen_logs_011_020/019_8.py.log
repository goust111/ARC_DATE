+from __future__ import annotations
+
+from dataclasses import dataclass
+from itertools import permutations
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 2
+YELLOW = 4
+GREY = 5
+BAR_COLORS = (1, 3, 6, 7)
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_SIDE_RANGE = (12, 16)
+BAR_COUNT_CHOICES = (3, 4)
+EDGE_MARGIN = 2
+MIN_BAND_GAP = 1
+MARKER_COUNT_CHOICES = (2, 2, 3)
+GEN_ATTEMPTS = 400
