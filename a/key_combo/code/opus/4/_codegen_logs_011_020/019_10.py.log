+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+SYMBOL_COLORS = [2, 3, 6, 7, 8]
+BORDER_COORDS = (
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 0),
+    (1, 2),
+    (2, 0),
+    (2, 1),
+    (2, 2),
+)
+PARTITIONS = [(3, 3), (2, 2, 2), (2, 2, 3), (2, 3, 3)]
+SIZE_CHOICES = [19, 23, 27]
+SIDES = ["top", "right", "bottom", "left"]
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid == int(color)
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc):
+                    if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(cells, dtype=int))
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = {tuple(map(int, coords[0]))}
+    stack = [tuple(map(int, coords[0]))]
+    points = {tuple(map(int, rc)) for rc in coords}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors8(r, c):
+            if (nr, nc) in points and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
