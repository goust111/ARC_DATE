    return regions


def _paint_rectangular_connectors(g: np.ndarray, bg: int, markers: dict[int, list[BBox]]) -> dict[tuple[int, int], int]:
    planned: dict[tuple[int, int], int] = {}

    for color, boxes in markers.items():
