+        r0 = int(spec["block_r0"])
+        c0 = int(spec["block_c0"])
+        half_h = int(spec["full_h"]) // 2
+        grid[r0 : r0 + half_h, c0 : c0 + int(spec["w"])] = int(spec["color"])
