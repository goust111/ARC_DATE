+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _attempt_input()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for mirrored punch-and-pack ARC task")

