+        row_min = 1 if height - mh >= 2 else 0
+        row_max = height - mh - 1 if height - mh >= 2 else height - mh
+        col_min = right_region_c0
+        col_max = width - mw - 1 if width - mw >= 2 else width - mw
+        candidates = []
+        for r in range(row_min, row_max + 1):
