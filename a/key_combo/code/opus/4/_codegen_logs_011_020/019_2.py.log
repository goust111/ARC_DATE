+def _attempt_input() -> np.ndarray | None:
+    specs = _choose_specs()
+    height, width, right_region_c0 = _assign_block_positions(specs)
+    if max(height, width) > 30:
+        return None
+    if not _place_motifs(specs, height, width, right_region_c0):
