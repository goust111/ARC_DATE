+        full_tile = _complete_half_block(g, block)
+        carved_tiles.append(_carve_centered(full_tile, motifs_by_color[color], bg))
+    return _pack_tiles(carved_tiles, bg)
+
+
+def _expected_output(specs: list[dict]) -> np.ndarray:
+    tiles = []
+    for spec in specs:
