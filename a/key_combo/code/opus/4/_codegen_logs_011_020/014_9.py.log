+    for r, c in occlusions:
+        inp[r, c] = BLACK
+    for (r, c), color in distractor_assignment:
+        inp[r, c] = color
+
+    if not _semantic_checks(inp, full, distractor_assignment, (row_period, col_period)):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
