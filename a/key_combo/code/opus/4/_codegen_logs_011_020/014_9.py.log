+    right = grid[r0 + dr : r1 + dr, c0 + dc : c1 + dc]
+    both_visible = (left != BLACK) & (right != BLACK)
+    support = int(np.sum(both_visible))
+    if support == 0:
+        return 0, 0
+    conflicts = int(np.count_nonzero(left[both_visible] != right[both_visible]))
+    return support, conflicts
