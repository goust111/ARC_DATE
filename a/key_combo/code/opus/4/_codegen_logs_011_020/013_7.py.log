15:def main(input_grid):
16:    """
17:    Count divider-defined regions and output a solid grid with those region dimensions.
18:
19:    Input structure:
20:    - The input has a non-black background crossed by full-row and full-column bars of another color.
21:    - Bars divide the canvas into rectangular regions.
22:    - The background color is the dominant non-bar color.
23:
24:    Rule:
25:    - Identify the bar color from a full row or full column.
26:    - Count bar columns and rows to infer the number of regions left-to-right and top-to-bottom.
27:    - Return a solid grid of background color with shape `(region_rows, region_columns)`.
28:
29:    Key insight:
30:    - The answer abstracts away bar positions and sizes; only the number of partitions in each
31:      direction matters.
32:    """
33:    # Plan:
34:    # 1. Find the color of the background and the bars
35:    # 2. Count the number of regions going left-to-right
36:    # 3. Count the number of regions going top-to-bottom
37:
38:    H, W = input_grid.shape
39:
40:    # Bar color = color of any full row/col stripe.
41:    bar_color = None
42:    for r in range(H):
43:        if np.all(input_grid[r, :] == input_grid[r, 0]):
44:            bar_color = int(input_grid[r, 0])
45:            break
46:    if bar_color is None:
47:        for c in range(W):
48:            if np.all(input_grid[:, c] == input_grid[0, c]):
49:                bar_color = int(input_grid[0, c])
50:                break
51:    assert bar_color is not None
52:
53:    # Background = most common non-bar color.
54:    vals = input_grid.flatten().astype(int)
55:    non_bar = vals[vals != bar_color]
56:    background = int(np.bincount(non_bar).argmax())
57:
58:    # Count vertical bar columns and horizontal bar rows.
59:    n_bar_cols = sum(1 for c in range(W) if input_grid[0, c] == bar_color)
60:    n_bar_rows = sum(1 for r in range(H) if input_grid[r, 0] == bar_color)
61:
62:    n_regions_lr = n_bar_cols + 1
63:    n_regions_tb = n_bar_rows + 1
64:
65:    # Output is (n_regions_tb, n_regions_lr), filled with background color.
66:    return np.full((n_regions_tb, n_regions_lr), background, dtype=int)
