+    max_comp_h = max(bar_h + 2 * count - 1 for bar_h, count in zip(bar_heights, counts))
+
+    free_h = 30 - (lattice_h + max_comp_h)
+    if free_h < 0:
+        return None
+    top = random.randint(0, min(2, free_h))
+    free_h -= top
+    gap = random.randint(0, min(1, free_h))
