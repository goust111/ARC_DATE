6:def main(grid: np.ndarray) -> np.ndarray:
7:    """
8:    Scale up a monochrome control sprite by stamping a polychrome tile at each filled pixel.
9:
10:    Input structure:
11:    - bg = background color.
12:    - Two foreground objects (8-connected): a monochrome rectangular sprite with bg holes (control), and a polychrome square tile (block).
13:
14:    Rule:
15:    - For each cell in the control sprite's bbox: if filled, stamp a copy of the block tile; if bg, leave a tile-sized bg region.
16:    - Output grid dimensions are (control_h × tile_h) by (control_w × tile_w).
17:
18:    Key insight: The control sprite acts as a binary mask that gets "pixel-scaled" by the tile — each pixel expands to a full tile copy or empty space.
19:    """
20:    g = np.array(grid, dtype=int)
21:    bg = int(get_bg(g))
22:
23:    # Find multicolor connected components of the foreground as a whole.
24:    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
25:    assert not (len(comps) != 2)
26:
27:    infos = []
28:    for comp in comps:
29:        patch = crop_bbox(g, comp["bbox"])
30:        cols = colors_present(patch, exclude={bg})
31:        infos.append({"bbox": comp["bbox"], "patch": patch, "cols": cols})
32:
33:    # Building block is the component with >=2 colors (or more unique colors), preferring square.
34:    infos.sort(
35:        key=lambda d: (
36:            len(d["cols"]) >= 2,
37:            len(d["cols"]),
38:            int(d["patch"].shape[0]) == int(d["patch"].shape[1]),
39:        ),
40:        reverse=True,
41:    )
42:    block = infos[0]["patch"]
43:    ctrl = infos[1]["patch"]
44:
45:    bh, bw = map(int, block.shape)
46:    ch, cw = map(int, ctrl.shape)
47:
48:    ctrl_cols = colors_present(ctrl, exclude={bg})
49:    if not ctrl_cols:
50:        return np.full((0, 0), int(bg), dtype=int)
51:
52:    ctrl_col = int(ctrl_cols[0])
53:    mask = (ctrl == int(ctrl_col))
54:
55:    out = np.full((ch * bh, cw * bw), int(bg), dtype=int)
56:    for r in range(ch):
57:        for c in range(cw):
58:            if bool(mask[r, c]):
59:                paste(out, block, r * bh, c * bw)
60:    return out
