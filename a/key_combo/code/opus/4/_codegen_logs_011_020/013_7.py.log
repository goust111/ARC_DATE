6:def main(grid: np.ndarray) -> np.ndarray:
7:    """
8:    Compress the colored pixels on a 5x5 X into the corresponding 3x3 square outline.
9:
10:    Input structure
11:    - The input is a 5x5 grid with a dominant background color.
12:    - Every non-background pixel lies on one of the two diagonals, forming an X.
13:    - All diagonal positions are colored foreground pixels.
14:
15:    Rule
16:    - Keep the center pixel at the center of the 3x3 output.
17:    - Project the northwest diagonal arm onto the top edge from left to center.
18:    - Project the northeast arm onto the right edge from top to center.
19:    - Project the southwest arm onto the left edge from center to bottom.
20:    - Project the southeast arm onto the bottom edge from center to right.
21:
22:    Key insight
23:    - The output is not a crop; it is the same X-shaped set of nine colored pixels
24:      folded into the perimeter and center of a 3x3 grid.
25:    """
26:    g = np.asarray(grid, dtype=int)
27:    assert g.ndim == 2, "expected a 2D grid"
28:    assert g.shape == (5, 5), "expected a 5x5 grid"
29:
30:    bg = get_bg(g)
31:    x_mask = np.zeros(g.shape, dtype=bool)
32:    for i in range(5):
33:        x_mask[i, i] = True
34:        x_mask[i, 4 - i] = True
35:
36:    assert np.all(g[~x_mask] == bg), "expected only background off the X"
37:    assert np.all(g[x_mask] != bg), "expected all X positions to be foreground"
38:
39:    out = np.full((3, 3), -1, dtype=int)
40:    center = 2
41:    for r, c in np.argwhere(x_mask):
42:        r = int(r)
43:        c = int(c)
44:        if r == center and c == center:
45:            rr, cc = 1, 1
46:        elif r < center and c < center:
47:            rr, cc = 0, r
48:        elif r < center and c > center:
49:            rr, cc = r, 2
50:        elif r > center and c < center:
51:            rr, cc = r - center, 0
52:        elif r > center and c > center:
53:            rr, cc = 2, c - center
54:        else:
55:            raise AssertionError("unexpected X position")
56:        out[rr, cc] = g[r, c]
57:
58:    assert np.all(out >= 0), "expected every output cell to be filled"
59:    return out
