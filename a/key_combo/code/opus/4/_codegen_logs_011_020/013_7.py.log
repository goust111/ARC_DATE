64:def _dihedral_orbits(size: int) -> list[tuple[list[tuple[int, int]], bool]]:
65:    seen: set[tuple[int, int]] = set()
66:    out: list[tuple[list[tuple[int, int]], bool]] = []
67:    s = int(size)
68:    for r in range(s):
69:        for c in range(s):
70:            if (r, c) in seen:
71:                continue
72:            orbit = {
73:                (r, c),
74:                (c, s - 1 - r),
75:                (s - 1 - r, s - 1 - c),
76:                (s - 1 - c, r),
77:                (r, s - 1 - c),
78:                (s - 1 - r, c),
79:                (c, r),
80:                (s - 1 - c, s - 1 - r),
81:            }
82:            cells = sorted(orbit)
83:            seen.update(cells)
84:            border = any(rr in (0, s - 1) or cc in (0, s - 1) for rr, cc in cells)
85:            out.append((cells, border))
86:    return out
