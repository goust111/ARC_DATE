                    seen[nr,nc]=True
                    st.append((nr,nc))
    return n

def strip(tile, copies):
    blocks=[]
    flip=np.fliplr(tile)
    for i in range(copies):
        blocks.append(tile if i%2==0 else flip)
    return np.concatenate(blocks,axis=1)

def make2(h,w):
    g=np.zeros((h,w),int)
    k=random.randint(1,w-2)
    if random.choice([0,1]):
        g[0,:k+1]=1; g[1,k:]=1
    else:
        g[1,:k+1]=1; g[0,k:]=1
    g[h-1,:]=1
    return g

def make4(h,w):
    g=np.zeros((h,w),int)
    g[0,:]=1
    length=random.randint(2,w-2)
    if random.choice([0,1]):
        g[h-1,:length]=1
    else:
        g[h-1,w-length:]=1
    return g

def make5(w):
    g=np.zeros((5,w),int)
    g[0,:]=1; g[2,:]=1
    length=random.randint(2,w-2)
    if random.choice([0,1]):
        g[4,:length]=1
    else:
        g[4,w-length:]=1
    return g

def make6(h,w):
    g=np.zeros((h,w),int)
    top=0; bot=h-1
    l1=random.randint(2,w-2); l2=random.randint(2,w-2)
    if random.choice([0,1]):
        g[top,:l1]=1; g[bot,w-l2:]=1
    else:
        g[top,w-l1:]=1; g[bot,:l2]=1
    return g

for name, maker in [('2', lambda: make2(random.choice([4,5]), random.randint(4,6))), ('4', lambda: make4(random.randint(3,5), random.randint(4,6))), ('5', lambda: make5(random.randint(4,6))), ('6', lambda: make6(random.choice([3,5]), random.randint(4,6)) )]:
