+def _candidate_move_masks(mask: np.ndarray) -> list[np.ndarray]:
+    candidates: list[np.ndarray] = []
+    for removed in _candidate_remove_masks(mask):
+        for r, c in _frontier_cells(removed):
+            if removed[r, c]:
