+
+def _corner_positions(height: int, width: int, h: int, w: int) -> list[Coord]:
+    return [(0, 0), (0, width - w), (height - h, 0), (height - h, width - w)]
+
+
+def _random_position(blocked: np.ndarray, h: int, w: int) -> Coord | None:
