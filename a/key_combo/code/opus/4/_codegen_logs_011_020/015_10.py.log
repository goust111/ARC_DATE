+        base = np.fliplr(mask) if reflect else mask
+        for turns in range(4):
+            candidate = np.rot90(base, turns)
+            key = _mask_key(candidate)
+            if key not in seen:
+                seen.add(key)
+                variants.append(np.asarray(candidate, dtype=bool))
+    return variants
