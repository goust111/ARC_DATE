+
+def _candidate_remove_masks(mask: np.ndarray) -> list[np.ndarray]:
+    candidates: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        trial = mask.copy()
+        trial[int(r), int(c)] = False
+        if int(trial.sum()) < TARGET_AREA_RANGE[0]:
+            continue
