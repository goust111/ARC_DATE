+    matched = []
+    unmatched = []
+    for coords in components_mask(grid == MATCH_COLOR, connectivity=4):
+        mask, bbox = _coords_to_mask(coords)
+        info = (coords, bbox, mask)
+        if _mask_key(mask) in variant_keys:
+            matched.append(info)
+        else:
+            unmatched.append(info)
