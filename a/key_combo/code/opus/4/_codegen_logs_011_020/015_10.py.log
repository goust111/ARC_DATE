+
+def _frontier_cells(mask: np.ndarray) -> list[Coord]:
+    h, w = mask.shape
+    cells: list[Coord] = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c]:
+                continue
+            for nr, nc in neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                    cells.append((r, c))
+                    break
