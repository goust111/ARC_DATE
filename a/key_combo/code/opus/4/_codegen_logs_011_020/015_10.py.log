+    assert queue, "nonempty object must have a boundary"
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and depth[nr, nc] == -1:
+                depth[nr, nc] = depth[r, c] + 1
+                queue.append((nr, nc))
+
+    return depth
+
