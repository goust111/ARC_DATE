+def _mask_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    coords = np.argwhere(mask)
+    assert len(coords) > 0
+    b = bbox_coords(coords)
+    cropped = crop_bbox(mask.astype(int), b)
+    return tuple(tuple(int(v) for v in row) for row in cropped)
