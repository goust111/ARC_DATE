+        if pos is None:
+            return None
+        cells = _place_patch(grid, patch, pos[0], pos[1])
+        _reserve(blocked, pos[0], pos[1], patch.shape[0], patch.shape[1])
+        distractor_specs.append((distractor_mask.copy(), pos))
