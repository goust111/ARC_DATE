+
+
+def _generate_template_mask() -> np.ndarray:
+    for _ in range(200):
+        target_area = random.randint(*TARGET_AREA_RANGE)
+        mask = CORE_MASK.copy()
+        while int(mask.sum()) < target_area:
+            frontier = _frontier_cells(mask)
+            if not frontier:
+                break
+            rr, cc = random.choice(frontier)
+            mask[rr, cc] = True
