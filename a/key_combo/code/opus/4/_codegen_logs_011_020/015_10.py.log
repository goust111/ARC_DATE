+BG = Color.BLACK
+MATCH_COLOR = Color.GREEN
+KEEP_COLOR = Color.TEAL
+ODD_COLOR = Color.RED
+EVEN_COLOR = Color.YELLOW
+NOISE_COLOR = Color.MAROON
