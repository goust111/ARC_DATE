+    h = int(horizontal_mask.sum())
+    v = int(vertical_mask.sum())
+    if h <= 0 or v <= 0:
+        raise ValueError("missing ruler")
+    if int(grey.sum()) != h + v:
+        raise ValueError("unexpected grey pixels")
