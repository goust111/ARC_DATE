+    top_margin = int(rng.integers(1, 4))
+    left_margin = int(rng.integers(1, 4))
+    bottom_margin = int(rng.integers(1, 4))
+    right_margin = int(rng.integers(1, 4))
+
+    r0 = top_margin + axis_r
+    c0 = left_margin + axis_c
