+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+PATTERN_COLORS = (BLUE, RED, YELLOW, PINK)
+GEN_RETRIES = 500
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _local_orbit(
+    r: int,
+    c: int,
+    height: int,
+    width: int,
+    axis_r: int,
+    axis_c: int,
+) -> tuple[tuple[int, int], ...]:
+    rows = {int(r)}
+    cols = {int(c)}
+
+    rr = 2 * int(axis_r) - int(r)
+    cc = 2 * int(axis_c) - int(c)
+    if 0 <= rr < height:
+        rows.add(int(rr))
+    if 0 <= cc < width:
+        cols.add(int(cc))
+
+    orbit = {(rr0, cc0) for rr0 in rows for cc0 in cols}
+    return tuple(sorted(orbit))
+
+
+def _iter_local_orbits(
+    height: int,
+    width: int,
+    axis_r: int,
+    axis_c: int,
+) -> Iterable[tuple[tuple[int, int], ...]]:
+    seen = np.zeros((height, width), dtype=bool)
+    for r in range(height):
+        for c in range(width):
+            if seen[r, c]:
+                continue
+            orbit = _local_orbit(r, c, height, width, axis_r, axis_c)
+            for rr, cc in orbit:
+                seen[rr, cc] = True
+            yield orbit
+
+
+def _solve_pattern(pattern: np.ndarray, axis_r: int, axis_c: int) -> np.ndarray:
+    out = np.array(pattern, dtype=int, copy=True)
+    height, width = map(int, out.shape)
