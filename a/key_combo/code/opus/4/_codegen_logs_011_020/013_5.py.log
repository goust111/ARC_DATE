+    orbits = list(_iter_local_orbits(height, width, axis_r, axis_c))
+    size2 = [orbit for orbit in orbits if len(orbit) == 2]
+    size4 = [orbit for orbit in orbits if len(orbit) == 4]
+    fillable = [orbit for orbit in orbits if len(orbit) >= 2]
