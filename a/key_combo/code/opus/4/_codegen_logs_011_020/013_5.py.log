+def _local_orbit(
+    r: int,
+    c: int,
+    height: int,
+    width: int,
+    axis_r: int,
+    axis_c: int,
+) -> tuple[tuple[int, int], ...]:
+    rows = {int(r)}
+    cols = {int(c)}
+
+    rr = 2 * int(axis_r) - int(r)
+    cc = 2 * int(axis_c) - int(c)
+    if 0 <= rr < height:
+        rows.add(int(rr))
+    if 0 <= cc < width:
+        cols.add(int(cc))
+
+    orbit = {(rr0, cc0) for rr0 in rows for cc0 in cols}
+    return tuple(sorted(orbit))
+
