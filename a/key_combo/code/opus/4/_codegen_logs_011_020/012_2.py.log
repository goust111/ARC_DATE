from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import Counter
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/4/012/2.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

BG, RED, GREEN, BLUE = 5, 2, 3, 1


def parse_markers(grid):
    pts = np.argwhere(grid "'!= BG)
    assert 2 <= len(pts) <= 3
    markers = [(int(r), int(c), int(grid[r, c])) for r, c in pts]
    rows = [r for r, _, _ in markers]
    cols = [c for _, c, _ in markers]
    colors = [color for _, _, color in markers]
    assert len(set(rows)) == len(rows)
    assert len(set(cols)) == len(cols)
    assert len(set(colors)) == len(colors)
    assert RED not in colors
    return markers


def segments(dividers, size):
    out = []
    prev = -1
    for d in sorted(dividers):
        start = prev + 1
        end = d - 1
        assert end >= start
        out.append((start, end, end - start + 1))
        prev = d
    start = prev + 1
    end = size - 1
    assert end >= start
    out.append((start, end, end - start + 1))
    return out


def classify(grid):
    markers = parse_markers(grid)
    row_parts = segments([r for r, _, _ in markers], grid.shape[0])
    col_parts = segments([c for _, c, _ in markers], grid.shape[1])
    areas = [rh * cw for _, _, rh in row_parts for _, _, cw in col_parts]
    lo, hi = min(areas), max(areas)
    if lo == hi:
        return '"'all_equal'
    if areas.count(lo) > 1 or areas.count(hi) > 1:
        return 'tied_extremes'
    return 'unique_extremes'


def verify_case(inp, out):
    markers = parse_markers(inp)
    H, W = inp.shape
    row_parts = segments([r for r, _, _ in markers], H)
    col_parts = segments([c for _, c, _ in markers], W)
    areas = [rh * cw for _, _, rh in row_parts for _, _, cw in col_parts]
    lo, hi = min(areas), max(areas)
    marker_rows = {r for r, _, _ in markers}
    marker_cols = {c for _, c, _ in markers}

    for r, c, color in markers:
        for cc in range(W):
            exp = color if cc == c or cc not in marker_cols else RED
            assert int(out[r, cc]) == exp
        for rr in range(H):
            exp = color if rr == r or rr not in marker_rows else RED
            assert int(out[rr, c]) == exp

    for rs, re, rh in row_parts:
        for cs, ce, cw in col_parts:
            patch = out[rs:re + 1, cs:ce + 1]
            area = rh * cw
            if lo == hi:
                exp = BG
            elif area == lo:
                exp = GREEN
            elif area == hi:
                exp = BLUE
            else:
                exp = BG
            assert np.all(patch == exp)

branch_counts = Counter()
marker_counts = Counter()
for _ in range(18):
    inp = mod.generate_input()
    out = mod.main(inp)
    verify_case(inp, out)
    branch_counts[classify(inp)] += 1
    marker_counts[int(np.count_nonzero(inp "'!= BG))] += 1

print('"'branches', dict(branch_counts))
print('marker_counts', dict(marker_counts))
assert set(branch_counts) == {'unique_extremes', 'tied_extremes', 'all_equal'}
assert set(marker_counts) == {2, 3}
