+CROSS_COLOR = int(Color.RED)
+MIN_FILL_COLOR = int(Color.GREEN)
+MAX_FILL_COLOR = int(Color.BLUE)
+MARKER_PALETTE = (
+    int(Color.YELLOW),
+    int(Color.PINK),
+    int(Color.ORANGE),
+    int(Color.TEAL),
+    int(Color.MAROON),
+)
