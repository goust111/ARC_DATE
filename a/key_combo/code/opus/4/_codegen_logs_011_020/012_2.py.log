+def _segments_to_dividers(segments: list[int]) -> list[int]:
+    acc = 0
+    dividers: list[int] = []
+    for length in segments[:-1]:
+        acc += int(length)
+        dividers.append(acc)
+        acc += 1
+    return dividers
