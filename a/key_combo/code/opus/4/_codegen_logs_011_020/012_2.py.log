+        return out
+
+    min_area = int(summary["min_area"])
+    max_area = int(summary["max_area"])
+    for r0, r1, height in row_segments:
+        for c0, c1, width in col_segments:
+            area = int(height) * int(width)
+            if area == min_area:
+                out[r0 : r1 + 1, c0 : c1 + 1] = MIN_FILL_COLOR
+            elif area == max_area:
