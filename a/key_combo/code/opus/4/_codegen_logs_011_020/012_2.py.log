+
+    for r, c, color in markers:
+        out[r, :] = int(color)
+        out[:, c] = int(color)
+
+    for i, (row_i, _col_i, _color_i) in enumerate(markers):
+        for j, (_row_j, col_j, _color_j) in enumerate(markers):
+            if i != j:
+                out[row_i, col_j] = CROSS_COLOR
+
+    for r, c, color in markers:
+        out[r, c] = int(color)
