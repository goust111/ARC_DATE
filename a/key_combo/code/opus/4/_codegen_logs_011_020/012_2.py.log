            if rec(pos + 1):
                return True
            placed[i] = None
        return False

    if not rec(0):
        return None
    return [p for p in placed if p is not None]


def _render_pair(placed: list[dict[str, int | _BBox]], n: int) -> tuple[np.ndarray, np.ndarray]:
    out = np.full((n, n), _BG, dtype=int)
