+_BG = 0
+_DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+_AREA_MIN = 5
+_AREA_MAX = 30
+_OUTER_MAX_DIM = 16
+_GEN_ATTEMPTS = 600
+_SHAPE_ATTEMPTS = 80
+_BBOX_ATTEMPTS = 80
+_GRID_H_RANGE = (13, 22)
+_GRID_W_RANGE = (13, 22)
+_LAYER_COUNTS = (3, 4)
+_INNER_DIMS = (3, 4, 5, 6)
