+def _border_cells(mask: np.ndarray, side: str) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    if side == "top":
+        return [(0, c) for c in range(w) if mask[0, c]]
+    if side == "bottom":
+        return [(h - 1, c) for c in range(w) if mask[h - 1, c]]
+    if side == "left":
