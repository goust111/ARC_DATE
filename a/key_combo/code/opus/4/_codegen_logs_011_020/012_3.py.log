+
+
+def _expected_output(shape: tuple[int, int], inner_box: tuple[int, int, int, int], colors: list[int]) -> np.ndarray:
+    center_r, center_c = _bbox_center(inner_box)
+    ring_colors = np.array(list(reversed(colors)), dtype=int)
