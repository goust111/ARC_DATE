+    view = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if np.any(view[mask] != _BG):
+        return False
+    view[mask] = int(color)
+    return True
+
+
+def _shapes_are_separated(grid: np.ndarray) -> bool:
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == _BG:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w:
+                    other = int(grid[nr, nc])
+                    if other != _BG and other != color:
+                        return False
