        if total <= per_max * n_distractor_colors
        and fg_min <= dominant_pixels + total <= fg_max
        and frac_min <= dominant_pixels / (dominant_pixels + total) <= frac_max
    ]
    assert distractor_totals, "expected feasible distractor total"
