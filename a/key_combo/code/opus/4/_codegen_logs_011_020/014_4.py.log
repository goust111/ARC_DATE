+    for segment_id, (direction, length) in enumerate(zip(dirs, lengths)):
+        for _ in range(length):
+            current = (current[0] + direction[0], current[1] + direction[1])
+            path.append(current)
+            segment_ids.append(segment_id)
+        if segment_id + 1 < len(dirs):
