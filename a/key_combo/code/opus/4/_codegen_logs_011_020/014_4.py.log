+        grid[r, c] = TEAL
+    grid[start] = GREEN
+    grid[end] = RED
+
+    blueprint = {
+        "grid": grid,
+        "legend": legend,
+        "start": start,
+        "end": end,
+        "dirs": dirs,
+        "lengths": lengths,
+        "path": path,
+        "segment_ids": segment_ids,
+        "segment_count": n_segments,
