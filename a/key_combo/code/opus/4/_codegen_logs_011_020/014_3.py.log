+def _local_tile_count_with_added(mask: np.ndarray, cell: tuple[int, int]) -> int:
+    r, c = cell
+    h, w = mask.shape
+    total = 0
+    seen: set[frozenset[tuple[int, int]]] = set()
+    for r0 in range(max(0, r - 1), min(h - 2, r) + 1):
+        for c0 in range(max(0, c - 1), min(w - 2, c) + 1):
