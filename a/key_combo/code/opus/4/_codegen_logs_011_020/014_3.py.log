+        while cur:
+            lsb = cur & -cur
+            cell_idx = lsb.bit_length() - 1
+            avail = [idx for idx in by_cell[cell_idx] if (tile_masks[idx] & state) == tile_masks[idx]]
+            count = len(avail)
+            if min_option_count is None or count < min_option_count:
