+        return best_score, best_count, best_kind, best_value
+
+    chosen_tiles: list[dict] = []
+    noise_cells: list[tuple[int, int]] = []
+    state = full_state
+    while state:
+        _score, _count, kind, value = solve(state)
+        if kind == 1:
+            chosen_tiles.append(tile_infos[value])
+            state ^= tile_masks[value]
+        elif kind == 0:
