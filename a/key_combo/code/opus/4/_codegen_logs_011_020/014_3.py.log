+        best_score = -1
+        best_count = 0
+        best_kind = -1
+        best_value = -1
+
+        options.sort(key=lambda idx: (-tile_sizes[idx], tile_infos[idx]["cells"]))
+        for tile_idx in options:
+            sub_score, sub_count, _kind, _value = solve(state ^ tile_masks[tile_idx])
+            score = sub_score + tile_sizes[tile_idx]
+            if score > best_score:
