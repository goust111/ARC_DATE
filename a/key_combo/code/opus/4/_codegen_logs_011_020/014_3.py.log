+        supported, tricky = _noise_semantics(noisy_mask, clean_mask, analysis)
+        if supported >= 1 and tricky >= 1:
+            return noisy_mask
+    return None
+
+
+def _generate_clean_instance() -> tuple[np.ndarray, np.ndarray] | None:
