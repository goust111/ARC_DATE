+    def solve(state: int) -> tuple[int, int, int, int]:
+        if state == 0:
+            return 0, 1, -1, -1
+
+        pivot_idx = -1
+        pivot_bit = 0
+        options: list[int] = []
+        min_option_count = None
+        cur = state
+        while cur:
+            lsb = cur & -cur
+            cell_idx = lsb.bit_length() - 1
+            avail = [idx for idx in by_cell[cell_idx] if (tile_masks[idx] & state) == tile_masks[idx]]
+            count = len(avail)
