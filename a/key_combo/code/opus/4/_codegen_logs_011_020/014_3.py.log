+        raise AssertionError("expected non-empty foreground mask")
+
+    cell_to_idx = {cell: idx for idx, cell in enumerate(coords)}
+    full_state = (1 << len(coords)) - 1
+
+    tile_masks: list[int] = []
+    tile_sizes: list[int] = []
+    tile_infos: list[dict] = []
+    seen_masks: set[int] = set()
+    h, w = mask.shape
+
+    for r0 in range(h - 1):
