+    ("square", ((0, 0), (0, 1), (1, 0), (1, 1)), BLUE),
+    ("missing_ul", ((0, 1), (1, 0), (1, 1)), RED),
+    ("missing_ll", ((0, 0), (0, 1), (1, 1)), GREEN),
+    ("missing_ur", ((0, 0), (1, 0), (1, 1)), YELLOW),
+)
+
+GEN_MAX_ATTEMPTS = 300
+GEN_HEIGHT_RANGE = (11, 14)
