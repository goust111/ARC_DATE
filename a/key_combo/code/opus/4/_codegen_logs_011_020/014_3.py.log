+                    {
+                        "tile_type": tile_type,
+                        "color": color,
+                        "cells": tuple(cells),
+                        "mask": bits,
+                    }
+                )
+
+    by_cell: list[list[int]] = [[] for _ in coords]
+    for idx, bits in enumerate(tile_masks):
+        cur = bits
+        while cur:
+            lsb = cur & -cur
+            by_cell[lsb.bit_length() - 1].append(idx)
+            cur ^= lsb
+
+    @lru_cache(maxsize=None)
+    def solve(state: int) -> tuple[int, int, int, int]:
