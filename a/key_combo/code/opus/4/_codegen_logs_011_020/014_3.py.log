+def _render_input(shape: tuple[int, int], placements: list[tuple[int, tuple[tuple[int, int], ...]]]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for _tile_type, cells in placements:
+        for r, c in cells:
