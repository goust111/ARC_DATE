+        "optimal_count": solve(full_state)[1],
+        "tiles": chosen_tiles,
+        "noise_cells": tuple(noise_cells),
+        "covered_mask": covered,
+        "output": out,
+        "all_candidate_tiles": tuple(tile_infos),
+        "foreground_area": len(coords),
