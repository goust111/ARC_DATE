+def _generate_clean_instance() -> tuple[np.ndarray, np.ndarray] | None:
+    for _ in range(GEN_CLEAN_LOCAL_ATTEMPTS):
+        height = random.randint(*GEN_HEIGHT_RANGE)
+        width = random.randint(*GEN_WIDTH_RANGE)
