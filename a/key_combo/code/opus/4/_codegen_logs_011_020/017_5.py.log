+def _edge_reachable_black(grid: np.ndarray) -> np.ndarray:
+    grid = np.asarray(grid, dtype=int)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if grid[r, c] == BLACK and not seen[r, c]:
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if grid[r, c] == BLACK and not seen[r, c]:
+                stack.append((r, c))
