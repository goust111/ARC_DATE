import random, numpy as np
BLACK, BLUE, RED, YELLOW, GREY = 0,1,2,4,5

def complete(panel):
    out=np.zeros((9,9),int)
    row=np.all(panel[4,:]==GREY)
    col=np.all(panel[:,4]==GREY)
    if row and not col:
        top=panel[:4,:]==BLUE
        bot=panel[5:,:]==BLUE
        if top.sum() and not bot.sum():
            src=top
            out[:4,:]=src
            out[5:,:]=np.flipud(src)
        elif bot.sum() and not top.sum():
            src=bot
            out[5:,:]=src
            out[:4,:]=np.flipud(src)
        else:
            return None
    elif col and not row:
        left=panel[:,:4]==BLUE
        right=panel[:,5:]==BLUE
        if left.sum() and not right.sum():
            src=left
            out[:,:4]=src
            out[:,5:]=np.fliplr(src)
        elif right.sum() and not left.sum():
            src=right
            out[:,5:]=src
            out[:,:4]=np.fliplr(src)
        else:
            return None
    else:
        return None
    return out.astype(int)

def fill_holes(grid):
    g=grid.copy()
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    st=[]
    for r in range(H):
        for c in (0,W-1):
            if g[r,c]==0 and not seen[r,c]: st.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if g[r,c]==0 and not seen[r,c]: st.append((r,c))
    while st:
        r,c=st.pop()
        if not (0<=r<H and 0<=c<W) or seen[r,c] or g[r,c]"'!=0: continue
        seen[r,c]=1
        st += [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]
    holes=(g==0)&(~seen)
    g[holes]=2
    return g, holes.sum()

def overlay(a,b):
    x=np.zeros((9,9),int)
    af=a==1; bf=b==1
    x[af''^bf]=1
    x[af&bf]=4
    return x

def family_h(side='"'top'):
    p=np.zeros((4,9),int)
    bar_r=random.choice([0,1])
    a=random.randint(1,3)
    b=random.randint(5,7)
    p[bar_r,a:b+1]=1
    for rr in range(bar_r,4):
        p[rr,a]=1; p[rr,b]=1
    if random.random()<0.6:
        m=random.randint(a+1,b-1)
        for rr in range(bar_r+1,4):
            p[rr,m]=1
    if random.random()<0.4 and a>0:
        p[bar_r,a-1]=1
    if random.random()<0.4 and b<8:
        p[bar_r,b+1]=1
    if p.sum()>12:
        # trim extras from top row between posts excluding endpoints
        extras=[(bar_r,c) for c in range(a+1,b) if p[bar_r,c]==1]
        random.shuffle(extras)
        while p.sum()>12 and extras:
            r,c=extras.pop(); p[r,c]=0
    if p.sum()<6 or p.sum()>12: return None
    if side=='bottom': p=np.flipud(p)
    return p

def family_v(side='left'):
    p=np.zeros((9,4),int)
