+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+PANEL_SIZE = 9
+GUIDE_INDEX = 4
+SEPARATOR_COL = 9
+GRID_SHAPE = (9, 19)
+GENERATION_ATTEMPTS = 500
+
