+    left = random.randint(1, 2)
+    right = random.randint(6, 7)
+
+    patch[bar_r, left : right + 1] = BLUE
+    for rr in range(bar_r, 4):
+        patch[rr, left] = BLUE
+        patch[rr, right] = BLUE
+
