+    while stack:
+        r, c = stack.pop()
+        if not (0 <= r < h and 0 <= c < w):
+            continue
+        if seen[r, c] or grid[r, c] != BLACK:
+            continue
+        seen[r, c] = True
+        stack.extend(_neighbors4(r, c))
