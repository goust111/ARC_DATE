+    for _ in range(GENERATION_ATTEMPTS):
+        panels = _sample_panels()
+        if panels is None:
+            continue
+        grid = _compose_grid(*panels)
+        if _is_good_instance(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid overlay-and-hole ARC input")

