+    if int(np.count_nonzero(overlay != BLACK)) > 48:
+        return False
+
+    expected = _fill_enclosed_black(overlay)
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    return bool(np.array_equal(actual, expected))
