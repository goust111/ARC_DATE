+def _overlay(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    out = np.full(left.shape, BLACK, dtype=int)
+    left_fg = left == BLUE
+    right_fg = right == BLUE
+    out[left_fg ^ right_fg] = BLUE
+    out[left_fg & right_fg] = YELLOW
+    return out
