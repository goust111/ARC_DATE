+    out = g.copy()
+    for r, c in activated:
+        out[r, c] = Color.ORANGE
+
+    ray_mask = np.zeros_like(shape_mask, dtype=bool)
+    stop_reasons: list[str] = []
+    ray_lengths: list[int] = []
