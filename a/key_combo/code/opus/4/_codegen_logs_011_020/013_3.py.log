+def _overlay_masks(masks: dict[int, np.ndarray], order: tuple[int, int, int]) -> np.ndarray:
+    shape = next(iter(masks.values())).shape
+    out = np.full(shape, int(Color.BLACK), dtype=int)
+    for color in order:
