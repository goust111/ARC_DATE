+        return False
+    if len(set(map(int, top_counts))) != 3 or len(set(map(int, bottom_counts))) != 3:
+        return False
+
+    growth_rank = tuple(np.argsort(diffs))
+    forbidden_ranks = {
+        tuple(np.argsort(top_counts)),
+        tuple(np.argsort(-top_counts)),
+        tuple(np.argsort(bottom_counts)),
