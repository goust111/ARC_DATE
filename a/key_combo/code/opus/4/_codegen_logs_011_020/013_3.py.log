+def _extract_panel_masks(grid: np.ndarray) -> tuple[dict[int, np.ndarray], dict[int, np.ndarray]]:
+    panel_h, panel_w = _panel_layout(grid)
+    top = grid[:panel_h, :]
+    bottom = grid[panel_h + 1 :, :]
