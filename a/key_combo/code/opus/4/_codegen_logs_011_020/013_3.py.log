+
+import numpy as np
+
+
+def _load_color_class():
+    try:
+        from arc_utils import Color as color_cls
+
+        return color_cls
+    except Exception:
+        pass
+
+    utils_path = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
