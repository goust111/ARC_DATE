+        + (bottom_masks[PANEL_COLORS[0]] & bottom_masks[PANEL_COLORS[2]]).sum()
+        + (bottom_masks[PANEL_COLORS[1]] & bottom_masks[PANEL_COLORS[2]]).sum()
+    )
+    if int(pairwise_overlap) < 3:
