+def _neighbors4(h: int, w: int, cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    out = []
+    if r > 0:
+        out.append((r - 1, c))
+    if r + 1 < h:
+        out.append((r + 1, c))
+    if c > 0:
+        out.append((r, c - 1))
+    if c + 1 < w:
+        out.append((r, c + 1))
+    return out
