+            return None
+        for _ in range(PLACEMENT_RETRIES):
+            top = random.randint(1, height - h - 1)
+            left = random.randint(1, width - w - 1)
+            box = _expanded_box(sprite, top, left)
+            if any(_boxes_overlap(box, other) for other in boxes):
