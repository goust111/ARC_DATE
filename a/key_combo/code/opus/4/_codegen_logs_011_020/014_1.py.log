+def _place_shapes(shapes: list[np.ndarray], hole_counts: list[int], shape: tuple[int, int]) -> list[Placement] | None:
+    height, width = shape
+    order = sorted(range(len(shapes)), key=lambda i: (shapes[i].shape[0] + 2) * (shapes[i].shape[1] + 2), reverse=True)
