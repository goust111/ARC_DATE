PATCH_SIDE_MIN, PATCH_SIDE_MAX = 2, 7
L_PATCH_SIDE_MIN, L_PATCH_SIDE_MAX = 3, 7
PATCH_AREA_MIN, PATCH_AREA_MAX = 4, 43

