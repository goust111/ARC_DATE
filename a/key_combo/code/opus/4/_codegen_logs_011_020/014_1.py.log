+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+HALO_BY_HOLE_COUNT = {0: BLUE, 1: RED, 2: GREEN}
+
+GENERATION_RETRIES = 400
+SHAPE_RETRIES = 200
+PLACEMENT_RETRIES = 600
+
