+        nr = int(r)
+        while nr + 1 < settled.shape[0] and int(settled[nr + 1, c]) == BG:
+            nr += 1
+        settled[nr, c] = int(color)
+        final_by_color.setdefault(int(color), []).append((int(nr), int(c)))
