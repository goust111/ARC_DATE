+from arc_utils import Color, colors_present
+
+
+BG = int(Color.BLACK)
+FRAME = int(Color.GREY)
+ROW_LINE = int(Color.YELLOW)
+COL_LINE = int(Color.PINK)
+MARKER_PALETTE = [int(Color.BLUE), int(Color.RED), int(Color.GREEN), int(Color.ORANGE)]
+
+MAX_ATTEMPTS = 300
+LOCAL_ATTEMPTS = 120
