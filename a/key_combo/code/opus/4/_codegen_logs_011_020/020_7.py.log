+    def cells(self) -> set[tuple[int, int]]:
+        left, right = self.horizontal_span
+        cells = {(int(self.r_top), c) for c in range(left, right + 1)}
+        cells.update((r, int(self.c_end)) for r in range(int(self.r_top), int(self.r_bottom) + 1))
+        return cells
