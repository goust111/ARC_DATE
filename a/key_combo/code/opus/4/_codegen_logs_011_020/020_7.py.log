+            if not candidates:
+                continue
+            dcol, drow = random.choice(candidates)
+        else:
+            candidates = []
+            for drow in range(1, min(3, r_top_a - 1) + 1):
+                for dcol in range(drow + 1, min(max_dcol, drow + 3) + 1):
+                    candidates.append((dcol, drow))
+            if not candidates:
+                continue
+            dcol, drow = random.choice(candidates)
