+    for cell, owners in _contributors(paths).items():
+        out[cell] = owners[0].color if len(owners) == 1 else _path_winner(owners, cell)
+    for path in paths:
+        for endpoint in path.endpoints:
+            out[endpoint] = int(path.color)
+    return out
