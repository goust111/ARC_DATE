+    for path in sorted(paths, key=lambda item: int(item.color)):
+        for cell in path.cells():
+            out[cell] = int(path.color)
+    for path in paths:
+        for endpoint in path.endpoints:
+            out[endpoint] = int(path.color)
+    return out
+
+
