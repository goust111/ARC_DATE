+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_MODES = ("a_wins", "b_wins", "tie_a_wins")
+MAX_GEN_ATTEMPTS = 400
+_GEN_CALL_COUNT = 0
