_TEMPLATE_CONNECTIVITY = 8

# -- CFG: marker placement --
_MIN_SLOT_COVERAGE = 0.60  # minimum fraction of NxN slots filled with markers

# -- CFG: palette swatch --
_SWATCH_DOUBLE_PROB = 0.35  # probability of 2-pixel swatch (vs 1-pixel)

# -- CFG: retry --
