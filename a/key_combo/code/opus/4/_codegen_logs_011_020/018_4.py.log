+    if info["outlier_idx"] != outlier_idx or info["outlier_area"] != outlier_area:
+        return False
+    if info["target_idx"] != target_idx:
+        return False
+    if not np.array_equal(info["sprite_patch"], sprite_patch):
+        return False
