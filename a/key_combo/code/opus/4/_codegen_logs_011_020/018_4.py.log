+    w = left_w + 1 + right_w
+    grid = np.full((h, w), BG, dtype=int)
+    grid[:, left_w] = DIVIDER
+
+    left_canvas = np.full((h, left_w), BG, dtype=int)
+    sprite_r, sprite_c = random_free_location(
