+def _expected_output_from_metadata(
+    grid: np.ndarray,
+    *,
+    slot_h: int,
+    left_w: int,
+    right_w: int,
+    sprite_patch: np.ndarray,
+    outlier_patch: np.ndarray,
+    outlier_idx: int,
+    target_idx: int,
