+    return out
+
+
+def _semantic_validation(
+    grid: np.ndarray,
+    *,
+    sprite_patch: np.ndarray,
+    slot_h: int,
+    left_w: int,
+    right_w: int,
+    outlier_idx: int,
+    outlier_area: int,
+    target_idx: int,
+    expected: np.ndarray,
+) -> bool:
+    try:
+        info = _analyze_grid(grid)
+    except Exception:
+        return False
+
+    if info["slot_h"] != slot_h or info["left_width"] != left_w or info["right_width"] != right_w:
