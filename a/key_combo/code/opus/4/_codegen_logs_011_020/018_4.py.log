+
+def _choose_outlier_red_patch(slot_h: int, right_w: int, area: int, normal_signature: tuple[tuple[int, ...], ...]) -> np.ndarray | None:
+    keys = [key for key in RED_KEYS if key[0] <= slot_h and key[1] <= right_w and key[2] == area]
+    random.shuffle(keys)
