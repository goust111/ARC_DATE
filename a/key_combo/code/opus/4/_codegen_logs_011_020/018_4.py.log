+def _render_input(
+    *,
+    slot_h: int,
+    left_w: int,
+    right_w: int,
+    sprite_patch: np.ndarray,
+    normal_patch: np.ndarray,
+    outlier_patch: np.ndarray,
+    outlier_idx: int,
+) -> tuple[np.ndarray, tuple[int, int]]:
