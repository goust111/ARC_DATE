+    for c in range(w):
+        if np.all(grid[:, c] == grid[0, c]):
+            candidates.add(int(grid[0, c]))
+    assert len(candidates) == 1, f"expected one divider color, found {sorted(candidates)}"
+    return next(iter(candidates))
