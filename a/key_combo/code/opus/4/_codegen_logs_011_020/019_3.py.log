+
+
+def _foreground_by_color(grid: np.ndarray) -> dict[int, np.ndarray]:
+    colors = sorted(set(map(int, grid.ravel())) - {BLACK, RED})
+    return {color: np.argwhere(grid == color) for color in colors}
