        assert patch.shape == (height, width)
        assert np.all(patch != separator)

        mark_mask = patch != blank
        assert np.any(mark_mask)
        assert not np.any((out != blank) & mark_mask)
        out[mark_mask] = patch[mark_mask]

    return out

