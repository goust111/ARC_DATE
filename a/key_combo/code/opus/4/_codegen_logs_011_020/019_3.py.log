+    out = fallen.copy()
+    for i, (r0, r1) in enumerate(bands):
+        band = out[r0:r1, :]
+        fg_mask = (band != BLACK) & (band != RED)
+        if i == winner:
+            band[band == BLACK] = GREY
+        else:
+            band[fg_mask] = BLACK
+        out[r0:r1, :] = band
+    return out
