    (0, 0): (0, 0),
    (0, 1): (1, 1),
    (0, 2): (0, 4),
    (1, 0): (3, 1),
    (1, 1): (2, 2),
    (1, 2): (1, 3),
    (2, 0): (4, 0),
    (2, 1): (3, 3),
    (2, 2): (4, 4),
}

TILE_COLUMN_SOURCES = (
    ((0, 0), (3, 1), (4, 0)),
    ((1, 1), (2, 2), (3, 3)),
    ((0, 4), (1, 3), (4, 4)),
)

VALID_COUNT_TRIPLES = [
    counts
    for counts in itertools.product((1, 2, 3), repeat=3)
    if sum(counts) >= 5
]


