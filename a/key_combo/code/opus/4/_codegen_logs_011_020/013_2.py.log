    seg_c0 = None
    for _ in range(60):
        candidate_width = random.randint(min_width, 30)
        lo = max(candidate_width // 2, x_c0 + 8)
        hi = candidate_width - (length + max_count)
        if lo <= hi:
            width = candidate_width
            seg_c0 = random.randint(lo, hi)
            break
