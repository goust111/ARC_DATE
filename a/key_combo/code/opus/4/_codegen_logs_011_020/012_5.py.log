+            rect_w = _ri(rng, 1, min(width, max(1, width // 2 + 1)))
+            r0 = _ri(rng, 0, height - rect_h)
+            c0 = _ri(rng, 0, width - rect_w)
+            half[r0 : r0 + rect_h, c0 : c0 + rect_w] = int(color)
+
+    for _ in range(_ri(rng, 1, 2)):
+        color = int(colors[_ri(rng, 0, len(colors) - 1)])
+        if rng.random() < 0.5:
