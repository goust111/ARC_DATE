+    inp = expected.copy()
+    inp[top + occ_r : top + occ_r + occ_h, left + occ_c : left + occ_c + occ_w] = OCCLUDER
+
+    true_axis = _true_axis(top, left, obj_h, obj_w, orientation)
+    return inp if _case_is_valid(inp, expected, orientation, true_axis) else None
