+    r0, c0, r1, c1 = box
+    assert grey_mask[r0 : r1 + 1, c0 : c1 + 1].all(), "grey component must be a filled rectangle"
+    assert int(grey_mask.sum()) == bbox_h(box) * bbox_w(box), "grey component must be rectangular"
