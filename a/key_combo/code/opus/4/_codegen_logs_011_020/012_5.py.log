+    return out
+
+
+def _build_symmetric_patch(
+    height: int, width: int, orientation: str, colors: list[int], rng: np.random.Generator
+) -> np.ndarray | None:
+    for _ in range(80):
+        if orientation == "vertical":
+            half = _make_half_pattern(height, (width + 1) // 2, colors, rng)
+        else:
