+import numpy as np
+
+_ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
+_ARC_SPEC = importlib.util.spec_from_file_location("_shared_arc_utils", _ARC_UTILS_PATH)
+if _ARC_SPEC is None or _ARC_SPEC.loader is None:
