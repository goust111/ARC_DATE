+
+Color = _ARC_UTILS.Color
+bbox = _ARC_UTILS.bbox
+bbox_h = _ARC_UTILS.bbox_h
+bbox_w = _ARC_UTILS.bbox_w
+colors_present = _ARC_UTILS.colors_present
