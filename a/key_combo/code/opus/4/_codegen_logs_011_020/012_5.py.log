+is_contiguous = _ARC_UTILS.is_contiguous
+paste = _ARC_UTILS.paste
+
+BG = Color.BLACK
+OCCLUDER = Color.GREY
+PALETTE = [
+    Color.BLUE,
+    Color.RED,
+    Color.GREEN,
+    Color.YELLOW,
+    Color.PINK,
+    Color.ORANGE,
+    Color.TEAL,
+    Color.MAROON,
