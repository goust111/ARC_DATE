+def _axis_score(grid: np.ndarray, orientation: str, axis: int, bg: int) -> int:
+    g = np.asarray(grid, dtype=int)
+    coords = np.argwhere(g != int(bg))
+    score = 0
+    if orientation == "vertical":
+        width = g.shape[1]
+        for r, c in coords:
+            mc = int(axis) - int(c)
+            if 0 <= mc < width and int(g[r, mc]) == int(g[r, c]):
+                score += 1
+    else:
+        height = g.shape[0]
+        for r, c in coords:
