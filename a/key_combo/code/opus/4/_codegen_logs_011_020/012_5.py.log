+    height = _ri(rng, 13, 17)
+    width = _ri(rng, 13, 17)
+    orientation = "vertical" if rng.random() < 0.5 else "horizontal"
+
+    obj_h = _ri(rng, 7, min(9, height - 4))
+    obj_w = _ri(rng, 7, min(9, width - 4))
