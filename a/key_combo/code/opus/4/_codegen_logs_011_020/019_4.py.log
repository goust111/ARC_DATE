+    triple_ok = int(np.argmax(areas)) != 0
+
+    options: list[tuple[int, ...]] = pair_choices[:]
+    if triple_ok:
+        options.extend([(0, 1, 2)] * 2)
+    assert options
+    return random.choice(options)
+
+
+def _sample_objects() -> tuple[np.ndarray, np.ndarray] | None:
