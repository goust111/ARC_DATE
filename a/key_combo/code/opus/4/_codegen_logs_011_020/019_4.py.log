+_GEN_SEPARATOR = Color.GREY
+_GEN_BG = Color.BLACK
+_GEN_COLORS = [Color.BLUE, Color.RED, Color.GREEN]
+_GEN_PANEL_H_RANGE = (9, 12)
+_GEN_PANEL_W_RANGE = (5, 8)
