def _gen_connector_cells(grid: np.ndarray, bg: int, marker_boxes: dict[int, list[tuple[int, int, int, int]]]):
    """Plan all rectangle connector cells, returning None on color conflict."""
    planned: dict[tuple[int, int], int] = {}
