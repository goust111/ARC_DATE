+    for (lr, lc), color in zip(chosen_positions, color_list):
+        boxes.append(_make_box(lr * (size + 1), lc * (size + 1), size, color))
+        grouped_indices[color].append(len(boxes) - 1)
+
+    inner = size - 2
+    marker_sets: list[set[tuple[int, int]]] = [set() for _ in boxes]
