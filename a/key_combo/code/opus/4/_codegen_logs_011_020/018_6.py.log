        v_cols = {int(bar["bbox"][1]) for bar in verticals}
        if len(h_rows) != 2 or len(v_cols) != 2:
            continue

        top, bottom = sorted(horizontals, key=lambda bar: int(bar["bbox"][0]))
        left, right = sorted(verticals, key=lambda bar: int(bar["bbox"][1]))

