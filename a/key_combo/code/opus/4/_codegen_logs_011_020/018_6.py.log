        if bottom["bbox"] != (bottom_row, left_col + 1, bottom_row, right_col - 1):
            continue
        if left["bbox"] != (top_row + 1, left_col, bottom_row - 1, left_col):
            continue
        if right["bbox"] != (top_row + 1, right_col, bottom_row - 1, right_col):
