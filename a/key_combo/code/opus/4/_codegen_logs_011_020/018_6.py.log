+    if name == "pair_safe_adj_iso":
+        return [
+            random.choice(same),
+            random.choice(same),
+            random.choice(other),
+            random.randint(*SEED_ROW_RANGE),
+        ]
+    raise ValueError(f"unknown template: {name}")
+
+
+def _build_seed_specs(template: str, width: int) -> list[tuple[int, int, int]]:
