+    if matches[0][:3] != target:
+        return False
+    actual = main(grid)
+    return np.array_equal(actual, expected)
+
+
+def _generate_attempt(
+    rng: np.random.Generator, target_rotation: int, anchor_count: int, placement_mode: str
+) -> np.ndarray | None:
