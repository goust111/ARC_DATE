+
+
+def _candidate_positions(
+    canvas_shape: tuple[int, int], rotated: np.ndarray, placement_mode: str
+) -> list[tuple[int, int]]:
+    rows, cols = map(int, canvas_shape)
+    height, width = map(int, rotated.shape)
