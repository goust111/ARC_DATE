+
+
+def _choose_anchors(
+    sprite: np.ndarray,
+    positions: list[tuple[int, int, int]],
+    canvas_shape: tuple[int, int],
+    target: tuple[int, int, int],
+    preferred_count: int,
+    rng: np.random.Generator,
+) -> list[tuple[int, int, int]] | None:
+    for count in (preferred_count, 5 - preferred_count):
