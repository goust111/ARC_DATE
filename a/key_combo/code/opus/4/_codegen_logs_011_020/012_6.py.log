+    wrap_sources = 0
+    wrap_added = 0
+    collisions = 0
+    added_targets: set[tuple[int, int]] = set()
+    for r, c in np.argwhere(tile != BG):
+        rr = int(r)
+        cc = int(c)
+        if rr == 0:
+            touch_top = True
+            continue
+        sr = rr - 1
+        sc = (cc - 1 + cols) % cols
+        if cc == 0:
+            wrap_sources += 1
