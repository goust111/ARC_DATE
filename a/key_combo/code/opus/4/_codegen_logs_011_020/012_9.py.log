+        np.array([[0, 1, 2], [1, 2, 0], [2, 0, 1]], dtype=int),
+        np.array([[0, 2, 1], [1, 0, 2], [2, 1, 0]], dtype=int),
+        np.array([[0, 1, 0], [1, 0, 1], [1, 0, 0]], dtype=int),
+        np.array([[0, 0, 1], [1, 0, 1], [0, 1, 0]], dtype=int),
+    ),
