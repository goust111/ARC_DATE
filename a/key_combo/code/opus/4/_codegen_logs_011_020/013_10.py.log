+    for comp in _find_color_components(grid, set(SPRITE_COLORS)):
+        box = comp["bbox"]
+        patch = _crop_bbox(grid, box)
+        color = int(comp["color"])
+        sprites.append(
+            {
+                "color": color,
+                "coords": comp["coords"],
+                "bbox": box,
+                "patch": patch,
+                "mask": patch == color,
+            }
+        )
