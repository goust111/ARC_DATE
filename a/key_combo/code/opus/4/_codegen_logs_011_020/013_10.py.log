+    group_bbox = (
+        min(rect["bbox"][0] for rect in rects),
+        min(rect["bbox"][1] for rect in rects),
+        max(rect["bbox"][2] for rect in rects),
+        max(rect["bbox"][3] for rect in rects),
+    )
+    control = tuple(map(int, control_coords[0]))
