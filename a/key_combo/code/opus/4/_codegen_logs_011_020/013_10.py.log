+    hole_infos.sort(key=lambda info: (info["rect_box"][0], info["rect_box"][1]))
+    group_bbox = (
+        min(box[0] for box in rect_boxes),
+        min(box[1] for box in rect_boxes),
+        max(box[2] for box in rect_boxes),
+        max(box[3] for box in rect_boxes),
