+    return tuple(map(int, arr.shape)), arr.tobytes()
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
