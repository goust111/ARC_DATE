+    return comps
+
+
+def _find_color_components(grid: np.ndarray, colors: set[int]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return comps
+
+
+def _hole_mask_from_rect_patch(rect_patch: np.ndarray) -> np.ndarray:
+    black = np.asarray(rect_patch == BG, dtype=bool)
+    h, w = black.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if black[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if black[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+    while q:
+        rr, cc = q.popleft()
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and black[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                q.append((nr, nc))
+    return black & ~exterior
