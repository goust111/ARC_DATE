        fill_mask[r:r1, c + 1 : c + 1 + motif_w] = True
        motif_mask[r1 - motif_h : r1, c + 1 : c + 1 + motif_w] = True
        if c + 1 + motif_w < GEN_GRID_W:
            guard_mask[r1 - 1, c + 1 + motif_w] = True
        return {
            "bar": bar_mask,
            "fill": fill_mask,
