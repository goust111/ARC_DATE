+def _extract_swatches_and_pattern(grid: np.ndarray, stripe_row: int) -> tuple[list[int], np.ndarray]:
+    lower = np.asarray(grid[stripe_row + 1 :], dtype=int)
+    colored = np.argwhere(lower != BG)
