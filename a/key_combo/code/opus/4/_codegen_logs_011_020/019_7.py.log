+def _draw_template(grid: np.ndarray, top: int, left: int, mask: np.ndarray) -> None:
+    patch = np.zeros((3, 3), dtype=int)
+    patch[np.asarray(mask, dtype=bool)] = GREY
+    grid[top : top + 3, left : left + 3] = patch
