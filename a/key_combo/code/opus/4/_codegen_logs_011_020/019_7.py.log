+
+def _split_slack(total: int, parts: int) -> list[int]:
+    out = [0] * parts
+    for _ in range(total):
+        out[random.randrange(parts)] += 1
+    return out
+
+
+def _draw_template(grid: np.ndarray, top: int, left: int, mask: np.ndarray) -> None:
+    patch = np.zeros((3, 3), dtype=int)
