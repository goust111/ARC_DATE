+BG = Color.BLACK
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.ORANGE]
+OBJECT_COUNT_OPTIONS = (4, 5)
+AREA_RANGE = (2, 5)
+CANVAS_HEIGHT_RANGE = (12, 17)
+CANVAS_WIDTH_RANGE = (11, 17)
+CHAIN_PATTERNS = {
+    4: [(2, 2), (3, 1)],
+    5: [(3, 2), (2, 2, 1), (4, 1)],
+}
+GENERATION_RETRIES = 400
