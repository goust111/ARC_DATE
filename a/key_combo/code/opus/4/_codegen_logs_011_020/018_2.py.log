+    changed = True
+    while changed:
+        changed = False
+        for idx in list(movable):
+            coords = objects[idx]["coords"]
+            shifted_rows = coords[:, 0] + 1
+            if np.any(shifted_rows >= h):
+                movable.remove(idx)
+                changed = True
+                continue
