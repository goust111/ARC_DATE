+def _simulate_gravity(objects: list[dict], shape: tuple[int, int]) -> list[dict]:
+    settled = []
+    for obj in objects:
+        settled.append(
+            {
+                "color": int(obj["color"]),
+                "coords": np.asarray(obj["coords"], dtype=int).copy(),
+                "initial_top": int(obj["initial_top"]),
