+        if not candidates:
+            return None
+
+        top, left, child_global = random.choice(candidates)
+        placed.append(
+            {
+                "patch": patch,
+                "color": int(patch[patch != BG][0]),
+                "top": top,
+                "left": left,
+                "coords": child_global,
+            }
