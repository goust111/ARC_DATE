+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
+
+    objects = _extract_objects(g)
+    settled = _simulate_gravity(objects, g.shape)
+    return _rings_from_falls(settled)
