+        for left in range(parent_c0 - child_w + 1, parent_c1 + 1):
+            top = _support_top(child_local, left, placed[-1]["coords"])
+            if top is None:
+                continue
+            child_global = _translate(child_local, top, left)
+            if _touches_any(child_global, occupied):
