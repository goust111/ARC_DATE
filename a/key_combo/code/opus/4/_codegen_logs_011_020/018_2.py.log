+
+    simulated = _simulate_gravity(objects, grid.shape)
+    by_color = {int(obj["color"]): obj for obj in simulated}
+    for obj in final_objects:
+        settled = by_color[int(obj["color"])]
+        if _footprint(settled["coords"]) != _footprint(obj["coords"]):
