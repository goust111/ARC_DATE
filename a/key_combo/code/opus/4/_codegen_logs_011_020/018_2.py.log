+            ),
+            BG,
+            dtype=int,
+        )
+        patch[coords[:, 0] - coords[:, 0].min(), coords[:, 1] - coords[:, 1].min()] = int(obj["color"])
+        paste(grid, patch, int(coords[:, 0].min()), int(coords[:, 1].min()), transparent=BG)
+        objects.append(
+            {
+                "color": int(obj["color"]),
+                "coords": coords,
+                "initial_top": int(coords[:, 0].min()),
+            }
+        )
