def extract_objects(grid):
    objs = []
    for color in sorted(int(c) for c in np.unique(grid) if int(c) "'!= 0):
        cells = {(int(r), int(c)) for r, c in np.argwhere(grid == color)}
        objs.append({'"'color': color, 'cells': cells, 'initial_top': min(r for r, _ in cells)})
    return objs

def simulate(objects, shape):
    h, _ = shape
    objs = [{'color': o['color'], 'cells': set(o['cells']), 'initial_top': o['initial_top']} for o in objects]
    for _ in range(h):
        occ = {}
        for idx, obj in enumerate(objs):
            for cell in obj['cells']:
                assert cell not in occ
                occ[cell] = idx
        movable = set(range(len(objs)))
        changed = True
        while changed:
            changed = False
            for idx in list(movable):
                cells = objs[idx]['cells']
                if any(r + 1 >= h for r, c in cells):
                    movable.remove(idx)
                    changed = True
                    continue
                blockers = {occ[(r + 1, c)] for r, c in cells if (r + 1, c) in occ and occ[(r + 1, c)] "'!= idx}
                if any(blocker not in movable for blocker in blockers):
                    movable.remove(idx)
                    changed = True
        if not movable:
            break
        for idx in movable:
            objs[idx]['"'cells'] = {(r + 1, c) for r, c in objs[idx]['cells']}
    for obj in objs:
        obj['final_top'] = min(r for r, _ in obj['cells'])
        obj['fall'] = obj['final_top'] - obj['initial_top']
    return objs

def expected_output(objects):
    ordered = sorted(objects, key=lambda o: o['fall'], reverse=True)
    k = len(ordered)
    side = 2 * k - (k % 2)
    out = np.full((side, side), ordered[0]['color'], dtype=int)
    for layer, obj in enumerate(ordered[1:], start=1):
        out[layer:side-layer, layer:side-layer] = obj['color']
    return out

for i in range(60):
    inp = mod.generate_input()
    objs = simulate(extract_objects(inp), inp.shape)
    got = mod.main(inp)
    want = expected_output(objs)
    assert np.array_equal(got, want), f'mismatch on sample {i}'
print('semantic_checks', 60)
