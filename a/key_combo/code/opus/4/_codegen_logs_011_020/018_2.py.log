+    if not _has_inversion(settled, "initial_top", "lower_starts_more"):
+        return None
+    if not _has_inversion(settled, "final_top", "higher_ends_more"):
+        return None
+
+    out = main(grid)
+    if out.ndim != 2 or max(out.shape) > 30:
+        return None
+    return grid
+
