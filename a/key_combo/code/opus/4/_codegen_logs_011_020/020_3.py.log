+    grid = np.full((slot_rows * SLOT_STRIDE + 1, slot_cols * SLOT_STRIDE + 1), BG, dtype=int)
+
+    slots = [(1 + sr * SLOT_STRIDE, 1 + sc * SLOT_STRIDE) for sr in range(slot_rows) for sc in range(slot_cols)]
+    rng.shuffle(slots)
+    slot_iter = iter(slots)
