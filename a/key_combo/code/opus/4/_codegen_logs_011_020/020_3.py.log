def _gen_render_bboxes(rows, cols, bboxes):
    inp = np.zeros((rows, cols), dtype=int)
    out = np.zeros((rows, cols), dtype=int)

    for r0, c0, r1, c1 in bboxes:
        width = c1 - c0 + 1
        mask = _gen_fragment_mask(width)
        if mask is None:
            return None
        out[r0 : r1 + 1, c0 : c1 + 1] = Color.RED

