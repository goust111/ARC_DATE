    w_top, c_top, w_bottom, c_bottom = _gen_choice(choices)
    return rows, cols, [
        (0, c_top, RECT_HEIGHT - 1, c_top + w_top - 1),
        (RECT_HEIGHT, c_bottom, (2 * RECT_HEIGHT) - 1, c_bottom + w_bottom - 1),
