+
+        while len(cells) < target_area and frontier:
+            options = tuple(frontier)
+            nxt = options[int(rng.integers(len(options)))]
+            frontier.remove(nxt)
+            cells.add(nxt)
+            for cell in _neighbors8(*nxt):
