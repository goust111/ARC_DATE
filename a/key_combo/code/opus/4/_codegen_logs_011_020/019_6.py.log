 105: def main(grid: np.ndarray) -> np.ndarray:
 106:     """Convert each hollow 3x3 symbol to one pixel and slide the pixels clockwise from the marked edge.
 107: 
 108:     Input structure
 109:     - The grid has a background, one full-edge marker line, and monochrome hollow 3x3 foreground symbols.
 110:     - The symbols lie on a coarse row/column lattice; fully empty lattice rows or columns are absent from the output.
 111: 
 112:     Rule
 113:     - Replace each hollow 3x3 symbol with one pixel of its color in the corresponding coarse-grid cell.
 114:     - The marker edge gives the compaction direction by clockwise border travel: top -> right, right -> down, bottom -> left, left -> up.
 115:     - Preserve the order of non-background pixels while sliding them as far as possible in that direction.
 116: 
 117:     Key insight
 118:     - The large picture is a scaled symbolic grid, and the blue edge marker acts as a gravity direction rather than as output content.
 119:     """
 120:     g = np.asarray(grid, dtype=int)
 121:     symbolic, side, bg = _symbolic_grid(g)
 122:     return _compact(symbolic, side, bg)
