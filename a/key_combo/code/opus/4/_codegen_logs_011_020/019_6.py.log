+def _slide_box(
+    box: tuple[int, int, int, int], direction: str, shape: tuple[int, int]
+) -> tuple[int, int, int, int]:
+    h, w = map(int, shape)
+    r0, c0, r1, c1 = map(int, box)
+    assert r1 - r0 == 2 and c1 - c0 == 2
+    if direction == "left":
+        return (r0, 0, r1, 2)
+    if direction == "right":
+        return (r0, w - 3, r1, w - 1)
+    if direction == "up":
+        return (0, c0, 2, c1)
+    if direction == "down":
+        return (h - 3, c0, h - 1, c1)
