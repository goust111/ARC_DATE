+    elif direction == "down":
+        for c0 in range(w - 2):
+            final_box = (h - 3, c0, h - 1, c0 + 2)
+            for start_r in range(0, h - 3):
+                initial_box = (start_r, c0, start_r + 2, c0 + 2)
+                candidates.append((initial_box, final_box))
+    elif direction == "left":
+        for r0 in range(h - 2):
+            final_box = (r0, 0, r0 + 2, 2)
