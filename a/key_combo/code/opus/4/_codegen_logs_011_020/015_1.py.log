+def _sample_rect_dims(rect_count: int) -> list[tuple[int, int]]:
+    dims: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    primary = (random.randint(*PRIMARY_RECT_H), random.randint(*PRIMARY_RECT_W))
