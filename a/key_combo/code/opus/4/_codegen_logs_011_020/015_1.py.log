+
+
+def _place_rectangles(height: int, width: int, dims: list[tuple[int, int]]) -> list[BBox] | None:
+    placed: list[BBox] = []
+    for h, w in sorted(dims, key=lambda hw: hw[0] * hw[1], reverse=True):
+        candidates = []
+        for r0 in range(height - h + 1):
