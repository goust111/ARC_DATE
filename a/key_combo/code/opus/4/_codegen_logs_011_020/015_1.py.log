from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/4/015/1.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

BG, RED, GREEN, YELLOW, GREY, ORANGE = 0, 2, 3, 4, 5, 7
DIAGS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
ORTH = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def comps(mask):
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            cur = []
            while stack:
                rr, cc = stack.pop()
                cur.append((rr, cc))
                for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            out.append(cur)
    return out


def analyze(grid):
    rects = []
    for comp in comps(grid "'!= BG):
        rows = [r for r, _ in comp]
        cols = [c for _, c in comp]
        bbox = (min(rows), min(cols), max(rows), max(cols))
        r0, c0, r1, c1 = bbox
        region = grid[r0:r1 + 1, c0:c1 + 1]
        assert np.all(region != BG)
        markers = [(r0 + rr, c0 + cc) for rr, cc in np.argwhere(region == RED)]
        rects.append((bbox, markers))
    return rects


def depth(cell, bbox):
    r, c = cell
    r0, c0, r1, c1 = bbox
    return min(r - r0, r1 - r, c - c0, c1 - c)


def spec(grid):
    out = grid.copy()
    records = []
    for bbox, markers in analyze(grid):
        for marker in markers:
            records.append((marker[0], marker[1], bbox))
    records.sort()
    for r, c, bbox in records:
        d = depth((r, c), bbox)
        if d == 0:
            out[r, c] = GREY
            continue
        deltas = DIAGS if d % 2 == 1 else ORTH
        color = YELLOW if d % 2 == 1 else ORANGE
        for dr, dc in deltas:
            rr, cc = r + dr, c + dc
            if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1] and out[rr, cc] == GREEN:
                out[rr, cc] = color
    return out


def validate_generated_structure(grid):
    rects = analyze(grid)
    assert len(rects) in (2, 3)
    sizes = set()
    saw0 = saw1 = saw2 = False
    for bbox, markers in rects:
        h = bbox[2] - bbox[0] + 1
        w = bbox[3] - bbox[1] + 1
        assert (h, w) not in sizes
        sizes.add((h, w))
        assert 2 <= len(markers) <= 4
        depths = [depth(m, bbox) for m in markers]
        assert any(d % 2 == 0 for d in depths)
        assert any(d % 2 == 1 for d in depths)
        for i, a in enumerate(markers):
            for b in markers[i + 1:]:
                assert abs(a[0] - b[0]) + abs(a[1] - b[1]) >= 3
        saw0 |= any(d == 0 for d in depths)
        saw1 |= any(d > 0 and d % 2 == 1 for d in depths)
        saw2 |= any(d > 0 and d % 2 == 0 for d in depths)
    assert saw0 and saw1 and saw2


# Fixed branch-coverage sample.
grid = np.zeros((10, 11), dtype=int)
grid[1:8, 2:9] = GREEN
grid[1, 2] = RED      # depth 0
grid[2, 6] = RED      # depth 1
grid[4, 4] = RED      # depth 2
expected = spec(grid)
actual = mod.main(grid)
assert np.array_equal(actual, expected)
assert actual[1, 2] == GREY
assert actual[1, 5] == YELLOW and actual[3, 7] == YELLOW
assert actual[3, 4] == ORANGE and actual[4, 3] == ORANGE


# Search a valid conflict case automatically.
def expansion_targets(cell, bbox):
    d = depth(cell, bbox)
    if d == 0:
        return []
    deltas = DIAGS if d % 2 == 1 else ORTH
    return [(cell[0] + dr, cell[1] + dc) for dr, dc in deltas]

conflict_grid = None
for cells in combinations([(r, c) for r in range(7) for c in range(7)], 3):
    ok = True
    for i, a in enumerate(cells):
        for b in cells[i + 1:]:
            if abs(a[0] - b[0]) + abs(a[1] - b[1]) < 3:
                ok = False
                break
        if not ok:
            break
    if not ok:
        continue
    bbox = (0, 0, 6, 6)
    all_targets = {}
    conflict = False
    for idx, cell in enumerate(sorted(cells)):
        for tgt in expansion_targets(cell, bbox):
            if not (0 <= tgt[0] < 7 and 0 <= tgt[1] < 7):
                continue
            if tgt in cells:
                continue
            if tgt in all_targets:
                conflict = True
                break
            all_targets[tgt] = idx
        if conflict:
            break
    depths = [depth(cell, bbox) for cell in cells]
    if conflict and any(d == 0 for d in depths) and any(d % 2 == 1 for d in depths) and any(d > 0 and d % 2 == 0 for d in depths):
        conflict_grid = np.zeros((9, 9), dtype=int)
        conflict_grid[1:8, 1:8] = GREEN
        for r, c in cells:
            conflict_grid[1 + r, 1 + c] = RED
        break

assert conflict_grid is not None, '"'failed to find a conflict case'
assert np.array_equal(mod.main(conflict_grid), spec(conflict_grid))


for _ in range(200):
    inp = mod.generate_input()
    validate_generated_structure(inp)
    assert np.array_equal(mod.main(inp), spec(inp))

print('semantic_validation ok')
