    min_area = (FILL_PCT_RANGE[0] * area + PCT_DENOM - 1) // PCT_DENOM
    max_area = (FILL_PCT_RANGE[1] * area) // PCT_DENOM
    fragment_count = _gen_randint_inclusive(*FRAGMENT_COUNT_RANGE)
