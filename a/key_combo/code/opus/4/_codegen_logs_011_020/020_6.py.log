+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    mask = grid != bg
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    h, w = grid.shape
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not mask[r, c]:
+                continue
+
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            color_order: list[int] = []
+            color_seen: set[int] = set()
+
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                color = int(grid[rr, cc])
+                if color not in color_seen:
+                    color_seen.add(color)
+                    color_order.append(color)
+
+                for dr, dc in _NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds((h, w), nr, nc) and not seen[nr, nc] and mask[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            arr = np.array(coords, dtype=int)
+            r0, c0 = arr.min(axis=0)
+            r1, c1 = arr.max(axis=0)
+            comps.append(
+                {
+                    "coords": arr,
+                    "area": int(arr.shape[0]),
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "colors": tuple(color_order),
+                }
+            )
+
+    return comps
+
+
+def _crop_non_bg(grid: np.ndarray, bg: int = _BG) -> np.ndarray:
+    coords = np.argwhere(grid != bg)
+    if coords.size == 0:
+        return grid.copy()
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return grid[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
