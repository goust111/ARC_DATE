+        mapping = rules[key]
+        coords = comp["coords"]
+        values = g[coords[:, 0], coords[:, 1]]
+        swapped = np.array([mapping[int(v)] for v in values], dtype=int)
+        out[coords[:, 0], coords[:, 1]] = swapped
+
+    return out
+
+
+def _manhattan(a: Coord, b: Coord) -> int:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
