            (h, w)
            for h in range(2, 6)
            for w in range(2, 6)
            if h * w >= area + 1 and h * w <= area + 7
        ]
        h, w = random.choice(dims)
        mask = np.zeros((h, w), dtype=bool)
        start = (random.randrange(h), random.randrange(w))
        mask[start] = True

        while int(mask.sum()) < area:
            frontier: list[Coord] = []
            for rr, cc in zip(*np.where(mask)):
