+
+def _line_positions(grid: np.ndarray, axis: int) -> list[int]:
+    if axis == 0:
+        return [int(r) for r in range(grid.shape[0]) if np.all(grid[r, :] == LINE)]
+    return [int(c) for c in range(grid.shape[1]) if np.all(grid[:, c] == LINE)]
