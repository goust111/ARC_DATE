+    assignments: dict[tuple[int, int], dict] = {}
+    for pos, item in zip(EDGE_POSITIONS, edge_masks):
+        assignments[pos] = item
+    for pos, item in zip(INNER_POSITIONS, inner_masks):
+        assignments[pos] = item
