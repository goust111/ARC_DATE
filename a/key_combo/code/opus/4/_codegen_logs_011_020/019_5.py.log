+def _choose_one(pool: list[dict], used_raw: set[tuple[str, ...]], used_sig: set[tuple[str, ...]]) -> dict | None:
+    choices = [item for item in pool if item["raw_key"] not in used_raw and item["sig"] not in used_sig]
+    if not choices:
+        return None
+    item = random.choice(choices)
