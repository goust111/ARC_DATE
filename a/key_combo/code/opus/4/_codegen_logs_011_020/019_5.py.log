+    return tuple("".join("1" if bool(cell) else "0" for cell in row) for row in mask)
+
+
+def _dihedral_signature(mask: np.ndarray) -> tuple[str, ...]:
+    base = _tight_mask(mask)
+    variants: list[tuple[str, ...]] = []
+    for k in range(4):
