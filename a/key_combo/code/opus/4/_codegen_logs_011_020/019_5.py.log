+                "id": idx,
+                "mask": mask,
+                "raw_key": _mask_key(mask),
+                "tight_key": _mask_key(tight),
+                "sig": _dihedral_signature(tight),
+                "sheared": sheared,
+                "shear_key": _mask_key(sheared),
+                "shear_sig": _dihedral_signature(sheared),
+            }
+        )
+        idx += 1
+    return candidates
+
+
+CANDIDATES = _enumerate_candidates()
