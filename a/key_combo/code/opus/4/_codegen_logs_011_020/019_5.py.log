+                "pos": pos,
+                "mask": mask,
+                "tight_key": _mask_key(tight),
+                "sig": sig,
+                "match": sig in edge_shear_sigs,
+                "no_shear_match": sig in edge_unsheared_sigs,
+                "exact_shear_match": _mask_key(tight) in edge_shear_keys,
+            }
+        )
