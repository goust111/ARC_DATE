+        if picked_green is None:
+            continue
+        inner.extend(picked_green)
+
+        red_seed = _choose_one(false_positive, used_raw, used_sig)
+        if red_seed is None:
+            continue
+        inner.append(red_seed)
+
+        more_red = len(INNER_POSITIONS) - len(inner)
+        picked_red = _choose_many(unmatched, more_red, used_raw, used_sig)
+        if picked_red is None:
+            continue
+        inner.extend(picked_red)
+
+        if len(inner) != len(INNER_POSITIONS):
+            continue
+        random.shuffle(inner)
+        return inner
+    return None
+
