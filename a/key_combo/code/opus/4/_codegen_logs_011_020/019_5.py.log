+    return {
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "cells": cells,
+        "edge_shear_sigs": edge_shear_sigs,
+        "edge_unsheared_sigs": edge_unsheared_sigs,
+        "edge_shear_keys": edge_shear_keys,
+        "inner": inner,
