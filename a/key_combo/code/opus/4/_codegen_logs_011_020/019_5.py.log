+    for (ri, ci), item in assignments.items():
+        r0 = 1 + ri * (CELL_SIZE + 1)
+        c0 = 1 + ci * (CELL_SIZE + 1)
+        patch = grid[r0 : r0 + CELL_SIZE, c0 : c0 + CELL_SIZE]
