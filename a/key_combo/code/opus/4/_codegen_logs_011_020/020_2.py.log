+    mask = np.zeros((height, width), dtype=bool)
+    mask[:, 0] = True
+    start = random.randint(2, width - 1)
+    mask[0, start:width] = True
+    return mask
+
+
+def _asym_three_corners(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
