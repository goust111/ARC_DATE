from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/4/015/6.py')
mod = SourceFileLoader('arc0156_semantic', str(p)).load_module()

BLACK, BLUE, RED, GREEN = 0, 1, 2, 3
BLOCK = 3

def oracle(grid: np.ndarray) -> np.ndarray:
    blue = np.zeros((3, 3), dtype=bool)
    marks = np.zeros((3, 3), dtype=bool)
    for br in range(3):
        for bc in range(3):
            block = grid[br*BLOCK:(br+1)*BLOCK, bc*BLOCK:(bc+1)*BLOCK]
            blue[br, bc] = np.any(block == BLUE)
            marks[br, bc] = np.any(block == RED)
    template = np.where(~blue, GREEN, BLACK).astype(int)
    out = np.zeros((9, 9), dtype=int)
    for br in range(3):
        for bc in range(3):
            if marks[br, bc]:
                patch = out[br*BLOCK:(br+1)*BLOCK, bc*BLOCK:(bc+1)*BLOCK]
                patch[template == GREEN] = GREEN
    return out

seen_outputs = {}
mark_counts = set()
blue_counts = set()
for i in range(250):
    inp = mod.generate_input()
    out = mod.main(inp)
    exp = oracle(inp)
    assert np.array_equal(out, exp), f'oracle mismatch on sample {i}'

    coarse_blue = np.zeros((3, 3), dtype=bool)
    coarse_red = np.zeros((3, 3), dtype=bool)
    for br in range(3):
        for bc in range(3):
            block = inp[br*BLOCK:(br+1)*BLOCK, bc*BLOCK:(bc+1)*BLOCK]
            coarse_blue[br, bc] = np.any(block == BLUE)
            coarse_red[br, bc] = np.any(block == RED)
            assert np.count_nonzero(block == RED) <= 1
    assert np.any(coarse_red & coarse_blue)
    assert np.any(coarse_red & ~coarse_blue)
    assert 0 < np.count_nonzero(coarse_blue) < 9
    assert 2 <= np.count_nonzero(coarse_red) <= 4

    mark_counts.add(int(np.count_nonzero(coarse_red)))
    blue_counts.add(int(np.count_nonzero(coarse_blue)))

    out_sig = hashlib.md5(out.tobytes()).hexdigest()
    inp_sig = hashlib.md5(inp.tobytes()).hexdigest()
    if out_sig in seen_outputs:
        assert seen_outputs[out_sig] == inp_sig, 'distinct inputs collapsed to the same output'
    else:
        seen_outputs[out_sig] = inp_sig

print('semantic_samples', 250)
print('mark_counts', sorted(mark_counts))
print('blue_counts', sorted(blue_counts))
print('unique_outputs', len(seen_outputs))
assert mark_counts == {2, 3, 4}
assert len(blue_counts) >= 5
