+    for r, c in source_cells:
+        out[r, c] = Color.GREEN
+    for r, c in dest_cells:
+        assert in_bounds(g.shape, r, c), "rotated arm left the grid"
+        assert int(g[r, c]) not in {Color.BLUE, Color.GREY}, "rotated arm cannot overwrite tokens or pivots"
+        out[r, c] = Color.RED
+
+    return out
