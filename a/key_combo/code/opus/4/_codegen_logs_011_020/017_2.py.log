+def _rotate_clockwise(dr: int, dc: int, quarter_turns: int) -> tuple[int, int]:
+    turns = int(quarter_turns) % 4
+    for _ in range(turns):
+        dr, dc = dc, -dr
+    return int(dr), int(dc)
