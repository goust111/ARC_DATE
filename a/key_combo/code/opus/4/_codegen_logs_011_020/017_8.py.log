+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+RANK_COLORS = (ORANGE, PINK, YELLOW)
+
+GENERATION_RETRIES = 500
+GRID_ROWS = (15, 20)
+GRID_COLS = (15, 20)
+WINDOW_RANDOM_TRIALS = 700
