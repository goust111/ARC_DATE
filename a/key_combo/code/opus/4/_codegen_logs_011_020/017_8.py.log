+        half_w = random.randint(2, 4)
+        axis = half_w - 1
+        mid_rows = h - 2
+        widths = [random.randint(1, axis)]
+        for _ in range(mid_rows - 1):
+            prev = widths[-1]
+            choices = [cand for cand in (prev - 1, prev, prev + 1) if 1 <= cand <= axis]
+            widths.append(random.choice(choices))
+        if random.random() < 0.5:
