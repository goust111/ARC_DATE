+
+
+def _choose_markers(window: tuple[int, int, int, int], blocked: np.ndarray) -> list[tuple[int, int]] | None:
+    H, W = blocked.shape
+    r0, c0, r1, c1 = window
+    if not (1 <= r0 <= r1 <= H - 2 and 1 <= c0 <= c1 <= W - 2):
+        return None
