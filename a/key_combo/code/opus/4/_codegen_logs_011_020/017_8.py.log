+    for _ in range(WINDOW_RANDOM_TRIALS):
+        r0 = random.randint(1, H - 2)
+        r1 = random.randint(r0, H - 2)
+        c0 = random.randint(1, W - 2)
+        c1 = random.randint(c0, W - 2)
+        consider((r0, c0, r1, c1))
