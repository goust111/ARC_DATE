+def _random_free_rect(occupied: np.ndarray, h: int, w: int, *, border: int = 1, padding: int = 1) -> tuple[int, int] | None:
+    H, W = occupied.shape
+    candidates: list[tuple[int, int]] = []
+    r_stop = H - h - border
+    c_stop = W - w - border
+    if r_stop < border or c_stop < border:
