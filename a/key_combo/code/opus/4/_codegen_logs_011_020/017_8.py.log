44: def main(grid: np.ndarray) -> np.ndarray:
45:     """
46:     Recolor the largest rectangular black pocket(s) in each black component red.
47: 
48:     Input structure
49:     - The input is a grey field with black empty regions; no red pixels are
50:       present initially.
51:     - Black regions are interpreted as 4-connected components.
52:     - Some black components contain a solid rectangular subregion with both
53:       height and width at least 2.
54: 
55:     Rule
56:     - For each 4-connected black component, enumerate all solid all-black
57:       rectangles with height >= 2 and width >= 2.
58:     - If a component contains such rectangles, recolor every maximum-area
59:       rectangle in that component to red.
60:     - Leave grey pixels and black cells outside those selected rectangles
61:       unchanged.
62: 
63:     Key insight
64:     - The output is not the union of every black 2x2 square; within each black
65:       component, smaller overlapping rectangles are ignored unless they tie for
66:       the largest area.
67:     """
68:     g = np.asarray(grid, dtype=int)
69:     colors = set(map(int, np.unique(g)))
70:     assert colors == {Color.BLACK, Color.GREY}, "expected only black empty regions on a grey field"
71: 
72:     out = g.copy()
73:     selected = np.zeros(g.shape, dtype=bool)
