+            "fill_mask": fill_mask,
+            "h": h,
+            "half_w": half_w,
+            "full_w": fill_mask.shape[1],
+            "area": int(fill_mask.sum()),
+            "fill_bbox_local": fill_bbox,
+        }
+    raise RuntimeError("failed to build half-shape")
