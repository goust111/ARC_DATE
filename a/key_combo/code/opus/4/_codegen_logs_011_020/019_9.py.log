+        extra_red = random.choice(red_candidates)
+        red_markers.append(extra_red)
+        used.add(extra_red)
+
+    blue_markers = list(blue_pair)
+    if blue_total == 3:
+        blue_candidates = [
+            cell
+            for cell in free
+            if cell not in blocked
+            and cell not in used
+            and cell[0] != cross_r
+            and cell[1] != cross_c
+        ]
+        if not blue_candidates:
