    col_pairs = _gen_pairs(tile_cols, GEN_COL_SPAN_MIN, GEN_COL_SPAN_MAX)

    if marker_count == 1:
        return [(random.choice(row_pairs), random.choice(col_pairs))]

    row_pair_choices = [
        (a, b)
        for i, a in enumerate(row_pairs)
