def _validate_semantics(grid: np.ndarray, expected: np.ndarray) -> bool:
    try:
        bg = _dominant_color(grid)
        sep_rows = _separator_rows(grid, bg)
        if len(sep_rows) != 2:
            return False
        top_sep, bottom_sep = sep_rows
