    sprite = sprite_mask[r0 : r1 + 1, c0 : c1 + 1]
    h, w = sprite.shape

    dr, dc = stem
    copy_dr, copy_dc = -dc, dr
    if copy_dr:
        reflected = np.flipud(sprite)
        target_r = r1 + 1 if copy_dr > 0 else r0 - h
        target_c = c0
    else:
        assert copy_dc
        reflected = np.fliplr(sprite)
        target_r = r0
        target_c = c1 + 1 if copy_dc > 0 else c0 - w

