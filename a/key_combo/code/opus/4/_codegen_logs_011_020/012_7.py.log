+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+SEP = 6
+GREEN = 3
+YELLOW = 4
+
+CELL = 3
+GAP = 1
+PITCH = CELL + GAP
+TABLE_DIM = 3
+TABLE_SPAN = TABLE_DIM * CELL + (TABLE_DIM - 1) * GAP
+
+GLYPH_COLORS = (1, 2, 5, 7, 9)
+TOP_BAND_H = 3
+BOTTOM_BAND_RANGE = (6, 8)
+WIDTH_RANGE = (16, 24)
+MAX_RETRIES = 400
+
+
+def _dominant_color(grid: np.ndarray) -> int:
+    values = np.asarray(grid, dtype=int).ravel()
+    counts = np.bincount(values, minlength=12)
+    return int(np.argmax(counts))
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _shape_is_connected(mask: np.ndarray) -> bool:
+    return len(_components(mask.astype(bool))) == 1
+
+
+def _full_bbox_shape(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _all_glyph_shapes() -> list[np.ndarray]:
