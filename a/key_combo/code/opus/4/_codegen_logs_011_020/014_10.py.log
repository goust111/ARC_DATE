+            assert target is not None
+            hits[target].add(color)
+        color = int(g[h - 1, c])
+        if color != BACKGROUND:
+            target = _trace_first_hit(labels, h - 1, c, -1, 0)
+            assert target is not None
+            hits[target].add(color)
+    for r in range(1, h - 1):
+        color = int(g[r, 0])
+        if color != BACKGROUND:
+            target = _trace_first_hit(labels, r, 0, 0, 1)
+            assert target is not None
+            hits[target].add(color)
+        color = int(g[r, w - 1])
+        if color != BACKGROUND:
+            target = _trace_first_hit(labels, r, w - 1, 0, -1)
+            assert target is not None
