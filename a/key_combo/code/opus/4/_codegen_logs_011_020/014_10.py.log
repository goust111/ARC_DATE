+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert int(g[0, 0]) == BACKGROUND
+    assert int(g[0, -1]) == BACKGROUND
+    assert int(g[-1, 0]) == BACKGROUND
+    assert int(g[-1, -1]) == BACKGROUND
