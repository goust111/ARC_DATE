+
+    expected = _independent_expected(g)
+    actual = main(g)
+    assert np.array_equal(actual, expected)
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
+    width = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
