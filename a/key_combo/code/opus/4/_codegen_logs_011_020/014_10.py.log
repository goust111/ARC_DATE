  17: def main(input_grid):
  18:     """
  19:     Find and color a constrained path from the green start line to the red end line.
  20: 
  21:     Input structure:
  22:     - A black grid contains teal barrier pixels.
  23:     - A short green horizontal or vertical line gives the starting location and initial travel direction.
  24:     - A short red line marks the destination.
  25: 
  26:     Rule:
  27:     - Run breadth-first search over position plus direction states.
  28:     - Move straight through black cells and turn only when a teal pixel blocks the next step.
  29:     - Stop when the next cell in the current direction is red, then color the recovered path green.
  30: 
  31:     Key insight:
  32:     - Teal pixels are not passable walls; they are turn triggers that define where the path may change direction.
  33:     """
  34:     # Plan:
  35:     # 1. Find the start and end points of the pathfinding problem
  36:     # 2. Define the state space, initial state(s), successor function, and goal test
  37:     # 3. Run bfs to find the shortest path from start to end
  38:     # 4. Color the path green
  39: 
  40:     # 1. Parse the input, based on color
  41:     # There is the start object, end object, and barriers object
  42:     background = Color.BLACK
  43:     start_object = input_grid.copy()
  44:     start_object[start_object != Color.GREEN] = background
  45:     end_object = input_grid.copy()
  46:     end_object[end_object != Color.RED] = background
  47:     barriers_object = input_grid.copy()
  48:     barriers_object[barriers_object != Color.TEAL] = background
  49: 
  50:     # Determine the orientation of the start object
  51:     r_coordinates = {r for r, c in np.argwhere(start_object == Color.GREEN)}
  52:     c_coordinates = {c for r, c in np.argwhere(start_object == Color.GREEN)}
  53:     # vertical line?
  54:     if len(r_coordinates) == 1:
  55:         possible_orientations = [(0, 1), (0, -1)]
  56:     # horizontal line?
  57:     elif len(c_coordinates) == 1:
  58:         possible_orientations = [(1, 0), (-1, 0)]
  59:     else:
  60:         assert False, "Start object is not horizontal/vertical"
  61:     
  62:     # 2. Define the state space, initial state(s), successor function, and goal test
  63:     # A state is a tuple of (x, y, orientation)
  64:     # orientation is a tuple of (dx, dy)
  65:         
  66:     # Initially we begin at a point on the line, along the orientation of the line
  67:     initial_states = [(r, c, orientation)
  68:                       for r, c in np.argwhere(start_object == Color.GREEN)
  69:                       for orientation in possible_orientations]
  70:     
  71: 
  72:     def successors(state):
  73:         r, c, orientation = state
  74:         dr, dc = orientation
  75: 
  76:         if not (0 <= r + dr < input_grid.shape[0] and 0 <= c + dc < input_grid.shape[1]):
  77:             return
  78: 
  79:         if barriers_object[r + dr, c + dc] == background:
  80:             yield (r + dr, c + dc, orientation)
  81:         if barriers_object[r + dr, c + dc] != background:
  82:             # right angle turns
  83:             new_orientations = [(dc, dr), (-dc, -dr)]
  84:             for new_orientation in new_orientations:
  85:                 yield (r, c, new_orientation)
  86:     
  87:     def is_goal(state):
  88:         r, c, (dr, dc) = state
  89:         if not (0 <= r + dr < end_object.shape[0] and 0 <= c + dc < end_object.shape[1]):
  90:             return False
  91:         return end_object[r + dr, c + dc] == Color.RED
  92:     
  93:     # 3. Run bfs to find the shortest path from start to end
  94:     queue = list(initial_states)
  95:     visited = set(initial_states)
  96:     parent = {}
  97:     while queue:
  98:         state = queue.pop(0)        
  99:         if is_goal(state):
 100:             break        
 101:         for successor in successors(state):
 102:             if successor not in visited:
 103:                 visited.add(successor)
 104:                 parent[successor] = state
 105:                 queue.append(successor)
 106: 
 107:     assert is_goal(state), "No path found"
 108:     
 109:     path = []
 110:     while state in parent:
 111:         path.append(state)
 112:         state = parent[state]
 113: 
 114:     # 4. Color the path green
 115:     # draw on top of the input grid
 116:     output_grid = input_grid.copy()
 117:     for r, c, _ in path:
 118:         output_grid[r, c] = Color.GREEN
 119: 
 120:     return output_grid
 121: 
 122: def generate_input():
 123:     # We want to first generate a successful path and add some noise teal pixels.
 124:     # Finally, we will remove the intermediate pixels in the path.
 125:     # Because the problem never uses the color 42, we will draw the path in that color, but finally erase it before returning the grid.
 126: 
 127:     # Initialize grid
 128:     n = random.randint(14, 20)
 129:     grid = np.zeros((n, n), dtype=int)
 130: 
 131:     # Start sprite: a 1x2 green line (we rotate the final grid for variety).
 132:     start_sprite = np.full((1, 2), Color.GREEN, dtype=int)
 133: 
 134:     # Draw start sprite
 135:     start_r, start_c = random_free_location(grid, start_sprite, transparent=Color.BLACK, border=4, padding=0, padding_connectivity=8)
 136:     paste(grid, start_sprite, start_r, start_c, transparent=Color.BLACK, clip=True)
 137: 
 138:     # Make a random path from the start to the end, leaving color 42 along the path, and leaving teal pixels at each turn
 139:     r,c = start_r, start_c-1
 140:     orientation = (0, -1)
 141:     target_length = random.randint(10, 20)
 142:     for _ in range(target_length):
 143:         # Draw the path
 144:         if grid[r, c] != Color.BLACK:
 145:             return generate_input()
 146:         grid[r, c] = 42        
 147: 
 148:         if random.random() < 0.2:
 149:             # right angle turn
 150:             dr, dc = orientation
 151:             new_orientation = random.choice([(dc, dr), (-dc, -dr)])
 152:             rr = r + dr
 153:             cc = c + dc
 154:             if rr < 0 or rr >= n or cc < 0 or cc >= n:
 155:                 return generate_input()
 156:             if grid[rr, cc] != Color.BLACK:
 157:                 return generate_input()
 158:             grid[rr, cc] = Color.TEAL
 159:             orientation = new_orientation
 160:         
 161:         dr, dc = orientation
 162:         r += dr
 163:         c += dc
 164: 
 165:         if r < 0 or r >= n or c < 0 or c >= n: return generate_input()
 166:     
 167:     # Color the ending red
 168:     grid[r, c] = Color.RED
 169:     grid[r-dr, c-dc] = Color.RED
 170: 
 171:     # randomly sprinkle teal in unoccupied locations
 172:     for r, c in np.argwhere(grid == Color.BLACK):
 173:         if random.random() < 0.3:
 174:             grid[r, c] = Color.TEAL
 175: 
 176:     # Replace the path with black
 177:     grid[grid == 42] = Color.BLACK
 178: 
 179:     # Randomly rotate
 180:     grid = np.rot90(grid, k=-(random.randint(0, 3)))
 181: 
 182:     return grid

