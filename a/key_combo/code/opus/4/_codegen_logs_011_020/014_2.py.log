+        "tl": [(r, c) for r in top_rows for c in left_cols],
+        "tr": [(r, c) for r in top_rows for c in right_cols],
+        "bl": [(r, c) for r in bottom_rows for c in left_cols],
+        "br": [(r, c) for r in bottom_rows for c in right_cols],
