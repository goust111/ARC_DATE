+def _gen_attempt() -> np.ndarray | None:
+    half_h = random.randint(HALF_MIN, HALF_MAX)
+    half_w = random.randint(HALF_MIN, HALF_MAX)
+    height = 2 * half_h + 1
+    width = 2 * half_w + 1
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[half_h, :] = Color.GREY
+    grid[:, half_w] = Color.GREY
