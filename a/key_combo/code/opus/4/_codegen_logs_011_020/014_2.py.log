                    available.append(center)
        if not available:
            return None
        pick = random.choice(available)
        placed.append(pick)
        placed_boxes.append(_marker_box(pick))

    random.shuffle(placed)
    return placed


def _expected_output_from_spec(grid: np.ndarray) -> np.ndarray:
