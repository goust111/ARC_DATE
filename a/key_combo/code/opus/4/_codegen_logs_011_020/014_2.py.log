+def _validate_input(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.BLUE, Color.RED, Color.GREY}
+
+    div_r, div_c = _divider_indices(g)
