+from arc_utils import Color, components_mask, paste
+
+
+SPRITE_SIZE = 3
+SPRITE_BOX = (0, 0, 2, 2)
+HALF_MIN = 6
+HALF_MAX = 12
+MARKER_MIN = 4
+MARKER_MAX = 8
+GEN_ATTEMPTS = 400
+QUADRANTS = ("tl", "tr", "bl", "br")
