+def _extract_sprite(grid: np.ndarray) -> np.ndarray:
+    sprite = np.where(grid[:SPRITE_SIZE, :SPRITE_SIZE] == Color.BLUE, Color.BLUE, Color.BLACK)
+    return sprite.astype(int)
