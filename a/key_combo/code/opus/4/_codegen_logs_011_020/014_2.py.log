+def _place_markers(half_h: int, half_w: int, total_markers: int) -> list[tuple[int, int]] | None:
+    candidates = _candidate_centers(half_h, half_w)
+    placed: list[tuple[int, int]] = []
+    placed_boxes: list[tuple[int, int, int, int]] = []
