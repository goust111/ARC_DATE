+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+
+_THIS_FILE = Path(__file__).resolve()
+for _parent in (_THIS_FILE.parent, *_THIS_FILE.parents):
+    _candidate = _parent / "new" / "solvers"
