+    center_off: list[np.ndarray] = []
+    for bits in range(1 << (SPRITE_SIZE * SPRITE_SIZE)):
+        area = bits.bit_count()
+        if area < 3 or area > 5:
+            continue
+        flat = np.array([(bits >> idx) & 1 for idx in range(SPRITE_SIZE * SPRITE_SIZE)], dtype=int)
+        mask = flat.reshape(SPRITE_SIZE, SPRITE_SIZE)
