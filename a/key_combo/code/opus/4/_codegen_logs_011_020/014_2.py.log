+                    out[r + dr, c + dc] = Color.BLUE
+
+    out[div_r, :] = Color.GREY
+    out[:, div_c] = Color.GREY
+    out[:SPRITE_SIZE, :SPRITE_SIZE] = g[:SPRITE_SIZE, :SPRITE_SIZE]
+    return out
+
