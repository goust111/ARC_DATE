    out[:, div_c] = Color.GREY
    out[:SPRITE_SIZE, :SPRITE_SIZE] = g[:SPRITE_SIZE, :SPRITE_SIZE]
    return out


def _validate_input(grid: np.ndarray) -> None:
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    assert max(g.shape) <= 30
