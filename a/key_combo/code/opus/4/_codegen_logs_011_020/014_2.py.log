+def _quadrant_name(r: int, c: int, div_r: int, div_c: int) -> str:
+    if r < div_r and c < div_c:
+        return "tl"
+    if r < div_r and c > div_c:
+        return "tr"
+    if r > div_r and c < div_c:
+        return "bl"
+    return "br"
+
