            del current[best_cell]
        return None

    solved = search({})
    if solved is None:
        return None

    lattice = np.zeros((r_count, c_count), dtype=int)
    for cell, color in solved.items():
        lattice[cell] = color
    return lattice


def _build_sparse_grid(lattice):
    grid = np.zeros((2 * lattice.shape[0] + 1, 2 * lattice.shape[1] + 1), dtype=int)
