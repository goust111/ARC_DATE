    except Exception:
        return False


def _gen_attempt() -> np.ndarray | None:
    nr = random.randint(MIN_PANEL_COUNT, MAX_PANEL_COUNT)
    nc = random.randint(MIN_PANEL_COUNT, MAX_PANEL_COUNT)
