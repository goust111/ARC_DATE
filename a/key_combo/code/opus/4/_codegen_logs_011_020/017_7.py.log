+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+TILE_COLOR_POOL = (1, 2, 4, 5, 6, 7, 8, 9)
+
+GEN_RETRIES = 400
+GRID_SIDE_RANGE = (10, 12)
+TOKEN_COUNTS = (2, 3, 4)
+TILE_SIDES = (3, 4)
+OFFSETS = (0, 1)
+
+
+def _neighbors4(shape: tuple[int, int], r: int, c: int):
+    h, w = map(int, shape)
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    """4-connected components of a boolean mask, following arc_utils (r, c) conventions."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((int(cr), int(cc)))
+            for nr, nc in _neighbors4(mask.shape, cr, cc):
+                if mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((int(nr), int(nc)))
+        comps.append(coords)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, bbox)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = map(int, patch.shape)
+    dst[int(r0) : int(r0) + h, int(c0) : int(c0) + w] = patch
+
