   150	            out_bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
   151	            in_bbox = (r0 - dr, c0 - dc, r0 - dr + h - 1, c0 - dc + w - 1)
   152	            boxes.append((out_bbox, in_bbox))
   153	    random.shuffle(boxes)
   154	    return boxes
