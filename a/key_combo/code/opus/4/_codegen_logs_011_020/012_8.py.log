    16	def main(grid: np.ndarray) -> np.ndarray:
    17	    """Extend a solid rectangle's color along outward diagonals after they pass through frame corners.
    18	    Input structure
    19	    The grid has a dominant background, one solid rectangular foreground object, and one one-cell-thick orthogonal frame object in a different color.
    20	    Rule
    21	    From each outer corner of the solid rectangle, trace the outward diagonal; if the first non-background pixel on that ray is a corner of the frame, continue past that frame pixel and paint every remaining background pixel on the same diagonal with the rectangle color.
    22	    Key insight
    23	    The frame corner selects which rectangle-corner diagonals are active, and the interior/background part of the ray before the frame is left unchanged.
    24	    """
    25	    g = np.asarray(grid, dtype=int)
    26	    bg = get_bg(g)
    27	    colors = colors_present(g, exclude={bg})
    28	    assert len(colors) == 2
    29	
    30	    bboxes = {}
    31	    solid_colors = []
    32	    for color in colors:
    33	        mask = g == color
    34	        box = bbox(mask)
    35	        assert box is not None
    36	        bboxes[color] = box
    37	        if int(mask.sum()) == bbox_h(box) * bbox_w(box):
    38	            solid_colors.append(color)
    39	    assert len(solid_colors) == 1
    40	
    41	    src_color = solid_colors[0]
    42	    frame_color = next(color for color in colors if color != src_color)
    43	    frame_mask = g == frame_color
    44	    out = g.copy()
    45	
    46	    r0, c0, r1, c1 = bboxes[src_color]
    47	    corner_rays = [
    48	        ((r0, c0), (-1, -1)),
    49	        ((r0, c1), (-1, 1)),
    50	        ((r1, c0), (1, -1)),
    51	        ((r1, c1), (1, 1)),
    52	    ]
    53	
    54	    active_rays = 0
    55	    for (r, c), (dr, dc) in corner_rays:
    56	        rr, cc = r + dr, c + dc
    57	        while in_bounds(g.shape, rr, cc) and g[rr, cc] == bg:
    58	            rr += dr
    59	            cc += dc
    60	
    61	        if not in_bounds(g.shape, rr, cc):
    62	            continue
    63	        if g[rr, cc] != frame_color or not _is_frame_corner(frame_mask, rr, cc):
    64	            continue
    65	
    66	        active_rays += 1
    67	        rr += dr
    68	        cc += dc
    69	        painted = 0
    70	        while in_bounds(g.shape, rr, cc):
    71	            assert g[rr, cc] == bg
    72	            out[rr, cc] = src_color
    73	            painted += 1
    74	            rr += dr
    75	            cc += dc
    76	        assert painted > 0
    77	
    78	    assert active_rays > 0
    79	    return out
