   238	def _gen_span_layouts(axis, h, w, ncomp, area):
   239	    if axis == "vertical":
   240	        extent, cross = w, h
   241	    else:
   242	        extent, cross = h, w
   243	
   244	    if extent < ncomp + _GEN_COMPONENT_GAP * (ncomp - 1):
   245	        return []
   246	
   247	    layouts = []
   248	    available = extent - _GEN_COMPONENT_GAP * (ncomp - 1)
   249	    for spans in _gen_positive_parts(available, ncomp):
   250	        lows = [cross + span - 1 for span in spans]
   251	        highs = [cross * span for span in spans]
   252	        for sizes in _gen_size_splits(area, lows, highs):
   253	            layouts.append((axis, spans, sizes))
   254	    return layouts
