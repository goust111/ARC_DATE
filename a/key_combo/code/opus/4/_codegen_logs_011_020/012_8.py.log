+        (fr0, fc1),
+        (fr1, fc0),
+        (fr1, fc1),
+    }
+    rays = [
+        ("tl", (sr0, sc0), (-1, -1)),
+        ("tr", (sr0, sc1), (-1, 1)),
+        ("bl", (sr1, sc0), (1, -1)),
+        ("br", (sr1, sc1), (1, 1)),
