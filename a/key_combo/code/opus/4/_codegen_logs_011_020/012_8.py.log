    20	def _marker_stem_direction(g: np.ndarray, color: int) -> tuple[int, int] | None:
    21	    mask = g == color
    22	    coords = np.argwhere(mask)
    23	
    24	    junctions = []
    25	    for r_raw, c_raw in coords:
    26	        r = int(r_raw)
    27	        c = int(c_raw)
    28	        degree = sum(
    29	            in_bounds(mask.shape, r + dr, c + dc) and mask[r + dr, c + dc]
    30	            for dr, dc in _DIRS
    31	        )
    32	        if degree >= 3:
    33	            junctions.append((r, c))
    34	    if len(junctions) != 1:
    35	        return None
    36	
    37	    jr, jc = junctions[0]
    38	    if any(int(r) != jr and int(c) != jc for r, c in coords):
    39	        return None
    40	
    41	    lengths = [_arm_length(mask, jr, jc, dr, dc) for dr, dc in _DIRS]
    42	    longest = max(lengths)
    43	    if longest == 0 or lengths.count(longest) != 1:
    44	        return None
    45	    return _DIRS[lengths.index(longest)]
