   226	def _gen_paint_trails(out, n, r0, c0, active, color):
   227	    trail_cells = []
   228	    for rr, cc, dr, dc in active:
   229	        r, c = r0 + rr + dr, c0 + cc + dc
   230	        while 0 <= r < n and 0 <= c < n:
