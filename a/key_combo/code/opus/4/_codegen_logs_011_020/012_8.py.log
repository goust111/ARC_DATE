   157	def _overlaps_placed(out_bbox: _BBox, in_bbox: _BBox, placed: list[dict[str, int | _BBox] | None], n: int) -> bool:
   158	    out_with_gap = _expand_bbox(out_bbox, n)
   159	    for other in placed:
   160	        if other is None:
   161	            continue
   162	        if _bbox_intersects(out_with_gap, other["out_bbox"]):
   163	            return True
   164	        if _bbox_intersects(in_bbox, other["in_bbox"]):
   165	            return True
   166	    return False
