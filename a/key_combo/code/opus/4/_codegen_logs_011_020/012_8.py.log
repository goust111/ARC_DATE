     7	def _is_frame_corner(frame_mask: np.ndarray, r: int, c: int) -> bool:
     8	    h, w = frame_mask.shape
     9	    up = r > 0 and frame_mask[r - 1, c]
    10	    down = r + 1 < h and frame_mask[r + 1, c]
    11	    left = c > 0 and frame_mask[r, c - 1]
    12	    right = c + 1 < w and frame_mask[r, c + 1]
