   225	def _gen_component_layouts(h, w, ncomp, area):
   226	    if ncomp == 1:
   227	        low = h + w - 1
   228	        if low <= area <= h * w:
   229	            return [("single", (w,), (area,))]
   230	        return []
   231	
   232	    layouts = []
   233	    layouts.extend(_gen_span_layouts("vertical", h, w, ncomp, area))
   234	    layouts.extend(_gen_span_layouts("horizontal", h, w, ncomp, area))
   235	    return layouts
