   152	    copy_dirs = [d for d in _GEN_COPY_DIRS if (d[0] and 2 * h <= H) or (d[1] and 2 * w <= W)]
   153	    if not copy_dirs:
   154	        return None
   155	    return _gen_choice(rng, copy_dirs)
