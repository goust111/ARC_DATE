   170	def _gen_size_splits(total, lows, highs):
   171	    if len(lows) == 1:
   172	        if lows[0] <= total <= highs[0]:
   173	            return [(int(total),)]
   174	        return []
   175	    out = []
   176	    lo = lows[0]
   177	    hi = highs[0]
   178	    rest_low = sum(lows[1:])
   179	    rest_high = sum(highs[1:])
   180	    for first in range(lo, hi + 1):
   181	        if rest_low <= total - first <= rest_high:
   182	            for rest in _gen_size_splits(total - first, lows[1:], highs[1:]):
   183	                out.append((int(first),) + rest)
   184	    return out
