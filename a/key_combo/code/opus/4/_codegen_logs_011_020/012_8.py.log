     9	def _rectangle_moves(g: np.ndarray, bg: int) -> list[tuple[int, int, int, int, int, int, int]]:
    10	    marker = Color.TEAL
    11	    marker_coords = {tuple(map(int, p)) for p in np.argwhere(g == marker)}
    12	    assert marker_coords, "expected at least one teal control pixel"
    13	
    14	    moves: list[tuple[int, int, int, int, int, int, int]] = []
    15	    used_markers: set[tuple[int, int]] = set()
    16	    colors = colors_present(g, exclude={bg, marker})
    17	
    18	    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=colors):
    19	        color = int(comp["color"])
    20	        r0, c0, r1, c1 = map(int, comp["bbox"])
    21	        region = g[r0 : r1 + 1, c0 : c1 + 1]
    22	        h, w = region.shape
    23	
    24	        marks = np.argwhere(region == marker)
    25	        assert marks.shape == (1, 2), "each colored rectangle has one teal corner"
    26	        mr, mc = map(int, marks[0])
    27	        assert mr in (0, h - 1) and mc in (0, w - 1), "teal pixel must be a rectangle corner"
    28	
    29	        expected = np.full((h, w), color, dtype=int)
    30	        expected[mr, mc] = marker
    31	        assert np.array_equal(region, expected), "teal corner must complete a filled rectangle"
    32	
    33	        dr = -1 if mr == 0 else 1
    34	        dc = -1 if mc == 0 else 1
    35	        tr0, tr1 = r0 + dr, r1 + dr
    36	        tc0, tc1 = c0 + dc, c1 + dc
    37	        H, W = g.shape
    38	        assert 0 <= tr0 <= tr1 < H and 0 <= tc0 <= tc1 < W, "shifted rectangle must stay in bounds"
    39	
    40	        used_markers.add((r0 + mr, c0 + mc))
    41	        moves.append((r0, c0, r1, c1, color, dr, dc))
    42	
    43	    assert used_markers == marker_coords, "every teal control pixel must belong to one rectangle"
    44	    return moves
