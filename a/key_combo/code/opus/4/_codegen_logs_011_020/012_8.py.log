    47	def main(grid: np.ndarray) -> np.ndarray:
    48	    """
    49	    Move each teal-cornered filled rectangle one cell diagonally toward its teal corner.
    50	
    51	    Input structure:
    52	    - Dominant background surrounds several filled rectangular colored objects.
    53	    - Each object has exactly one teal control pixel replacing one corner cell of
    54	      its rectangle.
    55	
    56	    Rule:
    57	    - Treat the teal pixel as the missing corner of its colored rectangle.
    58	    - Erase each original rectangle footprint, including the teal pixel.
    59	    - Repaint the completed rectangle shifted one cell diagonally in the direction
    60	      of that teal corner.
    61	
    62	    Key insight:
    63	    - The control pixel's corner position gives both the missing cell to restore
    64	      and the diagonal motion vector.
    65	    """
    66	    g = np.asarray(grid, dtype=int)
    67	    bg = get_bg(g)
    68	    moves = _rectangle_moves(g, bg)
    69	
    70	    out = g.copy()
    71	    for r0, c0, r1, c1, _color, _dr, _dc in moves:
    72	        out[r0 : r1 + 1, c0 : c1 + 1] = bg
    73	
    74	    occupied = np.zeros_like(g, dtype=bool)
    75	    for r0, c0, r1, c1, color, dr, dc in moves:
    76	        tr0, tr1 = r0 + dr, r1 + dr
    77	        tc0, tc1 = c0 + dc, c1 + dc
    78	        assert not occupied[tr0 : tr1 + 1, tc0 : tc1 + 1].any(), "shifted rectangles must not overlap"
    79	        assert np.all(out[tr0 : tr1 + 1, tc0 : tc1 + 1] == bg), "target region must be background"
    80	        out[tr0 : tr1 + 1, tc0 : tc1 + 1] = color
    81	        occupied[tr0 : tr1 + 1, tc0 : tc1 + 1] = True
    82	
    83	    return out
