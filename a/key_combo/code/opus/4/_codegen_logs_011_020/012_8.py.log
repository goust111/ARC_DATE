   206	def _gen_draw_frame(grid, kind, orient, r0, c0, h, w, color):
   207	    last_r = r0 + h - 1
   208	    last_c = c0 + w - 1
   209	    if kind == "L":
   210	        wall_r = last_r if orient in ("tl", "tr") else r0
   211	        wall_c = last_c if orient in ("tl", "bl") else c0
   212	        grid[wall_r, c0 : c0 + w] = color
   213	        grid[r0 : r0 + h, wall_c] = color
   214	    elif orient in ("top", "bottom"):
   215	        wall_r = last_r if orient == "top" else r0
   216	        grid[wall_r, c0 : c0 + w] = color
   217	        grid[r0 : r0 + h, c0] = color
   218	        grid[r0 : r0 + h, last_c] = color
   219	    else:
   220	        wall_c = last_c if orient == "left" else c0
   221	        grid[r0, c0 : c0 + w] = color
   222	        grid[last_r, c0 : c0 + w] = color
   223	        grid[r0 : r0 + h, wall_c] = color
