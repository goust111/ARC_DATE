     9	def _arm_length(mask: np.ndarray, r: int, c: int, dr: int, dc: int) -> int:
    10	    length = 0
    11	    rr = r + dr
    12	    cc = c + dc
    13	    while in_bounds(mask.shape, rr, cc) and mask[rr, cc]:
    14	        length += 1
    15	        rr += dr
    16	        cc += dc
