   221	    n = random.choice(_GRID_SIZES)
   222	    k = random.randint(*_RECT_COUNT_RANGE)
   223	    sizes = _choose_sizes(k, n)
   224	    if sizes is None:
   225	        return None
   226	
   227	    colors = random.sample(_RECT_COLORS, k)
   228	    rects: list[dict[str, int]] = []
   229	    for (h, w), color in zip(sizes, colors):
   230	        dr, dc = random.choice(_SHIFT_DIRS)
   231	        rects.append({"h": h, "w": w, "color": color, "dr": dr, "dc": dc})
