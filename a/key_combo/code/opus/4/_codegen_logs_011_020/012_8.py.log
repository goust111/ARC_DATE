   169	def _place_rectangles(rects: list[dict[str, int]], n: int) -> list[dict[str, int | _BBox]] | None:
   170	    placed: list[dict[str, int | _BBox] | None] = [None] * len(rects)
   171	    order = sorted(range(len(rects)), key=lambda i: rects[i]["h"] * rects[i]["w"], reverse=True)
   172	    node_budget = _PLACEMENT_NODE_BUDGET
   173	
   174	    def rec(pos: int) -> bool:
   175	        nonlocal node_budget
   176	        if pos == len(order):
   177	            return True
   178	        if node_budget <= 0:
   179	            return False
   180	        node_budget -= 1
   181	
   182	        i = order[pos]
   183	        rect = rects[i]
   184	        for out_bbox, in_bbox in _candidate_boxes(n, rect["h"], rect["w"], rect["dr"], rect["dc"]):
   185	            if _overlaps_placed(out_bbox, in_bbox, placed, n):
   186	                continue
   187	
   188	            placed[i] = {**rect, "out_bbox": out_bbox, "in_bbox": in_bbox}
   189	            if rec(pos + 1):
   190	                return True
   191	            placed[i] = None
   192	        return False
   193	
   194	    if not rec(0):
   195	        return None
   196	    return [p for p in placed if p is not None]
