   199	def _render_pair(placed: list[dict[str, int | _BBox]], n: int) -> tuple[np.ndarray, np.ndarray]:
   200	    out = np.full((n, n), _BG, dtype=int)
   201	    inp = np.full((n, n), _BG, dtype=int)
   202	
   203	    for rect in placed:
   204	        h, w = int(rect["h"]), int(rect["w"])
   205	        color = int(rect["color"])
   206	        dr, dc = int(rect["dr"]), int(rect["dc"])
   207	        out_r0, out_c0, _, _ = rect["out_bbox"]
   208	        in_r0, in_c0, _, _ = rect["in_bbox"]
   209	
   210	        completed = np.full((h, w), color, dtype=int)
   211	        paste(out, completed, int(out_r0), int(out_c0))
   212	
   213	        marked = completed.copy()
   214	        marked[0 if dr == -1 else h - 1, 0 if dc == -1 else w - 1] = _TEAL
   215	        paste(inp, marked, int(in_r0), int(in_c0))
   216	
   217	    return inp, out
