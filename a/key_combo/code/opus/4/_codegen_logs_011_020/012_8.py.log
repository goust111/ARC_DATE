   140	def _gen_sprite_dims(H, W, rng):
   141	    dims = []
   142	    for h in range(*_GEN_SPRITE_H_RANGE):
   143	        for w in range(*_GEN_SPRITE_W_RANGE):
   144	            if 2 * h <= H or 2 * w <= W:
   145	                dims.append((h, w))
   146	    if not dims:
   147	        return None
   148	    return _gen_choice(rng, dims)
