   243	    sr0, sc0, sr1, sc1 = solid
   244	    out[r0 + sr0 : r0 + sr1 + 1, c0 + sc0 : c0 + sc1 + 1] = solid_color
   245	
   246	    trail_cells = _gen_paint_trails(out, n, r0, c0, active, solid_color)
   247	
   248	    inp = out.copy()
   249	    for r, c in trail_cells:
   250	        inp[r, c] = BG_COLOR
   251	    return inp, out
