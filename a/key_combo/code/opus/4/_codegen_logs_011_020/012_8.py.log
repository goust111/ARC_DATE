    48	def main(grid: np.ndarray) -> np.ndarray:
    49	    """
    50	    Erase the cross marker and add a reflected adjacent copy of the other foreground sprite.
    51	
    52	    Input structure
    53	    - The background is the dominant color, and exactly two foreground colors are present.
    54	    - One foreground color forms the sprite to preserve and duplicate.
    55	    - The other foreground color forms a one-pixel-thick row/column marker with one junction and one uniquely longest arm.
    56	
    57	    Rule
    58	    - Interpret the marker's uniquely longest arm as a stem direction.
    59	    - Rotate that stem direction 90 degrees in row/column coordinates to choose the side of the sprite's bounding box.
    60	    - Mirror the sprite vertically for an above/below copy, or horizontally for a left/right copy, and paste it adjacent to that side.
    61	    - Output only the original sprite and its reflected copy; the marker is erased to background.
    62	
    63	    Key insight
    64	    - The marker is not a target location: its asymmetric arm encodes which adjacent side receives the mirrored sprite.
    65	    """
    66	    g = np.asarray(grid, dtype=int)
    67	    assert g.ndim == 2
    68	
    69	    bg = get_bg(g)
    70	    colors = colors_present(g, exclude={bg})
    71	    assert len(colors) == 2
    72	
    73	    marker_candidates = []
    74	    for color in colors:
    75	        stem = _marker_stem_direction(g, color)
    76	        if stem is not None:
    77	            marker_candidates.append((color, stem))
    78	    assert len(marker_candidates) == 1, "expected exactly one asymmetric cross marker"
    79	
    80	    marker_color, stem = marker_candidates[0]
    81	    sprite_colors = [color for color in colors if color != marker_color]
    82	    assert len(sprite_colors) == 1
    83	    sprite_color = sprite_colors[0]
    84	
    85	    sprite_mask = g == sprite_color
    86	    sprite_bbox = bbox(sprite_mask)
    87	    assert sprite_bbox is not None
    88	    r0, c0, r1, c1 = sprite_bbox
    89	    sprite = sprite_mask[r0 : r1 + 1, c0 : c1 + 1]
    90	    h, w = sprite.shape
    91	
    92	    dr, dc = stem
    93	    copy_dr, copy_dc = -dc, dr
    94	    if copy_dr:
    95	        reflected = np.flipud(sprite)
    96	        target_r = r1 + 1 if copy_dr > 0 else r0 - h
    97	        target_c = c0
    98	    else:
    99	        assert copy_dc
   100	        reflected = np.fliplr(sprite)
   101	        target_r = r0
   102	        target_c = c1 + 1 if copy_dc > 0 else c0 - w
   103	
   104	    H, W = g.shape
   105	    assert 0 <= target_r and 0 <= target_c
   106	    assert target_r + h <= H and target_c + w <= W
   107	
   108	    out = np.full_like(g, bg)
   109	    out[sprite_mask] = sprite_color
   110	    target = out[target_r : target_r + h, target_c : target_c + w]
   111	    assert np.all(target[reflected] == bg)
   112	    target[reflected] = sprite_color
   113	    return out
