   187	def _gen_connected_full_bbox(h, w, area, rng):
   188	    mask = np.zeros((h, w), dtype=bool)
   189	    if h == 1 or w == 1:
   190	        mask[:, :] = True
   191	        return mask
   192	
   193	    corners = (
   194	        ((0, 0), (h - 1, w - 1)),
   195	        ((0, w - 1), (h - 1, 0)),
   196	        ((h - 1, 0), (0, w - 1)),
   197	        ((h - 1, w - 1), (0, 0)),
   198	    )
   199	    start, end = corners[int(rng.integers(len(corners)))]
   200	    dr = 1 if end[0] > start[0] else -1
   201	    dc = 1 if end[1] > start[1] else -1
   202	    moves = [(dr, 0)] * (h - 1) + [(0, dc)] * (w - 1)
   203	    rng.shuffle(moves)
   204	
   205	    r, c = start
   206	    mask[r, c] = True
   207	    for rr, cc in moves:
   208	        r += rr
   209	        c += cc
   210	        mask[r, c] = True
   211	
   212	    while int(mask.sum()) < area:
   213	        frontier = []
   214	        for r, c in np.argwhere(mask):
   215	            for dr, dc in _GEN_COPY_DIRS:
   216	                rr = int(r) + dr
   217	                cc = int(c) + dc
   218	                if 0 <= rr < h and 0 <= cc < w and not mask[rr, cc]:
   219	                    frontier.append((rr, cc))
   220	        rr, cc = frontier[int(rng.integers(len(frontier)))]
   221	        mask[rr, cc] = True
   222	    return mask
   223	
