   158	def _gen_positive_parts(total, n):
   159	    if n == 1:
   160	        if total >= 1:
   161	            return [(int(total),)]
   162	        return []
   163	    out = []
   164	    for first in range(1, total - n + 2):
   165	        for rest in _gen_positive_parts(total - first, n - 1):
   166	            out.append((int(first),) + rest)
   167	    return out
