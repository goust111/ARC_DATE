+    active: list[str] = []
+    for name, (r, c), (dr, dc) in rays:
+        rr, cc = r + dr, c + dc
+        while _in_bounds(grid.shape, rr, cc) and grid[rr, cc] == bg:
+            rr += dr
+            cc += dc
+        if not _in_bounds(grid.shape, rr, cc):
