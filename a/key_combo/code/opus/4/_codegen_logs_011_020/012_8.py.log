+    gap_choices = _pattern_gap_candidates(pattern, total_gap)
+    if not gap_choices:
+        return None
+
+    fr0 = _central_start(height, frame_size)
+    fc0 = _central_start(width, frame_size)
+    a, b, c, d = random.choice(gap_choices)
+
+    sr0 = fr0 + a
+    sc0 = fc0 + c
+    sr1 = sr0 + rect_size - 1
+    sc1 = sc0 + rect_size - 1
+    fr1 = fr0 + frame_size - 1
+    fc1 = fc0 + frame_size - 1
+
+    grid = np.full((height, width), BLACK, dtype=int)
+    grid[fr0, fc0 : fc1 + 1] = RED
+    grid[fr1, fc0 : fc1 + 1] = RED
+    grid[fr0 : fr1 + 1, fc0] = RED
+    grid[fr0 : fr1 + 1, fc1] = RED
+    grid[sr0 : sr1 + 1, sc0 : sc1 + 1] = BLUE
+    return grid
+
+
+def _validate_generated_case(grid: np.ndarray) -> bool:
+    try:
+        bg, solid_color, solid_box, frame_color, frame_box = _find_scene(grid)
+    except AssertionError:
