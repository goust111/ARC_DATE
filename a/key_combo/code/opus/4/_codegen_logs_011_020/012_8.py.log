     7	
     8	def main(grid: np.ndarray) -> np.ndarray:
     9	    """
    10	    Recolor the one-pixel-inset interior of every solid foreground rectangle to teal.
    11	
    12	    Input structure
    13	    - The grid has one dominant background color.
    14	    - Non-background pixels form separated 4-connected monochrome objects.
    15	    - Each foreground object is a filled axis-aligned rectangle at least 3 cells tall and wide.
    16	
    17	    Rule
    18	    - Preserve every original pixel except the strict interior of each rectangle.
    19	    - For every foreground rectangle, replace all cells not on its one-pixel border with teal.
    20	
    21	    Key insight
    22	    - The output marks rectangle interiors, not whole objects: the original colors remain only as borders.
    23	    """
    24	    g = np.asarray(grid, dtype=int)
    25	    assert g.ndim == 2, "expected a 2D grid"
    26	    assert min(g.shape) > 0, "expected a nonempty grid"
    27	
    28	    bg = get_bg(g)
    29	    assert bg != Color.TEAL, "expected teal to be the added interior color, not background"
    30	    assert not np.any(g == Color.TEAL), "expected no existing teal pixels"
    31	
    32	    objects = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
    33	    assert objects, "expected at least one foreground rectangle"
    34	
    35	    out = g.copy()
    36	    for obj in objects:
    37	        box = obj["bbox"]
    38	        height = bbox_h(box)
    39	        width = bbox_w(box)
    40	        assert height >= 3 and width >= 3, "expected each rectangle to have an interior"
    41	        assert int(obj["area"]) == height * width, "expected each object to fill its bbox"
    42	
    43	        r0, c0, r1, c1 = map(int, box)
    44	        out[r0 + 1 : r1, c0 + 1 : c1] = Color.TEAL
    45	
    46	    return out
