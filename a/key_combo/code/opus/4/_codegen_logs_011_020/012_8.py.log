   299	def _gen_marker_patch(stem, opposite_len):
   300	    dr, dc = stem
   301	    pr, pc = -dc, dr
   302	    cells = [(0, 0)]
   303	    cells.extend((dr * i, dc * i) for i in range(1, _GEN_MARKER_STEM_LEN + 1))
   304	    cells.append((pr, pc))
   305	    cells.append((-pr, -pc))
   306	    if opposite_len:
   307	        cells.append((-dr, -dc))
   308	
   309	    min_r = min(r for r, _ in cells)
   310	    min_c = min(c for _, c in cells)
   311	    norm = [(r - min_r, c - min_c) for r, c in cells]
   312	    H = max(r for r, _ in norm) + 1
   313	    W = max(c for _, c in norm) + 1
   314	    patch = np.zeros((H, W), dtype=int)
   315	    for r, c in norm:
   316	        patch[r, c] = _GEN_MARKER_COLOR
   317	    return patch
