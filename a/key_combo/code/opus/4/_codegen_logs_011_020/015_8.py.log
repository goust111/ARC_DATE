+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> np.ndarray:
+    r0 = int(r0)
+    c0 = int(c0)
+    h, w = patch.shape
+    assert 0 <= r0 and 0 <= c0
