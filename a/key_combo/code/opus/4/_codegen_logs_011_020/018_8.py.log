+def _mirror_coords(sprite_coords: np.ndarray, side: str) -> np.ndarray:
+    coords = np.asarray(sprite_coords, dtype=int)
+    out = coords.copy()
+    if side == "left":
+        c0 = int(coords[:, 1].min())
+        out[:, 1] = 2 * c0 - 1 - coords[:, 1]
+    else:
+        c1 = int(coords[:, 1].max())
+        out[:, 1] = 2 * c1 + 1 - coords[:, 1]
+    return out
+
