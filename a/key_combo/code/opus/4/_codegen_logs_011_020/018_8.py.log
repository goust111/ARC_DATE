+    occ: np.ndarray,
+    *,
+    dc: int,
+    divider_col: int,
+) -> set[int]:
+    _h, w = shape
+    movable = {int(obj["id"]) for obj in objects}
+    by_id = {int(obj["id"]): obj for obj in objects}
+
+    changed = True
+    while changed:
+        changed = False
