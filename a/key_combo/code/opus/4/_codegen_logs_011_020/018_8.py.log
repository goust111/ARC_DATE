+def _objects_to_grid(shape: tuple[int, int], divider: int, objects: list[dict]) -> np.ndarray:
+    grid = np.full(shape, int(BG), dtype=int)
+    grid[:, int(divider)] = int(DIVIDER)
+    for obj in objects:
