+        base_shift = random.randint(1, min(4, int(base_max)))
+        shifted: list[dict] = []
+        for obj in side_objects:
+            if obj["role"] == "pair":
+                shift = base_shift
+            else:
+                margin = _object_margins(obj, W)[0 if side == "left" else 1]
+                if margin <= base_shift:
