+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_MIN = 17
+GRID_MAX = 23
+MARGIN = 3
+ANCHOR_COUNTS = (3, 4)
+MIN_GAP = 6
+PAIR_DELTAS = (6, 8, 10)
+GEN_ATTEMPTS = 400
+
+ARM_A = ((-1, 0), (0, 1))
+ARM_B = ((1, 0), (0, -1))
