+Anchor = tuple[int, int, int]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    """Mirror arc_utils.in_bounds with the canonical (r, c) convention."""
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
