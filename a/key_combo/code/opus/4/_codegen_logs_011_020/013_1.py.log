def dominant(row):
    counts = {}
    first = {}
    for i, v in enumerate(map(int, row)):
        if v in (BLACK, GREY):
            continue
        counts[v] = counts.get(v, 0) + 1
        first.setdefault(v, i)
    if not counts:
        return None
    best = None
    best_count = -1
    best_pos = len(row)
    for color, count in counts.items():
        pos = first[color]
        if count > best_count or (count == best_count and pos < best_pos):
            best = color
            best_count = count
            best_pos = pos
    return best

def segments(grid):
    h, w = grid.shape
    out = []
    for dr, dc in ((1, 1), (1, -1)):
        for r in range(h):
            for c in range(w):
                if int(grid[r, c]) "'!= GREY:
                    continue
                pr, pc = r - dr, c - dc
                if 0 <= pr < h and 0 <= pc < w and int(grid[pr, pc]) == GREY:
