                    coords.append((rr, cc))
                    rr += dr
                    cc += dc
                if len(coords) >= 2:
                    out.append((len(coords), coords[0], dc, coords))
    out.sort(key=lambda item: (-item[0], item[1][0], item[1][1], 0 if item[2] == 1 else 1))
    return out

def oracle(grid):
    g = np.array(grid, dtype=int)
    out = g.copy()
