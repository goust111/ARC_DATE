+
+def _edge_bar(row: np.ndarray) -> tuple[int, int]:
+    cols = np.flatnonzero(row == BLUE)
+    assert cols.size > 0, "expected a blue edge bar"
+    start = int(cols[0])
+    end = int(cols[-1])
+    assert np.array_equal(cols, np.arange(start, end + 1)), "edge bar must be contiguous"
