+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+GRID_H_RANGE = (10, 14)
+GRID_W_RANGE = (10, 14)
+SOURCE_COUNT_RANGE = (3, 5)
+GENERATION_RETRIES = 400
+
+MODE_WEIGHTS = (
