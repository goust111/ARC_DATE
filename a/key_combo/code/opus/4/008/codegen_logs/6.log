+def _trace_spiral(
+    shape: tuple[int, int], seed: tuple[int, int], base_step: int, max_legs: int = 12
+) -> list[dict]:
+    h, w = map(int, shape)
+    r, c = map(int, seed)
+    min_r = max_r = int(r)
+    min_c = max_c = int(c)
