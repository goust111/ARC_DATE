+def _green_component_stats(grid: np.ndarray) -> tuple[int, int]:
+    valid = 0
+    distract = 0
+    for coords in components_mask(grid == GREEN, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(coords)
+        area = int(coords.shape[0])
+        if area == 4 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2):
+            valid += 1
+        else:
+            distract += 1
