+            grid,
+            reserved,
+            prefix_path,
+            [(0, 0)],
+            PINK,
+            rng,
+            seed,
+            min_seed_gap=3,
+        ):
+            return None
+
+    try:
+        _validate_generated(grid, mode, n, obstacle_pos, blocker_pos)
+    except AssertionError:
+        return None
+    return grid
