+def _chebyshev_from_point(point: tuple[int, int], cells: list[tuple[int, int]]) -> int:
+    pr, pc = map(int, point)
+    return min(max(abs(pr - r), abs(pc - c)) for r, c in cells)
+
+
+def _reserve(reserved: np.ndarray, cells: list[tuple[int, int]], pad: int) -> None:
+    h, w = reserved.shape
