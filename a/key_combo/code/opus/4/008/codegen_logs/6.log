+        for rr in range(max(0, r - pad), min(h, r + pad + 1)):
+            for cc in range(max(0, c - pad), min(w, c + pad + 1)):
+                reserved[rr, cc] = True
+
+
+def _can_place(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    cells: list[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
