+        lower = lane[0]
+        upper = lane[1]
+        lower_mask = np.array(lower["mask"], copy=True)
+        upper_mask = np.array(upper["mask"], copy=True)
+        lower_h, lower_w = lower_mask.shape
+        upper_h, upper_w = upper_mask.shape
