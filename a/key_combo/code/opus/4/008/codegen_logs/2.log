+
+def _stretch_variants(mask: np.ndarray, *, max_area: int, max_dim: int) -> list[np.ndarray]:
+    out: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, ...], ...]] = set()
+    for oriented in _orientation_variants(mask):
