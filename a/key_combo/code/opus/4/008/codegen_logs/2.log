+        return None
+    grid, placed = laid_out
+
+    if not (4 <= len(placed) <= 6):
+        return None
+    if sum(int(item["is_match"]) for item in placed) < 1:
+        return None
+    if sum(not bool(item["is_match"]) for item in placed) < 1:
+        return None
+    if not _validate_scene(grid, proto_mask, placed):
+        return None
+    return grid
