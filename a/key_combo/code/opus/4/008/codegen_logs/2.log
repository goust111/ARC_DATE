+    lane_lefts: list[int] = []
+    x = left_start + slacks[0]
+    for i, width in enumerate(lane_widths):
+        lane_lefts.append(int(x))
+        x += width
+        if i < len(gaps):
+            x += gaps[i] + slacks[i + 1]
+    if x > cols - 1:
+        return None
+
+    grid = np.zeros((rows, cols), dtype=int)
+    grid[barrier_top:, :] = OBSTACLE
+    _paint_mask(grid, proto_mask, proto_top, proto_left, PROTOTYPE)
