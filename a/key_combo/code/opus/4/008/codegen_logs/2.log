+    options = []
+    for variant in entry["candidate_variants"]:
+        if require_non_raw and _raw_equivalent(variant, proto_mask):
+            continue
+        options.append(variant)
+    if not options:
+        return None
+    return np.array(rng.choice(options), copy=True)
