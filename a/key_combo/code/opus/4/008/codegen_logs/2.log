159:    slot_min, slot_max = SLOT_SIZE_RANGE
160:    height_min, height_max = FRAME_HEIGHT_RANGE
161:    width_min, width_max = FRAME_WIDTH_RANGE
162:    for h0 in range(slot_min, slot_max + 1):
