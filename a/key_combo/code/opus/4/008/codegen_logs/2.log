191:def _dilate4(mask: np.ndarray) -> np.ndarray:
192:    """4-connected dilation of a boolean mask."""
193:    out = mask.copy()
194:    out[1:, :] |= mask[:-1, :]
195:    out[:-1, :] |= mask[1:, :]
196:    out[:, 1:] |= mask[:, :-1]
197:    out[:, :-1] |= mask[:, 1:]
198:    return out
