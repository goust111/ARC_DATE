+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+CANDIDATE = 1
+MATCHED = 3
+OBSTACLE = 5
+PROTOTYPE = 7
+MAX_ATTEMPTS = 300
