179:def _choose_frame_specs(n_frames: int, rows: int, cols: int) -> list[FrameSpec] | None:
180:    keys = [size for size in _SIZE_OPTIONS if size[0] <= rows - 2 * EDGE_BORDER and size[1] <= cols - 2 * EDGE_BORDER]
181:    random.shuffle(keys)
182:
183:    usable = (rows - 2 * EDGE_BORDER) * (cols - 2 * EDGE_BORDER)
184:    budget = int(usable * random.uniform(*AREA_BUDGET_RANGE))
185:    chosen_sizes: list[tuple[int, int]] = []
186:    remaining = budget
187:
188:    for i in range(n_frames):
189:        slots_left = n_frames - i - 1
190:        candidates = [
191:            size
192:            for size in keys
193:            if size not in chosen_sizes
194:            and size[0] * size[1] <= remaining - slots_left * MIN_FRAME_AREA
195:        ]
196:        if not candidates:
197:            return None
198:        weights = []
199:        target = max(MIN_FRAME_AREA, remaining / (slots_left + 1))
200:        for height, width in candidates:
201:            area = height * width
202:            weights.append(1.0 / (1.0 + abs(area - target) / AREA_WEIGHT_SCALE))
203:        size = random.choices(candidates, weights=weights, k=1)[0]
204:        chosen_sizes.append(size)
205:        remaining -= size[0] * size[1]
206:
207:    specs = [random.choice(_SIZE_OPTIONS[size]) for size in chosen_sizes]
208:    specs.sort(key=lambda spec: (sum(spec[0]) + LATTICE_LINE_COUNT) * (sum(spec[1]) + LATTICE_LINE_COUNT), reverse=True)
209:    return specs
