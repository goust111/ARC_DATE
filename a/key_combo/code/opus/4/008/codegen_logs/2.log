+
+
+def _parse_scene(grid: np.ndarray) -> tuple[np.ndarray, set[tuple[tuple[int, ...], ...]], list[dict[str, object]]]:
+    g = np.asarray(grid, dtype=int)
+    proto_comps = _components_mask(g == PROTOTYPE)
+    cand_comps = _components_mask(g == CANDIDATE)
