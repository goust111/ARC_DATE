97:def _render_horizontal(rect_perp: int, rect_axial: int, gap: int, bg: int, color_a: int, color_b: int) -> tuple[np.ndarray, np.ndarray]:
98:    """Build the horizontal input/output pair; vertical cases are its transpose."""
99:    perp = rect_perp + 2 * MARGIN
100:    axial = 2 * rect_axial + gap + 2 * MARGIN
101:    left_c0 = MARGIN
102:    left_c1 = left_c0 + rect_axial - 1
103:    right_c1 = axial - MARGIN - 1
104:    right_c0 = right_c1 - rect_axial + 1
105:    row0 = MARGIN
106:    row1 = row0 + rect_perp - 1
107:
108:    out = np.full((perp, axial), bg, dtype=int)
109:    out[row0 : row1 + 1, left_c0 : left_c1 + 1] = color_a
110:    out[row0 : row1 + 1, right_c0 : right_c1 + 1] = color_b
111:
112:    span = gap // 2
113:    out[:, left_c1 + 1 : left_c1 + 1 + span] = color_a
114:    out[:, right_c0 - span : right_c0] = color_b
115:
116:    inp = out.copy()
117:    inp[:, left_c1 + 1 : right_c0] = bg
118:    return inp, out
