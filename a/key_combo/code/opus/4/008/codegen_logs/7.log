    mask=mask[rows,:]
    cols=[0]
    for c in range(1,mask.shape[1]):
        if not np.array_equal(mask[:,c],mask[:,c-1]):
            cols.append(c)
    return mask[:,cols]

def sig(mask):
    return tuple(tuple(int(v) for v in row) for row in mask)

def d4(mask):
    out=[]; seen=set()
    for k in range(4):
        rot=np.rot90(mask,k)
        for v in (rot,np.fliplr(rot)):
            s=sig(v)
            if s not in seen:
