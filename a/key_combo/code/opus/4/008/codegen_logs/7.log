_GEN_SYMBOL_DENSITY_MIN, _GEN_SYMBOL_DENSITY_MAX = 0.55, 0.89
_GEN_PROTO_DENSITY_MIN = 0.78
_GEN_COMPRESSED_SIZE_MIN, _GEN_COMPRESSED_SIZE_MAX = 2, 5

