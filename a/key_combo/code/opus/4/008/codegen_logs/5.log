+    col_lines = _frame_lines(slot_widths)
+    patch = np.full((row_lines[-1] + 1, col_lines[-1] + 1), BG, dtype=int)
+    patch[row_lines, :] = FRAME
+    patch[:, col_lines] = FRAME
+    return patch, row_lines, col_lines
