+        temp = [chain[:] for chain in chains]
+        while any(temp):
+            options = [idx for idx, chain in enumerate(temp) if chain]
+            idx = random.choice(options)
+            order.append((int(cols[idx]), int(temp[idx].pop(0))))
+
+        slot = np.full((height, width), BG, dtype=int)
