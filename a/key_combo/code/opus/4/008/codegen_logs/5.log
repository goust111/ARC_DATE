+    row_lines, col_lines = _parse_lattice(inp)
+    assert np.array_equal(out[row_lines, :], inp[row_lines, :])
+    assert np.array_equal(out[:, col_lines], inp[:, col_lines])
+    assert np.all(inp[(inp != BG) & (inp != FRAME)] != FRAME)
