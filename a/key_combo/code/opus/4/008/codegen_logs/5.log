+    for c in range(w):
+        stack = [int(slot[r, c]) for r in range(h - 1, -1, -1) if int(slot[r, c]) != BG]
+        for depth, color in enumerate(stack):
+            settled[h - 1 - depth, c] = int(color)
+    return settled
