+            if not choices:
+                break
+            heights[random.choice(choices)] += 1
+        random.shuffle(heights)
+
+        compact, raw_seq = _choose_compact_sequence(k, force_duplicate, force_three_colors)
+        if height <= len(compact):
+            continue
+        if len(set(compact)) < 2 or len(set(compact)) > 3:
+            continue
+
