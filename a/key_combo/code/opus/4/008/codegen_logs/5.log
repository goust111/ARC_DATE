+    compression_matters = False
+    fill_cycles = False
+
+    for sr in range(len(row_lines) - 1):
+        for sc in range(len(col_lines) - 1):
+            r0 = row_lines[sr] + 1
+            r1 = row_lines[sr + 1]
+            c0 = col_lines[sc] + 1
+            c1 = col_lines[sc + 1]
+
+            slot = inp[r0:r1, c0:c1]
