+
+        heights = [k] + [1] * (used_cols - 1)
+        extra_budget = height - sum(heights)
+        extra_total = random.randint(0, extra_budget) if extra_budget > 0 else 0
+        for _ in range(extra_total):
+            choices = [i for i, cur in enumerate(heights) if cur < k]
+            if not choices:
