+            obstacles.update(cluster)
+            return
+
+
+def _build_grid(shape: tuple[int, int], plans: list[dict], obstacles: set[tuple[int, int]]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for r, c in obstacles:
+        grid[r, c] = TEAL
