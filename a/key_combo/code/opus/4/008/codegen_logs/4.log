+    pieces.sort(key=lambda p: (int(p["static_steps"]), int(p["anchor"][0]), int(p["anchor"][1])))
+
+    out = g.copy()
+    out[np.isin(out, (RED, GREY))] = BG
+    stopped: set[tuple[int, int]] = set()
+    trace = []
+
+    for piece in pieces:
+        cells = piece["cells"]
+        travel = 0
+        while True:
+            nxt = _shift_cells(cells, piece["move"][0], piece["move"][1])
