+    panel = np.zeros((panel_size, panel_size), dtype=int)
+    h, w = mask.shape
+    top = random.randint(0, panel_size - h)
+    left = random.randint(0, panel_size - w)
+    panel[top : top + h, left : left + w][mask] = YELLOW
+    return panel
+
