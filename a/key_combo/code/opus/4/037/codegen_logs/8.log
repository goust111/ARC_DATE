+                s = 5.0 * new_sides + random.random()
+                if "top" in missing:
+                    s += float(qh - 1 - r)
+                if "left" in missing:
+                    s += float(qw - 1 - c)
+                if "bottom" in missing:
+                    s += float(r)
+                if "right" in missing:
+                    s += float(c)
+                s += 0.2 * (_orbit_weight(r, c, h, w) == 4)
