+    r0, c0, r1, c1 = full_box
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            orbit = _orbit_positions(r, c, full_box)
+            vals = {bool(full_panel_mask[rr, cc]) for rr, cc in orbit}
+            if len(vals) != 1:
+                return False
