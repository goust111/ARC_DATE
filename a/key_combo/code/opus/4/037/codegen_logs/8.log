+    r0, c0, r1, c1 = box
+    visited: set[tuple[tuple[int, int], ...]] = set()
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            orbit = _orbit_positions(r, c, box)
+            if orbit in visited:
+                continue
+            visited.add(orbit)
+            if not any(union[rr, cc] for rr, cc in orbit):
+                continue
+            for rr, cc in orbit:
+                if not left_mask[rr, cc] and not right_mask[rr, cc]:
+                    out[rr, cc] = RED
