+
+def _vertically_adjacent(coords_a: np.ndarray, coords_b: np.ndarray) -> bool:
+    cells_b = {tuple(map(int, cell)) for cell in coords_b}
+    for r, c in coords_a:
+        if (int(r) + 1, int(c)) in cells_b or (int(r) - 1, int(c)) in cells_b:
+            return True
+    return False
+
