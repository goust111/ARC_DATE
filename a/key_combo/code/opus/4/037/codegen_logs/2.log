+def _flip_patch(patch: np.ndarray) -> np.ndarray:
+    return np.fliplr(patch) if random.random() < 0.5 else patch.copy()
+
+
+def _pick_support_windows(patch: np.ndarray) -> tuple[int, int]:
+    top_by_col = {}
+    for col in range(patch.shape[1]):
+        rows = np.where(patch[:, col] != 0)[0]
+        if rows.size:
+            top_by_col[col] = int(rows.min())
+
+    candidates = []
+    for start in range(patch.shape[1] - 1):
+        if start in top_by_col and start + 1 in top_by_col:
+            score = min(top_by_col[start], top_by_col[start + 1])
+            candidates.append((score, start))
+
+    assert len(candidates) >= 2
+    low_start = max(candidates)[1]
+    high_start = min(candidates)[1]
+    assert low_start != high_start
+    return int(low_start), int(high_start)
+
+
+def _can_place(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    h, w = grid.shape
+    ph, pw = patch.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return False
+
+    cells = np.argwhere(patch != 0)
+    for pr, pc in cells:
+        rr = top + int(pr)
+        cc = left + int(pc)
+        if grid[rr, cc] != 0:
+            return False
+        r0 = max(0, rr - 1)
+        r1 = min(h, rr + 2)
+        c0 = max(0, cc - 1)
+        c1 = min(w, cc + 2)
+        if np.any(grid[r0:r1, c0:c1] != 0):
+            return False
+    return True
+
