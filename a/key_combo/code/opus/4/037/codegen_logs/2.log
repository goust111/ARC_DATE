        side = _tab_side(patch)
        h, w = map(int, patch.shape)
        if side in {"left", "right"}:
            reflected = np.fliplr(mask)
            color = Color.BLUE
            top = r0
            left = c1 + 2 if side == "left" else c0 - w - 1
        else:
