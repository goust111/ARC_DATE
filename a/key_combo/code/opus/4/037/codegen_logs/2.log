+ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(ARC_UTILS_DIR))
+
+from arc_utils import Color, bbox_coords, find_components, get_bg  # noqa: E402
+
