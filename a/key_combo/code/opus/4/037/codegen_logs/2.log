+            [1, 1],
+            [9, 9],
+            [1, 1],
+            [0, 1],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1],
+            [1, 1],
+            [9, 9],
+            [1, 0],
+        ],
+        dtype=int,
+    ),
+)
+
+VERTICAL_CRACK_TEMPLATES = (
+    np.array(
+        [
+            [1, 9, 1, 1],
+            [1, 9, 0, 1],
+        ],
