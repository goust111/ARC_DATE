+    support = _flip_patch(random.choice(SUPPORT_TEMPLATES))
+    low_start, high_start = _pick_support_windows(support)
+    support_patch = _colorize_template(support, color_order.pop())
+
+    support_top = random.randint(height - support.shape[0] - 4, height - support.shape[0] - 2)
+    support_left = random.randint(1, width - support.shape[1] - 2)
+    if not _can_place(grid, support_patch, support_top, support_left):
+        return None
+    _stamp(grid, support_patch, support_top, support_left)
+
+    pair_specs = []
+    gaps = random.sample([4, 5, 6, 7, 8], 2)
+    pair_specs.append((low_start, gaps[0], color_order.pop(), random.choice(HORIZONTAL_CRACK_TEMPLATES)))
+    pair_specs.append((high_start, gaps[1], color_order.pop(), random.choice(HORIZONTAL_CRACK_TEMPLATES)))
+    random.shuffle(pair_specs)
+
+    used_tops = {support_top}
+    for start, gap, color, template in pair_specs:
+        patch = _colorize_template(_flip_patch(template), color)
+        top = support_top - patch.shape[0] - gap
+        if top < 0 or top in used_tops:
+            return None
+        left = support_left + start
+        if not _can_place(grid, patch, top, left):
+            return None
+        _stamp(grid, patch, top, left)
+        used_tops.add(top)
+
+    include_extra = random.random() < 0.55
+    if include_extra:
+        extra_template = _flip_patch(random.choice(VERTICAL_CRACK_TEMPLATES))
