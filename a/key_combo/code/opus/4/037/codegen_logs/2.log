+    b = bbox_coords(coords)
+    h = b[2] - b[0] + 1
+    w = b[3] - b[1] + 1
+    return h != w and int(mask.sum()) < h * w
+
+
+def _component_summary(component: dict, grid: np.ndarray) -> dict:
