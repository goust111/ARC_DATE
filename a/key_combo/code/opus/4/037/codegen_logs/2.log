+        if summary["area"] < 4 or summary["area"] > 8:
+            return False
+        if not _non_square_non_rectangular(mask):
+            return False
+        tops.add(r0)
+        body_color = summary["body_color"]
+        if body_color in body_colors:
+            return False
+        body_colors.add(body_color)
+        if body_color not in BODY_COLORS:
+            return False
+
+        if CRACK in summary["colors"]:
+            cracked += 1
+            if len(summary["colors"]) != 2:
+                return False
+            if len(summary["crack_cols"]) == 1:
+                if w <= h:
+                    return False
+                if len(summary["crack_rows"]) != h:
+                    return False
+            elif len(summary["crack_rows"]) == 1:
+                if h <= w:
+                    return False
+                if len(summary["crack_cols"]) != w:
+                    return False
+            else:
+                return False
+        elif len(summary["colors"]) != 1:
+            return False
+
+    return cracked in {2, 3} and len(tops) == len(components)
+
+
+def _validate_semantics(grid: np.ndarray) -> bool:
+    if not _validate_input_structure(grid):
+        return False
+
+    out, state = _solve(grid, return_state=True)
+    if np.array_equal(out, grid):
+        return False
+
+    pair_infos = state["pair_infos"]
+    if len(pair_infos) not in {2, 3}:
+        return False
+
+    adjacent_pairs = [info for info in pair_infos if info["adjacent"]]
+    if len(adjacent_pairs) != 1:
+        return False
+
+    blocked_pairs = [info for info in pair_infos if (not info["adjacent"]) and info["blocked_by_other"]]
+    if not blocked_pairs:
+        return False
+
+    recolored = int(np.sum(out == int(MERGED)))
+    if recolored == 0:
+        return False
+
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randint(16, 22)
+    width = random.randint(13, 18)
+    grid = np.zeros((height, width), dtype=int)
+
+    color_order = list(BODY_COLORS)
+    random.shuffle(color_order)
+
+    support = _flip_patch(random.choice(SUPPORT_TEMPLATES))
+    low_start, high_start = _pick_support_windows(support)
+    support_patch = _colorize_template(support, color_order.pop())
+
+    support_top = random.randint(height - support.shape[0] - 4, height - support.shape[0] - 2)
+    support_left = random.randint(1, width - support.shape[1] - 2)
+    if not _can_place(grid, support_patch, support_top, support_left):
+        return None
+    _stamp(grid, support_patch, support_top, support_left)
+
+    pair_specs = []
+    gaps = random.sample([4, 5, 6, 7, 8], 2)
+    pair_specs.append((low_start, gaps[0], color_order.pop(), random.choice(HORIZONTAL_CRACK_TEMPLATES)))
+    pair_specs.append((high_start, gaps[1], color_order.pop(), random.choice(HORIZONTAL_CRACK_TEMPLATES)))
+    random.shuffle(pair_specs)
+
+    used_tops = {support_top}
+    for start, gap, color, template in pair_specs:
+        patch = _colorize_template(_flip_patch(template), color)
+        top = support_top - patch.shape[0] - gap
+        if top < 0 or top in used_tops:
+            return None
+        left = support_left + start
+        if not _can_place(grid, patch, top, left):
+            return None
+        _stamp(grid, patch, top, left)
+        used_tops.add(top)
+
+    include_extra = random.random() < 0.55
+    if include_extra:
+        extra_template = _flip_patch(random.choice(VERTICAL_CRACK_TEMPLATES))
+        extra_patch = _colorize_template(extra_template, color_order.pop())
+        candidate_columns = list(range(1, width - extra_patch.shape[1] - 1))
+        random.shuffle(candidate_columns)
+        placed = False
+        for left in candidate_columns:
+            top_choices = list(range(1, max(2, support_top - extra_patch.shape[0] - 2)))
+            random.shuffle(top_choices)
+            for top in top_choices:
+                if top in used_tops:
+                    continue
+                if _can_place(grid, extra_patch, top, left):
+                    _stamp(grid, extra_patch, top, left)
+                    placed = True
+                    break
+            if placed:
+                break
+        if not placed:
+            return None
+
+    return grid if _validate_semantics(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(800):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid fractured-gravity ARC input")

diff --git a//home/lixinyu/snap/a/key_combo/code/opus/4/037/2.py b//home/lixinyu/snap/a/key_combo/code/opus/4/037/2.py
new file mode 100644
