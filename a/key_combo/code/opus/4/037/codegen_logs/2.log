+    for index in sorted(range(len(settled)), key=lambda idx: _gravity_key(settled[idx])):
+        coords = np.asarray(settled[index]["coords"], dtype=int)
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        shift = 0
+        while True:
