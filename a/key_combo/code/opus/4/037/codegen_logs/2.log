+
+def _stamp(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    cells = np.argwhere(patch != 0)
+    for pr, pc in cells:
+        grid[top + int(pr), left + int(pc)] = int(patch[pr, pc])
