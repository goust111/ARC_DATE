+            _bbox_from_cells(pair_cells | body["input_body"] | body["stem"] | body["final_body"]),
+            shape,
+            margin=1,
+        )
+        reserve_mask = np.zeros(shape, dtype=bool)
+        reserve_mask[reserve_box[0] : reserve_box[2] + 1, reserve_box[1] : reserve_box[3] + 1] = True
