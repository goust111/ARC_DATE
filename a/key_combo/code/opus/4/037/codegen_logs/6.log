+            stem.add((row, c))
+    elif dr == 0 and dc == -1:
+        row = input_top + lane
+        for c in range(final_left + body_w, input_left):
+            stem.add((row, c))
+    elif dr == 1 and dc == 0:
+        col = input_left + lane
+        for r in range(input_top + body_h, input_top + body_h + distance):
+            stem.add((r, col))
+    elif dr == -1 and dc == 0:
+        col = input_left + lane
+        for r in range(final_top + body_h, input_top):
+            stem.add((r, col))
