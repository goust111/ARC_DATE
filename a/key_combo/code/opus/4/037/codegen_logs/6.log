+
+def _blue_body_cells(component: np.ndarray, body_box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = body_box
+    body = set()
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if component[r, c]:
+                body.add((r, c))
