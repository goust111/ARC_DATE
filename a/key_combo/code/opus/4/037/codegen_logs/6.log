+    seg_a = _segment_cells(k0, b0, length)
+    seg_b = _segment_cells(k0 + gap, b0, length)
+    fill = _pair_fill_cells(k0, gap, b0, length)
+    all_cells = seg_a | seg_b | fill
+    if len(seg_a) != length or len(seg_b) != length or not fill:
+        return None
+    if not all(in_bounds(shape, r, c) for r, c in all_cells):
