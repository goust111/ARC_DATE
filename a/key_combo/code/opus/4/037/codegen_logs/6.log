+    assert len(best) == 1, "blue object must have a unique largest solid rectangle"
+    return best[0]
+
+
+def _stem_shift(stem_mask: np.ndarray, body_box: tuple[int, int, int, int]) -> tuple[int, int, int]:
+    r0, c0, r1, c1 = body_box
