+                if any(reserved[r, c] for r, c in final_body):
+                    continue
+                if final_body & (pair["seg_a"] | pair["seg_b"]):
+                    continue
+                overlap = len(final_body & pair["fill"])
+                if overlap == 0 or overlap >= len(pair["fill"]):
+                    continue
