+                    if area < best_area:
+                        continue
+                    block = mask[r0 : r1 + 1, c0 : c1 + 1]
+                    if not block.all():
+                        continue
+                    if area > best_area:
+                        best_area = area
+                        best = []
+                    best.append((r0, c0, r1, c1))
