+    h, w = out.shape
+    segs = _extract_segments(out)
+    for b in range(-(w - 1), h):
+        active = [seg for seg in segs if seg["b0"] <= b <= seg["b1"]]
+        if len(active) < 2:
+            continue
+        active.sort(key=lambda seg: seg["k"])
