+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(16, 22)
+    w = random.randint(16, 22)
+    reserved = np.zeros((h, w), dtype=bool)
+    pair_specs: list[dict] = []
+    body_specs: list[dict] = []
