+    if len(unique_rows) == 1:
+        row = unique_rows[0]
+        cs = sorted(map(int, cols))
+        assert cs == list(range(cs[0], cs[-1] + 1)), "horizontal stem must be contiguous"
+        assert r0 <= row <= r1, "horizontal stem must attach to body side"
