+    rects: list[tuple[int, int, int, int, int, int, int]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0]:
+                continue
+            for r1 in range(r0, h):
+                for c1 in range(c0, w):
