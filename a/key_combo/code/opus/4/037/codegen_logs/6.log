+        moved = {(r + dr * distance, c + dc * distance) for r, c in body_cells}
+        for r, c in moved:
+            assert in_bounds(out.shape, r, c), "moved body leaves grid"
+            assert out[r, c] == BG, "moved body must land on empty background"
