+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    nbrs = DIRS4 if connectivity == 4 else DIRS8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in nbrs:
+                    nr, nc = cr + dr, cc + dc
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _coords_set(coords: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, rc)) for rc in coords}
+
+
+def _largest_solid_rectangle(mask: np.ndarray) -> tuple[int, int, int, int]:
+    h, w = mask.shape
+    best_area = 0
+    best: list[tuple[int, int, int, int]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0]:
+                continue
+            for r1 in range(r0, h):
+                for c1 in range(c0, w):
+                    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+                    if area < best_area:
+                        continue
+                    block = mask[r0 : r1 + 1, c0 : c1 + 1]
+                    if not block.all():
+                        continue
+                    if area > best_area:
+                        best_area = area
+                        best = []
+                    best.append((r0, c0, r1, c1))
+    assert best_area > 0, "blue object must contain a solid body"
+    assert len(best) == 1, "blue object must have a unique largest solid rectangle"
+    return best[0]
