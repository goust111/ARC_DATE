+    c1 = random.randint(1, max(1, width // 3))
+    k1 = random.randint(c1 + 2, width - 4)
+    c2 = random.randint(max(1, width // 3), width - 6)
+    k2_lo = max(c2 + 2, k1 + 2)
+    if k2_lo > width - 3:
+        return _gen_two_marker_case()
