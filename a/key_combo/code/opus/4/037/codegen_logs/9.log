+MARKER_COLORS = (2, 3, 7)
+
+Coord = Tuple[int, int]
+
+
+def _marker_cells(grid: np.ndarray) -> List[Tuple[int, int, int]]:
+    markers = [(int(r), int(c), int(grid[r, c])) for r, c in np.argwhere(np.isin(grid, MARKER_COLORS))]
