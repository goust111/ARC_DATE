+
+
+def _noise_candidates(
+    height: int,
+    width: int,
+    markers: Sequence[Coord],
+    reserved: Sequence[Coord],
+) -> List[Coord]:
+    reserved_set = {tuple(cell) for cell in reserved}
+    marker_set = {tuple(cell) for cell in markers}
