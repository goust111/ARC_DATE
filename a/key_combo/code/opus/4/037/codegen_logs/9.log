+    marker_set = {tuple(cell) for cell in markers}
+    cells: List[Coord] = []
+    for r in range(height):
+        for c in range(width):
+            cell = (r, c)
+            if cell in reserved_set or cell in marker_set:
+                continue
+            if any(abs(r - mr) + abs(c - mc) <= 1 for mr, mc in marker_set):
