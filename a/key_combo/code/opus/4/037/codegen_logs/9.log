+
+
+def _validate_semantics(inp: np.ndarray) -> bool:
+    analysis = _analyze(inp)
+    out = main(inp)
+    markers = analysis["markers"]
+    segments = analysis["segments"]
+    row_actions = analysis["row_actions"]
