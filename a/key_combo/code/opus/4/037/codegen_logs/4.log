+    col_colors = {int(grid[0, c]) for c in range(w) if np.all(grid[:, c] == grid[0, c])}
+    shared = row_colors & col_colors
+    assert len(shared) == 1, "expected exactly one full-row/full-column divider color"
+    return next(iter(shared))
