+            if not frontier:
+                break
+            shape.add(random.choice(frontier))
+        if len(shape) != count:
+            continue
+        rows = {r for r, _ in shape}
+        cols = {c for _, c in shape}
+        if len(rows) < 2 or len(cols) < 2:
