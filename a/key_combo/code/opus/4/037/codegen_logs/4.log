        return None
    choices = []
    for combo in itertools.combinations(cells, area):
        coords = set(combo)
        if not required <= coords:
            continue
        rows = [r for r, _ in coords]
        cols = [c for _, c in coords]
        if min(rows) != 0 or max(rows) != height - 1:
            continue
        if min(cols) != 0 or max(cols) != width - 1:
            continue
