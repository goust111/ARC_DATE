                adj[j].add(i)

    order = sorted(range(n), key=lambda idx: len(adj[idx]), reverse=True)
    colors = [None] * n

    def rec(pos, used):
        if pos == n:
            return len(used) == distinct
        idx = order[pos]
        forbidden = {colors[j] for j in adj[idx] if colors[j] is not None}
        candidates = list(palette)
