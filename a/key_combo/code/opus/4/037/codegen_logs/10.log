        for r, c in coords:
            mask[r, c] = 1
        if is_contiguous(mask, background=_GEN_BG, connectivity=_GEN_CONNECTIVITY):
            choices.append(mask)
    if not choices:
        return None
    return random.choice(choices)


def _gen_build_group(height, length, areas, grid_width):
    if length == 1:
