+            "min_r": int(min_r),
+            "max_r": int(max_r),
+            "min_c": int(min_c),
+            "max_c": int(max_c),
+            "line_index": int(line_col if orientation == "vertical" else line_row),
+            "marker_index": int(marker_col if orientation == "vertical" else marker_row),
+            "body_side": body_side,
