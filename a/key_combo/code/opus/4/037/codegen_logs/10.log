+def _buffered(coords, shape):
+    height, width = shape
+    out = set()
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width:
+                    out.add((rr, cc))
+    return out
