+                "anchor_r": int(anchor_r),
+                "anchor_c": int(anchor_c),
+                "source_abs": source,
+                "target_abs": tuple(sorted(targets)),
+            }
+        )
+        reserved_cells |= coords
+        reserved_buffer |= _buffered(coords, shape)
