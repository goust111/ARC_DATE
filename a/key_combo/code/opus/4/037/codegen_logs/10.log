+                marker_row, support = _find_sparse_marker_row(grid, c0, c1, range(r1 + 2, r1 + 5))
+            else:
+                assert np.all(body_local[:, 0] > local_line)
+                body_side = "down"
+                marker_row, support = _find_sparse_marker_row(grid, c0, c1, range(r0 - 2, r0 - 5, -1))
