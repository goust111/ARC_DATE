    for _ in range(GEN_RETRY):
        res = _gen_attempt()
        res = _gen_attempt()
        if res is not None:
        if res is not None:
            return res
            return res
    raise RuntimeError("Failed to generate input")
    raise RuntimeError("Failed to generate input")

