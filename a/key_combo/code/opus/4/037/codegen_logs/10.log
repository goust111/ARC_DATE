+    int(Color.BLUE): int(Color.RED),
+    int(Color.GREEN): int(Color.YELLOW),
+    int(Color.ORANGE): int(Color.PINK),
+}
+BODY_COLORS = tuple(BODY_TO_COPY)
+
+GRID_ROWS = (16, 22)
+GRID_COLS = (16, 22)
+OBJECT_COUNT_CHOICES = (2, 3)
+GEN_MAX_ATTEMPTS = 500
+SHAPE_ATTEMPTS = 200
+SCENE_ATTEMPTS = 200
