+            line_row = body_height if body_side == "up" else 0
+            marker_gap = random.randint(1, 3)
+            marker_row = line_row + marker_gap + 1 if body_side == "up" else line_row - marker_gap - 1
+            support = _make_sparse_support(width)
+            if support is None:
