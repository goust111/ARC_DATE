+    reserved_cells = set()
+    reserved_buffer = set()
+
+    order = sorted(
+        specs,
+        key=lambda spec: (spec["max_r"] - spec["min_r"], spec["max_c"] - spec["min_c"]),
+        reverse=True,
+    )
+    for spec in order:
+        r_lo = -spec["min_r"]
+        r_hi = height - 1 - spec["max_r"]
+        c_lo = -spec["min_c"]
+        c_hi = width - 1 - spec["max_c"]
+        candidates = []
+        for anchor_r in range(r_lo, r_hi + 1):
+            for anchor_c in range(c_lo, c_hi + 1):
