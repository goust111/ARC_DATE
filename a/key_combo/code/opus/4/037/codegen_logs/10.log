+def _place_specs(shape, specs):
+    height, width = shape
+    placed = []
+    reserved_cells = set()
+    reserved_buffer = set()
+
+    order = sorted(
+        specs,
+        key=lambda spec: (spec["max_r"] - spec["min_r"], spec["max_c"] - spec["min_c"]),
+        reverse=True,
