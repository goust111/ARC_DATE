+def _absolute_cells(spec, anchor_r, anchor_c):
+    source = {}
+    for (r, c), color in spec["source_cells"].items():
+        source[(anchor_r + r, anchor_c + c)] = int(color)
+    targets = {(anchor_r + r, anchor_c + c) for r, c in spec["target_cells"]}
+    return source, targets
