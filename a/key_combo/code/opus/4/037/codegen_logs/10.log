+    return candidates[0]
+
+
+def _find_sparse_marker_row(grid, c0, c1, search_rows):
+    span = c1 - c0 + 1
+    candidates = []
+    for r in search_rows:
+        if not (0 <= r < grid.shape[0]):
+            continue
+        cols = np.flatnonzero(grid[r, :] == CRACK)
