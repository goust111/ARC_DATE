+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None, clip: bool = False) -> np.ndarray:
+    h, w = dst.shape
+    r0 = int(r0)
+    c0 = int(c0)
+    ph, pw = patch.shape
