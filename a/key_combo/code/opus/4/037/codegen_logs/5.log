+    for _ in range(removal_budget):
+        boundary = [(r, c) for r, c in np.argwhere(hole) if r in (0, hole.shape[0] - 1) or c in (0, hole.shape[1] - 1)]
+        random.shuffle(boundary)
+        changed = False
+        for r, c in boundary:
+            candidate = hole.copy()
+            candidate[int(r), int(c)] = False
+            cropped = _crop_mask(candidate)
