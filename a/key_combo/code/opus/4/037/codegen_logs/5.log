+    return grid
+
+
+def _semantic_signature(obj: dict) -> tuple:
+    return (
+        obj["bbox"],
+        tuple(obj["embedded"]),
+        tuple(obj["isolated"]),
+        len(obj["isolated"]),
+        obj["repaired_patch"].shape,
+    )
+
+
+def _validate_generated(grid: np.ndarray, specs: list[dict]) -> bool:
