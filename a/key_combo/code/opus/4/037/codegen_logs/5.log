+        repaired = np.full(ring.shape, BG, dtype=int)
+        repaired[ring] = GREEN
+        for r, c in isolated:
+            repaired[int(r), int(c)] = RED
+
+        return {
+            "patch": patch,
+            "repaired_patch": repaired,
+            "ring_mask": ring,
+            "embedded": embedded,
+            "isolated": isolated,
+            "isolated_count": int(isolated_count),
+            "embedded_count": len(embedded),
+        }
