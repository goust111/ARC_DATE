+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+CYAN = 8
+
+GEN_RETRY_LIMIT = 500
+LOCAL_RETRY_LIMIT = 120
+GRID_H_RANGE = (18, 26)
+GRID_W_RANGE = (18, 26)
+OBJECT_COUNT_OPTIONS = (2, 3)
+ISOLATED_COUNT_RANGE = (1, 4)
