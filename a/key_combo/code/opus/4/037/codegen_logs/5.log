+            continue
+
+        patch = np.full(ring.shape, BG, dtype=int)
+        patch[ring] = GREEN
+        for r, c in embedded:
+            patch[int(r), int(c)] = RED
+        for r, c in isolated:
+            patch[int(r), int(c)] = RED
