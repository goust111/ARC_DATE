  92:     palette_arr = np.asarray(palette, dtype=int)
  93:     k = len(palette)
  94: 
  95:     rr, cc = np.indices((csize, csize))
  96:     base = (rr + cc + random.randrange(k)) % k
  97:     if random.choice([False, True]):
