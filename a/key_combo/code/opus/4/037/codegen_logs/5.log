+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    out = g.copy()
+
+    for obj in _analyze_grid(g):
+        r0, c0, r1, c1 = obj["bbox"]
+        for r, c in obj["embedded"]:
+            out[int(r), int(c)] = GREEN
