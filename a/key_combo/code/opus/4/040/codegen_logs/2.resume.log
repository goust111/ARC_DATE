+def _shortest_period(values: list[int]) -> list[int]:
+    n = len(values)
+    for period in range(1, n + 1):
+        ok = True
+        for idx, value in enumerate(values):
+            if value != values[idx % period]:
+                ok = False
+                break
+        if ok:
+            return values[:period]
+    return values[:]
