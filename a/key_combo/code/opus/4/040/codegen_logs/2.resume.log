+        area = int(coords.shape[0])
+        bbox_area = int((r1 - r0 + 1) * (c1 - c0 + 1))
+        item = {
+            "coords": coords,
+            "bbox": (r0, c0, r1, c1),
+            "area": area,
+            "bbox_area": bbox_area,
