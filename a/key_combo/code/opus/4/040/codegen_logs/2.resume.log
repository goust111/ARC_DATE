+    length = random.choice([1, 2]) if limit >= 4 else 1
+    offsets = list(range(limit - length + 1))
+    parity = used_parity.get(orient)
+    if parity is None:
+        random.shuffle(offsets)
+    else:
+        offsets = [offset for offset in offsets if offset % 2 == parity] or offsets
