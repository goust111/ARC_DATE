+
+def _build_gap_metadata(
+    row_lines: list[int],
+    col_lines: list[int],
+    cell_h: int,
+    cell_w: int,
+    edge: tuple[tuple[int, int], tuple[int, int]],
+    used_parity: dict[str, int],
+) -> dict:
+    (r0, c0), (r1, c1) = edge
+    if r0 == r1:
+        orient = "v"
+        limit = cell_h
+        separator = col_lines[min(c0, c1) + 1]
+        axis_base = row_lines[r0] + 1
+    else:
+        orient = "h"
+        limit = cell_w
+        separator = row_lines[min(r0, r1) + 1]
+        axis_base = col_lines[c0] + 1
