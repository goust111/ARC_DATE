+        hole = analysis["holes"][chosen_hole]
+        used_holes.add(chosen_hole)
+        expected[candidate["coords"][:, 0], candidate["coords"][:, 1]] = int(hole["host_color"])
+        expected[hole["coords"][:, 0], hole["coords"][:, 1]] = int(candidate["color"])
