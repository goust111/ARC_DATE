+def _can_place(blocked: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch.shape
+    gh, gw = blocked.shape
+    if r0 < 0 or c0 < 0 or r0 + h > gh or c0 + w > gw:
