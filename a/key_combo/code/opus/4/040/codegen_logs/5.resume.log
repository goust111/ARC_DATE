+def _build_instance() -> np.ndarray | None:
+    grid = np.zeros((random.randint(GRID_MIN, GRID_MAX), random.randint(GRID_MIN, GRID_MAX)), dtype=int)
+    hole_a, hole_b = _random_hole_pair()
