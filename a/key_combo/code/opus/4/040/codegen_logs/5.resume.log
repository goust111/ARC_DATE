+    candidate_count = random.randint(3, 4)
+    candidate_colors = random.sample(list(CANDIDATE_COLORS), candidate_count)
+    items: list[dict] = []
+    for host in host_defs:
+        items.append({"patch": host["patch"], "role": "host"})
