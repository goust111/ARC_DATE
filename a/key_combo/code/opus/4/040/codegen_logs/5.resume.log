+        if not np.all(vals == cand["color"]):
+            return False
+
+    for cand in matched:
+        hole = analysis["holes"][cand["possible_holes"][0]]
+        cand_vals = out[cand["coords"][:, 0], cand["coords"][:, 1]]
+        hole_vals = out[hole["coords"][:, 0], hole["coords"][:, 1]]
