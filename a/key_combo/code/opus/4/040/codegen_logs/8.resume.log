+    return {
+        "bars": bars,
+        "ordered": ordered,
+        "source": source,
+        "target": target,
+        "half": half,
+        "seg_top": seg_top,
+        "seg_bottom": seg_bottom,
+        "seg_len": seg_len,
+        "target_seg_top": target_seg_top,
+        "target_seg_bottom": target_seg_bottom,
+        "line_row": _segment_mid_row(seg_top, seg_len),
+        "line_color": UPPER_LINE if half == "upper" else LOWER_LINE,
+    }
