+    seg_bottom = int(spec["seg_bottom"])
+    target_seg_top = int(spec["target_seg_top"])
+    target_seg_bottom = int(spec["target_seg_bottom"])
+    line_row = int(spec["line_row"])
+    line_color = int(spec["line_color"])
