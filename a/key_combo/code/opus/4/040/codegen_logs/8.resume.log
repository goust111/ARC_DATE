WINDOW_STARTS = GRID_SIZE - TILE_SIZE + 1
TILE_CELL_COUNT = TILE_SIZE * TILE_SIZE
# Fixed colors.
BG_COLOR, SPRITE_COLOR, MARKER_COLOR = 0, 8, 4
