+    c0 = min(int(source["col"]), int(target["col"]))
+    c1 = max(int(source["col"]), int(target["col"]))
+    for c in range(c0, c1 + 1):
+        if out[line_row, c] == BG:
+            out[line_row, c] = line_color
+
