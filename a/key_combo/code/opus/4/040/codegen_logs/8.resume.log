+            red_bottom = int(red_rows[-1])
+            if not np.array_equal(red_rows, np.arange(red_top, red_bottom + 1)):
+                raise AssertionError("the red mark must be one contiguous segment")
+        else:
+            red_top = None
+            red_bottom = None
