+        offset = seg_top - int(source["top"])
+        target_seg_top = int(target["top"]) + offset
+    else:
+        offset = int(source["bottom"]) - seg_bottom
+        target_seg_top = int(target["bottom"]) - offset - seg_len + 1
+    target_seg_bottom = target_seg_top + seg_len - 1
