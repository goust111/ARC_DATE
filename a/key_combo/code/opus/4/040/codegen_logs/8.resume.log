+
+def _classify_half(bar_top: int, bar_bottom: int, seg_top: int, seg_len: int) -> str:
+    seg_bottom = seg_top + seg_len - 1
+    if seg_top + seg_bottom < bar_top + bar_bottom:
+        return "upper"
+    return "lower"
