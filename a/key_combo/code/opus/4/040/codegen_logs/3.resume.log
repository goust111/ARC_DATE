+                hidden_count += 1
+                has_hidden = True
+            if cell in visible[i]:
+                visible_count += 1
+                visible_sources.add(i)
+                has_visible = True
+                if i < len(rectangles) - 1:
+                    lower_visible = True
+        if i < len(rectangles) - 1 and has_hidden and has_visible:
+            lower_pivot_ok = True
+            break
+    else:
+        lower_pivot_ok = False
