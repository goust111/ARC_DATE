+        if not ok:
+            continue
+
+        if rng.random() < 0.45:
+            candidates = []
+            for i, rect in enumerate(rectangles):
+                if len(rect["marks"]) >= 2:
+                    continue
+                cell = _pick_unused(rng, hidden[i], used)
+                if cell is not None:
+                    candidates.append((i, cell))
+            if candidates:
+                i, cell = candidates[int(rng.integers(len(candidates)))]
