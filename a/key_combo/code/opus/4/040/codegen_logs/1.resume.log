+    assert scored, "seed must have at least one valid extension"
+    scored.sort(key=lambda item: item[0])
+    if len(scored) > 1:
+        assert scored[0][0] + 1e-9 < scored[1][0], "seed direction must be uniquely inward"
+    return scored[0][1]
+
