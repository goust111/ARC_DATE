+def _simulate_ray(grid: np.ndarray, frames: list[RectFrame]) -> tuple[np.ndarray, list[int]]:
+    out = grid.copy()
+    r, c, dr, dc = _seed_state(grid, frames)
+    hit_order: list[int] = []
+    seen: set[tuple[int, int, int, int]] = set()
+
+    while True:
+        state = (r, c, dr, dc)
+        if state in seen:
+            break
+        seen.add(state)
