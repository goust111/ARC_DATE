+                        _semantic_validate(trial)
+                    except AssertionError:
+                        continue
+                    grid = trial
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
+                break
+
+        if not placed:
+            continue
+
+        assert max(grid.shape) <= 30
+        return grid
+
+    raise RuntimeError("failed to generate a valid input")

