+            remaining = n_frames - 1 - i
+            built = False
+            for _ in range(40):
+                dt, dl, db, dr = [int(v) for v in rng.choice([3, 4], size=4)]
+                nxt = (prev[0] + dt, prev[1] + dl, prev[2] - db, prev[3] - dr)
+                need = 5 + 6 * remaining
+                if nxt[2] - nxt[0] + 1 >= need and nxt[3] - nxt[1] + 1 >= need:
