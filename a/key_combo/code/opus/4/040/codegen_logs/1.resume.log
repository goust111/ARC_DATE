+    ray_mask = ray_grid == ORANGE
+    hit_rank = {frame_idx: rank for rank, frame_idx in enumerate(hit_order)}
+    active = set(hit_order)
+    interior_masks = [strict_interior_mask(grid.shape, frame.bbox) for frame in frames]
