+def r0c0r1c1_contains_border(bbox: tuple[int, int, int, int], r: int, c: int) -> bool:
+    r0, c0, r1, c1 = bbox
+    return ((r in (r0, r1)) and c0 <= c <= c1) or ((c in (c0, c1)) and r0 <= r <= r1)
+
