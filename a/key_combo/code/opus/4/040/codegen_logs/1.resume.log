+            return (h, w), frames
+    raise RuntimeError("failed to build nested frames")
+
+
+def _corner_box(
+    outer: tuple[int, int, int, int],
+    inner: tuple[int, int, int, int],
+    corner: str,
+) -> tuple[range, range, tuple[int, int]]:
