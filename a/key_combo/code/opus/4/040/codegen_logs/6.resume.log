+        current_c = row_left
+        for idx in row:
+            spec = specs[idx]
+            oh, ow = spec["outer_shape"]
+            spec["top"] = current_r + random.randint(0, row_h - oh)
+            spec["left"] = current_c
+            current_c += ow + gap_x
+        current_r += row_h + gap_y
+
+    return canvas_h, canvas_w
+
+
