    return max(rows) - min(rows) + 1, max(cols) - min(cols) + 1


def _gen_mask_from_cells(cells: set[tuple[int, int]]) -> np.ndarray:
    coords = np.array(tuple(cells), dtype=int)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    h, w = r1 - r0 + 1, c1 - c0 + 1
