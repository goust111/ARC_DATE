+def _validate_sample(grid: np.ndarray) -> None:
+    frames = _extract_frames(grid)
+    crop_areas = [frame["crop_area"] for frame in frames]
+    assert len(set(crop_areas)) == 3
+
+    frames.sort(key=lambda frame: frame["crop_area"])
