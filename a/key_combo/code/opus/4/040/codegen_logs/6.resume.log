+def _valid_template_shapes() -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for h in range(2, 5):
+        for w in range(2, 5):
+            larger = []
+            for kh in range(1, 8 // h + 1):
+                for kw in range(1, 8 // w + 1):
+                    if (kh, kw) == (1, 1):
+                        continue
+                    shape = (h * kh, w * kw)
+                    if _allowed_orientations(shape, require_outside=True):
+                        larger.append(shape)
