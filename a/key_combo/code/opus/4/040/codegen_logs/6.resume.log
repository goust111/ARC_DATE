+
+def _repeat_to_shape(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    th, tw = tile.shape
+    reps = ((h + th - 1) // th, (w + tw - 1) // tw)
+    return np.tile(tile, reps)[:h, :w]
