+def _overlay_template(base: np.ndarray, template: np.ndarray) -> np.ndarray:
+    out = np.array(base, copy=True)
+    tiled = _repeat_to_shape(template, base.shape)
+    out[tiled == Color.GREY] = Color.GREY
+    return out
