+def _choose_center(rng: np.random.Generator, h: int, w: int) -> tuple[int, int]:
+    row_lo = max(4, h // 4)
+    row_hi = min(h - 5, h // 2)
+    col_lo = max(4, w // 4)
+    col_hi = min(w - 5, w // 2)
+    return int(rng.integers(row_lo, row_hi + 1)), int(rng.integers(col_lo, col_hi + 1))
+
