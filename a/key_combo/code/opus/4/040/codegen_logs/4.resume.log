+def _extend_lines(grid: np.ndarray, center: tuple[int, int]) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    out = np.array(grid, dtype=int, copy=True)
+    orth_mask = out == BLUE
+    diag_mask = out == RED
+    cr, cc = center
+
+    for dr, dc in ORTH_DIRS:
+        r, c = cr + dr, cc + dc
+        while in_bounds(out.shape, r, c):
+            if out[r, c] == BLACK:
+                out[r, c] = BLUE
+                orth_mask[r, c] = True
+            r += dr
+            c += dc
