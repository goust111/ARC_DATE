+        sw = int(shape_coords[:, 1].max()) + 1
+        for top in range(h - sh + 1):
+            for left in range(w - sw + 1):
+                cells = _placement_cells(shape_coords, top, left)
+                ok = True
+                for r, c in cells:
+                    r = int(r)
+                    c = int(c)
+                    if grid[r, c] != BLACK or blocked[r, c] or orth_mask[r, c] or diag_mask[r, c]:
