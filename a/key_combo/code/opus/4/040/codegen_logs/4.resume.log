+
+def _extend_lines(grid: np.ndarray, center: tuple[int, int]) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    out = np.array(grid, dtype=int, copy=True)
+    orth_mask = out == BLUE
+    diag_mask = out == RED
+    cr, cc = center
+
