+            nc = c + dc
+            if in_bounds(blocked.shape, nr, nc):
+                blocked[nr, nc] = True
+
+
+def _category_from_flags(touch_orth: bool, touch_diag: bool) -> str:
+    if touch_orth and touch_diag:
+        return "both"
+    if touch_orth:
+        return "orth"
+    if touch_diag:
+        return "diag"
+    return "none"
+
