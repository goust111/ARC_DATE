+    orth_mask: np.ndarray,
+    diag_mask: np.ndarray,
+    category: str,
+) -> list[np.ndarray]:
+    h, w = grid.shape
+    placements: list[np.ndarray] = []
+    for shape_coords in SHAPE_VARIANTS:
+        sh = int(shape_coords[:, 0].max()) + 1
+        sw = int(shape_coords[:, 1].max()) + 1
+        for top in range(h - sh + 1):
