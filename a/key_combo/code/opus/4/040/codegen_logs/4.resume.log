+                out[r, c] = RED
+                diag_mask[r, c] = True
+            r += dr
+            c += dc
+
+    return out, orth_mask, diag_mask
+
+
+def _touch_signature(cells: np.ndarray, orth_mask: np.ndarray, diag_mask: np.ndarray) -> tuple[bool, bool]:
+    touch_orth = False
+    touch_diag = False
+    for r, c in cells:
