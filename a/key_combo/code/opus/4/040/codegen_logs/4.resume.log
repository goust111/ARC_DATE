+
+    for coords in _components_of_color(grid, GRAY):
+        touch_orth, touch_diag = _touch_signature(coords, orth_mask, diag_mask)
+        if touch_orth and touch_diag:
+            new_color = ORANGE
+        elif touch_orth:
+            new_color = GREEN
+        elif touch_diag:
+            new_color = YELLOW
+        else:
+            new_color = GRAY
+        out[coords[:, 0], coords[:, 1]] = new_color
+
