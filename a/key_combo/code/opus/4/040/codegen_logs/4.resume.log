+    blocked = np.zeros((h, w), dtype=bool)
+    cross_cells = np.argwhere(grid != BLACK)
+    _mark_blocked(blocked, cross_cells)
+
+    for category in _sample_categories(rng):
+        placements = _all_valid_placements(grid, blocked, orth_mask, diag_mask, category)
+        if not placements:
+            return None
+        cells = placements[int(rng.integers(0, len(placements)))]
+        grid[cells[:, 0], cells[:, 1]] = GRAY
