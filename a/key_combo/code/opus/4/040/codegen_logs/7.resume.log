_GEN_HORIZONTAL, _GEN_VERTICAL = 0, 1
_GEN_MIN_BREACH_DIVISOR, _GEN_MAX_BREACH_DIVISOR = 4, 3
_GEN_GAP_LEN_RANGE = (1, 2)
# Retry policy.
