+
+def _sample_lines(boxes: list[BBox], h: int, w: int) -> list[dict] | None:
+    color = random.choice(LINE_COLORS)
+    h_box = random.choice(boxes)
+    v_box = random.choice(boxes)
+    h_rows = _safe_inner_rows(h_box)
+    v_cols = _safe_inner_cols(v_box)
