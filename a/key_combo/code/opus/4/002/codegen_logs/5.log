+    if not active:
+        return None
+
+    seeds = [random.choice(active)]
+    want_two = random.random() < 0.5
+    if not want_two:
+        return seeds
+
+    pool = [
+        pos
+        for pos in candidates
+        if pos not in seeds and max(abs(pos[0] - seeds[0][0]), abs(pos[1] - seeds[0][1])) >= 2
+    ]
+    if not pool:
+        return seeds
+    seeds.append(random.choice(pool))
+    return seeds
+
+
