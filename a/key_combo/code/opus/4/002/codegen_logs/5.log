+
+def _drop_orange_globally(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    coords = np.argwhere(g == ORANGE)
+    out = g.copy()
+    out[out == ORANGE] = BG
