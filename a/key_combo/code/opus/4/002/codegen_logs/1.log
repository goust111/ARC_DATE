    col = 0 if side == "left" else group.shape[1] - 1
    rows = []
    for r in range(GEN_HEIGHT):
        if group[r, col] == BG_COLOR:
            continue
        deg = sum(
            group[nr, nc] != BG_COLOR
            for nr, nc in _gen_neighbors(r, col, group.shape[1])
