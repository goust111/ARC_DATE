+    enclosed: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == bg and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
