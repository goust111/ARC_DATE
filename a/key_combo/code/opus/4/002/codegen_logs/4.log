+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _degree(mask: np.ndarray, r: int, c: int) -> int:
+    h, w = mask.shape
+    return sum(
+        0 <= r + dr < h and 0 <= c + dc < w and bool(mask[r + dr, c + dc])
+        for dr, dc in DIR4
+    )
