      q=deque([(r,c)]); vis[r,c]=1; comp=[]; touch=False
      while q:
        x,y=q.popleft(); comp.append((x,y))
        if x in (0,H-1) or y in (0,W-1): touch=True
        for dx,dy in DIRS:
          nx,ny=x+dx,y+dy
          if 0<=nx<H and 0<=ny<W and not g[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
      if not touch: ans.append(comp)
  return ans

def endpoint_row(group,side):
  H,W=group.shape
  c=0 if side=='L' else W-1
  rows=[]
  for r in range(H):
    if not group[r,c]: continue
    d=sum(0<=r+dr<H and 0<=c+dc<W and group[r+dr,c+dc] for dr,dc in DIRS)
    if d==1: rows.append(r)
  return rows

