+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for dr, dc in DIR4:
