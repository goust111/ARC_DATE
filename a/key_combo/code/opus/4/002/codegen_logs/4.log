+def _fg_color(grid: np.ndarray, bg: int) -> int:
+    colors = sorted({int(v) for v in grid.ravel() if int(v) != bg})
+    assert len(colors) == 1, "expected exactly one foreground color"
+    return int(colors[0])
+
