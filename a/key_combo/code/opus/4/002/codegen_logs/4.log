+
+
+BG = 0
+FG = 3
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GROUP_LEN_MIN = 3
+GROUP_LEN_MAX = 8
+SHIFT_ATTEMPTS = 80
+GEN_ATTEMPTS = 200
+MAX_INPUT_WIDTH = 30
+
+
+TEMPLATES: tuple[dict[str, object], ...] = (
+    {
