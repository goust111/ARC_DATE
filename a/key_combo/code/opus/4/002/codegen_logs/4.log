import random, numpy as np
from collections import deque
from functools import lru_cache
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]
GROUP_LEN_MIN=3; GROUP_LEN_MAX=8
@lru_cache(None)
def opts(H,W,a,b):
  out=[]
  def valid(g):
    coords=np.argwhere(g)
    ds=[]; left=[]; right=[]
    for r,c in coords:
      d=sum(0<=r+dr<H and 0<=c+dc<W and g[r+dr,c+dc] for dr,dc in DIRS)
      ds.append(d)
      if c==0 and d==1:left.append(r)
      if c==W-1 and d==1:right.append(r)
    return all(d in (1,2) for d in ds) and ds.count(1)==2 and len(left)==1 and len(right)==1
  def dfs(path,used):
    cur=path[-1]
    if len(path)>GROUP_LEN_MAX: return
    dist=abs(cur[0]-b)+abs(cur[1]-(W-1))
    if len(path)+dist>GROUP_LEN_MAX: return
    if cur==(b,W-1):
      if GROUP_LEN_MIN<=len(path)<=GROUP_LEN_MAX:
        g=np.zeros((H,W),int)
        for r,c in path:g[r,c]=1
        if valid(g): out.append(g)
      return
    r,c=cur
    for dr,dc in [(0,1),(-1,0),(1,0),(0,-1)]:
      nr,nc=r+dr,c+dc
      if 0<=nr<H and 0<=nc<W and (nr,nc) not in used and abs(nr-b)+abs(nc-(W-1))<=GROUP_LEN_MAX-len(path):
        path.append((nr,nc)); used.add((nr,nc)); dfs(path,used); used.remove((nr,nc)); path.pop()
  dfs([(a,0)],{(a,0)})
  return tuple(out)

def holes(g):
  H,W=g.shape
  vis=np.zeros_like(g,bool)
  ans=[]
  for r in range(H):
    for c in range(W):
      if g[r,c] or vis[r,c]: continue
      q=deque([(r,c)]); vis[r,c]=1; comp=[]; touch=False
      while q:
        x,y=q.popleft(); comp.append((x,y))
        if x in (0,H-1) or y in (0,W-1): touch=True
        for dx,dy in DIRS:
          nx,ny=x+dx,y+dy
          if 0<=nx<H and 0<=ny<W and not g[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
      if not touch: ans.append(comp)
  return ans

def connected(g):
  coords=np.argwhere(g)
  H,W=g.shape
  q=deque([tuple(coords[0])]); seen={tuple(coords[0])}
  while q:
    r,c=q.popleft()
    for dr,dc in DIRS:
      nr,nc=r+dr,c+dc
      if 0<=nr<H and 0<=nc<W and g[nr,nc] and (nr,nc) not in seen:
        seen.add((nr,nc)); q.append((nr,nc))
  return len(seen)==len(coords)

for tries in range(100000):
  H=random.randint(7,9); widths=[random.randint(2,5) for _ in range(4)]
  if sum(widths)>18: continue
  r0=random.randint(1,H-2)
  rows=[r0]+[random.randint(1,H-2) for _ in range(3)]+[r0]
  pools=[opts(H,w,rows[i],rows[i+1]) for i,w in enumerate(widths)]
  if any(not p for p in pools): continue
  groups=[random.choice(p) for p in pools]
  packed=np.zeros((H,sum(widths)),int)
  c=0
  for g in groups:
    packed[:,c:c+g.shape[1]]=g; c+=g.shape[1]
  hs=holes(packed)
  if len(hs)==1 and len(hs[0])>=2 and connected(packed):
    print('H',H,'widths',widths,'rows',rows,'hole',len(hs[0]))
    for i,g in enumerate(groups):
      print('group',i,g.astype(int).tolist())
    print('packed',packed.astype(int).tolist())
    break
else:
  print('none')
