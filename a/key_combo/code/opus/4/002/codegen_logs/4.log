+    mask = group != int(bg)
+    for r in range(h):
+        if not mask[r, c]:
+            continue
+        if _degree(mask, r, c) == 1:
+            rows.append(r)
+    assert len(rows) == 1, f"expected one {side} endpoint"
+    return int(rows[0])
