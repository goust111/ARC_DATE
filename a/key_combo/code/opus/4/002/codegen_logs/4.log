+def _valid_shifts(group: np.ndarray) -> list[int]:
+    rows = np.argwhere(group != BG)[:, 0]
+    lo = -int(rows.min())
+    hi = int(group.shape[0] - 1 - rows.max())
+    return list(range(lo, hi + 1))
+
