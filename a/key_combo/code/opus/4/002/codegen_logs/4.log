from collections import deque
from functools import lru_cache

DIRS=[(-1,0),(1,0),(0,-1),(0,1)]

def paths(H,W,start,goal,ncells):
  out=[]
  @lru_cache(None)
  def md(a,b):
    return abs(a[0]-b[0])+abs(a[1]-b[1])
  def dfs(path,used):
    cur=path[-1]
    if len(path)==ncells:
      if cur==goal:
        out.append(tuple(path))
      return
    rem=ncells-len(path)
    cand=[]
    for dr,dc in DIRS:
      nr,nc=cur[0]+dr,cur[1]+dc
      if 0<=nr<H and 0<=nc<W and (nr,nc) not in used and md((nr,nc),goal)<=rem-1:
        cand.append((nr,nc))
    random.shuffle(cand)
    for nxt in cand:
      path.append(nxt); used.add(nxt)
      dfs(path,used)
      used.remove(nxt); path.pop()
      if len(out)>200:
        return
  dfs([start],{start})
  return out

cache={}
def group_options(H,W,a,b):
  key=(H,W,a,b)
  if key in cache:return cache[key]
  opts=[]
  for n in range(max(W,3),9):
    for p in paths(H,W,(a,0),(b,W-1),n):
      g=np.zeros((H,W),int)
      for r,c in p:g[r,c]=1
      opts.append(g)
  cache[key]=opts
  return opts

