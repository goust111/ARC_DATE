+    out = np.full((h, out_w), int(bg), dtype=int)
+    c = 0
+    first = np.array(groups[0], dtype=int, copy=True)
+    out[:, : first.shape[1]] = first
+    prev_right = _endpoint_row(first, bg, "right")
+    c += first.shape[1]
+    for group in groups[1:]:
