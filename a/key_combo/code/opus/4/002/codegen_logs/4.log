+    assert g.ndim == 2
+    bg = _get_bg(g)
+    fg = _fg_color(g, bg)
+    groups = _column_groups(g, bg)
+    packed = _pack_groups(groups, bg, align=True)
+    return _fill_enclosed_regions(packed, bg, fg)
+
