+    canvas = np.full((groups[0].shape[0], width), BG, dtype=int)
+    c = 0
+    for i, group in enumerate(groups):
+        patch = np.where(group != BG, FG, BG)
+        canvas[:, c : c + patch.shape[1]] = patch
+        c += patch.shape[1]
+        if i < len(separators):
