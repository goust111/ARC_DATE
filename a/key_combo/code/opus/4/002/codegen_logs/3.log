+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+MAROON = 9
+PALETTE = (BLUE, GREEN, ORANGE, MAROON)
+CARDINALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SLOT_NAMES = ("tl", "tr", "bl", "br")
+GEN_ATTEMPTS = 400
