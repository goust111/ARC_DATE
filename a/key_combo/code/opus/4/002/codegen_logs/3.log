+    _mirror_payloads(out, scenes)
+    ray_infos: list[dict] = []
+    for scene in scenes:
+        for source in scene["sources"]:
+            cells, stop = _trace_ray(out, source, scene["marker"])
+            ray_infos.append(
+                {
+                    "marker": scene["marker"],
+                    "source_color": int(source["color"]),
+                    "tag": source.get("tag"),
+                    "cells": cells,
+                    "stop": stop,
+                    "direction": _ray_direction(scene["marker"], source["coords"]),
+                }
+            )
+    return out, ray_infos
