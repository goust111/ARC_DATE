+def _mirror_payloads(out: np.ndarray, scenes: list[dict]) -> None:
+    h, w = out.shape
+    for scene in scenes:
+        payload = scene["payload"]
+        mirrored = _reflect_coords(payload["coords"], scene["marker"])
+        for r, c in mirrored:
+            if 0 <= r < h and 0 <= c < w and int(out[r, c]) == BG:
+                out[r, c] = int(payload["color"])
