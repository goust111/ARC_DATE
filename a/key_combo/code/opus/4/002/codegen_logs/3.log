+def _reflect_coords(coords: np.ndarray, marker: tuple[int, int]) -> np.ndarray:
+    mr, mc = map(int, marker)
+    reflected = [(2 * mr - int(r), 2 * mc - int(c)) for r, c in coords]
+    return _sorted_coords(reflected)
