+def find_components(
+    grid: np.ndarray,
+    *,
+    ignored: set[int] | None = None,
+) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    ignored = {BG} if ignored is None else {int(v) for v in ignored}
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) in ignored:
+                continue
+            color = int(g[r, c])
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds((h, w), nr, nc) or seen[nr, nc]:
+                        continue
+                    if int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    queue.append((nr, nc))
+            coords = _sorted_coords(cells)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    comps.sort(key=lambda comp: (comp["bbox"][0], comp["bbox"][1], comp["color"]))
+    return comps
