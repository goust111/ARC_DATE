+def _paint_scene_input(grid: np.ndarray, scene: dict) -> bool:
+    h, w = grid.shape
+    mr, mc = scene["marker"]
+    if not in_bounds((h, w), mr, mc) or int(grid[mr, mc]) != BG:
+        return False
+    grid[mr, mc] = RED
+    for comp in [scene["payload"], *scene["sources"]]:
+        for r, c in comp["coords"]:
