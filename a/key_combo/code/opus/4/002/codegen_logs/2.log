+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLUE = 1
+YELLOW = 4
+GREY = 5
+PINK = 6
+PATTERN_COLORS = (BLUE, YELLOW)
+
+MAX_ENUM_UNKNOWN = 12
+GENERATION_ATTEMPTS = 500
+TILE_ATTEMPTS = 200
+MIN_PINK_PCT = 15
