+    col_count = random.choice([2, 3])
+    col_sizes = [random.randint(4, 8) for _ in range(col_count)]
+
+    height = sum(row_sizes) + len(row_sizes) - 1
+    width = sum(col_sizes) + len(col_sizes) - 1
+    if max(height, width) > 30:
