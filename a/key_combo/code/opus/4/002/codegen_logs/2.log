+
+    preserve: set[tuple[int, int]] = {random.choice(coords) for coords in groups.values()}
+    for info in partition_infos:
+        preserve.add(random.choice(info["coords"]))
+
+    flip_options: list[tuple[int, dict, list[tuple[int, int]]]] = []
+    for info in partition_infos:
