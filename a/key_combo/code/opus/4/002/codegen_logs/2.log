+
+
+def _random_tile() -> np.ndarray | None:
+    row_period = random.randint(2, 4)
+    col_period = random.randint(2, 4)
+    area = row_period * col_period
+    low = max(1, area // 3)
+    high = min(area - 1, area - area // 3)
+    for _ in range(TILE_ATTEMPTS):
