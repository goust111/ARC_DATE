+
+    for c in range(1, start_anchor):
+        modes[c] = start_row
+    for c in range(end_anchor + 1, int(box_w) - 1):
+        modes[c] = end_row
+
+    for c, mode in modes.items():
+        if mode == 0:
+            continue
