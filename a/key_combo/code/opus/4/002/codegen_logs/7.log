+    work = np.full((work_h, work_w), BLACK, dtype=int)
+    colors = random.sample(SOURCE_COLORS, 3)
+    bend_triplet = list(random.choice(BEND_TRIPLETS))
+
+    metas: list[dict] = []
+    r0 = top
+    for idx, (color, bends) in enumerate(zip(colors, bend_triplet)):
