+        bends = int(meta["bends"])
+        if bends > 0:
+            out[row, sep + 1 : sep + 1 + bends] = int(meta["color"])
+    return out
+
+
+def _validate_sample(grid: np.ndarray, metas: list[dict]) -> None:
+    assert isinstance(grid, np.ndarray)
+    assert grid.ndim == 2 and max(grid.shape) <= 30
