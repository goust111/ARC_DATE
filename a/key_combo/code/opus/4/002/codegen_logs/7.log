+    grid = np.full((work_h, work_w + 4), BLACK, dtype=int)
+    grid[:, :work_w] = work
+    grid[:, work_w] = GREY
+    metas.sort(key=lambda meta: meta["top_left"])
+    return grid, metas
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
