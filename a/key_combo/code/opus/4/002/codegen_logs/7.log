+    assert [info["bends"] for info in infos] == [meta["bends"] for meta in metas]
+    assert all(info["optimal_path_count"] == 1 for info in infos), "paths must be uniquely determined"
+    assert all(0 <= info["bends"] <= 3 for info in infos)
