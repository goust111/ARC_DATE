+from __future__ import annotations
+
+import heapq
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+SOURCE_COLORS = (RED, GREEN, YELLOW, ORANGE)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+START_DIR = 4
+
