+    planned.sort(key=lambda spec: spec[0] * spec[1], reverse=True)
+    targets: list[dict] = []
+    for h, w, local_gap in planned:
+        placed = _place_target_spec((grid_h, grid_w), place_block, occupied_bbox, ray_block, h, w, local_gap)
