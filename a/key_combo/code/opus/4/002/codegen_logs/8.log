+def _sample_gap_color(stretched: np.ndarray, local_gap: tuple[int, int], outer: int) -> int:
+    gh, gw = stretched.shape
+    r, c = map(int, local_gap)
+    if r == 0:
+        color = int(stretched[0, c - 1])
+    elif r == gh + 1:
+        color = int(stretched[-1, c - 1])
+    elif c == 0:
+        color = int(stretched[r - 1, 0])
