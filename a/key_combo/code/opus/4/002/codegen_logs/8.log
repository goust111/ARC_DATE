+    expected = _render_expected(grid, inner, targets)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if not _semantic_checks(grid, expected, inner, targets):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
