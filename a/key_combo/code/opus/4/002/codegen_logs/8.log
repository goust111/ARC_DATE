+
+def _transform_inner() -> np.ndarray:
+    inner = BASE_INTERIOR.copy()
+    if random.random() < 0.5:
+        inner = np.flipud(inner)
+    if random.random() < 0.5:
+        inner = np.fliplr(inner)
+    if random.random() < 0.5:
+        inner = inner.T
