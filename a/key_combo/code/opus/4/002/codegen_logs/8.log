+
+def _target_gap(patch: np.ndarray, bg: int) -> tuple[tuple[int, int], int] | None:
+    h, w = patch.shape
+    if h < 5 or w < 5:
+        return None
+    if np.any(patch[1:-1, 1:-1] == int(bg)):
+        return None
