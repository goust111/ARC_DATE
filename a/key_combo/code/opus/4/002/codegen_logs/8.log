+    perm_src = [1, 3, 4]
+    perm_dst = perm_src[:]
+    random.shuffle(perm_dst)
+    mapped = inner.copy()
+    for src, dst in zip(perm_src, perm_dst):
+        mapped[inner == int(src)] = int(dst)
+    return mapped
