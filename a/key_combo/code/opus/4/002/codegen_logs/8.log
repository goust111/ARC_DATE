+        colors.add(color)
+
+        border = out[r0 : r1 + 1, c0 : c1 + 1].copy()
+        border[1:-1, 1:-1] = OUTER
+        border[target["local_gap"]] = OUTER
+        if not np.all(border == OUTER):
