+        r, c = r0 + local_gap[0], c0 + local_gap[1]
+        while 0 <= r < h_grid and 0 <= c < w_grid:
+            assert int(g[r, c]) == scene["bg"], "ray path must be empty in the input"
+            out[r, c] = color
+            r += dr
+            c += dc
+
+    return out
