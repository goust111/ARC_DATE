+            if r in (0, h - 1) and c in (0, w - 1):
+                return None
+            holes.append((int(r), int(c)))
+
+    if len(holes) != 1:
+        return None
+
+    non_bg = [int(v) for v in patch.ravel() if int(v) != int(bg)]
+    if len(non_bg) != h * w - 1:
+        return None
+    colors = set(non_bg)
+    if len(colors) != 1:
+        return None
+    return holes[0], next(iter(colors))
