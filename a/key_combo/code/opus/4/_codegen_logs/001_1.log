    out = np.full((H, W), bg, dtype=int)
    _paint_mask(out, sprite, sr, sc, sprite_color, bg)
    _paint_mask(out, flipped, mr, mc, anchor_color, bg)

    # Build input
    inp = np.full((H, W), bg, dtype=int)
