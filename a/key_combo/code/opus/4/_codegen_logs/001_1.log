    # Oracle validation
    comps = find_components(inp, bg=bg, connectivity=8, monochromatic=True)
    if len(comps) != 2:
        return None
    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
        return None
    return inp


