+        objects.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "h": int(h),
+                "w": int(w),
+                "color": int(body),
+                "marker": (mr, mc),
+                "direction": (slot_r - 1, slot_c - 1),
+            }
+        )
