+    for spec in sorted(specs, key=lambda s: (s.r0, s.c0)):
+        for r0, c0 in _trajectory_stats(spec.r0, spec.c0, spec.h, spec.w, spec.slot_r, spec.slot_c, shape)["positions"]:
