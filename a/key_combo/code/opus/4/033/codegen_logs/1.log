+                    r0=r0,
+                    c0=c0,
+                    h=h,
+                    w=w,
+                    color=int(color),
+                    marker_r=marker_r,
+                    marker_c=marker_c,
+                    copies=copies,
+                    clipped=clipped,
+                )
+            )
+
+    rng.shuffle(candidates)
+    return candidates
+
+
+def _validate_specs(specs: list[RectSpec], shape: tuple[int, int], need_center: bool, need_clipped: bool) -> bool:
+    if not (3 <= len(specs) <= 5):
