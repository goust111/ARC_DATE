+def _render_input(specs: list[RectSpec], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.full(shape, BACKGROUND, dtype=int)
+    for spec in specs:
+        grid[spec.r0 : spec.r0 + spec.h, spec.c0 : spec.c0 + spec.w] = spec.color
