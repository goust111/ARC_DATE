NOISE_COMPONENT_TAIL_BUFFER = 2
NOISE_SEED_TRY_LIMIT = 80
NOISE_FRONTIER_RANDOM_WEIGHT = 1.5
NEIGHBORS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

