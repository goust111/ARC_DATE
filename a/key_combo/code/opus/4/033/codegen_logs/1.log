+
+def _sample_template(index: int, need_center: bool, need_clipped: bool, rng: np.random.Generator) -> dict:
+    if index == 0:
+        h, w = random.choice(((3, 6), (6, 3)))
+        slot_r, slot_c = random.choice(DIAGONAL_SLOTS)
