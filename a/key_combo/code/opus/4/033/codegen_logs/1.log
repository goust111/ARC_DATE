+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q: deque[tuple[int, int]] = deque([(r, c)])
+        coords: list[tuple[int, int]] = []
+        while q:
