+
+BACKGROUND = 0
+MARKER = 4
+BODY_COLORS = (1, 2, 3, 5, 6, 7, 8)
+SIZE_CHOICES = (3, 6)
+DIRECTION_SLOTS = tuple((sr, sc) for sr in range(3) for sc in range(3))
