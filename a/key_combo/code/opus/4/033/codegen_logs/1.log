+    return {
+        "footprint": footprint,
+        "positions": positions,
+        "copies": int(copies),
+        "full_copies": int(full_copies),
+        "clipped": bool(clipped),
+    }
+
+
+def _boxes_touch(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int], padding: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = box_a
+    br0, bc0, br1, bc1 = box_b
+    return not (
