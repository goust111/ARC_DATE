+        lo = 1
+        hi = grid_width - width - slope * (motif_rows - 1)
+    else:
+        lo = 1 - slope * (motif_rows - 1)
+        hi = grid_width - width
+    if lo > hi:
+        return None
+    return int(lo), int(hi)
