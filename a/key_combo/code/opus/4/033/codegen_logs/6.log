+            lo, hi = bounds
+            start = int(rng.integers(lo, hi + 1))
+            color = int(palette[int(rng.integers(len(palette)))])
+            track_specs.append((start, slope, width, color))
+
+        if len(track_specs) < 2:
+            continue
+
