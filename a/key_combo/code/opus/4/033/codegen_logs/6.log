+def _motif_row_count(grid: np.ndarray) -> int:
+    count = 0
+    while count < grid.shape[0] and int(grid[count, 0]) == Color.GREY:
+        count += 1
+    assert count >= 3, "expected at least three grey-delimited motif rows"
+    return count
