+
+def _last_non_obstacle_foreground_row(grid: np.ndarray) -> int:
+    rows = np.flatnonzero(np.any((grid != Color.BLACK) & (grid != Color.ORANGE), axis=1))
+    assert rows.size > 0, "expected some non-obstacle foreground content"
+    return int(rows[-1])
