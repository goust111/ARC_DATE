+from __future__ import annotations
+
+from pathlib import Path
+import sys
+
+import numpy as np
+
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if _ARC_UTILS_DIR.exists():
+    sys.path.insert(0, str(_ARC_UTILS_DIR))
