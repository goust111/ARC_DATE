                item = (r, c, h, w, per_direction)
                fallback_options.append(item)
                if target in per_direction:
                    options.append(item)

    if options:
        return options

    near_target = [item for item in fallback_options if min(abs(x - target) for x in item[4]) <= TARGET_FALLBACK_TOLERANCE]
