+        assert obstacle_row < end_row
+        assert np.any(actual[obstacle_row + 1 : end_row + 1] != wrong[obstacle_row + 1 : end_row + 1])
+
+    return True
+
+
+def _attempt_generate(rng: np.random.Generator) -> np.ndarray | None:
+    motif_rows = int(rng.integers(3, 6))
