+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(15, 22)
+    w = rng.randint(15, 22)
+    grid = np.full((h, w), BLACK, dtype=int)
+
+    top = rng.randint(1, 3)
+    left = rng.randint(1, 3)
