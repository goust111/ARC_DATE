+
+def _place_cross(grid: np.ndarray, center: tuple[int, int], color: int) -> set[tuple[int, int]]:
+    cells = set(_cross_cells(center))
+    for r, c in cells:
+        grid[r, c] = color if (r, c) != center else YELLOW
