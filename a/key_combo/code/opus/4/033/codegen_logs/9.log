+    for _ in range(300):
+        shapes.clear()
+        keys.clear()
+        areas = [random.randint(4, 6) for _ in range(count)]
+        ok = True
+        for area in areas:
+            shape = _generate_shape(area)
+            if shape is None:
+                ok = False
+                break
+            key = _canonical_shape_key(shape)
+            if key in keys:
+                ok = False
