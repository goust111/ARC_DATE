+def _make_frame_patch(shape: np.ndarray, color: int) -> tuple[np.ndarray, tuple[int, int]]:
+    sh, sw = shape.shape
+    inner_h = sh + random.randint(1, 3)
+    inner_w = sw + random.randint(1, 3)
+    patch = np.zeros((inner_h + 2, inner_w + 2), dtype=int)
+    patch[0, :] = GRAY
+    patch[-1, :] = GRAY
+    patch[:, 0] = GRAY
+    patch[:, -1] = GRAY
