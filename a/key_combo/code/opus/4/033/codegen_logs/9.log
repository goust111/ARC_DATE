+    rel = coords - np.array([r0, c0], dtype=int)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return mask
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, int], tuple[tuple[int, int], ...]]:
