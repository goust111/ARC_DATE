+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+GRAY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+TRANSFORM_NAMES = ("id", "rot90", "rot180", "rot270", "flip", "flip_rot90", "flip_rot180", "flip_rot270")
