+
+def _iter_patch_cells(patch: np.ndarray, top: int, left: int) -> list[tuple[int, int, int]]:
+    cells: list[tuple[int, int, int]] = []
+    for r, c in np.argwhere(patch != BG):
+        cells.append((top + int(r), left + int(c), int(patch[r, c])))
+    return cells
