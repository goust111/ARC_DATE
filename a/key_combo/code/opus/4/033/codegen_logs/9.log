        _paint_shrinking_rows(out, r1, 1, bottom_c0, bottom_c1, bg)
        _paint_shrinking_cols(out, c0, -1, left_r0, left_r1, bg)
        _paint_shrinking_cols(out, c1, 1, right_r0, right_r1, bg)

