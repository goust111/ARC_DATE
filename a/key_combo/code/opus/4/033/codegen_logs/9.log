+
+def _extract_references(grid: np.ndarray, frame_comps: list[np.ndarray]) -> dict[tuple[tuple[int, int], tuple[tuple[int, int], ...]], int]:
+    mapping: dict[tuple[tuple[int, int], tuple[tuple[int, int], ...]], int] = {}
