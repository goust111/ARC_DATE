+    if np.any(grid[top : top + h, left : left + w][shape] != Color.BLACK):
+        return False
+    new_box = (top, left, top + h - 1, left + w - 1)
+    for box in boxes:
+        row_gap, col_gap = _bbox_gap(new_box, box)
+        if row_gap < min_gap and col_gap < min_gap:
+            return False
+    return True
