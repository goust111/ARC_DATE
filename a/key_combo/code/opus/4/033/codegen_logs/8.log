+    min_comp = min(survivors, key=lambda comp: int(comp["area"]))
+    out[max_comp["coords"][:, 0], max_comp["coords"][:, 1]] = Color.BLUE
+    out[min_comp["coords"][:, 0], min_comp["coords"][:, 1]] = Color.RED
