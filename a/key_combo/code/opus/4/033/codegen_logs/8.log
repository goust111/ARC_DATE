+        if not placed:
+            return None
+
+    spot = _find_between_singleton_spot(grid, boxes)
+    if spot is None:
+        return None
+    reserved = {spot}
+    grid[spot] = Color.GREY
+
+    if not _place_random_singletons(grid, single_count - 1, reserved):
+        return None
+
+    if not _semantic_checks(grid):
+        return None
+    return grid
