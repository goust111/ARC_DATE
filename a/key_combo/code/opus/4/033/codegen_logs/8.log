+    for nr in range(max(0, r - 1), min(h, r + 2)):
+        for nc in range(max(0, c - 1), min(w, c + 2)):
+            if (nr != r or nc != c) and grid[nr, nc] == Color.GREY:
+                return False
+    return True
+
+
+def _place_random_singletons(
+    grid: np.ndarray,
+    count: int,
+    reserved: set[tuple[int, int]],
+) -> bool:
+    h, w = grid.shape
