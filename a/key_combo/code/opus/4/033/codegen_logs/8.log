+def _gray_components(grid: np.ndarray) -> list[dict]:
+    return find_components(
+        np.asarray(grid, dtype=int),
+        bg=Color.BLACK,
+        connectivity=4,
+        monochromatic=True,
+        colors=[Color.GREY],
+        return_format="dict",
+    )
