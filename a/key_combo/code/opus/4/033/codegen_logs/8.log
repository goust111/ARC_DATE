+
+
+def _shape_rectangle(area: int) -> np.ndarray:
+    factors = [(h, area // h) for h in range(2, area + 1) if area % h == 0 and area // h >= 2]
+    if not factors:
+        return _shape_line(area)
+    h, w = random.choice(factors)
+    return np.ones((h, w), dtype=bool)
