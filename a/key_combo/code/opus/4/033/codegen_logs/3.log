+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+MARKER = 9
+FRAME_COLORS = (1, 2, 3, 7, 8)
+MAX_GEN_ATTEMPTS = 500
+
+
+@dataclass(frozen=True)
+class Frame:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+    color: int
+
+    @property
+    def height(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def width(self) -> int:
+        return self.c1 - self.c0 + 1
+
+    @property
+    def area(self) -> int:
+        return self.height * self.width
+
+    def contains_interior(self, r: int, c: int) -> bool:
+        return self.r0 < r < self.r1 and self.c0 < c < self.c1
+
+    def border_cells(self) -> set[tuple[int, int]]:
+        pts: set[tuple[int, int]] = set()
+        for cc in range(self.c0, self.c1 + 1):
+            pts.add((self.r0, cc))
+            pts.add((self.r1, cc))
+        for rr in range(self.r0, self.r1 + 1):
+            pts.add((rr, self.c0))
+            pts.add((rr, self.c1))
+        return pts
