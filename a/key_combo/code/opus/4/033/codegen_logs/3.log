+    return candidates
+
+
+def _find_collision_pair(candidates: list[dict[str, object]]) -> list[dict[str, object]] | None:
+    for i in range(len(candidates)):
+        for j in range(i + 1, len(candidates)):
+            a = candidates[i]
+            b = candidates[j]
+            if a["target"] != b["target"]:
