+    for _ in range(300):
+        marker_count = int(rng.integers(4, 7))
+        selected: list[dict[str, object]] = []
+        used_sources: set[tuple[int, int]] = set()
+        used_targets: dict[tuple[int, int], int] = {}
+        collision_target: tuple[int, int] | None = None
