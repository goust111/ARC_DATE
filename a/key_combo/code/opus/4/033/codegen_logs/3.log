+def _distances_to_interior_edges(frame: Frame, r: int, c: int) -> dict[str, int]:
+    return {
+        "left": c - (frame.c0 + 1),
+        "right": (frame.c1 - 1) - c,
+        "top": r - (frame.r0 + 1),
+        "bottom": (frame.r1 - 1) - r,
+    }
