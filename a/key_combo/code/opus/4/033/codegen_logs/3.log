+def _validate_scene(grid: np.ndarray, frames: list[Frame], markers: list[dict[str, object]]) -> bool:
+    parsed = _extract_frames(grid)
+    if [(f.r0, f.c0, f.r1, f.c1, f.color) for f in parsed] != [
