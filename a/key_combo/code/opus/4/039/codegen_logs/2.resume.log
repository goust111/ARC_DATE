0067: GEN_CELL_HEIGHTS, GEN_CELL_WIDTHS = range(2, 12), range(1, 5)
0068: GEN_OBJECT_HEIGHT_MIN, GEN_OBJECT_HEIGHT_MAX = 7, 13
0069: GEN_OBJECT_WIDTH_MIN, GEN_OBJECT_WIDTH_MAX = 5, 9
