0404: def find_components(
0405:     grid: np.ndarray,
0406:     *,
0407:     bg: int | None = None,
0408:     connectivity: int = 4,
0409:     monochromatic: bool = True,
0410:     colors: Sequence[int] | None = None,
0411:     min_area: int = 1,
0412:     return_format: str = "dict",
0413: ) -> list[dict] | list[np.ndarray]:
0414:     """
0415:     Find connected components in a grid (unified API for ARC-2 + migrated seeds).
0416: 
0417:     return_format:
0418:       - \"dict\": list of dicts {color, coords, bbox, area}
0419:       - \"objects\": list of full-grid arrays containing exactly one component
0420:     """
0421:     if bg is None:
0422:         bg = get_bg(grid)
0423:     bg = int(bg)
0424: 
0425:     return_format = str(return_format).lower().strip()
0426:     if return_format not in {"dict", "objects"}:
0427:         raise ValueError("find_components: return_format must be 'dict' or 'objects'")
0428: 
0429:     if colors is None:
0430:         colors_set = None
0431:         colors_iter = sorted(set(map(int, grid.flatten())) - {bg})
0432:     else:
0433:         colors_set = {int(c) for c in colors}
0434:         colors_iter = [int(c) for c in colors_set if int(c) != bg]
0435: 
0436:     # Monochromatic = label per-color
0437:     if monochromatic:
0438:         if return_format == "dict":
0439:             out: list[dict] = []
0440:             for col in colors_iter:
0441:                 mask = (grid == col)
0442:                 if not mask.any():
0443:                     continue
0444:                 comps = components_mask(mask, connectivity=connectivity)
0445:                 for coords in comps:
0446:                     if int(coords.shape[0]) < int(min_area):
0447:                         continue
0448:                     out.append(
0449:                         {
0450:                             "color": int(col),
0451:                             "coords": coords,
0452:                             "bbox": bbox_coords(coords),
0453:                             "area": int(coords.shape[0]),
0454:                         }
0455:                     )
0456:             return out
0457: 
0458:         objs: list[np.ndarray] = []
0459:         struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
0460:         for col in colors_iter:
0461:             lab, n = label(grid == int(col), structure=struct)
0462:             for k in range(1, int(n) + 1):
0463:                 m = (lab == k)
0464:                 if int(m.sum()) < int(min_area):
0465:                     continue
0466:                 obj = np.full_like(grid, bg)
0467:                 obj[m] = int(col)
0468:                 objs.append(obj)
0469:         return objs
0470: 
0471:     # Multicolor components = label foreground as a whole
0472:     struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
0473:     if colors_set is None:
0474:         fg_mask = (grid != bg)
0475:     else:
0476:         fg_mask = (grid != bg) & np.isin(grid, list(colors_set))
0477: 
0478:     lab, n = label(fg_mask, structure=struct)

