0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """Paint teal square blocks at the two outward opposite corners of each diagonal foreground motif.
0024: 
0025:     Input structure
0026:     - The canvas has one background color and one foreground color.
0027:     - Each 8-connected foreground object has a square bounding box split into a 2-by-2 grid of equal square blocks.
0028:     - Exactly two diagonal blocks of that footprint are filled with the foreground color; the other two are background.
0029: 
0030:     Rule
0031:     - Preserve the input.
0032:     - If the filled blocks are northwest/southeast, paint teal blocks just outside the northeast and southwest corners.
0033:     - If the filled blocks are northeast/southwest, paint teal blocks just outside the northwest and southeast corners.
0034:     - Clip any painted block at the grid boundary.
0035: 
0036:     Key insight
0037:     - The green pixels are scaled square blocks; the task completes the perpendicular diagonal of the expanded block layout.
0038:     """
0039:     g = np.asarray(grid, dtype=int)
0040:     bg = get_bg(g)
0041:     source_colors = colors_present(g, exclude={bg})
0042:     assert len(source_colors) == 1
0043:     source_color = int(source_colors[0])
0044:     assert source_color != Color.TEAL
0045: 
0046:     out = g.copy()
0047:     components = find_components(
0048:         g,
0049:         bg=bg,
0050:         colors=[source_color],
0051:         connectivity=8,
0052:         monochromatic=False,
0053:     )
0054:     assert components
0055: 
0056:     for comp in components:
0057:         r0, c0, r1, c1 = map(int, comp["bbox"])
0058:         h = bbox_h(comp["bbox"])
0059:         w = bbox_w(comp["bbox"])
0060:         assert h == w and h % 2 == 0
0061:         size = h // 2
0062: 
0063:         sub = g[r0 : r1 + 1, c0 : c1 + 1]
0064:         occupied: set[tuple[int, int]] = set()
0065:         for br in range(2):
0066:             for bc in range(2):
0067:                 block = sub[br * size : (br + 1) * size, bc * size : (bc + 1) * size]
0068:                 if np.all(block == source_color):
0069:                     occupied.add((br, bc))
0070:                 else:
0071:                     assert np.all(block == bg)
0072: 
0073:         if occupied == {(0, 0), (1, 1)}:
0074:             targets = [(r0 - size, c1 + 1), (r1 + 1, c0 - size)]
0075:         else:
0076:             assert occupied == {(0, 1), (1, 0)}
0077:             targets = [(r0 - size, c0 - size), (r1 + 1, c1 + 1)]
0078: 
0079:         for rr, cc in targets:
0080:             _paste_teal_block(out, rr, cc, size, bg)
0081: 
0082:     return out
