0051: def main(grid: np.ndarray) -> np.ndarray:
0052:     """
0053:     Replace the missing-marker cells so the whole grid has matching horizontal and vertical reflections.
0054: 
0055:     Input structure:
0056:     - The grid is a complete reflection-symmetric pattern except for cells of one marker color.
0057:     - Under reflection across the horizontal and vertical center lines, each orbit has exactly one non-marker color.
0058:     - The marker color is structurally unique: treating any other color as missing breaks at least one orbit.
0059: 
0060:     Rule:
0061:     - Group cells by their four-way reflection orbit: original, vertical mirror, horizontal mirror, and 180-degree mirror.
0062:     - Infer the unique marker color whose removal leaves one known color in every orbit.
0063:     - Fill every cell in each orbit with that known color.
0064: 
0065:     Key insight:
0066:     - The yellow cells are not objects to move; they are holes in a two-axis mirror pattern, and their values are copied from the visible cells in the same reflection orbit.
0067:     """
0068:     g = np.asarray(grid, dtype=int)
0069:     assert g.ndim == 2, "expected a 2D grid"
0070: 
0071:     orbits = _reflection_orbits(g.shape)
0072:     marker = _missing_color(g, orbits)
0073: 
0074:     out = g.copy()
0075:     for orbit in orbits:
0076:         known = {int(g[r, c]) for r, c in orbit if int(g[r, c]) != marker}
0077:         assert len(known) == 1, "each reflection orbit must reveal exactly one fill color"
0078:         fill = known.pop()
0079:         for r, c in orbit:
0080:             out[r, c] = fill
0081: 
0082:     return out
