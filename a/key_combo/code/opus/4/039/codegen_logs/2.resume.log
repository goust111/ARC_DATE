0013: def main(input_grid):
0014:     """
0015:     Color selected divider-bounded regions by their relative positions.
0016: 
0017:     Input structure:
0018:     - Gray lines partition a black canvas into multiple regions.
0019:     - At least three non-gray regions are present.
0020:     - Regions are selected by upper-left, middle, and lower-right position.
0021: 
0022:     Rule:
0023:     - Treat gray as the divider color and find connected regions between dividers.
0024:     - Fill the upper-left region blue and the lower-right region green.
0025:     - Fill the middle positional candidate red while leaving dividers unchanged.
0026: 
0027:     Key insight:
0028:     - The regions are not identified by shape; their sorted positions determine their colors.
0029:     """
0030:     divider = Color.GREY
0031:     regions = find_components(input_grid, bg=divider, connectivity=4, monochromatic=False, return_format="objects")
0032: 
0033:     bbs = []
0034:     for obj in regions:
0035:         b = bbox(obj != divider)
0036:         if b is not None:
0037:             bbs.append(b)
0038:     assert len(bbs) >= 3
0039: 
0040:     # Choose TL, BR, and "middle" by position.
0041:     bbs_sorted = sorted(bbs, key=lambda b: (b[0], b[1]))
0042:     tl = bbs_sorted[0]
0043:     br = max(bbs_sorted, key=lambda b: (b[0] + b[1]))
0044:     mid_candidates = [b for b in bbs_sorted if b not in (tl, br)]
0045:     mid = mid_candidates[len(mid_candidates) // 2]
0046: 
0047:     out = input_grid.copy()
0048:     for b, color in [(tl, Color.BLUE), (mid, Color.RED), (br, Color.GREEN)]:
0049:         r0, c0, r1, c1 = b
0050:         out[r0 : r1 + 1, c0 : c1 + 1] = int(color)
0051:     return out
0052: 
