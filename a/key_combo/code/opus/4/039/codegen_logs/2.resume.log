0037: def main(grid: np.ndarray) -> np.ndarray:
0038:     """
0039:     Extract the largest clean framed sprite whose foreground pattern is not duplicated.
0040: 
0041:     Input structure
0042:     - The grid has one dominant background color and two foreground colors.
0043:     - The foreground contains several same-size rectangular sprites with a one-cell frame.
0044:     - Extra foreground clutter may touch the outside of a sprite, and smaller framed subpatterns may occur inside repeated sprites.
0045: 
0046:     Rule
0047:     - Find clean rectangles whose border is one foreground color and whose interior contains no background.
0048:     - Keep only the largest such rectangles; these are the full source sprites.
0049:     - Among those sprites, return the single full sprite pattern that occurs exactly once.
0050: 
0051:     Key insight
0052:     The surrounding clutter is irrelevant once the maximal intact frames are detected; the task is an odd-one-out selection among the clean sprite patterns.
0053:     """
0054:     g = np.asarray(grid, dtype=int)
0055:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0056: 
0057:     bg = get_bg(g)
0058:     colors = colors_present(g, exclude={bg})
0059:     assert len(colors) == 2, "expected exactly two foreground colors"
0060: 
