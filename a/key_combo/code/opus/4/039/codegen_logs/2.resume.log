0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """Bend the single foreground lattice into a one-pixel horizontal wave anchored at its bottom row.
0015: 
0016:     Input structure
0017:     - The grid has a dominant background and exactly one foreground color.
0018:     - All foreground pixels form one 4-connected lattice-like object.
0019:     - Each row inside the foreground object's bounding box contains foreground pixels.
0020: 
0021:     Rule
0022:     - Keep the bottom row of the object's bounding box fixed.
0023:     - Moving upward from that bottom row, leave every other row fixed.
0024:     - Shift the intervening rows by one pixel, alternating left, right, left, right.
0025: 
0026:     Key insight
0027:     - The phase of the wave is determined from the bottom of the object, not from the top.
0028:     """
0029:     g = np.asarray(grid, dtype=int)
0030:     bg = get_bg(g)
0031:     fg_colors = colors_present(g, exclude={bg})
0032:     assert len(fg_colors) == 1
0033:     fg = fg_colors[0]
0034: 
0035:     mask = g != bg
0036:     assert len(components_mask(mask, connectivity=4)) == 1
0037:     box = bbox(mask)
0038:     assert box is not None
0039:     r0, _, r1, _ = box
0040: 
0041:     out = g.copy()
0042:     for r in range(r0, r1 + 1):
0043:         cols = np.flatnonzero(mask[r])
0044:         assert cols.size > 0
0045:         shift = _wave_shift(r1 - r)
0046:         if shift == 0:
0047:             continue
0048: 
0049:         new_cols = cols + shift
0050:         assert int(new_cols.min()) >= 0
0051:         assert int(new_cols.max()) < g.shape[1]
0052:         out[r, cols] = bg
0053:         assert bool(np.all(out[r, new_cols] == bg))
0054:         out[r, new_cols] = fg
0055: 
0056:     return out
0057: 
0058: # --------------- generator (o5x) ---------------
0059: 
0060: # Canvas, palette, and placement margins.
0061: GEN_GRID_ROW_BOUNDS, GEN_GRID_COL_BOUNDS = (13, 15), (14, 15)
0062: GEN_BG, GEN_NO_SHIFT, GEN_FG_BOUNDS = 0, 0, (1, 9)
0063: GEN_VERTICAL_MARGIN, GEN_HORIZONTAL_MARGIN = 1, 2
