0013: def main(input_grid):
0014:     """
0015:     Fill only square-shaped holes inside gray square objects with red.
0016: 
0017:     Input structure:
0018:     - The grid is black with multiple gray square objects.
0019:     - Each gray object may contain a contiguous black hole inside it.
0020:     - Some holes are solid square blocks and others are irregular.
0021: 
0022:     Rule:
0023:     - Detect each gray object and crop it to its bounding box.
0024:     - Compute the enclosed black interior mask.
0025:     - Recolor the hole red only when its bounding box is square and completely filled.
0026: 
0027:     Key insight:
0028:     - The decision is based on the hole's own geometry, not on the outer gray square.
0029:     """
0030:     # get the grey squares
0031:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0032:     output_grid = input_grid.copy()
0033: 
0034:     for obj in objects:
0035:         b = bbox(obj != Color.BLACK)
0036:         if b is None:
0037:             continue
0038:         r0, c0, r1, c1 = b
0039:         sprite = crop_bbox(obj, b)
0040: 
0041:         # Identify the black hole(s) inside the grey object.
0042:         hole_mask = (sprite == Color.BLACK) & object_interior(sprite, background=Color.BLACK)
0043: 
0044:         hb = bbox(hole_mask)
0045:         if hb is not None:
0046:             hr0, hc0, hr1, hc1 = hb
0047:             hh = hr1 - hr0 + 1
0048:             hw = hc1 - hc0 + 1
0049:             hole_crop = hole_mask[hr0 : hr1 + 1, hc0 : hc1 + 1]
0050:             if hh == hw and int(hole_crop.sum()) == hh * hw:
0051:                 sprite[hole_mask] = Color.RED
0052: 
0053:         output_grid = paste(output_grid, sprite, r0, c0, transparent=Color.BLACK)
0054: 
0055:     return output_grid
0056: 
