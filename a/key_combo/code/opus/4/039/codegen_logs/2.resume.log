0258: def bbox_anchor(b: BBox, *, anchor: str = "upper left") -> Coord:
0259:     """
0260:     Return an anchor point (r,c) for a bbox.
0261: 
0262:     anchor:
0263:         upper left/right, lower left/right,
0264:         center,
0265:         upper center, lower center,
0266:         left center, right center
0267:     """
0268:     anchor = anchor.lower().replace(" ", "").replace("top", "upper").replace("bottom", "lower")
0269:     r0, c0, r1, c1 = map(int, b)
0270:     h = bbox_h(b)
0271:     w = bbox_w(b)
0272: 
0273:     if anchor == "upperleft":
0274:         rr, cc = r0, c0
0275:     elif anchor == "upperright":
0276:         rr, cc = r0, c1
0277:     elif anchor == "lowerleft":
0278:         rr, cc = r1, c0
0279:     elif anchor == "lowerright":
0280:         rr, cc = r1, c1
0281:     elif anchor == "center":
0282:         rr, cc = r0 + (h - 1) / 2, c0 + (w - 1) / 2
0283:     elif anchor == "uppercenter":
0284:         rr, cc = r0, c0 + (w - 1) / 2
0285:     elif anchor == "lowercenter":
0286:         rr, cc = r1, c0 + (w - 1) / 2
0287:     elif anchor == "leftcenter":
0288:         rr, cc = r0 + (h - 1) / 2, c0
0289:     elif anchor == "rightcenter":
0290:         rr, cc = r0 + (h - 1) / 2, c1
0291:     else:
0292:         raise ValueError("bbox_anchor: invalid anchor")
0293: 
0294:     return int(round(rr)), int(round(cc))
