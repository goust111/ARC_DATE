+
+    marker_rows = None
+    for r0 in row_options:
+        choices = [r1 for r1 in row_options if r1 != r0]
+        if choices:
+            marker_rows = [r0, random.choice(choices)]
+            break
+    if marker_rows is None:
+        return None
+
+    markers = None
