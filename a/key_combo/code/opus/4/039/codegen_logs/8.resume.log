+def _pattern_counts() -> list[tuple[int, int]]:
+    if random.choice([True, False]):
+        reds = random.sample([2, 3], 2)
+        return [(1, reds[0]), (1, reds[1])]
+    blues = random.sample([2, 3], 2)
+    return [(blues[0], 1), (blues[1], 1)]
+
