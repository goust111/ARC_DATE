+    counts = {BLUE: 0, RED: 0}
+    r, c = marker
+    for dr, dc in DIRS.values():
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1]:
