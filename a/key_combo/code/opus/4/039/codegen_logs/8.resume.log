    comps = find_components(
        grid,
        bg=BG,
        colors=[MAROON],
        connectivity=4,
        monochromatic=True,
        return_format="dict",
    )
    markers = []
    for comp in comps:
        if int(comp["area"]) == 1:
            r, c = map(int, comp["coords"][0])
            markers.append((r, c))
    return sorted(markers)


