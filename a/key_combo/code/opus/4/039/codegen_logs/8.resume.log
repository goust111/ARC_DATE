+def _adjacent_counts(grid: np.ndarray, marker: tuple[int, int]) -> dict[int, int]:
+    counts = {BLUE: 0, RED: 0}
+    r, c = marker
+    for dr, dc in DIRS.values():
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < grid.shape[0] and 0 <= cc < grid.shape[1]:
+            value = int(grid[rr, cc])
