+    assert np.all(sprite[:, 0] == MAROON)
+    assert np.all(sprite[:, -1] == MAROON)
+    assert np.all(sprite[-1, :] == MAROON)
+    assert np.all(sprite[:-1, 1:-1] == BG)
+    width = w - 2
+    cavity = (r0, c0 + 1, r1 - 1, c1 - 1)
+    return {"bbox": bbox, "width": int(width), "cavity": cavity}
