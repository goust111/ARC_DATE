+def _make_container(inner_width: int, height: int) -> np.ndarray:
+    patch = np.zeros((height, inner_width + 2), dtype=int)
+    patch[:, 0] = MAROON
+    patch[:, -1] = MAROON
+    patch[-1, :] = MAROON
+    return patch
