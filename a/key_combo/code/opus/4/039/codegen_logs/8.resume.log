+def _max_distance(top_h: int, shape: tuple[int, int], marker: tuple[int, int], direction: str) -> int:
+    r, c = marker
+    h, w = shape
+    if direction == "N":
+        return r
+    if direction == "S":
+        return top_h - 1 - r
+    if direction == "W":
+        return c
+    if direction == "E":
