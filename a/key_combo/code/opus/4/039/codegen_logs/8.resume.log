+            dr, dc = DIRS[direction]
+            options = []
+            for dist in range(2, max_d + 1):
+                rr = marker[0] + dr * dist
+                cc = marker[1] + dc * dist
+                if direction in ("E", "W") and cc == other[1]:
+                    continue
+                if direction in ("N", "S") and rr == other[0]:
+                    continue
