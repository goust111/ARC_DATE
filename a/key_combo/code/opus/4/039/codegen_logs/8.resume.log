+def _place_sources(
+    grid: np.ndarray,
+    top_h: int,
+    markers: list[tuple[int, int]],
+    counts: list[tuple[int, int]],
+) -> list[dict] | None:
+    sources: list[dict] = []
+    occupied = {marker for marker in markers}
