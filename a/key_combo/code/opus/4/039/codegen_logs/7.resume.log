+    if quadrant is not None:
+        anchor_r, anchor_c = _hole_anchor(quadrant)
+        mask = spec["hole_mask"]
+        sprite[anchor_r : anchor_r + 2, anchor_c : anchor_c + 2][mask] = BLACK
