+
+def _hole_spec(r0: int, c0: int, color: int, quadrant: str) -> dict:
+    return {
+        "r0": int(r0),
+        "c0": int(c0),
+        "size": HOLE_SIZE,
+        "color": int(color),
+        "hole_quadrant": quadrant,
+        "hole_mask": random.choice(HOLE_MASKS).copy(),
