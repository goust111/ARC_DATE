+def _paste_block(dst: np.ndarray, r0: int, c0: int, size: int, color: int) -> None:
+    h, w = dst.shape
+    rr0 = max(0, int(r0))
+    cc0 = max(0, int(c0))
+    rr1 = min(h, int(r0) + int(size))
+    cc1 = min(w, int(c0) + int(size))
