+    *,
+    anchor_from_bottom: bool,
+    shift_rule,
+) -> tuple[tuple[int, int], ...]:
+    r0, _, r1, _ = _bbox_from_coords(coords)
+    h, w = grid_shape
+    out = set()
+    for r, c in coords:
+        distance = (r1 - r) if anchor_from_bottom else (r - r0)
