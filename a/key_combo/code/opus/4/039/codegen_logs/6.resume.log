+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FG = 5
+MAX_GEN_ATTEMPTS = 500
+MAX_SHAPE_ATTEMPTS = 400
+MAX_PLACEMENT_ATTEMPTS = 160
+
+GROUP_PATTERNS = (
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+    (2, 2, 2),
+)
