+def _marker_lines(grid: np.ndarray) -> tuple[set[int], set[int]]:
+    h, w = grid.shape
+    horizontal_rows: set[int] = set()
+    vertical_cols: set[int] = set()
+    for r, c in np.argwhere(grid == ORANGE):
