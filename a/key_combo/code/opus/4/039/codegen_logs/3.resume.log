+    assert all(r1 - r0 + 1 == TILE_SIZE for r0, r1 in row_bands), "expected 3-row tile bands"
+    assert all(c1 - c0 + 1 == TILE_SIZE for c0, c1 in col_bands), "expected 3-col tile bands"
