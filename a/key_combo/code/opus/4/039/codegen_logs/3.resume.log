+    grid = np.zeros((tile_rows * STRIDE + 1, tile_cols * STRIDE + 1), dtype=int)
+    idx = 0
+    for tr in range(tile_rows):
+        for tc in range(tile_cols):
+            r0 = 1 + tr * STRIDE
+            c0 = 1 + tc * STRIDE
