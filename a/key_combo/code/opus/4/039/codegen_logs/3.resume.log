+def _render_tiles(tile_patterns: list[np.ndarray], tile_rows: int, tile_cols: int) -> np.ndarray:
+    grid = np.zeros((tile_rows * STRIDE + 1, tile_cols * STRIDE + 1), dtype=int)
+    idx = 0
