+    patch[-1, :] = 1
+    patch[:, 0] = 1
+    patch[:, -1] = 1
+
+    if hole_count == 0:
+        gap_side = random.randrange(4)
+        gap_pos = random.randint(1, size - 2)
+        if gap_side == 0:
+            patch[0, gap_pos] = 0
+        elif gap_side == 1:
+            patch[gap_pos, -1] = 0
+        elif gap_side == 2:
+            patch[-1, gap_pos] = 0
+        else:
+            patch[gap_pos, 0] = 0
+    elif hole_count == 1:
+        patch[1 : size - 2, 1] = 1
+        patch[1, 1 : min(size - 1, 3)] = 1
+    elif hole_count == 2:
+        divider = 2
+        patch[:, divider] = 1
+        patch[1, 1:divider] = 1
+    elif hole_count == 3:
+        divider = 2
+        patch[:, divider] = 1
+        patch[size // 2, : divider + 1] = 1
+        patch[1, divider + 1 : size - 1] = 1
