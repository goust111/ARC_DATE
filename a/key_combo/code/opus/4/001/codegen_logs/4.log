+def _fill_cavities(base: np.ndarray, sprites: list[dict]) -> np.ndarray:
+    out = base.copy()
+    sprite_lookup: dict[tuple[int, int], int] = {}
+    for idx, sprite in enumerate(sprites):
+        for coord in sprite["coords"]:
