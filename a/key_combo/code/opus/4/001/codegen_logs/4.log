+        for r, c in comp:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in neighbors4(rr, cc):
+                idx = sprite_lookup.get((int(nr), int(nc)))
+                if idx is not None:
+                    touching.add(idx)
