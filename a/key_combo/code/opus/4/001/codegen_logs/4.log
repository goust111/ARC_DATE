+B_REL_LARGE = ((0, 0), (1, 0), (2, 0), (2, 1), (3, 0), (3, 1))
+C_REL_LARGE = ((0, 0), (1, 0), (1, 1), (1, 2), (1, 3), (2, 3))
+C_REL_SMALL = ((0, 0), (1, 0), (1, 1), (1, 2), (0, 2))
