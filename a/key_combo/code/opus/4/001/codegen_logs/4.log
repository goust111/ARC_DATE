+    valid: list[dict] = []
+    for choice_tuple in itertools.product(*candidate_lists):
+        items = [dict(item) for item in choice_tuple]
+        if len({item["direction"] for item in items}) == 1:
+            continue
+        items.sort(key=lambda item: (int(item["bbox"][0]), int(item["bbox"][1])))
