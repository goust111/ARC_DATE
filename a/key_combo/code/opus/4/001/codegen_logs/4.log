        elif p[1]==c0-1 and r0 <= p[0] <= r1:
            side='left'
        elif p[1]==c1+1 and r0 <= p[0] <= r1:
            side='right'
        if side is None:
            continue
        cand.append((p,side,bbox(rem),tuple(sorted(rem))))
    return cand

def cavities(grid):
