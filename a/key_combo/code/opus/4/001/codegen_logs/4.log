+    H, W = map(int, shape)
+    dr, dc = DIRS[direction]
+    cur = set(body)
+    steps = 0
+    while True:
+        nxt = {(r + dr, c + dc) for r, c in cur}
+        if any(r < 0 or r >= H or c < 0 or c >= W for r, c in nxt):
+            return cur, steps
+        if nxt & blockers:
+            return cur, steps
+        cur = nxt
+        steps += 1
