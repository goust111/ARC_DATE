        return [(int(r + shift_r), int(c + shift_c)) for r, c in coords]

    obstacles = set(shift(OBSTACLES_CANONICAL))
    final_sprites = []
    for name in ("A", "B", "C"):
        coords = set(shift(final_bodies[name]))
        final_sprites.append(
            {
                "role": name,
                "color": int(colors[name]),
                "coords": coords,
                "area": len(coords),
                "bbox": _bbox(coords),
            }
        )

    inp = np.zeros((H, W), dtype=int)
    for r, c in obstacles:
        inp[r, c] = OBSTACLE
    for name in ("A", "B", "C"):
        for r, c in shift(input_bodies[name]):
            inp[r, c] = int(colors[name])
        mr, mc = markers[name]
        inp[mr + shift_r, mc + shift_c] = int(colors[name])

    final_base = _render_scene((H, W), obstacles, final_sprites)
    out = _fill_cavities(final_base, final_sprites)

    # Semantic checks from the intended construction, not from solver closure alone.
    assert len(_enclosed_zero_components(inp)) == 0, "input must not already contain enclosed cavities"
    final_cavities = _enclosed_zero_components(final_base)
    assert len(final_cavities) == 2, "the settled scaffold must yield exactly two cavities"
    assert len({dA, dB, dC}) >= 1 and len({"down", "down", "left"}) > 1

    left_touch = set()
    right_touch = set()
    sprite_lookup = {}
    for idx, sprite in enumerate(final_sprites):
        for coord in sprite["coords"]:
            sprite_lookup[coord] = idx
    for ridx, cavity in enumerate(final_cavities):
        touching = set()
        for r, c in cavity:
            for nr, nc in neighbors4(int(r), int(c)):
                idx = sprite_lookup.get((int(nr), int(nc)))
                if idx is not None:
                    touching.add(final_sprites[idx]["role"])
        if ridx == 0:
            left_touch = touching
        else:
            right_touch = touching
    assert left_touch == {"A"} or right_touch == {"A"}
    assert {"B", "C"} in (left_touch, right_touch)

    base_lookup = {sprite["role"]: sprite for sprite in final_sprites}
    if mode == 0:
        assert base_lookup["B"]["area"] < base_lookup["C"]["area"]
    elif mode == 1:
        assert base_lookup["B"]["area"] == base_lookup["C"]["area"]
    else:
        assert base_lookup["C"]["area"] < base_lookup["B"]["area"]

    # The third sprite must stop because of an already stopped sprite, not a grey obstacle.
    c_coords = final_sprites[2]["coords"]
    c_next = {(r - 0, c - 1) for r, c in c_coords}
    b_coords = final_sprites[1]["coords"]
    assert c_next & b_coords, "multi-sprite cavity must depend on ordered sprite collision"

    k = random.randint(0, 3)
    flip = random.choice([False, True])
    inp_t = _apply_transform(inp, k, flip)
    out_t = _apply_transform(out, k, flip)
    return inp_t, out_t


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        inp, expected = _build_case()
        produced = main(inp)
        if not np.array_equal(produced, expected):
            continue
        if len(_enclosed_zero_components(inp)) != 0:
            continue
        if len({hash(tuple(sorted(np.argwhere(inp == c).tolist())[0])) for c in SPRITE_COLORS}) == 0:
            continue
        return inp
    raise RuntimeError("failed to generate a valid sliding-cavity ARC input")

