+
+    for comp in _enclosed_zero_components(base):
+        touching: set[int] = set()
+        for r, c in comp:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in neighbors4(rr, cc):
+                idx = sprite_lookup.get((int(nr), int(nc)))
+                if idx is not None:
+                    touching.add(idx)
+
+        if not touching:
+            continue
+
+        winner_idx = min(
+            touching,
+            key=lambda idx: (
+                int(sprites[idx]["area"]),
+                int(sprites[idx]["bbox"][0]),
+                int(sprites[idx]["bbox"][1]),
