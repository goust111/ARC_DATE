    c0 = max(CORE_EDGE_MARGIN, min(w - core_w - CORE_EDGE_MARGIN, c_mid - core_w // 2))
    return r0, c0, r0 + core_h - 1, c0 + core_w - 1


def _gen_in_bbox(r, c, box):
    r0, c0, r1, c1 = box
    return r0 <= r <= r1 and c0 <= c <= c1


def _gen_pick_seeds(h, w, count, core_box):
    cells = []
