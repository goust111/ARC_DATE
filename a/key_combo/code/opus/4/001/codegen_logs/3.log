+
+def _base_pattern(n: int) -> np.ndarray:
+    mode = random.randrange(4)
+    center = n // 2
+    out = np.zeros((n, n), dtype=int)
+    for r in range(n):
+        for c in range(n):
+            a = max(abs(r - center), abs(c - center))
+            b = min(abs(r - center), abs(c - center))
+            if mode == 0:
+                out[r, c] = BLUE if (a + b) % 2 == 0 else RED
+            elif mode == 1:
