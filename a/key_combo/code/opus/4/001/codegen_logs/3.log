+    restored_only = full_square.copy()
+    diff = np.argwhere(expected != restored_only)
+    assert diff.shape[0] >= 4
+    assert any(not bool(occ_mask[int(r), int(c)]) for r, c in diff)
+
+    solved = main(inp)
+    assert np.array_equal(solved, expected)
