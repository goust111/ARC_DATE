    r0, c0, r1, c1 = legend_bbox
    lines = []
    for r in range(g.shape[0]):
        vals = set(map(int, g[r, :]))
        if len(vals) == 1 and bg not in vals and not (r0 <= r <= r1):
            lines.append(("row", r, next(iter(vals))))
    for c in range(g.shape[1]):
        vals = set(map(int, g[:, c]))
