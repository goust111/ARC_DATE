+    center, local_pixels, corner_colors, horizontal_edge_colors, vertical_edge_colors = _decode_corner_code(g)
+
+    pattern = _render_unfolded_frames(g.shape, corner_colors, horizontal_edge_colors, vertical_edge_colors)
