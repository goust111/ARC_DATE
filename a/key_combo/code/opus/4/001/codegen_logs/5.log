+    sig = _output_signature(out)
+    if sig in _SEEN_OUTPUT_SIGNATURES:
+        return None
+    _SEEN_OUTPUT_SIGNATURES.add(sig)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
