  93: def _gen_segment_rows(n_segs: int, h: int) -> list[int]:
  94:     """Sample unique rows with 1-2 gaps, reserving the stripe-adjacent row when possible."""
  95:     stripe_row = h - BOTTOM_STRIPE_ROWS
  96:     max_last = stripe_row - STRIPE_ADJACENT_EMPTY_ROWS - 1 if stripe_row > n_segs else stripe_row - 1
  97:     if max_last < n_segs - 1:
  98:         max_last = stripe_row - 1
  99:     max_extra_gaps = min(n_segs - 1, max_last - (n_segs - 1) * MIN_ROW_GAP)
 100:     n_two_gaps = random.randint(0, max_extra_gaps)
 101:     gaps = [MAX_ROW_GAP] * n_two_gaps + [MIN_ROW_GAP] * (n_segs - 1 - n_two_gaps)
 102:     random.shuffle(gaps)
 103:     span = sum(gaps)
 104:     start = random.randint(0, max_last - span)
 105:     rows = [start]
 106:     for gap in gaps:
 107:         rows.append(rows[-1] + gap)
 108:     return rows
