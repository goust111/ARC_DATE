 110: def _gen_attempt() -> np.ndarray | None:
 111:     n_segs = random.randint(MIN_SEGMENTS, MAX_SEGMENTS)
 112:     w = n_segs + WIDTH_EXTRA_COLUMNS
 113:     h = random.randint(n_segs + BOTTOM_STRIPE_ROWS, HEIGHT_MAX_SEGMENT_MULTIPLIER * n_segs + BOTTOM_STRIPE_ROWS)
 114: 
 115:     colors = random.sample(SEGMENT_COLORS, n_segs)
 116:     out = _empty_grid_with_stripe(h, w)
 117: 
 118:     bars = []
 119:     for length, color in zip(range(1, n_segs + 1), colors):
 120:         r = h - BOTTOM_STRIPE_ROWS - n_segs + length - 1
 121:         out[r, w - length : w] = color
 122:         bars.append((length, color))
 123: 
 124:     inp = _empty_grid_with_stripe(h, w)
 125: 
 126:     rows = _gen_segment_rows(n_segs, h)
 127:     random.shuffle(bars)

 128:     for row, (length, color) in zip(rows, bars):
 129:         c0 = random.randint(0, w - length)
 130:         inp[row, c0 : c0 + length] = color
 131: 
 132:     if not np.array_equal(main(inp), out):
 133:         return None
 134:     return inp
 135: 
 136: def generate_input() -> np.ndarray:
 137:     for _ in range(MAX_GENERATION_ATTEMPTS):
 138:         grid = _gen_attempt()
