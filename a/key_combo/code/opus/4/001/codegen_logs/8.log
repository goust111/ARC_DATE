  88: def _empty_grid_with_stripe(h: int, w: int) -> np.ndarray:
  89:     grid = np.full((h, w), BACKGROUND_COLOR, dtype=int)
  90:     grid[h - BOTTOM_STRIPE_ROWS, :] = STRIPE_COLOR
  91:     return grid
