  80: HEIGHT_MAX_SEGMENT_MULTIPLIER = 2
  81: # Colors.
  82: BACKGROUND_COLOR, STRIPE_COLOR = 0, 8
  83: SEGMENT_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
  84: # Scatter-row spacing and retry budget.
  85: MIN_ROW_GAP, MAX_ROW_GAP = 1, 2
  86: STRIPE_ADJACENT_EMPTY_ROWS, MAX_GENERATION_ATTEMPTS = 1, 300
