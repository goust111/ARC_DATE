+            found.append({"bbox": (int(r0), int(c0), int(r0 + 2), int(c0 + 2)), "color": color})
+    return found
+
+
+def _coord_adjacent_to_ring(coord: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    rr, cc = map(int, coord)
+    r0, c0, _r1, _c1 = map(int, bbox)
+    for lr in range(3):
+        for lc in range(3):
+            if (lr, lc) == (1, 1):
+                continue
+            if abs(rr - (r0 + lr)) + abs(cc - (c0 + lc)) == 1:
+                return True
+    return False
