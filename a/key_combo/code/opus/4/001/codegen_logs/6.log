+def _path_degrees(path: list[tuple[int, int]]) -> dict[tuple[int, int], int]:
+    deg = {node: 0 for node in path}
+    for i, a in enumerate(path):
+        for b in path[i + 1 :]:
+            if abs(a[0] - b[0]) + abs(a[1] - b[1]) == 2 and (a[0] == b[0] or a[1] == b[1]):
