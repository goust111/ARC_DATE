+        "grid": g,
+        "bg": bg,
+        "checker": checker,
+        "rings": rings,
+        "start": start,
+        "guide_color": guide_color,
+        "fill_color": fill_color,
+        "path": path,
+        "terminal": terminal,
+        "target_bbox": target_rings[0]["bbox"],
+        "target_color": int(target_rings[0]["color"]),
