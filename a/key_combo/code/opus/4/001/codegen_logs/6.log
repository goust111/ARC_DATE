+                if any(
+                    old != cur
+                    and abs(old[0] - nxt[0]) + abs(old[1] - nxt[1]) == 2
+                    and (old[0] == nxt[0] or old[1] == nxt[1])
+                    for old in visited
+                ):
+                    continue
+                weight = 2
+                if dirs and (dr, dc) != dirs[-1]:
