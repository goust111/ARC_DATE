+BG = 0
+PALETTE = tuple(range(1, 10))
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+EVEN_MASK = np.array([[1, 0, 1], [0, 1, 0], [1, 0, 1]], dtype=bool)
+ODD_MASK = ~EVEN_MASK
+
+GRID_RANGE = (18, 24)
+PATH_LEN_RANGE = (4, 8)
+RING_COUNT_CHOICES = (3, 4)
+GEN_ATTEMPTS = 400
