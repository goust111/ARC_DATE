+import numpy as np
+
+
+_ARC_UTILS_PATH = Path("/home/lixinyu/snap/new/solvers/arc_utils.py")
+_ARC_UTILS_SPEC = spec_from_file_location("_shared_arc_utils_6", _ARC_UTILS_PATH)
