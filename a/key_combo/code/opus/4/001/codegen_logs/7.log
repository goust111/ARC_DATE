CORE_WIDTH_CHOICES, CORE_WIDE_WIDTH_THRESHOLD, CORE_WIDE_EXTRA_WIDTH = (5, 7), 15, 9
CORE_CENTER_JITTER_CHOICES = (-1, 0, 0, 1)
CORE_EDGE_MARGIN = 3

