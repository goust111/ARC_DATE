+    except Exception:
+        return False
+    return np.array_equal(solved, out)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        spec = _build_spec()
+        if spec is None:
+            continue
+        grid = _build_grid(spec)
+        if _validate_spec(grid, spec):
