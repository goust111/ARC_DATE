+            for c0 in range(w - 4 + 1):
+                sub = grid[r0 : r0 + outer_h, c0 : c0 + 4]
+                border = np.zeros(sub.shape, dtype=bool)
+                border[0, :] = True
+                border[-1, :] = True
+                border[:, 0] = True
+                border[:, -1] = True
+                inner = sub[1:-1, 1:-1]
+                if not np.all(sub[border] == FRAME):
+                    continue
+                if inner.shape != (inner_h, 2):
+                    continue
+                if np.any((inner == BG) | (inner == FRAME)):
