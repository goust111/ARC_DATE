# === CFG: Canvas & layout ===
GRID_SIZE = 30                     # fixed 30x30 canvas
WALLPAPER_COLORS = (4, 5)         # number of wallpaper stripe colors (chosen per n_types)
TOTAL_COLORS_TARGET = (7, 8, 9)   # total distinct color count targets
GAP_RANGE = (1, 4)                # gap between rectangles during dimension selection

# === CFG: Rectangle size bounds ===
SRC_H_RANGE = (9, 19)             # source rect height (outer, inclusive)
SRC_W_RANGE = (8, 18)             # source rect width (outer, inclusive)
DST_H_RANGE = (9, 19)             # dest rect height (outer, inclusive)
DST_W_RANGE = (8, 20)             # dest rect width (outer, inclusive)
DST_W_SIDE_MAX = 20               # dest width cap for side-by-side layout

