+    return {
+        "row": guide_row,
+        "red_mask": red_mask,
+        "red_cols": red_cols,
+        "bar_left": bar_left,
+        "bar_right": bar_right,
+        "gap_mask": gap_mask,
+        "gap_cols": gap_cols,
+    }
