+        has_gap = bool(gap_prefix[c1 + 1] - gap_prefix[c0] > 0)
+        survives = bool(proj_width > 0 and not has_gap)
+        comps.append(
+            {
+                "coords": coords,
+                "bbox": bbox,
+                "area": area,
+                "width": width,
+                "height": height,
+                "mask": mask,
+                "proj_width": proj_width,
+                "has_gap": has_gap,
+                "survives": survives,
+            }
+        )
+    return comps
