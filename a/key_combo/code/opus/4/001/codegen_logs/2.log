+) -> list[dict] | None:
+    ordered = sorted(specs, key=lambda item: (item["width"], item["proj"]), reverse=True)
+    sides = ["above", "below"] + [random.choice(["above", "below"]) for _ in range(len(ordered) - 2)]
+    random.shuffle(sides)
