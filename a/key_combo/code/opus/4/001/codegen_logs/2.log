+        proj_width = int(red_prefix[c1 + 1] - red_prefix[c0])
+        has_gap = bool(gap_prefix[c1 + 1] - gap_prefix[c0] > 0)
+        survives = bool(proj_width > 0 and not has_gap)
+        comps.append(
