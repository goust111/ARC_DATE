+    for item in analyses:
+        r, c = item["center"]
+        dr, dc = DIRS4[item["longest"]]
+        rr, cc = r + dr, c + dc
+        while _in_bounds(out.shape, rr, cc):
+            if int(out[rr, cc]) == BG:
