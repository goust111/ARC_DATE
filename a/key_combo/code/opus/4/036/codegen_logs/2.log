+def _frame_output_signature(frame: dict) -> bytes:
+    inner = np.zeros(frame["inner_shape"], dtype=int)
+    _paint_dilation(inner, frame["markers_rel"], frame["hole_count"], frame["color"])
+    return inner.tobytes()
