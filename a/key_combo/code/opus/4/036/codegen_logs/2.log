+
+def _build_frame_patch(
+    color: int,
+    inner_h: int,
+    inner_w: int,
+    hole_count: int,
+    markers_rel: list[tuple[int, int]],
+    holes: list[tuple[int, int]],
+) -> np.ndarray:
+    patch = np.zeros((inner_h + 2, inner_w + 2), dtype=int)
+    patch[0, :] = int(color)
+    patch[-1, :] = int(color)
+    patch[:, 0] = int(color)
+    patch[:, -1] = int(color)
+    for r, c in holes:
+        patch[int(r), int(c)] = BG
+    for r, c in markers_rel:
+        patch[int(r) + 1, int(c) + 1] = MARKER
