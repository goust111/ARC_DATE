+
+def _border_mask(shape: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
