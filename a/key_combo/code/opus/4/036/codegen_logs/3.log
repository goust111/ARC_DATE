+        left_d, right_d = near, far
+    else:
+        left_d, right_d = far, near
+
+    c0_1 = 0
+    c1_1 = c0_1 + w1 - 1
+    marker_c = c1_1 + left_d
+    c0_2 = marker_c + right_d
+    c1_2 = c0_2 + w2 - 1
