    return dict(rectangles)


def _candidate_bridge(g: np.ndarray, bg: int, a: Rect, b: Rect) -> Bridge | None:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    candidates: list[Bridge] = []

    shared_r0 = max(ar0, br0)
    shared_r1 = min(ar1, br1)
    shared_c0 = max(ac0, bc0)
    shared_c1 = min(ac1, bc1)
