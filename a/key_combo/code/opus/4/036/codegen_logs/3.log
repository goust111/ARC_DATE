+    return {
+        "color": color,
+        "orientation": "H",
+        "rect_a": rect_a,
+        "rect_b": rect_b,
+        "marker": (marker_r, marker_c),
+        "bbox": (0, 0, max(r1_1, r1_2), c1_2),
+    }
+
+
+def _sample_vertical_pair(color: int) -> dict:
+    h1 = _shape_range(2, 5)
+    h2 = _shape_range(2, 5)
+    w1 = _shape_range(3, 4)
+    w2 = _shape_range(3, 4)
+    overlap = random.randint(3, min(w1, w2))
+
+    extra1 = w1 - overlap
+    extra2 = w2 - overlap
+    left1 = random.randint(0, extra1)
