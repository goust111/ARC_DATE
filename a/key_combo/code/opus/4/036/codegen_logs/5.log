import numpy as np

def lframe(h,w,ch,cw,corner):
    reg=np.ones((h,w),dtype=bool)
    if corner=='TR': reg[:ch,w-cw:]=False
    if corner=='TL': reg[:ch,:cw]=False
    if corner=='BR': reg[h-ch:,w-cw:]=False
    if corner=='BL': reg[h-ch:,:cw]=False
    frm=np.zeros((h,w),dtype=int)
    H,W=reg.shape
    for r in range(H):
        for c in range(W):
            if not reg[r,c]:
                continue
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                rr,cc=r+dr,c+dc
                if rr<0 or rr>=H or cc<0 or cc>=W or not reg[rr,cc]:
                    frm[r,c]=1
                    break
    return frm,reg

def count_diag(mask):
    H,W=mask.shape
    big=np.zeros((H+8,W+8),dtype=int)
    big[4:4+H,4:4+W]=mask
    cnt=[]
    for r in range(big.shape[0]):
        for c in range(big.shape[1]):
            if big[r,c]"'!=0: continue
            diag=False; orth=False
            for dr,dc in [(-1,-1),(-1,1),(1,-1),(1,1)]:
                rr,cc=r+dr,c+dc
                if 0<=rr<big.shape[0] and 0<=cc<big.shape[1] and big[rr,cc]==1: diag=True
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                rr,cc=r+dr,c+dc
                if 0<=rr<big.shape[0] and 0<=cc<big.shape[1] and big[rr,cc]==1: orth=True
            if diag and not orth:
                cnt.append((r,c))
    return len(cnt)

seen={}
for h in range(6,10):
  for w in range(6,10):
    for ch in range(2,h-1):
      for cw in range(2,w-1):
        if h-ch<3 or w-cw<3: continue
        for corner in ['"'TR','TL','BR','BL']:
          frm,reg=lframe(h,w,ch,cw,corner)
          interior=reg & (~frm.astype(bool))
          if interior.sum()<6: continue
          d=count_diag(frm)
          seen.setdefault(d,0)
          seen[d]+=1
print(seen)
