+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and free[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                stack.append((nr, nc))
