+def _make_l_region(h: int, w: int, cut_h: int, cut_w: int, corner: str) -> np.ndarray:
+    region = np.ones((h, w), dtype=bool)
+    if corner == "TL":
+        region[:cut_h, :cut_w] = False
+    elif corner == "TR":
