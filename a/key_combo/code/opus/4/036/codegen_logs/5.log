+def _rotate_coords(coords: list[tuple[int, int]], bbox: tuple[int, int, int, int], turns: int) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, bbox)
+    cr = int(r0 + bbox_h((r0, c0, r1, c1)) // 2)
+    cc = int(c0 + bbox_w((r0, c0, r1, c1)) // 2)
