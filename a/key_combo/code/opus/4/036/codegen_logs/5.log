+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_ATTEMPTS):
+        built = _build_case(rng)
+        if built is None:
+            continue
+        grid, metadata = built
+        if _validate_case(grid, metadata):
+            return grid
