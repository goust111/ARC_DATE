+    {"name": "step6", "shape": np.array([[1, 1, 0], [0, 1, 1], [1, 1, 0]], dtype=int)},
+    {"name": "hook6", "shape": np.array([[1, 0], [1, 0], [1, 1], [1, 1]], dtype=int)},
