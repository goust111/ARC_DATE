+def _rotate_point(r: int, c: int, cr: int, cc: int, turns: int) -> tuple[int, int]:
+    dr = int(r) - int(cr)
+    dc = int(c) - int(cc)
+    turns = int(turns) % 4
+    if turns == 0:
+        nr, nc = dr, dc
+    elif turns == 1:
+        nr, nc = dc, -dr
+    elif turns == 2:
+        nr, nc = -dr, -dc
+    else:
