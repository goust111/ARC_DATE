+def _bbox_of_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [int(r) for r, _ in coords]
+    cols = [int(c) for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
