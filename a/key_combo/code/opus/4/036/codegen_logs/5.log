+        frame_global[r0 : r1 + 1, c0 : c1 + 1] = patch_mask
+        interior_global = np.zeros_like(g, dtype=bool)
+        interior_global[r0 : r1 + 1, c0 : c1 + 1] = interior_local
+        diag_pixels = _diag_pixels_for_frame(g, frame_global, interior_global, bg)
