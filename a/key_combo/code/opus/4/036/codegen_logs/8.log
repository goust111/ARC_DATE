+neighbors8 = _ARC_UTILS.neighbors8
+
+BG = Color.BLACK
+SEP = Color.GREY
+PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+GEN_RETRIES = 400
+
+
+_BASE_TEMPLATES = [
+    np.array(
+        [
+            [0, 1],
+            [1, 0],
+            [1, 1],
+            [1, 2],
+            [2, 1],
+        ],
+        dtype=int,
