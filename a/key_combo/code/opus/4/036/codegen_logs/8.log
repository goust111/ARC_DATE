+        lr0, lc0, lr1, lc1 = band["left"]["panel_bbox_abs"]
+        rr0, rc0, rr1, rc1 = band["right"]["panel_bbox_abs"]
+        out[lr0 : lr1 + 1, lc0 : lc1 + 1] = left_panel
+        out[rr0 : rr1 + 1, rc0 : rc1 + 1] = right_panel
+    return out
