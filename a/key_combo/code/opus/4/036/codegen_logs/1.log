+    if want_overlap:
+        t_anchor_idx = random.randrange(2, anchor_count)
+    else:
+        t_anchor_idx = random.randrange(anchor_count)
+    anchors: list[tuple[int, int, int]] = []
+    for i, (r, c) in enumerate(anchors_xy):
