+def _neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    if not np.any(mask):
+        return False
+    _lab, n = label_mask(mask, connectivity=4)
+    return n == 1
