+        if overlap_offset is None:
+            return None
+        dr, dc = overlap_offset
+        for base in candidates:
+            other = (base[0] + dr, base[1] + dc)
+            if other[0] < lower_start or other[0] >= grid_shape[0] or other[1] < 0 or other[1] >= grid_shape[1]:
