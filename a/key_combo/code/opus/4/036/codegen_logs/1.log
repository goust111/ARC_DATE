+    cells = {start}
+    frontier = set()
+    for cell in _neighbors4(start):
+        if 0 <= cell[0] < h and 0 <= cell[1] < w:
+            frontier.add(cell)
+    while len(cells) < area and frontier:
+        cell = random.choice(tuple(frontier))
+        frontier.remove(cell)
