+GRID_W_RANGE = (17, 27)
+OBJ_H_RANGE = (5, 8)
+OBJ_W_RANGE = (5, 9)
+OBJ_GAP_RANGE = (2, 5)
+TOP_MARGIN_RANGE = (1, 3)
+SIDE_MARGIN = 1
+ANCHOR_COUNT_RANGE = (3, 5)
+ANCHOR_GAP_EXTRA = 2
