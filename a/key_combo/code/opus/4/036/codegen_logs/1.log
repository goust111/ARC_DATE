+
+
+def _build_case() -> dict | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    obj_h = random.randint(*OBJ_H_RANGE)
+    obj_w = random.randint(*OBJ_W_RANGE)
+    if obj_w * 2 + max(OBJ_GAP_RANGE) + SIDE_MARGIN * 2 > w:
+        return None
