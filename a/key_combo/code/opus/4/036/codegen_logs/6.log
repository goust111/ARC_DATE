+def _seed_pixels(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    coords = np.argwhere((grid != BLACK) & (grid != BLUE))
+    seeds = [(int(r), int(c), int(grid[r, c])) for r, c in coords]
+    seeds.sort()
+    return seeds
