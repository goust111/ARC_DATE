+def _interval_conflicts(interval: tuple[int, int], chosen: list[tuple[int, int]]) -> bool:
+    left, right = interval
+    for other_left, other_right in chosen:
+        if not (right + 1 < other_left or other_right + 1 < left):
+            return True
+    return False
+
