+    options: list[tuple[int, int]] = []
+    for left in range(0, grid_w - width + 1):
+        right = left + width - 1
+        cols = set(range(left, right + 1))
+        if cols & all_seed_cols:
+            continue
+        options.append((left, right))
+    random.shuffle(options)
+    return options
+
