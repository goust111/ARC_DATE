+def _choose_intervals(specs: list[int | None], grid_w: int, all_seed_cols: list[int]) -> list[tuple[int, int]] | None:
+    seed_set = set(all_seed_cols)
+    candidates: list[list[tuple[int, int]]] = []
+    for spec in specs:
