+def _sample_spaced_columns(width: int, count: int, min_gap: int = 4) -> list[int] | None:
+    cols = list(range(1, width - 1))
+    for _ in range(80):
+        random.shuffle(cols)
+        chosen: list[int] = []
+        for col in cols:
+            if all(abs(col - other) >= min_gap for other in chosen):
+                chosen.append(col)
+                if len(chosen) == count:
