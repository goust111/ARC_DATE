+
+def _find_single_component(coords):
+    coords = set(coords)
+    if not coords:
+        return set()
+    start = next(iter(coords))
+    stack = [start]
+    seen = {start}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in coords and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    return seen
