+    markers = {tuple(map(int, rc)) for rc in np.argwhere(grid == GREY)}
+    assert 3 <= len(markers) <= 5, "expected 3-5 grey markers"
+    assert not np.any(grid == BLUE), "blue should be absent from the input"
