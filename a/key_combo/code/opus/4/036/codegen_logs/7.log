+        LEFT: [(0, 0), (0, 1), (-1, 1)],
+    },
+    "tee4": {
+        UP: [(0, 0), (1, -1), (1, 0), (1, 1)],
+        RIGHT: [(0, 0), (-1, -1), (0, -1), (1, -1)],
+        DOWN: [(0, 0), (-1, -1), (-1, 0), (-1, 1)],
+        LEFT: [(0, 0), (-1, 1), (0, 1), (1, 1)],
+    },
+    "hook4": {
