+
+def _paint_halo(grid, center):
+    h, w = grid.shape
+    r, c = center
+    r0 = max(0, r - 1)
+    r1 = min(h, r + 2)
+    c0 = max(0, c - 1)
+    c1 = min(w, c + 2)
+    grid[r0:r1, c0:c1] = BLUE
