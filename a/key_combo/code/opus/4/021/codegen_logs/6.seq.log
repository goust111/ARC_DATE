+        input_cells = [(r - lift, c) for r, c in final_cells]
+        if any(r < 0 or r >= shape_hw[0] or c < 0 or c >= shape_hw[1] for r, c in input_cells):
+            continue
+        if input_blocked.intersection(input_cells):
