+    plan = {"shape": (height, width), "lines": lines, "objects": objects}
+    inp = _render_input(plan)
+    out = _render_output(plan)
+    if not _validate_plan(plan, inp, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
