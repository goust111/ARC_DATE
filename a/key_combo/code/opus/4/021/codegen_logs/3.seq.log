+    random.shuffle(axis_kinds)
+    random.shuffle(sign_pairs)
+    random.shuffle(diag_lengths)
+    random.shuffle(axis_lengths)
+    random.shuffle(row_offsets)
+    random.shuffle(col_offsets)
