+    assert g.ndim == 2
+    shapes = _extract_shapes(g)
+    yellow_points = [tuple(map(int, rc)) for rc in np.argwhere(g == YELLOW)]
+    triggered = _triggered_shape_indices(shapes, yellow_points)
