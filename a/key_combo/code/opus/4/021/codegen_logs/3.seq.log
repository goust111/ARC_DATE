+    ar, ac = anchor
+    br = ar + diag[0] + axis[0]
+    bc = ac + diag[1] + axis[1]
+    if diag[0] == 0 or diag[1] == 0 or abs(diag[0]) != abs(diag[1]):
+        return None
+    if axis == (0, 0) or (axis[0] != 0 and axis[1] != 0):
+        return None
