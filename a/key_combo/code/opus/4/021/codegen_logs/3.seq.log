    row_spans = _gen_split_axis(h, _GEN_PAIR_COUNT, _GEN_RECT_HEIGHT_RANGE)
    col_spans = _gen_split_axis(w, _GEN_PAIR_COUNT, _GEN_RECT_WIDTH_RANGE)
    if row_spans is None or col_spans is None:
