+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+MARKER_COLORS = (1, 2, 3, 6, 7, 8, 9)
+
+GRID_H_RANGE = (15, 21)
+GRID_W_RANGE = (17, 24)
+SHAPE_COUNT_CHOICES = (2, 3)
+MAX_GENERATION_ATTEMPTS = 800
