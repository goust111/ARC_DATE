+    dc = coord1[1] - coord0[1]
+    assert dr != 0 and dc != 0 and abs(dr) != abs(dc)
+    step = min(abs(dr), abs(dc))
+    diag = (_sign(dr) * step, _sign(dc) * step)
+    axis = (dr - diag[0], dc - diag[1])
