+                axis = (sign_r * axis_len, 0)
+            rels = [(0, 0), diag, axis, (diag[0] + axis[0], diag[1] + axis[1])]
+            min_r = min(r for r, _ in rels)
+            max_r = max(r for r, _ in rels)
+            min_c = min(c for _, c in rels)
+            max_c = max(c for _, c in rels)
