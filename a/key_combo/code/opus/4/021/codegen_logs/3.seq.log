+                    for shift_r in row_offsets:
+                        for shift_c in col_offsets:
+                            anchor = (base["a"][0] + shift_r, base["a"][1] + shift_c)
+                            if not (0 <= anchor[0] < h and 0 <= anchor[1] < w):
