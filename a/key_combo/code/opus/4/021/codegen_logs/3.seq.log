_GEN_WIDTH_RANGE = (17, 27)
_GEN_RECT_COUNT_CHOICES = (2, 3)
_GEN_RECT_HEIGHT_RANGE = (4, 14)
_GEN_RECT_WIDTH_RANGE = (4, 12)
_GEN_MIN_AXIS_GAP = 1

