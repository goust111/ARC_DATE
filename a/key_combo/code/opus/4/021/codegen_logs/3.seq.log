+    if len(interior) < 3:
+        return None
+
+    return {
+        "color": int(color),
+        "a": (ar, ac),
+        "b": (br, bc),
+        "diag": tuple(map(int, diag)),
+        "axis": tuple(map(int, axis)),
+        "diag_len": abs(diag[0]),
+        "axis_len": max(abs(axis[0]), abs(axis[1])),
+        "axis_kind": "h" if axis[0] == 0 else "v",
+        "sign_r": _sign(diag[0]),
+        "sign_c": _sign(diag[1]),
+        "verts": verts,
+        "boundary": boundary,
+        "interior": interior,
+        "area": abs(diag[0] * axis[1] - diag[1] * axis[0]),
