+def _sign(value: int) -> int:
+    if value > 0:
+        return 1
+    if value < 0:
+        return -1
+    return 0
+
+
+def _trace_segment(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    ar, ac = a
+    br, bc = b
+    dr = br - ar
+    dc = bc - ac
+    sr = _sign(dr)
+    sc = _sign(dc)
