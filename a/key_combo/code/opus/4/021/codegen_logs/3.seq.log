+        for r, c in inside_points + outside_points:
+            if grid[r, c] != BLACK:
+                failed = True
+                break
+            grid[r, c] = YELLOW
+        if failed:
+            continue
+
+        try:
+            _validate_generated_grid(grid, expect_overlap_source=overlap_mode)
+        except AssertionError:
