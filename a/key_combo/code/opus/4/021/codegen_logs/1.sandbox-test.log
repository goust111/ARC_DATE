+def _make_dead_network(
+    shape: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+    frame_gaps: set[tuple[int, int]],
+    all_landings: set[tuple[int, int]],
