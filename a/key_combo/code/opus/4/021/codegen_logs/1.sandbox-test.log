+    start: tuple[int, int],
+    landing_to_frame: dict[tuple[int, int], int],
+) -> list[tuple[int, int]]:
+    queue: deque[tuple[int, int]] = deque([start])
+    seen = {start}
+    found: list[tuple[int, int]] = []
+    while queue:
+        r, c = queue.popleft()
+        if (r, c) in landing_to_frame:
+            found.append((r, c))
