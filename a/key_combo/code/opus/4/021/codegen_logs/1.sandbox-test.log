+        for dr, dc in ((0, -1), (0, 1), (1, 0)):
+            rr, cc = r + dr, c + dc
+            if not in_bounds(passable.shape, rr, cc):
+                continue
+            if not passable[rr, cc] or (rr, cc) in seen:
