+                cells,
+                (start_row, end_row, start_col),
+                random.choice([2, 3]),
+                shape,
+                blocked,
+            )
+            if thicker is not None:
+                cells = thicker
+        if not _network_valid(
+            cells,
+            occupied,
+            blocked,
+            frame_gaps,
+            set(),
+            all_landings,
+            shape,
+        ):
+            continue
+        return {"cells": cells, "tokens": [(start_row, start_col)], "frame": None}
+    return None
+
