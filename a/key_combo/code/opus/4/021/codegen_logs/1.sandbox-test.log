+        winner = min(
+            candidates,
+            key=lambda item: (color_counts[item["color"]], item["start"][1]),
+        )
+        winner["winner"] = True
+        rr, cc = frame["coords"].T
+        out[rr, cc] = winner["color"]
+        lr, lc = winner["landing"]
+        out[lr, lc] = winner["color"]
