+        reached = _reachable_landings(passable, token["start"], landing_to_frame)
+        frame_ids = {landing_to_frame[cell] for cell in reached}
+        assert len(frame_ids) <= 1, "a token should not reach multiple frames"
+        if not frame_ids:
