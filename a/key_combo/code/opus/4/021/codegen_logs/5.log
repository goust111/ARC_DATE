def _gen_has_degenerate_symmetry(grid: np.ndarray) -> bool:
    return (
        np.array_equal(grid, np.fliplr(grid))
        or np.array_equal(grid, np.flipud(grid))
        or np.array_equal(grid, np.flipud(np.fliplr(grid)))
