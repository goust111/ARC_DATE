              else _sample_three_frames(H, W))
    if frames is None:
        return None

    base = np.full((H, W), bg, dtype=int)
    for frame in frames:
        _draw_frame(base, frame['r'], frame['c'], frame['size'])

    _assign_corner_colors(frames, bg)
    sources = _pick_sources(frames)
    if sources is None:
        return None

    output = _render_output(base, frames, pattern)
    inp = _derive_input(output, base, frames, pattern, k_max, sources)

    if not np.array_equal(main(inp), output):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError(f'failed to generate a valid input after {MAX_ATTEMPTS} attempts')
def _gen_attempt() -> np.ndarray | None:
    rng = np.random.default_rng()

    n_walls = int(rng.integers(5, 10))
    width = int(rng.integers(16, 20))

    gates: list[list[int]] = [[] for _ in range(n_walls)]
    holes: list[list[int]] = [[] for _ in range(n_walls + 1)]

    spine_len = int(rng.integers(3, min(6, n_walls) + 1))
    spine_start = int(rng.integers(0, n_walls - spine_len + 1))

    prev_center: int | None = None
    go_left = bool(rng.integers(2))  # alternate direction each step
    for row in range(spine_start, spine_start + spine_len):
        if prev_center is None:
            options = list(range(3, width - 3))
        elif go_left:
            options = [c for c in range(3, prev_center - 1)]  # c <= prev - 2
        else:
            options = [c for c in range(prev_center + 2, width - 2)]  # c >= prev + 2
        if not options:
            return None
        center = int(rng.choice(options))
        gates[row] = [center]
        prev_center = center
        go_left = not go_left

    holes = _repair_holes(gates, holes, width)
    if holes is None:
        return None

    total_gates = sum(len(row) for row in gates)
    target_total = int(rng.integers(max(6, total_gates), 13))

    while total_gates < target_total:
        candidates: list[tuple[int, int]] = []
        for row in range(n_walls):
            if len(gates[row]) >= 3:
                continue
            for center in _candidate_centers(gates, row, width):
                candidates.append((row, center))

        if not candidates:
            break

        order = rng.permutation(len(candidates))
        added = False
        for idx in order:
            row, center = candidates[int(idx)]
            new_gates = [list(cols) for cols in gates]
            new_gates[row] = sorted(new_gates[row] + [center])
            new_holes = _repair_holes(new_gates, holes, width)
            if new_holes is None:
                continue
            gates = new_gates
            holes = new_holes
            total_gates += 1
            added = True
            break

        if not added:
            break

    if not (6 <= total_gates <= 12):
        return None

    opened = _build_opened_grid(gates, holes, width)
    if _find_issues(opened):
        return None

    output, drop_counts = _simulate_output(opened)
    if max(drop_counts, default=0) < 3:
        return None

    inp = _build_input(gates, holes, width)
    if not np.array_equal(main(inp), output):
        return None

    return inp


def generate_input() -> np.ndarray:
    for _ in range(300):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate input for task 2b83f449")
def generate_input():
    # make a black grid as the background
    n = np.random.randint(10, 20)
    m = np.random.randint(10, 20)
    grid = np.zeros((n, m), dtype=int)

    # select which edges will be teal and which will be red
    top_or_bottom_color = np.random.choice([Color.TEAL, Color.RED])
    left_or_right_color = Color.TEAL if top_or_bottom_color == Color.RED else Color.RED

    # make a random vector of length m for the top or bottom edge of the grid
    top_or_bottom = np.zeros(m, dtype=int)

    # scatter the selected color anywhere along the vector except the ends
    top_or_bottom[np.random.choice(range(1, m-1), np.random.randint(2, 5), replace=False)] = top_or_bottom_color
    
    # make a random vector of length n for the left or right edge of the grid
    left_or_right = np.zeros(n, dtype=int)

    # scatter the selected color anywhere along the vector except the ends
    left_or_right[np.random.choice(range(1, n-1), np.random.randint(2, 5), replace=False)] = left_or_right_color

    # randomly put the top_or_bottom vector on the top or bottom of the grid
    if np.random.rand() < 0.5:
        grid[0] = top_or_bottom
    else:
        grid[-1] = top_or_bottom
    
    # randomly put the left_or_right vector on the left or right of the grid
    if np.random.rand() < 0.5:
        grid[:,0] = left_or_right
    else:
        grid[:,-1] = left_or_right
    
    return grid

