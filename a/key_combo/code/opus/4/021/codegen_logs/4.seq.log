+    blue_count = int(np.count_nonzero(pattern == BLUE))
+    red_count = int(np.count_nonzero(pattern == RED))
+    if not (3 <= fg_count <= 7):
+        return False
+    if blue_count < 1 or not (1 <= red_count <= 3):
+        return False
