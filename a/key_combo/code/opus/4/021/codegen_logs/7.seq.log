0004: def main(grid: np.ndarray) -> np.ndarray:
0005:     """
0006:     Build a double-sized mirror mosaic with the original grid in the lower-right quadrant.
0007: 
0008:     Input structure
0009:     - A rectangular 2D color grid.
0010: 
0011:     Rule
0012:     - Place the original grid in the lower-right quadrant of the output.
0013:     - Fill the lower-left quadrant with a left-right reflection of the input.
0014:     - Fill the upper-right quadrant with an up-down reflection of the input.
0015:     - Fill the upper-left quadrant with the 180-degree rotation of the input.
0016: 
0017:     Key insight
0018:     - The output is a mirrored extension of the input upward and left, not a pixel-scale zoom.
0019:     """
0020:     g = np.asarray(grid, dtype=int)
0021:     assert g.ndim == 2
0022:     return np.block([[np.flipud(np.fliplr(g)), np.flipud(g)], [np.fliplr(g), g]])
