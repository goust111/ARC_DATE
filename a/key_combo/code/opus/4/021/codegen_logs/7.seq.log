0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Paint a blue 3x3 hollow neighborhood around each red marker inside a green object's bounding rectangle.
0016: 
0017:     Input structure
0018:     - The input contains a black background, green 4-connected objects, and red marker pixels.
0019:     - Each green object forms an almost-rectangular region; its bounding box identifies the region it controls.
0020:     - The active red markers are exactly the red pixels lying inside one of those green-object bounding boxes.
0021:     Rule
0022:     - Preserve the input grid, including every active red marker itself.
0023:     - For each active red marker, recolor all in-bounds 8-neighbor cells to blue.
0024:     - If two active markers touch, their marker centers remain red rather than being overwritten by the other's blue stamp.
0025:     Key insight
0026:     - Red pixels outside the green rectangles are distractors; containment in a green component's bbox selects the markers to stamp.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     assert g.ndim == 2, "expected a 2D grid"
0030:     assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.RED, Color.GREEN}
0031: 
0032:     green_objects = find_components(
0033:         g,
