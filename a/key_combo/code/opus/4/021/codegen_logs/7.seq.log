+def _reverse_priority(shape: tuple[int, int], patch: np.ndarray, markers: list[tuple[int, int]]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    covered = np.zeros(shape, dtype=bool)
+    h, w = patch.shape
+    for r, c in sorted(markers, reverse=True):
