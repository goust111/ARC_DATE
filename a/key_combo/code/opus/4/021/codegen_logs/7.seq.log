+def _overlap_slices(h: int, w: int, dr: int, dc: int) -> tuple[slice, slice, slice, slice] | None:
+    a_r0 = max(0, dr)
+    b_r0 = max(0, -dr)
+    rows = min(h - a_r0, h - b_r0)
+    a_c0 = max(0, dc)
+    b_c0 = max(0, -dc)
