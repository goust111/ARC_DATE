0049:         assert len(containing) <= 1, "green object bounding boxes should not overlap at a red marker"
0050:         if containing:
0051:             active_markers.add(coord)
0052: 
0053:     assert active_markers, "expected at least one red marker inside a green-object bbox"
0054:     for bbox in bboxes:
