0010: # description:
0011: # In the input, you will see a black grid with teal pixels scattered along one edge and red pixels scattered along an edge perpendicular to the teal one.
0012: # To make the output, make the teal pixels flow from the edge they are on to the opposite edge. Whenever there is a red pixel in the same column or row as the flow of teal pixels, push the teal pixel's flow one pixel away from the red pixel.
0013: 
0014: def main(input_grid):
0015:     """
0016:     Flow teal pixels across the grid while red edge pixels push the paths aside.
0017: 
0018:     Input structure:
0019:     - The black grid has teal pixels on one edge and red pixels on a perpendicular edge.
0020:     - Teal starts flow toward the opposite edge.
0021:     - Red edge pixels create row or column push effects.
0022: 
0023:     Rule:
0024:     - Determine the teal flow direction and red push direction from the occupied edges.
0025:     - Start a path from each teal pixel.
0026:     - Move along the flow direction, but shift one cell away whenever aligned with any red pixel.
0027: 
0028:     Key insight:
0029:     - Red pixels act like directional repellers: they do not move, but their rows or
0030:       columns offset the teal streams.
0031:     """
0032:     # copy the input grid to the output grid
0033:     output_grid = np.copy(input_grid)
0034: 
0035:     # figure out which edges the red and teal pixels are on and decide the direction of flow and push based on that
0036:     top = output_grid[:,0]
0037:     bottom = output_grid[:, -1]
0038:     left = output_grid[0, :]
0039:     if Color.RED in top:
0040:         # push the teal pixels down
0041:         push = (0, 1)
0042: 
0043:         # teal can only be on the left or right edge if red is on the top edge
0044:         if Color.TEAL in left:
0045:             flow = (1, 0) # flow right
0046:         else:
0047:             flow = (-1, 0) # flow left    
0048:     elif Color.RED in bottom:
0049:         # push the teal pixels up
0050:         push = (0, -1)
0051: 
0052:         # teal can only be on the left or right edge if red is on the bottom edge
0053:         if Color.TEAL in left:
0054:             flow = (1, 0) # flow right
0055:         else:
0056:             flow = (-1, 0) # flow left
0057:     elif Color.RED in left:
0058:         # push the teal pixels to the right
0059:         push = (1, 0)
0060: 
0061:         # teal can only be on the top or bottom edge if red is on the left edge
0062:         if Color.TEAL in top:
0063:             flow = (0, 1) # flow down
0064:         else:
0065:             flow = (0, -1) # flow up
0066:     else: # red is on the right edge
0067:         # push the teal pixels to the left
0068:         push = (-1, 0)
0069:         
0070:         # teal can only be on the top or bottom edge if red is on the right edge
0071:         if Color.TEAL in top:
0072:             flow = (0, 1) # flow down
0073:         else:
0074:             flow = (0, -1) # flow up
0075: 
0076:     # find the coordinates of the teal and red pixels
0077:     teal = np.where(input_grid == Color.TEAL)
0078:     red = np.where(input_grid == Color.RED)
0079: 
0080:     # draw the flow of teal pixels
0081:     for i in range(len(teal[0])):
0082:         # start at a teal pixel
0083:         r, c = teal[0][i], teal[1][i]
0084: 
0085:         # draw across the grid one pixel at a time adjusting for red pixel effects
0086:         while r >= 0 and r < output_grid.shape[0] and c >= 0 and c < output_grid.shape[1]:
0087:             # push the teal pixel away from the red pixel if it is in the same row or column
0088:             if r in red[0] or c in red[1]:
0089:                 r += push[0]
0090:                 c += push[1]
0091: 
0092:                 # stop this flow if it goes off the grid
0093:                 if r < 0 or r >= output_grid.shape[0] or c < 0 or c >= output_grid.shape[1]:
0094:                     break
0095:                 
0096:             # draw a teal pixel in the flow
0097:             output_grid[r, c] = Color.TEAL
0098: 
0099:             # move the flow one pixel in the direction of flow
0100:             r += flow[0]
0101:             c += flow[1]
0102: 
0103:     return output_grid
0104: 
