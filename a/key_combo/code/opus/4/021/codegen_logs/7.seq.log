+def _rectangles_overlap(a: tuple[int, int], b: tuple[int, int], h: int, w: int) -> bool:
+    return not (a[0] + h <= b[0] or b[0] + h <= a[0] or a[1] + w <= b[1] or b[1] + w <= a[1])
+
