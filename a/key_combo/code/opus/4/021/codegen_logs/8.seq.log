+RED = 2
+GREEN = 3
+YELLOW = 4
+WALL = 6
+FLOOR = 7
+ENDPOINT_COLORS = (RED, BLUE, GREEN)
+STAMP_DELTAS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATION_ATTEMPTS = 400
