+    q = deque([tuple(map(int, coords[0]))])
+    seen.add(q[0])
+    out = []
+    while q:
+        cell = q.popleft()
+        out.append(cell)
+        for nr, nc in _neighbors4(*cell):
+            if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    assert len(seen) == int(mask.sum())
+    return np.array(sorted(out), dtype=int)
