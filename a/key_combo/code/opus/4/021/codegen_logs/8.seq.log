+        r1, c1 = coords.max(axis=0)
+        assert (int(r1 - r0 + 1), int(c1 - c0 + 1)) == (2, 2), f"endpoint color {color} must be a 2x2 block"
+        info[color] = {
+            "color": int(color),
+            "coords": [tuple(map(int, rc)) for rc in coords],
+            "anchor": (int(r0), int(c0)),
+        }
+    return info
