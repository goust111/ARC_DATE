+            "start_anchor": endpoints[a]["anchor"],
+            "end_anchor": endpoints[b]["anchor"],
+            "shortest_mask": shortest_mask,
+            "shortest_len": int(best_len),
+        }
+    return {"endpoints": endpoints, "pairs": pair_data}
