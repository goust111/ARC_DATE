    if _gen_has_split(w, n, _GEN_RECT_WIDTH_RANGE):
        layouts.append(_gen_horizontal_bboxes)
    if _gen_has_split(h, n, _GEN_RECT_HEIGHT_RANGE):
        layouts.append(_gen_vertical_bboxes)
    if n == _GEN_PAIR_COUNT and has_pair_split:
