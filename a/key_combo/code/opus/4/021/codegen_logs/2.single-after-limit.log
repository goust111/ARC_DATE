+    candidates: list[np.ndarray] = []
+    for r0, r1 in row_intervals:
+        for c0, c1 in col_intervals:
+            block = g[r0:r1, c0:c1]
+            if np.any(block == ERASED) or np.any(block == START):
+                continue
