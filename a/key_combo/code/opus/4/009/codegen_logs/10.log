+    assert np.all(actual[[r for r, _c in orange_cells], [c for _r, c in orange_cells]] == CROSS_COLOR)
+    for marker in markers:
+        r = int(marker["row"])
+        c = int(marker["col"])
+        color = int(marker["color"])
+        assert int(actual[r, c]) == color
