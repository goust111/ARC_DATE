+
+def _entry_height(shape_h: int) -> int:
+    if shape_h == 1:
+        return 2
+    if shape_h >= 4:
+        return shape_h
+    return shape_h + random.randint(0, 1)
+
+
+def _sample_spaced(count: int, size: int, min_delta: int) -> list[int] | None:
+    if count == 0:
+        return []
+    if count > size:
+        return None
+    population = list(range(size))
+    for _ in range(250):
