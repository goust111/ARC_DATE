+    _mask(["1", "1", "1"]),
+    _mask(["1", "1", "1", "1"]),
+    _mask(["10", "11", "10"]),
+    _mask(["01", "11", "01"]),
+    _mask(["10", "11", "01"]),
+    _mask(["01", "11", "10"]),
+]
