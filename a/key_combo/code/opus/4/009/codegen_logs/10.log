+        if not ok:
+            continue
+
+        marker_cells = {(int(marker["row"]), int(marker["col"])) for marker in markers}
+        orange_cells = {
+            (int(h_marker["row"]), int(v_marker["col"]))
+            for h_marker in markers
+            for v_marker in markers
+            if h_marker["orient"] == "H" and v_marker["orient"] == "V"
