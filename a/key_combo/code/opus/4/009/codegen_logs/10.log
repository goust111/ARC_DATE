+def _expected_from_meta(inp: np.ndarray, markers: list[dict[str, int | str]]) -> np.ndarray:
+    marker_tuples = [
+        (int(marker["row"]), int(marker["col"]), int(marker["color"]), str(marker["orient"]))
+        for marker in markers
