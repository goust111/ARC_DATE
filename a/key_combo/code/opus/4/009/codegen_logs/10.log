            row_sum = marker_r + anchor_r
            for r, c in source_coords:
                targets.append((int(row_sum - r), int(c)))

        for r, c in targets:
            assert 0 <= r < height and 0 <= c < width
            assert out[r, c] in (bg, marker_color)
        for r, c in targets:
            out[r, c] = marker_color

    return out

