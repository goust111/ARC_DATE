+        shape_h, shape_w = map(int, shape.shape)
+        slot_h = _entry_height(shape_h)
+        top_pad = random.randint(0, slot_h - shape_h)
+        left_pad = random.randint(0, 3 - shape_w)
+        layouts.append(
+            {
+                "color": int(color),
+                "orient": orient,
+                "shape": shape,
+                "slot_h": slot_h,
+                "top_pad": top_pad,
