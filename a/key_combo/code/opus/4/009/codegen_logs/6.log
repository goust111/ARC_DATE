+
+def _pairwise_chebyshev_ok(markers: list[dict[str, int]]) -> bool:
+    for i, a in enumerate(markers):
+        for b in markers[i + 1 :]:
+            if max(abs(a["r"] - b["r"]), abs(a["c"] - b["c"])) < MIN_MARKER_CHEB:
+                return False
+    return True
+
+
+def _sample_marker_layout(h: int, w: int, count: int) -> list[dict[str, int]] | None:
+    usable_rows = [r for r in range(1, h - TEMPLATE_REGION_SIDE) if 2 * r != h - 1]
+    usable_cols = [c for c in range(TEMPLATE_REGION_SIDE, w - 1) if 2 * c != w - 1]
+    top_rows = [r for r in usable_rows if r < h - 1 - r]
+    bottom_rows = [r for r in usable_rows if r > h - 1 - r]
+    left_cols = [c for c in usable_cols if c < w - 1 - c]
+    right_cols = [c for c in usable_cols if c > w - 1 - c]
+
+    if count == 3:
+        row_splits = [(1, 2), (2, 1)]
+        col_splits = [(1, 2), (2, 1)]
+    else:
+        row_splits = [(2, 2)]
+        col_splits = [(2, 2)]
+
+    for _ in range(PLACEMENT_ATTEMPTS):
+        top_count, bottom_count = random.choice(row_splits)
+        left_count, right_count = random.choice(col_splits)
+        rows_top = _sample_spaced(top_rows, top_count, MIN_ROW_COL_GAP)
+        rows_bottom = _sample_spaced(bottom_rows, bottom_count, MIN_ROW_COL_GAP)
+        cols_left = _sample_spaced(left_cols, left_count, MIN_ROW_COL_GAP)
+        cols_right = _sample_spaced(right_cols, right_count, MIN_ROW_COL_GAP)
+        if None in (rows_top, rows_bottom, cols_left, cols_right):
+            continue
+        rows = sorted(rows_top + rows_bottom)
+        cols = cols_left + cols_right
+        if any(b - a < MIN_ROW_COL_GAP for a, b in zip(rows, rows[1:])):
+            continue
+        if any(b - a < MIN_ROW_COL_GAP for a, b in zip(sorted(cols), sorted(cols)[1:])):
+            continue
+
+        colors = random.sample(list(MARKER_COLORS), count)
+        for _ in range(PAIRING_ATTEMPTS):
+            permuted_cols = random.sample(cols, len(cols))
+            markers = [
+                {"r": int(r), "c": int(c), "color": int(color)}
+                for r, c, color in zip(rows, permuted_cols, colors)
+            ]
+            if not _pairwise_chebyshev_ok(markers):
+                continue
+            return markers
+    return None
+
+
+def _template_coords(template: np.ndarray) -> list[tuple[int, int]]:
+    return [tuple(map(int, rc)) for rc in np.argwhere(template == PINK)]
+
+
+def _template_is_valid(template: np.ndarray) -> bool:
+    if template.ndim != 2 or template.size == 0:
+        return False
+    if template.shape[0] % 2 == 0 or template.shape[1] % 2 == 0:
+        return False
+    if not np.all((template == BLACK) | (template == PINK)):
+        return False
+    if not (3 <= int((template == PINK).sum()) <= 5):
+        return False
+    return _is_4_connected(template == PINK)
+
+
+def _validate_generated_input(grid: np.ndarray) -> bool:
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2:
+        return False
+    h, w = map(int, grid.shape)
+    if h > 30 or w > 30:
+        return False
+
+    pink_coords = np.argwhere(grid == PINK)
