    left_vals = range(EXPANSION_RANGE[0], EXPANSION_RANGE[1] + 1) if "left" in sides else [0]
    right_vals = range(EXPANSION_RANGE[0], EXPANSION_RANGE[1] + 1) if "right" in sides else [0]
