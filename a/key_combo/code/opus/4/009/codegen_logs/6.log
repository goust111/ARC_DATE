+
+
+def _stamp_points(
+    base: np.ndarray,
+    template: np.ndarray,
+    points: list[tuple[int, int, int, int]],
+    markers: list[dict[str, int]] | None,
+    *,
+    draw_rays: bool,
+) -> np.ndarray:
+    out = np.asarray(base, dtype=int).copy()
