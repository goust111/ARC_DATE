+        rows_bottom = _sample_spaced(bottom_rows, bottom_count, MIN_ROW_COL_GAP)
+        cols_left = _sample_spaced(left_cols, left_count, MIN_ROW_COL_GAP)
+        cols_right = _sample_spaced(right_cols, right_count, MIN_ROW_COL_GAP)
