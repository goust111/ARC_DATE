+        raise ValueError("paste out of bounds")
+
+    src = np.asarray(patch[rr0:rr1, cc0:cc1], dtype=int)
+    view = dst[r0 : r0 + src.shape[0], c0 : c0 + src.shape[1]]
+    if transparent is None:
+        view[:, :] = src
+        return
+    mask = src != int(transparent)
+    view[mask] = src[mask]
