+    out = np.asarray(base, dtype=int).copy()
+    if draw_rays and markers is not None:
+        out = _draw_rays(out, markers)
+    th, tw = map(int, template.shape)
+    for r, c, _row_id, _col_id in sorted(points, key=lambda item: (item[0], item[1])):
