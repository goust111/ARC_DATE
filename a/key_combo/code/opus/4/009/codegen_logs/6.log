        for idx in pink_flat:
            arr[idx // _GEN_TEMPLATE_SIDE, idx % _GEN_TEMPLATE_SIDE] = _GEN_PINK
        if not _gen_yellow_bbox_full(arr == _GEN_YELLOW):
            continue
        if len(_gen_dihedral_arrays(arr)) < _GEN_MIN_VARIANT_COUNT:
            continue
        templates.append(arr)
    return templates


