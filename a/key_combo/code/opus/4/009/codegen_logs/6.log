+
+def _sample_spaced(pool: list[int], count: int, gap: int) -> list[int] | None:
+    if count == 0:
+        return []
+    if len(pool) < count:
+        return None
+    for _ in range(200):
+        pick = sorted(random.sample(pool, count))
+        if all(b - a >= int(gap) for a, b in zip(pick, pick[1:])):
