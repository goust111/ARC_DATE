+        return False
+    if np.any(pink_coords[:, 0] < h - TEMPLATE_REGION_SIDE) or np.any(pink_coords[:, 1] >= TEMPLATE_REGION_SIDE):
+        return False
+
+    try:
+        template, template_bb = _extract_template(grid)
+        markers = _annotate_markers(_find_markers(grid), grid.shape)
