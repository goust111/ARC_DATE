+def _nearest_horizontal_edge(r: int, h: int) -> int:
+    top = int(r)
+    bottom = int(h) - 1 - int(r)
+    if top == bottom:
+        raise ValueError("horizontal boundary tie is not allowed")
+    return 0 if top < bottom else int(h) - 1
+
