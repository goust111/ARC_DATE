+
+def _pairwise_chebyshev_ok(markers: list[dict[str, int]]) -> bool:
+    for i, a in enumerate(markers):
+        for b in markers[i + 1 :]:
+            if max(abs(a["r"] - b["r"]), abs(a["c"] - b["c"])) < MIN_MARKER_CHEB:
+                return False
