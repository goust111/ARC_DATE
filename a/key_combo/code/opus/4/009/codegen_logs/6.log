+                "r": r,
+                "c": c,
+                "color": int(marker["color"]),
+                "v_edge": int(v_edge),
+                "h_edge": int(h_edge),
+                "vr0": int(vr0),
+                "vr1": int(vr1),
+                "hc0": int(hc0),
+                "hc1": int(hc1),
