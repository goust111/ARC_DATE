+
+
+def _compute_intersections(markers: list[dict[str, int]]) -> list[tuple[int, int, int, int]]:
+    points: list[tuple[int, int, int, int]] = []
+    for row_marker in markers:
+        for col_marker in markers:
+            if row_marker["id"] == col_marker["id"]:
