+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+MARKER_COLORS = (1, 2, 3, 4)
+PINK = 6
+
+TEMPLATE_REGION_SIDE = 4
+TEMPLATE_SHAPES = (
+    np.array([[PINK, PINK, PINK]], dtype=int),
+    np.array([[PINK], [PINK], [PINK]], dtype=int),
