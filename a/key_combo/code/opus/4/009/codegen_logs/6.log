+    h, w = map(int, template.shape)
+    row0 = grid.shape[0] - TEMPLATE_REGION_SIDE + random.randint(0, TEMPLATE_REGION_SIDE - h)
+    col0 = random.randint(0, TEMPLATE_REGION_SIDE - w)
