+def paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+    clip: bool = False,
+) -> None:
+    h, w = map(int, patch.shape)
+    r0 = int(r0)
+    c0 = int(c0)
+    rr0, cc0 = 0, 0
+    rr1, cc1 = h, w
