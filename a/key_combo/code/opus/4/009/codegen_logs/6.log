import random
H=W=26
rows=[r for r in range(1,H-4) if 2*r"'!=H-1]
cols=[c for c in range(4,W-1) if 2*c!=W-1]

def hdir(c):
    return '"'L' if c < W-1-c else 'R'

def vdir(r):
    return 'U' if r < H-1-r else 'D'

def ok(markers):
    for i,(r1,c1) in enumerate(markers):
        for r2,c2 in markers[i+1:]:
            if max(abs(r1-r2),abs(c1-c2))<5:
                return False
    return True

def pts(markers):
    out=[]
    for i,(r,c) in enumerate(markers):
        hc0,hc1=sorted((c,0 if hdir(c)=='L' else W-1))
        for j,(rr,cc) in enumerate(markers):
            if i==j: continue
            vr0,vr1=sorted((rr,0 if vdir(rr)=='U' else H-1))
            if hc0<=cc<=hc1 and vr0<=r<=vr1:
                out.append((i,j))
    return out

accepted=[]
for _ in range(500000):
    rs=random.sample(rows,4)
    cs=random.sample(cols,4)
    random.shuffle(cs)
    markers=list(zip(rs,cs))
    if not ok(markers): continue
    p=pts(markers)
    parts={i:0 for i in range(4)}
    for a,b in p:
        parts[a]+=1; parts[b]+=1
    if len(p)>=2 and len(p)<12 and min(parts.values())>0:
        accepted.append((len(p),markers,p,parts,[(vdir(r),hdir(c)) for r,c in markers]))
        if len(accepted)>=30:
            break
print('found', len(accepted))
for item in accepted[:30]:
    print(item)
