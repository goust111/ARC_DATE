+            [0, PINK, 0],
+            [PINK, PINK, PINK],
+            [0, PINK, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [PINK, PINK, PINK],
+            [0, PINK, 0],
+            [0, PINK, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, PINK, 0],
+            [0, PINK, 0],
+            [PINK, PINK, PINK],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [PINK, 0, 0],
+            [PINK, PINK, PINK],
+            [PINK, 0, 0],
