import itertools
H,W=28,28
rows=[1,5,9,13]
cols=[4,10,16,22]

def vdir(r):
    return 'up' if r < H-1-r else 'down'

def hdir(c):
    return 'left' if c < W-1-c else 'right'

def points(perm):
    out=[]
    markers=[{'id':i,'r':rows[i],'c':perm[i]} for i in range(4)]
    for a in markers:
        for b in markers:
            if a['id']==b['id']: continue
            if hdir(a['c'])=='left' and not (b['c']<=a['c']):
                continue
            if hdir(a['c'])=='right' and not (b['c']>=a['c']):
                continue
            if vdir(b['r'])=='up' and not (a['r']<=b['r']):
                continue
            if vdir(b['r'])=='down' and not (a['r']>=b['r']):
                continue
            out.append((a['id'],b['id']))
    return out

def cheb_ok(perm):
    markers=[(rows[i],perm[i]) for i in range(4)]
    for i,(r1,c1) in enumerate(markers):
        for r2,c2 in markers[i+1:]:
            if max(abs(r1-r2),abs(c1-c2))<5:
                return False
    return True

best=[]
for perm in itertools.permutations(cols):
    if not cheb_ok(perm):
        continue
    pts=points(perm)
    parts={i:0 for i in range(4)}
    for a,b in pts:
        parts[a]+=1; parts[b]+=1
    if min(parts.values())==0:
        continue
    best.append((len(pts),perm,pts,parts))
print('count', len(best))
for item in sorted(best, reverse=True)[:20]:
    print(item)
