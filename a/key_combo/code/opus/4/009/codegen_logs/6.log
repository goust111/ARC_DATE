+    if not _template_is_valid(template):
+        return False
+    tr0, tc0, tr1, tc1 = template_bb
+    if tr0 < h - TEMPLATE_REGION_SIDE or tc0 < 0 or tr1 >= h or tc1 >= TEMPLATE_REGION_SIDE:
+        return False
