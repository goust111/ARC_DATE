+
+
+def paste(
+    dst: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+    *,
+    transparent: int | None = None,
+    clip: bool = False,
+) -> None:
+    h, w = map(int, patch.shape)
+    r0 = int(r0)
+    c0 = int(c0)
+    rr0, cc0 = 0, 0
+    rr1, cc1 = h, w
+
+    if clip:
+        if r0 < 0:
+            rr0 = -r0
+            r0 = 0
+        if c0 < 0:
+            cc0 = -c0
+            c0 = 0
+        rr1 = min(rr1, dst.shape[0] - r0 + rr0)
+        cc1 = min(cc1, dst.shape[1] - c0 + cc0)
+        if rr0 >= rr1 or cc0 >= cc1:
+            return
