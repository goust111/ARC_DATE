+def _nearest_vertical_edge(c: int, w: int) -> int:
+    left = int(c)
+    right = int(w) - 1 - int(c)
+    if left == right:
+        raise ValueError("vertical boundary tie is not allowed")
+    return 0 if left < right else int(w) - 1
