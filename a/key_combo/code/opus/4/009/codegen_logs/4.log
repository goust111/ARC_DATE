+
+
+def _pairwise_chebyshev_ok(
+    seeds: list[tuple[int, int]], min_gap: int
+) -> bool:
+    for i, (r0, c0) in enumerate(seeds):
+        for r1, c1 in seeds[i + 1 :]:
+            if max(abs(r0 - r1), abs(c0 - c1)) < min_gap:
