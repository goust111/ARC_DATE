+def _components_by_color(grid: np.ndarray, colors: list[int]) -> list[dict]:
+    """Small 4-connected monochrome component finder following arc_utils conventions."""
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+
+    for color in colors:
+        points = np.argwhere(grid == color)
+        for r0, c0 in points:
+            r0 = int(r0)
+            c0 = int(c0)
+            if seen[r0, c0]:
+                continue
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for nr, nc in neighbors4(r, c):
+                    if (
+                        in_bounds((h, w), nr, nc)
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == int(color)
+                    ):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            coords_arr = np.asarray(coords, dtype=int)
+            out.append(
+                {
+                    "color": int(color),
+                    "coords": coords_arr,
+                    "bbox": bbox_coords(coords_arr),
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
+    return out
+
