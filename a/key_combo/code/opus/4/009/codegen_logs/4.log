+    for r, c in seeds:
+        grid[r, LEGEND_W + c] = SEED_COLOR
+
+    if _validate_instance(grid, palette, seeds):
+        return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid legend-ring Voronoi input")

