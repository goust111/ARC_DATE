+            mode_gap_pairs.append(("diag", gap))
+    random.shuffle(mode_gap_pairs)
+
+    for mode, gap in mode_gap_pairs:
+        for _ in range(80):
+            if mode == "row":
+                r = random.randint(1, height - 2)
