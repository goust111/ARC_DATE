+
+
+def _place_seeds(
+    height: int, width: int, radius: int, seed_count: int
+) -> list[tuple[int, int]] | None:
+    min_gap = max(6, 2 * radius)
+    mode_gap_pairs = []
+    for gap in range(min_gap, min_gap + 3):
+        if width >= gap + 3:
