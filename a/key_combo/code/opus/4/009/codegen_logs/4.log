+    colors = sorted(
+        int(color)
+        for color in np.unique(panel)
+        if int(color) not in (BG, PANEL_COLOR)
+    )
+    components = _components_by_color(panel, colors)
+    components.sort(key=lambda comp: (comp["bbox"][0], comp["bbox"][1]))
