+GRID_H_RANGE = (15, 19)
+GRID_W_RANGE = (15, 19)
+RECT_COUNT_CHOICES = (2, 3)
+RECT_H_RANGE = (2, 3)
+RECT_W_RANGE = (3, 4)
+TOP_GAP_RANGE = (0, 3)
+COLUMN_MARGIN = 1
+COLUMN_GAP = 2
+EXTRA_NOISE_RANGE = (0, 3)
+SOURCE_PALETTE = (2, 3, 4, 6, 8, 9)
