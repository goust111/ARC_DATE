+def _find_separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == SEP)]
+    assert len(rows) == 1, "expected one full-width blue separator row"
+    return int(rows[0])
+
