+        return False
+    if not isinstance(expected, np.ndarray) or expected.ndim != 2 or max(expected.shape) > 30:
+        return False
+
+    sep_cols = np.flatnonzero(np.all(grid == SEP, axis=0))
+    if len(sep_cols) != 1:
+        return False
+    sep = int(sep_cols[0])
+    left = grid[:, :sep]
+    right = grid[:, sep + 1 :]
+
