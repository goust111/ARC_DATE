SOURCE_BBOX_WIDTHS = tuple(range(3, 6))
SOURCE_DENSITY_RANGE = (0.44, 0.58)

# Marker and reflected-copy layout.
BACKGROUND_COLOR = 0
MARKER_COLORS = [2, 3, 4, 5, 6, 7, 8, 9]
MARKER_COUNTS = (1, 2)
MARKER_GAPS = tuple(range(4, 10))
