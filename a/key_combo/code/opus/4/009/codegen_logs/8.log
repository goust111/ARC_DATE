# Generation retry budget.
GENERATION_RETRIES = 300

_GEN_SOURCE_CACHE = {}


def _gen_source_cache():
    if "by_count" in _GEN_SOURCE_CACHE:
        return _GEN_SOURCE_CACHE["by_count"]

    by_count = {n: [] for n in SOURCE_PIXEL_COUNTS}
    for bh in SOURCE_BBOX_HEIGHTS:
