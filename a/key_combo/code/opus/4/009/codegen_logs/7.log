+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+PALETTE = [2, 3, 4, 5, 6, 7, 8, 9]
+REPEAT_OPTIONS = ((2, 2), (2, 3), (3, 2))
+GENERATION_ATTEMPTS = 400
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
