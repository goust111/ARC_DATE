+        for rr, cc in reflected:
+            out[rr, cc] = int(obj["color"])
+    return out
+
+
+def _validate_generated(inp: np.ndarray, objects: list[dict], marker_patch: np.ndarray, marker_top: int, marker_left: int, need_clip: bool) -> None:
+    h, w = inp.shape
