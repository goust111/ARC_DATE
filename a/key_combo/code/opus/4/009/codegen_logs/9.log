+def _mode_is_distinguishable(coords: np.ndarray, mode: str, r_h: int, c_v: int, shape: tuple[int, int]) -> bool:
+    correct, _ = _closure_coords(coords, mode, r_h, c_v, shape)
+    for alt in ("H", "V", "HV"):
+        if alt == mode:
