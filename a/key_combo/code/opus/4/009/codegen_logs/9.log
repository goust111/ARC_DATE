def _reflect_coords(
    coords: np.ndarray,
    *,
    r_h: int | None = None,
    c_v: int | None = None,
) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for r, c in coords:
        rr = int(r if r_h is None else 2 * int(r_h) - int(r))
        cc = int(c if c_v is None else 2 * int(c_v) - int(c))
        out.append((rr, cc))
    return out


def _reflected_targets(
    coords: np.ndarray,
    mode: str,
    r_h: int,
    c_v: int,
    shape: tuple[int, int],
