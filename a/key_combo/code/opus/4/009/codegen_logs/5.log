+    modes = ["clear", "clip"]
+    random.shuffle(modes)
+    for mode in modes:
+        if mode == "clear":
+            lo = 0
+            hi = min(width - obj_w, width - sprite_w)
+        else:
+            lo = max(0, width - sprite_w + 1)
+            hi = width - obj_w
+        if lo <= hi:
+            return random.randint(lo, hi), mode
+    return None
