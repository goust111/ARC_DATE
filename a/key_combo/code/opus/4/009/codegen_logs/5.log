+    return lower, direction, sprite_crop, color_sequence, template_bbox
+
+
+def _stamp_sequence(
+    lower: np.ndarray,
+    direction: str,
+    sprite_crop: np.ndarray,
+    color_sequence: list[int],
+    template_bbox: tuple[int, int, int, int],
+) -> np.ndarray:
