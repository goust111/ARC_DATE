def _rectangular_frame_bbox(g: np.ndarray, color: int) -> tuple[int, int, int, int] | None:
    coords = np.argwhere(g == int(color))
    if coords.size == 0:
        return None

    r0, c0, r1, c1 = bbox_coords(coords)
    h = int(r1 - r0 + 1)
    w = int(c1 - c0 + 1)
