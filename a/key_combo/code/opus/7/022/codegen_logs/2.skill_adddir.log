spec:
  grid: 3x3 [observed]
  colors: 2-4 distinct colors chosen from palette 1-9
  cell_values: each cell filled with one of the chosen colors; all chosen colors must appear at least once
  output: input tiled k x k where k = number of distinct colors
  output_size: (3*k) x (3*k), i.e. 6x6 for k=2, 9x9 for k=3, 12x12 for k=4

generation_strategy:
  approach: direct (input-first) -- the transform is trivially constructive
  steps:
    1. pick k uniformly from {2, 3, 4}
    2. sample k distinct colors from 1-9
    3. fill a 3x3 grid randomly, then verify all k colors appear (reject and retry if not; ~100% acceptance for k<=4 in 9 cells)
    4. output = np.tile(input, (k, k))
```
