+def _extract_patch(grid: np.ndarray, coords: list[tuple[int, int]]) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), BG, dtype=int)
+    for r, c in coords:
+        patch[r - r0, c - c0] = int(grid[r, c])
+    return patch
