+def _feasible_blue_counts(length: int) -> list[int]:
+    values = []
+    for blue_count in range((length + 1) // 2, length):
+        runs = length - blue_count + 1
+        if runs <= blue_count <= 3 * runs:
+            values.append(blue_count)
+    return values
+
