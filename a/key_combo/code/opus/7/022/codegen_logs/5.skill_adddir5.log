+def _fill_line_row(row: np.ndarray) -> np.ndarray:
+    filled = row.copy()
+    if row.size >= 3:
+        mask = (row[1:-1] == BG) & (row[:-2] == LINE_COLOR) & (row[2:] == LINE_COLOR)
+        filled[1:-1][mask] = FILL_COLOR
+    return filled
