  singletons:
    count: 4, one per diagonal quadrant relative to the block
    colors: 5 distinct non-bg non-block colors, all different from each other
    placement: each singleton is strictly above/below AND strictly left/right of the block (diagonally outside)
    distance_to_block_edge: 1-4 rows and 1-4 cols [observed]
  output:
    clear_all: fill grid with background
    fill_block: each singleton color written to the block cell in its matching quadrant
