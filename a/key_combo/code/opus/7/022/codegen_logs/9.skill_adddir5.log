import itertools
import numpy as np

W=9
c=4
r=1
# rows: 0 pipe top,1 wall gate,2 pipe bot within 3xW local slice

def rotate(g):
    out=g.copy()
    out[r,c-1:c+2]=5
    out[r-1:r+2,c]=2
    return out

def closed(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    from collections import deque
    q=deque()
    for i in range(H):
        for j in [0,W-1]:
            if mask[i,j] and not seen[i,j]: seen[i,j]=True; q.append((i,j))
    for j in range(W):
        for i in [0,H-1]:
            if mask[i,j] and not seen[i,j]: seen[i,j]=True; q.append((i,j))
    while q:
        x,y=q.popleft()
        for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
            nx,ny=x+dx,y+dy
            if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                seen[nx,ny]=True; q.append((nx,ny))
    return mask & ~seen

