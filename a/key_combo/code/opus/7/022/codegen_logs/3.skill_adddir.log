  "dst": "hidden marker-sized rectangle",
  "transform": "for each marker pixel, copy the unique non-marker color visible at its horizontal, vertical, or 180-degree reflection counterpart",
  "grid_shape": "output is the marker bbox crop"
}
</annotation>
<generation_spec>
