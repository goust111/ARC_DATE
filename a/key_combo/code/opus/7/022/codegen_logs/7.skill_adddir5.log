    bg = int(background)
    if (
        np.sum(sprite[0, :] != bg) > 0
        and np.sum(sprite[-1, :] != bg) > 0
        and np.sum(sprite[:, 0] != bg) > 0
        and np.sum(sprite[:, -1] != bg) > 0
    ):
