+
+
+def _counterpart_patches(left: np.ndarray, box: tuple[int, int, int, int]) -> list[np.ndarray]:
+    h, w = left.shape
+    r0, c0, r1, c1 = box
+    patches = []
+    for mr0, mc0, mr1, mc1 in _mirror_boxes(h, w, box):
+        patches.append(left[mr0 : mr1 + 1, mc0 : mc1 + 1].copy())
+    return patches
