+        (r0, w - 1 - c1, r1, w - 1 - c0),
+        (h - 1 - r1, c0, h - 1 - r0, c1),
+        (h - 1 - r1, w - 1 - c1, h - 1 - r0, w - 1 - c0),
+    ]
+
+
+def _recover_marker_patch(left: np.ndarray, box: tuple[int, int, int, int], marker: int) -> np.ndarray:
+    h, w = left.shape
+    r0, c0, r1, c1 = box
