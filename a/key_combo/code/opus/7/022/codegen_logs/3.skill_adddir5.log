+    for c in range(w):
+        for r in (0, h - 1):
+            if not blocked[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
