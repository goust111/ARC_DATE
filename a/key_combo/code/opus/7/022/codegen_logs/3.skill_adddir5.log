+    ]
+
+
+def _recover_marker_patch(left: np.ndarray, box: tuple[int, int, int, int], marker: int) -> np.ndarray:
+    h, w = left.shape
+    r0, c0, r1, c1 = box
+    patch = np.empty((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r in range(r0, r1 + 1):
