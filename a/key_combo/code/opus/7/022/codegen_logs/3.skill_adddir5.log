+        for dc in range(patch.shape[1]):
+            color = int(patch[dr, dc])
+            r = r0 + dr
+            c = c0 + dc
+            for rr, cc in {
+                (r, c),
+                (h - 1 - r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, w - 1 - c),
+            }:
