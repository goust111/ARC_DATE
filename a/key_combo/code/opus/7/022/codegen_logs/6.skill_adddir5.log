  symmetry_pattern:
    description: grid has full D4 (dihedral-4) symmetry -- invariant under LR flip, UD flip, 90/180/270 rotation, transpose, and anti-transpose
    fundamental_domain: upper-left triangle of upper-left 8x8 quadrant (36 cells where col <= row)
    colors: 6-8 distinct non-marker colors [observed]; no further structure (not concentric rings)
  marker_rect:
