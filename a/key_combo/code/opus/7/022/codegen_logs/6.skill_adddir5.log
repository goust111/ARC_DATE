+LEFT_FRAME = 8
+RIGHT_FRAME = 2
+OCCLUDER = 6
+SQUARE = 5
+INNER = 3
+PALETTE = (1, 3, 4, 7)
+FRAME_COLORS = (LEFT_FRAME, RIGHT_FRAME)
