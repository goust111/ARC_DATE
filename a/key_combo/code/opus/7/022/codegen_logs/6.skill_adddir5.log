+    needed = len(entries)
+    if len(all_cols) < needed:
+        return None
+
+    for _ in range(300):
+        ordered = _sample_processing_order(entries, ascending=ascending)
+        cols = sorted(random.sample(all_cols, needed))
+        if not ascending:
+            cols = cols[::-1]
+
+        placed: list[dict] = []
+        ok = True
+        for idx, entry in enumerate(ordered):
