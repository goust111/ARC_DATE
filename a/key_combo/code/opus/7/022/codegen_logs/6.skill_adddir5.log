+    br0, bc0 = b
+    ar1, ac1 = ar0 + SQUARE - 1, ac0 + SQUARE - 1
+    br1, bc1 = br0 + SQUARE - 1, bc0 + SQUARE - 1
+    row_gap = max(0, br0 - ar1 - 1, ar0 - br1 - 1)
+    col_gap = max(0, bc0 - ac1 - 1, ac0 - bc1 - 1)
+    return int(row_gap), int(col_gap)
