    out[r0 + 1 : r1, cross_c] = CROSS_COLOR
    _paint_frame(out, frame_bbox, FRAME_COLOR)

    if include_guides:
        for key, (r, c) in _guide_positions(frame_bbox).items():
            out[r, c] = int(guide_colors[key])
    return out


