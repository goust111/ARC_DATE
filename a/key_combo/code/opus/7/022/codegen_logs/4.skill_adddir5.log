+            ("ul", "ur", "ll", "lr"),
+            random.sample(GUIDE_PALETTE, 4),
+        )
+    )
+
+    branch = random.choice(("row_only", "col_only", "both"))
+    row_mode = "offset" if branch in ("row_only", "both") else "center"
+    col_mode = "offset" if branch in ("col_only", "both") else "center"
