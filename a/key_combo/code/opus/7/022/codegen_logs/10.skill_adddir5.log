+
+def _anchor_bounds(
+    shape: tuple[int, int],
+    gray_offsets: set[tuple[int, int]],
+    labels: list[tuple[tuple[int, int], int]],
+    transform: tuple[int, bool],
+) -> tuple[int, int, int, int]:
