+def _min_chebyshev(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> int:
+    best = 10**9
+    for r0, c0 in a:
+        for r1, c1 in b:
+            best = min(best, max(abs(r0 - r1), abs(c0 - c1)))
+    return int(best)
