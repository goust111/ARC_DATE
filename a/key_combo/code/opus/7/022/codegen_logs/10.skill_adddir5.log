    shape: tuple[int, int], bg: int, left_color: int, right_color: int,
    left_masks: list[np.ndarray], right_masks: list[np.ndarray],
) -> tuple[np.ndarray, list[Placement]] | None:
    out = _gen_base_grid(shape, bg, left_color, right_color)
