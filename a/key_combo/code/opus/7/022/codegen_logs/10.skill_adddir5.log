+from __future__ import annotations
+
+from collections import Counter, deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+ANCHOR = 1
+LABEL_COLORS = (2, 3)
+SKELETON = 5
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+TRANSFORMS = tuple((rot, flip) for rot in range(4) for flip in (False, True))
+
+GRID_MIN = 17
+GRID_MAX = 22
+MOTIF_COUNT = 4
+GEN_ATTEMPTS = 600
+SHAPE_ATTEMPTS = 300
+PLACEMENT_ATTEMPTS = 180
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _neighbors8(r: int, c: int) -> list[tuple[int, int]]:
+    out = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            out.append((int(r + dr), int(c + dc)))
+    return out
+
+
+def _components8(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors8(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _apply_transform(offset: tuple[int, int], transform: tuple[int, bool]) -> tuple[int, int]:
+    r, c = map(int, offset)
+    rot, flip = transform
+    for _ in range(int(rot)):
+        r, c = -c, r
+    if flip:
+        c = -c
+    return int(r), int(c)
+
+
+def _ray_cells(start: tuple[int, int], direction: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = map(int, direction)
+    r = int(start[0] + dr)
+    c = int(start[1] + dc)
+    cells: list[tuple[int, int]] = []
+    while _in_bounds(shape, r, c):
+        cells.append((int(r), int(c)))
+        r += dr
+        c += dc
+    return cells
