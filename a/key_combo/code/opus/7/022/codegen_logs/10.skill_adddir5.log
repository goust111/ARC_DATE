+        a_r_lo, a_r_hi, a_c_lo, a_c_hi = _anchor_bounds(shape, gray_offsets, labels, transform)
+        r0 = max(r_lo, a_r_lo)
+        r1 = min(r_hi, a_r_hi)
+        c0 = max(c_lo, a_c_lo)
+        c1 = min(c_hi, a_c_hi)
+        if r0 > r1 or c0 > c1:
+            return None
