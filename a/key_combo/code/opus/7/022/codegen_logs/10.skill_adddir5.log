+        (2, mid_r - 2, 2, mid_c - 2),
+        (2, mid_r - 2, mid_c + 1, w - 3),
+        (mid_r + 1, h - 3, 2, mid_c - 2),
+        (mid_r + 1, h - 3, mid_c + 1, w - 3),
