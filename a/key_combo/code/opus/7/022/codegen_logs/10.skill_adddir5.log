+    cells = {(int(ar), int(ac))}
+    for dr, dc in (_apply_transform(offset, transform) for offset in gray_offsets):
+        cells.add((int(ar + dr), int(ac + dc)))
+    for (offset, _color) in label_offsets:
+        dr, dc = _apply_transform(offset, transform)
+        cells.add((int(ar + dr), int(ac + dc)))
+    return cells
