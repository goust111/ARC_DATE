+            for label in motif["labels"]:
+                lr, lc = label["pos"]
+                grid[lr, lc] = int(label["color"])
+    return grid
+
+
+def _overlap_profile(shape: tuple[int, int], motifs: list[dict]) -> tuple[int, int]:
