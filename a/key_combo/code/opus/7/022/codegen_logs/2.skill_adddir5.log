+        for r in rows:
+            grid[r, c] = TOKEN
+
+    master_r0 = divider_r + 1 + lower_gap
+    grid[master_r0 : master_r0 + master_h, :] = master
+
+    out = _render_output(master, heights)
+    if max(out.shape) > 30:
+        return None
+    if not _semantic_checks(grid, out):
+        return None
