+    if not same_height_diff_pattern:
+        return False
+
+    already_stacked_cols = 0
+    upper = inp[:divider_r]
+    for c, h in enumerate(heights):
+        final_rows = set(range(divider_r - h, divider_r))
+        token_rows = set(map(int, np.flatnonzero(upper[:, c] == TOKEN)))
