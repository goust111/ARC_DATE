+def _apply_corner_cut(mask: np.ndarray, corner: int, style: int) -> None:
+    if int(style) == 0:
+        return
+    h, w = map(int, mask.shape)
+    if corner == 0:
+        r0, c0, dr, dc = 0, 0, 1, 1
+    elif corner == 1:
