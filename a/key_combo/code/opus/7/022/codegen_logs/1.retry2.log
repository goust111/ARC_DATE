+    elif corner == 2:
+        r0, c0, dr, dc = h - 1, 0, -1, 1
+    else:
+        r0, c0, dr, dc = h - 1, w - 1, -1, -1
+    cells = [(r0, c0)]
+    if int(style) >= 2:
+        cells.extend([(r0 + dr, c0), (r0, c0 + dc)])
+    if int(style) >= 3:
+        cells.append((r0 + dr, c0 + dc))
+    for r, c in cells:
+        if 0 <= r < h and 0 <= c < w:
+            mask[r, c] = False
 
