+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+
+GEN_ATTEMPTS = 400
+GRID_MIN = 15
+GRID_MAX = 20
+REGION_COUNT_RANGE = (3, 5)
+PLACEMENT_TRIES = 250
+RECT_PAD = 1
+
+_LOOP_ROWS = (
+    (
+        "33333",
+        "30003",
+        "30003",
+        "30003",
+        "33333",
+    ),
+    (
+        "333333",
+        "300003",
+        "300003",
+        "333333",
+    ),
+    (
+        "33333",
+        "30003",
+        "30003",
+        "30003",
+        "30003",
+        "33333",
+    ),
+    (
+        "03330",
+        "33033",
+        "30003",
+        "33033",
+        "03330",
+    ),
+    (
+        "03330",
+        "33033",
+        "30003",
+        "30003",
+        "33033",
+        "03330",
+    ),
+    (
+        "033330",
+        "330033",
+        "300003",
+        "300003",
+        "330033",
+        "033330",
+    ),
+)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _flood_from_border(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if mask[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    passable = g != GREEN
+    outside = _flood_from_border(passable)
+    enclosed = passable & ~outside
+    regions: list[dict] = []
+    for coords in _components(enclosed):
+        comp_mask = np.zeros_like(g, dtype=bool)
+        comp_mask[coords[:, 0], coords[:, 1]] = True
+
+        boundary: set[tuple[int, int]] = set()
+        for r, c in coords:
+            for nr, nc in _neighbors4(int(r), int(c)):
+                if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == GREEN:
+                    boundary.add((int(nr), int(nc)))
+
+        assert boundary, "each enclosed region must be surrounded by a green boundary"
+        all_coords = np.vstack(
+            [
+                coords,
+                np.array(sorted(boundary), dtype=int),
+            ]
+        )
+        r0, c0, r1, c1 = _bbox(all_coords)
+        regions.append(
+            {
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "has_seed": bool(np.any(g[coords[:, 0], coords[:, 1]] == RED)),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return regions
+
+
+def _seeded_tile(grid: np.ndarray) -> tuple[np.ndarray, int]:
+    regions = _extract_regions(grid)
+    seeded = [region for region in regions if region["has_seed"]]
+    assert len(seeded) == 1, "exactly one enclosed region must contain the red seed"
+    r0, c0, r1, c1 = seeded[0]["bbox"]
+    tile = np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1].copy()
+    tile[tile == RED] = BLACK
+    return tile, len(regions)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Count closed regions, crop the seeded one as a tile, and repeat that tile N by N.
+
+    Input structure:
+    - A black background contains several disjoint green closed boundaries.
+    - Each boundary encloses one black region, and exactly one enclosed region contains
+      a single red seed pixel.
+    - Different regions may have different boundary shapes and bounding boxes.
+
+    Rule:
+    - Treat green as walls and flood-fill from the outer border through all non-green cells.
+    - Every non-green component not reached from outside is one enclosed region; let the
+      total number of such regions be N.
+    - Find the enclosed region containing the red seed, crop its full bounding box together
+      with its surrounding green boundary, replace the red seed with black, and use that
+      crop as tile T.
+    - Output only a tight N by N tiling of T.
+
+    Key insight:
+    - The same topological analysis supplies two different facts: the count of enclosed
+      regions sets the repetition factor, while the seed chooses which enclosed shape is
+      cropped into the repeated tile.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert np.count_nonzero(g == RED) == 1, "input must contain exactly one red seed"
+
+    tile, count = _seeded_tile(g)
+    return np.tile(tile, (count, count))
+
+
+def _pattern_from_rows(rows: tuple[str, ...]) -> np.ndarray:
+    return np.array([[int(ch) for ch in row] for row in rows], dtype=int)
+
+
+def _pattern_signature(arr: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    a = np.asarray(arr, dtype=int)
+    return a.shape, a.tobytes()
+
+
+def _patch_interior_coords(patch: np.ndarray) -> np.ndarray:
+    regions = _extract_regions(patch)
+    assert len(regions) == 1
+    assert 4 <= regions[0]["area"] <= 12
+    return regions[0]["coords"]
+
+
+def _build_library() -> list[dict]:
+    library: list[dict] = []
+    for rows in _LOOP_ROWS:
+        patch = _pattern_from_rows(rows)
+        coords = _patch_interior_coords(patch)
+        sig = _pattern_signature(patch)
+        assert sig not in {item["signature"] for item in library}
+        library.append(
+            {
+                "patch": patch,
+                "interior": coords,
+                "signature": sig,
+            }
+        )
+    return library
+
+
+LOOP_LIBRARY = _build_library()
+
+
+def _too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = RECT_PAD) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + pad < br0 - pad
+        or br1 + pad < ar0 - pad
+        or ac1 + pad < bc0 - pad
+        or bc1 + pad < ac0 - pad
+    )
+
+
+def _place_patch(
+    rng: random.Random,
+    h: int,
+    w: int,
+    patch: np.ndarray,
+    placed_boxes: list[tuple[int, int, int, int]],
+) -> tuple[int, int] | None:
+    ph, pw = patch.shape
+    row_choices = list(range(1, h - ph))
+    col_choices = list(range(1, w - pw))
+    rng.shuffle(row_choices)
+    rng.shuffle(col_choices)
+    tries = 0
+    for r0 in row_choices:
+        for c0 in col_choices:
+            tries += 1
+            rect = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if any(_too_close(rect, other) for other in placed_boxes):
+                continue
+            return r0, c0
+            if tries >= PLACEMENT_TRIES:
+                return None
+    return None
+
+
+def _independent_expected(target_patch: np.ndarray, region_count: int) -> np.ndarray:
+    return np.tile(target_patch, (region_count, region_count))
+
+
+def _recover_region_tiles(grid: np.ndarray) -> list[np.ndarray]:
+    tiles: list[np.ndarray] = []
+    for region in _extract_regions(grid):
+        r0, c0, r1, c1 = region["bbox"]
+        tile = np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1].copy()
+        tile[tile == RED] = BLACK
+        tiles.append(tile)
+    return tiles
+
+
+def _generate_attempt() -> np.ndarray | None:
+    rng = random.Random()
+    region_count = rng.randint(REGION_COUNT_RANGE[0], REGION_COUNT_RANGE[1])
+    chosen = rng.sample(LOOP_LIBRARY, k=region_count)
+    target_idx = rng.randrange(region_count)
+
+    h = rng.randint(GRID_MIN, GRID_MAX)
+    w = rng.randint(GRID_MIN, GRID_MAX)
+    grid = np.zeros((h, w), dtype=int)
+
+    placements: list[dict] = []
+    boxes: list[tuple[int, int, int, int]] = []
+    order = list(range(region_count))
+    rng.shuffle(order)
+    for idx in order:
+        patch = chosen[idx]["patch"]
+        loc = _place_patch(rng, h, w, patch, boxes)
+        if loc is None:
+            return None
+        r0, c0 = loc
+        ph, pw = patch.shape
+        grid[r0 : r0 + ph, c0 : c0 + pw] = np.maximum(grid[r0 : r0 + ph, c0 : c0 + pw], patch)
+        rect = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+        boxes.append(rect)
+        placements.append({"index": idx, "r0": r0, "c0": c0})
+
+    target = chosen[target_idx]
+    target_place = next(item for item in placements if item["index"] == target_idx)
+    seed_r, seed_c = map(int, rng.choice(target["interior"]))
+    grid[target_place["r0"] + seed_r, target_place["c0"] + seed_c] = RED
+
+    target_patch = target["patch"]
+    expected = _independent_expected(target_patch, region_count)
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    if max(actual.shape) > 30:
+        return None
+
+    regions = _extract_regions(grid)
+    if len(regions) != region_count:
+        return None
+    if sum(1 for region in regions if region["has_seed"]) != 1:
+        return None
+
+    recovered = _recover_region_tiles(grid)
+    recovered_sigs = {_pattern_signature(tile) for tile in recovered}
+    chosen_sigs = {item["signature"] for item in chosen}
+    if recovered_sigs != chosen_sigs:
+        return None
+    if len(recovered_sigs) != region_count:
+        return None
+
+    tile, counted = _seeded_tile(grid)
+    if counted != region_count or not np.array_equal(tile, target_patch):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

