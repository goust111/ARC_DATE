+                "bbox": (r0, c0, r1, c1),
+                "has_seed": bool(np.any(g[coords[:, 0], coords[:, 1]] == RED)),
+                "area": int(coords.shape[0]),
+            }
+        )
+    return regions
+
+
+def _seeded_tile(grid: np.ndarray) -> tuple[np.ndarray, int]:
+    regions = _extract_regions(grid)
+    seeded = [region for region in regions if region["has_seed"]]
+    assert len(seeded) == 1, "exactly one enclosed region must contain the red seed"
+    r0, c0, r1, c1 = seeded[0]["bbox"]
+    tile = np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1].copy()
+    tile[tile == RED] = BLACK
+    return tile, len(regions)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Count closed regions, crop the seeded one as a tile, and repeat that tile N by N.
+
+    Input structure:
+    - A black background contains several disjoint green closed boundaries.
+    - Each boundary encloses one black region, and exactly one enclosed region contains
+      a single red seed pixel.
+    - Different regions may have different boundary shapes and bounding boxes.
+
+    Rule:
+    - Treat green as walls and flood-fill from the outer border through all non-green cells.
+    - Every non-green component not reached from outside is one enclosed region; let the
+      total number of such regions be N.
+    - Find the enclosed region containing the red seed, crop its full bounding box together
+      with its surrounding green boundary, replace the red seed with black, and use that
+      crop as tile T.
+    - Output only a tight N by N tiling of T.
+
+    Key insight:
+    - The same topological analysis supplies two different facts: the count of enclosed
+      regions sets the repetition factor, while the seed chooses which enclosed shape is
+      cropped into the repeated tile.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert np.count_nonzero(g == RED) == 1, "input must contain exactly one red seed"
+
+    tile, count = _seeded_tile(g)
+    return np.tile(tile, (count, count))
+
+
+def _pattern_from_rows(rows: tuple[str, ...]) -> np.ndarray:
+    return np.array([[int(ch) for ch in row] for row in rows], dtype=int)
+
+
+def _pattern_signature(arr: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    a = np.asarray(arr, dtype=int)
+    return a.shape, a.tobytes()
+
+
+def _patch_interior_coords(patch: np.ndarray) -> np.ndarray:
+    regions = _extract_regions(patch)
+    assert len(regions) == 1
+    assert 4 <= regions[0]["area"] <= 12
+    return regions[0]["coords"]
+
+
+def _build_library() -> list[dict]:
+    library: list[dict] = []
+    for rows in _LOOP_ROWS:
+        patch = _pattern_from_rows(rows)
+        coords = _patch_interior_coords(patch)
+        sig = _pattern_signature(patch)
+        assert sig not in {item["signature"] for item in library}
+        library.append(
+            {
+                "patch": patch,
+                "interior": coords,
+                "signature": sig,
+            }
+        )
+    return library
+
+
+LOOP_LIBRARY = _build_library()
+
+
+def _too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = RECT_PAD) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + pad < br0 - pad
+        or br1 + pad < ar0 - pad
+        or ac1 + pad < bc0 - pad
+        or bc1 + pad < ac0 - pad
+    )
+
+
+def _place_patch(
+    rng: random.Random,
