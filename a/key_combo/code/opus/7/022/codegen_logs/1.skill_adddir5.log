+PLACEMENT_TRIES = 250
+RECT_PAD = 1
+
+_LOOP_ROWS = (
+    (
+        "33333",
+        "30003",
+        "30003",
+        "30003",
+        "33333",
+    ),
+    (
+        "333333",
+        "300003",
+        "300003",
+        "333333",
+    ),
+    (
+        "33333",
+        "30003",
+        "30003",
+        "30003",
+        "30003",
+        "33333",
+    ),
+    (
+        "03330",
+        "33033",
+        "30003",
+        "33033",
+        "03330",
+    ),
+    (
+        "03330",
+        "33033",
+        "30003",
+        "30003",
+        "33033",
+        "03330",
+    ),
+    (
+        "033330",
+        "330033",
+        "300003",
+        "300003",
