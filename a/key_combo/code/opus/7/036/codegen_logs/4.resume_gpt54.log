+def _diamond_outline(cr: int, cc: int, radius: int) -> set[tuple[int, int]]:
+    pts = set()
+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        pts.add((cr + dr, cc + dc))
+        pts.add((cr + dr, cc - dc))
+    return pts
