+        cur += height + 1
+
+    col_starts = []
+    cur = 0
+    for width in col_widths:
+        col_starts.append(cur)
+        cur += width + 1
+
+    h_walls = []
+    cur = row_heights[0]
+    for idx in range(len(row_heights) - 1):
+        h_walls.append(cur + idx)
+        grid[cur + idx, :] = WALL
+        cur += row_heights[idx + 1]
