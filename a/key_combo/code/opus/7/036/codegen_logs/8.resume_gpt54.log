+    if omit_horizontal is not None:
+        boundary_idx, col_idx = omit_horizontal
+        wall_row = h_walls[boundary_idx]
+        c0 = col_starts[col_idx]
+        c1 = c0 + col_widths[col_idx] - 1
+        grid[wall_row, c0 : c1 + 1] = BG
+
