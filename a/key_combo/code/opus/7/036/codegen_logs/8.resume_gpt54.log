+    graph = _build_region_graph(labels, wall_mask)
+    phases = {start: 0}
+    q = deque([start])
+    while q:
+        region = q.popleft()
+        for neighbor in graph[region]:
+            expected = 1 - phases[region]
+            if neighbor in phases:
+                assert phases[neighbor] == expected, "region adjacency graph must be bipartite"
