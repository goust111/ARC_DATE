+        start_c = rng.choice(top_cols)
+        end_c = rng.choice(bottom_cols)
+        bend_r = rng.randint(r0 + 1, r1 - 1)
+        path = [(r, start_c) for r in range(r0, bend_r + 1)]
+        step = 1 if end_c >= start_c else -1
