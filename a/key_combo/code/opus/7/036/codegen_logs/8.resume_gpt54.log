+BG = 0
+WALL = 9
+MARKER_COLORS = (1, 2, 3, 4)
+
+MIN_REGIONS = 4
+MAX_REGIONS = 6
+MIN_REGION_AREA = 15
+MAX_REGION_AREA = 40
+MIN_SPLIT_AREA = 12
+MAX_GENERATION_ATTEMPTS = 400
