+        grid[:, cur + idx] = WALL
+        cur += col_widths[idx + 1]
+
+    if omit_vertical is not None:
+        row_idx, boundary_idx = omit_vertical
+        wall_col = v_walls[boundary_idx]
+        r0 = row_starts[row_idx]
+        r1 = r0 + row_heights[row_idx] - 1
+        grid[r0 : r1 + 1, wall_col] = BG
