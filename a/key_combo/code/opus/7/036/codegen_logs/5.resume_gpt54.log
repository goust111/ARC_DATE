+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+LEGEND_H = 2
+MAIN_COLORS = np.array([1, 2, 3, 4], dtype=int)
+ACCENT_COLORS = np.array([6, 7, 8, 9], dtype=int)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
+    (1, 0),
