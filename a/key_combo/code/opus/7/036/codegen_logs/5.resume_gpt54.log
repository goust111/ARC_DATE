+        return None
+    return cells
+
+
+def _generate_sprite(
+    rng: np.random.Generator,
+    main_color: int,
+    turns: int,
+) -> dict | None:
+    for _ in range(80):
+        total = int(rng.integers(4, 9))
+        full_cells = _grow_connected_shape(rng, total)
+        if full_cells is None:
+            continue
+
+        non_anchor = [(r, c) for r, c in full_cells if (r, c) != (0, 0)]
+        if len(non_anchor) < 3:
