+import numpy as np
+
+
+MIN_SIDE = 4
+YELLOW = 4
+GREEN = 3
+
+GRID_HEIGHT_RANGE = (17, 23)
+GRID_WIDTH_RANGE = (17, 23)
+RECT_COUNT_RANGE = (3, 5)
+RECT_HEIGHT_RANGE = (4, 7)
+RECT_WIDTH_RANGE = (4, 7)
+MIN_ADJ_OVERLAP = 2
+PALETTE = (0, 1, 2, 5, 6, 7, 8, 9)
