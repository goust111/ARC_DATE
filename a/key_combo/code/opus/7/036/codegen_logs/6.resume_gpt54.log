+    rect_mask = np.zeros(shape, dtype=bool)
+
+    for r0, c0, r1, c1, color in rects:
+        grid[r0 : r1 + 1, c0 : c1 + 1] = color
+        rect_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+
+    for r in range(h):
+        for c in range(w):
+            if rect_mask[r, c]:
