+        return False
+    if r1 + 1 < pref.shape[0] - 1 and _rect_sum(pref, r1 + 1, c0, r1 + 1, c1) == width:
+        return False
+    if c0 > 0 and _rect_sum(pref, r0, c0 - 1, r1, c0 - 1) == height:
+        return False
+    if c1 + 1 < pref.shape[1] - 1 and _rect_sum(pref, r0, c1 + 1, r1, c1 + 1) == height:
+        return False
+    return True
