+    if _overlap_1d(ac0, ac1, bc0, bc1):
+        if ar1 < br0:
+            return br0 - ar1 - 1 <= 1
+        if br1 < ar0:
+            return ar0 - br1 - 1 <= 1
+
+    return False
+
+
