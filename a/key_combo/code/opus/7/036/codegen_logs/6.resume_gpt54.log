+    graph = {idx: set() for idx in range(len(rects))}
+    for i in range(len(rects)):
+        for j in range(i + 1, len(rects)):
+            if _rectangles_adjacent(rects[i], rects[j]):
+                graph[i].add(j)
+                graph[j].add(i)
+    return graph
+
+
