+    return rects
+
+
+def _overlap_1d(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return max(a0, b0) <= min(a1, b1)
+
+
+def _rectangles_adjacent(a: Rect, b: Rect) -> bool:
+    ar0, ac0, ar1, ac1, _ = a
+    br0, bc0, br1, bc1, _ = b
