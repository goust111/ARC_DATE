38:def main(grid: np.ndarray) -> np.ndarray:
39:    """
40:    Fill every fully enclosed background region inside red outlines with blue.
41:
42:    Input structure
43:    - The grid has a black background and red one-cell-thick outline/barrier pixels.
44:    - Red outlines may touch each other or the grid boundary, and some red shapes
45:      may be incomplete.
46:    - Blue is absent from the input and appears only as the fill color.
47:
48:    Rule
49:    - Treat red pixels as walls and trace all background pixels connected to the
50:      grid boundary by 4-neighbor steps.
51:    - Recolor each remaining background pixel to blue.
52:    - Leave red pixels and exterior background unchanged.
53:
54:    Key insight
55:    - The blue cells are exactly the background holes: black regions that cannot
56:      escape to the outer boundary without crossing a red wall.
57:    """
58:    g = np.asarray(grid, dtype=int)
59:    assert g.ndim == 2, "expected a 2D grid"
60:
61:    bg = get_bg(g)
62:    assert bg != Color.RED, "red walls must not be the background"
63:    assert not np.any(g == Color.BLUE), "blue must be absent from the input"
64:    foreground = set(map(int, np.unique(g))) - {int(bg)}
65:    assert foreground == {Color.RED}, "expected only red foreground walls"
66:
67:    exterior = _exterior_background(g, bg)
68:    enclosed = (g == bg) & ~exterior
69:    assert np.any(enclosed), "expected at least one enclosed background region"
70:
71:    out = g.copy()
72:    out[enclosed] = Color.BLUE
73:    return out
