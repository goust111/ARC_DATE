+        grid[:split_r, split_c + 1 :],
+        grid[split_r + 1 :, :split_c],
+        grid[split_r + 1 :, split_c + 1 :],
+    ]
+    shapes = {quad.shape for quad in quadrants}
+    assert len(shapes) == 1, "quadrants must have the same shape"
+    return quadrants
