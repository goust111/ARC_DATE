def _foreground_bands(g: np.ndarray, bg: int) -> list[tuple[int, int, int]]:
    bands: list[tuple[int, int, int]] = []
    for color in colors_present(g, exclude={bg}):
        cols = np.where(g == color)[1]
        c0, c1 = int(cols.min()), int(cols.max())
