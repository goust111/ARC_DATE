    h, w = g.shape
    dr, dc = direction
    r, c = start
    path: list[tuple[int, int]] = []
    while 0 <= r < h and 0 <= c < w and int(g[r, c]) != block_color:
        path.append((r, c))
        r += dr
        c += dc

