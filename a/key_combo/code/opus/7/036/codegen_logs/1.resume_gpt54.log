+    adjacent_pairs = [("TL", "TR"), ("TR", "BR"), ("BR", "BL"), ("BL", "TL")]
+    opposite_pairs = [("TL", "BR"), ("TR", "BL")]
+    if random.random() < 0.75:
+        return random.choice(adjacent_pairs)
+    return random.choice(opposite_pairs)
