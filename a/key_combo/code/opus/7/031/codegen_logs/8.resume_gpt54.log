+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        template = random.choice(TEMPLATE_LIBRARY)
+        size = int(template.shape[0])
+        full_count = random.choice([2, 3])
+        layout = _choose_layout(size, full_count)
+        if layout is None:
+            continue
+
