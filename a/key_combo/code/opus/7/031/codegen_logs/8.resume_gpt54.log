+    dr, dc = deltas[0]
+
+    target_r0 = full_instances[-1][0] + dr
+    target_c0 = full_instances[-1][1] + dc
+    assert 0 <= target_r0 <= g.shape[0] - h and 0 <= target_c0 <= g.shape[1] - w
+
