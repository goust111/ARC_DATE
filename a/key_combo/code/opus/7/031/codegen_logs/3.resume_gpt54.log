+    selected = _selected_indices(g, bboxes)
+    assert selected, "expected at least one selected sprite"
+
+    template = np.zeros((box_h, box_w), dtype=bool)
+    for idx in selected:
+        template |= np.asarray(sprites[idx]["mask"], dtype=bool)
