+    markers: list[Coord] = []
+    used_markers: set[Coord] = set()
+    for idx in selected_indices:
+        options = [pos for pos in candidates[idx] if pos not in used_markers]
+        if not options:
+            return None
+        pos = random.choice(options)
+        markers.append(pos)
+        used_markers.add(pos)
