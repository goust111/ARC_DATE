+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
