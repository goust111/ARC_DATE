+def _normalize_coords(coords: np.ndarray) -> np.ndarray:
+    coords = np.asarray(coords, dtype=int)
+    mins = coords.min(axis=0)
+    return coords - mins
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray, offset: tuple[int, int] = (0, 0)) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    ro, co = offset
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr + ro, cc + co))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(cells, dtype=int))
+    return out
+
+
+def _projection_interval(coords: np.ndarray, direction: str) -> tuple[int, int]:
+    r0, c0, r1, c1 = _bbox(coords)
+    if direction in {"up", "down"}:
+        return c0, c1
+    return r0, r1
+
+
+def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return not (a[1] < b[0] or b[1] < a[0])
+
+
+def _distance_to_target(coords: np.ndarray, direction: str, shape: tuple[int, int]) -> int:
+    h, w = shape
+    r0, c0, r1, c1 = _bbox(coords)
+    if direction == "up":
+        return r0 - 1
+    if direction == "down":
