+                coords.append((cr, cc))
+                if cr == 0 or cc == 0 or cr == height - 1 or cc == width - 1:
+                    touches_border = True
+                for dr, dc in ORTHO_DIRS:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            comps.append(
