spec:
  grid: 8-19 rows x 9-21 cols, black background
  markers:
    color: blue (1)
    count: 7-19, density ~5-13% of grid cells
    isolated: 1-4 markers not sharing any row or col with another marker [observed]
  connections:
    rule: for each row/col with >=2 blue markers, paint teal (8) on all black cells strictly between consecutive markers (sorted order)
    rows_with_connections: 1-5
    cols_with_connections: 1-5
    both_axes_present: always true [observed]
    markers_per_line: typically 2, up to 4
    segment_length: 1-13 cells (gap between consecutive markers minus endpoints)
    total_segments: 3-12
    segments_only_cross_black: all cells between consecutive markers must be black in input
    teal_crosses: 0-1 cells where row and col segments overlap [observed]
  output: input grid with teal segments added; blue markers and all other cells unchanged

generation_strategy:
  approach: direct placement with validation
  steps:
    1. Choose grid size H in [8,19], W in [9,21]
    2. Choose N markers in [7, min(19, H*W*0.13)]
    3. Place markers to guarantee connections on both axes -- first place 2-5 row-aligned pairs and 1-5 col-aligned pairs, then scatter remaining as isolated markers
    4. For each row/col with >=2 markers, verify all cells between consecutive markers are black (guaranteed since only markers are placed)
    5. Ensure at least 3 total segments and no two markers occupy the same cell
    6. Output is computed by filling teal between consecutive same-row/col markers
```
