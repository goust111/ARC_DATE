def _gen_polyomino(area, rows, cols):
    shape_rows, shape_cols = _GEN_SHAPE_BOUNDS
    max_h = min(shape_rows, rows)
    max_w = min(shape_cols, cols)
    cells = {(0, 0)}
    while len(cells) < area:
        candidates = []
        for r, c in cells:
            for dr, dc in _GEN_NEIGHBORS4:
