+        r0 = int(sprite["r0"])
+        c0 = int(sprite["c0"])
+        color = int(sprite["color"])
+        swapped_color = other[color]
+        swapped_mask = masks[swapped_color]
+        view = output[r0 : r0 + swapped_mask.shape[0], c0 : c0 + swapped_mask.shape[1]]
+        if not np.any(view[swapped_mask] == swapped_color):
+            return False
+    return True
