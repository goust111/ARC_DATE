+        masks = []
+        for coords in comps:
+            r0, c0, r1, c1 = _bbox(coords)
+            rel = coords - np.array([r0, c0], dtype=int)
+            mask = _mask_from_rel((r1 - r0 + 1, c1 - c0 + 1), rel)
