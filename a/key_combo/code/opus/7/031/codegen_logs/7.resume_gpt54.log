+
+def _settle_right(sprites: list[dict], shape: tuple[int, int]) -> list[dict]:
+    h, w = shape
+    settled: list[dict] = []
+    occupied: set[tuple[int, int]] = set()
+
+    order = sorted(
+        range(len(sprites)),
+        key=lambda idx: (sprites[idx]["bbox"][3], sprites[idx]["bbox"][1]),
