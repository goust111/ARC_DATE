+
+    grid = np.full((grid_h, grid_w), BACKGROUND, dtype=int)
+    for sprite in sprites:
+        r0 = int(sprite["r0"])
+        c0 = int(sprite["c0"])
+        color = int(sprite["color"])
+        mask = masks[color]
+        patch = _patch_from_mask(mask, color, BACKGROUND)
+        rr = slice(r0, r0 + box_h)
+        cc = slice(c0, c0 + box_w)
+        view = grid[rr, cc]
+        view[mask] = patch[mask]
+
