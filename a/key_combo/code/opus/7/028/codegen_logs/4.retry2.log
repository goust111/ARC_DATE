+def _count_bends_from_coords(coords: tuple[tuple[int, int], ...]) -> int:
+    pts = set(coords)
+    rows = [r for r, _ in pts]
+    cols = [c for _, c in pts]
+    total = 0
+    for r in range(min(rows), max(rows)):
+        for c in range(min(cols), max(cols)):
+            filled = 0
+            for dr in (0, 1):
+                for dc in (0, 1):
+                    filled += (r + dr, c + dc) in pts
+            if filled == 3:
+                total += 1
+    return total
