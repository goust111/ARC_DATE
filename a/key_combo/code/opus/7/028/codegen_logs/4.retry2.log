+
+def _instantiate_object(bends: int, mask: np.ndarray, top: int, left: int) -> dict:
+    h, w = mask.shape
+    bbox = (top, left, top + h - 1, left + w - 1)
+    center = (top + (h - 1) // 2, left + (w - 1) // 2)
+    coords = []
+    for r in range(h):
+        for c in range(w):
+            if mask[r, c] == OBJECT_COLOR:
+                coords.append((top + r, left + c))
