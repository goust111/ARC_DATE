+    shapes_by_bends: dict[int, list[tuple[tuple[int, int], ...]]] = defaultdict(list)
+    for size in range(4, 9):
+        for shape in polyominoes[size]:
+            bends = _count_bends_from_coords(shape)
+            if bends in REQUIRED_BEND_COUNTS:
