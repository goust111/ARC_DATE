import itertools
from collections import defaultdict, deque

def norm(cells):
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    r0=min(rs); c0=min(cs)
    cells=sorted((r-r0,c-c0) for r,c in cells)
    return tuple(cells)

def transforms(cells):
    pts=list(cells)
    outs=[]
    for k in range(4):
        arr=pts
        for _ in range(k):
            arr=[(c,-r) for r,c in arr]
        outs.append(norm(arr))
        outs.append(norm([(r,-c) for r,c in arr]))
    return outs

def canon(cells):
    return min(transforms(cells))

def conn(cells):
    s=set(cells); q=[next(iter(s))]; seen={q[0]}
    while q:
        r,c=q.pop()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            p=(r+dr,c+dc)
            if p in s and p not in seen:
                seen.add(p); q.append(p)
    return len(seen)==len(s)

def bends(cells):
    cells=set(cells)
    rs=[r for r,c in cells]; cs=[c for r,c in cells]
    total=0
    for r in range(min(rs), max(rs)):
        for c in range(min(cs), max(cs)):
            cnt=sum((r+dr,c+dc) in cells for dr in [0,1] for dc in [0,1])
            if cnt==3:
                total+=1
    return total

