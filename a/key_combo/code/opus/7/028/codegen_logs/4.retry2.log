+    centers = [obj["center"] for obj in components]
+    if len({r for r, _ in centers}) != len(centers):
+        return False
+    if len({c for _, c in centers}) != len(centers):
+        return False
+
+    areas = [obj["area"] for obj in components]
+    if len(set(areas)) == 1:
+        return False
