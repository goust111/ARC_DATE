+def _canonical_coords(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    variants = [_transform_coords(coords, rotation=k, reflect=flip) for k in range(4) for flip in (False, True)]
+    return min(variants)
