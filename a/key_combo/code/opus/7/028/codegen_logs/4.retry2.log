+            c0 = min(cols)
+            r1 = max(rows)
+            c1 = max(cols)
+            local = _normalize_coords(coords)
+            bends = _count_bends_from_coords(local)
+            components.append(
+                {
+                    "coords": tuple(sorted(coords)),
+                    "coord_set": set(coords),
+                    "bbox": (r0, c0, r1, c1),
+                    "center": (r0 + (r1 - r0) // 2, c0 + (c1 - c0) // 2),
+                    "bends": bends,
+                    "area": len(coords),
