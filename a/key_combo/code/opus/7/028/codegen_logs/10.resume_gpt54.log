+def _slot_origin(slot_r: int, slot_c: int) -> tuple[int, int]:
+    return slot_r * STRIDE, slot_c * STRIDE
+
+
+def _symmetry_closure(mask: np.ndarray, transform) -> np.ndarray:
+    closed = mask.copy()
+    for _ in range(4):
+        nxt = closed | transform(closed)
+        if np.array_equal(nxt, closed):
+            break
+        closed = nxt
+    return closed
+
