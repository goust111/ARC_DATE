+    random.shuffle(modes)
+
+    used_counts: set[int] = set()
+    pieces = []
+    for family, mode in zip(families, modes):
+        piece = _make_piece(used_counts, family, mode)
+        if piece is None:
+            return None
+        pieces.append(piece)
+        used_counts.add(piece["count"])
