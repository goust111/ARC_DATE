) -> list[tuple[int, int]]:
    h, w = sprite.shape
    out = []
    for r in range(n - h + 1):
        for c in range(n - w + 1):
            box = (r, c, r + h - 1, c + w - 1)
            if all(_gen_bboxes_far_enough(box, other) for other in placed):
                out.append((r, c))
