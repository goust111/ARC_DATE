+        if len(candidates) == 1 and np.array_equal(candidates[0], full_mask):
+            options.append(tile)
+    if not options:
+        return None
+    return random.choice(options)
+
+
+def _make_piece(used_counts: set[int], family: str, mode: str) -> dict | None:
+    for _ in range(400):
+        full_mask = _random_family_mask(family)
+        if full_mask is None:
+            continue
+        red_count = int(full_mask.sum())
+        if red_count in used_counts:
+            continue
+        input_tile = _truncate_mask(full_mask, mode)
+        if input_tile is None:
+            continue
+        return {
+            "count": red_count,
+            "input_tile": input_tile,
+            "output_tile": _tile_from_mask(full_mask),
+        }
+    return None
+
+
+def _family_plan() -> list[str]:
+    base = random.sample(FAMILY_NAMES, 4)
+    while len(base) < OCCUPIED_TILES:
+        base.append(random.choice(FAMILY_NAMES))
+    random.shuffle(base)
+    return base
+
+
+def _occupied_slot_indices() -> list[int]:
+    slots = list(range(SLOT_COUNT * SLOT_COUNT))
+    for _ in range(100):
