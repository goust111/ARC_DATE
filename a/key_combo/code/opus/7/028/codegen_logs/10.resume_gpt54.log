    sprites = _gen_build_sprites(color)
    if sprites is None:
        return None

    symmetric, asymmetric = sprites
    canvas = _gen_place_sprites(n, symmetric + [asymmetric])
    if canvas is None:
        return None
    if not _gen_oracle_accepts(canvas, asymmetric):
        return None
    return canvas


