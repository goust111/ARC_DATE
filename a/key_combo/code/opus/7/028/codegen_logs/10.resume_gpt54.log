+FAMILY_COORD_TRANSFORMS = {
+    "rot90": _coord_rot90,
+    "rot180": _coord_rot180,
+    "flip_ud": _coord_flip_ud,
+    "flip_lr": _coord_flip_lr,
+    "diag": _coord_diag,
+    "anti": _coord_anti,
+}
