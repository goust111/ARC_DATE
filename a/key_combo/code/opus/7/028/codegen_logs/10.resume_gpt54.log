+    ("rot90", _rot90),
+    ("rot180", _rot180),
+    ("rot270", _rot270),
+    ("flip_ud", _flip_ud),
+    ("flip_lr", _flip_lr),
+    ("diag", _diag),
+    ("anti", _anti),
+)
