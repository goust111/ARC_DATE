    blocked=np.zeros((H,W),dtype=bool)
    for r,c in pts:
        blocked[r-1:r+2,c-1:c+2]=True
    lab,n=ndimage.label(~blocked, structure=struct)
    infos=[]
    for i in range(1,n+1):
        mask=lab==i
