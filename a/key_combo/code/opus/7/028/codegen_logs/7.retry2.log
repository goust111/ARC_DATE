                if 0<=rr<H and 0<=cc<W:
                    if (rr>0 and mask[rr-1,cc]) or (rr+1<H and mask[rr+1,cc]) or (cc>0 and mask[rr,cc-1]) or (cc+1<W and mask[rr,cc+1]):
