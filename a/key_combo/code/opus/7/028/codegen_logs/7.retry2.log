    pts=[]
    for p in random.sample(coords, len(coords)):
        if all(abs(p[0]-q[0])+abs(p[1]-q[1])>=2 for q in pts): pts.append(p)
        if len(pts)==k: break
    return tuple(sorted(pts))

best_s=(-1,); best_pts=None
