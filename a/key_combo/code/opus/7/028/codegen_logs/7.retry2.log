import itertools, numpy as np
from collections import deque

def build(markers, H=15, W=15, off=(0,0)):
    g=np.zeros((H,W),dtype=int)
    for r,c in markers:
        r+=off[0]; c+=off[1]
        g[r,c]=2
    out=g.copy()
    for r,c in np.argwhere(g==2):
        r=int(r); c=int(c)
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==dc==0: continue
                rr,cc=r+dr,c+dc
                if 0<=rr<H and 0<=cc<W and out[rr,cc]==0:
                    out[rr,cc]=1
    return out

def regions(grid):
    H,W=grid.shape
    seen=np.zeros((H,W),bool)
    regs=[]
    for r in range(H):
      for c in range(W):
        if grid[r,c]"'!=0 or seen[r,c]: continue
        q=deque([(r,c)]); seen[r,c]=1; comp=[]; touch=False
        while q:
          x,y=q.popleft(); comp.append((x,y))
          if x in (0,H-1) or y in (0,W-1): touch=True
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            xx,yy=x+dx,y+dy
            if 0<=xx<H and 0<=yy<W and grid[xx,yy]==0 and not seen[xx,yy]:
              seen[xx,yy]=1; q.append((xx,yy))
        regs.append((comp,touch))
    return [comp for comp,t in regs if not t]

def red_count(comp, inp):
    s=set(comp); cnt=0
    reds=list(map(tuple,np.argwhere(inp==2)))
    for r,c in reds:
      for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        if (r+dr,c+dc) in s:
          cnt+=1; break
    return cnt

cand=[(0,0),(0,2),(0,4),(0,6),(2,0),(2,2),(2,4),(2,6),(4,0),(4,2),(4,4),(4,6),(6,0),(6,2),(6,4),(6,6)]
# search a few 6-9 subsets with at least 3 enclosed regions size>=4
for k in range(6,10):
  found=0
  for subset in itertools.combinations(cand,k):
    inp=np.zeros((15,15),dtype=int)
    for r,c in subset:
      inp[r+4,c+4]=2
    out=build(subset,15,15,(4,4))
    regs=regions(out)
    good=[comp for comp in regs if len(comp)>=4]
    if len(good)>=3:
      counts=sorted(red_count(comp,inp) for comp in good)
      print('"'k',k,'subset',subset,'regions',len(good),'sizes',sorted(len(c) for c in good),'counts',counts)
      found+=1
      if found>=10:
        raise SystemExit
print('done')
