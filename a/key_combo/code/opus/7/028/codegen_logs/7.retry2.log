from scipy import ndimage

def stamp(pts,H=20,W=20):
    blocked=np.zeros((H,W),dtype=bool)
    for r,c in pts:
        blocked[max(0,r-1):min(H,r+2), max(0,c-1):min(W,c+2)] = True
    inp=np.zeros((H,W),dtype=np.uint8)
