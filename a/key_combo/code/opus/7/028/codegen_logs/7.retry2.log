        if size<4:
            continue
        reds=0
        for r,c in pts:
            if (r>0 and mask[r-1,c]) or (r+1<H and mask[r+1,c]) or (c>0 and mask[r,c-1]) or (c+1<W and mask[r,c+1]):
                reds+=1
        infos.append((size,reds,mask))
    return infos

def score(pts):
    infos=analyze(pts)
    counts=[reds for _,reds,_ in infos]
    pos=sum(r>0 for r in counts)
    parity=len(set(r%2 for r in counts if r>0))
    odd=sum(r%2==1 for r in counts)
    return (len(infos), pos, parity, odd, sum(s for s,_,_ in infos), min((s for s,_,_ in infos), default=-1), tuple(sorted(counts)))

def valid(cand):
    for i in range(len(cand)):
        for j in range(i):
            if abs(cand[i][0]-cand[j][0])+abs(cand[i][1]-cand[j][1])<2:
                return False
    return True

def rand_pts():
