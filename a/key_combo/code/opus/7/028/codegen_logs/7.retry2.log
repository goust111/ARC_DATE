                    contrib=True; break
            cnt += contrib
        infos.append((int(mask.sum()),cnt))
    return infos

def valid(pts):
    return all(abs(pts[i][0]-pts[j][0])+abs(pts[i][1]-pts[j][1])>=2 for i in range(len(pts)) for j in range(i))

