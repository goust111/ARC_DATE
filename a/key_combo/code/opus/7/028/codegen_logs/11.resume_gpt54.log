                    end_r = start_r + length - 1
                    cells = tuple((tile_r, tile_c, dr, dc) for tile_r in range(start_r, end_r + 1))
                    endpoints = ((start_r, tile_c, dr, dc), (end_r, tile_c, dr, dc))
                    candidates.append(_gen_candidate(2, ("V", length), cells, endpoints))

