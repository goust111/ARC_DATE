+        for tile_r, tile_cols in by_row.items():
+            if len(tile_cols) < 2:
+                continue
+            for tile_c in range(min(tile_cols), max(tile_cols) + 1):
+                r, c = _pixel_from_lane(row_runs, col_runs, tile_r, tile_c, rel_r, rel_c)
