                for start_c in range(tile_cols - length + 1):
                    end_c = start_c + length - 1
                    cells = tuple((tile_r, tile_c, dr, dc) for tile_c in range(start_c, end_c + 1))
                    endpoints = ((tile_r, start_c, dr, dc), (tile_r, end_c, dr, dc))
