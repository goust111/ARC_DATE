+        by_row: dict[int, list[int]] = defaultdict(list)
+        by_col: dict[int, list[int]] = defaultdict(list)
+        for tile_r, tile_c in points:
+            by_row[tile_r].append(tile_c)
+            by_col[tile_c].append(tile_r)
