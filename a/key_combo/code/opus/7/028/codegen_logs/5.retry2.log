+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+SEP = 5
+BG = 0
+ROW_COLORS = (1, 2, 3)
+DISTRACTORS = (4, 7)
+
+TILE_ROWS_RANGE = (3, 5)
+TILE_COLS_RANGE = (3, 5)
+GROUP_COUNT_RANGE = (2, 4)
+MIN_SPAN = 3
+MAX_GENERATION_ATTEMPTS = 400
+MAX_DISTRACTORS_PER_ROW = 2
