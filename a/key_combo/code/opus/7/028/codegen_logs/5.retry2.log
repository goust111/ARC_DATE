+    candidates = _build_candidates(tile_rows, tile_cols, row_colors)
+    groups: list[dict] = []
+    occupied: set[tuple[int, int, int, int]] = set()
+    used_keys: set[tuple[int, int]] = set()
+    present_orientations: set[str] = set()
+
+    while len(groups) < group_count:
