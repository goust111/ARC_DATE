+
+def _render_output(sim: dict, grid_shape: tuple[int, int]) -> np.ndarray:
+    out = np.zeros(grid_shape, dtype=int)
+    for idx in sim["inactive"]:
+        for rr, cc in sim["figures"][idx]["coords"]:
+            out[int(rr), int(cc)] = MAROON
+    for idx in sim["order"]:
