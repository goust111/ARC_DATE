+def _render_input_from_figures(figures: list[dict], grid_shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(grid_shape, dtype=int)
+    for fig in figures:
+        r0, c0, _, _ = fig["bbox"]
+        color = int(fig["color"])
+        mask = fig["mask"]
+        for rr, cc in np.argwhere(mask):
+            grid[r0 + int(rr), c0 + int(cc)] = color
