+    if mode == "full":
+        target_active = count
+    elif mode == "short":
+        target_active = min(count - 2, rng.randint(2, 3))
+    else:
+        target_active = rng.randint(3, count - 1)
+
+    seed_shape = rng.choice(SEED_SHAPES)
