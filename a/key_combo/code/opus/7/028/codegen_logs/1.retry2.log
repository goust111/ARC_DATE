+from __future__ import annotations
+
+from collections import Counter
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+ORANGE = 7
+MAROON = 9
+PALETTE = [1, 2, 3, 4, 5, 6]
+
+GRID_MIN = 18
+GRID_MAX = 24
+COUNT_CHOICES = [5, 6]
+GEN_ATTEMPTS = 1500
