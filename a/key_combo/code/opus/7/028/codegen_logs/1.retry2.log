+
+    grid = _render_input_from_figures(all_figures, (h, w))
+    parsed = _parse_figures(grid)
+    parsed_sim = _simulate(parsed, (h, w))
+    if not np.array_equal(_render_output(parsed_sim, (h, w)), main(grid)):
