+
+def _hits_bbox(cells: set[tuple[int, int]], tl: tuple[int, int]) -> bool:
+    r0, c0 = tl
+    for rr, cc in cells:
+        if r0 <= rr <= r0 + 2 and c0 <= cc <= c0 + 2:
+            return True
+    return False
