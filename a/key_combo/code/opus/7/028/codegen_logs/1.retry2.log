+    if not candidates:
+        return None
+    return rng.choice(candidates)
+
+
+def _place_general_inactive(
+    active_figures: list[dict],
+    occupied: list[tuple[int, int]],
+    grid_shape: tuple[int, int],
+    rng: random.Random,
+) -> tuple[int, int] | None:
+    h, w = grid_shape
+    candidates: list[tuple[int, int]] = []
+    for tr in range(h - 2):
+        for tc in range(w - 2):
+            tl = (int(tr), int(tc))
+            if not _can_place_bbox(tl, occupied, min_gap=1):
+                continue
+            if min(_bbox_gap(tl, other_tl) for other_tl in occupied) > 6:
+                continue
+            if any(_hits_bbox(fig["stamp_cells"], tl) for fig in active_figures):
+                continue
+            candidates.append(tl)
+    if not candidates:
+        return None
+    return rng.choice(candidates)
+
+
+def _build_attempt(rng: random.Random, mode: str, require_collision: bool, require_clipping: bool) -> np.ndarray | None:
