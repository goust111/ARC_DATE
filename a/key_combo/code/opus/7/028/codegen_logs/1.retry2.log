+    collision_pairs: list[tuple[int, int]] = []
+    for pos_a, idx_a in enumerate(order):
+        for idx_b in order[pos_a + 1 :]:
+            if enriched[idx_a]["stamp_cells"] & enriched[idx_b]["stamp_cells"]:
