+    region_only_inactive = False
+    near_inactive = False
+    for idx in active:
+        for j in inactive:
+            if _region_intersects(enriched[idx]["bbox"][:2], enriched[j]["bbox"][:2]):
+                region_only_inactive = True
+            if _bbox_gap(enriched[idx]["bbox"][:2], enriched[j]["bbox"][:2]) <= 4:
+                near_inactive = True
