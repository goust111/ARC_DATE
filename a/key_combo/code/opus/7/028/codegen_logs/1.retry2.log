+def _parse_figures(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert set(map(int, np.unique(g))).issubset(set(range(10)))
+    comps = _components_mask(g != BLACK)
