+def _bbox_overlap(tl_a: tuple[int, int], tl_b: tuple[int, int]) -> bool:
+    ar, ac = tl_a
+    br, bc = tl_b
+    return not (ar + 2 < br or br + 2 < ar or ac + 2 < bc or bc + 2 < ac)
