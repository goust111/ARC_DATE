+    order: list[int] = []
+    rounds: list[list[int]] = []
+    parent: dict[int, int] = {}
+    frontier = [seed_idx]
+    while frontier:
+        frontier = sorted(frontier, key=lambda i: _scan_key(enriched[i]))
+        rounds.append(list(frontier))
+        next_frontier: list[int] = []
+        for idx in frontier:
