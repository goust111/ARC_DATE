+        for dr in range(3):
+            for dc in range(3):
+                tl = (int(rr - dr), int(cc - dc))
+                if not (0 <= tl[0] <= h - 3 and 0 <= tl[1] <= w - 3):
+                    continue
+                if not _can_place_bbox(tl, occupied, min_gap=2):
+                    continue
