+    return {
+        "figures": enriched,
+        "seed_idx": seed_idx,
+        "active": active,
+        "inactive": inactive,
+        "order": order,
+        "rounds": rounds,
+        "parent": parent,
+        "collision_pairs": collision_pairs,
+        "region_only_inactive": region_only_inactive,
+        "near_inactive": near_inactive,
+        "clipped_any": any(
