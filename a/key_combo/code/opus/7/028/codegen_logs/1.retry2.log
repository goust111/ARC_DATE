+    occupied: list[tuple[int, int]],
+    grid_shape: tuple[int, int],
+    rng: random.Random,
+) -> tuple[int, int] | None:
+    h, w = grid_shape
+    candidates: list[tuple[int, int]] = []
+    for tr in range(h - 2):
