+
+def _pick_seed_tl(h: int, w: int, rng: random.Random, require_clipping: bool) -> tuple[int, int]:
+    if require_clipping:
+        edge_rows = [0, 1, 2, h - 5, h - 4, h - 3]
+        edge_cols = [0, 1, 2, w - 5, w - 4, w - 3]
+        if rng.random() < 0.5:
+            return int(rng.choice(edge_rows)), int(rng.randint(0, w - 3))
