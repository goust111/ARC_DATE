+    if np.array_equal(grid, main(grid)):
+        return None
+    if not np.array_equal(main(grid), _render_output(parsed_sim, (h, w))):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    profiles = [
+        ("mixed", False, False),
+        ("mixed", True, False),
+        ("short", False, True),
+        ("full", False, True),
