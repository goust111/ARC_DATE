+        "is_seed": bool(is_seed),
+        "shape": shape,
+        "stamp_cells": stamp_cells,
+        "clipped": int(clipped),
+        "raw_stamp_cells": int(len(shape["rel_stamp"])),
+    }
+
+
+def _actual_cascade_from_generated(figures: list[dict], grid_shape: tuple[int, int]) -> dict:
+    raw_figs = [
+        {
+            "bbox": fig["bbox"],
+            "coords": fig["coords"],
+            "mask": fig["mask"],
+            "color": fig["color"],
+            "is_seed": fig["is_seed"],
