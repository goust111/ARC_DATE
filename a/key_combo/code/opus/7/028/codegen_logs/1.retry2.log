+        "seed_idx": seed_idx,
+        "active": active,
+        "inactive": inactive,
+        "order": order,
+        "rounds": rounds,
+        "parent": parent,
+        "collision_pairs": collision_pairs,
+        "region_only_inactive": region_only_inactive,
+        "near_inactive": near_inactive,
+        "clipped_any": any(
+            enriched[idx]["clipped"] > 0 and enriched[idx]["raw_stamp_cells"] > len(enriched[idx]["stamp_cells"])
+            for idx in order
