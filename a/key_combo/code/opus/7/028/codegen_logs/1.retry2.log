+
+def _bbox_gap(tl_a: tuple[int, int], tl_b: tuple[int, int]) -> int:
+    ar, ac = tl_a
+    br, bc = tl_b
+    dr = max(0, max(br - (ar + 2), ar - (br + 2)))
+    dc = max(0, max(bc - (ac + 2), ac - (bc + 2)))
+    return int(max(dr, dc))
