+    flip_lr = bool(random.getrandbits(1))
+    flip_ud = bool(random.getrandbits(1))
+    inp = _maybe_flip(inp, flip_lr, flip_ud)
+
+    out = main(inp)
+    _semantic_checks(inp, out)
+    return inp
