+
+    blue_color = BLUE
+    red_color = RED
+    green_color = GREEN
+
+    blue_variant = random.choice(("lt_rb", "lb_rt"))
+    if blue_variant == "lt_rb":
+        _place_top_center(scene, 1, 0, blue_color)
+        _place_bottom_center(scene, 1, 2, blue_color)
+    else:
