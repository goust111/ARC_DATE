+    src = tile.copy()
+    for r in range(TILE_SIZE):
+        for c in cols:
+            mc = TILE_SIZE - 1 - c
+            mirrored = int(src[r, mc])
+            if mirrored == TEAL:
+                mirrored = ORANGE
+            out[r, c] = mirrored
+    return out
