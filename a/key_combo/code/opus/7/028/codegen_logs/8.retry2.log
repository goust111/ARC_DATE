+    deduped: list[tuple[int, int]] = []
+    seen: set[tuple[int, int]] = set()
+    for cell in cells:
+        if cell not in seen:
+            deduped.append(cell)
+            seen.add(cell)
+    return deduped
+
+
+def _draw_connections(scene: np.ndarray, ports: dict[int, list[dict[str, tuple[int, int] | int]]]) -> np.ndarray:
+    out = scene.copy()
