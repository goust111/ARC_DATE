+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+PORT_COLORS = (BLUE, RED, GREEN)
+TILE_SIZE = 5
+GAP = 1
+TILE_STRIDE = TILE_SIZE + GAP
+TILE_COUNT = 3
+GRID_SIZE = TILE_COUNT * TILE_SIZE + (TILE_COUNT - 1) * GAP
+GEN_RETRIES = 300
