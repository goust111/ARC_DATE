+    else:
+        assert ta_c == tb_c, "same-color tiles must share a tile row or tile column"
+        start, end = (a, b) if ta_r < tb_r else (b, a)
+        sr, sc = start["entry"]
+        er, ec = end["entry"]
+        for r in _inclusive_range(sr, er):
+            cells.append((r, sc))
+        if sc != ec:
+            for c in _inclusive_range(sc, ec):
+                cells.append((er, c))
