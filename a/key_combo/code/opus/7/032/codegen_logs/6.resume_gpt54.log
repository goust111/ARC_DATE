+
+    # Keep outputs visually sparse enough to read.
+    if np.count_nonzero(out == BLUE) > (grid.shape[0] * grid.shape[1]) // 3:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
