+    direction = random.choice([(0, 1), (1, 0), (1, 1), (1, -1)])
+    distance = random.randint(*INPUT_LINE_DIST_RANGE)
+    dr, dc = direction
+    if dc == -1:
+        c0_min = 1 + distance
+        c0_max = shape[1] - 2
+    else:
+        c0_min = 1
+        c0_max = shape[1] - 2 - distance * abs(dc)
+    r0_min = 1
+    r0_max = shape[0] - 2 - distance * abs(dr)
