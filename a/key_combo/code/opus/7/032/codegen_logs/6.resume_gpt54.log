+
+def _shortest_line(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = a
+    tr, tc = b
+    path = [(r, c)]
+    r_step = _sign(tr - r)
+    c_step = _sign(tc - c)
+    while r != tr and c != tc:
+        r += r_step
+        c += c_step
+        path.append((r, c))
+    while r != tr:
+        r += r_step
+        path.append((r, c))
+    while c != tc:
+        c += c_step
+        path.append((r, c))
+    return path
+
+
+def _diag_run_length(path: list[tuple[int, int]]) -> int:
+    longest = 0
+    run_steps = 0
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        if abs(r1 - r0) == 1 and abs(c1 - c0) == 1:
+            run_steps += 1
+        else:
+            if run_steps:
+                longest = max(longest, run_steps + 1)
+                run_steps = 0
+    if run_steps:
+        longest = max(longest, run_steps + 1)
+    return longest
