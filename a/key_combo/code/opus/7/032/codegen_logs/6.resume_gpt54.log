+
+def _build_input_grid(
+    shape: tuple[int, int],
+    anchors: list[tuple[int, int]],
+    sprite: frozenset[tuple[int, int]],
+    input_pair: tuple[tuple[int, int], tuple[int, int]],
+) -> np.ndarray:
+    grid = np.full(shape, BLACK, dtype=int)
