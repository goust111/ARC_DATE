    r2: int = 0,
    c2: int = 0,
    background: int = Color.BLACK,
) -> bool:
    """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
    bg = int(background)
    a = object1
    b = object2
    H1, W1 = a.shape
    H2, W2 = b.shape

    dr = int(r2) - int(r1)
    dc = int(c2) - int(c1)

    ra0 = max(0, dr)
    ca0 = max(0, dc)
    ra1 = min(H1, dr + H2)
    ca1 = min(W1, dc + W2)
    if ra0 >= ra1 or ca0 >= ca1:
        return False

    rb0 = ra0 - dr
    cb0 = ca0 - dc
    rb1 = rb0 + (ra1 - ra0)
    cb1 = cb0 + (ca1 - ca0)
    return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())


