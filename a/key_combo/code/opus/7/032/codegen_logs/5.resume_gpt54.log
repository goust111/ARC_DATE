+    cavity = {(r, c) for r in range(h) for c in range(w) if (r, c) not in walls}
+    box = (0, 0, h - 1, w - 1)
+    mouth, endpoints, forward_step, diagonal_steps = _mouth_and_endpoints(box, direction)
+    return {
