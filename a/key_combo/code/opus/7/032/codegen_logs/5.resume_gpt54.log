+
+
+def _mouth_and_endpoints(box: tuple[int, int, int, int], direction: str):
+    r0, c0, r1, c1 = box
+    if direction == "up":
+        return (
+            [(r0, c) for c in range(c0 + 1, c1)],
+            [(r0, c0), (r0, c1)],
+            (-1, 0),
+            [(-1, -1), (-1, 1)],
+        )
+    if direction == "down":
+        return (
+            [(r1, c) for c in range(c0 + 1, c1)],
+            [(r1, c0), (r1, c1)],
+            (1, 0),
