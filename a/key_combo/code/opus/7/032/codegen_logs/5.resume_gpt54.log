+        [(r0, c1), (r1, c1)],
+        (0, 1),
+        [(-1, 1), (1, 1)],
+    )
+
+
+def _cavity_cells(grid: np.ndarray, coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    box = _bbox(coords)
+    r0, c0, r1, c1 = box
