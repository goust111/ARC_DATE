+    if quadrant == "ur":
+        return r < mr and c > mc + 1
+    if quadrant == "ll":
+        return r > mr + 1 and c < mc
+    return r > mr + 1 and c > mc + 1
+
+
+def _ray_path(shape: tuple[int, int], blocked: set[tuple[int, int]], start: tuple[int, int], step: tuple[int, int]):
+    r, c = start
+    dr, dc = step
