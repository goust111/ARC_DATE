+
+def _apply_ray_action(out: np.ndarray, source: np.ndarray, box: tuple[int, int, int, int], direction: str, color: int) -> None:
+    mouth, endpoints, forward_step, diagonal_steps = _mouth_and_endpoints(box, direction)
