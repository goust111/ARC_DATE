+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+CUP = 5
+MARKER_COLORS = (1, 2, 3, 7)
+QUADRANTS = ("ul", "ur", "ll", "lr")
+DIRECTIONS = ("up", "down", "left", "right")
+DIR_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+CENTER_FACING = {
+    "ul": {"right", "down"},
+    "ur": {"left", "down"},
+    "ll": {"right", "up"},
+    "lr": {"left", "up"},
+}
+GRID_SIZE_RANGE = (13, 16)
