+    mr, mc = _locate_marker_block(g)
+    block = g[mr : mr + 2, mc : mc + 2]
+    quadrant_color = {
+        "ul": int(block[1, 1]),
+        "ur": int(block[1, 0]),
+        "ll": int(block[0, 1]),
+        "lr": int(block[0, 0]),
+    }
