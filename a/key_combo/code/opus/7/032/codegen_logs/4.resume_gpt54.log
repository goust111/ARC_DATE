+    full = _scale_mask(small_mask, factor)
+    small_area = int(small_mask.sum())
+    for _ in range(300):
+        r0 = int(rng.integers(0, full.shape[0]))
+        r1 = int(rng.integers(r0 + 1, full.shape[0] + 1))
+        c0 = int(rng.integers(0, full.shape[1]))
