+
+
+def _infer_sequence_pattern(
+    boxes: list[tuple[int, int, int, int]]
+) -> tuple[tuple[int, ...], tuple[int, int, int, int]]:
+    for indices in _candidate_patterns(len(boxes)):
+        delta = _infer_delta(boxes, indices)
+        if delta is None:
