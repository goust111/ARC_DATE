+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+BAR_COLORS = (3, 7)
+GEN_ATTEMPTS = 400
+
+SIDE_PATTERNS = (
+    ("T", "R"),
+    ("R", "B"),
+    ("B", "L"),
+    ("L", "T"),
+    ("T", "L", "R"),
+    ("R", "T", "B"),
+    ("B", "L", "R"),
+    ("L", "T", "B"),
+)
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _bbox_area(box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = box
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _stroke_cells(
+    box: tuple[int, int, int, int],
+    sides: tuple[str, ...],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, box)
+    if r1 < r0 or c1 < c0:
+        return set()
+    h, w = shape
+    cells: set[tuple[int, int]] = set()
+    if "T" in sides:
+        for c in range(c0, c1 + 1):
+            if 0 <= r0 < h and 0 <= c < w:
+                cells.add((r0, c))
+    if "B" in sides:
+        for c in range(c0, c1 + 1):
+            if 0 <= r1 < h and 0 <= c < w:
+                cells.add((r1, c))
+    if "L" in sides:
+        for r in range(r0, r1 + 1):
+            if 0 <= r < h and 0 <= c0 < w:
+                cells.add((r, c0))
+    if "R" in sides:
+        for r in range(r0, r1 + 1):
+            if 0 <= r < h and 0 <= c1 < w:
+                cells.add((r, c1))
+    return cells
+
+
+def _extract_sides(comp: list[tuple[int, int]]) -> tuple[str, ...]:
+    box = _bbox(comp)
+    r0, c0, r1, c1 = box
+    pts = set(comp)
+    sides: list[str] = []
+    if all((r0, c) in pts for c in range(c0, c1 + 1)):
+        sides.append("T")
+    if all((r1, c) in pts for c in range(c0, c1 + 1)):
+        sides.append("B")
+    if all((r, c0) in pts for r in range(r0, r1 + 1)):
+        sides.append("L")
+    if all((r, c1) in pts for r in range(r0, r1 + 1)):
+        sides.append("R")
