            coords = np.array(
                [(p // TEMPLATE_BBOX_MAX, p % TEMPLATE_BBOX_MAX) for p in flat_cells],
                dtype=int,
            )
            coords -= coords.min(axis=0)
            h = int(coords[:, 0].max()) + 1
            w = int(coords[:, 1].max()) + 1
            if h > TEMPLATE_BBOX_MAX or w > TEMPLATE_BBOX_MAX:
