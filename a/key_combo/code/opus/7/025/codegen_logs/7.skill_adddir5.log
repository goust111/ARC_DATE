+        while stack:
+            rr, cc = stack.pop()
+            coords.append((rr, cc))
+            for dr, dc in deltas:
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
