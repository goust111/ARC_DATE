+from __future__ import annotations
+
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+TEAL = 8
+
+ROTATION_TO_COLOR = {
+    0: RED,
+    1: YELLOW,
+    2: ORANGE,
+    3: BLUE,
+}
+
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if (dr, dc) != (0, 0)
+)
+
+GRID_MIN = 13
+GRID_MAX = 18
+COPY_COUNT_MIN = 3
+COPY_COUNT_MAX = 5
+NOISE_COUNT_MIN = 2
+NOISE_COUNT_MAX = 8
+PLACEMENT_GAP = 1
+GEN_ATTEMPTS = 400
