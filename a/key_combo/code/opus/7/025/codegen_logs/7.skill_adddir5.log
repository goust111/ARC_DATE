+    deltas = NEIGHBORS8 if connectivity == 8 else ((-1, 0), (1, 0), (0, -1), (0, 1))
+    out: list[np.ndarray] = []
+
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
