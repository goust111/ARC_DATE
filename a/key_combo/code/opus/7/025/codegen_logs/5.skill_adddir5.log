+        int(out[0, 0]),
+        int(out[0, 1]),
+        int(out[0, 2]),
+        int(out[1, 0]),
+        int(out[1, 2]),
+        int(out[2, 0]),
+        int(out[2, 1]),
+        int(out[2, 2]),
+    )
