+def _decode_bridge(comp: np.ndarray, ring_cell_to_ring: dict[tuple[int, int], int]) -> tuple[int, int]:
+    coords = {tuple(map(int, pt)) for pt in comp}
+    rows = {r for r, _ in coords}
+    cols = {c for _, c in coords}
