0010: # The input grid consists of a small grid filled completely with different colors.
0011: # To create the output grid, take the colors present in the input, and sort them by number of pixels of that color in the input, greatest to least. Then create an output grid of shape (num_colors, max_num_pixels), where num_colors is the number of colors in the input, and max_num_pixels is the max number of pixels of any color in the input. Then fill each row with the color corresponding to that row's index in the sorted list of colors, filling K pixels from the top downwards, where K is the number of pixels of that color in the input. Leave the remaining pixels in the row black.
0012: 
0013: def main(input_grid):
0014:     """
0015:     Convert color frequencies into a top-aligned histogram ordered from most to least common.
0016: 
0017:     Input structure:
0018:     - The input is a small grid fully filled with non-black colors.
0019:     - Each color may appear multiple times.
0020:     - Original pixel positions are irrelevant after counting.
0021: 
0022:     Rule:
0023:     - Count how many cells each color occupies.
0024:     - Sort colors by descending count.
0025:     - Build a black output with one column per color and fill each column from the top for that color's count.
0026: 
0027:     Key insight:
0028:     - The output is a frequency chart: color order is determined by population, and column height is
0029:       the count itself.
0030:     """
0031:     # find all unique colors in the input grid
0032:     colors = np.unique(input_grid)
0033: 
0034:     # track the number of pixels of each color in the input grid
0035:     colors_with_counts = [(c, np.sum(input_grid == c)) for c in colors]
0036:     sorted_colors_with_counts = sorted(colors_with_counts, key=lambda x: x[1], reverse=True)
0037: 
0038:     # In canonical (r,c), output is (max_count, num_colors) and we fill down columns.
0039:     num_colors = len(colors)
0040:     max_num_pixels = max([count for _, count in sorted_colors_with_counts])
0041:     output_grid = np.full((max_num_pixels, num_colors), Color.BLACK)
0042: 
0043:     # For each color in the list, color K pixels from top to bottom in that column.
0044:     for i, (color, count) in enumerate(sorted_colors_with_counts):
0045:         output_grid[:count, i] = color
0046: 
0047:     return output_grid
0048: 
