+            if any(v in (BLACK, GRAY) for v in vals):
+                continue
+            center = (r, c)
+            assert center not in occupied_centers
+            occupied_centers.add(center)
+            rings.append(
+                {
+                    "center": center,
+                    "cells": tuple(cells),
+                    "values": tuple(vals),
