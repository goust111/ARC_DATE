+    for chosen in itertools.combinations(idx_edges, n - 1):
+        deg = [0] * n
+        graph = [[] for _ in range(n)]
+        for a, b in chosen:
+            deg[a] += 1
+            deg[b] += 1
+            graph[a].append(b)
+            graph[b].append(a)
