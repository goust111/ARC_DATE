import random
random.seed(0)
# quick feasibility scratch for degree-constrained random graph on 3-5 nodes with 0-3 degrees,
# at least one 0-degree and one >=2 degree, edges noncross not checked.
for n in range(3,6):
    ok=[]
    nodes=list(range(n))
    import itertools
    pairs=list(itertools.combinations(nodes,2))
    for mask in range(1<<len(pairs)):
        deg=[0]*n
        e=[]
        for i,p in enumerate(pairs):
            if mask>>i &1:
                a,b=p;deg[a]+=1;deg[b]+=1;e.append(p)
        if max(deg)<=3 and any(d==0 for d in deg) and any(d>=2 for d in deg):
            ok.append((deg,e))
    print(n, len(ok), ok[:10])
