+def _rotate_ring_values(values: tuple[int, ...], steps: int) -> tuple[int, ...]:
+    steps %= 4
+    patch = np.array(
+        [
+            [values[0], values[1], values[2]],
+            [values[3], BLACK, values[4]],
+            [values[5], values[6], values[7]],
