spec:
  grid: 15-25 rows x 15-25 cols, bg 0
  rectangle:
    shape: square, side 5-8
    color: 2 (always)
    solid, 4-connected; unique largest foreground component
    placement: margin >= 1 on every side; at least 2 on sides with markers [observed]
  markers:
    count: exactly 8 singleton pixels
    color: any non-{0,2} color (varies per puzzle, single color)
    each aligned with exactly one side strip (not diagonal quadrants)
    one marker per column (top/bottom) or per row (left/right) on its side
    distance from rect edge: >= 2 [observed]
    distributed across 2-4 sides; some sides may have 0 markers
  transform:
    for each rect column without a top/bottom marker on that side, fill bg cells from rect edge to grid edge with color 2
    for each rect row without a left/right marker on that side, fill bg cells from rect edge to grid edge with color 2
    markers and rectangle preserved; extensions only in side strips, never in corner quadrants

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid H x W in [15,25]. Pick square side S in [5,8].
    2. Place rect so each margin >= 2 (ensures room for markers on all sides).
    3. Choose marker_color from non-{0,2} colors. Decide total 8 markers distributed across 2-4 sides.
       Per side, pick 0 to S/2 marked columns/rows (summing to 8 total); each marks one col/row of rect on that side.
    4. Build the output: fill all unmarked rect columns/rows to grid edges in their side strips.
    5. For each marked position, place a marker pixel in the corresponding side strip at distance >= 2 from rect, within grid bounds.
    6. Derive input by removing the extensions (set them back to bg 0), keeping rect and markers.
```
