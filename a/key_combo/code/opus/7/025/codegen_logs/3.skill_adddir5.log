+def _analyze_semantics(inp: np.ndarray, out: np.ndarray) -> dict[str, object] | None:
+    try:
+        rect = _find_rectangle(inp)
+        marked = _marker_sets(inp, rect)
+        extended = _extend_rays(inp, rect, marked)
+    except AssertionError:
+        return None
