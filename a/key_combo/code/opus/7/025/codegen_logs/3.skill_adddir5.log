  "type": "transform_in_place",
  "src": "largest solid foreground rectangle and singleton marker pixels aligned with its four side strips",
  "transform": "extend the rectangle color through every unmarked projected row or column on each side; marker-aligned rows or columns stay bg and the markers are preserved"
}
</annotation>
