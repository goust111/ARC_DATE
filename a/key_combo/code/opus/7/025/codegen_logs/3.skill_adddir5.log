+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+_GEN_MAX_ATTEMPTS = 800
+_GEN_BRANCHES = 4
+_GEN_COUNTER = 0
+_SEEN_INPUT_SIGS: set[str] = set()
+_SEEN_OUTPUT_SIGS: set[str] = set()
+
