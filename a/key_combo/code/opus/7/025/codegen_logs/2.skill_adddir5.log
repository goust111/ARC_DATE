+        ok = True
+        for h, s in zip(heights, steps):
+            bands.append((s, s + h - 1))
+        for a, b in zip(bands, bands[1:]):
+            if max(a[0], b[0]) > min(a[1], b[1]):
+                ok = False
+                break
