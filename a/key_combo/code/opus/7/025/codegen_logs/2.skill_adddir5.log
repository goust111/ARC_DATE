+    def rec(idx: int, left: int, cur: list[int]) -> None:
+        if idx == width:
+            if left == 0 and any(h > 0 for h in cur):
+                intervals = []
+                for h in cur:
+                    if h <= 0:
+                        return
+                    intervals.append((0, h - 1))
+                for a, b in zip(intervals, intervals[1:]):
+                    if max(a[0], b[0]) > min(a[1], b[1]):
