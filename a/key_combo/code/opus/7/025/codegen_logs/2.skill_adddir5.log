+    cavity_h = max(hh + ss for hh, ss in zip(heights, steps)) + random.randint(1, 2)
+    bottom = top + cavity_h + 1
+    right = left + width + 1
+    if top < 1 or left < 1 or bottom >= h - 1 or right >= w - 1:
+        return None
+
+    region = grid[top : bottom + 1, left : right + 1]
