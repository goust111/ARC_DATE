+    input_blues = set(map(tuple, np.argwhere(inp == BLUE)))
+    settled_blues = set(map(tuple, np.argwhere(settled == BLUE)))
+    if input_blues != settled_blues:
+        moved = True
+    if not moved:
+        return False
+
+    if np.any(inp[0] == BLUE):
+        return False
+    return True
