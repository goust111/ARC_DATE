+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _settle_water(grid: np.ndarray) -> np.ndarray:
+    g = np.array(grid, dtype=int).copy()
+    h, w = g.shape
+    for c in range(w):
+        rows = sorted((int(r) for r in np.flatnonzero(g[:, c] == BLUE)), reverse=True)
+        if not rows:
+            continue
+        g[rows, c] = BLACK
+        for start_r in rows:
+            r = int(start_r)
+            while r + 1 < h and int(g[r + 1, c]) == BLACK:
+                r += 1
+            g[r, c] = BLUE
+    return g
+
+
+def _is_closed_group(grid: np.ndarray, coords: np.ndarray) -> bool:
+    h, w = grid.shape
+    cells = {tuple(map(int, pt)) for pt in coords}
+    if any(r == 0 or c == 0 or c == w - 1 for r, c in cells):
+        return False
+
+    q = deque()
+    seen: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if nr == h:
+                continue
+            if not (0 <= nr < h and 0 <= nc < w):
+                return False
+            if int(grid[nr, nc]) == BLACK and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+
+    while q:
+        r, c = q.popleft()
+        if r == 0 or c == 0 or c == w - 1:
+            return False
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and int(grid[nr, nc]) == BLACK and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return True
+
+
+def _fill_color_for_area(area: int) -> int:
+    if area <= 2:
+        return RED
+    if area <= 4:
+        return GREEN
+    return YELLOW
+
+
+def _group_info(grid: np.ndarray) -> list[dict]:
+    info = []
+    for coords in _components_of_color(grid, BLUE):
+        area = int(coords.shape[0])
