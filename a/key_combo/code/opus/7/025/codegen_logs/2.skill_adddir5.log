+
+def _fill_color_for_area(area: int) -> int:
+    if area <= 2:
+        return RED
+    if area <= 4:
+        return GREEN
+    return YELLOW
+
+
+def _group_info(grid: np.ndarray) -> list[dict]:
+    info = []
+    for coords in _components_of_color(grid, BLUE):
+        area = int(coords.shape[0])
+        info.append(
+            {
+                "coords": coords,
+                "area": area,
+                "closed": _is_closed_group(grid, coords),
+                "bbox": (
+                    int(coords[:, 0].min()),
+                    int(coords[:, 1].min()),
+                    int(coords[:, 0].max()),
+                    int(coords[:, 1].max()),
+                ),
+            }
+        )
+    return info
