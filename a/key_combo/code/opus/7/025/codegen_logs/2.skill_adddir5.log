+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_layout()
+        if grid is not None and _semantic_ok(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle input")

