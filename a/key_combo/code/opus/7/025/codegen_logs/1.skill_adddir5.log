+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GRAY = 5
+
+SLOT_SIZE = 3
+SLOT_GAP = 1
+SLOT_MARGIN = 1
+SLOT_STRIDE = SLOT_SIZE + SLOT_GAP
+GEN_RETRIES = 400
