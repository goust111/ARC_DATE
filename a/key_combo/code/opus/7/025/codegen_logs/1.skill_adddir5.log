+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or g[r, c] != color:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords_list: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords_list.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
