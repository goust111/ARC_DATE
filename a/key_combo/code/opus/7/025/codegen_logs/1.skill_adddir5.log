    return _gen_pick_bbox_count_first(by_dim)


def _gen_render_pair(pattern: np.ndarray, box: _GenBox) -> tuple[np.ndarray, np.ndarray]:
    r0, c0, r1, c1 = box

    out = pattern.copy()
    out_window = out[r0 : r1 + 1, c0 : c1 + 1]
    marker_mask = out_window == _GEN_BLACK
