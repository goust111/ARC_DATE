+
+
+def _enumerate_shape_library() -> list[tuple[tuple[int, int], ...]]:
+    shapes: set[tuple[tuple[int, int], ...]] = set()
+    for bits in range(1 << 9):
+        area = bits.bit_count()
+        if not 3 <= area <= 6:
