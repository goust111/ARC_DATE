+        return mr, mc
+
+    if side == "down":
+        mr = random.randint(r1 + length, height - 1)
+        if orientation == "horizontal":
+            choices = _endpoint_favor_values(c0, c1, favor_first)
+            mc = random.choice(choices)
+        else:
