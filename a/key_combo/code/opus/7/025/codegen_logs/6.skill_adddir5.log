+def _generate_attempt(orientation: str, side: str, marker_color: int) -> np.ndarray | None:
+    height = random.randint(*GEN_SIZE_RANGE)
+    width = random.randint(*GEN_SIZE_RANGE)
+    length = random.randint(*GEN_LENGTH_RANGE)
