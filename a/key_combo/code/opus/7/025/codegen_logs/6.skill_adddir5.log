+def _marker_for_side(info: dict, side: str, marker_color: int, favor_first: bool) -> tuple[int, int]:
+    height, width = info["shape"]
+    r0, c0, r1, c1 = info["bbox"]
+    orientation = info["orientation"]
+    length = info["length"]
+
