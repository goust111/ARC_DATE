+def _grow_connected_mask(shape: tuple[int, int], required: list[tuple[int, int]], area: int) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    frontier = set()
+    for cell in required:
+        r, c = cell
+        mask[r, c] = True
+    while int(mask.sum()) < area:
