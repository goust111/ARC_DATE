+
+def _target_mask(shape: tuple[int, int], orient: str) -> np.ndarray:
+    h, w = shape
+    if orient == "H":
+        anchor = random.randrange(w)
+        required = [(0, anchor), (h - 1, anchor)]
+    else:
+        anchor = random.randrange(h)
+        required = [(anchor, 0), (anchor, w - 1)]
