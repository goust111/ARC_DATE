        _paint_full_ray_from_bar(expected, target_row, target_col)
    return inp, expected


def _passes_oracle(inp: np.ndarray, expected: np.ndarray) -> bool:
    try:
        actual = main(inp)
    except AssertionError:
        return False
    return np.array_equal(actual, expected)


