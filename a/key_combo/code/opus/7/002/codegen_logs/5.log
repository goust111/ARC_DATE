+                turns += 1
+            for _ in range(seg_len):
+                cur = (cur[0] + direction[0], cur[1] + direction[1])
+                if cur in used:
+                    ok = False
+                    break
+                cells.append(cur)
+                used.add(cur)
+            if not ok:
+                break
+
+        if not ok or turns == 0:
+            continue
+
+        coords = _normalize_coords(cells)
+        if coords[:, 0].ptp() == 0 or coords[:, 1].ptp() == 0:
+            continue
