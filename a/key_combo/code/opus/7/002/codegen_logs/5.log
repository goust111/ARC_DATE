+    halo = np.zeros_like(path_mask, dtype=bool)
+    for comp in path_components:
+        comp_mask = np.zeros_like(path_mask, dtype=bool)
+        comp_mask[comp[:, 0], comp[:, 1]] = True
+        halo |= _dilate8(comp_mask, iterations=1)
