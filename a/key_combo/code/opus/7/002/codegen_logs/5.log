+        c += dc
+        if not _in_bounds(blocker_mask.shape, r, c):
+            return cells, "edge"
+        if blocker_mask[r, c]:
+            return cells, "halo"
+        if occupied[r, c]:
+            return cells, "occupied"
+        cells.append((r, c))
