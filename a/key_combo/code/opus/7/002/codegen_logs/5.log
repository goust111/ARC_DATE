+def _normalize_coords(cells: list[tuple[int, int]]) -> np.ndarray:
+    arr = np.asarray(cells, dtype=int)
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    return arr
