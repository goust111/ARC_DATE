+        assert not halo[r, c]
+
+    seed_infos = [_seed_candidate_info((r, c), halo, path_mask) for r, c, _ in seed_points]
+    assert all(info is not None for info in seed_infos)
+    chosen_infos = [info for info in seed_infos if info is not None]
