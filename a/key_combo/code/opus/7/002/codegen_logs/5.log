+        return None
+
+    seeds = _choose_seeds(path_masks)
+    if seeds is None:
+        return None
+
+    grid = np.zeros(shape, dtype=int)
+    for mask in path_masks:
+        grid[mask] = PATH_COLOR
+    for r, c, color in seeds:
+        if grid[r, c] != BG:
+            return None
+        grid[r, c] = color
