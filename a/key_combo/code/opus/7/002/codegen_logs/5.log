+def _trace_ray(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    blocker_mask: np.ndarray,
+    occupied: np.ndarray,
+) -> tuple[list[tuple[int, int]], str]:
+    dr, dc = direction
+    r, c = start
+    cells: list[tuple[int, int]] = []
+    while True:
+        r += dr
+        c += dc
+        if not _in_bounds(blocker_mask.shape, r, c):
+            return cells, "edge"
+        if blocker_mask[r, c]:
+            return cells, "halo"
+        if occupied[r, c]:
+            return cells, "occupied"
+        cells.append((r, c))
