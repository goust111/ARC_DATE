+def _dilate8(mask: np.ndarray, iterations: int = 1) -> np.ndarray:
+    out = mask.astype(bool).copy()
+    for _ in range(iterations):
+        nxt = out.copy()
+        for r, c in np.argwhere(out):
+            for dr in (-1, 0, 1):
