+    grid[r - 1 : r + TEMPLATE_SIZE + 1, c - 1] = int(color)
+    grid[r - 1 : r + TEMPLATE_SIZE + 1, c + TEMPLATE_SIZE] = int(color)
+    grid[r - 1, c - 1 : c + TEMPLATE_SIZE + 1] = int(color)
+    grid[r + TEMPLATE_SIZE, c - 1 : c + TEMPLATE_SIZE + 1] = int(color)
+
