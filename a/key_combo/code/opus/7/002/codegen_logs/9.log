        if r <= apex_col:
            out[r, apex_col - r] = Color.RED
            out[r, apex_col + r] = Color.RED

        for c in range(width):
            inside_v = abs(c - apex_col) < r
            below_v = r > apex_col
            on_blue_lattice = (c - r - apex_col) % DIAGONAL_PERIOD == 0
            if (inside_v or below_v) and on_blue_lattice:
