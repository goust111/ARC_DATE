+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+TEMPLATE_SIZE = 3
+STENCIL_SIZE = 4
+FRAME_PAD = 1
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
