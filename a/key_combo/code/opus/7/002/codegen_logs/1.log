+        q: deque[tuple[int, int]] = deque([(r0, c0)])
+        seen[r0, c0] = True
+        cells: list[tuple[int, int]] = []
+
+        while q:
+            rr, cc = q.popleft()
+            cells.append((rr, cc))
+            for dr, dc in NEIGHBORS4:
+                nr, nc = rr + dr, cc + dc
+                if not _in_bounds(g.shape, nr, nc) or seen[nr, nc]:
+                    continue
+                if int(g[nr, nc]) != color:
+                    continue
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+        coords = np.asarray(cells, dtype=int)
+        components.append(
