+            & (target[:, 0] < height)
+            & (0 <= target[:, 1])
+            & (target[:, 1] < width)
+        ]
+        if visible.size == 0:
+            continue
+        out[visible[:, 0], visible[:, 1]] = int(comp["color"])
+
+    return out
+
+
