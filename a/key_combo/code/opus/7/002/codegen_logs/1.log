+def _find_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    seen = np.zeros(g.shape, dtype=bool)
+    components: list[dict] = []
+
+    for r, c in np.argwhere(g != BLACK):
+        r0 = int(r)
+        c0 = int(c)
+        if seen[r0, c0]:
+            continue
