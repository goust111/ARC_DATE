+        seed_options = _seed_candidates_for_side(room, side)
+        if not seed_options or not pocket_cells:
+            continue
+        return {
+            "side": side,
+            "room_bbox": room,
+            "blockers": blockers,
+            "grey_seed": random.choice(seed_options),
+            "blue_seed": random.choice(pocket_cells),
+        }
+    return None
+
