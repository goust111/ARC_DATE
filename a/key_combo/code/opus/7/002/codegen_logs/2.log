+BLACK = 0
+BLUE = 1
+GREY = 5
+RECT_COLORS = (2, 3, 4, 6, 7, 8, 9)
+SIDE_PRIORITY = {"N": 0, "W": 1, "S": 2, "E": 3}
+OPPOSITE_SIDE = {"N": "S", "S": "N", "W": "E", "E": "W"}
+GEN_ATTEMPTS = 400
