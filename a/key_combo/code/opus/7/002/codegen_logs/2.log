+    for module in modules:
+        grid[module["grey_seed"]] = GREY
+        grid[module["blue_seed"]] = BLUE
+
+    if max(grid.shape) > 30:
+        return None
+    if int((grid == BLUE).sum()) != 2:
+        return None
+    if int((grid == GREY).sum()) != 2:
+        return None
+    if not _semantic_checks(grid, modules):
