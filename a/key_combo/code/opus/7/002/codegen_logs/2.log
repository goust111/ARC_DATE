+def _nearest_wall_side(bbox: tuple[int, int, int, int], seed: tuple[int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    sr, sc = seed
+    distances = {
+        "N": int(sr - r0),
+        "W": int(sc - c0),
+        "S": int(r1 - sr),
+        "E": int(c1 - sc),
+    }
+    return min(distances, key=lambda side: (distances[side], SIDE_PRIORITY[side]))
+
