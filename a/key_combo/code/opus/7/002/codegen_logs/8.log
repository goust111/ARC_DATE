   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """
  11:     Expand the centered red pixel into a square red V with a periodic blue diagonal fill.
  12: 
  13:     Input structure
  14:     - The input is a single odd-length row with black background.
  15:     - Exactly one foreground pixel is present, and it is red at the center column.
  16: 
  17:     Rule
  18:     - Create an N x N background canvas, where N is the input width.
  19:     - Draw red diagonals from the top-center marker down-left and down-right until they hit the side edges.
  20:     - Paint blue on the NW-SE diagonal lattice with the marker column's modulo-4 phase, clipped to the strict interior of the red V above the midpoint and unclipped below it.
  21: 
  22:     Key insight
  23:     - The lone red pixel is the apex of a triangular pattern; the blue cells are one repeated diagonal family inside and below that triangle.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     assert g.ndim == 2, "expected a 2D grid"
  27:     assert g.shape[0] == 1, "expected a single input row"
  28: 
  29:     bg = get_bg(g)
  30:     assert bg == Color.BLACK, "expected black background"
  31:     colors = colors_present(g, exclude={bg})
  32:     assert colors == [Color.RED], "expected exactly one red foreground color"
  33: 
  34:     width = g.shape[1]
  35:     assert width % 2 == 1, "expected odd input width"
  36:     apex_col = width // 2
  37:     marker_cols = np.flatnonzero(g[0] == Color.RED)
  38:     assert marker_cols.size == 1, "expected exactly one red marker"
  39:     assert int(marker_cols[0]) == apex_col, "expected red marker at center"
  40: 
  41:     out = np.full((width, width), bg, dtype=int)
  42:     for r in range(width):
  43:         if r <= apex_col:
  44:             out[r, apex_col - r] = Color.RED
  45:             out[r, apex_col + r] = Color.RED
  46: 
  47:         for c in range(width):
  48:             inside_v = abs(c - apex_col) < r
  49:             below_v = r > apex_col
  50:             on_blue_lattice = (c - r - apex_col) % DIAGONAL_PERIOD == 0
  51:             if (inside_v or below_v) and on_blue_lattice:
  52:                 out[r, c] = Color.BLUE
  53: 
  54:     return out
