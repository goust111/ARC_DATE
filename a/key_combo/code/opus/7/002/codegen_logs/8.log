import numpy as np

def diag_only(mask):
    coords = {(r,c) for r,c in np.argwhere(mask)}
    h,w = mask.shape
    cand=set()
    for r,c in coords:
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==0 and dc==0: continue
                rr,cc=r+dr,c+dc
                if 0<=rr<h and 0<=cc<w and (rr,cc) not in coords:
                    cand.add((rr,cc))
    ortho=set()
    for r,c in coords:
