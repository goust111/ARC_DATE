import numpy as np
from collections import defaultdict, deque

def anti(m):
    return np.fliplr(np.flipud(m)).T

def conn(mask):
    coords=np.argwhere(mask)
    if len(coords)==0: return False
    s={tuple(x) for x in coords}
    q=deque([tuple(coords[0])])
    seen={tuple(coords[0])}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nb=(r+dr,c+dc)
            if nb in s and nb not in seen:
                seen.add(nb); q.append(nb)
    return len(seen)==len(s)

def candidates(mask, kind, pad=2):
    h,w=mask.shape
    H,W=h+2*pad,w+2*pad
    arr=np.zeros((H,W),dtype=bool)
    arr[pad:pad+h,pad:pad+w]=mask
    coords={(r,c) for r,c in np.argwhere(arr)}
    cand=set(); ortho=set()
    for r,c in coords:
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==0 and dc==0: continue
                rr,cc=r+dr,c+dc
                if 0<=rr<H and 0<=cc<W and (rr,cc) not in coords:
                    cand.add((rr,cc))
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and (rr,cc) not in coords:
                ortho.add((rr,cc))
    cand-=ortho
    if kind=='H':
        dest={(r,c) for r in range(pad+h,pad+2*h) for c in range(pad,pad+w)}
    elif kind=='V':
        dest={(r,c) for r in range(pad,pad+h) for c in range(pad+w,pad+2*w)}
    else:
        dest={(r,c) for r in range(pad+h,pad+2*h) for c in range(pad+w,pad+2*w)}
    return [(r-pad,c-pad) for r,c in cand if (r,c) not in dest]

def trim(mask):
    rows=np.any(mask,axis=1); cols=np.any(mask,axis=0)
    return mask[rows][:,cols]

found=defaultdict(list)
for h,w in [(3,4),(4,3),(4,4),(3,3),(5,4),(4,5)]:
  for bits in range(1,1<<(h*w)):
    area=bits.bit_count()
    if area<4 or area>8: continue
    m=np.array([(bits>>i)&1 for i in range(h*w)],dtype=bool).reshape(h,w)
    if not m[0].any() or not m[-1].any() or not m[:,0].any() or not m[:,-1].any():
        continue
    if not conn(m): continue
    hsym=np.array_equal(m,np.flipud(m))
    vsym=np.array_equal(m,np.fliplr(m))
    dmsym=h==w and np.array_equal(m,m.T)
    dasym=h==w and np.array_equal(m,anti(m))
    cats=[hsym,vsym,dmsym or dasym]
    if sum(cats)"'!=1: continue
    kind='"'H' if hsym else 'V' if vsym else 'D'
    if len(candidates(m,kind))<4: continue
    # avoid duplicates up to transpose/flip? just keep trimmed unique string
    key='\\n'.join(''.join('1' if x else '0' for x in row) for row in m)
    found[kind].append((key,dmsym,dasym,m.copy()))
for kind in found:
    print('KIND',kind,'count',len(found[kind]))
    shown=0
    seen=set()
    for key,dmsym,dasym,m in found[kind]:
        if key in seen: continue
        seen.add(key)
        print(key,'dm',dmsym,'da',dasym,'cand',len(candidates(m,kind)))
        print(m.astype(int))
        shown+=1
        if shown>=8: break
    print()
