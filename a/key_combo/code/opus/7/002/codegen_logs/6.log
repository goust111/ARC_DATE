+
+def _line_capacity(shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int]) -> int:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    k = 0
+    while 0 <= r < h and 0 <= c < w:
+        k += 1
+        r += dr
+        c += dc
+    return k
