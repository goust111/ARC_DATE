+    r, c = coord
+    dr, dc = direction
+    return r + dr * times, c + dc * times
+
+
+def _turns(direction: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    dr, dc = direction
+    return (dc, -dr), (-dc, dr)
