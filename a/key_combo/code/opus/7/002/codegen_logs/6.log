+def _is_component_valid(shape: tuple[int, int], cells: list[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    cell_set = set(cells)
+    if len(cell_set) != len(cells):
+        return False
+    if not all(in_bounds(shape, r, c) for r, c in cells):
+        return False
+    if cell_set & occupied:
