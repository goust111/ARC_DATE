+    cell_set = set(cells)
+    if len(cell_set) != len(cells):
+        return False
+    if not all(in_bounds(shape, r, c) for r, c in cells):
+        return False
+    if cell_set & occupied:
+        return False
+    for r, c in cells:
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in occupied and (nr, nc) not in cell_set:
