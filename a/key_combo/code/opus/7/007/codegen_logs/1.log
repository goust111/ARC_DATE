+def _shape_variants(base_shapes: list[tuple[tuple[int, int], ...]]) -> list[tuple[tuple[int, int], ...]]:
+    variants: set[tuple[tuple[int, int], ...]] = set()
+    for shape in base_shapes:
+        s0 = _normalize_shape(shape)
+        s1 = _flip_h(s0)
+        s2 = _flip_v(s0)
+        s3 = _flip_h(s2)
+        variants.update((s0, s1, s2, s3))
