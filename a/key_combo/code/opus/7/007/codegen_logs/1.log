+def _validate_scene(grid: np.ndarray) -> bool:
+    if not isinstance(grid, np.ndarray) or grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    if int(grid.min()) < 0 or int(grid.max()) > 9:
+        return False
