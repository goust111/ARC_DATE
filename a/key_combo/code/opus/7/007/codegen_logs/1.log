+BG = 0
+NEUTRAL = 5
+PALETTE = (1, 2, 3, 4)
+ZONE_H = 9
+ZONE_W = 7
+GRAY_ORIGIN_R = 3
+GRAY_ORIGIN_C = 2
+MAX_GENERATION_ATTEMPTS = 800
