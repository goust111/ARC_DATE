+def _matches_mode(before: bool, after: bool, mode: str) -> bool:
+    if mode == "gain":
+        return (not before) and after
+    if mode == "lose":
+        return before and (not after)
+    if mode == "stable":
+        return before and after
+    raise ValueError(mode)
