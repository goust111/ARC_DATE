+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _normalize_shape(shape: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    arr = np.array(shape, dtype=int)
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    pts = sorted((int(r), int(c)) for r, c in arr)
+    return tuple(pts)
+
