+def _damage_left(mask: np.ndarray, rooms: int) -> np.ndarray:
+    side = mask.shape[0]
+    wall_cells = [tuple(map(int, coord)) for coord in np.argwhere(mask)]
+    openers = _critical_break_candidates(mask)
+    assert openers
+
+    for _ in range(80):
