+    for patch in sprites:
+        box = np.full(patch.shape, 9, dtype=int)
+        sr0, sc0 = random_free_location(occupied, box, transparent=0, border=1, padding=1)
+        paste(occupied, box, sr0, sc0, transparent=0)
