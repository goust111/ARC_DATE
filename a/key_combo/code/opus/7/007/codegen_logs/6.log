+
+
+def _choose_pair_count() -> int:
+    return random.choices([2, 3, 4], weights=[2, 3, 5], k=1)[0]
+
+
+def _sample_inners(side: int, count: int) -> list[np.ndarray] | None:
+    for _ in range(100):
