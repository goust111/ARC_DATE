        colors_set = None
        colors_iter = sorted(set(map(int, grid.flatten())) - {bg})
    else:
        colors_set = {int(c) for c in colors}
        colors_iter = [int(c) for c in colors_set if int(c) != bg]

    # Monochromatic = label per-color
    if monochromatic:
        if return_format == "dict":
