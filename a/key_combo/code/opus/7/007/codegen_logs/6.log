    if distractor_count:
        candidates = _gen_distractor_candidates(height, width, occupied, component_sets)
        if not candidates:
            return None
        r, c = _gen_choice(candidates)
        input_grid[r, c] = marker_colors[-1]
        occupied.add((r, c))
        marker_positions.append((r, c))
