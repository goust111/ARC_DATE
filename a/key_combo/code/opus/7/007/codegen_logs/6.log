+
+
+def _sprite_component(grid: np.ndarray, marker: tuple[int, int], color: int) -> dict:
+    h, w = grid.shape
+    mr, mc = marker
+    allowed = {BODY, color}
+    q = deque([(mr, mc)])
+    seen = {(mr, mc)}
+    cells: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        cells.append((r, c))
+        for nr, nc in _neighbors(r, c, 8):
