    reserved_rays: set[tuple[int, int]] = set()
    placements: list[tuple[int, int, int, tuple[int, int]]] = []

    for marker_color, direction in zip(marker_colors, directions):
        center = _choose_center(H, W, direction, occupied, reserved_rays)
        if center is None:
