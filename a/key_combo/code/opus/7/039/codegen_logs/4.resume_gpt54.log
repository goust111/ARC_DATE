+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+TEMPLATE_COLORS = (BLUE, RED)
+TEMPLATE_SIZE_OPTIONS = (3, 5)
+GRID_SIZE_MIN = 18
+GRID_SIZE_MAX = 24
+COMPLETE_COUNT_OPTIONS = (2, 3)
+PARTIAL_COUNT_OPTIONS = (3, 4)
+PLACEMENT_GAP = 2
+GEN_ATTEMPTS = 400
+MASK_ATTEMPTS = 800
