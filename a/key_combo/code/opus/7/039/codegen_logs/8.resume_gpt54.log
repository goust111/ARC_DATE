+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    bg = _get_bg(g)
+    ref_rows = _reference_rows(g, bg)
+    reference = _extract_reference_sequence(g, ref_rows, bg)
+    cutoff_row = ref_rows[-1]
