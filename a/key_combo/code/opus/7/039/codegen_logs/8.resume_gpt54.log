+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        pair = _attempt_generate()
+        if pair is None:
+            continue
+        inp, expected = pair
+        try:
+            actual = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid puzzle instance")

