+            for d in range(length):
+                cells.add((base_h + d, c0))
+
+    min_r = min(r for r, _c in cells)
+    min_c = min(c for _r, c in cells)
+    normalized = {(r - min_r, c - min_c) for r, c in cells}
+    h = max(r for r, _c in normalized) + 1
