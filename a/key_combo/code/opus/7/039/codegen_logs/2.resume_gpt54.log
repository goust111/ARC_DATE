+def _pick_pattern(height: int, category: str) -> dict[str, object] | None:
+    catalog = list(_pattern_catalog(int(height)))
+    if category == "deep":
+        options = [rec for rec in catalog if int(rec["levels"]) >= 2]
+    elif category == "clip":
