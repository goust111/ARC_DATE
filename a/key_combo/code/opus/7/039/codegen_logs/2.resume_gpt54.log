            extra_rows = rows - 1 - last_gen_row
            if EXTRA_ROWS_BELOW_LAST_GEN_BOUNDS[0] <= extra_rows <= EXTRA_ROWS_BELOW_LAST_GEN_BOUNDS[1]:
