+        dist = target_row - tip_row
+        left_bound = tip_col - dist
+        right_bound = tip_col + dist
+        children = tuple(c for c in raw_children if left_bound <= c <= right_bound)
+        if not children:
+            break
+
+        for col in children:
+            if out[target_row, col] == BLACK:
+                out[target_row, col] = color
