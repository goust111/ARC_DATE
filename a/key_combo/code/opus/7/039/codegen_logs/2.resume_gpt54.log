+def _simulate_local_growth(seed_cols: tuple[int, ...], height: int) -> dict[str, object]:
+    active_cols = tuple(int(c) for c in seed_cols)
+    current_dist = int(height)
+    generations: list[tuple[int, tuple[int, ...]]] = []
+    clipped = False
