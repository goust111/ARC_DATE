+def _grow_wedge(out: np.ndarray, wedge: dict[str, object]) -> None:
+    tip_row = int(wedge["tip_row"])
+    tip_col = int(wedge["tip_col"])
+    current_row = int(wedge["base_row"])
+    active_cols = tuple(int(c) for c in wedge["seed_cols"])
+    color = PINK
