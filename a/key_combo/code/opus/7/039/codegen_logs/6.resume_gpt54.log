+                        if _in_bounds((h, w), sr, sc) and int(out[sr, sc]) == BG:
+                            out[sr, sc] = state.color
+                            arm_painted = True
+                            if state.color == BLUE:
+                                metrics["blue_new"] += 1
+                            else:
