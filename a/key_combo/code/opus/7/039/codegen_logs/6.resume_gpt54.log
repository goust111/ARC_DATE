+                                continue
+                            if int(g[orow, ocol]) != BG:
+                                continue
+                            key = (orow, ocol, dir_idx, leg_len, GREEN)
+                            if key in spawn_keys:
+                                continue
+                            spawn_keys.add(key)
+                            queue.append(_SpiralState(orow, ocol, dir_idx, leg_len, GREEN, False, "child"))
+                            metrics["child_count"] += 1
