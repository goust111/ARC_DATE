+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+MAX_GENERATION_ATTEMPTS = 400
