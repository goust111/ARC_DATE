+                r, c = nr, nc
+
+            if terminated:
+                break
+            if not arm_painted:
+                break
+
+            dir_idx = (dir_idx + 1) % 4
+            pair_phase ^= 1
+            if pair_phase == 0:
+                leg_len += 2
+            arm_index += 1
+
+            if arm_index > 2 * (h + w + 6):
+                break
+
+    if collect_metrics:
+        return out, metrics
+    return out
