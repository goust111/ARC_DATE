+                if not _in_bounds((h, w), nr, nc):
+                    r, c = nr, nc
+                    continue
+
+                cell = int(out[nr, nc])
+                if cell == RED:
+                    metrics["red_hits"] += 1
+                    terminated = True
+                    break
+
+                if cell == GREY:
+                    segment_cells, _axis, openings = _wall_segment(g, nr, nc)
+                    for wr, wc in segment_cells:
