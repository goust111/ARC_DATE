+        top = r0 + (tile_h - stamp.shape[0]) // 2
+        left = c0 + (tile_w - stamp.shape[1]) // 2
+        out[top : top + stamp.shape[0], left : left + stamp.shape[1]] = stamp
+
+    return out
+
+
+def _segment_nodes(segment: tuple[str, int, int], tile_size: int) -> list[tuple[int, int]]:
+    kind, a, b = segment
