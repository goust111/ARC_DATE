+def _render_case() -> tuple[np.ndarray, np.ndarray] | None:
+    tile_size = random.choice(TILE_SIZE_CHOICES)
+    side = TILE_COUNT * tile_size + (TILE_COUNT - 1)
+    grid = np.full((side, side), BG, dtype=int)
