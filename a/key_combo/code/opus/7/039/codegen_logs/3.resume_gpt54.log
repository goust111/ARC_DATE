74: def main(grid: np.ndarray) -> np.ndarray:
75:     """
76:     Return the ring object reached by following the guide path from the checkerboard object.
77: 
78:     Input structure
79:     - The input has one dominant background color, one 3x3 checkerboard object,
80:       several 3x3 ring objects, and sparse guide pixels on a two-cell lattice.
81: 
82:     Rule
83:     - Find the checkerboard object and its unique adjacent guide pixel.
84:     - Follow guide pixels of that color through two-cell horizontal/vertical steps.
85:     - Output the unique 3x3 ring object adjacent to that connected guide path.
86: 
87:     Key insight
88:     - The checkerboard object is the source, and the color of its attached guide
89:       pixel selects the path whose far endpoint points at the answer ring.
90:     """
91:     g = np.asarray(grid, dtype=int)
92:     bg = get_bg(g)
93: 
94:     rings = _ring_windows(g, bg)
95:     assert rings, "expected at least one 3x3 ring object"
96:     checkers = _checker_windows(g, bg)
97:     assert len(checkers) == 1, "expected exactly one checkerboard source object"
98: 
99:     object_mask = _mark_objects(g.shape, rings + checkers)
100:     src_r, src_c = checkers[0]
101: 
102:     connectors: list[tuple[int, int, int]] = []
103:     for rr, cc in _adjacent_sites(src_r, src_c):
104:         if not in_bounds(g.shape, rr, cc):
105:             continue
106:         if object_mask[rr, cc] or int(g[rr, cc]) == bg:
107:             continue
108:         connectors.append((rr, cc, int(g[rr, cc])))
109:     assert len(connectors) == 1, "checkerboard source must have one adjacent guide pixel"
110: 
111:     start_r, start_c, path_color = connectors[0]
112:     guide_nodes = {
113:         (int(r), int(c))
114:         for r, c in np.argwhere((g == path_color) & ~object_mask)
115:     }
116:     assert (start_r, start_c) in guide_nodes
117: 
118:     seen = {(start_r, start_c)}
119:     queue = deque([(start_r, start_c)])
120:     while queue:
121:         r, c = queue.popleft()
122:         for dr, dc in ((-2, 0), (2, 0), (0, -2), (0, 2)):
123:             neighbor = (r + dr, c + dc)
124:             if neighbor in guide_nodes and neighbor not in seen:
125:                 seen.add(neighbor)
126:                 queue.append(neighbor)
127: 
128:     targets = [
129:         (r, c)
130:         for r, c in rings
131:         if any(site in seen for site in _adjacent_sites(r, c))
132:     ]
133:     assert len(targets) == 1, "guide path must point at exactly one ring object"
134: 
135:     dst_r, dst_c = targets[0]
136:     return g[dst_r : dst_r + 3, dst_c : dst_c + 3].copy()
