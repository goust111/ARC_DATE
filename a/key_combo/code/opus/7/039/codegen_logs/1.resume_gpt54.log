+    if shelf1 is None:
+        return None
+    left_anchor, right_anchor = _terminal_anchors_from_shelf(*shelf1)
+    direct_leaf = _place_leaf_top_frame(grid, occ, left_anchor[0], left_anchor[1])
+    if direct_leaf is None:
+        return None
+
+    shelf2 = _place_specific_shelf(
+        grid,
