+                return frame
+    return None
+
+
+def _validate_generated(grid: np.ndarray, frames: list[dict]) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    if out.shape != grid.shape:
+        return False
+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        if interior.size == 0:
+            return False
+        colors = set(map(int, np.unique(interior)))
+        if len(colors) != 1:
+            return False
+        color = next(iter(colors))
+        if idx == 0 and color != RED:
+            return False
+        if idx > 0 and color != BLUE:
+            return False
+    return bool((out == BLUE).any()) and bool((out == RED).any())
+
+
+def _place_leaf_top_frame(grid: np.ndarray, occ: np.ndarray, anchor_r: int, anchor_c: int) -> dict | None:
+    for _ in range(120):
+        oh = random.randint(4, 6)
