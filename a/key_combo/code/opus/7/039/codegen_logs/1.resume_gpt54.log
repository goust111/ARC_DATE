+            frame = _place_frame_from_gap(
+                grid,
+                occ,
+                gap_side=gap_side,
+                gap_r=int(gap_r),
+                gap_c=int(gap_c),
+                oh=int(oh),
+                ow=int(ow),
+                fill_red=False,
+            )
