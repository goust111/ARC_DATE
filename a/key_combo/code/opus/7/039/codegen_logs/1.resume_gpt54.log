+    left = _place_branch_frame(grid, occ, left_anchor[0], left_anchor[1], "left", internal=False)
+    right = _place_branch_frame(grid, occ, right_anchor[0], right_anchor[1], "right", internal=False)
+    if left is None or right is None:
+        return None
+    return [top, left, right]
+
+
+def _gen_down_split_chain(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    h, w = grid.shape
+    top = None
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        c0 = random.randint(5, w - ow - 6)
+        gap_c = c0 + random.randint(1, ow - 2)
+        gap_r = r0 + oh - 1
+        top = _place_frame_from_gap(grid, occ, "bottom", gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    if top is None:
+        return None
+
+    shelf = _place_split_shelf(grid, occ, top["gap"][0], top["gap"][1], top["bbox"][2] + 3, top["bbox"][2] + 7)
+    if shelf is None:
+        return None
+    shelf_row, a, b = shelf
+    left_anchor = (shelf_row - 1, a - 1)
+    right_anchor = (shelf_row - 1, b + 1)
+    chain_side = random.choice(["left", "right"])
+
+    if chain_side == "left":
+        internal = _place_branch_frame(grid, occ, left_anchor[0], left_anchor[1], "left", internal=True)
+        leaf = _place_branch_frame(grid, occ, right_anchor[0], right_anchor[1], "right", internal=False)
+    else:
+        internal = _place_branch_frame(grid, occ, right_anchor[0], right_anchor[1], "right", internal=True)
+        leaf = _place_branch_frame(grid, occ, left_anchor[0], left_anchor[1], "left", internal=False)
+    if internal is None or leaf is None:
+        return None
+
+    anchor_r, anchor_c = _outgoing_anchor(internal, grid.shape)
+    shelf2 = _place_edge_shelf(
+        grid,
+        occ,
+        anchor_r,
+        anchor_c,
+        chain_side,
+        internal["bbox"][2] + 3,
+        internal["bbox"][2] + 8,
+    )
+    if shelf2 is None:
+        return None
+    row2, a2, b2 = shelf2
+    if chain_side == "left":
+        grand_anchor = (row2 - 1, b2 + 1)
+        grand = _place_branch_frame(grid, occ, grand_anchor[0], grand_anchor[1], "left", internal=False)
+    else:
+        grand_anchor = (row2 - 1, a2 - 1)
+        grand = _place_branch_frame(grid, occ, grand_anchor[0], grand_anchor[1], "right", internal=False)
+    if grand is None:
+        return None
+    return [top, internal, leaf, grand]
+
+
+def _gen_down_split_double_chain(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    top = None
+    w = grid.shape[1]
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        c0 = random.randint(5, w - ow - 6)
+        gap_c = c0 + random.randint(1, ow - 2)
+        gap_r = r0 + oh - 1
+        top = _place_frame_from_gap(grid, occ, "bottom", gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    if top is None:
+        return None
+
+    shelf = _place_split_shelf(grid, occ, top["gap"][0], top["gap"][1], top["bbox"][2] + 3, top["bbox"][2] + 7)
+    if shelf is None:
+        return None
+    shelf_row, a, b = shelf
+    left_anchor = (shelf_row - 1, a - 1)
+    right_anchor = (shelf_row - 1, b + 1)
+
+    left = _place_branch_frame(grid, occ, left_anchor[0], left_anchor[1], "left", internal=True)
+    right = _place_branch_frame(grid, occ, right_anchor[0], right_anchor[1], "right", internal=True)
+    if left is None or right is None:
+        return None
+
+    left_out = _outgoing_anchor(left, grid.shape)
+    right_out = _outgoing_anchor(right, grid.shape)
+    left_shelf = _place_edge_shelf(grid, occ, left_out[0], left_out[1], "left", left["bbox"][2] + 3, left["bbox"][2] + 8)
+    right_shelf = _place_edge_shelf(grid, occ, right_out[0], right_out[1], "right", right["bbox"][2] + 3, right["bbox"][2] + 8)
+    if left_shelf is None or right_shelf is None:
+        return None
+
+    left_grand_anchor = (left_shelf[0] - 1, left_shelf[2] + 1)
+    right_grand_anchor = (right_shelf[0] - 1, right_shelf[1] - 1)
+    left_grand = _place_branch_frame(grid, occ, left_grand_anchor[0], left_grand_anchor[1], "left", internal=False)
+    right_grand = _place_branch_frame(grid, occ, right_grand_anchor[0], right_grand_anchor[1], "right", internal=False)
+    if left_grand is None or right_grand is None:
+        return None
+    return [top, left, right, left_grand, right_grand]
+
+
+def _gen_edge_chain3(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    h, w = grid.shape
+    side = random.choice(["left", "right"])
+    top = None
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        if side == "left":
+            c0 = random.randint(4, w - ow - 6)
+            gap_c = c0
+        else:
+            c0 = random.randint(6, w - ow - 4)
+            gap_c = c0 + ow - 1
+        gap_r = r0 + random.randint(1, oh - 2)
+        top = _place_frame_from_gap(grid, occ, side, gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    if top is None:
+        return None
+
+    anchor_r, anchor_c = _outgoing_anchor(top, grid.shape)
+    shelf = _place_edge_shelf(grid, occ, anchor_r, anchor_c, side, top["bbox"][2] + 3, top["bbox"][2] + 7)
+    if shelf is None:
+        return None
+    row, a, b = shelf
+    if side == "left":
+        child_anchor = (row - 1, b + 1)
+        child = _place_branch_frame(grid, occ, child_anchor[0], child_anchor[1], "left", internal=True)
+    else:
+        child_anchor = (row - 1, a - 1)
+        child = _place_branch_frame(grid, occ, child_anchor[0], child_anchor[1], "right", internal=True)
+    if child is None:
+        return None
+
+    child_out = _outgoing_anchor(child, grid.shape)
+    shelf2 = _place_edge_shelf(grid, occ, child_out[0], child_out[1], side, child["bbox"][2] + 3, child["bbox"][2] + 8)
+    if shelf2 is None:
+        return None
+    if side == "left":
+        leaf_anchor = (shelf2[0] - 1, shelf2[2] + 1)
+        leaf = _place_branch_frame(grid, occ, leaf_anchor[0], leaf_anchor[1], "left", internal=False)
+    else:
+        leaf_anchor = (shelf2[0] - 1, shelf2[1] - 1)
+        leaf = _place_branch_frame(grid, occ, leaf_anchor[0], leaf_anchor[1], "right", internal=False)
+    if leaf is None:
+        return None
+    return [top, child, leaf]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(22, 29)
+    w = random.randint(20, 29)
+    grid = np.full((h, w), BG, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+
+    patterns = [
+        _gen_down_split2,
+        _gen_down_split_chain,
+        _gen_down_split_double_chain,
+        _gen_edge_chain3,
+    ]
+    weights = [3, 3, 2, 2]
+    builder = random.choices(patterns, weights=weights, k=1)[0]
+    frames = builder(grid, occ)
+    if frames is None:
+        return None
+    if not _validate_generated(grid, frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid cascading-gap input")

diff --git a/039/1.py b/039/1.py
new file mode 100644
index 0000000000000000000000000000000000000000..5e707f90157c9d50089a49aa990c074a235068ca
--- /dev/null
+++ b/039/1.py
@@ -0,0 +1,701 @@
+from __future__ import annotations
+
+from collections import deque
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+
+
+_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_UTILS_DIR))
+
+from arc_utils import Color, find_components, get_bg  # noqa: E402
+
+
+BG = Color.BLACK
+BLUE = Color.BLUE
+RED = Color.RED
+FRAME = Color.GREY
+SHELF = Color.ORANGE
+
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _toggle(color: int) -> int:
+    return BLUE if int(color) == RED else RED
+
+
+def _paint_if_blank(out: np.ndarray, r: int, c: int, color: int) -> None:
+    if int(out[r, c]) == BG:
+        out[r, c] = int(color)
+
+
+def _border_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    return {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    frames = find_components(
+        grid,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        colors=[FRAME],
+        return_format="dict",
+    )
+    out = []
+    for comp in frames:
+        r0, c0, r1, c1 = comp["bbox"]
+        oh = int(r1 - r0 + 1)
+        ow = int(c1 - c0 + 1)
+        assert 4 <= oh <= 6 and 4 <= ow <= 6, "expected 1-cell rectangular frames with 2..4 interiors"
+
+        coords = {tuple(map(int, rc)) for rc in comp["coords"]}
+        border = _border_cells(r0, c0, r1, c1)
+        gaps = sorted(border - coords)
+        assert len(gaps) == 1, "each frame must have exactly one missing border pixel"
+        gap_r, gap_c = gaps[0]
+
+        if gap_r == r0:
+            assert c0 < gap_c < c1
+            side = "top"
+        elif gap_r == r1:
+            assert c0 < gap_c < c1
+            side = "bottom"
+        elif gap_c == c0:
+            assert r0 < gap_r < r1
+            side = "left"
+        else:
+            assert gap_c == c1 and r0 < gap_r < r1
+            side = "right"
+
+        out.append(
+            {
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "gap": (int(gap_r), int(gap_c)),
+                "side": side,
+                "dir": DIRS[side],
+            }
+        )
+    out.sort(key=lambda frame: (frame["bbox"][0], frame["bbox"][1]))
+    for idx, frame in enumerate(out):
+        frame["id"] = idx
+    return out
+
+
+def _shelf_segments(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    rows: list[list[tuple[int, int]]] = [[] for _ in range(h)]
+    for r in range(h):
+        c = 0
+        while c < w:
+            if int(grid[r, c]) != SHELF:
+                c += 1
+                continue
+            c0 = c
+            while c + 1 < w and int(grid[r, c + 1]) == SHELF:
+                c += 1
+            rows[r].append((int(c0), int(c)))
+            c += 1
+    return rows
+
+
+def _segment_covering(segments: list[tuple[int, int]], col: int) -> tuple[int, int] | None:
+    for a, b in segments:
+        if int(a) <= int(col) <= int(b):
+            return (int(a), int(b))
+    return None
+
+
+def _fill_frame_interior(out: np.ndarray, frame: dict, color: int) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    out[r0 + 1 : r1, c0 + 1 : c1] = int(color)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Simulate a colored fill spilling out of one-gap frames, falling under gravity, and cascading across shelves.
+
+    Input structure:
+    - The grid is a black background with several grey rectangular border frames and orange horizontal shelves.
+    - Every frame is a 1-cell-thick rectangle with exactly one non-corner border pixel missing as a gap.
+    - Exactly one top frame has its whole interior pre-filled red; other frames have empty interiors.
+
+    Rule:
+    - Preserve every grey frame border and every orange shelf cell.
+    - Start from the pre-filled top frame with red as the current fill color.
+    - When a frame activates, fill its interior, paint its gap, extend a straight ray outward through the gap until the next step would hit structure or leave the grid, then switch to vertical gravity.
+    - A falling branch paints background cells while descending, spreads across the full row directly above any shelf it lands on, then restarts downward from one cell beyond each shelf end.
+    - If a falling branch reaches another frame's gap, toggle the fill color between red and blue, fill that frame, and continue from its own gap; earlier branches keep ownership of any shared background pixels.
+
+    Key insight:
+    - Each gap only chooses the ray's launch direction; after that the process is a gravity-driven cascade whose shelves branch the flow and whose newly entered frames alternate the active color.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    frames = _extract_frames(g)
+    assert 3 <= len(frames) <= 5, "expected 3..5 frames"
+
+    start_ids = []
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
+        if interior.size > 0 and np.all(interior == RED):
+            start_ids.append(int(frame["id"]))
+        else:
+            assert np.all(interior == BG), "non-start frames must have empty interiors"
+    assert len(start_ids) == 1, "expected exactly one pre-filled source frame"
+
+    shelves = _shelf_segments(g)
+    gap_to_frame = {tuple(frame["gap"]): int(frame["id"]) for frame in frames}
+
+    out = g.copy()
+    activated: set[int] = set()
+    seen_falls: set[tuple[int, int, int, int]] = set()
+    queue = deque([("frame", start_ids[0], RED)])
+
+    def enqueue_fall(r: int, c: int, color: int, include_start: bool) -> None:
+        if 0 <= int(r) < g.shape[0] and 0 <= int(c) < g.shape[1]:
+            queue.append(("fall", int(r), int(c), int(color), int(include_start)))
+
+    while queue:
+        item = queue.popleft()
+        kind = item[0]
+
+        if kind == "frame":
+            _, frame_id, color = item
+            if int(frame_id) in activated:
+                continue
+            frame = frames[int(frame_id)]
+            activated.add(int(frame_id))
+            _fill_frame_interior(out, frame, int(color))
+
+            r, c = map(int, frame["gap"])
+            dr, dc = frame["dir"]
+            out[r, c] = int(color)
+            end_r, end_c = r, c
+            while True:
+                nr = int(end_r + dr)
+                nc = int(end_c + dc)
+                if not (0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]):
+                    break
+                if int(g[nr, nc]) != BG:
+                    break
+                end_r, end_c = nr, nc
+                _paint_if_blank(out, end_r, end_c, int(color))
+            enqueue_fall(end_r, end_c, int(color), False)
+            continue
+
+        _, cur_r, cur_c, color, include_start_int = item
+        state = (int(cur_r), int(cur_c), int(color), int(include_start_int))
+        if state in seen_falls:
+            continue
+        seen_falls.add(state)
+
+        if include_start_int:
+            if int(g[cur_r, cur_c]) == BG:
+                _paint_if_blank(out, int(cur_r), int(cur_c), int(color))
+
+        r = int(cur_r)
+        c = int(cur_c)
+        while True:
+            nr = int(r + 1)
+            if nr >= g.shape[0]:
+                break
+
+            if (nr, c) in gap_to_frame:
+                target = int(gap_to_frame[(nr, c)])
+                if target not in activated:
+                    queue.append(("frame", target, _toggle(int(color))))
+                break
+
+            below = int(g[nr, c])
+            if below == BG:
+                r = nr
+                _paint_if_blank(out, r, c, int(color))
+                continue
+
+            if below == SHELF:
+                seg = _segment_covering(shelves[nr], c)
+                if seg is None:
+                    break
+                a, b = seg
+                for x in range(a, b + 1):
+                    if int(g[r, x]) == BG:
+                        _paint_if_blank(out, r, x, int(color))
+                enqueue_fall(r, a - 1, int(color), True)
+                enqueue_fall(r, b + 1, int(color), True)
+                break
+
+            break
+
+    return out
+
+
+def _expanded_bbox(r0: int, c0: int, r1: int, c1: int, h: int, w: int, pad: int = 1) -> tuple[int, int, int, int]:
+    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
+
+
+def _bbox_is_free(occ: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:
+    rr0, cc0, rr1, cc1 = _expanded_bbox(r0, c0, r1, c1, occ.shape[0], occ.shape[1], pad)
+    return not bool(occ[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
+
+
+def _reserve_bbox(occ: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    rr0, cc0, rr1, cc1 = _expanded_bbox(r0, c0, r1, c1, occ.shape[0], occ.shape[1], pad)
+    occ[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _draw_frame(grid: np.ndarray, occ: np.ndarray, frame: dict, fill_red: bool) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    gap = tuple(frame["gap"])
+    for r, c in _border_cells(r0, c0, r1, c1):
+        if (r, c) != gap:
+            grid[r, c] = FRAME
+    if fill_red:
+        grid[r0 + 1 : r1, c0 + 1 : c1] = RED
+    _reserve_bbox(occ, r0, c0, r1, c1, pad=1)
+
+
+def _draw_shelf(grid: np.ndarray, occ: np.ndarray, row: int, a: int, b: int) -> None:
+    grid[row, a : b + 1] = SHELF
+    _reserve_bbox(occ, row, a, row, b, pad=1)
+
+
+def _line_is_clear(grid: np.ndarray, fixed: int, start: int, end: int, axis: str) -> bool:
+    if start > end:
+        return True
+    if axis == "col":
+        return bool(np.all(grid[start : end + 1, fixed] == BG))
+    return bool(np.all(grid[fixed, start : end + 1] == BG))
+
+
+def _place_frame_from_gap(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    gap_side: str,
+    gap_r: int,
+    gap_c: int,
+    oh: int,
+    ow: int,
+    fill_red: bool,
+) -> dict | None:
+    if gap_side == "top":
+        offset = random.randint(1, ow - 2)
+        r0 = gap_r
+        c0 = gap_c - offset
+    elif gap_side == "bottom":
+        offset = random.randint(1, ow - 2)
+        r0 = gap_r - oh + 1
+        c0 = gap_c - offset
+    elif gap_side == "left":
+        offset = random.randint(1, oh - 2)
+        r0 = gap_r - offset
+        c0 = gap_c
+    else:
+        assert gap_side == "right"
+        offset = random.randint(1, oh - 2)
+        r0 = gap_r - offset
+        c0 = gap_c - ow + 1
+
+    r1 = r0 + oh - 1
+    c1 = c0 + ow - 1
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+        return None
+    if not _bbox_is_free(occ, r0, c0, r1, c1, pad=1):
+        return None
+
+    frame = {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "gap": (int(gap_r), int(gap_c)),
+        "side": gap_side,
+    }
+    _draw_frame(grid, occ, frame, fill_red=fill_red)
+    return frame
+
+
+def _outgoing_anchor(frame: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    gap_r, gap_c = map(int, frame["gap"])
+    side = frame["side"]
+    h, w = shape
+    if side == "left":
+        return gap_r, 0
+    if side == "right":
+        return gap_r, w - 1
+    if side == "top":
+        return 0, gap_c
+    assert side == "bottom"
+    return gap_r, gap_c
+
+
+def _place_split_shelf(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    row_lo: int,
+    row_hi: int,
+) -> tuple[int, int, int] | None:
+    row_lo = max(int(anchor_r) + 3, int(row_lo))
+    row_hi = min(int(row_hi), grid.shape[0] - 4)
+    if row_lo > row_hi:
+        return None
+    for _ in range(60):
+        row = random.randint(row_lo, row_hi)
+        if not _line_is_clear(grid, anchor_c, anchor_r + 1, row - 1, "col"):
+            continue
+        length = random.randint(3, 6)
+        left_max = min(anchor_c, grid.shape[1] - length - 2)
+        left_min = max(2, anchor_c - length + 1)
+        if left_min > left_max:
+            continue
+        a = random.randint(left_min, left_max)
+        b = a + length - 1
+        if not (a <= anchor_c <= b):
+            continue
+        if a - 1 < 0 or b + 1 >= grid.shape[1]:
+            continue
+        if not _bbox_is_free(occ, row, a, row, b, pad=1):
+            continue
+        _draw_shelf(grid, occ, row, a, b)
+        return (int(row), int(a), int(b))
+    return None
+
+
+def _place_edge_shelf(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    side: str,
+    row_lo: int,
+    row_hi: int,
+) -> tuple[int, int, int] | None:
+    row_lo = max(int(anchor_r) + 3, int(row_lo))
+    row_hi = min(int(row_hi), grid.shape[0] - 4)
+    if row_lo > row_hi:
+        return None
+    assert side in {"left", "right"}
+    for _ in range(60):
+        row = random.randint(row_lo, row_hi)
+        if not _line_is_clear(grid, anchor_c, anchor_r + 1, row - 1, "col"):
+            continue
+        length = random.randint(3, 6)
+        if side == "left":
+            a, b = 0, length - 1
+        else:
+            a, b = grid.shape[1] - length, grid.shape[1] - 1
+        if not _bbox_is_free(occ, row, a, row, b, pad=1):
+            continue
+        _draw_shelf(grid, occ, row, a, b)
+        return (int(row), int(a), int(b))
+    return None
+
+
+def _place_branch_frame(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    preferred_side: str,
+    internal: bool,
+) -> dict | None:
+    options = [preferred_side] if internal else [preferred_side, "top"]
+    random.shuffle(options)
+    for gap_side in options:
+        for _ in range(80):
+            oh = random.randint(4, 6)
+            ow = random.randint(4, 6)
+            if gap_side == "top":
+                lo = anchor_r + 3
+                hi = grid.shape[0] - oh - 2
+                if lo > hi:
+                    continue
+                gap_r = random.randint(lo, hi)
+                gap_c = anchor_c
+                if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+                    continue
+                if not _line_is_clear(grid, gap_c, 0, gap_r - 1, "col"):
+                    continue
+            elif gap_side == "left":
+                lo = anchor_r + 3
+                hi = grid.shape[0] - 3
+                if lo > hi:
+                    continue
+                gap_r = random.randint(lo, hi)
+                gap_c = anchor_c
+                if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+                    continue
+                if not _line_is_clear(grid, gap_r, 0, gap_c - 1, "row"):
+                    continue
+            else:
+                assert gap_side == "right"
+                lo = anchor_r + 3
+                hi = grid.shape[0] - 3
+                if lo > hi:
+                    continue
+                gap_r = random.randint(lo, hi)
+                gap_c = anchor_c
+                if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+                    continue
+                if not _line_is_clear(grid, gap_r, gap_c + 1, grid.shape[1] - 1, "row"):
+                    continue
+            frame = _place_frame_from_gap(
+                grid,
+                occ,
+                gap_side=gap_side,
+                gap_r=int(gap_r),
+                gap_c=int(gap_c),
+                oh=int(oh),
+                ow=int(ow),
+                fill_red=False,
+            )
+            if frame is not None:
+                return frame
+    return None
+
+
+def _validate_generated(grid: np.ndarray, frames: list[dict]) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    if out.shape != grid.shape:
+        return False
+    seen_blue = False
+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        if interior.size == 0:
+            return False
+        colors = set(map(int, np.unique(interior)))
+        if len(colors) != 1 or colors.pop() not in {BLUE, RED}:
+            return False
+        if idx > 0 and BLUE in set(map(int, np.unique(interior))):
+            seen_blue = True
+    return bool((out == BLUE).any()) and bool((out == RED).any()) and seen_blue
+
+
+def _gen_down_split2(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    h, w = grid.shape
+    top = None
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        c0 = random.randint(5, w - ow - 6)
+        gap_c = c0 + random.randint(1, ow - 2)
+        gap_r = r0 + oh - 1
+        top = _place_frame_from_gap(grid, occ, "bottom", gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    if top is None:
+        return None
+
+    shelf = _place_split_shelf(grid, occ, top["gap"][0], top["gap"][1], top["bbox"][2] + 3, top["bbox"][2] + 7)
+    if shelf is None:
+        return None
+    shelf_row, a, b = shelf
+    left_anchor = (shelf_row - 1, a - 1)
+    right_anchor = (shelf_row - 1, b + 1)
+
+    left = _place_branch_frame(grid, occ, left_anchor[0], left_anchor[1], "left", internal=False)
+    right = _place_branch_frame(grid, occ, right_anchor[0], right_anchor[1], "right", internal=False)
+    if left is None or right is None:
+        return None
+    return [top, left, right]
+
+
+def _gen_down_split_chain(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    h, w = grid.shape
+    top = None
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        c0 = random.randint(5, w - ow - 6)
+        gap_c = c0 + random.randint(1, ow - 2)
+        gap_r = r0 + oh - 1
+        top = _place_frame_from_gap(grid, occ, "bottom", gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    if top is None:
+        return None
+
+    shelf = _place_split_shelf(grid, occ, top["gap"][0], top["gap"][1], top["bbox"][2] + 3, top["bbox"][2] + 7)
