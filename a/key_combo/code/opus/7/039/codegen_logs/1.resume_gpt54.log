+
+
+def _place_frame_bbox(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    r0: int,
+    c0: int,
+    oh: int,
+    ow: int,
+    gap_side: str,
+    gap_offset: int,
+    fill_red: bool,
+) -> dict | None:
+    r1 = r0 + oh - 1
+    c1 = c0 + ow - 1
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+        return None
+    if not _bbox_is_free(occ, r0, c0, r1, c1, pad=1):
+        return None
+    if gap_side in {"top", "bottom"}:
