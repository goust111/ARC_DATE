+
+def _outgoing_anchor(frame: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    gap_r, gap_c = map(int, frame["gap"])
+    side = frame["side"]
+    h, w = shape
+    if side == "left":
+        return gap_r, 0
+    if side == "right":
+        return gap_r, w - 1
+    if side == "top":
+        return 0, gap_c
+    assert side == "bottom"
+    return gap_r, gap_c
