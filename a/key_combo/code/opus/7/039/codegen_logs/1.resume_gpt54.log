+def _gen_down_split2(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    top = _place_top_bottom_frame(grid, occ)
+    if top is None:
+        return None
+
+    gap_c = int(top["gap"][1])
+    length = random.randint(4, 5)
