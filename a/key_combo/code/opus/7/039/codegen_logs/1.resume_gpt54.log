+            r, c = map(int, frame["gap"])
+            dr, dc = frame["dir"]
+            out[r, c] = int(color)
+            end_r, end_c = r, c
+            while True:
+                nr = int(end_r + dr)
+                nc = int(end_c + dc)
+                if not (0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]):
