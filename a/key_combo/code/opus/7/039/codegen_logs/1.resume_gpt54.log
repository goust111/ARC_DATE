+
+
+def _place_edge_shelf(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    side: str,
+    row_lo: int,
+    row_hi: int,
+) -> tuple[int, int, int] | None:
+    row_lo = max(int(anchor_r) + 3, int(row_lo))
