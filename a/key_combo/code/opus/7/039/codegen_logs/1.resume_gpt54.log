+    out = g.copy()
+    activated: set[int] = set()
+    seen_falls: set[tuple[int, int, int, int]] = set()
+    queue = deque([("frame", start_ids[0], RED)])
+
+    def enqueue_fall(r: int, c: int, color: int, include_start: bool) -> None:
+        if 0 <= int(r) < g.shape[0] and 0 <= int(c) < g.shape[1]:
+            queue.append(("fall", int(r), int(c), int(color), int(include_start)))
+
+    while queue:
+        item = queue.popleft()
+        kind = item[0]
+
+        if kind == "frame":
+            _, frame_id, color = item
+            if int(frame_id) in activated:
+                continue
+            frame = frames[int(frame_id)]
+            activated.add(int(frame_id))
+            _fill_frame_interior(out, frame, int(color))
+
+            r, c = map(int, frame["gap"])
+            dr, dc = frame["dir"]
+            out[r, c] = int(color)
+            end_r, end_c = r, c
+            while True:
+                nr = int(end_r + dr)
+                nc = int(end_c + dc)
+                if not (0 <= nr < g.shape[0] and 0 <= nc < g.shape[1]):
+                    break
+                if int(g[nr, nc]) != BG:
+                    break
+                end_r, end_c = nr, nc
+                _paint_if_blank(out, end_r, end_c, int(color))
+            enqueue_fall(end_r, end_c, int(color), False)
+            continue
+
+        _, cur_r, cur_c, color, include_start_int = item
+        state = (int(cur_r), int(cur_c), int(color), int(include_start_int))
+        if state in seen_falls:
+            continue
+        seen_falls.add(state)
+
+        if include_start_int:
+            if int(g[cur_r, cur_c]) == BG:
+                _paint_if_blank(out, int(cur_r), int(cur_c), int(color))
+
+        r = int(cur_r)
+        c = int(cur_c)
+        while True:
+            nr = int(r + 1)
+            if nr >= g.shape[0]:
+                break
+
+            if (nr, c) in gap_to_frame:
+                target = int(gap_to_frame[(nr, c)])
+                if target not in activated:
+                    queue.append(("frame", target, _toggle(int(color))))
+                break
+
+            below = int(g[nr, c])
+            if below == BG:
+                r = nr
+                _paint_if_blank(out, r, c, int(color))
+                continue
+
+            if below == SHELF:
+                seg = _segment_covering(shelves[nr], c)
+                if seg is None:
+                    break
+                a, b = seg
+                for x in range(a, b + 1):
+                    if int(g[r, x]) == BG:
+                        _paint_if_blank(out, r, x, int(color))
+                enqueue_fall(r, a - 1, int(color), True)
+                enqueue_fall(r, b + 1, int(color), True)
+                break
+
+            break
+
+    return out
+
+
+def _expanded_bbox(r0: int, c0: int, r1: int, c1: int, h: int, w: int, pad: int = 1) -> tuple[int, int, int, int]:
+    return max(0, r0 - pad), max(0, c0 - pad), min(h - 1, r1 + pad), min(w - 1, c1 + pad)
+
+
+def _bbox_is_free(occ: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> bool:
+    rr0, cc0, rr1, cc1 = _expanded_bbox(r0, c0, r1, c1, occ.shape[0], occ.shape[1], pad)
+    return not bool(occ[rr0 : rr1 + 1, cc0 : cc1 + 1].any())
+
+
+def _reserve_bbox(occ: np.ndarray, r0: int, c0: int, r1: int, c1: int, pad: int = 1) -> None:
+    rr0, cc0, rr1, cc1 = _expanded_bbox(r0, c0, r1, c1, occ.shape[0], occ.shape[1], pad)
+    occ[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
+
+
+def _draw_frame(grid: np.ndarray, occ: np.ndarray, frame: dict, fill_red: bool) -> None:
+    r0, c0, r1, c1 = frame["bbox"]
+    gap = tuple(frame["gap"])
+    for r, c in _border_cells(r0, c0, r1, c1):
+        if (r, c) != gap:
+            grid[r, c] = FRAME
+    if fill_red:
+        grid[r0 + 1 : r1, c0 + 1 : c1] = RED
+    _reserve_bbox(occ, r0, c0, r1, c1, pad=1)
+
+
+def _draw_shelf(grid: np.ndarray, occ: np.ndarray, row: int, a: int, b: int) -> None:
+    grid[row, a : b + 1] = SHELF
+    _reserve_bbox(occ, row, a, row, b, pad=1)
+
+
+def _line_is_clear(grid: np.ndarray, fixed: int, start: int, end: int, axis: str) -> bool:
+    if start > end:
+        return True
+    if axis == "col":
+        return bool(np.all(grid[start : end + 1, fixed] == BG))
+    return bool(np.all(grid[fixed, start : end + 1] == BG))
+
+
+def _place_frame_from_gap(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    gap_side: str,
+    gap_r: int,
+    gap_c: int,
+    oh: int,
+    ow: int,
+    fill_red: bool,
+) -> dict | None:
+    if gap_side == "top":
+        offset = random.randint(1, ow - 2)
+        r0 = gap_r
+        c0 = gap_c - offset
+    elif gap_side == "bottom":
+        offset = random.randint(1, ow - 2)
+        r0 = gap_r - oh + 1
+        c0 = gap_c - offset
+    elif gap_side == "left":
+        offset = random.randint(1, oh - 2)
+        r0 = gap_r - offset
+        c0 = gap_c
+    else:
+        assert gap_side == "right"
+        offset = random.randint(1, oh - 2)
+        r0 = gap_r - offset
+        c0 = gap_c - ow + 1
+
+    r1 = r0 + oh - 1
+    c1 = c0 + ow - 1
+    if r0 < 0 or c0 < 0 or r1 >= grid.shape[0] or c1 >= grid.shape[1]:
+        return None
+    if not _bbox_is_free(occ, r0, c0, r1, c1, pad=1):
+        return None
+
+    frame = {
+        "bbox": (int(r0), int(c0), int(r1), int(c1)),
+        "gap": (int(gap_r), int(gap_c)),
+        "side": gap_side,
+    }
+    _draw_frame(grid, occ, frame, fill_red=fill_red)
+    return frame
+
+
+def _outgoing_anchor(frame: dict, shape: tuple[int, int]) -> tuple[int, int]:
+    gap_r, gap_c = map(int, frame["gap"])
+    side = frame["side"]
+    h, w = shape
+    if side == "left":
+        return gap_r, 0
+    if side == "right":
+        return gap_r, w - 1
+    if side == "top":
+        return 0, gap_c
+    assert side == "bottom"
+    return gap_r, gap_c
+
+
+def _place_split_shelf(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    row_lo: int,
+    row_hi: int,
+) -> tuple[int, int, int] | None:
+    row_lo = max(int(anchor_r) + 3, int(row_lo))
+    row_hi = min(int(row_hi), grid.shape[0] - 4)
+    if row_lo > row_hi:
+        return None
+    for _ in range(60):
+        row = random.randint(row_lo, row_hi)
+        if not _line_is_clear(grid, anchor_c, anchor_r + 1, row - 1, "col"):
+            continue
+        length = random.randint(3, 6)
+        left_max = min(anchor_c, grid.shape[1] - length - 2)
+        left_min = max(2, anchor_c - length + 1)
+        if left_min > left_max:
+            continue
+        a = random.randint(left_min, left_max)
+        b = a + length - 1
+        if not (a <= anchor_c <= b):
+            continue
+        if a - 1 < 0 or b + 1 >= grid.shape[1]:
+            continue
+        if not _bbox_is_free(occ, row, a, row, b, pad=1):
+            continue
+        _draw_shelf(grid, occ, row, a, b)
+        return (int(row), int(a), int(b))
+    return None
+
+
+def _place_edge_shelf(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    side: str,
+    row_lo: int,
+    row_hi: int,
+) -> tuple[int, int, int] | None:
+    row_lo = max(int(anchor_r) + 3, int(row_lo))
+    row_hi = min(int(row_hi), grid.shape[0] - 4)
+    if row_lo > row_hi:
+        return None
+    assert side in {"left", "right"}
+    for _ in range(60):
+        row = random.randint(row_lo, row_hi)
+        if not _line_is_clear(grid, anchor_c, anchor_r + 1, row - 1, "col"):
+            continue
+        length = random.randint(3, 6)
+        if side == "left":
+            a, b = 0, length - 1
+        else:
+            a, b = grid.shape[1] - length, grid.shape[1] - 1
+        if not _bbox_is_free(occ, row, a, row, b, pad=1):
+            continue
+        _draw_shelf(grid, occ, row, a, b)
+        return (int(row), int(a), int(b))
+    return None
+
+
+def _place_specific_shelf(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    row: int,
+    a: int,
+    b: int,
+) -> tuple[int, int, int] | None:
+    if not (0 <= a <= b < grid.shape[1]):
+        return None
+    if not (a <= anchor_c <= b):
+        return None
+    if a - 1 < 0 or b + 1 >= grid.shape[1]:
+        return None
+    if row <= anchor_r + 2 or row >= grid.shape[0] - 3:
+        return None
+    if not _line_is_clear(grid, anchor_c, anchor_r + 1, row - 1, "col"):
+        return None
+    if not _bbox_is_free(occ, row, a, row, b, pad=1):
+        return None
+    _draw_shelf(grid, occ, row, a, b)
+    return (int(row), int(a), int(b))
+
+
+def _place_branch_frame(
+    grid: np.ndarray,
+    occ: np.ndarray,
+    anchor_r: int,
+    anchor_c: int,
+    preferred_side: str,
+    internal: bool,
+) -> dict | None:
+    options = [preferred_side] if internal else [preferred_side, "top"]
+    random.shuffle(options)
+    for gap_side in options:
+        for _ in range(80):
+            oh = random.randint(4, 6)
+            ow = random.randint(4, 6)
+            if gap_side == "top":
+                lo = anchor_r + 3
+                hi = grid.shape[0] - oh - 2
+                if lo > hi:
+                    continue
+                gap_r = random.randint(lo, hi)
+                gap_c = anchor_c
+                if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+                    continue
+                if not _line_is_clear(grid, gap_c, 0, gap_r - 1, "col"):
+                    continue
+            elif gap_side == "left":
+                lo = anchor_r + 3
+                hi = grid.shape[0] - 3
+                if lo > hi:
+                    continue
+                gap_r = random.randint(lo, hi)
+                gap_c = anchor_c
+                if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+                    continue
+                if not _line_is_clear(grid, gap_r, 0, gap_c - 1, "row"):
+                    continue
+            else:
+                assert gap_side == "right"
+                lo = anchor_r + 3
+                hi = grid.shape[0] - 3
+                if lo > hi:
+                    continue
+                gap_r = random.randint(lo, hi)
+                gap_c = anchor_c
+                if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+                    continue
+                if not _line_is_clear(grid, gap_r, gap_c + 1, grid.shape[1] - 1, "row"):
+                    continue
+            frame = _place_frame_from_gap(
+                grid,
+                occ,
+                gap_side=gap_side,
+                gap_r=int(gap_r),
+                gap_c=int(gap_c),
+                oh=int(oh),
+                ow=int(ow),
+                fill_red=False,
+            )
+            if frame is not None:
+                return frame
+    return None
+
+
+def _validate_generated(grid: np.ndarray, frames: list[dict]) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    if out.shape != grid.shape:
+        return False
+    for idx, frame in enumerate(frames):
+        r0, c0, r1, c1 = frame["bbox"]
+        interior = out[r0 + 1 : r1, c0 + 1 : c1]
+        if interior.size == 0:
+            return False
+        colors = set(map(int, np.unique(interior)))
+        if len(colors) != 1:
+            return False
+        color = next(iter(colors))
+        if idx == 0 and color != RED:
+            return False
+        if idx > 0 and color != BLUE:
+            return False
+    return bool((out == BLUE).any()) and bool((out == RED).any())
+
+
+def _place_leaf_top_frame(grid: np.ndarray, occ: np.ndarray, anchor_r: int, anchor_c: int) -> dict | None:
+    for _ in range(120):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        lo = anchor_r + 3
+        hi = grid.shape[0] - oh - 2
+        if lo > hi:
+            return None
+        gap_r = random.randint(lo, hi)
+        gap_c = anchor_c
+        if not _line_is_clear(grid, anchor_c, anchor_r + 1, gap_r - 1, "col"):
+            continue
+        if not _line_is_clear(grid, gap_c, 0, gap_r - 1, "col"):
+            continue
+        frame = _place_frame_from_gap(
+            grid,
+            occ,
+            gap_side="top",
+            gap_r=int(gap_r),
+            gap_c=int(gap_c),
+            oh=int(oh),
+            ow=int(ow),
+            fill_red=False,
+        )
+        if frame is not None:
+            return frame
+    return None
+
+
+def _place_top_bottom_frame(grid: np.ndarray, occ: np.ndarray) -> dict | None:
+    w = grid.shape[1]
+    top = None
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        c0 = random.randint(5, w - ow - 6)
+        gap_c = c0 + random.randint(1, ow - 2)
+        gap_r = r0 + oh - 1
+        top = _place_frame_from_gap(grid, occ, "bottom", gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    return top
+
+
+def _terminal_anchors_from_shelf(row: int, a: int, b: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    return (row - 1, a - 1), (row - 1, b + 1)
+
+
+def _gen_down_split2(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    top = _place_top_bottom_frame(grid, occ)
+    if top is None:
+        return None
+
+    gap_c = int(top["gap"][1])
+    length = random.randint(4, 5)
+    row = int(top["bbox"][2]) + random.randint(4, 5)
+    a = max(4, min(gap_c - 2, grid.shape[1] - length - 5))
+    shelf = _place_specific_shelf(grid, occ, top["gap"][0], gap_c, row, a, a + length - 1)
+    if shelf is None:
+        return None
+    left_anchor, right_anchor = _terminal_anchors_from_shelf(*shelf)
+
+    left = _place_leaf_top_frame(grid, occ, left_anchor[0], left_anchor[1])
+    right = _place_leaf_top_frame(grid, occ, right_anchor[0], right_anchor[1])
+    if left is None or right is None:
+        return None
+    return [top, left, right]
+
+
+def _gen_down_split_chain(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    top = _place_top_bottom_frame(grid, occ)
+    if top is None:
+        return None
+
+    gap_c = int(top["gap"][1])
+    length = random.randint(4, 5)
+    row = int(top["bbox"][2]) + random.randint(4, 5)
+    a = max(5, min(gap_c - 2, grid.shape[1] - length - 6))
+    shelf = _place_specific_shelf(grid, occ, top["gap"][0], gap_c, row, a, a + length - 1)
+    if shelf is None:
+        return None
+    left_anchor, right_anchor = _terminal_anchors_from_shelf(*shelf)
+    chain_side = random.choice(["left", "right"])
+
+    if chain_side == "left":
+        leaf = _place_leaf_top_frame(grid, occ, right_anchor[0], right_anchor[1])
+        split_anchor = left_anchor
+    else:
+        leaf = _place_leaf_top_frame(grid, occ, left_anchor[0], left_anchor[1])
+        split_anchor = right_anchor
+    if leaf is None:
+        return None
+    length2 = random.randint(4, 5)
+    row2 = split_anchor[0] + random.randint(4, 5)
+    a2 = max(2, min(split_anchor[1] - 2, grid.shape[1] - length2 - 3))
+    shelf2 = _place_specific_shelf(grid, occ, split_anchor[0], split_anchor[1], row2, a2, a2 + length2 - 1)
+    if leaf is None or shelf2 is None:
+        return None
+    grand_a, grand_b = _terminal_anchors_from_shelf(*shelf2)
+    grand1 = _place_leaf_top_frame(grid, occ, grand_a[0], grand_a[1])
+    grand2 = _place_leaf_top_frame(grid, occ, grand_b[0], grand_b[1])
+    if grand1 is None or grand2 is None:
+        return None
+    return [top, leaf, grand1, grand2]
+
+
+def _gen_down_split_double_chain(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    top = _place_top_bottom_frame(grid, occ)
+    if top is None:
+        return None
+
+    gap_c = int(top["gap"][1])
+    length = random.randint(4, 5)
+    row = int(top["bbox"][2]) + random.randint(4, 5)
+    a = max(5, min(gap_c - 2, grid.shape[1] - length - 6))
+    shelf = _place_specific_shelf(grid, occ, top["gap"][0], gap_c, row, a, a + length - 1)
+    if shelf is None:
+        return None
+    left_anchor, right_anchor = _terminal_anchors_from_shelf(*shelf)
+
+    len_left = random.randint(4, 5)
+    row_left = left_anchor[0] + random.randint(4, 5)
+    a_left = max(2, min(left_anchor[1] - 2, grid.shape[1] - len_left - 3))
+    left_shelf = _place_specific_shelf(grid, occ, left_anchor[0], left_anchor[1], row_left, a_left, a_left + len_left - 1)
+    len_right = random.randint(4, 5)
+    row_right = right_anchor[0] + random.randint(4, 5)
+    a_right = max(2, min(right_anchor[1] - 2, grid.shape[1] - len_right - 3))
+    right_shelf = _place_specific_shelf(grid, occ, right_anchor[0], right_anchor[1], row_right, a_right, a_right + len_right - 1)
+    if left_shelf is None or right_shelf is None:
+        return None
+
+    leaves = []
+    for anchor in _terminal_anchors_from_shelf(*left_shelf) + _terminal_anchors_from_shelf(*right_shelf):
+        leaf = _place_leaf_top_frame(grid, occ, anchor[0], anchor[1])
+        if leaf is None:
+            return None
+        leaves.append(leaf)
+    return [top] + leaves
+
+
+def _gen_edge_chain3(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    h, w = grid.shape
+    side = random.choice(["left", "right"])
+    top = None
+    for _ in range(80):
+        oh = random.randint(4, 6)
+        ow = random.randint(4, 6)
+        r0 = random.randint(1, 3)
+        if side == "left":
+            c0 = random.randint(4, w - ow - 6)
+            gap_c = c0
+        else:
+            c0 = random.randint(6, w - ow - 4)
+            gap_c = c0 + ow - 1
+        gap_r = r0 + random.randint(1, oh - 2)
+        top = _place_frame_from_gap(grid, occ, side, gap_r, gap_c, oh, ow, fill_red=True)
+        if top is not None:
+            break
+    if top is None:
+        return None
+
+    anchor_r, anchor_c = _outgoing_anchor(top, grid.shape)
+    row = int(top["bbox"][2]) + random.randint(4, 5)
+    length = random.randint(4, 5)
+    if side == "left":
+        shelf = _place_specific_shelf(grid, occ, anchor_r, anchor_c, row, 0, length - 1)
+    else:
+        shelf = _place_specific_shelf(grid, occ, anchor_r, anchor_c, row, grid.shape[1] - length, grid.shape[1] - 1)
+    if shelf is None:
+        return None
+    row, a, b = shelf
+    if side == "left":
+        child_anchor = (row - 1, b + 1)
+    else:
+        child_anchor = (row - 1, a - 1)
+    length2 = random.randint(4, 5)
+    row2 = child_anchor[0] + random.randint(4, 5)
+    a2 = max(2, min(child_anchor[1] - 2, grid.shape[1] - length2 - 3))
+    shelf2 = _place_specific_shelf(grid, occ, child_anchor[0], child_anchor[1], row2, a2, a2 + length2 - 1)
+    if shelf2 is None:
+        return None
+
+    leaf1_anchor, leaf2_anchor = _terminal_anchors_from_shelf(*shelf2)
+    leaf1 = _place_leaf_top_frame(grid, occ, leaf1_anchor[0], leaf1_anchor[1])
+    leaf2 = _place_leaf_top_frame(grid, occ, leaf2_anchor[0], leaf2_anchor[1])
+    if leaf1 is None or leaf2 is None:
+        return None
+    return [top, leaf1, leaf2]
+
+
+def _gen_attempt() -> np.ndarray | None:
+    patterns = [
+        _gen_down_split2,
+        _gen_down_split_chain,
+        _gen_down_split_double_chain,
+        _gen_edge_chain3,
+    ]
+    weights = [3, 3, 2, 2]
+    builder = random.choices(patterns, weights=weights, k=1)[0]
+    if builder is _gen_down_split_double_chain:
+        h = random.randint(27, 29)
+        w = random.randint(25, 29)
+    elif builder is _gen_down_split_chain:
+        h = random.randint(25, 29)
+        w = random.randint(24, 29)
+    elif builder is _gen_edge_chain3:
+        h = random.randint(24, 29)
+        w = random.randint(22, 29)
+    else:
+        h = random.randint(22, 29)
+        w = random.randint(22, 29)
+    grid = np.full((h, w), BG, dtype=int)
+    occ = np.zeros((h, w), dtype=bool)
+
+    frames = builder(grid, occ)
+    if frames is None:
+        return None
+    if not _validate_generated(grid, frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
