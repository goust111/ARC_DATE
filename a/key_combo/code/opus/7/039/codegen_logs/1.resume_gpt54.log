+def _gen_down_split_chain(grid: np.ndarray, occ: np.ndarray) -> list[dict] | None:
+    h, w = grid.shape
+    oh = random.randint(4, 5)
+    ow = random.randint(5, 6)
+    gap_c = w // 2 + random.randint(-1, 1)
