14:def main(input_grid):
15:    """
16:    Return the one sprite among several objects that has a symmetry.
17:
18:    Input structure:
19:    - The input is a black grid containing several monochromatic sprites.
20:    - One sprite is symmetric under a rotation, reflection, or diagonal symmetry.
21:    - The other sprites are non-symmetric distractors.
22:
23:    Rule:
24:    - Detect and crop each object into its sprite.
25:    - Test each sprite for radial, vertical, horizontal, and diagonal symmetry.
26:    - Return the first sprite that satisfies one of those symmetry tests.
27:
28:    Key insight:
29:    - Shape symmetry, not color or position, identifies the target sprite.
30:    """
31:    # find the objects in the input grid
32:    objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
33:
34:    # crop out the sprites from the objects
35:    sprites = []
36:    for obj in objects:
37:        b = bbox(obj != Color.BLACK)
38:        if b is None:
39:            continue
40:        sprites.append(crop_bbox(obj, b))
41:
42:    # find the symmetric sprite
43:    symmetric_sprite = None
44:    for sprite in sprites:
45:      # check if the sprite is radially symmetric
46:      if np.array_equal(sprite, np.rot90(sprite, 1)):
47:        symmetric_sprite = sprite
48:        break
49:      # check if the sprite is vertically symmetric
50:      elif np.array_equal(sprite, np.fliplr(sprite)):
51:        symmetric_sprite = sprite
52:        break
53:      # check if the sprite is horizontally symmetric
54:      elif np.array_equal(sprite, np.flipud(sprite)):
55:        symmetric_sprite = sprite
56:        break
57:      # check if the sprite is diagonally symmetric
