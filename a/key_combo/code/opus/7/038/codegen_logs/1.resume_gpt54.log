130:
131:    out = g.copy()
132:    rm = r0 + 1
133:    cm = c0 + 1
134:
135:    red_specs = [
136:        ((r0 - 1, c0 - 1), (-1, -1)),
137:        ((r0 - 1, c1 + 1), (-1, 1)),
138:        ((r1 + 1, c0 - 1), (1, -1)),
139:        ((r1 + 1, c1 + 1), (1, 1)),
140:    ]
