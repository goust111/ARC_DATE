14:def main(input_grid: np.ndarray) -> np.ndarray:
15:    """
16:    Recolor each green pixel to match the nearest colored edge line.
17:
18:    Input structure:
19:    - Two full edge lines of different colors sit on opposite sides of the grid.
20:    - Green pixels are scattered between those lines.
21:    - The remaining cells are black.
22:
23:    Rule:
24:    - Remove green pixels from a line-only copy of the grid.
25:    - For each green pixel, find the closest non-black line cell by Manhattan distance.
26:    - Replace the green pixel with that closest line cell's color.
27:
28:    Key insight:
29:    - The edge lines are color sources, and each green marker inherits from the nearest source line.
30:    """
31:    # find the two lines by removing the green pixels
32:    lines = np.copy(input_grid)
33:    lines[input_grid == Color.GREEN] = Color.BLACK
34:
35:    # lines now contains only the lines, which are going to be used to assign color to the green pixels
36:    output_grid = np.copy(input_grid)
37:
38:    for r in range(input_grid.shape[0]):
39:        for c in range(input_grid.shape[1]):
40:            if input_grid[r, c] == Color.GREEN:
41:                # find the closest point on the lines
42:                closest_r, closest_c = min([(i, j) for i in range(input_grid.shape[0]) for j in range(input_grid.shape[1]) if lines[i, j] != Color.BLACK],
43:                                           key=lambda p: abs(p[0] - r) + abs(p[1] - c))
44:                color_of_closest_line = lines[closest_r, closest_c]
45:                output_grid[r, c] = color_of_closest_line
46:    
47:    return output_grid
