+    occupied = grid != BACKGROUND
+    rays = []
+    for source_id, bbox in enumerate(source_bboxes):
+        for info in _ray_cells(grid.shape, occupied, bbox):
+            ray_id = (source_id, info["corner_id"])
+            if ray_id in used or not info["cells"]:
