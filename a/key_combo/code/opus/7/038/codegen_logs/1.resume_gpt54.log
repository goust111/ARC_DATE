+    sc = src_bbox[1] + src_bbox[3]
+    tr = dst_bbox[0] + dst_bbox[2]
+    tc = dst_bbox[1] + dst_bbox[3]
+    dist = abs(sr - tr) + abs(sc - tc)
+    return dist, src_bbox[0], src_bbox[1]
