+def _can_place(
+    occupied: np.ndarray,
+    bboxes: list[tuple[int, int, int, int]],
+    mask: np.ndarray,
+    top: int,
+    left: int,
+    forbidden: set[tuple[int, int]],
+    allowed_hits: set[tuple[int, int]],
+) -> bool:
