+        ((r0, c0), (-1, -1)),
+        ((r0, c1), (-1, 1)),
+        ((r1, c0), (1, -1)),
+        ((r1, c1), (1, 1)),
+    ]
+
+
+def _ray_cells(
+    shape: tuple[int, int], occupied: np.ndarray, bbox: tuple[int, int, int, int]
