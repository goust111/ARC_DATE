+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not _in_bounds(g.shape, nr, nc) or seen[nr, nc]:
