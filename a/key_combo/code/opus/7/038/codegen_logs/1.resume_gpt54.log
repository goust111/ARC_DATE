146:        ((rm, c0 - 1), (-1, -1), "v", "desc"),
147:        ((r1 + 1, cm), (1, -1), "h", "desc"),
148:        ((rm, c1 + 1), (1, 1), "v", "asc"),
149:    ]
150:    for start, direction, odd_axis, odd_order in yellow_specs:
151:        _paint_yellow_ribbon(g, out, bg, start, direction, odd_axis, odd_order)
