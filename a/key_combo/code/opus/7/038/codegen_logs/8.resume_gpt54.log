+def _copy_origins(bbox: tuple[int, int, int, int], sprite_shape: tuple[int, int], count: int) -> list[tuple[int, int]]:
+    r0, c0, _r1, _c1 = bbox
+    h, w = sprite_shape
+    origins = [(r0, c0)]
