+
+    expected = grid.copy()
+    assigned = _greedy_marker_assignment(reflected_infos, markers)
+    for info, marker in zip(reflected_infos, assigned):
+        for r, c in info["placed"]:
+            expected[r, c] = marker["color"]
+
+    if not np.array_equal(main(grid), expected):
