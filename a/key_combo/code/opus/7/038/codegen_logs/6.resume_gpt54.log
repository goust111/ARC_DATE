+                }
+            )
+    return objects
+
+
+def _markers(grid: np.ndarray, axis: int):
+    markers = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(axis + 1, w):
+            color = int(grid[r, c])
+            if color in {BLACK, RED}:
+                continue
