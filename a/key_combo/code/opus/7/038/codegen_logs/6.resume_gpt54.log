+        if shape is None:
+            return None
+        shapes.append(shape)
+
+    stack_height = sum(_dims(shape)[0] for shape in shapes)
+    max_width = max(_dims(shape)[1] for shape in shapes)
+    min_height = max(14, stack_height)
+    max_height = min(18, stack_height + 4)
+    if min_height > max_height:
