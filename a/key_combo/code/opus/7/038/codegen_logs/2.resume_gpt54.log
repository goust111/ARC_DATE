+RAY_COLORS_BY_RANK = (2, 3, 4, 5)
+INPUT_COLORS = (1, 6, 7, 8, 9)
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
