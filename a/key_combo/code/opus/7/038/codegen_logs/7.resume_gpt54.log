+            w = int(_RNG.integers(2, 6))
+            seed = _RNG.random(((h + 1) // 2, w)) < _RNG.uniform(0.35, 0.7)
+            mask = _make_horizontal(seed, h)
+        elif mode == "rot180":
+            h = int(_RNG.integers(2, 6))
+            w = int(_RNG.integers(2, 6))
+            seed = _RNG.random((h, w)) < _RNG.uniform(0.25, 0.55)
