+    sh, sw = mask.shape
+    if sh > h - min_corner_gap or sw > w - min_corner_gap:
+        return None
+
+    candidates: list[tuple[int, int]] = []
+    for r0 in range(min_corner_gap, h - sh + 1):
+        for c0 in range(min_corner_gap, w - sw + 1):
+            rr0 = max(0, r0 - 1)
+            cc0 = max(0, c0 - 1)
+            rr1 = min(h, r0 + sh + 1)
+            cc1 = min(w, c0 + sw + 1)
