+            return None
+        r0, c0, _, _ = comp["bbox"]  # type: ignore[index]
+        if r0 < 4 or c0 < 4:
+            return None
+
+    out = main(grid)
+    if int(out[0, 0]) != GREY:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _build_input()
+        if grid is not None:
+            return grid
