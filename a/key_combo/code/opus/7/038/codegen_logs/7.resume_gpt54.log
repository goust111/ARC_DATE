+        "horizontal": bool(np.array_equal(mask, np.flipud(mask))),
+        "rot180": bool(np.array_equal(mask, np.rot90(mask, 2))),
+        "diag": bool(mask.shape[0] == mask.shape[1] and np.array_equal(mask, mask.T)),
