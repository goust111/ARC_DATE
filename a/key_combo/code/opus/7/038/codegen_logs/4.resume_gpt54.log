+) -> dict | None:
+    H, W = shape
+    for _ in range(PLACEMENT_TRIES):
+        move_name = random.choice(tuple(MOVE_VECTORS))
+        body = _random_body_shape()
+        body_h, body_w = _shape_size(body)
+        max_dist = _max_distance_for_body(move_name, body_h, body_w, shape)
