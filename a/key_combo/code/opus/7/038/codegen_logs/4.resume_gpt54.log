+    cells = {tuple(cell) for cell in coords.tolist()}
+    start = next(iter(cells))
+    queue = deque([start])
+    seen = {start}
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            nb = (r + dr, c + dc)
