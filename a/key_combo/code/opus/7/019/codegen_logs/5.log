+    """Return all cells with r - c == k on a grid of shape (H, W)."""
+    H, W = map(int, shape)
+    coords: list[tuple[int, int]] = []
+    for r in range(H):
+        c = r - int(k)
+        if 0 <= c < W:
+            coords.append((r, c))
+    return coords
