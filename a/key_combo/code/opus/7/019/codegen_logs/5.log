+        r1 = min(H - 1, int(r) + int(radius))
+        c0 = max(0, int(c) - int(radius))
+        c1 = min(W - 1, int(c) + int(radius))
+        out[r0 : r1 + 1, c0 : c1 + 1] = Color.BLACK
+    for r, c in blockers:
+        out[int(r), int(c)] = Color.GREY
+    return out
