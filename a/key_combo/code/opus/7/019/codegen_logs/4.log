+        # Keep moved rectangles from overwriting each other's source areas.
+        if any(
+            _bbox_intersects(rect["dst_bbox"], other["bbox"])
+            for i, rect in enumerate(moving_rects)
+            for j, other in enumerate(moving_rects)
+            if i != j
+        ):
