+def _touches_for_bbox(bbox: tuple[int, int, int, int], shape: tuple[int, int]) -> tuple[str, ...]:
+    r0, c0, r1, c1 = bbox
+    H, W = shape
+    edges: list[str] = []
+    if r0 == 0:
+        edges.append("top")
+    if r1 == H - 1:
+        edges.append("bottom")
+    if c0 == 0:
+        edges.append("left")
+    if c1 == W - 1:
+        edges.append("right")
+    return tuple(edges)
