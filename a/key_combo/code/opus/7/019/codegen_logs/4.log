+def _destination_bbox(rect: dict, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = rect["bbox"]
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    dr = 0
+    dc = 0
+    touches = set(rect["touches"])
+    if "top" in touches:
+        dr += h
+    if "bottom" in touches:
+        dr -= h
+    if "left" in touches:
+        dc += w
+    if "right" in touches:
+        dc -= w
