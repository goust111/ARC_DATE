+        second = _pick_candidate(
+            candidates,
+            chosen,
+            rng,
+            corner_rate=0.45,
+            reject_boxes=[rect["dst_bbox"] for rect in moving_rects],
+        )
+        if second is None or _bbox_intersects(second["dst_bbox"], first["dst_bbox"]):
+            continue
+        chosen.append(second)
+        moving_rects.append(second)
