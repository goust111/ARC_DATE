+        moving_rects: list[dict] = []
+
+        first = _pick_candidate(candidates, chosen, rng, corner_rate=0.45)
+        if first is None:
+            return None
+        chosen.append(first)
+        moving_rects.append(first)
+
+        second = _pick_candidate(
+            candidates,
+            chosen,
+            rng,
+            corner_rate=0.45,
+            reject_boxes=[rect["dst_bbox"] for rect in moving_rects],
