+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        sample = _sample_layout(rng)
+        if sample is None:
+            continue
+        inp, _expected = sample
+        return inp
