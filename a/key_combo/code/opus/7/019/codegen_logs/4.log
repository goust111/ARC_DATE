+def _bbox_intersects(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar0 <= br1 and br0 <= ar1 and ac0 <= bc1 and bc0 <= ac1
+
+
+def _bbox_intersects_with_gap(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    gap: int = 1,
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + gap < br0
+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
+
