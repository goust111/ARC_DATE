+
+def _draw_rectangles(base: np.ndarray, rects: list[dict]) -> np.ndarray:
+    out = base.copy()
+    for rect in rects:
+        r0, c0, r1, c1 = rect["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = int(rect["color"])
+    return out
+
