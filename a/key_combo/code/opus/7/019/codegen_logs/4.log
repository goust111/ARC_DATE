            marker = int(inp[r0 + 1, c0 + 1])
            out[r0:r0 + _GEN_CELL_SIZE, c0:c0 + _GEN_CELL_SIZE] = _GEN_MARKER_TO_FILL_54D9E175[marker]
    return out

