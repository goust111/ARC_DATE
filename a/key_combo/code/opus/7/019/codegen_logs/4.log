    for pink_count in range(_GEN_PINK_COUNT_BOUNDS[0], _GEN_PINK_COUNT_BOUNDS[1] + 1):
        for copy_count in range(_GEN_COPY_COUNT_BOUNDS[0], _GEN_COPY_COUNT_BOUNDS[1] + 1):
