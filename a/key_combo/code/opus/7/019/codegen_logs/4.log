+def _paint_background_patch(
+    out: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    tile: np.ndarray,
+) -> None:
+    r0, c0, r1, c1 = bbox
+    pr, pc = tile.shape
+    rows = np.arange(r0, r1 + 1) % pr
+    cols = np.arange(c0, c1 + 1) % pc
+    out[r0 : r1 + 1, c0 : c1 + 1] = tile[np.ix_(rows, cols)]
