+
+    candidates = _candidate_rectangles(H, W)
+    for _ in range(200):
+        chosen: list[dict] = []
+        moving_rects: list[dict] = []
+
+        first = _pick_candidate(candidates, chosen, rng, corner_rate=0.45)
+        if first is None:
+            return None
+        chosen.append(first)
+        moving_rects.append(first)
