                    continue
                visible_yellow += 1
                if int(out[rr, cc]) in _GEN_OCCUPIED_COLORS:
                    ok = False
                    break
            if ok and visible_yellow:
                placements.append((top, left))
    random.shuffle(placements)
    return placements


