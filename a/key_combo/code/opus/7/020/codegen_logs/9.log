+    r0, c0, r1, c1 = tile_box
+    out[r0 : r1 + 1, c0 : c1 + 1] = g[r0 : r1 + 1, c0 : c1 + 1]
+    legend_mask = _legend_mask(g)
+    out[legend_mask] = g[legend_mask]
