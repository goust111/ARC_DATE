            rs = slice(data_r0 + qr * half_h, data_r0 + (qr + 1) * half_h)
            cs = slice(data_c0 + qc * half_w, data_c0 + (qc + 1) * half_w)
            mask = g[rs, cs] == data_color
            block = out[rs, cs]
            block[mask] = int(legend[qr, qc])
    return out

