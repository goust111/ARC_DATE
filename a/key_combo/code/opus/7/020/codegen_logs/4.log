+        if B >= 3:
+            work, varied = _simulate_growth(g, color, B)
+            grow_score_varied |= varied
+        elif idx != largest_idx or not exempt_largest:
+            work, varied = _simulate_shrink(g, color, B)
+            shrink_score_varied |= varied
