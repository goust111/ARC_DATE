+    out = np.zeros_like(g)
+    for color, coords in finals:
+        for r, c in coords:
+            if int(out[r, c]) not in (Color.BLACK, color):
+                raise AssertionError("simultaneous edits overlap")
+            out[r, c] = color
+    return out, metadata, grow_score_varied, shrink_score_varied, int(n_bg)
