+        return False
+    if sum(B <= 2 for B in b_values) != 2:
+        return False
+
+    largest = [color for color, info in metadata.items() if bool(info["largest"])]
+    if len(largest) != 1:
+        return False
+    if int(metadata[largest[0]]["B"]) > 2:
+        return False
+
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return False
+    return True
+
