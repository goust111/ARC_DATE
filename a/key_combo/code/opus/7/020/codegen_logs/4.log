    if np.array_equal(grid,out): return False,None
    # largest exemption must matter
    alt=solve(grid, False)
    if alt is None or np.array_equal(alt[0], out): return False,None
    if not gvar: return False,None
    if not svar: return False,None
    return True,(grid,out,Bs,nreg)

ok=0
start=time.time(); tries=0
while ok<10 and tries<20000:
    tries+=1
    good,res=attempt()
