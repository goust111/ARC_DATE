+    sh = max(r for r, _ in shape) + 1
+    sw = max(c for _, c in shape) + 1
+    r0 = 0 if "T" in corner else h - sh
+    c0 = 0 if "L" in corner else w - sw
+    return {(r0 + r, c0 + c) for r, c in shape}
+
