+    objects = [
+        _place_corner(random.choice(BIG_LOW_SHAPES), low_corners[0], h, w),
+        _place_corner(random.choice(SMALL_LOW_SHAPES), low_corners[1], h, w),
+        _place_corner(random.choice(GROW_SHAPES), grow_list[0], h, w),
