        ok+=1
        grid,out,Bs,nreg=res
        print('"'ok',ok,'tries',tries,'shape',grid.shape,'Bs',Bs,'regions',nreg)
        print(grid)
        print('->')
        print(out)
        print()
print('done',ok,'tries',tries,'sec',time.time()-start)
