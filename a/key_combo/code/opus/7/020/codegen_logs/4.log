+        if len({score for score, _, _ in scored}) > 1:
+            varied = True
+        score, rr, cc = max(scored, key=lambda item: (item[0], -item[1], -item[2]))
+        _ = score
+        work[rr, cc] = color
+    return work, varied
+
+
