def _gen_path_clear(g, start, path, end):
    if not in_bounds(g.shape, end[0], end[1]) or int(g[end]) != Color.BLACK:
        return False
    path_set = set(path)
    for r, c in path:
        if not in_bounds(g.shape, r, c) or int(g[r, c]) != Color.BLACK:
            return False
    for r, c in path:
