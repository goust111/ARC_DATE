+    orange_rows = np.any(right == ORANGE, axis=1)
+    orange_cols = np.any(right == ORANGE, axis=0)
+    if not (orange_rows[0] and orange_rows[-1] and orange_cols[0] and orange_cols[-1]):
+        return False
+
+    return np.array_equal(main(grid), expected)
