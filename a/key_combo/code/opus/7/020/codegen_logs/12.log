+
+    if len(colors_present(grid, exclude={BG})) != sprite_count + 2:
+        return None
+
+    depths = _macro_depths(selector)
+    if not np.any(selector & (depths % 2 == 0)) or not np.any(selector & (depths % 2 == 1)):
