0021: def main(grid: np.ndarray) -> np.ndarray:
0022:     """
0023:     Recolor the data pixels in each quadrant using the matching entry of the 2x2 legend.
0024: 
0025:     Input structure:
0026:     - The grid has a dominant background, a thick divider color, one 2x2 corner legend,
0027:       and an opposite rectangular data region.
0028:     - The data region contains background plus one foreground data color.
0029: 
0030:     Rule:
0031:     - Split the data region into four equal quadrants.
0032:     - For every data-colored pixel, replace it with the color in the same top/bottom and
0033:       left/right position of the 2x2 legend.
0034:     - Keep the background, divider, and legend unchanged.
0035: 
0036:     Key insight:
0037:     - The 2x2 legend is not moved or copied as a shape; its cells are a quadrant color
0038:       key for the separated data field.
0039:     """
0040:     g = np.asarray(grid, dtype=int)
0041:     assert g.ndim == 2, "expected a 2D grid"
0042:     h, w = g.shape
0043: 
0044:     bg = get_bg(g)
0045:     divider = _unique_divider_color(g, bg)
0046: 
0047:     non_field_mask = (g != bg) & (g != divider)
0048:     legend_boxes = []
0049:     for coords in components_mask(non_field_mask, connectivity=4):
0050:         r0, c0, r1, c1 = bbox_coords(coords)
0051:         is_corner = (r0 == 0 or r1 == h - 1) and (c0 == 0 or c1 == w - 1)
0052:         if coords.shape[0] == 4 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2) and is_corner:
0053:             legend_boxes.append((r0, c0, r1, c1))
0054:     assert len(legend_boxes) == 1, "expected exactly one 2x2 legend"
0055:     lr0, lc0, lr1, lc1 = legend_boxes[0]
0056:     legend = g[lr0 : lr1 + 1, lc0 : lc1 + 1]
0057:     assert np.all((legend != bg) & (legend != divider)), "legend should contain only paint colors"
0058: 
0059:     at_top = lr0 == 0
0060:     at_bottom = lr1 == h - 1
0061:     at_left = lc0 == 0
0062:     at_right = lc1 == w - 1
0063:     assert at_top != at_bottom and at_left != at_right, "legend must sit in one corner"
0064: 
0065:     data_r0, data_r1 = (lr1 + 1, h - 1) if at_top else (0, lr0 - 1)
0066:     data_c0, data_c1 = (lc1 + 1, w - 1) if at_left else (0, lc0 - 1)
0067:     assert data_r0 <= data_r1 and data_c0 <= data_c1, "expected a nonempty data region"
0068: 
0069:     assert np.all(g[lr0 : lr1 + 1, data_c0 : data_c1 + 1] == divider)
0070:     assert np.all(g[data_r0 : data_r1 + 1, lc0 : lc1 + 1] == divider)
0071: 
0072:     data = g[data_r0 : data_r1 + 1, data_c0 : data_c1 + 1]
0073:     data_colors = [int(color) for color in set(map(int, data.ravel())) if color != bg]
0074:     assert len(data_colors) == 1, "data region should contain one foreground color"
0075:     data_color = data_colors[0]
0076:     assert data_color != divider, "divider should not appear inside the data region"
0077: 
0078:     data_h, data_w = data.shape
0079:     assert data_h % 2 == 0 and data_w % 2 == 0, "data region must split into four equal quadrants"
0080:     half_h, half_w = data_h // 2, data_w // 2
0081: 
0082:     out = g.copy()
0083:     for qr in range(2):
0084:         for qc in range(2):
0085:             rs = slice(data_r0 + qr * half_h, data_r0 + (qr + 1) * half_h)
0086:             cs = slice(data_c0 + qc * half_w, data_c0 + (qc + 1) * half_w)
0087:             mask = g[rs, cs] == data_color
