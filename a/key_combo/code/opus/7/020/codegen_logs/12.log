+def _macro_depths(selector: np.ndarray) -> np.ndarray:
+    h, w = selector.shape
+    depths = np.full((h, w), -1, dtype=int)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in range(w):
+            if not selector[r, c]:
+                continue
+            if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                depths[r, c] = 0
+                q.append((r, c))
