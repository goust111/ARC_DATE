0308: def paste(
0309:     dst: np.ndarray,
0310:     patch: np.ndarray,
0311:     r0: int,
0312:     c0: int,
0313:     *,
0314:     transparent: int | None = None,
0315:     mask: np.ndarray | None = None,
0316:     overwrite: bool = True,
0317:     clip: bool = False,
0318: ) -> np.ndarray:
0319:     """
0320:     Paste `patch` into `dst` at top-left (r0,c0).
0321: 
0322:     This is the ONE placement primitive solver examples should use.
0323: 
0324:     - Opaque paste: `paste(dst, patch, r0, c0)`
0325:     - Transparent overlay: `paste(dst, patch, r0, c0, transparent=bg)`
0326:     - Masked paste: `paste(dst, patch, r0, c0, mask=m)`
0327:     - Non-overwriting overlay: `paste(dst, patch, r0, c0, transparent=bg, overwrite=False)`
0328:     - Strict vs clip: default `clip=False` (fail fast); set `clip=True` to clip out-of-bounds.
0329:     """
0330:     H, W = dst.shape
0331:     r0 = int(r0)
0332:     c0 = int(c0)
0333:     h, w = map(int, patch.shape)
0334: 
0335:     if not clip:
0336:         if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
0337:             raise ValueError("paste: patch out of bounds (set clip=True to allow clipping)")
0338:         rr0, cc0 = r0, c0
0339:         rr1, cc1 = r0 + h, c0 + w
0340:         pr0, pc0 = 0, 0
0341:     else:
0342:         rr0 = max(0, r0)
0343:         cc0 = max(0, c0)
0344:         rr1 = min(H, r0 + h)
0345:         cc1 = min(W, c0 + w)
0346:         if rr0 >= rr1 or cc0 >= cc1:
0347:             return dst
0348:         pr0 = rr0 - r0
0349:         pc0 = cc0 - c0
0350: 
0351:     pr1 = pr0 + (rr1 - rr0)
0352:     pc1 = pc0 + (cc1 - cc0)
0353: 
0354:     dst_view = dst[rr0:rr1, cc0:cc1]
0355:     patch_view = patch[pr0:pr1, pc0:pc1]
0356: 
0357:     m = np.ones(patch_view.shape, dtype=bool)
0358:     if mask is not None:
0359:         m &= mask[pr0:pr1, pc0:pc1].astype(bool)
0360:     if transparent is not None:
0361:         m &= (patch_view != int(transparent))
0362:         if not overwrite:
0363:             m &= (dst_view == int(transparent))
0364:     else:
0365:         if not overwrite:
0366:             raise ValueError("paste: overwrite=False requires transparent to be set")
0367: 
0368:     dst_view[m] = patch_view[m]

