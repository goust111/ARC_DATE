+def _place_source_pieces(
+    shape: tuple[int, int],
+    rect_bbox: tuple[int, int, int, int],
+    marker_cells: list[tuple[int, int]],
+    pieces: list[np.ndarray],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    occ = np.zeros(shape, dtype=bool)
+    r0, c0, r1, c1 = rect_bbox
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
+    occ[rr0 : rr1 + 1, cc0 : cc1 + 1] = True
