+
+
+def _piece_bboxes_from_placements(placements: list[tuple[int, int]], pieces: list[np.ndarray]) -> list[tuple[int, int, int, int]]:
+    out = []
+    for (top, left), patch in zip(placements, pieces):
+        ph, pw = patch.shape
+        out.append((top, left, top + ph - 1, left + pw - 1))
