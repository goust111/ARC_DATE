+
+    desired_order = template["placement_order"]
+    blocked_budget = 3 if len(template["pieces"]) == 4 else 2
+    obstacles = _find_obstacles_for_order(piece_bboxes, rect_bbox, desired_order, blocked_budget, forbidden, (gh, gw))
+    if not obstacles:
