+        cells = [(r0 - 1, c1), (r0 - 1, c1 + 1), (r0, c1 + 1)]
+    elif corner == "BL":
+        anchor = (r1, c0)
+        cells = [(r1, c0 - 1), (r1 + 1, c0 - 1), (r1 + 1, c0)]
+    else:
