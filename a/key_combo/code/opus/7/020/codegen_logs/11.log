+    rect_bbox: tuple[int, int, int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect_bbox
+    sr, sc = _piece_center(piece_bbox)
+    tr = (r0 + r1) // 2
+    tc = (c0 + c1) // 2
+    path = []
+    for rr, cc in _row_first_path((sr, sc), (tr, tc)):
+        if 0 <= rr < shape[0] and 0 <= cc < shape[1]:
