+    shape: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    paths = [
+        [cell for cell in _row_first_path_cells_for_bbox(bbox, rect_bbox, shape) if cell not in forbidden]
+        for bbox in piece_bboxes
