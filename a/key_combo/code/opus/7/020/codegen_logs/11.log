+    assert 2 <= nonblue <= 4
+    return piece
+
+
+def _interior_spots(h: int, w: int) -> list[tuple[int, int]]:
+    spots = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            spots.append((r, c))
+    if not spots:
+        spots.append((h // 2, max(1, w // 2)))
+    return spots
+
+
+def _build_row_template() -> dict:
