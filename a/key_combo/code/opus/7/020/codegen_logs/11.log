+            patch = piece["array"]
+            touch = False
+
+            if left > 0:
+                neigh = occ_mask[top : top + ph, left - 1]
+                if neigh.any():
+                    if not _edge_compatible(patch[:, 0][neigh], occ_color[top : top + ph, left - 1][neigh]):
+                        continue
+                    touch = True
+            if left + pw < rw:
+                neigh = occ_mask[top : top + ph, left + pw]
+                if neigh.any():
