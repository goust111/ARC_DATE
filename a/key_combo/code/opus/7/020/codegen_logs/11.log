+        order = sorted(
+            range(len(pieces)),
+            key=lambda idx: (_obstacle_score(pieces[idx]["bbox"], rect_bbox, obstacles), pieces[idx]["bbox"]),
+        )
+        sols = _solve_for_order(pieces, rect_bbox, corner, order, max_solutions=2)
+        if len(sols) == 1:
