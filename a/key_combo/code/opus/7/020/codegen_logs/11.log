+    alt_sols = _solve_for_order(parsed, meta["rect_bbox"], meta["corner"], alt_order, max_solutions=2)
+    if len(alt_sols) != 1:
+        return False
+    if np.array_equal(alt_sols[0], meta["assembled"]):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    template = _build_row_template()
