+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    dst[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _find_multicolor_components(grid: np.ndarray, allowed: set[int]) -> list[dict]:
+    mask = np.isin(grid, list(allowed))
+    seen = np.zeros_like(mask, dtype=bool)
+    pieces = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            bbox = _bbox_coords(arr)
+            patch = _crop_bbox(grid, bbox)
+            area = int(arr.shape[0])
+            bh = bbox[2] - bbox[0] + 1
+            bw = bbox[3] - bbox[1] + 1
+            assert area == bh * bw, "expected solid rectangular pieces"
+            pieces.append(
+                {
+                    "coords": arr,
+                    "bbox": bbox,
+                    "array": patch,
+                    "area": area,
+                }
+            )
+    pieces.sort(key=lambda item: item["bbox"])
+    for idx, piece in enumerate(pieces):
