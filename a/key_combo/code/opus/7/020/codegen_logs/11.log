+    spots_a = _interior_spots(h, w_a)
+    spots_mid = _interior_spots(h, w_mid)
+    piece_a = _make_piece(
+        h,
+        w_a,
+        left=pat_a,
+        right=pat_l,
+        interior=[(*random.choice(spots_a), random.choice([c for c in PALETTE if c not in {color_l, color_a}]))],
+    )
+    piece_x = _make_piece(
+        h,
+        w_mid,
+        left=pat_l,
+        right=pat_r,
+        interior=[(*random.choice(spots_mid), color_a)],
+    )
+    piece_y = _make_piece(
