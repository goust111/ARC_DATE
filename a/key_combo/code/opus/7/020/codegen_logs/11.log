+        idx = order[step]
+        piece = pieces[idx]
+        for top, left in _candidate_positions(piece, step, rect_shape, corner, occ_mask, occ_color):
+            patch = piece["array"]
+            ph, pw = patch.shape
+            occ_mask[top : top + ph, left : left + pw] = True
+            occ_color[top : top + ph, left : left + pw] = patch
+            placements.append((top, left))
+            dfs(step + 1)
+            placements.pop()
