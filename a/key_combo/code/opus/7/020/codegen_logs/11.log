+            left = random.randint(0, w - pw)
+            rs = slice(max(0, top - 1), min(h, top + ph + 1))
+            cs = slice(max(0, left - 1), min(w, left + pw + 1))
+            if occ[rs, cs].any():
+                continue
+            occ[top : top + ph, left : left + pw] = True
+            placements.append((top, left))
+            placed = True
+            break
