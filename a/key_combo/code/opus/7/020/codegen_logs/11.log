+    elif corner == "TR":
+        rect_bbox = (1, gw - rw - 1, rh, gw - 2)
+    elif corner == "BL":
+        rect_bbox = (gh - rh - 1, 1, gh - 2, rw)
+    else:
+        rect_bbox = (gh - rh - 1, gw - rw - 1, gh - 2, gw - 2)
