+    r0, c0, r1, c1 = rect_bbox
+    tr = (r0 + r1) // 2
+    tc = (c0 + c1) // 2
+    path = _row_first_path((sr, sc), (tr, tc))
+    blocked = sum((cell in obstacles) for cell in path)
+    dist = abs(sr - tr) + abs(sc - tc)
+    return int(blocked), int(dist)
