+        "target_order": template["target_order"],
+        "swap_pair": template["swap_pair"],
+        "assembled": assembled,
+        "rect_bbox": rect_bbox,
+        "corner": corner,
+    }
+    if not _validate_semantics(inp, expected, meta):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
