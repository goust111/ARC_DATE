+        if (
+            GREY in colors
+            and colors <= {GREY, TEAL}
+            and h % MACRO_SIZE == 0
+            and w % MACRO_SIZE == 0
+            and h >= 2 * MACRO_SIZE
+            and w >= 2 * MACRO_SIZE
+            and int(comp["area"]) == h * w
