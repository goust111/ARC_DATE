    n = 0
    rr, cc = r + dr, c + dc
    while in_bounds(g.shape, rr, cc) and int(g[rr, cc]) == Color.BLUE:
        n += 1
        rr += dr
        cc += dc
    return n


def _gen_path_from(start, dr, dc, dist):
    sr, sc = start
    path = [(sr + dr * i, sc + dc * i) for i in range(1, dist)]
