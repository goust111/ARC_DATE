+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _side_step(col: int, width: int) -> int:
+    return -1 if col <= (width - 1 - col) else 1
+
+
+def _trace_rays(grid: np.ndarray, *, return_info: bool = False):
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    h, w = out.shape
+
+    sources = [(c, int(out[0, c])) for c in range(w) if int(out[0, c]) in SOURCE_COLORS]
+    sources.sort()
+
+    infos: list[dict] = []
+    for c0, color in sources:
+        r = 0
+        c = c0
+        path = [(0, c0)]
+        deflections = 0
+        terminated = False
+        while r < h - 1:
+            if int(out[r + 1, c]) == BLACK:
+                r += 1
+                out[r, c] = color
+                path.append((r, c))
+                continue
+
+            dc = _side_step(c, w)
+            nc = c + dc
+            if 0 <= nc < w and int(out[r, nc]) == BLACK:
+                c = nc
+                out[r, c] = color
+                path.append((r, c))
+                deflections += 1
+            else:
+                terminated = True
+                break
+
+        infos.append(
+            {
+                "color": color,
+                "source_col": c0,
+                "path": path,
+                "deflections": deflections,
+                "terminated": terminated,
+            }
+        )
+
+    if return_info:
+        return out, infos
+    return out
+
+
+def _ray_mask(grid: np.ndarray) -> np.ndarray:
+    return (grid != BLACK) & (grid != GREY)
+
+
+def _nearest_ray_left(ray_grid: np.ndarray, r: int, c: int):
+    for cc in range(c - 1, -1, -1):
+        color = int(ray_grid[r, cc])
+        if color != BLACK and color != GREY:
+            return cc, color
+    return None
+
+
+def _nearest_ray_right(ray_grid: np.ndarray, r: int, c: int):
+    w = ray_grid.shape[1]
+    for cc in range(c + 1, w):
+        color = int(ray_grid[r, cc])
+        if color != BLACK and color != GREY:
+            return cc, color
+    return None
+
+
+def _region_owner(comp: np.ndarray, ray_grid: np.ndarray) -> int:
+    left_col = int(comp[:, 1].min())
