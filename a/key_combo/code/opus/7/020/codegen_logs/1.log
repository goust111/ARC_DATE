+    protected.update((0, c) for c in source_cols)
+
+    target_obstacles = rng.randint(5, 8)
+    if not _place_extra_obstacles(
+        rng,
+        grid,
+        target_obstacles,
+        used_rows,
+        protected,
+        set(source_cols),
