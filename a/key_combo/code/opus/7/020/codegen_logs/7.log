# Wall graph growth limits.
MARKER_COUNT_MIN = 9
MARKER_COUNT_MAX = 17
SPUR_MARKER_EXTRA_MAX = 6
SEGMENT_COUNT_MIN = 8
SEGMENT_COUNT_MAX = 18
SPUR_DISTANCE_MIN = 3
SPUR_DISTANCE_MAX = 12
