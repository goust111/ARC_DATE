+ROTATION_K_BY_CORNER_COUNT = {0: 0, 1: 3, 2: 2, 3: 1, 4: 0}
+CORNER_COORDS = ((0, 0), (0, 2), (2, 0), (2, 2))
+MAX_GENERATION_ATTEMPTS = 300
+ROW_RANGE = (15, 21)
+COL_RANGE = (15, 21)
+SLOT_STEP = 5
+COUNT_TEMPLATE_FAMILIES = [
+    (0, 1, 2),
+    (1, 2, 3),
+    (0, 2, 3),
+    (0, 1, 2, 3),
+    (0, 1, 3, 2, 1),
+    (0, 2, 3, 1, 2),
+    (3, 1, 2, 0),
