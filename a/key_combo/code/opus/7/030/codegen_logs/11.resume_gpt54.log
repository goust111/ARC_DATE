+    base = list(OBJECT_COLORS)
+    random.shuffle(base)
+    colors = base[: min(object_count, len(base))]
+    while len(colors) < object_count:
+        colors.append(random.choice(OBJECT_COLORS))
+    random.shuffle(colors)
+    return colors
