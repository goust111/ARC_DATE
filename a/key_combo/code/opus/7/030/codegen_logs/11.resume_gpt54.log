+                    "color": color,
+                    "coords": coords,
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+    return components
+
+
+def _corner_count(mask: np.ndarray) -> int:
+    return sum(int(mask[r, c]) for r, c in CORNER_COORDS)
+
