  "transform": "count mask pixels on the four corners and replace the grid with the corresponding 1x1 class label: 0 corners -> 6, 1 -> 1, 2 -> 3, 4 -> 2",
  "grid_shape": "1x1 label cell"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 3x3 input, 1x1 output
  colors:
    background: always 0
    mask: any non-zero color (1-9), count exactly 5
    background_count: exactly 4
  mask_pattern:
    total_pixels: exactly 5 of 9 cells
    corner_occupancy: number of mask pixels at corners (0,0),(0,2),(2,0),(2,2)
    allowed_corner_counts: 0, 1, 2, or 4 only (never 3)
    valid_patterns: 1 for cc=0, 20 for cc=1, 60 for cc=2, 5 for cc=4
  output_label:
    mapping: 0 corners -> 6, 1 corner -> 1, 2 corners -> 3, 4 corners -> 2
    format: single 1x1 cell containing the label value
  task_pedagogy: |
    examples are paired to show same pattern with different mask colors
    producing the same output, teaching color-irrelevance [observed]

generation_strategy:
  approach: direct construction (tiny search space, no inversion needed)
  steps:
    1. Pick a corner_count from {0, 1, 2, 4} (uniform or weighted).
    2. Enumerate all 3x3 binary patterns with exactly 5 ones and that many
       corner cells occupied; pick one uniformly at random.
    3. Pick a mask color from 1-9.
    4. Fill mask cells with mask_color, rest with 0.
    5. Output is [[mapping[corner_count]]].
```
</generation_spec>
