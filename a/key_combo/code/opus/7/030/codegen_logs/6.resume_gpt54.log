+        overlap_neighbors[color_b].add(color_a)
+        r0, c0, r1, c1 = inter
+        visible = {
+            int(v)
+            for v in np.unique(grid[r0 : r1 + 1, c0 : c1 + 1])
+            if int(v) in (color_a, color_b)
+        }
+        assert len(visible) <= 1, "a pairwise overlap must reveal at most one visible layer"
+        if not visible:
+            continue
