+        height = random.randint(*SPRITE_H_RANGE)
+        width = random.randint(*SPRITE_W_RANGE)
+        specs.append(
+            {
+                "color": int(color),
+                "h": int(height),
+                "w": int(width),
+                "left_rows": _sample_edge_rows(height),
+                "right_rows": _sample_edge_rows(height),
+            }
+        )
+    return specs
+
+
+def _sample_chain_positions(specs: list[dict]) -> list[tuple[int, int]]:
+    positions = [(0, 0)]
+    for prev, curr in zip(specs, specs[1:]):
+        ih = random.randint(1, min(int(prev["h"]) - 2, int(curr["h"]) - 2))
+        iw = random.randint(1, min(int(prev["w"]) - 2, int(curr["w"]) - 2))
+
+        prev_rr = random.randint(1, int(prev["h"]) - 1 - ih)
+        prev_cc = random.randint(1, int(prev["w"]) - 1 - iw)
+        curr_rr = random.randint(1, int(curr["h"]) - 1 - ih)
+        curr_cc = random.randint(1, int(curr["w"]) - 1 - iw)
+
