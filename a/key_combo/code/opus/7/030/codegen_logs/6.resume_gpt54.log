+            or inter[2] >= bbox_a[2]
+            or inter[1] <= bbox_a[1]
+            or inter[3] >= bbox_a[3]
+            or inter[0] <= bbox_b[0]
+            or inter[2] >= bbox_b[2]
+            or inter[1] <= bbox_b[1]
+            or inter[3] >= bbox_b[3]
