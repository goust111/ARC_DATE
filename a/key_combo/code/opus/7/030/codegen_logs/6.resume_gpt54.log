+    grid_h = random.randint(max(GRID_H_RANGE[0], need_h), GRID_H_RANGE[1])
+    grid_w = random.randint(max(GRID_W_RANGE[0], need_w), GRID_W_RANGE[1])
+    pad_r = random.randint(0, grid_h - need_h)
+    pad_c = random.randint(0, grid_w - need_w)
