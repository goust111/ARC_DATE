+def _all_overlaps_are_interior(bboxes: list[tuple[int, int, int, int]]) -> bool:
+    for bbox_a, bbox_b in itertools.combinations(bboxes, 2):
+        inter = _intersect_bbox(bbox_a, bbox_b)
+        if inter is None:
+            continue
+        if (
+            inter[0] <= bbox_a[0]
+            or inter[2] >= bbox_a[2]
+            or inter[1] <= bbox_a[1]
+            or inter[3] >= bbox_a[3]
+            or inter[0] <= bbox_b[0]
+            or inter[2] >= bbox_b[2]
+            or inter[1] <= bbox_b[1]
+            or inter[3] >= bbox_b[3]
