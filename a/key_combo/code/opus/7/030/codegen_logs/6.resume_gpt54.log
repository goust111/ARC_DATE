+PLACEMENT_ATTEMPTS = 80
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (16, 24)
+SPRITE_H_RANGE = (4, 6)
+SPRITE_W_RANGE = (3, 5)
+EXTRA_MARKER_PROB = 0.35
+
+
+def _sample_edge_rows(height: int) -> list[int]:
+    rows = {random.randrange(height)}
+    if height >= 5 and random.random() < EXTRA_MARKER_PROB:
+        rows.add(random.randrange(height))
+    return sorted(rows)
