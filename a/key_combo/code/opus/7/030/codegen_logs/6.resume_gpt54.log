+    need_h = max(r + int(spec["h"]) for (r, _c), spec in zip(shifted, specs))
+    need_w = max(c + int(spec["w"]) for (_r, c), spec in zip(shifted, specs))
+    if need_h > GRID_H_RANGE[1] or need_w > GRID_W_RANGE[1]:
+        return None
