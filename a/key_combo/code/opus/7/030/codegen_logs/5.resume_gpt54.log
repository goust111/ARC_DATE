    safe = _gen_safe_rows(region, split_type)
    if safe is None:
        return None
    row_budget = safe[1] - safe[0] + 1 - _GEN_MIN_ROW_GAP * (count - 1)
    if row_budget < count * _GEN_MIN_RECT_HEIGHT:
        return None

    rects = []
    for i in range(count):
