+            return None
+        dist = int(rng.integers(2, min(6, ar) + 1))
+        v_marker = (ar - dist, v_col)
+        v_endpoint = (ar - 1, v_col)
+    v_path = _line_cells(v_marker[0], v_marker[1], v_endpoint[0], v_endpoint[1])
