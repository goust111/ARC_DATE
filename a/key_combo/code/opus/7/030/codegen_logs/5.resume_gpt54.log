  "path": "straight horizontal or vertical segment from each aligned marker along the shared row/column to the cell adjacent to the anchor",
  "dst": "nearest side of the 2x2 anchor square",
  "trajectory": "paint every background pixel on the segment with the marker color",
  "transform": "keep the anchor square and all original marker pixels unchanged; ignore unaligned markers"
}
</annotation>
