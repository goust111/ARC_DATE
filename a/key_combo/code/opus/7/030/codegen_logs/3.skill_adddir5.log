spec:
  grid: 12x12 [observed]
  background: BLACK (0), always most common non-grey color on border
  placeholder: GREY (5)
  control_column: column 0; every row with grey pixels has exactly one non-bg non-grey color at col 0
  control_colors: 2-3 distinct colors (not BLACK, not GREY), each used 3-7 times in col 0
  row_types:
    control_row: col 0 = control color, remaining cells are bg or grey; 11-12 rows per grid
    bg_row: entire row is BLACK; 0-1 rows, at the top [observed]
  grey_shape:
    connected_components: 2-3 (4-connected)
    composition: union of 2-5 axis-aligned rectangles (each 1-4 rows x 2-8 cols)
    rectangles are 4-adjacent (share edge) forming connected irregular shapes
    some components are single rectangles, others are L/T-shaped unions
