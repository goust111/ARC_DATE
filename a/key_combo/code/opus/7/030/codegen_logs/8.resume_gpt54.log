+    for i, row in enumerate(anchors):
+        start = 0 if i == 0 else (int(anchors[i - 1]) + int(row)) // 2 + 1
+        end = height - 1 if i == len(anchors) - 1 else (int(row) + int(anchors[i + 1])) // 2
+        bounds.append((int(start), int(end)))
+    return bounds
+
