+
+
+BG = 0
+FG = 5
+HOLE_TO_COLOR = {1: 1, 2: 2, 3: 3}
+
+GEN_HEIGHT_RANGE = (18, 30)
+GEN_WIDTH_RANGE = (13, 18)
+GEN_ATTEMPTS = 500
+GEN_COUNTS = (1, 2, 3)
+GEN_HOLE_MARGIN = 2
+GEN_OBJECT_HEIGHT_RANGE = (5, 8)
+GEN_OBJECT_WIDTH_RANGE = (6, 8)
