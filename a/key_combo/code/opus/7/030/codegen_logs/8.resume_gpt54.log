+    comps = _components(padded_bg)
+    count = 0
+    for comp in comps:
+        if any(int(r) in (0, padded_bg.shape[0] - 1) or int(c) in (0, padded_bg.shape[1] - 1) for r, c in comp):
+            continue
+        count += 1
+    return count
