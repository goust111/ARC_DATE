            for a in range(TWO_COMPONENT_WIDTH_MIN, TWO_COMPONENT_WIDTH_MAX + 1)
            for b in range(TWO_COMPONENT_WIDTH_MIN, TWO_COMPONENT_WIDTH_MAX + 1)
            if a + b + COMPONENT_GAP <= usable
