def _gen_attach_rect(
    mask: np.ndarray,
    base: tuple[int, int],
    band: tuple[int, int],
    active_start: int,
    active_end: int,
    min_width: int = MIN_RECT_WIDTH,
) -> tuple[int, int, int, int] | None:
    row0, row1 = base
    choices = []
    if row0 > active_start:
        choices.append("up")
    if row1 < active_end:
        choices.append("down")
    if not choices:
        return None

