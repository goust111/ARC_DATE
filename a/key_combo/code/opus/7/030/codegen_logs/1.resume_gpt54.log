+        final_head = positions[-1]
+        final_shift_r = int(np.argwhere(grid == BLUE)[0][0]) - (positions[0][0] + offsets[0][0])
+        final_shift_c = int(np.argwhere(grid == BLUE)[0][1]) - (positions[0][1] + offsets[0][1])
