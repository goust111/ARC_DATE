+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+DIRS = {
+    "U": (-1, 0),
+    "R": (0, 1),
+    "D": (1, 0),
+    "L": (0, -1),
+}
+
+BASE_TEMPLATES = {
+    "hook3": [(0, 0), (1, 0), (1, 1)],
+    "tee4": [(0, 0), (1, -1), (1, 0), (1, 1)],
+    "arrow5": [(0, 0), (1, -1), (1, 0), (1, 1), (2, 0)],
+}
+
+GEN_ATTEMPTS = 500
