+        border_coords = hole["border"]
+        mode = ROTATION_TO_BORDER[rotation_k]
+        if mode == "object":
+            out[border_coords[:, 0], border_coords[:, 1]] = color
+        elif mode == "erase":
+            out[border_coords[:, 0], border_coords[:, 1]] = BACKGROUND
+        elif mode == "separator":
