    g, block_tops = _gen_render_grid(n, random.choice(box_sets))
    if not _gen_has_long_ray(g, block_tops) or not _gen_passes_oracle(g):
        return None

    return g

def generate_input() -> np.ndarray:
    for _ in range(_GEN_MAX_ATTEMPTS):
        g = _gen_attempt()
        if g is not None:
