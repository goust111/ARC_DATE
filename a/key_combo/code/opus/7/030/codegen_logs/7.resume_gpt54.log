    if count == 0:
        return [()] if total == 0 else []
    out = []
    for value in range(low, high + 1):
        rest = total - value
        if low * (count - 1) <= rest <= high * (count - 1):
            for tail in _gen_compositions(count - 1, rest, low, high):
                out.append((value,) + tail)
    return out


