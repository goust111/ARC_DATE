+        out[r0 - 1, c0 : c1 + 1] = frame_color
+        out[r1 + 1, c0 : c1 + 1] = frame_color
+        out[r0 : r1 + 1, c0 - 1] = frame_color
+        out[r0 : r1 + 1, c1 + 1] = frame_color
+        out[r0 - 1, c0 - 1] = bg
+        out[r0 - 1, c1 + 1] = bg
+        out[r1 + 1, c0 - 1] = bg
+        out[r1 + 1, c1 + 1] = bg
