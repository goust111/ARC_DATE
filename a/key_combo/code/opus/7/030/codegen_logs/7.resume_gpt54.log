+            return False
+
+    delta = int(np.count_nonzero(out != grid))
+    expected = sum(2 * ((s["bbox"][2] - s["bbox"][0] + 1) + (s["bbox"][3] - s["bbox"][1] + 1)) + 4 for s in structures)
+    return delta == expected
+
