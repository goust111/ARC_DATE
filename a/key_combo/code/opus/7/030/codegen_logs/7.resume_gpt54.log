+
+            r0 = random.randint(1, height - frame_h - 1)
+            c0 = random.randint(1, width - frame_w - 1)
+            bbox = (r0, c0, r0 + frame_h - 1, c0 + frame_w - 1)
+            output_box = (r0 - 1, c0 - 1, r0 + frame_h, c0 + frame_w)
