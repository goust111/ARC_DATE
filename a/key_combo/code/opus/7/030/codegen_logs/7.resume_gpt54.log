+        return None
+
+    shape = random.choice(feasible)
+    shape_h, shape_w = _shape_size(shape)
+    r_off = random.randint(1, frame_h - shape_h - 1)
+    c_off = random.randint(1, frame_w - shape_w - 1)
+    return [(r_off + r, c_off + c) for r, c in shape]
