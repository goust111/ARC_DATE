+    if r1 + 1 < h:
+        out[r1 + 1, c0 : c1 + 1] = color
+    if c0 > 0:
+        out[r0 : r1 + 1, c0 - 1] = color
+    if c1 + 1 < w:
+        out[r0 : r1 + 1, c1 + 1] = color
+
