        inp[r0 : r0 + h, in_c0 : in_c0 + w] = _GEN_RED
    return True


def _gen_matches_oracle(inp: np.ndarray, out: np.ndarray) -> bool:
    try:
        solved = main(inp)
    except AssertionError:
