+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+MAX_GENERATION_ATTEMPTS = 500
+GRID_ROWS_RANGE = (13, 18)
