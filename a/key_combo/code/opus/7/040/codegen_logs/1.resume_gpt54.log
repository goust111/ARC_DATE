+        grid[sep, :] = GREY
+
+        top_margin = random.randint(1, top_height - template_h)
+        left_margin = random.randint(1, width - template_w - 1)
+        grid[top_margin : top_margin + template_h, left_margin : left_margin + template_w] = template
