+def _expected_output(grid: np.ndarray) -> np.ndarray:
+    sep = grid.shape[0] // 2
+    top = grid[:sep]
+    bottom = grid[sep + 1 :]
+    out = np.zeros_like(top, dtype=int)
+    out[(top == BLUE) | (bottom == RED)] = GREEN
+    return out
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    top_target: int,
+    bottom_target: int,
+    paired_rects: list[tuple[dict, dict, str]],
