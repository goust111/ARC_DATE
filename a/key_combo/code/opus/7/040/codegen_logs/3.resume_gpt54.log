+def _frame_area(rect: dict) -> int:
+    return int((rect["h"] - 2) * (rect["w"] - 2))
+
+
+def _border_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((int(h), int(w)), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
