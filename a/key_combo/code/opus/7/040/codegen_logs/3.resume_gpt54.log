+        used_areas.add(int(extra_top["area"]))
+        top_frames.append(extra_top)
+
+    if bottom_target == 3:
+        extra_bottom = _place_extra_frame(panel_h, panel_w, bottom_frames, top_frames, used_areas)
+        if extra_bottom is None:
