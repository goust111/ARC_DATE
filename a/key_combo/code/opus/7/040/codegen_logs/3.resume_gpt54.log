+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+GENERATION_RETRIES = 500
+PAIR_RETRIES = 300
+EXTRA_RETRIES = 400
