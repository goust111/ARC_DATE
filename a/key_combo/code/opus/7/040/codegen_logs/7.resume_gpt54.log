        target = (tr, tc, tr + height - 1, tc + width - 1)
        if not _gen_boxes_overlap(source, target):
            target_tops.append((tr, tc))
    tr, tc = target_tops[int(rng.integers(len(target_tops)))]
    return source, (tr, tc, tr + height - 1, tc + width - 1)


