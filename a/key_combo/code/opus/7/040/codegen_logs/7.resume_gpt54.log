+def _sample_distinct_base_shapes(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    first = None
+    for _ in range(60):
+        first = _random_connected_shape(rng)
+        if first is not None:
+            break
+    if first is None:
+        return None
