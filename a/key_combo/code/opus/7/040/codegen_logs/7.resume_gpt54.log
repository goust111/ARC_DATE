    p0 = float(rng.uniform(*_GEN_EMPTY_PROB_RANGE))
    lo = max(_GEN_NOISE_PROB_MIN, 1.0 - p0 - _GEN_NOISE_PROB_MAX)
    hi = min(_GEN_NOISE_PROB_MAX, 1.0 - p0 - _GEN_NOISE_PROB_MIN)
    p1 = float(rng.uniform(lo, hi))
