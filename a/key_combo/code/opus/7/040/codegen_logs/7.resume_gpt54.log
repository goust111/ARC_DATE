+    assert h == w and h % 2 == 0, "expected a square grid split into four equal quadrants"
+
+    side = h // 2
+    assert side > 0
+
+    regions = [
+        g[0:side, 0:side],
+        g[0:side, side:],
+        g[side:, 0:side],
+        g[side:, side:],
+    ]
