+    safe = _erode8(interior)
+    sh, sw = sprite.shape
+    candidates = []
+    h, w = grid.shape
+    for r0 in range(h - sh + 1):
+        for c0 in range(w - sw + 1):
+            bbox_ok = True
+            for dr in range(sh):
+                for dc in range(sw):
+                    if not interior[r0 + dr, c0 + dc]:
+                        bbox_ok = False
+                        break
+                if not bbox_ok:
+                    break
+            if not bbox_ok:
+                continue
+            sprite_ok = True
+            for dr in range(sh):
+                for dc in range(sw):
+                    if sprite[dr, dc] and not safe[r0 + dr, c0 + dc]:
