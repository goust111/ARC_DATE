+    blue_mask = grid == SPRITE
+    if len(_components(blue_mask, connectivity=4)) != 1:
+        return None
+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return None
+    if not np.any(out == SPRITE):
+        return None
+    if not np.any(out == MARKER):
+        return None
+    return grid
