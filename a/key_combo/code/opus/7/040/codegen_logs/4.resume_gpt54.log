+            if not frontier:
+                break
+            chosen = rng.choice(frontier)
+            mask[chosen] = True
+            cells.append(chosen)
+
+        coords = [(r, c) for r in range(h) for c in range(w) if mask[r, c]]
+        if len(coords) != area:
+            continue
+        r0, c0, r1, c1 = _bbox(coords)
+        cropped = mask[r0 : r1 + 1, c0 : c1 + 1]
+        if cropped.all():
