+
+    top = rng.randint(2, h - ih - 3)
+    left = rng.randint(2, w - iw - 3)
+    grid = np.zeros((h, w), dtype=int)
+    interior = np.zeros((h, w), dtype=bool)
+    interior[top : top + ih, left : left + iw] = local_interior
+    contour = _build_contour(interior)
