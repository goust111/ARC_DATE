+        return None
+    if not np.any(out == MARKER):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt(random)
+        if grid is not None:
+            return grid
