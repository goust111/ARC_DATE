+    base = _parse_patch(lines)
+    variants: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, ...], ...]] = set()
+    for k in range(4):
+        rot = np.rot90(base, k)
+        for variant in (rot, np.fliplr(rot)):
+            key = tuple(tuple(int(v) for v in row) for row in variant)
