+        r0 = lower_row + int(rng.integers(0, 2))
+        c0 = int(rng.integers(1, 4))
+        pos["ll"] = (r0, c0, r0 + h - 1, c0 + w - 1)
+    if "lr" in sizes:
+        h, w = sizes["lr"]
+        r0 = lower_row + int(rng.integers(0, 2))
+        c0 = right_col + int(rng.integers(0, 3))
+        pos["lr"] = (r0, c0, r0 + h - 1, c0 + w - 1)
+    return pos
