+        "left": ((0, -1), lambda n: [(n["r0"], n["c0"] - 1), (n["r1"], n["c0"] - 1)]),
+        "right": ((0, 1), lambda n: [(n["r0"], n["c1"] + 1), (n["r1"], n["c1"] + 1)]),
