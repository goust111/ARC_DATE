+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 600
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(coords)
+    return parts
+
+
+def _find_nodes(grid: np.ndarray) -> list[dict]:
+    nodes: list[dict] = []
+    for coords in _components(grid == BLUE):
+        rows = [r for r, _ in coords]
+        cols = [c for _, c in coords]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        if len(coords) != 4 or r1 - r0 != 1 or c1 - c0 != 1:
+            continue
+        nodes.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "pixels": [(r0, c0), (r0, c1), (r1, c0), (r1, c1)],
+            }
+        )
+    nodes.sort(key=lambda node: (node["r0"], node["c0"]))
+    for idx, node in enumerate(nodes):
+        node["id"] = idx
+    return nodes
+
+
+def _trace_track(
+    grid: np.ndarray,
+    node_at: np.ndarray,
+    start_node: int,
+    starter: tuple[int, int],
+    direction: tuple[int, int],
+) -> tuple[int, list[tuple[int, int]]] | None:
+    dr, dc = direction
+    r, c = starter
+    pixels: list[tuple[int, int]] = []
+    while _in_bounds(grid.shape, r, c) and grid[r, c] == RED:
+        if node_at[r, c] >= 0:
+            return None
+        pixels.append((r, c))
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(grid.shape, nr, nc):
+            return None
+        if node_at[nr, nc] >= 0:
+            end_node = int(node_at[nr, nc])
+            if end_node == start_node:
+                return None
+            return end_node, pixels
+        r, c = nr, nc
+    return None
+
+
+def _analyze_graph(grid: np.ndarray) -> tuple[list[dict], list[dict], dict[int, int]]:
+    g = np.asarray(grid, dtype=int)
