+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+ORANGE = 7
+GREY = 5
+PALETTE = np.array([2, 4, 8, 9], dtype=int)
+
+FRAME_COLOR_POOL = [1, 3, 6, 8]
+GRID_HEIGHT_RANGE = (18, 25)
+GRID_WIDTH_RANGE = (18, 25)
+FRAME_COUNT_CHOICES = [2, 2, 3, 3, 4]
+FRAME_HEIGHT_RANGE = (5, 9)
+FRAME_WIDTH_RANGE = (5, 10)
+DISTRACTOR_COUNT_RANGE = (3, 8)
+GENERATION_RETRIES = 600
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _colors_present(grid: np.ndarray, exclude: set[int] | None = None) -> list[int]:
+    colors = set(map(int, np.unique(grid)))
+    if exclude is not None:
+        colors -= set(exclude)
+    return sorted(colors)
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rect_border_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    mask = np.zeros(shape, dtype=bool)
+    mask[r0 : r1 + 1, c0] = True
+    mask[r0 : r1 + 1, c1] = True
+    mask[r0, c0 : c1 + 1] = True
+    mask[r1, c0 : c1 + 1] = True
+    return mask
+
+
+def _box_border_cells(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells = set()
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    return cells
+
+
+def _box_interior_cells(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    return {(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)}
+
+
+def _point_in_strict_interior(box: tuple[int, int, int, int], r: int, c: int) -> bool:
+    r0, c0, r1, c1 = box
+    return r0 < r < r1 and c0 < c < c1
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    frames = []
+
+    for color in _colors_present(g, exclude={bg}):
+        color_mask = g == color
+        box = _bbox(color_mask)
+        if box is None:
+            continue
+        r0, c0, r1, c1 = box
+        if r1 - r0 < 2 or c1 - c0 < 2:
+            continue
+
+        border = _rect_border_mask(g.shape, box)
+        if not np.array_equal(color_mask, border):
+            continue
+
+        markers = [
+            (rr, cc)
+            for rr, cc in np.argwhere(g == ORANGE)
+            if _point_in_strict_interior(box, int(rr), int(cc))
+        ]
+        assert len(markers) == 1, "each frame must contain exactly one orange marker"
+        marker = tuple(map(int, markers[0]))
+
+        frames.append(
+            {
+                "color": int(color),
+                "box": box,
+                "border": border,
+                "border_cells": _box_border_cells(box),
+                "interior_cells": _box_interior_cells(box),
+                "marker": marker,
+            }
+        )
+
+    frames.sort(key=lambda frame: frame["color"])
+    assert 2 <= len(frames) <= 4, "expected 2 to 4 rectangular frames"
+    return frames
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Color each frame interior with marker-centered Manhattan rings, resolving overlaps by the nearest frame marker.
+
+    Input structure:
+    - A black background contains 2 to 4 complete one-pixel-thick hollow rectangular frames in distinct colors.
+    - Each frame has exactly one orange marker strictly inside it, and some frame interiors overlap.
+    - Grey singleton pixels may appear outside every frame interior as distractors.
+
+    Rule:
+    - Keep every frame border pixel unchanged.
+    - For each non-border pixel that lies inside one or more frame interiors, compute its Manhattan distance to each containing frame's orange marker.
+    - Use the smallest such distance to index the cyclic palette red, yellow, teal, maroon; if distances tie, prefer the smaller frame color id.
+    - Recolor marker pixels as distance 0, and leave all pixels outside every frame interior unchanged.
+
+    Key insight:
+    - Each rectangle is both an object and the domain boundary of its own distance field, so overlapping interiors create a bounded multi-source Voronoi competition instead of a full-grid ring pattern.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    frames = _find_frames(g)
+    out = g.copy()
+
+    border_union = np.zeros_like(g, dtype=bool)
+    for frame in frames:
+        border_union |= frame["border"]
+
+    H, W = g.shape
+    for r in range(H):
+        for c in range(W):
+            if border_union[r, c]:
+                continue
+
+            contenders = []
+            for frame in frames:
+                if _point_in_strict_interior(frame["box"], r, c):
+                    mr, mc = frame["marker"]
+                    dist = abs(r - mr) + abs(c - mc)
+                    contenders.append((int(dist), int(frame["color"])))
+
+            if not contenders:
+                continue
+
+            best_dist, _best_color = min(contenders)
+            out[r, c] = int(PALETTE[best_dist % len(PALETTE)])
+
+    return out
+
+
+def _overlap_box(
+    box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]
+) -> tuple[int, int, int, int] | None:
+    ar0, ac0, ar1, ac1 = box_a
+    br0, bc0, br1, bc1 = box_b
+    r0 = max(ar0 + 1, br0 + 1)
+    c0 = max(ac0 + 1, bc0 + 1)
+    r1 = min(ar1 - 1, br1 - 1)
+    c1 = min(ac1 - 1, bc1 - 1)
+    if r0 > r1 or c0 > c1:
+        return None
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _make_overlapping_pair(
+    H: int, W: int
+) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:
+    h1 = random.randint(*FRAME_HEIGHT_RANGE)
+    w1 = random.randint(*FRAME_WIDTH_RANGE)
+    h2 = random.randint(*FRAME_HEIGHT_RANGE)
+    w2 = random.randint(*FRAME_WIDTH_RANGE)
+    ih1, iw1 = h1 - 2, w1 - 2
+    ih2, iw2 = h2 - 2, w2 - 2
+    if min(ih1, iw1, ih2, iw2) < 3:
+        return None
+
+    max_overlap_h = min(ih1, ih2) - 1
+    max_overlap_w = min(iw1, iw2) - 1
+    if max_overlap_h < 1 or max_overlap_w < 1:
+        return None
+
+    overlap_h = random.randint(1, min(4, max_overlap_h))
+    overlap_w = random.randint(1, min(4, max_overlap_w))
+    vertical = random.choice(["above", "below"])
+    horizontal = random.choice(["left", "right"])
+
+    dr = overlap_h - h2 + 2 if vertical == "above" else h1 - overlap_h - 2
+    dc = overlap_w - w2 + 2 if horizontal == "left" else w1 - overlap_w - 2
+
+    r0_min = max(0, -dr)
+    r0_max = min(H - h1, H - h2 - dr)
+    c0_min = max(0, -dc)
+    c0_max = min(W - w1, W - w2 - dc)
+    if r0_min > r0_max or c0_min > c0_max:
+        return None
+
+    a_r0 = random.randint(r0_min, r0_max)
+    a_c0 = random.randint(c0_min, c0_max)
+    b_r0 = a_r0 + dr
+    b_c0 = a_c0 + dc
+
+    box_a = (a_r0, a_c0, a_r0 + h1 - 1, a_c0 + w1 - 1)
+    box_b = (b_r0, b_c0, b_r0 + h2 - 1, b_c0 + w2 - 1)
+    if _overlap_box(box_a, box_b) is None:
+        return None
+    if _box_border_cells(box_a) & _box_border_cells(box_b):
+        return None
+    return box_a, box_b
+
+
+def _random_box(H: int, W: int) -> tuple[int, int, int, int]:
+    h = random.randint(*FRAME_HEIGHT_RANGE)
+    w = random.randint(*FRAME_WIDTH_RANGE)
+    r0 = random.randint(0, H - h)
+    c0 = random.randint(0, W - w)
+    return (r0, c0, r0 + h - 1, c0 + w - 1)
+
+
+def _markers_available(rects: list[dict]) -> list[list[tuple[int, int]]]:
+    border_union = set().union(*(rect["border_cells"] for rect in rects))
+    interiors = [rect["interior_cells"] for rect in rects]
+    available = []
+    for i, rect in enumerate(rects):
+        others = set().union(*(interiors[j] for j in range(len(rects)) if j != i))
+        cells = sorted(rect["interior_cells"] - others - border_union)
+        if not cells:
+            return []
+        available.append(cells)
+    return available
+
+
+def _overlap_cells(rects: list[dict]) -> set[tuple[int, int]]:
+    counts: Counter[tuple[int, int]] = Counter()
+    for rect in rects:
+        counts.update(rect["interior_cells"])
+    return {cell for cell, n in counts.items() if n >= 2}
+
+
+def _has_tied_overlap_assignment(rects: list[dict]) -> bool:
+    border_union = set().union(*(rect["border_cells"] for rect in rects))
+    for cell in _overlap_cells(rects):
+        if cell in border_union:
+            continue
+        distances = []
+        for rect in rects:
+            if cell in rect["interior_cells"]:
+                mr, mc = rect["marker"]
+                distances.append(abs(cell[0] - mr) + abs(cell[1] - mc))
+        if len(distances) >= 2 and min(distances) == sorted(distances)[1]:
+            return True
+    return False
+
+
+def _isolated_distractor_cells(
+    H: int,
+    W: int,
+    forbidden: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    cells = []
+    for r in range(H):
+        for c in range(W):
+            if (r, c) in forbidden or (r, c) in occupied:
+                continue
+            ok = True
+            for rr in range(max(0, r - 1), min(H, r + 2)):
+                for cc in range(max(0, c - 1), min(W, c + 2)):
+                    if (rr, cc) in occupied:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                cells.append((r, c))
+    return cells
+
+
+def _place_distractors(
+    grid: np.ndarray,
+    count: int,
+    forbidden: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+) -> bool:
+    H, W = grid.shape
+    for _ in range(count):
+        candidates = _isolated_distractor_cells(H, W, forbidden, occupied)
+        if not candidates:
+            return False
+        r, c = random.choice(candidates)
+        grid[r, c] = GREY
+        occupied.add((r, c))
+    return True
+
+
+def _build_candidate() -> np.ndarray | None:
+    H = random.randint(*GRID_HEIGHT_RANGE)
+    W = random.randint(*GRID_WIDTH_RANGE)
+    frame_count = random.choice(FRAME_COUNT_CHOICES)
+    frame_colors = random.sample(FRAME_COLOR_POOL, frame_count)
+
+    pair = _make_overlapping_pair(H, W)
+    if pair is None:
+        return None
+
+    boxes = [pair[0], pair[1]]
+    for _ in range(frame_count - 2):
+        added = False
+        for _try in range(80):
+            box = _random_box(H, W)
+            if any(_box_border_cells(box) & _box_border_cells(existing) for existing in boxes):
+                continue
+            test_boxes = boxes + [box]
+            rects = [
+                {
+                    "box": candidate,
+                    "border_cells": _box_border_cells(candidate),
+                    "interior_cells": _box_interior_cells(candidate),
+                }
+                for candidate in test_boxes
+            ]
+            if _markers_available(rects):
+                boxes.append(box)
+                added = True
+                break
+        if not added:
+            return None
+
+    rects = []
+    for color, box in zip(frame_colors, boxes):
+        rects.append(
+            {
+                "color": int(color),
+                "box": box,
+                "border_cells": _box_border_cells(box),
+                "interior_cells": _box_interior_cells(box),
+            }
+        )
+
+    if not _overlap_cells(rects):
+        return None
+
+    choices = _markers_available(rects)
+    if not choices:
+        return None
+
+    for rect, cells in zip(rects, choices):
+        rect["marker"] = random.choice(cells)
+
+    if _has_tied_overlap_assignment(rects):
+        return None
+
+    grid = np.full((H, W), BG, dtype=int)
+    occupied = set()
+    interior_union = set()
+    for rect in rects:
+        interior_union |= rect["interior_cells"]
+        r0, c0, r1, c1 = rect["box"]
+        color = rect["color"]
+        grid[r0 : r1 + 1, c0] = color
+        grid[r0 : r1 + 1, c1] = color
+        grid[r0, c0 : c1 + 1] = color
+        grid[r1, c0 : c1 + 1] = color
+        occupied |= rect["border_cells"]
+
+    for rect in rects:
+        mr, mc = rect["marker"]
+        grid[mr, mc] = ORANGE
+        occupied.add((mr, mc))
+
+    forbidden = interior_union | occupied
+    need = random.randint(*DISTRACTOR_COUNT_RANGE)
+    if not _place_distractors(grid, need, forbidden, occupied):
+        return None
+
+    if _get_bg(grid) != BG:
+        return None
+
+    try:
+        frames = _find_frames(grid)
+        out = main(grid)
+    except Exception:
+        return None
+
+    if len(frames) != frame_count:
+        return None
+    if out.shape != grid.shape:
+        return None
+    if np.array_equal(out, grid):
