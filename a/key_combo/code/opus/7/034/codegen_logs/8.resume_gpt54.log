+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+TEMPLATE_SIZE = 4
+LEGEND_SHAPE = (2, 1)
+PLACEMENT_PADDING = 2
+GENERATION_ATTEMPTS = 400
