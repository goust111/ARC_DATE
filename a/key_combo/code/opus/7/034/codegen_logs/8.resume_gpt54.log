+        if loc is None:
+            return None
+        r, c = loc
+        placed_rects.append((r, c, r + TEMPLATE_SIZE - 1, c + TEMPLATE_SIZE - 1))
+        object_positions.append((r, c))
+
+    random.shuffle(object_positions)
