+        if random.random() < 0.5:
+            full_mask = np.fliplr(full_mask)
+        if random.random() < 0.5:
+            full_mask = np.flipud(full_mask)
+
+        if not _is_connected(full_mask):
+            continue
+        if int(full_mask.sum()) < 4 or int((~full_mask).sum()) < 4:
