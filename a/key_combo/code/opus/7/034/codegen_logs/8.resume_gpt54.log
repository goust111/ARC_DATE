+    return GREEN, YELLOW
+
+
+def _find_partial_origins(grid: np.ndarray, support_mask: np.ndarray, template_origin: tuple[int, int]) -> list[tuple[int, int]]:
+    H, W = map(int, grid.shape)
+    partials: list[tuple[int, int]] = []
