+    positions: list[tuple[int, int]] = []
+    order = sorted(range(len(frame_patches)), key=lambda i: frame_patches[i].shape[0] * frame_patches[i].shape[1], reverse=True)
+    stack_cursor = 1
+    for idx in order:
