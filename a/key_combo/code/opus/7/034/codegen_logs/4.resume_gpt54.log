+    return adjacent, safe
+
+
+def _build_frame_specs(
+    key_colors: list[int],
+    final_counts: dict[int, int],
+    subtract_counts: dict[int, int],
+    include_exempt: bool,
+) -> list[dict] | None:
+    total_final = sum(final_counts.values())
+    total_sub = sum(subtract_counts.values())
