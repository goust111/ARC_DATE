+    return None
+
+
+def _frame_cell_sets(
+    inner_h: int,
+    inner_w: int,
+    exempt_positions: list[tuple[int, int]],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    exempt_set = set(exempt_positions)
+    adjacent: set[tuple[int, int]] = set()
+    for rr, cc in exempt_positions:
