def _gen_attempt():
    height = int(np.random.randint(*GRID_HEIGHT_RANGE))
    width = int(np.random.randint(*GRID_WIDTH_RANGE))
    inside_count = int(np.random.randint(*INSIDE_COUNT_RANGE))
    outside_count = int(np.random.randint(*OUTSIDE_COUNT_RANGE))
