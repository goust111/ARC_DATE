+
+
+def _pick_exempt_positions(inner_h: int, inner_w: int, count: int) -> list[tuple[int, int]] | None:
+    candidates = [
+        (r, c)
+        for r in range(inner_h)
+        for c in range(inner_w)
+        if (r, c) not in ((0, 0), (0, inner_w - 1), (inner_h - 1, 0), (inner_h - 1, inner_w - 1))
