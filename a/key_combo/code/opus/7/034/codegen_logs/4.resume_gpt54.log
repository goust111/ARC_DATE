    r = int(np.random.randint(MARKER_TOP_LEFT_MIN, h - MARKER_SIZE))
    c = int(np.random.randint(MARKER_TOP_LEFT_MIN, w - MARKER_SIZE))
    g[r : r + MARKER_SIZE, c : c + MARKER_SIZE] = Color.BLACK
    return g


