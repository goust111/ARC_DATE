+GRID_HEIGHT_RANGE = (12, 16)
+GRID_WIDTH_RANGE = (12, 16)
+STEP_LENGTH_MIN = 2
+STEP_LENGTH_MAX = 7
+GENERATION_ATTEMPTS = 500
+
+
+def _sign(x: int) -> int:
+    return (x > 0) - (x < 0)
+
+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
