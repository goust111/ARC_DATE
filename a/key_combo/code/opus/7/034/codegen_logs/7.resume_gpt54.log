+    side_r = r1 - r0 + 1
+    side_c = c1 - c0 + 1
+    if side_r != side_c or side_r < 2:
+        return None
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    color = int(patch[0, 0])
