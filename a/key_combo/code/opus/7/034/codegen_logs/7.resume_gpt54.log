+                direct_votes = 0
+                ok = True
+                for block in block_infos:
+                    dr = block["r0"] - base_r
+                    dc = block["c0"] - base_c
+                    if dr % step != 0 or dc % step != 0:
+                        ok = False
+                        break
+                    i = dr // step
