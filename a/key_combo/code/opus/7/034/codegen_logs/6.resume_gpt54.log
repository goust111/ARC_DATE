    (r + dr, c + dc)
    for r, c in _GEN_BRACKET_CELLS
    for dr, dc in _GEN_DIRS4
    if 0 <= r + dr < _GEN_H
    and 0 <= c + dc < _GEN_W
    and (r + dr, c + dc) in _GEN_SCATTER_SET
)


def _gen_neighbors4(cell: tuple[int, int]) -> list[tuple[int, int]]:
    r, c = cell
    return [
        (r + dr, c + dc)
        for dr, dc in _GEN_DIRS4
        if 0 <= r + dr < _GEN_H and 0 <= c + dc < _GEN_W
    ]


