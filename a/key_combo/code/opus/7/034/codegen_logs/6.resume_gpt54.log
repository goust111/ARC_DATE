+        boundary_row = r0 if dr > 0 else r1
+        return [(r, sc) for r in range(sr + dr, boundary_row, dr)]
+
+    dc = 1 if ec > sc else -1
+    boundary_col = c0 if dc > 0 else c1
+    return [(sr, c) for c in range(sc + dc, boundary_col, dc)]
