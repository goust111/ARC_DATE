+from __future__ import annotations
+
+import hashlib
+import random
+
+import numpy as np
+
+
+BG = 5
+CENTER = 2
+# The prompt names five colors, but 13x13 needs six distinct foreground colors.
+PALETTE = (1, 3, 4, 6, 7, 8)
+MAX_GENERATION_ATTEMPTS = 2000
+
+_SEEN_INPUT_SIGS: set[str] = set()
+_SEEN_OUTPUT_SIGS: set[str] = set()
+
+
