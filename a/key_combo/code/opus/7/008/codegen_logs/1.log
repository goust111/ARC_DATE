+                                    {
+                                        "orient": "H",
+                                        "boxes": (a, b),
+                                        "rect_cells": _box_cells(a) + _box_cells(b),
+                                        "gap_cells": _gap_cells(a, b, "H"),
+                                        "fill_cells": _half_fill_cells(a, b, "H"),
