+    if max_ur0 < 1:
+        return None
+    ur0 = random.randint(1, max_ur0)
+    ur1 = ur0 + h1 - 1
+
+    if direction == 1:
+        max_uc0 = w - w1 - delta - w2 - 1
+        if max_uc0 < 1:
+            return None
+        uc0 = random.randint(1, max_uc0)
+        uc1 = uc0 + w1 - 1
+        lr0 = ur1 + delta
+        lc0 = uc1 + delta
+        lower = (lr0, lc0, lr0 + h2 - 1, lc0 + w2 - 1)
+    else:
+        min_uc0 = delta + 1
+        max_uc0 = w - w1 - 1
+        if min_uc0 > max_uc0:
+            return None
+        uc0 = random.randint(min_uc0, max_uc0)
+        uc1 = uc0 + w1 - 1
+        lr0 = ur1 + delta
+        end_c = uc0 - delta
