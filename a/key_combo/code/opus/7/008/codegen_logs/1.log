+
+@functools.lru_cache(maxsize=None)
+def _diagonal_candidates_cached(h: int, w: int) -> tuple[dict, ...]:
+    out = []
+    for h1 in RECT_SIDES:
+        for w1 in RECT_SIDES:
+            for h2 in RECT_SIDES:
+                for w2 in RECT_SIDES:
