+            grid[r0 : r1 + 1, c0 : c1 + 1] = pair["color"]
+    return grid
+
+
+def _render_output_from_plan(shape: tuple[int, int], pairs: list[dict]) -> np.ndarray:
+    out = _render_input_from_plan(shape, pairs)
+    wall_mask = np.zeros(shape, dtype=bool)
+    for pair in pairs:
