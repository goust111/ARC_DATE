+        "kind": "aligned",
+        "color": color,
+        "boxes": cand["boxes"],
+        "orient": cand["orient"],
+        "gap_set": set(cand["gap_cells"]),
+        "fill_set": set(cand["fill_cells"]),
+    }
+    state["aligned"].append(meta)
+    state["pairs"].append(meta)
+
+
+def _accept_diagonal(state: dict, color: int, cand: dict) -> None:
+    shape = state["actual"].shape
+    all_cells = cand["rect_cells"] + cand["line_cells"]
+    expanded = _expanded_cells(all_cells, shape)
+    _mark(state["actual"], all_cells)
+    _mark(state["touch"], expanded)
+    meta = {
+        "kind": "diag",
+        "color": color,
+        "boxes": cand["boxes"],
+        "line_cells": list(cand["line_cells"]),
+    }
+    state["diagonals"].append(meta)
+    state["pairs"].append(meta)
+
+
+def _aligned_candidates(shape: tuple[int, int], orient: str) -> list[dict]:
+    return list(_aligned_candidates_cached(shape[0], shape[1], orient))
+
+
+@functools.lru_cache(maxsize=None)
+def _aligned_candidates_cached(h: int, w: int, orient: str) -> tuple[dict, ...]:
+    out = []
+    if orient == "H":
+        for height in RECT_SIDES:
+            for width_a in RECT_SIDES:
+                for width_b in RECT_SIDES:
+                    for r0 in range(1, h - height):
+                        r1 = r0 + height - 1
+                        for c0 in range(1, w - width_a - 1):
+                            c1 = c0 + width_a - 1
+                            min_rc0 = c1 + 1 + ALIGNED_GAP_RANGE[0]
+                            max_rc0 = min(w - width_b - 1, c1 + ALIGNED_GAP_RANGE[1] + 1)
+                            for rc0 in range(min_rc0, max_rc0 + 1):
+                                rc1 = rc0 + width_b - 1
+                                if rc1 >= w - 1:
+                                    continue
+                                a = (r0, c0, r1, c1)
+                                b = (r0, rc0, r1, rc1)
+                                out.append(
+                                    {
+                                        "orient": "H",
+                                        "boxes": (a, b),
+                                        "rect_cells": _box_cells(a) + _box_cells(b),
+                                        "gap_cells": _gap_cells(a, b, "H"),
+                                        "fill_cells": _half_fill_cells(a, b, "H"),
+                                    }
+                                )
+    else:
+        for width in RECT_SIDES:
+            for height_a in RECT_SIDES:
+                for height_b in RECT_SIDES:
+                    for c0 in range(1, w - width):
+                        c1 = c0 + width - 1
+                        for r0 in range(1, h - height_a - 1):
+                            r1 = r0 + height_a - 1
+                            min_br0 = r1 + 1 + ALIGNED_GAP_RANGE[0]
+                            max_br0 = min(h - height_b - 1, r1 + ALIGNED_GAP_RANGE[1] + 1)
+                            for br0 in range(min_br0, max_br0 + 1):
+                                br1 = br0 + height_b - 1
+                                if br1 >= h - 1:
+                                    continue
+                                a = (r0, c0, r1, c1)
+                                b = (br0, c0, br1, c1)
+                                out.append(
+                                    {
+                                        "orient": "V",
+                                        "boxes": (a, b),
+                                        "rect_cells": _box_cells(a) + _box_cells(b),
