+
+    crossed_only = _render_unblocked_fill(shape, crossed)
+    crossed_blocked = expected.copy()
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in crossed["fill_set"]:
+        mask[r, c] = True
+    if np.array_equal(crossed_only[mask], crossed_blocked[mask]):
+        return False
