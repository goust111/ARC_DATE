+                                    uc1 = uc0 + w1 - 1
+                                    lr0 = ur1 + delta
+                                    if direction == 1:
+                                        lc0 = uc1 + delta
+                                        lower = (lr0, lc0, lr0 + h2 - 1, lc0 + w2 - 1)
+                                    else:
+                                        end_c = uc0 - delta
+                                        lower = (lr0, end_c - w2 + 1, lr0 + h2 - 1, end_c)
+                                    upper = (ur0, uc0, ur1, uc1)
+                                    if min(*lower) < 1:
+                                        continue
+                                    if lower[2] >= h - 1 or lower[3] >= w - 1:
