+                                            "line_cells": line_cells,
+                                        }
+                                    )
+    return tuple(out)
+
+
+def _render_input_from_plan(shape: tuple[int, int], pairs: list[dict]) -> np.ndarray:
+    grid = np.full(shape, BG, dtype=int)
+    for pair in pairs:
+        for box in pair["boxes"]:
