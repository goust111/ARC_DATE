+    plain_only = _render_unblocked_fill(shape, plain)
+    plain_mask = np.zeros(shape, dtype=bool)
+    for r, c in plain["fill_set"]:
+        plain_mask[r, c] = True
+    if not np.array_equal(plain_only[plain_mask], expected[plain_mask]):
+        return False
