+                                rc1 = rc0 + width_b - 1
+                                if rc1 >= w - 1:
+                                    continue
+                                a = (r0, c0, r1, c1)
+                                b = (r0, rc0, r1, rc1)
+                                out.append(
+                                    {
+                                        "orient": "H",
+                                        "boxes": (a, b),
+                                        "rect_cells": _box_cells(a) + _box_cells(b),
+                                        "gap_cells": _gap_cells(a, b, "H"),
+                                        "fill_cells": _half_fill_cells(a, b, "H"),
+                                    }
+                                )
+    else:
+        for width in RECT_SIDES:
+            for height_a in RECT_SIDES:
+                for height_b in RECT_SIDES:
+                    for c0 in range(1, w - width):
+                        c1 = c0 + width - 1
+                        for r0 in range(1, h - height_a - 1):
+                            r1 = r0 + height_a - 1
+                            min_br0 = r1 + 1 + ALIGNED_GAP_RANGE[0]
+                            max_br0 = min(h - height_b - 1, r1 + ALIGNED_GAP_RANGE[1] + 1)
+                            for br0 in range(min_br0, max_br0 + 1):
+                                br1 = br0 + height_b - 1
+                                if br1 >= h - 1:
+                                    continue
+                                a = (r0, c0, r1, c1)
+                                b = (br0, c0, br1, c1)
+                                out.append(
+                                    {
+                                        "orient": "V",
+                                        "boxes": (a, b),
+                                        "rect_cells": _box_cells(a) + _box_cells(b),
+                                        "gap_cells": _gap_cells(a, b, "V"),
+                                        "fill_cells": _half_fill_cells(a, b, "V"),
+                                    }
+                                )
+    return tuple(out)
+
+
+def _diagonal_candidates(shape: tuple[int, int]) -> list[dict]:
+    return list(_diagonal_candidates_cached(shape[0], shape[1]))
+
+
+@functools.lru_cache(maxsize=None)
+def _diagonal_candidates_cached(h: int, w: int) -> tuple[dict, ...]:
+    out = []
+    for h1 in RECT_SIDES:
+        for w1 in RECT_SIDES:
+            for h2 in RECT_SIDES:
+                for w2 in RECT_SIDES:
+                    for gap in range(DIAG_GAP_RANGE[0], DIAG_GAP_RANGE[1] + 1):
+                        delta = gap + 1
+                        for direction in (-1, 1):
+                            for ur0 in range(1, h - h1 - delta - h2):
+                                ur1 = ur0 + h1 - 1
+                                for uc0 in range(1, w - w1):
+                                    uc1 = uc0 + w1 - 1
+                                    lr0 = ur1 + delta
+                                    if direction == 1:
+                                        lc0 = uc1 + delta
+                                        lower = (lr0, lc0, lr0 + h2 - 1, lc0 + w2 - 1)
+                                    else:
+                                        end_c = uc0 - delta
+                                        lower = (lr0, end_c - w2 + 1, lr0 + h2 - 1, end_c)
+                                    upper = (ur0, uc0, ur1, uc1)
+                                    if min(*lower) < 1:
+                                        continue
+                                    if lower[2] >= h - 1 or lower[3] >= w - 1:
+                                        continue
+                                    try:
+                                        line_cells = _diag_line_cells(upper, lower)
+                                    except AssertionError:
+                                        continue
+                                    out.append(
+                                        {
+                                            "boxes": (upper, lower),
+                                            "rect_cells": _box_cells(upper) + _box_cells(lower),
+                                            "line_cells": line_cells,
+                                        }
+                                    )
+    return tuple(out)
