+    if _cells_hit(state["touch"], cand["rect_cells"] + cand["line_cells"]):
+        return False
+    if _cells_hit(state["gap"], cand["rect_cells"]) or _cells_hit(state["gap"], expanded):
+        return False
+
+    hit_gaps = []
+    effective_hit = False
+    line_set = set(cand["line_cells"])
