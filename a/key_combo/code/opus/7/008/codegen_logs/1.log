+            cs = [p[1] for p in cells]
+            box = (min(rs), min(cs), max(rs), max(cs))
+            r0, c0, r1, c1 = box
+            area = (r1 - r0 + 1) * (c1 - c0 + 1)
+            assert len(cells) == area, "each object must be a solid rectangle"
