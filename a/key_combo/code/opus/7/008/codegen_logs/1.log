    n = random.choice(_GEN_SOURCE_SIZES)
    min_side = max(_GEN_MIN_GRID_SIDE, 2 * n + _GEN_MARKER_SIDE)
    height = random.randint(min_side, _GEN_MAX_HEIGHT)
