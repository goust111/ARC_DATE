+from __future__ import annotations
+
+import functools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Box = tuple[int, int, int, int]
+
+BG = 0
+COLORS = list(range(1, 10))
+RECT_SIDES = (2, 3)
+GRID_SIDE_RANGE = (18, 25)
+ALIGNED_GAP_RANGE = (3, 8)
+DIAG_GAP_RANGE = (2, 7)
+MAX_ATTEMPTS = 400
