+    _mark(state["touch"], expanded)
+    _mark(state["gap"], cand["gap_cells"])
+    meta = {
+        "kind": "aligned",
+        "color": color,
+        "boxes": cand["boxes"],
+        "orient": cand["orient"],
+        "gap_set": set(cand["gap_cells"]),
+        "fill_set": set(cand["fill_cells"]),
