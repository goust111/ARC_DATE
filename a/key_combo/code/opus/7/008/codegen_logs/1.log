+def _random_crossing_diagonal_candidate(state: dict, gap_idx: int) -> dict | None:
+    h, w = state["actual"].shape
+    aligned = state["aligned"][gap_idx]
+    fill_cells = list(aligned["fill_set"])
+    if not fill_cells:
