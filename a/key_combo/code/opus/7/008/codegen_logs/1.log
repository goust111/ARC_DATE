+                                        end = (xr + (gap - pos), xc + (gap - pos))
+                                        upper = (start[0] - h1 + 1, start[1] - w1 + 1, start[0], start[1])
+                                        lower = (end[0], end[1], end[0] + h2 - 1, end[1] + w2 - 1)
+                                    else:
+                                        start = (xr - pos - 1, xc + pos + 1)
+                                        end = (xr + (gap - pos), xc - (gap - pos))
+                                        upper = (start[0] - h1 + 1, start[1], start[0], start[1] + w1 - 1)
