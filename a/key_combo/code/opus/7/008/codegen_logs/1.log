+    pos = random.randint(0, gap - 1)
+    direction = random.choice((-1, 1))
+    h1 = random.choice(RECT_SIDES)
+    w1 = random.choice(RECT_SIDES)
+    h2 = random.choice(RECT_SIDES)
+    w2 = random.choice(RECT_SIDES)
