+                                    try:
+                                        line_cells = _diag_line_cells(upper, lower)
+                                    except AssertionError:
+                                        continue
+                                    out.append(
+                                        {
+                                            "boxes": (upper, lower),
+                                            "rect_cells": _box_cells(upper) + _box_cells(lower),
+                                            "line_cells": line_cells,
+                                        }
+                                    )
