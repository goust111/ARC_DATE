+
+def _pick_diagonal(state: dict, color: int, cross_gap_idx: int | None, require_cross: bool) -> bool:
+    cands = _crossing_diagonal_candidates(state, cross_gap_idx) if require_cross else _diagonal_candidates(state["actual"].shape)
