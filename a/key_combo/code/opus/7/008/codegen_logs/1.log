+    br0, _bc0, _br1, _bc1 = bottom
+    gap = br0 - tr1 - 1
+    span = gap // 2
+    for c in range(c0, c1 + 1):
+        for i in range(span):
+            r = tr1 + 1 + i
+            if wall_mask[r, c]:
+                break
+            out[r, c] = color
+        for i in range(span):
+            r = br0 - 1 - i
+            if wall_mask[r, c]:
