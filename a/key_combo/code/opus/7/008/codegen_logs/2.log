+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 1
+RED = 2
+GREEN = 3
+DIVIDER = 5
+
+GEN_RETRIES = 600
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _extract_single_sprite(panel: np.ndarray, color: int) -> np.ndarray:
+    comps = _components(panel == color)
+    assert len(comps) == 1, f"expected one {color} component"
+    box = _bbox(comps[0])
+    return _crop_bbox(panel, box)
+
+
+def _find_divider_col(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    cols = [c for c in range(w) if np.all(grid[:, c] == DIVIDER)]
+    assert len(cols) == 1, "expected exactly one full-height grey divider"
+    c = cols[0]
+    assert 0 < c < w - 1 and h >= 1
+    return c
+
