+        expected = np.zeros_like(local)
+        expected[0, :] = True
+        expected[-1, :] = True
+        expected[:, 0] = True
+        expected[:, -1] = True
+        assert np.array_equal(local, expected), "blue component must be a hollow rectangle"
+        assert np.all(right[r0 + 1 : r1, c0 + 1 : c1] == BG), "frame interior must be black"
