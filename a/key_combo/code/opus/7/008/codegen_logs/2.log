+def _find_frames(grid: np.ndarray, start_col: int) -> list[tuple[int, int, int, int]]:
+    right = grid[:, start_col:]
+    assert set(np.unique(right)).issubset({BG, FRAME}), "right panel should only contain blue frames on black"
