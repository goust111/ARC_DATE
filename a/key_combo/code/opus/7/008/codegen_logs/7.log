            n+=1; st=[(r,c)]; seen.add((r,c))
            while st:
                rr,cc=st.pop()
                for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and (nr,nc) not in seen:
                        seen.add((nr,nc)); st.append((nr,nc))
    return n

for m in range(2,7):
