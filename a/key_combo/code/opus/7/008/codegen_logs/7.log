0079: def main(grid: np.ndarray) -> np.ndarray:
0080:     """
0081:     Draw same-colored rectangular connector bands through background channels between four matching marker blocks.
0082: 
0083:     Input structure
0084:     - A background lattice of separated framed tiles; the frame color is the unique most frequent non-background color.
0085:     - Each tile region contains one solid non-frame interior block.
0086:     - The unique most common interior color is the default; every other interior color marks four rectangle corners.
0087: 
0088:     Rule
0089:     - For each marker color, find its two row bands and two column bands.
0090:     - Paint that color through background cells along the two horizontal and two vertical sides of the implied rectangle.
0091:     - Preserve all original frame, default interior, marker, and off-path background pixels.
0092: 
0093:     Key insight
0094:     - The repeated tile frames define which cells are obstacles and which cells are background channels; matching interior colors supply rectangle corners independent of tile and marker size.
0095:     """
0096:     g = np.asarray(grid, dtype=int)
0097:     bg = int(g[0, 0])
0098:     assert np.all(g[0, :] == bg), "top row must be background"
0099: 
0100:     non_bg = [int(v) for v in g.ravel() if int(v) != bg]
0101:     frame = _unique_most_common(Counter(non_bg), "frame color")
0102: 
0103:     regions = _interior_regions(g, bg, frame)
0104:     default = _unique_most_common(Counter(color for color, _box in regions), "default interior color")
0105: 
0106:     markers: dict[int, list[BBox]] = defaultdict(list)
