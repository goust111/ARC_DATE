import numpy as np, random

def path(H,W,anchors,start,end):
    g=np.zeros((H,W),int)
    GREEN=3
    pts=[(start,0)]
    cur=(start,0)
    for x,row in anchors:
        pts.append((cur[0],x)); cur=(cur[0],x)
        if cur[0]"'!=row:
            pts.append((row,x)); cur=(row,x)
    pts.append((cur[0],W-1)); cur=(cur[0],W-1)
    if cur[0]!=end:
        pts.append((end,W-1)); cur=(end,W-1)
    p=pts[0]
    for q in pts[1:]:
        r0,c0=p; r1,c1=q
        dr=(r1>r0)-(r1<r0); dc=(c1>c0)-(c1<c0)
        r,c=r0,c0; g[r,c]=GREEN
        while (r,c)!=(r1,c1): r+=dr; c+=dc; g[r,c]=GREEN
        p=q
    return g,pts

def ncomps(g):
    H,W=g.shape
    mask=np.ones((H,W),bool)
    mask[0,:]=False; mask[-1,:]=False; mask[g==3]=False
    seen=set(); n=0
