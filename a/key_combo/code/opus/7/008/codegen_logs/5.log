+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+LATIN_COLORS = (BLUE, RED, YELLOW, GRAY)
+BASE_LATIN = np.array(
+    [
+        [0, 1, 2, 3],
+        [1, 2, 3, 0],
+        [2, 3, 0, 1],
+        [3, 0, 1, 2],
+    ],
+    dtype=int,
+)
+MAX_ATTEMPTS = 400
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _flood_fill(grid: np.ndarray, r: int, c: int, color: int) -> None:
+    h, w = grid.shape
+    start_r = int(r)
+    start_c = int(c)
+    if not (0 <= start_r < h and 0 <= start_c < w):
+        return
+    old_color = int(grid[start_r, start_c])
+    new_color = int(color)
+    if old_color == new_color:
+        return
+    stack = [(start_r, start_c)]
+    while stack:
+        rr, cc = stack.pop()
+        if not (0 <= rr < h and 0 <= cc < w):
+            continue
+        if int(grid[rr, cc]) != old_color:
+            continue
+        grid[rr, cc] = new_color
+        stack.append((rr - 1, cc))
+        stack.append((rr + 1, cc))
+        stack.append((rr, cc - 1))
+        stack.append((rr, cc + 1))
