+def _parse_partition(grid: np.ndarray) -> tuple[tuple[int, int, int, int], list[int], list[int]]:
+    green_mask = grid == GREEN
+    frame = _bbox(green_mask)
+    assert frame is not None, "expected a green divider network"
+    r0, c0, r1, c1 = frame
