+    period = _infer_period(g, MARKER)
+    unit = _recover_unit(g, period, MARKER)
+
+    out = g.copy()
+    holes = np.argwhere(g == MARKER)
+    for r, c in holes:
+        out[int(r), int(c)] = int(unit[int(r), int(c) % period])
+    return out
