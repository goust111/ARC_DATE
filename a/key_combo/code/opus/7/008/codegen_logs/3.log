+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER = 4
+PALETTE = (1, 2, 3, 5)
+HEIGHT_RANGE = range(8, 13)
+PERIOD_RANGE = range(4, 7)
+REPEAT_RANGE = range(3, 6)
+MAX_ATTEMPTS = 400
