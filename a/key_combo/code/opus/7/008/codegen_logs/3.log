+
+def _compose_symmetric_unit(columns: list[np.ndarray], period: int) -> np.ndarray:
+    if period % 2 == 0:
+        full_columns = columns + columns[::-1]
+    else:
+        full_columns = columns + columns[-2::-1]
+    return np.stack(full_columns, axis=1).astype(int)
