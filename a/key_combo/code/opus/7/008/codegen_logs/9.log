+MACRO_SIDE = 5
+GRID_SIDE = MACRO_SIZE * MACRO_SIDE
+
+BG = 0
+LONGEST = 1
+SECOND = 2
+THIRD = 3
+SHORTEST = 4
+WALL = 5
+SOURCE = 8
