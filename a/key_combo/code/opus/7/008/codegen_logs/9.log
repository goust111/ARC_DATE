+
+def _macro_bounds(mr: int, mc: int) -> tuple[slice, slice]:
+    r0 = mr * MACRO_SIZE
+    c0 = mc * MACRO_SIZE
+    return slice(r0, r0 + MACRO_SIZE), slice(c0, c0 + MACRO_SIZE)
