+        band = grid[r0 : r0 + SLOT, 1:]
+        if np.all(band == Color.GREY):
+            occluded.append(i)
+    assert len(occluded) == 1, "expected exactly one fully grey lattice row"
+    return occluded[0]
+
+
+def _recover_sprite_mask(grid: np.ndarray, occluded_row: int) -> np.ndarray:
+    sprite_mask = None
+    visible_occupied = 0
+    visible_empty = 0
+
+    for i in range(K):
+        for j in range(K):
