 269:     r0, c0, r1, c1 = map(int, b)
 270:     h = bbox_h(b)
 271:     w = bbox_w(b)
 272: 
 273:     if anchor == "upperleft":
 274:         rr, cc = r0, c0
 275:     elif anchor == "upperright":
 276:         rr, cc = r0, c1
 277:     elif anchor == "lowerleft":
 278:         rr, cc = r1, c0
 279:     elif anchor == "lowerright":
 280:         rr, cc = r1, c1
 281:     elif anchor == "center":
