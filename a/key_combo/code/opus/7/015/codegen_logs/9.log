+    dir_idx = 0
+    turn_count = 0
+    path: list[tuple[int, int]] = []
+
+    while True:
+        assert int(out[r, c]) != Color.GREY
+        out[r, c] = Color.GREEN
+        path.append((r, c))
+
+        moved = False
+        for _ in range(4):
+            if not _blocked(out, r, c, dir_idx):
+                dr, dc = DIRS[dir_idx]
+                r += dr
+                c += dc
+                moved = True
+                break
+            dir_idx = (dir_idx + 1) % 4
+            turn_count += 1
+        if not moved:
