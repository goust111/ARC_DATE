  58:     """
  59:     Fill each solid rectangle with a size-adjusted copy of the multicolor exemplar rectangle.
  60: 
  61:     Input structure
  62:     - The background separates several solid rectangular foreground objects.
  63:     - Exactly one rectangle is a multicolor exemplar; its four corners share the outer color.
  64:     - Every other foreground rectangle is solid and uses that same outer color.
  65: 
  66:     Rule
  67:     - Run-length encode the exemplar's identical rows and identical columns.
  68:     - In each axis, keep all boundary runs fixed and resize the single interior run:
  69:       choose the run whose representative line has the most colors, using unique
  70:       run width/height only for the degenerate equal-complexity stripe case.
  71:     - Replace each solid outer-color rectangle by the resulting stretched exemplar pattern.
  72: 
  73:     Key insight
  74:     - The exemplar is not scaled geometrically; only its interior row and column runs stretch while the visible bands stay fixed.
  75:     """
  76:     g = np.asarray(grid, dtype=int)
  77:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
  78: 
  79:     bg = get_bg(g)
  80:     components = find_components(g, bg=bg, connectivity=4, monochromatic=False)
  81:     assert len(components) >= 2, "expected one exemplar and at least one target rectangle"
  82: 
  83:     regions: list[tuple[tuple[int, int, int, int], np.ndarray]] = []
  84:     for component in components:
  85:         b = component["bbox"]
  86:         patch = crop_bbox(g, b)
  87:         assert int(component["area"]) == bbox_h(b) * bbox_w(b), "components must be solid rectangles"
  88:         assert np.all(patch != bg), "component bbox must not contain background holes"
  89:         regions.append((b, patch))
  90: 
  91:     exemplar_regions = [(b, patch) for b, patch in regions if len(np.unique(patch)) > 1]
  92:     assert len(exemplar_regions) == 1, "expected exactly one multicolor exemplar"
  93:     exemplar_bbox, exemplar = exemplar_regions[0]
  94: 
  95:     outer = int(exemplar[0, 0])
  96:     corners = [exemplar[0, 0], exemplar[0, -1], exemplar[-1, 0], exemplar[-1, -1]]
  97:     assert all(int(corner) == outer for corner in corners), "exemplar corners must share outer color"
  98: 
  99:     out = g.copy()
 100:     for b, patch in regions:
 101:         if b == exemplar_bbox:
 102:             continue
 103:         colors = np.unique(patch)
 104:         assert len(colors) == 1 and int(colors[0]) == outer, "targets must be solid outer-color rectangles"
 105:         r0, c0, r1, c1 = b
 106:         out[r0 : r1 + 1, c0 : c1 + 1] = _stretch_pattern(exemplar, patch.shape)
