+MIN_SIZE = 10
+MAX_SIZE = 12
+MIN_OBSTACLES = 3
+MAX_OBSTACLES = 5
+MIN_TURNS = 6
+AREA_THRESHOLD = 4
+MAX_ATTEMPTS = 500
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
