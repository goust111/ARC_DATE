  13: def main(grid: np.ndarray) -> np.ndarray:
  14:     """Fill a green-lined table by coloring its four corner cells and its fully internal cells.
  15: 
  16:     Input structure
  17:     - The input contains a black background and one foreground separator color forming complete horizontal and vertical grid lines.
  18:     - Those separator lines divide the canvas into rectangular background cells.
  19:     Rule
  20:     - Preserve the separator lines, fill the top-left/top-right/bottom-left/bottom-right cells with red/yellow/blue/teal, and fill every cell that is neither in an outer row band nor an outer column band with orange.
  21:     - Leave all other edge cells black.
  22:     Key insight
  23:     - The green scaffold is a table; output colors depend only on each cell's position in that table: corner, strict interior, or remaining edge.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     bg = get_bg(g)
  27:     assert bg == Color.BLACK
  28:     fg_colors = colors_present(g, exclude={bg})
  29:     assert len(fg_colors) == 1
  30:     line_color = fg_colors[0]
  31:     assert line_color == Color.GREEN
  32: 
  33:     full_rows = [r for r in range(g.shape[0]) if np.all(g[r, :] == line_color)]
  34:     full_cols = [c for c in range(g.shape[1]) if np.all(g[:, c] == line_color)]
  35:     assert full_rows and full_cols
  36: 
  37:     line_mask = g == line_color
  38:     expected_line_mask = np.zeros(g.shape, dtype=bool)
  39:     expected_line_mask[full_rows, :] = True
  40:     expected_line_mask[:, full_cols] = True
  41:     assert np.array_equal(line_mask, expected_line_mask)
  42: 
  43:     row_regions = _regions_between(full_rows, g.shape[0])
  44:     col_regions = _regions_between(full_cols, g.shape[1])
  45:     assert len(row_regions) >= 2 and len(col_regions) >= 2
  46: 
  47:     out = g.copy()
  48:     last_row = len(row_regions) - 1
  49:     last_col = len(col_regions) - 1
  50:     for row_i, (r0, r1) in enumerate(row_regions):
