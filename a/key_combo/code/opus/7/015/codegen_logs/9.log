  41: def main(grid: np.ndarray) -> np.ndarray:
  42:     """
  43:     Draw red diagonal connectors between green plus objects whose centers lie on the same clear 45-degree diagonal.
  44: 
  45:     Input structure
  46:     - The canvas has a single background color and multiple same-colored 5-pixel plus objects.
  47:     - Each plus is a 4-connected object with a 3x3 bbox and pixels at the center plus the four cardinal neighbors.
  48:     - Some plus centers share an unobstructed diagonal line of background cells.
  49: 
  50:     Rule
  51:     - Keep every input pixel unchanged.
  52:     - For each pair of plus centers with equal row and column separation, scan the straight diagonal segment between them.
  53:     - If every interior cell on that diagonal segment is background, recolor those interior cells red.
  54: 
  55:     Key insight
  56:     - The added pixels are not extensions of plus arms; they are the empty center-to-center diagonal gaps between aligned plus objects.
  57:     """
  58:     g = np.asarray(grid, dtype=int)
  59:     bg = get_bg(g)
  60:     centers = _plus_centers(g, bg)
  61: 
  62:     out = g.copy()
  63:     connector_count = 0
  64:     for i, (r1, c1) in enumerate(centers):
  65:         for r2, c2 in centers[i + 1 :]:
  66:             dr = int(r2 - r1)
  67:             dc = int(c2 - c1)
  68:             if abs(dr) != abs(dc):
  69:                 continue
  70: 
  71:             sr = _sign(dr)
  72:             sc = _sign(dc)
  73:             gap = [(r1 + k * sr, c1 + k * sc) for k in range(1, abs(dr))]
  74:             if all(int(g[r, c]) == bg for r, c in gap):
  75:                 for r, c in gap:
  76:                     out[r, c] = Color.RED
  77:                 connector_count += 1
  78: 
