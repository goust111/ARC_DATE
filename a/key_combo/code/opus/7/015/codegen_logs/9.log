+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    assert h == w, "expected a square grid"
+    assert int(out[0, 0]) != Color.GREY, "top-left start must not be an obstacle"
+
+    r = c = 0
+    dir_idx = 0
+    turn_count = 0
+    path: list[tuple[int, int]] = []
+
+    while True:
+        assert int(out[r, c]) != Color.GREY
+        out[r, c] = Color.GREEN
+        path.append((r, c))
+
+        moved = False
+        for _ in range(4):
+            if not _blocked(out, r, c, dir_idx):
+                dr, dc = DIRS[dir_idx]
+                r += dr
+                c += dc
+                moved = True
+                break
+            dir_idx = (dir_idx + 1) % 4
+            turn_count += 1
+        if not moved:
+            break
+
+    return out, tuple(path), turn_count
+
+
+def _black_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != Color.BLACK:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_boundary = False
+            touches_obstacle = False
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr in (0, h - 1) or cc in (0, w - 1):
+                    touches_boundary = True
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds(grid.shape, nr, nc):
+                        continue
+                    val = int(grid[nr, nc])
+                    if val == Color.GREY:
