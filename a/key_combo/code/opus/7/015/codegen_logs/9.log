  15: def main(input_grid):
  16:     """
  17:     Draw a clockwise green spiral into an empty black square grid.
  18: 
  19:     Input structure:
  20:     - The input grid is entirely black.
  21:     - The grid is square and at least large enough for a visible spiral.
  22:     - The output keeps the same dimensions.
  23: 
  24:     Rule:
  25:     - Start at the top-left cell and move right.
  26:     - Turn clockwise when the next step would leave the grid or when the cell two steps ahead is already green.
  27:     - Stop when the next step would enter an already green cell.
  28: 
  29:     Key insight:
  30:     - The one-cell lookahead prevents the path from touching itself too early, creating the spiral gap.
  31:     """
  32:     # get the grid size
  33:     H, W = input_grid.shape
  34: 
  35:     # start from the top left corner of the grid
  36:     r, c = 0, 0
  37:     output_grid = input_grid.copy()
  38:     output_grid[r, c] = Color.GREEN
  39: 
  40:     # initial direction: right
  41:     dr, dc = (0, 1)
  42: 
  43:     def turn_clockwise(dr: int, dc: int) -> tuple[int, int]:
  44:         # rotate (dr,dc) clockwise
  45:         return (dc, -dr)
  46: 
  47:     # continue spiralling until we cannot anymore
  48:     while True:
  49:         # First, check if we hit the border, if so, we turn clockwise
  50:         if r + dr >= H or c + dc >= W or r + dr < 0 or c + dc < 0:
  51:             dr, dc = turn_clockwise(dr, dc)
  52:             continue
  53: 
  54:         # Then, check if the square after the current one is green, if so,
  55:         # we are already spiralling, so stop here
  56:         if output_grid[r + dr, c + dc] == Color.GREEN:
  57:             break
  58: 
  59:         # Last, check if the square after the current one is green, if so, we turn clockwise
  60:         # We do this to draw the spiral pattern
  61:         if (
  62:             0 <= r + 2 * dr < H
  63:             and 0 <= c + 2 * dc < W
  64:             and output_grid[r + 2 * dr, c + 2 * dc] == Color.GREEN
  65:         ):
  66:             dr, dc = turn_clockwise(dr, dc)
  67:             continue
  68:         
  69:         # then we move to the next square and color it green
  70:         r += dr
  71:         c += dc
  72:         output_grid[r, c] = Color.GREEN
  73: 
  74:     return output_grid
  75: 
  76: def generate_input():
  77:     # first create a randomly sized grid, somewhere between 5x5 and 20x20
  78:     length = random.randint(5, 20)
  79:     grid = np.full((length, length), Color.BLACK)
  80: 
  81:     return grid


