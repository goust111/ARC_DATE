+
+DIRS = ((0, 1), (1, 0), (0, -1), (-1, 0))
+MIN_SIZE = 10
+MAX_SIZE = 12
+MIN_OBSTACLES = 3
+MAX_OBSTACLES = 5
+MIN_TURNS = 6
