+    out = grid.copy()
+    for comp in closed_regions:
+        color = Color.RED if comp["area"] >= AREA_THRESHOLD else Color.BLUE
+        coords = comp["coords"]
+        out[coords[:, 0], coords[:, 1]] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
