+
+def _render_output(
+    cell_count: int,
+    cell_w: int,
+    band_h: int,
+    active: list[bool],
+    template_coords: list[tuple[int, int]],
+    palette: list[int],
+) -> np.ndarray:
+    out = np.zeros((band_h, cell_count * cell_w), dtype=int)
