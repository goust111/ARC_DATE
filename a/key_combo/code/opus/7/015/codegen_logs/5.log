0015: def main(input_grid):
0016:     """
0017:     Draw a clockwise green spiral into an empty black square grid.
0018: 
0019:     Input structure:
0020:     - The input grid is entirely black.
0021:     - The grid is square and at least large enough for a visible spiral.
0022:     - The output keeps the same dimensions.
0023: 
0024:     Rule:
0025:     - Start at the top-left cell and move right.
0026:     - Turn clockwise when the next step would leave the grid or when the cell two steps ahead is already green.
0027:     - Stop when the next step would enter an already green cell.
0028: 
0029:     Key insight:
0030:     - The one-cell lookahead prevents the path from touching itself too early, creating the spiral gap.
0031:     """
0032:     # get the grid size
0033:     H, W = input_grid.shape
0034: 
0035:     # start from the top left corner of the grid
0036:     r, c = 0, 0
0037:     output_grid = input_grid.copy()
0038:     output_grid[r, c] = Color.GREEN
0039: 
0040:     # initial direction: right
0041:     dr, dc = (0, 1)
0042: 
0043:     def turn_clockwise(dr: int, dc: int) -> tuple[int, int]:
0044:         # rotate (dr,dc) clockwise
0045:         return (dc, -dr)
0046: 
0047:     # continue spiralling until we cannot anymore
0048:     while True:
0049:         # First, check if we hit the border, if so, we turn clockwise
0050:         if r + dr >= H or c + dc >= W or r + dr < 0 or c + dc < 0:
0051:             dr, dc = turn_clockwise(dr, dc)
0052:             continue
0053: 
0054:         # Then, check if the square after the current one is green, if so,
0055:         # we are already spiralling, so stop here
0056:         if output_grid[r + dr, c + dc] == Color.GREEN:
0057:             break
0058: 
0059:         # Last, check if the square after the current one is green, if so, we turn clockwise
0060:         # We do this to draw the spiral pattern
0061:         if (
0062:             0 <= r + 2 * dr < H
0063:             and 0 <= c + 2 * dc < W
0064:             and output_grid[r + 2 * dr, c + 2 * dc] == Color.GREEN
0065:         ):
0066:             dr, dc = turn_clockwise(dr, dc)
0067:             continue
0068:         
0069:         # then we move to the next square and color it green
0070:         r += dr
0071:         c += dc
0072:         output_grid[r, c] = Color.GREEN
0073: 
0074:     return output_grid
0075: 
