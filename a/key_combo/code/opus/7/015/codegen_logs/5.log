+        "grid": g,
+        "row_regions": row_regions,
+        "col_regions": col_regions,
+        "band_h": band_h,
+        "mask_a": mask_a,
+        "mask_b": mask_b,
+        "active": active,
+        "palette": palette,
+        "template_idx": template_idx,
+        "template_coords": [(int(r), int(c)) for r, c in template_coords],
+        "used_rows": used_rows,
+    }
