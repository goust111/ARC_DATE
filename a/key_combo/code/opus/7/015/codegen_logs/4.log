+YELLOW = Color.YELLOW
+PINK = Color.PINK
+ORANGE = Color.ORANGE
+PERIOD = 4
+
+GEN_ATTEMPTS = 400
+GEN_HEIGHT_RANGE = (18, 25)
+GEN_WIDTH_RANGE = (18, 27)
+GEN_TARGET_COUNT_RANGE = (4, 6)
