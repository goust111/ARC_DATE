+
+
+def _scene_summary(grid: np.ndarray) -> dict:
+    cols, exemplar_bbox, exemplar, targets = _parse_scene(grid)
+    summary = {
+        "periodic_cols": cols,
+        "exemplar_bbox": exemplar_bbox,
