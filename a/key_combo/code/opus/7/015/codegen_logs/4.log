+    periodic_cols, _exemplar_bbox, exemplar, targets = _parse_scene(g)
+
+    out = g.copy()
+    out[0, periodic_cols] = BACKGROUND
+
+    qualified: list[tuple[int, int, int, int]] = []
+    for bbox, shape in targets:
