+    return out
+
+
+def _make_exemplar() -> np.ndarray:
+    inner_h = random.randint(2, 4)
+    inner_w = random.randint(3, 5)
+    split = random.randint(1, inner_h - 1)
+    colors = [RED, BLUE]
+    if random.random() < 0.5:
