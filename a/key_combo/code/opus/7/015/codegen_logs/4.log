+def _can_place(grid: np.ndarray, r0: int, c0: int, h: int, w: int, padding: int = 1) -> bool:
+    h0, w0 = grid.shape
+    if r0 < 1 or c0 < 0 or r0 + h > h0 or c0 + w > w0:
+        return False
+    rr0 = max(0, r0 - padding)
+    cc0 = max(0, c0 - padding)
