+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        h = random.randint(*GEN_HEIGHT_RANGE)
+        w = random.randint(*GEN_WIDTH_RANGE)
+        grid = np.zeros((h, w), dtype=int)
