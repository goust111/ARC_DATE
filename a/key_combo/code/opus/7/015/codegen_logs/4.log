+        target_count = random.randint(*GEN_TARGET_COUNT_RANGE)
+        nonqual_count = random.randint(GEN_MIN_NONQUALIFIED, min(2, target_count - GEN_MIN_QUALIFIED))
+        qual_count = target_count - nonqual_count
+
+        placed = []
+        ok = True
+
+        for _ in range(qual_count):
