+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_UTILS_DIR))
+
+from arc_utils import Color, crop_bbox, find_components, get_bg, paste
+
+
+BACKGROUND = Color.BLACK
+BLUE = Color.BLUE
+RED = Color.RED
+YELLOW = Color.YELLOW
+PINK = Color.PINK
+ORANGE = Color.ORANGE
+PERIOD = 4
+
+GEN_ATTEMPTS = 400
+GEN_HEIGHT_RANGE = (18, 25)
+GEN_WIDTH_RANGE = (18, 27)
+GEN_TARGET_COUNT_RANGE = (4, 7)
+GEN_TARGET_HEIGHT_RANGE = (4, 9)
+GEN_QUAL_WIDTH_RANGE = (4, 9)
+GEN_NONQUAL_WIDTH_RANGE = (3, 4)
+GEN_MIN_QUALIFIED = 2
+GEN_MIN_NONQUALIFIED = 1
