+
+
+def _column_lengths(cells: list[tuple[int, int]]) -> dict[int, int]:
+    lengths: dict[int, int] = {}
+    for _r, c in cells:
+        lengths[c] = lengths.get(c, 0) + 1
+    return lengths
+
+
+def _sample_layout() -> list[dict] | None:
+    h = random.randint(19, 27)
