+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAROON = 9
+
+TOKEN_COLORS = (BLUE, RED, YELLOW)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+TOKEN_SHAPES = {
+    "solid": {
+        (dr, dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+    },
+    "cross": {(-1, 0), (1, 0), (0, -1), (0, 1), (0, 0)},
+    "diamond": {(-1, -1), (-1, 1), (0, 0), (1, -1), (1, 1)},
+}
+SHAPE_CYCLE = {
+    "solid": "cross",
+    "cross": "diamond",
+    "diamond": "solid",
+}
