    if component_count == 2:
        shapes = rng.sample(shape_names, 2)
    else:
        if rng.random() < 0.6:
            shapes = rng.sample(shape_names, 3)
        else:
            pair = rng.sample(shape_names, 2)
            shapes = pair + [rng.choice(pair)]
            rng.shuffle(shapes)
    components=[]
    ok=True
    for color, shape in zip(colors, shapes):
        comp = mod._build_component(rng, color, shape)
        if comp is None:
            counts['build_fail'] += 1
            ok=False
            break
        components.append(comp)
    if not ok:
        continue
    height = rng.randint(20, 28)
    width = rng.randint(20, 28)
    inp = mod._place_components(rng, components, height, width)
    if inp is None:
        counts['place_fail'] += 1
        continue
    out = mod.main(inp)
    if np.array_equal(inp, out):
        counts['same_fail'] += 1
        continue
    if not mod._validate_semantics(inp, out):
        counts['sem_fail'] += 1
        continue
    counts['ok'] += 1
