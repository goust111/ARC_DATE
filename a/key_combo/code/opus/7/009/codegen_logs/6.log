+    for r_raw, c_raw in np.argwhere((g == RED) | (g == GREEN)):
+        r = int(r_raw)
+        c = int(c_raw)
+        row_idx = _band_index(r, row_bands)
+        col_idx = _band_index(c, col_bands)
+        if int(g[r, c]) == RED:
+            assert row_idx == 0
+            assert col_idx in red_sources
+        else:
+            assert col_idx == 0
+            assert row_idx in green_sources
