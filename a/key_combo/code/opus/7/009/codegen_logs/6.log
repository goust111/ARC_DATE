+def _parse_lattice(
+    grid: np.ndarray,
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], tuple[int, ...], tuple[int, ...]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and g.size > 0
+    assert set(map(int, np.unique(g))) <= {BLACK, RED, GREEN, GREY}
