+        assert not np.any(cell == GREEN)
+    for row_idx, (r0, r1) in enumerate(row_bands):
+        cell = g[r0 : r1 + 1, col_bands[0][0] : col_bands[0][1] + 1]
+        if np.any(cell == GREEN):
+            green_sources.append(row_idx)
+        assert not np.any(cell == RED)
