+def _render_output_from_state(
+    input_grid: np.ndarray,
+    row_bands: list[tuple[int, int]],
+    col_bands: list[tuple[int, int]],
+    cell_state: np.ndarray,
+) -> np.ndarray:
+    out = np.asarray(input_grid, dtype=int).copy()
+    mask = out != GREY
+    out[mask] = BLACK
