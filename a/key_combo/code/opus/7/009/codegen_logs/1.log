+    bars: list[Bar] = []
+    for comp in _components_of_color(grid, RED):
+        r0, c0, r1, c1 = _bbox_coords(comp)
+        assert c0 == c1, "red objects must be 1-cell-wide vertical bars"
+        bars.append(Bar(r0, c0, r1))
