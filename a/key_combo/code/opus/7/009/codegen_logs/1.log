  17: def main(input_grid):
  18:     """
  19:     Add blue downward extensions and larger green square frames around each input square.
  20: 
  21:     Input structure:
  22:     - The grid contains multiple monochromatic square objects on a black background.
  23:     - The square objects may have different sizes but share the same generated color.
  24:     - Blue and green are output-only construction colors.
  25: 
  26:     Rule:
  27:     - Detect each square object and clear the output background to black.
  28:     - Fill blue below each square's original footprint down to the grid bottom.
  29:     - Draw a green frame twice the square size around it, then paste the original square back.
  30: 
  31:     Key insight:
  32:     - Each square contributes two independent structures: a vertical blue projection from
  33:       its base and a centered doubled-size green frame around the original square.
  34:     """
  35:     # Plan:
  36:     # 1. Extract the square objects from the input grid
  37:     # 2. Expand the squares down to the bottom using the color BLUE
  38:     # 3. Draw the frame
  39:     # 4. Put the original squares back
  40: 
  41:     # 1. Input parsing and setup
  42:     # Extract the squares in the input grid
  43:     square_objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  44: 
  45:     # Note the frame color and the expansion down color
  46:     frame_color = Color.GREEN
  47:     expand_color = Color.BLUE
  48: 
  49:     # The output grid is the same size as the input grid
  50:     output_grid = np.full_like(input_grid, Color.BLACK)
  51: 
  52:     # 2. Expand the squares down to the bottom using `expand_color`.
  53:     for square_obj in square_objects:
  54:         _b = bbox(square_obj != Color.BLACK)
  55:         assert _b is not None
  56:         r0, c0, r1, c1 = map(int, _b)
  57:         # Fill below the square's footprint.
  58:         if r1 + 1 < output_grid.shape[0]:
  59:             output_grid[r1 + 1 :, c0 : c1 + 1] = int(expand_color)
  60:     
  61:     # 3. Draw a green square frame around the original squares, the green square should be twice as big as original were
  62:     for square_obj in square_objects:
