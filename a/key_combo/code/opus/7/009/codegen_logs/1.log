+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+CYAN = 8
+
+MAX_GEN_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Bar:
+    top: int
+    col: int
+    bottom: int
+
+    @property
+    def height(self) -> int:
