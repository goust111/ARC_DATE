+            if mask[r, c] and mask[r + 1, c + 1]:
+                nw_se += 1
+    for r in range(mask.shape[0] - 1):
+        for c in range(1, mask.shape[1]):
+            if mask[r, c] and mask[r + 1, c - 1]:
+                ne_sw += 1
+    return nw_se, ne_sw
