+    majority_orientation = "nw_se" if orient_counts["nw_se"] > orient_counts["ne_sw"] else "ne_sw"
+    minority_orientation = "ne_sw" if majority_orientation == "nw_se" else "nw_se"
+
+    out = np.full_like(g, bg)
