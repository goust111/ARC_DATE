+            assert aligned_bar == 3
+    except Exception:
+        return False
+    return True
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(12, 18))
+    w = int(rng.integers(12, 18))
