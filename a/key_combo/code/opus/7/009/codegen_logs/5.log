+                    _paint_pair(grid, cells, colors, rng)
+                    occupied.update(cells)
+                    available.remove(line_key)
+                    placed = True
+                    break
+                if placed:
+                    break
+            if placed:
+                break
+        if not placed:
+            return False
+    return True
