+    same_col = [nbr for nbr in neighbors if nbr[1] == center[1]]
+    if len(same_row) == 2 and len(same_col) == 1:
+        control = same_col[0]
+    elif len(same_col) == 2 and len(same_row) == 1:
+        control = same_row[0]
