import itertools, numpy as np

def rotate(cell,center2):
    r,c=cell; cr,cc=center2
    pr,pc=2*r,2*c
    return ((cr+cc-pc)//2, (cc+pr-cr)//2)

def rotset(cells,center2,k):
    cur=set(cells)
    for _ in range(k):
        cur={rotate(x,center2) for x in cur}
    return cur

def complete(cells,center2):
    out=set(cells)
    for cell in list(cells):
        cur=cell
        for _ in range(3):
            cur=rotate(cur,center2)
            out.add(cur)
    return out

def bbox(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
