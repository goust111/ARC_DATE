+def _bbox(coords: list[tuple[int, int]] | set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rs = [r for r, _c in coords]
+    cs = [c for _r, c in coords]
+    return min(rs), min(cs), max(rs), max(cs)
