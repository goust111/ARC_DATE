+def _rotate_cell_90(cell: tuple[int, int], center2: tuple[int, int]) -> tuple[int, int]:
+    r, c = cell
+    cr2, cc2 = center2
+    pr2 = 2 * r
+    pc2 = 2 * c
+    nr2 = cr2 + cc2 - pc2
+    nc2 = cc2 + pr2 - cr2
+    assert nr2 % 2 == 0 and nc2 % 2 == 0
+    return nr2 // 2, nc2 // 2
