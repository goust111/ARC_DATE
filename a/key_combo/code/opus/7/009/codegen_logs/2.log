+            for r0 in range(h - box_h + 1):
+                for c0 in range(w - box_w + 1):
+                    rect = (r0, c0, r0 + box_h - 1, c0 + box_w - 1)
+                    if all(_rect_far(rect, old) for old in used_rects):
+                        options.append((r0, c0))
+            if not options:
