+        if len(set(visible_areas)) != k:
+            continue
+        if not _has_area_inversion(chosen):
+            continue
+        if require_mixed_families and len({str(item["family"]) for item in chosen}) < 2:
+            continue
+        if require_mixed_kept and len({int(item["kept_count"]) for item in chosen}) < 2:
+            continue
