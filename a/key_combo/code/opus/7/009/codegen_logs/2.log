+def _rotate_coords(coords: set[tuple[int, int]], center2: tuple[int, int], turns: int) -> set[tuple[int, int]]:
+    out = set(coords)
+    for _ in range(turns % 4):
+        out = {_rotate_cell_90(cell, center2) for cell in out}
+    return out
