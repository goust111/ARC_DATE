        placed.append((j,r,c))
        for rr,cc in obj['visible']:
            grid[r+rr,c+cc]=colors[j]
    if not ok:
        continue
    out=main(grid)
    exp=render_expected([colors[i] for i in sorted(range(k), key=lambda i:-chosen[i]['full_area'])])
    if not np.array_equal(out, exp):
        print('mismatch',t)
        print(chosen)
        break
else:
    print('ok')
