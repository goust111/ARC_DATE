+                    if not (3 <= len(visible) <= 12):
+                        continue
+                    if not _connected(visible):
+                        continue
+                    inferred = _infer_center2(visible)
+                    if tuple(inferred["center2"]) != center2:
+                        continue
+                    if not bool(inferred["unique_distance"]):
