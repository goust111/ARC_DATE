+from __future__ import annotations
+
+import numpy as np
+
+
+MIN_SIDE = 4
+MAX_SIDE = 8
+GRID_MIN = 12
+GRID_MAX = 16
+FRAME_COUNT_MIN = 3
+FRAME_COUNT_MAX = 5
+EDGE_MARGIN = 1
+GEN_RETRY_LIMIT = 400
+LAYER_PLACEMENT_TRIES = 220
+PALETTE = np.arange(1, 10, dtype=int)
+_GEN_RNG = np.random.default_rng()
