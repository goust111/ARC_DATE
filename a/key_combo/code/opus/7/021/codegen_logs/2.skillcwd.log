+    h, w = map(int, shape)
+    max_h = min(MAX_SIDE, h - 2 * EDGE_MARGIN)
+    max_w = min(MAX_SIDE, w - 2 * EDGE_MARGIN)
+    if max_h < MIN_SIDE or max_w < MIN_SIDE:
