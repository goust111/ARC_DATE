+def _render_scene(shape: tuple[int, int], layers: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for layer in reversed(layers):
+        grid[layer["mask"]] = int(layer["color"])
+    return grid
