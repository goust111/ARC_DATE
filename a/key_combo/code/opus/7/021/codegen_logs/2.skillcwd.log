+    if coords.size == 0:
+        return []
+
+    support = g != 0
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    min_r = int(rows.min())
+    max_r = int(rows.max())
+    min_c = int(cols.min())
+    max_c = int(cols.max())
+
+    candidates: list[dict] = []
+    max_h = min(int(h), MAX_SIDE)
+    max_w = min(int(w), MAX_SIDE)
