  "src": "singleton marker pixels on opposite grid borders",
  "path": "matching left/right border markers emit a full horizontal row; matching top/bottom border markers emit a full vertical column",
  "trajectory": "paint the entire guide row or column with the marker color",
  "transform": "recolor every 4-connected object-color object that overlaps or 4-neighbor touches a completed guide line to the marker color; preserve the other objects"
}
</annotation>
<generation_spec>
