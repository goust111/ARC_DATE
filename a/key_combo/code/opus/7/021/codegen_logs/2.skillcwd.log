+
+def _side_slices(bbox: tuple[int, int, int, int]):
+    r0, c0, r1, c1 = map(int, bbox)
+    return (
+        (r0, slice(c0, c1 + 1)),
+        (r1, slice(c0, c1 + 1)),
+        (slice(r0, r1 + 1), c0),
+        (slice(r0, r1 + 1), c1),
+    )
