+def _enumerate_candidates(grid: np.ndarray, color: int) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    coords = np.argwhere(g == int(color))
+    if coords.size == 0:
+        return []
+
+    support = g != 0
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    min_r = int(rows.min())
+    max_r = int(rows.max())
+    min_c = int(cols.min())
+    max_c = int(cols.max())
