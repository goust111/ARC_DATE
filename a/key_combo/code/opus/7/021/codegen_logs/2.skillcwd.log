+def _gen_attempt() -> np.ndarray | None:
+    rng = _GEN_RNG
+    height = _randint(rng, GRID_MIN, GRID_MAX)
+    width = _randint(rng, GRID_MIN, GRID_MAX)
+    shape = (int(height), int(width))
