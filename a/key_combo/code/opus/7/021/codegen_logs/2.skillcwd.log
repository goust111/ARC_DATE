+def _place_next_layer(
+    rng: np.random.Generator,
+    shape: tuple[int, int],
+    layers: list[dict],
+    color: int,
+) -> dict | None:
+    higher_union = np.zeros(shape, dtype=bool)
+    for layer in layers:
+        higher_union |= layer["mask"]
+    prev = layers[-1]
+    older_union = np.zeros(shape, dtype=bool)
+    for layer in layers[:-1]:
+        older_union |= layer["mask"]
