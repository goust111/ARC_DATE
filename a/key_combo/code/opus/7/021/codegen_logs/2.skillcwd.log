+GRID_MAX = 16
+FRAME_COUNT_MIN = 3
+FRAME_COUNT_MAX = 5
+EDGE_MARGIN = 1
+GEN_RETRY_LIMIT = 400
+LAYER_PLACEMENT_TRIES = 220
