+def _topological_order(
+    nodes: list[int] | tuple[int, ...],
+    edges: set[tuple[int, int]],
+    *,
+    require_unique: bool,
+) -> list[int] | None:
+    succ = {int(node): set() for node in nodes}
+    indeg = {int(node): 0 for node in nodes}
+    for a, b in edges:
+        a = int(a)
+        b = int(b)
+        if a == b or b in succ[a]:
+            if a == b:
+                return None
+            continue
+        succ[a].add(b)
+        indeg[b] += 1
