+def _visible_side_count(blockers: np.ndarray, bbox: tuple[int, int, int, int]) -> int:
+    visible = 0
+    for side in _side_slices(bbox):
+        if not bool(np.any(blockers[side])):
+            visible += 1
+    return visible
