+
+def _sample_bbox(rng: np.random.Generator, shape: tuple[int, int]) -> tuple[int, int, int, int] | None:
+    h, w = map(int, shape)
+    max_h = min(MAX_SIDE, h - 2 * EDGE_MARGIN)
+    max_w = min(MAX_SIDE, w - 2 * EDGE_MARGIN)
