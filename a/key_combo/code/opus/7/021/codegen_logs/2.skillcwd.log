+
+    metric_fns = (
+        lambda layer: (layer["bbox"][0], layer["bbox"][1]),
+        lambda layer: (layer["bbox"][1], layer["bbox"][0]),
+        lambda layer: (layer["bbox"][2], layer["bbox"][0]),
+        lambda layer: (layer["bbox"][3], layer["bbox"][1]),
