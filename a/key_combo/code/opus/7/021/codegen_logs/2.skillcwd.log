+                    visible_count = int(np.count_nonzero(g[mask] == int(color)))
+                    candidates.append(
+                        {
+                            "bbox": bbox,
+                            "mask": mask,
+                            "visible_count": visible_count,
+                            "hidden_count": int(mask.sum()) - visible_count,
+                        }
+                    )
