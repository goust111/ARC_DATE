+            return None
+        c0 = _randint(rng, c0_lo, c0_hi)
+        return (int(r0), int(c0), int(r1), int(c0 + width - 1))
+
+    if mode == 1:
+        shared_col = int(rng.choice([pw0, pw1]))
+        use_left = bool(rng.integers(0, 2))
+        c0 = shared_col if use_left else shared_col - width + 1
