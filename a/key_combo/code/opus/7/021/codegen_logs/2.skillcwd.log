+        if require_unique and len(frontier) != 1:
+            return None
+        node = int(frontier.pop(0))
+        order.append(node)
+        for nxt in sorted(succ[node]):
+            indeg[nxt] -= 1
+            if indeg[nxt] == 0:
+                frontier.append(nxt)
+        frontier.sort()
+
