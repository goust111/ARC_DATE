SPRITE_EDGE_JITTER_PROB = 0.55
SPRITE_EDGE_JITTER_STEPS_MIN, SPRITE_EDGE_JITTER_MIN_STOP = 1, 2
SPRITE_EDGE_JITTER_AREA_DIVISOR = 5
NEIGHBOR_DELTAS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))

