    src_r, src_c = src_pos
    dst_r, dst_c = dst_pos
    out = np.full((GRID_SIZE, GRID_SIZE), bg, dtype=int)
    paste(out, motif, src_r, src_c)
    paste(out, np.fliplr(motif), dst_r, dst_c)
    inp = out.copy()
    inp[dst_r : dst_r + h, dst_c : dst_c + w] = Color.BLACK
    return inp, out

