    regions = [(0, slot_h, 0, slot_w)]
    while len(regions) < n_regions:
        splittable = [
            i
            for i, (r0, r1, c0, c1) in enumerate(regions)
            if r1 - r0 >= REGION_SPLIT_MIN_SIZE or c1 - c0 >= REGION_SPLIT_MIN_SIZE
        ]
