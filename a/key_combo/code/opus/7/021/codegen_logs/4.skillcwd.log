```python
from __future__ import annotations

from collections import Counter
import numpy as np


BG = 0
CONTROL_COLORS = (1, 2, 3)
TEMPLATE_COLOR = 5
GEN_RETRIES = 500


def _get_bg(grid: np.ndarray) -> int:
    counts = Counter(map(int, np.asarray(grid).ravel()))
    return int(counts.most_common(1)[0][0])


def _true_runs(flags: np.ndarray) -> list[tuple[int, int]]:
    runs: list[tuple[int, int]] = []
    i = 0
    while i < len(flags):
        if not flags[i]:
            i += 1
            continue
        j = i
        while j < len(flags) and flags[j]:
            j += 1
        runs.append((i, j))
        i = j
    return runs


def _binary_majority(values: list[int]) -> int:
    counts = Counter(values)
    zeros = counts.get(BG, 0)
    greys = counts.get(TEMPLATE_COLOR, 0)
    assert zeros != greys, "expected a unique majority at every voted position"
    return TEMPLATE_COLOR if greys > zeros else BG


def _recover_templates(
    grid: np.ndarray,
) -> tuple[list[tuple[int, int]], list[tuple[int, int]], dict[int, np.ndarray]]:
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = _get_bg(g)
    assert bg == BG, "expected black background"

    fg = g != bg
    row_runs = _true_runs(fg.any(axis=1))
    col_runs = _true_runs(fg.any(axis=0))
    assert len(row_runs) >= 3 and len(col_runs) >= 3, "expected a slot array"

    slot_h = row_runs[0][1] - row_runs[0][0]
    slot_w = col_runs[0][1] - col_runs[0][0]
    assert slot_h == slot_w and slot_h in (3, 4), "expected 3x3 or 4x4 slots"
    assert all(r1 - r0 == slot_h for r0, r1 in row_runs)
    assert all(c1 - c0 == slot_w for c0, c1 in col_runs)
    assert all(row_runs[i + 1][0] - row_runs[i][1] == 1 for i in range(len(row_runs) - 1))
    assert all(col_runs[i + 1][0] - col_runs[i][1] == 1 for i in range(len(col_runs) - 1))

    groups: dict[int, list[np.ndarray]] = {color: [] for color in CONTROL_COLORS}
    for r0, r1 in row_runs:
        for c0, c1 in col_runs:
            block = g[r0:r1, c0:c1]
            assert block.shape == (slot_h, slot_w)
            control = int(block[0, 0])
            assert control in CONTROL_COLORS, "top-left cell of each slot must be a control pixel"
            assert np.all(np.isin(block[1:, 1:], (BG, TEMPLATE_COLOR)))
            assert np.all(np.isin(block[0, 1:], (BG, TEMPLATE_COLOR)))
            assert np.all(np.isin(block[1:, 0], (BG, TEMPLATE_COLOR)))
            groups[control].append(block)

    used = {color: blocks for color, blocks in groups.items() if blocks}
    assert len(used) >= 2, "expected at least two control groups"

    restored: dict[int, np.ndarray] = {}
    for color, blocks in used.items():
        assert len(blocks) >= 3, "each used control color must appear in at least three slots"
        template = np.full((slot_h, slot_w), bg, dtype=int)
        template[0, 0] = color
        for r in range(slot_h):
            for c in range(slot_w):
                if (r, c) == (0, 0):
                    continue
                template[r, c] = _binary_majority([int(block[r, c]) for block in blocks])
        restored[color] = template
    return row_runs, col_runs, restored


def main(grid: np.ndarray) -> np.ndarray:
    """Restore each control-color group of noisy slots by groupwise majority vote and stamp the clean template back into every slot.

    Input structure:
    - The background is black.
    - Foreground pixels form a regular rectangular array of equally sized 3x3 or 4x4 slots separated by one black row and one black column.
    - The top-left cell of each slot is a red, blue, or green control pixel; the remaining cells are black or grey.
    - Slots with the same control color are noisy copies of one shared hidden grey template, while different control colors correspond to different templates.

    Rule:
    - Locate the slot array from the repeated non-background row and column bands.
    - Read the control color from the top-left cell of every slot and group slots by that color.
    - For each group, vote independently at every relative slot position except the top-left control cell, using the majority of black versus grey.
    - Replace every slot by its group's recovered template while keeping the original control pixel unchanged.

    Key insight:
    - A single global vote is insufficient because multiple underlying templates coexist; the control pixel color is the only reliable cue for which noisy copies should be pooled together.
    """
    g = np.asarray(grid, dtype=int)
    row_runs, col_runs, restored = _recover_templates(g)
    out = np.full_like(g, BG)
    for r0, r1 in row_runs:
        for c0, c1 in col_runs:
            control = int(g[r0, c0])
            out[r0:r1, c0:c1] = restored[control]
    return out


def _build_mask_library(size: int) -> dict[int, list[np.ndarray]]:
    coords = [(r, c) for r in range(size) for c in range(size) if (r, c) != (0, 0)]
    grouped: dict[int, list[np.ndarray]] = {}
    for bits in range(1, 1 << len(coords)):
        mask = np.zeros((size, size), dtype=bool)
        ones = 0
        for idx, (r, c) in enumerate(coords):
            if (bits >> idx) & 1:
                mask[r, c] = True
                ones += 1
        if ones < size + 1 or ones > len(coords) - 1:
            continue
        if not mask.any(axis=1).all():
            continue
        if not mask.any(axis=0).all():
            continue
        grouped.setdefault(ones, []).append(mask)
    return grouped


MASK_LIBRARY = {3: _build_mask_library(3), 4: _build_mask_library(4)}


def _hamming(a: np.ndarray, b: np.ndarray) -> int:
    return int(np.sum(a != b))


def _choose_templates(size: int, rng: np.random.Generator) -> dict[int, np.ndarray] | None:
    grouped = MASK_LIBRARY[size]
    counts = sorted(grouped)
    if not counts:
        return None

    lo = int(np.ceil((size * size - 1) * 0.35))
    hi = int(np.floor((size * size - 1) * 0.7))
    usable = [count for count in counts if lo <= count <= hi]
    if not usable:
        usable = counts

    min_distance = size + 1
    for _ in range(400):
        common_count = int(rng.choice(usable))
        pool = grouped[common_count]
        idxs = rng.permutation(len(pool))
        first = second = None
        for i in idxs:
            a = pool[int(i)]
            for j in idxs:
                if i == j:
                    continue
                b = pool[int(j)]
                if _hamming(a, b) >= min_distance:
                    first, second = a, b
                    break
            if first is not None:
                break
        if first is None:
            continue

        third = None
        count_order = rng.permutation(len(usable))
        for idx in count_order:
            count = usable[int(idx)]
            for cand_idx in rng.permutation(len(grouped[count])):
                cand = grouped[count][int(cand_idx)]
                if _hamming(cand, first) >= min_distance and _hamming(cand, second) >= min_distance:
                    third = cand
                    break
            if third is not None:
                break
        if third is None:
            continue

        return {
            1: first.copy(),
            2: second.copy(),
            3: third.copy(),
        }
    return None


def _sample_color_layout(rows: int, cols: int, rng: np.random.Generator) -> np.ndarray | None:
    total = rows * cols
    base = np.full(3, 3, dtype=int)
    extra = total - int(base.sum())
    for _ in range(300):
        counts = base + rng.multinomial(extra, [1 / 3, 1 / 3, 1 / 3])
        labels = np.repeat(np.array(CONTROL_COLORS, dtype=int), counts)
        rng.shuffle(labels)
        layout = labels.reshape(rows, cols)
        ok = True
        for color in CONTROL_COLORS:
            rr, cc = np.where(layout == color)
            if len(set(map(int, rr))) < 2 or len(set(map(int, cc))) < 2:
                ok = False
                break
        if ok:
            return layout
    return None


def _render_grid(
    slot_layout: np.ndarray,
    templates: dict[int, np.ndarray],
    top: int,
    left: int,
    bottom: int,
    right: int,
) -> np.ndarray:
    rows, cols = slot_layout.shape
    size = next(iter(templates.values())).shape[0]
    body_h = rows * size + (rows - 1)
    body_w = cols * size + (cols - 1)
    grid = np.zeros((top + body_h + bottom, left + body_w + right), dtype=int)
    for sr in range(rows):
        for sc in range(cols):
            color = int(slot_layout[sr, sc])
            r0 = top + sr * (size + 1)
            c0 = left + sc * (size + 1)
            patch = np.full((size, size), BG, dtype=int)
            patch[0, 0] = color
            patch[templates[color]] = TEMPLATE_COLOR
            patch[0, 0] = color
            grid[r0:r0 + size, c0:c0 + size] = patch
    return grid


def _apply_noise(
    slot_layout: np.ndarray,
    templates: dict[int, np.ndarray],
    rng: np.random.Generator,
) -> dict[tuple[int, int], np.ndarray] | None:
    rows, cols = slot_layout.shape
    size = next(iter(templates.values())).shape[0]
    per_color_slots: dict[int, list[tuple[int, int]]] = {color: [] for color in CONTROL_COLORS}
    patches: dict[tuple[int, int], np.ndarray] = {}
    for sr in range(rows):
        for sc in range(cols):
            color = int(slot_layout[sr, sc])
            patch = np.full((size, size), BG, dtype=int)
            patch[0, 0] = color
            patch[templates[color]] = TEMPLATE_COLOR
            patch[0, 0] = color
            patches[(sr, sc)] = patch
            per_color_slots[color].append((sr, sc))

    slot_cap = max(1, int(np.floor((size * size - 1) * 0.25)))
    remaining = {pos: slot_cap for pos in patches}
    group_flip_counts = {color: 0 for color in CONTROL_COLORS}
    positions = [(r, c) for r in range(size) for c in range(size) if (r, c) != (0, 0)]

    for color in CONTROL_COLORS:
        slots = per_color_slots[color]
        max_k = (len(slots) - 1) // 2
        assert max_k >= 1
        local_positions = positions.copy()
        rng.shuffle(local_positions)
        for r, c in local_positions:
            if rng.random() >= 0.45:
                continue
            available = [pos for pos in slots if remaining[pos] > 0]
            if not available:
                continue
            limit = min(max_k, len(available))
            if limit <= 0:
                continue
            k = int(rng.integers(1, limit + 1))
            picked_idx = rng.choice(len(available), size=k, replace=False)
            for idx in np.atleast_1d(picked_idx):
                pos = available[int(idx)]
                patches[pos][r, c] = BG if templates[color][r, c] else TEMPLATE_COLOR
                remaining[pos] -= 1
                group_flip_counts[color] += 1
        if group_flip_counts[color] == 0:
            force_slots = [pos for pos in slots if remaining[pos] > 0]
            if not force_slots:
                return None
            pos = force_slots[int(rng.integers(len(force_slots)))]
            choices = [
                (r, c)
                for r, c in positions
                if patches[pos][r, c] == (TEMPLATE_COLOR if templates[color][r, c] else BG)
            ]
            if not choices:
                return None
            r, c = choices[int(rng.integers(len(choices)))]
            patches[pos][r, c] = BG if templates[color][r, c] else TEMPLATE_COLOR
            remaining[pos] -= 1
            group_flip_counts[color] += 1

    if not all(count > 0 for count in group_flip_counts.values()):
        return None
    return patches


def _materialize_from_patches(
    slot_layout: np.ndarray,
    patches: dict[tuple[int, int], np.ndarray],
    top: int,
    left: int,
    bottom: int,
    right: int,
) -> np.ndarray:
    rows, cols = slot_layout.shape
    size = next(iter(patches.values())).shape[0]
    body_h = rows * size + (rows - 1)
    body_w = cols * size + (cols - 1)
    grid = np.zeros((top + body_h + bottom, left + body_w + right), dtype=int)
    for (sr, sc), patch in patches.items():
        r0 = top + sr * (size + 1)
        c0 = left + sc * (size + 1)
        grid[r0:r0 + size, c0:c0 + size] = patch
    return grid


def _global_majority_template(patches: dict[tuple[int, int], np.ndarray]) -> np.ndarray | None:
    blocks = list(patches.values())
    size = blocks[0].shape[0]
    template = np.full((size, size), BG, dtype=int)
    for r in range(size):
        for c in range(size):
            if (r, c) == (0, 0):
                continue
            values = [int(block[r, c]) for block in blocks]
            counts = Counter(values)
            zeros = counts.get(BG, 0)
            greys = counts.get(TEMPLATE_COLOR, 0)
            if zeros == greys:
                return None
            template[r, c] = TEMPLATE_COLOR if greys > zeros else BG
    return template


def _semantic_checks(
    inp: np.ndarray,
    out: np.ndarray,
    slot_layout: np.ndarray,
    templates: dict[int, np.ndarray],
    patches: dict[tuple[int, int], np.ndarray],
) -> bool:
    if np.array_equal(inp, out):
        return False
    if not np.array_equal(main(inp), out):
        return False

    clean_counts = [int(mask.sum()) for mask in templates.values()]
    if len(set(clean_counts)) == len(clean_counts):
        return False

    noisy_counts: dict[int, set[int]] = {color: set() for color in CONTROL_COLORS}
    rows, cols = slot_layout.shape
    for sr in range(rows):
        for sc in range(cols):
            color = int(slot_layout[sr, sc])
            noisy_counts[color].add(int(np.sum(patches[(sr, sc)] == TEMPLATE_COLOR)))
    overlap = False
    for i, a in enumerate(CONTROL_COLORS):
        for b in CONTROL_COLORS[i + 1 :]:
            if noisy_counts[a] & noisy_counts[b]:
                overlap = True
    if not overlap:
        return False

    global_template = _global_majority_template(patches)
    if global_template is not None:
        if all(
            np.array_equal(global_template, np.where(templates[color], TEMPLATE_COLOR, BG))
            for color in CONTROL_COLORS
        ):
            return False

        wrong = out.copy()
        fg = inp != BG
        row_runs = _true_runs(fg.any(axis=1))
        col_runs = _true_runs(fg.any(axis=0))
        for r0, r1 in row_runs:
            for c0, c1 in col_runs:
                control = int(inp[r0, c0])
                patch = global_template.copy()
                patch[0, 0] = control
                wrong[r0:r1, c0:c1] = patch
        if np.array_equal(wrong, out):
            return False
    return True


def _generate_one(rng: np.random.Generator) -> np.ndarray | None:
    size = int(rng.choice([3, 4]))
    rows = int(rng.choice([3, 4]))
    cols = int(rng.choice([3, 4]))
    templates = _choose_templates(size, rng)
    if templates is None:
        return None
    slot_layout = _sample_color_layout(rows, cols, rng)
    if slot_layout is None:
        return None

    body_h = rows * size + (rows - 1)
    body_w = cols * size + (cols - 1)
    max_margin_h = 30 - body_h
    max_margin_w = 30 - body_w
    if max_margin_h < 0 or max_margin_w < 0:
        return None
    top = int(rng.integers(0, min(5, max_margin_h) + 1))
    bottom = int(rng.integers(0, min(5, max_margin_h - top) + 1))
    left = int(rng.integers(0, min(5, max_margin_w) + 1))
    right = int(rng.integers(0, min(5, max_margin_w - left) + 1))

    clean = _render_grid(slot_layout, templates, top, left, bottom, right)
    patches = _apply_noise(slot_layout, templates, rng)
    if patches is None:
        return None
    inp = _materialize_from_patches(slot_layout, patches, top, left, bottom, right)
    if not _semantic_checks(inp, clean, slot_layout, templates, patches):
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = np.random.default_rng()
    for _ in range(GEN_RETRIES):
        grid = _generate_one(rng)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid puzzle instance")
