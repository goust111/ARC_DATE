+    high = np.asarray(counts) >= thresholds[0]
+    runs: list[tuple[int, int]] = []
+    i = 0
+    while i < len(high):
+        if not high[i]:
+            i += 1
+            continue
+        j = i
+        while j < len(high) and high[j]:
