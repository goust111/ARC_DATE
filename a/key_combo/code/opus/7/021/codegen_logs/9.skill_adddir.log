+def _sample_layout(rng: np.random.Generator) -> tuple[int, int, list[int], list[int]] | None:
+    slot_rows = int(rng.integers(3, 5))
+    slot_cols = int(rng.integers(3, 5))
+    row_gap = int(rng.integers(1, 4))
+    col_gap = int(rng.integers(1, 4))
