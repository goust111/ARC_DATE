+            assert len(colors) == 1, "each slot must use a single non-background color"
+            rr = br * OUTPUT_STRIDE
+            cc = bc * OUTPUT_STRIDE
+            out[rr : rr + EXPANDED_SIZE, cc : cc + EXPANDED_SIZE] = _expand_slot(slot)
