+    if any(int(r) in dense_rows or int(c) in dense_cols for r, c in noise_coords):
+        return False
+    if len({int(r) for r, _ in noise_coords}) != len(noise_coords):
+        return False
+    if len({int(c) for _, c in noise_coords}) != len(noise_coords):
+        return False
+
