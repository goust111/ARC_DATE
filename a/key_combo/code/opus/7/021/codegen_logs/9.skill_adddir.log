+    dense_rows = {r for r0 in row_starts for r in range(r0, r0 + SLOT_SIZE)}
+    dense_cols = {c for c0 in col_starts for c in range(c0, c0 + SLOT_SIZE)}
+    free_rows = [r for r in range(height) if r not in dense_rows]
