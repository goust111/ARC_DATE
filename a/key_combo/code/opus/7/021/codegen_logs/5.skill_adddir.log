+
+def _component_sizes(mask_cells: set[tuple[int, int]]) -> list[int]:
+    remaining = set(mask_cells)
+    sizes = []
+    while remaining:
+        start = remaining.pop()
+        q = [start]
+        size = 1
+        while q:
+            r, c = q.pop()
+            for nb in _neighbors4(r, c):
+                if nb in remaining:
+                    remaining.remove(nb)
+                    q.append(nb)
+                    size += 1
