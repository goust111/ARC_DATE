+
+
+def _sample_sizes(total_area: int, piece_count: int) -> list[int]:
+    sizes = []
+    want_tie = piece_count >= 4 and random.random() < 0.6
+    repeated = random.randint(2, 4) if want_tie else None
+    remaining = total_area
+    for slots_left in range(piece_count, 0, -1):
+        lo = max(2, remaining - 5 * (slots_left - 1))
+        hi = min(5, remaining - 2 * (slots_left - 1))
+        options = list(range(lo, hi + 1))
+        if repeated in options and sizes.count(repeated) < 2 and random.random() < 0.7:
+            size = repeated
+        else:
+            size = random.choice(options)
+        sizes.append(size)
+        remaining -= size
+    random.shuffle(sizes)
+    return sizes
+
+
+def _shape_signature(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    return tuple(sorted(map(tuple, _crop_coords(coords).tolist())))
+
+
+def _generate_partition(n: int) -> list[dict] | None:
+    total_area = n * n - n
+    lo = max(3, (total_area + 4) // 5)
+    hi = min(8, total_area // 2)
