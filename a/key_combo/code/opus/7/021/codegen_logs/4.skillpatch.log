    out, slot_controls = _build_output(rows, cols, marker_colors, mask_by_color)
    inp = _render_input(
        rows, cols, num_entries, out.shape[0], out.shape[1], marker_colors, mask_by_color, slot_controls
    )
    if inp is None:
        return None

    try:
        if np.array_equal(main(inp), out):
