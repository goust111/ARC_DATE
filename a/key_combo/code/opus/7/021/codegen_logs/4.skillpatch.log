  "summary": "Repeat each colored seed mask across its rectangular cavity while preserving wall pixels and mask gaps.",
  "type": "symmetry/pattern",
  "src": "rectangular non-wall cavities, each containing empty pixels and one colored seed mask",
  "transform": "use each seed-color bbox as the periodic tile for its cavity; repeat it in both directions with the seed's phase, leaving tile gaps empty"
}
</annotation>
