    """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
    bg = int(background)
    a = object1
    b = object2
    H1, W1 = a.shape
    H2, W2 = b.shape

    dr = int(r2) - int(r1)
    dc = int(c2) - int(c1)

    ra0 = max(0, dr)
    ca0 = max(0, dc)
