                break
        if not placed:
            raise AssertionError('piece could not be placed')
    return out, placements


def main(grid):
    g = np.asarray(grid, dtype=int)
    n = int(np.sum(g[:, -1] == GRAY))
    assert 4 <= n <= 6
    assert np.all(g[:n, -1] == GRAY)
    assert np.all(g[n:, -1] == BG)
    comps = find_components(g[:, :-1])
    assert comps and all(comp['color'] "'!= GRAY for comp in comps)
    total = sum(comp['"'area'] for comp in comps)
    assert total == n*n - n
    pieces = []
    for comp in comps:
        r0,c0,r1,c1 = comp['bbox']
        local = comp['coords'] - np.array([r0,c0])
        assert 2 <= comp['area'] <= 5
        pieces.append({'color': comp['color'], 'area': comp['area'], 'bbox': comp['bbox'], 'shape': local})
    out, _ = pack_pieces(pieces, n, forbid_diag=True)
    assert np.count_nonzero(out == BG) == 0
    return out


def all_cells(n):
    return {(r,c) for r in range(n) for c in range(n) if r "'!= c}


def connected_components(cells):
    cells = set(cells)
    comps = []
    while cells:
        start = next(iter(cells))
        cells.remove(start)
        comp = {start}
        stack = [start]
        while stack:
            cell = stack.pop()
            for nb in neighbors4(cell):
                if nb in cells:
                    cells.remove(nb)
                    comp.add(nb)
                    stack.append(nb)
        comps.append(comp)
    return comps


def component_sizes_fit(cells, sizes):
    if not sizes:
        return not cells
    caps = tuple(sorted((len(comp) for comp in connected_components(cells)), reverse=True))
    sizes = tuple(sorted(sizes, reverse=True))
    if sum(caps) != sum(sizes):
        return False
    memo = {}
    def rec(i, capacities):
        key = (i, capacities)
        if key in memo:
            return memo[key]
        if i == len(sizes):
            ans = all(cap == 0 for cap in capacities)
            memo[key] = ans
            return ans
        size = sizes[i]
        tried = set()
        for j, cap in enumerate(capacities):
            if cap < size or cap in tried:
                continue
            tried.add(cap)
            nxt = list(capacities)
            nxt[j] -= size
            nxt = tuple(sorted(nxt, reverse=True))
            if rec(i+1, nxt):
                memo[key] = True
                return True
        memo[key] = False
        return False
    return rec(0, caps)


def enumerate_anchor_subsets(cells, size, anchor):
    cells = set(cells)
    results = set()
    def rec(subset, frontier):
        if len(subset) == size:
            results.add(tuple(sorted(subset)))
            return
        if len(subset) + len(frontier) < size:
            return
        for cell in sorted(list(frontier)):
            new_subset = set(subset)
            new_subset.add(cell)
            new_frontier = set(frontier)
            new_frontier.remove(cell)
            for nb in neighbors4(cell):
                if nb in cells and nb not in new_subset:
                    new_frontier.add(nb)
            rec(new_subset, new_frontier)
    rec({anchor}, {nb for nb in neighbors4(anchor) if nb in cells})
    return [set(x) for x in results]


def choose_sizes(total, require_tie):
    for _ in range(300):
        kmin = (total + 4) // 5
        kmax = min(8, total // 2)
        k = random.randint(kmin, kmax)
        rem = total
        sizes = []
        for i in range(k):
            left = k - i - 1
            lo = max(2, rem - 5 * left)
            hi = min(5, rem - 2 * left)
            if lo > hi:
                break
            sizes.append(random.randint(lo, hi))
            rem -= sizes[-1]
        else:
            sizes.sort(reverse=True)
            if rem != 0:
                continue
            counts = Counter(sizes)
            if require_tie and not any(v >= 2 for v in counts.values()):
                continue
            return sizes
    return None


def build_partition(n, sizes):
    def rec(remaining, rest_sizes):
        if not rest_sizes:
            return [] if not remaining else None
        size = rest_sizes[0]
        if len(rest_sizes) == 1:
            return [set(remaining)] if len(remaining) == size and len(connected_components(remaining)) == 1 else None
        anchor = min(remaining)
        options = enumerate_anchor_subsets(remaining, size, anchor)
        random.shuffle(options)
        for subset in options:
            rem = remaining - subset
            if not component_sizes_fit(rem, rest_sizes[1:]):
                continue
            tail = rec(rem, rest_sizes[1:])
            if tail is not None:
                return [subset] + tail
        return None
    return rec(all_cells(n), tuple(sizes))


def absolute_cells(shape, r0, c0):
    return {(r0 + int(r), c0 + int(c)) for r,c in shape}


def can_place(shape, r0, c0, H, W, occupied):
    cells = absolute_cells(shape, r0, c0)
    if any(r < 1 or r >= H-1 or c < 1 or c >= W-2 for r,c in cells):
        return False
    if any(cell in occupied for cell in cells):
        return False
    for r,c in cells:
        for nr,nc in neighbors4((r,c)):
            if (nr,nc) in occupied and (nr,nc) not in cells:
                return False
    return True


def scatter(n, partition, require_reflection):
    H = random.randint(max(14, n + 8), 20)
    W = random.randint(max(14, n + 8), 20)
    grid = np.full((H,W), BG, dtype=int)
    grid[:n,-1] = GRAY
    occupied = set()
    colors = random.sample(PALETTE, len(partition))
    pieces = []
    reflected_used = False
    changed_used = False
    eligible_reflect = [i for i, cells in enumerate(partition) if len(orientations(normalize(np.array(sorted(cells), dtype=int)))) > 4]
    forced_reflect_idx = random.choice(eligible_reflect) if require_reflection and eligible_reflect else None
    for i, (cells, color) in enumerate(zip(partition, colors)):
        canonical = normalize(np.array(sorted(cells), dtype=int))
        vars_ = orientations(canonical)
        if forced_reflect_idx == i:
            reflected_indices = [j for j in range(len(vars_)) if j >= 4]
            idx = random.choice(reflected_indices)
        else:
            weights = [1] + [3]*(len(vars_)-1)
            idx = random.choices(range(len(vars_)), weights=weights, k=1)[0]
        shape = vars_[idx]
        reflected_used |= idx >= 4 and len(vars_) > 4
        changed_used |= idx != 0
        pieces.append({'"'color': color, 'area': len(cells), 'shape': shape})
    order = list(range(len(pieces)))
    random.shuffle(order)
    for idx in order:
        shape = pieces[idx]['shape']
        h = int(shape[:,0].max()) + 1
        w = int(shape[:,1].max()) + 1
        candidates = [(r,c) for r in range(1, H-h) for c in range(1, W-1-w)]
        random.shuffle(candidates)
        for r0,c0 in candidates:
            if can_place(shape, r0, c0, H, W, occupied):
                cells_abs = absolute_cells(shape, r0, c0)
                for r,c in cells_abs:
                    grid[r,c] = pieces[idx]['color']
                occupied |= cells_abs
                pieces[idx]['bbox'] = bbox_of_coords(list(cells_abs))
                break
        else:
            return None
    return grid, changed_used, reflected_used


def validate(inp, require_reflection=False):
    out = main(inp)
    n = out.shape[0]
    comps = find_components(inp[:, :-1])
    assert len(comps) >= 3
    pieces = []
    for comp in comps:
        r0,c0,r1,c1 = comp['bbox']
        pieces.append({'color': comp['color'], 'area': comp['area'], 'bbox': comp['bbox'], 'shape': comp['coords'] - np.array([r0,c0])})
    alt, _ = pack_pieces(pieces, n, forbid_diag=False)
    assert np.any(np.diag(alt) "'!= BG)
    assert not np.array_equal(alt, out)
    return out


def generate_input():
    for _ in range(800):
        n = random.randint(4,6)
        require_tie = random.random() < 0.6
        require_reflection = random.random() < 0.35
        sizes = choose_sizes(n*n-n, require_tie)
        if sizes is None:
            continue
        partition = build_partition(n, sizes)
        if partition is None:
            continue
        scat = scatter(n, partition, require_reflection)
        if scat is None:
            continue
        inp, changed, reflected = scat
        if not changed:
            continue
        if require_reflection and not reflected:
            continue
        try:
            validate(inp, require_reflection=require_reflection)
        except AssertionError:
            continue
        return inp
    raise RuntimeError('"'gen failed')

sigs = set()
ns = Counter()
for i in range(100):
    inp = generate_input()
    out = main(inp)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    ns[out.shape[0]] += 1
print('variants', len(sigs), 'n_dist', dict(ns))
