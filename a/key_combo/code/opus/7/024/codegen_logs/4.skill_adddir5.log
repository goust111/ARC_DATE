    return True


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is None:
            continue
        if _validate_input(grid):
            return grid
    raise RuntimeError("failed to generate a valid input for puzzle 4")

