+    return mask
+
+
+def _side_candidates(mask: np.ndarray, side: str) -> tuple[list[int], list[int]]:
+    H, W = mask.shape
+    tabs: list[int] = []
+    notches: list[int] = []
+
+    def tab_ok(rr: int, cc: int) -> bool:
