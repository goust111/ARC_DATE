+    else:
+        for r in range(1, H - 1):
+            cols = np.flatnonzero(mask[r, :])
+            if cols.size == 0:
+                continue
+            left = int(cols.min())
+            right = int(cols.max())
+            if side == "left":
+                if left > 0 and tab_ok(r, left - 1):
+                    tabs.append(r)
+                if left > 0 and notch_ok(r, right, (0, 1)):
