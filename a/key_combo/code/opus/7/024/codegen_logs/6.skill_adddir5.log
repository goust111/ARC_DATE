+    return {
+        "coords": comps[0],
+        "bbox": _bbox(comps[0]),
+        "tabs": tabs,
+        "notches": notches,
+        "side": tab_side,
+        "t": len(tabs),
+    }
+
+
+def _complete_blue(mask: np.ndarray) -> np.ndarray:
