+    return tabs
+
+
+def _notch_sources(mask: np.ndarray, tab_cells: set[tuple[int, int]]) -> list[dict]:
+    mask = np.asarray(mask, dtype=bool)
+    H, W = mask.shape
+    notches: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            if bool(mask[r, c]):
+                continue
+            fg_dirs: list[tuple[int, int]] = []
+            bg_dirs: list[tuple[int, int]] = []
+            for dr, dc in DIRS4:
+                rr = r + dr
+                cc = c + dc
