+    elif missing == "TL":
+        mask[:, w - arm_w :] = True
+        mask[h - arm_h :, :] = True
+    elif missing == "BR":
+        mask[:, :arm_w] = True
+        mask[:arm_h, :] = True
+    else:
+        mask[:, w - arm_w :] = True
+        mask[:arm_h, :] = True
