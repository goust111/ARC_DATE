+
+def _spaced_subsets(values: list[int], size: int) -> list[tuple[int, ...]]:
+    values = sorted(set(int(v) for v in values))
+    out: list[tuple[int, ...]] = []
+
+    def rec(start: int, chosen: list[int]) -> None:
