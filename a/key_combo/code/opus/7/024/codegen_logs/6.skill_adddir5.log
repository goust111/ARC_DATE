+    blue_info = _analyze_blue(blue_mask)
+    anchor_side = _red_anchor_side(blue_mask, red_mask)
+    sheared_red = _shear_red(red_mask, blue_info["side"], blue_info["t"], anchor_side)
+    completed_blue = _complete_blue(blue_mask)
