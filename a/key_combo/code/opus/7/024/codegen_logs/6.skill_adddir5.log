+        "coords": comps[0],
+        "bbox": _bbox(comps[0]),
+        "tabs": tabs,
+        "notches": notches,
+        "side": tab_side,
+        "t": len(tabs),
+    }
+
+
+def _complete_blue(mask: np.ndarray) -> np.ndarray:
+    info = _analyze_blue(mask)
+    out = mask.copy()
+    for tab in info["tabs"]:
+        r, c = tab["cell"]
+        target = _project_opposite_edge(mask, tab["side"], r, c)
+        out[target] = False
+    for notch in info["notches"]:
