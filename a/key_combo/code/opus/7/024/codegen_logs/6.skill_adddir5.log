+        red_mask[r0 : r0 + rect_h, c0 : c0 + rect_w] = True
+
+        grid = np.zeros((H, W), dtype=int)
+        grid[blue_mask] = BLUE
+        grid[red_mask] = RED
+        meta["anchor"] = anchor
+        _semantic_validate(grid, meta)
