+
+    def rec(start: int, chosen: list[int]) -> None:
+        if len(chosen) == size:
+            out.append(tuple(chosen))
+            return
+        for i in range(start, len(values)):
+            v = values[i]
+            if chosen and abs(v - chosen[-1]) < 2:
