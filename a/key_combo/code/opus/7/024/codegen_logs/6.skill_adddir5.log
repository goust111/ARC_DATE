+        "left": [(r, c0) for r in range(r0, r1 + 1)],
+        "right": [(r, c1) for r in range(r0, r1 + 1)],
+    }
+    scores = {side: _edge_distance(blue_coords, cells) for side, cells in edges.items()}
+    best = min(scores.values())
