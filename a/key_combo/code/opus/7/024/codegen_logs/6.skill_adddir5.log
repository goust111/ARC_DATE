+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _neighbors4_coords(mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr, dc in DIRS4:
+        rr = int(r) + dr
+        cc = int(c) + dc
