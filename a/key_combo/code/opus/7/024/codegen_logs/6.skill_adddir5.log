+            bg_dirs: list[tuple[int, int]] = []
+            for dr, dc in DIRS4:
+                rr = r + dr
+                cc = c + dc
+                if _in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):
+                    fg_dirs.append((dr, dc))
+                else:
+                    bg_dirs.append((dr, dc))
+            if len(fg_dirs) != 3 or len(bg_dirs) != 1:
+                continue
+            outward = bg_dirs[0]
+            dr, dc = outward
+            if dr != 0:
+                side_a = (r, c - 1)
+                side_b = (r, c + 1)
+            else:
+                side_a = (r - 1, c)
+                side_b = (r + 1, c)
+            if side_a in tab_cells or side_b in tab_cells:
+                continue
+            notches.append(
