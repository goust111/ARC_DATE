+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_VEC = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+VEC_TO_SIDE = {v: k for k, v in SIDE_TO_VEC.items()}
+OPPOSITE_SIDE = {
+    "top": "bottom",
+    "bottom": "top",
+    "left": "right",
+    "right": "left",
+}
+
+GRID_ROWS_RANGE = (13, 16)
+GRID_COLS_RANGE = (15, 18)
