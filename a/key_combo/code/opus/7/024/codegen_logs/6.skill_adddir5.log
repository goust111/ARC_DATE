+
+
+def _edge_distance(blue_coords: np.ndarray, edge_cells: list[tuple[int, int]]) -> int:
+    best = 10**9
+    for er, ec in edge_cells:
+        d = np.abs(blue_coords[:, 0] - int(er)) + np.abs(blue_coords[:, 1] - int(ec))
+        best = min(best, int(d.min()))
