+    assert len(marker) == 1 and 4 <= marker[0]["area"] <= 8
+
+    movable = [comp for comp in _components(grid, ignore={BG, MAROON})]
+    assert len(movable) == 6
+
+    counts = Counter(int(comp["color"]) for comp in movable)
+    assert counts == Counter({BLUE: 2, RED: 2, GREEN: 2})
+
