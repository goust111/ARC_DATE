+        elif a[1] == b[1]:
+            branch_types.add("v")
+        else:
+            branch_types.add("l")
+        free = _path_free_count(_path_between(a, b), blocked)
+        assert free >= 3 and free % 2 == 1
+    assert branch_types == {"h", "v", "l"}
+    return {"moved": moved}
+
+
+def _generate_one(rng: random.Random) -> np.ndarray | None:
+    H = rng.choice((16, 18, 20))
+    W = rng.choice((15, 17, 19))
+
+    row_candidates = _central_candidates(3, H - 7, H)
+    col_candidates = _central_candidates(3, W - 7, W)
+    row_candidates = [r for r in row_candidates if any((r - c) % 2 for c in col_candidates)] or row_candidates
+    marker_top = rng.choice(row_candidates)
+    marker_left_pool = [c for c in col_candidates if (marker_top - c) % 2 != 0]
+    if not marker_left_pool:
+        return None
+    marker_left = rng.choice(marker_left_pool)
+
+    grid = np.full((H, W), BG, dtype=int)
+    marker_cells = np.argwhere(_MARKER == 1)
+    for rr, cc in marker_cells:
+        grid[marker_top + int(rr), marker_left + int(cc)] = MAROON
+
+    role_colors = dict(zip(("horizontal", "vertical", "elbow"), rng.sample([BLUE, RED, GREEN], 3)))
+    for role, slots in _ROLE_SLOTS.items():
+        color = role_colors[role]
+        for side, pos in slots:
+            cells = _place_object_cells(marker_top, marker_left, side, pos)
+            for r, c in cells:
+                if not (0 <= r < H and 0 <= c < W):
+                    return None
+                if int(grid[r, c]) != BG:
+                    return None
+            for r, c in cells:
+                grid[r, c] = color
+
+    k = rng.randrange(4)
+    if k:
+        grid = np.rot90(grid, k).copy()
+    if rng.random() < 0.5:
+        grid = np.fliplr(grid).copy()
+
+    _analyze_semantics(grid)
+    out = main(grid)
+    assert out.shape[0] <= 30 and out.shape[1] <= 30
+    assert int(np.count_nonzero(out == GREY)) >= 9
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_GEN_ATTEMPTS):
+        grid = _generate_one(random.Random())
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle input")

