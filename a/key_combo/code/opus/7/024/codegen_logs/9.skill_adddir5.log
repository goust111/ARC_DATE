+def _place_object_cells(marker_top: int, marker_left: int, side: str, pos: int) -> list[tuple[int, int]]:
+    if side == "T":
+        return [(marker_top - 1, marker_left + pos - 1 + k) for k in range(3)]
+    if side == "B":
+        return [(marker_top + 5, marker_left + pos - 1 + k) for k in range(3)]
+    if side == "L":
+        return [(marker_top + pos - 1 + k, marker_left - 1) for k in range(3)]
+    return [(marker_top + pos - 1 + k, marker_left + 4) for k in range(3)]
+
+
+def _central_candidates(start: int, stop: int, extent: int) -> list[int]:
+    vals = list(range(start, stop + 1))
+    center = extent / 2.0
+    filtered = [v for v in vals if abs((v + 2.5) - center) <= max(2.0, extent / 4.0)]
+    return filtered if filtered else vals
+
+
+def _path_free_count(path: list[tuple[int, int]], blocked: np.ndarray) -> int:
+    return sum(0 if blocked[r, c] else 1 for r, c in path)
+
+
+def _analyze_semantics(grid: np.ndarray) -> dict:
+    marker = [comp for comp in _components(grid, ignore={BG}) if int(comp["color"]) == MAROON]
+    assert len(marker) == 1 and 4 <= marker[0]["area"] <= 8
