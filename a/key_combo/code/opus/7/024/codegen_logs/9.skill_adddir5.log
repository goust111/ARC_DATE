from itertools import combinations
from collections import deque
DIRS=[(-1,0),(1,0),(0,-1),(0,1)]

def conn(shape):
    s=set(shape); q=deque([next(iter(s))]); seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in DIRS:
            nb=(r+dr,c+dc)
            if nb in s and nb not in seen:
                seen.add(nb); q.append(nb)
    return len(seen)==len(s)

def normalize(shape):
    rs=[r for r,c in shape]; cs=[c for r,c in shape]
    r0=min(rs); c0=min(cs)
    return tuple(sorted((r-r0,c-c0) for r,c in shape))

def contact_sets(shape):
    s=set(shape)
    rows=[r for r,c in s]; cols=[c for r,c in s]
    top=min(rows); bot=max(rows); left=min(cols); right=max(cols)
    return {
        'T':sorted(c for r,c in s if r==top),
        'B':sorted(c for r,c in s if r==bot),
        'L':sorted(r for r,c in s if c==left),
        'R':sorted(r for r,c in s if c==right),
        'maxr':bot, 'maxc':right, 'shape':s,
    }

def obj_cells(side,pos,maxr,maxc):
    if side=='T': return {( -1, pos-1+i) for i in range(3)}
    if side=='B': return {( maxr+1, pos-1+i) for i in range(3)}
    if side=='L': return {( pos-1+i, -1) for i in range(3)}
    return {( pos-1+i, maxc+1) for i in range(3)}

def moved_centroid(side,pos,maxr,maxc,H=30,W=30):
    if side=='T': return (0,pos)
    if side=='B': return (H-1,pos)
    if side=='L': return (pos,0)
    return (pos,W-1)

