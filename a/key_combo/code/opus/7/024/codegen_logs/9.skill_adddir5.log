+        dirs_seen.add(direction)
+        shifted = comp["coords"] + np.array(direction, dtype=int) * _steps_to_edge(grid.shape, comp["coords"], direction)
+        moved.append({"color": int(comp["color"]), "coords": shifted, "direction": direction})
+    assert len(dirs_seen) >= 3
+
+    canvas = np.full_like(grid, BG)
+    maroon_coords = marker[0]["coords"]
+    canvas[maroon_coords[:, 0], maroon_coords[:, 1]] = MAROON
+    for comp in moved:
+        coords = comp["coords"]
+        assert bool(np.all(canvas[coords[:, 0], coords[:, 1]] == BG))
+        canvas[coords[:, 0], coords[:, 1]] = int(comp["color"])
+    blocked = canvas != BG
+
+    by_color: dict[int, list[dict]] = {BLUE: [], RED: [], GREEN: []}
+    for comp in moved:
+        by_color[int(comp["color"])].append(comp)
+
+    branch_types: set[str] = set()
+    for color, pair in by_color.items():
+        assert len(pair) == 2
+        assert pair[0]["direction"] != pair[1]["direction"]
+        a = _centroid(pair[0]["coords"])
+        b = _centroid(pair[1]["coords"])
+        if a[0] == b[0]:
+            branch_types.add("h")
+        elif a[1] == b[1]:
+            branch_types.add("v")
+        else:
+            branch_types.add("l")
+        free = _path_free_count(_path_between(a, b), blocked)
+        assert free >= 3 and free % 2 == 1
+    assert branch_types == {"h", "v", "l"}
+    return {"moved": moved}
+
+
+def _generate_one(rng: random.Random) -> np.ndarray | None:
+    H = rng.choice((15, 17, 19))
+    W = rng.choice((15, 17, 19))
+
+    row_candidates = _central_candidates(2, H - 4, H)
+    col_candidates = _central_candidates(2, W - 8, W)
+    marker_top = rng.choice(row_candidates)
