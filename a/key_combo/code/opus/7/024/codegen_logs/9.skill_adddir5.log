+        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == BG))
+        out[coords[:, 0], coords[:, 1]] = int(comp["color"])
+
+    blocked = out != BG
+    by_color: dict[int, list[dict]] = {}
+    for comp in moved:
+        by_color.setdefault(int(comp["color"]), []).append(comp)
+
+    assert set(by_color) == {BLUE, RED, GREEN}
