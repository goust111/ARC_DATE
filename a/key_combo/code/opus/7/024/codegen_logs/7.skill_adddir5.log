def _line_mask(h: int, w: int) -> np.ndarray:
    """Create a seed mask along a diagonal line spanning the bbox, randomly flipped."""
    mask = np.zeros((h, w), dtype=bool)
    if h == 1:
        mask[0, :] = True
        return mask
    if w == 1:
        mask[:, 0] = True
        return mask
    steps = max(h, w)
    for i in range(steps):
