+    frame = _locate_frame(g)
+    fr0, fc0, fr1, fc1 = frame
+    gray_mask = g == GRAY
+    sprite_mask = gray_mask.copy()
+    sprite_mask[fr0 + 1 : fr1, fc0 + 1 : fc1] = False
