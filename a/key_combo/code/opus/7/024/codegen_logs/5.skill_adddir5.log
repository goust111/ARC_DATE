+        b_vals.append(u)
+        a_rows.append([0.0, 0.0, 0.0, x, y, 1.0, -v * x, -v * y])
+        b_vals.append(v)
+    params = np.linalg.solve(np.array(a_rows, dtype=float), np.array(b_vals, dtype=float))
+    return np.array(
+        [
+            [params[0], params[1], params[2]],
+            [params[3], params[4], params[5]],
+            [params[6], params[7], 1.0],
