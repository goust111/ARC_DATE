+                    if not np.all(grid[r0 + 1 : r1, c0] == LEFT_COLOR):
+                        continue
+                    if not np.all(grid[r0 + 1 : r1, c1] == RIGHT_COLOR):
+                        continue
+                    if not np.all(grid[r0 + 1 : r1, c0 + 1 : c1] == BLACK):
+                        continue
+                    candidates.append((r0, c0, r1, c1))
