+    positions: list[tuple[int, int]] = []
+    gap_r0 = max(0, fr0 - 1)
+    gap_c0 = max(0, fc0 - 1)
+    gap_r1 = min(h - 1, fr1 + 1)
+    gap_c1 = min(w - 1, fc1 + 1)
