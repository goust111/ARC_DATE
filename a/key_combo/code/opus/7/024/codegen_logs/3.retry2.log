  "path": "move straight away from the maroon contact side along the matching row or column",
  "dst": "furthest in-bounds position where the object reaches the grid edge",
  "trajectory": "translate each object once, preserving its shape and color",
  "transform": "clear each moving object from its original position; keep maroon markers unchanged"
}
</annotation>
<generation_spec>
