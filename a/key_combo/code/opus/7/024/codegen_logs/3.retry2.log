    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _component_dicts(
    grid: np.ndarray,
    *,
    bg: int,
    colors: tuple[int, ...] | list[int] | None = None,
) -> list[dict]:
    h, w = grid.shape
    if colors is None:
        color_list = sorted(set(map(int, np.unique(grid))) - {bg})
    else:
        color_list = [int(color) for color in colors if int(color) != bg]

    seen = np.zeros((h, w), dtype=bool)
    out: list[dict] = []
    for color in color_list:
        for r in range(h):
            for c in range(w):
                if seen[r, c] or int(grid[r, c]) != color:
                    continue
                q = deque([(r, c)])
                seen[r, c] = True
                coords: list[tuple[int, int]] = []
                while q:
                    rr, cc = q.popleft()
                    coords.append((rr, cc))
                    for nr, nc in _neighbors4(rr, cc):
                        if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
                            seen[nr, nc] = True
                            q.append((nr, nc))
                out.append({"color": color, "coords": np.array(coords, dtype=int), "area": len(coords)})
    return out


def _direction_name(vec: tuple[int, int]) -> str:
    for name, candidate in DIRS.items():
        if candidate == vec:
            return name
    raise ValueError(f"unknown direction {vec}")


def _outward_direction(grid: np.ndarray, coords: np.ndarray) -> tuple[int, int]:
    marker_touch_dirs: set[tuple[int, int]] = set()
    for r, c in coords:
        rr = int(r)
        cc = int(c)
        for dr, dc in DIRS.values():
            nr = rr + dr
            nc = cc + dc
            if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == MARKER:
                marker_touch_dirs.add((-dr, -dc))
    assert len(marker_touch_dirs) == 1, "each object must touch the marker from exactly one cardinal side"
    return next(iter(marker_touch_dirs))


def _steps_to_edge(shape: tuple[int, int], coords: np.ndarray, direction: tuple[int, int]) -> int:
    h, w = shape
    dr, dc = direction
    if dr < 0:
        return int(coords[:, 0].min())
    if dr > 0:
        return int(h - 1 - coords[:, 0].max())
    if dc < 0:
        return int(coords[:, 1].min())
    return int(w - 1 - coords[:, 1].max())


def _translate(coords: np.ndarray, direction: tuple[int, int], steps: int) -> np.ndarray:
    return coords + np.array(direction, dtype=int) * int(steps)


def _swept_cells(coords: np.ndarray, direction: tuple[int, int], steps: int) -> set[tuple[int, int]]:
    own = {tuple(map(int, cell)) for cell in coords.tolist()}
    swept: set[tuple[int, int]] = set()
    for step in range(1, steps + 1):
        shifted = _translate(coords, direction, step)
        for r, c in shifted:
            pos = (int(r), int(c))
            if pos not in own:
                swept.add(pos)
    return swept


def _round_half_up(values: np.ndarray) -> tuple[int, int]:
    mean_r = float(values[:, 0].mean())
    mean_c = float(values[:, 1].mean())
    return int(np.floor(mean_r + 0.5)), int(np.floor(mean_c + 0.5))


def _marker_coords(grid: np.ndarray) -> np.ndarray:
    coords = np.argwhere(grid == MARKER)
    assert len(coords) > 0
    return coords


def _build_histogram_overlay(
    shape: tuple[int, int],
    marker_coords: np.ndarray,
    counts: dict[str, int],
) -> set[tuple[int, int]]:
    center = _round_half_up(marker_coords)
    overlay: set[tuple[int, int]] = set()
    for name in DIR_ORDER:
        dr, dc = DIRS[name]
        for step in range(1, counts[name] + 1):
            rr = center[0] + dr * step
            cc = center[1] + dc * step
            assert _in_bounds(shape, rr, cc)
            overlay.add((rr, cc))
    return overlay


def main(grid: np.ndarray) -> np.ndarray:
    """
    Push marker-touching objects outward, then summarize the push directions as a gray compass histogram around the marker.

    Input structure:
    - The background is black and the fixed marker is a single maroon 4-connected cross or T-like component near the center.
    - The remaining foreground consists of several small monochromatic 4-connected objects around the marker.
    - Each moving object touches the maroon marker along exactly one cardinal side, which uniquely identifies whether it sits above, below, left, or right of the marker.

    Rule:
    - For each non-maroon object, infer its push direction as the direction directly away from its maroon contact side.
    - Erase the object from its original cells, then translate it straight along that direction until it touches the corresponding grid edge; keep the maroon marker fixed.
    - Count how many objects moved up, down, left, and right, compute the rounded marker centroid, and draw a gray bar of that length from the centroid outward in each matching direction.
    - If a gray bar cell would overlap the maroon marker, keep the maroon pixel instead.

    Key insight:
    - The same contact-side relation serves two roles at once: it launches each object outward and also contributes one directional vote to the central histogram.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    assert max(g.shape) <= 30
    bg = _get_bg(g)
    assert bg == BG

    marker_components = _component_dicts(g, bg=bg, colors=[MARKER])
    assert len(marker_components) == 1
    marker_coords = marker_components[0]["coords"]
    assert 5 <= len(marker_coords) <= 9

    out = g.copy()
    counts = {name: 0 for name in DIR_ORDER}
    moved: list[tuple[int, np.ndarray, str]] = []

    for comp in _component_dicts(g, bg=bg):
        color = int(comp["color"])
        if color == MARKER:
            continue
        coords = comp["coords"]

