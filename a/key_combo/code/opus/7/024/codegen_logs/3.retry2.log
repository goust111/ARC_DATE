+        occupied_output: set[tuple[int, int]],
+        reserved_swept: set[tuple[int, int]],
+        chosen: list[dict],
+    ) -> list[dict] | None:
+        if index == len(slots):
+            return chosen.copy()
 
+        direction = slots[index]
