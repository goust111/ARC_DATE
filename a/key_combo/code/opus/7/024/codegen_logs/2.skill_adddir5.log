spec:
  grid: 8x8 [observed]
  divider:
    colors: yellow(4) interior core + orange(7) border/walls
    connectivity: single 4-connected component (yellow+orange together)
    yellow: row-convex and column-convex blob; never adjacent to any moving region
    orange: 1-px-wide border separating yellow from moving regions and moving regions from each other
    partitioning: divider partitions entire grid into exactly N 4-connected monochrome outer regions
    pixel_fraction: 45-65% of grid
  regions:
    count: 2-4 outer regions, each a distinct non-yellow non-orange color
    each_region: single 4-connected component of one unique color, fills a wedge-shaped sector around divider
    size: 3-19 pixels per region
    edge_touching: every region touches at least 1 grid edge [observed]
    angular_separation: minimum gap between consecutive region centroids >= 80 degrees
    colors: any from palette except yellow(4) and orange(7); all distinct
  transform:
    static: yellow and orange pixels unchanged
    rule: sort outer regions by centroid angle (atan2 from divider centroid, screen-coord CW); rotate colors one step CW in that cyclic order
    output_shape: same as input

generation_strategy:
  approach: output-first (build output, then derive input by inverse rotation)
  steps:
    1. Choose N in 2-4. Pick N distinct colors (not yellow/orange).
    2. Place a convex yellow core near grid center; surround with 1-px orange border.
    3. Extend N orange spoke-walls from the core to grid edges, partitioning remaining space into N sectors.
    4. Flood-fill each sector with a unique color; this is the output grid.
    5. Derive input by rotating the sector colors one step counter-clockwise (inverse of the CW rotation rule).
    6. Validate all solver assertions: each color forms exactly one 4-connected region, unique angular order, yellow never adjacent to moving colors.
```
