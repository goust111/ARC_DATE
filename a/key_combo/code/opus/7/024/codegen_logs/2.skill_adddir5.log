+    colors: list[int] = []
+    areas: dict[str, set[int]] = {"chain": set(), "solid": set()}
+    bboxes: dict[str, set[tuple[int, int]]] = {"chain": set(), "solid": set()}
+    output_signatures = set()
+
+    for r0 in PANEL_ORIGINS:
+        for c0 in PANEL_ORIGINS:
