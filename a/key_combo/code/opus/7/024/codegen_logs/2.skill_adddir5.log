+            grid[r0 : r0 + PANEL_SIZE, c0 : c0 + PANEL_SIZE] = next(panel_iter)
+    return grid
+
+
+def _semantic_check(grid: np.ndarray) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+
+    for idx in SEPARATOR_IDXS:
