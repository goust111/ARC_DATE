from __future__ import annotations

import random
from collections import Counter, deque

import numpy as np


BG = 0
BLUE = 1
RED = 2
GREEN = 3
GREY = 5
MAROON = 9
DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def _components(grid: np.ndarray, ignore: set[int] | None = None) -> list[dict]:
    ignore = set() if ignore is None else {int(v) for v in ignore}
    H, W = grid.shape
    seen = np.zeros((H, W), dtype=bool)
    comps: list[dict] = []
    for r in range(H):
        for c in range(W):
            color = int(grid[r, c])
            if seen[r, c] or color in ignore:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for dr, dc in DIR4:
                    nr = rr + dr
                    nc = cc + dc
                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            arr = np.array(coords, dtype=int)
            comps.append({"color": color, "coords": arr, "area": len(coords)})
    return comps


def _outward_direction(grid: np.ndarray, coords: np.ndarray) -> tuple[int, int]:
    H, W = grid.shape
    dirs: set[tuple[int, int]] = set()
    for r, c in coords:
        rr = int(r)
        cc = int(c)
        for dr, dc in DIR4:
            nr = rr + dr
            nc = cc + dc
            if 0 <= nr < H and 0 <= nc < W and int(grid[nr, nc]) == MAROON:
                dirs.add((-dr, -dc))
    assert len(dirs) == 1, "each object must touch the maroon marker on exactly one side"
    return next(iter(dirs))


def _steps_to_edge(shape: tuple[int, int], coords: np.ndarray, direction: tuple[int, int]) -> int:
    H, W = shape
    dr, dc = direction
    if dr < 0:
        return int(coords[:, 0].min())
    if dr > 0:
        return int(H - 1 - coords[:, 0].max())
    if dc < 0:
        return int(coords[:, 1].min())
    return int(W - 1 - coords[:, 1].max())


def _centroid(coords: np.ndarray) -> tuple[int, int]:
    rows = coords[:, 0].astype(int)
    cols = coords[:, 1].astype(int)
    assert int(rows.sum()) % len(rows) == 0
    assert int(cols.sum()) % len(cols) == 0
    return int(rows.sum() // len(rows)), int(cols.sum() // len(cols))


def _segment(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
    r1, c1 = a
    r2, c2 = b
    if r1 == r2:
        step = 1 if c2 >= c1 else -1
        return [(r1, c) for c in range(c1, c2 + step, step)]
    step = 1 if r2 >= r1 else -1
    return [(r, c1) for r in range(r1, r2 + step, step)]


def _ordered_endpoints(a: tuple[int, int], b: tuple[int, int]) -> tuple[tuple[int, int], tuple[int, int]]:
    if a[0] == b[0]:
        return (a, b) if a[1] <= b[1] else (b, a)
    if a[1] == b[1]:
        return (a, b) if a[0] <= b[0] else (b, a)
    return (a, b) if a[0] < b[0] else (b, a)


def _path_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
    if a[0] == b[0] or a[1] == b[1]:
        start, end = _ordered_endpoints(a, b)
        return _segment(start, end)
    start, end = _ordered_endpoints(a, b)
    turn = (start[0], end[1])
    return _segment(start, turn) + _segment(turn, end)[1:]


def _draw_dashed_path(out: np.ndarray, path: list[tuple[int, int]], blocked: np.ndarray) -> None:
    dash_index = 0
    for r, c in path:
        if blocked[r, c]:
            continue
        if dash_index % 2 == 0 and int(out[r, c]) == BG:
            out[r, c] = GREY
        dash_index += 1


def main(grid: np.ndarray) -> np.ndarray:
    """
    Push maroon-touching color pairs to the boundary and connect each same-color pair with a grey dashed line.

    Input structure:
    - The background is black.
    - A single compact maroon marker component sits near the center.
    - Exactly six small 4-connected monochrome objects use colors blue, red, and green, with each color appearing in exactly two objects.
    - Every object touches the maroon marker on exactly one cardinal side and lies wholly above, below, left, or right of it.

    Rule:
    - For each non-maroon object, detect which side of the maroon marker it touches and push the whole object straight away from the marker until it reaches the grid boundary.
    - Keep the maroon marker unchanged and erase the original object positions.
    - After all pushes, pair the two objects of each color and connect their centroids with a grey dashed path: horizontal if the centroids share a row, vertical if they share a column, otherwise an L path that goes horizontally on the smaller-row centroid's row and then vertically.
    - Along each path, number only the cells that are not maroon and not part of a pushed object; paint the even-numbered such cells grey and leave the odd-numbered ones unchanged.
    - Draw blue-pair dashes first, red-pair dashes second, and green-pair dashes last; later lines do not overwrite earlier grey cells.

    Key insight:
    - The maroon component acts twice: first as a launcher that fixes each object's push direction, then as the geometric reference whose pushed landing positions determine both the pair endpoints and each dashed line's rhythm.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    assert g.ndim == 2 and H <= 30 and W <= 30
    assert int(np.min(g)) >= 0

    marker_comps = [comp for comp in _components(g, ignore={BG}) if int(comp["color"]) == MAROON]
    assert len(marker_comps) == 1

    movable = [comp for comp in _components(g, ignore={BG, MAROON})]
    assert len(movable) == 6

    out = g.copy()
    moved: list[dict] = []
    for comp in movable:
        color = int(comp["color"])
        coords = comp["coords"]
        direction = _outward_direction(g, coords)
        steps = _steps_to_edge(g.shape, coords, direction)
        assert steps >= 1

        own = {tuple(map(int, cell)) for cell in coords.tolist()}
        dr, dc = direction
        for step in range(1, steps + 1):
            swept = coords + np.array([dr * step, dc * step], dtype=int)
            for rr, cc in swept:
                loc = (int(rr), int(cc))
                if loc not in own:
                    assert int(g[loc]) == BG

        shifted = coords + np.array([dr * steps, dc * steps], dtype=int)
        out[coords[:, 0], coords[:, 1]] = BG
        moved.append({"color": color, "coords": shifted, "direction": direction})

    for comp in moved:
        coords = comp["coords"]
        assert bool(np.all(out[coords[:, 0], coords[:, 1]] == BG))
        out[coords[:, 0], coords[:, 1]] = int(comp["color"])

    blocked = out != BG
    by_color: dict[int, list[dict]] = {}
    for comp in moved:
        by_color.setdefault(int(comp["color"]), []).append(comp)

    assert set(by_color) == {BLUE, RED, GREEN}
    for color in (BLUE, RED, GREEN):
        pair = by_color[color]
        assert len(pair) == 2
        centroids = [_centroid(comp["coords"]) for comp in pair]
        path = _path_between(centroids[0], centroids[1])
        _draw_dashed_path(out, path, blocked)

    return out


_MARKER = np.array(
    [
        [1, 1, 1, 1, 1, 1],
        [0, 1, 0, 0, 0, 1],
    ],
    dtype=int,
)
_ROLE_SLOTS = {
    "horizontal": [("L", 0), ("R", 0)],
    "vertical": [("T", 1), ("B", 1)],
    "elbow": [("T", 4), ("B", 5)],
}
_GEN_ATTEMPTS = 400


def _place_object_cells(marker_top: int, marker_left: int, side: str, pos: int) -> list[tuple[int, int]]:
    if side == "T":
        return [(marker_top - 1, marker_left + pos - 1 + k) for k in range(3)]
    if side == "B":
        return [(marker_top + 2, marker_left + pos - 1 + k) for k in range(3)]
    if side == "L":
        return [(marker_top + pos - 1 + k, marker_left - 1) for k in range(3)]
    return [(marker_top + pos - 1 + k, marker_left + 6) for k in range(3)]


def _central_candidates(start: int, stop: int, extent: int) -> list[int]:
    vals = list(range(start, stop + 1))
    center = extent / 2.0
    filtered = [v for v in vals if abs((v + 2.5) - center) <= max(2.0, extent / 4.0)]
    return filtered if filtered else vals


def _path_free_count(path: list[tuple[int, int]], blocked: np.ndarray) -> int:
    return sum(0 if blocked[r, c] else 1 for r, c in path)


def _analyze_semantics(grid: np.ndarray) -> dict:
    marker = [comp for comp in _components(grid, ignore={BG}) if int(comp["color"]) == MAROON]
    assert len(marker) == 1 and 4 <= marker[0]["area"] <= 8

    movable = [comp for comp in _components(grid, ignore={BG, MAROON})]
    assert len(movable) == 6

    counts = Counter(int(comp["color"]) for comp in movable)
    assert counts == Counter({BLUE: 2, RED: 2, GREEN: 2})

    moved: list[dict] = []
    dirs_seen: set[tuple[int, int]] = set()
    for comp in movable:
        direction = _outward_direction(grid, comp["coords"])

