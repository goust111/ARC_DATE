+
+def _apply_mask(dst: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    h, w = dst.shape
+    mh, mw = mask.shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(h, r0 + mh)
+    cc1 = min(w, c0 + mw)
+    if rr0 >= rr1 or cc0 >= cc1:
