+    br_bb = info["bracket_bbox"]
+    ebr = expanded(br_bb)
+    for bb in sprite_boxes:
+        e2 = expanded(bb)
+        disjoint = ebr[2] < e2[0] or e2[2] < ebr[0] or ebr[3] < e2[1] or e2[3] < ebr[1]
