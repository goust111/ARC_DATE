+    anchor = info["bracket_bbox"][:2]
+    template_mask = info["template_mask"]
+    c_color = info["c_color"]
+    marker = info["marker"]
+    bracket_coords = info["bracket_coords"]
+    shape = grid.shape
+    k = info["k"]
+
