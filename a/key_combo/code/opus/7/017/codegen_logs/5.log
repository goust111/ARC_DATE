            if ok: cand.append((p,s))
    if not cand: return None
    mp=min(p for p,_ in cand)
    cand=[x for x in cand if x[0]==mp]
    return cand

def build_comp(p,s,a,w):
    if p==2:
        intervals=[(a,a+w),(a,a+w+s)]
    else:
        intervals=[(a,a+w),(a,a+w+s),(a+s,a+s+w)]
