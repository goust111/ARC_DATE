def touch(a,b):
    dil=b.copy()
    dil[1:] |= b[:-1]
    dil[:-1] |= b[1:]
    dil[:,1:] |= b[:,:-1]
    dil[:,:-1] |= b[:,1:]
    return np.any(a & dil)

