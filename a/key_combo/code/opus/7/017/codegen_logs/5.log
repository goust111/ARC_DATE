        mid=r0+(r1-r0+1)//2
        for r,c in comp:
            if r>=mid:
                out[r,c]=2
    return out

def global_recolor(full):
    out=np.where(full,1,0)
    b=bbox(full)
    r0,c0,r1,c1=b
    mid=r0+(r1-r0+1)//2
    rr=np.arange(10)[:,None]
    out[full & (rr>=mid)] = 2
    return out

