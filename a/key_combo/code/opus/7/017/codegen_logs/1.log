+def _run_to_last_color(grid: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> tuple[int, int]:
+    rr, cc = r + dr, c + dc
+    last_r, last_c = r, c
+    while in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == int(color):
