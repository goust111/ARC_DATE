def _gen_group_size(h: int, r: int) -> int:
    return 1 if r == h // 2 else 2


def _gen_symmetric_sprite() -> np.ndarray | None:
    h = random.choice(SPRITE_HEIGHTS)
    w = random.randint(max(SPRITE_WIDTH_MIN, h), SPRITE_WIDTH_MAX)
    area = h * w
