+    max_damage = math.floor(cell_count * 0.50)
+    target = int(rng.integers(max(min_damage, tile_instances), max_damage + 1))
+
+    mask = np.zeros((h, w), dtype=bool)
+    phase_visible = np.full((p, p), tile_instances, dtype=int)
