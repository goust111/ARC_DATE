+def _count_distinct_phase_classes(mask: np.ndarray, p: int) -> int:
+    phase_hits = np.zeros((p, p), dtype=bool)
+    damaged = np.argwhere(mask)
+    for r, c in damaged:
+        phase_hits[int(r) % p, int(c) % p] = True
+    return int(phase_hits.sum())
