+    for _ in range(GEN_ATTEMPTS):
+        rng = np.random.default_rng()
+        p = int(rng.choice([3, 4]))
+
+        max_tiles = min(7, 30 // p)
+        tile_rows = int(rng.integers(2, max_tiles + 1))
+        tile_cols = int(rng.integers(2, max_tiles + 1))
+        h = tile_rows * p
+        w = tile_cols * p
