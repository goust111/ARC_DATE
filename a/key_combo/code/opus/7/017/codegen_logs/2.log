+_LEFT_SHAPES = {
+    1: [(0, 0), (0, -1), (-1, 0)],
+    2: [(0, 0), (0, 1), (-1, 0)],
+    3: [(0, 0), (0, 1), (0, 2), (-1, 0)],
+    4: [(0, 0), (0, 1), (0, 2), (0, 3)],
+}
+_RIGHT_SHAPES = {
+    1: [(0, 0), (0, 1), (1, 0)],
+    2: [(0, 0), (0, 1), (1, 1)],
+    3: [(0, 0), (0, 1), (0, 2), (1, 2)],
+    4: [(0, 0), (0, 1), (0, 2), (0, 3), (1, 3)],
+}
+
+_COUNT_CHOICES = {
+    2: [(1, 2), (1, 3), (1, 4), (2, 3), (2, 4), (3, 4)],
+    3: [(1, 2, 3), (1, 2, 4), (1, 3, 4), (2, 3, 4)],
+    4: [(1, 2, 3, 4)],
+}
