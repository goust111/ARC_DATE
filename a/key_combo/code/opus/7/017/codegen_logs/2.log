+def _choose_counts(rng: np.random.Generator) -> list[int]:
+    obstacle_count = int(rng.choice([2, 3, 4], p=[0.18, 0.57, 0.25]))
+    counts = list(_COUNT_CHOICES[obstacle_count][int(rng.integers(len(_COUNT_CHOICES[obstacle_count])))] )
+    if rng.random() < 0.5:
+        counts.reverse()
+    return counts
