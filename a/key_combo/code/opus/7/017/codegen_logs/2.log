+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SEED_COLORS = (BLUE, RED, GREEN)
+RECOLOR_BY_BLOCKED = {1: BLUE, 2: RED, 3: GREEN, 4: YELLOW}
