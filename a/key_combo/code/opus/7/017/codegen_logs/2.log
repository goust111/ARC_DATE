+    starts = []
+    cur = left_pad
+    for i, count in enumerate(counts):
+        starts.append(cur)
+        cur += count
+        if i < gap_count:
+            cur += gaps[i]
+
+    if cur + right_pad != width:
+        return None
+    return starts
