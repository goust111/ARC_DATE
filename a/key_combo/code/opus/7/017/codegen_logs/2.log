+        if occupied & coord_set:
+            return None
+        for r, c in coord_set:
+            for rr, cc in occupied:
+                if max(abs(r - rr), abs(c - cc)) <= 1:
+                    return None
+        occupied |= coord_set
+    return shapes
+
