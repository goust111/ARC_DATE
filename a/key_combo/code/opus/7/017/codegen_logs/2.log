    if (a + OUTPUT_COLS - 1) // OUTPUT_COLS + (b + OUTPUT_COLS - 1) // OUTPUT_COLS
    <= OUTPUT_ROWS
    and a + b <= TOTAL_ENCLOSED_MAX
