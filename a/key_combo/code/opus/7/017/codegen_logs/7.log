+    legend_mask = np.zeros_like(grid, dtype=bool)
+    legend_mask[r0 : r0 + outer, c0 : c0 + outer] = True
+    corner_r = r0 + outer - 1
+    corner_c = c0 + outer - 1
+    legend_mask[corner_r, corner_c : corner_c + extra_right + 1] = True
