+    for idx, kind in enumerate(kinds):
+        area = int(rng.integers(4, 9))
+        shape = _make_shape(rng, area)
+        if shape is None:
+            return None
+        colors = _component_variant_colors(rng, target_colors, kind)
+        patch = _colorize_shape(rng, shape, colors)
