+    corner_r = r0 + outer - 1
+    corner_c = c0 + outer - 1
+    legend_mask[corner_r, corner_c : corner_c + extra_right + 1] = True
+    legend_mask[corner_r : corner_r + extra_down + 1, corner_c] = True
