            lo = max(0, prefix[-1] - _GEN_ENDPOINT_DRIFT)
            hi = min(w - 1, prefix[-1] + _GEN_ENDPOINT_DRIFT)
        else:
            lo = max(0, start_lo)
            hi = min(w - 1, start_hi)
        for c in range(lo, hi + 1):
            rec(prefix + [c])

    rec([])
    return seqs


def _gen_angular_masks(h: int, w: int) -> list[np.ndarray]:
