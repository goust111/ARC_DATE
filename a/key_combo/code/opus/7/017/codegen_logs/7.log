+    while len(kinds) < comp_count:
+        kinds.append("erase" if rng.random() < 0.4 else ("partial" if rng.random() < 0.5 else "none"))
+    rng.shuffle(kinds)
+
+    placed_meta = []
+    first_erase_lane_done = False
+    first_survivor_lane_done = False
+    legend_bottom = legend_bbox[2]
