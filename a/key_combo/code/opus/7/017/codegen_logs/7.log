+def _remove_by_predicate(
+    grid: np.ndarray,
+    legend_mask: np.ndarray,
+    predicate,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int).copy()
+    g[legend_mask] = BG
+    for coords in _components_mask(g != BG):
+        colors = {int(g[r, c]) for r, c in coords}
+        if predicate(colors):
+            for r, c in coords:
