+            require_cols = overlap_cols
+        elif kind != "erase" and not first_survivor_lane_done:
+            row_range = (max(legend_bottom + 3, h // 2), h - 2)
+            col_range = (0, min(w - 2, max(overlap_cols)))
+            require_cols = overlap_cols
