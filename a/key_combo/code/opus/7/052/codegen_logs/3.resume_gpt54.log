+    colors = [RED] * red_count + [GREEN] * (fg_count - red_count)
+    random.shuffle(colors)
+
+    grid = np.zeros((side, side), dtype=int)
+    for cell, color in zip(chosen, colors):
+        grid[cell] = int(color)
+    return grid
+
