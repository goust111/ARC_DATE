+        return []
+    dr = b[0] - a[0]
+    dc = b[1] - a[1]
+    step_r = 0 if dr == 0 else (1 if dr > 0 else -1)
+    step_c = 0 if dc == 0 else (1 if dc > 0 else -1)
+    steps = max(abs(dr), abs(dc))
+    return [(a[0] + step_r * k, a[1] + step_c * k) for k in range(steps + 1)]
+
+
