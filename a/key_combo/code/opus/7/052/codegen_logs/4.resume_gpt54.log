+        return None
+    if np.any(inp[5:, :] == YELLOW):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _build_instance()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 4")

