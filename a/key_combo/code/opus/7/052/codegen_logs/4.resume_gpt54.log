+        row0 = max(0, top - 1)
+        col0 = max(0, left - 1)
+        row1 = min(grid_h, top + patch_h + 1)
+        col1 = min(grid_w, left + patch_w + 1)
+        reserved[row0:row1, col0:col1] = True
+        return True
+    return False
+
+
