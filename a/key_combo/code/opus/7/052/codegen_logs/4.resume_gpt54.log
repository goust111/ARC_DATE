    for i in range(-10, 10):
        dr = rectangle_width
        if 0 <= center_r + i*dr < width:
            grid[center_r + i*dr, center_c] = Color.GREEN
    
    # randomly flip/rotate
    grid = np.rot90(grid,-(np.random.randint(0, 4)))

    return grid

