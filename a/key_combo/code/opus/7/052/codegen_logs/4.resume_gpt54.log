   612	# =============================================================================
   613	# Tiling
   614	# =============================================================================
   615	
   616	
   617	def tile_fill(shape: tuple[int, int], tile: np.ndarray, *, offset: Coord = (0, 0)) -> np.ndarray:
   618	    """Return a new grid of `shape` filled by repeating `tile` with a phase offset."""
   619	    H, W = map(int, shape)
   620	    h, w = tile.shape
   621	    r_off, c_off = map(int, offset)
   622	    out = np.empty((H, W), dtype=tile.dtype)
   623	    for r in range(H):
   624	        tr = (r - r_off) % h
   625	        for c in range(W):
   626	            tc = (c - c_off) % w
   627	            out[r, c] = tile[tr, tc]
   628	    return out
   629	
   630	
   631	
   632	
   633	# =============================================================================
   634	# Motion / interaction (translate, collision/contact)
   635	# =============================================================================
   636	
   637	
   638	def translate(obj: np.ndarray, dr: int, dc: int, *, background: int = Color.BLACK) -> np.ndarray:
   639	    """Translate a full-grid object by (dr,dc), filling empty with background."""
   640	    dr = int(dr)
   641	    dc = int(dc)
   642	    bg = int(background)
   643	    H, W = obj.shape
   644	    out = np.full_like(obj, bg)
   645	    rr, cc = np.nonzero(obj != bg)
   646	    rr2 = rr + dr
   647	    cc2 = cc + dc
   648	    inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
   649	    out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
   650	    return out
   651	
   652	
   653	def collision(
   654	    *,
   655	    object1: np.ndarray,
   656	    object2: np.ndarray,
   657	    r1: int = 0,
   658	    c1: int = 0,
   659	    r2: int = 0,
   660	    c2: int = 0,
   661	    background: int = Color.BLACK,
   662	) -> bool:
   663	    """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
   664	    bg = int(background)
   665	    a = object1
   666	    b = object2
   667	    H1, W1 = a.shape
   668	    H2, W2 = b.shape
   669	
   670	    dr = int(r2) - int(r1)
   671	    dc = int(c2) - int(c1)
   672	
   673	    ra0 = max(0, dr)
   674	    ca0 = max(0, dc)
   675	    ra1 = min(H1, dr + H2)
   676	    ca1 = min(W1, dc + W2)
   677	    if ra0 >= ra1 or ca0 >= ca1:
   678	        return False
   679	
   680	    rb0 = ra0 - dr
   681	    cb0 = ca0 - dc
   682	    rb1 = rb0 + (ra1 - ra0)
   683	    cb1 = cb0 + (ca1 - ca0)
   684	    return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())
   685	
   686	
   687	def contact(
   688	    *,
   689	    object1: np.ndarray,
   690	    object2: np.ndarray,
   691	    r1: int = 0,
   692	    c1: int = 0,
   693	    r2: int = 0,
   694	    c2: int = 0,
   695	    background: int = Color.BLACK,
   696	    connectivity: int = 4,
   697	) -> bool:
   698	    """Return True iff objects touch (share edge/diagonal) or overlap."""
   699	    bg = int(background)
   700	    struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
   701	    m2 = (object2 != bg)
   702	    m2d = ndimage.binary_dilation(m2, structure=struct)
   703	    return collision(
   704	        object1=(object1 != bg).astype(int),
   705	        object2=m2d.astype(int),
   706	        r1=r1,
   707	        c1=c1,
   708	        r2=r2,
   709	        c2=c2,
   710	        background=0,
   711	    )
   712	
   713	
   714	# =============================================================================
   715	# Generation helpers
   716	# =============================================================================
   717	
   718	def first_free_location(
   719	    canvas: np.ndarray,
   720	    patch: np.ndarray,
   721	    *,
   722	    transparent: int,
   723	    border: int = 0,
   724	    padding: int = 0,
   725	    padding_connectivity: int = 8,
   726	) -> Coord | None:
   727	    """
   728	    Find the first (top-left) location where `patch` fits without overlap.
   729	
   730	    Args:
   731	        transparent: color treated as transparent in both `canvas` and `patch`
   732	        border: keep at least this many empty cells to the canvas border
   733	        padding: if > 0, treat `canvas` occupancy as dilated by `padding` pixels.
   734	                 (useful for “leave a gap” placement constraints)
   735	        padding_connectivity: 4 or 8 for the dilation neighborhood
   736	
   737	    Returns:
   738	        (r0,c0) or None if no placement exists.
   739	    """
   740	    H, W = canvas.shape
   741	    h, w = patch.shape
   742	    border = int(border)
   743	    padding = int(padding)
   744	    bg = int(transparent)
   745	
   746	    if h <= 0 or w <= 0:
   747	        return None
   748	    if H - h + 1 - border <= border or W - w + 1 - border <= border:
   749	        return None
   750	
   751	    # Occupancy of the canvas (optionally dilated to enforce padding).
   752	    occ = (canvas != bg)
   753	    if padding > 0:
   754	        if int(padding_connectivity) == 4:
   755	            struct = STRUCT4
   756	        elif int(padding_connectivity) == 8:
   757	            struct = STRUCT8
   758	        else:
   759	            raise ValueError("first_free_location: padding_connectivity must be 4 or 8")
   760	        occ = ndimage.binary_dilation(occ, iterations=padding, structure=struct)
   761	
   762	    patch_mask = (patch != bg)
   763	    if not bool(patch_mask.any()):
   764	        # Empty patch: any in-bounds location works; choose first.
   765	        return int(border), int(border)
   766	
   767	    for r0 in range(border, H - h + 1 - border):
   768	        for c0 in range(border, W - w + 1 - border):
   769	            if not bool((occ[r0 : r0 + h, c0 : c0 + w] & patch_mask).any()):
   770	                return int(r0), int(c0)
   771	    return None
   772	
   773	
   774	def random_sprite(
   775	    m,
   776	    n,
   777	    *,
   778	    density: float = 0.5,
   779	    symmetry: str | None = None,
   780	    color_palette: list[int] | None = None,
   781	    connectivity: int = 4,
   782	    background: int = Color.BLACK,
   783	    no_repeated_colors: bool = False,
   784	) -> np.ndarray:
   785	    """Generate a contiguous sprite of shape (m,n) with random symmetry and palette (for puzzle generation)."""
   786	    if isinstance(m, range):
   787	        m = list(m)
   788	    if isinstance(n, range):
   789	        n = list(n)
   790	    if not isinstance(m, list):
   791	        m = [m]
   792	    if not isinstance(n, list):
   793	        n = [n]
   794	
   795	    m_original, n_original = m, n
   796	    density_original, symmetry_original = density, symmetry
   797	    palette_original, conn_original, bg_original = color_palette, connectivity, background
   798	
   799	    can_be_square = any(m_ == n_ for m_ in m for n_ in n)
   800	    symmetry_types = ["horizontal", "vertical", "not_symmetric", "mirror"]
   801	    if can_be_square:
   802	        symmetry_types += ["diagonal", "radial"]
   803	    symmetry = symmetry or random.choice(symmetry_types)
   804	
   805	    has_to_be_square = symmetry in ("diagonal", "radial")
   806	    if has_to_be_square:
   807	        m, n = random.choice([(m_, n_) for m_ in m_original for n_ in n_original if m_ == n_])
   808	    else:
   809	        m = random.choice(m)
   810	        n = random.choice(n)
   811	
   812	    if m == 1 or n == 1:
   813	        density = 1.0
   814	    elif m == 2 or n == 2:
   815	        density = max(float(density), 0.6)
   816	    elif m == 3 or n == 3:
   817	        density = max(float(density), 0.5)
   818	    else:
   819	        density = max(0.4, min(0.95, random.gauss(float(density), 0.1)))
   820	
   821	    sprite = generate_sprite(
   822	        n=int(m),
   823	        m=int(n),
   824	        symmetry_type=symmetry,
   825	        color_palate=color_palette,
   826	        fill_percentage=density,
   827	        connectivity=connectivity,
   828	        background=background,
   829	        no_repeated_colors=no_repeated_colors,
   830	    )
   831	    assert is_contiguous(sprite, connectivity=connectivity, background=background), "Generated sprite is not contiguous."
   832	
   833	    bg = int(background)
   834	    if (
   835	        np.sum(sprite[0, :] != bg) > 0
   836	        and np.sum(sprite[-1, :] != bg) > 0
   837	        and np.sum(sprite[:, 0] != bg) > 0
   838	        and np.sum(sprite[:, -1] != bg) > 0
   839	    ):
   840	        return sprite
   841	
   842	    return random_sprite(
   843	        m_original,
   844	        n_original,
   845	        density=density_original,
   846	        symmetry=symmetry_original,
   847	        color_palette=palette_original,
   848	        connectivity=conn_original,
   849	        background=bg_original,
   850	        no_repeated_colors=no_repeated_colors,
   851	    )
   852	
