+    dc = b[1] - a[1]
+    return (dr == 0 and dc != 0) or (dc == 0 and dr != 0) or (abs(dr) == abs(dc) and dr != 0)
+
+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
