   854	def random_free_location(
   855	    canvas: np.ndarray,
   856	    patch: np.ndarray,
   857	    *,
   858	    transparent: int,
   859	    border: int = 0,
   860	    padding: int = 0,
   861	    padding_connectivity: int = 8,
   862	) -> Coord:
   863	    """
   864	    Return a random (r,c) top-left location where `patch` fits without overlap.
   865	
   866	    This is the generator-friendly counterpart of `first_free_location` and mirrors the
   867	    legacy seeds' `random_free_location_for_sprite` behavior.
   868	
   869	    Raises:
   870	        ValueError: if no free location exists.
   871	    """
   872	    H, W = canvas.shape
   873	    h, w = patch.shape
   874	    border = int(border)
   875	    padding = int(padding)
   876	    pad_conn = int(padding_connectivity)
   877	    bg = int(transparent)
   878	
   879	    if h <= 0 or w <= 0:
   880	        raise ValueError("random_free_location: patch must be non-empty")
   881	    if H <= 0 or W <= 0:
   882	        raise ValueError("random_free_location: canvas must be non-empty")
   883	
   884	    if border < 0:
   885	        raise ValueError("random_free_location: border must be >= 0")
   886	    if padding < 0:
   887	        raise ValueError("random_free_location: padding must be >= 0")
   888	    if pad_conn not in (4, 8):
   889	        raise ValueError("random_free_location: padding_connectivity must be 4 or 8")
   890	
   891	    r_min = border
   892	    c_min = border
   893	    r_max = H - border - h
   894	    c_max = W - border - w
   895	    if r_max < r_min or c_max < c_min:
   896	        raise ValueError("random_free_location: patch cannot fit (border too large or patch too big)")
   897	
   898	    occ = (canvas != bg)
   899	    if padding > 0:
   900	        struct = STRUCT4 if pad_conn == 4 else STRUCT8
   901	        occ = ndimage.binary_dilation(occ, structure=struct, iterations=padding)
   902	
   903	    m = (patch != bg)
   904	
   905	    candidates: list[Coord] = []
   906	    for r0 in range(r_min, r_max + 1):
   907	        for c0 in range(c_min, c_max + 1):
   908	            if not bool((occ[r0 : r0 + h, c0 : c0 + w] & m).any()):
   909	                candidates.append((int(r0), int(c0)))
   910	
   911	    if not candidates:
   912	        raise ValueError("random_free_location: no free location")
   913	    return random.choice(candidates)
   914	
   915	
   916	def randomly_scatter_points(
   917	    grid: np.ndarray,
   918	    color: int,
   919	    *,
   920	    density: float = 0.5,
   921	    background: int = Color.BLACK,
   922	) -> np.ndarray:
   923	    """Randomly scatter points of `color` into `background` cells until reaching density."""
   924	    bg = int(background)
   925	    col = int(color)
   926	    colored = 0
   927	    H, W = grid.shape
   928	    target = int(round(float(density) * H * W))
   929	    while colored < target:
   930	        r = np.random.randint(0, H)
   931	        c = np.random.randint(0, W)
   932	        if int(grid[r, c]) == bg:
   933	            grid[r, c] = col
   934	            colored += 1
   935	    return grid
   936	
   937	
   938	def randomly_spaced_indices(max_len: int, n_indices: int, border_size: int = 1, padding: int = 1) -> np.ndarray:
   939	    """Generate randomly-spaced indices guaranteed to not be adjacent."""
   940	    max_len = int(max_len)
   941	    n_indices = int(n_indices)
   942	    border_size = int(border_size)
   943	    padding = int(padding)
   944	
   945	    if border_size > 0:
   946	        return (
   947	            randomly_spaced_indices(max_len - border_size - 2, n_indices, border_size=0, padding=padding) + border_size
   948	        )
   949	
   950	    indices = [0 for _ in range(max_len)]
   951	    while sum(indices) < n_indices:
   952	        possible = [
   953	            i
   954	            for i in range(max_len)
   955	            if sum(indices[max(0, i - padding) : min(i + 1 + padding, max_len)]) == 0
   956	        ]
   957	        if not possible:
   958	            raise ValueError("randomly_spaced_indices: no feasible placement")
   959	        indices[random.choice(possible)] = 1
   960	    return np.argwhere(indices).flatten()
