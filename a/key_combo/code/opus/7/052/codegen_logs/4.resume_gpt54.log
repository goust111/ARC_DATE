MAX_SLIDE = 6
BARRIER_DENSITY_MIN, BARRIER_DENSITY_MAX = 0.29, 0.41
MOVING_ROW_BARRIER_MAX, NONMOVING_ROW_BARRIER_MAX = 5, 7
# Generation retry budget.
