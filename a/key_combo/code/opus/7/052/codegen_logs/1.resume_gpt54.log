+def _find_marker_chain(
+    grid: np.ndarray,
+    sprite_sets: list[set[tuple[int, int]]],
+    first_idx: int,
+    second_idx: int,
+) -> list[tuple[int, int]] | None:
+    sprite_occ = grid != BLACK
+    candidates: dict[tuple[int, int], dict] = {}
+    allowed_touch = {first_idx, second_idx}
