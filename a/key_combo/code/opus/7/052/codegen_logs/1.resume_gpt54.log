+def _bridge_and_isolated_zones(h: int, w: int) -> tuple[list[tuple[int, int, int, int]], list[tuple[int, int, int, int]]]:
+    corner_h = max(4, h // 3)
+    corner_w = max(4, w // 3)
+    if random.random() < 0.5:
