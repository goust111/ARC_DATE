+def _scene_summary(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    sprites = _sprite_components(grid)
+    owner = np.full(grid.shape, -1, dtype=int)
+    for idx, sprite in enumerate(sprites):
+        for r, c in sprite["coords"]:
+            owner[r, c] = idx
