+def _sprite_components(grid: np.ndarray) -> list[dict]:
+    sprites: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in {BLACK, BLUE, GREY}):
+        for comp in _components(grid == color):
+            sprites.append(
+                {
+                    "color": color,
+                    "coords": comp,
+                    "area": len(comp),
+                    "bbox": _bbox(comp),
