+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREY = 5
+SPRITE_COLORS = [2, 3, 4, 6, 7, 8, 9]
+
+GEN_HEIGHT_RANGE = (14, 18)
+GEN_WIDTH_RANGE = (14, 18)
+GEN_SPRITE_COUNT_RANGE = (3, 5)
+GEN_SPRITE_AREA_RANGE = (3, 7)
+GEN_MAX_ATTEMPTS = 400
