+    for comp in comps:
+        sprite_ids = comp["sprite_ids"]
+        if len(sprite_ids) < 2:
+            continue
+        leader = min(
+            sprite_ids,
+            key=lambda idx: (
+                -sprites[idx]["area"],
+                sprites[idx]["bbox"][0],
+                sprites[idx]["bbox"][1],
