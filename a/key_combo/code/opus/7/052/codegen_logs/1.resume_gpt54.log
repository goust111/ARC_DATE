+def _marker_patch(cell: tuple[int, int], sprite_occ: np.ndarray) -> frozenset[tuple[int, int]]:
+    r, c = cell
+    cells = {(r, c)}
+    h, w = sprite_occ.shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
