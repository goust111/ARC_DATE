+BLACK = 0
+BLUE = 1
+GREY = 5
+SPRITE_COLORS = [2, 3, 4, 6, 7, 8, 9]
+
+GEN_HEIGHT_RANGE = (14, 19)
+GEN_WIDTH_RANGE = (14, 19)
+GEN_SPRITE_COUNT_RANGE = (3, 6)
+GEN_SPRITE_AREA_RANGE = (3, 8)
+GEN_MAX_ATTEMPTS = 400
