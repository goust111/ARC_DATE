+    return sprites
+
+
+def _expand_halos(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    grays = [tuple(map(int, rc)) for rc in np.argwhere(grid == GREY)]
+    for r, c in grays:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and out[nr, nc] == BLACK:
+                    out[nr, nc] = BLUE
+        out[r, c] = GREY
+    return out
+
