+        placed.append(coords)
+        sprite_sets.append(set(coords))
+
+    path = _find_marker_chain(grid, sprite_sets, 0, 1)
+    if path is None:
+        return None
+    for cell in path:
+        grid[cell] = GREY
+
+    _add_distractor_markers(grid, sprite_sets, set(path))
+
+    if not _validate_generated(grid):
+        return None
+    return grid
