+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros(mask.shape, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _normalize(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
+
+
+def _orient(cells: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    arr = np.array(cells, dtype=int)
+    variants = set()
+    for k in range(4):
+        pts = arr.copy()
+        for _ in range(k):
+            pts = np.stack([-pts[:, 1], pts[:, 0]], axis=1)
+        for flip in (1, -1):
+            cur = pts.copy()
+            cur[:, 1] *= flip
+            variants.add(_normalize(set(map(tuple, cur))))
+    return random.choice(sorted(variants))
+
+
+def _random_polyomino(area: int) -> tuple[tuple[int, int], ...]:
+    for _ in range(200):
+        cells = {(0, 0)}
+        while len(cells) < area:
+            frontier = []
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            cells.add(random.choice(frontier))
