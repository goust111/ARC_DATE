@@ -0,0 +1,512 @@
+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+BODY_COLORS = [3, 5, 6, 7, 9]
+GEN_RETRIES = 400
+
+
+@dataclass(frozen=True)
+class Piece:
+    arr: np.ndarray
+    bbox: tuple[int, int, int, int]
+    reds: tuple[tuple[int, int], ...]
+    area: int
+
+    @property
+    def shape(self) -> tuple[int, int]:
+        return tuple(map(int, self.arr.shape))
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return np.array(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int)
+
+
+def _piece_from_component(grid: np.ndarray, coords: list[tuple[int, int]]) -> Piece:
+    bbox = _bbox(coords)
+    arr = _crop(grid, bbox)
+    reds = tuple(map(tuple, np.argwhere(arr == RED)))
+    return Piece(arr=arr, bbox=bbox, reds=reds, area=int(np.count_nonzero(arr)))
