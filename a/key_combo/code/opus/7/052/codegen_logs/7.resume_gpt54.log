+    ph, pw = piece.shape
+    if top < 0 or left < 0 or top + ph > h or left + pw > w:
+        return False, 0
+
+    overlap_unpaired = 0
+    for rr, cc in np.argwhere(piece.arr != BLACK):
+        rr = int(rr)
+        cc = int(cc)
+        pv = int(piece.arr[rr, cc])
+        gv = int(canvas[top + rr, left + cc])
+        if pv == RED:
+            if gv not in (BLACK, RED):
+                return False, 0
+            prev = red_counts.get((top + rr, left + cc), 0)
+            if prev >= 2:
+                return False, 0
+            if prev == 1:
