+    assert len(anchors) == 1, "expected exactly one anchor piece"
+    yellow = np.argwhere(anchors[0].arr == YELLOW)
+    yr0, yc0 = yellow.min(axis=0)
+    yr1, yc1 = yellow.max(axis=0)
