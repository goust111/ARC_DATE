+        rr = int(rr)
+        cc = int(cc)
+        out[top + rr, left + cc] = int(piece.arr[rr, cc])
+    return out
+
+
+def _solve_assembly(grid: np.ndarray) -> tuple[np.ndarray, int]:
+    objects = _extract_objects(grid)
+    templates = [obj for obj in objects if _is_template(obj)]
