+def _paint_piece(grid: np.ndarray, arr: np.ndarray, top: int, left: int) -> None:
+    for rr, cc in np.argwhere(arr != BLACK):
+        grid[top + int(rr), left + int(cc)] = int(arr[int(rr), int(cc)])
