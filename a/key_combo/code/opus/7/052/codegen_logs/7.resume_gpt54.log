        assert target["area"] == th * tw, "grey target must be a solid rectangle"
        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == grey), "grey target bbox must be solid"
        out[r0 : r1 + 1, c0 : c1 + 1] = template

    return out

