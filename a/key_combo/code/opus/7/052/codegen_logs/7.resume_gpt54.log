+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+BODY_COLORS = [3, 5, 6, 7, 9]
+GEN_RETRIES = 400
+
+
+@dataclass(frozen=True)
+class Piece:
+    arr: np.ndarray
+    bbox: tuple[int, int, int, int]
