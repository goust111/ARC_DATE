+def _rect_cycle(h: int, w: int, left_conn_r: int) -> list[tuple[int, int]]:
+    cycle: list[tuple[int, int]] = []
+    for r in range(left_conn_r, -1, -1):
+        cycle.append((r, 0))
+    for c in range(1, w):
+        cycle.append((0, c))
+    for r in range(1, h):
+        cycle.append((r, w - 1))
+    for c in range(w - 2, -1, -1):
+        cycle.append((h - 1, c))
+    for r in range(h - 2, left_conn_r, -1):
+        cycle.append((r, 0))
+    return cycle
