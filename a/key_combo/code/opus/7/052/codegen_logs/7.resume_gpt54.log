+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+BODY_COLORS = [3, 5, 6, 7, 9]
+GEN_RETRIES = 400
