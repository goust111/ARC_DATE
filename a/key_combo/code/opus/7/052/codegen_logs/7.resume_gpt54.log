+        return False, 0
+
+    overlap_unpaired = 0
+    for rr, cc in np.argwhere(piece.arr != BLACK):
+        rr = int(rr)
+        cc = int(cc)
+        pv = int(piece.arr[rr, cc])
+        gv = int(canvas[top + rr, left + cc])
