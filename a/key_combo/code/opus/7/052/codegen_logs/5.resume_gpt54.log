+    out = g.copy()
+    for red_point, green_point, wall in ops:
+        out[red_point] = BLACK
+        out[green_point] = TEAL
+        axis, fixed, start, end = wall
+        if axis == "v":
+            out[start : end + 1, fixed] = BLACK
+        else:
+            out[fixed, start : end + 1] = BLACK
