+def _divider_spans(length: int, dividers: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for divider in dividers:
+        if start <= divider - 1:
+            spans.append((start, divider - 1))
+        start = divider + 1
+    if start <= length - 1:
+        spans.append((start, length - 1))
+    return spans
