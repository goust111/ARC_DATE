+    grid: np.ndarray,
+    row_spans: list[tuple[int, int]],
+    col_spans: list[tuple[int, int]],
+    cell_r: int,
+    cell_c: int,
+    color: int,
+    row_offset: int | None = None,
+    col_offset: int | None = None,
+    row_mode: str = "center",
+    col_mode: str = "center",
+) -> Point:
