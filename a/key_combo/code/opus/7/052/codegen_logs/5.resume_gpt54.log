    bg = get_bg(g)
    groups = _column_groups(g, bg)

    h = g.shape[0]
    out = np.full((h, sum(group.shape[1] for group in groups)), bg, dtype=int)
    c = 0

    first = groups[0]
    out[:, : first.shape[1]] = first
    prev_right_row = _endpoint_row(first, bg, "right")
    c += first.shape[1]

