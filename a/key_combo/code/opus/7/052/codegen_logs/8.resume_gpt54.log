+def _diag_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = p
+    r1, c1 = q
+    dr = r1 - r0
+    dc = c1 - c0
+    assert abs(dr) == abs(dc) and dr != 0
+    sr = 1 if dr > 0 else -1
+    sc = 1 if dc > 0 else -1
+    steps = abs(dr)
+    return [(r0 + k * sr, c0 + k * sc) for k in range(steps + 1)]
