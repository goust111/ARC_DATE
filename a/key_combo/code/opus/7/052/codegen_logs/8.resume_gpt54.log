+            assert SEGMENT_MIN_LEN <= abs(p[0] - q[0]) <= SEGMENT_MAX_LEN
+            segments.append(
+                {
+                    "orientation": orientation,
+                    "endpoints": (p, q),
+                    "path": _diag_path(p, q),
