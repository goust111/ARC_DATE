            while 0 <= r < h and 0 <= c < w:
                if out[r, c] == BLUE:
                    break
                out[r, c] = PINK
                r += dr
                c += dc
    return out


def _region_output(completed: np.ndarray) -> np.ndarray:
    passable = (completed == BLACK) | (completed == RED)
