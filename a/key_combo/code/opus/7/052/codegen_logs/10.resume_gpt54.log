+    crop = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    gray_mask = g[r0 : r1 + 1, c0 : c1 + 1] == GRAY
+    crop[gray_mask] = GRAY
+    fill_color = analysis["seeds"][winner["winner"]][2]
+    for r, c in winner["cells"]:
+        crop[r - r0, c - c0] = fill_color
+    return crop
