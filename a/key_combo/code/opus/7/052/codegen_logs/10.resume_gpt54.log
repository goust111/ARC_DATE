+def _cavity_records(grid: np.ndarray) -> list[dict]:
+    cavities = []
+    for cells in _components(grid == BLACK, conn8=False):
+        if any(r == 0 or c == 0 or r == grid.shape[0] - 1 or c == grid.shape[1] - 1 for r, c in cells):
+            continue
+        boundary_gray = set()
