+def _rect_loop(top: int, left: int, inner_h: int, inner_w: int) -> set[tuple[int, int]]:
+    outer_h = inner_h + 2
+    outer_w = inner_w + 2
+    cells = set()
+    for c in range(left, left + outer_w):
