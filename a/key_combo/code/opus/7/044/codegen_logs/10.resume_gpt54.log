+            r0, c0 = pts.min(axis=0)
+            r1, c1 = pts.max(axis=0)
+            block = region[r0 : r1 + 1, c0 : c1 + 1]
+            assert np.all(block == color), "each partition must be a solid rectangle"
+            rectangles.append((color, (int(r0), int(c0), int(r1), int(c1))))
