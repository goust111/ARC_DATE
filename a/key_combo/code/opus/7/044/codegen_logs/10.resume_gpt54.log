+def _sample_template_mask(rng: np.random.Generator) -> np.ndarray:
+    for _ in range(200):
+        h = int(rng.choice([3, 4]))
+        w = int(rng.choice([3, 4]))
+        mask = rng.random((h, w)) < rng.uniform(0.35, 0.7)
+        if not mask.any() or mask.all():
