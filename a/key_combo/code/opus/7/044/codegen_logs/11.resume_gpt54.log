+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    if int(np.count_nonzero(out != grid)) < len(marked_indices) * 2:
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
