        targets = np.arange(_GEN_TARGET_MIN_CELLS, _GEN_TARGET_MAX_CELLS_EXCLUSIVE)
        _GEN_TARGET_BAG.extend(np.random.permutation(targets).astype(int).tolist())
    return int(_GEN_TARGET_BAG.pop())


