                    if ok:
                        keep0 = (sym_src == 0) & (dst == 0)
                        return ("sym_fill", {"stable": st, "keep0": keep0})

        if v is not None:
            pred = src.copy()
            m0 = src == 0
            mv = src == v
            pred[m0] = v
            pred[mv] = 0
            for c in st:
                pred[dst == c] = c
            if np.array_equal(pred, dst):
                return ("invert0", {"stable": st})

        for idx, var in enumerate(symmetries(src)):
            if np.array_equal(var, dst):
                return ("sym", {"idx": idx})

        if v is not None:
            coords = np.argwhere(src == v)
            S = set((int(r), int(c)) for r, c in coords)
            keep = np.zeros_like(src, dtype=bool)
            for r, c in S:
                deg = 0
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        if dr == 0 and dc == 0:
                            continue
                        if (r + dr, c + dc) in S:
                            deg += 1
                if deg <= 1:
                    keep[r, c] = True
            pred = src.copy()
            pred[src == v] = 0
            pred[keep] = v
            if np.array_equal(pred, dst):
                return ("endpoints", {"stable": st})

            pred = src.copy()
            h, w = pred.shape
            stable_mask = np.zeros_like(pred, dtype=bool)
            for c in st:
                stable_mask |= pred == c
            for r in range(h):
                nz = np.where(pred[r, :] != 0)[0]
                if nz.size >= 2:
                    cmin = int(nz.min())
                    cmax = int(nz.max())

