+    outer = panel.copy()
+    outer[r0 : r1 + 1, c0 : c1 + 1] = BACKGROUND
+    assert not np.any((outer != BACKGROUND) & (outer != MARKER)), "non-marker foreground must stay inside the centered 3x3"
