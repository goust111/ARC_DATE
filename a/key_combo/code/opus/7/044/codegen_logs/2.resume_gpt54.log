+    forbidden = _forbidden_mask(grid.shape, obstacles)
+    forbidden_track = {
+        (r, c)
+        for r, c in occupied
+        if grid[r, c] in (TEAL, MAROON) and forbidden[r, c]
+    }
+    if len(forbidden_track) < 4:
+        return None
