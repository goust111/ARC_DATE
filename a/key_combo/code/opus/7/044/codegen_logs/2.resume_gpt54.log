+    except AssertionError:
+        return None
+    if actual_path != safe_path:
+        return None
+
+    expected = _build_expected(grid, palette_cols, palette, safe_path)
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
