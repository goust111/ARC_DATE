+def _backbone_path(track_w: int) -> tuple[int, list[Coord], list[tuple[int, int, int]], list[tuple[int, int, int]]]:
+    n_levels = random.randint(3, 5)
+    h = 4 * (n_levels - 1) + 3
+    rows = [1 + 4 * i for i in range(n_levels)]
