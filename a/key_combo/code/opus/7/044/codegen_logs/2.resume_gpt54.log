+            for side in ("left", "right"):
+                cells = []
+                ok = True
+                for d in (1, 2):
+                    cc = col - d if side == "left" else col + d
+                    cell = (r, cc)
+                    if not (0 <= cc < track_w) or cell in occupied:
+                        ok = False
+                        break
+                    cells.append(cell)
+                if ok:
+                    branch_candidates.append(cells)
