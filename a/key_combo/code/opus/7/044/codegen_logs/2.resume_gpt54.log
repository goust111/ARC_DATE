+def _forbidden_mask(shape: tuple[int, int], obstacles: list[Coord]) -> np.ndarray:
+    forbidden = np.zeros(shape, dtype=bool)
+    for r, c in obstacles:
+        forbidden[r, c] = True
+        for nr, nc in _neighbors8(r, c):
+            if _in_bounds(shape, nr, nc):
