+        if right - left < 4:
+            continue
+        for side in ("up", "down"):
+            if side == "up" and row - 3 < 1:
+                continue
+            if side == "down" and row + 3 > h - 2:
+                continue
+            for base in range(left + 1, right - 2):
+                loop_candidates.append(_loop_shape(row, base, side))
