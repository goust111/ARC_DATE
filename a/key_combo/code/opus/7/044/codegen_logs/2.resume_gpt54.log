+def _unique_simple_path(mask: np.ndarray, start: Coord, end: Coord) -> list[Coord]:
+    adj = _adjacency(mask)
+    assert start in adj and end in adj, "endpoints must remain on the safe track"
+    paths: list[list[Coord]] = []
+    seen = {start}
+    stack = [start]
