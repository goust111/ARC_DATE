+def _adjacency(mask: np.ndarray) -> dict[Coord, list[Coord]]:
+    coords = [tuple(map(int, p)) for p in np.argwhere(mask)]
+    cells = set(coords)
+    adj: dict[Coord, list[Coord]] = {}
+    for r, c in coords:
+        nbrs = []
+        for nr, nc in _neighbors4(r, c):
