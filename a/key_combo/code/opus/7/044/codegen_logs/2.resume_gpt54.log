+        obstacles.append(obstacle)
+        occupied.update(detour)
+        occupied.add(obstacle)
+        reserved_backbone.update(top)
+
+    if not obstacles:
+        return None
+
+    branch_candidates: list[list[Coord]] = []
+    for row, left, right in horiz_segments:
