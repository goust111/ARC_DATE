+def _make_bar(color: int, orientation: str, start_r: int, start_c: int, length: int) -> dict:
+    radius = (int(length) - 1) // 2
+    if orientation == "H":
+        cells = [(int(start_r), int(start_c + offset)) for offset in range(int(length))]
+        return {
