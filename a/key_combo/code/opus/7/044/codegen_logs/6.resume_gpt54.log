        max_notches = CLOSED_NOTCH_COUNT[1] if base_area <= CLOSED_TWO_NOTCH_AREA_MAX else CLOSED_NOTCH_COUNT[0]
        notch_count = random.randint(CLOSED_NOTCH_COUNT[0], max_notches)
