+def _overlay_from_masks(masks: list[np.ndarray], colors: list[int], order: list[int]) -> np.ndarray:
+    patterns = [mask.astype(int) * color for mask, color in zip(masks, colors)]
+    return _overlay_patterns(patterns, order)
