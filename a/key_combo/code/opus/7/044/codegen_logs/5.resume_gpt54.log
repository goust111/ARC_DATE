+        panel = np.zeros((PANEL_SIZE, PANEL_SIZE), dtype=int)
+        panel[masks[panel_index]] = colors[panel_index]
+        panel[: heights[panel_index], bar_cols[panel_index]] = BAR_COLOR
+        grid[:, start : start + PANEL_SIZE] = panel
+    return grid
+
