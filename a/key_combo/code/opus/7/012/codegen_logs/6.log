+    areas = [reg["area"] for reg in regions]
+    min_area = min(areas)
+    template_candidates = [i for i, area in enumerate(areas) if area == min_area]
+    assert len(template_candidates) == 1, "smallest region must be unique"
+    template_idx = template_candidates[0]
