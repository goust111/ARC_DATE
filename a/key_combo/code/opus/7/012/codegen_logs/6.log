+        np.rot90(mask, 1),
+        np.rot90(mask, 2),
+        np.rot90(mask, 3),
+        np.flipud(mask),
+        np.fliplr(mask),
+        mask.T.copy(),
+        np.flipud(np.fliplr(mask)).T.copy(),
+    ]
+
+
+def _is_asymmetric(mask: np.ndarray) -> bool:
+    seen = {
+        (oriented.shape, oriented.astype(np.uint8).tobytes())
+        for oriented in _all_orientations(mask)
+    }
+    return len(seen) == 8
