+        chosen = []
+    if count - len(chosen) > len(available):
+        return False
+    chosen.extend(random.sample(available, count - len(chosen)))
+    for rr, cc in chosen:
+        grid[r0 + rr, c0 + cc] = Color.BLUE
+    return True
+
