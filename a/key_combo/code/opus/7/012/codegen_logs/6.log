+def _generate_attempt() -> np.ndarray | None:
+    sprite_mask = random.choice(SPRITE_CATALOG).copy()
+    sprite_h, sprite_w = sprite_mask.shape
+    partition = _make_partition(sprite_h, sprite_w)
