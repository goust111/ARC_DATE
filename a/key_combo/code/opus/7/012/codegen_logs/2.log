+        if mask_grid[r, 0] == BLACK and not reachable[r, 0]:
+            reachable[r, 0] = True
+            queue.append((r, 0))
+        if mask_grid[r, w - 1] == BLACK and not reachable[r, w - 1]:
+            reachable[r, w - 1] = True
+            queue.append((r, w - 1))
