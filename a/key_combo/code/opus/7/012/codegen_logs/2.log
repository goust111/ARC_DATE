+        assert _enclosed_black_mask(payload).any()
+        assert np.any(out == color)
+        assert np.any(out == GREEN)
+        assert not np.array_equal(out, only_x)
+        assert not np.array_equal(out, only_y)
+        assert not np.array_equal(out, no_shift)
+        return grid
