+def _parse_cells(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    lattice = int(g[0, 0])
+    assert lattice == LATTICE
+    assert np.all(g[0, :] == lattice)
+    assert np.all(g[-1, :] == lattice)
+    assert np.all(g[:, 0] == lattice)
+    assert np.all(g[:, -1] == lattice)
