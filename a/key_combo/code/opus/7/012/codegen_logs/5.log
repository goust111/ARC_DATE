    if not (TOTAL_STAMPS_RANGE[0] <= total_stamps <= TOTAL_STAMPS_RANGE[1]):
        return None
    if not (CLIPPED_STAMPS_RANGE[0] <= clipped <= CLIPPED_STAMPS_RANGE[1]):
