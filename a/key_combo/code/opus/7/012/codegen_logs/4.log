+    blocks = meta["blocks"]
+    weights = meta["weights"]
+    final_weights = meta["final_weights"]
+    pass_count = 0
+    blocked_count = 0
+
+    for (wr, wc), (fr, fc) in final_weights:
+        assert wc == fc
+        carrier = [block for block in blocks if block["c0"] <= wc < block["c0"] + BLOCK_SIZE][0]
+        local_c = int(wc - carrier["c0"])
