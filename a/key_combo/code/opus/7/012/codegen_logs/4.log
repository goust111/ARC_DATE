+    blocks.sort(key=lambda b: (b["r0"], b["c0"]))
+    weights.sort()
+
+    block_colors = {int(block["color"]) for block in blocks}
+    assert block_colors == set(motifs_by_color)
+    assert len(block_colors) == len(blocks)
+
+    for wr, wc in weights:
