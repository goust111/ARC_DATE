+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return comps
+
+
+MOTIF_LIBRARY: dict[str, np.ndarray] = {
+    "center": np.array(
+        [
+            [1],
+            [1],
+            [1],
+        ],
+        dtype=bool,
+    ),
+    "pair": np.array(
+        [
+            [1, 0],
+            [1, 1],
+        ],
+        dtype=bool,
+    ),
+    "triple": np.array(
+        [
+            [0, 1, 0],
+            [1, 1, 1],
+        ],
+        dtype=bool,
+    ),
+}
+
