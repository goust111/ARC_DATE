+    direction = spec["dir"]
+    if direction == "U":
+        return r0 - 1, c0 + offset
+    if direction == "D":
+        return r0 + size, c0 + offset
+    if direction == "L":
+        return r0 + offset, c0 - 1
+    if direction == "R":
+        return r0 + offset, c0 + size
