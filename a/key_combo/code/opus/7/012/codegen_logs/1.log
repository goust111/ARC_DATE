+def _spec_ok(
+    shape: tuple[int, int],
+    spec: dict,
+    placed: list[dict],
+    occupied: set[tuple[int, int]],
+    reserved_paths: set[tuple[int, int]],
+) -> bool:
+    indicator = _indicator_pos(spec)
+    square = _square_cells(spec)
