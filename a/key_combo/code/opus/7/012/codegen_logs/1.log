+    if np.array_equal(descending_out, grid):
+        return False
+    if np.array_equal(descending_out, ascending_out):
+        return False
+    if np.array_equal(descending_out, no_ray_block_out):
+        return False
+    if not any(trace["stop_kind"] == "ray" for trace in traces):
