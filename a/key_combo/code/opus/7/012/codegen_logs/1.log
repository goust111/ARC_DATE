+def _simulate(
+    grid: np.ndarray,
+    objects: list[dict],
+    *,
+    block_rays: bool = True,
+) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    initial_non_bg = {tuple(map(int, rc)) for rc in np.argwhere(g != BACKGROUND)}
+    ray_cells: set[tuple[int, int]] = set()
+    traces: list[dict] = []
