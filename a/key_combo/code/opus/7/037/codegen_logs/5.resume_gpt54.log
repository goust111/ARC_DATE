+            {(int(r), int(c)) for r, c in other["coords"]}
+            for other in comps
+            if other is not comp
+        ]
+    ) for comp in comps):
+        return None
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
