    color = int(np.random.choice(BAR_COLORS))
    r0, c0 = positions[int(np.random.randint(0, len(positions)))]

    inp = np.full((N, N), BACKGROUND_COLOR, dtype=int)
    inp[r0 : r0 + h, c0 : c0 + w] = color

    try:
        out = main(inp)
    except Exception:
        return None
    if out.shape != inp.shape:
        return None
    return inp


