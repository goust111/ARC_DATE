+    segs: list[tuple[int, int]] = []
+    start = int(indices[0])
+    prev = int(indices[0])
+    for value in indices[1:]:
+        value = int(value)
+        if value == prev + 1:
+            prev = value
+            continue
+        segs.append((start, prev))
+        start = prev = value
+    segs.append((start, prev))
+    return segs
