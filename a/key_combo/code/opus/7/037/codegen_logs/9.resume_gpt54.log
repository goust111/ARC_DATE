+            placed = True
+            break
+        if not placed:
+            return None
+
+    produced = main(grid)
+    if not np.array_equal(produced, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
