+
+            grid[tuple(zip(*line_cells))] = GREY
+            if chain_cells:
+                grid[tuple(zip(*chain_cells))] = GREY
+            color = colors[lengths.index(length)]
+            for r, c in full_cells:
+                expected[r, c] = color
+            for r, c in chain_cells:
