+
+from collections import Counter
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+GREY = 5
+BLACK = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_RETRIES = 400
+RNG = random.Random()
+
