+    for r in range(h):
+        for c in range(w):
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
+            if grid[r, c] != BACKGROUND:
+                continue
+            isolated = True
+            for rr in range(max(0, r - 1), min(h, r + 2)):
+                for cc in range(max(0, c - 1), min(w, c + 2)):
+                    if (rr, cc) != (r, c) and grid[rr, cc] != BACKGROUND:
