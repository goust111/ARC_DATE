+    width = int(c1 - c0 + 1)
+    length = max(height, width)
+    assert (height == 1) != (width == 1)
+    assert len(coords) == length
+    assert length % 2 == 1
+    center = ((int(r0) + int(r1)) // 2, (int(c0) + int(c1)) // 2)
+    orient = "H" if height == 1 else "V"
