+        if kind != KIND_NONE:
+            assert cross_center is not None and ring_color is not None
+            rr, cc = cross_center
+            assert 0 < rr < h - 1
+            assert 0 < cc < w - 1
+            ring_specs.append((cross_center, ring_color))
+
+    for center, ring_color in ring_specs:
+        for r, c in _ring_cells(center):
+            out[r, c] = int(ring_color)
