        minority_counts = [minority_total]
    else:
        minority_counts = [1, 1]
    majority_count = random.randint(
        max(MAJORITY_MARKERS[0], max(minority_counts) + 1),
        min(MAJORITY_MARKERS[1], MARKERS_PER_REGION_MAX - minority_total),
