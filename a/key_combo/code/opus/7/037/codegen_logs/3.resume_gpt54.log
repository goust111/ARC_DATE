+def _classify_noise_sites(
+    expected: np.ndarray,
+    sample_mask: np.ndarray,
+    area_by_color: dict[int, int],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[tuple[int, int]]]:
