+
+def _build_base_grid(h: int, w: int, rects: list[dict[str, int]]) -> tuple[np.ndarray, np.ndarray]:
+    base = np.zeros((h, w), dtype=int)
+    owner = np.full((h, w), -1, dtype=int)
