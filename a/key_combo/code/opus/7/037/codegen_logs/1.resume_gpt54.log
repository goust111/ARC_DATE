+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+TEAL = 8
+
+# Generator bounds tuned to keep the grids compact while leaving enough room
+# for 2-3 carrier rectangles and visible ray lengths.
+GRID_H_MIN = 14
+GRID_H_MAX = 18
+GRID_W_PAD_MAX = 5
+EDGE_MARGIN = 2
+RECT_H_OPTIONS = (4, 5)
+RECT_W_OPTIONS = (6, 7, 8)
+RECT_COUNT_OPTIONS = (2, 3)
