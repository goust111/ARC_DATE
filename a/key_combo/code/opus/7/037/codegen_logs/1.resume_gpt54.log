    if direction == -1 and c - L < 0:
        return None
    path = []
    blocked = False
    blocker = None
    for step in range(1, L + 1):
        nc = c + direction * step
        oid = int(owner[r, nc])
        color = int(base[r, nc])
        if oid "'!= -1 and oid != idx:
            if color == carrier:
                return None
            blocked = True
            blocker = oid
            break
        if color not in (BACKGROUND, carrier):
            blocked = True
            break
        path.append((r, nc))
    if not path:
        return None
    return {'"'rect': idx, 'r': r, 'c': c, 'path': tuple(path), 'blocked': blocked, 'L': L, 'color': carrier, 'blocker': blocker}


def _enumerate_candidates(H, W, base, owner, rects, rng):
    all_cands = []
    for idx, rect in enumerate(rects):
        cands = []
        for r in range(rect['r0'] + 1, rect['r1']):
            for c in range(rect['c0'] + 1, rect['c1']):
                cand = _trace_candidate(H, W, base, owner, rects, idx, r, c)
                if cand is not None:
                    cands.append(cand)
        rng.shuffle(cands)
        all_cands.append(cands)
    return all_cands


def _choose_counts(rects, rng):
    counts = [1 + int(rng.random() < 0.45) for _ in rects]
    if sum(counts) == len(rects):
        counts[rng.randrange(len(counts))] = 2
    return counts


def _select_markers(rects, rect_cands, counts, rng):
    total_markers = sum(counts)
    require_blocked = rng.random() < BLOCKED_VARIANT_PROB and any(c['blocked'] for lst in rect_cands for c in lst)
    rect_order = sorted(range(len(rects)), key=lambda i: (len(rect_cands[i]), counts[i]))
    selected = []
    used_path = set()
    marker_positions = set()
    solutions = []

    def compatible(cand):
        pos = (cand['r'], cand['c'])
        if pos in used_path:
            return False
        for pr, pc in marker_positions:
            if max(abs(pr - cand['r']), abs(pc - cand['c'])) <= 1:
                return False
        pset = set(cand['path'])
        if pset & used_path:
            return False
        if any(p in marker_positions for p in pset):
            return False
        for sel in selected:
            if pos in sel['path']:
                return False
        return True

    def finalize_ok():
        if total_markers > 1 and len({cand['L'] for cand in selected}) < 2:
            return False
        if not any(not cand['blocked'] for cand in selected):
            return False
        if require_blocked and not any(cand['blocked'] for cand in selected):
            return False
        if require_blocked and total_markers > 1 and not any(not cand['blocked'] for cand in selected):
            return False
        return True

    def backtrack(i):
        if len(solutions) >= 24:
            return
        if i == len(rect_order):
            if finalize_ok():
                solutions.append([dict(cand) for cand in selected])
            return
        rect_idx = rect_order[i]
        cands = rect_cands[rect_idx][:]
        rng.shuffle(cands)
        picked = []

        def pick_from(start):
            if len(picked) == counts[rect_idx]:
                backtrack(i + 1)
                return
            need = counts[rect_idx] - len(picked)
            for j in range(start, len(cands)):
                if len(cands) - j < need:
                    break
                cand = cands[j]
                if not compatible(cand):
                    continue
                picked.append(cand)
                selected.append(cand)
                pos = (cand['r'], cand['c'])
                marker_positions.add(pos)
                for p in cand['path']:
                    used_path.add(p)
                pick_from(j + 1)
                for p in cand['path']:
                    used_path.remove(p)
                marker_positions.remove(pos)
                selected.pop()
                picked.pop()
        pick_from(0)

    backtrack(0)
    if not solutions:
        return None
    return rng.choice(solutions)


def generate_input_seed(seed):
    rng = random.Random(seed)
    for _ in range(GEN_ATTEMPTS):
