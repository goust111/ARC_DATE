+
+    return None
+
+
+def _place_rectangles(rng: random.Random) -> tuple[int, int, list[dict[str, int]]] | None:
+    if rng.random() < PAIRED_LAYOUT_PROB:
+        paired = _place_paired_layout(rng)
+        if paired is not None:
