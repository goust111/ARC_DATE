+    planned = [src_a, src_b]
+    forbidden_block_cells = {
+        (lane_r, cc) for cc in range(anchor_a[1] + 1, w)
+    } | {
+        (rr, cross_c) for rr in range(anchor_b[0] + 1, h - 1)
+    }
