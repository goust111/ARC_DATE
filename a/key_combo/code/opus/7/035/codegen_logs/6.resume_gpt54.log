+    if random.random() < 0.45:
+        candidates = [
+            (r, c)
+            for r in range(1, h - 2)
+            for c in range(1, w - 2)
+            if _can_place_block(blocks, (r, c), grid.shape, forbidden_block_cells)
+        ]
+        random.shuffle(candidates)
+        for extra_block in candidates:
