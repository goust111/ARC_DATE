+
+def _path_cells(src: tuple[int, int], dst: tuple[int, int]) -> list[tuple[int, int]]:
+    sr, sc = src
+    dr = 0 if dst[0] == sr else (1 if dst[0] > sr else -1)
+    dc = 0 if dst[1] == sc else (1 if dst[1] > sc else -1)
+    cells = []
+    cr, cc = sr + dr, sc + dc
+    while (cr, cc) != dst:
+        cells.append((cr, cc))
+        cr += dr
+        cc += dc
+    cells.append(dst)
+    return cells
