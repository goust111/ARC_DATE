+    out = g.copy()
+    for info in infos:
+        sr, sc = info["src"]
+        out[sr, sc] = BG
+
+    grown = np.zeros_like(out, dtype=bool)
+    events: list[dict[str, object]] = []
+
+    for info in infos:
+        ar, ac = info["anchor"]
+        color = int(info["color"])
+        dr, dc = DIRS[str(info["grow_dir"])]
+
+        assert int(out[ar, ac]) == BG and not grown[ar, ac], "growth anchor must be free"
+        out[ar, ac] = color
+        grown[ar, ac] = True
+
+        cr, cc = ar, ac
+        stop = "boundary"
+        while True:
+            nr, nc = cr + dr, cc + dc
+            if not in_bounds(out.shape, nr, nc):
+                stop = "boundary"
+                break
+            if grown[nr, nc]:
+                stop = "line"
+                break
+            if int(out[nr, nc]) == WALL:
+                stop = "wall"
+                break
+            if int(out[nr, nc]) == BLOCK:
+                stop = "block"
+                break
+            if int(out[nr, nc]) != BG:
+                stop = "occupied"
