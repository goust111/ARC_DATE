# Canvas and rectangle bounds.
_GEN_GRID_SIZE_BOUNDS_9DEF23FE = (15, 26)
_GEN_RECT_SIDE_BOUNDS_9DEF23FE = (5, 9)
_GEN_RECT_MARGIN_9DEF23FE = 2
# Marker layout and palette.
