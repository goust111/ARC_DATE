+def _collect_pairs(grid: np.ndarray) -> tuple[list[dict], list[tuple[int, int]], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    barriers = _barriers(g)
+    dominoes = _dominoes(g, bg)
+    paired_ids: set[int] = set()
