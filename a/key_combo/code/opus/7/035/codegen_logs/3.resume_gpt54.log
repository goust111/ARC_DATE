+                    dom
+                    for dom in dominoes
+                    if dom["orientation"] == "v" and int(dom["col"]) == col and int(dom["r1"]) < row
+                ]
+                bottom = [
+                    dom
+                    for dom in dominoes
+                    if dom["orientation"] == "v" and int(dom["col"]) == col and int(dom["r0"]) > row
+                ]
+                if len(top) == 1 and len(bottom) == 1:
+                    a = int(top[0]["id"])
+                    b = int(bottom[0]["id"])
