+        shape_h = int(shape[:, 0].max()) + 1
+        shape_w = int(shape[:, 1].max()) + 1
+        max_top = divider_r - shape_h - 1
+        if max_top < 0:
+            return False
+        top = random.randint(0, max_top)
+        left = random.randint(target["c0"], target["c1"] - shape_w + 1)
+
+        color = int(chamber["color"])
+        for dr, dc in shape:
+            rr = top + int(dr)
+            cc = left + int(dc)
+            if grid[rr, cc] != BG:
