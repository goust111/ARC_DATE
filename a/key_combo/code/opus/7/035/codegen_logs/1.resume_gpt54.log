+    out = main(grid)
+    if np.array_equal(out, grid):
+        return None
+    if int(np.count_nonzero(grid == BG)) <= int(grid.size // 3):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

