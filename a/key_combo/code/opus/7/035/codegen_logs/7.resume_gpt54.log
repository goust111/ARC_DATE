+    expected = np.full((h, w), BLUE, dtype=int)
+    for cells, color in zip(hole_cells, matched_colors):
+        for r, c in cells:
+            expected[r, c] = color
+
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
