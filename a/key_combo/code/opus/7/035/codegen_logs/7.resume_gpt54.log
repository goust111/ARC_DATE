+def _shape_cells(shape: tuple[tuple[int, int], ...], top: int, left: int) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in shape]
+
+
+def _choose_shapes(max_marker_h: int, max_hole_h: int, max_hole_w: int) -> tuple[
