+        (r0, c0), (r1, c1) = sorted(comp)
+        if r0 == r1 and abs(c0 - c1) == 1:
+            row_walls.append(int(r0))
+        elif c0 == c1 and abs(r0 - r1) == 1:
+            col_walls.append(int(c0))
+        else:
