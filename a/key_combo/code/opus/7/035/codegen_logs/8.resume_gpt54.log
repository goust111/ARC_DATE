+GEN_SIZE_MIN = 11
+GEN_SIZE_MAX = 15
+GEN_COUNTS = [(1, 2), (2, 1), (2, 2), (2, 2), (1, 3), (3, 1), (2, 3), (3, 2)]
+GEN_ATTEMPTS = 400
