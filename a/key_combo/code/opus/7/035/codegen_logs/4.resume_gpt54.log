+    counts = rng.sample([1, 2, 3, 4, 5], k)
+    rng.shuffle(counts)
+    return counts
+
+
+def _non_sorted_order(counts: list[int], rng: random.Random) -> list[int]:
+    indices = list(range(len(counts)))
+    for _ in range(50):
+        rng.shuffle(indices)
+        permuted = [counts[i] for i in indices]
+        if permuted != sorted(permuted):
