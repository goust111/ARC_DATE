+    starts = [0]
+    for c in _separator_columns(grid):
+        starts.append(c + 1)
+
+    stops = _separator_columns(grid) + [grid.shape[1]]
+    blocks: list[np.ndarray] = []
+    for start, stop in zip(starts, stops):
