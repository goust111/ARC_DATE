+    unsorted_blocks: list[np.ndarray] = []
+    unsorted_counts: list[int] = []
+    for color, count in zip(colors, counts):
+        sprite = _generate_sprite(color, count, rng)
+        if sprite is None:
+            return None
+        unsorted_blocks.append(sprite)
+        unsorted_counts.append(count)
