    r0, r1 = sorted([start[0], end[0]])
    c0, c1 = sorted([start[1], end[1]])
    bounds = (r0, c0, r1, c1)
    forward = _reachable(g, bg, start, moves, bounds)
    backward = _reachable(g, bg, end, [(-dr, -dc) for dr, dc in moves], bounds)
