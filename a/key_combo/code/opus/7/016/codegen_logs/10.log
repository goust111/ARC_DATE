+    out, debug = _solve_with_markers(grid, markers, source_colors_override=overrides, return_debug=True)
+    return out, debug
+
+
+def _mode_satisfied(mode: str, debug: dict) -> bool:
+    overlaps = list(debug["overlaps"].items())
+    if mode == "plain":
+        return True
+    if not overlaps:
+        return False
+    if mode == "overlap_big":
