+def _allowed_base_indices(bar_len: int) -> tuple[int, ...]:
+    if bar_len <= 1:
+        return (0,)
+    if bar_len % 2 == 1:
+        return (bar_len // 2,)
+    return (bar_len // 2 - 1, bar_len // 2)
