+from __future__ import annotations
+
+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+PALETTE = (1, 3, 4, 5, 7)
+RED = 2
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GRID_BANDS = (3, 4, 5)
+MAX_GEN_ATTEMPTS = 400
+MAX_COMBO_ATTEMPTS = 200
