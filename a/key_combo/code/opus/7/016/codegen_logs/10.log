0124: def _coords_in_bounds(coords: np.ndarray, shape: tuple[int, int]) -> bool:
0125:     return (
0126:         int(coords[:, 0].min()) >= 0
0127:         and int(coords[:, 1].min()) >= 0
0128:         and int(coords[:, 0].max()) < shape[0]
0129:         and int(coords[:, 1].max()) < shape[1]
