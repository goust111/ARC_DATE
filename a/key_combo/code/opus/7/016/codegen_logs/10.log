+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    target = int(color)
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or int(g[r, c]) != target:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(g.shape, nr, nc) and not seen[nr, nc] and int(g[nr, nc]) == target:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _label_nonred_components(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    comp_id = np.full((H, W), -1, dtype=int)
+    comps: list[dict] = []
+    cid = 0
+    for r in range(H):
+        for c in range(W):
+            if comp_id[r, c] >= 0 or int(g[r, c]) == RED:
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            comp_id[r, c] = cid
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(g.shape, nr, nc):
+                        continue
+                    if comp_id[nr, nc] >= 0 or int(g[nr, nc]) != color:
+                        continue
+                    comp_id[nr, nc] = cid
+                    q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "area": len(coords)})
+            cid += 1
+    return comp_id, comps
