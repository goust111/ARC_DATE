0077: 
0078:     out_w = sum(group.shape[1] + 1 for group in groups)
0079:     out = np.full((out_h, out_w), bg, dtype=int)
0080:     c = 0
0081:     for group in groups:
0082:         w = group.shape[1]
0083:         out[:, c : c + w] = group
0084:         c += w + 1
