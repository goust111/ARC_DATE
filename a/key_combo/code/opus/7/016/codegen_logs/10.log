0133: def _shift_is_valid(coords: np.ndarray, occupied: np.ndarray, dr: int, dc: int) -> bool:
0134:     rr = coords[:, 0] + dr
0135:     cc = coords[:, 1] + dc
0136:     return (
0137:         int(rr.min()) >= 0
0138:         and int(cc.min()) >= 0
0139:         and int(rr.max()) < occupied.shape[0]
0140:         and int(cc.max()) < occupied.shape[1]
0141:         and not bool(occupied[rr, cc].any())
