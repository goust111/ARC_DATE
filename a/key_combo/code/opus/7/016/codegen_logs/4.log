+    for row, color in zip(stripe_rows, colors):
+        start = random.randint(band_left, probe_c0)
+        end = random.randint(probe_c1, band_right)
+        if end - start + 1 < 4:
+            end = min(grid.shape[1] - 2, start + 3)
+        grid[row, start : end + 1] = int(color)
+
