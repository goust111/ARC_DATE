            return None

        sprite_size = random.randint(MIN_SPRITE_SIZE, max_possible)
        cells = _random_polyomino(sprite_size, forbidden=occupied)
        if not cells:
            return None

        sprites.append((color, cells))
        occupied.update(cells)

    return sprites


