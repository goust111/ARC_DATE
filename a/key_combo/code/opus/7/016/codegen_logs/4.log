+        band_left = probe_c0
+    if band_right < probe_c1:
+        band_right = probe_c1
+    if band_right - band_left + 1 < 4:
+        pad = 4 - (band_right - band_left + 1)
+        band_left = max(1, band_left - pad)
+        band_right = min(width - 2, band_right + pad)
+    return int(band_left), int(band_right)
