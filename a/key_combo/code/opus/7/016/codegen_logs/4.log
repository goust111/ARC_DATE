+                    options.add(prev + 1)
+                if prev > 0 and random.random() < 0.35:
+                    options.add(prev - 1)
+            else:
+                if prev > 0:
+                    options.add(prev - 1)
+                if prev < local_w - 1 and random.random() < 0.35:
+                    options.add(prev + 1)
