+def _normalize_template(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def _flip_horizontal(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    width = max(c for _, c in coords) + 1
+    return _normalize_template(tuple((r, width - 1 - c) for r, c in coords))
+
+
+def _flip_vertical(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    height = max(r for r, _ in coords) + 1
+    return _normalize_template(tuple((height - 1 - r, c) for r, c in coords))
+
+
+def _template_size(coords: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return max(rows) + 1, max(cols) + 1
+
+
+def _pick_distinct_shapes(base_templates: list[tuple[tuple[int, int], ...]], count: int, used: set[tuple[tuple[int, int], ...]]) -> list[tuple[tuple[int, int], ...]] | None:
+    variants = []
+    for template in base_templates:
+        norm = _normalize_template(template)
+        variants.append(norm)
+        variants.append(_flip_horizontal(norm))
+        variants.append(_flip_vertical(norm))
+        variants.append(_flip_vertical(_flip_horizontal(norm)))
+    unique_variants: list[tuple[tuple[int, int], ...]] = []
+    seen = set()
+    for variant in variants:
+        if variant not in seen:
+            unique_variants.append(variant)
+            seen.add(variant)
+    random.shuffle(unique_variants)
+
+    picked = []
+    for variant in unique_variants:
+        if variant in used:
+            continue
+        picked.append(variant)
+        used.add(variant)
+        if len(picked) == count:
+            return picked
+    return None
+
+
+def _pick_spaced_values(low: int, high: int, count: int, min_gap: int) -> list[int] | None:
+    values = list(range(low, high + 1))
+    random.shuffle(values)
+    picked: list[int] = []
+    for v in values:
+        if all(abs(v - old) >= min_gap for old in picked):
+            picked.append(v)
+            if len(picked) == count:
+                return sorted(picked)
+    return None
+
+
+def _choose_non_identity_permutation(n: int) -> list[int]:
+    if n == 2:
+        return [1, 0]
+    while True:
+        perm = list(range(n))
+        random.shuffle(perm)
+        if any(perm[i] != i for i in range(n)):
+            return perm
+
+
+def _place_template(top: int, left: int, template: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in template]
+
+
+def _template_anchor(template: tuple[tuple[int, int], ...], side: str) -> tuple[int, int]:
+    if side == "right":
+        edge = max(c for _, c in template)
+        candidates = [(r, c) for r, c in template if c == edge]
+        center = sum(r for r, _ in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
+        return candidates[0]
+    if side == "left":
+        edge = min(c for _, c in template)
+        candidates = [(r, c) for r, c in template if c == edge]
+        center = sum(r for r, _ in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
+        return candidates[0]
+    if side == "top":
+        edge = min(r for r, _ in template)
+        candidates = [(r, c) for r, c in template if r == edge]
+        center = sum(c for _, c in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
+        return candidates[0]
+    if side == "bottom":
+        edge = max(r for r, _ in template)
+        candidates = [(r, c) for r, c in template if r == edge]
+        center = sum(c for _, c in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
+        return candidates[0]
+    raise ValueError("invalid side")
+
+
+def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
+    return not (
+        a[2] + margin < b[0]
+        or b[2] + margin < a[0]
+        or a[3] + margin < b[1]
+        or b[3] + margin < a[1]
+    )
+
+
+def _draw_axis_path(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for (r0, c0), (r1, c1) in zip(points, points[1:]):
+        if r0 != r1 and c0 != c1:
+            raise ValueError("path segments must be axis-aligned")
+        dr = 0 if r0 == r1 else (1 if r1 > r0 else -1)
+        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
+        steps = max(abs(r1 - r0), abs(c1 - c0))
+        for i in range(steps + 1):
+            cell = (r0 + dr * i, c0 + dc * i)
+            if not coords or coords[-1] != cell:
+                coords.append(cell)
+    return coords
+
+
+def _dilate_cells(shape: tuple[int, int], cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    out = set(cells)
+    for r, c in list(cells):
+        for nr, nc in _neighbors8(r, c):
+            if _in_bounds(shape, nr, nc):
+                out.add((nr, nc))
+    return out
+
+
+def _find_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+    pq = [(0, 0, start)]
+    parents = {start: None}
+    best = {start: 0}
+    while pq:
+        _score, cost, cell = heapq.heappop(pq)
+        if cell == end:
+            path = []
+            cur = end
+            while cur is not None:
+                path.append(cur)
+                cur = parents[cur]
+            path.reverse()
+            return path
+        r, c = cell
+        neighbors = []
+        for nr, nc in _neighbors8(r, c):
+            if not _in_bounds(shape, nr, nc) or (nr, nc) in blocked:
+                continue
+            neighbors.append((nr, nc))
+        neighbors.sort(key=lambda pos: (abs(pos[0] - end[0]) + abs(pos[1] - end[1]), pos))
+        for nxt in neighbors:
+            new_cost = cost + 1
+            if new_cost < best.get(nxt, 10**9):
+                best[nxt] = new_cost
+                parents[nxt] = cell
+                heuristic = max(abs(nxt[0] - end[0]), abs(nxt[1] - end[1]))
+                heapq.heappush(pq, (new_cost + heuristic, new_cost, nxt))
+    return None
+
+
+def _side_anchor(coords: list[tuple[int, int]], side: str) -> tuple[int, int]:
+    if side == "right":
+        edge = max(c for _, c in coords)
+        candidates = [(r, c) for r, c in coords if c == edge]
+    else:
+        edge = min(c for _, c in coords)
+        candidates = [(r, c) for r, c in coords if c == edge]
+    center_row = sum(r for r, _ in coords) / len(coords)
+    candidates.sort(key=lambda cell: (abs(cell[0] - center_row), cell[0], cell[1]))
+    return candidates[0]
+
+
+def _distance(a: tuple[float, float], b: tuple[float, float]) -> float:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
+
+def _has_non_nearest_pairing(objects: list[dict], pairs: list[tuple[int, int]]) -> bool:
+    tx_ids = [tx for tx, _ in pairs]
+    for tx, rx in pairs:
+        actual = _distance(objects[tx]["center"], objects[rx]["center"])
+        best = min(_distance(objects[other]["center"], objects[rx]["center"]) for other in tx_ids)
+        if actual > best:
+            return True
+    return False
+
+
+def _validate_scene(inp: np.ndarray, expected_pairs: int) -> bool:
+    try:
+        objects, paths, pairs = _analyze(inp)
+    except Exception:
+        return False
+    if len(paths) != expected_pairs or len(pairs) != expected_pairs:
+        return False
+    if len(objects) != expected_pairs * 2:
+        return False
+    colors = [obj["color"] for obj in objects]
+    if len(set(colors)) != len(colors):
+        return False
+    if not _has_non_nearest_pairing(objects, pairs):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_pairs = random.choice([2, 3])
+    h = random.randint(20, 26) if n_pairs == 2 else random.randint(26, 29)
+    w = random.randint(22, 27) if n_pairs == 2 else random.randint(26, 29)
+
+    row_slots = _pick_spaced_values(2, h - 3, 2 * n_pairs, min_gap=3)
+    if row_slots is None:
+        return None
+    random.shuffle(row_slots)
+    left_rows = sorted(row_slots[:n_pairs])
+    right_rows = sorted(row_slots[n_pairs:])
+    perm = _choose_non_identity_permutation(n_pairs)
+
+    colors = random.sample(OBJECT_COLORS, 2 * n_pairs)
+    roles = [random.choice(["left_tx", "right_tx"]) for _ in range(n_pairs)]
+
+    used_shapes: set[tuple[tuple[int, int], ...]] = set()
+    symmetric_shapes = _pick_distinct_shapes(SYMMETRIC_TEMPLATES, n_pairs, used_shapes)
+    asymmetric_shapes = _pick_distinct_shapes(ASYMMETRIC_TEMPLATES, n_pairs, used_shapes)
+    if symmetric_shapes is None or asymmetric_shapes is None:
+        return None
+
+    objects: list[dict] = []
+    occupied_objects: set[tuple[int, int]] = set()
+
+    for i in range(n_pairs):
+        left_is_tx = roles[i] == "left_tx"
+        left_template = symmetric_shapes[i] if left_is_tx else asymmetric_shapes[i]
+        right_template = asymmetric_shapes[i] if left_is_tx else symmetric_shapes[i]
+
+        left_anchor = _template_anchor(left_template, "right")
+        right_anchor = _template_anchor(right_template, "left")
+        left_coords = _place_template(left_rows[i] - left_anchor[0], 2 - left_anchor[1], left_template)
+        right_coords = _place_template(right_rows[perm[i]] - right_anchor[0], (w - 3) - right_anchor[1], right_template)
+
+        for coords in (left_coords, right_coords):
+            if not all(_in_bounds((h, w), r, c) for r, c in coords):
+                return None
+        left_bbox = _bbox(left_coords)
+        right_bbox = _bbox(right_coords)
+        for prior in objects:
+            if _bbox_overlap(left_bbox, prior["bbox"], margin=1) or _bbox_overlap(right_bbox, prior["bbox"], margin=1):
+                return None
+        if _bbox_overlap(left_bbox, right_bbox, margin=2):
+            return None
+
+        left_obj = {
+            "coords": left_coords,
+            "bbox": left_bbox,
+            "color": colors[2 * i],
+            "symmetric": left_is_tx,
+            "pair_index": i,
+            "side": "left",
+        }
+        right_obj = {
+            "coords": right_coords,
+            "bbox": right_bbox,
+            "color": colors[2 * i + 1],
+            "symmetric": not left_is_tx,
+            "pair_index": i,
+            "side": "right",
+        }
+        objects.extend([left_obj, right_obj])
+        occupied_objects.update(left_coords)
+        occupied_objects.update(right_coords)
+
+    grid = np.zeros((h, w), dtype=int)
+    for obj in objects:
+        for r, c in obj["coords"]:
+            grid[r, c] = obj["color"]
+
+    path_cells_all: set[tuple[int, int]] = set()
+    pair_order = list(range(n_pairs))
+    pair_order.sort(key=lambda i: abs(left_rows[i] - right_rows[perm[i]]), reverse=True)
+    pair_paths: dict[int, list[tuple[int, int]]] = {}
+
+    for i in pair_order:
+        left_obj = next(obj for obj in objects if obj["pair_index"] == i and obj["side"] == "left")
+        right_obj = next(obj for obj in objects if obj["pair_index"] == i and obj["side"] == "right")
+        left_anchor_cell = _side_anchor(left_obj["coords"], "right")
+        right_anchor_cell = _side_anchor(right_obj["coords"], "left")
+        start = (left_anchor_cell[0], left_anchor_cell[1] + 1)
+        end = (right_anchor_cell[0], right_anchor_cell[1] - 1)
+        if not _in_bounds((h, w), *start) or not _in_bounds((h, w), *end):
+            return None
+
+        blocked = set(occupied_objects)
+        blocked.update(_dilate_cells((h, w), path_cells_all))
+        for obj in objects:
+            if obj["pair_index"] != i:
+                blocked.update(_dilate_cells((h, w), set(obj["coords"])))
+
+        path = _find_path((h, w), start, end, blocked)
+        if path is None:
+            return None
+        pair_paths[i] = path
+        path_cells_all.update(path)
+
+    for path in pair_paths.values():
+        for r, c in path:
+            if (r, c) in occupied_objects:
+                return None
+            grid[r, c] = PATH
+
+    if not _validate_scene(grid, n_pairs):
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    if np.count_nonzero(out == PATH) != 0:
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a valid puzzle instance")

diff --git a//home/lixinyu/snap/a/key_combo/code/opus/7/016/1.py b//home/lixinyu/snap/a/key_combo/code/opus/7/016/1.py
