+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+    pq = [(0, 0, start)]
+    parents = {start: None}
+    best = {start: 0}
+    while pq:
+        _score, cost, cell = heapq.heappop(pq)
