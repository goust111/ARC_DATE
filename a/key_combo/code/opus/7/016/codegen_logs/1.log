+    symmetric_shapes = _pick_distinct_shapes(SYMMETRIC_TEMPLATES, n_pairs, used_shapes)
+    asymmetric_shapes = _pick_distinct_shapes(ASYMMETRIC_TEMPLATES, n_pairs, used_shapes)
