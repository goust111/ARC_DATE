+import numpy as np
+
+
+BG = 0
+PATH = 5
+OBJECT_COLORS = [1, 2, 3, 4, 6, 7]
+MAX_GENERATION_ATTEMPTS = 400
+
+
+SYMMETRIC_TEMPLATES = [
+    ((0, 0), (0, 1), (1, 0), (1, 1)),
