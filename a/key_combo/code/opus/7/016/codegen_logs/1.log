+    paths = _path_components(grid)
+    if not paths:
+        raise ValueError("no gray paths found")
+
+    pairs: list[tuple[int, int]] = []
+    used_objects: set[int] = set()
+    for path in paths:
+        touched: set[int] = set()
+        for r, c in path["coords"]:
+            for nr, nc in _neighbors8(r, c):
+                obj_id = obj_at.get((nr, nc))
+                if obj_id is not None:
+                    touched.add(obj_id)
+        if len(touched) != 2:
+            raise ValueError(f"path touches {len(touched)} objects instead of 2")
+        a, b = sorted(touched)
+        if objects[a]["symmetric"] == objects[b]["symmetric"]:
+            raise ValueError("path does not connect one symmetric and one asymmetric object")
+        tx = a if objects[a]["symmetric"] else b
+        rx = b if tx == a else a
+        if tx in used_objects or rx in used_objects:
+            raise ValueError("object participates in multiple paths")
+        used_objects.add(tx)
+        used_objects.add(rx)
+        pairs.append((tx, rx))
+
+    if len(used_objects) != len(objects):
+        raise ValueError("some objects are not paired")
+    return objects, paths, pairs
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Route each symmetric sender's color along its gray path to the non-symmetric receiver, then wrap that receiver in its original color.
+
+    Input structure:
+    - The background is black.
+    - Several small single-color 4-connected objects use distinct non-gray colors.
+    - Gray 8-connected path components connect the objects into disjoint pairs.
+    - In each pair, exactly one object's shape is horizontally symmetric inside its own bounding box.
+
+    Rule:
+    - Detect horizontal symmetry within each object's own bounding box; the symmetric object is the sender and the other is the receiver.
+    - Follow each gray path component to identify which sender is paired with which receiver.
+    - Recolor every receiver pixel to the paired sender's color.
+    - Around each recolored receiver, paint the one-cell outer border of its expanded bounding box using the receiver's original color.
+    - Erase all gray path pixels and erase every sender object.
+
+    Key insight:
+    - Symmetry decides direction, but the gray path decides pairing, so the final receiver combines the sender's color inside with the receiver's own original color on the outside.
+    """
+    g = np.asarray(grid, dtype=int)
+    objects, paths, pairs = _analyze(g)
+
+    out = g.copy()
+    out[out == PATH] = BG
+
+    for tx, _ in pairs:
+        for r, c in objects[tx]["coords"]:
+            out[r, c] = BG
+
+    for tx, rx in pairs:
+        tx_color = int(objects[tx]["color"])
+        rx_color = int(objects[rx]["color"])
+        for r, c in objects[rx]["coords"]:
+            out[r, c] = tx_color
+        r0, c0, r1, c1 = objects[rx]["bbox"]
+        for r in range(r0 - 1, r1 + 2):
+            for c in range(c0 - 1, c1 + 2):
+                if not _in_bounds(out.shape, r, c):
+                    continue
+                if r0 <= r <= r1 and c0 <= c <= c1:
+                    continue
+                out[r, c] = rx_color
+
+    return out
+
+
+def _normalize_template(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def _flip_horizontal(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    width = max(c for _, c in coords) + 1
+    return _normalize_template(tuple((r, width - 1 - c) for r, c in coords))
+
+
+def _flip_vertical(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    height = max(r for r, _ in coords) + 1
+    return _normalize_template(tuple((height - 1 - r, c) for r, c in coords))
+
+
+def _template_size(coords: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return max(rows) + 1, max(cols) + 1
+
+
+def _pick_distinct_shapes(base_templates: list[tuple[tuple[int, int], ...]], count: int, used: set[tuple[tuple[int, int], ...]]) -> list[tuple[tuple[int, int], ...]] | None:
+    variants = []
+    for template in base_templates:
+        norm = _normalize_template(template)
+        variants.append(norm)
+        variants.append(_flip_horizontal(norm))
+        variants.append(_flip_vertical(norm))
+        variants.append(_flip_vertical(_flip_horizontal(norm)))
+    unique_variants: list[tuple[tuple[int, int], ...]] = []
+    seen = set()
+    for variant in variants:
+        if variant not in seen:
+            unique_variants.append(variant)
+            seen.add(variant)
+    random.shuffle(unique_variants)
+
+    picked = []
+    for variant in unique_variants:
+        if variant in used:
+            continue
+        picked.append(variant)
+        used.add(variant)
+        if len(picked) == count:
+            return picked
+    return None
+
+
+def _pick_spaced_values(low: int, high: int, count: int, min_gap: int) -> list[int] | None:
+    values = list(range(low, high + 1))
+    random.shuffle(values)
+    picked: list[int] = []
+    for v in values:
+        if all(abs(v - old) >= min_gap for old in picked):
+            picked.append(v)
+            if len(picked) == count:
+                return sorted(picked)
+    return None
+
+
+def _choose_non_identity_permutation(n: int) -> list[int]:
+    if n == 2:
+        return [1, 0]
+    while True:
+        perm = list(range(n))
+        random.shuffle(perm)
+        if any(perm[i] != i for i in range(n)):
+            return perm
+
+
+def _place_template(top: int, left: int, template: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in template]
+
+
+def _template_anchor(template: tuple[tuple[int, int], ...], side: str) -> tuple[int, int]:
+    if side == "right":
+        edge = max(c for _, c in template)
+        candidates = [(r, c) for r, c in template if c == edge]
+        center = sum(r for r, _ in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
+        return candidates[0]
+    if side == "left":
+        edge = min(c for _, c in template)
+        candidates = [(r, c) for r, c in template if c == edge]
+        center = sum(r for r, _ in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
+        return candidates[0]
+    if side == "top":
+        edge = min(r for r, _ in template)
+        candidates = [(r, c) for r, c in template if r == edge]
+        center = sum(c for _, c in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
+        return candidates[0]
+    if side == "bottom":
+        edge = max(r for r, _ in template)
+        candidates = [(r, c) for r, c in template if r == edge]
+        center = sum(c for _, c in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
+        return candidates[0]
+    raise ValueError("invalid side")
+
+
+def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
+    return not (
+        a[2] + margin < b[0]
+        or b[2] + margin < a[0]
+        or a[3] + margin < b[1]
+        or b[3] + margin < a[1]
+    )
+
+
+def _draw_axis_path(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for (r0, c0), (r1, c1) in zip(points, points[1:]):
+        if r0 != r1 and c0 != c1:
+            raise ValueError("path segments must be axis-aligned")
+        dr = 0 if r0 == r1 else (1 if r1 > r0 else -1)
+        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
+        steps = max(abs(r1 - r0), abs(c1 - c0))
+        for i in range(steps + 1):
+            cell = (r0 + dr * i, c0 + dc * i)
+            if not coords or coords[-1] != cell:
+                coords.append(cell)
+    return coords
+
+
+def _dilate_cells(shape: tuple[int, int], cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    out = set(cells)
+    for r, c in list(cells):
+        for nr, nc in _neighbors8(r, c):
+            if _in_bounds(shape, nr, nc):
+                out.add((nr, nc))
+    return out
+
+
+def _find_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+    pq = [(0, 0, start)]
+    parents = {start: None}
+    best = {start: 0}
+    while pq:
+        _score, cost, cell = heapq.heappop(pq)
+        if cell == end:
+            path = []
+            cur = end
+            while cur is not None:
+                path.append(cur)
+                cur = parents[cur]
+            path.reverse()
+            return path
+        r, c = cell
+        neighbors = []
+        for nr, nc in _neighbors8(r, c):
+            if not _in_bounds(shape, nr, nc) or (nr, nc) in blocked:
+                continue
+            neighbors.append((nr, nc))
+        neighbors.sort(key=lambda pos: (abs(pos[0] - end[0]) + abs(pos[1] - end[1]), pos))
+        for nxt in neighbors:
+            new_cost = cost + 1
+            if new_cost < best.get(nxt, 10**9):
+                best[nxt] = new_cost
+                parents[nxt] = cell
+                heuristic = max(abs(nxt[0] - end[0]), abs(nxt[1] - end[1]))
+                heapq.heappush(pq, (new_cost + heuristic, new_cost, nxt))
+    return None
+
+
+def _side_anchor(coords: list[tuple[int, int]], side: str) -> tuple[int, int]:
+    if side == "right":
+        edge = max(c for _, c in coords)
+        candidates = [(r, c) for r, c in coords if c == edge]
+    else:
+        edge = min(c for _, c in coords)
+        candidates = [(r, c) for r, c in coords if c == edge]
+    center_row = sum(r for r, _ in coords) / len(coords)
+    candidates.sort(key=lambda cell: (abs(cell[0] - center_row), cell[0], cell[1]))
+    return candidates[0]
+
+
+def _distance(a: tuple[float, float], b: tuple[float, float]) -> float:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
+
+def _has_non_nearest_pairing(objects: list[dict], pairs: list[tuple[int, int]]) -> bool:
+    tx_ids = [tx for tx, _ in pairs]
+    for tx, rx in pairs:
+        actual = _distance(objects[tx]["center"], objects[rx]["center"])
+        best = min(_distance(objects[other]["center"], objects[rx]["center"]) for other in tx_ids)
+        if actual > best:
+            return True
+    return False
+
+
+def _validate_scene(inp: np.ndarray, expected_pairs: int) -> bool:
+    try:
