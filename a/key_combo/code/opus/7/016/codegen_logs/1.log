+            "kind": "lr",
+            "first_anchor": (h - 5, 2),
+            "first_side": "right",
+            "second_anchor": (outer_top, w - 3),
+            "second_side": "left",
+            "path": [(h - 5, 3), (outer_bottom, 3), (outer_bottom, w - 6), (outer_top, w - 6), (outer_top, w - 4)],
