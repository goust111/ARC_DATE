+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
