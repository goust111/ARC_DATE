+    return None
+
+
+def _choose_non_identity_permutation(n: int) -> list[int]:
+    if n == 2:
+        return [1, 0]
+    while True:
+        perm = list(range(n))
+        random.shuffle(perm)
+        if any(perm[i] != i for i in range(n)):
+            return perm
+
+
+def _place_template(top: int, left: int, template: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in template]
+
+
+def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
+    return not (
+        a[2] + margin < b[0]
+        or b[2] + margin < a[0]
+        or a[3] + margin < b[1]
+        or b[3] + margin < a[1]
+    )
+
+
+def _draw_axis_path(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    coords: list[tuple[int, int]] = []
+    for (r0, c0), (r1, c1) in zip(points, points[1:]):
+        if r0 != r1 and c0 != c1:
+            raise ValueError("path segments must be axis-aligned")
+        dr = 0 if r0 == r1 else (1 if r1 > r0 else -1)
+        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
+        steps = max(abs(r1 - r0), abs(c1 - c0))
+        for i in range(steps + 1):
+            cell = (r0 + dr * i, c0 + dc * i)
+            if not coords or coords[-1] != cell:
+                coords.append(cell)
+    return coords
+
+
+def _side_anchor(coords: list[tuple[int, int]], side: str) -> tuple[int, int]:
+    if side == "right":
+        edge = max(c for _, c in coords)
+        candidates = [(r, c) for r, c in coords if c == edge]
+    else:
+        edge = min(c for _, c in coords)
+        candidates = [(r, c) for r, c in coords if c == edge]
+    candidates.sort()
+    return random.choice(candidates)
+
+
+def _distance(a: tuple[float, float], b: tuple[float, float]) -> float:
+    return abs(a[0] - b[0]) + abs(a[1] - b[1])
+
+
+def _has_non_nearest_pairing(objects: list[dict], pairs: list[tuple[int, int]]) -> bool:
+    tx_ids = [tx for tx, _ in pairs]
+    for tx, rx in pairs:
+        actual = _distance(objects[tx]["center"], objects[rx]["center"])
+        best = min(_distance(objects[other]["center"], objects[rx]["center"]) for other in tx_ids)
+        if actual > best:
+            return True
+    return False
+
+
+def _validate_scene(inp: np.ndarray, expected_pairs: int) -> bool:
+    try:
+        objects, paths, pairs = _analyze(inp)
+    except Exception:
+        return False
+    if len(paths) != expected_pairs or len(pairs) != expected_pairs:
+        return False
+    if len(objects) != expected_pairs * 2:
+        return False
+    colors = [obj["color"] for obj in objects]
+    if len(set(colors)) != len(colors):
+        return False
+    if not _has_non_nearest_pairing(objects, pairs):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_pairs = random.choice([2, 3, 3])
+    h = random.randint(13 if n_pairs == 2 else 18, 18 if n_pairs == 2 else 24)
+    w = random.randint(17 if n_pairs == 2 else 21, 22 if n_pairs == 2 else 27)
+
+    left_tops = _pick_spaced_values(0, h - 3, n_pairs, min_gap=5)
+    right_tops = _pick_spaced_values(0, h - 3, n_pairs, min_gap=5)
+    if left_tops is None or right_tops is None:
+        return None
+
+    corridor_rows = _pick_spaced_values(1, h - 2, n_pairs, min_gap=4)
+    if corridor_rows is None:
+        return None
+
+    perm = _choose_non_identity_permutation(n_pairs)
+    colors = random.sample(OBJECT_COLORS, 2 * n_pairs)
+    roles = [random.choice(["left_tx", "right_tx"]) for _ in range(n_pairs)]
+
+    used_shapes: set[tuple[tuple[int, int], ...]] = set()
+    symmetric_shapes = _pick_distinct_shapes(SYMMETRIC_TEMPLATES, n_pairs, used_shapes)
+    asymmetric_shapes = _pick_distinct_shapes(ASYMMETRIC_TEMPLATES, n_pairs, used_shapes)
+    if symmetric_shapes is None or asymmetric_shapes is None:
+        return None
+
+    objects: list[dict] = []
+    occupied_objects: set[tuple[int, int]] = set()
+
+    for i in range(n_pairs):
+        left_role_tx = roles[i] == "left_tx"
+        left_template = symmetric_shapes[i] if left_role_tx else asymmetric_shapes[i]
+        right_template = asymmetric_shapes[i] if left_role_tx else symmetric_shapes[i]
+        left_h, left_w = _template_size(left_template)
+        right_h, right_w = _template_size(right_template)
+
+        left_top = min(left_tops[i], h - left_h)
+        right_top = min(right_tops[perm[i]], h - right_h)
+        left_col = random.randint(0, 1)
+        right_col = random.randint(w - right_w - 1, w - right_w)
+
+        left_coords = _place_template(left_top, left_col, left_template)
+        right_coords = _place_template(right_top, right_col, right_template)
+
+        left_bbox = _bbox(left_coords)
+        right_bbox = _bbox(right_coords)
+        for prior in objects:
+            if _bbox_overlap(left_bbox, prior["bbox"], margin=1) or _bbox_overlap(right_bbox, prior["bbox"], margin=1):
+                return None
+        if _bbox_overlap(left_bbox, right_bbox, margin=2):
+            return None
+
+        left_color = colors[2 * i]
+        right_color = colors[2 * i + 1]
+        left_obj = {
+            "coords": left_coords,
+            "bbox": left_bbox,
+            "color": left_color,
+            "symmetric": left_role_tx,
+            "pair_index": i,
+            "side": "left",
+        }
+        right_obj = {
+            "coords": right_coords,
+            "bbox": right_bbox,
+            "color": right_color,
+            "symmetric": not left_role_tx,
+            "pair_index": i,
+            "side": "right",
+        }
+        objects.extend([left_obj, right_obj])
+        occupied_objects.update(left_coords)
+        occupied_objects.update(right_coords)
+
+    grid = np.zeros((h, w), dtype=int)
+    for obj in objects:
+        for r, c in obj["coords"]:
+            if not _in_bounds(grid.shape, r, c) or grid[r, c] != BG:
+                return None
+            grid[r, c] = obj["color"]
+
+    path_cells_all: set[tuple[int, int]] = set()
+    pairs_layout = []
+    for i in range(n_pairs):
+        left_obj = next(obj for obj in objects if obj["pair_index"] == i and obj["side"] == "left")
+        right_obj = next(obj for obj in objects if obj["pair_index"] == i and obj["side"] == "right")
+        left_anchor = _side_anchor(left_obj["coords"], "right")
+        right_anchor = _side_anchor(right_obj["coords"], "left")
+        start = (left_anchor[0], left_anchor[1] + 1)
+        end = (right_anchor[0], right_anchor[1] - 1)
+        if not _in_bounds(grid.shape, *start) or not _in_bounds(grid.shape, *end):
+            return None
+        left_stub = 5 + 2 * i
+        right_stub = w - 6 - 2 * i
+        if left_stub <= start[1] or right_stub >= end[1] or left_stub >= right_stub:
+            return None
+        points = [
+            start,
+            (start[0], left_stub),
+            (corridor_rows[i], left_stub),
+            (corridor_rows[i], right_stub),
+            (end[0], right_stub),
+            end,
+        ]
+        path_cells = _draw_axis_path(points)
+        for cell in path_cells:
+            if cell in occupied_objects:
+                return None
+            for nr, nc in _neighbors8(*cell):
+                if (nr, nc) in path_cells_all and (nr, nc) not in path_cells:
+                    return None
+        path_cells_all.update(path_cells)
+        pairs_layout.append((left_obj, right_obj, path_cells))
+
+    for _, _, path_cells in pairs_layout:
+        for r, c in path_cells:
+            if grid[r, c] != BG:
+                return None
+            grid[r, c] = PATH
+
+    if not _validate_scene(grid, n_pairs):
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    if np.count_nonzero(out == PATH) != 0:
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        result = _gen_attempt()
+        if result is not None:
+            return result
+    raise RuntimeError("failed to generate a valid puzzle instance")

