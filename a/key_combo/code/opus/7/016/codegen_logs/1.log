+            grid[r, c] = PATH
+
+    if not _validate_scene(grid, n_pairs):
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    if np.count_nonzero(out == PATH) != 0:
+        return None
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
