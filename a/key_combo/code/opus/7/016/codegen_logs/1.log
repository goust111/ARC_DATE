+
+    outer_top = random.randint(1, 2)
+    outer_bottom = h - 2
+    outer_right = w - 3
+
+    specs = [
+        {
+            "kind": "lr",
+            "first_anchor": (inner_top, 2),
+            "first_side": "right",
+            "second_anchor": (inner_bottom, w - 3),
+            "second_side": "left",
+            "path": [(inner_top, 3), (inner_top, inner_mid), (inner_bottom, inner_mid), (inner_bottom, w - 4)],
