+                "first_anchor": (2, vertical_col),
+                "first_side": "bottom",
+                "second_anchor": (h - 3, vertical_col),
+                "second_side": "top",
+                "path": [(3, vertical_col), (h - 4, vertical_col)],
+            }
+        )
