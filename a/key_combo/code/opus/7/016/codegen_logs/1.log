+
+def _find_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    blocked = set(blocked)
+    blocked.discard(start)
+    blocked.discard(end)
+    pq = [(0, 0, start)]
+    parents = {start: None}
+    best = {start: 0}
+    while pq:
+        _score, cost, cell = heapq.heappop(pq)
+        if cell == end:
+            path = []
+            cur = end
+            while cur is not None:
+                path.append(cur)
+                cur = parents[cur]
