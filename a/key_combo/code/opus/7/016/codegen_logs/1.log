+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Route each symmetric sender's color along its gray path to the non-symmetric receiver, then wrap that receiver in its original color.
+
+    Input structure:
+    - The background is black.
+    - Several small single-color 4-connected objects use distinct non-gray colors.
+    - Gray 8-connected path components connect the objects into disjoint pairs.
+    - In each pair, exactly one object's shape is horizontally symmetric inside its own bounding box.
+
+    Rule:
+    - Detect horizontal symmetry within each object's own bounding box; the symmetric object is the sender and the other is the receiver.
+    - Follow each gray path component to identify which sender is paired with which receiver.
+    - Recolor every receiver pixel to the paired sender's color.
+    - Around each recolored receiver, paint the one-cell outer border of its expanded bounding box using the receiver's original color.
+    - Erase all gray path pixels and erase every sender object.
+
+    Key insight:
+    - Symmetry decides direction, but the gray path decides pairing, so the final receiver combines the sender's color inside with the receiver's own original color on the outside.
+    """
+    g = np.asarray(grid, dtype=int)
+    objects, paths, pairs = _analyze(g)
+
+    out = g.copy()
+    out[out == PATH] = BG
+
+    for tx, _ in pairs:
+        for r, c in objects[tx]["coords"]:
+            out[r, c] = BG
+
+    for tx, rx in pairs:
+        tx_color = int(objects[tx]["color"])
+        rx_color = int(objects[rx]["color"])
+        for r, c in objects[rx]["coords"]:
+            out[r, c] = tx_color
+        r0, c0, r1, c1 = objects[rx]["bbox"]
+        for r in range(r0 - 1, r1 + 2):
+            for c in range(c0 - 1, c1 + 2):
+                if not _in_bounds(out.shape, r, c):
+                    continue
+                if r0 <= r <= r1 and c0 <= c <= c1:
+                    continue
+                out[r, c] = rx_color
+
+    return out
+
+
+def _normalize_template(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def _flip_horizontal(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    width = max(c for _, c in coords) + 1
+    return _normalize_template(tuple((r, width - 1 - c) for r, c in coords))
+
+
+def _flip_vertical(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    height = max(r for r, _ in coords) + 1
+    return _normalize_template(tuple((height - 1 - r, c) for r, c in coords))
+
+
+def _template_size(coords: tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return max(rows) + 1, max(cols) + 1
+
+
+def _pick_distinct_shapes(base_templates: list[tuple[tuple[int, int], ...]], count: int, used: set[tuple[tuple[int, int], ...]]) -> list[tuple[tuple[int, int], ...]] | None:
+    variants = []
+    for template in base_templates:
+        norm = _normalize_template(template)
+        variants.append(norm)
+        variants.append(_flip_horizontal(norm))
+        variants.append(_flip_vertical(norm))
+        variants.append(_flip_vertical(_flip_horizontal(norm)))
+    unique_variants: list[tuple[tuple[int, int], ...]] = []
+    seen = set()
+    for variant in variants:
+        if variant not in seen:
+            unique_variants.append(variant)
+            seen.add(variant)
+    random.shuffle(unique_variants)
+
+    picked = []
+    for variant in unique_variants:
+        if variant in used:
+            continue
+        picked.append(variant)
+        used.add(variant)
+        if len(picked) == count:
+            return picked
+    return None
+
+
+def _pick_spaced_values(low: int, high: int, count: int, min_gap: int) -> list[int] | None:
+    values = list(range(low, high + 1))
+    random.shuffle(values)
+    picked: list[int] = []
+    for v in values:
+        if all(abs(v - old) >= min_gap for old in picked):
+            picked.append(v)
+            if len(picked) == count:
+                return sorted(picked)
+    return None
+
+
+def _choose_non_identity_permutation(n: int) -> list[int]:
+    if n == 2:
+        return [1, 0]
+    while True:
+        perm = list(range(n))
+        random.shuffle(perm)
+        if any(perm[i] != i for i in range(n)):
+            return perm
+
+
+def _place_template(top: int, left: int, template: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
+    return [(top + r, left + c) for r, c in template]
+
+
+def _template_anchor(template: tuple[tuple[int, int], ...], side: str) -> tuple[int, int]:
+    if side == "right":
+        edge = max(c for _, c in template)
+        candidates = [(r, c) for r, c in template if c == edge]
+        center = sum(r for r, _ in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
+        return candidates[0]
+    if side == "left":
+        edge = min(c for _, c in template)
+        candidates = [(r, c) for r, c in template if c == edge]
+        center = sum(r for r, _ in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
+        return candidates[0]
+    if side == "top":
+        edge = min(r for r, _ in template)
+        candidates = [(r, c) for r, c in template if r == edge]
+        center = sum(c for _, c in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
+        return candidates[0]
+    if side == "bottom":
+        edge = max(r for r, _ in template)
+        candidates = [(r, c) for r, c in template if r == edge]
+        center = sum(c for _, c in template) / len(template)
+        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
+        return candidates[0]
