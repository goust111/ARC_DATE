+def _gen_attempt() -> np.ndarray | None:
+    side = random.randint(5, 7)
+    out_h, out_w = _choose_counts(side)
+    ul = _scatter_count_quadrant(side, BLUE, out_h)
+    ur = _scatter_count_quadrant(side, RED, out_w)
