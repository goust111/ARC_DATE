+    grid[:side, :side] = ul
+    grid[:side, side:] = ur
+    grid[side:, :side] = ll
+    grid[side:, side:] = rr
+
+    try:
+        _validate_semantics(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

