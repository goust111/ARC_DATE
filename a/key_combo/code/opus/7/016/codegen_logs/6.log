+    for _ in range(300):
+        rows = sorted(random.sample(all_rows, len(sorted_specs)))
+        if all(rows[i] in feasible_rows[i] for i in range(len(rows))):
+            if any(rows[i] != sorted_specs[i]["marker_abs"][0] for i in range(len(rows))):
+                return rows
