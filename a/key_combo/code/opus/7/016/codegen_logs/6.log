+def _expand8(coords: set[tuple[int, int]], H: int, W: int) -> set[tuple[int, int]]:
+    expanded = set()
+    for r, c in coords:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if 0 <= nr < H and 0 <= nc < W:
+                    expanded.add((int(nr), int(nc)))
