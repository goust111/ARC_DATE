+            if nxt != goal and nxt in forbidden:
+                continue
+            prev[nxt] = cur
+            dq.append(nxt)
+    if goal not in prev:
+        return None
+    out = []
+    cur = goal
+    while cur is not None:
+        out.append(cur)
+        cur = prev[cur]
+    out.reverse()
+    return out
+
+
+def _route_to_goal(
+    grid: np.ndarray,
+    sprite: dict,
+    goal: tuple[int, int],
+    other_sprites: list[dict],
+    used_paths: set[tuple[int, int]],
