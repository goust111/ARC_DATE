+def _bfs_path(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    H, W = grid.shape
+    dq = deque([start])
+    prev = {start: None}
+    while dq:
+        cur = dq.popleft()
+        if cur == goal:
+            break
+        nbrs = sorted(
+            _neighbors8(cur[0], cur[1]),
+            key=lambda rc: (abs(rc[0] - goal[0]) + abs(rc[1] - goal[1]), abs(rc[0] - cur[0]) + abs(rc[1] - cur[1])),
+        )
+        for nr, nc in nbrs:
+            nxt = (int(nr), int(nc))
+            if not (0 <= nr < H and 0 <= nc < W):
+                continue
+            if nxt in prev:
