+    for other in other_sprites:
+        other_forbidden |= _expand8(set(other["coords"]), H, W)
+
+    starts = _candidate_starts(grid, sprite["marker_abs"], other_forbidden | _expand8(used_paths, H, W))
+    if not starts:
+        return None
