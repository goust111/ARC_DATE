+        if path is None:
+            continue
+        if any(any((nr, nc) in own_coords for nr, nc in _neighbors8(r, c)) for r, c in path[1:]):
+            continue
+        if best is None or len(path) < len(best):
+            best = path
+    return best
+
+
+def _route_fragment(
