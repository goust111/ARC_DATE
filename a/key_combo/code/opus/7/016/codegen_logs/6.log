+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+BODY_COLORS = (6, 7, 8, 9)
+MARKER_COLORS = (BLUE, RED, GREEN, YELLOW)
+GEN_ATTEMPTS = 500
