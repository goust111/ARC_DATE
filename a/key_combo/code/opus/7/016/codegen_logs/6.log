+            continue
+        body_offsets = sorted((int(r), int(c)) for r, c in mapped if (r, c) != (0, 0))
+        rows = [0] + [r for r, _c in body_offsets]
+        cols = [0] + [c for _r, c in body_offsets]
+        if max(rows) - min(rows) <= 3 and max(cols) - min(cols) <= 3:
+            return body_offsets
