+def _stamped_cells(spec: dict, row: int, cols: list[int]) -> set[tuple[int, int]]:
+    painted = set()
+    for col in cols:
+        for dr, dc in spec["body_offsets"]:
+            painted.add((int(row + dr), int(col + dc)))
+    return painted
