+    bottom = 0
+    while bottom < n and int(line[n - 1 - bottom]) == BLACK:
+        bottom += 1
+    if top == 0 or bottom == 0 or top + bottom >= n:
+        return None
+    middle = line[top : n - bottom]
+    if np.any(middle == BLACK):
