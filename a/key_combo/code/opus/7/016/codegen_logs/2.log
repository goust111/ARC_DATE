+        shift_c = INNER_MIN + random.randint(0, (INNER_MAX - INNER_MIN + 1) - (sc1 - sc0 + 1))
+        concrete = tuple(sorted((int(r + shift_r), int(c + shift_c)) for r, c in shape))
