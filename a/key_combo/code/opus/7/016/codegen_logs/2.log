+INNER_MIN = 1
+INNER_MAX = TILE_SIZE - 2
+ARRAY_GAP = 1
+ARRAY_SIDE = 3
+ARRAY_SPAN = ARRAY_SIDE * TILE_SIZE + (ARRAY_SIDE - 1) * ARRAY_GAP
