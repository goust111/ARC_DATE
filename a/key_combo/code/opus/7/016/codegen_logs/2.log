+    "domino": ((0, 0), (0, 1)),
+    "line3": ((0, 0), (0, 1), (0, 2)),
+    "el3": ((0, 0), (1, 0), (1, 1)),
+    "square4": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "el4": ((0, 0), (1, 0), (2, 0), (2, 1)),
+    "tee4": ((0, 1), (1, 0), (1, 1), (1, 2)),
+    "zig4": ((0, 1), (0, 2), (1, 0), (1, 1)),
