+
+def _normalize_coords(coords) -> tuple[tuple[int, int], ...]:
+    pts = np.asarray(list(coords), dtype=int)
+    if pts.size == 0:
+        return ()
+    pts -= pts.min(axis=0)
+    return tuple(sorted((int(r), int(c)) for r, c in pts))
