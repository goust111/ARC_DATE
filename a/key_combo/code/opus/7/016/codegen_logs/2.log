+
+    for sprite in parsed_sprites:
+        matches = _match_candidates(sprite["patch"], parsed_active)
+        if len(matches) != 1:
+            return None
+
+    expected = _render_expected(grid, tiles, sprite_specs)
+    actual = main(grid)
+    if np.array_equal(actual, grid):
+        return None
+    if not np.array_equal(actual, expected):
