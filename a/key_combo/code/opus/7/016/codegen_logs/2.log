+
+def _paint_docked_patch(
+    out: np.ndarray,
+    tile: dict,
+    patch: np.ndarray,
+    match_color: int,
+    swap_colors: bool,
+) -> None:
+    colors = sorted(int(color) for color in np.unique(patch) if int(color) != Color.BLACK)
+    assert len(colors) == 2
+    remap = {colors[0]: colors[0], colors[1]: colors[1]}
+    if swap_colors:
