+
+def _is_connected(coords) -> bool:
+    cells = {tuple(map(int, cell)) for cell in coords}
+    if not cells:
+        return False
+    seen = {next(iter(cells))}
+    stack = list(seen)
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            nxt = (int(nr), int(nc))
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(cells)
