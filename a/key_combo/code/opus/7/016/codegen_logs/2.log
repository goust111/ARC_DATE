+        r0, c0, r1, c1 = _bbox_of_coords(union)
+        if (r1 - r0 + 1) > TILE_SIZE or (c1 - c0 + 1) > TILE_SIZE:
+            continue
+        return _coords_to_patch(match_cells, other, match_color, other_color)
