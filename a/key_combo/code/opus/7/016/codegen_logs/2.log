+        while len(other) < other_size:
+            frontier = set()
+            for r, c in other:
+                for nr, nc in _neighbors4(r, c):
+                    if low <= nr <= high and low <= nc <= high and (nr, nc) not in match_cells and (nr, nc) not in other:
