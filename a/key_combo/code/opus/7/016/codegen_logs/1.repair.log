+def _shape_patch(coords: list[tuple[int, int]] | np.ndarray) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0, r1, c1 = _bbox(arr)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
