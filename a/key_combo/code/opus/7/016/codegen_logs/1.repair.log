def _choose_non_identity_permutation(n: int) -> list[int]:
    if n == 2:
        return [1, 0]
    while True:
        perm = list(range(n))
        random.shuffle(perm)
        if any(perm[i] != i for i in range(n)):
            return perm


def _place_template(top: int, left: int, template: tuple[tuple[int, int], ...]) -> list[tuple[int, int]]:
    return [(top + r, left + c) for r, c in template]


def _template_anchor(template: tuple[tuple[int, int], ...], side: str) -> tuple[int, int]:
    if side == "right":
        edge = max(c for _, c in template)
        candidates = [(r, c) for r, c in template if c == edge]
        center = sum(r for r, _ in template) / len(template)
        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
        return candidates[0]
    if side == "left":
        edge = min(c for _, c in template)
        candidates = [(r, c) for r, c in template if c == edge]
        center = sum(r for r, _ in template) / len(template)
        candidates.sort(key=lambda cell: (abs(cell[0] - center), cell[0], cell[1]))
        return candidates[0]
    if side == "top":
        edge = min(r for r, _ in template)
        candidates = [(r, c) for r, c in template if r == edge]
        center = sum(c for _, c in template) / len(template)
        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
        return candidates[0]
    if side == "bottom":
        edge = max(r for r, _ in template)
        candidates = [(r, c) for r, c in template if r == edge]
        center = sum(c for _, c in template) / len(template)
        candidates.sort(key=lambda cell: (abs(cell[1] - center), cell[1], cell[0]))
        return candidates[0]
    raise ValueError("invalid side")


def _bbox_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], margin: int) -> bool:
    return not (
        a[2] + margin < b[0]
        or b[2] + margin < a[0]
        or a[3] + margin < b[1]
        or b[3] + margin < a[1]
    )


def _draw_axis_path(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
    coords: list[tuple[int, int]] = []
    for (r0, c0), (r1, c1) in zip(points, points[1:]):
        if r0 != r1 and c0 != c1:
            raise ValueError("path segments must be axis-aligned")
        dr = 0 if r0 == r1 else (1 if r1 > r0 else -1)
        dc = 0 if c0 == c1 else (1 if c1 > c0 else -1)
        steps = max(abs(r1 - r0), abs(c1 - c0))
        for i in range(steps + 1):
            cell = (r0 + dr * i, c0 + dc * i)
            if not coords or coords[-1] != cell:
                coords.append(cell)
    return coords


def _dilate_cells(shape: tuple[int, int], cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
    out = set(cells)
    for r, c in list(cells):
        for nr, nc in _neighbors8(r, c):
            if _in_bounds(shape, nr, nc):
                out.add((nr, nc))
    return out


def _find_path(
    shape: tuple[int, int],
    start: tuple[int, int],
    end: tuple[int, int],
    blocked: set[tuple[int, int]],
) -> list[tuple[int, int]] | None:
    blocked = set(blocked)
    blocked.discard(start)
    blocked.discard(end)
    pq = [(0, 0, start)]
    parents = {start: None}
    best = {start: 0}
    while pq:
        _score, cost, cell = heapq.heappop(pq)
        if cell == end:
            path = []
            cur = end
            while cur is not None:
                path.append(cur)
                cur = parents[cur]
            path.reverse()
            return path
        r, c = cell
        neighbors = []
        for nr, nc in _neighbors8(r, c):
            if not _in_bounds(shape, nr, nc) or (nr, nc) in blocked:
                continue
            neighbors.append((nr, nc))
        neighbors.sort(key=lambda pos: (abs(pos[0] - end[0]) + abs(pos[1] - end[1]), pos))
        for nxt in neighbors:
            new_cost = cost + 1
            if new_cost < best.get(nxt, 10**9):
                best[nxt] = new_cost
                parents[nxt] = cell
                heuristic = max(abs(nxt[0] - end[0]), abs(nxt[1] - end[1]))
                heapq.heappush(pq, (new_cost + heuristic, new_cost, nxt))
    return None


def _side_anchor(coords: list[tuple[int, int]], side: str) -> tuple[int, int]:
    if side == "right":
        edge = max(c for _, c in coords)
        candidates = [(r, c) for r, c in coords if c == edge]
    else:
        edge = min(c for _, c in coords)
        candidates = [(r, c) for r, c in coords if c == edge]
    center_row = sum(r for r, _ in coords) / len(coords)
    candidates.sort(key=lambda cell: (abs(cell[0] - center_row), cell[0], cell[1]))
    return candidates[0]


def _distance(a: tuple[float, float], b: tuple[float, float]) -> float:
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def _has_non_nearest_pairing(objects: list[dict], pairs: list[tuple[int, int]]) -> bool:
    tx_ids = [tx for tx, _ in pairs]
    for tx, rx in pairs:
        actual = _distance(objects[tx]["center"], objects[rx]["center"])
        best = min(_distance(objects[other]["center"], objects[rx]["center"]) for other in tx_ids)
        if actual > best:
            return True
    return False


def _validate_scene(inp: np.ndarray, expected_pairs: int) -> bool:
    try:
        objects, paths, pairs = _analyze(inp)
    except Exception:
        return False
    if len(paths) != expected_pairs or len(pairs) != expected_pairs:
        return False
    if len(objects) != expected_pairs * 2:
        return False
    colors = [obj["color"] for obj in objects]
    if len(set(colors)) != len(colors):
        return False
    if not _has_non_nearest_pairing(objects, pairs):
        return False
    return True


def _gen_attempt() -> np.ndarray | None:
    n_pairs = 2
