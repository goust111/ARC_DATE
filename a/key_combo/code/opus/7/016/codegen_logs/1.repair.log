-def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
-    return 0 <= int(r) < int(shape[0]) and 0 <= int(c) < int(shape[1])
-
-
-def _neighbors4(r: int, c: int):
-    yield r - 1, c
-    yield r + 1, c
-    yield r, c - 1
-    yield r, c + 1
-
-
-def _neighbors8(r: int, c: int):
-    for dr in (-1, 0, 1):
-        for dc in (-1, 0, 1):
-            if dr == 0 and dc == 0:
-                continue
-            yield r + dr, c + dc
-
-
-def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
-    rows = [r for r, _ in coords]
-    cols = [c for _, c in coords]
-    return min(rows), min(cols), max(rows), max(cols)
-
-
-def _crop_mask(coords: list[tuple[int, int]]) -> np.ndarray:
-    r0, c0, r1, c1 = _bbox(coords)
-    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
-    for r, c in coords:
-        patch[r - r0, c - c0] = True
-    return patch
-
-
-def _is_horizontally_symmetric(coords: list[tuple[int, int]]) -> bool:
-    patch = _crop_mask(coords)
-    return bool(np.array_equal(patch, np.flipud(patch)))
-
-
-def _find_components_for_colors(grid: np.ndarray, colors: set[int], connectivity: int) -> list[dict]:
-    h, w = grid.shape
-    seen = np.zeros((h, w), dtype=bool)
-    comps: list[dict] = []
-    nbrs = _neighbors4 if connectivity == 4 else _neighbors8
-    for r in range(h):
-        for c in range(w):
-            color = int(grid[r, c])
-            if color not in colors or seen[r, c]:
-                continue
-            q = deque([(r, c)])
-            seen[r, c] = True
-            coords: list[tuple[int, int]] = []
-            while q:
-                rr, cc = q.popleft()
-                coords.append((rr, cc))
-                for nr, nc in nbrs(rr, cc):
-                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
-                        seen[nr, nc] = True
-                        q.append((nr, nc))
-            comps.append(
-                {
-                    "color": color,
-                    "coords": coords,
-                    "bbox": _bbox(coords),
-                    "area": len(coords),
-                }
-            )
-    return comps
-
-
-def _object_components(grid: np.ndarray) -> list[dict]:
-    return _find_components_for_colors(grid, set(OBJECT_COLORS), connectivity=4)
-
-
-def _path_components(grid: np.ndarray) -> list[dict]:
-    return _find_components_for_colors(grid, {PATH}, connectivity=8)
 
 
-def _analyze(grid: np.ndarray) -> tuple[list[dict], list[dict], list[tuple[int, int]]]:
-    objects = _object_components(grid)
-    if not objects:
-        raise ValueError("no colored objects found")
-    for idx, comp in enumerate(objects):
-        comp["id"] = idx
-        comp["symmetric"] = _is_horizontally_symmetric(comp["coords"])
-        r0, c0, r1, c1 = comp["bbox"]
-        comp["center"] = ((r0 + r1) / 2.0, (c0 + c1) / 2.0)
-
-    obj_at = {}
-    for comp in objects:
-        for cell in comp["coords"]:
-            obj_at[cell] = comp["id"]
-
-    paths = _path_components(grid)
-    if not paths:
-        raise ValueError("no gray paths found")
-
-    pairs: list[tuple[int, int]] = []
-    used_objects: set[int] = set()
-    for path in paths:
-        touched: set[int] = set()
-        for r, c in path["coords"]:
-            for nr, nc in _neighbors8(r, c):
-                obj_id = obj_at.get((nr, nc))
-                if obj_id is not None:
-                    touched.add(obj_id)
-        if len(touched) != 2:
-            raise ValueError(f"path touches {len(touched)} objects instead of 2")
-        a, b = sorted(touched)
-        if objects[a]["symmetric"] == objects[b]["symmetric"]:
-            raise ValueError("path does not connect one symmetric and one asymmetric object")
-        tx = a if objects[a]["symmetric"] else b
-        rx = b if tx == a else a
-        if tx in used_objects or rx in used_objects:
-            raise ValueError("object participates in multiple paths")
-        used_objects.add(tx)
-        used_objects.add(rx)
-        pairs.append((tx, rx))
-
-    if len(used_objects) != len(objects):
-        raise ValueError("some objects are not paired")
-    return objects, paths, pairs
-
-
-def main(grid: np.ndarray) -> np.ndarray:
-    """
-    Route each symmetric sender's color along its gray path to the non-symmetric receiver, then wrap that receiver in its original color.
-
-    Input structure:
-    - The background is black.
-    - Several small single-color 4-connected objects use distinct non-gray colors.
-    - Gray 8-connected path components connect the objects into disjoint pairs.
-    - In each pair, exactly one object's shape is horizontally symmetric inside its own bounding box.
-
-    Rule:
-    - Detect horizontal symmetry within each object's own bounding box; the symmetric object is the sender and the other is the receiver.
-    - Follow each gray path component to identify which sender is paired with which receiver.
-    - Recolor every receiver pixel to the paired sender's color.
-    - Around each recolored receiver, paint the one-cell outer border of its expanded bounding box using the receiver's original color.
-    - Erase all gray path pixels and erase every sender object.
-
-    Key insight:
-    - Symmetry decides direction, but the gray path decides pairing, so the final receiver combines the sender's color inside with the receiver's own original color on the outside.
-    """
-    g = np.asarray(grid, dtype=int)
-    objects, paths, pairs = _analyze(g)
-
-    out = g.copy()
-    out[out == PATH] = BG
-
-    for tx, _ in pairs:
-        for r, c in objects[tx]["coords"]:
-            out[r, c] = BG
-
-    for tx, rx in pairs:
-        tx_color = int(objects[tx]["color"])
-        rx_color = int(objects[rx]["color"])
-        for r, c in objects[rx]["coords"]:
-            out[r, c] = tx_color
-        r0, c0, r1, c1 = objects[rx]["bbox"]
-        for r in range(r0 - 1, r1 + 2):
-            for c in range(c0 - 1, c1 + 2):
-                if not _in_bounds(out.shape, r, c):
-                    continue
-                if r0 <= r <= r1 and c0 <= c <= c1:
-                    continue
-                out[r, c] = rx_color
-
-    return out
-
-
 def _normalize_template(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
-    rows = [r for r, _ in coords]
-    cols = [c for _, c in coords]
