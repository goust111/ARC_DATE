            "path": [(bottom_left_row, 3), (h - 2, 3), (h - 2, w - 5), (top_right_row, w - 5), (top_right_row, w - 4)],
        },
    ]

    objects: list[dict] = []
    occupied_objects: set[tuple[int, int]] = set()
    for i, spec in enumerate(specs):
        left_is_tx = roles[i] == "left_tx"
        left_template = symmetric_shapes[i] if left_is_tx else asymmetric_shapes[i]
        right_template = asymmetric_shapes[i] if left_is_tx else symmetric_shapes[i]
        left_anchor = _template_anchor(left_template, "right")
        right_anchor = _template_anchor(right_template, "left")
        left_coords = _place_template(spec["left_anchor"][0] - left_anchor[0], spec["left_anchor"][1] - left_anchor[1], left_template)
        right_coords = _place_template(spec["right_anchor"][0] - right_anchor[0], spec["right_anchor"][1] - right_anchor[1], right_template)
        for coords in (left_coords, right_coords):
            if not all(_in_bounds((h, w), r, c) for r, c in coords):
                return None
        left_bbox = _bbox(left_coords)
        right_bbox = _bbox(right_coords)
        for prior in objects:
            if _bbox_overlap(left_bbox, prior["bbox"], margin=1) or _bbox_overlap(right_bbox, prior["bbox"], margin=1):
                return None
        if _bbox_overlap(left_bbox, right_bbox, margin=2):
            return None
        left_obj = {
            "coords": left_coords,
            "bbox": left_bbox,
            "color": colors[2 * i],
            "symmetric": left_is_tx,
            "pair_index": i,
            "side": "left",
        }
        right_obj = {
            "coords": right_coords,
            "bbox": right_bbox,
            "color": colors[2 * i + 1],
            "symmetric": not left_is_tx,
            "pair_index": i,
            "side": "right",
        }
        objects.extend([left_obj, right_obj])
        occupied_objects.update(left_coords)
        occupied_objects.update(right_coords)

    grid = np.zeros((h, w), dtype=int)
    for obj in objects:
        for r, c in obj["coords"]:
            grid[r, c] = obj["color"]

    path_cells_all: set[tuple[int, int]] = set()
    for spec in specs:
        path = _draw_axis_path(spec["path"])
        for cell in path:
            if cell in occupied_objects:
                return None
            for nr, nc in _neighbors8(*cell):
                if (nr, nc) in path_cells_all and (nr, nc) not in path:
                    return None
        path_cells_all.update(path)
        for r, c in path:
            grid[r, c] = PATH

    if not _validate_scene(grid, n_pairs):
        return None

    try:
        out = main(grid)
    except Exception:
        return None

    if np.array_equal(grid, out):
        return None
    if np.count_nonzero(out == PATH) != 0:
        return None
    if max(grid.shape) > 30 or max(out.shape) > 30:
        return None
    return grid


