+def _route_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    waypoints: list[tuple[int, int]],
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    stops = [start, *waypoints, end]
+    built: list[tuple[int, int]] = []
+    own_cells: set[tuple[int, int]] = set()
+    for a, b in zip(stops, stops[1:]):
