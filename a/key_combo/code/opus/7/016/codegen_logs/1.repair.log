-def main(grid: np.ndarray) -> np.ndarray:
-    """
-    Route each symmetric sender's color along its gray path to the non-symmetric receiver, then wrap that receiver in its original color.
-
-    Input structure:
-    - The background is black.
-    - Several small single-color 4-connected objects use distinct non-gray colors.
-    - Gray 8-connected path components connect the objects into disjoint pairs.
-    - In each pair, exactly one object's shape is horizontally symmetric inside its own bounding box.
-
-    Rule:
-    - Detect horizontal symmetry within each object's own bounding box; the symmetric object is the sender and the other is the receiver.
-    - Follow each gray path component to identify which sender is paired with which receiver.
-    - Recolor every receiver pixel to the paired sender's color.
-    - Around each recolored receiver, paint the one-cell outer border of its expanded bounding box using the receiver's original color.
-    - Erase all gray path pixels and erase every sender object.
-
-    Key insight:
-    - Symmetry decides direction, but the gray path decides pairing, so the final receiver combines the sender's color inside with the receiver's own original color on the outside.
-    """
-    g = np.asarray(grid, dtype=int)
-    objects, paths, pairs = _analyze(g)
-
-    out = g.copy()
-    out[out == PATH] = BG
-
-    for tx, _ in pairs:
-        for r, c in objects[tx]["coords"]:
-            out[r, c] = BG
-
-    for tx, rx in pairs:
-        tx_color = int(objects[tx]["color"])
-        rx_color = int(objects[rx]["color"])
-        for r, c in objects[rx]["coords"]:
-            out[r, c] = tx_color
-        r0, c0, r1, c1 = objects[rx]["bbox"]
-        for r in range(r0 - 1, r1 + 2):
-            for c in range(c0 - 1, c1 + 2):
-                if not _in_bounds(out.shape, r, c):
-                    continue
-                if r0 <= r <= r1 and c0 <= c <= c1:
-                    continue
-                out[r, c] = rx_color
-
-    return out
-
