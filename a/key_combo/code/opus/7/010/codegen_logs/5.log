   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """Reflect the multi-cell foreground mask across each singleton marker so the marker becomes one cell of its colored copy.
  10: 
  11:     Input structure
  12:     A background canvas contains one multi-pixel foreground object and one or more singleton marker colors. Each marker
  13:     shares exactly one row or exactly one column with a pixel of the source object.
  14: 
  15:     Rule
  16:     Keep the source object. For each marker, if it shares a row with exactly one source pixel, reflect the whole source
  17:     object horizontally through the vertical midline between that source pixel and the marker. If it shares a column
  18:     with exactly one source pixel, reflect the whole source object vertically through the horizontal midline between
  19:     them. Paint the reflected mask in the marker color.
  20: 
  21:     Key insight
  22:     The singleton marker is one already-reflected cell of the source object, so its aligned source pixel fixes the
  23:     mirror axis for the entire copy.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     bg = get_bg(g)
  27:     colors = colors_present(g, exclude={bg})
  28:     coords_by_color = {color: np.argwhere(g == color) for color in colors}
  29: 
  30:     source_colors = [color for color, coords in coords_by_color.items() if len(coords) > 1]
  31:     assert len(source_colors) == 1
  32:     source_color = source_colors[0]
  33:     source_coords = coords_by_color[source_color]
  34: 
  35:     marker_colors = [color for color in colors if color != source_color]
  36:     assert marker_colors
  37: 
  38:     out = g.copy()
  39:     height, width = g.shape
  40:     for marker_color in marker_colors:
  41:         marker_coords = coords_by_color[marker_color]
  42:         assert len(marker_coords) == 1
  43:         marker_r, marker_c = map(int, marker_coords[0])
  44: 
  45:         row_anchors = source_coords[source_coords[:, 0] == marker_r]
  46:         col_anchors = source_coords[source_coords[:, 1] == marker_c]
  47:         use_horizontal_reflection = len(row_anchors) == 1
  48:         use_vertical_reflection = len(col_anchors) == 1
  49:         assert use_horizontal_reflection != use_vertical_reflection
  50: 
  51:         targets = []
  52:         if use_horizontal_reflection:
  53:             anchor_c = int(row_anchors[0, 1])
  54:             col_sum = marker_c + anchor_c
  55:             for r, c in source_coords:
  56:                 targets.append((int(r), int(col_sum - c)))
  57:         else:
  58:             anchor_r = int(col_anchors[0, 0])
  59:             row_sum = marker_r + anchor_r
  60:             for r, c in source_coords:
  61:                 targets.append((int(row_sum - r), int(c)))
