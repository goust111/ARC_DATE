  30: def main(grid: np.ndarray) -> np.ndarray:
  31:     """
  32:     Recolor each black or blue connected component with the color of the marker that borders it most.
  33: 
  34:     Input structure
  35:     - The grid contains black regions, blue line components, and isolated non-black/non-blue marker pixels.
  36:     - Marker pixels are controls; the black and blue cells are the regions to recolor.
  37:     Rule
  38:     - Label black and blue cells separately using 4-connectivity.
  39:     - For each labeled component, count side-adjacencies to every marker pixel.
  40:     - Recolor the component with the marker color having the largest shared side boundary; equal counts use row-major marker order.
  41:     - Leave the marker pixels unchanged.
  42:     Key insight
  43:     - The color assignment is local to each original-color component and is decided by shared edge contact with nearby markers.
  44:     """
  45:     g = np.asarray(grid, dtype=int)
  46:     assert g.ndim == 2, "expected a 2D grid"
  47: 
  48:     colors = set(map(int, np.unique(g)))
  49:     assert Color.BLACK in colors and Color.BLUE in colors, "expected black and blue base colors"
  50: 
  51:     marker_coords = np.argwhere(~np.isin(g, list(BASE_COLORS)))
  52:     assert len(marker_coords) > 0, "expected colored marker pixels"
  53:     markers = {(int(r), int(c)): int(g[r, c]) for r, c in marker_coords}
  54: 
  55:     out = g.copy()
  56:     for base_color in (Color.BLACK, Color.BLUE):
  57:         labels, n_labels = label_mask(g == base_color, connectivity=4)
  58:         assert n_labels > 0, "expected each base color to appear"
  59:         for label_id in range(1, n_labels + 1):
  60:             component = np.argwhere(labels == label_id)
  61:             out[labels == label_id] = _best_marker_color(g, component, markers)
  62: 
  63:     return out
