  50:                 if 0 <= r < height and 0 <= c < width and int(g[r, c]) in marker_colors:
  51:                     adjacent_markers[(r, c)] = int(g[r, c])
  52:         assert adjacent_markers, "each chamber must touch at least one marker"
  53: 
  54:         marker_counts = Counter(adjacent_markers.values())
  55:         fill = _unique_most_common(marker_counts, list(marker_counts), "majority marker")
  56:         out[coords[:, 0], coords[:, 1]] = fill
