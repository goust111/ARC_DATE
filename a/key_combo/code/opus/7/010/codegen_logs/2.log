+def _paint_sequence(colors: list[int], order: tuple[tuple[int, int], ...]) -> np.ndarray:
+    out = np.full((3, 3), BACKGROUND, dtype=int)
+    for index, color in enumerate(colors[:9]):
+        r, c = order[index]
+        out[r, c] = int(color)
+    return out
+
