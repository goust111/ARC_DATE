+
+    visible_tile_cells = np.count_nonzero((out != BG) & (out != MARKER_COLOR))
+    if visible_tile_cells < max(3, marker_height):
+        return None
+    if len(set(np.unique(out)) - {BG}) < 2:
+        return None
+    return grid
