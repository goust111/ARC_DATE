+    for index, ((chamber_id, candidates, _area), winner) in enumerate(zip(chosen, target_winners)):
+        cells = random.sample(candidates, min(len(candidates), 6))
+        cells.sort()
+        other_colors = [color for color in MARKER_COLORS if color != winner]
+        do_tie = want_tie and not tie_used and len(cells) >= 2 and index > 0
+        if do_tie:
+            loser = random.choice(other_colors)
+            out[cells[0]] = winner
+            out[cells[1]] = loser
+            tie_used = True
+            continue
