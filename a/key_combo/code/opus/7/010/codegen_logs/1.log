+
+def _assign_markers(grid: np.ndarray) -> np.ndarray:
+    traced = _trace_ray(grid)
+    labels, comps = _label_black_components(traced)
+    chamber_candidates = []
+    for chamber_id, coords in enumerate(comps, start=1):
+        candidates = _candidate_marker_cells(labels, chamber_id)
+        if len(candidates) >= 2:
+            chamber_candidates.append((chamber_id, candidates, len(coords)))
+    assert len(chamber_candidates) >= 2
+
+    chamber_candidates.sort(key=lambda item: item[2], reverse=True)
+    use_count = random.randint(2, min(4, len(chamber_candidates)))
+    chosen = chamber_candidates[:use_count]
+    random.shuffle(chosen)
+
+    preferred = random.sample(list(MARKER_COLORS), 3)
+    target_winners = [preferred[0], preferred[1]]
+    while len(target_winners) < use_count:
+        target_winners.append(random.choice(MARKER_COLORS))
+    if len(target_winners) > 2:
+        tail = target_winners[2:]
+        random.shuffle(tail)
+        target_winners[2:] = tail
+
+    out = grid.copy()
+    tie_used = False
+    want_tie = random.random() < 0.4 and any(len(cands) >= 2 for _cid, cands, _area in chosen)
