+    work[wall_mask] = GREY
+    labels, comps = _label_black_components(work)
+    markers = _markers_by_chamber(traced, labels)
+    for chamber_id, coords in enumerate(comps, start=1):
+        fill = _choose_fill_color(markers.get(chamber_id, []))
+        if fill is not None:
