+        return None
+    counts = Counter(color for color, _pos in entries)
+    best_count = max(counts.values())
+    candidates = [color for color, cnt in counts.items() if cnt == best_count]
+    if len(candidates) == 1:
+        return int(candidates[0])
+    best_pos = {}
+    for color in candidates:
