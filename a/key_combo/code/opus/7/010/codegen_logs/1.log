+        incoming_dr = -incoming_dr
+
+    for wr, wc in wall_points:
+        if wr == rt:
+            for rr in range(0, wr):
+                grid[rr, wc] = GREY
+        else:
+            for rr in range(wr + 1, h):
+                grid[rr, wc] = GREY
+
+    return grid, np.array(path, dtype=int)
