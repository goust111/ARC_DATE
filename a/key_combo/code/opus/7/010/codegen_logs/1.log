+        pts = {(int(r), int(c)) for r, c in coords}
+        if len({r - c for r, c in pts}) == 1:
+            first = min(pts)
+            last = max(pts)
+            endpoints = ((first, (-1, -1)), (last, (1, 1)))
+        else:
+            top = min(pts)
+            bottom = max(pts)
+            endpoints = ((top, (-1, 1)), (bottom, (1, -1)))
