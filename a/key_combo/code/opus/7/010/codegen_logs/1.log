+
+def _mirror_orientations(grid: np.ndarray) -> tuple[dict[tuple[int, int], str], list[np.ndarray]]:
+    mirrors: dict[tuple[int, int], str] = {}
+    comps = _components_mask(grid == RED, connectivity=4)
