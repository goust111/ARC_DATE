+def _fill_from_traced(traced: np.ndarray, *, wall_mask: np.ndarray | None = None) -> np.ndarray:
+    out = traced.copy()
+    if wall_mask is None:
+        wall_mask = (traced == BLUE) | (traced == GREY)
