+        points.append((cur_r, cur_c))
+        cur_dr = -cur_dr
+
+    max_tail = cur_r if cur_dr == -1 else (h - 1 - cur_r)
+    assert max_tail >= 2
+    tail_len = random.randint(2, min(6, max_tail))
+    w = cur_c + tail_len + 1
