+        else:
+            assert len(cols) == 1, "mirror must be horizontal or vertical"
+            assert rows == list(range(rows[0], rows[-1] + 1)), "vertical mirror must be contiguous"
+            orientation = "vertical"
+        for r, c in coords:
+            mirrors[(int(r), int(c))] = orientation
+    return mirrors, comps
