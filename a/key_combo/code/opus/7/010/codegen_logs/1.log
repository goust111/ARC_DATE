+def _trace_ray(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    _seed_coords, (r, c, dr, dc) = _find_seed(out)
+    mirrors, _mirror_comps = _mirror_orientations(out)
