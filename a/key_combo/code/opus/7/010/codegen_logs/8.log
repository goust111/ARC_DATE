+    r0, c0 = map(int, top)
+    for dr, dc in shape:
+        grid[r0 + dr, c0 + dc] = int(color)
+
+
+def _legend_layout(
+    rng: random.Random,
+    shapes: list[tuple[tuple[int, int], ...]],
+) -> tuple[int, int, list[tuple[int, int]]]:
+    shape_dims = [_shape_dims(shape) for shape in shapes]
