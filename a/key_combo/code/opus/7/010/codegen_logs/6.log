+import numpy as np
+
+
+BACKGROUND = 0
+SOURCE_COLOR = 1
+MARKER_COLORS = (2, 3, 4)
+
+GRID_HEIGHT_RANGE = (12, 16)
+GRID_WIDTH_RANGE = (14, 20)
+SOURCE_BBOX_HEIGHTS = (3, 4)
+SOURCE_BBOX_WIDTHS = (3, 4, 5)
+SOURCE_PIXEL_COUNTS = (5, 6, 7, 8)
+MARKER_COUNTS = (2, 3)
+MARKER_DISTANCES = (4, 5, 6, 7, 8)
+GENERATION_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 240
