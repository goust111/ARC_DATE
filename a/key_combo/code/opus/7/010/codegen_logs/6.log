+        density = float(mask.mean())
+        if not (0.35 <= density <= 0.75):
+            continue
+        row_counts = mask.sum(axis=1)
+        col_counts = mask.sum(axis=0)
+        if not np.any(row_counts == 1):
+            continue
+        if not np.any(col_counts == 1):
+            continue
+        return mask
