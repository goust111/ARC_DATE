+        col_matches = [(r, c) for r, c in source_coords if c == mc and r != mr]
+        assert (len(row_matches) == 1) != (len(col_matches) == 1)
+        assert (mr not in source_rows) or (len(row_matches) == 1)
+        assert (mc not in source_cols) or (len(col_matches) == 1)
