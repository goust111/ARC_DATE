+    mr, mc = marker
+    if ar == mr and ac != mc:
+        return [(r, ac + mc - c) for r, c in source_coords]
+    if ac == mc and ar != mr:
+        return [(ar + mr - r, c) for r, c in source_coords]
+    raise AssertionError("marker must align with anchor in exactly one axis")
+
