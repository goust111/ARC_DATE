+        anchor = row_matches[0] if len(row_matches) == 1 else col_matches[0]
+        reflected = _reflect_coords(source_coords, anchor, marker)
+        copy_grid = _crop_coords(reflected, color, bg=bg)
+        copies_with_order.append((mc, copy_grid))
