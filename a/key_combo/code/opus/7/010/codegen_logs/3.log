+        "frame_bbox": (
+            frame_top + frame_meta["frame_bbox"][0],
+            frame_left + frame_meta["frame_bbox"][1],
+            frame_top + frame_meta["frame_bbox"][2],
+            frame_left + frame_meta["frame_bbox"][3],
