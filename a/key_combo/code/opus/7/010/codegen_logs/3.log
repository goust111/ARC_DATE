+        rect_coords = tuple(
+            (r, c)
+            for r in range(abs_bbox[0], abs_bbox[2] + 1)
+            for c in range(abs_bbox[1], abs_bbox[3] + 1)
+        )
+        pairs.append(
+            {
+                "matches": matches,
+                "rect_bbox": abs_bbox,
+                "rect_coords": rect_coords,
+                "sprite_coords": _translate_coords(local_meta["sprite_coords"], top, left),
