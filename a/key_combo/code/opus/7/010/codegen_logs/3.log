+
+def _normalize_coords(coords) -> tuple[tuple[int, int], ...]:
+    arr = np.asarray(coords, dtype=int)
+    arr = arr.copy()
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    return tuple(sorted((int(r), int(c)) for r, c in arr))
+
