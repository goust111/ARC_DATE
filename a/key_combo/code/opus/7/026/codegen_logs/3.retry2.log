+def _candidate() -> np.ndarray | None:
+    h = random.randint(*GRID_H_RANGE)
+    w = random.randint(*GRID_W_RANGE)
+    cross_r = random.randint(QUADRANT_MIN_SIZE, h - QUADRANT_MIN_SIZE - 1)
