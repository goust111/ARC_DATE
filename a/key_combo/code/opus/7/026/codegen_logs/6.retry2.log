+    _ARC_UTILS = SourceFileLoader(
+        "_arc_utils_shared",
+        "/home/lixinyu/snap/new/solvers/arc_utils.py",
+    ).load_module()
+    bbox = _ARC_UTILS.bbox
+    get_bg = _ARC_UTILS.get_bg
+    in_bounds = _ARC_UTILS.in_bounds
+
+
+BG = 0
+SCAFFOLD = 5
+CONTENT_COLORS = (1, 2, 3, 4, 7)
+CELL_COUNTS = (3, 4)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+FIXED_DIRECTION_COLORS = {
+    (-1, -1): 1,
+    (-1, 1): 2,
+    (1, -1): 3,
+    (1, 1): 4,
+}
+
+CANVAS_MIN = 11
+CANVAS_MAX = 15
+ACTIVE_COUNT_RANGE = (4, 8)
+GEN_ATTEMPTS = 800
+
+
+def _bbox_or_raise(mask: np.ndarray) -> tuple[int, int, int, int]:
+    b = bbox(mask)
+    assert b is not None, "expected a scaffold bbox"
+    return tuple(map(int, b))
+
+
+def _parse_grid(grid: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= 30, "ARC grids must be at most 30x30"
+    assert int(get_bg(g)) == BG, "background must be black"
+
+    allowed = set(CONTENT_COLORS) | {BG, SCAFFOLD}
+    assert set(map(int, np.unique(g))).issubset(allowed), "unexpected colors present"
+
+    r0, c0, r1, c1 = _bbox_or_raise(g == SCAFFOLD)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    assert height % 2 == 1 and width % 2 == 1, "scaffold bbox must have odd size"
+
+    cell_rows = (height - 1) // 2
+    cell_cols = (width - 1) // 2
+    assert cell_rows == cell_cols and cell_rows in CELL_COUNTS, "expected a 3x3 or 4x4 lattice"
+
+    outside = g.copy()
+    outside[r0 : r1 + 1, c0 : c1 + 1] = BG
+    assert np.all(outside == BG), "only the scaffold lattice may be non-background"
+
+    window = g[r0 : r1 + 1, c0 : c1 + 1]
+    contents = np.zeros((cell_rows, cell_cols), dtype=int)
+    for rr in range(height):
+        for cc in range(width):
+            value = int(window[rr, cc])
+            if rr % 2 == 1 and cc % 2 == 1:
+                assert value in set(CONTENT_COLORS) | {BG}, "cell centers must hold content colors or black"
+                contents[(rr - 1) // 2, (cc - 1) // 2] = value
+            else:
+                assert value == SCAFFOLD, "shared frame lines must stay grey in the input"
+
+    return (r0, c0, r1, c1), contents
+
+
+def _marker_map_from_contents(contents: np.ndarray) -> tuple[dict[tuple[int, int], int], list[tuple[int, int, int, int, int, int]]]:
+    planned: dict[tuple[int, int], int] = {}
+    events: list[tuple[int, int, int, int, int, int]] = []
+    rows, cols = map(int, contents.shape)
+
+    for r, c in np.argwhere(contents != BG):
+        r = int(r)
+        c = int(c)
+        self_color = int(contents[r, c])
+        for dr, dc in DIAGONALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols and int(contents[nr, nc]) != BG:
+                color = int(contents[nr, nc])
+                corner = (1 + 2 * r + dr, 1 + 2 * c + dc)
+                previous = planned.get(corner)
+                assert previous is None or previous == color, "corner color must be uniquely determined"
+                planned[corner] = color
+                events.append((r, c, dr, dc, self_color, color))
