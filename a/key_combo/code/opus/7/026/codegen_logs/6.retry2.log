+    return planned, events
+
+
+def _paint_markers(
+    base: np.ndarray,
+    bbox_local: tuple[int, int, int, int],
+    markers: dict[tuple[int, int], int],
+) -> np.ndarray:
+    out = np.asarray(base, dtype=int).copy()
+    r0, c0, _r1, _c1 = bbox_local
+    for (rr, cc), color in markers.items():
+        ar = r0 + rr
+        ac = c0 + cc
+        assert in_bounds(out.shape, ar, ac)
+        assert int(out[ar, ac]) in (SCAFFOLD, color), "markers only overwrite shared grey corners"
+        out[ar, ac] = int(color)
+    return out
+
+
+def _output_from_grid(grid: np.ndarray) -> np.ndarray:
+    bbox_local, contents = _parse_grid(grid)
+    markers, _events = _marker_map_from_contents(contents)
+    return _paint_markers(grid, bbox_local, markers)
