+    contents = np.zeros((cell_count, cell_count), dtype=int)
+    for i in range(cell_count):
+        for j in range(cell_count):
+            top = row_bounds[i] + 1
+            left = col_bounds[j] + 1
+            patch = g[top : top + 3, left : left + 3]
