      888
      8.8   (dot = bg hole at center)
      888
  markers:
    count: 1-2 distinct marker colors per grid, each != scaffold and != bg
    pixels_per_color: 2-4 pixels, placed on bg pixels (boundary intersections, boundary edges, or cell center holes)
