+++ b/026/6.py
@@ -0,0 +1,389 @@
+from __future__ import annotations
+
+import random
+from importlib.machinery import SourceFileLoader
+from pathlib import Path
+
+import numpy as np
+
+try:
+    from arc_utils import bbox, get_bg, in_bounds
+except ModuleNotFoundError:
+    _ARC_UTILS = SourceFileLoader(
+        "_arc_utils_shared",
+        "/home/lixinyu/snap/new/solvers/arc_utils.py",
+    ).load_module()
+    bbox = _ARC_UTILS.bbox
+    get_bg = _ARC_UTILS.get_bg
+    in_bounds = _ARC_UTILS.in_bounds
+
+
+BG = 0
+SCAFFOLD = 5
+CONTENT_COLORS = (1, 2, 3, 4, 7)
+CELL_COUNTS = (3, 4)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+FIXED_DIRECTION_COLORS = {
+    (-1, -1): 1,
+    (-1, 1): 2,
+    (1, -1): 3,
+    (1, 1): 4,
+}
+
+CANVAS_MIN = 11
+CANVAS_MAX = 15
+ACTIVE_COUNT_RANGE = (4, 8)
+GEN_ATTEMPTS = 800
+
+
+def _bbox_or_raise(mask: np.ndarray) -> tuple[int, int, int, int]:
+    b = bbox(mask)
+    assert b is not None, "expected a scaffold bbox"
+    return tuple(map(int, b))
+
+
+def _parse_grid(grid: np.ndarray) -> tuple[tuple[int, int, int, int], np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= 30, "ARC grids must be at most 30x30"
+    assert int(get_bg(g)) == BG, "background must be black"
+
+    allowed = set(CONTENT_COLORS) | {BG, SCAFFOLD}
+    assert set(map(int, np.unique(g))).issubset(allowed), "unexpected colors present"
+
+    r0, c0, r1, c1 = _bbox_or_raise(g == SCAFFOLD)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    assert height % 2 == 1 and width % 2 == 1, "scaffold bbox must have odd size"
+
+    cell_rows = (height - 1) // 2
+    cell_cols = (width - 1) // 2
+    assert cell_rows == cell_cols and cell_rows in CELL_COUNTS, "expected a 3x3 or 4x4 lattice"
+
+    outside = g.copy()
+    outside[r0 : r1 + 1, c0 : c1 + 1] = BG
+    assert np.all(outside == BG), "only the scaffold lattice may be non-background"
+
+    window = g[r0 : r1 + 1, c0 : c1 + 1]
+    contents = np.zeros((cell_rows, cell_cols), dtype=int)
+    for rr in range(height):
+        for cc in range(width):
+            value = int(window[rr, cc])
+            if rr % 2 == 1 and cc % 2 == 1:
+                assert value in set(CONTENT_COLORS) | {BG}, "cell centers must hold content colors or black"
+                contents[(rr - 1) // 2, (cc - 1) // 2] = value
+            else:
+                assert value == SCAFFOLD, "shared frame lines must stay grey in the input"
+
+    return (r0, c0, r1, c1), contents
+
+
+def _marker_map_from_contents(contents: np.ndarray) -> tuple[dict[tuple[int, int], int], list[tuple[int, int, int, int, int, int]]]:
+    planned: dict[tuple[int, int], int] = {}
+    events: list[tuple[int, int, int, int, int, int]] = []
+    rows, cols = map(int, contents.shape)
+
+    for r, c in np.argwhere(contents != BG):
+        r = int(r)
+        c = int(c)
+        self_color = int(contents[r, c])
+        for dr, dc in DIAGONALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols and int(contents[nr, nc]) != BG:
+                color = int(contents[nr, nc])
+                corner = (1 + 2 * r + dr, 1 + 2 * c + dc)
+                previous = planned.get(corner)
+                assert previous is None or previous == color, "corner color must be uniquely determined"
+                planned[corner] = color
+                events.append((r, c, dr, dc, self_color, color))
+
+    return planned, events
+
+
+def _paint_markers(
+    base: np.ndarray,
+    bbox_local: tuple[int, int, int, int],
+    markers: dict[tuple[int, int], int],
+) -> np.ndarray:
+    out = np.asarray(base, dtype=int).copy()
+    r0, c0, _r1, _c1 = bbox_local
+    for (rr, cc), color in markers.items():
+        ar = r0 + rr
+        ac = c0 + cc
+        assert in_bounds(out.shape, ar, ac)
+        assert int(out[ar, ac]) in (SCAFFOLD, color), "markers only overwrite shared grey corners"
+        out[ar, ac] = int(color)
+    return out
+
+
+def _output_from_grid(grid: np.ndarray) -> np.ndarray:
+    bbox_local, contents = _parse_grid(grid)
+    markers, _events = _marker_map_from_contents(contents)
+    return _paint_markers(grid, bbox_local, markers)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Decorate each active scaffold cell corner with the content color of its diagonal active neighbor.
+
+    Input structure:
+    - The grid has a black background and one grey scaffold lattice made from
+      shared-edge 3x3 hollow frames.
+    - Each lattice cell has a one-pixel center that is either black or one
+      active content color.
+    - The lattice forms a 3x3 or 4x4 square array of cells.
+
+    Rule:
+    - Preserve the scaffold and every center content pixel.
+    - For each active cell, inspect its four diagonal neighboring cells in the
+      lattice topology.
+    - If a diagonal neighbor exists and is also active, paint the shared corner
+      pixel of the current cell in that corner direction with the diagonal
+      neighbor's content color; otherwise leave that corner unchanged.
+
+    Key insight:
+    - The grey scaffold is not just decoration: it defines the cell grid and the
+      exact corner pixels where diagonal cell-to-cell color exchange is written.
+    """
+    return _output_from_grid(np.asarray(grid, dtype=int))
+
+
+def _has_full_active_2x2(active: np.ndarray) -> bool:
+    rows, cols = active.shape
+    for r in range(rows - 1):
+        for c in range(cols - 1):
+            if bool(np.all(active[r : r + 2, c : c + 2])):
+                return True
+    return False
+
+
+def _features(contents: np.ndarray) -> dict[str, object]:
+    active = contents != BG
+    rows, cols = map(int, contents.shape)
+    if _has_full_active_2x2(active):
+        return {
+            "active_count": int(np.count_nonzero(active)),
+            "distinct_active_colors": len(set(map(int, contents[active]))),
+            "marker_count": -1,
+            "diag_pair_count": -1,
+            "orth_pairs": -1,
+            "degrees": {},
+            "edge_active": 0,
+            "has_empty_in_bounds_diagonal": False,
+            "has_neighbor_with_different_color": False,
+            "direction_color_variation": False,
+        }
+    markers, events = _marker_map_from_contents(contents)
+    diag_pairs: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    orth_pairs = 0
+    degrees: dict[tuple[int, int], int] = {}
+    direction_colors = {direction: set() for direction in DIAGONALS}
+    edge_active = 0
+    has_empty_in_bounds_diagonal = False
+    has_neighbor_with_different_color = False
+
+    for r, c in np.argwhere(active):
+        r = int(r)
+        c = int(c)
+        if r in (0, rows - 1) or c in (0, cols - 1):
+            edge_active += 1
+        deg = 0
+        for dr, dc in DIAGONALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols:
+                if int(contents[nr, nc]) != BG:
+                    deg += 1
+                    diag_pairs.add(tuple(sorted(((r, c), (nr, nc)))))
+                    direction_colors[(dr, dc)].add(int(contents[nr, nc]))
+                    if int(contents[nr, nc]) != int(contents[r, c]):
+                        has_neighbor_with_different_color = True
+                else:
+                    has_empty_in_bounds_diagonal = True
+        degrees[(r, c)] = deg
+        if r + 1 < rows and bool(active[r + 1, c]):
+            orth_pairs += 1
+        if c + 1 < cols and bool(active[r, c + 1]):
+            orth_pairs += 1
+
+    return {
+        "active_count": int(np.count_nonzero(active)),
+        "distinct_active_colors": len(set(map(int, contents[active]))),
+        "marker_count": len(markers),
+        "diag_pair_count": len(diag_pairs),
+        "orth_pairs": orth_pairs,
+        "degrees": degrees,
+        "edge_active": edge_active,
+        "has_empty_in_bounds_diagonal": has_empty_in_bounds_diagonal,
+        "has_neighbor_with_different_color": has_neighbor_with_different_color,
+        "direction_color_variation": any(len(colors) >= 2 for colors in direction_colors.values()),
+    }
+
+
+def _marker_map_fixed_direction(contents: np.ndarray) -> dict[tuple[int, int], int]:
+    planned: dict[tuple[int, int], int] = {}
+    rows, cols = map(int, contents.shape)
+    for r, c in np.argwhere(contents != BG):
+        r = int(r)
+        c = int(c)
+        for dr, dc in DIAGONALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols and int(contents[nr, nc]) != BG:
+                planned[(1 + 2 * r + dr, 1 + 2 * c + dc)] = FIXED_DIRECTION_COLORS[(dr, dc)]
+    return planned
+
+
+def _marker_map_self_color(contents: np.ndarray) -> dict[tuple[int, int], int]:
+    planned: dict[tuple[int, int], int] = {}
+    rows, cols = map(int, contents.shape)
+    for r, c in np.argwhere(contents != BG):
+        r = int(r)
+        c = int(c)
+        self_color = int(contents[r, c])
+        for dr, dc in DIAGONALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols and int(contents[nr, nc]) != BG:
+                planned[(1 + 2 * r + dr, 1 + 2 * c + dc)] = self_color
+    return planned
+
+
+def _marker_map_all_in_bounds_self(contents: np.ndarray) -> dict[tuple[int, int], int]:
+    planned: dict[tuple[int, int], int] = {}
+    rows, cols = map(int, contents.shape)
+    for r, c in np.argwhere(contents != BG):
+        r = int(r)
+        c = int(c)
+        self_color = int(contents[r, c])
+        for dr, dc in DIAGONALS:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < rows and 0 <= nc < cols:
+                planned[(1 + 2 * r + dr, 1 + 2 * c + dc)] = self_color
+    return planned
+
+
+def _sample_canvas_size(cell_count: int, active_count: int) -> tuple[int, int]:
+    lattice_side = 2 * cell_count + 1
+    grey_count = lattice_side * lattice_side - cell_count * cell_count
+    min_area = 2 * grey_count + active_count + 1
+    choices = [
+        (height, width)
+        for height in range(max(CANVAS_MIN, lattice_side + 2), CANVAS_MAX + 1)
+        for width in range(max(CANVAS_MIN, lattice_side + 2), CANVAS_MAX + 1)
+        if height * width >= min_area
+    ]
+    assert choices, "expected at least one canvas size with black as the dominant color"
+    return random.choice(choices)
+
+
+def _render_input(contents: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    cell_count = int(contents.shape[0])
+    lattice_side = 2 * cell_count + 1
+    height, width = _sample_canvas_size(cell_count, int(np.count_nonzero(contents)))
+    top = random.randint(1, height - lattice_side - 1)
+    left = random.randint(1, width - lattice_side - 1)
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[top : top + lattice_side, left : left + lattice_side] = SCAFFOLD
+    for r in range(cell_count):
+        for c in range(cell_count):
+            grid[top + 1 + 2 * r, left + 1 + 2 * c] = int(contents[r, c])
+    return grid, (top, left, top + lattice_side - 1, left + lattice_side - 1)
+
+
+def _base_layout_ok(mode: int, feats: dict[str, object]) -> bool:
+    degrees = list(feats["degrees"].values())
+    if not (ACTIVE_COUNT_RANGE[0] <= int(feats["active_count"]) <= ACTIVE_COUNT_RANGE[1]):
+        return False
+    if int(feats["diag_pair_count"]) < 1:
+        return False
+    if int(feats["marker_count"]) < 2:
+        return False
+    if int(feats["distinct_active_colors"]) < 2:
+        return False
+    if not bool(feats["has_neighbor_with_different_color"]):
+        return False
+    if mode == 0:
+        return 0 in degrees and any(deg > 0 for deg in degrees) and bool(feats["has_empty_in_bounds_diagonal"])
+    if mode == 1:
+        return max(degrees) >= 2 and int(feats["edge_active"]) >= 1
+    if mode == 2:
+        return int(feats["orth_pairs"]) >= 1 and bool(feats["has_empty_in_bounds_diagonal"])
+    return bool(feats["direction_color_variation"]) and int(feats["edge_active"]) >= 1
+
+
+def _semantics_ok(contents: np.ndarray) -> bool:
+    active = contents != BG
+    if _has_full_active_2x2(active):
+        return False
+
+    correct, _events = _marker_map_from_contents(contents)
+    if not correct:
+        return False
+    if correct == _marker_map_fixed_direction(contents):
+        return False
+    if correct == _marker_map_self_color(contents):
+        return False
+    if correct == _marker_map_all_in_bounds_self(contents):
+        return False
+    return True
+
+
+def _sample_contents(mode: int) -> np.ndarray | None:
+    cell_count = 4 if mode in (1, 3) and random.random() < 0.7 else random.choice(CELL_COUNTS)
+    all_cells = [(r, c) for r in range(cell_count) for c in range(cell_count)]
+    active_count = random.randint(ACTIVE_COUNT_RANGE[0], min(ACTIVE_COUNT_RANGE[1], cell_count * cell_count))
+    active_cells = random.sample(all_cells, active_count)
+
+    contents = np.zeros((cell_count, cell_count), dtype=int)
+    palette_size = random.randint(2, min(len(CONTENT_COLORS), active_count))
+    palette = random.sample(list(CONTENT_COLORS), palette_size)
+    colors = palette[:] + [random.choice(palette) for _ in range(active_count - palette_size)]
+    random.shuffle(colors)
+    for (r, c), color in zip(active_cells, colors):
+        contents[r, c] = int(color)
+
+    feats = _features(contents)
+    if not _base_layout_ok(mode, feats):
+        return None
+    if not _semantics_ok(contents):
+        return None
+    return contents
+
+
+def _validate_generated(grid: np.ndarray, contents: np.ndarray, bbox_local: tuple[int, int, int, int]) -> bool:
+    try:
+        parsed_bbox, parsed_contents = _parse_grid(grid)
+        if parsed_bbox != bbox_local or not np.array_equal(parsed_contents, contents):
+            return False
+
+        expected = _output_from_grid(grid)
+        actual = main(grid)
+        if not np.array_equal(actual, expected):
+            return False
+        if np.array_equal(actual, grid):
+            return False
+
+        correct_markers, _events = _marker_map_from_contents(contents)
+        wrong_marker_sets = [
+            _marker_map_fixed_direction(contents),
+            _marker_map_self_color(contents),
+            _marker_map_all_in_bounds_self(contents),
+        ]
+        for wrong_markers in wrong_marker_sets:
+            wrong = _paint_markers(grid, bbox_local, wrong_markers)
+            if np.array_equal(wrong, actual):
+                return False
+
+        return True
+    except AssertionError:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        mode = random.randrange(4)
+        contents = _sample_contents(mode)
+        if contents is None:
+            continue
+        grid, bbox_local = _render_input(contents)
+        if _validate_generated(grid, contents, bbox_local):
+            return grid
+    raise RuntimeError("failed to generate a valid scaffold-diagonal-decoration input")

