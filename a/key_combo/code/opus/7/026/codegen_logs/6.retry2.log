+    cell_cols = (width - 1) // 2
+    assert cell_rows == cell_cols and cell_rows in CELL_COUNTS, "expected a 3x3 or 4x4 lattice"
+
+    outside = g.copy()
+    outside[r0 : r1 + 1, c0 : c1 + 1] = BG
+    assert np.all(outside == BG), "only the scaffold lattice may be non-background"
+
+    window = g[r0 : r1 + 1, c0 : c1 + 1]
+    contents = np.zeros((cell_rows, cell_cols), dtype=int)
+    for rr in range(height):
+        for cc in range(width):
+            value = int(window[rr, cc])
+            if rr % 2 == 1 and cc % 2 == 1:
+                assert value in set(CONTENT_COLORS) | {BG}, "cell centers must hold content colors or black"
+                contents[(rr - 1) // 2, (cc - 1) // 2] = value
+            else:
