+def _sample_canvas_size(cell_count: int, active_count: int) -> tuple[int, int]:
+    lattice_side = 2 * cell_count + 1
+    grey_count = lattice_side * lattice_side - cell_count * cell_count
+    min_area = 2 * grey_count + active_count + 1
+    choices = [
+        (height, width)
+        for height in range(max(CANVAS_MIN, lattice_side + 2), CANVAS_MAX + 1)
+        for width in range(max(CANVAS_MIN, lattice_side + 2), CANVAS_MAX + 1)
