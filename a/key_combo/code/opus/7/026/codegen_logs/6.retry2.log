+def _corner_local(cell_r: int, cell_c: int, dr: int, dc: int) -> tuple[int, int]:
+    top = 4 * cell_r + 1
+    left = 4 * cell_c + 1
+    return top + (0 if dr == -1 else 2), left + (0 if dc == -1 else 2)
