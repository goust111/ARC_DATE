+
+        return True
+    except AssertionError:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        mode = random.randrange(4)
+        contents = _sample_contents(mode)
+        if contents is None:
