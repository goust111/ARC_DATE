+    out = g.copy()
+    ranked = sorted(bars, key=lambda bar: bar["length"], reverse=True)
+    for rank, bar in enumerate(ranked, start=1):
+        coords = bar["coords"]
+        out[coords[:, 0], coords[:, 1]] = RANK_COLORS[rank]
