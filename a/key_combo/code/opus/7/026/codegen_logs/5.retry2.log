+
+def _gap_rect(a: dict, b: dict) -> tuple[int, int, int, int] | None:
+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    row0 = max(ar0, br0)
+    row1 = min(ar1, br1)
+    if row0 > row1:
+        return None
+    if ac1 < bc0:
+        col0 = ac1 + 1
+        col1 = bc0 - 1
+    elif bc1 < ac0:
