+        r0, c0, r1, c1 = _bbox_from_coords(comp)
+        if r1 - r0 + 1 < 3 or c1 - c0 + 1 < 3:
+            continue
+        border = set(_border_cells((r0, c0, r1, c1)))
+        if set(comp) != border:
