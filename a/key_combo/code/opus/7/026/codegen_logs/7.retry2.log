+    r0, c0, r1, c1 = comp["bbox"]
+    assert comp["area"] == 3
+    assert r1 - r0 == 1 and c1 - c0 == 1
+    rel = {(r - r0, c - c0) for r, c in comp["coords"]}
+    missing = L_CORNERS - rel
+    assert len(missing) == 1
