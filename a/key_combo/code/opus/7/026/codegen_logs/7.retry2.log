+            return False
+        if (r, c) in occupied:
+            return False
+    copy_comp = _copy_component(comp)
+    for r, c in copy_comp["coords"]:
+        if not (0 <= r < H and 0 <= c < W):
+            return False
+        if (r, c) in occupied:
+            return False
+    for other in placed:
+        if not _gap_ok(comp["bbox"], other["bbox"]):
+            return False
+    return True
+
+
+def _build_input(comps: list[dict], H: int, W: int) -> np.ndarray:
