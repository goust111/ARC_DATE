+                "path_color": int(copy_comp["color"]),
+                "bbox": comp["bbox"],
+                "copy_bbox": copy_comp["bbox"],
+                "p": p,
+                "q": q,
+                "attempted": attempted,
+                "drawn": drawn,
+                "blocked_at": blocked_at,
+                "blocked_by": blocked_by,
+                "completed": blocked_at is None,
