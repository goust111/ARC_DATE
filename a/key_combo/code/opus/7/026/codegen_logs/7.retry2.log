+    if pc != qc:
+        step = 1 if qc > pc else -1
+        for c in range(pc + step, qc + step, step):
+            cells.append((pr, c))
+    if pr != qr:
+        step = 1 if qr > pr else -1
+        for r in range(pr + step, qr + step, step):
+            cells.append((r, qc))
+    return cells
+
