+
+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(coords)
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
