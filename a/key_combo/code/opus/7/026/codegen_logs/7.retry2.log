+    for missing in sorted(L_CORNERS):
+        shift_r, shift_c = _copy_shift(color, missing)
+        for rr in (0, 1):
+            for cc in (0, 1):
+                if (rr, cc) == missing:
+                    continue
+                r0 = tr - shift_r - rr
+                c0 = tc - shift_c - cc
+                comp = _make_comp(color, r0, c0, missing)
