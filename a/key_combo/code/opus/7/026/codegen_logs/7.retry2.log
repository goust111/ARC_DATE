+
+def _components(grid: np.ndarray) -> list[dict]:
+    H, W = grid.shape
+    seen = np.zeros_like(grid, dtype=bool)
+    comps: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            color = int(grid[r, c])
+            if color not in SOURCE_COLORS or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
