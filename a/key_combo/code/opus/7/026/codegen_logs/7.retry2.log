+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+SOURCE_COLORS = (GREY, RED)
+COPY_COLOR = {GREY: YELLOW, RED: GREEN}
+DIAGONAL_STEP = 2  # one 2x2-box diagonal step
+L_CORNERS = {(0, 0), (0, 1), (1, 0), (1, 1)}
+MAX_GENERATION_ATTEMPTS = 800
+
+
+def _bbox(coords: Iterable[tuple[int, int]]) -> tuple[int, int, int, int]:
+    pts = list(coords)
+    rs = [r for r, _ in pts]
+    cs = [c for _, c in pts]
+    return min(rs), min(cs), max(rs), max(cs)
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    H, W = grid.shape
+    seen = np.zeros_like(grid, dtype=bool)
+    comps: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            color = int(grid[r, c])
+            if color not in SOURCE_COLORS or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) == color:
