+def _attempt_generate() -> np.ndarray | None:
+    H = random.randint(22, 28)
+    W = random.randint(22, 28)
+    grey_count = random.randint(3, 4)
+    red_count = random.randint(3, 4)
+    colors = [GREY] * grey_count + [RED] * red_count
+    random.shuffle(colors)
