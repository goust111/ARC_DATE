+        r0 = random.randint(0, H - 2)
+        c0 = random.randint(0, W - 2)
+        comp = _make_comp(color, r0, c0, missing)
+        if _can_place(comp, placed, occupied, H, W):
+            return comp
+    return None
+
+
+def _find_blocker(
+    color: int,
+    target: tuple[int, int],
+    keep_free: tuple[int, int],
+    placed: list[dict],
+    occupied: set[tuple[int, int]],
+    H: int,
+    W: int,
