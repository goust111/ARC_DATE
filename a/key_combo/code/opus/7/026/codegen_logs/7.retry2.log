+    victim_path = _raw_path_for_comp(victim)
+    if len(victim_path) < 2:
+        return None
+    _place_comp(victim, placed, occupied)
+
+    target = victim_path[-1]
+    keep_free = victim_path[0]
+    blocker = None
+    for idx, color in enumerate(colors):
