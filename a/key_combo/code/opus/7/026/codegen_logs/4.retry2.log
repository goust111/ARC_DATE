+GREY = 5
+CONTROL_COLORS = (1, 2, 3, 4, 7)
+ALL_CORNERS = ((0, 0), (0, 1), (1, 0), (1, 1))
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = (
+    (-1, -1),
