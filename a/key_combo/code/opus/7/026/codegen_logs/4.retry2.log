    missing = _L_CORNERS - rel
    assert len(missing) == 1, "2x2 L triomino must have exactly one missing corner"
    mr, mc = next(iter(missing))
    return (-1 if mr == 0 else 1, -1 if mc == 0 else 1)


def main(grid: np.ndarray) -> np.ndarray:
