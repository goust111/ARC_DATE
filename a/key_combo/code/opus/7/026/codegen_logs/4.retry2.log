+def _expand8(cells: tuple[tuple[int, int], ...], h: int, w: int) -> set[tuple[int, int]]:
+    blocked: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for dr, dc in DIR8:
+            nr, nc = r + dr, c + dc
