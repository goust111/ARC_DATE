+    b = int(rng.integers(last_band[0], last_band[1] + 1))
+    return a, b
+
+
+def _rectangle_mask(
+    shape: tuple[int, int],
+    r0: int,
+    r1: int,
+    c0: int,
+    c1: int,
+    blank_rows: set[int],
+    blank_cols: set[int],
