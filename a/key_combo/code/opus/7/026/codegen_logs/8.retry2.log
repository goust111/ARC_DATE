+                continue
+            rb0 = int(rng.integers(0, row_band_count - 1))
+            cb0 = int(rng.integers(0, marker_count - 1))
+            obj = _place_object(
+                rng,
+                occupied,
+                row_bands,
+                col_bands,
+                blank_row_set,
+                blank_col_set,
+                marker_cols,
+                row_span=(rb0, rb0 + 1),
+                col_span=(cb0, cb0 + 1),
+            )
+        if obj is not None:
+            objects.append(obj)
