    for _ in range(single_count):
        placements = _gen_single_locations(grid)
        if not placements:
            return False
        coords = placements[int(rng.integers(0, len(placements)))]
        r, c = coords[0]
        grid[r, c] = GEN_FOREGROUND
    return True


