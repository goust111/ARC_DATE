+        axis_kind, axis = _frame_axis(r0, c0, r1, c1)
+        perimeter = _perimeter_coords(r0, c0, r1, c1)
+        gap_cells = [(r, c) for r, c in perimeter if int(grid[r, c]) == BG]
+        assert len(gap_cells) == 1, "each frame must have exactly one perimeter gap"
