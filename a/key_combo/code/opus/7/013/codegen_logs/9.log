+    cells |= _segment_cells((cur_r, cur_c), (end[0], cur_c), include_start=False)
+    cells |= _segment_cells((end[0], cur_c), end, include_start=True)
+    cells.discard(start)
+    cells.discard(end)
+    corridor_cells.append(cells)
+    return corridor_cells, door_cells
