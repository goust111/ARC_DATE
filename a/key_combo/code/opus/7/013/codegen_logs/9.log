+        offset = 0
+        for color, count in counts.items():
+            for r, c in picked[offset : offset + count]:
+                grid[r, c] = int(color)
+            offset += count
+
+
+def _oracle_output(
+    grid: np.ndarray,
+    wall_rows: list[int],
+    door_cols: list[int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+) -> np.ndarray:
