+
+
+def _place_scatter(
+    grid: np.ndarray,
+    bounds: list[tuple[int, int]],
+    corridor_cells: list[set[tuple[int, int]]],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    majority_colors: list[int],
+    rng: random.Random,
+) -> None:
