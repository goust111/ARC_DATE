+
+def _pick_dimensions(rng: random.Random) -> tuple[int, int, int, list[int]]:
+    corridor_count = rng.choice((3, 4))
+    heights = [rng.randint(4, 6) for _ in range(corridor_count)]
+    total_h = sum(heights) + (corridor_count - 1)
