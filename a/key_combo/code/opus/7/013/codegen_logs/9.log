    raise ValueError("could not sample a non-degenerate route")


def _corridor_for_row(bounds: list[tuple[int, int]], row: int) -> int:
    for i, (r0, r1) in enumerate(bounds):
        if r0 <= row <= r1:
            return i
    raise AssertionError("row is not inside any corridor")


