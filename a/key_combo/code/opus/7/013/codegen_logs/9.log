+        scatter_on_path = np.argwhere((~np.isin(grid, (BG, WALL, MARKER))) & np.array(
+            [[(r, c) in path_cells for c in range(grid.shape[1])] for r in range(grid.shape[0])],
+            dtype=bool,
+        ))
+        assert scatter_on_path.size == 0
+
