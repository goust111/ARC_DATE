+        inner = grid[r0 + 1 : r1, c0 + 1 : c1]
+        markers = np.argwhere(inner == RED)
+        if markers.shape[0] != 1:
+            continue
+        if not np.all((inner == BLACK) | (inner == RED)):
+            continue
