+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_4_connected(coords: list[tuple[int, int]]) -> bool:
+    if not coords:
+        return False
+    cells = set(coords)
+    seen = {coords[0]}
+    stack = [coords[0]]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in DIRS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                stack.append(nxt)
+    return len(seen) == len(cells)
+
+
+def _wall_axis(row: np.ndarray) -> int | None:
+    zeros = np.flatnonzero(row == BLACK)
+    if len(zeros) != 3:
+        return None
+    if not np.array_equal(zeros, np.arange(zeros[0], zeros[0] + 3)):
+        return None
+    if not np.all((row == GREY) | (row == BLACK)):
+        return None
+    if int(np.count_nonzero(row == GREY)) != len(row) - 3:
+        return None
+    return int(zeros[1])
+
