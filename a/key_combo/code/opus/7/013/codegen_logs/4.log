+GRID_H_RANGE = (13, 20)
+GRID_W_RANGE = (14, 22)
+CORRIDOR_COUNT_CHOICES = (2, 3)
+CORRIDOR_HEIGHT_RANGE = (3, 5)
+PATTERN_SIZE_RANGE = (2, 5)
+GEN_RETRIES = 400
