/2/code.py:275:        cross_extra = cross - path_set\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:277:        if cross & used_cross:\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:279:        if ray & used_cross:\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:281:        if cross_extra & occupied or cross_extra & drawn:\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:285:        if cross_extra & used_ray or ray & extra_cross or ray & used_ray:\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:288:        used_cross.update(cross)\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:290:        extra_cross.update(cross_extra)\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:296:    return selected, extra_cross, used_ray, set(path[1:-1]) - selected_set\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:335:        trigger_positions, extra_cross, ray_cells, path_fill = chosen\n/home/lixinyu/snap/new/ceshi/code/db695cfb/D13/2/code.py:342:        drawn.update(extra_cross)\n/home/lixinyu/snap/new/ceshi/code/2ba387bc/D14/1/code.py:35:#    - Unique non-bg colors prevent any accidental merging across objects of different classes.\n/home/lixinyu/snap/new/ceshi/code/2ba387bc/D14/1/code.py:40:#    - Having at least one group with size >= 2 makes left-to-right ordering readable across examples.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D4/1/code.py:19:#     examples; mixing left->right and right->left across samples would make the rule harder to infer.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D4/1/code.py:43:#   - The generator reserves the two legend rows across the whole width so no marker can sit on those rows.\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D2/0/code.py:334:    cross_dim = 3 if arrangement == \"horizontal\" else total\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D2/0/code.py:339:        r_min, r_max = 1, panel_h - cross_dim - 1\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D2/0/code.py:3