+    if info["K"] != meta["K"]:
+        return False
+    if info["repeated_colors"] != meta["repeated_colors"]:
+        return False
+    if info["target"]["signature"] != meta["target_signature"]:
+        return False
+
+    target = info["target"]
+    peers = [record for record in info["singletons"] if record["signature"] != target["signature"]]
+    if not peers:
