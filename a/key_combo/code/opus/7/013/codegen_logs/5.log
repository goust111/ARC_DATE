 216: def _place_positions(n: int, lo: int, hi: int, min_gap: int, rng: random.Random) -> list[int] | None:
 217:     """Place n positions in [lo..hi] with pairwise gap >= min_gap between consecutive sorted positions."""
 218:     needed = n + (n - 1) * min_gap
 219:     span = hi - lo + 1
 220:     if span < needed:
 221:         return None
 222:     compressed_span = span - (n - 1) * min_gap
 223:     picks = sorted(rng.sample(range(compressed_span), n))
 224:     return [lo + picks[i] + i * min_gap for i in range(n)]
 225: 
