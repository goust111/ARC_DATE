+    g = np.asarray(grid, dtype=int)
+    info = _analyze(g)
+    target = info["target"]
+    r0, c0, _r1, _c1 = target["bbox"]
+    scaled = scale_sprite(target["crop"], info["K"])
+
+    out = np.full(g.shape, info["bg"], dtype=int)
+    paste(out, scaled, r0, c0)
+    return out
