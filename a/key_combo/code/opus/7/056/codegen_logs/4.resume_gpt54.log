+
+def _render_frame(
+    seed: np.ndarray,
+    heights: np.ndarray,
+    widths: np.ndarray,
+    shown: set[tuple[int, int]],
+) -> np.ndarray:
+    rows, cols = seed.shape
+    h = int(heights.sum() + rows + 1)
+    w = int(widths.sum() + cols + 1)
