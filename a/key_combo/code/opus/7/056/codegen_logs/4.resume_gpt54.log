+    line_rows = [r for r in range(sub.shape[0]) if np.all(sub[r] == FRAME)]
+    line_cols = [c for c in range(sub.shape[1]) if np.all(sub[:, c] == FRAME)]
+    assert len(line_rows) >= 3 and len(line_cols) >= 3
