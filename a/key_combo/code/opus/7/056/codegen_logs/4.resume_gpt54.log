+    bottom[r1, c0 : c1 + 1] = FRAME
+    bottom[r0 : r1 + 1, c0] = FRAME
+    bottom[r0 : r1 + 1, c1] = FRAME
+
+    expected = _expected_bottom(bottom, (r0, c0, r1, c1), seed)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
