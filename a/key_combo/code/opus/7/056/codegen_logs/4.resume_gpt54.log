+    layout: tuple[int, int] | None = None
+    seen: dict[tuple[int, int], int] = {}
+    for frame in frames:
+        cur_layout, slot_colors = _parse_frame(top, frame)
+        if layout is None:
+            layout = cur_layout
+        assert cur_layout == layout
+        for pos, color in slot_colors.items():
+            prev = seen.get(pos)
+            if prev is None:
