+def _tile_into(shape: tuple[int, int], seed: np.ndarray) -> np.ndarray:
+    h, w = shape
+    rr = np.arange(h)[:, None] % seed.shape[0]
+    cc = np.arange(w)[None, :] % seed.shape[1]
+    return seed[rr, cc]
