+    bottom[r0, c0 : c1 + 1] = FRAME
+    bottom[r1, c0 : c1 + 1] = FRAME
+    bottom[r0 : r1 + 1, c0] = FRAME
+    bottom[r0 : r1 + 1, c1] = FRAME
