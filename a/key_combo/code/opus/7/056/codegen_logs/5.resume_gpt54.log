    overlap_band_h = max(plain_h, *(rect.shape[0] for rect in overlap_rects))

    non_overlap_rects = _build_non_overlap_rects(
        n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs
    )
