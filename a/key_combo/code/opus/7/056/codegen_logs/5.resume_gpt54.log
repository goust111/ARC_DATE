+
+
+def _bbox_from_center(obj: dict) -> tuple[int, int, int, int]:
+    cr, cc = obj["center"]
+    return (
+        int(cr + obj["template"]["min_r"]),
+        int(cc + obj["template"]["min_c"]),
+        int(cr + obj["template"]["max_r"]),
