+def _place_center_random(obj: dict, h: int, w: int, placed: list[dict], *, allow_ring_overlap: bool) -> bool:
+    radius = int(obj["count"]) - 1
+    rows = list(range(radius, h - radius))
+    cols = list(range(radius, w - radius))
+    random.shuffle(rows)
+    random.shuffle(cols)
+    for cr in rows:
+        for cc in cols:
