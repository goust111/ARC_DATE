+        for template in templates:
+            cells = set(template["cells"])
+            assert len(cells) == count
+            seen = set()
+            stack = [next(iter(cells))]
+            while stack:
+                cur = stack.pop()
+                if cur in seen:
+                    continue
+                seen.add(cur)
