+
+def _has_visible_ring_conflict(a: dict, b: dict) -> bool:
+    box_a = _ring_box(a)
+    box_b = _ring_box(b)
+    r0 = max(box_a[0], box_b[0])
+    c0 = max(box_a[1], box_b[1])
+    r1 = min(box_a[2], box_b[2])
