  42:         dest_bottom = dest_top + int(red_rows.size)
  43:         assert dest_bottom <= h
  44:         assert np.all(g[dest_top:dest_bottom, c] != Color.BLUE)
  45: 
  46:         out[dest_top:dest_bottom, c] = Color.RED
  47: 
