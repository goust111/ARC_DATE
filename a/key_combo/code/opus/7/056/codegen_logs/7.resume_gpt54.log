  69: def main(grid: np.ndarray) -> np.ndarray:
  70:     """
  71:     Use local source-target-pattern examples to replace matching source pixels.
  72: 
  73:     Input structure:
  74:     - Black background with isolated colored pixels and teal (8) pattern components.
  75:     - A rule example is a 4-neighbor colored pair source->target whose continued
  76:       direction reaches an anchor touching a teal pattern component.
  77: 
  78:     Rule:
  79:     - For each rule example, copy that teal component onto every other pixel of
  80:       source.color, recoloring the copied component to target.color.
  81:     - Translation maps the rule anchor onto the source pixel being replaced.
  82:     - Remove teal components and all pixels used by rule examples.
  83: 
  84:     Key insight: The two adjacent colored pixels define the color substitution and
  85:     the anchor point; the nearby teal component is the stencil that gets recolored.
  86:     """
  87:     g = np.asarray(grid, dtype=int)
  88:     bg = get_bg(g)
  89:     pattern_color = 8
  90:     h, w = g.shape
  91: 
  92:     rules = _discover_rules(g, bg=bg, pattern_color=pattern_color)
  93:     legend_pixels: set[tuple[int, int]] = set()
  94:     source_colors: set[int] = set()
  95:     for rule in rules:
  96:         legend_pixels.add(rule["source_pos"])
  97:         legend_pixels.add(rule["target_pos"])
  98:         source_colors.add(rule["source_color"])
  99: 
 100:     out = np.full_like(g, int(bg))
 101: 
 102:     # Preserve ordinary colored pixels that are not consumed by any learned rule.
 103:     for r, c in map(tuple, np.argwhere((g != int(bg)) & (g != pattern_color))):
 104:         r = int(r)
 105:         c = int(c)
 106:         color = int(g[r, c])
 107:         if (r, c) in legend_pixels or color in source_colors:
 108:             continue
 109:         out[r, c] = color
 110: 
 111:     for rule in rules:
 112:         ar, ac = rule["anchor"]
 113:         pattern = rule["pattern"]
 114:         for sr, sc in map(tuple, np.argwhere(g == rule["source_color"])):
