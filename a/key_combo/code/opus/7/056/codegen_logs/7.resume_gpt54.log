+    h, w = out.shape
+    for bar in sorted(bars, key=_stamp_order):
+        rows = offsets[:, 0] + bar.final_center_row
+        cols = offsets[:, 1] + bar.col
+        keep = (0 <= rows) & (rows < h) & (0 <= cols) & (cols < w)
+        out[rows[keep], cols[keep]] = bar.color
