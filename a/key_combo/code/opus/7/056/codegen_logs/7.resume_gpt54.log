+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(14, 21)
+    w = rng.randint(14, 21)
+    grey_row = rng.randint(5, h - 6)
+    grid = np.full((h, w), BLACK, dtype=int)
