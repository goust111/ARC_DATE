+
+TEMPLATE_PATTERNS = [
+    np.array(
+        [
+            [8, 0, 0],
+            [8, 8, 8],
+            [0, 8, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 0, 8],
+            [8, 8, 8],
+            [0, 8, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 8, 0],
+            [8, 8, 8],
+            [8, 0, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 8, 0],
+            [8, 8, 8],
+            [0, 0, 8],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 8, 0],
+            [8, 8, 0],
+            [0, 8, 8],
+        ],
+        dtype=int,
+    ),
