  14: def main(input_grid):
  15:     """
  16:     Remove a filled rectangular occluder and mirror the remaining object to restore symmetry.
  17: 
  18:     Input structure:
  19:     - A black grid contains a monochromatic object with left-right mirror symmetry.
  20:     - A different-colored filled rectangle overlaps and hides part of that object.
  21:     - The rectangle is itself a solid connected component.
  22: 
  23:     Rule:
  24:     - Detect the solid rectangle component and erase it to black.
  25:     - Detect mirror symmetry while ignoring the rectangle color.
  26:     - Reflect every remaining object pixel across the detected mirror axes to fill the missing cells.
  27: 
  28:     Key insight:
  29:     - The occluder color should be ignored for symmetry detection, while black remains meaningful absence.
  30:     """
  31:     # Plan:
  32:     # 1. Extract and separate the rectangle from the symmetric object
  33:     # 2. Find the left-right symmetry
  34:     # 3. Fill in the missing parts of the object
  35: 
  36:     background_color = Color.BLACK
  37: 
  38:     # Each object has a different color, so we can look at connected components by color
  39:     objects = detect_objects(input_grid, monochromatic=True, connectivity=8, background=background_color)
  40:     sprites = []
  41:     for obj in objects:
  42:         _b = bbox(obj != background_color)
  43:         if _b is None:
  44:             continue
  45:         sprites.append(crop_bbox(obj, _b))
  46:     # Find the rectangle
  47:     for obj, sprite in zip(objects, sprites):
  48:         # the rectangle will be completely filled, so we can check if its total area is the whole rectangular region
  49:         if sprite.shape[0] * sprite.shape[1] == np.sum(sprite != Color.BLACK):
  50:             rectangle = obj
  51:             break
  52: 
  53:     # Find the color of the rectangle, because it is the occluder
  54:     rectangle_color = colors_present(rectangle, exclude={ background_color })[0]
  55:     
  56:     # Delete the rectangle
  57:     rectangle_mask = rectangle != Color.BLACK
  58:     output_grid = input_grid.copy()
  59:     output_grid[rectangle_mask] = Color.BLACK
  60: 
