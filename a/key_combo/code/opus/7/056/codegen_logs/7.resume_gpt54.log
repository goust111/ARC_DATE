+    h, w = grid.shape
+    th, tw = template.shape
+    if corner == "tl":
+        r0 = rng.randint(0, 1)
+        c0 = rng.randint(0, 1)
+    elif corner == "tr":
+        r0 = rng.randint(0, 1)
+        c0 = rng.randint(max(0, w - tw - 1), w - tw)
+    elif corner == "bl":
+        r0 = rng.randint(max(0, h - th - 1), h - th)
+        c0 = rng.randint(0, 1)
+    else:
+        r0 = rng.randint(max(0, h - th - 1), h - th)
+        c0 = rng.randint(max(0, w - tw - 1), w - tw)
+    mask = template == TEAL
+    grid[r0 : r0 + th, c0 : c0 + tw][mask] = TEAL
+    return r0, c0
+
