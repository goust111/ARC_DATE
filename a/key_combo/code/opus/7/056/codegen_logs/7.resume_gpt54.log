+def _extract_bars(grid: np.ndarray, grey_row: int) -> list[Bar]:
+    h, w = grid.shape
+    bars: list[Bar] = []
+    valid_colors = set(int(v) for v in np.unique(grid)) - {BLACK, GREY, TEAL}
