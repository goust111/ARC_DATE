+    if teal_pixels < 3 or teal_pixels > 8:
+        return None
+
+    bars = _extract_bars(grid, grey_row)
+    if sum(bar.side == "above" for bar in bars) == 0 or sum(bar.side == "below" for bar in bars) == 0:
+        return None
+
+    out = main(grid)
+    if np.count_nonzero(out) < teal_pixels:
+        return None
+    return grid
