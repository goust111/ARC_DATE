+    expected = _combine_rendered_panels(left_objects, right_objects, shape)
+    if np.count_nonzero(expected) == 0 or np.count_nonzero(expected == BACKGROUND) == 0:
+        return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
