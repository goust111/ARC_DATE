+    "left": [(9, 1), (9, 3), (7, 1), (7, 3), (7, 5), (5, 1), (5, 3)],
+    "right": [(1, 9), (3, 9), (1, 7), (3, 7), (5, 7), (1, 5), (3, 5)],
+    "tie": [(3, 3), (5, 5), (7, 7), (9, 9), (1, 1)],
+}
+EXTRA_SIDE_WEIGHTS = (1, 3, 3, 5, 5, 7, 7, 9)
