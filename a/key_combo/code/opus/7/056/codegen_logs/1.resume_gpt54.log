+    use_pair = bool(pairs) and (not singles or rng.random() < 0.65)
+    if use_pair:
+        preferred = [item for item in pairs if item[2]]
+        pool = preferred if preferred else pairs
+        (a, b), entries, _ = pool[int(rng.integers(0, len(pool)))]
