+    grid[wr1, wc0 : wc1 + 1] = WALL
+    grid[wr0 : wr1 + 1, wc0] = WALL
+    grid[wr0 : wr1 + 1, wc1] = WALL
+
+
+def _find_cavities(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
