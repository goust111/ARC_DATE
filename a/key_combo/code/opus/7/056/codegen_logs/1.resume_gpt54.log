+    entries: dict[int, list[tuple[int, int]]] = {}
+    for dr, dc in DIAGONALS:
+        active: set[int] = set()
+        r, c = source
+        while True:
+            r += dr
+            c += dc
+            if not (0 <= r < h and 0 <= c < w):
+                break
+            for idx, cavity in enumerate(cavities):
+                r0, c0, r1, c1 = cavity["interior"]
+                inside = r0 <= r <= r1 and c0 <= c <= c1
