+    if pairs:
+        (a, b), entries, _ = pairs[int(rng.integers(0, len(pairs)))]
+        return [((a["coord"][0], a["coord"][1]), SOURCE_COLORS[0]), ((b["coord"][0], b["coord"][1]), SOURCE_COLORS[1])], entries
