+    tile = cavity["tile"]
+    tile_h, tile_w = tile.shape
+    ar, ac = anchor
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            out[r, c] = int(tile[(r - ar) % tile_h, (c - ac) % tile_w])
