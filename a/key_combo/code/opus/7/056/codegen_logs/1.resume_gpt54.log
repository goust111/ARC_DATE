+    out = np.full_like(g, BLACK)
+    out[g == WALL] = WALL
+    for idx, cavity in enumerate(cavities):
+        if not entries[idx]:
+            raise AssertionError("every cavity must be hit by at least one ray")
+        anchor = min(entries[idx])
+        _tile_cavity(out, cavity, anchor)
+    return out
