+
+BLACK = 0
+WALL = 5
+SOURCE_COLORS = (6, 7)
+SEED_COLORS = (1, 2, 3, 4, 8, 9)
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+MAX_GENERATION_ATTEMPTS = 400
+GRID_HEIGHT_RANGE = (16, 23)
+GRID_WIDTH_RANGE = (16, 23)
