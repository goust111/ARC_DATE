+            covered = a["covered"] | b["covered"]
+            if covered != target:
+                continue
+            entries = _merge_entries(a["entries"], b["entries"], len(cavities))
+            multi = any(len(entries[idx]) >= 2 for idx in target)
+            pairs.append(((a, b), entries, multi))
