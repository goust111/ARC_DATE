+def _entry_points_for_source(
+    shape: tuple[int, int], source: tuple[int, int], cavities: list[dict]
+) -> dict[int, list[tuple[int, int]]]:
+    h, w = shape
+    entries: dict[int, list[tuple[int, int]]] = {}
+    for dr, dc in DIAGONALS:
+        active: set[int] = set()
+        r, c = source
+        while True:
+            r += dr
+            c += dc
+            if not (0 <= r < h and 0 <= c < w):
