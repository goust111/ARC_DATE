RECT_H_RANGE = (2, 5)                            # rect height bounds
RECT_MAX_WIDTH = 7                               # max rect width
RECT_RETRY_FACTOR = 5                            # retries per target rect
RECT_MARGIN_GAP = 1                              # min gap between placed rects

