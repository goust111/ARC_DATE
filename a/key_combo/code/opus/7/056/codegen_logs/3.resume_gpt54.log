+def _components_same_color(grid: np.ndarray, mask: np.ndarray | None = None) -> list[dict]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c]:
+                continue
+            if mask is not None and not bool(mask[r, c]):
+                continue
+            color = int(grid[r, c])
+            if color == 0 and mask is None:
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if visited[nr, nc]:
+                        continue
+                    if mask is not None and not bool(mask[nr, nc]):
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    visited[nr, nc] = True
+                    stack.append((nr, nc))
+            if coords:
+                comps.append(
+                    {
+                        "color": color,
+                        "coords": coords,
+                        "bbox": _bbox_from_coords(coords),
+                        "area": len(coords),
+                    }
+                )
+    return comps
+
+
+def _components_from_mask(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
