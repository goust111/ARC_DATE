+
+    completed_holes = np.zeros((frame_h, frame_w), dtype=bool)
+    pairs: list[dict] = []
+
+    total_pairs_target = rng.randint(max(4, shape_count), shape_count + 3)
+    per_shape_counts = [1] * shape_count
