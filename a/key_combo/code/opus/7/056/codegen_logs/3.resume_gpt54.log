+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or not bool(mask[r, c]):
+                continue
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and bool(mask[nr, nc]):
