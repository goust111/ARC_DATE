+def _canonical_shape_key(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    keys = []
+    for variant in _shape_variants(mask):
+        keys.append((tuple(map(int, variant.shape)), variant.astype(np.uint8).tobytes()))
+    return min(keys)
