+def _estimate_axis2(frame_mask: np.ndarray) -> int:
+    h, w = frame_mask.shape
+    center_axis2 = w - 1
+    best = (10**9, 10**9, center_axis2)
+    for axis2 in range(2 * w - 1):
+        score = 0
+        for c in range(w):
+            mc = axis2 - c
+            col = frame_mask[:, c]
+            if 0 <= mc < w:
