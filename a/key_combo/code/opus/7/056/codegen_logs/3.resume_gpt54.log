+        per_shape_counts[rng.randrange(shape_count)] += 1
+
+    for shape, color, pair_count in zip(chosen_shapes, chosen_colors, per_shape_counts):
+        sh, sw = shape.shape
+        mirrored_shape = np.fliplr(shape)
