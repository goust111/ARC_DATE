+    pairs: list[dict] = []
+
+    total_pairs_target = rng.randint(max(4, shape_count), shape_count + 3)
+    per_shape_counts = [1] * shape_count
+    for _ in range(total_pairs_target - shape_count):
+        per_shape_counts[rng.randrange(shape_count)] += 1
