import random
import numpy as np

BG, BLUE, RED = 0,1,2

def in_bounds(shape,r,c):
    return 0 <= r < shape[0] and 0 <= c < shape[1]

def perimeter_cells(box):
    r0,c0,r1,c1=box
    cells=[]
    for c in range(c0,c1+1):
        cells.append((r0,c))
        cells.append((r1,c))
    for r in range(r0+1,r1):
        cells.append((r,c0))
        cells.append((r,c1))
    return set(cells)

def ray_cells(red_box, shape):
    r0,c0,r1,c1=red_box
    specs=[((r0,c0),(-1,-1)),((r0,c1),(-1,1)),((r1,c0),(1,-1)),((r1,c1),(1,1))]
    rays=[]
    for (r,c),(dr,dc) in specs:
        cells=[]
        rr,cc=r+dr,c+dc
        while in_bounds(shape,rr,cc):
            cells.append((rr,cc))
            rr+=dr; cc+=dc
        rays.append(cells)
    return rays

def clear_box(a,b,pad=0):
    ar0,ac0,ar1,ac1=a
    br0,bc0,br1,bc1=b
    return ar1+pad < br0 or br1+pad < ar0 or ac1+pad < bc0 or bc1+pad < ac0

def analyze(shape, red_box, frame_box):
    H,W=shape
    enc={(r,c) for r in range(H-3,H) for c in range(W-3,W)}
    frame=perimeter_cells(frame_box)
    corners={(frame_box[0],frame_box[1]),(frame_box[0],frame_box[3]),(frame_box[2],frame_box[1]),(frame_box[2],frame_box[3])}
    infos=[]
    active=0
    for cells in ray_cells(red_box, shape):
        hits=[p for p in cells if p in frame]
        if len(hits)>1:
            return None
        if hits:
            hit=hits[0]
            if hit not in corners:
                return None
            idx=cells.index(hit)
            after=cells[idx+1:]
            if not after:
                return None
            if any(p in enc for p in after):
                return None
            infos.append((hit, idx, len(after)))
            active += 1
        else:
            infos.append(None)
    return active, infos

random.seed(0)
for attempt in range(20):
    H=random.randint(13,18)
    W=random.randint(13,18)
    rh=random.randint(3,4)
    rw=random.randint(2,3)
    r0=random.randint(3, H-7-rh)
    c0=random.randint(3, W-7-rw)
    red=(r0,c0,r0+rh-1,c0+rw-1)
    enc=(H-3,W-3,H-1,W-1)
    cand=[]
    for fr0 in range(1,H-4):
      for fc0 in range(1,W-4):
        for fr1 in range(fr0+2,H-1):
          for fc1 in range(fc0+2,W-1):
            if fr1-fr0+1 <= rh or fc1-fc0+1 <= rw:
              continue
            box=(fr0,fc0,fr1,fc1)
            if not clear_box(red, box, pad=0):
              continue
            if not clear_box(box, enc, pad=0):
              continue
            res=analyze((H,W), red, box)
            if res and res[0] in (1,2,3):
              cand.append((box,res[0]))
    print(attempt, (H,W), red, len(cand), {n:sum(1 for _,k in cand if k==n) for n in (1,2,3)})
