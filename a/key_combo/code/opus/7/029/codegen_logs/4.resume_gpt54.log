+def _render_grid(
+    shape: tuple[int, int],
+    red_box: tuple[int, int, int, int],
+    frame_box: tuple[int, int, int, int],
+) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    r0, c0, r1, c1 = red_box
+    grid[r0 : r1 + 1, c0 : c1 + 1] = SOLID
+    for r, c in _perimeter_cells(frame_box):
+        grid[r, c] = FRAME
