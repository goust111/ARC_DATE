+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed to build a valid puzzle instance")

