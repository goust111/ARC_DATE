+def _find_components(grid: np.ndarray, bg: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if visited[r, c] or int(grid[r, c]) == bg:
+                continue
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
