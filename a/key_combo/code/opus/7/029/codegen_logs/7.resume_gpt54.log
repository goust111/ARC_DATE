+    if bottom < h:
+        out[bottom, max(0, left) : min(w, right + 1)] = frame.color
+    if left >= 0:
+        out[max(0, top) : min(h, bottom + 1), left] = frame.color
+    if right < w:
+        out[max(0, top) : min(h, bottom + 1), right] = frame.color
