+    W: int,
+    start: tuple[int, int],
+    initial_direction: tuple[int, int],
+    turns: tuple[int, ...],
+) -> tuple[set[tuple[int, int]], list[tuple[tuple[int, int], int]]] | None:
+    def search(
+        i: int,
+        pos: tuple[int, int],
+        direction: tuple[int, int],
+        path_cells: set[tuple[int, int]],
+        controls: list[tuple[tuple[int, int], int]],
