+
+def _render_folded_scene(
+    H: int,
+    W: int,
+    start: tuple[int, int],
+    controls: list[tuple[tuple[int, int], int]],
+) -> np.ndarray:
+    scene = np.zeros((H, W), dtype=int)
+    scene[start] = START
+    for (r, c), color in controls:
+        scene[r, c] = int(color)
+    return scene
