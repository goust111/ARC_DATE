+
+            inp = np.zeros((H, 2 * W + 1), dtype=int)
+            inp[:, :W] = left_only
+            inp[:, W] = SEPARATOR
+            inp[:, W + 1 :] = np.fliplr(right_folded)
+
+            out = main(inp)
+            expected = _trace_path(folded)
+            if not np.array_equal(out, expected):
+                continue
+            if len(path_cells) < TOTAL_PATH_RANGE[0]:
+                continue
+            return inp
+
+    return None
+
+
+def generate_input() -> np.ndarray:
