+PATTERNS = {
+    3: (("h", "v"), ("v", "h")),
+    4: (("h", "v", "h"), ("v", "h", "v")),
+}
+OFFSET_CHOICES = (-2, -1, 0, 1, 2)
+GAP_CHOICES = (3, 4, 5)
+MARGIN_CHOICES = (2, 3, 4, 5)
