+    out = np.full_like(g, bg)
+    densities: dict[int, int] = {}
+
+    for anchor in anchors:
+        out[anchor["r0"] : anchor["r1"] + 1, anchor["c0"] : anchor["c1"] + 1] = anchor["color"]
+
+    for anchor in anchors:
+        color = anchor["color"]
