+
+def _bg_color(grid: np.ndarray) -> int:
+    values = grid.astype(int).ravel()
+    counts = np.bincount(values, minlength=max(11, int(values.max()) + 1))
+    return int(np.argmax(counts))
+
+
+def _sign(x: int) -> int:
+    if x > 0:
+        return 1
+    if x < 0:
+        return -1
+    return 0
+
+
+def _overlap_1d(a0: int, a1: int, b0: int, b1: int) -> tuple[int, int] | None:
+    lo = max(a0, b0)
+    hi = min(a1, b1)
+    return (lo, hi) if lo <= hi else None
+
+
+def _find_anchors(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
+    anchors: list[dict] = []
+    seen = set()
+    h, w = g.shape
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            color = int(g[r0, c0])
+            if color == bg:
+                continue
+            if not np.all(g[r0 : r0 + 3, c0 : c0 + 3] == color):
+                continue
+            key = (r0, c0, color)
+            if key in seen:
+                continue
+            seen.add(key)
+            anchors.append(
+                {
+                    "color": color,
+                    "r0": r0,
+                    "c0": c0,
+                    "r1": r0 + 2,
+                    "c1": c0 + 2,
+                    "cr": r0 + 1,
+                    "cc": c0 + 1,
+                }
+            )
+    anchors.sort(key=lambda anchor: (anchor["r0"], anchor["c0"]))
+    return anchors
+
+
+def _direction_from_center(anchor: dict, r: int, c: int) -> tuple[int, int] | None:
+    dr = r - anchor["cr"]
+    dc = c - anchor["cc"]
+    if dr == 0 and dc != 0:
+        return 0, _sign(dc)
+    if dc == 0 and dr != 0:
+        return _sign(dr), 0
+    if abs(dr) == abs(dc) and dr != 0:
+        return _sign(dr), _sign(dc)
+    return None
+
+
+def _compress_state(grid: np.ndarray) -> tuple[np.ndarray, list[dict], dict[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _bg_color(g)
