+                c0 = left["c1"] + 1
+                c1 = right["c0"] - 1
+                r0, r1 = row_band
+                if c0 <= c1 and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == bg):
+                    pairs.append(
+                        {
+                            "a": a,
+                            "b": b,
+                            "axis": "h",
+                            "rect": (r0, c0, r1, c1),
+                            "color": _corridor_color(a, b, densities),
+                        }
+                    )
+                    continue
