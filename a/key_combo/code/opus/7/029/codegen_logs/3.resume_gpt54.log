+        for (dr, dc), dists in groups.items():
+            for idx, _dist in enumerate(sorted(dists)):
+                rr = anchor["cr"] + (idx + 2) * dr
+                cc = anchor["cc"] + (idx + 2) * dc
+                out[rr, cc] = color
