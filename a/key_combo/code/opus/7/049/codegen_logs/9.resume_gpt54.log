+        "bottom": np.broadcast_to(rows >= height - height // 2, (height, width)),
+        "left": np.broadcast_to(cols < width // 2, (height, width)),
+        "right": np.broadcast_to(cols >= width - width // 2, (height, width)),
+    }
+
