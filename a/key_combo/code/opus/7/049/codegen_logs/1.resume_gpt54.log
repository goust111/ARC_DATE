+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+CONTOUR_COLOR = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 8, 9)
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.asarray(cells, dtype=int)
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return out
+
+
+def _can_shift_down(coords: np.ndarray, dr: int, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    shifted = coords + np.array([dr, 0], dtype=int)
+    if not bool(np.all((0 <= shifted[:, 0]) & (shifted[:, 0] < h) & (0 <= shifted[:, 1]) & (shifted[:, 1] < w))):
+        return False
+    return not bool(occupied[shifted[:, 0], shifted[:, 1]].any())
+
+
+def _drop_contours(contours: list[dict], markers: list[tuple[int, int, int]], shape: tuple[int, int]) -> list[dict]:
+    occupied = np.zeros(shape, dtype=bool)
+    for r, c, _color in markers:
+        occupied[int(r), int(c)] = True
+
+    placed: list[dict] = []
+    order = sorted(contours, key=lambda comp: (int(comp["bbox"][2]), int(comp["bbox"][0]), int(comp["bbox"][1])), reverse=True)
+    for comp in order:
+        dr = 0
+        while _can_shift_down(comp["coords"], dr + 1, occupied):
+            dr += 1
+        landed = comp["coords"] + np.array([dr, 0], dtype=int)
+        occupied[landed[:, 0], landed[:, 1]] = True
+        placed.append(
+            {
+                "id": comp["id"],
+                "color": int(comp["color"]),
+                "coords": landed,
+                "bbox": _bbox(landed),
+                "area": int(comp["area"]),
+                "drop": dr,
+            }
+        )
+    return placed
+
+
+def _mask_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
