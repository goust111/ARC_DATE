+    marker_positions = []
+    used_colors = random.sample(list(MARKER_COLORS), k=len(landed))
+    for comp, color in zip(sorted(landed, key=lambda x: x["id"]), used_colors):
+        regions = _local_cavity_regions(landed_grid, comp)
