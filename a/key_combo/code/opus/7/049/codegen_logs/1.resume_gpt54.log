+def _render_contours(shape: tuple[int, int], contours: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for comp in contours:
+        _paint(grid, comp["coords"], comp["color"])
+    return grid
+
