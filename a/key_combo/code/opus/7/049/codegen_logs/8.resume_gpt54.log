+    for i, j in solutions[0]:
+        a = blue_coords[i]
+        b = blue_coords[j]
+        pairs.append(tuple(sorted((a, b))))
+    return sorted(pairs, key=lambda pair: ((pair[0][0] + pair[1][0]) // 2, (pair[0][1] + pair[1][1]) // 2))
