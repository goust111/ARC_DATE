+        box = _bbox(comp)
+        if (box[2] - box[0] + 1, box[3] - box[1] + 1) != (3, 3):
+            continue
+        sprite = _crop(grid, box)
+        area = int(np.count_nonzero(sprite != BLACK))
+        if 3 <= area <= 5:
