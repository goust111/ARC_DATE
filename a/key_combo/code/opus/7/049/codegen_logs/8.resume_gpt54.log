+    for comp in _components(mask, connectivity=4):
+        if any(
+            0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and blue_mask[nr, nc]
+            for r, c in comp
+            for nr, nc in _neighbors8(r, c)
+        ):
