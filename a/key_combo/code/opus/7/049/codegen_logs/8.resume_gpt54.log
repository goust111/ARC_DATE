BLACK_COUNT_BOUNDS = (3, 9)
FOREGROUND_COLOR_BOUNDS = (1, 10)
MAX_ATTEMPTS = 300  # Solver-oracle retry budget.


def _gen_expected_output(grid: np.ndarray) -> np.ndarray:
    slot_count = int(np.sum(grid == 0))
