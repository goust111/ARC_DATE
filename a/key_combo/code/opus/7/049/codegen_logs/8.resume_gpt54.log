+            if r1 == r2:
+                dist = abs(c1 - c2)
+                if dist == 0 or dist % 2:
+                    continue
+                lo, hi = sorted((c1, c2))
+                if any((r1, cc) in blue_set for cc in range(lo + 1, hi)):
+                    continue
+                edges.append((i, j))
+            elif c1 == c2:
+                dist = abs(r1 - r2)
+                if dist == 0 or dist % 2:
+                    continue
