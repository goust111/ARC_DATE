+def _paste_sprite(dst: np.ndarray, sprite: np.ndarray, center: tuple[int, int]) -> None:
+    r0 = int(center[0]) - 1
+    c0 = int(center[1]) - 1
+    mask = sprite != BLACK
+    dst[r0 : r0 + 3, c0 : c0 + 3][mask] = sprite[mask]
