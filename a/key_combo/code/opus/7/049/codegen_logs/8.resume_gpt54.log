+                        continue
+                    if a in {(r0, c0) for r0 in range(sprite_box[0], sprite_box[2] + 1) for c0 in range(sprite_box[1], sprite_box[3] + 1)}:
+                        continue
+                    if b in {(r0, c0) for r0 in range(sprite_box[0], sprite_box[2] + 1) for c0 in range(sprite_box[1], sprite_box[3] + 1)}:
+                        continue
