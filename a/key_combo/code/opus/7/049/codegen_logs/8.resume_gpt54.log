+    sprite = _find_sprite(g)
+    pair_count = int(np.count_nonzero(sprite != BLACK))
+    blue_pairs = _unique_blue_pairs(g, pair_count)
+
+    out = g.copy()
+    for (r1, c1), (r2, c2) in blue_pairs:
+        center = ((r1 + r2) // 2, (c1 + c2) // 2)
+        _paste_sprite(out, sprite, center)
+    return out
