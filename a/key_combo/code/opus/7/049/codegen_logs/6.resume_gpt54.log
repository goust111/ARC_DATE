+    return out
+
+
+def _add_noise(
+    grid: np.ndarray,
+    ring_colors: list[int],
+    offsets: list[tuple[int, int]],
+) -> bool:
+    size = grid.shape[0]
+    ring_cells = set().union(*(_ring_cells(offset, grid.shape) for offset in offsets))
+    noise_count = random.randint(*NOISE_COUNT_RANGE)
+    chosen_positions: list[tuple[int, int]] = []
+
+    candidates = [
+        (r, c)
+        for r in range(size)
+        for c in range(size)
