# Color and bbox sampling.
N_COLORS_MIN, N_COLORS_MAX = 3, 5
COLOR_MIN, COLOR_MAX = 1, 9
BBOX_HEIGHT_MIN, BBOX_HEIGHT_MAX = 1, 6
BBOX_WIDTH_MIN, BBOX_WIDTH_MAX = 4, 12

