+    for _ in range(_GEN_PAIR_ATTEMPTS):
+        center1 = centers1[int(rng.integers(len(centers1)))]
+        center2 = centers2[int(rng.integers(len(centers2)))]
+        if center1 == center2:
+            continue
+        if _chebyshev(center1, center2) <= min(d1, d2):
+            continue
