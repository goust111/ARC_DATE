+def _candidate_centers(shape: tuple[int, int], d: int) -> list[tuple[int, int]]:
+    height, width = map(int, shape)
+    pad = 2 * int(d)
+    return [
+        (r, c)
+        for r in range(pad, height - pad)
+        for c in range(pad, width - pad)
