def _gen_padded_bounds(
    shape: tuple[int, int], r0: int, c0: int, r1: int, c1: int, pad: int
) -> tuple[int, int, int, int]:
    rows, cols = shape
    return (
        max(0, r0 - pad),
        max(0, c0 - pad),
        min(rows - 1, r1 + pad),
        min(cols - 1, c1 + pad),
    )


