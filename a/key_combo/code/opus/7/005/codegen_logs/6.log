+    outer_b = coords[j]
+    center = coords[3 - i - j]
+
+    assert outer_a[0] + outer_b[0] == 2 * center[0]
+    assert outer_a[1] + outer_b[1] == 2 * center[1]
+
+    dr = outer_a[0] - center[0]
+    dc = outer_a[1] - center[1]
