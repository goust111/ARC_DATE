+
+def _spec(center: tuple[int, int], d: int, slope: int, color: int) -> dict[str, object]:
+    return {
+        "center": tuple(map(int, center)),
+        "d": int(d),
+        "slope": 1 if int(slope) >= 0 else -1,
+        "color": int(color),
+        "seeds": _seed_coords(center, d, slope),
