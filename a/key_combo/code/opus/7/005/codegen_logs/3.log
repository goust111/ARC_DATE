+def _coords_with_padding(coords: list[tuple[int, int]] | tuple[tuple[int, int], ...], shape: tuple[int, int], pad: int) -> set[tuple[int, int]]:
+    h, w = map(int, shape)
+    out = set()
+    for r, c in coords:
+        for dr in range(-pad, pad + 1):
+            for dc in range(-pad, pad + 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < h and 0 <= cc < w:
+                    out.add((rr, cc))
+    return out
