+            sprite_coords = candidate["sprite_coords"]
+            grey_coords = candidate["grey_coords"]
+            moved_coords = candidate["moved_coords"]
+            mirrored_coords = candidate["mirrored_coords"]
+            sweep = _sweep_coords(sprite_coords, moved_coords)
