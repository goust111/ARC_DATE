+        occupied_input |= set(sprite_coords) | set(grey_coords)
+        reserved_input |= _coords_with_padding(sprite_coords + grey_coords, (h, w), pad=1)
+        occupied_output |= set(moved_coords) | set(mirrored_coords)
+        occupied_sweeps |= sweep
