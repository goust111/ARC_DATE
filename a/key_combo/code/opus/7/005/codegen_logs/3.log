+            ar, ac = anchor["anchor_center"]
+            dists.append(((sr - ar) ** 2 + (sc - ac) ** 2, idx))
+        dists.sort()
+        if matches[sprite["signature"]] != dists[0][1]:
+            return True
+    return False
