+    matches = {}
+    assignments = []
+    for idx, anchor in enumerate(anchors):
+        sig = anchor["indicator_signature"]
+        if sig not in sprite_by_sig or sig in matches:
+            return False
+        matches[sig] = idx
+        assignments.append((sprite_by_sig[sig], anchor))
