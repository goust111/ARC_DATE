+def _has_solid_2x2(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if bool(mask[r : r + 2, c : c + 2].all()):
+                return True
+    return False
