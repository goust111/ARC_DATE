+                "bbox": (r0, c0, r1, c1),
+                "center": ((r0 + r1) / 2.0, (c0 + c1) / 2.0),
+                "signature": sig,
+            }
+        )
+    return out
+
+
+def _parse_anchor_component(comp: dict) -> dict:
