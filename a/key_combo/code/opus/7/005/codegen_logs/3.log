+
+def _slide_sprite(sprite: dict, anchor: dict, direction: str) -> tuple[list[tuple[int, int]], str]:
+    coords = list(sprite["coords"])
+    ar, ac, _ar1, _ac1 = anchor["anchor_bbox"]
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    if direction == "right":
