+    arr = arr - np.array([r0, c0], dtype=int)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    mask = np.zeros((h, w), dtype=bool)
+    mask[arr[:, 0], arr[:, 1]] = True
+    assert not _has_solid_2x2(mask)
+    return {
+        "coords": tuple(sorted((int(r), int(c)) for r, c in arr)),
+        "mask": mask,
