+        cc = int(c)
+        yellow_rows.setdefault(rr, []).append(cc)
+        yellow_cols.setdefault(cc, []).append(rr)
+
+    for values in yellow_rows.values():
+        values.sort()
+    for values in yellow_cols.values():
+        values.sort()
+
