+def _paint_horizontal_ray(grid: np.ndarray, r: int, c: int) -> None:
+    _, width = grid.shape
+    for dc in (-1, 1):
+        cc = c + dc
+        while 0 <= cc < width:
+            if grid[r, cc] != BLACK:
+                break
+            grid[r, cc] = GREEN
+            cc += dc
