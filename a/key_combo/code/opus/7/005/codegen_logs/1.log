+        distances = [abs(pos - ref) for ref in refs]
+        best = min(distances)
+        if distances.count(best) != 1 or best < 2:
+            continue
+        target = refs[distances.index(best)]
+        if pos < refs[0]:
+            relation = "outer_low"
+        elif pos > refs[-1]:
+            relation = "outer_high"
+        else:
+            relation = "between"
+        direction = "low" if target < pos else "high"
+        out.append(
+            {
+                "pos": int(pos),
+                "target": int(target),
+                "distance": int(best),
+                "direction": direction,
+                "relation": relation,
+            }
+        )
