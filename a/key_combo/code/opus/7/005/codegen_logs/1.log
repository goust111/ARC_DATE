+def _paint_horizontal_ray(grid: np.ndarray, r: int, c: int) -> None:
+    _, width = grid.shape
+    for dc in (-1, 1):
+        cc = c + dc
+        while 0 <= cc < width:
+            if grid[r, cc] != BLACK:
+                break
+            grid[r, cc] = GREEN
+            cc += dc
+
+
+def _paint_vertical_ray(grid: np.ndarray, r: int, c: int) -> None:
+    height, _ = grid.shape
+    for dr in (-1, 1):
+        rr = r + dr
+        while 0 <= rr < height:
+            value = int(grid[rr, c])
+            if value == BLACK:
+                grid[rr, c] = GREEN
+            elif value == GREEN:
+                grid[rr, c] = YELLOW
+            else:
+                break
+            rr += dr
+
+
