+def _paint_vertical_ray(grid: np.ndarray, r: int, c: int) -> None:
+    height, _ = grid.shape
+    for dr in (-1, 1):
+        rr = r + dr
+        while 0 <= rr < height:
+            value = int(grid[rr, c])
+            if value == BLACK:
