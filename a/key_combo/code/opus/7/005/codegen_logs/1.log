+    winners = [int(choice) for choice, dist in zip(choices, distances) if dist == best]
+    assert len(winners) == 1, "nearest spine point must be unique"
+    return winners[0]
+
+
+def _paint_horizontal_ray(grid: np.ndarray, r: int, c: int) -> None:
+    _, width = grid.shape
+    for dc in (-1, 1):
+        cc = c + dc
+        while 0 <= cc < width:
+            if grid[r, cc] != BLACK:
+                break
+            grid[r, cc] = GREEN
+            cc += dc
+
+
+def _paint_vertical_ray(grid: np.ndarray, r: int, c: int) -> None:
+    height, _ = grid.shape
+    for dr in (-1, 1):
+        rr = r + dr
+        while 0 <= rr < height:
+            value = int(grid[rr, c])
+            if value == BLACK:
+                grid[rr, c] = GREEN
+            elif value == GREEN:
+                grid[rr, c] = YELLOW
+            else:
+                break
+            rr += dr
+
+
+def _extract_sources(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    reds = [tuple(map(int, coord)) for coord in np.argwhere(grid == RED)]
+    blues = [tuple(map(int, coord)) for coord in np.argwhere(grid == BLUE)]
+    assert reds and blues, "input must contain red and blue control pixels"
+    return reds, blues
+
+
+def _spine_from_rays(grid: np.ndarray) -> np.ndarray:
+    work = np.asarray(grid, dtype=int).copy()
+    reds, blues = _extract_sources(work)
+
+    for r, c in sorted(reds, key=lambda rc: (rc[0], rc[1])):
+        _paint_horizontal_ray(work, r, c)
+    for r, c in sorted(blues, key=lambda rc: (rc[1], rc[0])):
+        _paint_vertical_ray(work, r, c)
+
+    return work == YELLOW
+
+
+def _apply_connections(
+    base: np.ndarray,
+    reds: list[tuple[int, int]],
+    blues: list[tuple[int, int]],
+    spine: np.ndarray,
+) -> np.ndarray:
+    out = np.asarray(base, dtype=int).copy()
+    yellow_rows: dict[int, list[int]] = {}
+    yellow_cols: dict[int, list[int]] = {}
+
+    for r, c in np.argwhere(spine):
+        rr = int(r)
+        cc = int(c)
+        yellow_rows.setdefault(rr, []).append(cc)
+        yellow_cols.setdefault(cc, []).append(rr)
+
+    for values in yellow_rows.values():
+        values.sort()
+    for values in yellow_cols.values():
+        values.sort()
+
+    for r, c in reds:
+        candidates = yellow_rows.get(int(r), [])
+        if not candidates:
+            continue
+        target_c = _unique_nearest(c, candidates)
+        step = 1 if target_c > c else -1
+        for cc in range(c + step, target_c, step):
+            if out[r, cc] == BLACK:
+                out[r, cc] = RED
+
+    for r, c in blues:
+        candidates = yellow_cols.get(int(c), [])
+        if not candidates:
+            continue
+        target_r = _unique_nearest(r, candidates)
+        step = 1 if target_r > r else -1
+        for rr in range(r + step, target_r, step):
+            if out[rr, c] == BLACK:
+                out[rr, c] = BLUE
+
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Emerge a yellow spine from red horizontal rays and blue vertical rays, then orthogonally link the controls to that spine.
+
+    Input structure:
+    - A black background contains 3-5 red single pixels and 3-5 blue single pixels.
+    - Red pixels have distinct row coordinates; blue pixels have distinct column coordinates.
+    - No red pixel shares a row or column with any blue pixel, so ray crossings happen only on blank cells.
+
+    Rule:
+    - Extend green rays left and right from each red pixel until the boundary or a non-background cell.
+    - Then extend green rays up and down from each blue pixel; when a vertical ray passes through green, recolor that cell yellow as a crossing, otherwise stop at non-background cells.
+    - Delete every non-crossing green cell, keep only the yellow crossings as the emerged spine, and connect each original red or blue pixel straight to its uniquely nearest yellow spine point on the same row or column.
+
+    Key insight:
+    - The yellow structure is not given in the input: it is the set of ray intersections, and the final colored links depend on that emergent spine rather than on any pre-marked target.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    reds, blues = _extract_sources(g)
+    spine = _spine_from_rays(g)
+
+    out = np.full(g.shape, BLACK, dtype=int)
+    out[spine] = YELLOW
+    for r, c in reds:
+        out[r, c] = RED
+    for r, c in blues:
+        out[r, c] = BLUE
+
+    return _apply_connections(out, reds, blues, spine)
+
+
+def _chebyshev_adjacent(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(abs(int(a[0]) - int(b[0])), abs(int(a[1]) - int(b[1]))) <= 1
+
+
+def _sample_spaced_positions(length: int, count: int) -> list[int] | None:
+    min_gap = 3 if length >= 18 else 2
+    candidates = list(range(length))
+    for _ in range(300):
+        picks = sorted(random.sample(candidates, count))
+        if all(b - a >= min_gap for a, b in zip(picks, picks[1:])):
+            return picks
+    return None
+
+
+def _axis_candidates(length: int, refs: list[int]) -> list[dict[str, int | str]]:
+    out: list[dict[str, int | str]] = []
+    for pos in range(length):
+        if pos in refs:
+            continue
+        distances = [abs(pos - ref) for ref in refs]
+        best = min(distances)
+        if distances.count(best) != 1 or best < 2:
+            continue
+        target = refs[distances.index(best)]
+        if pos < refs[0]:
+            relation = "outer_low"
+        elif pos > refs[-1]:
+            relation = "outer_high"
+        else:
+            relation = "between"
+        direction = "low" if target < pos else "high"
+        out.append(
+            {
+                "pos": int(pos),
+                "target": int(target),
+                "distance": int(best),
+                "direction": direction,
+                "relation": relation,
+            }
+        )
+    return out
+
+
+def _sample_other_positions(
+    candidates: list[dict[str, int | str]],
+    count: int,
+) -> list[int] | None:
+    if len(candidates) < count:
+        return None
+
+    all_directions = {str(item["direction"]) for item in candidates}
+    has_between = any(str(item["relation"]) == "between" for item in candidates)
+    has_outer = any(str(item["relation"]) != "between" for item in candidates)
+
+    for _ in range(500):
+        chosen = random.sample(candidates, count)
+        positions = sorted(int(item["pos"]) for item in chosen)
+        if any(b - a < 2 for a, b in zip(positions, positions[1:])):
+            continue
+        if len({int(item["target"]) for item in chosen}) < 2:
+            continue
+        if len(all_directions) >= 2 and len({str(item["direction"]) for item in chosen}) < 2:
+            continue
+        if count >= 3 and has_between and not any(str(item["relation"]) == "between" for item in chosen):
+            continue
+        if count >= 3 and has_outer and not any(str(item["relation"]) != "between" for item in chosen):
+            continue
+        return positions
+    return None
+
+
+def _sample_axis(length: int, ref_count: int, other_count: int) -> tuple[list[int], list[int]] | None:
+    for _ in range(400):
+        refs = _sample_spaced_positions(length, ref_count)
+        if refs is None:
+            continue
+        others = _sample_other_positions(_axis_candidates(length, refs), other_count)
+        if others is not None:
+            return refs, others
+    return None
+
+
+def _pair_positions(
+    red_rows: list[int],
+    red_cols: list[int],
+    blue_rows: list[int],
+    blue_cols: list[int],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
+    for _ in range(400):
+        r_cols = red_cols[:]
+        b_rows = blue_rows[:]
+        random.shuffle(r_cols)
+        random.shuffle(b_rows)
+        reds = list(zip(red_rows, r_cols))
+        blues = list(zip(b_rows, blue_cols))
+        points = reds + blues
+        if all(
+            not _chebyshev_adjacent(points[i], points[j])
+            for i in range(len(points))
+            for j in range(i + 1, len(points))
+        ):
+            return reds, blues
+    return None
+
+
+def _expected_from_sources(
+    shape: tuple[int, int],
+    reds: list[tuple[int, int]],
+    blues: list[tuple[int, int]],
+) -> np.ndarray:
+    out = np.full(shape, BLACK, dtype=int)
+    red_rows = sorted({int(r) for r, _ in reds})
+    blue_cols = sorted({int(c) for _, c in blues})
+
+    for r in red_rows:
+        for c in blue_cols:
+            out[r, c] = YELLOW
+
+    for r, c in reds:
+        target_c = _unique_nearest(c, blue_cols)
+        step = 1 if target_c > c else -1
+        for cc in range(c + step, target_c, step):
+            out[r, cc] = RED
+    for r, c in blues:
+        target_r = _unique_nearest(r, red_rows)
+        step = 1 if target_r > r else -1
+        for rr in range(r + step, target_r, step):
+            assert out[rr, c] == BLACK, "connection interiors should not overlap"
+            out[rr, c] = BLUE
+
+    for r, c in reds:
+        out[r, c] = RED
+    for r, c in blues:
+        out[r, c] = BLUE
+    for r in red_rows:
+        for c in blue_cols:
+            out[r, c] = YELLOW
+
+    return out
+
+
+def _validate_generated_case(grid: np.ndarray) -> bool:
+    reds, blues = _extract_sources(grid)
+    if not (MIN_COUNT <= len(reds) <= MAX_COUNT and MIN_COUNT <= len(blues) <= MAX_COUNT):
+        return False
+
+    red_rows = [int(r) for r, _ in reds]
+    blue_rows = [int(r) for r, _ in blues]
+    red_cols = [int(c) for _, c in reds]
+    blue_cols = [int(c) for _, c in blues]
+
+    if len(set(red_rows)) != len(red_rows):
+        return False
+    if len(set(blue_cols)) != len(blue_cols):
+        return False
+    if set(red_rows) & set(blue_rows):
+        return False
+    if set(red_cols) & set(blue_cols):
+        return False
+    if any(_chebyshev_adjacent(a, b) for i, a in enumerate(reds + blues) for b in (reds + blues)[i + 1 :]):
+        return False
+    if len(reds) * len(blues) < 2:
+        return False
+
+    try:
+        red_targets = [_unique_nearest(c, blue_cols) for _, c in reds]
+        blue_targets = [_unique_nearest(r, red_rows) for r, _ in blues]
+    except AssertionError:
+        return False
+
+    if min(abs(c - t) for (_, c), t in zip(reds, red_targets)) < 2:
+        return False
+    if min(abs(r - t) for (r, _), t in zip(blues, blue_targets)) < 2:
+        return False
+    if len(set(red_targets)) < 2 or len(set(blue_targets)) < 2:
+        return False
+    if len({("left" if t < c else "right") for (_, c), t in zip(reds, red_targets)}) < 2:
+        return False
+    if len({("up" if t < r else "down") for (r, _), t in zip(blues, blue_targets)}) < 2:
+        return False
+    if not any(blue_cols[0] < c < blue_cols[-1] for _, c in reds):
+        return False
+    if not any(red_rows[0] < r < red_rows[-1] for r, _ in blues):
+        return False
+
+    expected = _expected_from_sources(grid.shape, reds, blues)
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    return np.array_equal(actual, expected)
+
+
+def _generate_case() -> np.ndarray | None:
+    red_count = random.randint(MIN_COUNT, MAX_COUNT)
+    blue_count = random.randint(MIN_COUNT, MAX_COUNT)
+
+    height = random.randint(max(MIN_SIZE, red_count + blue_count + 4), MAX_SIZE)
+    width = random.randint(max(MIN_SIZE, red_count + blue_count + 4), MAX_SIZE)
+
+    row_data = _sample_axis(height, red_count, blue_count)
+    col_data = _sample_axis(width, blue_count, red_count)
+    if row_data is None or col_data is None:
+        return None
+
+    red_rows, blue_rows = row_data
+    blue_cols, red_cols = col_data
+    paired = _pair_positions(red_rows, red_cols, blue_rows, blue_cols)
+    if paired is None:
+        return None
+
+    reds, blues = paired
+    grid = np.full((height, width), BLACK, dtype=int)
+    for r, c in reds:
+        grid[r, c] = RED
+    for r, c in blues:
+        grid[r, c] = BLUE
+
+    if not _validate_generated_case(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ARC input")

