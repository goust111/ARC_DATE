+    colors: list[int] = []
+    for depth in range(layer_count):
+        vals = np.unique(grid[depths == depth])
+        assert len(vals) == 1, f"layer {depth} must be monochromatic"
+        colors.append(int(vals[0]))
+    return colors
+
+
