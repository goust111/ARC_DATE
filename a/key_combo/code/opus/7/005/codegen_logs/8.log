    """Sample a rectangle count from the target-compatible 2..4 range."""
    feasible_counts = [
        k for k in range(_GEN_MIN_COMPONENTS, _GEN_MAX_COMPONENTS + 1)
        if _GEN_RECT_MIN_AREA * k <= target <= _GEN_RECT_MAX_AREA * k
