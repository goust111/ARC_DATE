+            return None
+
+    if split == "h":
+        cut_min = outer[1] + lw
+        cut_max = outer[3] - rw - 1
+        if cut_min > cut_max:
+            return None
+        cut = random.randint(cut_min, cut_max)
+        containers = [(outer[0], outer[1], outer[2], cut - 1), (outer[0], cut + 1, outer[2], outer[3])]
+    else:
+        cut_min = outer[0] + lh
+        cut_max = outer[2] - rh - 1
+        if cut_min > cut_max:
