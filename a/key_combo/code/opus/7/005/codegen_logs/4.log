+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+ORANGE = 7
+
+DEPTH_TO_RING_COLOR = {1: RED, 2: GREEN, 3: YELLOW}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _component_masks(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    nbrs = _neighbors4 if connectivity == 4 else _neighbors8
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = np.zeros_like(mask, dtype=bool)
+            comp[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in nbrs(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        comp[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _flood_from_boundary(passable: np.ndarray) -> np.ndarray:
+    height, width = passable.shape
+    seen = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(height):
+        for c in (0, width - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(width):
+        for r in (0, height - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
+
+def _compute_ring_interior_domain(ring_mask: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(ring_mask)
+    r0 = max(0, r0 - 1)
+    c0 = max(0, c0 - 1)
+    r1 = min(ring_mask.shape[0] - 1, r1 + 1)
+    c1 = min(ring_mask.shape[1] - 1, c1 + 1)
+    local_ring = ring_mask[r0 : r1 + 1, c0 : c1 + 1]
+    passable = ~local_ring
+    outside = _flood_from_boundary(passable)
+    interior_local = passable & ~outside
+    comps = _component_masks(interior_local, connectivity=4)
+    assert len(comps) == 1 and interior_local.any(), "each ring must enclose one interior domain"
+    interior = np.zeros_like(ring_mask, dtype=bool)
+    interior[r0 : r1 + 1, c0 : c1 + 1] = interior_local
+    return interior
+
+
+def _boundary_of_filled(filled: np.ndarray) -> np.ndarray:
+    height, width = filled.shape
+    out = np.zeros_like(filled, dtype=bool)
+    for r, c in np.argwhere(filled):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if not _in_bounds(filled.shape, nr, nc) or not filled[nr, nc]:
+                out[rr, cc] = True
+                break
+    return out
+
+
+def _analyze_rings(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    assert bg == BLACK, "expected black background"
+    colors = sorted(set(map(int, g.ravel())) - {bg})
+    assert colors == [BLUE], "expected only blue rings"
+
+    ring_components = _component_masks(g == BLUE, connectivity=4)
+    assert 3 <= len(ring_components) <= 5, "expected 3-5 rings"
+
+    rings: list[dict] = []
+    for idx, ring_mask in enumerate(ring_components):
+        interior = _compute_ring_interior_domain(ring_mask)
+        rings.append(
+            {
+                "id": idx,
+                "mask": ring_mask,
+                "coords": np.argwhere(ring_mask),
+                "interior": interior,
+            }
+        )
+
+    for ring in rings:
+        containers = []
+        for other in rings:
+            if other["id"] == ring["id"]:
+                continue
+            coords = ring["coords"]
+            inside = other["interior"][coords[:, 0], coords[:, 1]]
+            if bool(np.any(inside)):
+                assert bool(np.all(inside)), "containment must be all-or-nothing"
+                containers.append(other["id"])
+        ring["depth"] = 1 + len(containers)
+        assert ring["depth"] in DEPTH_TO_RING_COLOR, "nesting depth must be at most 3"
+
+    depths = {int(r["depth"]) for r in rings}
+    assert 1 in depths and 2 in depths, "scene must contain both odd and even depths"
+    return rings
+
+
+def _render_output_from_rings(input_grid: np.ndarray, rings: list[dict]) -> np.ndarray:
+    out = np.zeros_like(input_grid)
+    for ring in rings:
+        out[ring["mask"]] = DEPTH_TO_RING_COLOR[int(ring["depth"])]
+
+    for ring in sorted(rings, key=lambda item: int(item["depth"]), reverse=True):
+        depth = int(ring["depth"])
+        paint_inside = depth % 2 == 0
+        outline_color = ORANGE if paint_inside else GRAY
+        for r, c in ring["coords"]:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in _neighbors8(rr, cc):
+                if not _in_bounds(input_grid.shape, nr, nc):
+                    continue
+                if int(input_grid[nr, nc]) != BLACK or int(out[nr, nc]) != BLACK:
+                    continue
+                in_hole = bool(ring["interior"][nr, nc])
+                if in_hole == paint_inside:
+                    out[nr, nc] = outline_color
+    return out
+
+
+def main(input_grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each blue ring by its nesting depth and draw only the depth-selected side of its outline.
+
+    Input structure:
+    - The grid is a black background containing 3-5 blue 4-connected closed rings.
+    - Every ring is a one-pixel-thick contour enclosing one geometric interior region.
+    - Some rings lie inside the interior of other rings, creating 2-3 nesting levels.
+
+    Rule:
+    - Infer each ring's depth from containment: depth 1 rings are not inside any other ring, depth 2 rings are inside one ring, and depth 3 rings are inside two rings.
+    - Recolor the ring body by depth: 1 -> red, 2 -> green, 3 -> yellow.
+    - Process rings from deepest to shallowest; odd depths paint gray on black cells that are 8-neighbors on the outside of the ring, while even depths paint orange on black cells that are 8-neighbors on the inside of the ring.
+    - If a candidate outline cell was already painted by a deeper ring, keep the earlier color.
+
+    Key insight:
+    - All input rings look identical in color, so the only way to decide both the recolor and which side gets outlined is to recover the nesting relation from enclosed space rather than from size or distance.
+    """
+    g = np.asarray(input_grid, dtype=int)
+    rings = _analyze_rings(g)
+    return _render_output_from_rings(g, rings)
+
+
+def _shift_mask(local_mask: np.ndarray, shape: tuple[int, int], r0: int, c0: int) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    h, w = local_mask.shape
+    out[r0 : r0 + h, c0 : c0 + w] = local_mask
+    return out
+
+
+def _dilate8(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    for dr in range(-radius, radius + 1):
+        for dc in range(-radius, radius + 1):
+            src_r0 = max(0, -dr)
+            src_r1 = min(mask.shape[0], mask.shape[0] - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(mask.shape[1], mask.shape[1] - dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = min(mask.shape[0], mask.shape[0] + dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = min(mask.shape[1], mask.shape[1] + dc)
+            out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[src_r0:src_r1, src_c0:src_c1]
+    return out
+
+
+def _erode8(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    out = mask.copy()
+    for dr in range(-radius, radius + 1):
+        for dc in range(-radius, radius + 1):
+            shifted = np.zeros_like(mask, dtype=bool)
+            src_r0 = max(0, -dr)
+            src_r1 = min(mask.shape[0], mask.shape[0] - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(mask.shape[1], mask.shape[1] - dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = min(mask.shape[0], mask.shape[0] + dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = min(mask.shape[1], mask.shape[1] + dc)
+            shifted[dst_r0:dst_r1, dst_c0:dst_c1] = mask[src_r0:src_r1, src_c0:src_c1]
+            out &= shifted
+    return out
+
+
+def _mask_component_count(mask: np.ndarray, connectivity: int = 4) -> int:
+    return len(_component_masks(mask, connectivity=connectivity))
+
+
+def _make_filled_shape(max_h: int, max_w: int, has_children: bool) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    min_core = 8 if has_children else 5
+    min_domain_area = 30 if has_children else 9
+    if max_h < min_core or max_w < min_core:
+        return None
+
+    for _ in range(80):
+        core_h = random.randint(min_core, min(max_h, 12 if has_children else 9))
+        core_w = random.randint(min_core, min(max_w, 12 if has_children else 9))
+        slack_h = max_h - core_h
+        slack_w = max_w - core_w
+
+        top_ext = random.randint(0, min(2, slack_h))
+        bottom_ext = random.randint(0, min(2, slack_h - top_ext))
+        left_ext = random.randint(0, min(2, slack_w))
+        right_ext = random.randint(0, min(2, slack_w - left_ext))
+
+        height = core_h + top_ext + bottom_ext
+        width = core_w + left_ext + right_ext
+        filled = np.zeros((height, width), dtype=bool)
+        r0 = top_ext
+        c0 = left_ext
+        filled[r0 : r0 + core_h, c0 : c0 + core_w] = True
+
+        bump_budget = 0
+        for side, ext in (("top", top_ext), ("bottom", bottom_ext), ("left", left_ext), ("right", right_ext)):
+            if ext > 0 and random.random() < 0.75:
+                bump_budget += 1
+                if side in ("top", "bottom"):
+                    span = random.randint(2, core_w - 2)
+                    start = random.randint(1, core_w - span - 1)
+                    rr0 = 0 if side == "top" else r0 + core_h
+                    rr1 = top_ext if side == "top" else height
+                    cc0 = c0 + start
+                    cc1 = cc0 + span
+                else:
+                    span = random.randint(2, core_h - 2)
+                    start = random.randint(1, core_h - span - 1)
+                    cc0 = 0 if side == "left" else c0 + core_w
+                    cc1 = left_ext if side == "left" else width
+                    rr0 = r0 + start
+                    rr1 = rr0 + span
+                filled[rr0:rr1, cc0:cc1] = True
+
+        if bump_budget == 0 and random.random() < 0.55:
+            continue
+
+        ring = _boundary_of_filled(filled)
+        domain = filled & ~ring
+        if not domain.any():
+            continue
+        if _mask_component_count(ring, connectivity=4) != 1:
+            continue
+        if _mask_component_count(domain, connectivity=4) != 1:
+            continue
+        if int(domain.sum()) < min_domain_area:
+            continue
+        return filled, ring, domain
+    return None
+
+
+def _candidate_positions(allowed: np.ndarray, local_filled: np.ndarray, local_ring: np.ndarray, occupied_halo: np.ndarray):
+    height, width = allowed.shape
+    ph, pw = local_filled.shape
+    filled_coords = np.argwhere(local_filled)
+    ring_coords = np.argwhere(local_ring)
+    positions = []
+    for r0 in range(height - ph + 1):
+        for c0 in range(width - pw + 1):
+            ok = True
+            for rr, cc in filled_coords:
+                if not allowed[r0 + int(rr), c0 + int(cc)]:
+                    ok = False
+                    break
+            if not ok:
+                continue
+            for rr, cc in ring_coords:
+                if occupied_halo[r0 + int(rr), c0 + int(cc)]:
+                    ok = False
+                    break
+            if ok:
+                positions.append((r0, c0))
+    return positions
+
+
+def _node_specs() -> list[dict]:
+    if random.random() < 0.65:
+        root0 = {"children": [{"children": [{"children": []}]}]}
+        root1 = {"children": []}
+        roots = [root0, root1]
+        if random.random() < 0.55:
+            root1["children"].append({"children": []})
+        return roots
+
+    roots = [{"children": []}, {"children": []}]
+    total = random.randint(3, 5)
+    remaining = total - len(roots)
+    roots[random.randrange(len(roots))]["children"].append({"children": []})
+    remaining -= 1
+    while remaining > 0:
+        choice = random.choice(roots)
+        if len(choice["children"]) < 2 and random.random() < 0.7:
+            choice["children"].append({"children": []})
+        else:
+            roots.append({"children": []})
+        remaining -= 1
+    return roots
+
+
+def _flatten_nodes(nodes: list[dict], depth: int = 1) -> list[dict]:
+    flat = []
+    for node in nodes:
+        node["depth"] = depth
+        flat.append(node)
+        flat.extend(_flatten_nodes(node["children"], depth + 1))
+    return flat
+
+
+def _place_subtree(
+    node: dict,
+    allowed: np.ndarray,
+    occupied_blue: np.ndarray,
+    canvas_shape: tuple[int, int],
+) -> bool:
+    max_h = min(allowed.shape[0], max(5, _bbox(allowed)[2] - _bbox(allowed)[0] + 1)) if allowed.any() else 0
+    max_w = min(allowed.shape[1], max(5, _bbox(allowed)[3] - _bbox(allowed)[1] + 1)) if allowed.any() else 0
+    has_children = bool(node["children"])
+    if not allowed.any():
+        return False
+
+    for _ in range(80):
+        patch = _make_filled_shape(max_h=max_h, max_w=max_w, has_children=has_children)
+        if patch is None:
+            return False
+        local_filled, local_ring, local_domain = patch
+        occupied_halo = _dilate8(occupied_blue, radius=1)
+        positions = _candidate_positions(allowed, local_filled, local_ring, occupied_halo)
+        if not positions:
+            continue
+        random.shuffle(positions)
+        for r0, c0 in positions[:40]:
+            ring_mask = _shift_mask(local_ring, canvas_shape, r0, c0)
+            domain_mask = _shift_mask(local_domain, canvas_shape, r0, c0)
+            filled_mask = _shift_mask(local_filled, canvas_shape, r0, c0)
+            node["ring_mask"] = ring_mask
+            node["ring_coords"] = np.argwhere(ring_mask)
+            node["domain_mask"] = filled_mask & ~ring_mask
+            snapshot = occupied_blue.copy()
+            occupied_blue |= ring_mask
+            child_allowed = _erode8(node["domain_mask"], radius=1) & ~_dilate8(occupied_blue, radius=1)
+            ok = True
+            for child in sorted(node["children"], key=lambda item: len(_flatten_nodes([item])), reverse=True):
+                if not _place_subtree(child, child_allowed.copy(), occupied_blue, canvas_shape):
+                    ok = False
+                    break
+                child_allowed &= ~_dilate8(child["ring_mask"] | child["domain_mask"], radius=1)
+            if ok:
+                return True
+            occupied_blue[:] = snapshot
+        continue
+    return False
+
+
+def _build_scene() -> tuple[np.ndarray, list[dict], np.ndarray] | None:
+    roots = _node_specs()
+    flat = _flatten_nodes(roots)
+    max_depth = max(int(node["depth"]) for node in flat)
+    total = len(flat)
+    grid_h = random.randint(22 if max_depth == 3 else 18, 28)
+    grid_w = random.randint(22 if total >= 4 else 18, 28)
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    allowed = np.zeros_like(grid, dtype=bool)
+    allowed[1:-1, 1:-1] = True
+    occupied = np.zeros_like(grid, dtype=bool)
+
+    for root in sorted(roots, key=lambda item: len(_flatten_nodes([item])), reverse=True):
+        if not _place_subtree(root, allowed.copy(), occupied, grid.shape):
+            return None
+        allowed &= ~_dilate8(root["ring_mask"] | root["domain_mask"], radius=1)
+
+    nodes = _flatten_nodes(roots)
+    for node in nodes:
+        grid[node["ring_mask"]] = BLUE
+
+    expected = np.zeros_like(grid)
+    for node in nodes:
+        expected[node["ring_mask"]] = DEPTH_TO_RING_COLOR[int(node["depth"])]
+    nodes_by_depth = sorted(nodes, key=lambda item: int(item["depth"]), reverse=True)
+    for node in nodes_by_depth:
+        paint_inside = int(node["depth"]) % 2 == 0
+        outline_color = ORANGE if paint_inside else GRAY
+        for r, c in node["ring_coords"]:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in _neighbors8(rr, cc):
+                if not _in_bounds(grid.shape, nr, nc) or grid[nr, nc] != BLACK or expected[nr, nc] != BLACK:
+                    continue
+                if bool(node["domain_mask"][nr, nc]) == paint_inside:
+                    expected[nr, nc] = outline_color
+    return grid, nodes, expected
+
+
+def _validate_scene(grid: np.ndarray, nodes: list[dict], expected: np.ndarray) -> bool:
+    try:
+        derived = _analyze_rings(grid)
+        actual = main(grid)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+
+    depth_by_mask = {}
+    for ring in derived:
+        depth_by_mask[ring["mask"].tobytes()] = int(ring["depth"])
+    planned_depths = []
+    actual_depths = []
+    for node in nodes:
+        key = node["ring_mask"].tobytes()
+        if key not in depth_by_mask:
+            return False
+        planned_depths.append(int(node["depth"]))
+        actual_depths.append(depth_by_mask[key])
+    if sorted(planned_depths) != sorted(actual_depths):
+        return False
+
+    odd_count = sum(depth % 2 == 1 for depth in planned_depths)
+    even_count = sum(depth % 2 == 0 for depth in planned_depths)
+    if odd_count == 0 or even_count == 0:
+        return False
+
+    if len(set(planned_depths)) < 2:
+        return False
+    if int((grid == BLUE).sum()) <= 20:
+        return False
+    if np.unique(expected).size < 4:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        built = _build_scene()
+        if built is None:
+            continue
+        grid, nodes, expected = built
+        if max(grid.shape) > 30 or max(expected.shape) > 30:
+            continue
+        if _validate_scene(grid, nodes, expected):
+            return grid
+    raise RuntimeError("failed to generate a valid nested-ring ARC input")

diff --git a//home/lixinyu/snap/a/key_combo/code/opus/7/005/4.py b//home/lixinyu/snap/a/key_combo/code/opus/7/005/4.py
new file mode 100644
index 0000000000000000000000000000000000000000..fb0b849febb07800fd57550d4dce77fdf92eeb2b
--- /dev/null
+++ b//home/lixinyu/snap/a/key_combo/code/opus/7/005/4.py
@@ -0,0 +1,508 @@
+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+ORANGE = 7
+
+DEPTH_TO_RING_COLOR = {1: RED, 2: GREEN, 3: YELLOW}
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _component_masks(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    height, width = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    nbrs = _neighbors4 if connectivity == 4 else _neighbors8
+    for r in range(height):
+        for c in range(width):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = np.zeros_like(mask, dtype=bool)
+            comp[r, c] = True
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in nbrs(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        comp[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _flood_from_boundary(passable: np.ndarray) -> np.ndarray:
+    height, width = passable.shape
+    seen = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(height):
+        for c in (0, width - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(width):
+        for r in (0, height - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(passable.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
+
+
+def _compute_ring_interior_domain(ring_mask: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(ring_mask)
+    r0 = max(0, r0 - 1)
+    c0 = max(0, c0 - 1)
+    r1 = min(ring_mask.shape[0] - 1, r1 + 1)
+    c1 = min(ring_mask.shape[1] - 1, c1 + 1)
+    local_ring = ring_mask[r0 : r1 + 1, c0 : c1 + 1]
+    passable = ~local_ring
+    outside = _flood_from_boundary(passable)
+    interior_local = passable & ~outside
+    comps = _component_masks(interior_local, connectivity=4)
+    assert len(comps) == 1 and interior_local.any(), "each ring must enclose one interior domain"
+    interior = np.zeros_like(ring_mask, dtype=bool)
+    interior[r0 : r1 + 1, c0 : c1 + 1] = interior_local
+    return interior
+
+
+def _boundary_of_filled(filled: np.ndarray) -> np.ndarray:
+    height, width = filled.shape
+    out = np.zeros_like(filled, dtype=bool)
+    for r, c in np.argwhere(filled):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if not _in_bounds(filled.shape, nr, nc) or not filled[nr, nc]:
+                out[rr, cc] = True
+                break
+    return out
+
+
+def _analyze_rings(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _get_bg(g)
+    assert bg == BLACK, "expected black background"
+    colors = sorted(set(map(int, g.ravel())) - {bg})
+    assert colors == [BLUE], "expected only blue rings"
+
+    ring_components = _component_masks(g == BLUE, connectivity=4)
+    assert 3 <= len(ring_components) <= 5, "expected 3-5 rings"
+
+    rings: list[dict] = []
+    for idx, ring_mask in enumerate(ring_components):
+        interior = _compute_ring_interior_domain(ring_mask)
+        rings.append(
+            {
+                "id": idx,
+                "mask": ring_mask,
+                "coords": np.argwhere(ring_mask),
+                "interior": interior,
+            }
+        )
+
+    for ring in rings:
+        containers = []
+        for other in rings:
+            if other["id"] == ring["id"]:
+                continue
+            coords = ring["coords"]
+            inside = other["interior"][coords[:, 0], coords[:, 1]]
+            if bool(np.any(inside)):
+                assert bool(np.all(inside)), "containment must be all-or-nothing"
+                containers.append(other["id"])
+        ring["depth"] = 1 + len(containers)
+        assert ring["depth"] in DEPTH_TO_RING_COLOR, "nesting depth must be at most 3"
+
+    depths = {int(r["depth"]) for r in rings}
+    assert 1 in depths and 2 in depths, "scene must contain both odd and even depths"
+    return rings
+
+
+def _render_output_from_rings(input_grid: np.ndarray, rings: list[dict]) -> np.ndarray:
+    out = np.zeros_like(input_grid)
+    for ring in rings:
+        out[ring["mask"]] = DEPTH_TO_RING_COLOR[int(ring["depth"])]
+
+    for ring in sorted(rings, key=lambda item: int(item["depth"]), reverse=True):
+        depth = int(ring["depth"])
+        paint_inside = depth % 2 == 0
+        outline_color = ORANGE if paint_inside else GRAY
+        for r, c in ring["coords"]:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in _neighbors8(rr, cc):
+                if not _in_bounds(input_grid.shape, nr, nc):
+                    continue
+                if int(input_grid[nr, nc]) != BLACK or int(out[nr, nc]) != BLACK:
+                    continue
+                in_hole = bool(ring["interior"][nr, nc])
+                if in_hole == paint_inside:
+                    out[nr, nc] = outline_color
+    return out
+
+
+def main(input_grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each blue ring by its nesting depth and draw only the depth-selected side of its outline.
+
+    Input structure:
+    - The grid is a black background containing 3-5 blue 4-connected closed rings.
+    - Every ring is a one-pixel-thick contour enclosing one geometric interior region.
+    - Some rings lie inside the interior of other rings, creating 2-3 nesting levels.
+
+    Rule:
+    - Infer each ring's depth from containment: depth 1 rings are not inside any other ring, depth 2 rings are inside one ring, and depth 3 rings are inside two rings.
+    - Recolor the ring body by depth: 1 -> red, 2 -> green, 3 -> yellow.
+    - Process rings from deepest to shallowest; odd depths paint gray on black cells that are 8-neighbors on the outside of the ring, while even depths paint orange on black cells that are 8-neighbors on the inside of the ring.
+    - If a candidate outline cell was already painted by a deeper ring, keep the earlier color.
+
+    Key insight:
+    - All input rings look identical in color, so the only way to decide both the recolor and which side gets outlined is to recover the nesting relation from enclosed space rather than from size or distance.
+    """
+    g = np.asarray(input_grid, dtype=int)
+    rings = _analyze_rings(g)
+    return _render_output_from_rings(g, rings)
+
+
+def _shift_mask(local_mask: np.ndarray, shape: tuple[int, int], r0: int, c0: int) -> np.ndarray:
+    out = np.zeros(shape, dtype=bool)
+    h, w = local_mask.shape
+    out[r0 : r0 + h, c0 : c0 + w] = local_mask
+    return out
+
+
+def _dilate8(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    for dr in range(-radius, radius + 1):
+        for dc in range(-radius, radius + 1):
+            src_r0 = max(0, -dr)
+            src_r1 = min(mask.shape[0], mask.shape[0] - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(mask.shape[1], mask.shape[1] - dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = min(mask.shape[0], mask.shape[0] + dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = min(mask.shape[1], mask.shape[1] + dc)
+            out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[src_r0:src_r1, src_c0:src_c1]
+    return out
+
+
+def _erode8(mask: np.ndarray, radius: int = 1) -> np.ndarray:
+    out = mask.copy()
+    for dr in range(-radius, radius + 1):
+        for dc in range(-radius, radius + 1):
+            shifted = np.zeros_like(mask, dtype=bool)
+            src_r0 = max(0, -dr)
+            src_r1 = min(mask.shape[0], mask.shape[0] - dr)
+            src_c0 = max(0, -dc)
+            src_c1 = min(mask.shape[1], mask.shape[1] - dc)
+            dst_r0 = max(0, dr)
+            dst_r1 = min(mask.shape[0], mask.shape[0] + dr)
+            dst_c0 = max(0, dc)
+            dst_c1 = min(mask.shape[1], mask.shape[1] + dc)
+            shifted[dst_r0:dst_r1, dst_c0:dst_c1] = mask[src_r0:src_r1, src_c0:src_c1]
+            out &= shifted
+    return out
+
+
+def _mask_component_count(mask: np.ndarray, connectivity: int = 4) -> int:
+    return len(_component_masks(mask, connectivity=connectivity))
+
+
+def _make_filled_shape(max_h: int, max_w: int, has_children: bool) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
+    min_core = 8 if has_children else 5
+    min_domain_area = 30 if has_children else 9
+    if max_h < min_core or max_w < min_core:
+        return None
+
+    for _ in range(80):
+        core_h = random.randint(min_core, min(max_h, 12 if has_children else 9))
+        core_w = random.randint(min_core, min(max_w, 12 if has_children else 9))
+        slack_h = max_h - core_h
+        slack_w = max_w - core_w
+
+        top_ext = random.randint(0, min(2, slack_h))
+        bottom_ext = random.randint(0, min(2, slack_h - top_ext))
+        left_ext = random.randint(0, min(2, slack_w))
+        right_ext = random.randint(0, min(2, slack_w - left_ext))
+
+        height = core_h + top_ext + bottom_ext
+        width = core_w + left_ext + right_ext
+        filled = np.zeros((height, width), dtype=bool)
+        r0 = top_ext
+        c0 = left_ext
+        filled[r0 : r0 + core_h, c0 : c0 + core_w] = True
+
+        bump_budget = 0
+        for side, ext in (("top", top_ext), ("bottom", bottom_ext), ("left", left_ext), ("right", right_ext)):
+            if ext > 0 and random.random() < 0.75:
+                bump_budget += 1
+                if side in ("top", "bottom"):
+                    span = random.randint(2, core_w - 2)
+                    start = random.randint(1, core_w - span - 1)
+                    rr0 = 0 if side == "top" else r0 + core_h
+                    rr1 = top_ext if side == "top" else height
+                    cc0 = c0 + start
+                    cc1 = cc0 + span
+                else:
+                    span = random.randint(2, core_h - 2)
+                    start = random.randint(1, core_h - span - 1)
+                    cc0 = 0 if side == "left" else c0 + core_w
+                    cc1 = left_ext if side == "left" else width
+                    rr0 = r0 + start
+                    rr1 = rr0 + span
+                filled[rr0:rr1, cc0:cc1] = True
+
+        if bump_budget == 0 and random.random() < 0.55:
+            continue
+
+        ring = _boundary_of_filled(filled)
+        domain = filled & ~ring
+        if not domain.any():
+            continue
+        if _mask_component_count(ring, connectivity=4) != 1:
+            continue
+        if _mask_component_count(domain, connectivity=4) != 1:
+            continue
+        if int(domain.sum()) < min_domain_area:
+            continue
+        return filled, ring, domain
+    return None
+
+
+def _candidate_positions(allowed: np.ndarray, local_filled: np.ndarray, local_ring: np.ndarray, occupied_halo: np.ndarray):
+    height, width = allowed.shape
+    ph, pw = local_filled.shape
+    filled_coords = np.argwhere(local_filled)
+    ring_coords = np.argwhere(local_ring)
+    positions = []
+    for r0 in range(height - ph + 1):
+        for c0 in range(width - pw + 1):
+            ok = True
+            for rr, cc in filled_coords:
+                if not allowed[r0 + int(rr), c0 + int(cc)]:
+                    ok = False
+                    break
+            if not ok:
+                continue
+            for rr, cc in ring_coords:
+                if occupied_halo[r0 + int(rr), c0 + int(cc)]:
+                    ok = False
+                    break
+            if ok:
+                positions.append((r0, c0))
+    return positions
+
+
+def _node_specs() -> list[dict]:
+    if random.random() < 0.65:
+        root0 = {"children": [{"children": [{"children": []}]}]}
+        root1 = {"children": []}
+        roots = [root0, root1]
+        if random.random() < 0.55:
+            root1["children"].append({"children": []})
+        return roots
+
+    roots = [{"children": []}, {"children": []}]
+    total = random.randint(3, 5)
+    remaining = total - len(roots)
+    roots[random.randrange(len(roots))]["children"].append({"children": []})
+    remaining -= 1
+    while remaining > 0:
+        choice = random.choice(roots)
+        if len(choice["children"]) < 2 and random.random() < 0.7:
+            choice["children"].append({"children": []})
+        else:
+            roots.append({"children": []})
+        remaining -= 1
+    return roots
+
+
+def _flatten_nodes(nodes: list[dict], depth: int = 1) -> list[dict]:
+    flat = []
+    for node in nodes:
+        node["depth"] = depth
+        flat.append(node)
+        flat.extend(_flatten_nodes(node["children"], depth + 1))
+    return flat
+
+
+def _place_subtree(
+    node: dict,
+    allowed: np.ndarray,
+    occupied_blue: np.ndarray,
+    canvas_shape: tuple[int, int],
+) -> bool:
+    max_h = min(allowed.shape[0], max(5, _bbox(allowed)[2] - _bbox(allowed)[0] + 1)) if allowed.any() else 0
+    max_w = min(allowed.shape[1], max(5, _bbox(allowed)[3] - _bbox(allowed)[1] + 1)) if allowed.any() else 0
+    has_children = bool(node["children"])
+    if not allowed.any():
+        return False
+
+    for _ in range(80):
+        patch = _make_filled_shape(max_h=max_h, max_w=max_w, has_children=has_children)
+        if patch is None:
+            return False
+        local_filled, local_ring, local_domain = patch
+        occupied_halo = _dilate8(occupied_blue, radius=1)
+        positions = _candidate_positions(allowed, local_filled, local_ring, occupied_halo)
+        if not positions:
+            continue
+        random.shuffle(positions)
+        for r0, c0 in positions[:40]:
+            ring_mask = _shift_mask(local_ring, canvas_shape, r0, c0)
+            domain_mask = _shift_mask(local_domain, canvas_shape, r0, c0)
+            filled_mask = _shift_mask(local_filled, canvas_shape, r0, c0)
+            node["ring_mask"] = ring_mask
+            node["ring_coords"] = np.argwhere(ring_mask)
+            node["domain_mask"] = filled_mask & ~ring_mask
+            snapshot = occupied_blue.copy()
+            occupied_blue |= ring_mask
+            child_allowed = _erode8(node["domain_mask"], radius=1) & ~_dilate8(occupied_blue, radius=1)
+            ok = True
+            for child in sorted(node["children"], key=lambda item: len(_flatten_nodes([item])), reverse=True):
+                if not _place_subtree(child, child_allowed.copy(), occupied_blue, canvas_shape):
+                    ok = False
+                    break
+                child_allowed &= ~_dilate8(child["ring_mask"] | child["domain_mask"], radius=1)
+            if ok:
+                return True
+            occupied_blue[:] = snapshot
+        continue
+    return False
+
+
+def _build_scene() -> tuple[np.ndarray, list[dict], np.ndarray] | None:
+    roots = _node_specs()
+    flat = _flatten_nodes(roots)
+    max_depth = max(int(node["depth"]) for node in flat)
+    total = len(flat)
+    grid_h = random.randint(22 if max_depth == 3 else 18, 28)
+    grid_w = random.randint(22 if total >= 4 else 18, 28)
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    allowed = np.zeros_like(grid, dtype=bool)
+    allowed[1:-1, 1:-1] = True
+    occupied = np.zeros_like(grid, dtype=bool)
+
+    for root in sorted(roots, key=lambda item: len(_flatten_nodes([item])), reverse=True):
+        if not _place_subtree(root, allowed.copy(), occupied, grid.shape):
+            return None
+        allowed &= ~_dilate8(root["ring_mask"] | root["domain_mask"], radius=1)
+
+    nodes = _flatten_nodes(roots)
+    for node in nodes:
+        grid[node["ring_mask"]] = BLUE
+
+    expected = np.zeros_like(grid)
+    for node in nodes:
+        expected[node["ring_mask"]] = DEPTH_TO_RING_COLOR[int(node["depth"])]
+    nodes_by_depth = sorted(nodes, key=lambda item: int(item["depth"]), reverse=True)
+    for node in nodes_by_depth:
+        paint_inside = int(node["depth"]) % 2 == 0
+        outline_color = ORANGE if paint_inside else GRAY
+        for r, c in node["ring_coords"]:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in _neighbors8(rr, cc):
+                if not _in_bounds(grid.shape, nr, nc) or grid[nr, nc] != BLACK or expected[nr, nc] != BLACK:
+                    continue
+                if bool(node["domain_mask"][nr, nc]) == paint_inside:
+                    expected[nr, nc] = outline_color
+    return grid, nodes, expected
+
+
+def _validate_scene(grid: np.ndarray, nodes: list[dict], expected: np.ndarray) -> bool:
+    try:
+        derived = _analyze_rings(grid)
+        actual = main(grid)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+
+    depth_by_mask = {}
+    for ring in derived:
+        depth_by_mask[ring["mask"].tobytes()] = int(ring["depth"])
+    planned_depths = []
+    actual_depths = []
+    for node in nodes:
+        key = node["ring_mask"].tobytes()
+        if key not in depth_by_mask:
+            return False
+        planned_depths.append(int(node["depth"]))
+        actual_depths.append(depth_by_mask[key])
+    if sorted(planned_depths) != sorted(actual_depths):
+        return False
+
+    odd_count = sum(depth % 2 == 1 for depth in planned_depths)
+    even_count = sum(depth % 2 == 0 for depth in planned_depths)
+    if odd_count == 0 or even_count == 0:
+        return False
+
+    if len(set(planned_depths)) < 2:
+        return False
+    if int((grid == BLUE).sum()) <= 20:
+        return False
+    if np.unique(expected).size < 4:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        built = _build_scene()
+        if built is None:
+            continue
+        grid, nodes, expected = built
+        if max(grid.shape) > 30 or max(expected.shape) > 30:
+            continue
+        if _validate_scene(grid, nodes, expected):
+            return grid
+    raise RuntimeError("failed to generate a valid nested-ring ARC input")

