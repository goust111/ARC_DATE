+    interior_local = (~blocked) & (~outside)
+    interior = np.zeros(shape, dtype=bool)
+    interior[r0 : r1 + 1, c0 : c1 + 1] = interior_local[1:-1, 1:-1]
+    return interior
+
+
+def _region_depths(core: np.ndarray) -> tuple[np.ndarray, list[int]]:
