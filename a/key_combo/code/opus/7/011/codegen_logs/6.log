+            dl = max(0, min(1, dl + random.choice([-1, 0, 1])))
+            dr = max(0, min(1, dr + random.choice([-1, 0, 1])))
+            lc = parent_lefts[idx] + base_left + dl
+            rc = parent_rights[idx] - base_right - dr
+            if rc - lc + 1 < 5:
