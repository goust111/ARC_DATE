+    for r in range(core.shape[0]):
+        for c in range(core.shape[1]):
+            if core[r, c] != 0:
+                continue
+            depth = depths[int(zero_labels[r, c])]
+            if depth <= 0:
+                continue
+            assert depth <= len(palette), "palette must cover all nesting depths"
+            out[r, c] = palette[(r + c) % depth]
+    return out
