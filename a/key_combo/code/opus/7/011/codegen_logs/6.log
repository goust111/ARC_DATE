+    boxes = [box]
+    for level in range(1, depth_count):
+        prev = boxes[-1]
+        prev_h = prev[2] - prev[0] + 1
+        prev_w = prev[3] - prev[1] + 1
+        remaining = depth_count - level - 1
+        min_child = inner_min + 6 * remaining
+
+        pad_options = []
+        for pt in range(3, 6):
+            for pb in range(3, 6):
