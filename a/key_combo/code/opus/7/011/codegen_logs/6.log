+    min_h = max(11, needed_span)
+    min_w = max(11, needed_span)
+    max_h = min(19, core_h - 4)
+    max_w = min(22, w - 4)
+    if max_h < min_h or max_w < min_w:
+        return None
+
+    box_h = random.randint(min_h, max_h)
+    box_w = random.randint(min_w, max_w)
+    top = random.randint(1, core_h - box_h - 2)
+    left = random.randint(1, w - box_w - 2)
+    right = left + box_w - 1
+
+    min_width = max(7, box_w - 4)
+    lefts = []
+    rights = []
+    cur_left = left + random.randint(0, 1)
+    cur_right = right - random.randint(0, 1)
+    for _ in range(box_h):
+        cur_left = max(left, min(left + 2, cur_left + random.choice([-1, 0, 1])))
+        cur_right = max(right - 2, min(right, cur_right + random.choice([-1, 0, 1])))
+        if cur_right - cur_left + 1 < min_width:
+            need = min_width - (cur_right - cur_left + 1)
+            cur_left = max(left, cur_left - need // 2 - need % 2)
+            cur_right = min(right, cur_right + need // 2)
+        lefts.append(cur_left)
+        rights.append(cur_right)
+
+    if len(set(lefts)) == 1 and len(set(rights)) == 1:
+        pivot = random.randint(2, box_h - 3)
+        if random.random() < 0.5:
+            lefts[pivot] = min(lefts[pivot] + 1, left + 2)
+        else:
+            rights[pivot] = max(rights[pivot] - 1, right - 2)
