+
+def _build_nested_shapes(core_h: int, w: int, depth_count: int) -> list[np.ndarray] | None:
+    for _ in range(80):
+        outer = _make_outer_shape(core_h, w, depth_count)
+        if outer is None:
+            return None
+        shapes = [outer]
+        ok = True
+        while len(shapes) < depth_count:
+            child = _shrink_shape(shapes[-1])
+            if child is None:
+                ok = False
+                break
+            shapes.append(child)
+        if ok:
