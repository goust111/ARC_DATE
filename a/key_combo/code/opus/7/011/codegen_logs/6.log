+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox(mask: np.ndarray) -> BBox | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _label_components(mask: np.ndarray) -> tuple[np.ndarray, list[list[Coord]]]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    components: list[list[Coord]] = []
+    next_label = 1
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = next_label
+            comp: list[Coord] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_label
+                        q.append((nr, nc))
+            components.append(comp)
+            next_label += 1
+    return labels, components
+
+
+def _boundary(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    cells = np.argwhere(mask)
+    for r, c in cells:
+        r = int(r)
+        c = int(c)
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(mask.shape, nr, nc) or not mask[nr, nc]:
+                out[r, c] = True
+                break
+    return out
