+
+def _make_mask_from_rows(top: int, lefts: list[int], rights: list[int], shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    for offset, (lc, rc) in enumerate(zip(lefts, rights)):
