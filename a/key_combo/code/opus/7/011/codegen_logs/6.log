+    region_to_rings = [set() for _ in range(len(zero_components) + 1)]
+    ring_to_regions = [set() for _ in range(len(ring_components) + 1)]
+    reps = [(-1, -1)] * (len(zero_components) + 1)
+    for rid, comp in enumerate(zero_components, start=1):
+        reps[rid] = comp[0]
