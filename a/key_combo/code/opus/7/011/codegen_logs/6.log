+        r = rows[idx]
+        contour[r + 1, min(lefts[idx], lefts[idx + 1]) : max(lefts[idx], lefts[idx + 1]) + 1] = True
+        contour[r + 1, min(rights[idx], rights[idx + 1]) : max(rights[idx], rights[idx + 1]) + 1] = True
