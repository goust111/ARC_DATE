+    mask = np.zeros(shape, dtype=bool)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _build_nested_shapes(core_h: int, w: int, depth_count: int) -> list[np.ndarray] | None:
+    inner_min = 7 if depth_count == 4 else 5
