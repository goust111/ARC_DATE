+    inner_min = 7 if depth_count == 4 else 5
+    min_outer = inner_min + 6 * (depth_count - 1)
+    max_outer_h = core_h - 2
+    max_outer_w = w - 2
+    if max_outer_h < min_outer or max_outer_w < min_outer:
+        return None
