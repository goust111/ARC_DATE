+
+
+def _shrink_shape(parent: np.ndarray) -> np.ndarray | None:
+    rows = np.flatnonzero(np.any(parent, axis=1))
+    if len(rows) < 9:
+        return None
+    top = int(rows[0])
+    bottom = int(rows[-1])
+    parent_lefts = [int(np.flatnonzero(parent[r])[0]) for r in range(top, bottom + 1)]
+    parent_rights = [int(np.flatnonzero(parent[r])[-1]) for r in range(top, bottom + 1)]
+    parent_h = bottom - top + 1
+
+    for _ in range(80):
+        pad_top = random.randint(2, 3)
+        pad_bottom = random.randint(2, 3)
+        if parent_h - pad_top - pad_bottom < 5:
+            continue
+        child_top = top + pad_top
+        child_bottom = bottom - pad_bottom
+        child_h = child_bottom - child_top + 1
+
+        base_left = random.randint(2, 3)
+        base_right = random.randint(2, 3)
+        lefts: list[int] = []
+        rights: list[int] = []
