+def _ray_stop_kind(active: np.ndarray, directions: np.ndarray, r: int, c: int) -> str:
+    dr, dc = DIR_TO_DELTA[int(directions[c])]
+    rr = int(r + dr)
+    cc = int(c + dc)
+    painted = False
+    while 0 <= rr < PANEL_H and 0 <= cc < PANEL_W:
+        if bool(active[rr, cc]):
+            return "collision"
+        painted = True
