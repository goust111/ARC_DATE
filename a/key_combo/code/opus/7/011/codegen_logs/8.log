+    grid[1 : 1 + PANEL_H, SEPARATOR_COL] = GREY
+    grid[1 : 1 + PANEL_H, SEPARATOR_COL + 1 :] = MAROON
+    grid[1 : 1 + PANEL_H, :PANEL_W][left_black] = BACKGROUND
+    grid[1 : 1 + PANEL_H, SEPARATOR_COL + 1 :][right_black] = BACKGROUND
+    return grid
