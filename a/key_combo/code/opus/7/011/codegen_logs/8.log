+    dr, dc = DIR_TO_DELTA[int(directions[c])]
+    rr = int(r + dr)
+    cc = int(c + dc)
+    painted = False
+    while 0 <= rr < PANEL_H and 0 <= cc < PANEL_W:
+        if bool(active[rr, cc]):
+            return "collision"
+        painted = True
+        rr += dr
+        cc += dc
+    return "boundary" if painted else "none"
