+            break
+        if row_counts[r] >= 3:
+            continue
+        active[r, c] = True
+        row_counts[r] += 1
+
+    if not (8 <= int(active.sum()) <= 15):
+        return None
+    if int(row_counts.max()) > 3:
+        return None
+    if any(not np.any(active[:, directions == color]) for color in (BLUE, RED, GREEN, YELLOW)):
