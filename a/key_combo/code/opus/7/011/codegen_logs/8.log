+    left_black = left == BACKGROUND
+    right_black = right == BACKGROUND
+    active = left_black & right_black
+
+    if not np.array_equal(out, _render_from_active(active, directions, stop_on_active=True)):
+        return False
+    if not (8 <= int(active.sum()) <= 15):
+        return False
