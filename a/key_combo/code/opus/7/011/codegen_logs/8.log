+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+INPUT_H = 15
+INPUT_W = 23
+PANEL_H = 13
+PANEL_W = 11
+SEPARATOR_COL = 11
+
+DIR_TO_DELTA = {
+    RED: (1, 0),
+    GREEN: (-1, 0),
+    BLUE: (0, 1),
+    YELLOW: (0, -1),
+}
+OPPOSITE_DIR = {
+    RED: GREEN,
+    GREEN: RED,
+    BLUE: YELLOW,
+    YELLOW: BLUE,
+}
+
+GEN_RETRIES = 400
