+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+
+def _find_separator_col(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == GREY)]
+    assert len(cols) == 1, f"expected one grey separator column, got {cols}"
+    return int(cols[0])
