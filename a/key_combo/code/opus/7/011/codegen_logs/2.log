0014: def main(input_grid):
0015:     """
0016:     Compress nested colored shapes into a small nested-square color summary.
0017: 
0018:     Input structure:
0019:     - The input contains nested monochromatic non-black shapes on a black background.
0020:     - Outer layers have larger bounding boxes than inner layers.
0021:     - Each layer has a distinct color.
0022: 
0023:     Rule:
0024:     - Detect the colored objects and sort them from largest bounding box to smallest.
0025:     - Create a square output with one ring per detected layer.
0026:     - Fill nested squares from outermost to innermost using the corresponding layer colors.
0027: 
0028:     Key insight:
0029:     - The output preserves only nesting order and colors; geometric details of the
0030:       original shapes are reduced to one-pixel-thick square layers.
0031:     """
0032:     # Plan:
0033:     # 1. Parse the input into objects and order them from outermost to innermost by area
0034:     # 2. Draw nested rectangles with the colors of the input objects, each layer has only one pixel length
0035: 
0036:     # 1. input parsing
0037:     # Find the objects in the input grid
0038:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0039: 
0040:     # Sort the objects from outermost to innermost, using area to determine the order
0041:     def _area(o: np.ndarray) -> int:
0042:         b = bbox(o != Color.BLACK)
0043:         if b is None:
0044:             return 0
0045:         r0, c0, r1, c1 = b
0046:         return (r1 - r0 + 1) * (c1 - c0 + 1)
0047: 
0048:     objects.sort(key=_area, reverse=True)
0049: 
0050:     # 2. drawing the output
0051:     # Leave only one layer of each color shape
0052:     grid_len = len(objects) * 2 - 1
0053:     output_grid = np.full((grid_len, grid_len), Color.BLACK)
0054: 
0055:     # Calculate each layer's length, which starts at the outermost layer
0056:     current_len = grid_len
0057: 
0058:     # Draw nested shapes with the colors of the input objects. Each layer has only one pixel length of the current color
0059:     for i, obj in enumerate(objects):
0060:         # Get the color of the current layer
0061:         cols = set(map(int, np.unique(obj))) - {Color.BLACK}
0062:         assert cols
0063:         color = next(iter(cols))
0064:         # Fill the region with the current color
0065:         cur_shape = np.full((current_len, current_len), color)
0066:         # Place the current shape in the output grid
0067:         # Make sure each layer has only one pixel length of the current color
0068:         output_grid = paste(output_grid, cur_shape, i, i)
0069:         current_len -= 2
0070: 
0071:     return output_grid
