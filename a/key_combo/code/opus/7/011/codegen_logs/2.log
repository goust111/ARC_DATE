+            region = canvas[r : r + mh, c : c + mw]
+            region[mask] = int(spec["color"])
+            occupied[r : r + mh, c : c + mw] |= mask
+            placed = True
+            break
+        if not placed:
+            return None
+    start = random.randint(0, width - 3)
+    canvas[-1, start : start + 3] = np.array(PALETTE_COLORS, dtype=int)
+    return canvas
