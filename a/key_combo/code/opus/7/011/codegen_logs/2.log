+def _random_transform(mask: np.ndarray) -> np.ndarray:
+    out = np.array(mask, dtype=bool, copy=True)
+    out = np.rot90(out, random.randrange(4))
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    return out.copy()
