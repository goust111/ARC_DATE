+    width = random.randint(19, 25)
+    if count == 5:
+        height = max(height, 21)
+        width = max(width, 21)
+    grid = _place_shapes(height, width, specs)
+    if grid is None:
+        return None
+
+    expected = _validate_semantics(grid, hole_counts)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
