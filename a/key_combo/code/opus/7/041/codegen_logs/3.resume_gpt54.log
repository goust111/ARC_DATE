+    hi = min(width - 3, 25 // height)
+    return list(range(lo, hi + 1))
+
+
+def _choose_mask(window_width: int, side: str, total_width: int) -> tuple[int, int]:
+    if side == "left":
+        return 0, window_width - 1
+    return total_width - window_width, total_width - 1
