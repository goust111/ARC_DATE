+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            r0 = int(rows.min())
+            r1 = int(rows.max())
+            c0 = int(cols.min())
+            c1 = int(cols.max())
+            assert r0 == r1, "segments must be horizontal"
+            assert int(coords.shape[0]) == c1 - c0 + 1, "segments must be solid one-cell bars"
+            segments.append((r0, c0, c1, int(color)))
+    assert segments, "expected colored segments"
+    return segments
