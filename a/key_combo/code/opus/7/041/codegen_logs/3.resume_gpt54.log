+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert h >= 4 and w >= 4
+    assert bool(np.all(g[-1, :] == int(BAR_COLOR))), "expected a full red bottom bar"
+
+    open_cols = _mask_columns(g)
+    segments = _segment_runs(g)
