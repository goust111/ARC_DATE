+def _neighbors(mask: np.ndarray, start: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    q = deque([start])
+    seen = {start}
+    out: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
