+    solved = main(inp)
+    if not np.array_equal(solved, out):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _attempt_grid()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input grid")

