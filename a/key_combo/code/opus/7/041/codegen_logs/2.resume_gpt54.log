        out[r0:r_mid, c_mid : c1 + 1] = colors[1]
        out[r_mid : r1 + 1, c0:c_mid] = colors[2]
        out[r_mid : r1 + 1, c_mid : c1 + 1] = colors[3]

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, out):
