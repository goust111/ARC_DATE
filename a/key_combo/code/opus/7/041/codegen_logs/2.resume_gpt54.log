+        sc = c0 + dc * w
+        for rr, cc in _mask_coords(stamp):
+            gr = sr + rr
+            gc = sc + cc
+            assert 0 <= gr < shape[0] and 0 <= gc < shape[1], "stamp placement out of bounds"
+            coverage[gr, gc] += 1
