+
+BG = 0
+TEMPLATE_COLOR = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+OVERLAP_COLOR = 5
+ORIGIN_COLOR = 7
+MARKER_PALETTE = (GREEN, YELLOW, RED, ORIGIN_COLOR)
+
+ROTATION_BY_CORNER = {
+    "tl": 0,
+    "tr": 90,
+    "br": 180,
+    "bl": 270,
+}
+ROT90_K = {
+    0: 0,
+    90: 3,
+    180: 2,
+    270: 1,
+}
+
+TEMPLATE_DIMS = ((3, 4), (3, 5), (4, 5))
+TEMPLATE_AREA_RANGE = (5, 8)
+GRID_SIDE_RANGE = (18, 28)
+GEN_RETRIES = 500
