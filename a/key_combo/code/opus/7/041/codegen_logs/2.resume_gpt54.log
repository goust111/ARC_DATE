+    template_mask = grid[r0 : r1 + 1, c0 : c1 + 1] == TEMPLATE_COLOR
+    h, w = template_mask.shape
+
+    corner_positions = {
+        "tl": (r0 - 1, c0 - 1),
+        "tr": (r0 - 1, c1 + 1),
+        "br": (r1 + 1, c1 + 1),
+        "bl": (r1 + 1, c0 - 1),
