+
+    c = legend_c0
+    for idx, color in enumerate(colors):
+        grid[0:SWATCH_SIZE, c : c + SWATCH_SIZE] = color
+        c += SWATCH_SIZE
+        if idx != len(colors) - 1:
+            c += 1
+
+    c += legend_gap
+    for idx, mask in enumerate(stencils):
+        grid[0:STENCIL_SIZE, c : c + STENCIL_SIZE] = np.where(mask, NEUTRAL, BACKGROUND)
+        c += STENCIL_SIZE
+        if idx != len(colors) - 1:
+            c += 1
