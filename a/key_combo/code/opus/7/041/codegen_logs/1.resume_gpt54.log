+        rng.shuffle(colors)
+
+        regions = []
+        ok = True
+        for idx, (kind, want_overlap) in enumerate(specs):
+            region_h = region_heights[idx // 2]
+            region_w = region_widths[idx % 2]
+            color = colors[idx]
