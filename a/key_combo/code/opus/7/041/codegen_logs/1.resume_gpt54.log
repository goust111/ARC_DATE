+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+SPRITE_COLORS = (BLUE, GREEN, YELLOW, PINK)
+
+LINE_OVERLAP_TEMPLATES = (
+    (2, [(-2, 1), (-1, 0), (-1, 1), (1, 0), (1, 1)]),
+    (3, [(-1, 0), (-1, 1), (-1, 2), (1, 0), (1, 1), (2, 1)]),
+    (3, [(-2, 1), (-1, 0), (1, 0), (1, 1), (1, 2)]),
+)
