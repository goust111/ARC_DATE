+def _mirror_coords(
+    sprite_coords: set[tuple[int, int]],
+    marker_mode: str,
+    marker_data: int | tuple[int, int],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
+    h, w = shape
+    mirrored = set()
+    for r, c in sprite_coords:
+        if marker_mode == "row":
+            rr, cc = 2 * int(marker_data) - r, c
+        elif marker_mode == "col":
+            rr, cc = r, 2 * int(marker_data) - c
+        else:
+            mr, mc = marker_data
+            rr, cc = 2 * mr - r, 2 * mc - c
+        if 0 <= rr < h and 0 <= cc < w:
