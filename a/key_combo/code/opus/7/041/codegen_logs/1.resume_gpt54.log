+def _transform_point_offsets(
+    offsets: list[tuple[int, int]], rot_k: int, flip_lr: bool
+) -> list[tuple[int, int]]:
+    pts = [(int(r), int(c)) for r, c in offsets]
+    if flip_lr:
+        pts = [(r, -c) for r, c in pts]
+    for _ in range(rot_k % 4):
+        pts = [(-c, r) for r, c in pts]
