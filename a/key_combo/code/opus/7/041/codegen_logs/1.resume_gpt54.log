PAYLOAD_DENSITY_LO, PAYLOAD_DENSITY_HI = 0.50, 0.80

# Isolated payload
ISOLATED_PX_MIN, ISOLATED_PX_MAX = 1, 8   # pixel count range
ISOLATED_BBOX_MAX = 4                      # max side of isolated bbox

# Color palette
