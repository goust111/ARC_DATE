+        for r, c in placed_colors:
+            region[r, c] = color
+        for r, c in placed_reds:
+            region[r, c] = RED
+
+        sprite_color, overlap = _analyze_region(region)
+        if sprite_color != color:
+            continue
+        if (overlap > 0) != want_overlap:
+            continue
+        return region
