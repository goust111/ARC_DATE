+def generate_input() -> np.ndarray:
+    rng = random.Random()
+
+    for _ in range(300):
+        region_heights = [rng.randint(6, 8), rng.randint(6, 8)]
+        region_widths = [rng.randint(6, 8), rng.randint(6, 8)]
+        grid_h = sum(region_heights) + 1
+        grid_w = sum(region_widths) + 1
