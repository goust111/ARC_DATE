+    sprite_coords: set[tuple[int, int]],
+    marker_mode: str,
+    marker_data: int | tuple[int, int],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
+    h, w = shape
+    mirrored = set()
+    for r, c in sprite_coords:
