+    out: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if mask[r, c] and mask[r - 1 : r + 2, c - 1 : c + 2].all():
+                out.append((r, c))
+    return out
