+        elif (occ[0, :3].all() and occ[1, :3].all()):
+            band_mask[:2, :3] = True
+        extras = np.argwhere(occ & ~band_mask)
+    else:
+        extras = np.argwhere(occ)
+    if extras.size == 0:
+        extras = np.argwhere(occ)
+    mr, mc = extras[int(rng.integers(len(extras)))]
+    patch[mr, mc] = marker_color
+    return patch
