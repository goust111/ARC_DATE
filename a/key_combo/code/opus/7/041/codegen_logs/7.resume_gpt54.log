+        return False
+    occ = patch != BG
+    for rr, cc in np.argwhere(occ):
+        rr = int(rr)
+        cc = int(cc)
+        gr = r0 + rr
+        gc = c0 + cc
+        if grid[gr, gc] != BG:
+            return False
+        r1 = max(0, gr - 1)
+        r2 = min(h, gr + 2)
+        c1 = max(0, gc - 1)
+        c2 = min(w, gc + 2)
+        if np.any(grid[r1:r2, c1:c2] != BG):
