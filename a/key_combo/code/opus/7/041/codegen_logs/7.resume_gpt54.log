+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 400
+PLACE_RETRIES = 200
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+TOP_TEMPLATES = [
+    [".#.", ".#.", "###", "###"],
+    ["..#.", "..##", "###.", "###."],
+    ["##..", "#...", "###.", "###."],
+    ["...#", ".###", "###.", "###."],
+    [".##.", "..#.", "###.", "###."],
+    ["...#", "..##", "..#.", "###.", "###."],
+]
+
+
+def _get_bg(grid: np.ndarray) -> int:
