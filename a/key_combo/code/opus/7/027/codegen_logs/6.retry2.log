    extra = _GEN_GRID_SIZE - sum(widths) - _GEN_MIN_INTER_OBJECT_GAP * (n - 1)
    gap_extra = [0] * (n + 1)
    for _ in range(extra):
        gap_extra[random.randrange(n + 1)] += 1

