+    h, w = g.shape
+
+    assert int(g[0, 0]) == BLACK
+    assert int(g[0, w - 1]) == BLACK
+    assert int(g[h - 1, 0]) == BLACK
+    assert int(g[h - 1, w - 1]) == BLACK
+    assert not np.any(g[1:-1, 1:-1] < 0)
+
