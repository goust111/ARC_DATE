+def _trace_ray(
+    grid: np.ndarray,
+    start: tuple[int, int, int],
+    side: str,
+    *,
+    ignore_blockers: bool = False,
+) -> tuple[list[tuple[int, int, int]], bool]:
+    h, w = grid.shape
+    r, c, color = start
+    dr, dc = SIDE_TO_DIR[side]
+    rr, cc = r + dr, c + dc
+    dist = 1
+    hits: list[tuple[int, int, int]] = []
+    blocked = False
