+            kind = "vertical"
+            winner_side = str(v["side"])
+            winner_color = int(v["color"])
+        elif int(h["dist"]) < int(v["dist"]):
+            kind = "horizontal"
+            winner_side = str(h["side"])
+            winner_color = int(h["color"])
+        else:
+            kind = "tie"
+            winner_side = str(h["side"])
+            winner_color = int(h["color"])
