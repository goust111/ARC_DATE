+
+def _compose_output(
+    grid: np.ndarray,
+    vertical_hits: dict[tuple[int, int], dict[str, int | str | tuple[int, int]]],
+    horizontal_hits: dict[tuple[int, int], dict[str, int | str | tuple[int, int]]],
+    *,
+    mode: str = "distance",
