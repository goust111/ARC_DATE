+                        configs.append(
+                            {
+                                "vertical_side": vertical_side,
+                                "horizontal_side": horizontal_side,
+                                "row": int(row),
+                                "tie_col": int(tie_c),
+                                "horiz_win_col": int(horiz_win_c),
+                                "vert_win_col": int(vert_win_c),
+                                "blocker_cols": blocker_cols,
