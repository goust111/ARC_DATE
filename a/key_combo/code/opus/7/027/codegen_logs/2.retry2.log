+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+
+TOP_COLORS = (BLUE, GREEN)
+BOTTOM_COLORS = (RED, YELLOW)
+LEFT_COLOR = MAGENTA
+RIGHT_COLOR = ORANGE
+
+SIDE_TO_DIR = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
+}
