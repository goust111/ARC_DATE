+) -> int | None:
+    if side == "top":
+        lo, hi = 2, max(horizontal_rows) - 1
+    else:
+        lo, hi = min(horizontal_rows) + 1, h - 3
+    candidates = [r for r in range(lo, hi + 1) if r not in forbidden_rows]
+    if not candidates:
