spec:
  grid: 20x20 [observed]
  colors:
    bg: 0 (always g[0,0])
    fill: 1 [observed], more common foreground color
    marker: 2 [observed], rarer foreground color; exactly 2 distinct foreground colors required
  rectangles:
    count: 3-4 non-overlapping axis-aligned solid rectangles (no bg inside)
    dimensions: each side 3-18 cells
    separation: min gap >= 2 between any pair of bounding boxes
    may touch grid edges, but g[0,0] must be bg
    coverage: total rectangle area / grid area ~ 0.3-0.6 [observed]
  markers:
    every rectangle has >= 1 marker pixel scattered within it
    marker fraction per rectangle: 5-25% of rectangle area
    total markers across all rectangles: 13-25 [observed]
  selection_rule:
    exactly one rectangle has strictly the most marker pixels (unique winner)
    output = exact bounding-box crop of that rectangle (no recoloring)

generation_strategy:
  approach: direct (forward construction; constraints are simple enough)
  steps:
    1. Pick grid 20x20, bg=0, fill=1, marker=2
    2. Choose N=3-4 rectangles with random heights/widths in [3,18]
    3. Place rectangles on grid with no overlap and min gap >= 2; allow edge-touching but keep g[0,0]=bg
    4. For each rectangle, choose a marker count = randint(2, ceil(0.25*area)), ensuring >= 1
    5. Adjust counts so exactly one rectangle has strictly the largest marker count (the winner); ensure winner has at least 2 more markers than runner-up
    6. For each rectangle, scatter its marker pixels randomly within the rectangle, filling rest with fill color
    7. Verify total marker count < total fill count (marker is the rarer color)
```
