  "type": "transform_in_place",
  "src": "solid foreground rectangles containing sparse marker pixels",
  "transform": "select the rectangle with the largest marker-pixel count and return it unchanged",
  "grid_shape": "tight crop to the selected rectangle bbox"
}
</annotation>
