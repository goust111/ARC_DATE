+
+BG = 0
+OUT_BLUE = 1
+OUT_RED = 2
+LINE = 7
+INPUT_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
