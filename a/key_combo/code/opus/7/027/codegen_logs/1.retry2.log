+        rb = int(RNG.integers(rb_lo, rb_max + 1))
+        if not _can_place_input(occ, a["mask"], ra, c0):
+            continue
+        occ2 = occ.copy()
+        _occupy(occ2, a["mask"], ra, c0)
+        if not _can_place_input(occ2, b["mask"], rb, c0):
