+    keys_by_area = {}
+    for obj in objects:
+        area = int(obj["mask"].sum())
+        key = _canonical_shape_key(obj["mask"])
+        keys_by_area.setdefault(area, set()).add(key)
+    if not any(len(keys) >= 2 for keys in keys_by_area.values()):
+        return False
