+            frontier = []
+            for r, c in cells:
+                for dr, dc in DIRS4:
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < bbox_h and 0 <= nc < bbox_w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
