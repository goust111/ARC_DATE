+
+
+def _generate_attempt() -> np.ndarray | None:
+    H = int(RNG.choice([15, 17, 19]))
+    W = int(RNG.integers(15, 20))
+    line_row = H // 2
+    specs = _build_object_specs(H, W)
+    if specs is None:
+        return None
