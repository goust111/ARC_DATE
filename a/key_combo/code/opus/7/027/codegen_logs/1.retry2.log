+    out = []
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if visited[r, c] or color in (BG, LINE):
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
