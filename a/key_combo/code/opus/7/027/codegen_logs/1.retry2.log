+    used_keys.add(unique_same_area[1])
+
+    specs = []
+    first_group_size = shared_sizes[0]
+    variants = [overlap_pair[0], overlap_pair[1]]
+    extra_vars = shared_vars.copy()
+    RNG.shuffle(extra_vars)
+    while len(variants) < first_group_size:
