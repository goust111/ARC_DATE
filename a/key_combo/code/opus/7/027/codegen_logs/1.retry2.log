+
+
+def _try_place_unique_overlap(
+    occ: np.ndarray, objs: list[dict], col_lo: int, col_hi: int, line_row: int
+) -> bool:
+    a, b = objs[0], objs[1]
+    wa, wb = a["mask"].shape[1], b["mask"].shape[1]
+    for _ in range(400):
