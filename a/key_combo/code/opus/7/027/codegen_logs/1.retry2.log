+
+    for group_id, group_size in enumerate(shared_sizes[1:], start=1):
+        try:
+            template, key = _random_polyomino(int(RNG.integers(3, 7)), require_asymmetric=False, forbid=used_keys)
+        except RuntimeError:
+            return None
+        used_keys.add(key)
