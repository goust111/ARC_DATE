+            return None
+
+    grid = _render_input(H, W, specs)
+    if not _validate_instance(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _generate_attempt()
+        if grid is not None:
