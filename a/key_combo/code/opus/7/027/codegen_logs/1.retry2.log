+
+def _paste_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    h, w = mask.shape
+    sl = grid[r0 : r0 + h, c0 : c0 + w]
+    if np.any(sl[mask] != BG):
+        raise AssertionError("object overlap")
