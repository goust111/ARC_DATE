+        7: ([2], [3], [2, 2], [3, 2]),
+        8: ([2], [3], [2, 2], [3, 2]),
+    }
+    candidates = [list(x) for x in options[n_objects] if n_objects - sum(x) >= 2]
+    return candidates[int(RNG.integers(len(candidates)))]
