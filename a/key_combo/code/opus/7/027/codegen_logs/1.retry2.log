+    canvas_a = np.zeros((h, w), dtype=bool)
+    canvas_b = np.zeros((h, w), dtype=bool)
+    canvas_a[: mask_a.shape[0], c0_a - left : c0_a - left + mask_a.shape[1]] = mask_a
+    canvas_b[: mask_b.shape[0], c0_b - left : c0_b - left + mask_b.shape[1]] = mask_b
