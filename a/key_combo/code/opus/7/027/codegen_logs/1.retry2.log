+    stack_pair = shared_objs[:2]
+    overlap_pair = unique_objs[:2]
+    if not _try_place_shared_stack(occ, stack_pair, W, line_row):
+        return None
+    if not _try_place_unique_overlap(occ, overlap_pair, W, line_row):
+        return None
