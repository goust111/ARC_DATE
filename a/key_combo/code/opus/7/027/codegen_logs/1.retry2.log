+def _can_place_input(occ: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    H, W = occ.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    coords = np.argwhere(mask)
+    for rr, cc in coords:
+        gr = r0 + int(rr)
+        gc = c0 + int(cc)
+        if occ[gr, gc]:
+            return False
+        for dr, dc in DIRS4:
+            nr, nc = gr + dr, gc + dc
+            if 0 <= nr < H and 0 <= nc < W and occ[nr, nc]:
+                return False
