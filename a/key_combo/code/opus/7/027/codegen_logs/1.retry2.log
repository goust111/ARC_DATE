+    in_objs = _find_objects(grid)
+    out_objs = _find_objects(out)
+    if len(in_objs) != len(out_objs):
+        return False
+
+    out_by_cols = {}
+    for obj in out_objs:
+        bbox = obj["bbox"]
+        key = (bbox[1], bbox[3], tuple(int(x) for x in obj["mask"].ravel()), obj["mask"].shape)
+        out_by_cols.setdefault(key, []).append(obj)
