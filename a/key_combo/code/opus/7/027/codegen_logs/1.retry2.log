+
+
+def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return max(a[0], b[0]) <= min(a[1], b[1])
+
+
+def _validate_instance(grid: np.ndarray) -> bool:
+    H, W = grid.shape
+    if H > 30 or W > 30:
+        return False
+    line_row = H // 2
+    if not np.all(grid[line_row] == LINE):
+        return False
+    if np.any(grid[line_row + 1 :] != BG):
+        return False
