+            return False
+        ra = int(RNG.integers(0, ra_max + 1))
+        rb = int(RNG.integers(0, rb_max + 1))
+        if not _can_place_input(occ, a["mask"], ra, c0a):
+            continue
+        occ2 = occ.copy()
