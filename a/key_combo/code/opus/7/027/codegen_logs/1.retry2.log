+                        q.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            bbox = _bbox_from_coords(arr)
+            out.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": bbox,
+                    "mask": _mask_from_coords(arr, bbox),
+                }
+            )
+    return out
