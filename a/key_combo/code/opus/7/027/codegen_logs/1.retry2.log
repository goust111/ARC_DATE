+        return False
+
+    in_objs = _find_objects(grid)
+    out_objs = _find_objects(out)
+    if len(in_objs) != len(out_objs):
+        return False
+
+    out_by_cols = {}
+    for obj in out_objs:
+        bbox = obj["bbox"]
+        key = (bbox[1], bbox[3], tuple(int(x) for x in obj["mask"].ravel()), obj["mask"].shape)
+        out_by_cols.setdefault(key, []).append(obj)
+
+    odd = even = False
+    collision_needed = False
+    moved_up = moved_down = False
+    for obj in in_objs:
+        key = _canonical_shape_key(obj["mask"])
+        group_shared = freq[key] >= 2
+        target_color = None
+        matched = None
+        for cand in out_objs:
+            if cand["bbox"][1] == obj["bbox"][1] and cand["mask"].shape == obj["mask"].shape and np.array_equal(cand["mask"], obj["mask"]):
+                matched = cand
+                break
+        if matched is None:
+            return False
+        disp = abs(matched["bbox"][0] - obj["bbox"][0])
+        if group_shared:
+            moved_down |= matched["bbox"][0] > obj["bbox"][0]
+        else:
+            moved_up |= matched["bbox"][0] < obj["bbox"][0]
+        target_color = OUT_RED if disp % 2 == 1 else OUT_BLUE
+        if int(matched["color"]) != target_color:
+            return False
+        odd |= target_color == OUT_RED
+        even |= target_color == OUT_BLUE
+        naive_row = 0 if not group_shared else line_row - obj["mask"].shape[0]
+        if matched["bbox"][0] != naive_row:
