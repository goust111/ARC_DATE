+        if group_shared:
+            moved_down |= dest_r0 > obj["bbox"][0]
+        else:
+            moved_up |= dest_r0 < obj["bbox"][0]
+        odd |= expected_color == OUT_RED
+        even |= expected_color == OUT_BLUE
