+        _occupy(occ, a["mask"], ra, c0a)
+        _occupy(occ, b["mask"], rb, c0b)
+        return True
+    return False
+
+
+def _try_place_random(
+    occ: np.ndarray, obj: dict, col_lo: int, col_hi: int, line_row: int
+) -> bool:
+    h, w = obj["mask"].shape
+    if col_hi - col_lo < w or line_row < h:
+        return False
+    for _ in range(300):
