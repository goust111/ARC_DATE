+    occ = np.zeros((line_row, W), dtype=bool)
+    split = W // 2
+    shared_hi = max(split - 1, max(obj["mask"].shape[1] for obj in shared_objs))
+    unique_lo = min(split + 1, W - max(obj["mask"].shape[1] for obj in unique_objs))
+    if shared_hi >= unique_lo:
