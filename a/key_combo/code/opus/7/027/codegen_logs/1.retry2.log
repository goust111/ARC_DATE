+        patch = out[dest_r0 : dest_r0 + h, c0 : c0 + w]
+        expected_color = OUT_RED if abs(dest_r0 - obj["bbox"][0]) % 2 == 1 else OUT_BLUE
+        if not np.all(patch[mask] == expected_color):
