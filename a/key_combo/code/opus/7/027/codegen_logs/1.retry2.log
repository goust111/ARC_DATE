+        return False
+    if np.any(grid[line_row + 1 :] != BG):
+        return False
+
+    objects = _find_objects(grid)
+    if not (6 <= len(objects) <= 8):
+        return False
+    if any(obj["bbox"][2] >= line_row for obj in objects):
+        return False
+    if any(not (3 <= int(obj["mask"].sum()) <= 6) for obj in objects):
+        return False
