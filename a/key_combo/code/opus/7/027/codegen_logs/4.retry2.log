+def _row_clusters(grid: np.ndarray) -> list[tuple[int, int]]:
+    rows = np.flatnonzero(np.any(grid != BLACK, axis=1))
+    assert rows.size > 0, "expected foreground symbols"
+    clusters: list[tuple[int, int]] = []
+    start = int(rows[0])
+    prev = int(rows[0])
+    for row in rows[1:]:
