+    clusters: list[tuple[int, int]] = []
+    start = int(rows[0])
+    prev = int(rows[0])
+    for row in rows[1:]:
+        row = int(row)
+        if row == prev + 1:
+            prev = row
+            continue
+        clusters.append((start, prev))
+        start = prev = row
+    clusters.append((start, prev))
+    return clusters
