+    (top_r0, top_r1), (bot_r0, bot_r1) = clusters
+    assert top_r1 - top_r0 == SYMBOL_SIZE - 1, "top symbol rows must span 3 rows"
+    assert bot_r1 - bot_r0 == SYMBOL_SIZE - 1, "bottom symbol rows must span 3 rows"
