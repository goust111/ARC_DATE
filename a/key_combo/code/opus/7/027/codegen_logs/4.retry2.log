+def _make_layout(slot_specs: list[dict[str, int]], separator_rows: int) -> np.ndarray | None:
+    slot_count = len(slot_specs)
+    height = TOP_BAND_HEIGHT * 2 + separator_rows
+    width = slot_count * SLOT_STEP - 1
