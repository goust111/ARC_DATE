+    kinds = [_slot_kind(t, b) for t, b in zip(top, bottom)]
+    if kinds.count("tie") != 1:
+        return False
+    if "top_wins" not in kinds or "bottom_wins" not in kinds:
+        return False
+    if not any(kind in ("top_only", "bottom_only") for kind in kinds):
