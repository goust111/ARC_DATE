    inp = _gen_render_input(masks)
    expected = _gen_expected_output(masks)
    if not _gen_validates(inp, expected):
        return None
    return inp


def generate_input():
    for _ in range(_GEN_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
