  "dst": "output rows ordered top-to-bottom by increasing gray-marker count",
  "match_cond": "rank(s.gray_marker_count ascending) == rank(d.row_order top-to-bottom)",
  "transform": "paint each row with s.color repeated s.gray_marker_count times, then right-pad with background",
  "grid_shape": "number of rows is the number of frames; width is the largest gray-marker count"
}
</annotation>
