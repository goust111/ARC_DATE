+    assert interior.any(), "each region must be closed"
+    hole_count = 0
+    seen = np.zeros_like(interior, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not interior[r, c] or seen[r, c]:
+                continue
+            hole_count += 1
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            while queue:
+                cr, cc = queue.popleft()
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and interior[nr, nc] and not seen[nr, nc]:
