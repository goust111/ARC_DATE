+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 400
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while queue:
+                cr, cc = queue.popleft()
+                coords.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            arr = np.array(coords, dtype=int)
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox(arr),
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return components
+
+
+def _interior_mask(component: dict) -> tuple[np.ndarray, tuple[int, int, int, int], int]:
+    r0, c0, r1, c1 = component["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in component["coords"]:
+        mask[r - r0, c - c0] = True
+
+    outside = np.zeros((h, w), dtype=bool)
+    queue = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                queue.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                queue.append((r, c))
+
+    while queue:
+        cr, cc = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = cr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                queue.append((nr, nc))
+
