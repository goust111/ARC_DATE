+        marker = (r0 - 1, mid_c)
+        occ = (r0 - 1, c0, r1, c1)
+    elif direction == "bottom":
+        marker = (r1 + 1, mid_c)
+        occ = (r0, c0, r1 + 1, c1)
+    elif direction == "left":
+        marker = (mid_r, c0 - 1)
+        occ = (r0, c0 - 1, r1, c1)
+    else:
+        marker = (mid_r, c1 + 1)
+        occ = (r0, c0, r1, c1 + 1)
