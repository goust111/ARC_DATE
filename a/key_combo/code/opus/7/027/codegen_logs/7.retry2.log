+            "direction": direction,
+            "P": pass_count,
+            "T": total_count,
+            "inner_h": inner_h,
+            "inner_w": inner_w,
+            "grey_cells": grey_cells,
+        }
+    raise RuntimeError("failed to build object spec")
+
+
+def _occupied_and_reserve(
+    r0: int,
+    c0: int,
+    frame_h: int,
+    frame_w: int,
+    direction: str,
+) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int], tuple[int, int]]:
+    r1 = r0 + frame_h - 1
+    c1 = c0 + frame_w - 1
+    mid_r = (r0 + r1) // 2
+    mid_c = (c0 + c1) // 2
