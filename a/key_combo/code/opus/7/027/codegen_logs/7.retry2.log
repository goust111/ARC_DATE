+        grid[r0 + 1 + ir, c0 + 1 + ic] = GREY
+    _, _, marker = _occupied_and_reserve(r0, c0, frame_h, frame_w, spec["direction"])
+    grid[marker] = color
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n = random.randint(3, 5)
+    base = 18 if n == 3 else 20 if n == 4 else 22
+    h = random.randint(base, min(24, base + 2))
+    w = random.randint(base - 1, min(24, base + 3))
