+        grey_cover[r0 + 1 : r1, c0 + 1 : c1] += (interior == GREY).astype(int)
+        if direction in ("top", "bottom"):
+            ray = g[r0 + 1 : r1, mid_c]
+        else:
+            ray = g[mid_r, c0 + 1 : c1]
+        pass_count = int(np.count_nonzero(ray == GREY))
+        assert pass_count >= 1
