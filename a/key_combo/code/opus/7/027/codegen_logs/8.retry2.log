+    for coords in _components(grid == FRAME):
+        r0, c0, r1, c1 = _bbox(coords)
+        if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+            continue
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        if not np.all(patch[0, :] == FRAME):
