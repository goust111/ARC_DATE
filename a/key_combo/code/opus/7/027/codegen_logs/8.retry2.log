+def _enumerate_candidates(frames: list[dict], width: int) -> list[dict]:
+    candidates = []
+    ordered = [{**frame, "index": idx} for idx, frame in enumerate(frames)]
+    for span_w in (1, 2):
+        for c0 in range(0, width - span_w + 1):
