+BG = 0
+FRAME = 8
+SHAPE_COLORS = (1, 2, 3, 4)
+COUNT_TO_COLOR = {0: 5, 1: 8}
+
+SHAPE_TEMPLATES = {
+    1: (
+        np.array([(0, 0), (1, 0)], dtype=int),
+        np.array([(0, 0), (1, 0), (2, 0)], dtype=int),
