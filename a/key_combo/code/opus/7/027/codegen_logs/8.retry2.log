+    out = main(grid)
+    assert out.shape == grid.shape
+    recolored = {0: 5, 1: 8}
+    for idx, frame in enumerate(frames):
+        expected = recolored.get(int(counts[idx]), 2)
+        coords = frame["coords"]
+        assert np.all(out[coords[:, 0], coords[:, 1]] == expected)
+    for item in sim:
