+    for idx, frame in enumerate(frames):
+        if frame["gap"] is None:
+            continue
+        assert any(any(fi == idx and action == "pass" for fi, action in item["path"]) for item in sim)
+        assert any(item["landing"] == idx for item in sim)
+    assert len(set(counts)) >= 2
+    if len(frames) == 3:
