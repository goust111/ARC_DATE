+        bottom = patch[-1, :]
+        if bottom[0] != FRAME or bottom[-1] != FRAME:
+            continue
+        interior = bottom[1:-1]
+        if not np.all(np.isin(interior, [BG, FRAME])):
+            continue
+        gap = None
+        zeros = np.where(interior == BG)[0]
+        if zeros.size:
+            if int(zeros[-1] - zeros[0] + 1) != int(zeros.size):
+                continue
+            if zeros.size > 2:
