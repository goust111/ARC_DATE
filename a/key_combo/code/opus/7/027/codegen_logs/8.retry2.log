+            path, landing = _trace_span(ordered, c0, c1, start_bottom=-1)
+            if not path:
+                continue
+            candidates.append(
+                {
+                    "c0": c0,
+                    "c1": c1,
+                    "width": span_w,
+                    "path": path,
+                    "landing": landing,
+                }
+            )
+    return candidates
