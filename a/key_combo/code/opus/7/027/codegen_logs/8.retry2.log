+    mask[:, 0] = True
+    mask[:, -1] = True
+    mask[-1, :] = True
+    if frame["gap"] is not None:
+        g0, g1 = frame["gap"]
+        mask[-1, int(g0 - frame["c0"]) : int(g1 - frame["c0"]) + 1] = False
