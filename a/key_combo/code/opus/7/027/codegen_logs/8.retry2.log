+            gap = (int(c0 + 1 + zeros[0]), int(c0 + 1 + zeros[-1]))
+        expected = _frame_mask_from_spec({"r0": r0, "c0": c0, "r1": r1, "c1": c1, "gap": gap})
+        if not np.array_equal(patch == FRAME, expected):
+            continue
+        frames.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "gap": gap,
+                "coords": coords,
