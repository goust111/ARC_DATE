+            (2, 3, 1),
+            (2, 3, 2),
+            (3, 2, 1),
+            (3, 2, 2),
+        ]
+    )
+    valid_tops = [top for top in range(-plate_h + 1, 1) if top <= 0 <= top + plate_h - 1]
+    top = random.choice(valid_tops)
+
+    core = {(0, 0)}
+    seed = {(0, c) for c in range(1, stem_len + 1)}
