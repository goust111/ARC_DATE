        return None
    inside_marker_total, reserved_marker_cells = marker_result

    if not _gen_place_required_strays(inp, out, marker_palette, inside_marker_total, reserved_marker_cells):
        return None

    if not _gen_solver_accepts(inp, out):
        return None
    return inp


