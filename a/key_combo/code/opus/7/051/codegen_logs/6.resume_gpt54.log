+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+LABEL_COLORS = (BLUE, RED, GREEN)
+SPRITE_COLORS = (BLUE, RED, GREEN, ORANGE)
