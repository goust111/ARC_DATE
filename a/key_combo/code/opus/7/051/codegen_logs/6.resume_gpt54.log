+    bg = _majority_color(g)
+    divider, divider_rows, divider_cols = _find_divider_grid(g, bg)
+    row_ranges = _ranges_between(g.shape[0], divider_rows)
+    col_ranges = _ranges_between(g.shape[1], divider_cols)
