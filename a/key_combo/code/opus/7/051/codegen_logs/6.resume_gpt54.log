+                mask.tobytes(),
+                np.fliplr(mask).tobytes(),
+                np.flipud(mask).tobytes(),
+                np.flipud(np.fliplr(mask)).tobytes(),
+            }
+        ) < 3:
+            continue
+        return mask
+    return None
+
+
+def _layout_ranges(cell_count: int, cell_size: int) -> tuple[list[tuple[int, int]], list[int], int]:
