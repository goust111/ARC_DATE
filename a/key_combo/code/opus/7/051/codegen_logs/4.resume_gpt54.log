{
  "type": "move_in_order",
  "src": "overlaid one-cell-thick rectangular frames on the background",
  "dst": "single-column list of frame colors ordered from bottom layer to top layer",
  "transform": "reconstruct each frame from its visible-pixel bbox; at each frame intersection the visible color is above the other frames covering that pixel, then output the unique layer order",
  "grid_shape": "HxW input -> N x 1 output, one row per frame"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 18x19 [observed]
  background: 8 [observed], most-frequent color
  frames:
    count: 4-5 distinct non-bg colors, each forming a 1-cell-thick rectangular frame
    dimensions: height 2-16, width 3-17, minimum dimension >= 2
    structure: frame = border of its bounding box (top/bottom rows, left/right columns)
    overlap: each pair of overlapping frames shares exactly 2 cells (or 4 when one frame's horizontal edge crosses both vertical edges of the other)
    visibility: at overlap cells, the higher-layer frame's color is shown; hidden pixels are inferred from visible-pixel bbox
  layer_order:
    output: Nx1 column listing frame colors bottom-to-top
    constraint: overlap edges must yield a unique topological order (no ambiguity at any step)
    consecutive_pairs: every consecutive pair in the order overlaps (at least 2 shared border cells)
    non_consecutive: some non-adjacent layers may also overlap; all overlaps are consistent with the order
    overlap_edges: n-1 to n+1 directed edges total (always >= n-1 consecutive, sometimes 1-2 extra non-consecutive)
  placement: frames may touch or extend to grid boundary; no requirement for bg border on all sides

generation_strategy:
  approach: output-first — build the layered frame stack, then render the visible input
  steps:
    1. Choose n=4-5 frame colors (distinct, non-bg)
    2. Fix a random layer order (bottom to top) as the ground-truth output
    3. Place frames one at a time from bottom to top; each new frame must have its border cross the border of at least one already-placed frame (ensuring >=2 overlap cells per consecutive pair)
    4. Optionally allow 1-2 extra non-consecutive overlaps, but verify unique topological sort still holds
    5. Render the grid by painting frames bottom-to-top; each frame overwrites any previously painted cells on its border, producing the visible-color-wins effect
    6. Verify: each frame's visible pixels reconstruct its full bbox, and overlap edges yield a unique order
