+    r, c = dest
+    dr, dc = direction
+    limits = []
+    if dr < 0:
+        limits.append(r)
+    elif dr > 0:
+        limits.append(h - 1 - r)
+    if dc < 0:
+        limits.append(c)
+    elif dc > 0:
+        limits.append(w - 1 - c)
