            return True
        for top_row in np.random.permutation(ROW_COUNT - BLOCK_SIZE + 1):
            top_row = int(top_row)
            if _can_place_row(left_cols, rows, idx, top_row):
                rows[idx] = top_row
                if place(idx + 1):
