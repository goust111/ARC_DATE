+) -> list[tuple[int, int, int, int, int, int]] | None:
+    ar, ac = anchor_top_left
+    spec_ids = _cluster_destinations(cluster_name, count)
+    ring_info = []
+    for spec_id in spec_ids:
+        ro, co, dr, dc = RING_SPECS[spec_id]
+        dest = (ar + ro, ac + co)
