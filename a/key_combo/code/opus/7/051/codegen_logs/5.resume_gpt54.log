+def _choose_targets(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]] | None:
+    shuffled = candidates[:]
+    random.shuffle(shuffled)
+    chosen: list[tuple[int, int]] = []
+    used_rows: set[int] = set()
+    used_cols: set[int] = set()
