+    upper_only = random.randint(1, target_count - 1)
+    lower_only = target_count - upper_only
+    base_min = max(8 - upper_only, 8 - lower_only, 6)
+    base_max = min(15 - upper_only, 15 - lower_only, 10)
+    if base_min > base_max:
