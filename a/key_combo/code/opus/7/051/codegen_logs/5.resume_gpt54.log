+
+    markers = _place_markers(lower_mask, targets)
+    if markers is None:
+        return None
+
+    grid = _assemble_input(upper_mask, lower_mask, markers)
+    expected = _assemble_output((height, width), targets, markers)
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
