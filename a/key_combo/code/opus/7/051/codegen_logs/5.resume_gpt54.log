            if 0 <= nr < height and 0 <= nc < width and mask[nr, nc] and (nr, nc) not in seen:
                seen.add((nr, nc))
                stack.append((nr, nc))
    return len(seen) == int(mask.sum())


def _grow_shared_mask(height: int, width: int, size: int) -> np.ndarray | None:
    if height < 5 or width < 7:
