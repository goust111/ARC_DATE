        if tc - mc >= 2 and mc not in other_cols and _is_isolated_from_red(lower_mask, tr, mc):
            path = frozenset((tr, cc) for cc in range(mc + 1, tc))
            candidates.append((tr, mc, "h", path, (tr, tc - 1)))

