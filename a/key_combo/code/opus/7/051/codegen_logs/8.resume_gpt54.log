+        anchors.append({"corner": CORNER_SW, "anchor": (r1 + 1, c0 - 1), "size": size})
+    else:
+        assert occupied == {(0, 1), (1, 0)}
+        anchors.append({"corner": CORNER_NW, "anchor": (r0 - 1, c0 - 1), "size": size})
+        anchors.append({"corner": CORNER_SE, "anchor": (r1 + 1, c1 + 1), "size": size})
