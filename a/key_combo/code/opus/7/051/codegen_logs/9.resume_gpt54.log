+
+    rect_h = r1 - r0 + 1
+    rect_w = c1 - c0 + 1
+    repeat = (rect_h * rect_w) // len(source)
+
+    tile = np.full((rect_h, rect_w), color, dtype=int)
+    return _alternating_reflection_tile(tile, repeat)
