+BG = 0
+FILLER = 6
+FRAME_COLORS = (1, 2, 3, 4, 8)
+ORTHO = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 400
+COUNT_PERMS = [list(p) for p in itertools.permutations((1, 2, 3))]
