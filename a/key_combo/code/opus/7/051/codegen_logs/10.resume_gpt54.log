+
+def _count_crosses_by_frame(
+    grid: np.ndarray,
+    owners: np.ndarray,
+    frame_count: int,
+) -> tuple[list[int], set[tuple[int, int]]]:
+    counts = [0] * frame_count
+    centers: set[tuple[int, int]] = set()
+    h, w = grid.shape
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
