+        if placed != need:
+            return None
+    return chosen_centers
+
+
+def _would_create_unplanned_cross(
+    grid: np.ndarray,
+    owners: np.ndarray,
+    protected: set[tuple[int, int]],
+    cell: tuple[int, int],
+) -> bool:
