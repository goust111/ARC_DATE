+    seg_width = int(rng.choice(np.array(SEGMENT_WIDTH_CHOICES)))
+    height = _randint(rng, max(HEIGHT_RANGE[0], marker_count + 2), HEIGHT_RANGE[1])
+    grid_width = _randint(rng, max(WIDTH_RANGE[0], seg_width + 4), WIDTH_RANGE[1])
