+WIDTH_RANGE = (15, 29)
+SEGMENT_WIDTH_CHOICES = (9, 11, 13)
+MARKER_COUNT_CHOICES = (2, 3, 4)
+MARKER_COUNT_PROBS = (0.15, 0.30, 0.55)
+NON_MARKER_RED_FRAC = (0.30, 0.65)
+MARKER_ROW_RED_FRAC = (0.25, 0.55)
+MARKER_GAP_RANGE = (1, 3)
