def _gen_bounded_composition(n: int, total: int, lo: int, hi: int) -> list[int]:
    parts: list[int] = []
    remaining = total
    for i in range(n):
        left = n - i - 1
        min_here = max(lo, remaining - hi * left)
        max_here = min(hi, remaining - lo * left)
        value = _gen_randint(min_here, max_here)
