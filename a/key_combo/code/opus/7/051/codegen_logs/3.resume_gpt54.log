        center,
        upper center, lower center,
        left center, right center
    """
    anchor = anchor.lower().replace(" ", "").replace("top", "upper").replace("bottom", "lower")
    r0, c0, r1, c1 = map(int, b)
    h = bbox_h(b)
    w = bbox_w(b)

    if anchor == "upperleft":
