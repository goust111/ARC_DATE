+    gray_coords = np.argwhere(g == GREY)
+    for r, c in gray_coords:
+        hits = 0
+        color = GREY
+        for (r0, c0, r1, c1), zone_color in zones:
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                hits += 1
+                color = zone_color
+        if hits == 1:
+            out[r, c] = color
+        elif hits > 1:
+            out[r, c] = BLUE
+    return out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _generate_example()
+        if grid is not None:
+            return grid
