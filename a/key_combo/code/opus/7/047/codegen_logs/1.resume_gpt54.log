+    dr, dc = direction
+    if (dr, dc) == (1, 1):
+        rows = range(r0 + 2, min(r0 + 5, r1))
+        cols = range(c0 + 2, min(c0 + 5, c1))
+    elif (dr, dc) == (1, -1):
+        rows = range(r0 + 2, min(r0 + 5, r1))
+        cols = range(max(c0 + 1, c1 - 4), c1)
