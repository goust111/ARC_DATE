+
+def _trace_full(
+    shape: tuple[int, int],
+    frame_box: tuple[int, int, int, int],
+    arrow_cells: set[tuple[int, int]],
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    wall_cells: set[tuple[int, int]],
+) -> dict:
+    cur = start
+    dr, dc = direction
+    painted: list[tuple[int, int]] = []
+    unsafe: set[tuple[int, int]] = set()
+    bounce_count = 0
+    events: list[str] = []
+    seen: set[tuple[int, int, int, int]] = set()
+
+    while True:
+        state = (cur[0], cur[1], dr, dc)
+        if state in seen:
+            return {
+                "painted": painted,
+                "unsafe": unsafe,
+                "bounce_count": bounce_count,
+                "stop": "loop",
+                "events": events,
+            }
+        seen.add(state)
+        segment = _trace_until_event(shape, frame_box, arrow_cells, cur, (dr, dc), wall_cells)
+        painted.extend(segment["cells"])
+        unsafe |= segment["unsafe"]
+        event = segment["event"]
+        if event in {"frame", "arrow", "out", "loop"}:
+            return {
+                "painted": painted,
+                "unsafe": unsafe,
+                "bounce_count": bounce_count,
+                "stop": event,
+                "events": events,
+            }
+        bounce_count += 1
+        events.append(event)
+        cur = segment["end_cur"]
+        dr, dc = segment["end_dir"]
