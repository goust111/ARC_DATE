+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+PINK = 6
+MAROON = 9
+
+BAND_COLORS = (RED, BLUE, YELLOW)
+DIAGONALS = ((1, 1), (1, -1), (-1, 1), (-1, -1))
+MAX_GENERATION_ATTEMPTS = 500
