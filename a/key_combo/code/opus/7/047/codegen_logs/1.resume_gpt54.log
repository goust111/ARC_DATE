+
+def _band_color(r: int, c: int, frame_box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = frame_box
+    depth = min(r - r0, r1 - r, c - c0, c1 - c)
+    assert depth >= 1
+    return BAND_COLORS[(depth - 1) % len(BAND_COLORS)]
