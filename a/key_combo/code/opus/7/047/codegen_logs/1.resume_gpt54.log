+    H, W = shape
+    r0, c0, r1, c1 = frame_box
+    grid = np.zeros((H, W), dtype=int)
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+    grid[r0, c0 : c1 + 1] = GREY
+    grid[r1, c0 : c1 + 1] = GREY
+    for r, c in arrow_cells:
+        grid[r, c] = PINK
+    for r, c in wall_cells:
+        grid[r, c] = MAROON
