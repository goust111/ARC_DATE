+    for r, c in pts:
+        deg[(r, c)] = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+    start = next(cell for cell, degree in deg.items() if degree == 2)
+    return pts, (int(start[0]), int(start[1])), (int(dr), int(dc))
