+    unsafe_prefix: set[tuple[int, int]] = set()
+    cur = start
+    cur_dir = direction
+
+    for bounce_index in range(target_bounces):
+        options = _bounce_candidates(frame_box, cur, cur_dir)
+        rng.shuffle(options)
