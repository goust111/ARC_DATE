+                "event": "out",
+                "cells": cells,
+                "unsafe": unsafe,
+                "end_cur": cur,
+                "end_dir": (dr, dc),
+                "trigger": None,
+            }
+        if (nr, nc) in arrow_cells:
+            return {
+                "event": "arrow",
+                "cells": cells,
+                "unsafe": unsafe,
+                "end_cur": cur,
+                "end_dir": (dr, dc),
+                "trigger": None,
+            }
