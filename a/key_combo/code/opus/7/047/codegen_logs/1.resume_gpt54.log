+        options = _bounce_candidates(frame_box, cur, cur_dir)
+        rng.shuffle(options)
+        options.sort(
+            key=lambda item: (
+                0 if item[0] == "head" else 1,
+                -item[2] if bounce_index < target_bounces - 1 else item[2],
