+                "end_dir": (-dr, -dc),
+                "trigger": (nr, nc),
+            }
+
+        cur = (nr, nc)
+        cells.append(cur)
+
+        side_r = (cur[0] + dr, cur[1])
+        side_c = (cur[0], cur[1] + dc)
+        if 0 <= side_r[0] < H and 0 <= side_r[1] < W:
+            unsafe.add(side_r)
+        if 0 <= side_c[0] < H and 0 <= side_c[1] < W:
+            unsafe.add(side_c)
+
+        hit_r = side_r in wall_cells
+        hit_c = side_c in wall_cells
+        if hit_r or hit_c:
+            if hit_r and hit_c:
+                event = "side_both"
+                trigger = frozenset((side_r, side_c))
+                new_dir = (-dr, -dc)
+            elif hit_r:
+                event = "side_r"
+                trigger = side_r
+                new_dir = (-dr, dc)
+            else:
+                event = "side_c"
+                trigger = side_c
+                new_dir = (dr, -dc)
+            return {
+                "event": event,
+                "cells": cells,
+                "unsafe": unsafe,
+                "end_cur": cur,
+                "end_dir": new_dir,
+                "trigger": trigger,
+            }
