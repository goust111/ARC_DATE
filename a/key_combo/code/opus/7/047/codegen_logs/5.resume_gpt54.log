+
+def _draw_frame(grid: np.ndarray, rect: Rect) -> None:
+    r0, c0, r1, c1 = rect
+    grid[r0 : r1 + 1, c0] = GREEN
+    grid[r0 : r1 + 1, c1] = GREEN
+    grid[r0, c0 : c1 + 1] = GREEN
+    grid[r1, c0 : c1 + 1] = GREEN
