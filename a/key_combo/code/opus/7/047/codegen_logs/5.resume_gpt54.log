+            return False
+        chosen = _spanning_edges(edges, len(rects))
+        if len({edge["gap"] for edge in edges}) != len(edges):
+            return False
+        if len(rects) >= 4 and len(edges) < len(rects):
+            return False
+        if not _is_unique_mst(edges, len(rects)):
