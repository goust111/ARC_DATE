def _spanning_edges(edges: list[dict], n_rects: int) -> list[dict]:
    parent = list(range(n_rects))

    def find(x: int) -> int:
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a: int, b: int) -> None:
