+    if room_count == 5:
+        rects = _add_leaf(rects, (h, w))
+        if rects is None:
+            return None
+
+    grid = np.zeros((h, w), dtype=int)
+    for rect in rects:
+        _draw_frame(grid, rect)
+    if not _valid_generated_grid(grid):
+        return None
+    return grid
