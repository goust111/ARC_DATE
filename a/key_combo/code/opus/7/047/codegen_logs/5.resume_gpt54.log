+
+
+def _edge_signature(edge: dict) -> tuple:
+    return edge["gap"], edge["kind"], edge["a"], edge["b"], edge["r0"], edge["r1"], edge["c0"], edge["c1"]
+
+
+def _is_unique_mst(edges: list[dict], n_rects: int) -> bool:
