+            overlap = min(pr1 - 1, r1 - 1) - max(pr0 + 1, r0 + 1) + 1
+            if overlap < 3:
+                continue
+            if r0 < 1 or c0 < 1 or r1 >= shape[0] - 1 or c1 >= shape[1] - 1:
+                continue
+            out.append((r0, c0, r1, c1))
+    else:
+        if side == "up":
+            r0 = pr0 - gap - h
+        else:
+            r0 = pr1 + gap + 1
+        r1 = r0 + h - 1
+        for c0 in range(pc0 - w + 4, pc1 - 1):
+            c1 = c0 + w - 1
+            overlap = min(pc1 - 1, c1 - 1) - max(pc0 + 1, c0 + 1) + 1
+            if overlap < 3:
+                continue
+            if r0 < 1 or c0 < 1 or r1 >= shape[0] - 1 or c1 >= shape[1] - 1:
