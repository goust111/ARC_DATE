        def temp_find(x: int) -> int:
            temp_parent.setdefault(x, x)
            while temp_parent[x] != x:
                temp_parent[x] = temp_parent[temp_parent[x]]
                x = temp_parent[x]
            return x

        for edge in eligible:
            ra = find(edge["a"])
            rb = find(edge["b"])
            ta = temp_find(ra)
            tb = temp_find(rb)
            assert ta != tb
