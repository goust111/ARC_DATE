+    enclosed = _enclosed_black_mask(out)
+    dist = _distance_field(out, enclosed)
+    for r, c in np.argwhere(enclosed):
+        rr = int(r)
+        cc = int(c)
+        out[rr, cc] = _color_for_distance(int(dist[rr, cc]))
+    return out
