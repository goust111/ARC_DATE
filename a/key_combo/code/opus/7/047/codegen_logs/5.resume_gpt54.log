+
+def _row_gap(a: Rect, b: Rect) -> int:
+    if a[2] < b[0]:
+        return b[0] - a[2] - 1
+    if b[2] < a[0]:
+        return a[0] - b[2] - 1
+    return 0
+
+
+def _col_gap(a: Rect, b: Rect) -> int:
+    if a[3] < b[1]:
+        return b[1] - a[3] - 1
+    if b[3] < a[1]:
+        return a[1] - b[3] - 1
+    return 0
+
