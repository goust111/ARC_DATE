+        for right in bars[i + 1 :]:
+            if abs(left.row - right.row) != 1:
+                continue
+            if _overlap_interval(left.c0, left.c1, right.c0, right.c1) is not None:
+                return False
+    return True
+
+
+def _build_grid(h: int, w: int, bars: list[Bar], tiles: list[Tile]) -> np.ndarray:
