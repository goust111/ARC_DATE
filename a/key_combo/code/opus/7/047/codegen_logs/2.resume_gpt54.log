+
+    @property
+    def h(self) -> int:
+        return int(self.pattern.shape[0])
+
+    @property
+    def w(self) -> int:
+        return int(self.pattern.shape[1])
+
+    @property
+    def r1(self) -> int:
+        return self.r0 + self.h - 1
+
+    @property
+    def c1(self) -> int:
+        return self.c0 + self.w - 1
+
+
+def _neighbors4(r: int, c: int, h: int, w: int):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[Component]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[Component] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            bbox = (min(rows), min(cols), max(rows), max(cols))
+            comps.append(Component(tuple(sorted(coords)), bbox))
+    return comps
+
+
+def _detect_objects(grid: np.ndarray) -> tuple[list[Bar], list[Tile]]:
+    bars: list[Bar] = []
+    tiles: list[Tile] = []
+    for comp in _components(grid != BACKGROUND):
+        r0, c0, r1, c1 = comp.bbox
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        area = len(comp.coords)
