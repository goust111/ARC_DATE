+                    "cause": "boundary" if not in_bounds(grid.shape, nr, nc) else "obstacle",
+                    "both_open": bool(options[0] and options[1]),
+                    "pos": pos,
+                    "blocked_cell": (nr, nc),
+                    "blocked_is_copy": (nr, nc) in copy_obstacles,
