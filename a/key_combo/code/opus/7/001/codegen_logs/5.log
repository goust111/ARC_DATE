+        if _path_signature(no_copy_sim) == _path_signature(final_sim):
+            continue
+
+        input_grid = base_obstacles.copy()
+        input_grid[start] = START
+        input_grid[end] = END
+        if not _base_has_valid_start_neighborhood(base_obstacles, start):
+            continue
+        return input_grid
+
+    return None
+
