+def _copy_positions(h: int, w: int, pos: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = pos
+    return [
+        (r, c),
+        (r, 2 * w - 1 - c),
+        (2 * h - 1 - r, c),
+        (2 * h - 1 - r, 2 * w - 1 - c),
+    ]
