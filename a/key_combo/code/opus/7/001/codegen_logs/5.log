+            continue
+        seen.add(pos)
+        if pos[0] >= h or pos[1] >= w:
+            continue
+        if not (0 < pos[0] < h - 1 and 0 < pos[1] < w - 1):
+            continue
+        candidates.append(pos)
+    random.shuffle(candidates)
+
+    for end in candidates[:24]:
