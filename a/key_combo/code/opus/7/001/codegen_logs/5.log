    full=np.block([[base, np.fliplr(base)], [np.flipud(base), np.flipud(np.fliplr(base))]])
    sr,sc=start
    copy_positions={(sr,2*w-1-sc),(2*h-1-sr,sc),(2*h-1-sr,2*w-1-sc)}
    if end is not None:
        er,ec=end
        end_copy_positions={(er,2*w-1-ec),(2*h-1-er,ec),(2*h-1-er,2*w-1-ec)}
    else:
        end_copy_positions=set()
    if convert_copies:
        for p in copy_positions|end_copy_positions: full[p]=8
    if end is not None: full[end]=2
    full[start]=3
    return full, copy_positions|end_copy_positions

def sim(full, copy_pos=set()):
    H,W=full.shape
    s=tuple(map(int,np.argwhere(full==3)[0]))
    e=np.argwhere(full==2)
    e=tuple(map(int,e[0])) if len(e) else None
    dirs=[(-1,0),(0,1),(1,0),(0,-1)]
    obs=[]
    for d,(dr,dc) in enumerate(dirs):
        nr,nc=s[0]+dr,s[1]+dc
        if 0<=nr<H and 0<=nc<W and full[nr,nc]==8:
            obs.append(d)
    if len(obs)"'!=1: return None
    d=(obs[0]+2)%4
    pos=s
    seen={(pos,d)}
    path=[]; events=[]
    for _ in range(H*W*8):
        dr,dc=dirs[d]; nr,nc=pos[0]+dr,pos[1]+dc
        if e is not None and (nr,nc)==e:
            return {'"'ok':True,'path':path,'events':events}
        blocked=not(0<=nr<H and 0<=nc<W) or full[nr,nc]==8
        if blocked:
            cause='boundary' if not (0<=nr<H and 0<=nc<W) else 'obstacle'
            blocked_cell=(nr,nc)
            ld=(d-1)%4; rd=(d+1)%4
            opts=[]
            for nd in [ld,rd]:
                rr,cc=pos[0]+dirs[nd][0], pos[1]+dirs[nd][1]
                ok=(0<=rr<H and 0<=cc<W and full[rr,cc]"'!=8)
                opts.append(ok)
            if not any(opts): return {'"'ok':False,'path':path,'events':events,'stop':'dead'}
            both=all(opts)
            d=ld if opts[0] else rd
            events.append((cause,both,pos,d,blocked_cell, blocked_cell in copy_pos))
            dr,dc=dirs[d]; nr,nc=pos[0]+dr,pos[1]+dc
            if e is not None and (nr,nc)==e:
                return {'ok':True,'path':path,'events':events}
        if not (0<=nr<H and 0<=nc<W) or full[nr,nc]==8:
            return {'ok':False,'path':path,'events':events,'stop':'bad'}
        pos=(nr,nc); path.append(pos)
        state=(pos,d)
        if state in seen: return {'ok':False,'path':path,'events':events,'stop':'loop'}
        seen.add(state)
    return {'ok':False,'path':path,'events':events,'stop':'cap'}

def small(base,start,end):
    g=base.copy(); g[start]=3; g[end]=2
    return sim(g)

