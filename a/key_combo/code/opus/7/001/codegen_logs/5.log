+    h, w = base_obstacles.shape
+    tiled_without_end, start_copy_obstacles = _build_tiled_grid(
+        base_obstacles,
+        start,
+        start,
+        convert_end_copies=False,
+    )
+    tiled_without_end[start] = START
+    no_end_sim = _simulate_path(
