0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """
0009:     Straighten the single foreground mask into a centered horizontal segment of the same color and length.
0010: 
0011:     Input structure:
0012:     - The grid has one dominant background color.
0013:     - All non-background pixels share one foreground color.
0014:     - The number of foreground pixels fits in one centered row of the grid.
0015: 
0016:     Rule:
0017:     - Erase the original foreground mask.
0018:     - Count its pixels, keep its color, and paint that many pixels as a horizontal segment.
0019:     - Place the segment on the middle row with equal background margin on the left and right.
0020: 
0021:     Key insight:
0022:     - The original foreground shape is irrelevant except for its color and area; the output is the area normalized into the grid's central horizontal line.
0023:     """
0024:     g = np.asarray(grid, dtype=int)
