+def _render_specs(height: int, width: int, specs: list[dict]) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    for spec in specs:
+        mask = spec["mask"]
+        r0 = spec["r0"]
+        c0 = spec["c0"]
+        rr, cc = np.argwhere(mask).T
