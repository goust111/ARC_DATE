+
+    striped_rows = 0
+    solid_rows = 0
+    for spec in specs:
+        row = expected[spec["r0"]]
+        tail = row[spec["c0"] - 1 :]
+        if spec["symmetric"]:
+            striped_rows += int(GREY in tail)
+        else:
+            solid_rows += int(np.all(np.isin(tail[tail != BLUE], [RED])))
+    if striped_rows == 0 or solid_rows == 0:
+        raise AssertionError("missing visible branch evidence")
+
