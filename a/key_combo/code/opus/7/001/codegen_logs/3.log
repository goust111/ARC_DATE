0035:     assert height % 2 == 1, "expected a unique middle row"
0036:     assert (width - count) % 2 == 0, "foreground segment must center with equal side margins"
0037: 
0038:     out = np.full(g.shape, bg, dtype=int)
0039:     row = height // 2
0040:     start = (width - count) // 2
0041:     out[row, start : start + count] = color
