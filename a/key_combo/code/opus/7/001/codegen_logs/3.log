0027:     bg = get_bg(g)
0028: 
0029:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0030:     rectangles = []
0031:     markers = []
0032:     for comp in components:
0033:         h = bbox_h(comp["bbox"])
0034:         w = bbox_w(comp["bbox"])
