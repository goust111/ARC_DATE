+    gaps = len(heights) + 1
+    base = [1] + [3] * (len(heights) - 1) + [1]
+    extra = height - (sum(heights) + sum(base))
+    for _ in range(extra):
+        base[random.randrange(gaps)] += 1
+
+    starts = []
+    r = base[0]
+    for idx, obj_h in enumerate(heights):
+        starts.append(r)
+        r += obj_h
+        if idx + 1 < len(heights):
+            r += base[idx + 1]
+    return starts
+
