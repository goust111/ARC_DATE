import random, itertools
import numpy as np

COLORS=[2,3,4,7]

def center_dist(n,r,c):
    mid=n-1
    return abs(2*r-mid)+abs(2*c-mid)

def build(n, markers):
    out=np.zeros((n,n),dtype=int)
    first=np.full((n,n),-1,dtype=int)
    overlap=np.zeros((n,n),dtype=bool)
    for r,c,color in markers:
        cells=[(r,cc) for cc in range(n)] + [(rr,c) for rr in range(n)]
        for rr,cc in cells:
            prev=first[rr,cc]
            if prev==-1:
                first[rr,cc]=color
            elif prev"'!=color:
                overlap[rr,cc]=True
    mask=(first!=-1)&(~overlap)
    out[mask]=first[mask]
    return out

def compress(grid, markers):
    n=grid.shape[0]; b=n//3
    dmap={color:center_dist(n,r,c) for r,c,color in markers}
    out=np.zeros((3,3),dtype=int)
    tie=False
    for br in range(3):
      for bc in range(3):
        block=grid[br*b:(br+1)*b,bc*b:(bc+1)*b]
        vals, cnts=np.unique(block[block!=0], return_counts=True)
        if len(vals)==0: continue
        m=cnts.max(); cand=[int(v) for v,c in zip(vals,cnts) if c==m]
        if len(cand)>1:
            tie=True
            md=min(dmap[v] for v in cand)
            cand=[v for v in cand if dmap[v]==md]
            if len(cand)!=1:
                return None, None
        out[br,bc]=cand[0]
    return out, tie

def preclear(n, markers):
