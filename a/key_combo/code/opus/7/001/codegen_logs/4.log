0007: def main(grid: np.ndarray) -> np.ndarray:
0008:     """Move each maroon marker toward the blue rectangle and recolor the rectangle red.
0009: 
0010:     Input structure
0011:     A background canvas contains one solid blue rectangular object and several isolated
0012:     maroon marker pixels. Each marker is horizontally or vertically aligned with the
0013:     rectangle and lies outside it.
0014: 
0015:     Rule
0016:     Start with a background canvas, repaint the blue rectangle red, and move each
0017:     maroon marker straight toward the rectangle along its row or column. Exactly one
0018:     marker is strictly closer to the rectangle than all others and enters the
0019:     rectangle boundary; every other marker lands in the adjacent exterior cell just
0020:     outside its aligned side.
0021: 
0022:     Key insight
0023:     The single entering marker is the unique global nearest marker to the rectangle,
0024:     not the nearest marker on each of the four sides.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     bg = get_bg(g)
0028: 
0029:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0030:     rectangles = []
0031:     markers = []
0032:     for comp in components:
0033:         h = bbox_h(comp["bbox"])
0034:         w = bbox_w(comp["bbox"])
