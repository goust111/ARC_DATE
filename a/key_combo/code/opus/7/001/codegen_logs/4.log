+def _compress_grid(grid: np.ndarray, distance_by_color: dict[int, int]) -> tuple[np.ndarray, int, int]:
+    size = int(grid.shape[0])
+    block = size // 3
+    out = np.zeros((3, 3), dtype=int)
+    tie_blocks = 0
+    strict_blocks = 0
+    for br in range(3):
