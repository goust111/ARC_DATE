+def _render_cleared_crosses(shape: tuple[int, int], color_masks: dict[int, np.ndarray]) -> np.ndarray:
+    cover_count = np.zeros(shape, dtype=int)
+    first_color = np.zeros(shape, dtype=int)
+    for color, mask in color_masks.items():
