+    canvas = np.zeros(shape, dtype=int)
+    draw_line(canvas, r=r, c=0, direction=(0, 1), color=1)
+    draw_line(canvas, r=0, c=c, direction=(1, 0), color=1)
+    return canvas.astype(bool)
