+def _on_outline(rect: Rect, r: int, c: int) -> bool:
+    return rect.r0 <= r <= rect.r1 and rect.c0 <= c <= rect.c1 and (r in (rect.r0, rect.r1) or c in (rect.c0, rect.c1))
