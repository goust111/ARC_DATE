+def _bbox_spans_enough(mask: np.ndarray) -> bool:
+    box = bbox(mask)
+    if box is None:
+        return False
+    r0, c0, r1, c1 = box
+    return (r1 - r0 + 1) >= 4 and (c1 - c0 + 1) >= 3
+
+
+def _neighbors8(height: int, width: int, row: int, col: int) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = row + dr
+            cc = col + dc
+            if 0 <= rr < height and 0 <= cc < width:
+                out.append((rr, cc))
+    return out
