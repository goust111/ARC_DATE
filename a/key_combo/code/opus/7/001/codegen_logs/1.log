+    for _ in range(80):
+        area = height * half_width
+        target = random.randint(
+            max(1, int(np.ceil(TARGET_FILL_RATIO_RANGE[0] * area))),
+            max(1, int(np.floor(TARGET_FILL_RATIO_RANGE[1] * area))),
