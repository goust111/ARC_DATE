+) -> dict | None:
+    rr0, rc0, rr1, rc1 = rect_bbox
+    shape = _choose_shape(symmetric)
+    pts = np.array(shape, dtype=int)
+    shape_h = int(pts[:, 0].max()) + 1
+    shape_w = int(pts[:, 1].max()) + 1
