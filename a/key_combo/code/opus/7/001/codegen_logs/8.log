        center_r, center_c = bbox_anchor(b, anchor="center")
        out[center_r, :] = Color.PINK
        out[:, center_c] = Color.PINK
    
    # Redraw the objects
    for obj in objects:
        out = paste(out, obj, 0, 0, transparent=background)
    
    return out

