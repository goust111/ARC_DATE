+    sh, sw = sprite.shape
+    if top < 0 or left < 0 or top + sh > h or left + sw > w:
+        return False
+
+    sprite_coords = np.argwhere(sprite != BLACK)
+    if sprite_coords.size == 0:
+        return False
+    if max(int(left + c) for _, c in sprite_coords) >= w / 2:
+        return False
