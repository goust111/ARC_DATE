+def _right_contour(coords: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    return sorted(
+        [(r, c) for r, c in coords if not any(rr == r and cc > c for rr, cc in coords)],
+        key=lambda rc: (rc[0], rc[1]),
+    )
+
