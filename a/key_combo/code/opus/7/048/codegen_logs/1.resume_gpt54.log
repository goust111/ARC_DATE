+def _boundary_scan(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    order: list[tuple[int, int]] = []
+    for c in range(w):
+        order.append((0, c))
+    for r in range(1, h):
