import numpy as np, random
from collections import deque, Counter

def scan_order(n):
    pts=[]
    for c in range(n): pts.append((0,c))
    for r in range(1,n): pts.append((r,n-1))
    for c in range(n-2,-1,-1): pts.append((n-1,c))
    for r in range(n-2,0,-1): pts.append((r,0))
    return pts

def init_dir(n,r,c):
    if r==0 and c==0: return 1,1
    if r==0 and c==n-1: return 1,-1
    if r==n-1 and c==0: return -1,1
    if r==n-1 and c==n-1: return -1,-1
    if r==0: return 1,1
    if r==n-1: return -1,1
    if c==0: return 1,1
    if c==n-1: return 1,-1

def draw(grid):
    n=grid.shape[0]; order=scan_order(n); starts=[p for p in order if grid[p]"'!=0]; g=grid.copy()
    for sr,sc in starts:
        color=int(g[sr,sc]); r,c=sr,sc; dr,dc=init_dir(n,r,c)
        while True:
            nr=r+dr; nc=c+dc
            if not (0<=nr<n): dr=-dr; nr=r+dr
            if not (0<=nc<n): dc=-dc; nc=c+dc
            if (nr,nc)==(sr,sc) or g[nr,nc]!=0: break
            g[nr,nc]=color; r,c=nr,nc
    return g

def enclosed(g):
    n=g.shape[0]
    ext=np.zeros_like(g,dtype=bool)
    dq=deque()
    for i in range(n):
        for p in ((0,i),(n-1,i),(i,0),(i,n-1)):
            r,c=p
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append(p)
    while dq:
        r,c=dq.popleft()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<n and 0<=nc<n and g[nr,nc]==0 and not ext[nr,nc]: ext[nr,nc]=True; dq.append((nr,nc))
    return int(np.count_nonzero((g==0)&(~ext)))

for n in [13,15,17]:
  order=scan_order(n)
  goods=[]
  for i,p1 in enumerate(order):
    for p2 in order[i+1:]:
      grid=np.zeros((n,n),int); grid[p1]=2; grid[p2]=3
      e=enclosed(draw(grid))
      if e>=3:
        goods.append((e,p1,p2))
  print('"'n',n,'count',len(goods),'best',sorted(goods, reverse=True)[:10])
