+        colors = random.sample(PALETTE, 2)
+        return colors
+
+    if num_starts == 3:
+        if random.random() < 0.55:
+            colors = random.sample(PALETTE, 3)
+            return colors
+        a, b = random.sample(PALETTE, 2)
+        colors = [a, a, b]
+        random.shuffle(colors)
+        return colors
+
+    if random.random() < 0.45:
+        a, b = random.sample(PALETTE, 2)
+        colors = [a, a, b, b]
+    else:
