+
+def _boundary_scan(shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    order: list[tuple[int, int]] = []
+    for c in range(w):
+        order.append((0, c))
+    for r in range(1, h):
+        order.append((r, w - 1))
+    for c in range(w - 2, -1, -1):
+        order.append((h - 1, c))
+    for r in range(h - 2, 0, -1):
+        order.append((r, 0))
+    return order
+
+
+def _initial_direction(shape: tuple[int, int], r: int, c: int) -> tuple[int, int]:
+    h, w = map(int, shape)
+    if r == 0 and c == 0:
+        return 1, 1
+    if r == 0 and c == w - 1:
+        return 1, -1
+    if r == h - 1 and c == 0:
+        return -1, 1
+    if r == h - 1 and c == w - 1:
+        return -1, -1
+    if r == 0:
+        return 1, 1
+    if r == h - 1:
+        return -1, 1
+    if c == 0:
+        return 1, 1
+    if c == w - 1:
+        return 1, -1
+    raise AssertionError("start must lie on the boundary")
