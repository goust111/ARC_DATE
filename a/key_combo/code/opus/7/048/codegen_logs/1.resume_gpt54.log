GRID_WIDTH_RANGE = (12, 20)
BBOX_HEIGHT_RANGE = (6, 10)
BBOX_WIDTH_RANGE = (8, 14)
BBOX_MARGIN = 1
MAX_BBOX_ASPECT = 1.75

# Marker color/pattern and retry limit.
