+def _advance_with_reflection(
+    shape: tuple[int, int], r: int, c: int, dr: int, dc: int
+) -> tuple[int, int, int, int]:
+    h, w = map(int, shape)
+    nr = r + dr
+    nc = c + dc
+    if nr < 0 or nr >= h:
+        dr = -dr
+        nr = r + dr
+    if nc < 0 or nc >= w:
+        dc = -dc
+        nc = c + dc
+    return nr, nc, dr, dc
+
+
+def _trace_rays(
+    grid: np.ndarray,
+) -> tuple[np.ndarray, list[tuple[int, int]], dict[int, int], list[int]]:
