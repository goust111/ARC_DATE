+        grid = np.zeros((n, n), dtype=int)
+        for (r, c), color in zip(positions, colors):
+            grid[r, c] = color
+
+        require_tie = random.random() < 0.2
+        if _valid_input(grid, require_tie=require_tie):
+            return grid
