+            (2 * center_r - r, 2 * center_c - c),
+            (2 * center_r - r, c),
+            (r, 2 * center_c - c),
+        )
+        fill = None
+        for rr, cc in candidates:
+            color = int(out[rr, cc])
+            if color != HOLE:
+                fill = color
+                break
