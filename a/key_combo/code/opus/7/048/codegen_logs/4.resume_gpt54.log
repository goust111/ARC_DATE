+    count = random.choice(BOX_COUNT_CHOICES)
+    marker_colors = random.sample(MARKER_COLORS, count)
+    boxes = [_build_box(mode, color) for mode, color in zip(_box_modes(count), marker_colors)]
+    placed = _place_boxes(boxes)
+    if placed is None:
