+
+    inp, expected = placed
+    for color in PATTERN_COLORS:
+        if int(np.count_nonzero(inp == color)) == 3:
+            return None
+    if not np.array_equal(main(inp), expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
