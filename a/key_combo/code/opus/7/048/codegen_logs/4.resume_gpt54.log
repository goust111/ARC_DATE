+        patch[center_r, center_c - dc] = color
+        patch[center_r, center_c + dc] = color
+    for dr in range(1, center_r + 1):
+        color = random.choice(PATTERN_COLORS)
+        patch[center_r - dr, center_c] = color
+        patch[center_r + dr, center_c] = color
