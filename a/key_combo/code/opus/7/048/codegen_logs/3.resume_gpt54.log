+        r, c, dr, dc = stack.pop()
+        state = (r, c, dr, dc)
+        if state in seen_rays:
+            continue
+        seen_rays.add(state)
+
+        rr, cc = r, c
+        while True:
+            nr, nc = rr + dr, cc + dc
+            if not (0 <= nr < h and 0 <= nc < w):
+                break
+
+            if marker_mask[nr, nc]:
+                marker = (int(nr), int(nc))
+                if marker not in opened_markers:
