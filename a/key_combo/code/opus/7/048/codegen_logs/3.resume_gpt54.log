+    target_marker_count = random.randint(5, 8)
+    base_pattern = random.choice(FIVE_MARKER_PATTERNS) if target_marker_count == 5 else SIX_MARKER_PATTERN
+
+    grid = np.zeros((h, w), dtype=int)
+    grid[start_r, 0] = RED
+    for idx in base_pattern:
