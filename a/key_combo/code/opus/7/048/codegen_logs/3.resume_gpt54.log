+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+MAX_ATTEMPTS = 500
+FIVE_MARKER_PATTERNS = (
+    (0, 1, 2, 3, 4),
+    (0, 1, 2, 3, 5),
