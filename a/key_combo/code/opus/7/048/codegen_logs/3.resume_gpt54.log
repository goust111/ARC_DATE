                dq=deque([(r,c)]); reg[r,c]=rid
                while dq:
                    rr,cc=dq.popleft()
                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and not wall[nr,nc] and not ext[nr,nc] and reg[nr,nc]==0:
                            reg[nr,nc]=rid; dq.append((nr,nc))
    counts={i:0 for i in range(1,rid+1)}
