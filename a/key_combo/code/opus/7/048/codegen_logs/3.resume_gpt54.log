from collections import deque
import hashlib, random
import numpy as np

BLUE, RED, GREEN, YELLOW = 1,2,3,4

PATTERNS_5=((0,1,2,3,4),(0,1,2,3,5),(0,1,2,4,5))
PATTERN_6=(0,1,2,3,4,5)


def trace(grid):
    g=np.asarray(grid,dtype=int)
    H,W=g.shape
    start=np.argwhere(g==RED)
    assert len(start)==1 and start[0,1]==0
    marker_mask=(g==GREEN)
    out=g.copy()
    opened=set(); seen=set(); stack=[(int(start[0,0]),0,0,1)]
    while stack:
        r,c,dr,dc=stack.pop()
        state=(r,c,dr,dc)
        if state in seen:
            continue
        seen.add(state)
        rr,cc=r,c
        while True:
            nr,nc=rr+dr,cc+dc
            if not (0<=nr<H and 0<=nc<W):
                break
            if marker_mask[nr,nc]:
                marker=(int(nr),int(nc))
                if marker not in opened:
                    opened.add(marker)
                    if dr==0:
                        stack.append((rr,cc,-1,0))
                        stack.append((rr,cc,1,0))
                    else:
                        stack.append((rr,cc,0,-1))
                        stack.append((rr,cc,0,1))
                break
            if g[nr,nc]==0:
                out[nr,nc]=RED
            rr,cc=nr,nc
    return out, opened


def exterior(wall):
    H,W=wall.shape
    ext=np.zeros((H,W),dtype=bool)
    dq=deque()
    for r,c in ((0,0),(0,W-1),(H-1,0),(H-1,W-1)):
        if not wall[r,c] and not ext[r,c]:
            ext[r,c]=True; dq.append((r,c))
    while dq:
        r,c=dq.popleft()
        for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and not wall[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=True; dq.append((nr,nc))
    return ext


def analyze(grid):
    ray_grid, opened = trace(grid)
    wall=(ray_grid==RED)|(grid==GREEN)
    ext=exterior(wall)
    H,W=grid.shape
    region=np.zeros((H,W),dtype=int)
    rid=0
    dq=deque()
    for r in range(H):
        for c in range(W):
            if wall[r,c] or ext[r,c] or region[r,c]:
                continue
            rid+=1
            region[r,c]=rid
            dq.append((r,c))
            while dq:
                rr,cc=dq.popleft()
                for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and not wall[nr,nc] and not ext[nr,nc] and region[nr,nc]==0:
                        region[nr,nc]=rid
                        dq.append((nr,nc))
    counts={i:0 for i in range(1,rid+1)}
    for mr,mc in map(tuple,np.argwhere(grid==GREEN)):
        adj=set()
        for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
            nr,nc=mr+dr,mc+dc
            if 0<=nr<H and 0<=nc<W and region[nr,nc]>0:
                adj.add(int(region[nr,nc]))
        for x in adj:
            counts[x]+=1
    out=ray_grid.copy()
    for i,cnt in counts.items():
        out[region==i]=BLUE if cnt%2 else YELLOW
    return out, region, counts, ray_grid


def spacing_ok(markers, cand):
    r,c=cand
    for mr,mc in markers:
        if max(abs(r-mr),abs(c-mc))<=1:
            return False
    return True


def sample_base_points():
    H=random.randint(16,22)
    W=random.randint(16,24)
    start_r=random.randint(H//3, (2*H)//3)
    first_c=random.randint(3,5)
    top_max=start_r-2
    bottom_max=H-start_r-3
    if top_max<3 or bottom_max<4:
        return None
    top_span=random.randint(3, top_max)
    bottom_span=random.randint(3, bottom_max-1)
    right_c=random.randint(first_c+5, W-3)
    pts=[
        (start_r, first_c),
        (start_r-top_span, first_c-1),
        (start_r+bottom_span, first_c-1),
        (start_r-top_span+1, right_c),
        (start_r+bottom_span-1, right_c),
        (start_r+bottom_span+1, right_c-1),
    ]
    if any(r<=0 or c<=0 or r>=H-1 or c>=W-1 for r,c in pts):
        return None
    ms=[]
    for p in pts:
        if not spacing_ok(ms,p):
            return None
        ms.append(p)
    return H,W,start_r,pts


def add_extras(grid, base_red, region, need):
    g=grid.copy()
    markers=list(map(tuple,np.argwhere(g==GREEN)))
    H,W=g.shape
    candidates=[]
    for r in range(1,H-1):
        for c in range(1,W-1):
            if g[r,c]"'!=0 or region[r,c]==0:
                continue
            rid=region[r,c]
            if region[r-1,c]!=rid or region[r+1,c]!=rid or region[r,c-1]!=rid or region[r,c+1]!=rid:
                continue
            if not spacing_ok(markers,(r,c)):
                continue
            candidates.append((r,c))
    random.shuffle(candidates)
    placed=0
    for cand in candidates:
        trial=g.copy(); trial[cand]=GREEN
        out2, region2, counts2, red2=analyze(trial)
        vals=list(counts2.values())
        if np.array_equal(red2, base_red) and region2.max()>=2 and any(v%2 for v in vals) and any(v%2==0 for v in vals):
            g=trial; markers.append(cand); placed+=1
            if placed==need:
                return g
    return None


def generate():
    for _ in range(500):
        base=sample_base_points()
        if base is None:
            continue
        H,W,start_r,pts=base
        target=random.randint(5,8)
        if target==5:
            idxs=random.choice(PATTERNS_5)
        else:
            idxs=PATTERN_6
        g=np.zeros((H,W),dtype=int); g[start_r,0]=RED
        for i in idxs:
            r,c=pts[i]; g[r,c]=GREEN
        out, region, counts, base_red = analyze(g)
        vals=list(counts.values())
        if region.max()<2 or not any(v%2 for v in vals) or not any(v%2==0 for v in vals):
            continue
        extra_need=target-len(idxs)
        if extra_need>0:
            g2=add_extras(g, base_red, region, extra_need)
            if g2 is None:
                continue
            g=g2
            out, region, counts, base_red = analyze(g)
            vals=list(counts.values())
            if region.max()<2 or not any(v%2 for v in vals) or not any(v%2==0 for v in vals):
                continue
        if 5 <= np.count_nonzero(g==GREEN) <= 8:
            return g
    raise RuntimeError('"'fail')

sigs=set(); counts=[]
for i in range(100):
    g=generate(); o,region,cc,red=analyze(g)
    vals=list(cc.values())
    assert g.ndim==2 and max(g.shape)<=30
    assert 5 <= np.count_nonzero(g==GREEN) <= 8
    assert region.max()>=2
    assert any(v%2 for v in vals) and any(v%2==0 for v in vals)
    sigs.add(hashlib.md5(g.tobytes()+str(g.shape).encode()).hexdigest())
    counts.append(np.count_nonzero(g==GREEN))
print('variants',len(sigs),'marker_counts',sorted(set(counts)))
