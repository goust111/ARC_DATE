+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+ORANGE = 7
+
+PANEL_H = 8
+PANEL_W = 7
+INPUT_W = PANEL_W * 3 + 2
+LAYER_COLORS = {0: YELLOW, 1: ORANGE, 2: BLUE}
+GENERATION_RETRIES = 400
