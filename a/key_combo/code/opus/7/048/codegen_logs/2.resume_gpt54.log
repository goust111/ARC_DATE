+    pr, pc = map(int, pivot_coords[0])
+
+    source_coords = np.argwhere(g == BLUE)
+    assert len(source_coords) > 0, "expected a blue source shape"
+    offsets = {(int(r) - pr, int(c) - pc) for r, c in source_coords}
+
