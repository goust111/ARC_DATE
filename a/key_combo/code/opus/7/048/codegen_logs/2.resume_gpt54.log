+        adds = _candidate_additions(current)
+        changed = False
+        for remove_cell in leaves:
+            for add_cell in adds:
+                if add_cell == remove_cell:
+                    continue
+                trial = set(current)
+                trial.remove(remove_cell)
+                trial.add(add_cell)
+                if _has_required_overlap(trial):
+                    current = trial
