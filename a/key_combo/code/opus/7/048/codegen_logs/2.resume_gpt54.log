from itertools import combinations
from collections import defaultdict, deque

R=5
cells=[(r,c) for r in range(-R,R+1) for c in range(-R,R+1) if 2 <= abs(r)+abs(c) <= 5]
idx={p:i for i,p in enumerate(cells)}
N=len(cells)
dirs=[(-1,0),(1,0),(0,-1),(0,1)]
adj=[[] for _ in range(N)]
for i,(r,c) in enumerate(cells):
    for dr,dc in dirs:
        q=(r+dr,c+dc)
        if q in idx:
            adj[i].append(idx[q])

def rot(p,k=1):
    r,c=p
    for _ in range(k%4):
        r,c=c,-r
    return (r,c)

def evaluate(S):
    if {rot(p,1) for p in S}==S: return False
