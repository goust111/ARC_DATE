        for sc in combinations(oc,2):
            req=tuple(sorted(sa+sb+sc))
            terminal_sets.append(req)
random.shuffle(terminal_sets)
print('terminal sets',len(terminal_sets))


def steiner(terminals):
    k=len(terminals)
    t_idx=[idx[t] for t in terminals]
    FULL=1<<k
    INF=10**9
    dp=[[INF]*N for _ in range(FULL)]
    parent=[[None]*N for _ in range(FULL)]
    for i,v in enumerate(t_idx):
        dp[1<<i][v]=1
    # For each mask, merge and then shortest paths
    for mask in range(1,FULL):
        # subset merges at same node
        sub=(mask-1)&mask
        while sub:
            other=mask"'^sub
            if other and sub<other:
