            for w in adj[v]:
                ncost=cost+1
                if ncost<dp[mask][w]:
                    dp[mask][w]=ncost
                    parent[mask][w]=('"'move',v)
                    heapq.heappush(pq,(ncost,w))
        if min(dp[mask])>8:
            return None
    best=min(range(N), key=lambda v: dp[FULL-1][v])
    if dp[FULL-1][best]>8:
        return None
    used=set()
    def rec(mask,v):
        used.add(v)
        p=parent[mask][v]
        if p is None:
            return
        if p[0]=='move':
            rec(mask,p[1])
        else:
            _,a,b,v2=p
            rec(a,v2); rec(b,v2)
    rec(FULL-1,best)
    return {cells[v] for v in used}

