+def _solve_with_meta(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    arrows = _find_arrows(grid)
+    ray_grid, ray_paths = _trace_rays(grid, arrows)
+    ray_sets = [set(path) for path in ray_paths]
