+def _tile_grid(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    tile_h, tile_w = tile.shape
+    out = np.zeros((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
