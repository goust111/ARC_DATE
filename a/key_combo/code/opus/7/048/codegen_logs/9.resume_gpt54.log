+    assert width > 0
+    visible = np.asarray(grid[:, :width], dtype=int)
+    for period in range(1, width + 1):
+        matches = True
+        for c in range(width - period):
+            if not np.array_equal(visible[:, c], visible[:, c + period]):
+                matches = False
+                break
+        if matches:
+            return period
+    raise AssertionError("failed to infer horizontal period")
+
