+        return None
+
+    if _floating_column_count(full, cut) < 3:
+        return None
+
+    if _gravity_changes(full) < 3:
+        return None
+
+    inp = full.copy()
+    inp[:, cut:] = PLACEHOLDER
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input for ARC task 9")

