    for r in non_sep_rows:
        protected[r, random.choice(non_sep_cols)] = True
    for c in non_sep_cols:
        protected[random.choice(non_sep_rows), c] = True
    return protected


def _add_grey_overlay(inp: np.ndarray, protected: np.ndarray) -> bool:
