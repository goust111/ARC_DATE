import numpy as np

from arc_utils import Color, components_mask, paste, random_free_location
import random


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor every non-isolated black object in the blue field to teal.

    Input structure:
    - The grid contains only blue background pixels and black foreground pixels.
    - Black pixels form 4-connected objects, including singleton noise pixels.

    Rule:
    - Keep all blue pixels unchanged.
    - Keep every singleton black object unchanged.
    - Recolor every black object with area greater than one to teal.

    Key insight:
    - The distinction is 4-connectivity among black pixels: touching black pixels are
      real objects to mark, while isolated black pixels are preserved as noise.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    assert set(map(int, np.unique(g))).issubset({Color.BLACK, Color.BLUE}), "expected only black and blue"

    out = g.copy()
    for coords in components_mask(g == Color.BLACK, connectivity=4):
        if len(coords) > 1:
            out[coords[:, 0], coords[:, 1]] = Color.TEAL

    return out

# --------------- generator (o5x) ---------------

# Canvas and colors.
GRID_SHAPE = (13, 13)
BACKGROUND_COLOR, OBJECT_COLOR, RECOLOR_COLOR = Color.BLUE, Color.BLACK, Color.TEAL

# Structural target ranges.
BLACK_TOTAL_RANGE = (27, 52)
COMPONENT_TOTAL_RANGE, MULTI_COUNT_RANGE, SINGLETON_COUNT_RANGE = (18, 30), (5, 7), (13, 24)
GENERATION_RETRIES = 300

# Multi-cell object size plan.
SMALL_BASE_SIZE, SMALL_EXTRA_CAPACITY = 2, 1
MEDIUM_BASE_SIZE, MEDIUM_EXTRA_CAPACITY = 4, 0
LARGE_BASE_SIZE, LARGE_EXTRA_CAPACITY = 5, 3
LARGE_COUNT_OPTIONS = (1, 2)

# Polyomino shape and placement constraints.
DIRS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
PATCH_LONG_SIDE_MAX, PATCH_SHORT_SIDE_MAX = 5, 3
ROTATION_COUNT, FLIP_PROBABILITY = 4, 0.5
PLACEMENT_PADDING, CONNECTIVITY_4 = 1, 4


def _closed_range(bounds: tuple[int, int]) -> range:
    return range(bounds[0], bounds[1] + 1)


def _gen_size_count_plans(obj_count: int, pixel_total: int) -> list[tuple[int, int, int]]:
    plans = []
    min_small = obj_count // 2 + 1
    for small_count in range(min_small, obj_count + 1):
        for large_count in LARGE_COUNT_OPTIONS:
            medium_count = obj_count - small_count - large_count
            if medium_count < 0:
                continue
            base = SMALL_BASE_SIZE * small_count + MEDIUM_BASE_SIZE * medium_count + LARGE_BASE_SIZE * large_count
            capacity = SMALL_EXTRA_CAPACITY * small_count + MEDIUM_EXTRA_CAPACITY * medium_count + LARGE_EXTRA_CAPACITY * large_count
            if base <= pixel_total <= base + capacity:
                plans.append((small_count, medium_count, large_count))
    return plans


def _gen_object_sizes(obj_count: int, pixel_total: int) -> list[int]:
    small_count, medium_count, large_count = random.choice(
        _gen_size_count_plans(obj_count, pixel_total)
    )
    sizes = [SMALL_BASE_SIZE] * small_count + [MEDIUM_BASE_SIZE] * medium_count + [LARGE_BASE_SIZE] * large_count
    capacities = [SMALL_EXTRA_CAPACITY] * small_count + [MEDIUM_EXTRA_CAPACITY] * medium_count + [LARGE_EXTRA_CAPACITY] * large_count
    extra = pixel_total - sum(sizes)
    while extra:
        expandable = [i for i, cap in enumerate(capacities) if cap > 0]
        i = random.choice(expandable)
        sizes[i] += 1
        capacities[i] -= 1
        extra -= 1
    random.shuffle(sizes)
    return sizes


def _gen_polyomino_patch(area: int) -> np.ndarray:
    coords = {(0, 0)}
    while len(coords) < area:
        frontier = []
        for r, c in coords:
            for dr, dc in DIRS_4:
                nr, nc = r + dr, c + dc
                if (nr, nc) in coords:
                    continue
                trial = coords | {(nr, nc)}
                rows = [p[0] for p in trial]
                cols = [p[1] for p in trial]
                h = max(rows) - min(rows) + 1
                w = max(cols) - min(cols) + 1
                if max(h, w) <= PATCH_LONG_SIDE_MAX and min(h, w) <= PATCH_SHORT_SIDE_MAX:
                    frontier.append((nr, nc))
        if not frontier:
            return np.full((1, area), OBJECT_COLOR, dtype=int)
        coords.add(random.choice(frontier))

    min_r = min(r for r, _ in coords)
    min_c = min(c for _, c in coords)
    norm = [(r - min_r, c - min_c) for r, c in coords]
    h = max(r for r, _ in norm) + 1
    w = max(c for _, c in norm) + 1
    patch = np.full((h, w), BACKGROUND_COLOR, dtype=int)
    for r, c in norm:
        patch[r, c] = OBJECT_COLOR

    patch = np.rot90(patch, random.randrange(ROTATION_COUNT))
    if random.random() < FLIP_PROBABILITY:
        patch = np.flipud(patch)
    if random.random() < FLIP_PROBABILITY:
        patch = np.fliplr(patch)
    return patch.copy()


def _gen_structural_choices(black_total: int) -> list[tuple[int, int, int, int]]:
    choices = []
    for component_total in _closed_range(COMPONENT_TOTAL_RANGE):
        for multi_count in _closed_range(MULTI_COUNT_RANGE):
            singleton_count = component_total - multi_count
            if not SINGLETON_COUNT_RANGE[0] <= singleton_count <= SINGLETON_COUNT_RANGE[1]:
                continue
            multi_pixels = black_total - singleton_count
            if _gen_size_count_plans(multi_count, multi_pixels):
                choices.append(
                    (component_total, multi_count, singleton_count, multi_pixels)
                )
    return choices


def _place_patch(grid: np.ndarray, patch: np.ndarray) -> bool:
    """Place a patch while preserving 4-neighbor separation between black components."""
    try:
        r, c = random_free_location(
            grid,
            patch,
            transparent=BACKGROUND_COLOR,
            padding=PLACEMENT_PADDING,
            padding_connectivity=CONNECTIVITY_4,
        )
    except ValueError:
        return False
    paste(grid, patch, r, c, transparent=BACKGROUND_COLOR)
    return True


def _gen_attempt() -> np.ndarray | None:
    grid = np.full(GRID_SHAPE, BACKGROUND_COLOR, dtype=int)
    black_total = random.randint(*BLACK_TOTAL_RANGE)
    choices = _gen_structural_choices(black_total)
    if not choices:
        return None

    component_total, multi_count, singleton_count, multi_pixels = random.choice(choices)
    multi_sizes = _gen_object_sizes(multi_count, multi_pixels)

    for size in sorted(multi_sizes, reverse=True):
        if not _place_patch(grid, _gen_polyomino_patch(size)):
            return None

    singleton = np.array([[OBJECT_COLOR]], dtype=int)
    for _ in range(singleton_count):
        if not _place_patch(grid, singleton):
            return None

    if int(np.sum(grid == OBJECT_COLOR)) != black_total:
        return None

    comps = components_mask(grid == OBJECT_COLOR, connectivity=CONNECTIVITY_4)
    if len(comps) != component_total:
        return None
    found_multi = sorted(len(coords) for coords in comps if len(coords) > 1)
    if len(found_multi) != multi_count or found_multi != sorted(multi_sizes):
        return None
    if sum(1 for coords in comps if len(coords) == 1) != singleton_count:
        return None

    expected = grid.copy()
    for coords in comps:
        if len(coords) > 1:
            expected[coords[:, 0], coords[:, 1]] = RECOLOR_COLOR
    if not np.array_equal(main(grid), expected):
        return None
    return grid


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid e0fb7511 input")
from __future__ import annotations

import numpy as np


def _best_reflection_axis(
    grid: np.ndarray, hole_color: int, *, along_rows: bool
) -> tuple[int, int] | None:
    limit = grid.shape[0] if along_rows else grid.shape[1]
    candidates: list[tuple[int, int]] = []

    for axis_sum in range(2 * limit - 1):
        evidence = 0
        conflicts = 0
        for i in range(limit):
            j = axis_sum - i
            if not (0 <= j < limit and i < j):
                continue

            a = grid[i, :] if along_rows else grid[:, i]
            b = grid[j, :] if along_rows else grid[:, j]
            known = (a != hole_color) & (b != hole_color)
            evidence += int(np.count_nonzero(known))
            conflicts += int(np.count_nonzero(known & (a != b)))

        if conflicts == 0 and evidence > 0:
            candidates.append((evidence, axis_sum))

    if not candidates:
        return None

    best_evidence = max(evidence for evidence, _axis_sum in candidates)
    best = [axis_sum for evidence, axis_sum in candidates if evidence == best_evidence]
    assert len(best) == 1, "expected a unique strongest reflection axis"
    return best_evidence, best[0]


def _find_hole_color_and_axes(grid: np.ndarray) -> tuple[int, int, int]:
    scored: list[tuple[int, int, int, int]] = []
    for color in map(int, np.unique(grid)):
        row_axis = _best_reflection_axis(grid, color, along_rows=True)
        col_axis = _best_reflection_axis(grid, color, along_rows=False)
        if row_axis is None or col_axis is None:
            continue
        score = min(row_axis[0], col_axis[0])
        scored.append((score, color, row_axis[1], col_axis[1]))

    assert scored, "expected one color to act as symmetry holes"
    scored.sort(reverse=True)
    assert len(scored) == 1 or scored[0][0] > scored[1][0], "hole color must be structurally unique"

    _score, hole_color, row_axis, col_axis = scored[0]
    assert np.any(grid == hole_color), "expected at least one hole pixel"
    return hole_color, row_axis, col_axis


def _in_bounds(shape: tuple[int, int], row: int, col: int) -> bool:
    height, width = shape
    return 0 <= row < height and 0 <= col < width


def _visible_values(grid: np.ndarray, coords: set[tuple[int, int]], hole_color: int) -> set[int]:
    return {int(grid[row, col]) for row, col in coords if int(grid[row, col]) != hole_color}


def _fill_from_reflections(
    grid: np.ndarray, hole_color: int, row_axis: int, col_axis: int
) -> bool:
    changed = False
    shape = grid.shape
    for row, col in np.argwhere(grid == hole_color):
        row = int(row)
        col = int(col)
        orbit = {(row, col)}
        for rr, cc in (
            (row_axis - row, col),
            (row, col_axis - col),
            (row_axis - row, col_axis - col),
        ):
            if _in_bounds(shape, rr, cc):
                orbit.add((rr, cc))

        values = _visible_values(grid, orbit, hole_color)
        if not values:
            continue
        assert len(values) == 1, "reflection orbit must have one visible color"
        grid[row, col] = values.pop()
        changed = True
    return changed


def _fill_from_quarter_turns(grid: np.ndarray, hole_color: int, center_axis: int) -> bool:
    changed = False
    shape = grid.shape
    for row, col in np.argwhere(grid == hole_color):
        row = int(row)
        col = int(col)
        orbit: set[tuple[int, int]] = set()
        for rr, cc in ((center_axis - col, row), (col, center_axis - row)):
            if _in_bounds(shape, rr, cc):
                orbit.add((rr, cc))

        values = _visible_values(grid, orbit, hole_color)
        if not values:
            continue
        assert len(values) == 1, "quarter-turn orbit must have one visible color"
        grid[row, col] = values.pop()
        changed = True
    return changed


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repair the maroon-stained pattern by replacing each damaged pixel with the color forced by the pattern symmetries.

    Input structure:
    - A square grid contains one occluding color whose pixels are not part of the final design.
    - Ignoring the occluding color reveals unique shifted horizontal and vertical reflection axes with the same center.
    - Any occluding pixels left unresolved by reflection lie in edge bands that also obey the same-center quarter-turn relation.

    Rule:
    - Infer the occluding color as the only color whose removal gives conflict-free high-evidence row and column reflection axes.
    - Fill occluding pixels from the unique visible color in their horizontal, vertical, and 180-degree reflection orbit.
    - Fill any remaining occluding pixels from the unique visible color at a 90-degree quarter-turn counterpart.

    Key insight:
    - The maroon pixels are damage over a shifted kaleidoscope-like pattern; the hidden color is determined by a visible mate in the same symmetry orbit.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)
    assert height == width, "expected a square grid"

    hole_color, row_axis, col_axis = _find_hole_color_and_axes(g)
    assert row_axis == col_axis, "row and column axes must share a center"

    out = g.copy()
    while _fill_from_reflections(out, hole_color, row_axis, col_axis):
        pass

    while _fill_from_quarter_turns(out, hole_color, row_axis):
        pass

    assert not np.any(out == hole_color), "all damaged pixels must be repairable"
    return out

