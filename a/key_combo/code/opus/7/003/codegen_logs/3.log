+            out[r0:r1, c0:c1] = int(color)
+
+    details = {
+        "parsed": parsed,
+        "reaches": reaches,
+        "counts": counts,
+        "chamber_owner": chamber_owner,
+        "chamber_reachers": chamber_reachers,
+    }
+    return out, details
+
+
