+        for c in range(parsed["n_cols"]):
+            r0 = line_rows[r] + 1
+            r1 = line_rows[r + 1]
+            c0 = line_cols[c] + 1
+            c1 = line_cols[c + 1]
+            chamber = (r, c)
+            if chamber in chamber_owner:
+                color = markers[chamber_owner[chamber]]["color"]
