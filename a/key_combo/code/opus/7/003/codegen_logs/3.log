+        for c in range(n_cols):
+            c0 = line_cols[c] + 1
+            c1 = line_cols[c + 1]
+            if np.any(g[wall_r, c0:c1] != FRAME):
+                a = (r, c)
+                b = (r + 1, c)
+                graph[a].add(b)
+                graph[b].add(a)
+                gaps.append(("h", a, b))
+
+    for r in range(n_rows):
+        for c in range(n_cols - 1):
+            wall_c = line_cols[c + 1]
+            r0 = line_rows[r] + 1
+            r1 = line_rows[r + 1]
+            if np.any(g[r0:r1, wall_c] != FRAME):
+                a = (r, c)
+                b = (r, c + 1)
+                graph[a].add(b)
+                graph[b].add(a)
+                gaps.append(("v", a, b))
+
+    return {
+        "grid": g,
+        "line_rows": line_rows,
+        "line_cols": line_cols,
+        "n_rows": n_rows,
+        "n_cols": n_cols,
+        "chambers": chambers,
+        "markers": markers,
+        "marker_chambers": marker_chambers,
+        "graph": graph,
+        "gaps": gaps,
+    }
