+    start = markers[start_index]["chamber"]
+    blocked = {m["chamber"] for i, m in enumerate(markers) if i != start_index}
+    seen = {start}
+    q = deque([start])
+    while q:
+        cur = q.popleft()
+        if cur != start and cur in blocked:
