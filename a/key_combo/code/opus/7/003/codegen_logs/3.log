+def _reachable_chambers(parsed: dict, start_index: int) -> set[tuple[int, int]]:
+    markers = parsed["markers"]
+    graph = parsed["graph"]
+    start = markers[start_index]["chamber"]
+    blocked = {m["chamber"] for i, m in enumerate(markers) if i != start_index}
+    seen = {start}
+    q = deque([start])
+    while q:
