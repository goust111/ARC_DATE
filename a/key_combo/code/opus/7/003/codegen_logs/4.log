+            continue
+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        nr = min(rows)
+        nc = min(cols)
+        norm = {(r - nr, c - nc) for r, c in cells}
+        h = max(r for r, _ in norm) + 1
+        w = max(c for _, c in norm) + 1
