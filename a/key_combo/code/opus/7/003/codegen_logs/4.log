+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+ORANGE = 7
+
+LEFT_TILE_COLORS = {BLUE, RED}
+RIGHT_TILE_COLORS = {GREEN, ORANGE}
+COLOR_MAP = {BG: BG, BLUE: ORANGE, RED: GREEN}
+SIDES = ("up", "right", "down", "left")
+DIRS = {
