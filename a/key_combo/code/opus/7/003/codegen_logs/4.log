+            continue
+        return inp, expected
+    raise RuntimeError("failed to generate valid puzzle instance")
+
+
+def _validate_instance(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    sprite_box: tuple[int, int, int, int],
+    sprite_patch: np.ndarray,
+    side: str,
+    arm: str,
+    arm_lengths: dict[str, int],
+) -> bool:
