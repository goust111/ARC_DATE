+            frontier = []
+            for r, c in cells:
+                for nr, nc in neighbors4(r, c):
+                    if 0 <= nr < limit_h and 0 <= nc < limit_w and (nr, nc) not in cells:
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
