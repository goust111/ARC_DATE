+
+def random_colored_patch(area_range: tuple[int, int], *, limit_h: int, limit_w: int) -> np.ndarray:
+    while True:
+        area = random.randint(*area_range)
+        cells = grow_connected(area, limit_h=limit_h, limit_w=limit_w)
