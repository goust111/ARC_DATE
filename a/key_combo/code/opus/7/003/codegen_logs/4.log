+def render_cells(cells: set[tuple[int, int]], colors: dict[tuple[int, int], int]) -> np.ndarray:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    r0, c0, r1, c1 = min(rows), min(cols), max(rows), max(cols)
