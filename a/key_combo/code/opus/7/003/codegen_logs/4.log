+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+ORANGE = 7
+
+LEFT_TILE_COLORS = {BLUE, RED}
+RIGHT_TILE_COLORS = {GREEN, ORANGE}
+COLOR_MAP = {BG: BG, BLUE: ORANGE, RED: GREEN}
+SIDES = ("up", "right", "down", "left")
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+CW_SIDE = {"up": "right", "right": "down", "down": "left", "left": "up"}
+CCW_ARM = {v: k for k, v in CW_SIDE.items()}
