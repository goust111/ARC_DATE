    _GEN_GEOMETRY_CACHE[sprite_count] = by_grid
    return by_grid


def _gen_choose_geometry(sprite_count: int) -> tuple[int, int, _GenBox] | None:
    geometry_options = _gen_geometry_options(sprite_count)
