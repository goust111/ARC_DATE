+def _initial_mask(region: np.ndarray, tile_h: int, tile_w: int, rep_h: int, rep_w: int) -> np.ndarray:
+    height, width = region.shape
+    missing = np.zeros((height, width), dtype=bool)
+    class_size = rep_h * rep_w
