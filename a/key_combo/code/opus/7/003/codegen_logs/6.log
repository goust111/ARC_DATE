+    if sym_only < 2 or tile_only < 2 or deadlock < 1:
+        raise RuntimeError("semantic recovery categories are insufficient")
+    if int(np.sum(fill_step >= 2)) < 1:
+        raise RuntimeError("missing chain dependency across iterations")
