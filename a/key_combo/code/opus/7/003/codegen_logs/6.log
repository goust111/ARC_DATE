+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        try:
+            inp, _out = _generate_case()
+            return inp
+        except RuntimeError:
+            continue
+    raise RuntimeError("failed to generate a valid ARC input")

