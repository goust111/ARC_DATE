+def _special_residues(tile_h: int, tile_w: int) -> tuple[tuple[int, int], tuple[int, int]]:
+    non_center = [(tr, tc) for tr in range(tile_h) for tc in range(tile_w) if tc != tile_w // 2]
+    random.shuffle(non_center)
+    first = non_center[0]
+    second_choices = [
