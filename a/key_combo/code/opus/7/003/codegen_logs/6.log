+    def can_add_pair(pos: tuple[int, int]) -> bool:
+        if missing[pos]:
+            return False
+        mirror_pos = _mirror(pos, width)
+        if pos == mirror_pos or missing[mirror_pos]:
+            return False
+        res_a = _residue_of(pos, tile_h, tile_w)
+        res_b = _residue_of(mirror_pos, tile_h, tile_w)
