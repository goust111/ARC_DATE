+
+def _generate_case() -> tuple[np.ndarray, np.ndarray]:
+    tile_h, tile_w, rep_h, rep_w = random.choice(SPECIAL_CONFIGS)
+    clean = _full_region(tile_h, tile_w, rep_h, rep_w)
+    missing = _initial_mask(clean, tile_h, tile_w, rep_h, rep_w)
