+            sym_color = int(work[rr, width - 1 - cc])
+            candidates = set(tile_colors)
+            if sym_color != 0:
+                candidates.add(sym_color)
+            if len(candidates) > 1:
+                return None if not trace else (None, None)
+            if len(candidates) == 1:
