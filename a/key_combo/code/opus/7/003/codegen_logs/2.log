+
+    mask = np.zeros((height, local_width), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return mask
+
+
+def _half_mask_ok(mask: np.ndarray) -> bool:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    if len(rows) < 3 or len(cols) < 2:
+        return False
+    if not mask[:, -1].any():
+        return False
+    if not mask[:, :-1].any():
+        return False
+    if int(mask.sum()) < 6:
