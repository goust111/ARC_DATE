+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+PAIR_COLORS = (1, 2, 3)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_ATTEMPTS = 500
