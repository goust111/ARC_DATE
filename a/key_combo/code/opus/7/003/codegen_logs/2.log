+                else:
+                    visible_local[r, c] = True
+                    visible_local[r, mc] = True
+            else:
+                if roll < 0.72:
+                    visible_local[r, mc] = True
+                elif roll < 0.88:
+                    visible_local[r, c] = True
+                else:
+                    visible_local[r, c] = True
+                    visible_local[r, mc] = True
+
+    global_full = np.zeros((top + local_h, axis + span + 1), dtype=bool)
+    global_visible = np.zeros_like(global_full)
+    left = axis - span
+    for r in range(local_h):
+        for c in range(full_w):
+            if full_local[r, c]:
