+
+def _path_for_top(frame_box: BBox, start: Coord) -> tuple[list[Coord], list[Coord], str]:
+    r0, c0, _r1, c1 = frame_box
+    sr, sc = start
+    outer_col = c0 - 2
+    top_col = random.randint(c0, c1)
+    left_steps = sc - outer_col
+    moves: list[str] = []
+    initial_up = random.randint(0, 1)
