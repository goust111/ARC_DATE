+        r, c = cur
+        up_blocked = (r - 1, c) in frame or int(g[r - 1, c]) == GREY
+        if not up_blocked:
+            nxt = (r - 1, c)
+        else:
+            if c + 1 >= w or (r, c + 1) in frame or int(g[r, c + 1]) == GREY:
+                nxt = (r, c - 1)
+            else:
+                nxt = (r, c + 1)
