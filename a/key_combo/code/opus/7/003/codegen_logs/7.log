+def _make_scene() -> tuple[np.ndarray, dict[Coord, dict[str, object]]]:
+    width = random.randint(14, 20)
+    frame_w = random.randint(7, min(10, width - 6))
+    c0 = random.randint(3, width - frame_w - 3)
+    c1 = c0 + frame_w - 1
+
