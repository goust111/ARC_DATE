+        elif step == "R":
+            obstacle_needs.append((r - 1, c))
+            nxt = (r, c + 1)
+        elif step == "L":
+            obstacle_needs.append((r - 1, c))
+            obstacle_needs.append((r, c + 1))
+            nxt = (r, c - 1)
+        else:
