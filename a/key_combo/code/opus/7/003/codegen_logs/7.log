+def _simulate_all(grid: np.ndarray, frame_box: BBox) -> tuple[dict[Coord, list[Coord]], dict[Coord, int]]:
+    g = np.asarray(grid, dtype=int)
+    frame = _frame_cells(frame_box)
+    starts = []
+    for r, c in np.argwhere(g == YELLOW):
+        pt = (int(r), int(c))
