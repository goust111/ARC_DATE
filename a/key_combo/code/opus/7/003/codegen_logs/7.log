+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+GEN_RETRY_LIMIT = 500
