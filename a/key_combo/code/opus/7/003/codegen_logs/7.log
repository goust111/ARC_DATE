+        ("left", "right"),
+        ("top", "right"),
+        ("left", "top"),
+        ("left", "top", "right"),
+        ("left", "top", "right"),
+    ]
+    sides = list(random.choice(side_sets))
+    start_rows = {
+        "top": base_start_row,
+        "left": base_start_row - (1 if "top" in sides else 0),
+        "right": base_start_row - random.choice([0, 1]),
+    }
