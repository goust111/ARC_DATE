+    return None
+
+
+def _wall_cells(box: tuple[int, int, int, int], gap: tuple[int, int] | None) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells = set()
+    for c in range(c0, c1 + 1):
