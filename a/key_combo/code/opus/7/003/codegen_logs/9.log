+def _flood_reaches_anchor(grid: np.ndarray, start: tuple[int, int], anchor: tuple[int, int]) -> bool:
+    height, width = grid.shape
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
