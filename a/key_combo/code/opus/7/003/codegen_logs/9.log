+def _extract_sprites(grid: np.ndarray, anchors: dict[int, tuple[int, int]], bg: int) -> list[dict]:
+    colors = [int(c) for c in np.unique(grid) if int(c) not in (bg, WALL)]
+    comps = find_components(
