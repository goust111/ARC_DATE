+    sprites: list[dict] = []
+    for comp in comps:
+        coords = tuple((int(r), int(c)) for r, c in comp["coords"])
+        if len(coords) < 2:
+            continue
+        if any(r in (0, grid.shape[0] - 1) or c in (0, grid.shape[1] - 1) for r, c in coords):
