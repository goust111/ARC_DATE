+    left_col = random.randint(2, axis - 2)
+    right_col = _mirror_col(left_col, axis)
+    grid[r, left_col] = Color.BLUE
+    grid[r, right_col] = Color.BLUE
+
+    row_used = {left_col, right_col}
+
+    left_target = random.randint(0, left_col - 1)
