+
+    return {
+        "blue_count": len(blues),
+        "symmetric_count": len(symmetric),
+        "isolated_count": len(isolated),
+        "same_ray_extra": same_ray_extra,
+        "opposite_symmetric": opposite_hits["symmetric"],
