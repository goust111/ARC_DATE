GRID_SIZE_MIN = 13
GRID_SIZE_MAX = 17
SPRITE_SIZE_MIN = 3
SPRITE_SIZE_MAX = 5

# Object count ranges.
CLOSED_COUNT_MIN = 2
CLOSED_COUNT_MAX = 3
OPEN_COUNT_MIN = 2
OPEN_COUNT_MAX = 4

# Palette constraints.
COLOR_MIN = 1
COLOR_MAX = 9
DISTINCT_COLOR_MIN = 3
