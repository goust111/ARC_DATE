+
+BLACK = 0
+GREY = 5
+LOOKUP_PALETTE = (1, 2, 3, 4, 7)
+DRAW_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+MAX_GENERATION_ATTEMPTS = 500
