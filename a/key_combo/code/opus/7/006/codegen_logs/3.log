+def _random_crop(cell_size: int, n_pixels: int, used: set[tuple[tuple[int, int], bytes]]) -> np.ndarray:
+    for _ in range(400):
+        h = random.randint(3, cell_size)
+        w = random.randint(3, cell_size)
+        if n_pixels > h * w:
