+    used_signatures: set[tuple[tuple[int, int], bytes]] = set()
+    cells: list[list[np.ndarray]] = [[np.zeros((cell_size, cell_size), dtype=int) for _ in range(3)] for _ in range(3)]
+    anomaly_cols: list[int] = []
+
+    for r in range(3):
