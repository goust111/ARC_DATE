    lanes: list[list[int]] = [[] for _ in range(n_lanes)]
    sums = [0] * n_lanes

    def rec(pos: int) -> bool:
        if pos == len(order):
            return all(lane for lane in lanes)

        idx = order[pos]
        lane_order = list(range(n_lanes))
        random.shuffle(lane_order)
