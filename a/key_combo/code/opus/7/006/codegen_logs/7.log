+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+TEAL = 8
+GROUP_COLORS = (2, 3, 1)
+PATTERNS = (("H", "H"), ("H", "V"), ("V", "H"), ("V", "V"))
+MAX_RETRIES = 600
