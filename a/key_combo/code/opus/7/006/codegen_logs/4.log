+            (bottom_r, left_c, bottom_r + h2 - 1, left_c + w2 - 1, Color.GREEN),
+        ]
+    else:
+        rects = [
+            (top_r, left_c, top_r + h1 - 1, left_c + w1 - 1, Color.RED),
+            (bottom_r, right_c, bottom_r + h2 - 1, right_c + w2 - 1, Color.GREEN),
