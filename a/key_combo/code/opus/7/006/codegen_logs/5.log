+import numpy as np
+
+try:
+    from solvers.arc_utils import Color, find_components, get_bg
+except Exception:
+    _ARC_UTILS = SourceFileLoader(
+        "_arc_utils_ref",
+        "/home/lixinyu/snap/new/solvers/arc_utils.py",
+    ).load_module()
