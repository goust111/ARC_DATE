+    for i, (color_i, coords_i) in enumerate(placed):
+        for color_j, coords_j in placed[i + 1 :]:
+            if color_i != color_j:
+                continue
+            distances = np.abs(coords_i[:, None, :] - coords_j[None, :, :]).sum(axis=2)
+            if np.any(distances <= 1):
