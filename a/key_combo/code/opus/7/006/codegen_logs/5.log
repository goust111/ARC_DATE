+
+    def rec(ci: int, oi: int, prev_closed_top: int, prev_open_bottom: int) -> bool:
+        if ci == len(closed) and oi == len(open_objects):
+            return True
+
+        choices: list[str] = []
+        if ci < len(closed):
+            choices.append("closed")
+        if oi < len(open_objects):
+            choices.append("open")
+        random.shuffle(choices)
