# Canvas and object size bounds.
GRID_SIZE_MIN = 13
GRID_SIZE_MAX = 17
SPRITE_SIZE_MIN = 3
SPRITE_SIZE_MAX = 5

# Object count ranges.
CLOSED_COUNT_MIN = 2
CLOSED_COUNT_MAX = 3
OPEN_COUNT_MIN = 2
