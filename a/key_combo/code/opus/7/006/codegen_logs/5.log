+@dataclass
+class Obj:
+    color: int
+    patch: np.ndarray
+    closed: bool
+    bbox: tuple[int, int, int, int]
+
+    @property
+    def height(self) -> int:
+        return int(self.patch.shape[0])
+
+    @property
+    def width(self) -> int:
+        return int(self.patch.shape[1])
+
+    @property
+    def col(self) -> int:
+        return int(self.bbox[1])
