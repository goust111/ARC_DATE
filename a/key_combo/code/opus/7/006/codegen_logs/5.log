                    continue
            lanes[lane_i].append(idx)
            sums[lane_i] += heights[idx]
            if rec(pos + 1):
                return True
            sums[lane_i] -= heights[idx]
            lanes[lane_i].pop()
        return False

    return lanes if rec(0) else None


