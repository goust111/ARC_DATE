+    for obj in objects:
+        if obj[row_key] is None:
+            return True
+        coords = np.argwhere(obj["patch"] != BG_COLOR)
+        coords = coords + np.array([int(obj[row_key]), int(obj["c"])])
+        placed.append((int(obj["color"]), coords))
