+def _choose_role_colors() -> tuple[int, int, int]:
+    i = random.randrange(len(PALETTE_RING))
+    return (
+        int(PALETTE_RING[i]),
+        int(PALETTE_RING[(i + 1) % len(PALETTE_RING)]),
+        int(PALETTE_RING[(i + 2) % len(PALETTE_RING)]),
+    )
+
+
+def _build_input(
+    pair: tuple[tuple[int, int], tuple[int, int]],
+    selector: int,
+    frame: int,
+    bulk: int,
