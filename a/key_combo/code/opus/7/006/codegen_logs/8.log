+        elif dr == 1 and dc == 1:
+            cat = "diagonal_adjacent"
+        elif (dr, dc) in {(2, 0), (0, 2)}:
+            cat = "line_gap_two"
+        elif (dr, dc) in {(2, 1), (1, 2)}:
+            cat = "knight_like"
