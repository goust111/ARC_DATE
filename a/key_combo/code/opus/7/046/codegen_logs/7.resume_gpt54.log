+    blockable_rows = [r for r in row_corridors if r != open_row]
+    blockable_cols = [c for c in col_corridors if c != open_col]
+    block_choices = [("row", r) for r in blockable_rows] + [("col", c) for c in blockable_cols]
+    if not block_choices:
+        return None
+
