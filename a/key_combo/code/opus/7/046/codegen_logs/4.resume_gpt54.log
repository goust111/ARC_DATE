+            color = random.choice(SIGNAL_COLORS)
+        patch[rr, cc] = color
+
+    colors = {int(v) for v in patch[mask]}
+    if len(colors) == 1:
+        r, c = map(int, random.choice(np.argwhere(mask).tolist()))
+        patch[r, c] = GREY if int(patch[r, c]) == RED else RED
+    return patch
