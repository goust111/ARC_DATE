  63:         if side == "top":
  64:             out[:, c0 : c1 + 1] = trail
  65:             targets.append((h - rect_h, c0, h - 1, c1))
  66:         elif side == "bottom":
  67:             out[:, c0 : c1 + 1] = trail
  68:             targets.append((0, c0, rect_h - 1, c1))
  69:         elif side == "left":
  70:             out[r0 : r1 + 1, :] = trail
