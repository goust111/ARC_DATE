        if not placed: return None
    objects=comps(grid)
    if len(objects)!=len(color_list): return None
    counts=Counter(grid[grid>0].tolist())
    if set(counts)!=set(colors): return None
    if len(set(counts.values()))!=len(counts): return None
    out, placed, color_counts = solve(grid)
    if np.array_equal(out, grid): return None
    if not np.any(out==5): return None
    # bottom and grey objects
    bottoms=0; greys=0
    for _,final,b in placed:
