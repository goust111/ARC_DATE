    paint(grid,mhi,r_hi,c_hi,high)
    if not can_place(grid,mlo,r_lo,c_lo,1): return None
    paint(grid,mlo,r_lo,c_lo,low)
    used={hi,lo}
    order=list(range(len(color_list)))
    random.shuffle(order)
    for idx in order:
        if idx in used: continue
        m=masks[idx]; color=color_list[idx]
        placed=False
        for _ in range(80):
            r=random.randint(0, max(0,H-m.shape[0]-3))
            c=random.randint(0, W-m.shape[1])
            if can_place(grid,m,r,c,1):
