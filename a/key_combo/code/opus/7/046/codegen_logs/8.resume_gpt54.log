    return out

def solve(grid):
    H,W=grid.shape
    objects=comps(grid)
    counts=Counter()
    for o in objects: counts[o['color']]+=o['area']
    order=sorted(counts, key=lambda color: -counts[color])
    occ=np.zeros((H,W),bool)
    out=np.zeros((H,W),int)
