    if bottoms==0 or greys==0: return None
    # overlap pair diff vs bottom priority
    if np.array_equal(out, bottom_priority(grid)): return None
    # upper-heavy input
    if max(o['"'bbox'][2] for o in objects) >= H-2: return None
