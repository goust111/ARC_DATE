        final=np.column_stack([coords[:,0]+shift, coords[:,1]])
        col=o['color'] if final[:,0].max()==H-1 else 5
        out[final[:,0], final[:,1]]=col
        occ[final[:,0], final[:,1]]=True
    return out

def area(mask): return int(mask.sum())

def can_place(grid, mask, r, c, gap=1):
    H,W=grid.shape
    hh,ww=mask.shape
    if r<0 or c<0 or r+hh>H or c+ww>W: return False
    cells=np.argwhere(mask)
    for dr,dc in cells:
        rr=r+dr; cc=c+dc
        if grid[rr,cc]"'!=0: return False
        for nr in range(rr-gap, rr+gap+1):
            for nc in range(cc-gap, cc+gap+1):
                if 0<=nr<H and 0<=nc<W and grid[nr,nc]!=0:
