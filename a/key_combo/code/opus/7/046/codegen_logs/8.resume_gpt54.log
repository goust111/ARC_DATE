            out[final[:,0], final[:,1]]=col
            occ[final[:,0], final[:,1]]=True
            placed.append((o,final,bottom))
    return out, placed, counts

def bottom_priority(grid):
    H,W=grid.shape
    objects=comps(grid)
    occ=np.zeros((H,W),bool)
    out=np.zeros((H,W),int)
