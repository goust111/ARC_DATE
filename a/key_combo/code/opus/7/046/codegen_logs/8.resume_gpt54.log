        cols_a=set(a['coords'][:,1].tolist())
        for b in objects[i+1:]:
            if a['color']==b['color']: continue
            if cols_a & set(b['coords'][:,1].tolist()): ok=True
    if not ok: return None
    return grid, out, color_counts, [o['bbox'] for o in objects]

