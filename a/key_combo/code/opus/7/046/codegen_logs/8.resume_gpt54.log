+    if not _can_place(grid, dominant_shape, dominant_top, dominant_left):
+        return None
+    _paint(grid, dominant_shape, dominant_top, dominant_left, dominant_color)
+    if not _can_place(grid, blocked_shape, blocked_top, blocked_left):
+        return None
