+
+def _smallest_col_period(pattern: np.ndarray) -> int:
+    w = pattern.shape[1]
+    for period in range(1, w + 1):
+        if np.array_equal(pattern, pattern[:, np.arange(w) % period]):
+            return period
+    raise AssertionError("left zone must have a column period")
+
+
