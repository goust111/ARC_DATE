+def _touches_edge(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1)))
+
+
+def _passable_mask(grid: np.ndarray) -> np.ndarray:
+    return np.isin(grid, PASSABLE_COLORS)
