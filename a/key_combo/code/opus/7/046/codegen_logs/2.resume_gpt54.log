    if any(deg < 1 or deg > 2 for deg in degrees):
        return False
    if degrees.count(1) != 2:
        return False

    left_endpoints, right_endpoints = [], []
    for r, c in cells:
        deg = _gen_degree(cells, r, c, width)
        if deg == 1 and c == 0:
