            seed = {(row, c) for c in cols}
        else:
            seed = {(row, 0), (row, 1), (row, 2)}
            candidates = [
                (rr, cc)
                for rr in (row - 1, row + 1)
                if 0 <= rr < th
                for cc in range(3)
