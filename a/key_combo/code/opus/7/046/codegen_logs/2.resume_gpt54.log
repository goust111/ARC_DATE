+        rr = int(r)
+        cc = int(c)
+        ok = True
+        for dr, dc in ALL_NEIGHBOR_STEPS:
+            nr, nc = rr + dr, cc + dc
+            if not _in_bounds(region_mask.shape, nr, nc) or not region_mask[nr, nc]:
+                ok = False
+                break
+        if ok:
+            candidates.append((rr, cc))
+    return candidates
+
