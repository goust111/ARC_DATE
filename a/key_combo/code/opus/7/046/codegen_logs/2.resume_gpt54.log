    if th == 1:
        source_n = SOURCE_COUNT_RANGE[0]
        if random.random() < ONE_MARKER_LINE_LEFT_PROB:
            marker = (0, 0)
            source = {(0, 1), (0, 2), (0, 3)}
        else:
            marker = (0, 3)
            source = {(0, 0), (0, 1), (0, 2)}
    else:
        row = random.randrange(th)
        if tw == 4:
            marker_col = random.choice((0, 3))
            marker = (row, marker_col)
