+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _component_key(comp: list[tuple[int, int]]) -> tuple[int, int]:
+    return min(comp)
+
+
+def _boundary_cells(comp: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    cells = set(comp)
+    out = []
+    for r, c in comp:
+        if any((r + dr, c + dc) not in cells for dr, dc in DIR4):
+            out.append((r, c))
+    return sorted(out)
