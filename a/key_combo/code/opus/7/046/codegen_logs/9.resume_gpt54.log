+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
