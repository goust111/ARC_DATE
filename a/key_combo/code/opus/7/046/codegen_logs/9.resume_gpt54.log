+def _scan_color_order(grid: np.ndarray) -> list[int]:
+    order: list[int] = []
+    seen = {BACKGROUND, OBSTACLE}
+    for value in map(int, grid.ravel()):
+        if value not in seen:
+            seen.add(value)
+            order.append(value)
+    return order
+
