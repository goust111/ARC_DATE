+
+def _settle_obstacles(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+    for c in range(w):
+        rows = [r for r in range(h) if out[r, c] == OBSTACLE]
+        if not rows:
+            continue
+        out[rows, c] = BACKGROUND
+        for offset, r in enumerate(range(h - len(rows), h)):
+            out[r, c] = OBSTACLE
