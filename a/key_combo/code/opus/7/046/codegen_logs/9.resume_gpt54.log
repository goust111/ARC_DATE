                    ROW_SHAPES,
                    [c_row],
                    c_col_min,
                    c_col_max,
                    color,
                )
                if placed_c is None:
                    ok = False
                    break

            must_shift = idx == critical_index
            if must_shift or random.random() < 0.35:
                if not _add_grey_block(
                    grid,
