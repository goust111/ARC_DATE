+def _solve_assignment(sprites: list[dict], holes: list[dict], *, max_solutions: int = 2):
+    if len(sprites) != len(holes):
+        return []
+    if sum(sprite["area"] for sprite in sprites) != sum(hole["area"] for hole in holes):
+        return []
