+    seen = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if local[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not local[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if touches_edge:
