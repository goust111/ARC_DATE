+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(np.array(cells, dtype=int))
+    return components
+
+
+def _find_monochrome_components(grid: np.ndarray, bg: int) -> list[dict]:
+    components = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) != bg):
+        for coords in _components_mask(grid == color):
+            r0, c0 = coords.min(axis=0)
+            r1, c1 = coords.max(axis=0)
+            components.append(
+                {
+                    "color": int(color),
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return components
+
+
+def _find_component_holes(grid: np.ndarray, comp: dict, bg: int) -> list[dict]:
+    r0, c0, r1, c1 = comp["bbox"]
+    color = int(comp["color"])
+    local = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+    h, w = local.shape
+    holes = []
+    seen = np.zeros((h, w), dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if local[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not local[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if touches_edge:
+                continue
+            coords = np.array([(r0 + rr, c0 + cc) for rr, cc in cells], dtype=int)
+            shape = _normalize_shape(cells)
+            holes.append(
+                {
+                    "coords": coords,
+                    "cells": frozenset((int(rr), int(cc)) for rr, cc in coords.tolist()),
+                    "bbox": (
+                        int(coords[:, 0].min()),
+                        int(coords[:, 1].min()),
+                        int(coords[:, 0].max()),
+                        int(coords[:, 1].max()),
