from collections import deque
import itertools, numpy as np
H=W=15
# templates as relative intervals per row
Top=[(0,3,4),(1,2,5),(2,1,6),(3,0,7)]
Left=[(0,0,3),(1,1,3),(2,2,4),(3,3,5),(4,4,5)]
Right=[(0,0,3),(1,0,2),(2,-1,1),(3,-1,0),(4,-1,0)]  # add left offset later around anchor as right side start
# For right, anchor indicates left base around center-right

def render(top_t, left_t, right_t):
    shapes=[]
    # top anchor is leftmost col of row 3? no just add
    for template, (tr,tc), kind in [(Top,top_t,'t'), (Left,left_t,'l'), (Right,right_t,'r')]:
        sh=[]
        for dr,a,b in template:
            r=tr+dr
            if kind=='r':
                sh.append((r, tc+a, tc+b))
            else:
                sh.append((r, tc+a, tc+b))
        shapes.append(sh)
    return shapes

def paint(shapes, filled=True):
    g=np.zeros((H,W),int)
    for sh in shapes:
        for r,a,b in sh:
            if not (0<=r<H and 0<=a<=b<W):
                return None
            if filled:
                if np.any(g[r,a:b+1]): return None
                g[r,a:b+1]=1
            else:
                if g[r,a] or g[r,b]: return None
                g[r,a]=1; g[r,b]=1
    return g

def neigh(r,c):
    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
        nr,nc=r+dr,c+dc
        if 0<=nr<H and 0<=nc<W: yield nr,nc

def comps(mask):
    vis=np.zeros((H,W),bool); out=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not vis[r,c]:
                q=deque([(r,c)]); vis[r,c]=1; comp=[]
                while q:
                    x,y=q.popleft(); comp.append((x,y))
                    for nx,ny in neigh(x,y):
                        if mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
                out.append(comp)
    return out

def reach(mask):
    vis=np.zeros((H,W),bool); q=deque()
    for r in range(H):
        for c in (0,W-1):
            if mask[r,c] and not vis[r,c]: vis[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if mask[r,c] and not vis[r,c]: vis[r,c]=1; q.append((r,c))
    while q:
        x,y=q.popleft()
        for nx,ny in neigh(x,y):
            if mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
    return vis

for top_t in itertools.product(range(1,4), range(4,8)):
  for left_t in itertools.product(range(4,8), range(1,6)):
    for right_t in itertools.product(range(4,8), range(8,13)):
      shapes=render(top_t,left_t,right_t)
      fg=paint(shapes,True)
      if fg is None: continue
      cs=comps(fg==0)
      enclosed=[comp for comp in cs if all(0<r<H-1 and 0<c<W-1 for r,c in comp)]
      if not enclosed: continue
      inp=paint(shapes,False)
      if inp is None: continue
      if np.all(reach(inp==0)):
        print('found',top_t,left_t,right_t,'encl',list(map(len,enclosed)))
        print('filled\\n',fg)
        print('hollow\\n',inp)
        raise SystemExit
print('none')
