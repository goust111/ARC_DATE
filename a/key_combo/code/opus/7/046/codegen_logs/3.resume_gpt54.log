from collections import deque
H=W=15
shape1=[(1,4,5),(2,3,5),(3,3,5),(4,2,5),(5,1,6),(6,1,4),(7,1,4),(8,1,5),(9,2,5)]
D4=((1,0),(-1,0),(0,1),(0,-1)); D8=D4+((1,1),(1,-1),(-1,1),(-1,-1))

def comps(mask,dirs):
    vis=np.zeros_like(mask,dtype=bool); out=[]; H,W=mask.shape
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not vis[r,c]:
                q=deque([(r,c)]); vis[r,c]=1; cells=[]
                while q:
                    x,y=q.popleft(); cells.append((x,y))
                    for dr,dc in dirs:
                        nx,ny=x+dr,y+dc
                        if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not vis[nx,ny]: vis[nx,ny]=1; q.append((nx,ny))
                out.append(cells)
    return out

def reach(mask):
    vis=np.zeros_like(mask,dtype=bool); q=deque(); H,W=mask.shape
    for r in range(H):
        for c in (0,W-1):
            if mask[r,c] and not vis[r,c]: vis[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if mask[r,c] and not vis[r,c]: vis[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in D4:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not vis[nr,nc]: vis[nr,nc]=1; q.append((nr,nc))
    return vis

def paint(shapes,filled):
    g=np.zeros((H,W),dtype=np.uint8)
    for sh in shapes:
        for r,a,b in sh:
            if r<0 or r>=H or a<0 or b>=W or a>b: return None
            if filled:
                if g[r,a:b+1].any(): return None
                g[r,a:b+1]=1
            else:
