+    region_mask[region[:, 0], region[:, 1]] = True
+    candidates: list[tuple[int, int]] = []
+    for r, c in map(tuple, region):
+        if r in (0, h - 1) or c in (0, w - 1):
+            continue
+        degree = 0
+        for dr, dc in DIRS4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and region_mask[nr, nc]:
