+    if rect.c1 < axis:
+        return (0, 1), (0, -1)
+    assert rect.c0 > axis, "rectangles must not cross the divider"
+    return (0, -1), (0, 1)
+
+
+def _is_divider_cell(r: int, c: int, divider_orient: str, axis: int) -> bool:
+    return r == axis if divider_orient == "horizontal" else c == axis
+
+
+def _cast_ray(
+    out: np.ndarray,
+    rect: Rectangle,
+    direction: tuple[int, int],
+    color: int,
+    divider_orient: str,
+    axis: int,
+) -> None:
+    h, w = out.shape
+    dr, dc = direction
+    r, c = rect.center
+    r += dr
+    c += dc
