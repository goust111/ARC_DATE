_GEN_SPLIT_TYPES = ("horizontal", "vertical")

# Red rectangle layout.
_GEN_RECT_SIZES = (
    (1, 1),
    (1, 2),
    (2, 1),
    (2, 2),
    (2, 3),
    (2, 4),
    (3, 2),
    (4, 2),
)
_GEN_COUNT_OPTIONS = ((2, 2), (3, 2), (2, 3))
