+def _render_input(h: int, w: int, divider_orient: str, axis: int, rects: list[Rectangle]) -> np.ndarray:
+    grid = np.full((h, w), BLACK, dtype=int)
+    if divider_orient == "horizontal":
+        grid[axis, :] = GREY
+    else:
+        grid[:, axis] = GREY
