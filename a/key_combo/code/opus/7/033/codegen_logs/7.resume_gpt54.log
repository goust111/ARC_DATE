+
+def _preferred_edge_positions(values: list[int]) -> list[int]:
+    if len(values) > 2:
+        return values[1:-1]
+    return values
+
+
+def _mark_active_rectangle(grid: np.ndarray, rect: Rectangle) -> None:
+    edge_cells = {
