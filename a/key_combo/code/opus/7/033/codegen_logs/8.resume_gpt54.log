# Canvas and palette.
BACKGROUND_COLOR = 0
CANVAS_SIZE_MIN = 20
CANVAS_SIZE_MAX = 23
FOREGROUND_COLORS = tuple(range(1, 10))

# Sprite bbox and fill constraints.
SPRITE_HEIGHT_MIN = 3
SPRITE_HEIGHT_MAX = 7
SPRITE_WIDTH_MIN = 4
SPRITE_WIDTH_MAX = 9
SPRITE_AREA_MIN = 15
SPRITE_AREA_MAX = 36
SPRITE_FILL_MIN = 0.40
SPRITE_FILL_MAX = 0.66

