+
+def marker_direction(sprite: np.ndarray, r: int, c: int) -> tuple[int, int]:
+    h, w = sprite.shape
+    dirs = []
+    if r == 0:
+        dirs.append((-1, 0))
+    if r == h - 1:
+        dirs.append((1, 0))
+    if c == 0:
+        dirs.append((0, -1))
+    if c == w - 1:
