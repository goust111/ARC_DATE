+    for obj_id, coords in enumerate(find_components(grid != bg)):
+        r0, c0, r1, c1 = bbox_from_coords(coords)
+        sprite = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+        for rr, cc in coords:
+            sprite[int(rr) - r0, int(cc) - c0] = grid[int(rr), int(cc)]
