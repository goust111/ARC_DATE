+    for r in range(h):
+        for c in range(w):
+            if out[r, c] != bg or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            region = []
+            touches_edge = False
+            while q:
+                cr, cc = q.popleft()
+                region.append((cr, cc))
+                if cr in (0, h - 1) or cc in (0, w - 1):
+                    touches_edge = True
+                for nr, nc in neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and out[nr, nc] == bg and not visited[nr, nc]:
