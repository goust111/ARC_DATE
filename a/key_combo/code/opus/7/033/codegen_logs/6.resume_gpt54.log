+    for lr, (r0, r1) in enumerate(row_runs):
+        tile_row: list[np.ndarray] = []
+        for lc, (c0, c1) in enumerate(col_runs):
+            tile = g[r0 : r1 + 1, c0 : c1 + 1]
+            tile_row.append(tile)
