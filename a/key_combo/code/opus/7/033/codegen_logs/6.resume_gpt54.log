+    random.shuffle(values)
+    return np.array(values[:total], dtype=int).reshape(lattice_h, lattice_w)
+
+
+def _place_tile(canvas: np.ndarray, tile: np.ndarray, r0: int, c0: int) -> None:
+    h, w = tile.shape
+    canvas[r0 : r0 + h, c0 : c0 + w] = tile
