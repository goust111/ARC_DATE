+
+def _make_majority_matrix(rows: int, cols: int) -> tuple[np.ndarray, set[tuple[int, int]], set[tuple[int, int]]] | None:
+    pattern = _choose_zero_pattern(rows, cols)
+    if pattern is None:
+        return None
+    zeros, holes = pattern
+
+    matrix = np.zeros((rows, cols), dtype=int)
+    used_nonzero = set()
+    for r in range(rows):
