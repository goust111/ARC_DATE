+def _noisy_block(height: int, width: int, majority: int) -> np.ndarray:
+    block = np.full((height, width), int(majority), dtype=int)
+    cells = height * width
+    max_noise = min(cells // 3, 4)
+    noise_count = random.randint(1, max_noise) if max_noise else 0
