+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+SOURCE_COLORS = (GREEN, YELLOW)
+MARKER_COLORS = (BLUE, RED)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
