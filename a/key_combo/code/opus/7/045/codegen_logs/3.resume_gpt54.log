+            continue
+        if np.any(grid[r0, c0 + 1 : c1] != BG):
+            continue
+        if np.any(grid[r1, c0 + 1 : c1] != BG):
+            continue
+        if np.any(grid[r0 + 1 : r1, c0] != BG):
+            continue
+        if np.any(grid[r0 + 1 : r1, c1] != BG):
+            continue
+        if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] != BG):
+            continue
