+    mask = patch != BG
+    view = dst[top : top + patch.shape[0], left : left + patch.shape[1]]
+    view[mask] = patch[mask]
+
+
+def _extract_template(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    source_mask = np.isin(grid, SOURCE_COLORS)
