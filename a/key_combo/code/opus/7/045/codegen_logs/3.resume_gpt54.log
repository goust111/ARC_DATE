+            return sprite
+    raise RuntimeError("failed to color the source sprite")
+
+
+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
