+
+        rows = {r for r, _ in cells}
+        cols = {c for _, c in cells}
+        if rows != {0, 1, 2} or cols != {0, 1, 2}:
+            continue
+
+        mask = np.zeros((SPRITE_SIZE, SPRITE_SIZE), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
