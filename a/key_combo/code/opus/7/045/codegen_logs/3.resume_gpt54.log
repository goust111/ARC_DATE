    for seed in first_seeds:
        reserved = np.zeros_like(mask, dtype=bool)
        reserved[seed[0], rw - 1 - seed[1]] = True
        cells = _gen_grow_blob(~reserved, size, seed)
        if cells is None:
            continue
        mask[tuple(zip(*cells))] = True
        return reserved
    return None


