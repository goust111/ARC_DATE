+        cells = {(random.randrange(SPRITE_SIZE), random.randrange(SPRITE_SIZE))}
+        while len(cells) < area:
+            r, c = random.choice(tuple(cells))
+            neighbors = []
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < SPRITE_SIZE and 0 <= nc < SPRITE_SIZE and (nr, nc) not in cells:
