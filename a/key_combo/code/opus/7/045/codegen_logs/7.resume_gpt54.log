+    landing_counts = Counter(ray["landing"] for ray in ray_specs)
+    if max(landing_counts.values()) < 2:
+        return None
+    if 1 not in landing_counts.values():
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
