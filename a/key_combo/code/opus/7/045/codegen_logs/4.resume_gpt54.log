+    if seg["orient"] == "h":
+        return r0 <= int(seg["r"]) <= r1 and _intervals_overlap(int(seg["c0"]), int(seg["c1"]), c0, c1)
+    return c0 <= int(seg["c"]) <= c1 and _intervals_overlap(int(seg["r0"]), int(seg["r1"]), r0, r1)
+
+
+def _segment_cuts_bbox(seg: Segment, box: BBox) -> bool:
+    r0, c0, r1, c1 = box
+    if seg["orient"] == "h":
+        return r0 < int(seg["r"]) < r1 and _intervals_overlap(int(seg["c0"]), int(seg["c1"]), c0, c1)
+    return c0 < int(seg["c"]) < c1 and _intervals_overlap(int(seg["r0"]), int(seg["r1"]), r0, r1)
