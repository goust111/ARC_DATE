+            assert c0 >= 1 and c1 + 1 < g.shape[1], "split rectangle must stay in bounds after moving"
+            out[r0 : r1 + 1, c0 - 1 : cut_c] = GREY
+            out[r0 : r1 + 1, cut_c + 1 : c1 + 2] = GREY
