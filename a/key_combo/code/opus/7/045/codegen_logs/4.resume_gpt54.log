+
+
+def _count_crossings(segments: list[Segment]) -> int:
+    horizontals = [seg for seg in segments if seg["orient"] == "h"]
+    verticals = [seg for seg in segments if seg["orient"] == "v"]
+    total = 0
+    for h_seg in horizontals:
