+        if seg["orient"] == "h":
+            out[int(seg["r"]), int(seg["c0"]) : int(seg["c1"]) + 1] = int(seg["color"])
+    for seg in segments:
+        if seg["orient"] == "v":
+            out[int(seg["r0"]) : int(seg["r1"]) + 1, int(seg["c"])] = int(seg["color"])
