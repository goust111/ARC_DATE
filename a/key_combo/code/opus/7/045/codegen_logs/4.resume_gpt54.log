+    if out.ndim != 2 or max(out.shape) > 30:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle-4 input")

