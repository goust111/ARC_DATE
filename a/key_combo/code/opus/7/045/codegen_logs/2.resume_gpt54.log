+
+    exp = _expected_output(grid)
+    if not np.array_equal(pred, exp):
+        return None
+    if np.array_equal(pred, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
