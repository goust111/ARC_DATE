+    out = g.copy()
+    for pos, frame_id in enumerate(order):
+        src_id = order[(pos + step) % len(order)]
+        r0, c0, r1, c1 = frames[frame_id]["bbox"]
+        inner = out[r0 + 1 : r1, c0 + 1 : c1]
