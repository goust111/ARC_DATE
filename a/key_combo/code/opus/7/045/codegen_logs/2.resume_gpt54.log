import random

import numpy as np
from typing import *
from arc_utils import Color, bbox, draw_line

# concepts:
# counting, uniqueness, surrounding

# description:
# In the input, you will see a grid with a black background and colored pixels sprinkled on it. Exactly one color occurs only one time.
# To make the output, find the cell whose color is unique (color occurs only one time), and surround that cell with red pixels. Make all the other pixels black.

def main(input_grid: np.ndarray) -> np.ndarray:
    """
    Isolate the uniquely colored cell and surround it with a red 3 by 3 frame.

    Input structure:
    - The background is black.
    - Exactly one non-black color occurs once.
    - Other non-black colors occur zero times or more than once.

    Rule:
    - Find the first non-black color with exactly one cell.
    - Create a black output grid.
    - Fill the 3 by 3 neighborhood around that cell red, then restore the unique cell's original color.

    Key insight:
    - Frequency, not position or shape, identifies the target cell; all non-target input pixels are discarded.
    """
    # Plan:
    # 1. Create a blank new canvas (so that the non-unique colors don't get copied)
    # 2. Find the unique cell
    # 3. Surround the unique cell with red pixels

    output_grid = np.zeros_like(input_grid)

    # 2. Find the unique cell
    unique_color = None
    for color in Color.NOT_BLACK:
        if np.count_nonzero(input_grid == color) == 1:
            unique_color = color
            break
    assert unique_color is not None
    
    # 3. Surround the unique cell with red pixels
    # First get the coordinates of the unique cell
    _b = bbox(input_grid == unique_color)
    assert _b is not None
    r, c, _r1, _c1 = _b
