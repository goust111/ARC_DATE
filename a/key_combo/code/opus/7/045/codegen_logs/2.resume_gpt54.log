+
+
+def _bfs_path(
+    shape: tuple[int, int],
+    start: tuple[int, int],
+    end: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    if start == end:
+        return [start]
+    q = deque([start])
+    prev: dict[tuple[int, int], tuple[int, int] | None] = {start: None}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            nxt = (nr, nc)
+            if not _in_bounds(shape, nr, nc):
+                continue
+            if nxt in prev:
+                continue
+            if nxt != end and (nxt in occupied or nxt in blocked):
+                continue
+            prev[nxt] = (r, c)
+            if nxt == end:
+                path = [end]
+                cur = end
+                while prev[cur] is not None:
