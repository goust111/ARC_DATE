+        return "horizontal"
+    if dc == 0:
+        return "vertical"
+    return "diagonal"
+
+
+def _pick_targets(source_directions: list[tuple[int, int]]) -> dict[tuple[int, int], tuple[int, int]]:
+    groups = {
