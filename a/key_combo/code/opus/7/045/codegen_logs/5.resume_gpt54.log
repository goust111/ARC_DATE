+    dr, dc = base_direction
+    sr, sc = COLOR_TO_SIGN[swapped_color]
+    out_r = 0 if dr == 0 else dr * sr
+    out_c = 0 if dc == 0 else dc * sc
+    return int(out_r), int(out_c)
