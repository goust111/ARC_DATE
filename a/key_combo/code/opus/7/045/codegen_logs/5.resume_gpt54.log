+            if not mask[r0, c0] or visited[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            visited[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
