+VERTICAL_DIRECTIONS = [(-1, 0), (1, 0)]
+HORIZONTAL_DIRECTIONS = [(0, -1), (0, 1)]
+DIAGONAL_DIRECTIONS = [d for d in ALL_DIRECTIONS if d[0] != 0 and d[1] != 0]
