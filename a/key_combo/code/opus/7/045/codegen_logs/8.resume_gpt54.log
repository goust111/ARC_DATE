+_TILE_FORMULAS = (
+    (1, 1, 0),
+    (1, 2, 0),
+    (2, 1, 1),
+    (2, 2, 2),
+)
+
+_SOURCE_PATTERNS = (
+    (
+        (0, 1, YELLOW),
+        (-1, 1, ORANGE),
+        (1, 1, ORANGE),
+        (-1, 2, YELLOW),
+        (0, 2, ORANGE),
+        (1, 2, YELLOW),
+    ),
+    (
+        (0, 1, ORANGE),
+        (0, 2, YELLOW),
+        (-1, 2, ORANGE),
+        (1, 2, ORANGE),
+        (-1, 3, YELLOW),
+        (1, 3, YELLOW),
+    ),
+    (
+        (0, 1, YELLOW),
+        (1, 1, ORANGE),
+        (-1, 2, YELLOW),
+        (0, 2, ORANGE),
+        (1, 2, YELLOW),
+    ),
+)
