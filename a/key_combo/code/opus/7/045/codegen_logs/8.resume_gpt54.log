+    h, w = base.shape
+    candidates: list[tuple[int, int, int]] = []
+    for ar, ac in anchors:
+        if ar < h // 2 or ac < w // 2:
+            continue
+        ok = True
+        covered: set[tuple[int, int]] = set()
+        for dr, dc, _color in source_offsets:
