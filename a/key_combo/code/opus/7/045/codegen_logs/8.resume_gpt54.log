+    for ar, ac in np.argwhere(out == RED):
+        ar = int(ar)
+        ac = int(ac)
+        for dr, dc, color in source_offsets:
+            rr = ar + dr
+            cc = ac + dc
+            assert _in_bounds(out.shape, rr, cc), "stamp must stay inside the grid"
+            out[rr, cc] = color
