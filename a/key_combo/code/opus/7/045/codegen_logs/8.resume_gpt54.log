+def _rotate_offsets(
+    offsets: tuple[tuple[int, int, int], ...], turns: int
+) -> list[tuple[int, int, int]]:
+    rotated = [(dr, dc, color) for dr, dc, color in offsets]
+    for _ in range(turns % 4):
+        rotated = [(-dc, dr, color) for dr, dc, color in rotated]
+    return rotated
