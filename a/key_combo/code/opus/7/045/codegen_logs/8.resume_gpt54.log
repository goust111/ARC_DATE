+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+TILE_COLORS = (BLUE, RED, GREEN, GREY)
+SOURCE_COLORS = (YELLOW, ORANGE)
+GEN_ATTEMPTS = 400
