+    sprite = _sprite_patch()
+    side = random.choice((3, 4))
+    if sprite.shape[0] > side or sprite.shape[1] > side:
+        return None
+
+    separator = random.randint(2, 4)
+    left_width = random.randint(8, 11)
+    right_start = left_width + separator
