+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(20, 28)
+    w = random.randint(24, 30)
+    frame_count = random.choice((2, 3, 3))
+    colors = list(FRAME_COLORS[:frame_count])
+    random.shuffle(colors)
