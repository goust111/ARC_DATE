+        frame = {
+            "color": spec["color"],
+            "side": spec["side"],
+            "missing_kind": spec["missing_kind"],
+            "missing": corners_map[spec["missing_kind"]],
+            "markers": tuple(sorted(pt for name, pt in corners_map.items() if name != spec["missing_kind"])),
