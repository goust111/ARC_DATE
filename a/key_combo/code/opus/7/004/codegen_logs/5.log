+
+def _orient_sprite(sprite: np.ndarray, source_corner: str, target_corner: str, bg: int) -> np.ndarray:
+    out = sprite.copy()
+    src_sign = CORNER_SIGN[source_corner]
+    dst_sign = CORNER_SIGN[target_corner]
+    if src_sign[0] != dst_sign[0]:
