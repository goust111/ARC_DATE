+        corner = random.choice(tuple(CORNER_SIGN))
+        if len(set(corners + [corner])) == 1:
+            continue
+        corners.append(corner)
+    random.shuffle(corners)
+    if source_corner not in corners:
+        corners[0] = source_corner
