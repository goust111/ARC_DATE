+
+def _group_cells(
+    frame_top: int,
+    frame_left: int,
+    side: int,
+    missing_kind: str,
+    sprite: np.ndarray,
+    copies: int,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
