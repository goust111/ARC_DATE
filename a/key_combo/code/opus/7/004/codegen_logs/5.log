+    for idx in range(copies):
+        if sign[0] < 0:
+            r0 = anchor[0] - (idx + 1) * h + 1
+        else:
+            r0 = anchor[0] + idx * h
+        if sign[1] < 0:
+            c0 = anchor[1] - (idx + 1) * w + 1
+        else:
