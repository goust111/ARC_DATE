+    rows = sorted({r for r, _ in singles})
+    cols = sorted({c for _, c in singles})
+    frames = []
+    seen = set()
+    for r0 in rows:
+        for span in (2, 3):
+            r1 = r0 + span
+            if r1 not in rows:
