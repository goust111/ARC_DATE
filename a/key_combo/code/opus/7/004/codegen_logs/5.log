+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+SPRITE_COLOR = 4
+FRAME_COLORS = (1, 2, 3)
+CORNER_SIGN = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
