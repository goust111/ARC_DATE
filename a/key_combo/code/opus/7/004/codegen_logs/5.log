+                    "tl": (r0, c0),
+                    "tr": (r0, c1),
+                    "bl": (r1, c0),
+                    "br": (r1, c1),
+                }
+                present = [name for name, pt in corners.items() if pt in singles]
+                if len(present) != 3:
