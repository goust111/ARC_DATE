+    assert len(sprite_comps) == 1, "expected exactly one yellow sprite component"
+    sprite_box = bbox_coords(sprite_comps[0])
+    sprite = np.where(crop_bbox(g, sprite_box) == SPRITE_COLOR, SPRITE_COLOR, bg)
