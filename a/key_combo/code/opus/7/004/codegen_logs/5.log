+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != transparent
+    view[mask] = patch[mask]
+
+
+def _corner_matches_bbox(corner: str, point: tuple[int, int], box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
