+
+import random
+
+import numpy as np
+
+
+BG = 0
+SPRITE_COLOR = 4
+FRAME_COLORS = (1, 2, 3)
+CORNER_SIGN = {
+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
+COMPONENT_SHAPES = (
+    np.array([[1]], dtype=int),
+    np.array([[1, 1]], dtype=int),
+    np.array([[1], [1]], dtype=int),
+    np.array([[1, 1, 1]], dtype=int),
+    np.array([[1], [1], [1]], dtype=int),
+    np.array([[1, 1], [1, 0]], dtype=int),
+    np.array([[1, 1], [0, 1]], dtype=int),
+)
+SPRITE_SHAPES = (
