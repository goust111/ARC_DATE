+            return False
+        r0, c0, cells = random.choice(candidates)
+        paste(grid, patch, r0, c0, transparent=BG)
+        forbidden |= _dilate_cells(cells, h, left_width)
+    return True
+
+
+def _render_expected(
+    grid: np.ndarray,
+    frames: list[dict],
+    source_color: int,
+    source_corner: str,
+    sprite: np.ndarray,
+    counts: dict[int, int],
