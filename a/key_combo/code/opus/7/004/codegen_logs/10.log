+import numpy as np
+
+
+BG = 0
+TEMPLATE = 1
+FRAME = 2
+OBSTACLE = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+_PATTERN_CACHE: dict[tuple[int, int], list[dict]] = {}
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    if connectivity == 4:
+        neighbors = DIR4
+    else:
+        neighbors = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in neighbors:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _frame_components(grid: np.ndarray) -> list[dict]:
+    frames = []
+    for coords in components_mask(grid == FRAME, connectivity=4):
+        r0, c0, r1, c1 = bbox_coords(coords)
+        patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 4 or w < 4:
+            continue
+        expected = 2 * (h + w) - 4
+        if len(coords) != expected:
+            continue
+        if not np.all(patch[0, :] == FRAME):
+            continue
+        if not np.all(patch[-1, :] == FRAME):
+            continue
+        if not np.all(patch[:, 0] == FRAME):
+            continue
+        if not np.all(patch[:, -1] == FRAME):
+            continue
+        inner = patch[1:-1, 1:-1]
+        if np.any(inner == FRAME):
