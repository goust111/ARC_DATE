+
+def _largest_zero_rect(inner: np.ndarray) -> tuple[int, int]:
+    h, w = inner.shape
+    blocked = (inner != BG).astype(int)
+    pref = np.pad(blocked, ((1, 0), (1, 0)))
+    pref = pref.cumsum(axis=0).cumsum(axis=1)
+    best_area = -1
+    best_count = 0
+    for r0 in range(h):
