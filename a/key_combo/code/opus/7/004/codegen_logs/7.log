+        below_survivors = 0
+        for r, c in det["survived"]:
+            if r < det["guide_row"]:
+                above_survivors += 1
+            else:
+                below_survivors += 1
+        if above_survivors < 1 or below_survivors < 1:
+            return False
+
+    out = main(grid)
+    if out.ndim != 2 or max(out.shape) > 30:
+        return False
+    if out.shape[0] != 14:
+        return False
+    return True
