+        if not solid_mask[c]
+    )
+    blues = [(int(r), int(c)) for r, c in np.argwhere(region == BLUE)]
+    survived = []
+    erased = []
+    far_projection = False
+    for r, c in blues:
+        side = "above" if r < guide_r else "below"
+        near_row = guide_r - 1 if side == "above" else guide_r + 1
+        if r != near_row:
