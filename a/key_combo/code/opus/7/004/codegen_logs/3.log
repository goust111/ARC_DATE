+def _paint_structure(grid: np.ndarray, spec: dict, color: int) -> None:
+    for r, c in spec["wall"]:
+        grid[r, c] = Color.GREY
+    candidates = [cell for cell in spec["cavity"] if cell != spec["start"]]
+    seed = random.choice(candidates)
+    grid[seed] = color
