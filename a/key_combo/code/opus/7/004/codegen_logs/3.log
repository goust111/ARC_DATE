+
+def _pairwise_min_gap(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> int:
+    best = 10**9
+    for r1, c1 in a:
+        for r2, c2 in b:
+            best = min(best, max(abs(r1 - r2), abs(c1 - c2)))
+    return best
+
