+    r, c = collision
+    if side == "left":
+        return (r, c - distance)
+    if side == "right":
+        return (r, c + distance)
+    if side == "top":
+        return (r - distance, c)
+    if side == "bottom":
+        return (r + distance, c)
+    raise ValueError(side)
