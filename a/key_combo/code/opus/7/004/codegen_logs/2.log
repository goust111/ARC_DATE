+    max_outer_w = 27
+    max_outer_h = 29
+    min_inner = 3
+    max_inner_h = max(min_inner, min(8, max_outer_h - 2 * total_inset))
+    max_inner_w = max(min_inner, min(8, max_outer_w - 2 * total_inset))
