+    frames = []
+    r0 = top_margin
+    c0 = left_margin
+    r1 = r0 + outer_h - 1
+    c1 = c0 + outer_w - 1
+    frames.append((r0, c0, r1, c1))
+    for gap in gaps:
+        inset = gap + 1
+        r0 += inset
+        c0 += inset
+        r1 -= inset
