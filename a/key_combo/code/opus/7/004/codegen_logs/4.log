+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(grid.shape, nr, nc):
+                continue
+            if seen[nr, nc] or int(grid[nr, nc]) != Color.BLACK:
