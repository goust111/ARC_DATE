+    for dr in (-1, 0, 1):
+        specs.append((cr + dr, cc - 2, Color.RED, "left"))
+        specs.append((cr + dr, cc + 2, Color.RED, "right"))
+    specs.append((cr - 1, cc, Color.GREY, "up"))
+    for dc in range(-2, 3):
+        specs.append((cr + 2, cc + dc, Color.TEAL, "down"))
+    return specs
+
