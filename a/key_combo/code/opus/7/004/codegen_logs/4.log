+def _axial_run_lengths(grid: np.ndarray, cr: int, cc: int) -> dict[str, int]:
+    dirs = {
+        "up": (-1, 0),
+        "down": (1, 0),
+        "left": (0, -1),
+        "right": (0, 1),
+    }
+    out: dict[str, int] = {}
+    for name, (dr, dc) in dirs.items():
+        dist = 0
+        r, c = cr, cc
+        while True:
+            r += dr
+            c += dc
+            if not in_bounds(grid.shape, r, c) or int(grid[r, c]) != Color.BLACK:
+                break
+            dist += 1
+        out[name] = dist
