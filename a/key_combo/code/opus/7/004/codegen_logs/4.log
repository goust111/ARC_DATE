+    for nr, nc in neighbors4(*start):
+        if in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == Color.BLACK and not seen[nr, nc]:
+            seen[nr, nc] = True
+            q.append((int(nr), int(nc)))
