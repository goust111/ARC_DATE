+            if int(g[r, c]) != Color.BLACK:
+                continue
+            if reach[r, c]:
+                out[r, c] = int(color)
+
+    out[g == Color.GREEN] = Color.GREEN
+    out[g == Color.TEAL] = Color.TEAL
+    return out
+
+
+def _choose_controls(h: int, w: int, n_controls: int) -> list[tuple[int, int]]:
+    controls: list[tuple[int, int]] = []
+    for _ in range(200):
+        controls.clear()
+        while len(controls) < n_controls:
+            cr = _RNG.randint(_CONTROL_MARGIN, h - _CONTROL_MARGIN - 1)
+            cc = _RNG.randint(_CONTROL_MARGIN, w - _CONTROL_MARGIN - 1)
+            ok = True
+            for orr, occ in controls:
+                if abs(cr - orr) + abs(cc - occ) < 8:
+                    ok = False
+                    break
+                if abs(cr - orr) <= 2 * _LOCAL_RADIUS and abs(cc - occ) <= 2 * _LOCAL_RADIUS:
+                    ok = False
