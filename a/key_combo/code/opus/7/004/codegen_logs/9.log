+                    continue
+                bcol = s_blue - 1
+                gcol = s_green + 1
+                if bcol < 2 or gcol > width - 3:
+                    continue
+                mid = (bcol + gcol) // 2
+                tie_ok = mid in solid_set and mid not in {s_blue, s_green}
+
+                other_gaps = [g for g in gap_pool if g != g_seed]
+                random.shuffle(other_gaps)
+                for g_unseed in other_gaps:
+                    nearby = [
+                        s
+                        for s in solid_cols
+                        if 1 <= abs(s - g_unseed) <= 4 and s not in {s_blue, s_green}
+                    ]
+                    if not nearby:
+                        continue
+                    u_solid = random.choice(nearby)
+                    return {
+                        "blue_seed": bcol,
+                        "ab_blue": s_blue,
+                        "b_only": g_seed,
+                        "ab_green": s_green,
+                        "green_seed": gcol,
+                        "tie_col": mid,
+                        "tie_ok": int(tie_ok),
+                        "a_only": u_solid,
+                        "neither": g_unseed,
+                    }
+    return None
+
+
+def _box_rows(side: str, guide_r: int) -> tuple[int, int]:
+    if side == "top":
+        r1 = guide_r - 2
+        r0 = r1 - BOX_HEIGHT + 1
+    else:
+        r0 = guide_r + 2
+        r1 = r0 + BOX_HEIGHT - 1
+    return r0, r1
+
+
+def _build_box(
+    side: str,
+    guide_r: int,
+    specs: list[dict[str, int | str]],
+) -> dict:
+    r0, r1 = _box_rows(side, guide_r)
+    cols = [int(spec["col"]) for spec in specs]
+    c0 = min(cols) - 2
+    c1 = max(cols) + 2
