+    }
+    for color, seed in seeds.items():
+        sr, sc = seed
+        cand = None
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(grid.shape, nr, nc):
+                continue
+            if (nr, nc) == seed:
