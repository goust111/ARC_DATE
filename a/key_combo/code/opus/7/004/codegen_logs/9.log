+    unseeded_specs: list[dict[str, int | str]] = [
+        {"label": "a_only", "color": YELLOW, "col": roles["a_only"], "slot": "upper_near"},
+        {"label": "neither", "color": YELLOW, "col": roles["neither"], "slot": "lower_near"},
