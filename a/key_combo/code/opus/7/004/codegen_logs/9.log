+    random.shuffle(spare)
+    for c in spare[: random.randint(1, min(2, len(spare)))]:
+        depth = random.choice([1, 2])
+        if random.random() < 0.5:
+            for d in range(1, depth + 1):
+                black_cells.add((trunk_r - d, c))
+        else:
+            for d in range(1, depth + 1):
+                black_cells.add((trunk_r + d, c))
