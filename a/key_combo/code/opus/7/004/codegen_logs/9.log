+BLACK = Color.BLACK
+BLUE = Color.BLUE
+RED = Color.RED
+GREEN = Color.GREEN
+YELLOW = Color.YELLOW
+TEAL = Color.TEAL
+
+GRID_H_RANGE = (20, 24)
+GRID_W_RANGE = (18, 26)
