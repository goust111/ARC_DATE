+                    if not nearby:
+                        continue
+                    u_solid = random.choice(nearby)
+                    return {
+                        "blue_seed": bcol,
+                        "ab_blue": s_blue,
+                        "b_only": g_seed,
+                        "ab_green": s_green,
+                        "green_seed": gcol,
