+def _box_rows(side: str, guide_r: int) -> tuple[int, int]:
+    if side == "top":
+        r1 = guide_r - 2
+        r0 = r1 - BOX_HEIGHT + 1
+    else:
+        r0 = guide_r + 2
+        r1 = r0 + BOX_HEIGHT - 1
