+
+def _global_notches(pattern: dict, top: int, left: int) -> list[dict]:
+    return [
+        {
+            "direction": notch["direction"],
+            "center": (top + notch["center"][0], left + notch["center"][1]),
+        }
+        for notch in pattern["notches"]
+    ]
