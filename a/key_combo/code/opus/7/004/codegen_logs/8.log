import itertools, numpy as np
DIRS={'up':(-1,0),'down':(1,0),'left':(0,-1),'right':(0,1)}

def cross(center):
    r,c=center
    return {(r,c),(r-1,c),(r+1,c),(r,c-1),(r,c+1)}

def connected(mask):
    pts={(r,c) for r,c in zip(*np.where(mask))}
    if not pts:return False
    stack=[next(iter(pts))]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            q=(r+dr,c+dc)
            if q in pts and q not in seen:
                seen.add(q); stack.append(q)
    return len(seen)==len(pts)

def find(dirs):
    for h in range(4,8):
      for w in range(4,8):
        if ('up' in dirs or 'down' in dirs) and w<5: continue
        if ('left' in dirs or 'right' in dirs) and h<5: continue
        cands={}
        if 'up' in dirs: cands['up']=[(0,c) for c in range(2,w-2)]
        if 'down' in dirs: cands['down']=[(h-1,c) for c in range(2,w-2)]
        if 'left' in dirs: cands['left']=[(r,0) for r in range(2,h-2)]
        if 'right' in dirs: cands['right']=[(r,w-1) for r in range(2,h-2)]
        if any(not v for v in cands.values()): continue
        ks=list(cands)
        for picks in itertools.product(*[cands[k] for k in ks]):
            rect=np.ones((h,w),dtype=int)
            ok=True
            allcross=[]
            for ctr in picks:
                cc=cross(ctr)
                allcross.append(cc)
            # require cross sets disjoint inside expanded bbox? just disjoint full coords
            union=set()
            for cc in allcross:
                if union & cc:
                    ok=False; break
                union |= cc
            if not ok: continue
            for r,c in union:
                if 0<=r<h and 0<=c<w:
                    rect[r,c]=0
            area=rect.sum()
            if 8<=area<=18 and connected(rect):
                return dirs,h,w,dict(zip(ks,picks)),area,rect
    return None
