+def _global_crosses(pattern: dict, top: int, left: int) -> set[tuple[int, int]]:
+    cells = set()
+    for notch in _global_notches(pattern, top, left):
+        cells.update(_notch_pattern(notch["center"], notch["direction"])["cross"])
