+def _isolated_from_obstacles(cell: tuple[int, int], placed: set[tuple[int, int]]) -> bool:
+    r, c = cell
+    for rr, cc in placed:
+        if max(abs(r - rr), abs(c - cc)) <= 1:
+            return False
+    return True
+
