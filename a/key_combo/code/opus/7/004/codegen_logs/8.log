+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RIGHT_COLOR = 1
+UP_COLOR = 2
+DOWN_COLOR = 3
+LEFT_COLOR = 4
+OBJ = 5
+OBSTACLE = 7
+
+DIRS = {
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+    "left": (0, -1),
+}
+DIR_COLOR = {
+    "up": UP_COLOR,
+    "right": RIGHT_COLOR,
+    "down": DOWN_COLOR,
+    "left": LEFT_COLOR,
+}
+FRAME_COLORS = {RIGHT_COLOR, UP_COLOR, DOWN_COLOR, LEFT_COLOR}
+FRAME_BY_DIR = {
+    "up": UP_COLOR,
+    "right": RIGHT_COLOR,
+    "down": DOWN_COLOR,
+    "left": LEFT_COLOR,
+}
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _frame_bbox(grid: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(np.isin(grid, list(FRAME_COLORS)))
+    assert len(coords) > 0, "expected a colored frame"
+    return _bbox_coords(coords)
+
+
+def _direction_distances(r: int, c: int, frame_bbox: tuple[int, int, int, int]) -> dict[str, int]:
+    fr0, fc0, fr1, fc1 = frame_bbox
+    return {
+        "up": r - fr0,
+        "down": fr1 - r,
+        "left": c - fc0,
+        "right": fc1 - c,
+    }
+
+
+def _notch_pattern(center: tuple[int, int], direction: str) -> dict[str, tuple[tuple[int, int], ...]]:
+    r, c = center
+    dr, dc = DIRS[direction]
+    pr, pc = -dc, dr
+    cross = (
+        (r, c),
+        (r + dr, c + dc),
+        (r - dr, c - dc),
+        (r + pr, c + pc),
+        (r - pr, c - pc),
+    )
+    support = (
+        (r - 2 * dr, c - 2 * dc),
+        (r - dr + pr, c - dc + pc),
+        (r - dr - pr, c - dc - pc),
+        (r + 2 * pr, c + 2 * pc),
+        (r - 2 * pr, c - 2 * pc),
+    )
+    open_side = (
+        (r + 2 * dr, c + 2 * dc),
+        (r + dr + pr, c + dc + pc),
+        (r + dr - pr, c + dc - pc),
+    )
+    return {"cross": cross, "support": support, "open_side": open_side}
+
+
+def _notch_directions(grid: np.ndarray, r: int, c: int) -> list[str]:
+    out = []
+    for direction in DIRS:
