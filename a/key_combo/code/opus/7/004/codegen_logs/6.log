+    anchor_mask = random.choice(ANCHOR_SHAPES)
+    ah, aw = anchor_mask.shape
+    anchor_r0 = ar - ah // 2
+    anchor_c0 = ac - aw // 2
+    paste(grid, _colorize(anchor_mask, ANCHOR), anchor_r0, anchor_c0, transparent=BG)
+
