+def _build_attempt() -> tuple[np.ndarray, np.ndarray] | None:
+    h = random.choice([21, 23, 25, 27])
+    w = random.choice([19, 21, 23, 25, 27])
+    ar = h // 2 - 1
+    ac = w // 2
+
