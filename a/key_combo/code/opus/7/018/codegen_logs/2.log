+    for side, color in zip(sides, colors[1:]):
+        coords = random_asymmetric_shape()
+        sampled = _sample_position(grid, occupied, reserved, coords, axis_col, side)
+        if sampled is None:
+            return None
+        top, left, (abs_in, abs_out) = sampled
+        for r, c in abs_in:
+            occupied[r, c] = True
+        for r, c in abs_out:
+            reserved[r, c] = True
