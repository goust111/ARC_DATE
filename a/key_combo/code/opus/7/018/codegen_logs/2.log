+    colors = random.sample(list(range(1, 10)), n_objects)
+
+    anchor_shape = _choose_anchor_shape()
+    anchor_top, anchor_left = _anchor_position(h, w, anchor_shape)
+    place_shape(grid, anchor_shape, anchor_top, anchor_left, colors[0])
