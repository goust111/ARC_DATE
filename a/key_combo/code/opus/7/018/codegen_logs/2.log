+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    if not np.array_equal(out[anchor["mask"]], grid[anchor["mask"]]):
+        return False
+
+    for item in movers:
+        if np.any(out[item["mask"]] != 0):
+            return False
+        for r, c in reflect_coords(np.argwhere(item["mask"]), axis_col):
+            if out[r, c] != item["color"]:
+                return False
+    return True
