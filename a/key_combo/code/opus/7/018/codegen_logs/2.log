+
+def random_asymmetric_shape():
+    for _ in range(64):
+        base = random.choice(ASYMMETRIC_SHAPES)
+        coords = transform_shape(
+            base,
+            rot=random.randrange(4),
+            flip_h=bool(random.getrandbits(1)),
+            flip_v=bool(random.getrandbits(1)),
