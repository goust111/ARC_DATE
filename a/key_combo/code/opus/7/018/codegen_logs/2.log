+
+def normalize_shape(coords):
+    arr = np.array(coords, dtype=int)
+    arr[:, 0] -= arr[:, 0].min()
+    arr[:, 1] -= arr[:, 1].min()
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return [tuple(map(int, cell)) for cell in arr[order]]
