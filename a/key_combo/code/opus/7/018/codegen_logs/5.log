+def _enclosed_regions(grid: np.ndarray) -> list[np.ndarray]:
+    regions = []
+    for comp in _components(grid != GREY, connectivity=4):
+        if not _touches_border(comp, grid.shape):
+            regions.append(comp)
+    return regions
