def _gen_grow_qualifying_arms(cells, rect_cells, endpoints, extra_steps):
    """Extend seeded arms inside the 5x5 patch; mutates cells and endpoints."""
    bounds = (_GEN_QUAL_PATCH_SPAN, _GEN_QUAL_PATCH_SPAN)
