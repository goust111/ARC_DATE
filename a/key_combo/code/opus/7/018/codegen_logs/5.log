                cells.add(cand)
                endpoint[0] = cand
                endpoint[1] = (ndr, ndc)
                placed = True
                break
            if placed:
                break
        if not placed:
            return False
    return True


def _gen_render_patch(cells, red_cells=()):
    r0, c0, r1, c1 = _gen_bbox(cells)
    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), _GEN_GREY, dtype=int)
    for r, c in cells:
        patch[r - r0, c - c0] = _GEN_BLACK
    for r, c in red_cells:
        patch[r - r0, c - c0] = _GEN_RED
    return patch


