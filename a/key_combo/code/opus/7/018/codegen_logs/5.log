+    grid[r1, c0 : c1 + 1] = GREY
+    grid[r0 : r1 + 1, c0] = GREY
+    grid[r0 : r1 + 1, c1] = GREY
+
+
+def _ring_components(grid: np.ndarray) -> list[np.ndarray]:
+    return _components(grid == GREY, connectivity=4)
