+    return [
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr != 0 or dc != 0
+    ]
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
