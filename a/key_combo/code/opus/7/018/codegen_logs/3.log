+
+
+def _choose_group_sizes(fill_count: int) -> list[int]:
+    if fill_count == 4:
+        return [2, 2]
+    if fill_count == 5:
+        return random.choice(([2, 3], [3, 2]))
+    return random.choice(([3, 3], [2, 2, 2]))
