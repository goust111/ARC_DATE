+
+
+def _expected_from_groups(shape: tuple[int, int], groups: list[dict]) -> np.ndarray:
+    ranked = _rank_groups(groups, "size")
+    out = np.zeros(shape, dtype=int)
+    if len(ranked) == 1:
+        survivors = {ranked[0]["color"]: YELLOW}
+    else:
+        survivors = {ranked[0]["color"]: YELLOW}
+        for info in ranked[1:-1]:
