+                "color": color,
+                "frames": group_frames,
+                "union": union,
+                "size": int(union.sum()),
+                "max_visible": max(visible_counts),
+                "total_visible": total_visible,
+                "first": (group_frames[0]["r0"], group_frames[0]["c0"]),
+            }
