+    top, bottom = row_pad
+    left, right = col_pad
+    height = top + rows * FRAME_SIZE + (rows - 1) + bottom
+    width = left + cols * FRAME_SIZE + (cols - 1) + right
+    grid = np.zeros((height, width), dtype=int)
+    for item in assignments:
