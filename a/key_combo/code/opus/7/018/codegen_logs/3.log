+def generate_input() -> np.ndarray:
+    for _ in range(RETRY_LIMIT):
+        rows, cols = random.choice(((2, 3), (3, 2)))
+        fill_count = random.choices([4, 5, 6], weights=[2, 3, 5], k=1)[0]
