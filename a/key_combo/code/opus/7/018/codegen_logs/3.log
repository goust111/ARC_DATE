+        max_visible_a = min(large_size - 1, small_size - 1)
+        if min_visible_a > max_visible_a:
+            continue
+        visible_a = random.randint(min_visible_a, max_visible_a)
+        specs[overtaker] = {
+            "post_size": large_size,
+            "mode": "all_incomplete",
+            "max_visible": visible_a,
+        }
+        specs[overtaken] = {
