+        colors = random.sample(INPUT_COLORS, len(group_sizes))
+
+        shuffled_slots = used_slots[:]
+        random.shuffle(shuffled_slots)
+        slot_groups = []
+        cursor = 0
+        for size in group_sizes:
+            slot_groups.append(sorted(shuffled_slots[cursor : cursor + size]))
+            cursor += size
+
+        assignments = []
