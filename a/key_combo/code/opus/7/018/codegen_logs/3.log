+
+def _choose_group_specs(group_sizes: list[int]) -> list[dict] | None:
+    group_count = len(group_sizes)
+    for _ in range(160):
+        overtaker, overtaken = random.sample(range(group_count), 2)
+        specs: list[dict | None] = [None] * group_count
