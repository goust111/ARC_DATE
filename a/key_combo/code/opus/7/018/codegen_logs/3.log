+def _frame_bbox_overlaps(a: dict, b: dict) -> bool:
+    return not (
+        a["r0"] + FRAME_SIZE - 1 < b["r0"]
+        or b["r0"] + FRAME_SIZE - 1 < a["r0"]
+        or a["c0"] + FRAME_SIZE - 1 < b["c0"]
+        or b["c0"] + FRAME_SIZE - 1 < a["c0"]
+    )
