+        for c0 in range(w - FRAME_SIZE + 1):
+            parsed = _parse_frame(g[r0 : r0 + FRAME_SIZE, c0 : c0 + FRAME_SIZE])
+            if parsed is None:
+                continue
+            color, inner = parsed
+            frame = {
+                "r0": r0,
+                "c0": c0,
+                "color": color,
+                "inner": inner.copy(),
+                "visible_count": int(inner.sum()),
