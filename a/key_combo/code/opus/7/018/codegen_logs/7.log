+
+def _build_cluster(kind: str, selected_window: np.ndarray) -> tuple[np.ndarray, tuple[int, int], tuple[int, int]]:
+    layout = KIND_TO_LAYOUT[kind]
+    h, w = layout["shape"]
+    patch = np.full((h, w), GREY, dtype=int)
