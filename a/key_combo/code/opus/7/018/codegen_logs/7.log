+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+GEN_RETRIES = 600
+GRID_H_RANGE = (15, 23)
+GRID_W_RANGE = (18, 28)
+CLUSTER_COUNT_RANGE = (3, 5)
