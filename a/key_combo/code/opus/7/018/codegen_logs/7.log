+
+
+def _place_clusters(
+    h: int, w: int, clusters: list[dict]
+) -> list[dict] | None:
+    placed = []
+    used_rects = []
+    for cluster in clusters:
+        ph, pw = cluster["patch"].shape
+        positions = [
+            (r, c)
+            for r in range(1, h - ph - 1)
+            for c in range(1, w - pw - 1)
+        ]
