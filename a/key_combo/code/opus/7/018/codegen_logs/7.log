+    blue_r, blue_c = random.choice(blue_choices)
+    grid[blue_r, blue_c] = BLUE
+
+    if not _validate_grid(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
