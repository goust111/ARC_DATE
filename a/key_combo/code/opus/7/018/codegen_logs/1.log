+
+def _anchor_has_two_bg_steps(grid: np.ndarray, obj: dict) -> bool:
+    dr, dc = DIRS_BY_DEPTH[obj["depth"] % 4]
+    r, c = obj["anchor"]
+    for step in (1, 2):
