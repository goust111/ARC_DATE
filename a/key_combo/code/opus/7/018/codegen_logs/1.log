+
+def _has_cross_color_adjacency(grid: np.ndarray) -> bool:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == 0:
+                continue
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w:
+                    other = int(g[nr, nc])
