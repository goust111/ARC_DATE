+        depth1_obj = next(obj for obj in objects if obj["depth"] == 1)
+        prefix = _apply_rule(grid, max_depth=0)
+        dr, dc = DIRS_BY_DEPTH[1]
+        rr = depth1_obj["anchor"][0] + dr
+        cc = depth1_obj["anchor"][1] + dc
