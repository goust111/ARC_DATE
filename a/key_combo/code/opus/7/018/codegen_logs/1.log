+                    "color": color,
+                    "coords": arr,
+                    "bbox": _bbox_from_coords(arr),
+                    "anchor": anchor,
+                    "area": int(arr.shape[0]),
+                }
+            )
+    return objects
+
+
+def _annotate_depths(objects: list[dict]) -> list[dict]:
+    annotated: list[dict] = []
+    for obj in objects:
