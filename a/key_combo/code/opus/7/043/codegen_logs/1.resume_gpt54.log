+    seed_mask = np.zeros_like(g, dtype=bool)
+    seed_mask[2:] = (g[2:] == RED_SEED) | (g[2:] == GREEN_SEED)
+    out = _paint_rays(g, red_cols, green_rows, seed_mask)
