+    height, width = forbidden.shape
+    for r, c in cells:
+        r0 = max(0, r - SEPARATION_RADIUS)
+        r1 = min(height, r + SEPARATION_RADIUS + 1)
+        c0 = max(0, c - SEPARATION_RADIUS)
+        c1 = min(width, c + SEPARATION_RADIUS + 1)
+        forbidden[r0:r1, c0:c1] = True
