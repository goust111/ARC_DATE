    num_single, multi_sizes = structure

    if not _gen_place_multi_blobs(grid, multi_sizes):
        return None
    for _ in range(num_single):
        if not _gen_place_single(grid):
            return None
    return grid if _gen_valid_grid(grid) else None


def generate_input():
