GEN_NOTCH_COUNTS, GEN_NOTCH_WEIGHTS = [0, 1, 2, 3, 4], [1, 1, 2, 3, 4]
GEN_THREE_CYCLE_NOTCH_COUNTS, GEN_THREE_CYCLE_NOTCH_WEIGHTS = [0, 1, 2], [2, 3, 3]
