    expected = clean.copy()
    covered = np.zeros_like(clean, dtype=bool)
    for marker in markers:
        for r, c in marker["expansion"]:
            expected[r, c] = int(marker["color"])
            covered[r, c] = True

    hr0, hc0, hr1, hc1 = hole_box
    inp = clean.copy()
    inp[hr0 : hr1 + 1, hc0 : hc1 + 1] = ORANGE
    for marker in markers:
        _paint_marker(inp, marker)

    center = size // 2
    if cross_vertical:
        hidden_horiz = _horizontal_hidden_count(hole_box, covered, center * 2)
        if hidden_horiz == 0:
            return None
    else:
        hidden_horiz = _horizontal_hidden_count(hole_box, covered, center * 2)
        if hidden_horiz == covered.size:
            return None

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, expected):
        return None
    return inp


def generate_input() -> np.ndarray:
    for _ in range(MAX_GEN_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid input for puzzle 8")

