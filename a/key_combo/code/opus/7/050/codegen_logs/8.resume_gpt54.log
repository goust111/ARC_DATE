+def _expansion_cells(
+    hole_box: tuple[int, int, int, int],
+    marker_box: tuple[int, int, int, int],
+    corner: str,
+) -> set[tuple[int, int]]:
+    hr0, hc0, hr1, hc1 = hole_box
+    mr0, mc0, mr1, mc1 = marker_box
+    cells: set[tuple[int, int]] = set()
+
+    if corner == "top_left":
+        for c in range(hc0, mc1 + 1):
