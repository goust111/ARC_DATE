+        mismatch = False
+        for r in range(h):
+            for c in range(w):
+                if _inside_bbox(r, c, hole_box):
+                    continue
+                rr, cc = (axis2 - r, c) if rows else (r, axis2 - c)
+                if not (0 <= rr < h and 0 <= cc < w):
