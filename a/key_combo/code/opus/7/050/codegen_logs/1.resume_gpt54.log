+        left = int(rng.integers(MARGIN_RANGE[0], MARGIN_RANGE[1] + 1))
+        right = int(rng.integers(MARGIN_RANGE[0], MARGIN_RANGE[1] + 1))
+
+        panel_height = top + base_height + bottom
+        panel_width = left + base_width + right
