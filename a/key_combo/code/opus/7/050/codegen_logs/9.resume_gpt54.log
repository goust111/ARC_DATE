+    grid[:, side] = SEPARATOR
+    grid[:side, :side] = panels[0]
+    grid[:side, side + 1 :] = panels[1]
+    grid[side + 1 :, :side] = panels[2]
+    grid[side + 1 :, side + 1 :] = panels[3]
+    return grid
+
+
+def _gen_attempt() -> np.ndarray | None:
