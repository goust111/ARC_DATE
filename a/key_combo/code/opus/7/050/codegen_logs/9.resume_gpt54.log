+        "marker": marker_pos,
+        "obstacle": int(obstacle),
+        "endpoint": endpoint,
+        "score": int(gap + walk_len),
+    }
+
+
+def _apply_quadrant_result(panel: np.ndarray, info: dict) -> np.ndarray:
+    out = panel.copy()
+    out[info["marker"]] = info["bg"]
+    out[info["endpoint"]] = info["obstacle"]
+    return out
