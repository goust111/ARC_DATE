+def _enclosed_black_regions(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    regions: list[list[tuple[int, int]]] = []
+    for comp in _components_of_value(grid, BLACK):
+        if any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in comp):
+            continue
+        regions.append(comp)
+    return regions
