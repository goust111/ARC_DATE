+                    ring_mask = _ring_coverage_mask(tiling.shape, top, left, region_h, region_w)
+                    ring_covered = int(np.count_nonzero(tiling[ring_mask]))
+                    if ring_covered < 1:
+                        continue
+                    candidates.append(
