+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+GRID_MIN = 18
+GRID_MAX = 24
+REGION_COUNT_CHOICES = (2, 3)
+REGION_SIZE_RANGE = (6, 8)
+BAR_SHORT_SIDES = (1, 2)
