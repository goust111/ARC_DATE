+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    seed_top, seed_left, bar_h, bar_w = _extract_seed_bar(g)
+
+    out = g.copy()
+    _apply_zigzag_tiling(out, seed_top, seed_left, bar_h, bar_w, BLUE)
+
+    for region in _enclosed_black_regions(g):
+        for r, c in region:
+            if int(out[r, c]) == BLACK:
+                out[r, c] = YELLOW
+
