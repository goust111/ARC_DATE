+    options: list[tuple[int, int]] = []
+    for short in BAR_SHORT_SIDES:
+        for long_side in range(BAR_LONG_RANGE[0], BAR_LONG_RANGE[1] + 1):
+            if short == long_side:
+                continue
+            options.append((short, long_side))
+            options.append((long_side, short))
