+def _oracle_accepts(inp: np.ndarray) -> bool:
+    try:
+        out = main(inp)
+    except Exception:
+        return False
+
+    if out.shape != inp.shape:
+        return False
+    if not np.any(out == GREEN) or not np.any(out == YELLOW):
+        return False
+    if not np.array_equal(out[inp == BLUE], inp[inp == BLUE]):
