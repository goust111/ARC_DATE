+                    box = (top, left, top + region_h - 1, left + region_w - 1)
+                    if not _bbox_far_enough(seed_box, box, gap=1):
+                        continue
+                    interior = tiling[top + 1 : top + region_h - 1, left + 1 : left + region_w - 1]
