+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+GRID_MIN = 18
+GRID_MAX = 24
+REGION_COUNT_CHOICES = (2, 3)
+REGION_SIZE_RANGE = (6, 8)
+BAR_SHORT_SIDES = (1, 2)
+BAR_LONG_RANGE = (3, 5)
+GEN_RETRIES = 400
