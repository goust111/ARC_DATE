+
+    max_k = min(6, len(columns) - 1)
+    k = random.randint(3, max_k)
+    start = random.randint(0, len(columns) - k)
+    chosen = columns[start : start + k]
+    assert len(chosen) >= 3
+    assert len(chosen) < len(columns)
+    return period, chosen
