+)
+PAIR_HORIZONTAL_DIMS = [(3, 2), (4, 2), (5, 2), (4, 3), (5, 3)]
+PAIR_VERTICAL_DIMS = [(4, 2), (5, 2), (4, 3), (5, 3)]
+GRID_RANGE = (18, 26)
