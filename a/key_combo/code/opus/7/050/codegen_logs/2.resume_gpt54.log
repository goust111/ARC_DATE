+        obj_b = EncodedRect(
+            color=colors[1],
+            body_r0=b_body_r0,
+            body_c0=coll_c,
+            h=b_h,
+            w=b_w,
+            direction="up",
+            gap=b_gap,
+            attach=b_attach,
