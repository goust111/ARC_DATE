+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+ALL_DIMS = sorted(
+    {
+        (a, b)
+        for a in (2, 3, 4, 5)
