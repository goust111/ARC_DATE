+    rotations = [0, 2] if displacement_major == "horizontal" else [1, 3]
+
+    for _ in range(120):
+        base = _base_scene()
+        if base is None:
+            continue
+        scene = np.rot90(base, random.choice(rotations)).copy()
+        if _scene_signal_axis(scene) == target_axis:
+            return scene
+    raise RuntimeError("failed to generate contour scene")
