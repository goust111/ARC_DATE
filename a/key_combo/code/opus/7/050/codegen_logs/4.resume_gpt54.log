+    end = _walk_contour(scene, contour_start, direction)
+    dr = int(end[0] - start[0])
+    dc = int(end[1] - start[1])
+    assert abs(dr) != abs(dc)
+    return "vertical" if abs(dc) > abs(dr) else "horizontal"
+
+
