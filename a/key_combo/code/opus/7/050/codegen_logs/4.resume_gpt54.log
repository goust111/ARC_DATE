+        cc = int(c)
+        if axis == "vertical":
+            src = (rr, pc0 + pc1 - cc)
+        else:
+            src = (pr0 + pr1 - rr, cc)
+        sr, sc = src
+        assert pr0 <= sr <= pr1 and pc0 <= sc <= pc1, "reflection source must stay inside pattern bbox"
+        assert int(out[sr, sc]) != OCCLUDER, "chosen axis must reflect from visible pattern cells"
+        out[rr, cc] = int(out[sr, sc])
+    return out
