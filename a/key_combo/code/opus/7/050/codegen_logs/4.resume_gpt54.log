+def _sightline_to_obstacle(grid: np.ndarray, start: Coord) -> tuple[Coord, Coord]:
+    hits: list[tuple[Coord, Coord]] = []
+    sr, sc = start
+    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+        r, c = sr + dr, sc + dc
+        previous_bg: Coord | None = None
+        while _in_bounds(grid.shape, r, c):
+            value = int(grid[r, c])
+            if value == OBSTACLE:
