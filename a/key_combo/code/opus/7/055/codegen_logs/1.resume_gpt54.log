+def _trace_cycle(coords: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    pts = set(coords)
+    for r, c in pts:
+        degree = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        assert degree == 2, (r, c, degree)
