+        assert len(next_cells) == 1, (cur, next_cells)
+        prev, cur = cur, next_cells[0]
+        assert len(path) <= len(pts)
+
+    assert len(path) == len(pts)
+    return path
+
+
+def _classify_cycle(path: list[tuple[int, int]]) -> tuple[set[tuple[int, int]], set[tuple[int, int]], set[tuple[int, int]]]:
