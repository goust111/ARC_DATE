+        bottom_depth_max = min(max(1, (height - 4) // 2), height - 3 - top_depth)
+        if bottom_depth_max < 1:
+            return None
+        bottom_depth = random.randint(1, bottom_depth_max)
+        for c in range(t0, t1 + 1):
+            top[c] = top_depth
+        for c in range(b0, b1 + 1):
+            bottom[c] = height - 1 - bottom_depth
+
