+        max_top = row_bounds[1] - mask_h + 1
+        max_left = col_bounds[1] - mask_w + 1
+        if max_top < row_bounds[0] or max_left < col_bounds[0]:
+            continue
+        top = random.randint(row_bounds[0], max_top)
+        left = random.randint(col_bounds[0], max_left)
