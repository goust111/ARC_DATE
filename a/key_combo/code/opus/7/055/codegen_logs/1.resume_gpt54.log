+    bottom = [height - 1] * width
+
+    if mode == "top":
+        interval = _choose_interval(width)
+        if interval is None:
+            return None
+        start, end = interval
+        depth = random.randint(1, max(1, (height - 3) // 2))
+        for c in range(start, end + 1):
