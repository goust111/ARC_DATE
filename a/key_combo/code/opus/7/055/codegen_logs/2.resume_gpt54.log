+
+def _sample_pair_rows(H: int, h_a: int, h_b: int, blocking: bool) -> tuple[int, int] | None:
+    max_a = H - h_a - 1
+    max_b = H - h_b - 1
+    if max_a < 1 or max_b < 1:
+        return None
+
+    for _ in range(40):
+        r_a = random.randint(1, max_a)
+        if blocking:
+            lo = max(1, r_a - h_b + 1)
+            hi = min(max_b, r_a + h_a - 1)
+            if lo > hi:
+                continue
+            r_b = random.randint(lo, hi)
