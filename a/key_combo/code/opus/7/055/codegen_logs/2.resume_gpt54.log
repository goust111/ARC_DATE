+    if coords[:, 1].min() < 0 or coords[:, 1].max() >= W:
+        return False
+    return not bool(np.any(occupied[coords[:, 0], coords[:, 1]]))
+
+
+def _shape_signature(mask: np.ndarray) -> tuple[str, ...]:
