+    subset_masks = []
+    for bits in range(1, 1 << len(coords)):
+        area = bits.bit_count()
+        if area < 2 or area > 4:
+            continue
+        canvas = np.zeros_like(ref_mask, dtype=bool)
+        for idx, (r, c) in enumerate(coords):
