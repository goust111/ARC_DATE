+    rel = np.argwhere(mask).astype(int)
+    coords = rel + np.array([r0, c0], dtype=int)
+    return {
+        "color": int(color),
+        "coords": coords,
+        "bbox": (int(r0), int(c0), int(r0 + mask.shape[0] - 1), int(c0 + mask.shape[1] - 1)),
+        "rel_coords": rel,
+        "mask": mask.copy(),
