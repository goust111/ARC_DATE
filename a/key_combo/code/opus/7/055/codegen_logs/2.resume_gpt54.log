+def _bbox_gap(b1: tuple[int, int, int, int], b2: tuple[int, int, int, int]) -> int:
+    row_gap = max(b2[0] - b1[2] - 1, b1[0] - b2[2] - 1, 0)
+    col_gap = max(b2[1] - b1[3] - 1, b1[1] - b2[3] - 1, 0)
+    if row_gap == 0:
+        return int(col_gap)
+    if col_gap == 0:
+        return int(row_gap)
+    return int(min(row_gap, col_gap))
+
