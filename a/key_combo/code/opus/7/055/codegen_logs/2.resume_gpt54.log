+            r0 = int(coords_arr[:, 0].min())
+            c0 = int(coords_arr[:, 1].min())
+            r1 = int(coords_arr[:, 0].max())
+            c1 = int(coords_arr[:, 1].max())
+            rel = coords_arr - np.array([r0, c0], dtype=int)
+            mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            mask[rel[:, 0], rel[:, 1]] = True
+            components.append(
+                {
