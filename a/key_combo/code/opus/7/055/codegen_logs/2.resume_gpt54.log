+    out = np.full_like(g, BACKGROUND)
+    out[:, 0] = LEFT_WALL
+    out[:, -1] = RIGHT_WALL
+    for side in ("left", "right"):
+        ref = ref_info[side]
+        out[ref["coords"][:, 0], ref["coords"][:, 1]] = GREY
