+PLACEMENT_TRIES = 80
+MAX_OUTPUT_OVERLAP = 2
+
+BASE_REFERENCE_SHAPES = {
+    "square": np.array([[1, 1], [1, 1]], dtype=bool),
+    "ell": np.array([[1, 0, 0], [1, 0, 0], [1, 1, 1]], dtype=bool),
