+
+    erased = _erased_block_columns(n, list(marker_cols), marker_count)
+    if len(erased) > n - 2:
+        return None
+
+    return tile
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        rng = random.Random()
+        grid = _gen_attempt(rng)
