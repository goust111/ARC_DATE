+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+ARC_COLORS = tuple(range(10))
+NON_SPECIAL_COLORS = tuple(c for c in ARC_COLORS if c not in (BLACK, BLUE))
+MAX_GEN_ATTEMPTS = 500
