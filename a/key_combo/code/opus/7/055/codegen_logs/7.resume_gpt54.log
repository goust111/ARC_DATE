+        out[row_slice, col_slice] = clean
+
+    for block_col in _erased_block_columns(n, blue_cols, marker_width):
+        col_slice = slice(block_col * n, (block_col + 1) * n)
+        out[row_slice, col_slice] = BLACK
+
+    return out
