+from collections import deque
+import random
+
+import numpy as np
+
+
+SEP = 7
+BACKGROUND = 0
+ACTIVE_COLORS = (1, 2, 3, 4)
+DUMMY_COLORS = (5, 6, 8, 9)
+OUTER_MARGIN = 2
+MAX_GEN_ATTEMPTS = 400
