+def _noise_cell(h: int, w: int, palette: tuple[int, ...], seed: int) -> np.ndarray:
+    cell = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            idx = (2 * r + 3 * c + seed + (r ^ c)) % len(palette)
+            cell[r, c] = palette[idx]
