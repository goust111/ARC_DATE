+        np.array([(0, 0), (0, 1), (1, 0)], dtype=int),
+        np.array([(0, 0), (0, 1), (1, 1)], dtype=int),
+        np.array([(0, 0), (1, 0), (1, 1)], dtype=int),
+        np.array([(0, 1), (1, 0), (1, 1)], dtype=int),
+    ],
+    4: [
+        np.array([(0, 0), (0, 1), (1, 0), (1, 1)], dtype=int),
+    ],
+}
