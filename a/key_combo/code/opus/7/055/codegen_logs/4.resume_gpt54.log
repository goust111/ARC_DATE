    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False)
    assert len(comps) >= 2, "expected a reference motif and at least one target motif"

    skeleton, anchor, extra_colors = _infer_role_colors(g, comps, bg)
    ref_indices = [
