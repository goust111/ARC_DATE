+        col_band = col_bands[global_rc[1]]
+        side = side_by_local[local]
+
+        if local == local_collision_high:
+            area = 4
+        elif local == local_collision_low:
+            area = 2
+        elif collision_pair is not None and mode.endswith("tie") and local in collision_pair:
+            area = 3
+        else:
