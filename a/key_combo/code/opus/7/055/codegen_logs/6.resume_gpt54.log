+    out = np.full_like(g, BLACK)
+    selected_mask = np.zeros_like(g, dtype=bool)
+    out[top : bottom + 1, tall_c] = BLUE
+    selected_mask[top : bottom + 1, tall_c] = True
+    out[short_r0 : bottom + 1, short_c] = RED
