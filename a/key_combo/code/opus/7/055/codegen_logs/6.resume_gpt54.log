+        if len(cols) >= count:
+            starts.append(cols)
+    if not starts:
+        return None
+    base = random.choice(starts)
+    return sorted(random.sample(base, count))
+
+
+def _build_input() -> np.ndarray | None:
+    h = random.randint(18, 24)
+    w = random.randint(18, 24)
+
+    feasible_counts = [count for count in range(5, 8) if 3 * (count - 1) + 2 <= w]
+    if not feasible_counts:
+        return None
+    bar_count = random.choice(feasible_counts)
+    cols = _sample_bar_columns(w, bar_count)
+    if cols is None:
+        return None
+
+    frame_pairs = [(i, j) for i in range(bar_count) for j in range(i + 1, bar_count) if cols[j] - cols[i] >= 8]
+    if not frame_pairs:
+        return None
+    widest = max(cols[j] - cols[i] for i, j in frame_pairs)
+    wide_pairs = [(i, j) for i, j in frame_pairs if cols[j] - cols[i] >= widest - 2]
+    tall_i, short_i = random.choice(wide_pairs)
+    if random.random() < 0.5:
+        tall_i, short_i = short_i, tall_i
+
+    max_tall = min(15, h - 4)
+    if max_tall < 8:
+        return None
+    tall_height = random.randint(8, max_tall)
+    short_height = random.randint(3, min(6, tall_height - 2))
+    remaining_pool = [x for x in range(3, max_tall + 1) if x not in {tall_height, short_height}]
+    if len(remaining_pool) < bar_count - 2:
+        return None
+    other_heights = random.sample(remaining_pool, bar_count - 2)
+
+    heights = [None] * bar_count
+    heights[tall_i] = tall_height
+    heights[short_i] = short_height
+    for idx, height in zip([i for i in range(bar_count) if i not in {tall_i, short_i}], other_heights):
