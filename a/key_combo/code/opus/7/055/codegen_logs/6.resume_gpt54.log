+    short_height = random.randint(3, min(6, tall_height - 2))
+    remaining_pool = [x for x in range(3, max_tall + 1) if x not in {tall_height, short_height}]
+    if len(remaining_pool) < bar_count - 2:
+        return None
+    other_heights = random.sample(remaining_pool, bar_count - 2)
+
+    heights = [None] * bar_count
+    heights[tall_i] = tall_height
+    heights[short_i] = short_height
+    for idx, height in zip([i for i in range(bar_count) if i not in {tall_i, short_i}], other_heights):
