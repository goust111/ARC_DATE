+            continue
+        r0 = int(rows[0])
+        r1 = int(rows[-1])
+        height = int(rows.size)
+        assert height == r1 - r0 + 1
+        assert np.all(grid[r0 : r1 + 1, c] == GREY)
+        bars.append((height, r0, int(c)))
+    return bars
