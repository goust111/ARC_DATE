+        for c0 in range(0, w - pw + 1):
+            box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            inside = _strictly_inside(box, frame)
+            if status == "inside" and inside:
+                positions.append((r0, c0))
+            elif status == "outside_any" and not inside:
