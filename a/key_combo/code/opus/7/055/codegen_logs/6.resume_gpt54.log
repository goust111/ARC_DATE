+    loop_count = random.randint(2, 4)
+    statuses = ["inside", random.choice(["outside_any", "outside_crossing"])]
+    while len(statuses) < loop_count:
+        statuses.append(random.choices(["inside", "outside_any", "outside_crossing"], weights=[1, 2, 2])[0])
+    random.shuffle(statuses)
+
+    for status in statuses:
+        if status == "inside":
+            max_ph = min(7, interior_h)
+            max_pw = min(8, interior_w)
+        else:
+            max_ph = min(8, h - 2)
+            max_pw = min(9, w - 2)
+        patch = _make_cycle_patch(max_ph, max_pw)
+        if patch is None:
