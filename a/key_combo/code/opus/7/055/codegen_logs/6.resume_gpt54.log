+) -> list[tuple[int, int]]:
+    h, w = shape
+    ph, pw = patch_shape
+    top, left, bottom, right = frame
+    positions = []
+    for r0 in range(0, h - ph + 1):
+        for c0 in range(0, w - pw + 1):
