+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _trace_cycle(coords: np.ndarray) -> list[tuple[int, int]]:
+    pts = {tuple(map(int, p)) for p in coords}
+    for r, c in pts:
+        degree = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        assert degree == 2, (r, c, degree)
+
+    start = min(pts)
+    neighbors = sorted((nr, nc) for nr, nc in _neighbors4(*start) if (nr, nc) in pts)
+    assert len(neighbors) == 2
+
+    path = [start]
+    prev = start
+    cur = neighbors[0]
+    while cur != start:
+        path.append(cur)
+        next_cells = [
