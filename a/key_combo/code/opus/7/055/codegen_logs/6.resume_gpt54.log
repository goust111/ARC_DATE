+
+    frame_pairs = [(i, j) for i in range(bar_count) for j in range(i + 1, bar_count) if cols[j] - cols[i] >= 8]
+    if not frame_pairs:
+        return None
+    widest = max(cols[j] - cols[i] for i, j in frame_pairs)
+    wide_pairs = [(i, j) for i, j in frame_pairs if cols[j] - cols[i] >= widest - 2]
+    tall_i, short_i = random.choice(wide_pairs)
+    if random.random() < 0.5:
