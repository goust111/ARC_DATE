+    for coords in _components(g == GREEN):
+        r0, c0, r1, c1 = _bbox(coords)
+        if r0 > top and r1 < bottom and c0 > left and c1 < right:
+            convex, concave = _cycle_turns(coords)
+            for r, c in map(tuple, coords):
+                out[r, c] = GREEN
+            for r, c in convex:
+                out[r, c] = YELLOW
+            for r, c in concave:
+                out[r, c] = RED
