+
+def _can_place(coords: np.ndarray, r0: int, c0: int, occupied: np.ndarray) -> bool:
+    h, w = occupied.shape
+    for r, c in map(tuple, coords):
+        rr = r0 + r
+        cc = c0 + c
+        if not (0 <= rr < h and 0 <= cc < w):
+            return False
+        for dr, dc in DIRS4 + [(0, 0)]:
