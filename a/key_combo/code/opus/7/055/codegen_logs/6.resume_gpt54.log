+def _sample_bar_columns(width: int, count: int) -> list[int] | None:
+    starts = []
+    for offset in (1, 2, 3):
+        cols = list(range(offset, width - 1, 3))
+        if len(cols) >= count:
+            starts.append(cols)
+    if not starts:
+        return None
+    base = random.choice(starts)
+    return sorted(random.sample(base, count))
+
+
+def _build_input() -> np.ndarray | None:
+    h = random.randint(18, 24)
+    w = random.randint(18, 24)
