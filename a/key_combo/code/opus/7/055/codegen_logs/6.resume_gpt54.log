+            out[top, c] = RED
+        if not selected_mask[bottom, c]:
+            out[bottom, c] = RED
+
+    out[top, left] = BLUE
+    out[top, right] = BLUE
+    out[bottom, left] = BLUE
+    out[bottom, right] = BLUE
+    return out
+
+
+def _draw_segment(path: list[tuple[int, int]], a: tuple[int, int], b: tuple[int, int]) -> None:
+    r0, c0 = a
+    r1, c1 = b
+    if r0 == r1:
