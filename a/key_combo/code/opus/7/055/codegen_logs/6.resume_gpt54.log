+    start = min(pts)
+    neighbors = sorted((nr, nc) for nr, nc in _neighbors4(*start) if (nr, nc) in pts)
+    assert len(neighbors) == 2
+
+    path = [start]
+    prev = start
+    cur = neighbors[0]
+    while cur != start:
+        path.append(cur)
+        next_cells = [
+            (nr, nc)
+            for nr, nc in _neighbors4(*cur)
+            if (nr, nc) in pts and (nr, nc) != prev
