+            convex, concave = _cycle_turns(coords)
+        except AssertionError:
+            return False
+        if len(convex) == 0 or len(concave) == 0:
+            return False
+        box = _bbox(coords)
+        if _strictly_inside(box, frame):
+            inside += 1
+        else:
+            outside += 1
+    if inside == 0 or outside == 0:
+        return False
+
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+    return out.shape == grid.shape
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _build_input()
+        if grid is not None:
+            return grid
