+
+
+def _place_loop(grid: np.ndarray, occupied: np.ndarray, coords: np.ndarray, positions: list[tuple[int, int]]) -> bool:
+    if not positions:
+        return False
+    random.shuffle(positions)
+    for r0, c0 in positions:
