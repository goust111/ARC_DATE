+
+
+def _rotate_coords(coords: set[tuple[int, int]], turns: int) -> set[tuple[int, int]]:
+    pts = set(coords)
+    turns %= 4
+    for _ in range(turns):
+        height = max(r for r, _ in pts) + 1
+        pts = {(c, height - 1 - r) for r, c in pts}
