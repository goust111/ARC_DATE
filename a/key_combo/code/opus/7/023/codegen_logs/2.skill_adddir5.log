+    g = np.asarray(grid, dtype=int)
+    height, width = g.shape
+    out = g.copy()
+    gray = np.zeros((height, width), dtype=bool)
+    anchors = _extract_anchors(g)
+    anchor_cells = {(a["r"], a["c"]) for a in anchors}
