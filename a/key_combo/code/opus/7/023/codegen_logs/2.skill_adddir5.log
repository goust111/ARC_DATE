+            c = c0
+            axis = 0
+            segments = 0
+            pixels = 0
+            stop_reason = "cycle"
+            limit = None if repeat else 2
+            while True:
+                if limit is not None and segments >= limit:
+                    break
+                cells = _segment_cells(r, c, axis, step, hc, vr)
+                blocked = None
