+            ("away", -int(anchor["hc"]), -int(anchor["vr"])),
+        ):
+            r = r0
+            c = c0
+            axis = 0
+            segments = 0
+            pixels = 0
+            stop_reason = "cycle"
+            limit = None if repeat else 2
