+def _choose_corners(mode: str) -> list[str]:
+    if mode == "collision":
+        pair = random.choice([("TL", "BR"), ("TR", "BL")])
+        count = random.choice([3, 4])
+        others = [corner for corner in ALL_CORNERS if corner not in pair]
+        return list(pair) + random.sample(others, count - 2)
+    if mode == "open":
