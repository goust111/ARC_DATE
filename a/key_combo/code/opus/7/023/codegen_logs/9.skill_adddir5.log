+            {
+                "coords": coords,
+                "bbox": _bbox(coords),
+                "surfaces": surfaces,
+            }
+        )
+
+    if side == "N":
+        for r in range(1, h):
+            exposed = [c for c in range(w) if occupied[r, c] and not occupied[r - 1, c]]
+            if not exposed or r - height < 0:
+                continue
+            runs: list[tuple[int, int]] = []
+            start = prev = exposed[0]
+            for c in exposed[1:]:
