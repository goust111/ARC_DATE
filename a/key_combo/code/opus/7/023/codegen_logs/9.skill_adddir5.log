+def _overhang_axis(side: str, next_side: str) -> tuple[str, int] | None:
+    if side == "N" and next_side == "E":
+        return ("c1", 1)
+    if side == "N" and next_side == "W":
+        return ("c0", -1)
+    if side == "S" and next_side == "E":
+        return ("c1", 1)
+    if side == "S" and next_side == "W":
+        return ("c0", -1)
+    if side == "W" and next_side == "N":
