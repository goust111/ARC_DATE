+    if not _pick_gap_assignment(base_mask, placements, grid.shape, list(range(num_objects))):
+        return None
+
+    grid[base_mask] = GREY
+    for place in placements:
+        grid[place["input_coords"][:, 0], place["input_coords"][:, 1]] = place["color"]
+
+    if not _semantic_ok(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is not None:
