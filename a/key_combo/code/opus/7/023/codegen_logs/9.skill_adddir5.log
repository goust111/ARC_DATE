+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "N": (1, 0),
+    "S": (-1, 0),
+    "W": (0, 1),
+    "E": (0, -1),
+}
+SIDE_CYCLE = ("N", "E", "S", "W")
+COLOR_POOL = (1, 2, 3, 4)
+MAX_GEN_ATTEMPTS = 500
