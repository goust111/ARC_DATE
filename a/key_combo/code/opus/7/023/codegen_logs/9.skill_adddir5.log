+    idxs = []
+    for idx, obj in enumerate(objects):
+        _, dist = _shortest_direction_and_distance(obj["coords"], base_mask)
+        dists.append(dist)
+        idxs.append(idx)
+    return dists, idxs
+
+
+def _pick_gap_assignment(
+    base_mask: np.ndarray,
+    placements: list[dict],
