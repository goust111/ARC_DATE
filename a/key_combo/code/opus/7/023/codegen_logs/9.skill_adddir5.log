+        return coords[coords[:, 0] == bound]
+    if dc == 1:
+        bound = int(coords[:, 1].max())
+        return coords[coords[:, 1] == bound]
+    bound = int(coords[:, 1].min())
+    return coords[coords[:, 1] == bound]
