+
+def _pick_gap_assignment(base_mask: np.ndarray, placements: list[dict], shape: tuple[int, int], order: list[int]) -> bool:
+    usable = [list(range(1, min(7, place["max_gap"] + 1))) for place in placements]
+    if any(not choices for choices in usable):
