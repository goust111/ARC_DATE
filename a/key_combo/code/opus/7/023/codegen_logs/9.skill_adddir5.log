+
+def _prefer_candidates(
+    candidates: list[dict],
+    current_bbox: tuple[int, int, int, int],
+    current_base_mask: np.ndarray,
+    next_side: str | None,
+) -> list[dict]:
+    random.shuffle(candidates)
+    if next_side is None:
+        return candidates
+
+    axis = _overhang_axis(
+        "N" if candidates and candidates[0]["surfaces"][0][0] > candidates[0]["bbox"][0] else "",
+        next_side,
+    )
+    if axis is None:
