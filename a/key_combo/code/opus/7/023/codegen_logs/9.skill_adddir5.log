+    elif side == "W":
+        for c in range(1, w):
+            exposed = [r for r in range(h) if occupied[r, c] and not occupied[r, c - 1]]
+            if not exposed or c - width < 0:
+                continue
+            runs = []
+            start = prev = exposed[0]
+            for r in exposed[1:]:
+                if r == prev + 1:
+                    prev = r
+                else:
+                    runs.append((start, prev))
+                    start = prev = r
+            runs.append((start, prev))
+            for r0, r1 in runs:
