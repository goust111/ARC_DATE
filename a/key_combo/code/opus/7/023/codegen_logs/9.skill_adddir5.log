+    for alt in _alternative_outputs(grid):
+        if np.array_equal(out, alt):
+            return False
+    return True
+
+
+def _build_attempt() -> np.ndarray | None:
+    h = random.randint(15, 18)
+    w = random.randint(15, 18)
