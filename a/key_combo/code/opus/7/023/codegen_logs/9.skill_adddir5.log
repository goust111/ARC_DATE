+                for top in range(r0, r1 - height + 2):
+                    rows = np.arange(top, top + height)[:, None]
+                    cols = np.arange(c - width, c)[None, :]
+                    coords = np.stack(np.broadcast_arrays(rows, cols), axis=-1).reshape(-1, 2)
+                    add_candidate(coords, SIDE_TO_DIR[side])
+    else:
+        for c in range(w - 1):
