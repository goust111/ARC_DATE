+    start_idx = random.randrange(4)
+    step = random.choice((1, -1))
+    side_order = [SIDE_CYCLE[(start_idx + step * i) % 4] for i in range(num_objects)]
+    colors = list(random.sample(COLOR_POOL, num_objects))
+
