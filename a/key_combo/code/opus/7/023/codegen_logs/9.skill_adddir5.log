+                "distance": obj["distance"],
+                "direction": obj["direction"],
+                "surface_before": tuple(surface_before),
+                "final_bbox": _bbox(final_coords),
+                "surface_nonbase": any(not base_mask[r, c] for r, c in surfaces),
