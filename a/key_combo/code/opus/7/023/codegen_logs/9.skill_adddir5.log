+                    prev = c
+                else:
+                    runs.append((start, prev))
+                    start = prev = c
+            runs.append((start, prev))
+            for c0, c1 in runs:
+                if c1 - c0 + 1 < width:
+                    continue
+                for left in range(c0, c1 - width + 2):
+                    rows = np.arange(r + 1, r + 1 + height)[:, None]
+                    cols = np.arange(left, left + width)[None, :]
