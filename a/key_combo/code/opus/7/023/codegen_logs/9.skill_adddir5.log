+def _semantic_ok(grid: np.ndarray) -> bool:
+    try:
+        out, trace = _simulate(grid, return_trace=True)
+    except Exception:
+        return False
+    if len(trace) < 3:
+        return False
+    if not any(step["surface_nonbase"] for step in trace[1:]):
+        return False
+    for alt in _alternative_outputs(grid):
+        if np.array_equal(out, alt):
+            return False
+    return True
