+                    overhang_pref = [cand for cand in candidates if cand["bbox"][1] < target]
+                elif key == "r1":
+                    target = current_bbox[2]
+                    overhang_pref = [cand for cand in candidates if cand["bbox"][2] > target]
+                else:
