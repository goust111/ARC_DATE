+                grid[place["input_coords"][:, 0], place["input_coords"][:, 1]] = place["color"]
+            objs = _extract_objects(grid)
+            base_direction = max(_components(grid == GREY), key=lambda pts: int(pts.shape[0]))
+            base_dir_mask = _mask_from_coords(shape, base_direction)
+            enriched = []
