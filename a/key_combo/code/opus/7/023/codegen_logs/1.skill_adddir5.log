+    if traced != path:
+        return False
+
+    detected = _find_frames(grid)
+    detected_key = sorted((item["bbox"], item["color"]) for item in detected)
+    meta_key = sorted((item["bbox"], item["color"]) for item in frames)
+    if detected_key != meta_key:
+        return False
