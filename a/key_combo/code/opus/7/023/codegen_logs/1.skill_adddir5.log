+        r0, c0, r1, c1 = frame["bbox"]
+        out[r0, c0 : c1 + 1] = frame["color"]
+        out[r1, c0 : c1 + 1] = frame["color"]
+        out[r0 : r1 + 1, c0] = frame["color"]
+        out[r0 : r1 + 1, c1] = frame["color"]
+        out[r0 + 1 : r1, c0 + 1 : c1] = frame["arrival_color"]
+    return out
+
+
+def _validate_semantics(
