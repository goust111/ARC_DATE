+                "bbox": bbox,
+                "color": border_colors[index],
+                "markers": markers,
+                "grey_count": grey_count,
+                "traversed": True,
+                "keep": grey_count > 1,
+                "segment": segment,
+                "orientation": cand["orientation"],
+                "dir": cand["dir"],
+                "arrival_color": path_colors[arrival_idx],
+                "entry_color": path_colors[arrival_idx],
+                "exit_color": path_colors[exit_idx],
+            }
+        )
