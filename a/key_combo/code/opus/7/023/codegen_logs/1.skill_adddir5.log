+        grid[r0, c0 : c1 + 1] = frame["color"]
+        grid[r1, c0 : c1 + 1] = frame["color"]
+        grid[r0 : r1 + 1, c0] = frame["color"]
+        grid[r0 : r1 + 1, c1] = frame["color"]
+        for r, c in frame["markers"]:
