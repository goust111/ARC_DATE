+def _build_staircase_path(h: int, w: int) -> list[tuple[int, int]] | None:
+    horizontal_runs = random.choice([4, 5])
+    h_steps = [random.randint(4, 6) for _ in range(horizontal_runs)]
+    if 2 + sum(h_steps) > w - 3:
+        return None
+
+    v_steps = [random.randint(4, 6) for _ in range(horizontal_runs - 1)]
+    start_row = random.randint(4, h - 5)
+    current_row = start_row
+    used_up = False
+    used_down = False
+    vertical_dirs: list[int] = []
+
+    for i, steps in enumerate(v_steps):
+        feasible: list[int] = []
+        if current_row + steps <= h - 3:
+            feasible.append(1)
+        if current_row - steps >= 2:
+            feasible.append(-1)
+        if not feasible:
+            return None
+
+        if i == len(v_steps) - 1:
+            feasible = [sign for sign in feasible if current_row + sign * steps >= start_row]
+            if not feasible:
+                return None
+
+        random.shuffle(feasible)
+        chosen = feasible[0]
+        if not used_up and -1 in feasible and random.random() < 0.7:
+            chosen = -1
+        elif not used_down and 1 in feasible and random.random() < 0.7:
+            chosen = 1
