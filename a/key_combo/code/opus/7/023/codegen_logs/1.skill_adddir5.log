+
+    for (r, c), color in zip(path, path_colors):
+        grid[r, c] = color
+    return grid
+
+
+def _expected_output_from_meta(shape: tuple[int, int], frames: list[dict]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for frame in frames:
+        if not frame["keep"]:
