+    assert len(order) == len(pts), "snake traversal must visit every pixel"
+    return order
+
+
+def _segment_inside_rect(
+    order: list[tuple[int, int]],
+    rect: tuple[int, int, int, int],
+) -> tuple[int, int] | None:
