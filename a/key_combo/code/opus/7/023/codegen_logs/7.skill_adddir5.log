+    r0, c0, r1, c1 = rect
+    inside = [r0 <= r <= r1 and c0 <= c <= c1 for r, c in order]
+    if not any(inside):
+        return None
+
+    first = inside.index(True)
+    last = len(inside) - 1 - inside[::-1].index(True)
+    if not all(inside[first:last + 1]):
+        return None
+    return first, last
