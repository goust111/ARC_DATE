+    values = [int(grid[r, c]) for r, c in cells]
+    if len(set(values)) == 1:
+        r, c = random.choice(cells)
+        grid[r, c] = LOCATOR_COLORS[0] if values[0] == LOCATOR_COLORS[1] else LOCATOR_COLORS[1]
