+            random.shuffle(candidates)
+            candidates.sort(
+                key=lambda pt: (
+                    abs(pt[0] - height // 2) + abs(pt[1] - width // 2),
+                    random.random(),
+                )
+            )
+
+            for nxt in candidates:
+                path.append(nxt)
+                used.add(nxt)
+                if len(path) < target_len:
+                    future = [nb for nb in _neighbors4(*nxt) if _can_step(nb, nxt, used, (height, width))]
