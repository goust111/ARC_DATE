+    nxt: tuple[int, int],
+    cur: tuple[int, int],
+    used: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> bool:
+    r, c = nxt
+    h, w = shape
+    if not (1 <= r < h - 1 and 1 <= c < w - 1):
+        return False
+    if nxt in used:
+        return False
+    for nb in _neighbors4(r, c):
+        if nb in used and nb != cur:
+            return False
+    return True
