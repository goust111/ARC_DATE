+def _random_partition(total: int, parts: int, min_len: int, max_len: int) -> list[int] | None:
+    if parts * min_len > total or parts * max_len < total:
+        return None
+    out = [min_len] * parts
+    remaining = total - parts * min_len
+    while remaining > 0:
