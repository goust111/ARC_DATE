+    for r, c in pts:
+        deg[(r, c)] = sum((nr, nc) in pset for nr, nc in _neighbors4(r, c))
+
+    ends = [pt for pt in pts if deg[pt] == 1]
+    assert len(ends) == 2, "snake must have exactly two endpoints"
+    start = min(ends)
+
