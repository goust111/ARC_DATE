+def _turn_count(coords: list[tuple[int, int]]) -> int:
+    turns = 0
+    for i in range(1, len(coords) - 1):
+        dr1 = coords[i][0] - coords[i - 1][0]
+        dc1 = coords[i][1] - coords[i - 1][1]
+        dr2 = coords[i + 1][0] - coords[i][0]
+        dc2 = coords[i + 1][1] - coords[i][1]
+        if (dr1, dc1) != (dr2, dc2):
+            turns += 1
+    return turns
