+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIR_UP = -1
+DIR_DOWN = 1
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG4 = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in N4:
+        yield r + dr, c + dc
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _parse_legend(grid: np.ndarray) -> tuple[dict[int, int], np.ndarray]:
+    h, w = grid.shape
+    assert w >= 2, "grid must have at least two columns"
+    legend_mask = np.zeros_like(grid, dtype=bool)
+    mapping: dict[int, int] = {}
+    r = 0
+    while r <= h - 2:
+        block = grid[r : r + 2, 0:2]
+        left = block[:, 0]
+        right = block[:, 1]
+        if (
+            int(left[0]) == int(left[1])
+            and int(left[0]) not in (BG, GREY)
+            and tuple(map(int, right.tolist())) in ((GREY, BG), (BG, GREY))
+        ):
+            color = int(left[0])
+            direction = DIR_UP if int(right[0]) == GREY else DIR_DOWN
+            assert color not in mapping, "legend color must be unique"
+            mapping[color] = direction
+            legend_mask[r : r + 2, 0:2] = True
+            r += 2
+            continue
+        r += 1
+    assert 2 <= len(mapping) <= 3, "expected 2 or 3 legend entries"
+    assert set(mapping.values()) == {DIR_UP, DIR_DOWN}, "legend must contain both up and down"
+    return mapping, legend_mask
+
+
+def _major_color(values: np.ndarray) -> int:
+    counts = Counter(map(int, values.tolist()))
+    color, freq = counts.most_common(1)[0]
+    assert list(counts.values()).count(freq) == 1, "major color must be unique"
+    return int(color)
+
+
+def _extract_fragments(
+    grid: np.ndarray,
+    *,
+    direction_override: callable | None = None,
+) -> tuple[dict[int, int], np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    mapping, legend_mask = _parse_legend(g)
+
+    fg_mask = (g != bg) & (g != GREY) & (~legend_mask)
+    comps = _component_coords(fg_mask)
+    assert 2 <= len(comps) <= 3, "expected 2 or 3 non-legend objects"
+
+    fragments: list[dict] = []
+    upper_dirs: list[int] = []
+    for obj_idx, coords in enumerate(sorted(comps, key=lambda x: (int(x[:, 0].min()), int(x[:, 1].min())))):
+        obj_colors = sorted(set(map(int, g[coords[:, 0], coords[:, 1]].tolist())))
+        assert len(obj_colors) == 2, "each object must use exactly two colors"
+        assert all(color in mapping for color in obj_colors), "object colors must appear in legend"
+        assert mapping[obj_colors[0]] != mapping[obj_colors[1]], "object colors must map to opposite directions"
+
+        r0, c0, r1, c1 = _bbox(coords)
+        height = r1 - r0 + 1
+        assert height % 2 == 0 and 4 <= height <= 8, "object height must be even and between 4 and 8"
+        assert 3 <= c1 - c0 + 1 <= 5, "object width must be between 3 and 5"
+        split_row = r0 + height // 2
+
+        upper_mask = coords[:, 0] < split_row
+        lower_mask = coords[:, 0] >= split_row
+        upper_coords = coords[upper_mask]
+        lower_coords = coords[lower_mask]
+        assert upper_coords.size and lower_coords.size, "both halves must be nonempty"
+
+        upper_vals = g[upper_coords[:, 0], upper_coords[:, 1]]
+        lower_vals = g[lower_coords[:, 0], lower_coords[:, 1]]
+        upper_major = _major_color(upper_vals)
+        lower_major = _major_color(lower_vals)
+
+        upper_dir = direction_override(obj_idx, "upper", upper_major) if direction_override else mapping[upper_major]
+        lower_dir = direction_override(obj_idx, "lower", lower_major) if direction_override else mapping[lower_major]
+        upper_dirs.append(int(upper_dir))
+
+        fragments.append(
+            {
+                "object_id": obj_idx,
+                "half": "upper",
+                "coords": upper_coords.copy(),
+                "colors": upper_vals.copy(),
+                "dir": int(upper_dir),
+                "major": int(upper_major),
+            }
+        )
+        fragments.append(
+            {
+                "object_id": obj_idx,
+                "half": "lower",
+                "coords": lower_coords.copy(),
+                "colors": lower_vals.copy(),
+                "dir": int(lower_dir),
+                "major": int(lower_major),
+            }
+        )
+
+    assert DIR_UP in upper_dirs and DIR_DOWN in upper_dirs, "sample must contain upper halves moving both up and down"
+    return mapping, legend_mask, fragments
+
+
+def _coord_set(coords: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, rc)) for rc in coords.tolist()}
+
+
+def _diag_contact(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    has_diag = False
+    has_cardinal = False
+    for r, c in a:
+        for dr, dc in N4:
+            if (r + dr, c + dc) in b:
+                has_cardinal = True
+        for dr, dc in DIAG4:
+            if (r + dr, c + dc) in b:
+                has_diag = True
+        if has_diag and has_cardinal:
+            return False
+    return has_diag and not has_cardinal
+
+
+def _touches_boundary(coords: np.ndarray, direction: int, h: int) -> bool:
+    rows = coords[:, 0]
+    if direction == DIR_UP:
+        return int(rows.min()) == 0
+    return int(rows.max()) == h - 1
+
+
+def _simulate_fragments(grid: np.ndarray, fragments: list[dict]) -> tuple[list[dict], list[dict]]:
+    h, w = grid.shape
+    state: list[dict] = []
+    for frag in fragments:
+        state.append(
+            {
+                **frag,
+                "coords": frag["coords"].copy(),
+                "colors": frag["colors"].copy(),
+                "steps": 0,
+                "reason": None,
+            }
+        )
+
+    def build_sets() -> list[set[tuple[int, int]]]:
+        return [_coord_set(f["coords"]) for f in state]
+
+    def assert_disjoint():
+        all_pts: set[tuple[int, int]] = set()
+        for frag in state:
+            pts = _coord_set(frag["coords"])
+            assert all(0 <= r < h and 0 <= c < w for r, c in pts), "fragment left the grid"
+            assert all_pts.isdisjoint(pts), "fragments may not overlap"
+            all_pts |= pts
+
+    assert_disjoint()
+    fixed = [False] * len(state)
+
+    sets = build_sets()
+    for i in range(len(state)):
+        if any(_diag_contact(sets[i], sets[j]) for j in range(len(state)) if j != i):
+            fixed[i] = True
+            state[i]["reason"] = "diag"
+    for i in range(len(state)):
+        if not fixed[i] and _touches_boundary(state[i]["coords"], state[i]["dir"], h):
+            fixed[i] = True
+            state[i]["reason"] = "boundary"
+
+    limit = h * 2 + 2
+    for _ in range(limit):
+        if all(fixed):
+            break
+        progressed = False
+        for i, frag in enumerate(state):
+            if fixed[i]:
+                continue
+            if _touches_boundary(frag["coords"], frag["dir"], h):
+                fixed[i] = True
+                frag["reason"] = "boundary"
+                continue
+            frag["coords"][:, 0] += frag["dir"]
+            frag["steps"] += 1
+            progressed = True
+
+        assert_disjoint()
+        sets = build_sets()
+        for i in range(len(state)):
+            if fixed[i]:
+                continue
+            if any(_diag_contact(sets[i], sets[j]) for j in range(len(state)) if j != i):
+                fixed[i] = True
+                state[i]["reason"] = "diag"
+        for i in range(len(state)):
+            if not fixed[i] and _touches_boundary(state[i]["coords"], state[i]["dir"], h):
+                fixed[i] = True
+                state[i]["reason"] = "boundary"
+        if not progressed:
+            break
+
+    assert all(fixed), "simulation did not terminate"
+    return state, fragments
+
+
+def _render_output(shape: tuple[int, int], legend_mask: np.ndarray, state: list[dict]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    out[legend_mask] = BG
+    for frag in state:
+        rows = frag["coords"][:, 0]
+        cols = frag["coords"][:, 1]
+        out[rows, cols] = frag["colors"]
+    return out
+
+
+def _solve_core(grid: np.ndarray, *, direction_override: callable | None = None) -> tuple[np.ndarray, dict]:
+    mapping, legend_mask, fragments = _extract_fragments(grid, direction_override=direction_override)
+    state, base = _simulate_fragments(np.asarray(grid, dtype=int), fragments)
+    out = _render_output(np.asarray(grid).shape, legend_mask, state)
+    meta = {"mapping": mapping, "legend_mask": legend_mask, "fragments": base, "final_state": state}
+    return out, meta
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Read a left-edge direction legend, split each two-color object horizontally, and slide the halves until they stop at diagonal joins.
+
+    Input structure:
+    - The background is black, and the left edge contains 2x2 legend blocks in columns 0-1.
+    - In each legend block the left column is one object color, while a single gray cell in the right column marks whether that color moves up or down.
+    - Away from the legend there are 2-3 four-connected two-color objects with even-height bboxes.
+
+    Rule:
+    - Parse each legend block as a color -> vertical direction mapping, then ignore the legend in the output.
+    - Split every non-legend object at the horizontal midpoint of its bbox into an upper half and a lower half.
+    - For each half, find its majority color, look up that color's direction in the legend, and move that half one row per synchronous step in that direction.
+    - A half stops as soon as it becomes diagonally adjacent to any other half without any cardinal contact, or when it can no longer move because it has reached the grid boundary.
+
+    Key insight:
+    - The legend does not map colors to replacement colors; it maps colors to motion directions, so the majority color inside each split half decides how that fragment travels.
+    """
+    out, _ = _solve_core(np.asarray(grid, dtype=int))
+    return out
+
+
+def _connected_patch(cells: list[tuple[int, int]], target_size: int) -> set[tuple[int, int]]:
+    cell_set = set(cells)
+    seed = random.choice(cells)
+    patch = {seed}
+    while len(patch) < target_size:
+        frontier = sorted(
+            nbr
+            for r, c in patch
+            for nbr in _neighbors4(r, c)
+            if nbr in cell_set and nbr not in patch
+        )
+        if not frontier:
+            break
+        patch.add(random.choice(frontier))
+    return patch
+
+
+def _paint_half(sprite: np.ndarray, rows: range, major_color: int, minor_color: int) -> None:
+    cells = [(r, c) for r in rows for c in range(sprite.shape[1]) if sprite[r, c] != BG]
+    assert len(cells) >= 2
+    minor_size = random.randint(1, max(1, len(cells) // 3))
+    patch = _connected_patch(cells, minor_size)
+    for r, c in cells:
+        sprite[r, c] = minor_color if (r, c) in patch else major_color
+
+
+def _make_normal_sprite(width: int, height: int, upper_major: int, lower_major: int, other_color: int) -> np.ndarray:
+    sprite = np.full((height, width), BG, dtype=int)
+    sprite[:, :] = 9
+    removable = [(0, 0), (0, width - 1), (height - 1, 0), (height - 1, width - 1)]
+    random.shuffle(removable)
+    for r, c in removable[: random.randint(0, min(2, len(removable)))]:
+        if 0 < r < height - 1 or 0 < c < width - 1:
+            sprite[r, c] = BG
+    mid = height // 2
+    _paint_half(sprite, range(0, mid), upper_major, other_color)
+    _paint_half(sprite, range(mid, height), lower_major, other_color)
+    return sprite
+
+
+def _make_contrary_sprite(upper_major: int, lower_major: int, up_color: int, down_color: int) -> np.ndarray:
+    width = 5
+    height = 4
+    sprite = np.full((height, width), BG, dtype=int)
+    intervals = [(0, 1), (1, 2), (2, 3), (3, 4)]
+    if random.random() < 0.5:
+        intervals = [(width - 1 - hi, width - 1 - lo) for lo, hi in intervals]
+    for r, (lo, hi) in enumerate(intervals):
+        sprite[r, lo : hi + 1] = 9
+    mid = height // 2
+    _paint_half(sprite, range(0, mid), upper_major, up_color if upper_major != up_color else down_color)
+    _paint_half(sprite, range(mid, height), lower_major, down_color if lower_major != down_color else up_color)
+    return sprite
+
+
+def _paste(dst: np.ndarray, sprite: np.ndarray, top: int, left: int) -> None:
+    h, w = sprite.shape
+    region = dst[top : top + h, left : left + w]
+    mask = sprite != BG
+    assert not np.any(region[mask] != BG), "sprite placement overlap"
+    region[mask] = sprite[mask]
+
+
+def _object_bbox_on_grid(sprite: np.ndarray, top: int, left: int) -> tuple[int, int, int, int]:
+    pts = np.argwhere(sprite != BG)
+    pts = pts + np.array([top, left], dtype=int)
+    return _bbox(pts)
+
+
+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    return not (a[2] + gap < b[0] or b[2] + gap < a[0] or a[3] + gap < b[1] or b[3] + gap < a[1])
+
+
+def _draw_legend(grid: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    h = grid.shape[0]
+    mask = np.zeros_like(grid, dtype=bool)
+    rows = list(range(1, 1 + 3 * len(mapping), 3))
+    if rows[-1] + 1 >= h:
+        rows = list(range(h - (3 * len(mapping) - 1) - 1, h - 1, 3))
+    for (color, direction), r in zip(sorted(mapping.items()), rows, strict=False):
+        grid[r : r + 2, 0] = color
+        if direction == DIR_UP:
+            grid[r, 1] = GREY
+            grid[r + 1, 1] = BG
+        else:
+            grid[r, 1] = BG
+            grid[r + 1, 1] = GREY
+        mask[r : r + 2, 0:2] = True
+    return mask
+
+
+def _position_solver(grid: np.ndarray) -> np.ndarray:
+    def override(_obj_idx: int, half: str, _major: int) -> int:
+        return DIR_UP if half == "upper" else DIR_DOWN
+
+    out, _ = _solve_core(grid, direction_override=override)
+    return out
+
+
+def _validate_sample(grid: np.ndarray, require_boundary: bool) -> bool:
+    try:
+        out, meta = _solve_core(grid)
+    except AssertionError:
+        return False
+
+    state = meta["final_state"]
+    if not any(f["reason"] == "diag" for f in state):
+        return False
+    if require_boundary and not any(f["reason"] == "boundary" for f in state):
+        return False
+    if not any(f["steps"] > 0 for f in state):
+        return False
+    if np.array_equal(out, _position_solver(grid)):
+        return False
+    if np.any(out[:, :2] != BG):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(16, 22)
+    w = random.randint(19, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    legend_count = 3 if random.random() < 0.7 else 2
+    colors = random.sample(PALETTE, legend_count)
+    up_colors = random.sample(colors, 1 if legend_count == 2 else random.choice([1, 2]))
+    mapping = {color: (DIR_UP if color in up_colors else DIR_DOWN) for color in colors}
+    if set(mapping.values()) != {DIR_UP, DIR_DOWN}:
+        return None
+
+    up_pool = [c for c, d in mapping.items() if d == DIR_UP]
+    down_pool = [c for c, d in mapping.items() if d == DIR_DOWN]
+    if not up_pool or not down_pool:
+        return None
+
+    _draw_legend(grid, mapping)
+
+    require_boundary = random.random() < 0.45
+    object_count = 3 if random.random() < 0.75 else 2
+
+    top_up = random.choice(up_pool)
+    top_down = random.choice(down_pool)
+    top_width = random.randint(3, 5)
+    top_height = random.choice([4, 6])
+    top_sprite = _make_normal_sprite(top_width, top_height, top_up, top_down, top_down)
+
+    if object_count == 3:
+        mid_up = random.choice(up_pool)
+        mid_down = random.choice(down_pool)
+        mid_width = random.randint(3, 5)
+        mid_height = random.choice([4, 6])
+        mid_sprite = _make_normal_sprite(mid_width, mid_height, mid_up, mid_down, mid_down)
+
+        contra_up = random.choice(up_pool)
+        contra_down = random.choice(down_pool)
+        contra_sprite = _make_contrary_sprite(contra_down, contra_up, contra_up, contra_down)
+
+        top_left = random.randint(5, 8)
+        mid_left = top_left + top_width
+        if mid_left + mid_width > w - 2:
+            return None
+        top_row = random.randint(2, 4)
+        vertical_gap = random.choice([2, 4])
+        mid_row = top_row + top_height + vertical_gap
+        if mid_row + mid_height > h - 2:
+            return None
+
+        contra_left_choices = [c for c in range(4, w - 5) if c + 5 <= w - 1 and abs(c - top_left) >= 3 and abs(c - mid_left) >= 3]
+        if not contra_left_choices:
+            return None
+        contra_left = random.choice(contra_left_choices)
+        contra_row_choices = [r for r in range(2, h - 4) if abs(r - top_row) >= 3 and abs(r - mid_row) >= 3]
+        if not contra_row_choices:
+            return None
+        contra_row = random.choice(contra_row_choices)
+
+        placements = [
+            (top_sprite, top_row, top_left),
+            (mid_sprite, mid_row, mid_left),
+            (contra_sprite, contra_row, contra_left),
+        ]
+    else:
+        contra_up = random.choice(up_pool)
+        contra_down = random.choice(down_pool)
+        contra_sprite = _make_contrary_sprite(contra_down, contra_up, contra_up, contra_down)
+
+        top_left = random.randint(5, 9)
+        contra_left = top_left + top_width
+        if contra_left + contra_sprite.shape[1] > w - 2:
+            return None
+        top_row = random.randint(2, 4)
+        vertical_gap = random.choice([2, 4])
+        contra_row = top_row + top_height + vertical_gap
+        if contra_row + contra_sprite.shape[0] > h - 2:
+            return None
+
+        placements = [
+            (top_sprite, top_row, top_left),
+            (contra_sprite, contra_row, contra_left),
+        ]
+
+    boxes: list[tuple[int, int, int, int]] = []
+    for sprite, row, col in placements:
+        box = _object_bbox_on_grid(sprite, row, col)
+        if any(_boxes_too_close(box, other, 0) for other in boxes):
+            return None
+        boxes.append(box)
+        _paste(grid, sprite, row, col)
+
+    if not _validate_sample(grid, require_boundary=require_boundary):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample")

diff --git a/023/3.py b/023/3.py
new file mode 100644
index 0000000000000000000000000000000000000000..a96e7d8a7d684af1607e7daa8729f0a61611f1fa
--- /dev/null
+++ b/023/3.py
@@ -0,0 +1,518 @@
+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+DIR_UP = -1
+DIR_DOWN = 1
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG4 = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in N4:
+        yield r + dr, c + dc
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _parse_legend(grid: np.ndarray) -> tuple[dict[int, int], np.ndarray]:
+    h, w = grid.shape
+    assert w >= 2, "grid must have at least two columns"
+    legend_mask = np.zeros_like(grid, dtype=bool)
+    mapping: dict[int, int] = {}
+    r = 0
+    while r <= h - 2:
+        block = grid[r : r + 2, 0:2]
+        left = block[:, 0]
+        right = block[:, 1]
+        if (
+            int(left[0]) == int(left[1])
+            and int(left[0]) not in (BG, GREY)
+            and tuple(map(int, right.tolist())) in ((GREY, BG), (BG, GREY))
+        ):
+            color = int(left[0])
+            direction = DIR_UP if int(right[0]) == GREY else DIR_DOWN
+            assert color not in mapping, "legend color must be unique"
+            mapping[color] = direction
+            legend_mask[r : r + 2, 0:2] = True
+            r += 2
+            continue
+        r += 1
+    assert 2 <= len(mapping) <= 3, "expected 2 or 3 legend entries"
+    assert set(mapping.values()) == {DIR_UP, DIR_DOWN}, "legend must contain both up and down"
+    return mapping, legend_mask
+
+
+def _major_color(values: np.ndarray) -> int:
+    counts = Counter(map(int, values.tolist()))
+    color, freq = counts.most_common(1)[0]
+    assert list(counts.values()).count(freq) == 1, "major color must be unique"
+    return int(color)
+
+
+def _extract_fragments(
+    grid: np.ndarray,
+    *,
+    direction_override: callable | None = None,
+) -> tuple[dict[int, int], np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    mapping, legend_mask = _parse_legend(g)
+
+    fg_mask = (g != bg) & (g != GREY) & (~legend_mask)
+    comps = _component_coords(fg_mask)
+    assert 2 <= len(comps) <= 3, "expected 2 or 3 non-legend objects"
+
+    fragments: list[dict] = []
+    upper_dirs: list[int] = []
+    for obj_idx, coords in enumerate(sorted(comps, key=lambda x: (int(x[:, 0].min()), int(x[:, 1].min())))):
+        obj_colors = sorted(set(map(int, g[coords[:, 0], coords[:, 1]].tolist())))
+        assert len(obj_colors) == 2, "each object must use exactly two colors"
+        assert all(color in mapping for color in obj_colors), "object colors must appear in legend"
+        assert mapping[obj_colors[0]] != mapping[obj_colors[1]], "object colors must map to opposite directions"
+
+        r0, c0, r1, c1 = _bbox(coords)
+        height = r1 - r0 + 1
+        assert height % 2 == 0 and 4 <= height <= 8, "object height must be even and between 4 and 8"
+        assert 3 <= c1 - c0 + 1 <= 5, "object width must be between 3 and 5"
+        split_row = r0 + height // 2
+
+        upper_mask = coords[:, 0] < split_row
+        lower_mask = coords[:, 0] >= split_row
+        upper_coords = coords[upper_mask]
+        lower_coords = coords[lower_mask]
+        assert upper_coords.size and lower_coords.size, "both halves must be nonempty"
+
+        upper_vals = g[upper_coords[:, 0], upper_coords[:, 1]]
+        lower_vals = g[lower_coords[:, 0], lower_coords[:, 1]]
+        upper_major = _major_color(upper_vals)
+        lower_major = _major_color(lower_vals)
+
+        upper_dir = direction_override(obj_idx, "upper", upper_major) if direction_override else mapping[upper_major]
+        lower_dir = direction_override(obj_idx, "lower", lower_major) if direction_override else mapping[lower_major]
+        upper_dirs.append(int(upper_dir))
+
+        fragments.append(
+            {
+                "object_id": obj_idx,
+                "half": "upper",
+                "coords": upper_coords.copy(),
+                "colors": upper_vals.copy(),
+                "dir": int(upper_dir),
+                "major": int(upper_major),
+            }
+        )
+        fragments.append(
+            {
+                "object_id": obj_idx,
+                "half": "lower",
+                "coords": lower_coords.copy(),
+                "colors": lower_vals.copy(),
+                "dir": int(lower_dir),
+                "major": int(lower_major),
+            }
+        )
+
+    assert DIR_UP in upper_dirs and DIR_DOWN in upper_dirs, "sample must contain upper halves moving both up and down"
+    return mapping, legend_mask, fragments
+
+
+def _coord_set(coords: np.ndarray) -> set[tuple[int, int]]:
+    return {tuple(map(int, rc)) for rc in coords.tolist()}
+
+
+def _diag_contact(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    has_diag = False
+    has_cardinal = False
+    for r, c in a:
+        for dr, dc in N4:
+            if (r + dr, c + dc) in b:
+                has_cardinal = True
+        for dr, dc in DIAG4:
+            if (r + dr, c + dc) in b:
+                has_diag = True
+        if has_diag and has_cardinal:
+            return False
+    return has_diag and not has_cardinal
+
+
+def _touches_boundary(coords: np.ndarray, direction: int, h: int) -> bool:
+    rows = coords[:, 0]
+    if direction == DIR_UP:
+        return int(rows.min()) == 0
+    return int(rows.max()) == h - 1
+
+
+def _simulate_fragments(grid: np.ndarray, fragments: list[dict]) -> tuple[list[dict], list[dict]]:
+    h, w = grid.shape
+    state: list[dict] = []
+    for frag in fragments:
+        state.append(
+            {
+                **frag,
+                "coords": frag["coords"].copy(),
+                "colors": frag["colors"].copy(),
+                "steps": 0,
+                "reason": None,
+            }
+        )
+
+    def build_sets() -> list[set[tuple[int, int]]]:
+        return [_coord_set(f["coords"]) for f in state]
+
+    def assert_disjoint():
+        all_pts: set[tuple[int, int]] = set()
+        for frag in state:
+            pts = _coord_set(frag["coords"])
+            assert all(0 <= r < h and 0 <= c < w for r, c in pts), "fragment left the grid"
+            assert all_pts.isdisjoint(pts), "fragments may not overlap"
+            all_pts |= pts
+
+    assert_disjoint()
+    fixed = [False] * len(state)
+
+    sets = build_sets()
+    for i in range(len(state)):
+        if any(_diag_contact(sets[i], sets[j]) for j in range(len(state)) if j != i):
+            fixed[i] = True
+            state[i]["reason"] = "diag"
+    for i in range(len(state)):
+        if not fixed[i] and _touches_boundary(state[i]["coords"], state[i]["dir"], h):
+            fixed[i] = True
+            state[i]["reason"] = "boundary"
+
+    limit = h * 2 + 2
+    for _ in range(limit):
+        if all(fixed):
+            break
+        progressed = False
+        for i, frag in enumerate(state):
+            if fixed[i]:
+                continue
+            if _touches_boundary(frag["coords"], frag["dir"], h):
+                fixed[i] = True
+                frag["reason"] = "boundary"
+                continue
+            frag["coords"][:, 0] += frag["dir"]
+            frag["steps"] += 1
+            progressed = True
+
+        assert_disjoint()
+        sets = build_sets()
+        for i in range(len(state)):
+            if fixed[i]:
+                continue
+            if any(_diag_contact(sets[i], sets[j]) for j in range(len(state)) if j != i):
+                fixed[i] = True
+                state[i]["reason"] = "diag"
+        for i in range(len(state)):
+            if not fixed[i] and _touches_boundary(state[i]["coords"], state[i]["dir"], h):
+                fixed[i] = True
+                state[i]["reason"] = "boundary"
+        if not progressed:
+            break
+
+    assert all(fixed), "simulation did not terminate"
+    return state, fragments
+
+
+def _render_output(shape: tuple[int, int], legend_mask: np.ndarray, state: list[dict]) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    out[legend_mask] = BG
+    for frag in state:
+        rows = frag["coords"][:, 0]
+        cols = frag["coords"][:, 1]
+        out[rows, cols] = frag["colors"]
+    return out
+
+
+def _solve_core(grid: np.ndarray, *, direction_override: callable | None = None) -> tuple[np.ndarray, dict]:
+    mapping, legend_mask, fragments = _extract_fragments(grid, direction_override=direction_override)
+    state, base = _simulate_fragments(np.asarray(grid, dtype=int), fragments)
+    out = _render_output(np.asarray(grid).shape, legend_mask, state)
+    meta = {"mapping": mapping, "legend_mask": legend_mask, "fragments": base, "final_state": state}
+    return out, meta
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Read a left-edge direction legend, split each two-color object horizontally, and slide the halves until they stop at diagonal joins.
+
+    Input structure:
+    - The background is black, and the left edge contains 2x2 legend blocks in columns 0-1.
+    - In each legend block the left column is one object color, while a single gray cell in the right column marks whether that color moves up or down.
+    - Away from the legend there are 2-3 four-connected two-color objects with even-height bboxes.
+
+    Rule:
+    - Parse each legend block as a color -> vertical direction mapping, then ignore the legend in the output.
+    - Split every non-legend object at the horizontal midpoint of its bbox into an upper half and a lower half.
+    - For each half, find its majority color, look up that color's direction in the legend, and move that half one row per synchronous step in that direction.
+    - A half stops as soon as it becomes diagonally adjacent to any other half without any cardinal contact, or when it can no longer move because it has reached the grid boundary.
+
+    Key insight:
+    - The legend does not map colors to replacement colors; it maps colors to motion directions, so the majority color inside each split half decides how that fragment travels.
+    """
+    out, _ = _solve_core(np.asarray(grid, dtype=int))
+    return out
+
+
+def _connected_patch(cells: list[tuple[int, int]], target_size: int) -> set[tuple[int, int]]:
+    cell_set = set(cells)
+    seed = random.choice(cells)
+    patch = {seed}
+    while len(patch) < target_size:
+        frontier = sorted(
+            nbr
+            for r, c in patch
+            for nbr in _neighbors4(r, c)
+            if nbr in cell_set and nbr not in patch
+        )
+        if not frontier:
+            break
+        patch.add(random.choice(frontier))
+    return patch
+
+
+def _paint_half(sprite: np.ndarray, rows: range, major_color: int, minor_color: int) -> None:
+    cells = [(r, c) for r in rows for c in range(sprite.shape[1]) if sprite[r, c] != BG]
+    assert len(cells) >= 2
+    minor_size = random.randint(1, max(1, len(cells) // 3))
+    patch = _connected_patch(cells, minor_size)
+    for r, c in cells:
+        sprite[r, c] = minor_color if (r, c) in patch else major_color
+
+
+def _make_normal_sprite(width: int, height: int, upper_major: int, lower_major: int, other_color: int) -> np.ndarray:
+    sprite = np.full((height, width), BG, dtype=int)
+    sprite[:, :] = 9
+    removable = [(0, 0), (0, width - 1), (height - 1, 0), (height - 1, width - 1)]
+    random.shuffle(removable)
+    for r, c in removable[: random.randint(0, min(2, len(removable)))]:
+        if 0 < r < height - 1 or 0 < c < width - 1:
+            sprite[r, c] = BG
+    mid = height // 2
+    _paint_half(sprite, range(0, mid), upper_major, other_color)
+    _paint_half(sprite, range(mid, height), lower_major, other_color)
+    return sprite
+
+
+def _make_contrary_sprite(upper_major: int, lower_major: int, up_color: int, down_color: int) -> np.ndarray:
+    width = 5
+    height = 4
+    sprite = np.full((height, width), BG, dtype=int)
+    intervals = [(0, 1), (1, 2), (2, 3), (3, 4)]
+    if random.random() < 0.5:
+        intervals = [(width - 1 - hi, width - 1 - lo) for lo, hi in intervals]
+    for r, (lo, hi) in enumerate(intervals):
+        sprite[r, lo : hi + 1] = 9
+    mid = height // 2
+    _paint_half(sprite, range(0, mid), upper_major, up_color if upper_major != up_color else down_color)
+    _paint_half(sprite, range(mid, height), lower_major, down_color if lower_major != down_color else up_color)
+    return sprite
+
+
+def _paste(dst: np.ndarray, sprite: np.ndarray, top: int, left: int) -> None:
+    h, w = sprite.shape
+    region = dst[top : top + h, left : left + w]
+    mask = sprite != BG
+    assert not np.any(region[mask] != BG), "sprite placement overlap"
+    region[mask] = sprite[mask]
+
+
+def _object_bbox_on_grid(sprite: np.ndarray, top: int, left: int) -> tuple[int, int, int, int]:
+    pts = np.argwhere(sprite != BG)
+    pts = pts + np.array([top, left], dtype=int)
+    return _bbox(pts)
+
+
+def _boxes_too_close(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    return not (a[2] + gap < b[0] or b[2] + gap < a[0] or a[3] + gap < b[1] or b[3] + gap < a[1])
+
+
+def _draw_legend(grid: np.ndarray, mapping: dict[int, int]) -> np.ndarray:
+    h = grid.shape[0]
+    mask = np.zeros_like(grid, dtype=bool)
+    rows = list(range(1, 1 + 3 * len(mapping), 3))
+    if rows[-1] + 1 >= h:
+        rows = list(range(h - (3 * len(mapping) - 1) - 1, h - 1, 3))
+    for (color, direction), r in zip(sorted(mapping.items()), rows, strict=False):
+        grid[r : r + 2, 0] = color
+        if direction == DIR_UP:
+            grid[r, 1] = GREY
+            grid[r + 1, 1] = BG
+        else:
+            grid[r, 1] = BG
+            grid[r + 1, 1] = GREY
+        mask[r : r + 2, 0:2] = True
+    return mask
+
+
+def _position_solver(grid: np.ndarray) -> np.ndarray:
+    def override(_obj_idx: int, half: str, _major: int) -> int:
+        return DIR_UP if half == "upper" else DIR_DOWN
+
+    out, _ = _solve_core(grid, direction_override=override)
+    return out
+
+
+def _validate_sample(grid: np.ndarray, require_boundary: bool) -> bool:
+    try:
+        out, meta = _solve_core(grid)
+    except AssertionError:
+        return False
+
+    state = meta["final_state"]
+    if not any(f["reason"] == "diag" for f in state):
+        return False
+    if require_boundary and not any(f["reason"] == "boundary" for f in state):
+        return False
+    if not any(f["steps"] > 0 for f in state):
+        return False
+    if np.array_equal(out, _position_solver(grid)):
+        return False
+    if np.any(out[:, :2] != BG):
+        return False
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(16, 22)
+    w = random.randint(19, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    legend_count = 3 if random.random() < 0.7 else 2
+    colors = random.sample(PALETTE, legend_count)
+    up_colors = random.sample(colors, 1 if legend_count == 2 else random.choice([1, 2]))
+    mapping = {color: (DIR_UP if color in up_colors else DIR_DOWN) for color in colors}
+    if set(mapping.values()) != {DIR_UP, DIR_DOWN}:
+        return None
+
+    up_pool = [c for c, d in mapping.items() if d == DIR_UP]
+    down_pool = [c for c, d in mapping.items() if d == DIR_DOWN]
+    if not up_pool or not down_pool:
+        return None
+
+    _draw_legend(grid, mapping)
+
+    require_boundary = random.random() < 0.45
+    object_count = 3 if random.random() < 0.75 else 2
+
+    top_up = random.choice(up_pool)
+    top_down = random.choice(down_pool)
+    top_width = random.randint(3, 5)
+    top_height = random.choice([4, 6])
+    top_sprite = _make_normal_sprite(top_width, top_height, top_up, top_down, top_down)
+
+    if object_count == 3:
+        mid_up = random.choice(up_pool)
+        mid_down = random.choice(down_pool)
+        mid_width = random.randint(3, 5)
+        mid_height = random.choice([4, 6])
+        mid_sprite = _make_normal_sprite(mid_width, mid_height, mid_up, mid_down, mid_down)
+
+        contra_up = random.choice(up_pool)
+        contra_down = random.choice(down_pool)
+        contra_sprite = _make_contrary_sprite(contra_down, contra_up, contra_up, contra_down)
+
+        top_left = random.randint(5, 8)
+        mid_left = top_left + top_width
+        if mid_left + mid_width > w - 2:
+            return None
+        top_row = random.randint(2, 4)
+        vertical_gap = random.choice([2, 4])
+        mid_row = top_row + top_height + vertical_gap
+        if mid_row + mid_height > h - 2:
+            return None
+
+        contra_left_choices = [c for c in range(4, w - 5) if c + 5 <= w - 1 and abs(c - top_left) >= 3 and abs(c - mid_left) >= 3]
+        if not contra_left_choices:
+            return None
+        contra_left = random.choice(contra_left_choices)
+        contra_row_choices = [r for r in range(2, h - 4) if abs(r - top_row) >= 3 and abs(r - mid_row) >= 3]
+        if not contra_row_choices:
+            return None
+        contra_row = random.choice(contra_row_choices)
+
+        placements = [
+            (top_sprite, top_row, top_left),
+            (mid_sprite, mid_row, mid_left),
+            (contra_sprite, contra_row, contra_left),
+        ]
+    else:
+        contra_up = random.choice(up_pool)
+        contra_down = random.choice(down_pool)
+        contra_sprite = _make_contrary_sprite(contra_down, contra_up, contra_up, contra_down)
+
+        top_left = random.randint(5, 9)
+        contra_left = top_left + top_width
+        if contra_left + contra_sprite.shape[1] > w - 2:
+            return None
+        top_row = random.randint(2, 4)
+        vertical_gap = random.choice([2, 4])
+        contra_row = top_row + top_height + vertical_gap
+        if contra_row + contra_sprite.shape[0] > h - 2:
+            return None
+
+        placements = [
+            (top_sprite, top_row, top_left),
+            (contra_sprite, contra_row, contra_left),
+        ]
+
+    boxes: list[tuple[int, int, int, int]] = []
+    for sprite, row, col in placements:
+        box = _object_bbox_on_grid(sprite, row, col)
+        if any(_boxes_too_close(box, other, 0) for other in boxes):
+            return None
+        boxes.append(box)
+        _paste(grid, sprite, row, col)
+
+    if not _validate_sample(grid, require_boundary=require_boundary):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample")

