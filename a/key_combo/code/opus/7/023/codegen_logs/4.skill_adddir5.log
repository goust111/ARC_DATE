+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BACKGROUND = 0
+SEPARATOR = 7
+PAYLOAD_COLORS = (1, 2, 3, 4, 6, 8, 9)
+GEN_ATTEMPTS = 500
+
+
+def _rot90_orbit(side: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    last = side - 1
+    return (
+        (r, c),
+        (c, last - r),
+        (last - r, last - c),
+        (last - c, r),
+    )
+
