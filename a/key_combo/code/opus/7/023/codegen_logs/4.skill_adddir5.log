+        for c in range(side):
+            orbit = tuple(sorted(set(_rot90_orbit(side, r, c))))
+            if orbit in seen:
+                continue
+            seen.add(orbit)
+            fg_positions = [pos for pos in orbit if int(square[pos]) != BACKGROUND]
