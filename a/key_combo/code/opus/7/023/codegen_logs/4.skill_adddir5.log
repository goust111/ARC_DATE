+    if want_conflict and conflict_count == 0:
+        return False
+    if not want_conflict and conflict_count != 0:
+        return False
+
+    solved = main(grid)
+    if not np.array_equal(solved, completed):
+        return False
+
+    if max(grid.shape) > 30 or max(solved.shape) > 30:
+        return False
+    return True
