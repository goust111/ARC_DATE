+        col_steps = np.diff(np.concatenate(([-1], col_lines, [w])))
+        if len(set(map(int, row_steps))) != 1 or len(set(map(int, col_steps))) != 1:
+            continue
+
+        row_step = int(row_steps[0])
+        col_step = int(col_steps[0])
+        cell_h = row_step - 1
+        cell_w = col_step - 1
+        if cell_h < 1 or cell_w < 1:
+            continue
