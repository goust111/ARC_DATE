    if center_orb:
        base.extend(center_orb[0]["cells"])

    preferred_sector = random.randrange(SECTOR_COUNT)
    choices = []
    for orb in partial_orbs:
        opts = []
        seen = set()
        for idx, pos in enumerate(_rot90_orbit(side, *orb["rep"])):
