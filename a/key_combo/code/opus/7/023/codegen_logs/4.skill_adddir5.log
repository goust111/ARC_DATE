+        n_cols = len(col_lines) + 1
+        compact = np.zeros((n_rows, n_cols), dtype=int)
+        ok = True
+        for rr in range(n_rows):
+            r0 = rr * row_step
+            for cc in range(n_cols):
+                c0 = cc * col_step
+                block = grid[r0 : r0 + cell_h, c0 : c0 + cell_w]
+                if block.shape != (cell_h, cell_w):
+                    ok = False
+                    break
+                if not np.all(block == block[0, 0]):
