+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
