+            return None
+        mid_box = _bbox_from_pos(mid, *mid_pos)
+        mid_abs = np.array([(mid_box[0] + r, mid_box[1] + c) for r, c in mid["shape"]], dtype=int)
+        placed.append({**mid, "bbox": mid_box, "coords_abs": mid_abs})
