+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+MARKER_COLORS = (RED, GREEN)
+SIDES = ("top", "bottom", "left", "right")
+DIRS = ("up", "down", "left", "right")
+
+GEN_ATTEMPTS = 400
+GRID_MIN = 20
+GRID_MAX = 24
+ZONE_MARGIN = 1
+ZONE_GAP = 3
