+
+def _bbox_overlaps_1d(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return not (a1 < b0 or b1 < a0)
+
+
+def _candidate_positions(
+    obj: dict,
+    zone: tuple[int, int, int, int],
+    occupied: np.ndarray,
