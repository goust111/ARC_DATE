+        sr0, sc0, sr1, sc1 = smallest["bbox"]
+        if smallest["side"] == "top":
+            temp[sr0 - 1, sc0 : sc1 + 1] = BG
+        elif smallest["side"] == "bottom":
+            temp[sr1 + 1, sc0 : sc1 + 1] = BG
+        elif smallest["side"] == "left":
+            temp[sr0 : sr1 + 1, sc0 - 1] = BG
+        else:
