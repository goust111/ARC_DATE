        reasons['build_none'] += 1
        continue
    try:
        out, meta = mod._solve_core(g)
        state = meta['final_state']
        objects = meta['objects']
        upper_dirs = {obj['upper_dir'] for obj in objects}
        if upper_dirs "'!= {mod.DIR_UP, mod.DIR_DOWN}:
            reasons['"'upper_dirs'] += 1; continue
        if not all(obj['upper_major'] "'!= obj['"'lower_major'] for obj in objects):
            reasons['same_major'] += 1; continue
        if not any(fragment['steps'] > 0 for fragment in state):
            reasons['no_steps'] += 1; continue
        if not any(fragment['stop_reason'] == 'diag' for fragment in state):
            reasons['no_diag'] += 1; continue
        if np.any(out[:, :2] "'!= mod.BG):
            reasons['"'legend_not_cleared'] += 1; continue
        if np.array_equal(out, g):
            reasons['out_eq_in'] += 1; continue
        if np.array_equal(out, mod._position_solver(g)):
            reasons['same_position'] += 1; continue
        if np.array_equal(out, mod._minority_solver(g)):
            reasons['same_minority'] += 1; continue
        kept += 1
    except AssertionError:
        reasons['assert'] += 1
print('kept', kept)
print(reasons)
mod._validate_sample = orig
