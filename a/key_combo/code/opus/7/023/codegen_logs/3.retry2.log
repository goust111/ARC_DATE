+def _make_shape(width: int, height: int) -> np.ndarray:
+    kind = random.choice(["block", "stair_r", "stair_l"])
+    mask = np.zeros((height, width), dtype=bool)
+    if kind == "block" or width == 3:
+        mask[:, :] = True
