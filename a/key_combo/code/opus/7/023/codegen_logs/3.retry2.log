from pathlib import Path
from collections import Counter
import numpy as np
p = Path('/home/lixinyu/snap/a/key_combo/code/opus/7/023/3.py')
mod = SourceFileLoader('arc3_dbg2', str(p)).load_module()
orig = mod._validate_sample
mod._validate_sample = lambda *args, **kwargs: True
reasons = Counter()
kept = 0
for i in range(200):
    g = mod._generate_attempt()
