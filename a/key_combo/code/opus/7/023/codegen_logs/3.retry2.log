+def _diag_contact(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    has_diag = False
+    for r, c in a:
+        for dr, dc in DIAG4:
+            if (r + dr, c + dc) in b:
+                has_diag = True
+                break
+        if has_diag:
+            break
+    if not has_diag:
+        return False
+    for r, c in a:
+        for dr, dc in N4:
+            if (r + dr, c + dc) in b:
+                return False
+    return True
+
