+            output_patch[r, c] = sprite_color
+        for r, c in path_cells:
+            input_patch[r, c] = PATH
+        for r, c in stamp_cells:
+            output_patch[r, c] = sprite_color
+        for r, c in isolated_markers:
+            input_patch[r, c] = MARKER
+            output_patch[r, c] = MARKER
+        for r, c in repair_markers:
+            input_patch[r, c] = MARKER
+            output_patch[r, c] = sprite_color
