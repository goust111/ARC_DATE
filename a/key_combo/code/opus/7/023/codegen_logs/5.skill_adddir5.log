+        input_patch = np.zeros((local_h, local_w), dtype=int)
+        output_patch = np.zeros((local_h, local_w), dtype=int)
+
+        for r, c in template_cells:
+            input_patch[r, c] = TEMPLATE
+            output_patch[r, c] = TEMPLATE
