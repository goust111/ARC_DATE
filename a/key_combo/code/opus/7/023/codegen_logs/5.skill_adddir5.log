+
+def _sprite_patch_from_coords(coords: list[Coord], color: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        patch[r - r0, c - c0] = color
