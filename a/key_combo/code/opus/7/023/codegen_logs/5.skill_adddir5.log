+
+def _identify_groups(grid: np.ndarray) -> list[dict]:
+    mask = np.isin(grid, [TEMPLATE, RED, GREEN, PATH])
+    groups: list[dict] = []
+    for comp in _components_from_mask(mask):
+        colors = {int(grid[r, c]) for r, c in comp}
+        if colors == {PATH}:
+            continue
+        assert TEMPLATE in colors and PATH in colors, "each structure must contain template and path"
+        sprite_colors = sorted(colors & set(SPRITE_COLORS))
+        assert len(sprite_colors) == 1, "each structure must contain exactly one sprite color"
+        sprite_color = sprite_colors[0]
+
+        template_cells = [(r, c) for r, c in comp if int(grid[r, c]) == TEMPLATE]
+        path_cells = [(r, c) for r, c in comp if int(grid[r, c]) == PATH]
+        sprite_cells = [(r, c) for r, c in comp if int(grid[r, c]) == sprite_color]
+
+        assert len(_components_from_mask(np.isin(grid, [TEMPLATE]) & np.array([[ (r, c) in set(comp) for c in range(grid.shape[1])] for r in range(grid.shape[0])], dtype=bool))) >= 0
+        assert len(_components_from_mask(np.array([[False]*grid.shape[1] for _ in range(grid.shape[0])], dtype=bool))) == 0
+
+        assert len(_components_from_mask(np.array([[False] * grid.shape[1] for _ in range(grid.shape[0])], dtype=bool))) == 0
+        assert len(_components_from_mask(np.array([[False] * grid.shape[1] for _ in range(grid.shape[0])], dtype=bool))) == 0
