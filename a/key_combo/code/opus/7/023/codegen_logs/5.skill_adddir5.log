+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+
+BG = 0
+TEMPLATE = 1
+RED = 2
+GREEN = 3
+PATH = 4
+MARKER = 5
+SPRITE_COLORS = (RED, GREEN)
+
+_GROUP_GAP = 2
+_GROUP_RETRIES = 300
+_GRID_RETRIES = 300
+
+_TEMPLATE_SHAPES = [
+    {(0, 0), (1, 0), (1, 1)},
+    {(0, 0), (1, 0), (2, 0), (2, 1)},
+    {(0, 1), (1, 0), (1, 1), (2, 0)},
+    {(0, 1), (1, 0), (1, 1), (1, 2)},
+    {(0, 0), (0, 1), (1, 0), (1, 1), (2, 0)},
+    {(0, 0), (1, 0), (1, 1), (2, 1), (2, 2)},
+]
+
+_SPRITE_SHAPES = [
+    {(0, 0), (1, 0), (1, 1)},
+    {(0, 0), (1, 0), (2, 0), (2, 1)},
+    {(0, 1), (1, 0), (1, 1), (2, 0)},
+    {(0, 1), (1, 0), (1, 1), (1, 2)},
+    {(0, 0), (0, 1), (1, 0), (1, 1), (2, 1)},
+    {(0, 0), (1, 0), (1, 1), (1, 2), (0, 2)},
+]
+
+
+def neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: list[Coord] | np.ndarray) -> tuple[int, int, int, int]:
+    arr = np.asarray(coords, dtype=int)
+    r0, c0 = arr.min(axis=0)
+    r1, c1 = arr.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_from_mask(mask: np.ndarray) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[Coord]]:
+    return _components_from_mask(grid == int(color))
+
+
+def _normalize_shape(cells: set[Coord]) -> frozenset[Coord]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return frozenset((r - r0, c - c0) for r, c in cells)
+
+
+def _transform_shape(cells: set[Coord], rot: int, flip: bool) -> set[Coord]:
+    pts = list(cells)
+    out: list[Coord] = []
+    for r, c in pts:
+        rr, cc = r, c
+        for _ in range(rot % 4):
+            rr, cc = cc, -rr
+        if flip:
+            cc = -cc
+        out.append((rr, cc))
+    norm = _normalize_shape(set(out))
+    return set(norm)
+
+
+def _random_shape(shape_bank: list[set[Coord]]) -> set[Coord]:
+    base = random.choice(shape_bank)
+    return _transform_shape(base, random.randrange(4), bool(random.randrange(2)))
+
+
+def _shape_bbox(cells: set[Coord]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox_coords(list(cells))
+    return r1 - r0 + 1, c1 - c0 + 1
+
+
+def _stamp_patch(cells: set[Coord], color: int) -> np.ndarray:
+    h, w = _shape_bbox(cells)
+    patch = np.zeros((h, w), dtype=int)
+    for r, c in cells:
+        patch[r, c] = color
+    return patch
+
+
+def _place_cells(cells: set[Coord], top: int, left: int) -> set[Coord]:
+    return {(top + r, left + c) for r, c in cells}
+
+
+def _repair_sites(shape: set[Coord]) -> list[Coord]:
+    h, w = _shape_bbox(shape)
+    sites: list[Coord] = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in shape:
+                continue
+            count = sum((nr, nc) in shape for nr, nc in neighbors4(r, c))
+            if count >= 3:
+                sites.append((r, c))
+    return sites
+
+
+def _boundary_cells(shape: set[Coord], side: str) -> list[Coord]:
+    if side == "left":
+        return [(r, c) for r, c in shape if (r, c - 1) not in shape]
+    if side == "right":
+        return [(r, c) for r, c in shape if (r, c + 1) not in shape]
+    raise ValueError("side must be left or right")
+
+
+def _object_adjacency(shape: set[Coord], cells: set[Coord]) -> dict[Coord, int]:
+    adj: dict[Coord, int] = {}
+    for r, c in cells:
+        count = 0
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in shape:
+                count += 1
+        adj[(r, c)] = count
+    return adj
+
+
+def _dfs_path(
+    free: np.ndarray,
+    start: Coord,
+    end: Coord,
+    length: int,
+    forbidden_adj: set[Coord],
+) -> list[Coord] | None:
+    target_steps = int(length) - 1
+    used = {start}
+    path = [start]
+
+    def rec(cur: Coord, steps: int) -> list[Coord] | None:
+        dist = abs(cur[0] - end[0]) + abs(cur[1] - end[1])
+        remaining = target_steps - steps
+        if dist > remaining or ((remaining - dist) % 2 != 0):
+            return None
+        if steps == target_steps:
+            return path.copy() if cur == end else None
+
+        nbrs = list(neighbors4(*cur))
+        random.shuffle(nbrs)
+        for nr, nc in nbrs:
+            nxt = (nr, nc)
+            if not in_bounds(free.shape, nr, nc) or not free[nr, nc] or nxt in used:
+                continue
+            if nxt != end and nxt in forbidden_adj:
+                continue
+            used.add(nxt)
+            path.append(nxt)
+            found = rec(nxt, steps + 1)
+            if found is not None:
+                return found
+            path.pop()
+            used.remove(nxt)
+        return None
+
+    return rec(start, 0)
+
+
+def _sprite_patch_from_coords(coords: list[Coord], color: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        patch[r - r0, c - c0] = color
+    return patch, (r0, c0, r1, c1)
