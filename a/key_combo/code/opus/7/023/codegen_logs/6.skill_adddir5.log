+                if np.array_equal(cur, np.fliplr(cur)):
+                    continue
+                hole_sizes = sorted(len(comp) for comp in _components_from_mask(holes))
+                if not hole_sizes or any(size > 2 for size in hole_sizes):
+                    continue
+                variants.append(cur)
+    return variants
