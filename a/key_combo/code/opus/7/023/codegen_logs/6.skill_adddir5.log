def _gen_boxes_disjoint(a: tuple[int, int], b: tuple[int, int]) -> bool:
    ar, ac = a
    br, bc = b
    last = _GEN_BOX_SIZE - 1
    return ar + last < br or br + last < ar or ac + last < bc or bc + last < ac

@lru_cache(maxsize=None)
