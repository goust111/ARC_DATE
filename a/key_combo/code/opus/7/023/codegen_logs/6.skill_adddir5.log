+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _holes_mask(patch: np.ndarray) -> np.ndarray:
+    h, w = patch.shape
+    holes = (patch == BG)
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if holes[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if holes[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and holes[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return holes & ~outside
+
+
+def _make_patch(coords: np.ndarray, color: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    box = _bbox(coords)
+    r0, c0, r1, c1 = box
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    patch[coords[:, 0] - r0, coords[:, 1] - c0] = int(color)
