+def _padded_boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return _intervals_overlap(ar0 - pad, ar1 + pad, br0 - pad, br1 + pad) and _intervals_overlap(
+        ac0 - pad, ac1 + pad, bc0 - pad, bc1 + pad
+    )
