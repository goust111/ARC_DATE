                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not vis[nr,nc]:
                        vis[nr,nc]=True; q.append((nr,nc))
            out.append(cur)
    return out

def conn(mask):
    return len(comps(mask.astype(bool)))==1

