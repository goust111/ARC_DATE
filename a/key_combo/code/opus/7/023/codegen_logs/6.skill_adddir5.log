+import numpy as np
+
+
+BG = 0
+SEPARATOR = 5
+SOURCE_COLORS = (1, 2)
+HALO_COLORS = (3, 4, 6, 7, 8, 9)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+BASE_TEMPLATES = (
+    np.array(
