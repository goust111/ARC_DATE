+def _template_variants() -> list[np.ndarray]:
+    variants: list[np.ndarray] = []
+    for template in BASE_TEMPLATES:
+        for flip_ud in (False, True):
+            for flip_lr in (False, True):
+                cur = template.copy()
+                if flip_ud:
+                    cur = np.flipud(cur)
+                if flip_lr:
+                    cur = np.fliplr(cur)
+                if any(np.array_equal(cur, seen) for seen in variants):
