import numpy as np
from collections import deque

def holes(mask):
    g=np.array(mask,dtype=int)
    h,w=g.shape
    outside=np.zeros((h,w),dtype=bool)
    q=deque()
    for r in range(h):
        for c in (0,w-1):
            if g[r,c]==0 and not outside[r,c]:
                outside[r,c]=True; q.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if g[r,c]==0 and not outside[r,c]:
                outside[r,c]=True; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<h and 0<=nc<w and g[nr,nc]==0 and not outside[nr,nc]:
                outside[nr,nc]=True; q.append((nr,nc))
    return (g==0) & ~outside

def comps(mask):
    h,w=mask.shape
    vis=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or vis[r,c]:
                continue
            q=deque([(r,c)]); vis[r,c]=True; cur=[]
            while q:
                rr,cc=q.popleft(); cur.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
