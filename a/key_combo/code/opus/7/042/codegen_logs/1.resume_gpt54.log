+    outer_h = hole_h + 2
+    outer_w = hole_w + 2
+    placements = [(top, left) for top in range(n - outer_h + 1) for left in range(n - outer_w + 1)]
+    rng.shuffle(placements)
+    for top, left in placements:
+        frame = np.full((n, n), BLACK, dtype=int)
