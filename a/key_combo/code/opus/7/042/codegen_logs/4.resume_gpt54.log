+def _generate_candidate() -> np.ndarray | None:
+    height = random.randint(MIN_GRID_HEIGHT, MAX_GRID_HEIGHT)
+    width = random.randint(MIN_GRID_WIDTH, MAX_GRID_WIDTH)
+    grid = np.zeros((height, width), dtype=int)
