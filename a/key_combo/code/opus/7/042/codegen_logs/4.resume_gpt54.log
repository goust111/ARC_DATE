        # Also ensure it is not between the borders of the objects (padding=1)
        if check_between_objects(obj1=objects[0], obj2=objects[1], r=int(r), c=int(c), padding=1, background=bg):
            output_grid[int(r), int(c)] = Color.TEAL
    
    return output_grid


