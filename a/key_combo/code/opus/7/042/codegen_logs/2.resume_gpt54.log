+
+    erased = _apply_erasures(full, row_period, col_period, markers)
+    if erased is None:
+        return None
+
+    inp = erased.copy()
+    for r, c in markers:
+        inp[r, c] = MARKER
+
+    expected = _paint_marker_rays(full, markers)
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
