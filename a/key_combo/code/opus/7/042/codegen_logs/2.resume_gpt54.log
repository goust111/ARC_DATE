    else:
        for a in aliases:
            if a in kwargs:
                used = a
                break
    if used is None:
        return None, None
    val = kwargs.pop(used)
    names = [primary, *aliases]
    for n in names:
        if n != used and n in kwargs:
            raise TypeError(f"got multiple values for {primary}: {used} and {n}")
    return val, used


