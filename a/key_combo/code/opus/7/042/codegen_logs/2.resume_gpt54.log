+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    restored = _restore_pattern(g)
+    markers = [tuple(map(int, rc)) for rc in np.argwhere(g == MARKER)]
+    assert 2 <= len(markers) <= 3, "expected 2-3 markers"
