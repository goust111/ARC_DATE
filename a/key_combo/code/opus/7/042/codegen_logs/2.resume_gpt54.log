+def _pattern_residue_map(tile: np.ndarray) -> dict[tuple[int, int], int]:
+    return {
+        (r, c): int(tile[r, c])
+        for r in range(tile.shape[0])
+        for c in range(tile.shape[1])
+        if int(tile[r, c]) != BACKGROUND
+    }
