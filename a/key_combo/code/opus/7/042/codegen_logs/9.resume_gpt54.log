+    frame_patch = np.where(patch == color, color, BACKGROUND)
+    return {
+        "color": color,
+        "bbox": (r0, c0, r1, c1),
+        "frame_patch": frame_patch,
+        "marker_local": marker_local,
+        "hole_shape": inside.shape,
+    }
