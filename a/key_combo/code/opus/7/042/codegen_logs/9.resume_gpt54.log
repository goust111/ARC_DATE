+        or br1 + gap < ar0
+        or ac1 + gap < bc0
+        or bc1 + gap < ac0
+    )
+
+
+def _frame_candidates(grid: np.ndarray) -> list[dict]:
+    candidates = []
+    seen = np.zeros(grid.shape, dtype=bool)
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            value = int(grid[r, c])
+            if value in (BACKGROUND, MARKER) or seen[r, c]:
+                continue
