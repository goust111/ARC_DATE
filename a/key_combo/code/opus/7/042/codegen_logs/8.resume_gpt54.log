+
+
+BACKGROUND = 0
+TEMPLATE_COLOR = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MASK_SHAPE = (3, 3)
+GRID_HEIGHT_RANGE = (10, 15)
+GRID_WIDTH_RANGE = (12, 17)
+LEGEND_COUNT_RANGE = (3, 4)
+INSTANCE_COUNT_RANGE = (0, 2)
