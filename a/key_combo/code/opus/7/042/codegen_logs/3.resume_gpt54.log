+
+    for obj in _analyze_objects(body):
+        if not obj["holes"]:
+            continue
+        fill_color = int(mapping[obj["color"]])
+        for hole in obj["holes"]:
+            for r, c in hole:
+                out[r, c] = fill_color
+
+        for c, start_r in _hole_columns(obj["holes"]).items():
+            rr = start_r + 1
+            while rr < h and (rr, c) in obj["coord_set"]:
+                rr += 1
+            while rr < h and body[rr, c] == BLACK:
+                out[rr, c] = fill_color
+                rr += 1
