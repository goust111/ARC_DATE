+    for coords in _component_coords(body != BLACK):
+        color = int(body[coords[0][0], coords[0][1]])
+        holes = _enclosed_holes(body, coords)
+        objects.append(
+            {
+                "coords": coords,
+                "coord_set": set(coords),
+                "color": color,
+                "bbox": _bbox(coords),
+                "holes": holes,
+            }
