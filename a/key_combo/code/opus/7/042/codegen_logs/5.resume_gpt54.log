  67: def main(grid: np.ndarray) -> np.ndarray:
  68:     """
  69:     Copy colored control-ray ports from one rectangular sprite orientation to every matching transformed sprite.
  70: 
  71:     Input structure:
  72:     - bg is the most common color.
  73:     - Several dense 2-by-N or N-by-2 rectangular sprites are dihedral transforms of one template.
  74:     - Isolated single-pixel control markers sit on rays projected outward from the dominant long edge of some sprites.
  75: 
  76:     Rule:
  77:     - For each sprite, the active edge is the long side whose cells have the strongest same-color majority.
  78:     - A control marker seen first along an outward ray from an active-edge cell assigns its color to that template cell.
  79:     - On every transformed sprite, draw that assigned color outward from the corresponding active-edge cell through bg cells until blocked or out of bounds.
  80: 
  81:     Key insight:
  82:     - The marker positions are not absolute; they label cells of a shared rectangular template, then the labels follow each sprite's rotation/reflection.
  83:     """
  84:     g = np.asarray(grid, dtype=int)
  85:     bg = int(get_bg(g))
  86:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False)
  87: 
  88:     sprites_raw: list[dict] = []
  89:     markers: dict[tuple[int, int], int] = {}
  90:     for comp in comps:
  91:         r0, c0, r1, c1 = map(int, comp["bbox"])
  92:         h = r1 - r0 + 1
  93:         w = c1 - c0 + 1
  94:         area = int(comp["area"])
  95:         if area == 1:
  96:             r, c = map(int, comp["coords"][0])
