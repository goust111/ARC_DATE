+    source = np.zeros((q, q), dtype=int)
+    motif_fn = _motif_tie_blue if bool(np.random.randint(2)) else _motif_tie_red
+    motif = motif_fn(q)
+    for (r, c), color in motif.items():
+        source[r, c] = color
