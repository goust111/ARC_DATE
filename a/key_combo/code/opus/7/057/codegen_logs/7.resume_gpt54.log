+def frame_components(grid: np.ndarray, color: int) -> list[dict]:
+    frames: list[dict] = []
+    for coords in components_mask(grid == color):
+        if not is_rectangular_frame(coords):
+            continue
+        b = bbox_coords(coords)
+        area = (b[2] - b[0] + 1) * (b[3] - b[1] + 1)
