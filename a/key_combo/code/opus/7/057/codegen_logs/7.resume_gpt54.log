+            matched += 1
+        else:
+            if values != {BLACK}:
+                return False
+            unmatched += 1
+    return matched >= 2 and unmatched >= 1
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
