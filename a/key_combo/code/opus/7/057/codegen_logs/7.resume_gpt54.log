    for r, c in pts:
        degree = sum((r + dr, c + dc) in pts for dr, dc in GEN_DIRS4)
        if degree != 2:
            return None

def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("generate_input failed")

