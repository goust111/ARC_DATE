+def dihedral_signatures(mask: np.ndarray) -> set[tuple[tuple[int, ...], ...]]:
+    sigs: set[tuple[tuple[int, ...], ...]] = set()
+    for turns in range(4):
+        rotated = np.rot90(mask, turns)
