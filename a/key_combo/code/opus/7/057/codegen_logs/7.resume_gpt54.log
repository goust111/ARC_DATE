+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+PINK = 6
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_ATTEMPTS = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flatten())).most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def component_mask(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+    return mask
+
+
+def crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0, r1, c1 = bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def compress_mask(mask: np.ndarray) -> np.ndarray:
+    mask = crop_mask(np.asarray(mask, dtype=bool))
+    row_keep = [0]
+    for r in range(1, mask.shape[0]):
+        if not np.array_equal(mask[r], mask[r - 1]):
+            row_keep.append(r)
+    mask = mask[row_keep, :]
