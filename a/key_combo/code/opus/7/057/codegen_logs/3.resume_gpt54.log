+        blacks = remaining - sum(counts)
+        if blacks < 1:
+            continue
+        others = counts
+        break
+    if not others:
+        return None
+
+    colors = list(np.random.choice(CODE_PALETTE, size=matching_count + other_color_count, replace=False))
+    matching_colors = set(map(int, colors[:matching_count]))
