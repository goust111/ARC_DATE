    """Paint all components at their output positions."""
    out = np.full((H, W), bg, dtype=int)
    for comp in comps:
        paste(out, comp["pat"], comp["out_r0"], comp["c0"], transparent=bg)
    return out


def _derive_input(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray | None:
