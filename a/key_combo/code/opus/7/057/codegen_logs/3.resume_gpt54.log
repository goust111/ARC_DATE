+    start = (int(np.random.randint(size)), int(np.random.randint(size)))
+    mask[start] = True
+    while int(mask.sum()) < count:
+        frontier = {
+            cell
+            for r, c in np.argwhere(mask)
+            for cell in _neighbors4(int(r), int(c), size)
+            if not mask[cell]
