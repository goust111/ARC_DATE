+    matching_count = int(np.random.randint(1, max_matching + 1))
+
+    remaining = width - matching_count * damage_count
+    if remaining < 2:
+        return None
+
+    other_color_count = int(np.random.randint(1, min(3, len(CODE_PALETTE) - matching_count) + 1))
+    others: list[int] = []
+    attempts = 0
+    while attempts < 80:
