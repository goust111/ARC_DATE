    occupied = np.zeros((H, W), dtype=bool)
    order = list(range(len(comps)))
    _RNG.shuffle(order)
    order.sort(key=lambda i: comps[i]["h"] * comps[i]["w"], reverse=True)

    for i in order:
        comp = comps[i]
        h, c0 = comp["h"], comp["c0"]
        rows = [r for r in range(H - h + 1) if r != comp["out_r0"]]
        if not rows:
            rows = list(range(H - h + 1))
