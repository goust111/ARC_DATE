+    for _ in range(RETRY_LIMIT):
+        case = _build_case()
+        if case is None:
+            continue
+        inp, expected = case
+        try:
+            observed = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(observed, expected):
+            return inp
+    raise RuntimeError(f"generate_input failed after {RETRY_LIMIT} attempts")

