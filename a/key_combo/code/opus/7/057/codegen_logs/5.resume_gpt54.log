+        area = random.randint(min_area, max_area)
+        chosen = {random.choice(cells)}
+        while len(chosen) < area:
+            frontier = [
+                cell
+                for cell in cells
+                if cell not in chosen
+                and any(max(abs(cell[0] - r), abs(cell[1] - c)) == 1 for r, c in chosen)
