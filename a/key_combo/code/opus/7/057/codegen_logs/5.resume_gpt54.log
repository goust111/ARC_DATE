+def _link_graph(objects: list[dict]) -> tuple[list[list[int]], list[list[int]]]:
+    by_left: defaultdict[int, list[int]] = defaultdict(list)
+    for idx, obj in enumerate(objects):
+        by_left[int(obj["left"])].append(idx)
