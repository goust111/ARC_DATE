+    chain_ids: set[int] = set()
+    chains: list[list[int]] = []
+    for idx in range(len(objects)):
+        if preds[idx] or not succs[idx]:
+            continue
+        chain = [idx]
+        cur = idx
+        while succs[cur]:
+            nxt = succs[cur][0]
+            chain.append(nxt)
