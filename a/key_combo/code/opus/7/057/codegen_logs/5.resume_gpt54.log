+    for idx in isolated:
+        obj = objects[idx]
+        r0, c0, r1, c1 = obj["bbox"]
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        mask[obj["coords"][:, 0] - r0, obj["coords"][:, 1] - c0] = True
+        _paint_object(out, occupied, mask, r0, c0, RED)
