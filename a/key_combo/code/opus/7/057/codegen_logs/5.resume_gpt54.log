+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+GEN_ATTEMPTS = 500
+MASK_ATTEMPTS = 200
+LAYOUT_ATTEMPTS = 300
+ROW_GAP = 1
