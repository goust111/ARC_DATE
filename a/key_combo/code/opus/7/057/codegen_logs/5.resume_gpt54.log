+STRUCTURE_CASES = [
+    ((2, 2), 1),
+    ((2, 2), 2),
+    ((2, 2), 3),
+    ((2, 3), 0),
+    ((2, 3), 1),
+    ((2, 3), 2),
+    ((3, 3), 0),
+    ((3, 3), 1),
+    ((2, 2, 2), 0),
+    ((2, 2, 2), 1),
+    ((2, 2, 3), 0),
+]
+STRUCTURE_WEIGHTS = [2, 3, 1, 2, 3, 1, 2, 1, 1, 1, 1]
