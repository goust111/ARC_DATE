+        (-1, 0): 0,
+        (0, 1): 1,
+        (1, 0): 2,
+        (0, -1): 3,
+    }.get(direction, 4)
+    return (
+        _chebyshev(source, cell),
+        cardinal_priority,
+        _manhattan(source, cell),
+        cell[0],
+        cell[1],
+    )
+
+
