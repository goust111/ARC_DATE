+GRID_MIN_SIZE = 14
+GRID_MAX_SIZE = 18
+ANCHOR_COUNT_OPTIONS = (2, 3)
+SINGLETON_COUNT_OPTIONS = (4, 5)
+DISTANCE_OPTIONS = (2, 3, 4, 5)
