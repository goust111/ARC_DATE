+    grid = np.zeros((height, width), dtype=int)
+    for anchor in anchors:
+        for r, c in _anchor_cells(anchor):
+            grid[r, c] = GREY
+    for (r, c), color in placements:
+        if grid[r, c] != BACKGROUND:
+            return None
+        grid[r, c] = color
+
+    try:
+        output = main(grid)
+    except AssertionError:
+        return None
