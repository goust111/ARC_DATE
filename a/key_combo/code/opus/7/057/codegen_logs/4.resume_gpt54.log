+        if c < c0:
+            return (-1, -1)
+        if c > c1:
+            return (-1, 1)
+        return (-1, 0)
+    if r > r1:
+        if c < c0:
+            return (1, -1)
+        if c > c1:
+            return (1, 1)
+        return (1, 0)
+    return (0, -1) if c < c0 else (0, 1)
+
+
+def _frame_cells(anchor: BBox) -> list[Coord]:
+    r0, c0, r1, c1 = anchor
