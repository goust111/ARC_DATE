+def _bbox_chebyshev_gap(a: BBox, b: BBox) -> int:
+    if a[2] < b[0]:
+        dr = b[0] - a[2]
+    elif b[2] < a[0]:
+        dr = a[0] - b[2]
+    else:
+        dr = 0
+    if a[3] < b[1]:
+        dc = b[1] - a[3]
+    elif b[3] < a[1]:
+        dc = a[1] - b[3]
+    else:
+        dc = 0
+    return max(dr, dc)
