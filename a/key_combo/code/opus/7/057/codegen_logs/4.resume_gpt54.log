+    for r in range(r0 - 1, r1 + 2):
+        for c in range(c0 - 1, c1 + 2):
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
+            cells.append((r, c))
+    return cells
+
+
+def _target_sort_key(source: Coord, anchor: BBox, cell: Coord) -> tuple[int, int, int, int, int]:
+    direction = _frame_direction(anchor, cell)
