+def _vote_pairs_for_winner(winner: int) -> list[tuple[int, int]]:
+    _ = winner
+    return [(4, 2), (3, 2), (3, 1), (5, 2), (4, 1)]
+
+
+def _expected_output(grid: np.ndarray) -> tuple[np.ndarray, int, np.ndarray, np.ndarray]:
