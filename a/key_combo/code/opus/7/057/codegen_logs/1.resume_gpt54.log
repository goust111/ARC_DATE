        if return_format == "dict":
            out: list[dict] = []
            for col in colors_iter:
                mask = (grid == col)
                if not mask.any():
                    continue
                comps = components_mask(mask, connectivity=connectivity)
                for coords in comps:
                    if int(coords.shape[0]) < int(min_area):
                        continue
                    out.append(
                        {
                            "color": int(col),
                            "coords": coords,
                            "bbox": bbox_coords(coords),
                            "area": int(coords.shape[0]),
