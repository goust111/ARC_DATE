+        if len(solutions) >= max_solutions:
+            return
+        if not remaining:
+            solutions.append([placements[idx] for idx in chosen])
+            return
+
+        cell = min(
+            remaining,
+            key=lambda rc: sum(
+                1 for idx in cell_to_candidates[rc] if set(placements[idx]["cells"]) <= remaining
+            ),
