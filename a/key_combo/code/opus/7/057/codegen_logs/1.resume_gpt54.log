    return tuple(sorted((r + dr, c + dc) for r, c in cells))


def _touches(existing: set[tuple[int, int]], placed: set[tuple[int, int]]) -> bool:
    for r, c in placed:
        for dr, dc in NEIGHBORS4:
            if (r + dr, c + dc) in existing:
