+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+    GREY = 5
+    PINK = 6
+    ORANGE = 7
+    TEAL = 8
+    MAROON = 9
+
+
+Coord = tuple[int, int]
+ObjectSpec = dict[str, object]
+
+DRAW_COLORS = [Color.BLUE, Color.RED, Color.YELLOW, Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+GEN_RETRIES = 400
