+    for idx, (r, c) in enumerate(coords):
+        allowed = set()
+        if idx > 0:
+            allowed.add(coords[idx - 1])
+        if idx + 1 < len(coords):
+            allowed.add(coords[idx + 1])
+        if idx == 0:
+            allowed.add((pr, pc))
+        for rr, cc in _neighbors4(r, c):
+            if _in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == int(color):
