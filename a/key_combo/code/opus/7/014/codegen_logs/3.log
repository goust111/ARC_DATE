+        b_len = random.randint(2, 4)
+        mode = random.choice(("east", "west"))
+
+        if mode == "east":
+            a_dir = (-1, 0)
+            c_a_min = 2
+            c_a_max = width - a_len - min_long_ray - 2
+        else:
+            a_dir = (1, 0)
+            c_a_min = a_len + min_long_ray + 1
