+def _follow_segment(grid: np.ndarray, pivot: Coord, near: Coord, color: int) -> list[Coord]:
+    pr, pc = map(int, pivot)
+    nr, nc = map(int, near)
+    dr = nr - pr
+    dc = nc - pc
+    assert abs(dr) + abs(dc) == 1
