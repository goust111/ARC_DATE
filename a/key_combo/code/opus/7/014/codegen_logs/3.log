+
+
+def _cross_touches(cells_a: set[Coord], cells_b: set[Coord]) -> bool:
+    for r, c in cells_a:
+        if (r, c) in cells_b:
+            return True
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells_b:
