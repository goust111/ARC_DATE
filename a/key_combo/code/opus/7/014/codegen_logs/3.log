+    out = g.copy()
+    traces: list[dict[str, object]] = []
+    for obj in objects:
+        color = int(obj["color"])
+        for r, c in _rotated_cells(obj):
+            assert int(out[r, c]) == Color.BLACK, "rotated segment must land on background"
+            out[r, c] = color
