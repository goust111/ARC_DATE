    col_pos_by_half = {half: _gen_axis_positions(panel_w, half) for half in range(OUTPUT_SIDE)}
    if any(not row_pos_by_half[h] for h in range(OUTPUT_SIDE)) or any(not col_pos_by_half[h] for h in range(OUTPUT_SIDE)):
