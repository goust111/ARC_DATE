+            ray_len += 1
+            r += ray_dr
+            c += ray_dc
+
+        traces.append(
+            {
+                "pivot": obj["pivot"],
+                "color": color,
+                "length": int(obj["length"]),
+                "direction": obj["direction"],
+                "ray_direction": obj["rotated_direction"],
+                "ray_len": ray_len,
+                "stop_kind": stop_kind,
+                "stop_cell": stop_cell,
+            }
