    assert not np.any(outline & holes), "hole fill and outside outline must be disjoint"
    assert np.any(outline), "expected at least one outside outline cell"

    out = g.copy()
    out[outline] = Color.GREEN
    out[holes] = Color.YELLOW
    return out

