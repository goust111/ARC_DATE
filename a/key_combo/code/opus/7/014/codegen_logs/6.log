+    glyphs: dict[int, np.ndarray] = {}
+    for color in colors:
+        coords = np.argwhere(left == color)
+        box = bbox_coords(coords)
+        r0, c0, r1, c1 = box
+        assert r1 - r0 + 1 == 3 and c1 - c0 + 1 == 4, "dictionary entry must be label + 3x3 glyph"
