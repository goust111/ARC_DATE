+        top_end = (rmin, col)
+        bottom_end = (rmax, col)
+        top_touch = any(
+            0 <= nr < body_mask.shape[0] and 0 <= nc < body_mask.shape[1] and body_mask[nr, nc]
+            for nr, nc in _neighbors4(*top_end)
