+        sprite_r0 + body_local_bbox[0],
+        sprite_c0 + body_local_bbox[1],
+        sprite_r0 + body_local_bbox[2],
+        sprite_c0 + body_local_bbox[3],
+    )
+    r0, c0, r1, c1 = body_bbox
