+        dirs = [random.choice(("left", "right")), random.choice(("up", "down"))]
+        random.shuffle(dirs)
+        return dirs
+    return random.sample(DIR_ORDER, 3)
+
+
+def _sample_lengths(n: int) -> list[int]:
+    while True:
+        lengths = [random.randint(2, 4) for _ in range(n)]
+        if len(set(lengths)) >= 2:
+            return lengths
+
