+    body_bbox = (
+        sprite_r0 + body_local_bbox[0],
+        sprite_c0 + body_local_bbox[1],
+        sprite_r0 + body_local_bbox[2],
+        sprite_c0 + body_local_bbox[3],
+    )
+    r0, c0, r1, c1 = body_bbox
+    h, w = body_patch.shape
+    if direction == "right":
+        assert near_global == (h // 2 + 1, w), "tail must attach at the right midpoint"
+    elif direction == "left":
+        assert near_global == (h // 2 + 1, 1), "tail must attach at the left midpoint"
+    elif direction == "down":
+        assert near_global == (h, w // 2 + 1), "tail must attach at the bottom midpoint"
+    else:
+        assert near_global == (1, w // 2 + 1), "tail must attach at the top midpoint"
+
+    assert 2 <= length <= 4, "tail length must be between 2 and 4"
+    assert 4 <= int(body_mask.sum()) <= 8, "body size must be between 4 and 8"
