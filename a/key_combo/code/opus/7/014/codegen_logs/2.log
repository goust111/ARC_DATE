+    return {
+        "body_color": int(body_color),
+        "tail_color": int(tail_color),
+        "body_coords": body_coords,
+        "tail_coords": tail_coords,
+        "body_patch": body_patch,
+        "body_bbox": body_bbox,
+        "direction": direction,
+        "length": int(length),
+        "copy_top_left": (int(copy_r0), int(copy_c0)),
