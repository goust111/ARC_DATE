+    elif direction == "left":
+        assert near_global == (h // 2 + 1, 1), "tail must attach at the left midpoint"
+    elif direction == "down":
+        assert near_global == (h, w // 2 + 1), "tail must attach at the bottom midpoint"
+    else:
