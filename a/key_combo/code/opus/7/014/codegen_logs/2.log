+    bounds = []
+    for idx in order:
+        spec = specs[idx]
+        rows = [r for r, _ in spec["all_local_cells"]]
+        cols = [c for _, c in spec["all_local_cells"]]
+        min_r, max_r = min(rows), max(rows)
+        min_c, max_c = min(cols), max(cols)
+        bounds.append((idx, min_r, max_r, min_c, max_c))
