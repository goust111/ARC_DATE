+    for spec in specs:
+        r0, c0 = spec["top_left"]
+        body_patch = np.where(spec["body_patch"] != 0, spec["body_color"], 0).astype(int)
+        _paste(out, body_patch, r0, c0)
+        mirrored = np.fliplr(spec["body_patch"]) if spec["direction"] in ("left", "right") else np.flipud(spec["body_patch"])
