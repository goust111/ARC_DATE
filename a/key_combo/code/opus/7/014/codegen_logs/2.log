+        if not _place_specs(h, w, placed):
+            continue
+        inp = _render_input(h, w, placed)
+        expected = _render_output(h, w, placed)
+        if _semantic_checks(inp, expected, placed):
+            return inp
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
