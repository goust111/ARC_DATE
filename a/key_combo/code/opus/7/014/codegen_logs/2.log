+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BODY_COLORS = (1, 2, 3, 4)
+TAIL_COLORS = (7, 8, 9)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+DIR_ORDER = ("up", "down", "left", "right")
