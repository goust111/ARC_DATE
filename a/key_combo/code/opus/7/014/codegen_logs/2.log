+    elif direction == "left":
+        copy_r0, copy_c0 = r0, c0 - length - w
+    elif direction == "down":
+        copy_r0, copy_c0 = r1 + length + 1, c0
+    else:
+        copy_r0, copy_c0 = r0 - length - h, c0
