+def _orientation_from_tail(body_mask: np.ndarray, tail_coords: np.ndarray) -> tuple[str, int, tuple[int, int]]:
+    rows = sorted(set(map(int, tail_coords[:, 0])))
+    cols = sorted(set(map(int, tail_coords[:, 1])))
+    if len(rows) == 1:
