+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int = 0) -> None:
+    h, w = patch.shape
+    rr1 = r0 + h
+    cc1 = c0 + w
+    if r0 < 0 or c0 < 0 or rr1 > dst.shape[0] or cc1 > dst.shape[1]:
