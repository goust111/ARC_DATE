+
+def _orient_template(template: np.ndarray, direction: str) -> np.ndarray:
+    if direction == "right":
+        return template.copy()
+    if direction == "left":
+        return np.fliplr(template)
+    if direction == "down":
+        return np.rot90(template, k=3)
+    if direction == "up":
+        return np.rot90(template, k=1)
