+    if direction == "right":
+        assert near_global == (h // 2 + 1, w + 1), "tail must attach at the right midpoint"
+    elif direction == "left":
+        assert near_global == (h // 2 + 1, 0), "tail must attach at the left midpoint"
+    elif direction == "down":
+        assert near_global == (h + 1, w // 2 + 1), "tail must attach at the bottom midpoint"
+    else:
