+
+def _semantic_checks(inp: np.ndarray, expected: np.ndarray, specs: list[dict]) -> bool:
+    try:
+        actual, analyzed = _solve(inp)
+    except AssertionError:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+    if len(analyzed) != len(specs):
+        return False
