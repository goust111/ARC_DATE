+                if dilated & reserved:
+                    continue
+
+                spec["top_left"] = (r0, c0)
+                spec["tail_cells"] = [(r0 + r, c0 + c) for r, c in spec["tail_local"]]
+                spec["copy_top_left"] = (r0 + spec["copy_shift"][0], c0 + spec["copy_shift"][1])
+                reserved.update(dilated)
+                placed = True
+                break
+
+            if not placed:
+                success = False
+                break
+
+        if success:
+            return True
+
+    return False
