+def _render_fixed_gap_output(h: int, w: int, specs: list[dict], fixed_gap: int = 2) -> np.ndarray:
+    out = np.zeros((h, w), dtype=int)
+    for spec in specs:
+        r0, c0 = spec["top_left"]
+        body_patch = np.where(spec["body_patch"] != 0, spec["body_color"], 0).astype(int)
