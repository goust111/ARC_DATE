    # (independent ±3 jitter otherwise creates 1-cell bg notches in flat regions).
    cc_jit = np.convolve(
        np.array([random.randint(-3, 3) for _ in range(H)], dtype=float),
        np.ones(3) / 3, mode='same')
    w_jit = np.convolve(
        np.array([random.randint(-3, 3) for _ in range(H)], dtype=float),
        np.ones(3) / 3, mode='same')

    for r in range(H):
        c_left_param = centers[r] - half_w[r]
