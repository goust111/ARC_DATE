+    wrapped[0, :] = FRAME_COLOR
+    wrapped[-1, :] = FRAME_COLOR
+    wrapped[:, 0] = FRAME_COLOR
+    wrapped[:, -1] = FRAME_COLOR
+    wrapped[1:-1, 1:-1] = out
+    return wrapped
