+def _min_axis_period(mask: np.ndarray, axis: int) -> int:
+    n = int(mask.shape[axis])
+    for period in range(1, n + 1):
+        if axis == 0:
+            if np.array_equal(mask[period:, :], mask[:-period, :]):
+                return period
+        else:
+            if np.array_equal(mask[:, period:], mask[:, :-period]):
