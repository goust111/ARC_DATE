+
+def _sample_hole_rectangles(
+    outer_h: int,
+    outer_w: int,
+    hole_count: int,
+    orientation: str,
+    fracture_index: int,
+) -> list[tuple[int, int, int, int]] | None:
+    candidates: list[tuple[int, int, int, int]] = []
+    max_hole_h = min(2, outer_h - 2)
+    max_hole_w = min(2, outer_w - 2)
+    for hh in range(1, max_hole_h + 1):
