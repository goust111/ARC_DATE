+        out[coords[:, 0], coords[:, 1]] = color
+        for hole in obj["hole_coords"]:
+            out[hole[:, 0], hole[:, 1]] = color
+
+        axis = obj["expand_axis"]
+        if parallel_to_fracture:
+            axis = "vertical" if axis == "horizontal" else "horizontal"
+
+        if axis == "horizontal" and h > 0:
