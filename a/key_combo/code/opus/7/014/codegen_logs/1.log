+        objects.append(
+            {
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "color": color,
+                "hole_coords": hole_coords_global,
+                "hole_count": len(hole_components),
+                "expand_axis": "horizontal" if vertical else "vertical",
