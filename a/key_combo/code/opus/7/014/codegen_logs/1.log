+
+
+def _rects_intersect(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
+
+def _expanded_bbox(
+    top: int,
+    left: int,
+    patch: np.ndarray,
+    hole_count: int,
+    expand_axis: str,
+    shape: tuple[int, int],
