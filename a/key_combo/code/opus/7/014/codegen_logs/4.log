+
+def _dilate_chebyshev(mask: np.ndarray, radius: int) -> np.ndarray:
+    out = mask.copy()
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                nr = int(r) + dr
+                nc = int(c) + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out[nr, nc] = True
