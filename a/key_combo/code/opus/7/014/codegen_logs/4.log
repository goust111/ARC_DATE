    inp, out = _render_input_output(side, blocks, colors)
    return inp if np.array_equal(main(inp), out) else None

def generate_input():
    for _ in range(GENERATION_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 52fd389e input")

