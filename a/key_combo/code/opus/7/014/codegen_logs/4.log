+            continue
+        for hr, hc in hole_cells:
+            canvas[r0 + hr, c0 + hc] = False
+        if hole_count == 0:
+            notch = random.choice(
+                [
+                    (r0, c0),
+                    (r0, c0 + base_w - 1),
+                    (r0 + base_h - 1, c0),
+                    (r0 + base_h - 1, c0 + base_w - 1),
+                ]
+            )
+            canvas[notch] = False
+        if not _shape_quality(canvas, hole_count):
+            continue
