+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_instance()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid topology-palette outline/fill instance")

