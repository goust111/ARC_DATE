+def _shape_quality(mask: np.ndarray, hole_count: int) -> bool:
+    if not mask.any():
+        return False
+    if not _foreground_connected(mask):
+        return False
+    area = int(mask.sum())
+    if not 12 <= area <= 30:
+        return False
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    bh = r1 - r0 + 1
+    bw = c1 - c0 + 1
+    if bh < 4 or bw < 4 or bh > 7 or bw > 7:
