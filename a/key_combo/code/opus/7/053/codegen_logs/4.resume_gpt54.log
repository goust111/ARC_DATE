# Canvas and rectangle geometry.
BACKGROUND_COLOR = 0
GRID_HEIGHT_RANGE, GRID_WIDTH_RANGE = (13, 19), (13, 18)
RECT_HEIGHT_RANGE, RECT_WIDTH_RANGE = (8, 13), (11, 14)
RECT_MARGIN, FRAME_WIDTH, MARKER_DEPTH = 1, 2, 1

# Marker structure.
