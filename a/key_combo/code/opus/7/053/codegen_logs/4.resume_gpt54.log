+            assert c in (c0 - 1, c1 + 1), "horizontal leaf must sit beside the rectangle"
+            rows.add(r)
+        else:
+            assert r in (r0 - 1, r1 + 1), "vertical leaf must sit above or below the rectangle"
+            cols.add(c)
+
+    return rows, cols, leaves
+
