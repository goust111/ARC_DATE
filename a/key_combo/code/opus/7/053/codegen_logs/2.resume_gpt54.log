+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+KEY_COLORS = [4, 5, 6, 7, 8, 9]
+
+FRAME_COUNT_RANGE = (3, 5)
+FRAME_INNER_H_RANGE = (3, 5)
+FRAME_INNER_W_RANGE = (3, 5)
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (18, 28)
+MAX_ATTEMPTS = 400
+MIN_GAP = 1
