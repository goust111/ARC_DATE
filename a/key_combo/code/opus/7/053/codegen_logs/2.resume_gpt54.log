        patches.append(patch)
    return patches


def _gen_attempt():
    height = random.randint(*GEN_CANVAS_ROW_RANGE)
    width = random.randint(*GEN_CANVAS_COL_RANGE)
    color = random.choice(GEN_FOREGROUND_COLORS)
    count = random.choice(GEN_CYCLE_COUNTS)
