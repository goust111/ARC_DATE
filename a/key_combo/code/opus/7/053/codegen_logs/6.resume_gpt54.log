  "type": "symmetry/pattern",
  "src": "rough two-color nested foreground drawing: closed frame objects and small blob objects",
  "dst": "canonical frame-and-dot diagram preserving containment and sibling row/column order",
  "transform": "replace each blob by one pixel; replace each frame by a rectangular border padded around its direct children; keep outside blobs outside the enclosing frame",
  "grid_shape": "canonical crop; root-level outside blobs occupy a 3x3 bg slot"
}
</annotation>
<generation_spec>
