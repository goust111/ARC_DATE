+
+def _crop_non_bg(grid: np.ndarray, bg: int = BG) -> np.ndarray:
+    coords = np.argwhere(grid != bg)
+    if coords.size == 0:
+        return np.zeros((1, 1), dtype=int)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
