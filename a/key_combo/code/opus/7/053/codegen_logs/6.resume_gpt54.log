+        nodes.append(
+            SolverNode(
+                coords=coords,
+                center=(float(coords[:, 0].mean()), float(coords[:, 1].mean())),
+                area=int(coords.shape[0]),
+                holes=holes,
+                is_frame=bool(holes),
