+    holes_local = (~local) & (~outside)
+    holes: list[np.ndarray] = []
+    for hole_coords in _components(holes_local):
+        full = np.zeros(shape, dtype=bool)
+        full[hole_coords[:, 0] + r0, hole_coords[:, 1] + c0] = True
+        holes.append(full)
+    return holes
