+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if out.ndim != 2 or max(out.shape) > 30:
+        return None
+    if len(np.unique(grid)) < 3:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
