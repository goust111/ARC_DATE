+from collections import deque
+from dataclasses import dataclass, field
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+LEGEND_PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 400
