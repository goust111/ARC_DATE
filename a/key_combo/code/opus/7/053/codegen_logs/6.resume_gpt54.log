+    children = sorted(node.children, key=_node_sort_key)
+    if not children:
+        out = np.zeros((5, 5), dtype=int)
+        out[0, :] = color
+        out[-1, :] = color
+        out[:, 0] = color
+        out[:, -1] = color
+        return out
