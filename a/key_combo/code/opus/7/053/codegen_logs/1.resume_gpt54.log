+def _layered_output(colors: list[int]) -> np.ndarray:
+    n = len(colors)
+    side = 2 * n if n % 2 == 0 else 2 * n - 1
+    out = np.empty((side, side), dtype=int)
+    for layer, color in enumerate(colors):
+        out[layer : side - layer, layer : side - layer] = int(color)
+    return out
