+    for _ in range(120):
+        cells = set(required)
+        while len(cells) < area:
+            frontier = set()
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < panel_size and 0 <= nc < panel_size and (nr, nc) not in cells:
