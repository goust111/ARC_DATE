+        if len(cells) != area:
+            continue
+        mask = np.zeros((panel_size, panel_size), dtype=bool)
+        for r, c in cells:
+            mask[r, c] = True
+        if not _is_connected(mask):
+            continue
+        if not _is_rotationally_asymmetric(mask):
+            continue
+        r0, c0, r1, c1 = _bbox(mask)
+        if r1 == r0 or c1 == c0:
