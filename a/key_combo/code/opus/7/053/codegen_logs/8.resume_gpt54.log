+def _aligned_pair_count(frames: list[dict[str, Any]]) -> int:
+    count = 0
+    for i, first in enumerate(frames):
+        for second in frames[i + 1 :]:
+            if first["center_row2"] == second["center_row2"] or first["center_col2"] == second["center_col2"]:
+                count += 1
+    return count
