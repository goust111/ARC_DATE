+import numpy as np
+
+
+BLACK = 0
+RED = 2
+ORANGE = 7
+FRAME_COLOR_POOL = (1, 3, 4, 5, 6, 8, 9)
+FRAME_SIZE_CHOICES = (5, 7)
+MAX_GENERATION_ATTEMPTS = 400
