+                top, bottom = sorted((first, second), key=lambda frame: frame["box"][0])
+                anchor = min(
+                    (first, second),
+                    key=lambda frame: (_distance_to_topleft2(frame), frame["box"]),
+                )
+                _draw_vertical_bridge(out, top, bottom, majority_by_box[anchor["box"]])
