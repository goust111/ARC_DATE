+    gap_cols: list[int],
+    gap_source_cols: list[int],
+    source_rows: dict[int, int],
+) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    grid[guide_row, GUIDE_MARGIN : width - GUIDE_MARGIN] = ORANGE
