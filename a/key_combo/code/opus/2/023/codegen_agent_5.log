+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+ORANGE = 7
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= int(r) < h and 0 <= int(c) < w
