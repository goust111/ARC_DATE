+        grid[guide_row, c] = BG
+
+    for row, c0, c1 in wall_segments:
+        grid[row, c0 : c1 + 1] = GREY
+
+    for c in success_cols + gap_source_cols:
+        grid[source_rows[c], c] = RED
+
