+
+def _assign_source_rows(
+    guide_row: int, first_wall_row: int, source_cols: list[int]
+) -> dict[int, int] | None:
+    row_lo = guide_row + 2
+    row_hi = first_wall_row - 2
+    if row_lo > row_hi:
+        return None
