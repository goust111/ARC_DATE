+    n = out.shape[0]
+    inset = (n - int(size)) // 2
+    lo = inset
+    hi = n - inset - 1
+    if lo == hi:
+        out[lo, lo] = int(color)
+        return
+    out[lo, lo : hi + 1] = int(color)
+    out[hi, lo : hi + 1] = int(color)
+    out[lo : hi + 1, lo] = int(color)
+    out[lo : hi + 1, hi] = int(color)
