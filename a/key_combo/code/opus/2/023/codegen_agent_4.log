+def _sample_block_counts() -> list[int]:
+    roll = random.random()
+    if roll < 0.35:
+        return [1, 2, 3]
+    if roll < 0.70:
+        return list(random.choice(((1, 2, 4), (1, 3, 4), (2, 3, 4))))
+    return [1, 2, 3, 4]
+
