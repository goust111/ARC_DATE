+            "blocks": 0,
+            "components": 0,
+            "pixels": 0,
+            "fragments": [],
+        }
+
+    for component in find_components(
+        np.asarray(grid, dtype=int),
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
