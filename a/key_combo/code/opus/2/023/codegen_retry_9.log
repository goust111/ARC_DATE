+from __future__ import annotations
+
+import random
+from collections import Counter, defaultdict, deque
+
+import numpy as np
+
+
+COLOR_TO_EDGE = {
+    1: "left",
+    2: "right",
+    3: "top",
+    4: "bottom",
+}
+EDGE_ORDER = ("left", "right", "top", "bottom")
+SPRITE_SIZE = 3
+PADDED_SIZE = 5
+BG = 0
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _intervals_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return not (a1 < b0 or b1 < a0)
+
+
+def _boxes_touch_or_overlap(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    *,
+    padding: int = 1,
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + padding < br0
+        or br1 + padding < ar0
+        or ac1 + padding < bc0
+        or bc1 + padding < ac0
+    )
+
+
+def _mask_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors8(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(coords)
+
+
+def _find_components(grid: np.ndarray, colors: set[int]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    seen = np.zeros(g.shape, dtype=bool)
+    comps: list[dict] = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors8(rr, cc):
+                    if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                    "area": int(len(cells)),
+                }
+            )
+    return comps
+
+
+def _build_sprite_masks() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for bits in range(1, 1 << 9):
+        if bits == (1 << 9) - 1:
+            continue
+        flat = np.array([(bits >> i) & 1 for i in range(9)], dtype=bool)
+        mask = flat.reshape(3, 3)
+        coords = np.argwhere(mask)
