def _gen_visible_overlap_count(boxes: list[VisibleBox]) -> int:
    total = 0
    for i in range(len(boxes)):
        for j in range(i + 1, len(boxes)):
            total += int(_gen_inclusive_boxes_overlap(boxes[i], boxes[j]))
    return total


def _gen_valid_positions(
    side: int,
