+def _bbox_h(box: BBox) -> int:
+    return int(box[2] - box[0] + 1)
+
+
+def _bbox_w(box: BBox) -> int:
+    return int(box[3] - box[1] + 1)
+
+
+def _bbox_area(box: BBox) -> int:
+    return _bbox_h(box) * _bbox_w(box)
