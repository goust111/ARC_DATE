from collections import deque
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/2/023/7.py')
mod = SourceFileLoader('arc7_verify', str(p)).load_module()


def find_components(grid):
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            color = int(g[r, c])
            if color == 0 or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            rows = [rr for rr, _ in coords]
            cols = [cc for _, cc in coords]
            comps.append({
                'color': color,
                'area': len(coords),
                'top': min(rows),
                'left': min(cols),
                'bbox_h': max(rows) - min(rows) + 1,
                'bbox_w': max(cols) - min(cols) + 1,
            })
    return comps


def expected_output(grid):
    comps = find_components(grid)
    width = max(comp['area'] for comp in comps)
    out = np.zeros((len(comps), width), dtype=int)
    ordered = sorted(comps, key=lambda comp: (-comp['area'], comp['top']))
    for r, comp in enumerate(ordered):
        left = (width - comp['area']) // 2
        out[r, left:left + comp['area']] = comp['color']
    return out, comps

# Independent semantic verification on many generated samples.
for i in range(200):
