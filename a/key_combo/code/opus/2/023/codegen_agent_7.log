+
+def _transform_cells(cells: set[Coord]) -> tuple[Coord, ...]:
+    transforms = (
+        lambda r, c: (r, c),
+        lambda r, c: (r, -c),
+        lambda r, c: (-r, c),
+        lambda r, c: (-r, -c),
+        lambda r, c: (c, r),
+        lambda r, c: (c, -r),
+        lambda r, c: (-c, r),
+        lambda r, c: (-c, -r),
+    )
+    transform = random.choice(transforms)
+    return _normalize_cells({transform(r, c) for r, c in cells})
