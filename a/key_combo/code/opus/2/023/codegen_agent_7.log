+    out_w = max(areas)
+    out = np.zeros((out_h, out_w), dtype=int)
+
+    for out_r, comp in enumerate(_sorted_components(components)):
+        length = int(comp["area"])
+        color = int(comp["color"])
+        left = (out_w - length) // 2
+        out[out_r, left : left + length] = color
+
+    return out
