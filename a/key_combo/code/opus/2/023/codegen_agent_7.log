grid_a[1:4, 1] = 2
grid_a[3, 2] = 2
grid_a[1, 7:10] = 3
grid_a[2, 7] = 3
grid_a[7, 2:5] = 4
grid_a[8, 3] = 4

grid_b = np.zeros((12, 12), dtype=int)
grid_b[8, 8:11] = 2
grid_b[7, 10] = 2
grid_b[3:5, 2] = 3
grid_b[4, 3:5] = 3
grid_b[1:3, 7:9] = 4

out_a = mod.main(grid_a)
out_b = mod.main(grid_b)
