+    h, w = patch.shape
+    gh, gw = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > gh or c0 + w > gw:
+        return False
+
+    for pr, pc in np.argwhere(patch != 0):
+        rr = r0 + int(pr)
+        cc = c0 + int(pc)
+        if int(grid[rr, cc]) != 0:
+            return False
+        rr0 = max(0, rr - 1)
+        rr1 = min(gh, rr + 2)
+        cc0 = max(0, cc - 1)
+        cc1 = min(gw, cc + 2)
+        if np.any(grid[rr0:rr1, cc0:cc1] != 0):
+            return False
