            lambda hh, ww, nn: _gen_row_l_bboxes(hh, ww),
        ])
    if not layouts:
        return None
    return random.choice(layouts)(h, w, n)


def _gen_bounded_counts(n, total, count_range):
    lo, hi = count_range
