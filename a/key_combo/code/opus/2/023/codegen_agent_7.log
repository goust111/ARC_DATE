+    arr = np.array(cells, dtype=int)
+    box = _bbox_coords(arr)
+    patch = np.zeros((_bbox_h(box), _bbox_w(box)), dtype=int)
+    for r, c in cells:
+        patch[int(r), int(c)] = int(color)
+    return patch
