+OBSTACLE_COLOR = Color.GREY
+BACKGROUND_COLOR = Color.BLACK
+HORIZONTAL_STAMP = Color.GREEN
+VERTICAL_STAMP = Color.BLUE
+BOTH_STAMP = Color.YELLOW
+
+STATUS_TO_FLAGS = {
+    "horizontal": (True, False),
+    "vertical": (False, True),
+    "both": (True, True),
+    "none": (False, False),
+}
