            grid[r, block_c] = OBSTACLE_COLOR
            if block_c in row_block_pool:
                row_block_pool.remove(block_c)
        if not vertical:
            choices = col_block_pool or spare_rows
            block_r = _pick_block_coordinate(choices, r)
