MIN_CROSS_SIZE, LARGE_CROSS_SIZE_MIN = 5, 11
LARGE_CROSS_MARGIN, SMALL_CROSS_MARGIN = 5, 2
OUTPUT_SLOT_RANGE = (6, 12)
MIN_SLOTS_PER_SIDE = 2
SOURCE_COUNT_RANGE = (11, 15)
ERASED_SOURCE_RANGE = (3, 7)
SIDE_A, SIDE_B = -1, 1

