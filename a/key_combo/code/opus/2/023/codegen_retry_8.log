+    random.shuffle(candidates)
+    chosen: list[Coord] = []
+    for r, c in candidates:
+        if any(max(abs(r - rr), abs(c - cc)) <= 1 for rr, cc in chosen):
+            continue
+        chosen.append((r, c))
+        if len(chosen) == count:
+            return chosen
+    return None
+
