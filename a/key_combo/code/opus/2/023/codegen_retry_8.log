+    if distractor_positions is None:
+        distractor_positions = _pick_spaced_points(loose[:], len(active_colors))
+    if distractor_positions is None:
+        return None
+    distractors = [
+        (r, c, color)
+        for (r, c), color in zip(distractor_positions, active_colors)
+    ]
