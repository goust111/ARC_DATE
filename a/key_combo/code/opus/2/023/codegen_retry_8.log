+        grid[r0, c] = color
+
+    for marker in active_by_region:
+        if marker is None:
+            continue
+        r, c, color = marker
+        grid[r, c] = color
+
+    for r, c, color in distractors:
+        grid[r, c] = color
+
+    return grid
+
