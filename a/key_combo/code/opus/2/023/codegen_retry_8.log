+    h, w = shape
+    r0, c0, r1, c1 = frame_box
+    strict: list[Coord] = []
+    loose: list[Coord] = []
+    for r in range(h):
+        for c in range(w):
+            if r0 <= r <= r1 and c0 <= c <= c1:
+                continue
+            loose.append((r, c))
+            if not (r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1):
+                strict.append((r, c))
