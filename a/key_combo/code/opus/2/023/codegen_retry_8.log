+    r0, _c0, r1, _c1 = frame_box
+    for c, color in zip(split_cols, split_colors):
+        out[r0 : r1 + 1, c] = color
+
+    for marker, (left, right) in zip(active_markers, regions):
+        if marker is None:
+            continue
+        _mr, _mc, color = marker
+        region = out[r0 + 1 : r1, left : right + 1]
+        region[region == Color.BLACK] = color
