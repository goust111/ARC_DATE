+    out[~a_mask & ~b_mask & c_mask] = panel_colors[2]
+    out[a_mask & b_mask & ~c_mask] = PAIR_MAP[panel_colors[1]]
+    out[a_mask & ~b_mask & c_mask] = PAIR_MAP[panel_colors[2]]
+    out[~a_mask & b_mask & c_mask] = PAIR_MAP[panel_colors[2]]
