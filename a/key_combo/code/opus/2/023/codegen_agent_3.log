+
+BBox = tuple[int, int, int, int]
+
+
+def _ring_coords(box: BBox) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = map(int, box)
+    coords: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
+        coords.add((r0, c))
+        coords.add((r1, c))
+    for r in range(r0, r1 + 1):
+        coords.add((r, c0))
+        coords.add((r, c1))
+    return coords
+
