+    ready = [color for color, deg in indegree.items() if deg == 0]
+    order: list[int] = []
+    while ready:
+        assert len(ready) == 1, "occlusion order must be uniquely linear"
+        top = ready.pop()
+        order.append(int(top))
+        for lower in sorted(above[top]):
+            indegree[lower] -= 1
+            if indegree[lower] == 0:
+                ready.append(int(lower))
