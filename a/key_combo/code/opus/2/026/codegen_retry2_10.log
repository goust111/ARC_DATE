+def _find_separator(grid: np.ndarray) -> int:
+    cols = np.where(np.all(grid == YELLOW, axis=0))[0]
+    if len(cols) != 1:
+        raise AssertionError("expected exactly one full-height yellow separator column")
+    return int(cols[0])
+
