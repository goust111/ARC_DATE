        if sym_src is not None:
            if np.all(dst[sym_src != 0] == sym_src[sym_src != 0]):
                fill_cols = sorted(set(int(x) for x in dst[sym_src == 0].ravel() if int(x) != 0))
                if len(fill_cols) <= 1:
                    fill_col = fill_cols[0] if fill_cols else None
                    ok = True
