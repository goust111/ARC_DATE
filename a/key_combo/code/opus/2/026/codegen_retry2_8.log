        masked = pattern.copy()
        masked[r0 : r1 + 1, c0 : c1 + 1] = MASK_COLOR
        if _valid_instance(pattern, masked, period, rect):
            return masked

    raise RuntimeError(f"failed to generate a valid input after {GEN_ATTEMPTS} attempts")

