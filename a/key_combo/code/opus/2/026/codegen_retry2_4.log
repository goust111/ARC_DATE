+    g = np.asarray(grid, dtype=int)
+    frames, rays, _indegrees, degrees = _analyze_grid(g)
+
+    out = g.copy()
+    for ray in rays:
+        for r, c in ray["path"]:
+            out[r, c] = RAY
+
+    for frame, degree in zip(frames, degrees):
+        r0, c0, r1, c1 = frame["bbox"]
+        out[r0 + 1 : r1, c0 + 1 : c1] = _degree_color(degree)
+
+    return out
