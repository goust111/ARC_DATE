+    col0 = 0
+    col1 = col0 + sizes["A"] + gap_ab
+    col2 = col1 + sizes["B"] + gap_bc
+    bottom_row = top_row + max(sizes["A"], sizes["B"], sizes["C"]) + gap_vertical
+
