def overlaps(a,b):
    ar0,ac0,h,w=a; br0,bc0,h2,w2=b
    ar1=ar0+h-1; ac1=ac0+w-1; br1=br0+h2-1; bc1=bc0+w2-1
    return not (ar1<br0 or br1<ar0 or ac1<bc0 or bc1<ac0)

def adjacent(a,b):
    ar0,ac0,h,w=a; br0,bc0,h2,w2=b
    ar1=ar0+h-1; ac1=ac0+w-1; br1=br0+h2-1; bc1=bc0+w2-1
    return not (ar1+1<br0 or br1+1<ar0 or ac1+1<bc0 or bc1+1<ac0)

def trace(src,target,others):
    srect=src
    trect=target
    tb=border_cells(trect)
    occ=set()
    for o in others:
        occ|=border_cells(o)
        # include full bbox as blocking
        r0,c0,h,w=o; r1=r0+h-1; c1=c0+w-1
        occ|={(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)}
    # src full bbox too except gap may be removed but block irrelevant forward
    for gap,(dr,dc) in noncorner_gaps(srect):
        r,c=gap
        path=[]
