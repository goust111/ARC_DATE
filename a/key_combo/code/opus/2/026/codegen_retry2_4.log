rects=[(r,c,4,4) for r in coords for c in coords]

def border_cells(rect):
    r0,c0,h,w=rect
    r1=r0+h-1; c1=c0+w-1
    return {(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1) if r in (r0,r1) or c in (c0,c1)}

def noncorner_gaps(rect):
    r0,c0,h,w=rect
    r1=r0+h-1; c1=c0+w-1
    out=[]
    for c in range(c0+1,c1): out.append(((r0,c),(-1,0)))
    for c in range(c0+1,c1): out.append(((r1,c),(1,0)))
    for r in range(r0+1,r1): out.append(((r,c0),(0,-1)))
    for r in range(r0+1,r1): out.append(((r,c1),(0,1)))
