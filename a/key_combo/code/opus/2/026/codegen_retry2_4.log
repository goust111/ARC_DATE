            if (r,c) in tb and (r,c)"'!=gap:
                break
            # if current cell beyond source gap? path paints current background cell including gap, stop before stepping into target border
            if (r,c)!=gap and (r,c) in occ:
                path=None; break
            path.append((r,c))
            nr,nc=r+dr,c+dc
            if (nr,nc) in tb:
                return gap,(dr,dc),tuple(path)
            if not (0<=nr<20 and 0<=nc<20):
                path=None; break
            if (nr,nc) in occ:
                path=None; break
            r,c=nr,nc
    return None

for n in (3,4):
    found=0
    for chosen in combinations(rects,n):
        if any(overlaps(a,b) or adjacent(a,b) for a,b in combinations(chosen,2)):
