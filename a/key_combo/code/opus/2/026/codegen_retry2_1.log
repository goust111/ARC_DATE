+                        break
+                    if (int(row), int(col)) in protected:
+                        ok = False
+                        break
+                    if (int(row - 1), int(col)) in placed_cells or (int(row + 1), int(col)) in placed_cells:
+                        ok = False
+                        break
+                if ok:
+                    candidates.append((int(start), int(end), covered))
