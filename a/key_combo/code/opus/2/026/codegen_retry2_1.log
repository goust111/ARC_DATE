+
+
+def _validate_generated(grid: np.ndarray, meta: dict) -> bool:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    if g.ndim != 2 or max(h, w) > 30:
+        return False
+    if np.argwhere(g == GREY).shape[0] != 1:
+        return False
+    if not _blue_segments_valid(g):
+        return False
+
