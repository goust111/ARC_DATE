+    assert bool(blue_only.any()), "output must contain blue-only halo cells"
+    assert bool(np.all(actual[sep_row, :] == YELLOW))
+    assert int(np.count_nonzero(actual == GREEN)) == int(np.count_nonzero(green_cells))
+
