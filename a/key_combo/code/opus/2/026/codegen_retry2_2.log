+def _render_from_groups(shape: tuple[int, int], sep_row: int, red_markers: list[Coord], blue_markers: list[Coord]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    out[int(sep_row), :] = YELLOW
