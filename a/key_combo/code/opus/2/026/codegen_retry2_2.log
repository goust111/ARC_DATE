+        r1 = min(height - 1, int(r) + HALO_RADIUS)
+        c0 = max(0, int(c) - HALO_RADIUS)
+        c1 = min(width - 1, int(c) + HALO_RADIUS)
+        halo[r0 : r1 + 1, c0 : c1 + 1] = True
+    halo[int(sep_row), :] = False
+    return halo
+
