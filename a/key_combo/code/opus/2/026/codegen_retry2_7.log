+    return mapped, proto_vertices, edges
+
+
+def _segment_lengths(mapped: dict[tuple[int, int], tuple[int, int]], edges) -> list[int]:
+    lengths: list[int] = []
+    for a, b in edges:
+        r0, c0 = mapped[a]
+        r1, c1 = mapped[b]
+        lengths.append(abs(r1 - r0) + abs(c1 - c0) - 1)
+    return lengths
