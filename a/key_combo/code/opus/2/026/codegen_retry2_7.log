+    raise ValueError("unknown transform variant")
+
+
+_BASE_SHAPES = (
+    ((0, 0), (0, 4), (4, 4), (4, 0)),
+    ((0, 0), (0, 4), (2, 4), (2, 0), (4, 0)),
+    ((0, 0), (0, 4), (4, 4), (4, 0), (2, 0)),
+)
+
+
+def _choose_template() -> list[tuple[int, int]]:
