+def _prototype_edges(red_mask: np.ndarray, vertices: list[tuple[int, int]]) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    vertex_set = set(vertices)
+    edges: set[tuple[tuple[int, int], tuple[int, int]]] = set()
+    for vr, vc in vertices:
