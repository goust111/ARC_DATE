    vertices: list[tuple[int, int]] = []
    for r, c in pts:
        neigh = _neighbors4(red_mask, r, c)
        degree = len(neigh)
        if degree != 2:
            vertices.append((r, c))
            continue
        (r1, c1), (r2, c2) = neigh
        if r1 == r2 or c1 == c2:
            continue
        vertices.append((r, c))
