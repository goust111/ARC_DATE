+        return r, c
+    if variant == 1:
+        return r, last - c
+    if variant == 2:
+        return last - r, c
+    if variant == 3:
+        return last - r, last - c
+    if variant == 4:
+        return c, r
+    if variant == 5:
+        return last - c, r
+    if variant == 6:
