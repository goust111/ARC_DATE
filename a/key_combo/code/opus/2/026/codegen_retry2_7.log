+
+def _parse_task(grid: np.ndarray):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    sep = _full_separator_col(g)
+    left = g[:, :sep]
+    right = g[:, sep + 1 :]
