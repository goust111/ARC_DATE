            return x.copy()

        if kind == "invert0":
            y = x.copy()
            m0 = x == 0
            mv = x == v
            y[m0] = v
            y[mv] = 0
            return y

        if kind == "endpoints":
            coords = np.argwhere(x == v)
            S = set((int(r), int(c)) for r, c in coords)
            keep = np.zeros_like(x, dtype=bool)
