                deg = 0
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        if dr == 0 and dc == 0:
                            continue
                        if (r + dr, c + dc) in S:
                            deg += 1
                if deg <= 1:
                    keep[r, c] = True
            y = x.copy()
            y[x == v] = 0
            y[keep] = v
