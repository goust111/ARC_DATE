+    g = np.asarray(grid, dtype=int)
+    assert g.shape == (GRID_SIZE, GRID_SIZE), "expected a 9x9 grid"
+    assert int(g[CENTER]) == CENTER_COLOR, "expected a grey pivot at the center"
