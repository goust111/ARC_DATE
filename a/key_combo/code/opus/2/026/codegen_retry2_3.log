        best = max(
            candidates,
            key=lambda a: sum((a + t) % row_period not in high_residues for t in uncovered),
        )
        chosen.append(int(best))
        uncovered = {
            t for t in uncovered if (best + t) % row_period in high_residues
        }
    return chosen


