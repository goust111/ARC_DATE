+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+FRAME_SIZE = 5
+INNER_SIZE = 3
+BACKGROUND = 0
+SPRITE_COLORS = (1, 3)
+BORDER_COLORS = (2, 4, 5, 6, 7, 8, 9)
+GRID_MIN = 18
+GRID_MAX = 24
