        if v is not None:
            coords = np.argwhere(src == v)
            S = set((int(r), int(c)) for r, c in coords)
            keep = np.zeros_like(src, dtype=bool)
            for r, c in S:
                deg = 0
                for dr in (-1, 0, 1):
                    for dc in (-1, 0, 1):
                        if dr == 0 and dc == 0:
                            continue
                        if (r + dr, c + dc) in S:
                            deg += 1
                if deg <= 1:
                    keep[r, c] = True
            pred = src.copy()
            pred[src == v] = 0
            pred[keep] = v
            if np.array_equal(pred, dst):
                return ("endpoints", {"stable": st})

            pred = src.copy()
            h, w = pred.shape
