+    arr = np.asarray(sprite, dtype=int)
+    if name == "rotate_cw":
+        return np.rot90(arr, -1).copy()
+    if name == "rotate_ccw":
+        return np.rot90(arr, 1).copy()
+    if name == "flip_horizontal":
+        return np.fliplr(arr).copy()
+    if name == "flip_vertical":
+        return np.flipud(arr).copy()
+    if name == "rotate_180":
+        return np.rot90(arr, 2).copy()
