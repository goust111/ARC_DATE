+def _build_vertical_case() -> np.ndarray | None:
+    (h0, w0), (h1, w1) = random.choice(SHAPES), random.choice(SHAPES)
+    H = random.randint(9, 20)
+    W = random.randint(max(12, w0 + w1 + 4), 24)
