+    edges = []
+    if int(r0) == 0:
+        edges.append("top")
+    if int(r1) == H - 1:
+        edges.append("bottom")
+    if int(c0) == 0:
+        edges.append("left")
+    if int(c1) == W - 1:
+        edges.append("right")
