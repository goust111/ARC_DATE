+            c0 = random.randint(0, W - w)
+            if not _can_place(patch, r0, c0, shape, occupied):
+                continue
+
+            for pr, pc in _fg_cells(patch):
+                rr = int(r0 + pr)
+                cc = int(c0 + pc)
+                grid[rr, cc] = int(patch[pr, pc])
