+def _make_end_patch(side: str, body_color: int, marker_color: int, row_off: int) -> np.ndarray:
+    assert side in {"left", "right"}
+
+    for _ in range(120):
+        width = random.choice([2, 2, 3])
+        min_h = max(3, row_off + 2)
