+    out = np.full((int(max_r - min_r + 1), int(max_c - min_c + 1)), BG, dtype=int)
+    for info, (x, y) in zip(ordered, positions):
+        patch = info["patch"].copy()
+        if recolor_connectors:
+            patch[patch == CONNECTOR] = int(info["body_color"])
