+        h, w = map(int, patch.shape)
+        r0 = int(y - min_r)
+        c0 = int(x - min_c)
+        window = out[r0 : r0 + h, c0 : c0 + w]
+        mask = patch != BG
+        assert not np.any(window[mask] != BG), "assembled sprites must not overlap"
+        window[mask] = patch[mask]
+
