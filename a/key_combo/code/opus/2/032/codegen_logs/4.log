+        assert isinstance(bbox, tuple)
+        grid_r = (int(bbox[0]) - int(marker_origin_r)) // int(stamp_h)
+        grid_c = (int(bbox[1]) - int(marker_origin_c)) // int(stamp_w)
+        patch = template_a if orientation == majority_orientation else template_b
+        _stamp(
