+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(map(int, coords[0]))
+    seen = {start}
+    queue: deque[tuple[int, int]] = deque([start])
+    H, W = mask.shape
+    while queue:
