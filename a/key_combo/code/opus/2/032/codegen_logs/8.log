+def _segments(size: int, lines: list[int]) -> list[tuple[int, int]]:
+    segs: list[tuple[int, int]] = []
+    start = 0
+    for line in sorted(set(int(x) for x in lines)):
+        if start <= line - 1:
+            segs.append((int(start), int(line - 1)))
+        start = int(line + 1)
+    if start <= int(size - 1):
+        segs.append((int(start), int(size - 1)))
+    return segs
