    starts = np.argwhere(g == red)
    assert starts.shape == (1, 2)
    r, c = map(int, starts[0])
    if r == 0:
        dr, dc = 1, 0
    elif r == h - 1:
        dr, dc = -1, 0
    elif c == 0:
