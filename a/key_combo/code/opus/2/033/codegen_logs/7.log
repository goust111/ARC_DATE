            rr, cc = int(r), int(c)
            H2, W2 = int(H0), int(W0)
        elif int(k) == 1:
            rr, cc = int(W0 - 1 - c), int(r)
            H2, W2 = int(W0), int(H0)
        elif int(k) == 2:
            rr, cc = int(H0 - 1 - r), int(W0 - 1 - c)
            H2, W2 = int(H0), int(W0)
        else:
            rr, cc = int(c), int(H0 - 1 - r)
            H2, W2 = int(W0), int(H0)
