+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
+
+    local_h = rr1 - rr0 + 1
+    local_w = cc1 - cc0 + 1
