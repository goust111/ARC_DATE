+
+def _transform_coords(coords: np.ndarray, rot: int, flip: bool) -> np.ndarray:
+    arr = np.asarray(coords, dtype=int).copy()
+    if flip:
+        arr[:, 1] *= -1
+    for _ in range(rot % 4):
+        arr = np.column_stack((-arr[:, 1], arr[:, 0]))
