+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GRAY = 5
+PATH_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 400
+OBJECT_COUNT_OPTIONS = (2, 3)
+PATH_LENGTH_POOL = (4, 5, 6, 7, 8)
