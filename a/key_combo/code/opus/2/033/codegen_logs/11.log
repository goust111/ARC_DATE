+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        seen[rr, cc] = True
+        stack = [(rr, cc)]
+        coords: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for nr, nc in neighbors4(cr, cc):
