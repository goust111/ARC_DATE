+        prev, cur = cur, nxt
+    assert len(ordered) == len(pts), "path traversal must visit every path pixel exactly once"
+    return ordered
+
+
+def _enclosed_background_area(grid: np.ndarray, ring_coords: np.ndarray) -> int:
+    h, w = grid.shape
+    r0, c0, r1, c1 = bbox_coords(ring_coords)
+    rr0 = max(0, r0 - 1)
