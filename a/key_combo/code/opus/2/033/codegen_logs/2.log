+        grid_w = random.randint(18, 28)
+        placements = _place_records(records, (grid_h, grid_w))
+        if placements is None:
+            continue
+
+        palette_positions = _palette_positions(grid_w, n_loops)
+        if palette_positions is None:
+            continue
+
