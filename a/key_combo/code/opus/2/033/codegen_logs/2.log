+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+PALETTE_POOL = [2, 3, 4, 5, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 500
+SHAPE_ATTEMPTS = 200
