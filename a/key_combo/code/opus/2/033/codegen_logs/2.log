+                local_c = nc - c0
+                inside_solid = (
+                    0 <= local_r < solid.shape[0]
+                    and 0 <= local_c < solid.shape[1]
+                    and bool(solid[local_r, local_c])
+                )
+                if int(inp[nr, nc]) == BLACK and not inside_solid:
+                    out[nr, nc] = int(color)
+    return out
