        else:
            if w < 5 or h < 4:
                continue
            depth = random.randint(1, min(3, w - 3))
            span = random.randint(1, h - 2)
            r0 = random.randint(1, h - span - 1)
            if side == "left":
                solid[r0 : r0 + span, :depth] = False
            else:
                solid[r0 : r0 + span, w - depth :] = False

    if random.random() < 0.5:
        solid = np.flipud(solid)
    if random.random() < 0.5:
        solid = np.fliplr(solid)
    solid = np.rot90(solid, random.randrange(4)).copy()
    return solid


def _shape_record() -> dict | None:
    for _ in range(SHAPE_ATTEMPTS):
        solid = _random_solid()
        if bool(np.all(solid)):
            continue

