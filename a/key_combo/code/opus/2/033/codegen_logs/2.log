            continue

        _, interior_components = _label_components(interior)
        if len(interior_components) != 1:
            continue
        if not _is_single_cycle(ring):
            continue

        return {
            "solid": solid,
            "ring": ring,
            "area": int(interior.sum()),
            "h": int(solid.shape[0]),
            "w": int(solid.shape[1]),
        }
    return None


def _expanded_rect(r0: int, c0: int, h: int, w: int) -> tuple[int, int, int, int]:
    return r0 - 2, c0 - 2, r0 + h + 1, c0 + w + 1


