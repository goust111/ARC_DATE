+        if notch["side"] == "left":
+            _trace_to(path, (notch["r1"], 0))
+            _trace_to(path, (notch["r1"], notch["depth"]))
+            _trace_to(path, (notch["r0"], notch["depth"]))
+            _trace_to(path, (notch["r0"], 0))
