+    n_loops = random.choice([2, 3, 3, 4])
+    records: list[dict] = []
+    used_areas: set[int] = set()
+
+    for _ in range(200):
+        if len(records) == n_loops:
+            break
+        rec = _shape_record()
+        if rec is None or rec["area"] in used_areas:
+            continue
+        used_areas.add(int(rec["area"]))
+        records.append(rec)
+    if len(records) != n_loops:
+        return None
+
+    for _ in range(CANVAS_ATTEMPTS):
