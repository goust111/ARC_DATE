+
+def _trace_to(path: list[tuple[int, int]], end: tuple[int, int]) -> None:
+    r, c = path[-1]
+    er, ec = end
+    dr = 0 if er == r else (1 if er > r else -1)
+    dc = 0 if ec == c else (1 if ec > c else -1)
+    assert dr == 0 or dc == 0
+    while (r, c) != (er, ec):
+        r += dr
+        c += dc
+        path.append((r, c))
+
+
