+    if len(components) != 1:
+        return False
+    for r, c in components[0]:
+        degree = 0
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(ring.shape, nr, nc) and bool(ring[nr, nc]):
+                degree += 1
+        if degree != 2:
+            return False
+    return True
