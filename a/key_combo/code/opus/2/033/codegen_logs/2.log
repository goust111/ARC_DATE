+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or labels[r, c] != -1:
+                continue
+            labels[r, c] = next_id
+            queue = deque([(r, c)])
+            coords = [(r, c)]
+            while queue:
+                cr, cc = queue.popleft()
+                for nr, nc in _neighbors4(cr, cc):
+                    if not _in_bounds(mask.shape, nr, nc):
