# Legend shape and panel slot sampling.
LEGEND_COUNT, LEGEND_BBOX_SIZE = 4, 3
LEGEND_CELL_MIN, LEGEND_CELL_MAX_EXCLUSIVE = 4, 8
LEGEND_GAP_MIN, LEGEND_GAP_MAX = 1, 3
