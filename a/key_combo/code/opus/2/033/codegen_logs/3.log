    gaps = LEGEND_GAP_OPTIONS[int(rng.integers(len(LEGEND_GAP_OPTIONS)))]
    spare = GRID_SHAPE[0] - LEGEND_COUNT * LEGEND_BBOX_SIZE - sum(gaps)

