+def _match_sprites_to_cavities(sprites: list[dict], cavities: list[dict]) -> dict[int, tuple[int, int, bool]]:
+    options: list[list[tuple[int, int, bool]]] = []
+    for sprite in sprites:
+        by_cavity: dict[int, tuple[int, bool]] = {}
