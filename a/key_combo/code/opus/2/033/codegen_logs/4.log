+        if aligned is None:
+            return None
+        for idx, (top, left) in enumerate(aligned):
+            spec = specs[idx]
+            shapes.append(
+                {
+                    "spec": spec,
+                    "color": shape_colors[idx],
+                    "top": top,
+                    "left": left,
+                    "h": int(spec["h"]),
+                    "w": int(spec["w"]),
+                }
+            )
+        start_index = 2
+    else:
+        start_index = 0
+
+    for idx in range(start_index, n_shapes):
+        spec = specs[idx]
+        pos = _random_bbox_position(used, int(spec["h"]), int(spec["w"]))
+        if pos is None:
+            return None
+        _mark_bbox(used, pos[0], pos[1], int(spec["h"]), int(spec["w"]))
+        shapes.append(
