+                {
+                    "spec": spec,
+                    "color": shape_colors[idx],
+                    "top": top,
+                    "left": left,
+                    "h": int(spec["h"]),
+                    "w": int(spec["w"]),
+                }
+            )
+        start_index = 2
+    else:
+        start_index = 0
+
+    for idx in range(start_index, n_shapes):
