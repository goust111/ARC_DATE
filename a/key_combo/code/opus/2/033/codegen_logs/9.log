            seen.add(key)
            by_count[n].append((shape, dims, key))
    _SHAPE_ORBITS_BY_COUNT = by_count
    return by_count

def _gen_random_variant(shape, dims, rng):
    variants = list(_d4_variants(shape, dims))
    return variants[int(rng.integers(len(variants)))]

