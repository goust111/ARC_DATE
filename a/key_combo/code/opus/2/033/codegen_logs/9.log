+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert 1 <= int(np.sum(g == BLUE)) <= 2, "expected one or two blue contour barriers"
+    assert np.any(g == GREEN), "expected a green obstacle"
