+    turns = _candidate_turns(slide_dir)
+    branches = [_walk_branch(g, landing, turn) for turn in turns]
+    best = 0
+    if len(branches[1]) > len(branches[0]):
+        best = 1
+
+    dest = branches[best][-1] if branches[best] else landing
