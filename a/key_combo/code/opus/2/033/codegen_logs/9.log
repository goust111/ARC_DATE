                ((h0, run0), (h1, run1))
                for h0 in GROUP_HEIGHT_RANGE
                for h1 in GROUP_HEIGHT_RANGE
                for run0 in RUN_LEN_RANGE
                for run1 in RUN_LEN_RANGE
            ]
