+    yield int(r) - 1, int(c)
+    yield int(r) + 1, int(c)
+    yield int(r), int(c) - 1
+    yield int(r), int(c) + 1
+
+
+def _adjacent_to_color(g: np.ndarray, pos: Coord, color: int) -> bool:
+    r, c = pos
+    return any(
+        _in_bounds(g.shape, nr, nc) and int(g[nr, nc]) == int(color)
+        for nr, nc in _neighbors4(r, c)
+    )
