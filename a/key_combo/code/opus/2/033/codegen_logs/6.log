+    bc1 = min(w - 1, c1 + 1)
+
+    local = np.zeros((br1 - br0 + 1, bc1 - bc0 + 1), dtype=bool)
+    for r, c in coords:
+        local[int(r) - br0, int(c) - bc0] = True
+
+    exterior = np.zeros_like(local, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    lh, lw = local.shape
+
+    for rr in range(lh):
