+def _can_place(occupied: np.ndarray, h: int, w: int, r: int, c: int, pad: int) -> bool:
+    r0, c0, r1, c1 = _expand_box(r, c, h, w, pad, occupied.shape)
+    return not bool(occupied[r0:r1, c0:c1].any())
