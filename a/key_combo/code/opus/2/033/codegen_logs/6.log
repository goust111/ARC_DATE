+def _expand_box(r: int, c: int, h: int, w: int, pad: int, shape: tuple[int, int]):
+    gh, gw = shape
+    r0 = max(0, r - pad)
+    c0 = max(0, c - pad)
+    r1 = min(gh, r + h + pad)
+    c1 = min(gw, c + w + pad)
+    return r0, c0, r1, c1
