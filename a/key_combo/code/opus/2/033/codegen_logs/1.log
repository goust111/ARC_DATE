                    seen.add((nr,nc)); stack.append((nr,nc))
        comps.append(tuple(sorted(comp)))
    comps.sort(); return comps

def reflect_barriers(grid):
    H,W=grid.shape; pts=set()
    for r,c in map(tuple,np.argwhere(grid==GRAY)):
        for rr in {r,H-1-r}:
            for cc in {c,W-1-c}:
                pts.add((rr,cc))
    return pts

def center_targets(H,W,d):
    dr,dc=d
    if dc>0: return (W-1)//2
    if dc<0: return W//2
    if dr>0: return (H-1)//2
    return H//2

def front_for_spec(shape,spec):
    H,W=shape
    if spec.orientation=='h':
        return (spec.line, spec.length-1) if spec.color==GREEN else (spec.line, W-spec.length)
    return (spec.length-1, spec.line) if spec.color==GREEN else (H-spec.length, spec.line)

def distance_for_spec(shape,spec):
    H,W=shape; cr=(H-1)/2.0; cc=(W-1)/2.0; r,c=front_for_spec(shape,spec)
    return abs(r-cr)+abs(c-cc)

def cells_for_spec(shape,spec):
    H,W=shape
    if spec.orientation=='h':
        if spec.color==GREEN:
            return [(spec.line,c) for c in range(spec.length)]
        return [(spec.line,c) for c in range(W-spec.length, W)]
    if spec.color==GREEN:
        return [(r,spec.line) for r in range(spec.length)]
    return [(r,spec.line) for r in range(H-spec.length, H)]

def extract_runs(grid):
    H,W=grid.shape; center=((H-1)/2.0,(W-1)/2.0); runs=[]
    for color in (RED,GREEN):
        for comp in components_of_color(grid,color):
            rows=sorted({r for r,_ in comp}); cols=sorted({c for _,c in comp}); r0,r1=rows[0],rows[-1]; c0,c1=cols[0],cols[-1]
            if len(rows)==1:
