def components_of_color(grid, color):
    H,W=grid.shape; seen=set(); comps=[]
    for r,c in map(tuple,np.argwhere(grid==color)):
        if (r,c) in seen: continue
        stack=[(r,c)]; seen.add((r,c)); comp=[]
