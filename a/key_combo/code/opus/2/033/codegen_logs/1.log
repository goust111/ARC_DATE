                    direction=(0,1); front=(r0,c1); edge='"'left'
                else:
                    if c1"'!=W-1: raise AssertionError
                    direction=(0,-1); front=(r0,c0); edge='"'right'
            elif len(cols)==1:
                if len(comp)"'!=r1-r0+1: raise AssertionError
                orientation='"'v'
                if color==GREEN:
                    if r0"'!=0: raise AssertionError
                    direction=(1,0); front=(r1,c0); edge='"'top'
                else:
