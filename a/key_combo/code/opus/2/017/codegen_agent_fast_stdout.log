import numpy as np

_RNG = np.random.default_rng(3101)


def _components(mask: np.ndarray):
    h, w = mask.shape
    visited = np.zeros_like(mask, dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or visited[r, c]:
                continue
            stack = [(r, c)]
            visited[r, c] = True
            comp = []
            while stack:
                x, y = stack.pop()
                comp.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < h and 0 <= ny < w and mask[nx, ny] and not visited[nx, ny]:
                        visited[nx, ny] = True
                        stack.append((nx, ny))
            comps.append(comp)
    return comps


def _bbox(coords):
    rs = [p[0] for p in coords]
    cs = [p[1] for p in coords]
    return min(rs), max(rs), min(cs), max(cs)


def _draw_ring(grid: np.ndarray, r0, c0, r1, c1, color: int):
    if r1 <= r0 or c1 <= c0:
        return
    grid[r0, c0:c1 + 1] = color
    grid[r1, c0:c1 + 1] = color
    grid[r0:r1 + 1, c0] = color
    grid[r0:r1 + 1, c1] = color


def _tail_and_depth_for_group(grid: np.ndarray, color: int, comps):
    depths = len(comps)
    if depths == 0:
        return None

    comp_sets = [set(comp) for comp in comps]
    outer_idx = int(np.argmax([len(comp) for comp in comps]))
    outer = comps[outer_idx]
    r0, r1, c0, c1 = _bbox(outer)
    outer_set = comp_sets[outer_idx]

    cx = (c0 + c1) // 2
    cy = (r0 + r1) // 2
    h, w = grid.shape

    if cy > 0 and (cy - 1, cx) in outer_set:
        direction = (-1, 0)
    elif cy + 1 < h and (cy + 1, cx) in outer_set:
        direction = (1, 0)
    elif cx > 0 and (cy, cx - 1) in outer_set:
        direction = (0, -1)
    elif cx + 1 < w and (cy, cx + 1) in outer_set:
        direction = (0, 1)
    else:
        direction = None

    # find the actual spike position in the component, if any
    tail = None
    if direction == (-1, 0) and cy > 0 and (cy - 1, cx) in outer_set:
        tail = (cy - 1, cx)
    elif direction == (1, 0) and cy + 1 < h and (cy + 1, cx) in outer_set:
        tail = (cy + 1, cx)
    elif direction == (0, -1) and cx > 0 and (cy, cx - 1) in outer_set:
        tail = (cy, cx - 1)
    elif direction == (0, 1) and cx + 1 < w and (cy, cx + 1) in outer_set:
        tail = (cy, cx + 1)

    return depth, direction, tail


def main(grid: np.ndarray):
    \"\"\"Task 1 transform.

    1) Parse each non-black color group and detect all connected frame components.
    2) Depth is component count per color; tail is inferred from spike pixel.
    3) Erase all frame pixels, then draw color ejection of length equal to depth.
    4) Return transformed grid with only ejection trails.
    \"\"\"

    g = np.array(grid, dtype=int)
    out = g.copy()
    colors = [int(v) for v in np.unique(g) if v "'!= 0]

    for color in colors:
        mask = g == color
        comps = _components(mask)
        if not comps:
            continue

        for comp in comps:
            for r, c in comp:
                out[r, c] = 0

        depth = len(comps)
        info = _tail_and_depth_for_group(g, color, comps)
        if info is None:
            continue
        _, direction, tail = info
        if direction is None or tail is None:
            continue

        dr, dc = direction
        tr, tc = tail
        h, w = out.shape
        for step in range(depth):
            rr = tr + dr * step
            cc = tc + dc * step
            if 0 <= rr < h and 0 <= cc < w:
                out[rr, cc] = color

    return out


def _dilate_mask(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    out = np.zeros_like(mask)
    for r in range(h):
        for c in range(w):
            if not mask[r, c]:
                continue
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    rr = r + dr
                    cc = c + dc
                    if 0 <= rr < h and 0 <= cc < w:
                        out[rr, cc] = True
    return out


def _place_group(g, occupied, color, depth, max_trials=120):
    h, w = g.shape
    min_side = 4 * (depth - 1) + 5
    max_side = h - 2
    if min_side > max_side or min_side < 5:
        return False

    directions = [(0, -1), (0, 1), (-1, 0), (1, 0)]
    for _ in range(max_trials):
        side = int(_RNG.choice(np.arange(min_side, max_side + 1, 2)))
        r0_min = 0
        r0_max = h - side
        c0_min = 0
        c0_max = w - side

        dir_dr, dir_dc = directions[int(_RNG.integers(len(directions)))]
        if dir_dr == -1:
            r0_min = 1
        if dir_dr == 1:
            r0_max = h - side - 1
        if dir_dc == -1:
            c0_min = 1
        if dir_dc == 1:
            c0_max = w - side - 1

        if r0_min > r0_max or c0_min > c0_max:
            continue

        r0 = int(_RNG.integers(r0_min, r0_max + 1))
        c0 = int(_RNG.integers(c0_min, c0_max + 1))
        r1 = r0 + side - 1
        c1 = c0 + side - 1

        if side < min_side or r1 >= h or c1 >= w:
            continue

        temp_mask = np.zeros((h, w), dtype=bool)
        for level in range(depth):
            rr0 = r0 + 2 * level
            cc0 = c0 + 2 * level
            rr1 = r1 - 2 * level
            cc1 = c1 - 2 * level
            if rr0 > rr1 or cc0 > cc1:
                break
            _draw_ring(temp_mask.view(np.int8), rr0, cc0, rr1, cc1, 1)
            temp_mask = temp_mask | (temp_mask > 1)

        if not temp_mask.any():
            continue

        tr, tc = ((r0 + c1) // 2, (c0 + c1) // 2)
        if dir_dr == -1:
            tr = r0 - 1
            tc = (c0 + c1) // 2
        elif dir_dr == 1:
            tr = r1 + 1
            tc = (c0 + c1) // 2
        elif dir_dc == -1:
            tr = (r0 + r1) // 2
            tc = c0 - 1
        else:
            tr = (r0 + r1) // 2
            tc = c1 + 1
        if not (0 <= tr < h and 0 <= tc < w):
            continue

        temp_mask[tr, tc] = True
        dil = _dilate_mask(temp_mask)
        if np.any(occupied & dil):
            continue

        for rr in range(h):
            for cc in range(w):
                if temp_mask[rr, cc]:
                    g[rr, cc] = color
        occupied |= dil
        return True

    return False


def generate_input():
    """Problem 1 input generator.

    1) Build 15x15 black canvas.
    2) Place 2-3 independent color groups of nested 1-pixel rings with 1-cell gaps.
    3) Each group has unique color, unique depth and one outward tail spike.
    4) Randomness uses fixed RNG so data are stable and varied.
    """

    h, w = 15, 15
    grid = np.zeros((h, w), dtype=int)
    occupied = np.zeros((h, w), dtype=bool)

    group_count = int(_RNG.integers(2, 4))
    colors = [2, 3, 4, 1]
    _RNG.shuffle(colors)
    depths = list(range(1, group_count + 1))
    _RNG.shuffle(depths)

    for i in range(group_count):
        color = colors[i]
        placed = _place_group(grid, occupied, color, depths[i])
        if not placed:
            # fallback: reduce depth greedily
            for d2 in range(1, depths[i] + 1):
                if _place_group(grid, occupied, color, d2):
                    break

    return grid


if __name__ == "__main__":
    sample = generate_input()
    print(main(sample))
