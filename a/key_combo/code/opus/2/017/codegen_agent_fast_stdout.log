                    r0 = r
                    c0 = cc
                    if c0 == axis:
                        continue
                    if g[r0, c0] != 0:
                        continue
                    g[r0, c0] = color

                if color == colors[0]:
                    used_coord.add(coord)
                placed = True
                break
            if not placed:
                continue

    return g


if __name__ == "__main__":
