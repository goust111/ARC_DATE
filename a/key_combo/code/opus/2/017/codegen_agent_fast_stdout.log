        for rr in range(h):
            for cc in range(w):
                if temp_mask[rr, cc]:
                    g[rr, cc] = color
        occupied |= dil
        return True

    return False


def generate_input():
    """Problem 1 input generator.

    1) Build 15x15 black canvas.
    2) Place 2-3 independent color groups of nested 1-pixel rings with 1-cell gaps.
    3) Each group has unique color, unique depth and one outward tail spike.
    4) Randomness uses fixed RNG so data are stable and varied.
    """

    h, w = 15, 15
    grid = np.zeros((h, w), dtype=int)
    occupied = np.zeros((h, w), dtype=bool)

