            placed = False
            for _ in range(60):
                if axis_is_row:
                    r = int(_RNG.integers(0, half))
                    c = int(_RNG.integers(0, w))
                    if color == colors[0]:
                        coord = c
                    else:
                        coord = c
                    if coord in used_coord and color == colors[0]:
