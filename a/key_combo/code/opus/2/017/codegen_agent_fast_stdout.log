                continue
            g[r0, c0:c1 + 1] = col
            g[r1, c0:c1 + 1] = col
            g[r0:r1 + 1, c0] = col
            g[r0:r1 + 1, c1] = col
            occ[max(0, r0 - 1):min(h - 1, r1 + 2), max(0, c0 - 1):min(w - 1, c1 + 2)] = True
            placed = True
            break

        if placed:
            attempts += 1

    # seeds at bottom row
    seed_row = h - 2
    seed_cols = np.arange(1, w - 1)
    _RNG.shuffle(seed_cols)
