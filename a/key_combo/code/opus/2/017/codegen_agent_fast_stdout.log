        hashes.add((g.shape,hashlib.md5(g.tobytes()).hexdigest(),g2.shape,hashlib.md5(g2.tobytes()).hexdigest()))
    results.append((i,comp,len(hashes)))

for i,c,v in results:
    print(f'{i}: py_compile {c}, variants {v}')
