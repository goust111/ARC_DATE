import numpy as np
from collections import deque


_BACKGROUND = 0
_BLUE = 1

_generate_calls = 0


def _rotate_turn(dxdy):
    dr, dc = dxdy
    return {(-1, 0): 0, (0, 1): 1, (1, 0): 2, (0, -1): 3}[(dr, dc)]


def _turn_delta(idx):
    return {0: (-1, 0), 1: (0, 1), 2: (1, 0), 3: (0, -1)}[idx]


def _next_dir(prev_idx, right=True):
    return (prev_idx + (1 if right else -1)) % 4


def _trace_loop(mask):
