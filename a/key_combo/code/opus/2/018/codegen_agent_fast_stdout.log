            dr, dc = _turn_delta(d)
            q = (pr + dr, pc + dc)
            if q in comp:
                candidates.append((d, q))
        # deterministic neighbor choice excluding previous when possible
        if prev is not None and len(candidates) > 1:
            d_prev = prev
            # choose neighbor that keeps smooth traversal on boundary
            for d, q in candidates:
                if q "'!= _opp(prev[0], prev[1]) if False else False:
                    pass
            del_candidates = [item for item in candidates if item[1] != visited.__contains__]
        # simple: prefer right-most turn relative to previous and choose valid unvisited
        if prev is None:
            for d, q in candidates:
                if q not in visited:
                    next_cell = (d, q)
                    break
            if next_cell is None:
                next_cell = candidates[0]
        else:
            pd = prev
            order = [pd, (pd + 1) % 4, (pd + 2) % 4, (pd + 3) % 4]
            found = False
            for d in order:
                q = (pr + _turn_delta(d)[0], pc + _turn_delta(d)[1])
                if q in comp:
                    if q != _prev_pixel and not found:
                        pass
                    found = True
                    next_cell = (d, q)
                    break
            if next_cell is None:
                next_cell = candidates[0]
        if next_cell is None:
            break
        d, q = next_cell
        if q == start and len(path) > 1:
            prev = d
            break
        if q in visited:
            break
        path.append(q)
        visited.add(q)
        prev = d
        p = q
    return path


def _opp(d):
    return (d + 2) % 4

def _trace_loop_simple(mask):
    cells = np.argwhere(mask)
    if len(cells) == 0:
        return []
    start = tuple(cells[0])
    comp = {tuple(p) for p in cells}
    path = [start]
    prev = None
    while True:
        r, c = path[-1]
        neigh = []
        for d in range(4):
            dr, dc = _turn_delta(d)
            q = (r + dr, c + dc)
            if q in comp:
                neigh.append((d, q))
        if not neigh:
            break

        if prev is None:
            # choose first non-back edge
            d, q = neigh[0]
        else:
            # prefer continuing, then right, then left, then back if needed
            order = [prev, (prev + 1) % 4, (prev + 3) % 4, (prev + 2) % 4]
            chosen = None
            for d in order:
                for cand, q in neigh:
                    if cand == d:
                        chosen = (cand, q)
                        break
                if chosen is not None:
                    break
            if chosen is None:
                chosen = neigh[0]
            d, q = chosen
        if q == start:
            break
        if len(path) > 1 and q == path[-2]:
            break
        path.append(q)
        prev = d
        if q == start:
            break
    return path


def _turn_counts(path):
    if len(path) < 3:
        return 0, 0
    dirs = []
    for i in range(len(path)):
        r1, c1 = path[i]
        r2, c2 = path[(i + 1) % len(path)]
        dr, dc = r2 - r1, c2 - c1
        dirs.append(_rotate_turn((dr, dc)))
    left = 0
    right = 0
    for i in range(len(dirs)):
        a = dirs[i - 1]
        b = dirs[i]
        d = (b - a) % 4
        if d == 1:
            left += 1
        elif d == 3:
            right += 1
    return left, right


def _inside_components(component_mask, wall_mask):
    h, w = component_mask.shape
    outside = np.zeros((h, w), dtype=bool)
    q = deque()
    for r in range(h):
        for c in range(w):
            if r in (0, h - 1) or c in (0, w - 1):
                if wall_mask[r, c] == 0 and not outside[r, c]:
                    outside[r, c] = True
                    q.append((r, c))
    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and not outside[nr, nc] and wall_mask[nr, nc] == 0 and component_mask[nr, nc] == 0:
                outside[nr, nc] = True
                q.append((nr, nc))
    enclosed = np.logical_not(np.logical_or(wall_mask > 0, outside))
    comps = []
    vis = np.zeros_like(enclosed, dtype=bool)
    for r in range(h):
        for c in range(w):
            if enclosed[r, c] and not vis[r, c]:
                comp = []
                dq = deque([(r, c)])
                vis[r, c] = True
                while dq:
                    x, y = dq.popleft()
                    comp.append((x, y))
                    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                        nx, ny = x + dr, y + dc
                        if 0 <= nx < h and 0 <= ny < w and enclosed[nx, ny] and not vis[nx, ny]:
                            vis[nx, ny] = True
                            dq.append((nx, ny))
                comps.append(comp)
    return comps


def _square_filled_inside(cells, grid):
    rs = [p[0] for p in cells]
    cs = [p[1] for p in cells]
    r0, r1 = min(rs), max(rs)
    c0, c1 = min(cs), max(cs)
    h = r1 - r0 + 1
    w = c1 - c0 + 1
    if h != w:
        return False
    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
    return int(np.all(sub == _BACKGROUND))


def _generate_loop_template(template_id, rng):
    if template_id == 0:
        coords = []
