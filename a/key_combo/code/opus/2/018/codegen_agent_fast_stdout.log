                        vis[nx, ny] = True
                        q.append((nx, ny))
            comps.setdefault(color, []).append(cells)
    return comps


def _find_bar_and_tail(cells):
    cells_set = set(cells)
    col = min(c for _, c in cells)
    col_cells = sorted((r, c) for r, c in cells if c == col)
    if not col_cells:
        return (None, None, None)
    # bar as topmost vertical segment in one column
    col_rows = [r for r, _ in col_cells]
    run_start = min(col_rows)
    run = [run_start]
    while run_start + 1 in col_rows and run_start + len(run) in col_rows:
        run_start += 1
        run = list(range(min(col_rows), run_start + 1))
    # fallback robustly: choose the shortest contiguous run from top
    run = [row for row in col_rows if row <= min(col_rows) + 6 and all((row + k, col) in cells_set for k in range(4))][:1]

    # more deterministic alternative: take 4..7 top cells in same column
    bar = [(r, col) for r in sorted(col_rows) if r <= min(col_rows) + 6][:7]
    bar = bar[: len(bar) if bar else 0]
    if not bar:
        return (None, None, None)
    tail = [p for p in cells if p not in set(bar)]
    return bar, tail, col_cells[0]


def _obstacle_boxes(grid):
    h, w = grid.shape
    vis = np.zeros((h, w), dtype=bool)
    boxes = []
    for r in range(h):
        for c in range(w):
            if grid[r, c] "'!= _GRAY or vis[r, c]:
                continue
            q = deque([(r, c)])
            vis[r, c] = True
            cells = []
            while q:
                x, y = q.popleft()
                cells.append((x, y))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dr, y + dc
                    if 0 <= nx < h and 0 <= ny < w and not vis[nx, ny] and grid[nx, ny] == _GRAY:
                        vis[nx, ny] = True
                        q.append((nx, ny))
