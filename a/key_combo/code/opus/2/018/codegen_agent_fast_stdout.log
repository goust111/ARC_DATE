import numpy as np
from collections import deque


_BG = 0
_GRAY = 5

_generate_calls = 0


def _component_cells(grid, mask):
    h, w = grid.shape
    vis = np.zeros((h, w), dtype=bool)
    comps = {}
    for r in range(h):
        for c in range(w):
