    return grid


def _rotate(mat, k):
    return np.rot90(mat, -k)


def _read_quadrant_box(grid, r0, c0, r1, c1):
    box = grid[r0:r1, c0:c1]
    for r in range(box.shape[0]):
        for c in range(box.shape[1]):
            if box[r, c] != 0:
                return box
    return np.zeros((4, 4), dtype=int)


def main(grid: np.ndarray) -> np.ndarray:
    """1) Locate the 2x2 gray anchor and split four quadrants.
2) Detect the unique complete non-zero quadrant as source template.
3) Deduce each target quadrant rotation from quadrant index offset.
4) Fill missing pixels in three target quadrants using the rotated source template."""

    g = np.array(grid)
    out = g.copy()

    loc = np.argwhere(g == _GRAY)
    if len(loc) < 4:
        return out
    r0, c0 = min(loc[:, 0]), min(loc[:, 1])

    anchors = {
        0: (r0 - 4, c0 - 4, r0, c0),
        1: (r0 - 4, c0 + 2, r0, c0 + 6),
        2: (r0 + 2, c0 + 2, r0 + 6, c0 + 6),
        3: (r0 + 2, c0 - 4, r0 + 6, c0),
    }

    quadrant_boxes = {}
    for q, (ar0, ac0, ar1, ac1) in anchors.items():
        quadrant_boxes[q] = g[ar0:ar1, ac0:ac1]

    source_q = None
    source_template = None
    for q, box in quadrant_boxes.items():
        if box.size == 0:
            continue
        if np.all(box != 0):
            source_q = q
            source_template = box.copy()
            break

    if source_template is None:
        return out

    for q, box in quadrant_boxes.items():
        if q == source_q:
            continue
        ar0, ac0, ar1, ac1 = anchors[q]
        k = (q - source_q) % 4
        target = _rotate(source_template, k)
        if target.shape != (4, 4):
            target = np.array(target)
        for i in range(target.shape[0]):
            for j in range(target.shape[1]):
