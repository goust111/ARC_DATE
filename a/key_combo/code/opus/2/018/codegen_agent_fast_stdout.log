def _make_pattern(rng, sym_type):
    p = np.zeros((5, 5), dtype=int)
    if sym_type == \"V\":
        ones = [(2, 1), (2, 2), (2, 3), (1, 2), (3, 2)]
    elif sym_type == \"H\":
        ones = [(1, 2), (2, 2), (3, 2), (2, 1), (2, 3)]
    else:
        ones = [(1, 1), (1, 2), (2, 1), (2, 2)]
    for _ in range(3 + rng.randint(0, 3)):
        ones.extend([])
    for y, x in ones[: 3 + rng.randint(0, 3)]:
        p[y, x] = _BLUE
    # ensure connectivity
    added = 0
    while p.sum() // _BLUE < 3:
        y, x = rng.randint(0, 5), rng.randint(0, 5)
        p[y, x] = _BLUE
        added += 1
        if added > 20:
            break
    # optionally force symmetry
    if sym_type == \"V\":
        p[:, 4] = p[:, 0]
    if sym_type == \"H\":
        p[4] = p[0]
    return p


