def _loop_from_component(component_mask):
    path = _trace_loop_simple(component_mask)
    if len(path) == 0:
        return []
    path_set = set(path)
    # ensure simple closed list
    return path


def main(grid: np.ndarray) -> np.ndarray:
    """1) Track each blue closed orthogonal loop as a separate cycle.
2) For each loop, count left/right turns and classify convex vs concave by majority.
3) Compute median convex-turn count across loops and gate a fill operation.
4) For active loops fill only square fully solid enclosed regions with color by concavity presence."""

    g = np.array(grid)
    h, w = g.shape

    visited = np.zeros((h, w), dtype=bool)
    loops = []
    for r in range(h):
        for c in range(w):
            if g[r, c] == _BLUE and not visited[r, c]:
                q = deque([(r, c)])
                visited[r, c] = True
