                continue
            color = int(grid[r, c])
            q = deque([(r, c)])
            vis[r, c] = True
            cells = []
            while q:
                x, y = q.popleft()
                cells.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
