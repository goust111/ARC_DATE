            (0, 5),
            (1, 5),
            (2, 5),
            (3, 5),
            (4, 5),
            (0, 5),
        ]
    coords = np.array(coords)
    # remove accidental duplicates
    u, idx = np.unique(coords, axis=0, return_index=True)
    return u[idx]


def _flood_component(grid, start, forbidden):
    h, w = grid.shape
    q = deque([start])
    vis = np.zeros((h, w), dtype=bool)
    vis[start] = True
    comp = []
    while q:
        r, c = q.popleft()
        comp.append((r, c))
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
