import math
import numpy as np


_SOURCE = 5
_BACKGROUND = 0
_IGNORE = 7


_generate_calls = 0


def _shape_for_score(score):
    if score == 1:
        return np.array([[0, 0], [0, 1], [0, 2], [0, 3]])
    if score == 2:
        return np.array([[0, 0], [1, 0], [1, 1], [0, 1]])
    if score == 3:
        return np.array([[0, 0], [1, 0], [1, 1], [2, 1]])
    return np.array([[0, 0], [1, 0], [2, 0], [3, 0]])


def _build_valid_row_bands(h, rng):
    scores = [1, 2, 3, 4]
    bands = {}
    used = np.zeros(h, dtype=bool)
    for score in scores:
        span = score
        candidates = [r for r in range(0, h - span + 1)]
        good = []
        for r in candidates:
            seg = np.arange(r, r + span)
            if not used[seg].any() and (seg[0] > 0 and used[seg[0] - 1] == 0) and (seg[-1] + 1 < h and used[seg[-1] + 1] == 0):
                good.append(r)
        if not good:
            good = [r for r in candidates if not used[r : r + span].any()]
        r0 = int(rng.choice(good))
        used[r0 : r0 + span] = True
        if r0 > 0:
            used[r0 - 1] = True
        if r0 + span < h:
            used[r0 + span] = True
        bands[score] = r0
    return bands


def _find_components(grid):
    h, w = grid.shape
    colors = [1, 2, 3, 4, 6]
    comps = {}
    visited = np.zeros_like(grid, dtype=bool)
    for r in range(h):
        for c in range(w):
            color = int(grid[r, c])
            if color not in colors or visited[r, c]:
                continue
            stack = [(r, c)]
            visited[r, c] = True
            pix = []
            while stack:
                x, y = stack.pop()
                pix.append((x, y))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and int(grid[nr, nc]) == color:
                        visited[nr, nc] = True
                        stack.append((nr, nc))
            comps.setdefault(color, []).append(pix)
    return [
        {
            \"color\": color,
            \"pixels\": pixels,
            \"size\": len(pixels),
            \"side\": int(math.isqrt(len(pixels))),
        }
        for color, c_list in comps.items()
        for pixels in c_list
        if int(color) "'!= _SOURCE
    ]


def generate_input():
    global _generate_calls
    rng = np.random.RandomState(1000 + _generate_calls)
    _generate_calls += 1

    h = 18
    w = 18
    grid = np.zeros((h, w), dtype=int)
    grid[:, 0] = _SOURCE

    colors = [2, 1, 3, 4, 6]
    rng.shuffle(colors)
    scores = [1, 2, 3, 4]
    rng.shuffle(scores)
    bands = _build_valid_row_bands(h, rng)
    cols = np.array([1, 6, 11, 16])
    rng.shuffle(cols)

    for idx, score in enumerate(scores):
        color = colors[idx]
        base = _shape_for_score(score)
        top = bands[score]
        left = int(cols[idx])
        if left + base[:, 1].max() >= w:
            left = 1 + idx * 4
        pts = base + np.array([top, left])
        for r, c in pts:
            if 0 <= r < h and 0 <= c < w - 1:
                grid[r, c] = color

    # sparse orange distractors
    free = [(r, c) for r in range(h) for c in range(1, w) if grid[r, c] == 0]
    rng.shuffle(free)
    for r, c in free[:3 + rng.randint(0, 4)]:
        grid[r, c] = 7

    return grid


def _ray_scores(grid):
    h, w = grid.shape
    comps = _find_components(grid)
    color_to_index = {c["color"]: i for i, c in enumerate(comps)}
    hits = np.zeros(len(comps), dtype=int)
    for r in range(h):
        for c in range(1, w):
            p = int(grid[r, c])
            if p in (0, 7):
                continue
            if p in color_to_index:
                hits[color_to_index[p]] += 1
                break
    for c in comps:
        c["score"] = int(hits[color_to_index[c["color"]]])
    return comps


def main(grid: np.ndarray) -> np.ndarray:
    """1) Input transform: multiple sprites with unique visibility scores.
2) Rule: horizontal rays from the left gray strip score sprite hits.
3) Action: each sprite becomes a solid square with side sqrt(area), sorted by score.
4) Output: sprites packed left-to-right with 1-column gaps, bottom aligned."""

    g = np.array(grid)
    comps = _ray_scores(g)
    for comp in comps:
        comp["side"] = int(math.isqrt(comp["size"]))

    comps_sorted = sorted(comps, key=lambda item: (item["score"], item["color"]))
    total_w = sum(c["side"] for c in comps_sorted) + max(0, len(comps_sorted) - 1)
    max_side = max((c["side"] for c in comps_sorted), default=0)
    out = np.zeros((max_side, total_w), dtype=int)

    x = 0
    for comp in comps_sorted:
        s = comp["side"]
        color = comp["color"]
        y = max_side - s
        out[y : y + s, x : x + s] = color
        x += s + 1
    return out


if __name__ == "__main__":
    sample = generate_input()
    print(main(sample))
