    for comp in sorted(comps, key=lambda it: (it[\"score\"], it[\"color\"])):
        s = int(math.isqrt(comp[\"size\"]))
        color = comp[\"color\"]
        y = max_side - s
        out[y : y + s, x : x + s] = color
        x += s + 1

