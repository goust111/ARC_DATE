    total_w = sum(int(math.isqrt(c[\"size\"])) for c in comps) + max(0, len(comps) - 1)
    max_side = max((int(math.isqrt(c[\"size\"])) for c in comps), default=0)
    out = np.zeros((max_side, total_w), dtype=int)

