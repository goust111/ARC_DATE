    o_rs = [p[0] for p in ob]
    o_cs = [p[1] for p in ob]
    bbox = (min(o_rs), min(o_cs), max(o_rs), max(o_cs))
    path = _perimeter_path((bbox[0] - 1, bbox[1] - 1, bbox[2] + 1, bbox[3] + 1))

    br_candidates = sorted(bar_cells)
    if not br_candidates:
        return None
    start = br_candidates[-1]

    best_idx = 0
    best_d = 10 ** 9
    for i, p in enumerate(path):
        d = abs(p[0] - start[0]) + abs(p[1] - start[1])
        if d < best_d:
            best_d = d
            best_idx = i
    path = path[best_idx : best_idx + tail_len]
    if len(path) < tail_len:
        k = (tail_len + len(path) - 1) // len(path)
        path = (path * k)[:tail_len]

    # group canvas
    all_pixels = list(comp_set | set(path) | set(ob))
    minr = min(r for r, c in all_pixels)
    maxr = max(r for r, c in all_pixels)
    minc = min(c for r, c in all_pixels)
    maxc = max(c for r, c in all_pixels)
    h = maxr - minr + 1
    w = maxc - minc + 1
    canvas = np.zeros((h, w), dtype=int)

    for r, c in ob:
        canvas[r - minr, c - minc] = _GRAY
    for r, c in comp:
        if (r, c) in bar_cells:
            canvas[r - minr, c - minc] = color
    for (r, c) in path:
        if 0 <= r - minr < h and 0 <= c - minc < w:
            canvas[r - minr, c - minc] = color

    return {
        "canvas": canvas,
        "color": color,
        "height": h,
        "width": w,
        "ob_perim": _obstacle_perimeter(grid, ob),
        "min_col": minc,
        "min_row": minr,
    }


def main(grid: np.ndarray) -> np.ndarray:
    """1) For each color strip/segment pair, identify nearby obstacle perimeter geometry.
2) Reroute segment along a clockwise perimeter walk around obstacle of equal pixel count.
3) Sort pairs by obstacle perimeter and concatenate groups left to right.
4) Bottom-align groups with 1-column spacing in the final canvas."""

    g = np.array(grid)
    h, w = g.shape
    comps_by_color = _component_cells(g, None)

    obstacles = _obstacle_boxes(g)
    if not obstacles:
        return g

    groups = []
    for color, comps in comps_by_color.items():
        if not comps:
            continue
        for comp in comps:
            if len(comp) < 6:
                continue
            group = _build_group(g, color, comp, obstacles)
            if group is not None:
                groups.append(group)

    if not groups:
        return g

    groups.sort(key=lambda x: (x["ob_perim"], x["min_col"]))
    total_w = sum(gp["width"] for gp in groups) + max(0, len(groups) - 1)
    max_h = max(gp["height"] for gp in groups)
    out = np.zeros((max_h, total_w), dtype=int)

    x = 0
    for gp in groups:
        hh = gp["height"]
        ww = gp["width"]
        y = max_h - hh
        out[y : y + hh, x : x + ww] = gp["canvas"]
        x += ww + 1

    return out


if __name__ == "__main__":
    print(main(generate_input()).shape)
