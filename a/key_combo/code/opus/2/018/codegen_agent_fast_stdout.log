def generate_input():
    global _generate_calls
    rng = np.random.RandomState(4000 + _generate_calls)
    _generate_calls += 1

    h = 20
    w = 20
    grid = np.zeros((h, w), dtype=int)
    placed = []
    anchors = [(1, 1), (11, 1), (6, 10)]
    rng.shuffle(anchors)
    for idx, (r0, c0) in enumerate(anchors):
        coords = _generate_loop_template(idx % 3, rng)
        rr = r0 + coords[:, 0]
        cc = c0 + coords[:, 1]
        # ensure inside grid
        if rr.max() >= h - 1 or cc.max() >= w - 1:
