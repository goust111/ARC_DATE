from __future__ import annotations
import itertools, random
from collections import deque
import numpy as np

BLACK, RED, GREEN, YELLOW, GRAY = 0, 2, 3, 4, 5


def neighbors4(r,c):
    yield r-1,c
    yield r+1,c
    yield r,c-1
    yield r,c+1

def neighbors8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==0 and dc==0:
                continue
            yield r+dr,c+dc

def in_bounds(shape,r,c):
    return 0 <= r < shape[0] and 0 <= c < shape[1]

def normalize(cells):
    r0=min(r for r,c in cells); c0=min(c for r,c in cells)
    return tuple(sorted((r-r0,c-c0) for r,c in cells))

def transform(cells, rot, flip):
    pts=[]
    for r,c in cells:
        x,y=r,c
        for _ in range(rot):
            x,y=y,-x
        if flip:
            y=-y
        pts.append((x,y))
    return normalize(pts)

def marker_candidates(shape):
    s=set(shape)
    return [cell for cell in shape if sum((nr,nc) in s for nr,nc in neighbors4(*cell)) >= 2]

def random_shape(size, min_markers):
    for _ in range(100):
        cells={(3,3)}
        frontier={(2,3),(4,3),(3,2),(3,4)}
        while len(cells) < size and frontier:
            options=list(frontier)
            weights=[]
            for cell in options:
                deg=sum(nb in cells for nb in neighbors4(*cell))
                weights.append((deg+0.3)**3)
            cell=random.choices(options, weights=weights, k=1)[0]
            frontier.remove(cell)
            cells.add(cell)
            for nb in neighbors4(*cell):
                if nb not in cells and 0 <= nb[0] <= 7 and 0 <= nb[1] <= 7:
                    frontier.add(nb)
        sh=transform(normalize(cells), random.randrange(4), bool(random.randrange(2)))
        if len(sh)"'!=size:
            continue
        if len(marker_candidates(sh)) < min_markers:
            continue
        if max(r for r,c in sh) >= 5 or max(c for r,c in sh) >= 5:
            continue
        return sh
    return None

def choose_markers(shape, count):
    if count == 0:
        return ()
    cands=marker_candidates(shape)
    combos=list(itertools.combinations(cands, count))
    if not combos:
        return None
    spaced=[combo for combo in combos if all(abs(a[0]-b[0])+abs(a[1]-b[1]) >= 2 for a,b in itertools.combinations(combo,2))]
    pick=random.choice(spaced or combos)
    return tuple(sorted(pick))

def compute_active(grid):
    h,w=grid.shape
    marker=np.argwhere(grid==RED)
    if len(marker)!=1:
        raise ValueError
    mc=int(marker[0,1])
    wall_rows=np.flatnonzero(np.any(grid==GRAY, axis=1))
    top,bottom=int(wall_rows.min()), int(wall_rows.max())
    active=np.zeros((h,w), dtype=bool)
    for r in range(top, bottom+1):
        cols=np.flatnonzero(grid[r] == GRAY)
        if cols.size == 0:
            active[r,:] = True
            continue
        left=cols[cols <= mc]
        right=cols[cols >= mc]
        start=(int(left.max()) + 1) if left.size else 0
        stop=int(right.min()) if right.size else w
        if start < stop:
            active[r, start:stop] = True
    return active

def comps(grid):
    mask=np.isin(grid, [GREEN,YELLOW])
    seen=np.zeros_like(mask, dtype=bool)
    out=[]
    for r,c in np.argwhere(mask):
        r=int(r); c=int(c)
        if seen[r,c]:
            continue
        dq=deque([(r,c)])
        seen[r,c]=True
        coords=[]
        while dq:
            rr,cc=dq.popleft()
            coords.append((rr,cc))
            for nr,nc in neighbors4(rr,cc):
                if in_bounds(mask.shape,nr,nc) and mask[nr,nc] and not seen[nr,nc]:
                    seen[nr,nc]=True
                    dq.append((nr,nc))
        out.append(np.array(coords,dtype=int))
    return out

def apply(grid):
    active=compute_active(grid)
    out=grid.copy()
    for comp in comps(grid):
        rows,cols=comp[:,0], comp[:,1]
        if bool(np.all(active[rows,cols])) and int(np.count_nonzero(grid[rows,cols]==YELLOW)) >= 2:
            out[rows,cols] = BLACK
    return out

def dilate(mask, conn=8):
    h,w=mask.shape
    out=mask.copy()
    coords=np.argwhere(mask)
    for r,c in coords:
        r=int(r); c=int(c)
        nbrs=neighbors8 if conn==8 else neighbors4
        for nr,nc in nbrs(r,c):
            if in_bounds(mask.shape,nr,nc):
                out[nr,nc]=True
    return out

def abs_cells(shape, r0, c0):
    return [(r0+r, c0+c) for r,c in shape]

def place(mode, markers, grid, active, blocked):
    for _ in range(120):
        size=random.randint(5,9)
        shape=random_shape(size, markers)
        if shape is None:
            continue
        mark_rel=choose_markers(shape, markers)
        if mark_rel is None:
            continue
        h=max(r for r,c in shape)+1
        w=max(c for r,c in shape)+1
        candidates=[]
        for r0 in range(grid.shape[0]-h+1):
            for c0 in range(grid.shape[1]-w+1):
                cells=abs_cells(shape,r0,c0)
                if any(blocked[r,c] for r,c in cells):
                    continue
                inside=sum(active[r,c] for r,c in cells)
                if mode == '"'inside' and inside "'!= len(cells):
                    continue
                if mode == '"'straddle' and not (0 < inside < len(cells)):
                    continue
                candidates.append((cells, abs_cells(mark_rel, r0, c0)))
        if candidates:
            cells, marks=random.choice(candidates)
            for r,c in cells:
                grid[r,c] = GREEN
            for r,c in marks:
                grid[r,c] = YELLOW
            obj=np.zeros_like(blocked)
            for r,c in cells:
                obj[r,c]=True
            blocked |= dilate(obj,8)
            return True
    return False

def build():
    h=random.randint(14,18); w=random.randint(14,18)
    marker_c=random.randint(4, w-5)
    top=random.randint(2,4)
    bottom=random.randint(max(top+6, h-7), h-3)
    span=bottom-top+1
    wall_count=random.randint(4, min(6, span-2))
    selected={top,bottom}
    middle=[r for r in range(top+1, bottom) ]
