+def _allowed_main_cells(h: int, w: int, side: str) -> set[Coord]:
+    r0, r1 = 2, h - 2
+    c0, c1 = 2, w - 2
+    if side == "top":
+        r0 = 3
+    elif side == "bottom":
+        r1 = h - 3
+    elif side == "left":
+        c0 = 3
+    else:
+        c1 = w - 3
+    return {(r, c) for r in range(r0, r1) for c in range(c0, c1)}
