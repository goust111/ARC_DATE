+    for r, c in isolated:
+        nr, nc = r + dr, c + dc
+        assert in_bounds(g.shape, nr, nc), "isolated-marker extension must remain in bounds"
+        if int(g[nr, nc]) == BG:
+            out[nr, nc] = MARKER
