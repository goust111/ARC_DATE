+        weights = []
+        for cell in choices:
+            r, c = cell
+            degree_bias = (_degree_in(blob, cell) + 0.35) ** 3
+            dist = abs(r - center_r) + abs(c - center_c)
+            weights.append(degree_bias / (1.0 + 0.12 * dist))
