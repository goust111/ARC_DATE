+    line_rows: list[int],
+    line_cols: list[int],
+    cell_r: int,
+    cell_c: int,
+) -> None:
+    r0 = line_rows[cell_r] + 1
+    r1 = line_rows[cell_r + 1]
+    c0 = line_cols[cell_c] + 1
+    c1 = line_cols[cell_c + 1]
