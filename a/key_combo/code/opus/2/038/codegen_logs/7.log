+        return []
+
+    low = max(min_count, int(np.floor(len(cells) * fraction_range[0])))
+    high = max(low, int(np.ceil(len(cells) * fraction_range[1])))
+    high = min(high, len(cells))
+    count = int(rng.integers(low, high + 1))
+    if count == 0:
