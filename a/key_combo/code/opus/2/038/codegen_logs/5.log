+    r, c = anchor
+    left = int(grid[r, c - 1]) if c - 1 >= 0 else BG
+    right = int(grid[r, c + 1]) if c + 1 < grid.shape[1] else BG
+    up = int(grid[r - 1, c]) if r - 1 >= 0 else BG
+    down = int(grid[r + 1, c]) if r + 1 < grid.shape[0] else BG
+
