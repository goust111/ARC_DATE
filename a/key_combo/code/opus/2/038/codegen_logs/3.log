+    blocked = np.zeros_like(grid, dtype=bool)
+    for r, c in yellow_cells:
+        blocked[r, c] = True
+    red_side = red_side_mask(grid.shape, red, blocked)
+    return red, teal, yellow_cells, blocked, red_side
