+            cells = rng.choice(candidates)
+            for r, c in cells:
+                grid[r, c] = BLUE
+            forbidden |= expand_cells(cells, grid.shape, 2)
+
+    return grid if validate_input(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = generate_attempt(rng)
+        if grid is not None:
