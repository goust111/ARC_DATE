+            if in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == BLACK:
+                add.add((nr, nc))
+    return add
+
+
+def erode_object(coords: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    keep: set[tuple[int, int]] = set()
