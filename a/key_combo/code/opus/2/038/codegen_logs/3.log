+    for comp in components:
+        rep = representative(comp)
+        comp_set = set(comp)
+        if red_side[rep]:
+            growth_targets |= grown_neighbors(comp_set, g)
+        else:
+            keep = erode_object(comp_set, g.shape)
+            shrink_remove |= comp_set - keep
