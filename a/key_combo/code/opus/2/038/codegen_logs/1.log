+
+
+def _candidate_placements(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    reserved: np.ndarray,
+    obj: dict,
+    bar_r: int,
+    used_centers: list[int],
+) -> list[tuple[int, int, list[Coord], int]]:
+    h, w = grid.shape
