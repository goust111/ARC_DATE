+            cc == c and ((rr > r) if side == "above" else (rr < r))
+            for rr, cc in cells
+        )
+        if not blocked:
+            valid.append((cell,))
+    return valid
+
+
+def _sample_object(kind: str, side: str, rng: random.Random) -> dict | None:
+    if kind == "zero":
+        size_range = (4, 8)
+    elif kind == "single":
+        size_range = (5, 8)
+    else:
+        size_range = (6, 8)
