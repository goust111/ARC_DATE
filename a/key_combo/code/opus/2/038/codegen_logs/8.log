    wall_4conn = (n_comp == 1)

    # --- Build output tile ---
    out3 = np.full((5, 5), b, dtype=int)
    for r in range(5):
        for c in range(5):
            v1, v2 = int(t1[r, c]), int(t2[r, c])
            if (r, c) in inside:
                if v1 != b:
                    out3[r, c] = v1
            elif (r, c) in wall:
