+        shape_h = 1 + max(r for r, _ in shape)
+        row0 = row_starts[i]
+        specs.append(
+            {
+                "row0": int(row0),
+                "col": int(columns[i]),
+                "length": int(lengths[i]),
+                "line_color": int(line_colors[i]),
+                "label_color": int(label_colors[i]),
+                "label_area": int(label_areas[i]),
+                "label_shape": shape,
