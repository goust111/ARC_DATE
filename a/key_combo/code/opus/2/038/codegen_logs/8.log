+def _extract_specs(grid: np.ndarray) -> list[dict]:
+    comps = _components_by_color(grid, bg=BG)
+    lines = [comp for comp in comps if _is_vertical_line(comp)]
+    labels = [comp for comp in comps if not _is_vertical_line(comp)]
