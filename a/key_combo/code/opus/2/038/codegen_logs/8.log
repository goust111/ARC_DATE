+    anchor = int(round(center - (shape_h - 1) / 2))
+    low = max(0, row0 - 1)
+    high = min(height - shape_h, row0 + length - shape_h + 1)
+    offset = random.choice((-1, 0, 1))
+    return min(max(anchor + offset, low), high)
