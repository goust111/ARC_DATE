+def _is_vertical_line(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return c0 == c1 and int(comp["area"]) == (r1 - r0 + 1) and 4 <= int(comp["area"]) <= 7
+
