/bin/bash -lc "python - <<'PY'
import random
import numpy as np
BG, BLUE, RED, GREEN = 5,1,2,3

def apply_paths(grid):
    g=np.array(grid, dtype=int)
    H,W=g.shape
    out=np.full((H,W), BG, dtype=int)
    out[g==GREEN]=BG
    cols=sorted(int(c) for c in np.argwhere(g==GREEN)[:,1])
    mid=W//2
    for c in cols:
        out[:,c]=BLUE
        if W%2==1 and c==mid:
            out[0,c:]=BLUE
            out[-1,:c+1]=BLUE
        else:
            out[0,:c+1]=BLUE
            out[-1,c:]=BLUE
    return out

def enclosed(path):
    H,W=path.shape
    seen=np.zeros((H,W),bool)
    comps=[]
    for r in range(H):
      for c in range(W):
        if path[r,c]"'!=BG or seen[r,c]: continue
        stack=[(r,c)]; seen[r,c]=1; comp=[]; touch=False
        while stack:
          rr,cc=stack.pop(); comp.append((rr,cc)); touch|=rr in (0,H-1) or cc in (0,W-1)
          for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=rr+dr,cc+dc
            if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and path[nr,nc]==BG:
              seen[nr,nc]=1; stack.append((nr,nc))
        if not touch: comps.append(comp)
    return comps

def main(grid):
    path=apply_paths(grid)
    out=path.copy()
    for comp in enclosed(path):
        for r,c in comp:
            out[r,c]=RED
    return out

def gen(mode):
    while True:
      H=random.randint(12,18)
      if mode=='"'even': W=random.choice([w for w in range(12,19) if w%2==0])
      else: W=random.choice([w for w in range(13,20) if w%2==1])
      mid=W//2; n=random.randint(3,5)
      if mode=='odd_center':
        cols=[mid]
        side=random.choice(['L','R'])
        side_cols=list(range(1,mid)) if side=='L' else list(range(mid+1,W-1))
        pair=random.sample(side_cols,2)
        pair.sort()
        if pair[1]-pair[0]<3: continue
        cols.extend(pair)
        rem=[c for c in range(1,W-1) if c not in cols]
        random.shuffle(rem)
        for c in rem:
          if len(cols)>=n: break
          cols.append(c)
        cols=sorted(cols[:n])
      else:
        cols=sorted(random.sample(range(1,W-1), n))
        if mode=='odd_no_center' and mid in cols: continue
        if not any(b-a>=3 for a,b in zip(cols,cols[1:])): continue
      grid=np.full((H,W),BG,int)
      row=H//2
      for c in cols: grid[row,c]=GREEN
      out=main(grid)
      comps=enclosed(apply_paths(grid))
      if not comps or max(len(c) for c in comps)<8: continue
      ok=True
      for c in cols:
        grid2=grid.copy(); grid2[row,c]=BG
        if np.array_equal(main(grid2), out): ok=False
      if ok: return H,W,cols,len(comps),[len(c) for c in comps]

for mode in ['even','odd_no_center','odd_center']:
  print('mode',mode)
  for _ in range(20):
    print(gen(mode))
