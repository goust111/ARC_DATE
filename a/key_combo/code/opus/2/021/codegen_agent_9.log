import random
import numpy as np

BG, BLUE, RED, GREEN = 5,1,2,3

def draw_paths(shape, cols):
    H,W = shape
    g = np.full((H,W), BG, dtype=int)
    mid = W//2
    has_mid = (W % 2 == 1)
    for c in cols:
        g[:, c] = BLUE
