    return g

def enclosed(path):
    H,W = path.shape
    seen = np.zeros((H,W), bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if path[r,c] "'!= BG or seen[r,c]:
                continue
            stack=[(r,c)]
            seen[r,c]=True
            comp=[]
            touches=False
