0077:         other_color = input_grid[opposite_r, opposite_c]
0078: 
0079:         # 3. Make them attract/march toward each other until they meet in the middle (grey when they touch), leaving a trail of their own color
0080:         while (r, c) != (opposite_r, opposite_c):
0081:             # Draw a trail of color
