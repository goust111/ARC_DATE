+        cells.append((height - 1, col))
+    for row in range(1, height - 1):
+        cells.append((row, 0))
+        cells.append((row, width - 1))
+    seen = []
+    used = set()
+    for cell in cells:
+        if cell in used:
+            continue
+        used.add(cell)
+        seen.append(cell)
+    return seen
