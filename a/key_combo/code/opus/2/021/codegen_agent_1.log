            dim for dim in _GEN_RECT_DIMS
            if _gen_can_sum_rect_areas(remaining - dim[0] * dim[1], slots)
        ]
        h, w = choices[int(np.random.randint(len(choices)))]
        dims.append((h, w))
        remaining -= h * w
