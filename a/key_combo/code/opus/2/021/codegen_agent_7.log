+_K_BAG: list[int] = []
+_SPRITE_SHAPE_BAG: list[tuple[int, int]] = []
+
+
+def _bagged_k() -> int:
+    global _K_BAG
+    if not _K_BAG:
+        _K_BAG = random.sample([2, 3, 4], 3)
+    return int(_K_BAG.pop())
+
+
+def _bagged_sprite_shape() -> tuple[int, int]:
