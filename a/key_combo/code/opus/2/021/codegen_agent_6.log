+    box = tuple(map(int, comp["bbox"]))
+    h = bbox_h(box)
+    w = bbox_w(box)
+    color = int(comp["color"])
+    if h != w or h < 2 or int(comp["area"]) != h * w:
+        return False
+    return bool(np.all(crop_bbox(grid, box) == color))
+
