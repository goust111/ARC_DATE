0015: def main(input_grid):
0016:     """
0017:     March each opposite-side pixel pair toward the center and mark the meeting point gray.
0018: 
0019:     Input structure:
0020:     - Non-black single pixels appear in pairs on opposite sides of a black grid.
0021:     - Each pair lies on a shared row or column after considering horizontal or vertical reflection.
0022:     - Distances are arranged so each pair has one meeting cell.
0023: 
0024:     Rule:
0025:     - Detect each single-pixel component.
0026:     - Match it to the one non-background reflected pixel on the opposite side.
0027:     - Move both endpoints toward each other, leaving trails of their own colors and coloring the meeting cell gray.
0028: 
0029:     Key insight:
0030:     - Opposite-side reflection identifies the pairings, and simultaneous inward motion creates the two-color trails.
0031:     """
0032:     # Plan:
0033:     # 1. Detect the pixels
0034:     # 2. Associate each pixel with its matching pair
0035:     # 3. Make them attract/march toward each other until they meet in the middle, leaving a trail of their own color
0036: 
0037:     # 1. Find the location of the pixels
0038:     pixel_objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0039:     assert len(pixel_objects) % 2 == 0, "There should be an even number of pixels"
0040: 
0041:     # we're going to draw on top of the input grid
0042:     output_grid = input_grid.copy()
0043: 
0044:     seen: set[tuple[int, int]] = set()
0045:     H, W = input_grid.shape
0046:     for obj in pixel_objects:
0047:         # 2. Associate each pixel with its matching pair
0048:         # Find the matching position. The legacy seed solver ran under a transpose wrapper;
0049:         # the most robust way here is to probe both possible "opposite side" candidates
0050:         # and pick the one that is non-background.
0051:         _b = bbox(obj != Color.BLACK)
0052:         assert _b is not None
0053:         r, c = bbox_anchor(_b, anchor="center")
0054:         if (r, c) in seen:
0055:             continue
0056: 
0057:         candidates: list[tuple[int, int]] = []
0058:         # vertical reflection
0059:         rv, cv = H - 1 - r, c
0060:         if 0 <= rv < H and 0 <= cv < W and int(input_grid[rv, cv]) != int(Color.BLACK):
0061:             candidates.append((rv, cv))
0062:         # horizontal reflection
0063:         rh, ch = r, W - 1 - c
0064:         if 0 <= rh < H and 0 <= ch < W and int(input_grid[rh, ch]) != int(Color.BLACK):
0065:             candidates.append((rh, ch))
0066: 
0067:         assert len(candidates) == 1, "Expected exactly one non-background opposite pixel"
0068:         opposite_r, opposite_c = candidates[0]
0069:         seen.add((r, c))
0070:         seen.add((opposite_r, opposite_c))
0071: 
0072:         # get the unit vector pointing from one to the other
0073:         dr = int(np.sign(opposite_r - r))
0074:         dc = int(np.sign(opposite_c - c))
0075: 
0076:         color = input_grid[r, c]
0077:         other_color = input_grid[opposite_r, opposite_c]
0078: 
0079:         # 3. Make them attract/march toward each other until they meet in the middle (grey when they touch), leaving a trail of their own color
0080:         while (r, c) != (opposite_r, opposite_c):
0081:             # Draw a trail of color
0082:             if output_grid[r, c] == Color.BLACK:
0083:                 output_grid[r, c] = color
0084:             if output_grid[opposite_r, opposite_c] == Color.BLACK:
0085:                 output_grid[opposite_r, opposite_c] = other_color
0086:             r += dr
0087:             c += dc
0088:             opposite_r -= dr
0089:             opposite_c -= dc
0090: 
0091:             # Make sure we haven't fallen out of bounds
0092:             if not (0 <= r < input_grid.shape[0] and 0 <= c < input_grid.shape[1] and 0 <= opposite_r < input_grid.shape[0] and 0 <= opposite_c < input_grid.shape[1]):
0093:                 break
0094:         # when they meet, turn the middle point grey
0095:         output_grid[r, c] = Color.GREY
0096:     
0097:     return output_grid
0098:         
