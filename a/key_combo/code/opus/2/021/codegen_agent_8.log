    mask = _gen_mask_for_target(_gen_target_cell_count())
    if mask is None or not _gen_mask_is_valid(mask):
        return None

    inp = out.copy()
    inp[mask] = _GEN_MASK
    if not _gen_oracle_matches(inp, out):
        return None
    return inp


