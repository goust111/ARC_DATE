+
+BG = 0
+SPRITE_COLORS = (1, 3, 4, 7, 9)
+BLOCK_COLORS = (2, 5, 6)
+
+_SCENARIO_CYCLE = (
+    {"above": 1, "left": 1},
+    {"above": 2, "left": 0},
+    {"above": 0, "left": 2},
+    {"above": 2, "left": 1},
+)
+_scenario_index = 0
