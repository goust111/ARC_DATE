+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_GENERATION_ATTEMPTS):
+        try:
+            records = _build_records()
+            grid = _place_records(records)
+            _validate_instance(grid, records)
+            return grid
+        except Exception:
