+
+
+def _find_components(
+    grid: np.ndarray,
+    *,
+    bg: int = 0,
+    monochromatic: bool,
+) -> list[dict]:
+    h, w = map(int, grid.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+
+            color = int(grid[r, c])
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
