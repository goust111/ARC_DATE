_GEN_RECT_MIN_SIDE, _GEN_RECT_MAX_SIDE = 2, 8
_GEN_RECT_MIN_AREA = 8
_GEN_RECT_MAX_AREA = _GEN_RECT_MAX_SIDE * _GEN_RECT_MAX_SIDE
_GEN_RECT_PADDING = 1
_GEN_RECT_DIMS = tuple(
    (h, w)
    for h in range(_GEN_RECT_MIN_SIDE, _GEN_RECT_MAX_SIDE + 1)
