+def _selected_index(infos: list[dict]) -> int:
+    winners = [i for i, info in enumerate(infos) if info["symmetric"]]
+    assert len(winners) == 1, "exactly one compressed skeleton must be left-right symmetric"
+    return int(winners[0])
