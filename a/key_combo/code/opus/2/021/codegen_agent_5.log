+def _place_records(records: list[dict]) -> np.ndarray:
+    h = random.randint(*_CANVAS_SIDE_RANGE)
+    w = random.randint(*_CANVAS_SIDE_RANGE)
+    grid = np.zeros((h, w), dtype=int)
+
+    quadrants = [
+        (1, 1, h // 2 - 2, w // 2 - 2),
+        (1, w // 2 + 1, h // 2 - 2, w - 2),
+        (h // 2 + 1, 1, h - 2, w // 2 - 2),
+        (h // 2 + 1, w // 2 + 1, h - 2, w - 2),
+    ]
+    slots = random.sample(range(4), len(records))
