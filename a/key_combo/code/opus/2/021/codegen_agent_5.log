+        for info in infos
+    ), "every sprite must use unequal partition sizes"
+    assert all(
+        not np.array_equal(out, info["crop"])
+        for idx, info in enumerate(infos)
+        if idx != winner
+    ), "target crop must be unique among sprites in the same instance"
