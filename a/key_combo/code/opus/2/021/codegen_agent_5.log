+
+def _render_sprite(skeleton: np.ndarray, row_heights: list[int], col_widths: list[int]) -> np.ndarray:
+    h = sum(row_heights)
+    w = sum(col_widths)
+    sprite = np.zeros((h, w), dtype=int)
+    r0 = 0
+    for i, rh in enumerate(row_heights):
