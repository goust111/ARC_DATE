+def _is_proper_coloring(skeleton: np.ndarray) -> bool:
+    rows, cols = map(int, skeleton.shape)
+    for r in range(rows):
+        for c in range(cols):
+            if r + 1 < rows and int(skeleton[r, c]) == int(skeleton[r + 1, c]):
+                return False
+            if c + 1 < cols and int(skeleton[r, c]) == int(skeleton[r, c + 1]):
+                return False
+    return True
