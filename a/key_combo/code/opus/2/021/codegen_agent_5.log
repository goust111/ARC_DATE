+_COLOR_POOL = tuple(range(1, 10))
+_AXIS_CANDIDATES = {
+    count: [
+        seq
+        for seq in itertools.product((1, 2, 3), repeat=count)
+        if 6 <= sum(seq) <= 10 and len(set(seq)) > 1
