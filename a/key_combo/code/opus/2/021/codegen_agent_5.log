+    foil_palette = _usable_colors(palette_size)
+    foil_skeleton = _generate_asymmetric_skeleton(target_rows, target_cols, foil_palette)
+    foil = _make_sprite_record(foil_skeleton, row_heights, col_widths, kind="foil")
