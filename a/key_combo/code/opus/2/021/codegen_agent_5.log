+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < rows and 0 <= nc < cols:
+                blocked.add(int(skeleton[nr, nc]))
+        options = [color for color in palette if int(color) not in blocked]
+        random.shuffle(options)
