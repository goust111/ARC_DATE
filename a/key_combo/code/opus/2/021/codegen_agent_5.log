+    col_widths: list[int],
+    *,
+    kind: str,
+) -> dict:
+    sprite = _render_sprite(skeleton, row_heights, col_widths)
+    return {
+        "kind": kind,
+        "skeleton": np.asarray(skeleton, dtype=int),
+        "row_heights": list(map(int, row_heights)),
+        "col_widths": list(map(int, col_widths)),
+        "sprite": sprite,
+        "shape": sprite.shape,
