    for _ in range(MAX_GENERATION_ATTEMPTS):
        try:
            grid = _gen_attempt()
            if grid is not None:
                return grid
        except (AssertionError, ValueError):
            pass
    raise RuntimeError("failed to generate valid cb227835 input")

