    abs_dr, abs_dc = offsets[int(np.random.randint(len(offsets)))]
    dr = abs_dr * int(np.random.choice(SIGN_CHOICES))
    dc = abs_dc * int(np.random.choice(SIGN_CHOICES))
    grid = _gen_marker_grid(h, w, dr, dc)
    main(grid)
    return grid


