+def _paint_ray(out: np.ndarray, marker: tuple[int, int], hit: tuple[int, int]) -> None:
+    mr, mc = marker
+    hr, hc = hit
+    dr = 0 if hr == mr else (1 if hr > mr else -1)
+    dc = 0 if hc == mc else (1 if hc > mc else -1)
+    rr = mr + dr
+    cc = mc + dc
+    while (rr, cc) != (hr, hc):
