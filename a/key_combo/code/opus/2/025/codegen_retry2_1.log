+    coords = np.argwhere(mask)
+    scores: list[tuple[int, int, int, float]] = []
+    for axis in range(g.shape[1]):
+        matches = 0
+        mismatches = 0
+        paired = 0
+        for r, c in coords:
+            mc = _mirror_col(axis, int(c))
+            if 0 <= mc < g.shape[1] and mask[int(r), int(mc)]:
+                paired += 1
+                if int(g[int(r), int(c)]) == int(g[int(r), int(mc)]):
