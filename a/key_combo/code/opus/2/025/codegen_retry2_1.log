+                        "direction": (int(dr), int(dc)),
+                        "distance": int(gap),
+                        "hit": (int(rr), int(cc)),
+                    }
+                )
+            break
+    return candidates
+
+
+def _match_markers(grid: np.ndarray) -> tuple[tuple[int, int, int, int] | None, list[dict]]:
+    g = np.asarray(grid, dtype=int)
