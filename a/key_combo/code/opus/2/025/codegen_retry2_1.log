+def _make_pattern(height: int, width: int) -> np.ndarray:
+    axis = width // 2
+    for _ in range(200):
+        left = np.random.choice(PATTERN_COLORS, size=(height, axis), replace=True)
+        center = np.random.choice(PATTERN_COLORS, size=(height, 1), replace=True)
