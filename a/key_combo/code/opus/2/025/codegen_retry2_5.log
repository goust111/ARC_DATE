+from __future__ import annotations
+
+import random
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+
+try:
+    from arc_utils import Color, coords_where, get_bg, in_bounds
+except ImportError:
+    utils_dir = Path("/home/lixinyu/snap/new/solvers")
