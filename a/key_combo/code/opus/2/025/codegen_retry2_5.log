+
+    if np.array_equal(base, out):
+        return False
+
+    _, alt_long, _ = _simulate((rows, cols), parallelograms, use_short_edge=False)
+    if np.array_equal(out, alt_long):
+        return False
+
+    _, alt_inward, _ = _simulate((rows, cols), parallelograms, flip_normals=True)
