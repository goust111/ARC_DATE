        hits.append(hit_other)
        painted.append(set(cells + ([hit] if hit_other else [])))
    if not (any(hits[:2]) and any(hits[2:])): continue
    # no overlaps among painted sets
    for i in range(4):
        for j in range(i+1,4):
            if painted[i] & painted[j]: ok=False
    if not ok: continue
    print('"'found',trial,H,W,s1,s2,hits,[len(r[3]) for r in rays])
    break
else:
    print('none')
