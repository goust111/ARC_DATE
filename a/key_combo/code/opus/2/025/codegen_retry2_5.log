+    dc = b[1] - a[1]
+    length = max(abs(dr), abs(dc))
+    assert length > 0
+    assert abs(dr) in (0, length)
+    assert abs(dc) in (0, length)
+    sr = _sign(dr)
+    sc = _sign(dc)
+    return [(a[0] + i * sr, a[1] + i * sc) for i in range(length + 1)]
