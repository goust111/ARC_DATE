    g=np.zeros((H,W),dtype=int)
    for sh in shapes:
        for cell in sh.border:
            if cell not in sh.markers: g[cell]=GREEN
        g[sh.p]=sh.color; g[sh.q]=sh.color
    return g

def simulate(shapes,H,W,use_short=True):
    base=draw_base(shapes,H,W)
    rays=[]
    for i,sh in enumerate(shapes):
