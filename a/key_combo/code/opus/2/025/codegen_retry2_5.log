import random, math
from dataclasses import dataclass
from typing import List, Tuple
import numpy as np

GREEN=3


def sign(x):
    return (x>0)-(x<0)

def step(v):
    return (sign(v[0]), sign(v[1]))

def seg(a,b):
    dr=b[0]-a[0]; dc=b[1]-a[1]
    sr=sign(dr); sc=sign(dc)
    L=max(abs(dr),abs(dc))
    assert abs(dr) in (0,L) and abs(dc) in (0,L) and L>0
    return [(a[0]+i*sr,a[1]+i*sc) for i in range(L+1)]

@dataclass
class Shape:
    color:int
    p:Tuple[int,int]
    q:Tuple[int,int]
    diag:Tuple[int,int]
    straight:Tuple[int,int]
    verts:Tuple[Tuple[int,int],...]
    bbox:Tuple[int,int,int,int]
    border:set
    markers:set


def build_shape(color,p,diag,straight):
    q=(p[0]+diag[0]+straight[0], p[1]+diag[1]+straight[1])
    a=p
    b=(p[0]+diag[0], p[1]+diag[1])
    c=(p[0]+straight[0], p[1]+straight[1])
    verts=(a,b,q,c)  # order around shape maybe not used
    # edges from p to b,c and to q
    border=set(seg(a,b)+seg(a,c)+seg(b,q)+seg(c,q))
    rs=[v[0] for v in verts]; cs=[v[1] for v in verts]
    bbox=(min(rs),min(cs),max(rs),max(cs))
    return Shape(color,p,q,diag,straight,verts,bbox,border,{p,q})


def sample_shape(color,H,W):
    axis=random.choice('hv')
    d=random.randint(2,5)
    s=random.randint(1,5)
    while s==d:
        s=random.randint(1,5)
    sr=random.choice([-1,1]); sc=random.choice([-1,1])
    diag=(sr*d, sc*d)
    straight=(0, sc*s) if axis=='h' else (sr*s,0)
    offs=[(0,0),diag,straight,(diag[0]+straight[0],diag[1]+straight[1])]
    minr=min(r for r,c in offs); maxr=max(r for r,c in offs)
    minc=min(c for r,c in offs); maxc=max(c for r,c in offs)
    r=random.randint(-minr, H-1-maxr)
    c=random.randint(-minc, W-1-maxc)
    return build_shape(color,(r,c),diag,straight)


def outward(short_vec, other_vec):
    er,ec=step(short_vec)
    n=(ec,-er)
    dot=other_vec[0]*n[0]+other_vec[1]*n[1]
    if dot>0:
        n=(-n[0],-n[1])
    return n


def ray_info(shape):
    d=abs(shape.diag[0])
    s=max(abs(shape.straight[0]),abs(shape.straight[1]))
    if d<s:
        short=shape.diag; long=shape.straight
    else:
        short=shape.straight; long=shape.diag
    return [
        (shape.p, outward(short,long)),
        (shape.q, outward((-short[0],-short[1]),(-long[0],-long[1])))
    ]


def draw_base(shapes,H,W):
    g=np.zeros((H,W),dtype=int)
    for sh in shapes:
        for r,c in sh.border:
            if (r,c) not in sh.markers:
                g[r,c]=GREEN
        g[sh.p]=sh.color; g[sh.q]=sh.color
    return g


def simulate(shapes,H,W):
    base=draw_base(shapes,H,W)
    rays=[]
    for i,sh in enumerate(shapes):
        other=shapes[1-i]
        for start,drdc in ray_info(sh):
            cells=[]
            r,c=start
            while True:
                r+=drdc[0]; c+=drdc[1]
                if not (0<=r<H and 0<=c<W):
                    hit=None; break
                if base[r,c]"'!=0:
                    hit=(r,c); break
                cells.append((r,c))
            rays.append((sh.color,start,drdc,cells,hit,other))
    out=base.copy()
    for color,start,drdc,cells,hit,other in rays:
        for r,c in cells:
            out[r,c]=color
    for color,start,drdc,cells,hit,other in rays:
        if hit is not None and hit in other.border and hit not in other.markers and base[hit]==GREEN:
            out[hit]=color
    return base,out,rays


def bbox_gap(a,b):
    ra0,ca0,ra1,ca1=a; rb0,cb0,rb1,cb1=b
    row=max(rb0-ra1-1, ra0-rb1-1, 0)
    col=max(cb0-ca1-1, ca0-cb1-1, 0)
    return max(row,col), row, col

for trial in range(10000):
    H=random.randint(18,24); W=random.randint(18,24)
    s1=sample_shape(1,H,W); s2=sample_shape(2,H,W)
    if s1.border & s2.border: continue
    if s1.markers & s2.border or s2.markers & s1.border: continue
    gap,row,col=bbox_gap(s1.bbox,s2.bbox)
    if not (2<=gap<=5): continue
    base,out,rays=simulate([s1,s2],H,W)
    hits=[]; ok=True
    painted=[]
