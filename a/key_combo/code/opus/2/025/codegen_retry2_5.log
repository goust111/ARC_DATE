                and MANHATTAN_RANGE[0] <= manhattan <= MANHATTAN_RANGE[1]
            ):
                offsets.append((abs_dr, abs_dc))
    return offsets


def _gen_marker_grid(h: int, w: int, dr: int, dc: int) -> np.ndarray:
