+        return False
+
+    painted_regions: list[set[Coord]] = []
+    for ray in rays:
+        cells = set(ray.path)
+        if ray.recolor_hit and ray.hit is not None:
+            cells.add(ray.hit)
+        painted_regions.append(cells)
+    for i in range(len(painted_regions)):
+        for j in range(i + 1, len(painted_regions)):
