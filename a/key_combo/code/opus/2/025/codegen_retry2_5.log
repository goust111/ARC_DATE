+def _outward_normal(edge_vec: Coord, other_vec: Coord, *, flip: bool = False) -> Coord:
+    er, ec = _step(edge_vec)
+    normal = (ec, -er)
+    if other_vec[0] * normal[0] + other_vec[1] * normal[1] > 0:
+        normal = (-normal[0], -normal[1])
+    if flip:
+        normal = (-normal[0], -normal[1])
+    return normal
