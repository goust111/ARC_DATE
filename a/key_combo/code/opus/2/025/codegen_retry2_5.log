    return base,out,rays

def bbox_gap(a,b):
    ar0,ac0,ar1,ac1=a; br0,bc0,br1,bc1=b
    row=max(br0-ar1-1, ar0-br1-1, 0)
    col=max(bc0-ac1-1, ac0-bc1-1, 0)
    return max(row,col)

def ok_pair(s1,s2,H,W):
    if s1 is None or s2 is None: return False
    if s1.border & s2.border: return False
    if s1.markers & s2.border or s2.markers & s1.border: return False
    if not (2<=bbox_gap(s1.bbox,s2.bbox)<=5): return False
    base,out,rays=simulate([s1,s2],H,W,True)
