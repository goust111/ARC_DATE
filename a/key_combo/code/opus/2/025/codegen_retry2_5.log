+    path: list[Coord] = []
+    r, c = start
+    while True:
+        r += direction[0]
+        c += direction[1]
+        if not in_bounds(base.shape, r, c):
+            return RayTrace(own_shape.marker_color, start, direction, tuple(path), None, False)
+        if int(base[r, c]) != int(bg):
+            hit = (r, c)
+            recolor = hit in other_shape.green_cells and int(base[r, c]) == GREEN
