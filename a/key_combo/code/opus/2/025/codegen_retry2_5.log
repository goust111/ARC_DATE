+def _decompose_opposite_corners(p: Coord, q: Coord) -> tuple[Coord, Coord, int, int]:
+    dr = q[0] - p[0]
+    dc = q[1] - p[1]
+    abs_dr = abs(dr)
+    abs_dc = abs(dc)
+    assert abs_dr > 0 and abs_dc > 0 and abs_dr != abs_dc
