            rays.append((sh.color,start,drc,cells,hit,hit_other))
    out=base.copy()
    for color,start,drc,cells,hit,hit_other in rays:
        for cell in cells: out[cell]=color
    for color,start,drc,cells,hit,hit_other in rays:
