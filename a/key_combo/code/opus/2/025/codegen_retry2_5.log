GREEN=3

def sign(x): return (x>0)-(x<0)
def step(v): return (sign(v[0]),sign(v[1]))
def seg(a,b):
    dr=b[0]-a[0]; dc=b[1]-a[1]; sr=sign(dr); sc=sign(dc); L=max(abs(dr),abs(dc))
    if not (L>0 and abs(dr) in (0,L) and abs(dc) in (0,L)): raise ValueError
    return [(a[0]+i*sr,a[1]+i*sc) for i in range(L+1)]
@dataclass
class Shape:
    color:int; p:Tuple[int,int]; q:Tuple[int,int]; diag:Tuple[int,int]; straight:Tuple[int,int]; verts:tuple; bbox:tuple; border:set; markers:set

def build_shape(color,p,diag,straight):
    q=(p[0]+diag[0]+straight[0],p[1]+diag[1]+straight[1])
    a=p; b=(p[0]+diag[0],p[1]+diag[1]); c=(p[0]+straight[0],p[1]+straight[1]); d=q
    verts=(a,b,d,c)
    border=set(seg(a,b)+seg(a,c)+seg(b,d)+seg(c,d))
    rs=[x for x,y in verts]; cs=[y for x,y in verts]
    return Shape(color,p,q,diag,straight,verts,(min(rs),min(cs),max(rs),max(cs)),border,{p,q})

def sample_shape(color,H,W):
    axis=random.choice('hv')
    short_diag = bool(random.randrange(2))
    if short_diag:
        d=random.randint(1,3); s=random.randint(d+1,5)
    else:
        s=random.randint(1,3); d=random.randint(s+1,5)
    sr=random.choice([-1,1]); sc=random.choice([-1,1])
    diag=(sr*d,sc*d); straight=(0,sc*s) if axis=='h' else (sr*s,0)
    offs=[(0,0),diag,straight,(diag[0]+straight[0],diag[1]+straight[1])]
    minr=min(r for r,c in offs); maxr=max(r for r,c in offs); minc=min(c for r,c in offs); maxc=max(c for r,c in offs)
    if -minr>H-1-maxr or -minc>W-1-maxc: return None
    p=(random.randint(-minr,H-1-maxr), random.randint(-minc,W-1-maxc))
    return build_shape(color,p,diag,straight)

def outward(edge,other):
    er,ec=step(edge)
    n=(ec,-er)
    if other[0]*n[0]+other[1]*n[1] > 0:
        n=(-n[0],-n[1])
    return n

def ray_sources(shape,use_short=True):
    d=abs(shape.diag[0]); s=max(abs(shape.straight[0]),abs(shape.straight[1]))
    short_first=d<s
    edge = shape.diag if (short_first==use_short) else shape.straight
    other = shape.straight if (short_first==use_short) else shape.diag
    return [(shape.p, outward(edge,other)), (shape.q, outward((-edge[0],-edge[1]), (-other[0],-other[1])))]

