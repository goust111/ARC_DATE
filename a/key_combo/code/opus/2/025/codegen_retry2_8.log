+
+def _ray_path(
+    gap: tuple[int, int],
+    direction: tuple[int, int],
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    dr, dc = direction
+    r, c = gap
+    out: list[tuple[int, int]] = []
+    while 0 <= r < h and 0 <= c < w:
+        out.append((int(r), int(c)))
+        r += int(dr)
+        c += int(dc)
+    return out
+
