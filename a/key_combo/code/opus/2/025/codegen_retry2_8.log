   226	def main(grid: np.ndarray) -> np.ndarray:
   227	    """
   228	    Fill blue frames, emit outward teal rays from one-cell gaps, then extract and stack the row-marked strips those rays pass through.
   229	
   230	    Input structure:
   231	    - The grid has a black background, 2-3 blue hollow axis-aligned rectangular frames, and 4-6 red 2x2 marker blocks.
   232	    - Each red pair shares the same two rows and defines a 2-row extraction strip strictly between the left and right marker blocks.
   233	    - Some frame borders have one non-corner gap; gray noise may appear on the background, including inside extraction strips.
   234	
   235	    Rule:
   236	    - For every blue frame, fill its interior with teal; if it has a one-cell gap, paint a teal ray from that gap straight outward, perpendicular to the side, through black or gray cells until a non-black, non-gray cell blocks it or the ray leaves the grid.
   237	    - Identify the red 2x2 blocks, pair the two blocks that share each two-row span, and crop the rectangle strictly between each pair after the teal fills and rays have already been drawn.
   238	    - Sort the cropped strips from top to bottom and stack them vertically; left-align narrower strips and pad their right side with black.
   239	
   240	    Key insight:
   241	    - The final payload is not present in the raw marker strips: teal pixels must first be created by frame gaps and only then extracted, so the ray-frame analysis and the marker-strip stacking are both essential.
   242	    """
   243	    g = np.asarray(grid, dtype=int)
   244	    assert g.ndim == 2
   245	    decorated = _apply_frame_effects(g)
   246	    pairs = _marker_pairs(g)
   247	    return _stack_regions(_extract_regions(decorated, pairs))
   248	
   249	
   250	def _render_frame(
   251	    grid: np.ndarray,
   252	    bbox: tuple[int, int, int, int],
   253	    gap: tuple[int, int] | None,
   254	) -> None:
   255	    r0, c0, r1, c1 = bbox
   256	    for c in range(c0, c1 + 1):
   257	        if gap != (r0, c):
   258	            grid[r0, c] = BLUE
   259	        if gap != (r1, c):
   260	            grid[r1, c] = BLUE
   261	    for r in range(r0 + 1, r1):
   262	        if gap != (r, c0):
   263	            grid[r, c0] = BLUE
   264	        if gap != (r, c1):
   265	            grid[r, c1] = BLUE
   266	
   267	
   268	def _sample_rows(rng: np.random.Generator, height: int, num_pairs: int) -> list[int] | None:
   269	    choices = np.arange(2, height - 2)
   270	    if len(choices) < num_pairs:
   271	        return None
   272	    for _ in range(300):
