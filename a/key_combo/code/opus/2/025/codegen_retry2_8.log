+        if not np.any((raw_stack == GREY) & (dec_stack == TEAL)):
+            return False
+        if not np.any((raw_stack == GREY) & (dec_stack == GREY)):
+            return False
+        if not np.any(dec_stack == TEAL):
+            return False
+        if not np.array_equal(main(g), dec_stack):
+            return False
+        return True
