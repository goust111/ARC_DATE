+            for r in range(extract_bbox[0], extract_bbox[2] + 1)
+            for c in range(extract_bbox[1], extract_bbox[3] + 1)
+            if not frame_mask[r, c] and int(grid[r, c]) == BG and (r, c) not in path_set
+        ]
+        if pair is target_pair:
