+    h, w = g.shape
+    for frame in frames:
+        gap = frame["gap"]
+        if gap is None:
+            continue
+        bbox = frame["bbox"]  # type: ignore[misc]
+        dr, dc = _gap_direction(gap, bbox)  # type: ignore[arg-type]
+        r, c = gap
+        while 0 <= r < h and 0 <= c < w and int(out[r, c]) in (BG, GREY):
+            out[r, c] = TEAL
+            r += int(dr)
+            c += int(dc)
+    return out
