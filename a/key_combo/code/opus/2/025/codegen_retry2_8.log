+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != int(color):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((int(rr), int(cc)))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(g[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    arr = np.asarray(coords, dtype=int)
+    return (
+        int(arr[:, 0].min()),
+        int(arr[:, 1].min()),
+        int(arr[:, 0].max()),
+        int(arr[:, 1].max()),
+    )
+
+
+def _bbox_intersects(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    ar0 -= int(pad)
+    ac0 -= int(pad)
+    ar1 += int(pad)
+    ac1 += int(pad)
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+
+
+def _cell_in_bbox(cell: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    r, c = cell
+    r0, c0, r1, c1 = bbox
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _gap_side(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r, c = gap
+    r0, c0, r1, c1 = bbox
+    if r == r0:
+        return "top"
+    if r == r1:
+        return "bottom"
+    if c == c0:
+        return "left"
+    assert c == c1
+    return "right"
+
+
+def _gap_direction(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    side = _gap_side(gap, bbox)
+    if side == "top":
+        return -1, 0
+    if side == "bottom":
+        return 1, 0
+    if side == "left":
+        return 0, -1
+    return 0, 1
