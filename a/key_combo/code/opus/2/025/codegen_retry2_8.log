+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREY = 5
+TEAL = 8
+
+MARKER_SIZE = 2
+FRAME_SIZES = ((4, 4), (4, 5), (5, 4), (5, 5))
+
+GRID_H_RANGE = (18, 24)
+GRID_W_RANGE = (13, 18)
+PAIR_COUNT_CHOICES = (2, 3)
+FRAME_COUNT_CHOICES = (2, 3)
+PAIR_GAP_MIN = 3
+PAIR_GAP_MAX = 8
+PAIR_ROW_SEPARATION = 4
+MAX_GENERATE_ATTEMPTS = 400
