  97: def _gen_row_starts(rng: np.random.Generator, height: int, num_pairs: int) -> list[int] | None:
  98:     """Return top rows for 2-row marker spans with sampled vertical gaps."""
  99:     if num_pairs == 1:
 100:         return [int(rng.integers(0, height - MARKER_SIZE + 1))]
 101:     gaps = rng.integers(ROW_GAP_MIN, ROW_GAP_HIGH, size=num_pairs - 1)
 102:     used_height = MARKER_SIZE * num_pairs + int(gaps.sum())
 103:     extra = height - used_height
 104:     if extra < 0:
 105:         return None
 106: 
 107:     row = int(rng.integers(0, extra + 1))
 108:     starts = [row]
 109:     for gap in gaps:
 110:         row += MARKER_SIZE + int(gap)
 111:         starts.append(row)
 112:     return starts
 113: 
 114: def _gen_output(rng: np.random.Generator, num_pairs: int, gap_width: int) -> np.ndarray:
 115:     """Sample the stacked stripe payload later copied between marker pairs."""
 116:     out = np.zeros((MARKER_SIZE * num_pairs, gap_width), dtype=int)
 117:     area = out.size
 118:     density = float(rng.uniform(STRIPE_DENSITY_MIN, STRIPE_DENSITY_MAX))
 119:     count = int(round(area * density))
 120:     count = max(1, min(area, count))
 121:     locs = rng.choice(area, size=count, replace=False)
 122:     out.flat[locs] = rng.choice(GEN_COLORS, size=count, replace=True)
 123:     return out
 124: 
 125: def _choose_layout(rng: np.random.Generator):
 126:     """Sample canvas dimensions and pair anchors, or return None if impossible."""
 127:     num_pairs = int(rng.integers(NUM_PAIRS_MIN, NUM_PAIRS_HIGH))
 128:     gap_width = int(rng.integers(GAP_WIDTH_MIN, GAP_WIDTH_HIGH))
 129:     height = int(rng.integers(GRID_HEIGHT_MIN, GRID_HEIGHT_HIGH))
 130:     min_width = max(MIN_GRID_WIDTH, gap_width + MIN_WIDTH_GAP_PADDING, num_pairs + LEFT_COL_HIGH_MARGIN)
 131:     if min_width >= GRID_WIDTH_HIGH:
 132:         return None
 133:     width = int(rng.integers(min_width, GRID_WIDTH_HIGH))
 134:     row_starts = _gen_row_starts(rng, height, num_pairs)
 135:     if row_starts is None:
 136:         return None
 137:     left_options = np.arange(0, width - LEFT_COL_HIGH_MARGIN)
 138:     if len(left_options) < num_pairs:
 139:         return None
 140:     left_cols = rng.choice(left_options, size=num_pairs, replace=False)
 141:     return height, width, num_pairs, gap_width, row_starts, left_cols
