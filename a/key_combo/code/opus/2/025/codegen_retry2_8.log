+def _apply_frame_effects(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    frames = _detect_frames(g)
+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]  # type: ignore[misc]
+        out[r0 + 1 : r1, c0 + 1 : c1] = TEAL
