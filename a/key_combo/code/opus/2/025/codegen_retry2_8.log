+
+def _bbox_intersects(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = 0) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    ar0 -= int(pad)
+    ac0 -= int(pad)
+    ar1 += int(pad)
+    ac1 += int(pad)
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
