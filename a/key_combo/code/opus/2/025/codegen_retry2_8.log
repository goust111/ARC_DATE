+        dr, dc = _gap_direction(gap, bbox)  # type: ignore[arg-type]
+        r, c = gap
+        while 0 <= r < h and 0 <= c < w and int(out[r, c]) in (BG, GREY):
+            out[r, c] = TEAL
+            r += int(dr)
+            c += int(dc)
+    return out
