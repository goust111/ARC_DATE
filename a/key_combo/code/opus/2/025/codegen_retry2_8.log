+                    bbox = (int(r0), 0, int(r1), 0)
+                    for c0 in range(0, width - fw + 1):
+                        bbox = (int(r0), int(c0), int(r1), int(c0 + fw - 1))
+                        if any(_bbox_intersects(bbox, other, pad=0) for other in marker_bboxes + extract_bboxes):
