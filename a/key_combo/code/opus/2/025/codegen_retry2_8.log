+    grid[on_path] = GREY
+
+    off_path = [
+        (r, c)
+        for r in range(target_extract[0], target_extract[2] + 1)
+        for c in range(target_extract[1], target_extract[3] + 1)
+        if (r, c) not in path_set and not frame_mask[r, c] and int(grid[r, c]) == BG
+    ]
+    if not off_path:
