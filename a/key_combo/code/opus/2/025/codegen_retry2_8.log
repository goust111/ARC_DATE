+        left = int(pair["left"])
+        gap_width = int(pair["width"])
+        right = left + MARKER_SIZE + gap_width
+        grid[row : row + MARKER_SIZE, left : left + MARKER_SIZE] = RED
+        grid[row : row + MARKER_SIZE, right : right + MARKER_SIZE] = RED
