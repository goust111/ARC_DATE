 143: def _render_marker_pairs(grid: np.ndarray, protected: np.ndarray, expected: np.ndarray, row_starts, left_cols, gap_width: int) -> None:
 144:     """Place 2x2 markers and copied stripe strips, marking cells excluded from noise."""
 145:     for i, (row, col) in enumerate(zip(row_starts, left_cols)):
 146:         strip = expected[MARKER_SIZE * i : MARKER_SIZE * i + MARKER_SIZE]
 147:         right_col = col + MARKER_SIZE + gap_width
 148:         grid[row : row + MARKER_SIZE, col : col + MARKER_SIZE] = MARKER_COLOR
 149:         grid[row : row + MARKER_SIZE, col + MARKER_SIZE : right_col] = strip
 150:         grid[row : row + MARKER_SIZE, right_col : right_col + MARKER_SIZE] = MARKER_COLOR
 151:         protected[row : row + MARKER_SIZE, col : right_col + MARKER_SIZE] = True
 152: 
 153: def _add_noise(rng: np.random.Generator, grid: np.ndarray, protected: np.ndarray, expected: np.ndarray, num_pairs: int) -> bool:
 154:     """Fill unprotected cells while forcing every non-marker color to appear."""
 155:     total = grid.size
 156:     marker_count = 2 * MARKER_SIZE * MARKER_SIZE * num_pairs
 157:     stripe_non_bg = int(np.count_nonzero(expected))
 158:     min_non_marker = max(int(np.ceil(NON_MARKER_DENSITY_MIN * total)), stripe_non_bg + len(GEN_COLORS))
 159:     max_non_marker = min(int(np.floor(NON_MARKER_DENSITY_MAX * total)), total - 2 * marker_count - 1)
 160:     if min_non_marker > max_non_marker:
 161:         return False
 162: 
 163:     target_non_marker = int(rng.integers(min_non_marker, max_non_marker + 1))
 164:     noise_count = target_non_marker - stripe_non_bg
 165:     free = np.argwhere(~protected)
 166:     if noise_count < len(GEN_COLORS) or noise_count > len(free):
 167:         return False
 168: 
 169:     noise_coords = free[rng.choice(len(free), size=noise_count, replace=False)]
 170:     noise_colors = rng.choice(GEN_COLORS, size=noise_count, replace=True)
 171:     forced = GEN_COLORS.copy()
 172:     rng.shuffle(forced)
 173:     noise_colors[: len(forced)] = forced
 174:     order = rng.permutation(noise_count)
 175:     grid[noise_coords[order, 0], noise_coords[order, 1]] = noise_colors[order]
 176:     return True
 177: 
 178: def _passes_oracle(grid: np.ndarray, expected: np.ndarray) -> bool:
 179:     """Check background dominance and solver output match."""
 180:     counts = np.bincount(grid.ravel(), minlength=ARC_COLOR_COUNT)
 181:     if counts[BACKGROUND_COLOR] <= max(counts[1:]):
 182:         return False
 183:     try:
 184:         actual = main(grid)
 185:     except Exception:
 186:         return False
 187:     return np.array_equal(actual, expected)
