 cross = _legend_cross_dim(legends, \"vertical\")\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:362:    panel_w = random.randint(max(PANEL_SIZE_RANGE[0], cross + 2), PANEL_SIZE_RANGE[1])\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:369:        c0 = random.randint(1, panel_w - cross - 1)\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:374:        c0 = random.randint(div_c + 2, GRID_SIZE - cross - 1)\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:406:    cross = _legend_cross_dim(legends, arrangement)\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:407:    cross_panel = random.randint(max(PANEL_SIZE_RANGE[0], cross + 2), PANEL_SIZE_RANGE[1])\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:410:        panel_h, panel_w = cross_panel, along\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:411:        line_h, line_w = cross, total\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:413:        panel_h, panel_w = along, cross_panel\n/home/lixinyu/snap/new/ceshi/code/e3721c99/D1/4/code.py:414:        line_h, line_w = total, cross\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D6/2/code.py:23:#   across it, processing A first would overwrite B unless B's pixels were put\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D6/2/code.py:43:#   base task is visible across a few examples: each legend entry acts on its own\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:13:      Each active legend color now uses exactly two 5-pixel crosses.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:14:      A cross is {center, up, down, left, right}.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:15:      The two cross centers are the diagonal corners of the rectangle to fill.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:16:      The crosses stay visible in the output; only the rectangle between their centers is recolored.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:20:      Suppose marker color 4 has crosses centered at (2,3) and (7,9).\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:27:      - that logic would fail because a symmetric cross has no L orientation\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:30:      - recognize each 5-pixel component as a cross and read its center\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:35:      The bounding box of all marker pixels is no longer the fill rectangle because each cross extends\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:41:      Keeping exactly two identical crosses per active color limits free-form ambiguity.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:58:      - The fill rectangle must come from detected cross centers, not from extremal marker pixels.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:59:      - Since all active markers are now cross-pairs, the block branch is removed.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:61:      - Every non-noop legend marker color has exactly two disconnected 5-pixel cross components.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:72:      Because same-color cross components are disconnected, component-based center extraction is stable.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:155:def _cross_center(comp: set[tuple[int, int]]) -> tuple[int, int] | None:\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:156:    \"\"\"Return the center of an exact 5-pixel cross component, else None.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:168:    Recolor rectangles whose opposite corners are indicated by same-color cross markers.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:173:    - Away from the legend, an active marker color appears as two separate 5-pixel crosses.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:178:    - If two exact crosses are present, use their centers as opposite corners of an axis-aligned rectangle.\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:184:      two cross shapes. Because each cross sticks out by one cell in four directions, center recovery is the\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:218:            center = _cross_center(comp)\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:219:            assert center is not None, \"every active marker component must be an exact 5-pixel cross\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:222:        assert len(centers) == 2, \"every active marker color must contain exactly two crosses\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:226:        assert rmin < rmax and cmin < cmax, \"cross centers must be diagonal corners\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:250:# ── CFG: cross-pair rectangle shape ────────────────────────────────\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:265:def _cross_cells(center_r: int, center_c: int) -> list[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:269:def _cross_pair_cells(rmin: int, cmin: int, rmax: int, cmax: int, diag: str) -> list[tuple[int, int]]:\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:270:    \"\"\"Return the 10 cells for a pair of crosses whose centers sit on one rectangle diagonal.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:277:        cells.extend(_cross_cells(r, c))\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:282:    \"\"\"Pick a random valid fill-rectangle size for a cross pair.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:311:def _try_place_cross_pair(H: int, W: int, color: int, retries: int, can_place, do_place) -> bool:\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:312:    \"\"\"Try to place a cross pair of `color` on the grid within `retries` attempts.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/9385bd28/D2/1/code.py:327:        cells = _cross_pair_cells(rmin