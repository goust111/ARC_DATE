  79: # --------------- generator (o5x) ---------------
  80: 
  81: GEN_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)
  82: BACKGROUND_COLOR, MARKER_COLOR, ARC_COLOR_COUNT = 0, 8, 10
  83: 
  84: # Canvas and paired-marker layout bounds.
  85: NUM_PAIRS_MIN, NUM_PAIRS_HIGH = 1, 5
  86: GAP_WIDTH_MIN, GAP_WIDTH_HIGH = 3, 7
  87: GRID_HEIGHT_MIN, GRID_HEIGHT_HIGH = 12, 16
  88: MIN_GRID_WIDTH, GRID_WIDTH_HIGH = 10, 18
  89: MIN_WIDTH_GAP_PADDING, LEFT_COL_HIGH_MARGIN, MARKER_SIZE = 6, 9, 2
  90: ROW_GAP_MIN, ROW_GAP_HIGH = 1, 4
  91: 
  92: # Content densities and retry limits.
  93: STRIPE_DENSITY_MIN, STRIPE_DENSITY_MAX = 0.50, 0.75
  94: NON_MARKER_DENSITY_MIN, NON_MARKER_DENSITY_MAX = 0.35, 0.45
  95: MAX_GENERATION_ATTEMPTS = 300
