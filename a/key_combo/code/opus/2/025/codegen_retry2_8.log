+            gap_cands = side_cands
+        return gap_cands[int(rng.integers(len(gap_cands)))]
+    if plain:
+        return plain[int(rng.integers(len(plain)))]
+    if gap_cands:
+        return gap_cands[int(rng.integers(len(gap_cands)))]
