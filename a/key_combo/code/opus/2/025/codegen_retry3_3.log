+    side_cells = _side_coords(h, w, side)
+    if gap_mode == "center":
+        max_gap = 2 if len(side_cells) >= 5 else 1
+        gap_len = int(rng.integers(1, max_gap + 1))
+        gap = _center_gap(side_cells, gap_len)
