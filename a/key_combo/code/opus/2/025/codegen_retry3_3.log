+def _analyze_cup_patch(patch: np.ndarray, color: int, bg: int) -> dict:
+    arr = np.asarray(patch, dtype=int)
+    h, w = arr.shape
+    assert h >= 4 and w >= 4, "cups must be at least 4x4"
+
