+    side_rank = {"top": 3, "left": 2, "right": 1, "bottom": 0}
+    for side in ("top", "left", "right", "bottom"):
+        coords = _side_coords(h, w, side)
+        idxs = [i for i, coord in enumerate(coords) if coord in missing_border]
+        if not idxs or len(idxs) > 2:
