+    side: str,
+    gap_mode: str,
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    cup = np.zeros((h, w), dtype=int)
+    cup[0, :] = color
+    cup[-1, :] = color
+    cup[:, 0] = color
+    cup[:, -1] = color
