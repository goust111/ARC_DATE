+    alive_side_idx = int(rng.choice(remaining))
+    if alive_side_idx == 0:
+        side = "right"
+    else:
+        side = str(rng.choice(["left", "right"]))
+    roles[alive_side_idx] = {"side": side, "gap_mode": "center"}
+
+    if n >= 4 and rng.random() < 0.45:
+        extra_dead = [i for i in range(n - 1) if roles[i]["side"] is None]
+        if extra_dead:
