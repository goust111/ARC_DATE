     6	def _gap_direction(gap: tuple[int, int], bbox: tuple[int, int, int, int]) -> tuple[int, int]:
     7	    r, c = gap
     8	    r0, c0, r1, c1 = bbox
     9	    assert int(r in (r0, r1)) + int(c in (c0, c1)) == 1
    10	    if r == r0:
