+def _offset2(bounds: tuple[int, int, int, int], anchor: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bounds
+    ar, ac = anchor
+    return 2 * ar - (r0 + r1), 2 * ac - (c0 + c1)
