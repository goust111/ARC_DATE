+def _relative_map_from_shape(shape: set[tuple[int, int]], fg_color: int) -> dict[tuple[int, int], int]:
+    rel: dict[tuple[int, int], int] = {}
+    for r, c in shape:
+        rel[(int(r), int(c))] = GREY if (r, c) == (0, 0) else int(fg_color)
+    return rel
+
