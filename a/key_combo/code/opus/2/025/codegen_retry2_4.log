   488	def _gen_attempt() -> np.ndarray | None:
   489	    """Single generation attempt: build output, validate constraints, scatter, oracle check."""
   490	    out, bg, fcs = _make_output()
   491	    if out is None:
   492	        return None
   493	    if not np.array_equal(out, out[:, ::-1]):
   494	        return None
   495	    if not (_N_COLORS_MIN <= len(np.unique(out)) <= _N_COLORS_MAX):
   496	        return None
   497	    pc = _piece_count(out)
   498	    if not (_PIECE_COUNT_MIN <= pc <= _PIECE_COUNT_MAX):
   499	        return None
   500	    if any(len(pts) > _MAX_PIECE_AREA for col in np.unique(out)
   501	           for pts in components_mask(out == col, connectivity=4)):
   502	        return None
   503	    try:
   504	        inp = _scatter(out, bg, fcs)
   505	        got = main(inp)
   506	    except Exception:
   507	        return None
   508	    if np.array_equal(got, out):
   509	        return inp
   510	    return None
