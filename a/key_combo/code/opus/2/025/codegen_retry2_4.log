     5	def main(grid: np.ndarray) -> np.ndarray:
     6	    """
     7	    Reconstruct a 4-way symmetric mosaic by filling missing (black) pixels.
     8	
     9	    Input structure:
    10	    - A colored grid exhibiting bilateral symmetry along both a vertical and a horizontal axis.
    11	    - Some pixels are erased to color 0 (black), creating gaps in the pattern.
    12	
    13	    Rule:
    14	    - Infer the vertical and horizontal reflection axes from the visible (non-zero) pixels.
    15	    - For each black pixel, recover its color from the mirrored position across either axis or both.
    16	    - When multiple mirrors yield candidates, use the majority color.
    17	
    18	    Key insight: The reflection axes are not given — they must be deduced from the surviving pixels by finding the axes that best preserve the existing symmetry.
    19	    """
    20	    g = np.array(grid, dtype=int).copy()
    21	    H, W = g.shape
    22	    miss = 0
    23	    assert not (not bool((g == int(miss)).any()))
    24	
    25	    nz = g != int(miss)
    26	
    27	    # Find best vertical axis (a2 = 2*axis), minimizing mismatches on known cells.
    28	    best_a2 = 0
    29	    best_key = None
    30	    for a2 in range(0, 2 * (W - 1) + 1):
    31	        mism = 0
    32	        pairs = 0
    33	        for r in range(H):
    34	            cols = np.where(nz[int(r)])[0]
    35	            for c in cols:
    36	                c2 = int(a2) - int(c)
    37	                if 0 <= c2 < W and bool(nz[int(r), int(c2)]):
    38	                    pairs += 1
    39	                    if int(g[int(r), int(c)]) != int(g[int(r), int(c2)]):
    40	                        mism += 1
    41	        key = (int(mism), -int(pairs))
    42	        if best_key is None or key < best_key:
    43	            best_key = key
    44	            best_a2 = int(a2)
    45	
    46	    # Find best horizontal axis (b2 = 2*axis), minimizing mismatches on known cells.
    47	    best_b2 = 0
    48	    best_key = None
    49	    rows = np.where(nz.any(axis=1))[0]
    50	    for b2 in range(0, 2 * (H - 1) + 1):
    51	        mism = 0
    52	        pairs = 0
    53	        for r in rows:
    54	            r2 = int(b2) - int(r)
    55	            if not (0 <= r2 < H):
    56	                continue
    57	            cols = np.where(nz[int(r)] & nz[int(r2)])[0]
    58	            pairs += int(len(cols))
    59	            if len(cols):
    60	                mism += int(np.sum(g[int(r), cols] != g[int(r2), cols]))
    61	        key = (int(mism), -int(pairs))
    62	        if best_key is None or key < best_key:
    63	            best_key = key
    64	            best_b2 = int(b2)
    65	
    66	    out = g.copy()
    67	
    68	    def fill_once(cur: np.ndarray) -> bool:
    69	        changed = False
    70	        zeros = np.argwhere(cur == int(miss))
    71	        for r, c in zeros:
    72	            r = int(r)
    73	            c = int(c)
    74	            cand: list[int] = []
    75	
    76	            c2 = int(best_a2) - int(c)
    77	            if 0 <= c2 < W and int(cur[int(r), int(c2)]) != int(miss):
    78	                cand.append(int(cur[int(r), int(c2)]))
    79	
    80	            r2 = int(best_b2) - int(r)
    81	            if 0 <= r2 < H and int(cur[int(r2), int(c)]) != int(miss):
    82	                cand.append(int(cur[int(r2), int(c)]))
    83	
    84	            if 0 <= r2 < H and 0 <= c2 < W and int(cur[int(r2), int(c2)]) != int(miss):
    85	                cand.append(int(cur[int(r2), int(c2)]))
    86	
    87	            if cand:
    88	                cur[int(r), int(c)] = int(Counter(cand).most_common(1)[0][0])
    89	                changed = True
    90	        return bool(changed)
    91	
    92	    # Usually one pass suffices; do a few in case missing regions touch their mirrors.
    93	    for _ in range(5):
