+    if len(set(common_offsets)) != 3:
+        return False
+
+    counts = Counter()
+    for shape in common_shapes:
+        for cell in shape:
+            counts[cell] += 1
+    if not any(cnt >= 2 for cell, cnt in counts.items() if cell != (0, 0)):
+        return False
