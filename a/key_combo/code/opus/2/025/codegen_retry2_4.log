    28	def main(grid: np.ndarray) -> np.ndarray:
    29	    """Draw the green perimeter of the parallelogram whose opposite corners are the two marker pixels.
    30	
    31	    Input structure
    32	    - The input is a same-size canvas with a dominant background and exactly two foreground marker pixels of one color.
    33	    - The marker-to-marker offset has both row and column components, with unequal magnitudes.
    34	
    35	    Rule
    36	    - Decompose the vector between markers into a 45-degree diagonal vector plus the remaining horizontal/vertical vector.
    37	    - Treat those two vectors as adjacent sides of a parallelogram, with the markers as opposite corners.
    38	    - Paint the four sides green while preserving the marker pixels.
    39	
    40	    Key insight
    41	    - The outline is not a direct line interpolation; it is the perimeter of the parallelogram induced by the diagonal and axis-aligned parts of the marker offset.
    42	    """
    43	    g = np.asarray(grid, dtype=int)
    44	    bg = get_bg(g)
    45	    marker_colors = colors_present(g, exclude={bg})
    46	    assert len(marker_colors) == 1
    47	
    48	    marker_color = marker_colors[0]
    49	    marker_coords = coords_where(g == marker_color)
    50	    assert marker_coords.shape == (2, 2)
    51	    p = tuple(map(int, marker_coords[0]))
    52	    q = tuple(map(int, marker_coords[1]))
    53	
    54	    dr = q[0] - p[0]
    55	    dc = q[1] - p[1]
    56	    abs_dr = abs(dr)
    57	    abs_dc = abs(dc)
    58	    assert abs_dr > 0
    59	    assert abs_dc > 0
    60	    assert abs_dr != abs_dc
    61	
    62	    diag_len = min(abs_dr, abs_dc)
    63	    straight_len = abs(abs_dr - abs_dc)
    64	    sr = _sign(dr)
    65	    sc = _sign(dc)
    66	
    67	    if abs_dr > abs_dc:
    68	        straight_vec = (sr * straight_len, 0)
    69	    else:
    70	        straight_vec = (0, sc * straight_len)
    71	    diag_vec = (sr * diag_len, sc * diag_len)
    72	
    73	    straight_corner = (p[0] + straight_vec[0], p[1] + straight_vec[1])
    74	    diag_corner = (p[0] + diag_vec[0], p[1] + diag_vec[1])
    75	
    76	    out = g.copy()
    77	    for a, b in ((p, straight_corner), (p, diag_corner), (straight_corner, q), (diag_corner, q)):
    78	        for r, c in _segment_cells(a, b):
    79	            assert in_bounds(g.shape, r, c)
    80	            if g[r, c] != marker_color:
    81	                out[r, c] = Color.GREEN
    82	
    83	    return out
