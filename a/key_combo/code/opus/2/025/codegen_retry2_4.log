   100	def generate_input() -> np.ndarray:
   101	    miss = 0
   102	    H = int(np.random.randint(10, 18))
   103	    W = int(np.random.randint(10, 18))
   104	
   105	    # Symmetry axes through the center: a2 = W-1, b2 = H-1.
   106	    a2 = int(W - 1)
   107	    b2 = int(H - 1)
   108	
   109	    pal = list(range(1, 10))
   110	    g = np.full((H, W), int(miss), dtype=int)
   111	
   112	    # Fill by orbit representatives under (r,c)->(r,b2-r) and (r,c)->(r,a2-c).
   113	    seen = set()
   114	    for r in range(H):
   115	        for c in range(W):
   116	            if (int(r), int(c)) in seen:
   117	                continue
   118	            orbit = {
   119	                (int(r), int(c)),
   120	                (int(r), int(a2 - c)),
   121	                (int(b2 - r), int(c)),
   122	                (int(b2 - r), int(a2 - c)),
   123	            }
   124	            orbit = {(rr, cc) for (rr, cc) in orbit if 0 <= rr < H and 0 <= cc < W}
   125	            col = int(pal[int(np.random.randint(0, len(pal)))])
   126	            for rr, cc in orbit:
   127	                g[int(rr), int(cc)] = int(col)
   128	                seen.add((int(rr), int(cc)))
   129	
   130	    # Punch missing holes.
   131	    n_holes = int(np.random.randint(max(1, (H * W) // 10), max(2, (H * W) // 4)))
   132	    idx = np.random.choice(H * W, size=n_holes, replace=False)
   133	    for k in idx:
   134	        r = int(k // W)
   135	        c = int(k % W)
   136	        g[int(r), int(c)] = int(miss)
   137	
   138	    # Ensure at least one non-missing pixel remains.
   139	    if not bool((g != int(miss)).any()):
   140	        g[int(H // 2), int(W // 2)] = 1
   141	    return g
