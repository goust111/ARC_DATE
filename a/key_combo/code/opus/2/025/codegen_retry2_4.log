+    solid_pixels = int(np.sum(actual != BLACK))
+    if not (1 <= overlap_pixels < solid_pixels):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    top = random.randint(6, 9)
+    bottom = random.randint(6, 9)
+    left = random.randint(6, 9)
+    right = random.randint(6, 9)
