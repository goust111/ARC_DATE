+                "coords": coords,
+                "bbox": box,
+                "fg": int(fg_color),
+                "anchor": grey_cells[0],
+                "patch": patch,
+            }
+        )
+    assert len(infos) == 4
+    split = _find_separator_pair(grid, infos)
+    assert split is not None
+    return infos, split
