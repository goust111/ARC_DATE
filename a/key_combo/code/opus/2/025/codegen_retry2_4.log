   103	    max_abs_dr = min(ABS_DR_RANGE[1], h - EDGE_PADDING)
   104	    max_abs_dc = min(ABS_DC_RANGE[1], w - EDGE_PADDING)
   105	    for abs_dr in range(ABS_DR_RANGE[0], max_abs_dr + 1):
