+        return None
+
+    out = main(grid)
+    in_sig = _array_sig(grid)
+    out_sig = _array_sig(out)
+    if in_sig in _SEEN_INPUT_SIGS or out_sig in _SEEN_OUTPUT_SIGS:
+        return None
+    _SEEN_INPUT_SIGS.add(in_sig)
+    _SEEN_OUTPUT_SIGS.add(out_sig)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
