+def _extract_sprites(grid: np.ndarray) -> tuple[list[dict], tuple[int, int]]:
+    comps = _components(grid != BLACK)
+    infos: list[dict] = []
+    for coords in comps:
+        colors = sorted({int(grid[int(r), int(c)]) for r, c in coords if int(grid[int(r), int(c)]) != BLACK})
