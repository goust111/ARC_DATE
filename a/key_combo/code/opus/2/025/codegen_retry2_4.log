   117	def _gen_choose_sizes(n, lo, hi, max_sum):
   118	    min_sum = n * lo
   119	    max_sum = min(max_sum, n * hi)
   120	    if max_sum < min_sum:
   121	        return None
   122	    total = np.random.randint(min_sum, max_sum + 1)
   123	    sizes = [lo] * n
   124	    extra = total - min_sum
   125	    while extra:
   126	        choices = [i for i, size in enumerate(sizes) if size < hi]
   127	        i = int(np.random.choice(choices))
   128	        add = np.random.randint(1, min(hi - sizes[i], extra) + 1)
   129	        sizes[i] += int(add)
   130	        extra -= int(add)
   131	    np.random.shuffle(sizes)
   132	    return sizes
