+        cells = set(base)
+        while len(cells) < target_size:
+            frontier = _shape_frontier(cells)
+            if not frontier:
+                break
+            cells.add(random.choice(frontier))
+        if len(cells) != target_size:
+            continue
+        sig = _shape_signature(cells)
+        if sig in banned:
+            continue
+        if not _is_irregular_shape(cells):
+            continue
+        return cells
+    return None
+
