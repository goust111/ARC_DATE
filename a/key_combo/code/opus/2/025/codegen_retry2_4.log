    22	def _build_requirements(
    23	    H: int,
    24	    W: int,
    25	    comps_by_color: dict[int, list[list[tuple[int, int]]]],
    26	) -> np.ndarray:
    27	    """
    28	    Build per-cell required color constraints (req[r,c] == -1 means unconstrained).
    29	
    30	    Heuristics supported by training examples:
    31	      - If there is a color with exactly 4 singleton components, those are the four corners.
    32	      - If there are full horizontal bars of length W-2 in the input, use them as the top/bottom edges
    33	        between the corners (ordered by their vertical position in the input).
    34	      - If there is a color with exactly two full vertical line components (width=1) in the input,
    35	        place them on the left/right edges centered vertically.
    36	    """
    37	    req = np.full((H, W), -1, dtype=int)
    38	
    39	    # 4 singleton components -> corners
    40	    corner_colors = [
    41	        col
    42	        for col, comps in comps_by_color.items()
    43	        if len(comps) == 4 and all(len(p) == 1 for p in comps)
    44	    ]
    45	    assert len(corner_colors) <= 1, "corner singleton color must be unique when present"
    46	    corner_color = corner_colors[0] if corner_colors else None
    47	    if corner_color is not None:
    48	        req[0, 0] = corner_color
    49	        req[0, W - 1] = corner_color
    50	        req[H - 1, 0] = corner_color
    51	        req[H - 1, W - 1] = corner_color
    52	
    53	    # Horizontal bar(s) of length W-2 (filled, height 1)
    54	    bar_colors: list[tuple[int, int]] = []  # (min_input_row, color)
    55	    if W >= 3 and corner_color is not None:
    56	        for col, comps in comps_by_color.items():
    57	            for pts in comps:
    58	                r0, c0, r1, c1 = bbox_coords(pts)
    59	                hh, ww = r1 - r0 + 1, c1 - c0 + 1
    60	                if hh == 1 and ww == (W - 2) and len(pts) == ww:
    61	                    bar_colors.append((r0, col))
    62	                    break
    63	        if bar_colors:
    64	            assert len(bar_colors) <= 2, "horizontal edge bar colors must be top/bottom only"
    65	            bar_colors.sort()
    66	            top_col = bar_colors[0][1]
    67	            bot_col = bar_colors[-1][1]
    68	            req[0, 1 : W - 1] = top_col
    69	            req[H - 1, 1 : W - 1] = bot_col
    70	
    71	    # Two full vertical line components -> left/right edges, centered vertically
    72	    vertical_line_candidates = []
    73	    for col, comps in comps_by_color.items():
    74	        if len(comps) != 2:
    75	            continue
    76	        sigs = [_piece_sig(pts) for pts in comps]
    77	        (h0, w0, coords0), (h1, w1, coords1) = sigs[0], sigs[1]
    78	        if w0 == 1 and w1 == 1 and h0 == h1 and coords0 == coords1 and h0 > 1:
    79	            vertical_line_candidates.append((col, h0))
    80	    assert len(vertical_line_candidates) <= 1, "paired vertical edge-line color must be unique when present"
    81	    if vertical_line_candidates:
    82	        col, L = vertical_line_candidates[0]
    83	        top = (H - L) // 2
    84	        assert 0 <= top and top + L <= H, "paired vertical edge lines must fit in the output height"
    85	        req[top : top + L, 0] = col
    86	        req[top : top + L, W - 1] = col
    87	
    88	    return req
