+        sprite_draw_coords[quadrant] = coords_arr
+        sprite_info[quadrant] = (centered_mask, int(color))
+        expected_binary[quadrant] = actual
+
+    if not _semantic_checks(template_binary, sprite_specs, centered_masks, expected_binary):
