+    frame_top = (q - 5) // 2
+    frame_left = (q - 5) // 2
+    frame = np.full((5, 5), FRAME_COLOR, dtype=int)
+    frame[1:-1, 1:-1] = BACKGROUND
+
+    for quadrant, color in zip(("tr", "bl", "br"), (sprite_info["tr"][1], sprite_info["bl"][1], sprite_info["br"][1])):
+        patch = np.zeros((q, q), dtype=int)
