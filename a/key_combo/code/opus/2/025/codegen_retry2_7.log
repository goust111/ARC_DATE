+def _shape_to_centered_mask(spec: dict[str, object], shift: tuple[int, int], q: int) -> tuple[np.ndarray, np.ndarray]:
+    frame_top = (q - 5) // 2
+    frame_left = (q - 5) // 2
+    sprite_coords = []
