+def _obstacle_far_from_squares(cell: tuple[int, int], squares: list[tuple[int, int]]) -> bool:
+    r, c = cell
+    for square in squares:
+        for sr, sc in _square_cells(square):
+            if abs(r - sr) + abs(c - sc) < 3:
+                return False
+    return True
+
