+    grid = np.zeros(shape, dtype=int)
+    for r0, c0 in squares:
+        grid[r0 : r0 + 2, c0 : c0 + 2] = SQUARE_COLOR
+    for r, c in obstacles:
+        grid[r, c] = OBSTACLE_COLOR
+    return grid
+
