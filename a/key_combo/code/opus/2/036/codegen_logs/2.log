+def _square_cells(square: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0 = square
+    return [(r0 + dr, c0 + dc) for dr in range(2) for dc in range(2)]
+
+
+def _marker_specs(square: tuple[int, int]) -> list[dict]:
+    r0, c0 = square
