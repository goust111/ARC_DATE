            tile = np.full((5, 5), fill_color, dtype=int)
            tile[completed[(slot_r, slot_c)]] = marker_color
            r0 = 1 + 6 * tile_r
            c0 = 1 + 6 * tile_c
            out[r0 : r0 + 5, c0 : c0 + 5] = tile
    return out

