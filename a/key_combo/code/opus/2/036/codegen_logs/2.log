+                    "marker": spec["marker"],
+                    "direction": spec["direction"],
+                    "color": spec["color"],
+                    "path": path,
+                }
+            )
+    return rays
+
+
+def _find_squares(grid: np.ndarray) -> list[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
