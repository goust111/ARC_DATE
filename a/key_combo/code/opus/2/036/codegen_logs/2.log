+def _isolated(cell: tuple[int, int], others: set[tuple[int, int]]) -> bool:
+    r, c = cell
+    for rr, cc in others:
+        if max(abs(r - rr), abs(c - cc)) <= 1:
+            return False
+    return True
+
+
+def _build_grid(
+    shape: tuple[int, int],
+    squares: list[tuple[int, int]],
+    obstacles: set[tuple[int, int]],
