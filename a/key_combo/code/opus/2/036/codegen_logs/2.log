+        (0, "nw"),
+        (0, "sw"),
+        (square_count - 1, "ne"),
+        (square_count - 1, "se"),
+    }
+    return [ray for ray in rays if (ray["square_index"], ray["name"]) in wanted]
+
+
+def _choose_single_obstacles(
+    rays: list[dict],
+    square_count: int,
+    existing: set[tuple[int, int]],
