+        out[mr, mc] = ray["color"]
+
+    for ray in rays:
+        path, stop_type, stop_coord = _trace_ray(g.shape, ray["marker"], ray["direction"], blockers, obstacles)
+        for r, c in path:
+            out[r, c] = ray["color"]
+        if stop_type == "obstacle" and stop_coord is not None:
+            hits[stop_coord].append(ray["color"])
