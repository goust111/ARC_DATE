+    "hbar_top": ((-1, -1), (-1, 1)),
+    "hbar_bottom": ((1, -1), (1, 1)),
+    "vbar_left": ((-1, -1), (1, -1)),
+    "vbar_right": ((-1, 1), (1, 1)),
