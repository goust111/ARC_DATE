    if np.array_equal(main(inp), out):
        return inp
    return None


def generate_input():
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate d6e50e54 input")

