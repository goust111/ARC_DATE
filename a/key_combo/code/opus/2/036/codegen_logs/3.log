+        "TR": (slice(0, sr), slice(sc + 1, None)),
+        "BL": (slice(sr + 1, None), slice(0, sc)),
+        "BR": (slice(sr + 1, None), slice(sc + 1, None)),
+    }
+
+
+def _quadrant_of(r: int, c: int, sr: int, sc: int) -> str:
