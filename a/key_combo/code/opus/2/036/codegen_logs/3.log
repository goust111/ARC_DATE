+from arc_utils import bbox, in_bounds
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+DOMINANT_COLORS = (BLUE, RED, GREEN, YELLOW)
+NOISE_COLORS = (BLUE, RED, GREEN, YELLOW, MAGENTA, TEAL)
