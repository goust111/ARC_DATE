85:    assert len(fg_colors) == 2, "expected exactly two nonblack tile colors"
86:    counts = Counter(int(v) for v in g.ravel() if int(v) != Color.BLACK)
87:    assert counts[fg_colors[0]] != counts[fg_colors[1]], "fill and marker colors must be frequency-distinct"
88:    fill_color, marker_color = (color for color, _ in counts.most_common())
