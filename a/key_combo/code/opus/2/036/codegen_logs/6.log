6:def main(grid: np.ndarray) -> np.ndarray:
7:    """
8:    Extend the eight non-center cells of a filled 3x3 block as rays to the grid edge.
9:
10:    Input structure
11:    - The background is the dominant color.
12:    - All foreground pixels form exactly one filled 3x3 block.
13:    - The middle cell of that block is the center, and the other eight cells are compass-direction ray seeds.
14:
15:    Rule
16:    - Keep the input grid unchanged as the base output.
17:    - For each non-center cell in the 3x3 block, continue its color away from the center in that cell's compass direction.
18:    - Paint that ray through the starting cell and onward until it leaves the grid.
19:
20:    Key insight
21:    - The local position of a cell around the 3x3 center is also its global ray direction.
22:    """
23:    g = np.asarray(grid, dtype=int)
24:    bg = get_bg(g)
25:    box = bbox(g != bg)
26:    assert box is not None
27:    assert bbox_h(box) == 3
28:    assert bbox_w(box) == 3
29:
30:    r0, c0, r1, c1 = box
31:    block = g[r0 : r1 + 1, c0 : c1 + 1]
32:    assert np.all(block != bg)
33:
34:    center_r = r0 + 1
35:    center_c = c0 + 1
36:    H, W = g.shape
37:    out = g.copy()
38:
39:    for dr in (-1, 0, 1):
40:        for dc in (-1, 0, 1):
41:            if dr == 0 and dc == 0:
42:                continue
43:            color = int(g[center_r + dr, center_c + dc])
44:            r = center_r + dr
45:            c = center_c + dc
46:            while 0 <= r < H and 0 <= c < W:
47:                out[r, c] = color
48:                r += dr
49:                c += dc
50:
51:    return out
