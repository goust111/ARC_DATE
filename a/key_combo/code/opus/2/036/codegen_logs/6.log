91:    for tile_r in range(3):
92:        for tile_c in range(3):
93:            r0 = 1 + 6 * tile_r
94:            c0 = 1 + 6 * tile_c
95:            tile = g[r0 : r0 + 5, c0 : c0 + 5]
96:            assert set(map(int, np.unique(tile))).issubset({fill_color, marker_color})
