+def _sample_counts(n_colors: int) -> list[int]:
+    if n_colors == 2:
+        return list(random.choice(((3, 3), (4, 2), (4, 3))))
+    return list(random.choice(((3, 2, 2), (4, 2, 2), (3, 3, 2), (4, 3, 2))))
