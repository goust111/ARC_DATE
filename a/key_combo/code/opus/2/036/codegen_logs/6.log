+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+TASK_COLORS = (BLUE, RED, GREEN)
+
+LEGEND_BOX_WIDTH = 9
+GEN_RETRY_LIMIT = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    values = Counter(map(int, grid.ravel()))
+    return int(values.most_common(1)[0][0])
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    return bbox_coords(coords)
+
+
+def _connected_components(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _find_legend_box(grid: np.ndarray) -> tuple[int, int, int, int]:
+    grey_mask = grid == GREY
+    box = bbox(grey_mask)
+    assert box is not None, "expected a grey legend frame"
+    r0, c0, r1, c1 = box
+
+    border = np.zeros_like(grey_mask)
+    border[r0, c0 : c1 + 1] = True
+    border[r1, c0 : c1 + 1] = True
+    border[r0 : r1 + 1, c0] = True
+    border[r0 : r1 + 1, c1] = True
