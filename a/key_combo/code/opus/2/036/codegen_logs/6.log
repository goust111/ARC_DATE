+    assert g.ndim == 2 and max(g.shape) <= 30
+    assert get_bg(g) == BG
+
+    analysis = _analyze_instance(g)
+    out = _render_legend(analysis["slidden"], analysis["box"], analysis["keys"], analysis["final_counts"])
+    return out
+
