+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+ORANGE = 7
+MAROON = 9
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+FRAME_INTERIORS = tuple(
+    (h, w)
+    for h in range(1, 5)
+    for w in range(1, 5)
+    if 2 <= h * w <= 8
+)
