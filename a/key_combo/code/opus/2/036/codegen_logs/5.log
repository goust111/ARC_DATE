+                max_c0 = w - GEN_MARGIN - 3 - gap - blocker_len
+                if min_c0 > max_c0:
+                    continue
+                driver_c0 = random.randint(min_c0, max_c0)
+                blocker_c0 = driver_c0 + 3 + gap
