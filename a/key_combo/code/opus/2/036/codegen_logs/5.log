+def _box_inside(shape: tuple[int, int], bbox: tuple[int, int, int, int], margin: int = GEN_MARGIN) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return margin <= r0 and margin <= c0 and r1 <= h - 1 - margin and c1 <= w - 1 - margin
