+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+PALETTE = (1, 2, 3, 4)
+LONG_SIDES = (5, 7, 9, 11)
+GEN_MARGIN = 1
+GEN_CLEARANCE = 2
+GEN_GRID_MIN = 15
+GEN_GRID_MAX = 21
+GEN_MAX_ATTEMPTS = 500
+GEN_CORE_ATTEMPTS = 200
+GEN_EXTRA_ATTEMPTS = 200
