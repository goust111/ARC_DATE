+def _hole_cells(rect: dict) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect["bbox"]
+    box_h = r1 - r0 + 1
+    box_w = c1 - c0 + 1
+    if box_w > box_h:
+        center_r = r0 + box_h // 2
+        return [(center_r, c) for c in range(c0 + 1, c1, 2)]
+    center_c = c0 + box_w // 2
+    return [(r, center_c) for r in range(r0 + 1, r1, 2)]
