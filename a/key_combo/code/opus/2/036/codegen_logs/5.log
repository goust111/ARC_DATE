+
+            coord_array = np.array(coords, dtype=int)
+            r0 = int(coord_array[:, 0].min())
+            c0 = int(coord_array[:, 1].min())
+            r1 = int(coord_array[:, 0].max())
+            c1 = int(coord_array[:, 1].max())
+            box_h = r1 - r0 + 1
+            box_w = c1 - c0 + 1
