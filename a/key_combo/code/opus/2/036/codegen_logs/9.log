    return mask


def _gen_edge_seed() -> np.ndarray:
    bits = random.choice(_GEN_EDGE_BIT_CHOICES)
    mask = np.zeros(_GEN_TILE_SHAPE, dtype=bool)
    bit_i = 0
    for r in _GEN_EDGE_FREE_ROWS:
