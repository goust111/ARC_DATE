+
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+BG = Color.BLACK
+FG = Color.BLUE
+RAY = Color.RED
+
+GRID_ROWS_RANGE = (13, 19)
+GRID_COLS_RANGE = (13, 19)
