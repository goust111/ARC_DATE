# Grid/tile geometry.
_GEN_TILE_SIZE = 5
_GEN_TILE_SHAPE = (_GEN_TILE_SIZE, _GEN_TILE_SIZE)
_GEN_TILE_STRIDE, _GEN_TILE_OFFSET, _GEN_GRID_TILES = 6, 1, 3
_GEN_CANVAS_SHAPE = (19, 19)
_GEN_SLOT_VALUES = (-1, 0, 1)
_GEN_SLOTS = SLOTS
