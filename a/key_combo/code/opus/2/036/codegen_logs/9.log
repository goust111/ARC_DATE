        m &= (patch_view != int(transparent))
        if not overwrite:
            m &= (dst_view == int(transparent))
    else:
        if not overwrite:
            raise ValueError("paste: overwrite=False requires transparent to be set")

    dst_view[m] = patch_view[m]
    return dst


