            masks[slot] = center_mask
        elif slot[0] != 0 and slot[1] != 0:
            masks[slot] = _gen_orbit_mask(corner_seed, _GEN_CORNER_SRC_SLOT, slot)
        else:
            masks[slot] = _gen_orbit_mask(edge_seed, _GEN_EDGE_SRC_SLOT, slot)
