def _gen_split_slack(extra: int, slots: int) -> list[int]:
    cuts = sorted(random.randint(0, extra) for _ in range(slots - 1))
    parts = []
    prev = 0
    for cut in cuts + [extra]:
        parts.append(cut - prev)
        prev = cut
    random.shuffle(parts)
