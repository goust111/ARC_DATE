+def _paint_rays(base: np.ndarray, ray_sources: list[tuple[tuple[int, int], tuple[int, int]]]) -> np.ndarray:
+    out = base.copy()
+    for (r, c), (dr, dc) in ray_sources:
+        rr, cc = r + dr, c + dc
+        while in_bounds(out.shape, rr, cc):
+            out[rr, cc] = RAY
+            rr += dr
+            cc += dc
