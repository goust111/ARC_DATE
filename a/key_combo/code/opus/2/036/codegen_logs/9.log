        inp = np.rot90(inp, turns)
        expected = np.rot90(expected, turns)
    if random.choice(FLIP_OPTIONS):
        inp = np.fliplr(inp)
        expected = np.fliplr(expected)
    return inp, expected

def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GRID_SIDE_MIN, GRID_SIDE_MAX)
