+    weighted: list[int] = []
+    if 0 in valid:
+        weighted.extend([0] * (4 if idx == 2 else 3))
+    if 1 in valid and idx >= 2:
+        weighted.extend([1] * 2)
+    if 2 in valid and idx >= 3:
+        weighted.append(2)
+    if not weighted:
+        return []
