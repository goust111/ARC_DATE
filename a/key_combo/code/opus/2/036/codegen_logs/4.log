+    30: ((5, 6), (6, 5)),
+    25: ((5, 5),),
+    24: ((4, 6), (6, 4)),
+    20: ((4, 5), (5, 4)),
+    18: ((3, 6), (6, 3)),
+    16: ((4, 4),),
+    15: ((3, 5), (5, 3)),
+    12: ((3, 4), (4, 3)),
+    10: ((2, 5), (5, 2)),
+    9: ((3, 3),),
+    8: ((2, 4), (4, 2)),
+    6: ((2, 3), (3, 2)),
