+            remaining = cavity_area - int(p1["area"]) - int(p2["area"])
+            if remaining <= 0:
+                continue
+            pair = sorted((p1, p2), key=lambda item: item["col_range"][0])
+            options.append({"placements": pair, "remaining": remaining})
+
+    return options
+
+
+def _choose_container_plan(target_parity: int) -> dict:
