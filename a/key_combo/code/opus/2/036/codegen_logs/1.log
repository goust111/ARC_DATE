+
+    fill_parities: list[int] = []
+    for container in containers:
+        r0, c0, r1, c1 = container["cavity_bbox"]
+        black_count = int(np.sum(out[r0 : r1 + 1, c0 : c1 + 1] == Color.BLACK))
+        if black_count != 0:
+            return None
+        red_count = int(np.sum(out[r0 : r1 + 1, c0 : c1 + 1] == Color.RED))
+        orange_count = int(np.sum(out[r0 : r1 + 1, c0 : c1 + 1] == Color.ORANGE))
+        if red_count and orange_count:
+            continue
+        fill_parities.append(0 if red_count else 1)
+    if 0 not in fill_parities or 1 not in fill_parities:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid gravity-parity input")

