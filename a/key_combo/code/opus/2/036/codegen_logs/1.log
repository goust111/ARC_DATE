+    if base_height > 30:
+        return None
+    height = base_height + random.randint(0, min(3, 30 - base_height))
+
+    grid = np.zeros((height, width), dtype=int)
+    bottom = height - 1 - bottom_margin
+
+    block_specs: list[dict] = []
+    c = 1 + gap_slack[0]
+    for i, plan in enumerate(plans):
