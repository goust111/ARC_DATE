+
+    try:
+        containers = _detect_containers(grid)
+        if len(containers) != container_count:
+            return None
+        blocks = _find_components(grid, (Color.RED, Color.GREEN, Color.YELLOW))
+        if len(blocks) != len(block_specs):
+            return None
+        out = main(grid)
