    inp, frames = placed
    expected = _gen_expected_output(inp, frames)
    inp, expected = _gen_random_orientation(inp, expected)
    try:
        actual = main(inp)
    except AssertionError:
        return None
    if not np.array_equal(actual, expected):
        return None
    return inp

