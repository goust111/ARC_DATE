+def _pattern_slot(coords: Iterable[tuple[int, int]]) -> tuple[int, int]:
+    row_sum = 0
+    col_sum = 0
+    for r, c in coords:
+        row_sum += r - 2
+        col_sum += c - 2
+    return _sign(row_sum), _sign(col_sum)
