+            continue
+        for r, c in cells:
+            grid[r, c] = 3
+        occupied |= halo
+        return True
+    return False
+
+
+def _generate_case(rng: random.Random):
+    h = rng.randint(18, 27)
+    w = rng.randint(18, 27)
