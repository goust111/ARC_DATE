+            cm = c0 + iw // 2
+            expected[r0:rm, c0:cm] = colors[0]
+            expected[r0:rm, cm : c0 + iw] = colors[1]
+            expected[rm : r0 + ih, c0:cm] = colors[2]
+            expected[rm : r0 + ih, cm : c0 + iw] = colors[3]
