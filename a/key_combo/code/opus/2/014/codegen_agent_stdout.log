+            c0 = rng.randint(2, w - iw - 3)
+            top = r0 - 1
+            left = c0 - 1
+            bottom = r0 + ih
+            right = c0 + iw
+            ring = set()
+            for c in range(left, right + 1):
+                ring.add((top, c))
+                ring.add((bottom, c))
+            for r in range(top, bottom + 1):
+                ring.add((r, left))
+                ring.add((r, right))
+            markers = [
+                (top - 1, left - 1),
+                (top - 1, right + 1),
+                (bottom + 1, left - 1),
+                (bottom + 1, right + 1),
+            ]
+            footprint = set(ring) | set(markers)
+            halo = set()
+            for r, c in footprint:
+                for nr in range(r - 1, r + 2):
+                    for nc in range(c - 1, c + 2):
