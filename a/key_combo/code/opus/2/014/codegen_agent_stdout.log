+def _build_active(seed_mask, n):
+    m = n * n
+    active = np.zeros((m, m), dtype=bool)
+    for i in range(n):
+        for j in range(n):
+            if seed_mask[i, j]:
+                active[i * n : (i + 1) * n, j * n : (j + 1) * n] = True
+    return active
