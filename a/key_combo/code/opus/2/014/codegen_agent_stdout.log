+        elif gap_side == "bottom":
+            gap = (r0 + oh - 1, rng.randint(c0 + 1, c0 + ow - 2))
+        elif gap_side == "left":
+            gap = (rng.randint(r0 + 1, r0 + oh - 2), c0)
+        else:
+            gap = (rng.randint(r0 + 1, r0 + oh - 2), c0 + ow - 1)
+        cells.remove(gap)
+        halo = set()
+        for r, c in cells:
+            for nr in range(r - 1, r + 2):
