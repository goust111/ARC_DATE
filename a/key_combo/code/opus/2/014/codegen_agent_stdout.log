+        out[rm : r1 + 1, c0:cm] = colors[2]
+        out[rm : r1 + 1, cm : c1 + 1] = colors[3]
+        for mr, mc in marker_positions:
+            out[mr, mc] = 0
+    return out
+
+
+def _draw_open_shape(grid, rng, occupied):
