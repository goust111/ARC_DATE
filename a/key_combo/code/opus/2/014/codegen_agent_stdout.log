+        for oc in obstacle_cols:
+            orow = rng.randint(0, max(0, top - 1))
+            grid[orow, oc] = 9
+            expected[orow, oc] = 9
+        shadow = set(obstacle_cols)
+        for r in range(top - 1, -1, -1):
