+    bottom[0, total_w // 2 - 1] = 2
+    left[center_h // 2, 0] = 2
+    right[center_h // 2 - 1, 0] = 2
+    center[0, center_w // 2] = 2
+    center[-1, center_w // 2 - 1] = 2
+    center[center_h // 2, 0] = 2
+    center[center_h // 2 - 1, -1] = 2
+    pieces = [top, bottom, left, right, center]
