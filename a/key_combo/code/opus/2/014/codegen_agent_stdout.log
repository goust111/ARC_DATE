+        if c1 > c0:
+            for r in range(r1 - 1, r0, -1):
+                pos.append((r, c0))
+        perim = [rect[r, c] for r, c in pos if rect[r, c] != 6]
+        if not perim:
+            break
+        colors.append(max(set(perim), key=perim.count))
+        bounds.append((r0, c0, r1, c1))
+        r0 += 1
+        c0 += 1
+        r1 -= 1
