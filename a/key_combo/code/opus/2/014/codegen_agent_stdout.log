+            if grid[r, c] == 3 and expected[r, c] == 0:
+                expected[r, c] = 3
+    return grid, main(grid)
+
+
+def generate_input() -> np.ndarray:
+    return _generate_case(random.Random(random.randrange(1 << 30)))[0]
