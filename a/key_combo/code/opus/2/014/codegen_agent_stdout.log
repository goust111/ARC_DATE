+        seed_r = h - 5
+        seed_c = (c0 + c1 - 1) // 2
+        grid[seed_r, seed_c] = 7
+        expected[top : h - 3, c0:c1] = 7
+        obstacle_count = rng.randint(0, min(2, c1 - c0))
+        obstacle_cols = rng.sample(range(c0, c1), obstacle_count)
+        for oc in obstacle_cols:
+            orow = rng.randint(0, max(0, top - 1))
+            grid[orow, oc] = 9
