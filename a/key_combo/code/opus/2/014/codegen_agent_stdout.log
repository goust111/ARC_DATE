+        ow = rng.randint(4, 8)
+        r0 = rng.randint(1, h - oh - 2)
+        c0 = rng.randint(1, w - ow - 2)
+        cells = {(r0, c) for c in range(c0, c0 + ow)}
+        cells |= {(r0 + oh - 1, c) for c in range(c0, c0 + ow)}
+        cells |= {(r, c0) for r in range(r0, r0 + oh)}
+        cells |= {(r, c0 + ow - 1) for r in range(r0, r0 + oh)}
