+            break
+    rects = [{"bbox": bbox, "color": color, "key": ((bbox[0] if blue_horizontal else bbox[1]), (bbox[1] if blue_horizontal else bbox[0]))} for bbox, color in placed]
+    rects.sort(key=lambda item: item["key"])
+    top_parts = []
+    bottom_parts = []
+    for info in rects:
