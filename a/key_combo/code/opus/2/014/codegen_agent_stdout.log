+    cols = [c for _, c in cells]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    piece = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    colors = [grid[r, c] for r, c in cells if grid[r, c] not in (2, 6)]
