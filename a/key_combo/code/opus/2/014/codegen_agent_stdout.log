+def _reverse_layers(rect):
+    out = rect.copy()
+    colors = []
+    bounds = []
+    r0, c0 = 0, 0
+    r1, c1 = rect.shape[0] - 1, rect.shape[1] - 1
+    while r0 <= r1 and c0 <= c1:
+        perim = []
+        pos = []
+        for c in range(c0, c1 + 1):
+            pos.append((r0, c))
+        for r in range(r0 + 1, r1 + 1):
+            pos.append((r, c1))
+        if r1 > r0:
+            for c in range(c1 - 1, c0 - 1, -1):
