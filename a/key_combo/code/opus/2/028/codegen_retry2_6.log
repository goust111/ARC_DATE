+    grid = np.full((height, 2 * width + 1), BG, dtype=int)
+    grid[:, :width] = left
+    grid[:, width] = SEPARATOR_COLOR
+    grid[:, width + 1 :] = np.fliplr(right_fold)
+    return grid
