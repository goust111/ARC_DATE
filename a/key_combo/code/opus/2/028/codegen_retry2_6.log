+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+LEFT_COLOR = 1
+RIGHT_COLOR = 3
+SEPARATOR_COLOR = 5
+RAY_COLOR = 7
+
+HEIGHT_RANGE = (9, 13)
+HALF_WIDTH_RANGE = (5, 7)
+SHAPE_SIZE_RANGE = (6, 10)
