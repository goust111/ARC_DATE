+def _folded_output(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    _, left, right_input, bg = _decode_scene(grid)
+    mid = _fold_xor(left, right_input, bg)
+    out = _apply_rays(mid, bg)
