+    source = {(int(r), int(c)) for r, c in np.argwhere(mid != BG)}
+    for r, c in source:
+        dr, dc = _nearest_direction(r, c, height, width)
+        rr, cc = r + dr, c + dc
+        while 0 <= rr < height and 0 <= cc < width:
