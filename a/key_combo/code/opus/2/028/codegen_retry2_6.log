+def _direction_count(mid: np.ndarray) -> int:
+    height, width = map(int, mid.shape)
+    return len(
+        {
+            _direction_name(_nearest_direction(r, c, height, width))
+            for r, c, _ in _survivor_data(mid)
+        }
+    )
