+def _naive_fold_union(left: np.ndarray, right_input: np.ndarray, bg: int) -> np.ndarray:
+    right = np.fliplr(right_input)
+    out = left.copy()
+    mask = right != bg
+    out[mask] = right[mask]
+    return out
