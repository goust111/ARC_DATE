+    out = np.full(left.shape, bg, dtype=int)
+    left_fg = left != bg
+    right_fg = right != bg
+    out[left_fg & ~right_fg] = left[left_fg & ~right_fg]
+    out[right_fg & ~left_fg] = right[right_fg & ~left_fg]
+    return out
