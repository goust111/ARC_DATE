+    holes: set[tuple[int, int]] = set()
+
+    main_dc = random.choice((-1, 1))
+    if main_dc == -1:
+        main_cols = [c for c in range(1, rect_w - 1) if 2 <= c <= min(4, rect_w - 2)]
+    else:
