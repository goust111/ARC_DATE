+
+def find_components(grid: np.ndarray, colors: tuple[int, ...]) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    wanted = {int(color) for color in colors}
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if seen[r, c] or color not in wanted:
