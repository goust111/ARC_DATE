GRID_MAX = 18
GEN_RETRIES = 500
MAX_OTHER_PLACE_TRIES = 80
OBJECT_COUNTS = (2, 3)
MIN_VISIBLE_UNIQUE = 5
MIN_VISIBLE_PER_DIAG = 3
MAX_FILLED_RATIO = 0.35


