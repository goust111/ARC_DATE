+
+BG = Color.BLACK
+TEMPLATE_PALETTE = (Color.BLUE, Color.GREEN)
+PREFIX_PALETTE = (Color.RED, Color.YELLOW, Color.PINK, Color.ORANGE)
+SEPARATOR = Color.GREY
+MARKER = Color.TEAL
