    all_counts = _bounded_compositions(
        total, region_count, MIN_MARKERS_PER_REGION, MAX_MARKERS_PER_REGION
    )
    return [
        counts
        for counts in all_counts
        if sum(value > 0 for value in counts) >= min_marked_regions
