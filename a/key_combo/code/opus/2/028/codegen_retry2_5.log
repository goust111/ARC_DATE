+        "template_row": template_row,
+        "partial_rows": partial_rows,
+        "completed_rows": completed_rows,
+        "mappings": mappings,
+        "prefix_lengths": prefix_lengths,
+        "lower_start": lower_start,
+        "lower": lower,
+        "sep_rows": sep_rows,
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "stamp": stamp,
+        "marked_cells": marked_cells,
