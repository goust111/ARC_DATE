+def _partition_spans(length: int, separators: np.ndarray) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for sep in [int(v) for v in separators.tolist()]:
+        if start <= sep - 1:
