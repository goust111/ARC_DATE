from __future__ import annotations
import random
import numpy as np

PANEL=7
RED=2
ORANGE=7
BLACK=0
BLUE=1
GREEN=3
ORDER=(\"up\",\"right\",\"down\",\"left\")
ALT_ORDER=(\"left\",\"up\",\"right\",\"down\")
VEC={\"up\":(-1,0),\"right\":(0,1),\"down\":(1,0),\"left\":(0,-1)}
TOP_POOL=((1,1),(1,4),(2,5),(4,1),(5,2),(5,5))
BOTTOM_POOL=((1,2),(1,5),(2,1),(4,5),(5,1),(5,4))


def choose(cell, order=ORDER):
    r,c=cell
    dist={\"up\":r,\"right\":PANEL-1-c,\"down\":PANEL-1-r,\"left\":c}
    m=min(dist.values())
    ties=[d for d,v in dist.items() if v==m]
    for d in order:
        if dist[d]==m:
            return d, dist, ties
    raise AssertionError

def trace(markers, cell, order=ORDER, include_edge=False, ignore_markers=False):
    direction,dist,ties=choose(cell, order)
    dr,dc=VEC[direction]
    r,c=cell
    path=[]
    while True:
        r+=dr;c+=dc
        if not (0<=r<PANEL and 0<=c<PANEL):
            return {\"source\":cell,\"direction\":direction,\"distances\":dist,\"ties\":ties,\"path\":tuple(path),\"stop\":None,\"reason\":\"outside\"}
        if not ignore_markers and (r,c) in markers:
            return {\"source\":cell,\"direction\":direction,\"distances\":dist,\"ties\":ties,\"path\":tuple(path),\"stop\":(r,c),\"reason\":\"marker\"}
        if r in (0,PANEL-1) or c in (0,PANEL-1):
            if include_edge:
                path.append((r,c))
            return {\"source\":cell,\"direction\":direction,\"distances\":dist,\"ties\":ties,\"path\":tuple(path),\"stop\":(r,c),\"reason\":\"edge\"}
        path.append((r,c))

def render(markers, suppress_blockers=True, order=ORDER, include_edge=False, ignore_markers=False):
    marks=set(markers)
    meta={m:trace(marks,m,order,include_edge,ignore_markers) for m in marks}
    suppressed={info['stop'] for info in meta.values() if info['reason']=='marker' and info['stop'] in marks}
    emitters=marks - suppressed if suppress_blockers else marks
    out=np.zeros((PANEL,PANEL),dtype=int)
    for r,c in marks:
        out[r,c]=RED
    for m in emitters:
        for r,c in meta[m]['path']:
            if (r,c) not in marks:
                out[r,c]=ORANGE
    return out, meta, emitters, suppressed

def build_input(markers):
    top=np.full((PANEL,PANEL),BLUE,dtype=int)
    bottom=np.full((PANEL,PANEL),GREEN,dtype=int)
    for cell in markers:
        top[cell]=BLACK
        bottom[cell]=BLACK
    for cell in TOP_POOL:
        if cell not in markers:
            top[cell]=BLACK
    for cell in BOTTOM_POOL:
        if cell not in markers:
            bottom[cell]=BLACK
    return np.vstack([top,bottom])

def mask_from_input(inp):
    top=inp[:PANEL]
    bottom=inp[PANEL:]
    return {(int(r),int(c)) for r,c in np.argwhere((top==BLACK)&(bottom==BLACK))}

def validate(markers):
    if not (4<=len(markers)<=8): return False,'count'
    rows={r for r,_ in markers}; cols={c for _,c in markers}
    if len(rows)==1 or len(cols)==1: return False,'aligned'
    out,meta,emitters,supp=render(markers,True)
    if not supp: return False,'no suppression'
    if 2 not in out or 7 not in out: return False,'missing colors'
    if not any(len(info['ties'])>1 and src in emitters for src,info in meta.items()): return False,'no emitted tie'
    if not any(info['reason']=='edge' and len(info['path'])>0 and src in emitters for src,info in meta.items()): return False,'no emitted edge ray'
    exact,_,_,_=render(markers,False)
    if np.array_equal(out, exact): return False,'suppression no effect'
    alt,_,_,_=render(markers,True,ALT_ORDER)
    if np.array_equal(out,alt): return False,'tie no effect'
    incl,_,_,_=render(markers,True,ORDER,True)
    if np.array_equal(out,incl): return False,'edge-inclusive same'
    inp=build_input(markers)
    if mask_from_input(inp)"'!=set(markers): return False,'"'embed mismatch'
    return True, (out,meta,emitters,supp)

