+        if axis_kind == "h":
+            on_axis = fg_mask[axis_index, :]
+            part_a = int(fg_mask[:axis_index, :].sum())
+            part_b = int(fg_mask[axis_index + 1 :, :].sum())
+        else:
+            on_axis = fg_mask[:, axis_index]
+            part_a = int(fg_mask[:, :axis_index].sum())
+            part_b = int(fg_mask[:, axis_index + 1 :].sum())
