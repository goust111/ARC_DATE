+        fg_mask = g == fg_color
+
+        components = find_components(
+            g, bg=bg, connectivity=4, monochromatic=True, colors=[fg_color]
+        )
+        assert len(components) == 1
+
+        bb = bbox(fg_mask)
+        assert bb is not None
+        r0, c0, r1, c1 = bb
+        assert (r1 - r0 + 1) * (c1 - c0 + 1) > int(fg_mask.sum())
