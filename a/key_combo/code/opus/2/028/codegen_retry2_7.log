+    if random.random() < 0.5:
+        out = np.flipud(out)
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    return out.copy()
+
+
+def _semantic_ok(grid: np.ndarray) -> bool:
+    try:
+        g = np.asarray(grid, dtype=int)
+        bg, fg_color, ctrl_color, axis_kind, axis_index, _, = _detect_axis(g)
