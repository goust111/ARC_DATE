+        grid[top_rows, band_left + c] = FG_COLOR
+    for r, c in bottom_cells:
+        grid[top_rows + 1 + (bottom_rows - 1 - r), band_left + c] = FG_COLOR
+    grid[top_rows, 0] = CTRL_COLOR
