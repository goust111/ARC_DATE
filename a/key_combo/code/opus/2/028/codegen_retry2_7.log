  95: def _bounded_compositions(total, count, min_value, max_value):
  96:     values: list[tuple[int, ...]] = []
  97: 
  98:     def rec(prefix: list[int], remaining: int, slots: int) -> None:
  99:         if slots == 0:
 100:             if remaining == 0:
 101:                 values.append(tuple(prefix))
 102:             return
 103:         tail_slots = slots - 1
 104:         low = max(min_value, remaining - max_value * tail_slots)
 105:         high = min(max_value, remaining - min_value * tail_slots)
