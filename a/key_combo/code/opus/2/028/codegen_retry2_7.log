+        return None
+    if any(not allowed[r, c] for r, c in seeds):
+        return None
+
+    cells = set(seeds)
+    frontier: set[tuple[int, int]] = set()
+
+    def add_frontier(r: int, c: int) -> None:
+        for nr, nc in _neighbors4(shape, r, c):
+            if allowed[nr, nc] and (nr, nc) not in cells:
+                frontier.add((nr, nc))
