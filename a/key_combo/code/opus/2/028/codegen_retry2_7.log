  19: def main(grid: np.ndarray) -> np.ndarray:
  20:     """
  21:     Extend each black marker into a full divider line through its colored rectangle.
  22: 
  23:     Input structure
  24:     - The grid is partitioned into non-square monochrome rectangular regions.
  25:     - A unique rare marker color appears as isolated pixels inside those regions.
  26:     - Each region is otherwise filled with exactly one non-marker color.
  27: 
  28:     Rule
  29:     - For each wide region, replace the full region-height column through every
  30:       marker with the marker color.
  31:     - For each tall region, replace the full region-width row through every
  32:       marker with the marker color.
  33:     - Preserve colored regions that contain no marker.
  34: 
  35:     Key insight
  36:     - The marker does not spread globally; the aspect ratio of its own rectangle
  37:       chooses the perpendicular divider direction and the rectangle bounds stop it.
  38:     """
  39:     g = np.asarray(grid, dtype=int)
  40:     assert g.ndim == 2, "expected a 2D grid"
  41: 
  42:     marker = _unique_rarest_color(g)
  43:     out = g.copy()
  44:     assigned_markers = np.zeros(g.shape, dtype=bool)
  45: 
  46:     for color in colors_present(g, exclude={marker}):
  47:         region_mask = g == color
  48:         region_bbox = bbox(region_mask)
  49:         assert region_bbox is not None, "expected each region color to be present"
  50:         r0, c0, r1, c1 = region_bbox
  51: 
  52:         region = g[r0 : r1 + 1, c0 : c1 + 1]
  53:         assert np.all((region == color) | (region == marker)), (
  54:             "expected a rectangular region with only its own color and markers"
  55:         )
  56: 
  57:         height = r1 - r0 + 1
  58:         width = c1 - c0 + 1
  59:         assert height != width, "expected each colored region to be non-square"
  60: 
  61:         markers = np.argwhere(region == marker)
  62:         for rr, cc in markers:
  63:             r = int(r0 + rr)
  64:             c = int(c0 + cc)
  65:             assigned_markers[r, c] = True
  66:             if width > height:
  67:                 out[r0 : r1 + 1, c] = marker
  68:             else:
  69:                 out[r, c0 : c1 + 1] = marker
  70: 
  71:     assert np.array_equal(assigned_markers, g == marker), (
  72:         "expected every marker to lie in exactly one colored region"
  73:     )
  74:     return out
  75: 
