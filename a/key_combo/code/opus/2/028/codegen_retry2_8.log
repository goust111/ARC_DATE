_GEN_RETRY_LIMIT = 300
_GEN_BLOCK_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_transform_grid(g: np.ndarray, side: str) -> np.ndarray:
    if side == "top":
        return g.copy()
    if side == "bottom":
        return np.flipud(g).copy()
    if side == "left":
        return np.rot90(g, 1).copy()
    if side == "right":
        return np.rot90(g, -1).copy()
    raise ValueError(side)


