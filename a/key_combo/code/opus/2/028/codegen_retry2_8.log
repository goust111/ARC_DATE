.py:67:    - bg = 0 (black). A single teal (8) cross with a 1-cell hole at the center.\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D11/2/code.py:185:MAX_TOTAL_BARS = 10          # max bars across all groups\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D11/2/code.py:210:    \"\"\"Distribute bar columns across groups with random inter-group spacing.\n/home/lixinyu/snap/new/ceshi/code/97d7923e/D12/2/code.py:50:#    - Across examples, solvers can see the consistent pattern: \"filled bar encodes rank; output\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:10:#     - 颜色 8/5/9 的导线网络、crossing 标记、9 矩形通道、置换式路由全部保留。\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:34:#     - 仍保留 4-5 条通道、非恒等置换、crossing 与 9 矩形，使任务复杂度主要仍来自配线追踪，而不是 token 识别噪声。\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:240:    Toggle colored 3×3 tokens across wire networks, mirroring the toggled shape to the opposite endpoint.\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:341:def _decompose_to_crossovers(perm):\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:342:    \"\"\"Decompose permutation into sequential crossover moves using bypass for cycles.\"\"\"\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:345:    crossovers = []\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:358:        crossovers.append((cycle[0], -1))\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:360:            crossovers.append((cycle[k], cycle[(k + 1) % len(cycle)]))\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:361:        crossovers.append((-1, cycle[1]))\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:362:    return crossovers\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:373:        mode = \"crossing\"\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:396:    if mode == \"crossing\" and xover_rows:\n/home/lixinyu/snap/new/ceshi/code/a47bf94d/D9/0/code.py:447:def _build_wire_network(grid, n_channels, ch_cols, bypass_col, top_e