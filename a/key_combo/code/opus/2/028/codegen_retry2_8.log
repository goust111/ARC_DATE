+def _visible_overlay(left_fg: np.ndarray, right_fg: np.ndarray) -> np.ndarray:
+    out = np.full(left_fg.shape, RED, dtype=int)
+    out[left_fg & ~right_fg] = BLUE
+    out[~left_fg & right_fg] = GREEN
+    out[left_fg & right_fg] = YELLOW
+    return out
+
