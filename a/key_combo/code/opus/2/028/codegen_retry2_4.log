+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+REGION_COLORS = (BLUE, GREEN, YELLOW, TEAL)
+GEN_RETRIES = 400
+COUNT_OPTIONS = {
+    "first_more": ((2, 1), (3, 1), (3, 2), (4, 1)),
+    "second_more": ((1, 2), (1, 3), (2, 3), (1, 4)),
+    "tie": ((1, 1), (2, 2)),
