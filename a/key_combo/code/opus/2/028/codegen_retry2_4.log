+    second_cells: list[tuple[int, int]] = []
+    if orientation == "wide":
+        for r in range(h):
+            for c in range(w):
+                if c < split:
+                    first_cells.append((r, c))
+                elif c > split:
+                    second_cells.append((r, c))
+    else:
+        for r in range(h):
+            for c in range(w):
+                if r < split:
+                    first_cells.append((r, c))
+                elif r > split:
+                    second_cells.append((r, c))
