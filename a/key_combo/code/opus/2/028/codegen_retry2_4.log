+    inp = np.full((grid_h, grid_w), BLACK, dtype=int)
+    expected = np.full((grid_h, grid_w), BLACK, dtype=int)
+
+    for (sr, sc), role in zip(active_slots, roles):
+        slot_r0 = 1 + sr * (slot_h + 1)
+        slot_c0 = 1 + sc * (slot_w + 1)
