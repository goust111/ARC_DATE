from collections import deque

def bar_cells(cr,cc,L,o):
    h=L//2
    if o=='H':
        return {(cr,cc+d) for d in range(-h,h+1)}
    return {(cr+d,cc) for d in range(-h,h+1)}

def regions(H,W,bars):
    occ=set()
    for b in bars:
        occ|=bar_cells(*b)
    seen=set(); comps=[]
    for r in range(H):
      for c in range(W):
        if (r,c) in occ or (r,c) in seen: continue
        q=deque([(r,c)]); seen.add((r,c)); comp=[]
        while q:
          x,y=q.popleft(); comp.append((x,y))
          for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<H and 0<=ny<W and (nx,ny) not in occ and (nx,ny) not in seen:
              seen.add((nx,ny)); q.append((nx,ny))
        comps.append(comp)
    return occ, comps

def rotate(b):
    cr,cc,L,o=b
    return (cr,cc,L,'V' if o=='H' else 'H')

# H11 narrow chain x=3 W13
def layout(H,W,x,extras):
    bars=[]
    if H==11:
        bars += [(2,x,5,'V'), (5,x+2,3,'H'), (8,x+4,5,'V')]
        if 'LT' in extras: bars.append((3,(x-1)//2,x,'H'))
        if 'LB' in extras: bars.append((7,3,7,'H'))
        if 'RB' in extras: bars.append((7,(x+5 + W-1)//2,W-x-5,'H'))
    else:
        bars += [(3,x,7,'V'), (7,x+2,3,'H'), (10,x+4,5,'V')]
        if 'LT' in extras: bars.append((5,(x-1)//2,x,'H'))
        if 'LB' in extras: bars.append((9,3,7,'H'))
        if 'RB' in extras: bars.append((9,(x+5 + W-1)//2,W-x-5,'H'))
    return bars

for H,W,x,extras in [
    (11,13,3,['LT']),
    (11,13,3,['LT','RB']),
    (11,13,3,['LT','LB','RB']),
    (11,15,5,['LT']),
    (11,15,5,['LT','RB']),
    (13,13,3,['LT']),
    (13,13,3,['LT','RB']),
    (13,13,3,['LT','LB','RB']),
]:
    final=layout(H,W,x,extras)
    inp=[rotate(b) for b in final]
    occf, compsf = regions(H,W,final)
    occi, compsi = regions(H,W,inp)
    print('case',H,W,x,extras,'final regions',len(compsf),'input regions',len(compsi))
    # quick draw final/input
    for name,bars in [('F',final),('I',inp)]:
        occ,_=regions(H,W,bars)
        print(name)
        for r in range(H):
            print(''.join('#' if (r,c) in occ else '.' for c in range(W)))
        print()
    print('---')
