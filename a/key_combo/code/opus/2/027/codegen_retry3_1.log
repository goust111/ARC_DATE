   7: # concepts:
   8: # symmetry, mirror
   9: 
  10: # description:
  11: # In the input you will see big objects with a primary color and some single pixels of different colors attached to it.
  12: # To make the output, mirror the primary colored part of each object over the differently colored pixels attached to it, changing the primary color to match the other color.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Mirror each primary object across its attached indicator pixel and recolor the mirror copy.
  17: 
  18:     Input structure:
  19:     - Larger primary-color objects sit on a black background.
  20:     - One-pixel indicators of other colors touch the primary objects.
  21:     - Indicators may touch sides or corners of the primary object.
  22: 
  23:     Rule:
  24:     - Pair each indicator with every primary object it touches.
  25:     - Recolor a copy of the primary object to the indicator color.
  26:     - Mirror that copy across the side or corner axis implied by the indicator position.
  27: 
  28:     Key insight:
  29:     - Attached single pixels provide both the mirror axis and the color for the reflected copy.
  30:     """
  31:     # Plan
  32:     # 1. Parse the input into primary regions and their associated single pixel indicators
  33:     # 2. For each primary region and each attached indicator pixel, change color and mirror.
  34: 
  35:     # 1. Input parsing
  36:     background = Color.BLACK
  37:     objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=True, return_format="objects")
  38:     indicator_pixels = [ obj for obj in objects if np.sum(obj != background) == 1 ]
  39:     primary_objects = [ obj for obj in objects if np.sum(obj != background) > 1 ]
  40: 
  41:     # 2. Output generation
  42: 
  43:     # Copy the input because we draw on top of it
  44:     output_grid = input_grid.copy()
  45: 
  46:     # loop over primary objects and every pixel that they are in contact with
  47:     for primary_object in primary_objects:
  48:         for indicator_pixel in indicator_pixels:
  49:             if not contact(object1=primary_object, object2=indicator_pixel, background=background, connectivity=8): continue
  50: 
  51:             # Recolor
  52:             indicator_color = colors_present(indicator_pixel, exclude={ background })[0]
  53:             recolored_object = np.copy(primary_object)
  54:             recolored_object[primary_object != background] = indicator_color
  55: 
  56:             # Build the mirroring object
  57:             _b = bbox(indicator_pixel != background)
  58:             assert _b is not None
  59:             indicator_r, indicator_c = bbox_anchor(_b, anchor="upper left")
  60:             _b = bbox(primary_object != background)
  61:             assert _b is not None
  62:             primary_r1, primary_c1 = bbox_anchor(_b, anchor="upper left")
  63:             _b = bbox(primary_object != background)
  64:             assert _b is not None
  65:             primary_x2, primary_y2 = bbox_anchor(_b, anchor="lower right")
  66:             # If it's in the corners, we mirror diagonally (over both x and y)
  67:             # If it's on the left/right side, we mirror horizontally
  68:             # If it's on the top/bottom side, we mirror vertically
  69:             mirror_r, mirror_c = None, None
  70:             if indicator_r == primary_r1-1: mirror_r = primary_r1-0.5
  71:             if indicator_r == primary_x2+1: mirror_r = primary_x2+0.5
  72:             if indicator_c == primary_c1-1: mirror_c = primary_c1-0.5
  73:             if indicator_c == primary_y2+1: mirror_c = primary_y2+0.5
  74:             symmetry = MirrorSymmetry(mirror_r=mirror_r, mirror_c=mirror_c)
  75: 
  76:             # Mirror the primary object over the indicator pixel
  77:             for r, c in np.argwhere(primary_object != background):
  78:                 x2, y2 = symmetry.apply(r, c)
  79:                 if 0 <= x2 < output_grid.shape[0] and 0 <= y2 < output_grid.shape[1]:
  80:                     output_grid[x2, y2] = recolored_object[r, c]
  81: 
  82:     return output_grid
  83: 
