    for i in range(len(cells)):
      for j in range(i+1,len(cells)):
        a,b=cells[i],cells[j]
        if a & b: return False
        for r,c in a:
          if (r-1,c) in b or (r+1,c) in b or (r,c-1) in b or (r,c+1) in b:
            return False
    return True

def region_count(H,W,bars):
