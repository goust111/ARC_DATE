      for c in range(W):
        if (r,c) in occ or (r,c) in seen: continue
        n += 1
        q=deque([(r,c)]); seen.add((r,c))
        while q:
          x,y=q.popleft()
          for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<H and 0<=ny<W and (nx,ny) not in occ and (nx,ny) not in seen:
              seen.add((nx,ny)); q.append((nx,ny))
    return n

def draw(H,W,bars):
    occ=set().union(*(bar_cells(*b) for b in bars)) if bars else set()
    for r in range(H):
      print(''.join('#' if (r,c) in occ else '.' for c in range(W)))

for H,W,x in [(11,13,3),(11,15,5),(13,13,3),(13,15,5)]:
    chain = [(2,x,5,'V'), (5,x+2,3,'H'), (8,x+4,5,'V')] if H==11 else [(3,x,7,'V'), (7,x+2,3,'H'), (10,x+4,5,'V')]
    pool=[]
