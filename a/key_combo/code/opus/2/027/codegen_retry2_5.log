+    mask_bbox: tuple[int, int, int, int],
+    marked_rows: set[int],
+) -> np.ndarray | None:
+    g = base.copy()
+    _r0, c0, _r1, c1 = mask_bbox
+    outside_cols = [c for c in range(g.shape[1]) if c < c0 or c > c1]
+    if not outside_cols:
+        return None
+
+    for r in marked_rows:
+        n = random.choice([1, 2])
+        cols = random.sample(outside_cols, k=min(n, len(outside_cols)))
+        for c in cols:
