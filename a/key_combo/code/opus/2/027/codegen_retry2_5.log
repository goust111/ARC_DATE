+def _reconstruct_mask(g: np.ndarray, bbox_rc: tuple[int, int, int, int], pr: int, pc: int) -> np.ndarray:
+    out = g.copy()
+    r0, c0, r1, c1 = bbox_rc
+    for r in range(r0, r1 + 1):
