+def _axis_period_candidates(g: np.ndarray, axis: int) -> list[tuple[int, int]]:
+    h, w = g.shape
+    limit = h if axis == 0 else w
+    candidates: list[tuple[int, int]] = []
+    for shift in range(1, limit):
