+    return _invert_marked_rows(out, bbox_rc, marked_rows)
+
+
+def _unique_best_candidate(candidates: list[tuple[int, int]], chosen: int) -> bool:
+    chosen_score = None
+    for shift, score in candidates:
+        if shift == chosen:
+            chosen_score = score
+            break
