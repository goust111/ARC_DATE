        regions.append(sorted(adj))
    return comps, regions


def _gen_region_valid(counts):
    used = [v for v in counts if v]
    if len(used) < 2:
        return False
    top = max(used)
    return sum(1 for v in used if v == top) == 1


def _gen_region_possible(region, assigned, remaining, n_colors):
    counts = [0] * n_colors
    unknown = 0
    for idx in region:
        color = assigned[idx]
        if color < 0:
            unknown += 1
        else:
            counts[color] += 1

    def rec(pos):
        if pos == unknown:
            return _gen_region_valid(counts)
        order = list(range(n_colors))
        np.random.shuffle(order)
        for color in order:
            if remaining[color] <= 0:
                continue
            remaining[color] -= 1
            counts[color] += 1
            if rec(pos + 1):
                counts[color] -= 1
                remaining[color] += 1
                return True
            counts[color] -= 1
            remaining[color] += 1
        return False

    return rec(0)


def _gen_solve_marker_colors(g, marker_list, regions):
    n_markers = len(marker_list)
    degrees = [0] * n_markers
    for region in regions:
        for idx in region:
            degrees[idx] += 1

