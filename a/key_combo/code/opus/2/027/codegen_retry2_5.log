def _gen_wall_branch_candidates(g):
    out = []
    for r, c in zip(*np.where(g == Color.BLUE)):
        r = int(r)
        c = int(c)
        up = _gen_blue_run(g, r, c, -1, 0)
        down = _gen_blue_run(g, r, c, 1, 0)
        left = _gen_blue_run(g, r, c, 0, -1)
