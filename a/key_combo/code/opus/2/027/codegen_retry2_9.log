+
+
+def _extract_dashed_segments(grid: np.ndarray) -> list[dict]:
+    segments = []
+    h, _w = grid.shape
+    for r in range(h):
+        blue_cols = np.where(grid[r] == BLUE)[0].tolist()
+        if not blue_cols:
+            continue
