+def _row_span_cavity_cells(grid: np.ndarray, coords: list[Coord] | tuple[Coord, ...]) -> tuple[Coord, ...]:
+    rows: dict[int, list[int]] = defaultdict(list)
+    for r, c in coords:
+        rows[int(r)].append(int(c))
+
+    cavity: list[Coord] = []
+    for r in sorted(rows):
+        cols = rows[r]
+        left = min(cols)
+        right = max(cols)
+        for c in range(left + 1, right):
+            if int(grid[r, c]) == BG:
+                cavity.append((r, c))
+    return tuple(cavity)
+
