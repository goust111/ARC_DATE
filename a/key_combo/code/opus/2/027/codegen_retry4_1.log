+        taken: set[tuple[int, int]] = set()
+        markers: dict[tuple[int, int], int] = {}
+        ok = True
+
+        for color, count in big_plan.items():
+            picks = _pick_cells(big_candidates, count, taken)
+            if picks is None:
+                ok = False
+                break
+            for cell in picks:
