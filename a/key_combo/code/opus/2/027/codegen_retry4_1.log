+
+def _scene_bar_sets(specs: list[dict], *, rotated: bool) -> list[set[tuple[int, int]]]:
+    parts = []
+    for spec in specs:
+        orient = spec["out_orient"] if rotated else _swap_orient(spec["out_orient"])
+        parts.append(_bar_cells(spec["center"], spec["length"], orient))
+    return parts
+
+
