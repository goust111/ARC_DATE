from __future__ import annotations

from collections import Counter, deque
import random
import numpy as np

BG = 0
GREY = 5
MARKER_COLORS = (1, 2, 3)
BAR_LENGTHS = (3, 5, 7)
CORE_LENGTHS = (5, 7)
GEN_ATTEMPTS = 400


def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(grid[r, c]) "'!= color:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for nr, nc in neighbors4(rr, cc):
                    if in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(np.array(cells, dtype=int))
    return comps


def bar_cells(center: tuple[int, int], length: int, orient: str) -> set[tuple[int, int]]:
    cr, cc = center
    half = length // 2
    if orient == '"'H':
        return {(cr, cc + dc) for dc in range(-half, half + 1)}
    return {(cr + dr, cc) for dr in range(-half, half + 1)}


def swapped_orient(orient: str) -> str:
    return 'V' if orient == 'H' else 'H'


def rotated_bar_cells(coords: np.ndarray) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = bbox_coords(coords)
    height = r1 - r0 + 1
    width = c1 - c0 + 1
    area = int(coords.shape[0])
    assert area == max(height, width)
    assert min(height, width) == 1
    length = max(height, width)
    assert length % 2 == 1
    cr = (r0 + r1) // 2
    cc = (c0 + c1) // 2
    half = length // 2
    if height == 1:
        return [(r, cc) for r in range(cr - half, cr + half + 1)]
    return [(cr, c) for c in range(cc - half, cc + half + 1)]


def region_map(shape: tuple[int, int], obstacles: set[tuple[int, int]]) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
    h, w = shape
    labels = np.full((h, w), -2, dtype=int)
    for r, c in obstacles:
        labels[r, c] = -1
    regions = []
    region_id = 0
    for r in range(h):
        for c in range(w):
            if labels[r, c] "'!= -2:
                continue
            q = deque([(r, c)])
            labels[r, c] = region_id
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for nr, nc in neighbors4(rr, cc):
                    if in_bounds(shape, nr, nc) and labels[nr, nc] == -2:
                        labels[nr, nc] = region_id
                        q.append((nr, nc))
            regions.append(cells)
            region_id += 1
    return labels, regions


def solve_with_mode(grid: np.ndarray, rotate: bool) -> np.ndarray:
    g = np.asarray(grid, dtype=int)
    out = np.zeros_like(g)
    grey_comps = components_of_color(g, GREY)
    barrier_cells = set()
    for comp in grey_comps:
        target = rotated_bar_cells(comp) if rotate else [tuple(map(int, rc)) for rc in comp]
        for r, c in target:
            assert in_bounds(g.shape, r, c)
            assert (r, c) not in barrier_cells
            barrier_cells.add((r, c))
            out[r, c] = GREY

    marker_cells = [tuple(map(int, rc)) for rc in np.argwhere((g != BG) & (g != GREY))]
    for r, c in marker_cells:
        assert out[r, c] == BG
        out[r, c] = int(g[r, c])

    labels, regions = region_map(g.shape, barrier_cells)
    for rid, cells in enumerate(regions):
        counts = Counter(int(g[r, c]) for r, c in cells if int(g[r, c]) not in (BG, GREY))
        if not counts:
            continue
        ranked = counts.most_common()
        assert len(ranked) == 1 or ranked[0][1] > ranked[1][1]
        fill = int(ranked[0][0])
        for r, c in cells:
            if out[r, c] == BG:
                out[r, c] = fill
    return out


def main(grid: np.ndarray) -> np.ndarray:
    return solve_with_mode(grid, True)


def cells_touching_side(cells: set[tuple[int, int]], others: set[tuple[int, int]]) -> bool:
    return any((nr, nc) in others for r, c in cells for nr, nc in neighbors4(r, c))


def scene_cells(specs: list[dict], rotated: bool) -> list[set[tuple[int, int]]]:
    parts = []
    for spec in specs:
        orient = spec['"'out_orient'] if rotated else swapped_orient(spec['out_orient'])
        parts.append(bar_cells(spec['center'], spec['length'], orient))
    return parts


def valid_specs(shape: tuple[int, int], specs: list[dict]) -> bool:
    for rotated in (False, True):
        parts = scene_cells(specs, rotated)
        for i, cells in enumerate(parts):
            if any(not in_bounds(shape, r, c) for r, c in cells):
                return False
            for other in parts[:i]:
                if cells & other:
                    return False
                if cells_touching_side(cells, other):
                    return False
    return True


def build_core_specs(shape: tuple[int, int], extra_count: int) -> list[dict] | None:
    h, w = shape
    specs = [
        {'center': (tl_v := random.choice(CORE_LENGTHS), (tl_h := random.choice(CORE_LENGTHS)) // 2), 'length': tl_h, 'out_orient': 'H'},
        {'center': (tl_v // 2, tl_h), 'length': tl_v, 'out_orient': 'V'},
        {'center': (h - 1 - (br_v := random.choice(CORE_LENGTHS)), w - 1 - (br_h := random.choice(CORE_LENGTHS)) // 2), 'length': br_h, 'out_orient': 'H'},
        {'center': (h - 1 - br_v // 2, w - 1 - br_h), 'length': br_v, 'out_orient': 'V'},
    ]
    if not valid_specs(shape, specs):
        return None
    for _ in range(extra_count):
        placed = False
        for _ in range(200):
            spec = {
                'center': (
                    random.randint(3, h - 4),
                    random.randint(3, w - 4),
                ),
                'length': random.choice(BAR_LENGTHS),
                'out_orient': random.choice(('H', 'V')),
            }
            if valid_specs(shape, specs + [spec]):
                specs.append(spec)
                placed = True
                break
        if not placed:
            return None
    return specs


def render_input(shape: tuple[int, int], specs: list[dict], markers: dict[tuple[int, int], int]) -> np.ndarray:
    grid = np.zeros(shape, dtype=int)
    for spec in specs:
        for r, c in bar_cells(spec['center'], spec['length'], swapped_orient(spec['out_orient'])):
            grid[r, c] = GREY
    for (r, c), color in markers.items():
        assert grid[r, c] == BG
        grid[r, c] = color
    return grid


def same_region_signature(labels: np.ndarray, points: list[tuple[int, int]]) -> tuple[bool, ...]:
    sig = []
    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            sig.append(int(labels[points[i]]) == int(labels[points[j]]))
    return tuple(sig)


def marker_candidates(shape: tuple[int, int], region_cells: list[tuple[int, int]], input_bars: set[tuple[int, int]], output_bars: set[tuple[int, int]]) -> list[tuple[int, int]]:
    out = []
    for r, c in region_cells:
        if (r, c) in input_bars or (r, c) in output_bars:
            continue
        if any(in_bounds(shape, nr, nc) and (nr, nc) in input_bars for nr, nc in neighbors4(r, c)):
            continue
        out.append((r, c))
    random.shuffle(out)
    return out


def pick_cells(cands: list[tuple[int, int]], count: int, taken: set[tuple[int, int]]) -> list[tuple[int, int]] | None:
    picked = []
    blocked = set(taken)
    for cell in cands:
        if cell in blocked:
            continue
        if any(nb in blocked for nb in neighbors4(*cell)):
            continue
        picked.append(cell)
        blocked.add(cell)
        for nb in neighbors4(*cell):
            blocked.add(nb)
        if len(picked) == count:
            return picked
    return None


def marker_plan() -> tuple[Counter[int], Counter[int]]:
    a, b, c = random.sample(MARKER_COLORS, 3)
    region_big = Counter({a: random.choice((3, 4)), b: 1, c: 1})
    region_small = Counter({a: 1, b: random.choice((2, 3, 4)), c: 1})
    return region_big, region_small


def validate_semantics(grid: np.ndarray) -> None:
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and max(g.shape) <= 30
    grey_comps = components_of_color(g, GREY)
    assert 4 <= len(grey_comps) <= 6
    marker_positions = [tuple(map(int, rc)) for rc in np.argwhere((g "'!= BG) & (g != GREY))]
    marker_counts = Counter(int(g[r, c]) for r, c in marker_positions)
    assert 8 <= len(marker_positions) <= 14
    assert set(marker_counts) == set(MARKER_COLORS)
    assert all(marker_counts[color] >= 2 for color in MARKER_COLORS)

    input_bars = set()
    for comp in grey_comps:
        assert int(comp.shape[0]) in BAR_LENGTHS
        r0, c0, r1, c1 = bbox_coords(comp)
        h = r1 - r0 + 1
        w = c1 - c0 + 1
        assert min(h, w) == 1 and max(h, w) == int(comp.shape[0])
        assert not (input_bars & {tuple(map(int, rc)) for rc in comp})
        input_bars.update(tuple(map(int, rc)) for rc in comp)

    for pos in marker_positions:
        for nb in neighbors4(*pos):
            assert nb not in input_bars
    output = main(g)
    no_rotate_output = solve_with_mode(g, False)
    assert not np.array_equal(output, no_rotate_output)

    rotated_bars = {tuple(map(int, rc)) for rc in np.argwhere(output == GREY)}
    out_labels, out_regions = region_map(g.shape, rotated_bars)
    assert len(out_regions) >= 3
    in_labels, _ = region_map(g.shape, input_bars)
    assert same_region_signature(in_labels, marker_positions) != same_region_signature(out_labels, marker_positions)

    marked_regions = 0
    mixed_regions = 0
    majority_colors = set()
    for rid, cells in enumerate(out_regions):
        counts = Counter(int(g[r, c]) for r, c in cells if int(g[r, c]) in MARKER_COLORS)
        if not counts:
            for r, c in cells:
                if (r, c) not in rotated_bars:
                    assert int(output[r, c]) in (BG, int(g[r, c]))
            continue
        marked_regions += 1
        if len(counts) > 1:
            mixed_regions += 1
        ranked = counts.most_common()
        assert len(ranked) == 1 or ranked[0][1] > ranked[1][1]
        fill = int(ranked[0][0])
        majority_colors.add(fill)
        for r, c in cells:
            if int(g[r, c]) in MARKER_COLORS:
                assert int(output[r, c]) == int(g[r, c])
            else:
                assert int(output[r, c]) == fill
    assert marked_regions >= 2
    assert marked_regions < len(out_regions)
    assert mixed_regions >= 1
    assert len(majority_colors) >= 2


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        shape = (random.randint(14, 18), random.randint(14, 18))
        extra_count = random.choice((0, 1, 2))
        specs = build_core_specs(shape, extra_count)
        if specs is None:
            continue

        input_bar_sets = scene_cells(specs, rotated=False)
        output_bar_sets = scene_cells(specs, rotated=True)
        input_bars = set().union(*input_bar_sets)
        output_bars = set().union(*output_bar_sets)
        out_labels, out_regions = region_map(shape, output_bars)
        if len(out_regions) < 3:
            continue

        sized_regions = sorted(
            [(idx, cells) for idx, cells in enumerate(out_regions)],
            key=lambda item: len(item[1]),
            reverse=True,
        )
        big_id, big_cells = sized_regions[0]
        other_options = []
        for rid, cells in sized_regions[1:]:
            cands = marker_candidates(shape, cells, input_bars, output_bars)
            if len(cands) >= 4:
                other_options.append((rid, cells, cands))
        if not other_options:
