+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        shape = (random.randint(14, 18), random.randint(14, 18))
+        specs = _build_core_specs(shape, extra_count=random.choice((0, 1, 2)))
+        if specs is None:
