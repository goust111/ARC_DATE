+    small_region = Counter({major_big: 1, major_small: random.choice((2, 3, 4)), other: 1})
+    return big_region, small_region
+
+
+def _validate_generated_input(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
