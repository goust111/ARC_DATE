import random,itertools,time
from collections import Counter, deque
T=6;G=1;M=1;GREY=5
VOTE=[1,2,3]; DEFAULT=4

def build_case(R,C,src):
    h=2*M+R*T+(R-1)*G; w=2*M+C*T+(C-1)*G
    g=[[0]*w for _ in range(h)]
    boxes=[]
    for i in range(R):
        for j in range(C):
            r0=M+i*(T+G); c0=M+j*(T+G)
            boxes.append((i,j,r0,c0,r0+T-1,c0+T-1))
    # build regions from actual geometry using tile bbox adjacency
    import numpy as np
    grid=np.zeros((h,w),dtype=int)
    patch=np.full((T,T),GREY,dtype=int); patch[3,:]=0; patch[:,3]=0; patch[1:3,1:3]=DEFAULT
    for i,j,r0,c0,r1,c1 in boxes:
        grid[r0:r0+T,c0:c0+T]=patch
    ray=np.zeros_like(grid,dtype=bool)
    for i,j,r0,c0,r1,c1 in boxes:
        if (i,j) in src:
            cr,cc=r0+3,c0+3
            ray[cr,cc]=True
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                r,c=cr+dr,cc+dc
                while 0<=r<h and 0<=c<w and grid[r,c]==0:
                    ray[r,c]=True; r+=dr; c+=dc
    passable=(grid==0)&(~ray)
    seen=np.zeros_like(passable,dtype=bool)
    regions=[]
    for r in range(h):
        for c in range(w):
            if passable[r,c] and not seen[r,c]:
                q=deque([(r,c)]); seen[r,c]=True; cells=[]
                while q:
                    x,y=q.popleft(); cells.append((x,y))
                    for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and passable[nx,ny] and not seen[nx,ny]:
                            seen[nx,ny]=True; q.append((nx,ny))
                rc=np.array(cells)
                touched=[]
                for i,j,r0,c0,r1,c1 in boxes:
                    if (i,j) in src:
                        continue
                    if np.any((rc[:,0]>=r0-1)&(rc[:,0]<=r1+1)&(rc[:,1]>=c0-1)&(rc[:,1]<=c1+1)):
                        touched.append((i,j))
                regions.append(tuple(sorted(touched)))
    return tuple(regions), [b[:2] for b in boxes if b[:2] not in src]

def random_find(regions, tiles, trials=50000, majority_defaults=False):
    for attempt in range(1,trials+1):
        colors={t:DEFAULT for t in tiles}
        k=random.randint(4, min(len(tiles), 8))
        for t in random.sample(tiles, k):
            colors[t]=random.choice(VOTE)
        if majority_defaults:
            d=sum(v==DEFAULT for v in colors.values())
            if d <= len(colors)-d:
                continue
        winners=[]; ok=True
        for touched in regions:
            vals=[colors[t] for t in touched if colors[t]"'!=DEFAULT]
            if len(vals)<2:
                ok=False; break
            cnt=Counter(vals).most_common()
            if len(cnt)>1 and cnt[0][1]==cnt[1][1]:
                ok=False; break
            winners.append(cnt[0][0])
        if ok and len(set(winners))>=2:
            return attempt, colors, winners
    return None

cases=[]
for R,C in [(3,4),(4,3),(4,4)]:
    allpos=[(i,j) for i in range(R) for j in range(C)]
    for src in itertools.combinations(allpos,2):
        regions, tiles=build_case(R,C,src)
        mins=min(len(r) for r in regions)
        if len(regions)>=3 and mins>=2:
            cases.append(((R,C),src,regions,tiles))
print('"'candidate cases',len(cases))
for case in cases:
