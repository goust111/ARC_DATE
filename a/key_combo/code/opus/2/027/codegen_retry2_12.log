    res=random_find(regions, tiles, trials=20000, majority_defaults=False)
    res2=random_find(regions, tiles, trials=40000, majority_defaults=True)
    print('case',R,C,src,'regions',len(regions),'min',min(len(r) for r in regions),'any',None if res is None else res[0],'majority_default',None if res2 is None else res2[0])
