      p=np.full((T,T),GREY,dtype=int)
      mid=T//2
      p[mid,:]=0; p[:,mid]=0
      rs,cs=pos
      p[rs,cs]=4
      g[r0:r0+T,c0:c0+T]=p
      boxes.append((i,j,r0,c0))
  mark_cells={}
  for idx,(i,j,r0,c0) in enumerate(boxes):
    coords=np.argwhere((g[r0:r0+T,c0:c0+T]"'!=0)&(g[r0:r0+T,c0:c0+T]!=GREY))
    for rr,cc in coords:
      mark_cells[(r0+rr,c0+cc)]=idx
  allpos=[(i,j) for i in range(R) for j in range(C)]
  def eval(src):
    ray=np.zeros_like(g,dtype=bool)
    for i,j,r0,c0 in boxes:
      if (i,j) in src:
        cr,cc=r0+T//2,c0+T//2
        ray[cr,cc]=True
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
          r,c=cr+dr,cc+dc
          while 0<=r<h and 0<=c<w and g[r,c]==0:
            ray[r,c]=True; r+=dr; c+=dc
    passable=(g==0)&(~ray)
    seen=np.zeros_like(passable,dtype=bool)
    mins=999; nregs=0
    for r in range(h):
      for c in range(w):
        if passable[r,c] and not seen[r,c]:
          q=deque([(r,c)]); seen[r,c]=True; cells=[]
          while q:
            x,y=q.popleft(); cells.append((x,y))
            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
              nx,ny=x+dx,y+dy
              if 0<=nx<h and 0<=ny<w and passable[nx,ny] and not seen[nx,ny]:
                seen[nx,ny]=True; q.append((nx,ny))
          touched=set()
          for rr,cc in cells:
            for dr in (-1,0,1):
              for dc in (-1,0,1):
                if dr==0 and dc==0: continue
                if (rr+dr,cc+dc) in mark_cells:
                  touched.add(mark_cells[(rr+dr,cc+dc)])
          mins=min(mins,len(touched)); nregs+=1
    return nregs, mins
  count=0; best=[]
  for k in [2,3]:
    for src in itertools.combinations(allpos,k):
