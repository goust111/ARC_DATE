+    centers: list[int] = []
+    for r in range(h):
+        row = grid[r]
+        if not np.all(np.isin(row, [BLACK, GREY])):
+            continue
+        runs = _black_runs(row)
+        if len(runs) != 1:
+            continue
+        c0, c1 = runs[0]
+        if c1 - c0 + 1 != 3:
+            continue
+        if int(np.count_nonzero(row == GREY)) != w - 3:
+            continue
