+
+def _render_walls(grid: np.ndarray, wall_rows: list[int], door_centers: list[int]) -> None:
+    for r, c in zip(wall_rows, door_centers):
+        grid[r, :] = GREY
+        grid[r, c - 1 : c + 2] = BLACK
