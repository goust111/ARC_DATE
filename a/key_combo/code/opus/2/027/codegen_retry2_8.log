+    assert int(v_cols[0]) == c1 + 2
+    assert int(v_rows.min()) == r0
+    assert int(h_rows[0]) == r1 + 2
+    assert int(h_cols.min()) == c0
+    assert p_v >= sh + 1
+    assert p_h >= sw + 1
