+    out = np.zeros(canvas_shape, dtype=int)
+    h, w = canvas_shape
+    r0, c0 = origin
+    sh, sw = sprite_patch.shape
+    max_i = (h - r0 - sh) // p_v
+    max_j = (w - c0 - sw) // p_h
+
+    for i in range(max_i + 1):
+        for j in range(max_j + 1):
