+            continue
+        for p_h in range(3, 6):
+            if p_h < sw + 1:
+                continue
+            if p_v >= sh + 2 and p_h >= sw + 2:
+                continue
+            period_pairs.append((p_v, p_h))
+    if not period_pairs:
+        return None
+    p_v, p_h = random.choice(period_pairs)
