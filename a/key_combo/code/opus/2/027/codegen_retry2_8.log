+    v_cols = vbar_coords[:, 1]
+    assert len(set(map(int, v_cols))) == 1
+    assert _is_consecutive(v_rows)
+    p_v = int(v_rows.max() - v_rows.min() + 1)
+    assert 3 <= p_v <= 5
