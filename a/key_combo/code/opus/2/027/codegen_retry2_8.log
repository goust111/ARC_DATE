+    h_options = _count_options(c0, sw, p_h)
+    if not v_options or not h_options:
+        return None
+
+    _, h_lo, h_hi = random.choice(v_options)
+    _, w_lo, w_hi = random.choice(h_options)
+    h = random.randint(h_lo, h_hi)
+    w = random.randint(w_lo, w_hi)
+
