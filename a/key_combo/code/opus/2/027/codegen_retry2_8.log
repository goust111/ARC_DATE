+    h_rows = hbar_coords[:, 0]
+    h_cols = hbar_coords[:, 1]
+    assert len(set(map(int, h_rows))) == 1
+    assert _is_consecutive(h_cols)
+    p_h = int(h_cols.max() - h_cols.min() + 1)
+    assert 3 <= p_h <= 5
