+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+SPRITE_RED = 2
+H_MIRROR_GREEN = 3
+V_MIRROR_YELLOW = 4
+HV_MIRROR_ORANGE = 7
+
+MIN_SIDE = 18
+MAX_SIDE = 28
+GEN_ATTEMPTS = 400
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
+    assert box is not None
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], bytes]:
+    return tuple(map(int, mask.shape)), mask.astype(np.uint8).tobytes()
+
+
+def _all_flip_variants(mask: np.ndarray) -> list[np.ndarray]:
+    return [
+        mask.copy(),
+        np.fliplr(mask),
+        np.flipud(mask),
+        np.flipud(np.fliplr(mask)),
+    ]
+
+
+def _is_valid_sprite_mask(mask: np.ndarray) -> bool:
+    if mask.dtype != bool:
+        mask = mask.astype(bool)
+    if int(mask.sum()) < 4 or int(mask.sum()) > 6:
+        return False
+    comps = _components4(mask)
+    if len(comps) != 1:
+        return False
+    box = _bbox(mask)
