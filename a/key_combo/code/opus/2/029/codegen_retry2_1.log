    """Check if two lines cross within an SxS grid."""
    if k1 == k2:
        return False  # same-kind lines are parallel
    c1 = _gen_line_cells(S, k1, v1)
    c2 = _gen_line_cells(S, k2, v2)
    return bool(c1 & c2)


