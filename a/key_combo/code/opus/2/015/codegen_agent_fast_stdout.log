import numpy as np

_RNG = np.random.default_rng(20260707)

dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)]

def _rng(seed=None):
    return np.random.default_rng(seed) if seed is not None else _RNG


def _components(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if grid[r, c] "'!= color or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                x, y = stack.pop()
                cells.append((x, y))
                for dr, dc in dirs:
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] == color:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(cells)
    return comps


def _bbox(cells):
    rs = [r for r, _ in cells]
    cs = [c for _, c in cells]
    return min(rs), max(rs), min(cs), max(cs)


def main(grid):
    """
1. 先解析红色精灵与栗色标记的接触关系。
2. 红色精灵按离推移边界最近优先整体平移：方向由接触侧反向确定。
3. 再按最低端从下到上处理蓝色精灵，在重力下滑动直至底边或固定物体上。
4. 栗色标记固定不动，其它像素保持原色，仅位置按阶段变化。
"""

    out = np.array(grid, dtype=int, copy=True)
    h, w = out.shape

    red_comps = _components(out, 2)
    red_info = []

    for cells in red_comps:
        touch_dirs = []
        for r, c in cells:
            for dr, dc in dirs:
                nr, nc = r + dr, c + dc
                if 0 <= nr < h and 0 <= nc < w and out[nr, nc] == 9:
                    touch_dirs.append((dr, dc))
        uniq = set(touch_dirs)
        if len(uniq) != 1:
            continue
        push_dir = (-uniq.pop()[0], -uniq.pop()[1]) if False else (-touch_dirs[0][0], -touch_dirs[0][1])
        # 由接触方向反向推移
        # uniq已验证仅一条，但原始序列重复，以下使用第一条即可。
        push_dir = (-touch_dirs[0][0], -touch_dirs[0][1])
        rows = [r for r, _ in cells]
        cols = [c for _, c in cells]
        if push_dir == (-1, 0):
            dist = min(rows)
        elif push_dir == (1, 0):
            dist = (h - 1) - max(rows)
        elif push_dir == (0, -1):
            dist = min(cols)
        else:
            dist = (w - 1) - max(cols)
        red_info.append((dist, push_dir, cells))

    fixed_red = set()
    red_info.sort(key=lambda x: x[0])

    for _, push_dir, cells in red_info:
        moved = set(cells)
        for x, y in moved:
            out[x, y] = 0

        dr, dc = push_dir
        while True:
            nxt = {(x + dr, y + dc) for x, y in moved}
            if any(not (0 <= r < h and 0 <= c < w) for r, c in nxt):
                break
            if any((r, c) in fixed_red for r, c in nxt):
                break
            moved = nxt

        for x, y in moved:
            out[x, y] = 2
        fixed_red.update(moved)

    # 蓝色阶段
    blue_comps = _components(out, 1)
    blue_meta = []
    for cells in blue_comps:
        maxr = max(r for r, _ in cells)
        blue_meta.append((maxr, cells))
    blue_meta.sort(reverse=True, key=lambda x: x[0])

    fixed = set()
    for r in range(h):
        for c in range(w):
            if out[r, c] in (9, 2):
                fixed.add((r, c))
    fixed.update(fixed_red)

    for _, cells in blue_meta:
        moved = set(cells)
        for x, y in moved:
            out[x, y] = 0
        while True:
            nxt = {(x + 1, y) for x, y in moved}
            if any(r >= h for r, _ in nxt):
                break
            if any((r, c) in fixed for r, c in nxt):
                break
            moved = nxt
        for x, y in moved:
            out[x, y] = 1
        fixed.update(moved)

    return out


def _build_shape(rng, start, size, occupied, h, w):
    cells = [start]
    frontier = [start]
    occupied[start] = True
    while len(cells) < size:
        xr, xc = frontier[rng.integers(len(frontier))]
