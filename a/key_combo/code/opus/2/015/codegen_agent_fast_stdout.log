        minr, maxr = min(rows), max(rows)
        minc, maxc = min(cols), max(cols)
        if ir == minr:
            direction = "up"
        elif ir == maxr:
            direction = "down"
        elif ic == minc:
            direction = "left"
        elif ic == maxc:
            direction = "right"
        else:
