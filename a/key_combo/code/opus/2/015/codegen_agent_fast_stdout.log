        else:
            grid[mr, mc] = 2

    occ[max(0, r0 - 1):min(h, r1 + 2), max(0, c0 - 1):min(w, c1 + 2)] = True
    return True


def generate_input(seed=None):
    rng = _rng(seed)
    H = W = 18

    while True:
        grid = np.zeros((H, W), dtype=int)
        occ = np.zeros((H, W), dtype=bool)
        n = int(rng.integers(2, 4))
