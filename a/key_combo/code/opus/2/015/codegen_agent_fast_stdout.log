-
-        target_color = int(palette[L - 1])
-        if not (0 <= nr <= h - 2 and 0 <= nc <= w - 2):
-            continue
-        for r, c in body:
-            rr = nr + (r - br)
-            cc = nc + (c - bc)
-            if 0 <= rr < h and 0 <= cc < w:
-                out[rr, cc] = target_color
-
-    return out
