            mc = int(rng.integers(inner_c0, inner_c1 + 1))
        else:
            mr = int(rng.integers(axis + 1, inner_r1 + 1))
            mc = int(rng.integers(inner_c0, inner_c1 + 1))
        has_m = False
        for rr in range(half_rows[0], half_rows[1]):
