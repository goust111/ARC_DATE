                    iw = int(np.ceil(ih * 1.6)) + int(rng.integers(1, 4))
                else:
                    iw = int(rng.integers(5, 8))
                    ih = int(np.ceil(iw * 1.6)) + int(rng.integers(1, 4))
                ih = int(ih)
                iw = int(iw)
