import hashlib, importlib.util, numpy as np
base='/home/lixinyu/snap/a/key_combo/code/opus/2/015'
err=[]
for i in range(1,9):
    spec=importlib.util.spec_from_file_location(f'm{i}', f'{base}/{i}.py')
    mod=importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)

    hashes=set(); ok=True
    for t in range(100):
        try:
            g=mod.generate_input()
        except Exception as e:
            err.append((i,'generate',repr(e)))
            ok=False
            break
        if not isinstance(g,np.ndarray) or g.ndim"'!=2 or g.shape[0]>30 or g.shape[1]>30:
            err.append((i,'"'generate_type_shape'))
            ok=False
            break
        try:
            o=mod.main(g)
        except Exception as e:
            err.append((i,'main',repr(e)))
            ok=False
            break
        if not isinstance(o,np.ndarray) or o.ndim"'!=2 or o.shape[0]>30 or o.shape[1]>30:
            err.append((i,'"'main_type_shape'))
            ok=False
            break
        hashes.add(hashlib.md5(g.tobytes()).hexdigest())
    if ok and len(hashes)<20:
        err.append((i,f'variants={len(hashes)}'))
    if ok:
        print(i,'ok variants',len(hashes))

print('errors',err)
