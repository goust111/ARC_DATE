                    out[nr, nc] = 3
                    nr += dr
                    nc += dc

    for r, c in [(x, y) for x, y in np.argwhere(out == 2).tolist()]:
        out[r, c] = 4
    return out


def _place_frame(grid, occ, rng, r0, c0, ih, iw, is_wide):
    h, w = grid.shape
    r1 = r0 + ih + 1
    c1 = c0 + iw + 1
    if r1 >= h - 1 or c1 >= w - 1:
