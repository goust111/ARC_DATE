-            continue
-
-        body = info["body"]
-        line = info["line"]
-        dr, dc = info["dir"]
-
-        for r, c in body:
-            out[r, c] = 0
-        for r, c in line:
-            out[r, c] = 0
-
-        br, bc = min(r for r, _ in body), min(c for _, c in body)
