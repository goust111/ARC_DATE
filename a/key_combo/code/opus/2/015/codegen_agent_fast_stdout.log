import numpy as np

_RNG = np.random.default_rng(20260707)

def _rng(seed=None):
    return np.random.default_rng(seed) if seed is not None else _RNG


def _components(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if grid[r, c] "'!= color or seen[r, c]:
                continue
            st = [(r, c)]
            seen[r, c] = True
            cells = []
            while st:
                x, y = st.pop()
                cells.append((x, y))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dr, y + dc
                    if 0 <= nx < h and 0 <= ny < w and not seen[nx, ny] and grid[nx, ny] == color:
                        seen[nx, ny] = True
                        st.append((nx, ny))
            comps.append(cells)
    return comps


def _parse_group(cells_set):
    rs = [r for r, _ in cells_set]
    cs = [c for _, c in cells_set]
    minr, maxr = min(rs), max(rs)
    minc, maxc = min(cs), max(cs)
    if minr < 0 or minc < 0:
        return None

    for r in range(minr, maxr):
        for c in range(minc, maxc):
            body = {(r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1)}
            if not body.issubset(cells_set):
                continue

            # right
            start = (r, c + 2)
            line = []
            cur = start
            while cur in cells_set and cur not in body:
                line.append(cur)
                cur = (cur[0], cur[1] + 1)
            if len(line) in (1, 2, 3, 4):
                ar, ac = r, c + 2 + len(line)
                if all((ar + dr, ac + dc) in cells_set for dr, dc in ((0, 0), (0, 1), (1, 0), (1, 1))):
                    return {"body": body, "line": set(line), "L": len(line), "dir": (0, 1)}

            # left
            start = (r, c - 1)
            line = []
            cur = start
            while cur in cells_set and cur not in body:
                line.append(cur)
                cur = (cur[0], cur[1] - 1)
            if len(line) in (1, 2, 3, 4):
                ar, ac = r, c - 2 - len(line)
                if all((ar + dr, ac + dc) in cells_set for dr, dc in ((0, 0), (0, 1), (1, 0), (1, 1))):
                    return {"body": body, "line": set(line), "L": len(line), "dir": (0, -1)}

            # down
            start = (r + 2, c)
            line = []
            cur = start
            while cur in cells_set and cur not in body:
                line.append(cur)
                cur = (cur[0] + 1, cur[1])
            if len(line) in (1, 2, 3, 4):
                ar, ac = r + 2 + len(line), c
                if all((ar + dr, ac + dc) in cells_set for dr, dc in ((0, 0), (0, 1), (1, 0), (1, 1))):
                    return {"body": body, "line": set(line), "L": len(line), "dir": (1, 0)}

            # up
            start = (r - 1, c)
            line = []
            cur = start
            while cur in cells_set and cur not in body:
                line.append(cur)
                cur = (cur[0] - 1, cur[1])
            if len(line) in (1, 2, 3, 4):
                ar, ac = r - 2 - len(line), c
                if all((ar + dr, ac + dc) in cells_set for dr, dc in ((0, 0), (0, 1), (1, 0), (1, 1)):
                    return {"body": body, "line": set(line), "L": len(line), "dir": (-1, 0)}
    return None


def main(grid):
    """
1) 解析每组“红色2x2矩形体 + 1格宽杆 + 灰色锚定物”的组块。
2) 杆长度 L 由组内红色像素到锚定物前的连续杆段得到。
3) 将矩形体整体平移 L 格至锚定物相邻。
4) 平移后颜色按调色板第 L 个颜色重涂（L 从1开始）。
5) 只在目标列/行内移动矩形体，不改变杆和锚定物。
"""

    out = np.array(grid, dtype=int, copy=True)
    h, w = out.shape

    palette = [v for v in out[0, :4] if v != 0]

    red_components = _components(out, 2)
    for comp in red_components:
        comp_set = set(comp)
        info = _parse_group(comp_set)
        if info is None:
            continue

        L = info["L"]
        if L < 1 or L > len(palette):
            continue

        body = info["body"]
        line = info["line"]
        dr, dc = info["dir"]

        for r, c in body:
            out[r, c] = 0
        for r, c in line:
            out[r, c] = 0

        br, bc = min(r for r, _ in body), min(c for _, c in body)
        nr, nc = br + dr * L, bc + dc * L

        target_color = int(palette[L - 1])
        if not (0 <= nr <= h - 2 and 0 <= nc <= w - 2):
            continue
        for r, c in body:
            rr = nr + (r - br)
            cc = nc + (c - bc)
            if 0 <= rr < h and 0 <= cc < w:
                out[rr, cc] = target_color

    return out


def generate_input(seed=None):
    rng = _rng(seed)
    h = w = 16

    while True:
        grid = np.zeros((h, w), dtype=int)
        occ = np.zeros((h, w), dtype=bool)

        palette_colors = [1, 3, 4, 7, 6]
        cols = list(rng.choice(palette_colors, size=4, replace=False))
        for c in range(4):
            grid[0, c] = cols[c]

        groups = int(rng.integers(2, 5))
        lengths = set()

        for _ in range(groups):
            ok = False
            for _ in range(300):
                dir_id = int(rng.integers(4))
                L = int(rng.integers(1, 5))
                if len(lengths) >= 2 and L in lengths:
                    if rng.random() > 0.5:
                        pass
                r = int(rng.integers(0, h - 1))
                c = int(rng.integers(0, w - 1))

                if dir_id == 0:  # right
                    if c + 4 + L >= w:
                        continue
                    if r + 1 >= h - 1 or r < 0:
                        continue
                    body = {(r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1)}
                    stem = {(r, c + 2 + i) for i in range(L)}
                    anchor = {(r, c + 2 + L), (r, c + 3 + L), (r + 1, c + 2 + L), (r + 1, c + 3 + L)}
                elif dir_id == 1:  # left
                    if c - (2 + L) < 0 or c + 1 >= w:
                        continue
                    body = {(r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1)}
                    stem = {(r, c - 1 - i) for i in range(L)}
                    anchor = {(r, c - 2 - L), (r, c - 3 - L), (r + 1, c - 2 - L), (r + 1, c - 3 - L)}
                elif dir_id == 2:  # down
                    if r + 3 + L >= h:
                        continue
                    body = {(r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1)}
                    stem = {(r + 2 + i, c) for i in range(L)}
                    anchor = {(r + 2 + L, c), (r + 3 + L, c), (r + 2 + L, c + 1), (r + 3 + L, c + 1)}
                else:  # up
                    if r - (3 + L) < 0:
                        continue
                    body = {(r, c), (r, c + 1), (r + 1, c), (r + 1, c + 1)}
                    stem = {(r - 1 - i, c) for i in range(L)}
                    anchor = {(r - 2 - L, c), (r - 3 - L, c), (r - 2 - L, c + 1), (r - 3 - L, c + 1)}

                cells = body | stem | anchor
                if any(x < 0 or y < 0 or x >= h or y >= w for x, y in cells):
                    continue
                if any(occ[x, y] for x, y in cells):
                    continue

                if not (dir_id in (2, 3) and c + 1 >= w):
                    pass

                for x, y in body:
                    grid[x, y] = 2
                for x, y in stem:
                    grid[x, y] = 2
                for x, y in anchor:
                    grid[x, y] = 5
                for x, y in cells:
                    occ[x, y] = True

                lengths.add(L)
                ok = True
                break
            if not ok:
                continue

        if len(lengths) >= 2:
            return grid


if __name__ == "__main__":
    pass
