import numpy as np

_RNG = np.random.default_rng(20260707)
_PALETTE = np.array([1, 3, 4, 7, 6], dtype=np.int32)
_DIRECTIONS = {\"up\": (-1, 0), \"down\": (1, 0), \"left\": (0, -1), \"right\": (0, 1)}


def _get_rng(seed=None):
    return np.random.default_rng(seed) if seed is not None else _RNG


def _component_cells(grid):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if grid[r, c] == 0 or seen[r, c]:
                continue
            color = grid[r, c]
            stack = [(r, c)]
            seen[r, c] = True
            cells = []
            while stack:
                x, y = stack.pop()
                cells.append((x, y))
                v = grid[x, y]
                if v "'!= color:
                    continue
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and grid[nr, nc] != 0:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(cells)
    return comps


def main(grid):
    """
1. 目标: 对每个带红色指示像素的多色矩形块做方向化延伸。
2. 输入/输出: 输入为二维numpy数组，0为背景；返回同尺寸numpy数组。
3. 规则: 统计指示块内非黑非红颜色种数K，按指示方向在其外侧生成长度K的绿带，并将指示像素改黄。
4. 复杂度: 以网格面积为n，连通块扫描与重绘为O(n)。
"""

    g = np.array(grid, dtype=int, copy=True)
    for cells in _component_cells(g):
        reds = [(r, c) for r, c in cells if g[r, c] == 2]
        if len(reds) != 1:
            continue
        colors = {g[r, c] for r, c in cells} - {0, 2}
        k = len(colors)
        if k <= 0:
            continue
        minr = min(r for r, _ in cells)
        maxr = max(r for r, _ in cells)
        minc = min(c for _, c in cells)
        maxc = max(c for _, c in cells)
        ir, ic = reds[0]
        if ir == minr:
            direction = "up"
            extent = k
            start_r = ir - extent
            if start_r < 0:
                continue
            for rr in range(start_r, ir):
                for cc in range(minc, maxc + 1):
                    g[rr, cc] = 3
        elif ir == maxr:
            direction = "down"
            start_r = ir + 1
            end_r = start_r + k
            if end_r > g.shape[0]:
                continue
            for rr in range(start_r, end_r):
                for cc in range(minc, maxc + 1):
                    g[rr, cc] = 3
        elif ic == minc:
            direction = "left"
            start_c = ic - k
            if start_c < 0:
                continue
            for rr in range(minr, maxr + 1):
                for cc in range(start_c, ic):
                    g[rr, cc] = 3
        elif ic == maxc:
            direction = "right"
            start_c = ic + 1
            end_c = start_c + k
            if end_c > g.shape[1]:
                continue
            for rr in range(minr, maxr + 1):
                for cc in range(start_c, end_c):
                    g[rr, cc] = 3
        else:
            continue
        g[ir, ic] = 4
    return g


def generate_input(seed=None):
    rng = _get_rng(seed)
    H, W = 15, 15

    while True:
        grid = np.zeros((H, W), dtype=int)
        occ = np.zeros((H, W), dtype=bool)
        count = int(rng.integers(3, 6))
        placed = 0
        for _ in range(count):
            ok = False
            for _ in range(200):
                h = int(rng.integers(2, 4))  # 2-3
                w = int(rng.integers(3, 5))  # 3-4
                direction = int(rng.integers(4))
                k = int(rng.integers(1, 5))
                colors = rng.choice(_PALETTE, size=k, replace=False)

                if direction == 0:  # up
                    r0 = int(rng.integers(3, H - h + 1))
                    c0 = int(rng.integers(0, W - w + 1))
                    ext_rows = (r0 - 4, r0)
                elif direction == 1:  # down
                    r0 = int(rng.integers(0, H - h - 3 + 1))
                    c0 = int(rng.integers(0, W - w + 1))
                    ext_rows = (r0 + h, r0 + h + 4)
                elif direction == 2:  # left
                    r0 = int(rng.integers(0, H - h + 1))
                    c0 = int(rng.integers(3, W - w + 1))
                    ext_rows = (r0, r0 + h)
                else:  # right
                    r0 = int(rng.integers(0, H - h + 1))
                    c0 = int(rng.integers(0, W - w - 3 + 1))
                    ext_rows = (r0, r0 + h)

                block_rows = (r0, r0 + h)
                block_cols = (c0, c0 + w)
                if direction in (0, 1):
                    ext_cols = block_cols
                    e_r0, e_r1 = ext_rows
                    if e_r0 < 0 or e_r1 > H:
                        continue
                else:
                    ext_cols = (
                        c0 - 4 if direction == 2 else c0 + w,
                        c0 if direction == 2 else c0 + w + 4,
                    )
                    e_r0, e_r1 = block_rows
                    if ext_cols[0] < 0 or ext_cols[1] > W:
                        continue

                rr0 = max(0, min(block_rows[0], e_r0) - 1)
                rr1 = min(H, max(block_rows[1], e_r1) + 1)
                cc0 = max(0, min(block_cols[0], ext_cols[0]) - 1)
                cc1 = min(W, max(block_cols[1], ext_cols[1]) + 1)

                if np.any(occ[rr0:rr1, cc0:cc1]):
                    continue

                r = rng.integers(r0, r0 + h)
                c = rng.integers(c0, c0 + w)
                if direction == 0:
                    if r != r0:
