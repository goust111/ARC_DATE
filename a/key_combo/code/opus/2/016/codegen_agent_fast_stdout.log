    colors = [1, 2, 3, 4]
    _RNG.shuffle(colors)
    cols = colors[:k]

    points = []
    used_rows = []
    used_cols = []
    attempts = 0
    while len(points) < k and attempts < 5000:
        attempts += 1
        rr = int(_RNG.integers(2, h - 2))
        cc = int(_RNG.integers(2, w - 2))
        if any(abs(rr - rv) < 2 for rv in used_rows):
            continue
        if any(abs(cc - cv) < 2 for cv in used_cols):
            continue
        used_rows.append(rr)
        used_cols.append(cc)
        points.append((rr, cc))

    while len(points) < k:
        rr = 2 + len(points)
        cc = 2 + len(points)
        points.append((rr, cc))

    for (r, c), col in zip(points, cols):
        g[r, c] = col

    return g
