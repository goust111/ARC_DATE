import numpy as np

_RNG = np.random.default_rng(20260102)


def _components(grid: np.ndarray):
    mask = grid > 0
    h, w = grid.shape
    vis = np.zeros_like(mask, dtype=bool)
    comps = []
    dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))

    for r in range(h):
        for c in range(w):
            if not mask[r, c] or vis[r, c]:
                continue
            q = [(r, c)]
            vis[r, c] = True
            comp = []
            qi = 0
            while qi < len(q):
                x, y = q[qi]
                qi += 1
                comp.append((x, y))
                for dr, dc in dirs:
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not vis[nr, nc]:
                        vis[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps


def _norm(coords):
    arr = np.array(coords, dtype=int)
    arr -= arr.min(axis=0)
    return tuple(sorted((int(r), int(c)) for r, c in arr.tolist()))


def _transforms(coords):
    arr = np.array(coords, dtype=int)
    x = arr[:, 0]
    y = arr[:, 1]
    variants = [
        (x, y),
        (x, -y),
        (-x, y),
        (-x, -y),
        (y, x),
        (y, -x),
        (-y, x),
        (-y, -x),
    ]
    out = set()
    for a, b in variants:
        out.add(_norm(np.stack([a, b], axis=1)))
    return out


def _connected_without_diag(points):
    return _norm(points)


