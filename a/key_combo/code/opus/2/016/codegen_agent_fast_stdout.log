def generate_input():
    """随机且稳定地生成输入：门框与障碍形成至少一条含转弯的单调最短走廊。"""
    h = w = 14
    g = np.zeros((h, w), dtype=int)

    def ring(top, left, miss, color):
        g[top + 1, left + 1] = 9
        g[top + 0, left + 1] = 6 if miss != "up" else 0
        g[top + 1, left + 0] = 6 if miss != "left" else 0
        g[top + 1, left + 2] = 6 if miss != "right" else 0
        g[top + 2, left + 1] = 6 if miss != "down" else 0
        g[top + 0, left] = 6
        g[top + 0, left + 2] = 6
        g[top + 2, left] = 6
        g[top + 2, left + 2] = 6
        g[top, left] = color
        g[top, left + 2] = color
        g[top + 2, left] = color
        g[top + 2, left + 2] = color

    ring(2, 2, "left", 6)
    ring(9, 8, "up", 6)

    # 横向+纵向障碍形成多路径并集转弯\n    for c in range(3, 9):
        g[6, c] = 5
    for r in range(4, 9):
        g[r, 9] = 5
    # 打开一条转弯单调通路
    g[6, 3] = 0
    g[7, 9] = 0

    return g
