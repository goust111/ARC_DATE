        placed = False
        for _ in range(500):
            r0 = int(_RNG.integers(0, max(1, qh - max(p[0] for p in shape) - 1)))
            c0 = int(_RNG.integers(0, max(1, qw - max(p[1] for p in shape) - 1)))
            if all(g[start_row + r0 + rr, c0 + cc] == 0 for rr, cc in shape):
