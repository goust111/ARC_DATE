import importlib.util
import pathlib
import py_compile
import numpy as np

base = pathlib.Path('/home/lixinyu/snap/a/key_combo/code/opus/2/016')
files = [str(base / f'{i}.py') for i in range(1, 11)]

for fp in files:
    py_compile.compile(fp, doraise=True)

for fp in files:
    name = pathlib.Path(fp).stem
    spec = importlib.util.spec_from_file_location(name, fp)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)

    variants = set()
    ok = True
    err = ''
    for _ in range(100):
        try:
            inp = mod.generate_input()
            a = np.array(inp)
            if a.ndim "'!= 2 or a.shape[0] == 0 or a.shape[1] == 0 or a.shape[0] > 30 or a.shape[1] > 30:
                ok = False
                err = '"'bad_input'
                break
            out = mod.main(a)
            b = np.array(out)
            if b.ndim "'!= 2 or b.shape[0] == 0 or b.shape[1] == 0 or b.shape[0] > 30 or b.shape[1] > 30:
                ok = False
                err = '"'bad_output'
                break
            variants.add(bytes(a.tobytes()))
        except Exception as e:
            ok = False
            err = str(e)
            break

    print(name, 'OK' if ok else 'FAIL ' + err, 'variants=', len(variants))
