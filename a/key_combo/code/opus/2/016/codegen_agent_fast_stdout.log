    src_v = np.full((h, w, 2), -1, dtype=int)

    for r0, c0, col in points:
        for cc in range(w):
            color_h[r0, cc] = col
            src_h[r0, cc] = (r0, c0)
        for rr in range(h):
            color_v[rr, c0] = col
            src_v[rr, c0] = (r0, c0)

    line = np.zeros_like(g)
    for r in range(h):
        for c in range(w):
            has_h = src_h[r, c, 0] != -1
            has_v = src_v[r, c, 0] != -1
