+
+def _paint_wall(
+    grid: np.ndarray,
+    path_set: set[tuple[int, int]],
+    r: int,
+    c: int,
+    color: int,
+) -> bool:
+    if not in_bounds(grid.shape, r, c) or (r, c) in path_set:
+        return True
+    cur = int(grid[r, c])
+    if cur != Color.ORANGE and cur != color:
+        return False
+    grid[r, c] = color
+    return True
