+    for sprite in sprites:
+        first = _first_approach_index(path, sprite["coords"])
+        if first is None:
+            continue
+        chosen.append((first, _sprite_crop(sprite)))
+
+    if not chosen:
+        return np.zeros((1, 1), dtype=int)
+
+    chosen.sort(key=lambda item: item[0])
