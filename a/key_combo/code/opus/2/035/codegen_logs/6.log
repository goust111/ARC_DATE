+        if not _place_remote_sprite(grid, path_forbidden, sprite_cells):
+            return None
+
+    if not _generator_ok(grid, path):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        grid = _gen_attempt()
+        if grid is not None:
