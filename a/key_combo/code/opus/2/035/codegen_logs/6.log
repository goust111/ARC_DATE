+def _sprite_crop(sprite: dict) -> np.ndarray:
+    r0, c0, r1, c1 = sprite["bbox"]
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in sprite["coords"]:
+        out[r - r0, c - c0] = int(sprite["color"])
+    return out
