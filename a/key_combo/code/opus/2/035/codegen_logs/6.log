+def _generator_ok(
+    grid: np.ndarray,
+    expected_path: list[tuple[int, int]],
+) -> bool:
+    if max(grid.shape) > 30:
+        return False
+    traced = trace_path(grid)
+    if traced != expected_path:
+        return False
+
+    sprites = find_sprite_components(grid)
+    if not (4 <= len(sprites) <= 6):
