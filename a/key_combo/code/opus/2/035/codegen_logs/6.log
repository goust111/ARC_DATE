+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def find_sprite_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    out = []
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color not in SPRITE_COLORS or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if not in_bounds(g.shape, nr, nc) or seen[nr, nc]:
+                        continue
+                    if int(g[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": len(coords),
+                }
+            )
+    return out
+
+
+def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str) -> bool:
+    H, W = grid.shape
+    if not (0 <= r < H and 0 <= c < W):
+        return False
+    if int(grid[r, c]) not in PASSABLE_COLORS:
+        return False
+    if direction in {"left", "right"}:
+        if r == 0 or r == H - 1:
+            return False
+        a, b = int(grid[r - 1, c]), int(grid[r + 1, c])
+    else:
+        if c == 0 or c == W - 1:
+            return False
+        a, b = int(grid[r, c - 1]), int(grid[r, c + 1])
+    return a == b and a not in PASSABLE_COLORS
