+    H, W = g.shape
+    seen = np.zeros((H, W), dtype=bool)
+    out = []
+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color not in SPRITE_COLORS or seen[r, c]:
+                continue
