+        options = []
+        for turn_dir in PERPENDICULAR[direction]:
+            tdr, tdc = DIRS[turn_dir]
+            tr, tc = r + tdr, c + tdc
+            if _has_corridor(g, tr, tc, turn_dir):
+                options.append((tr, tc, turn_dir))
+        assert len(options) <= 1, "ambiguous turn"
+        if not options:
+            break
+        r, c, direction = options[0]
+        path.append((r, c))
+    return path
