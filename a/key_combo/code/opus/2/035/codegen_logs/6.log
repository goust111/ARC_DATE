+    for _ in range(g.size * 8):
+        dr, dc = DIRS[direction]
+        nr, nc = r + dr, c + dc
+        if not in_bounds(g.shape, nr, nc):
+            break
+        if int(g[nr, nc]) in PASSABLE_COLORS:
+            r, c = nr, nc
+            path.append((r, c))
+            continue
