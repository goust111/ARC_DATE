    raise RuntimeError("failed to choose rows")


def _choose_turn_cols(W: int) -> tuple[int, int]:
    odds = [c for c in range(3, W - 2, 2)]
    for _ in range(200):
        c2, c1 = sorted(random.sample(odds, 2))
        if c1 - c2 < 4:
            continue
        if c1 > W - 4 or c2 < 3:
            continue
        if c2 > W // 2:
            continue
        if c1 < W // 2:
            continue
        return c1, c2
    raise RuntimeError("failed to choose turn columns")


