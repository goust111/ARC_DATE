+        suppressed = set()
+        if idx + 1 < len(segments):
+            turn_r = segments[idx + 1][0][0] - segment[-1][0]
+            turn_c = segments[idx + 1][0][1] - segment[-1][1]
+            prev_r, prev_c = segment[-2]
+            suppressed.add((prev_r + turn_r, prev_c + turn_c))
