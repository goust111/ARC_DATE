+    "right": (0, 1),
+    "left": (0, -1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
+PERPENDICULAR = {
+    "right": ("up", "down"),
+    "left": ("up", "down"),
+    "up": ("left", "right"),
+    "down": ("left", "right"),
+}
+PASSABLE_COLORS = {Color.ORANGE, Color.PINK, Color.YELLOW, Color.MAROON}
+SPRITE_COLORS = (Color.YELLOW, Color.MAROON)
+BAR_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.GREY, Color.TEAL]
