+    segments = [
+        [(r1, c) for c in range(0, c1 + 1)],
+        [(r, c1) for r in seg2_rows],
+        [(r2, c) for c in range(c1 - 1, c2 - 1, -1)],
+        [(r, c2) for r in seg4_rows],
+        [(r3, c) for c in range(c2 + 1, W)],
+    ]
