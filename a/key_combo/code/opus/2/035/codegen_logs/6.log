+def _apply_path_sprite(
+    grid: np.ndarray,
+    path: list[tuple[int, int]],
+    start: int,
+    length: int,
+    color: int,
+) -> set[tuple[int, int]]:
+    coords = set(path[start : start + length])
+    for r, c in coords:
+        grid[r, c] = color
+    return coords
