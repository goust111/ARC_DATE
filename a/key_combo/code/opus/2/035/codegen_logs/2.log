+        for r, c in path:
+            input_grid[r, c] = BRIDGE
+
+    try:
+        if np.array_equal(main(input_grid), output_grid):
+            return input_grid
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid bridge-gated docking puzzle")

