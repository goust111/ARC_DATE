+
+def _edge_segment(mask: np.ndarray, side: str) -> tuple[int, list[int]] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    if side == "top":
+        row = int(coords[:, 0].min())
+        values = sorted(int(c) for c in coords[coords[:, 0] == row][:, 1])
+        return row, values
+    if side == "bottom":
