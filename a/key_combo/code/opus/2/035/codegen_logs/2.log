+    goal_set = set(goals)
+
+    def is_clear(cell: tuple[int, int]) -> bool:
+        if cell in goal_set:
+            return True
+        if int(grid[cell]) != BG:
+            return False
+        return len(_neighbor_nonblack(grid, cell)) == 0
+
+    q = deque()
+    parent: dict[tuple[int, int], tuple[int, int] | None] = {}
+    for cell in starts:
+        if cell in parent:
+            continue
+        parent[cell] = None
+        q.append(cell)
+
+    while q:
+        cur = q.popleft()
+        if cur in goal_set:
+            path = []
+            node = cur
+            while node is not None:
+                path.append(node)
+                node = parent[node]
+            path.reverse()
+            return path
+        dirs = DIR4[:]
+        rng.shuffle(dirs)
+        for dr, dc in dirs:
+            nr, nc = cur[0] + dr, cur[1] + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]):
+                continue
+            if nxt in parent:
+                continue
+            if is_clear(nxt):
+                parent[nxt] = cur
+                q.append(nxt)
