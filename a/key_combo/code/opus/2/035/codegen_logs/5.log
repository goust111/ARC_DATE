+            arm_color = int(arm_colors[0])
+            assert arm_color != center_color, "cross center and arms must differ"
+            assert all(int(obj[r0 + dr, c0 + dc]) == bg for dr, dc in ((0, 0), (0, 2), (2, 0), (2, 2)))
