+    for domino in dominoes:
+        color = int(domino["color"])
+        if domino["orientation"] == "h":
+            r = int(domino["row"])
+            c = int(domino["col"])
+            grid[r, c : c + 2] = color
+        else:
+            r = int(domino["row"])
+            c = int(domino["col"])
+            grid[r : r + 2, c] = color
