+            return None
+        starts = list(range(width - 1))
+        if side_preference == "right":
+            starts = _shuffle([c for c in starts if c >= width // 2]) + _shuffle([c for c in starts if c < width // 2])
+        elif side_preference == "left":
+            starts = _shuffle([c for c in starts if c < width // 2]) + _shuffle([c for c in starts if c >= width // 2])
