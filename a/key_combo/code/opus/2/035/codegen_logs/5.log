+
+    if axis in used_cols:
+        return None
+    starts = list(range(height - 1))
+    if side_preference == "top":
+        starts = _shuffle([r for r in starts if r < height // 2]) + _shuffle([r for r in starts if r >= height // 2])
+    elif side_preference == "bottom":
