+    rows_overlap = max(ar0, br0) <= min(ar1, br1)
+    cols_overlap = max(ac0, bc0) <= min(ac1, bc1)
+    if rows_overlap and (ac1 + 1 == bc0 or bc1 + 1 == ac0):
