+        assert len(parsed_v) == sum(item["orientation"] == "v" for item in dominoes)
+        out = main(grid)
+        assert out.shape == grid.shape
+        assert max(grid.shape) <= 30 and max(out.shape) <= 30
+    except AssertionError:
