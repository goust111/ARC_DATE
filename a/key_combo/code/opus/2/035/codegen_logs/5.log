+    crosses = []
+    for idx in range(int(num_crosses)):
+        slot = slots[idx]
+        center = (int(GEN_RNG.choice(np.array(slot["rows"]))), int(GEN_RNG.choice(np.array(slot["cols"]))))
+        crosses.append(
+            {
+                "center": center,
+                "arm_color": int(colors[2 * idx]),
+                "center_color": int(colors[2 * idx + 1]),
+                "bbox": _cross_bbox(center),
