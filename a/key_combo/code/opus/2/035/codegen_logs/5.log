+        for _ in range(30):
+            orientation = str(GEN_RNG.choice(np.array(["h", "v"])))
+            wants_interaction = bool(GEN_RNG.random() < 0.3)
+            target_cross = crosses[int(GEN_RNG.integers(len(crosses)))]
