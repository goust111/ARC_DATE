+    if h_domino is None:
+        return None
+    dominoes.append(h_domino)
+
+    v_axis = int(GEN_RNG.choice(np.arange(cross_b["center"][1] - 2, cross_b["center"][1] + 3)))
+    v_domino = _place_domino(
