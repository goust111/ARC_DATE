+def _bbox_conflicts(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = map(int, a)
+    br0, bc0, br1, bc1 = map(int, b)
+
+    overlaps = not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+    if overlaps:
+        return True
