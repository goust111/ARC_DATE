17:def main(input_grid):
18:    """
19:    Collapse a separator grid into one color per region, then mirror the compact grid left-to-right.
20:
21:    Input structure:
22:    - The input is divided into uniformly colored cells by horizontal and vertical separator bars.
23:    - Each region between separators has a single color.
24:    - The separator color forms a connected partition spanning the full canvas.
25:
26:    Rule:
27:    - Identify the separator color and extract all separator-delimited regions.
28:    - Replace each region with one pixel of its region color, preserving row and column order.
29:    - Mirror the compact region-color grid horizontally.
30:
31:    Key insight:
32:    - The large chessboard-like image is an enlarged region map; the final step is a left-right
33:      reflection of that compressed map.
34:    """
35:    # Plan:
36:    # 1. Determine the color of the separator between the regions
37:    # 2. Extract all the regions separated by the separator color
38:    # 3. Find the region positions and their possible X/Y positions
39:    # 4. Create the output grid so that one pixel represents the original region, preserving X/Y ordering
40:    # 5. Mirror the output grid by x-axis
41:
42:    H, W = input_grid.shape
43:
44:    # 1. Determine the separator color.
45:    # Mirror the legacy seed approach: find the monochromatic component (non-black)
46:    # whose bbox spans the whole canvas.
47:    bg = Color.BLACK
48:    sep_objs = find_components(input_grid, bg=bg, connectivity=4, monochromatic=True, return_format="objects")
49:    sep_candidates = [obj for obj in sep_objs if bbox(obj != bg) == (0, 0, H - 1, W - 1)]
50:    assert len(sep_candidates) == 1, "There should be exactly 1 separator partitioning the input"
51:    separator_color = colors_present(sep_candidates[0], exclude={bg})[0]
52:
53:    # 2. Extract all regions separated by the separator color.
54:    regions = find_components(
55:        input_grid,
56:        bg=int(separator_color),
57:        connectivity=4,
58:        monochromatic=True,
59:        return_format="dict",
60:    )
61:
62:    # 3/4. Build the downscaled grid (one pixel per region), preserving row/col ordering.
63:    r_positions = sorted({int(reg["bbox"][0]) for reg in regions})
64:    c_positions = sorted({int(reg["bbox"][1]) for reg in regions})
65:    r_to_i = {r: i for i, r in enumerate(r_positions)}
66:    c_to_j = {c: j for j, c in enumerate(c_positions)}
67:
68:    output_grid = np.full((len(r_positions), len(c_positions)), Color.BLACK, dtype=int)
69:    for reg in regions:
70:        r0, c0, _r1, _c1 = reg["bbox"]
71:        output_grid[r_to_i[int(r0)], c_to_j[int(c0)]] = int(reg["color"])
72:
73:    # 5. Mirror the downscaled grid horizontally (left-right).
74:    output_grid = np.fliplr(output_grid)
75:
76:    return output_grid
