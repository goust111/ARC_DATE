14:def main(grid: np.ndarray) -> np.ndarray:
15:    """
16:    Extend each colored domino marker into a full row or column bar, with horizontal bars covering vertical bars at crossings.
17:
18:    Input structure:
19:    - The background is the dominant color.
20:    - Every foreground object is a 4-connected same-color domino of exactly two pixels.
21:    - A horizontal domino marks a row to paint; a vertical domino marks a column to paint.
22:
23:    Rule:
24:    - Paint each marked column entirely with the color of its vertical domino marker.
25:    - Paint each marked row entirely with the color of its horizontal domino marker.
26:    - Rows are painted after columns, so row bars overwrite column bars at intersections.
27:
28:    Key insight:
29:    - The two-pixel orientation is the instruction: horizontal markers emit row bars, vertical markers emit column bars, and the only layering cue is row-over-column.
30:    """
31:    g = np.asarray(grid, dtype=int)
32:    assert g.ndim == 2
33:    bg = get_bg(g)
34:
35:    row_colors: dict[int, int] = {}
36:    col_colors: dict[int, int] = {}
37:    components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
38:    assert components, "expected at least one foreground domino"
39:
40:    for comp in components:
41:        color = int(comp["color"])
42:        coords = comp["coords"]
43:        assert len(coords) == 2, "each foreground object must be a two-pixel domino"
44:        r0, c0, r1, c1 = comp["bbox"]
45:
46:        if r0 == r1 and c1 == c0 + 1:
47:            _add_bar(row_colors, r0, color)
48:        elif c0 == c1 and r1 == r0 + 1:
49:            _add_bar(col_colors, c0, color)
50:        else:
51:            raise AssertionError("domino marker must be horizontal or vertical")
52:
53:    out = np.full_like(g, int(bg))
54:    for c, color in col_colors.items():
55:        out[:, c] = int(color)
56:    for r, color in row_colors.items():
57:        out[r, :] = int(color)
58:    return out
