132:
133:    lead = 0
134:    extra_steps = np.zeros(n - 1, dtype=int)
135:    if slack > 0:
136:        if n >= 3:
137:            forced_i = int(rng.integers(0, n - 1))
138:            forced = int(rng.integers(1, slack + 1))
139:            extra_steps[forced_i] += forced
140:            slack -= forced
141:        for _ in range(slack):
142:            bucket = int(rng.integers(0, n + 1))
143:            if bucket == 0:
144:                lead += 1
145:            elif bucket < n:
146:                extra_steps[bucket - 1] += 1
