+        if not ok:
+            continue
+
+        marker_rows = [0, 1]
+        random.shuffle(marker_rows)
+        expected_counts = {}
+        for row, color, n_pairs in zip(marker_rows, colors, pair_counts):
+            grid[row, 0] = color
+            expected_counts[color] = 2 * n_pairs
+
+        if _valid_case(grid, expected_counts):
