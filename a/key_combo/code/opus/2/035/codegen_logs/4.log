6:def main(grid: np.ndarray) -> np.ndarray:
7:    """
8:    Crop each foreground sprite to its bounding box and pack the crops tightly along the sprites' layout axis.
9:
10:    Input structure:
11:    - The input is a background grid containing multiple separated, monochrome, 8-connected sprites.
12:    - The sprites all have the same bounding-box shape.
13:    - The sprite centers are spread more in either rows or columns, defining a vertical or horizontal layout.
14:
15:    Rule:
16:    - Extract each sprite's bbox crop.
17:    - If the sprite centers span more columns than rows, order sprites left-to-right and concatenate the crops horizontally.
18:    - Otherwise, order sprites top-to-bottom and concatenate the crops vertically.
19:
20:    Key insight:
21:    - The output is not a recoloring; it is the same sprites with all empty space between their bboxes removed.
22:    """
23:    g = np.asarray(grid, dtype=int)
24:    bg = get_bg(g)
25:
26:    sprites = find_components(
27:        g,
28:        bg=bg,
29:        connectivity=8,
30:        monochromatic=True,
31:        return_format="dict",
32:    )
33:    assert len(sprites) >= 2
34:
35:    items = []
36:    shapes = set()
37:    centers = []
38:    for sprite in sprites:
39:        bbox = tuple(map(int, sprite["bbox"]))
40:        crop = crop_bbox(g, bbox)
41:        fg = crop[crop != bg]
42:        assert fg.size == int(sprite["area"])
43:        assert len(set(map(int, fg))) == 1
44:
45:        r0, c0, r1, c1 = bbox
46:        items.append((bbox, crop))
47:        shapes.add(tuple(crop.shape))
48:        centers.append(((r0 + r1) / 2, (c0 + c1) / 2))
49:
50:    assert len(shapes) == 1
51:    sprite_h, sprite_w = next(iter(shapes))
52:
53:    row_span = max(r for r, _ in centers) - min(r for r, _ in centers)
54:    col_span = max(c for _, c in centers) - min(c for _, c in centers)
55:    assert row_span != col_span
56:
57:    if col_span > row_span:
58:        starts = [bbox[1] for bbox, _ in items]
59:        assert len(set(starts)) == len(starts)
60:        ordered = sorted(items, key=lambda item: item[0][1])
61:
62:        out = np.full((sprite_h, sprite_w * len(ordered)), bg, dtype=int)
63:        for i, (_, crop) in enumerate(ordered):
64:            paste(out, crop, 0, i * sprite_w)
65:    else:
66:        starts = [bbox[0] for bbox, _ in items]
67:        assert len(set(starts)) == len(starts)
68:        ordered = sorted(items, key=lambda item: item[0][0])
69:
70:        out = np.full((sprite_h * len(ordered), sprite_w), bg, dtype=int)
71:        for i, (_, crop) in enumerate(ordered):
72:            paste(out, crop, i * sprite_h, 0)
73:
74:    return out
