+        r0 = random.randint(0, h - sh)
+        c0 = random.randint(0, left_max)
+        left = _translate(shape, r0, c0)
+        right = set(_mirror_coords(left, w))
+
+        extras = set()
+        for rr, cc in right:
+            for nr, nc in _neighbors4(rr, cc):
+                if 0 <= nr < h and 0 <= nc < w and nc >= half + 1 and (nr, nc) not in right:
