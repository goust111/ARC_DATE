+            work_items.append(("noise", color))
+        random.shuffle(work_items)
+
+        ok = True
+        for kind, color in work_items:
+            placed = _try_place_true_pair(scene, color) if kind == "pair" else _try_place_near_miss(scene, color)
+            if not placed:
+                ok = False
+                break
+        if not ok:
+            continue
+
+        marker_rows = [0, 1]
+        random.shuffle(marker_rows)
+        expected_counts = {}
