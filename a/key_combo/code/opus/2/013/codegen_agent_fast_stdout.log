        direction = (0, -1)
    elif move_side == "up":
        sr = int(RNG.integers(0, top))
        sc = int(RNG.integers(left + 1, left + size - 1))
        direction = (1, 0)
    else:
        sr = int(RNG.integers(top + size, h))
        sc = int(RNG.integers(left + 1, left + size - 1))
