from collections import deque

RNG = np.random.default_rng(404)


def main(grid: np.ndarray) -> np.ndarray:
    """Task 4: flood along maze corridor with palette-driven cycle.

Input:
    Black corridors, cyan walls(8), palette row at bottom, and one seed(9).
Output:
    Corridor recolored by BFS distance, indexed by palette colors.

Reasoning:
    Read palette sequence P from bottom row.
    BFS from seed through non-wall cells and recolor each reachable cell with P[dist mod k].

Complexity:
    O(H*W).
    """

    g = np.array(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    palette_row = g[h - 1]
    nz = np.where(palette_row != 0)[0]
    if len(nz) == 0:
        return out
    k = int(np.max(np.diff(nz)) if len(nz) > 1 else 1)
    start = int(nz[0])
    end = int(nz[-1])
    if start > end:
        start, end = end, start
    seq = list(palette_row[start : end + 1])
    k = len(seq)
    if k == 0:
        return out

    seeds = list(zip(*np.where(g == 9)))
    if not seeds:
        return out
    sr, sc = seeds[0]

    dist = -np.ones((h, w), dtype=int)
    q = deque()
    dist[sr, sc] = 0
    q.append((sr, sc))
    allowed = (g != 8) & (np.arange(h)[:, None] < h - 1)

    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and dist[nr, nc] == -1 and allowed[nr, nc]:
                dist[nr, nc] = dist[r, c] + 1
                q.append((nr, nc))

    for r in range(h):
        for c in range(w):
            if dist[r, c] >= 0:
                out[r, c] = seq[dist[r, c] % k]

    return out


def _connected_zero(g):
    h, w = g.shape
    wall = g == 8
    cells = [(r, c) for r in range(h - 2) for c in range(w) if not wall[r, c]]
    if not cells:
        return False
    vis = np.zeros((h, w), dtype=bool)
    q = [cells[0]]
    vis[cells[0][0], cells[0][1]] = True
    while q:
        r, c = q.pop()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h - 1 and 0 <= nc < w and not wall[nr, nc] and not vis[nr, nc]:
                vis[nr, nc] = True
                q.append((nr, nc))
    return vis.sum() == len(cells)


