            [5, 0, 5, 5],
            [0, 5, 5, 0],
        ],
        dtype=int,
    ),
}


def _components(mask):
    h, w = mask.shape
    vis = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or vis[r, c]:
                continue
            stack = [(r, c)]
            vis[r, c] = True
            cells = []
            while stack:
                x, y = stack.pop()
                cells.append((x, y))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not vis[nr, nc]:
                        vis[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(cells, dtype=int))
    return comps


def main(grid: np.ndarray) -> np.ndarray:
    """Task 5: diagonal-marked rectangles stamped with upscaled sprite stencil.

Input:
    A gray sprite near top-left and 2-3 same-color marker pairs.
Output:
    Rectangles delimited by each marker pair filled by stencil stamping of upscaled sprite.

Reasoning:
    Locate sprite from gray component, infer each rectangle from marker pair and scale,
    enlarge sprite by factor m and stamp only at gray-template blocks.

Complexity:
    O(H*W + number_of_markers*sprite_size^2).
    """

    g = np.array(grid, dtype=int)
    out = g.copy()

    # detect top-left sprite
    comps = _components(g == 5)
    if not comps:
        return out
    comps_sorted = sorted(comps, key=lambda c: (c[:, 0].min(), c[:, 1].min()))
    sprite_comp = comps_sorted[0]
    r0, r1 = int(sprite_comp[:, 0].min()), int(sprite_comp[:, 0].max())
    c0, c1 = int(sprite_comp[:, 1].min()), int(sprite_comp[:, 1].max())
    sprite_h = r1 - r0 + 1
    sprite_w = c1 - c0 + 1

    sprite = (g[r0 : r1 + 1, c0 : c1 + 1] == 5).astype(int)

    h, w = g.shape
    colors = [v for v in np.unique(g) if v not in (0, 5)]
    for col in colors:
        positions = list(zip(*np.where(g == col)))
        if len(positions) != 2:
            continue
        (r_a, c_a), (r_b, c_b) = positions
        top = min(r_a, r_b)
        bottom = max(r_a, r_b)
        left = min(c_a, c_b)
        right = max(c_a, c_b)

        rect_h = bottom - top + 1
        rect_w = right - left + 1
        if rect_h % sprite_h != 0 or rect_w % sprite_w != 0:
            continue
        m = rect_h // sprite_h
        if m <= 0 or rect_w // sprite_w != m:
            continue

        for sr in range(sprite_h):
            for sc in range(sprite_w):
                if sprite[sr, sc] == 0:
                    continue
                br = top + sr * m
                bc = left + sc * m
                for dr in range(m):
                    for dc in range(m):
                        rr = br + dr
                        cc = bc + dc
                        if not (top <= rr <= bottom and left <= cc <= right):
                            continue
                        for pr in range(sprite_h):
                            for pc in range(sprite_w):
                                rr2 = rr + pr - sr * m
                                cc2 = cc + pc - sc * m
                                if 0 <= rr2 < h and 0 <= cc2 < w and 0 <= rr < h and 0 <= cc < w:
                                    out[rr2, cc2] = 5

    return out


def generate_input() -> np.ndarray:
    h = 20
    w = 20
    g = np.zeros((h, w), dtype=int)

    sw = int(RNG.choice([3, 4]))
    sprite = SPRITE_TEMPLATES[sw]
    sh = sw

    # place sprite near top-left
    g[:sh, :sw] = sprite

    n_pairs = int(RNG.integers(2, 4))
    colors = RNG.choice([1, 2, 3], size=n_pairs, replace=False)

    used = {(r, c) for r in range(h) for c in range(w) if g[r, c] != 0}
    for col in colors:
        m = int(RNG.choice([2, 3]))
        rh = sh * m
        rw = sw * m
        placed = False
        for _ in range(500):
            top = int(RNG.integers(3, h - rh))
            left = int(RNG.integers(0, w - rw))
            if left + rw > 20 or top + rh > 20:
                continue
            corners = [(top, left), (top + rh - 1, left + rw - 1)]
            rect_cells = {
                (r, c)
                for r in range(top, top + rh)
                for c in range(left, left + rw)
            }
            if any(p in used for p in corners) or any(p in used for p in rect_cells):
                continue
            # ensure no overlap with other rectangles (markers and sprites)
            g[top, left] = col
            g[top + rh - 1, left + rw - 1] = col
            used.add((top, left))
            used.add((top + rh - 1, left + rw - 1))
            placed = True
            break

        if not placed:
            top = 3
            left = 3 + 2 * len(colors)
            g[top, left] = col
            g[top + sw * m - 1, left + sw * m - 1] = col

    return g
import numpy as np

RNG = np.random.default_rng(707)


def main(grid: np.ndarray) -> np.ndarray:
    """Task 7: slide object to cup, infer active opening, fill and emit rays.

Input:
    Gray U/C-like cup with one opening and one blue object.
Output:
    Moved blue object, one cup cavity recolored by motion distance and rays from active opening.

Reasoning:
    Detect contact direction by nearest wall distance, move object, choose active opening as
    opposite side, recolor inner cavity by distance mapping, then cast opening rays.

Complexity:
    O(H*W*#object_pixels).
    """

    g = np.array(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    wall = g == 5

    # cup bbox and opening side
    wall_cells = list(zip(*np.where(wall)))
    if not wall_cells:
        return out
    rs = [r for r, c in wall_cells]
    cs = [c for r, c in wall_cells]
    top, bottom = min(rs), max(rs)
    left, right = min(cs), max(cs)

    top_count = int(np.sum(wall[top, left:right + 1]))
    bottom_count = int(np.sum(wall[bottom, left:right + 1]))
    left_count = int(np.sum(wall[top:bottom + 1, left]))
    right_count = int(np.sum(wall[top:bottom + 1, right]))
    counts = {
        "up": top_count,
        "down": bottom_count,
        "left": left_count,
        "right": right_count,
    }
    open_side = min(counts, key=counts.get)

    object_cells = [(r, c) for r in range(h) for c in range(w) if g[r, c] == 1]
    if not object_cells:
        return out

    # object movement by minimal distance to wall in each direction
    def wall_dist(dr, dc, cells):
        best = 10 ** 9
        for r, c in cells:
            rr, cc = r + dr, c + dc
            d = 0
            while 0 <= rr < h and 0 <= cc < w and g[rr, cc] != 5:
                rr += dr
                cc += dc
                d += 1
            # stop at wall cell or boundary
            if 0 <= rr < h and 0 <= cc < w and g[rr, cc] == 5:
                best = min(best, d - 1)
        return best

    dirs = [( -1, 0, "up"), (1, 0, "down"), (0, -1, "left"), (0, 1, "right")]
    best_d = 10 ** 9
    best_dir = None
    for dr, dc, name in dirs:
        d = wall_dist(dr, dc, object_cells)
        if d < best_d:
            best_d = d
            best_dir = (dr, dc, name)
    if best_dir is None:
        return out

    dr, dc, move_dir = best_dir
    d = best_d
    if d < 0 or d == 10 ** 9:
        d = 0

    # move object
    for r, c in object_cells:
        out[r, c] = 0
    moved_cells = []
    for r, c in object_cells:
        nr, nc = r + d * dr, c + d * dc
        if 0 <= nr < h and 0 <= nc < w:
            out[nr, nc] = 1
            moved_cells.append((nr, nc))

    opposite = {"up": "down", "down": "up", "left": "right", "right": "left"}
    active_open = opposite[move_dir]

    color_by_d = {1: 2, 2: 3, 3: 4}
    c_fill = color_by_d.get(d, 7)

    # interior box defined by bbox of cup; works for 3-side wall frame
    r1, r2, c1, c2 = top, bottom, left, right
    ir1 = r1 + 1
    ir2 = r2 - 1
    ic1 = c1 + 1
    ic2 = c2 - 1

    if open_side == "up":
        pass
    # fill cavity
    for rr in range(ir1, ir2 + 1):
        for cc in range(ic1, ic2 + 1):
            if out[rr, cc] != 5:
                out[rr, cc] = c_fill

    # emit rays from opening edge outward
    if active_open == "right":
        cols = range(ic1, ic2 + 1)
        for rr in range(ir1, ir2 + 1):
            cc = ic2 + 1
            while 0 <= cc < w and out[rr, cc] != 5:
                if out[rr, cc] == 0 or (rr, cc) not in moved_cells:
                    out[rr, cc] = c_fill
                cc += 1
    elif active_open == "left":
        for rr in range(ir1, ir2 + 1):
            cc = ic1 - 1
            while 0 <= cc < w and out[rr, cc] != 5:
                if out[rr, cc] == 0 or (rr, cc) not in moved_cells:
                    out[rr, cc] = c_fill
                cc -= 1
    elif active_open == "down":
        for cc in range(ic1, ic2 + 1):
            rr = ir2 + 1
            while 0 <= rr < h and out[rr, cc] != 5:
                if out[rr, cc] == 0 or (rr, cc) not in moved_cells:
                    out[rr, cc] = c_fill
                rr += 1
    else:  # up
        for cc in range(ic1, ic2 + 1):
            rr = ir1 - 1
            while 0 <= rr < h and out[rr, cc] != 5:
                if out[rr, cc] == 0 or (rr, cc) not in moved_cells:
                    out[rr, cc] = c_fill
                rr -= 1

    # keep moved object color
    for rr, cc in moved_cells:
        out[rr, cc] = 1

    return out


def _make_cup(grid, top, left, size, open_side):
    h, w = size, size
    bottom = top + h - 1
    right = left + w - 1
    # Left/right walls
    grid[top:bottom + 1, left] = 5
    grid[top:bottom + 1, right] = 5
    # Top/bottom walls
    if open_side != "up":
        grid[top, left:right + 1] = 5
    if open_side != "down":
        grid[bottom, left:right + 1] = 5
    if open_side != "left":
        for r in range(top, bottom + 1):
            grid[r, left] = 5
    if open_side != "right":
        for r in range(top, bottom + 1):
            grid[r, right] = 5


def generate_input() -> np.ndarray:
    h = 14
    w = 14
    g = np.zeros((h, w), dtype=int)

    open_side = str(RNG.choice(["up", "down", "left", "right"]))
    size = 8
    top = 3
    left = 3
    _make_cup(g, top, left, size, open_side)

    # closed sides available for object side
    closed = [s for s in ["up", "down", "left", "right"] if s != open_side]
    move_side = str(RNG.choice(closed))

    if move_side == "left":
        sr = int(RNG.integers(top + 2, top + size - 2))
        sc = int(RNG.integers(1, left - 1))
        dr, dc = (0, 1)
    elif move_side == "right":
        sr = int(RNG.integers(top + 2, top + size - 2))
        sc = int(RNG.integers(left + size + 1, w - 1))
        dr, dc = (0, -1)
    elif move_side == "up":
        sr = int(RNG.integers(1, top - 1))
        sc = int(RNG.integers(left + 2, left + size - 2))
        dr, dc = (1, 0)
    else:
        sr = int(RNG.integers(top + size + 1, h - 2))
        sc = int(RNG.integers(left + 2, left + size - 2))
        dr, dc = (-1, 0)

    obj_size = int(RNG.integers(3, 6))
    cells = [(sr, sc)]
    g[sr, sc] = 1
    while len(cells) < obj_size:
        r, c = cells[int(RNG.integers(len(cells)))]
        nr = r + int(RNG.choice([-1, 0, 1]))
        nc = c + int(RNG.choice([-1, 0, 1]))
        if abs(nr - r) + abs(nc - c) != 1:
            continue
        if 0 <= nr < h and 0 <= nc < w and g[nr, nc] == 0:
            # keep away from cup
            if not (top <= nr <= top + size - 1 and left <= nc <= left + size - 1):
                g[nr, nc] = 1
                cells.append((nr, nc))

    return g
import numpy as np

RNG = np.random.default_rng(808)

def _components(mask):
    h, w = mask.shape
    vis = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or vis[r, c]:
                continue
            stack = [(r, c)]
            vis[r, c] = True
            comp = []
            while stack:
                x, y = stack.pop()
                comp.append((x, y))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not vis[nr, nc]:
                        vis[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(comp)
    return comps


def main(grid: np.ndarray) -> np.ndarray:
    """Task 8: complementary pair rectangles with overlap conflict cross.

Input:
    Two colors, each two fragments with one at left border and one interior.
Output:
    Each pair moved to filled rectangle; overlap gets cross-marked by rectangle centers and winner color.

Reasoning:
    Build both rectangles, fill non-overlap by color, then resolve overlap with center-derived rows/cols.

Complexity:
    O(H*W*N).
    """

    g = np.array(grid, dtype=int)
    out = np.zeros_like(g)
    h, w = g.shape

    rects = {}
    totals = {}

    def rect_from_components(comps, color):
        if len(comps) != 2:
            return None, 0
        s0 = set(map(tuple, comps[0]))
        s1 = set(map(tuple, comps[1]))
        if any(c == 0 for c, _ in s0):
            move_set = s0
            anchor_set = s1
        elif any(c == 0 for c, _ in s1):
            move_set = s1
            anchor_set = s0
        else:
            # fallback by x==0 check on each set
            move_set = s0
            anchor_set = s1

        move_list = list(move_set)
        minr = min(v[0] for v in anchor_set)
        # infer translation by matching two-row filled rectangle constraints
        total_area = len(move_set) + len(anchor_set)

        rects_found = None
        for dr in range(-h, h + 1):
            for dc in range(-w, w + 1):
                moved = {(r + dr, c + dc) for r, c in move_list}
                if any(r < 0 or c < 0 or r >= h or c >= w for r, c in moved):
                    continue
                union = anchor_set | moved
                rs = [p[0] for p in union]
                cs = [p[1] for p in union]
                tr, br = min(rs), max(rs)
                lc, rc = min(cs), max(cs)
                if (br - tr + 1) * (rc - lc + 1) != len(union):
                    continue
                if (br - tr + 1) * (rc - lc + 1) != total_area:
                    continue
                rects_found = (tr, br, lc, rc)
                break
            if rects_found is not None:
                break

        if rects_found is None:
            return None, 0
        return rects_found, total_area

    for color in (2, 3):
        comps = _components(g == color)
        rect, area = rect_from_components(comps, color)
        if rect is None:
            continue
        rects[color] = rect
        totals[color] = area

    if 2 not in rects or 3 not in rects:
        return g.copy()

    red_rect = rects[2]
    green_rect = rects[3]
    r1t, r1b, r1l, r1r = red_rect
    r2t, r2b, r2l, r2r = green_rect

    out[r1t : r1b + 1, r1l : r1r + 1] = 2
    out[r2t : r2b + 1, r2l : r2r + 1] = 3

    top_o = max(r1t, r2t)
    left_o = max(r1l, r2l)
    bottom_o = min(r1b, r2b)
    right_o = min(r1r, r2r)
    if top_o <= bottom_o and left_o <= right_o:
        rc1 = (r1t + r1b) // 2
        cc1 = (r1l + r1r) // 2
        rc2 = (r2t + r2b) // 2
        cc2 = (r2l + r2r) // 2

        winner = 2 if totals[2] > totals[3] else 3
        loser = 3 if winner == 2 else 2
        for rr in range(top_o, bottom_o + 1):
            for cc in range(left_o, right_o + 1):
                if rr == rc1 or cc == cc1 or rr == rc2 or cc == cc2:
                    out[rr, cc] = winner
                else:
                    out[rr, cc] = loser

    return out


def generate_input() -> np.ndarray:
    h = 16
    w = 16
    g = np.zeros((h, w), dtype=int)

    # red rectangle on left edge
    r_h1 = 5
    r_w1 = 6
    t1 = 2
    l1 = 0
    cells1 = [(r, c) for r in range(t1, t1 + r_h1) for c in range(l1, l1 + r_w1)]
    for p in cells1:
        r, c = p
        if c == l1:
            g[r, c] = 2
        else:
            g[r, c] = 2

    # green rectangle with overlap and left touch
    r_h2 = 6
    r_w2 = 5
    t2 = 4
    l2 = 0
    cells2 = [(r, c) for r in range(t2, t2 + r_h2) for c in range(l2, l2 + r_w2)]
    # ensure not complete containment by height/width mismatch and overlap > 0
    for p in cells2:
        g[p] = 3

    # split fragments by moving left column (touching boundary)
    # redraw: convert only left column to moving pieces
    # color already same, generation parser handles by connectivity
    return g
import numpy as np

RNG = np.random.default_rng(1010)


def main(grid: np.ndarray) -> np.ndarray:
    """Task 10: extrapolate frame sequence, compress to nested ring ring order.

Input:
    Multiple equal-width panels separated by gray borders, each with one blue sprite.
Output:
    (2*(N+1)-1)x(2*(N+1)-1) nested square rings; inner rings correspond to later frames.

Reasoning:
    Parse frames, recover sprite shape and vertical positions, extrapolate one step by
    constant drift, then map area sequence order to nested-ring colors by rank.

Complexity:
    O(H*W).
    """

    g = np.array(grid, dtype=int)
    H, W = g.shape

    sep_cols = [c for c in range(W) if np.all(g[:, c] == 5)]
    segs = []
    start = 0
    for c in range(W):
        if c in sep_cols:
            if start <= c - 1:
                segs.append((start, c - 1))
            start = c + 1
    if start < W:
        segs.append((start, W - 1))

    panels = []
    for s, e in segs:
        sub = g[:, s : e + 1]
        pts = [(r, c) for r in range(H) for c in range(sub.shape[1]) if sub[r, c] == 1]
        if not pts:
            continue
        xs = [r for r, c in pts]
        ys = [c for r, c in pts]
        top = min(xs)
        panels.append((s, e, top, pts))

    if not panels:
        return np.zeros((1, 1), dtype=int)

    N = len(panels)
    rows = [p[2] for p in panels]
    if N >= 2:
        dr = rows[1] - rows[0]
    else:
        dr = 0

    # shape relative to first panel
    base_s, base_e, base_top, base_pts = panels[0]
    base_cells = [(r - base_top, c) for r, c in base_pts]
    sprite_coords = [(dr0, dc0) for dr0, dc0 in [(r, c) for r, c in base_cells]]
    sprite_width = base_e - base_s + 1

    areas = []
    for idx, top in enumerate(rows):
        # area as shown in each input panel
        # already clipped already
        cnt = 0
        for rr, cc in panels[idx][3]:
            if 0 <= rr < H and 0 <= cc < W:
                cnt += 1
        areas.append(cnt)

    # extrapolate one more frame
    next_top = rows[-1] + dr
    next_cnt = 0
    for dr0, dc0 in sprite_coords:
        nr = next_top + dr0
        nc = base_pts[0][1] - base_top + 0 + dc0
        if 0 <= nr < H and 0 <= nc < sprite_width:
            next_cnt += 1
    areas.append(next_cnt)

    colors = [2, 3, 4, 6, 7]
    rank = sorted(range(len(areas)), key=lambda i: (-areas[i], i))
    color_of_frame = {idx: colors[k] for k, idx in enumerate(rank)}

    S = 2 * (N + 1) - 1
    out = np.zeros((S, S), dtype=int)

    for layer in range(N + 1):
        c = color_of_frame[layer]
        for x in range(layer, S - layer):
            out[layer, x] = c
            out[S - layer - 1, x] = c
            out[x, layer] = c
            out[x, S - layer - 1] = c

    return out


def generate_input() -> np.ndarray:
    H = 12
    panel_count = int(RNG.choice([3, 4]))
    panel_w = 4
    gap = 1
    base_w = panel_count * panel_w + (panel_count - 1) * gap

    W = 20
    g = np.zeros((H, W), dtype=int)
    starts = []
    for i in range(panel_count):
        s = i * (panel_w + gap)
        e = s + panel_w - 1
        starts.append(s)
        if i > 0:
            sep = s - 1
            g[:, sep] = 5
        # draw sprite in panel i
        if i == 0:
            base_shape = set()
            r0 = int(RNG.integers(1, H - 5))
            c0 = s
            pts = [(0, 0), (1, 0), (1, 1)]
            n = int(RNG.integers(3, 6))
            while len(base_shape) < n:
                if len(base_shape) == 0:
                    base_shape.add((0, 1))
                else:
                    rr, cc = tuple(RNG.choice(list(base_shape)))
                    nr, nc = rr + int(RNG.choice([-1, 0, 1])), cc + int(RNG.choice([-1, 0, 1]))
                    if abs(nr - rr) + abs(nc - cc) != 1:
                        continue
                    if 0 <= nc < panel_w and 0 <= nr < H:
                        base_shape.add((nr, nc))
            base_shape = list(base_shape)[:n]
            for rr, cc in base_shape:
                g[r0 + rr, s + cc] = 1
            base_top = r0

    # assign drifting top row per panel
    dr = int(RNG.choice([-2, -1, 1, 2]))
    if panel_count >= 2:
        # rewrite with exact drift
        for i, s in enumerate(starts):
            # clear old row in panel
            g[:, s : s + panel_w] = 0
            if i == 0:
                # keep base
                for rr, cc in base_shape:
                    rr0 = base_top + i * dr
                    if 0 <= rr0 + rr < H:
                        g[rr0 + rr, s + cc] = 1
            else:
                row = base_top + i * dr
                for rr, cc in base_shape:
                    nr = row + rr
                    nc = cc
                    if 0 <= nr < H and 0 <= nc < panel_w:
                        g[nr, s + nc] = 1

    return g

