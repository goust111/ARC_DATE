        left, right = min(cs), max(cs)
        rings.append((top, bottom, left, right))

    if not rings:
        return out

    rings = sorted(rings, key=lambda x: (x[1] - x[0] + 1) * (x[3] - x[2] + 1), reverse=True)
    n = len(rings)

