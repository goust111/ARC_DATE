import numpy as np
from collections import deque

RNG = np.random.default_rng(404)


def main(grid: np.ndarray) -> np.ndarray:
    """Task 4: flood fill maze corridor using palette cycle.

Input:
    A maze in black with cyan walls, palette row on last row and seed 9.
Output:
    Reachable corridor recolored by palette sequence indexed by BFS distance.

Reasoning:
    Read contiguous palette segment from bottom row.
    BFS from seed over cells != wall and recolor with P[dist mod k].

Complexity:
    O(H*W).
    """

    g = np.array(grid, dtype=int)
    h, w = g.shape
    out = g.copy()

    bottom = g[h - 1]
    nz = np.where(bottom != 0)[0]
    if nz.size == 0:
        return out
    start, end = int(nz.min()), int(nz.max())
    seq = [int(v) for v in bottom[start : end + 1] if v != 0]
    if not seq:
        return out
    k = len(seq)

    seeds = list(zip(*np.where(g == 9)))
    if not seeds:
        return out
    sr, sc = seeds[0]

    allowed = (g != 8)
    dist = -np.ones((h, w), dtype=int)
    q = deque([(sr, sc)])
    dist[sr, sc] = 0

    while q:
        r, c = q.popleft()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h - 1 and 0 <= nc < w and allowed[nr, nc] and dist[nr, nc] == -1:
                dist[nr, nc] = dist[r, c] + 1
                q.append((nr, nc))

    for r in range(h):
        for c in range(w):
            if dist[r, c] >= 0:
                out[r, c] = seq[dist[r, c] % k]

    return out


def _is_connected_maze(g: np.ndarray) -> bool:
    h, w = g.shape
    cells = [(r, c) for r in range(h - 2) for c in range(w) if g[r, c] != 8 and g[r, c] != 9]
    if not cells:
        return False
    vis = np.zeros((h, w), dtype=bool)
    st = [cells[0]]
    vis[st[0][0], st[0][1]] = True
    while st:
        r, c = st.pop()
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if 0 <= nr < h - 1 and 0 <= nc < w and not vis[nr, nc] and g[nr, nc] != 8:
                vis[nr, nc] = True
                st.append((nr, nc))
    return vis.sum() == len(cells)


def generate_input() -> np.ndarray:
    h, w = 15, 15

    for _ in range(1000):
        g = np.zeros((h, w), dtype=int)

        # thin internal walls (safe vertical and horizontal blocks)
        for _ in range(3):
            col = int(RNG.integers(1, w - 1))
            gap = int(RNG.integers(1, h - 3))
            for rr in range(h - 3):
                if rr != gap:
                    g[rr, col] = 8

        for _ in range(2):
            row = int(RNG.integers(1, h - 4))
            gap = int(RNG.integers(0, w))
            for cc in range(w):
                if cc != gap:
                    g[row, cc] = 8

        g[h - 2, :] = 8  # separator wall row

        k = int(RNG.integers(3, 5))
        start = 0
        if k <= 3:
            seq = RNG.choice([2, 3, 4], size=k, replace=False)
        else:
            seq = RNG.choice([2, 3, 4], size=k, replace=True)
        g[h - 1, start : start + k] = seq

        zero = [(r, c) for r in range(h - 2) for c in range(w) if g[r, c] == 0]
        if not zero:
            continue
        r0, c0 = zero[int(RNG.integers(len(zero)))]
        g[r0, c0] = 9

        if _is_connected_maze(g):
            return g

    # fallback connected layout
    g = np.zeros((h, w), dtype=int)
    for r in range(h - 3):
        g[r, 7] = 8
    g[h - 2, :] = 8
    g[h - 1, 0:3] = [2, 3, 4]
    g[0, 0] = 9
    return g
import numpy as np

RNG = np.random.default_rng(808)


def _components(mask: np.ndarray):
    h, w = mask.shape
    vis = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or vis[r, c]:
                continue
            st = [(r, c)]
            vis[r, c] = True
            comp = []
            while st:
                x, y = st.pop()
                comp.append((x, y))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = x + dr, y + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not vis[nr, nc]:
                        vis[nr, nc] = True
                        st.append((nr, nc))
            comps.append(comp)
    return comps


def _rect_for_color(g: np.ndarray, color: int):
    comps = _components(g == color)
    if len(comps) != 2:
        return None, 0

    s0 = set(map(tuple, comps[0]))
    s1 = set(map(tuple, comps[1]))
    if any(c == 0 for c, _ in s0):
        move_set, anchor_set = s0, s1
    elif any(c == 0 for c, _ in s1):
        move_set, anchor_set = s1, s0
    else:
        # fallback: piece touching left boundary is moving
        p0 = any(c == 0 for c, _ in s0)
        if p0:
            move_set, anchor_set = s0, s1
        elif any(c == 0 for c, _ in s1):
            move_set, anchor_set = s1, s0
        else:
            return None, 0

    h, w = g.shape
    total = len(move_set) + len(anchor_set)
    found = None

    move_list = list(move_set)
    for dr in range(-h, h + 1):
        for dc in range(-w, w + 1):
            moved = {(r + dr, c + dc) for r, c in move_list}
            if any(r < 0 or c < 0 or r >= h or c >= w for r, c in moved):
                continue
            union = anchor_set | moved
            rs = [p[0] for p in union]
            cs = [p[1] for p in union]
            tr, br = min(rs), max(rs)
            lc, rc = min(cs), max(cs)
            if (br - tr + 1) * (rc - lc + 1) != len(union):
                continue
            if (br - tr + 1) * (rc - lc + 1) != total:
                continue
            found = (tr, br, lc, rc)
            break
        if found is not None:
            break

    return found, total


def main(grid: np.ndarray) -> np.ndarray:
    """Task 8: overlap-aware complementary rectangles with cross conflict.

Input:
    Two colors each with two fragments, one touching left edge.
Output:
    Two filled rectangles by area; overlap cells resolved by center-cross pattern.

Reasoning:
    Recover each rectangle from moving+anchor pair, fill independently,
    then resolve overlap by lines through each rectangle center.

Complexity:
    O(H*W).
    """

    g = np.array(grid, dtype=int)
    h, w = g.shape
    out = np.zeros((h, w), dtype=int)

    rects = {}
    sizes = {}
    for color in (2, 3):
        rect, area = _rect_for_color(g, color)
        if rect is None:
            return g.copy()
        rects[color] = rect
        sizes[color] = area

    r1t, r1b, r1l, r1r = rects[2]
    r2t, r2b, r2l, r2r = rects[3]

    out[r1t : r1b + 1, r1l : r1r + 1] = 2
    out[r2t : r2b + 1, r2l : r2r + 1] = 3

    top = max(r1t, r2t)
    left = max(r1l, r2l)
    bottom = min(r1b, r2b)
    right = min(r1r, r2r)

    if top <= bottom and left <= right:
        c1r, c1c = (r1t + r1b) // 2, (r1l + r1r) // 2
        c2r, c2c = (r2t + r2b) // 2, (r2l + r2r) // 2
        winner = 2 if sizes[2] >= sizes[3] else 3
        loser = 3 if winner == 2 else 2

        for rr in range(top, bottom + 1):
            for cc in range(left, right + 1):
                if rr == c1r or cc == c1c or rr == c2r or cc == c2c:
                    out[rr, cc] = winner
                else:
                    out[rr, cc] = loser

    return out


def generate_input() -> np.ndarray:
    h = 16
    w = 16
    g = np.zeros((h, w), dtype=int)

    # final rectangles will always be completed by moving col0 piece with +1 shift
    red_h = 5
    red_w = 6
    green_h = 4
    green_w = 5

    red_top = 2
    green_top = 5

    # moving fragments touching global left
    for rr in range(red_top, red_top + red_h):
        g[rr, 0] = 2
    for rr in range(green_top, green_top + green_h):
        g[rr, 0] = 3

    # anchors are one column shifted right
    for rr in range(red_top, red_top + red_h):
        for cc in range(2, red_w + 1):
            g[rr, cc] = 2
    for rr in range(green_top, green_top + green_h):
        for cc in range(2, green_w + 1):
            g[rr, cc] = 3

    return g

