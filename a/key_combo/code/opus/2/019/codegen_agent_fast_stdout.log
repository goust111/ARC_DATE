    g = np.zeros((H + 4, W + 4), dtype=int)
    used = np.zeros((H + 4, W + 4), dtype=bool)
    for i, comp in enumerate(comps):
        rr = [p[0] for p in comp]
        cc = [p[1] for p in comp]
        rmin, rmax = min(rr), max(rr)
        cmin, cmax = min(cc), max(cc)
        h, w = rmax - rmin + 1, cmax - cmin + 1

        tries = 0
        placed = False
        while tries < 100:
            R = rs.randint(0, H)
            C = rs.randint(0, W)
            if R + h >= H + 4 - 2 or C + w >= W + 4 - 2:
                tries += 1
                continue
            if np.any(used[R:R + h, C:C + w]):
                tries += 1
                continue
            for r, c in comp:
                tr, tc = R + (r - rmin), C + (c - cmin)
                g[tr, tc] = base[r, c]
                used[tr, tc] = True
            placed = True
            break
        if not placed:
            return np.zeros((H + 4, W + 4), dtype=int)

    return g
