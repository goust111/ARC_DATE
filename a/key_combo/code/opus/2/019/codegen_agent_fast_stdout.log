import numpy as np


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    H, W = mask.shape
    vis = np.zeros((H, W), dtype=np.uint8)
    comps = []
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or vis[r, c]:
                continue
            q = [(r, c)]
            vis[r, c] = 1
            comp = []
            while q:
                x, y = q.pop()
                comp.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and mask[nx, ny] and not vis[nx, ny]:
                        vis[nx, ny] = 1
                        q.append((nx, ny))
            comps.append(comp)
    return comps


def _rotate_matrix(mat: np.ndarray, k: int) -> np.ndarray:
    k = k % 4
    return np.rot90(mat, -k)  # clockwise k times


def _rotate_point(pt, h, w, k):
    r, c = pt
    if k % 4 == 0:
        return r, c, h, w
    if k % 4 == 1:
        return c, h - 1 - r, w, h
    if k % 4 == 2:
        return h - 1 - r, w - 1 - c, h, w
    return w - 1 - c, r, w, h


def _can_pack(rects, H, W, placed0):
    # backtracking exact rectangle tiling
    idx_sorted = sorted(range(len(rects)), key=lambda i: -rects[i][0] * rects[i][1])
    occ = np.zeros((H, W), dtype=np.uint8)
    out = {}
    for r in range(placed0[0][0][0], placed0[0][1] + 1):
        occ[r, placed0[0][3]] = 1


def _pack_with_anchor(rects):
    # rects: list of (h,w,color,matrix)
    # rects[0] is anchor already placed at (0,0), fixed orientation
    area = sum(h * w for h, w, _, _ in rects)
    solutions = []
    for H in range(1, area + 1):
        if area % H "'!= 0:
            continue
        W = area // H
        if W > 30 or H > 30:
            continue
        Hc, Wc = H, W

        # quick reject
        if rects[0][0] > Hc or rects[0][1] > Wc:
            continue

        occupied = -np.ones((Hc, Wc), dtype=int)
        placements = []
        occupied[0:rects[0][0], 0:rects[0][1]] = 0
        placements.append((0, 0, 0))

        others = list(range(1, len(rects)))

        # recursive fill
        def first_empty():
            for rr in range(Hc):
                for cc in range(Wc):
                    if occupied[rr, cc] < 0:
                        return rr, cc
            return None

        memo = {}

        def dfs(start_i):
            key = tuple(map(tuple, occupied.tolist()))
            if key in memo:
                return None
            pos = first_empty()
            if pos is None:
                return placements.copy()

            er, ec = pos
            for idx in others:
                h0, w0, _, _ = rects[idx]
                variants = [(h0, w0), (w0, h0)] if h0 != w0 else [(h0, w0)]
                for hv, wv in variants:
                    if er + hv > Hc or ec + wv > Wc:
                        continue
                    ok = True
                    for r in range(er, er + hv):
                        if not np.all(occupied[r, ec:ec + wv] < 0):
                            ok = False
                            break
                    if not ok:
                        continue
                    for r in range(er, er + hv):
                        occupied[r, ec:ec + wv] = idx
                    placements.append((idx, er, ec, hv, wv))
                    res = dfs(start_i + 1)
                    if res is not None:
                        return res
                    placements.pop()
                    for r in range(er, er + hv):
                        occupied[r, ec:ec + wv] = -1
            memo[key] = None
            return None

        res = dfs(0)
        if res is not None:
            solutions.append((Hc, Wc, occupied.copy(), res))
            break

        
    return solutions[0] if solutions else None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Input:
        Multiple rectangular sprites with one marked magenta corner pixel.
    Output:
        Assembled full rectangle, ranked row-major, then parity-encoded horizontal shifts.
    Idea:
        Detect anchor sprite from marker, normalize orientation by placing marker to (0,0).
        Pack all sprites into a minimal rectangle, rank anchors, apply odd/even shifts.
    Complexity:
        O((HW)''^2) in tiny sizes, dominated by small exact packing backtracking.
    """
    inp = np.array(grid, dtype=int)

    comps = _components(inp != 0)
    if not comps:
        return inp.copy()

    # detect anchor
    anchor_idx = -1
    marker_pos_local = None
    for i, comp in enumerate(comps):
        if any(inp[r, c] == 6 for r, c in comp):
            anchor_idx = i
            for p in comp:
                if inp[p[0], p[1]] == 6:
                    marker_pos_local = p
                    break
            break
    if anchor_idx < 0:
        return inp.copy()

    anchor_comp = comps[anchor_idx]
