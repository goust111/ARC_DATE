                x, y = q.pop()
                comp.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and mask[nx, ny] and not visited[nx, ny]:
                        visited[nx, ny] = 1
                        q.append((nx, ny))
            comps.append(comp)
    return comps


def _tile_maskable(cells: list[tuple[int, int]]) -> bool:
    if not cells:
        return False
    tiles = _tile_component(cells)
    return tiles is not None


def _tile_component(cells: list[tuple[int, int]]) -> list[tuple[list[tuple[int, int]], int]] | None:
    if not cells:
        return []
    rs = [r for r, _ in cells]
    cs = [c for _, c in cells]
    r0, c0 = min(rs), min(cs)
    r1, c1 = max(rs), max(cs)
    h, w = r1 - r0 + 1, c1 - c0 + 1

    idx = {}
    id_to_rc = {}
    for i, (r, c) in enumerate(cells):
        k = (r - r0) * w + (c - c0)
        idx[(r - r0, c - c0)] = i
        id_to_rc[i] = (r, c)

    mask = np.zeros(h * w, dtype=np.uint8)
    for _, _ in cells:
        pass
    cell_ok = np.zeros((h, w), dtype=np.uint8)
    for (r, c) in cells:
        cell_ok[r - r0, c - c0] = 1

    total = len(cells)
    full_bits = (1 << total) - 1
    base_to_local = {}
    for i, (r, c) in enumerate(cells):
        base_to_local[(r - r0, c - c0)] = i

    cand_by_index = [[] for _ in range(total)]

    # 2x2 squares
    for r in range(h - 1):
        for c in range(w - 1):
            pts = [(r, c), (r + 1, c), (r, c + 1), (r + 1, c + 1)]
            if all(cell_ok[rr, cc] for rr, cc in pts):
                bits = 0
                for rr, cc in pts:
                    bits |= 1 << base_to_local[(rr, cc)]
                for rr, cc in pts:
                    cand_by_index[base_to_local[(rr, cc)]].append((bits, 8, 4))

    # 1x3 and 3x1 bars
    for r in range(h):
        for c in range(w - 2):
            pts = [(r, c), (r, c + 1), (r, c + 2)]
            if all(cell_ok[rr, cc] for rr, cc in pts):
                bits = 0
                for rr, cc in pts:
                    bits |= 1 << base_to_local[(rr, cc)]
                for rr, cc in pts:
                    cand_by_index[base_to_local[(rr, cc)]].append((bits, 2, 3))
    for r in range(h - 2):
        for c in range(w):
            pts = [(r, c), (r + 1, c), (r + 2, c)]
            if all(cell_ok[rr, cc] for rr, cc in pts):
                bits = 0
                for rr, cc in pts:
                    bits |= 1 << base_to_local[(rr, cc)]
                for rr, cc in pts:
                    cand_by_index[base_to_local[(rr, cc)]].append((bits, 2, 3))

    memo = {full_bits: []}

    def dfs(used: int):
        if used in memo:
            return memo[used]
        rem = full_bits & ~used
        if rem == 0:
            return []
        i = (rem & -rem).bit_length() - 1
        for bits, color, _ in cand_by_index[i]:
            if bits & used:
                continue
            nxt = used | bits
            if nxt == used:
                continue
            rest = dfs(nxt)
            if rest is not None:
                return [(bits, color)] + rest
        memo[used] = None
        return None

    sol = dfs(0)
    if sol is None:
        return None
    out = []
    for bits, color in sol:
        pix = []
        b = bits
        while b:
            lb = b & -b
            idx_bit = lb.bit_length() - 1
            pix.append(id_to_rc[idx_bit])
            b "'^= lb
        out.append((pix, color))
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Input:
        Arbitrary 2D int grid with background 0 and several gray(5) convex-ear shapes.
    Output:
        Same-size grid after mirror-decompose-recolor operation.
    Procedure:
        Mirror each shape across side opposite its protruding ear, remove ear pixels,
        decompose mirrored targets into 2x2 squares / 1x3 bars, paint by rules.
    Complexity:
        O(k * s * p) where k components, s per-cell candidates, p recursion states.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    out = np.zeros((H, W), dtype=int)

    comps = _extract_components(g != 0)
    for comp in comps:
        colors = {g[r, c] for r, c in comp}
        gray = [(r, c) for r, c in comp if g[r, c] == 5]
        if not gray:
            continue

        ear_candidates = [(r, c) for r, c in comp if g[r, c] != 5]
        if not ear_candidates:
            continue
        ear_r, ear_c = ear_candidates[0]

        gr = [r for r, _ in gray]
        gc = [c for _, c in gray]
        rmin, rmax = min(gr), max(gr)
        cmin, cmax = min(gc), max(gc)

        if ear_c < cmin:
            side = '"'L'
        elif ear_c > cmax:
            side = 'R'
        elif ear_r < rmin:
            side = 'U'
        else:
            side = 'D'

        def mirror(pos):
            r, c = pos
            if side == 'L':
                return r, 2 * cmax - c + 1
            if side == 'R':
                return r, 2 * cmin - c - 1
            if side == 'U':
                return 2 * rmax - r + 1, c
            return 2 * rmin - r - 1, c

        target_cells = set(gray)
        for p in gray:
            target_cells.add(mirror(p))

        # decompose by connected parts
        temp = np.zeros((H, W), dtype=np.uint8)
        for r, c in target_cells:
            if 0 <= r < H and 0 <= c < W:
                temp[r, c] = 1

        for piece in _extract_components(temp):
            painting = _tile_component(piece)
            if painting is None:
                continue
            for pos_list, color in painting:
                for pr, pc in pos_list:
                    out[pr, pc] = color

    return out


def _rand_connected_coords(rng: np.random.Generator, h: int, w: int, n: int) -> list[tuple[int, int]]:
    for _ in range(80):
        rs, cs = rng.integers(0, h), rng.integers(0, w)
        comp = {(int(rs), int(cs))}
        front = [(int(rs), int(cs))]
        for _ in range(n - 1):
            x, y = front[rng.integers(0, len(front))]
            neigh = [(x + dx, y + dy) for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1))]
            cand = [(a, b) for a, b in neigh if 0 <= a < h and 0 <= b < w and (a, b) not in comp]
            if not cand:
                break
            a, b = cand[rng.integers(0, len(cand))]
            comp.add((int(a), int(b)))
            front.append((int(a), int(b)))
        if len(comp) == n:
            return sorted(comp)
    return None


def _tileable_cells(cells: list[tuple[int, int]]) -> bool:
    if not cells:
        return False
    temp = np.zeros((10, 10), dtype=np.uint8)
    for r, c in cells:
        temp[r, c] = 1
    rs = [r for r, _ in cells]
    cs = [c for _, c in cells]
    H, W = max(rs) + 1, max(cs) + 1
    part = _extract_components(temp[:H, :W])
    for cc in part:
        if _tile_component(cc) is None:
            return False
    return True


def generate_input() -> np.ndarray:
    \"\"\"
