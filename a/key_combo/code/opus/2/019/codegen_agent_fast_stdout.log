import numpy as np


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    H, W = mask.shape
    vis = np.zeros((H, W), dtype=np.uint8)
    comps = []
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or vis[r, c]:
                continue
            q = [(r, c)]
            vis[r, c] = 1
            comp = []
            while q:
                x, y = q.pop()
                comp.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and mask[nx, ny] and not vis[nx, ny]:
                        vis[nx, ny] = 1
                        q.append((nx, ny))
            comps.append(comp)
    return comps


def _extract_contour(comp: list[tuple[int, int]], grid: np.ndarray) -> list[tuple[int, int]]:
    H, W = grid.shape
    comp_set = set(comp)
    contour = []
    for r, c in comp:
        color = grid[r, c]
        keep = False
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dx, c + dy
            if nr < 0 or nr >= H or nc < 0 or nc >= W:
                keep = True
                break
            if (nr, nc) not in comp_set:
                # if neighbour exists and not same foreground then boundary
                if grid[nr, nc] "'!= color:
                    keep = True
                    break
        if keep:
            contour.append((r, c))
    return contour


def main(grid: np.ndarray) -> np.ndarray:
    """
    Input:
        Foreground components on black background.
    Output:
        Same size, each component replaced by its 4-neighbour contour and shifted down by perimeter.
    Idea:
        Extract contour pixels, compute perimeter P, shift by P rows.
        When overlaps happen, smaller perimeter component is drawn on top.
    Complexity:
        O(HW + S log S), S number of component pixels plus sorting by perimeter.
    """
    inp = np.array(grid, dtype=int)
    H, W = inp.shape
    out = np.zeros((H, W), dtype=int)

    fg = inp != 0
    comps = _components(fg)
    parts = []
    for comp in comps:
        col = inp[comp[0][0], comp[0][1]]
        contour = _extract_contour(comp, inp)
        if not contour:
            continue
        p = len(contour)
        parts.append((p, col, contour))

    # smaller perimeter on top => draw larger first
    parts.sort(key=lambda x: x[0], reverse=True)

    for p, col, contour in parts:
        for r, c in contour:
            nr = r + p
            if 0 <= nr < H:
                out[nr, c] = col

    return out


def _rand_connected(rng: np.random.RandomState, target: int, h: int, w: int) -> list[tuple[int, int]]:
    cells = {(rng.randint(0, h), rng.randint(0, w))}
    frontier = list(cells)
    while len(cells) < target:
        if not frontier:
            return []
        x, y = frontier[rng.randint(0, len(frontier))]
        neigh = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
        cand = [(a, b) for a, b in neigh if 0 <= a < h and 0 <= b < w and (a, b) not in cells]
        if not cand:
            continue
        nx, ny = cand[rng.randint(0, len(cand))]
        cells.add((nx, ny))
        frontier.append((nx, ny))
    return sorted(cells)


def generate_input() -> np.ndarray:
    """
    Random input generator for task 4.
    Returns:
        A 18x18 grid with 3-5 irregular colored components.
    """
    if not hasattr(generate_input, '"'_rng'):
        generate_input._rng = np.random.RandomState(4404)
        generate_input._i = 0
    rs = generate_input._rng
    generate_input._i += 1

    H = W = 18

    for _ in range(80):
        g = np.zeros((H, W), dtype=int)
        used = np.zeros((H, W), dtype=bool)
        n = int(rs.randint(3, 6))
        colors = [1, 2, 3, 4][:n]
        comps_data = []
        success = True
        perims = []

        for i in range(n):
            area = int(rs.randint(6, 21))
            found = False
            for _ in range(200):
                h = int(rs.randint(4, 9))
                w = int(rs.randint(4, 9))
                comp_local = _rand_connected(rs, area, h, w)
                if not comp_local:
                    continue
                rsum, csum = zip(*comp_local)
                rr0, rr1 = min(rsum), max(rsum)
                cc0, cc1 = min(csum), max(csum)
                ph = rr1 - rr0 + 1
                pw = cc1 - cc0 + 1
                if ph < 3 or pw < 3 or ph > H - 3 or pw > W - 3:
                    continue
                # irregularity check
                if len(comp_local) == area:
                    # place at random top-left
                    pr = int(rs.randint(1, H - ph - 1))
                    pc = int(rs.randint(1, W - pw - 1))
                    placed = []
                    overlap = False
                    for r, c in comp_local:
                        rr, cc = pr + (r - rr0), pc + (c - cc0)
                        if used[rr, cc]:
                            overlap = True
                            break
                        placed.append((rr, cc))
                    if overlap:
                        continue
                    # perimeter
                    mask = np.zeros((H, W), dtype=np.uint8)
                    for rr, cc in placed:
                        mask[rr, cc] = 1
                    comps = _components(mask)
                    if not comps:
                        continue
                    comp = comps[0]
                    border = _extract_contour(comp, mask)
                    perim = len(border)
                    if perim in perims:
                        continue
                    color = colors[i]
                    for rr, cc in placed:
                        g[rr, cc] = color
                        used[rr, cc] = True
                    perims.append(perim)
                    comps_data.append((len(placed), perim, color, placed))
                    found = True
                    break
            if not found:
                success = False
                break

        if not success or len(perims) "'!= n:
            continue

        # validate required overflow+overlap after shift by perimeter
        sim = np.zeros((H, W), dtype=int)
        overflow = False
        overlap = False
        for _, p, col, placed in sorted(comps_data, key=lambda x: x[1], reverse=True):
            for rr, cc in placed:
                nr = rr + p
                if nr >= H:
                    overflow = True
                else:
                    if sim[nr, cc] != 0:
                        overlap = True
                    sim[nr, cc] = col
        if overflow and overlap:
            return g

    return np.zeros((H, W), dtype=int)
