import numpy as np


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    H, W = mask.shape
    vis = np.zeros((H, W), dtype=np.uint8)
    out = []
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or vis[r, c]:
                continue
            q = [(r, c)]
            vis[r, c] = 1
            comp = []
            while q:
                x, y = q.pop()
                comp.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and mask[nx, ny] and not vis[nx, ny]:
                        vis[nx, ny] = 1
                        q.append((nx, ny))
            out.append(comp)
    return out


def _contour(comp: list[tuple[int, int]], grid: np.ndarray) -> list[tuple[int, int]]:
    H, W = grid.shape
    s = set(comp)
    out = []
    for r, c in comp:
        color = grid[r, c]
        is_border = False
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if nr < 0 or nr >= H or nc < 0 or nc >= W:
                is_border = True
                break
            if (nr, nc) not in s and grid[nr, nc] "'!= color:
                is_border = True
                break
        if is_border:
            out.append((r, c))
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Input:
        Colored filled components on black background.
    Output:
        4-neighbour contour of each component, shifted downward by contour pixel count.
    Idea:
        For each component, extract contour, compute perimeter P, move contour to row+P.
        Larger perimeters are drawn first; smaller perimeters remain on top.
    Complexity:
        O(HW + S log S) where S is total object pixels.
    """
    inp = np.array(grid, dtype=int)
    H, W = inp.shape
    out = np.zeros((H, W), dtype=int)

    comps = _components(inp != 0)
    items = []
    for comp in comps:
        color = inp[comp[0][0], comp[0][1]]
        border = _contour(comp, inp)
        if border:
            items.append((len(border), color, border))

    # larger first => smaller perim overlays
    items.sort(key=lambda x: x[0], reverse=True)
    for perim, color, border in items:
        for r, c in border:
            nr = r + perim
            if 0 <= nr < H:
                out[nr, c] = color

    return out


def _rand_connected(rng: np.random.RandomState, target: int, h: int, w: int) -> list[tuple[int, int]]:
    comp = {(int(rng.randint(0, h)), int(rng.randint(0, w)))}
    front = list(comp)
    while len(comp) < target:
        if not front:
            return []
        x, y = front[rng.randint(0, len(front))]
        neigh = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
        neigh = [(a, b) for a, b in neigh if 0 <= a < h and 0 <= b < w and (a, b) not in comp]
        if not neigh:
            continue
        a, b = neigh[rng.randint(0, len(neigh))]
        comp.add((int(a), int(b)))
        front.append((int(a), int(b)))
    return list(comp)


def generate_input() -> np.ndarray:
    """
    Random generator for task 4.
    Returns:
        An 18x18 grid with 3-5 connected components.
    """
    if not hasattr(generate_input, '"'_rng'):
        generate_input._rng = np.random.RandomState(4404)
        generate_input._i = 0
    rs = generate_input._rng
    generate_input._i += 1

    H = W = 18
    colors = [1, 2, 3, 4, 5, 6]

    for _ in range(120):
        g = np.zeros((H, W), dtype=int)
        used = np.zeros((H, W), dtype=bool)
        n = int(3 + rs.randint(0, 3))
        comps_info = []
        ok = True
        used_perims = set()

        for i in range(n):
            area = int(rs.randint(6, 18))
            found = False
            for _ in range(250):
                h = int(rs.randint(4, 9))
                w = int(rs.randint(4, 9))
                local = _rand_connected(rs, area, h, w)
                if not local:
                    continue
                rr = [r for r, _ in local]
                cc = [c for _, c in local]
                rr0, rr1 = min(rr), max(rr)
                cc0, cc1 = min(cc), max(cc)
                ph = rr1 - rr0 + 1
                pw = cc1 - cc0 + 1
                if ph > H - 4 or pw > W - 4:
                    continue

                max_pr = H - ph - 2
                max_pc = W - pw - 2
                if max_pr <= 1 or max_pc <= 1:
                    continue
                pr = int(rs.randint(1, max_pr))
                pc = int(rs.randint(1, max_pc))

                placed = []
                clash = False
                for r, c in local:
                    r2, c2 = pr + (r - rr0), pc + (c - cc0)
                    if used[r2, c2]:
                        clash = True
                        break
                    placed.append((r2, c2))
                if clash:
                    continue

                mask = np.zeros((H, W), dtype=np.uint8)
                for r2, c2 in placed:
                    mask[r2, c2] = 1
                border = _contour(_components(mask)[0], mask)
                perim = len(border)
                if perim in used_perims:
                    continue

                color = colors[i % len(colors)]
                for r2, c2 in placed:
                    g[r2, c2] = color
                    used[r2, c2] = True
                used_perims.add(perim)
                comps_info.append((perim, color, placed))
                found = True
                break

            if not found:
                ok = False
                break

        if not ok:
            continue

        # constraints check for self-valid generation
        sim = np.zeros((H, W), dtype=int)
        overflow = False
        overlap = False
        for perim, color, placed in sorted(comps_info, key=lambda x: -x[0]):
            for r2, c2 in placed:
                nr = r2 + perim
                if nr >= H:
                    overflow = True
                    continue
                if sim[nr, c2] "'!= 0:
                    overlap = True
                sim[nr, c2] = color

        if overflow and overlap:
            return g

    return np.zeros((H, W), dtype=int)
