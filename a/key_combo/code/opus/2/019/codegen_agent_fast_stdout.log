import numpy as np


def main(grid: np.ndarray) -> np.ndarray:
    \"\"\"
    Input:
        Vertical bars plus marker pixels on black background.
    Output:
        Bars recolored by cyclic slot shift, then marker-origin rays extend left/right.
    Idea:
        Identify bars by column-aligned height >=3, rotate their colors by slot order,
        then process each marker ray in row-major order with same-color-bar stopping rule.
    Complexity:
        O(HW + M log M + R), with R count of ray steps.
    \"\"\"
    inp = np.array(grid, dtype=int)
    H, W = inp.shape
    out = inp.copy()

    visited = np.zeros((H, W), dtype=np.uint8)
    comps = []
    for r in range(H):
        for c in range(W):
            if inp[r, c] == 0 or visited[r, c]:
                continue
            q = [(r, c)]
            visited[r, c] = 1
            comp = []
            while q:
                x, y = q.pop()
                comp.append((x, y))
                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nx, ny = x + dx, y + dy
                    if 0 <= nx < H and 0 <= ny < W and inp[nx, ny] "'!= 0 and not visited[nx, ny]:
                        visited[nx, ny] = 1
                        q.append((nx, ny))

            # candidate bar: width1 and continuous in column
            cols = [y for _, y in comp]
            rows = [x for x, _ in comp]
            if max(cols) == min(cols) and (max(rows) - min(rows) + 1) == len(comp):
                comps.append((inp[comp[0][0], comp[0][1]], min(cols), min(rows), max(rows), set(comp)))

    comps = sorted(comps, key=lambda x: x[1])
    if len(comps) < 2:
        return inp.copy()

    # cyclic color shift by slot
    for i, (col, _, _, _, _) in enumerate(comps):
        _, cc, _, _, _ = comps[i]
        out[(out[:, cc] != 0), cc] = 0

    new_colors = [comps[(i - 1) % len(comps)][0] for i in range(len(comps))]
    bar_pixels = set()
    for i, (_, c, _, _, cells) in enumerate(comps):
        nc = new_colors[i]
        for r, _ in cells:
            out[r, c] = nc
            bar_pixels.add((r, c))

    markers = [(r, c) for r in range(H) for c in range(W) if inp[r, c] != 0 and not any((r, c) in s for _, _, _, _, s in comps)]
    markers.sort()

    # ray extend with same-color-bar stop
    ordered = []
    for r in range(H):
        for c in range(W):
            if (r, c) in bar_pixels:
                continue
            if inp[r, c] != 0 and not any((r, c) in s for _, _, _, _, s in comps):
                ordered.append((r, c))

    def is_bar(x, y):
        return (x, y) in bar_pixels

    for mr, mc in ordered:
        color = inp[mr, mc]

        # left
        x, y = mr, mc - 1
        while 0 <= y:
            if is_bar(x, y):
                if out[x, y] == color:
                    break
                out[x, y] = color
                y -= 1
                continue
            out[x, y] = color
            y -= 1

        # right
        x, y = mr, mc + 1
        while y < W:
            if is_bar(x, y):
                if out[x, y] == color:
                    break
                out[x, y] = color
                y += 1
                continue
            out[x, y] = color
            y += 1

        out[mr, mc] = inp[mr, mc]

    return out


def generate_input() -> np.ndarray:
    """
    Random input generator for task 6.
    Returns:
        12x12 grid with 4-6 vertical bars and 2-3 markers satisfying post-shift blocking.
    """
    if not hasattr(generate_input, '"'_rng'):
        generate_input._rng = np.random.RandomState(6606)
        generate_input._i = 0
    rs = generate_input._rng
    generate_input._i += 1

    H = W = 12
    palette = [1, 2, 3, 4, 6, 7]

    for _ in range(80):
        g = np.zeros((H, W), dtype=int)
        cols = list(range(1, W - 1))
        rs.shuffle(cols)
        m = int(4 + rs.randint(0, 3))
        cols = sorted(cols[:m])
        base_colors = rs.choice(palette, size=m, replace=False)

        bars = []
        for i, c in enumerate(cols):
            h = int(rs.randint(3, 9))
            top = H - h
            for r in range(top, H):
                g[r, c] = int(base_colors[i])
            bars.append((c, top, h, int(base_colors[i])))

        shifted = [bars[(i - 1) % m][3] for i in range(m)]
        possible = sorted(set(shifted))

        marker_colors = rs.choice(possible, size=int(2 + rs.randint(0, 2)), replace=True)
        # ensure at least one blocker match and markers not on bars
        ok = True
        used = np.zeros((H, W), dtype=bool)

        for i in range(H):
            used[i, :] = np.any([((i >= bars[j][1]) and (i < bars[j][1] + bars[j][2]) for j in range(m)]) if bars else False

        for col in [bc for bc in marker_colors]:
            # pick a row intersecting at least one shifted-matched bar
            ok_row = False
            idxs = [j for j, bar in enumerate(bars) if shifted[j] == col]
            if idxs:
                j = int(idxs[0])
                r = int(rs.randint(bars[j][1], bars[j][1] + bars[j][2]))
                ok_row = True
            else:
                r = int(rs.randint(0, H - 1))

            for _ in range(80):
                c = int(rs.randint(0, W))
                if used[r, c]:
                    continue
                g[r, c] = col
                break
            if not ok_row:
                ok = False

        # simple post condition
        if ok:
            return g

    return np.zeros((H, W), dtype=int)
