import numpy as np


def _orbit_positions(r, c):
    if (r, c) == (2, 2):
        return [(2, 2)]
    return sorted({
        (r, c),
        (c, r),
        (4 - r, 4 - c),
        (4 - c, 4 - r),
        (c, 4 - r),
        (4 - c, r),
        (r, 4 - c),
        (4 - r, c),
    })


def main(grid: np.ndarray) -> np.ndarray:
    """
    Input:
        A grid containing a 5x5 diagonal X with gray(5) mask cells.
    Output:
        A 3x3 folded grid after symmetry completion.
    Idea:
        Recover every masked pixel from its 8-fold orbit inside the X.
        Then fold each position to 3x3 by fixed index mapping.
    Complexity:
        O(25) cell operations, constant-time orbit restoration.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    # locate a 5x5 area with diagonal occupancy
    best = None
    for r in range(max(0, H - 4)):
        for c in range(max(0, W - 4)):
            sub = g[r:r + 5, c:c + 5]
            diag = [(0, 0), (1, 1), (2, 2), (3, 3), (4, 4), (0, 4), (1, 3), (3, 1), (4, 0)]
            vals = [sub[a, b] for a, b in diag]
            score = sum(v != 0 for v in vals)
            if score >= 4:
                best = (r, c)
                break
        if best is not None:
            break

    if best is None:
        # fallback: take top-left 5x5
        best = (0, 0)

    r0, c0 = best
    sub = g[r0:r0 + 5, c0:c0 + 5].copy()
    out = sub.copy()

    # symmetry completion using 8-fold orbits on X positions
    diag_pos = [(0, 0), (1, 1), (2, 2), (3, 3), (4, 4), (0, 4), (1, 3), (3, 1), (4, 0)]
    for rr, cc in diag_pos:
        if out[rr, cc] != 5:
            continue
        orbit = _orbit_positions(rr, cc)
        color = 0
        for ar, ac in orbit:
            v = out[ar, ac]
            if v != 5 and v != 0:
                color = v
                break
        if color == 0:
            # should not happen by construction
            color = 1
        for ar, ac in orbit:
            out[ar, ac] = color

    fold_map = {
        (2, 2): (1, 1),
        (1, 1): (0, 0),
        (0, 0): (0, 1),
        (1, 3): (0, 2),
        (0, 4): (1, 2),
        (3, 1): (2, 0),
        (4, 0): (1, 0),
        (3, 3): (2, 1),
        (4, 4): (2, 2),
    }
    r = np.zeros((3, 3), dtype=int)
    for (sr, sc), (tr, tc) in fold_map.items():
        r[tr, tc] = out[sr, sc]
    return r


def generate_input() -> np.ndarray:
    """
    Random input generator for task 2.
    Returns:
        A 5x5 grid (or region) where X-diagonal colors are partially masked by 5.
    """
    if not hasattr(generate_input, '_rng'):
        generate_input._rng = np.random.RandomState(2302)
        generate_input._i = 0

    rs = generate_input._rng
    generate_input._i += 1

    sub = np.zeros((5, 5), dtype=int)
    colors = [1, 2, 3, 4]
    orbit1 = [(0, 0), (0, 4), (4, 0), (4, 4)]
    orbit2 = [(1, 1), (1, 3), (3, 1), (3, 3)]
    center = (2, 2)

    for cset in [orbit1, orbit2]:
        col = int(colors[rs.randint(0, len(colors))])
        k = int(rs.randint(1, 4))
        masked = int(rs.choice(cset, size=k, replace=False).tolist() if k < len(cset) else cset)
        for p in cset:
            if p in masked:
                sub[p] = 5
            else:
                sub[p] = col

    if rs.random() < 0.5:
        sub[center] = int(colors[rs.randint(0, len(colors))])
    else:
        sub[center] = 5
    sub[center] = int(colors[rs.randint(0, len(colors))])

    return sub

