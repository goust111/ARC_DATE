                elif side == 2:
                    mirror = lambda p: (2 * rmax - p[0] + 1, p[1])
                else:
                    mirror = lambda p: (2 * rmin - p[0] - 1, p[1])

                target = set(raw_set)
                mirrored = {mirror(p) for p in raw_set}
                target.update(mirrored)
                r0 = min([p[0] for p in target])
