+    rects = _recover_rectangles(g)
+    return _tiled_output(g, rects)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
