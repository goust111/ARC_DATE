+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+SHADOW = 2
+RECT_COLORS = (1, 4, 6, 7)
+GRID_MIN = 7
+GRID_MAX = 10
+MAX_GENERATION_ATTEMPTS = 400
