        endpoint_indices.append(i)
        candidate_lists.append(rows)

    valid = []
    for picked in product(*candidate_lists):
        rows = [None] * SRC_COUNT
        for i, row in zip(endpoint_indices, picked):
            rows[i] = row
        row_tuple = tuple(rows)
        if not _gen_sides_cross_ok(sides, row_tuple):
            continue
