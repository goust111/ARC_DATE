+        "ll": np.rot90(ul, 1),
+        "lr": np.rot90(ul, 2),
+    }
+    slices = {
+        "ur": (slice(0, half), slice(half, side)),
+        "ll": (slice(half, side), slice(0, half)),
+        "lr": (slice(half, side), slice(half, side)),
+    }
