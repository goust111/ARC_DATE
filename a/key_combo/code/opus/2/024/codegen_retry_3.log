+        if int(np.count_nonzero(tile == BG)) < 3:
+            continue
+        if int(np.count_nonzero(tile[1:, :] != BG)) < 4:
+            continue
+        if len(set(map(int, tile[tile != BG].tolist()))) < 2:
+            continue
+        if any(np.array_equal(tile, np.rot90(tile, k)) for k in (1, 2, 3)):
+            continue
+        return tile
+    return None
+
+
