+    grid[r0 : r0 + side, c0 : c0 + side] = motif
+    meta = {
+        "tile": tile,
+        "box": (r0, c0, r0 + side - 1, c0 + side - 1),
+        "counts": counts,
+    }
+    return grid, meta
+
+
+def _manual_output(inp: np.ndarray) -> np.ndarray:
+    out = np.array(inp, dtype=int, copy=True)
