+        for idx, src in enumerate(defect_srcs[name]):
+            rr, cc = _source_to_quadrant(src, name, n)
+            if idx == 0:
+                quad[rr, cc] = shared_wrong
+            else:
+                quad[rr, cc] = _different_value(int(quad[rr, cc]))
+
+    motif = np.zeros((2 * n, 2 * n), dtype=int)
+    motif[:n, :n] = actual["ul"]
+    motif[:n, n:] = actual["ur"]
+    motif[n:, :n] = actual["ll"]
+    motif[n:, n:] = actual["lr"]
