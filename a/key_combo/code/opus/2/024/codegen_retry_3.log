+    r0, c0, r1, c1 = box
+    motif = crop_bbox(inp, box)
+    side = int(motif.shape[0])
+    assert side == motif.shape[1] and side % 2 == 0
+    half = side // 2
+    ul = motif[:half, :half]
+    expectations = {
