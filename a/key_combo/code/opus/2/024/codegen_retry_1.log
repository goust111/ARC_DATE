    colors = random.sample(SEGMENT_COLORS, n_segs)
    out = _empty_grid_with_stripe(h, w)

    bars = []
    for length, color in zip(range(1, n_segs + 1), colors):
        r = h - BOTTOM_STRIPE_ROWS - n_segs + length - 1
        out[r, w - length : w] = color
