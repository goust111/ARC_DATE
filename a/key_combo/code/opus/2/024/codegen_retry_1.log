+    return [spec_a, spec_b] if _spec_fits(spec_a, shape) and _spec_fits(spec_b, shape) else None
+
+
+def _random_extra_object(shape: tuple[int, int], color: int) -> ObjSpec | None:
+    H, W = map(int, shape)
+    L = random.randint(2, 4)
+    if random.random() < 0.5:
