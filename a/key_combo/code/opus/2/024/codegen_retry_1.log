) -> list[tuple[int, int, int, int, int]] | None:
    """Create two panels sharing a horizontal border; returns panel records."""
    H, W = grid.shape
    split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)
