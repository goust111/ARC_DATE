def _gen_rect_candidates(foreground: np.ndarray) -> list[tuple[int, int, int, int, int]]:
    candidates: list[tuple[int, int, int, int, int]] = []
    for height in range(GEN_RECT_HEIGHT_MIN, GEN_RECT_HEIGHT_MAX + 1):
