+def _choose_seeds(
+    eligible: list[tuple[int, int]], target_count: int
+) -> list[tuple[int, int]] | None:
+    even = [cell for cell in eligible if (cell[0] + cell[1]) % 2 == 0]
+    odd = [cell for cell in eligible if (cell[0] + cell[1]) % 2 == 1]
+    if not even or not odd:
+        return None
+
+    for _ in range(120):
+        chosen = [random.choice(even), random.choice(odd)]
+        blocked = set()
+        for r, c in chosen:
+            for rr in range(r - 1, r + 2):
+                for cc in range(c - 1, c + 2):
+                    blocked.add((rr, cc))
+
+        pool = eligible[:]
+        random.shuffle(pool)
+        for cell in pool:
+            if cell in chosen or cell in blocked:
+                continue
+            chosen.append(cell)
+            r, c = cell
+            for rr in range(r - 1, r + 2):
+                for cc in range(c - 1, c + 2):
+                    blocked.add((rr, cc))
+            if len(chosen) == target_count:
+                break
+
+        if len(chosen) < target_count:
+            for cell in pool:
+                if cell not in chosen:
+                    chosen.append(cell)
+                if len(chosen) == target_count:
+                    break
