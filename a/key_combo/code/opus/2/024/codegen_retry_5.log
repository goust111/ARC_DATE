+        "frame_color": int(frame_color),
+        "bbox": bbox,
+        "center_r": int(center_r),
+        "center_c": int(center_c),
+        "radius": int(radius),
+        "markers": markers,
+        "seeds": seeds,
+        "residue_to_color": residue_to_color,
+    }
+
