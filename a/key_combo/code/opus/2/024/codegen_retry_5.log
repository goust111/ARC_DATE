+    for _ in range(120):
+        cols = random.sample(v_pool, random.randint(1, 2))
+        rows = random.sample(h_pool, random.randint(1, 2))
+        has_cross = any(
+            abs(row - center_r) + abs(col - center_c) < radius
+            for row in rows
+            for col in cols
+        )
