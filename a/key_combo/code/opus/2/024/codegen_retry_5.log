+def _draw_diamond(grid: np.ndarray, r0: int, c0: int, radius: int) -> None:
+    center_r = int(r0 + radius)
+    center_c = int(c0 + radius)
+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        grid[center_r + dr, center_c - dc] = FRAME_COLOR
