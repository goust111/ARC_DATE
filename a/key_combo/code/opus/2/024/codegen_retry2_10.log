+SHAPE_PROFILES = (
+    ((3, 3), (1, 2), (2, 2)),
+    ((3, 3), (2, 1), (2, 3)),
+    ((3, 3), (3, 1), (2, 2)),
+    ((3, 3), (1, 3), (3, 2)),
+)
+GEN_CALL_COUNT = 0
