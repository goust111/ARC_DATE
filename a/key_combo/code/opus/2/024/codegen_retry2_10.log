+from __future__ import annotations
+
+import random
+import sys
+from pathlib import Path
+
+import numpy as np
+
+_ARC_UTILS_DIR = Path("/home/lixinyu/snap/new/solvers")
+if str(_ARC_UTILS_DIR) not in sys.path:
+    sys.path.append(str(_ARC_UTILS_DIR))
+
+try:
+    from arc_utils import Color, bbox, crop_bbox, find_components, paste
+except Exception:
+    class Color:
+        BLACK = 0
+        GREY = 5
+
+    def bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+        coords = np.argwhere(mask)
+        if coords.size == 0:
+            return None
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        return int(r0), int(c0), int(r1), int(c1)
+
+    def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+        r0, c0, r1, c1 = map(int, box)
+        return np.asarray(grid[r0 : r1 + 1, c0 : c1 + 1], dtype=int).copy()
+
+    def paste(
+        dst: np.ndarray,
+        patch: np.ndarray,
+        r0: int,
+        c0: int,
+        *,
+        transparent: int | None = None,
+        mask: np.ndarray | None = None,
+        overwrite: bool = True,
+        clip: bool = False,
+    ) -> np.ndarray:
+        r0 = int(r0)
+        c0 = int(c0)
+        h, w = map(int, patch.shape)
+        if not clip:
+            assert 0 <= r0 and 0 <= c0 and r0 + h <= dst.shape[0] and c0 + w <= dst.shape[1]
+            rr0, cc0, rr1, cc1 = r0, c0, r0 + h, c0 + w
+            pr0, pc0 = 0, 0
+        else:
+            rr0 = max(0, r0)
+            cc0 = max(0, c0)
+            rr1 = min(dst.shape[0], r0 + h)
+            cc1 = min(dst.shape[1], c0 + w)
+            if rr0 >= rr1 or cc0 >= cc1:
+                return dst
+            pr0 = rr0 - r0
+            pc0 = cc0 - c0
+        pr1 = pr0 + (rr1 - rr0)
+        pc1 = pc0 + (cc1 - cc0)
+        dst_view = dst[rr0:rr1, cc0:cc1]
+        patch_view = patch[pr0:pr1, pc0:pc1]
+        active = np.ones_like(patch_view, dtype=bool)
+        if mask is not None:
+            active &= mask[pr0:pr1, pc0:pc1].astype(bool)
+        if transparent is not None:
+            active &= patch_view != int(transparent)
+            if not overwrite:
+                active &= dst_view == int(transparent)
+        dst_view[active] = patch_view[active]
+        return dst
+
+    def find_components(
+        grid: np.ndarray,
+        *,
+        bg: int | None = None,
+        connectivity: int = 4,
+        monochromatic: bool = True,
+        colors: tuple[int, ...] | list[int] | None = None,
+        min_area: int = 1,
+        return_format: str = "dict",
+    ) -> list[dict]:
+        assert monochromatic
+        g = np.asarray(grid, dtype=int)
+        if bg is None:
+            values, counts = np.unique(g, return_counts=True)
+            bg = int(values[np.argmax(counts)])
+        steps = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+        if int(connectivity) == 8:
+            steps += [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+        if colors is None:
+            colors = [int(v) for v in np.unique(g) if int(v) != int(bg)]
+        out: list[dict] = []
+        for color in colors:
+            seen = np.zeros_like(g, dtype=bool)
+            for r in range(g.shape[0]):
+                for c in range(g.shape[1]):
+                    if seen[r, c] or int(g[r, c]) != int(color):
+                        continue
+                    stack = [(int(r), int(c))]
+                    seen[r, c] = True
+                    coords: list[tuple[int, int]] = []
+                    while stack:
+                        rr, cc = stack.pop()
+                        coords.append((rr, cc))
+                        for dr, dc in steps:
+                            nr = rr + dr
+                            nc = cc + dc
+                            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and not seen[nr, nc] and int(g[nr, nc]) == int(color):
+                                seen[nr, nc] = True
+                                stack.append((nr, nc))
+                    if len(coords) < int(min_area):
+                        continue
+                    arr = np.array(coords, dtype=int)
+                    r0, c0 = arr.min(axis=0)
+                    r1, c1 = arr.max(axis=0)
+                    out.append(
+                        {
+                            "color": int(color),
+                            "coords": arr,
+                            "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                            "area": int(arr.shape[0]),
+                        }
+                    )
+        return out
+
+
+BG = Color.BLACK
+FRAME = Color.GREY
+ICON_SIZE = 5
+NORM_SIZE = 3
+MAX_GENERATION_ATTEMPTS = 400
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+FRAME_SIZE_RANGE = (5, 9)
+OBJECT_COUNT_RANGE = (3, 5)
+FRAME_GAP = 2
+ALLOWED_RAW_SHAPES = (
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
+)
+SHAPE_PROFILES = (
+    ((3, 3), (1, 2), (2, 2)),
+    ((3, 3), (2, 1), (2, 3)),
+    ((3, 3), (3, 1), (2, 2)),
+    ((3, 3), (1, 3), (3, 2)),
+)
+GEN_CALL_COUNT = 0
