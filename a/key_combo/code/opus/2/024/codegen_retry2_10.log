+BG = Color.BLACK
+FRAME = Color.GREY
+ICON_SIZE = 5
+NORM_SIZE = 3
+MAX_GENERATION_ATTEMPTS = 400
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+FRAME_SIZE_RANGE = (5, 9)
+OBJECT_COUNT_RANGE = (3, 5)
+FRAME_GAP = 2
+ALLOWED_RAW_SHAPES = (
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (2, 2),
+    (2, 3),
+    (3, 2),
+    (3, 3),
