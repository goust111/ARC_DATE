+        outer_h, outer_w = outer_size
+        inner_h = outer_h - 2
+        inner_w = outer_w - 2
+        raw_h, raw_w = map(int, raw_patch.shape)
+        can_shift = (inner_h - raw_h) > 0 or (inner_w - raw_w) > 0
+        offset = _sample_offset(
+            inner_h,
+            inner_w,
+            raw_h,
+            raw_w,
+            prefer_off_center=idx == forced_off_center,
