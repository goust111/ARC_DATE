+def _gen_attempt(call_index: int) -> np.ndarray | None:
+    n = random.randint(*OBJECT_COUNT_RANGE)
+    sizes = _sample_outer_sizes(n)
+    canvas_h, canvas_w = _sample_canvas_size(n, sizes)
+    boxes = _place_boxes(canvas_h, canvas_w, sizes)
+    if boxes is None:
