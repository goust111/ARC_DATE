+    shapes = _sample_raw_shapes(n, call_index)
+    used_norms: set[bytes] = set()
+    specs: list[dict] = []
+
+    shiftable = [
+        idx
+        for idx, ((h, w), shape) in enumerate(zip(sizes, shapes))
+        if (h - 2 > shape[0]) or (w - 2 > shape[1])
