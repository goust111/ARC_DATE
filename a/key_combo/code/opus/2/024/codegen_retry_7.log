+
+def _segments(line: np.ndarray) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
+    start: int | None = None
+    for idx, value in enumerate(line.astype(bool).tolist()):
+        if value and start is None:
+            start = idx
+        elif not value and start is not None:
