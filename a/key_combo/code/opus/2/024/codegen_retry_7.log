+    spec_boxes = sorted(spec["bbox"] for spec in real_specs)
+    if detected_boxes != spec_boxes:
+        return False
+
+    for corridor, spec in zip(sorted(detected, key=lambda x: x["bbox"]), sorted(real_specs, key=lambda x: x["bbox"])):
