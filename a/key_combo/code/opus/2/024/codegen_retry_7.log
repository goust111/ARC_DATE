+            return False
+        if spec["marker_bbox"] is not None:
+            interior = _strict_interior(spec["marker_bbox"])
+            if interior is None:
+                return False
+            pr0, pc0, pr1, pc1 = interior
+            if not bool(np.all(grid[pr0 : pr1 + 1, pc0 : pc1 + 1] == BG)):
