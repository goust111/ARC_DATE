+        for c0 in range(w - band_w + 1):
+            band = np.all(support[:, c0 : c0 + band_w], axis=1)
+            for r0, r1 in _segments(band):
+                if c0 > 0 and bool(np.all(support[r0 : r1 + 1, c0 - 1])):
+                    continue
+                if c0 + band_w < w and bool(np.all(support[r0 : r1 + 1, c0 + band_w])):
