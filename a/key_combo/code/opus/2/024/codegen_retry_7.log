+
+
+def _mark_reserved(mask: np.ndarray, box: tuple[int, int, int, int], padding: int = 0) -> None:
+    r0, c0, r1, c1 = _expand(box, padding)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
