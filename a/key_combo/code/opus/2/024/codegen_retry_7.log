+def _expected_from_specs(grid: np.ndarray, corridors: list[dict]) -> np.ndarray:
+    active = [
+        {
+            "bbox": spec["bbox"],
+            "orientation": spec["orientation"],
+            "marker_bbox": spec["marker_bbox"],
+        }
+        for spec in corridors
+        if not spec["distractor"]
+    ]
