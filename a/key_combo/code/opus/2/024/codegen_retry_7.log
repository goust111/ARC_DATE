+
+        if marked:
+            if orientation == "H":
+                mr0 = r0 + 1
+                mr1 = r0 + 3
+                mw = random.randint(4, actual_w - 1)
+                mc0 = random.randint(c0 + 1, c0 + actual_w - mw)
+                mc1 = mc0 + mw - 1
+            else:
+                mc0 = c0 + 1
+                mc1 = c0 + 3
+                mh = random.randint(4, actual_h - 1)
+                mr0 = random.randint(r0 + 1, r0 + actual_h - mh)
+                mr1 = mr0 + mh - 1
