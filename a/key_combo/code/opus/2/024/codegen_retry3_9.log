+                ok = False
+                break
+        if ok:
+            candidates.append((r, c))
+
+    if count == 1:
+        return candidates if candidates else None
+    pairs = [
+        [a, b]
+        for i, a in enumerate(candidates)
+        for b in candidates[i + 1 :]
+        if abs(a[0] - b[0]) + abs(a[1] - b[1]) >= 2
