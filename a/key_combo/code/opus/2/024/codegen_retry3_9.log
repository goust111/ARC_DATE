+    aux[r0 : r1 + 1, :sep_col][aux[r0 : r1 + 1, :sep_col] == LEFT_COLOR] = BG
+    aux[r0 : r1 + 1, sep_col + 1 :][aux[r0 : r1 + 1, sep_col + 1 :] == RIGHT_COLOR] = BG
+    for anchor in anchors:
+        aux[anchor.r, anchor.c] = BG
+    return aux
