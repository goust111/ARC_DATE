+    left = int(seg["left"])
+    right = int(seg["right"])
+    radius = int(seg["radius"])
+
+    mask = np.zeros((height, width), dtype=bool)
+    for row in range(0, min(height, radius + 1)):
+        shrink = radius - row
+        c0 = max(0, left - shrink)
+        c1 = min(width - 1, right + shrink)
+        mask[row, c0 : c1 + 1] = True
+    return mask
