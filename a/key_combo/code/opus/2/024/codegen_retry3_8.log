+    runs: list[tuple[int, int, int]] = []
+    col = 0
+    width = int(row.shape[0])
+    while col < width:
+        color = int(row[col])
+        if color == bg:
+            col += 1
+            continue
+        start = col
+        while col + 1 < width and int(row[col + 1]) == color:
+            col += 1
+        runs.append((start, col, color))
+        col += 1
+    return runs
