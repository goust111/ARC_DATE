+        red_base=red_base,
+        red_start=(red_r0, red_c0),
+        red_step=red_step,
+        left_top=left_top,
+        left_len=left_len,
+        right_top=right_top,
+        right_len=right_len,
+        left_pred=left_pred,
+        right_pred=right_pred,
+    )
