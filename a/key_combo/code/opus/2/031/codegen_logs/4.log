+    shifts = [_component_shift(a, b) for a, b in zip(coords_list, coords_list[1:])]
+    assert len(set(shifts)) == 1, "motion must be arithmetic"
+    dr, dc = shifts[0]
+    return coords_list[-1] + np.array([dr, dc], dtype=int)
