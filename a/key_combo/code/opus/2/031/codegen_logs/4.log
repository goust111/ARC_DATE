+        assert len(regions) >= 3, "expected a horizontal panel sequence"
+        widths = {c1 - c0 + 1 for c0, c1 in regions}
+        assert len(widths) == 1, "panels must have equal width"
+        return [grid[:, c0 : c1 + 1].copy() for c0, c1 in regions]
