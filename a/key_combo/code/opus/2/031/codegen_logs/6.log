+def _paint_cell(out: np.ndarray, r: int, c: int, color: int) -> None:
+    if 0 <= r < out.shape[0] and 0 <= c < out.shape[1]:
+        current = int(out[r, c])
+        if current == BACKGROUND or current == int(color):
+            out[r, c] = int(color)
+
