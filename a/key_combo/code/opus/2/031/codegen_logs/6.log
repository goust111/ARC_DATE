+def _bridge_params(lo: int, hi: int) -> tuple[int, int, int, int, int, int] | None:
+    gap = int(hi - lo - 1)
+    if gap < 4 or gap % 2 != 0:
+        return None
+    slid_lo = int(lo + 1)
+    slid_hi = int(hi - 1)
+    mid = int((slid_lo + slid_hi) // 2)
+    width = int(gap // 2)
+    rect_lo = int(mid - (width - 1) // 2)
+    rect_hi = int(rect_lo + width - 1)
+    return gap, slid_lo, slid_hi, mid, rect_lo, rect_hi
