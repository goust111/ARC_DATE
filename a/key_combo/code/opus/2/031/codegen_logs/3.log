+    if start[0] == end[0] or start[1] == end[1]:
+        return _segment_cells(start, end)
+    if first_axis == "h":
+        turn = (start[0], end[1])
+    elif first_axis == "v":
+        turn = (end[0], start[1])
+    else:
+        raise ValueError("first_axis must be 'h' or 'v'")
+    return _segment_cells(start, turn) + _segment_cells(turn, end)[1:]
+
+
