+    for _ in range(80):
+        axis = random.choice(["h", "v"])
+        length = random.randint(2, 5)
+        offset = random.randint(0, length - 1)
+        if axis == "h":
+            start_c = c - offset
+            coords = [(r, start_c + i) for i in range(length)]
+        else:
+            start_r = r - offset
+            coords = [(start_r + i, c) for i in range(length)]
