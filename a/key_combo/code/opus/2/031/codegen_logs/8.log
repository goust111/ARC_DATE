71:     for i in range(copies):
72:         row = i * (tile_h + 1)
73:         out[row, 0] = bg
74:         out[row, -1] = bg
75:         paste(out, tile, row + 1, 1)
76: 
77:     out[-1, 0] = bg
78:     out[-1, -1] = bg
79:     return out
