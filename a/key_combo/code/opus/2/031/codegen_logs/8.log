7: def main(grid: np.ndarray) -> np.ndarray:
8:     """
9:     Composite four quadrant panels into one panel, resolving overlaps by a fixed positional layer order.
10: 
11:     Input structure
12:     - The input is a 2x2 array of equal-size panels on a shared background.
13:     - Each panel contains exactly one distinct foreground color.
14:     - Corresponding cells in the four panels map to the same output cell.
15: 
16:     Rule
17:     - Create one output panel with the same shape as a single input panel.
18:     - Paint the upper-left panel first, then lower-right, then lower-left,
19:       then upper-right.
20:     - Only non-background pixels are painted; later panels overwrite earlier
21:       pixels at the same position.
22: 
23:     Key insight
24:     - The four panels are transparent layers whose depth is determined by panel
25:       position, not by numeric color order.
26:     """
27:     g = np.asarray(grid, dtype=int)
28:     assert g.ndim == 2, "expected a 2D grid"
29:     H, W = g.shape
30:     assert H % 2 == 0 and W % 2 == 0, "grid must split evenly into four panels"
31:     panel_h = H // 2
32:     panel_w = W // 2
33:     assert panel_h > 0 and panel_w > 0, "panels must be non-empty"
34: 
35:     bg = get_bg(g)
36:     upper_left = g[:panel_h, :panel_w]
37:     upper_right = g[:panel_h, panel_w:]
38:     lower_left = g[panel_h:, :panel_w]
39:     lower_right = g[panel_h:, panel_w:]
40:     panels = (upper_left, upper_right, lower_left, lower_right)
41: 
42:     panel_colors = [colors_present(panel, exclude={bg}) for panel in panels]
43:     assert all(len(colors) == 1 for colors in panel_colors), "each panel must have exactly one foreground color"
44:     assert len({colors[0] for colors in panel_colors}) == 4, "panel foreground colors must be distinct"
45: 
46:     out = np.full((panel_h, panel_w), bg, dtype=int)
47:     for panel in (upper_left, lower_right, lower_left, upper_right):
48:         mask = panel != bg
49:         out[mask] = panel[mask]
50:     return out
