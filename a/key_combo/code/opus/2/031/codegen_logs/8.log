94: def _edge_cells(h: int, w: int) -> list[tuple[int, int]]:
95:     return [
96:         (r, c)
97:         for r in range(h)
98:         for c in range(w)
99:         if r in (0, h - 1) or c in (0, w - 1)
100:     ]
