131: def _gen_attempt() -> np.ndarray | None:
132:     H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))
133:     W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))
134: 
135:     dims = _sample_object_dims(H, W)
136:     if dims is None:
137:         return None
138:     oh, ow = dims
139: 
140:     bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))
141:     inp = np.full((H, W), bg, dtype=int)
142:     inp[:oh, :ow] = body
143:     inp[H - oh : H, W - ow : W] = body
144:     mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]
145:     inp[mr, mc] = marker
146:     inp[H - oh + mr, W - ow + mc] = marker
147: 
148:     expected = _expected_output(inp, bg)
149:     if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:
150:         return None
151: 
152:     try:
153:         actual = main(inp)
154:     except AssertionError:
155:         return None
156:     if not np.array_equal(actual, expected):
157:         return None
158:     return inp
