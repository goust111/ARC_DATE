97: def _gen_pattern(cell_h: int, cell_w: int, colors: list[int], n_pixels: int) -> np.ndarray | None:
98:     pattern = np.zeros((cell_h, cell_w), dtype=int)
99:     anchor_rows = [r for r in range(cell_h) if not (cell_h % 2 and r == cell_h // 2)]
100:     anchor_cols = [c for c in range(cell_w) if not (cell_w % 2 and c == cell_w // 2)]
101:     ar = random.choice(anchor_rows)
102:     ac = random.choice(anchor_cols)
103:     blocked = {(ar, cell_w - 1 - ac), (cell_h - 1 - ar, ac)}
104: 
105:     coords = [(ar, ac)]
106:     row_counts = [0] * cell_h
107:     col_counts = [0] * cell_w
108:     row_counts[ar] = 1
109:     col_counts[ac] = 1
110: 
111:     available = [
112:         (r, c)
113:         for r in range(cell_h)
114:         for c in range(cell_w)
115:         if (r, c) != (ar, ac) and (r, c) not in blocked
116:     ]
117:     random.shuffle(available)
118:     for r, c in available:
119:         if len(coords) == n_pixels:
120:             break
121:         if row_counts[r] >= cell_w - 1 or col_counts[c] >= cell_h - 1:
122:             continue
123:         coords.append((r, c))
124:         row_counts[r] += 1
125:         col_counts[c] += 1
126: 
127:     if len(coords) != n_pixels:
128:         return None
129: 
130:     random.shuffle(coords)
131:     shuffled_colors = colors[:]
132:     random.shuffle(shuffled_colors)
133:     for i, (r, c) in enumerate(coords):
134:         pattern[r, c] = shuffled_colors[i] if i < len(shuffled_colors) else random.choice(colors)
135:     return pattern
