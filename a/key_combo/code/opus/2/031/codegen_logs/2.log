+    if corner == "nw":
+        up, down = extra_h - minor_vertical, minor_vertical
+        left, right = extra_w - minor_horizontal, minor_horizontal
+    elif corner == "ne":
+        up, down = extra_h - minor_vertical, minor_vertical
+        left, right = minor_horizontal, extra_w - minor_horizontal
+    elif corner == "sw":
+        up, down = minor_vertical, extra_h - minor_vertical
+        left, right = extra_w - minor_horizontal, minor_horizontal
+    elif corner == "se":
+        up, down = minor_vertical, extra_h - minor_vertical
+        left, right = minor_horizontal, extra_w - minor_horizontal
+    else:
