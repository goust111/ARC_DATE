+        area_i = (box_i[2] - box_i[0] + 1) * (box_i[3] - box_i[1] + 1)
+        for j in range(i + 1, len(rects)):
+            box_j = rects[j]["bbox"]
+            area_j = (box_j[2] - box_j[0] + 1) * (box_j[3] - box_j[1] + 1)
+            inter = _intersection_area(box_i, box_j)
+            if inter <= 0:
