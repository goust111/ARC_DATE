    left = np.any(cov[r0 : r1 + 1, c0] == 1)
    right = np.any(cov[r0 : r1 + 1, c1] == 1)
    return bool(top and bottom and left and right)


def _safe_marker_cells(rect: dict, cov: np.ndarray) -> list[tuple[int, int]]:
    r0, c0, r1, c1 = rect["bbox"]
