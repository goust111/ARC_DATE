+    limit = 2 * (g.shape[0] + g.shape[1] + 5)
+    for _ in range(limit):
+        if _paint_stroke(out, bbox, side_mask, BLUE) == 0:
+            break
+        bbox = _shift_bbox(bbox, step, -1)
+    else:
+        raise AssertionError("smaller-direction extension did not terminate")
