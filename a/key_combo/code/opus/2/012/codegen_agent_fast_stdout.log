   183	        frames.append((cnt, color, r0, r1, c0, c1))
   184	
   185	    frames.sort(key=lambda x: x[0])
   186	
   187	    out = np.zeros((h, w), dtype=int)
   188	    for _, color, r0, r1, c0, c1 in frames:
   189	        for c in range(c0, c1 + 1):
   190	            out[r0, c] = color
   191	            out[r1, c] = color
   192	        for r in range(r0, r1 + 1):
   193	            out[r, c0] = color
   194	            out[r, c1] = color
   195	
   196	    return out
