import numpy as np

_rng = np.random.default_rng(202603)


def _build_input():
    palette = [2, 1, 3, 4]

    R = int(_rng.integers(3, 6))
    C = int(_rng.integers(3, 6))
    row_sizes = [int(_rng.integers(2, 4)) for _ in range(R)]
    col_sizes = [int(_rng.integers(2, 4)) for _ in range(C)]

    h_cells = sum(row_sizes) + R + 1
    w_cells = sum(col_sizes) + C + 1

    lattice_w = max(w_cells, 6)

    h = h_cells + 1 + int(_rng.integers(2, 4))
    n = int(_rng.integers(2, 4))
    w = max(lattice_w, 2)

    grid = np.zeros((h, w), dtype=int)

    row_lines = [0]
    c = 0
    for s in row_sizes:
        c += s
        row_lines.append(c + len(row_lines) - 1)
    col_lines = [0]
    c = 0
    for s in col_sizes:
        c += s
        col_lines.append(c + len(col_lines) - 1)

    # 边界线和内部分割线
    for r in row_lines:
        grid[r, :w_cells] = 5
    for c in col_lines:
        grid[:h_cells, c] = 5

    for ri in range(R):
        for cj in range(C):
            rs = row_lines[ri] + 1
            re = row_lines[ri + 1]
            cs = col_lines[cj] + 1
            ce = col_lines[cj + 1]
            col = int(_rng.choice(palette))
            for r in range(rs, re):
                for c2 in range(cs, ce):
                    grid[r, c2] = col

    # 各色至少一次
    used = {int(x) for x in grid[grid "'!= 0]}
    present = [c for c in palette if c in used]
    missing = [c for c in palette if c not in used]
    if missing:
        rr = 0
        for c in missing:
            rs = row_lines[rr] + 1
            cs = col_lines[rr] + 1
            grid[rs, cs] = c
            rr += 1

    # 图例放在下方，左侧双列
    legend_start_row = h_cells + 1
    available_colors = palette
    for i in range(n):
        a, b = tuple(int(_rng.choice(available_colors, size=2, replace=False))
        if a == b:
            b = available_colors[(available_colors.index(a) + 1) % len(available_colors)]
        grid[legend_start_row + i, 0] = a
        grid[legend_start_row + i, 1] = b

    return grid


def generate_input():
    while True:
        grid = _build_input()
        # 解析检查是否得到有效网格结构
        cols = np.where(np.any(grid == 5, axis=0))[0]
        rows = np.where(np.any(grid == 5, axis=1))[0]
        if len(rows) < 2 or len(cols) < 2:
            continue

        top, bottom = int(rows.min()), int(rows.max())
        left, right = int(cols.min()), int(cols.max())
        lattice = grid[top : bottom + 1, left : right + 1]
        rows_l = np.where(np.any(lattice == 5, axis=1))[0]
        cols_l = np.where(np.any(lattice == 5, axis=0))[0]
        if len(rows_l) < 2 or len(cols_l) < 2:
            continue

        R = len(rows_l) - 1
        C = len(cols_l) - 1
        if R < 3 or C < 3:
            continue

        legend_row = bottom + 1
        if legend_row >= grid.shape[0] - 2:
            continue
        has_leg = False
        for r in range(legend_row + 1, min(grid.shape[0], legend_row + 5)):
            if grid[r, 0] and grid[r, 1] and grid[r, 0] != grid[r, 1]:
                has_leg = True
                break
        if not has_leg:
            continue

        return grid


def main(grid):
    """
    输入: 以灰(5)为网格骨架的矩阵，右侧下方有两列图例。

    输出: 与输入同尺寸；格子区域按边缘/内部做不同方向的链式替换，图例与网格线不变。

    算法: 1) 提取灰线行列以恢复单元格阵列；
    2) 读取图例序列 S = (L_i,R_i)；
    3) 边缘单元格对其颜色做正向(L_i->R_i)链式映射，内部单元格做逆向(R_i->L_i)链式映射。

    复杂度: O(H*W*N)。
    """
    g = np.array(grid, dtype=int, copy=True)
    h, w = g.shape

    row_lines = np.where(np.any(g == 5, axis=1))[0]
    col_lines = np.where(np.any(g == 5, axis=0))[0]
    if len(row_lines) < 2 or len(col_lines) < 2:
        return g

    top, bottom = int(row_lines.min()), int(row_lines.max())
    left, right = int(col_lines.min()), int(col_lines.max())
    rows = row_lines - top
    cols = col_lines - left

    legend_pairs = []
    sr = bottom + 1
    for r in range(sr + 1, h):
        l = int(g[r, 0])
        rr = int(g[r, 1])
        if l == 0 and rr == 0:
            break
        if l != 0 and rr != 0 and l != rr:
            legend_pairs.append((l, rr))

    R = len(rows) - 1
    C = len(cols) - 1
    if R <= 0 or C <= 0:
        return g

    for ri in range(R):
        r0 = rows[ri] + top
        r1 = rows[ri + 1] + top
        edge_row = (ri == 0 or ri == R - 1)
        for cj in range(C):
            c0 = cols[cj] + left
            c1 = cols[cj + 1] + left
            edge_col = (cj == 0 or cj == C - 1)
            edge_cell = edge_row or edge_col
            fill_color = int(g[r0 + 1, c0 + 1])

            if fill_color == 5:
                continue
            newc = fill_color
            if edge_cell:
                for a, b in legend_pairs:
                    if newc == a:
                        newc = b
            else:
                for a, b in legend_pairs:
                    if newc == b:
                        newc = a
            for r in range(r0 + 1, r1):
                for c in range(c0 + 1, c1):
                    g[r, c] = newc

    return g
