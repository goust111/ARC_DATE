def _is_rect_border(grid, color):
    h, w = grid.shape
    vis = np.zeros_like(grid, dtype=bool)
    for r in range(h):
        for c in range(w):
            if vis[r, c] or grid[r, c] != color:
                continue
            q = [(r, c)]
            vis[r, c] = True
            comp = [(r, c)]
            for cr, cc in q:
