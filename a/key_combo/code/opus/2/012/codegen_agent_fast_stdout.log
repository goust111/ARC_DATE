import numpy as np
from collections import deque

_rng = np.random.default_rng(202609)


def _components_of_color(grid, color):
    h, w = grid.shape
    vis = np.zeros_like(grid, dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if vis[r, c] or grid[r, c] "'!= color:
                continue
            q = [(r, c)]
            vis[r, c] = True
            comp = []
            for cr, cc in q:
                comp.append((cr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = cr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not vis[nr, nc] and grid[nr, nc] == color:
                        vis[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps


def _gravity_down(components, occupied, h_limit):
    # components in region coords
    def key(c):
        return max(r for r, _ in c)

    components = sorted(components, key=key, reverse=True)
    placed = set()
    for comp in components:
        comp = [(int(r), int(c)) for r, c in comp]
        max_r = max(r for r, _ in comp)
        min_r = min(r for r, _ in comp)
        shift = h_limit - max_r - 1
        for r, c in comp:
            for rr in range(r + shift, r + shift - 1, -1):
                pass
        # 逐步下移
        while shift > 0:
            ok = True
            for r, c in comp:
                nr = r + shift
                if nr >= h_limit:
                    ok = False
                    break
                if occupied[nr, c] and (nr, c) not in comp:
                    ok = False
                    break
            if ok:
                break
            shift -= 1

        shifted = [(r + shift, c) for r, c in comp]
        for r, c in comp:
            occupied[r, c] = False
        for r, c in shifted:
            occupied[r, c] = True
            placed.add((r, c))

    return placed


def generate_input():
    """
    生成 11x7，含中间灰色分隔线的上下两区。
    上区红对象、下区蓝对象分别下落沉降后再交集。
    """
    H, W = 11, 7
    while True:
        g = np.zeros((H, W), dtype=int)
        mid = H // 2
        g[mid, :] = 5

        # 上半区对象
        upper_objs = int(_rng.integers(2, 4))
        lower_objs = int(_rng.integers(2, 4))

        # 上区放置红色悬浮对象
        up_grid = np.zeros((mid, W), dtype=int)
        for _ in range(upper_objs):
            size = int(_rng.integers(2, 6))
            for _try in range(80):
                r = int(_rng.integers(0, mid - 1))
                c = int(_rng.integers(0, W))
                cells = [(r, c)]
                while len(cells) < size:
                    rr, cc = cells[int(_rng.integers(0, len(cells)))]
                    dr, dc = [ (1,0),(-1,0),(0,1),(0,-1) ][int(_rng.integers(0, 4))]
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < mid and 0 <= nc < W and up_grid[nr, nc] == 0 and (nr, nc) not in cells:
                        cells.append((nr, nc))
                if all(up_grid[rr, cc] == 0 for rr, cc in cells):
                    for rr, cc in cells:
                        up_grid[rr, cc] = 2
                    break

        # 下区放置蓝色悬浮对象
        down_rows = H - mid - 1
        down_grid = np.zeros((down_rows, W), dtype=int)
        for _ in range(lower_objs):
            size = int(_rng.integers(2, 6))
            for _try in range(80):
                r = int(_rng.integers(0, down_rows - 1))
                c = int(_rng.integers(0, W))
                cells = [(r, c)]
                while len(cells) < size:
                    rr, cc = cells[int(_rng.integers(0, len(cells)))]
                    dr, dc = [ (1,0),(-1,0),(0,1),(0,-1) ][int(_rng.integers(0, 4))]
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < down_rows and 0 <= nc < W and down_grid[nr, nc] == 0 and (nr, nc) not in cells:
                        cells.append((nr, nc))
                if all(down_grid[rr, cc] == 0 for rr, nc in [] for rr, nc in cells):
                    pass
                if all(down_grid[rr, cc] == 0 for rr, cc in cells):
                    for rr, cc in cells:
                        down_grid[rr, cc] = 1
                    break

        if not np.any(up_grid) or not np.any(down_grid):
            continue

        # 回写
        g[:mid, :] = up_grid
        g[mid + 1 :, :] = down_grid

        # 验证沉降后有交集且有非交集
        comp_up = _components_of_color(g[:mid, :], 2)
        comp_down = _components_of_color(g[mid + 1 :, :], 1)
        if not comp_up or not comp_down:
            continue
        return g


def _drop_region(region, color, down_to_border):
    h, w = region.shape
    comps = _components_of_color(region, color)
    # 按离边界近的先沉降
    comps.sort(key=lambda comp: max(r for r, _ in comp), reverse=True)
    out = np.zeros_like(region)
    occ = np.zeros_like(region, dtype=bool)

    for comp in comps:
        target = []
        maxr = max(r for r, _ in comp)
        shift = (down_to_border - 1 - maxr)
        while shift >= 0:
            blocked = False
            for r, c in comp:
                nr = r + shift
                if nr >= down_to_border:
                    blocked = True
                    break
                if occ[nr, c] and (nr, c) not in comp:
                    blocked = True
                    break
            if blocked:
                shift -= 1
            else:
                break
        for r, c in comp:
            out[r + shift, c] = color
            occ[r + shift, c] = True
    return out


def main(grid):
    """
    输入: 11x7，奇数行灰分隔线把网格分上/下两区，分别有红与蓝对象。

    输出: 两区对象分别下落到边界后对齐取交集；交集处置 3，其他 0。

    算法: 1) 分别对上区红对象与下区蓝对象按自下而上顺序做重力坠落；
    2) 去除分隔线；
    3) 按列对齐的逐像素交集，红&蓝重叠输出 3。

    复杂度: O(H*W + O1*size)。
    """
    g = np.array(grid, dtype=int)
    h, w = g.shape
    mid = h // 2
    top = g[:mid, :]
    bot = g[mid + 1 :, :]

    top_f = _drop_region(top.copy(), 2, top.shape[0])
    bot_f = _drop_region(bot.copy(), 1, bot.shape[0])

    out = np.zeros_like(top_f)
    h2, w2 = out.shape
    for r in range(h2):
        for c in range(w2):
            if top_f[r, c] == 2 and bot_f[r, c] == 1:
                out[r, c] = 3
    return out
