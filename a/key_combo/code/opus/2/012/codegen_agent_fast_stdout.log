     7	def _bfs_path(grid, start, goal):
     8	    h, w = grid.shape
     9	    dist = -np.ones((h, w), dtype=int)
    10	    prev = {}
    11	    q = deque([start])
    12	    dist[start] = 0
    13	    while q:
    14	        r, c = q.popleft()
    15	        if (r, c) == goal:
    16	            break
    17	        nd = dist[r, c] + 1
    18	        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
    19	            nr, nc = r + dr, c + dc
    20	            if not (0 <= nr < h and 0 <= nc < w):
    21	                continue
    22	            if grid[nr, nc] == 3:
    23	                continue
    24	            if dist[nr, nc] != -1:
    25	                continue
    26	            dist[nr, nc] = nd
    27	            prev[(nr, nc)] = (r, c)
    28	            q.append((nr, nc))
    29	
    30	    if dist[goal] == -1:
    31	        return None
    32	    path = []
    33	    cur = goal
    34	    while cur != start:
    35	        path.append(cur)
    36	        cur = prev[cur]
    37	    path.append(start)
    38	    path.reverse()
    39	    return path
