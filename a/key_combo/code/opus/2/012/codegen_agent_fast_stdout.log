import importlib.util, os, hashlib, numpy as np, py_compile, time

base='/home/lixinyu/snap/a/key_combo/code/opus/2/012'

for i in range(1,11):
    name=f'{i}.py'
    path=os.path.join(base,name)
    try:
        py_compile.compile(path,doraise=True)
    except Exception as e:
        print(name,'compile_fail')
        continue

    spec=importlib.util.spec_from_file_location(f'm{i}', path)
    mod=importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mod)
    except Exception as e:
        print(name,'import_fail',repr(e))
        continue

    variants=set()
    ok=True
    why=''
    tstart=time.time()

    for t in range(100):
        start=time.time()
        try:
            inp=mod.generate_input()
            if not isinstance(inp,np.ndarray) or inp.ndim"'!=2:
                raise ValueError('"'generate_input return')
            out=mod.main(inp)
            if not isinstance(out,np.ndarray) or out.ndim"'!=2:
                raise ValueError('"'main return')
            if inp.shape[0]>30 or inp.shape[1]>30 or out.shape[0]>30 or out.shape[1]>30:
                raise ValueError('shape limit')
        except Exception as e:
            ok=False
            why=f'err@{t}:{e}'
            break

        if time.time()-start > 2.0:
            ok=False
            why=f'timeout@{t}'
            break

        variants.add(hashlib.sha256(inp.tobytes()).hexdigest())

    if not ok:
        print(name,'FAIL',why)
    else:
        print(name,'OK', 'variants',len(variants))

    if time.time()-tstart > 40:
        # 防止单次卡住
        break
