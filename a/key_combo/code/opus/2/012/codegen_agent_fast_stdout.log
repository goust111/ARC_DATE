     6	def _cc4(grid, color_mask=None):
     7	    h, w = grid.shape
     8	    vis = np.zeros_like(grid, dtype=bool)
     9	    comps = []
    10	    for r in range(h):
    11	        for c in range(w):
    12	            if vis[r, c]:
    13	                continue
    14	            v = grid[r, c]
    15	            if v == 0 or (color_mask is not None and v not in color_mask):
    16	                continue
    17	            stack = [(r, c)]
    18	            vis[r, c] = True
    19	            comp = []
    20	            for cr, cc in stack:
    21	                comp.append((cr, cc))
    22	                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
    23	                    nr, nc = cr + dr, cc + dc
    24	                    if 0 <= nr < h and 0 <= nc < w and not vis[nr, nc] and grid[nr, nc] == v:
    25	                        vis[nr, nc] = True
    26	                        stack.append((nr, nc))
    27	            comps.append((v, comp))
    28	    return comps
