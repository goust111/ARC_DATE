import numpy as np

_rng = np.random.default_rng(202604)


def _cc4(grid, color_mask=None):
    h, w = grid.shape
    vis = np.zeros_like(grid, dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if vis[r, c]:
                continue
            v = grid[r, c]
            if v == 0 or (color_mask is not None and v not in color_mask):
                continue
            stack = [(r, c)]
            vis[r, c] = True
            comp = []
            for cr, cc in stack:
                comp.append((cr, cc))
                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    nr, nc = cr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not vis[nr, nc] and grid[nr, nc] == v:
                        vis[nr, nc] = True
                        stack.append((nr, nc))
            comps.append((v, comp))
    return comps


def _is_rect_frame(cells):
    rs = [p[0] for p in cells]
    cs = [p[1] for p in cells]
    r0, r1 = min(rs), max(rs)
    c0, c1 = min(cs), max(cs)
    area = (r1 - r0 + 1) * (c1 - c0 + 1)
    if area < 16:
        return None
    border = []
    for r, c in cells:
        if r in (r0, r1) or c in (c0, c1):
            border.append((r, c))
    if len(border) "'!= len(set(border)):
        return None
    # 外框厚度必须为1，且框线颜色必须连通且完整
    if len(border) != 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4:
        return None
    return (r0, r1, c0, c1)


def generate_input():
    """
    生成 14x14 网格，包含 3~4 个不同色矩形框和若干黄标记。
    框内黄块数量均不相同，用于后续按标记数排序重绘。
    """
    H = W = 14
    colors = [1, 2, 3, 7]
    sprite_colors = [4]

    while True:
        k = int(_rng.integers(3, 5))
        frame_colors = list(colors[:k])
        _rng.shuffle(frame_colors)

        grid = np.zeros((H, W), dtype=int)
        frames = []
        used = np.zeros((H, W), dtype=bool)
        hlims = [0, H - 1]
        for idx, fc in enumerate(frame_colors):
            placed = False
            tries = 0
            while tries < 200 and not placed:
                tries += 1
                h = int(_rng.integers(4, 8))
                w = int(_rng.integers(4, 8))
                r0 = int(_rng.integers(0, H - h))
                c0 = int(_rng.integers(0, W - w))
                r1 = r0 + h - 1
                c1 = c0 + w - 1
                if any(used[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2]):
                    continue
                placed = True
                used[r0 - 1 : r1 + 2, c0 - 1 : c1 + 2] = True
                for c in range(c0, c1 + 1):
                    grid[r0, c] = fc
                    grid[r1, c] = fc
                for r in range(r0, r1 + 1):
                    grid[r, c0] = fc
                    grid[r, c1] = fc
                frames.append((fc, r0, r1, c0, c1))

            if not placed:
                break

        if len(frames) != k:
            continue

        # 至少一对框重叠边框像素
        overlap = False
        for i in range(len(frames)):
            for j in range(i + 1, len(frames)):
                fi = set()
                bi = frames[i]
                bj = frames[j]
                for c in range(bi[3], bi[4] + 1):
                    fi.add((bi[1], c)); fi.add((bi[2], c))
                for r in range(bi[1], bi[2] + 1):
                    fi.add((r, bi[3])); fi.add((r, bi[4]))
                for c in range(bj[3], bj[4] + 1):
                    if (bj[1], c) in fi or (bj[2], c) in fi:
                        overlap = True
                for r in range(bj[1], bj[2] + 1):
                    if (r, bj[3]) in fi or (r, bj[4]) in fi:
                        overlap = True
        if not overlap:
            continue

        # 在每个框内放置互异的黄标记数
        cnts = np.array(list(range(1, k + 1)), dtype=int)
        _rng.shuffle(cnts)
        all_cells = [(r, c) for r in range(H) for c in range(W) if grid[r, c] == 0]
        _rng.shuffle(all_cells)

        usedm = np.zeros_like(grid, dtype=bool)
        ok = True
        for idx, (fc, r0, r1, c0, c1) in enumerate(frames):
            interior = []
            for r in range(r0 + 1, r1):
                for c in range(c0 + 1, c1):
                    interior.append((r, c))
            if len(interior) < cnts[idx]:
                ok = False
                break
            chosen = interior[:cnts[idx]]
            for rr, cc in chosen:
                usedm[rr, cc] = True
                grid[rr, cc] = 4

        if not ok:
            continue

        # 干扰项：放在框外
        outside = [(r, c) for r in range(H) for c in range(W) if not usedm[r, c] and grid[r, c] == 0]
        _rng.shuffle(outside)
        for rr, cc in outside[:2]:
            grid[rr, cc] = 4

        return grid


def main(grid):
    """
    输入: 若干单像素厚矩形框（边框色 1/2/3/7）与黄标记(4)。

    输出: 擦除所有黄点后仅保留边框，按“框内黄点数”从少到多依次绘制。

    算法: 1) 识别各矩形框并计算其严格内部黄点数量；
    2) 依据数量排序后绘制边框，后绘制覆盖先绘制；
    3) 忽略框外黄点。

    复杂度: O(H*W + F*P)。
    """
    g = np.array(grid, dtype=int, copy=True)
    h, w = g.shape
    comps = _cc4(g, {1, 2, 3, 7})

    frames = []
    seen = set()
    for color, comp in comps:
        b = _is_rect_frame(comp)
        if b is None:
            continue
        r0, r1, c0, c1 = b
        key = (color, r0, r1, c0, c1)
        if key in seen:
            continue
        seen.add(key)
        cnt = 0
        for r in range(r0 + 1, r1):
            for c in range(c0 + 1, c1):
                if g[r, c] == 4:
                    cnt += 1
        frames.append((cnt, color, r0, r1, c0, c1))

    frames.sort(key=lambda x: x[0])

    out = np.zeros((h, w), dtype=int)
    for _, color, r0, r1, c0, c1 in frames:
        for c in range(c0, c1 + 1):
            out[r0, c] = color
            out[r1, c] = color
        for r in range(r0, r1 + 1):
            out[r, c0] = color
            out[r, c1] = color

    return out
