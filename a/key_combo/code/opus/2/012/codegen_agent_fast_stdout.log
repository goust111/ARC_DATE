import numpy as np
from collections import deque

_rng = np.random.default_rng(202601)


def _bfs_path(grid, start, goal):
    h, w = grid.shape
    dist = -np.ones((h, w), dtype=int)
    prev = {}
    q = deque([start])
    dist[start] = 0
    while q:
        r, c = q.popleft()
        if (r, c) == goal:
            break
        nd = dist[r, c] + 1
        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr, nc = r + dr, c + dc
            if not (0 <= nr < h and 0 <= nc < w):
                continue
            if grid[nr, nc] == 3:
                continue
            if dist[nr, nc] "'!= -1:
                continue
            dist[nr, nc] = nd
            prev[(nr, nc)] = (r, c)
            q.append((nr, nc))

    if dist[goal] == -1:
        return None
    path = []
    cur = goal
    while cur != start:
        path.append(cur)
        cur = prev[cur]
    path.append(start)
    path.reverse()
    return path


def generate_input():
    """
    随机生成 15x15 的迷宫寻路实例。
    绿色种子所在列为周期绿柱起点，柱状缺口全部位于同一行。
    两个红端点随机放置于种子列左右并保证至少一条最短路径可达。
    """
    H = W = 15

    while True:
        seed_col = int(_rng.integers(4, 11))
        if seed_col % 2 == 1:
            seed_col -= 1
        seed_row = int(_rng.integers(4, 11))
        # 两根端点必须位于 seed_col 左右两侧，并且不在同一行
        left_col = int(_rng.integers(1, max(2, seed_col)))
        right_col = int(_rng.integers(seed_col + 5, W - 1))
        row1 = int(_rng.integers(0, H))
        row2 = int(_rng.integers(0, H))
        if row1 == row2:
            row2 = (row2 + 1) % H

        grid = np.zeros((H, W), dtype=int)
        for c in range(seed_col, W, 2):
            grid[:, c] = 3

        # 生成缺口（缺口在种子行）
        for c in range(seed_col, W, 2):
            grid[seed_row, c] = 0

        grid[row1, left_col] = 2
        grid[row2, right_col] = 2

        start, end = (row1, left_col), (row2, right_col)
        path = _bfs_path(grid, start, end)
        if path is None:
            continue

        # 简单重筛：仅使用障碍结构与端点列关系构成实例
        return grid


def main(grid):
    """
    输入: 0-背景、3-绿种子及垂直绿栅栏、2-两个红端点。

    输出: 0-背景、3-同样的绿栅栏、2-端点、4-唯一最短路径上的中间像素。

    算法: 1) 提取绿线列和缺口行，构造可通行网格；
    2) 在黑色像素+两个红端点中做四邻接最短路；
    3) 将路径中红端点以外的像素改为4；其余保留。

    复杂度: O(H*W)。
    """
    g = np.array(grid, dtype=int, copy=True)
    h, w = g.shape
    verts = np.argwhere(g == 3)
    if verts.size == 0:
        return g

    seed_cols = np.unique(verts[:, 1])
    rows_for_cols = np.zeros((len(seed_cols), w), dtype=int)

    green_cols = list(seed_cols)
    path_row = 0
    found_row = None
    for r in range(h):
        ok = True
        for c in green_cols:
            if g[r, c] != 0:
                ok = False
                break
        if ok:
            found_row = r
            break
    if found_row is not None:
        path_row = found_row

    reds = np.argwhere(g == 2)
    if reds.shape[0] != 2:
        return g
    start = tuple(int(x) for x in reds[0])
    goal = tuple(int(x) for x in reds[1])

    # 与生成一致：绿线是障碍
    path = _bfs_path(g, start, goal)
    if path is None:
        return g

    for r, c in path:
        if (r, c) not in (start, goal) and g[r, c] == 0:
            g[r, c] = 4
    return g
