import numpy as np
from itertools import combinations

_rng = np.random.default_rng(202607)


def _make_quadrant_pattern(size, color):
    mat = np.zeros((size, size), dtype=int)
    # 随机生成一个连通前景形状
    k = int(_rng.integers(6, 12))
    cells = []
    r = int(_rng.integers(0, size))
    c = int(_rng.integers(0, size))
    mat[r, c] = color
    cells.append((r, c))
    for _ in range(k - 1):
        rr, cc = cells[int(_rng.integers(0, len(cells)))]
        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        _rng.shuffle(dirs)
        for dr, dc in dirs:
            nr, nc = rr + dr, cc + dc
            if 0 <= nr < size and 0 <= nc < size and mat[nr, nc] == 0:
                mat[nr, nc] = color
                cells.append((nr, nc))
                break
    return mat


def _diff(a, b):
    return int(np.sum((a "'!= b) & ((a != 0) | (b != 0)) | ((a == 0) & (b == 0) & False)))


def generate_input():
    """
    生成 13x13 网格，被灰(5)十字分成四象限。
    每象限包含单色前景图案，且恰好有唯一象限对为差异最小对。
    """
    while True:
        n = 13
        mid = n // 2
        hq = (n // 2)
        base = np.zeros((n, n), dtype=int)
        base[mid, :] = 5
        base[:, mid] = 5

        colors = [1, 2, 3]
        # 四个象限模式，先随机给色
        q = [_make_quadrant_pattern(hq, int(_rng.choice(colors)))]
        p1 = _make_quadrant_pattern(hq, int(q[0][q[0] != 0][0,0] if np.any(q[0]) else _rng.choice(colors)))
        while not np.any(p1):
            p1 = _make_quadrant_pattern(hq, int(_rng.choice(colors)))

        # 依赖四象限构造，手工控制最小差异对在 q0,q1
        q0 = _make_quadrant_pattern(hq, int(_rng.choice(colors)))
        q1 = q0.copy()
        # 打开一个差异位
        zr, zc = int(_rng.integers(0, hq)), int(_rng.integers(0, hq))
        col1 = int(_rng.choice([1, 2, 3]))
        q1[zr, zc] = col1

        q2 = _make_quadrant_pattern(hq, int(_rng.choice([1, 2, 3])))
        q3 = _make_quadrant_pattern(hq, int(_rng.choice([1, 2, 3])))

        # 随机置入
        base[0: hq, 0: hq] = q0
        base[0: hq, mid + 1 :] = q1
        base[mid + 1 :, 0: hq] = q2
        base[mid + 1 :, mid + 1 :] = q3

        quads = [q0, q1, q2, q3]
        all_d = []
        unique = True
        for i, j in combinations(range(4), 2):
            all_d.append((np.count_nonzero(quads[i] != quads[j]), i, j))
        vals = [d for d, _, _ in all_d]
        if min(vals) == 0:
            continue
        if len(set(vals)) == 1:
            continue
        # 要求 q0 与 q1 至少同色且差异最小
        if not np.array_equal(np.where(q0), np.where(q1)) and np.count_nonzero(q0 == q1) == 0:
            continue
        m = min(vals)
        ties = [x for x in all_d if x[0] == m]
        if len(ties) != 1:
            continue

        return base


def main(grid):
    """
    输入: 灰(5)形成中位十字后，四个象限各含单色前景。

    输出: 将四个象限提取后找出两两差异最小的一对，输出该对前景交集。

    算法: 1) 解析四象限；
    2) 统计6个象限对差异像素数并取唯一最小；
    3) 对该象限对逐像素交集，前景则填 3，否则 0。

    复杂度: O(H*W)。
    """
    g = np.array(grid, dtype=int)
    n, m = g.shape
    if n % 2 == 0 or m % 2 == 0:
        return np.zeros((n // 2, m // 2), dtype=int)
    mid_r, mid_c = n // 2, m // 2

    q_tl = g[:mid_r, :mid_c]
    q_tr = g[:mid_r, mid_c + 1 :]
    q_bl = g[mid_r + 1 :, :mid_c]
    q_br = g[mid_r + 1 :, mid_c + 1 :]

    quads = [q_tl, q_tr, q_bl, q_br]
    pairs = list(combinations(range(4), 2))
    scores = []
    for i, j in pairs:
        a, b = quads[i], quads[j]
        d = int(np.sum(a != b))
        scores.append((d, i, j))

    scores.sort(key=lambda x: (x[0], x[1], x[2]))
    d0, i0, j0 = scores[0]
    if d0 == 0:
        return np.zeros((mid_r, mid_c), dtype=int)

    A, B = quads[i0], quads[j0]
    inter = ((A != 0) & (B != 0)).astype(int)
    out = np.zeros_like(inter, dtype=int)
    out[inter == 1] = 3
    return out
