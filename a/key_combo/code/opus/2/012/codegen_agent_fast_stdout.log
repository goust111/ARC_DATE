import numpy as np

_rng = np.random.default_rng(202605)


def _simulate_ray(h, w, start, dr, dc):
    path = set()
    r, c = start
    rr, cc = r, c
    for _ in range(4 * max(h, w)):
        rr += dr
        cc += dc
        if not (0 <= rr < h and 0 <= cc < w):
            if rr < 0 or rr >= h:
                dr *= -1
                rr = r + dr
            if cc < 0 or cc >= w:
                dc *= -1
                cc = c + dc
            # 如果两边都越界，方向会翻转两次
            rr = r + dr
            cc = c + dc
            if not (0 <= rr < h and 0 <= cc < w):
                break

        path.add((rr, cc))
        r, c = rr, cc
        if (r, c) == start:
            break
    return path


def _is_collinear(p0, p1, p2):
    return (p1[0] - p0[0]) == (p2[0] - p1[0]) and (p1[1] - p0[1]) == (p2[1] - p1[1])


def _parse_seed(grid):
    pts = np.argwhere(grid == 6)
    pts = [tuple(map(int, p)) for p in pts]
    if len(pts) not in (2, 3):
        return None

    pts_sorted = sorted(pts)
    center = ((grid.shape[0] - 1) / 2.0, (grid.shape[1] - 1) / 2.0)

    # 找出端点与方向
    if len(pts) == 2:
        a, b = pts_sorted
        dr = b[0] - a[0]
        dc = b[1] - a[1]
        if abs(dr) "'!= 1 or abs(dc) != 1:
            return None
        dist_a = (a[0] - center[0]) ** 2 + (a[1] - center[1]) ** 2
        dist_b = (b[0] - center[0]) ** 2 + (b[1] - center[1]) ** 2
        if dist_a >= dist_b:
            return a, (dr, dc)
        return b, (-dr, -dc)

    # len == 3，假设位于同一对角线
    a, b, c = pts_sorted
    if _is_collinear(a, b, c):
        start = a
        end = c
    else:
        start = b
        end = c if b[0] != a[0] else a
    dr = end[0] - start[0]
    dc = end[1] - start[1]
    if abs(dr) != 1 or abs(dc) != 1:
        return None

    if (start[0] - center[0]) ** 2 + (start[1] - center[1]) ** 2 >= '"\\
       (end[0] - center[0]) ** 2 + (end[1] - center[1]) ** 2:
        return start, (dr, dc)
    return end, (-dr, -dc)


def _build_pattern(grid):
    return grid


def generate_input():
    \"\"\"
    生成 11x11 的奇数网格：近对称前景、黄空洞、对角品红种子及其反射射线可达性。
    射线会穿过部分黄洞并修复，未穿过的不变。
    \"\"\"
    n = 11
    colors = [1, 2, 3]

    while True:
        grid = np.zeros((n, n), dtype=int)

        # 随机决定种子与方向
        ori = int(_rng.integers(0, 2))
        if ori == 0:
            seed = [(0, 0), (1, 1)]
            start_dir = (1, 1)
            if int(_rng.integers(0, 2)) == 1:
                seed = [(0, 1), (1, 0)]
                start_dir = (1, -1)
        else:
            seed = [(10, 0), (9, 1)]
            start_dir = (-1, 1)
            if int(_rng.integers(0, 2)) == 1:
                seed = [(10, 10), (9, 9)]
                start_dir = (-1, -1)

        # 确保种子 2~3 像素对角连续
        if int(_rng.integers(0, 2)) == 0:
            extra = (seed[1][0] + int(start_dir[0]), seed[1][1] + int(start_dir[1]))
            if 0 <= extra[0] < n and 0 <= extra[1] < n and int(_rng.integers(0, 2)) == 1:
                seed.append(extra)
        for p in seed:
            grid[p] = 6

        path = _simulate_ray(n, n, seed[0], start_dir[0], start_dir[1])

        # 生成近似双轴对称前景：按轨道块赋色，避开射线轨迹
        target_indices = []
        for r in range(n):
            for c in range(n):
                orbit = [(r, c), (r, n - 1 - c), (n - 1 - r, c), (n - 1 - r, n - 1 - c)]
                if any(p in seed for p in orbit):
                    continue
                # 选用上半角的一半进行采样
                if r > n // 2 or (r == n // 2 and c > n // 2):
                    continue
                target_indices.append((r, c))

        _rng.shuffle(target_indices)
        fill_budget = int(_rng.integers(20, 35))
        drawn = 0
        for r, c in target_indices:
            if drawn >= fill_budget:
                break
            if (r, c) in path:
                continue
            orbit = [(r, c), (r, n - 1 - c), (n - 1 - r, c), (n - 1 - r, n - 1 - c)]
            if any(p in path for p in orbit):
                continue
            col = int(_rng.choice(colors))
            for rr, cc in orbit:
                if 0 <= rr < n and 0 <= cc < n and grid[rr, cc] == 0:
                    grid[rr, cc] = col
            drawn += 1

        colored_count = int(np.sum(np.isin(grid, colors)))
        if not (30 <= colored_count <= 50):
            continue

        candidates = [(r, c) for r in range(n) for c in range(n)
                      if grid[r, c] == 0 and (r, c) not in path and (r, c) not in seed]
        if len(candidates) < 6:
            continue

        _rng.shuffle(candidates)
        path_holes = []
        off_holes = []
        for p in candidates:
            orbit = [(p[0], p[1]), (p[0], n - 1 - p[1]), (n - 1 - p[0], p[1]), (n - 1 - p[0], n - 1 - p[1])]
            if any(grid[rr, cc] not in (0, 4) for rr, cc in orbit):
                if p in path:
                    path_holes.append(p)
                else:
                    off_holes.append(p)

        if len(path_holes) < 2 or len(off_holes) < 2:
            continue

        for p in path_holes[:4]:
            grid[p] = 4
        for p in off_holes[:4]:
            grid[p] = 4

        # 至少一对路径/非路径空洞都要有
        if np.any(grid == 4) and int(np.sum(grid == 4)) >= 4:
            return grid


def main(grid):
    \"\"\"
    输入: 11x11 网格，含蓝/红/绿前景、黄空洞、品红种子(6)，背景黑。

    输出: 仅对被对角反射射线命中的黄空洞做对称修复，修复色来自其四点轨道中出现的非黄前景色。

    算法: 1) 根据种子识别射线路径（碰到边界反射）；
    2) 对每个黄像素判断是否在路径集合中；
    3) 命中则按反射轨道取行号最小的非黄颜色，否则保持不变。

    复杂度: O(H*W)。
    \"\"\"
    g = np.array(grid, dtype=int, copy=True)
    h, w = g.shape

    seed_info = _parse_seed(g)
    if seed_info is None:
        return g
    start, (dr, dc) = seed_info

    path = _simulate_ray(h, w, start, dr, dc)
    if not path:
        return g

    for r, c in zip(*np.where(g == 4)):
        if (int(r), int(c)) not in path:
            continue
        orbit = [
            (r, c),
            (r, w - 1 - c),
            (h - 1 - r, c),
            (h - 1 - r, w - 1 - c)
        ]
        candidates = []
        for rr, cc in orbit:
            v = int(g[rr, cc])
            if v not in (0, 4, 6):
                candidates.append((rr, v))
        if not candidates:
            continue
        # 行号最小优先
        chosen = min(candidates, key=lambda x: x[0])[1]
        g[r, c] = chosen

    return g
