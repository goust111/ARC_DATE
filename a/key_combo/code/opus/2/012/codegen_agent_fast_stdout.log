    31	def _is_rect_frame(cells):
    32	    rs = [p[0] for p in cells]
    33	    cs = [p[1] for p in cells]
    34	    r0, r1 = min(rs), max(rs)
    35	    c0, c1 = min(cs), max(cs)
    36	    area = (r1 - r0 + 1) * (c1 - c0 + 1)
    37	    if area < 16:
    38	        return None
    39	    border = []
    40	    for r, c in cells:
    41	        if r in (r0, r1) or c in (c0, c1):
    42	            border.append((r, c))
    43	    if len(border) != len(set(border)):
    44	        return None
    45	    # 外框厚度必须为1，且框线颜色必须连通且完整
    46	    if len(border) != 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4:
    47	        return None
    48	    return (r0, r1, c0, c1)
