        except Exception as e:
            ok=False; why=str(e); break
        if time.time()-t0>2.0:
            ok=False; why='timeout'; break
        seen.add(hashlib.sha256(inp.tobytes()).hexdigest())

    if not ok:
        print(f'{i}.py FAIL {why}')
    else:
        print(f'{i}.py OK variants={len(seen)}')
