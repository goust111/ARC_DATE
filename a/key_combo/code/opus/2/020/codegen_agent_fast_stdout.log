import numpy as np
from collections import deque, defaultdict


def _regions(g):
    H, W = g.shape
    passable = (g != 6) & (np.arange(H)[:, None] != 0) & (np.arange(H)[:, None] != H - 1)
    rid = np.full((H, W), -1, dtype=int)
    comps = {}
    cid = 0
    for r in range(1, H - 1):
        for c in range(W):
            if not passable[r, c] or rid[r, c] != -1:
                continue
            q = deque([(r, c)])
            rid[r, c] = cid
            cells = [(r, c)]
            while q:
                y, x = q.popleft()
                for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                    ny, nx = y + dr, x + dc
                    if 0 <= ny < H and 0 <= nx < W and passable[ny, nx] and rid[ny, nx] == -1:
                        rid[ny, nx] = cid
                        q.append((ny, nx))
                        cells.append((ny, nx))
            comps[cid] = cells
            cid += 1
    return rid, comps


def main(grid):
    """
    Task:
    Bipartite color regions split by magenta walls and extend green markers inward.

    Input:
    Top blue row and bottom red row are fixed boundary bars; black regions are separated by walls.

    Algorithm:
    1) Color black components by checker coloring across wall adjacency.
    2) Replace black background with region alternating colors 5 and 4.
    3) For each green control, paint its nearest direction-adjacent cell with the control'"'s region color.

    Return:
    Grid with preserved borders, walls, control color and extended marker colors.
    \"\"\"
    g = np.array(grid, dtype=int)
    out = g.copy()
    H, W = g.shape
    rid, comps = _regions(g)
    n = len(comps)
    if n == 0:
        return out

    # build adjacency graph across wall cells
    graph = defaultdict(set)
    for r in range(H):
        for c in range(W):
            if g[r, c] "'!= 6:
                continue
            neigh = []
            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and rid[nr, nc] != -1:
                    neigh.append(rid[nr, nc])
            for i in range(len(neigh)):
                for j in range(i + 1, len(neigh)):
                    a, b = neigh[i], neigh[j]
                    if a != b:
                        graph[a].add(b)
                        graph[b].add(a)

    color_by_region = {}
    start_pos = (H - 2, 1)
    # find region containing lower-left inside cell
    sid = rid[start_pos]
    if sid == -1:
        sid = 0
    dq = deque([sid])
    color_by_region[sid] = 0
    while dq:
        u = dq.popleft()
        cu = color_by_region[u]
        for v in graph[u]:
            if v not in color_by_region:
                color_by_region[v] = 1 - cu
                dq.append(v)

    for ridx, cells in comps.items():
        col = 5 if color_by_region.get(ridx, 0) == 0 else 4
        for r, c in cells:
            if g[r, c] == 0:
                out[r, c] = col

    # controls
    for r, c in np.argwhere(g == 3):
        r = int(r); c = int(c)
        dist_top = r
        dist_bottom = (H - 1) - r
        if dist_top < dist_bottom:
            tr, tc = r - 1, c
        else:
            tr, tc = r + 1, c
        if 0 <= tr < H and 0 <= tc < W and g[tr, tc] != 6:
            out[r, c] = 3
            rg = int(rid[r, c])
            paint = 5 if color_by_region.get(rg, 0) == 0 else 4
            if g[tr, tc] != 1 and g[tr, tc] != 2 and (g[tr, tc] != 6):
                out[tr, tc] = paint

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 31 + 9
    rng = np.random.default_rng(seed)

    H = 15
    W = 15
    while True:
        g = np.zeros((H, W), dtype=int)
        g[0, :] = 1
        g[H - 1, :] = 2

        # 1-2 horizontal and 1 vertical walls (for 4-6 regions)
        h_lines = sorted(set(int(rng.integers(3, H - 3)) for _ in range(1)))
        v_lines = sorted(set(int(rng.integers(3, W - 3)) for _ in range(1)))

        for r in h_lines:
            g[r, 1:W - 1] = 6
        for c in v_lines:
            g[1:H - 1, c] = 6

        rid, comps = _regions(g)
        if len(comps) < 3 or len(comps) > 6:
            continue

        # place 2-4 controls in distinct regions if possible
        region_cells = [cells for _, cells in comps.items()]
        cells_by_region = list(range(len(region_cells)))
        rng.shuffle(cells_by_region)
        n_ctrl = int(rng.integers(2, 5))
        if n_ctrl > len(region_cells):
            n_ctrl = len(region_cells)
        placed = 0
        for rr in cells_by_region[:n_ctrl]:
            r, c = region_cells[rr][0]
            if g[r, c] == 0 and abs((r) - ((H - 1) / 2)) > 0.001:
                # non-equidistant from top and bottom
                if r != (H - 1) / 2:
                    g[r, c] = 3
                    placed += 1

        # guarantee distance inequality and uniqueness count
        controls = [tuple(x) for x in np.argwhere(g == 3)]
        if len(controls) < 2:
            continue
        ok = True
        for r, c in controls:
            if r == (H - 1) / 2:
                ok = False
        if not ok:
            continue

        # ensure at least one control in each of at least 2 regions
        used_regions = set(int(rid[r, c]) for r, c in controls)
        if len(used_regions) < 2:
            continue

        return g.astype(int)

