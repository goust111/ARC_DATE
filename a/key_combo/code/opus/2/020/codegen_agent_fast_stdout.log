import numpy as np
from collections import defaultdict, deque


def _tile_layout(grid):
    h, w = grid.shape
    row_sep = [r for r in range(h) if np.all(grid[r] == 5)]
    col_sep = [c for c in range(w) if np.all(grid[:, c] == 5)]
    if len(row_sep) < 4 or len(col_sep) < 4:
        return None
    tile_h = row_sep[0]
    tile_w = col_sep[0]
    rows = [r - tile_h for r in row_sep[:4]]
    cols = [c - tile_w for c in col_sep[:4]]
    return tile_h, tile_w, rows, cols


def _move_point(g, pos, drow, dcol, trs, tcs):
    r, c = pos
    r0 = trs
    c0 = tcs
    while True:
        nr, nc = r + drow, c + dcol
        if not (r0 <= nr < r0 + 3 and c0 <= nc < c0 + 3):
            break
        if g[nr, nc] != 0:
            break
        r, c = nr, nc
    return r, c


def main(grid):
    """
    Task:
    Decode gravity direction from the legend tile and slide endpoints in each tile.

    Input:
    Grid is partitioned by gray separators into a 4x4 field of 3x3 tiles.

    Algorithm:
    1) Detect legend in the top-left tile (two cherry pixels), derive direction D.
    2) For every colored endpoint in normal tiles, slide it along D until boundary/obstacle.
    3) Connect same-color endpoints sharing the same subcell position in one tile row/column.

    Return:
    4x4 interior with transformed endpoints and unchanged legend/separators.
    """
    g = np.array(grid, dtype=int)
    out = g.copy()

    layout = _tile_layout(out)
    if layout is None:
        return out
    tile_h, tile_w, tile_rows, tile_cols = layout
    # decode direction from top-left tile legend
    tr0, tc0 = tile_rows[0], tile_cols[0]
    center = (tr0 + 1, tc0 + 1)
    neigh = [(-1, 0), (1, 0), (0, -1), (0, 1)]
    drow = dcol = 0
    for dr, dc in neigh:
        rr, cc = center[0] + dr, center[1] + dc
        if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1] and out[rr, cc] == 9:
            drow, dcol = dr, dc
            break

    endpoints = []
    for ti, tr in enumerate(tile_rows):
        for tj, tc in enumerate(tile_cols):
            if ti == 0 and tj == 0:
                continue
            block = out[tr:tr + tile_h, tc:tc + tile_w]
            if block.size == 0:
                continue
            found = np.argwhere(np.logical_and(block != 0, block != 5))
            if found.size == 0:
                continue
            rloc, cloc = found[0]
            color = block[rloc, cloc]
            sr, sc = tr + rloc, tc + cloc
            nr, nc = _move_point(out, (sr, sc), drow, dcol, tr, tc)
            if (nr, nc) != (sr, sc):
                out[sr, sc] = 0
            # overwrite after full move
            if out[nr, nc] == 0:
                out[nr, nc] = color
            else:
                out[nr, nc] = color
            endpoints.append((color, rloc, cloc, ti, tj, nr, nc))

    groups = defaultdict(list)
    for color, rl, cl, ti, tj, nr, nc in endpoints:
        groups[(int(color), int(rl), int(cl))].append((ti, tj, nr, nc))

    for (color, sub_r, sub_c), items in groups.items():
        by_row = defaultdict(list)
        by_col = defaultdict(list)
        for ti, tj, nr, nc in items:
            by_row[ti].append((tj, nc))
            by_col[tj].append((ti, nr))

        for ti, lst in by_row.items():
            if len(lst) < 2:
                continue
            lst = sorted(lst)
            for a, b in zip(lst[:-1], lst[1:]):
                t1, c1 = a
                t2, c2 = b
                for tc_mid in range(min(t1, t2) + 1, max(t1, t2)):
                    rr = tile_rows[ti] + sub_r
                    cc = tile_cols[tc_mid] + sub_c
                    out[rr, cc] = color

        for tj, lst in by_col.items():
            if len(lst) < 2:
                continue
            lst = sorted(lst)
            for a, b in zip(lst[:-1], lst[1:]):
                r1, x1 = a
                r2, x2 = b
                for tr_mid in range(min(r1, r2) + 1, max(r1, r2)):
                    rr = tile_rows[tr_mid] + sub_r
                    cc = tile_cols[tj] + sub_c
                    out[rr, cc] = color

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 97 + 19
    rng = np.random.default_rng(seed)

    g = np.zeros((17, 17), dtype=int)
    tile_h = tile_w = 3
    # separators
    for idx in range(1, 4):
        r = idx * 4 - 1
        c = idx * 4 - 1
        g[r, :] = 5
        g[:, c] = 5

    # direction legend in top-left tile
    d_opts = [(0, 1), (0, -1), (1, 0), (-1, 0)]
    drow, dcol = d_opts[rng.integers(0, 4)]
    g[1, 1] = 9
    g[1 + drow, 1 + dcol] = 9

    colors = [1, 2, 3]
    tile_indices = [i for i in range(16) if i != 0]
    tile_to_pos = [(i // 4, i % 4) for i in tile_indices]

    # enforce same-subcell pairs for each color
    assignments = {}
    for color in colors:
        pair_row = int(rng.integers(0, 4))
        c1, c2 = rng.choice(range(4), 2, replace=False)
        sub_r = int(rng.integers(0, 3))
        sub_c = int(rng.integers(0, 3))
        idx = pair_row * 4 + c1
        assignments[idx] = (color, sub_r, sub_c)
        idx2 = pair_row * 4 + c2
        assignments[idx2] = (color, sub_r, sub_c)
        # optional extra copies of color
        extra = int(rng.integers(0, 2))
        remaining = [i for i in tile_indices if i not in assignments]
        if extra > 0 and remaining:
            pick = int(rng.choice(remaining))
            sr = int(rng.integers(0, 3))
            sc = int(rng.integers(0, 3))
            assignments[pick] = (color, sr, sc)

    for idx in tile_indices:
        tr = idx // 4
        tc = idx % 4
        tr0 = tr * 4
        tc0 = tc * 4
        if idx in assignments:
            color, sr, sc = assignments[idx]
            g[tr0 + sr, tc0 + sc] = color
        else:
            # remain blank
            pass

    # add remaining colored points with controlled constraints
    occupied = set(zip(*np.where(g != 0)))
    for color in colors:
        assigned = [i for i, v in assignments.items() if v[0] == color]
        for i in tile_indices:
            if i in assigned:
                continue
            if len(assigned) >= 4:
                continue
            if rng.random() < 0.2:
                tr = i // 4
                tc = i % 4
                tr0 = tr * 4
                tc0 = tc * 4
                rr = tr0 + int(rng.integers(0, 3))
                cc = tc0 + int(rng.integers(0, 3))
                if g[rr, cc] == 0:
                    g[rr, cc] = color
                    assigned.append(i)

    return g.astype(int)

