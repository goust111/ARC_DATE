                marker_n = marker_n + 1 if marker_n < 6 else marker_n - 1

            # draw frame
            grid[r1, c1 : c2 + 1] = color
            grid[r2, c1 : c2 + 1] = color
            grid[r1 : r2 + 1, c1] = color
            grid[r1 : r2 + 1, c2] = color
