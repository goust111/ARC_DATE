    # lower three tiles in one row
    shape = np.array([[2, 1, 2], [1, 2, 1], [2, 1, 2]], dtype=int)
    # choose color mapping for source and target
    if rng.random() < 0.5:
        c_a, c_b = 1, 2
        c_c, c_d = 3, 4
    else:
        c_a, c_b = 2, 1
        c_c, c_d = 4, 3

    tile_a = np.where(shape == 1, c_a, c_b)
    perm = rng.choice([0, 1])
    if perm == 1:
        tile_b = np.where(shape == 1, c_c, c_d)
    else:
        tile_b = np.where(shape == 1, c_d, c_c)

    # third different tile
    tile_c = np.zeros((3, 3), dtype=int)
    cnt = 0
    while cnt < 5:
        tile_c = rng.integers(0, 5, size=(3, 3))
        tile_c[tile_c == 0] = 6
        if not np.array_equal(tile_c, tile_a) and not np.array_equal(tile_c, tile_b):
            cnt += 1
            break

    # maybe swap pair ordering and place
    row0 = top_h + 1
    if rng.random() < 0.5:
        g[row0:row0 + 3, 0:3] = tile_a
        g[row0:row0 + 3, 4:7] = tile_b
        g[row0:row0 + 3, 8:11] = tile_c
    else:
        g[row0:row0 + 3, 0:3] = tile_b
        g[row0:row0 + 3, 4:7] = tile_a
        g[row0:row0 + 3, 8:11] = tile_c

    return g.astype(int)

