import numpy as np
from itertools import product


def _decode_dir(legend):
    positions = np.argwhere(legend == 4)
    if len(positions) == 0:
        return (0, 1)
    y, x = positions[0]
    cy, cx = 1, 1
    return int(y - cy), int(x - cx)


def _simulate_slide(block, template, positions, drow, dcol):
    h = block.shape[0]
    w = block.shape[1]
    temp = block.copy()
    # deterministic order
    if drow == 0:
        rows = range(h)
        cols = range(w - 1, -1, -1) if dcol == 1 else range(w)
        order = [(r, c) for r in rows for c in cols]
    else:
        cols = range(w)
        rows = range(h - 1, -1, -1) if drow == 1 else range(h)
        order = [(r, c) for c in cols for r in rows]

    for r, c in order:
        color = template[r, c]
        if color == 0:
            continue
        if (r, c) not in positions:
            continue
        rr, cc = r, c
        while True:
            nr, nc = rr + drow, cc + dcol
            if not (0 <= nr < h and 0 <= nc < w):
                break
            if temp[nr, nc] != 0:
                break
            rr, cc = nr, nc
        temp[rr, cc] = color
    return temp


def main(grid):
    """
    Task:
    Fill missing pixels by deriving both template-diff set and sliding direction.

    Input:
    Top area: 5x5 template and direction legend above a magenta separator row.
    Bottom area: multiple incomplete copies of the template.

    Algorithm:
    1) Decode direction D from legend.
    2) Detect missing pixels as template-nonzero but copy-zero.
    3) Slide each missing pixel along D with collision-stop.
    4) Keep separator, template, and legend unchanged.

    Return:
    Transformed full grid with same shape.
    """
    g = np.array(grid, dtype=int)
    out = g.copy()
    h, w = out.shape

    sep_rows = [i for i in range(h) if np.all(out[i] == 6)]
    if not sep_rows:
        return out
    sep = sep_rows[0]
    top = out[:sep]
    bottom = out[sep + 1 :]
    if bottom.size == 0:
        return out

    template = top[:5, :5]
    # locate legend
    legend = (slice(0, 3), slice(6, 9))
    lg = top[legend[0], legend[1]]
    if lg.shape == (3, 3):
        drow, dcol = _decode_dir(lg)
    else:
        drow, dcol = (0, 1)

    rows_nonzero = np.any(bottom != 0, axis=1)
    if not np.any(rows_nonzero):
        return out
    start_r = int(np.where(rows_nonzero)[0][0])
    start_r = max(start_r, 0)

    template_mask = template != 0
    missing_positions_by_copy = {}

    for sc in [0, 7, 14]:
        if sc + 5 > bottom.shape[1] or start_r + 5 > bottom.shape[0]:
            continue
        block = bottom[start_r:start_r + 5, sc:sc + 5]
        if not np.any(template_mask & (block != 0)):
            continue
        missing = {(r, c) for r, c in np.argwhere(np.logical_and(template_mask, block == 0))}
        if not missing:
            continue

        moved = _simulate_slide(block.copy(), template, missing, drow, dcol)
        # keep only non-zero moves inside empty spaces already checked
        bottom[start_r:start_r + 5, sc:sc + 5] = moved

    out[sep + 1 :, :] = bottom
    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 29 + 11
    rng = np.random.default_rng(seed)

    g = np.zeros((15, 21), dtype=int)
    # build top area
    # template
    template = np.zeros((5, 5), dtype=int)
    start = (2, 2)
    cells = {(start[0], start[1])}
    target_n = int(rng.integers(8, 13))
    while len(cells) < target_n:
        y, x = rng.integers(0, 5), rng.integers(0, 5)
        if rng.random() < 0.3:
            continue
        if (y, x) in cells:
            continue
        if abs(y - start[0]) + abs(x - start[1]) == 1:
            pass
        # force connectivity by growing from existing
        nbrs = [(yy + 1, xx), (yy - 1, xx), (yy, xx + 1), (yy, xx - 1)]
        yy = int(rng.integers(0, 5)); xx = int(rng.integers(0, 5))
        
        attempts = 0
        while attempts < 20:
            attempts += 1
            yy = int(rng.integers(0, 5))
            xx = int(rng.integers(0, 5))
            if (yy, xx) in cells:
                continue
            found = False
            for py, px in ((yy + 1, xx), (yy - 1, xx), (yy, xx + 1), (yy, xx - 1)):
                if 0 <= py < 5 and 0 <= px < 5 and (py, px) in cells:
                    found = True
                    break
            if found:
                cells.add((yy, xx))
                break

    # simple random paint
    template = np.zeros((5, 5), dtype=int)
    if cells:
        cells_list = list(cells)
        for (yy, xx) in cells_list:
            template[yy, xx] = int(rng.choice([1, 2]))
    if np.random.default_rng(seed).integers(0, 2):
        template = np.ones((5, 5), dtype=int)

    # ensure 8-14 non-zero connected-ish
    if template.sum() == 0:
        yy = xx = 2
        for _ in range(10):
            template[yy, xx] = int(rng.integers(1, 3))
            yy, xx = min(4, max(0, yy + int(rng.choice([-1, 0, 1])))), min(4, max(0, xx + int(rng.choice([-1, 0, 1]))))

    g[:5, :5] = template

    # legend
    g[0:3, 6:9] = 6
    g[1 + 1, 7] = 0
    d_list = [(0, 1), (0, -1), (1, 0), (-1, 0)]
    drow, dcol = d_list[int(rng.integers(0, 4))]
    y0, x0 = 1, 1
    g[1, 1] = 0
    gy, gx = y0 + drow, x0 + dcol
    if 0 <= gy < 3 and 0 <= gx < 3:
        g[gy, gx] = 4

    # ensure all non-template rows are black

    sep_row = 8
    g[sep_row, :] = 6

    # copies
    n_copies = int(rng.integers(2, 4))
    copy_starts = [0, 7, 14][:n_copies]

    def slide_missing(copy_block, miss_pos, drow, dcol):
        h, w = copy_block.shape
        res = copy_block.copy()
        if drow == 0:
            rows = range(h)
            cols = range(w - 1, -1, -1) if dcol == 1 else range(w)
            order = [(r, c) for r in rows for c in cols]
        else:
            cols = range(w)
            rows = range(h - 1, -1, -1) if drow == 1 else range(h)
            order = [(r, c) for c in cols for r in rows]

        for r, c in order:
            if (r, c) not in miss_pos:
                continue
            color = template[r, c]
            rr, cc = r, c
            while True:
                nr, nc = rr + drow, cc + dcol
                if not (0 <= nr < h and 0 <= nc < w):
                    break
                if res[nr, nc] != 0:
                    break
                rr, cc = nr, nc
            res[rr, cc] = color
        return res

    for sc in copy_starts:
        block = template.copy()
        template_cells = np.argwhere(template != 0)
        max_missing = min(4, len(template_cells))
        miss_n = int(rng.integers(2, max_missing + 1))
        miss_idx = rng.choice(len(template_cells), size=miss_n, replace=False)
        miss_pos = {tuple(template_cells[i]) for i in miss_idx}
        for (r, c) in miss_pos:
            block[r, c] = 0

        # ensure at least valid along direction by simulation loop
        attempts = 0
        while attempts < 20:
            attempts += 1
            moved = slide_missing(block.copy(), miss_pos, drow, dcol)
            good = True
            for (r, c) in miss_pos:
                color = template[r, c]
                # if impossible overlap would imply no space
                if color == 0:
                    continue
            if good:
                break
        g[sep_row + 1 : sep_row + 6, sc : sc + 5] = moved

    return g.astype(int)

