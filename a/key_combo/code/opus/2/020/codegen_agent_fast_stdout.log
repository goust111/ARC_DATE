            inner_h, inner_w = ih, iw
            target = parity if parity in (0, 1) else rng.integers(0, 2)
            if not (0 <= target <= 1):
                target = 0
            marker_n = int(2 + rng.integers(0, 5))
            if marker_n % 2 "'!= target:
                marker_n += 1
                if marker_n > 6:
                    marker_n -= 2
            if marker_n < 2:
                marker_n = 2

            attempts = 0
            while attempts < 50:
                attempts += 1
                candidate = grid.copy()
                candidate[r0:r2 + 1, c0:c2 + 1] = 0
                rr = r0
                cc = c0
                # frame border
                candidate[r0, c0:c2 + 1] = color
                candidate[r2, c0:c2 + 1] = color
                candidate[r0:r2 + 1, c0] = color
                candidate[r0:r2 + 1, c2] = color

                # orange sprite 4-neigh walk
                ih0 = np.zeros((inner_h, inner_w), dtype=bool)
                sr = int(rng.integers(0, inner_h))
                sc = int(rng.integers(0, inner_w))
                ih0[sr, sc] = True
                step = int(rng.integers(3, 6))
                while ih0.sum() < step:
                    tr, tc = int(rng.integers(0, inner_h)), int(rng.integers(0, inner_w))
                    for __ in range(10):
                        dr, dc = rng.choice([-1, 0, 1]), rng.choice([-1, 0, 1])
                        if abs(dr) + abs(dc) != 1:
                            continue
                        nr, nc = tr + dr, tc + dc
                        if 0 <= nr < inner_h and 0 <= nc < inner_w and not ih0[nr, nc]:
                            tr, tc = nr, nc
                            ih0[tr, tc] = True
                            break
                    else:
                        break
                    if ih0.sum() >= step:
                        break
                rrp, ccp = np.where(ih0)
                sprite_cells = list(zip(rrp, ccp))
                sprite_len = len(sprite_cells)
                if sprite_len < 3:
                    continue

                # markers
                all_inside = [(rr + 1 + r, cc + 1 + c) for r in range(inner_h) for c in range(inner_w)]
                forbidden = set((r0 + 1 + sr, c0 + 1 + sc) for sr, sc in sprite_cells)
                candidates = [p for p in all_inside if p not in forbidden]
                if len(candidates) < marker_n:
                    continue
                rng.shuffle(candidates)
                markers = candidates[:marker_n]
                mset = set(markers)
                # mirror condition and odd/even check
                tmp = candidate.copy()
                inner = tmp[r0 + 1:r2, c0 + 1:c2]
                orange = np.zeros(inner.shape, dtype=bool)
                for sr, sc in sprite_cells:
                    orange[sr, sc] = True
                mirror = np.zeros_like(orange)
                for rrp, ccp in sprite_cells:
                    if marker_n % 2 == 1:
                        mcp = _mirror_map(ccp, 0, inner_w - 1)
                        mr, mc = rrp, mcp
                    else:
                        mrp = _mirror_map(rrp, 0, inner_h - 1)
                        mr, mc = mrp, ccp
                    mirror[mr, mc] = True
                both = orange | mirror
                inside_markers = [(r, c) for r, c in mset if both[r - (r0 + 1), c - (c0 + 1)]]
                if not inside_markers:
                    continue
                if len(inside_markers) == marker_n:
                    continue

                tmp = candidate.copy()
                for mrk in mset:
                    tmp[mrk] = 5
                for sr, sc in sprite_cells:
                    tmp[r0 + 1 + sr, c0 + 1 + sc] = 7
                candidate = tmp

                placed.append((r1, r2, c1, c2))
                grid = candidate
                # finalize frame body now
                out_inner = grid[r0 + 1:r2, c0 + 1:c2]
                # ensure markers count fixed
                for mrk in markers:
                    out_inner[mrk[0] - (r0 + 1), mrk[1] - (c0 + 1)] = 5
                break

            if attempts < 50:
                ok = True
                break

        if not ok:
            # fallback deterministic simple frame
            ih = 7
            iw = 8
            rh, rw = ih + 2, iw + 2
            r0 = 2 + idx * 9
            c0 = 2
            r1, r2 = r0, r0 + rh - 1
            c1, c2 = c0, c0 + rw - 1
            grid[r0:r2 + 1, c0:c2 + 1] = 0
            grid[r0, c0:c2 + 1] = color
            grid[r2, c0:c2 + 1] = color
            grid[r0:r2 + 1, c0] = color
            grid[r0:r2 + 1, c2] = color
