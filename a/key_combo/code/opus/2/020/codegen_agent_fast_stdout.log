import numpy as np
from collections import deque, defaultdict


def _regions(g):
    H, W = g.shape
    rid = np.full((H, W), -1, dtype=int)
    comps = {}
    cid = 0
    for r in range(H):
        for c in range(W):
            if g[r, c] == 2 or rid[r, c] "'!= -1:
                continue
            q = deque([(r, c)])
            rid[r, c] = cid
            comps[cid] = []
            while q:
                y, x = q.popleft()
                comps[cid].append((y, x))
                for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                    ny, nx = y + dr, x + dc
                    if 0 <= ny < H and 0 <= nx < W and g[ny, nx] != 2 and rid[ny, nx] == -1:
                        rid[ny, nx] = cid
                        q.append((ny, nx))
            cid += 1
    return rid, comps


def main(grid):
    """
    Task:
    Alternate-color regions split by red walls and color rays at their intersections.

    Input:
    Red walls, black background and blue control pixels.

    Algorithm:
    1) Bipartite-color each region by wall adjacency.
    2) Build ray coverage from each control (full row and full column).
    3) Recolor non-wall pixels based on region side and coverage.

    Return:
    Recolored grid with controls set to 4.
    """
    g = np.array(grid, dtype=int)
    out = g.copy()
    H, W = g.shape
    rid, comps = _regions(g)
    if not comps:
        return out

    graph = defaultdict(set)
    for r in range(H):
        for c in range(W):
            if g[r, c] != 2:
                continue
            neigh = []
            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and rid[nr, nc] != -1:
                    neigh.append(rid[nr, nc])
            for i in range(len(neigh)):
                for j in range(i + 1, len(neigh)):
                    a, b = neigh[i], neigh[j]
                    if a != b:
                        graph[a].add(b)
                        graph[b].add(a)

    start = rid[H - 1, 0]
    if start == -1:
        start = next(iter(comps.keys()))

    color_side = {}
    dq = deque([start])
    color_side[start] = 5  # encode gray side with value 5
    while dq:
        u = dq.popleft()
        for v in graph[u]:
            if v not in color_side:
                color_side[v] = 3 if color_side[u] == 5 else 5
                dq.append(v)

    for r, c in np.argwhere(g == 1):
        color_side[int(rid[r, c])] = 5 if color_side.get(int(rid[r, c]), 5) else 5

    rows = sorted(set(int(r) for r, c in np.argwhere(g == 1)))
    cols = sorted(set(int(c) for r, c in np.argwhere(g == 1)))

    for r in range(H):
        for c in range(W):
            if g[r, c] == 2:
                continue
            if g[r, c] == 1:
                out[r, c] = 4
                continue
            covered = (r in rows) or (c in cols)
            side = color_side.get(int(rid[r, c]), 5)
            if covered:
                out[r, c] = 7 if side == 5 else 6
            else:
                out[r, c] = side

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 11 + 53
    rng = np.random.default_rng(seed)

    H = 15
    W = 15
    while True:
        g = np.zeros((H, W), dtype=int)

        hr = int(rng.integers(4, 11))
        vc = int(rng.integers(4, 11))

        g[hr, 1:W - 1] = 2
        g[1:H - 1, vc] = 2

        # ensure 4-7 regions and connectedness not broken too badly
        rid, comps = _regions(g)
        if len(comps) < 4 or len(comps) > 7:
            continue

        # place 2-3 controls in random non-wall cells of distinct regions
        region_cells = {rid_i: [] for rid_i in comps}
        for rid_i, cells in comps.items():
            region_cells[rid_i] = cells
        keys = list(region_cells.keys())
        rng.shuffle(keys)
        n_ctrl = int(rng.integers(2, 4))
        n_ctrl = min(n_ctrl, len(keys))
        used = 0
        for k in keys[:n_ctrl]:
            r, c = region_cells[k][0]
            if g[r, c] == 0:
                g[r, c] = 1
                used += 1

        if used < 2:
            continue

        # coverage needs at least two regions crossed
        rows = set(int(r) for r, c in np.argwhere(g == 1))
        cols = set(int(c) for r, c in np.argwhere(g == 1))
        if not rows and not cols:
            continue
        touched_regions = set()
        for r in rows:
            for c in range(W):
                if g[r, c] != 2:
                    touched_regions.add(rid[r, c])
        for c in cols:
            for r in range(H):
                if g[r, c] != 2:
                    touched_regions.add(rid[r, c])
        if len(touched_regions) < 2:
            continue

        return g.astype(int)

