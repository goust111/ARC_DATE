                best = (fr, fc)
                best_d = d
                best_i = i
                best_r = fr
                best_c = fc
        counts[best_i] += 1

    order = sorted(range(len(frames)), key=lambda i: (counts[i], i))
    rank = {idx: k + 1 for k, idx in enumerate(order)}
    palette = {1: 1, 2: 2, 3: 3, 4: 4, 5: 7}

    for i, (r, c, col) in enumerate(frames):
        rr = i + 1
        rc = palette.get(rank[i], 7)
