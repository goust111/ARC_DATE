    for y in range(top_h):
        for x in range(top_w):
            if rng.random() < 0.16:
                top[y, x] = 2
    g[:top_h, :] = top

    sep = top_h
    g[sep, :] = 6

    # shape and pair colors
    shape = np.array(
        [[1, 2, 1],
         [2, 1, 2],
         [1, 2, 1]],
        dtype=int,
    )
    if rng.random() < 0.5:
        src_colors = (1, 2)
        dst_colors = (3, 4)
    else:
        src_colors = (1, 2)
        dst_colors = (4, 3)

