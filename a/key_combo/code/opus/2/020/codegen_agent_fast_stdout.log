import importlib.util, os, sys, traceback, numpy as np
base='/home/lixinyu/snap/a/key_combo/code/opus/2/020'
files=[os.path.join(base,f'{i}.py') for i in range(1,11)]

print('compile checks:')
for p in files:
    try:
        compile(open(p,'r',encoding='utf-8').read(), p, 'exec')
        print(os.path.basename(p), 'py_compile: ok')
    except Exception as e:
        print(os.path.basename(p), 'py_compile: FAIL', repr(e))

print('\\nrun checks:')
for p in files:
    name=os.path.basename(p)
    spec=importlib.util.spec_from_file_location('m',p)
    m=importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(m)
    except Exception as e:
        print(f\"{name} import error: {e}\")
        traceback.print_exc()
        continue
    ok=0; shapes_ok=0; errs=[]
    for i in range(100):
        try:
            g=m.generate_input(0,i)
        except Exception as e:
            errs.append(f'gen {i} err {e}')
            break
        if not isinstance(g,np.ndarray):
            errs.append('not ndarray')
            break
        if g.ndim"'!=2 or max(g.shape)>30:
            errs.append(f'"'bad input shape {g.shape}')
            break
        try:
            out=m.main(g)
        except Exception as e:
            errs.append(f'main {i} err {e}')
            break
        ok+=1
        if isinstance(out,np.ndarray) and out.ndim==2:
            shapes_ok+=1
        else:
            errs.append('out bad')
            break

    vouts=[]
    for i in range(20):
        vouts.append(bytes(m.generate_input(0,i).tobytes()))
    distinct=len(set(vouts))

    if errs:
        print(f\"{name} check: FAIL {'; '.join(errs)}\")
    else:
        print(f\"{name} check: ok samples={ok} shapes_ok={shapes_ok} distinct_variants={distinct}\")
