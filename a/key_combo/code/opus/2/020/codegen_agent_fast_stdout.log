import numpy as np
from collections import deque


def _frame_list(g):
    frames = []
    for color in [c for c in np.unique(g) if c not in (0, 3, 5)]:
        ys, xs = np.where(g == color)
        if len(ys) == 0:
            continue
        r1, r2 = int(ys.min()), int(ys.max())
        c1, c2 = int(xs.min()), int(xs.max())
        if r2 - r1 < 2 or c2 - c1 < 2:
            continue
        if not (np.all(g[r1, c1:c2 + 1] == color) and np.all(g[r2, c1:c2 + 1] == color) and
                np.all(g[r1:r2 + 1, c1] == color) and np.all(g[r1:r2 + 1, c2] == color)):
            continue
        frames.append((r1, r2, c1, c2, int(color)))
    return frames


def _components(mask):
    H, W = mask.shape
    vis = np.full((H, W), -1, dtype=int)
    comps = []
    cid = 0
    for r in range(H):
        for c in range(W):
            if not mask[r, c] or vis[r, c] "'!= -1:
                continue
            q = deque([(r, c)])
            vis[r, c] = cid
            cells = []
            while q:
                y, x = q.popleft()
                cells.append((y, x))
                for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                    ny, nx = y + dr, x + dc
                    if 0 <= ny < H and 0 <= nx < W and mask[ny, nx] and vis[ny, nx] == -1:
                        vis[ny, nx] = cid
                        q.append((ny, nx))
            comps.append(cells)
            cid += 1
    return vis, comps


def main(grid):
    """
    Task:
    Bounce-stamp the green rectangle inside each frame with steps defined by marker count.

    Input:
    Several gray frames each containing gray markers and one green rectangle.

    Algorithm:
    1) For each frame, compute marker count N.
    2) Choose initial stamp direction from rectangle corner affinity.
    3) Repeatedly place a translated green rectangle N times, reflecting on boundary
       collisions with frame wall.

    Return:
    Updated grid with cumulative green stamp trail and preserved borders.
    """
    g = np.array(grid, dtype=int)
    out = g.copy()

    for r1, r2, c1, c2, color in _frame_list(out):
        inner_top, inner_bottom = r1 + 1, r2 - 1
        inner_left, inner_right = c1 + 1, c2 - 1
        inner = out[inner_top:inner_bottom + 1, inner_left:inner_right + 1]
        if inner.size == 0:
            continue

        gray_n = int(np.sum(inner == 5))
        if gray_n == 0:
            continue

        # mark green component
        vis, comps = _components(inner == 3)
        if not comps:
            continue
        comp = max(comps, key=len)
        rs = [p[0] for p in comp]
        cs = [p[1] for p in comp]
        sr1, sr2 = min(rs), max(rs)
        sc1, sc2 = min(cs), max(cs)
        gh, gw = sr2 - sr1 + 1, sc2 - sc1 + 1
        if gh == 0 or gw == 0:
            continue

        # map to global
        gr, gc = sr1 + inner_top, sc1 + inner_left

        corners = {
            '"'tl': (inner_top, inner_left),
            'tr': (inner_top, inner_right - gw + 1),
            'bl': (inner_bottom - gh + 1, inner_left),
            'br': (inner_bottom - gh + 1, inner_right - gw + 1),
        }
        cr, cc = inner_top + inner.shape[0] // 2, inner_left + inner.shape[1] // 2
        nearest = None
        md = None
        for k, (rr, cc0) in corners.items():
            d = abs(rr - (gr)) + abs(cc0 - gc)
            if md is None or d < md:
                md = d
                nearest = k

        if nearest == 'tl':
            dr, dc = gh, gw
        elif nearest == 'tr':
            dr, dc = gh, -gw
        elif nearest == 'bl':
            dr, dc = -gh, gw
        else:
            dr, dc = -gh, -gw

        cur_r, cur_c = gr, gc
        for _ in range(gray_n):
            tr, tc = cur_r + dr, cur_c + dc
            # collision handling with wall line
            if tr < inner_top or tr + gh - 1 > inner_bottom:
                dr *= -1
            if tc < inner_left or tc + gw - 1 > inner_right:
                dc *= -1
            tr, tc = cur_r + dr, cur_c + dc
            out[tr:tr + gh, tc:tc + gw] = 3
            cur_r, cur_c = tr, tc

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 41 + 3
    rng = np.random.default_rng(seed)

    H = 22
    W = 22
    g = np.zeros((H, W), dtype=int)

    n_frames = int(rng.integers(2, 4))
    frame_colors = [1, 2, 3, 4, 6, 9]
    rng.shuffle(frame_colors)

    boxes = []
    for i in range(n_frames):
        color = frame_colors[i]
        ih = int(rng.integers(8, 12))
        iw = int(rng.integers(8, 12))
        rh, rw = ih + 2, iw + 2
        for _ in range(200):
            r0 = int(rng.integers(0, H - rh))
            c0 = int(rng.integers(0, W - rw))
            r1, r2 = r0, r0 + rh - 1
            c1, c2 = c0, c0 + rw - 1
            conflict = False
            for a1, a2, b1, b2 in boxes:
                if not (r2 + 2 < a1 or a2 + 2 < r1 or c2 + 2 < b1 or b2 + 2 < c1):
                    conflict = True
            if conflict:
                continue
            g[r1:r2 + 1, c1:c2 + 1] = 0
            g[r1, c1:c2 + 1] = color
            g[r2, c1:c2 + 1] = color
            g[r1:r2 + 1, c1] = color
            g[r1:r2 + 1, c2] = color
            boxes.append((r1, r2, c1, c2))

            # markers 2-5 unique maybe
            count = int(rng.integers(2, 6))
            if i == 0:
                count = 2 + (int(variant) + i) % 4
            avail = [(r, c) for r in range(r1 + 1, r2) for c in range(c1 + 1, c2) if g[r, c] == 0]
            rng.shuffle(avail)
            for p in avail[:count]:
                g[p] = 5

            # green rectangle near a corner
            h = int(rng.integers(2, 4))
            w = int(rng.choice([2, 3]))
            corner = int(rng.integers(0, 4))
            if corner == 0:  # tl
                sr = r1 + 1 + int(rng.integers(0, 2))
                sc = c1 + 1 + int(rng.integers(0, 2))
            elif corner == 1:  # tr
                sr = r1 + 1 + int(rng.integers(0, 2))
                sc = c2 - w - int(rng.integers(0, 2))
            elif corner == 2:  # bl
                sr = r2 - h - int(rng.integers(0, 2))
                sc = c1 + 1 + int(rng.integers(0, 2))
            else:
                sr = r2 - h - int(rng.integers(0, 2))
                sc = c2 - w - int(rng.integers(0, 2))
            if sr < r1 + 1:
                sr = r1 + 1
            if sc < c1 + 1:
                sc = c1 + 1
            if sr + h > r2:
                sr = r2 - h
            if sc + w > c2:
                sc = c2 - w
            g[sr:sr + h, sc:sc + w] = 3

            break

    return g.astype(int)

