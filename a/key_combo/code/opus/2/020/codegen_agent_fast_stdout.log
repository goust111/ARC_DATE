import numpy as np
from collections import deque


def _find_frames(grid):
    frames = []
    colors = [int(c) for c in np.unique(grid) if c not in (0, 5, 7)]
    for color in colors:
        ys, xs = np.where(grid == color)
        if len(ys) == 0:
            continue
        r1, r2 = int(ys.min()), int(ys.max())
        c1, c2 = int(xs.min()), int(xs.max())
        if r2 - r1 < 2 or c2 - c1 < 2:
            continue
        if not np.all(grid[r1, c1:c2 + 1] == color):
            continue
        if not np.all(grid[r2, c1:c2 + 1] == color):
            continue
        if not np.all(grid[r1:r2 + 1, c1] == color):
            continue
        if not np.all(grid[r1:r2 + 1, c2] == color):
            continue
        frames.append((r1, r2, c1, c2))
    return frames


def _mirror_map(coord, lo, hi, odd=False):
    # coord in global coordinates, map across axis inside [lo, hi] inclusive
    size = hi - lo + 1
    rel = coord - lo
    return lo + (size - 1 - rel)


def main(grid):
    \"\"\"
    Task:
    Apply per-frame mirror, erase-and-recolor logic controlled by gray marker parity.

    Input:
    grid is an HxW integer array containing gray markers and orange sprites inside
    hollow single-color frames.

    Procedure:
    1) Detect each hollow frame (non-black, non-gray, non-orange single-pixel border).
    2) Compute gray marker count inside, choose mirror axis by parity, draw mirrored
       orange sprite copy while keeping original sprite.
    3) Erase any gray marker positions covered by orange.
    4) Recolor the whole frame border by remaining-gray parity (odd->4, even->9).

    Output:
    Return transformed grid as ndarray.
    \"\"\"
    g = np.array(grid, dtype=int)
    out = g.copy()
    h, w = out.shape

    for r1, r2, c1, c2 in _find_frames(out):
        ir1, ir2 = r1 + 1, r2
        jc1, jc2 = c1 + 1, c2
        inner = out[ir1:ir2, jc1:jc2]
        if inner.size == 0:
            continue

        markers = (inner == 5)
        N = int(markers.sum())
        odd = (N % 2 == 1)

        orange = (inner == 7)
        mirrored = np.zeros_like(orange)
        H, W = inner.shape
        ors = np.argwhere(orange)
        for rr, cc in ors:
            rrg = int(rr)
            ccg = int(cc)
            if odd:
                nc = _mirror_map(ccg, 0, W - 1)
                nr = rrg
            else:
                nr = _mirror_map(rrg, 0, H - 1)
                nc = ccg
            mirrored[nr, nc] = True

        both_orange = orange | mirrored
        for rr in range(H):
            for cc in range(W):
                if both_orange[rr, cc]:
                    inner[rr, cc] = 7
                elif markers[rr, cc]:
                    inner[rr, cc] = 5

        remaining = int(np.sum(inner == 5))
        color = 4 if (remaining % 2 == 1) else 9
        out[r1, c1:c2 + 1] = color
        out[r2, c1:c2 + 1] = color
        out[ir1:ir2, c1] = color
        out[ir1:ir2, c2] = color

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 37 + 17
    rng = np.random.default_rng(seed)

    h = 20 + int(rng.integers(0, 4))
    w = 20 + int(rng.integers(0, 4))
    grid = np.zeros((h, w), dtype=int)

    n_frames = int(rng.integers(2, 5))
    frame_colors = [1, 2, 3, 6, 9]
    rng.shuffle(frame_colors)
    frame_colors = frame_colors[:n_frames]

    min_h, max_h = 7, 12
    min_w, max_w = 7, 12
    placed = []

    def free_box(t, b, l, r):
        for pt in placed:
            pt1, pb1, pl1, pr1 = pt
            if not (b + 1 < pt1 - 1 or pb1 + 1 < t - 1 or r + 1 < pl1 - 1 or pr1 + 1 < l - 1):
                return False
        return True

    for idx, color in enumerate(frame_colors):
        ok = False
        parity = idx % 2  # enforce non-uniform parity mix
        for _ in range(200):
            ih = int(rng.integers(min_h, max_h))
            iw = int(rng.integers(min_w, max_w))
            rh, rw = ih + 2, iw + 2
            if rh + 2 > h or rw + 2 > w:
                continue
            r0 = int(rng.inteples(0, h - rh))
            c0 = int(rng.integers(0, w - rw))
