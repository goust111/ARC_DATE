import numpy as np


def _detect_frames(g):
    H, W = g.shape
    frames = []
    for r in range(H - 2):
        for c in range(W - 2):
            b = g[r:r + 3, c:c + 3]
            if b[1, 1] != 0:
                continue
            col = b[0, 0]
            if col == 0 or col == 5:
                continue
            if np.all(b[0, :] == col) and np.all(b[2, :] == col) and np.all(b[:, 0] == col) and np.all(b[:, 2] == col):
                if b[1, 0] == col and b[1, 2] == col:
                    continue
                # skip overlapping duplicate centers
                if not any(abs(r - rr) < 3 and abs(c - cc) < 3 for rr, cc, _ in frames):
                    frames.append((r + 1, c + 1, col))
    return frames


def main(grid):
    """
    Task:
    Count gray markers assigned to frames, rank frames, and recolor each 3x3 frame as cross.

    Input:
    Several 3x3 hollow colored frames plus gray markers.

    Algorithm:
    1) Assign each gray marker to nearest frame center with tie-breaking row then col.
    2) Sort frames by assigned marker count.
    3) Map rank to fixed color and paint a cross on frame area; erase all gray markers.

    Return:
    Final grid with recolored crosses.
    """
    g = np.array(grid, dtype=int)
    out = g.copy()

    frames = _detect_frames(out)
    centers = []
    for i, (r, c, color) in enumerate(frames):
        centers.append((i, r, c))

    counts = [0] * len(frames)
    for rr, cc in np.argwhere(g == 5):
        rr = int(rr); cc = int(cc)
        best_i = None
        best_d = None
        best_row = None
        best_col = None
        for i, fr, fc in centers:
            d = abs(rr - fr) + abs(cc - fc)
            if best_d is None or d < best_d or (d == best_d and (fr < best_row or (fr == best_row and fc < best_col))):
                best_d = d
                best_i = i
                best_row = fr
                best_col = fc
        if best_i is not None:
            counts[best_i] += 1

    # ranking
    order = sorted(range(len(frames)), key=lambda i: (counts[i], i))
    rank = {idx: pos + 1 for pos, idx in enumerate(order)}
    rank_color = {1: 1, 2: 2, 3: 3, 4: 4, 5: 7}

    for i, (r, c, _) in enumerate(frames):
        r0, c0 = r - 1, c - 1
        col = rank_color[rank[i]]
        # corners black, cross color
        out[r0 + 1, c0] = out[r0 + 1, c0 + 2] = 0
        out[r0, c0 + 1] = 0
        out[r0 + 2, c0 + 1] = 0
        out[r0, c0] = 0
        out[r0, c0 + 2] = 0
        out[r0 + 2, c0] = 0
        out[r0 + 2, c0 + 2] = 0
        out[r0 + 1, c0 + 1] = col
        out[r0, c0 + 1] = col
        out[r0 + 2, c0 + 1] = col
        out[r0 + 1, c0] = col
        out[r0 + 1, c0 + 2] = col

    out[g == 5] = 0
    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 51 + 23
    rng = np.random.default_rng(seed)

