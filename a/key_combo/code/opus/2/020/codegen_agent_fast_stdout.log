        for _ in range(400):
            r = int(rng.integers(1, H - 3))
            c = int(rng.integers(1, W - 3))
            # margin
            if used[max(0, r - 2):min(H, r + 5), max(0, c - 2):min(W, c + 5)].any():
                continue
            # draw 3x3 hollow frame color
            g[r, c:c + 3] = colors[idx]
            g[r + 2, c:c + 3] = colors[idx]
            g[r:r + 3, c] = colors[idx]
            g[r:r + 3, c + 2] = colors[idx]
            used[r:r + 3, c:c + 3] = True
            boxes.append((r + 1, c + 1))
            break

    boxes = boxes[:n_frames]
    # nearest owner for each cell
    centers = boxes
    owners = {}
    for rr in range(H):
        for cc in range(W):
            if g[rr, cc] != 0:
                continue
            best = None
            best_d = 10**9
            best_row = 10**9
            best_col = 10**9
            best_i = -1
            for i, (fr, fc) in enumerate(centers):
                d = abs(rr - fr) + abs(cc - fc)
                if d < best_d or (d == best_d and (fr < best_row or (fr == best_row and fc < best_col))):
                    best_d = d
                    best_row = fr
                    best_col = fc
                    best_i = i
            owners.setdefault(best_i, []).append((rr, cc))

    # unique marker counts
    counts = list(range(1, len(boxes) + 1))
    if len(counts) >= 2:
        rng.shuffle(counts)
    for i, (fr, fc) in enumerate(centers):
        k = counts[i] if i < len(counts) else 1
        cand = owners.get(i, [])
        if len(cand) < k:
            continue
        rng.shuffle(cand)
        for p in cand[:k]:
            g[p] = 5

    return g.astype(int)

