import numpy as np
from collections import deque, defaultdict


def _components(g):
    H, W = g.shape
    rid = np.full((H, W), -1, dtype=int)
    comps = {}
    cid = 0
    for r in range(1, H - 1):
        for c in range(W):
            if g[r, c] == 6 or g[r, c] == 1 or g[r, c] == 2 or rid[r, c] "'!= -1:
                continue
            q = deque([(r, c)])
            rid[r, c] = cid
            comps[cid] = []
            while q:
                y, x = q.popleft()
                comps[cid].append((y, x))
                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ny, nx = y + dy, x + dx
                    if 0 <= ny < H and 0 <= nx < W and g[ny, nx] != 6 and g[ny, nx] != 1 and g[ny, nx] != 2 and rid[ny, nx] == -1:
                        rid[ny, nx] = cid
                        q.append((ny, nx))
            cid += 1
    return rid, comps


def main(grid):
    """
    1) Find wall-separated regions between top blue and bottom red bars.
    2) Bipartite alternate-color each region with gray(5)/yellow(4).
    3) Replace nearest-direction target of each green control with its region color.
    4) Keep border bars and walls unchanged.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape
    out = g.copy()

    rid, comps = _components(g)
    if not comps:
        return out

    # build region adjacency across wall cells
    graph = defaultdict(set)
    for r in range(H):
        for c in range(W):
            if g[r, c] != 6:
                continue
            neigh = []
            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and rid[nr, nc] != -1:
                    neigh.append(rid[nr, nc])
            for i in range(len(neigh)):
                for j in range(i + 1, len(neigh)):
                    a, b = neigh[i], neigh[j]
                    if a != b:
                        graph[a].add(b)
                        graph[b].add(a)

    start = rid[H - 2, 1]
    if start == -1:
        start = 0

    region_color = {start: 5}
    dq = deque([start])
    while dq:
        u = dq.popleft()
        for v in graph[u]:
            if v not in region_color:
                region_color[v] = 4 if region_color[u] == 5 else 5
                dq.append(v)

    for cid, cells in comps.items():
        col = region_color.get(cid, 5)
        for r, c in cells:
            if g[r, c] == 0:
                out[r, c] = col

    for y, x in np.argwhere(g == 3):
        y = int(y)
        x = int(x)
        d_up = y
        d_down = (H - 1) - y
        if d_up < d_down:
            ty, tx = y - 1, x
        else:
            ty, tx = y + 1, x
        if 0 <= ty < H and 0 <= tx < W and g[ty, tx] != 6:
            out[ty, tx] = region_color.get(int(rid[y, x]), 5)

    return out


def _region_cells(g, rid, cid):
    return [(r, c) for r in range(g.shape[0]) for c in range(g.shape[1]) if rid[r, c] == cid]


def generate_input(seed=0, variant=None):
    if variant is None:
        variant = 0
    rng = np.random.default_rng(int(seed) * 1000003 + int(variant) * 19 + 31)
    H = 15
    W = 15

    while True:
        g = np.zeros((H, W), dtype=int)
        g[0, :] = 1
        g[H - 1, :] = 2

        # 1-2 lines each orientation, avoid creating >6 regions
        nh = int(rng.integers(1, 2))
        nv = int(rng.integers(1, 2))
        hrows = sorted(rng.choice(np.arange(2, H - 2), size=nh, replace=False)) if nh > 0 else []
        vcols = sorted(rng.choice(np.arange(2, W - 2), size=nv, replace=False)) if nv > 0 else []
        for r in hrows:
            g[r, 1:W - 1] = 6
        for c in vcols:
            g[1:H - 1, c] = 6

        rid, comps = _components(g)
        if len(comps) < 3 or len(comps) > 6:
            continue
        if len(comps) < 2:
            continue

        # place 2-4 controls in distinct regions and non-tied distances
        regions = list(comps.keys())
        rng.shuffle(regions)
        n_ctrl = int(rng.integers(2, 5))
        n_ctrl = min(n_ctrl, len(regions))
        placed = 0
        for ridx in regions[:n_ctrl]:
            cells = _region_cells(g, rid, ridx)
            if not cells:
                continue
            y, x = cells[0]
            if y == (H - 1) / 2:
                continue
            g[y, x] = 3
            placed += 1

        controls = np.argwhere(g == 3)
        if len(controls) < 2:
            continue
        if any(int(y) == (H - 1) / 2 for y, x in controls):
            continue

        return g.astype(int)
