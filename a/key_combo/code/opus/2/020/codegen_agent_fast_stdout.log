            c1, c2 = cc, cc + wi + 1
            ok = True
            for pr1, pr2, pc1, pc2 in frames:
                if not (r2 + 2 <= pr1 or pr2 + 2 <= r1 or c2 + 2 <= pc1 or pc2 + 2 <= c1):
                    ok = False
                    break
            if not ok or used[r1 : r2 + 1, c1 : c2 + 1].any():
                continue

            marker_n = int(rng.integers(2, 7))
