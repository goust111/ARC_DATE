import numpy as np
from collections import deque


def _find_rects(g):
    H, W = g.shape
    colors = [int(c) for c in np.unique(g) if c not in (0, 2, 7)]
    rects = []
    for col in colors:
        ys, xs = np.where(g == col)
        if len(ys) == 0:
            continue
        r1, r2 = int(ys.min()), int(ys.max())
        c1, c2 = int(xs.min()), int(xs.max())
        if r2 - r1 < 4 or c2 - c1 < 4:
            continue
        if not (np.all(g[r1, c1:c2 + 1] == col) and np.all(g[r2, c1:c2 + 1] == col) and
                np.all(g[r1:r2 + 1, c1] == col) and np.all(g[r1:r2 + 1, c2] == col)):
            continue
        rects.append((r1, r2, c1, c2, col))
    return rects


def _red_components(region):
    ys, xs = np.where(region == 2)
    H, W = region.shape
    vis = np.zeros(region.shape, bool)
    comps = []
    for y, x in zip(ys, xs):
        y = int(y); x = int(x)
        if vis[y, x]:
            continue
        q = deque([(y, x)])
        vis[y, x] = True
        comp = []
        while q:
            r, c = q.popleft()
            comp.append((r, c))
            for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W and not vis[nr, nc] and region[nr, nc] == 2:
                    vis[nr, nc] = True
                    q.append((nr, nc))
        comps.append(comp)
    return comps


def main(grid):
    """
    Task:
    Count ray crossings per rectangle and keep components by this count.

    Input:
    Several solid rectangles and orange ray-control pixels.

    Algorithm:
    1) For each rectangle, count distinct row/column rays from controls that pass through it.
    2) Select the rectangle with maximum count K.
    3) In that rectangle, keep exactly red components of area K.
    4) Crop output to the selected rectangle.

    Return:
    Cropped rectangle with recoloring applied.
    """
    g = np.array(grid, dtype=int)
    rects = _find_rects(g)
    if not rects:
        return g

    control_rows = [int(r) for r in set(np.argwhere(g == 7)[:, 0])] if np.any(g == 7) else []
    control_cols = [int(c) for c in set(np.argwhere(g == 7)[:, 1])] if np.any(g == 7) else []

    best = None
    best_k = -1
    for r1, r2, c1, c2, col in rects:
        hr = [r for r in control_rows if r1 <= r <= r2]
        vc = [c for c in control_cols if c1 <= c <= c2]
        k = len(set(hr)) + len(set(vc))
        if k > best_k:
            best_k = k
            best = (r1, r2, c1, c2, col, k)

    if best is None:
        return g

    r1, r2, c1, c2, col, k = best
    region = g[r1:r2 + 1, c1:c2 + 1].copy()
    comps = _red_components(region)

    for comp in comps:
        if len(comp) != k:
            for rr, cc in comp:
                region[rr, cc] = col
    return region


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 23 + 13
    rng = np.random.default_rng(seed)

    H, W = 22, 22
    g = np.zeros((H, W), dtype=int)
    colors = [1, 3, 4, 6, 9]
    rng.shuffle(colors)

    attempts = 0
    while True:
        attempts += 1
        g[:] = 0
        rects = []
        used = np.zeros((H, W), dtype=bool)
        count = int(rng.integers(3, 5))
        cur = 0
        for i in range(count):
            for _ in range(200):
                h = int(rng.integers(5, 8))
                w = int(rng.integers(5, 8))
                r0 = int(rng.integers(0, H - h))
                c0 = int(rng.integers(0, W - w))
                if np.any(used[r0:r0 + h, c0:c0 + w]):
                    continue
                if r0 < 1 or c0 < 1 or r0 + h > H - 1 or c0 + w > W - 1:
                    continue
                rects.append((r0, r0 + h - 1, c0, c0 + w - 1, colors[i]))
                used[r0:r0 + h, c0:c0 + w] = True
                g[r0:r0 + h, c0:c0 + w] = colors[i]
                break
        if len(rects) != count:
            continue

        # place controls
        controls = []
        for _ in range(3):
            for _ in range(200):
                r = int(rng.integers(0, H))
                c = int(rng.integers(0, W))
                if g[r, c] != 0:
                    continue
                controls.append((r, c))
                g[r, c] = 7
                break
        if len(controls) < 3:
            continue

        # compute k values
        ks = []
        valid = True
        control_rows = sorted({r for r, c in controls})
        control_cols = sorted({c for r, c in controls})
        for r1, r2, c1, c2, col in rects:
            hr = [r for r in control_rows if r1 <= r <= r2]
            vc = [c for c in control_cols if c1 <= c <= c2]
            k = len(set(hr)) + len(set(vc))
            ks.append(k)
        if len(ks) != len(set(ks)):
            continue
        if not ks:
            continue
        kmax = max(ks)
        max_rect_idx = int(ks.index(kmax))
        if kmax == 0:
            continue

        # ensure all red markers and area constraints on max rect
        rr, rc, cl1, cl2, col = rects[max_rect_idx]
        region = g[rr:rc + 1, cl1:cl2 + 1]
        region[:] = col

        # place two components with required areas
        area_target = kmax
        total_area = region.shape[0] * region.shape[1]
        if total_area < 10:
            continue

        def put_comp(area, color=2):
            for _ in range(100):
                y = int(rng.integers(0, region.shape[0]))
                x = int(rng.integers(0, region.shape[1]))
                region[y, x] = color
                pts = [(y, x)]
                q = [(y, x)]
                seen = {(y, x)}
                while q and len(pts) < area:
                    cy, cx = q.pop(0)
                    for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                        ny, nx = cy + dr, cx + dc
                        if 0 <= ny < region.shape[0] and 0 <= nx < region.shape[1] and region[ny, nx] == col and (ny, nx) not in seen:
                            if len(pts) < area:
                                seen.add((ny, nx))
                                region[ny, nx] = color
                                q.append((ny, nx))
                                pts.append((ny, nx))
                    if len(pts) >= area:
                        break
                if len(pts) >= area:
                    return True
                region[region == color] = col
            return False

        # clear all red and reconstruct
        region[region == 2] = col
        ok = True
        if area_target < 1 or area_target >= total_area:
            ok = False
        else:
            if not put_comp(area_target):
                ok = False
            other_area = area_target + 1 if area_target < 6 else area_target - 1
            if not put_comp(other_area):
                ok = False

        for r in rects:
            pass

        # add some red to all rects
        for idx, (y1, y2, x1, x2, cc) in enumerate(rects):
            for _ in range(2):
                area = int(rng.integers(1, 4))
                for _ in range(40):
                    rr0 = int(rng.integers(y1 + 1, y2))
                    cc0 = int(rng.integers(x1 + 1, x2))
                    if g[rr0, cc0] == cc:
                        g[rr0, cc0] = 2
                        break
            # guarantee at least one red exists each rect
            if np.all(g[y1:y2 + 1, x1:x2 + 1] != 2):
                g[(y1 + 1), (x1 + 1)] = 2

        if ok:
            break

        if attempts > 120:
            break

    return g.astype(int)

