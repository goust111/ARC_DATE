import numpy as np
from itertools import permutations


def _find_mapping(src_tile, tgt_tile):
    src_colors = [int(c) for c in np.unique(src_tile) if c != 0]
    tgt_colors = [int(c) for c in np.unique(tgt_tile) if c != 0]
    if len(src_colors) == 0 or len(src_colors) != len(tgt_colors):
        return {}

    s_masks = [src_tile == c for c in src_colors]
    t_masks = [tgt_tile == c for c in tgt_colors]

    for perm in permutations(range(len(tgt_colors))):
        ok = True
        mapping = {}
        for i, j in enumerate(perm):
            if not np.array_equal(s_masks[i], t_masks[j]):
                ok = False
                break
            mapping[src_colors[i]] = tgt_colors[j]
        if ok:
            return mapping
    return {}


def main(grid):
    """
    Task:
    Compress upper region to 3x3 map and recolor via template-pair color mapping.

    Input:
    One magenta row separates top large pattern and three lower tiles.

    Algorithm:
    1) Compress top with non-blue->red/blue rule to 3x3 map.
    2) Derive source-target color mapping from isomorphic tile pair in lower band.
    3) Apply mapping to compressed map.

    Return:
    3x3 mapped map.
    """
    g = np.array(grid, dtype=int)
    h, w = g.shape

    sep_rows = [r for r in range(h) if np.all(g[r] == 6)]
    if not sep_rows:
        return g
    sep = sep_rows[0]
    top = g[:sep, :]
    bottom = g[sep + 1 :, :]

    if top.shape[0] == 0 or top.shape[1] % 3 != 0:
        return g
    bh = top.shape[0] // 3
    bw = top.shape[1] // 3
    if bh == 0 or bw == 0:
        return g

    compressed = np.zeros((3, 3), dtype=int)
    for tr in range(3):
        for tc in range(3):
            blk = top[tr * bh:(tr + 1) * bh, tc * bw:(tc + 1) * bw]
            compressed[tr, tc] = 2 if np.any(blk == 2) else 1

    # locate three tiles, fixed layout in generator
    tile_starts = []
    for c in [0, 4, 8]:
        if c + 2 < bottom.shape[1] and np.any(bottom[:, c : c + 3] != 0):
            tile_starts.append(c)
    if len(tile_starts) != 3:
        return compressed

    # assume tiles in single row with size3
    sr = 0
    while sr < max(1, bottom.shape[0] - 2) and not np.any(bottom[sr:sr + 3] != 0):
        sr += 1
    if sr + 3 > bottom.shape[0]:
        sr = 0

    tiles = []
    for c in tile_starts:
        tile = bottom[sr:sr + 3, c:c + 3]
        if tile.shape == (3, 3):
            tiles.append(tile)

    if len(tiles) != 3:
        return compressed

    # find isomorphic pair
    src = None
    dst = None
    for i in range(3):
        for j in range(i + 1, 3):
            m = _find_mapping(tiles[i], tiles[j])
            if m and (set(m.keys()) == {1, 2}):
                src, dst = tiles[i], tiles[j]
                mapping = m
                break
            m2 = _find_mapping(tiles[j], tiles[i])
            if m2 and set(m2.keys()) == {1, 2}:
                src, dst = tiles[j], tiles[i]
                mapping = m2
                break
        if src is not None:
            break

    if src is None:
        mapping = {1: 1, 2: 2}
    out = compressed.copy()
    for r in range(3):
        for c in range(3):
            v = out[r, c]
            out[r, c] = mapping.get(int(v), int(v))

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 17 + 7
    rng = np.random.default_rng(seed)

    top_h = 9
    top_w = 12
