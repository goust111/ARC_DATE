import numpy as np
from collections import deque


def _rectangles(g):
    out = []
    for color in [c for c in np.unique(g) if c not in (0, 2, 7)]:
        ys, xs = np.where(g == color)
        if len(ys) == 0:
            continue
        r1, r2 = int(ys.min()), int(ys.max())
        c1, c2 = int(xs.min()), int(xs.max())
        if r2 - r1 < 4 or c2 - c1 < 4:
            continue
        if not (np.all(g[r1, c1 : c2 + 1] == color) and
                np.all(g[r2, c1 : c2 + 1] == color) and
                np.all(g[r1 : r2 + 1, c1] == color) and
                np.all(g[r1 : r2 + 1, c2] == color)):
            continue
        out.append((r1, r2, c1, c2, color))
    return out


def _red_components(sub):
    h, w = sub.shape
    vis = np.zeros((h, w), dtype=bool)
    comps = []
    for y in range(h):
        for x in range(w):
            if sub[y, x] "'!= 2 or vis[y, x]:
                continue
            q = deque([(y, x)])
            vis[y, x] = True
            comp = []
            while q:
                yy, xx = q.popleft()
                comp.append((yy, xx))
                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                    ny, nx = yy + dy, xx + dx
                    if 0 <= ny < h and 0 <= nx < w and sub[ny, nx] == 2 and not vis[ny, nx]:
                        vis[ny, nx] = True
                        q.append((ny, nx))
            comps.append(comp)
    return comps


def main(grid):
    """
    1) Count ray lines through each solid rectangle (unique control row/col rays).
    2) Pick rectangle with maximal count.
    3) Keep only red components whose area equals count, recolor others with fill color.
    4) Crop and return only selected rectangle.
    """
    g = np.array(grid, dtype=int)
    rects = _rectangles(g)
    if not rects:
        return g
    control_rows = sorted(set(int(r) for r, c in np.argwhere(g == 7)[:, 0])) if np.any(g == 7) else []
    control_cols = sorted(set(int(c) for r, c in np.argwhere(g == 7)[:, 1])) if np.any(g == 7) else []

    best = None
    best_k = -1
    for r1, r2, c1, c2, color in rects:
        hr = len([r for r in control_rows if r1 <= r <= r2])
        hc = len([c for c in control_cols if c1 <= c <= c2])
        k = hr + hc
        if k > best_k:
            best_k = k
            best = (r1, r2, c1, c2, color)

    if best is None:
        return g
    r1, r2, c1, c2, color = best
    sub = g[r1 : r2 + 1, c1 : c2 + 1].copy()

    for comp in _red_components(sub):
        if len(comp) != best_k:
            for y, x in comp:
                sub[y, x] = color

    return sub


def _place_rectangles(g, rng):
    H, W = g.shape
    colors = [1, 3, 4, 6, 9]
    rng.shuffle(colors)
    n = int(rng.integers(3, 5))
    used = np.zeros((H, W), dtype=bool)
    rects = []
    for i in range(n):
        color = colors[i]
        for _ in range(200):
            rh = int(rng.integers(5, 8))
            rw = int(rng.integers(5, 8))
            r1 = int(rng.integers(0, H - rh))
            c1 = int(rng.integers(0, W - rw))
            r2 = r1 + rh - 1
            c2 = c1 + rw - 1
            if r1 < 1 or c1 < 1 or r2 >= H - 1 or c2 >= W - 1:
                continue
            if used[r1 - 1 : r2 + 2, c1 - 1 : c2 + 2].any():
                continue
            g[r1 : r2 + 1, c1 : c2 + 1] = color
            used[r1 : r2 + 1, c1 : c2 + 1] = True
            rects.append((r1, r2, c1, c2, color))
            break
    return rects


def _random_walk_cells(gsub, start, color, area, rng):
    h, w = gsub.shape
    ys, xs = np.where(gsub == 0)
    if len(ys) == 0:
        return
    y, x = int(ys[0]), int(xs[0])
    cur = (y, x)
    for _ in range(area):
        y, x = cur
        gsub[y, x] = color
        dirs = ((1, 0), (-1, 0), (0, 1), (0, -1))
        rng.shuffle(dirs)
        moved = False
        for dy, dx in dirs:
            ny, nx = y + dy, x + dx
            if 0 <= ny < h and 0 <= nx < w and gsub[ny, nx] == 0:
                cur = (ny, nx)
                moved = True
                break
        if not moved:
            return


def generate_input(seed=0, variant=None):
    if variant is None:
        variant = 0
    rng = np.random.default_rng(int(seed) * 1000003 + int(variant) * 17 + 27)
    H, W = 22, 22
    while True:
        g = np.zeros((H, W), dtype=int)
        rects = _place_rectangles(g, rng)
        if len(rects) < 3:
            continue

        # controls
        for _ in range(3):
            for _ in range(200):
                y = int(rng.integers(0, H))
                x = int(rng.integers(0, W))
                if g[y, x] == 0:
                    g[y, x] = 7
                    break

        control_rows = sorted(set(int(r) for r, c in np.argwhere(g == 7)[:, 0]))
        control_cols = sorted(set(int(c) for r, c in np.argwhere(g == 7)[:, 1]))
        counts = []
        for r1, r2, c1, c2, _ in rects:
            hr = len([r for r in control_rows if r1 <= r <= r2])
            hc = len([c for c in control_cols if c1 <= c <= c2])
            counts.append(hr + hc)

        if len(set(counts)) != len(counts):
            continue
        if max(counts) < 1:
            continue

        idx_max = int(np.argmax(counts))
        y1, y2, x1, x2, fill = rects[idx_max]

        # enforce marker counts: one area==K and one area!=K
        k = counts[idx_max]
        if k == 0:
            continue
        sub = g[y1 : y2 + 1, x1 : x2 + 1]
        sub[:] = fill

        # create at least one component with area k and one with area k+1 (or k-1)
        for p in [(y1 + 1, x1 + 1), (y1 + 2, x1 + 1)]:
            if p[0] < y2 and p[1] < x2:
                sub[p[0] - y1, p[1] - x1] = 0

        tmp = np.zeros_like(sub)
        if k < 6:
            target1 = k
            target2 = k + 1
        else:
            target1 = 6
            target2 = 5
        _random_walk_cells(sub - fill, (0, 0), 2, target1, rng)
        _random_walk_cells(sub - fill, (0, 0), 2, target2, rng)

        # fill every region with at least one red
        for rr in rects:
            a = np.argwhere(g[rr[0] : rr[1] + 1, rr[2] : rr[3] + 1] != 0)
            if len(a) == 0:
                continue
        return g.astype(int)
