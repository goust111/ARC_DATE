import numpy as np


def _decode_direction(legend):
    cy, cx = 1, 1
    if legend.shape != (3, 3):
        return 0, 1
    for dy, dx in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
        y, x = cy + dy, cx + dx
        if 0 <= y < 3 and 0 <= x < 3 and legend[y, x] == 4:
            return dy, dx
    return 0, 1


def _ordered_iter(h, w, drow, dcol):
    if drow == 0:
        rows = range(h)
        cols = range(w - 1, -1, -1) if dcol == 1 else range(w)
        return [(r, c) for r in rows for c in cols]
    cols = range(w)
    rows = range(h - 1, -1, -1) if drow == 1 else range(h)
    return [(r, c) for c in cols for r in rows]


def main(grid):
    """
    1) Split by magenta separator, decode 3x3 direction legend in top area.
    2) In each lower copy, locate missing template pixels (template nonzero, copy zero).
    3) Slide missing pixels along direction with collision-stop to rest position.
    4) Paste moved pixels while keeping template and separator unchanged.
    """
    g = np.array(grid, dtype=int).copy()
    h, w = g.shape
    sep_rows = [r for r in range(h) if np.all(g[r] == 6)]
    if not sep_rows:
        return g
    sep = int(sep_rows[0])
    top = g[:sep]
    bottom = g[sep + 1 :]

    template = top[:5, :5]
    # legend expected near top-left-right
    legend = top[:3, 6:9]
    drow, dcol = _decode_direction(legend)

    rows_nonzero = np.where(np.any(bottom != 0, axis=1))[0]
    if len(rows_nonzero) == 0:
        return g
    br0 = int(rows_nonzero[0])

    for sc in (0, 7, 14):
        if sc + 5 > bottom.shape[1] or br0 + 5 > bottom.shape[0]:
            continue
        copy = bottom[br0 : br0 + 5, sc : sc + 5]
        miss = []
        for y in range(5):
            for x in range(5):
                if template[y, x] != 0 and copy[y, x] == 0:
                    miss.append((y, x))
        if not miss:
            continue

        order = _ordered_iter(5, 5, drow, dcol)
        for my, mx in order:
            if (my, mx) not in miss:
                continue
            color = int(template[my, mx])
            if color == 0:
                continue
            yy, xx = my, mx
            while True:
                ny, nx = yy + drow, xx + dcol
                if not (0 <= ny < 5 and 0 <= nx < 5):
                    break
                if copy[ny, nx] != 0:
                    break
                yy, xx = ny, nx
            copy[yy, xx] = color

        bottom[br0 : br0 + 5, sc : sc + 5] = copy

    g[sep + 1 : sep + 1 + bottom.shape[0], :bottom.shape[1]] = bottom
    return g


def _random_template(rng):
    cnt = int(rng.integers(8, 13))
    cells = {(2, 2)}
    while len(cells) < cnt:
        cy, cx = list(cells)[-1]
        for _ in range(10):
            dy, dx = rng.choice([(-1, 0), (1, 0), (0, -1), (0, 1)])
            ny, nx = cy + dy, cx + dx
            if 0 <= ny < 5 and 0 <= nx < 5:
                cells.add((ny, nx))
                cy, cx = ny, nx
                break
    t = np.zeros((5, 5), dtype=int)
    for y, x in cells:
        t[y, x] = int(rng.choice([1, 2]))
    return t


def generate_input(seed=0, variant=None):
    if variant is None:
        variant = 0
    rng = np.random.default_rng(int(seed) * 1000003 + int(variant) * 7 + 11)
    g = np.zeros((15, 21), dtype=int)
    template = _random_template(rng)
    g[:5, :5] = template

    # legend 3x3
    g[:3, 6:9] = 6
    g[1, 7] = 0
    dr, dc = rng.choice([(0, 1), (0, -1), (1, 0), (-1, 0)])
    g[1 + dr, 7 + dc] = 4

    sep = 8
    g[sep, :] = 6

    n_copies = int(rng.integers(2, 4))
    starts = [0, 7, 14][:n_copies]

    for sc in starts:
        copy = template.copy()
        miss_candidates = np.argwhere(template != 0)
        rng.shuffle(miss_candidates)
        miss_count = int(rng.integers(2, min(5, len(miss_candidates) + 1)))
        miss = set((int(y), int(x)) for y, x in miss_candidates[:miss_count])
        for y, x in miss:
            copy[y, x] = 0
        # simple move order with simulated sliding
        order = _ordered_iter(5, 5, dr, dc)
        for y, x in order:
            if (y, x) not in miss:
                continue
            color = int(template[y, x])
            yy, xx = y, x
            while True:
                ny, nx = yy + dr, xx + dc
                if not (0 <= ny < 5 and 0 <= nx < 5):
                    break
                if copy[ny, nx] != 0:
                    break
                yy, xx = ny, nx
            copy[yy, xx] = color
        g[sep + 1 : sep + 6, sc : sc + 5] = copy

    return g

