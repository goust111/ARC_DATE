import numpy as np
from collections import deque


def _is_frame(grid, color):
    ys, xs = np.where(grid == color)
    if len(ys) == 0:
        return None
    r1, r2 = int(ys.min()), int(ys.max())
    c1, c2 = int(xs.min()), int(xs.max())
    if r2 - r1 < 3 or c2 - c1 < 3:
        return None
    if not (np.all(grid[r1, c1:c2 + 1] == color) and np.all(grid[r2, c1:c2 + 1] == color) and
            np.all(grid[r1:r2 + 1, c1] == color) and np.all(grid[r1:r2 + 1, c2] == color)):
        return None
    return (r1, r2, c1, c2)


def _components(g):
    H, W = g.shape
    vis = np.full((H, W), -1, dtype=int)
    cid = 0
    comps = {}
    for r in range(H):
        for c in range(W):
            if g[r, c] == 0 or g[r, c] == 5 or vis[r, c] != -1:
                continue
            q = [(r, c)]
            vis[r, c] = cid
            comps[cid] = []
            while q:
                y, x = q.pop()
                comps[cid].append((y, x))
                for dr, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
                    ny, nc = y + dr, x + dc
                    if 0 <= ny < H and 0 <= nc < W and vis[ny, nc] == -1 and g[ny, nc] != 0 and g[ny, nc] != 5:
                        vis[ny, nc] = cid
                        q.append((ny, nc))
            cid += 1
    return vis, comps


def main(grid):
    """
    Task:
    Select frame by largest count of adjacent external sprites and recolor mirrored interior.

    Input:
    Multiple gray hollow frames with sprites outside, each touching frame border.

    Algorithm:
    1) Count per frame how many outside-connected sprite components touch it.
    2) Choose frame with max count, horizontally mirror its interior sprites.
    3) Using one left and one right outer sprite colors, recolor black halves
       (left color fills right half, right color fills left half).

    Return:
    Mirrored-and-recolored strict interior of target frame.
    """
    g = np.array(grid, dtype=int)
    vis, comps = _components(g)

    frames = []
    for color in [c for c in np.unique(g) if c not in (0, 5, 3)]:
        frame = _is_frame(g, int(color))
        if frame is not None:
            frames.append(frame)

    best_frame = None
    best_count = -1

    for fidx, (r1, r2, c1, c2) in enumerate(frames):
        touching = set()
        side_left = set()
        side_right = set()
        for c in range(c1, c2 + 1):
            for rr, cc in [(r1 - 1, c), (r2 + 1, c)]:
                if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and g[rr, cc] != 0 and g[rr, cc] != 5:
                    side_id = vis[rr, cc]
                    if side_id != -1:
                        touching.add(side_id)
        for r in range(r1, r2 + 1):
            for rr, cc in [(r, c1 - 1), (r, c2 + 1)]:
                if 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1] and g[rr, cc] != 0 and g[rr, cc] != 5:
                    sid = vis[rr, cc]
                    if sid != -1:
                        touching.add(sid)
                        if cc == c1 - 1:
                            side_left.add(sid)
                        if cc == c2 + 1:
                            side_right.add(sid)

        if len(touching) > best_count:
            best_count = len(touching)
            best_frame = (fidx, (r1, r2, c1, c2), side_left, side_right)

    if best_frame is None:
        return g

    fidx, (r1, r2, c1, c2), side_left, side_right = best_frame

    inside = g[r1 + 1:r2, c1 + 1:c2]
    if inside.size == 0:
        return g
    H, W = inside.shape

    orig = inside.copy()
    mirrored = np.zeros_like(inside)
    for rr in range(H):
        for cc in range(W):
            if orig[rr, cc] != 0:
                nc = W - 1 - cc
                mirrored[rr, nc] = orig[rr, cc]

    # find left and right sprite colors from neighboring components
    left_color = 4
    right_color = 3
    if side_left:
        sid = int(next(iter(side_left)))
        for r, c in comps.get(sid, []):
            left_color = int(g[r, c])
            break
    if side_right:
        sid = int(next(iter(side_right)))
        for r, c in comps.get(sid, []):
            right_color = int(g[r, c])
            break

    # cross-colors: left half -> right sprite color, right half -> left sprite color
    left_half_end = (W - 1) // 2
    out = mirrored.copy()
    for rr in range(H):
        for cc in range(W):
            if out[rr, cc] == 0:
                if cc <= left_half_end:
                    out[rr, cc] = right_color
                else:
                    out[rr, cc] = left_color

    return out


def generate_input(seed=0, variant=None):
    seed = int(seed)
    if variant is None:
        variant = 0
    seed = seed * 1000003 + int(variant) * 47 + 5
    rng = np.random.default_rng(seed)

    H = 20
    W = 20
    g = np.zeros((H, W), dtype=int)
    n_frames = int(rng.integers(2, 4))

    frame_colors = [1, 2, 3, 6, 9, 4]
    rng.shuffle(frame_colors)

    frame_boxes = []
    min_gap = 3
    for i in range(n_frames):
        color = frame_colors[i]
        fh = int(rng.integers(4, 7)) + 2
        fw = int(rng.integers(6, 10)) + 2
        for _ in range(200):
            r0 = int(rng.integers(0, H - fh))
            c0 = int(rng.integers(0, W - fw))
            r1, r2 = r0, r0 + fh - 1
            c1, c2 = c0, c0 + fw - 1
            conflict = False
            for pr1, pr2, pc1, pc2 in frame_boxes:
                if not (r2 + min_gap < pr1 or pr2 + min_gap < r1 or c2 + min_gap < pc1 or pc2 + min_gap < c1):
                    conflict = True
                    break
            if conflict:
                continue
            g[r0:r2 + 1, c0:c2 + 1] = 0
            g[r0, c0:c2 + 1] = color
            g[r2, c0:c2 + 1] = color
            g[r0:r2 + 1, c0] = color
            g[r0:r2 + 1, c2] = color
            # interior seed pattern
            fill_positions = [(r, c) for r in range(r0 + 1, r2) for c in range(c0 + 1, c2)]
            rng.shuffle(fill_positions)
            for rr, cc in fill_positions[: min(6, len(fill_positions))]:
                g[rr, cc] = int(rng.choice([1, 2, 3]))
            frame_boxes.append((r1, r2, c1, c2))
            break

    # ensure counts unique
    counts = [1 + i for i in range(len(frame_boxes))]
    for idx, (r1, r2, c1, c2) in enumerate(frame_boxes):
        side_candidates = {
            '"'L': [(r, c1 - 1) for r in range(r1, r2 + 1) if c1 - 1 >= 0 and g[r, c1 - 1] == 0],
            'R': [(r, c2 + 1) for r in range(r1, r2 + 1) if c2 + 1 < W and g[r, c2 + 1] == 0],
            'U': [(r1 - 1, c) for c in range(c1, c2 + 1) if r1 - 1 >= 0 and g[r1 - 1, c] == 0],
            'D': [(r2 + 1, c) for c in range(c1, c2 + 1) if r2 + 1 < H and g[r2 + 1, c] == 0],
        }
        need = counts[idx]
        colors = [1, 2, 3]
        all_cells = []
        for key in ['L', 'R', 'U', 'D']:
            for yx in side_candidates[key]:
                all_cells.append((key, yx[0], yx[1]))
        if len(all_cells) < need:
            continue
        rng.shuffle(all_cells)
        for k in range(need):
            key, y, x = all_cells[k]
            col = int(colors[k % len(colors)])
            # size-1 component
            g[y, x] = col

    # enforce max frame has one left and one right sprite color-different
    if frame_boxes:
        r1, r2, c1, c2 = frame_boxes[0]
        if c1 - 1 >= 0 and c1 + 1 < W:
            y = r1 + (r2 - r1) // 2
            g[y, c1 - 1] = 2
            g[y, c2 + 1] = 3

    return g.astype(int)

