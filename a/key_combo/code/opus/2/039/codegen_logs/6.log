+    r0, c0, r1, c1 = map(int, rect_bbox)
+    mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    for c in active_cols:
+        if r1 + 1 < axis_row:
+            mask[r1 + 1 : axis_row, int(c)] = True
