+    candidates: list[tuple[int, dict]] = []
+    for color in colors_present(g, exclude={bg, axis_color}):
+        components = find_components(
+            g,
+            bg=bg,
+            connectivity=4,
+            monochromatic=True,
+            colors=[int(color)],
+            return_format="dict",
+        )
+        if len(components) != 1:
+            continue
+        component = components[0]
+        if int(component["area"]) <= 1:
+            continue
+        if int(component["bbox"][2]) >= int(axis_row):
+            continue
