+        chosen.append(pos)
+        used.add(pos)
+
+    if len(chosen) < count and outside_pool and random.random() < 0.8:
+        pos = random.choice(outside_pool)
+        if pos not in used:
+            chosen.append(pos)
+            used.add(pos)
