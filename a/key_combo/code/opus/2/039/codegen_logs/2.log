170: SQUARE_EDGE_GAP = 5                            # min gap from square to grid edges
171: 
172: # Obstacles
173: OBS_COUNT_4_PROB = 0.65                        # P(4 obstacles); else 3
174: OBS_THICKNESS_RANGE = (2, 4)                   # obstacle shorter-dimension bounds
175: OBS_SINGLE_MARGIN = 6                          # margin subtracted when only one side present
176: OBS_BOTH_GAP = 2                               # gap subtracted when both sides present
177: 
178: # Span selection
179: SPAN_MIN_MULT = 3                              # min obstacle length = SPAN_MIN_MULT * sz
180: SPAN_MAX_MULT = 14                             # max obstacle length = SPAN_MAX_MULT * sz
181: SPAN_COMPACT_PROB = 0.4                        # P(bias toward compact spans)
182: 
