+        if len(set(row_labels.tolist()) | set(col_labels.tolist())) < 3:
+            continue
+
+        match = np.equal.outer(row_labels[:ah], col_labels[:aw])
+        kept = occupied & match
+        grey = occupied & ~match
+        if int(kept.sum()) < max(2, area // 5):
