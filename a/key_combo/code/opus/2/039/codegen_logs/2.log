+
+    inner = _place_pieces(inner_shape, patches)
+    if inner is None:
+        return None
+
+    labels = _sample_labels(inner_shape, assembly)
+    if labels is None:
+        return None
+    row_labels, col_labels = labels
+
+    grid = np.full((inner_shape[0] + 1, inner_shape[1] + 1), Color.BLACK, dtype=int)
+    grid[:-1, :-1] = inner
+    grid[:-1, -1] = row_labels
+    grid[-1, :-1] = col_labels
