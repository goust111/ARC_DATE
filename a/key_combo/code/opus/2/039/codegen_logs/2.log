67: def main(grid: np.ndarray) -> np.ndarray:
68:     """
69:     Emit four teal beams from a square, turning at colored obstacles per a legend.
70: 
71:     Input structure:
72:     - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.
73:     - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.
74: 
75:     Rule:
76:     - Remove the legend from the output.
77:     - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).
78:     - Each beam paints teal over bg cells as it moves.
79:     - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.
80:     - Beams stop at grid edges.
81: 
82:     Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.
83:     """
84:     g = np.asarray(grid, dtype=int)
85: 
86:     # Legend height: crop everything above and including the last row containing legend bg (usually 5).
87:     # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.
88:     legend_bg = 5
89:     rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
90:     assert rows_with_legend.size, "legend rows must be present"
91:     legend_h = int(rows_with_legend.max() + 1)
92:     assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
93: 
94:     legend_turn = _parse_legend(g, legend_h)
95: 
96:     base = g[legend_h:, :].copy()
97:     assert base.size, "main grid must remain after legend crop"
98: 
99:     _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])
100:     teal = 8
101:     src = _find_teal_square(base, teal=teal)
102:     sr, sc, sz = src
103: 
104:     out = base.copy()
105: 
106:     def in_bounds(r: int, c: int) -> bool:
107:         return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
108: 
109:     def paint_block(r: int, c: int) -> None:
110:         blk = out[r : r + sz, c : c + sz]
111:         blk[blk == bg] = teal
112:         out[r : r + sz, c : c + sz] = blk
113: 
114:     def obstacle_color_at_next(nr: int, nc: int) -> int | None:
115:         blk = out[nr : nr + sz, nc : nc + sz]
116:         cols = set(map(int, np.unique(blk)))
117:         cols.discard(bg)
118:         cols.discard(teal)
119:         if not cols:
120:             return None
121:         assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
122:         return int(next(iter(cols)))
123: 
124:     # Four beams, each is a moving copy of the teal square.
125:     for d0 in range(4):
126:         r, c, d = sr, sc, d0
127:         seen: set[tuple[int, int, int]] = set()
128:         while True:
129:             state = (r, c, d)
130:             assert state not in seen, "beam path must not cycle"
131:             seen.add(state)
132: 
133:             dr, dc = _DIRS[d]
134:             nr, nc = r + dr, c + dc
135:             if not in_bounds(nr, nc):
136:                 break
137: 
138:             oc = obstacle_color_at_next(nr, nc)
139:             if oc is None:
140:                 r, c = nr, nc
141:                 paint_block(r, c)
142:                 continue
143: 
144:             assert oc in legend_turn, "obstacle color must be encoded by legend"
145:             turn = legend_turn[oc]
146:             d = _rot_ccw(d) if turn == "L" else _rot_cw(d)
147: 
148:     return out
149: 
