151:     for center, height, sequence in pyramid_data:
152:         top_pyramid_row = H - height
153:         num_pixels = height * height
154:         available_rows = list(range(top_pyramid_row))
155:         if len(available_rows) < num_pixels:
156:             return None
157:         chosen_rows = sorted(random.sample(available_rows, num_pixels))
158:         for row, color in zip(chosen_rows, sequence):
159:             inp[row, center] = color
