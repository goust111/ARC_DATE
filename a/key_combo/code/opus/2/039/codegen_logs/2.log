+    for _ in range(LABEL_RETRY_LIMIT):
+        row_labels = _sample_label_sequence(H)
+        col_labels = _sample_label_sequence(W)
+        if len(set(row_labels.tolist())) < 2 or len(set(col_labels.tolist())) < 2:
