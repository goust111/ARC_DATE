42:         region = g[qr * region_h : (qr + 1) * region_h, qc * region_w : (qc + 1) * region_w]
43:         foreground_colors = colors_present(region, exclude=[bg])
44:         assert len(foreground_colors) == 1, "each quadrant must have exactly one foreground color"
