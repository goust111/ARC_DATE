+
+
+LABEL_COLORS = (Color.BLUE, Color.RED, Color.GREEN)
+PIECE_COLORS = (Color.BLUE, Color.GREEN)
+GEN_RETRY_LIMIT = 400
+LABEL_RETRY_LIMIT = 200
