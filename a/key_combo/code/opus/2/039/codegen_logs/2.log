+    for r1, c1 in positions[0][:PLACEMENT_RETRY_LIMIT]:
+        abs_a = _translated_coords(coords[0], r1, c1)
+        for r2, c2 in positions[1][:PLACEMENT_RETRY_LIMIT]:
