+            b_norm = shifted_b - np.array([r0, c0], dtype=int)
+            patch[a_norm[:, 0], a_norm[:, 1]] = Color.BLUE
+            patch[b_norm[:, 0], b_norm[:, 1]] = Color.GREEN
