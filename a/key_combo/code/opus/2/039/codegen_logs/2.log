+
+
+def _place_pieces(inner_shape: tuple[int, int], patches: list[np.ndarray]) -> np.ndarray | None:
+    H, W = map(int, inner_shape)
+    coords = [np.argwhere(patch != Color.BLACK) for patch in patches]
+    positions = []
+    for patch in patches:
+        h, w = patch.shape
+        if h > H or w > W:
