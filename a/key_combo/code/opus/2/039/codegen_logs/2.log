191:     """Create an Nx2 canonical template with a structurally unique active (left) edge.
192: 
193:     Returns (template, ids_base, template_colors) or None on rejection.
194:     """
195:     num_colors = random.randint(*_TEMPLATE_COLOR_COUNT)
196:     template_colors = random.sample(_NON_BG_COLORS, num_colors)
197: 
198:     # Active edge (left column) must have strictly higher max-same-color count
199:     active_majority = random.randint(_ACTIVE_MAJORITY_RANGE[0], min(N, _ACTIVE_MAJORITY_RANGE[1]))
200:     left_col = _build_column(N, template_colors, active_majority, random.choice(template_colors))
201: 
202:     # Right column with strictly lower majority
203:     max_right_majority = active_majority - 1
204:     right_majority = random.randint(max(2, N // num_colors), max_right_majority)
205:     right_dominant = random.choice(template_colors)
206:     others = [c for c in template_colors if c != right_dominant]
207:     if not others:
208:         return None
209:     right_col = _build_column(N, template_colors, right_majority, right_dominant)
