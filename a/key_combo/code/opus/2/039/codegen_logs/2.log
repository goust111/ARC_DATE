+    for patch in patches:
+        h, w = patch.shape
+        if h > H or w > W:
+            return None
+        pos = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
+        random.shuffle(pos)
+        positions.append(pos)
+
+    for r1, c1 in positions[0][:PLACEMENT_RETRY_LIMIT]:
