192: # ── Obstacle span selection ───────────────────────────────────────────
193: 
194: def _choose_span(
195:     axis_len: int,
196:     required: list[tuple[int, int]],
197:     excluded: list[tuple[int, int]],
198:     min_len: int,
199:     max_len: int,
200: ) -> tuple[int, int] | None:
201:     """Pick a (start, end) span covering all *required* intervals, avoiding all *excluded*."""
202:     req0 = min(a for a, _ in required)
203:     req1 = max(b for _, b in required)
204:     lo = max(min_len, req1 - req0 + 1)
205:     hi = min(max_len, axis_len)
206:     choices: list[tuple[int, int, int]] = []
207:     for length in range(lo, hi + 1):
208:         start0 = max(0, req1 - length + 1)
209:         start1 = min(req0, axis_len - length)
210:         for start in range(start0, start1 + 1):
211:             end = start + length - 1
212:             if all(end < a or start > b for a, b in excluded):
213:                 choices.append((length, start, end))
214:     if not choices:
215:         return None
216: 
217:     # Bias mildly toward compact side bars while still covering long-span cases.
218:     lengths = sorted({length for length, _, _ in choices})
219:     if random.random() < SPAN_COMPACT_PROB:
220:         cutoff = lengths[min(len(lengths) - 1, max(0, len(lengths) // 2))]
221:         pool = [(start, end) for length, start, end in choices if length <= cutoff]
222:     else:
223:         pool = [(start, end) for _, start, end in choices]
224:     return random.choice(pool)
225: 
226: 
227: # ── Beam simulation (oracle) ──────────────────────────────────────────
228: 
229: def _simulate_paths(
230:     base: np.ndarray, turns: dict[int, str], bg: int
231: ) -> tuple[np.ndarray, list[list[tuple[int, int, int, int]]]]:
232:     """Simulate 4 beams from the teal square, returning painted grid and per-beam hit lists."""
233:     vals, counts = np.unique(base, return_counts=True)
234:     assert int(vals[counts.argmax()]) == bg
235: 
236:     teal_locs = np.argwhere(base == TEAL)
237:     assert teal_locs.size
238:     sr, sc = teal_locs.min(axis=0)
239:     r1, c1 = teal_locs.max(axis=0)
240:     sz = int(r1 - sr + 1)
241:     assert sz == int(c1 - sc + 1)
242: 
243:     out = base.copy()
244:     H, W = out.shape
245:     hits: list[list[tuple[int, int, int, int]]] = []
246: 
