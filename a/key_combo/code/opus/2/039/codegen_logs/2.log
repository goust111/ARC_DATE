+def _grow_compact_mask(canvas_h: int, canvas_w: int, area: int) -> np.ndarray | None:
+    mask = np.zeros((canvas_h, canvas_w), dtype=bool)
+    start = (random.randrange(canvas_h), random.randrange(canvas_w))
