+    if len(order) != len(cells):
+        return None
+
+    subtrees: dict[tuple[int, int], set[tuple[int, int]]] = {}
+    for cell in reversed(order):
+        nodes = {cell}
+        for child in children[cell]:
+            nodes.update(subtrees[child])
+        subtrees[cell] = nodes
+
+    total = len(cells)
+    candidates = []
+    for cell in order[1:]:
