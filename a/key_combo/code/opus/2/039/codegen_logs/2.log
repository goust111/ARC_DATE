9: def main(grid: np.ndarray) -> np.ndarray:
10:     """Move each vertical stream of pixels into a bottom-aligned centered pile.
11: 
12:     Input structure
13:     - A mostly background grid contains one or more vertical source columns of
14:       foreground pixels.
15:     - Each source column has n^2 foreground pixels, and the top-to-bottom color
16:       sequence splits into monochrome groups of lengths 1, 3, 5, ...
17: 
18:     Rule
19:     - Clear the canvas to background.
20:     - For each source column, read the foreground colors from top to bottom and
21:       rebuild them at the bottom below the same column as odd-width centered
22:       rows of lengths 1, 3, 5, ...
23: 
24:     Key insight
25:     - The scattered vertical pixels are falling grains; a square number of
26:       grains decomposes into the odd row widths of a centered pyramid.
27:     """
28:     g = np.asarray(grid, dtype=int)
29:     bg = get_bg(g)
30:     H, W = g.shape
31: 
32:     source_cols: list[tuple[int, list[int]]] = []
33:     for c in range(W):
34:         sequence = [int(g[r, c]) for r in range(H) if int(g[r, c]) != bg]
35:         if sequence:
36:             source_cols.append((c, sequence))
37: 
38:     assert source_cols
39: 
40:     out = np.full_like(g, bg)
41:     for center_c, sequence in source_cols:
42:         height = math.isqrt(len(sequence))
43:         assert height * height == len(sequence)
44:         assert height <= H
45: 
46:         idx = 0
47:         for layer_idx in range(height):
48:             width = 2 * layer_idx + 1
49:             layer = sequence[idx : idx + width]
50:             assert len(layer) == width
51:             assert len(set(layer)) == 1
52: 
53:             r = H - height + layer_idx
54:             c0 = center_c - layer_idx
55:             c1 = center_c + layer_idx
56:             assert 0 <= c0 <= c1 < W
57:             assert np.all(out[r, c0 : c1 + 1] == bg)
58: 
59:             out[r, c0 : c1 + 1] = layer[0]
60:             idx += width
61: 
62:         assert idx == len(sequence)
63: 
64:     return out
