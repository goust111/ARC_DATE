+
+
+def _cells_to_patch(cells: set[tuple[int, int]], color: int) -> np.ndarray:
+    coords = np.array(sorted(cells), dtype=int)
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
