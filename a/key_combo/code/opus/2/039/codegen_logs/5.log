+GRID_SIDE_RANGE = (18, 24)
+SOURCE_COUNT_OPTIONS = (2, 3)
+TARGET_H_RANGE = (7, 9)
+TARGET_W_RANGE = (7, 10)
+TARGET_AREA_RANGE = (20, 30)
