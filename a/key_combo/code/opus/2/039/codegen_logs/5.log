+    out: set[Coord] = set()
+    for r, c in cells:
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not blocked[nr, nc]:
+                out.add((int(nr), int(nc)))
+    return out
+
+
+def _bfs_path(shape: tuple[int, int], blocked: np.ndarray, starts: set[Coord], goals: set[Coord]) -> list[Coord] | None:
+    if not starts or not goals:
+        return None
+    goal_set = set(goals)
+    queue = deque(starts)
+    prev: dict[Coord, Coord | None] = {cell: None for cell in starts}
+    h, w = map(int, shape)
+
+    while queue:
+        cell = queue.popleft()
+        if cell in goal_set:
+            path = []
+            cur: Coord | None = cell
+            while cur is not None:
+                path.append(cur)
+                cur = prev[cur]
+            path.reverse()
+            return path
+        r, c = cell
+        for nr, nc in neighbors4(r, c):
+            nxt = (int(nr), int(nc))
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if blocked[nr, nc] or nxt in prev:
+                continue
+            prev[nxt] = cell
+            queue.append(nxt)
+    return None
