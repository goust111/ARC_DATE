+                r0, c0 = random_free_location(canvas, patch, transparent=BG, border=1, padding=2, padding_connectivity=8)
+                paste(canvas, patch, r0, c0, transparent=BG)
+        except ValueError:
+            continue
+        return canvas
+    return None
