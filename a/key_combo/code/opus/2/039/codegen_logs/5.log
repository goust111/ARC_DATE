+
+            patch_markers = find_components(
+                patch,
+                bg=BG,
+                connectivity=4,
+                monochromatic=True,
+                colors=[marker_color],
+                return_format="dict",
+            )
+            if len(patch_markers) != n_sources:
+                continue
+            norm_shapes = {_normalize_shape([tuple(map(int, coord)) for coord in comp["coords"]]) for comp in patch_markers}
+            if len(norm_shapes) != n_sources:
