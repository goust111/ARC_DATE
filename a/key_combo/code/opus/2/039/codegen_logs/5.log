+def _build_stamp(mask: np.ndarray, placement: set[Coord], marker_color: int, own_color: int) -> np.ndarray:
+    stamp = np.zeros(mask.shape, dtype=int)
+    stamp[mask] = own_color
+    for r, c in placement:
