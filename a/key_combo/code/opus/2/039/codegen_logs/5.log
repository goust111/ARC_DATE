+    7: _mask(["1100", "1111", "0010"]),
+    8: _mask(["10000", "11111", "00110"]),
+    9: _mask(["10000", "11110", "00110", "00110"]),
+    10: _mask(["11000", "11110", "00110", "00110"]),
