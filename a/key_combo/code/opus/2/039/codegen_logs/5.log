+
+def _place_target_markers(h: int, w: int, shapes: list[tuple[Coord, ...]]) -> list[dict] | None:
+    placed: list[dict] = []
+    occupied: set[Coord] = set()
+    for shape in sorted(shapes, key=len, reverse=True):
