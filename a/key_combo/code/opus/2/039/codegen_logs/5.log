+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+MAGENTA = 6
+OWN_COLORS = (BLUE, GREEN, MAGENTA)
+MARKER_COLORS = (RED, YELLOW)
