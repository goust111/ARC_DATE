+                trial = set(cells)
+                trial.add(nxt)
+                score = (_bbox_area(trial) - current_bbox_area, random.random())
+                frontier.append((score, nxt))
+        if not frontier:
+            break
+        frontier.sort(key=lambda item: item[0], reverse=True)
+        top = frontier[: min(6, len(frontier))]
+        cells.add(random.choice(top)[1])
