+
+
+def _choose_target_layout(
+    regions: dict[str, tuple[int, int, int, int]],
+    offsets: list[tuple[int, int]],
+) -> dict[str, tuple[int, int]] | None:
+    candidates = {
+        name: _candidate_targets(bounds, offsets)
+        for name, bounds in regions.items()
+        if name != "tl"
+    }
