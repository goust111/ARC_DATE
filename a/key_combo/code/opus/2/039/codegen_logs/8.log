+    coords = np.argwhere(mask)
+    assert coords.size > 0, "component must be non-empty"
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                if (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    q.append((nr, nc))
