+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SEP = 5
+TEMPLATE_COLOR = 8
+TARGET_COLORS = (1, 2, 4)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+TOP_H_RANGE = (7, 12)
+BOTTOM_H_RANGE = (6, 12)
+LEFT_W_RANGE = (7, 12)
