+
+
+def _candidate_targets(
+    bounds: tuple[int, int, int, int],
+    offsets: list[tuple[int, int]],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]], list[tuple[int, int]]]:
+    r0, r1, c0, c1 = bounds
+    area = len(offsets)
+    preferred_min_visible = max(2, (area + 1) // 2)
