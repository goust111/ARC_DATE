def find_components(
    grid: np.ndarray,
    *,
    bg: int | None = None,
    connectivity: int = 4,
    monochromatic: bool = True,
    colors: Sequence[int] | None = None,
    min_area: int = 1,
    return_format: str = "dict",
) -> list[dict] | list[np.ndarray]:
    """
    Find connected components in a grid (unified API for ARC-2 + migrated seeds).

    return_format:
