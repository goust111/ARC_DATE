0014: def main(input_grid):
0015:     """
0016:     Fit two monochromatic puzzle pieces together into the tightest rectangular assembly.
0017: 
0018:     Input structure:
0019:     - The input is a black grid containing exactly two non-black monochromatic objects.
0020:     - Each object is a puzzle piece that may be translated but not rotated.
0021:     - The pieces come from a compact two-color object.
0022: 
0023:     Rule:
0024:     - Crop the two pieces from the input.
0025:     - Try all non-overlapping translations on a canvas large enough to hold both pieces.
0026:     - Return the placement whose cropped bounding box leaves the fewest black cells.
0027: 
0028:     Key insight:
0029:     - The reconstruction is the densest translation-only packing of the two pieces.
0030:     """
0031:     # Plan:
0032:     # 1. Detect the pieces
0033:     # 2. Consider different ways of placing them together
0034:     # 3. Pick the way which makes them the most tightly packed, meaning that there is as little empty pixels remaining as possible
0035: 
0036:     # 1. Extract puzzle pieces
0037:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
0038:     assert len(objects) == 2, "There should be exactly 2 objects"
0039:     sprites = []
0040:     for obj in objects:
0041:         _b = bbox(obj != Color.BLACK)
0042:         assert _b is not None
0043:         sprites.append(crop_bbox(obj, _b))
0044:     
0045:     width = max(sprite.shape[0] for sprite in sprites) + min(sprite.shape[0] for sprite in sprites)
0046:     height = max(sprite.shape[1] for sprite in sprites) + min(sprite.shape[1] for sprite in sprites)
0047:     output_grid = np.full((width, height), Color.BLACK)
0048: 
0049:     # 2. Try to fit the pieces together
0050:     possible_placements = [ (x1, x2, y1, y2)
0051:                            for x1 in range(width - sprites[0].shape[0] + 1)
0052:                            for x2 in range(width - sprites[1].shape[0] + 1)
0053:                            for y1 in range(height - sprites[0].shape[1] + 1)
0054:                            for y2 in range(height - sprites[1].shape[1] + 1) 
0055:                            if not collision(object1=sprites[0], object2=sprites[1], r1=x1, r2=x2, c1=y1, c2=y2) ]
0056:     
0057:     def score_placement(x1, x2, y1, y2):
0058:         # We are trying to make the puzzle pieces fit together perfectly
0059:         # Therefore, there shouldn't be very many unfilled (black) pixels remaining after we place the pieces
0060:         # So we are minimizing the number of black pixels
0061:         # Equivalently maximizing the negative number of black pixels
0062:         test_canvas = np.full_like(output_grid, Color.BLACK)
0063:         paste(test_canvas, sprites[0], x1, y1, transparent=Color.BLACK, clip=True)
0064:         paste(test_canvas, sprites[1], x2, y2, transparent=Color.BLACK, clip=True)
0065:         _b = bbox(test_canvas != Color.BLACK)
0066:         assert _b is not None
0067:         test_canvas = crop_bbox(test_canvas, _b)
0068:         return -np.sum(test_canvas == Color.BLACK)
0069:     
0070:     # pick the best one
0071:     x1, x2, y1, y2 = max(possible_placements, key=lambda placement: score_placement(*placement))
0072:     paste(output_grid, sprites[0], x1, y1, transparent=Color.BLACK, clip=True)
0073:     paste(output_grid, sprites[1], x2, y2, transparent=Color.BLACK, clip=True)
0074: 
0075:     _b = bbox(output_grid != Color.BLACK)
0076:     assert _b is not None
0077:     return crop_bbox(output_grid, _b)
0078: 
0079: def generate_input():
0080:     # Create a 2-color object and then break it up into 2 pieces
0081:     two_color = random_sprite([2,3,4], [2,3,4], density=1, color_palette=Color.NOT_BLACK, background=Color.BLACK)
0082:     if len(colors_present(two_color, exclude={ Color.BLACK })) != 2:
0083:         return generate_input()
0084:     
0085:     # break it up into 2 pieces
0086:     pieces = find_components(two_color, bg=Color.BLACK, connectivity=8, monochromatic=True, return_format="objects")
0087:     if len(pieces) != 2:
0088:         return generate_input()
0089:     
0090:     # convert them to sprites and then randomly place them on a big canvas
0091:     sprites = []
0092:     for piece in pieces:
0093:         _b = bbox(piece != Color.BLACK)
0094:         assert _b is not None
0095:         sprites.append(crop_bbox(piece, _b))
0096:     width, height = np.random.randint(10, 20), np.random.randint(10, 20)
0097:     grid = np.full((width, height), Color.BLACK)
0098:     for sprite in sprites:
0099:         _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=0, padding=0, padding_connectivity=8)
0100:         if _loc is None:
0101:             raise ValueError("no placement")
0102:         r, c = _loc
0103:         paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
0104:     
0105:     return grid

