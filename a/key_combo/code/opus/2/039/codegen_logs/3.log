+    left = rng.randint(band_c[0], band_c[1] - 2)
+    if mode == "equal":
+        shape = PLUS_GLYPH
+    else:
+        shape = rng.choice((HBAR_GLYPH, VBAR_GLYPH))
+    for dr, dc in shape:
+        grid[top + dr, left + dc] = MAGENTA
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+
+    cell_h = rng.randint(3, 9)
