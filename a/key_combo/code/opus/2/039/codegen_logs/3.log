0080: def main(grid: np.ndarray) -> np.ndarray:
0081:     """Complete each colored corner frame by mirroring its internal blue pixels to the opposite side and remove blue pixels outside all frames.
0082: 
0083:     Input structure
0084:     A black background contains blue pixels and one non-blue marker color. The marker
0085:     color appears only as 2x2 L-corner triominoes, grouped into rectangular frames
0086:     with exactly one top-left, top-right, bottom-left, and bottom-right corner.
0087: 
0088:     Rule
0089:     Keep every non-blue pixel fixed. For each marker frame, keep the blue pixels
0090:     inside its bounding rectangle and also paint their reflected copies: wide
0091:     frames reflect left/right, while tall frames reflect top/bottom. Clear all
0092:     blue pixels that are outside every marker frame.
0093: 
0094:     Key insight
0095:     The colored L-corners define the frame bbox; the frame aspect ratio determines
0096:     which pair of opposite sides the blue motif must be copied between.
0097:     """
0098:     g = np.asarray(grid, dtype=int)
0099:     bg = get_bg(g)
0100:     marker_colors = colors_present(g, exclude={bg, BLUE})
0101:     assert len(marker_colors) == 1
0102:     marker = int(marker_colors[0])
0103:     frames = _find_frames(g, marker)
0104: 
0105:     out = g.copy()
0106:     out[g == BLUE] = bg
0107:     rr, cc = np.indices(g.shape)
0108: 
0109:     for top, left, bottom, right in frames:
0110:         height = bottom - top + 1
0111:         width = right - left + 1
0112:         assert height != width
0113: 
0114:         in_frame = (top <= rr) & (rr <= bottom) & (left <= cc) & (cc <= right)
0115:         blue_coords = np.argwhere((g == BLUE) & in_frame)
0116:         assert len(blue_coords) > 0
0117: 
0118:         for r, c in blue_coords:
0119:             r = int(r)
0120:             c = int(c)
0121:             if width > height:
0122:                 mr, mc = r, left + right - c
0123:             else:
0124:                 mr, mc = top + bottom - r, c
0125:             assert g[mr, mc] != marker
0126:             out[r, c] = BLUE
0127:             out[mr, mc] = BLUE
0128: 
0129:     return out
0130: 
