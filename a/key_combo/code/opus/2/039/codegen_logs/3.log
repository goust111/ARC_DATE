0067: def main(grid: np.ndarray) -> np.ndarray:
0068:     """
0069:     Emit four teal beams from a square, turning at colored obstacles per a legend.
0070: 
0071:     Input structure:
0072:     - Top band: grey (5) legend with colored vertical bars in cells; bar position (left or right) encodes turn direction.
0073:     - Below: main grid with bg, a solid teal (8) square, and colored obstacle blocks.
0074: 
0075:     Rule:
0076:     - Remove the legend from the output.
0077:     - From the teal square, shoot a beam in each cardinal direction (as a sliding copy of the square).
0078:     - Each beam paints teal over bg cells as it moves.
0079:     - On hitting an obstacle of color C, consult the legend: bar on left → turn counterclockwise, bar on right → turn clockwise. Continue in the new direction.
0080:     - Beams stop at grid edges.
0081: 
0082:     Key insight: The legend's bar position (left vs right within its cell) is the encoding for turn direction at each obstacle color.
0083:     """
0084:     g = np.asarray(grid, dtype=int)
0085: 
0086:     # Legend height: crop everything above and including the last row containing legend bg (usually 5).
0087:     # In this dataset, the legend uses a dedicated color (5) that doesn't appear below.
0088:     legend_bg = 5
0089:     rows_with_legend = np.where(np.any(g == legend_bg, axis=1))[0]
0090:     assert rows_with_legend.size, "legend rows must be present"
0091:     legend_h = int(rows_with_legend.max() + 1)
0092:     assert np.array_equal(rows_with_legend, np.arange(legend_h)), "legend color must be confined to the top band"
0093: 
0094:     legend_turn = _parse_legend(g, legend_h)
0095: 
0096:     base = g[legend_h:, :].copy()
0097:     assert base.size, "main grid must remain after legend crop"
0098: 
0099:     _vals, _cnts = np.unique(base, return_counts=True); bg = int(_vals[_cnts.argmax()])
0100:     teal = 8
0101:     src = _find_teal_square(base, teal=teal)
0102:     sr, sc, sz = src
0103: 
0104:     out = base.copy()
0105: 
0106:     def in_bounds(r: int, c: int) -> bool:
0107:         return 0 <= r and 0 <= c and r + sz - 1 < out.shape[0] and c + sz - 1 < out.shape[1]
0108: 
0109:     def paint_block(r: int, c: int) -> None:
0110:         blk = out[r : r + sz, c : c + sz]
0111:         blk[blk == bg] = teal
0112:         out[r : r + sz, c : c + sz] = blk
0113: 
0114:     def obstacle_color_at_next(nr: int, nc: int) -> int | None:
0115:         blk = out[nr : nr + sz, nc : nc + sz]
0116:         cols = set(map(int, np.unique(blk)))
0117:         cols.discard(bg)
0118:         cols.discard(teal)
0119:         if not cols:
0120:             return None
0121:         assert len(cols) == 1, "beam footprint must not hit mixed obstacle colors"
0122:         return int(next(iter(cols)))
0123: 
0124:     # Four beams, each is a moving copy of the teal square.
0125:     for d0 in range(4):
0126:         r, c, d = sr, sc, d0
0127:         seen: set[tuple[int, int, int]] = set()
0128:         while True:
0129:             state = (r, c, d)
0130:             assert state not in seen, "beam path must not cycle"
0131:             seen.add(state)
0132: 
0133:             dr, dc = _DIRS[d]
0134:             nr, nc = r + dr, c + dc
0135:             if not in_bounds(nr, nc):
0136:                 break
0137: 
0138:             oc = obstacle_color_at_next(nr, nc)
0139:             if oc is None:
0140:                 r, c = nr, nc
0141:                 paint_block(r, c)
0142:                 continue
0143: 
0144:             assert oc in legend_turn, "obstacle color must be encoded by legend"
0145:             turn = legend_turn[oc]
0146:             d = _rot_ccw(d) if turn == "L" else _rot_cw(d)
