0009: def main(grid: np.ndarray) -> np.ndarray:
0010:     """Move each vertical stream of pixels into a bottom-aligned centered pile.
0011: 
0012:     Input structure
0013:     - A mostly background grid contains one or more vertical source columns of
0014:       foreground pixels.
0015:     - Each source column has n^2 foreground pixels, and the top-to-bottom color
0016:       sequence splits into monochrome groups of lengths 1, 3, 5, ...
0017: 
0018:     Rule
0019:     - Clear the canvas to background.
0020:     - For each source column, read the foreground colors from top to bottom and
0021:       rebuild them at the bottom below the same column as odd-width centered
0022:       rows of lengths 1, 3, 5, ...
0023: 
0024:     Key insight
0025:     - The scattered vertical pixels are falling grains; a square number of
0026:       grains decomposes into the odd row widths of a centered pyramid.
0027:     """
0028:     g = np.asarray(grid, dtype=int)
0029:     bg = get_bg(g)
0030:     H, W = g.shape
0031: 
0032:     source_cols: list[tuple[int, list[int]]] = []
0033:     for c in range(W):
0034:         sequence = [int(g[r, c]) for r in range(H) if int(g[r, c]) != bg]
0035:         if sequence:
0036:             source_cols.append((c, sequence))
0037: 
0038:     assert source_cols
0039: 
0040:     out = np.full_like(g, bg)
0041:     for center_c, sequence in source_cols:
0042:         height = math.isqrt(len(sequence))
0043:         assert height * height == len(sequence)
0044:         assert height <= H
0045: 
0046:         idx = 0
0047:         for layer_idx in range(height):
0048:             width = 2 * layer_idx + 1
0049:             layer = sequence[idx : idx + width]
0050:             assert len(layer) == width
0051:             assert len(set(layer)) == 1
0052: 
0053:             r = H - height + layer_idx
0054:             c0 = center_c - layer_idx
0055:             c1 = center_c + layer_idx
0056:             assert 0 <= c0 <= c1 < W
0057:             assert np.all(out[r, c0 : c1 + 1] == bg)
0058: 
0059:             out[r, c0 : c1 + 1] = layer[0]
0060:             idx += width
0061: 
0062:         assert idx == len(sequence)
0063: 
0064:     return out
0065: 
0066: # --------------- generator (att1, Claude) ---------------
0067: 
0068: # Canvas and palette bounds.
0069: GRID_HEIGHT_RANGE = (16, 30)
0070: GRID_WIDTH_RANGE = (9, 13)
0071: BACKGROUND_COLOR = 0
0072: FOREGROUND_COLORS = [1, 2, 3, 4, 5, 6, 7, 8, 9]
0073: 
0074: # Source-column, pyramid, placement, and retry choices.
0075: SOURCE_COLUMN_COUNTS = [1, 2]
0076: PYRAMID_HEIGHTS = [2, 3]
0077: MIN_FOOTPRINT_GAP = 1
0078: MAX_GENERATION_ATTEMPTS = 300
0079: 
0080: 
