0011: def main(grid: np.ndarray) -> np.ndarray:
0012:     """
0013:     Overlay the four monochrome quadrant masks onto their common half-size canvas.
0014: 
0015:     Input structure
0016:     The input is a 2x2 arrangement of equal-size regions on a uniform background.
0017:     Each region contains foreground pixels of exactly one color, forming one mask
0018:     at the output scale.
0019: 
0020:     Rule
0021:     Start with a background output the size of one region. Stamp the masks from
0022:     back to front by quadrant position: top-left, bottom-right, bottom-left,
0023:     then top-right. Later masks overwrite earlier masks where they overlap.
0024: 
0025:     Key insight
0026:     Folding all four quadrants onto the same coordinates gives the output
0027:     canvas; the quadrant positions encode the visible layer stack.
0028:     """
0029:     g = np.asarray(grid, dtype=int)
0030:     assert g.ndim == 2, "expected a 2D grid"
0031:     height, width = map(int, g.shape)
0032:     assert height % 2 == 0 and width % 2 == 0, "input must split into four equal regions"
0033: 
0034:     region_h, region_w = height // 2, width // 2
0035:     assert region_h > 0 and region_w > 0, "quadrant regions must be nonempty"
0036: 
0037:     bg = get_bg(g)
0038:     out = np.full((region_h, region_w), bg, dtype=int)
0039: 
0040:     seen_colors: set[int] = set()
0041:     for qr, qc in _BACK_TO_FRONT_QUADRANTS:
0042:         region = g[qr * region_h : (qr + 1) * region_h, qc * region_w : (qc + 1) * region_w]
0043:         foreground_colors = colors_present(region, exclude=[bg])
0044:         assert len(foreground_colors) == 1, "each quadrant must have exactly one foreground color"
0045: 
0046:         color = foreground_colors[0]
0047:         assert color not in seen_colors, "quadrant foreground colors must be distinct"
0048:         seen_colors.add(color)
0049: 
0050:         out[region != bg] = color
0051: 
0052:     assert len(seen_colors) == 4, "expected four colored masks"
0053:     return out
0054: 
