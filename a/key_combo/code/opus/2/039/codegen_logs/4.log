+def _trace_current_state(
+    state: np.ndarray,
+    marker: tuple[int, int],
+    ray_dir: tuple[int, int],
+    *,
+    erase_obstacle: bool,
+) -> dict:
+    r, c = marker
+    dr, dc = ray_dir
+    rr = r + dr
+    cc = c + dc
+    distance = 1
+    path: list[tuple[int, int]] = []
+
+    while in_bounds(state.shape, rr, cc):
+        value = int(state[rr, cc])
+        if value == BLACK:
+            path.append((rr, cc))
+            state[rr, cc] = _distance_color(distance)
+            rr += dr
+            cc += dc
+            distance += 1
+            continue
+        if value == ORANGE:
+            if erase_obstacle:
+                state[rr, cc] = BLACK
+            return {
