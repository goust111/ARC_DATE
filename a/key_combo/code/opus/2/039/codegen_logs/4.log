+def _distance_color(distance: int) -> int:
+    mod = distance % 3
+    if mod == 1:
+        return BLUE
+    if mod == 2:
+        return GREEN
+    return YELLOW
+
+
+def _track_cells(marker: tuple[int, int], track_dir: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = marker
+    dr, dc = track_dir
+    return [(r + dr * step, c + dc * step) for step in range(1, 4)]
+
