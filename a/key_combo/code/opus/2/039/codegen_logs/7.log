                    for left in range(FRAME_BORDER_MARGIN, cols - width):
                        right = left + width - 1
                        if left in used_lefts or right in used_rights:
                            continue
                        if _gen_box_is_clear(used, top, left, bottom, right):
                            locs.append((top, left))

