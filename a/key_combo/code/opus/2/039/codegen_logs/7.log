        blue_coords = np.argwhere((g == BLUE) & in_frame)
        assert len(blue_coords) > 0

        for r, c in blue_coords:
            r = int(r)
            c = int(c)
            if width > height:
                mr, mc = r, left + right - c
            else:
                mr, mc = top + bottom - r, c
            assert g[mr, mc] != marker
            out[r, c] = BLUE
            out[mr, mc] = BLUE

    return out

