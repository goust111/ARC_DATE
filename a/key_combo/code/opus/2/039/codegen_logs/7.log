            c0 = center_c - layer_idx
            c1 = center_c + layer_idx
            assert 0 <= c0 <= c1 < W
            assert np.all(out[r, c0 : c1 + 1] == bg)

            out[r, c0 : c1 + 1] = layer[0]
            idx += width

        assert idx == len(sequence)

    return out

