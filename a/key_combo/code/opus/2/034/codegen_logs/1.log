    if not _paths_do_not_overlap(start_rows, red_cols, (height, width)):
        return None

    grid = np.zeros((height, width), dtype=int)
    grid[0, red_cols] = RED
    grid[start_rows, 0] = TEAL
    return grid


def generate_input() -> np.ndarray:
