+                    best = (h, w)
+                    best_area = area
+    return best
+
+
+def _sample_tile(rng: np.random.Generator, size: int, palette: tuple[int, ...]) -> np.ndarray:
+    for _ in range(200):
+        tile = rng.choice(np.array(palette, dtype=int), size=(size, size), replace=True)
+        if len(np.unique(tile)) != len(palette):
