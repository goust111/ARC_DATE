+
+
+def _segment_cells(segment: Segment) -> set[Coord]:
+    r0, c0, r1, c1 = segment.rect
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def _expand4(cells: set[Coord], shape: tuple[int, int]) -> set[Coord]:
