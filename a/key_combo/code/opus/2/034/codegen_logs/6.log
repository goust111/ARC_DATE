    if axis == "v":
        c = a[1]
        r0 = min(a[0], b[0]) + GEN_BLOCK_SIZE
        r1 = max(a[0], b[0]) - 1
        if r0 <= r1:
            return (r0, c, r1, c + GEN_BLOCK_SIZE - 1), axis
    return None, None


def _gen_corridor_clear(a, b, positions):
    rect, axis = _gen_corridor(a, b)
    if axis is None:
        return False
    for pos in positions:
