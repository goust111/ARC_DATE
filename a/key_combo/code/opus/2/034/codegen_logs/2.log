+    ("##", ".#", "##"),
+    ("#..#", "####"),
+    ("#.#", "###", "#.#"),
+    ("###", ".#.", "###"),
+    ("#...#", "#####"),
+    ("#####", "#...#"),
+    ("#.#.", "####"),
+)
