+            if shifts is None:
+                return None
+            inner_shift, outer_shift = shifts
+            outer["r0"] = int(row0)
+            inner["r0"] = inner_row
+            outer["c0"] = _initial_col(outer, width, outer_shift)
+            inner["c0"] = _initial_col(inner, width, inner_shift)
