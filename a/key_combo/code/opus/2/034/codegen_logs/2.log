    if not any(obj["direction"] == "right" for obj in objects_found):
        return None

    initial_boxes = [obj["src_bbox"] for obj in objects_found]
    for i, bbox_i in enumerate(initial_boxes):
        for j, bbox_j in enumerate(initial_boxes):
            if i == j:
