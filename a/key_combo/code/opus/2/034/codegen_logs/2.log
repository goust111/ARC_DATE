+def _copy_spec(spec: dict) -> dict:
+    return {
+        "direction": spec["direction"],
+        "mask": spec["mask"].copy(),
+        "h": int(spec["h"]),
+        "w": int(spec["w"]),
+        "area": int(spec["area"]),
