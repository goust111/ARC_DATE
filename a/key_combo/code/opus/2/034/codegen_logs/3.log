+            continue
+        anchor = (sr, sc + shift_c)
+        if anchor in source_halo:
+            continue
+        copy_cells = {(sr + r, sc + c + shift_c) for r, c, _color in sprite["non_anchor"]}
+        if copy_cells & source_halo:
+            continue
+        horizontal.append(
+            {
+                "axis": "h",
+                "anchor": anchor,
+                "cells": copy_cells,
+                "halo": _expand4(copy_cells),
+            }
+        )
