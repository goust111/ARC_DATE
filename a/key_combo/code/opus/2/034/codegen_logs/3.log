+        blue_count = int(rng.integers(2, len(non_anchor) - 1))
+        while len(non_anchor) - blue_count < 2:
+            blue_count = int(rng.integers(2, len(non_anchor) - 1))
+        order = list(range(len(non_anchor)))
+        rng.shuffle(order)
+        blue_indices = set(order[:blue_count])
