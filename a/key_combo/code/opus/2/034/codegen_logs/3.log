+
+BACKGROUND = int(Color.BLACK)
+BLUE = int(Color.BLUE)
+RED = int(Color.RED)
+GREEN = int(Color.GREEN)
+YELLOW = int(Color.YELLOW)
+GREY = int(Color.GREY)
