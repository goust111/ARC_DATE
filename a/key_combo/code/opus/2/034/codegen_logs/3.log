+        tr, tc = target["anchor"]
+        grid[tr, tc] = GREY
+    return grid
+
+
+def _attempt_input(rng: np.random.Generator) -> np.ndarray | None:
+    sprite = _make_sprite(rng)
+    if sprite is None:
