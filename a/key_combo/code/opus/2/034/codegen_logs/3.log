+            suffix_h[idx] = suffix_h[idx + 1] + int(candidates[idx]["axis"] == "h")
+            suffix_v[idx] = suffix_v[idx + 1] + int(candidates[idx]["axis"] == "v")
+
+        def dfs(index: int, need_h: int, need_v: int, selected: list[dict]) -> list[dict] | None:
+            if need_h == 0 and need_v == 0:
+                return selected.copy()
+            if index == len(candidates):
+                return None
+            if suffix_h[index] < need_h or suffix_v[index] < need_v:
+                return None
+
+            candidate = candidates[index]
+            if candidate["axis"] == "h":
+                next_h, next_v = need_h - 1, need_v
+            else:
+                next_h, next_v = need_h, need_v - 1
+
+            if next_h >= 0 and next_v >= 0 and _compatible(candidate, selected):
+                selected.append(candidate)
+                picked = dfs(index + 1, next_h, next_v, selected)
+                selected.pop()
+                if picked is not None:
+                    return picked
+
+            return dfs(index + 1, need_h, need_v, selected)
