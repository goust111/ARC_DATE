+        def dfs(index: int, need_h: int, need_v: int, selected: list[dict]) -> list[dict] | None:
+            if need_h == 0 and need_v == 0:
+                return selected.copy()
+            if index == len(candidates):
+                return None
+            if suffix_h[index] < need_h or suffix_v[index] < need_v:
+                return None
