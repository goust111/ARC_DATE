+    if len(horizontal) < h_needed or len(vertical) < v_needed:
+        return None
+
+    for _ in range(SELECTION_RETRIES):
+        candidates = list(horizontal) + list(vertical)
+        rng.shuffle(candidates)
+        suffix_h = [0] * (len(candidates) + 1)
+        suffix_v = [0] * (len(candidates) + 1)
+        for idx in range(len(candidates) - 1, -1, -1):
+            suffix_h[idx] = suffix_h[idx + 1] + int(candidates[idx]["axis"] == "h")
+            suffix_v[idx] = suffix_v[idx + 1] + int(candidates[idx]["axis"] == "v")
