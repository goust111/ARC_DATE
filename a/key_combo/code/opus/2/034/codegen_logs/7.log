# Canvas and sprite geometry.
_GEN_H, _GEN_W = 10, 10
_GEN_BG = 0
_GEN_SIZE = 3

# Direction colors; tuple order preserves equal random.choice weights.
_GEN_EDGE_BY_COLOR = {
