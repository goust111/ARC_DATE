+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    """ARC toolbox convention: coords are (row, col) and bboxes are inclusive."""
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
