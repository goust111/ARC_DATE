    dr, dc = offsets[0]

    inp = out.copy()
    inp[inp == OBJECT_COLOR] = BACKGROUND_COLOR
    paste(inp, sprite, target_r + dr, target_c + dc, transparent=BACKGROUND_COLOR)

    if np.array_equal(main(inp), out):
