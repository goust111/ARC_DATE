    pattern = _gen_pattern()
    if pattern is None:
        return None

    box = _gen_pick_bbox(pattern)
    if box is None:
        return None

    inp, out = _gen_render_pair(pattern, box)
    if not _gen_passes_oracle(inp, out):
        return None
    return inp


