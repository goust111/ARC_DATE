+def _coords_to_mask(coords: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    full = np.zeros(shape, dtype=int)
+    full[coords[:, 0], coords[:, 1]] = 1
+    return crop_bbox(full, bbox_coords(coords)).astype(bool)
+
