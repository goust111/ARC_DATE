        return None

    inp = out.copy()
    if not _gen_place_inner_objects(inp, containers, inner_counts, inner_plan):
        return None

    try:
        solved = main(inp)
    except Exception:
        return None
    if np.array_equal(solved, out):
        return inp
    return None


