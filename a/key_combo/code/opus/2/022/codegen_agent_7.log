+    return {
+        "grid": g,
+        "frame": frame,
+        "templates": templates,
+        "complete": complete,
+        "incomplete": incomplete,
+    }
+
+
+def _make_patch(shell_color: int, center_color: int, mask):
+    patch = np.zeros((3, 3), dtype=int)
+    for dr, dc in mask:
+        patch[dr + 1, dc + 1] = int(shell_color)
