+def _exterior_background_mask(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    mask = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if grid[r, c] == BG and not mask[r, c]:
+                mask[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if grid[r, c] == BG and not mask[r, c]:
+                mask[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == BG and not mask[nr, nc]:
+                mask[nr, nc] = True
+                q.append((nr, nc))
+    return mask
+
+
+def _bar_components(grid: np.ndarray) -> list[dict]:
+    return find_components(
+        grid,
+        bg=BG,
+        colors=[BAR],
+        connectivity=4,
+        monochromatic=True,
+        min_area=1,
+        return_format="dict",
+    )
