+    left_starts = {5: 0, 3: 0, 2: 0, 4: 0}
+    right_starts = {5: safe_w - 5, 3: safe_w - 3, 2: safe_w - 2, 4: safe_w - 4}
+    side_pattern = [0, 1, 0, 1] if random.random() < 0.5 else [1, 0, 1, 0]
+    for row, length, side in zip(chosen_rows, lengths, side_pattern):
