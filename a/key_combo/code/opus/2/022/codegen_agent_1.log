+    def backtrack(i: int) -> bool:
+        if i == len(lengths):
+            return True
+        for cells in _candidate_bars(grid, allowed, lengths[i]):
+            for r, c in cells:
+                grid[r, c] = BAR
+            if backtrack(i + 1):
