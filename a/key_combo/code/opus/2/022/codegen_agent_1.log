+    forced_corridor_length = 2 if (corridor_right - corridor_left - 2) >= 2 else None
+    if forced_corridor_length is not None and random.random() < 0.8:
+        if not _place_lengths(grid, corridor, [forced_corridor_length]):
+            raise ValueError("failed to place corridor counterexample bar")
