+            for idx, hole in enumerate(holes):
+                if all(bool(hole[r, c]) for r, c in cells):
+                    owner = idx
+                    break
+            assert owner is not None, "inside bar must belong to a unique hole"
+            hole_bar_counts[owner] += 1
