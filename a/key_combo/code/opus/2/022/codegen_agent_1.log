+    rows = {r for r, _ in coords}
+    cols = sorted(c for _, c in coords)
+    assert len(rows) == 1, "grey component must be horizontal"
+    assert cols == list(range(cols[0], cols[0] + len(cols))), "grey component must be contiguous"
