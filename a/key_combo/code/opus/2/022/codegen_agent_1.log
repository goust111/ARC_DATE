+
+def _collect_component(mask: np.ndarray, start: tuple[int, int], connectivity: int = 4) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    if not (0 <= sr < h and 0 <= sc < w) or not bool(mask[sr, sc]):
+        return []
+    seen = {start}
+    q = deque([start])
+    coords: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        coords.append((r, c))
+        for nr, nc in neighbors4(r, c):
