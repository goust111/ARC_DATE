+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _collect_component(mask: np.ndarray, start: tuple[int, int], connectivity: int = 4) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    sr, sc = start
+    if not (0 <= sr < h and 0 <= sc < w) or not bool(mask[sr, sc]):
+        return []
+    seen = {start}
+    q = deque([start])
+    coords: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        coords.append((r, c))
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+        if connectivity == 8:
+            for dr in (-1, 0, 1):
+                for dc in (-1, 0, 1):
+                    if dr == 0 and dc == 0:
+                        continue
+                    nr, nc = r + dr, c + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                        seen.add((nr, nc))
+                        q.append((nr, nc))
+    return coords
+
