+OUTER_MAP = {2: Color.BLUE, 3: Color.RED, 4: Color.YELLOW, 5: Color.ORANGE}
+INNER_MAP = {2: Color.TEAL, 3: Color.PINK, 4: Color.MAROON, 5: Color.BLUE}
