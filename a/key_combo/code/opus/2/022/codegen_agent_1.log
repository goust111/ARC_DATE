+def _validate_grid(grid: np.ndarray, layout: str) -> None:
+    assert isinstance(grid, np.ndarray)
+    assert grid.ndim == 2 and max(grid.shape) <= 30
+
+    wall_components = find_components(
+        grid,
+        bg=BG,
+        colors=[WALL],
+        connectivity=4,
+        monochromatic=True,
+        min_area=1,
+        return_format="dict",
+    )
