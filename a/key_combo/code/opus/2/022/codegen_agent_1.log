+def _safe_hole_mask(rect: tuple[int, int, int, int], shape: tuple[int, int]) -> np.ndarray:
+    top, left, height, width = rect
+    mask = np.zeros(shape, dtype=bool)
+    mask[top + 2 : top + height - 2, left + 2 : left + width - 2] = True
+    return mask
