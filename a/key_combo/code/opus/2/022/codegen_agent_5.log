+            right = np.any(out[r0 + 1 : r1, c1] == BLUE)
+            if int(top) != int(horizontal[i, j]):
+                return False
+            if int(bottom) != int(horizontal[i + 1, j]):
+                return False
+            if int(left) != int(vertical[i, j]):
