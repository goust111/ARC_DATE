+
+    for r in row_lines:
+        for c0, c1 in zip(col_lines, col_lines[1:]):
+            grid[r, c0 : c1 + 1] = GREY
+            for gap in _gap_positions(int(c0), int(c1), row_gap_offset):
+                grid[r, gap] = BLACK
+
+    for c in col_lines:
