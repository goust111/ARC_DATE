16:def main(grid: np.ndarray) -> np.ndarray:
17:    """
18:    Split the two-color object horizontally, swap its colors, and slide the upper half to the right.
19:
20:    Input structure:
21:    - The grid has one background color and exactly two foreground colors.
22:    - All foreground pixels form one 4-connected object with an even-height bbox.
23:    - The object has foreground pixels on both rows adjacent to its horizontal midpoint.
24:
25:    Rule:
26:    - Split the object into upper and lower halves at the midpoint of its bbox.
27:    - Swap the two foreground colors in both halves.
28:    - Keep the lower half in place and shift the upper half right until its lower-left
29:      boundary pixel is diagonally adjacent to the lower half's upper-right boundary pixel.
30:
31:    Key insight:
32:    - The object is not copied or reflected; it is broken at the horizontal waist,
33:      recolored by exchanging the two visible object colors, then rejoined diagonally.
34:    """
35:    g = np.asarray(grid, dtype=int)
36:    assert g.ndim == 2, "expected a 2D grid"
37:
38:    bg = get_bg(g)
39:    colors = colors_present(g, exclude={bg})
40:    assert len(colors) == 2, "expected exactly two foreground colors"
41:    color_a, color_b = colors
42:
43:    objects = find_components(g, bg=bg, connectivity=4, monochromatic=False)
44:    assert len(objects) == 1, "expected one connected foreground object"
45:    r0, _c0, r1, _c1 = objects[0]["bbox"]
46:    height = int(r1 - r0 + 1)
47:    assert height % 2 == 0, "object bbox height must split evenly"
48:
49:    split_row = int(r0 + height // 2)
50:    row_ids = np.arange(g.shape[0])[:, None]
51:    fg = g != int(bg)
52:    upper = fg & (row_ids < split_row)
53:    lower = fg & (row_ids >= split_row)
54:    assert np.any(upper), "expected a nonempty upper half"
55:    assert np.any(lower), "expected a nonempty lower half"
56:    assert int(upper.sum()) == int(lower.sum()), "expected equal upper and lower areas"
57:
58:    upper_boundary_cols = np.flatnonzero(upper[split_row - 1])
59:    lower_boundary_cols = np.flatnonzero(lower[split_row])
60:    assert upper_boundary_cols.size > 0, "upper half must touch the split boundary"
61:    assert lower_boundary_cols.size > 0, "lower half must touch the split boundary"
62:
63:    shift = int(lower_boundary_cols.max() + 1 - upper_boundary_cols.min())
64:    assert shift > 0, "upper half must shift right"
65:
66:    upper_rows, upper_cols = np.where(upper)
67:    lower_rows, lower_cols = np.where(lower)
68:    shifted_upper_cols = upper_cols + shift
69:    assert int(shifted_upper_cols.max()) < g.shape[1], "shifted upper half must fit in the grid"
70:
71:    out = np.full_like(g, int(bg))
72:    out[lower_rows, lower_cols] = _swapped_values(g[lower_rows, lower_cols], color_a, color_b)
73:    out[upper_rows, shifted_upper_cols] = _swapped_values(g[upper_rows, upper_cols], color_a, color_b)
74:    return out
