+def _spec_output_radius(spec: dict) -> int:
+    radius = int(spec["radius"])
+    count = int(spec["count"])
+    return radius + 1 if count % 2 == 0 else radius - 1
+
+
+def _center_candidates(spec: dict, placed: list[dict]) -> list[tuple[int, int]]:
+    radius = int(spec["radius"])
