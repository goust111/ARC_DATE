+
+
+def _same_specs(a: list[dict], b: list[dict]) -> bool:
+    key = lambda spec: (spec["color"], spec["center"], spec["radius"])
+    return sorted((key(spec) for spec in a)) == sorted((key(spec) for spec in b))
+
