+def _diamond_interior_coords(cr: int, cc: int, radius: int) -> list[tuple[int, int]]:
+    pts: list[tuple[int, int]] = []
+    for dr in range(-(radius - 1), radius):
+        span = radius - 1 - abs(dr)
+        rr = cr + dr
+        for dc in range(-span, span + 1):
+            pts.append((rr, cc + dc))
