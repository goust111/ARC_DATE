+def _neighbors(coords: tuple[int, int], connectivity: int) -> Iterable[tuple[int, int]]:
+    r, c = coords
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+        return
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
