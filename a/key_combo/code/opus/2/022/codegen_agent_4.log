+        if len(chosen) == count:
+            return True
+        remaining = count - len(chosen)
+        if len(interior) - start < remaining:
+            return False
+        for idx in range(start, len(interior)):
+            cell = interior[idx]
+            if any(abs(cell[0] - rr) + abs(cell[1] - cc2) == 1 for rr, cc2 in chosen):
+                continue
+            chosen.append(cell)
+            if rec(idx + 1):
+                return True
+            chosen.pop()
+        return False
+
+    return chosen if rec(0) else None
+
