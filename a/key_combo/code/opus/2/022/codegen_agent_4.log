+
+def _extract_diamonds(grid: np.ndarray) -> list[dict]:
+    specs: list[dict] = []
+    for color in sorted(int(c) for c in np.unique(grid) if c not in (BG, MARKER)):
+        for coords in _components(grid == color, connectivity=8):
