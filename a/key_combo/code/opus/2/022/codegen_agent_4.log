+    for dr in range(-radius, radius + 1):
+        dc = radius - abs(dr)
+        rr = cr + dr
+        if dc == 0:
+            pts.append((rr, cc))
+        else:
+            pts.append((rr, cc - dc))
+            pts.append((rr, cc + dc))
+    return pts
