+    for r in range(0, height, 2):
+        segment = out[r, c0 : c1 + 1]
+        if (r // 2) % 3 == 2:
+            row_mask = out[r] != BG
+            out[r, row_mask] = GREEN
+            segment[segment == BG] = GREEN
+        else:
