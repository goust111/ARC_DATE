# Glyph sequence, canvas, and retry configuration.
GEN_GLYPH_COUNT = 5
GEN_NUM_VERTICAL = 2
GEN_STEP_CHOICES = (-1, 1)
GEN_INPUT_ROWS = 2
GEN_INPUT_WIDTH = 3 * GEN_GLYPH_COUNT - GEN_NUM_VERTICAL - 1
GEN_OUTPUT_WIDTH = GEN_INPUT_WIDTH // 2 + 1
GEN_RETRY_LIMIT = 300


def _sample_steps() -> list[int | None] | None:
    """Sample glyph instructions and reject paths that leave the output."""
    col = GEN_OUTPUT_WIDTH // 2
    vertical_positions = set(random.sample(range(GEN_GLYPH_COUNT), GEN_NUM_VERTICAL))
    steps: list[int | None] = []

    for pos in range(GEN_GLYPH_COUNT):
        if pos in vertical_positions:
            steps.append(None)
            continue

        choices = list(GEN_STEP_CHOICES)
        random.shuffle(choices)
        valid = [step for step in choices if 0 <= col + step < GEN_OUTPUT_WIDTH]
        if not valid:
            return None
        step = random.choice(valid)
        steps.append(step)
        col += step
    return steps


def _encode_input(steps: list[int | None]) -> np.ndarray:
    """Encode sampled instructions into the two-row glyph strip."""
    grid = np.full((GEN_INPUT_ROWS, GEN_INPUT_WIDTH), Color.BLACK, dtype=int)
    c = 0
    for step in steps:
        if step is None:
            grid[:, c] = Color.RED
            c += 1
        else:
            top_offset = 0 if step == 1 else 1
            grid[0, c + top_offset] = Color.RED
            grid[1, c : c + 2] = Color.RED
            c += 2
        if c < GEN_INPUT_WIDTH:
            c += 1
    return grid


def _render_expected(steps: list[int | None]) -> np.ndarray:
    """Render the decoded output used to validate the generated strip."""
    out_h = 1 + sum(2 if step is None else 1 for step in steps)
    expected = np.full((out_h, GEN_OUTPUT_WIDTH), Color.BLACK, dtype=int)
    r = 0
    col = GEN_OUTPUT_WIDTH // 2
    expected[r, col] = Color.GREEN
    r += 1
    for step in steps:
        if step is None:
            expected[r : r + 2, col] = Color.RED
            r += 2
        else:
            expected[r, col] = Color.RED
            expected[r, col + step] = Color.RED
            col += step
            r += 1
    return expected


def _gen_attempt() -> np.ndarray | None:
    steps = _sample_steps()
    if steps is None:
        return None
    grid = _encode_input(steps)
    return grid if np.array_equal(main(grid), _render_expected(steps)) else None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        if (grid := _gen_attempt()) is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg
import random


def _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:
    rows: list[tuple[int, int]] = []
    for r in range(g.shape[0]):
        row_colors = set(map(int, g[r]))
        if len(row_colors) == 1:
            color = next(iter(row_colors))
            if int(color) != int(bg):
                rows.append((int(r), int(color)))
    assert len(rows) == 1, "expected exactly one solid non-background divider row"
    return rows[0]


def _unique_widest_row(coords: np.ndarray) -> int:
    row_counts: list[tuple[int, int]] = []
    for r in sorted(set(map(int, coords[:, 0]))):
        row_cols = np.sort(coords[coords[:, 0] == r, 1])
        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))
        row_counts.append((int(row_cols.size), int(r)))

    max_count = max(count for count, _r in row_counts)
    widest = [r for count, r in row_counts if count == max_count]
    assert max_count > 1, "multi-column sprites must have a horizontal span"
    assert len(widest) == 1, "expected a unique widest horizontal row"
    return int(widest[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.

    Input structure:
    - The background is the dominant color.
    - One non-background color forms a single full-width horizontal divider row.
    - The other non-background color forms 4-connected sprites above the divider.

    Rule:
    - Clear the original sprite pixels.
    - A one-column sprite falls to the bottom of its column and deletes the divider
      pixel it crossed.
    - Any wider sprite falls until its unique widest horizontal row is immediately
      above the divider row; if the moved sprite overlaps the divider, it covers it.

    Key insight:
    The red row is not a generic floor: only one-column sprites pass through to the
    bottom, while wider sprites are registered by their widest horizontal segment.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))
    line_r, line_color = _divider_row(g, bg)

    non_bg_colors = set(map(int, g.ravel())) - {bg}
    sprite_colors = non_bg_colors - {line_color}
    assert len(sprite_colors) == 1, "expected exactly one sprite color"
    sprite_color = next(iter(sprite_colors))

    sprites = find_components(
        g,
        bg=bg,
        colors=[sprite_color],
        connectivity=4,
        monochromatic=True,
    )
    assert sprites, "expected at least one sprite"

    out = g.copy()
    out[g == sprite_color] = bg
    occupied = np.zeros((H, W), dtype=bool)

    for sprite in sprites:
        coords = sprite["coords"]
        _r0, c0, r1, c1 = map(int, sprite["bbox"])
        assert r1 < line_r, "all sprites must begin above the divider"

        if c0 == c1:
            shift = H - 1 - r1
            assert shift >= 0
            assert int(out[line_r, c0]) == line_color
            out[line_r, c0] = bg
        else:
            widest_r = _unique_widest_row(coords)
            shift = line_r - 1 - widest_r
            assert shift >= 0

        moved = coords.copy()
        moved[:, 0] += shift
        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))
        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))

        for rr, cc in moved:
            r = int(rr)
            c = int(cc)
            assert not occupied[r, c], "moved sprites must not overlap"
            occupied[r, c] = True
            out[r, c] = sprite_color

    return out

