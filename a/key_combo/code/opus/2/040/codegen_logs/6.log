+def _rotate_ccw(pivot: tuple[int, int], source: tuple[int, int]) -> tuple[int, int]:
+    pr, pc = pivot
+    sr, sc = source
+    dr = sr - pr
+    dc = sc - pc
+    return pr - dc, pc + dr
