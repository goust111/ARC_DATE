+            assert color not in bars, "expected one horizontal bar per color"
+            bars[color] = {"row": int(r), "gap_col": int(gap_col)}
+    assert MIN_BARS <= len(bars) <= MAX_BARS, "expected 3 to 5 bars"
+    return bars
+
