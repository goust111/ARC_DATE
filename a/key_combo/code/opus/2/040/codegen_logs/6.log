from __future__ import annotations

from collections import Counter

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def _shape_key(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor each 8-connected foreground object by whether its normalized shape is repeated or unique.

    Input structure
    - The dominant background contains several same-color foreground objects.
    - Objects are 8-connected; diagonal contact joins pixels into the same object.
    - Up to translation within each bbox, exactly one object shape appears once
      and exactly one other object shape appears multiple times.

    Rule
    - Group foreground objects by their normalized bbox mask.
    - Recolor the singleton-shape object red.
    - Recolor every repeated-shape object blue.
    - Keep the background unchanged.

    Key insight
    - The recolor is determined by object-shape frequency, not by position or size alone.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"

    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1, "expected one foreground color"

    components = find_components(
        g,
        bg=bg,
        connectivity=8,
        monochromatic=True,
        colors=fg_colors,
        return_format="dict",
    )
    assert len(components) >= 2, "expected multiple foreground objects"

    shape_keys = [_shape_key(component["coords"]) for component in components]
    counts = Counter(shape_keys)
    singleton_shapes = {key for key, count in counts.items() if count == 1}
    repeated_shapes = {key for key, count in counts.items() if count > 1}
    assert len(singleton_shapes) == 1, "expected exactly one singleton object shape"
    assert len(repeated_shapes) == 1, "expected exactly one repeated object shape"

    out = g.copy()
    for component, shape_key in zip(components, shape_keys):
        coords = component["coords"]
        color = 2 if shape_key in singleton_shapes else 1
        out[coords[:, 0], coords[:, 1]] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas/colors.
GEN_GRID_SHAPE = (10, 10)
GEN_BG, GEN_FG = 0, 8
GEN_OUT_REPEATED, GEN_OUT_SINGLETON = 1, 2
# Shape sampling.
SHAPE_HEIGHT_RANGE = (2, 4)
SHAPE_WIDTH_RANGE = (2, 5)
SHAPE_AREA_RANGE = (4, 10)
SHAPE_FLIP_PROB = 0.5
SHAPE_PAIR_RETRIES = 60
NEIGHBOR_DELTAS_8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
# Placement/retries.
PLACEMENT_PADDING, PLACEMENT_CONNECTIVITY = 1, 8
GENERATION_RETRIES = 300


def _gen_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    coords = np.argwhere(mask)
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))


def _gen_dihedral_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    forms = []
    base = mask.astype(bool)
    for k in range(4):
        rot = np.rot90(base, k)
        forms.append(_gen_key(rot))
        forms.append(_gen_key(np.fliplr(rot)))
    return min(forms)


def _gen_random_shape() -> np.ndarray:
    h = random.randint(*SHAPE_HEIGHT_RANGE)
    w = random.randint(*SHAPE_WIDTH_RANGE)
    area = random.randint(max(SHAPE_AREA_RANGE[0], h, w), min(SHAPE_AREA_RANGE[1], h * w))

    path_len = random.randint(max(h, w), min(h + w - 1, area))
    diag_count = h + w - 1 - path_len
    steps = (
        [(1, 1)] * diag_count
        + [(1, 0)] * (h - 1 - diag_count)
        + [(0, 1)] * (w - 1 - diag_count)
    )
    random.shuffle(steps)

    mask = np.zeros((h, w), dtype=bool)
    r = c = 0
    mask[r, c] = True
    for dr, dc in steps:
        r += dr
        c += dc
        mask[r, c] = True

    while int(mask.sum()) < area:
        frontier = set()
        for rr, cc in np.argwhere(mask):
            for dr, dc in NEIGHBOR_DELTAS_8:
                nr = int(rr) + dr
                nc = int(cc) + dc
                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
                    frontier.add((nr, nc))
        if not frontier:
            break
        nr, nc = random.choice(tuple(frontier))
        mask[nr, nc] = True

    if random.random() < SHAPE_FLIP_PROB:
        mask = np.fliplr(mask)
    if random.random() < SHAPE_FLIP_PROB:
        mask = np.flipud(mask)
    return mask


def _gen_pair_shapes() -> tuple[np.ndarray, np.ndarray] | None:
    shape_a = _gen_random_shape()
    key_a = _gen_dihedral_key(shape_a)
    for _ in range(SHAPE_PAIR_RETRIES):
        shape_b = _gen_random_shape()
        if _gen_dihedral_key(shape_b) != key_a:
            return shape_a, shape_b
    return None


def _render_candidate(shape_a: np.ndarray, shape_b: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    inp = np.zeros(GEN_GRID_SHAPE, dtype=int)
    expected = np.zeros(GEN_GRID_SHAPE, dtype=int)
    pieces = [
        (shape_a, GEN_OUT_REPEATED),
        (shape_a, GEN_OUT_REPEATED),
        (shape_b, GEN_OUT_SINGLETON),
    ]
    random.shuffle(pieces)

    for mask, out_color in pieces:
        in_patch = np.where(mask, GEN_FG, GEN_BG)
        out_patch = np.where(mask, out_color, GEN_BG)
        r, c = random_free_location(
            inp,
            in_patch,
            transparent=GEN_BG,
            padding=PLACEMENT_PADDING,
            padding_connectivity=PLACEMENT_CONNECTIVITY,
        )
        paste(inp, in_patch, r, c, transparent=GEN_BG)
        paste(expected, out_patch, r, c, transparent=GEN_BG)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    pair = _gen_pair_shapes()
    if pair is None:
        return None
    try:
        inp, expected = _render_candidate(*pair)
        actual = main(inp)
    except Exception:
        return None

    return inp if np.array_equal(actual, expected) else None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("failed to generate a valid b230c067 input")
from __future__ import annotations
from collections import Counter, defaultdict, deque
import random
import numpy as np
from scipy.ndimage import label as scipy_label
from arc_utils import bbox_h, bbox_w, find_components, in_bounds, neighbors4, paste

def main(grid: np.ndarray) -> np.ndarray:
    """
    Slide a solid square through a winding channel to reach a same-sized target square.

    Input structure:
    - bg (most common color). A river color forms a winding corridor.
    - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.

    Rule:
    - The mover square travels along the river toward the destination.
    - It can only pass through positions where the full NxN area is river.
    - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.
    - The mover's original position is filled with the river color.

    Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.
    """
    g = np.array(grid, dtype=int)
    H, W = g.shape

    # Corner-majority background (more stable than global mode here).
    bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])

    # Detect solid square components (excluding bg).
    squares: list[dict] = []
    for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
        col = int(comp["color"])
        b = comp["bbox"]
        if bbox_h(b) != bbox_w(b):
            continue
        patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
        if not bool((patch == int(col)).all()):
            continue
        squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})

    assert not (len(squares) < 2)

    # Choose the size that appears at least twice (most common size).
    by_n: dict[int, list[dict]] = defaultdict(list)
    for s in squares:
        by_n[int(s["n"])].append(s)
    nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
    cand = by_n[int(nside)]
    assert not (len(cand) < 2)

    cand.sort(key=lambda s: int(s["col"]))
    mover = cand[0]
    dest = cand[1]

    n = int(mover["n"])
    sr, sc = int(mover["r0"]), int(mover["c0"])
    dr, dc = int(dest["r0"]), int(dest["c0"])

    # River = most common remaining color (excluding bg and the two square colors).
    counts = Counter(map(int, g.flatten()))
    river = None
    for col, _ct in counts.most_common():
        if int(col) == int(bg):
            continue
        if int(col) in (int(mover["col"]), int(dest["col"])):
            continue
        river = int(col)
        break
    assert not (river is None)

    trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))

    # Feasible top-left placements: NxN window fully inside trav.
    h2 = int(H - n + 1)
    w2 = int(W - n + 1)
    assert not (h2 <= 0 or w2 <= 0)
    assert not (not (0 <= sr < h2 and 0 <= sc < w2))

    feasible = np.zeros((h2, w2), dtype=bool)
    for r in range(h2):
        for c in range(w2):
            if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
                feasible[int(r), int(c)] = True
    assert not (not bool(feasible[int(sr), int(sc)]))

    # BFS on placement grid.
    dist = -np.ones((h2, w2), dtype=int)
    q = deque([(int(sr), int(sc))])
    dist[int(sr), int(sc)] = 0
    DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    while q:
        r, c = q.popleft()
        for dr2, dc2 in DIR4:
            rr = int(r + dr2)
            cc = int(c + dc2)
            if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
                dist[rr, cc] = int(dist[int(r), int(c)] + 1)
                q.append((int(rr), int(cc)))

    # Pick target.
    if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:
        tr, tc = int(dr), int(dc)
    else:
        best = -1
        tr, tc = int(sr), int(sc)
        for r in range(h2):
            for c in range(w2):
                if int(dist[int(r), int(c)]) > best:
                    best = int(dist[int(r), int(c)])
                    tr, tc = int(r), int(c)

    out = g.copy()
    out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
    out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
    return out


