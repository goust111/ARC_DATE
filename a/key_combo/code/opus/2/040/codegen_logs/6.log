+def _neighbors8(shape: tuple[int, int], r: int, c: int) -> Iterable[tuple[int, int]]:
+    height, width = shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < height and 0 <= cc < width:
+                yield rr, cc
