+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIVIDER_COLOR = 0
+SHAPE_COLOR = 5
+REGION_BG_COLOR = 9
+
+UNIQUE_OUT = 2
+RARE_OUT = 4
+COMMON_OUT = 1
+
+GEN_RETRIES = 400
+LAYOUTS = ((3, 3), (4, 3))
+COUNT_PATTERNS = {
+    9: (
+        (1, 2, 3, 3),
+        (1, 2, 2, 4),
+        (1, 1, 2, 2, 3),
+        (1, 2, 6),
+    ),
+    12: (
+        (1, 2, 3, 3, 3),
+        (1, 2, 2, 3, 4),
