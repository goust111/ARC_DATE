+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+DIVIDER_COLOR = 0
+SHAPE_COLOR = 5
+REGION_BG_COLOR = 9
+
+UNIQUE_OUT = 2
+RARE_OUT = 4
+COMMON_OUT = 1
+
+GEN_RETRIES = 400
+LAYOUTS = ((3, 3), (4, 3))
+COUNT_PATTERNS = {
+    9: (
+        (1, 2, 3, 3),
+        (1, 2, 2, 4),
+        (1, 1, 2, 2, 3),
+        (1, 2, 6),
+    ),
+    12: (
+        (1, 2, 3, 3, 3),
+        (1, 2, 2, 3, 4),
+        (1, 1, 2, 2, 3, 3),
+        (1, 2, 4, 5),
+        (1, 2, 3, 6),
+    ),
+}
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[int(np.argmax(counts))])
+
+
+def _crop_bbox(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise ValueError("cannot crop an empty mask")
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    cropped = _crop_bbox(np.asarray(mask, dtype=bool))
+    return tuple(tuple(int(cell) for cell in row) for row in cropped.astype(int))
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((int(rr), int(cc)))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
