+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BACKGROUND = 5
+RECT_COLOR = 9
+SHAPE_COLOR = 4
+RAY_COLORS = (1, 2, 3)
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
