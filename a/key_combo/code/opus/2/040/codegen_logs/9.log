from __future__ import annotations

from collections import Counter

import numpy as np

from arc_utils import colors_present, find_components, get_bg, paste, random_free_location
import random


def _shape_key(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))


def main(grid: np.ndarray) -> np.ndarray:
    """
    Recolor each 8-connected foreground object by whether its normalized shape is repeated or unique.

    Input structure
    - The dominant background contains several same-color foreground objects.
    - Objects are 8-connected; diagonal contact joins pixels into the same object.
    - Up to translation within each bbox, exactly one object shape appears once
      and exactly one other object shape appears multiple times.

    Rule
    - Group foreground objects by their normalized bbox mask.
    - Recolor the singleton-shape object red.
    - Recolor every repeated-shape object blue.
    - Keep the background unchanged.

    Key insight
    - The recolor is determined by object-shape frequency, not by position or size alone.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"

    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1, "expected one foreground color"

    components = find_components(
        g,
        bg=bg,
        connectivity=8,
        monochromatic=True,
        colors=fg_colors,
        return_format="dict",
    )
    assert len(components) >= 2, "expected multiple foreground objects"

    shape_keys = [_shape_key(component["coords"]) for component in components]
    counts = Counter(shape_keys)
    singleton_shapes = {key for key, count in counts.items() if count == 1}
    repeated_shapes = {key for key, count in counts.items() if count > 1}
    assert len(singleton_shapes) == 1, "expected exactly one singleton object shape"
    assert len(repeated_shapes) == 1, "expected exactly one repeated object shape"

    out = g.copy()
    for component, shape_key in zip(components, shape_keys):
        coords = component["coords"]
        color = 2 if shape_key in singleton_shapes else 1
        out[coords[:, 0], coords[:, 1]] = color

    return out

# --------------- generator (o5x) ---------------

# Canvas/colors.
GEN_GRID_SHAPE = (10, 10)
GEN_BG, GEN_FG = 0, 8
GEN_OUT_REPEATED, GEN_OUT_SINGLETON = 1, 2
# Shape sampling.
SHAPE_HEIGHT_RANGE = (2, 4)
SHAPE_WIDTH_RANGE = (2, 5)
SHAPE_AREA_RANGE = (4, 10)
SHAPE_FLIP_PROB = 0.5
SHAPE_PAIR_RETRIES = 60
NEIGHBOR_DELTAS_8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
# Placement/retries.
PLACEMENT_PADDING, PLACEMENT_CONNECTIVITY = 1, 8
GENERATION_RETRIES = 300


def _gen_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    coords = np.argwhere(mask)
    r0 = int(coords[:, 0].min())
    c0 = int(coords[:, 1].min())
    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))


def _gen_dihedral_key(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
    forms = []
    base = mask.astype(bool)
    for k in range(4):
        rot = np.rot90(base, k)
        forms.append(_gen_key(rot))
        forms.append(_gen_key(np.fliplr(rot)))
    return min(forms)


def _gen_random_shape() -> np.ndarray:
    h = random.randint(*SHAPE_HEIGHT_RANGE)
    w = random.randint(*SHAPE_WIDTH_RANGE)
    area = random.randint(max(SHAPE_AREA_RANGE[0], h, w), min(SHAPE_AREA_RANGE[1], h * w))

    path_len = random.randint(max(h, w), min(h + w - 1, area))
    diag_count = h + w - 1 - path_len
    steps = (
        [(1, 1)] * diag_count
        + [(1, 0)] * (h - 1 - diag_count)
        + [(0, 1)] * (w - 1 - diag_count)
    )
    random.shuffle(steps)

    mask = np.zeros((h, w), dtype=bool)
    r = c = 0
    mask[r, c] = True
    for dr, dc in steps:
        r += dr
        c += dc
        mask[r, c] = True

    while int(mask.sum()) < area:
        frontier = set()
        for rr, cc in np.argwhere(mask):
            for dr, dc in NEIGHBOR_DELTAS_8:
                nr = int(rr) + dr
                nc = int(cc) + dc
                if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
                    frontier.add((nr, nc))
        if not frontier:
            break
        nr, nc = random.choice(tuple(frontier))
        mask[nr, nc] = True

    if random.random() < SHAPE_FLIP_PROB:
        mask = np.fliplr(mask)
    if random.random() < SHAPE_FLIP_PROB:
        mask = np.flipud(mask)
    return mask


def _gen_pair_shapes() -> tuple[np.ndarray, np.ndarray] | None:
    shape_a = _gen_random_shape()
    key_a = _gen_dihedral_key(shape_a)
    for _ in range(SHAPE_PAIR_RETRIES):
        shape_b = _gen_random_shape()
        if _gen_dihedral_key(shape_b) != key_a:
            return shape_a, shape_b
    return None


def _render_candidate(shape_a: np.ndarray, shape_b: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    inp = np.zeros(GEN_GRID_SHAPE, dtype=int)
    expected = np.zeros(GEN_GRID_SHAPE, dtype=int)
    pieces = [
        (shape_a, GEN_OUT_REPEATED),
        (shape_a, GEN_OUT_REPEATED),
        (shape_b, GEN_OUT_SINGLETON),
    ]
    random.shuffle(pieces)

    for mask, out_color in pieces:
        in_patch = np.where(mask, GEN_FG, GEN_BG)
        out_patch = np.where(mask, out_color, GEN_BG)
        r, c = random_free_location(
            inp,
            in_patch,
            transparent=GEN_BG,
            padding=PLACEMENT_PADDING,
            padding_connectivity=PLACEMENT_CONNECTIVITY,
        )
        paste(inp, in_patch, r, c, transparent=GEN_BG)
        paste(expected, out_patch, r, c, transparent=GEN_BG)
    return inp, expected


def _gen_attempt() -> np.ndarray | None:
    pair = _gen_pair_shapes()
    if pair is None:
        return None
    try:
        inp, expected = _render_candidate(*pair)
        actual = main(inp)
    except Exception:
        return None

    return inp if np.array_equal(actual, expected) else None


def generate_input() -> np.ndarray:
    for _ in range(GENERATION_RETRIES):
        result = _gen_attempt()
        if result is not None:
            return result
    raise RuntimeError("failed to generate a valid b230c067 input")
import numpy as np

from arc_utils import Color, crop_bbox, find_components
import random


def _glyphs(g: np.ndarray) -> list[int | None]:
    comps = find_components(g, bg=Color.BLACK, colors=[Color.RED], connectivity=4)
    comps = sorted(comps, key=lambda comp: comp["bbox"][1])

    glyphs: list[int | None] = []
    for comp in comps:
        r0, _c0, r1, _c1 = comp["bbox"]
        assert (r0, r1) == (0, 1)

        mask = crop_bbox(g == Color.RED, comp["bbox"])
        assert mask.shape[0] == 2
        assert mask.shape[1] in (1, 2)

        top_cols = np.flatnonzero(mask[0])
        bottom_cols = np.flatnonzero(mask[1])
        assert len(top_cols) == 1
        assert len(bottom_cols) in (1, 2)

        entry = int(top_cols[0])
        bottom = [int(c) for c in bottom_cols]
        assert entry in bottom

        if len(bottom) == 1:
            glyphs.append(None)
            continue

        exit_cols = [c for c in bottom if c != entry]
        assert len(exit_cols) == 1
        step = exit_cols[0] - entry
        assert abs(step) == 1
        glyphs.append(step)

    assert glyphs
    return glyphs


def main(grid: np.ndarray) -> np.ndarray:
    """Decode the two-row red glyph strip into a downward red trace starting from a centered green marker.

    Input structure
    - The input is a black 2-row strip containing 4-connected red glyphs, read left to right.
    - Each glyph spans both rows and has exactly one top red entry cell; its bottom row is either the same cell only or a two-cell elbow.
    Rule
    - Make a black output whose width is one more than half the input width and whose height is one marker row plus one row for each elbow and two rows for each vertical glyph.
    - Put a green marker in the center of the top row, then trace the glyphs downward: a vertical glyph paints two red cells in the current column; an elbow paints the two bottom cells as a horizontal red segment and moves the current column left or right.
    Key insight
    - The missing top cell of each 2x2 elbow tells whether the trace exits left or right; the glyphs are pipe instructions rather than shapes to copy literally.
    """
    g = np.asarray(grid, dtype=int)
    assert g.shape[0] == 2
    assert g.shape[1] % 2 == 0
    assert set(map(int, np.unique(g))) == {Color.BLACK, Color.RED}

    glyphs = _glyphs(g)
    out_h = 1 + sum(2 if step is None else 1 for step in glyphs)
    out_w = g.shape[1] // 2 + 1
    out = np.full((out_h, out_w), Color.BLACK, dtype=int)

    r = 0
    c = out_w // 2
    out[r, c] = Color.GREEN
    r += 1

    for step in glyphs:
        if step is None:
            assert r + 1 < out_h
            out[r : r + 2, c] = Color.RED
            r += 2
        else:
            next_c = c + step
            assert 0 <= next_c < out_w
            out[r, c] = Color.RED
            out[r, next_c] = Color.RED
            r += 1
            c = next_c

    assert r == out_h
    return out

# --------------- generator (o5x) ---------------
# Glyph sequence, canvas, and retry configuration.
GEN_GLYPH_COUNT = 5
GEN_NUM_VERTICAL = 2
GEN_STEP_CHOICES = (-1, 1)
GEN_INPUT_ROWS = 2
GEN_INPUT_WIDTH = 3 * GEN_GLYPH_COUNT - GEN_NUM_VERTICAL - 1
GEN_OUTPUT_WIDTH = GEN_INPUT_WIDTH // 2 + 1
GEN_RETRY_LIMIT = 300


def _sample_steps() -> list[int | None] | None:
    """Sample glyph instructions and reject paths that leave the output."""
    col = GEN_OUTPUT_WIDTH // 2
    vertical_positions = set(random.sample(range(GEN_GLYPH_COUNT), GEN_NUM_VERTICAL))
    steps: list[int | None] = []

    for pos in range(GEN_GLYPH_COUNT):
        if pos in vertical_positions:
            steps.append(None)
            continue

        choices = list(GEN_STEP_CHOICES)
        random.shuffle(choices)
        valid = [step for step in choices if 0 <= col + step < GEN_OUTPUT_WIDTH]
        if not valid:
            return None
        step = random.choice(valid)
        steps.append(step)
        col += step
    return steps


def _encode_input(steps: list[int | None]) -> np.ndarray:
    """Encode sampled instructions into the two-row glyph strip."""
    grid = np.full((GEN_INPUT_ROWS, GEN_INPUT_WIDTH), Color.BLACK, dtype=int)
    c = 0
    for step in steps:
        if step is None:
            grid[:, c] = Color.RED
            c += 1
        else:
            top_offset = 0 if step == 1 else 1
            grid[0, c + top_offset] = Color.RED
            grid[1, c : c + 2] = Color.RED
            c += 2
        if c < GEN_INPUT_WIDTH:
            c += 1
    return grid


def _render_expected(steps: list[int | None]) -> np.ndarray:
    """Render the decoded output used to validate the generated strip."""
    out_h = 1 + sum(2 if step is None else 1 for step in steps)
    expected = np.full((out_h, GEN_OUTPUT_WIDTH), Color.BLACK, dtype=int)
    r = 0
    col = GEN_OUTPUT_WIDTH // 2
    expected[r, col] = Color.GREEN
    r += 1
    for step in steps:
        if step is None:
            expected[r : r + 2, col] = Color.RED
            r += 2
        else:
            expected[r, col] = Color.RED
            expected[r, col + step] = Color.RED
            col += step
            r += 1
    return expected


def _gen_attempt() -> np.ndarray | None:
    steps = _sample_steps()
    if steps is None:
        return None
    grid = _encode_input(steps)
    return grid if np.array_equal(main(grid), _render_expected(steps)) else None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        if (grid := _gen_attempt()) is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
import numpy as np

from arc_utils import Color, colors_present, components_mask


def main(grid: np.ndarray) -> np.ndarray:
    """Compare the two stacked half-size masks and emit pink where exactly one mask is filled.

    Input structure
    - The input has even height and is vertically partitioned into two equal-size regions.
    - The two regions share one background color, and each region has exactly one foreground color.
    Rule
    - Align the top and bottom regions by position.
    - Output pink at positions where exactly one corresponding input cell is foreground.
    - Output the shared background at positions where both cells agree as background or foreground.
    Key insight
    - The result is the symmetric difference of the two stacked foreground masks.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    height, width = g.shape
    assert height % 2 == 0

    half = height // 2
    top = g[:half, :]
    bottom = g[half:, :]

    common_colors = set(colors_present(top)) & set(colors_present(bottom))
    assert len(common_colors) == 1
    bg = common_colors.pop()

    top_colors = colors_present(top, exclude={bg})
    bottom_colors = colors_present(bottom, exclude={bg})
    assert len(top_colors) == 1
    assert len(bottom_colors) == 1
    assert top_colors[0] != bottom_colors[0]

    out = np.full((half, width), bg, dtype=int)
    out[(top != bg) ^ (bottom != bg)] = Color.PINK
    return out

# --------------- generator (o5x) ---------------
# Fixed canvas and colors observed in all task examples.
HALF_HEIGHT, WIDTH = 3, 5
TOTAL_CELLS = HALF_HEIGHT * WIDTH
BACKGROUND_COLOR, TOP_COLOR, BOTTOM_COLOR = Color.BLACK, Color.MAROON, Color.YELLOW

# Foreground/overlap ranges and inclusive XOR size bounds.
TOP_COUNT_RANGE, BOTTOM_COUNT_RANGE, OVERLAP_RANGE = range(5, 10), range(8, 11), range(3, 8)
PINK_COUNT_BOUNDS = (5, 9)

# Inclusive connected-component filters and retry cap.
TOP_COMPONENT_BOUNDS, BOTTOM_COMPONENT_BOUNDS = (2, 5), (1, 4)
GENERATION_ATTEMPTS = 300


def _gen_count_choices():
    choices = []
    for top_count in TOP_COUNT_RANGE:
        for bottom_count in BOTTOM_COUNT_RANGE:
            for overlap in OVERLAP_RANGE:
                if overlap > top_count or overlap > bottom_count:
                    continue
                bottom_only_count = bottom_count - overlap
                if bottom_only_count > TOTAL_CELLS - top_count:
                    continue
                pink_count = top_count + bottom_count - 2 * overlap
                if PINK_COUNT_BOUNDS[0] <= pink_count <= PINK_COUNT_BOUNDS[1]:
                    choices.append((top_count, bottom_count, overlap))
    return choices


COUNT_CHOICES = _gen_count_choices()


def _gen_num_components(mask):
    return len(components_mask(mask, connectivity=4))


def _gen_sample_masks(top_count, bottom_count, overlap):
    all_cells = np.arange(TOTAL_CELLS)
    top_cells = np.random.choice(all_cells, size=top_count, replace=False)
    overlap_cells = np.random.choice(top_cells, size=overlap, replace=False)
    free_cells = np.setdiff1d(all_cells, top_cells, assume_unique=False)
    bottom_only_cells = np.random.choice(
        free_cells, size=bottom_count - overlap, replace=False
    )

    top_mask = np.zeros(TOTAL_CELLS, dtype=bool)
    bottom_mask = np.zeros(TOTAL_CELLS, dtype=bool)
    top_mask[top_cells] = True
    bottom_mask[overlap_cells] = True
    bottom_mask[bottom_only_cells] = True
    return top_mask.reshape(HALF_HEIGHT, WIDTH), bottom_mask.reshape(HALF_HEIGHT, WIDTH)


def _gen_render(top_mask, bottom_mask):
    top = np.where(top_mask, TOP_COLOR, BACKGROUND_COLOR)
    bottom = np.where(bottom_mask, BOTTOM_COLOR, BACKGROUND_COLOR)
    expected = np.where(top_mask ^ bottom_mask, Color.PINK, BACKGROUND_COLOR)
    return np.vstack([top, bottom]).astype(int), expected.astype(int)


def _gen_attempt():
    top_count, bottom_count, overlap = COUNT_CHOICES[
        np.random.randint(len(COUNT_CHOICES))
    ]
    top_mask, bottom_mask = _gen_sample_masks(top_count, bottom_count, overlap)
    top_components = _gen_num_components(top_mask)
    bottom_components = _gen_num_components(bottom_mask)
    top_ok = TOP_COMPONENT_BOUNDS[0] <= top_components <= TOP_COMPONENT_BOUNDS[1]
    bottom_ok = BOTTOM_COMPONENT_BOUNDS[0] <= bottom_components <= BOTTOM_COMPONENT_BOUNDS[1]
    if not (top_ok and bottom_ok):
        return None

    inp, expected = _gen_render(top_mask, bottom_mask)
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(GENERATION_ATTEMPTS):
        inp = _gen_attempt()
        if inp is not None:
            return inp
    raise RuntimeError("failed to generate a valid 31d5ba1a input")

