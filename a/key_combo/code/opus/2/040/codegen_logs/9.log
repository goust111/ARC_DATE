+    v_sides = ["top", "bottom"][:v_needed]
+    if h_needed == 1:
+        h_sides = [random.choice(["left", "right"])]
+    elif h_needed == 2:
+        random.shuffle(h_sides)
+    if v_needed == 1:
+        v_sides = [random.choice(["top", "bottom"])]
+    elif v_needed == 2:
+        random.shuffle(v_sides)
