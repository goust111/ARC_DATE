+        gap = random.randint(1, 3)
+        if side == "top":
+            bbox_r1 = r0 - gap - 1
+            bbox = (bbox_r1 - 2, col - 1, bbox_r1, col + 1)
+            marker_r = random.randint(0, bbox[0] - 2)
+        else:
+            bbox_r0 = r1 + gap + 1
