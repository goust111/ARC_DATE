+    candidates = []
+    for top in range(1, h - 3):
+        for left in range(1, w - 3):
+            bbox = (top, left, top + 2, left + 2)
+            rows = {top, top + 1, top + 2}
+            cols = {left, left + 1, left + 2}
+            if rows & set(active_rows):
+                continue
+            if cols & set(active_cols):
+                continue
+            if not _bbox_clear(grid, bbox, pad=1):
