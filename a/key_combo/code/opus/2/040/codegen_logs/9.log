from __future__ import annotations

import numpy as np

from arc_utils import find_components, get_bg
import random


def _divider_row(g: np.ndarray, bg: int) -> tuple[int, int]:
    rows: list[tuple[int, int]] = []
    for r in range(g.shape[0]):
        row_colors = set(map(int, g[r]))
        if len(row_colors) == 1:
            color = next(iter(row_colors))
            if int(color) != int(bg):
                rows.append((int(r), int(color)))
    assert len(rows) == 1, "expected exactly one solid non-background divider row"
    return rows[0]


def _unique_widest_row(coords: np.ndarray) -> int:
    row_counts: list[tuple[int, int]] = []
    for r in sorted(set(map(int, coords[:, 0]))):
        row_cols = np.sort(coords[coords[:, 0] == r, 1])
        assert np.array_equal(row_cols, np.arange(int(row_cols[0]), int(row_cols[-1]) + 1))
        row_counts.append((int(row_cols.size), int(r)))

    max_count = max(count for count, _r in row_counts)
    widest = [r for count, r in row_counts if count == max_count]
    assert max_count > 1, "multi-column sprites must have a horizontal span"
    assert len(widest) == 1, "expected a unique widest horizontal row"
    return int(widest[0])


def main(grid: np.ndarray) -> np.ndarray:
    """
    Drop the blue sprites downward relative to the red divider, with vertical sprites passing through to the bottom.

    Input structure:
    - The background is the dominant color.
    - One non-background color forms a single full-width horizontal divider row.
    - The other non-background color forms 4-connected sprites above the divider.

    Rule:
    - Clear the original sprite pixels.
    - A one-column sprite falls to the bottom of its column and deletes the divider
      pixel it crossed.
    - Any wider sprite falls until its unique widest horizontal row is immediately
      above the divider row; if the moved sprite overlaps the divider, it covers it.

    Key insight:
    The red row is not a generic floor: only one-column sprites pass through to the
    bottom, while wider sprites are registered by their widest horizontal segment.
    """
    g = np.asarray(grid, dtype=int)
    H, W = g.shape
    bg = int(get_bg(g))
    line_r, line_color = _divider_row(g, bg)

    non_bg_colors = set(map(int, g.ravel())) - {bg}
    sprite_colors = non_bg_colors - {line_color}
    assert len(sprite_colors) == 1, "expected exactly one sprite color"
    sprite_color = next(iter(sprite_colors))

    sprites = find_components(
        g,
        bg=bg,
        colors=[sprite_color],
        connectivity=4,
        monochromatic=True,
    )
    assert sprites, "expected at least one sprite"

    out = g.copy()
    out[g == sprite_color] = bg
    occupied = np.zeros((H, W), dtype=bool)

    for sprite in sprites:
        coords = sprite["coords"]
        _r0, c0, r1, c1 = map(int, sprite["bbox"])
        assert r1 < line_r, "all sprites must begin above the divider"

        if c0 == c1:
            shift = H - 1 - r1
            assert shift >= 0
            assert int(out[line_r, c0]) == line_color
            out[line_r, c0] = bg
        else:
            widest_r = _unique_widest_row(coords)
            shift = line_r - 1 - widest_r
            assert shift >= 0

        moved = coords.copy()
        moved[:, 0] += shift
        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H))
        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < W))

        for rr, cc in moved:
            r = int(rr)
            c = int(cc)
            assert not occupied[r, c], "moved sprites must not overlap"
            occupied[r, c] = True
            out[r, c] = sprite_color

    return out

# --------------- generator (att2) ---------------

# Canvas, palette, and divider bounds.
MIN_GRID_SIZE, LARGE_GRID_MIN, MAX_GRID_SIZE = 7, 14, 18
LARGE_GRID_PROB, PALETTE_SIZE, DIVIDER_MARGIN = 0.35, 10, 3
ADJACENT_ROW_OFFSET = 1

# Sprite counts, spacing, and retry limits.
MIN_SPRITE_COUNT, MAX_SPRITE_COUNT = 1, 5
MAX_SINGLE_SPRITES, MAX_MULTI_SPRITES = 2, 3
GAP_COLUMNS, INPUT_GAP_TO_DIVIDER = 1, 1
GENERATION_RETRIES = 300

# Sprite geometry.
MIN_SPRITE_HEIGHT, MAX_SINGLE_HEIGHT, MAX_MULTI_HEIGHT = 1, 7, 5
SINGLE_WIDTH, MIN_MULTI_WIDTH, MAX_MULTI_WIDTH = 1, 2, 3
WIDE_MULTI_PROB = 0.5


def _composition(total: int, parts: int) -> list[int]:
    shares = [0] * parts
    for _ in range(total):
        shares[random.randrange(parts)] += 1
    return shares


def _min_layout_width(n_single: int, n_multi: int) -> int:
    n = n_single + n_multi
    return n_single * SINGLE_WIDTH + MIN_MULTI_WIDTH * n_multi + GAP_COLUMNS * max(0, n - 1)


def _count_pairs(width: int) -> list[tuple[int, int]]:
    pairs: list[tuple[int, int]] = []
    for n_single in range(MAX_SINGLE_SPRITES + 1):
        for n_multi in range(MAX_MULTI_SPRITES + 1):
            n = n_single + n_multi
            if MIN_SPRITE_COUNT <= n <= MAX_SPRITE_COUNT and _min_layout_width(n_single, n_multi) <= width:
                pairs.append((n_single, n_multi))
    return pairs


def _place_intervals(widths: list[int], grid_width: int) -> list[int]:
    n = len(widths)
    base = sum(widths) + GAP_COLUMNS * max(0, n - 1)
    extra = grid_width - base
    assert extra >= 0
    gaps = _composition(extra, n + 1)

    starts: list[int] = []
    c = gaps[0]
    for i, width in enumerate(widths):
        starts.append(c)
        c += width
        if i < n - 1:
            c += GAP_COLUMNS + gaps[i + 1]
    return starts


def _multi_coords(top: int, left: int, height: int, width: int, bar_row: int, spine_col: int) -> np.ndarray:
    coords = {(top + r, left + spine_col) for r in range(height)}
    coords.update((top + bar_row, left + c) for c in range(width))
    return np.array(sorted(coords), dtype=int)


def _build_descriptors(n_single: int, n_multi: int, max_single_h: int, max_multi_h: int, grid_width: int) -> list[dict[str, int | str]]:
    descriptors: list[dict[str, int | str]] = []
    for _ in range(n_single):
        descriptors.append(
            {"kind": "single", "width": SINGLE_WIDTH, "height": random.randint(MIN_SPRITE_HEIGHT, max_single_h)}
        )

    extra_width = grid_width - _min_layout_width(n_single, n_multi)
    for _ in range(n_multi):
        width = MIN_MULTI_WIDTH
        if extra_width > 0 and random.random() < WIDE_MULTI_PROB:
            width = MAX_MULTI_WIDTH
            extra_width -= MAX_MULTI_WIDTH - MIN_MULTI_WIDTH
        height = random.randint(MIN_SPRITE_HEIGHT, max_multi_h)
        descriptors.append(
            {
                "kind": "multi",
                "width": width,
                "height": height,
                "bar_row": random.randint(0, height - ADJACENT_ROW_OFFSET),
                "spine_col": random.randrange(width),
            }
        )

    random.shuffle(descriptors)
    return descriptors


def _gen_attempt() -> np.ndarray | None:
    H = random.randint(LARGE_GRID_MIN, MAX_GRID_SIZE) if random.random() < LARGE_GRID_PROB else random.randint(MIN_GRID_SIZE, MAX_GRID_SIZE)
    W = H
    bg, divider_color, sprite_color = random.sample(range(PALETTE_SIZE), 3)
    divider_choices = list(range(DIVIDER_MARGIN, H - DIVIDER_MARGIN))
    divider_weights = [min(r - ADJACENT_ROW_OFFSET, H - r - ADJACENT_ROW_OFFSET) for r in divider_choices]
    divider_r = random.choices(divider_choices, weights=divider_weights, k=1)[0]

    pairs = _count_pairs(W)
    if not pairs:
        return None
    n_single, n_multi = random.choice(pairs)

    max_single_h = min(MAX_SINGLE_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER, H - divider_r - ADJACENT_ROW_OFFSET)
    max_multi_h = min(MAX_MULTI_HEIGHT, divider_r - INPUT_GAP_TO_DIVIDER)
    if (n_single and max_single_h < MIN_SPRITE_HEIGHT) or (n_multi and max_multi_h < MIN_SPRITE_HEIGHT):
        return None

    descriptors = _build_descriptors(n_single, n_multi, max_single_h, max_multi_h, W)
    starts = _place_intervals([int(d["width"]) for d in descriptors], W)

    inp = np.full((H, W), bg, dtype=int)
    out = np.full((H, W), bg, dtype=int)
    inp[divider_r, :] = divider_color
    out[divider_r, :] = divider_color

    input_max_bottom = divider_r - INPUT_GAP_TO_DIVIDER - ADJACENT_ROW_OFFSET
    for desc, left in zip(descriptors, starts):
        height = int(desc["height"])
        width = int(desc["width"])
        if desc["kind"] == "single":
            col = left
            out[divider_r, col] = bg
            out[H - height : H, col] = sprite_color

            input_bottom = random.randint(height - ADJACENT_ROW_OFFSET, input_max_bottom)
            inp[input_bottom - height + ADJACENT_ROW_OFFSET : input_bottom + ADJACENT_ROW_OFFSET, col] = sprite_color
            continue

        bar_row = int(desc["bar_row"])
        spine_col = int(desc["spine_col"])
        landed_top = divider_r - ADJACENT_ROW_OFFSET - bar_row
        landed = _multi_coords(landed_top, left, height, width, bar_row, spine_col)
        if np.any((landed[:, 0] < 0) | (landed[:, 0] >= H)):
            return None
        out[landed[:, 0], landed[:, 1]] = sprite_color

        landed_bottom = int(landed[:, 0].max())
        min_shift = landed_bottom - input_max_bottom
        max_shift = landed_top
        if min_shift > max_shift:
            return None
        shift = random.randint(min_shift, max_shift)
        original = landed.copy()
        original[:, 0] -= shift
        if np.any((original[:, 0] < 0) | (original[:, 0] > input_max_bottom)):
            return None
        inp[original[:, 0], original[:, 1]] = sprite_color

    bg_count = int(np.count_nonzero(inp == bg))
    if bg_count <= int(np.count_nonzero(inp == divider_color)):
        return None
import numpy as np

from arc_utils import colors_present, find_components, get_bg


def _regular_lattice(
    grid: np.ndarray, bg: int
) -> tuple[int, list[int], list[int], int, int]:
    candidates: list[tuple[int, list[int], list[int], int, int]] = []
    for color in colors_present(grid, exclude={bg}):
        coords = np.argwhere(grid == int(color))
        rows = sorted({int(r) for r, _c in coords})
        cols = sorted({int(c) for _r, c in coords})
        if len(rows) < 2 or len(cols) < 2:
            continue
        if int(coords.shape[0]) != len(rows) * len(cols):
            continue
        if any(int(grid[r, c]) != int(color) for r in rows for c in cols):
            continue

        row_diffs = np.diff(rows)
        col_diffs = np.diff(cols)
        if len(set(map(int, row_diffs))) != 1 or len(set(map(int, col_diffs))) != 1:
            continue
        row_pitch = int(row_diffs[0])
        col_pitch = int(col_diffs[0])
        if row_pitch >= 3 and col_pitch >= 3:
            candidates.append((int(color), rows, cols, row_pitch, col_pitch))

    assert len(candidates) == 1, "expected exactly one regular marker lattice"
    return candidates[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move each small sprite to the centered slot of its marker-lattice cell.

    Input structure
    - The background is the dominant color.
    - One foreground color forms a complete regular Cartesian lattice of isolated markers.
    - The other foreground color forms one 4-connected 2x2-bbox sprite in each occupied lattice cell.

    Rule
    - Keep the marker lattice fixed and clear the original sprite pixels.
    - For each sprite, find the lattice marker immediately above-left of its cell.
    - Repaint the same sprite shape with its bbox upper-left at half a lattice pitch down and right from that marker.

    Key insight
    - The markers define identical cells; the sprite's shape matters, but its off-center position inside the cell is normalized to the cell center.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"
    height, width = map(int, g.shape)

    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 2, "expected marker and sprite foreground colors"

    marker_color, marker_rows, marker_cols, row_pitch, col_pitch = _regular_lattice(g, bg)
    assert row_pitch % 2 == 1 and col_pitch % 2 == 1, "expected odd lattice pitch"

    sprite_colors = [color for color in colors if color != marker_color]
    assert len(sprite_colors) == 1, "expected one sprite color"
    sprite_color = int(sprite_colors[0])

    sprites = find_components(
        g,
        bg=bg,
        colors=[sprite_color],
        connectivity=4,
        monochromatic=True,
        return_format="dict",
    )
    assert sprites, "expected at least one sprite"

    out = g.copy()
    out[g == sprite_color] = bg

    used_cells: set[tuple[int, int]] = set()
    for sprite in sprites:
        coords = sprite["coords"]
        r0, c0, r1, c1 = map(int, sprite["bbox"])
        assert r1 - r0 + 1 == 2 and c1 - c0 + 1 == 2, "expected a 2x2 sprite bbox"

        cell_rows = [r for r in marker_rows if r < r0 and r1 < r + row_pitch]
        cell_cols = [c for c in marker_cols if c < c0 and c1 < c + col_pitch]
        assert len(cell_rows) == 1 and len(cell_cols) == 1, "expected sprite inside one lattice cell"
        cell = (cell_rows[0], cell_cols[0])
        assert cell not in used_cells, "expected at most one sprite per cell"
        used_cells.add(cell)

        target_r = cell[0] + row_pitch // 2
        target_c = cell[1] + col_pitch // 2
        rel = coords - np.array([[r0, c0]])
        target_coords = rel + np.array([[target_r, target_c]])
        assert np.all((0 <= target_coords[:, 0]) & (target_coords[:, 0] < height))
        assert np.all((0 <= target_coords[:, 1]) & (target_coords[:, 1] < width))
        assert np.all(out[target_coords[:, 0], target_coords[:, 1]] == bg), "target slot must be empty"
        out[target_coords[:, 0], target_coords[:, 1]] = sprite_color

    return out

# --------------- generator (o5x) ---------------
# Canvas and marker lattice.
PITCH, GRID_MIN, GRID_MAX = 5, 10, 19
FIRST_MARKER_STOP, BOUNDARY_PAD_MAX = 3, 3
CELL_LAYOUTS, FORCED_ROW_BOUNDARY_ROWS = ((2, 3), (3, 2)), 2
# Colors and sprite placement.
BG_COLOR, SPRITE_COLOR, MARKER_COLOR = 0, 1, 2
SPRITE_SIZE, CENTER_OFFSET = 2, PITCH // 2
INPUT_OFFSET_START, INPUT_OFFSET_STOP = 1, 4
INPUT_OFFSETS = tuple(
    (dr, dc) for dr in range(INPUT_OFFSET_START, INPUT_OFFSET_STOP)
    for dc in range(INPUT_OFFSET_START, INPUT_OFFSET_STOP) if (dr, dc) != (CENTER_OFFSET, CENTER_OFFSET)
)
# Sampling limits.
SQUARE_COUNT_STOP, BINARY_STOP, GEN_RETRY_LIMIT = 3, 2, 300


def _gen_axis(first: int, cell_count: int, has_boundary: bool) -> tuple[list[int], int]:
    """Return marker coordinates and canvas size for one lattice axis."""
    marker_count = cell_count + int(has_boundary)
    markers = [first + PITCH * i for i in range(marker_count)]
    if not has_boundary:
        return markers, first + PITCH * cell_count
    boundary = markers[-1]
    max_pad = min(BOUNDARY_PAD_MAX, GRID_MAX - 1 - boundary)
    if max_pad < 0:
        return markers, -1
    size = boundary + 1 + int(np.random.randint(0, max_pad + 1))
    return markers, size


def _gen_sprite(square: bool) -> np.ndarray:
    """Return a 2x2 square or one-missing-pixel triomino mask."""
    sprite = np.ones((SPRITE_SIZE, SPRITE_SIZE), dtype=int)
    if not square:
        missing = int(np.random.randint(0, SPRITE_SIZE * SPRITE_SIZE))
        sprite[missing // SPRITE_SIZE, missing % SPRITE_SIZE] = 0
    return sprite


def _paste_sprite(grid: np.ndarray, r: int, c: int, sprite: np.ndarray, color: int) -> None:
    """Paint nonzero sprite cells at the given top-left corner."""
    grid[r : r + SPRITE_SIZE, c : c + SPRITE_SIZE][sprite.astype(bool)] = color


def _build_output(marker_rows, marker_cols, cell_rows, cell_cols, shape):
    """Render markers and centered sprites, returning sprite metadata."""
    out = np.zeros(shape, dtype=int)
    out[np.ix_(marker_rows, marker_cols)] = MARKER_COLOR

    cell_count = cell_rows * cell_cols
    square_count = int(np.random.randint(0, SQUARE_COUNT_STOP))
    square_idxs = set()
    if square_count:
        square_idxs = set(map(int, np.random.choice(cell_count, size=square_count, replace=False)))

    sprites: list[tuple[int, int, np.ndarray]] = []
    for i in range(cell_count):
        r = marker_rows[i // cell_cols]
        c = marker_cols[i % cell_cols]
        sprite = _gen_sprite(i in square_idxs)
        _paste_sprite(out, r + CENTER_OFFSET, c + CENTER_OFFSET, sprite, SPRITE_COLOR)
        sprites.append((r, c, sprite))
    return out, sprites


def _build_input(out: np.ndarray, sprites: list[tuple[int, int, np.ndarray]]) -> np.ndarray:
    """Move centered sprites to sampled non-center offsets."""
    inp = out.copy()
    for r, c, sprite in sprites:
        _paste_sprite(inp, r + CENTER_OFFSET, c + CENTER_OFFSET, sprite, BG_COLOR)
    for r, c, sprite in sprites:
        dr, dc = INPUT_OFFSETS[int(np.random.randint(0, len(INPUT_OFFSETS)))]
        _paste_sprite(inp, r + dr, c + dc, sprite, SPRITE_COLOR)
    return inp


def _gen_attempt() -> np.ndarray | None:
    cell_rows, cell_cols = CELL_LAYOUTS[int(np.random.randint(0, len(CELL_LAYOUTS)))]
    first_r = int(np.random.randint(0, FIRST_MARKER_STOP))
    first_c = int(np.random.randint(0, FIRST_MARKER_STOP))
    extra_row = cell_rows == FORCED_ROW_BOUNDARY_ROWS or bool(np.random.randint(0, BINARY_STOP))
    extra_col = bool(np.random.randint(0, BINARY_STOP))

    marker_rows, height = _gen_axis(first_r, cell_rows, extra_row)
    marker_cols, width = _gen_axis(first_c, cell_cols, extra_col)
    if not (GRID_MIN <= height <= GRID_MAX and GRID_MIN <= width <= GRID_MAX):
        return None

    out, sprites = _build_output(marker_rows, marker_cols, cell_rows, cell_cols, (height, width))
    inp = _build_input(out, sprites)

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 20981f0e input")
import numpy as np

from arc_utils import get_bg
import random


def _gap_columns(g: np.ndarray, bg: int) -> dict[int, list[tuple[int, int]]]:
    H, W = g.shape
    gaps: dict[int, list[tuple[int, int]]] = {}
    for r in range(H):
        for c in range(1, W - 1):
            left = int(g[r, c - 1])
            if int(g[r, c]) == bg and left != bg and left == int(g[r, c + 1]):
                gaps.setdefault(c, []).append((r, left))
    return gaps


def main(grid: np.ndarray) -> np.ndarray:
    """Extend broken horizontal bars vertically through their gap columns.

    Input structure
    - The background is empty color, and each control cell is a one-pixel gap
      inside a horizontal bar: its immediate left and right neighbors have the
      same non-background color.
    - Gap cells in the same column form a top-to-bottom stack, with a
      non-background vertical marker color somewhere below the last gap.
    Rule
    - For each gap column, sort its gaps by row. Paint from the top through each
      gap row with that row's horizontal-bar color, then paint the remaining
      lower part of the column with the marker color found below the last gap.
    Key insight
    - A gap column is an implicit vertical color ruler: horizontal bars provide
      the upper breakpoints, and the lower marker provides the final segment.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = get_bg(g)
    gaps = _gap_columns(g, bg)
    assert gaps

    out = g.copy()
    H, _ = g.shape
    for c, entries in gaps.items():
        entries = sorted(entries)
        rows = [r for r, _ in entries]
        assert len(rows) == len(set(rows))

        last_gap_row = rows[-1]
        assert last_gap_row + 1 < H
        terminal_colors = {int(x) for x in g[last_gap_row + 1 :, c] if int(x) != bg}
        assert len(terminal_colors) == 1
        terminal_color = terminal_colors.pop()

        start = 0
        for r, color in entries:
            assert all(int(x) in (bg, color) for x in g[start : r + 1, c])
            out[start : r + 1, c] = color
            start = r + 1

        assert all(int(x) in (bg, terminal_color) for x in g[start:, c])
        out[start:, c] = terminal_color

    return out

# --------------- generator (o5x) ---------------

# Canvas, palette, and retry limits.
GRID_H, GRID_W, BG = 15, 15, 0
COLOR_POOL = range(1, 10)
MIN_COLORS, MAX_COLORS, MAX_ATTEMPTS = 3, 7, 300

# Gap columns, bar rows, and side order.
GAP_COUNT_MIN, GAP_COUNT_MAX = 1, 3
GAP_DISTANCE_MIN, GAP_DISTANCE_MAX = 4, 8
INTERIOR_COL_MIN, INTERIOR_COL_MAX = 1, 13
BOTTOM_BELOW_MIN, BOTTOM_BELOW_MAX = 1, 8
SIDE_LEFT, SIDE_RIGHT = "L", "R"

# Horizontal span offsets from the two gap columns.
LEFT_END_MIN, LEFT_END_BEFORE_C2 = 2, 1
RIGHT_START_AFTER_C1, RIGHT_START_BEFORE_C2 = 1, 2
SPLIT_AFTER_C1, SPLIT_BEFORE_C2 = 1, 2

# Terminal-marker gap and length bounds.
MARKER_GAP_MIN, MARKER_GAP_MAX = 0, 2
MARKER_LEN_MIN, MARKER_LEN_MAX = 1, 6

def _gen_color_sequences(n: int) -> tuple[list[int], list[int]]:
    total = random.randint(max(MIN_COLORS, n + 1), min(MAX_COLORS, 2 * n + 2))
    palette = random.sample(COLOR_POOL, total)

    left_seq = random.sample(palette, n + 1)
    missing_from_left = [color for color in palette if color not in left_seq]
    right_seq = missing_from_left + random.sample(left_seq, n + 1 - len(missing_from_left))
    random.shuffle(right_seq)
    return left_seq, right_seq


def _gen_marker_start(bottom_row: int) -> int:
    total_below = GRID_H - 1 - bottom_row
    gaps = [
        gap
        for gap in range(MARKER_GAP_MIN, MARKER_GAP_MAX + 1)
        if MARKER_LEN_MIN <= total_below - gap <= MARKER_LEN_MAX
    ]
    gap = random.choice(gaps)
    return bottom_row + 1 + gap


def _gen_fill_column(
    out: np.ndarray, col: int, gap_rows: list[int], colors: list[int]
) -> None:
    start = 0
    for row, color in zip(gap_rows, colors[:-1]):
        out[start : row + 1, col] = color
        start = row + 1
    out[start:, col] = colors[-1]


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GAP_COUNT_MIN, GAP_COUNT_MAX)
    distance = random.randint(GAP_DISTANCE_MIN, GAP_DISTANCE_MAX)
    c1 = random.randint(INTERIOR_COL_MIN, INTERIOR_COL_MAX - distance)
    c2 = c1 + distance

    below_count = random.randint(BOTTOM_BELOW_MIN, BOTTOM_BELOW_MAX)
    bottom_row = GRID_H - 1 - below_count
    above_rows = sorted(random.sample(range(bottom_row), 2 * (n - 1)))

    first_side = random.choice([SIDE_LEFT, SIDE_RIGHT])
    second_side = SIDE_RIGHT if first_side == SIDE_LEFT else SIDE_LEFT
    sides = [first_side if i % 2 == 0 else second_side for i in range(len(above_rows))]
    left_gap_rows = [row for row, side in zip(above_rows, sides) if side == SIDE_LEFT]
    right_gap_rows = [row for row, side in zip(above_rows, sides) if side == SIDE_RIGHT]
    left_gap_rows.append(bottom_row)
    right_gap_rows.append(bottom_row)

    left_colors, right_colors = _gen_color_sequences(n)

    out = np.zeros((GRID_H, GRID_W), dtype=int)
    _gen_fill_column(out, c1, left_gap_rows, left_colors)
    _gen_fill_column(out, c2, right_gap_rows, right_colors)

    for row, color in zip(left_gap_rows[:-1], left_colors[:-2]):
        end_col = random.randint(c1 + LEFT_END_MIN, c2 - LEFT_END_BEFORE_C2)
        out[row, : end_col + 1] = color

    for row, color in zip(right_gap_rows[:-1], right_colors[:-2]):
