+    return None
+
+
+def _place_unaligned_source(
+    grid: np.ndarray,
+    rect_bbox: tuple[int, int, int, int],
+    divider_r: int,
+    bg: int,
+    color: int,
+) -> tuple[int, int, int] | None:
+    h, w = map(int, grid.shape)
+    for _ in range(200):
+        r = random.randint(1, divider_r - 2)
+        c = random.randint(1, w - 2)
