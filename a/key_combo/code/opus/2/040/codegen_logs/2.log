import numpy as np

from arc_utils import Color, crop_bbox, find_components
import random


def _glyphs(g: np.ndarray) -> list[int | None]:
    comps = find_components(g, bg=Color.BLACK, colors=[Color.RED], connectivity=4)
    comps = sorted(comps, key=lambda comp: comp["bbox"][1])

    glyphs: list[int | None] = []
    for comp in comps:
        r0, _c0, r1, _c1 = comp["bbox"]
        assert (r0, r1) == (0, 1)

        mask = crop_bbox(g == Color.RED, comp["bbox"])
        assert mask.shape[0] == 2
        assert mask.shape[1] in (1, 2)

        top_cols = np.flatnonzero(mask[0])
        bottom_cols = np.flatnonzero(mask[1])
        assert len(top_cols) == 1
        assert len(bottom_cols) in (1, 2)

        entry = int(top_cols[0])
        bottom = [int(c) for c in bottom_cols]
        assert entry in bottom

        if len(bottom) == 1:
            glyphs.append(None)
            continue

        exit_cols = [c for c in bottom if c != entry]
        assert len(exit_cols) == 1
        step = exit_cols[0] - entry
        assert abs(step) == 1
        glyphs.append(step)

    assert glyphs
    return glyphs


def main(grid: np.ndarray) -> np.ndarray:
    """Decode the two-row red glyph strip into a downward red trace starting from a centered green marker.

    Input structure
    - The input is a black 2-row strip containing 4-connected red glyphs, read left to right.
    - Each glyph spans both rows and has exactly one top red entry cell; its bottom row is either the same cell only or a two-cell elbow.
    Rule
    - Make a black output whose width is one more than half the input width and whose height is one marker row plus one row for each elbow and two rows for each vertical glyph.
    - Put a green marker in the center of the top row, then trace the glyphs downward: a vertical glyph paints two red cells in the current column; an elbow paints the two bottom cells as a horizontal red segment and moves the current column left or right.
    Key insight
    - The missing top cell of each 2x2 elbow tells whether the trace exits left or right; the glyphs are pipe instructions rather than shapes to copy literally.
    """
    g = np.asarray(grid, dtype=int)
    assert g.shape[0] == 2
    assert g.shape[1] % 2 == 0
    assert set(map(int, np.unique(g))) == {Color.BLACK, Color.RED}

    glyphs = _glyphs(g)
    out_h = 1 + sum(2 if step is None else 1 for step in glyphs)
    out_w = g.shape[1] // 2 + 1
    out = np.full((out_h, out_w), Color.BLACK, dtype=int)

    r = 0
    c = out_w // 2
    out[r, c] = Color.GREEN
    r += 1

    for step in glyphs:
        if step is None:
            assert r + 1 < out_h
            out[r : r + 2, c] = Color.RED
            r += 2
        else:
            next_c = c + step
            assert 0 <= next_c < out_w
            out[r, c] = Color.RED
            out[r, next_c] = Color.RED
            r += 1
            c = next_c

    assert r == out_h
    return out

# --------------- generator (o5x) ---------------
# Glyph sequence, canvas, and retry configuration.
GEN_GLYPH_COUNT = 5
GEN_NUM_VERTICAL = 2
GEN_STEP_CHOICES = (-1, 1)
GEN_INPUT_ROWS = 2
GEN_INPUT_WIDTH = 3 * GEN_GLYPH_COUNT - GEN_NUM_VERTICAL - 1
GEN_OUTPUT_WIDTH = GEN_INPUT_WIDTH // 2 + 1
GEN_RETRY_LIMIT = 300


def _sample_steps() -> list[int | None] | None:
    """Sample glyph instructions and reject paths that leave the output."""
    col = GEN_OUTPUT_WIDTH // 2
    vertical_positions = set(random.sample(range(GEN_GLYPH_COUNT), GEN_NUM_VERTICAL))
    steps: list[int | None] = []

    for pos in range(GEN_GLYPH_COUNT):
        if pos in vertical_positions:
            steps.append(None)
            continue

        choices = list(GEN_STEP_CHOICES)
        random.shuffle(choices)
        valid = [step for step in choices if 0 <= col + step < GEN_OUTPUT_WIDTH]
        if not valid:
            return None
        step = random.choice(valid)
        steps.append(step)
        col += step
    return steps


def _encode_input(steps: list[int | None]) -> np.ndarray:
    """Encode sampled instructions into the two-row glyph strip."""
    grid = np.full((GEN_INPUT_ROWS, GEN_INPUT_WIDTH), Color.BLACK, dtype=int)
    c = 0
    for step in steps:
        if step is None:
            grid[:, c] = Color.RED
            c += 1
        else:
            top_offset = 0 if step == 1 else 1
            grid[0, c + top_offset] = Color.RED
            grid[1, c : c + 2] = Color.RED
            c += 2
        if c < GEN_INPUT_WIDTH:
            c += 1
    return grid


def _render_expected(steps: list[int | None]) -> np.ndarray:
    """Render the decoded output used to validate the generated strip."""
    out_h = 1 + sum(2 if step is None else 1 for step in steps)
    expected = np.full((out_h, GEN_OUTPUT_WIDTH), Color.BLACK, dtype=int)
    r = 0
    col = GEN_OUTPUT_WIDTH // 2
    expected[r, col] = Color.GREEN
    r += 1
    for step in steps:
        if step is None:
            expected[r : r + 2, col] = Color.RED
            r += 2
        else:
            expected[r, col] = Color.RED
            expected[r, col + step] = Color.RED
            col += step
            r += 1
    return expected


def _gen_attempt() -> np.ndarray | None:
    steps = _sample_steps()
    if steps is None:
        return None
    grid = _encode_input(steps)
    return grid if np.array_equal(main(grid), _render_expected(steps)) else None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRY_LIMIT):
        if (grid := _gen_attempt()) is not None:
            return grid
    raise RuntimeError("failed to generate valid input")
import numpy as np

from arc_utils import get_bg
import random


def _gap_columns(g: np.ndarray, bg: int) -> dict[int, list[tuple[int, int]]]:
    H, W = g.shape
    gaps: dict[int, list[tuple[int, int]]] = {}
    for r in range(H):
        for c in range(1, W - 1):
            left = int(g[r, c - 1])
            if int(g[r, c]) == bg and left != bg and left == int(g[r, c + 1]):
                gaps.setdefault(c, []).append((r, left))
    return gaps


def main(grid: np.ndarray) -> np.ndarray:
    """Extend broken horizontal bars vertically through their gap columns.

    Input structure
    - The background is empty color, and each control cell is a one-pixel gap
      inside a horizontal bar: its immediate left and right neighbors have the
      same non-background color.
    - Gap cells in the same column form a top-to-bottom stack, with a
      non-background vertical marker color somewhere below the last gap.
    Rule
    - For each gap column, sort its gaps by row. Paint from the top through each
      gap row with that row's horizontal-bar color, then paint the remaining
      lower part of the column with the marker color found below the last gap.
    Key insight
    - A gap column is an implicit vertical color ruler: horizontal bars provide
      the upper breakpoints, and the lower marker provides the final segment.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = get_bg(g)
    gaps = _gap_columns(g, bg)
    assert gaps

    out = g.copy()
    H, _ = g.shape
    for c, entries in gaps.items():
        entries = sorted(entries)
        rows = [r for r, _ in entries]
        assert len(rows) == len(set(rows))

        last_gap_row = rows[-1]
        assert last_gap_row + 1 < H
        terminal_colors = {int(x) for x in g[last_gap_row + 1 :, c] if int(x) != bg}
        assert len(terminal_colors) == 1
        terminal_color = terminal_colors.pop()

        start = 0
        for r, color in entries:
            assert all(int(x) in (bg, color) for x in g[start : r + 1, c])
            out[start : r + 1, c] = color
            start = r + 1

        assert all(int(x) in (bg, terminal_color) for x in g[start:, c])
        out[start:, c] = terminal_color

    return out

# --------------- generator (o5x) ---------------

# Canvas, palette, and retry limits.
GRID_H, GRID_W, BG = 15, 15, 0
COLOR_POOL = range(1, 10)
MIN_COLORS, MAX_COLORS, MAX_ATTEMPTS = 3, 7, 300

# Gap columns, bar rows, and side order.
GAP_COUNT_MIN, GAP_COUNT_MAX = 1, 3
GAP_DISTANCE_MIN, GAP_DISTANCE_MAX = 4, 8
INTERIOR_COL_MIN, INTERIOR_COL_MAX = 1, 13
BOTTOM_BELOW_MIN, BOTTOM_BELOW_MAX = 1, 8
SIDE_LEFT, SIDE_RIGHT = "L", "R"

# Horizontal span offsets from the two gap columns.
LEFT_END_MIN, LEFT_END_BEFORE_C2 = 2, 1
RIGHT_START_AFTER_C1, RIGHT_START_BEFORE_C2 = 1, 2
SPLIT_AFTER_C1, SPLIT_BEFORE_C2 = 1, 2

# Terminal-marker gap and length bounds.
MARKER_GAP_MIN, MARKER_GAP_MAX = 0, 2
MARKER_LEN_MIN, MARKER_LEN_MAX = 1, 6

def _gen_color_sequences(n: int) -> tuple[list[int], list[int]]:
    total = random.randint(max(MIN_COLORS, n + 1), min(MAX_COLORS, 2 * n + 2))
    palette = random.sample(COLOR_POOL, total)

    left_seq = random.sample(palette, n + 1)
    missing_from_left = [color for color in palette if color not in left_seq]
    right_seq = missing_from_left + random.sample(left_seq, n + 1 - len(missing_from_left))
    random.shuffle(right_seq)
    return left_seq, right_seq


def _gen_marker_start(bottom_row: int) -> int:
    total_below = GRID_H - 1 - bottom_row
    gaps = [
        gap
        for gap in range(MARKER_GAP_MIN, MARKER_GAP_MAX + 1)
        if MARKER_LEN_MIN <= total_below - gap <= MARKER_LEN_MAX
    ]
    gap = random.choice(gaps)
    return bottom_row + 1 + gap


def _gen_fill_column(
    out: np.ndarray, col: int, gap_rows: list[int], colors: list[int]
) -> None:
    start = 0
    for row, color in zip(gap_rows, colors[:-1]):
        out[start : row + 1, col] = color
        start = row + 1
    out[start:, col] = colors[-1]


def _gen_attempt() -> np.ndarray | None:
    n = random.randint(GAP_COUNT_MIN, GAP_COUNT_MAX)
    distance = random.randint(GAP_DISTANCE_MIN, GAP_DISTANCE_MAX)
    c1 = random.randint(INTERIOR_COL_MIN, INTERIOR_COL_MAX - distance)
    c2 = c1 + distance

    below_count = random.randint(BOTTOM_BELOW_MIN, BOTTOM_BELOW_MAX)
    bottom_row = GRID_H - 1 - below_count
    above_rows = sorted(random.sample(range(bottom_row), 2 * (n - 1)))

    first_side = random.choice([SIDE_LEFT, SIDE_RIGHT])
    second_side = SIDE_RIGHT if first_side == SIDE_LEFT else SIDE_LEFT
    sides = [first_side if i % 2 == 0 else second_side for i in range(len(above_rows))]
    left_gap_rows = [row for row, side in zip(above_rows, sides) if side == SIDE_LEFT]
    right_gap_rows = [row for row, side in zip(above_rows, sides) if side == SIDE_RIGHT]
    left_gap_rows.append(bottom_row)
    right_gap_rows.append(bottom_row)

    left_colors, right_colors = _gen_color_sequences(n)

    out = np.zeros((GRID_H, GRID_W), dtype=int)
