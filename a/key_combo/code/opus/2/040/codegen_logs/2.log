+
+
+def _trace_rays(
+    shape: tuple[int, int],
+    rect_bbox: tuple[int, int, int, int],
+    sources: list[tuple[int, int, int]],
+) -> list[dict[str, object]]:
+    rays: list[dict[str, object]] = []
+    for r, c, color in sources:
+        end = _ray_end(rect_bbox, shape, (r, c))
+        if end is None:
+            continue
+        rays.append(
+            {
