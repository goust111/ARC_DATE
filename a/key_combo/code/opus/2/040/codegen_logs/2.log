+    settled: set[tuple[int, int]] = set()
+    for r, c in sorted(intersections, key=lambda cell: (int(cell[1]), -int(cell[0]))):
+        rr = int(r)
+        cc = int(c)
+        assert rr < divider_r
+        while rr + 1 < divider_r and (rr + 1, cc) not in settled:
+            rr += 1
+        settled.add((rr, cc))
+        out[rr, cc] = FALL_COLOR
