+        return False
+
+    r0, c0 = random.choice(valid)
+    coords = np.argwhere(template) + np.array([[r0, c0]])
+    panel[coords[:, 0], coords[:, 1]] = int(color)
+    occupied[coords[:, 0], coords[:, 1]] = True
