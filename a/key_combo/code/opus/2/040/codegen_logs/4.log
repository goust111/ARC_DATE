+            used_any = True
+        if not used_any or int(np.count_nonzero(panel)) < 2:
+            return None
+
+    grid = _render_input(top_h, panel_w, sprite_mask, sprite_col, panels)
+    expected = _oracle_output(panels, branch)
+
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
