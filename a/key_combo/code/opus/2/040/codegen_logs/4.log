+    if width == 2:
+        return 1
+    return 0
+
+
+def _merge_panels(panels: list[np.ndarray], anchor: int, bg: int) -> np.ndarray:
+    out = panels[anchor].copy()
+    for idx, panel in enumerate(panels):
+        if idx == anchor:
+            continue
+        paste(out, panel, 0, 0, transparent=bg, overwrite=False)
+    return out
