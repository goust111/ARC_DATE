+    sprites = find_components(
+        top,
+        bg=bg,
+        colors=[SPRITE_COLOR],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    assert len(sprites) == 1, "expected one yellow sprite"
+    sprite = sprites[0]
+    width = int(bbox_w(sprite["bbox"]))
+    _r0, c0, _r1, c1 = map(int, sprite["bbox"])
