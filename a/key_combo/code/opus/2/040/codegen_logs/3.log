+def _extract_obstacles(grid: np.ndarray, *, expand: bool) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    mask = np.zeros((H, W), dtype=bool)
+    obstacles = find_components(
+        g,
+        bg=Color.BLACK,
+        colors=[Color.RED],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
