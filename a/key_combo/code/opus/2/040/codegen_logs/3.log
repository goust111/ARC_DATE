+    expanded = _expanded_rect_mask(channel.shape, r, c, h, w)
+    if bool((rect & occupied).any()):
+        return False
+    if bool((expanded & expanded_taken).any()):
+        return False
+    return True
+
+
+def _place_obstacle(
+    occupied: np.ndarray,
+    expanded_taken: np.ndarray,
+    r: int,
+    c: int,
+    h: int,
+    w: int,
+) -> tuple[np.ndarray, np.ndarray]:
