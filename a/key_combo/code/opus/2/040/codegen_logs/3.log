+    return dc, -dr
+
+
+def _rect_mask(shape: tuple[int, int], r: int, c: int, h: int, w: int) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[r : r + h, c : c + w] = True
+    return mask
