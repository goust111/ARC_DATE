+        if i < n_rises:
+            turn_col = c_start + run_gaps[i]
+            c_end = turn_col + width - 1
+        else:
+            turn_col = None
+            c_end = c_start + final_run + width - 1
+            final_right = c_end
+
+        if c_end >= W - 2:
