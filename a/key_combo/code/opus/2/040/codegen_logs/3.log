+def _build_layout() -> dict | None:
+    width = random.randint(3, 5)
+    if width == 5:
+        n_rises = 2
+    elif width == 4:
+        n_rises = random.choice([2, 2, 3])
+    else:
+        n_rises = random.choice([2, 3])
+
