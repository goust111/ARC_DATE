+    return mask
+
+
+def _expanded_rect_mask(shape: tuple[int, int], r: int, c: int, h: int, w: int) -> np.ndarray:
+    """Return the obstacle plus its cross-shaped one-cell extrusion."""
+    H, W = shape
+    mask = _rect_mask(shape, r, c, h, w)
+    if r - 1 >= 0:
+        mask[r - 1, c : c + w] = True
+    if r + h < H:
