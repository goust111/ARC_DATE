+    )
+    for comp in obstacles:
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if expand:
+            mask |= _expanded_rect_mask((H, W), r0, c0, h, w)
+        else:
+            mask |= _rect_mask((H, W), r0, c0, h, w)
+    return mask
+
+
+def _initial_direction(grid: np.ndarray, start: tuple[int, int]) -> tuple[int, int]:
