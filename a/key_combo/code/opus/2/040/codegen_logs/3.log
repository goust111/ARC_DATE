+    if not bool(channel[r - 1, c : c + w].all()):
+        return False
+    if not bool(channel[r + h, c : c + w].all()):
+        return False
+    if not bool(channel[r : r + h, c - 1].all()):
+        return False
+    if not bool(channel[r : r + h, c + w].all()):
+        return False
