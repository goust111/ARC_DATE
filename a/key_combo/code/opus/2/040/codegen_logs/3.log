+        if state in visited_states:
+            stop_reason = "loop"
+            break
+        visited_states.add(state)
+
+        nr, nc = r + dr, c + dc
+        if in_bounds((H, W), nr, nc) and bool(end_mask[nr, nc]):
+            out[nr, nc] = Color.MAROON
+            path.append((nr, nc))
+            reached_end = True
