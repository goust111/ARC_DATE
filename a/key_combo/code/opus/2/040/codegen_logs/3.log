+    return {
+        "shape": (H, W),
+        "width": width,
+        "channel": channel,
+        "h_segments": h_segments,
+        "v_segments": v_segments,
+        "start": start,
+        "final_right": final_right,
+        "r_tops": r_tops,
+    }
