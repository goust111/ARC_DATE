+) -> tuple[np.ndarray, np.ndarray]:
+    rect = _rect_mask(occupied.shape, r, c, h, w)
+    expanded = _expanded_rect_mask(occupied.shape, r, c, h, w)
+    occupied = occupied.copy()
+    expanded_taken = expanded_taken.copy()
+    occupied |= rect
+    expanded_taken |= expanded
