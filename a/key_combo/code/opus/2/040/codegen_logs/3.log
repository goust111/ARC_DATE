+    if want_reach != bool(expanded_meta["reached_end"]):
+        return None
+    if not want_reach and expanded_meta["stop_reason"] != "stuck":
+        return None
+    if np.array_equal(expanded_out, base_out):
+        return None
+    if expanded_meta["path"] == base_meta["path"]:
+        return None
+
+    return grid
