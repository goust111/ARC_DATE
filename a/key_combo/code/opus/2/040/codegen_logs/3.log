+    options = []
+    for dr, dc in ((0, 1), (1, 0), (0, -1), (-1, 0)):
+        nr, nc = r + dr, c + dc
+        if in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == Color.BLUE:
+            options.append((dr, dc))
+    assert len(options) == 1, "expected a unique channel-facing direction from the start marker"
+    return options[0]
