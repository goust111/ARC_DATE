+    size_pool = [(1, 1), (1, 2), (2, 1), (2, 2)]
+
+    for idx, seg in enumerate(layout["h_segments"]):
+        if idx == 0:
+            continue
+        for h, w in size_pool:
+            row = int(seg["r_top"] + width - h - 1)
+            if row <= seg["r_top"]:
