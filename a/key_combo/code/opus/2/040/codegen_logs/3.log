+    neighbors = 0
+    for dr, dc in DIR4:
+        nr, nc = start[0] + dr, start[1] + dc
+        if in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == Color.BLUE:
+            neighbors += 1
+    if neighbors != 1:
+        return False
+    red = find_components(
