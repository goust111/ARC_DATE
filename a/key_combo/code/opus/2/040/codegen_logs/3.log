+
+def _solve(grid: np.ndarray, *, expand_obstacles: bool, return_meta: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and 1 <= g.shape[0] <= 30 and 1 <= g.shape[1] <= 30
