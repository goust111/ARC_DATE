0063:     out = np.full((out_h, out_w), Color.BLACK, dtype=int)
0064: 
0065:     r = 0
0066:     c = out_w // 2
0067:     out[r, c] = Color.GREEN
0068:     r += 1
0069: 
0070:     for step in glyphs:
0071:         if step is None:
0072:             assert r + 1 < out_h
0073:             out[r : r + 2, c] = Color.RED
0074:             r += 2
0075:         else:
0076:             next_c = c + step
0077:             assert 0 <= next_c < out_w
0078:             out[r, c] = Color.RED
0079:             out[r, next_c] = Color.RED
0080:             r += 1
0081:             c = next_c
0082: 
0083:     assert r == out_h
