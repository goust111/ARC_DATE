+    return _fill_enclosed_regions(out, bg=bg, fill_color=YELLOW)
+
+
+PITCH = 4
+BASE_MARKER_ROWS = (0, 4, 8)
+BASE_MARKER_COLS = (0, 4, 8, 12)
+BASE_CELL_SHAPES = (
