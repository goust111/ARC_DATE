import itertools, random, hashlib
from collections import Counter, deque
import numpy as np

BLACK, RED, GREEN, YELLOW = 0,2,3,4
PITCH=4
LOCAL_MIN=-2
LOCAL_MAX=2
CORNERS={(-2,-2),(-2,2),(2,-2),(2,2)}

# template library
coords_all=[(r,c) for r in range(LOCAL_MIN,LOCAL_MAX+1) for c in range(LOCAL_MIN,LOCAL_MAX+1) if (r,c) not in CORNERS]

def conn(shape):
    s=set(shape)
    q=[next(iter(s))]; seen={q[0]}
    while q:
        r,c=q.pop()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            p=(r+dr,c+dc)
            if p in s and p not in seen:
                seen.add(p); q.append(p)
    return len(seen)==len(s)

TEMPLATES=[]
for k in range(2,6):
    for comb in itertools.combinations(coords_all,k):
        rs=[r for r,c in comb]; cs=[c for r,c in comb]
        if min(rs)+max(rs)"'!=0 or min(cs)+max(cs)!=0:
            continue
        if conn(comb):
            TEMPLATES.append(tuple(sorted(comb)))
print('"'templates',len(TEMPLATES))
SHIFT_OPTIONS={}
for sh in TEMPLATES:
    opts=[]
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==0 and dc==0: continue
            moved={(r+dr,c+dc) for r,c in sh}
            if all(LOCAL_MIN<=r<=LOCAL_MAX and LOCAL_MIN<=c<=LOCAL_MAX for r,c in moved) and not any(p in CORNERS for p in moved):
                opts.append((dr,dc))
    SHIFT_OPTIONS[sh]=opts
print('shift option lens',sorted({len(v) for v in SHIFT_OPTIONS.values()}))


def components(mask):
    H,W=mask.shape
    vis=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or vis[r,c]: continue
            q=[(r,c)]; vis[r,c]=True; comp=[]
            while q:
                rr,cc=q.pop(); comp.append((rr,cc))
                for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not vis[nr,nc]:
                        vis[nr,nc]=True; q.append((nr,nc))
            out.append(comp)
    return out


def fill_output(base):
    g=base.copy()
    comps=components(g==BLACK)
    areas=[len(c) for c in comps]
    if len(comps)<2:
        return None
    outside=max(range(len(comps)), key=lambda i: areas[i])
    hole_areas=[]
    for i,comp in enumerate(comps):
        if i==outside: continue
        hole_areas.append(len(comp))
        for r,c in comp: g[r,c]=YELLOW
    return g, hole_areas


def centered_grid(cell_shape, pad_top, pad_left, rows, cols):
    H=pad_top*0


def gen_output_attempt(rows, cols):
    pad_top=random.randint(1,3)
    pad_left=random.randint(1,3)
    pad_bottom=random.randint(1,3)
    pad_right=random.randint(1,3)
    marker_rows=[pad_top + PITCH*i for i in range(rows+1)]
    marker_cols=[pad_left + PITCH*j for j in range(cols+1)]
    H=marker_rows[-1] + pad_bottom + 1
    W=marker_cols[-1] + pad_right + 1
    if H>30 or W>30: return None
    centers=[(marker_rows[i]+2, marker_cols[j]+2) for i in range(rows) for j in range(cols)]
    # bias toward templates with some boundary reach
    directional=[sh for sh in TEMPLATES if any(abs(r)==2 or abs(c)==2 for r,c in sh)]
    all_templates=TEMPLATES
    shapes=[]
    for _ in centers:
        pool = directional if random.random()<0.7 else all_templates
        shapes.append(random.choice(pool))
    g=np.zeros((H,W),dtype=int)
    for r in marker_rows:
        for c in marker_cols:
            g[r,c]=RED
    for (cr,cc),sh in zip(centers,shapes):
        for dr,dc in sh:
            g[cr+dr,cc+dc]=GREEN
    filled = fill_output(g)
    if filled is None:
        return None
    out, hole_areas = filled
    if len(hole_areas) "'!= 1:
        return None
    if hole_areas[0] < 3 or hole_areas[0] > 20:
        return None
    # centered output should have one green component for clearer wall network
    green_comps=components(g==GREEN)
    if len(green_comps) > 3:
        return None
    return dict(inp_base=g, out=out, shapes=shapes, marker_rows=marker_rows, marker_cols=marker_cols, centers=centers)


def neighbors8(coords):
    out=set()
    for r,c in coords:
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==0 and dc==0: continue
                out.add((r+dr,c+dc))
    return out


def make_input(spec):
    centers=spec['"'centers']; shapes=spec['shapes']
    marker_rows=spec['marker_rows']; marker_cols=spec['marker_cols']
    H,W=spec['inp_base'].shape
    marker_set={(r,c) for r in marker_rows for c in marker_cols}
    # candidate absolute coords per cell per shift
    cands=[]
    for idx,((cr,cc),sh) in enumerate(zip(centers,shapes)):
        opts=[]
        for dr,dc in SHIFT_OPTIONS[sh]:
            pts=[(cr+r+dr, cc+c+dc) for r,c in sh]
            if any(p in marker_set for p in pts):
                continue
            # stay within cell interval inclusive to keep assignment unique
            i=idx//(len(marker_cols)-1)
            j=idx%(len(marker_cols)-1)
            r0,r1=marker_rows[i], marker_rows[i+1]
            c0,c1=marker_cols[j], marker_cols[j+1]
            if not all(r0 <= r <= r1 and c0 <= c <= c1 for r,c in pts):
                continue
            # off-center by construction
            opts.append(((dr,dc), pts))
        if not opts:
            return None
        random.shuffle(opts)
        cands.append(opts)
    order=sorted(range(len(cands)), key=lambda i: len(cands[i]))
    placed=[None]*len(cands)
    occupied=set(); halo=set()
    def bt(k):
        if k==len(order): return True
        idx=order[k]
        for shift,pts in cands[idx]:
            s=set(pts)
            if s & occupied: continue
            if s & halo: continue
            placed[idx]=(shift,pts)
            prev_occ=set(occupied); prev_halo=set(halo)
            occupied.update(s)
            for r,c in s:
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        if dr or dc:
                            halo.add((r+dr,c+dc))
            if bt(k+1): return True
            occupied.clear(); occupied.update(prev_occ)
            halo.clear(); halo.update(prev_halo)
            placed[idx]=None
        return False
    if not bt(0):
        return None
    inp=np.zeros((H,W),dtype=int)
    for p in marker_set: inp[p]=RED
    for _shift,pts in placed:
        for r,c in pts: inp[r,c]=GREEN
    return inp

# implement main as planned quickly for verification

def get_bg(grid):
    vals, counts=np.unique(grid, return_counts=True)
    return int(vals[np.argmax(counts)])

def colors_present(grid, exclude=()):
    return [int(v) for v in np.unique(grid) if int(v) not in set(map(int,exclude))]

def bbox_coords(coords):
    arr=np.array(coords)
    return int(arr[:,0].min()), int(arr[:,1].min()), int(arr[:,0].max()), int(arr[:,1].max())

def comps_by_color(grid,color):
    mask=grid==color
    return components(mask)

def regular_lattice(g,bg):
    out=[]
    for color in colors_present(g, exclude={bg}):
        coords=np.argwhere(g==color)
        rows=sorted({int(r) for r,_ in coords})
        cols=sorted({int(c) for _,c in coords})
        if len(rows)<2 or len(cols)<2: continue
        if len(coords)"'!=len(rows)*len(cols): continue
        if any(g[r,c]!=color for r in rows for c in cols): continue
        rd=np.diff(rows); cd=np.diff(cols)
        if len(set(map(int,rd)))!=1 or len(set(map(int,cd)))!=1: continue
        out.append((int(color), rows, cols, int(rd[0]), int(cd[0])))
    assert len(out)==1
    return out[0]


def find_green_components(g,bg,green):
    return [np.array(c) for c in comps_by_color(g,green)]


def solve(grid):
    g=np.array(grid,dtype=int)
    bg=get_bg(g)
    cols=colors_present(g, exclude={bg})
    marker_color, marker_rows, marker_cols, row_pitch, col_pitch = regular_lattice(g,bg)
    others=[c for c in cols if c!=marker_color]
    assert len(others)==1
    green=others[0]
    comps=find_green_components(g,bg,green)
    out=g.copy(); out[out==green]=bg
    for coords in comps:
        r0,c0,r1,c1=bbox_coords(coords)
        cell_rows=[i for i in range(len(marker_rows)-1) if marker_rows[i] <= r0 and r1 <= marker_rows[i+1]]
        cell_cols=[j for j in range(len(marker_cols)-1) if marker_cols[j] <= c0 and c1 <= marker_cols[j+1]]
        assert len(cell_rows)==1 and len(cell_cols)==1
        i,j=cell_rows[0],cell_cols[0]
        shift_r2=(marker_rows[i]+marker_rows[i+1]) - (r0+r1)
        shift_c2=(marker_cols[j]+marker_cols[j+1]) - (c0+c1)
        assert shift_r2%2==0 and shift_c2%2==0
        dr,dc=shift_r2//2, shift_c2//2
        moved=coords + np.array([[dr,dc]])
        for r,c in moved:
            out[r,c]=green
    filled=fill_output(out.copy())
    assert filled is not None
    return filled[0]


sigs=set(); success=0
for t in range(100):
    for _ in range(200):
        rows,cols=random.choice([(2,3),(3,2)])
        spec=gen_output_attempt(rows,cols)
        if spec is None: continue
        inp=make_input(spec)
