centers=[(2+4*i,2+4*j) for i in range(rows) for j in range(cols)]
markers={(r,c) for r in mr for c in mc}

def stable_fill(g):
    f=fill(g)
    if f is None: return False, None
    pad=np.pad(g, ((1,1),(1,1)), constant_values=0)
    pf=fill(pad)
    if pf is None: return False, None
    return np.array_equal(pf[1:-1,1:-1], f), f

def valid_offsets(shapes):
    cands=[]
