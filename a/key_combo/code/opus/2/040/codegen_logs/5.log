LOCAL_MIN=-2; LOCAL_MAX=2; CORNERS={(-2,-2),(-2,2),(2,-2),(2,2)}
coords_all=[(r,c) for r in range(LOCAL_MIN,LOCAL_MAX+1) for c in range(LOCAL_MIN,LOCAL_MAX+1) if (r,c) not in CORNERS]

def conn(shape):
    s=set(shape); st=[next(iter(s))]; seen={st[0]}
    while st:
        r,c=st.pop()
        for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
            p=(r+dr,c+dc)
            if p in s and p not in seen:
                seen.add(p); st.append(p)
    return len(seen)==len(s)
T=[]
for k in range(2,6):
    for comb in itertools.combinations(coords_all,k):
        rs=[r for r,c in comb]; cs=[c for r,c in comb]
        if min(rs)+max(rs)"'!=0 or min(cs)+max(cs)!=0: continue
        if conn(comb): T.append(tuple(sorted(comb)))
SHIFT={}
for sh in T:
    opts=[]
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==0 and dc==0: continue
            moved={(r+dr,c+dc) for r,c in sh}
            if all(LOCAL_MIN<=r<=LOCAL_MAX and LOCAL_MIN<=c<=LOCAL_MAX for r,c in moved) and not any(p in CORNERS for p in moved):
                opts.append((dr,dc))
    SHIFT[sh]=opts

def comps(mask):
    H,W=mask.shape
    vis=np.zeros_like(mask,dtype=bool); out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or vis[r,c]: continue
            st=[(r,c)]; vis[r,c]=True; comp=[]
            while st:
                rr,cc=st.pop(); comp.append((rr,cc))
                for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and mask[nr,nc] and not vis[nr,nc]:
                        vis[nr,nc]=True; st.append((nr,nc))
            out.append(comp)
    return out

def fill(g):
    out=g.copy()
    cs=comps(out==0)
    if len(cs)<2: return None
    areas=[len(c) for c in cs]; oi=max(range(len(cs)), key=lambda i: areas[i])
    for i,c in enumerate(cs):
        if i==oi: continue
        for r,cc in c: out[r,cc]=4
    return out
