+            if not all(r0 <= int(r) <= r1 and c0 <= int(c) <= c1 for r, c in pts):
+                continue
+            options.append((int(dr), int(dc)))
+        assert options, "each base fragment needs at least one non-zero legal shift"
+        per_cell.append(options)
+
