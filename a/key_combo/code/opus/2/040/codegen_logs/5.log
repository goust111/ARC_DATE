    if not valid_offsets(shapes): continue
    print('"'found',tries,'hole_area',hole_area,'green_cc',len(comps(g==3)))
    for idx,sh in enumerate(shapes): print(idx,sh)
    print(g)
    print('filled')
    print(filled)
    break
else:
    print('none')
