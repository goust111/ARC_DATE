+def _find_components(grid: np.ndarray, color: int) -> list[dict]:
+    comps = _components_from_mask(grid == int(color))
+    out = []
+    for coords in comps:
+        out.append({"coords": coords, "bbox": bbox_coords(coords), "area": int(coords.shape[0])})
