+        moved = coords + np.array([[dr, dc]], dtype=int)
+        assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < h))
+        assert np.all((0 <= moved[:, 1]) & (moved[:, 1] < w))
+        assert np.all(g[moved[:, 0], moved[:, 1]] != marker_color), "translated fragments must not overwrite markers"
