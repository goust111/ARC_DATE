        if any((cr+dr,cc+dc) in markers for dr,dc in sh): ok=False; break
        for dr,dc in sh: g[cr+dr,cc+dc]=3
    if not ok: continue
    stable, filled = stable_fill(g)
    if not stable: continue
    hole_area=int(np.sum(filled==4))
    if not (3 <= hole_area <= 20): continue
    if len(comps(g==3)) > 4: continue
    if valid_offsets(shapes):
        print('"'found',tries,'hole_area',hole_area,'gcc',len(comps(g==3)))
        for idx,sh in enumerate(shapes): print(idx,sh)
        print(g)
        print('filled')
        print(filled)
        break
else:
    print('none')
