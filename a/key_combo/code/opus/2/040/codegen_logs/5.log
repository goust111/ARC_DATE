+        for i in range(len(absolute)):
+            for j in range(i + 1, len(absolute)):
+                if any(abs(r1 - r2) <= 1 and abs(c1 - c2) <= 1 for r1, c1 in absolute[i] for r2, c2 in absolute[j]):
