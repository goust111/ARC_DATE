+        rot_k = random.randint(0, 3)
+        flip_lr = bool(random.randint(0, 1))
+
+        transformed_input = _transform_grid(base_input, rot_k, flip_lr)
+        expected_output = _transform_grid(BASE_OUTPUT, rot_k, flip_lr)
+
