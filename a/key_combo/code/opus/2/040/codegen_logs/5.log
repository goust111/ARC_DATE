            if any(p in markers for p in pts): continue
            if not all(r0<=r<=r1 and c0<=c<=c1 for r,c in pts): continue
            opts.append(pts)
        if not opts: return False
        cands.append(opts)
    order=sorted(range(len(cands)), key=lambda i: len(cands[i]))
    occ=set(); halo=set()
    def bt(k):
        if k==len(order): return True
        idx=order[k]
        for pts in cands[idx]:
            s=set(pts)
            if s & occ or s & halo: continue
            prev_occ=occ.copy(); prev_halo=halo.copy()
            occ.update(s)
            for r,c in s:
                for dr in (-1,0,1):
                    for dc in (-1,0,1):
                        if dr or dc: halo.add((r+dr,c+dc))
            if bt(k+1): return True
            occ.clear(); occ.update(prev_occ)
            halo.clear(); halo.update(prev_halo)
        return False
    return bt(0)

for tries in range(300000):
    shapes=[random.choice(T) for _ in centers]
    g=np.zeros((9,13),dtype=int)
    for r,c in markers: g[r,c]=2
    ok=True
    for (cr,cc),sh in zip(centers,shapes):
        if any((cr+dr,cc+dc) in markers for dr,dc in sh): ok=False; break
        for dr,dc in sh: g[cr+dr,cc+dc]=3
