+        absolute: list[set[tuple[int, int]]] = []
+        for (cr, cc), shape, (dr, dc) in zip(BASE_CENTERS, BASE_CELL_SHAPES, combo):
+            pts = {(int(cr + r + dr), int(cc + c + dc)) for r, c in shape}
+            absolute.append(pts)
