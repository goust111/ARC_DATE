+            grid[int(r), int(c)] = RED
+    for (cr, cc), shape in zip(BASE_CENTERS, BASE_CELL_SHAPES):
+        for dr, dc in shape:
+            grid[int(cr + dr), int(cc + dc)] = GREEN
