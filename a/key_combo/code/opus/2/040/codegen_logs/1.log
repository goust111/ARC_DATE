from arc_utils import Color, crop_bbox, find_components, paste, random_free_location


BLACK = Color.BLACK
BLUE = Color.BLUE
RED = Color.RED
GREEN = Color.GREEN
PINK = Color.PINK
ORANGE = Color.ORANGE

GEN_RETRIES = 600
GRID_MIN = 16
GRID_MAX = 24
PAIR_COUNT_RANGE = (3, 5)
ACTIVE_COUNT_MAX = 2
ACTIVE_VANISH_PROB = 0.35

SHAPES = [
