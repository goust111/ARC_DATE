+            grid[cursor, :] = DIVIDER
+            cursor += 1
+
+    col_starts = []
+    cursor = 0
+    for j, size in enumerate(col_sizes):
+        col_starts.append(cursor)
+        cursor += size
+        if j < col_count - 1:
+            grid[:, cursor] = DIVIDER
+            cursor += 1
+
+    regions = []
+    for i, rs in enumerate(row_starts):
+        for j, cs in enumerate(col_starts):
+            r0 = rs
+            c0 = cs
+            r1 = rs + row_sizes[i] - 1
+            c1 = cs + col_sizes[j] - 1
+            regions.append((r0, c0, r1, c1))
+    return grid, regions
