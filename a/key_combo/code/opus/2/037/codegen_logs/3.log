0013: def main(input_grid: np.ndarray) -> np.ndarray:
0014:     """
0015:     Keep only the divider region or regions with the most colored pixels and fill them with their color.
0016: 
0017:     Input structure:
0018:     - Full divider rows and columns split the grid into rectangular regions.
0019:     - Each region is mostly black with scattered pixels of one non-black, non-divider color.
0020:     - The divider color appears as a full constant row or column.
0021: 
0022:     Rule:
0023:     - Detect the divider color and extract all separated regions.
0024:     - Count non-black, non-divider colored pixels in each region.
0025:     - Fill regions tied for the maximum count with their single color and fill all other regions black.
0026: 
0027:     Key insight:
0028:     - The scattered pixels are votes for a region; only the densest region contents survive.
0029:     """
0030:     # Create a copy of the input grid to avoid modifying the original
0031:     output_grid = np.copy(input_grid)  
0032: 
0033:     # Get all the rectangular regions seperated by horizontal and vertical dividers
0034:     # The dividers are colored grey, but more generally their color is just whatever color stretches all the way horizontally or vertically
0035:     for r in range(input_grid.shape[0]):
0036:         if np.all(input_grid[r, :] == input_grid[r, 0]):
0037:             divider_color = input_grid[r, 0]
0038:             break
0039:     # For this problem you could also do: divider_color = Color.GRAY
0040:     regions = find_components(output_grid, bg=divider_color, connectivity=4, monochromatic=False, return_format="objects")
0041: 
0042:     # Find the region with the most colored pixels inside of it
0043:     num_colored_pixels = [ np.sum((region != divider_color) & (region != Color.BLACK)) for region in regions ]
0044:     max_colored_pixels = max(num_colored_pixels)
0045: 
0046:     # Fill the region with the most colored pixels with its color
0047:     # Fill the other regions with black
0048:     for region_obj in regions:
0049:         # Figure out if it is one of the max colored regions to determine what the target color is that we are going to fill with
