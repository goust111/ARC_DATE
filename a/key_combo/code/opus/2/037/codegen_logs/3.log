+def _isolated(combo: tuple[tuple[int, int, int], ...]) -> bool:
+    for i in range(len(combo)):
+        for j in range(i + 1, len(combo)):
+            r1, c1, _ = combo[i]
+            r2, c2, _ = combo[j]
