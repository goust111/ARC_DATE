+def _generate_layout() -> np.ndarray:
+    proto_red, proto_orange = _choose_prototypes()
+    max_dims = (
+        max(proto_red.shape[0], proto_orange.shape[0]),
+        max(proto_red.shape[1], proto_orange.shape[1]),
