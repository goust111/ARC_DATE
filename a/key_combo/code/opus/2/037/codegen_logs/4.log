+    route: list[Coord] = []
+    detours: list[dict] = []
+    r, c = sr, sc
+
+    while True:
+        if r == tr or c == tc:
+            break
+
+        dc = 1 if tc > c else -1
+        nr, nc = r + 1, c + dc
+
+        if nr > tr:
+            break
+        if (nr, nc) == (tr, tc):
+            break
+
+        if 0 <= nc < w and int(grid[nr, nc]) == RED:
+            left, right = _red_run(grid[nr], nc)
+            side_col = _nearest_outside_col(c, left, right, w)
+            step = 1 if side_col > c else -1
+            for cc in range(c + step, side_col + step, step):
+                route.append((r, cc))
+            detours.append(
+                {
+                    "row_before": r,
+                    "obstacle_row": nr,
+                    "current_col": c,
+                    "left": left,
+                    "right": right,
+                    "side_col": side_col,
+                }
+            )
+            c = side_col
+            continue
+
+        route.append((nr, nc))
+        r, c = nr, nc
+        if r == tr or c == tc:
+            break
+
+    correction = "none"
+    if r == tr and c != tc:
+        correction = "horizontal"
+        step = 1 if tc > c else -1
+        for cc in range(c + step, tc, step):
+            route.append((r, cc))
+    elif c == tc and r != tr:
+        correction = "vertical"
+        for rr in range(r + 1, tr):
+            route.append((rr, c))
+    return route, detours, correction
