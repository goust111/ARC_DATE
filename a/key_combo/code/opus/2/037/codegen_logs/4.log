+        upper, lower = _sort_pair_components(components)
+        ur0, uc0, ur1, uc1 = upper["bbox"]
+        lr0, lc0, lr1, lc1 = lower["bbox"]
+        start = (ur1, uc1)
+        target = (lr0, lc0)
+        assert start[0] < target[0] and start[1] < target[1]
