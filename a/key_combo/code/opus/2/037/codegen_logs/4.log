    return upper, lower, start, target


def _obstacle_choices(start: Coord, target: Coord, width: int) -> list[tuple[int, int, int]]:
    sr, sc = start
    tr, tc = target
    choices = []
    delta = tr - sr
    for step_idx in range(1, delta):
        obstacle_row = sr + step_idx
        hit_col = sc + step_idx
