+def _paint_route(out: np.ndarray, clean: np.ndarray, color: int, route: list[Coord]) -> None:
+    for r, c in route:
+        val = int(out[r, c])
+        if val in (BG, int(color)):
+            out[r, c] = int(color)
+            continue
+        if int(clean[r, c]) == int(color):
+            out[r, c] = int(color)
+            continue
