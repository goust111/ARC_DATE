+    return bool(np.all(patch == int(color)))
+
+
+def _sort_pair_components(components: list[dict]) -> tuple[dict, dict]:
+    assert len(components) == 2
+    comps = sorted(
+        components,
+        key=lambda comp: ((comp["bbox"][0] + comp["bbox"][2]), (comp["bbox"][1] + comp["bbox"][3])),
