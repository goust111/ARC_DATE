+    route: list[Coord] = []
+    detours: list[dict] = []
+    r, c = sr, sc
+
+    while True:
+        if r == tr or c == tc:
+            break
+
+        dc = 1 if tc > c else -1
+        nr, nc = r + 1, c + dc
+
+        if nr > tr:
+            break
+        if (nr, nc) == (tr, tc):
+            break
+
+        if 0 <= nc < w and int(grid[nr, nc]) == RED:
