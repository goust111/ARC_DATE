+
+    out[clean == RED] = RED
+    return out
+
+
+def _box_cells(box: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = box
+    return {(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1)}
+
+
+def _expanded_box(box: BBox, h: int, w: int, pad: int = 1) -> BBox:
+    r0, c0, r1, c1 = box
