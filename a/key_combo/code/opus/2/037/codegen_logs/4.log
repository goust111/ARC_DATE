+                    "row_before": r,
+                    "obstacle_row": nr,
+                    "current_col": c,
+                    "left": left,
+                    "right": right,
+                    "side_col": side_col,
+                }
+            )
+            r, c = nr, side_col
+            continue
+
+        route.append((nr, nc))
+        r, c = nr, nc
+        if r == tr or c == tc:
+            break
+
+    correction = "none"
+    if r == tr and c != tc:
+        correction = "horizontal"
+        step = 1 if tc > c else -1
+        for cc in range(c + step, tc, step):
+            route.append((r, cc))
+    elif c == tc and r != tr:
