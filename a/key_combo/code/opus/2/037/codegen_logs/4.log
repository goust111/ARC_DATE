+        r0, c0, r1, c1 = box
+        if np.any(rect_guard[r0 : r1 + 1, c0 : c1 + 1]):
+            return False
+    return True
+
+
+def _mark_box(mask: np.ndarray, box: BBox, value: bool = True) -> None:
+    r0, c0, r1, c1 = box
+    mask[r0 : r1 + 1, c0 : c1 + 1] = value
+
+
+def _place_rect(grid: np.ndarray, box: BBox, color: int) -> None:
