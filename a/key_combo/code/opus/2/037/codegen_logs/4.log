+    return comps[0], comps[1]
+
+
+def _red_run(row: np.ndarray, col: int) -> tuple[int, int]:
+    c = int(col)
+    assert int(row[c]) == RED
+    left = c
+    while left - 1 >= 0 and int(row[left - 1]) == RED:
