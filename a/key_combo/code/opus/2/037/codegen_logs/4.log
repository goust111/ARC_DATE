+def _trace_route(grid: np.ndarray, start: Coord, target: Coord) -> tuple[list[Coord], list[dict], str]:
+    _h, w = grid.shape
+    sr, sc = map(int, start)
+    tr, tc = map(int, target)
+    assert sr < tr and sc < tc
