+def _choose_target(rects: list[dict], counts: list[int]) -> dict:
+    scored = list(zip(rects, counts, strict=True))
+    scored.sort(key=lambda item: (item[1], item[0]["area"], item[0]["bbox"][0], item[0]["bbox"][1]))
+    return scored[0][0]
