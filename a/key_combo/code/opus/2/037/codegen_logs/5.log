+        _polyline_cells([attachments["BR"]["bottom"], corner, attachments["TL"]["left"]]),
+    ]
+
+
+def _build_attempt() -> np.ndarray | None:
+    frame_count = random.choice([3, 4])
+    size = random.choice([6, 7, 8])
+    margin = 2
+    max_gap = 30 - 2 * size - 2 * margin
+    if max_gap < 4:
