+    marker_r, marker_c = marker
+    abs_c = c0 + 1 + marker_c
+
+    out[r0 + 1 + marker_r, abs_c] = int(color)
+    for local_r in range(marker_r - 1, -1, -1):
+        if int(source_interior[local_r, marker_c]) != BG:
+            break
+        out[r0 + 1 + local_r, abs_c] = int(color)
