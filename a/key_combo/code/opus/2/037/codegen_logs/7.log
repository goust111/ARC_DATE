            lo, hi = sorted((other["source"], other["target"]))
            if lo <= spec["source"] <= hi:
                if "obs_row" in other:
                    blocked_row = other["obs_row"] + 1
                    allowed_rows = [r for r in allowed_rows if r != blocked_row]
        if len(allowed_rows) < 2:
            return None
        random.shuffle(allowed_rows)
        k = random.randint(2, min(4, len(allowed_rows)))
        for rr in sorted(allowed_rows[:k]):
            grid[rr, spec["source"]] = spec["color"]
    main(grid)
    return grid

for seed in range(20000):
    try:
        res = gen_attempt(seed)
    except Exception as exc:
        print('"'seed', seed, exc)
        break
    if res is None:
        continue
else:
    print('no failures')
