import random
import numpy as np

BACKGROUND = 0
OBSTACLE = 2
PALETTE = [1,3,4,6,7,8,9]


def obstacle_span(grid, row, col):
    left = col
    while left - 1 >= 0 and grid[row, left - 1] == OBSTACLE:
        left -= 1
    right = col
    while right + 1 < grid.shape[1] and grid[row, right + 1] == OBSTACLE:
        right += 1
    return left, right


def choose_bypass(width, source_col, all_source_cols, chosen_targets, intervals, spans):
    blocked_cols = set(all_source_cols) | set(chosen_targets)
    candidates = []
    for dl in range(0, 4):
        for dr in range(0, 4):
            length = dl + dr + 1
            if not (3 <= length <= 6):
                continue
            left = source_col - dl
            right = source_col + dr
            if left < 1 or right > width - 2:
                continue
            if any(col in range(left, right + 1) for col in blocked_cols if col "'!= source_col):
                continue
            left_target = left - 1
            right_target = right + 1
            if left_target >= 0 and dr > dl:
                interval = (left_target, source_col)
                if left_target in blocked_cols:
                    pass
                elif any(lo <= left_target <= hi for lo, hi in intervals + spans):
                    pass
                else:
                    candidates.append(("left", dl, dr, left, right, left_target))
            if right_target < width and dr <= dl:
                interval = (source_col, right_target)
                if right_target in blocked_cols:
                    pass
                elif any(lo <= right_target <= hi for lo, hi in intervals + spans):
                    pass
                else:
                    candidates.append(("right", dl, dr, left, right, right_target))
    return candidates


def main(grid):
    g = np.asarray(grid, dtype=int)
    out = g.copy()
    h, w = out.shape
    for c in np.flatnonzero(g[-1] != BACKGROUND):
        color = int(g[-1, c])
        r = h - 1
        cur_c = int(c)
        while 0 <= r < h:
            val = int(out[r, cur_c])
            if val == BACKGROUND:
                out[r, cur_c] = color
            elif val == color:
                pass
            else:
                raise AssertionError(("vertical", r, cur_c, val, color))
            if r == 0:
                break
            nr = r - 1
            nval = int(out[nr, cur_c])
            if nval == OBSTACLE:
                left, right = obstacle_span(out, nr, cur_c)
                choices = []
                if left - 1 >= 0:
                    choices.append((cur_c - left, 1, left - 1))
                if right + 1 < w:
                    choices.append((right - cur_c, 0, right + 1))
                _, _, target = min(choices)
                step = 1 if target > cur_c else -1
                for cc in range(cur_c, target + step, step):
                    if out[r, cc] in (BACKGROUND, color):
                        out[r, cc] = color
                    else:
                        raise AssertionError(("horiz", r, cc, out[r, cc], color))
                cur_c = target
                r = nr - 1
                continue
            if nval not in (BACKGROUND, color):
                break
            r = nr
    return out


def gen_attempt(seed=None):
    if seed is not None:
        random.seed(seed)
    h = random.randint(16, 24)
    w = random.randint(14, 22)
    marker_count = random.choice([2, 3])
    blocked_count = random.randint(1, marker_count - 1)
    for _ in range(200):
        cols = sorted(random.sample(range(2, w - 2), marker_count))
        if min(b - a for a, b in zip(cols, cols[1:])) < 4:
            continue
        break
    else:
        return None
    blocked_indices = set(random.sample(range(marker_count), blocked_count))
    colors = random.sample(PALETTE, marker_count)
    specs = []
    chosen_targets = []
    intervals = []
    spans = []
    for idx, col in enumerate(cols):
        spec = {"source": col, "color": colors[idx], "blocked": idx in blocked_indices}
        if spec["blocked"]:
            cands = choose_bypass(w, col, cols, chosen_targets, intervals, spans)
            if not cands:
                return None
            side, dl, dr, left, right, target = random.choice(cands)
            spec.update({"side": side, "dl": dl, "dr": dr, "left": left, "right": right, "target": target})
            chosen_targets.append(target)
            intervals.append((min(col, target), max(col, target)))
            spans.append((left, right))
        else:
            spec["target"] = col
        specs.append(spec)
    blocked_specs = [s for s in specs if s["blocked"]]
    rows = []
    for spec in blocked_specs:
        candidates = [r for r in range(3, h - 4) if all(abs(r - prior) >= 2 for prior in rows)]
        if not candidates:
            return None
        spec["obs_row"] = random.choice(candidates)
        rows.append(spec["obs_row"])
    grid = np.zeros((h, w), dtype=int)
    reserved_rows = {}
    for spec in specs:
        grid[h - 1, spec["source"]] = spec["color"]
    for spec in specs:
        if spec["blocked"]:
            r0 = spec["obs_row"]
            grid[r0, spec["left"]:spec["right"] + 1] = OBSTACLE
            forbidden_row = r0 + 1
            reserved_rows.setdefault(spec["source"], set()).add(forbidden_row)
            allowed_rows = [r for r in range(r0 + 1, h - 1) if r != forbidden_row]
        else:
            allowed_rows = list(range(1, h - 1))
