+    assert src.ndim == 2
+
+    out = src.copy()
+    marker_cols = np.flatnonzero(src[-1] != BACKGROUND)
+    for col in marker_cols:
+        _propagate_from_marker(src, out, int(col), int(src[-1, col]))
