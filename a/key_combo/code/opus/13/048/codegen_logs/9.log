+            idx += 1
+    return patch, mapping
+
+
+def _choose_lookup_positions(count: int) -> list[tuple[int, int]]:
+    if random.random() < 0.5:
+        chosen = [(0, 2), (1, 0)]
+    else:
+        chosen = [(0, 0), (1, 2)]
+    if count >= 3:
+        chosen.append(random.choice([(0, 1), (1, 1)]))
+    if count >= 4:
