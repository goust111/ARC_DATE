+                "id": idx,
+                "bbox": box,
+                "patch": patch,
+                "h": h,
+                "w": w,
+                "area": h * w,
+                "marker_color": marker_color,
+                "marker_pos": marker_pos,
+                "fill_color": int(fill_color),
+            }
+        )
