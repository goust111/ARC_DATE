+        "cells": cells,
+        "by_color": by_color,
+        "mask": mask,
+    }
+
+
+def _parse_rectangles(grid: np.ndarray, table_box: tuple[int, int, int, int]) -> list[dict]:
+    lower = grid.copy()
+    r0, c0, r1, c1 = table_box
