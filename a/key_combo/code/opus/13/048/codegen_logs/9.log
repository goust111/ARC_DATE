+BG = 0
+TABLE_BG = 8
+TABLE_SEP = 5
+TABLE_ROWS = 2
+TABLE_COLS = 3
+CELL = 3
+TABLE_H = TABLE_ROWS * CELL + (TABLE_ROWS - 1)
+TABLE_W = TABLE_COLS * CELL + (TABLE_COLS - 1)
+LOWER_START_ROW = 9
+
+REF_COLORS = [1, 2, 3, 4, 6, 7, 9]
+RECT_SHAPES_BY_AREA = {
+    4: [(2, 2)],
+    6: [(2, 3), (3, 2)],
+    8: [(2, 4)],
+    9: [(3, 3)],
+    12: [(3, 4)],
