+
+BG = 0
+TABLE_BG = 8
+TABLE_SEP = 5
+TABLE_ROWS = 2
+TABLE_COLS = 3
+CELL = 3
+TABLE_H = TABLE_ROWS * CELL + (TABLE_ROWS - 1)
+TABLE_W = TABLE_COLS * CELL + (TABLE_COLS - 1)
