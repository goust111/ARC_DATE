+    weights = random.sample((1, 2, 3), 2)
+    phase = random.randrange(n_colors)
+    out = np.zeros(mask.shape, dtype=int)
+    for r, c in np.argwhere(mask):
+        idx = (weights[0] * int(r) + weights[1] * int(c) + phase) % n_colors
