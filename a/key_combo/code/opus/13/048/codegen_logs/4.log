+def _sample_missing_mask(branch: str) -> np.ndarray:
+    mask = random.choice(MASK_LIBRARY[branch]).copy()
+    if branch == "H":
+        if random.random() < 0.5:
+            mask = np.fliplr(mask)
+    elif branch == "V":
+        if random.random() < 0.5:
+            mask = np.flipud(mask)
+    else:
+        for _ in range(random.randint(0, 3)):
+            mask = np.rot90(mask)
+        if random.random() < 0.5:
+            mask = np.fliplr(mask)
+        if random.random() < 0.5:
+            mask = np.flipud(mask)
+    assert _symmetry_kind(mask) == branch
+    assert 2 <= int(mask.sum()) <= 5
+    return mask
