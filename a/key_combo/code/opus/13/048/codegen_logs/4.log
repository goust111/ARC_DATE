+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    if random.random() < 0.5:
+        first, second = complete, damaged
+    else:
+        first, second = damaged, complete
+
+    r0, c0 = pos_a
+    grid[r0 : r0 + h, c0 : c0 + w] = first
+    r1, c1 = pos_b
+    grid[r1 : r1 + h, c1 : c1 + w] = second
