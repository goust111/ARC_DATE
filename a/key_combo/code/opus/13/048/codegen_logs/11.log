+def _paint_region(grid: np.ndarray, top: int, left: int, rel_cells: set[tuple[int, int]], color: int):
+    abs_cells = []
+    for rr, cc in rel_cells:
+        grid[top + rr, left + cc] = color
+        abs_cells.append((top + rr, left + cc))
+    return abs_cells
