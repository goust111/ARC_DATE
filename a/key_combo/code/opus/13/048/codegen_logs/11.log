+            arrow["shaft"],
+            arrow["direction"],
+            arrow["target_color"],
+            arrow["source_color"],
+        )
+        for arrow in scene["arrows"]
+    )
+    if parsed_keys != expected_keys:
+        return False
+
+    if any(not (4 <= len(cells) <= 8) for cells in region_cells):
