+                    arrows = [{"shaft": (top + 1, left + 4), "direction": direction, "source": 0, "target": 1}]
+                else:
+                    arrows = [{"shaft": (top + 1, left + 9), "direction": direction, "source": 1, "target": 2}]
+            else:
