+    settled: list[dict] = []
+    for fragment in _sort_channel_fragments(fragments, height, direction):
+        coords = fragment["coords"]
+        shift = 0
+        while True:
+            candidate = coords + np.array([shift + direction, 0])
+            rows = candidate[:, 0]
+            cols = candidate[:, 1]
+            if int(rows.min()) < 0 or int(rows.max()) >= height:
