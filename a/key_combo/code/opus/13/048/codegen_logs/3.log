+            channel_mask[:, c0 : c1 + 1] = True
+            fragment_mask = visible_mask & channel_mask
+            if not np.any(fragment_mask):
+                continue
+            coords = np.argwhere(fragment_mask)
+            fragments_by_channel[channel].append(
