+def _sample_distinct(rows: list[int], count: int, min_gap: int = 1) -> list[int] | None:
+    rows = rows.copy()
+    random.shuffle(rows)
+    chosen: list[int] = []
+    for value in rows:
+        if all(abs(value - other) >= min_gap for other in chosen):
+            chosen.append(value)
+            if len(chosen) == count:
+                return sorted(chosen)
+    return None
