+        assert not np.any(occupied[final_coords[:, 0], final_coords[:, 1]])
+        occupied[final_coords[:, 0], final_coords[:, 1]] = True
+        settled.append(
+            {
+                **fragment,
+                "final_coords": final_coords,
+                "shift": int(shift),
+                "moved": bool(shift != 0),
+            }
