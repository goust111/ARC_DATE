+    r0, c0, r1, c1 = component["bbox"]
+    if r0 != height - 2 or r1 != height - 1 or c1 - c0 + 1 < BRACKET_WIDTH_MIN:
+        return False
+    expected = {(height - 1, c) for c in range(c0, c1 + 1)}
+    expected.add((height - 2, c0))
+    expected.add((height - 2, c1))
