+    order = sorted(range(len(objects)), key=lambda i: objects[i]["size"][0] * objects[i]["size"][1], reverse=True)
+
+    for _ in range(120):
+        placements: dict[int, tuple[int, int]] = {}
+        for idx in order:
+            oh, ow = objects[idx]["size"]
+            candidates = []
+            for r in range(h - oh + 1):
+                for c in range(w - ow + 1):
