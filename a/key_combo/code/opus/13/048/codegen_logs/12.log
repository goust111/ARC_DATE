+def _neighbors(r: int, c: int, connectivity: int) -> tuple[tuple[int, int], ...]:
+    if connectivity == 4:
+        return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+    return (
+        (r - 1, c - 1),
+        (r - 1, c),
+        (r - 1, c + 1),
+        (r, c - 1),
+        (r, c + 1),
+        (r + 1, c - 1),
+        (r + 1, c),
+        (r + 1, c + 1),
+    )
+
+
+def _components(mask: np.ndarray, connectivity: int) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
