+        lo = 1
+        hi = max(1, length // 2 - size)
+    elif side == "bottom":
+        lo = min(max_start, max(length // 2, 1))
+        hi = max_start - 1
+    elif side == "left":
+        lo = 1
+        hi = max(1, length // 2 - size)
+    elif side == "right":
+        lo = min(max_start, max(length // 2, 1))
+        hi = max_start - 1
+    else:
+        raise ValueError(side)
+    if hi < lo:
+        lo, hi = 0, max_start
+    return int(lo), int(hi)
