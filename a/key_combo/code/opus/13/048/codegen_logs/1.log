+                continue
+
+            if ignore_priority:
+                per_object = [(int(distance_maps[i][r, c]), i) for i in range(len(objects))]
+                best_distance = min(dist for dist, _idx in per_object)
+                winners = [i for dist, i in per_object if dist == best_distance]
+                if len(winners) > 1:
+                    out[r, c] = BLACK
+                else:
