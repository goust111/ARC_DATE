+    distance_maps = []
+    for idx, obj in enumerate(objects):
+        coords = obj["coords"]
+        object_mask[coords[:, 0], coords[:, 1]] = True
+        objects_by_priority[obj["priority"]].append(idx)
+        distance_maps.append(_distance_map(coords, g.shape))
+    out[object_mask] = RED
