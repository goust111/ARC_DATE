+            mask = np.fliplr(mask)
+        return mask
+    if kind == "V":
+        mask = rng.choice(H_TEMPLATES).T.copy()
+        if rng.random() < 0.5:
+            mask = np.flipud(mask)
+        return mask
+    base = rng.choice(D_TEMPLATES).copy()
+    if rng.random() < 0.5:
+        base = np.fliplr(base)
+    if rng.random() < 0.5:
+        base = np.flipud(base)
+    return base
