+        max(0, c0 - gap),
+        min(shape[0] - 1, r1 + gap),
+        min(shape[1] - 1, c1 + gap),
+    )
+
+
+def _bboxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
