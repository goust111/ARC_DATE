  41:     red_coords = red_components[0]["coords"]
  42:     red_set = {tuple(map(int, coord)) for coord in red_coords}
  43:     length = len(red_set)
  44: 
  45:     adjacent = [
  46:         (r, c)
  47:         for r, c in red_set
  48:         if abs(r - pivot_r) + abs(c - pivot_c) == 1
  49:     ]
  50:     assert len(adjacent) == 1
  51:     near_r, near_c = adjacent[0]
  52:     dr = near_r - pivot_r
  53:     dc = near_c - pivot_c
  54:     assert abs(dr) + abs(dc) == 1
  55: 
  56:     expected_source = {
  57:         (pivot_r + k * dr, pivot_c + k * dc)
  58:         for k in range(1, length + 1)
  59:     }
  60:     assert red_set == expected_source
  61: 
  62:     out = g.copy()
  63:     out[g == Color.RED] = Color.GREEN
