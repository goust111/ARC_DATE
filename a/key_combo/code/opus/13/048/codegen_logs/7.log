  30:     bg = get_bg(g)
  31:     assert set(map(int, np.unique(g))) == {bg, Color.RED, Color.GREY}
  32: 
  33:     marker_coords = np.argwhere(g == Color.GREY)
  34:     assert marker_coords.shape == (1, 2)
  35:     pivot_r, pivot_c = map(int, marker_coords[0])
  36: 
  37:     red_components = find_components(
