 404: def find_components(
 405:     grid: np.ndarray,
 406:     *,
 407:     bg: int | None = None,
 408:     connectivity: int = 4,
 409:     monochromatic: bool = True,
 410:     colors: Sequence[int] | None = None,
 411:     min_area: int = 1,
 412:     return_format: str = "dict",
 413: ) -> list[dict] | list[np.ndarray]:
 414:     """
 415:     Find connected components in a grid (unified API for ARC-2 + migrated seeds).
 416: 
 417:     return_format:
 418:       - \"dict\": list of dicts {color, coords, bbox, area}
 419:       - \"objects\": list of full-grid arrays containing exactly one component
 420:     """
 421:     if bg is None:
 422:         bg = get_bg(grid)
 423:     bg = int(bg)
 424: 
 425:     return_format = str(return_format).lower().strip()
 426:     if return_format not in {"dict", "objects"}:
 427:         raise ValueError("find_components: return_format must be 'dict' or 'objects'")
 428: 
 429:     if colors is None:
 430:         colors_set = None
 431:         colors_iter = sorted(set(map(int, grid.flatten())) - {bg})
 432:     else:
 433:         colors_set = {int(c) for c in colors}
 434:         colors_iter = [int(c) for c in colors_set if int(c) != bg]
 435: 
 436:     # Monochromatic = label per-color
 437:     if monochromatic:
 438:         if return_format == "dict":
 439:             out: list[dict] = []
 440:             for col in colors_iter:
 441:                 mask = (grid == col)
 442:                 if not mask.any():
 443:                     continue
 444:                 comps = components_mask(mask, connectivity=connectivity)
 445:                 for coords in comps:
 446:                     if int(coords.shape[0]) < int(min_area):
 447:                         continue
 448:                     out.append(
 449:                         {
 450:                             "color": int(col),
 451:                             "coords": coords,
 452:                             "bbox": bbox_coords(coords),
 453:                             "area": int(coords.shape[0]),
 454:                         }
 455:                     )
 456:             return out
 457: 
 458:         objs: list[np.ndarray] = []
 459:         struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
 460:         for col in colors_iter:
 461:             lab, n = label(grid == int(col), structure=struct)
 462:             for k in range(1, int(n) + 1):
 463:                 m = (lab == k)
 464:                 if int(m.sum()) < int(min_area):
 465:                     continue
 466:                 obj = np.full_like(grid, bg)
 467:                 obj[m] = int(col)
 468:                 objs.append(obj)
 469:         return objs
 470: 
 471:     # Multicolor components = label foreground as a whole
 472:     struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
 473:     if colors_set is None:
 474:         fg_mask = (grid != bg)
 475:     else:
 476:         fg_mask = (grid != bg) & np.isin(grid, list(colors_set))
 477: 
 478:     lab, n = label(fg_mask, structure=struct)
 479:     if return_format == "dict":
 480:         out: list[dict] = []
 481:         for k in range(1, int(n) + 1):
 482:             coords = np.argwhere(lab == k)
 483:             if coords.size == 0 or int(coords.shape[0]) < int(min_area):
 484:                 continue
