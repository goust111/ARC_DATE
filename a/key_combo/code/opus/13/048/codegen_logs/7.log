+        rot = _line_coords(pivot, _rotate_cw(dr, dc), length)
+        if all(_in_bounds(shape, r, c) for r, c in src + rot):
+            allowed.append((dr, dc))
+    return allowed
+
+
+def _sign(direction: tuple[int, int]) -> int:
