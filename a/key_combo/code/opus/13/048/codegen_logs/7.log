 175: def _make_component(area: int, color: int, bg: int) -> dict:
 176:     """Generate a random 8-connected component with the given area and color."""
 177:     dims = _feasible_dims(area)
 178:     irregular_dims = [d for d in dims if d[0] * d[1] > area]
 179:     if irregular_dims and _RNG.random() < IRREGULAR_PROB:
 180:         dims = irregular_dims
 181:     h, w = dims[int(_RNG.integers(0, len(dims)))]
 182:     mask = _make_mask(h, w, area)
 183:     return {"area": area, "color": color, "h": h, "w": w,
 184:             "mask": mask, "pat": _mask_to_pat(mask, color, bg),
 185:             "shape_key": canonical_shape_key(mask)}
 186: 
 187: 
 188: def _random_transform(mask: np.ndarray) -> np.ndarray:
 189:     """Apply a random rotation (0-3) and optional horizontal flip to a mask."""
 190:     mask = np.rot90(mask, int(_RNG.integers(0, 4)))
 191:     if bool(_RNG.integers(0, 2)):
 192:         mask = np.fliplr(mask)
 193:     return mask
 194: 
 195: 
 196: def _clone_component(template: dict, color: int, bg: int) -> dict:
 197:     """Create a duplicate of template's shape with a new color and random transform."""
 198:     mask = _random_transform(template["mask"].copy())
 199:     h, w = mask.shape
 200:     return {"area": template["area"], "color": color, "h": h, "w": w,
 201:             "mask": mask, "pat": _mask_to_pat(mask, color, bg),
 202:             "shape_key": canonical_shape_key(mask)}
 203: 
 204: 
 205: def _assign_columns(widths: list[int], W: int) -> list[int] | None:
 206:     """Distribute components horizontally with random spacing (min gap = MIN_COL_GAP)."""
 207:     n = len(widths)
 208:     total = sum(widths) + MIN_COL_GAP * (n - 1)
 209:     if total > W:
 210:         return None
 211:     slack = W - total
 212:     extras = _RNG.multinomial(slack, np.ones(n + 1) / (n + 1))
 213:     cols = []
 214:     c = int(extras[0])
 215:     for i, w in enumerate(widths):
 216:         cols.append(c)
 217:         c += w
 218:         if i < n - 1:
 219:             c += MIN_COL_GAP + int(extras[i + 1])
 220:     return cols
 221: 
