 223: def _dilate_occupied(occupied: np.ndarray) -> np.ndarray:
 224:     """Return a mask that is True wherever occupied or any 8-neighbor is occupied."""
 225:     dilated = occupied.copy()
 226:     dilated[1:, :] |= occupied[:-1, :]
 227:     dilated[:-1, :] |= occupied[1:, :]
 228:     dilated[:, 1:] |= occupied[:, :-1]
 229:     dilated[:, :-1] |= occupied[:, 1:]
 230:     dilated[1:, 1:] |= occupied[:-1, :-1]
 231:     dilated[1:, :-1] |= occupied[:-1, 1:]
 232:     dilated[:-1, 1:] |= occupied[1:, :-1]
 233:     dilated[:-1, :-1] |= occupied[1:, 1:]
 234:     return dilated
 235: 
 236: 
 237: def _can_place(dilated: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
 238:     """Check if mask placed at (r0, c0) overlaps any dilated-occupied cell."""
 239:     h, w = mask.shape
 240:     return not bool((dilated[r0:r0 + h, c0:c0 + w] & mask).any())
 241: 
 242: 
 243: def _build_output(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray:
 244:     """Paint all components at their output positions."""
 245:     out = np.full((H, W), bg, dtype=int)
 246:     for comp in comps:
 247:         paste(out, comp["pat"], comp["out_r0"], comp["c0"], transparent=bg)
 248:     return out
 249: 
 250: 
 251: def _derive_input(comps: list[dict], H: int, W: int, bg: int) -> np.ndarray | None:
 252:     """Place components at random non-output rows without 8-neighbor overlap."""
 253:     inp = np.full((H, W), bg, dtype=int)
 254:     occupied = np.zeros((H, W), dtype=bool)
 255:     order = list(range(len(comps)))
 256:     _RNG.shuffle(order)
 257:     order.sort(key=lambda i: comps[i]["h"] * comps[i]["w"], reverse=True)
 258: 
 259:     for i in order:
 260:         comp = comps[i]
 261:         h, c0 = comp["h"], comp["c0"]
 262:         rows = [r for r in range(H - h + 1) if r != comp["out_r0"]]
 263:         if not rows:
 264:             rows = list(range(H - h + 1))
 265:         _RNG.shuffle(rows)
 266: 
 267:         dilated = _dilate_occupied(occupied)
 268:         valid = [r for r in rows if _can_place(dilated, comp["mask"], r, c0)]
 269:         if not valid:
 270:             valid = [r for r in range(H - h + 1)
 271:                      if _can_place(dilated, comp["mask"], r, c0)]
 272:         if not valid:
 273:             return None
 274: 
 275:         r0 = valid[int(_RNG.integers(0, len(valid)))]
 276:         comp["in_r0"] = r0
