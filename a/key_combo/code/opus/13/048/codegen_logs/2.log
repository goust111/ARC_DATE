  20: def main(grid: np.ndarray) -> np.ndarray:
  21:     """
  22:     Crop the unique foreground object whose mask is not mirror-symmetric left-to-right.
  23: 
  24:     Input structure
  25:     - A dominant background surrounds several same-color 8-connected foreground objects.
  26:     - Exactly one foreground color appears.
  27:     - All but one foreground object are mirror-symmetric left-to-right inside their tight bboxes.
  28: 
  29:     Rule
  30:     - Split the non-background pixels into 8-connected objects.
  31:     - Build each object's tight bbox crop over the background.
  32:     - Return the single crop whose foreground mask differs from its left-right reflection.
  33: 
  34:     Key insight
  35:     - The input is a set of candidate sprites, and vertical-axis asymmetry identifies which one to extract regardless of color or position.
  36:     """
  37:     g = np.asarray(grid, dtype=int)
  38:     assert g.ndim == 2, "expected a 2D grid"
  39: 
