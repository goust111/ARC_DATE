+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+ROTATION_TO_COLOR = {0: RED, 1: GREEN, 2: BLUE, 3: YELLOW}
+MAX_GENERATION_ATTEMPTS = 500
