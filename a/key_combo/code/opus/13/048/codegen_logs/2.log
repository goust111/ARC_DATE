   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Rotate the red segment one quarter-turn clockwise around the grey marker, recoloring its original cells green.
  10: 
  11:     Input structure:
  12:     - The grid has a dominant background, exactly one grey marker, and one red
  13:       4-connected segment.
  14:     - The red segment is a straight horizontal or vertical bar attached to the
  15:       grey marker at exactly one end.
  16:     - The clockwise-rotated red segment fits on the same canvas.
  17: 
  18:     Rule:
  19:     - Locate the grey marker and the adjacent red cell, which gives the bar's
  20:       direction away from the marker.
  21:     - Recolor every input red cell green.
  22:     - Draw a red segment of the same length from the marker in the direction
  23:       obtained by rotating the original direction clockwise.
  24: 
  25:     Key insight:
  26:     - The grey marker is the pivot, and the side occupied by the red bar tells
  27:       which perpendicular side receives the new red bar.
  28:     """
  29:     g = np.asarray(grid, dtype=int)
  30:     bg = get_bg(g)
  31:     assert set(map(int, np.unique(g))) == {bg, Color.RED, Color.GREY}
  32: 
  33:     marker_coords = np.argwhere(g == Color.GREY)
  34:     assert marker_coords.shape == (1, 2)
  35:     pivot_r, pivot_c = map(int, marker_coords[0])
  36: 
  37:     red_components = find_components(
  38:         g, bg=bg, connectivity=4, monochromatic=True, colors=[Color.RED]
  39:     )
  40:     assert len(red_components) == 1
  41:     red_coords = red_components[0]["coords"]
  42:     red_set = {tuple(map(int, coord)) for coord in red_coords}
  43:     length = len(red_set)
  44: 
  45:     adjacent = [
  46:         (r, c)
  47:         for r, c in red_set
  48:         if abs(r - pivot_r) + abs(c - pivot_c) == 1
  49:     ]
  50:     assert len(adjacent) == 1
  51:     near_r, near_c = adjacent[0]
  52:     dr = near_r - pivot_r
  53:     dc = near_c - pivot_c
  54:     assert abs(dr) + abs(dc) == 1
  55: 
  56:     expected_source = {
  57:         (pivot_r + k * dr, pivot_c + k * dc)
  58:         for k in range(1, length + 1)
  59:     }
  60:     assert red_set == expected_source
  61: 
  62:     out = g.copy()
  63:     out[g == Color.RED] = Color.GREEN
  64: 
  65:     rotated_dr, rotated_dc = dc, -dr
  66:     H, W = g.shape
  67:     for k in range(1, length + 1):
  68:         r = pivot_r + k * rotated_dr
  69:         c = pivot_c + k * rotated_dc
  70:         assert 0 <= r < H and 0 <= c < W
  71:         assert int(g[r, c]) == bg
  72:         out[r, c] = Color.RED
  73: 
  74:     return out
