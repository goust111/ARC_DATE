 107: 
 108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),
 109:                (0, 1), (1, -1), (1, 0), (1, 1)]
 110: 
 111: 
 112: def _feasible_dims(area: int) -> list[tuple[int, int]]:
 113:     """Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10."""
 114:     dims = []
 115:     for h in range(1, BBOX_MAX + 1):
 116:         for w in range(1, BBOX_MAX + 1):
 117:             if area > h * w:
 118:                 continue
 119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:
 120:                 continue
 121:             if h == 1 and area != w:
 122:                 continue
 123:             if w == 1 and area != h:
 124:                 continue
 125:             if h > 1 and w > 1 and area < max(h, w):
 126:                 continue
 127:             dims.append((h, w))
 128:     return dims
 129: 
 130: 
 131: def _line_mask(h: int, w: int) -> np.ndarray:
 132:     """Create a seed mask along a diagonal line spanning the bbox, randomly flipped."""
 133:     mask = np.zeros((h, w), dtype=bool)
 134:     if h == 1:
 135:         mask[0, :] = True
 136:         return mask
 137:     if w == 1:
 138:         mask[:, 0] = True
 139:         return mask
 140:     steps = max(h, w)
 141:     for i in range(steps):
 142:         r = int(round(i * (h - 1) / (steps - 1)))
 143:         c = int(round(i * (w - 1) / (steps - 1)))
 144:         mask[r, c] = True
 145:     if bool(_RNG.integers(0, 2)):
