  41:     foreground_colors = colors_present(g, exclude={bg})
  42:     assert len(foreground_colors) == 1, "expected one foreground color"
  43: 
  44:     asymmetric_crops: list[np.ndarray] = []
  45:     for coords in components_mask(g != bg, connectivity=8):
  46:         crop = _component_crop(g, coords, bg)
  47:         mask = crop != bg
  48:         if not np.array_equal(mask, np.fliplr(mask)):
  49:             asymmetric_crops.append(crop)
  50: 
  51:     assert len(asymmetric_crops) == 1, "expected exactly one left-right-asymmetric object"
