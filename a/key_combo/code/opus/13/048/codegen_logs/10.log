+def _layout_from_sizes(sizes: list[int]) -> tuple[list[tuple[int, int]], list[int], int]:
+    spans: list[tuple[int, int]] = []
+    dividers: list[int] = []
+    pos = 0
+    for idx, size in enumerate(sizes):
+        spans.append((pos, pos + size))
+        pos += size
+        if idx < len(sizes) - 1:
+            dividers.append(pos)
+            pos += 1
