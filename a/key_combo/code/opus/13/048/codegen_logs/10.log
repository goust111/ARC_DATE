+def _make_candidate(rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray] | None:
+    mode = str(rng.choice(["diff_tie", "same_tie", "mixed", "free"], p=[0.34, 0.24, 0.24, 0.18]))
