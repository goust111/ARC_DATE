+def _marker_grid(final_regions: np.ndarray) -> np.ndarray:
+    marks = np.full((final_regions.shape[0] - 1, final_regions.shape[1] - 1), GREY, dtype=int)
+    for i in range(marks.shape[0]):
+        for j in range(marks.shape[1]):
+            around = {
