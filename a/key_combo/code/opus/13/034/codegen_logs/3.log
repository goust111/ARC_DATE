+            return True
+    return False
+
+
+def _render_grid(objects: list[dict], H: int, W: int) -> np.ndarray:
+    grid = np.zeros((H, W), dtype=int)
+    for obj in objects:
+        r0, c0 = obj["pos"]
+        patch = obj["patch"]
+        grid[r0 : r0 + 3, c0 : c0 + 3] = patch
+    return grid
+
+
+def _sample_branch() -> str:
+    global _GEN_COUNTER
+    branch = _PAIR_BRANCHES[_GEN_COUNTER % len(_PAIR_BRANCHES)]
+    _GEN_COUNTER += 1
+    return branch
