+
+    signatures = Counter()
+    anomaly_sig = _signature(_make_sprite(anomaly_mask, _ANOMALY_COLOR))
+    signatures[anomaly_sig] += 1
+
+    objects: list[dict] = [
+        {
+            "kind": "anomaly",
+            "pair_idx": None,
+            "patch": _make_sprite(anomaly_mask, _ANOMALY_COLOR),
+            "mask": anomaly_mask.copy(),
+            "color": _ANOMALY_COLOR,
+        }
