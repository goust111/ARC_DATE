+    br, bc = blocker
+    candidates = []
+    for fh, fw in SIZE_OPTIONS:
+        for side in ("top", "bottom", "left", "right"):
+            span = fw if side in ("top", "bottom") else fh
+            for offset in range(1, span - 1):
+                if side == "top":
+                    r0, c0 = br, bc - offset
+                elif side == "bottom":
