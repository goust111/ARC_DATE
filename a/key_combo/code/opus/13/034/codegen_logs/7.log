+def _spiral_path(seed_r: int, seed_c: int, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    r, c = seed_r, seed_c
+    max_delta = max(r, h - 1 - r, c, w - 1 - c)
+    max_leg = 2 * (max_delta + 1)
+    direction_index = 0
+    leg_len = 2
+    path: list[tuple[int, int]] = []
