+    forbidden_cells: set[tuple[int, int]],
+    used_bboxes: list[tuple[int, int, int, int]],
+    forbid_seed: tuple[int, int],
+) -> list[tuple[int, int, int, int]]:
+    h, w = shape
+    candidates = []
+    for fh, fw in SIZE_OPTIONS:
+        for r0 in range(h - fh + 1):
+            r1 = r0 + fh - 1
+            for c0 in range(w - fw + 1):
