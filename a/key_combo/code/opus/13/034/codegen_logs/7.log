spec:
  grid: 17-26 rows x 18-23 cols
  background: 0 (black)
  lattice:
    divider_color: one non-bg color; single-pixel lines spanning full width/height
    divider_spacing: uniform within each axis; 5-6 cells apart
    num_divider_rows: 3-4; num_divider_cols: 3
    cell_grid: 4-5 rows x 4 cols of rectangular cells
    cell_size: 4x4 or 5x5 (uniform except last row/col may be truncated to 2-3)
  sprites:
    count: 1-3 distinct sprite colors, each != bg and != divider
    per_group: 3 cells in an L-shape within a 2x2 block of equal-sized cells (never truncated edge cells)
    missing_corner: any of TL/TR/BL/BR; varies per group
    pixel_count: 4-6 colored pixels per cell
    symmetry: NOT LR-symmetric AND NOT UD-symmetric (ensures non-trivial reflection)
    reflection: the 4 cells of each 2x2 block are H/V/HV reflections of one canonical sprite
    blocks_non_overlapping: 2x2 blocks of different colors share no cells
  transform: fill the missing 4th cell with the appropriate H/V/HV reflection of the canonical sprite

generation_strategy:
  approach: output-first
  steps:
    1. Pick cell_size S in {4,5}, num_divider_rows R in {3,4}, num_divider_cols C=3
    2. Pick num_groups G in {1,2,3}; pick G distinct sprite colors + 1 divider color, all != bg
    3. For each group, generate a canonical SxS binary sprite with 4-6 pixels, asymmetric under both LR and UD flip
    4. Build the full cell grid (R+1 x C+1); optionally truncate last row/col to 2..S-1
    5. Place each group's 2x2 block in non-overlapping positions using only full-sized cell pairs
    6. Fill all 4 cells of each block with canonical + H-flip + V-flip + HV-flip => this is the output lattice content
    7. Assemble full output grid: divider lines + cell contents + bg fill
    8. For each group, randomly remove one of the 4 cells (clear to bg) => this is the input
```
