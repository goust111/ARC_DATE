+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+SEED = 3
+MOTIF = 4
+FRAME = 5
+
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+QUADS = ("TL", "TR", "BL", "BR")
+SIZE_OPTIONS = ((6, 6), (6, 8), (8, 6), (8, 8))
+GEN_ATTEMPTS = 500
