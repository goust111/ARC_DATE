+def _wrong_all_down(categories: np.ndarray) -> np.ndarray:
+    return _simulate_categories(categories, all_down=True, green_blocks=False, paint_green=False)
+
+
+def _wrong_all_up(categories: np.ndarray) -> np.ndarray:
