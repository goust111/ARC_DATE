+def _column_safe(col: np.ndarray) -> bool:
+    green_rows = np.flatnonzero(col == CAT_BOTH)
+    bounds = [-1] + [int(v) for v in green_rows] + [len(col)]
+    for lo, hi in zip(bounds, bounds[1:]):
