+    left = g[:bar_row, :sep]
+    right = g[:bar_row, sep + 1 :]
+    assert left.shape == right.shape and left.size > 0
+    assert set(map(int, np.unique(left))) <= {BLACK, ORANGE}
+    assert set(map(int, np.unique(right))) <= {BLACK, ORANGE}
