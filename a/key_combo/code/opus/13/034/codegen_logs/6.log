 157:     source_rel, marker_rel = _template_cells(
 158:         g, template, template_coords, source_color, marker_color
 159:     )
 160:     targets = _target_marker_squares(g, bg, marker_color, template_coords)
 161:     instances = _matched_instances(targets, marker_rel)
 162: 
 163:     out = g.copy()
 164:     for (origin_r, origin_c), scale in instances:
 165:         block = np.full((scale, scale), int(source_color), dtype=int)
 166:         for rel_r, rel_c in source_rel:
 167:             paste(
 168:                 out,
 169:                 block,
 170:                 origin_r + rel_r * scale,
 171:                 origin_c + rel_c * scale,
 172:                 transparent=bg,
 173:                 overwrite=False,
 174:                 clip=True,
 175:             )
 176: 
 177:     return out
