  23:     g = np.asarray(grid, dtype=int)
  24:     bg = get_bg(g)
  25:     fg_colors = [int(color) for color in np.unique(g) if int(color) != bg]
  26:     assert len(fg_colors) == 1
  27: 
  28:     fg = g != bg
  29:     out = g.copy()
  30:     height, width = g.shape
  31:     groups = {"nw_se": [], "ne_sw": []}
  32: 
  33:     for r0, c0 in np.argwhere(fg):
  34:         r, c = int(r0), int(c0)
  35:         has_nw_se = (
  36:             (r > 0 and c > 0 and fg[r - 1, c - 1])
  37:             or (r + 1 < height and c + 1 < width and fg[r + 1, c + 1])
  38:         )
  39:         has_ne_sw = (
  40:             (r > 0 and c + 1 < width and fg[r - 1, c + 1])
  41:             or (r + 1 < height and c > 0 and fg[r + 1, c - 1])
  42:         )
  43:         assert has_nw_se ^ has_ne_sw
  44:         groups["nw_se" if has_nw_se else "ne_sw"].append((r, c))
  45: 
  46:     nw_se_count = len(groups["nw_se"])
  47:     ne_sw_count = len(groups["ne_sw"])
  48:     assert nw_se_count > 0 and ne_sw_count > 0
  49:     assert nw_se_count != ne_sw_count
  50: 
  51:     larger = "nw_se" if nw_se_count > ne_sw_count else "ne_sw"
  52:     smaller = "ne_sw" if larger == "nw_se" else "nw_se"
  53: 
  54:     for r, c in groups[larger]:
  55:         out[r, c] = Color.TEAL
  56:     for r, c in groups[smaller]:
  57:         out[r, c] = Color.RED
  58: 
  59:     return out
