+    moves = _alternate_moves(blue_starts, red_starts)
+
+    pending = np.zeros((active_h, width), dtype=bool)
+    if block_unmoved:
+        for color, (r, c) in moves:
+            pending[r, c] = True
+
+    for color, (r0, c0) in moves:
+        if block_unmoved:
+            pending[r0, c0] = False
+
+        if settled[r0, c0]:
+            trace["start_conflict"] = True
+
+        occupied = settled | pending
+        r = r0
+        if color == BLUE:
+            while r + 1 < active_h and not occupied[r + 1, c0]:
+                r += 1
+            if r + 1 == active_h:
+                stop_reason = "grey"
+            elif categories[r + 1, c0] == CAT_BOTH and green_blocks:
+                stop_reason = "green"
+            else:
+                stop_reason = "mover"
+        else:
+            while r - 1 >= 0 and not occupied[r - 1, c0]:
+                r -= 1
+            if r == 0:
+                stop_reason = "top"
+            elif categories[r - 1, c0] == CAT_BOTH and green_blocks:
+                stop_reason = "green"
+            else:
+                stop_reason = "mover"
+
+        settled[r, c0] = True
+        out[r, c0] = color
+        trace["moves"].append(
+            {
+                "color": color,
+                "start": (r0, c0),
+                "end": (r, c0),
+                "distance": abs(r - r0),
+                "stop": stop_reason,
+            }
+        )
