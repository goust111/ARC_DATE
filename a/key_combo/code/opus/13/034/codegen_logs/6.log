+            while r + 1 < active_h and not occupied[r + 1, c0]:
+                r += 1
+            if r + 1 == active_h:
+                stop_reason = "grey"
+            elif categories[r + 1, c0] == CAT_BOTH and green_blocks:
+                stop_reason = "green"
+            else:
+                stop_reason = "mover"
+        else:
+            while r - 1 >= 0 and not occupied[r - 1, c0]:
+                r -= 1
+            if r == 0:
+                stop_reason = "top"
+            elif categories[r - 1, c0] == CAT_BOTH and green_blocks:
+                stop_reason = "green"
+            else:
+                stop_reason = "mover"
