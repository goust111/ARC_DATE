+            return False
+        categories[r, blue_col] = CAT_LEFT
+    for r in red_rows:
+        if categories[r, red_col] != CAT_NONE:
+            return False
+        categories[r, red_col] = CAT_RIGHT
+
+    return all(_column_safe(categories[:, c]) for c in cols)
