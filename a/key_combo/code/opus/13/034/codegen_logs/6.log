+    inp = _make_input_from_categories(categories)
+    if not np.array_equal(main(inp), out):
+        return False
+    return True
+
+
+def _place_base_patterns(categories: np.ndarray, rng: np.random.Generator) -> bool:
+    active_h, width = categories.shape
