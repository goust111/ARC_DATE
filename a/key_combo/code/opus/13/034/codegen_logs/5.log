+                "bbox": box,
+                "variant_idx": idx,
+                "mirror": variants[idx]["mirror"],
+                "rot": variants[idx]["rot"],
+            }
+        )
+
+    distractor_count = random.randint(1, 3)
+    distractor_added = 0
+    for _ in range(distractor_count):
+        if random.random() < 0.5:
+            distractor_added += int(_add_partial_distractor(grid, blocked, variants))
+        else:
