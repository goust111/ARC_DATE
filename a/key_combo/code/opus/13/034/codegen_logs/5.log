+def _components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if connectivity == 4:
+                    nbrs = _neighbors4(rr, cc)
+                else:
+                    nbrs = (
+                        (rr + dr, cc + dc)
+                        for dr in (-1, 0, 1)
+                        for dc in (-1, 0, 1)
+                        if dr != 0 or dc != 0
+                    )
+                for nr, nc in nbrs:
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
