+
+
+def _add_extra_red_distractor(
+    grid: np.ndarray,
+    blocked: list[tuple[int, int, int, int]],
+    variants: list[dict],
+) -> bool:
+    order = list(range(len(variants)))
+    random.shuffle(order)
+    for idx in order:
+        mask = variants[idx]["grid"]
+        zeros = list(zip(*np.nonzero(~mask)))
