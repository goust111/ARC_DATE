  "type": "move_to_match",
  "src": "source rectangular sprite s with fill-color cells and an embedded marker-color mask",
  "dst": "empty rectangular slot d containing marker-color pixels",
  "match_cond": "d.marker_mask equals a rotation/reflection of s.marker_mask; every non-marker in-bounds cell of d is bg",
  "transform": "paint d's bg cells with s.fill_color; preserve marker pixels and the original source sprite"
}
</annotation>
<generation_spec>
