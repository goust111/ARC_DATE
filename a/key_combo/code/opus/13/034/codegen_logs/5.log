+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FILL = 1
+MARK = 2
+
+GRID_MIN = 17
+GRID_MAX = 23
+SOURCE_SIZES = (5, 6)
+MATCH_COUNTS = (1, 2)
+MAX_GENERATION_ATTEMPTS = 500
+PLACEMENT_GAP = 1
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if connectivity == 4:
+                    nbrs = _neighbors4(rr, cc)
+                else:
+                    nbrs = (
+                        (rr + dr, cc + dc)
+                        for dr in (-1, 0, 1)
+                        for dc in (-1, 0, 1)
+                        if dr != 0 or dc != 0
+                    )
+                for nr, nc in nbrs:
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _connected4(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    return coords.size > 0 and len(_components_mask(mask, connectivity=4)) == 1
+
+
+def _swap_colors(patch: np.ndarray) -> np.ndarray:
+    out = patch.copy()
+    out[patch == FILL] = MARK
+    out[patch == MARK] = FILL
+    return out
+
+
+def _apply_transform(arr: np.ndarray, mirror: bool, rot: int) -> np.ndarray:
+    transformed = np.fliplr(arr) if mirror else arr.copy()
+    return np.rot90(transformed, rot)
+
+
+def _unique_transforms(arr: np.ndarray) -> list[dict]:
+    variants: list[dict] = []
+    for mirror in (False, True):
+        for rot in range(4):
+            transformed = _apply_transform(arr, mirror, rot)
+            if any(np.array_equal(transformed, item["grid"]) for item in variants):
+                continue
+            variants.append(
+                {
+                    "grid": transformed,
+                    "mirror": mirror,
+                    "rot": rot,
+                }
+            )
+    return variants
