+        patch[mask] = MARK
+        return patch
+    return None
+
+
+def _candidate_boxes(
+    grid_shape: tuple[int, int],
+    shape: tuple[int, int],
+    blocked: list[tuple[int, int, int, int]],
+) -> list[tuple[int, int, int, int]]:
+    h_grid, w_grid = grid_shape
+    h, w = shape
+    options = []
+    for r0 in range(h_grid - h + 1):
+        for c0 in range(w_grid - w + 1):
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if all(_boxes_separated(box, other) for other in blocked):
+                options.append(box)
+    random.shuffle(options)
+    return options
+
+
+def _place_mask_cells(grid: np.ndarray, box: tuple[int, int, int, int], mask: np.ndarray) -> None:
+    r0, c0, _r1, _c1 = box
+    rows, cols = np.nonzero(mask)
+    for rr, cc in zip(rows, cols):
+        grid[r0 + rr, c0 + cc] = MARK
+
+
+def _add_partial_distractor(
+    grid: np.ndarray,
+    blocked: list[tuple[int, int, int, int]],
+    variants: list[dict],
+) -> bool:
+    order = list(range(len(variants)))
+    random.shuffle(order)
+    for idx in order:
+        mask = variants[idx]["grid"]
+        if int(mask.sum()) <= 1:
+            continue
+        for box in _candidate_boxes(grid.shape, mask.shape, blocked):
+            coords = list(zip(*np.nonzero(mask)))
+            random.shuffle(coords)
+            keep = coords[:-1]
+            if not keep:
+                continue
+            temp = grid.copy()
+            r0, c0, _r1, _c1 = box
+            for rr, cc in keep:
+                temp[r0 + rr, c0 + cc] = MARK
+            source_bbox, source_patch = _find_source(temp)
+            source_mask = source_patch == MARK
+            if len(_all_exact_matches(temp, _unique_transforms(source_mask), source_bbox)) == 0:
+                grid[:] = temp
+                blocked.append(box)
+                return True
+    return False
+
+
+def _add_extra_red_distractor(
+    grid: np.ndarray,
+    blocked: list[tuple[int, int, int, int]],
+    variants: list[dict],
+) -> bool:
+    order = list(range(len(variants)))
+    random.shuffle(order)
+    for idx in order:
+        mask = variants[idx]["grid"]
+        zeros = list(zip(*np.nonzero(~mask)))
+        if not zeros:
+            continue
+        for box in _candidate_boxes(grid.shape, mask.shape, blocked):
+            temp = grid.copy()
+            _place_mask_cells(temp, box, mask)
+            r0, c0, _r1, _c1 = box
+            rr, cc = random.choice(zeros)
+            temp[r0 + rr, c0 + cc] = MARK
+            source_bbox, source_patch = _find_source(temp)
+            source_mask = source_patch == MARK
+            if len(_all_exact_matches(temp, _unique_transforms(source_mask), source_bbox)) == 0:
+                grid[:] = temp
+                blocked.append(box)
+                return True
+    return False
+
+
+def _render_expected_output(
+    inp: np.ndarray,
+    source_patch: np.ndarray,
+    matches: list[dict],
