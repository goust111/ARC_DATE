+                            "bbox": (r0, c0, r1, c1),
+                            "variant_idx": idx,
+                            "mirror": variant["mirror"],
+                            "rot": variant["rot"],
+                        }
+                    )
+    return matches
+
+
+def main(grid: np.ndarray) -> np.ndarray:
