+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+FILL = 1
+MARK = 2
+
+GRID_MIN = 17
+GRID_MAX = 23
+SOURCE_SIZES = (5, 6)
+MATCH_COUNTS = (1, 2)
+MAX_GENERATION_ATTEMPTS = 500
+PLACEMENT_GAP = 1
