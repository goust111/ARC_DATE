    return out


def _gen_choose_canvas_and_color() -> tuple[int, int]:
    n = random.randint(CANVAS_SIZE_MIN, CANVAS_SIZE_MAX)
    color = random.choice(FOREGROUND_COLORS)
    return n, int(color)


