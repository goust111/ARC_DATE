+            rr, cc = random.choice(zeros)
+            grid[r0 + rr, c0 + cc] = MARK
+            blocked.append(box)
+            return True
+    return False
+
+
+def _render_expected_output(
+    inp: np.ndarray,
+    source_patch: np.ndarray,
+    matches: list[dict],
+) -> np.ndarray:
+    out = inp.copy()
+    swapped = _swap_colors(source_patch)
