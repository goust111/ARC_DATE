+def _semantic_checks(inp: np.ndarray, expected_right: np.ndarray, lookup: list[int], stats: dict[str, int]) -> bool:
+    if stats["first_mismatch_rows"] == 0 or stats["last_mismatch_rows"] == 0 or stats["two_noise_rows"] == 0:
