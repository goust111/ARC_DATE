    pitch: 5 in both dimensions (odd, >=3 required by solver)
    marker_rows: 3-4 evenly spaced rows of single-pixel markers
    marker_cols: 2-4 evenly spaced columns of single-pixel markers
    first_marker: row 0-2, col 0-2
    grid_sized_so: each non-boundary marker has pitch rows and cols of space below-right
  cells:
