+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+LEFT_HEIGHT = 12
+LEFT_WIDTH = 9
+RIGHT_HEIGHT = 12
+RIGHT_WIDTH = 9
+INPUT_SHAPE = (12, 19)
+OUTPUT_SHAPE = (12, 9)
