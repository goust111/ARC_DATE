spec:
  grid: 7x7 [observed]
  background: BLACK
  foreground: TEAL (exactly one fg color)
  objects:
    type: L-shaped triskelion (3 cells of a 2x2 box, one corner missing)
    count: 2-4
    orientation: any of 4 rotations (TL/TR/BL/BR missing); all 4 appear across examples
    separation: bounding boxes must not overlap or be 4-adjacent (min chebyshev gap >= 1 between bboxes)
  transform:
    rule: for each L object, paint the single missing corner of its 2x2 bbox BLUE
    output_colors: BLACK + TEAL + BLUE

generation_strategy:
  approach: direct (simple enough for forward generation)
  steps:
    1. Create 7x7 BLACK grid.
    2. Pick count = randint(2, 4) L objects.
    3. For each L, pick a random 2x2 anchor (r, c) where r in [0, 5], c in [0, 5], and choose one of 4 missing-corner orientations uniformly.
    4. Before placing, verify the 2x2 box does not overlap or 4-adjacently touch any already-placed 2x2 box (chebyshev gap >= 1 between bboxes).
    5. Fill the 3 non-missing cells with TEAL. Retry anchor/orientation if placement fails; reject grid if not all objects placed after reasonable attempts.
```
