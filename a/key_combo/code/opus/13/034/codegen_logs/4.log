+            maroon_mask = patch == MAROON
+            assert 1 <= int(np.count_nonzero(maroon_mask)) <= 3, "each cell must contain a 1-3 pixel maroon sprite"
+            patch[maroon_mask] = int(lookup_colors[idx])
+            idx += 1
+    return out
