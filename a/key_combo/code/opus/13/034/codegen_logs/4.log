+    sep_col = int(sep_candidates[0])
+
+    left = g[:, :sep_col]
+    right = g[:, sep_col + 1 :]
+
+    lookup = [_dominant_non_bg(left[r, :]) for r in range(left.shape[0])]
+    return _expected_output_from_lookup(right, lookup)
