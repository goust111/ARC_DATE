+def _expand_mask(mask: np.ndarray) -> np.ndarray:
+    size = int(mask.shape[0])
+    out = np.zeros((size * size, size * size), dtype=bool)
+    for r in range(size):
+        for c in range(size):
+            if mask[r, c]:
