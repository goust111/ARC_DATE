+    left = g[:, :mid]
+    right = g[:, mid + 1 :]
+    assert left.shape == right.shape == (height, height), "panels must be equal N x N squares"
+
+    left_mask = _validate_seed(left, LEFT_COLOR)
+    right_mask = _validate_seed(right, RIGHT_COLOR)
