+    left_expanded = _expand_mask(left_mask)
+    right_expanded = _expand_mask(right_mask)
+    overlap = int(np.logical_and(left_expanded, right_expanded).sum())
+    xor_mask = np.logical_xor(left_expanded, right_expanded)
