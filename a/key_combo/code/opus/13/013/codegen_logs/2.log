  grid: 5 rows x 9 cols (odd width) [observed]
  layout: left_panel | separator_col | right_panel, each panel 5x4 [observed]
  separator:
    single solid-color column at center (col W//2)
    color: YELLOW(4) [observed]; must differ from bg and not appear in either panel
  panels:
    each is a binary mask — exactly 1 background color + 1 foreground color
    bg: BLACK(0) [observed]; shared by both panels (exactly 1 common color)
    left_fg: AZURE(8), right_fg: GREY(5) [observed]; must differ from each other and from bg/sep
    foreground density: 40-60% per panel [observed]
  overlap: panels share 4-7 foreground cells at same positions [observed]
  output:
    same size as one panel (5x4)
    XOR of the two binary masks — cells where exactly one panel has fg become RED(2), rest become bg
