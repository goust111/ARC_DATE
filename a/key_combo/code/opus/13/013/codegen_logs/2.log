+    size = int(mask.shape[0])
+    out = np.zeros((size * size, size * size), dtype=bool)
+    for r in range(size):
+        for c in range(size):
+            if mask[r, c]:
+                out[r * size : (r + 1) * size, c * size : (c + 1) * size] = mask
+    return out
+
+
