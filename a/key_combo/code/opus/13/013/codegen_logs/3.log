        added = False
        for p in candidates:
            new_comp = set(comp)
            new_comp.add(p)
            if can_use_component(new_comp, outline_mask, placed):
                comp = new_comp
                frontier.append(p)
                added = True
                break
        if not added:
            break
    return comp if can_use_component(comp, outline_mask, placed) else None


