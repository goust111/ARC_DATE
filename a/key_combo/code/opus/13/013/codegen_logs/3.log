+    src = np.zeros_like(outline_mask, dtype=bool)
+    for r, c in np.argwhere(exterior_mask & bg_mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in DIRS4:
+            nr, nc = rr + dr, cc + dc
+            if in_bounds(outline_mask.shape, nr, nc) and outline_mask[nr, nc]:
+                src[rr, cc] = True
