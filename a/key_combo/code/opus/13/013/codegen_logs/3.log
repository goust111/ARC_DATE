+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def flood_from_border(passable: np.ndarray) -> np.ndarray:
+    h, w = passable.shape
+    seen = np.zeros_like(passable, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
