    placed = set()
    comps_out = []
    n_obstacles = random.randint(2, 4)
    good_rays = [ray for ray in rays if len(ray['path']) >= 4]
    random.shuffle(good_rays)
    n_blocking = min(len(good_rays), random.randint(1, min(2, n_obstacles)))
    used_sources = set()
    for ray in good_rays:
        if len(comps_out) >= n_blocking:
            break
        source = ray['source']
        if source in used_sources:
            continue
        candidates = [p for p in ray['path'][2:-1] if p not in placed]
        random.shuffle(candidates)
        for anchor in candidates:
            size = random.randint(1, 3)
            comp = grow_component(anchor, size, outline, placed)
            if comp is None:
