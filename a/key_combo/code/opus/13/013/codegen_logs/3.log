+                seen[r, c] = True
+                q.append((int(r), int(c)))
+    for c in range(w):
+        for r in (0, h - 1):
+            if passable[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((int(r), int(c)))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            nr, nc = r + dr, c + dc
+            if in_bounds(passable.shape, nr, nc) and passable[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+    return seen
