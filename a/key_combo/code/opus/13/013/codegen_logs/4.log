+    for r in range(h):
+        for c in range(w):
+            color = int(crop[r, c])
+            if color in (BG, RED):
+                continue
+            distances = {
+                "top": r,
+                "right": w - 1 - c,
+                "bottom": h - 1 - r,
+                "left": c,
+            }
+            best = min(distances.values())
+            winners = [side for side, dist in distances.items() if dist == best]
+            if len(winners) == 1:
+                sides_hit.add(winners[0])
+            else:
+                tie_count += 1
+    return sides_hit, tie_count
