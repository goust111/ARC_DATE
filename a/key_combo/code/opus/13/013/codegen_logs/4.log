+        return False
+    coords = np.argwhere(arr != BG)
+    coord_set = {(top + int(rr), left + int(cc)) for rr, cc in coords}
+    for abs_r, abs_c in coord_set:
+        if grid[abs_r, abs_c] != BG:
+            return False
+        for nr in range(abs_r - 1, abs_r + 2):
+            for nc in range(abs_c - 1, abs_c + 2):
