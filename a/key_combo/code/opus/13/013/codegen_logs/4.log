+    vals = []
+    prev = 0
+    for cut in cuts + [total]:
+        vals.append(cut - prev)
+        prev = cut
+    return vals
+
+
+def _build_chain_parents(n_pieces: int) -> tuple[list[int], list[list[int]]]:
