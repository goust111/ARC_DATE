        remaining_steps = n_cells - len(path) - 1
        for nr, nc in _gen_neighbors(*path[-1], width):
            if (nr, nc) in path:
                continue
            if abs(nr - goal[0]) + abs(nc - goal[1]) > remaining_steps:
                continue
            dfs(path + [(nr, nc)])

    dfs([start])
    return paths


