+        outer, inner = counts.most_common(2)[0][0], counts.most_common(2)[1][0]
+        inner_coords = np.argwhere(patch == inner)
+        anchor_offset = int(np.floor(inner_coords[:, 1].mean()))
+        sprites.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "patch": patch,
+                "outer": int(outer),
+                "inner": int(inner),
+                "anchor_offset": anchor_offset,
+                "coords": coords,
