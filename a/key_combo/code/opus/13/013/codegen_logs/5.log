AREA_RANGE = (3, 13)              # component area in [3, 12]
MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w
IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes

# ── CFG: layout ─────────────────────────────────────────────────────
DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures
