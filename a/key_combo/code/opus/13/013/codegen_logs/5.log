  "src": "foreground pixels on a background-spaced logical lattice",
  "dst": "expanded 26x26 lattice with 2-pixel background spacers",
  "transform": "expand logical rows/columns to equal bands; paint each foreground pixel as a solid rectangle; join adjacent same-color pixels horizontally, and join vertical neighbors only when neither endpoint is part of a horizontal same-color run",
  "grid_shape": "fixed 26x26"
}
</annotation>
