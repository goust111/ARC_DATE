+
+    candidates: list[tuple[int, int, int, np.ndarray]] = []
+    for row_period in range(1, h):
+        for col_period in range(1, w):
+            tile = np.full((row_period, col_period), -1, dtype=int)
+            conflict = False
+            for r, c in np.argwhere(observed):
+                color = int(g[r, c])
