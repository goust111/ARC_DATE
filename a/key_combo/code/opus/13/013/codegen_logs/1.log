spec:
  grid: 27x27 (fixed)
  tile:
    size: 8x8 (fixed); grid = 3 full repeats + 3 extra in each axis
    colors: 2-8 non-black colors; black (0) never appears in tile
    last_row: all blue (1) [observed]
    last_col: all blue (1) [observed]
    no symmetry required [observed]
  output: perfect tiling of the 8x8 tile across the 27x27 grid
  holes:
    count: 4-5 connected regions of black (0) cells
    shape: mostly axis-aligned rectangles; occasionally L-shaped (two abutting rectangles)
    individual_dims: 2-9 rows x 2-8 cols, area 4-45
    total_black: 8-12% of grid (60-84 cells)
    separation: min Chebyshev gap >= 2 between regions
    may_touch_border: yes (some holes extend to grid edge)
  phase_coverage: every tile phase (r%8, c%8) must be visible (non-black) in at least one cell

generation_strategy:
  approach: output-first
  steps:
    1. Generate an 8x8 tile using 2-8 non-black colors (including blue/1); set last row and last col to all-1
    2. Tile it across a 27x27 grid to get the output
    3. Place 4-5 non-overlapping rectangular holes (2-6 rows x 2-6 cols each) at random positions with Chebyshev gap >= 2; optionally merge two adjacent rectangles into an L-shape
    4. Verify all 64 tile phases remain visible after masking; if not, shrink or shift a hole and retry
    5. Set hole cells to black (0) to produce the input
```
</generation_spec>
