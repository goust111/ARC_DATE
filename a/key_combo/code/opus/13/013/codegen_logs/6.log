+        remaining = cells - len(path)
+        if remaining == 0:
+            if cur == goal and _path_is_valid(height, width, path, left_row, right_row):
+                out.append(path)
+            return
+
+        dist = abs(cur[0] - goal[0]) + abs(cur[1] - goal[1])
