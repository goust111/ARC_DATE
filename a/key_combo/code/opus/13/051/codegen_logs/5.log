+            tab = (fr0 + fh // 2, fc0 - 1 if side == "left" else fc1 + 1)
+        else:
+            tab = (fr0 - 1 if side == "top" else fr1 + 1, fc0 + fw // 2)
+        expected = _outline_set(fr0, fc0, fh, fw)
+        expected.add(tab)
+        if cells == expected:
+            candidates.append(
+                {
+                    "color": int(comp["color"]),
+                    "side": side,
+                    "height": int(fh),
+                    "width": int(fw),
+                    "area": int(fh * fw),
+                }
