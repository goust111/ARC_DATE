+            continue
+
+        if sizes[0][0] < 10 or sizes[0][1] < 10:
+            continue
+        if sizes[0][0] > outer_cap or sizes[0][1] > outer_cap:
+            continue
+        if any(sizes[i][0] >= sizes[i - 1][0] - 2 or sizes[i][1] >= sizes[i - 1][1] - 2 for i in range(1, count)):
