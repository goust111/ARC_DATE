+
+def _adjust_for_side(value: int, side: str, axis: str) -> int:
+    if side in {"left", "right"} and axis == "h" and value % 2 == 0:
+        return value + 1
+    if side in {"top", "bottom"} and axis == "w" and value % 2 == 0:
+        return value + 1
+    return value
