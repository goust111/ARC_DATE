+import numpy as np
+
+
+BLACK = 0
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDE_TO_CORNER = {
+    "left": ("bottom", "right"),
+    "right": ("bottom", "left"),
+    "top": ("bottom", "right"),
+    "bottom": ("top", "right"),
