+    for cc in range(c0, c1 + 1):
+        pts.add((r0, cc))
+        pts.add((r1, cc))
+    for rr in range(r0, r1 + 1):
+        pts.add((rr, c0))
+        pts.add((rr, c1))
+    return pts
+
