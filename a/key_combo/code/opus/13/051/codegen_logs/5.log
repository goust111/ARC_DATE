+def _outline_set(r0: int, c0: int, h: int, w: int) -> set[tuple[int, int]]:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    pts: set[tuple[int, int]] = set()
+    for cc in range(c0, c1 + 1):
+        pts.add((r0, cc))
+        pts.add((r1, cc))
+    for rr in range(r0, r1 + 1):
+        pts.add((rr, c0))
+        pts.add((rr, c1))
+    return pts
+
