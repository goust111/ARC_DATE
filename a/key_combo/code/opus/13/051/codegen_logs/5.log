+BLACK = 0
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+SIDE_TO_CORNER = {
+    "left": ("bottom", "right"),
+    "right": ("bottom", "left"),
+    "top": ("bottom", "right"),
+    "bottom": ("top", "right"),
+}
+GEN_ATTEMPTS = 400
+GEN_CANVAS_RANGE = (20, 30)
