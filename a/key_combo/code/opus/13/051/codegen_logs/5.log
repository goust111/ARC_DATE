+def _decode_component(comp: dict) -> dict:
+    coords = comp["coords"]
+    cells = {tuple(map(int, rc)) for rc in coords}
+    r0, c0, r1, c1 = comp["bbox"]
+    candidates = []
+
+    specs = [
+        ("left", r0, c0 + 1, r1, c1),
+        ("right", r0, c0, r1, c1 - 1),
+        ("top", r0 + 1, c0, r1, c1),
+        ("bottom", r0, c0, r1 - 1, c1),
+    ]
+    for side, fr0, fc0, fr1, fc1 in specs:
+        fh = fr1 - fr0 + 1
+        fw = fc1 - fc0 + 1
+        if fh < 4 or fw < 4:
