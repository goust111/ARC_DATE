+    r0, c0, r1, c1 = comp["bbox"]
+    candidates = []
+
+    specs = [
+        ("left", r0, c0 + 1, r1, c1),
+        ("right", r0, c0, r1, c1 - 1),
+        ("top", r0 + 1, c0, r1, c1),
+        ("bottom", r0, c0, r1 - 1, c1),
