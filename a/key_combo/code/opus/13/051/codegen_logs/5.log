+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        count = random.choices(GEN_COUNT_VALUES, weights=GEN_COUNT_WEIGHTS, k=1)[0]
+        sides = _random_side_list(count)
