+    max_w = max(int(spec["patch"].shape[1]) for spec in specs)
+    min_dim = max(GEN_CANVAS_RANGE[0], max(max_h, max_w) + 1)
+
+    for _ in range(250):
+        h = random.randint(min_dim, GEN_CANVAS_RANGE[1])
+        w = random.randint(min_dim, GEN_CANVAS_RANGE[1])
