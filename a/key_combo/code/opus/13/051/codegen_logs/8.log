+def _simulate_rays(grid: np.ndarray, objects: list[dict]) -> tuple[np.ndarray, list[dict], list[list[tuple[int, int]]]]:
+    out = np.asarray(grid, dtype=int).copy()
+    owner = np.full(out.shape, -1, dtype=int)
+    events: list[dict] = []
+    paths: list[list[tuple[int, int]]] = []
+    h, w = out.shape
+    for obj in objects:
+        r, c = obj["center"]
+        dr, dc = obj["ray_dir"]
+        path: list[tuple[int, int]] = []
+        cur_r, cur_c = r, c
+        while True:
+            nr, nc = cur_r + dr, cur_c + dc
+            if not _in_bounds(out.shape, nr, nc) or nr in (0, h - 1) or nc in (0, w - 1):
+                events.append({"kind": "boundary", "object": obj["index"], "path": path[:]})
+                break
+            val = int(out[nr, nc])
+            if val == BLACK:
+                out[nr, nc] = GREY
+                owner[nr, nc] = obj["index"]
+                path.append((nr, nc))
+                cur_r, cur_c = nr, nc
+                continue
+            if val == GREY:
+                other = int(owner[nr, nc])
+                event = {
+                    "kind": "ray_hit",
+                    "object": obj["index"],
+                    "other": other,
+                    "blocked_cell": (nr, nc),
+                    "path": path[:],
+                }
+                if path:
+                    event["pair_point"] = path[-1]
+                events.append(event)
+                break
+            events.append(
+                {
+                    "kind": "obstacle",
+                    "object": obj["index"],
+                    "blocked_cell": (nr, nc),
+                    "color": val,
+                    "path": path[:],
+                }
+            )
+            break
+        paths.append(path)
+    return out, events, paths
