+    if any(event["kind"] == "obstacle" for event in events):
+        return False
+    if any(event["kind"] == "ray_hit" and "pair_point" not in event for event in events):
+        return False
+    if sum(len(path) for path in paths) < 4:
+        return False
+    for info in stamp_infos:
