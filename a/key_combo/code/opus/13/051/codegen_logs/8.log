+                if s in sprite:
+                    attachments.append((t, s))
+        if len(attachments) != 1:
+            continue
+        near, attach = attachments[0]
+        far = next(iter(trail - {near}))
+        d1 = (far[0] - near[0], far[1] - near[1])
+        d2 = (near[0] - attach[0], near[1] - attach[1])
+        if d1 != d2:
