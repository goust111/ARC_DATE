+    h, w = out.shape
+    for obj in objects:
+        r, c = obj["center"]
+        dr, dc = obj["ray_dir"]
+        path: list[tuple[int, int]] = []
+        cur_r, cur_c = r, c
+        while True:
+            nr, nc = cur_r + dr, cur_c + dc
+            if not _in_bounds(out.shape, nr, nc) or nr in (0, h - 1) or nc in (0, w - 1):
