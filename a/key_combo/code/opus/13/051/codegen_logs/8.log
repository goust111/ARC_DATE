+            rr = anchor_r + dr
+            cc = anchor_c + dc
+            if _in_bounds(out.shape, rr, cc) and int(out[rr, cc]) == BLACK:
+                out[rr, cc] = int(donor["color"])
+                painted.append((rr, cc))
+        stamp_infos.append(
+            {
+                "event": event,
+                "provider": provider["index"],
+                "donor": donor["index"],
+                "anchor": (anchor_r, anchor_c),
+                "painted": painted,
+                "bbox_shape": provider["bbox"],
+            }
+        )
+    return out, stamp_infos
