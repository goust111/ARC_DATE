+def _simulate_rays(grid: np.ndarray, objects: list[dict]) -> tuple[np.ndarray, list[dict], list[list[tuple[int, int]]]]:
+    out = np.asarray(grid, dtype=int).copy()
+    owner = np.full(out.shape, -1, dtype=int)
+    events: list[dict] = []
