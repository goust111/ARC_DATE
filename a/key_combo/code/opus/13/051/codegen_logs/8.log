+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+SPRITE_COLORS = (BLUE, RED, GREEN, YELLOW)
+CARDINALS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+GRID_ROWS = (18, 23)
+GRID_COLS = (18, 23)
+MAX_GENERATION_ATTEMPTS = 500
+MIN_RAY_LEN = 2
+MIN_STAMP_PIXELS = 2
+PRIMARY_GAP_ROWS = 4
+PRIMARY_GAP_COLS = 4
