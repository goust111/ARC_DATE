+    size = random.randint(3, min(6, (r1 - r0 + 1) * (c1 - c0 + 1)))
+    rel_cells = grow_connected_shape(r1 - r0 + 1, c1 - c0 + 1, size, anchor)
+    sprite_cells = [(r0 + rr, c0 + cc) for rr, cc in rel_cells]
+    for r, c in sprite_cells:
