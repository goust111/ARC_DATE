+            assert painted >= 2
+        else:
+            inactive += 1
+            for r, c in sprite + [indicator]:
+                assert out[r, c] == BLACK
+    assert active >= 2
+    assert inactive >= 1
+    assert axis_kinds == {"horizontal", "vertical"}
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
