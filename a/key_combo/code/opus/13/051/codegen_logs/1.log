+            segments.append({"kind": "v", "col": a[1], "r0": r0, "r1": r1})
+    return points, segments
+
+
+def add_horizontal_loop(
+    track: set[tuple[int, int]],
+    seg: dict[str, object],
+    h: int,
+    blockers: list[tuple[int, int]],
+    safe_rows: set[int],
+) -> tuple[bool, dict[str, object] | None]:
+    row = int(seg["row"])
+    c0 = int(seg["c0"])
+    c1 = int(seg["c1"])
