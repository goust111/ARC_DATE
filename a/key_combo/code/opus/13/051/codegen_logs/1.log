+
+def place_sprite_on_run(
+    grid: np.ndarray,
+    run: dict[str, object],
+    side: str,
+    indicator_side: str,
+    color: int,
+    indicator_color: int,
+) -> tuple[list[tuple[int, int]], tuple[int, int], str] | None:
+    h, w = grid.shape
+    if run["kind"] == "h":
+        row = int(run["row"])
+        span0 = int(run["c0"])
+        span1 = int(run["c1"])
+        box_h = random.randint(2, 3)
+        box_w = random.randint(2, 3)
+        if span1 - span0 + 1 < box_w:
+            return None
+        start_c = random.randint(span0, span1 - box_w + 1)
