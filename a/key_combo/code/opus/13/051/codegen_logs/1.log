+                grid,
+                run,
+                side,
+                side,
+                random.choice([BLUE, RED, GREEN]),
+                random.choice([YELLOW, GREY]),
+            )
+            if result is not None:
+                placed += 1
+                break
+        if placed >= count:
+            break
+    return placed
