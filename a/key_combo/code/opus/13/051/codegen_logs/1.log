+            r1 = row + box_h
+        c0 = start_c
+        c1 = start_c + box_w - 1
+    else:
+        col = int(run["col"])
+        span0 = int(run["r0"])
+        span1 = int(run["r1"])
+        box_h = random.randint(2, 3)
+        box_w = random.randint(2, 3)
+        if span1 - span0 + 1 < box_h:
+            return None
+        start_r = random.randint(span0, span1 - box_h + 1)
+        r0 = start_r
+        r1 = start_r + box_h - 1
+        if side == "left":
+            c0 = col - box_w
+            c1 = col - 1
+        else:
+            c0 = col + 1
+            c1 = col + box_w
