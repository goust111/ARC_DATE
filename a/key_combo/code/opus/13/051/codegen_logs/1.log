+    if np.any(grid[r0:r1 + 1, c0:c1 + 1] != BLACK):
+        return None
+    copy_box = sprite_copy_bbox(bbox, indicator_side)
+    if not rect_in_bounds(grid.shape, copy_box):
+        return None
+    cr0, cc0, cr1, cc1 = copy_box
+    if np.any(grid[cr0:cr1 + 1, cc0:cc1 + 1] != BLACK):
