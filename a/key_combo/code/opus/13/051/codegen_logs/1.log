+        return None
+
+    grid = np.zeros((h, w), dtype=int)
+    start = points[0]
+    end = points[-1]
+    for r, c in track:
+        grid[r, c] = TEAL
+    grid[start] = MAROON
+    grid[end] = MAROON
+    for r, c in blockers:
+        grid[r, c] = ORANGE
+
+    try:
+        path = solve_safe_path(grid)
+    except ValueError:
+        return None
+
+    if path != safe_cells:
+        return None
+    return grid, path, segments, decoy_segments, blockers
+
+
+def grow_connected_shape(h: int, w: int, size: int, must_include: tuple[int, int]) -> set[tuple[int, int]]:
+    cells = {must_include}
+    frontier = [must_include]
+    while len(cells) < size and frontier:
+        r, c = random.choice(frontier)
+        candidates = []
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
