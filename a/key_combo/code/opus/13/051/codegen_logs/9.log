+    return False
+
+
+def _fill_stage(grid: np.ndarray) -> tuple[np.ndarray, dict[int, np.ndarray], list[dict[str, object]], dict[int, set[tuple[int, int]]]]:
+    out = np.array(grid, dtype=int, copy=True)
+    seeds = _seed_positions(out)
