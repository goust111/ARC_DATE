15: def main(input_grid):
16:    """
17:    Tile the input into a 2x2 canvas and mark black diagonal neighbors of colored pixels teal.
18: 
19:    Input structure:
20:    - The input is a small black grid containing one to four non-teal colored pixels.
21:    - Pixel colors are preserved when the input is tiled.
22:    - Teal is reserved for newly added diagonal marks.
23: 
24:    Rule:
25:    - Copy the input into all four quadrants of a doubled output grid.
26:    - For every non-black, non-teal pixel in the doubled grid, inspect its four diagonal neighbors.
27:    - Color any black diagonal neighbor teal.
28: 
29:    Key insight:
30:    - The output combines replication with local decoration: after tiling, every colored seed grows
31:      only into currently black diagonal cells.
32:    """
33:    # Replicate input grid 4 times to initialize output grid
34:    output_grid = np.zeros((2*input_grid.shape[0], 2* input_grid.shape[1]),dtype=int)
35:    for i in range(2):
36:       for j in range(2):
37:          paste(output_grid, input_grid, i*input_grid.shape[0], j*input_grid.shape[1], transparent=Color.BLACK, clip=True)
38:   
39:    # Create diagonal directions
40:    diagonal_dx_dy = [(1,1),(-1,1),(1,-1),(-1,-1)]
41: 
42:    # Color diagonal pixels 
43:    for c in range(output_grid.shape[1]):
44:       for r in range(output_grid.shape[0]):
45:          if output_grid[r,c] != Color.BLACK and output_grid[r,c] != Color.TEAL:
46:             for dr,dc in diagonal_dx_dy:
47:                # Color diagonal pixel teal if it is black
48:                if r+dr >= 0 and r+dr < output_grid.shape[0] and c+dc >= 0 and c+dc < output_grid.shape[1] and output_grid[r+dr,c+dc] == Color.BLACK:
49:                   output_grid[r+dr,c+dc] = Color.TEAL
50:   
51:    return output_grid
