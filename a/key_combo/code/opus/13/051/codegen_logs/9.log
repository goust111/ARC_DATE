+    return cavities
+
+
+def _supports_cavity(boundary: set[tuple[int, int]], component: set[tuple[int, int]]) -> bool:
+    if boundary & component:
+        return True
+    for r, c in boundary:
+        for dr, dc in ORTHO_DIRS:
+            if (r + dr, c + dc) in component:
