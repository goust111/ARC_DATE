427: def _gen_attempt() -> np.ndarray | None:
428:     n, color = _gen_choose_canvas_and_color()
429:     sprites = _gen_build_sprites(color)
430:     if sprites is None:
431:         return None
432: 
433:     symmetric, asymmetric = sprites
434:     canvas = _gen_place_sprites(n, symmetric + [asymmetric])
435:     if canvas is None:
436:         return None
437:     if not _gen_oracle_accepts(canvas, asymmetric):
438:         return None
439:     return canvas
