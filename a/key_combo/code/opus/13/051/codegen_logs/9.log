402: def _gen_place_sprites(n: int, sprites: list[np.ndarray]) -> np.ndarray | None:
403:     items = list(sprites)
404:     random.shuffle(items)
405: 
406:     canvas = np.full((n, n), BACKGROUND_COLOR, dtype=int)
407:     placed: list[tuple[int, int, int, int]] = []
408: 
409:     for sprite in items:
410:         positions = _gen_valid_positions(n, sprite, placed)
411:         if not positions:
412:             return None
413:         r, c = random.choice(positions)
414:         paste(canvas, sprite, r, c, transparent=BACKGROUND_COLOR)
415:         placed.append((r, c, r + sprite.shape[0] - 1, c + sprite.shape[1] - 1))
416:     return canvas
