34: def main(grid: np.ndarray) -> np.ndarray:
35:     """
36:     Move every red object horizontally until it is flush with the side of its enclosing blue or teal region.
37: 
38:     Input structure
39:     - The grid contains only blue, red, and teal pixels.
40:     - The red pixels form one or more 4-connected objects.
41:     - Each red object is embedded in exactly one adjacent non-red carrier color.
42: 
43:     Rule
44:     - Clear each red object back to its carrier color to recover the blue and teal regions.
45:     - A red object carried by blue moves right until its bounding box touches the right edge of that blue region.
46:     - A red object carried by teal moves left until its bounding box touches the left edge of that teal region.
47:     - Preserve the object's shape and rows, and apply all object moves simultaneously.
48: 
49:     Key insight
50:     - The red objects are sliders inside colored horizontal lanes; the carrier color encodes the slide direction.
51:     """
52:     g = np.asarray(grid, dtype=int)
53:     assert g.ndim == 2, "input must be a 2D grid"
54:     assert set(map(int, np.unique(g))) == {Color.BLUE, Color.RED, Color.TEAL}, "expected blue, red, and teal only"
55: 
56:     red_objects = components_mask(g == Color.RED, connectivity=4)
57:     assert red_objects, "expected at least one red object"
58: 
59:     base = g.copy()
60:     objects: list[tuple[np.ndarray, int]] = []
61:     for coords in red_objects:
62:         carrier = _carrier_color(g, coords)
63:         base[coords[:, 0], coords[:, 1]] = carrier
64:         objects.append((coords, carrier))
65: 
66:     out = base.copy()
67:     occupied = np.zeros(g.shape, dtype=bool)
68:     H, W = g.shape
69: 
70:     for coords, carrier in objects:
71:         obj_box = bbox_coords(coords)
72:         region = _containing_region(base, coords, carrier)
73:         region_box = bbox_coords(region)
74:         obj_c0, obj_c1 = obj_box[1], obj_box[3]
75:         reg_c0, reg_c1 = region_box[1], region_box[3]
76: 
77:         obj_w = int(obj_c1 - obj_c0 + 1)
78:         if carrier == Color.BLUE:
79:             dst_c0 = int(reg_c1 - obj_w + 1)
80:         else:
81:             assert carrier == Color.TEAL
82:             dst_c0 = int(reg_c0)
83: 
84:         moved = coords.copy()
85:         moved[:, 1] += dst_c0 - int(obj_c0)
86: 
87:         assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H) & (0 <= moved[:, 1]) & (moved[:, 1] < W))
88:         assert np.all(base[moved[:, 0], moved[:, 1]] == carrier), "destination must stay inside the carrier region"
89:         assert not np.any(occupied[moved[:, 0], moved[:, 1]]), "moved red objects must not overlap"
90: 
91:         occupied[moved[:, 0], moved[:, 1]] = True
92:         out[moved[:, 0], moved[:, 1]] = Color.RED
93: 
94:     return out
