+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        try:
+            inp, expected = _build_sample()
+        except AssertionError:
+            continue
+        if _validate_generated(inp, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid sample")

