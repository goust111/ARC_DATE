+    repaired = np.asarray(grid, dtype=int)
+    rails = _find_rails(repaired)
+    left_col = int(rails[0][0])
+    right_col = int(rails[1][0])
+    top = int(rails[0][1])
+    bottom = int(rails[0][2])
+
