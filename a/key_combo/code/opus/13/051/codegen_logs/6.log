import random
from typing import Iterable

import numpy as np


BG = 0
BLUE = 1
RED = 2
GREEN = 3
GREY = 5
MASK = 6
TEAL = 8

PALETTE = (BLUE, RED, GREEN)
GRID_SIZES = (13, 15, 17)
SHAPES = (
    ((0, 0),),
    ((0, 0), (1, 0)),
