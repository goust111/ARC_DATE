+            (int(r), int(c))
+            for r, c in np.argwhere(full != BG)
+            if int(c) > mid
+        ]
+    color_extras = [
+        (r, c)
+        for r, c in side_foreground
+        if full[r, c] in PALETTE and (r, c) not in mandatory
