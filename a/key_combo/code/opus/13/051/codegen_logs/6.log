+    return True
+
+
+def _mark_blocked(blocked: np.ndarray, coords: Iterable[tuple[int, int]]) -> None:
+    width = blocked.shape[1]
+    occupied = np.zeros_like(blocked, dtype=bool)
+    for r, c in coords:
