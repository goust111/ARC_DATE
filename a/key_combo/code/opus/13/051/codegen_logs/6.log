+    height, width = g.shape
+    used = False
+    for r in range(height):
+        for c in range((width + 1) // 2):
+            mc = _mirror_col(width, c)
+            a = int(g[r, c])
+            b = int(g[r, mc])
+            a_mask = a == int(candidate)
+            b_mask = b == int(candidate)
+            if c == mc:
+                if a_mask:
+                    return False
+                continue
+            if a_mask and b_mask:
+                return False
+            if a_mask or b_mask:
