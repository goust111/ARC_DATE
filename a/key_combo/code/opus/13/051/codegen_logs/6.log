+    assert len(candidates) == 1, f"expected one mask color, got {candidates}"
+    return int(candidates[0])
+
+
+def _repair_vertical_symmetry(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
