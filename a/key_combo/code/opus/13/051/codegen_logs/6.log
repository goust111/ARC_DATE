GEN_BLOB_EXTRA_AREA_FLOOR = 3
GEN_FORBIDDEN_CORNER = 2
GEN_MIN_MASKED_COLORS, GEN_ORBIT_MASK_CAP_DIVISOR = 2, 2

# Generation retries.
