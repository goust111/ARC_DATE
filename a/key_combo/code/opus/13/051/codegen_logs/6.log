+    return runs
+
+
+def _find_rails(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    runs = [
+        (c, r0, r1)
+        for c, r0, r1 in _column_runs_of_color(grid, GREY)
+        if r1 - r0 + 1 >= 4
+    ]
