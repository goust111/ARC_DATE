+        repaired = _repair_vertical_symmetry(inp)
+        if not np.array_equal(repaired, np.fliplr(repaired)):
+            return False
+
+        raw_crop = _try_crop_without_repair(inp)
+        if raw_crop is not None and np.array_equal(raw_crop, expected):
