+    boundary_mask[top : bottom + 1, right_col] = True
+    boundary_mask[crop_r0, left_col] = True
+    boundary_mask[crop_r1, left_col] = True
+    boundary_mask[crop_r0, right_col] = True
+    boundary_mask[crop_r1, right_col] = True
