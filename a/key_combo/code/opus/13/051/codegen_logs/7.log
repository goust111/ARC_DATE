GEN_SINGLE_COMP_MIN, GEN_SINGLE_COMP_MAX = 4, 7
GEN_MATCH_COUNT_MIN, GEN_MATCH_COUNT_MAX = 3, 6
GEN_PAIR_PROB = 0.45

# Color proportions and retry policy.
GEN_LATTICE_FRAC_MIN, GEN_LATTICE_FRAC_MAX = 0.42, 0.66
