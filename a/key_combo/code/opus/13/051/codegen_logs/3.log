0150: def _make_sprite(block_size: int, foreground: int, blank: int) -> np.ndarray | None:
0151:     area = block_size * block_size
0152:     min_num, min_den = SPRITE_FG_MIN_RATIO
0153:     max_num, max_den = SPRITE_FG_MAX_RATIO
0154:     fg_min = math.ceil(area * min_num / min_den)
0155:     fg_max = math.floor(area * max_num / max_den)
0156:     if fg_min > fg_max:
0157:         fg_min = fg_max = round(area * min_num / min_den)
0158:     fg_count = random.randint(fg_min, fg_max)
0159:     blank_count = area - fg_count
0160: 
0161:     for _ in range(SPRITE_ATTEMPTS):
0162:         mask = np.ones((block_size, block_size), dtype=bool)
0163:         if block_size == TINY_BLOCK_SIZE:
0164:             blanks = [random.randrange(area)]
0165:         else:
0166:             cols = list(range(block_size))
0167:             random.shuffle(cols)
0168:             blanks = [r * block_size + cols[r] for r in range(block_size)]
0169:             extra = blank_count - block_size
0170:             if extra > 0:
0171:                 pool = [i for i in range(area) if i not in blanks]
0172:                 blanks.extend(random.sample(pool, extra))
0173: 
0174:         for idx in blanks:
0175:             mask[idx // block_size, idx % block_size] = False
0176: 
0177:         if block_size > TINY_BLOCK_SIZE:
