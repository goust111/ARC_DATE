0190: def _neighbors4(r: int, c: int, height: int, width: int):
0191:     for dr, dc in NEIGHBOR_OFFSETS_4:
0192:         nr, nc = r + dr, c + dc
0193:         if 0 <= nr < height and 0 <= nc < width:
0194:             yield nr, nc
