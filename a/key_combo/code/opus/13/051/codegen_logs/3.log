0018: def _regular_intervals(separators: list[int], length: int) -> list[tuple[int, int]]:
0019:     assert separators, "expected at least one separator line"
0020:     bounds = [-1, *separators, int(length)]
0021:     intervals = [(bounds[i] + 1, bounds[i + 1]) for i in range(len(bounds) - 1)]
0022:     sizes = [end - start for start, end in intervals]
0023:     assert min(sizes) > 0, "separators must leave non-empty blocks"
0024:     assert len(set(sizes)) == 1, "all encoded blocks must have the same size"
0025:     return intervals
0026: 
0027: 
0028: def _find_sprite(
0029:     g: np.ndarray,
0030:     row_intervals: list[tuple[int, int]],
0031:     col_intervals: list[tuple[int, int]],
0032:     payload_colors: list[int],
0033: ) -> np.ndarray:
0034:     payload = set(payload_colors)
0035:     sprites = []
0036: 
0037:     for r0, r1 in row_intervals:
0038:         for c0, c1 in col_intervals:
0039:             block = g[r0:r1, c0:c1]
0040:             block_colors = set(colors_present(block, exclude={ERASED}))
0041:             assert SEPARATOR not in block_colors, "block interiors cannot contain separator color"
0042:             if ERASED not in set(map(int, block.flat)) and block_colors == payload:
0043:                 sprites.append(block.copy())
0044: 
0045:     assert sprites, "expected at least one fully visible sprite block"
0046:     sprite = sprites[0]
