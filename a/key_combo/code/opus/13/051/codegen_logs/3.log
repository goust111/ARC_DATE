    arr=np.array(sorted(coords),dtype=int)
    arr-=arr.min(axis=0)
    return tuple(map(tuple,arr.tolist()))

def to_mask(coords):
    arr=np.array(list(coords),dtype=int)
    arr-=arr.min(axis=0)
    h,w=arr.max(axis=0)+1
    m=np.zeros((h,w),dtype=bool)
    m[arr[:,0],arr[:,1]]=True
    return m

def from_mask(mask):
    return norm(set(map(tuple,np.argwhere(mask))))

def variants(base):
    m=to_mask(base)
    outs=set()
    cur=m
    for k in range(4):
        r=np.rot90(m,k)
        outs.add(from_mask(r))
        outs.add(from_mask(np.fliplr(r)))
    return [set(v) for v in outs]

def pairs(coords):
    arr=sorted(coords)
    out=[]
    for a,b in combinations(arr,2):
        dr=b[0]-a[0]; dc=b[1]-a[1]
        if dr>0 and dr==dc:
            out.append((dr,a,b))
    return out

def best_pair(coords):
    ps=pairs(coords)
    return max(ps,key=lambda x:(x[0],-x[1][0],-x[1][1],-x[2][0],-x[2][1])) if ps else None

def draw(coords,pair):
    if pair is None: return set(coords)
    dr,a,b=pair
    r1,c1=a
    return set(coords)|{(r1+i,c1+i) for i in range(dr+1)}

def flip(coords):
    arr=np.array(list(coords),dtype=int)
    r0,c0=arr.min(axis=0); r1,c1=arr.max(axis=0)
    return {(r0+r1-r,c) for r,c in coords}

def trig_ok(coords):
    bp=best_pair(coords)
    if bp is None: return False
    dr,a,b=bp
    mids={(a[0]+i,a[1]+i) for i in range(1,dr)}
    if mids & set(coords): return False
    post=flip(draw(coords,bp))
    if post==set(coords): return False
    if post==draw(coords,bp): return False
    if post==flip(set(coords)): return False
    return True

def non_ok(coords):
    return best_pair(coords) is None and flip(set(coords))"'!=set(coords)

def anti(coords):
    arr=sorted(coords)
    for a,b in combinations(arr,2):
        dr=b[0]-a[0]; dc=b[1]-a[1]
        if dr>0 and dr==-dc:
            return True
    return False

for name,bases,check in [('"'trigger',TRIGGER_BASES,trig_ok),('non',NON_BASES,non_ok)]:
    total=0
    anti_count=0
    for base in bases:
        good=[]
