0008: def _carrier_color(g: np.ndarray, coords: np.ndarray) -> int:
0009:     adjacent = set()
0010:     for r_raw, c_raw in coords:
0011:         r = int(r_raw)
0012:         c = int(c_raw)
0013:         for nr, nc in neighbors4(r, c):
0014:             if in_bounds(g.shape, nr, nc) and int(g[nr, nc]) != Color.RED:
0015:                 adjacent.add(int(g[nr, nc]))
0016: 
0017:     assert len(adjacent) == 1, "each red object must touch exactly one carrier color"
0018:     carrier = next(iter(adjacent))
0019:     assert carrier in {Color.BLUE, Color.TEAL}, "carrier color must be blue or teal"
0020:     return carrier
0021: 
0022: 
0023: def _containing_region(base: np.ndarray, coords: np.ndarray, color: int) -> np.ndarray:
0024:     coord_set = {(int(r), int(c)) for r, c in coords}
0025:     hits = []
0026:     for region in components_mask(base == int(color), connectivity=4):
0027:         if any((int(r), int(c)) in coord_set for r, c in region):
0028:             hits.append(region)
0029: 
0030:     assert len(hits) == 1, "red object must belong to exactly one carrier region"
0031:     return hits[0]
