0197: def _grow_blob(allowed: np.ndarray, size: int) -> set[tuple[int, int]] | None:
0198:     comps = [
0199:         [tuple(map(int, rc)) for rc in coords]
0200:         for coords in components_mask(allowed, connectivity=GREY_CONNECTIVITY)
0201:         if len(coords) >= size
0202:     ]
0203:     if not comps:
0204:         return None
0205: 
0206:     comp = random.choice(comps)
0207:     comp_set = set(comp)
0208:     seed = random.choice(comp)
0209:     blob = {seed}
0210:     frontier = {nb for nb in _neighbors4(*seed, *allowed.shape) if nb in comp_set}
0211: 
0212:     while len(blob) < size:
0213:         if not frontier:
0214:             return None
0215:         cell = random.choice(tuple(frontier))
0216:         frontier.remove(cell)
0217:         blob.add(cell)
0218:         for nb in _neighbors4(*cell, *allowed.shape):
0219:             if nb in comp_set and nb not in blob:
0220:                 frontier.add(nb)
0221: 
0222:     return blob
0223: 
