+def _cavity_components(grid: np.ndarray, bar_r: int) -> list[np.ndarray]:
+    cavity_mask = grid == BG
+    cavity_mask[0, :] = False
+    cavity_mask[-1, :] = False
+    cavity_mask[:, 0] = False
+    cavity_mask[:, -1] = False
+    cavity_mask[bar_r:, :] = False
+    return components_mask(cavity_mask, connectivity=4)
