+        out[nr, c] = MOVING
+
+    for r, c in moved:
+        if r + 1 < h and int(out[r + 1, c]) == BAR:
+            for dc in (-1, 1):
+                rr, cc = r, c
+                while 0 <= rr < h and 0 <= cc < w:
+                    splash[rr, cc] = True
+                    out[rr, cc] = MOVING
+                    rr -= 1
+                    cc += dc
+
