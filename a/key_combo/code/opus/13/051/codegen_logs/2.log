+def _seed_positions(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    seeds = []
+    for c in range(grid.shape[1]):
+        value = int(grid[0, c])
+        if value in SEED_COLORS:
+            seeds.append((0, c, value))
+    return seeds
