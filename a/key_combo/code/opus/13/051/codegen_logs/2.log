+
+def _touches_component(cavity: np.ndarray, comp_mask: np.ndarray) -> bool:
+    h, w = comp_mask.shape
+    for r_raw, c_raw in cavity:
+        r = int(r_raw)
+        c = int(c_raw)
+        for nr, nc in neighbors4(r, c):
