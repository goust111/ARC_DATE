  "dst": "colored template sprites d in the upper-left legend",
  "match_cond": "canonical_shape(s) == canonical_shape(d) under rotations/reflections",
  "transform": "s.color = d.color; preserve bg, divider, and legend pixels",
  "symbol_instructions": "L-shaped divider isolates the upper-left shape-to-color legend"
}
</annotation>
<generation_spec>
