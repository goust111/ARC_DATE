+    meta = {
+        "rows": rows,
+        "cols": cols,
+        "heights": heights,
+        "widths": widths,
+        "rects": rects,
+        "wall_rows": wall_rows,
+        "wall_cols": wall_cols,
+        "seed_positions": seed_positions,
+    }
