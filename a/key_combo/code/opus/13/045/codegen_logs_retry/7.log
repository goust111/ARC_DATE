+
+def _choose_seed_pair(raw_areas: dict[int, int], graph: dict[int, set[int]]) -> tuple[int, int, dict] | None:
+    ids = sorted(graph)
+    candidates = []
+    for red_seed in ids:
+        for blue_seed in ids:
