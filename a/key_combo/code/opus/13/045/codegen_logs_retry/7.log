+            np.any(coords[:, 0] == 0)
+            or np.any(coords[:, 0] == h - 1)
+            or np.any(coords[:, 1] == 0)
+            or np.any(coords[:, 1] == w - 1)
+        )
+        if touches_edge:
+            continue
+
+        region_id = len(regions)
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        region_of[rows, cols] = region_id
+
+        values = g[rows, cols]
+        black_mask = values == BLACK
+        black_coords = coords[black_mask]
+        area = int(black_mask.sum())
+        assert area > 0
+
