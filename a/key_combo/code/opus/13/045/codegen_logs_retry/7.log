+
+def _cell_graph(rows: int, cols: int) -> dict[int, set[int]]:
+    graph = {rid: set() for rid in range(rows * cols)}
+    for r in range(rows):
+        for c in range(cols):
+            rid = r * cols + c
+            if r > 0:
+                graph[rid].add((r - 1) * cols + c)
+            if r + 1 < rows:
+                graph[rid].add((r + 1) * cols + c)
+            if c > 0:
+                graph[rid].add(r * cols + (c - 1))
+            if c + 1 < cols:
+                graph[rid].add(r * cols + (c + 1))
+    return graph
+
