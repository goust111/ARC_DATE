+
+
+def _expected_from_abstract(grid: np.ndarray, rects: dict[int, tuple[int, int, int, int]], plan: dict, barrier: int) -> np.ndarray:
+    out = grid.copy()
+    for rid, (r0, c0, r1, c1) in rects.items():
