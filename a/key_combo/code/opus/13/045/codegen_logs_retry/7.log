+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components of a boolean mask as (N,2) coord arrays."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bfs_dist(graph: dict[int, set[int]], start: int) -> dict[int, int]:
+    dist = {start: 0}
+    q = deque([start])
+    while q:
+        cur = q.popleft()
+        for nxt in graph[cur]:
+            if nxt not in dist:
+                dist[nxt] = dist[cur] + 1
+                q.append(nxt)
+    return dist
+
+
+def _analyze_grid(grid: np.ndarray) -> dict:
+    """Parse closed regions, black-pixel areas, seed locations, and orange-boundary adjacency."""
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
