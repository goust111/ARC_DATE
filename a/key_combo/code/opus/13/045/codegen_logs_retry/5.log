+
+    labels, n = label_mask(grid == ORANGE, connectivity=4)
+    if n != 2:
+        return None
+    return grid, polylines
+
+
+def ring_template(size: int) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    obj = set()
+    hole = set()
+    for r in range(size):
+        for c in range(size):
+            if r in (0, size - 1) or c in (0, size - 1):
+                obj.add((r, c))
+            else:
+                hole.add((r, c))
+    boundary = set()
+    for r, c in obj:
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in hole:
+                boundary.add((r, c))
+                break
