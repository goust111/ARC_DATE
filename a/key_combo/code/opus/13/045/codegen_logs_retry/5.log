+
+def can_place_object(grid: np.ndarray, used: list[tuple[int, int, int]], r0: int, c0: int, size: int) -> bool:
+    h, w = grid.shape
+    if r0 < 1 or c0 < 1 or r0 + size >= h - 1 or c0 + size >= w - 1:
+        return False
+    obj_cells, hole_cells = ring_template(size)
