+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    dirs = STRUCT4
+    if connectivity == 8:
+        dirs = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
+    cur = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            cur += 1
+            q = deque([(r, c)])
+            labels[r, c] = cur
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in dirs:
