+
+
+PROFILE_INTENTS = {
+    "A": ("red_top", "blue_bottom", "black_middle"),
+    "B": ("grey_both", "red_mixed", "black_middle"),
+    "C": ("grey_both", "red_top", "blue_bottom"),
+}
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
