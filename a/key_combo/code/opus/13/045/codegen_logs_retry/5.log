+        kinds = {next(seg["kind"] for seg in segs if seg["id"] == cid) for cid in info["adjacent_ids"]}
+        if info["intent"] == "red_top" and kinds != {"top"}:
+            return False
+        if info["intent"] == "blue_bottom" and kinds != {"bottom"}:
