+            if not candidates:
+                ok = False
+                break
+            r0, c0, height, width, ids = candidates[0]
+            hole_cells = paint_object(work, r0, c0, height, width, color)
+            used.append((r0, c0, height, width))
+            placements.append(
+                {
+                    "intent": intent,
+                    "hole_cells": hole_cells,
+                    "adjacent_ids": set(ids),
+                }
+            )
+        if not ok:
+            continue
+        if verify_semantics(work, placements, profile):
+            return work
+    raise RuntimeError("failed to generate a valid input")

