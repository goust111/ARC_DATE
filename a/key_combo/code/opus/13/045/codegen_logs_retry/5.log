+        for dc in (-1, 0, 1):
+            r_src0 = max(0, -dr)
+            r_src1 = min(h, h - dr)
+            c_src0 = max(0, -dc)
+            c_src1 = min(w, w - dc)
+            r_dst0 = max(0, dr)
+            r_dst1 = min(h, h + dr)
+            c_dst0 = max(0, dc)
+            c_dst1 = min(w, w + dc)
+            out[r_dst0:r_dst1, c_dst0:c_dst1] |= mask[r_src0:r_src1, c_src0:c_src1]
+    return out
+
