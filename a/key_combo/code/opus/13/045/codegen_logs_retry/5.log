+def expected_fill_for_intent(intent: str) -> int:
+    if intent in ("red_top", "red_mixed"):
+        return RED
+    if intent == "blue_bottom":
+        return BLUE
+    if intent == "grey_both":
+        return GREY
+    return BLACK
