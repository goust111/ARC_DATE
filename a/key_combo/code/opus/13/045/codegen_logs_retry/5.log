+        if info["intent"] == "grey_both" and kinds != {"both"}:
+            return False
+        if info["intent"] == "black_middle" and kinds != {"middle"}:
+            return False
+        if info["intent"] == "red_mixed" and not ("top" in kinds and "bottom" in kinds and "both" not in kinds):
