+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+STRUCT4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    for dr, dc in STRUCT4:
+        yield r + dr, c + dc
+
+
+def label_mask(mask: np.ndarray, connectivity: int = 4) -> tuple[np.ndarray, int]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    dirs = STRUCT4
+    if connectivity == 8:
+        dirs = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
+    cur = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            cur += 1
+            q = deque([(r, c)])
+            labels[r, c] = cur
+            while q:
+                rr, cc = q.popleft()
+                for dr, dc in dirs:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = cur
+                        q.append((nr, nc))
+    return labels, cur
+
+
+def dilate8(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    out = np.zeros_like(mask, dtype=bool)
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            r_src0 = max(0, -dr)
+            r_src1 = min(h, h - dr)
+            c_src0 = max(0, -dc)
+            c_src1 = min(w, w - dc)
+            r_dst0 = max(0, dr)
+            r_dst1 = min(h, h + dr)
+            c_dst0 = max(0, dc)
+            c_dst1 = min(w, w + dc)
+            out[r_dst0:r_dst1, c_dst0:c_dst1] |= mask[r_src0:r_src1, c_src0:c_src1]
+    return out
+
