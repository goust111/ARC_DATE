+
+def ring_template(size: int) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    obj = set()
+    hole = set()
+    for r in range(size):
+        for c in range(size):
+            if r in (0, size - 1) or c in (0, size - 1):
+                obj.add((r, c))
+            else:
+                hole.add((r, c))
+    boundary = set()
+    for r, c in obj:
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in hole:
+                boundary.add((r, c))
+                break
+    return obj, boundary
+
+
+def object_adjacency_types(
+    channel_labels: np.ndarray,
+    seg_by_id: dict[int, dict],
+    r0: int,
+    c0: int,
+    size: int,
+) -> tuple[set[str], set[int]]:
+    obj_cells, boundary = ring_template(size)
+    ids = set()
+    for rr, cc in boundary:
+        gr = r0 + rr
+        gc = c0 + cc
+        for nr, nc in neighbors4(gr, gc):
+            if in_bounds(channel_labels.shape, nr, nc) and channel_labels[nr, nc] > 0:
+                ids.add(int(channel_labels[nr, nc]))
+    return {seg_by_id[cid]["kind"] for cid in ids}, ids
+
+
+def can_place_object(grid: np.ndarray, used: list[tuple[int, int, int]], r0: int, c0: int, size: int) -> bool:
+    h, w = grid.shape
+    if r0 < 1 or c0 < 1 or r0 + size >= h - 1 or c0 + size >= w - 1:
+        return False
+    obj_cells, hole_cells = ring_template(size)
+    for rr, cc in obj_cells | hole_cells:
+        if grid[r0 + rr, c0 + cc] != BLACK:
+            return False
+    for ur, uc, us in used:
+        if not (r0 + size + 1 <= ur or ur + us + 1 <= r0 or c0 + size + 1 <= uc or uc + us + 1 <= c0):
+            return False
+    return True
+
+
+def find_candidates(
+    grid: np.ndarray,
+    channel_labels: np.ndarray,
+    segs: list[dict],
+    intent: str,
+    used: list[tuple[int, int, int]],
+) -> list[tuple[int, int, int, set[int]]]:
+    seg_by_id = {seg["id"]: seg for seg in segs}
+    out = []
+    for size in (3, 5, 7):
+        for r0 in range(grid.shape[0] - size + 1):
+            for c0 in range(grid.shape[1] - size + 1):
+                if not can_place_object(grid, used, r0, c0, size):
+                    continue
+                kinds, ids = object_adjacency_types(channel_labels, seg_by_id, r0, c0, size)
+                if not ids:
+                    continue
+                ok = False
+                if intent == "red_top":
+                    ok = kinds == {"top"}
+                elif intent == "blue_bottom":
+                    ok = kinds == {"bottom"}
+                elif intent == "grey_both":
+                    ok = kinds == {"both"}
+                elif intent == "black_middle":
