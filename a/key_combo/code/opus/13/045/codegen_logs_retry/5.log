+        add_hline(left_cells, conn_row, 1, anchor[1])
+    for name, cells in right_pieces.items():
+        conn_row = max(1, min(h - 2, right_rows[name]))
+        anchor = min(cells, key=lambda p: (abs(p[0] - conn_row), -p[1], p[0]))
