+        hole_global = {(r0 + rr, c0 + cc) for rr, cc in pts}
+        boundary = set()
+        for rr, cc in hole_global:
+            for nr, nc in neighbors4(rr, cc):
+                if (nr, nc) in obj["cells"]:
+                    boundary.add((nr, nc))
+        holes.append({"cells": hole_global, "boundary": boundary})
+    return holes
