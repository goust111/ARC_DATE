+            bid=bid,
+            color=color,
+            pos=pos,
+            pattern=(direction,),
+            phase=0,
+            path=[pos],
+            enter_dirs=[direction],
+        )
+        beams[bid] = beam
+        paint_cell(bid, pos, direction)
+
+    def find_partner(bid: int) -> int | None:
+        beam = beams[bid]
+        if not beam.active:
+            return None
+        direction = beam.next_dir()
+        partner: int | None = None
+        for other_id, other in beams.items():
+            if other_id == bid or not other.active:
