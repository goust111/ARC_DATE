+            else:
+                resolve_cross_collision(a, b)
+            continue
+
+        for bid in sorted(prop):
+            nxt, direction = prop[bid]
+            assert cell_owner.get(nxt) is None
+            beam = beams[bid]
+            beam.path.append(nxt)
+            beam.enter_dirs.append(direction)
+            beam.pos = nxt
+            paint_cell(bid, nxt, direction)
