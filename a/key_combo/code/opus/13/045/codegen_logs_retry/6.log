+        beam.enter_dirs = beam.enter_dirs[:keep_len]
+        beam.pos = beam.path[-1]
+        beam.active = True
+
+    def spawn_beam(color: int, pos: tuple[int, int], direction: tuple[int, int]) -> None:
+        nonlocal next_bid
+        bid = next_bid
+        next_bid += 1
