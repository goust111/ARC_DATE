+
+def _is_cardinal(d: tuple[int, int]) -> bool:
+    return abs(d[0]) + abs(d[1]) == 1
+
+
+def _is_diagonal(d: tuple[int, int]) -> bool:
+    return abs(d[0]) + abs(d[1]) == 2
