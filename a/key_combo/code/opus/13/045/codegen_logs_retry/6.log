+FRAME_SIZE = 4
+FRAME_OFFSET = 1
+FRAME_COLOR = GREEN
+SOURCE_COLORS = (ORANGE, MAROON)
+INNER_COLORS = (BLUE, RED, YELLOW, PINK, TEAL)
