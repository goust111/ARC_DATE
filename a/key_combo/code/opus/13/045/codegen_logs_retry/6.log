+
+def _normalize_dir(dr: int, dc: int) -> tuple[int, int]:
+    if dr == 0 and dc == 0:
+        return (0, 0)
+    if dr != 0:
+        dr = 1 if dr > 0 else -1
+    if dc != 0:
+        dc = 1 if dc > 0 else -1
+    return dr, dc
