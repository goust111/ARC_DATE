+
+def _slot_origins() -> list[int]:
+    return [i * STRIDE for i in range(SLOT_COUNT)]
+
+
+def _slot_origin(br: int, bc: int) -> tuple[int, int]:
+    return br * STRIDE, bc * STRIDE
