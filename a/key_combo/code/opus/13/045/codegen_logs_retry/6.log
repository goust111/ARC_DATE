+                {"slot": (0, 1), "gap_choices": [[S_RIGHT]], "extra_choices": [None]},
+                {"slot": (0, 3), "gap_choices": [[S_LEFT], [S_RIGHT]], "extra_choices": [None, [W_TOP], [W_BOTTOM]]},
