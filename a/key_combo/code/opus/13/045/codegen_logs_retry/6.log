+from __future__ import annotations
+
+from dataclasses import dataclass
+import random
+from typing import Any
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+SLOT_COUNT = 4
+SLOT_SIZE = 5
+STRIDE = SLOT_SIZE + 1
