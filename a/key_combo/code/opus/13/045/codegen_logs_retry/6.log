+def _dir_diff(a: tuple[int, int], b: tuple[int, int]) -> int:
+    ia = DIR_TO_INDEX[a]
+    ib = DIR_TO_INDEX[b]
+    d = (ia - ib) % 8
+    return min(d, 8 - d)
