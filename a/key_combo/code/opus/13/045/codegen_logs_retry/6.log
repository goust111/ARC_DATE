+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, dict[str, Any]]:
+    info = _analyze(grid)
+    out = info["ray_grid"].copy()
+    row_bands = info["row_bands"]
+    col_bands = info["col_bands"]
+    source_tile = info["source_tile"]
+    slot_colors = info["slot_colors"]
