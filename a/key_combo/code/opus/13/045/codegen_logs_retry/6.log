+
+def _gap_direction(frame: Frame, gap: tuple[int, int]) -> tuple[int, int]:
+    center_r = frame.top + 1.5
+    center_c = frame.left + 1.5
+    dr = -1 if gap[0] < center_r else (1 if gap[0] > center_r else 0)
+    dc = -1 if gap[1] < center_c else (1 if gap[1] > center_c else 0)
+    direction = _normalize_dir(dr, dc)
+    assert direction != (0, 0), "gap direction must be outward"
+    return direction
