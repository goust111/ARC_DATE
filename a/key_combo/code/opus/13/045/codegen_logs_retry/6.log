+
+    def stop_group(ids: set[int]) -> None:
+        group = set(ids)
+        queue = list(ids)
+        while queue:
+            current = queue.pop()
+            partner = find_partner(current)
+            if partner is not None and partner not in group:
+                group.add(partner)
+                queue.append(partner)
+        for gid in group:
