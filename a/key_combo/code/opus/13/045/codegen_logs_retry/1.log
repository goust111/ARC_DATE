+    if barrier_axis == "vertical":
+        rooms_a = [(rr, cc) for rr in range(room_rows) for cc in range(barrier_index)]
+        rooms_b = [(rr, cc) for rr in range(room_rows) for cc in range(barrier_index, room_cols)]
+    else:
