+    cand_b = _frame_config_candidates(room_rows, room_cols, barrier_axis, barrier_index, side_b)
+    if not cand_a or not cand_b:
+        return None
+
+    frame_a = rng.choice(cand_a)
+    frame_b = rng.choice(cand_b)
+    if frame_a.room == frame_b.room:
+        return None
