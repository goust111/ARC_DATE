  "summary": "Complete the self-similar sprite lattice and mark each copy by its lattice coordinate.",
  "type": "symmetry/pattern",
  "src": "repeated kxk foreground sprite in a kxk lattice of slots, with one full slot row or column hidden by a solid rectangle",
  "dst": "complete lattice after removing the hidden row or column occluder",
  "transform": "use the sprite mask as the coarse slot mask; draw a sprite in every filled-mask slot and recolor within each copy the local pixel matching that slot coordinate to teal"
}
</annotation>
