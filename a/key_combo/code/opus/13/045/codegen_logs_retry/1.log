+    blue_seed = seeds_by_color[BLUE]
+    seed_set = {red_seed, blue_seed}
+    red_dist = _bfs_distances(post_ray_grid, red_seed, seed_set)
+    blue_dist = _bfs_distances(post_ray_grid, blue_seed, seed_set)
