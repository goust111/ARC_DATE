+    for color in (RED, BLUE):
+        coords = np.argwhere((grid == color) & (~occupied))
+        assert coords.shape == (1, 2), f"expected exactly one seed of color {color}"
+        seeds[color] = (int(coords[0, 0]), int(coords[0, 1]))
