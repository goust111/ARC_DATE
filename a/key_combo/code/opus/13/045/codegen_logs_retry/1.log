+def _bfs_distances(grid: np.ndarray, start: Coord, seeds: set[Coord]) -> dict[Coord, int]:
+    q = deque([start])
+    dist = {start: 0}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            nxt = (nr, nc)
+            if not _in_bounds(grid.shape, nr, nc) or nxt in dist:
+                continue
+            if not _traversable(grid, nxt, seeds):
+                continue
+            dist[nxt] = dist[(r, c)] + 1
+            q.append(nxt)
+    return dist
