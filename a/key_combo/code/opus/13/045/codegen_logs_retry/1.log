+    out = np.array(post_ray_grid, copy=True)
+    all_cells = set(red_dist) | set(blue_dist)
+    for pos in all_cells:
+        r, c = pos
+        if int(post_ray_grid[r, c]) != BLACK and pos not in seed_set:
+            continue
