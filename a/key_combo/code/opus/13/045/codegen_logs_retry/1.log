+def _find_seeds(grid: np.ndarray, frames: list[Frame]) -> dict[int, Coord]:
+    occupied = np.zeros_like(grid, dtype=bool)
+    for frame in frames:
+        occupied[frame.top : frame.top + FRAME_SIZE, frame.left : frame.left + FRAME_SIZE] = True
