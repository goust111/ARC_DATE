+    grid[seed_red] = RED
+    grid[seed_blue] = BLUE
+    if not _semantic_ok(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_RETRIES):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
