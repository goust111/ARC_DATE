+    seed_red = _choose_seed(max(comps_a, key=len), frame_boxes, rng)
+    seed_blue = _choose_seed(max(comps_b, key=len), frame_boxes, rng)
+    if seed_red is None or seed_blue is None or seed_red == seed_blue:
+        return None
