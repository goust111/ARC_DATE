            length=1 if turned or just_turned else 2
            ag['dir']=chosen
            just_turned=turned
            for step in range(length):
                nr=ag['cur'][0]+chosen[0]; nc=ag['cur'][1]+chosen[1]
                if not (0<=nr<H and 0<=nc<W):
                    ag['done']=True; reasons.append('boundary'); break
