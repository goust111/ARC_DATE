def _room_counts_valid(on_route, off_route):
    return ON_ROUTE_ROOM_MIN <= on_route <= ON_ROUTE_ROOM_MAX and OFF_ROUTE_ROOM_MIN <= off_route <= OFF_ROUTE_ROOM_MAX


def _solver_accepts(grid):
    try:
        main(grid)
