+def _build_input(gap: int, center: tuple[int, int], arm_lengths: tuple[int, int, int, int]) -> np.ndarray | None:
+    cell_size = 5
+    size = 4 * cell_size + 3 * gap
+    pitch = cell_size + gap
+    marker_positions = [i * pitch + cell_size // 2 for i in range(4)]
+
