+
+def _colorize(mask: np.ndarray) -> np.ndarray:
+    patch = np.zeros(mask.shape, dtype=int)
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    color_count = random.randint(2, min(3, len(coords)))
