+
+def _generate_instance() -> tuple[np.ndarray, np.ndarray]:
+    module_count = random.choice([2, 3])
+    orientations = ["vertical", "horizontal"]
+    if module_count == 3:
+        orientations.append(random.choice(["vertical", "horizontal"]))
+    random.shuffle(orientations)
