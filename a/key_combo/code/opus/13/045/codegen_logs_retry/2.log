+
+def _draw_module(grid: np.ndarray, module: dict) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]]:
+    r0 = int(module["r0"])
+    c0 = int(module["c0"])
+    h = int(module["outer_h"])
+    w = int(module["outer_w"])
