+    chamber_w = random.randint(4, 5)
+    top_h = random.randint(3, 4)
+    bottom_h = random.randint(3, 4)
+    return {
+        "orientation": orientation,
+        "outer_h": top_h + bottom_h + 3,
+        "outer_w": chamber_w + 2,
+        "chambers": (("top", top_h, chamber_w), ("bottom", bottom_h, chamber_w)),
