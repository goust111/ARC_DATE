+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+SPRITE_COLORS = (BLUE, RED, GREEN)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _label_mask(mask: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    components: list[np.ndarray] = []
+    next_id = 1
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            q = deque([(r, c)])
+            labels[r, c] = next_id
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = next_id
+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+            next_id += 1
+    return labels, components
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _normalize_cells(cells: set[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    pts = list(cells)
+    min_r = min(r for r, _ in pts)
+    min_c = min(c for _, c in pts)
+    return tuple(sorted((int(r - min_r), int(c - min_c)) for r, c in pts))
+
+
+def _coords_to_mask(coords: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = max(r for r, _ in coords) + 1
+    w = max(c for _, c in coords) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in coords:
+        mask[int(r), int(c)] = True
+    return mask
+
+
+def _mask_to_coords(mask: np.ndarray) -> tuple[tuple[int, int], ...]:
+    coords = np.argwhere(mask)
+    return tuple(sorted((int(r), int(c)) for r, c in coords))
+
+
+def _all_transforms(coords: tuple[tuple[int, int], ...]) -> list[tuple[tuple[int, int], ...]]:
+    pts = list(coords)
+    variants = []
+    for kind in range(8):
+        transformed = []
+        for r, c in pts:
+            if kind == 0:
+                rr, cc = r, c
+            elif kind == 1:
+                rr, cc = r, -c
+            elif kind == 2:
+                rr, cc = -r, c
+            elif kind == 3:
+                rr, cc = -r, -c
+            elif kind == 4:
+                rr, cc = c, r
+            elif kind == 5:
+                rr, cc = c, -r
+            elif kind == 6:
+                rr, cc = -c, r
+            else:
