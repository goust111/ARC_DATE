0142: def _gen_variants(coords):
0143:     pts = [(int(r), int(c)) for r, c in coords]
0144:     variants = []
0145:     for rr_r, rr_c, cc_r, cc_c in DIHEDRAL_TRANSFORMS:
0146:         transformed = []
0147:         for r, c in pts:
0148:             transformed.append((rr_r * r + rr_c * c, cc_r * r + cc_c * c))
0149:         variants.append(_gen_normalize(transformed))
0150:     return tuple(sorted(set(variants)))
