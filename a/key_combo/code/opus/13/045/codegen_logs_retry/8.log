+    size = grid.shape[0]
+    candidates = []
+    for r0 in range(1, size - h):
+        for c0 in range(1, size - w):
+            bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if not _category_position_ok(shape, r0, c0, category):
+                continue
+            if not _bbox_gap_ok(bbox, bboxes, QUERY_BBOX_GAP):
