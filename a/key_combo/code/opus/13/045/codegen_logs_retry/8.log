+
+
+def _polyomino_catalog():
+    fixed = {1: {((0, 0),)}}
+    for size in range(2, 6):
+        shapes = set()
+        for shape in fixed[size - 1]:
+            cells = set(shape)
+            for r, c in shape:
+                for dr, dc in NEIGHBORS4:
+                    nxt = (r + dr, c + dc)
+                    if nxt not in cells:
+                        shapes.add(_normalize(cells | {nxt}))
