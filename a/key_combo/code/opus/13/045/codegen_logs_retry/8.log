1585:     if not can_overlap and objects:
1586:         def size_key(obj: np.ndarray):
1587:             b = bbox(obj != bg)
1588:             if b is None:
1589:                 return (0, 0)
1590:             spr = crop_bbox(obj, b)
1591:             return (spr.shape[0] * spr.shape[1], int(np.sum(obj != bg)))
1592: 
1593:         objects.sort(key=size_key, reverse=True)
1594:         masks = [obj != bg for obj in objects]
1595: 
