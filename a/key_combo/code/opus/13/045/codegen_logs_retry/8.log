+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLORS = (1, 2, 3, 4, 6, 9)
+DIVIDER = 5
+QUERY = 7
+OUTLINE = 8
+
+ROT_OPS = ("r0", "r90", "r180", "r270")
+REF_OPS = ("fh", "fv", "fd", "fa")
+ALL_OPS = ROT_OPS + REF_OPS
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+LEGEND_HEIGHT = 5
+TEMPLATE_GAP = 1
+GRID_MIN = 22
+GRID_MAX = 28
+QUERY_COUNT_RANGE = (5, 8)
+QUERY_BBOX_GAP = 2
+GEN_ATTEMPTS = 400
+
+
+def _normalize(coords):
+    pts = [tuple(map(int, p)) for p in coords]
+    r0 = min(r for r, _ in pts)
+    c0 = min(c for _, c in pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
+
+
+def _transform(coords, op):
+    out = []
+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        if op == "r0":
+            out.append((r, c))
+        elif op == "r90":
+            out.append((c, -r))
+        elif op == "r180":
+            out.append((-r, -c))
+        elif op == "r270":
+            out.append((-c, r))
+        elif op == "fh":
+            out.append((-r, c))
+        elif op == "fv":
+            out.append((r, -c))
+        elif op == "fd":
+            out.append((c, r))
+        elif op == "fa":
+            out.append((-c, -r))
+        else:
+            raise ValueError(f"unknown transform {op}")
+    return _normalize(out)
+
+
+def _variants(coords, ops):
+    return {_transform(coords, op) for op in ops}
+
+
+def _shape_dims(coords):
+    rs = [r for r, _ in coords]
+    cs = [c for _, c in coords]
+    return max(rs) + 1, max(cs) + 1
+
+
+def _patch_from_shape(coords, color):
+    h, w = _shape_dims(coords)
+    patch = np.full((h, w), BG, dtype=int)
+    rr, cc = np.array(coords, dtype=int).T
+    patch[rr, cc] = int(color)
+    return patch
+
+
+def _bbox_from_coords(coords):
+    rr = coords[:, 0]
+    cc = coords[:, 1]
+    return int(rr.min()), int(cc.min()), int(rr.max()), int(cc.max())
+
+
+def _components_of_color(grid, color):
+    g = np.asarray(grid, dtype=int)
+    mask = g == int(color)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _legend_templates(grid):
+    legend = grid[:LEGEND_HEIGHT, : _divider_corner(grid)[1]]
+    templates = []
+    for color in sorted(set(map(int, legend.flatten())) - {BG, DIVIDER}):
+        for coords in _components_of_color(legend, color):
+            templates.append(
+                {
+                    "color": int(color),
+                    "shape": _normalize(coords),
