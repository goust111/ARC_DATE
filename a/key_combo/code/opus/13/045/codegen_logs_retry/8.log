+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLORS = (1, 2, 3, 4, 6, 9)
+DIVIDER = 5
+QUERY = 7
+OUTLINE = 8
+
+ROT_OPS = ("r0", "r90", "r180", "r270")
+REF_OPS = ("fh", "fv", "fd", "fa")
+ALL_OPS = ROT_OPS + REF_OPS
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
