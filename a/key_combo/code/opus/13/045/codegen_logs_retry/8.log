+    recolored = base.copy()
+    bboxes = []
+    query_infos = []
+    for query in _query_plan(role_map):
+        coords = _place_query(recolored, query["shape"], query["color"], query["category"], bboxes)
+        if coords is None:
+            return None
+        query_infos.append(
+            {
+                "shape": _normalize(query["shape"]),
+                "category": query["category"],
+                "coords": coords,
+                "color": int(query["color"]),
+                "tag": query["tag"],
+            }
