+    for r, c in coords:
+        r = int(r)
+        c = int(c)
+        if op == "r0":
+            out.append((r, c))
+        elif op == "r90":
+            out.append((c, -r))
+        elif op == "r180":
+            out.append((-r, -c))
+        elif op == "r270":
+            out.append((-c, r))
+        elif op == "fh":
+            out.append((-r, c))
+        elif op == "fv":
+            out.append((r, -c))
+        elif op == "fd":
+            out.append((c, r))
+        elif op == "fa":
