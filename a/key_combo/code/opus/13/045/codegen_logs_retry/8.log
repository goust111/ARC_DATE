+    g = np.asarray(grid, dtype=int)
+    if g.ndim != 2 or g.shape[0] != g.shape[1]:
+        raise AssertionError("expected a square 2D grid")
+    _divider_corner(g)
+    templates = _legend_templates(g)
+    if not templates:
+        raise AssertionError("legend must contain templates")
