0013: def main(input_grid):
0014:     """
0015:     Complete the bounding rectangle around an incomplete teal shape by filling its missing cells red.
0016: 
0017:     Input structure:
0018:     - The input is a black grid containing an incomplete teal rectangle.
0019:     - The teal pixels define the intended rectangle's bounding box.
0020:     - Black pixels inside that bounding box are missing rectangle cells.
0021: 
0022:     Rule:
0023:     - Find the bounding box of all non-black pixels.
0024:     - Replace black cells inside that box with red while preserving teal cells.
0025:     - Paste the completed rectangle back into the original grid.
0026: 
0027:     Key insight:
0028:     - The non-black bounding box gives the full rectangle extent; interior black cells are gaps to complete.
0029:     """
0030:     # Find the bounding box of the incomplete rectangle and use it to extra the sprite
0031:     b = bbox(input_grid != Color.BLACK)
0032:     assert b is not None
0033:     r0, c0, r1, c1 = b
0034:     rectangle = input_grid[r0 : r1 + 1, c0 : c1 + 1]
0035: 
0036:     # Find the missing parts of the rectangle (which are colored black) and complete it with red color
0037:     rectangle_sprite = np.where(rectangle == Color.BLACK, Color.RED, rectangle)
0038: 
0039:     # Make the output by copying the sprite to a new canvas
0040:     output_grid = np.copy(input_grid)
0041:     output_grid = paste(output_grid, rectangle_sprite, r0, c0)
0042: 
0043:     return output_grid
