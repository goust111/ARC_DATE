0053: def main(grid: np.ndarray) -> np.ndarray:
0054:     """Recolor each query sprite by matching its shape, up to rotation/reflection, to a colored legend sprite.
0055: 
0056:     Input structure
0057:     A background grid contains a one-color L-shaped divider from the top edge to the left edge.  The upper-left
0058:     region inside that divider holds monochrome colored template sprites.  Elsewhere, all query sprites share one
0059:     non-template color.
0060: 
0061:     Rule
0062:     Read the upper-left templates as a shape-to-color legend.  For each query sprite, compare its connected-cell
0063:     shape to the legend shapes under all rotations and reflections, then recolor that sprite to the matched
0064:     template color.  Leave the divider, background, and legend pixels unchanged.
0065: 
0066:     Key insight
0067:     The divider marks a dictionary of sprite shapes; the query color is only a placeholder, and orientation does
0068:     not matter for the lookup.
0069:     """
0070:     g = np.asarray(grid, dtype=int)
0071:     bg = get_bg(g)
0072:     divider_color, divider_r, divider_c = _find_legend_divider(g, bg)
0073: 
0074:     legend = g[:divider_r, :divider_c]
0075:     template_by_shape: dict[tuple[tuple[int, int], ...], int] = {}
0076:     template_colors: set[int] = set()
0077:     for comp in find_components(legend, bg=bg, connectivity=4, monochromatic=True):
0078:         color = int(comp["color"])
0079:         assert color != divider_color, "divider color must not appear inside the legend interior"
0080:         key = _canonical_shape(comp["coords"])
0081:         assert key not in template_by_shape, "each legend shape must map to exactly one color"
0082:         template_by_shape[key] = color
0083:         template_colors.add(color)
0084:     assert template_by_shape, "legend must contain at least one template sprite"
0085: 
0086:     role_colors = set(colors_present(g, exclude={bg, divider_color}))
0087:     query_colors = role_colors - template_colors
0088:     assert len(query_colors) == 1, "expected exactly one non-template query color"
0089:     query_color = next(iter(query_colors))
0090: 
0091:     out = g.copy()
0092:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[query_color]):
0093:         key = _canonical_shape(comp["coords"])
0094:         assert key in template_by_shape, "query sprite shape must occur in the legend"
0095:         coords = comp["coords"]
0096:         out[coords[:, 0], coords[:, 1]] = template_by_shape[key]
0097: 
0098:     return out
