+def _sorted_nonzero_cells(grid: np.ndarray) -> list[tuple[int, int, int]]:
+    cells = [(int(r), int(c), int(grid[r, c])) for r, c in np.argwhere(grid != BG)]
+    cells.sort()
+    return cells
