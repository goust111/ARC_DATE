+    min_side = {2: 12, 3: 14, 4: 16}[cup_count]
+    height = int(rng.integers(min_side, min_side + 5))
+    width = int(rng.integers(min_side, min_side + 5))
+    cups = _place_cups(rng, (height, width), directions)
+    if cups is None:
+        return None
