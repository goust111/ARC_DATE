+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+STRIP_HEIGHT = 3
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OPENINGS = ("up", "right", "down", "left")
+ROTATION_K = {"up": 0, "right": 3, "down": 2, "left": 1}
+MIN_CUP_GAP = 3
