+        key = (sprite.tobytes(), sprite.shape)
+        candidates[key] = sprite
+    return list(candidates.values())
+
+
+SPRITE_LIBRARY = _sprite_candidates()
+
+
+def _cup_patch(opening: str) -> np.ndarray:
+    if opening == "up":
+        patch = np.zeros((4, 5), dtype=int)
+        patch[:, 0] = RED
+        patch[:, -1] = RED
+        patch[-1, :] = RED
