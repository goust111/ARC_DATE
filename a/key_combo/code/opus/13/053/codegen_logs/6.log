+    sprite = SPRITE_LIBRARY[int(rng.integers(len(SPRITE_LIBRARY)))]
+    cup_count = int(rng.choice([2, 3, 4], p=[0.3, 0.4, 0.3]))
+    directions = _choose_directions(rng, cup_count)
