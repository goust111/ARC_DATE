+        patch = np.zeros((4, 5), dtype=int)
+        patch[:, 0] = RED
+        patch[:, -1] = RED
+        patch[-1, :] = RED
+        return patch
+    if opening == "down":
+        patch = np.zeros((4, 5), dtype=int)
+        patch[:, 0] = RED
+        patch[:, -1] = RED
+        patch[0, :] = RED
+        return patch
+    if opening == "left":
+        patch = np.zeros((5, 4), dtype=int)
+        patch[0, :] = RED
+        patch[-1, :] = RED
+        patch[:, -1] = RED
+        return patch
+    patch = np.zeros((5, 4), dtype=int)
+    patch[0, :] = RED
+    patch[-1, :] = RED
+    patch[:, 0] = RED
+    return patch
