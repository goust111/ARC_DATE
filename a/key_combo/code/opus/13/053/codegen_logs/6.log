+def _stamp_sprite(
+    out: np.ndarray, sprite: np.ndarray, interior_bbox: tuple[int, int, int, int]
+) -> None:
+    ir0, ic0, ir1, ic1 = interior_bbox
+    assert (ir1 - ir0 + 1, ic1 - ic0 + 1) == (3, 3)
+    h, w = sprite.shape
+    assert h <= 3 and w <= 3
+    target = out[ir0 : ir0 + h, ic0 : ic0 + w]
+    target[sprite == BLUE] = BLUE
