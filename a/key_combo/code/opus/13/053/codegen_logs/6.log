+    cups.sort(key=lambda cup: (cup["wall_bbox"][0], cup["wall_bbox"][1]))
+    return cups
+
+
+def _rotate_sprite(sprite: np.ndarray, opening: str) -> np.ndarray:
+    return np.rot90(sprite, ROTATION_K[opening]).copy()
