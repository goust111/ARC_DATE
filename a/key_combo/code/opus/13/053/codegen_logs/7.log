+    groups = list(_square_group_options(n))
+    if len(groups) < 2:
+        return None
+
+    for _ in range(120):
+        g1, g2 = random.sample(groups, 2)
+        if g1 & g2:
+            continue
+        fg_mask = base.copy()
+        for r, c in g1 | g2:
+            fg_mask[r, c] = True
+        placements = _unique_exact_cover(fg_mask)
