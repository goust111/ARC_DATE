import itertools

def cells(a):
    r,c=a
    return {(r+i,c+j) for i in range(2) for j in range(2)}

def touches(a,b):
    A=cells(a); B=cells(b)
    return any(abs(r1-r2)+abs(c1-c2)==1 for r1,c1 in A for r2,c2 in B)

valid=[]
for combo in itertools.combinations([(r,c) for r in range(4) for c in range(4)],4):
    occ=set(); ok=True
    for a in combo:
        cc=cells(a)
        if occ & cc:
            ok=False; break
        occ|=cc
    if not ok:
        continue
    rs=[r for r,c in occ]; cs=[c for r,c in occ]
    h=max(rs)-min(rs)+1; w=max(cs)-min(cs)+1
    if h not in (4,5) or w not in (4,5):
        continue
    # normalize
    mr=min(r for r,c in combo); mc=min(c for r,c in combo)
    norm=tuple(sorted((r-mr,c-mc) for r,c in combo))
    # connectivity on square-touch graph
    idx=list(norm)
    seen={0}; stack=[0]
    while stack:
        i=stack.pop()
        for j in range(4):
            if j in seen: continue
            if touches(idx[i], idx[j]):
                seen.add(j); stack.append(j)
    if len(seen)<4:
        continue
    valid.append(norm)
valid=sorted(set(valid))
print('count',len(valid))
for v in valid:
    print(v)
