+from __future__ import annotations
+
+from collections import Counter, deque
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLOR = 2
+SIDES = ("top", "right", "bottom", "left")
+DIRECTIONS = ("up", "right", "down", "left")
+SIDE_TO_DEFAULT_DIRECTION = {
+    "top": "up",
