+) -> np.ndarray:
+    centers = [(2 * r + 1, 2 * c + 1) for r, c in layout]
+    row_order = sorted(range(4), key=lambda i: (centers[i][0], centers[i][1]))
+    col_order = sorted(range(4), key=lambda i: (centers[i][1], centers[i][0]))
+    top_two = set(row_order[:2])
