+    region_h, region_w = _layout_shape(layout)
+    sprite_centers = [(2 * r + 1, 2 * c + 1) for r, c in layout]
+    out: dict[str, dict[int, list[tuple[int, int]]]] = {side: {} for side in SIDES}
