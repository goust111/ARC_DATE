+        if {parsed_by_side[side]["direction"] for side in SIDES} != set(DIRECTIONS):
+            return None
+        solved = main(grid)
+    except Exception:
+        return None
+
+    if not np.array_equal(solved, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
