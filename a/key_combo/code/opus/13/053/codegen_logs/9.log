def bbox(layout):
    rs=[r for a in layout for r in [a[0],a[0]+1]]
    cs=[c for a in layout for c in [a[1],a[1]+1]]
    return min(rs),min(cs),max(rs),max(cs)

def centers(layout):
    return [(2*r+1,2*c+1) for r,c in layout]

def cands(side, H, W):
    if side=='top': return [(-4,c) for c in range(-1,W-1)]
    if side=='bottom': return [(H+2,c) for c in range(-1,W-1)]
    if side=='left': return [(r,-4) for r in range(-1,H-1)]
    if side=='right': return [(r,W+2) for r in range(-1,H-1)]

def target_map(layout):
    r0,c0,r1,c1=bbox(layout); H=r1-r0+1; W=c1-c0+1
    loc=[(r-r0,c-c0) for r,c in layout]
    sc=centers(loc)
    ans={}
    for side in ['top','right','bottom','left']:
        options=[]
        for mr,mc in cands(side,H,W):
            center=(2*(mr+1),2*(mc+1))
            ds=[abs(center[0]-sr)+abs(center[1]-sc2) for sr,sc2 in sc]
            m=min(ds)
            if ds.count(m)==1:
                options.append(ds.index(m))
        ans[side]=sorted(set(options))
    return loc,ans

count=0
for layout in layouts:
    loc,ans=target_map(layout)
    # test if perfect matching exists
    sides=['top','right','bottom','left']
    ok=False
    for perm in itertools.permutations(range(4)):
        if all(perm[i] in ans[sides[i]] for i in range(4)):
            ok=True; break
    if ok:
        count+=1
        print(loc,ans)
print('valid layouts with side->sprite bijection',count)
