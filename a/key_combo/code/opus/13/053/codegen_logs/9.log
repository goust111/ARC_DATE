+    margin_left = 4 + random.choice(EXTRA_MARGIN_CHOICES)
+    margin_bottom = 5 + random.choice(EXTRA_MARGIN_CHOICES)
+    margin_right = 5 + random.choice(EXTRA_MARGIN_CHOICES)
