        area = (interior_bbox[2] - interior_bbox[0] + 1) * (interior_bbox[3] - interior_bbox[1] + 1)
        if len(cells) + len(mirrored) >= area:
            continue
        return sorted(cells)
    raise RuntimeError("failed to build non-degenerate cup pattern")


