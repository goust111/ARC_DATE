    inp[r0 + 1 : r1, c0 + 1 : c1] = BG_COLOR

    if not np.array_equal(main(inp), out):
        return None
    return inp


def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
