+    for r, c in cells:
+        if not (0 <= r < inner_h and 0 <= c < inner_w):
+            return False
+        if (r, c) in occupied:
+            return False
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < inner_h and 0 <= nc < inner_w and (nr, nc) in occupied:
+                return False
