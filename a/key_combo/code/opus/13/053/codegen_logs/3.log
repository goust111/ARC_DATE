spec:
  grid: 10-20 rows x 10-20 cols, bg=0
  frame:
    shape: 1-pixel-thick hollow rectangle, color=1 [observed]
    size: 6-14 rows x 6-14 cols (may be non-square)
    top-left: at (N, N) where N = number of markers
    interior: entirely bg; min(interior_h, interior_w) >= 2*N_markers - 1
  markers:
    count: 2-5 singleton pixels, each a unique non-bg non-frame color
    layout: contiguous down-right diagonal from (0,0) to (N-1,N-1)
    colors: all distinct, no duplicates, drawn from palette 2-9
