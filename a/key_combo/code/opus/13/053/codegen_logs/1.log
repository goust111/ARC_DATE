+    for meta in metas:
+        ir0, ic0, ir1, ic1 = meta["interior_bbox"]
+        for r in range(ir0, ir1 + 1):
+            for c in range(ic0, ic1 + 1):
+                if int(fill_only[r, c]) == BG:
+                    fill_only[r, c] = meta["color"]
