+    h, w = patch.shape
+    region = dst[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BG
+    region[mask] = patch[mask]
+
+
+def _globalize_meta(local_meta: dict, top: int, left: int) -> dict:
+    def shift(box: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
+        r0, c0, r1, c1 = box
