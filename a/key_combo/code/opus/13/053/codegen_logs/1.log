+        return False
+
+    mirror_only = inp.copy()
+    any_green_added = False
+    for meta in metas:
+        for r, c in meta["pattern_cells"]:
+            mr, mc = _mirror_coord(r, c, meta["interior_bbox"], meta["opening"])
