+        c0 = side - w
+        for r in range(r0, r0 + h):
+            for c in range(c0, c0 + w):
+                coords.add((r, c))
+    elif branch == "diag":
+        length = side
+        r0 = 0
+        c0 = 0
+        for k in range(length):
+            coords.add((r0 + k, c0 + k))
+        if side >= 4:
