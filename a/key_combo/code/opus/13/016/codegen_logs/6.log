+def _anomaly_shape(side: int, pattern_seed: int) -> set[Coord]:
+    branch = ("rectangle", "diag", "lshape", "scatter")[pattern_seed % 4]
+    coords: set[Coord] = set()
+
+    if branch == "rectangle":
+        h = max(1, side // 2)
+        w = max(1, (side + 1) // 2)
