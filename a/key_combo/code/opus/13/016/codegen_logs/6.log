+    side = rng.randint(*_SIDE_RANGE)
+    size = _GRID_BANDS * side + (_GRID_BANDS - 1)
+    grid = np.zeros((size, size), dtype=int)
+
+    for split in range(side, size, side + 1):
+        grid[split, :] = _SEPARATOR
