+def _row_starts(rng: np.random.Generator, height: int, num_pairs: int) -> list[int] | None:
+    gaps = rng.integers(1, 4, size=max(0, num_pairs - 1))
+    used = 2 * num_pairs + int(gaps.sum())
+    slack = height - used
+    if slack < 0:
+        return None
+    row = int(rng.integers(0, slack + 1))
+    starts = [row]
+    for gap in gaps:
+        row += 2 + int(gap)
+        starts.append(row)
+    return starts
