+def _build_input_from_stacked(
+    rng: np.random.Generator, stacked: np.ndarray, num_pairs: int, gap_width: int
+) -> np.ndarray | None:
+    min_height = 2 * num_pairs + max(1, num_pairs - 1) + 2
