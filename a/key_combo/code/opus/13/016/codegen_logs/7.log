+
+    max_k = min(5, len(baseline["anchors"]) // 3)
+    if max_k < 1:
+        return None
+    k = random.randint(1, max_k)
+
+    for _ in range(100):
+        seeds = _pick_seed_cells(mode, k, usable, baseline)
+        if seeds is None:
