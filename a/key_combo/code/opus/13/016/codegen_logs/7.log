+
+
+def _make_template() -> np.ndarray:
+    a, b = random.sample(TEMPLATE_COLORS, 2)
+    patterns = (
+        np.array([[0, 1], [1, 0]], dtype=int),
+        np.array([[0, 1], [0, 1]], dtype=int),
+        np.array([[0, 0], [1, 1]], dtype=int),
+        np.array([[0, 0], [0, 1]], dtype=int),
