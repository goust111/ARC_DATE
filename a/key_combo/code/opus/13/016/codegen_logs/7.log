+            forced = random.randint(1, min(k, len(edge_pool), 2))
+            chosen.extend(random.sample(edge_pool, forced))
+            remainder = [cell for cell in usable if cell not in chosen]
+            if len(remainder) < k - forced:
+                continue
+            chosen.extend(random.sample(remainder, k - forced))
+
+        if _well_spaced(chosen):
+            random.shuffle(chosen)
+            return chosen
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    size = random.choice(GRID_SIZE_CHOICES)
+    mode = random.choice(("quota", "obstacle", "edge"))
+    center_mode = random.choice(("central", "offset"))
+    template = _make_template()
+    center = _choose_center(size, center_mode)
+
+    base = np.zeros((size, size), dtype=int)
