+
+
+def _choose_marker_position(
+    bbox: tuple[int, int, int, int],
+    center: tuple[int, int],
+    direction: str,
+    h: int,
+    w: int,
+    sep: int,
+    main_left: int,
+    forbidden_rows: set[int],
+    forbidden_cols: set[int],
+) -> tuple[int, int] | None:
