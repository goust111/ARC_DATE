+    markers = []
+    for comp in comps:
+        r0, c0, r1, c1 = _bbox(comp)
+        area = int(len(comp))
+        if area == 1:
+            markers.append((int(comp[0, 0]), int(comp[0, 1]), int(top[comp[0, 0], comp[0, 1]])))
+        else:
+            assert area == 9 and (r1 - r0 + 1, c1 - c0 + 1) == (3, 3), "legend sprites must be 3x3"
