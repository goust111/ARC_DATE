+            if target not in counts:
+                continue
+        if mode == 3 and not (any(c == 0 for c in counts) and any(c >= 2 for c in counts)):
+            continue
+        return counts
+
+    counts = [0] * k
+    counts[int(_RNG.integers(0, k))] = 1
+    return counts
