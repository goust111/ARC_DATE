+        chosen = {coords[int(idx)] for idx in picks}
+        if any(set(orbit).issubset(chosen) for orbit in orbits):
+            continue
+        return chosen
+    return None
+
+
+def _build_input(size: int, colors: list[int], counts: list[int]) -> np.ndarray | None:
+    grid = np.zeros((size, size), dtype=int)
