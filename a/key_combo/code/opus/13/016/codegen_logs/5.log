  grid: 5-18 rows x 5-18 cols, background 8 (azure)
  objects:
    count: 1-4 composite objects, each 9 foreground pixels
    marker_color: single color shared by all markers; most frequent fg color, pixel count = 4 * object_count; always 1 (blue) [observed]
    structure: each object bbox is 3x6 (horizontal) or 6x3 (vertical)
    marker_block: |
      fixed 4-pixel shape in one 3x3 half, rotated per direction:
        left:  1..|.11|1..   right: ..1|11.|..1
        top:   1.1|.1.|.1.   bottom: .1.|.1.|1.1
    cross_block: 5-pixel plus/cross in the other 3x3 half; center always 4 (yellow); 4 arm colors all distinct, none = bg or marker
  placement:
    objects 8-connected-separated from each other in input
    distance from object bbox to target edge >= 2 [observed]
    objects sharing same target edge must occupy non-overlapping row/col bands (no collision after move)
  rule:
    move_direction: away from marker side to opposite grid edge (left->right, right->left, top->bottom, bottom->top)
    cross_rotation: rotate 3x3 cross block 180 degrees within the composite
    marker_block: unchanged
    final_position: object bbox flush against target grid edge, same row (horizontal) or column (vertical)

generation_strategy:
