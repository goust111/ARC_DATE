+    for layer in layers:
+        depth = int(layer["depth"])
+        color = int(layer["color"])
+        count = sum(1 for r, c in anomalies if _layer_depth(r, c, rows) == depth)
+        counts.append(count)
+        colors.append(color)
+
+    return _render_output(counts, colors)
