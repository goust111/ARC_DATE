+    except Exception:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        call_id = _GEN_COUNTER
+        _GEN_COUNTER += 1
+        grid = _gen_attempt(call_id)
+        if grid is not None:
+            return grid
