+        if chosen is None:
+            return None
+        for r, c in chosen:
+            grid[r, c] = ANOMALY
+
+    return grid
+
+
+def _gen_attempt(call_id: int) -> np.ndarray | None:
+    size, k = _choose_layout(call_id)
+    colors = list(_RNG.choice(RING_COLORS, size=k, replace=False))
