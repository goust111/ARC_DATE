+        top, left = loc
+        placed.append(
+            {
+                "interior": spec["interior"],
+                "symmetric": bool(spec["symmetric"]),
+                "count": int(spec["count"]),
+                "bbox": (top, left, top + patch.shape[0] - 1, left + patch.shape[1] - 1),
+            }
+        )
+
+    if not _validate_grid(grid, placed):
+        return None
+    return grid
