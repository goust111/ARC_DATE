+def _frame_infos(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _dominant_color(g)
+    infos: list[dict] = []
+    for box, frame_color in _find_frames(g, bg):
+        r0, c0, r1, c1 = box
+        interior = g[r0 + 1 : r1, c0 + 1 : c1]
