+def _gen_attempt() -> np.ndarray | None:
+    masks = _sample_seed_masks()
+    specs = _specs_from_masks(masks)
+    placements = _layout_positions([spec["outer_shape"] for spec in specs])
+    if placements is None:
+        return None
+    height = max(box[2] for box in placements.values()) + 1
+    width = max(box[3] for box in placements.values()) + 1
+    grid = _draw_input(specs, placements, (height, width))
+    try:
+        if _semantic_checks(grid):
+            return grid
+    except Exception:
+        return None
+    return None
+
+
+def generate_input() -> np.ndarray:
