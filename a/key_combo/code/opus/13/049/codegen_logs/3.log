+                "holes": holes,
+                "mask": mask,
+                "frame_color": frame_color,
+                "seed_color": seed_color,
+                "inner_shape": inner_shape,
+                "outer_shape": (inner_shape[0] + 2, inner_shape[1] + 2),
+            }
+        )
+    return specs
