+    height: int,
+    width: int,
+    vertex_row: int,
+    center_col: int,
+    depth: int,
+    band_r0: int,
+    band_h: int,
+    tile: np.ndarray,
+) -> tuple[np.ndarray, np.ndarray]:
+    left = center_col - depth
+    right = center_col + depth
+    band_r1 = band_r0 + band_h - 1
+    expected = _complete_pattern((height, width), (band_r0, band_r1), tile.shape, tile)
