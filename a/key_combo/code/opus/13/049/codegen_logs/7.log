+    out = g.copy()
+    covered = np.zeros(g.shape[1], dtype=bool)
+    covered[c0 : c1 + 1] = True
+    for r in range(band_r0, band_r1 + 1):
+        for c in range(g.shape[1]):
+            if covered[c]:
+                continue
+            if out[r, c] == BLACK:
+                out[r, c] = int(tile[r % pr, c % pc])
+
+    out[out == ORANGE] = BLACK
+    return out
+
