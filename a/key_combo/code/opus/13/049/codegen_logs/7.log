+    rr, cc = np.indices(tile.shape)
+    known = np.column_stack([rr.ravel(), cc.ravel()])
+    pr, pc, _ = _infer_unique_period(tile, known, rows, cols)
+    return pr, pc
+
+
+def _random_tile(rng: np.random.Generator, p_h: int) -> np.ndarray:
+    for _ in range(300):
+        n_colors = _randint(rng, 2, 3)
