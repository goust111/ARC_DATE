+    inp = expected.copy()
+    inp[:, :left] = inp[:, :left]
+    inp[:, right + 1 :] = inp[:, right + 1 :]
+    inp[band_r0 : band_r1 + 1, :left] = BLACK
+    inp[band_r0 : band_r1 + 1, right + 1 :] = BLACK
+
