+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+ORANGE = 7
+PALETTE = (1, 2, 3, 4, 5, 6, 8, 9)
+GEN_ATTEMPTS = 400
+
+
+def _widest_orange_span(grid: np.ndarray) -> tuple[int, int, int]:
+    orange = grid == ORANGE
+    rows = np.where(np.any(orange, axis=1))[0]
+    assert len(rows) > 0, "expected an orange chevron"
+
