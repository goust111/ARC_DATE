+    replacement_colors: list[int] = []
+    for r, c in sorted(pattern):
+        expected = int(clean[r, c])
+        if rng.random() < 0.65 and len(tile_palette - {expected}) > 0:
+            choices = sorted(tile_palette - {expected})
+        else:
