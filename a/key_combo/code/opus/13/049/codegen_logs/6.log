+def _has_smaller_period(tile: np.ndarray) -> bool:
+    th, tw = tile.shape
+    for pr in range(1, th + 1):
+        for pc in range(1, tw + 1):
+            if pr == th and pc == tw:
+                continue
+            if pr * pc >= th * tw:
+                continue
+            ok = True
+            for r in range(th):
+                for c in range(tw):
+                    if tile[r, c] != tile[r % pr, c % pc]:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                return True
+    return False
