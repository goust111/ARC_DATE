+
+    known_count = int(np.sum(inp != BLACK))
+    if true_support != known_count - len(pattern):
+        return False
+
+    scored = []
+    for candidate in PERIOD_CANDIDATES:
+        inferred = _infer_tile_and_support(inp, candidate, require_unique=False)
+        if inferred is None:
