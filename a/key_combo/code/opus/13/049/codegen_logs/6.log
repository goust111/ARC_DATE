+
+def _neighbors4(cell: tuple[int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = cell
+    h, w = shape
+    out = []
+    for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            out.append((rr, cc))
+    return out
