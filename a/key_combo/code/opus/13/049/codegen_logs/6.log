+            weights_arr = np.asarray(weights, dtype=float)
+            weights_arr /= weights_arr.sum()
+            idx = int(rng.choice(len(choices), p=weights_arr))
+            nr, nc = choices[idx]
+            prev_dir = (nr - r, nc - c)
+            cells.append((nr, nc))
+            used.add((nr, nc))
+        if len(used) == target_len:
