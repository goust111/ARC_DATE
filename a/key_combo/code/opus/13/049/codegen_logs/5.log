+
+    sides = set(activations.values())
+    if active_count >= 2 and rng.random() < 0.5 and len(sides) < 2:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        grid = _attempt_generate(rng)
+        if grid is not None:
+            return grid
