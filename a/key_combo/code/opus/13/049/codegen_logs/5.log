    end = doors[1][1]
    row_step = _sign(end[0] - start[0])
    col_step = _sign(end[1] - start[1])
    assert row_step != 0 or col_step != 0

    moves = []
    if row_step:
        moves.append((row_step, 0))
    if col_step:
        moves.append((0, col_step))

