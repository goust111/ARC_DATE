# Canvas and object bounds.
GRID_N_MIN, GRID_N_MAX = 6, 12
FRAME_H_MIN, FRAME_H_MAX = 3, 7
FRAME_W_MIN, FRAME_W_MAX = 4, 6
SOLID_H_MIN, SOLID_H_MAX = 1, 5
SOLID_W_MIN, SOLID_W_MAX = 1, 4
TRAIL_LEN_MIN, TRAIL_LEN_MAX = 1, 5

