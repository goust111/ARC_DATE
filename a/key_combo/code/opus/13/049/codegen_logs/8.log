+    RECENT_OUTPUTS.add(out_sig)
+    if len(RECENT_OUTPUTS) > 512:
+        RECENT_OUTPUTS.clear()
+        RECENT_OUTPUTS.add(out_sig)
+
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
