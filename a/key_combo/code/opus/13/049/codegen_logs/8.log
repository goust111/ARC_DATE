+
+    if direction == DIR_RIGHT:
+        band = row_bands[target_row]
+        marker_r = rng.randint(band[0], band[1])
+        max_gap = left_margin + min_dc - 1
+        gap = rng.randint(1, max_gap)
+        marker_c = lattice["left"] - gap - 1
+    elif direction == DIR_LEFT:
+        band = row_bands[target_row]
+        marker_r = rng.randint(band[0], band[1])
