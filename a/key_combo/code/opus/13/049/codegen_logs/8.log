+                None,
+                solid_col0 + cc,
+                marker_color,
+                top_margin,
+                bottom_margin,
+                left_margin,
+                right_margin,
+                rng,
+            )
+        sprites.append(sprite)
+
+    lattice2 = _locate_lattice(grid)
+    extracted, meta = _extract_solid_block(grid, lattice2)
+    if not np.array_equal(extracted, solid):
