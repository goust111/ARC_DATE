+                return None
+            rr = row_choices[row_ptr]
+            row_ptr += 1
+            cc = 0 if direction == DIR_RIGHT else solid_w - 1
+            if (rr, cc) in used_targets:
+                return None
+            used_targets.add((rr, cc))
+            expected[rr, cc] = marker_color
+            sprite = _place_sprite(
+                grid,
+                lattice,
+                direction,
+                solid_row0 + rr,
+                None,
+                marker_color,
+                top_margin,
+                bottom_margin,
+                left_margin,
+                right_margin,
+                rng,
