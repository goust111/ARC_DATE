+            row = int(r0)
+            cols = sorted(map(int, coords[:, 1]))
+            assert cols == list(range(int(c0), int(c1) + 1)), "horizontal bar must be contiguous"
+            orient = "H"
+        else:
+            col = int(c0)
+            rows = sorted(map(int, coords[:, 0]))
+            assert rows == list(range(int(r0), int(r1) + 1)), "vertical bar must be contiguous"
+            orient = "V"
+
