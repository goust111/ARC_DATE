+        assert (height == 1) ^ (width == 1), "each object must be a one-cell-thick bar"
+        assert int(coords.shape[0]) == length, "bar must be solid and contiguous"
+        assert length >= 3 and length % 2 == 1, "bars must have odd length in [3, 9]"
+
