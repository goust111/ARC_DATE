        patch = crop_bbox(g, (r0, c0, r1, c1))

        # Isolate this component exactly (bbox rectangle may include background).
        rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp["coords"]]
        m = mask_from_coords(rel_coords, patch.shape)
