+def _line_cells(center: tuple[int, int], length: int, orient: str) -> list[tuple[int, int]]:
+    cr, cc = map(int, center)
+    half = int(length) // 2
+    if orient == "H":
+        return [(cr, c) for c in range(cc - half, cc + half + 1)]
+    if orient == "V":
+        return [(r, cc) for r in range(cr - half, cr + half + 1)]
