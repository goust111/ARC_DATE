+    if len({bar["color"] for bar in bars}) != len(bars):
+        return False
+    if len({bar["center"][0] for bar in bars}) != len(bars):
+        return False
+    if len({bar["center"][1] for bar in bars}) != len(bars):
+        return False
+    if {bar["orient"] for bar in bars} != {"H", "V"}:
