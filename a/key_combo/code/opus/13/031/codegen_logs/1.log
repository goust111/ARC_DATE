def _gen_column_options(width: int, gap: int) -> list[tuple[int, int]]:
    return [(left, left + gap) for left in range(EDGE_COLUMN_MARGIN, width - gap - EDGE_COLUMN_MARGIN)]


def _gen_row_starts(
