+        return False
+
+    same_dir_diff_len = any(
+        parsed[i].direction == parsed[j].direction and parsed[i].length != parsed[j].length
+        for i in range(len(parsed))
+        for j in range(i + 1, len(parsed))
+    )
+    if not same_dir_diff_len:
+        return False
+
+    try:
+        out = main(inp)
+    except Exception:
+        return False
+
+    if np.array_equal(out, inp):
+        return False
