def _gen_matches_solver(inp: np.ndarray, out: np.ndarray) -> bool:
    counts = np.bincount(inp.ravel(), minlength=GEN_COLOR_BINS)
    if counts[GEN_BACKGROUND] <= max(counts[1:]):
        return False
    try:
        solved = main(inp)
    except Exception:
        return False
    return bool(np.array_equal(solved, out))


