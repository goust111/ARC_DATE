+    magenta_count = int(np.count_nonzero(out == MAGENTA))
+    if want_overlap != (magenta_count > 0):
+        return False
+    if magenta_count > max(12, inp.size // 12):
+        return False
+
+    density = int(np.count_nonzero(out)) / float(out.size)
+    if density > 0.58:
+        return False
