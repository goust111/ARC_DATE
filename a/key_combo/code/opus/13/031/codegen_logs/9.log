  92: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3
  93: COLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5
  94: UNUSED_COLOR_BIAS = 0.7
  95: 
  96: # Mask density and retry budget.
  97: MASK_DENSITY_MIN, MASK_DENSITY_MAX = 0.60, 0.71
