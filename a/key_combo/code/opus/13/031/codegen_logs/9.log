+    if any((grid == color).sum() >= len(template_offsets) for color in full_copies):
+        return None
+    if any(color not in (YELLOW, ORANGE) for color in full_copies):
+        return None
+    if np.count_nonzero(expected == GREEN) == 0 or np.count_nonzero(expected == BLACK) == 0:
