  10: def main(grid: np.ndarray) -> np.ndarray:
  11:     """Overlay the colored contents of same-sized blank panels after removing the dominant separator color.
  12: 
  13:     Input structure
  14:     - The most common color is a separator surrounding several rectangular
  15:       panels made from a common blank color plus sparse colored marks.
  16:     - The panels are 4-connected regions of non-separator cells, and all panel
  17:       bounding boxes have the same shape.
  18:     Rule
  19:     - Create one blank panel of that common shape.
  20:     - For each input panel, copy every non-blank mark to the same relative
  21:       position in the output panel.
  22:     Key insight
  23:     - The large separator color is not part of the answer; the answer is the
  24:       transparent overlay of the small drawings inside its panels.
  25:     """
  26:     g = np.asarray(grid, dtype=int)
  27: 
  28:     separator = get_bg(g)
  29:     panel_values = g[g != separator]
  30:     assert panel_values.size > 0
  31: 
  32:     counts = Counter(map(int, panel_values))
  33:     blank, blank_count = counts.most_common(1)[0]
  34:     assert all(blank_count > count for color, count in counts.items() if color != blank)
  35: 
  36:     panels = find_components(g, bg=separator, connectivity=4, monochromatic=False)
  37:     assert panels
  38: 
  39:     boxes = [panel["bbox"] for panel in panels]
  40:     panel_shapes = {(r1 - r0 + 1, c1 - c0 + 1) for r0, c0, r1, c1 in boxes}
  41:     assert len(panel_shapes) == 1
  42:     height, width = next(iter(panel_shapes))
  43: 
  44:     out = np.full((height, width), blank, dtype=int)
  45:     for r0, c0, r1, c1 in boxes:
  46:         patch = g[r0 : r1 + 1, c0 : c1 + 1]
  47:         assert patch.shape == (height, width)
  48:         assert np.all(patch != separator)
  49: 
  50:         mark_mask = patch != blank
  51:         assert np.any(mark_mask)
  52:         assert not np.any((out != blank) & mark_mask)
  53:         out[mark_mask] = patch[mark_mask]
  54: 
  55:     return out
  56: 
  57: # --------------- generator (o5x) ---------------
  58: 
  59: # Canvas/panel geometry.
  60: CANVAS_SHAPE, PANEL_HEIGHT_BOUNDS, PANEL_WIDTH_BOUNDS, PANEL_COUNT_BOUNDS = (16, 16), (3, 5), (3, 5), (2, 4)
  61: # Mark blob sizing and preferred output coverage.
  62: BLANK_COLOR, MARK_SIZE_VALUES, COVERAGE_MIN, COVERAGE_MAX = 0, range(2, 6), 0.45, 0.80
  63: # Color/placement constraints.
  64: ARC_COLORS, PANEL_BORDER, PANEL_GAP, PADDING_CONNECTIVITY = range(1, 10), 1, 2, 8
  65: # Retry limit and 4-neighbor growth.
  66: MAX_GENERATION_ATTEMPTS, NEIGHBORS4 = 300, ((-1, 0), (1, 0), (0, -1), (0, 1))
  67: 
  68: def _gen_neighbors4(r, c, h, w):
  69:     for dr, dc in NEIGHBORS4:
  70:         rr, cc = r + dr, c + dc
  71:         if 0 <= rr < h and 0 <= cc < w:
  72:             yield rr, cc
  73: 
  74: 
  75: def _gen_size_tuple(h, w, n):
  76:     """Choose per-panel mark sizes near the observed output coverage range."""
  77:     area = h * w
  78:     tuples = [sizes for sizes in itertools.product(MARK_SIZE_VALUES, repeat=n) if sum(sizes) <= area]
  79:     preferred = [sizes for sizes in tuples if COVERAGE_MIN <= sum(sizes) / area <= COVERAGE_MAX]
  80:     if preferred:
  81:         return random.choice(preferred)
  82:     def coverage_distance(sizes):
  83:         coverage = sum(sizes) / area
  84:         return min(abs(coverage - COVERAGE_MIN), abs(coverage - COVERAGE_MAX))
  85: 
  86:     best_distance = min(coverage_distance(sizes) for sizes in tuples)
  87:     closest = [sizes for sizes in tuples if coverage_distance(sizes) == best_distance]
  88:     return random.choice(closest)
