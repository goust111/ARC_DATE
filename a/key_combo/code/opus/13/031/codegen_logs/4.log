+def _bbox_gap_ok(box: tuple[int, int, int, int], others: list[tuple[int, int, int, int]], gap: int = 1) -> bool:
+    r0, c0, r1, c1 = box
+    for or0, oc0, or1, oc1 in others:
+        if not (r1 + gap < or0 or or1 + gap < r0 or c1 + gap < oc0 or oc1 + gap < c0):
+            return False
+    return True
