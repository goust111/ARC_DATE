+FRAME_COLOR = 5
+BASE_COLORS = (1, 3, 4)
+MARKER_COLORS = (2, 6, 7, 8, 9)
+K_CHOICES = (2, 3)
+SLOT_COUNT_CHOICES = (2, 3)
+LAYOUT_SIZE_BY_K = {2: (6, 9), 3: (6, 8)}
+SLOT_AREA_RANGE = (6, 15)
+CANVAS_RANGE = (22, 30)
+MAX_RETRIES = 400
