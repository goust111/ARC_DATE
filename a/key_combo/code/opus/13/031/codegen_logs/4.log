+    order = sorted(range(len(slots)), key=lambda idx: len(slot_options[idx]))
+    solutions: list[list[dict | None]] = []
+
+    def dfs(depth: int, used: set[int], chosen: list[dict | None]) -> None:
+        if len(solutions) > 1:
+            return
+        if depth == len(order):
+            solutions.append(chosen.copy())
+            return
+        slot_idx = order[depth]
