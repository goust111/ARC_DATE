+def _infer_scale(pieces: list[dict]) -> int:
+    valid = []
+    for k in (2, 3):
+        if all(_downsample_blocks(piece["mask"], k) is not None for piece in pieces):
+            valid.append(int(k))
+    assert len(valid) == 1, "scale factor must be uniquely inferable"
+    return int(valid[0])
