+def _build_expected(layout: np.ndarray, slots: list[dict], out_patches: list[np.ndarray], k: int) -> np.ndarray:
+    out = np.full(((layout.shape[0] + 2) * k, (layout.shape[1] + 2) * k), FRAME_COLOR, dtype=int)
