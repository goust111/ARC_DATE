+def _hole_position(cell: np.ndarray) -> tuple[int, int]:
+    holes = np.argwhere(cell == BLACK)
+    assert len(holes) == 1, "each candidate cell must contain exactly one black hole"
+    return tuple(map(int, holes[0]))
+
