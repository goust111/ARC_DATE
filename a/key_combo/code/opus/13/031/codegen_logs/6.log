+        if have < need:
+            deficit[int(color)] = int(need - have)
+    return deficit
+
+
+def _completion_info(cells: dict[tuple[int, int], np.ndarray], positions: list[tuple[int, int]]) -> tuple[Counter[int], dict[tuple[int, int], int]] | None:
