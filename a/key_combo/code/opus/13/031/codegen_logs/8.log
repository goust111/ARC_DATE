+    if 0 not in types or 1 not in types:
+        types[random.randrange(n)] = 0
+        types[random.randrange(n)] = 1
+
+    colors = random.sample(list(range(1, 10)), n)
+    order = random.sample(colors, len(colors))
+
+    max_side = max(3 * s for s in scales)
+    center_r = random.randint(max_side // 2, h - 1 - max_side // 2)
+    center_c = random.randint(max_side // 2, w - 1 - max_side // 2)
+
+    sprites = []
+    for i in range(n):
+        scale = int(scales[i])
+        size = 3 * scale
+        top = center_r - size // 2 + random.randint(-4, 4)
+        left = center_c - size // 2 + random.randint(-4, 4)
