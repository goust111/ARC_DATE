+def _overlap_pairs(masks: dict[int, np.ndarray], colors: list[int]) -> set[frozenset[int]]:
+    pairs: set[frozenset[int]] = set()
+    for i, a in enumerate(colors):
+        for b in colors[i + 1 :]:
+            if np.any(masks[a] & masks[b]):
