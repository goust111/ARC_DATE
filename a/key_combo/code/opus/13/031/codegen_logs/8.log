+def _full_mask(shape: tuple[int, int], sprite: dict, proto: np.ndarray) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    patch = _scale_mask(proto, int(sprite["scale"]))
+    top = int(sprite["top"])
+    left = int(sprite["left"])
+    h, w = patch.shape
+    mask[top : top + h, left : left + w] = patch
+    return mask
