+    if n == 3:
+        scales.append(random.choice([2, 3]))
+    else:
+        scales.extend([random.choice([2, 3]), random.choice([2, 3])])
+    random.shuffle(scales)
+
+    small_idx = [i for i, s in enumerate(scales) if s == 1]
+    types = [None] * n
+    types[small_idx[0]] = 0
+    types[small_idx[1]] = 1
+    for i in range(n):
