+    n = random.choice([3, 4])
+    scales = [1, 1]
+    if n == 3:
+        scales.append(random.choice([2, 3]))
+    else:
+        scales.extend([random.choice([2, 3]), random.choice([2, 3])])
+    random.shuffle(scales)
