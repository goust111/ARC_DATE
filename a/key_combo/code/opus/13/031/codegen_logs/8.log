+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter
+
+import numpy as np
+
+
+_PROTO_LIBRARY = [
+    np.array([[1, 1, 1], [0, 1, 0], [0, 1, 0]], dtype=bool),
