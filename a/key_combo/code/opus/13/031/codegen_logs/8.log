+    order = random.sample(colors, len(colors))
+
+    max_side = max(3 * s for s in scales)
+    center_r = random.randint(max_side // 2, h - 1 - max_side // 2)
+    center_c = random.randint(max_side // 2, w - 1 - max_side // 2)
