+
+def _random_proto_pair() -> tuple[np.ndarray, np.ndarray]:
+    ia, ib = random.sample(range(len(_PROTO_LIBRARY)), 2)
+    return _PROTO_LIBRARY[int(ia)], _PROTO_LIBRARY[int(ib)]
