+            return []
+        scale = h // 3
+        if scale < 1 or scale > 3:
+            return []
+        sprites.append(
+            {
+                "color": int(color),
+                "top": int(r0),
+                "left": int(c0),
+                "scale": int(scale),
+                "visible": _crop(vis, box).copy(),
+                "area": int(h * w),
+            }
+        )
