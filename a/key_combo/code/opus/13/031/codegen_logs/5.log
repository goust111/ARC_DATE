+def _boxes_conflict(a: Slot, b: Slot, pad: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a.bbox
+    br0, bc0, br1, bc1 = b.bbox
+    return not (
+        ar1 + pad < br0
+        or br1 + pad < ar0
+        or ac1 + pad < bc0
+        or bc1 + pad < ac0
+    )
