+def _build_grid(panel_size: int, slots: list[Slot], roles: dict) -> np.ndarray:
+    left = np.full((panel_size, panel_size), BACKGROUND, dtype=int)
+    right = np.full((panel_size, panel_size), BACKGROUND, dtype=int)
