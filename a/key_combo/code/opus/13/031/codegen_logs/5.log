+        return (self.r0, self.c0, self.r0 + self.h - 1, self.c0 + self.w - 1)
+
+    @property
+    def interior_area(self) -> int:
+        return (self.h - 2) * (self.w - 2)
+
+
+BACKGROUND = 0
+SEPARATOR = 5
+FRAME_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+PANEL_SIZE_RANGE = (11, 14)
