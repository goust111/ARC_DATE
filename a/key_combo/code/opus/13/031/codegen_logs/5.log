+    return comps
+
+
+def _find_frames(panel: np.ndarray, bg: int) -> list[Frame]:
+    frames: list[Frame] = []
+    for color in sorted(int(v) for v in np.unique(panel) if int(v) != bg):
+        for coords in _component_coords(panel == color):
+            r0 = int(coords[:, 0].min())
+            c0 = int(coords[:, 1].min())
+            r1 = int(coords[:, 0].max())
+            c1 = int(coords[:, 1].max())
