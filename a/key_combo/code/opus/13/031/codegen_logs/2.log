+    claimed_halo: set[Coord] = set()
+    for color, cells in copies.items():
+        halo_cells = _halo_cells_from_object(cells, grid_output.shape)
+        assert halo_cells.isdisjoint(template_cells)
+        assert halo_cells.isdisjoint(claimed_halo)
