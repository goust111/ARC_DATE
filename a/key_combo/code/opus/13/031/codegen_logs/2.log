+    out = g.copy()
+    for color, cells in completed.items():
+        for r, c in cells:
+            out[r, c] = color
+
+    halo_claimed: set[Coord] = set()
+    for color, cells in completed.items():
+        halo_color = mapping[color]
+        halo_cells = _halo_cells_from_object(cells, out.shape)
+        for r, c in halo_cells:
+            if out[r, c] != BG:
