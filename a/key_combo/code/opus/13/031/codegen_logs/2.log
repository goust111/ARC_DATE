+    if len({frozenset(cells) for cells in meta["copies"].values()}) != len(meta["copies"]):
+        return False
+
+    if len({tuple(sorted(cells)) for cells in meta["fragments"].values()}) != len(meta["fragments"]):
+        return False
+
+    if np.array_equal(grid_input, grid_output):
+        return False
