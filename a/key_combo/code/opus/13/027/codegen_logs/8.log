+
+    left_anchor_max = sep_col - inner_w - 2
+    right_anchor_min = sep_col + 2
+    right_anchor_max = width - inner_w - 1
+    if left_anchor_max < 2 or right_anchor_min > right_anchor_max:
+        return None
+
