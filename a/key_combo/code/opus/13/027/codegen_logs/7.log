+    corner = random.choice(LEGEND_CORNERS)
+    lr0, lc0 = _legend_origin(corner, h, w)
+    legend_colors = random.sample(list(LEGEND_COLORS), 4)
+    grid[lr0 : lr0 + 2, lc0 : lc0 + 2] = np.array(legend_colors, dtype=int).reshape(2, 2)
