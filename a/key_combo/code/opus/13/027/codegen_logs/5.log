# Canvas/scaffold geometry.
BACKGROUND_COLOR = 0
CELL_SIZE, CELL_STRIDE, TRUNCATED_CROP = 3, 4, 2
SEPARATOR_COUNT_RANGE, TRUNCATION_COIN_RANGE = (5, 8), (0, 2)
FORCE_FULL_SEP_COUNT, FORCE_TRUNCATED_SEP_COUNT = 5, 7
