COLOR_COUNT_RANGE = (2, 5)
NON_GRAY_PALETTE = np.array([1, 2, 3, 4, 6, 7, 8, 9], dtype=int)

# Placement and validation constraints.
BACKGROUND_COLOR, MARKER_COLOR = Color.BLACK, Color.GREY
