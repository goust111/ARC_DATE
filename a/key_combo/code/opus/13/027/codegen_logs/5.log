def _render_output(shape: tuple[int, int], sprite: np.ndarray, anchor: tuple[int, int], source: tuple[int, int], target: tuple[int, int]) -> np.ndarray:
    ar, ac = anchor
    target_patch = sprite.copy()
    target_patch[ar, ac] = BACKGROUND_COLOR
