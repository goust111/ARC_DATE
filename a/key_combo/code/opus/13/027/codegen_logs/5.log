NEIGHBOR_OFFSETS_4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
GENERATION_RETRIES = 300

SPRITE_SIZE_OPTIONS = tuple(
    (h, w, max(SPRITE_PIXEL_RANGE[0], (h * w + 1) // MIN_DENSITY_DIVISOR), min(SPRITE_PIXEL_RANGE[1], h * w))
