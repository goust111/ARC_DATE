    wall_rows_set = set(wall_rows)
    wall_cols_set = set(wall_cols)
    for i, rows in enumerate(row_bands):
        for j, cols in enumerate(col_bands):
            color = target[i][j]
            if _gen_chamber_has_marker(grid, rows, cols, color, wall_rows_set, wall_cols_set):
