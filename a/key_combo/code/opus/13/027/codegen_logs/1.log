    if i == 0:
        return 0
    if i == len(row_bands) - 1:
        return len(wall_rows) - 1
    matches = []
    if target[i - 1][j] == target[i][j]:
        matches.append(i)
    if target[i + 1][j] == target[i][j]:
        matches.append(i + 1)
    if not matches:
        return None
    return min(matches, key=lambda idx: (row_counts[wall_rows[idx]], random.random()))


