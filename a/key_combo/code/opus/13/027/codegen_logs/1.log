    flat = np.array(
        [Color.BLUE] * blue_count
        + [Color.ORANGE] * orange_count
        + [Color.TEAL] * teal_count,
        dtype=int,
    )
    np.random.shuffle(flat)
    inp = flat.reshape(rows, cols)

    expected = inp.copy()
    expected[expected == Color.ORANGE] = Color.GREY
    if not np.array_equal(main(inp), expected):
        return None
    return inp


