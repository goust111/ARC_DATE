+GEN_PANEL_COUNT_RANGE = (2, 4)
+GEN_PIXELS_PER_COLOR_RANGE = (1, 3)
+GEN_RETRY_LIMIT = 400
+GEN_COLLISION_PROBABILITY = 0.4
