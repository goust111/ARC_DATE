+BG = 0
+GREY = 5
+ORANGE = 7
+LEGEND_ROWS = 2
+PAINT_COLORS = [1, 2, 3, 4, 6, 8, 9]
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
