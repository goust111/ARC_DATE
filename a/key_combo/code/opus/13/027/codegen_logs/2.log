+
+def _u_mask(shape, direction):
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    if direction == "up":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif direction == "down":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif direction == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif direction == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(direction)
+    return mask
+
+
+def _parse_legend(grid):
+    top = grid[:LEGEND_ROWS]
+    h, w = top.shape
+    assert h == 2
+    mapping = {}
+    c = 0
