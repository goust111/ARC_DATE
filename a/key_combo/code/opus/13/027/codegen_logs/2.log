+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+ORANGE = 7
+LEGEND_ROWS = 2
+PAINT_COLORS = [1, 2, 3, 4, 6, 8, 9]
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GEN_RETRIES = 400
+
+
+def _neighbors4(r, c):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components4(mask):
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _bbox(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _u_mask(shape, direction):
+    h, w = shape
+    mask = np.zeros((h, w), dtype=bool)
+    if direction == "up":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[-1, :] = True
+    elif direction == "down":
+        mask[:, 0] = True
+        mask[:, -1] = True
+        mask[0, :] = True
+    elif direction == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif direction == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(direction)
+    return mask
+
+
+def _parse_legend(grid):
+    top = grid[:LEGEND_ROWS]
+    h, w = top.shape
+    assert h == 2
+    mapping = {}
+    c = 0
+    while c < w:
+        if np.all(top[:, c] == GREY):
+            c += 1
+            continue
+        if (
+            c + 1 < w
+            and top[0, c] == top[1, c]
+            and top[0, c + 1] == top[1, c + 1]
+            and int(top[0, c]) not in (BG, GREY, ORANGE)
