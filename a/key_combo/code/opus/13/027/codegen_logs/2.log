+        if np.all(top[:, c] == GREY):
+            c += 1
+            continue
+        if (
+            c + 1 < w
+            and top[0, c] == top[1, c]
+            and top[0, c + 1] == top[1, c + 1]
+            and int(top[0, c]) not in (BG, GREY, ORANGE)
+            and int(top[0, c + 1]) not in (BG, GREY, ORANGE)
