+    if r0 + h < H and np.all(grid[r0 + h, c0 : c0 + w] != bg):
+        return True
+    if c0 > 0 and np.all(grid[r0 : r0 + h, c0 - 1] != bg):
+        return True
+    if c0 + w < W and np.all(grid[r0 : r0 + h, c0 + w] != bg):
