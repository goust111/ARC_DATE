+    c1 = c0 + w - 1
+    pr, pc = parity
+    out = []
+    for r in range(r0, r1 + 1):
+        for c, side in ((c0 - 1, "L"), (c1 + 1, "R")):
+            if in_bounds(shape, r, c) and r % 2 == pr and c % 2 == pc:
+                out.append(((r, c), side))
+    for c in range(c0, c1 + 1):
+        for r, side in ((r0 - 1, "T"), (r1 + 1, "B")):
+            if in_bounds(shape, r, c) and r % 2 == pr and c % 2 == pc:
