+                    if _rect_can_extend(grid, bg, r0, c0, h, w):
+                        continue
+                    candidates.append((r0, c0, h, w))
+    candidates.sort(key=lambda box: box[2] * box[3], reverse=True)
+    chosen: list[Box] = []
+    occupied: set[Coord] = set()
+    for box in candidates:
+        cells = bbox_cells(box)
+        if cells & occupied:
+            continue
+        chosen.append(box)
+        occupied |= cells
+    return chosen
