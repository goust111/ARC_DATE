+def bfs_path(
+    start: Coord,
+    end: Coord,
+    shape: tuple[int, int],
+    blocked_nodes: set[Coord],
+    avoid_nodes: set[Coord],
+    special_nodes: set[Coord],
+    object_adj: set[Coord],
+    rng: np.random.Generator,
+) -> list[Coord] | None:
+    if start == end:
+        return [start]
+    q = deque([start])
+    parent = {start: None}
+    while q:
+        cur = q.popleft()
+        deltas = STEP2.copy()
+        rng.shuffle(deltas)
+        for dr, dc in deltas:
+            nr, nc = cur[0] + dr, cur[1] + dc
+            nxt = (nr, nc)
+            if nxt in parent or not in_bounds(shape, nr, nc):
+                continue
+            if nxt in blocked_nodes:
+                continue
+            if nxt in avoid_nodes and nxt not in special_nodes:
+                continue
+            if nxt in object_adj and nxt not in special_nodes:
+                continue
+            if (nr % 2, nc % 2) != (start[0] % 2, start[1] % 2):
+                continue
+            parent[nxt] = cur
+            if nxt == end:
+                path = [end]
+                while path[-1] != start:
+                    path.append(parent[path[-1]])
+                path.reverse()
+                return path
+            q.append(nxt)
+    return None
+
