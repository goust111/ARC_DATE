+def find_regions(grid: np.ndarray, bg: int) -> list[Box]:
+    H, W = grid.shape
+    candidates: list[Box] = []
+    for h in (5, 4):
+        for w in (5, 4):
+            for r0 in range(H - h + 1):
+                for c0 in range(W - w + 1):
+                    sub = grid[r0 : r0 + h, c0 : c0 + w]
+                    if np.any(sub == bg):
