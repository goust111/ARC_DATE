+
+Coord = tuple[int, int]
+Box = tuple[int, int, int, int]  # r0, c0, h, w
+
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+STEP2 = [(-2, 0), (2, 0), (0, -2), (0, 2)]
+NON_BG = tuple(range(1, 10))
+GEN_RETRIES = 500
