+def expand_same_color_separation(nodes: Iterable[Coord], shape: tuple[int, int]) -> set[Coord]:
+    out = set(nodes)
+    for r, c in list(nodes):
+        for dr, dc in STEP2:
+            nr, nc = r + dr, c + dc
+            if in_bounds(shape, nr, nc):
