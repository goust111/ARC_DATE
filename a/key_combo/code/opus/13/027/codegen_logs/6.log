+                    vals, counts = np.unique(sub, return_counts=True)
+                    if len(vals) != 2:
+                        continue
+                    minor = int(sub.size - counts.max())
+                    if minor < 2 or minor > 4:
+                        continue
+                    base, motif_mask = region_base_and_mask(sub)
+                    if not mask_connected(motif_mask):
