+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in STEP2:
+            nxt = (r + dr, c + dc)
+            if nxt in guide_nodes and nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
+    return seen
