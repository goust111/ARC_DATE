+
+    expected = _build_expected(grid, rows, cols, objects)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    if np.count_nonzero(actual == NEW) == 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRIES):
