+def _spec_pool(rows: list[int], cols: list[int]) -> list[tuple[str, int]]:
+    return [("h", row) for row in rows] + [("v", col) for col in cols]
+
+
+def _plan_objects(rng: np.random.Generator) -> list[dict]:
