+
+def _find_placement(
+    rng: np.random.Generator,
+    full_local: set[tuple[int, int]],
+    input_local: set[tuple[int, int]],
+    placed_full: list[set[tuple[int, int]]],
+    rows: list[int],
+    cols: list[int],
+    spec: tuple[str, int] | None,
+    h: int,
+    w: int,
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]] | None:
