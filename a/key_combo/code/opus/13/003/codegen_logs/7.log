+    plan = _plan_objects(rng)
+    touched_indices = [i for i, item in enumerate(plan) if item["needs_touch"]]
+    assigned_specs: list[tuple[str, int] | None] = [None] * len(plan)
+    distinct = min(len(specs), len(touched_indices), 2)
+    if distinct == 2:
