+def _valid_input(grid: np.ndarray, expected_shelves: int) -> bool:
+    shelf_mask = grid == SHELF
+    shelf_rows = np.flatnonzero(shelf_mask.any(axis=1))
+    if len(shelf_rows) != int(expected_shelves):
+        return False
+
+    for r in shelf_rows:
