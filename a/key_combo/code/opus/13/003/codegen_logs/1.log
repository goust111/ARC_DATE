+        if cols.size < 3 or cols.size > 6:
+            return False
+        if not np.array_equal(cols, np.arange(cols[0], cols[-1] + 1)):
+            return False
+
+    seen_rects: list[tuple[int, int, int, int]] = []
+    for color in COLORS:
