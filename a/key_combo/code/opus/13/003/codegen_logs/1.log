+        rect = (min(rows), min(cols), max(rows), max(cols))
+        if any(_boxes_overlap(rect, prev) for prev in seen_rects):
+            return False
+        seen_rects.append(rect)
+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return False
+    return True
+
