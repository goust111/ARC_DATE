+
+INPUT_SIZE = 4
+BACKGROUND = 0
+FOREGROUND = 3
+RAY_COLOR = 2
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
