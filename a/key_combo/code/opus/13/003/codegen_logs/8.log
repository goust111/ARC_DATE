+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _rectangles(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
