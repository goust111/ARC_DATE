+BG = 0
+TL_COLOR = 1
+TR_COLOR = 2
+BL_COLOR = 3
+BR_COLOR = 4
+RECT_COLOR = 5
+
+RAY_SPECS = (
+    ("TL", TL_COLOR, (0, 0), (1, 1)),
