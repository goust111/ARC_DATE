+RAY_SPECS = (
+    ("TL", TL_COLOR, (0, 0), (1, 1)),
+    ("TR", TR_COLOR, None, (1, -1)),
+    ("BL", BL_COLOR, None, (-1, 1)),
+    ("BR", BR_COLOR, None, (-1, -1)),
+)
