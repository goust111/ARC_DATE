+from __future__ import annotations
+
+import random
+from collections import deque
+from functools import lru_cache
+
+import numpy as np
+
+
+BG = 0
+TL_COLOR = 1
+TR_COLOR = 2
+BL_COLOR = 3
+BR_COLOR = 4
