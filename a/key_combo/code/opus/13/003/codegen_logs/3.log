+                missing = rng.choice(counts)
+                visible = options[missing]
+                rr = rng.randint(r0, r1 - side + 1)
+                cc = rng.randint(c0, c1 - side + 1)
+                objects.append(
+                    {
+                        "missing": missing,
+                        "visible_area": len(visible),
+                        "full_area": len(full_cells),
+                        "cells": {(rr + r, cc + c) for r, c in visible},
