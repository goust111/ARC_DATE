+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+OBSTACLE = 5
+DIR_COLORS = {
+    (-1, 0): 2,  # up -> red
+    (0, -1): 7,  # left -> orange
+    (0, 1): 6,   # right -> magenta
+    (1, 0): 8,   # down -> cyan
