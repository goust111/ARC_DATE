+
+
+def _stamp_cross(out: np.ndarray, inp: np.ndarray, marker: tuple[int, int], bg: int) -> None:
+    r, c = marker
+    for dr, dc in CARDINALS:
+        nr, nc = r + dr, c + dc
+        if in_bounds(inp.shape, nr, nc) and int(inp[nr, nc]) == bg:
