+        color = DIR_COLORS[direction]
+        out[seed] = color
+        _extend_from_seed(out, obstacle_only, seed, direction, color, bg, obstacle)
+
+    return out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _build_input_attempt()
+        if grid is not None:
+            return grid
