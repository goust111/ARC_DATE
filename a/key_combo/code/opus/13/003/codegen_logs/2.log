+
+    for marker in sorted(markers):
+        direction = dirs_by_marker[marker]
+        seed = (marker[0] + direction[0], marker[1] + direction[1])
+        color = DIR_COLORS[direction]
+        out[seed] = color
+        _extend_from_seed(out, obstacle_only, seed, direction, color, bg, obstacle)
