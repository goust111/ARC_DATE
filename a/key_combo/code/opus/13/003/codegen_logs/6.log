+def _sample_structure() -> tuple[np.ndarray, list[tuple[int, int, int, int]]] | None:
+    builders = [
+        _make_cross4,
+        lambda: _make_vsplit3(True),
+        lambda: _make_vsplit3(False),
+        lambda: _make_hsplit3(True),
+        lambda: _make_hsplit3(False),
