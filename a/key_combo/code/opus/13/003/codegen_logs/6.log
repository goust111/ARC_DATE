+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PALETTE = (BLUE, RED, GREEN, YELLOW)
+MAX_GENERATION_ATTEMPTS = 800
