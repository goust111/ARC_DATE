+def _outside_mask(grid: np.ndarray) -> np.ndarray:
+    """Flood all non-grey cells reachable from the border."""
+    h, w = grid.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    def seed(r: int, c: int) -> None:
+        if 0 <= r < h and 0 <= c < w and not outside[r, c] and grid[r, c] != GREY:
+            outside[r, c] = True
+            q.append((r, c))
+
+    for r in range(h):
+        seed(r, 0)
+        seed(r, w - 1)
+    for c in range(w):
+        seed(0, c)
+        seed(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and not outside[nr, nc] and grid[nr, nc] != GREY:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return outside
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components as coordinate arrays."""
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
