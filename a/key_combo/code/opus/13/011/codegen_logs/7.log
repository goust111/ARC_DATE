+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 500
+_GEN_CALL_INDEX = 0
