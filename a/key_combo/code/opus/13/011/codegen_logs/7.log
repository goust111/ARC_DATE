+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 500
+_GEN_CALL_INDEX = 0
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIRS4:
+        yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _endpoint_open_dirs(grid: np.ndarray) -> dict[tuple[int, int], tuple[int, int]]:
+    mask = grid == GREY
+    endpoints: dict[tuple[int, int], tuple[int, int]] = {}
+    for r, c in np.argwhere(mask):
+        rr, cc = int(r), int(c)
+        neigh = [(nr, nc) for nr, nc in _neighbors4(rr, cc) if _in_bounds(grid.shape, nr, nc) and mask[nr, nc]]
+        if len(neigh) != 1:
+            continue
+        nr, nc = neigh[0]
+        endpoints[(rr, cc)] = (rr - nr, cc - nc)
+    return endpoints
+
+
+def _nearest_visible_endpoint(grid: np.ndarray, marker: tuple[int, int], endpoints: dict[tuple[int, int], tuple[int, int]]) -> tuple[int, int]:
+    h, w = grid.shape
+    r0, c0 = marker
+    candidates: list[tuple[int, int, int]] = []
+    for dr, dc in DIRS4:
+        r, c = r0 + dr, c0 + dc
+        dist = 1
+        while 0 <= r < h and 0 <= c < w:
+            value = int(grid[r, c])
+            if value == BACKGROUND:
+                r += dr
+                c += dc
+                dist += 1
+                continue
+            if value == GREY and (r, c) in endpoints:
+                candidates.append((dist, r, c))
+            break
+    assert candidates, f"marker at {marker} must see a grey endpoint"
+    candidates.sort()
+    best_dist = candidates[0][0]
+    best = [pt for dist, *pt in candidates if dist == best_dist]
+    assert len(best) == 1, f"marker at {marker} must have a unique nearest endpoint"
+    return int(best[0][0]), int(best[0][1])
+
+
+def _facing_pair(p0: tuple[int, int], d0: tuple[int, int], p1: tuple[int, int], d1: tuple[int, int]) -> bool:
+    r0, c0 = p0
+    r1, c1 = p1
+    if r0 == r1 and c0 < c1:
+        return d0 == (0, 1) and d1 == (0, -1)
+    if r0 == r1 and c1 < c0:
+        return d0 == (0, -1) and d1 == (0, 1)
+    if c0 == c1 and r0 < r1:
+        return d0 == (1, 0) and d1 == (-1, 0)
+    if c0 == c1 and r1 < r0:
+        return d0 == (-1, 0) and d1 == (1, 0)
+    return False
+
+
+def _repair_grid(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int).copy()
+    original_endpoints = _endpoint_open_dirs(g)
+    for r, c in np.argwhere(g == RED):
+        marker = (int(r), int(c))
+        _nearest_visible_endpoint(g, marker, original_endpoints)
+        g[marker] = GREY
+
+    endpoints = _endpoint_open_dirs(g)
+    fill_cells: set[tuple[int, int]] = set()
+    items = sorted(endpoints.items())
+    for i, (p0, d0) in enumerate(items):
+        r0, c0 = p0
+        for p1, d1 in items[i + 1 :]:
+            r1, c1 = p1
+            if r0 != r1 and c0 != c1:
+                continue
+            if not _facing_pair(p0, d0, p1, d1):
+                continue
+            if r0 == r1:
+                left, right = sorted([c0, c1])
+                gap = right - left - 1
+                if not (1 <= gap <= 3):
+                    continue
+                if np.all(g[r0, left + 1 : right] == BACKGROUND):
+                    for c in range(left + 1, right):
+                        fill_cells.add((r0, c))
+            else:
+                top, bottom = sorted([r0, r1])
+                gap = bottom - top - 1
+                if not (1 <= gap <= 3):
+                    continue
+                if np.all(g[top + 1 : bottom, c0] == BACKGROUND):
+                    for r in range(top + 1, bottom):
+                        fill_cells.add((r, c0))
+    for r, c in fill_cells:
+        g[r, c] = GREY
+    return g
+
+
+def _ranked_components(grid: np.ndarray) -> list[np.ndarray]:
+    comps = _components(grid == GREY)
+    assert 3 <= len(comps) <= 6, "repaired grid must have 3 to 6 grey components"
+    areas = [int(len(comp)) for comp in comps]
+    assert len(set(areas)) == len(areas), "repaired component areas must be unique"
+    return sorted(comps, key=lambda comp: (int(len(comp)), _bbox(comp)[0], _bbox(comp)[1]))
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Repair the broken grey line network and recolor each repaired component by ascending area rank.
+
+    Input structure:
+    - The input is a black background grid containing one-pixel-wide grey horizontal/vertical line fragments.
+    - Red singleton markers lie on the same row or column as a visible grey endpoint and indicate which fragment should be extended.
+    - The grey fragments may already include turns, but every repair action happens along straight row or column gaps.
+
+    Rule:
+    - Recolor each red marker to grey after assigning it to its unique nearest visible grey endpoint.
+    - On the repaired grey mask, find every pair of grey endpoints in one row or one column that face each other across an all-black gap of length 1 to 3, and fill that gap with grey.
+    - Compute the 4-connected grey components after all repairs, sort them by area from small to large, and break ties by the top-left component bbox corner.
+    - Recolor the ranked components with the repeating palette green, red, blue.
+
+    Key insight:
+    - The red markers do not just add pixels: they move endpoints outward, which can enable short facing-gap repairs that merge fragments and completely change the component-area ranking used for the final colors.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert max(g.shape) <= 30, "ARC grids must stay within 30x30"
+    assert set(map(int, np.unique(g))).issubset({BACKGROUND, BLUE, RED, GREEN, GREY}), "unexpected colors"
+
+    repaired = _repair_grid(g)
+    ranked = _ranked_components(repaired)
+    palette = [GREEN, RED, BLUE]
+
+    out = np.zeros_like(repaired)
+    for rank, comp in enumerate(ranked):
+        color = palette[rank % len(palette)]
+        out[comp[:, 0], comp[:, 1]] = color
+    return out
+
+
+def _normalize_path(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    min_r = min(r for r, _ in path)
+    min_c = min(c for _, c in path)
+    return [(r - min_r, c - min_c) for r, c in path]
+
+
+def _path_is_simple(path: list[tuple[int, int]]) -> bool:
+    cells = set(path)
+    if len(cells) != len(path):
+        return False
+    degs: dict[tuple[int, int], int] = {cell: 0 for cell in cells}
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells:
+                degs[(r, c)] += 1
+    degrees = list(degs.values())
+    return max(degrees) <= 2 and degrees.count(1) == 2 and degrees.count(0) == 0
+
+
+def _partition_sum(total: int, parts: int, lo: int, hi: int, rng: random.Random) -> list[int] | None:
+    for _ in range(100):
+        vals = []
+        remain = total
+        for i in range(parts):
+            left = parts - i - 1
+            vmin = max(lo, remain - hi * left)
+            vmax = min(hi, remain - lo * left)
+            if vmin > vmax:
+                break
+            val = rng.randint(vmin, vmax)
+            vals.append(val)
+            remain -= val
+        if len(vals) == parts and remain == 0:
+            return vals
+    return None
+
+
+def _build_relative_path(area: int, rng: random.Random, force_turn: bool) -> tuple[list[tuple[int, int]], list[tuple[int, int]]] | None:
+    segment_choices = [2, 3] if force_turn else [1, 2, 3]
+    rng.shuffle(segment_choices)
+    for segments in segment_choices:
+        lengths = _partition_sum(area - 1, segments, 2, 6, rng)
+        if lengths is None:
+            continue
+        first_dir = rng.choice(DIRS4)
+        dirs = [first_dir]
+        for _ in range(1, segments):
+            dr, dc = dirs[-1]
+            dirs.append(rng.choice([(dc, dr), (-dc, -dr)]))
+        path = [(0, 0)]
+        r = c = 0
+        for length, (dr, dc) in zip(lengths, dirs):
+            for _ in range(length):
+                r += dr
+                c += dc
+                path.append((r, c))
+        path = _normalize_path(path)
+        if _path_is_simple(path):
+            return path, dirs
+    return None
+
+
+def _path_bbox(path: list[tuple[int, int]]) -> tuple[int, int]:
+    rows = [r for r, _ in path]
+    cols = [c for _, c in path]
+    return max(rows) + 1, max(cols) + 1
+
+
+def _can_place(path: list[tuple[int, int]], offset: tuple[int, int], blocked: np.ndarray) -> bool:
+    off_r, off_c = offset
+    h, w = blocked.shape
+    for r, c in path:
+        rr, cc = r + off_r, c + off_c
+        if not (0 <= rr < h and 0 <= cc < w) or blocked[rr, cc]:
+            return False
+    return True
+
+
+def _mark_blocked(blocked: np.ndarray, path: list[tuple[int, int]], offset: tuple[int, int]) -> None:
+    off_r, off_c = offset
+    h, w = blocked.shape
+    for r, c in path:
+        rr, cc = r + off_r, c + off_c
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr, nc = rr + dr, cc + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    blocked[nr, nc] = True
+
+
+def _place_paths(shape: tuple[int, int], specs: list[tuple[int, bool]], rng: random.Random) -> list[list[tuple[int, int]]] | None:
+    h, w = shape
+    blocked = np.zeros((h, w), dtype=bool)
+    placed: list[list[tuple[int, int]]] = []
+    for area, force_turn in specs:
+        placed_one = False
+        for _ in range(120):
+            built = _build_relative_path(area, rng, force_turn)
+            if built is None:
+                continue
+            rel_path, _dirs = built
+            ph, pw = _path_bbox(rel_path)
+            if ph > h or pw > w:
+                continue
+            off_r = rng.randint(0, h - ph)
+            off_c = rng.randint(0, w - pw)
+            if not _can_place(rel_path, (off_r, off_c), blocked):
+                continue
+            path = [(r + off_r, c + off_c) for r, c in rel_path]
+            _mark_blocked(blocked, rel_path, (off_r, off_c))
+            placed.append(path)
+            placed_one = True
+            break
+        if not placed_one:
+            return None
+    return placed
+
+
+def _break_candidates(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    dirs = [
+        (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        for i in range(len(path) - 1)
+    ]
+    candidates: list[tuple[int, int]] = []
+    n = len(path)
+    for gap_black in (1, 2, 3):
+        removed_len = gap_black + 1
+        for a in range(2, n - removed_len - 1):
+            b = a + removed_len - 1
+            if n - (b + 1) < 2:
+                continue
+            segment_dirs = dirs[a - 1 : b + 1]
+            if len(segment_dirs) == removed_len + 1 and len(set(segment_dirs)) == 1:
+                candidates.append((a, removed_len))
+    return candidates
+
+
+def _apply_break(path: list[tuple[int, int]], start: int, removed_len: int, use_left_marker: bool) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    removed = path[start : start + removed_len]
+    marker = removed[0] if use_left_marker else removed[-1]
+    cells = set(path)
+    for pt in removed:
+        cells.remove(pt)
+    cells.add(marker)
+    return cells, marker
+
+
+def _build_input_grid(shape: tuple[int, int], paths: list[list[tuple[int, int]]], forced_gap: int, rng: random.Random) -> np.ndarray | None:
+    grid = np.zeros(shape, dtype=int)
+    markers: list[tuple[int, int]] = []
+    all_grey: set[tuple[int, int]] = set()
+    first_component = True
+    for path in paths:
+        candidates = _break_candidates(path)
+        if not candidates:
+            return None
+        preferred = [cand for cand in candidates if cand[1] == forced_gap + 1] if first_component else []
+        start, removed_len = rng.choice(preferred or candidates)
+        use_left_marker = bool(rng.randint(0, 1))
+        kept_cells, marker = _apply_break(path, start, removed_len, use_left_marker)
+        all_grey |= kept_cells - {marker}
+        markers.append(marker)
+        first_component = False
+
+    for r, c in all_grey:
+        grid[r, c] = GREY
+    for r, c in markers:
+        if grid[r, c] != BACKGROUND:
+            return None
+        grid[r, c] = RED
+    return grid
+
+
+def _expected_repaired(paths: list[list[tuple[int, int]]], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for path in paths:
+        for r, c in path:
+            grid[r, c] = GREY
+    return grid
+
+
+def _valid_marker_assignments(grid: np.ndarray) -> bool:
+    endpoints = _endpoint_open_dirs(np.where(grid == GREY, GREY, BACKGROUND))
+    try:
+        for r, c in np.argwhere(grid == RED):
+            _nearest_visible_endpoint(grid, (int(r), int(c)), endpoints)
+    except AssertionError:
+        return False
+    return True
+
+
+def _generate_attempt(rng: random.Random, count: int, forced_gap: int, force_turn: bool) -> np.ndarray | None:
+    h = rng.randint(13, 18)
+    w = rng.randint(13, 18)
+    max_area = min(16, max(h, w) + 1)
+    area_pool = list(range(6, max_area + 1))
+    if len(area_pool) < count:
+        return None
+    areas = sorted(rng.sample(area_pool, count))
+    specs = [(area, force_turn and i == 0) for i, area in enumerate(areas)]
+    paths = _place_paths((h, w), specs, rng)
+    if paths is None:
+        return None
+
+    inp = _build_input_grid((h, w), paths, forced_gap, rng)
+    if inp is None:
+        return None
+    if not _valid_marker_assignments(inp):
+        return None
+
+    repaired = _repair_grid(inp)
+    expected = _expected_repaired(paths, (h, w))
+    if not np.array_equal(repaired, expected):
+        return None
+    ranked = _ranked_components(repaired)
+    if len(ranked) != count:
+        return None
+    if np.array_equal(main(inp), inp):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_CALL_INDEX
+    _GEN_CALL_INDEX += 1
+
+    count = 3 + ((_GEN_CALL_INDEX - 1) % 4)
+    forced_gap = 1 + ((_GEN_CALL_INDEX - 1) % 3)
+    force_turn = (_GEN_CALL_INDEX % 2) == 0
+
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt(rng, count, forced_gap, force_turn)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 7")

