   362	    return grid
   363	
   364	
   365	def _expected_repaired(paths: list[list[tuple[int, int]]], shape: tuple[int, int]) -> np.ndarray:
   366	    grid = np.zeros(shape, dtype=int)
   367	    for path in paths:
   368	        for r, c in path:
   369	            grid[r, c] = GREY
   370	    return grid
