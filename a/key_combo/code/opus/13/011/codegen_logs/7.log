+def _break_candidates(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    dirs = [
+        (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
+        for i in range(len(path) - 1)
+    ]
+    candidates: list[tuple[int, int]] = []
+    n = len(path)
+    for gap_black in (1, 2, 3):
+        removed_len = gap_black + 1
+        for a in range(2, n - removed_len - 1):
+            b = a + removed_len - 1
+            if n - (b + 1) < 2:
+                continue
+            segment_dirs = dirs[a - 1 : b + 1]
+            if len(segment_dirs) == removed_len + 1 and len(set(segment_dirs)) == 1:
+                candidates.append((a, removed_len))
+    return candidates
