+
+def _apply_break(path: list[tuple[int, int]], start: int, removed_len: int, use_left_marker: bool) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    removed = path[start : start + removed_len]
+    marker = removed[0] if use_left_marker else removed[-1]
+    cells = set(path)
+    for pt in removed:
+        cells.remove(pt)
+    cells.add(marker)
+    return cells, marker
+
+
+def _build_input_grid(shape: tuple[int, int], paths: list[list[tuple[int, int]]], forced_gap: int, rng: random.Random) -> np.ndarray | None:
+    grid = np.zeros(shape, dtype=int)
+    markers: list[tuple[int, int]] = []
+    all_grey: set[tuple[int, int]] = set()
+    first_component = True
+    for path in paths:
