+    for dr, dc in DIRS4:
+        r, c = r0 + dr, c0 + dc
+        dist = 1
+        while 0 <= r < h and 0 <= c < w:
+            value = int(grid[r, c])
+            if value == BACKGROUND:
+                r += dr
+                c += dc
+                dist += 1
+                continue
