   260	def _can_place(path: list[tuple[int, int]], offset: tuple[int, int], blocked: np.ndarray) -> bool:
   261	    off_r, off_c = offset
   262	    h, w = blocked.shape
   263	    for r, c in path:
   264	        rr, cc = r + off_r, c + off_c
   265	        if not (0 <= rr < h and 0 <= cc < w) or blocked[rr, cc]:
   266	            return False
   267	    return True
   268	
   269	
   270	def _mark_blocked(blocked: np.ndarray, path: list[tuple[int, int]], offset: tuple[int, int]) -> None:
   271	    off_r, off_c = offset
   272	    h, w = blocked.shape
   273	    for r, c in path:
   274	        rr, cc = r + off_r, c + off_c
   275	        for dr in (-1, 0, 1):
   276	            for dc in (-1, 0, 1):
   277	                nr, nc = rr + dr, cc + dc
   278	                if 0 <= nr < h and 0 <= nc < w:
   279	                    blocked[nr, nc] = True
   280	
   281	
   282	def _place_paths(shape: tuple[int, int], specs: list[tuple[int, bool]], rng: random.Random) -> list[list[tuple[int, int]]] | None:
   283	    h, w = shape
   284	    blocked = np.zeros((h, w), dtype=bool)
   285	    placed: list[list[tuple[int, int]]] = []
   286	    for area, force_turn in specs:
   287	        placed_one = False
   288	        for _ in range(120):
   289	            built = _build_relative_path(area, rng, force_turn)
   290	            if built is None:
   291	                continue
   292	            rel_path, _dirs = built
   293	            ph, pw = _path_bbox(rel_path)
   294	            if ph > h or pw > w:
   295	                continue
   296	            off_r = rng.randint(0, h - ph)
   297	            off_c = rng.randint(0, w - pw)
   298	            if not _can_place(rel_path, (off_r, off_c), blocked):
   299	                continue
   300	            path = [(r + off_r, c + off_c) for r, c in rel_path]
   301	            _mark_blocked(blocked, rel_path, (off_r, off_c))
   302	            placed.append(path)
   303	            placed_one = True
   304	            break
   305	        if not placed_one:
   306	            return None
   307	    return placed
   308	
   309	
   310	def _break_candidates(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
   311	    dirs = [
   312	        (path[i + 1][0] - path[i][0], path[i + 1][1] - path[i][1])
   313	        for i in range(len(path) - 1)
   314	    ]
   315	    candidates: list[tuple[int, int]] = []
   316	    n = len(path)
   317	    for gap_black in (1, 2, 3):
   318	        removed_len = gap_black + 1
   319	        for a in range(2, n - removed_len - 1):
   320	            b = a + removed_len - 1
   321	            if n - (b + 1) < 2:
   322	                continue
   323	            segment_dirs = dirs[a - 1 : b + 1]
   324	            if len(segment_dirs) == removed_len + 1 and len(set(segment_dirs)) == 1:
   325	                candidates.append((a, removed_len))
   326	    return candidates
   327	
   328	
   329	def _apply_break(path: list[tuple[int, int]], start: int, removed_len: int, use_left_marker: bool) -> tuple[set[tuple[int, int]], tuple[int, int]]:
   330	    removed = path[start : start + removed_len]
   331	    marker = removed[0] if use_left_marker else removed[-1]
   332	    cells = set(path)
   333	    for pt in removed:
   334	        cells.remove(pt)
   335	    cells.add(marker)
   336	    return cells, marker
   337	
   338	
   339	def _build_input_grid(shape: tuple[int, int], paths: list[list[tuple[int, int]]], forced_gap: int, rng: random.Random) -> np.ndarray | None:
   340	    grid = np.zeros(shape, dtype=int)
   341	    markers: list[tuple[int, int]] = []
   342	    all_grey: set[tuple[int, int]] = set()
   343	    first_component = True
   344	    for path in paths:
   345	        candidates = _break_candidates(path)
   346	        if not candidates:
   347	            return None
   348	        preferred = [cand for cand in candidates if cand[1] == forced_gap + 1] if first_component else []
   349	        start, removed_len = rng.choice(preferred or candidates)
   350	        use_left_marker = bool(rng.randint(0, 1))
   351	        kept_cells, marker = _apply_break(path, start, removed_len, use_left_marker)
   352	        all_grey |= kept_cells - {marker}
   353	        markers.append(marker)
   354	        first_component = False
   355	
   356	    for r, c in all_grey:
   357	        grid[r, c] = GREY
   358	    for r, c in markers:
   359	        if grid[r, c] != BACKGROUND:
   360	            return None
