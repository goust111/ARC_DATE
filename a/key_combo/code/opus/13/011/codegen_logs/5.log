+    elif side == "right":
+        mask[r0 : r1 + 1, c0 : c1 + rect_w] = True
+    elif side == "top":
+        mask[r0 - (rect_h - 1) : r1 + 1, c0 : c1 + 1] = True
+    else:
+        assert side == "bottom"
+        mask[r0 : r1 + rect_h, c0 : c1 + 1] = True
+    return mask
+
