+    if r0 <= r <= r1 and c == c0 - 1:
+        hits.append("left")
+    if r0 <= r <= r1 and c == c1 + 1:
+        hits.append("right")
+    if c0 <= c <= c1 and r == r0 - 1:
+        hits.append("top")
+    if c0 <= c <= c1 and r == r1 + 1:
+        hits.append("bottom")
+    assert len(hits) == 1, "red marker must indicate exactly one rectangle side"
+    return hits[0]
