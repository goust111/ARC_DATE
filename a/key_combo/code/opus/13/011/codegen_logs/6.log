+GRIDLINE = 6
+BG = 0
+STRIPE_COLORS = (1, 2, 3, 4)
+BASE_COLORS = (5, 7, 8, 9)
+GEN_ATTEMPTS = 500
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
