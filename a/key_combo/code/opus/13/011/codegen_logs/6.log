+
+
+def _make_base_pattern(cell_h: int, cell_w: int, forbidden_row: int, color: int) -> np.ndarray | None:
+    allowed = [(r, c) for r in range(cell_h) for c in range(cell_w) if r != forbidden_row]
+    if len(allowed) < 3:
