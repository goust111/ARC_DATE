    control_col = int(top_cols[0])
    assert control_col in (0, mw - 1), "marker control pixel must be on a horizontal end"

    if control_col == 0:
        dst_c0 = sc0 - sw
    else:
        dst_c0 = sc1 + 1
    dst_c1 = dst_c0 + sw - 1
    assert 0 <= dst_c0 and dst_c1 < g.shape[1], "destination block must be in bounds"

