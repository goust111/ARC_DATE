+
+BLACK = 0
+BLUE = 1
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+PAIR_COLORS = (BLUE, GREEN, YELLOW, PINK)
+GENERATION_RETRIES = 400
