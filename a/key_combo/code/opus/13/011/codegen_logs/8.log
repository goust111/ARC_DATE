+    bottom = top + size - 1
+    right = left + size - 1
+    grid[top, left : right + 1] = color
+    grid[bottom, left : right + 1] = color
+    grid[top : bottom + 1, left] = color
+    grid[top : bottom + 1, right] = color
+
+
+def _square_border_cells(top: int, left: int, size: int) -> set[tuple[int, int]]:
+    bottom = top + size - 1
+    right = left + size - 1
