+
+
+def _attempt_generate(rng: random.Random) -> np.ndarray | None:
+    sampled = _sample_frames(rng)
+    if sampled is None:
+        return None
+    h, w, frames = sampled
+    base, _order = _render_visible_grid(h, w, frames, rng)
