+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+NOISE = 7
+FRAME_COLORS = (1, 3, 4, 6)
+
+GRID_MIN = 15
+GRID_MAX = 20
+FRAME_COUNT_OPTIONS = (3, 4)
+FRAME_SIZE_MIN = 4
+FRAME_SIZE_MAX = 12
+JITTER_OPTIONS = (-2, -1, 0, 1, 2)
+GENERATION_ATTEMPTS = 600
