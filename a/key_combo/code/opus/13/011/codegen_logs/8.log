+    tie_breakers = []
+    for color in tied:
+        rows = [nr for col, nr, _nc in support if col == color]
+        cols = [nc for col, nr, nc in support if col == color and nr == min(rows)]
+        tie_breakers.append((min(rows), min(cols), color))
+    tie_breakers.sort()
+    return tie_breakers[0][2]
