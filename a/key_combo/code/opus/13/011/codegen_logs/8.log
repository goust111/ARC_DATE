0013: def main(input_grid):
0014:     """
0015:     Remove noise pixels from colored rectangles, restoring attached noise to rectangle color when needed.
0016: 
0017:     Input structure:
0018:     - The input is a black grid with large same-colored rectangles.
0019:     - A different noise color appears as small objects on or away from the rectangles.
0020:     - Noise that touches a rectangle strongly represents an occluded rectangle cell.
0021: 
0022:     Rule:
0023:     - Split objects into small noise objects and larger rectangle objects.
0024:     - For each noise object, count its 4-neighbor contact with each rectangle.
0025:     - Recolor noise to the rectangle color if it has at least two rectangle neighbors; otherwise delete it.
0026: 
0027:     Key insight:
0028:     - Neighbor support distinguishes rectangle-covered noise from background noise.
0029:     """
0030:     # Plan:
0031:     # 1. Extract and classify the objects (rectangles, noise pixels)
0032:     # 2. If a noise pixel is significantly touching a rectangle (it has at least 2 neighbors that are part of the rectangle), then the noise reveals the rectangle color
0033:     # 3. Otherwise, the noise reveals the background, so delete the noise pixel
0034: 
0035:     objects = find_components(input_grid, bg=Color.BLACK, monochromatic=True, connectivity=4, return_format="objects")
0036:     rectangle_size_threshold = 4
0037:     noisy_objects = [ obj for obj in objects if np.sum(obj != Color.BLACK) < rectangle_size_threshold ]
0038:     rectangle_objects = [ obj for obj in objects if np.sum(obj != Color.BLACK) >= rectangle_size_threshold ]
0039: 
