+        valid_offsets = []
+        for dr in JITTER_OPTIONS:
+            for dc in JITTER_OPTIONS:
+                top = ideal_top + dr
+                left = ideal_left + dc
+                if 0 <= top and 0 <= left and top + size <= h and left + size <= w:
