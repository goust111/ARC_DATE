+    expected_sizes = _intended_sizes(frames)
+    colors = [int(frame["color"]) for frame in frames]
+    if _sizes_by_color(base, colors) != expected_sizes:
+        return None
+
+    critical = _find_critical_noise_sets(base, frames)
+    if not critical:
