0042:         noise_object_mask = noise_object != Color.BLACK
0043:         noise_neighbors_mask = object_neighbors(noise_object, connectivity=4, background=Color.BLACK)
0044: 
0045:         for rectangle_object in rectangle_objects:
0046:             # Check if the noise object has at least 2 neighbors that are part of this rectangle
0047:             rectangle_object_mask = rectangle_object != Color.BLACK
0048:             if np.sum(noise_neighbors_mask & rectangle_object_mask) >= 2:
0049:                 rectangle_color = int(np.argmax(np.bincount(rectangle_object[rectangle_object_mask].astype(int))))
0050:                 output_grid[noise_object_mask] = rectangle_color
0051:                 break
0052:         else:
0053:             # Delete this noise object
0054:             output_grid[noise_object_mask] = Color.BLACK
0055: 
