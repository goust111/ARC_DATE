+
+
+def _touches_existing_noise(cells: set[tuple[int, int]], chosen: set[tuple[int, int]]) -> bool:
+    for r, c in cells:
+        if (r, c) in chosen:
+            return True
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in chosen and (nr, nc) not in cells:
