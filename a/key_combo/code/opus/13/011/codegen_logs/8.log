+
+
+def _find_safe_singletons(
+    base: np.ndarray,
+    frames: list[dict[str, object]],
+    chosen_noise: set[tuple[int, int]],
+    target_outcomes: set[int],
+) -> list[tuple[int, int]]:
+    candidates: list[tuple[int, int]] = []
