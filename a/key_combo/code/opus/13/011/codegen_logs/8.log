+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+NOISE = 7
+FRAME_COLORS = (1, 3, 4, 6)
+
+GRID_MIN = 15
+GRID_MAX = 20
+FRAME_COUNT_OPTIONS = (3, 4)
+FRAME_SIZE_MIN = 4
+FRAME_SIZE_MAX = 12
+JITTER_OPTIONS = (-2, -1, 0, 1, 2)
+GENERATION_ATTEMPTS = 600
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _component_coords(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(comp)
+    return components
+
+
+def _bbox_for_color(grid: np.ndarray, color: int) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(grid == color)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bbox_size(grid: np.ndarray, color: int) -> int:
+    box = _bbox_for_color(grid, color)
+    if box is None:
+        return 0
+    r0, c0, r1, c1 = box
+    return max(r1 - r0 + 1, c1 - c0 + 1)
+
+
+def _draw_square_border(grid: np.ndarray, top: int, left: int, size: int, color: int) -> None:
+    bottom = top + size - 1
+    right = left + size - 1
+    grid[top, left : right + 1] = color
+    grid[bottom, left : right + 1] = color
+    grid[top : bottom + 1, left] = color
+    grid[top : bottom + 1, right] = color
+
+
+def _square_border_cells(top: int, left: int, size: int) -> set[tuple[int, int]]:
+    bottom = top + size - 1
+    right = left + size - 1
+    cells: set[tuple[int, int]] = set()
+    for c in range(left, right + 1):
+        cells.add((top, c))
+        cells.add((bottom, c))
+    for r in range(top, bottom + 1):
+        cells.add((r, left))
