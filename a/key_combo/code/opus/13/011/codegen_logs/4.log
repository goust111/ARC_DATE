+    dc = int(target_anchor[1]) - anchor_c
+    if {(r + dr, c + dc) for r, c in variant_skeleton} != target_skeleton:
+        return None
+    cells = [
+        (int(r + dr), int(c + dc), int(variant[r, c]))
+        for r, c in np.argwhere(np.isin(variant, MARKER_COLORS))
+    ]
+    return tuple(sorted(cells))
