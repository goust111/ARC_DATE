+                continue
+            color = int(grid[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbor_fn(rr, cc):
+                    if not (0 <= nr < h and 0 <= nc < w) or seen[nr, nc]:
