+    out = g.copy()
+    anchors: list[tuple[int, int]] = []
+    for idx, comp in enumerate(comps):
+        anchor_cells = [(int(r), int(c)) for r, c in comp["coords"] if int(g[int(r), int(c)]) == ANCHOR]
