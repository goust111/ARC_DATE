+        anchor_cells = [(int(r), int(c)) for r, c in comp["coords"] if int(g[int(r), int(c)]) == ANCHOR]
+        assert len(anchor_cells) == 1, "each motif must contain exactly one blue anchor"
+        anchor = anchor_cells[0]
+        anchors.append(anchor)
