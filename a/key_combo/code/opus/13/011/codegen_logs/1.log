+def _paste_patch(grid: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    mask = patch != BG
+    target = grid[top : top + patch.shape[0], left : left + patch.shape[1]]
+    target[mask] = patch[mask]
+
+
+def _choose_sides(count: int) -> list[int]:
