        edges = {(cluster[0], cluster[1]), (cluster[1], cluster[2])}
    else:
        cluster = random.sample(pool, 3)
        edges = {(cluster[0], cluster[1]), (cluster[0], cluster[2]), (cluster[1], cluster[2])}
    return cluster, {tuple(sorted(edge)) for edge in edges}


