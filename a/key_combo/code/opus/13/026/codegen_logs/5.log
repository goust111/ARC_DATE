    r0, c0, r1, c1 = bbox_coords(coords_arr)
    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
    shifted = coords_arr - np.array([r0, c0])
    patch[shifted[:, 0], shifted[:, 1]] = Color.BLUE
    return patch


def _gen_make_tree_patch(size, max_h, max_w):
