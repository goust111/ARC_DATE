    while len(coords) < size:
        frontier = set()
        for r, c in coords:
            for dr, dc in _GEN_DIRS4:
                nb = (r + dr, c + dc)
                if nb in coords:
                    continue
                neighbor_count = 0
                for nr, nc in ((nb[0] + ddr, nb[1] + ddc) for ddr, ddc in _GEN_DIRS4):
                    if (nr, nc) in coords:
                        neighbor_count += 1
                if neighbor_count == 1 and _gen_bbox_dims(coords | {nb}) <= (max_h, max_w):
                    frontier.add(nb)
        if not frontier:
            return None
        coords.add(_gen_choice(list(frontier)))
