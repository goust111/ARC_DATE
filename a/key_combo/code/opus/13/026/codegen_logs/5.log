    # Validate: no overlap with existing rects (with 1-cell margin)
    gap = RECT_MARGIN_GAP
    for pr0, pc0, pr1, pc1 in placed_rects:
        if (rect_r0 <= pr1 + gap and pr0 <= rect_r1 + gap and
                rect_c0 <= pc1 + gap and pc0 <= rect_c1 + gap):
