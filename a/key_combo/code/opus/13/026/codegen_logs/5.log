    inp[affected] = bg
    axis_mask = np.zeros((H, W), dtype=bool)
    if orient == "vertical":
        inp[:, axis] = sep
        axis_mask[:, axis] = True
        side_masks = (np.tile(np.arange(W) < axis, (H, 1)), np.tile(np.arange(W) > axis, (H, 1)))
    else:
        inp[axis, :] = sep
        axis_mask[axis, :] = True
        side_masks = (
            np.tile((np.arange(H) < axis)[:, None], (1, W)),
            np.tile((np.arange(H) > axis)[:, None], (1, W)),
        )
    allowed = ~(axis_mask | source_mask)
