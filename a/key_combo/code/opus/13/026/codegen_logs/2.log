    sprite = np.full(mask.shape, BACKGROUND_COLOR, dtype=int)
    sprite[mask] = int(color)
    return sprite


def _gen_mark_half_path(half: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:
    r, c = a
    tr, tc = b
    half[r, c] = True
    while (r, c) != (tr, tc):
