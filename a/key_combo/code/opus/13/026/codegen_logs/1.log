+            return None
+        grid[r0 : r0 + fh, c0 : c0 + fw] = patch
+        if marker_count % 4 != 0:
+            changed_turns += 1
+
+    if changed_turns == 0:
+        return None
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

