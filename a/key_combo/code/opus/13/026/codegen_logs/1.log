+    cc1 = min(reserved.shape[1], c0 + w + 1)
+    return not reserved[rr0:rr1, cc0:cc1].any()
+
+
+def _frame_positions(height: int, width: int, frame_sizes: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
