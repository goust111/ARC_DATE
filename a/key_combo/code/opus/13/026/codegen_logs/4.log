+    search[wall_row, :] = GREY
+
+    wall_col = rng.randint(3, w - 4)
+    upper_branch = rng.random() < 0.5
+    span0, span1 = (0, wall_row) if upper_branch else (wall_row + 1, h)
+    span = span1 - span0
+    if span < 3:
+        return None
+
+    if rng.random() < 0.45:
+        seg_len = span
+    else:
