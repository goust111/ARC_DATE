我已经把生成器收敛到一个更稳的结构化方案：用 18~25 个灰色“墙段”把搜索区切成几块黑色腔室，再用求解器反验，只接受方块分组数和每组计数都合规的样例。先跑一次命中率，确认自检时不会超时。
exec
/bin/bash -lc "python - <<'PY'
import random, numpy as np
from collections import Counter
BLACK=0; GREY=5

def rect_sum(pref,r0,c0,r1,c1):
    total=int(pref[r1,c1])
    if r0: total-=int(pref[r0-1,c1])
    if c0: total-=int(pref[r1,c0-1])
    if r0 and c0: total+=int(pref[r0-1,c0-1])
    return total

def groups(search):
    h,w=search.shape
    pref=np.cumsum(np.cumsum((search"'!=BLACK).astype(np.int16),0),1)
    occ=np.zeros((h,w),dtype=bool)
    gs={}
    for s in range(min(h,w),1,-1):
        for r in range(h-s+1):
            for c in range(w-s+1):
                if occ[r:r+s,c:c+s].any():
                    continue
                if rect_sum(pref,r,c,r+s-1,c+s-1):
                    continue
                gs.setdefault(s,[]).append((r,c,s))
                occ[r:r+s,c:c+s]=True
    return gs

def add_seg(g, orient, fixed, start, length):
    before=int(np.count_nonzero(g==GREY))
    if orient=='"'h': g[fixed, start:start+length]=GREY
    else: g[start:start+length, fixed]=GREY
    return int(np.count_nonzero(g==GREY))-before

def attempt(rng):
    h=rng.randint(13,18); w=rng.randint(15,19)
    g=np.zeros((h,w),dtype=int)
    wall_row=rng.randint(3,h-4)
    g[wall_row,:]=GREY
    obs=int(np.count_nonzero(g==GREY))
    wall_col=rng.randint(3,w-4)
    top=rng.random()<0.5
    span0,span1=(0,wall_row) if top else (wall_row+1,h)
    span=span1-span0
    full=rng.random()<0.45
    seg_len=span if full else rng.randint(max(3, span//2), min(span, 6))
    start=rng.randint(span0, span1-seg_len)
    obs += add_seg(g,'v',wall_col,start,seg_len)
    if rng.random()<0.8:
        rem=25-obs
        if rem>=3:
            if rng.random()<0.5:
                # short horizontal in one chamber
                row_choices=[r for r in range(h) if r"'!=wall_row]
                rr=rng.choice(row_choices)
                seg_len=rng.randint(3,min(6,rem,w))
                cc=rng.randint(0,w-seg_len)
                obs += add_seg(g,'"'h',rr,cc,seg_len)
            else:
                col_choices=[c for c in range(w) if c"'!=wall_col]
                cc=rng.choice(col_choices)
                seg_len=rng.randint(3,min(6,rem,h))
                rr=rng.randint(0,h-seg_len)
                obs += add_seg(g,'"'v',cc,rr,seg_len)
    if not (15<=obs<=25):
        return None
    gs=groups(g)
    sides=sorted(gs, reverse=True)
    counts=[len(gs[s]) for s in sides]
    if not (3<=len(sides)<=5):
        return None
    if not all(1<=k<=4 for k in counts):
        return None
    if max(counts)<2:
        return None
    if sides[0]>10:
        return None
    return h,w,obs,list(zip(sides,counts))

rng=random.Random(0)
oks=[]
tries=0
while len(oks)<20 and tries<2000:
    tries+=1
    x=attempt(rng)
    if x: oks.append((tries,x))
print('found',len(oks),'within',tries)
print('first few',oks[:10])
