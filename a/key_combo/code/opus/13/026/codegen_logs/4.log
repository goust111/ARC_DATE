import random, numpy as np
from collections import Counter

def select(grid):
    h,w=grid.shape
    selected=[]
    for s in range(min(h,w),1,-1):
        for r in range(h-s+1):
            for c in range(w-s+1):
                if any(not (r+s<=rr or rr+ss<=r or c+s<=cc or cc+ss<=c) for rr,cc,ss in selected):
                    continue
                if np.all(grid[r:r+s,c:c+s]==0):
                    selected.append((r,c,s))
    return selected

def trial(n=2000):
    ok=0
    prof=Counter()
    for _ in range(n):
        h=random.randint(18,24)
        w=random.randint(20,24)
        g=np.zeros((h,w),dtype=int)
