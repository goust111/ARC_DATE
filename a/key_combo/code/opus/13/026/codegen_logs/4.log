    """4-neighborhood of (r,c)."""
    r = int(r)
    c = int(c)
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


def neighbors8(r: int, c: int) -> Iterator[Coord]:
    """8-neighborhood of (r,c)."""
    r = int(r)
    c = int(c)
    for dr in (-1, 0, 1):
        for dc in (-1, 0, 1):
            if dr == 0 and dc == 0:
                continue
            yield r + dr, c + dc






