+    if own_mask is None:
+        own_mask = np.zeros_like(obstacle_mask, dtype=bool)
+
+    distance = 0
+    while True:
+        next_cells = []
+        hit_wall = False
+        for r, c in coords:
+            nr = int(r) + distance + 1
+            nc = int(c)
+            if nr >= h:
+                return distance, "bottom"
+            if obstacle_mask[nr, nc] and not own_mask[nr, nc]:
+                hit_wall = True
