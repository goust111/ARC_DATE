+def _candidate_positions(
+    chamber_mask: np.ndarray,
+    wall_mask: np.ndarray,
+    occupied: np.ndarray,
+    require_move: bool,
+    desired_reason: str | None = None,
+) -> list[dict]:
+    h, w = chamber_mask.shape
+    candidates = []
+    obstacle_mask = wall_mask | occupied
