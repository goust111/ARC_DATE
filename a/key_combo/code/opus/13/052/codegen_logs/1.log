+                own[cells[:, 0], cells[:, 1]] = True
+                distance, reason = _drop_distance(cells, obstacle_mask | own, own)
+                if require_move and distance <= 0:
+                    continue
+                if desired_reason is not None and reason != desired_reason:
+                    continue
