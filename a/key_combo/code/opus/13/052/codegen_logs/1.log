+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+WALL_COLORS = {BLUE, GREEN}
+SPRITE_COLORS = (RED, YELLOW, ORANGE)
