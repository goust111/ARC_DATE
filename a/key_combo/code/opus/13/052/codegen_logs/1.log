+            cells = [(a - step, b) for step in range(1, length + 1)]
+        elif direction == "down":
+            cells = [(a + step, b) for step in range(1, length + 1)]
+        elif direction == "left":
+            cells = [(a, b - step) for step in range(1, length + 1)]
+        else:
