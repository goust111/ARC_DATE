+                grey_count += len(black_cells)
+    if grey_count == 0:
+        return False
+    if np.array_equal(result, grid):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(RETRY_LIMIT):
+        base = _build_layout(rng)
+        if base is None:
+            continue
+        grid = _place_sprites(base, rng)
+        if grid is None:
+            continue
+        if _validate_generated(grid):
+            return grid
