+def _room_fits(existing: np.ndarray, room: tuple[int, int, int, int]) -> bool:
+    h, w = existing.shape
+    r0, c0, r1, c1 = room
+    if r0 < 1 or c0 < 1 or r1 >= h - 1 or c1 >= w - 1:
+        return False
+    rr0 = max(0, r0 - 2)
+    cc0 = max(0, c0 - 2)
+    rr1 = min(h - 1, r1 + 2)
+    cc1 = min(w - 1, c1 + 2)
+    return not np.any(existing[rr0 : rr1 + 1, cc0 : cc1 + 1])
