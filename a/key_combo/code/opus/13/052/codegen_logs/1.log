+
+    chambers, chamber_id = _chambers(grid)
+    chamber_sprite_counts = {ch["id"]: 0 for ch in chambers}
+    open_with_sprite = 0
+    closed_with_sprite = 0
+    open_reasons = set()
+
+    wall_mask = np.isin(grid, list(WALL_COLORS))
+    all_sprite_mask = np.isin(grid, list(SPRITE_COLORS))
