+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+LEGEND_PATCH = np.array([[BLUE, RED], [GREEN, YELLOW]], dtype=int)
+ORTHOGONALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+GRID_SIZE_RANGE = (14, 18)
+OBJECT_COUNT_CHOICES = [4, 5, 6]
+MARGIN = 2
+MAX_GENERATION_ATTEMPTS = 400
