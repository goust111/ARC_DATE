  "type": "transform_in_place",
  "src": "solid grey 2x2 square objects on a black background",
  "transform": "preserve each grey square and paint blue, red, green, and yellow pixels at its northwest, northeast, southwest, and southeast diagonal outside corners"
}
</annotation>
