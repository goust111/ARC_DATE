+    area = int(coords.shape[0])
+    centroid_r = float(r0 + coords[:, 0].mean())
+    centroid_c = float(c0 + coords[:, 1].mean())
+    direction = _direction_from_centroid(centroid_r, centroid_c, r0, r1, c0, c1)
