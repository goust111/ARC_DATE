+            out[r, sep_c] = fill_color
+    for info in infos:
+        dr, dc = DIR_TO_OFFSET[IDENTITY_DIRECTIONS[info["label"]]]
+        out[sep_r + dr, sep_c + dc] = int(info["color"])
