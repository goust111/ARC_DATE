+    scores = [sum(abs(a - b) for b in areas) for a in areas]
+    best = max(scores)
+    idxs = [i for i, score in enumerate(scores) if score == best]
+    assert len(idxs) == 1, "area outlier must be unique"
+    return int(idxs[0])
+
