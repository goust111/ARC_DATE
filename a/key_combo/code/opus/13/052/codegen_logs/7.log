+    grid: np.ndarray,
+    sep_r: int,
+    sep_c: int,
+    infos: list[dict],
+    choose: str,
+) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    areas = [info["area"] for info in infos]
+    if choose == "largest":
+        idx = max(range(4), key=lambda i: areas[i])
+    elif choose == "smallest":
