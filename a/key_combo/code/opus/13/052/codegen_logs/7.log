+DIR_TO_OFFSET = {
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SW": (1, -1),
+    "SE": (1, 1),
+}
+
+QUADRANTS = ("TL", "TR", "BL", "BR")
+IDENTITY_DIRECTIONS = {
+    "TL": "NW",
+    "TR": "NE",
+    "BL": "SW",
+    "BR": "SE",
+}
