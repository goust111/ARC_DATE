spec:
  grid: 4-10 rows x 4-10 cols, uniform background (color 8)
  pixel:
    count: exactly 1 foreground pixel
    color: any non-8 color (observed 4, 6, 9)
    placement: must have a unique nearest corner by Manhattan distance (margin >= 1)
    position: 0-44% of the way from the nearest edge in each axis [observed]
  transform:
    rule: fill the axis-aligned rectangle from the pixel to its nearest grid corner with the pixel color
    rectangle: bounded inclusively by pixel position and nearest corner
    output_grid: same dimensions as input

generation_strategy:
