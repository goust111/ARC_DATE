+            outer_color = _pick_frame_color(rng, used_colors)
+            inner_color = _pick_frame_color(rng, used_colors, forbidden={outer_color})
+            return {
+                "outer": {"bbox": outer_bbox, "color": outer_color, "cells": outer_frame, "kind": "outer"},
+                "inner": {
+                    "bbox": inner_bbox,
+                    "color": inner_color,
+                    "cells": inner_frame,
+                    "kind": "inner",
+                    "center": center,
