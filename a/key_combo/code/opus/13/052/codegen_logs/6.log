+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+FRAME_COLORS = (BLUE, RED, GREEN, YELLOW)
+DIRS = {
+    "U": (-1, 0),
+    "D": (1, 0),
+    "L": (0, -1),
+    "R": (0, 1),
+}
+
+MAX_GENERATION_ATTEMPTS = 500
+NESTED_CASES = [
+    (1, 1),
+    (1, 2),
+    (1, 3),
+    (2, 1),
+]
+NESTED_CASE_WEIGHTS = np.array([0.24, 0.28, 0.18, 0.30], dtype=float)
