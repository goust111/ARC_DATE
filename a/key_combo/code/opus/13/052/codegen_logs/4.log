+def _sample_positions(h: int, w: int, count: int, rng: np.random.Generator) -> list[tuple[int, int]] | None:
+    candidates = [(r, c) for r in range(2, h - 3) for c in range(2, w - 3)]
+    placed: list[tuple[int, int]] = []
