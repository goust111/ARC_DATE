+            claims[cell][color] = claims[cell].get(color, 0) | ROLE_PATH
+        if not include_stamps:
+            continue
+        for cell in _stamp_geom(spec, shape, route):
+            if cell in markers:
+                continue
+            claims[cell][color] = claims[cell].get(color, 0) | ROLE_STAMP
+
+    return claims
+
