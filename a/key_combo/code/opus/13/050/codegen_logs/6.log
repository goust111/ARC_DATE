+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < base.shape[0] and 0 <= cc < base.shape[1]:
+                if base[rr, cc] == BLACK and dist[rr, cc] == -1:
+                    dist[rr, cc] = dist[r, c] + 1
+                    q.append((rr, cc))
