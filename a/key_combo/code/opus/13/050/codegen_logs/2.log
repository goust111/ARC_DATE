+    return {
+        "coords": coords,
+        "shape": shape,
+        "marker": marker,
+        "push_dir": direction,
+        "start_parity": start_parity,
+        "stop_step": stop_step,
+        "max_steps": max_steps,
+        "contact": contact,
+        "input_occ": input_occ,
+        "input_buffer": input_buffer,
+        "final_occ": final_cells,
+        "final_buffer": final_buffer,
+        "swept": swept,
