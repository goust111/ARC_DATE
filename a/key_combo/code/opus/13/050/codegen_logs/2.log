+def _pick_with_quotas(
+    by_dir: dict[tuple[int, int], list[dict]],
+    quotas: dict[tuple[int, int], int],
+    rng: np.random.Generator,
+) -> list[dict] | None:
+    dirs = list(quotas)
+    for _ in range(SELECT_RETRIES):
+        picked: list[dict] = []
+        good = True
+        rng.shuffle(dirs)
+        for direction in dirs:
