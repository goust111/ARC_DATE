+from collections import deque
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+FRAME = 3
+CONTROL = 5
+MARKER = 9
+OBJECT_COLORS = [1, 2, 4, 6, 7, 8]
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_RETRIES = 400
+SELECT_RETRIES = 300
+
+# Base shapes are defined for a rightward push with contact cell at (0, 0).
+BASE_SHAPES = [
+    [(0, 0), (0, 1)],
+    [(0, 0), (0, 1), (0, 2)],
+    [(0, 0), (0, 1), (1, 1)],
+    [(0, 0), (0, 1), (1, 1), (1, 2)],
+    [(0, 0), (0, 1), (0, 2), (1, 1)],
