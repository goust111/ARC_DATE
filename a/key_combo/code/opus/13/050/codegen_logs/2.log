+    later_same = False
+    for step in range(stop_step + 1, max_steps + 1):
+        front = _frontier(_shift_coords(coords, direction, step), direction)
+        if all(_cheb_parity((int(rr), int(cc)), control) == start_parity for rr, cc in front):
