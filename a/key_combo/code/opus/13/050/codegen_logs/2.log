+                    "color": color,
+                    "coords": coords,
+                    "coord_set": {tuple(map(int, cell)) for cell in coords.tolist()},
+                    "marker": marker,
+                    "push_dir": push_dir,
+                    "start_parity": next(iter(parities)),
+                    "contact_cells": contact_cells,
