+
+
+INPUT_SIZE = 11
+QUAD_SIZE = 5
+CROSS_INDEX = 5
+MACRO_SIZE = 10
+OUTPUT_SIZE = 30
+
+BG_COLOR = 0
+SOURCE_COLOR = 2
+PLACEHOLDER_COLOR = 7
+
+GEN_ATTEMPTS = 1000
