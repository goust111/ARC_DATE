+    if int(mask.sum()) < AREA_MIN or int(mask.sum()) > AREA_MAX:
+        return False
+    height, width = _bbox_hw(mask)
+    if height < 3 or width < 3:
+        return False
+    family = _rotation_family(mask)
+    if len({_mask_key(rot) for rot in family}) != 4:
+        return False
+    return True
+
