+    mask = np.zeros((QUAD_SIZE, QUAD_SIZE), dtype=bool)
+    seed_r = int(rng.integers(0, QUAD_SIZE))
+    seed_c = int(rng.integers(0, QUAD_SIZE))
+    mask[seed_r, seed_c] = True
