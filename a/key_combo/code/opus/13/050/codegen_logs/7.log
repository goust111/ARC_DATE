+def _next_placeholder_index(rng: np.random.Generator) -> int:
+    global _PLACEHOLDER_CYCLE
+    if not _PLACEHOLDER_CYCLE:
+        _PLACEHOLDER_CYCLE = rng.permutation(4).astype(int).tolist()
+    return int(_PLACEHOLDER_CYCLE.pop())
+
