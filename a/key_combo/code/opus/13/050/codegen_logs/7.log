+        grid[:QUAD_SIZE, CROSS_INDEX + 1 :],
+        grid[CROSS_INDEX + 1 :, :QUAD_SIZE],
+        grid[CROSS_INDEX + 1 :, CROSS_INDEX + 1 :],
