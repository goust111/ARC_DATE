+
+def _paint_candidate(
+    rng: random.Random,
+    h: int,
+    w: int,
+    centers: list[tuple[int, int]],
+    target_centers: set[tuple[int, int]],
+    target_color: int,
+) -> tuple[np.ndarray, dict[str, object]] | None:
+    grid = np.zeros((h, w), dtype=int)
