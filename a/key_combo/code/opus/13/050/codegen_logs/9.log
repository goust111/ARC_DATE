+BLACK = 0
+YELLOW = 4
+ARM_COLORS = (1, 2, 3, 5, 6, 7, 8, 9)
+PLUS_OFFSETS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+CARDINALS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+GRID_MIN = 13
+GRID_MAX = 18
+MARKER_COUNT_RANGE = (4, 6)
+TARGET_COUNT_OPTIONS = (2, 3, 4)
