+def _noise_count_bounds(h: int, w: int, target_count: int) -> tuple[int, int]:
+    area = h * w
+    lo = math.ceil(area * NOISE_DENSITY_RANGE[0])
+    hi = math.floor(area * NOISE_DENSITY_RANGE[1])
+    lo = max(lo, 4 * target_count + 1)
+    return lo, hi
