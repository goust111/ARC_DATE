+        blocked.add((r, 0))
+        blocked.add((r, 1))
+    for box in rectangles:
+        blocked.update(_rect_cells(box))
+
+    candidates = [(r, c) for r in range(height) for c in range(width) if (r, c) not in blocked]
+    random.shuffle(candidates)
+    return candidates
