+import numpy as np
+
+
+BACKGROUND = 0
+CONTROL_COLOR = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+GRID_HEIGHT_RANGE = (13, 18)
+GRID_WIDTH_RANGE = (13, 18)
+PAIR_COUNT_CHOICES = (3, 4)
+EXPANDED_SIZE_RANGE = (4, 7)
+MAX_ATTEMPTS = 500
