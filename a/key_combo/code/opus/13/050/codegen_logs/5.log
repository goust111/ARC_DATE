+                d_lose = groups[loser]["distance"]
+                same_parity = (d_win % 2) == (d_lose % 2)
+                if mode == OVERLAP_MODE_ODD_EVEN:
+                    if d_win % 2 != 1 or d_lose % 2 != 0:
