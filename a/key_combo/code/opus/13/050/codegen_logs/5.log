+def _random_rectangle(height: int, width: int, legend_rows: int) -> tuple[int, int, int, int] | None:
+    legend_box = (0, 0, legend_rows - 1, 1)
+    min_size, max_size = EXPANDED_SIZE_RANGE
+    for _ in range(80):
