+        ("tr", "bl", "br"),
+        ("tl", "tr", "bl", "br"),
+        ("tl", "tm", "br"),
+        ("tr", "tm", "bl"),
+        ("tl", "rm", "bl"),
+        ("tr", "lm", "br"),
+        ("tl", "bm", "tr"),
+        ("bl", "tm", "br"),
+    ]
+
+    out: list[np.ndarray] = []
+    for template in templates:
+        coords = [points[name] for name in template]
+        if len(set(coords)) < len(coords):
