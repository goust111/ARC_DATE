+
+def _intersection(box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]) -> tuple[int, int, int, int] | None:
+    r0 = max(box_a[0], box_b[0])
+    c0 = max(box_a[1], box_b[1])
+    r1 = min(box_a[2], box_b[2])
