+def _legend_order_indices(pair_count: int, conflict_pair: tuple[int, int]) -> list[int]:
+    winner, loser = conflict_pair
+    remaining = [idx for idx in range(pair_count) if idx not in conflict_pair]
+    random.shuffle(remaining)
