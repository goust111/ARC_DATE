+        ("tr", "bl"),
+        ("tl", "tr", "br"),
+        ("tl", "bl", "br"),
+        ("tl", "tr", "bl"),
+        ("tr", "bl", "br"),
+        ("tl", "tr", "bl", "br"),
+        ("tl", "tm", "br"),
+        ("tr", "tm", "bl"),
+        ("tl", "rm", "bl"),
