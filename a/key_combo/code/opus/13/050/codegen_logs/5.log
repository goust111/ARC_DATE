+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rect_cells(box: tuple[int, int, int, int]) -> Iterable[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
