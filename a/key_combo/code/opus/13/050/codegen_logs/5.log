+    for coords in point_sets:
+        dot_cells.update(tuple(map(int, pt)) for pt in coords)
+
+    blocked = set(dot_cells)
+    for r, c in list(dot_cells):
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
+                cc = c + dc
+                if 0 <= rr < height and 0 <= cc < width:
