+
+def _legend_pairs(grid: np.ndarray) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    for r in range(grid.shape[0]):
+        left = int(grid[r, 0])
+        right = int(grid[r, 1])
+        if left == BACKGROUND or right == BACKGROUND:
+            break
+        pairs.append((left, right))
