+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+MARKER = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+RECT_COUNT_OPTIONS = (2, 3)
+GRID_ROWS_BY_COUNT = {2: (13, 20), 3: (16, 22)}
+GRID_COLS_BY_COUNT = {2: (15, 22), 3: (18, 26)}
+RECT_H_RANGE = (5, 9)
+RECT_W_RANGE = (5, 10)
+GRID_BORDER = 1
+LEFT_MARGIN = 2
+RECT_GAP = 1
+GEN_RETRY_LIMIT = 400
