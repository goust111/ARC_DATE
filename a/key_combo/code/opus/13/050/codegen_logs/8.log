+    frame_colors = colors[:n_rects]
+    key_colors = colors[n_rects : 2 * n_rects]
+
+    grid = np.zeros((h, w), dtype=int)
+    specs: list[dict[str, int]] = []
+    for i, box in enumerate(boxes):
