+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        built = _build_case()
+        if built is None:
+            continue
+        grid, specs = built
+        if _validate_case(grid, specs):
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

