+    if len(set(key_colors)) != len(key_colors):
+        return False
+    if len(set(frame_colors)) != len(frame_colors):
+        return False
+    if set(key_colors) & set(frame_colors):
+        return False
+
+    if np.count_nonzero(grid[:, 0]) != len(specs):
