+import random
+from itertools import combinations
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+Shape = tuple[Coord, ...]
+Placement = tuple[Coord, ...]
+
+BACKGROUND = 0
+GREY = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_HEIGHT_RANGE = (16, 22)
+GRID_WIDTH_RANGE = (16, 22)
+COUNT_PATTERNS = (
+    (2, 1, 1),
+    (1, 2, 1),
+    (1, 1, 2),
+    (2, 2, 1),
+    (2, 1, 2),
+    (1, 2, 2),
+)
+GENERATION_RETRIES = 300
+SOLVER_MAX_SOLUTIONS = 2
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    if connectivity == 4:
+        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        deltas = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for dr, dc in deltas:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _normalize(cells: list[Coord] | tuple[Coord, ...]) -> Shape:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
+
+
+def _shape_dims(shape: Shape) -> tuple[int, int]:
+    return max(r for r, _ in shape) + 1, max(c for _, c in shape) + 1
+
+
+def _dihedral_variants(shape: Shape) -> list[Shape]:
