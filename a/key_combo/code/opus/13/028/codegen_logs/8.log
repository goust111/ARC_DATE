+        vh, vw = _shape_dims(variant)
+        for r0 in range(1, h - vh + 1):
+            for c0 in range(w - vw + 1):
+                placement = _place_shape(variant, r0, c0)
+                if placement not in seen:
+                    seen.add(placement)
+                    placements.append(placement)
