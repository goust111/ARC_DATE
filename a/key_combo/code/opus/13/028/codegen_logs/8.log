    candidates: list[tuple[int, int, frozenset[tuple[int, int]]]] = []
    for variant in variants:
        h, w = _shape_size(variant)
        for r in range(H - h + 1):
            for c in range(W - w + 1):
                cells = frozenset((r + dr, c + dc) for dr, dc in variant)
