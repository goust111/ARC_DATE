  "src": "8-connected teal template mask s",
  "dst": "green mask placement d in the grid",
  "match_cond": "d.shape == s.shape under rotation or reflection",
  "transform": "recolor matched green pixels to teal",
  "multi_step": "scan placements in row-major order and skip later matches that overlap already selected cells"
}
</annotation>
