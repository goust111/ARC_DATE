+def _touches(a: Placement, b: Placement) -> bool:
+    aset = set(a)
+    for r, c in b:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (r + dr, c + dc) in aset:
+                    return True
+    return False
