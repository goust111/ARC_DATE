+    variants: set[Shape] = set()
+    for k in range(4):
+        rotated = np.rot90(arr, k)
+        for candidate in (rotated, np.fliplr(rotated)):
+            coords = [tuple(map(int, rc)) for rc in np.argwhere(candidate)]
+            variants.add(_normalize(coords))
