+def _components(mask: np.ndarray, connectivity: int = 4) -> list[list[Coord]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[Coord]] = []
+    if connectivity == 4:
+        deltas = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
