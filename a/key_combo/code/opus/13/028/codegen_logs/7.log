+    if not np.any(out == RED):
+        return False
+    if not np.any(out == expected_gap_color):
+        return False
+    if np.any(out == unexpected_gap_color):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
