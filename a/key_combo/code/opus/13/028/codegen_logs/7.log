+        ch = left_margin
+        cs = ch + hw + gap
+    else:
+        cs = left_margin
+        ch = cs + sw + gap
+
+    width = max(ch + hw, cs + sw) + right_margin
+    width = min(width, 24)
+    if width < max(ch + hw, cs + sw) + 1:
+        return None
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[rh : rh + hh, ch : ch + hw][hollow_mask] = GREEN
+    grid[rs : rs + sh, cs : cs + sw][solid_mask] = GREEN
+    return grid
