86: 
87: _RNG = np.random.default_rng()
88: 
89: # ── CFG: canvas ──────────────────────────────────────────────────────
90: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]
91: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]
92: NUM_COLORS = 10                   # palette 0-9
93: 
94: # ── CFG: component shapes ───────────────────────────────────────────
95: BBOX_MAX = 5                      # max h or w of a component bbox
96: AREA_RANGE = (3, 13)              # component area in [3, 12]
97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w
98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes
99: 
100: # ── CFG: layout ─────────────────────────────────────────────────────
101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures
102: MIN_COL_GAP = 1                   # minimum column gap between components
103: MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top
104: 
105: # ── CFG: generation ─────────────────────────────────────────────────
106: MAX_RETRIES = 300                 # outer generate_input retry budget
107: 
108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),
109:                (0, 1), (1, -1), (1, 0), (1, 1)]
110: 
111: 
112: def _feasible_dims(area: int) -> list[tuple[int, int]]:
113:     """Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10."""
114:     dims = []
115:     for h in range(1, BBOX_MAX + 1):
116:         for w in range(1, BBOX_MAX + 1):
117:             if area > h * w:
118:                 continue
119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:
120:                 continue
121:             if h == 1 and area != w:
122:                 continue
123:             if w == 1 and area != h:
124:                 continue
125:             if h > 1 and w > 1 and area < max(h, w):
126:                 continue
127:             dims.append((h, w))
128:     return dims
129: 
130: 
131: def _line_mask(h: int, w: int) -> np.ndarray:
132:     """Create a seed mask along a diagonal line spanning the bbox, randomly flipped."""
133:     mask = np.zeros((h, w), dtype=bool)
134:     if h == 1:
135:         mask[0, :] = True
136:         return mask
137:     if w == 1:
138:         mask[:, 0] = True
139:         return mask
140:     steps = max(h, w)
141:     for i in range(steps):
142:         r = int(round(i * (h - 1) / (steps - 1)))
143:         c = int(round(i * (w - 1) / (steps - 1)))
144:         mask[r, c] = True
145:     if bool(_RNG.integers(0, 2)):
146:         mask = np.flipud(mask)
147:     if bool(_RNG.integers(0, 2)):
148:         mask = np.fliplr(mask)
149:     return mask
150: 
151: 
152: def _make_mask(h: int, w: int, area: int) -> np.ndarray:
153:     """Grow an 8-connected mask from a line seed to the target area."""
154:     mask = _line_mask(h, w)
155:     while int(mask.sum()) < area:
156:         frontier = set()
157:         for r, c in np.argwhere(mask):
