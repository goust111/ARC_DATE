57: def _bounded_counts(total: int) -> list[int]:
58:     counts = []
59:     remaining = total
60:     lo, hi = CELLS_PER_COLOR_RANGE
61:     for i in range(COLOR_COUNT):
62:         left = COLOR_COUNT - i - 1
63:         low = max(lo, remaining - left * hi)
64:         high = min(hi, remaining - left * lo)
65:         value = random.randint(low, high)
66:         counts.append(value)
67:         remaining -= value
68:     random.shuffle(counts)
69:     return counts
