+    if box is None:
+        return None
+    if box[0] != 0 or box[2] != height - 1:
+        return None
+    if box[3] - box[1] + 1 < 3:
+        return None
+
+    total = int(np.count_nonzero(clean))
+    if not (8 <= total <= 14):
+        return None
+    if _color_count(clean, BLUE) < 3 or _color_count(clean, YELLOW) < 3:
+        return None
+    return clean
+
+
+def _candidate_noise_positions(grid: np.ndarray, color: int) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    mirror_sum = w - 1
+    primary = []
+    secondary = []
+    for r in range(h):
