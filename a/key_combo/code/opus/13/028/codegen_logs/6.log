+    noisy = clean.copy()
+    noise_total = 0
+    for color in (BLUE, YELLOW):
+        count = random.randint(1, 2)
+        for _ in range(count):
+            candidates = _candidate_noise_positions(noisy, color)
+            if not candidates:
+                return None
+            r, c = candidates[0]
+            noisy[r, c] = color
+            noise_total += 1
+
+    total = int(np.count_nonzero(noisy))
