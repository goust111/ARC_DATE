97: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w
98: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes
99: 
100: # ── CFG: layout ─────────────────────────────────────────────────────
