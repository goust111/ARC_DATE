14: def main(grid: np.ndarray) -> np.ndarray:
15:     """
16:     Recolor each blue placeholder object with the color of the non-blue object that has the same shape.
17: 
18:     Input structure
19:     - A black-background grid contains several 4-connected foreground objects.
20:     - Blue objects are uncolored placeholders.
21:     - Every non-blue foreground object is a colored shape template.
22: 
23:     Rule
24:     - Compare objects by their normalized 4-connected pixel mask inside their bounding box.
25:     - For each blue object, find the unique non-blue template object with the same normalized mask.
26:     - Recolor all pixels of the blue object to that matched template color; leave templates and background unchanged.
27: 
28:     Key insight
29:     - Position is irrelevant: each placeholder is identified by shape equality with a colored template elsewhere in the grid.
30:     """
31:     g = np.asarray(grid, dtype=int)
32:     assert g.ndim == 2, "expected a 2D grid"
