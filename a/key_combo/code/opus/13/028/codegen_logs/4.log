+
+    expected = np.full(shape, BACKGROUND, dtype=int)
+    expected[(~top_mask) & (~shifted_bottom_mask)] = OUTPUT_COLOR
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
