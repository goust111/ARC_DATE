def _gen_feasible_dimensions(notch_count, max_height, max_width):
    feasible_dims = []
    for height in range(GEN_PATCH_HEIGHT_RANGE[0], max_height + 1):
        for width in range(GEN_PATCH_WIDTH_RANGE[0], max_width + 1):
