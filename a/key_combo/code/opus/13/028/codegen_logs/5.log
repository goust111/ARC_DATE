import random, numpy as np
from collections import deque

BLACK, RED, GREEN, ORANGE, TEAL = 0,2,3,7,8

def neighbors4(h,w,r,c):
    for dr,dc in ((-1,0),(1,0),(0,-1),(0,1)):
        rr,cc=r+dr,c+dc
        if 0<=rr<h and 0<=cc<w:
            yield rr,cc

def plus_cells(center):
    r,c=center
    return {(r,c),(r-1,c),(r+1,c),(r,c-1),(r,c+1)}

def components(mask):
    h,w=mask.shape
    vis=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or vis[r,c]:
                continue
            q=deque([(r,c)])
            vis[r,c]=True
            comp=[]
            while q:
                rr,cc=q.popleft(); comp.append((rr,cc))
                for nr,nc in neighbors4(h,w,rr,cc):
                    if mask[nr,nc] and not vis[nr,nc]:
                        vis[nr,nc]=True; q.append((nr,nc))
            out.append(comp)
    return out

def main(inp):
    g=inp.copy()
    h,w=g.shape
    centers=[]
    vis=np.zeros((h,w),dtype=bool)
    for r in range(h):
        for c in range(w):
            if g[r,c]"'!=GREEN or vis[r,c]:
                continue
            q=deque([(r,c)]); vis[r,c]=True; comp=[]
            while q:
                rr,cc=q.popleft(); comp.append((rr,cc))
                for nr,nc in neighbors4(h,w,rr,cc):
                    if g[nr,nc]==GREEN and not vis[nr,nc]:
                        vis[nr,nc]=True; q.append((nr,nc))
            pts=set(comp)
            if len(pts)!=5: raise AssertionError
            rs=[r for r,c in pts]; cs=[c for r,c in pts]
            if max(rs)-min(rs)!=2 or max(cs)-min(cs)!=2: raise AssertionError
            center=(min(rs)+1,min(cs)+1)
            if pts!=plus_cells(center): raise AssertionError
            centers.append(center)
    centers.sort()
    out=g.copy()
    for i,(r1,c1) in enumerate(centers):
        for r2,c2 in centers[i+1:]:
            dr=r2-r1; dc=c2-c1
            if abs(dr)!=abs(dc):
                continue
            sr=(dr>0)-(dr<0); sc=(dc>0)-(dc<0)
            gap=[(r1+k*sr,c1+k*sc) for k in range(1,abs(dr))]
            if all(out[r,c]==BLACK for r,c in gap):
                for r,c in gap:
                    out[r,c]=RED
    regs=components(out==BLACK)
    areas=sorted(len(x) for x in regs)
    if len(areas)<3 or len(set(areas))!=len(areas): raise AssertionError(areas)
    small=min(regs,key=len); large=max(regs,key=len)
    out2=out.copy()
    for r,c in small: out2[r,c]=ORANGE
    for r,c in large: out2[r,c]=TEAL
    return out2, areas

def transform(n, centers, code):
    out=[]
    for r,c in centers:
        if code==0: rr,cc=r,c
        elif code==1: rr,cc=r,n-1-c
        elif code==2: rr,cc=n-1-r,c
        elif code==3: rr,cc=n-1-r,n-1-c
        elif code==4: rr,cc=c,r
        elif code==5: rr,cc=c,n-1-r
        elif code==6: rr,cc=n-1-c,r
        else: rr,cc=n-1-c,n-1-r
        out.append((rr,cc))
    return out

def valid_centers(n, centers):
    if len(set(centers))!=len(centers): return False
    allcells=[]
    for center in centers:
        r,c=center
        if not (1<=r<n-1 and 1<=c<n-1): return False
        allcells.append(plus_cells(center))
    for i,a in enumerate(allcells):
        for b in allcells[i+1:]:
            if a & b: return False
            for r1,c1 in a:
                for r2,c2 in b:
                    if abs(r1-r2)+abs(c1-c2)==1:
                        return False
    return True

def add_distractors(n, centers, target):
    centers=list(centers)
    tries=0
    while len(centers)<target and tries<1000:
        tries+=1
        cand=(random.randint(1,n-2), random.randint(1,n-2))
        if cand in centers: continue
        ok=True
        for other in centers:
            if max(abs(cand[0]-other[0]), abs(cand[1]-other[1]))<3:
                ok=False; break
            if abs(cand[0]-other[0])==abs(cand[1]-other[1]):
                ok=False; break
        if ok and valid_centers(n, centers+[cand]):
            centers.append(cand)
    return centers if len(centers)==target else None

def build_parallel(n):
    max_off=max(3,n//3)
    a=random.randint(2,max_off)
    b=random.randint(2,max_off)
    if a==b:
        b=min(max_off,b+1) if b<max_off else b-1
    centers=[(1,1+a),(n-2-a,n-2),(1+b,1),(n-2,n-2-b)]
    centers=transform(n,centers, random.randrange(8))
    target=random.randint(4,6)
    centers=add_distractors(n, centers, target)
    return centers

def build_diamond(n):
    for _ in range(200):
        s=random.randint(3,5)
        r=random.randint(s+4, n-s-5)
        c=random.randint(s+3, n-s-3)
        T=(r-s,c); L=(r,c-s); R=(r,c+s); B=(r+s,c)
        k=min(T[0]-1,T[1]-1)
        if k<3: continue
        E=(T[0]-k, T[1]-k)
        centers=[T,L,R,B,E]
        centers=transform(n, centers, random.randrange(8))
        target=random.randint(5,6)
        centers=add_distractors(n, centers, target)
        if centers is not None:
            return centers
    return None

for name,builder in [('"'parallel',build_parallel),('diamond',build_diamond)]:
    ok=0
    samples=[]
    for _ in range(400):
        n=random.randint(17,21)
        centers=builder(n)
        if centers is None or not valid_centers(n, centers):
            continue
        g=np.zeros((n,n),dtype=int)
        for r,c in centers:
            for rr,cc in plus_cells((r,c)):
                g[rr,cc]=GREEN
        try:
            out, areas=main(g)
            ok+=1
            samples.append((n, len(centers), areas))
        except Exception:
            pass
    print(name, ok, samples[:10])
