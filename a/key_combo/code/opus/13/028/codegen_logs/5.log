+def _plus_cells(center: tuple[int, int]) -> set[tuple[int, int]]:
+    r, c = center
+    return {
+        (r, c),
+        (r - 1, c),
+        (r + 1, c),
+        (r, c - 1),
+        (r, c + 1),
+    }
+
