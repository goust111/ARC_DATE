+    left_max = center - 1
+    left_cols = [random.randint(left_min, left_max)]
+    for _ in range(1, h):
+        step = random.choice((-1, 0, 1))
+        left_cols.append(max(left_min, min(left_max, left_cols[-1] + step)))
