+        return reached
+
+    q: deque[tuple[int, int]] = deque([(sr, sc)])
+    reached[sr, sc] = True
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and not reached[rr, cc] and int(grid[rr, cc]) != GREY:
+                reached[rr, cc] = True
+                q.append((rr, cc))
+    return reached
+
