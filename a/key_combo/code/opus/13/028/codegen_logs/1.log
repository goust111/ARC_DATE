+def _sample_spaced(candidates: list[tuple[int, int]], count: int) -> list[tuple[int, int]]:
+    random.shuffle(candidates)
+    picked: list[tuple[int, int]] = []
+    for r, c in candidates:
+        if all(abs(r - rr) + abs(c - cc) >= 2 for rr, cc in picked):
+            picked.append((r, c))
+            if len(picked) == count:
+                break
+    return picked
+
