from itertools import combinations
from collections import deque
rows=['.....#####.....','.....#...#.....','....##...##....','....#..#..#....','....#.....#....','...##.....##...','...##.....##...','....#.....#....','....##.#.##....','....##...##....','...##.....##...','...##.....##...','....##...##....','....##...##....','....#.....#....']
H=len(rows); W=len(rows[0]); center=W//2
wall=[[c=='#' for c in row] for row in rows]

def reach(mask):
    if mask[0][0]: return False
    q=deque([(0,0)]); seen={(0,0)}
    while q:
        r,c=q.popleft()
        if c==W-1: return True
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and not mask[rr][cc] and (rr,cc) not in seen:
