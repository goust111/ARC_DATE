spec:
  grid: 5-15 rows x 5-12 cols (area 60-150)
  colors_input: BLACK (background) + GREY (walls) only
  colors_output: same plus ORANGE (smallest region) and TEAL (largest region)
  walls:
    color: GREY
    width: exactly 1 cell (no 2x2 grey block anywhere)
    connectivity: single 4-connected component [observed]
    fraction: 35-44% of grid cells [observed]
  black_regions:
    definition: 4-connected components of BLACK pixels
    count: 7-8
    area_min: 1-4 (unique -- no tie for smallest)
    area_max: 10-23 (unique -- no tie for largest)
    area_ratio: >=5 between largest and smallest [observed]
