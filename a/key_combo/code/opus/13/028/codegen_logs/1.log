+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+
+GEN_ATTEMPTS = 400
+WALL_ATTEMPTS = 160
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _repair_wall(grid: np.ndarray) -> np.ndarray:
+    repaired = np.array(grid, dtype=int, copy=True)
+    h, w = repaired.shape
+    center = w // 2
+    for r in range(h):
+        for d in range(1, center + 1):
+            c1 = center - d
+            c2 = center + d
+            if c1 < 0 or c2 >= w:
+                continue
+            v1 = int(repaired[r, c1])
+            v2 = int(repaired[r, c2])
+            if v1 == GREY and v2 == BLACK:
+                repaired[r, c2] = GREY
+            elif v1 == BLACK and v2 == GREY:
+                repaired[r, c1] = GREY
+    return repaired
+
+
+def _reachable_mask(grid: np.ndarray, start: tuple[int, int] = (0, 0)) -> np.ndarray:
+    h, w = grid.shape
+    reached = np.zeros((h, w), dtype=bool)
+    sr, sc = start
+    if not (0 <= sr < h and 0 <= sc < w) or int(grid[sr, sc]) == GREY:
+        return reached
+
+    q: deque[tuple[int, int]] = deque([(sr, sc)])
+    reached[sr, sc] = True
+    while q:
+        r, c = q.popleft()
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and not reached[rr, cc] and int(grid[rr, cc]) != GREY:
+                reached[rr, cc] = True
+                q.append((rr, cc))
+    return reached
+
+
+def _reaches_right_half(wall_mask: np.ndarray) -> bool:
+    h, w = wall_mask.shape
+    center = w // 2
+    if wall_mask[0, 0]:
+        return False
+
+    seen = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        if c > center:
+            return True
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and not seen[rr, cc] and not wall_mask[rr, cc]:
+                seen[rr, cc] = True
+                q.append((rr, cc))
+    return False
+
