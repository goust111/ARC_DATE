+        area = int(obj["area"])
+        color = int(obj["color"])
+        for step in range(area):
+            rr = int(r1) + 1 + step
+            if rr >= H:
+                break
+            width = area - step
+            out[rr, dst_c0 : min(W, dst_c0 + width)] = color
+
+    return out
