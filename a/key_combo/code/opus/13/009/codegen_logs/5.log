+def _touching(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r, c in a:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (r + dr, c + dc) in b:
