+
+def _wedge_cells(r0: int, c0: int, h: int, area: int, H: int, W: int) -> set[tuple[int, int]]:
+    cells: set[tuple[int, int]] = set()
+    for step in range(int(area)):
+        rr = int(r0 + h + step)
+        if not (0 <= rr < H):
+            continue
+        width = int(area - step)
+        for cc in range(int(c0), min(W, int(c0) + width)):
+            cells.add((rr, cc))
+    return cells
