+def _mask_cells(mask: np.ndarray, r0: int, c0: int) -> set[tuple[int, int]]:
+    rows, cols = np.nonzero(mask)
+    return {(int(r0 + r), int(c0 + c)) for r, c in zip(rows, cols)}
