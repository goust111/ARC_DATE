+        if not (0 <= rr < H):
+            continue
+        width = int(area - step)
+        for cc in range(int(c0), min(W, int(c0) + width)):
+            cells.add((rr, cc))
+    return cells
+
+
+def _touching(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r, c in a:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                if (r + dr, c + dc) in b:
+                    return True
+    return False
