  "path": "perpendicular ray from the black hinge toward the side with more space to the grid edge",
  "trajectory": "continuous, same length as the original tail",
  "transform": "clear the original tail; keep the markers and the gray-to-black segment fixed"
}
</annotation>
<generation_spec>
