+    cavities.sort(key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    return cavities
+
+
+def fold_shape(
+    total_len: int,
+    fixed_len: int,
+    rod_orient: str,
+    endpoint_sign: int,
+    fold_sign: int,
+) -> tuple[tuple[int, int], ...]:
+    tail_len = total_len - fixed_len
