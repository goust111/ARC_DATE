        rotated = _gen_normalize_mask(np.rot90(mask, k))
        if not any(np.array_equal(rotated, old) for old in variants):
            variants.append(rotated)
    return variants


def _gen_arch_options(count: int):
    intervals = []
    for width in GEN_ARCH_WIDTHS:
