+
+def _rod_input_cells(spec: dict, start_r: int, start_c: int) -> dict:
+    total_len = spec["total_len"]
+    fixed_len = spec["fixed_len"]
+    endpoint_sign = spec["endpoint_sign"]
+    rod_orient = spec["rod_orient"]
+    tail_len = total_len - fixed_len
