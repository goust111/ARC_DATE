+
+def _sample_unmatched_spec() -> dict:
+    total_len = random.randint(7, 8)
+    fixed_len = random.randint(3, total_len - 1)
+    return {
+        "total_len": total_len,
+        "fixed_len": fixed_len,
+        "rod_orient": random.choice(["h", "v"]),
+        "endpoint_sign": random.choice([-1, 1]),
