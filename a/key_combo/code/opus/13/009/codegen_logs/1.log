+def _neighbors4(r, c):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _find_objects(grid):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (BG, WALL) or seen[r, c]:
