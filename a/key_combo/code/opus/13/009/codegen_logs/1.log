+        ranking = chamber_info[idx]["ranking"]
+        if len(ranking) < 2 or ranking[-1]["count"] == 0:
+            return False
+        if not (ranking[0]["count"] == ranking[1]["count"] and ranking[0]["bottom"] > ranking[1]["bottom"]):
