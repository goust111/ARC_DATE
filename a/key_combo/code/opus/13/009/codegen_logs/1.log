+        if not (ranking[0]["count"] == ranking[1]["count"] and ranking[0]["bottom"] == ranking[1]["bottom"] and ranking[0]["left"] < ranking[1]["left"]):
+            return False
+    return True
+
+
+def _gen_attempt(rng):
+    mode = rng.choices(["bottom_tie", "left_tie", "none"], weights=[4, 4, 2], k=1)[0]
