+SQUARE4 = ((0, 0), (0, 1), (1, 0), (1, 1))
+LINE3V = ((0, 0), (1, 0), (2, 0))
+L3 = ((0, 0), (1, 0), (1, 1))
+
+
+def _shape_size(shape):
+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    return max(rows) + 1, max(cols) + 1
