+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        if int(grid[r, c]) != BG:
+            return False
+    for r, c in cells:
+        for nr in range(r - 1, r + 2):
+            for nc in range(c - 1, c + 2):
+                if not (0 <= nr < h and 0 <= nc < w):
+                    continue
+                if (nr, nc) in cell_set:
+                    continue
+                if int(grid[nr, nc]) not in (BG, WALL):
+                    return False
