+            {"shape": SQUARE4, "x": 1, "tag": "stack_lower"},
+            {"shape": SQUARE4, "x": 1, "tag": "stack_upper"},
+        ]
+    if role == "left_tie":
+        return [
+            {"shape": SQUARE4, "x": 1},
+            {"shape": SQUARE4, "x": chamber_width - 3},
+        ]
+    if role == "stack_majority":
+        return [
+            {"shape": SQUARE4, "x": 1, "tag": "stack_lower"},
+            {"shape": L3, "x": 1, "tag": "stack_upper"},
+        ]
+    if role == "floor_majority":
+        return [
+            {"shape": SQUARE4, "x": 1},
+            {"shape": LINE3V, "x": chamber_width - 2},
+        ]
