+    obj_size = input_obj.shape[0]
+    obj_r, obj_c = _centered_location(height, width, obj_size)
+    obj_bbox = (obj_r, obj_c, obj_r + obj_size - 1, obj_c + obj_size - 1)
+    anchor_r, anchor_c = _core_anchor_from_bbox(obj_bbox, controls)
