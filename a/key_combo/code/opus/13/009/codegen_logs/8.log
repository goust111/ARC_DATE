+    g = np.asarray(grid, dtype=int)
+    tile, (anchor_r, anchor_c) = _solve_components(g)
+    out = g.copy()
+    out[1:-1, 1:-1] = _periodic_inner(g.shape, tile, anchor_r, anchor_c)[1:-1, 1:-1]
+    return out
