+    cols = (np.arange(1, w - 1) - int(anchor_c)) % tile.shape[1]
+    inner = tile[np.ix_(rows, cols)]
+    out = np.full(shape, BG, dtype=int)
+    out[1:-1, 1:-1] = inner
