+    sys.path.append(str(_ARC_UTILS_DIR))
+
+from arc_utils import crop_bbox, paste
+
+
+BG = 5
+BLACK = 0
+CTRL_COLORS = (1, 2)
+TILE_COLORS = (3, 4, 6, 7, 8, 9)
+SIDES = ("top", "bottom", "left", "right")
+TRANSFORMS = [(k, flip) for k in range(4) for flip in (False, True)]
+GEN_MAX_ATTEMPTS = 400
