+        "bottom": grid[-1, 1:-1],
+        "left": grid[1:-1, 0],
+        "right": grid[1:-1, -1],
+    }
+    controls: dict[str, int] = {}
+    for side, vals in sides.items():
+        unique = {int(v) for v in vals}
+        if len(unique) == 1:
+            color = unique.pop()
+            if color in CTRL_COLORS:
+                controls[side] = color
+    if len(controls) != 2:
+        raise ValueError("expected exactly two control sides")
+    return controls
+
