+    mask = np.isin(grid, list(control_colors))
+    mask[0, :] = False
+    mask[-1, :] = False
+    mask[:, 0] = False
+    mask[:, -1] = False
+    bbox = _bbox_from_mask(mask)
+    return bbox, crop_bbox(grid, bbox)
