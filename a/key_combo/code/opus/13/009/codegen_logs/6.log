+        orient = orientations[idx]
+        spec = _make_safe_spec(
+            shape,
+            colors[idx],
+            placed,
+            orient,
+            allow_immobile=want_static and idx == object_count - 1,
+        )
+        if spec is None:
+            return None
+        placed.append(spec)
+
+    if not _tracks_isolated(placed):
