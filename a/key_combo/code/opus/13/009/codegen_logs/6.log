+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+OBJECT_COLORS = (BLUE, ORANGE, TEAL, MAROON)
+SPACINGS = (3, 4)
+TRACK_LENGTHS = (3, 4, 5)
+
