+
+def _track_slots(
+    anchor: tuple[int, int],
+    step: tuple[int, int],
+    length: int,
+    index: int,
+) -> tuple[tuple[int, int], ...]:
+    ar, ac = anchor
+    dr, dc = step
+    return tuple((ar + (i - index) * dr, ac + (i - index) * dc) for i in range(length))
