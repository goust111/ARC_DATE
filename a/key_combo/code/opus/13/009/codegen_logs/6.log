+    h, w = shape
+    coords = [tuple(map(int, rc)) for rc in component["coords"]]
+    candidates = {}
+    for anchor in coords:
+        for orient in ("h", "v"):
+            for spacing in SPACINGS:
+                step = (0, spacing) if orient == "h" else (spacing, 0)
