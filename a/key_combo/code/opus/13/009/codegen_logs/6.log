+            random.shuffle(options)
+            for spec in options[:40]:
+                if not _input_clear(spec, placed_specs):
+                    continue
+                if not _future_safe(spec, placed_specs):
+                    continue
+                out = dict(spec)
+                out["color"] = color
+                return out
+    return None
