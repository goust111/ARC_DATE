+def _coords_from_anchor(anchor: tuple[int, int], rels: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    ar, ac = anchor
+    return tuple(sorted((ar + dr, ac + dc) for dr, dc in rels))
