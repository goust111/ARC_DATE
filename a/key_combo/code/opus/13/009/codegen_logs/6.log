+    occupancy: dict[tuple[int, int], list[int]] = {}
+    for idx, coords in enumerate(moved_coords):
+        for cell in coords:
+            occupancy.setdefault(cell, []).append(idx)
+
+    collided = set()
+    for idxs in occupancy.values():
+        if len(idxs) > 1:
+            collided.update(idxs)
+    return moved_coords, collided
