+    return tuple(sorted((ar + dr, ac + dc) for dr, dc in rels))
+
+
+def _shift_coords(coords: tuple[tuple[int, int], ...], step: tuple[int, int]) -> tuple[tuple[int, int], ...]:
+    dr, dc = step
+    return tuple(sorted((r + dr, c + dc) for r, c in coords))
