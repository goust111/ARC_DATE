+def _input_clear(spec: dict, placed_specs: list[dict]) -> bool:
+    input_cells = set(spec["input_cells"])
+    for other in placed_specs:
+        if input_cells & set(other["input_cells"]):
+            return False
+    for other in placed_specs:
