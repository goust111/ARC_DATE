0013: def main(grid: np.ndarray) -> np.ndarray:
0014:     """Slide every colored object rightward until it is blocked by the edge or by an object that started farther right.
0015: 
0016:     Input structure
0017:     A black-background grid contains several monochromatic foreground objects, each a 4-connected component.
0018: 
0019:     Rule
0020:     Clear the foreground, then process objects from right to left by their original bounding boxes.
0021:     Each object keeps its shape and color while repeatedly moving one cell to the right until its next step would leave the grid or overlap an already placed object.
0022: 
0023:     Key insight
0024:     The objects behave like horizontal gravity: rightmost objects settle first and become blockers, so later objects cannot pass through them even if there is empty space beyond.
0025:     """
0026:     g = np.asarray(grid, dtype=int)
0027:     assert g.ndim == 2
0028: 
0029:     bg = get_bg(g)
0030:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True)
0031:     assert components
0032: 
0033:     h, w = g.shape
0034:     out = np.full_like(g, bg)
0035:     occupied = np.zeros((h, w), dtype=bool)
0036: 
0037:     for component in sorted(components, key=_right_slide_order):
0038:         color = int(component["color"])
0039:         coords = np.asarray(component["coords"], dtype=int)
0040:         assert coords.ndim == 2 and coords.shape[1] == 2
0041:         assert color != bg
0042: 
0043:         shift = 0
0044:         rows = coords[:, 0]
0045:         cols = coords[:, 1]
0046:         while True:
0047:             next_cols = cols + shift + 1
0048:             if np.any(next_cols >= w):
0049:                 break
0050:             if np.any(occupied[rows, next_cols]):
0051:                 break
0052:             shift += 1
0053: 
0054:         dest_cols = cols + shift
0055:         assert not np.any(occupied[rows, dest_cols])
0056:         out[rows, dest_cols] = color
0057:         occupied[rows, dest_cols] = True
0058: 
0059:     assert int(np.sum(out != bg)) == int(np.sum(g != bg))
0060:     return out
