def _gen_attempt() -> np.ndarray | None:
    h = random.randint(13, 17)
    w = random.randint(13, 17)
    shape = (h, w)
    object_count = random.choice([3, 4])
    colors = random.sample(list(OBJECT_COLORS), object_count)

    if object_count == 3:
        if random.random() < 0.7:
            orientations = ["h", "v", random.choice(["h", "v"])]
        else:
            orientations = [random.choice(["h", "v"]) for _ in range(3)]
    else:
        base = ["h", "v", random.choice(["h", "v"]), random.choice(["h", "v"])]
        random.shuffle(base)
        orientations = base

    pair = _make_collision_pair(shape, (colors[0], colors[1]), orientations[:2])
    if pair is None:
        return None

    placed = pair[:]
    allow_immobile = random.random() < 0.45
    for idx in range(2, object_count):
        orient = orientations[idx]
        spec = _make_safe_spec(
            shape,
            colors[idx],
            placed,
            orient,
            allow_immobile=allow_immobile and idx == object_count - 1,
        )
        if spec is None:
            return None
        placed.append(spec)

    grid = _render_input(placed, shape)

    try:
        out = main(grid)
    except Exception:
        return None
    if out.shape != grid.shape:
        return None

    try:
        obj_count, collided_count, static_count = _object_and_collision_profile(grid)
    except Exception:
        return None
    if obj_count != object_count:
        return None
    if collided_count < 2 or collided_count >= object_count:
        return None
    if static_count == 0 and allow_immobile:
        return None

    return grid


def generate_input() -> np.ndarray:
    for _ in range(800):
        grid = _gen_attempt()
        if grid is None:
            continue
        return grid
    raise RuntimeError("failed to generate a valid orbit-collision sample")

