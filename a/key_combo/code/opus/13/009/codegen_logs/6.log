+    out = np.full_like(g, BLACK)
+    for track in tracks:
+        for r, c in track["slots"]:
+            out[r, c] = GREEN
+    for idx, obj in enumerate(objects):
+        color = RED if idx in collided else int(obj["color"])
+        for r, c in moved_coords[idx]:
+            out[r, c] = color
