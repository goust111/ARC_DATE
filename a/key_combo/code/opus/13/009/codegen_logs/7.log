+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w) or int(grid[r, c]) != BG:
+            return False
+    for r, c in cells:
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if not (0 <= nr < h and 0 <= nc < w):
