def _gen_nearest_rect_area_sum(target, rect_count):
    lo = _GEN_RECT_MIN_AREA * rect_count
    hi = _GEN_RECT_MAX_AREA * rect_count
    possible = [v for v in range(lo, hi + 1) if _gen_can_sum_rect_areas(v, rect_count)]
