+def _repair_black(grid: np.ndarray, template: np.ndarray) -> np.ndarray:
+    pr, pc = template.shape
+    out = np.asarray(grid, dtype=int).copy()
+    for r, c in np.argwhere(out == BLACK):
+        out[int(r), int(c)] = int(template[int(r) % pr, int(c) % pc])
+    return out
