+    cols = np.arange(side)[None, :]
+    dist = np.abs(rows - center) + np.abs(cols - center)
+    out = np.zeros((side, side), dtype=int)
+    for idx, color in enumerate(colors_desc):
+        radius = center - idx
+        assert radius >= 0
