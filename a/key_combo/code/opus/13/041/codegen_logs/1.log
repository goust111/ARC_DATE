+        r0, c0, cells = chosen
+        for r, c in cells:
+            occupied[r, c] = True
+        _mark_forbidden(forbidden, cells, gap=2)
+        placed.append(
+            {
+                "length": int(length),
+                "color": int(color),
+                "orientation": orientation,
+                "top_left": (int(r0), int(c0)),
+                "cells": cells,
+            }
+        )
+    return placed
+
+
+def _render_input(shape: tuple[int, int], placed: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
