+    if mask is None:
+        return None
+
+    pattern = _paint_pattern(mask)
+    if pattern is None:
+        return None
+
+    legends = tuple(random.sample(CORNER_PALETTE, 4))
+    inp = _embed_with_corners(pattern, legends)
+    if not _validate_example(inp):
+        return None
+    return inp
+
