+    offsets: dict[int, tuple[int, int]],
+    group_ids: dict[int, int],
+    noise_cells: list[tuple[int, int]],
+) -> bool:
+    h, w = grid.shape
+    rank = {color: i for i, color in enumerate(order)}
+    template_union: set[tuple[int, int]] = set()
+    seen_cross_group_overlap = False
