+        prev = cut
+    return vals
+
+
+def _group_sizes(n: int) -> list[int]:
+    min_groups = 2
+    max_groups = min(3, n)
+    choices = []
+    for parts in range(min_groups, max_groups + 1):
+        for cuts in itertools.combinations(range(1, n), parts - 1):
+            vals = []
+            prev = 0
+            for cut in cuts + (n,):
+                vals.append(cut - prev)
+                prev = cut
+            if max(vals) <= GEN_MAX_GROUP_SIZE:
+                choices.append(vals)
