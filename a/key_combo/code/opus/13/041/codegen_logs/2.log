+    rows = int(math.ceil(len(colors) / 3))
+    out = np.zeros((rows, 3), dtype=int)
+    for idx, color in enumerate(colors):
+        r = idx // 3
+        k = idx % 3
+        c = k if r % 2 == 0 else 2 - k
