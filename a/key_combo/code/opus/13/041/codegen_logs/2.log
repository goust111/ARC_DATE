+        return []
+    matches: set[tuple[int, int]] = set()
+    for r, c in coords:
+        for dr, dc in RING_CELLS:
+            offset = (r - dr, c - dc)
+            if all((rr - offset[0], cc - offset[1]) in RING_SET for rr, cc in coords):
+                matches.add(offset)
+    return sorted(matches)
