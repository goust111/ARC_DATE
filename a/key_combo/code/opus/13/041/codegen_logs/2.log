+def _group_sizes(n: int) -> list[int]:
+    min_groups = 2
+    max_groups = min(3, n)
+    choices = []
+    for parts in range(min_groups, max_groups + 1):
+        for cuts in itertools.combinations(range(1, n), parts - 1):
