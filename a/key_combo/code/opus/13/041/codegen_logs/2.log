+    order: list[int] = []
+    while remaining:
+        ready = [color for color in remaining if indegree[color] == 0]
+        if not ready:
+            raise AssertionError("occlusion relation must be acyclic")
+        ready.sort(key=lambda color: sprites[color]["offset"])
+        color = ready[0]
+        order.append(color)
+        remaining.remove(color)
