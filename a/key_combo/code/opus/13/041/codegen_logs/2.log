+        coords = {tuple(map(int, rc)) for rc in np.argwhere(grid == color)}
+        if len(coords) < 4:
+            continue
+        offsets = _matching_offsets(coords)
+        if len(offsets) != 1:
+            continue
+        offset = offsets[0]
