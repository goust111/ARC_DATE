+def _pad_union(masks: list[np.ndarray]) -> np.ndarray:
+    h = max(mask.shape[0] for mask in masks)
+    w = max(mask.shape[1] for mask in masks)
+    out = np.zeros((h, w), dtype=bool)
+    for mask in masks:
+        mh, mw = mask.shape
+        out[:mh, :mw] |= mask
+    return out
