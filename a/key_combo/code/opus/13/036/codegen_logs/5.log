+    grid[top : top + LATTICE_SIZE, left : left + LATTICE_SIZE] = BASE
+    for rel in SEPARATOR_INDEXES:
+        grid[top + rel, left : left + LATTICE_SIZE] = SEPARATOR
+        grid[top : top + LATTICE_SIZE, left + rel] = SEPARATOR
+    return grid
+
