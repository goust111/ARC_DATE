+REL_TO_TILE = {
+    0: (0, 0),
+    1: (0, 1),
+    2: (0, 2),
+    4: (1, 0),
+    5: (1, 1),
+    6: (1, 2),
+    8: (2, 0),
+    9: (2, 1),
+    10: (2, 2),
+}
+LOCAL_OFFSETS = tuple((lr, lc) for lr in range(TILE_SIZE) for lc in range(TILE_SIZE))
+TILE_DIRS = {
+    (-1, 0): "U",
+    (1, 0): "D",
+    (0, -1): "L",
+    (0, 1): "R",
+}
+ANCHORS = {"U": (0, 1), "D": (2, 1), "L": (1, 0), "R": (1, 2)}
