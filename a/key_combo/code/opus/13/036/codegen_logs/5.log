+    for r, c in np.argwhere(g != BG):
+        r = int(r)
+        c = int(c)
+        color = int(g[r, c])
+        if color in (BASE, PATH, SEPARATOR, ENDPOINT):
+            continue
+        tile_r, tile_c, local_r, local_c = _tile_local_from_raw(top, left, r, c)
+        markers.append(
+            {
+                "color": color,
+                "tile": (tile_r, tile_c),
+                "local": (local_r, local_c),
