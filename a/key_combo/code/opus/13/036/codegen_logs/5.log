+
+
+def _render_wrong_pixel_step_output(scene: dict) -> np.ndarray:
+    out = scene["grid"].copy()
+    out[(out == PATH) | (out == ENDPOINT)] = scene["base"]
+    dr, dc = scene["vector"]
+    for marker in scene["markers"]:
+        r, c = marker["raw"]
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+            out[rr, cc] = marker["color"]
