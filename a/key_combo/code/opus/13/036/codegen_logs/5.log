+GRID_MIN = 13
+GRID_MAX = 17
+LATTICE_SIZE = 11
+TILE_COUNT = 3
+TILE_SIZE = 3
+TILE_STEP = 4
+SEPARATOR_INDEXES = {3, 7}
+MARKER_COLORS = (1, 2, 3, 4, 7)
+VECTOR_OPTIONS = (
+    (0, 1),
+    (0, 2),
+    (1, -1),
+    (1, 0),
+    (1, 1),
+    (2, 0),
+)
+MAX_ATTEMPTS = 400
+
+REL_TO_TILE = {
+    0: (0, 0),
+    1: (0, 1),
+    2: (0, 2),
+    4: (1, 0),
+    5: (1, 1),
+    6: (1, 2),
+    8: (2, 0),
+    9: (2, 1),
+    10: (2, 2),
+}
+LOCAL_OFFSETS = tuple((lr, lc) for lr in range(TILE_SIZE) for lc in range(TILE_SIZE))
+TILE_DIRS = {
+    (-1, 0): "U",
+    (1, 0): "D",
+    (0, -1): "L",
+    (0, 1): "R",
+}
+ANCHORS = {"U": (0, 1), "D": (2, 1), "L": (1, 0), "R": (1, 2)}
