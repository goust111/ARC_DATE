+
+        start = min(endpoint_raw)
+        end = max(endpoint_raw)
+        paths = _enumerate_paths(start, end, (top, left, top + 10, left + 10), reserved)
+        if len(paths) < 2:
+            continue
+        path = random.choice(paths)
+
+        input_grid = _render_input_scene(
+            height,
+            width,
+            top,
+            left,
+            vector,
+            endpoint_src,
+            marker_tiles,
+            marker_offsets,
+            marker_colors,
+            path,
+        )
+
+        try:
+            _check_semantics(input_grid)
+        except AssertionError:
+            continue
+        return input_grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

