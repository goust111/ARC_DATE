+REL_TO_TILE = {
+    0: (0, 0),
+    1: (0, 1),
+    2: (0, 2),
+    4: (1, 0),
+    5: (1, 1),
+    6: (1, 2),
+    8: (2, 0),
+    9: (2, 1),
+    10: (2, 2),
