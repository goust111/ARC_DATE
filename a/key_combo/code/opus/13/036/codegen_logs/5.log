+def _build_segments(points: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    path = [points[0]]
+    for nr, nc in points[1:]:
+        r, c = path[-1]
+        if r != nr and c != nc:
+            return []
+        step_r = 0 if r == nr else (1 if nr > r else -1)
+        step_c = 0 if c == nc else (1 if nc > c else -1)
+        while (r, c) != (nr, nc):
+            r += step_r
+            c += step_c
+            path.append((r, c))
+    return path
+
