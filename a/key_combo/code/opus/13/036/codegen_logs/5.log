+import numpy as np
+
+
+BG = 0
+PATH = 5
+SEPARATOR = 6
+BASE = 8
+ENDPOINT = 9
+
+GRID_MIN = 13
+GRID_MAX = 17
+LATTICE_SIZE = 11
+TILE_COUNT = 3
+TILE_SIZE = 3
+TILE_STEP = 4
+SEPARATOR_INDEXES = {3, 7}
