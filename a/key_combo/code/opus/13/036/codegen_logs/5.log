+        blocked_local = set()
+        for raw in blocked_raw:
+            try:
+                tile_r, tile_c, local_r, local_c = _tile_local_from_raw(top, left, raw[0], raw[1])
+            except AssertionError:
+                continue
+            if (tile_r, tile_c) == tile:
+                blocked_local.add((local_r, local_c))
