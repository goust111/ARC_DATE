+            nc = tile_c + dc
+            nxt = (nr, nc)
+            if not (0 <= nr < TILE_COUNT and 0 <= nc < TILE_COUNT):
+                continue
+            if nxt in path:
+                continue
+            dfs(path + [nxt])
