    carrier = next(iter(adjacent))
    assert carrier in {Color.BLUE, Color.TEAL}, "carrier color must be blue or teal"
    return carrier


def _containing_region(base: np.ndarray, coords: np.ndarray, color: int) -> np.ndarray:
