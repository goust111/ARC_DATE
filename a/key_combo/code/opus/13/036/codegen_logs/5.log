+        if 0 <= target_tile_r < TILE_COUNT and 0 <= target_tile_c < TILE_COUNT:
+            rr, cc = _raw_from_tile(top, left, target_tile_r, target_tile_c, 1, 1)
+            out[rr, cc] = marker["color"]
