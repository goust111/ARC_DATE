+            cc = tile_c + dc
+            if 0 <= rr < TILE_COUNT and 0 <= cc < TILE_COUNT:
+                remaining = [
+                    (r, c)
+                    for r in range(TILE_COUNT)
+                    for c in range(TILE_COUNT)
+                    if (r, c) not in {(tile_r, tile_c), (rr, cc)}
+                    and 0 <= r + dr < TILE_COUNT
+                    and 0 <= c + dc < TILE_COUNT
