+def _assign_colors(mask: np.ndarray, palette: list[int]) -> np.ndarray:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    assert coords
+    assert 2 <= len(palette) <= min(3, len(coords))
