+    targets = info["targets"]
+    erased = info["erased"]
+    kept = info["kept"]
+    deleted = info["deleted"]
+    kind = info["axis_kind"]
+    axis = info["axis_index"]
+    r0, c0, r1, c1 = info["bbox"]
+    out = info["output"]
