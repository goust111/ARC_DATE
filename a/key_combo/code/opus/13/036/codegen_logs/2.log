+    else:
+        if np.all(grid[r0 : r1 + 1, axis] == BG):
+            return False
+        left = sum(np.any(comp[:, 1] < axis) for comp in kept)
+        right = sum(np.any(comp[:, 1] > axis) for comp in kept)
