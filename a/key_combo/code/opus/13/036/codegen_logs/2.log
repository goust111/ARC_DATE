+    rows = [r for r in range(r0 + 1, r1) if np.all(grid_after_erase[r, c0 : c1 + 1] == BG)]
+    cols = [c for c in range(c0 + 1, c1) if np.all(grid_after_erase[r0 : r1 + 1, c] == BG)]
+    axes = [("row", r) for r in rows] + [("col", c) for c in cols]
