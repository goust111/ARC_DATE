+    if len(candidates) < count:
+        return None
+
+    settled = tuple(_settled_positions_for_axis(direction, count, h, w))
+    options = list(itertools.combinations(candidates, count))
+    if mode == "stay":
+        return settled if settled in options else None
+    if mode == "move":
