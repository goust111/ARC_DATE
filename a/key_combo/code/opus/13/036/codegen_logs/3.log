+    move_idx = rng.randrange(len(group_specs))
+    stay_idx = rng.randrange(len(group_specs))
+    groups: list[dict] = []
+
+    for idx, ((direction, line), count) in enumerate(zip(group_specs, counts)):
+        mode = "any"
+        if idx == move_idx:
+            mode = "move"
+        elif idx == stay_idx and count == 1:
