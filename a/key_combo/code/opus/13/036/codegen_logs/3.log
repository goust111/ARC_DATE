+def _parse_frame(grid: np.ndarray) -> tuple[int, dict[str, int], dict[int, str]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
+    assert 3 <= h <= 30 and 3 <= w <= 30
+
+    bg = int(g[0, 0])
