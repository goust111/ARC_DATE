+    return {
+        "direction": direction,
+        "line": int(line),
+        "count": count,
+        "sources": sources,
+        "settled": settled,
+        "corridor": corridor,
+        "moved": moved,
+    }
+
+
+def _cap_cells(direction: str, pos: tuple[int, int], h: int, w: int) -> list[tuple[int, int]]:
+    r, c = pos
+    if direction == "up":
+        return [(0, cc) for cc in range(c - 1, c + 2) if 0 <= cc < w]
+    if direction == "down":
+        return [(h - 1, cc) for cc in range(c - 1, c + 2) if 0 <= cc < w]
+    if direction == "left":
