import random, numpy as np
from collections import Counter

def bounce_wave():
    h=random.randint(5,8); w=random.randint(8,14)
    top=[0]
    dir_top=1
    for _ in range(1,w):
        if top[-1] <= 0: dir_top=1
        elif top[-1] >= h-3: dir_top=-1
        step=dir_top if random.random()<0.75 else 0
        top.append(max(0,min(h-3, top[-1]+step)))
    # ensure amplitude
    if max(top)-min(top)<2: return None
    thickness=[random.randint(2, min(5,h-top[0]))]
    dir_thick = 1 if random.random()<0.5 else -1
    for c in range(1,w):
        max_t=min(5,h-top[c])
        if thickness[-1] <= 2: dir_thick=1
        elif thickness[-1] >= max_t: dir_thick=-1
        step=dir_thick if random.random()<0.7 else 0
        cand=thickness[-1]+step
        cand=max(2,min(max_t,cand))
        thickness.append(cand)
    bottom=[top[i]+thickness[i]-1 for i in range(w)]
    if max(bottom)"'!=h-1 or max(bottom)-min(bottom)<2: return None
    g=np.zeros((h,w),int)
    for c in range(w): g[top[c]:bottom[c]+1,c]=7
    return g

def stack(p):
    h,w=p.shape
    out=np.zeros((4*h-3,w),dtype=int)
    pf=np.flipud(p)
    for k,patch in enumerate([p,pf,p,pf]):
        r0=k*(h-1)
        out[r0:r0+h][patch!=0]=7
    return out

def holes(g):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    arr=[]
    for r in range(H):
      for c in range(W):
        if g[r,c]!=0 or seen[r,c]: continue
        st=[(r,c)]; seen[r,c]=1; comp=[]; edge=False
        while st:
          x,y=st.pop(); comp.append((x,y)); edge|=x in (0,H-1) or y in (0,W-1)
          for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not seen[nx,ny]: seen[nx,ny]=1; st.append((nx,ny))
        if not edge: arr.append(len(comp))
    return arr

shape=Counter(); acc=Counter(); valid=0
for i in range(5000):
    g=bounce_wave()
    if g is None: continue
    valid+=1
    shape[g.shape[0]]+=1
    hs=holes(stack(g))
    if len(hs)>=2 and len(set(hs))>=2 and any(a%2 for a in hs) and any(a%2==0 for a in hs):
        acc[g.shape[0]]+=1
print('"'valid',valid,shape)
print('acc',acc)
