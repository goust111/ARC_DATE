+    keep_mask = stacked != BG
+    if not np.array_equal(out[keep_mask], stacked[keep_mask]):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    target_height = random.randint(5, 8)
+    for _ in range(INNER_HEIGHT_ATTEMPTS):
