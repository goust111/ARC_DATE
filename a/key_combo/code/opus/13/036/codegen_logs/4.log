0039:     r, c = map(int, coords[0])
0040: 
0041:     H, W = input_grid.shape
0042: 
0043:     # Shoot diagonally up-right, bouncing off left/right walls until exiting the top.
0044:     dr, dc = -1, 1
0045:     while 0 <= r < H and 0 <= c < W:
0046:         input_grid[r, c] = Color.BLUE
0047:         nr = r + dr
0048:         nc = c + dc
0049:         if nr < 0:
0050:             break
0051:         if nc < 0 or nc >= W:
0052:             dc = -dc
0053:             nc = c + dc
0054:         r, c = nr, nc
0055:     
0056:     old_background = Color.BLACK
0057:     new_background = Color.TEAL
0058:     input_grid[input_grid == old_background] = new_background
0059:     
0060:     return input_grid
