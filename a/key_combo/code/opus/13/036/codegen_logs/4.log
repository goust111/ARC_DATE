import random, numpy as np
from collections import Counter

def sample_one():
    h=random.randint(5,8); w=random.randint(8,14)
    top=[random.randint(0,h-3)]
    thickness=[random.randint(2, min(5,h-top[0]))]
    for _ in range(1,w):
        nt=max(0,min(h-3, top[-1]+random.choice([-1,0,1])))
        lo=max(2, thickness[-1]-1)
        hi=min(5, thickness[-1]+1, h-nt)
        if lo>hi:
