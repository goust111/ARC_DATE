+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = np.full((4 * h - 3, w), BG, dtype=int)
+    flipped = np.flipud(g)
+    for k, patch in enumerate((g, flipped, g, flipped)):
+        r0 = k * (h - 1)
+        block = out[r0 : r0 + h]
+        block[patch != BG] = patch[patch != BG]
+    return out
+
+
