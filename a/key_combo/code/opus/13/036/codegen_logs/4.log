import random, numpy as np

def gen():
    h = random.randint(5,8)
    w = random.randint(8,14)
    top=[random.randint(0,max(0,h-4))]
    thick=[random.randint(2, min(4,h-top[0]))]
    for c in range(1,w):
        nt = min(max(top[-1]+random.choice([-1,0,1]),0), h-3)
        lo=max(2, thick[-1]-1)
        hi=min(4, h-nt)
        if lo>hi:
            nt=min(nt,h-4)
            hi=min(4,h-nt)
            lo=max(2,thick[-1]-1)
        if lo>hi:
            return None
        nk=random.randint(lo,hi)
        top.append(nt); thick.append(nk)
    bot=[top[c]+thick[c]-1 for c in range(w)]
    if max(top)-min(top) < 2 or max(bot)-min(bot)<2:
        return None
    g=np.zeros((h,w),dtype=int)
    for c in range(w):
        g[top[c]:bot[c]+1,c]=7
    return g

def stack(p):
    h,w=p.shape
    out=np.zeros((4*h-3,w),dtype=int)
    pf=np.flipud(p)
    for k,patch in enumerate([p,pf,p,pf]):
        r0=k*(h-1)
        out[r0:r0+h] = np.where(patch"'!=0, patch, out[r0:r0+h])
    return out

def holes(g):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    comps=[]
    for r in range(H):
      for c in range(W):
        if g[r,c]!=0 or seen[r,c]: continue
        st=[(r,c)]; seen[r,c]=1; pts=[]; edge=False
        while st:
          x,y=st.pop(); pts.append((x,y))
          if x in (0,H-1) or y in (0,W-1): edge=True
          for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not seen[nx,ny]: seen[nx,ny]=1; st.append((nx,ny))
        if not edge: comps.append(len(pts))
    return comps

ok=0
for i in range(5000):
