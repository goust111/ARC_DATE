        if lo>hi: return None
        top.append(nt)
        thickness.append(random.randint(lo,hi))
    bottom=[top[i]+thickness[i]-1 for i in range(w)]
    if min(top)"'!=0 or max(bottom)!=h-1: return None
    if max(top)-min(top) < 2 or max(bottom)-min(bottom) < 2: return None
    g=np.zeros((h,w),int)
    for c in range(w): g[top[c]:bottom[c]+1,c]=7
    return g

def stack(p):
    h,w=p.shape
    out=np.zeros((4*h-3,w),dtype=int)
    pf=np.flipud(p)
    for k,patch in enumerate([p,pf,p,pf]):
        r0=k*(h-1)
        out[r0:r0+h][patch!=0]=7
    return out

def holes(g):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    arr=[]
    for r in range(H):
      for c in range(W):
        if g[r,c]!=0 or seen[r,c]: continue
        st=[(r,c)]; seen[r,c]=1; comp=[]; edge=False
        while st:
          x,y=st.pop(); comp.append((x,y)); edge|=x in (0,H-1) or y in (0,W-1)
          for nx,ny in ((x-1,y),(x+1,y),(x,y-1),(x,y+1)):
            if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not seen[nx,ny]: seen[nx,ny]=1; st.append((nx,ny))
        if not edge: arr.append(len(comp))
    return arr

shape=Counter(); acc=Counter(); valid=0
for i in range(5000):
    g=sample_one()
    if g is None: continue
    valid+=1
    shape[g.shape[0]]+=1
    hs=holes(stack(g))
    if len(hs)>=2 and len(set(hs))>=2 and any(a%2 for a in hs) and any(a%2==0 for a in hs):
