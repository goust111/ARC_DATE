+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+INPUT_COLORS = (4, 5, 6, 7, 8, 9)
+GEN_ATTEMPTS = 800
+INNER_HEIGHT_ATTEMPTS = 60
+
+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    assert coords.size > 0
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_to_foreground(grid: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(grid != BG)
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _single_foreground_color(grid: np.ndarray) -> int:
+    colors = sorted(set(map(int, grid.flat)) - {BG})
+    assert len(colors) == 1
+    return int(colors[0])
+
+
+def _stack_wave(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = np.full((4 * h - 3, w), BG, dtype=int)
+    flipped = np.flipud(g)
+    for k, patch in enumerate((g, flipped, g, flipped)):
+        r0 = k * (h - 1)
+        block = out[r0 : r0 + h]
+        block[patch != BG] = patch[patch != BG]
+    return out
+
+
+def _enclosed_black_regions(grid: np.ndarray) -> list[np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    regions: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if g[r, c] != BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            touches_edge = False
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
