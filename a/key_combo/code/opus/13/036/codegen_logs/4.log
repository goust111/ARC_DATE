+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    regions: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if g[r, c] != BG or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            touches_edge = False
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                if cr == 0 or cr == h - 1 or cc == 0 or cc == w - 1:
