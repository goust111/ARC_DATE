+
+def _trace_bounce_path(h: int, w: int, start_c: int, dc: int) -> list[Coord]:
+    r = h - 1
+    c = start_c
+    out: list[Coord] = []
+    step_c = dc
+    while True:
+        out.append((r, c))
+        nr = r - 1
+        if nr < 0:
+            break
+        nc = c + step_c
+        if nc < 0 or nc >= w:
+            step_c = -step_c
+            nc = c + step_c
+        r, c = nr, nc
+    return out
+
+
+def _label_passable(passable: np.ndarray) -> tuple[np.ndarray, list[list[Coord]]]:
+    h, w = passable.shape
+    labels = np.full((h, w), -1, dtype=int)
+    comps: list[list[Coord]] = []
+    cid = 0
+    for r in range(h):
+        for c in range(w):
+            if not passable[r, c] or labels[r, c] >= 0:
+                continue
+            q: deque[Coord] = deque([(r, c)])
+            labels[r, c] = cid
+            comp: list[Coord] = []
+            while q:
