{
  "type": "transform_in_place",
  "src": "4-connected monochromatic foreground components among scattered distractor pixels",
  "transform": "select the unique largest component and render only that component over bg",
  "grid_shape": "tight bbox crop of the selected component"
}
</annotation>
<generation_spec>
