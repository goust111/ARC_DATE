+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": int(len(cells)),
+                }
+            )
+    return comps
+
+
+def _is_hollow_square_frame(comp: dict) -> bool:
+    if int(comp["color"]) != FRAME:
+        return False
+    coords = comp["coords"]
+    r0, c0, r1, c1 = comp["bbox"]
+    side_h = r1 - r0 + 1
+    side_w = c1 - c0 + 1
+    if side_h != side_w or side_h < 5:
+        return False
+    expected = 4 * side_h - 4
+    if int(comp["area"]) != expected:
+        return False
