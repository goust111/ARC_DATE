def _gen_normalize_shape(shape):
    r0 = min(r for r, _c in shape)
    c0 = min(c for _r, c in shape)
    return frozenset((r - r0, c - c0) for r, c in shape)


_GEN_SKELETON_CACHE = {}


def _gen_skeleton_pool(size):
