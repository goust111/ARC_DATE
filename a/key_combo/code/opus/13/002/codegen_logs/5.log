+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_RETRIES):
+        grid = _gen_attempt()
+        try:
+            out = main(grid)
+        except Exception:
+            continue
+        if grid.ndim != 2 or out.ndim != 2:
+            continue
+        if max(grid.shape) > 30 or max(out.shape) > 30:
+            continue
+        return grid
