  "transform": "replace each contiguous background row band and column band by one output pixel; fill every output pixel with the input background color",
  "grid_shape": "number of non-separator row bands x number of non-separator column bands"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10-27 rows x 10-27 cols, always square [observed]
  colors: exactly 2 — one background (most frequent), one foreground
  separators:
    description: foreground pixels form exactly the union of complete horizontal rows and complete vertical columns (no extra foreground pixels)
    row_count: 1-4 full separator rows
    col_count: 3-4 full separator columns
    width: always 1 pixel each
    border_lines: may include grid border (row 0 / col 0 / last row / last col) [observed: rare, 1 of 4 examples]
    no_adjacent: consecutive separator rows/cols allowed (they just reduce band size)
  bands:
    row_bands: 2-5 contiguous non-separator row regions
    col_bands: 3-5 contiguous non-separator column regions
    band_size: each band >=1 row/col wide
    band_sizes_vary: bands within one grid have different widths (not uniform) [observed]
  output:
    shape: (number_of_row_bands) x (number_of_col_bands), range 2-5 x 3-5
    content: uniform grid filled entirely with the background color

generation_strategy:
  approach: output-first
  steps:
    1. Pick output dims out_h in [2,5], out_w in [3,5]
    2. For each of the out_h row bands, pick a band height >=1; for each of the out_w col bands, pick a band width >=1
    3. Pick (out_h - 1) interior row separators, optionally add 0-2 border separators (top/bottom); similarly (out_w - 1) interior col separators plus optional border separators — each 1px wide
    4. Total grid size = sum(row_band_heights) + num_row_seps, similarly for cols; ensure total in [10, 27]
    5. Pick bg and fg colors (distinct, any from 0-9)
    6. Fill grid with bg; set each full separator row and column to fg
    7. Verify foreground == union of full rows and full cols (guaranteed by construction)
