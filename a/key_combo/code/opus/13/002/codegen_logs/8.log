spec:
  grid: 30x30, background color 0
  signal_object:
    type: single 4-connected monochromatic foreground component
    color: unique color not used by any distractor
    bbox: 3-5 rows x 3-4 cols
    area: 6-12 pixels, fill ratio 67-80% of bbox
    connectivity: exactly 1 connected component (no disconnected parts)
    must be strictly the largest component, >=3x the second largest
  distractors:
    count: 36-112 small components scattered across the grid
    colors: 1-3 distinct colors, all different from signal color
    component_area: 1-4 pixels each (mostly 1, a few 2, rarely 3-4)
    no distractor overlaps with signal bounding box [observed]
  fg_density: 5-16% of grid cells are non-background
  total_distinct_fg_colors: 2-4 (1 signal + 1-3 distractor colors)
  output: tight bounding-box crop of the signal object on bg

generation_strategy:
