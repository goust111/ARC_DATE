+            return None
+
+        patch = _coords_to_patch(shape, color)
+        specs.append(
+            {
+                "color": int(color),
+                "patch": patch,
+                "height": int(patch.shape[0]),
+                "width": int(patch.shape[1]),
+                "bbox_area": int(patch.shape[0] * patch.shape[1]),
+            }
+        )
+
+    return specs
+
