+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_candidate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

