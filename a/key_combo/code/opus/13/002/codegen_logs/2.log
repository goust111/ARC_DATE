+    rng: np.random.Generator, n: int, sep_rows: list[int], sep_cols: list[int]
+) -> np.ndarray | None:
+    grid = np.full((n, n), BG, dtype=int)
+    grid[sep_rows, :] = FG
+    grid[:, sep_cols] = FG
