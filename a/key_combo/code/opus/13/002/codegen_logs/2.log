+    return len(sep_rows) + 1, len(sep_cols) + 1
+
+
+def _choose_separator_layout(rng: np.random.Generator, n: int) -> tuple[list[int], list[int], str]:
+    mid = n // 2
+    if float(rng.random()) < 0.5:
