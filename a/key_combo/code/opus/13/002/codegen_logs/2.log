+    if np.flatnonzero(full_rows).tolist() != sep_rows:
+        return False
+    if np.flatnonzero(full_cols).tolist() != sep_cols:
+        return False
+
+    expected = np.full(_expected_output_shape(sep_rows, sep_cols), BG, dtype=int)
+    try:
+        if not np.array_equal(main(inp), expected):
+            return False
+    except Exception:
+        return False
+    return True
