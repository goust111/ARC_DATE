+    out = g.copy()
+    for orbit in _all_orbits(n):
+        values = [int(g[r, c]) for r, c in orbit]
+        if MASK not in values:
+            continue
+        visible = {value for value in values if value != MASK}
+        assert len(visible) == 1, "each masked orbit must expose one visible color"
+        fill = visible.pop()
+        for r, c in orbit:
+            if int(out[r, c]) == MASK:
+                out[r, c] = fill
+    return out
+
