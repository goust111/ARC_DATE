spec:
  grid: 24x24 square [observed, even size]
  output_pattern:
    symmetry: full D4 (all 8 symmetries of the square - rotations + reflections)
    colors: 7-8 distinct colors from {1,3,4,5,6,7,8,9}, never 0 or 2
    orbits: 78 total (12 of size 4 on axes/diagonals, 66 of size 8 general position)
    each orbit is uniformly one color; colors assigned randomly across orbits
  mask:
    color: always 2 (red)
    coverage: 3-17% of grid (18-96 pixels)
    shape: 2-4 connected rectangular blobs placed arbitrarily [observed]
    constraint: every D4 orbit has at least 1 unmasked cell (max 50% of orbit masked)
  input: output with mask pixels replacing some cells
  transform: replace each mask pixel with the unique non-mask color from its D4 orbit

generation_strategy:
  approach: output-first then mask
  steps:
    1. Create 24x24 grid. Pick 7-8 colors from {1,3,4,5,6,7,8,9}.
    2. For each of the 78 D4 orbits, assign a random color from the palette.
       Fill all orbit cells with that color. This guarantees full D4 symmetry.
    3. Generate 2-4 axis-aligned rectangles (h in 2-6, w in 2-6) at random positions.
       Union of rectangles forms the mask region.
    4. Validate: for every orbit that intersects the mask, check that at least one
       cell in the orbit is NOT masked. If violated, shrink or shift the rectangle.
    5. Replace masked cells with color 2 to produce the input.
```
