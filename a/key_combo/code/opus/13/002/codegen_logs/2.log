+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    n = int(rng.choice(GRID_SIZES))
+    sep_rows, sep_cols, mode = _choose_separator_layout(rng, n)
+    completed = _render_completed_grid(rng, n, sep_rows, sep_cols)
