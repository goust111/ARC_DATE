+
+
+def _symmetry_orbit(n: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    last = int(n) - 1
+    return tuple(
+        sorted(
+            {
+                (r, c),
+                (c, r),
+                (r, last - c),
+                (last - r, c),
+                (last - r, last - c),
+                (last - c, last - r),
+                (c, last - r),
+                (last - c, r),
+            }
+        )
+    )
+
+
