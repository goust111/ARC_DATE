+    full_rows, full_cols = _separator_lines(restored)
+    out_h = _count_bands(full_rows)
+    out_w = _count_bands(full_cols)
+    assert out_h > 0 and out_w > 0
+    return np.full((out_h, out_w), BG, dtype=int)
