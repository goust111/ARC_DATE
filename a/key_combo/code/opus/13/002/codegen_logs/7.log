                    for height in range(max(GEN_HEIGHT_MIN, min_h), min(GEN_HEIGHT_MAX, max_h) + 1):
                        for width in range(max(GEN_WIDTH_MIN, min_w), min(GEN_WIDTH_MAX, max_w) + 1):
