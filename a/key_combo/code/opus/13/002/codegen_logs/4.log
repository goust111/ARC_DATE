    expected_frame[r0 : r1 + 1, c0] = True
    expected_frame[r0 : r1 + 1, c1] = True
    expected_frame[r0, c0 : c1 + 1] = True
    expected_frame[r1, c0 : c1 + 1] = True
    assert np.array_equal(g == frame_color, expected_frame)

