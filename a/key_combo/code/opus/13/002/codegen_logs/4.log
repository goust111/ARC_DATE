+    notches = _find_notches(g, frame)
+
+    out = g.copy()
+    for notch in notches:
+        for rr, cc in notch["cross"]:
+            out[rr, cc] = int(notch["color"])
+
+    return _expand_territories(out, frame, notches)
+
