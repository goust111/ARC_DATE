+    r0, c0, r1, c1 = box
+    return r0 <= r <= r1 and c0 <= c <= c1
+
+
+def _notch_pattern(r: int, c: int, direction: str) -> dict[str, tuple[tuple[int, int], ...] | str]:
+    dr, dc = DIRS[direction]
+    pr, pc = -dc, dr
+    cross = tuple((r + rr, c + cc) for rr, cc in CROSS)
