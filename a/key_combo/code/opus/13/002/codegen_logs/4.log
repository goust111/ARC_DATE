+    "top": (-1, 0),
+    "right": (0, 1),
+    "bottom": (1, 0),
+    "left": (0, -1),
+}
+CROSS = ((0, 0), (-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATION_ATTEMPTS = 400
