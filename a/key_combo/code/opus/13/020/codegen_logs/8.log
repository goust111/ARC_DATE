+    bbox: tuple[int, int, int, int],
+    rows: list[int],
+    cols: list[int],
+) -> None:
+    r0, c0, r1, c1 = bbox
+    for rr in rows:
+        if random.random() < 0.5:
+            grid[r0 + rr, c0] = BLUE
+        else:
+            grid[r0 + rr, c1] = RED
+    for cc in cols:
+        if random.random() < 0.5:
+            grid[r0, c0 + cc] = GREEN
+        else:
+            grid[r1, c0 + cc] = PINK
+
+
