+    successors = {
+        layer: ring_colors[(layer + 1) % len(ring_colors)] for layer in range(len(ring_colors))
+    }
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            if (r, c) in hit_counts:
+                continue
+            layer = _layer_index(r, c, bbox)
+            if layer in crossing_layers:
