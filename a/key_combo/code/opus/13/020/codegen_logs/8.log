+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+MARKER_TO_DIR = {
+    BLUE: (0, 1),
+    RED: (0, -1),
+    GREEN: (1, 0),
+    PINK: (-1, 0),
+}
+RING_PALETTE = [BLUE, RED, GREEN, YELLOW, GREY, TEAL]
+OUTER_RING_CHOICES = [YELLOW, GREY, TEAL]
+GEN_MAX_ATTEMPTS = 400
+
