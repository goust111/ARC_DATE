+    vote_plans = _make_vote_plan(k, rng)
+    top_marker_used: set[tuple[int, int]] = set()
+    bottom_marker_used: set[tuple[int, int]] = set()
+    top_marker_count = 0
+    bottom_marker_count = 0
+    cross_panel_ok = False
