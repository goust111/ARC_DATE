+    out = main(grid)
+    out_comps = _components(out != BLACK)
+    if len(out_comps) != k:
+        return None
+    out_colors = {int(out[r, c]) for comp in out_comps for r, c in comp}
+    if len(out_colors) < 2:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _assemble_attempt(rng)
+        if grid is not None:
