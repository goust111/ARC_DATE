+    for panel_idx, panel in enumerate((top, bottom)):
+        for r, c in component:
+            for nr, nc in neighbors4(r, c):
+                if not _in_bounds(panel.shape, nr, nc):
+                    continue
+                color = int(panel[nr, nc])
+                if color not in MARKER_COLORS:
+                    continue
+                key = (panel_idx, nr, nc)
+                if key in touches:
+                    continue
+                touches[key] = (color, nr, nc)
