+        if len({trace["direction_color"] for trace in traces}) < min(2, len(traces)):
+            continue
+        if use_pair and not any("deposit" in trace["stop_causes"] for trace in traces):
+            continue
+        if np.count_nonzero(grid == GREY) < 3:
