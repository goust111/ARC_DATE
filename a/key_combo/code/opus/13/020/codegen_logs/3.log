+        target_dirs = []
+        palette = list(MARKER_COLORS)
+        random.shuffle(palette)
+        if remaining > 0:
+            while len(target_dirs) < remaining:
+                target_dirs.append(palette[len(target_dirs) % len(palette)])
+            random.shuffle(target_dirs)
