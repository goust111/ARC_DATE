+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+DIR_BY_MARKER = {
+    RED: (1, 0),      # down
+    GREEN: (0, -1),   # left
+    YELLOW: (0, 1),   # right
+    ORANGE: (-1, 0),  # up
