+def plan_independent(shape: tuple[tuple[int, int], ...], direction_color: int, grid_shape: tuple[int, int], reserved: np.ndarray, must_use_wall: bool) -> dict | None:
+    h, w = grid_shape
+    sh, sw = shape_dims(shape)
