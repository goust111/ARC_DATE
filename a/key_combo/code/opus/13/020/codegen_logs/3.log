+
+def build_grid_from_plans(grid_shape: tuple[int, int], plans: list[dict]) -> np.ndarray:
+    grid = np.zeros(grid_shape, dtype=int)
+    for plan in plans:
+        for r, c in plan["wall_cells"]:
+            grid[r, c] = GREY
+    for plan in plans:
+        for r, c in plan["start_cells"]:
+            grid[r, c] = BLUE
+    for plan in plans:
