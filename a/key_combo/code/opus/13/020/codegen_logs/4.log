+        if mode == "col" and cell[1] >= focus[1]:
+            continue
+        markers.append(cell)
+        used.add(cell)
+        extra_target -= 1
+
+    if target == "tie":
+        adjusted = _tie_adjust_markers(rng, (h, w), rects, markers, band)
+        if adjusted is None:
+            return None
+        markers = adjusted
+
+    if not (6 <= len(markers) <= 12):
+        return None
+
+    r0, c0, r1, c1 = _bbox(markers)
+    bbox_h = r1 - r0 + 1
+    bbox_w = c1 - c0 + 1
+    if target == "row" and bbox_h < bbox_w:
