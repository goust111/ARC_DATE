+        left, right = band
+        for r in range(shape[0]):
+            for c in range(max(0, left - 1), min(shape[1], right + 2)):
+                cell = (r, c)
+                if cell in rect_cells or cell in ring_cells or cell in forbidden:
+                    continue
+                pool.append(cell)
+    else:
+        top, bottom = band
