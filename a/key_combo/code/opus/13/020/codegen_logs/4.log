+
+
+def _tie_adjust_markers(
+    rng: random.Random,
+    shape: tuple[int, int],
+    rects: list[tuple[int, int, int, int]],
+    markers: list[tuple[int, int]],
+    band: tuple[int, int],
+) -> list[tuple[int, int]] | None:
+    r0, c0, r1, c1 = _bbox(markers)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if width > height:
+        return None
+    if width == height:
+        return markers
