+
+def _ring_cells(rect: tuple[int, int, int, int], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    cells: set[tuple[int, int]] = set()
+    for c in range(c0, c1 + 1):
