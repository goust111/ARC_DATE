+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    branches = ["row", "col", "tie"]
+    weights = [4, 4, 2]
+    for _ in range(600):
+        target = rng.choices(branches, weights=weights, k=1)[0]
+        grid = _build_attempt(rng, target)
+        if grid is not None:
