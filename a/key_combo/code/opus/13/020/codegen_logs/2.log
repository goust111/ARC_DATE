+CONTROL_COLORS = (4, 5, 6, 7, 8, 9)
+NON_TL_QUADRANTS = ((0, 1), (1, 0), (1, 1))
+GEN_K_CHOICES = (4, 5, 6)
+GEN_TEMPLATE_SIZE_RANGE = (3, 8)
+GEN_RETRY_LIMIT = 500
+_GEN_BRANCH_COUNTER = 0
