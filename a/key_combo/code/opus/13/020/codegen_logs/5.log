+            if (guide_row - 1, next_col) in obstacles:
+                steps = [(1, 0), (0, 1), (-1, 0)]
+            elif (guide_row + 1, next_col) in obstacles:
+                steps = [(-1, 0), (0, 1), (1, 0)]
+            else:
+                steps = [(0, 1)]
+        else:
+            next_col = c + 1
+            if (path_row, next_col) in obstacles:
+                if path_row == guide_row - 1:
+                    steps = [(1, 0), (0, 1), (0, 1), (-1, 0)]
+                else:
+                    steps = [(-1, 0), (0, 1), (0, 1), (1, 0)]
+            else:
+                steps = [(0, 1)]
+
+        rr, cc = r, c
+        ok = True
+        for dr, dc in steps:
+            rr += dr
+            cc += dc
+            if not _can_traverse(base, rr, cc):
+                ok = False
+                break
+        if not ok:
+            break
+
+        rr, cc = r, c
+        for dr, dc in steps:
