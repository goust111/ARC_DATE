import numpy as np

from arc_utils import bbox_h, bbox_w, colors_present, find_components, get_bg, neighbors4
import random
from functools import lru_cache
from itertools import combinations


Ray = tuple[tuple[int, int], int, list[tuple[int, int]]]

CORNER_OFFSETS = {
    "NW": (-1, -1),
    "NE": (-1, 2),
    "SW": (2, -1),
    "SE": (2, 2),
}

DIAGONAL_DIRS = {
    "NW": (-1, -1),
    "NE": (-1, 1),
    "SW": (1, -1),
    "SE": (1, 1),
}

ROTATED_SOURCE = {
    "NW": "SW",
