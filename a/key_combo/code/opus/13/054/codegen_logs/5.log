+SHAPE_GROUPS: dict[tuple[int, int, int], list[tuple[tuple[int, int], ...]]] = {}
+for shape in SHAPE_POOL:
+    area = len(shape)
+    sh, sw = _shape_dims(shape)
+    SHAPE_GROUPS.setdefault((area, sh, sw), []).append(shape)
