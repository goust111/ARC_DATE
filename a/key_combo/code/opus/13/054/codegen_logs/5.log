+        th = random.randint(max(MIN_TEMPLATE_SIZE, sh + 2), MAX_TEMPLATE_SIZE)
+        tw = random.randint(max(MIN_TEMPLATE_SIZE, sw + 2), MAX_TEMPLATE_SIZE)
+        sizes.append((th, tw))
