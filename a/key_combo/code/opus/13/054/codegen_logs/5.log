+def _distribute(total: int, buckets: int) -> list[int]:
+    cuts = sorted(random.sample(range(total + buckets - 1), buckets - 1))
+    values = []
+    prev = -1
+    for cut in cuts + [total + buckets - 1]:
+        values.append(cut - prev - 1)
+        prev = cut
