+
+def _non_identity_permutation() -> tuple[int, int, int]:
+    perms = [perm for perm in permutations(range(3)) if perm != (0, 1, 2)]
+    return random.choice(perms)
+
+
+def _choose_source_layout(
+    h: int,
+    w: int,
+    divider_c: int,
