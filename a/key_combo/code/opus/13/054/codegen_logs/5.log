+        sh, sw = _shape_dims(shape)
+        c0 = random.randint(1, divider_c - tw - 1)
+        hole_r = random.randint(1, th - sh - 1)
+        hole_c = random.randint(1, tw - sw - 1)
+        layout.append(
+            {
+                "index": idx,
+                "shape": shape,
+                "template_color": color,
