+                out[r0 : r0 + sh, c] = GATE_MARK_COLOR
+    return out
+
+
+def _semantic_checks(inp: np.ndarray, out: np.ndarray, templates: list[dict], sources: list[dict], perm: tuple[int, int, int]) -> bool:
+    if perm == (0, 1, 2):
