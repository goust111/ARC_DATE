+    min_height = sum(th for th, _ in sizes) + MIN_TEMPLATE_GAP * 2
+    h = random.randint(max(22, min_height), min(29, min_height + 5))
+    starts = _place_vertical_spans([th for th, _ in sizes], MIN_TEMPLATE_GAP, h)
+    if starts is None:
