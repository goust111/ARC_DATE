+    color_by_col = {col: OUTPUT_PALETTE[i] for i, col in enumerate(left_cols)}
+
+    out = np.zeros_like(g)
+    for coords, box in survivors:
+        out[coords[:, 0], coords[:, 1]] = color_by_col[box[1]]
