+    raise RuntimeError("failed to generate symmetric mask")
+
+
+def _generate_generic_asymmetric_mask(h: int, w: int, rng: random.Random) -> np.ndarray:
+    area_lo, area_hi = _target_area_range(h, w)
+    for _ in range(MASK_ATTEMPTS):
+        points = [
