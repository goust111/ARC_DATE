+
+
+def _touches_all_bbox_edges(mask: np.ndarray) -> bool:
+    return bool(mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any())
+
+
+def _valid_object_mask(mask: np.ndarray, *, symmetric: bool) -> bool:
+    area = int(mask.sum())
