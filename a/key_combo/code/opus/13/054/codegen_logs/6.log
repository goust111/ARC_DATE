+
+
+def _ensure_mask_library(hole_count: int, target_size: int = 20) -> None:
+    library = _MASK_LIBRARY[hole_count]
+    if len(library) >= target_size:
+        return
+
+    known = {_canonical_mask(mask) for mask in library}
