+from __future__ import annotations
+
+import hashlib
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+
+CELL_SIZE = 5
+CELL_GAP = 1
+MACRO_ROWS = 3
+MACRO_COLS = 4
+GRID_SHAPE = (
+    MACRO_ROWS * CELL_SIZE + (MACRO_ROWS - 1) * CELL_GAP,
+    MACRO_COLS * CELL_SIZE + (MACRO_COLS - 1) * CELL_GAP,
+)
+HOLE_TO_COLOR = {0: GREY, 1: BLUE, 2: RED, 3: GREEN}
