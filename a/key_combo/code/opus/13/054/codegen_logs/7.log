+        return "h", int(w)
+    if w == 1 and bool(mask.all()):
+        return "v", int(h)
+    return None
+
+
+def _balanced_frame_dims(border_pixels: int) -> tuple[int, int]:
+    candidates: list[tuple[int, int]] = []
