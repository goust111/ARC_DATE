+            W = random.randint(*CANVAS_SIDE_RANGE)
+            canvas = np.zeros((H, W), dtype=int)
+            placed = True
+            for patch in sorted(objects, key=lambda arr: (arr.shape[0] * arr.shape[1], arr.shape[0] + arr.shape[1]), reverse=True):
