+    for r in range(H):
+        for c in range(W):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in nbrs:
+                    nr = rr + dr
+                    nc = cc + dc
