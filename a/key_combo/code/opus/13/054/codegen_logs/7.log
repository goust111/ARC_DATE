+
+def _is_axis_symmetric(mask: np.ndarray) -> bool:
+    return bool(np.array_equal(mask, np.fliplr(mask)) or np.array_equal(mask, np.flipud(mask)))
+
+
+def _bar_descriptor(mask: np.ndarray) -> tuple[str, int] | None:
+    h, w = mask.shape
