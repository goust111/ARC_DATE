        if not candidates:
            return False

        pair_candidates = [
            p for p in candidates if _gen_orbit_weight(p[1], w) == MIRROR_ORBIT_PAIR_WEIGHT
        ]
        single_candidates = [
            p for p in candidates if _gen_orbit_weight(p[1], w) == MIRROR_ORBIT_SINGLE_WEIGHT
