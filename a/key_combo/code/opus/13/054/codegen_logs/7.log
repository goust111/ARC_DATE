+
+
+def _crop_component_mask(grid: np.ndarray, comp: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    crop = np.full((r1 - r0 + 1, c1 - c0 + 1), bg, dtype=int)
+    coords = comp["coords"]
+    crop[coords[:, 0] - r0, coords[:, 1] - c0] = comp["color"]
+    return crop != bg
