+    if orient == "h":
+        for row in (0, h - 1):
+            for c0 in range(w - length + 1):
+                cells = tuple((row, c) for c in range(c0, c0 + length))
+                mask = 0
+                for cell in cells:
+                    mask |= 1 << index_by_coord[cell]
+                placements.append((mask, cells))
+    else:
+        for col in (0, w - 1):
+            for r0 in range(h - length + 1):
+                cells = tuple((r, col) for r in range(r0, r0 + length))
+                mask = 0
+                for cell in cells:
+                    mask |= 1 << index_by_coord[cell]
+                placements.append((mask, cells))
