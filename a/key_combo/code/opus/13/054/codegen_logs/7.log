+    best: list[dict] | None = None
+
+    def is_good(solution: list[dict]) -> bool:
+        if len({seg["orient"] for seg in solution}) < 2:
+            return False
+        if len({seg["length"] for seg in solution}) < 2:
+            return False
+        side_counts = {side: 0 for side in ("top", "bottom", "left", "right")}
+        for seg in solution:
