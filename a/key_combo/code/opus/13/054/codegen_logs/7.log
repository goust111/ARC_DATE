+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 7)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+BAR_COUNT_CHOICES = (5,)
+DISTRACTOR_COUNT_CHOICES = (2, 3)
+FRAME_SIDE_RANGE = (4, 8)
+CANVAS_SIDE_RANGE = (15, 18)
