+    total_length = sum(bar["length"] for bar in bars)
+    assert total_length == len(border)
+
+    def search(
+        step: int,
+        used_mask: int,
+        used_cells: int,
+        chosen: list[tuple[int, tuple[tuple[int, int], ...]]],
+    ) -> None:
+        if len(unique_outputs) > 1:
+            return
+        if step == len(order):
+            if used_mask != full_mask:
+                return
