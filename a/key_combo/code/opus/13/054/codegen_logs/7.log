+    order = sorted(
+        range(len(bars)),
+        key=lambda i: (
+            len(placements_by_bar[i]),
+            -bars[i]["length"],
+            bars[i].get("bbox", (0, 0, 0, 0))[0],
+            bars[i].get("bbox", (0, 0, 0, 0))[1],
+        ),
