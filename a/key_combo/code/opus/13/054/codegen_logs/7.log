+
+
+def _border_coords(h: int, w: int) -> list[tuple[int, int]]:
+    return [(r, c) for r in range(h) for c in range(w) if r in (0, h - 1) or c in (0, w - 1)]
+
+
+def _placements_for_bar(
+    orient: str,
+    length: int,
+    h: int,
+    w: int,
+    index_by_coord: dict[tuple[int, int], int],
