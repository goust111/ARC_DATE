+    border = _border_coords(h, w)
+    index_by_coord = {coord: i for i, coord in enumerate(border)}
+    full_mask = (1 << len(border)) - 1
+    placements_by_bar: list[list[tuple[int, tuple[tuple[int, int], ...]]]] = []
