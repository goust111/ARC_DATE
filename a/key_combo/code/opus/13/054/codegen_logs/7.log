+            _v_segment(0, 0, a, "left"),
+            _v_segment(0, a, b, "left"),
+            _v_segment(w - 1, 0, h, "right"),
+            _h_segment(0, 1, w - 2, "top"),
+            _h_segment(h - 1, 1, w - 2, "bottom"),
