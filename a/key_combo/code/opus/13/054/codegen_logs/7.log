+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        bar_count = BAR_COUNT_CHOICES[0]
+        w, h = random.choice(BALANCED_FRAME_CHOICES)
