def _gen_abs_cells(color: int, anchor_row: int) -> set[tuple[int, int]]:
    return {(anchor_row + dr, c) for dr, c in _glyph_cells(color, _GEN_SIZE)}


def _gen_valid_rows(color: int) -> list[int]:
