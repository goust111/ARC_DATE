spec:
  grid: 20x20, background 0
  frame:
    two full-height vertical bars at col 0 and col 19, single color
    frame_color: any color not used as glyph/marker in this example (observed from {1,2,5,7,9})
  interior: cols 1-18, rows 0-19
  glyph_colors: exactly 5 fixed templates keyed by color (1,2,3,6,7)
    color_1: height 3 (dr -1..+1), 22 cells — bar + 2 prongs near right end
    color_2: height 5 (dr -2..+2), 24 cells — bar + diamond at left-center
    color_3: height 5 (dr -2..+2), 21 cells — bar with gap + diamond at left
    color_6: height 6 (dr -2..+3), 29 cells — bar with gap + box at left
    color_7: height 5 (dr -2..+2), 26 cells — bar + 2 prongs near right
  input_content:
    exactly 1 full glyph rendered at some anchor row (its horizontal bar row)
    1-2 marker colors, each as a pair of pixels at (anchor_row, col 1) and (anchor_row, col 18)
    all colors distinct from each other and from frame_color
    marker anchor rows must allow full glyph expansion within rows 0-19
    expanded glyphs must not overlap each other (no shared cells)
  output:
    erase the full glyph; expand each marker pair into its color's template anchored on marker row
    frame unchanged; erased glyph area becomes background

generation_strategy:
  approach: output-first
  steps:
    1. Pick frame_color from {0..9} excluding glyph palette {1,2,3,6,7}; viable = {0,4,5,8,9} but frame != 0 (bg) [observed {1,2,5,7,9} — frame CAN be a glyph color if not used as glyph in this example]
