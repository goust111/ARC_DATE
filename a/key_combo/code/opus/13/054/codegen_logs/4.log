ARC_COLORS, PANEL_BORDER, PANEL_GAP, PADDING_CONNECTIVITY = range(1, 10), 1, 2, 8
# Retry limit and 4-neighbor growth.
MAX_GENERATION_ATTEMPTS, NEIGHBORS4 = 300, ((-1, 0), (1, 0), (0, -1), (0, 1))

def _gen_neighbors4(r, c, h, w):
