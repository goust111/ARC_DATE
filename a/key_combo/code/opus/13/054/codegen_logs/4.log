+    if np.array_equal(majority, unique):
+        return None
+    if _hamming(majority, unique) < 10:
+        return None
+    if np.array_equal(_extend_patch_rows(unique), majority):
+        return None
+    unique_slot = int(rng.integers(4))
+    grid = _assemble_grid(majority, unique, unique_slot)
