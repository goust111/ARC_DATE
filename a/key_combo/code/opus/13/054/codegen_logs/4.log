+        prefix = patch[r, :prefix_len].copy()
+        suffix_len = prefix_len - 1
+        fill_stop = w - suffix_len
+        out[r, prefix_len:fill_stop] = int(prefix[0])
+        out[r, fill_stop:] = prefix[1:]
+    return out
+
