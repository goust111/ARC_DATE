+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+HOLE_TO_COLOR = {
+    0: BLACK,
+    1: BLUE,
+    2: RED,
+    3: GREEN,
+}
+
+INPUT_COLORS = [BLUE, RED, GREEN, YELLOW]
+GEN_ATTEMPTS = 500
