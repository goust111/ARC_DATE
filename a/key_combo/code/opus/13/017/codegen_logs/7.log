+
+    for r in (top + TILE_SIZE, top + TILE_SIZE + STRIDE):
+        grid[r, :] = SEP
+    for c in (left + TILE_SIZE, left + TILE_SIZE + STRIDE):
+        grid[:, c] = SEP
