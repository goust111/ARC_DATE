+
+
+def _find_separator_col(grid: np.ndarray) -> int:
+    candidates = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == GREY)]
+    if not candidates:
+        raise ValueError("expected a full-height grey separator column")
