+def _render_symmetric_units(h: int, w: int, units: set[tuple[int, int]]) -> np.ndarray:
+    reps = (w + 1) // 2
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in units:
+        assert 0 <= c < reps
+        mirror = w - 1 - c
+        mask[r, c] = True
+        mask[r, mirror] = True
+    return _crop_mask(mask)
+
