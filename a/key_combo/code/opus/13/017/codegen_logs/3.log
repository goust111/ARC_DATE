+    grid = np.full((H, 3 * panel_w + 2), SEPARATOR, dtype=int)
+    grid[:, :panel_w] = panels[0]
+    grid[:, panel_w + 1 : 2 * panel_w + 1] = panels[1]
+    grid[:, 2 * panel_w + 2 :] = panels[2]
