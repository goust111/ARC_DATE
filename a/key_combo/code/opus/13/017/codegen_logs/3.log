+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+) -> list[dict]:
+    if connectivity != 4:
+        raise ValueError("only 4-connectivity is used in this task")
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    components: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            color = int(grid[r, c])
+            if color == int(bg) or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
+            )
+    return components
+
+
+def _component_patch(grid: np.ndarray, comp: dict, bg: int) -> np.ndarray:
+    r0, c0, r1, c1 = comp["bbox"]
+    patch = np.full((r1 - r0 + 1, c1 - c0 + 1), int(bg), dtype=int)
+    for r, c in comp["coords"]:
+        patch[r - r0, c - c0] = int(comp["color"])
+    return patch
+
+
+def _is_lr_symmetric(patch: np.ndarray) -> bool:
+    return bool(np.array_equal(patch, np.fliplr(patch)))
+
+
+def _panel_layout(grid: np.ndarray) -> tuple[list[np.ndarray], int]:
+    g = np.asarray(grid, dtype=int)
+    H, W = g.shape
+    bg = _get_bg(g)
+
+    candidates = []
+    for c in range(W):
+        col = g[:, c]
+        if int(col[0]) == int(bg):
+            continue
+        if np.all(col == col[0]):
+            candidates.append((c, int(col[0])))
+
+    layouts = []
+    for i in range(len(candidates)):
+        for j in range(i + 1, len(candidates)):
+            c1, color1 = candidates[i]
+            c2, color2 = candidates[j]
+            if color1 != color2:
+                continue
+            left_w = c1
+            mid_w = c2 - c1 - 1
+            right_w = W - c2 - 1
+            if left_w > 0 and left_w == mid_w == right_w:
+                layouts.append((c1, c2, color1, left_w))
