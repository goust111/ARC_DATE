+        hit_col = random.choice(hit_cols)
+        side_choice = random.choice(("top", "bottom", "both"))
+        if side_choice in ("top", "both"):
+            forced_top.add(hit_col)
+        if side_choice in ("bottom", "both"):
+            forced_bottom.add(hit_col)
