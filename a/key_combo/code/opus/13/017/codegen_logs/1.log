+        ((-4, 1), (-4, 2), (-4, 3), (-3, 2)),
+        ((-4, 1), (-3, 1), (-3, 2), (-2, 1)),
+        ((-4, 2), (-3, 2), (-3, 3), (-2, 2)),
+    ),
+    3: (
