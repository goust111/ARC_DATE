from itertools import product
T={
1:[((-3,1),(-3,2),(-2,1)),((-4,2),(-4,3),(-3,2)),((-4,3),(-4,4),(-3,4))],
2:[((-4,1),(-4,2),(-4,3),(-3,2)),((-4,1),(-3,1),(-3,2),(-2,1)),((-4,2),(-3,2),(-3,3),(-2,2))],
3:[((-4,1),(-4,2),(-3,2),(-3,3),(-2,2)),((-4,1),(-3,1),(-3,2),(-2,2),(-2,3)),((-4,2),(-3,1),(-3,2),(-3,3),(-2,1))],
}

def transform(coords,rot,mir):
    out=[]
    for r,c in coords:
        if mir:c=-c
        for _ in range(rot):
            r,c=c,-r
        out.append((r,c))
    return set(out)

def full(s): return s|{(-r,-c) for r,c in s}
def cheb(a,b):
    return min(max(abs(r1-r2),abs(c1-c2)) for r1,c1 in a for r2,c2 in b)
opts=[]
for cls,arr in T.items():
    for i,temp in enumerate(arr):
        for rot in range(4):
            for mir in range(2):
                s=transform(temp,rot,mir)
                opts.append((cls,i,rot,mir,s,full(s)))
seen=0
for combo in product(opts, repeat=4):
    classes=[x[0] for x in combo]
    if not {1,2,3}.issubset(classes):
        continue
    halves=[x[4] for x in combo]
    if len({tuple(sorted(h)) for h in halves})<4:
        continue
    ok=True
    occ=set()
    for i,h in enumerate(halves):
