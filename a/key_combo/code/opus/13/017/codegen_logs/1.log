from collections import defaultdict

allowed=[(r,c) for r in range(-4,5) for c in range(-4,5) if (r,c)"'!=(0,0)]

def conn(cells):
    cells=set(cells)
    stack=[next(iter(cells))]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for nb in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if nb in cells and nb not in seen:
                seen.add(nb); stack.append(nb)
    return len(seen)==len(cells)

def raw_bends(pts):
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    cnt=0
    for r in range(min(rs)-1,max(rs)+1):
        for c in range(min(cs)-1,max(cs)+1):
            s=sum((r+dr,c+dc) in pts for dr in (0,1) for dc in (0,1))
            if s==3: cnt+=1
    return cnt

def bbox(pts):
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    return min(rs),min(cs),max(rs),max(cs)

def rotate(pts,k):
    out=[]
    for r,c in pts:
