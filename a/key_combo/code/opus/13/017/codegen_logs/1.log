+
+
+def _placeable(
+    candidate_half: set[tuple[int, int]],
+    pivot: tuple[int, int],
+    shape: tuple[int, int],
+    placed_halves: list[set[tuple[int, int]]],
+    occupied_full: set[tuple[int, int]],
