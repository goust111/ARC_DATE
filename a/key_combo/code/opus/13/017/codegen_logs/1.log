from itertools import product
T={
1:[((-3,1),(-3,2),(-2,1)),((-4,2),(-4,3),(-3,2)),((-4,3),(-4,4),(-3,4))],
2:[((-4,1),(-4,2),(-4,3),(-3,2)),((-4,1),(-3,1),(-3,2),(-2,1)),((-4,2),(-3,2),(-3,3),(-2,2))],
3:[((-4,1),(-4,2),(-3,2),(-3,3),(-2,2)),((-4,1),(-3,1),(-3,2),(-2,2),(-2,3)),((-4,2),(-3,1),(-3,2),(-3,3),(-2,1))],
}

def transform(coords,rot,mir):
    out=[]
    for r,c in coords:
        if mir:c=-c
        for _ in range(rot):
            r,c=c,-r
        out.append((r,c))
    return set(out)

def full(s):
    return s|{(-r,-c) for r,c in s}

def cheb(a,b):
    return min(max(abs(r1-r2),abs(c1-c2)) for r1,c1 in a for r2,c2 in b)
opts={}
for cls,arr in T.items():
    opts[cls]=[]
    for i,temp in enumerate(arr):
        for rot in range(4):
            for mir in range(2):
                s=transform(temp,rot,mir)
                opts[cls].append((i,rot,mir,s,full(s)))
seen=0
for a,b,c in product(opts[1],opts[2],opts[3]):
    halves=[a[3],b[3],c[3]]; fulls=[a[4],b[4],c[4]]
    ok=True
    for i in range(3):
        for j in range(i+1,3):
            if fulls[i] & fulls[j]: ok=False
            if cheb(halves[i],halves[j])<3: ok=False
    if ok:
        print('layout')
        for item in (a,b,c):
            print(item[:3],sorted(item[3]))
        seen+=1
        if seen>=8: break
