from itertools import combinations
from collections import deque,defaultdict

# search half-shapes around pivot at (0,0), allowed coords dc>0 or dc==0 and dr>0
allowed=[]
for dr in range(-3,4):
    for dc in range(0,5):
        if dc>0 or (dc==0 and dr>0):
            if abs(dr)+abs(dc) <= 5 and not (dc==0 and dr==0):
                allowed.append((dr,dc))

def conn(cells):
    cells=set(cells)
    q=[next(iter(cells))]
    vis={q[0]}
    while q:
        r,c=q.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if (nr,nc) in cells and (nr,nc) not in vis:
                vis.add((nr,nc));q.append((nr,nc))
    return len(vis)==len(cells)

def bend_count(full):
    pts=set(full)
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    cnt=0
    for r in range(min(rs)-1,max(rs)+1):
        for c in range(min(cs)-1,max(cs)+1):
            s=0
            for dr in (0,1):
                for dc in (0,1):
                    s += ((r+dr,c+dc) in pts)
            if s==3:
                cnt+=1
