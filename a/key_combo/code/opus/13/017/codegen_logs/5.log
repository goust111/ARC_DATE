+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PALETTE = list(range(1, 10))
+MAX_ATTEMPTS = 500
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+FEASIBLE_BBOXES = [
+    (2, 2),
+    (2, 3),
+    (2, 4),
+    (2, 5),
