+def _random_walk_path(h: int, w: int) -> list[tuple[int, int]]:
+    corners = [((0, 0), (h - 1, w - 1)), ((0, w - 1), (h - 1, 0))]
+    (sr, sc), (tr, tc) = random.choice(corners)
+    r, c = sr, sc
+    path = [(r, c)]
+    while (r, c) != (tr, tc):
+        moves = []
+        if r < tr:
+            moves.append((1, 0))
+        elif r > tr:
+            moves.append((-1, 0))
