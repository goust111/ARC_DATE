+def _random_partition(n: int, parts: int) -> list[int]:
+    cuts = sorted(random.sample(range(1, n), parts - 1))
+    sizes = []
+    prev = 0
+    for cut in cuts + [n]:
+        sizes.append(cut - prev)
+        prev = cut
+    return sizes
+
