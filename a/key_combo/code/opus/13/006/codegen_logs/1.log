+        rect = _bbox(coords)
+        r0, c0, r1, c1 = rect
+        assert (r1 - r0 + 1, c1 - c0 + 1) == (2, 2), "grey object must be a 2x2 arrow sprite"
+        assert coords.shape[0] == 3, "grey arrow sprite must have exactly one missing corner"
