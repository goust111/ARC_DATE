+        for ci, cand in enumerate(module["candidates"]):
+            entry = dict(cand)
+            entry["color"] = module["color"]
+            entry["module_index"] = mi
+            entry["special"] = module["special"]
+            all_candidates[(mi, ci)] = entry
+    return all_candidates
