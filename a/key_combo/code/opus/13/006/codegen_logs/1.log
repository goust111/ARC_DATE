+def _ray_hits_bbox(arrow: dict, box: Rect) -> bool:
+    r0, c0, _r1, _c1 = arrow["bbox"]
+    br0, bc0, br1, bc1 = box
+    direction = arrow["direction"]
+    if direction == "right":
+        return br0 <= r0 + 1 and br1 >= r0 and bc1 >= c0 + 2
+    if direction == "left":
+        return br0 <= r0 + 1 and br1 >= r0 and bc0 <= c0 - 1
+    if direction == "down":
