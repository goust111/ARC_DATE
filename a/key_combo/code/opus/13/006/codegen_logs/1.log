+def _place_modules(modules: list[dict], height: int, width: int) -> list[tuple[int, int]] | None:
+    order = sorted(range(len(modules)), key=lambda idx: _module_size(modules[idx])[0] * _module_size(modules[idx])[1], reverse=True)
