+    h, w = grid.shape
+    if grid.ndim != 2 or h > 30 or w > 30:
+        return False
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+
+    grey_comps = _components(grid == GREY)
+    if len(grey_comps) != 1:
+        return False
+
+    run_len = _top_pink_run_length(grid)
