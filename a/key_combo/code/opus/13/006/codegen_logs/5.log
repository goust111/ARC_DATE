+    grid = np.zeros((h, w), dtype=int)
+    grid[0, :run_len] = PINK
+    for r, c in grey_cells:
+        grid[r, c] = GREY
+    for color, cells in marker_cells.items():
+        for r, c in cells:
+            grid[r, c] = color
+    return grid
+
+
