  "type": "move_to_match",
  "src": "non-background marker pixel s",
  "dst": "centered square ring region d",
  "match_cond": "s.chebyshev_distance_to_grid_center == d.ring_radius",
  "transform": "fill every pixel in d with s.color"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: odd square, side length 7-13 (radius = side//2, range 3-6)
  background: single dominant color filling all non-marker cells [observed: always 7]
  markers:
    count: radius + 1 (one per Chebyshev distance 0..radius from center)
    each_size: exactly 1 pixel
    colors: all mutually distinct, all != background
    placement: exactly one marker at each Chebyshev distance d from grid center (d=0 is the center cell itself)
    position_within_ring: any valid cell at that Chebyshev distance (no further constraint)
  output:
    same dimensions as input
    concentric square rings centered on grid center
    ring at distance d filled with the color of the marker whose Chebyshev distance is d
    no background remains in output

generation_strategy:
  approach: output-first
  steps:
    1. Pick odd side length N in {7,9,11,13}; set radius = N//2
    2. Choose background color bg (any color 0-9)
    3. Choose radius+1 distinct non-bg colors for rings 0..radius
    4. Build the output grid: fill each cell at Chebyshev distance d from center with color[d]
    5. Build the input grid: fill with bg, then for each distance d place one marker pixel with color[d] at a random cell whose Chebyshev distance from center is d
```
