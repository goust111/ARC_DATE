+def _line_cells_between(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    if a[0] == b[0]:
+        r = a[0]
+        c0, c1 = sorted((a[1], b[1]))
+        return [(r, c) for c in range(c0 + 1, c1)]
+    c = a[1]
