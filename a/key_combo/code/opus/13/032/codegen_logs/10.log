        if i <= peak_idx:
            lefts[i] = int(round(top_left + t * (peak_left - top_left)))
            rights[i] = int(round(top_right + t * (peak_right - top_right)))
        else:
            lefts[i] = int(round(peak_left + t * (bot_left - peak_left)))
            rights[i] = int(round(peak_right + t * (bot_right - peak_right)))

