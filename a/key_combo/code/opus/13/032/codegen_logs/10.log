  "transform": "read path pixels from one endpoint to the other and reverse that color sequence onto the same pixels; leave background unchanged"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10x10, background color 8
  path:
    structure: single 4-connected non-branching one-pixel-wide path with exactly 2 endpoints
    length: 8-28 cells
    turns: 2-8 direction changes
    straight_segments: each 2-8 cells long
    margin: path does not touch grid border; >=1 cell margin on all sides [observed]
    colors: 6-7 distinct non-background colors; colors may repeat along the path
    no_palindrome: color sequence along the path must not be a palindrome (otherwise output == input)
  transform:
    walk path endpoint-to-endpoint; reverse the color sequence onto the same cells
    path geometry unchanged; only colors are permuted

generation_strategy:
  approach: direct construction (path-first)
  steps:
    1. Choose grid 10x10 with bg=8.
    2. Build a random non-branching 4-connected path via random walk on the grid interior
       (stay >=1 cell from border). Target 8-28 cells with 2-8 turns.
       Use self-avoiding walk; stop when target length reached or walk is trapped.
    3. Pick 6-7 non-bg colors. Assign colors along the path randomly from this palette.
    4. Reject if the color sequence is a palindrome (very unlikely for length >= 8).
    5. Output = same path with reversed color sequence.
```
