+
+
+def _validate_local_zone(zone: np.ndarray, meta: dict) -> bool:
+    pair = {
+        "color": 1,
+        "rect_bbox": meta["rect_bbox"],
+        "block_bbox": meta["block_bbox"],
+        "axis": meta["axis"],
+        "dims": meta["dims"],
+        "norm_dims": meta["norm_dims"],
+        "norm_bbox": meta["norm_bbox"],
+        "swap": meta["swap"],
