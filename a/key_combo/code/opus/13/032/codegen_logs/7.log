+    rect_center_r2 = nr0 + (nr0 + nh - 1)
+    if rect_center_r2 < block_center_r2:
+        fr0 = br0 - nh
+    else:
+        fr0 = br1 + 1
+    return fr0, nc0, fr0 + nh - 1, nc0 + nw - 1
