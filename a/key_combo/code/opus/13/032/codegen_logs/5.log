+            translated = {(r + shift_r, c + shift_c) for r, c in cells}
+            if not all(_in_bounds((h, w), r, c) for r, c in translated):
+                continue
+            if not _cells_have_gap(translated, occupied):
+                continue
+            if any(r in (0, h - 1) or c in (0, w - 1) for r, c in translated):
+                continue
+            placed = translated
+            break
+        if placed is None:
