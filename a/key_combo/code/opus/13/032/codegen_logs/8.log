+def _random_region_offsets(area: int, direction: tuple[int, int]) -> list[tuple[int, int]] | None:
+    dir_r, dir_c = direction
+    allowed = set()
+    for dr in range(-3, 4):
+        for dc in range(-3, 4):
+            if max(abs(dr), abs(dc)) > 3 or abs(dr) + abs(dc) > 5:
+                continue
+            score = dr * dir_r + dc * dir_c
+            if score < 0:
+                continue
+            if score == 0 and abs(dr) + abs(dc) > 3:
+                continue
+            allowed.add((dr, dc))
