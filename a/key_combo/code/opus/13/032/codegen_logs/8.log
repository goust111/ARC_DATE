+    for region in regions:
+        angle = _angle_clockwise(divider_centroid, region["centroid"])
+        region["angle"] = angle
+    ordered_all = sorted(regions, key=lambda region: region["angle"])
+    ordered_survivors = sorted(survivors, key=lambda region: region["angle"])
