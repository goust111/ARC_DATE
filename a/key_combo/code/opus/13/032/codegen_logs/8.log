+    return {
+        "grid": g,
+        "divider_coords": divider,
+        "divider_centroid": divider_centroid,
+        "regions": regions,
+        "distractor": distractor,
+        "ordered_all": ordered_all,
+        "ordered_survivors": ordered_survivors,
+    }
