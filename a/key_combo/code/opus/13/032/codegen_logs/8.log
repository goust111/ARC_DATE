+def _path_plan(grid: np.ndarray) -> tuple[np.ndarray, list[dict]]:
+    info = _analyze_input(grid)
+    base = np.array(info["grid"], copy=True)
+    base[info["distractor"]["coords"][:, 0], info["distractor"]["coords"][:, 1]] = BG
+    obstacle_mask = base != BG
