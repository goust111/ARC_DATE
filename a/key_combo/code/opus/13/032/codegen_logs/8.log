+        color = int(next(iter(colors)))
+        centroid = _centroid(coords)
+        regions.append(
+            {
+                "coords": coords,
+                "color": color,
+                "area": int(coords.shape[0]),
+                "centroid": centroid,
+                "anchor": _anchor_from_centroid(coords),
+            }
+        )
+    return regions
+
+
+def _analyze_input(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
