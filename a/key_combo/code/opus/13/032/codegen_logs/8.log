+                compact = abs(dr) + abs(dc)
+                balance = 3 - min(3, abs(dr + dc))
+                weights.append(max(1, 8 - 2 * score - compact + balance))
+            pick = random.choices(candidates, weights=weights, k=1)[0]
+            cells.add(pick)
