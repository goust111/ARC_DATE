+        mean_r, mean_c = coords.mean(axis=0)
+        if abs(mean_r) >= 0.45 or abs(mean_c) >= 0.45:
+            continue
+        if max(dr * dir_r + dc * dir_c for dr, dc in cells) <= 0:
