+def _slot_offsets(grid_shape: tuple[int, int]) -> list[tuple[int, int]]:
+    center_r = grid_shape[0] // 2
+    center_c = grid_shape[1] // 2
+    radial = min(center_r, center_c) - 3
+    diag = radial - 1
+    return [
+        (0, radial),
+        (diag, diag),
+        (radial, 0),
+        (diag, -diag),
+        (0, -radial),
+        (-diag, -diag),
+        (-radial, 0),
+        (-diag, diag),
+    ]
+
