+    frame_boxes = list(frames)
+    mask = ~np.isin(grid, [BG, BORDER])
+    candidates = []
+    for coords in _components_mask(mask, connectivity=8):
+        box = _bbox(coords)
+        r0, c0, r1, c1 = box
+        inside_frame = any(fr0 < r0 <= r1 < fr1 and fc0 < c0 <= c1 < fc1 for fr0, fc0, fr1, fc1 in frame_boxes)
+        if inside_frame:
