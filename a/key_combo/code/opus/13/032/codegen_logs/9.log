+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 5
+BORDER = 0
+HIGHLIGHT = 2
+INPUT_COLORS = (1, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
