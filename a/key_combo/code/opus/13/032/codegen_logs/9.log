+def _free_rect(occupied: np.ndarray, top: int, left: int, h: int, w: int, pad: int) -> bool:
+    H, W = occupied.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(H, top + h + pad)
+    c1 = min(W, left + w + pad)
+    return not occupied[r0:r1, c0:c1].any()
