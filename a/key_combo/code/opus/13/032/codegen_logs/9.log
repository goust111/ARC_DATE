+        _scale, _rot, transformed = matches[0]
+        fill_count = int(np.count_nonzero((inner == BG) & (transformed != BG)))
+        out[r0 + 1 : r1, c0 + 1 : c1] = transformed
+        completions.append((fill_count, box))
