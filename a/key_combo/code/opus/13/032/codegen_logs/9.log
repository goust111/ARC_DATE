+        expected = set(_frame_border_cells(box))
+        if ring != expected:
+            continue
+        frames.append(box)
+    frames.sort()
+    return frames
+
+
+def _find_template_sprite(grid: np.ndarray, frames: Iterable[tuple[int, int, int, int]]) -> np.ndarray:
