+def _place_objects(template: np.ndarray, frame_sizes: list[tuple[int, int]]) -> tuple[int, int, tuple[int, int], list[tuple[int, int]]]:
+    th, tw = template.shape
+    corners = ["tl", "tr", "bl", "br"]
