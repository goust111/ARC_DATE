+def _validate_partial_latin(grid: np.ndarray) -> None:
+    for row in grid:
+        seen = [int(v) for v in row if int(v) != BACKGROUND]
+        assert len(seen) == len(set(seen)), "rows may not repeat a filled Latin color"
+    for col in grid.T:
