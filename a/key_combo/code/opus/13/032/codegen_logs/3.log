+def _solve_latin_unique(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    _validate_partial_latin(out)
+    solutions: list[np.ndarray] = []
+    palette_set = set(PALETTE)
