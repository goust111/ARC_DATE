    1: {"NW": "SW", "NE": "NW", "SW": "SE", "SE": "NE"},
    2: {"NW": "SE", "NE": "SW", "SW": "NE", "SE": "NW"},
    3: {"NW": "NE", "NE": "SE", "SW": "NW", "SE": "SW"},
}


def _corner_coords(bbox: tuple[int, int, int, int]) -> dict[str, tuple[int, int]]:
    r0, c0, r1, c1 = bbox
    return {
        "NW": (r0, c0),
        "NE": (r0, c1),
        "SW": (r1, c0),
        "SE": (r1, c1),
