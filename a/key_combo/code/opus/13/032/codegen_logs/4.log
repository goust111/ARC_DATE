+            continue
+        seen.add((r, c))
+        for dr, dc in _DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+    monochromatic: bool = True,
+) -> list[dict]:
