+    if connectivity != 4:
+        raise ValueError("this task uses only 4-connectivity")
+    if not monochromatic:
+        raise ValueError("this task uses only monochromatic components")
+
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
