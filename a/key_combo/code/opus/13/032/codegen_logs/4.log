+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
+
+
+def _connected4(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    seen = set()
+    stack = [tuple(map(int, coords[0]))]
+    h, w = mask.shape
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for dr, dc in _DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and (nr, nc) not in seen:
+                stack.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
+
+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int,
+    connectivity: int = 4,
+    monochromatic: bool = True,
