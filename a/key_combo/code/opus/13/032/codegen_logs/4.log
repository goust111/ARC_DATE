+    analysis = _analyze(grid)
+    g = analysis["grid"]
+    bg = analysis["bg"]
+
+    out = g.copy()
+    for pos in analysis["marker_lookup"]:
+        out[pos] = bg
+    for info in analysis["sprite_infos"]:
+        for r, c in info["coords"]:
+            out[int(r), int(c)] = bg
