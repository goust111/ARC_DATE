+BG = 0
+SPRITE_COLORS = (1, 2, 3)
+SPRITE_SIZE = 3
+ZONE_SIZE = 5
+SLOT_STEP = 6
+GEN_ATTEMPTS = 400
+SHAPE_AREA_MIN = 4
+SHAPE_AREA_MAX = 6
