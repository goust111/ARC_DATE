    dashes: grey (5) dashed lines along each rectangle side between adjacent glyphs
    dash_rule: gap cells at positions 0..n-1; cell painted grey iff min(i, n-1-i) is even
    gap_span: horizontal gap cols [left+2, right-2], vertical gap rows [top+2, bottom-2]

generation_strategy:
