+import numpy as np
+
+
+BG = 0
+GREY = 5
+SQUARE_FILL = 8
+BAR_FILL = 2
+OUTLINE_COLORS = (1, 3, 4, 6, 7, 9)
+
+GRID_ROWS_RANGE = (17, 20)
+GRID_COLS_RANGE = (17, 20)
+OUTLINE_COUNT_OPTIONS = (2, 3)
+VALID_COUNT_PAIRS = (
+    (1, 2),
+    (2, 1),
+    (1, 3),
+    (3, 1),
+    (1, 4),
+    (4, 1),
+    (2, 3),
+    (3, 2),
