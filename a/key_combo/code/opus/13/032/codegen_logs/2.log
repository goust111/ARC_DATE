+def _bbox(coords: list[tuple[int, int]] | set[tuple[int, int]] | np.ndarray) -> tuple[int, int, int, int]:
+    if isinstance(coords, np.ndarray):
+        rows = coords[:, 0]
+        cols = coords[:, 1]
+        return int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())
