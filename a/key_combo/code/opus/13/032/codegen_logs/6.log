+            continue
+        if not arr[0, 0]:
+            continue
+        if count == total:
+            continue
+        has_h = any(arr[r, c] and arr[r, c + 1] for r in range(rows) for c in range(cols - 1))
+        has_v = any(arr[r, c] and arr[r + 1, c] for r in range(rows - 1) for c in range(cols))
+        if not (has_h and has_v):
