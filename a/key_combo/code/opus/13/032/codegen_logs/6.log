+    return True
+
+
+def _generate_once() -> tuple[np.ndarray, np.ndarray] | None:
+    template_mask = random.choice(TEMPLATE_CATALOG).copy()
+    rows, cols, dy, dx, box_h, box_w = _layout_choice()
