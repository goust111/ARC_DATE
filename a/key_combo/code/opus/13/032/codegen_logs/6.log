                    continue
                tile = np.zeros((period_r, period_c), dtype=int)
                for idx in range(area):
                    if bits & (1 << idx):
                        tile[idx // period_c, idx % period_c] = _GEN_BLUE
                if not _gen_exact_period(tile, period_r, period_c):
