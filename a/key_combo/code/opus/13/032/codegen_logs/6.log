+
+    r0, c0, r1, c1 = box
+    out_box = expected[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.any(out_box == GREEN) or not np.any(out_box == BLUE):
+        return False
+    if np.any(expected == RED):
