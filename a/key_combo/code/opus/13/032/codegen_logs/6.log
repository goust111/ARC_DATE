+    col_to_rows: dict[int, list[int]] = defaultdict(list)
+    for r, c in anchors:
+        row_to_cols[r].append(c)
+        col_to_rows[c].append(r)
+    if min(
+        min(cols[i + 1] - cols[i] for i in range(len(cols) - 1))
