+            max_r = max(r for r, _ in norm)
+            max_c = max(c for _, c in norm)
+            h, w = max_r + 1, max_c + 1
+            if (h // 2, w // 2) not in norm:
+                continue
+            unique.add(norm)
+        for norm in sorted(unique):
+            max_r = max(r for r, _ in norm)
+            max_c = max(c for _, c in norm)
