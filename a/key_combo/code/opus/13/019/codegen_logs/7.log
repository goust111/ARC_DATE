+    gap2 = 2 + extras[2]
+
+    starts = [
+        left,
+        left + widths[0] + gap1,
+        left + widths[0] + gap1 + widths[1] + gap2,
+    ]
+    for (patch, _area), c0 in zip(templates, starts):
+        h, w = patch.shape
