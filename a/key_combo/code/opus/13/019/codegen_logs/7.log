+    rr = r0 + (WINDOW_SIZE - h) // 2
+    cc = c0 + (WINDOW_SIZE - w) // 2
+    mask = patch != BLACK
+    out[rr : rr + h, cc : cc + w][mask] = patch[mask]
+
+
+def _solve(grid: np.ndarray) -> np.ndarray:
