+
+    grid = np.zeros((height, GRID_WIDTH), dtype=int)
+    for r in range(3, divider + 1, STRIDE):
+        grid[r, :] = GREY
+    for c in range(3, GRID_WIDTH, STRIDE):
+        grid[:divider, c] = GREY
