+
+def _bbox(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(coords)
+    return out
+
+
+def _min_grey_crossings(grid):
+    h, w = grid.shape
+    inf = 10 ** 9
+    dist = np.full((h, w), inf, dtype=int)
+    dq = deque()
+    border = set()
+    for r in range(h):
+        border.add((r, 0))
+        border.add((r, w - 1))
+    for c in range(w):
+        border.add((0, c))
+        border.add((h - 1, c))
+    for r, c in border:
+        cost = 1 if int(grid[r, c]) == GREY else 0
+        if cost < dist[r, c]:
+            dist[r, c] = cost
+            if cost == 0:
+                dq.appendleft((r, c))
+            else:
+                dq.append((r, c))
+
+    while dq:
+        r, c = dq.popleft()
+        base = int(dist[r, c])
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            step = 1 if int(grid[nr, nc]) == GREY else 0
+            nd = base + step
+            if nd < dist[nr, nc]:
+                dist[nr, nc] = nd
+                if step == 0:
+                    dq.appendleft((nr, nc))
+                else:
+                    dq.append((nr, nc))
+    return dist
+
+
+def _analyze_regions(grid):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    colors = set(map(int, np.unique(g)))
+    assert colors <= {BLACK, GREY}, "input must contain only black background and grey walls"
+
+    dist = _min_grey_crossings(g)
+    regions = []
+    for coords in _components(g == BLACK):
+        depth_values = {int(dist[r, c]) for r, c in coords}
+        depth = min(depth_values)
+        regions.append(
+            {
+                "coords": coords,
+                "area": len(coords),
+                "bbox": _bbox(coords),
+                "depth": depth,
+            }
+        )
+    return regions
