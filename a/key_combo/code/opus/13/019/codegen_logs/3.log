+    return grid
+
+
+def _depth_histogram(regions):
+    hist = defaultdict(int)
+    for region in regions:
+        hist[int(region["depth"])] += 1
+    return hist
+
+
+def _intervals_overlap(a, b):
+    return max(min(a), min(b)) <= min(max(a), max(b))
+
+
+def _valid_generated_grid(grid, target_depth):
