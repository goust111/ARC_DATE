+def _min_grey_crossings(grid):
+    h, w = grid.shape
+    inf = 10 ** 9
+    dist = np.full((h, w), inf, dtype=int)
+    dq = deque()
+    border = set()
+    for r in range(h):
+        border.add((r, 0))
+        border.add((r, w - 1))
+    for c in range(w):
+        border.add((0, c))
+        border.add((h - 1, c))
+    for r, c in border:
+        cost = 1 if int(grid[r, c]) == GREY else 0
+        if cost < dist[r, c]:
+            dist[r, c] = cost
+            if cost == 0:
+                dq.appendleft((r, c))
+            else:
+                dq.append((r, c))
+
+    while dq:
+        r, c = dq.popleft()
+        base = int(dist[r, c])
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            step = 1 if int(grid[nr, nc]) == GREY else 0
+            nd = base + step
+            if nd < dist[nr, nc]:
