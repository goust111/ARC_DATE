+
+
+def _place_roots(root_a, root_b, rng):
+    candidates = []
+    for order in ((root_a, root_b), (root_b, root_a)):
+        a, b = order
+        for layout in ("horizontal", "vertical"):
+            gap = rng.randint(1, 3)
+            if layout == "horizontal":
+                left = rng.randint(0, 1)
