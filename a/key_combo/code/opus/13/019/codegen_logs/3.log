+        ("vertical", vertical_h, vertical_w),
+    ]
+    rng.shuffle(layouts)
+    layout, h, w = min(layouts, key=lambda item: (item[1] * item[2], max(item[1], item[2])))
+    return FrameNode(h, w, children, layout, depth)
