+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    preferred_depth = 4 if rng.random() < 0.35 else 3
+    primary_budget = MAX_GENERATION_ATTEMPTS // 2 if preferred_depth == 4 else MAX_GENERATION_ATTEMPTS
