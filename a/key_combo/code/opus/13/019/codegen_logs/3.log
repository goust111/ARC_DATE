+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DEPTH_TO_COLOR = {
+    1: RED,
+    2: BLUE,
+    3: GREEN,
+    4: YELLOW,
+}
