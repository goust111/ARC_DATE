+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+DEPTH_TO_COLOR = {
+    1: RED,
+    2: BLUE,
+    3: GREEN,
+    4: YELLOW,
+}
+
+MAX_GENERATION_ATTEMPTS = 400
+LEAF_SIZES = (
+    (4, 4),
+    (4, 5),
+    (5, 4),
+    (4, 6),
+    (6, 4),
+    (5, 5),
+    (5, 6),
+    (6, 5),
+)
