+        base_r = r0 + 2
+        free_h = node.h - 4 - max(child.h for child in node.children)
+        for idx, child in enumerate(node.children):
+            child_r = base_r + rng.randint(0, free_h)
+            _assign_boxes(child, child_r, x, rng)
+            x += child.w
+            if idx < len(node.children) - 1:
