+def _build_depth3_roots(rng):
+    chain_a1 = _build_chain(2, 3, rng)
+    child_a2 = _make_leaf(rng, 2)
+    root_a = _pack_children([chain_a1, child_a2], rng, 1)
+
+    chain_b1 = _build_chain(2, 3, rng)
+    root_b = _pack_children([chain_b1], rng, 1)
