+
+def _split_nonnegative(total, parts, rng):
+    if parts == 1:
+        return [total]
+    cuts = sorted(rng.sample(range(total + parts - 1), parts - 1))
+    out = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
