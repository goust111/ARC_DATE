+
+class FrameNode:
+    def __init__(self, h, w, children=None, layout=None, target_depth=1):
+        self.h = int(h)
+        self.w = int(w)
+        self.children = list(children or [])
+        self.layout = layout
+        self.target_depth = int(target_depth)
+        self.box = None
