+    out = main(grid)
+    if np.array_equal(out, grid):
+        return False
+    used_colors = set(map(int, np.unique(out))) - {BLACK, GREY}
+    expected = {DEPTH_TO_COLOR[d] for d in range(1, target_depth + 1)}
+    return expected <= used_colors
+
+
+def _generate_attempt(rng):
