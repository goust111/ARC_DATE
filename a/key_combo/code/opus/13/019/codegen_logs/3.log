+MAX_GENERATION_ATTEMPTS = 400
+LEAF_SIZES = (
+    (4, 4),
+    (4, 5),
+    (5, 4),
+    (4, 6),
+    (6, 4),
+    (5, 5),
+    (5, 6),
+    (6, 5),
