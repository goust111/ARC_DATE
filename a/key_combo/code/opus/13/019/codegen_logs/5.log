+                continue
+            q = deque([(r, c)])
+            labels[r, c] = label
+            touches = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
