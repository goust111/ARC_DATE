+                cc = c0 + int(pc)
+                if not region_mask[rr, cc] or forbidden[rr, cc]:
+                    ok = False
+                    break
+                placed.append((rr, cc))
+            if ok and _adjacent_black_exists(region_mask, placed):
+                candidates.append(placed)
