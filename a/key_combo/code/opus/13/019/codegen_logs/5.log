+    mask = np.zeros((h, w), dtype=bool)
+    r0 = room["top"] + room["inner_r0"]
+    c0 = room["left"] + room["inner_c0"]
+    mask[r0 : r0 + room["inner_h"], c0 : c0 + room["inner_w"]] = True
+    return mask
