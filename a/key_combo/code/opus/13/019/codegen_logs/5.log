+            continue
+        cur = anchor
+        length = random.randint(1, 2)
+        for _ in range(length):
+            cur = (cur[0] + step[0], cur[1] + step[1])
+            walls.add(cur)
+        if random.random() < 0.5:
+            turn = random.choice([(step[1], step[0]), (-step[1], -step[0])])
+            cur = (cur[0] + turn[0], cur[1] + turn[1])
+            walls.add(cur)
