+    min_r = min(r for r, _ in walls)
+    min_c = min(c for _, c in walls)
+    walls = {(r - min_r, c - min_c) for r, c in walls}
+    inner_r0 = 1 - min_r
+    inner_c0 = 1 - min_c
+    return {
+        "walls": walls,
+        "bbox_h": max(r for r, _ in walls) + 1,
+        "bbox_w": max(c for _, c in walls) + 1,
+        "inner_r0": inner_r0,
+        "inner_c0": inner_c0,
+        "inner_h": inner_h,
+        "inner_w": inner_w,
