        for r, c in coords:
            for dr, dc in NEIGHBOR_OFFSETS_4:
                nr, nc = r + dr, c + dc
                if (nr, nc) in coords:
                    continue
                trial = coords | {(nr, nc)}
                rs = [p[0] for p in trial]
                cs = [p[1] for p in trial]
                if max(rs) - min(rs) + 1 <= max_h and max(cs) - min(cs) + 1 <= max_w:
                    candidates.append((nr, nc))
