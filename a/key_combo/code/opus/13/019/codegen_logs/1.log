+def _normalize_binary(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask != 0)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
