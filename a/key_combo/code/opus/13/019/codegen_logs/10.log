        for j, col in enumerate(cols):
            paint_color = int(g[r0 + i, c0 + j])
            assert paint_color != bg and paint_color != template_color
            component = by_anchor[(row, col)]
            coords = component["coords"]
            out[coords[:, 0], coords[:, 1]] = paint_color

