+    except AssertionError:
+        return None
+
+    if out.shape != inp.shape or max(inp.shape) > 30:
+        return None
+    if not np.any(inp == YELLOW):
+        return None
+    if not np.any(out == BLUE) or not np.any(out == RED) or not np.any(out == GREEN):
+        return None
+    return inp
+
