+        assert coords.shape[0] == 5, "each cross must have five grey pixels"
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        assert (r1 - r0 + 1, c1 - c0 + 1) == (3, 3), "each cross must fit in a 3x3 box"
