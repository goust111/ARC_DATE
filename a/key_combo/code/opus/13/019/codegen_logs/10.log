+    for dr, dc in DIRS4:
+        for step in range(2, arm_len + 1):
+            cells.append((center_r + dr * step, center_c + dc * step))
+    return cells
+
+
+def _sample_markers(
+    rng: np.random.Generator,
+    control: np.ndarray,
+    centers: dict[tuple[int, int], tuple[int, int]],
