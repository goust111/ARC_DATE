+        banned_cells.add((int(line["line"]), int(line["end"]) + 1))
+    for line in chosen_cols:
+        banned_cells.add((int(line["start"]) - 1, int(line["line"])))
+        banned_cells.add((int(line["end"]) + 1, int(line["line"])))
