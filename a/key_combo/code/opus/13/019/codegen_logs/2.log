+    left = [i for i in range(start) if vals[i] not in (BG, BLUE, YELLOW, TEAL)]
+    right = [i for i in range(end + 1, len(vals)) if vals[i] not in (BG, BLUE, YELLOW, TEAL)]
+    if len(left) != 1 or len(right) != 1:
+        return []
