  56: def main(grid: np.ndarray) -> np.ndarray:
  57:     """
  58:     Complete the sparse-color reflected copy of the foreground motif across its matching marker row or column.
  59: 
  60:     Input structure
  61:     - The grid has one background color and two foreground colors.
  62:     - One foreground color appears only as a sparse marker row or column.
  63:     - The other foreground color contains the same sparse marker positions on a parallel row or column, plus the motif on the far side of the sparse markers.
  64: 
  65:     Rule
  66:     - Keep the original grid unchanged.
  67:     - Reflect every motif pixel of the larger foreground color across the two parallel marker lines.
  68:     - Paint the reflected motif pixels with the sparse marker color.
  69: 
  70:     Key insight
  71:     - The two equal marker rows or columns are paired landmarks: the sparse-color marker line borders the source motif, and the matching source-color marker line anchors the reflected copy.
  72:     """
  73:     g = np.asarray(grid, dtype=int)
  74:     bg = get_bg(g)
  75:     colors = colors_present(g, exclude={bg})
  76:     assert len(colors) == 2, "expected exactly two foreground colors"
  77: 
  78:     target, axis, target_line, marker_positions = _find_sparse_marker(g, colors)
  79:     source = next(color for color in colors if color != target)
  80:     source_line = _matching_source_line(g, source, axis, marker_positions)
