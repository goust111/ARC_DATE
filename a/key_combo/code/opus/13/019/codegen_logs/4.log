   9: def _marker_line(coords: np.ndarray) -> tuple[int, int, set[int]]:
  10:     rows = np.unique(coords[:, 0])
  11:     cols = np.unique(coords[:, 1])
  12:     same_row = len(rows) == 1
  13:     same_col = len(cols) == 1
  14:     assert same_row != same_col, "marker pixels must form one row or one column"
  15: 
  16:     if same_row:
  17:         return 0, int(rows[0]), set(map(int, cols))
  18:     return 1, int(cols[0]), set(map(int, rows))
  19: 
  20: 
  21: def _find_sparse_marker(
  22:     g: np.ndarray, colors: list[int]
  23: ) -> tuple[int, int, int, set[int]]:
  24:     candidates: list[tuple[int, int, int, set[int]]] = []
  25:     for color in colors:
  26:         coords = np.argwhere(g == color)
  27:         rows = np.unique(coords[:, 0])
  28:         cols = np.unique(coords[:, 1])
  29:         if (len(rows) == 1) != (len(cols) == 1):
  30:             axis, line, positions = _marker_line(coords)
  31:             candidates.append((color, axis, line, positions))
  32: 
  33:     assert len(candidates) == 1, "expected exactly one sparse marker color"
  34:     return candidates[0]
  35: 
  36: 
  37: def _matching_source_line(
  38:     g: np.ndarray, source: int, axis: int, marker_positions: set[int]
  39: ) -> int:
  40:     other_axis = 1 - axis
  41:     coords = np.argwhere(g == source)
  42:     candidates = []
  43:     for line in sorted(set(map(int, coords[:, axis]))):
  44:         positions = {
  45:             int(coord[other_axis])
  46:             for coord in coords
  47:             if int(coord[axis]) == line
  48:         }
  49:         if positions == marker_positions:
  50:             candidates.append(line)
  51: 
  52:     assert len(candidates) == 1, "expected one matching source marker line"
  53:     return int(candidates[0])
