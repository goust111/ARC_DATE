  56: def main(grid: np.ndarray) -> np.ndarray:
  57:     """
  58:     Complete the sparse-color reflected copy of the foreground motif across its matching marker row or column.
  59: 
  60:     Input structure
  61:     - The grid has one background color and two foreground colors.
  62:     - One foreground color appears only as a sparse marker row or column.
  63:     - The other foreground color contains the same sparse marker positions on a parallel row or column, plus the motif on the far side of the sparse markers.
  64: 
  65:     Rule
  66:     - Keep the original grid unchanged.
  67:     - Reflect every motif pixel of the larger foreground color across the two parallel marker lines.
  68:     - Paint the reflected motif pixels with the sparse marker color.
  69: 
  70:     Key insight
  71:     - The two equal marker rows or columns are paired landmarks: the sparse-color marker line borders the source motif, and the matching source-color marker line anchors the reflected copy.
  72:     """
  73:     g = np.asarray(grid, dtype=int)
  74:     bg = get_bg(g)
  75:     colors = colors_present(g, exclude={bg})
  76:     assert len(colors) == 2, "expected exactly two foreground colors"
  77: 
  78:     target, axis, target_line, marker_positions = _find_sparse_marker(g, colors)
  79:     source = next(color for color in colors if color != target)
  80:     source_line = _matching_source_line(g, source, axis, marker_positions)
  81: 
  82:     line_delta = source_line - target_line
  83:     assert line_delta != 0, "marker lines must be distinct"
  84:     direction = 1 if line_delta > 0 else -1
  85:     other_axis = 1 - axis
  86: 
  87:     source_coords = np.argwhere(g == source)
  88:     target_coords = np.argwhere(g == target)
  89:     assert len(marker_positions) == len(target_coords), "marker positions must be unique"
  90: 
  91:     body_coords: list[tuple[int, int]] = []
  92:     source_marker_count = 0
  93:     for coord_arr in source_coords:
  94:         coord = (int(coord_arr[0]), int(coord_arr[1]))
  95:         on_source_marker = (
  96:             coord[axis] == source_line and coord[other_axis] in marker_positions
  97:         )
  98:         on_body_side = (coord[axis] - target_line) * direction < 0
  99:         assert on_source_marker or on_body_side, "source pixels must be motif or marker"
 100:         if on_source_marker:
 101:             source_marker_count += 1
 102:         else:
 103:             body_coords.append(coord)
 104: 
 105:     assert source_marker_count == len(target_coords), "marker lines must have equal length"
 106:     assert len(body_coords) + len(target_coords) == len(source_coords)
 107: 
 108:     out = g.copy()
 109:     h, w = g.shape
 110:     for coord in body_coords:
 111:         dst = [coord[0], coord[1]]
 112:         dst[axis] = source_line + target_line - coord[axis]
 113:         r, c = dst
 114:         assert 0 <= r < h and 0 <= c < w, "reflected motif must stay in bounds"
 115:         assert out[r, c] == bg, "reflected motif must land on background"
 116:         out[r, c] = target
 117: 
 118:     return out
