   6: # concepts:
   7: # color guide, filling, objects
   8: 
   9: # description:
  10: # In the input, you will see a colored object in the middle and a single pixel in the bottom left corner of a different color.
  11: # To make the output, remove the pixel from bottom left corner and color the object in the middle with the color from the pixel you removed.
  12: 
  13: def main(input_grid):
  14:     """
  15:     Use the bottom-left guide pixel to recolor the central object.
  16: 
  17:     Input structure:
  18:     - A colored object appears away from the bottom-left corner.
  19:     - The bottom-left cell contains a single guide color.
  20:     - Black is the background and the guide color differs from the object color.
  21: 
  22:     Rule:
  23:     - Read the guide color from the bottom-left cell.
  24:     - Clear that guide pixel to black.
  25:     - Recolor every remaining foreground cell with the guide color.
  26: 
  27:     Key insight:
  28:     - The corner pixel is a color key that transfers its color and then disappears.
  29:     """
  30:     # copy the input grid to the output grid
  31:     output_grid = np.copy(input_grid)
  32: 
  33:     # get the color of the pixel in the bottom-left corner
  34:     color = int(output_grid[-1, 0])
  35: 
  36:     # remove the pixel from the bottom-left corner
  37:     output_grid[-1, 0] = Color.BLACK
  38: 
  39:     # color the object in the middle with the color of the pixel from the bottom left corner
  40:     output_grid[output_grid != Color.BLACK] = int(color)
  41:     # could also have used flood_fill:
  42:     # x, y = np.where(output_grid != Color.BLACK)
  43:     # flood_fill(output_grid, x[0], y[0], color)
  44: 
  45:     return output_grid
  46: 
  47: def generate_input():
  48:     # make 7x7 black grid with black background
  49:     n = m = 7
  50:     grid = np.zeros((n,m), dtype=int)
  51: 
  52:     # select a color for the sprite
  53:     sprite_color = np.random.choice(list(Color.NOT_BLACK))
  54: 
  55:     # select a color for the corner pixel
  56:     corner_color = np.random.choice(list(Color.NOT_BLACK))
  57: 
  58:     # check that colors are different
  59:     # if they are the same then try again
  60:     if sprite_color == corner_color:
  61:         return generate_input()
  62:     
  63:     # make random sprite and put it in middle of grid
  64:     sprite = random_sprite(m=m - 2, n=n - 2, symmetry="not_symmetric", color_palette=[int(sprite_color)])
  65:     paste(grid, sprite, 1, 1, transparent=Color.BLACK, clip=True)
  66: 
  67:     # put a single pixel in the bottom left corner
  68:     grid[-1, 0] = int(corner_color)
  69: 
  70:     return grid
