   1: 
   2: import numpy as np
   3: from typing import *
   4: import random
   5: from arc_utils import Color, bbox, draw_line, find_components, first_free_location, paste
   6: 
   7: # concepts:
   8: # pixel manipulation, growing
   9: 
  10: # description:
  11: # In the input you will see some number of colored crosses, each of which is 3 pixels tall, 3 pixels wide, and has a single pixel in the center of the cross that is a different color.
  12: # Make the output by growing the cross by 1 pixel north/south/east/west, and growing the center pixel by 2 pixels along each of the 4 diagonals.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Expand each two-color cross into a larger cross-and-diagonal motif.
  17: 
  18:     Input structure:
  19:     - The input contains small 3x3 cross objects on a black background.
  20:     - Each cross has one arm color and a different center color.
  21:     - Crosses are independent connected components.
  22: 
  23:     Rule:
  24:     - Locate the center and bounding box of each cross.
  25:     - Extend the arm color one step farther north, south, east, and west.
  26:     - Extend the center color along all four diagonals within the expanded 5x5 footprint.
  27: 
  28:     Key insight:
  29:     - The two colors have different growth roles: the arm color grows orthogonally, while the
  30:       center color grows diagonally.
  31:     """
  32: 
  33:     # extract the 3x3 crosses
  34:     crosses = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
  35: 
  36:     output_grid = input_grid.copy()
  37: 
  38:     for cross in crosses:
  39:         # find the center
  40:         _b = bbox(cross != Color.BLACK)
  41:         assert _b is not None
  42:         r, c, _r1, _c1 = _b
  43:         w = _r1 - r + 1
  44:         h = _c1 - c + 1
  45:         center_r, center_c = r + w//2, c + h//2
  46: 
  47:         # extract the relevant colors
  48:         center_color = cross[center_r, center_c]
  49:         cross_color = cross[cross != Color.BLACK][0]
  50: 
  51:         # grow the cross
  52:         for output_r in range(r-1, r+w+1):
  53:             for output_c in range(c-1, c+h+1):
  54:                 # skip if out of bounds
  55:                 if output_r < 0 or output_c < 0 or output_r >= input_grid.shape[0] or output_c >= input_grid.shape[1]:
  56:                     continue
  57:                 
  58:                 # grow the cross north/south/east/west
  59:                 if output_r == center_r or output_c == center_c:
  60:                     output_grid[output_r, output_c] = cross_color
  61:                 
  62:                 # grow the center diagonally
  63:                 if (output_r - center_r) == (output_c - center_c) or (output_r - center_r) == (center_c - output_c):
  64:                     output_grid[output_r, output_c] = center_color
  65: 
  66:     return output_grid
  67: 
  68: 
  69: 
  70: def generate_input():
  71:     input_grid = np.zeros((20, 20), dtype=int)
  72: 
  73:     # create 2 crosses
  74:     for cross_number in range(2):
  75:         # create a separate sprite
  76:         cross = np.zeros((3, 3), dtype=int)
  77:         cross_color, center_color = random.sample(list(Color.NOT_BLACK), 2)
  78:         cross[1, :] = cross_color
  79:         cross[:, 1] = cross_color
  80:         cross[1, 1] = center_color
  81: 
  82:         # find a free place on the grid
