    for j in range(NUM_COL_BANDS - 1):
        free = sum(len(row_bands[i]) for i in range(band_rows) if target[i][j] == target[i][j + 1])
        if free < 1:
            return False
    return True


def _gen_targets(row_bands, col_bands):
