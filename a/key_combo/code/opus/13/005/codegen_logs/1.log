+
+def _place_final_movers(
+    lane_map: np.ndarray,
+    lanes: list[int],
+    lane_modes: dict[int, str],
+    stacked_lane: int,
+    stationary_by_lane: dict[int, list[dict]],
+) -> tuple[np.ndarray, dict[int, list[dict]]] | None:
