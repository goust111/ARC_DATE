+        options.append((lift, moved))
+    return options
+
+
+def _build_input_from_output(
+    h: int,
+    w: int,
+    seed: tuple[int, int],
+    lane_map: np.ndarray,
+    lanes: list[int],
+    stationary_by_lane: dict[int, list[dict]],
+    movers_by_lane: dict[int, list[dict]],
+) -> tuple[np.ndarray, np.ndarray] | None:
