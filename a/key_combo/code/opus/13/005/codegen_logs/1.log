+    options: list[tuple[int, np.ndarray]] = []
+    max_lift = int(coords[:, 0].min())
+    for lift in range(int(min_lift), max_lift + 1):
+        moved = coords - np.array([lift, 0], dtype=int)
+        rows = moved[:, 0]
+        cols = moved[:, 1]
+        if np.any(lane_map[rows, cols] != lane_id):
