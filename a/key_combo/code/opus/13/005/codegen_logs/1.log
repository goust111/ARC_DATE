+def _ray_path(shape: tuple[int, int], seed: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = map(int, shape)
+    r, c = map(int, seed)
+    dc = 1
+    path: list[tuple[int, int]] = []
