+                    mask = np.zeros((h, w), dtype=bool)
+                    mask.ravel()[list(cells)] = True
+                    coords = np.argwhere(mask)
+                    if coords.size == 0:
+                        continue
+                    if _bbox(coords) != (0, 0, h - 1, w - 1):
+                        continue
+                    if not _is_connected(mask):
+                        continue
+                    key = tuple(int(x) for x in mask.ravel())
+                    if key in seen:
