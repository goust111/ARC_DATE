+    occupied = np.zeros((h, w), dtype=bool)
+    stationary_by_lane: dict[int, list[dict]] = {lane: [] for lane in lanes}
+
+    for lane in lanes:
+        shapes = SMALL_SHAPES[:]
+        random.shuffle(shapes)
+        placed = False
+        for mask in shapes:
