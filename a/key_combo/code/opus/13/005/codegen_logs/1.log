+            coords = random.choice(candidates)
+            color = _sample_color()
+            stationary_by_lane[lane].append(_component_from_coords(coords, color))
+            occupied[coords[:, 0], coords[:, 1]] = True
+            placed = True
+            break
+        if not placed:
+            return None
+    return occupied, stationary_by_lane
