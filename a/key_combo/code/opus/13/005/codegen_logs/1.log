+    if sum(v >= 2 for v in movers.values()) == 0:
+        return None
+
+    actual = main(inp)
+    if not np.array_equal(actual, expected):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid lane-gravity ARC input")

