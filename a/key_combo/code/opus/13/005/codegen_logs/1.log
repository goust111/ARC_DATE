+        movers.sort(key=lambda comp: int(comp["bbox"][0]))
+        lifts_accum = 0
+        for comp in movers:
+            min_lift = max(1, lifts_accum + random.randint(0, 1))
+            options = _lift_options(comp, lane_map, lane, blocked_in, min_lift)
+            if not options:
+                return None
+            lift, moved = random.choice(options)
+            lifts_accum = lift + 1
+            _paint(inp, moved, comp["color"])
+            blocked_in[moved[:, 0], moved[:, 1]] = True
