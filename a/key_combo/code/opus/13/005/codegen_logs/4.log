+        2: [2, 3, 4],
+        3: [1, 2, 3],
+        4: [1, 2],
+        5: [1, 2],
+    }[int(width)]
+    for _ in range(200):
+        height = random.choice(height_options)
+        patch = random_sprite(
+            height,
+            width,
+            density=random.uniform(0.45, 0.9),
+            symmetry="not_symmetric",
+            color_palette=[OBJECT_COLOR],
+            connectivity=8,
+            background=BG,
+        )
+        area = _patch_area(patch)
+        if 3 <= area <= 9:
+            return patch
+    return None
