+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        sample = _generation_attempt()
+        if sample is None:
+            continue
+        inp, expected = sample
+        try:
+            solved = main(inp)
+        except Exception:
+            continue
+        if np.array_equal(solved, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

