+def _pair_edge(grid: np.ndarray, bg: int, a: dict, b: dict) -> dict:
+    ar0, ac0, ar1, ac1 = a["bbox"]
+    br0, bc0, br1, bc1 = b["bbox"]
+    candidates: list[dict] = []
+
+    if ac1 < bc0 or bc1 < ac0:
+        if ac1 < bc0:
+            left, right = a, b
+        else:
+            left, right = b, a
+        lr0, lc0, lr1, lc1 = left["bbox"]
+        rr0, rc0, rr1, rc1 = right["bbox"]
+        r0 = max(lr0 + 1, rr0 + 1)
+        r1 = min(lr1 - 1, rr1 - 1)
