0154: def _gen_pick_layout(n: int) -> tuple[int, int, int, int, int] | None:
0155:     h_min, h_max = OBJECT_HEIGHT_RANGE
0156:     pairs = [
0157:         (rh, nh)
0158:         for rh in range(h_min, h_max + 1)
0159:         for nh in range(h_min, h_max + 1)
