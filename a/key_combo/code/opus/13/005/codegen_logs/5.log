0734:         return None
0735:     loop_counts = sorted({len(combo) for combo in combo_options})
0736:     loop_count = random.choice(loop_counts)
0737:     count_options = [combo for combo in combo_options if len(combo) == loop_count]
0738:     sizes = list(random.choice(count_options))
