0366: def _gen_attempt() -> np.ndarray | None:
0367:     rng = random.Random()
0368:     bg = 8
0369:     N = 4
0370:     edge_len = N - 2  # = 2
0371: 
0372:     H = rng.randint(18, 26)
0373:     W = rng.randint(20, 26)
0374: 
0375:     # Choose 4 distinct non-bg colors for hub edges
0376:     all_colors = [c for c in range(10) if c != bg]
0377:     rng.shuffle(all_colors)
0378:     top_col, bot_col, left_col, right_col = all_colors[:4]
0379: 
0380:     sides = ["top", "bot", "left", "right"]
0381:     side_colors = {"top": top_col, "bot": bot_col, "left": left_col, "right": right_col}
0382: 
0383:     # Choose K sides (2-4) to get sprites
0384:     K = rng.randint(2, 4)
0385:     sprite_sides = rng.sample(sides, K)
0386: 
0387:     # Generate sprite masks for each chosen side
0388:     sprite_masks = {}
0389:     for side in sprite_sides:
0390:         mask = _make_sprite_mask(edge_len, side, rng)
0391:         if mask is None:
0392:             return None
0393:         sprite_masks[side] = mask
0394: 
0395:     # Compute max sprite extent to ensure enough margin for hub placement
0396:     max_sprite_h = max(m.shape[0] for m in sprite_masks.values())
0397:     max_sprite_w = max(m.shape[1] for m in sprite_masks.values())
0398:     max_extent = max(max_sprite_h, max_sprite_w)
0399:     margin = max_extent + 2
0400: 
0401:     # Place hub near center with margin
0402:     hub_r_min = margin
0403:     hub_r_max = H - N - margin
0404:     hub_c_min = margin
0405:     hub_c_max = W - N - margin
0406:     if hub_r_min > hub_r_max or hub_c_min > hub_c_max:
0407:         return None
0408: 
0409:     hub_r = rng.randint(hub_r_min, hub_r_max)
0410:     hub_c = rng.randint(hub_c_min, hub_c_max)
0411: 
0412:     # Build output grid
0413:     out = np.full((H, W), bg, dtype=int)
0414: 
0415:     # Place hub
0416:     # Top edge
0417:     for ci in range(1, N - 1):
0418:         out[hub_r, hub_c + ci] = top_col
0419:     # Bottom edge
0420:     for ci in range(1, N - 1):
0421:         out[hub_r + N - 1, hub_c + ci] = bot_col
0422:     # Left edge
0423:     for ri in range(1, N - 1):
0424:         out[hub_r + ri, hub_c] = left_col
0425:     # Right edge
0426:     for ri in range(1, N - 1):
0427:         out[hub_r + ri, hub_c + N - 1] = right_col
0428: 
0429:     # Attach sprites to hub in output
0430:     attached_sprites = {}  # side -> (arr, mask, sr, sc) in output coords
0431:     for side in sprite_sides:
0432:         mask = sprite_masks[side]
0433:         sh, sw = mask.shape
0434:         color = side_colors[side]
0435:         arr = np.where(mask, color, bg).astype(int)
0436: 
0437:         # Compute placement so sprite's contact edge is flush with hub side.
0438:         # The solver's segs dict defines: for each side, the contact position and span.
0439:         #   top -> sprite's bot row at hub_r-1, cols hub_c+1..hub_c+N-2
0440:         #   bot -> sprite's top row at hub_r+N, cols hub_c+1..hub_c+N-2
0441:         #   left -> sprite's right col at hub_c-1, rows hub_r+1..hub_r+N-2
0442:         #   right -> sprite's left col at hub_c+N, rows hub_r+1..hub_r+N-2
0443:         if side == "top":
0444:             # Find first filled col on bottom row of sprite
0445:             filled = np.where(mask[-1])[0]
0446:             sc = hub_c + 1 - int(filled[0])
0447:             sr = hub_r - sh  # bottom row of sprite at row hub_r-1
0448:         elif side == "bot":
0449:             filled = np.where(mask[0])[0]
0450:             sc = hub_c + 1 - int(filled[0])
0451:             sr = hub_r + N  # top row of sprite at row hub_r+N
0452:         elif side == "left":
0453:             filled = np.where(mask[:, -1])[0]
0454:             sr = hub_r + 1 - int(filled[0])
0455:             sc = hub_c - sw  # right col of sprite at col hub_c-1
0456:         else:  # right
0457:             filled = np.where(mask[:, 0])[0]
0458:             sr = hub_r + 1 - int(filled[0])
0459:             sc = hub_c + N  # left col of sprite at col hub_c+N
0460: 
0461:         # Check bounds
0462:         if sr < 0 or sc < 0 or sr + sh > H or sc + sw > W:
0463:             return None
0464: 
0465:         # Check no overlap with existing content
0466:         for r in range(sh):
0467:             for c in range(sw):
0468:                 if mask[r, c] and out[sr + r, sc + c] != bg:
0469:                     return None
0470: 
0471:         paste(out, arr, sr, sc, transparent=bg)
0472:         attached_sprites[side] = (arr, mask, sr, sc)
0473: 
0474:     # Verify output is correct by running solver later (via oracle check)
0475: 
0476:     # Build input: hub + scattered sprites in random rotations + optional distractor
0477:     inp = np.full((H, W), bg, dtype=int)
0478:     # Place hub on input
0479:     inp[hub_r:hub_r+N, hub_c:hub_c+N] = out[hub_r:hub_r+N, hub_c:hub_c+N]
0480: 
0481:     # Canvas for placement tracking
0482:     canvas = inp.copy()
0483: 
0484:     for side in sprite_sides:
0485:         arr, mask, sr, sc = attached_sprites[side]
0486:         # Apply a random non-identity rotation
0487:         # But we need to ensure the solver will find the right rotation
0488:         # The solver uses 8-connectivity labeling and picks the largest component of matching color
0489:         # Apply a random rotation (1-3 quarter turns, avoiding identity)
0490:         k = rng.choice([1, 2, 3])
0491:         rotated_arr = np.rot90(arr, k)
0492:         rotated_mask = np.rot90(mask, k)
0493: 
0494:         # Crop to bounding box of the mask
0495:         rows_any = rotated_mask.any(axis=1)
0496:         cols_any = rotated_mask.any(axis=0)
0497:         r0_idx, r1_idx = np.where(rows_any)[0][[0, -1]]
0498:         c0_idx, c1_idx = np.where(cols_any)[0][[0, -1]]
0499:         cropped_arr = rotated_arr[r0_idx:r1_idx+1, c0_idx:c1_idx+1]
0500:         cropped_mask = rotated_mask[r0_idx:r1_idx+1, c0_idx:c1_idx+1]
0501:         patch = np.where(cropped_mask, cropped_arr, bg).astype(int)
0502: 
0503:         try:
0504:             pr, pc = random_free_location(canvas, patch, transparent=bg, padding=2, padding_connectivity=8)
0505:         except ValueError:
0506:             return None
0507:         paste(canvas, patch, pr, pc, transparent=bg)
0508:         paste(inp, patch, pr, pc, transparent=bg)
0509: 
0510:     # Optionally add a distractor (0 or 1)
0511:     if rng.random() < 0.3:
0512:         used_colors = set(side_colors.values())
0513:         distractor_colors = [c for c in range(10) if c != bg and c not in used_colors]
0514:         if distractor_colors:
0515:             dcol = rng.choice(distractor_colors)
0516:             # Make a small distractor sprite
0517:             dist_mask = _make_sprite_mask(edge_len, rng.choice(sides), rng)
0518:             if dist_mask is not None:
0519:                 dist_arr = np.where(dist_mask, dcol, bg).astype(int)
0520:                 try:
0521:                     pr, pc = random_free_location(canvas, dist_arr, transparent=bg, padding=2, padding_connectivity=8)
0522:                     paste(canvas, dist_arr, pr, pc, transparent=bg)
0523:                     paste(inp, dist_arr, pr, pc, transparent=bg)
0524:                 except ValueError:
0525:                     pass  # skip distractor if no room
0526: 
0527:     # Oracle check
0528:     result = main(inp)
0529:     if not np.array_equal(result, out):
0530:         return None
0531: 
0532:     return inp
0533: 
