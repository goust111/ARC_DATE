0167:         return None
0168:     rect_w = random.randint(min_w, max_w)
0169: 
0170:     place_nonsplit_above = random.choice(NONSPLIT_ABOVE_CHOICES)
0171:     if place_nonsplit_above:
0172:         max_rect_top = n - rect_h
0173:         min_rect_top = nonsplit_h + ROW_GAP_MIN
0174:         if min_rect_top > max_rect_top:
0175:             return None
0176:         rect_top = random.randint(min_rect_top, max_rect_top)
0177:         nonsplit_top = random.randint(0, rect_top - nonsplit_h - ROW_GAP_MIN)
0178:     else:
0179:         max_rect_top = n - rect_h - nonsplit_h - ROW_GAP_MIN
0180:         if max_rect_top < 0:
0181:             return None
0182:         rect_top = random.randint(0, max_rect_top)
0183:         nonsplit_top = random.randint(rect_top + rect_h + ROW_GAP_MIN, n - nonsplit_h)
0184:     return rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top
