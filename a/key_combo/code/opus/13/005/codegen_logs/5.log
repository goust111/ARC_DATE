+
+
+def _apply_corridor(out: np.ndarray, bg: int, color: int, edge: dict) -> None:
+    r0 = int(edge["r0"])
+    r1 = int(edge["r1"])
+    c0 = int(edge["c0"])
+    c1 = int(edge["c1"])
+    if edge["kind"] == "h":
+        out[r0, c0 : c1 + 1] = color
+        out[r1, c0 : c1 + 1] = color
+        left = edge["left"]
+        right = edge["right"]
