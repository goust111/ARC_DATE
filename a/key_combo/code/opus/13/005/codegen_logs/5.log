0041: def main(grid: np.ndarray) -> np.ndarray:
0042:     """Recolor each closed orthogonal line loop so convex bend pixels are yellow and concave bend pixels are red.
0043: 
0044:     Input structure
0045:     - The grid has a dominant background and exactly one foreground color.
0046:     - The foreground forms one or more 4-connected one-pixel-wide closed cycles; every foreground pixel has degree 2.
0047:     Rule
0048:     - Trace each cycle and inspect the turn at each foreground pixel.
0049:     - Straight pixels keep the original foreground color.
0050:     - Bend pixels whose turn direction is the majority direction for that cycle are convex corners and become yellow.
0051:     - Bend pixels whose turn direction is the minority direction for that cycle are concave corners and become red.
0052:     Key insight
0053:     - A simple rectilinear closed boundary has exactly four more convex bends than concave bends, so convexity can be inferred structurally from the majority turn sign within each traced cycle.
0054:     """
0055:     g = np.asarray(grid, dtype=int)
0056:     bg = get_bg(g)
0057:     colors = colors_present(g, exclude={bg})
