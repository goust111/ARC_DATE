0426: def _gen_marker_cells(g: np.ndarray) -> set[tuple[int, int]]:
0427:     return {
0428:         (int(r), int(c))
0429:         for r, c in np.argwhere(_gen_marker_mask(g))
0430:     }
0431: 
0432: 
0433: def _gen_no_marker_neighbor(
0434:     r: int, c: int, markers: list[tuple[int, int]]
0435: ) -> bool:
0436:     for mr, mc in markers:
0437:         if max(abs(int(r) - mr), abs(int(c) - mc)) <= _GEN_MARKER_NEIGHBOR_RADIUS:
0438:             return False
0439:     return True
0440: 
0441: 
0442: def _gen_component_after_marker_ok(mask: np.ndarray, r: int, c: int) -> tuple[bool, int]:
0443:     rest = mask.copy()
0444:     rest[r, c] = False
0445:     labels, n_labels = label_mask(rest, connectivity=4)
0446:     if n_labels == 0:
0447:         return False, 0
0448:     for label_id in range(1, n_labels + 1):
0449:         coords = np.argwhere(labels == label_id)
0450:         if len(coords) < _GEN_BLACK_COMPONENT_MIN_AREA:
0451:             return False, n_labels
0452:         touches = False
0453:         for nr, nc in neighbors4(r, c):
0454:             if in_bounds(mask.shape, nr, nc) and labels[nr, nc] == label_id:
0455:                 touches = True
0456:                 break
0457:         if not touches:
0458:             return False, n_labels
0459:     return True, n_labels
0460: 
0461: 
0462: def _gen_required_marker_candidates(
0463:     g: np.ndarray,
0464:     labels: np.ndarray,
0465:     label_id: int,
0466:     markers: list[tuple[int, int]],
0467: ) -> list[tuple[int, int]]:
0468:     comp_mask = labels == label_id
0469:     candidates = []
0470:     for r, c in np.argwhere(comp_mask):
0471:         r = int(r)
0472:         c = int(c)
0473:         if g[r, c] != _GEN_BLACK or not _gen_no_marker_neighbor(r, c, markers):
0474:             continue
0475:         blue_adj = _gen_count_blue_neighbors(g, r, c)
0476:         if blue_adj == 0:
0477:             continue
0478:         ok, split_count = _gen_component_after_marker_ok(comp_mask, r, c)
0479:         if ok:
0480:             candidates.append((split_count, -blue_adj, r, c))
0481:     random.shuffle(candidates)
0482:     candidates.sort()
0483:     return [(r, c) for _, _, r, c in candidates]
0484: 
0485: 
0486: def _gen_coords_touch_markers(coords: np.ndarray, markers: set[tuple[int, int]]) -> bool:
0487:     for r, c in coords:
0488:         for nr, nc in neighbors4(int(r), int(c)):
0489:             if (nr, nc) in markers:
0490:                 return True
0491:     return False
0492: 
0493: 
0494: def _gen_components_touch_markers(g: np.ndarray) -> bool:
0495:     markers = _gen_marker_cells(g)
0496:     if not markers:
0497:         return False
0498:     for color in _GEN_BASE_COLORS:
0499:         labels, n_labels = label_mask(g == color, connectivity=4)
0500:         if n_labels == 0:
0501:             return False
0502:         for label_id in range(1, n_labels + 1):
0503:             coords = np.argwhere(labels == label_id)
0504:             if color == _GEN_BLACK and not (
0505:                 _GEN_BLACK_COMPONENT_MIN_AREA <= len(coords) <= _GEN_BLACK_COMPONENT_MAX_AREA
0506:             ):
0507:                 return False
0508:             if not _gen_coords_touch_markers(coords, markers):
0509:                 return False
0510:     return True
0511: 
0512: 
0513: def _gen_black_side_ok(g: np.ndarray) -> bool:
0514:     markers = _gen_marker_cells(g)
0515:     labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
0516:     if not (_GEN_BLACK_COMPONENT_MIN_COUNT <= n_labels <= _GEN_BLACK_COMPONENT_MAX_COUNT):
0517:         return False
0518:     for label_id in range(1, n_labels + 1):
0519:         coords = np.argwhere(labels == label_id)
0520:         if not (
0521:             _GEN_BLACK_COMPONENT_MIN_AREA <= len(coords) <= _GEN_BLACK_COMPONENT_MAX_AREA
0522:         ):
0523:             return False
0524:         if not _gen_coords_touch_markers(coords, markers):
0525:             return False
0526:     return True
0527: 
0528: 
0529: def _gen_blue_component_touched(
0530:     g: np.ndarray, labels: np.ndarray, label_id: int
0531: ) -> bool:
0532:     markers = _gen_marker_cells(g)
0533:     return _gen_coords_touch_markers(np.argwhere(labels == label_id), markers)
0534: 
0535: 
0536: def _gen_cover_blue_components(
0537:     g: np.ndarray, markers: list[tuple[int, int]]
0538: ) -> list[tuple[int, int]] | None:
0539:     for _ in range(_GEN_COVER_BLUE_RETRIES):
0540:         labels, n_labels = label_mask(g == _GEN_BLUE, connectivity=4)
0541:         uncovered = [
0542:             label_id
0543:             for label_id in range(1, n_labels + 1)
0544:             if not _gen_blue_component_touched(g, labels, label_id)
0545:         ]
0546:         if not uncovered:
0547:             return markers
0548:         label_id = random.choice(uncovered)
0549:         candidates = set()
0550:         for r, c in np.argwhere(labels == label_id):
0551:             for nr, nc in neighbors4(int(r), int(c)):
0552:                 if in_bounds(g.shape, nr, nc) and g[nr, nc] == _GEN_BLACK:
0553:                     candidates.add((nr, nc))
0554:         scored = []
0555:         for r, c in candidates:
0556:             if not _gen_no_marker_neighbor(r, c, markers):
0557:                 continue
0558:             temp = g.copy()
0559:             temp[r, c] = _GEN_TEMP_MARKER
0560:             if _gen_black_side_ok(temp):
0561:                 blue_adj = _gen_count_blue_neighbors(temp, r, c)
0562:                 scored.append((blue_adj, r, c))
0563:         if not scored or len(markers) >= _GEN_MARKER_MAX_COUNT:
0564:             return None
0565:         random.shuffle(scored)
0566:         scored.sort(reverse=True)
0567:         _, r, c = random.choice(_gen_top_choices(scored, _GEN_BLUE_COVER_TOP_K))
0568:         g[r, c] = _GEN_TEMP_MARKER
0569:         markers.append((r, c))
0570:     return None
0571: 
0572: 
0573: def _gen_blue_stats(g: np.ndarray) -> tuple[int, int, float]:
0574:     blue = g == _GEN_BLUE
0575:     if not np.any(blue):
0576:         return 0, 0, 0.0
0577:     degrees = np.zeros(g.shape, dtype=int)
0578:     degrees[1:, :] += blue[:-1, :]
0579:     degrees[:-1, :] += blue[1:, :]
0580:     degrees[:, 1:] += blue[:, :-1]
0581:     degrees[:, :-1] += blue[:, 1:]
0582:     blue_degrees = degrees[blue]
0583:     endpoints = int(np.sum(blue_degrees == 1))
0584:     branches = int(np.sum(blue_degrees >= 3))
0585:     degree2 = float(np.sum(blue_degrees == 2) / len(blue_degrees))
0586:     return endpoints, branches, degree2
0587: 
0588: 
0589: def _gen_base_ok(g: np.ndarray) -> bool:
0590:     if g.shape != _GEN_SHAPE:
0591:         return False
0592:     blue_total = int(np.sum(g == _GEN_BLUE))
0593:     if not (_GEN_BLUE_TOTAL_MIN <= blue_total <= _GEN_BLUE_TOTAL_MAX):
0594:         return False
0595: 
0596:     black_labels, black_count = label_mask(g == _GEN_BLACK, connectivity=4)
0597:     _, blue_count = label_mask(g == _GEN_BLUE, connectivity=4)
0598:     if not (
0599:         _GEN_BLACK_COMPONENT_MIN_COUNT <= black_count <= _GEN_BLACK_COMPONENT_MAX_COUNT
0600:         and _GEN_BLUE_COMPONENT_MIN_COUNT <= blue_count <= _GEN_BLUE_COMPONENT_MAX_COUNT
0601:     ):
0602:         return False
0603: 
0604:     for label_id in range(1, black_count + 1):
0605:         area = int(np.sum(black_labels == label_id))
0606:         if not (_GEN_BLACK_COMPONENT_MIN_AREA <= area <= _GEN_BLACK_COMPONENT_MAX_AREA):
0607:             return False
0608: 
0609:     endpoints, branches, degree2 = _gen_blue_stats(g)
0610:     if not (
0611:         _GEN_MIN_ENDPOINTS <= endpoints <= _GEN_MAX_ENDPOINTS
0612:         and 0 <= branches <= _GEN_MAX_BRANCHES
0613:         and _GEN_DEGREE2_MIN <= degree2 <= _GEN_DEGREE2_MAX
0614:     ):
0615:         return False
0616: 
0617:     return _gen_components_touch_markers(g)
0618: 
0619: 
0620: def _gen_place_required_markers(g: np.ndarray) -> list[tuple[int, int]] | None:
0621:     labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
0622:     component_ids = list(range(1, n_labels + 1))
0623:     random.shuffle(component_ids)
0624:     component_ids.sort(key=lambda i: int(np.sum(labels == i)))
0625: 
0626:     markers: list[tuple[int, int]] = []
0627:     for label_id in component_ids:
0628:         candidates = _gen_required_marker_candidates(g, labels, label_id, markers)
0629:         if not candidates:
0630:             return None
0631:         r, c = random.choice(_gen_top_choices(candidates, _GEN_REQUIRED_MARKER_TOP_K))
0632:         g[r, c] = _GEN_TEMP_MARKER
0633:         markers.append((r, c))
0634:     markers = _gen_cover_blue_components(g, markers)
0635:     if markers is None or len(markers) > _GEN_MARKER_MAX_COUNT:
0636:         return None
0637:     if not _gen_base_ok(g):
0638:         return None
0639:     return markers
0640: 
0641: 
0642: def _gen_extra_marker_candidates(
0643:     g: np.ndarray, markers: list[tuple[int, int]]
0644: ) -> list[tuple[int, int]]:
0645:     candidates = []
0646:     for r, c in np.argwhere(g == _GEN_BLACK):
0647:         r = int(r)
0648:         c = int(c)
0649:         if not _gen_no_marker_neighbor(r, c, markers):
0650:             continue
0651:         blue_adj = _gen_count_blue_neighbors(g, r, c)
0652:         if blue_adj == 0:
0653:             continue
0654:         temp = g.copy()
0655:         temp[r, c] = _GEN_TEMP_MARKER
0656:         if _gen_base_ok(temp):
0657:             candidates.append((blue_adj, r, c))
0658:     random.shuffle(candidates)
0659:     candidates.sort(reverse=True)
0660:     return [(r, c) for _, r, c in candidates]
0661: 
0662: 
0663: def _gen_assign_marker_colors(
0664:     g: np.ndarray, markers: list[tuple[int, int]]
0665: ) -> None:
0666:     n_markers = len(markers)
0667:     if n_markers == _GEN_MARKER_MAX_COUNT:
0668:         colors = list(random.sample(_GEN_MARKER_COLORS, _GEN_MARKER_MAX_DISTINCT))
0669:         colors.append(random.choice(colors))
0670:     elif (
0671:         n_markers >= _GEN_MARKER_MIN_COUNT + 1
0672:         and random.random() < _GEN_DUPLICATE_MARKER_PROB
0673:     ):
0674:         colors = list(random.sample(_GEN_MARKER_COLORS, n_markers - 1))
0675:         colors.append(random.choice(colors))
0676:     else:
0677:         colors = list(random.sample(_GEN_MARKER_COLORS, n_markers))
0678:     random.shuffle(colors)
0679:     for (r, c), color in zip(markers, colors):
0680:         g[r, c] = color
0681: 
0682: 
0683: def _gen_final_ok(g: np.ndarray) -> bool:
0684:     if not _gen_base_ok(g):
0685:         return False
0686: 
0687:     marker_values = [
0688:         int(g[r, c])
