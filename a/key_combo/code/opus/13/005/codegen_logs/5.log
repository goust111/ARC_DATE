0208: def _make_sprite_mask(edge_len: int, side: str, rng: random.Random) -> np.ndarray | None:
0209:     """
0210:     Constructively build a sprite mask in the attached orientation for `side`.
0211:     The mask is bool, 8-connected, has the correct symmetry and contact-edge length,
0212:     and exactly 1 rotation (out of 4) is a valid attachment for any hub side.
0213: 
0214:     Strategy: build in canonical "left-attach" frame (flipud symmetric, contact on right col),
0215:     then rotate to the target side.
0216:     """
0217:     # Build in "left-attach" frame: h rows, w cols.
0218:     # Right column = contact edge with exactly `edge_len` contiguous filled cells.
0219:     # flipud symmetric (rows mirror top-to-bottom).
0220:     # h > w ensures not square, breaking 90-degree rotation ambiguity.
0221:     # Also ensure NOT fliplr symmetric to prevent the complementary side matching.
0222:     e = edge_len  # = 2 for N=4
0223:     h = rng.choice([3, 4])  # height: 3 or 4 (must be > e to break symmetry)
0224:     w = rng.randint(2, 4)   # width: 2-4 (cols including the contact column)
0225: 
0226:     half_h = (h + 1) // 2  # rows to decide (rest mirrored vertically)
0227: 
0228:     for _attempt in range(100):
0229:         grid = np.zeros((h, w), dtype=bool)
0230: 
0231:         # Contact edge: rightmost column, middle `e` rows filled, rest empty.
0232:         # For flipud symmetry with h=3 or h=4 and e=2:
0233:         #   h=3: rows 0,2 empty; row 1 filled -> only 1 contiguous. No good.
0234:         #   Actually for h=4, e=2: rows 1,2 filled (symmetric pair). Contact = [F,T,T,F]
0235:         #   For h=3, e=2: rows 0,2 mirrored. If row 0=T, row 2=T, row 1=T -> 3 contig.
0236:         #                  If row 0=F, row 2=F, row 1=T -> 1 contig. Not enough.
0237:         #                  Need to allow row0=T,row1=T,row2=T -> 3 != e.
0238:         # So for h=3, e=2 the rightmost col can't have exactly 2 contiguous cells
0239:         # with flipud symmetry. Let me think differently.
0240: 
0241:         # The contact edge doesn't have to span the full height. It's the N-2 contiguous
0242:         # cells on the attachment side. For "left-attach", the solver checks the RIGHT edge
0243:         # of the cropped sprite: exactly e contiguous filled cells.
0244: 
0245:         # Build each row from right to left. Rightmost col is the contact column.
0246:         # For flipud symmetry, row[i] mirrors row[h-1-i].
0247:         # Decide top half, mirror to bottom.
0248: 
0249:         for ri in range(half_h):
0250:             mirror_ri = h - 1 - ri
0251:             for ci in range(w):
0252:                 if ci == w - 1:
0253:                     # Contact column: fill rows that form the contiguous e-block
0254:                     # Place the e-block centered. For h=4,e=2: rows 1,2. For h=3,e=2: impossible with strict flipud.
0255:                     # Instead: just decide freely and check later
0256:                     val = rng.random() < 0.5
0257:                 else:
0258:                     val = rng.random() < 0.5
0259:                 grid[ri, ci] = val
0260:                 grid[mirror_ri, ci] = val
0261: 
0262:         # Check: rightmost column has exactly e contiguous filled cells
0263:         right_col = grid[:, -1]
0264:         # Find contiguous runs
0265:         runs = []
0266:         count = 0
0267:         for v in right_col:
0268:             if v:
0269:                 count += 1
0270:             else:
0271:                 if count > 0:
0272:                     runs.append(count)
0273:                 count = 0
0274:         if count > 0:
0275:             runs.append(count)
0276:         if len(runs) != 1 or runs[0] != e:
0277:             continue
0278: 
0279:         # Trim empty rows/cols
0280:         rows_any = grid.any(axis=1)
0281:         cols_any = grid.any(axis=0)
0282:         if not rows_any.any():
0283:             continue
0284:         r0, r1 = np.where(rows_any)[0][[0, -1]]
0285:         c0, c1 = np.where(cols_any)[0][[0, -1]]
0286:         grid = grid[r0:r1+1, c0:c1+1]
0287: 
0288:         if grid.shape[0] < 2 or grid.shape[1] < 2:
0289:             continue
0290: 
0291:         # Check flipud symmetry
0292:         if not np.array_equal(grid, np.flipud(grid)):
0293:             continue
0294: 
0295:         # Check 8-connectivity
0296:         labeled, num = _label(grid, structure=np.ones((3, 3), dtype=int))
0297:         if num != 1:
0298:             continue
0299: 
0300:         # Must NOT be fliplr symmetric (to avoid the other side matching)
0301:         if np.array_equal(grid, np.fliplr(grid)):
0302:             continue
0303: 
0304:         # Pixel count 4-12
0305:         px = int(grid.sum())
0306:         if px < 4 or px > 12:
0307:             continue
0308: 
0309:         # Now verify exactly 1 valid attachment across all 4 rotations x 4 sides.
0310:         # The solver, for each side, tries rot90 x 0-3 and checks:
0311:         #   - correct symmetry (fliplr for top/bot, flipud for left/right)
0312:         #   - contact edge = e contiguous cells on the correct side
0313:         # We need exactly 1 such (rotation, side) pair across all possibilities.
0314:         # Actually, the solver matches by color, so each sprite is only tested against
0315:         # one side. But we need: for ANY side the solver might try, only 1 rotation works.
0316:         # Since the solver already picks the first valid rotation, we just need that
0317:         # for the intended side, exactly 1 rotation of the sprite is valid.
0318: 
0319:         # Check: for the canonical "left" side, how many rotations are valid?
0320:         valid_for_left = 0
0321:         for k in range(4):
0322:             rot = np.rot90(grid, k)
0323:             # Trim
0324:             ra = rot.any(axis=1)
0325:             ca = rot.any(axis=0)
0326:             rr0, rr1 = np.where(ra)[0][[0, -1]]
0327:             cc0, cc1 = np.where(ca)[0][[0, -1]]
0328:             cr = rot[rr0:rr1+1, cc0:cc1+1]
0329:             # Left side needs flipud + right-edge = e contiguous
0330:             if not np.array_equal(cr, np.flipud(cr)):
0331:                 continue
0332:             rc = cr[:, -1]
0333:             runs2 = []
0334:             cnt2 = 0
0335:             for v in rc:
0336:                 if v: cnt2 += 1
0337:                 else:
0338:                     if cnt2 > 0: runs2.append(cnt2)
0339:                     cnt2 = 0
0340:             if cnt2 > 0: runs2.append(cnt2)
0341:             if len(runs2) == 1 and runs2[0] == e:
0342:                 valid_for_left += 1
0343: 
0344:         if valid_for_left != 1:
0345:             continue
0346: 
0347:         # Success! Now rotate to target side.
0348:         # grid is in "left-attach" frame (contact on right, flipud symmetric).
0349:         # left -> as-is
0350:         # right -> fliplr (contact moves to left side)
0351:         # top -> rot90 CW (contact moves to bottom)
0352:         # bot -> rot90 CCW (contact moves to top)
0353:         if side == "left":
0354:             mask = grid.copy()
0355:         elif side == "right":
0356:             mask = np.fliplr(grid)
0357:         elif side == "top":
0358:             mask = np.rot90(grid, -1)  # CW: right->bottom
0359:         else:  # bot
0360:             mask = np.rot90(grid, 1)   # CCW: right->top
0361:         return mask
0362: 
0363:     return None
0364: 
