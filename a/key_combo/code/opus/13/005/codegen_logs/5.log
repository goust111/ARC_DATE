0152: def _gen_trace_cycle(mask):
0153:     pts = {tuple(map(int, p)) for p in np.argwhere(mask)}
0154:     if len(pts) < GEN_PERIMETER_RANGE[0]:
0155:         return None
0156:     for r, c in pts:
0157:         degree = sum((r + dr, c + dc) in pts for dr, dc in GEN_DIRS4)
0158:         if degree != 2:
0159:             return None
0160: 
0161:     start = min(pts)
0162:     neigh = sorted((start[0] + dr, start[1] + dc) for dr, dc in GEN_DIRS4 if (start[0] + dr, start[1] + dc) in pts)
0163:     if len(neigh) != 2:
0164:         return None
0165:     path = [start]
0166:     prev, cur = start, neigh[0]
0167:     while cur != start:
0168:         path.append(cur)
0169:         nxt = [
0170:             (cur[0] + dr, cur[1] + dc)
0171:             for dr, dc in GEN_DIRS4
0172:             if (cur[0] + dr, cur[1] + dc) in pts
0173:             and (cur[0] + dr, cur[1] + dc) != prev
0174:         ]
0175:         if len(nxt) != 1 or len(path) > len(pts):
0176:             return None
0177:         prev, cur = cur, nxt[0]
0178:     return path if len(path) == len(pts) else None
