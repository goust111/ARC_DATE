0137: 
0138:         spr_mask = labc == int(best_id)
0139:         spr_arr = g.copy()
0140:         spr_arr[~spr_mask] = int(bg)
0141:         spr_arr, spr_mask = _crop_to_mask(spr_arr, spr_mask)
0142: 
0143:         found = None  # (a, msk, dr, dc)
0144:         for krot in range(4):
0145:             a = np.rot90(spr_arr, int(krot))
0146:             msk = np.rot90(spr_mask, int(krot))
0147:             a, msk = _crop_to_mask(a, msk)
0148: 
0149:             # Attached sprite must be mirror-symmetric along the contact edge axis
0150:             if need_edge in ("left", "right"):
0151:                 if not bool(np.array_equal(msk, np.flipud(msk))):
0152:                     continue
0153:             else:
0154:                 if not bool(np.array_equal(msk, np.fliplr(msk))):
0155:                     continue
0156: 
0157:             seg = _edge_segment(msk, need_edge)
