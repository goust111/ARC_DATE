0281:             if not (0 <= nxt[0] < h and 0 <= nxt[1] < w):
0282:                 continue
0283:             if nxt == forbidden or nxt in parent:
0284:                 continue
0285:             parent[nxt] = cur
0286:             q.append(nxt)
