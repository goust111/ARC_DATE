0168: def main(grid: np.ndarray) -> np.ndarray:
0169:     """
0170:     Connect hollow rectangular frames into one shortest visible corridor network.
0171: 
0172:     Input structure
0173:     - A single foreground color forms disconnected hollow rectangular frames on the background.
0174:     - A visible candidate gap is horizontal or vertical, has overlapping frame interiors, and is clear background between the two frames.
0175: 
0176:     Rule
0177:     - Select the minimum-length spanning set of visible frame-to-frame gaps.
0178:     - For a horizontal selected gap, paint the two boundary rows of the overlapping interiors across the gap, then erase the facing wall cells strictly between those rows.
0179:     - For a vertical selected gap, do the transposed operation with boundary columns and the facing top/bottom wall cells.
0180: 
0181:     Key insight
0182:     - The connector is determined by the overlap of the rooms' interiors, and longer redundant visible gaps are ignored once the shortest spanning network connects all frames.
0183:     """
0184:     g = np.asarray(grid, dtype=int)
0185:     bg = get_bg(g)
0186:     color, rects = _rectangles(g, bg)
0187:     edges = _candidate_edges(g, bg, rects)
0188:     chosen = _spanning_edges(edges, len(rects))
0189: 
0190:     out = g.copy()
0191:     for edge in chosen:
0192:         _apply_edge(out, bg, color, rects, edge)
0193: 
0194:     comps = find_components(out, bg=bg, connectivity=4, monochromatic=True, colors=[color])
0195:     assert len(comps) == 1
0196:     return out
