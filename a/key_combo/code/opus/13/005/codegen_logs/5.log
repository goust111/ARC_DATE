0175: def _gen_place_rectangles(
0176:     sizes: list[tuple[int, int]],
0177: ) -> list[tuple[int, int, int, int]] | None:
0178:     sizes = sorted(sizes, key=lambda s: s[0] * s[1], reverse=True)
0179:     placed: list[tuple[int, int, int, int]] = []
0180: 
0181:     def search(i: int) -> bool:
0182:         if i == len(sizes):
0183:             return True
0184:         h, w = sizes[i]
0185:         positions = [
0186:             (r, c)
0187:             for r in range(_GEN_LOOP_MARGIN, _GEN_H - h - _GEN_LOOP_MARGIN + 1)
0188:             for c in range(_GEN_LOOP_MARGIN, _GEN_W - w - _GEN_LOOP_MARGIN + 1)
0189:         ]
0190:         random.shuffle(positions)
0191:         for r, c in positions:
0192:             box = (r, c, r + h - 1, c + w - 1)
0193:             if not _gen_rects_clear(box, placed):
0194:                 continue
0195:             placed.append(box)
0196:             if search(i + 1):
0197:                 return True
0198:             placed.pop()
0199:         return False
0200: 
0201:     if search(0):
0202:         return placed.copy()
0203:     return None
0204: 
0205: 
0206: def _gen_draw_loop(g: np.ndarray, box: tuple[int, int, int, int]) -> None:
0207:     r0, c0, r1, c1 = box
0208:     g[r0, c0 : c1 + 1] = _GEN_BLUE
0209:     g[r1, c0 : c1 + 1] = _GEN_BLUE
0210:     g[r0 : r1 + 1, c0] = _GEN_BLUE
0211:     g[r0 : r1 + 1, c1] = _GEN_BLUE
0212: 
0213: 
0214: def _gen_tail_candidates(
0215:     g: np.ndarray, box: tuple[int, int, int, int], length: int
0216: ) -> list[list[tuple[int, int]]]:
0217:     r0, c0, r1, c1 = box
0218:     anchors: list[tuple[int, int, int, int]] = []
0219:     for c in range(c0 + 1, c1):
0220:         anchors.append((r0, c, -1, 0))
0221:         anchors.append((r1, c, 1, 0))
0222:     for r in range(r0 + 1, r1):
0223:         anchors.append((r, c0, 0, -1))
0224:         anchors.append((r, c1, 0, 1))
0225:     random.shuffle(anchors)
0226: 
0227:     out: list[list[tuple[int, int]]] = []
0228:     for ar, ac, dr, dc in anchors:
0229:         path = [(ar + dr * k, ac + dc * k) for k in range(1, length + 1)]
0230:         if any(not in_bounds(g.shape, r, c) or g[r, c] != _GEN_BLACK for r, c in path):
0231:             continue
0232:         path_set = set(path)
0233:         ok = True
0234:         for idx, (r, c) in enumerate(path):
0235:             allowed = {(ar, ac)}
0236:             if idx > 0:
0237:                 allowed.add(path[idx - 1])
0238:             if idx + 1 < len(path):
0239:                 allowed.add(path[idx + 1])
0240:             for nr, nc in neighbors4(r, c):
0241:                 if (
0242:                     in_bounds(g.shape, nr, nc)
0243:                     and g[nr, nc] == _GEN_BLUE
0244:                     and (nr, nc) not in allowed
0245:                 ):
0246:                     ok = False
0247:                     break
0248:                 if (nr, nc) in path_set and (nr, nc) not in allowed:
0249:                     ok = False
0250:                     break
0251:             if not ok:
0252:                 break
0253:         if ok:
0254:             out.append(path)
0255:     return out
0256: 
0257: 
0258: def _gen_add_tail_lengths(
0259:     g: np.ndarray, boxes: list[tuple[int, int, int, int]], tail_lengths: tuple[int, ...]
0260: ) -> bool:
0261:     if not tail_lengths:
0262:         return True
0263:     configs = []
0264:     for box_order in permutations(range(len(boxes)), len(tail_lengths)):
0265:         for length_order in set(permutations(tail_lengths)):
0266:             configs.append((box_order, length_order))
0267:     random.shuffle(configs)
0268: 
0269:     for box_order, length_order in configs:
0270:         temp = g.copy()
0271:         ok = True
0272:         for box_idx, length in zip(box_order, length_order):
0273:             paths = _gen_tail_candidates(temp, boxes[box_idx], length)
0274:             if not paths:
0275:                 ok = False
0276:                 break
0277:             for r, c in random.choice(paths):
0278:                 temp[r, c] = _GEN_BLUE
0279:         if ok:
0280:             g[:, :] = temp
0281:             return True
0282:     return False
0283: 
0284: 
0285: def _gen_integer_parts(total: int, count: int, minimum: int) -> list[tuple[int, ...]]:
0286:     if count == 0:
0287:         return [()] if total == 0 else []
0288:     out = []
0289:     max_first = total - minimum * (count - 1)
0290:     for first in range(minimum, max_first + 1):
0291:         for rest in _gen_integer_parts(total - first, count - 1, minimum):
0292:             out.append((first,) + rest)
0293:     return out
0294: 
0295: 
0296: def _gen_appendage_plans(
0297:     loop_count: int, append_total: int, target_blue: int
0298: ) -> list[tuple[tuple[int, ...], tuple[int, ...]]]:
0299:     plans = []
0300:     max_open = _GEN_MAX_BLUE_COMPONENTS - loop_count
0301:     for tail_count in range(0, min(_GEN_MAX_TAILS, loop_count, append_total) + 1):
0302:         min_tail_total = tail_count * _GEN_MIN_TAIL_LENGTH
0303:         for tail_total in range(min_tail_total, append_total + 1):
0304:             for tail_lengths in _gen_integer_parts(
0305:                 tail_total, tail_count, _GEN_MIN_TAIL_LENGTH
0306:             ):
0307:                 remaining = append_total - sum(tail_lengths)
0308:                 for open_count in range(
0309:                     0, min(max_open, remaining // _GEN_MIN_OPEN_PATH_LENGTH) + 1
0310:                 ):
0311:                     for open_lengths in _gen_integer_parts(
0312:                         remaining, open_count, _GEN_MIN_OPEN_PATH_LENGTH
0313:                     ):
0314:                         endpoints = tail_count + 2 * open_count
0315:                         branches = tail_count
0316:                         degree2 = (target_blue - endpoints - branches) / target_blue
0317:                         if (
0318:                             _GEN_MIN_ENDPOINTS <= endpoints <= _GEN_MAX_ENDPOINTS
0319:                             and branches <= _GEN_MAX_BRANCHES
0320:                             and _GEN_DEGREE2_MIN <= degree2 <= _GEN_DEGREE2_MAX
0321:                         ):
0322:                             plans.append((tail_lengths, open_lengths))
0323:     return plans
0324: 
0325: 
0326: def _gen_open_path_candidates(g: np.ndarray, length: int) -> list[list[tuple[int, int]]]:
0327:     black_labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
0328:     if n_labels == 0:
0329:         return []
0330:     exterior = max(
0331:         range(1, n_labels + 1), key=lambda label_id: int(np.sum(black_labels == label_id))
0332:     )
0333:     eligible = black_labels == exterior
0334: 
0335:     def cell_ok(r: int, c: int) -> bool:
0336:         if not (
0337:             _GEN_LOOP_MARGIN <= r < _GEN_H - _GEN_LOOP_MARGIN
0338:             and _GEN_LOOP_MARGIN <= c < _GEN_W - _GEN_LOOP_MARGIN
0339:         ):
0340:             return False
0341:         if not eligible[r, c] or g[r, c] != _GEN_BLACK:
0342:             return False
0343:         return all(
0344:             not (in_bounds(g.shape, nr, nc) and g[nr, nc] == _GEN_BLUE)
0345:             for nr, nc in neighbors4(r, c)
0346:         )
0347: 
0348:     starts = [(int(r), int(c)) for r, c in np.argwhere(eligible)]
0349:     random.shuffle(starts)
0350:     out: list[list[tuple[int, int]]] = []
0351: 
0352:     def extend(path: list[tuple[int, int]]) -> None:
0353:         if len(out) >= _GEN_MAX_PATH_CANDIDATES:
0354:             return
0355:         if len(path) == length:
0356:             out.append(path.copy())
0357:             return
0358:         last_r, last_c = path[-1]
0359:         next_cells = list(neighbors4(last_r, last_c))
0360:         random.shuffle(next_cells)
0361:         used = set(path)
0362:         for nr, nc in next_cells:
0363:             if not in_bounds(g.shape, nr, nc) or not cell_ok(nr, nc) or (nr, nc) in used:
0364:                 continue
0365:             if any(
0366:                 (ar, ac) in used and (ar, ac) != path[-1]
0367:                 for ar, ac in neighbors4(nr, nc)
0368:             ):
0369:                 continue
0370:             path.append((nr, nc))
0371:             extend(path)
0372:             path.pop()
0373: 
0374:     for start in starts:
0375:         if len(out) >= _GEN_MAX_PATH_CANDIDATES:
0376:             break
0377:         if cell_ok(*start):
0378:             extend([start])
0379:     return out
0380: 
0381: 
0382: def _gen_add_open_paths(g: np.ndarray, lengths: tuple[int, ...]) -> bool:
0383:     lengths = tuple(sorted(lengths, reverse=True))
0384:     for length in lengths:
0385:         paths = _gen_open_path_candidates(g, length)
0386:         if not paths:
0387:             return False
0388:         for r, c in random.choice(paths):
0389:             g[r, c] = _GEN_BLUE
0390:     return True
0391: 
0392: 
0393: def _gen_add_appendages(
0394:     g: np.ndarray,
0395:     boxes: list[tuple[int, int, int, int]],
0396:     append_total: int,
0397:     target_blue: int,
0398: ) -> bool:
0399:     plans = _gen_appendage_plans(len(boxes), append_total, target_blue)
0400:     by_endpoint: dict[int, list[tuple[tuple[int, ...], tuple[int, ...]]]] = {}
0401:     for plan in plans:
0402:         endpoint_count = len(plan[0]) + 2 * len(plan[1])
0403:         by_endpoint.setdefault(endpoint_count, []).append(plan)
0404: 
0405:     endpoint_order = sorted(by_endpoint)
0406:     if endpoint_order:
0407:         first = random.choices(endpoint_order, weights=[ep * ep for ep in endpoint_order], k=1)[0]
0408:         endpoint_order.remove(first)
0409:         random.shuffle(endpoint_order)
0410:         endpoint_order.insert(0, first)
0411: 
0412:     for endpoint_count in endpoint_order:
0413:         endpoint_plans = by_endpoint[endpoint_count]
0414:         random.shuffle(endpoint_plans)
0415:         for tail_lengths, open_lengths in endpoint_plans:
0416:             temp = g.copy()
0417:             if not _gen_add_tail_lengths(temp, boxes, tail_lengths):
0418:                 continue
0419:             if not _gen_add_open_paths(temp, open_lengths):
0420:                 continue
0421:             g[:, :] = temp
0422:             return True
0423:     return False
0424: 
