0168:                 _typ, edge_r, cols = seg
0169:                 if len(cols) != int(target) or not _is_contig(cols):
0170:                     continue
0171:                 dr = int(fixed - edge_r)
0172:                 dc = int(span[0] - cols[0])
0173: 
0174:             placed = {(int(rr + dr), int(cc2 + dc)) for rr, cc2 in np.argwhere(msk)}
0175:             if any(not (0 <= R < H and 0 <= C < W) for R, C in placed):
0176:                 continue
0177: 
0178:             # ensure no conflicts with already-drawn hub (or previously placed sprites)
0179:             ok = True
0180:             for R, C in placed:
0181:                 val = int(a[int(R - dr), int(C - dc)])
0182:                 if val == int(bg):
0183:                     continue
0184:                 if int(out[int(R), int(C)]) != int(bg) and int(out[int(R), int(C)]) != val:
0185:                     ok = False
0186:                     break
0187:             if not ok:
0188:                 continue
0189: 
0190:             found = (a, msk, int(dr), int(dc))
0191:             break
0192: 
0193:         if found is None:
0194:             continue
0195: 
0196:         a, msk, dr, dc = found
0197:         paste(out, a, int(dr), int(dc), mask=msk, overwrite=True, clip=True)
0198: 
0199:     return out
