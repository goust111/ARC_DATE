0181: def _gen_cycle_metrics(mask):
0182:     path = _gen_trace_cycle(mask)
0183:     if path is None:
0184:         return None
0185:     counts = {1: 0, -1: 0}
0186:     n = len(path)
0187:     for i, (r, c) in enumerate(path):
0188:         pr, pc = path[i - 1]
0189:         nr, nc = path[(i + 1) % n]
0190:         incoming = (r - pr, c - pc)
0191:         outgoing = (nr - r, nc - c)
0192:         cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
0193:         if cross:
0194:             counts[1 if cross > 0 else -1] += 1
0195:     convex = max(counts.values())
0196:     concave = min(counts.values())
0197:     return len(path), convex, concave
