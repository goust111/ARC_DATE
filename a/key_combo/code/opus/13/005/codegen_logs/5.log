0071: def main(grid: np.ndarray) -> np.ndarray:
0072:     """
0073:     Move the left-edge fragment into its same-colored anchor fragment to complete a solid rectangle.
0074: 
0075:     Input structure
0076:     - The grid has a dominant background color.
0077:     - Exactly one foreground color is split into two 4-connected objects: one
0078:       touches the left edge, and the other is an anchor away from the left edge.
0079:     - The translated left-edge object and the anchor can form one filled rectangle.
0080:     Rule
0081:     - Find the unique split color whose left-edge object can be translated onto
0082:       background cells beside the other same-colored object so their union is a
0083:       solid axis-aligned rectangle.
0084:     - Clear the left-edge object's original cells to the background.
0085:     - Paint that object at the unique completing offset, preserving all other cells.
0086:     Key insight
0087:     - The active color is identified by object structure and rectangle completion,
0088:       not by a fixed color id; the same-colored anchor object stays in place.
0089:     """
0090:     g = np.asarray(grid, dtype=int)
0091:     assert g.ndim == 2
0092: 
0093:     bg = get_bg(g)
0094:     color, source, dr, dc = _completion_candidate(g, bg)
0095: 
0096:     out = g.copy()
0097:     for r, c in source:
0098:         out[r, c] = int(bg)
0099:     for r, c in source:
0100:         rr, cc = r + dr, c + dc
0101:         assert int(out[rr, cc]) == int(bg), "translated source must land on background cells"
0102:         out[rr, cc] = int(color)
0103: 
0104:     return out
0105: 
