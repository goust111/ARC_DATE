0187: def _gen_split_patches(rect_h: int, rect_w: int, min_dst_width: int,
0188:                        split_color: int, bg: int) -> tuple[np.ndarray, np.ndarray, list[int]]:
0189:     dst_widths = _gen_symmetric_widths(rect_h, rect_w - 1, min_width=min_dst_width, varied=True)
0190:     dst = np.full((rect_h, rect_w), bg, dtype=int)
