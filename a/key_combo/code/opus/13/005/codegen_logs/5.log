0198: def _gen_attempt() -> np.ndarray | None:
0199:     n = random.randint(*GRID_SIZE_RANGE)
0200:     layout = _gen_pick_layout(n)
0201:     if layout is None:
0202:         return None
0203:     rect_h, rect_w, rect_top, nonsplit_h, nonsplit_top = layout
0204: 
0205:     colors = list(PALETTE_COLORS)
0206:     bg = random.choice(colors)
0207:     colors.remove(bg)
0208:     split_color, nonsplit_color = random.sample(colors, 2)
0209:     min_dst_width = max(MIN_ROW_WIDTH, 2 * rect_w - n + SOURCE_RIGHT_PAD)
0210:     if min_dst_width > rect_w - DST_WIDTH_RESERVED_COLS:
