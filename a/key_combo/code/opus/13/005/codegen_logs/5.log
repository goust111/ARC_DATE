+            candidates.append(
+                {
+                    "kind": "h",
+                    "r0": int(r0),
+                    "r1": int(r1),
+                    "c0": int(c0),
+                    "c1": int(c1),
+                    "left": left["bbox"],
+                    "right": right["bbox"],
+                }
+            )
+
+    if ar1 < br0 or br1 < ar0:
+        if ar1 < br0:
+            upper, lower = a, b
+        else:
+            upper, lower = b, a
+        ur0, uc0, ur1, uc1 = upper["bbox"]
+        lr0, lc0, lr1, lc1 = lower["bbox"]
+        c0 = max(uc0 + 1, lc0 + 1)
+        c1 = min(uc1 - 1, lc1 - 1)
+        r0 = ur1 + 1
+        r1 = lr0 - 1
+        if c0 <= c1 and r0 <= r1 and bool((grid[r0 : r1 + 1, c0 : c1 + 1] == int(bg)).all()):
+            candidates.append(
