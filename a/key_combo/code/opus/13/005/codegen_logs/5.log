+        lab, n = label_mask(grid == int(color), connectivity=4)
+        for k in range(1, n + 1):
+            coords = np.argwhere(lab == k)
+            if coords.size == 0:
+                continue
+            r0, c0, r1, c1 = bbox_coords(coords)
+            h = int(r1 - r0 + 1)
+            w = int(c1 - c0 + 1)
