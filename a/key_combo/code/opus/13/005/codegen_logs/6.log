   9: def main(grid: np.ndarray) -> np.ndarray:
  10:     """Build a four-quadrant rotational tiling of the input square.
  11: 
  12:     Input structure
  13:     - The input is a square grid treated as one complete sprite.
  14: 
  15:     Rule
  16:     - Each output quadrant is a 2x2 repetition of a rotated copy of the whole input.
  17:     - The quadrant rotations are upper-left 180 degrees, upper-right 90 degrees
  18:       clockwise, lower-left 90 degrees counterclockwise, and lower-right unchanged.
  19: 
  20:     Key insight
  21:     - The output is a 4x4 grid of original-size blocks, not a per-pixel scale-up.
  22:     """
  23:     g = np.asarray(grid, dtype=int)
  24:     assert g.ndim == 2
  25:     h, w = g.shape
  26:     assert h == w and h > 0
  27: 
  28:     upper_left = _repeat_2x2(np.rot90(g, 2))
  29:     upper_right = _repeat_2x2(np.rot90(g, -1))
  30:     lower_left = _repeat_2x2(np.rot90(g, 1))
  31:     lower_right = _repeat_2x2(g)
  32: 
  33:     return np.block([[upper_left, upper_right], [lower_left, lower_right]])
