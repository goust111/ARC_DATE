   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """Move the diagonal foreground segment to the next longer run along the same up-right diagonal.
   9: 
  10:     Input structure
  11:     The grid has one background color and one foreground color. The foreground pixels form a
  12:     contiguous one-pixel-wide segment on a single anti-diagonal.
  13: 
  14:     Rule
  15:     Erase the current segment. If its columns are c0..c1 and its length is L, draw the same
  16:     color on columns c1+1..c1+L+1 along the same anti-diagonal.
  17: 
  18:     Key insight
  19:     The segment advances past its current upper-right end by one whole segment position, and
  20:     the next segment is one pixel longer than the current one.
  21:     """
  22:     g = np.asarray(grid, dtype=int)
  23:     bg = get_bg(g)
  24:     fg_colors = colors_present(g, exclude={bg})
  25:     assert len(fg_colors) == 1
  26:     fg = fg_colors[0]
  27: 
  28:     coords = np.argwhere(g == fg)
  29:     assert coords.size > 0
  30:     diag_sums = {int(r + c) for r, c in coords}
  31:     assert len(diag_sums) == 1
  32:     diag_sum = next(iter(diag_sums))
  33: 
  34:     cols = sorted(int(c) for _r, c in coords)
  35:     assert cols == list(range(cols[0], cols[-1] + 1))
  36:     length = len(cols)
  37:     out_cols = range(cols[-1] + 1, cols[-1] + length + 2)
  38: 
  39:     out = np.full_like(g, bg)
  40:     for c in out_cols:
  41:         r = diag_sum - c
  42:         assert in_bounds(g.shape, r, c)
  43:         out[r, c] = fg
  44:     return out
