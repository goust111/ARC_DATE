+        rots.append(rot)
+    return True
+
+
+def _random_connected_template(rng: random.Random) -> np.ndarray:
+    for _ in range(400):
+        canvas_h = rng.randint(2, 4)
+        canvas_w = rng.randint(3, 5)
+        max_area = min(8, canvas_h * canvas_w - 1)
+        if max_area < 4:
