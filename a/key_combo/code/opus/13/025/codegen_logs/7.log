+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 8
+BLOCK = 3
+MOTIF = 9
+RING_SLOTS = [(0, 0), (0, 1), (0, 2), (1, 2), (2, 2), (2, 1), (2, 0), (1, 0)]
+CENTER_SOURCE_COORDS = [(2, 2), (2, 4), (2, 6), (4, 6), (6, 6), (6, 4), (6, 2), (4, 2)]
+CENTER_TARGET_COORDS = [(0, 0), (0, 1), (0, 2), (1, 2), (2, 2), (2, 1), (2, 0), (1, 0)]
+MAIN_COLORS = [1, 2, 3, 4, 5, 6, 7, 9]
+
+GRID_H_RANGE = (12, 20)
+GRID_W_RANGE = (17, 24)
+MARKER_GAP_RANGE = (1, 3)
+MARKER_SPAN = 15
+OWN_COUNT_PATTERNS = {
+    5: [
+        [8, 7, 6, 5, 3, 2, 1, 0],
+        [8, 6, 6, 5, 4, 2, 1, 0],
+        [7, 6, 5, 5, 4, 3, 1, 1],
+    ],
+    6: [
+        [5, 4, 4, 3, 3, 2, 2, 1],
+        [6, 4, 4, 3, 3, 2, 1, 1],
+    ],
+}
+GEN_ATTEMPTS = 600
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bool(mask[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
