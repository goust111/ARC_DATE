  50: def main(grid: np.ndarray) -> np.ndarray:
  51:     """
  52:     Extend each solid 3x3 color block into a full-width and full-height cross, clearing crossings between different blocks.
  53: 
  54:     Input structure:
  55:     - The background is the dominant color.
  56:     - The cross generators are exact 4-connected same-color components shaped as solid 3x3 blocks.
  57:     - These 3x3 block centers have distinct rows and distinct columns, separated enough that their cross intersections are outside every source block.
  58: 
  59:     Rule:
  60:     - Copy the input grid.
  61:     - For every solid 3x3 block, fill its center row and center column with the block color.
  62:     - Where the center row of one block crosses the center column of another block, reset that pixel to background.
  63: 
  64:     Key insight:
  65:     - The 3x3 blocks are cross generators; other foreground pixels are noise that is overwritten only if a generated cross passes through them.
  66:     """
  67:     g = np.asarray(grid, dtype=int)
  68:     assert g.ndim == 2, "expected a 2D grid"
  69: 
  70:     bg = get_bg(g)
  71:     blocks = _solid_3x3_blocks(g, bg)
  72:     assert blocks, "expected at least one solid 3x3 foreground block"
  73: 
  74:     rows = [row for row, _, _, _ in blocks]
  75:     cols = [col for _, col, _, _ in blocks]
  76:     assert len(set(rows)) == len(rows), "expected 3x3 block centers to have unique rows"
  77:     assert len(set(cols)) == len(cols), "expected 3x3 block centers to have unique columns"
  78:     for i, (row_i, col_i, _, _) in enumerate(blocks):
  79:         for row_j, col_j, _, _ in blocks[i + 1 :]:
  80:             assert abs(row_i - row_j) > 2, "expected source blocks to occupy separate row bands"
  81:             assert abs(col_i - col_j) > 2, "expected source blocks to occupy separate column bands"
  82: 
  83:     out = g.copy()
  84:     for row, col, color, _ in blocks:
  85:         out[row, :] = color
  86:         out[:, col] = color
  87: 
  88:     for i, (row, _, _, _) in enumerate(blocks):
  89:         for j, (_, col, _, _) in enumerate(blocks):
  90:             if i != j:
  91:                 out[row, col] = bg
  92: 
  93:     return out
