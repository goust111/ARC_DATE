+
+LOOP_TEMPLATES = _template_arrays()
+
+
+def _random_loop_template() -> tuple[np.ndarray, np.ndarray, bool]:
+    wall = random.choice(LOOP_TEMPLATES).copy()
+    wall = np.rot90(wall, random.randrange(4))
