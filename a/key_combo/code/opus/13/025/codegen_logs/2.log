+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds((h, w), nr, nc) and not wall_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
