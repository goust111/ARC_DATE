+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds(grid.shape, nr, nc) and not mask[nr, nc] and grid[nr, nc] != WALL:
+                mask[nr, nc] = True
+                q.append((nr, nc))
+    return mask
