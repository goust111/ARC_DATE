+    except AssertionError:
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _build_example()
+        if grid is not None:
