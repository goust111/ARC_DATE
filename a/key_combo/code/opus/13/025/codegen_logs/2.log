+        ["#####", "#...#", "#...#", "#####"],
+        ["#####", "#...#", "#...#", "#...#", "#####"],
+        ["#####", "#...#", "###.#", "#...#", "#####"],
+        ["######", "#....#", "###..#", "#....#", "######"],
