+
+
+def _side_toward(src: tuple[float, float], dst: tuple[float, float]) -> str:
+    dr = dst[0] - src[0]
+    dc = dst[1] - src[1]
+    if abs(dc) >= abs(dr):
+        return "E" if dc > 0 else "W"
+    return "S" if dr > 0 else "N"
