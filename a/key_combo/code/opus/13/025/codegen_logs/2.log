+                for r, c in path:
+                    grid[r, c] = WALL
+                used_ports[loop_id].add(src_port)
+                used_ports[next_id].add(dst_port)
+                placed = True
+                break
+            if placed:
+                break
+        if not placed:
+            return False
+    return True
