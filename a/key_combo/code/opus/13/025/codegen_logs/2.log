+    out = g.copy()
+    for idx, region_id in enumerate(order):
+        next_region_id = order[(idx + 1) % len(order)]
+        out[regions[region_id]["mask"]] = regions[next_region_id]["color"]
+    out[g == WALL] = WALL
+    return out
