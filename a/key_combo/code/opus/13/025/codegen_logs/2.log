+        a, b = sorted(touched)
+        edges.add((a, b))
+
+    assert len(edges) == len(regions), "connectors must form one Hamiltonian cycle"
+    degrees = [0] * len(regions)
+    for a, b in edges:
+        degrees[a] += 1
+        degrees[b] += 1
+    assert all(deg == 2 for deg in degrees), f"expected degree-2 cycle, got {degrees}"
