+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+INDICATOR_COLORS = (1, 2, 3, 4, 7)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GEN_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _flood_non_wall(grid: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    h, w = grid.shape
+    mask = np.zeros((h, w), dtype=bool)
+    sr, sc = start
+    q = deque([(sr, sc)])
+    mask[sr, sc] = True
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds(grid.shape, nr, nc) and not mask[nr, nc] and grid[nr, nc] != WALL:
+                mask[nr, nc] = True
+                q.append((nr, nc))
+    return mask
+
+
+def _enclosed_mask_from_wall(wall_mask: np.ndarray) -> np.ndarray:
+    h, w = wall_mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not wall_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not wall_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds((h, w), nr, nc) and not wall_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return (~wall_mask) & (~outside)
+
+
+def _centroid(coords: np.ndarray) -> tuple[float, float]:
+    return float(coords[:, 0].mean()), float(coords[:, 1].mean())
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    indicators = np.argwhere((grid != BG) & (grid != WALL))
+    assert 4 <= len(indicators) <= 5, "expected 4 or 5 indicator pixels"
