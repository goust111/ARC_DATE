+        regions.append(
+            {
+                "mask": region,
+                "coords": region_coords,
+                "boundary": boundary,
+                "boundary_coords": boundary_coords,
+                "color": int(grid[int(r), int(c)]),
+                "center": _centroid(region_coords),
