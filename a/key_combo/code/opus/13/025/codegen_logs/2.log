    out = np.full_like(g, bg)
    marker_mask = np.zeros(g.shape, dtype=bool)
    outlines: list[dict] = []

    for comp in components:
        coords = comp["coords"]
        if comp["area"] == 1:
            marker_mask[coords[0, 0], coords[0, 1]] = True
        else:
            outlines.append(comp)
            out[coords[:, 0], coords[:, 1]] = int(comp["color"])

