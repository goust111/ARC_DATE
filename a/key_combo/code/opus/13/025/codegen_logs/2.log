+def _angles_clockwise(centers: list[tuple[float, float]]) -> list[int]:
+    pts = np.array(centers, dtype=float)
+    ctr = pts.mean(axis=0)
+    angles = [math.atan2(r - ctr[0], c - ctr[1]) for r, c in pts]
+    return sorted(range(len(centers)), key=lambda i: angles[i])
