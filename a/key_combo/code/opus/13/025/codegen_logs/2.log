+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+INDICATOR_COLORS = (1, 2, 3, 4, 7)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GEN_ATTEMPTS = 400
