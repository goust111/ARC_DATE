+    q = deque([(sr, sc)])
+    mask[sr, sc] = True
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds(grid.shape, nr, nc) and not mask[nr, nc] and grid[nr, nc] != WALL:
+                mask[nr, nc] = True
+                q.append((nr, nc))
+    return mask
+
+
+def _enclosed_mask_from_wall(wall_mask: np.ndarray) -> np.ndarray:
+    h, w = wall_mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for r in range(h):
+        for c in (0, w - 1):
+            if not wall_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not wall_mask[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if _in_bounds((h, w), nr, nc) and not wall_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return (~wall_mask) & (~outside)
