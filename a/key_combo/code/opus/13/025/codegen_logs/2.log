+    edge_set = {tuple(sorted(edge)) for edge in edges}
+    cyclic_pairs = {
+        tuple(sorted((order[i], order[(i + 1) % len(order)])))
+        for i in range(len(order))
+    }
+    assert cyclic_pairs == edge_set, "geometric clockwise order must match connector cycle"
+    return order
