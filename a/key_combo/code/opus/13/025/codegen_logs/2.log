+        for r, c in comp:
+            for dr, dc in DIR4:
+                nr, nc = int(r) + dr, int(c) + dc
+                if _in_bounds(grid.shape, nr, nc) and boundary_owner[nr, nc] >= 0:
+                    touched.add(int(boundary_owner[nr, nc]))
