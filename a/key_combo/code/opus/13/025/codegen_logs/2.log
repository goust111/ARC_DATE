            if int(g[int(r), int(c)]) == int(skeleton)
        }
        target_anchor = {
            (int(r), int(c))
            for r, c in comp["coords"]
            if int(g[int(r), int(c)]) == int(anchor)
        }
        assert len(target_anchor) == 1, "target motif must have one anchor pixel"

