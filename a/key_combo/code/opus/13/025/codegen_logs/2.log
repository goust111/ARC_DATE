+
+def _bbox_with_margin(cells: np.ndarray, margin: int = 0) -> tuple[int, int, int, int]:
+    r0 = int(cells[:, 0].min()) - margin
+    c0 = int(cells[:, 1].min()) - margin
+    r1 = int(cells[:, 0].max()) + margin
+    c1 = int(cells[:, 1].max()) + margin
