+        dst_ports = _candidate_ports(dst, dst_side)
+        src_ports.sort(key=lambda rc: abs(rc[0] - dst["center"][0]) + abs(rc[1] - dst["center"][1]))
+        dst_ports.sort(key=lambda rc: abs(rc[0] - src["center"][0]) + abs(rc[1] - src["center"][1]))
