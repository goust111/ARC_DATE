+        anchors = [(0.17, 0.50), (0.31, 0.81), (0.74, 0.72), (0.76, 0.28), (0.31, 0.19)]
+    centers = []
+    for rf, cf in anchors:
+        jr = random.randint(-1, 1)
+        jc = random.randint(-1, 1)
