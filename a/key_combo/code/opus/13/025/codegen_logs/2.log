+
+def _centroid(coords: np.ndarray) -> tuple[float, float]:
+    return float(coords[:, 0].mean()), float(coords[:, 1].mean())
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    indicators = np.argwhere((grid != BG) & (grid != WALL))
