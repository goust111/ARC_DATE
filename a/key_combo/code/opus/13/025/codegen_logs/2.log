+def _template_arrays() -> list[np.ndarray]:
+    rows = [
+        ["####", "#..#", "#..#", "####"],
+        ["#####", "#...#", "#...#", "#####"],
+        ["#####", "#...#", "#...#", "#...#", "#####"],
