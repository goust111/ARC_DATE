+        anchors = [(0.22, 0.24), (0.22, 0.76), (0.78, 0.76), (0.78, 0.24)]
+    else:
+        anchors = [(0.21, 0.30), (0.23, 0.74), (0.52, 0.81), (0.79, 0.50), (0.51, 0.19)]
