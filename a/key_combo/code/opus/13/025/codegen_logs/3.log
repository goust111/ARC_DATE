spec:
  grid: 13x14 (fixed) [observed]
  colors: exactly 2 — one foreground color (any non-black) + black
  lattice:
    anchor_cols: every 3rd col starting at 0 (cols 0,3,6,9,12) — all fg
    separator_cols: every 3rd col starting at 2 (cols 2,5,8,11) — all black
    active_cols: every 3rd col starting at 1 (cols 1,4,7,10,13) — editable
    even_rows: rows 0,2,4,...,12 — all fg at active_cols (horizontal bars)
    active_rows: rows 1,3,5,...,11 — editable (6 rows)
  editable_matrix:
    size: 6 rows x 5 cols (binary: each cell is fg or black)
    column_counts: 5 distinct values (one per column), all unique
    count_range: each count in 0-6; observed sets are 5 consecutive integers [observed]
    not_already_sorted: input column counts are NOT in ascending order
  rule: sort editable columns by ascending foreground-pixel count (stable permutation)

generation_strategy:
  approach: output-first
  steps:
    1. Pick fg color from non-black palette
    2. Choose 5 distinct column counts (pick 5 distinct values from 0-6, preferring consecutive runs)
    3. Sort them ascending — these are the OUTPUT column counts left-to-right
    4. For each output column, generate a random binary vector of length 6 with exactly that many 1s
    5. Shuffle the 5 columns into a non-sorted order — this is the INPUT editable matrix
    6. Embed into the 13x14 lattice: anchor cols all fg, separator cols all black, even rows at active cols all fg, active rows at active cols from the editable matrix
