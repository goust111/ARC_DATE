+            elif v != parent:
+                low[u] = min(low[u], disc[v])
+
+    for node in range(n):
+        if disc[node] == -1:
+            dfs(node, -1)
+    return bridges
+
+
+def non_bridge_components(mask: np.ndarray) -> tuple[list[tuple[int, int]], list[np.ndarray], dict[tuple[int, int], int]]:
