+        need_branch_hole = random.random() < 0.55 and any(name in HOLE_NAMES for name in remaining)
+        if need_branch_hole:
+            branch_hole = random.choice([name for name in remaining if name in HOLE_NAMES])
+            extra_names.append(branch_hole)
