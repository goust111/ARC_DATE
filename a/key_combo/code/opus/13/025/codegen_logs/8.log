+        "tr": SHAPE_BY_NAME[names[1]],
+        "br": SHAPE_BY_NAME[names[2]],
+        "bl": SHAPE_BY_NAME[names[3]],
+        **({f"b{i}": SHAPE_BY_NAME[names[4 + i]] for i in range(n_objects - 4)}),
+    }
