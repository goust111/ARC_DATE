+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+]
+
+MIN_OBJECT_AREA = 5
+GEN_RETRIES = 400
