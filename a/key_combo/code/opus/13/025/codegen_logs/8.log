+    remaining = [name for name in SHAPE_BY_NAME if name not in cycle_names]
+    cycle_names.extend(random.sample(remaining, 3))
+    random.shuffle(cycle_names)
+
+    extra_names: list[str] = []
+    if n_objects > 4:
+        remaining = [name for name in SHAPE_BY_NAME if name not in cycle_names]
