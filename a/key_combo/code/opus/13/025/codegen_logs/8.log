+def bridge_edges(adj: list[list[int]]) -> set[tuple[int, int]]:
+    n = len(adj)
+    disc = [-1] * n
+    low = [0] * n
+    time = 0
+    bridges: set[tuple[int, int]] = set()
+
+    def dfs(u: int, parent: int) -> None:
+        nonlocal time
+        disc[u] = low[u] = time
+        time += 1
+        for v in adj[u]:
