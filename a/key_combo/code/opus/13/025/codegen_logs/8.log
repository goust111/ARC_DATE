+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        n_objects = random.choice([5, 6])
+        positions, branch_edges, shapes = sample_branch_plan(n_objects)
+        grid = render_scene(shapes, positions, branch_edges)
