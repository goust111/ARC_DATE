+        if np.any(
+            (coords[:, 0] == 0)
+            | (coords[:, 1] == 0)
+            | (coords[:, 0] == h - 1)
+            | (coords[:, 1] == w - 1)
+        ):
+            edge_ids.add(comp_id)
+    return edge_ids
