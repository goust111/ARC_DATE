  transform:
    blue_pixels: unchanged
    red: for each rim object, paint edge-connected black cells that are 8-adjacent to the rim; also cap 1-cell top-left diagonal closures
    green: for each rim object, paint hole cells that are 8-adjacent to the rim
    distractors: unchanged (no red/green added)
generation_strategy:
