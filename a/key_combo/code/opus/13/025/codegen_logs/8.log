+
+    grid = np.zeros((h, w), dtype=int)
+    for node, pos in positions.items():
+        shape = shapes[node]["mask"]
+        r0, c0 = pos
+        r1, c1 = r0 + shape.shape[0], c0 + shape.shape[1]
