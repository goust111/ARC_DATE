+    if direction == "left":
+        child_anchor = (parent_anchor[0], parent_anchor[1] - span)
+    elif direction == "right":
+        child_anchor = (parent_anchor[0], parent_anchor[1] + span)
+    elif direction == "up":
+        child_anchor = (parent_anchor[0] - span, parent_anchor[1])
+    else:
+        child_anchor = (parent_anchor[0] + span, parent_anchor[1])
