+
+        if obj_id not in info["cycle_nodes"]:
+            continue
+        for hole in info["holes_by_object"][obj_id]:
+            for r, c in hole:
+                rr = int(r)
+                cc = int(c)
+                if touches_mask8(obj_mask, rr, cc):
+                    out[rr, cc] = GREEN
