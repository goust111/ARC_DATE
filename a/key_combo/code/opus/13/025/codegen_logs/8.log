+        non_cycle = set(range(len(info["object_masks"]))) - set(info["cycle_nodes"])
+        if not non_cycle:
+            continue
+        if np.array_equal(out, grid):
+            continue
+        return grid
+    raise RuntimeError("generate_input: exhausted attempts")

