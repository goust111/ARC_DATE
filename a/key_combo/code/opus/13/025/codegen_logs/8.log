+
+
+def cycle_positions(shapes: dict[str, dict]) -> dict[str, tuple[int, int]]:
+    tl, tr, br, bl = shapes["tl"], shapes["tr"], shapes["br"], shapes["bl"]
+    min_col_gap = max(
+        tr["anchors"]["top"][1] - tl["anchors"]["top"][1] + tl["mask"].shape[1] + 2,
