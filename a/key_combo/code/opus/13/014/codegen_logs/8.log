+def _render_output(shape: tuple[int, int], rects_front_to_back: list[tuple[int, int, int, int]]) -> np.ndarray:
+    out = np.full(shape, BACKGROUND, dtype=int)
+    for depth_idx in range(len(rects_front_to_back) - 1, -1, -1):
