+def _rect_bits(
+    rect: tuple[int, int, int, int],
+    bit_index: dict[tuple[int, int], int],
+) -> int:
+    bits = 0
+    for coord in _rect_border_coords(rect):
+        bits |= 1 << bit_index[coord]
+    return bits
