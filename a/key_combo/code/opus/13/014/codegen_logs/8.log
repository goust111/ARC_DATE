+        placed = False
+        choices = [
+            ("top", "left"),
+            ("top", "right"),
+            ("bottom", "left"),
+            ("bottom", "right"),
+            ("left", "top"),
+            ("left", "bottom"),
+            ("right", "top"),
+            ("right", "bottom"),
+        ]
+        random.shuffle(choices)
+        for side, end in choices:
+            for _ in range(24):
+                height, width = _choose_dims(used_dims)
+                rect = _attached_rect(parent, side, end, height, width)
+                if any(_strict_contains(rect, old) or _strict_contains(old, rect) for old in rects):
+                    continue
+
+                rect_border = _border_set(rect)
+                ok = True
+                for old_idx, old in enumerate(rects):
+                    old_border = _border_set(old)
+                    inter = rect_border & old_border
+                    if old_idx == len(rects) - 1:
+                        if len(inter) != 2:
