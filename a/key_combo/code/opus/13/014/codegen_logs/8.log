+def _render_input(shape: tuple[int, int], rects: list[tuple[int, int, int, int]]) -> np.ndarray:
+    grid = np.full(shape, BACKGROUND, dtype=int)
+    for rect in rects:
+        _paint_rect(grid, rect, INPUT_FRAME)
+    return grid
