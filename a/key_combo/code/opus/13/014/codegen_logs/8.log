+        uncovered = all_bits & ~covered
+        bit_pos = None
+        choices = None
+        for pos in range(len(points)):
+            if not (uncovered & (1 << pos)):
+                continue
+            options = [
+                idx
+                for idx in by_pixel[pos]
+                if idx not in selected
+                and dims[idx] not in used_dims
+                and (candidate_bits[idx] & uncovered) != 0
+            ]
