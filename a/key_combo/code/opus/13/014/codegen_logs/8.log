+def _valid_solution(rects: list[tuple[int, int, int, int]], bits: list[int]) -> bool:
+    topo = _depth_order(rects)
+    if topo is None:
+        return False
+    order, edge_count = topo
+    if len(order) != len(rects) or edge_count < len(rects) - 1:
+        return False
