+    order = []
+    ready = [idx for idx, deg in enumerate(indeg) if deg == 0]
+    edge_count = sum(len(out) for out in edges)
+    while ready:
+        if len(ready) != 1:
+            return None
+        node = ready.pop()
+        order.append(node)
+        for dst in sorted(edges[node]):
+            indeg[dst] -= 1
+            if indeg[dst] == 0:
