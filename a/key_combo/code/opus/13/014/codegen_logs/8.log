+
+    candidate_bits = [_rect_bits(rect, bit_index) for rect in candidate_rects]
+    dims = [_rect_dims(rect) for rect in candidate_rects]
+    perims = [len(_rect_border_coords(rect)) for rect in candidate_rects]
