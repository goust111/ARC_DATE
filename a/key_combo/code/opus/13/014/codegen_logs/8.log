+def _visible_corner_count(rect: tuple[int, int, int, int], others: list[tuple[int, int, int, int]]) -> int:
+    count = 0
+    for corner in _rect_corners(rect):
+        if not any(_point_on_strict_edge(corner, other) for other in others):
+            count += 1
+    return count
