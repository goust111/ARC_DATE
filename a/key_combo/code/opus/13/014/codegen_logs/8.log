+def _enumerate_candidates(mask: np.ndarray) -> list[tuple[int, int, int, int]]:
+    rows = sorted(set(int(r) for r in np.flatnonzero(mask.any(axis=1))))
+    cols = sorted(set(int(c) for c in np.flatnonzero(mask.any(axis=0))))
+    candidates = []
