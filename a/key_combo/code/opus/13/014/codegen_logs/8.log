+    r, c = point
+    r0, c0, r1, c1 = rect
+    on_top_or_bottom = r in (r0, r1) and c0 < c < c1
+    on_left_or_right = c in (c0, c1) and r0 < r < r1
+    return on_top_or_bottom or on_left_or_right
