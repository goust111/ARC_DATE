+    def search(step: int) -> tuple[int, int] | None:
+        rr = r
+        dist = 0
+        while 0 <= rr + step < h:
+            rr += step
+            dist += 1
+            if blocked[rr, c]:
+                return None
+            if not blocked[rr, c + 1]:
