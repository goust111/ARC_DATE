+    if slot == "right":
+        lo = max(4, width - obj_w - 6)
+        return list(range(lo, hi + 1))
+    raise ValueError(slot)
+
+
+def _band_range(height: int, obj_h: int, band: str) -> list[int]:
+    if band == "top":
+        lo, hi = 1, max(1, height // 4)
+    elif band == "mid":
