+def _trace_ray(start: tuple[int, int], blocked: np.ndarray) -> tuple[list[tuple[int, int]] | None, int]:
+    h, w = blocked.shape
+    r, c = map(int, start)
+    if not (0 <= r < h and 0 <= c < w) or blocked[r, c]:
+        return None, 0
+
+    path = [(r, c)]
+    detours = 0
+    steps = 0
+
+    while c < w - 1:
+        steps += 1
+        if steps > h * w * 2:
+            return None, detours
+        if not blocked[r, c + 1]:
+            c += 1
+            path.append((r, c))
+            continue
