+        return None
+
+    up = search(-1)
+    down = search(1)
+    if up is None and down is None:
+        return None
+    if up is None:
+        return int(down[0])
+    if down is None:
+        return int(up[0])
+    if up[1] <= down[1]:
+        return int(up[0])
+    return int(down[0])
