+def _expand_bbox(bbox: tuple[int, int, int, int], radius: int, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return (
+        max(0, r0 - radius),
+        max(0, c0 - radius),
+        min(h - 1, r1 + radius),
+        min(w - 1, c1 + radius),
