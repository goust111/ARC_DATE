+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != int(color):
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _count_holes_in_component(grid: np.ndarray, coords: np.ndarray) -> int:
+    r0, c0, r1, c1 = _bbox(coords)
+    crop = grid[r0 : r1 + 1, c0 : c1 + 1]
+    h, w = crop.shape
+    obj_mask = crop == GREY
+    bg_mask = crop == BG
+    seen = np.zeros((h, w), dtype=bool)
+    holes = 0
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or not bg_mask[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_edge = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and bg_mask[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            if not touches_edge:
+                holes += 1
+
+    assert holes in HOLE_TO_COLOR
+    assert obj_mask.any()
+    return holes
+
+
+def _expand_bbox(bbox: tuple[int, int, int, int], radius: int, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return (
+        max(0, r0 - radius),
+        max(0, c0 - radius),
+        min(h - 1, r1 + radius),
+        min(w - 1, c1 + radius),
+    )
