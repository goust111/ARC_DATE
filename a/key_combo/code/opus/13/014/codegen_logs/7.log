        assert comp["color"] == src_color
        obj_mask = crop_bbox(g == src_color, comp["bbox"])
        holes = _hole_count(obj_mask)
        assert holes in HOLE_COLOR
        rr, cc = comp["coords"].T
        out[rr, cc] = HOLE_COLOR[holes]

