+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+ORANGE = 7
+
+HOLE_TO_COLOR = {1: BLUE, 2: RED, 3: ORANGE}
+
+GRID_ROWS = (18, 22)
+GRID_COLS = (20, 25)
+OBJECT_COUNT_CHOICES = (4, 5)
+MAX_GEN_ATTEMPTS = 500
