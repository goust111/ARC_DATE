+def _choose_detour_row(blocked: np.ndarray, r: int, c: int) -> int | None:
+    h, w = blocked.shape
+    assert c + 1 < w
+
+    def search(step: int) -> tuple[int, int] | None:
+        rr = r
+        dist = 0
+        while 0 <= rr + step < h:
+            rr += step
+            dist += 1
+            if blocked[rr, c]:
+                return None
+            if not blocked[rr, c + 1]:
+                return rr, dist
+        return None
+
+    up = search(-1)
+    down = search(1)
+    if up is None and down is None:
+        return None
+    if up is None:
+        return int(down[0])
+    if down is None:
+        return int(up[0])
+    if up[1] <= down[1]:
+        return int(up[0])
+    return int(down[0])
