+
+
+def _candidate_floor_object(
+    h: int,
+    w: int,
+    occupied: set[tuple[int, int]],
+) -> set[tuple[int, int]] | None:
+    candidates: list[set[tuple[int, int]]] = []
+    for c in range(2, w - 2):
