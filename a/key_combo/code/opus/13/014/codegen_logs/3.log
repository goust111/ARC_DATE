+            bbox = (
+                int(arr[:, 0].min()),
+                int(arr[:, 1].min()),
+                int(arr[:, 0].max()),
+                int(arr[:, 1].max()),
+            )
+            objects.append({"coords": arr, "bbox": bbox})
+    objects.sort(key=lambda obj: (obj["bbox"][0], obj["bbox"][1]))
+    return objects
+
