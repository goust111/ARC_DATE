0014: def main(input_grid):
0015:     """
0016:     Mirror gray objects across their nearest red frame so the reflected copies land inside the frames.
0017: 
0018:     Input structure:
0019:     - The input is a black grid with red frame objects and gray objects outside them.
0020:     - All objects are aligned along one row or one column.
0021:     - Each gray object belongs to the closest red frame.
0022: 
0023:     Rule:
0024:     - Detect the red frames and gray objects.
0025:     - Infer whether the reflection axis is horizontal or vertical from object alignment.
0026:     - Reflect each gray object across the center line of its closest frame and redraw the frame.
0027: 
0028:     Key insight:
0029:     - The red frames define local mirror axes; each gray object moves by reflection, not by free translation.
0030:     """
0031:     # Extract the framework
0032:     frame_color = Color.RED
0033:     object_color = Color.GRAY 
0034:     background = Color.BLACK
0035: 
0036:     # Create an empty grid
0037:     n, m = input_grid.shape
0038:     output_grid = np.zeros((n, m), dtype=int)
0039: 
0040:     # parse the input
0041:     objects = find_components(input_grid, bg=background, connectivity=8, monochromatic=True, return_format="objects")
0042:     frames = [ obj for obj in objects if frame_color in colors_present(obj, exclude={ background }) ]
0043:     mirrored_objects = [ obj for obj in objects if object_color in colors_present(obj, exclude={ background }) ]
0044: 
0045:     # determine if we are doing horizontal or vertical mirroring
0046:     # if all the objects have the same X coordinate, we are doing vertical mirroring
0047:     # if all the objects have the same Y coordinate, we are doing horizontal mirroring
0048:     def _center(b: tuple[int, int, int, int]) -> tuple[float, float]:
0049:         r0, c0, r1, c1 = map(int, b)
0050:         return (r0 + r1) / 2.0, (c0 + c1) / 2.0
0051: 
0052:     centers: list[tuple[float, float]] = []
0053:     for obj in objects:
0054:         _b = bbox(obj != background)
0055:         assert _b is not None
0056:         centers.append(_center(_b))
0057:     r_positions = [rc[0] for rc in centers]
0058:     c_positions = [rc[1] for rc in centers]
0059: 
0060:     # Legacy note: the seed solver ran under a transpose wrapper, so the axis test swaps here.
0061:     if all(c == c_positions[0] for c in c_positions):
0062:         orientation = "vertical"
0063:     elif all(r == r_positions[0] for r in r_positions):
0064:         orientation = "horizontal"
0065:     else: raise ValueError(f"The objects are not aligned in a single axis")
0066: 
0067:     # Flip each other object over its closest frame
0068:     for mirrored_object in mirrored_objects:
0069:         # Find the closest frame
0070:         def distance_between_objects(obj1, obj2):
0071:             _b = bbox(obj1 != background)
0072:             assert _b is not None
0073:             r1, c1 = _center(_b)
0074:             _b = bbox(obj2 != background)
0075:             assert _b is not None
0076:             r2, c2 = _center(_b)
0077:             return (r1 - r2) ** 2 + (c1 - c2) ** 2        
0078:         closest_frame = min(frames, key=lambda frame: distance_between_objects(frame, mirrored_object))
0079: 
0080:         # Build a symmetry object for flipping over the closest frame
0081:         _b = bbox(closest_frame != background)
0082:         assert _b is not None
0083:         frame_r, frame_c = _center(_b)
0084:         _b = bbox(mirrored_object != background)
0085:         assert _b is not None
0086:         this_r, this_c = _center(_b)
0087:         # Make it one pixel past the middle of frame
0088:         frame_c += 0.5 if this_c > frame_c else -0.5
0089:         frame_r += 0.5 if this_r > frame_r else -0.5
0090:         # Conjugation note: legacy seeds ran under a transpose wrapper.
0091:         # When objects are aligned vertically (same column), we mirror across a horizontal line (mirror_r).
0092:         # When objects are aligned horizontally (same row), we mirror across a vertical line (mirror_c).
0093:         symmetry = MirrorSymmetry(
0094:             mirror_r=frame_r if orientation == "vertical" else None,
0095:             mirror_c=frame_c if orientation == "horizontal" else None,
0096:         )
