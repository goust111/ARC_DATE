0020: def main(grid: np.ndarray) -> np.ndarray:
0021:     """
0022:     Crop the unique foreground object whose mask is not mirror-symmetric left-to-right.
0023: 
0024:     Input structure
0025:     - A dominant background surrounds several same-color 8-connected foreground objects.
0026:     - Exactly one foreground color appears.
0027:     - All but one foreground object are mirror-symmetric left-to-right inside their tight bboxes.
0028: 
0029:     Rule
0030:     - Split the non-background pixels into 8-connected objects.
0031:     - Build each object's tight bbox crop over the background.
0032:     - Return the single crop whose foreground mask differs from its left-right reflection.
0033: 
0034:     Key insight
0035:     - The input is a set of candidate sprites, and vertical-axis asymmetry identifies which one to extract regardless of color or position.
0036:     """
0037:     g = np.asarray(grid, dtype=int)
0038:     assert g.ndim == 2, "expected a 2D grid"
0039: 
0040:     bg = get_bg(g)
0041:     foreground_colors = colors_present(g, exclude={bg})
0042:     assert len(foreground_colors) == 1, "expected one foreground color"
0043: 
0044:     asymmetric_crops: list[np.ndarray] = []
0045:     for coords in components_mask(g != bg, connectivity=8):
0046:         crop = _component_crop(g, coords, bg)
0047:         mask = crop != bg
0048:         if not np.array_equal(mask, np.fliplr(mask)):
0049:             asymmetric_crops.append(crop)
0050: 
0051:     assert len(asymmetric_crops) == 1, "expected exactly one left-right-asymmetric object"
0052:     return asymmetric_crops[0]
