+def _available_trigger_cells(
+    paths: list[list[tuple[int, int]]],
+    output_blue: set[tuple[int, int]],
+    input_blue: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    candidates = []
+    for path in paths:
+        for cell in path[1:-1]:
