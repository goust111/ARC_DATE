+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != BLUE:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == BLUE:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
