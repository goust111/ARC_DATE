 115: PAYLOAD_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
 116: PAYLOAD_COLOR_COUNT = 2
 117: GEN_SEPARATOR_COLOR, GEN_ERASED_COLOR = int(SEPARATOR), int(ERASED)
