+                value = int(grid[nr, nc])
+                if value != RED:
+                    adjacent.add(value)
+    carrier = adjacent & CARRIER_COLORS
+    assert len(carrier) == 1, "each red object must have exactly one carrier color"
+    return next(iter(carrier))
