+def _carrier_color(grid: np.ndarray, coords: np.ndarray) -> int:
+    adjacent = set()
+    for r_raw, c_raw in coords:
+        r = int(r_raw)
+        c = int(c_raw)
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
+                value = int(grid[nr, nc])
+                if value != RED:
+                    adjacent.add(value)
