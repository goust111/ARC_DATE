+        return None
+    extra = max_bottom - total_needed
+    slots = [0] * (len(heights) + 1)
+    for _ in range(extra):
+        slots[random.randrange(len(slots))] += 1
+    rows = []
+    r = 1 + slots[0]
+    for i, height in enumerate(heights):
+        rows.append(r)
+        r += height
+        if i < len(heights) - 1:
