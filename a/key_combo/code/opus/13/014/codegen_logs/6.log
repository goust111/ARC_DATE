+BLUE = 1
+RED = 2
+GREY = 5
+TEAL = 8
+CARRIER_COLORS = {BLUE, TEAL}
+
+SHAPES = ((2, 2), (1, 3))
+GRID_H_RANGE = (18, 22)
+GRID_W_RANGE = (16, 20)
+CARRIER_COUNT_CHOICES = (3, 4)
+GEN_RETRIES = 500
