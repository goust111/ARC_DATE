    blocks: list[tuple[int, int, int, int]] = []
    for comp in comps:
        b = comp["bbox"]
        assert comp["area"] == 4 and bbox_h(b) == 2 and bbox_w(b) == 2, "grey anchors must be solid 2x2 blocks"
        blocks.append(b)
