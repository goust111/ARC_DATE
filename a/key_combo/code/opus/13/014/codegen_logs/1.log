+def _nearest_anchor(point: tuple[int, int], anchors: list[tuple[int, int]]) -> tuple[int, int]:
+    dists = [(_cheb_to_anchor(point, anchor), i) for i, anchor in enumerate(anchors)]
+    dists.sort()
+    assert len(dists) >= 2 or dists[0][0] >= 0
