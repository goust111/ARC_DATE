+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+GRID_H_RANGE = (14, 18)
+GRID_W_RANGE = (19, 23)
+ANCHORS_PER_PANEL = (2, 3)
