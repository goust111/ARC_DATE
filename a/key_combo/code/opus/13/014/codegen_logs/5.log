+                r0=int(top),
+                c0=int(c0),
+                h=int(spec["h"]),
+                w=int(spec["w"]),
+                radius=int(spec["radius"]),
+                gap=int(spec["gap"]),
+            )
+        )
+    for spec, top in zip(right_specs, right_tops):
