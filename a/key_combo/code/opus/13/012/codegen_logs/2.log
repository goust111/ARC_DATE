def _solid_rectangles_for_background(g: np.ndarray, bg: int):
    fg_colors = [int(color) for color in np.unique(g) if int(color) != bg]
    if len(fg_colors) != 1:
        return None

    fg = fg_colors[0]
    rectangles = []
    for coords in components_mask(g == fg, connectivity=4):
        r0, c0, r1, c1 = bbox_coords(coords)
