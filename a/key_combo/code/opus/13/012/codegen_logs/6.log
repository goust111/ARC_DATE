        for dr, dc in _GEN_DIRS4
        if 0 <= r + dr < _GEN_H and 0 <= c + dc < _GEN_W
    ]


def _gen_is_clear_scatter_cell(
    cell: tuple[int, int],
    occupied: set[tuple[int, int]],
) -> bool:
