+        return None
+    if np.count_nonzero(out == GREY) != 0:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        specs = _build_region_specs()
+        grid = _place_specs(specs)
+        if grid is not None:
+            return grid
