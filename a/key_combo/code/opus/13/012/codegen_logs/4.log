+    colors = [
+        _random_control_color(exclude=shared),
+        shared,
+        shared,
+        _random_control_color(exclude=shared),
+    ]
+    return cells, colors, "fail_same_color"
+
+
+def _make_pass_domino_chain() -> tuple[list[Coord], list[int], str]:
+    rows = random.randint(3, 4)
+    cells = []
+    for r in range(rows):
