+def _components_from_cells(cells: set[Coord], connectivity: int) -> list[set[Coord]]:
+    remaining = set(cells)
+    out: list[set[Coord]] = []
+    nbr_fn = _neighbors4 if connectivity == 4 else _neighbors8
+    while remaining:
+        seed = next(iter(remaining))
+        stack = [seed]
+        remaining.remove(seed)
+        comp = {seed}
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in nbr_fn(r, c):
+                nb = (nr, nc)
+                if nb in remaining:
+                    remaining.remove(nb)
+                    comp.add(nb)
+                    stack.append(nb)
+        out.append(comp)
