+    return cells, colors, "pass_sensitive"
+
+
+def _make_fail_blob() -> tuple[list[Coord], list[int], str]:
+    options = [
+        [(0, 0), (0, 1), (1, 0), (1, 1), (1, 2), (2, 1)],
+        [(0, 1), (1, 0), (1, 1), (1, 2), (2, 0), (2, 1)],
+        [(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (2, 1)],
