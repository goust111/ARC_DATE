from itertools import combinations, product
from collections import defaultdict

def comp4(cells):
    cells=set(cells); out=[]
    while cells:
        s=next(iter(cells)); stack=[s]; cells.remove(s); cur=[]
        while stack:
            r,c=stack.pop(); cur.append((r,c))
            for nb in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
                if nb in cells:
                    cells.remove(nb); stack.append(nb)
        out.append(cur)
    return out

def conn8(shape):
    cells=set(shape); stack=[next(iter(cells))]; seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if dr==dc==0: continue
                nb=(r+dr,c+dc)
                if nb in cells and nb not in seen:
                    seen.add(nb); stack.append(nb)
    return len(seen)==len(cells)

def classify(shape,seq):
    by=defaultdict(list)
    for r,c in shape: by[seq[r]].append((r,c))
    subs=[]
    for cells in by.values():
        for cc in comp4(cells): subs.append(set(cc))
    if len(subs)<2: return False
    n=len(subs); graph=[set() for _ in range(n)]
    for i in range(n):
        for j in range(i+1,n):
            ortho=diag=False
            for r,c in subs[i]:
                for rr,cc in subs[j]:
                    if abs(r-rr)+abs(c-cc)==1: ortho=True
                    if abs(r-rr)==1 and abs(c-cc)==1: diag=True
            if ortho: return False
            if diag:
                graph[i].add(j); graph[j].add(i)
    if max((len(g) for g in graph), default=0)>2: return False
    seen={0}; stack=[0]
    while stack:
        i=stack.pop()
        for j in graph[i]:
            if j not in seen:
                seen.add(j); stack.append(j)
    if len(seen)"'!=n: return False
    return sum(len(g) for g in graph)//2 == n-1

# search shapes in 4x4 with 4-7 cells, normalized to min row/col zero and using all rows in span
pts=[(r,c) for r in range(4) for c in range(4)]
found=[]
for k in range(4,8):
  for comb in combinations(pts,k):
    rs=[r for r,c in comb]; cs=[c for r,c in comb]
    r0=min(rs); c0=min(cs)
    shape=tuple(sorted((r-r0,c-c0) for r,c in comb))
    h=max(r for r,c in shape)+1
    if h<3 or not conn8(shape):
        continue
    # use all rows in span
    if set(r for r,c in shape)!=set(range(h)):
        continue
    distinct=tuple(range(h))
    if not classify(shape, distinct):
        continue
    # repeated adjacent rows same color causing fail
    for i in range(h-1):
        seq=list(range(h))
        seq[i+1]=seq[i]
        if not classify(shape, seq):
            found.append((shape, distinct, tuple(seq), i))
            print('"'FOUND', shape, distinct, tuple(seq), 'repeat', i)
            raise SystemExit
