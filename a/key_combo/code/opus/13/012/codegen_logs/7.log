+
+
+def _expected_output(
+    grid: np.ndarray,
+    cell_size: int,
+    templates: list[np.ndarray],
+    prefix_specs: dict[tuple[int, int], tuple[int, dict[int, int]]],
+    marker_colors: dict[tuple[int, int], int],
