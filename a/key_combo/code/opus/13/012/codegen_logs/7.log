+
+def _prefix_from_template(
+    template: np.ndarray,
+    prefix_width: int,
+    mapping: dict[int, int],
+) -> np.ndarray:
+    region = np.zeros_like(template)
+    for template_color, prefix_color in mapping.items():
+        region[:, :prefix_width][template[:, :prefix_width] == template_color] = prefix_color
+    return region
