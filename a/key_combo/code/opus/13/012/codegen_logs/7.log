+
+def _make_template(cell_size: int, rng: np.random.Generator) -> tuple[np.ndarray, list[int]]:
+    min_area = max(cell_size + 1, 4)
+    max_area = min((cell_size * cell_size) - 2, max(min_area, int(round(cell_size * cell_size * 0.55))))
