+import numpy as np
+
+
+BG = 0
+TEMPLATE_BLUE = 1
+TEMPLATE_RED = 2
+PREFIX_GREEN = 3
+PREFIX_YELLOW = 4
+DIVIDER = 5
+MARKER_COLORS = (6, 7, 8, 9)
+
+TABLE_BANDS = 4
+DATA_ROWS = (1, 2, 3)
+TEMPLATE_COLORS = (TEMPLATE_BLUE, TEMPLATE_RED)
+PREFIX_COLORS = (PREFIX_GREEN, PREFIX_YELLOW)
