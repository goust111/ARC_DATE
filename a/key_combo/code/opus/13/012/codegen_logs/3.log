def _checkerboard(h: int, w: int) -> np.ndarray:
    """Checkerboard with top-left cell = 1, bg[r,c] = (r+c+1)%2."""
    rows, cols = np.indices((h, w))
    return ((rows + cols + 1) % 2).astype(int)


def _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
    """Set grid[r, c] = color for each (r, c) in cells."""
    for r, c in cells:
        grid[r, c] = color


def _sort_segment(cells: list[tuple[int, int]], slope: str) -> list[tuple[int, int]]:
    """Sort diagonal segment cells by row (and column appropriate to slope direction)."""
    if slope == "diff":
        return sorted(cells, key=lambda p: (p[0], p[1]))
    return sorted(cells, key=lambda p: (p[0], -p[1]))


