spec:
  grid: 4-14 rows x 10-14 cols; all cells are black(0), red(2), blue(1), or teal(8)
  marker_rows:
    count: 1-5 rows, each containing exactly one blue pixel left of one teal pixel
    segment: cells strictly between blue and teal markers; all segments have equal width (3-7)
    segment_content: only black(0) and red(2), ~30-75% red
    marker_positions: blue col 0-5, teal col 4-10; vary across rows (not fixed columns)
    spacing: gap between consecutive marker rows is 1-3 [observed]
    placement: may start at row 0; never end at last row [observed]
  non_marker_rows:
    count: 3-9 rows with no blue/teal; contain only black(0) and red(2)
    red_fraction: ~30-60% red, randomly distributed
  marker_row_outside_bracket: cells outside the blue..teal span are only black(0) and red(2)
  output: stack the segments (top-to-bottom marker order); dims = marker_count x segment_width

generation_strategy:
  approach: direct construction (simple extraction task, no complex constraints)
  steps:
    1. Choose num_markers M in [1,5], segment_width W in [3,7]
    2. Generate M segment rows of width W with random black/red content
    3. Choose grid height H >= M+3 and grid width GW >= W+2
    4. Scatter M marker rows among H rows (gaps 1-3, at least 1 non-marker row exists)
    5. For each marker row, pick blue_col so that blue_col+1+W <= GW-1, set teal_col = blue_col+1+W
    6. Fill marker row outside the bracket span with random black/red
    7. Fill all non-marker rows with random black/red
    8. Output = vertically stacked segments in row order
