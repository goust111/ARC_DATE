+def _pairwise_manhattan_gap(
+    a: frozenset[tuple[int, int]], b: frozenset[tuple[int, int]]
+) -> int:
+    return min(abs(r1 - r2) + abs(c1 - c2) for r1, c1 in a for r2, c2 in b)
