+    rows = [r for r, _ in shape]
+    cols = [c for _, c in shape]
+    if max(rows) - min(rows) < 3 or max(cols) - min(cols) < 3:
+        return None
+    if any(len([1 for nr, nc in _neighbors4(r, c) if (nr, nc) in shape]) == 0 for r, c in shape):
