+    for wedge in _detect_wedges(right):
+        triangle = wedge["triangle"]
+        if any(left_foreground[r, c] for r, c in triangle):
+            continue
+        for r, c in triangle:
+            out[r, c] = GREEN if int(right[r, c]) == GREEN else TEAL
+    return out
