+def _triangle_cells(
+    kind: str, tip_r: int, tip_c: int, height: int, shape: tuple[int, int]
+) -> frozenset[tuple[int, int]]:
+    cells = {(tip_r, tip_c)}
+    if kind == "down":
+        for d in range(1, height + 1):
+            rr = tip_r + d
+            for cc in range(tip_c - d, tip_c + d + 1):
+                if _in_bounds(shape, rr, cc):
+                    cells.add((rr, cc))
+    elif kind == "up":
+        for d in range(1, height + 1):
+            rr = tip_r - d
+            for cc in range(tip_c - d, tip_c + d + 1):
+                if _in_bounds(shape, rr, cc):
+                    cells.add((rr, cc))
+    elif kind == "right":
