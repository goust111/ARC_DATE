+    cells = {(tip_r, tip_c)}
+    if kind == "down":
+        for d in range(1, height + 1):
+            rr = tip_r + d
+            for cc in range(tip_c - d, tip_c + d + 1):
+                if _in_bounds(shape, rr, cc):
+                    cells.add((rr, cc))
+    elif kind == "up":
+        for d in range(1, height + 1):
+            rr = tip_r - d
+            for cc in range(tip_c - d, tip_c + d + 1):
+                if _in_bounds(shape, rr, cc):
+                    cells.add((rr, cc))
+    elif kind == "right":
+        for d in range(1, height + 1):
+            cc = tip_c + d
+            for rr in range(tip_r - d, tip_r + d + 1):
