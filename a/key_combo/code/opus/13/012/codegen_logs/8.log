+from __future__ import annotations
+
+import numpy as np
+
+BLACK = 0
+BLUE = 1
+GREEN = 3
+ORANGE = 7
+TEAL = 8
+
+_WEDGE_KINDS = (
+    ("down", (1, -1), (1, 1)),
+    ("up", (-1, -1), (-1, 1)),
+    ("right", (-1, 1), (1, 1)),
+    ("left", (-1, -1), (1, -1)),
+)
+
+_GEN_HEIGHT_RANGE = (11, 15)
+_GEN_PANEL_WIDTH_RANGE = (11, 14)
+_GEN_BLUE_AREA_RANGE = (15, 28)
