+def _ray_marker_distances(grid: np.ndarray, r: int, c: int, dr: int, dc: int) -> list[int]:
+    distances: list[int] = []
+    d = 1
+    while _in_bounds(grid.shape, r + dr * d, c + dc * d):
+        if int(grid[r + dr * d, c + dc * d]) == GREEN:
+            distances.append(d)
+        d += 1
