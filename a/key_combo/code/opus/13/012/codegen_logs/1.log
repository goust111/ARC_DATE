+from __future__ import annotations
+
+from collections import deque
+import random
+import numpy as np
+
+
+BG = 0
+MARKER = 1
+FG = 7
+CHAIN_COLOR = 8
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+DIAG4 = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
