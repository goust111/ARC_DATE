+    orange = g == FG
+    labels8, n8 = _label_mask(orange, connectivity=8)
+    assigned, _isolated = _marker_assignments(g, labels8, n8)
+
+    out = g.copy()
+    for k in range(1, n8 + 1):
+        mask = labels8 == k
+        coords = np.argwhere(mask)
+        markers = assigned[k]
+        if _is_diagonal_chain(mask):
+            out[coords[:, 0], coords[:, 1]] = CHAIN_COLOR
+            for r, c in markers:
