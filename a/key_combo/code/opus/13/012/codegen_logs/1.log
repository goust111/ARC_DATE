+def _diagonal_contacts(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> bool:
+    for r, c in a:
+        for dr, dc in DIAG4:
+            if (r + dr, c + dc) in b:
+                return True
+    return False
+
