def crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
    """Crop a grid to bbox (inclusive)."""
    r0, c0, r1, c1 = map(int, bbox)
    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()


