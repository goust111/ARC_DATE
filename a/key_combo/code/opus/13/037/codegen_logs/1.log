+def _paste(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> np.ndarray:
+    h, w = patch.shape
+    sub = grid[r0 : r0 + h, c0 : c0 + w]
+    mask = patch != BG
+    sub[mask] = patch[mask]
+    return grid
