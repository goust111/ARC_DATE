+    "solid_2x3": [(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (1, 2)],
+    "solid_3x2": [(0, 0), (1, 0), (2, 0), (0, 1), (1, 1), (2, 1)],
+    "l4": [(0, 0), (1, 0), (2, 0), (2, 1)],
+    "t5": [(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)],
