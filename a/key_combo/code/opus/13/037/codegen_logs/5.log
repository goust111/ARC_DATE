+BG = 0
+GREY = 5
+BAND_H = 3
+SPRITE_COLORS = (1, 2, 3, 4, 7)
+MAIN_HEIGHT_OPTIONS = (16, 17)
+GRID_WIDTH_RANGE = (19, 24)
