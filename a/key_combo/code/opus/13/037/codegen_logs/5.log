    gaps = _gen_bounded_counts(size - 1, n_lines + 1, CUT_GAP_MIN, CUT_GAP_MAX)
    if gaps is None:
        return None
    cuts = []
    cur = 0
    for gap in gaps[:-1]:
        cur += gap
        cuts.append(cur)
    return cuts


