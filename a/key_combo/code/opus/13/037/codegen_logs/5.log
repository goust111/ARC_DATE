+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
