    rows = _gen_cuts(h, n_h)
    cols = _gen_cuts(w, n_v)
    if rows is None or cols is None:
        return None

    g = np.zeros((h, w), dtype=int)
    for c in cols:
        g[:, c] = Color.BLUE
    for r in rows:
        g[r, :] = Color.BLUE

    markers = set()
    for c in cols:
        markers.add((0, c))
        markers.add((h - 1, c))
    for r in rows:
        markers.add((r, 0))
        markers.add((r, w - 1))
    for r in rows:
        for c in cols:
            markers.add((r, c))
    for r, c in markers:
        g[r, c] = Color.RED

