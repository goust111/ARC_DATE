+                "key": (spec["color"], _mask_key(spec["shape"])),
+                "color": spec["color"],
+                "patch": _patch_from_shape(spec["shape"], spec["color"]),
+                "count": spec["count"],
+                "first_bbox": min(spec["bboxes"]),
