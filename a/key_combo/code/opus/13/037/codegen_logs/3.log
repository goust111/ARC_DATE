+    wall_mask = (grid == BLUE) | (grid == GREY)
+    for _room_id, (er, ec, color) in emitters.items():
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            dist = 1
+            r = er + dr
+            c = ec + dc
+            while _in_bounds(grid.shape, r, c) and not wall_mask[r, c]:
+                out[r, c] = color if dist % 2 == 0 else GREY
+                dist += 1
+                r += dr
+                c += dc
+    return out
