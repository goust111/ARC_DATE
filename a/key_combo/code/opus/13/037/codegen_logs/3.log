+    components: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not passable[r, c] or labels[r, c] >= 0:
+                continue
+            label = len(components)
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            labels[r, c] = label
+            comp: list[tuple[int, int]] = []
