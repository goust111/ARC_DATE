+def _wall_is_intersection(wall_mask: np.ndarray, r: int, c: int) -> bool:
+    up = _in_bounds(wall_mask.shape, r - 1, c) and bool(wall_mask[r - 1, c])
+    down = _in_bounds(wall_mask.shape, r + 1, c) and bool(wall_mask[r + 1, c])
