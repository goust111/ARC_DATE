+        return False
+    if H_BAR_COLOR not in expected or V_BAR_COLOR not in expected:
+        return False
+
+    variants = [
+        _render_tile_array(
+            sprite_patch,
+            rows,
+            cols,
+            apply_row_flips=False,
+            apply_col_flips=False,
+            row_sep_color=V_BAR_COLOR,
+            col_sep_color=H_BAR_COLOR,
