+        alt_h = alt_rows * sprite_patch.shape[0] + (alt_rows - 1)
+        if r0 + alt_h <= grid.shape[0]:
+            alt = _render_full_output(grid.shape, (r0, c0), sprite_patch, alt_rows, cols)
+            if np.array_equal(alt, expected):
