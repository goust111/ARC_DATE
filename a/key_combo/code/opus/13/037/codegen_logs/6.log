+
+
+def _is_vertical_bar(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    return (
+        int(component["color"]) == V_BAR_COLOR
+        and c0 == c1
+        and int(component["area"]) == r1 - r0 + 1
+    )
