+    cols = _line_length(horizontal)
+    tiled = _render_tile_array(
+        sprite_patch,
+        rows,
+        cols,
+        apply_row_flips=True,
+        apply_col_flips=True,
+        row_sep_color=V_BAR_COLOR,
+        col_sep_color=H_BAR_COLOR,
+        vertical_priority=True,
+        bg=bg,
+    )
