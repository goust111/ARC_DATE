+def _is_horizontal_bar(component: dict) -> bool:
+    r0, c0, r1, c1 = component["bbox"]
+    return (
+        int(component["color"]) == H_BAR_COLOR
+        and r0 == r1
+        and int(component["area"]) == c1 - c0 + 1
