+        row=int(r0),
+        c0=int(c0),
+        c1=int(c1),
+        radius=int(radius),
+        outline=outline,
+        upper_outline=upper_outline,
+        bbox=(int(r0 - radius), int(c0), int(r0 + radius), int(c1)),
+    )
