+def _assign_colors(rng: random.Random, sprites: list[SpritePlacement]) -> None:
+    distinct_count = min(len(SPRITE_COLORS), max(2, min(len(sprites), rng.randint(2, 4))))
+    chosen = list(rng.sample(SPRITE_COLORS, distinct_count))
+    colors = chosen.copy()
