+        if sprite.input_row + sprite.shape[0] - 1 >= min_bar_row:
+            return False
+        if max(sprite.col, bars[sprite.support_bar].c0) > min(sprite.col + sprite.shape[1] - 1, bars[sprite.support_bar].c1):
