0111:     out = np.full_like(g, bg)
0112:     objects = _objects(g, bg)
0113: 
0114:     closed = [obj for obj in objects if obj.closed]
0115:     open_objects = [obj for obj in objects if not obj.closed]
0116:     assert closed, "expected at least one closed object"
0117:     assert open_objects, "expected at least one open object"
0118: 
0119:     for obj in sorted(closed, key=lambda o: (o.bbox[0], o.bbox[1], o.bbox[2], o.bbox[3])):
0120:         _slide_into_place(out, obj, bg, upward=True)
0121: 
0122:     for obj in sorted(open_objects, key=lambda o: (-o.bbox[2], o.bbox[1], -o.bbox[0], o.bbox[3])):
0123:         _slide_into_place(out, obj, bg, upward=False)
0124: 
0125:     return out
