0038: def main(grid: np.ndarray) -> np.ndarray:
0039:     """
0040:     Slide each right-edge colored run left within its row until it is packed against the nearest fixed barrier or the left edge.
0041: 
0042:     Input structure
0043:     - The background is the dominant color.
0044:     - There are exactly two foreground colors: fixed barrier pixels and moving pixels.
0045:     - In every row where the moving color appears, it forms one contiguous horizontal run ending at the right edge.
0046: 
0047:     Rule
0048:     - Process each occupied row independently.
0049:     - Clear the moving run from the right edge.
0050:     - Repaint that run starting immediately to the right of the row's rightmost barrier pixel, or at column 0 when no barrier is present.
0051:     - Keep the barrier pixels and all rows without moving pixels unchanged.
0052: 
0053:     Key insight
0054:     - The fixed pixels are row-wise stoppers; each moving run simply slides left as far as possible without crossing the nearest stopper.
0055:     """
0056:     g = np.asarray(grid, dtype=int)
0057:     assert g.ndim == 2
0058: 
0059:     bg = int(get_bg(g))
0060:     moving = _right_edge_run_color(g, bg)
0061:     blockers = colors_present(g, exclude={bg, moving})
0062:     assert len(blockers) == 1, "expected a unique barrier color"
0063:     barrier = int(blockers[0])
0064: 
0065:     height, width = g.shape
0066:     out = g.copy()
0067:     moved_rows = 0
0068: 
0069:     for r in range(height):
0070:         cols = np.flatnonzero(g[r] == moving)
0071:         if len(cols) == 0:
0072:             continue
0073: 
0074:         moved_rows += 1
0075:         start = int(cols[0])
0076:         end = int(cols[-1])
0077:         run_len = int(len(cols))
0078:         assert end == width - 1 and run_len == end - start + 1, "moving pixels must form a right-edge run"
0079: 
0080:         barrier_cols = np.flatnonzero(g[r, :start] == barrier)
0081:         target_start = int(barrier_cols[-1]) + 1 if len(barrier_cols) else 0
0082:         target_end = target_start + run_len
0083:         assert target_end <= width, "slid run must fit in its row"
0084:         assert np.all(g[r, target_start:target_end] != barrier), "slid run cannot cover a barrier"
0085: 
0086:         out[r, start : end + 1] = bg
0087:         out[r, target_start:target_end] = moving
0088: 
0089:     assert moved_rows > 0, "expected at least one moving run"
0090:     return out
