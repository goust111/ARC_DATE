0617: def tile_fill(shape: tuple[int, int], tile: np.ndarray, *, offset: Coord = (0, 0)) -> np.ndarray:
0618:     """Return a new grid of `shape` filled by repeating `tile` with a phase offset."""
0619:     H, W = map(int, shape)
0620:     h, w = tile.shape
0621:     r_off, c_off = map(int, offset)
0622:     out = np.empty((H, W), dtype=tile.dtype)
0623:     for r in range(H):
0624:         tr = (r - r_off) % h
0625:         for c in range(W):
0626:             tc = (c - c_off) % w
0627:             out[r, c] = tile[tr, tc]
0628:     return out
