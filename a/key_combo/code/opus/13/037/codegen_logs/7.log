+    sprite_components = _extract_components(g, sprite_colors)
+    assert sprite_components, "expected at least one sprite"
+
+    out = np.full_like(g, bg)
+    for bar in bars:
+        for r, c in bar.outline:
+            out[r, c] = DIAMOND_COLOR
