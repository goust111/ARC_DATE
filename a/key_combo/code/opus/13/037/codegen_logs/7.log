0687: def contact(
0688:     *,
0689:     object1: np.ndarray,
0690:     object2: np.ndarray,
0691:     r1: int = 0,
0692:     c1: int = 0,
0693:     r2: int = 0,
0694:     c2: int = 0,
0695:     background: int = Color.BLACK,
0696:     connectivity: int = 4,
0697: ) -> bool:
0698:     """Return True iff objects touch (share edge/diagonal) or overlap."""
0699:     bg = int(background)
0700:     struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
0701:     m2 = (object2 != bg)
0702:     m2d = ndimage.binary_dilation(m2, structure=struct)
0703:     return collision(
0704:         object1=(object1 != bg).astype(int),
0705:         object2=m2d.astype(int),
0706:         r1=r1,
0707:         c1=c1,
0708:         r2=r2,
0709:         c2=c2,
0710:         background=0,
0711:     )
