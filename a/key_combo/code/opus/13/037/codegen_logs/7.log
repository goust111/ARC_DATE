0041: def main(grid: np.ndarray) -> np.ndarray:
0042:     """
0043:     Fill enclosed regions along a line seeded by unique border pixels.
0044: 
0045:     Input structure:
0046:     - bg = most common color.
0047:     - Colored lines/drawings on the grid.
0048:     - Unique single-pixel colors on the grid border mark seed endpoints of each line.
0049: 
0050:     Rule:
0051:     - Each border seed pixel connects (8-connected) to a line drawing.
0052:     - Find closed bg cavities whose boundary touches that line.
0053:     - Flood-fill each such cavity with the seed pixel's color.
0054: 
0055:     Key insight: Only cavities reachable through the seed's own line get filled; the seed's unique color acts as a per-line fill label.
0056:     """
0057:     g = np.asarray(grid, dtype=int)
0058:     h, w = g.shape
0059:     bg = get_bg(g)
0060: 
0061:     out = g.copy()
0062: 
0063:     # Precompute background regions (4-connected). Exclude those containing background corners as "outside".
0064:     bg_comps = _components_mask(g == bg, conn8=False)
0065:     regions = []  # list of (set_pts, boundary_set, touches_border, size)
0066:     for pts in bg_comps:
0067:         region = set(pts)
0068:         touches = _touches_border(pts, h, w)
0069:         boundary = set()
0070:         for r, c in region:
0071:             for nr, nc in neighbors4(r, c):
0072:                 if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in region and int(g[nr, nc]) != bg:
0073:                     boundary.add((nr, nc))
0074:         regions.append((region, boundary, touches, len(region)))
0075: 
0076:     corners = {(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)}
0077:     outside_idxs = set()
0078:     for i, (reg, _, _, _) in enumerate(regions):
0079:         if any(p in reg for p in corners if int(g[p]) == bg):
0080:             outside_idxs.add(i)
0081: 
0082:     cavities = []
0083:     for i, (reg, bnd, _, _) in enumerate(regions):
0084:         if i in outside_idxs or not bnd:
0085:             continue
0086:         bcols = {int(g[p]) for p in bnd}
0087:         cavities.append((reg, bnd, bcols))
0088: 
0089:     for sr, sc in _seed_pixels(g, bg):
0090:         seed_col = int(g[sr, sc])
0091: 
0092:         neigh_cols = []
0093:         for nr, nc in neighbors4(sr, sc):
0094:             if 0 <= nr < h and 0 <= nc < w:
0095:                 v = int(g[nr, nc])
0096:                 if v != bg:
0097:                     neigh_cols.append(v)
0098:         assert neigh_cols, "seed pixel must have at least one non-bg neighbor"
0099:         line_col = Counter(neigh_cols).most_common(1)[0][0]
0100: 
0101:         # Trace the connected "drawing" reachable from the seed (8-connected, non-background).
0102:         traced = _nonbg_component8_from(g, (sr, sc), bg)
0103: 
0104:         for cav, boundary, bcols in cavities:
0105:             if len(bcols) != 1:
0106:                 continue
0107:             boundary_in_traced = boundary & traced
0108:             if not boundary_in_traced:
0109:                 continue
0110: 
0111:             # Require that the traced boundary is adjacent (8-neigh) to at least one pixel of the line color.
0112:             # This prevents filling regions that are only connected through other structures, not the line itself.
0113:             ok = False
0114:             for r, c in boundary_in_traced:
0115:                 for nr, nc in neighbors8(r, c):
0116:                     if 0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) == line_col:
0117:                         ok = True
0118:                         break
0119:                 if ok:
0120:                     break
0121:             if not ok:
0122:                 continue
0123: 
0124:             for r, c in cav:
0125:                 if int(out[r, c]) == bg:
0126:                     out[r, c] = seed_col
