+
+def _bar_bbox_clear(new_bbox: tuple[int, int, int, int], bars: list[Bar]) -> bool:
+    nr0, nc0, nr1, nc1 = new_bbox
+    for bar in bars:
+        br0, bc0, br1, bc1 = bar.bbox
+        if nr1 + 1 < br0 or br1 + 1 < nr0 or nc1 + 1 < bc0 or bc1 + 1 < nc0:
+            continue
+        return False
+    return True
