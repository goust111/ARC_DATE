0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Paint a teal diamond envelope around each straight foreground bar.
0011: 
0012:     Input structure
0013:     - The grid has a single background color and one non-background foreground color.
0014:     - Every foreground object is a solid horizontal or vertical one-cell-thick bar.
0015:     - Teal is absent from the input and is reserved for the added envelope pixels.
0016: 
0017:     Rule
0018:     - Keep every original foreground bar unchanged.
0019:     - For a horizontal bar, paint teal rows above and below it; each step away from the bar shortens the interval by one pixel at both ends.
0020:     - For a vertical bar, apply the same shrinking construction rotated ninety degrees.
0021: 
0022:     Key insight
0023:     - A bar of length L defines a centered diamond of radius floor((L - 1) / 2), with the original bar forming the middle line and teal filling only the surrounding background cells.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     assert g.ndim == 2, "expected a 2D grid"
0027: 
0028:     bg = get_bg(g)
0029:     colors = colors_present(g, exclude={bg})
0030:     assert len(colors) == 1, "expected exactly one foreground color"
0031:     bar_color = colors[0]
0032:     fill_color = Color.TEAL
0033:     assert fill_color != bg and fill_color != bar_color, "teal must be a new output color"
0034:     assert not np.any(g == fill_color), "teal must not appear in the input"
0035: 
0036:     out = g.copy()
0037:     height, width = map(int, g.shape)
0038:     bars = find_components(g, bg=bg, connectivity=4, monochromatic=True, colors=[bar_color])
0039:     assert bars, "expected at least one foreground bar"
0040: 
0041:     for bar in bars:
0042:         r0, c0, r1, c1 = bar["bbox"]
0043:         h = int(r1 - r0 + 1)
0044:         w = int(c1 - c0 + 1)
0045:         area = int(bar["area"])
0046:         assert area == h * w, "foreground bar must be solid"
0047:         assert h == 1 or w == 1, "foreground object must be a straight bar"
0048: 
0049:         length = max(h, w)
0050:         radius = (length - 1) // 2
0051:         assert radius >= 1, "bar must be long enough to form an envelope"
0052: 
0053:         if h == 1:
0054:             row = int(r0)
0055:             for offset in range(1, radius + 1):
0056:                 left = int(c0 + offset)
0057:                 right = int(c1 - offset)
0058:                 assert 0 <= left <= right < width, "horizontal envelope interval must stay in bounds"
0059:                 for rr in (row - offset, row + offset):
0060:                     assert 0 <= rr < height, "horizontal envelope row must stay in bounds"
0061:                     view = out[rr, left : right + 1]
0062:                     view[view == bg] = fill_color
0063:         else:
0064:             col = int(c0)
0065:             for offset in range(1, radius + 1):
0066:                 top = int(r0 + offset)
0067:                 bottom = int(r1 - offset)
0068:                 assert 0 <= top <= bottom < height, "vertical envelope interval must stay in bounds"
0069:                 for cc in (col - offset, col + offset):
0070:                     assert 0 <= cc < width, "vertical envelope column must stay in bounds"
0071:                     view = out[top : bottom + 1, cc]
0072:                     view[view == bg] = fill_color
0073: 
0074:     return out
