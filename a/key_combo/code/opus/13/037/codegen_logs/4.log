+        left, right = sorted(members, key=lambda obj: obj["bbox"][1])
+        left_gap = int(right["bbox"][1] - left["bbox"][3] - 1)
+        assert left_gap >= 1, "paired objects must be separated horizontally"
+        pairs.append((left, right))
