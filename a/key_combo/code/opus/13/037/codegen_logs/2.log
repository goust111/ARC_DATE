+    out[:q, mid + 1 :][np.fliplr(ul)] = majorities[0]
+    out[mid + 1 :, :q][np.flipud(ul)] = majorities[1]
+    out[mid + 1 :, mid + 1 :][np.rot90(ul, 2)] = majorities[2]
