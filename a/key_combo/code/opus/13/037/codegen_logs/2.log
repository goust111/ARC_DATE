    return grid


def _gen_expected_output(grid: np.ndarray, grey_cells_by_motif: list[CellList]) -> np.ndarray:
    out = grid.copy()
    for grey_cells in grey_cells_by_motif:
        rows, cols = zip(*grey_cells)
        out[rows, cols] = GEN_RED
    return out


