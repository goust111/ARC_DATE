    color_count = int(rng.integers(COLOR_COUNT_MIN, COLOR_COUNT_MAX_EXCLUSIVE))
    palette = rng.choice(COLOR_VALUES, size=color_count, replace=False)

    tile = rng.choice(palette, size=(height, width), replace=True).astype(int)

