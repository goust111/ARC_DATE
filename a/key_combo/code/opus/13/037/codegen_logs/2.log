+    template = inp[:mid, :mid] == TEMPLATE_COLOR
+    assert not np.array_equal(np.fliplr(template), template)
+    assert not np.array_equal(np.flipud(template), template)
+    assert not np.array_equal(np.rot90(template, 2), template)
