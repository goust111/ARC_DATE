    min_r, max_r, min_c, max_c = _gen_offset_bounds(offsets)
    patch = np.zeros((max_r - min_r + 1, max_c - min_c + 1), dtype=int)
    for dr, dc in offsets:
        patch[dr - min_r, dc - min_c] = color
    return patch, min_r, min_c


