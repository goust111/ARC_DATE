    bottom = height - 1 - top
    rows = list(range(-top, bottom + 1))

    units = _gen_source_units(rows, half_width)
    offsets: set[tuple[int, int]] = set()
    offsets.update(random.choice(_gen_anchor_adjacency_patterns(top, bottom)))

    _gen_add_unit(
        offsets,
