spec:
  grid: 25-29 rows x 25-29 cols, square, background BLACK
  blocks:
    count: 2-3 solid rectangular yellow blocks on black background
    dimensions: 3-8 rows x 3-10 cols (min dimension >= 3)
    fill: all cells either YELLOW or one marker color; marker color != YELLOW
    markers:
      count: 1-5 per block (= expansion padding distance)
      placement: strictly interior (never on block border row/col)
      color: one non-yellow non-black color per block; unique across blocks [observed]
  expansion:
    each block bbox expands by pad cells on all 4 sides
    expanded bboxes must stay within grid bounds (margin >= 0)
    expanded bboxes must not overlap (gap >= 0 on each axis)
  output:
    expanded rectangles filled with marker color
    original block cells (yellow + markers) restored on top

generation_strategy:
