+    def feasible_from(index: int, prev_max_row: int) -> bool:
+        probe_prev = prev_max_row
+        for j in range(index, len(objects)):
+            min_row, max_row = row_bounds[j]
+            shift = max(1, probe_prev + 2 - min_row)
+            if max_row + shift >= H:
