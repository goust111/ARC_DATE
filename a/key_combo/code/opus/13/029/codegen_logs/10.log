+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and min(g.shape) > 0
+    settled, object_ids, comps, wall_mask = _settle_components(g)
+    return _filter_merged_components(settled, object_ids, comps, wall_mask)
