+                    "color": int(color),
+                    "width": int(lane_width),
+                    "shapes": shapes,
+                    "offsets": offsets,
+                }
+    return None
+
+
+def _settle_top(coords: np.ndarray, occupied: np.ndarray, H: int) -> np.ndarray | None:
+    cur = coords.copy()
+    if np.any(occupied[cur[:, 0], cur[:, 1]]):
+        return None
