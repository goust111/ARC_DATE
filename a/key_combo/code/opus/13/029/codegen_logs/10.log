SPRITE_MIN_HEIGHT = 1
SPRITE_MAX_HEIGHT = 5
SPRITE_MIN_WIDTH = 1
SPRITE_MAX_WIDTH = 3
SPRITE_MIN_AREA = 3
SPRITE_MAX_AREA = 6

