+        return None
+    while True:
+        nxt = cur + np.array([-1, 0], dtype=int)
+        if np.any(nxt[:, 0] < 0) or np.any(occupied[nxt[:, 0], nxt[:, 1]]):
+            return cur
+        cur = nxt
