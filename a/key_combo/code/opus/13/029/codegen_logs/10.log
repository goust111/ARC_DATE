+        while True:
+            nxt = coords + step
+            in_bounds = (
+                np.all(0 <= nxt[:, 0])
+                and np.all(nxt[:, 0] < H)
+                and np.all(0 <= nxt[:, 1])
+                and np.all(nxt[:, 1] < W)
