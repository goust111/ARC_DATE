def _boundary_background(g: np.ndarray) -> int:
    boundary = np.concatenate((g[0, :], g[-1, :], g[1:-1, 0], g[1:-1, -1]))
    colors, counts = np.unique(boundary, return_counts=True)
    assert colors.size > 0, "expected a nonempty grid boundary"

