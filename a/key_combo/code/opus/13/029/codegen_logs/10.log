+    settled = np.full((H, W), BLACK, dtype=int)
+    settled[wall_mask] = RED
+    object_ids = np.full((H, W), -1, dtype=int)
+    occupied = wall_mask.copy()
+    step = np.array([dr, dc], dtype=int)
