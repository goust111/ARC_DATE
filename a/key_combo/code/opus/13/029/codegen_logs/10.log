+def _normalize(coords: np.ndarray) -> np.ndarray:
+    arr = np.array(coords, dtype=int)
+    arr -= arr.min(axis=0)
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
