+def _orientations(shape: list[tuple[int, int]]) -> list[np.ndarray]:
+    base = np.array(shape, dtype=int)
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    out: list[np.ndarray] = []
+    for rot in range(4):
