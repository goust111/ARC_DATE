+        max_width = max(_shape_dims(shape)[1] for shape in shapes)
+        width_choices = [max_width]
+        if max_width < 4:
+            width_choices.append(max_width + 1)
+        random.shuffle(width_choices)
+        for lane_width in width_choices:
