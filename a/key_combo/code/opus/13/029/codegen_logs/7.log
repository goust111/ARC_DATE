+    out = np.array(grid, dtype=int, copy=True)
+    for r in range(out.shape[0]):
+        pair_cols = _find_pair_columns(out[r])
+        if pair_cols is None:
+            continue
+        c_left, c_right = pair_cols
+        dst = c_left + 1
+        if c_right != dst:
+            out[r, dst] = out[r, c_right]
+            out[r, c_right] = 0
+    return out
+
+
