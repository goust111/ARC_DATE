+    seen = {tuple(map(int, coords[0]))}
+    stack = [tuple(map(int, coords[0]))]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors8(r, c, h, w):
+            if mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
