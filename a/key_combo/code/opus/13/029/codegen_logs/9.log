+            grid[:upper_h, left_pad : left_pad + upper_w] = upper
+            grid[upper_h, :] = SEP
+            grid[upper_h + 1 :, :] = lower
+
+            expected = _render_lower_region(lower_h, overall_w, markers, motif)
+            produced = main(grid)
+            if not np.array_equal(produced, expected):
