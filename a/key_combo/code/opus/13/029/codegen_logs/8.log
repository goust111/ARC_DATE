    pattern_idxs = rng.choice(len(_GEN_PATTERNS), size=_GEN_COLOR_PAIR_SIZE, replace=False)
    matched_pattern = _GEN_PATTERNS[int(pattern_idxs[0])]
    odd_pattern = _GEN_PATTERNS[int(pattern_idxs[1])]
