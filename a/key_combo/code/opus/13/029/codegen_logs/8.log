        shared_src_i = int(rng.integers(_GEN_COLOR_PAIR_SIZE))
        shared_dst_i = int(rng.integers(_GEN_COLOR_PAIR_SIZE))
        new_color = int(rng.choice(remaining))
        dst[shared_dst_i] = src[shared_src_i]
        dst[1 - shared_dst_i] = new_color
