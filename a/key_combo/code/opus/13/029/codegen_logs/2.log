+    plans = singles + pairs
+    RNG.shuffle(plans)
+    out: list[tuple[str, ...]] = []
+    used: set[tuple[str, ...]] = set()
+    for plan in plans:
+        visible = orbit_count * len(plan)
+        if 3 <= visible <= 8 and plan not in used:
