+        patch = obj["patch"]
+        ph = patch.shape[0]
+        dest_r0 = 0 if freq[obj["shape_key"]] >= 2 else h - ph
+        region = out[dest_r0 : dest_r0 + ph, c0 : c0 + patch.shape[1]]
+        assert np.all((region == bg) | (patch == bg))
+        region[patch != bg] = patch[patch != bg]
