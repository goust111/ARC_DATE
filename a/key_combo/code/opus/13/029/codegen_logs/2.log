+        ("tr", "bl"), ("tr", "br"), ("bl", "br"),
+    )]
+    plans = singles + pairs
+    RNG.shuffle(plans)
+    out: list[tuple[str, ...]] = []
+    used: set[tuple[str, ...]] = set()
+    for plan in plans:
