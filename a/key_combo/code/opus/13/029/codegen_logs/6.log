+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLOCK = 3
+GREY = 5
+MARK_GREEN = 3
+PALETTE = (1, 2, 4)
+SEPARATOR_CHOICES = (0, 6, 7, 8, 9)
+GEN_RETRY_LIMIT = 400
