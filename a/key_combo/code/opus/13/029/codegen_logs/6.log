+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[tuple[int, list[tuple[int, int]]]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            seen[r, c] = True
+            queue = deque([(r, c)])
+            coords = [(r, c)]
+            while queue:
