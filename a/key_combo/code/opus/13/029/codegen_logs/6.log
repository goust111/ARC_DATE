+        damaged = np.argwhere(diff_counts > 0)
+        if damaged.shape[0] != 1:
+            continue
+
+        dr, dc = map(int, damaged[0])
+        damage_mask = diffs[dr, dc]
+        if not np.any(damage_mask):
+            continue
+        if not np.all(blocks[dr, dc][damage_mask] == 0):
+            continue
+        if not np.all(motif[damage_mask] != 0):
+            continue
+
