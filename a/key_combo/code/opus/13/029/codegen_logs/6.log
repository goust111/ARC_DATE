    diffs = blocks != motif
    diff_counts = diffs.reshape(block_rows, block_cols, block_h * block_w).sum(axis=2)
    damaged_blocks = np.argwhere(diff_counts > 0)
    assert damaged_blocks.shape[0] == 1, "expected exactly one damaged copy of the motif"

