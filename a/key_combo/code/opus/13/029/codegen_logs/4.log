+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _make_candidate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid separator-palette cross example")

