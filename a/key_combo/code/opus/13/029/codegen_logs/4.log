+        out = main(grid)
+    except AssertionError:
+        return None
+    sprite_pixels = int(np.count_nonzero(np.delete(np.delete(grid, cr, axis=0), cc, axis=1)))
+    if int(np.count_nonzero(out)) != sprite_pixels:
+        return None
+    return grid
+
