+def _can_place(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = patch.shape
+    H, W = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
