+    return _sample_solid_shape(area)
+
+
+def _sample_area_plan() -> tuple[list[tuple[int, bool]], bool]:
+    count = random.randint(*OBJECT_COUNT_RANGE)
+    include_hole = random.random() < INCLUDE_HOLE_PROB
+
+    if include_hole:
