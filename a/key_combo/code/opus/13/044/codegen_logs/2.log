+    for r in range(h):
+        for c in (0, w - 1):
+            if patch[r, c] == 0 and not visited[r, c]:
+                visited[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if patch[r, c] == 0 and not visited[r, c]:
+                visited[r, c] = True
