def _sample_solid_shape(area: int) -> set[tuple[int, int]]:
    if area == 8 and random.random() < 0.75:
        choices = [
            {(r, c) for r in range(3) for c in range(3)} - {(0, 1)},
            {(r, c) for r in range(3) for c in range(3)} - {(1, 0)},
