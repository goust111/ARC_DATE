        rows_overlap and (ac1 + GEN_ADJACENCY_GAP == bc0 or bc1 + GEN_ADJACENCY_GAP == ac0)
        or cols_overlap and (ar1 + GEN_ADJACENCY_GAP == br0 or br1 + GEN_ADJACENCY_GAP == ar0)
