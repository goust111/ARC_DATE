+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+PERIOD_CHOICES = ((3, 3), (3, 4), (4, 3), (4, 4))
+PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+
+GRID_MIN = 11
+GRID_MAX = 16
+SEED_COUNT_WEIGHTS = (1, 2, 2, 3, 3)
+MAX_GENERATION_ATTEMPTS = 500
