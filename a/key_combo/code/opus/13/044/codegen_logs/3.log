+def _enumerate_rectangles(shape: tuple[int, int]) -> list[tuple[int, int, int, int]]:
+    h, w = shape
+    rects = []
+    for rh in range(1, 4):
+        for rw in range(1, 5):
+            if rh * rw > 8:
