    return inp if np.array_equal(solved, out) else None


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS_9DEF23FE):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise AssertionError("failed to generate a valid 9def23fe input")

