    return cells


def _route_cells_vertical_then_horizontal(
    start: tuple[int, int], end: tuple[int, int]
) -> list[tuple[int, int]]:
    r0, c0 = start
    r1, c1 = end
    cells: list[tuple[int, int]] = []
    if r0 != r1:
        dr = 1 if r1 > r0 else -1
        for r in range(r0 + dr, r1 + dr, dr):
