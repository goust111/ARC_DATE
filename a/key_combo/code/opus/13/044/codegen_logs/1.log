+    occupied_rooms = sorted(occupied_rooms, key=lambda room: int(room["r0"]))
+    mode_by_slot: dict[str, str] = {}
+    markers: list[tuple[int, int]] = []
+    used_positions: set[tuple[int, int]] = set()
+
+    for room, mode in zip(occupied_rooms, desired):
