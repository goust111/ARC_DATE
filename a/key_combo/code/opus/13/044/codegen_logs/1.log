from __future__ import annotations

import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
PINK = 6
ORANGE = 7

SURVIVOR_COLORS = (RED, YELLOW, PINK, ORANGE)
EXTERIOR_MARKER_COLORS = (GREY, GREEN)
ROOM_SLOT_NAMES = ("top_left", "mid_right", "bottom_left")
GEN_RETRY_LIMIT = 400


def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def _flood_external_non_walls(grid: np.ndarray) -> np.ndarray:
    """Return the boundary-reachable mask when blue is treated as the only wall."""
    h, w = map(int, grid.shape)
    external = np.zeros((h, w), dtype=bool)
    stack: list[tuple[int, int]] = []

    for r in range(h):
        for c in (0, w - 1):
            if int(grid[r, c]) != BLUE and not external[r, c]:
                stack.append((r, c))
    for c in range(w):
        for r in (0, h - 1):
            if int(grid[r, c]) != BLUE and not external[r, c]:
                stack.append((r, c))

    while stack:
        r, c = stack.pop()
        if not _in_bounds((h, w), r, c) or external[r, c] or int(grid[r, c]) == BLUE:
            continue
        external[r, c] = True
        for nr, nc in _neighbors4(r, c):
            stack.append((nr, nc))
    return external


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = map(int, mask.shape)
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            stack = [(r, c)]
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while stack:
                rr, cc = stack.pop()
                coords.append((rr, cc))
                for nr, nc in _neighbors4(rr, cc):
                    if _in_bounds((h, w), nr, nc) and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        stack.append((nr, nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def _route_cells_horizontal_then_vertical(
    start: tuple[int, int], end: tuple[int, int]
) -> list[tuple[int, int]]:
    r0, c0 = start
    r1, c1 = end
    cells: list[tuple[int, int]] = []
    if c0 != c1:
        dc = 1 if c1 > c0 else -1
        for c in range(c0 + dc, c1 + dc, dc):
            cell = (r0, c)
            if cell != end:
                cells.append(cell)
    if r0 != r1:
        dr = 1 if r1 > r0 else -1
        for r in range(r0 + dr, r1 + dr, dr):
            cell = (r, c1)
            if cell != end:
