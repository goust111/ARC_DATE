+            pair = tuple(sorted((start, end)))
+            hv_clear = _route_is_clear(grid, external, _route_cells_horizontal_then_vertical(*pair))
+            vh_clear = _route_is_clear(grid, external, _route_cells_vertical_then_horizontal(*pair))
