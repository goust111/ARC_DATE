+    if room["stub"]:
+        stub_col = int(room["stub_col"])
+        stub_end = int(room["stub_end"])
+        _draw_segment(grid, (r0, stub_col), (stub_end, stub_col), BLUE)
+
+
+def _paint_wall_layout(rooms: list[dict], h: int, w: int) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
