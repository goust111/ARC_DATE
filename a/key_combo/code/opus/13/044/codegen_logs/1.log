+    return coords
+
+
+def _candidate_pairs(grid: np.ndarray, external: np.ndarray, room: dict) -> dict[str, list[tuple[tuple[int, int], tuple[int, int]]]]:
+    coords = _room_accessible_coords(grid, room)
