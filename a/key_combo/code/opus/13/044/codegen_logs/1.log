+
+
+def _room_accessible_coords(grid: np.ndarray, room: dict) -> list[tuple[int, int]]:
+    r0 = int(room["r0"])
+    c0 = int(room["c0"])
+    h = int(room["h"])
+    w = int(room["w"])
+    r1 = r0 + h - 1
