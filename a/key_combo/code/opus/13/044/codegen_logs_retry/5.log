+
+
+def _validate_masks(
+    blue_mask: np.ndarray, red_mask: np.ndarray, rects: list[tuple[int, int, int, int]]
+) -> bool:
+    if not blue_mask.any() or not red_mask.any():
+        return False
+    if np.any(blue_mask & red_mask):
