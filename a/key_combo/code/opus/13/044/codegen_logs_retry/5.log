+    return [cand for cand in candidates if cand[2] >= 1]
+
+
+def _try_add_tail(mask: np.ndarray, occupied: np.ndarray, start: tuple[int, int], step: tuple[int, int], max_len: int) -> bool:
+    h, w = mask.shape
+    cells: list[tuple[int, int]] = []
