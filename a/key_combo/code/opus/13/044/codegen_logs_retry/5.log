    fg_min = _gen_ceil_pct(n_cells, FG_MIN_PCT)
    fg_max = (n_cells * FG_MAX_PCT) // 100
    grey_min = max(GREY_MIN_COUNT, _gen_ceil_pct(n_cells, GREY_MIN_PCT))
    grey_max = (n_cells * GREY_MAX_PCT) // 100

    triples: list[tuple[int, int, int]] = []
