from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/13/044/5.py')
mod = SourceFileLoader('arc_new5_debug', str(p)).load_module()

for i in range(20):
    inp = mod.generate_input()
    out = mod.main(inp)
    h, w2 = inp.shape
    w = w2 // 2
    blue = inp[:, :w] == mod.BLUE
    red = inp[:, w:] == mod.RED
    assert not mod._hole_components(blue)
    assert not mod._hole_components(red)
    holes = mod._hole_components(blue | red)
    assert holes
    assert np.array_equal(out, mod._compose_output(blue, red))
print('debug ok')
