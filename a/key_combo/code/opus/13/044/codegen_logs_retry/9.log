            output[r, c] = color
        layers.append(layer)
    return output, layers, len(taken)


def _grid_size(side: int, count: int, marker_total: int) -> int | None:
    area = side * side
    feasible = [
        s
        for s in GRID_SIDE_OPTIONS
        if s * s - count * area > count * area - marker_total
    ]
    if not feasible:
        return None
    return random.choice(feasible)


