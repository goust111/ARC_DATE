   9: # description:
  10: # In the input, you will see a 10x10 black grid. The grid has one row and one column colored solidly in a single color, forming a cross of that color across the grid. The grid also has H grey pixels in the rightmost column at the top of the grid.
  11: # To create the output, convert the H grey pixels to be black. Then shift the "cross" H pixels to the left and H pixels down.
  12: 
  13: def main(input_grid):
  14:     """
  15:     Move a colored cross left and downward by the gray counter value.
  16: 
  17:     Input structure:
  18:     - The input is a 10x10 black grid with one solid colored row and one solid colored column.
  19:     - The row and column share the same non-black, non-gray color.
  20:     - The top of the rightmost column contains gray pixels that encode the shift amount.
  21: 
  22:     Rule:
  23:     - Count gray pixels in the rightmost column.
  24:     - Find the colored cross row, column, and color.
  25:     - Recreate the cross on black after moving the row down and the column left by that count.
  26: 
  27:     Key insight:
  28:     - The gray pixels are a numeric instruction only; they disappear after determining
  29:       how far to shift the cross.
  30:     """
  31:     # 1. Calculate the shift amount: the number of grey pixels in the rightmost column
  32:     H = int(np.sum(input_grid[:, -1] == Color.GREY))
  33: 
  34:     # 2. find the row and column of the cross, and its color.
  35:     color = next(c for c in np.unique(input_grid) if c not in [Color.BLACK, Color.GREY])
  36: 
  37:     # find which row is fully colored with the color
  38:     r = int(np.where(np.all(input_grid == color, axis=1))[0][0])
  39:     # find which column is fully colored with the color
  40:     c = int(np.where(np.all(input_grid == color, axis=0))[0][0])
  41: 
  42:     # shift the column and row down/left by H
  43:     r += H
  44:     c -= H
  45: 
  46:     # create the output grid by recreating the cross at the new location
  47:     output_grid = np.full(input_grid.shape, Color.BLACK)
  48:     output_grid[r, :] = color
  49:     output_grid[:, c] = color
  50: 
  51:     return output_grid
  52: 
  53: def generate_input():
  54:     # create a 10x10 black grid
  55:     grid = np.full((10, 10), Color.BLACK)
  56: 
  57:     # choose a shift amount H (number of grey pixels in the rightmost column)
  58:     H = int(np.random.randint(1, 5))
  59: 
  60:     # choose a column/row and color for the cross such that shifting by H stays in-bounds
  61:     r = int(np.random.randint(H, 10 - H))
  62:     # avoid the rightmost column (reserved for the grey counter)
  63:     c = int(np.random.randint(H, 9))
  64:     color = int(np.random.choice([c for c in Color.NOT_BLACK if c != Color.GREY]))
  65:     grid[r, :] = color
  66:     grid[:, c] = color
  67: 
  68:     # color the rightmost column's top H pixels grey
  69:     grid[:H, -1] = Color.GREY
  70: 
  71:     return grid
