+    mask = np.zeros_like(grid, dtype=bool)
+    mask[comp[:, 0], comp[:, 1]] = True
+    assert np.any(mask[0]), "catalog should touch the top edge"
+    return mask
+
+
+def _extract_templates(grid: np.ndarray, catalog: np.ndarray) -> list[np.ndarray]:
