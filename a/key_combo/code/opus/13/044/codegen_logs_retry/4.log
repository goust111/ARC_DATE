+    for r0 in range(th - ph + 1):
+        for c0 in range(tw - pw + 1):
+            ok = True
+            for pr_raw, pc_raw in coords:
+                pr = int(pr_raw)
+                pc = int(pc_raw)
+                if int(template[r0 + pr, c0 + pc]) != int(part[pr, pc]):
+                    ok = False
+                    break
+            if ok:
+                offsets.append((r0, c0))
+    return offsets
