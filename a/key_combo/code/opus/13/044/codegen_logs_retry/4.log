+BASE_TEMPLATES = [
+    np.array([[1, 2, 1], [2, 3, 2], [0, 1, 2]], dtype=int),
+    np.array([[1, 1, 2, 0], [0, 2, 3, 3], [1, 0, 2, 0]], dtype=int),
