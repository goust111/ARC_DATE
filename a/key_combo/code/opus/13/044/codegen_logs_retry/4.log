+def _matching_offsets(part: np.ndarray, template: np.ndarray) -> list[tuple[int, int]]:
+    ph, pw = part.shape
+    th, tw = template.shape
+    if ph > th or pw > tw:
+        return []
+    coords = np.argwhere(part != BLACK)
+    if len(coords) == 0:
