+    palette = random.sample(TEMPLATE_COLORS, distinct_colors)
+    if distinct_colors == 2:
+        mapping = {1: palette[0], 2: palette[1], 3: random.choice(palette)}
+    else:
+        mapping = {1: palette[0], 2: palette[1], 3: palette[2]}
