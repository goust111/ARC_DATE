+    total = len(coords)
+    target = random.randint((total + 1) // 2, total - 1)
+    coord_set = set(coords)
+    seed = random.choice(coords)
+    chosen = {seed}
+    frontier = set()
+    for dr, dc in DIR8:
+        nxt = (seed[0] + dr, seed[1] + dc)
+        if nxt in coord_set:
