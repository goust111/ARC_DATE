+            c0, c1 = min(cols), max(cols)
+            if r1 - r0 + 1 != NODE_SIZE or c1 - c0 + 1 != NODE_SIZE:
+                continue
+            if len(comp) != NODE_SIZE * NODE_SIZE:
+                continue
