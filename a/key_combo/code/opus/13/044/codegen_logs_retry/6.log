+        ("B", "C", bc),
+        ("A", "D", 1),
+        ("D", "E", 1),
+        ("E", "F", extra_sum),
+        ("F", "C", 1),
+        ("E", "H", eh),
+        ("H", "I", hi),
+        ("I", "F", inf),
