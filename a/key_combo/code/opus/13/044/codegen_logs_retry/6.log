+        color = RED if name in terminals else BLUE
+        grid[r0 : r0 + NODE_SIZE, c0 : c0 + NODE_SIZE] = color
+        for rr in range(r0, r0 + NODE_SIZE):
+            for cc in range(c0, c0 + NODE_SIZE):
