+        node_path.append(int(cur))
+        edge_id = prev_edge.get(int(cur))
+        if edge_id is not None:
+            edge_path.append(int(edge_id))
+        cur = prev_node.get(int(cur))
+    node_path.reverse()
+    edge_path.reverse()
+    return node_path, edge_path, best[int(goal)]
+
