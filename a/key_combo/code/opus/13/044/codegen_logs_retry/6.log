+    out = g.copy()
+    out[out == GREY] = ORANGE
+
+    node_by_id = {int(node["id"]): node for node in nodes}
+    edge_by_id = {int(edge["id"]): edge for edge in edges}
+    edge_ids = set(map(int, edge_path))
+    terminal_ids = {int(start), int(goal)}
