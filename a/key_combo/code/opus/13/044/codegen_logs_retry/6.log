+def _extract_graph(grid: np.ndarray) -> tuple[list[dict], list[dict], int, int, dict[int, list[tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
+    nodes = _find_nodes(g)
+    pix_to_node: dict[tuple[int, int], int] = {}
+    for node in nodes:
