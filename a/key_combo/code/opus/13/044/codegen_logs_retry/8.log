+        for i in range(len(params))
+        for j in range(len(params))
+        if i != j
+    )
+    shift_smaller_bigger_area = any(
+        shifts[i] < shifts[j] and areas[i] > areas[j]
+        for i in range(len(params))
+        for j in range(len(params))
+        if i != j
