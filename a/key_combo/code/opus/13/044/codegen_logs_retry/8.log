+        for r, c in spec["fill"]:
+            if out[r, c] == BLACK:
+                out[r, c] = RED
+    ordered = sorted(specs, key=lambda spec: (int(spec["area"]), int(spec["color"])))
+    h = inp.shape[0]
+    for i, spec in enumerate(ordered):
+        col = left_w + 1 + 2 * i
+        height = int(spec["area"])
+        out[h - 1 - height : h - 1, col] = int(spec["color"])
+    return out
