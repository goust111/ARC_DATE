+
+def _dominant_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
+def _neighbors4(r: int, c: int) -> list[Coord]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _neighbors8(r: int, c: int) -> list[Coord]:
+    out: list[Coord] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            out.append((r + dr, c + dc))
+    return out
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                r1 = max(r1, rr)
+                c0 = min(c0, cc)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(
+                {
+                    "color": color,
+                    "coords": tuple(sorted(coords)),
+                    "coord_set": set(coords),
+                    "bbox": (r0, c0, r1, c1),
+                    "area": len(coords),
+                }
+            )
+    components.sort(key=lambda comp: comp["bbox"])
+    return components
+
+
+def _classify_objects(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    bg = _dominant_color(g)
+    components = _find_components(g, bg)
+    anchors: list[dict] = []
+    markers: list[dict] = []
+    for comp in components:
+        r0, c0, r1, c1 = comp["bbox"]
+        if comp["area"] == 4 and (r1 - r0 + 1, c1 - c0 + 1) == (2, 2):
+            if comp["coord_set"] == {(r0, c0), (r0, c0 + 1), (r0 + 1, c0), (r0 + 1, c0 + 1)}:
+                anchors.append(comp)
+                continue
+        if comp["area"] == 1:
+            markers.append(comp)
+            continue
+        raise AssertionError("expected only solid 2x2 anchors and isolated marker pixels")
+
+    assert 2 <= len(anchors) <= 4
+    assert len(anchors) == len(markers)
+    assert len({int(comp["color"]) for comp in anchors}) == len(anchors)
+    assert len({int(comp["color"]) for comp in markers}) == len(markers)
