+    rr = int(rng.integers(row_lo, row_hi + 1))
+    cc = int(rng.integers(col_lo, col_hi + 1))
+    return rr, cc, rr + mask_h - 1, cc + mask_w - 1
+
+
+def _build_spec(rng: np.random.Generator) -> dict[str, object]:
