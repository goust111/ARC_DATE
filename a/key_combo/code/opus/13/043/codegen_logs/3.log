+        old_parent = frame["parent"]
+        if old_parent is None:
+            frame["parent"] = None
+        else:
+            parent_bbox = tuple(frames_by_old_index[old_parent]["bbox"])
+            frame["parent"] = index_by_bbox[parent_bbox]
+        frame["children"] = []
+    for i, frame in enumerate(frames):
+        parent = frame["parent"]
+        if parent is not None:
