+
+def _random_mask(rng: np.random.Generator, height: int, width: int) -> np.ndarray:
+    area = height * width
+    while True:
+        mask = rng.integers(0, 2, size=(height, width), dtype=int).astype(bool)
+        count = int(mask.sum())
+        if count < 2 or count > area - 2:
