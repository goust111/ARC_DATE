+import numpy as np
+
+
+FRAME_COLORS = (1, 3, 4, 6)
+MASK_COLOR = 5
+BACKGROUND = 0
+DEPTH_TO_FILL = {0: 2, 1: 1, 2: 4}
+FRAME_COUNT = 3
+SIDES = ("top", "bottom", "left", "right")
+MAX_GENERATION_ATTEMPTS = 400
