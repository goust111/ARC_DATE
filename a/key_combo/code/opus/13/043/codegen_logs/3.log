+                "depth": depth,
+                "color": colors[depth],
+                "bbox": bboxes[depth],
+                "child_bbox": child_bbox,
+                "mask": masks[depth],
+                "mask_bbox": mask_bbox,
+                "side": sides[depth],
+            }
+        )
