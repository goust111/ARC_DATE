+    edge_left = int(rng.integers(1, 4))
+    edge_bottom = int(rng.integers(1, 4))
+    edge_right = int(rng.integers(1, 4))
+    grid_h = outer_h + edge_top + edge_bottom
+    grid_w = outer_w + edge_left + edge_right
+    assert max(grid_h, grid_w) <= 30
