+    grid_w = outer_w + edge_left + edge_right
+    assert max(grid_h, grid_w) <= 30
+
+    bboxes: list[tuple[int, int, int, int]] = [None, None, None]  # type: ignore[assignment]
+    bboxes[0] = (edge_top, edge_left, edge_top + outer_h - 1, edge_left + outer_w - 1)
