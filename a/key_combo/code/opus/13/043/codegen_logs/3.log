+        pr0, pc0, _pr1, _pc1 = bboxes[depth]
+        bboxes[depth + 1] = (
+            pr0 + top,
+            pc0 + left,
+            pr0 + top + child_h - 1,
+            pc0 + left + child_w - 1,
