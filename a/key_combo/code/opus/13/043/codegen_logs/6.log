+        if np.array_equal(solved, grid):
+            return False
+        if solved.shape != grid.shape:
+            return False
+
+        winner_color = int(solved[cross])
+        expected_winner = min(
+            (block_a, block_b),
+            key=lambda block: (
+                _dist2_chebyshev(cross, block["center2"]),
+                block["center2"][0],
+                block["center2"][1],
