+            return False
+        contested = {cell: ids for cell, ids in claims.items() if len(ids) >= 2}
+        if not contested:
+            return False
+        if not any(len(ids) == 1 for ids in claims.values()):
+            return False
+
+        cross = tuple(meta["cross"])
+        if cross not in contested:
+            return False
