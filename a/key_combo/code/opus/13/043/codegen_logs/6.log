+        markers: list[tuple[int, int]] = []
+        for direction in DIAGONALS:
+            marker = _marker_cell(origin, direction)
+            if _in_bounds(g.shape, marker[0], marker[1]) and int(g[marker]) == color:
+                markers.append(marker)
