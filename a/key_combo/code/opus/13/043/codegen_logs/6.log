+def _valid_anchor_steps(
+    shape: tuple[int, int],
+    cross: tuple[int, int],
+    direction: tuple[int, int],
+) -> list[int]:
+    h, w = shape
+    out: list[int] = []
+    dr, dc = direction
+    for steps in range(3, max(h, w)):
+        marker = (cross[0] - steps * dr, cross[1] - steps * dc)
+        origin = (
+            marker[0] + DIR_TO_ORIGIN_OFFSET[direction][0],
+            marker[1] + DIR_TO_ORIGIN_OFFSET[direction][1],
