    h: int,
    w: int,
) -> tuple[range, range] | None:
    min_r = max(-rel_r * scale for rel_r, _ in marker_rel)
    max_r = min(h - scale - rel_r * scale for rel_r, _ in marker_rel)
    min_c = max(-rel_c * scale for _, rel_c in marker_rel)
