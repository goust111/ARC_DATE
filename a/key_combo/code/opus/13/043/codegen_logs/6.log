_GEN_BRACKET_SIZE = 4
_GEN_BRACKET_EDGE = _GEN_BRACKET_SIZE - 1
_GEN_MARKER_POS = (1, 1)
_GEN_MARKER_COLORS = tuple(c for c in _GEN_COLORS if c != _GEN_BRACKET_COLOR)

