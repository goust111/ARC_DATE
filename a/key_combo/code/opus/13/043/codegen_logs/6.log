    src = set(source_rel)
    for mr, mc in marker_rel:
        if not any((mr + dr, mc + dc) in src for dr, dc in NEIGHBORS4):
            return None
    if len(marker_rel) == 2:
        boxes = [(r, c, r, c) for r, c in marker_rel]
        if not _gen_boxes_have_gap(boxes[0], boxes[1], PLACEMENT_GAP):
