_PANEL_COLORS, _PANEL_PRIORITY = (4, 3, 9, 8), (0, 3, 2, 1)  # UL, UR, LL, LR
_COLOR_TO_PANEL = {4: 0, 3: 1, 9: 2, 8: 3}
_COLOR_PRIORITY = {4: 0, 8: 1, 9: 2, 3: 3}
