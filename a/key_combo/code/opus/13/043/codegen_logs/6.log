_GEN_MARKER_SCATTER_COUNT_RANGE = (3, 5)
_GEN_INCLUDE_BRACKET_COLOR_PROB = 0.18
_GEN_MAX_OTHER_COLOR_COUNT = 8

# Generation retry bound.
