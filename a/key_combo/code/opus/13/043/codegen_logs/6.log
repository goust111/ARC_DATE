+        marker = (cross[0] - steps * dr, cross[1] - steps * dc)
+        origin = (
+            marker[0] + DIR_TO_ORIGIN_OFFSET[direction][0],
+            marker[1] + DIR_TO_ORIGIN_OFFSET[direction][1],
+        )
+        if not (1 <= origin[0] <= h - 4 and 1 <= origin[1] <= w - 4):
+            continue
