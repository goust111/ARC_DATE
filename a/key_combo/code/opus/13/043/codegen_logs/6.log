+        blocks.append(_make_block(block_id, color, origin, directions))
+    return blocks
+
+
+def _collect_claims(
+    grid: np.ndarray,
+    blocks: list[dict[str, Any]],
+) -> dict[tuple[int, int], set[int]]:
+    g = np.asarray(grid, dtype=int)
+    claims: dict[tuple[int, int], set[int]] = {}
+    for block in blocks:
