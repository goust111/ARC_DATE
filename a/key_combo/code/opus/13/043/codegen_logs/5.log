+    inner_h = r1 - r0 - 1
+    inner_w = c1 - c0 - 1
+    for _ in range(200):
+        local = _orient_local_shape(_random_connected_shape(inner_h, inner_w, side), side)
+        lh = int(local[:, 0].max()) + 1
+        lw = int(local[:, 1].max()) + 1
