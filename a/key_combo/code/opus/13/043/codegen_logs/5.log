+    out = touch_coords.copy()
+    if side == "left":
+        out[:, 1] = 2 * c0 - out[:, 1]
+    elif side == "right":
+        out[:, 1] = 2 * c1 - out[:, 1]
+    elif side == "top":
+        out[:, 0] = 2 * r0 - out[:, 0]
+    else:
+        out[:, 0] = 2 * r1 - out[:, 0]
+    assert np.all((out[:, 0] > r0) & (out[:, 0] < r1))
+    assert np.all((out[:, 1] > c0) & (out[:, 1] < c1))
+    return _sorted_coords(out)
