+    out = g.copy()
+    for box in frames:
+        color, coords = _extract_sprite(g, box, bg)
+        mid_col = _frame_mid_col(box)
+        ir0, ic0, ir1, ic1 = _frame_interior(box)
+        if _is_symmetric_about_col(coords, mid_col):
+            out[ir0 : ir1 + 1, ic0 : ic1 + 1] = int(color)
+        else:
