+def _sprite_self_mid_col(coords: list[tuple[int, int]]) -> int | None:
+    cols = [int(c) for _r, c in coords]
+    c0, c1 = min(cols), max(cols)
+    if (c1 - c0 + 1) % 2 == 0:
+        return None
+    return (c0 + c1) // 2
