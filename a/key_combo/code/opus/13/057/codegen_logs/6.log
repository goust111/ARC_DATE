+                assert source is None
+                source = {"tile_rc": (tr, tc), "origin": (r0, c0), "tile": tile.copy()}
+            elif has_marker:
+                assert colors <= {BG, MARKER}
+                assert int(np.count_nonzero(tile == MARKER)) == 1
+                markers.append({"tile_rc": (tr, tc), "origin": (r0, c0)})
