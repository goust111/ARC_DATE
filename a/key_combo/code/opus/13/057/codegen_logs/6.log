+def _spans(length: int, separators: list[int]) -> list[tuple[int, int]]:
+    spans = []
+    start = 0
+    for idx in sorted(separators):
+        assert start <= idx - 1
+        spans.append((start, idx - 1))
+        start = idx + 1
+    assert start <= length - 1
+    spans.append((start, length - 1))
+    return spans
