+def _classify_obstacle(r: int, c: int, color: int, copied_orange: set[tuple[int, int]]) -> str:
+    if color == SEPARATOR:
+        return "separator"
+    if color == STAMP:
+        return "orange_copy" if (int(r), int(c)) in copied_orange else "orange_source"
+    if color == PATH:
