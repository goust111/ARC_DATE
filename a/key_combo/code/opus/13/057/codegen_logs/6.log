+        "col_spans": col_spans,
+        "tile_h": tile_h,
+        "tile_w": tile_w,
+        "source": source,
+        "markers": markers,
+    }
+
+
+def _apply_stamp(meta: dict) -> tuple[np.ndarray, set[tuple[int, int]]]:
+    stamped = meta["grid"].copy()
+    source_tile = meta["source"]["tile"]
+    tile_h, tile_w = source_tile.shape
