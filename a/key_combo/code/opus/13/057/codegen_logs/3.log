+        patch = _make_patch(h, w, spec["area"], rng)
+        if patch is None:
+            return None
+        grid[r0 : r1 + 1, c0 : c1 + 1] = patch
+
+    if not _validate(grid, specs):
+        return None
+    return grid
+
