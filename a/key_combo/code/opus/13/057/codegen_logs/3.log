+def _randint(rng: random.Random, lo: int, hi: int) -> int:
+    return int(rng.randint(lo, hi))
+
+
+def _weighted_choice(rng: random.Random, items, weights):
+    total = float(sum(weights))
+    x = rng.random() * total
+    acc = 0.0
+    for item, weight in zip(items, weights):
+        acc += float(weight)
+        if x <= acc:
+            return item
+    return items[-1]
