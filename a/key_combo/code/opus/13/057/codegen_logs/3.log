+    specs = []
+    r = EDGE_MARGIN + extra_rows[0]
+    c = EDGE_MARGIN + extra_cols[0]
+    for idx, (area, (h, w)) in enumerate(zip(areas, dims)):
+        specs.append({"bbox": (r, c, r + h - 1, c + w - 1), "area": area, "dims": (h, w)})
+        r += h
+        c += w
+        if idx + 1 < count:
