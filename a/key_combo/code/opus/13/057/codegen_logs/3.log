+    8: [(2, 4), (4, 2)],
+    9: [(3, 3)],
+    12: [(3, 4), (4, 3)],
+    15: [(3, 5), (5, 3)],
+    16: [(4, 4)],
+    20: [(4, 5), (5, 4)],
+    25: [(5, 5)],
