+EDGE_MARGIN = 1
+MIN_GAP = 1
+GEN_ATTEMPTS = 400
+
+AREA_TO_DIMS = {
+    4: [(2, 2)],
+    6: [(2, 3), (3, 2)],
+    8: [(2, 4), (4, 2)],
+    9: [(3, 3)],
+    12: [(3, 4), (4, 3)],
+    15: [(3, 5), (5, 3)],
+    16: [(4, 4)],
+    20: [(4, 5), (5, 4)],
+    25: [(5, 5)],
