+                        queue.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def find_teal_fragments(grid: np.ndarray) -> list[dict]:
+    out = []
+    for coords in components_mask(grid == TEAL):
