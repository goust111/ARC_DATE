+            rng,
+            (height, width),
+            bboxes,
+            [],
+            (3, 5),
+            (3, 6),
+            predicate=lambda b, control_cols=all_control_cols: all(not (b[1] <= col <= b[3]) for col in control_cols),
+        )
+        if rect is None:
+            return None
+        bboxes.append(rect)
+        filler_rects.append(rect)
+        named_rects[f"filler_{len(filler_rects) - 1}"] = rect
