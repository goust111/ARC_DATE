+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+CONTROL_COLORS = (BLUE, GREEN, TEAL)
+
+_GEN_RETRIES = 400
+_SIDE_MARGIN = 1
+_MIN_RECT_GAP = 1
