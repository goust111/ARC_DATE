spec:
  grid: 8-18 rows x 7-19 cols, background always 0 (black)
  rectangles:
    count: 1-5 solid monochrome axis-aligned rectangles
    height: 3-7
    width: 3-8
    colors: each rectangle has a distinct non-zero color (1-9)
    fill: every cell in bbox is the rectangle's color (fully solid)
  layout:
    no_overlap: rectangles never overlap or touch (min Chebyshev gap >= 2)
    border_padding: at least 1 row/col of bg on all four grid edges [observed]
  transform:
    rule: hollow each rectangle by setting strict interior (excluding 1-cell border) to bg
    output_size: same as input

generation_strategy:
  approach: direct construction (task is simple enough)
  steps:
    1. Pick grid H in [8,18], W in [7,19]
    2. Pick n_rects in [1,5]; choose n_rects distinct non-zero colors
    3. For each rectangle, pick height in [3,7] and width in [3,8]
    4. Place rectangles on the grid with at least 1-cell gap between any pair
       and at least 1-cell margin from grid edges; use rejection or greedy packing
    5. Fill each rectangle's bbox with its color
    6. Output is the input with interior of each rectangle (excluding 1-cell perimeter) set to 0
```
