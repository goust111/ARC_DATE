  "transform": "within each such region, recolor every non-red foreground pixel to yellow; preserve red, bg, and outside pixels"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 14-18 rows x 14-18 cols
  colors:
    background: BLACK
    foreground: one color, not BLACK/RED/YELLOW
    marker: RED (only inside target rectangles)
    output_fill: YELLOW (absent from input)
  scattered_foreground:
    description: random-looking sparse foreground pixels across grid
    density: 0.40-0.48 of all cells are foreground (excluding red)
    components: many small clusters (sizes 1-25), plus a few larger blobs (10-50)
  target_rectangles:
    count: 2-4 per grid
    dimensions: 2-3 rows x 2-7 cols (area 4-21)
    content: every cell is non-black (mix of RED and foreground color)
    red_fraction: 0.38-0.88 of rectangle area
    red_placement: red touches all 4 sides of rectangle (top/bottom/left/right each have >=1 red)
    remaining cells: foreground color (these become YELLOW in output)
    embedding: each rectangle is part of a larger connected foreground region [observed]
    separation: rectangles do not overlap; min gap >=1 row or col between any pair [observed]
  transform:
    within each target rectangle, recolor foreground-color cells to YELLOW
    preserve all RED, BLACK, and foreground pixels outside target rectangles

generation_strategy:
  approach: output-first (build rectangles first, then scatter foreground)
  steps:
    1. Choose grid size (14-18 x 14-18) and foreground color (not BLACK/RED/YELLOW).
    2. Place 2-4 target rectangles (2-3 x 2-7) at non-overlapping positions with gap>=1.
       For each rectangle, fill all cells with RED+fg mix ensuring red touches all 4 sides
       and at least 1 cell is foreground (red fraction 0.38-0.88).
    3. Fill the rest of the grid with random foreground pixels at ~40-48% density.
       Ensure each target rectangle connects (4-connected) to at least one adjacent
       foreground pixel outside it, so it is embedded in a larger foreground blob.
    4. Verify no spurious qualifying rectangles exist outside the intended targets
       (run solver and check only intended cells change). Reject if spurious rects found.
