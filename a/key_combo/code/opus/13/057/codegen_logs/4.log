+def _normalize_pair(color: int, p0: tuple[int, int], p1: tuple[int, int]) -> dict:
+    a, b = sorted((tuple(map(int, p0)), tuple(map(int, p1))), key=lambda p: (p[0], p[1]))
+    return {"color": int(color), "a": a, "b": b}
