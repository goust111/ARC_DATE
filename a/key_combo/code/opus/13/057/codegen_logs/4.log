+def _path_cells(pair: dict, *, corner_mode: str = "target_col") -> list[tuple[int, int]]:
+    ar, ac = pair["a"]
+    br, bc = pair["b"]
+    if ar == br or ac == bc:
+        raise ValueError("each endpoint pair must differ in both row and column")
