+    cells: list[tuple[int, int]] = []
+    if corner_mode == "target_col":
+        step_c = 1 if bc > ac else -1
+        for c in range(ac, bc + step_c, step_c):
+            cells.append((ar, c))
+        for r in range(ar + 1, br + 1):
+            cells.append((r, bc))
+        return cells
+
+    if corner_mode == "target_row":
