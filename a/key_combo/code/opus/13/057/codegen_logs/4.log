+def _base_pairs(shape: tuple[int, int], colors: list[int]) -> list[dict] | None:
+    h, w = shape
+    rows = _sample_spaced_values(1, h - 2, 6, 2)
+    cols = _sample_spaced_values(1, w - 2, 5, 2)
