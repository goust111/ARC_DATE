+    if random.random() < 0.5:
+        mirrored = []
+        for pair in pairs:
+            a = (pair["a"][0], w - 1 - pair["a"][1])
+            b = (pair["b"][0], w - 1 - pair["b"][1])
+            mirrored.append(_normalize_pair(pair["color"], a, b))
+        pairs = mirrored
+    return pairs
