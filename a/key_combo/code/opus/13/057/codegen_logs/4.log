+    br, bc = pair["b"]
+    return {
+        "color": int(pair["color"]),
+        "a": tuple(map(int, pair["a"])),
+        "b": tuple(map(int, pair["b"])),
+        "length": int(abs(br - ar) + abs(bc - ac)),
