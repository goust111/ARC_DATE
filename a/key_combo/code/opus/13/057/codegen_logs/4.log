+    endpoint_set = {pair["a"] for pair in pairs} | {pair["b"] for pair in pairs}
+    length_targets = [path["length"] for path in base_paths]
+    target_cols = [pair["a"][1] for pair in pairs] + [pair["b"][1] for pair in pairs]
