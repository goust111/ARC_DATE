+
+def _path_info(pair: dict, *, corner_mode: str = "target_col") -> dict:
+    cells = _path_cells(pair, corner_mode=corner_mode)
+    ar, ac = pair["a"]
+    br, bc = pair["b"]
+    return {
+        "color": int(pair["color"]),
+        "a": tuple(map(int, pair["a"])),
+        "b": tuple(map(int, pair["b"])),
+        "length": int(abs(br - ar) + abs(bc - ac)),
+        "cells": cells,
+        "cellset": set(cells),
+    }
