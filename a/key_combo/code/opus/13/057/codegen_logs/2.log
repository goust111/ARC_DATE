+    fg_labels, fg_count = label_mask(g != bg)
+    comps = []
+    for comp_id in range(1, fg_count + 1):
+        coords = component_coords(fg_labels, comp_id)
+        adj_regions = set()
+        for r, c in coords:
+            rr = int(r)
+            cc = int(c)
+            for nr, nc in neighbors4(rr, cc):
