+    h = rng.randint(9, 12)
+    w = rng.randint(9, 13)
+    grid = np.zeros((h, w), dtype=int)
+
+    stem_col = rng.randint(2, min(3, w - 5))
+    branch_row = rng.randint(2, h - 3)
