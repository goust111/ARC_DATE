+        ghost[int(bar["row"]), sep_col + 1 :] = int(bar["color"])
+    return ghost
+
+
+def _cast_ray(
+    grid: np.ndarray,
+    ghost: np.ndarray,
+    sep_col: int,
+    row: int,
+    col: int,
+    dr: int,
+    dc: int,
+) -> tuple[int, int, int] | None:
