+def _extract_bars(grid: np.ndarray, sep_col: int) -> list[dict]:
+    bars: list[dict] = []
+    for r in range(grid.shape[0]):
+        runs = []
+        c = 0
+        while c < sep_col:
+            value = int(grid[r, c])
+            if value in (BG, SEP, CTRL):
+                c += 1
+                continue
+            c0 = c
+            while c < sep_col and int(grid[r, c]) == value:
+                c += 1
