+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    sep_col = _find_separator(g)
+    bars = _extract_bars(g, sep_col)
+    assert 2 <= len(bars) <= 3
+    return _render_with_rules(g, bars, sep_col)
