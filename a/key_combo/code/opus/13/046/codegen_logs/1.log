 308: def paste(
 309:     dst: np.ndarray,
 310:     patch: np.ndarray,
 311:     r0: int,
 312:     c0: int,
 313:     *,
 314:     transparent: int | None = None,
 315:     mask: np.ndarray | None = None,
 316:     overwrite: bool = True,
 317:     clip: bool = False,
 318: ) -> np.ndarray:
 319:     """
 320:     Paste `patch` into `dst` at top-left (r0,c0).
 321: 
 322:     This is the ONE placement primitive solver examples should use.
 323: 
 324:     - Opaque paste: `paste(dst, patch, r0, c0)`
 325:     - Transparent overlay: `paste(dst, patch, r0, c0, transparent=bg)`
 326:     - Masked paste: `paste(dst, patch, r0, c0, mask=m)`
 327:     - Non-overwriting overlay: `paste(dst, patch, r0, c0, transparent=bg, overwrite=False)`
 328:     - Strict vs clip: default `clip=False` (fail fast); set `clip=True` to clip out-of-bounds.
 329:     """
 330:     H, W = dst.shape
 331:     r0 = int(r0)
 332:     c0 = int(c0)
 333:     h, w = map(int, patch.shape)
 334: 
 335:     if not clip:
 336:         if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
 337:             raise ValueError("paste: patch out of bounds (set clip=True to allow clipping)")
 338:         rr0, cc0 = r0, c0
 339:         rr1, cc1 = r0 + h, c0 + w
 340:         pr0, pc0 = 0, 0
 341:     else:
 342:         rr0 = max(0, r0)
 343:         cc0 = max(0, c0)
