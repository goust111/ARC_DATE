+
+
+def _compress_rows(grid: np.ndarray) -> np.ndarray:
+    keep = [0]
+    keep.extend(r for r in range(1, grid.shape[0]) if bool(np.any(grid[r] != BLACK)))
+    return grid[np.asarray(keep, dtype=int), :].copy()
