+    assert MIN_CONTROLS <= len(controls) <= MAX_CONTROLS
+    assert len({c for c, _ in controls}) == len(controls)
+    assert all(color in CONTROL_COLORS for _, color in controls)
+    assert not np.any((grid[1:, :] != BLACK) & (grid[1:, :] != GREY))
