+    if total_h > GRID_H_CAP:
+        return None
+    return tops, total_h
+
+
+def _special_side_options(control_cols: list[int], rect_span: tuple[int, int], idx: int) -> list[tuple[str, int]]:
+    c0, c1 = rect_span
