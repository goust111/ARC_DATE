+    return True
+
+
+def _place_noise_component(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    if not _can_place_noise(grid, cells):
+        return False
+    for r, c in cells:
+        grid[r, c] = GREY
+    return True
+
+
+def _rows_occupied_by_rects(rects: list[dict]) -> set[int]:
+    rows: set[int] = set()
+    for rect in rects:
