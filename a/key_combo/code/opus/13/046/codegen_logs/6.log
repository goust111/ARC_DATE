    if rng is None:
        rng = np.random.default_rng()

    layout = _gen_design_layout(rng)
    if layout is None:
        return None
    count, rows, cols, rects = layout

    out = np.full((rows, cols), _GEN_WALL, dtype=int)
    inp = out.copy()
