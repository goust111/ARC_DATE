+RECT_WIDTH_RANGE = (5, 8)
+EDGE_PAD = 1
+MIN_RECT_GAP = 2
+GAP_REPAIRED_LEN = 3
+UNREPAIRED_GAP_LEN_RANGE = (1, 3)
+DISTRACTOR_PAIR_RANGE = (1, 2)
+RECT_PLACEMENT_TRIES = 400
+PAIR_PLACEMENT_TRIES = 300
+GENERATE_RETRIES = 400
