spec:
  grid: 8-19 rows x 9-21 cols, black background
  markers:
    color: blue (1)
    count: 7-19, density ~5-13% of grid cells
    isolated: 1-4 markers not sharing any row or col with another marker [observed]
  connections:
    rule: for each row/col with >=2 blue markers, paint teal (8) on all black cells strictly between consecutive markers (sorted order)
    rows_with_connections: 1-5
    cols_with_connections: 1-5
    both_axes_present: always true [observed]
    markers_per_line: typically 2, up to 4
    segment_length: 1-13 cells (gap between consecutive markers minus endpoints)
    total_segments: 3-12
