+
+    rect_gap_cells = set()
+    for meta in rect_meta:
+        rect_gap_cells |= meta["gap_cells"]
+
+    for pair in distractor_pairs:
+        (r0, c0), (r1, c1) = pair["endpoints"]
+        if r0 == r1:
+            segment = {(r0, c) for c in range(min(c0, c1), max(c0, c1) + 1)}
+        else:
