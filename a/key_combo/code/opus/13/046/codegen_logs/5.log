+
+def _forbidden_for_distractors(shape: tuple[int, int], rects: list[tuple[int, int, int, int]]) -> np.ndarray:
+    h, w = shape
+    forbidden = np.zeros((h, w), dtype=bool)
+    for r0, c0, r1, c1 in rects:
