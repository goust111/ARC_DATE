+        return False
+    if any(count > 2 for count in col_counts.values()):
+        return False
+    for r, c in coords:
+        participates = 0
+        if row_counts[r] == 2:
+            participates += 1
+        if col_counts[c] == 2:
+            participates += 1
+        if participates != 1:
+            return False
+    return True
