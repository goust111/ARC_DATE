+                grid[r_a, c_a] = RED
+                grid[r_b, c_b] = RED
+                repaired_cells.update({(r_a, c_a), (r_b, c_b)})
+                pairs.append(
+                    {
+                        "kind": "repair",
+                        "orientation": "h" if r_a == r_b else "v",
+                        "endpoints": ((r_a, c_a), (r_b, c_b)),
