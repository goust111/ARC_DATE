+        lo = c0 + 1
+        hi = c1 - length
+    else:
+        lo = r0 + 1
+        hi = r1 - length
+    if lo > hi:
+        return []
+    return list(range(lo, hi + 1))
+
+
+def _draw_connections(grid: np.ndarray) -> np.ndarray:
