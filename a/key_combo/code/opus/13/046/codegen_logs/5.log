+        if valid:
+            used_pair_rows.clear()
+            used_pair_rows.update(tmp_pair_rows)
+            used_pair_cols.clear()
+            used_pair_cols.update(tmp_pair_cols)
+            used_red_rows.clear()
+            used_red_rows.update(tmp_red_rows)
+            used_red_cols.clear()
+            used_red_cols.update(tmp_red_cols)
