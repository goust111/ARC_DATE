+
+
+def _black_components(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or g[r, c] != BLACK:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            touches_border = False
