+        valid = True
+        tmp_pair_rows = set(used_pair_rows)
+        tmp_pair_cols = set(used_pair_cols)
+        tmp_red_rows = set(used_red_rows)
+        tmp_red_cols = set(used_red_cols)
+
+        kinds = plan[:]
+        random.shuffle(kinds)
