+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            touches_border = False
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] == BLACK:
