+                    ok = False
+                    break
+                r0 = random.randint(EDGE_PAD, h - rh - EDGE_PAD)
+                c0 = random.randint(EDGE_PAD, w - rw - EDGE_PAD)
+                rect = (r0, c0, r0 + rh - 1, c0 + rw - 1)
+                if all(_rect_separated(rect, other) for other in rects):
+                    rects.append(rect)
+                    placed = True
+                    break
+            if not ok or not placed:
+                ok = False
