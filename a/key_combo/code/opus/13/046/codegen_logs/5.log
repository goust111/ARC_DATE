  "src": "unique least-frequent marker color pixels embedded in mostly solid rectangular color regions",
  "transform": "count markers by surrounding region color and replace the grid with the color of the region containing the most markers",
  "grid_shape": "1x1 label cell"
}
</annotation>
<generation_spec>
