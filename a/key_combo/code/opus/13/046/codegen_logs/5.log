+def _add_horizontal_pair(
+    pair_row: int,
+    c0: int,
+    c1: int,
+    used_pair_rows: set[int],
+    used_pair_cols: set[int],
+    used_red_rows: set[int],
+    used_red_cols: set[int],
+) -> bool:
