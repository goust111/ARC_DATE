+    connected = _draw_connections(np.asarray(grid, dtype=int))
+    out = connected.copy()
+    for comp in _black_components(connected):
+        if not comp["touches_border"]:
+            for r, c in comp["cells"]:
+                out[r, c] = YELLOW
+    return out
