+            if b > a + 1:
+                segment = out[r, a + 1 : b]
+                segment[segment == BLACK] = TEAL
+
+    for c in range(w):
+        rows = np.flatnonzero(out[:, c] == RED)
+        if len(rows) == 2:
+            a, b = map(int, rows)
+            if b > a + 1:
+                segment = out[a + 1 : b, c]
+                segment[segment == BLACK] = TEAL
+
