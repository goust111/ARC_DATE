+
+    for c in range(w):
+        rows = np.flatnonzero(out[:, c] == RED)
+        if len(rows) == 2:
+            a, b = map(int, rows)
+            if b > a + 1:
+                segment = out[a + 1 : b, c]
+                segment[segment == BLACK] = TEAL
+
+    return out
+
+
+def _black_components(grid: np.ndarray) -> list[dict]:
