+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or g[r, c] != YELLOW:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] == YELLOW:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(cells)
+    return comps
