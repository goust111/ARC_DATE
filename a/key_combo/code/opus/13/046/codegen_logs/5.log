+            participates += 1
+        if col_counts[c] == 2:
+            participates += 1
+        if participates != 1:
+            return False
+    return all(count in (0, 2) for count in row_counts.values() if count) and all(
+        count in (0, 2) for count in col_counts.values() if count not in (0, 1)
