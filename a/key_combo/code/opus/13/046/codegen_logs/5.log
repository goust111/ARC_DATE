+            if repaired:
+                length = GAP_REPAIRED_LEN
+            else:
+                max_len = 3
+                if side in ("top", "bottom"):
+                    max_len = min(max_len, rect[3] - rect[1] - 1)
+                else:
+                    max_len = min(max_len, rect[2] - rect[0] - 1)
+                if max_len < 1:
