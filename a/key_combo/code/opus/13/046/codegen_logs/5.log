+def _rect_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], pad: int = MIN_RECT_GAP) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + pad < br0 or br1 + pad < ar0 or ac1 + pad < bc0 or bc1 + pad < ac0
