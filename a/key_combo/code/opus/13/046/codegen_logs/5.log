+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+TEAL = 8
+
+GRID_RANGE_BY_RECT_COUNT = {
+    2: ((14, 18), (14, 18)),
+    3: ((16, 20), (16, 20)),
+    4: ((18, 22), (18, 22)),
+}
