+                    break
+                length = random.randint(1, max_len)
+
+            starts = _interval_options(rect, side, length)
+            random.shuffle(starts)
+            picked = None
+            for start in starts:
+                cells = _gap_cells(rect, side, start, length)
+                if repaired:
+                    first = cells[0]
+                    last = cells[-1]
