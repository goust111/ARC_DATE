+
+def _yellow_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or g[r, c] != YELLOW:
