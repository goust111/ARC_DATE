+                            first[0],
+                            last[0],
+                            tmp_pair_rows,
+                            tmp_pair_cols,
+                            tmp_red_rows,
+                            tmp_red_cols,
+                        ):
+                            continue
+                picked = {
+                    "side": side,
+                    "cells": cells,
+                    "repaired": repaired,
