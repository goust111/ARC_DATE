+
+def _analyze(grid: np.ndarray) -> dict[str, object]:
+    frames = _find_frames(grid)
+    path_grid, paths = _simulate_paths(grid)
+    frame_infos: list[dict[str, object]] = []
+    for frame in frames:
+        gap = (frame["gap_r"], frame["gap_c"])
+        blocked = int(path_grid[gap]) == RED
