+    shifts = target_c - start_c
+    if shifts < 0:
+        return None
+    rows = _plan_shift_rows(shape[0], target_row, shifts, reserved_rows=reserved_rows)
+    if rows is None:
+        return None
+    frame_block = _cells_adjacent_to_boxes(shape, [_frame_bbox(f) for f in frames])
+    cur_c = start_c
