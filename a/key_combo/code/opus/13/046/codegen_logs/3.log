+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _connected_components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _find_frames(grid: np.ndarray) -> list[dict[str, int]]:
+    frames: list[dict[str, int]] = []
+    for comp in _connected_components(grid == BLUE):
+        r0, c0, r1, c1 = _bbox(comp)
+        if r1 - r0 + 1 < FRAME_MIN_OUTER or c1 - c0 + 1 < FRAME_MIN_OUTER:
+            continue
+
+        missing: list[tuple[int, int]] = []
+        valid = True
+        for r in range(r0, r1 + 1):
+            for c in range(c0, c1 + 1):
+                on_border = r in (r0, r1) or c in (c0, c1)
+                if on_border:
+                    if grid[r, c] != BLUE:
+                        missing.append((r, c))
+                elif grid[r, c] != BLACK:
+                    valid = False
+                    break
+            if not valid:
+                break
+        if not valid or len(missing) != 1:
+            continue
+
+        gap_r, gap_c = missing[0]
+        if gap_r != r1 or not (c0 < gap_c < c1):
+            continue
+
+        border_area = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4 - 1
+        if len(comp) != border_area:
+            continue
+
+        frames.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "gap_r": gap_r,
+                "gap_c": gap_c,
+            }
+        )
+    frames.sort(key=lambda f: (f["r0"], f["c0"], f["r1"], f["c1"]))
+    return frames
+
