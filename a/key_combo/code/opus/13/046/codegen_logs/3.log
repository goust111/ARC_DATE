+def _trace_single_path(grid: np.ndarray, start_c: int) -> dict[str, object]:
+    h, w = grid.shape
+    r = h - 1
+    c = int(start_c)
+    coords = [(r, c)]
+    detours: list[dict[str, object]] = []
+
+    while True:
+        if r == 0:
+            break
+        above = int(grid[r - 1, c])
+        if above in (BLUE, GREY):
+            if c + 1 >= w or int(grid[r, c + 1]) in (BLUE, GREY):
