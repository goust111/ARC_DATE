+def _draw_frame(grid: np.ndarray, frame: dict[str, int]) -> None:
+    r0, c0, r1, c1 = frame["r0"], frame["c0"], frame["r1"], frame["c1"]
+    grid[r0, c0 : c1 + 1] = BLUE
+    grid[r1, c0 : c1 + 1] = BLUE
+    grid[r0 : r1 + 1, c0] = BLUE
