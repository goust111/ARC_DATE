+        gap_r, gap_c = missing[0]
+        if gap_r != r1 or not (c0 < gap_c < c1):
+            continue
+
+        border_area = 2 * ((r1 - r0 + 1) + (c1 - c0 + 1)) - 4 - 1
+        if len(comp) != border_area:
+            continue
