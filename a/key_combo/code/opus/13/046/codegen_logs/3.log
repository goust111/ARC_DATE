+def _random_frame(
+    h: int,
+    w: int,
+    others: list[tuple[int, int, int, int]],
+    row_range: tuple[int, int],
+    col_range: tuple[int, int],
+) -> dict[str, int] | None:
+    for _ in range(60):
+        fh = random.randint(5, 7)
+        fw = random.randint(5, 8)
