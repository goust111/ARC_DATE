+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+TEAL = 8
+
+FRAME_MIN_INNER = 3
+FRAME_MIN_OUTER = FRAME_MIN_INNER + 2
+GEN_ATTEMPTS = 400
