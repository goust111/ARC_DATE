+def _cells_adjacent_to_boxes(shape: tuple[int, int], boxes: list[tuple[int, int, int, int]]) -> set[tuple[int, int]]:
+    h, w = shape
+    blocked: set[tuple[int, int]] = set()
+    for r0, c0, r1, c1 in boxes:
+        for r in range(r0 - 1, r1 + 2):
