def build(n):
    rid=np.zeros((n,n),int)
    for reg,size in [(1,n-2),(2,n-4),(3,n-8)]:
        a=(n-size)//2; b=a+size
        rid[a:b,a:b]=reg
    return rid

def orbit(n,r,c):
    return frozenset([(r,c),(r,n-1-c),(n-1-r,c),(n-1-r,n-1-c)])

def valid_candidates(n):
    rid=build(n); mid=n//2
    out=[]; seen=set()
