+def _build_role_grid(n: int) -> np.ndarray:
+    grid = np.zeros((n, n), dtype=int)
+    for role, size in ((ROLE_OUTER, n - 2), (ROLE_MIDDLE, n - 4), (ROLE_INNER, n - 8)):
+        start = (n - size) // 2
+        stop = start + size
+        grid[start:stop, start:stop] = role
+    return grid
+
