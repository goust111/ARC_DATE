+
+                    key = (
+                        rect,
+                        tuple(orbit["rep"] for orbit in inner_case["subset"]),
+                        tuple(orbit["rep"] for orbit in middle_case["subset"]),
+                        target,
+                    )
+                    if key in seen:
+                        continue
+                    seen.add(key)
+                    score = inner_case["hidden"] * 10 + inner_case["full"] + middle_case["full"]
+                    scored.append(
+                        (
+                            score,
+                            {
+                                "n": n,
+                                "branch": branch,
+                                "rect": rect,
+                                "target": target,
+                                "final_role": ROLE_INNER,
+                                "visible_role": ROLE_MIDDLE,
+                                "inner_subset": inner_case["subset"],
+                                "middle_subset": middle_case["subset"],
+                            },
+                        )
+                    )
+        else:
+            for middle_case in hidden_middle:
+                for inner_case in clear_inner:
+                    if not _subsets_compatible(inner_case["subset"], middle_case["subset"]):
+                        continue
+                    if inner_case["visible"] <= middle_case["visible"]:
+                        continue
+                    if middle_case["full"] <= inner_case["full"]:
+                        continue
+
+                    key = (
+                        rect,
+                        tuple(orbit["rep"] for orbit in inner_case["subset"]),
+                        tuple(orbit["rep"] for orbit in middle_case["subset"]),
+                        target,
+                    )
+                    if key in seen:
+                        continue
+                    seen.add(key)
+                    score = middle_case["hidden"] * 10 + inner_case["full"] + middle_case["full"]
+                    scored.append(
+                        (
+                            score,
+                            {
+                                "n": n,
+                                "branch": branch,
+                                "rect": rect,
+                                "target": target,
+                                "final_role": ROLE_MIDDLE,
+                                "visible_role": ROLE_INNER,
+                                "inner_subset": inner_case["subset"],
+                                "middle_subset": middle_case["subset"],
+                            },
+                        )
+                    )
+
+    scored.sort(key=lambda item: item[0], reverse=True)
+    return [scenario for _score, scenario in scored[:limit]]
+
+
+def _build_scenario_pool() -> list[dict]:
+    pool: list[dict] = []
+    for branch in ("horizontal", "vertical"):
+        pool.extend(_collect_scenarios_for_case(13, branch, "inner_tie", 4))
+        pool.extend(_collect_scenarios_for_case(13, branch, "middle_strict", 4))
+        pool.extend(_collect_scenarios_for_case(15, branch, "inner_tie", 4))
+        pool.extend(_collect_scenarios_for_case(15, branch, "inner_strict", 4))
+        pool.extend(_collect_scenarios_for_case(15, branch, "middle_strict", 4))
