+def _recover(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    n, m = map(int, g.shape)
+    assert n == m, "expected a square grid"
+    r0, c0, r1, c1 = _yellow_bbox(g)
