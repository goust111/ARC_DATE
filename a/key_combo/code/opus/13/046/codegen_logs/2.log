import itertools, numpy as np

def build(n):
    rid=np.zeros((n,n),int)
    outer=n-2; middle=n-4; inner=n-8
    for reg,size in [(1,outer),(2,middle),(3,inner)]:
        r0=(n-size)//2; r1=r0+size
        rid[r0:r1,r0:r1]=reg
    return rid

def orbit(n,r,c):
    return frozenset([(r,c),(r,n-1-c),(n-1-r,c),(n-1-r,n-1-c)])

def valid_candidates(n):
    rid=build(n); mid=n//2
    out=[]
    seen=set()
    for r in range(1,mid):
      for c in range(1,mid):
        o=orbit(n,r,c)
        if o in seen or len(o)"'!=4: continue
        seen.add(o)
        regs={rid[x,y] for x,y in o}
        if len(regs)!=1 or 0 in regs: continue
        reg=next(iter(regs))
        ok=True
        for x,y in o:
          counts={1:0,2:0,3:0}
          for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            xx,yy=x+dr,y+dc
            if 0<=xx<n and 0<=yy<n and rid[xx,yy] in counts:
              counts[rid[xx,yy]]+=1
          arr=sorted(counts.items(), key=lambda kv: kv[1], reverse=True)
          if arr[0][0]!=reg or arr[0][1]<=arr[1][1]: ok=False
        if ok:
          out.append({'"'reg':reg,'cells':o,'rep':(r,c)})
    return out

def rects(n, branch):
    mid=n//2
    vals=[]
    # inside colored square rows/cols 1..n-2
    for h in range(3,6):
      for w in range(3,6):
        for r0 in range(1,n-1-h+1):
          r1=r0+h-1
          for c0 in range(1,n-1-w+1):
            c1=c0+w-1
            if branch=='h':
              if not (r0<=mid<=r1): continue
              if c0<=mid<=c1: continue
            else:
              if not (c0<=mid<=c1): continue
              if r0<=mid<=r1: continue
            vals.append((r0,c0,r1,c1))
    return vals

def hidden(rect, orb):
    r0,c0,r1,c1=rect
    return sum(r0<=r<=r1 and c0<=c<=c1 for r,c in orb)

def conflict(a,b):
    ca=a['cells']; cb=b['cells']
    for r,c in ca:
      for rr,cc in cb:
        if abs(r-rr)+abs(c-cc)<=1:
          return True
    return False

def independent(items):
    for a,b in itertools.combinations(items,2):
      if conflict(a,b): return False
    return True

for n in [13,15]:
  cands=valid_candidates(n)
  by={1:[],2:[],3:[]}
  for c in cands: by[c['reg']].append(c)
  print('N',n,'cand lens', {k:len(v) for k,v in by.items()})
  for branch in ['h','v']:
    found=False
    for rect in rects(n,branch):
      inner_h=[c for c in by[3] if hidden(rect,c['cells'])==2]
      inner_v=[c for c in by[3] if hidden(rect,c['cells'])==0]
      mid_h=[c for c in by[2] if hidden(rect,c['cells'])==2]
      mid_v=[c for c in by[2] if hidden(rect,c['cells'])==0]
      # tie inner: 2 hidden inner + 2 visible middle
      for ii in itertools.combinations(inner_h,2):
        if not independent(ii): continue
        for mm in itertools.combinations(mid_v,2):
          if independent(mm+ii):
            print('tie inner',n,branch,rect,[x['rep'] for x in ii],[x['rep'] for x in mm])
            found=True; raise SystemExit
    print('no found for branch',branch)
