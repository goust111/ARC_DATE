+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+REGION_COLORS = (BLUE, RED, GREEN)
+ROLE_OUTER = 1
+ROLE_MIDDLE = 2
+ROLE_INNER = 3
+
+GRID_SIZES = (13, 15)
+RECT_DIMS = (3, 4, 5)
+MAX_GENERATION_ATTEMPTS = 300
