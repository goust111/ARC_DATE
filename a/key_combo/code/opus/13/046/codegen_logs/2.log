import itertools, numpy as np

def build(n):
    mid=n//2
    rid=np.zeros((n,n),int)
    colors=np.zeros((n,n),int)
    outer=n-2; middle=n-4; inner=n-8
    r0=(n-outer)//2; r1=r0+outer
    rid[r0:r1,r0:r1]=1
    r0=(n-middle)//2; r1=r0+middle
    rid[r0:r1,r0:r1]=2
    r0=(n-inner)//2; r1=r0+inner
    rid[r0:r1,r0:r1]=3
    return rid

def orbit(n,r,c):
    return {(r,c),(r,n-1-c),(n-1-r,c),(n-1-r,n-1-c)}

def good(rid, orb):
    vals={rid[r,c] for r,c in orb}
    if len(vals)"'!=1 or 0 in vals or len(orb)!=4: return False
    reg=vals.pop()
