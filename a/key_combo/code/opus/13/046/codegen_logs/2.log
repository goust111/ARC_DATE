+def _orbit_cells(n: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    cells = {
+        (r, c),
+        (r, n - 1 - c),
+        (n - 1 - r, c),
+        (n - 1 - r, n - 1 - c),
+    }
+    return tuple(sorted(cells))
+
+
+def _candidate_orbits(n: int) -> list[dict]:
+    role_grid = _build_role_grid(n)
