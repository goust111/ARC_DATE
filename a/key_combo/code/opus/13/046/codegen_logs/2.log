+def _validate_generated(grid: np.ndarray, clean: np.ndarray, scenario: dict, role_colors: dict[int, int]) -> bool:
+    rect = scenario["rect"]
+    r0, c0, r1, c1 = rect
+
+    hidden_marker_count = int(np.sum((clean == GREY) & (grid == YELLOW)))
+    if hidden_marker_count <= 0:
+        return False
