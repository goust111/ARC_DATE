+                        tuple(orbit["rep"] for orbit in middle_case["subset"]),
+                        target,
+                    )
+                    if key in seen:
+                        continue
+                    seen.add(key)
+                    score = middle_case["hidden"] * 10 + inner_case["full"] + middle_case["full"]
+                    scored.append(
+                        (
+                            score,
+                            {
