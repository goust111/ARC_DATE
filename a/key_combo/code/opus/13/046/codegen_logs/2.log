+
+_ROLE_GRID_CACHE = {n: _build_role_grid(n) for n in GRID_SIZES}
+_ORBIT_CACHE = {n: _candidate_orbits(n) for n in GRID_SIZES}
+_ORBIT_BY_REP = {n: {orbit["rep"]: orbit for orbit in _ORBIT_CACHE[n]} for n in GRID_SIZES}
+_SUBSET_CACHE = {
