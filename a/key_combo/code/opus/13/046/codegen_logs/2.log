            if 0<=xx<n and 0<=yy<n and rid[xx,yy] in counts:
              counts[rid[xx,yy]]+=1
          vals=sorted(counts.values(), reverse=True)
          if counts[reg]!=vals[0] or vals[0]==vals[1]: ok=False
        if ok:
          out.append({'"'reg':reg,'cells':o,'rep':(r,c)})
    return out

def rects(n, branch):
    mid=n//2
    vals=[]
    for h in range(3,6):
