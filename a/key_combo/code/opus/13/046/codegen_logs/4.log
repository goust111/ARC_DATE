+    frame_comps = _extract_components(g == FRAME_COLOR)
+    assert frame_comps, "expected a grey frame"
+    max_area = max(comp["area"] for comp in frame_comps)
+    frame_candidates = [comp for comp in frame_comps if comp["area"] == max_area]
