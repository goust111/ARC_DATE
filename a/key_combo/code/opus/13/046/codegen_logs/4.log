+    quadrant_origins = [
+        (pad_top, pad_left, cell_h_top, cell_w_left, tl),
+        (pad_top, pad_left + cell_w_left + gap_w, cell_h_top, cell_w_right, tr),
+        (pad_top + cell_h_top + gap_h, pad_left, cell_h_bottom, cell_w_left, bl),
