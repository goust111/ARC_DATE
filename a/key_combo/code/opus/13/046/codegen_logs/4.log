from itertools import product
import numpy as np

def neighbors4(r,c):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        yield r+dr,c+dc

def comps(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    cnt=0
    for r in range(h):
      for c in range(w):
        if mask[r,c] and not seen[r,c]:
          cnt+=1
          st=[(r,c)]; seen[r,c]=1
          while st:
            cr,cc=st.pop()
            for nr,nc in neighbors4(cr,cc):
              if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                seen[nr,nc]=1; st.append((nr,nc))
    return cnt

def rot(mask,k):
    return np.rot90(mask,-k)

def key(mask):
    return (mask.shape, mask.astype(np.uint8).tobytes())

def ok(h,w):
  total=0
  for bits in range(1<<(h*w)):
    area=bits.bit_count()
    if not (4<=area<=6):
      continue
    mask=np.zeros((h,w),dtype=bool)
    for idx in range(h*w):
      if bits>>idx &1:
        mask[idx//w, idx%w]=1
    coords=np.argwhere(mask)
    if len(coords)==0: continue
    r0,c0=coords.min(axis=0); r1,c1=coords.max(axis=0)
    if (r0,c0,r1,c1)"'!=(0,0,h-1,w-1):
      continue
    if comps(mask)!=1: continue
    if len({key(rot(mask,k)) for k in range(4)})!=4: continue
    total+=1
  return total

for dims in [(3,4),(3,5),(4,5),(3,6),(4,4),(5,4)]:
  print(dims, ok(*dims))
