+    assert np.all(frame_box[0, :] == FRAME_COLOR)
+    assert np.all(frame_box[-1, :] == FRAME_COLOR)
+    assert np.all(frame_box[:, 0] == FRAME_COLOR)
+    assert np.all(frame_box[:, -1] == FRAME_COLOR)
+
+    holes = _extract_components(frame_box == BG)
+    assert len(holes) == 4, "expected four holes inside the frame"
+    for hole in holes:
