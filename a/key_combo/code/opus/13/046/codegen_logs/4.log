        counts[r, c] += 1
        made += 1
        if made == target:
            return True
    return False


def _gen_render_output(shape, sprite, row_starts, col_starts):
    out = np.zeros(shape, dtype=int)
    slot_h, slot_w = sprite.shape
    for r0 in row_starts:
        for c0 in col_starts:
            out[r0 : r0 + slot_h, c0 : c0 + slot_w] = sprite
    return out


def _gen_attempt():
