+
+
+def _assign_rotations(rng: np.random.Generator, shapes: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    same_angles = [0, 2]
+    swap_angles = [1, 3]
+    rng.shuffle(same_angles)
+    rng.shuffle(swap_angles)
+
