+
+
+def _build_frame(rng: np.random.Generator, records: list[dict[str, Any]]) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    slots = [0, 1, 2, 3]
+    rng.shuffle(slots)
+    placed = [records[i] for i in slots]
+    tl, tr, bl, br = placed
