def _gen_grid_size(n_groups: int) -> tuple[int, int]:
    if n_groups == 1:
        min_rows, min_cols = _GEN_MIN_SIZE_BY_LAYOUT["one"]
    elif n_groups == 2 and random.random() < _GEN_TWO_GROUP_TALL_PROB:
        min_rows, min_cols = _GEN_MIN_SIZE_BY_LAYOUT["two_tall"]
    elif n_groups == 2:
