def _gen_valid_masks(h: int, w: int, target_area: int) -> list[tuple[np.ndarray, int]]:
    key = (h, w, target_area)
    if key in _GEN_MASK_CACHE:
        return _GEN_MASK_CACHE[key]

    valid = []
