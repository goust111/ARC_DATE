+def _sample_shape(rng: np.random.Generator, h: int, w: int) -> np.ndarray:
+    valid = _valid_shapes_for_dims(h, w)
+    if not valid:
+        raise RuntimeError(f"no valid shapes for {h}x{w}")
+    return valid[int(rng.integers(len(valid)))].copy()
