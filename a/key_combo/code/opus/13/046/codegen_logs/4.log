  "type": "move_to_match",
  "src": "monochrome 2x2 L sprite s",
  "dst": "one of four 2x2 quadrants d in the 4x4 output around the central hole",
  "match_cond": "s.missing_corner is the inner corner of d facing the central 2x2 hole",
  "transform": "crop s to its 2x2 bbox and copy it into d without rotation",
  "grid_shape": "13x13 input -> 4x4 output"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 13x13 input, 4x4 output, background 0
  objects:
    count: exactly 4 monochrome 2x2 L-sprites (3 colored pixels + 1 bg corner)
    colors: 4 distinct non-zero colors chosen from 1-9
    orientations: all 4 missing-corner orientations present exactly once (TL, TR, BL, BR)
    placement: scattered on 13x13 grid, non-overlapping, min pairwise gap >= 3 cells
  output_rule: |
    Each L-sprite is placed in the 4x4 output in the quadrant OPPOSITE its missing corner:
      missing TL -> quadrant (2,2), missing TR -> quadrant (2,0),
      missing BL -> quadrant (0,2), missing BR -> quadrant (0,0)
    Center 2x2 of output is always background (the 4 missing corners meet there).

generation_strategy:
  approach: output-first
  steps:
    - Build 4x4 output: pick 4 distinct colors, assign one per quadrant, fill each 2x2 quadrant as an L-sprite with the inner corner (facing center) as background.
    - Create 13x13 background grid. For each of the 4 sprites, place its 2x2 bbox at a random non-overlapping position with >= 3 cell gap between any two bboxes.
    - No rotation or mirroring needed; sprites transfer directly from output quadrants to scattered input positions.
```
