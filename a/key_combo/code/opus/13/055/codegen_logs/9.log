+                continue
+            if exposed_side == "top" and higher_boxes and not (r0 < top_limit):
+                continue
+            if exposed_side == "bottom" and higher_boxes and not (r1 > bottom_limit):
+                continue
+            for c0 in range(1, hub_c):
