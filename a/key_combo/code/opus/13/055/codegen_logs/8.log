0100:         ad = _triangle_apex_and_dir(comp)
0101:         if ad is None:
0102:             continue
0103:         (ar, ac), (dr, dc) = ad
0104:         rr = ar + 5 * dr
0105:         cc = ac + 5 * dc
0106:         if 0 <= rr < h and 0 <= cc < w:
0107:             dest_to_shooters.setdefault((rr, cc), []).append(cid)
0108: 
0109:     hit_components: set[int] = set()
0110:     for dest in dest_to_shooters:
0111:         if dest in cell_to_comp:
0112:             hit_components.add(cell_to_comp[dest])
0113: 
0114:     out = g.copy()
0115: 
0116:     # Projectile hitting a sprite recolors the entire sprite to maroon (9).
0117:     for cid in hit_components:
0118:         for r, c in comps[cid]:
0119:             out[r, c] = 9
0120: 
0121:     # Projectile collision locations on empty background.
0122:     for (r, c), shooters in dest_to_shooters.items():
0123:         if (r, c) in cell_to_comp:
0124:             continue
0125:         if len(shooters) >= 2:
0126:             out[r, c] = 1
0127:         else:
0128:             out[r, c] = 9
