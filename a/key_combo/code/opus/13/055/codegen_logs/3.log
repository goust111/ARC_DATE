+    out = np.asarray(grid, dtype=int).copy()
+    for run in _diagonal_runs(out != _BG):
+        for idx, (r, c) in enumerate(run):
+            if idx % 2 == 1:
+                out[r, c] = _YELLOW
+    return out
+
+
+def _main_diagonal_pattern(mask: np.ndarray) -> str:
+    return "".join("1" if bool(mask[i, i]) else "0" for i in range(_Q))
+
+
