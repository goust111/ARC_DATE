+from __future__ import annotations
+
+import hashlib
+import itertools
+import random
+
+import numpy as np
+
+
+_BG = 0
+_BLUE = 1
+_RED = 2
+_GREEN = 3
+_YELLOW = 4
+_GREY = 5
+_ORANGE = 7
+
+_Q = 5
+_INPUT_SIZE = 2 * _Q + 1
