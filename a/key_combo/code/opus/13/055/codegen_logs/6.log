+    _paint_segment(out, current, (current[0], end[1]))
+    _paint_segment(out, (current[0], end[1]), end)
+    return out
+
+
+def _component_count(mask: np.ndarray) -> int:
+    seen = np.zeros_like(mask, dtype=bool)
