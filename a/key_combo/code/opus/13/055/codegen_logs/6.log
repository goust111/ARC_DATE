+    maze = grid.copy()
+    descriptors = []
+    for idx, (r0, c0, r1, c1) in enumerate(regions):
+        wall = np.rot90(template_wall, k=-idx)
+        if idx > 0:
+            mask = wall == WALL
+            sub = maze[r0:r1, c0:c1]
+            sub[mask] = WALL
+        descriptors.append(_describe_wall(wall))
+    return maze, regions, descriptors
