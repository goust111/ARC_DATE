+        if gaps:
+            gaps[rng.randrange(len(gaps))] = 2
+        if not any(gap >= 3 for gap in gaps):
+            gaps[rng.randrange(len(gaps))] = 3
+    else:
+        gaps = [rng.randint(3, 5) for _ in range(len(counts) - 1)]
