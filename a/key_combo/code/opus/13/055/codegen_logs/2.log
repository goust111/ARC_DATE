+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+ORANGE = 7
+TEAL = 8
+BLOCK = 2
+MAX_GENERATION_ATTEMPTS = 400
+LAYOUT_ATTEMPTS = 200
+INPUT_ATTEMPTS = 120
