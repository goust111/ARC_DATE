+            assert (r1 - r0 + 1, c1 - c0 + 1) == (BLOCK, BLOCK), "each block must be 2x2"
+            assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "each block must be a solid 2x2 square"
+            blocks.append({"r": r0, "c": c0, "color": color})
