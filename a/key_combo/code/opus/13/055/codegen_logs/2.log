from __future__ import annotations
import random
from collections import deque
import numpy as np

BLACK, RED, ORANGE, TEAL = 0,2,7,8


def comps_counts(total, parts, max_part=3):
    out=[]
    def rec(rem,k,cur):
        if k==0:
            if rem==0: out.append(tuple(cur))
            return
        for x in range(1, min(max_part, rem-k+1)+1):
            cur.append(x); rec(rem-x,k-1,cur); cur.pop()
    rec(total,parts,[])
    return out


COMPS=[]
for total in range(5,8):
    for parts in range(3,5):
        COMPS.extend(comps_counts(total,parts,3))
COMPS=sorted(set(COMPS))
print('comps',COMPS[:20],len(COMPS))


def render(blocks, H, W):
    g=np.zeros((H,W),dtype=int)
    for b in blocks:
        g[b['r']:b['r']+2,b['c']:b['c']+2]=b['color']
    return g


def settle(blocks,H,W):
    blocks=[dict(b) for b in blocks]
    for _ in range(W+5):
        occ=np.zeros((H,W),dtype=int)-1
        for i,b in enumerate(blocks):
            occ[b['r']:b['r']+2,b['c']:b['c']+2]=i
        movable=[]
        for i,b in enumerate(blocks):
            if b['c']+2>=W:
                continue
            ok=True
            for rr in range(b['r'],b['r']+2):
                for cc in range(b['c']+1,b['c']+3):
                    lab=occ[rr,cc]
                    if lab not in (-1,i):
                        ok=False
            if ok:
                movable.append(i)
        if not movable:
            return blocks
        for i in movable:
            blocks[i]['c']+=1
    raise RuntimeError


def visible_step(grid,a,b):
    if a['r']==b['r']:
        c0=min(a['c'],b['c'])+2
        c1=max(a['c'],b['c'])-1
        if c0<=c1 and not np.all(grid[a['r']:a['r']+2,c0:c1+1]==0):
            return None
        return 'h', abs(a['c']-b['c'])
    if a['c']==b['c']:
        r0=min(a['r'],b['r'])+2
        r1=max(a['r'],b['r'])-1
        if r0<=r1 and not np.all(grid[r0:r1+1,a['c']:a['c']+2]==0):
            return None
        return 'v', abs(a['r']-b['r'])
    return None


def path(blocks,H,W):
    grid=render(blocks,H,W)
    start=[i for i,b in enumerate(blocks) if b['color']==RED][0]
    unvisited={i for i,b in enumerate(blocks) if b['color']==TEAL}
    cur=start
    steps=[]
    while True:
        cand=[]
        for i in sorted(unvisited):
            st=visible_step(grid,blocks[cur],blocks[i])
            if st is None:
                continue
            axis,dist=st
            cand.append((dist,blocks[i]['r'],blocks[i]['c'],axis,i))
        if not cand:
            break
        cand.sort()
        dist,row,col,axis,i=cand[0]
        steps.append((cur,i,axis,dist))
        unvisited.remove(i)
        cur=i
    return steps,unvisited


def gen_input_from_counts(counts):
    rng=random.Random()
    B=len(counts)
    gaps=[rng.randint(3,5) for _ in range(B-1)]
    rows=[1]
    for g in gaps:
        rows.append(rows[-1]+g)
    H=rows[-1]+3
    W=rng.randint(16,22)
    settled=[]
    for bi,n in enumerate(counts):
        for j in range(n):
            settled.append({'r':rows[bi],'c':W-2*(j+1),'color':TEAL,'band':bi,'slot':j})
    # pick red among slot1 or slot2 if possible
    options=[i for i,b in enumerate(settled) if b['slot']>0]
    if not options: return None
    ridx=rng.choice(options)
    settled[ridx]['color']=RED
    stps,unv=path(settled,H,W)
    axes=''.join(s[2] for s in stps)
    if len(stps)<3 or 'h' not in axes or 'v' not in axes:
        return None
    # input columns
    used=set()
    inp=[]
    for bi,n in enumerate(counts):
        max_right=W-3
        # choose ascending left cols for leftmost..rightmost? convert later
        cols=[]
        last=-10
        choices=list(range(1,W-2))
        rng.shuffle(choices)
        # rightmost final settled col = W-2. require rightmost input <= W-3
        # build from rightmost to leftmost backwards
        cur_max=W-3
        bandcols=[]
        for slot in range(n):
            # choose c for this slot (0 rightmost) less than previous-2 if previous exists, and unique globally
            lo=1
            hi=cur_max
            cands=[c for c in range(lo,hi+1) if c not in used]
            if not cands:
                return None
            c=rng.choice(cands)
            bandcols.append(c)
            used.add(c)
            cur_max=c-2
        # bandcols are slot0,slot1... decreasing? since cur_max desc, yes each next smaller
        for slot,c in enumerate(bandcols):
            color=RED if settled[[k for k,b in enumerate(settled) if b['band']==bi and b['slot']==slot][0]]['color']==RED else TEAL
            inp.append({'r':rows[bi],'c':c,'color':color})
    final=settle(inp,H,W)
    # compare positions ignoring order
    s1=sorted((b['r'],b['c'],b['color']) for b in final)
    s2=sorted((b['r'],b['c'],b['color']) for b in settled)
    if s1"'!=s2:
        return None
    stps_in,unv_in=path(inp,H,W)
    if len(stps_in)>=len(stps):
        return None
    return counts,rows,W,H,stps,stps_in,settled,inp

ok=0
for counts in COMPS:
    hits=0
    for _ in range(200):
        r=gen_input_from_counts(counts)
        if r:
            hits+=1
            if hits<3:
                print('"'counts',counts,'path',[(a,b,ax,d) for a,b,ax,d in r[4]],'inputlen',len(r[5]))
    if hits:
        print('valid counts',counts,hits)
        ok+=1
print('ok patterns',ok)
