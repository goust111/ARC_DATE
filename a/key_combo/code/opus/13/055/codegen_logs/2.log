+
+
+def _sample_input_blocks(settled: list[dict], shape: tuple[int, int], rng: random.Random) -> list[dict] | None:
+    _h, w = map(int, shape)
+    used_cols: set[int] = set()
+    input_blocks: list[dict] = []
