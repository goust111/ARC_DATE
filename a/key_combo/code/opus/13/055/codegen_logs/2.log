+                    "r": int(rows[band]),
+                    "c": int(width - BLOCK * (slot + 1)),
+                    "color": RED if band == red_band and slot == 1 else TEAL,
+                    "band": int(band),
+                    "slot": int(slot),
+                }
+            )
+    return blocks
