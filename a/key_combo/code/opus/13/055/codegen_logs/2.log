from __future__ import annotations
import random, itertools
import numpy as np
BLACK, RED, TEAL = 0,2,8


def render(blocks,H,W):
    g=np.zeros((H,W),dtype=int)
    for b in blocks:
        g[b['r']:b['r']+2,b['c']:b['c']+2]=b['color']
    return g

def visible_step(grid,a,b):
    if a['r']==b['r']:
        c0=min(a['c'],b['c'])+2; c1=max(a['c'],b['c'])-1
        if c0<=c1 and not np.all(grid[a['r']:a['r']+2,c0:c1+1]==0): return None
        return 'h', abs(a['c']-b['c'])
    if a['c']==b['c']:
        r0=min(a['r'],b['r'])+2; r1=max(a['r'],b['r'])-1
        if r0<=r1 and not np.all(grid[r0:r1+1,a['c']:a['c']+2]==0): return None
        return 'v', abs(a['r']-b['r'])
    return None

def path(blocks,H,W):
    g=render(blocks,H,W)
    cur=[i for i,b in enumerate(blocks) if b['color']==RED][0]
    unv={i for i,b in enumerate(blocks) if b['color']==TEAL}
    tie=False; painted=False; axes=[]
    while True:
        cand=[]
        for i in unv:
            st=visible_step(g,blocks[cur],blocks[i])
            if st:
                ax,dist=st
                cand.append((dist,blocks[i]['r'],blocks[i]['c'],ax,i))
        if not cand: break
        cand.sort()
        best=cand[0]
        if len(cand)>=2 and cand[0][:2]==cand[1][:2]:
            tie=True
        _,_,_,ax,i=best
        if ax=='v' and abs(blocks[cur]['r']-blocks[i]['r'])>=3: painted=True
        axes.append(ax)
        unv.remove(i); cur=i
    return ''.join(axes), tie, painted

patterns=[]
for counts in {(2,1,2),(2,2,2),(1,2,2,1),(1,2,2,2),(2,2,1,2),(3,1,2)}:
  B=len(counts)
  for gaps in itertools.product([2,3,4], repeat=B-1):
    rows=[1]
    for g in gaps: rows.append(rows[-1]+g)
    W=18; H=rows[-1]+3
    blocks=[]
    for bi,n in enumerate(counts):
      for j in range(n): blocks.append({'r':rows[bi],'c':W-2*(j+1),'color':TEAL,'band':bi,'slot':j})
    for idx,b in enumerate(blocks):
      if b['slot']==0: continue
      orig=b['color']; b['color']=RED
      axes,tie,painted=path(blocks,H,W)
      if 'h' in axes and 'v' in axes and tie and painted:
        patterns.append((counts,gaps,idx,axes))
      b['color']=orig
print('found',len(patterns))
for p in patterns[:30]: print(p)
