+        for idx, (r, c) in enumerate(seg):
+            out[r, c] = YELLOW if idx % 2 == 1 else RED
+
+    return out
+
+
+def _segment_from_center(center: tuple[int, int], length: int) -> list[tuple[int, int]]:
+    cr, cc = center
+    start_offset = length // 2
