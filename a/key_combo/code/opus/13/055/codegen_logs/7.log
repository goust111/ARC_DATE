_GEN_SIZE_MIN = 3
_GEN_SIZE_MAX = 12
_GEN_BACKGROUND_COLOR = int(Color.BLACK)
_GEN_OUTPUT_COLOR = int(Color.YELLOW)
_GEN_FG_COLORS = np.array([c for c in Color.NOT_BLACK if c != _GEN_OUTPUT_COLOR], dtype=int)

