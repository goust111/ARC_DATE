+def _extend_side(
+    black: set[tuple[int, int]],
+    center: tuple[int, int],
+    side: str,
+    length: int,
+) -> None:
+    dr, dc = {"N": (-1, 0), "S": (1, 0), "W": (0, -1), "E": (0, 1)}[side]
+    r, c = center
+    for step in range(1, length + 1):
+        black.add((r + dr * step, c + dc * step))
