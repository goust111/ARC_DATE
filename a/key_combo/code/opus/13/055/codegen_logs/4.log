+def _safe_extension_sides(cyan_diagonals: set[str]) -> set[str]:
+    safe = set()
+    for side, diags in SIDE_TO_DIAGONALS.items():
+        if any(diag in cyan_diagonals for diag in diags):
+            safe.add(side)
+    return safe
+
