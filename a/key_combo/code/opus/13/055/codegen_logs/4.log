+    for i, j in edges:
+        r1, c1 = centers[i]
+        r2, c2 = centers[j]
+        if r1 == r2:
+            if c1 < c2:
+                used[i].add("E")
+                used[j].add("W")
+            else:
+                used[i].add("W")
+                used[j].add("E")
