+
+def _center_used_sides(
+    centers: list[tuple[int, int]], edges: list[tuple[int, int]]
+) -> dict[int, set[str]]:
+    used = {i: set() for i in range(len(centers))}
+    for i, j in edges:
+        r1, c1 = centers[i]
+        r2, c2 = centers[j]
+        if r1 == r2:
+            if c1 < c2:
