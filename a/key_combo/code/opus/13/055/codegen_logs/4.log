+        dvals = {info[i]["d"] for i in indices}
+        if len(dvals) >= 2:
+            winner = _priority_winner(indices, info)
+            if all(
+                (info[winner]["d"], -info[winner]["center"][0], -info[winner]["center"][1])
+                >= (info[i]["d"], -info[i]["center"][0], -info[i]["center"][1])
