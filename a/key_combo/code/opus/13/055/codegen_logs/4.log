+        (
+            [(0, 0), (0, g1), (0, g1 + g2)],
+            [(0, 1), (1, 2)],
+        ),
+        (
+            [(0, 0), (0, g1), (0, g1 + g2), (g3, g1)],
+            [(0, 1), (1, 2)],
