+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+CYAN = 8
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAGONALS = {
+    "NW": (-1, -1),
+    "NE": (-1, 1),
+    "SW": (1, -1),
+    "SE": (1, 1),
+}
+SIDE_TO_DIAGONALS = {
+    "N": ("NW", "NE"),
+    "S": ("SW", "SE"),
+    "W": ("NW", "SW"),
+    "E": ("NE", "SE"),
+}
