+def _solve_metadata(grid: np.ndarray) -> tuple[np.ndarray, list[dict], dict[tuple[int, int], list[int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    centers = _find_centers(g)
