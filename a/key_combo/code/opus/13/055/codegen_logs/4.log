+    out = g.copy()
+    for cell, indices in contested.items():
+        best = max(indices, key=lambda i: (info[i]["d"], -info[i]["center"][0], -info[i]["center"][1]))
+        out[cell] = info[best]["color"]
+
+    assert out.shape == (h, w)
+    return out, info, contested
