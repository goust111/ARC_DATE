+        ),
+        (
+            [(0, 0), (0, g1), (0, g1 + g2), (g3, g1), (g3, g1 + g2 + g4)],
+            [(0, 1), (1, 2), (1, 3)],
+        ),
+        (
+            [(0, 0), (0, g1), (0, g1 + g2), (g3, g1)],
+            [(0, 1), (1, 2)],
