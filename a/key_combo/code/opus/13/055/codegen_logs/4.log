+def _add_center_structure(
+    black: set[tuple[int, int]],
+    center: tuple[int, int],
+    cyan_diagonals: set[str],
+) -> None:
+    r, c = center
+    black.add((r, c))
+    for dr, dc in DIR4:
+        black.add((r + dr, c + dc))
+    for name, (dr, dc) in DIAGONALS.items():
+        if name not in cyan_diagonals:
