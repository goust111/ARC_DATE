+                if r < cr:
+                    predecessors.append((r + 1, c))
+                elif r > cr:
+                    predecessors.append((r - 1, c))
+                if c < cc:
+                    predecessors.append((r, c + 1))
+                elif c > cc:
+                    predecessors.append((r, c - 1))
