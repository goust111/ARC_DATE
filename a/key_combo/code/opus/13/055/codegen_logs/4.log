+def _template_layout(rng: random.Random) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    g1 = rng.randint(4, 5)
+    g2 = rng.randint(4, 5)
+    g3 = rng.randint(4, 5)
+    g4 = rng.randint(4, 5)
+    templates: list[tuple[list[tuple[int, int]], list[tuple[int, int]]]] = [
+        (
+            [(0, 0), (0, g1), (0, g1 + g2)],
+            [(0, 1), (1, 2)],
+        ),
+        (
+            [(0, 0), (0, g1), (0, g1 + g2), (g3, g1)],
