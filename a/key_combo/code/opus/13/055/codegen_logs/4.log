+def _find_centers(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    centers: list[tuple[int, int]] = []
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if grid[r, c] != BLACK:
+                continue
+            if all(grid[r + dr, c + dc] == BLACK for dr, dc in DIR4):
+                centers.append((r, c))
+    return centers
