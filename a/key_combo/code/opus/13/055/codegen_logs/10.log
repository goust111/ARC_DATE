            height_range = GEN_PATCH_HEIGHT_RANGE
            width_range = GEN_PATCH_WIDTH_RANGE
        patch = _gen_cycle_patch(color, desired, max_height=height_range[1], max_width=width_range[1])
        if patch is None:
            return None
        patches.append(patch)
    return patches


def _gen_attempt():
