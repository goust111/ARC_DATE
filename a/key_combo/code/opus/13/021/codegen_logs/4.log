+
+    grid[:TILE_SIZE, tile_left:width] = tile
+    return grid
+
+
+def _attempt_generate() -> np.ndarray | None:
+    n_glyphs = random.randint(MIN_GLYPHS, MAX_GLYPHS)
+    shape = _sample_shape(n_glyphs)
