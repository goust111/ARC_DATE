# Canvas, marker, and side-selection bounds.
GRID_SIZES = [8, 10, 12, 14, 16, 18, 9, 11, 13, 15, 17]
MIN_MARKERS, MAX_MARKERS, SIZE_MARKER_LIMIT_OFFSET = 4, 14, 4
SIDE_COUNT_MIN, SIDE_COUNT_MAX = 1, 2
