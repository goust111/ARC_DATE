+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+FRAME_COLOR = YELLOW
+HEIGHT_MARKER = GREY
+DIRECTION_MARKER = PINK
+MOTIF_COLORS = (BLUE, RED, GREEN)
+ROTATION_BY_SIDE = {"top": 0, "right": 3, "bottom": 2, "left": 1}
+ALL_SIDES = ("top", "right", "bottom", "left")
+GEN_RETRIES = 400
