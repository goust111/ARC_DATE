+        color_count = random.randint(2, 3)
+        colors = random.sample(MOTIF_COLORS, color_count)
+        motif = np.zeros((motif_h, motif_w), dtype=int)
+        filled = list(zip(*np.where(mask)))
+        random.shuffle(filled)
