def _gen_scatter_markers(grid: np.ndarray, frames: list[dict[str, object]]) -> bool:
    allowed = grid == GEN_BACKGROUND_COLOR
    for frame in frames:
        r0, c0, r1, c1 = frame["bbox"]
        allowed[r0 : r1 + 1, c0 : c1 + 1] = False

    jobs: list[int] = []
    for frame in frames:
