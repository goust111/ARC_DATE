    _gen_paint_obstacles(inp, obstacle_row, runs)

    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(GEN_RETRY_LIMIT):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid c87289bb input")

