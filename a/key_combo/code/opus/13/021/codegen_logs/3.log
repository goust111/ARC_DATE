                options.append((side, start, end, depth))
    return options


def _gen_apply_notch(top, bottom, option):
    side, start, end, depth = option
    if side == "top":
        top[start : end + 1] = [depth] * (end - start + 1)
    else:
        height = max(bottom) + 1
        bottom[start : end + 1] = [height - 1 - depth] * (end - start + 1)


