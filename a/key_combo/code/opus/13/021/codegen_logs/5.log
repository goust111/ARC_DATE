import itertools
import numpy as np
from collections import deque

for q in [5,6]:
    n=2*q+1
    k=q
    cells=[(r,c) for r in range(q) for c in range(q)]
    def connected(shape):
        pts=list(shape)
        if not pts:return False
        seen={pts[0]}
        dq=deque([pts[0]])
        while dq:
            r,c=dq.popleft()
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                nb=(r+dr,c+dc)
                if nb in shape and nb not in seen:
                    seen.add(nb); dq.append(nb)
        return len(seen)==len(shape)
    def render(shape):
        g=np.zeros((n,n),int)
        g[k,:]=5; g[:,k]=5
        for r,c in shape:
            for rr,cc in [(r,c),(r,2*k-c),(2*k-r,c),(2*k-r,2*k-c)]:
                g[rr,cc]=1
        g[g==5]=0
        return g
    def pockets(g):
        h,w=g.shape
        seen=np.zeros((h,w),bool)
        out=[]
        for r in range(h):
            for c in range(w):
                if g[r,c]"'!=0 or seen[r,c]:
                    continue
                dq=deque([(r,c)]); seen[r,c]=True; comp=[(r,c)]; touch=r in (0,h-1) or c in (0,w-1)
                while dq:
                    x,y=dq.popleft()
                    for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<h and 0<=ny<w and g[nx,ny]==0 and not seen[nx,ny]:
                            seen[nx,ny]=True; dq.append((nx,ny)); comp.append((nx,ny))
                            if nx in (0,h-1) or ny in (0,w-1): touch=True
                if not touch:
                    out.append(comp)
        return out
    found=[]
    for size in range(4,9):
        for comb in itertools.combinations(cells,size):
            s=set(comb)
            if not connected(s):
                continue
            if not any(r==q-1 or c==q-1 for r,c in s):
                continue
            if all(r!=q-1 for r,c in s) or all(c!=q-1 for r,c in s):
                continue
            if sum(r==q-1 for r,c in s)==q or sum(c==q-1 for r,c in s)==q:
                continue
            ps=pockets(render(s))
            if ps:
                found.append((size,s,ps))
                print('"'q',q,'size',size,'pockets',len(ps),'area',sorted(len(p) for p in ps))
                print(sorted(s))
                # print grid
                g=render(s)
                chars={0:'.',1:'#'}
                for row in g:
                    print(''.join(chars[v] for v in row))
                print()
                if len(found)>=8:
                    raise SystemExit
    print('total found maybe',len(found))
