+    q = source.shape[0]
+    n = 2 * q + 1
+    out = np.full((n, n), BACKGROUND, dtype=int)
+    for rr, cc in _mirror_coords(source):
+        out[rr, cc] = int(shape_color)
+    return out
+
+
