    if right_width >= H_MIN_MAJOR_AXIS and h * right_arm >= H_MIN_NEW_AREA:
        valid.append("right")
    if h * left_arm >= H_MIN_NEW_AREA and h * right_arm >= H_MIN_NEW_AREA:
        valid.append("both")
    if not valid:
        return None

    side = str(rng.choice(valid))
    if side == "left":
        return 0, vt_c1
    if side == "right":
        return vt_c0, GRID_SIZE - 1
    return 0, GRID_SIZE - 1


