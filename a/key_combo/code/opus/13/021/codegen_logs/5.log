    mask = _gen_full_from_half(half, w)
    if not np.array_equal(mask, np.fliplr(mask)):
        return None
    if not is_contiguous(mask.astype(int), background=0, connectivity=8):
        return None

    return _gen_sprite_from_mask(mask, color)


