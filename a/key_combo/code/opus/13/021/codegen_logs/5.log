    rng: np.random.Generator,
    h: int,
    vt_c0: int,
    vt_c1: int,
    vc0: int,
    vc1: int,
) -> tuple[int, int] | None:
    left_width = vc1 + 1
    right_width = GRID_SIZE - vc0
    left_arm = vc0
    right_arm = GRID_SIZE - 1 - vc1
