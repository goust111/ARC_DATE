+    min_width = max(GRID_W_RANGE[0], seed_count * motif_w + (seed_count - 1))
+    if min_width > GRID_W_RANGE[1]:
+        return None
+    width = random.randint(min_width, GRID_W_RANGE[1])
+    height = random.randint(*GRID_H_RANGE)
+
