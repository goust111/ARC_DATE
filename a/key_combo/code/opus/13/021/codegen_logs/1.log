+        return None
+
+    rows = [random.choice(long_rows)]
+    pool = [row for row in range(low, high + 1) if row != rows[0]]
+    rows.extend(random.sample(pool, seed_count - 1))
+    random.shuffle(rows)
+    return rows
+
