+    grid_h = random.randint(min_h, max_h)
+    grid_w = random.randint(min_w, max_w)
+    top = _centered_position(grid_h, outer_h)
+    left = _centered_position(grid_w, outer_w)
+    bboxes = _build_bboxes(top, left, inner_h, inner_w, gaps)
