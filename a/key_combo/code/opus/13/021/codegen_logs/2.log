+    frame_count = len(bboxes)
+    palette = random.sample(ALL_COLORS, 2 * frame_count)
+    frame_colors = palette[:frame_count]
+    marker_colors = palette[frame_count:]
+    fill_colors = marker_colors[:]
+    random.shuffle(fill_colors)
