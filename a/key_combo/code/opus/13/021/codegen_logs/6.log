+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]) or bool(seen[r, c]):
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _marker_corner_from_missing(missing_pos: tuple[int, int], bbox: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = bbox
+    if missing_pos == (r0, c0):
+        return "BR"
+    if missing_pos == (r0, c1):
+        return "BL"
+    if missing_pos == (r1, c0):
+        return "TR"
+    return "TL"
+
+
+def _find_marker(grid: np.ndarray, bg: int) -> tuple[int, tuple[int, int], str]:
+    counts = Counter(map(int, grid.flatten()))
+    for color, count in counts.items():
+        if int(color) == int(bg) or int(count) != 3:
+            continue
+        pts = [tuple(map(int, rc)) for rc in np.argwhere(grid == int(color))]
+        rs = [r for r, _ in pts]
+        cs = [c for _, c in pts]
+        r0, r1 = min(rs), max(rs)
+        c0, c1 = min(cs), max(cs)
+        if r1 - r0 != 1 or c1 - c0 != 1:
+            continue
+        all_cells = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
+        missing = list(all_cells - set(pts))
+        if len(missing) == 1:
+            bbox = (r0, c0, r1, c1)
+            return int(color), missing[0], _marker_corner_from_missing(missing[0], bbox)
+    raise AssertionError("expected one 3-cell L marker")
+
+
+def _extract_pieces(grid: np.ndarray, bg: int, marker: int) -> list[Piece]:
+    mask = (grid != int(bg)) & (grid != int(marker))
+    pieces: list[Piece] = []
+    for idx, coords in enumerate(_components(mask)):
+        r0, c0 = coords.min(axis=0)
+        r1, c1 = coords.max(axis=0)
+        r0 = int(r0)
+        c0 = int(c0)
+        r1 = int(r1)
+        c1 = int(c1)
