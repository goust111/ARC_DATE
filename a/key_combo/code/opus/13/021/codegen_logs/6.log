+                    "rect_shape": (rect_h, rect_w),
+                    "rect_origin": (top, left),
+                    "corner": corner,
+                    "wildcard": wildcard,
+                    "canvas": canvas,
+                    "owner": owner,
+                    "placement": placement,
+                    "placement_sig": _candidate_signature(placement),
+                    "visible_score": int(visible_score),
+                    "repaired": repaired,
+                    "full_score": int(full_score),
