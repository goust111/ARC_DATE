+    inp = np.full((grid_h, grid_w), BACKGROUND_COLOR, dtype=int)
+    for piece, (r0, c0) in zip(pieces, positions):
+        h, w = piece.shape
+        inp[r0 : r0 + h, c0 : c0 + w] = piece
+    for r, c in marker_cells:
+        inp[r, c] = MARKER_COLOR
