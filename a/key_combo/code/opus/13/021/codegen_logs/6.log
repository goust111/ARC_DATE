+                continue
+            occupied[r0 : r0 + piece.h, c0 : c0 + piece.w] = True
+            used[piece.index] = True
+            placements[piece.index] = (r0, c0)
+            dfs()
+            placements.pop(piece.index)
+            used[piece.index] = False
