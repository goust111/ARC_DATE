+
+def _rect_origin_for_corner(missing: tuple[int, int], corner: str, h: int, w: int) -> tuple[int, int]:
+    mr, mc = map(int, missing)
+    if corner == "TL":
+        return mr, mc
+    if corner == "TR":
+        return mr, mc - w + 1
+    if corner == "BL":
+        return mr - h + 1, mc
+    return mr - h + 1, mc - w + 1
