+    r0, c0 = best["rect_origin"]
+    h, w = rect.shape
+    produced[r0 : r0 + h, c0 : c0 + w] = rect
+    return np.array_equal(produced, out)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        try:
+            inp, out, _meta = _compose_input()
