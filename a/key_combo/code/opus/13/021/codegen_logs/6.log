+def _is_good_instance(inp: np.ndarray, out: np.ndarray) -> bool:
+    candidates = _solve_candidates(inp)
+    if len(candidates) < 2:
+        return False
+    best_key = min((cand["visible_score"], cand["full_score"]) for cand in candidates)
+    if best_key != (0, 0):
