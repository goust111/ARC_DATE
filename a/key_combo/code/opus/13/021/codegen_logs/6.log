+def _scatter_pieces(
+    grid_h: int,
+    grid_w: int,
+    pieces: list[np.ndarray],
+    forbidden: Iterable[tuple[int, int, int, int]],
+) -> list[tuple[int, int]]:
+    blocked = list(forbidden)
+    positions: list[tuple[int, int]] = []
