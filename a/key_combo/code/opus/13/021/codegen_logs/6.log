+        return None
+    return out
+
+
+def _full_symmetry_mismatches(grid: np.ndarray) -> int:
+    h, w = grid.shape
+    mismatches = 0
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if int(grid[h - 1 - r, c]) != color:
+                mismatches += 1
+            if int(grid[r, w - 1 - c]) != color:
+                mismatches += 1
+    return mismatches
+
