+    rect_h = int(np.random.choice([8, 10]))
+    rect_w = int(np.random.choice([8, 10]))
+    piece_boxes = _partition_template(rect_h, rect_w)
+    allowed = _build_allowed_mask(rect_h, rect_w, piece_boxes)
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    for r in range(rect_h):
+        for c in range(rect_w):
