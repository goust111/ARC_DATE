+            r0 = int(np.random.randint(0, grid_h - h + 1))
+            c0 = int(np.random.randint(0, grid_w - w + 1))
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(_bbox_overlap(box, other, pad=1) for other in blocked):
