+    out = np.full_like(inp, BACKGROUND_COLOR)
+    repaired = _repair_holes(rect)
+    assert repaired is not None
+    out[top : top + rect_h, left : left + rect_w] = repaired
+    meta = {
+        "corner": corner,
+        "rect_shape": (rect_h, rect_w),
+        "target_box": target_box,
+        "positions": positions,
+    }
