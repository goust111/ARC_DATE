+    marker, missing, corner = _find_marker(grid, bg)
+    pieces = _extract_pieces(grid, bg, marker)
+
+    piece_pixels: list[int] = []
+    for piece in pieces:
+        piece_pixels.extend(map(int, piece.array.flatten()))
+    wildcard = int(Counter(piece_pixels).most_common(1)[0][0])
