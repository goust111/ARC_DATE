+def _partition_template(rect_h: int, rect_w: int) -> list[tuple[int, int, int, int]]:
+    if np.random.rand() < 0.5:
+        split = rect_h // 2
+        cut = int(np.random.choice([v for v in range(3, rect_w - 2) if v != rect_w // 2]))
+        return [
+            (0, 0, split - 1, cut - 1),
+            (0, cut, split - 1, rect_w - 1),
+            (split, 0, rect_h - 1, rect_w - cut - 1),
+            (split, rect_w - cut, rect_h - 1, rect_w - 1),
+        ]
+    split = rect_w // 2
+    cut = int(np.random.choice([v for v in range(3, rect_h - 2) if v != rect_h // 2]))
+    return [
