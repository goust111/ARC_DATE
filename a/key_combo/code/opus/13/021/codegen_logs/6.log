+    return out
+
+
+def _edge_compatible(a: int, b: int, wildcard: int) -> bool:
+    return int(a) == int(wildcard) or int(b) == int(wildcard) or int(a) == int(b)
+
+
+def _assemble_candidate(
+    pieces: list[Piece],
+    placement: dict[int, tuple[int, int]],
+    rect_h: int,
+    rect_w: int,
+    wildcard: int,
