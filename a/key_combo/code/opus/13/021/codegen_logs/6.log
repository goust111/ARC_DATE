+            canvas, owner = assembled
+            visible_score = _visible_symmetry_mismatches(canvas, wildcard)
+            repaired = _repair_holes(canvas)
+            full_score = 10**9 if repaired is None else _full_symmetry_mismatches(repaired)
+            candidates.append(
