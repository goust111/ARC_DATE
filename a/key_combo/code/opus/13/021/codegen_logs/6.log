+    return out
+
+
+def _marker_cells(missing: tuple[int, int], corner: str) -> list[tuple[int, int]]:
+    mr, mc = missing
+    if corner == "BR":
+        return [(mr, mc + 1), (mr + 1, mc), (mr + 1, mc + 1)]
+    if corner == "BL":
+        return [(mr, mc - 1), (mr + 1, mc - 1), (mr + 1, mc)]
+    if corner == "TR":
+        return [(mr - 1, mc), (mr - 1, mc + 1), (mr, mc + 1)]
+    return [(mr - 1, mc - 1), (mr - 1, mc), (mr, mc - 1)]
