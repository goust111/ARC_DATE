+    for rect_h, rect_w in _factor_pairs(total_area):
+        top, left = _rect_origin_for_corner(missing, corner, rect_h, rect_w)
+        if top < 0 or left < 0 or top + rect_h > grid_h or left + rect_w > grid_w:
