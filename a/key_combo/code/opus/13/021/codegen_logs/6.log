+
+
+def _visible_symmetry_mismatches(grid: np.ndarray, wildcard: int, hole: int = HOLE_COLOR) -> int:
+    h, w = grid.shape
+    mismatches = 0
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (int(wildcard), int(hole)):
+                continue
+            hr = h - 1 - r
+            vc = w - 1 - c
+            if int(grid[hr, c]) not in (int(hole), color):
+                mismatches += 1
+            if int(grid[r, vc]) not in (int(hole), color):
+                mismatches += 1
+    return mismatches
+
+
+def _repair_holes(grid: np.ndarray, hole: int = HOLE_COLOR) -> np.ndarray | None:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    changed = True
+    while changed:
+        changed = False
+        for r, c in np.argwhere(out == int(hole)):
+            rr = int(r)
+            cc = int(c)
+            mates = (
+                (h - 1 - rr, cc),
+                (rr, w - 1 - cc),
+                (h - 1 - rr, w - 1 - cc),
+            )
+            for mr, mc in mates:
+                color = int(out[mr, mc])
+                if color != int(hole):
+                    out[rr, cc] = color
+                    changed = True
+                    break
