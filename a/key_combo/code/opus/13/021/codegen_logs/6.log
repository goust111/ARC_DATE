+    owner = np.full((rect_h, rect_w), -1, dtype=int)
+    for piece in pieces:
+        r0, c0 = placement[piece.index]
+        r1 = r0 + piece.h
+        c1 = c0 + piece.w
+        canvas[r0:r1, c0:c1] = piece.array
+        owner[r0:r1, c0:c1] = piece.index
