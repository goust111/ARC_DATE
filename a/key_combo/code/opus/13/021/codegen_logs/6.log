+import numpy as np
+
+
+WILDCARD_COLOR = 1
+HOLE_COLOR = 9
+MARKER_COLOR = 6
+BACKGROUND_COLOR = 0
+GEN_MAX_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Piece:
+    index: int
+    array: np.ndarray
