+    r0, c0, r1, c1 = box
+    if r0 == 0 and c0 == 0:
+        return "TL"
+    if r0 == 0 and c1 == w - 1:
+        return "TR"
+    if r1 == h - 1 and c1 == w - 1:
+        return "BR"
+    if r1 == h - 1 and c0 == 0:
