+        dst_corner = NEXT_CORNER[src_corner]
+        r0, c0, r1, c1 = comp["bbox"]
+        obj_h = int(r1 - r0 + 1)
+        obj_w = int(c1 - c0 + 1)
+        dst_r0, dst_c0 = _corner_anchor(dst_corner, h, w, obj_h, obj_w)
+        color = int(comp["color"])
+        for rr, cc in comp["coords"]:
+            out[int(dst_r0 + rr - r0), int(dst_c0 + cc - c0)] = color
