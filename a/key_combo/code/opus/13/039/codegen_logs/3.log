+from __future__ import annotations
+
+from collections import Counter, deque
+import hashlib
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+CORNERS = ("TL", "TR", "BR", "BL")
+NEXT_CORNER = {"TL": "TR", "TR": "BR", "BR": "BL", "BL": "TL"}
+CORNER_COLORS = (1, 2, 3, 4)
