+    {(0, 0), (0, 1), (0, 2), (1, 0), (1, 1)},
+    {(0, 0), (1, 0), (2, 0), (1, 1), (2, 1)},
+    {(0, 0), (0, 1), (1, 0), (2, 0), (2, 1)},
+    {(0, 0), (0, 1), (0, 2), (1, 0), (2, 0), (2, 1)},
+    {(0, 0), (0, 1), (1, 0), (1, 1), (2, 0), (2, 1)},
+    {(0, 0), (0, 1), (0, 2), (1, 0), (1, 1), (2, 0), (2, 1)},
+    {(0, 0), (0, 1), (0, 2), (1, 0), (1, 2), (2, 0), (2, 1), (2, 2)},
+)
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    counts = Counter(map(int, grid.ravel()))
+    return int(counts.most_common(1)[0][0])
+
+
+def _neighbors(r: int, c: int, connectivity: int) -> tuple[tuple[int, int], ...]:
+    if connectivity == 4:
+        return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+    return tuple(
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if (dr, dc) != (0, 0)
+    )
+
+
+def _components_of_color(grid: np.ndarray, color: int, connectivity: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
