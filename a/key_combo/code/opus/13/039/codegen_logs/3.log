+    for corner, color in zip(chosen_corners, chosen_colors):
+        template = _CORNER_TEMPLATES[int(rng.integers(len(_CORNER_TEMPLATES)))]
+        cells = _corner_cells(corner, template, grid.shape)
+        _stamp_cells(grid, cells, int(color))
