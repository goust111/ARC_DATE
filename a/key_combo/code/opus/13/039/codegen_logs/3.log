+def _blocked_bands(ray_pixels: set[tuple[int, int]], shape: tuple[int, int]) -> set[str]:
+    h, w = shape
+    blocked: set[str] = set()
+    for r, c in ray_pixels:
+        if r == 0:
+            blocked.add("TL")
+        if c == w - 1:
+            blocked.add("TR")
+        if r == h - 1:
+            blocked.add("BR")
+        if c == 0:
+            blocked.add("BL")
+    return blocked
