+        path.append((r, c))
+    return path
+
+
+def _find_corner_objects(grid: np.ndarray, bg: int) -> dict[str, dict]:
+    h, w = grid.shape
+    by_corner: dict[str, dict] = {}
+    for color in sorted(set(map(int, np.unique(grid))) - {bg, GREY}):
+        for coords in _components_of_color(grid, color, connectivity=4):
