+def _segment_endpoints(coords: np.ndarray) -> list[tuple[int, int]]:
+    cells = [tuple(map(int, rc)) for rc in coords]
+    pts = set(cells)
+    ends = []
+    for r, c in cells:
+        deg = sum((nr, nc) in pts for nr, nc in _neighbors(r, c, 8))
+        if deg == 1:
+            ends.append((r, c))
