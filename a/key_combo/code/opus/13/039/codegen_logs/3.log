+def _components_of_color(grid: np.ndarray, color: int, connectivity: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, connectivity):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _corner_from_bbox(box: tuple[int, int, int, int], h: int, w: int) -> str | None:
+    r0, c0, r1, c1 = box
+    if r0 == 0 and c0 == 0:
+        return "TL"
+    if r0 == 0 and c1 == w - 1:
+        return "TR"
+    if r1 == h - 1 and c1 == w - 1:
+        return "BR"
+    if r1 == h - 1 and c0 == 0:
