+
+def _neighbors(r: int, c: int, connectivity: int) -> tuple[tuple[int, int], ...]:
+    if connectivity == 4:
+        return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+    return tuple(
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if (dr, dc) != (0, 0)
+    )
