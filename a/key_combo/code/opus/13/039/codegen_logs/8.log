import numpy as np

def build(tail):
    # constants k1=2,k2=6,s1=16,s2=20
    segs=[]
    # For each line, segment extends between its two crossings +- tail rows.
    for color,k in [(1,2),(2,6)]:
        r_cross1=(16-k)//2; r_cross2=(20-k)//2
        r0=r_cross1-tail; r1=r_cross2+tail
        p0=(r0,r0+k); p1=(r1,r1+k); segs.append(('desc',color,p0,p1))
    for color,s in [(3,16),(4,20)]:
        r_cross1=(s-6)//2; r_cross2=(s-2)//2  # with k2=6,k1=2 -> smaller row first
        r0=r_cross1-tail; r1=r_cross2+tail
        p0=(r0,s-r0); p1=(r1,s-r1); segs.append(('asc',color,p0,p1))
    return segs

def solve(segs,N=20):
    g=np.zeros((N,N),int)
    for typ,color,p0,p1 in segs:
        if typ=='desc': ur,uc=p0[0]-2,p0[1]-2; lr,lc=p1[0]+1,p1[1]+1
        else: ur,uc=p0[0]-2,p0[1]+1; lr,lc=p1[0]+1,p1[1]-2
        if min(ur,uc,lr,lc)<0 or max(ur+1,uc+1,lr+1,lc+1)>=N: return None,[]
        g[ur:ur+2,uc:uc+2]=color; g[lr:lr+2,lc:lc+2]=color
    # draw lines in order by upper top-left c then r? actually c tie? order by left-to-right then up-down on upper top-left
    pairs=[]
    for typ,color,p0,p1 in segs:
        if typ=='desc': ur,uc=p0[0]-2,p0[1]-2; start=(ur+1,uc+1); end=(p1[0]+1,p1[1]+1)
        else: ur,uc=p0[0]-2,p0[1]+1; start=(ur+1,uc); end=(p1[0]+1,p1[1]-1)
        # ignore
    # detect from grid
    colors=sorted(set(g.ravel())-{0})
    pairs=[]
    for color in colors:
        pts=np.argwhere(g==color); seen=set(); comps=[]
        for r,c in map(tuple,pts):
            if (r,c) in seen: continue
            st=[(r,c)]; seen.add((r,c)); arr=[]
            while st:
                rr,cc=st.pop(); arr.append((rr,cc))
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<N and 0<=nc<N and g[nr,nc]==color and (nr,nc) not in seen: seen.add((nr,nc)); st.append((nr,nc))
            arr=np.array(arr); comps.append((arr[:,0].min(),arr[:,1].min(),arr[:,0].max(),arr[:,1].max()))
        upper,lower=sorted(comps,key=lambda b:(b[0],b[1]))
        ur0,uc0,ur1,uc1=upper; lr0,lc0,lr1,lc1=lower
        if uc1<lc0: start=(ur1,uc1); end=(lr0,lc0); dr,dc=1,1
        else: start=(ur1,uc0); end=(lr0,lc1); dr,dc=1,-1
        pairs.append((uc0,ur0,color,start,end,dr,dc))
    pairs.sort(key=lambda x:(x[0],x[1]))
    out=g.copy()
    for _,_,color,start,end,dr,dc in pairs:
        r,c=start[0]+dr,start[1]+dc
        while (r,c)"'!=end:
            if out[r,c]==0: out[r,c]=color
            r+=dr;c+=dc
    h,w=out.shape; seen=np.zeros((h,w),bool); regs=[]
    for r in range(h):
        for c in range(w):
            if out[r,c]!=0 or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; pts=[]; touch=False
            while st:
                rr,cc=st.pop(); pts.append((rr,cc))
                if rr in (0,h-1) or cc in (0,w-1): touch=True
