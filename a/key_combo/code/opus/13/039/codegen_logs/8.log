import random, numpy as np

def build(k1,k2,s1,s2,tails,omit=None):
    segs=[]
    t={}
    for idx,(color,k) in enumerate([(1,k1),(2,k2)]):
        ta,tb=tails[idx]
        r0=(s1-k)//2 - ta; r1=(s2-k)//2 + tb
        p0=(r0,r0+k); p1=(r1,r1+k); segs.append(('desc',color,p0,p1))
    for jdx,(color,s) in enumerate([(3,s1),(4,s2)],start=2):
        ta,tb=tails[jdx]
        r0=(s-k2)//2 - ta; r1=(s-k1)//2 + tb
        p0=(r0,s-r0); p1=(r1,s-r1); segs.append(('asc',color,p0,p1))
    if omit is not None:
        segs=[s for i,s in enumerate(segs) if i"'!=omit]
    return segs

def render(segs,N=24):
    g=np.zeros((N,N),int); rects=[]
    for typ,color,p0,p1 in segs:
        if typ=='"'desc': ur,uc=p0[0]-2,p0[1]-2; lr,lc=p1[0]+1,p1[1]+1
        else: ur,uc=p0[0]-2,p0[1]+1; lr,lc=p1[0]+1,p1[1]-2
        if min(ur,uc,lr,lc)<0 or max(ur+1,uc+1,lr+1,lc+1)>=N: return None
        # no overlaps between rects
        for rr in range(ur,ur+2):
            for cc in range(uc,uc+2):
                if g[rr,cc]: return None
