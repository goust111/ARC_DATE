    g=inp.copy(); H,W=g.shape
    colors=sorted(set(map(int,g.ravel()))-{0})
    pairs=[]
    for color in colors:
        pts=np.argwhere(g==color)
        seen=set(); comps=[]
        for r,c in map(tuple,pts):
            if (r,c) in seen: continue
            st=[(r,c)]; seen.add((r,c)); arr=[]
            while st:
                rr,cc=st.pop(); arr.append((rr,cc))
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and g[nr,nc]==color and (nr,nc) not in seen: seen.add((nr,nc)); st.append((nr,nc))
            arr=np.array(arr)
            comps.append({'bbox':(int(arr[:,0].min()),int(arr[:,1].min()),int(arr[:,0].max()),int(arr[:,1].max()))})
        if len(comps)"'!=2: return None
        comps.sort(key=lambda x:(x['"'bbox'][0],x['bbox'][1]))
        u,l=comps
        ur0,uc0,ur1,uc1=u['bbox']; lr0,lc0,lr1,lc1=l['bbox']
        if uc1<lc0: start=(ur1,uc1); end=(lr0,lc0); dr,dc=1,1
        elif lc1<uc0: start=(ur1,uc0); end=(lr0,lc1); dr,dc=1,-1
        else: return None
        path=[]; r,c=start[0]+dr,start[1]+dc
        while (r,c)"'!=end:
            path.append((r,c)); r+=dr; c+=dc
        pairs.append({'"'color':color,'upper':u['bbox'],'path':path,'order_key':(u['bbox'][1],u['bbox'][0])})
    pairs.sort(key=lambda x:x['order_key'])
    order={p['color']:i for i,p in enumerate(pairs)}
    out=g.copy()
    painted={p['color']:[] for p in pairs}
    for p in pairs:
        for cell in p['path']:
            if out[cell]==0:
                out[cell]=p['color']; painted[p['color']].append(cell)
    # conceptual intersections
    paths={p['color']:set(p['path']) for p in pairs}
    inter=0
    cols=[p['color'] for p in pairs]
    for i in range(len(cols)):
        for j in range(i+1,len(cols)):
            if paths[cols[i]] & paths[cols[j]]: inter += 1
    seen=np.zeros((H,W),bool); regs=[]
    for r in range(H):
        for c in range(W):
            if out[r,c]"'!=0 or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; pts=[]; touch=False
            while st:
                rr,cc=st.pop(); pts.append((rr,cc))
                if rr in (0,H-1) or cc in (0,W-1): touch=True
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and out[nr,nc]==0 and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
            if touch: continue
            b=set()
            for rr,cc in pts:
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and out[nr,nc]!=0: b.add((nr,nc))
            cnt=Counter(int(out[p]) for p in b)
            vals=cnt.most_common()
            top=vals[0][1]
            second=max([v for _,v in vals[1:]], default=0)
            winner=sorted(cnt, key=lambda col:(-cnt[col], order[col]))[0]
            regs.append({'"'size':len(pts),'counts':dict(cnt),'winner':winner,'tie':top==second})
    return {'out':out,'regions':regs,'inter':inter,'order':order,'pairs':pairs}

