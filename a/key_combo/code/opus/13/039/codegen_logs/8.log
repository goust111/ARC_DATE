+
+def _build_segments(mode: str, n_pairs: int) -> tuple[int, int, list[dict]] | None:
+    gap_pos = random.choice([4, 6])
+    gap_neg = random.choice([2, 4, 6])
+    k1 = random.choice([0, 2, 4, 6])
+    k2 = k1 + gap_pos
+    s1 = random.choice(list(range(k2 + 8, k2 + 17, 2)))
+    s2 = s1 + gap_neg
