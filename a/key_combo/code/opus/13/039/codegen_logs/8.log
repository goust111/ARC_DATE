+def _boundary_counts(
+    g: np.ndarray,
+    region: list[tuple[int, int]],
+) -> tuple[Counter[int], set[tuple[int, int]]]:
+    h, w = g.shape
+    boundary: set[tuple[int, int]] = set()
+    for r, c in region:
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and g[nr, nc] != BG:
+                boundary.add((int(nr), int(nc)))
