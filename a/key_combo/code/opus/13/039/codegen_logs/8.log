+
+    segs: list[dict] = []
+    for idx, k in enumerate([k1, k2]):
+        before, after = tails[idx]
+        r0 = (s1 - k) // 2 - before
+        r1 = (s2 - k) // 2 + after
+        segs.append({"id": idx, "type": "desc", "p0": (r0, r0 + k), "p1": (r1, r1 + k)})
+    for idx, s in enumerate([s1, s2], start=2):
+        before, after = tails[idx]
+        r0 = (s - k2) // 2 - before
+        r1 = (s - k1) // 2 + after
