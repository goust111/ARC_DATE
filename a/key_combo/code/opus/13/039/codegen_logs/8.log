import numpy as np

def solve(grid):
    g=grid.copy(); bg=0
    colors=sorted(set(g.ravel())-{0})
    pairs=[]
    for color in colors:
        seen=np.zeros_like(g,dtype=bool)
        comps=[]
        for r,c in np.argwhere(g==color):
            r=int(r);c=int(c)
            if seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; pts=[]
            while st:
                rr,cc=st.pop(); pts.append((rr,cc))
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<g.shape[0] and 0<=nc<g.shape[1] and g[nr,nc]==color and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
            arr=np.array(pts)
            comps.append((arr[:,0].min(),arr[:,1].min(),arr[:,0].max(),arr[:,1].max()))
        comps.sort(key=lambda b:(b[0],b[1]))
        if len(comps)"'!=2: return None,[]
        upper,lower=comps
        ur0,uc0,ur1,uc1=upper; lr0,lc0,lr1,lc1=lower
        if uc1<lc0: start=(ur1,uc1); end=(lr0,lc0); dr,dc=1,1
        elif lc1<uc0: start=(ur1,uc0); end=(lr0,lc1); dr,dc=1,-1
        else: return None,[]
        pairs.append((upper[0],upper[1],color,start,end,dr,dc))
    pairs.sort(key=lambda x:(x[1],x[0]))
    out=g.copy()
    for _,_,color,start,end,dr,dc in pairs:
        r,c=start[0]+dr,start[1]+dc
        while (r,c)!=end:
            if out[r,c]==bg: out[r,c]=color
            r+=dr;c+=dc
    # bg comps
    h,w=out.shape
    seen=np.zeros((h,w),bool); regs=[]
    for r in range(h):
        for c in range(w):
            if out[r,c]!=0 or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; pts=[]; touch=False
            while st:
                rr,cc=st.pop(); pts.append((rr,cc))
                if rr in (0,h-1) or cc in (0,w-1): touch=True
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and out[nr,nc]==0 and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
            if not touch: regs.append(pts)
    return out,regs

