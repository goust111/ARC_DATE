import random, numpy as np
from collections import Counter

COLORS=[1,2,3,4]

def rects_overlap(a,b,pad=0):
    ar0,ac0,ar1,ac1=a; br0,bc0,br1,bc1=b
    return not (ar1+pad < br0 or br1+pad < ar0 or ac1+pad < bc0 or bc1+pad < ac0)

def boxes_for_segment(seg):
    typ,p0,p1=seg['type'],seg['p0'],seg['p1']
    if typ=='desc':
        upper=(p0[0]-2,p0[1]-2,p0[0]-1,p0[1]-1)
        lower=(p1[0]+1,p1[1]+1,p1[0]+2,p1[1]+2)
    else:
        upper=(p0[0]-2,p0[1]+1,p0[0]-1,p0[1]+2)
        lower=(p1[0]+1,p1[1]-2,p1[0]+2,p1[1]-1)
    return upper,lower

def shift_seg(seg,dr,dc):
    q=seg.copy(); q['p0']=(seg['p0'][0]+dr,seg['p0'][1]+dc); q['p1']=(seg['p1'][0]+dr,seg['p1'][1]+dc); return q

def line_cells(seg):
    dr,dc=(1,1) if seg['type']=='desc' else (1,-1)
    r,c=seg['p0']; pts=[]
    while True:
        pts.append((r,c))
        if (r,c)==seg['p1']: break
        r+=dr; c+=dc
    return pts

def make_candidate():
    n_pairs=random.choice([3,4])
    family=random.choice(['compact','asym'])
    gapk=random.choice([4,6])
    gaps=random.choice([2,4,6])
    k1=random.choice([0,2,4,6])
    k2=k1+gapk
    s1=random.choice(list(range(k2+8,k2+17,2)))
    s2=s1+gaps
    tails=[]
    if family=='compact':
        for _ in range(4): tails.append((random.randint(0,1),random.randint(0,1)))
    else:
        for _ in range(4): tails.append((random.randint(0,2),random.randint(0,2)))
    segs=[]
    for idx,k in enumerate([k1,k2]):
        ta,tb=tails[idx]
        r0=(s1-k)//2-ta; r1=(s2-k)//2+tb
        segs.append({'id':idx,'type':'desc','p0':(r0,r0+k),'p1':(r1,r1+k)})
    for off,s in enumerate([s1,s2],start=2):
        ta,tb=tails[off]
        r0=(s-k2)//2-ta; r1=(s-k1)//2+tb
        segs.append({'id':off,'type':'asc','p0':(r0,s-r0),'p1':(r1,s-r1)})
    if n_pairs==3:
        omit=random.randrange(4)
        segs=[s for s in segs if s['id']"'!=omit]
    # shift positive
    all_boxes=[]
    for seg in segs: all_boxes.extend(boxes_for_segment(seg))
    minr=min(b[0] for b in all_boxes); minc=min(b[1] for b in all_boxes)
    segs=[shift_seg(seg,2-minr,2-minc) for seg in segs]
    all_boxes=[]
    for seg in segs: all_boxes.extend(boxes_for_segment(seg))
    maxr=max(b[2] for b in all_boxes); maxc=max(b[3] for b in all_boxes)
    H=maxr+1+random.randint(2,5); W=maxc+1+random.randint(2,5)
    if max(H,W)>30: return None
    # extra shift inside canvas
    dr=random.randint(0,H-maxr-1-1)
    dc=random.randint(0,W-maxc-1-1)
    segs=[shift_seg(seg,dr,dc) for seg in segs]
    # maybe mirror
    mirror_h=random.choice([False,True])
    mirror_v=random.choice([False,True])
    if mirror_h or mirror_v:
        # apply in local canvas
        for seg in segs:
            pts=line_cells(seg)
            pts=[((H-1-r) if mirror_v else r, (W-1-c) if mirror_h else c) for r,c in pts]
            pts.sort()
            # reorder by row increasing along actual line path
            pts=sorted(pts,key=lambda rc: rc[0])
            # endpoints by row increasing, and if same row choose according to path slope not needed
            p0,p1=pts[0],pts[-1]
            typ='"'desc' if p1[1]>p0[1] else 'asc'
            seg['type']=typ; seg['p0']=p0; seg['p1']=p1
    # assign colors randomly
    cols=random.sample(COLORS,len(segs))
    for seg,col in zip(segs,cols): seg['color']=col
    # check boxes
    boxes=[]
    for seg in segs:
        u,l=boxes_for_segment(seg)
        if min(*u,*l)<0 or u[2]>=H or u[3]>=W or l[2]>=H or l[3]>=W: return None
        boxes.extend([(seg['color'],u),(seg['color'],l)])
    for i in range(len(boxes)):
        for j in range(i+1,len(boxes)):
            if rects_overlap(boxes[i][1],boxes[j][1],pad=0): return None
    # foreign line through rectangles
    rect_occ=set()
    for _,b in boxes:
        r0,c0,r1,c1=b
        for r in range(r0,r1+1):
            for c in range(c0,c1+1): rect_occ.add((r,c))
    for seg in segs:
        own=set()
        for b in boxes_for_segment(seg):
            r0,c0,r1,c1=b
            for r in range(r0,r1+1):
                for c in range(c0,c1+1): own.add((r,c))
        for p in line_cells(seg):
            if p in rect_occ and p not in own: return None
    return H,W,segs

def build_input(H,W,segs):
    g=np.zeros((H,W),int)
    for seg in segs:
        for box in boxes_for_segment(seg):
            r0,c0,r1,c1=box
            g[r0:r1+1,c0:c1+1]=seg['color']
    return g

