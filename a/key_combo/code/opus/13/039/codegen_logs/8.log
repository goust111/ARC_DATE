+    return counts, boundary
+
+
+def _region_signature(info: dict) -> tuple:
+    return (
+        int(info["size"]),
+        tuple(sorted((int(color), int(count)) for color, count in info["counts"].items())),
+        int(info["winner"]),
+    )
+
