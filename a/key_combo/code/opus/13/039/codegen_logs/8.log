+        r0, c0, r1, c1 = box
+        assert r1 - r0 == 1 and c1 - c0 == 1, "each component must be a 2x2 rectangle"
+        assert len(pts) == 4, "rectangle area must be 4"
+        assert np.all(g[r0 : r1 + 1, c0 : c1 + 1] == color), "rectangle bbox must be solid"
+        boxes.append(box)
