import numpy as np
# construct tail0 4-line and omit variants

def analyze(out, order):
    h,w=out.shape
    seen=np.zeros((h,w),bool)
    infos=[]
    for r in range(h):
        for c in range(w):
            if out[r,c]"'!=0 or seen[r,c]: continue
            st=[(r,c)]; seen[r,c]=1; pts=[]; touch=False
            while st:
                rr,cc=st.pop(); pts.append((rr,cc))
                if rr in (0,h-1) or cc in (0,w-1): touch=True
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and out[nr,nc]==0 and not seen[nr,nc]: seen[nr,nc]=1; st.append((nr,nc))
            if touch: continue
            b=set()
            for rr,cc in pts:
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and out[nr,nc]!=0: b.add((nr,nc))
            cnt={}
            for p in b: cnt[out[p]]=cnt.get(out[p],0)+1
            best=max(cnt, key=lambda col:(cnt[col], -order[col]))
            infos.append((len(pts), cnt, best))
    return infos

def make(omit=None):
    k1,k2,s1,s2=2,6,16,20
    segs=[]
    for color,k in [(1,k1),(2,k2)]:
        r0=(s1-k)//2; r1=(s2-k)//2
        p0=(r0,r0+k); p1=(r1,r1+k); segs.append(('"'desc',color,p0,p1))
    for color,s in [(3,s1),(4,s2)]:
        r0=(s-k2)//2; r1=(s-k1)//2
        p0=(r0,s-r0); p1=(r1,s-r1); segs.append(('asc',color,p0,p1))
    if omit is not None: segs=[s for i,s in enumerate(segs) if i"'!=omit]
    N=20; g=np.zeros((N,N),int)
    rects=[]
    for typ,color,p0,p1 in segs:
        if typ=='"'desc': ur,uc=p0[0]-2,p0[1]-2; lr,lc=p1[0]+1,p1[1]+1
        else: ur,uc=p0[0]-2,p0[1]+1; lr,lc=p1[0]+1,p1[1]-2
        g[ur:ur+2,uc:uc+2]=color; g[lr:lr+2,lc:lc+2]=color
        rects.append((color,ur,uc))
    rects.sort(key=lambda t:(t[2],t[1]))
    order={color:i for i,(color,_,_) in enumerate(rects)}
    # draw via intended
    out=g.copy()
    for color,_,_ in rects:
        seg=[s for s in segs if s[1]==color][0]
        typ,_,p0,p1=seg
        dr,dc=(1,1) if typ=='desc' else (1,-1)
        r,c=p0
        while True:
            if out[r,c]==0: out[r,c]=color
            if (r,c)==p1: break
            r+=dr;c+=dc
    return g,out,order

for omit in [None,0,1,2,3]:
    g,out,order=make(omit)
    print('omit',omit,'infos',analyze(out,order))
