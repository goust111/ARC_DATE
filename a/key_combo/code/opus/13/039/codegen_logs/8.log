+        "p1": (int(seg["p1"][0] + dr), int(seg["p1"][1] + dc)),
+    }
+
+
+def _mirror_segments(segs: list[dict], rows: int, cols: int, flip_h: bool, flip_v: bool) -> list[dict]:
+    out = []
+    for seg in segs:
