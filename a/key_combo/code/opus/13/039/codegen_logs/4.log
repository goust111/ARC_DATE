+                    "index": idx,
+                    "grid_pos": (rb, cb),
+                    "region_box": (r0, c0, r1 - 1, c1 - 1),
+                    "count": marker_count,
+                    "color": colors[0],
+                    "patch": patch,
+                    "sprite_box_local": box,
