+    random.shuffle(colors)
+
+    h = sum(row_heights) + 2
+    w = sum(col_widths) + 2
+    grid = np.full((h, w), BG, dtype=int)
+
+    sep_rows = [row_heights[0], row_heights[0] + 1 + row_heights[1]]
+    sep_cols = [col_widths[0], col_widths[0] + 1 + col_widths[1]]
