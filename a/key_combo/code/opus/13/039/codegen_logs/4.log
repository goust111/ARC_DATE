  "type": "move_to_match",
  "src": "single non-gray foreground sprite s",
  "dst": "empty same-size window d centered on the gray marker pixel",
  "match_cond": "unique s maps to unique d; s.bbox_center aligns with d.gray_marker",
  "transform": "stamp s into d with background transparent; remove the gray marker and preserve the original sprite"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 8-10 rows x 7-11 cols, background black (0)
  sprite:
    bbox: odd x odd, 3x3 [observed]; solver requires odd both dims
    pixels: 6-7 filled out of 9 (density 67-78%) [observed]
    colors: 3 distinct non-bg non-gray colors [observed]
    connectivity: single 4-connected component
    center_cell: must be non-bg (solver asserts)
    symmetry: none (not LR, not UD) [observed]
  marker:
    count: exactly 1 gray (5) pixel
    placement: far enough that paste region (sprite bbox centered on marker) fits entirely within grid and does not overlap original sprite bbox
    paste_region: all cells must be bg or gray before stamping
  output:
    original sprite kept in place
    gray marker removed (set to bg)
    copy of sprite stamped centered on marker (bg cells in patch are transparent)

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size H in [8,12], W in [8,12]
    2. Pick sprite bbox size sh=sw=3 (or any small odd values, 3 or 5)
    3. Generate a random multicolor sprite in sh x sw with 3 non-bg non-gray colors, 4-connected, center cell non-bg, density >= 60%
    4. Choose two non-overlapping positions (r1,c1) and (r2,c2) for the sprite bbox such that both fit within the grid and their bounding boxes do not overlap (gap >= 1 row or column)
    5. Place the sprite at (r1,c1) as the original
    6. Place a gray pixel at the center of (r2,c2) as the marker
    7. Verify the paste region at (r2,c2) is all bg -- guaranteed by step 4
