+HORIZONTAL_MASK = np.array(
+    [
+        [0, 0, 0],
+        [1, 1, 1],
+        [0, 0, 0],
+    ],
+    dtype=bool,
+)
+VERTICAL_MASK = np.array(
+    [
+        [0, 1, 0],
+        [0, 1, 0],
+        [0, 1, 0],
+    ],
+    dtype=bool,
+)
+SCATTER_MASK = np.array(
+    [
+        [1, 0, 1],
+        [0, 0, 0],
+        [1, 0, 1],
+    ],
+    dtype=bool,
+)
