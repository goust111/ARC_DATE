+
+BG = 0
+SPRITE = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 500
+_GEN_COUNTER = 0
+
+HORIZONTAL = "horizontal"
+VERTICAL = "vertical"
+TILE = "tile"
