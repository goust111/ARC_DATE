+        "bars": bars,
+        "total": 1 + len(path),
+        "turns": 1,
+        "fill": (1 + len(path)) // 2,
+    }
+
+
+def _build_h_v_stop(
+    mr: int,
+    mc: int,
+    rh: int,
+    sign: int,
+    len_h: int,
+    len_v: int,
+    lane_left: int,
+    lane_right: int,
+    shape: tuple[int, int],
+) -> dict | None:
