+) -> tuple[int, list[tuple[int, int]], int]:
+    r, c = map(int, start)
+    direction = "up"
+    count = 1
+    turns = 0
+    path = [(r, c)]
+
+    for _ in range(grid.size * 4):
+        dr, dc = DIRS[direction]
+        nr, nc = r + dr, c + dc
+        if not _in_bounds(grid.shape, nr, nc):
+            break
