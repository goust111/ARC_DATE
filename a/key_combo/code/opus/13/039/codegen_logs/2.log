+def _choose_candidates(per_cup: list[list[dict]], cups: list[dict]) -> list[dict] | None:
+    n = len(cups)
+    full_idxs = [i for i, (cup, cands) in enumerate(zip(cups, per_cup)) if any(c["fill"] == cup["height"] for c in cands)]
+    partial_idxs = [
