+    used_path_cells: set[tuple[int, int]] = set()
+    for cand in chosen:
+        path_set = set(cand["path"])
+        if used_path_cells & path_set:
+            return None
+        used_path_cells |= path_set
+
+    for color, cand in zip(bar_palette, chosen):
