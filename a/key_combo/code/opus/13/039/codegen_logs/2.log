+                "bbox": (r0, c0, r0 + heights[i] - 1, c0 + widths[i] - 1),
+                "marker": marker,
+                "height": heights[i] - 1,
+            }
+        )
+        cursor += widths[i]
+        if i < n_cups - 1:
+            cursor += gaps[i]
+
+    per_cup: list[list[dict]] = []
+    for i, cup in enumerate(cup_infos):
+        left = 1 if i == 0 else cup_infos[i - 1]["bbox"][3] + 2
