+                return None
+            grid[r, c] = int(color)
+
+    try:
+        _validate_semantics(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
