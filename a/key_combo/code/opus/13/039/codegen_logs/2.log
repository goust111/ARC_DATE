+    cursor = left_margin
+    for i in range(n_cups):
+        cup, marker_local = _make_cup(widths[i], heights[i], marker_colors[i])
+        r0 = cup_tops[i]
+        c0 = cursor
+        grid[r0 : r0 + heights[i], c0 : c0 + widths[i]] = cup
+        marker = (r0 + marker_local[0], c0 + marker_local[1])
+        cup_infos.append(
