+def _generate_attempt() -> np.ndarray | None:
+    n_cups = random.choice((2, 2, 3))
+    widths = [random.randint(3, 5) for _ in range(n_cups)]
+    heights = [random.randint(4, 6) for _ in range(n_cups)]
