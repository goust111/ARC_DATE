+    per_cup: list[list[dict]] = []
+    for i, cup in enumerate(cup_infos):
+        left = 1 if i == 0 else cup_infos[i - 1]["bbox"][3] + 2
+        right = width - 2 if i == n_cups - 1 else cup_infos[i + 1]["bbox"][1] - 2
