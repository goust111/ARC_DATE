+    min_cup_top = top_band + 2
+    max_cup_top = 14
+    if min_cup_top > max_cup_top:
+        return None
+    cup_tops = [random.randint(min_cup_top, max_cup_top) for _ in range(n_cups)]
+    height = max(cup_tops[i] + heights[i] for i in range(n_cups)) + random.randint(1, 3)
