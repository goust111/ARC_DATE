+
+def _make_cup(width: int, height: int, marker_color: int) -> tuple[np.ndarray, tuple[int, int]]:
+    cup = np.zeros((height, width), dtype=int)
+    cup[:, 0] = BLUE
+    cup[:, -1] = BLUE
+    cup[-1, :] = BLUE
+    cup[0, 0] = BLUE
