+            continue
+        if not np.all(grid[r0 : r1 + 1, c1] == BLUE):
+            continue
+        if not np.all(grid[r1, c0 : c1 + 1] == BLUE):
+            continue
+        if grid[r0, c0] != BLUE or grid[r0, c1] != BLUE:
+            continue
+        if np.any(grid[r0, c0 + 1 : c1] == BLUE):
+            continue
+
