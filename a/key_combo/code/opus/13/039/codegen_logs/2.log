+
+    bar_palette = list(BAR_COLORS)
+    random.shuffle(bar_palette)
+    while len(bar_palette) < n_cups:
+        bar_palette.extend(random.sample(BAR_COLORS, len(BAR_COLORS)))
+
+    used_path_cells: set[tuple[int, int]] = set()
+    for cand in chosen:
