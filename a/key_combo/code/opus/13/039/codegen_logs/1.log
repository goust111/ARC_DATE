+    for rect in rects:
+        r0, c0, r1, c1 = rect
+        out[r0 : r1 + 1, c0 : c1 + 1] = GREY
+    for info in assignments:
+        _recolor_rectangle(out, rects[info["rect_idx"]], info["body_color"], info["marker_color"])
