+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    rect_count = int(rng.choice([2, 3], p=[0.45, 0.55]))
+    sprite_count = rect_count if rect_count == 2 else int(rng.choice([2, 3], p=[0.45, 0.55]))
