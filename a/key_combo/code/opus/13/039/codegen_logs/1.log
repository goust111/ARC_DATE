+        for cand in best_candidates:
+            initial_cells = {(r, c) for r, c, _ in cand["input_cells"]}
+            result = backtrack(
+                next_remaining,
+                chosen + [cand],
+                blocked_initial | initial_cells,
+                blocked_initial_buffer | buffered(initial_cells),
+                blocked_path | cand["sweep_cells"],
