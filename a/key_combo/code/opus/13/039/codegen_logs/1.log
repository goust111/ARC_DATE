+def _search_assignments(
+    targets: list[int],
+    rects: list[tuple[int, int, int, int]],
+    colors: list[tuple[int, int]],
+    rect_id_grid: np.ndarray,
+    rng: np.random.Generator,
+) -> list[dict] | None:
