+        else:
+            assignment = next(item for item in assignments if item["rect_idx"] == idx)
+            if int(patch[0, 0]) != assignment["marker_color"]:
+                return False
+            if int(patch[0, 1]) != assignment["body_color"]:
+                return False
+            if int(patch[1, 1]) != GREY:
+                return False
