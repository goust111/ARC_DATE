+
+def _rect_id_grid(shape: tuple[int, int], rects: list[tuple[int, int, int, int]]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for idx, (r0, c0, r1, c1) in enumerate(rects, start=1):
+        grid[r0 : r1 + 1, c0 : c1 + 1] = idx
