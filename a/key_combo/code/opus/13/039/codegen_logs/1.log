+    untouched = set(range(len(rects))) - rect_set
+    for idx, rect in enumerate(rects):
+        r0, c0, r1, c1 = rect
+        patch = actual[r0 : r1 + 1, c0 : c1 + 1]
+        if idx in untouched:
