+            max_gap = final_r0
+            for gap in range(1, max_gap + 1):
+                positions.append((final_r0 - gap, final_c0, gap))
+    elif direction == "left":
+        final_c0 = c1 + 1
+        if final_c0 + 2 >= w:
+            return []
+        for final_r0 in range(max(0, r0 - 1), min(h - 3, r1 - 1) + 1):
+            max_gap = w - 3 - final_c0
+            for gap in range(1, max_gap + 1):
+                positions.append((final_r0, final_c0 + gap, gap))
+    else:
+        final_c0 = c0 - 3
+        if final_c0 < 0:
+            return []
+        for final_r0 in range(max(0, r0 - 1), min(h - 3, r1 - 1) + 1):
