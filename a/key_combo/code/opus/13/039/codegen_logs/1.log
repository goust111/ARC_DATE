+
+def _semantic_check(
+    grid: np.ndarray,
+    rects: list[tuple[int, int, int, int]],
+    assignments: list[dict],
+    expected: np.ndarray,
+) -> bool:
+    rect_set = {assignment["rect_idx"] for assignment in assignments}
+    if len(rect_set) != len(assignments):
+        return False
+
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return False
