+    return out
+
+
+SPRITE_TEMPLATES = {
+    "up": (
+        ((0, 1, "marker"), (1, 1, "body"), (2, 1, "body"), (1, 0, "body"), (1, 2, "body")),
+        ((0, 1, "marker"), (1, 1, "body"), (2, 1, "body"), (1, 0, "body"), (1, 2, "body"), (2, 0, "body")),
+        ((0, 1, "marker"), (1, 1, "body"), (2, 1, "body"), (1, 0, "body"), (1, 2, "body"), (2, 2, "body")),
