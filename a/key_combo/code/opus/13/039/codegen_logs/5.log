+def _expected_output(full_grid: np.ndarray, input_grid: np.ndarray) -> np.ndarray:
+    bg = _get_bg(input_grid)
+    ranked = _rank_colors(full_grid, input_grid, bg)
+    return _recolor_minorities(full_grid, set(ranked[:2]), bg)
