+            first = _lattice_first_positions(visible)
+            visible_rank = _rank_from_counts(Counter(map(int, visible.flatten())), first)
+            full_counts = Counter(map(int, full.flatten()))
+            full_rank = _rank_from_counts(full_counts, first)
