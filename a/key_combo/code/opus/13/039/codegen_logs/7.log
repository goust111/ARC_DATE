+AREA4_SHAPES = (
+    _mask(["1111"]),
+    _mask(["1", "1", "1", "1"]),
+    _mask(["11", "11"]),
+    _mask(["111", "010"]),
+    _mask(["010", "111"]),
+    _mask(["10", "10", "11"]),
+    _mask(["01", "01", "11"]),
