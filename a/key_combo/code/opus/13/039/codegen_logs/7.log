+        "coords": arr,
+        "bbox": (r0, c0, r1, c1),
+        "mask": mask,
+        "color": int(next(iter(colors))),
+        "area": int(len(coords)),
+    }
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
