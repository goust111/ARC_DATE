        if not candidates:
            return False
        r, c, b = _gen_choice(rng, candidates)
        rects[idx]["pos"] = (r, c)
        rects[idx]["bbox"] = b
        blocked.append(b)
    return True


def _gen_place_rectangles(rng, grid_h, grid_w, rects):
    cluster_indices, isolated_indices = _gen_partition_rectangles(rng, len(rects))
