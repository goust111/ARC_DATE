+    pairs: list[dict] = []
+    used_small: set[int] = set()
+    used_big: set[int] = set()
+    for small_idx, options in by_small.items():
+        if len(options) != 1:
+            continue
+        big_idx, factor = options[0]
+        if len(by_big.get(big_idx, [])) != 1:
+            continue
