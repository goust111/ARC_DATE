+
+AREA5_SHAPES = (
+    _mask(["00100", "11111"]),
+    _mask(["11111"]),
+    _mask(["1", "1", "1", "1", "1"]),
+    _mask(["111", "010", "010"]),
+    _mask(["010", "111", "010"]),
+    _mask(["11", "11", "10"]),
