        h2, w2 = mask.shape
        if not (OPEN_BBOX_ROWS[0] <= h2 <= OPEN_BBOX_ROWS[1] and OPEN_BBOX_COLS[0] <= w2 <= OPEN_BBOX_COLS[1]):
            continue

