# Colors and palette.
_GEN_WALL = 8
_GEN_EMPTY = 0
_GEN_SEED_COLORS = np.array([1, 2, 3, 4, 5, 6, 7, 9], dtype=int)

# Canvas and cavity coverage.
_GEN_GRID_ROWS = range(19, 27)
_GEN_GRID_COLS = range(13, 23)
_GEN_CAVITY_COUNT_RANGE = (1, 3)
_GEN_NON_WALL_PCT_RANGE = (23, 36)
_GEN_WALL_FRACTION_RANGE = (0.64, 0.77)

# Cavity dimensions and wall spacing.
_GEN_CAVITY_HEIGHT_OPTIONS = (6, 8, 9, 10, 12)
_GEN_CAVITY_WIDTH_OPTIONS = (6, 8, 9, 10, 12, 15)
_GEN_CAVITY_DIMS = [(h, w) for h in _GEN_CAVITY_HEIGHT_OPTIONS for w in _GEN_CAVITY_WIDTH_OPTIONS]
_GEN_BORDER_WALL_THICKNESS = 2
_GEN_CAVITY_START_GAP = 3
_GEN_MIN_CAVITY_AREA = min(h * w for h, w in _GEN_CAVITY_DIMS)
_GEN_MAX_CAVITY_AREA = max(h * w for h, w in _GEN_CAVITY_DIMS)
_GEN_CAVITY_WIDTH_WEIGHT_POWER = 2

# Tile dimensions, repetition, and density.
_GEN_TILE_HEIGHT_RANGE = (2, 3)
_GEN_TILE_WIDTH_RANGE = (2, 5)
_GEN_REPS_PER_AXIS_RANGE = (2, 5)
_GEN_TILE_DENSITY_PCT_RANGE = (56, 78)

# Retry limits.
_GEN_MAX_ATTEMPTS = 300
_GEN_PERCENT_DENOM = 100


def _gen_floor_percent(percent: int, value: int) -> int: return (percent * value) // _GEN_PERCENT_DENOM


def _gen_ceil_percent(percent: int, value: int) -> int: return (percent * value + _GEN_PERCENT_DENOM - 1) // _GEN_PERCENT_DENOM


def _gen_factor_options(length: int, lo: int, hi: int) -> list[int]:
    rep_min, rep_max = _GEN_REPS_PER_AXIS_RANGE
    return [d for d in range(lo, hi + 1) if length % d == 0 and rep_min <= length // d <= rep_max]


def _gen_choose_grid(rng: np.random.Generator, count: int) -> tuple[int, int] | None:
    choices = []
    min_cavity_area = _GEN_MIN_CAVITY_AREA * count
    max_cavity_area = _GEN_MAX_CAVITY_AREA * count
    for rows in _GEN_GRID_ROWS:
        for cols in _GEN_GRID_COLS:
            area = rows * cols
            if min_cavity_area <= _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area) and max_cavity_area >= _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area):
                choices.append((rows, cols))
    if not choices:
        return None
    return choices[int(rng.integers(0, len(choices)))]


def _gen_choose_cavity_dims(rng: np.random.Generator, rows: int, cols: int, count: int) -> list[tuple[int, int]] | None:
    area = rows * cols
    min_area = _gen_ceil_percent(_GEN_NON_WALL_PCT_RANGE[0], area)
    max_area = _gen_floor_percent(_GEN_NON_WALL_PCT_RANGE[1], area)
    max_h = rows - 2 * _GEN_BORDER_WALL_THICKNESS
    max_w = cols - 2 * _GEN_BORDER_WALL_THICKNESS
    options = [(h, w) for h, w in _GEN_CAVITY_DIMS if h <= max_h and w <= max_w]
    combos: list[tuple[tuple[int, int], ...]] = []

    def rec(start: list[tuple[int, int]], area: int) -> None:
        if len(start) == count:
            if min_area <= area <= max_area:
                combos.append(tuple(start))
            return
        remaining = count - len(start)
        if area + remaining * _GEN_MIN_CAVITY_AREA > max_area:
            return
from __future__ import annotations
from collections import Counter
import numpy as np
from arc_utils import get_bg, label_mask
import random
from arc_utils import label_mask, bbox, crop_bbox, paste, random_free_location

def main(grid: np.ndarray) -> np.ndarray:
    """
    Fill holes in a target object with colors from a source object's subsprites, then tight-crop.

    Input structure:
    - bg = background. Two similar 8-connected objects share an outline color.
    - Source has colored subsprites in cavities; target has empty cavities.

    Rule:
    - Find the two 8-connected objects.
    - Target = object with more hole area. Align subsprites to holes (rotation/flip if needed).
    - Fill each hole with its matched subsprite color; tight-crop.

    Key insight: Hole centers in the target are matched to source subsprite centers under the best rotation/flip transform.
    """
    g = np.array(grid, dtype=int)
    bg = int(get_bg(g))

    def _components(mask: np.ndarray) -> list[dict]:
        lab, n = label_mask(mask, connectivity=8)
        comps = []
        for cid in range(1, int(n) + 1):
            pts = np.argwhere(lab == int(cid))
            if pts.size == 0:
                continue
            r0, c0 = pts.min(axis=0)
            r1, c1 = pts.max(axis=0)
            comps.append(
                {
                    "cid": int(cid),
                    "pts": pts,
                    "size": int(len(pts)),
                    "cent": (float(pts[:, 0].mean()), float(pts[:, 1].mean())),
                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
                }
            )
        comps.sort(key=lambda d: int(d["size"]), reverse=True)
        return comps

    def _extract_two_objects():
        comps = _components(g != int(bg))
        if len(comps) < 2:
            return [comps]
        return [[comps[0]], [comps[1]]]

    def _bbox_of(group: list[dict]) -> tuple[int, int, int, int]:
        r0 = min(int(d["bbox"][0]) for d in group)
        c0 = min(int(d["bbox"][1]) for d in group)
        r1 = max(int(d["bbox"][2]) for d in group)
        c1 = max(int(d["bbox"][3]) for d in group)
        return int(r0), int(c0), int(r1), int(c1)

    def _extract_group_subgrid(group: list[dict]) -> np.ndarray:
        r0, c0, r1, c1 = _bbox_of(group)
        sub = np.full((int(r1 - r0 + 1), int(c1 - c0 + 1)), int(bg), dtype=int)
        for d in group:
            for rr, cc in d["pts"]:
                sub[int(rr) - int(r0), int(cc) - int(c0)] = int(g[int(rr), int(cc)])
        return sub

    def _enclosed_bg_components(sub: np.ndarray) -> list[dict]:
        m = sub == int(bg)
        lab, n = label_mask(m, connectivity=4)
        Hs, Ws = sub.shape
        holes = []
        for cid in range(1, int(n) + 1):
            pts = np.argwhere(lab == int(cid))
            if pts.size == 0:
                continue
            r0, c0 = pts.min(axis=0)
            r1, c1 = pts.max(axis=0)
            if bool(r0 == 0 or c0 == 0 or r1 == int(Hs - 1) or c1 == int(Ws - 1)):
                continue
            cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))
            holes.append({"pts": pts, "cent": cent, "size": int(len(pts))})
        return holes

    def _outline_col(sub: np.ndarray) -> int:
        cnt = Counter(map(int, sub.flatten()))
        opts = [(c, n) for c, n in cnt.items() if int(c) != int(bg)]
        return int(max(opts, key=lambda t: t[1])[0]) if opts else int(bg)

    def _colored_components(sub: np.ndarray) -> list[dict]:
        outc = _outline_col(sub)
        m = (sub != int(bg)) & (sub != int(outc))
        lab, n = label_mask(m, connectivity=4)
        subs = []
        for cid in range(1, int(n) + 1):
            pts = np.argwhere(lab == int(cid))
            if pts.size == 0:
                continue
            col = Counter(map(int, sub[lab == int(cid)].flatten())).most_common(1)[0][0]
            cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))
            subs.append({"cent": cent, "color": int(col)})
        return subs

    def _rank_keys(pts: list[tuple[int, int]]):
        rows = sorted(set(int(r) for r, _c in pts))
        cols = sorted(set(int(c) for _r, c in pts))
        rrank = {r: i for i, r in enumerate(rows)}
        crank = {c: i for i, c in enumerate(cols)}
        keys = [(int(rrank[r]), int(crank[c])) for r, c in pts]
        return keys, rrank, crank

    def _transform_point(p: tuple[int, int], H0: int, W0: int, k: int, flip: bool) -> tuple[int, int]:
        r, c = int(p[0]), int(p[1])
        if int(k) == 0:
            rr, cc = int(r), int(c)
            H2, W2 = int(H0), int(W0)
        elif int(k) == 1:
            rr, cc = int(W0 - 1 - c), int(r)
            H2, W2 = int(W0), int(H0)
        elif int(k) == 2:
            rr, cc = int(H0 - 1 - r), int(W0 - 1 - c)
            H2, W2 = int(H0), int(W0)
        else:
            rr, cc = int(c), int(H0 - 1 - r)
            H2, W2 = int(W0), int(H0)
        if bool(flip):
            cc = int(W2 - 1 - cc)
        return int(rr), int(cc)

    groups = _extract_two_objects()
    assert not (len(groups) < 2)
    objs = [_extract_group_subgrid(grp) for grp in groups]

    holes_list = [_enclosed_bg_components(o) for o in objs]
    hole_area = [sum(int(h["size"]) for h in hh) for hh in holes_list]
    dest_i = int(np.argmax(hole_area))
    src_i = int(1 - dest_i)
    dest = objs[dest_i].copy()
    src = objs[src_i].copy()

    dest_holes = _enclosed_bg_components(dest)
    src_subs = _colored_components(src)
    if not dest_holes or not src_subs:
        m = dest != int(bg)
        pts = np.argwhere(m)
        r0, c0 = pts.min(axis=0)
        r1, c1 = pts.max(axis=0)
        return dest[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1]

    dest_pts = [h["cent"] for h in dest_holes]
    dest_keys, d_rr, d_cc = _rank_keys(dest_pts)

    best = None
    for k in range(4):
        for flip in [False, True]:
            tpts = [_transform_point(s["cent"], int(src.shape[0]), int(src.shape[1]), int(k), bool(flip)) for s in src_subs]
            tkeys, _s_rr, _s_cc = _rank_keys(tpts)
            if sorted(tkeys) == sorted(dest_keys):
                best = (int(k), bool(flip))
                break

