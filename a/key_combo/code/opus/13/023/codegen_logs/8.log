    if c == 0:
        directions.append((0, 1))
    if c == w - 1:
        directions.append((0, -1))
    if len(directions) != 1:
        return None
    dr, dc = directions[0]

    stack = [((r, c), 0)]
    seen = set()
    hit_count = 0
    max_depth = 0
    while stack:
        (sr, sc), depth = stack.pop()
        if (sr, sc) in seen:
            continue
        seen.add((sr, sc))
        cr, cc = sr, sc
        while True:
            nr, nc = cr + dr, cc + dc
            if not (0 <= nr < h and 0 <= nc < w):
                max_depth = max(max_depth, depth)
