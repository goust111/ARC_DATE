                lo = hi = nc
                while lo - 1 >= 0 and g[nr, lo - 1] == WALL_COLOR:
                    lo -= 1
                while hi + 1 < w and g[nr, hi + 1] == WALL_COLOR:
                    hi += 1
                for x in (lo - 1, hi + 1):
