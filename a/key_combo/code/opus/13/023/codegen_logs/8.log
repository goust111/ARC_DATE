+                gaps = walls[nc][2]
+                next_states = [(gap_r, nc + dc, depth + 1) for gap_r in gaps if _in_bounds(g.shape, gap_r, nc + dc)]
+            max_branching = max(max_branching, len(next_states))
+            max_depth = max(max_depth, depth + 1)
+            stack.extend(next_states)
