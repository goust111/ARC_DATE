+EDGE_CHOICES = ("top", "bottom", "left", "right")
+WALL_COUNT_WEIGHTS = ((2, 2), (3, 4), (4, 3))
+FIRST_WALL_DIST_RANGE = (2, 4)
+WALL_SPACING_RANGE = (2, 4)
