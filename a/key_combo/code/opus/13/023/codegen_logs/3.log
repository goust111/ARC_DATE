+        symmetric_cols = [j for j, tile in enumerate(tiles) if _is_diag_symmetric(tile)]
+        assert len(symmetric_cols) == 1
+        source_col = symmetric_cols[0]
+        fill_color = _tile_color(tiles[source_col])
