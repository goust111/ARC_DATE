+    tile_size = random.randint(*TILE_SIZE_RANGE)
+    rows = [_make_row(tile_size) for _ in range(3)]
+    grid = _assemble_grid(rows)
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+
+    if np.array_equal(out, grid):
+        return None
+    return grid
+
