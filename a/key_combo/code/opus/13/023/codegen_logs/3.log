+        nonsym_colors = [borrowed, borrowed]
+    else:
+        nonsym_colors = random.sample(nonsym_palette, 2)
+
+    row: list[np.ndarray] = []
+    nonsym_index = 0
+    for col in range(3):
+        if col == symmetric_pos:
+            row.append(_make_tile(tile_size, symmetric_color, symmetric=True))
+        else:
