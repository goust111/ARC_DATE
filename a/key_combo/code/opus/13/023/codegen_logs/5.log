+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+TRACK_COLOR = 5
+BG_COLOR = 0
+RECTANGLE_SOURCE_COLORS = (1, 2, 3)
+DISTRACTOR_COLORS = (1, 2, 3, 4)
+GEN_RETRIES = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(grid, return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _neighbors8(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        (r + dr, c + dc)
+        for dr in (-1, 0, 1)
+        for dc in (-1, 0, 1)
+        if dr != 0 or dc != 0
+    )
+
+
+def _find_components(grid: np.ndarray, bg: int) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[dict] = []
+
+    for r0 in range(h):
+        for c0 in range(w):
+            color = int(grid[r0, c0])
+            if color == bg or seen[r0, c0]:
+                continue
+
+            stack = [(r0, c0)]
+            seen[r0, c0] = True
+            coords: list[tuple[int, int]] = []
+
+            while stack:
+                r, c = stack.pop()
+                coords.append((r, c))
+                for nr, nc in _neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+
+            rows = [r for r, _ in coords]
+            cols = [c for _, c in coords]
+            components.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set(coords),
+                    "bbox": (min(rows), min(cols), max(rows), max(cols)),
+                    "area": len(coords),
+                }
+            )
+
+    return components
+
+
+def _border_coords(bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    border = set()
+    for c in range(c0, c1 + 1):
+        border.add((r0, c))
+        border.add((r1, c))
+    for r in range(r0, r1 + 1):
+        border.add((r, c0))
+        border.add((r, c1))
+    return border
+
+
+def _is_hollow_rectangle(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3:
+        return False
+    expected = _border_coords(comp["bbox"])
+    return comp["coord_set"] == expected
+
+
+def _extract_scene(grid: np.ndarray) -> tuple[int, list[dict], list[dict]]:
+    bg = _get_bg(grid)
+    rectangles: list[dict] = []
+    pixels: list[dict] = []
+
+    for comp in _find_components(grid, bg):
+        if _is_hollow_rectangle(comp):
+            r0, c0, r1, c1 = comp["bbox"]
+            rectangles.append(
+                {
+                    "color": int(comp["color"]),
+                    "coords": comp["coords"],
