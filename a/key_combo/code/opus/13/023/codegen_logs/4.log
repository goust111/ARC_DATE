+    if not (open_branch and barrier_branch and stacked_branch):
+        return None
+
+    if np.array_equal(grid, out):
+        return None
+    if np.count_nonzero(grid == ORANGE) < 3:
+        return None
+
+    bottom_diffs = np.count_nonzero(out[-1] != barrier[-1])
+    if bottom_diffs < 1:
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
