+    rooms.sort(key=lambda room: _bbox(list(room)))
+    return rooms
+
+
+def _decode_marker(room: set[tuple[int, int]], grid: np.ndarray) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    reds = [(r, c) for r, c in room if int(grid[r, c]) == RED]
