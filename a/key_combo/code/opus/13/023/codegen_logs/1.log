+
+        for r, c, color, _ in _slide_records(room, movers, dr, dc):
+            out[r, c] = color
+
+    return out
+
+
+def _split_rooms(
+    grid: np.ndarray,
+    rooms: list[tuple[int, int, int, int]],
+    target_count: int,
