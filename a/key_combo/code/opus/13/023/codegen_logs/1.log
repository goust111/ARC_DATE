        reg_c0, reg_c1 = region_box[1], region_box[3]

        obj_w = int(obj_c1 - obj_c0 + 1)
        if carrier == Color.BLUE:
            dst_c0 = int(reg_c1 - obj_w + 1)
        else:
            assert carrier == Color.TEAL
            dst_c0 = int(reg_c0)

        moved = coords.copy()
        moved[:, 1] += dst_c0 - int(obj_c0)

