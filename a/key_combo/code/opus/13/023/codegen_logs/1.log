+    rooms.sort()
+    return rooms
+
+
+def _marker_cells(
+    top: int,
+    left: int,
+    missing: tuple[int, int],
+) -> set[tuple[int, int]]:
+    cells = {(top + rr, left + cc) for rr in (0, 1) for cc in (0, 1)}
+    cells.remove((top + missing[0], left + missing[1]))
