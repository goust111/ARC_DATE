                        seen[nr, nc] = True
                        stack.append((nr, nc))
            coord_arr = np.asarray(coords, dtype=int)
            r0, c0 = coord_arr.min(axis=0)
            r1, c1 = coord_arr.max(axis=0)
            components.append(
