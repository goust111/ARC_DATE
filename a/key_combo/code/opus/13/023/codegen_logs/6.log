+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BACKGROUND = 0
+COLOR_POOL = (1, 2, 3, 7)
+OBJECT_COUNT_OPTIONS = (3, 4)
+ROW_GAP = 1
+MIN_COL_GAP = 2
+MAX_GEN_ATTEMPTS = 500
+MAX_WANDER = 2
+
+BASE_WIDTH_SEQS = (
