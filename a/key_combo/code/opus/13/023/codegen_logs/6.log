    r0, c0 = filled.min(axis=0)
    r1, c1 = filled.max(axis=0)
    patch = np.full((int(r1 - r0 + 1), int(c1 - c0 + 1)), bg, dtype=int)
    patch[filled[:, 0] - r0, filled[:, 1] - c0] = color
    return patch, int(r0), int(c0)


