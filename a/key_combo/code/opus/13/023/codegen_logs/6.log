+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

