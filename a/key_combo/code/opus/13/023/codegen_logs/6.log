+def _seq_area(widths: tuple[int, ...]) -> int:
+    return int(sum(widths))
+
+
+DECEPTIVE_PAIRS = [
+    (a, b)
+    for a in BASE_WIDTH_SEQS
+    for b in BASE_WIDTH_SEQS
+    if len(a) == len(b) and abs(_seq_area(a) - _seq_area(b)) >= 5
