+    for i, a in enumerate(shapes):
+        for b in shapes[i + 1 :]:
+            boundary_gap = abs(int(a["boundary_pixels"]) - int(b["boundary_pixels"]))
+            area_gap = abs(int(a["area"]) - int(b["area"]))
+            if boundary_gap <= 2 and area_gap >= 5:
