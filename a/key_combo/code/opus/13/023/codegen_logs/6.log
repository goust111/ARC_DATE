+    if len({(shape["area"], tops[idx]) for idx, shape in enumerate(shapes)}) != len(shapes):
+        return None
+
+    inp = np.full((canvas_h, canvas_w), BACKGROUND, dtype=int)
+    placed = []
+    for idx, shape in enumerate(shapes):
+        top = int(tops[idx])
+        left = int(x_positions[idx])
