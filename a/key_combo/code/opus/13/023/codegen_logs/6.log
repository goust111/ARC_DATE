+            seq = _choose_extra_sequence(rng, used_areas, allow_duplicate_area=False)
+            sequences.append(seq)
+            used_areas.add(_seq_area(seq))
+
+    rng.shuffle(sequences)
+    if sum(len(seq) for seq in sequences) + ROW_GAP * (len(sequences) - 1) > 30:
+        return None
