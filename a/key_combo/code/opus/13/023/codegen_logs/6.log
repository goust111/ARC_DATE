+                "outline": outline,
+                "filled": filled,
+                "color": color,
+                "area": int(np.count_nonzero(filled)),
+                "height": int(filled.shape[0]),
+                "width": int(filled.shape[1]),
+                "boundary_pixels": 2 * int(filled.shape[0]),
