+
+
+def _render_expected(shapes: list[dict], width: int) -> np.ndarray:
+    ordered = sorted(shapes, key=lambda item: (item["area"], item["top"]))
+    out_h = sum(item["filled"].shape[0] for item in ordered) + ROW_GAP * (len(ordered) - 1)
