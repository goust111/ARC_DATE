    if rng.random() < 0.5:
        widths = tuple(reversed(widths))

    bias = rng.choice((-1, 0, 1))
    for _ in range(40):
        lefts = [0]
        rights = [int(widths[0]) - 1]
        ok = True
        for idx in range(1, len(widths)):
