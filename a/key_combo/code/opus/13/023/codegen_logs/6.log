+    (2, 3, 5, 3, 2),
+    (2, 3, 4, 4, 3, 2),
+    (2, 4, 5, 5, 4, 2),
+    (2, 3, 5, 5, 3, 2),
+    (2, 3, 4, 5, 4, 3, 2),
+)
