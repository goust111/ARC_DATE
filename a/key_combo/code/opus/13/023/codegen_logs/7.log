    out = np.full((out_h, out_w), main, dtype=int)
    for r in range(macro_h):
        for c in range(macro_w):
            if selector[r, c]:
                out[r * stamp_h : (r + 1) * stamp_h, c * stamp_w : (c + 1) * stamp_w] = stamp
    return out

