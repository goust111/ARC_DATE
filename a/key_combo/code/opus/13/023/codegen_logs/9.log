+
+def _draw_corner_l(out: np.ndarray, corner: str, arm: int, color: int) -> None:
+    h, w = out.shape
+    arm = int(arm)
+    color = int(color)
+    if corner == "top_left":
+        out[0, :arm] = color
+        out[:arm, 0] = color
+    elif corner == "top_right":
+        out[0, w - arm :] = color
+        out[:arm, w - 1] = color
+    elif corner == "bottom_left":
+        out[h - 1, :arm] = color
+        out[h - arm :, 0] = color
+    else:
+        assert corner == "bottom_right"
+        out[h - 1, w - arm :] = color
+        out[h - arm :, w - 1] = color
