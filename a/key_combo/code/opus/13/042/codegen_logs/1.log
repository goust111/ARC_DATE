+def _bbox_in_bounds(shape: tuple[int, int], box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    return 0 <= r0 <= r1 < shape[0] and 0 <= c0 <= c1 < shape[1]
