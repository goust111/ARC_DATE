+        winner = _winner(hit_infos)
+        color = int(g[winner["start"]])
+        r0, c0, r1, c1 = frames[frame_idx]
+        out[r0 + 1 : r1, c0 + 1 : c1] = color
+    return out
+
+
+def generate_input() -> np.ndarray:
