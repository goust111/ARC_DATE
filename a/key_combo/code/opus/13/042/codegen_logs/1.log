+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        rng = random.Random()
+        H = rng.randint(18, 22)
+        W = rng.randint(18, 22)
+        shape = (H, W)
+        center = (rng.randint(6, H - 7), rng.randint(6, W - 7))
+        block_box = (center[0] - 1, center[1] - 1, center[0] + 1, center[1] + 1)
+
