+
+def _primary_frame(
+    center: tuple[int, int], orient: str, want_tie: bool, rng: random.Random
+) -> tuple[int, int, int, int]:
+    cr, cc = center
+    if want_tie:
+        depth = rng.randint(4, 6)
+        span = rng.randint(4, 6)
+        if orient == "N":
