+    for r, c in np.argwhere(grid == GRAY):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        seen[r, c] = True
+        q = deque([(r, c)])
+        coords: list[tuple[int, int]] = []
