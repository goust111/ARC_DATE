+def _frame_border_cells(box: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _draw_frame(grid: np.ndarray, box: tuple[int, int, int, int]) -> None:
