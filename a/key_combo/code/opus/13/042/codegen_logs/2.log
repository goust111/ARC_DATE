+    if not _removal_changes_output(grid, "left", left_only, out, sep):
+        return False
+    if not _removal_changes_output(grid, "right", right_only, out, sep):
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(*HEIGHT_RANGE)
