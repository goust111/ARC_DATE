+    assert len(orbit) == len(values)
+    shift = random.randrange(len(orbit))
+    ordered_orbit = orbit[shift:] + orbit[:shift]
+    for (r, c), value in zip(ordered_orbit, values):
+        grid[r, c] = int(value)
+
