+        [dominant, secondary, dominant, secondary],
+        [dominant, dominant, 0, secondary],
+        [dominant, 0, 0, 0],
+        [0, dominant, dominant, 0],
+    ]
+    if len(colors) >= 3:
+        a, b, c = random.sample(colors, 3)
+        patterns.append([a, b, c, 0])
+    return random.choice(patterns)
+
