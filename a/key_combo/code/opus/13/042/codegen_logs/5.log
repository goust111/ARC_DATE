+
+    mandatory = [
+        [c0, c1, c0, c1],
+        [c0, c0, c0, c1],
+        random.choice([[0, c1, 0, c2], [0, c1, c2, 0], [c1, 0, c2, 0], [0, c2, 0, c1]]),
