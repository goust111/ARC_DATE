+    seen: set[tuple[int, int]] = set()
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(n):
+        for c in range(n):
+            if (r, c) in seen:
+                continue
+            orbit = _orbit((r, c), n)
+            seen.update(orbit)
+            orbits.append(orbit)
+    return orbits
+
