+        return h - 1 - obj_h, c0, h - 2, c1
+    if side == "left":
+        return r0, w - obj_w, r1, w - 1
+    assert side == "right"
+    return r0, 0, r1, obj_w - 1
+
+
+def _travel_distance(rect: tuple[int, int, int, int], side: str, shape: tuple[int, int]) -> int:
+    dst = _destination(rect, side, shape)
+    if side == "top":
