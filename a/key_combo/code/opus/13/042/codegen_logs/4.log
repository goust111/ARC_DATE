+        if require_clip and not obj["clipped"]:
+            continue
+        score = 0
+        if side == "top":
+            score = anchor
+        else:
+            score = anchor
+        ranked.append((score, anchor))
+    ranked.sort(reverse=bool(require_clip))
+    return [anchor for _, anchor in ranked]
+
+
