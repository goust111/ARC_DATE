0015: def main(input_grid: np.ndarray) -> np.ndarray:
0016:     """
0017:     Swap each bordered square's colors and grow original-border-colored rectangles from its four sides.
0018: 
0019:     Input structure:
0020:     - The grid contains one or two separated square patterns on a black background.
0021:     - Each pattern has a solid inner square and a one-pixel outer border in a different color.
0022:     - There is enough surrounding black space for the pattern to grow outward.
0023: 
0024:     Rule:
0025:     - Split each pattern into its inner and outer square components.
0026:     - Swap the colors of the inner square and outer border.
0027:     - Add four rectangles outside the outer square, using the original border color.
0028: 
0029:     Key insight:
0030:     - The original border color becomes the growth material, while the original inner and
0031:       outer square colors trade places in the central pattern.
0032:     """
0033:     # Get the output grid with the same size as the input grid.
0034:     output_grid = np.copy(input_grid)
0035: 
0036:     # Detect the square pattern in the input grid.
0037:     entire_square = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
0038:     for each_square in entire_square:
0039:         # Detect the inner and outer squares in the pattern.
0040:         object_square = find_components(each_square, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
0041: 
0042:         # Split the square pattern into inner and outer squares.
0043:         split_objects = []
0044:         for obj in object_square:
0045:             _b = bbox(obj != Color.BLACK)
0046:             assert _b is not None
0047:             r, c, _r1, _c1 = _b
0048:             width = _r1 - r + 1
0049:             height = _c1 - c + 1
0050:             _b = bbox(obj != Color.BLACK)
0051:             assert _b is not None
0052:             shape = crop_bbox(obj, _b)
0053:             color = obj[r, c]
0054:             split_objects.append({'x': r, 'y': c, 'len': width, 'color': color, 'shape': shape})
0055: 
0056:         # Get the outer and inner square by comparing their size.
0057:         if split_objects[0]['len'] > split_objects[1]['len']:
0058:             outer_square = split_objects[0]
0059:             inner_square = split_objects[1]
0060:         else:
0061:             outer_square = split_objects[1]
0062:             inner_square = split_objects[0]
0063:         
0064:         # Swap the color between the inner and outer squares.
0065:         outer_square_pattern, inner_square_pattern = outer_square['shape'], inner_square['shape']
0066:         outer_square_pattern[outer_square_pattern == outer_square['color']] = inner_square['color']
0067:         inner_square_pattern[inner_square_pattern == inner_square['color']] = outer_square['color']
0068: 
0069:         # Draw the inner and outer squares after swaping on the output grid.
0070:         output_grid = paste(output_grid, outer_square_pattern, outer_square['x'], outer_square['y'], transparent=Color.BLACK, clip=True)
0071:         output_grid = paste(output_grid, inner_square_pattern, inner_square['x'], inner_square['y'], transparent=Color.BLACK, clip=True)
0072: 
0073:         # Draw the rectangle as growing from outer square, the width is the same as the length of the inner square.
0074:         # The rectangle is the same color as the original outer square.
0075:         rectangle_width, rectangle_height = outer_square['len'], inner_square['len']  
0076:         
0077:         # Create the rectangle pattern for the edges of the outer square.
0078:         rectangle_up_down = np.full((rectangle_width, rectangle_height), outer_square['color'])
0079:         rectangle_left_right = np.full((rectangle_height, rectangle_width), outer_square['color'])
0080: 
0081:         # Draw the rectangle on the four edges of the outer square.
0082:         output_grid = paste(output_grid, rectangle_up_down, outer_square['x'], outer_square['y'] - inner_square['len'], transparent=Color.BLACK, clip=True)
0083:         output_grid = paste(output_grid, rectangle_up_down, outer_square['x'], outer_square['y'] + outer_square['len'], transparent=Color.BLACK, clip=True)
0084:         output_grid = paste(output_grid, rectangle_left_right, outer_square['x'] - inner_square['len'], outer_square['y'], transparent=Color.BLACK, clip=True)
0085:         output_grid = paste(output_grid, rectangle_left_right, outer_square['x'] + outer_square['len'], outer_square['y'], transparent=Color.BLACK, clip=True)
0086: 
0087:     return output_grid
