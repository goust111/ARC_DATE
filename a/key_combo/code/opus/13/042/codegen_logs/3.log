0081: def _gen_partition_bands(total: int, line_count: int, rng: np.random.Generator) -> list[int]:
0082:     band_count = line_count + 1
0083:     remaining = total - line_count
0084:     widths = []
0085:     min_band, max_band = BAND_WIDTH_RANGE
0086:     for i in range(band_count):
0087:         left = band_count - i - 1
0088:         lo = max(min_band, remaining - max_band * left)
0089:         hi = min(max_band, remaining - min_band * left)
0090:         width = int(rng.integers(lo, hi + 1))
