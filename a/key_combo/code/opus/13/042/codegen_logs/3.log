+def _validate_generated_input(grid: np.ndarray) -> None:
+    _full_rows, _full_cols, row_regions, col_regions = _table_structure(grid)
+    n_rows = len(row_regions)
+    n_cols = len(col_regions)
+    assert (n_rows, n_cols) in TABLE_SHAPES
+
+    branch_counts = {
+        ("corner", True): 0,
+        ("corner", False): 0,
+        ("edge", True): 0,
+        ("edge", False): 0,
+        ("interior", True): 0,
+        ("interior", False): 0,
