+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+MAROON = 9
+
+CORE_COLORS = (BLUE, RED, YELLOW)
+TABLE_SHAPES = ((3, 4), (4, 3), (4, 4))
+BAND_VALUES = (6, 8)
+MAX_GEN_RETRIES = 300
