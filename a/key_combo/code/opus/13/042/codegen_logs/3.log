0100:     choices = []
0101:     for height in range(*GRID_HEIGHT_RANGE):
0102:         for width in range(*GRID_WIDTH_RANGE):
0103:             green = num_hlines * width + num_vlines * height - num_hlines * num_vlines
0104:             if height * width - green > green:
0105:                 choices.append((height, width))
0106:     height, width = choices[int(rng.integers(0, len(choices)))]
0107:     return height, width, num_hlines, num_vlines
