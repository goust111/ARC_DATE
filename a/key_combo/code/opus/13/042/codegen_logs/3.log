+    _fill_box(out, r0 - 2, c0 - 2, 8, 8, MAROON)
+    _fill_box(out, r0 - 1, c0 - 1, 6, 6, GREY)
+    _fill_box(out, r0 + 1, c0 + 1, 2, 2, core_color)
+    return out
