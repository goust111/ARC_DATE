+
+def _frame_candidates(grid: np.ndarray) -> list[tuple[int, int, int, int, int, int]]:
+    """Return (area, r0, c0, r1, c1, color) for every monochrome rectangular frame."""
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
