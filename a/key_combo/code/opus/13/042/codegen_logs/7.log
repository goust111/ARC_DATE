+    max_area = max(area for area, *_rest in candidates)
+    largest = [item for item in candidates if item[0] == max_area]
+    assert len(largest) == 1, "expected a unique largest rectangular frame"
+    _area, r0, c0, r1, c1, _color = largest[0]
