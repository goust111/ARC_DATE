+
+    pool = list(range(height + width - 1))
+    rng.shuffle(pool)
+    for total in pool:
+        residue = total % 3
+        if residue in selected:
+            continue
+        if _diag_length_slash(height, width, total) < min_length:
+            continue
+        selected[residue] = int(total)
+        if len(selected) == 3:
+            return selected
+    return None
