+    for c in range(w):
+        edge_targets.append((0, c))
+        edge_targets.append((h - 1, c))
+    for r in range(1, h - 1):
+        edge_targets.append((r, 0))
+        edge_targets.append((r, w - 1))
+    edge_targets = list(dict.fromkeys(edge_targets))
+    for r, c in edge_targets:
