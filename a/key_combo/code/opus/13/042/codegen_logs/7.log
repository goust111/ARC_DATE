+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+FRAME_COLOR = 6
+DIAGONAL_COLORS = (1, 2, 3)
+BLACK = 0
+MAX_GEN_ATTEMPTS = 800
+
+_SEEN_OUTPUTS: set[bytes] = set()
+_GEN_CALLS = 0
