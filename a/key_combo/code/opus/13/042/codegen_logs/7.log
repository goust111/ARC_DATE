+def _add_noise(grid: np.ndarray, frame_bbox: tuple[int, int, int, int], rng: random.Random) -> None:
+    h, w = map(int, grid.shape)
+    r0, c0, r1, c1 = map(int, frame_bbox)
+    outside = [
+        (r, c)
+        for r in range(h)
+        for c in range(w)
+        if not (r0 <= r <= r1 and c0 <= c <= c1)
