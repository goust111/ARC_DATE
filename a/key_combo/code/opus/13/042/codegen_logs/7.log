+    canvas = np.zeros((height, width), dtype=int)
+    for residue, color in residue_to_color.items():
+        invariant = residue_to_invariant[residue]
+        if orientation == "backslash":
+            for r in range(height):
+                c = int(r - invariant)
+                if 0 <= c < width:
+                    canvas[r, c] = int(color)
+        else:
+            for r in range(height):
+                c = int(invariant - r)
+                if 0 <= c < width:
+                    canvas[r, c] = int(color)
+    return canvas
