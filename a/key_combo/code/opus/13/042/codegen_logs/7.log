+    def valid(orientation: str) -> dict[int, int] | None:
+        mapping: dict[int, int] = {}
+        for color in colors:
+            coords = np.argwhere(g == color)
+            if orientation == "backslash":
+                invariants = {int(r - c) for r, c in coords}
+            else:
