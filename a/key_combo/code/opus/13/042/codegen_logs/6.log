+        cells_try = _classified_cells(grid_try.shape, sources_try)
+        if any(len(cells_try.get(color, ())) < 3 for color in colors):
+            continue
+        cross_try = _find_cross_pair(colors[0], colors[1], cells_try)
+        if cross_try is None:
