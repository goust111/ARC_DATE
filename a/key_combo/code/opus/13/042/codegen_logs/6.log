def draw_line(
    grid: np.ndarray,
    r: int,
    c: int,
    *,
    end_r: int | None = None,
    end_c: int | None = None,
    length: int | None = None,
    direction: tuple[int, int] | None = None,
    color: int,
    stop_at: set[int] | None = None,
