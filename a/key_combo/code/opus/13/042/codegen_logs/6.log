+    col_counts: dict[int, dict[int, int]],
+    used: set[Coord],
+) -> None:
+    a, b = pair
+    used.add(a)
+    used.add(b)
+    row_counts[color][a[0]] += 1
+    row_counts[color][b[0]] += 1
+    col_counts[color][a[1]] += 1
+    col_counts[color][b[1]] += 1
