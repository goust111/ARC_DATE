+def _border_cells(shape: tuple[int, int]) -> list[Coord]:
+    h, w = shape
+    cells = [(0, c) for c in range(w)] + [(h - 1, c) for c in range(w)]
+    cells += [(r, 0) for r in range(1, h - 1)] + [(r, w - 1) for r in range(1, h - 1)]
+    return cells
