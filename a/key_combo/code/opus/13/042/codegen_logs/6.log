+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+
+GEN_RETRY_LIMIT = 500
+GEN_SOURCE_LAYOUT_RETRIES = 120
+GEN_COLORS = (1, 2, 6, 8, 9)
+
+
+Coord = tuple[int, int]
