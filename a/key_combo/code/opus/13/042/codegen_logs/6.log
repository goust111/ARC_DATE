+    return None
+
+
+def _same_color_three_collinear(markers: dict[Coord, int]) -> bool:
+    rows: dict[tuple[int, int], int] = defaultdict(int)
+    cols: dict[tuple[int, int], int] = defaultdict(int)
+    for (r, c), color in markers.items():
+        rows[(color, r)] += 1
+        cols[(color, c)] += 1
