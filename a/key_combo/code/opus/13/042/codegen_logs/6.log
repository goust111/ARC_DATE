+
+    target_count = random.randint(max(6, len(markers)), min(10, len(markers) + 3))
+    filler_candidates = [
+        pos
+        for color in colors
+        for pos in cells[color]
+        if pos not in markers
+        and row_counts[color].get(pos[0], 0) == 0
+        and col_counts[color].get(pos[1], 0) == 0
