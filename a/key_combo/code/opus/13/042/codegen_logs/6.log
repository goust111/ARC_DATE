+
+def _source_priority(shape: tuple[int, int], coords: tuple[Coord, ...]) -> tuple[int, int, int]:
+    h, w = shape
+    ranks: list[tuple[int, int, int]] = []
+    for r, c in coords:
+        if r == 0:
+            ranks.append((0, c, 0))
+        elif c == 0:
+            ranks.append((1, r, 0))
+        elif r == h - 1:
+            ranks.append((2, c, 0))
+        elif c == w - 1:
+            ranks.append((3, r, 0))
+    assert ranks, "source must touch the border"
+    return min(ranks)
