+            if a[0] != b[0] and a[1] != b[1]:
+                continue
+            dist = abs(a[0] - b[0]) + abs(a[1] - b[1])
+            lo = min(a, b)
+            hi = max(a, b)
+            out.append(((dist, lo[0], lo[1], hi[0], hi[1]), a, b))
+    return sorted(out)
+
+
+def _best_partner_map(markers: dict[Coord, int], color: int) -> dict[Coord, Coord]:
