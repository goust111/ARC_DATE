+    expected_pairs.append((min(pair), max(pair), color))
+
+    markers = set(used)
+
+    tie_bonus = random.random() < 0.45
+    if tie_bonus:
+        tie_candidates = [
+            pos
+            for pos in _tie_cells(grid.shape, sources)
