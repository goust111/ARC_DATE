+            c0, c1 = sorted((a[1], b[1]))
+            horizontals.append({"color": color, "r": r, "c0": c0, "c1": c1, "a": a, "b": b})
+        else:
+            c = a[1]
+            r0, r1 = sorted((a[0], b[0]))
+            verticals.append({"color": color, "c": c, "r0": r0, "r1": r1, "a": a, "b": b})
