def _gen_safe_rows(region: dict[str, int | str], split_type: str) -> tuple[int, int] | None:
    r0 = int(region["r0"])
    r1 = int(region["r1"])
    if split_type == "horizontal":
        if region["side"] == "top":
            r1 -= 1
        else:
            r0 += 1
    if r0 > r1:
