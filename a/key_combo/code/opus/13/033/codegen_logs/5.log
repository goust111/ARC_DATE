+def _dent_candidates(mask: np.ndarray) -> tuple[list[tuple[tuple[int, int], ...]], list[tuple[tuple[int, int], ...]]]:
+    h, w = mask.shape
+    singles: list[tuple[tuple[int, int], ...]] = []
+    pairs: list[tuple[tuple[int, int], ...]] = []
+    for r in range(1, h - 1):
