+def _denoise(grid: np.ndarray, protected: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if protected[r, c]:
+                continue
+            color = int(grid[r, c])
+            if color in (BLACK, GREY):
