    if split_type == "vertical":
        if color == _GEN_BLUE and region["side"] == "right":
            max_gap -= _GEN_VERTICAL_SPLIT_CLEARANCE
        elif color == _GEN_TEAL and region["side"] == "left":
            max_gap -= _GEN_VERTICAL_SPLIT_CLEARANCE
    return min(_GEN_MAX_SLIDE_GAP, max_gap)


