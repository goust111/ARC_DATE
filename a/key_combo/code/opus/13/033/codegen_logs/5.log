+    sub = clean[r - 1 : r + 2, c - 1 : c + 2]
+    counts = {color: int(np.sum(sub == color)) for color in mapping}
+    total = sum(counts.values())
+    if total == 0:
+        return None
+    host, host_count = max(counts.items(), key=lambda item: item[1])
+    if host_count * 2 <= total:
+        return None
