+        stop_top, stop_left, collided, pre_steps = _slide_until_stop(state, r0, c0, patch, direction)
+        event = {
+            "id": obj["id"],
+            "color": color,
+            "initial_bbox": obj["bbox"],
+            "collided": bool(collided),
