+    obstacle_count = int(np.count_nonzero(grid == OBSTACLE) > 0)
+    if obstacle_count < 1:
+        return None
+    if obstacle_count == 1 and random.random() < 0.5:
+        _place_idle_obstacle(grid, forbidden=used_paths)
+
+    object_mask = np.isin(grid[1:-1, :], [TOP_BAR, BOTTOM_BAR, FRACTURE])
