+        paste(out, _paint_patch(placed["mask"], placed["color"]), r0, c0, transparent=BG)
+    return out
+
+
+def _semantic_checks(grid: np.ndarray, out: np.ndarray, proto_mask: np.ndarray, objects: list[dict]) -> None:
