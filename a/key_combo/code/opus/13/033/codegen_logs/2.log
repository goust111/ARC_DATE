+        placed.append(
+            {
+                "mask": obj["mask"],
+                "color": RED,
+                "bbox": (dest_r0, obj["c0"], dest_r0 + obj["mask"].shape[0] - 1, obj["c0"] + obj["mask"].shape[1] - 1),
+            }
+        )
