+                "mask": mask,
+                "c0": int(c0),
+                "input_r0": int(r0),
+                "input_bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "out_color": RED if is_match else BLUE,
+            }
+        )
+
+    out = np.zeros_like(g)
+    out[0, :] = RED
+    out[h - 1, :] = BLUE
