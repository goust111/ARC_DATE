19:def canonical_shape_key(mask: np.ndarray) -> tuple[bytes, tuple[int, int]]:
20:    """Canonicalize a boolean mask up to rotation and horizontal reflection."""
21:    canon = np.asarray(mask, dtype=bool)
22:    best = (canon.tobytes(), tuple(map(int, canon.shape)))
23:    for _ in range(4):
24:        canon = np.rot90(canon)
25:        for v in (canon, np.fliplr(canon)):
26:            key = (v.tobytes(), tuple(map(int, v.shape)))
27:            if key < best:
28:                best = key
29:    return best
