+def _compress_runs(mask: np.ndarray) -> np.ndarray:
+    rows = [0]
+    for r in range(1, mask.shape[0]):
+        if not np.array_equal(mask[r], mask[r - 1]):
+            rows.append(r)
+    mask = mask[rows, :]
