+        for obj, c0 in zip(left_objs, left_cols):
+            obj["c0"] = int(c0)
+        for obj, c0 in zip(right_objs, right_cols):
+            obj["c0"] = int(c0)
+
+        row_ok = True
+        for obj in candidates:
+            obj_h = obj["mask"].shape[0]
+            if obj["match"]:
+                low = 2
