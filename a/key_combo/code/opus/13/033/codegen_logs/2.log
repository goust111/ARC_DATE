+        for idx in range(n_mismatches):
+            stretched, used_extra = _choose_distractor(proto_mask, require_extra=(idx == 0))
+            candidates.append(
+                {
+                    "mask": stretched,
+                    "match": False,
+                    "used_extra": used_extra,
+                    "transform_nontrivial": False,
