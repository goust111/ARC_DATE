21:def _paint_corner_triangle(out: np.ndarray, corner: str, side: int, color: int) -> None:
22:    H, W = out.shape
23:    assert side > 0, "triangle side length must be positive"
24:    for r in range(H):
25:        for c in range(W):
26:            a, b = _corner_distances((H, W), corner, r, c)
27:            if a + b < side:
28:                out[r, c] = int(color)
