9:def _corner_distances(shape: tuple[int, int], corner: str, r: int, c: int) -> tuple[int, int]:
10:    H, W = shape
11:    if corner == "TL":
12:        return int(r), int(c)
13:    if corner == "TR":
14:        return int(r), int(W - 1 - c)
15:    if corner == "BL":
16:        return int(H - 1 - r), int(c)
17:    assert corner == "BR"
18:    return int(H - 1 - r), int(W - 1 - c)
