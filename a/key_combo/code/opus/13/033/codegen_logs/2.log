131:def _line_mask(h: int, w: int) -> np.ndarray:
132:    """Create a seed mask along a diagonal line spanning the bbox, randomly flipped."""
133:    mask = np.zeros((h, w), dtype=bool)
134:    if h == 1:
135:        mask[0, :] = True
136:        return mask
137:    if w == 1:
138:        mask[:, 0] = True
139:        return mask
140:    steps = max(h, w)
141:    for i in range(steps):
142:        r = int(round(i * (h - 1) / (steps - 1)))
143:        c = int(round(i * (w - 1) / (steps - 1)))
144:        mask[r, c] = True
145:    if bool(_RNG.integers(0, 2)):
146:        mask = np.flipud(mask)
147:    if bool(_RNG.integers(0, 2)):
148:        mask = np.fliplr(mask)
149:    return mask
150:
151:
152:def _make_mask(h: int, w: int, area: int) -> np.ndarray:
153:    """Grow an 8-connected mask from a line seed to the target area."""
154:    mask = _line_mask(h, w)
155:    while int(mask.sum()) < area:
156:        frontier = set()
157:        for r, c in np.argwhere(mask):
158:            for dr, dc in _NEIGHBORS8:
159:                nr, nc = int(r) + dr, int(c) + dc
160:                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
161:                    frontier.add((nr, nc))
162:        pick = list(frontier)
163:        nr, nc = pick[int(_RNG.integers(0, len(pick)))]
164:        mask[nr, nc] = True
165:    return mask
