172:def _gen_triangle_mask(shape, corner, side):
173:    H, W = shape
174:    rr, cc = np.indices((H, W))
175:    if corner == "TL":
176:        return rr + cc < side
177:    if corner == "TR":
178:        return rr + (W - 1 - cc) < side
179:    if corner == "BL":
180:        return (H - 1 - rr) + cc < side
181:    return (H - 1 - rr) + (W - 1 - cc) < side
