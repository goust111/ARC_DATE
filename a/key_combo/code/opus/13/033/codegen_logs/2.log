217:
218:def _gen_is_diagonal_symmetric_patch(patch):
219:    if patch.shape[0] != patch.shape[1]:
220:        return False
221:    main_ok = np.array_equal(patch, patch.T)
222:    return main_ok or np.array_equal(patch, _gen_reflect_anti_diagonal(patch))
223:
