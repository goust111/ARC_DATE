+    patch = np.zeros(mask.shape, dtype=int)
+    patch[mask] = int(color)
+    return patch
+
+
+def _horizontal_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[3] < b[1] or b[3] < a[1])
