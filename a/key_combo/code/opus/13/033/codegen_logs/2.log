7:def mask_from_coords(coords, shape: tuple[int, int]) -> np.ndarray:
8:    """Local helper: build a boolean mask from bbox-relative component coordinates."""
9:    m = np.zeros(shape, dtype=bool)
10:    H, W = shape
11:    for r, c in coords:
12:        rr = int(r)
13:        cc = int(c)
14:        assert 0 <= rr < H and 0 <= cc < W
15:        m[rr, cc] = True
16:    return m
