55:def main(grid: np.ndarray) -> np.ndarray:
56:    """
57:    Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.
58:
59:    Input structure:
60:    - The background is the dominant color.
61:    - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color
62:      sprite attached to a 5-pixel non-marker colored cross.
63:    - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly
64:      one side of the cross.
65:
66:    Rule:
67:    - Move the whole object straight away from its marker side until the object
68:      bbox touches the corresponding grid edge.
69:    - Keep the marker sprite unchanged within the object.
70:    - Rotate the 3x3 colored cross block by 180 degrees before placing it.
71:
72:    Key insight:
73:    The marker sprite is a directional tail; the cross is the leading payload,
74:    and only that payload turns around during the slide to the edge.
75:    """
76:    g = np.asarray(grid, dtype=int)
77:    H, W = g.shape
78:    bg = get_bg(g)
79:    marker = _marker_color(g, bg)
80:
81:    out = np.full_like(g, int(bg))
82:    objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)
83:    assert objects, "expected at least one composite object"
84:
85:    for obj in objects:
86:        assert int(obj["area"]) == 9, "each composite should contain 9 foreground pixels"
87:        r0, c0, _r1, _c1 = obj["bbox"]
88:        patch = crop_bbox(g, obj["bbox"])
89:        h, w = patch.shape
90:        moved = patch.copy()
91:
92:        if (h, w) == (3, 6):
93:            left = patch[:, :3]
94:            right = patch[:, 3:]
95:            left_kind = _block_kind(left, bg, marker)
96:            right_kind = _block_kind(right, bg, marker)
97:            assert {left_kind, right_kind} == {"marker", "cross"}, "expected one marker and one cross"
98:
99:            if left_kind == "marker":
100:                moved[:, 3:] = np.rot90(right, 2)
101:                target_r, target_c = int(r0), W - w
102:            else:
103:                moved[:, :3] = np.rot90(left, 2)
104:                target_r, target_c = int(r0), 0
105:
106:        elif (h, w) == (6, 3):
107:            top = patch[:3, :]
108:            bottom = patch[3:, :]
109:            top_kind = _block_kind(top, bg, marker)
110:            bottom_kind = _block_kind(bottom, bg, marker)
111:            assert {top_kind, bottom_kind} == {"marker", "cross"}, "expected one marker and one cross"
112:
113:            if top_kind == "marker":
114:                moved[3:, :] = np.rot90(bottom, 2)
115:                target_r, target_c = H - h, int(c0)
116:            else:
117:                moved[:3, :] = np.rot90(top, 2)
118:                target_r, target_c = 0, int(c0)
119:
120:        else:
121:            raise AssertionError("each composite bbox should be 3x6 or 6x3")
122:
123:        _paste_checked(out, moved, target_r, target_c, bg)
124:
125:    return out
