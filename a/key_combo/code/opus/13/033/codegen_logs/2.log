+
+
+def _expected_output_from_scene(height: int, width: int, objects: list[dict]) -> np.ndarray:
+    out = np.zeros((height, width), dtype=int)
+    out[0, :] = RED
+    out[height - 1, :] = BLUE
+    for placed in _slide_by_bbox(objects, height):
