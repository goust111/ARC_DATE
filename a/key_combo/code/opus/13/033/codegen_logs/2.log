223:def _dilate_occupied(occupied: np.ndarray) -> np.ndarray:
224:    """Return a mask that is True wherever occupied or any 8-neighbor is occupied."""
225:    dilated = occupied.copy()
226:    dilated[1:, :] |= occupied[:-1, :]
227:    dilated[:-1, :] |= occupied[1:, :]
228:    dilated[:, 1:] |= occupied[:, :-1]
229:    dilated[:, :-1] |= occupied[:, 1:]
230:    dilated[1:, 1:] |= occupied[:-1, :-1]
231:    dilated[1:, :-1] |= occupied[:-1, 1:]
232:    dilated[:-1, 1:] |= occupied[1:, :-1]
233:    dilated[:-1, :-1] |= occupied[1:, 1:]
234:    return dilated
