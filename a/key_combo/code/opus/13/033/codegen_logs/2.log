225:def _gen_patch_direction(patch):
226:    if patch.shape[0] != patch.shape[1]:
227:        return None
228:    n = patch.shape[0]
229:    main_ok = np.array_equal(patch, patch.T)
230:    anti_ok = np.array_equal(patch, _gen_reflect_anti_diagonal(patch))
231:    if main_ok:
232:        if patch[0, 0] and not patch[n - 1, n - 1]:
233:            return "TL"
234:        if patch[n - 1, n - 1] and not patch[0, 0]:
235:            return "BR"
236:    if anti_ok:
237:        if patch[0, n - 1] and not patch[n - 1, 0]:
238:            return "TR"
239:        if patch[n - 1, 0] and not patch[0, n - 1]:
240:            return "BL"
241:    return None
