168:def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
169:    """Paint a boolean mask into a colored patch on a bg-filled array."""
170:    pat = np.full(mask.shape, bg, dtype=int)
171:    pat[mask] = color
172:    return pat
