201:def _gen_patch_variants(patch):
202:    variants = []
203:    seen = set()
204:    for k in range(4):
205:        rotated = np.rot90(patch, k)
206:        for variant in (rotated, np.fliplr(rotated)):
207:            key = tuple(map(tuple, variant.astype(int)))
208:            if key not in seen:
209:                seen.add(key)
210:                variants.append(variant.copy())
211:    return variants
