+            if 0 < r < h - 1:
+                a = int(region_id[r - 1, c])
+                b = int(region_id[r + 1, c])
+                if a >= 0 and b >= 0 and a != b:
+                    adjacency[a].add(b)
+                    adjacency[b].add(a)
+            if 0 < c < w - 1:
+                a = int(region_id[r, c - 1])
+                b = int(region_id[r, c + 1])
+                if a >= 0 and b >= 0 and a != b:
+                    adjacency[a].add(b)
+                    adjacency[b].add(a)
