+        if rid in marked_ids:
+            if len(vals) != 1:
+                return False
+            val = next(iter(vals))
+            output_colors.add(val)
+            if rid in pair_partner:
+                if val != int(regions[pair_partner[rid]]["color"]):
+                    return False
+            else:
