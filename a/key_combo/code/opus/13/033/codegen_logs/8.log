+def _merge_partition(rows: int, cols: int, target_regions: int, rng: random.Random) -> np.ndarray | None:
+    labels = np.arange(rows * cols, dtype=int).reshape(rows, cols)
+    groups = {int(labels[r, c]): {(r, c)} for r in range(rows) for c in range(cols)}
+
+    def region_edges() -> list[tuple[int, int]]:
+        edges: set[tuple[int, int]] = set()
+        for r in range(rows):
+            for c in range(cols):
+                a = int(labels[r, c])
+                if r + 1 < rows:
