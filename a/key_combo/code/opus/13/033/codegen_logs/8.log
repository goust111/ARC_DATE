+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+PARTITION_TEMPLATES = (
+    np.array([[0, 1, 2], [0, 3, 2], [4, 3, 5]], dtype=int),
+    np.array([[0, 1, 1], [2, 3, 1], [2, 3, 4]], dtype=int),
+    np.array([[0, 1, 2], [3, 1, 4], [5, 6, 4]], dtype=int),
