+    pairs = info["pairs"]
+    pair_partner = info["pair_partner"]
+
+    if not (4 <= len(regions) <= 7):
+        return False
+    if not (3 <= len(marked_ids) <= 5):
+        return False
+    if len(marked_ids) >= len(regions):
+        return False
+    if not pairs:
+        return False
