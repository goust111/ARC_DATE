+            wall_c = col_starts[c] + col_widths[c]
+            r0 = row_starts[r]
+            r1 = r0 + row_heights[r]
+            grid[r0:r1, wall_c] = GREY
+    for r in range(rows - 1):
+        for c in range(cols):
