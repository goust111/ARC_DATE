+def _free_positions(height: int, width: int, occupied: list[tuple[int, int]]) -> list[tuple[int, int]]:
+    out = []
+    for r in range(height - FRAME_SIZE + 1):
+        for c in range(width - FRAME_SIZE + 1):
+            if _boxes_clear((r, c), occupied):
+                out.append((r, c))
+    return out
