+    if axis == "horizontal":
+        open_idx = random.randrange(count)
+        blocked_idx = random.randrange(1, count)
+        sides[open_idx] = "down"
+        sides[blocked_idx] = "left" if random.random() < 0.5 else "right"
+    else:
+        open_idx = random.randrange(count)
+        blocked_idx = random.randrange(1, count)
+        sides[open_idx] = "right"
+        sides[blocked_idx] = "up" if random.random() < 0.5 else "down"
