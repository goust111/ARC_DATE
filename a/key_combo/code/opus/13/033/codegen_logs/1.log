+    return candidates
+
+
+def _place_unpaired(grid: np.ndarray, color: int, preferred: list[tuple[int, int]] | None = None) -> bool:
+    candidates = []
+    if preferred:
+        candidates.extend(preferred)
+    for rr in range(grid.shape[0]):
+        for cc in range(grid.shape[1]):
