+
+def _mode_requirements(call_index: int) -> dict:
+    mode = call_index % 4
+    if mode == 0:
+        return {
+            "required_vecs": [(0, 1), (1, 0)],
+            "require_grey": True,
+            "require_color": False,
+            "require_order": False,
+            "min_dominoes": 2,
+        }
+    if mode == 1:
+        return {
+            "required_vecs": [(0, -1), (-1, 0)],
