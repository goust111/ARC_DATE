+    (0, 1): [(-1, 1), (1, 1)],   # right -> up-right, down-right
+    (0, -1): [(-1, -1), (1, -1)],  # left -> up-left, down-left
+    (1, 0): [(1, -1), (1, 1)],   # down -> down-left, down-right
+    (-1, 0): [(-1, -1), (-1, 1)],  # up -> up-left, up-right
