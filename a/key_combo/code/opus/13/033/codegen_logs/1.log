+            cell = (int(rr), int(cc))
+            if int(grid[cell]) != BLACK:
+                continue
+            if _touches_any_rg(grid, cell):
+                continue
+            candidates.append(cell)
+    seen: set[tuple[int, int]] = set()
+    unique = []
+    for cell in candidates:
+        if cell not in seen:
+            seen.add(cell)
+            unique.append(cell)
+    if not unique:
+        return False
+    cell = random.choice(unique)
+    grid[cell] = int(color)
+    return True
+
+
+def _place_grey(grid: np.ndarray, preferred: list[tuple[int, int]] | None = None) -> bool:
+    candidates = []
+    if preferred:
+        candidates.extend(preferred)
+    for rr in range(grid.shape[0]):
+        for cc in range(grid.shape[1]):
+            cell = (int(rr), int(cc))
+            if int(grid[cell]) != BLACK:
+                continue
+            if _touches_any_rg(grid, cell):
+                continue
+            candidates.append(cell)
+    seen: set[tuple[int, int]] = set()
+    unique = []
+    for cell in candidates:
+        if cell not in seen:
+            seen.add(cell)
+            unique.append(cell)
+    if not unique:
+        return False
+    cell = random.choice(unique)
+    grid[cell] = GREY
+    return True
