+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    """Return 4-connected components of a boolean mask as coord arrays."""
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
