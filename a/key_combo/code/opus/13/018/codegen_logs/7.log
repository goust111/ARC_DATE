+        max_gap = min(max_gap, max(width - 2, height - 2))
+        gap_size = int(rng.integers(1, min(3, max(width - 2, height - 2)) + 1))
+        side = random.choice(_feasible_sides(height, width, gap_size))
+        area = _cup_area(height, width, gap_size)
