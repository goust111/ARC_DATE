+def _infer_separator_color(grid: np.ndarray) -> int:
+    row_counts: Counter[int] = Counter()
+    col_counts: Counter[int] = Counter()
+    for r in range(grid.shape[0]):
+        row = grid[r]
+        if np.all(row == row[0]):
+            row_counts[int(row[0])] += 1
+    for c in range(grid.shape[1]):
