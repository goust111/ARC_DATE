  "trajectory": "paint the whole segment-width rectangular strip with the segment color",
  "transform": "keep the full-edge bar unchanged",
  "multi_step": "paint farther-from-bar strips before nearer-to-bar strips so nearer projections cover overlaps"
}
</annotation>
