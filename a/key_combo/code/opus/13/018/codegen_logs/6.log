+ORDERED_PAIR_CHOICES = (
+    ("top", "right"),
+    ("top", "left"),
+    ("right", "bottom"),
+    ("bottom", "left"),
+)
+
+
+def _runs(indices: list[int]) -> list[tuple[int, int]]:
+    if not indices:
+        return []
+    out = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+            continue
+        out.append((start, prev))
+        start = prev = idx
+    out.append((start, prev))
+    return out
+
+
+def _majority_color(block: np.ndarray) -> int:
