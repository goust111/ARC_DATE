    shape: 1-cell-thick bars parallel to the wall edge, length 2-9
    colors: distinct per segment, not bg or wall_color
    distance_to_wall: all distinct, range 2-14, min distance >= 2, gaps >= 2
    length_ordering: nearer segments <= farther segments [observed]
