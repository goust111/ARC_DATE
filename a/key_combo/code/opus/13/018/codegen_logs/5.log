  93:             gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)
  94:             if 0 <= gap < W:
  95:                 for r in span:
  96:                     out[int(r), int(gap)] = int(bg)
  97: 
  98:         step += 1
  99: 
