 281:         if len({r for r, _c in p}) < 2 or len({c for _r, c in p}) < 2:
 282:             continue
 283:         path = p
 284:         break
 285:     if path is None:
 286:         return None
 287: 
 288:     # sample uneven row/col gaps (eval-like) but keep at least 1 bg cell separation
 289:     row_gap = [int(np.random.randint(1, 6)) for _ in range(int(R) - 1)]
 290:     col_gap = [int(np.random.randint(1, 6)) for _ in range(int(C) - 1)]
 291:     top_margin = int(np.random.randint(1, 4))
 292:     left_margin = int(np.random.randint(1, 4))
 293: 
 294:     r0s = [int(top_margin)]
 295:     for k in range(int(R) - 1):
 296:         r0s.append(int(r0s[-1] + outer + row_gap[int(k)]))
 297:     c0s = [int(left_margin)]
 298:     for k in range(int(C) - 1):
 299:         c0s.append(int(c0s[-1] + outer + col_gap[int(k)]))
 300: 
 301:     # frame dicts (only for visited path cells)
 302:     slot_to_frame: dict[tuple[int, int], dict] = {}
 303:     frames: list[dict] = []
 304:     for rr, cc in path:
 305:         r0 = int(r0s[int(rr)])
 306:         c0 = int(c0s[int(cc)])
 307:         r1 = int(r0 + outer - 1)
 308:         c1 = int(c0 + outer - 1)
 309:         f = {
 310:             "bbox": (int(r0), int(c0), int(r1), int(c1)),
 311:             "inner_bbox": (int(r0 + t), int(c0 + t), int(r1 - t), int(c1 - t)),
 312:             "slot": (int(rr), int(cc)),
