 342:         cc = int(cc)
 343:         forbid = set(used_in_row[int(rr)]) | set(used_in_col[int(cc)]) | {int(start_color)}
 344:         choices = [int(x) for x in inner_palette if int(x) not in forbid]
 345:         if not choices:
