   5: def main(grid: np.ndarray) -> np.ndarray:
   6:     """
   7:     Propagate a repeating striped pattern from a yellow border segment toward the opposite edge, recoloring foreground objects on certain stripes.
   8: 
   9:     Input structure:
  10:     - bg = most common color. Foreground blobs of another color scattered in the interior.
  11:     - A short yellow (4) segment sits on one border edge.
  12: 
  13:     Rule:
  14:     - From the yellow segment, march toward the opposite edge in steps of 2 cells, cycling colors Y, Y, G (4, 4, 3). The 1-cell gap between stripes is forced to bg.
  15:     - Yellow stripes paint only within the segment's span.
  16:     - Green stripes additionally recolor all non-bg pixels across the entire row/column to green.
  17: 
  18:     Key insight: Green stripes act as a "flood" that recolors existing objects on the full row/column, while yellow stripes are confined to the segment span.
  19:     """
  20:     g = np.array(grid, dtype=int)
  21:     H, W = g.shape
  22:     bg = int(get_bg(g))
  23:     out = g.copy()
  24: 
  25:     Y = 4
  26:     G = 3
  27: 
  28:     border = np.zeros((H, W), dtype=bool)
  29:     border[0, :] = True
  30:     border[-1, :] = True
  31:     border[:, 0] = True
  32:     border[:, -1] = True
  33: 
  34:     smask = (g == int(Y)) & border
  35:     if not bool(smask.any()):
  36:         return out
  37: 
  38:     lab, n = label_mask(smask, connectivity=4)
  39:     if int(n) <= 0:
  40:         return out
  41: 
  42:     best_id = max(range(1, int(n) + 1), key=lambda cid: int((lab == int(cid)).sum()))
  43:     pts = np.argwhere(lab == int(best_id))
  44: 
  45:     rs = pts[:, 0]
  46:     cs = pts[:, 1]
  47:     r0, r1 = int(rs.min()), int(rs.max())
  48:     c0, c1 = int(cs.min()), int(cs.max())
  49: 
  50:     if r0 == r1:
  51:         orient = "h"
  52:         start_pos = int(r0)
  53:         cols = sorted(int(c) for c in cs)
  54:         span = list(range(int(cols[0]), int(cols[-1]) + 1))
  55:         dir1 = 1 if start_pos == 0 else -1
  56:         limit = H
  57:     elif c0 == c1:
  58:         orient = "v"
  59:         start_pos = int(c0)
  60:         rows = sorted(int(r) for r in rs)
  61:         span = list(range(int(rows[0]), int(rows[-1]) + 1))
  62:         dir1 = 1 if start_pos == 0 else -1
  63:         limit = W
  64:     else:
  65:         # Unexpected: not a straight edge segment.
  66:         return out
  67: 
  68:     cycle = [int(Y), int(Y), int(G)]
  69: 
  70:     step = 0
  71:     while True:
  72:         pos = int(start_pos) + int(dir1) * (2 * int(step))
  73:         if not (0 <= pos < int(limit)):
  74:             break
  75: 
  76:         col = int(cycle[int(step) % 3])
  77: 
  78:         if orient == "h":
  79:             if col == int(G):
  80:                 out[pos, :] = np.where(out[pos, :] != int(bg), int(G), out[pos, :])
  81:             for c in span:
  82:                 out[pos, int(c)] = col
  83:             # Force the 1-cell gap to background within the segment span.
  84:             gap = int(start_pos) + int(dir1) * (2 * int(step) + 1)
  85:             if 0 <= gap < H:
  86:                 for c in span:
  87:                     out[int(gap), int(c)] = int(bg)
  88:         else:
