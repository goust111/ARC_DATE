 332:     used_in_row: dict[int, set[int]] = defaultdict(set)
 333:     used_in_col: dict[int, set[int]] = defaultdict(set)
 334: 
 335:     start_color = int(np.random.choice(np.array(inner_palette, dtype=int)))
 336:     colors_by_slot: dict[tuple[int, int], int] = {(0, 0): int(start_color)}
 337:     used_in_row[0].add(int(start_color))
