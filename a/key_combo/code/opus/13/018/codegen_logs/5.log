   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Slide multi-color sprites to align their marker pixels with matching isolated border anchors.
  10: 
  11:     Input structure:
  12:     - bg = most common color.
  13:     - Multi-color sprites in the interior; each has a minority-color "marker" pixel.
  14:     - Isolated border pixels (non-bg with all 4-neighbors bg) act as anchors.
  15: 
  16:     Rule:
  17:     - Match each sprite to the border anchor sharing its marker color.
  18:     - Top/bottom-edge anchor (non-corner): slide sprite horizontally so marker column = anchor column.
  19:     - Left/right-edge anchor (or corner): slide sprite vertically so marker row = anchor row.
  20: 
  21:     Key insight: The anchor's edge position determines the slide axis — top/bottom means horizontal, left/right (or corner) means vertical.
  22:     """
  23:     g = np.array(grid, dtype=int)
  24:     H, W = g.shape
  25:     bg = int(get_bg(g))
  26: 
  27:     def is_border(r: int, c: int) -> bool:
  28:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))
  29: 
  30:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---
  31:     anchors_by_color: dict[int, tuple[int, int]] = {}
  32:     for r in range(H):
  33:         for c in range(W):
  34:             if not is_border(r, c):
  35:                 continue
  36:             v = int(g[r, c])
  37:             if v == int(bg):
  38:                 continue
  39:             ok = True
  40:             for rr, cc in neighbors4(int(r), int(c)):
  41:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):
  42:                     ok = False
  43:                     break
  44:             if ok and v not in anchors_by_color:
  45:                 anchors_by_color[int(v)] = (int(r), int(c))
  46: 
  47:     assert not (not anchors_by_color)
  48: 
  49:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}
  50: 
  51:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---
  52:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
  53: 
  54:     def component_marker_color(coords: np.ndarray) -> int | None:
  55:         # For multi-color sprites, the marker color is the least frequent color inside the component.
  56:         vals = [int(g[int(r), int(c)]) for r, c in coords]
  57:         cnt = Counter(vals)
  58:         if len(cnt) <= 1:
  59:             return None
  60:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
  61: 
  62:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:
  63:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).
  64:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]
  65:         if not pts:
  66:             return None
  67:         if len(pts) == 1:
  68:             return pts[0]
  69:         S = {(int(r), int(c)) for r, c in coords}
  70:         for r, c in pts:
  71:             for rr, cc in neighbors4(int(r), int(c)):
  72:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):
  73:                     return (int(r), int(c))
  74:         return pts[0]
  75: 
  76:     moves: list[tuple[np.ndarray, int, int]] = []
  77: 
  78:     for comp in comps:
  79:         coords = comp["coords"]
  80:         if coords.size == 0:
  81:             continue
  82: 
  83:         # --- STEP 3) Decide marker color for this component. ---
  84:         marker_col = component_marker_color(coords)
  85:         if marker_col is None:
  86:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.
  87:             if int(coords.shape[0]) != 1:
  88:                 continue
  89:             r, c = map(int, coords[0])
  90:             v = int(g[r, c])
  91:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:
  92:                 continue
  93:             marker_col = int(v)
  94: 
  95:         if int(marker_col) not in anchors_by_color:
  96:             continue
  97: 
  98:         mp = marker_pixel(coords, int(marker_col))
  99:         if mp is None:
 100:             continue
 101: 
 102:         ar, ac = anchors_by_color[int(marker_col)]
 103: 
 104:         # --- STEP 4) Compute translation (dr,dc). ---
 105:         on_top_bottom = int(ar) in (0, int(H - 1))
 106:         on_left_right = int(ac) in (0, int(W - 1))
 107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner
 108: 
 109:         dr = 0
 110:         dc = 0
 111:         if horizontal:
 112:             dc = int(ac - mp[1])
 113:         else:
 114:             dr = int(ar - mp[0])
 115: 
 116:         moves.append((coords, int(dr), int(dc)))
 117: 
 118:     out = g.copy()
 119: 
 120:     # --- STEP 5) Apply all moves. ---
 121:     # Clear moved components first (prevents collisions with their original locations).
 122:     for coords, _dr, _dc in moves:
 123:         out[coords[:, 0], coords[:, 1]] = int(bg)
 124: 
 125:     # Paste moved components:
 126:     # - clip out-of-bounds pixels
 127:     # - do not overwrite existing non-bg pixels
 128:     for coords, dr, dc in moves:
 129:         for r, c in coords:
 130:             rr = int(r) + int(dr)
 131:             cc = int(c) + int(dc)
 132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):
 133:                 out[rr, cc] = int(g[int(r), int(c)])
 134: 
 135:     return out
