 355:     # Build virtual output: frames + bridges + control row.
 356:     out = np.full((int(H), int(W)), int(bg), dtype=int)
 357:     for f in frames:
 358:         rr, cc = map(int, f["slot"])
 359:         r0, c0, _r1, _c1 = map(int, f["bbox"])
 360:         _draw_frame(out, r0=int(r0), c0=int(c0), outer=int(outer), t=int(t), border=int(border), inner_col=int(colors_by_slot[(rr, cc)]))
 361: 
 362:     # Bridges follow the 1-touch path.
 363:     bridge_cells_all: set[tuple[int, int]] = set()
 364:     ok = True
 365:     for a_slot, b_slot in zip(path, path[1:]):
 366:         fa = slot_to_frame[(int(a_slot[0]), int(a_slot[1]))]
 367:         fb = slot_to_frame[(int(b_slot[0]), int(b_slot[1]))]
 368:         cells = _bridge_cells(fa, fb)
 369:         if not cells:
 370:             ok = False
 371:             break
 372:         if cells & bridge_cells_all:
 373:             ok = False
 374:             break
 375:         for r, c in cells:
 376:             if not (0 <= int(r) < int(H) and 0 <= int(c) < int(W)):
 377:                 ok = False
 378:                 break
 379:             if int(out[int(r), int(c)]) != int(bg):
 380:                 ok = False
 381:                 break
 382:         if not ok:
 383:             break
 384:         paint = int(colors_by_slot[(int(a_slot[0]), int(a_slot[1]))])
 385:         for r, c in cells:
 386:             out[int(r), int(c)] = int(paint)
 387:         bridge_cells_all |= set(cells)
 388: 
 389:     if not ok:
 390:         return None
 391: 
 392:     # Control row encodes full visitation order. In eval, control pixels are at fixed columns:
 393:     # 1,3,5,... (gap=2), with bg everywhere else.
 394:     ctrl_colors = [int(colors_by_slot[(int(r), int(c))]) for r, c in path]
 395:     if len(ctrl_colors) < 2:
 396:         return None
 397:     ctrl_cols = [int(1 + 2 * i) for i in range(int(len(ctrl_colors)))]
 398:     if int(ctrl_cols[-1]) >= int(W):
 399:         return None
 400:     for col, cc in zip(ctrl_colors, ctrl_cols):
 401:         out[int(ctrl_r), int(cc)] = int(col)
 402: 
 403:     # Invert to input by erasing bridges.
 404:     inp = out.copy()
 405:     for r, c in bridge_cells_all:
 406:         inp[int(r), int(c)] = int(bg)
 407: 
 408:     # Ensure bg/border are inferred the way main() expects.
 409:     if int(get_bg(inp)) != int(bg):
 410:         return None
 411:     if int(_most_common_nonbg(inp, int(bg)) or -1) != int(border):
 412:         return None
 413: 
 414:     # Validate: running main() on input recreates the virtual output exactly.
 415:     try:
 416:         pred = main(inp)
 417:     except Exception:
 418:         return None
 419:     if pred.shape != out.shape:
 420:         return None
 421:     if not bool(np.array_equal(pred, out)):
 422:         return None
 423: 
 424:     return inp
