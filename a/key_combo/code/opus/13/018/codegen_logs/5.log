 271:             ]
 272:             if not opts:
 273:                 ok = False
 274:                 break
 275:             nxt = opts[int(np.random.randint(0, len(opts)))]
 276:             p.append((int(nxt[0]), int(nxt[1])))
 277:             vis.add((int(nxt[0]), int(nxt[1])))
