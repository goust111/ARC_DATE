+        coords = comp["coords"]
+        area = int(comp["area"])
+        actual_shift = area
+        block_source = None
+
+        for step in range(1, area + 1):
+            candidate = coords.copy()
+            candidate[:, 0] += step
+            if _touches_or_overlaps(candidate, settled_mask):
