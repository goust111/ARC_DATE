18:     """Tile each rectangular non-wall cavity with the colored seed pattern it already contains.
19: 
20:     Input structure
21:     - The dominant color forms solid walls around one or more rectangular cavities.
22:     - A unique most common non-wall color is the empty cavity color.
23:     - Each cavity contains exactly one other color, arranged as one copy of a repeat tile.
24: 
25:     Rule
26:     - For each 4-connected non-wall cavity, take the bbox of its seed color as the tile.
27:     - Repeat that tile across the entire cavity, preserving the phase set by the seed's current position.
28:     - Leave wall cells unchanged and leave tile-empty positions as the empty cavity color.
29: 
30:     Key insight
31:     - The colored pixels are not moved objects; they are one visible instance of a periodic mask that fills its containing rectangle.
32:     """
33:     g = np.asarray(grid, dtype=int)
34:     wall = get_bg(g)
35:     non_wall_colors = colors_present(g, exclude={wall})
36:     assert len(non_wall_colors) >= 2
37:     empty = _unique_most_common(g, non_wall_colors)
38: 
39:     out = g.copy()
40:     labels, n_regions = label_mask(g != wall, connectivity=4)
41:     assert n_regions >= 1
42: 
43:     for region_id in range(1, n_regions + 1):
44:         region_mask = labels == region_id
45:         region_bbox = bbox(region_mask)
46:         assert region_bbox is not None
47:         r0, c0, r1, c1 = region_bbox
48:         assert region_mask[r0 : r1 + 1, c0 : c1 + 1].all()
49: 
50:         region_colors = set(map(int, g[region_mask]))
51:         assert empty in region_colors
52:         seed_colors = region_colors - {empty}
53:         assert len(seed_colors) == 1
54:         seed_color = seed_colors.pop()
55: 
