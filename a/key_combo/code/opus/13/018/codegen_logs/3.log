+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+FOREGROUND_COLORS = (BLUE, RED, GREEN, YELLOW)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+NEIGHBORS8 = (
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
+    (1, 0),
