14: def main(input_grid):
15:     """
16:     Move the green object until it touches the red bar, then place a teal copy of the bar beyond it.
17: 
18:     Input structure:
19:     - The grid contains exactly one red bar and exactly one green object.
20:     - Both objects sit on a black background.
21:     - The scene may be rotated.
22: 
23:     Rule:
24:     - Find the shortest cardinal displacement that makes the green object touch the red bar.
25:     - Paste the green object at that touching position.
26:     - Recolor a copy of the red bar teal and translate it opposite the movement direction until clear.
27: 
28:     Key insight:
29:     - The red bar is both the contact target and the template for the teal bar placed on
30:       the far side of the moved green object.
31:     """
32:     # Plan:
33:     # 1. Detect the objects; separate the green thing from the red bar
34:     # 2. Move the green object to touch the red bar
35:     # 3. Add a teal bar on the other side of the green object
36: 
37:     # 1. Object detection and setup
38:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
39: 
40:     red_objects = [ obj for obj in objects if Color.RED in colors_present(obj, exclude={ Color.BLACK }) ]
41:     green_objects = [ obj for obj in objects if Color.GREEN in colors_present(obj, exclude={ Color.BLACK }) ]
42: 
43:     assert len(red_objects) == 1, "There should be exactly one red object"
44:     assert len(green_objects) == 1, "There should be exactly one green object"
45:     
46:     red_object = red_objects[0]
47:     green_object = green_objects[0]
48: 
49:     # Make the output grid: Start with the red object, then add the green object and the teal bar
50:     output_grid = np.full_like(input_grid, Color.BLACK)
51:     paste(output_grid, red_object, 0, 0, transparent=Color.BLACK, clip=True)
52: 
53:     # 2. Move the green object to touch the red bar
54:     # First calculate what direction we have to move in order to contact the grey object
55:     # Consider all displacements, starting with the smallest translations first
56:     possible_displacements = [ (i*dr, i*dc) for i in range(0, 30) for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)] ]
57: 
58:     # Only keep the displacements that cause a contact between the colored object and the grey object
59:     valid_displacements = [ displacement for displacement in possible_displacements
60:                             if contact(object1=translate(green_object, *displacement), object2=red_object) ]
61:     assert valid_displacements, "There should be at least one valid displacement"
62: 
63:     # Pick the smallest valid displacement
64:     displacement = min(valid_displacements, key=lambda displacement: sum(abs(r) for r in displacement))
65: 
66:     # Extract the direction from the displacement
67:     direction = np.sign(displacement, dtype=int)
68: 
69:     # Translate and draw on the canvas
70:     green_object = translate(green_object, *displacement)
71:     paste(output_grid, green_object, 0, 0, transparent=Color.BLACK, clip=True)
72: 
73:     # 3. Add a teal bar on the other side of the green object
74:     # It should be the same shape as the red bar, but teal
75:     # To place it correctly, it needs to be on the other side so we go in the opposite direction that the green object moved
76:     teal_object = red_object.copy()
77:     teal_object[teal_object != Color.BLACK] = Color.TEAL
78:     opposite_direction = -direction
79:     # Move the teal object until it doesn't collide with anything
80:     while collision(object1=teal_object, object2=output_grid):
81:         teal_object = translate(teal_object, *opposite_direction)
82:     # Draw the teal object on the canvas
83:     paste(output_grid, teal_object, 0, 0, transparent=Color.BLACK, clip=True)
84:     
85:     return output_grid
86: 
