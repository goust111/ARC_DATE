9: def main(grid: np.ndarray) -> np.ndarray:
10:     """Copy the marked sprite window into the marked empty window, aligned by the shared marker.
11: 
12:     Input structure
13:     - The dominant color is the outer background.
14:     - There are exactly two solid rectangular non-background windows.
15:     - Each window has one pixel of a shared marker color; only one window also
16:       contains the sprite color(s).
17: 
18:     Rule
19:     - The marker-only window gives the output size and fill color.
20:     - Translate every non-fill pixel from the sprite window so the source marker
21:       lands on the destination marker.
22: 
23:     Key insight
24:     The two equal marker pixels define the offset; the output is cropped to the
25:     marker-only window, not to the sprite window.
26:     """
27:     g = np.asarray(grid, dtype=int)
28:     assert g.ndim == 2
29: 
30:     bg = get_bg(g)
31:     windows = find_components(g, bg=bg, connectivity=4, monochromatic=False)
32:     assert len(windows) == 2
33: 
34:     regions = []
35:     for window in windows:
36:         r0, c0, r1, c1 = window["bbox"]
37:         region = g[r0 : r1 + 1, c0 : c1 + 1]
38:         assert int(window["area"]) == int(region.size)
39:         regions.append(region)
40: 
41:     colors = colors_present(g, exclude={bg})
42:     counts = Counter(map(int, g.ravel()))
43: 
44:     marker_candidates = [
45:         color
46:         for color in colors
47:         if counts[color] == len(regions)
48:         and all(np.count_nonzero(region == color) == 1 for region in regions)
49:     ]
50:     assert len(marker_candidates) == 1
51:     marker = marker_candidates[0]
52: 
53:     fill_candidates = [
54:         color
55:         for color in colors
56:         if color != marker and all(np.any(region == color) for region in regions)
57:     ]
58:     assert len(fill_candidates) == 1
59:     fill = fill_candidates[0]
60: 
61:     sprite_colors = [color for color in colors if color not in {fill, marker}]
62:     assert sprite_colors
63: 
64:     classified = []
65:     for region in regions:
66:         marker_coords = np.argwhere(region == marker)
67:         assert marker_coords.shape == (1, 2)
68:         has_sprite = any(np.any(region == color) for color in sprite_colors)
69:         classified.append((has_sprite, region, tuple(map(int, marker_coords[0]))))
70: 
71:     source = [item for item in classified if item[0]]
72:     destination = [item for item in classified if not item[0]]
73:     assert len(source) == 1
74:     assert len(destination) == 1
75: 
76:     _, src_region, src_marker = source[0]
77:     _, dst_region, dst_marker = destination[0]
78: 
79:     out = np.full(dst_region.shape, fill, dtype=int)
80:     dr = dst_marker[0] - src_marker[0]
81:     dc = dst_marker[1] - src_marker[1]
82: 
83:     for r, c in np.argwhere(src_region != fill):
84:         rr = int(r) + dr
85:         cc = int(c) + dc
86:         assert 0 <= rr < out.shape[0]
87:         assert 0 <= cc < out.shape[1]
88:         out[rr, cc] = src_region[r, c]
89: 
90:     return out
