+def _bbox_spans(coords: set[tuple[int, int]]) -> tuple[int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return max(rows) - min(rows) + 1, max(cols) - min(cols) + 1
