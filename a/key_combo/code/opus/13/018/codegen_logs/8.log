+def _is_connected(coords: set[tuple[int, int]], h: int, w: int) -> bool:
+    if not coords:
+        return False
+    start = next(iter(coords))
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if (nr, nc) in coords and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return len(seen) == len(coords)
+
