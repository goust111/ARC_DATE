 131: def _gen_make_sprite(h: int, w: int, color: int) -> np.ndarray | None:
 132:     """Build one connected colored sprite within bbox fill constraints."""
 133:     area = h * w
 134:     min_count = max(OBJECT_PIXEL_BOUNDS[0], int(np.ceil(MIN_BBOX_DENSITY * area)), h + w - 1)
 135:     max_count = min(OBJECT_PIXEL_BOUNDS[1], area)
 136:     if min_count > max_count:
 137:         return None
 138: 
 139:     for _ in range(SPRITE_RETRY_LIMIT):
 140:         target_count = np.random.randint(min_count, max_count + 1)
 141:         possible_modes = list(BASE_LINE_MODES)
 142:         if 2 * w + h - 2 <= target_count:
 143:             possible_modes.append(MODE_TOP_BOTTOM)
 144:         if 2 * h + w - 2 <= target_count:
 145:             possible_modes.append(MODE_LEFT_RIGHT)
 146:         if 2 * h + 2 * w - 4 <= target_count:
 147:             possible_modes.append(MODE_FRAME)
 148:         mode = possible_modes[np.random.randint(0, len(possible_modes))]
 149:         mask = _gen_line_mask(h, w, mode)
 150:         if int(mask.sum()) > target_count:
 151:             continue
 152:         mask = _gen_grow_connected(mask, target_count)
 153:         if mask is not None:
 154:             sprite = np.zeros((h, w), dtype=int)
 155:             sprite[mask] = color
 156:             return sprite
 157:     return None
 158: 
