 109: def _gen_frontier(mask: np.ndarray) -> np.ndarray:
 110:     """Return empty cells 4-adjacent to the current connected mask."""
 111:     frontier = np.zeros_like(mask, dtype=bool)
 112:     frontier[1:, :] |= mask[:-1, :]
 113:     frontier[:-1, :] |= mask[1:, :]
 114:     frontier[:, 1:] |= mask[:, :-1]
 115:     frontier[:, :-1] |= mask[:, 1:]
 116:     frontier &= ~mask
 117:     return frontier
 118: 
 119: 
 120: def _gen_grow_connected(mask: np.ndarray, target_count: int) -> np.ndarray | None:
 121:     """Grow mask by random frontier cells until it reaches target_count."""
 122:     while int(mask.sum()) < target_count:
 123:         frontier = np.argwhere(_gen_frontier(mask))
 124:         if len(frontier) == 0:
 125:             return None
 126:         r, c = frontier[np.random.randint(0, len(frontier))]
 127:         mask[r, c] = True
 128:     return mask
 129: 
