 140:         coords = placements[int(rng.integers(0, len(placements)))]
 141:         for r, c in coords:
 142:             grid[r, c] = GEN_FOREGROUND
 143:         domino_boxes.append(bbox_coords(np.array(coords, dtype=int)))
 144:     return domino_boxes
