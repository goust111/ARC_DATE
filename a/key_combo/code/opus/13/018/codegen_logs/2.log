 133: EDGES = ("top", "bottom", "left", "right")
 134: HORIZONTAL_EDGES = {"top", "bottom"}
 135: BACKGROUND_COLOR = 0
 136: WALL_COLOR = 5
 137: SEGMENT_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
 138: SEGMENT_COUNT_RANGE = (3, 4)
