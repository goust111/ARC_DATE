 407: def _place_palette(grid, occ, pal, side, rng):
 408:     """Place palette on the chosen edge and mark its occupancy (with 1-cell padding)."""
 409:     H, W = grid.shape
 410:     pal_h, pal_w = pal.shape
 411:     if side == 'top':
 412:         pr0, pc0 = 0, rng.randint(0, W - pal_w)
 413:     elif side == 'bottom':
 414:         pr0, pc0 = H - pal_h, rng.randint(0, W - pal_w)
 415:     elif side == 'left':
 416:         pr0, pc0 = rng.randint(0, H - pal_h), 0
 417:     else:
 418:         pr0, pc0 = rng.randint(0, H - pal_h), W - pal_w
 419:     grid[pr0:pr0 + pal_h, pc0:pc0 + pal_w] = pal
 420:     occ[max(0, pr0 - 1):min(H, pr0 + pal_h + 1),
 421:         max(0, pc0 - 1):min(W, pc0 + pal_w + 1)] = True
 422: 
