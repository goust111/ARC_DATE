 441:     """Render a sprite onto the grid: border cells in color, hole cells in fill (if given)."""
 442:     grid[r0:r0 + mask.shape[0], c0:c0 + mask.shape[1]][mask] = color
 443:     if fill is not None:
 444:         for hpts in holes:
 445:             for hr, hc in hpts:
 446:                 grid[r0 + hr, c0 + hc] = fill
