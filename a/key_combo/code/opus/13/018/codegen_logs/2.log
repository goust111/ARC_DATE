 204: def _gen_projection_bbox(edge: str, h: int, w: int, distance: int, span: tuple[int, int]) -> BBox:
 205:     s0, s1 = span
 206:     if edge == "top":
 207:         row = distance + 1
 208:         return 1, s0, row, s1
 209:     if edge == "bottom":
 210:         row = h - 2 - distance
 211:         return row, s0, h - 2, s1
 212:     if edge == "left":
 213:         col = distance + 1
 214:         return s0, 1, s1, col
 215:     col = w - 2 - distance
 216:     return s0, col, s1, w - 2
 217: 
