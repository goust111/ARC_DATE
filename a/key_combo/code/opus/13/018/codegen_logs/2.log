 402: def _gen_instance_at(
 403:     origin: Cell,
 404:     scale: int,
 405:     source_rel: list[Cell],
 406:     marker_rel: list[Cell],
 407:     h: int,
 408:     w: int,
 409: ) -> dict | None:
 410:     origin_r, origin_c = origin
 411:     marker_boxes: list[Box] = []
 412:     marker_cells: set[Cell] = set()
 413:     source_cells: set[Cell] = set()
 414: 
 415:     for rel_r, rel_c in marker_rel:
 416:         r0 = origin_r + rel_r * scale
 417:         c0 = origin_c + rel_c * scale
 418:         if r0 < 0 or c0 < 0 or r0 + scale > h or c0 + scale > w:
 419:             return None
 420:         box = (r0, c0, r0 + scale - 1, c0 + scale - 1)
 421:         if any(not _gen_boxes_have_gap(box, other, PLACEMENT_GAP) for other in marker_boxes):
 422:             return None
 423:         marker_boxes.append(box)
 424:         marker_cells |= _gen_block_cells(r0, c0, scale, h, w)
 425: 
 426:     for rel_r, rel_c in source_rel:
 427:         r0 = origin_r + rel_r * scale
 428:         c0 = origin_c + rel_c * scale
 429:         cells = _gen_block_cells(r0, c0, scale, h, w)
 430:         if not cells:
 431:             return None
 432:         source_cells |= cells
 433: 
 434:     if marker_cells & source_cells:
 435:         return None
 436:     return {
 437:         "origin": origin,
 438:         "scale": scale,
 439:         "marker_boxes": marker_boxes,
 440:         "marker_cells": marker_cells,
 441:         "source_cells": source_cells,
 442:         "cells": marker_cells | source_cells,
 443:     }
 444: 
 445: 
 446: def _gen_origin_ranges(
 447:     scale: int,
 448:     source_rel: list[Cell],
 449:     marker_rel: list[Cell],
 450:     h: int,
 451:     w: int,
 452: ) -> tuple[range, range] | None:
 453:     min_r = max(-rel_r * scale for rel_r, _ in marker_rel)
 454:     max_r = min(h - scale - rel_r * scale for rel_r, _ in marker_rel)
 455:     min_c = max(-rel_c * scale for _, rel_c in marker_rel)
 456:     max_c = min(w - scale - rel_c * scale for _, rel_c in marker_rel)
 457: 
 458:     min_r = max(min_r, max(-rel_r * scale - scale + 1 for rel_r, _ in source_rel))
 459:     max_r = min(max_r, min(h - 1 - rel_r * scale for rel_r, _ in source_rel))
 460:     min_c = max(min_c, max(-rel_c * scale - scale + 1 for _, rel_c in source_rel))
 461:     max_c = min(max_c, min(w - 1 - rel_c * scale for _, rel_c in source_rel))
 462:     if min_r > max_r or min_c > max_c:
 463:         return None
 464:     return range(min_r, max_r + 1), range(min_c, max_c + 1)
 465: 
