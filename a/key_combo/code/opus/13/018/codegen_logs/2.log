 358:     H = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
 359:     W = random.randint(GRID_SIZE_MIN, GRID_SIZE_MAX)
 360:     grid = np.full((H, W), bg_color, dtype=int)
