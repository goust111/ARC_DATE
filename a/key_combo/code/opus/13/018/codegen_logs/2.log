 168: def _gen_spans(lengths: list[int], axis_len: int) -> list[tuple[int, int]]:
 169:     overlap_pair = set(random.sample(range(len(lengths)), 2))
 170:     shared_axis_cell = random.randrange(axis_len)
 171:     spans: list[tuple[int, int]] = []
 172: 
 173:     for i, length in enumerate(lengths):
 174:         if i in overlap_pair:
 175:             lo = max(0, shared_axis_cell - length + 1)
 176:             hi = min(shared_axis_cell, axis_len - length)
 177:             start = random.randint(lo, hi)
 178:         else:
 179:             start = random.randint(0, axis_len - length)
 180:         spans.append((start, start + length - 1))
 181: 
 182:     return spans
 183: 
