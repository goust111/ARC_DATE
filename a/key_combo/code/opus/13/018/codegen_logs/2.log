 269: def _gen_attempt() -> np.ndarray | None:
 270:     h = random.randint(*GRID_SIZE_RANGE)
 271:     w = random.randint(*GRID_SIZE_RANGE)
 272:     edge = random.choice(EDGES)
 273:     segments = _gen_segments(edge, h, w)
 274:     if segments is None:
 275:         return None
 276: 
 277:     out = _gen_render_output(h, w, edge, segments)
 278:     inp = _gen_derive_input(out, edge, segments)
 279:     if not np.array_equal(main(inp), out):
 280:         return None
 281:     return inp
