 132: def _gen_place_dominoes(rng, grid: np.ndarray, domino_count: int):
 133:     """Place requested dominoes, returning their bounding boxes or None on crowding."""
 134:     domino_boxes: list[tuple[int, int, int, int]] = []
 135:     for _ in range(domino_count):
 136:         horizontal = bool(rng.integers(0, GEN_ORIENTATION_COUNT))
 137:         placements = _gen_domino_placements(grid, horizontal)
 138:         if not placements:
