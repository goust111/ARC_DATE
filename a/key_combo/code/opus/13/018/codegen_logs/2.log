 467: def _gen_place_instance(
 468:     scale: int,
 469:     source_rel: list[Cell],
 470:     marker_rel: list[Cell],
 471:     h: int,
 472:     w: int,
 473:     occupied: set[Cell],
 474:     marker_boxes: list[Box],
 475: ) -> dict | None:
 476:     ranges = _gen_origin_ranges(scale, source_rel, marker_rel, h, w)
 477:     if ranges is None:
 478:         return None
 479:     rows, cols = ranges
 480:     candidates = [(r, c) for r in rows for c in cols]
 481:     random.shuffle(candidates)
 482:     for origin in candidates:
 483:         inst = _gen_instance_at(origin, scale, source_rel, marker_rel, h, w)
 484:         if inst is None or inst["cells"] & occupied:
 485:             continue
 486:         if any(
 487:             not _gen_boxes_have_gap(box, old_box, PLACEMENT_GAP)
 488:             for box in inst["marker_boxes"]
 489:             for old_box in marker_boxes
 490:         ):
 491:             continue
 492:         return inst
 493:     return None
 494: 
