 227: def _gen_rows_for_rects(
 228:     safe_r0: int, safe_r1: int, rects: list[tuple[int, int]], rng: np.random.Generator
 229: ) -> list[int]:
 230:     used = sum(h for h, _ in rects)
 231:     min_between = _GEN_MIN_ROW_GAP * (len(rects) - 1)
 232:     extra = safe_r1 - safe_r0 + 1 - used - min_between
 233:     slots = rng.multinomial(extra, np.full(len(rects) + 1, 1 / (len(rects) + 1)))
 234: 
 235:     rows = []
 236:     r = safe_r0 + int(slots[0])
 237:     for i, (h, _) in enumerate(rects):
 238:         rows.append(r)
 239:         r += h
 240:         if i < len(rects) - 1:
 241:             r += _GEN_MIN_ROW_GAP + int(slots[i + 1])
 242:     return rows
