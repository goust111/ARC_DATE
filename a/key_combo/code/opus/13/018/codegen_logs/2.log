 185: def _gen_segments(edge: str, h: int, w: int) -> list[tuple[int, int, tuple[int, int]]] | None:
 186:     count = random.randint(*SEGMENT_COUNT_RANGE)
 187:     if edge in HORIZONTAL_EDGES:
 188:         perp_dim, axis_len = h, w
 189:     else:
 190:         perp_dim, axis_len = w, h
 191:     max_distance = min(DISTANCE_RANGE[1], perp_dim - PERP_DISTANCE_MARGIN)
 192:     max_length = min(axis_len - AXIS_LENGTH_MARGIN, SEGMENT_LENGTH_RANGE[1])
 193: 
 194:     distances = _gen_distance_set(count, max_distance)
 195:     if distances is None:
 196:         return None
 197: 
 198:     lengths = _gen_ordered_lengths(count, max_length)
 199:     spans = _gen_spans(lengths, axis_len)
 200:     colors = random.sample(SEGMENT_COLORS, count)
 201:     return list(zip(distances, colors, spans))
