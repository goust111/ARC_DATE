 496: def _gen_grouping_unambiguous(instances: list[dict], marker_rel: list[Cell]) -> bool:
 497:     if len(marker_rel) == 1:
 498:         return True
 499:     delta = (
 500:         (marker_rel[1][0] - marker_rel[0][0]),
 501:         (marker_rel[1][1] - marker_rel[0][1]),
 502:     )
 503:     records: list[tuple[int, int, int, int]] = []
 504:     expected: set[frozenset[int]] = set()
 505:     for gi, inst in enumerate(instances):
 506:         group_ids: list[int] = []
 507:         origin_r, origin_c = inst["origin"]
 508:         scale = inst["scale"]
 509:         for rel_r, rel_c in marker_rel:
 510:             group_ids.append(len(records))
 511:             records.append((scale, origin_r + rel_r * scale, origin_c + rel_c * scale, gi))
 512:         expected.add(frozenset(group_ids))
 513: 
 514:     found: set[frozenset[int]] = set()
 515:     for i, (ki, ri, ci, _gi) in enumerate(records):
 516:         for j, (kj, rj, cj, _gj) in enumerate(records):
 517:             if i >= j or ki != kj:
 518:                 continue
 519:             dr, dc = rj - ri, cj - ci
 520:             if (dr, dc) in (
 521:                 (delta[0] * ki, delta[1] * ki),
 522:                 (-delta[0] * ki, -delta[1] * ki),
 523:             ):
 524:                 found.add(frozenset((i, j)))
 525:     return found == expected
 526: 
 527: 
 528: def _gen_place_template(
 529:     template: np.ndarray,
 530:     h: int,
 531:     w: int,
 532:     occupied: set[Cell],
 533:     marker_boxes: list[Box],
 534: ) -> Cell | None:
 535:     th, tw = template.shape
 536:     rel_cells = [tuple(map(int, rc)) for rc in np.argwhere(template != BACKGROUND_COLOR)]
 537:     candidates = [(r, c) for r in range(h - th + 1) for c in range(w - tw + 1)]
 538:     random.shuffle(candidates)
 539:     for r0, c0 in candidates:
 540:         template_box = (r0, c0, r0 + th - 1, c0 + tw - 1)
 541:         if any(not _gen_boxes_have_gap(template_box, box, PLACEMENT_GAP) for box in marker_boxes):
 542:             continue
 543:         cells = {(r0 + r, c0 + c) for r, c in rel_cells}
 544:         if cells & occupied:
 545:             continue
 546:         return r0, c0
 547:     return None
 548: 
