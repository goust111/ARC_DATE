 204: def _gen_attempt() -> np.ndarray | None:
 205:     H, W, h, w = _gen_sample_dimensions()
 206:     color = np.random.randint(COLOR_BOUNDS[0], COLOR_BOUNDS[1] + 1)
 207: 
 208:     sprite = _gen_make_sprite(h, w, color)
 209:     if sprite is None:
 210:         return None
 211:     if int(np.count_nonzero(sprite)) >= H * W * MAX_OBJECT_CANVAS_FRACTION:
 212:         return None
 213: 
 214:     r0 = np.random.randint(EDGE_MARGIN, H - h - EDGE_MARGIN + 1)
 215:     valid_lefts, clipped_lefts = _gen_left_offsets(H, W, r0, sprite, color)
 216:     if not valid_lefts:
 217:         return None
 218: 
 219:     c0 = _gen_choose_left(valid_lefts, clipped_lefts)
 220:     inp = np.zeros((H, W), dtype=int)
 221:     _gen_paste(inp, sprite, r0, c0, transparent=BACKGROUND_COLOR)
 222:     out, lost = _gen_shear(inp, color)
 223:     if not (0 <= lost <= MAX_LOST_PIXELS):
 224:         return None
 225:     if not np.array_equal(main(inp), out):
 226:         return None
 227:     return inp
 228: 
 229: 
 230: def generate_input() -> np.ndarray:
 231:     for _ in range(GENERATOR_RETRY_LIMIT):
 232:         grid = _gen_attempt()
 233:         if grid is not None:
 234:             return grid
 235:     raise RuntimeError("failed to generate valid input")

