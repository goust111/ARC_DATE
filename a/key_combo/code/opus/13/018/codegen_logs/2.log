 161: def _gen_ordered_lengths(count: int, max_length: int) -> list[int]:
 162:     min_length, _ = SEGMENT_LENGTH_RANGE
 163:     lengths = [random.randint(min_length, max_length) for _ in range(count)]
 164:     lengths.sort()
 165:     return lengths
 166: 
