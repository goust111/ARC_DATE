 525:         core_bbox, full_bbox = placed
 526:         placed_bboxes.append(full_bbox)
 527: 
 528:         cr0, cr1, cc0, cc1 = core_bbox
 529:         output_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color
 530:         input_grid[cr0:cr1 + 1, cc0:cc1 + 1] = obj_color
 531: 
 532:         for side, defect_type in zip(sides, defect_types):
