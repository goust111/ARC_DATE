 618: def _gen_input_if_solver_matches(out: np.ndarray, instances: list[dict]) -> np.ndarray | None:
 619:     """Remove source completions and keep only grids accepted by the solver oracle."""
 620:     inp = out.copy()
 621:     for inst in instances:
 622:         for r, c in inst["source_cells"]:
 623:             inp[r, c] = BACKGROUND_COLOR
 624: 
 625:     try:
 626:         if np.array_equal(main(inp), out):
 627:             return inp
 628:     except Exception:
 629:         return None
 630:     return None
