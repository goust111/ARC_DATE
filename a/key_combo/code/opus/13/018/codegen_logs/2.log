 134: def _gen_paths(width, n_cells, left_row, right_row):
 135:     start = (left_row, 0)
 136:     goal = (right_row, width - 1)
 137:     paths = []
 138: 
 139:     def dfs(path):
 140:         if len(path) == n_cells:
 141:             if path[-1] == goal and _gen_path_is_valid(path, width):
 142:                 paths.append(tuple(path))
 143:             return
 144: 
 145:         remaining_steps = n_cells - len(path) - 1
 146:         for nr, nc in _gen_neighbors(*path[-1], width):
 147:             if (nr, nc) in path:
 148:                 continue
 149:             if abs(nr - goal[0]) + abs(nc - goal[1]) > remaining_steps:
 150:                 continue
 151:             dfs(path + [(nr, nc)])
 152: 
 153:     dfs([start])
 154:     return paths
 155: 
 156: 
 157: def _gen_render_path(width, path, color):
 158:     group = np.zeros((GEN_HEIGHT, width), dtype=int)
 159:     rows, cols = zip(*path)
 160:     group[rows, cols] = color
 161:     return group
 162: 
 163: 
 164: def _gen_random_group(left_row, color):
 165:     n_cells = random.choice(GROUP_CELL_CHOICES)
 166:     options = []
 167:     for width in GROUP_WIDTH_CHOICES:
 168:         for right_row in range(GEN_HEIGHT):
 169:             for path in _gen_paths(width, n_cells, left_row, right_row):
 170:                 options.append((width, path))
 171: 
 172:     width, path = random.choice(options)
 173:     return _gen_render_path(width, path, color)
