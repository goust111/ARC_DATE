  78: def _gen_line_mask(h: int, w: int, mode: int) -> np.ndarray:
  79:     """Return the seed mask for one connected-line template."""
  80:     mask = np.zeros((h, w), dtype=bool)
  81:     if mode == MODE_FREE_CROSS:
  82:         rr = np.random.randint(0, h)
  83:         cc = np.random.randint(0, w)
  84:         mask[rr, :] = True
  85:         mask[:, cc] = True
  86:     elif mode == MODE_EDGE_L:
  87:         rr = np.random.choice([0, h - 1])
  88:         cc = np.random.choice([0, w - 1])
  89:         mask[rr, :] = True
  90:         mask[:, cc] = True
  91:     elif mode == MODE_TOP_BOTTOM:
  92:         cc = np.random.randint(0, w)
  93:         mask[0, :] = True
  94:         mask[h - 1, :] = True
  95:         mask[:, cc] = True
  96:     elif mode == MODE_LEFT_RIGHT:
  97:         rr = np.random.randint(0, h)
  98:         mask[:, 0] = True
  99:         mask[:, w - 1] = True
 100:         mask[rr, :] = True
 101:     else:
 102:         mask[0, :] = True
 103:         mask[h - 1, :] = True
 104:         mask[:, 0] = True
 105:         mask[:, w - 1] = True
 106:     return mask
 107: 
