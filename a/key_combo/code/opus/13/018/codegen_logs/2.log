 219: def _gen_fill_bbox(grid: np.ndarray, bbox: BBox, color: int) -> None:
 220:     r0, c0, r1, c1 = bbox
 221:     grid[r0 : r1 + 1, c0 : c1 + 1] = color
 222: 
