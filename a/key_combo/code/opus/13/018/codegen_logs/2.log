  42:     out = np.full_like(g, bg)
  43:     width = g.shape[1]
  44:     for r, c in components[0]:
  45:         r = int(r)
  46:         c = int(c)
  47:         assert 0 <= r < g.shape[0] and 0 <= c < width
  48:         new_c = c - (int(bottom) - r)
  49:         if 0 <= new_c < width:
