 224: def _gen_paint_wall(grid: np.ndarray, edge: str) -> None:
 225:     if edge == "top":
 226:         grid[0, :] = WALL_COLOR
 227:     elif edge == "bottom":
 228:         grid[-1, :] = WALL_COLOR
 229:     elif edge == "left":
 230:         grid[:, 0] = WALL_COLOR
 231:     else:
 232:         grid[:, -1] = WALL_COLOR
 233: 
