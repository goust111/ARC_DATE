 158: def _gen_matches_oracle(grid: np.ndarray, boxes: list[tuple[int, int, int, int]]) -> bool:
 159:     """Check that the independent border renderer agrees with main()."""
 160:     expected = grid.copy()
 161:     for box in boxes:
 162:         _gen_paint_expected_border(expected, box)
 163:     try:
 164:         actual = main(grid)
 165:     except Exception:
 166:         return False
 167:     return np.array_equal(actual, expected)
