 100: def main(grid: np.ndarray) -> np.ndarray:
 101:     """
 102:     Extend every colored segment straight toward the single solid edge bar, with nearer segments covering farther projections.
 103: 
 104:     Input structure
 105:     - The background is the dominant color.
 106:     - Exactly one full grid edge is a solid non-background bar.
 107:     - All other foreground objects are 4-connected, monochrome, one-cell-thick segments parallel to that edge.
 108: 
 109:     Rule
 110:     - Each segment paints the rectangular strip from itself to the cell before the edge bar, perpendicular to the segment.
 111:     - Strips farther from the edge bar are painted first; closer strips overwrite them wherever their rectangular regions overlap.
 112:     - The original edge bar remains unchanged.
 113: 
 114:     Key insight
 115:     - The edge bar acts as the direction cue and occluding wall: every segment casts a same-color projection toward it, and distance to the wall determines visible layering.
 116:     """
 117:     g = np.asarray(grid, dtype=int)
 118:     assert g.ndim == 2
 119:     bg = int(get_bg(g))
 120:     edge, wall_color = _full_edge_bar(g, bg)
 121:     projections = _segment_projections(g, bg, edge, wall_color)
 122:     _assert_no_equal_distance_color_conflicts(projections)
 123: 
 124:     out = g.copy()
 125:     for _distance, color, (r0, c0, r1, c1) in sorted(projections, key=lambda item: item[0], reverse=True):
 126:         out[r0 : r1 + 1, c0 : c1 + 1] = color
 127:     return out
 128: 
