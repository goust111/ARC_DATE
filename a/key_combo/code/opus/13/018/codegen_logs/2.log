 396: def _gen_block_cells(r0: int, c0: int, k: int, h: int, w: int) -> set[Cell]:
 397:     rr0, cc0 = max(0, r0), max(0, c0)
 398:     rr1, cc1 = min(h, r0 + k), min(w, c0 + k)
 399:     return {(r, c) for r in range(rr0, rr1) for c in range(cc0, cc1)}
