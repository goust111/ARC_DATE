 372: def _object_overlaps(full_bbox: tuple[int, int, int, int], placed_bboxes: list[tuple[int, int, int, int]]) -> bool:
 373:     full_r0, full_r1, full_c0, full_c1 = full_bbox
 374:     for br0, br1, bc0, bc1 in placed_bboxes:
 375:         if (
 376:             full_r0 - OBJECT_GAP <= br1
 377:             and full_r1 + OBJECT_GAP >= br0
 378:             and full_c0 - OBJECT_GAP <= bc1
 379:             and full_c1 + OBJECT_GAP >= bc0
 380:         ):
 381:             return True
 382:     return False
