 149: def _gen_distance_set(count: int, max_distance: int) -> list[int] | None:
 150:     min_distance, _ = DISTANCE_RANGE
 151:     valid = [
 152:         combo
 153:         for combo in combinations(range(min_distance, max_distance + 1), count)
 154:         if all(b - a >= MIN_DISTANCE_GAP for a, b in zip(combo, combo[1:]))
 155:     ]
 156:     if not valid:
 157:         return None
 158:     return list(random.choice(valid))
