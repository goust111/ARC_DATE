 242: def _build_horizontal_panels(
 243:     grid: np.ndarray,
 244:     panel_a_color: int,
 245:     panel_b_color: int,
 246: ) -> list[tuple[int, int, int, int, int]] | None:
 247:     """Create two panels sharing a horizontal border; returns panel records."""
 248:     H, W = grid.shape
 249:     split_r = random.randint(MIN_PANEL_DIM, H - MIN_PANEL_DIM - 1)
 250:     border_top, border_bot, border_left, border_right = _choose_borders()
 251: 
 252:     pa_height = split_r - border_top
 253:     pb_height = H - border_bot - split_r
 254:     if pa_height < MIN_PANEL_DIM or pb_height < MIN_PANEL_DIM:
 255:         return None
 256: 
 257:     offset_side = random.choice(HORIZONTAL_OFFSETS)
 258:     if offset_side == "none":
 259:         pa_c0, pa_c1 = border_left, W - 1 - border_right
 260:         pb_c0, pb_c1 = border_left, W - 1 - border_right
 261:     elif offset_side == "left":
 262:         offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
 263:         if random.random() < 0.5:
 264:             pa_c0 = border_left
 265:             pa_c1 = W - 1 - border_right
 266:             pb_c0 = border_left + offset_cols
 267:             pb_c1 = W - 1 - border_right
 268:         else:
 269:             pa_c0 = border_left + offset_cols
 270:             pa_c1 = W - 1 - border_right
 271:             pb_c0 = border_left
 272:             pb_c1 = W - 1 - border_right
 273:     else:
 274:         offset_cols = random.randint(OFFSET_MIN, min(OFFSET_MAX, W - 2 * MIN_PANEL_DIM))
 275:         if random.random() < 0.5:
 276:             pa_c0 = border_left
 277:             pa_c1 = W - 1 - border_right - offset_cols
 278:             pb_c0 = border_left
 279:             pb_c1 = W - 1 - border_right
 280:         else:
 281:             pa_c0 = border_left
 282:             pa_c1 = W - 1 - border_right
 283:             pb_c0 = border_left
 284:             pb_c1 = W - 1 - border_right - offset_cols
 285: 
 286:     if pa_c1 - pa_c0 + 1 < MIN_PANEL_DIM or pb_c1 - pb_c0 + 1 < MIN_PANEL_DIM:
 287:         return None
 288:     if min(pa_c1, pb_c1) < max(pa_c0, pb_c0):
 289:         return None
 290: 
 291:     pa_r0, pa_r1 = border_top, split_r - 1
 292:     pb_r0, pb_r1 = split_r, H - 1 - border_bot
 293:     grid[pa_r0:pa_r1 + 1, pa_c0:pa_c1 + 1] = panel_a_color
 294:     grid[pb_r0:pb_r1 + 1, pb_c0:pb_c1 + 1] = panel_b_color
 295:     return [
 296:         (panel_a_color, pa_r0, pa_r1, pa_c0, pa_c1),
 297:         (panel_b_color, pb_r0, pb_r1, pb_c0, pb_c1),
 298:     ]
