 502:     other_panel_color: int,
 503: ) -> bool:
 504:     """Place all objects for one panel into input and output grids."""
 505:     panel_color, pr0, pr1, pc0, pc1 = panel
 506:     avail_r0 = pr0 + PANEL_MARGIN
 507:     avail_r1 = pr1 - PANEL_MARGIN
 508:     avail_c0 = pc0 + PANEL_MARGIN
 509:     avail_c1 = pc1 - PANEL_MARGIN
