 385: def _place_core(
 386:     panel_bbox: tuple[int, int, int, int],
 387:     core_h: int,
 388:     core_w: int,
 389:     sides: list[str],
 390:     placed_bboxes: list[tuple[int, int, int, int]],
 391: ) -> tuple[tuple[int, int, int, int], tuple[int, int, int, int]] | None:
 392:     """Find a non-overlapping core bbox and its full bbox including bars."""
 393:     pr0, pr1, pc0, pc1 = panel_bbox
 394:     extra_top = 1 if "top" in sides else 0
 395:     extra_bot = 1 if "bottom" in sides else 0
 396:     extra_left = 1 if "left" in sides else 0
 397:     extra_right = 1 if "right" in sides else 0
 398: 
 399:     place_r0 = pr0 + PANEL_MARGIN + extra_top
 400:     place_r1 = pr1 - PANEL_MARGIN - extra_bot - core_h + 1
 401:     place_c0 = pc0 + PANEL_MARGIN + extra_left
 402:     place_c1 = pc1 - PANEL_MARGIN - extra_right - core_w + 1
 403:     if place_r1 < place_r0 or place_c1 < place_c0:
 404:         return None
 405: 
