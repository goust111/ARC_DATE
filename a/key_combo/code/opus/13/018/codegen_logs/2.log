+    h, w = grid.shape
+    visited = np.zeros((h, w), dtype=bool)
+    out: list[tuple[int, np.ndarray]] = []
+
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (bg_color, bar_color) or visited[r, c]:
+                continue
+            q = deque([(r, c)])
+            visited[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
