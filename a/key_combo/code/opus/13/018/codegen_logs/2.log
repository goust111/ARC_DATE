 235: def _gen_draw_segment(grid: np.ndarray, edge: str, distance: int, span: tuple[int, int], color: int) -> None:
 236:     s0, s1 = span
 237:     h, w = grid.shape
 238:     if edge == "top":
 239:         grid[distance + 1, s0 : s1 + 1] = color
 240:     elif edge == "bottom":
 241:         grid[h - 2 - distance, s0 : s1 + 1] = color
 242:     elif edge == "left":
 243:         grid[s0 : s1 + 1, distance + 1] = color
 244:     else:
 245:         grid[s0 : s1 + 1, w - 2 - distance] = color
 246: 
 247: 
 248: def _gen_render_output(h: int, w: int, edge: str, segments: list[tuple[int, int, tuple[int, int]]]) -> np.ndarray:
 249:     out = np.zeros((h, w), dtype=int)
 250:     _gen_paint_wall(out, edge)
 251:     for distance, color, span in sorted(segments, key=lambda item: item[0], reverse=True):
 252:         bbox = _gen_projection_bbox(edge, h, w, distance, span)
 253:         _gen_fill_bbox(out, bbox, color)
 254:     return out
 255: 
 256: 
 257: def _gen_derive_input(out: np.ndarray, edge: str, segments: list[tuple[int, int, tuple[int, int]]]) -> np.ndarray:
 258:     h, w = out.shape
 259:     inp = out.copy()
 260:     for distance, _color, span in segments:
 261:         bbox = _gen_projection_bbox(edge, h, w, distance, span)
 262:         _gen_fill_bbox(inp, bbox, BACKGROUND_COLOR)
 263:     for distance, color, span in segments:
 264:         _gen_draw_segment(inp, edge, distance, span, color)
 265:     _gen_paint_wall(inp, edge)
 266:     return inp
 267: 
