  24: def main(grid: np.ndarray) -> np.ndarray:
  25:     """
  26:     Draw a green one-cell border around every adjacent red pair while leaving isolated red pixels unchanged.
  27: 
  28:     Input structure
  29:     - The grid is a black background containing only red foreground pixels.
  30:     - Each 4-connected red object is either a single pixel or a two-pixel horizontal/vertical domino.
  31: 
  32:     Rule
  33:     - Preserve all input pixels.
  34:     - For each red domino, expand its bounding box by one cell in all directions, clipped to the grid.
  35:     - Paint the perimeter of that expanded box green wherever it is currently black.
  36: 
  37:     Key insight
  38:     - The green marks are not drawn around all red pixels, only around the 4-connected red objects of area two.
  39:     """
  40:     g = np.asarray(grid, dtype=int)
  41:     assert g.ndim == 2
  42:     assert set(np.unique(g)).issubset({Color.BLACK, Color.RED})
  43: 
  44:     red_objects = components_mask(g == Color.RED, connectivity=4)
  45:     assert red_objects
  46: 
  47:     out = g.copy()
  48:     domino_count = 0
  49:     for coords in red_objects:
  50:         area = int(coords.shape[0])
  51:         if area == 1:
  52:             continue
  53:         assert area == 2, "red objects must be isolated pixels or dominoes"
  54:         r0, c0, r1, c1 = bbox_coords(coords)
  55:         assert (r1 - r0) + (c1 - c0) == 1, "domino must be edge-connected"
  56:         _paint_expanded_border(out, (r0, c0, r1, c1))
  57:         domino_count += 1
  58: 
  59:     assert domino_count > 0
  60:     return out
