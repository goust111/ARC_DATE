 160: def _gen_shear(grid: np.ndarray, color: int) -> tuple[np.ndarray, int]:
 161:     """Apply the task shear and return the output plus clipped pixel count."""
 162:     coords = np.argwhere(grid == color)
 163:     bottom = int(coords[:, 0].max())
 164:     out = np.zeros_like(grid)
 165:     shifted_cols = coords[:, 1] - (bottom - coords[:, 0])
 166:     valid = (0 <= shifted_cols) & (shifted_cols < grid.shape[1])
 167:     out[coords[valid, 0], shifted_cols[valid]] = color
 168:     lost = int(np.count_nonzero(~valid))
 169:     return out, lost
 170: 
