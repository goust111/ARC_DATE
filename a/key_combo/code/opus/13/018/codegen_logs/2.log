  99: GROUP_CELL_CHOICES = [2, 3, 4]
 100: NEIGHBOR_DELTAS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
 101: INPUT_SHIFT_CHOICES = range(-2, 3)
 102: MAX_GENERATION_ATTEMPTS = 300
