 518:         n_defects = random.randint(DEFECT_COUNT_MIN, DEFECT_COUNT_MAX)
 519:         sides = random.sample(DEFECT_SIDES, n_defects)
 520:         defect_types = [random.choice(DEFECT_TYPES) for _ in range(n_defects)]
 521: 
 522:         placed = _place_core((pr0, pr1, pc0, pc1), core_h, core_w, sides, placed_bboxes)
 523:         if placed is None:
