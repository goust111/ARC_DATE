 580: def _gen_render_output(
 581:     template: np.ndarray,
 582:     template_pos: Cell,
 583:     instances: list[dict],
 584:     source_rel: list[Cell],
 585:     marker_rel: list[Cell],
 586:     h: int,
 587:     w: int,
 588: ) -> np.ndarray:
 589:     """Render the solved grid before source blocks are removed for the input."""
 590:     out = np.zeros((h, w), dtype=int)
 591:     tr, tc = template_pos
 592:     _gen_paste(out, template, tr, tc, transparent=BACKGROUND_COLOR)
 593:     for inst in instances:
 594:         origin_r, origin_c = inst["origin"]
 595:         scale = inst["scale"]
 596:         marker_block = np.full((scale, scale), MARKER_COLOR, dtype=int)
 597:         source_block = np.full((scale, scale), SOURCE_COLOR, dtype=int)
 598:         for rel_r, rel_c in marker_rel:
 599:             _gen_paste(
 600:                 out,
 601:                 marker_block,
 602:                 origin_r + rel_r * scale,
 603:                 origin_c + rel_c * scale,
 604:             )
 605:         for rel_r, rel_c in source_rel:
 606:             _gen_paste(
 607:                 out,
 608:                 source_block,
 609:                 origin_r + rel_r * scale,
 610:                 origin_c + rel_c * scale,
 611:                 transparent=BACKGROUND_COLOR,
 612:                 overwrite=False,
 613:                 clip=True,
 614:             )
 615:     return out
