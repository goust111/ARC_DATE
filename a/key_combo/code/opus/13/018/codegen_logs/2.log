 555:     n_obj_b = random.choice(OBJECTS_PER_PANEL)
 556:     if not 2 <= n_obj_a + n_obj_b <= 4:
 557:         return None
 558: 
 559:     output_grid = grid.copy()
 560:     input_grid = grid.copy()
 561:     object_counts = (n_obj_a, n_obj_b)
 562:     other_colors = (panel_b_color, panel_a_color)
 563: 
 564:     for panel, n_objs, other_panel_color in zip(panels, object_counts, other_colors):
 565:         if not _place_panel_objects(
