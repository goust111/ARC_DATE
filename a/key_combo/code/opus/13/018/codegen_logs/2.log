 172: def _gen_sample_dimensions() -> tuple[int, int, int, int]:
 173:     """Sample canvas and sprite dimensions that leave the required margin."""
 174:     H = np.random.randint(GRID_HEIGHT_BOUNDS[0], GRID_HEIGHT_BOUNDS[1] + 1)
 175:     W = np.random.randint(GRID_WIDTH_BOUNDS[0], GRID_WIDTH_BOUNDS[1] + 1)
 176:     h = np.random.randint(OBJECT_HEIGHT_BOUNDS[0], min(OBJECT_HEIGHT_BOUNDS[1], H - 2 * EDGE_MARGIN) + 1)
 177:     w = np.random.randint(OBJECT_WIDTH_BOUNDS[0], min(OBJECT_WIDTH_BOUNDS[1], W - 2 * EDGE_MARGIN) + 1)
 178:     return H, W, h, w
 179: 
 180: 
 181: def _gen_left_offsets(H: int, W: int, r0: int, sprite: np.ndarray, color: int) -> tuple[list[int], list[int]]:
 182:     """Partition legal left offsets by whether the shear clips pixels."""
 183:     w = sprite.shape[1]
 184:     valid_lefts = []
 185:     clipped_lefts = []
 186:     for c0 in range(EDGE_MARGIN, W - w - EDGE_MARGIN + 1):
 187:         grid = np.zeros((H, W), dtype=int)
 188:         _gen_paste(grid, sprite, r0, c0, transparent=BACKGROUND_COLOR)
 189:         _, lost = _gen_shear(grid, color)
 190:         if lost <= MAX_LOST_PIXELS:
 191:             valid_lefts.append(c0)
 192:             if lost > 0:
 193:                 clipped_lefts.append(c0)
 194:     return valid_lefts, clipped_lefts
 195: 
 196: 
 197: def _gen_choose_left(valid_lefts: list[int], clipped_lefts: list[int]) -> int:
 198:     """Choose a valid left offset with the configured clipping bias."""
 199:     if clipped_lefts and np.random.random() < CLIPPED_LEFT_PROBABILITY:
 200:         return clipped_lefts[np.random.randint(0, len(clipped_lefts))]
 201:     return valid_lefts[np.random.randint(0, len(valid_lefts))]
 202: 
