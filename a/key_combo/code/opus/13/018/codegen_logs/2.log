 198: def _gen_choose_rects(
 199:     region: dict[str, int | str], count: int, split_type: str, rng: np.random.Generator
 200: ) -> list[tuple[int, int]] | None:
 201:     safe = _gen_safe_rows(region, split_type)
 202:     if safe is None:
 203:         return None
 204:     row_budget = safe[1] - safe[0] + 1 - _GEN_MIN_ROW_GAP * (count - 1)
 205:     if row_budget < count * _GEN_MIN_RECT_HEIGHT:
 206:         return None
 207: 
 208:     rects = []
 209:     for i in range(count):
 210:         remaining = count - i - 1
 211:         choices = []
 212:         remaining_min_height = remaining * _GEN_MIN_RECT_HEIGHT
 213:         for h, w in _GEN_RECT_SIZES:
 214:             fits_rows = h <= row_budget - remaining_min_height
 215:             fits_gap = _gen_max_gap(region, int(region["color"]), w, split_type) >= 1
 216:             if fits_rows and fits_gap:
 217:                 choices.append((h, w))
 218:         if not choices:
 219:             return None
 220:         h, w = choices[int(rng.integers(0, len(choices)))]
 221:         rects.append((h, w))
 222:         row_budget -= h
 223:     rng.shuffle(rects)
 224:     return rects
