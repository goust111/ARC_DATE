 556: def _gen_place_instances(
 557:     group_count: int,
 558:     source_rel: list[Cell],
 559:     marker_rel: list[Cell],
 560:     h: int,
 561:     w: int,
 562: ) -> tuple[list[dict], set[Cell], list[Box]] | None:
 563:     """Place all scaled instance footprints and return their occupancy records."""
 564:     occupied: set[Cell] = set()
 565:     marker_boxes: list[Box] = []
 566:     instances: list[dict] = []
 567:     scales = sorted([random.randint(*SCALE_RANGE) for _ in range(group_count)], reverse=True)
 568:     for scale in scales:
 569:         inst = _gen_place_instance(
 570:             scale, source_rel, marker_rel, h, w, occupied, marker_boxes
 571:         )
 572:         if inst is None:
 573:             return None
 574:         instances.append(inst)
 575:         occupied |= inst["cells"]
 576:         marker_boxes.extend(inst["marker_boxes"])
 577:     return instances, occupied, marker_boxes
