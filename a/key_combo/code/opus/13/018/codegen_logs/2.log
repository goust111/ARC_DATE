 119: def _gen_paint_expected_border(out: np.ndarray, box: tuple[int, int, int, int]) -> None:
 120:     h, w = out.shape
 121:     r0, c0, r1, c1 = box
 122:     er0 = max(0, r0 - 1)
 123:     ec0 = max(0, c0 - 1)
 124:     er1 = min(h - 1, r1 + 1)
 125:     ec1 = min(w - 1, c1 + 1)
 126:     for r in range(er0, er1 + 1):
 127:         for c in range(ec0, ec1 + 1):
 128:             if (r in (er0, er1) or c in (ec0, ec1)) and out[r, c] == GEN_BACKGROUND:
 129:                 out[r, c] = GEN_FRAME
