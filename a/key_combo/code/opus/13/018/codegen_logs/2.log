 572:         ):
 573:             return None
 574: 
 575:     # Verify: run solver on input and check it produces the output
 576:     try:
 577:         result = main(input_grid)
 578:         if np.array_equal(result, output_grid):
 579:             return input_grid
 580:     except (AssertionError, IndexError, ValueError):
 581:         pass
 582: 
 583:     return None
 584: 
