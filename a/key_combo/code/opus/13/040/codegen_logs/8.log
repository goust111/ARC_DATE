+
+
+def _gen_attempt() -> np.ndarray | None:
+    width = int(_RNG.integers(22, 31))
+    tri_cols = _triangular_columns(width)
+    if len(tri_cols) < 5:
+        return None
+
+    template = _sample_template()
+    sampled = _sample_frames(width, tri_cols)
