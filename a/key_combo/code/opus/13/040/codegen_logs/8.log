+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATE_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid sample for puzzle 8")

