+    r0, c0 = source_top_left
+    for r, c in np.argwhere(sprite != 0):
+        grid[r0 + int(r), c0 + int(c)] = int(sprite[r, c])
+    for tr, tc in target_anchors:
+        grid[tr, tc] = GREY
+    return grid
+
+
