+BG = 0
+GREY = 5
+PAYLOAD_COLORS = (1, 2)
+
+_DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_RNG = np.random.default_rng()
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in _DIR4:
+        yield r + dr, c + dc
