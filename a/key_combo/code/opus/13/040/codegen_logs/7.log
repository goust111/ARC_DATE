+
+    in_box, in_h_rows, in_v_cols = _extract_bar_structure(inp == LINE)
+    out_box, out_h_rows, out_v_cols = _extract_bar_structure(expected == LINE)
+    got_counts = _count_side_markers(inp, in_box)
