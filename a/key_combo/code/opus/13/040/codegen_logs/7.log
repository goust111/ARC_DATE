+    return int(candidates[_randint(0, len(candidates) - 1)])
+
+
+def _render_case(
+    shape: tuple[int, int],
+    box: tuple[int, int, int, int],
+    h_rows: list[int],
+    v_cols: list[int],
+    counts: dict[str, int],
+    marker_cells: list[tuple[int, int]],
