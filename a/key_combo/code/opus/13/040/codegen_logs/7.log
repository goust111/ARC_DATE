        if ok:
            candidates.append((split_count, -blue_adj, r, c))
    random.shuffle(candidates)
    candidates.sort()
    return [(r, c) for _, _, r, c in candidates]


def _gen_coords_touch_markers(coords: np.ndarray, markers: set[tuple[int, int]]) -> bool:
    for r, c in coords:
