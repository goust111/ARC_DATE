import random
from collections import Counter

import numpy as np


BG = 0
SPRITE_COLOR = 2
FRAME_COLOR = 4

GRID_SIDE_RANGE = (20, 29)
FRAME_COUNT_CHOICES = (3, 4)
FRAME_INNER_MAX = 6
GEN_ATTEMPTS = 500


def _neighbors4(r: int, c: int):
    yield r - 1, c
    yield r + 1, c
    yield r, c - 1
    yield r, c + 1


