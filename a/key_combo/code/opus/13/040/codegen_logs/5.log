+def _place_rectangles(
+    rng: random.Random,
+    height: int,
+    width: int,
+    sprite_bbox: tuple[int, int, int, int],
+    frame_specs: list[tuple[str, int, int]],
+) -> list[tuple[str, int, int, int, int]] | None:
