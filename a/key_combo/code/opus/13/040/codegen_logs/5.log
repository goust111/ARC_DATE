+
+def _build_input_from_layout(
+    height: int,
+    width: int,
+    sprite: np.ndarray,
+    sprite_top: int,
+    sprite_left: int,
+    frames: list[tuple[str, int, int, int, int]],
+) -> np.ndarray:
+    grid = np.full((height, width), BG, dtype=int)
+    _paste(grid, sprite, sprite_top, sprite_left)
+    for kind, top, left, outer_h, outer_w in frames:
+        inner_h = outer_h - 2
+        inner_w = outer_w - 2
