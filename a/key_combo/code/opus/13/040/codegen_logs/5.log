+        assert np.array_equal(out[r0 : r1 + 1, c0 : c1 + 1] == FRAME_COLOR, inp[r0 : r1 + 1, c0 : c1 + 1] == FRAME_COLOR)
+        ir0, ic0, ir1, ic1 = frame["inner_bbox"]
+        if frame["inner_w"] > frame["inner_h"]:
