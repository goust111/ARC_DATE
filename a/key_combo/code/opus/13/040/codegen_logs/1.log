+            elif variant == 2:
+                rr, cc = -r, c
+            elif variant == 3:
+                rr, cc = -r, -c
+            elif variant == 4:
+                rr, cc = c, r
+            elif variant == 5:
+                rr, cc = c, -r
+            elif variant == 6:
