+    diag_positions = [(hr - 1, hc - 1), (hr - 1, hc + 1), (hr + 1, hc - 1), (hr + 1, hc + 1)]
+    ortho_positions = [(hr - 1, hc), (hr + 1, hc), (hr, hc - 1), (hr, hc + 1)]
+    random.shuffle(diag_positions)
+    random.shuffle(ortho_positions)
