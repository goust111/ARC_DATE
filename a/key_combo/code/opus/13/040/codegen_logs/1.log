+
+def _anchor_component_candidates(
+    anchor: tuple[int, int],
+    hub: tuple[int, int],
+    used_signatures: set[tuple[tuple[int, int], ...]],
+) -> list[list[tuple[int, int]]]:
+    ar, ac = anchor
+    hr, hc = hub
+    anchor_dist = abs(ar - hr) + abs(ac - hc)
+    outward = (ar - hr, ac - hc)
