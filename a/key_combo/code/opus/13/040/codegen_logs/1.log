+def _place_anchor_component(
+    grid: np.ndarray,
+    color: int,
+    anchor: tuple[int, int],
+    hub: tuple[int, int],
+    components_by_color: dict[int, list[np.ndarray]],
+    used_signatures: set[tuple[tuple[int, int], ...]],
+    reserved: set[tuple[int, int]],
+) -> bool:
+    own_forbidden = reserved - {anchor}
