+
+
+def _dirs_for_geometry(geometry: str) -> list[tuple[int, int]]:
+    return DIAG_DIRS if geometry == "diag" else ORTHO_DIRS
+
+
+def _claim_data(
+    grid: np.ndarray,
+    geometry_override: dict[int, str] | None = None,
