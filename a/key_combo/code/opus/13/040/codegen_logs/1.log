+            return None
+
+    extra_order = colors[:]
+    random.shuffle(extra_order)
+    for color in extra_order:
+        for _ in range(counts_by_color[color] - 1):
+            if not _place_extra_component(
+                grid,
+                color,
+                components_by_color,
+                used_signatures,
+                hub,
+            ):
+                return None
+
