+    for color, cells in claims.items():
+        for cell in cells:
+            cell_claimers[cell].append(color)
+
+    def priority(color: int) -> tuple[int, int]:
+        if reverse_priority:
+            return (-areas[color], color)
+        return (areas[color], color)
