    for _ in range(num_red):
        r, c = np.random.randint(0, m), np.random.randint(0, n)
        grid[r, c] = Color.RED
    
    for _ in range(num_blue):
        r, c = np.random.randint(0, m), np.random.randint(0, n)
        grid[r, c] = Color.BLUE
    
    for _ in range(num_other):
