+        right_rings[pos] = _make_ring(require_corner_variation=False, require_side_variation=True)
+        composite = _compose_pair(left_rings[pos], right_rings[pos], BG)
+        raw = np.full((3, 3), BG, dtype=int)
+        for r, c in CORNER_OFFSETS:
