+SEP = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+
+RING_OFFSETS = (
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 0),
+    (1, 2),
+    (2, 0),
+    (2, 1),
+    (2, 2),
