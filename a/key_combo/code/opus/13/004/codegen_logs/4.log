+def _place_anchor(grid: np.ndarray, row_bands: list[tuple[int, int]], col_bands: list[tuple[int, int]], cell: tuple[int, int]) -> None:
+    r0, _ = row_bands[cell[0]]
+    c0, _ = col_bands[cell[1]]
+    grid[r0 : r0 + 2, c0 : c0 + 2] = GREEN
