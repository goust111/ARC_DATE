def _gen_add_distractor(g: np.ndarray, frames: list[Frame], n: int, need_extra: int, max_extra: int) -> bool:
    for extra, opt in _gen_distractor_options(g, frames, n):
        if extra < need_extra or extra > max_extra:
            continue
        a0, b0, a1, b1, side = opt
        if side == "top":
            g[:a0, b0] = GEN_RED
            g[:a1, b1] = GEN_RED
        elif side == "bottom":
            g[a0 + 1 :, b0] = GEN_RED
            g[a1 + 1 :, b1] = GEN_RED
        elif side == "left":
            g[a0, :b0] = GEN_RED
            g[a1, :b1] = GEN_RED
        else:
            g[a0, b0 + 1 :] = GEN_RED
            g[a1, b1 + 1 :] = GEN_RED
        return True
    return False


