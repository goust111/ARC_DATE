def _gen_shift(group, dr):
    shifted = np.zeros_like(group)
    rows, cols = np.nonzero(group != BG_COLOR)
    new_rows = rows + dr
    if np.any((new_rows < 0) | (new_rows >= GEN_HEIGHT)):
