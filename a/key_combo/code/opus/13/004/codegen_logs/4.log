+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+PINK = 6
+TEAL = 8
+
+CELL_SIZE = 3
+CELL_COUNTS = (4, 5)
+GEN_RETRY_LIMIT = 500
+
+
+def _cell_ranges(size: int, walls: list[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for wall in walls:
+        if start <= wall - 1:
+            bands.append((start, wall - 1))
+        start = wall + 1
+    if start < size:
+        bands.append((start, size - 1))
+    return bands
+
+
+def _band_index(pos: int, bands: list[tuple[int, int]]) -> int:
+    for idx, (lo, hi) in enumerate(bands):
+        if lo <= pos <= hi:
+            return idx
+    raise AssertionError("position does not fall inside any lattice cell")
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _singleton_color(colors: set[int], label: str) -> int:
+    if len(colors) != 1:
+        raise AssertionError(f"{label} expected exactly one fill color")
+    return next(iter(colors))
+
+
+def _parse_input(grid: np.ndarray):
