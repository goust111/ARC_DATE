+    assert _band_index(int(anchor_pixels[:, 1].max()), col_bands) == anchor_col
+
+    markers = []
+    occupied_cells: set[tuple[int, int]] = {(anchor_row, anchor_col)}
+    for color in (BLUE, RED):
