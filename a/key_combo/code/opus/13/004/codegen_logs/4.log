+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+PINK = 6
+TEAL = 8
+
+CELL_SIZE = 3
+CELL_COUNTS = (4, 5)
