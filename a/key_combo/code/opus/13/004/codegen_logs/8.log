+
+
+def _marker_ok(grid: np.ndarray, r: int, c: int) -> bool:
+    if not _in_bounds(grid.shape, r, c) or int(grid[r, c]) != BLACK:
+        return False
+    h, w = grid.shape
+    for rr in range(r - 1, r + 2):
