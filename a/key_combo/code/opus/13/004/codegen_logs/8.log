+    sr, sc = square_top_left
+    cells: list[tuple[int, int]] = []
+    for (corner_dr, corner_dc), (step_r, step_c) in RAY_SPECS:
+        cr = sr + corner_dr
+        cc = sc + corner_dc
+        for step in range(1, length + 1):
+            rr = cr + step_r * step
+            cc2 = cc + step_c * step
+            if not _in_bounds(shape, rr, cc2):
