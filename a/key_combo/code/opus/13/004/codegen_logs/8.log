+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+SQUARE_SIZE = 3
+RAY_MARKER_LIMIT = 6
+GEN_RETRIES = 400
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+RAY_SPECS = [
+    ((0, 0), (-1, -1)),
+    ((0, 2), (-1, 1)),
+    ((2, 2), (1, 1)),
+    ((2, 0), (1, -1)),
+]
