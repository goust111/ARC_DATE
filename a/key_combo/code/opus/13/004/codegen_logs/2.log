+            bbox = _bbox_from_coords(coords_arr)
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords_arr,
+                    "bbox": bbox,
+                    "area": int(coords_arr.shape[0]),
+                }
+            )
