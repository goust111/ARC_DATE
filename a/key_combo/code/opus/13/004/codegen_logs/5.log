+def _platform_slots(row: np.ndarray) -> list[tuple[int, int, int]]:
+    row = np.asarray(row, dtype=int)
+    assert set(map(int, row)) <= {BG, PLATFORM}
+    runs: list[tuple[int, int]] = []
