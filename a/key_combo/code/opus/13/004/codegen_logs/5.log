+def _find_components(grid: np.ndarray, colors: list[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for color in colors:
+        for r in range(h):
+            for c in range(w):
