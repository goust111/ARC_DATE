+                    continue
+                q = deque([(r, c)])
+                seen[r, c] = True
+                coords: list[tuple[int, int]] = []
+                while q:
+                    rr, cc = q.popleft()
+                    coords.append((rr, cc))
+                    for nr, nc in _neighbors4(rr, cc):
+                        if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                            seen[nr, nc] = True
+                            q.append((nr, nc))
+                comps.append(
+                    {
+                        "color": int(color),
+                        "coords": coords,
+                        "bbox": _bbox_from_coords(coords),
