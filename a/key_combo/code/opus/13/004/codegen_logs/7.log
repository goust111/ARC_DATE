+
+
+def _movement_visible(items: list[dict], rows: int, cols: int, direction: str) -> bool:
+    packed = _compacted_items(items, rows, cols, direction)
+    return any(int(p["r"]) != int(p["slot_r"]) or int(p["c"]) != int(p["slot_c"]) for p in packed)
