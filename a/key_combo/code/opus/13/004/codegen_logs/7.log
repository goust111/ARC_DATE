+
+
+def _build_symbolic_items(rows: int, cols: int, count: int, rng: random.Random) -> list[dict]:
+    cells = _covering_cells(rows, cols, count, rng)
+    areas = rng.sample(AREA_VALUES, count)
+    colors = rng.sample(SYMBOL_COLORS, count)
