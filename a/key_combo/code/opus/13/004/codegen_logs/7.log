+
+    areas = [int(item["area"]) for item in items]
+    masks = _choose_symbol_masks(areas, rng)
+    area_part = _expand_area(items, rows, cols, side, masks)
+
+    bh = th + rng.randint(1, 3)
+    bw = tw + rng.randint(1, 3)
+    bh = max(bh, 4)
+    bw = max(bw, 4)
