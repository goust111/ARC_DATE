+
+
+def _covering_cells(rows: int, cols: int, count: int, rng: random.Random) -> list[tuple[int, int]]:
+    all_cells = [(r, c) for r in range(rows) for c in range(cols)]
+    rng.shuffle(all_cells)
+    chosen = []
+    used_rows = set()
+    used_cols = set()
+    for r, c in all_cells:
+        if len(used_rows) < rows and r not in used_rows:
+            chosen.append((r, c))
+            used_rows.add(r)
+            used_cols.add(c)
+        elif len(used_cols) < cols and c not in used_cols:
+            chosen.append((r, c))
+            used_rows.add(r)
+            used_cols.add(c)
+        if len(chosen) == count:
