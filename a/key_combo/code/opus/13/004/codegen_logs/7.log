+    return parts, sr, sc
+
+
+def _marker_side(area: np.ndarray) -> str:
+    sides = []
+    if area.shape[0] > 0 and np.all(area[0, :] == MARKER):
+        sides.append("top")
+    if area.shape[1] > 0 and np.all(area[:, -1] == MARKER):
+        sides.append("right")
+    if area.shape[0] > 0 and np.all(area[-1, :] == MARKER):
