+
+def _place_template(part: np.ndarray, template_mask: np.ndarray, rng: random.Random) -> None:
+    th, tw = map(int, template_mask.shape)
+    off_r = rng.randint(0, part.shape[0] - th)
+    off_c = rng.randint(0, part.shape[1] - tw)
