+def _split_quadrants(grid: np.ndarray) -> tuple[dict[str, np.ndarray], int, int]:
+    row_lines = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == SEP)]
+    col_lines = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == SEP)]
