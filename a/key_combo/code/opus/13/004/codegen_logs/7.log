+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    cells = {tuple(map(int, rc)) for rc in coords}
+    stack = [next(iter(cells))]
+    seen = set()
+    while stack:
+        r, c = stack.pop()
+        if (r, c) in seen:
