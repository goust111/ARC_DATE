+
+
+def _build_template_patterns() -> list[np.ndarray]:
+    patterns = []
+    for h in (2, 3):
+        for w in (2, 3):
+            for bits in range(1 << (h * w)):
+                mask = np.array([(bits >> i) & 1 for i in range(h * w)], dtype=int).reshape(h, w).astype(bool)
+                area = int(mask.sum())
+                if area < 3 or area > 5:
+                    continue
+                if not _is_connected(mask):
