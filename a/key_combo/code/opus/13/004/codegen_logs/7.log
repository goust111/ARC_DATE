+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BG = 0
+SEP = 1
+TEMPLATE_COLOR = 2
+MARKER = 6
+SYMBOL_COLORS = [3, 4, 5, 7, 8, 9]
+AREA_VALUES = [5, 6, 7, 8]
+GEN_RETRIES = 400
+
+DIR_FROM_SIDE = {
+    "top": "right",
+    "right": "down",
+    "bottom": "left",
