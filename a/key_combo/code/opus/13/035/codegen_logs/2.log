+                }
+            )
+    return chambers
+
+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, list[dict[str, Any]], list[dict[str, Any]]]:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
