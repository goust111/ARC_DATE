+    }
+
+
+def _make_vertical_gap_rows(plan: dict[str, Any], band: int) -> list[int]:
+    cols = int(plan["cols"])
+    left_row, right_row = plan["seed_rows"][band]
+    left_reach = int(plan["patterns"][band]["left_reach"])
