+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    out = np.full_like(g, BLACK)
+    out[g == WALL] = WALL
+    for chamber in _parse_chambers(g):
+        _draw_pyramid(out, chamber["cellset"], chamber["marker_color"], chamber["line"])
+    return out
