            return None
        prev, cur = cur, nxt[0]
    return path if len(path) == len(pts) else None


def _gen_cycle_metrics(mask):
    path = _gen_trace_cycle(mask)
    if path is None:
        return None
    counts = {1: 0, -1: 0}
    n = len(path)
    for i, (r, c) in enumerate(path):
        pr, pc = path[i - 1]
        nr, nc = path[(i + 1) % n]
        incoming = (r - pr, c - pc)
        outgoing = (nr - r, nc - c)
        cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
        if cross:
