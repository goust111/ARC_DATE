spec:
  grid: 20x20 [observed]
  colors:
    bg: 0 (always g[0,0])
    fill: 1 [observed], more common foreground color
    marker: 2 [observed], rarer foreground color; exactly 2 distinct foreground colors required
  rectangles:
    count: 3-4 non-overlapping axis-aligned solid rectangles (no bg inside)
    dimensions: each side 3-18 cells
    separation: min gap >= 2 between any pair of bounding boxes
    may touch grid edges, but g[0,0] must be bg
    coverage: total rectangle area / grid area ~ 0.3-0.6 [observed]
  markers:
