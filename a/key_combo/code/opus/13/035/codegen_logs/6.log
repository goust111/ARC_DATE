+def _interior_rows(rect: tuple[int, int, int, int]) -> list[int]:
+    r0, _c0, r1, _c1 = rect
+    return list(range(r0 + 1, r1))
+
+
+def _interior_cols(rect: tuple[int, int, int, int]) -> list[int]:
+    _r0, c0, _r1, c1 = rect
+    return list(range(c0 + 1, c1))
+
