+        rects.append(rect)
+        if "H" in pattern:
+            row = random.choice(row_choices)
+            used_rows.add(row)
+            extra_rays.append(("h", row))
+        if "V" in pattern:
+            col = random.choice(col_choices)
+            used_cols.add(col)
+            extra_rays.append(("v", col))
