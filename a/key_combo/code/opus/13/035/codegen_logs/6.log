def _gen_cover_chambers(grid, wall_rows, wall_cols, row_bands, col_bands, target, row_counts, col_counts):
    wall_rows_set = set(wall_rows)
    wall_cols_set = set(wall_cols)
    for i, rows in enumerate(row_bands):
