        if (c in cols) == has_blocker:
            return False
    return True


def _gen_components_ok(inp: np.ndarray) -> bool:
    comps = find_components(
        inp, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
    )
