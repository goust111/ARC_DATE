    return _gen_unique_masks(candidates)


def _gen_outline_masks(h: int, w: int) -> list[np.ndarray]:
    key = (h, w)
    if key not in _gen_MASK_CACHE:
        _gen_MASK_CACHE[key] = _gen_unique_masks(
            _gen_angular_masks(h, w) + _gen_frame_masks(h, w)
