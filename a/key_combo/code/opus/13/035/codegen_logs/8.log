+    rng = np.random.default_rng()
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _attempt_generate(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 8")

