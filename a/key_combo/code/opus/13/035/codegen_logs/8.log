+                inside = [
+                    cell
+                    for cell in candidates
+                    if top + 1 <= cell[0] <= bottom - 1 and left + 1 <= cell[1] <= right - 1
+                ]
+                if inside:
+                    candidates = inside
+            choice = candidates[int(rng.integers(0, len(candidates)))]
+            scatter.append((int(choice[0]), int(choice[1]), int(color)))
+            taken.add(choice)
+    return scatter
+
