    r0 = int(r0)
    c0 = int(c0)
    h, w = map(int, patch.shape)

    if not clip:
        if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
            raise ValueError("paste: patch out of bounds (set clip=True to allow clipping)")
        rr0, cc0 = r0, c0
        rr1, cc1 = r0 + h, c0 + w
        pr0, pc0 = 0, 0
    else:
        rr0 = max(0, r0)
        cc0 = max(0, c0)
        rr1 = min(H, r0 + h)
        cc1 = min(W, c0 + w)
        if rr0 >= rr1 or cc0 >= cc1:
            return dst
        pr0 = rr0 - r0
        pc0 = cc0 - c0

    pr1 = pr0 + (rr1 - rr0)
    pc1 = pc0 + (cc1 - cc0)

