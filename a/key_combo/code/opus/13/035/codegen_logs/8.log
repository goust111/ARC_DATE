+    out[top, left : right + 1] = FRAME_COLOR
+    out[bottom, left : right + 1] = FRAME_COLOR
+    out[top : bottom + 1, left] = FRAME_COLOR
+    out[top : bottom + 1, right] = FRAME_COLOR
