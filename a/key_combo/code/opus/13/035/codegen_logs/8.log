+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 2
+INPUT_COLORS = (1, 3, 4, 5, 6, 7, 8, 9)
+SEED_BBOX_OPTIONS = ((2, 2), (2, 3), (3, 2))
+GENERATION_ATTEMPTS = 400
