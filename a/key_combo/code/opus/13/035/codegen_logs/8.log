+    seed_bbox = (sr0, sc0, sr0 + seed_h - 1, sc0 + seed_w - 1)
+    seed_cells = {(sr0 + int(r), sc0 + int(c)) for r, c in np.argwhere(seed_patch != BACKGROUND)}
+    occupied = _expanded_cells(seed_cells)
