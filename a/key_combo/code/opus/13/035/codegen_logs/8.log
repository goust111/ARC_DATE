+def _validate_case(
+    grid: np.ndarray,
+    *,
+    anchor: tuple[int, int],
+    seed_bbox: tuple[int, int, int, int],
+    seed_patch: np.ndarray,
+    scatter: list[tuple[int, int, int]],
+) -> bool:
