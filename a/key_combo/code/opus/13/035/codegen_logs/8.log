import random

import numpy as np
from typing import *
from arc_utils import Color, bbox, draw_line

# concepts:
# counting, uniqueness, surrounding

# description:
# In the input, you will see a grid with a black background and colored pixels sprinkled on it. Exactly one color occurs only one time.
# To make the output, find the cell whose color is unique (color occurs only one time), and surround that cell with red pixels. Make all the other pixels black.

def main(input_grid: np.ndarray) -> np.ndarray:
    """
    Isolate the uniquely colored cell and surround it with a red 3 by 3 frame.

    Input structure:
    - The background is black.
    - Exactly one non-black color occurs once.
    - Other non-black colors occur zero times or more than once.

    Rule:
    - Find the first non-black color with exactly one cell.
    - Create a black output grid.
    - Fill the 3 by 3 neighborhood around that cell red, then restore the unique cell's original color.

    Key insight:
    - Frequency, not position or shape, identifies the target cell; all non-target input pixels are discarded.
    """
    # Plan:
    # 1. Create a blank new canvas (so that the non-unique colors don't get copied)
    # 2. Find the unique cell
    # 3. Surround the unique cell with red pixels

    output_grid = np.zeros_like(input_grid)

    # 2. Find the unique cell
    unique_color = None
    for color in Color.NOT_BLACK:
        if np.count_nonzero(input_grid == color) == 1:
            unique_color = color
            break
    assert unique_color is not None
    
    # 3. Surround the unique cell with red pixels
    # First get the coordinates of the unique cell
    _b = bbox(input_grid == unique_color)
    assert _b is not None
    r, c, _r1, _c1 = _b
    # Copy red over the region around the unique cell (but this will accidentally delete the unique cell, so be copied back)
    for rr in range(r - 1, r + 2):
        for cc in range(c - 1, c + 2):
            if 0 <= rr < len(input_grid) and 0 <= cc < len(input_grid[0]):
                output_grid[rr, cc] = Color.RED
    # Copy the unique cell back
    output_grid[r, c] = unique_color

    return output_grid


    



def generate_input() -> np.ndarray:
    
    # make a 10x10 black grid first as background
    n, m = 10, 10
    grid = np.zeros((m, n), dtype=int)

    # randomly select a unique color from Color.NOT_BLACK
    unique_color = random.choice(Color.NOT_BLACK)

    # randomly choose a non-border cell for the unique color
    non_border_cells = [ (i, j) for i in range(1, m-1) for j in range(1, n-1) ]
    unique_cell = random.choice(non_border_cells)
    grid[unique_cell] = unique_color

    # remove the unique color from the list
    remaining_colors = [ color for color in Color.NOT_BLACK if color != unique_color ]

    for remaining_color in remaining_colors:
        # Pick a random frequency but make sure that this colour is not unique (does not have frequency 1)
        frequency_of_this_color = random.choice([0, 2, 3, 4, 5, 6])

        for _ in range(frequency_of_this_color):
            # randomly choose an unoccupied cell for the remaining color
            empty_cells = [ (i, j) for i in range(m) for j in range(n) if grid[i][j] == Color.BLACK ]
            r, c = random.choice(empty_cells)
            grid[r, c] = remaining_color
    
    return grid
  
from __future__ import annotations

import numpy as np

from arc_utils import bbox, colors_present, get_bg, paste


def _ring_projection(
    r: int,
    c: int,
    block_bbox: tuple[int, int, int, int],
) -> tuple[int, int]:
    r0, c0, r1, c1 = block_bbox

    if r < r0:
        nr = r0 - 1
    elif r > r1:
        nr = r1 + 1
    else:
        nr = r

    if c < c0:
        nc = c0 - 1
    elif c > c1:
        nc = c1 + 1
    else:
        nc = c

    return int(nr), int(nc)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Move each marker pixel straight inward until it touches the one-cell ring around the solid 2x2 block.

    Input structure
    - The background contains exactly two foreground colors.
    - One foreground color forms a unique filled 2x2 block.
    - The other foreground color appears as marker pixels aligned with the block by row, column, or 45-degree diagonal.

    Rule
    - Keep the 2x2 block fixed.
    - Clear every marker from its original position.
    - Project each marker along its row, column, or diagonal toward the block, stopping in the adjacent ring cell on the same side/corner of the 2x2 block.

    Key insight
    - The 2x2 block is the anchor, and every marker is already on one of the eight rays extending from the block's surrounding ring.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2, "expected a 2D grid"

    bg = get_bg(g)
    foreground_colors = colors_present(g, exclude={bg})
    assert len(foreground_colors) == 2, "expected two foreground colors"

    block_candidates: list[tuple[int, tuple[int, int, int, int]]] = []
    for color in foreground_colors:
        mask = g == int(color)
        box = bbox(mask)
        assert box is not None, "foreground color must be present"
        r0, c0, r1, c1 = box
        if (
            r1 - r0 + 1 == 2
            and c1 - c0 + 1 == 2
            and int(np.count_nonzero(mask)) == 4
            and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(color))
        ):
            block_candidates.append((int(color), box))

    assert len(block_candidates) == 1, "expected one filled 2x2 foreground block"
    block_color, block_bbox = block_candidates[0]
    r0, c0, r1, c1 = block_bbox

    marker_colors = [int(color) for color in foreground_colors if int(color) != block_color]
    assert len(marker_colors) == 1, "expected one marker color"
    marker_color = marker_colors[0]
    marker_coords = np.argwhere(g == marker_color)
    assert marker_coords.size > 0, "expected at least one marker"

    out = g.copy()
    out[g == marker_color] = bg

    height, width = map(int, g.shape)
    destinations: set[tuple[int, int]] = set()
    for rr, cc in marker_coords:
        r = int(rr)
        c = int(cc)
        assert not (r0 <= r <= r1 and c0 <= c <= c1), "marker cannot lie inside the block"

        nr, nc = _ring_projection(r, c, block_bbox)
        row_aligned = r0 <= r <= r1
        col_aligned = c0 <= c <= c1
        if not row_aligned and not col_aligned:
            assert abs(r - nr) == abs(c - nc), "diagonal marker must lie on a 45-degree ray"

        assert 0 <= nr < height and 0 <= nc < width, "projected marker must stay inside the grid"
        assert int(g[nr, nc]) != block_color, "projected marker cannot overwrite the block"
        assert (nr, nc) not in destinations, "marker destinations must be unique"
        destinations.add((nr, nc))
        out[nr, nc] = marker_color

    return out

