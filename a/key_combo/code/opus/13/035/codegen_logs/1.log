+
+
+def _build_output_pattern(ph: int, pw: int) -> np.ndarray:
+    colors = RNG.choice(PALETTE, size=int(RNG.integers(3, 5)), replace=False)
+    copy_prob = float(RNG.uniform(0.2, 0.5))
