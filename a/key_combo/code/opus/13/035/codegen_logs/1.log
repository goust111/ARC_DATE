+    return damaged, donor_specs, symmetry_specs
+
+
+def _place_markers(
+    inp: np.ndarray,
+    patch_box: tuple[int, int, int, int],
+    donor_specs: list[dict[str, object]],
+    symmetry_specs: list[dict[str, object]],
+) -> np.ndarray | None:
+    h, w = inp.shape
+    out = inp.copy()
+    used_sources: set[tuple[int, int]] = set()
