+    qw = (pw + 1) // 2
+    seeds: dict[tuple[int, int], int] = {}
+    for r in range(qh):
+        for c in range(qw):
+            neighbors = [
+                seeds[key]
+                for key in ((r - 1, c), (r, c - 1), (r - 1, c - 1))
+                if key in seeds
+            ]
+            if neighbors and RNG.random() < copy_prob:
+                color = int(RNG.choice(neighbors))
+            else:
+                color = int(RNG.choice(colors))
+            seeds[(r, c)] = color
