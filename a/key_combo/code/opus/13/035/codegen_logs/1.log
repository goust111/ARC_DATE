+    return sides
+
+
+def _source_for_side(
+    shape: tuple[int, int],
+    box: tuple[int, int, int, int],
+    side: str,
+    target: tuple[int, int],
+) -> tuple[int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = box
+    r, c = target
+    if side == "left":
+        assert r0 <= r <= r1 and c == c0
+        return r, 0
+    if side == "right":
+        assert r0 <= r <= r1 and c == c1
