+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            orbit = _orbit_cells(box, r, c)
+            if orbit in seen:
+                continue
+            seen.add(orbit)
+            values = [int(grid[rr, cc]) for rr, cc in orbit]
+            greens = [(rr, cc) for rr, cc in orbit if int(grid[rr, cc]) == GREEN]
+            if not greens:
