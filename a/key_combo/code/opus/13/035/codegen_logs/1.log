+    inp = np.zeros((h, w), dtype=int)
+    inp[r0 : r0 + ph, c0 : c0 + pw] = damaged_patch
+    inp = _place_markers(inp, box, donor_specs, symmetry_specs)
+    if inp is None:
+        return None
+    if not _validate_instance(inp, output, donor_specs):
