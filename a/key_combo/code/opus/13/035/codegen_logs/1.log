+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+PALETTE = (BLUE, RED, YELLOW, ORANGE)
+
+RNG = np.random.default_rng()
+GEN_ATTEMPTS = 400
