+    box = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+
+    patch = _build_output_pattern(ph, pw)
+    output = np.zeros((h, w), dtype=int)
+    output[r0 : r0 + ph, c0 : c0 + pw] = patch
