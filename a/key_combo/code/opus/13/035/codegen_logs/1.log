+    targets: dict[tuple[int, int], int] = {}
+    for r, c, color in marker_cells:
+        out[r, c] = BLACK
+        dr, dc = _marker_direction(box, r, c)
+        hit = _first_nonblack_on_ray(grid, r + dr, c + dc, dr, dc)
+        if hit is None:
