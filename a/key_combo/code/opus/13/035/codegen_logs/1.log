        r0, c0, r1, c1 = box
        if (
            r1 - r0 + 1 == 2
            and c1 - c0 + 1 == 2
            and int(np.count_nonzero(mask)) == 4
            and np.all(g[r0 : r1 + 1, c0 : c1 + 1] == int(color))
