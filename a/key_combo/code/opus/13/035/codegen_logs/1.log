+    rr = int(r)
+    cc = int(c)
+    while 0 <= rr < h and 0 <= cc < w:
+        if int(grid[rr, cc]) != BLACK:
+            return rr, cc
+        rr += dr
+        cc += dc
+    return None
+
+
+def _apply_markers(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
