+            return False
+        return True
+    except AssertionError:
+        return False
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        made = _make_instance()
+        if made is None:
+            continue
+        inp, _out = made
