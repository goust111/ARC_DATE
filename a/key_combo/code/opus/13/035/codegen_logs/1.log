+
+def _orbit_cells(
+    box: tuple[int, int, int, int], r: int, c: int
+) -> tuple[tuple[int, int], ...]:
+    r0, c0, r1, c1 = box
+    rr = r - r0
+    cc = c - c0
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    cells = {
+        (r0 + rr, c0 + cc),
+        (r0 + rr, c0 + (w - 1 - cc)),
+        (r0 + (h - 1 - rr), c0 + cc),
+        (r0 + (h - 1 - rr), c0 + (w - 1 - cc)),
+    }
