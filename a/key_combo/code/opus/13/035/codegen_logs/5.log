+                    "block": (br, bc),
+                    "size": size,
+                    "color": SIZE_TO_COLOR[size],
+                    "norm": norm,
+                    "local_tl": local_tl,
+                    "bbox_h": bbox_h,
+                    "bbox_w": bbox_w,
+                }
+            )
