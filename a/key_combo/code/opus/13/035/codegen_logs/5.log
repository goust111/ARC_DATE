+        ((0, 1), (1, 1), (2, 0), (2, 1)),
+        ((0, 0), (0, 1), (1, 1), (2, 1)),
+        ((0, 0), (0, 1), (1, 0), (2, 0)),
+        ((0, 0), (0, 1), (0, 2), (1, 1)),
+        ((0, 1), (1, 0), (1, 1), (2, 1)),
+        ((0, 1), (1, 0), (1, 1), (1, 2)),
+        ((0, 0), (1, 0), (1, 1), (2, 0)),
+        ((0, 0), (1, 0), (1, 1), (1, 2)),
+        ((0, 1), (0, 2), (1, 0), (1, 1)),
+        ((0, 0), (1, 0), (1, 1), (2, 1)),
+        ((0, 0), (0, 1), (1, 1), (1, 2)),
+        ((0, 1), (1, 0), (1, 1), (2, 0)),
+    ),
+}
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _normalize(coords: list[tuple[int, int]]) -> tuple[tuple[tuple[int, int], ...], tuple[int, int], int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    norm = tuple(sorted((r - r0, c - c0) for r, c in coords))
+    return norm, (r0, c0), r1 - r0 + 1, c1 - c0 + 1
+
+
+def _parse_objects(grid: np.ndarray) -> tuple[list[dict], int]:
+    g = np.asarray(grid, dtype=int)
+    if g.shape != (GRID_SIDE, GRID_SIDE):
+        raise AssertionError(f"expected {GRID_SIDE}x{GRID_SIDE} grid, got {g.shape}")
+
