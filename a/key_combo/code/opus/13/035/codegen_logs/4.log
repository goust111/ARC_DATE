+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 3 or w < 3 or h % 2 == 0 or w % 2 == 0:
+        return False
+    coord_set = set(coords)
+    expected = set()
+    for r in range(r0, r1 + 1):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1):
+        expected.add((r0, c))
+        expected.add((r1, c))
+    return coord_set == expected
