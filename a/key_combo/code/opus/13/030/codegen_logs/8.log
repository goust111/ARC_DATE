    return (h - abs(dr)) * (w - abs(dc))


def _gen_norm_sq(vec):
    return vec[0] * vec[0] + vec[1] * vec[1]


def _gen_in_range(value, bounds):
    return bounds[0] <= value <= bounds[1]


def _gen_lattice_area(v1, v2):
    return abs(v1[0] * v2[1] - v1[1] * v2[0])


