+            return None
+        pc = random.randrange(0, left)
+        pr = random.choice(rows_inside if aligned else rows_outside)
+        return pr, pc
+    if left + rw >= gw:
+        return None
+    pc = random.randrange(left + rw, gw)
+    pr = random.choice(rows_inside if aligned else rows_outside)
+    return pr, pc
