+    except AssertionError:
+        return None
+
+    if np.array_equal(filled_h, filled_v):
+        return None
+    if not np.any(region == BLACK):
+        return None
+
+    expected = _expected_output(grid, pattern_bbox, axis)
+    try:
+        actual = main(grid)
+    except Exception:
+        return None
