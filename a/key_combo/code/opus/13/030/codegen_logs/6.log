+    """Cells strictly between two axis-aligned coordinates."""
+    ar, ac = a
+    br, bc = b
+    if ar == br:
+        step = _sign(bc - ac)
+        return [(ar, c) for c in range(ac + step, bc, step)]
+    if ac == bc:
+        step = _sign(br - ar)
+        return [(r, ac) for r in range(ar + step, br, step)]
+    raise AssertionError("expected axis-aligned path")
