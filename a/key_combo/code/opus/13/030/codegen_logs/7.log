    dimensions: min(h,w) 1-2, max(h,w) 2-5, area 2-10
    count: exactly 1 foreground object on the input grid
    position: anywhere on grid (no overlap conflicts possible)
  path:
    type: two 45-degree zigzag chains crossing at the seed bar
    period: h + w (range 3-7)
    chain_1_offsets: (r0 + n*period, c0 + n*period) for all integer n
    chain_2_offsets: (r0 + n*period, c0 - n*period) for all integer n
  trajectory:
    original_copies: same orientation (h x w) in seed color, placed at chain offsets
    rotated_copies: 90-degree rotated (w x h) in the other green/pink color, placed between adjacent originals on each chain
    rotated_offsets_chain1: (r0 + h + n*period, c0 + w + n*period)
    rotated_offsets_chain2: (r0 + h + n*period, c0 - h - n*period)
    clipping: bars extending beyond grid edges are clipped to canvas
