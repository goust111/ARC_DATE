  "src": "one-cell-thick blue rectangular frames on a black background, each enclosing black interior pixels; frames may touch externally",
  "transform": "fill each frame interior red if its interior area is even and orange if it is odd; preserve frame borders and exterior background"
}
</annotation>
<generation_spec>
