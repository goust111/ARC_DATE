+    for _ in range(40):
+        kind = builders[int(rng.integers(0, len(builders)))]
+        if kind == "mixed":
+            frames = _build_mixed(crop_h, crop_w, rng)
+        elif kind == "binary":
+            frames = _build_binary(crop_h, crop_w, rng)
+        elif kind == "chain3":
