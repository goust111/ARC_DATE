+    if outer is None:
+        return None
+
+    allowed = (outer[0] + 2, outer[1] + 2, outer[2] - 2, outer[3] - 2)
+    children: list[Rect] = []
+    for _ in range(200):
+        first = _random_rect_in_region(allowed, 3, 5, 3, 5, rng)
+        second = _random_rect_in_region(allowed, 3, 5, 3, 5, rng)
