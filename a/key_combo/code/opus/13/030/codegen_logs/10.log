+
+
+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    cell_size = int(rng.choice(np.array([3, 4], dtype=int)))
+    num_h = int(rng.choice(np.array([4, 5], dtype=int)))
