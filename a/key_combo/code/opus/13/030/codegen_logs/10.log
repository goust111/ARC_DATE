+def _build_chain(crop_h: int, crop_w: int, levels: int, rng: np.random.Generator) -> list[Rect] | None:
+    outer_min = 11 if levels == 3 else 7
+    outer = _sample_outer_rect(crop_h, crop_w, outer_min, outer_min, rng)
+    if outer is None:
