+        if not np.any(out == RED) or not np.any(out == ORANGE):
+            return False
+        blue_components = components_mask(out == BLUE, connectivity=4)
+        if len(blue_components) != expected_count:
+            return False
+        return True
+    except AssertionError:
+        return False
+
+
