  grid: 10-20 rows x 10-20 cols, always square [observed]
  background: black (0)
  frames:
    count: 2-5 per grid
    shape: always square, 1-cell-thick blue (1) hollow rectangles
    outer_side: 3-10 cells (interior side = outer_side - 2, so 1-8)
    interior: black in input; filled in output
    non_overlapping: frame bounding boxes never overlap; min 1-cell gap between any two frame borders
    parity_mix: each example has at least one even-area and one odd-area interior [observed]
  transform:
