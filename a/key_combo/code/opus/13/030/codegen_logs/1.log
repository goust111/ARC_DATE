+        r0, c0, r1, c1 = bbox_coords(coords)
+        patch = g[r0 : r1 + 1, c0 : c1 + 1]
+        h, w = patch.shape
+        assert h >= 3 and w >= 3, "frame must have non-empty border and interior"
+
