+
+def _draw_frame(patch: np.ndarray, frame_color: int, fill_color: int | None = None) -> np.ndarray:
+    out = patch.copy()
+    out[0, :] = frame_color
+    out[-1, :] = frame_color
+    out[:, 0] = frame_color
+    out[:, -1] = frame_color
