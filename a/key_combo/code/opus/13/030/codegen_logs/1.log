+        border_mask[0, :] = True
+        border_mask[-1, :] = True
+        border_mask[:, 0] = True
+        border_mask[:, -1] = True
+        assert np.array_equal(np.isin(patch, [BLUE, TEAL]), border_mask), "component must be a 1-pixel rectangular frame"
