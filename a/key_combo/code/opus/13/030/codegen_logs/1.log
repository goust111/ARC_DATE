+
+def _expand_bbox(bbox: tuple[int, int, int, int], gap: int, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return max(0, r0 - gap), max(0, c0 - gap), min(h - 1, r1 + gap), min(w - 1, c1 + gap)
