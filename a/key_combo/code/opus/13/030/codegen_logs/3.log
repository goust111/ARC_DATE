+                    [a, b, a],
+                    [c, d, c],
+                    [a, b, a],
+                ],
+                dtype=int,
+            )
+        else:
+            tile = np.array(
+                [
+                    [a, b, b, a],
+                    [c, d, d, c],
+                    [c, d, d, c],
+                    [a, b, b, a],
+                ],
+                dtype=int,
+            )
