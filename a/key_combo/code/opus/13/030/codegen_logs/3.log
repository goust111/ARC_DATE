+    orbits: list[tuple[tuple[int, int], ...]] = []
+    for r in range(size):
+        for c in range(size):
+            if (r, c) in seen:
+                continue
+            orbit = _mirror_orbit(size, r, c)
+            seen.update(orbit)
+            orbits.append(orbit)
+    return orbits
+
+
+def _mirror_restore(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    size = int(g.shape[0])
+    out = g.copy()
+    for orbit in _all_orbits(size):
+        colors = {int(g[r, c]) for r, c in orbit if int(g[r, c]) != BLACK}
+        if not colors:
+            continue
+        assert len(colors) == 1, "mirror orbit colors must agree"
+        color = colors.pop()
+        for r, c in orbit:
+            out[r, c] = color
+    return out
