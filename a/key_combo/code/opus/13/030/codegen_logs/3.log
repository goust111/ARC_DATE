+        for c in range(period):
+            if (r, c) in seen:
+                continue
+            group = {
+                (r, c),
+                (period - 1 - r, c),
+                (r, period - 1 - c),
+                (period - 1 - r, period - 1 - c),
+            }
+            frozen = tuple(sorted(group))
+            seen.update(frozen)
+            groups.append(frozen)
+    return groups
+
+
