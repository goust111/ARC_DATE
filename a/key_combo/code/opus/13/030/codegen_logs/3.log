+    g = np.asarray(grid, dtype=int)
+    tile = np.full((tile_h, tile_w), -1, dtype=int)
+    for r, c in np.argwhere(g != BLACK):
+        phase_r = int(r) % tile_h
+        phase_c = int(c) % tile_w
+        color = int(g[r, c])
+        current = int(tile[phase_r, phase_c])
+        if current == -1:
+            tile[phase_r, phase_c] = color
+        elif current != color:
+            return None
+    if np.any(tile < 0):
+        return None
+    return tile
