+def _mirror_orbit(size: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    orbit = {
+        (int(r), int(c)),
+        (size - 1 - int(r), int(c)),
+        (int(r), size - 1 - int(c)),
+        (size - 1 - int(r), size - 1 - int(c)),
+    }
+    return tuple(sorted(orbit))
+
+
+def _all_orbits(size: int) -> list[tuple[tuple[int, int], ...]]:
