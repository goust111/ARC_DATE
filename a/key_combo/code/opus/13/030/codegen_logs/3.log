+def _generate_case() -> np.ndarray | None:
+    period = int(np.random.choice([3, 4]))
+    size = 12 if period == 3 else int(np.random.choice([12, 16]))
+    tile = _build_symmetric_tile(period)
+    full = _repeat_tile(tile, (size, size))
