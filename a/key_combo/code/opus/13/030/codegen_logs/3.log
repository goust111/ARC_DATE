+        if period == 3 and color_count == 3:
+            a, b, c = map(int, colors)
+            d = a
+        elif period == 4 and color_count == 3:
+            a, b, c = map(int, colors)
+            d = b
+        else:
+            a, b, c, d = map(int, colors[:4])
+        if period == 3:
+            tile = np.array(
