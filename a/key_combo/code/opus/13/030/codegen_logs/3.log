+        for c in range(period):
+            phase_mask = (
+                (np.arange(g.shape[0])[:, None] % period == r)
+                & (np.arange(g.shape[1])[None, :] % period == c)
+            )
+            if not np.any(g[phase_mask] != BLACK):
+                missing.append((r, c))
+    return missing
