+        r = int(r)
+        c = int(c)
+        color = int(g[r, c])
+        if r < red_r:
+            out[r, w - 1 - c] = color
+        elif red_r < r < blue_r:
+            out[r, w - 1 - c] = SWAP[color]
+        elif r > blue_r:
+            out[r, c] = SWAP[color]
+
+    return out
