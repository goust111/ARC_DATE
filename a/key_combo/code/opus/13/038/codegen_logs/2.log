+    intersections: list[tuple[list[tuple[int, int]], int]] = []
+    for obj in objects:
+        left_cov, right_cov = _split_object(obj["coords"])
+        for r, c in left_cov:
+            left[r, c] = obj["color"]
+        for r, c in right_cov:
+            right[r, c] = obj["color"]
+        shared = sorted(left_cov & right_cov)
+        if shared:
+            intersections.append((shared, obj["color"]))
