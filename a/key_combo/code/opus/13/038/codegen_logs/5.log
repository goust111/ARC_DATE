spec:
  grid:
    input: H rows x (2*W+1) cols, width is odd
    output: H x W (half-width minus separator)
    H: 3 [observed], W: 3 [observed]
  separator:
    solid vertical column at middle index W
    single non-bg color, distinct from both mask colors
    color: yellow(4) [observed]
  background: black(0) [observed]
  left_mask:
    region [:, :W], one foreground color on bg, not connected required
    color: magenta(6) [observed], fg_cells: 2-7
  right_mask:
    region [:, W+1:], one foreground color on bg, distinct from left
    color: azure(8) [observed], fg_cells: 3-5
  color_constraint: bg, separator, left_fg, right_fg are 4 distinct colors
  transform:
    output = union of left and right mask positions, recolored red(2)
    overlap between masks: 1-2 cells [observed]
    output fg_cells: 4-8

generation_strategy:
  approach: output-first
  steps:
    1. Pick H in 3-6, W in 3-5. Choose 4 distinct colors for bg, separator, left_fg, right_fg.
    2. Generate output mask on H x W grid with fg_cells in [ceil(H*W*0.4), H*W-1] colored red, rest bg.
    3. Split output fg cells into three sets - left_only, right_only, both (overlap >= 1).
       Left mask fg = left_only + both; right mask fg = right_only + both.
       Ensure each side has >= 2 fg cells.
    4. Build input grid (H x 2W+1) - left region with left_fg color, separator column, right region with right_fg color.
