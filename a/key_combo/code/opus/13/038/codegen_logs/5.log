+    correct = _overlay_from_masks(left_mask, rotated_right_mask)
+    if not np.array_equal(correct, main(grid)):
+        return False
+
+    for alt in _alternative_outputs(right_input_mask, left_mask):
+        if np.array_equal(alt, correct):
