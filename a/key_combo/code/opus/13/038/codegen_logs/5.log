+
+    both = left_mask & rotated_right_mask
+    left_only = left_mask & ~rotated_right_mask
+    right_only = ~left_mask & rotated_right_mask
+    if int(both.sum()) < 2 or int(left_only.sum()) < 2 or int(right_only.sum()) < 2:
+        return False
