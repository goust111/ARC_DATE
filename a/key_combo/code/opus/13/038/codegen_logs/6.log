+    c_cut_hi = min(VISIBLE_CUT_RANGE[1], W - 2)
+    r_cut = random.randint(VISIBLE_CUT_RANGE[0], r_cut_hi)
+    c_cut = random.randint(VISIBLE_CUT_RANGE[0], c_cut_hi)
