+
+    for obj in objects:
+        inp[obj["coords"][:, 0], obj["coords"][:, 1]] = int(obj["color"])
+
+    expected = main(inp)
+    if not _validate_case(inp, expected):
+        return None
+    return inp, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        built = _generate_case()
