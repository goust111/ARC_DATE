+def _pick_margin(available: int, prefer_large: bool) -> int:
+    if available <= 0:
+        return 0
+    if available == 1:
+        return 1
+    if prefer_large:
+        return 2 if random.random() < 0.7 else 1
+    return 1 if random.random() < 0.7 else 2
