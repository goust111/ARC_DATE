+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+PALETTE = [BLUE, GREEN, YELLOW, ORANGE]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+MAX_GENERATION_ATTEMPTS = 400
+MAX_LOCAL_ATTEMPTS = 120
