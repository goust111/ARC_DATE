+        patch = piece["patch"]
+        for rr in range(patch.shape[0]):
+            for cc in range(patch.shape[1]):
+                value = int(patch[rr, cc])
+                if value == RED:
+                    canvas[r0 + rr, c0 + cc] = RED
+                elif value != BLACK:
+                    canvas[r0 + rr, c0 + cc] = value
