+        bbox = _bbox_from_coords(coords)
+        patch = _crop(grid, bbox)
+        rel = coords - np.array([bbox[0], bbox[1]])
+        mask = np.zeros(patch.shape, dtype=bool)
+        mask[rel[:, 0], rel[:, 1]] = True
