+        candidates = [
+            (r, c)
+            for r in range(0, full_h - piece.shape[0] + 1)
+            for c in range(0, full_w - piece.shape[1] + 1)
+            if _can_place(grid[:-1, :], piece, r, c, pad=1)
+        ]
+        if not candidates:
+            return None
+        r, c = random.choice(candidates)
