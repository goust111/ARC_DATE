  separator: single color filling entire row; always 5 [observed]
  background: single color filling result region; always 0 [observed]
  source_region:
    colors: 2-8 distinct colors, none equal to separator or background color
    majority: exactly one color has strictly highest count
    pixel_fill: every cell filled with a non-bg non-sep color (no blanks)
