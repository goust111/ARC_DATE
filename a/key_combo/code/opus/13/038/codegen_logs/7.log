+
+def _place_holes(frame_h: int, frame_w: int, areas: list[int]) -> list[dict] | None:
+    occupied = np.zeros((frame_h, frame_w), dtype=bool)
+    blocked = np.zeros((frame_h, frame_w), dtype=bool)
+    holes: list[dict] = []
+    center = np.array([frame_h / 2.0, frame_w / 2.0])
