+    for area in areas:
+        choices = []
+        for shape in _shape_candidates(area):
+            sh, sw = shape.shape
+            for r0 in range(1, frame_h - sh):
+                for c0 in range(1, frame_w - sw):
+                    if blocked[r0 : r0 + sh, c0 : c0 + sw][shape].any():
