+    out = np.zeros(shape, dtype=int)
+    winner_map: dict[tuple[int, int], Claim] = {}
+    for cell, claims in claim_map.items():
+        best = min(claims, key=_claim_priority)
+        winner_map[cell] = best
+        out[cell] = best.color
+    for (r, c), color in marker_cells.items():
+        out[r, c] = color
