+@dataclass(frozen=True)
+class Domino:
+    color: int
+    orientation: str
+    r: int
+    c: int
+
+    def cells(self) -> tuple[tuple[int, int], tuple[int, int]]:
+        if self.orientation == "H":
+            return ((self.r, self.c), (self.r, self.c + 1))
