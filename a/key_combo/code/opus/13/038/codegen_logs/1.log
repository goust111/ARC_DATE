def _gen_grey_layout_valid(grey_mask, total):
    grey_count = int(np.count_nonzero(grey_mask))
    grey_ratio = grey_count / total
    if not (GREY_DENSITY_LIMITS[0] <= grey_ratio <= GREY_DENSITY_LIMITS[1]):
