+BG = 0
+COLORS = tuple(range(1, 10))
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+VERTICAL_STEPS = (-1, 1)
+GEN_ATTEMPTS = 600
+PAIR_GAP = 2
