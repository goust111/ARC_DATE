+TOP_BG = 0
+PANEL_BG = 5
+CROSS_COLOR = 2
+TOP_H = 2
+SQUARE_COLORS = (1, 3, 4)
+ODD_SIDES = (3, 5)
+EVEN_SIDES = (2, 4)
+TOTAL_SQUARE_RANGE = (6, 10)
+PANEL_H_RANGE = (12, 18)
+PANEL_W_RANGE = (12, 18)
+MAX_GEN_ATTEMPTS = 600
