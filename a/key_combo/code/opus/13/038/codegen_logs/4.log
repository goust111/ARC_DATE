+def _validate_generated_case(
+    grid: np.ndarray,
+    panel_h: int,
+    panel_w: int,
+    markers: list[tuple[int, int]],
+    squares: list[dict],
+    plus_center: tuple[int, int],
+    expect_plus_kept: bool,
+) -> bool:
+    try:
+        parsed_markers, plus, parsed_squares = _extract_structure(grid)
+        if parsed_markers != markers:
