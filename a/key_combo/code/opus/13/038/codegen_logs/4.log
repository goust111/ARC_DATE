+    side_w = int(c1 - c0 + 1)
+    return side_h == side_w and int(comp["area"]) == side_h * side_w
+
+
+def _extract_structure(grid: np.ndarray) -> tuple[list[tuple[int, int]], dict, list[dict]]:
+    g = np.asarray(grid, dtype=int)
