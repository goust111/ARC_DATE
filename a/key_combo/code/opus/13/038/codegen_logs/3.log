+        if deg == 1:
+            ends.append((r, c))
+    assert len(ends) == 2, "snake must have exactly two endpoints"
+    cur = min(ends)
+    prev = None
+    order: list[tuple[int, int]] = []
+    for _ in range(len(coords)):
+        order.append(cur)
+        nxts = []
+        for dr, dc in DIR4:
+            nxt = (cur[0] + dr, cur[1] + dc)
+            if nxt in pts and nxt != prev:
+                nxts.append(nxt)
+        if not nxts:
+            break
+        assert len(nxts) == 1, "snake path cannot branch"
+        prev, cur = cur, nxts[0]
