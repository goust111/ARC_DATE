+
+def _get_bg(grid: np.ndarray) -> int:
+    counts = np.bincount(grid.ravel().astype(int), minlength=10)
+    return int(np.argmax(counts))
+
+
+def _component_info(grid: np.ndarray, coords: list[tuple[int, int]]) -> dict:
+    arr = np.array(coords, dtype=int)
+    values = [int(grid[r, c]) for r, c in coords]
+    rows = [r for r, _c in coords]
+    cols = [c for _r, c in coords]
+    return {
+        "coords": coords,
+        "coord_set": set(coords),
+        "array": arr,
+        "area": len(coords),
+        "bbox": (min(rows), min(cols), max(rows), max(cols)),
+        "colors": set(values),
+    }
+
+
+def _find_foreground_components(grid: np.ndarray, bg: int) -> list[dict]:
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[dict] = []
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or int(grid[r, c]) == bg:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < H and 0 <= nc < W and not seen[nr, nc] and int(grid[nr, nc]) != bg:
