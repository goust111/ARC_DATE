+    snake_colors = scene["snake_colors"]
+    counts = Counter(snake_colors)
+    latest_last_color = snake_colors[-1]
+    if latest_last_color in {grow_color, shrink_color}:
+        return False
+    if counts[grow_color] >= max(counts.values()):
