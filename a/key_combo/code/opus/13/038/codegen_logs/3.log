+
+GENERAL_OBJECT_TEMPLATES = SHRINK_DISAPPEAR_TEMPLATES + SHRINK_SURVIVE_TEMPLATES + [
+    {(0, 0), (0, 1), (1, 1), (2, 1), (2, 2)},
+    {(0, 0), (1, 0), (1, 1), (1, 2), (2, 2)},
+    {(0, 0), (0, 1), (1, 0), (1, 1), (2, 1)},
+    {(0, 1), (1, 0), (1, 1), (2, 1), (2, 2)},
