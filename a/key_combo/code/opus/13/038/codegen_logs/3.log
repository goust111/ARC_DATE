+        if _first_order(colors) != priority:
+            continue
+        if colors[-1] not in middle:
+            continue
+        counts = Counter(colors)
+        max_count = max(counts.values())
+        if counts[priority[0]] == max_count:
+            continue
+        if counts[middle[0]] <= counts[priority[0]]:
+            continue
