+def _is_simple_path(coords: list[tuple[int, int]]) -> bool:
+    pts = set(coords)
+    degs = []
+    for r, c in coords:
+        deg = sum((r + dr, c + dc) in pts for dr, dc in DIR4)
+        degs.append(deg)
+    return degs.count(1) == 2 and all(deg in (1, 2) for deg in degs)
