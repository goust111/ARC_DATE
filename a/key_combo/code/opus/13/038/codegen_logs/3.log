+def _growth_cells(grid: np.ndarray, bg: int, obj_coords: list[tuple[int, int]]) -> set[tuple[int, int]]:
+    H, W = grid.shape
+    growth: set[tuple[int, int]] = set()
+    for r, c in obj_coords:
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < H and 0 <= nc < W and int(grid[nr, nc]) == bg:
+                growth.add((nr, nc))
