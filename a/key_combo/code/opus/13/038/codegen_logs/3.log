+    output_sig = hashlib.md5(out.tobytes() + str(out.shape).encode()).hexdigest()
+    if output_sig in _SEEN_OUTPUT_SIGNATURES:
+        return None
+    _SEEN_OUTPUT_SIGNATURES.add(output_sig)
+    return grid
