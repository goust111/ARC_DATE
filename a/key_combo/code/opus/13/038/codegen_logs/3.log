+
+def _random_place(grid: np.ndarray, occupied: set[tuple[int, int]], patch: np.ndarray) -> tuple[int, int] | None:
+    H, W = grid.shape
+    h, w = patch.shape
+    coords = _patch_fg_coords(patch)
