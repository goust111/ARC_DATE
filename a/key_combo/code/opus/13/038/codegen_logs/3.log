+    cols = [c for _r, c in coords]
+    r0 = min(rows)
+    c0 = min(cols)
+    return sorted((r - r0, c - c0) for r, c in coords)
+
+
+def _shift_path_to_origin(path: list[tuple[int, int]]) -> list[tuple[int, int]]:
