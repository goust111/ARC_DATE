+            if nxt in pts and nxt != prev:
+                nxts.append(nxt)
+        if not nxts:
+            break
+        assert len(nxts) == 1, "snake path cannot branch"
+        prev, cur = cur, nxts[0]
+    assert len(order) == len(coords), "snake traversal must cover every path cell"
+    return order
