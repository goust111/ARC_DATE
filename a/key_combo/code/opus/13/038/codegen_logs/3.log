+    grid = np.zeros((H, W), dtype=int)
+    occupied: set[tuple[int, int]] = set()
+    object_places: dict[int, tuple[int, int]] = {}
+    for color in sorted(colors, key=lambda c: len(obj_shapes[c]), reverse=True):
