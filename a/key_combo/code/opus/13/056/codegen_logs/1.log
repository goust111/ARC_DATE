+    v_band_right = max(c1 for _, c1 in v_cols)
+    if h_band_top < 2 or v_band_left < 2 or h_band_bottom > grid_h - 3 or v_band_right > grid_w - 3:
+        return None
+
+    horizontal_frames: list[tuple[int, int, int, int, np.ndarray]] = []
+    for r0, r1 in h_rows:
