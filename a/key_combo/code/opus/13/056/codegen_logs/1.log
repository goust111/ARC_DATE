+
+
+def _region_boundary_colors(grid: np.ndarray, region: list[tuple[int, int]]) -> list[int]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    boundary: set[int] = set()
+    for r, c in region:
