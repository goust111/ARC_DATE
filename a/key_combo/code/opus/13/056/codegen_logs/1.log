+                outside[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if grid[r, c] == 0 and not outside[r, c]:
+                outside[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for dr, dc in N4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and grid[nr, nc] == 0 and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+    return outside
+
+
+def _crossing_edges(grid: np.ndarray) -> set[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    edges: set[tuple[int, int]] = set()
