+
+
+def _frame_patch(height: int, width: int, orientation: str) -> np.ndarray:
+    patch = np.zeros((height, width), dtype=int)
+    if orientation == "h":
+        split = random.randint(1, height - 2)
+        left_shift_limit = min(2, width - 4)
