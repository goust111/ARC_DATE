+def _unique_bottom_to_top(colors: list[int], edges: set[tuple[int, int]]) -> list[int]:
+    higher_from: dict[int, set[int]] = {color: set() for color in colors}
+    indeg = {color: 0 for color in colors}
+    for lower, upper in edges:
