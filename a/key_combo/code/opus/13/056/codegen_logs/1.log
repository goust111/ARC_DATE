+
+def _gen_attempt() -> np.ndarray | None:
+    total = random.randint(3, 5)
+    layer_orients = _orientation_sequence(total)
+    h_count = layer_orients.count("h")
+    v_count = layer_orients.count("v")
+    h_rows, grid_h = _spaced_intervals(h_count, (4, 5))
