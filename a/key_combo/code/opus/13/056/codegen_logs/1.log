+
+
+def _modal_boundary_color(grid: np.ndarray, region: list[tuple[int, int]]) -> int | None:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    counts: Counter[int] = Counter()
+    for r, c in region:
+        for dr, dc in N4:
