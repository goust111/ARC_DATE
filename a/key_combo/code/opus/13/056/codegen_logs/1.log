+    return max(sorted(counts), key=lambda color: counts[color])
+
+
+def _fill_with_rank(grid: np.ndarray, rank: dict[int, int]) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    outside = _outside_black(g)
