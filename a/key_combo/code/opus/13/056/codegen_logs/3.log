+    out = g.copy()
+    for target in targets:
+        tr0, tc0, _, _ = target["bbox"]
+        for source in sources:
+            kind = _equivalence_kind(source, target)
+            if kind is None:
+                continue
+            for rr, cc in _map_markers(source, (target["h"], target["w"]), kind):
+                out[tr0 + rr, tc0 + cc] = ORANGE
