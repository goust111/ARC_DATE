+def _make_scenario() -> list[dict]:
+    mode = random.choices(
+        ["single", "disjoint", "overlap"],
+        weights=[0.4, 0.35, 0.25],
+        k=1,
+    )[0]
+    if mode == "single":
+        rects = _single_source_scenario()
+    elif mode == "disjoint":
+        rects = _two_source_disjoint_scenario()
+    else:
