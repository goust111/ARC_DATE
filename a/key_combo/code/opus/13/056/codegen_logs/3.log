+def _orange_set_in_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    local = np.argwhere(grid[r0 : r1 + 1, c0 : c1 + 1] == ORANGE)
+    return {tuple(map(int, rc)) for rc in local}
+
