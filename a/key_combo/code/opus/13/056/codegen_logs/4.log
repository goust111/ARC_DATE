+def _fill_enclosed_black(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    exterior = _exterior_black_mask(out)
+    out[(out == BLACK) & ~exterior] = YELLOW
