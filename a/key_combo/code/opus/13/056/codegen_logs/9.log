+def _corner_path_mask(h: int, w: int) -> np.ndarray:
+    start = random.choice([(0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)])
+    end = (h - 1 - start[0], w - 1 - start[1])
+    moves = [(1 if end[0] > start[0] else -1, 0)] * abs(end[0] - start[0])
