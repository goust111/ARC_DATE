+        patch = sprite["patch"]
+        ph, pw = patch.shape
+        placed = False
+        for r0, c0 in _edge_candidates(grid.shape, patch.shape, band=4):
+            bbox = (r0, c0, r0 + ph - 1, c0 + pw - 1)
+            if not _can_place_bbox(bbox, existing, padding=1):
+                continue
+            _paste(grid, patch, r0, c0)
+            existing.append(bbox)
+            sprite["bbox"] = bbox
