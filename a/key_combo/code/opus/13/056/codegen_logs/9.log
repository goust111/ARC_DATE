+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in {BLACK, GREY}):
+        for coords in _component_coords(grid == color):
+            bbox = _bbox_from_coords(coords)
+            crop = _crop_bbox(grid, bbox)
+            sprites.append(
