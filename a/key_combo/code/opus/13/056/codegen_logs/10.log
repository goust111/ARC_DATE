+    pivot_r = int(pivot_rows[0])
+    markers = pivot_markers[0]
+
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color == BLACK:
+                continue
+            if color == BLUE:
+                assert (r == top_r and left_c < c < right_c) or (r == bottom_r and left_c < c < right_c) or (
