+        if segment.size != interior_w:
+            continue
+        if not np.all(np.isin(segment, [YELLOW, RED, GREEN])):
+            continue
+        markers = [(int(c), int(g[r, c])) for c in range(left_c + 1, right_c) if int(g[r, c]) in MARKER_DISTANCE]
+        if 2 <= len(markers) <= 4:
+            pivot_rows.append(r)
+            pivot_markers.append(markers)
