+def _parse_input(grid: np.ndarray) -> tuple[int, int, int, int, int, list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    allowed = {BLACK, BLUE, RED, GREEN, YELLOW}
