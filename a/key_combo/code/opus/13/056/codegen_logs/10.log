+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+MARKER_DISTANCE = {RED: 3, GREEN: 4}
+PATTERN_CYCLE = (
+    ((RED,), (RED,)),
+    ((GREEN,), (GREEN,)),
+    ((RED, GREEN), (RED,)),
+    ((GREEN,), (RED, GREEN)),
