+    assert np.all(out[bottom_r, left_c : right_c + 1] == BLUE)
+    assert np.all(out[top_r + 1 : bottom_r, left_c] == BLUE)
+    assert np.all(out[top_r + 1 : bottom_r, right_c] == BLUE)
+
+    marker_cols = {col for col, _ in markers}
