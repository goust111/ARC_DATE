+
+    if len(set(dominant_colors)) < 2:
+        return False
+    if len(set(distractor_colors)) != 1:
+        return False
+    if edge_blocks < 2 or clipped_blocks < 1:
+        return False
+    if len(set(block_outputs)) < 2:
+        return False
+
+    return True
+
