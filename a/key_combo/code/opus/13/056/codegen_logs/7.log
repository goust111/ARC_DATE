+        return [(r0, c) for c in range(c0 + 1, c1)]
+    if side == "bottom":
+        return [(r1, c) for c in range(c0 + 1, c1)]
+    if side == "left":
+        return [(r, c0) for r in range(r0 + 1, r1)]
+    return [(r, c1) for r in range(r0 + 1, r1)]
