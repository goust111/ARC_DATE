+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in DIRS4:
+            rr, cc = r + dr, c + dc
+            if _in_bounds(grid.shape, rr, cc):
+                add(rr, cc)
+
+    return exterior
