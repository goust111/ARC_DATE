+def _flood_exterior_black(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    def add(r: int, c: int) -> None:
+        if grid[r, c] == BLACK and not exterior[r, c]:
+            exterior[r, c] = True
+            queue.append((r, c))
