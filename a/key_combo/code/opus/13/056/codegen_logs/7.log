+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
