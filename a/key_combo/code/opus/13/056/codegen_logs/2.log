+BG = 0
+RED = 2
+GREY = 5
+
+GRID_SIDE_RANGE = (10, 16)
+INTERIOR_SIDES = (3, 4)
+RED_COUNT_RANGE = (2, 4)
+MAX_GENERATION_ATTEMPTS = 600
