+            cropped_coords, cropped_shape = cropped
+            if tuple(map(int, cropped_shape)) != (ch, cw):
+                continue
+            if not _spans_shape(cropped_coords, (ch, cw)):
+                continue
+            patch = _render_local_coords(cropped_coords, (ch, cw), color)
+            matches.append((idx, patch))
