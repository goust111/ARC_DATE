+def _pack_cavities(specs: list[dict]) -> tuple[int, int, list[tuple[int, int]]] | None:
+    min_h = max(8, max(spec["keep_shape"][0] for spec in specs) + 4)
+    min_w = max(9, max(spec["keep_shape"][1] for spec in specs) + 5)
+    for _ in range(200):
