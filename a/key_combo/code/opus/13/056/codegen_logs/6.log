+def _random_connected_shape(h: int, w: int, area: int) -> np.ndarray:
+    start = (random.randrange(h), random.randrange(w))
+    cells = {start}
+    frontier = set()
+    while len(cells) < area:
+        frontier.clear()
+        for r, c in cells:
+            for nr, nc in _neighbors(r, c, 4):
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
