+            keep_w = random.randint(2, 4 - (1 if amount == 2 else 0))
+            full_shape = (keep_h, keep_w + amount)
+            keep_shape = (keep_h, keep_w)
+        else:
+            keep_h = random.randint(2, 4 - (1 if amount == 2 else 0))
+            keep_w = random.randint(2, 3)
