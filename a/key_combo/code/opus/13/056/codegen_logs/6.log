+
+def _place_external_pairs(
+    grid: np.ndarray,
+    specs: list[dict],
+    frame_bbox: tuple[int, int, int, int],
+) -> bool:
+    h, w = grid.shape
+    fr0, fc0, fr1, fc1 = frame_bbox
+    forbidden = {
+        (r, c)
+        for r in range(max(0, fr0 - 1), min(h, fr1 + 2))
+        for c in range(max(0, fc0 - 1), min(w, fc1 + 2))
