+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 5
+SPRITE_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+DIRECTIONS = ["right", "left", "down", "up"]
+DIR_STEP = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
+}
+DIR_TO_CROP_SIDE = {
+    "right": "left",
+    "left": "right",
+    "down": "top",
+    "up": "bottom",
+}
+OTHER_AXIS_SIDE = {
+    "left": "right",
+    "right": "left",
+    "top": "bottom",
+    "bottom": "top",
+}
