+    height, width = map(int, g.shape)
+
+    band_left, band_right, band = _parse_top_band(g)
+    obstacle_row, obstacle_left, obstacle_right = _parse_obstacle(g)
+
+    mask = np.ones_like(g, dtype=bool)
