WIDTH_WITH_GAP = 3
EXTRA_HEIGHT_RANGE, EXTRA_WIDTH_RANGE = (0, 2), (0, 3)
MAX_GENERATION_ATTEMPTS = 300


def _expected_output(grid: np.ndarray, left: int, span_width: int) -> np.ndarray:
    expected = grid.copy()
    right = left + span_width - 1
