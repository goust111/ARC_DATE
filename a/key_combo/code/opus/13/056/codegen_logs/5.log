+            hi = band_right - source_depth
+            colors = band[source_depth : span_width - source_depth]
+            if (source_depth + 1) % 2 == 1:
+                colors = _swap_signal_array(colors)
+            out[obstacle_row + d, lo : hi + 1] = colors
+
+    return out
+
