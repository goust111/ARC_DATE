+    tip_depth = span_width // 2
+
+    for r in range(1, min(height, tip_depth + 1)):
+        lo = band_left + r
+        hi = band_right - r
+        if lo > hi:
+            break
+        colors = band[r : span_width - r]
+        if r % 2 == 1:
+            colors = _swap_signal_array(colors)
+        out[r, lo : hi + 1] = colors
+
