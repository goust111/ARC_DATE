+        out = main(grid)
+    except Exception:
+        return False
+
+    if np.array_equal(out, grid):
+        return False
+    if np.count_nonzero(out == WALL_MARK) != int(np.count_nonzero(wall_mask)):
+        return False
+    if np.count_nonzero(out == PATH_COLOR) <= 2:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    count = random.choice((2, 3, 4))
+    grid = _build_canonical_layout(count)
+    if grid is None:
+        return None
+    grid = _random_symmetry(grid)
+    if not _validate_generated(grid, count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid hidden-rectangle corridor grid")

