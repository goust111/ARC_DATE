+        nr, nc = r + dr, c + dc
+        if not in_bounds(wall_mask.shape, nr, nc):
+            break
+
+        if not bool(wall_mask[nr, nc]):
+            r, c = int(nr), int(nc)
+            path.append((r, c))
+            if _is_border(wall_mask.shape, r, c) and (r, c) != border:
+                break
+            continue
