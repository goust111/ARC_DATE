+def _gen_for_count(count: int, attempts: int = 24) -> np.ndarray | None:
+    for _ in range(attempts):
+        grid = _build_canonical_layout(count)
+        if grid is None:
+            continue
+        grid = _random_symmetry(grid)
+        if _validate_generated(grid, count):
+            return grid
+    return None
+
