+        return None
+    c1 = random.randint(c1_min, c1_max)
+
+    rects: list[tuple[int, int, int, int]] = []
+
+    if count == 4:
+        w3 = random.randint(4, 6)
+        c3_min = c1 + 6
+        c3_max = w - w3 - 3
+        if c3_min > c3_max:
+            return None
+        c3 = random.randint(c3_min, c3_max)
