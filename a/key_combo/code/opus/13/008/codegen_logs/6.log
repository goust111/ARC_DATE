+    for r, c in path:
+        if not wall_mask[r, c]:
+            out[r, c] = PATH_COLOR
+    return out
+
+
+def _rect_mask(shape: tuple[int, int], rects: list[tuple[int, int, int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r0, c0, r1, c1 in rects:
