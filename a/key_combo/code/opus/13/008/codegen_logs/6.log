+def _gen_attempt() -> np.ndarray | None:
+    count = random.choices((2, 3, 4), weights=(3, 3, 5))[0]
+    grid = _build_canonical_layout(count)
+    if grid is None:
+        return None
+    grid = _random_symmetry(grid)
+    if not _validate_generated(grid, count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid hidden-rectangle corridor grid")

