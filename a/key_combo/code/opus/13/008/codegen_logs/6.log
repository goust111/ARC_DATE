+                    for rr in range(r, r + MIN_SIDE)
+                    for cc in range(c, c + MIN_SIDE)
+                    if not fixed_mask[rr, cc]
+                ]
+                if not coords:
+                    continue
+                for rr, cc in coords:
+                    grid[rr, cc] = random.choice(NOISE_COLORS)
+                changed = True
+        if not changed:
+            return True
+    return False
+
