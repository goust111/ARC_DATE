+        choices: list[tuple[int, int]] = []
+        for tdr, tdc in ((-dc, dr), (dc, -dr)):
+            tr, tc = r + tdr, c + tdc
+            if in_bounds(wall_mask.shape, tr, tc) and not bool(wall_mask[tr, tc]):
+                choices.append((int(tdr), int(tdc)))
