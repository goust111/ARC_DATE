0055:     out = g.copy()
0056:     for base_color in (Color.BLACK, Color.BLUE):
0057:         labels, n_labels = label_mask(g == base_color, connectivity=4)
0058:         assert n_labels > 0, "expected each base color to appear"
0059:         for label_id in range(1, n_labels + 1):
0060:             component = np.argwhere(labels == label_id)
0061:             out[labels == label_id] = _best_marker_color(g, component, markers)
