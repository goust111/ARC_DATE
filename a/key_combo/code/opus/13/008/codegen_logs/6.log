+        w3 = 0
+        w0_max = min(10, w - c1 - 2)
+    if w0_max < 4:
+        return None
+    w0 = random.randint(4, w0_max)
+    rects.append((r1 - h0, c1, r1 - 1, c1 + w0 - 1))
+
+    if count == 2:
+        bottom1 = random.randint(r1 + 3, h - 2)
+        rects.append((r1, c1 - w1, bottom1, c1 - 1))
+    else:
+        h2 = random.randint(4, 6)
