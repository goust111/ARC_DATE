+            if overlaps(r0, r1, or0, or1) and overlaps(c0, c1, oc0, oc1):
+                return False
+            if overlaps(r0, r1, or0, or1) and (c1 + 1 == oc0 or oc1 + 1 == c0):
+                return False
+            if overlaps(c0, c1, oc0, oc1) and (r1 + 1 == or0 or or1 + 1 == r0):
+                return False
