+    border, inner, (dr, dc) = start_info
+    path = [border, inner]
+    turns = 0
+    r, c = inner
+    seen_states: set[tuple[int, int, int, int]] = set()
+
+    while True:
+        state = (r, c, dr, dc)
+        assert state not in seen_states, "path should not cycle"
+        seen_states.add(state)
+
+        nr, nc = r + dr, c + dc
+        if not in_bounds(wall_mask.shape, nr, nc):
+            break
