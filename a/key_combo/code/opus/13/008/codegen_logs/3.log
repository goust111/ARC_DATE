/bin/bash -lc "python - <<'PY'
import random
from collections import deque, defaultdict
import numpy as np

TEAL, GREY, GREEN, ORANGE = 8,5,3,7
DIRS = [(-1,-1),(-1,1),(1,-1),(1,1)]
CARD = [(1,0),(-1,0),(0,1),(0,-1)]


def full_arm_path(anchor, dr, dc, shape):
    H,W = shape
    r,c = anchor
    path=[]
    while True:
        for _ in range(2):
            c += dc
            if not (0 <= r < H and 0 <= c < W):
                return path
            path.append((r,c))
        for _ in range(2):
            r += dr
            if not (0 <= r < H and 0 <= c < W):
                return path
            path.append((r,c))


def render(grid):
    out=grid.copy()
    ar,ac = map(int, np.argwhere(out==TEAL)[0])
    H,W = out.shape
    for dr,dc in DIRS:
        r,c=ar,ac
        while True:
            stopped=False
            for _ in range(2):
                nc = c + dc
                if not (0 <= r < H and 0 <= nc < W) or out[r,nc] == GREY:
                    stopped=True; break
                c=nc; out[r,c]=GREY
            if stopped: break
            for _ in range(2):
                nr = r + dr
                if not (0 <= nr < H and 0 <= c < W) or out[nr,c] == GREY:
                    stopped=True; break
                r=nr; out[r,c]=GREY
            if stopped: break
    out[ar,ac]=TEAL
    return out


def feasible(out):
    H,W=out.shape
    open_mask = (out "'!= GREY) & (out != TEAL)
    F=np.zeros((H-1,W-1),bool)
    for r in range(H-1):
        for c in range(W-1):
            F[r,c]=open_mask[r:r+2,c:c+2].all()
    return open_mask,F


def comps(mask):
    H,W=mask.shape
    seen=set(); res=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or (r,c) in seen: continue
            q=deque([(r,c)]); seen.add((r,c)); cur=[]
            while q:
                p=q.popleft(); cur.append(p)
                for dr,dc in CARD:
                    rr,cc=p[0]+dr,p[1]+dc
                    if 0<=rr<H and 0<=cc<W and mask[rr,cc] and (rr,cc) not in seen:
                        seen.add((rr,cc)); q.append((rr,cc))
            res.append(cur)
    return res


def slide_neighbors(F):
    H,W = F.shape
    states = [(r,c) for r in range(H) for c in range(W) if F[r,c]]
    nbr={}
    deg={}
    for r,c in states:
        outs=[]
        for dr,dc in CARD:
            rr,cc=r,c
            moved=False
            while True:
                nr,nc=rr+dr,cc+dc
                if not (0<=nr<H and 0<=nc<W and F[nr,nc]):
                    break
                rr,cc=nr,nc; moved=True
            if moved:
                outs.append((rr,cc))
        nbr[(r,c)] = sorted(set(outs))
        deg[(r,c)] = len(nbr[(r,c)])
    return states,nbr,deg


def bfs(start,nbr):
    dist={start:0}; q=deque([start])
    while q:
        u=q.popleft()
        for v in nbr[u]:
            if v not in dist:
                dist[v]=dist[u]+1; q.append(v)
    return dist


def choose(branch):
    for att in range(1000):
        H=random.randint(17,24); W=random.randint(17,24)
        anchor=(random.randint(5,H-6), random.randint(5,W-6))
        paths={d:full_arm_path(anchor,d[0],d[1],(H,W)) for d in DIRS}
        if min(len(v) for v in paths.values()) < 8: continue
        grid=np.zeros((H,W),int)
        grid[anchor]=TEAL
        grey=set()
        for d,p in paths.items():
            ends=[i for i in range(3,len(p),4)]
            if len(ends)<2: break
            idx=random.choice(ends[1:])
            grey.add(p[idx])
            later=[j for j in ends if j>idx+3]
            if later and random.random()<0.45:
                grey.add(p[random.choice(later)])
        else:
            if not (4 <= len(grey) <= 8): continue
            for cell in grey: grid[cell]=GREY
            out=render(grid)
            open_mask,F=feasible(out)
            if F.sum() < 40: continue
            Fcomps=comps(F)
            Ocomps=comps(open_mask)
            states,nbr,deg=slide_neighbors(F)
            if not states: continue
            op_comp_index={p:i for i,comp in enumerate(Ocomps) for p in comp}
            state_open_comp={s: op_comp_index[(s[0],s[1])] for s in states if (s[0],s[1]) in op_comp_index}
            # better representative as top-left cell only, rough
            if branch=='"'reach':
                cand=[s for s in states if deg[s]>=2]
                random.shuffle(cand)
                for s in cand[:60]:
                    dist=bfs(s,nbr)
                    far=[t for t,d in dist.items() if d>=2 and deg[t]>=1]
                    if len(dist)<8 or not far: continue
                    t=max(far,key=lambda x:(dist[x],abs(x[0]-s[0])+abs(x[1]-s[1])))
                    return att,H,W,anchor,grey,s,t,out,F,nbr,dist
            else:
                # start in one F component, target in another but same open component by any corner cell
                comp_of_state={s:i for i,comp in enumerate(Fcomps) for s in comp}
                cand=[s for s in states if deg[s]>=2]
                random.shuffle(cand)
                for s in cand[:80]:
                    dist=bfs(s,nbr)
                    if len(dist)<8: continue
                    same_open=[]
                    for t in states:
                        if comp_of_state[t]==comp_of_state[s]:
                            continue
                        # any cell of 2x2 in same open comp? rough use top-left and bottom-right
                        cells=[(t[0],t[1]),(t[0]+1,t[1]),(t[0],t[1]+1),(t[0]+1,t[1]+1)]
                        oc={op_comp_index.get(c) for c in cells}
                        scells=[(s[0],s[1]),(s[0]+1,s[1]),(s[0],s[1]+1),(s[0]+1,s[1]+1)]
                        soc={op_comp_index.get(c) for c in scells}
                        if None in oc or None in soc: continue
                        if oc & soc:
                            same_open.append(t)
                    if not same_open: continue
                    t=min(same_open,key=lambda x:abs(x[0]-s[0])+abs(x[1]-s[1]))
                    return att,H,W,anchor,grey,s,t,out,F,nbr,dist
    return None

for branch in ['reach','stuck']:
    res=choose(branch)
    print(branch, bool(res), None if res is None else {'size':res[5:7],'H':res[1],'W':res[2],'grey':len(res[4]),'reach':len(res[10])})
