+        dest = max(
+            candidates,
+            key=lambda state: (
+                min(4, _corner_profile(state, feasible.shape)[1]) == _corner_profile(state, feasible.shape)[1],
+                int(dist[state]),
+                abs(int(state[0]) - int(start[0])) + abs(int(state[1]) - int(start[1])),
