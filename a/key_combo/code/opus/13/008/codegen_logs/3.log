0014: def main(input_grid):
0015:     """
0016:     Draw mirrored gray staircases of step length two from the teal anchor pixel.
0017: 
0018:     Input structure:
0019:     - The grid is black except for one teal pixel.
0020:     - The teal pixel is away from the border.
0021:     - The output keeps the input dimensions.
0022: 
0023:     Rule:
0024:     - From the teal pixel, draw gray steps upward then rightward with length two.
0025:     - Also draw gray steps downward then leftward with length two.
0026:     - Restore the teal pixel after drawing the staircases.
0027: 
0028:     Key insight:
0029:     - The single teal pixel is the shared center of two opposite staircase arms.
0030:     """
0031:     # Find the location of the teal pixel
0032:     teal_r, teal_c = np.argwhere(input_grid == Color.TEAL)[0]
0033: 
0034:     # staircase is gray
0035:     staircase_color = Color.GRAY
0036: 
0037:     # we are going to draw on top of the input
0038:     output_grid = input_grid.copy()
0039:     H, W = input_grid.shape
0040: 
0041:     # Draw stairs from the teal pixel
0042:     STAIR_LEN = 2
0043:     # Upper-right staircase: go up then right (step size 2).
0044:     r, c = teal_r, teal_c
0045:     while 0 <= r < H and 0 <= c < W:
0046:         # go up
0047:         draw_line(output_grid, r, c, length=STAIR_LEN, color=staircase_color, direction=(-1, 0))
0048:         r -= STAIR_LEN
0049:         # go right
0050:         draw_line(output_grid, r, c, length=STAIR_LEN, color=staircase_color, direction=(0, 1))
0051:         c += STAIR_LEN
0052:     
0053:     # Lower-left staircase: go down then left (step size 2).
0054:     r, c = teal_r, teal_c
0055:     while 0 <= r < H and 0 <= c < W:
0056:         # go down
0057:         draw_line(output_grid, r, c, length=STAIR_LEN, color=staircase_color, direction=(1, 0))
0058:         r += STAIR_LEN
0059:         # go left
0060:         draw_line(output_grid, r, c, length=STAIR_LEN, color=staircase_color, direction=(0, -1))
0061:         c -= STAIR_LEN
0062:     
0063:     # make sure that the teal pixel stays there
0064:     output_grid[teal_r, teal_c] = Color.TEAL
0065: 
0066:     return output_grid
0067: 
