+
+    inp = base.copy()
+    sr, sc = start
+    dr, dc = dest
+    inp[sr : sr + BLOCK_SIZE, sc : sc + BLOCK_SIZE] = MOVER
+    inp[dr : dr + BLOCK_SIZE, dc : dc + BLOCK_SIZE] = DEST
