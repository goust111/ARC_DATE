+    return max(
+        dist,
+        key=lambda pos: (
+            int(dist[pos]),
+            -abs(int(pos[0]) - int(dest[0])) - abs(int(pos[1]) - int(dest[1])),
+            -int(pos[0]),
+            -int(pos[1]),
