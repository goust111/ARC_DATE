+def _slide_bfs(feasible: np.ndarray, start: tuple[int, int]) -> dict[tuple[int, int], int]:
+    dist = {tuple(map(int, start)): 0}
+    queue = deque([tuple(map(int, start))])
+    while queue:
+        cur = queue.popleft()
+        for nxt in _slide_neighbors(feasible, cur):
+            if nxt not in dist:
+                dist[nxt] = int(dist[cur] + 1)
+                queue.append(nxt)
+    return dist
