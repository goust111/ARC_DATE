0092: RUN_LENGTH_MIN, RUN_LENGTH_MAX = 1, 3
0093: COLUMN_COLOR_DISTINCT_MIN, COLUMN_COLOR_DISTINCT_MAX = 3, 5
0094: UNUSED_COLOR_BIAS = 0.7
