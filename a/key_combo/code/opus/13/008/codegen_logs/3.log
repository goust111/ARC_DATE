+
+def _build_wall_grid(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    anchor = _find_unique_pixel(out, ANCHOR)
+    for dr, dc in DIAG_DIRS:
+        _paint_arm(out, anchor, dr, dc)
+    out[anchor] = ANCHOR
