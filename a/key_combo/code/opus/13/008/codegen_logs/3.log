+        "feasible": feasible,
+        "open_mask": open_mask,
+        "f_labels": f_labels,
+        "f_comps": f_comps,
+        "o_labels": o_labels,
+        "states": states,
+        "neighbors": neighbors,
+        "degree": degree,
+    }
