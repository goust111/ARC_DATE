+BG = 0
+MOVER = 3
+WALL = 5
+DEST = 7
+ANCHOR = 8
+BLOCK_SIZE = 2
+
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 600
