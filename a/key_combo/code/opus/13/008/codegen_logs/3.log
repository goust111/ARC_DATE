0042: def main(grid: np.ndarray) -> np.ndarray:
0043:     """
0044:     Fill each enclosed outline with the majority marker color inside it, while removing stray marker pixels.
0045: 
0046:     Input structure
0047:     - The background is the dominant color.
0048:     - Foreground consists of 4-connected monochrome outline objects and isolated one-pixel marker/control pixels.
0049:     - Some outline objects enclose interior regions; open outlines have no enclosed region.
0050: 
0051:     Rule
0052:     - Keep every multi-pixel outline object.
0053:     - Remove all isolated marker pixels from the canvas.
0054:     - For each enclosed interior region, fill all of its cells with the unique most frequent marker color found inside it.
0055: 
0056:     Key insight
0057:     - The target to fill is the set of cells unreachable from the outline bbox boundary without crossing that outline.
0058:     """
0059:     g = np.asarray(grid, dtype=int)
0060:     assert g.ndim == 2, "expected a 2D grid"
0061: 
0062:     bg = get_bg(g)
0063:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict")
0064:     assert components, "expected foreground components"
0065: 
0066:     out = np.full_like(g, bg)
0067:     marker_mask = np.zeros(g.shape, dtype=bool)
0068:     outlines: list[dict] = []
0069: 
0070:     for comp in components:
0071:         coords = comp["coords"]
0072:         if comp["area"] == 1:
0073:             marker_mask[coords[0, 0], coords[0, 1]] = True
0074:         else:
0075:             outlines.append(comp)
0076:             out[coords[:, 0], coords[:, 1]] = int(comp["color"])
0077: 
0078:     assert outlines, "expected at least one outline object"
0079: 
0080:     filled_regions = 0
0081:     for outline in outlines:
0082:         for region_coords in _enclosed_region_coords(outline["coords"], outline["bbox"]):
0083:             rr, cc = region_coords[:, 0], region_coords[:, 1]
0084:             inside_markers = marker_mask[rr, cc]
0085:             marker_values = g[rr[inside_markers], cc[inside_markers]]
0086:             assert marker_values.size > 0, "expected enclosed region to contain marker pixels"
0087: 
0088:             counts = Counter(map(int, marker_values))
0089:             ranked = counts.most_common()
0090:             assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique majority marker color"
0091: 
0092:             out[rr, cc] = int(ranked[0][0])
0093:             filled_regions += 1
0094: 
0095:     assert filled_regions > 0, "expected at least one enclosed region to fill"
0096:     return out
