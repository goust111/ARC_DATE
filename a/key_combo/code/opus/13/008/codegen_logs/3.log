+        if len(dist) < 8 or max(dist.values(), default=0) < 2:
+            continue
+        start_corner, _ = _corner_profile(start, feasible.shape)
+        candidates = [
+            state
+            for state, d in dist.items()
+            if state != start and d >= 2 and _corner_profile(state, feasible.shape)[0] != start_corner
