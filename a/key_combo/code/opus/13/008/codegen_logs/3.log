+            if not bool(mask[r, c]) or int(labels[r, c]) != -1:
+                continue
+            label = len(comps)
+            queue = deque([(int(r), int(c))])
+            labels[r, c] = label
+            comp: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                comp.append((int(rr), int(cc)))
+                for dr, dc in DIR4:
+                    nr = int(rr + dr)
+                    nc = int(cc + dc)
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and int(labels[nr, nc]) == -1:
