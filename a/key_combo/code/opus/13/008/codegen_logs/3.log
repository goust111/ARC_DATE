0101: def _valid_run_lengths(width: int, n_runs: int) -> list[tuple[int, ...]]:
0102:     length_range = range(RUN_LENGTH_MIN, RUN_LENGTH_MAX + 1)
0103:     return [
0104:         tuple(int(x) for x in lengths)
0105:         for lengths in product(length_range, repeat=int(n_runs))
0106:         if sum(lengths) == int(width)
0107:     ]
0108: 
0109: 
0110: def _run_colors(colors: list[int], n_runs: int) -> list[int]:
0111:     seq: list[int] = []
0112:     unused = set(colors)
0113:     for i in range(int(n_runs)):
0114:         slots_left = int(n_runs) - i
0115:         choices = [c for c in colors if not seq or c != seq[-1]]
0116:         if len(unused) >= slots_left:
0117:             choices = [c for c in choices if c in unused]
0118:         elif unused and random.random() < UNUSED_COLOR_BIAS:
0119:             preferred = [c for c in choices if c in unused]
0120:             if preferred:
0121:                 choices = preferred
0122:         color = random.choice(choices)
0123:         seq.append(int(color))
0124:         unused.discard(int(color))
0125:     return seq
0126: 
0127: 
0128: def _palette_row(width: int, colors: list[int]) -> np.ndarray:
0129:     valid_counts = [
0130:         n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)
0131:     ]
0132:     n_runs = random.choice(valid_counts)
0133:     valid_lengths = _valid_run_lengths(int(width), n_runs)
0134:     lengths = random.choice(valid_lengths)
0135:     n_distinct = random.randint(
0136:         COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)
0137:     )
0138:     chosen = random.sample(colors, n_distinct)
0139:     seq = _run_colors(chosen, n_runs)
0140:     return np.repeat(seq, lengths).astype(int)
