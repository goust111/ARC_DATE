+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+WALL = 5
+GATE = 6
+MAROON = 9
+TOKEN_COLORS = (BLUE, RED, GREEN, YELLOW)
