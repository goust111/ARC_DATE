+
+def _extract_glyph(grid: np.ndarray, gate: dict) -> np.ndarray:
+    r = int(gate["row"])
+    c1 = int(gate["c1"])
+    h, w = grid.shape
+    assert r >= 1, "glyph needs one row above the gate row"
+    for c in range(c1 + 1, min(w - 1, c1 + 8)):
+        block = grid[r - 1 : r + 1, c : c + 2]
+        if block.shape != (2, 2):
