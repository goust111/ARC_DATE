+GLYPH_PRIORITY = {
+    ((1, 0), (0, 0)): 1,
+    ((1, 1), (0, 0)): 2,
+    ((1, 0), (1, 1)): 3,
+}
+
+
+def _neighbors_for_fall(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r + 1, c), (r, c - 1), (r, c + 1))
