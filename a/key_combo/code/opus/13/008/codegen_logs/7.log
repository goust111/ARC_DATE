    area: 3-6 pixels, 8-connected, density 0.67-0.75
    count: 3-6 (equal to area)
  layout:
    pattern: sprites arranged on an NxN grid (N = sprite bbox side) where occupied cells exactly match the normalized sprite shape
    separation: 1 cell gap between adjacent sprite bboxes in both row and column directions
  legend:
    pixel_count: equals sprite count (one pixel per sprite)
    occupancy: same NxN pattern as the sprite shape / layout
    spacing: 1 cell between consecutive legend rows and columns
    colors: 2-4 distinct non-bg non-source colors; repeats allowed
    placement: does not overlap any sprite; anywhere on grid with room
  transform:
    each sprite is recolored to the legend color at the matching (row-rank, col-rank) position
    legend and background unchanged

generation_strategy:
