        return min(abs(coverage - COVERAGE_MIN), abs(coverage - COVERAGE_MAX))

    best_distance = min(coverage_distance(sizes) for sizes in tuples)
    closest = [sizes for sizes in tuples if coverage_distance(sizes) == best_distance]
