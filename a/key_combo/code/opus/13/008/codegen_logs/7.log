+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+SHAPE = 1
+SEP = 2
+LEGEND_COLORS = (3, 4, 6, 7)
+
+GEN_ATTEMPTS = 400
+SLOT_SIZE = 5
+PANEL_MARGIN = 1
+SLOT_GAP = 1
