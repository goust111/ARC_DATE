  "summary": "Complete each framed motif by reflecting it to the opposite side of its rectangular frame.",
  "type": "symmetry/pattern",
  "src": "motif-color pixels inside each large frame-color object bbox",
  "transform": "for each frame bbox, mirror the motif pixels left-to-right when the bbox is wider than tall, and top-to-bottom when it is taller than wide; preserve all existing pixels"
}
</annotation>
<generation_spec>
