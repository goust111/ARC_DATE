+    assert box is not None, "expected a maroon scaled pattern"
+    r0, c0, r1, c1 = box
+    crop = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert crop.shape[0] == crop.shape[1], "scaled pattern bbox must be square"
+
