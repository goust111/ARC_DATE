+
+def _marker_side(r: int, c: int, frame_box: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = frame_box
+    if r == r0:
+        return "top"
+    if c == c1:
+        return "right"
+    if r == r1:
