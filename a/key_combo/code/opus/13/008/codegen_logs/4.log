+    frame_box, center_r, center_c, _radius = _diamond_frame(g)
+    mask, scale = _scaled_mask(g)
+    n = int(mask.shape[0])
+    square_side = int(n * scale)
+    square_r0, square_c0 = _square_origin(center_r, center_c, square_side)
