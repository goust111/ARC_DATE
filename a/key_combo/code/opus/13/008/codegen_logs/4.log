+
+def _paint_vertical(
+    out: np.ndarray,
+    base: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    column: int,
+    band: int,
+    scale: int,
+    square_r0: int,
+    square_c0: int,
+    reverse: bool,
+) -> None:
+    n = int(mask.shape[0])
+    rows = range(n - 1, -1, -1) if reverse else range(n)
+    for i in rows:
+        if not mask[i, band]:
+            break
+        rr0 = square_r0 + i * scale
+        rr1 = rr0 + scale
+        col = square_c0 + band * scale + scale // 2
+        assert col == column
+        paintable = base[rr0:rr1, col] == BG
+        out[rr0:rr1, col][paintable] = int(color)
+
+
+def _paint_horizontal(
+    out: np.ndarray,
+    base: np.ndarray,
+    mask: np.ndarray,
+    color: int,
+    row: int,
+    band: int,
+    scale: int,
+    square_r0: int,
+    square_c0: int,
+    reverse: bool,
+) -> None:
+    n = int(mask.shape[0])
+    cols = range(n - 1, -1, -1) if reverse else range(n)
+    for j in cols:
+        if not mask[band, j]:
+            break
+        cc0 = square_c0 + j * scale
+        cc1 = cc0 + scale
+        rr = square_r0 + band * scale + scale // 2
+        assert rr == row
+        paintable = base[rr, cc0:cc1] == BG
+        out[rr, cc0:cc1][paintable] = int(color)
