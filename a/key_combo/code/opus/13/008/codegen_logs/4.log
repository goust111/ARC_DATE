+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+FRAME = 2
+PATTERN = 9
+MARKER_COLORS = (1, 3, 4, 7)
+SIDE_ORDER = ("top", "right", "bottom", "left")
+CASE_OPTIONS = ((4, 2), (3, 3))  # (mask_size, scale)
+MAX_GENERATION_ATTEMPTS = 400
+MASK_ATTEMPTS = 800
+INNER_STRUCTURE_ATTEMPTS = 80
