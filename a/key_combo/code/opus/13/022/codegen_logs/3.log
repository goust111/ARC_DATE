+def _find_corner_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    counts = Counter(map(int, g.ravel()))
+    tile_colors = {color for color, _ in counts.most_common(2)}
