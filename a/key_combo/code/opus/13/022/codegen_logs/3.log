    while len(blob) < size:
        if not frontier:
            return None
        cell = random.choice(tuple(frontier))
        frontier.remove(cell)
        blob.add(cell)
        blocked = occupied | blob
        for nbr in _gen_neighbors4(cell[0], cell[1], h, w):
