  "path": "from each rectangle's corner, move inward away from the touched row and column borders by one rectangle height/width",
  "trajectory": "translate each selected rectangle once; same-color overlaps merge",
  "transform": "clear selected rectangles at their original positions; leave singleton-color rectangles unchanged"
}
</annotation>
<generation_spec>
