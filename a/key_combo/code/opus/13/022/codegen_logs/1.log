+    for comp, adjacent in zip(neutral_comps, neutral_touches):
+        assert len(adjacent) == 1
+        obj_idx = next(iter(adjacent))
+        touched_objects.add(obj_idx)
+        color = obj_colors[obj_idx]
+        for r, c in comp:
