+    cc0 = max(0, c0 - pad)
+    rr1 = min(shape[0] - 1, r1 + pad)
+    cc1 = min(shape[1] - 1, c1 + pad)
+    return rr0 <= r <= rr1 and cc0 <= c <= cc1
+
