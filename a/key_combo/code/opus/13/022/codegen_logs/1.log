+    return _trim_mask(mask)
+
+
+def _tab_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    candidates: list[tuple[int, int]] = []
+    padded = np.pad(mask, 1)
