+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and labels[nr, nc] >= 0:
+                    adjacent.add(int(labels[nr, nc]))
+        touches.append(adjacent)
+    return object_comps, neutral_comps, labels, tab_counts, touches
