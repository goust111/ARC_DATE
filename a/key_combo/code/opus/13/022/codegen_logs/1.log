+        return trimmed
+    return None
+
+
+def _analysis(grid: np.ndarray):
+    object_comps = _components(grid == GREY)
+    neutral_comps = _components(grid == ORANGE)
+    labels = np.full(grid.shape, -1, dtype=int)
