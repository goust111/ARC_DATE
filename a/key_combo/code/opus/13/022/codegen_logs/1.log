+    if obj_h > sector_h - 2 or obj_w > sector_w - 2:
+        return False
+    top = random.randint(1, sector_h - obj_h - 1)
+    left = random.randint(1, sector_w - obj_w - 1)
+
+    object_cells_local = {
+        (top + r, left + c)
+        for r in range(obj_h)
+        for c in range(obj_w)
+        if obj_mask[r, c]
