+def _count_fg_neighbors(mask: np.ndarray, r: int, c: int) -> int:
+    total = 0
+    for dr, dc in DIRS4:
+        rr, cc = r + dr, c + dc
+        if _in_bounds(mask.shape, rr, cc) and bool(mask[rr, cc]):
+            total += 1
+    return total
