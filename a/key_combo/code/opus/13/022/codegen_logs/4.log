+    if found_side != side:
+        return False
+    return True
+
+
+def _is_valid_input(mask: np.ndarray, side: str, notch_count: int, shape: tuple[int, int]) -> bool:
+    if min(shape) < 1 or max(shape) > 30:
+        return False
+    if not (0.40 <= mask.mean() <= 0.60):
