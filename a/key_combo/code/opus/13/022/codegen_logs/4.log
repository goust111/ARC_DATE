+def _component_count(mask: np.ndarray) -> int:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return 0
+    seen: set[tuple[int, int]] = set()
+    parts = 0
+    for r, c in map(tuple, coords):
+        if (r, c) in seen:
+            continue
+        parts += 1
+        stack = [(r, c)]
+        seen.add((r, c))
+        while stack:
+            rr, cc = stack.pop()
+            for dr, dc in DIRS4:
+                nr, nc = rr + dr, cc + dc
+                if _in_bounds(mask.shape, nr, nc) and bool(mask[nr, nc]) and (nr, nc) not in seen:
