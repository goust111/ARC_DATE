    parts = 0
    for r, c in map(tuple, coords):
        if (r, c) in seen:
            continue
        parts += 1
        stack = [(r, c)]
        seen.add((r, c))
        while stack:
            rr, cc = stack.pop()
            for dr, dc in DIRS4:
