+        if side == "right" and c != c1:
+            continue
+        if side == "up" and r != r0:
+            continue
+        if side == "down" and r != r1:
+            continue
+        if (side in {"left", "right"} and r in (r0, r1)) or (side in {"up", "down"} and c in (c0, c1)):
+            continue
+        if _count_fg_neighbors(mask, r, c) == 3:
+            candidates.append((r, c))
+    random.shuffle(candidates)
+    return candidates
+
