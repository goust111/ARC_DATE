+    assert len(slots) == 9, "expected a 3x3 table of enclosed slot regions"
+    row_starts = sorted({box[0] for box in slots})
+    col_starts = sorted({box[1] for box in slots})
+    assert len(row_starts) == 3 and len(col_starts) == 3
+
