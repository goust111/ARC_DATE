            scale, source_rel, marker_rel, h, w, occupied, marker_boxes
        )
        if inst is None:
            return None
        instances.append(inst)
        occupied |= inst["cells"]
        marker_boxes.extend(inst["marker_boxes"])
    return instances, occupied, marker_boxes


