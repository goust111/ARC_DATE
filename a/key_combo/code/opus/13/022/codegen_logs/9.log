    for r, c in cells:
        deg = _gen_degree(cells, r, c, width)
        if deg == 1 and c == 0:
            left_endpoints.append(r)
        if deg == 1 and c == width - 1:
            right_endpoints.append(r)
    return len(left_endpoints) == 1 and len(right_endpoints) == 1


