+    inp = np.vstack([panels[0], separator, panels[1], separator, panels[2]])
+    expected = _expand_summary(predicted)
+
+    try:
+        actual = main(inp)
+    except AssertionError:
+        return None
+    if not np.array_equal(actual, expected):
+        return None
+    return inp, expected
+
