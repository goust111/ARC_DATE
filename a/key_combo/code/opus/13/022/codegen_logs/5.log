+    out = np.zeros((PANEL_SIZE, PANEL_SIZE), dtype=int)
+    for r in range(SUMMARY_SIZE):
+        for c in range(SUMMARY_SIZE):
+            out[r * BLOCK_SIZE + 1, c * BLOCK_SIZE + 1] = int(summary[r, c])
+    return out
