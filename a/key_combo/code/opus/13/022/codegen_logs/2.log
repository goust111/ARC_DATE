+        candidate_positions = []
+        for dr, dc in candidate_offsets(markers[anchor], markers[new], color):
+            pos = (placements[anchor][0] + dr, placements[anchor][1] + dc)
+            if not overlaps(sprites[new], pos, occupied, bg=bg):
+                candidate_positions.append(pos)
