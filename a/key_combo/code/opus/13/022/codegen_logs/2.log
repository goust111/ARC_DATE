+def paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int | None = None) -> None:
+    h, w = patch.shape
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+        return
+    mask = patch != int(transparent)
+    view[mask] = patch[mask]
