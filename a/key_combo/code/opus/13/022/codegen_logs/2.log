+    connector_cells_flat = {cell for _color, axis in connectors for cell in connector_cells((h, w), axis)}
+
+    blue_candidates = []
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in connector_cells_flat:
+                continue
+            if sprite[r, c] != BODY:
