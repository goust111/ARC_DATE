+            if not overlaps(sprites[new], pos, occupied, bg=bg):
+                candidate_positions.append(pos)
+        assert candidate_positions, f"no non-overlapping placement for color {color}"
+        placements[new] = min(candidate_positions)
+        occupied |= sprite_cells(sprites[new], placements[new], bg=bg)
