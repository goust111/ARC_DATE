+    sides = []
+    if r == 0:
+        sides.append("T")
+    if r == h - 1:
+        sides.append("B")
+    if c == 0:
+        sides.append("L")
+    if c == w - 1:
+        sides.append("R")
+    assert len(sides) == 1, "connectors must lie on a single exposed side"
