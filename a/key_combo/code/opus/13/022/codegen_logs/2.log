+    h, w = sprite.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(sprite[r, c])
+            if color in (BG, body):
+                continue
+            side = boundary_side((h, w), r, c)
+            out[color].append((r, c, DIRS[side]))
+    return dict(out)
