+def connector_cells(shape: tuple[int, int], axis: str) -> list[tuple[int, int]]:
+    h, w = shape
+    if axis == "H":
+        return [(h // 2, 0), (h // 2, w - 1)]
+    assert axis == "V"
+    return [(0, w // 2), (h - 1, w // 2)]
+
