+
+def boundary_side(shape: tuple[int, int], r: int, c: int) -> str:
+    h, w = shape
+    sides = []
+    if r == 0:
+        sides.append("T")
+    if r == h - 1:
+        sides.append("B")
+    if c == 0:
+        sides.append("L")
+    if c == w - 1:
+        sides.append("R")
