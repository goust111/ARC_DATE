        sprites.append({"bbox": (r0, c0, r1, c1), "crop": crop})

    by_row = sorted(sprites, key=lambda s: (s["bbox"][0], s["bbox"][1]))
    assert by_row[1]["bbox"][0] < by_row[2]["bbox"][0]

    ordered_rows = []
    for row in (by_row[:2], by_row[2:]):
