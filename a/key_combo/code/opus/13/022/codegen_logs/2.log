+            blue_candidates.append((r, c))
+    _RNG.shuffle(blue_candidates)
+
+    for r, c in blue_candidates:
+        if len(missing) >= target_missing:
+            break
+        orbit = set(orbit_of((h, w), r, c))
+        if sum((cell in missing) for cell in orbit) >= len(orbit) - 1:
