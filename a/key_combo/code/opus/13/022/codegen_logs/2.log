+    connector_specs = [[] for _ in range(object_count)]
+    for edge_idx, color in enumerate(colors):
+        axis = axes[edge_idx]
+        connector_specs[edge_idx].append((color, axis))
+        connector_specs[edge_idx + 1].append((color, axis))
