+def dominant_body_color(grid: np.ndarray, bg: int) -> int:
+    fg = np.asarray(grid, dtype=int)
+    vals = fg[fg != bg]
+    counts = Counter(map(int, vals))
+    return counts.most_common(1)[0][0]
+
