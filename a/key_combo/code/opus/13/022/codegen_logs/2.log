+    h, w = out.shape
+    progress = True
+    while progress and np.any(out == BG):
+        progress = False
+        zeros = np.argwhere(out == BG)
+        for rr, cc in zeros:
+            r = int(rr)
+            c = int(cc)
+            orbit = {
+                (r, c),
+                (h - 1 - r, c),
+                (r, w - 1 - c),
+                (h - 1 - r, w - 1 - c),
+            }
+            vals = {int(out[orow, ocol]) for orow, ocol in orbit if out[orow, ocol] != BG}
+            if len(vals) == 1:
+                value = vals.pop()
+                for orow, ocol in orbit:
+                    if out[orow, ocol] == BG:
+                        out[orow, ocol] = value
+                        progress = True
