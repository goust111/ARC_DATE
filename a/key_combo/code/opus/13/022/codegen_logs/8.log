+        if not np.any(np.all(coords == start, axis=1)):
+            start = _nearest_region_cell(coords, centroid_r, centroid_c)
+        direction = {
+            TOP: (-1, 0),
+            BOTTOM: (1, 0),
+            LEFT: (0, -1),
+            RIGHT: (0, 1),
+        }[fill_color]
+        records.append(
