  "transform": "collapse each slot to one output pixel in row/column order: use the contained object color if present, otherwise use the background color",
  "grid_shape": "number of slot rows x number of slot columns"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 13-19 rows x 13-19 cols
  colors:
    bg: most-common color; fills outer border and slot interiors
    frame: second-most-common color; forms rectangular table grid lines; does not touch grid edge
    objects: 1-6 distinct colors, each != bg and != frame; may repeat across slots
  structure: |
    Outer bg border (1-2 cells) surrounds a frame-color rectangular region.
    Inside the frame: a R x C array of bg-colored rectangular slots separated by
    frame-color grid lines (separator thickness 1-2). Frame inner padding 1-2.
    Slots in the same row share height; same column share width.
  table:
    dimensions: 2x2 to 3x3 (R=2-3 rows, C=2-3 cols)
    slot_height: 3-6 per row
    slot_width: 3-4 per column
  objects_in_slots:
    count: 1 to R*C-1 slots filled, rest empty [observed >=1 empty]
    shape: solid axis-aligned rectangle (1x1 to 3x2 bbox, 1-6 pixels)
    placement: margins >= 1 on all sides from slot boundary (never touches edge)
    color: one unique non-bg non-frame color per object; same color may appear in multiple slots
  transform: each slot maps to one output pixel; filled slot -> object color, empty -> bg
  output: R x C grid

generation_strategy:
  approach: output-first
  steps:
    - Pick table dims R (2-3), C (2-3) and choose bg, frame, and object palette
    - Build output grid (R x C): randomly assign object colors to some slots, bg to rest (keep >=1 filled)
    - Choose per-row heights (3-6) and per-col widths (3-4) for slots
    - Choose separator thicknesses (1-2) between adjacent rows/cols
    - Choose frame inner padding (1-2) on each side
    - Assemble the frame region: frame-color grid with bg-colored slot rectangles at computed positions
    - For each filled slot, place a random solid rectangle of the assigned color inside with >=1 margin
    - Surround the frame region with an outer bg border (1-2 cells on each side)
