+    parts = walls + 1
+    min_inner_w = parts * 3 + walls
+    inner_h = _sample_odd(rng, 5, 9)
+    inner_w = _sample_odd(rng, min_inner_w, min(min_inner_w + 6, 19))
+    vertical_sizes = _sample_partition(inner_w - walls, parts, rng, min_size=3)
