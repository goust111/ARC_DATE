+    best = None
+    best_key = None
+    for r, c in coords:
+        key = (
+            abs(float(r) - centroid_r) + abs(float(c) - centroid_c),
+            abs(float(r) - centroid_r),
+            abs(float(c) - centroid_c),
+            int(r),
+            int(c),
+        )
