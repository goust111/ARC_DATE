+    top_rows = np.where(np.any(grid == TOP, axis=1))[0]
+    bottom_rows = np.where(np.any(grid == BOTTOM, axis=1))[0]
+    left_cols = np.where(np.any(grid == LEFT, axis=0))[0]
+    right_cols = np.where(np.any(grid == RIGHT, axis=0))[0]
