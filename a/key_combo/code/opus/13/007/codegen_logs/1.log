+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+BG = 0
+SPRITE_SIZE = 3
+GRID_RANGE = (18, 25)
+SPRITE_COUNT_CHOICES = (2, 3)
+COPY_COUNT_CHOICES = (2, 2, 3, 3, 4)
