+
+def _direction_to_target(
+    sprite_bbox: tuple[int, int, int, int], target: tuple[int, int]
+) -> tuple[int, int]:
+    r0, c0, r1, c1 = sprite_bbox
+    tr, tc = target
+    directions: list[tuple[int, int]] = []
