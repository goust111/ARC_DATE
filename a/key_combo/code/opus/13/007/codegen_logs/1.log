+    border = patch.copy()
+    center = int(border[1, 1])
+    border[1, 1] = -1
+    vals = {int(v) for v in border.flatten() if int(v) != -1}
+    return len(vals) == 1 and BG not in vals and center != BG and center != next(iter(vals))
+
+
