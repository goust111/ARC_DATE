+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_gap = max(0, br0 - ar1 - 1, ar0 - br1 - 1)
+    col_gap = max(0, bc0 - ac1 - 1, ac0 - bc1 - 1)
+    return int(row_gap + col_gap)
+
+
+def _sprite_patch(body: int, center: int) -> np.ndarray:
+    patch = np.full((3, 3), int(body), dtype=int)
+    patch[1, 1] = int(center)
+    return patch
