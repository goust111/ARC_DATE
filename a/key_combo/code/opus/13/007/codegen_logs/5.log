_GEN_LOSER_COUNT_BOUNDS = (4, 7)
_GEN_WINNER_MIN_COUNT, _GEN_WINNER_MAX_COUNT = 5, 9


def _gen_mask_with_count(count: int) -> np.ndarray:
    mask = np.zeros((_GEN_TILE_SIZE, _GEN_TILE_SIZE), dtype=bool)
