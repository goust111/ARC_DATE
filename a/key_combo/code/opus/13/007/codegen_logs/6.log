+    gap_start = shape_c0 + min(np.flatnonzero(shape_mask.any(axis=0) == False), default=shape_w)
+    gap_cols = [c for c in range(shape_c0, shape_c0 + shape_w) if not shape_mask[:, c - shape_c0].all() and np.any(~shape_mask[:, c - shape_c0])]
+    inner_left = shape_c0 + np.max(np.flatnonzero(shape_mask[0 if open_down else shape_h - 1] == RED))
+    inner_right = shape_c0 + np.min(np.flatnonzero(shape_mask[0 if open_down else shape_h - 1] == RED))
+    del gap_start, gap_cols, inner_left, inner_right
