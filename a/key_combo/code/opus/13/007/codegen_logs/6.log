+    out = grid.copy()
+    wall_mask = (out == RED) | (out == ORANGE)
+    for r in range(out.shape[0]):
+        wall_cols = np.flatnonzero(wall_mask[r])
+        if wall_cols.size == 0:
+            continue
+        left = wall_cols[wall_cols < marker_col]
+        right = wall_cols[wall_cols >= marker_col]
