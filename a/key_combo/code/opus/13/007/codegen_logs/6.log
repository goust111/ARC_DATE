def _block_color(g: np.ndarray, bg: int) -> int:
    candidates: list[int] = []
    for color in colors_present(g, exclude={bg}):
        comps = find_components(
            g,
            bg=bg,
            connectivity=4,
            monochromatic=True,
            colors=[color],
            return_format="dict",
        )
        if comps and all(
            int(comp["area"]) == 4
            and bbox_h(comp["bbox"]) == 2
            and bbox_w(comp["bbox"]) == 2
            for comp in comps
