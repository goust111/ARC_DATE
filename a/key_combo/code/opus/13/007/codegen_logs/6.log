+    holes: list[np.ndarray] = []
+    for coords in _components(local_black):
+        if (
+            np.any(coords[:, 0] == 0)
+            or np.any(coords[:, 0] == r1 - r0)
+            or np.any(coords[:, 1] == 0)
+            or np.any(coords[:, 1] == c1 - c0)
