+    try:
+        solved = main(grid)
+    except AssertionError:
+        return None
+    if not np.count_nonzero(solved == ORANGE):
+        return None
+    if not np.count_nonzero(solved == YELLOW):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _build_input()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

