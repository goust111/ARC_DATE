+    for _ in range(random.randint(1, 4)):
+        candidates = []
+        h, w = cur.shape
+        for r in range(h):
+            for c in range(w):
+                trial = cur.copy()
+                trial[r, c] = not trial[r, c]
+                if not np.any(trial):
+                    continue
