+    options = [
+        [0, 1, 2],
+        [0, 1, 3],
+        [0, 2, 3],
+        [1, 2, 3],
+    ]
+    return random.choice(options).copy()
+
+
+def _place_input_objects(objects: list[dict]) -> np.ndarray | None:
+    for _ in range(120):
