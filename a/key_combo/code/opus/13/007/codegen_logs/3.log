+
+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr, dc in NEIGHBORS4:
+        yield r + dr, c + dc
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[int(r0) : int(r1) + 1, int(c0) : int(c1) + 1].copy()
+
+
+def _component_masks(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    deltas = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in deltas:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comp = np.zeros((h, w), dtype=bool)
+            rr, cc = zip(*coords)
+            comp[np.array(rr), np.array(cc)] = True
+            out.append(comp)
+    return out
+
+
+def _hole_masks(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    bg = ~mask
+    reachable = np.zeros((h, w), dtype=bool)
+    stack = []
+    for r in range(h):
+        for c in (0, w - 1):
+            if bg[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if bg[r, c] and not reachable[r, c]:
+                reachable[r, c] = True
+                stack.append((r, c))
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not reachable[nr, nc]:
+                reachable[nr, nc] = True
+                stack.append((nr, nc))
+    return _component_masks(bg & ~reachable, connectivity=4)
+
