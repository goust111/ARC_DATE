+    return out
+
+
+def _mask_area(mask: np.ndarray) -> int:
+    return int(np.count_nonzero(mask))
+
+
+def _is_single_component(mask: np.ndarray) -> bool:
+    return len(_component_masks(mask, connectivity=4)) == 1
