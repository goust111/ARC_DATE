{
  "type": "transform_in_place",
  "src": "single-color foreground objects on a background; some objects enclose background holes",
  "transform": "draw a one-cell 8-neighborhood green outline on exterior background pixels around the foreground; recolor enclosed background holes to yellow; preserve foreground pixels"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 15x15 [observed]
  colors:
    background: any color except green(3) or yellow(4); 8 (azure) [observed]
    foreground: exactly 1 color, not green(3) or yellow(4); 6 (magenta) [observed]
  objects:
    count: 3 [observed]
    type: axis-aligned rectangles with an optional rectangular hole punched inside
    bbox_dims: 2-7 per side; each object >=2x2
    hole: 0 or more objects have a rectangular hole; at least 1 object must have a hole
    hole_shape: rectangular, fully enclosed by 1-cell-thick fg border on all sides
    hole_position: anywhere inside the object (not necessarily centered or filling entire interior)
    connectivity: 4-connected per object; objects are 4-connected components
    separation: pairwise Chebyshev distance >= 3 between objects
    margin: every fg pixel >= 1 cell from grid border (no fg on row/col 0 or 14)
  transform:
    preserve: all foreground pixels unchanged
    green_outline: exterior bg pixels that 8-neighbor any fg pixel become green(3)
    yellow_fill: enclosed bg holes (unreachable from grid border via 4-connected bg) become yellow(4)

generation_strategy:
  approach: direct construction (constraints are easy to satisfy)
  steps:
    1. Create 15x15 grid filled with background color (pick from non-green, non-yellow)
    2. Pick 1 foreground color (not bg, not green, not yellow)
    3. Place 3 non-overlapping rectangles with >=1 margin from grid border and pairwise Chebyshev distance >=3
    4. For 1-3 of them, punch a rectangular hole (>=1x1) fully inside the border ring; ensure at least 1 object has a hole (bbox must be >=3 on both dims if holed)
    5. Derive output by flood-filling exterior bg from border, marking enclosed bg as yellow, marking exterior bg 8-adjacent to fg as green
