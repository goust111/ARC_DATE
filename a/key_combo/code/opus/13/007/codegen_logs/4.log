 173: def _gen_composite(side: str, cross: np.ndarray) -> np.ndarray:
 174:     marker = _gen_marker_block(side)
 175:     if side == "left":
 176:         return np.concatenate([marker, cross], axis=1)
 177:     if side == "right":
 178:         return np.concatenate([cross, marker], axis=1)
 179:     if side == "top":
 180:         return np.concatenate([marker, cross], axis=0)
 181:     return np.concatenate([cross, marker], axis=0)
