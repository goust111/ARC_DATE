 120:                 continue
 121:             if h == 1 and area != w:
 122:                 continue
 123:             if w == 1 and area != h:
 124:                 continue
 125:             if h > 1 and w > 1 and area < max(h, w):
 126:                 continue
 127:             dims.append((h, w))
 128:     return dims
