 197: def _gen_can_place(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, padding: int) -> bool:
 198:     h, w = patch.shape
 199:     H, W = canvas.shape
 200:     if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
 201:         return False
 202:     for dr, dc in np.argwhere(patch != _GEN_BG):
 203:         r = int(r0 + dr)
 204:         c = int(c0 + dc)
 205:         r1 = max(0, r - padding)
 206:         r2 = min(H, r + padding + 1)
 207:         c1 = max(0, c - padding)
 208:         c2 = min(W, c + padding + 1)
 209:         if np.any(canvas[r1:r2, c1:c2] != _GEN_BG):
 210:             return False
 211:     return True
