import random
from collections import deque
import numpy as np

N=5

def neigh4(r,c):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        nr,nc=r+dr,c+dc
        if 0<=nr<N and 0<=nc<N:
            yield nr,nc

def connected(cells):
    cells=set(cells)
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        r,c=q.popleft()
        for nr,nc in neigh4(r,c):
            if (nr,nc) in cells and (nr,nc) not in seen:
                seen.add((nr,nc)); q.append((nr,nc))
    return len(seen)==len(cells)

def transform(tile,r,c):
    out=tile
    if c%2==1: out=np.fliplr(out)
    if r%2==1: out=np.flipud(out)
    return out

def tile3(tile):
    parts=[]
    for r in range(3):
        row=[]
        for c in range(3):
            row.append(transform(tile,r,c))
        parts.append(np.concatenate(row,axis=1))
    return np.concatenate(parts,axis=0)

def close_info(tile):
    g=tile3(tile)
    H,W=g.shape
    bg=(g==0)
    ext=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in [0,W-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in [0,H-1]:
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and bg[nr,nc] and not ext[nr,nc]:
                ext[nr,nc]=1; q.append((nr,nc))
    holes=bg & ~ext
    return holes.sum(), holes

def rand_shape():
    k=random.randint(8,14)
    cells={(random.randrange(N), random.randrange(N))}
    while len(cells)<k:
        frontier=[]
        for r,c in list(cells):
            for nr,nc in neigh4(r,c):
                if (nr,nc) not in cells:
                    frontier.append((nr,nc))
        if not frontier: return None
        cells.add(random.choice(frontier))
    if not connected(cells): return None
    if sum(r in (0,N-1) or c in (0,N-1) for r,c in cells) < 2: return None
    tile=np.zeros((N,N),int)
    for r,c in cells: tile[r,c]=2
    return tile

def edge_noise_candidates(tile):
    cand=[]
    for r in range(N):
        for c in range(N):
            if tile[r,c]"'!=0: continue
            if r not in (0,N-1) and c not in (0,N-1): continue
            ok=False
            for nr,nc in neigh4(r,c):
                if tile[nr,nc]==2: ok=True
            if ok: cand.append((r,c))
    return cand

found=[]
seen=set()
for _ in range(50000):
    tile=rand_shape()
    if tile is None: continue
    holes0,mask0=close_info(tile)
    if holes0<1: continue
    cand=edge_noise_candidates(tile)
    if not cand: continue
    random.shuffle(cand)
    good=None
    for cnt in [1,2]:
        if len(cand)<cnt: continue
        # sample some combos
        import itertools
        combos=list(itertools.combinations(cand,cnt))
        random.shuffle(combos)
        for comb in combos[:20]:
            noisy=tile.copy()
            for r,c in comb: noisy[r,c]=5
            holes1,mask1=close_info(np.where(noisy==5,5,noisy))
            # close_info treats nonzero as fg? currently only 0 bg works, yes any nonzero barrier.
            if holes1!=holes0 or not np.array_equal(mask1,mask0):
                good=comb,holes0,holes1
                break
        if good: break
    if not good: continue
    sig=tile.tobytes()+bytes(sum(good[0],()))
    key=tile.tobytes()
    if key in seen: continue
    seen.add(key)
    found.append((tile,good))
    if len(found)>=20: break

print('"'found',len(found))
for i,(tile,(comb,h0,h1)) in enumerate(found[:10],1):
    print('---',i,'h',h0,h1,'noise',comb)
    print(tile)
