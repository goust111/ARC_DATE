 185:         positions = [
 186:             (r, c)
 187:             for r in range(_GEN_LOOP_MARGIN, _GEN_H - h - _GEN_LOOP_MARGIN + 1)
 188:             for c in range(_GEN_LOOP_MARGIN, _GEN_W - w - _GEN_LOOP_MARGIN + 1)
