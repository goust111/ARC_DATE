  21: def _marker_color(g: np.ndarray, bg: int) -> int:
  22:     counts = Counter(int(v) for v in g[g != int(bg)])
  23:     assert counts, "expected foreground pixels"
  24:     max_count = max(counts.values())
  25:     candidates = [color for color, count in counts.items() if count == max_count]
  26:     assert len(candidates) == 1, "expected a unique repeated marker color"
  27:     marker = int(candidates[0])
  28:     assert counts[marker] % 4 == 0, "marker pixels should form 4-pixel sprites"
  29:     return marker
  30: 
  31: 
  32: def _block_kind(block: np.ndarray, bg: int, marker: int) -> str:
  33:     assert block.shape == (3, 3), "expected 3x3 half-block"
  34:     marker_mask = block == int(marker)
  35:     other_mask = (block != int(bg)) & ~marker_mask
  36: 
  37:     if int(marker_mask.sum()) == 4 and not bool(other_mask.any()):
  38:         return "marker"
  39: 
  40:     if not bool(marker_mask.any()) and int(other_mask.sum()) == 5:
  41:         assert np.array_equal(other_mask, _CROSS_MASK), "expected a 5-pixel cross"
  42:         return "cross"
  43: 
  44:     raise AssertionError("expected either a marker block or a colored cross block")
  45: 
