import random, itertools
from collections import deque
import numpy as np
N=5

def neigh4(r,c,H,W):
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        nr,nc=r+dr,c+dc
        if 0<=nr<H and 0<=nc<W:
            yield nr,nc

def neigh8(r,c,H,W):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==dc==0: continue
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W:
                yield nr,nc

def cc(mask):
    H,W=mask.shape
    seen=np.zeros_like(mask,bool); comps=[]
    for r in range(H):
        for c in range(W):
            if mask[r,c] and not seen[r,c]:
                q=deque([(r,c)]); seen[r,c]=1; cur=[]
                while q:
                    x,y=q.popleft(); cur.append((x,y))
                    for nx,ny in neigh4(x,y,H,W):
                        if mask[nx,ny] and not seen[nx,ny]: seen[nx,ny]=1; q.append((nx,ny))
                comps.append(cur)
    return comps

def tile3(tile):
    rows=[]
    for tr in range(3):
        row=[]
        for tc in range(3):
            part=tile
            if tc%2: part=np.fliplr(part)
            if tr%2: part=np.flipud(part)
            row.append(part)
        rows.append(np.concatenate(row,axis=1))
    return np.concatenate(rows,axis=0)

def solve(tile):
    g=tile3(tile)
    H,W=g.shape
    bg=(g==0)
    ext=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if bg[r,c] and not ext[r,c]: ext[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for nr,nc in neigh4(r,c,H,W):
            if bg[nr,nc] and not ext[nr,nc]: ext[nr,nc]=1; q.append((nr,nc))
    holes=bg & ~ext
    fg=(g==2)|holes
    outline=np.zeros((H,W),bool)
    for r,c in np.argwhere(ext):
        if any(fg[nr,nc] for nr,nc in neigh8(int(r),int(c),H,W)):
            outline[r,c]=1
    return g,holes,outline

def rand_shape():
    target=random.randint(8,14)
    start=(random.randrange(N),random.randrange(N))
    cells={start}
    while len(cells)<target:
        frontier=[]
        for r,c in cells:
            for nr,nc in neigh4(r,c,N,N):
                if (nr,nc) not in cells:
                    score=sum((xr in (0,N-1) or xc in (0,N-1)) for xr,xc in cells)
                    frontier.append((nr,nc))
        if not frontier: return None
        # bias toward compact growth
        frontier=sorted(frontier,key=lambda p:(abs(p[0]-2)+abs(p[1]-2), random.random()))
        pick=frontier[random.randrange(min(len(frontier),4))]
        cells.add(pick)
    tile=np.zeros((N,N),int)
    for r,c in cells: tile[r,c]=2
    if sum(tile[r,c]==2 and (r in (0,N-1) or c in (0,N-1)) for r in range(N) for c in range(N))<2: return None
    return tile

def noise_candidates(tile):
    out=[]
    for r in range(N):
        for c in range(N):
            if tile[r,c]"'!=0: continue
            if r not in (0,N-1) and c not in (0,N-1): continue
            if any(tile[nr,nc]==2 for nr,nc in neigh4(r,c,N,N)):
                out.append((r,c))
    return out

count=0
for _ in range(2000):
    tile=rand_shape()
    if tile is None: continue
    g,holes,outline=solve(tile)
    comps=len(cc(holes))
    hp=int(holes.sum())
    if comps<1 or hp<1 or hp>28: continue
    cand=noise_candidates(tile)
    if len(cand)<1: continue
    good=[]
    for k in [1,2]:
        for comb in itertools.combinations(cand,k):
            noisy=tile.copy()
            for r,c in comb: noisy[r,c]=5
            g2,h2,o2=solve(np.where(noisy==5,5,noisy))
            if not np.array_equal(h2,holes):
                good.append((comb,int(h2.sum())))
    if not good: continue
    count+=1
    if count<=8:
        print('"'tile')
        print(tile)
        print('hole_pixels',hp,'hole_comps',comps,'noise options',good[:5])
        print('outline',int(outline.sum()))
        print()
print('valid count',count)
