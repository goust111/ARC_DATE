import numpy as np, random

def owner(shape, markers):
    H,W=shape
    own=np.full((H,W),-1,int)
    best=np.full((H,W),10**9,int)
    for i,(mr,mc,col) in enumerate(markers):
        seen=set()
        for dr,dc in ((-1,-1),(-1,1),(1,-1),(1,1)):
            r,c=mr,mc
            while 0<=r<H and 0<=c<W:
                if (r,c) not in seen:
                    d=(r-mr)**2+(c-mc)**2
                    if d < best[r,c] or (d==best[r,c] and (own[r,c]==-1 or (mr,mc)<markers[own[r,c]][:2])):
                        best[r,c]=d; own[r,c]=i
                    seen.add((r,c))
                r += dr; c += dc
    return own

def comps(shape, markers):
    wall=owner(shape, markers)"'!=-1
    H,W=shape; seen=np.zeros((H,W),bool); out=[]
    for r in range(H):
      for c in range(W):
        if wall[r,c] or seen[r,c]: continue
        st=[(r,c)]; seen[r,c]=1; cells=[]; border=False
        while st:
          rr,cc=st.pop(); cells.append((rr,cc)); border |= rr in (0,H-1) or cc in (0,W-1)
          for nr,nc in ((rr-1,cc),(rr+1,cc),(rr,cc-1),(rr,cc+1)):
            if 0<=nr<H and 0<=nc<W and not wall[nr,nc] and not seen[nr,nc]:
              seen[nr,nc]=1; st.append((nr,nc))
        if not border: out.append(cells)
    return out

for corners in [3,4]:
  ok=0
  trials=0
  for _ in range(4000):
    H=W=random.randint(12,15)
    rows=sorted(random.sample(range(2,H-2),2))
    cols=sorted(random.sample(range(2,W-2),2))
    if rows[1]-rows[0] < 4 or cols[1]-cols[0] < 4:
      continue
    trials +=1
    pts=[(rows[0],cols[0],1),(rows[0],cols[1],2),(rows[1],cols[0],3),(rows[1],cols[1],4)]
    if corners==3:
      pts=random.sample(pts,3)
    regs=comps((H,W),pts)
    areas=sorted(len(x) for x in regs)
