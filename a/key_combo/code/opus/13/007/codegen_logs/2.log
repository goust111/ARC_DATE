  grid: 15x15 [observed]
  colors:
    background: any color except green(3) or yellow(4); 8 (azure) [observed]
    foreground: exactly 1 color, not green(3) or yellow(4); 6 (magenta) [observed]
  objects:
    count: 3 [observed]
    type: axis-aligned rectangles with an optional rectangular hole punched inside
    bbox_dims: 2-7 per side; each object >=2x2
    hole: 0 or more objects have a rectangular hole; at least 1 object must have a hole
    hole_shape: rectangular, fully enclosed by 1-cell-thick fg border on all sides
    hole_position: anywhere inside the object (not necessarily centered or filling entire interior)
    connectivity: 4-connected per object; objects are 4-connected components
    separation: pairwise Chebyshev distance >= 3 between objects
    margin: every fg pixel >= 1 cell from grid border (no fg on row/col 0 or 14)
  transform:
    preserve: all foreground pixels unchanged
    green_outline: exterior bg pixels that 8-neighbor any fg pixel become green(3)
    yellow_fill: enclosed bg holes (unreachable from grid border via 4-connected bg) become yellow(4)

generation_strategy:
