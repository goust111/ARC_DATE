+
+    if not any(
+        any(int(grid[r, c]) == BLACK and int(out[r, c]) != BLACK for r, c in region["cells"])
+        for region in labeled_closed
+    ):
+        return False
+    if not any(
+        any(int(grid[r, c]) == BLACK and int(out[r, c]) == BLACK for r, c in region["cells"])
+        for region in unlabeled_closed
+    ):
+        return False
+    return True
+
