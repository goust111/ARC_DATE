  "path": "both full diagonals through every marker pixel, extending to the grid edges",
  "trajectory": "paint the union of those diagonal cells according to the original base color at each cell",
  "transform": "base-color cells on active diagonals become their paired marker color; marker pixels and off-path cells remain unchanged"
}
</annotation>
