+    return out
+
+
+GRID_MIN = 12
+GRID_MAX = 15
+MARKER_COUNT_OPTIONS = (3, 4)
+MIN_ROW_GAP = 4
+MIN_COL_GAP = 4
+MAX_ATTEMPTS = 400
+MIN_ELIGIBLE_REGION_AREA = 4
+LABEL_TOTAL_MIN = 4
+LABEL_TOTAL_MAX = 8
