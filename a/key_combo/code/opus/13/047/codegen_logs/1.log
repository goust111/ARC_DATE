+    def key(self) -> tuple[int, int, int]:
+        return self.area, self.r0, self.c0
+
+    def covers(self, r: int, c: int) -> bool:
+        return self.r0 <= r <= self.r1 and self.c0 <= c <= self.c1
+
+    def cell_value(self, r: int, c: int, *, local_phase: bool = True) -> int:
