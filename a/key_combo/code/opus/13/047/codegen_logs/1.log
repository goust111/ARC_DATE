+        rows = int(rng.integers(*GRID_ROWS))
+        cols = int(rng.integers(*GRID_COLS))
+        pair_count = int(rng.choice(PAIR_COUNT_OPTIONS, p=PAIR_COUNT_WEIGHTS))
