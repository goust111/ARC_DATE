+        if any((h * w, r0, c0) == rect.key for rect in existing):
+            continue
+        overlaps = [
+            _intersection_area(_build_rect(color, r0, c0, h, w, 0), rect)
+            for rect in existing
+        ]
+        if require_overlap and not any(area > 0 for area in overlaps):
