+    if reverse_area:
+        priority = sorted(rects, key=lambda spec: (-spec.area, spec.r0, spec.c0))
+    elif reverse_equal_tie:
+        priority = sorted(rects, key=lambda spec: (spec.area, -spec.r0, -spec.c0))
+    else:
+        priority = sorted(rects, key=lambda spec: spec.key)
