+    counts = [active_depth] * ncols
+    remaining = total_pixels - active_depth * ncols
+    while remaining > 0:
+        candidates = [idx for idx, count in enumerate(counts) if count < nrows]
+        idx = random.choice(candidates)
+        counts[idx] += 1
+        remaining -= 1
