+
+    nrows, ncols = occupancy.shape
+    center_rows = [top + 1 + 4 * i for i in range(nrows)]
+    center_cols = [left + 1 + 4 * j for j in range(ncols)]
+
+    colors = [int(inp[r, c]) for r, c in np.argwhere((inp != BLACK) & (inp != GREY))]
+    if not (5 <= len(colors) <= 8):
