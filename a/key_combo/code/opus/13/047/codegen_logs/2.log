+def _tie_pattern(ncols: int, palette: list[int]) -> list[int]:
+    if ncols == 3:
+        return random.sample(palette, 3)
+    a, b = random.sample(palette, 2)
+    return [a, b, a, b] if random.choice([False, True]) else [a, b, b, a]
