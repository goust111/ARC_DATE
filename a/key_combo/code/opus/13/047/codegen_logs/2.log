+        tie_row = random.randrange(active_depth)
+
+    for i in range(active_depth):
+        if i == tie_row:
+            pattern = _tie_pattern(ncols, palette if len(palette) >= 3 else palette + [random.choice([c for c in PALETTE if c not in palette])])
+        else:
