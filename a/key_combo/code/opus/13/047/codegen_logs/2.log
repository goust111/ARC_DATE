+    return center_rows, center_cols, by_center, scaffold_top
+
+
+def _winner(colors: list[int]) -> int:
+    counts = Counter(colors)
+    best = max(counts.values())
+    for color in colors:
+        if counts[color] == best:
+            return int(color)
+    raise AssertionError("unreachable")
