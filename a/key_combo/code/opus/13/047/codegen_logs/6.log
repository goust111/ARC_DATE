+                item["end"] = col_count - 1 - pair["start"]
+        else:
+            if flip_c:
+                item["track"] = col_count - 1 - pair["track"]
+            if flip_r:
+                item["start"] = row_count - 1 - pair["end"]
+                item["end"] = row_count - 1 - pair["start"]
