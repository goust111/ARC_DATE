+def _infer_divider_color(grid: np.ndarray) -> int:
+    row_colors = [int(grid[r, 0]) for r in range(grid.shape[0]) if np.all(grid[r, :] == grid[r, 0])]
+    col_colors = [int(grid[0, c]) for c in range(grid.shape[1]) if np.all(grid[:, c] == grid[0, c])]
