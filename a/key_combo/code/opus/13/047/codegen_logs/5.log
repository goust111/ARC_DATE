+BG = 0
+OUTLINE_COLOR = 3
+INTERSECTION_COLOR = 4
+INPUT_COLORS = (1, 2, 5, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+GEN_ATTEMPTS = 400
