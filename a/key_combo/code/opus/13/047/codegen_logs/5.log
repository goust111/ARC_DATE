+    actual_yellow = {tuple(map(int, rc)) for rc in np.argwhere(out == INTERSECTION_COLOR)}
+    if actual_yellow != meta["crossings"]:
+        return False
+
+    ray_union = set()
+    for color, cells in meta["ray_hits_by_color"].items():
