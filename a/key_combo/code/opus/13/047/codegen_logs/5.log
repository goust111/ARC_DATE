+    for color in info["noise_colors"]:
+        out[g == color] = BG
+
+    outline_cells: set[tuple[int, int]] = set()
+    for color in sorted(info["signal_infos"]):
+        sig = info["signal_infos"][color]
+        if sig["area"] != 2:
+            continue
+        for r, c in _expanded_outline(sig["bbox"], g.shape):
+            if out[r, c] == BG:
+                out[r, c] = OUTLINE_COLOR
