+    ray_hits_by_color: dict[int, set[tuple[int, int]]] = defaultdict(set)
+    ray_paths: dict[tuple[int, int, int], list[tuple[int, int]]] = {}
+    first_blockers: dict[tuple[int, int, int], tuple[int, int] | None] = {}
+    signal_pixels = info["signal_pixels"]
