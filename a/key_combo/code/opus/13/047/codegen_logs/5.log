+            ray_paths[(color, dr, dc)] = path
+            first_blockers[(color, dr, dc)] = blocker
+
+    crossings: set[tuple[int, int]] = set()
+    for cells in ray_hits_by_color.values():
+        crossings |= cells & outline_cells
+    for r, c in crossings:
