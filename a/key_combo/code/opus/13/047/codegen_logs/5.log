+    dir_order = list(directions)
+    rng.shuffle(dir_order)
+    for side in dir_order:
+        distances = [3, 4, 5]
+        rng.shuffle(distances)
+        shapes = list(BLOCKER_SHAPES[side])
+        rng.shuffle(shapes)
+        for dist in distances:
+            if side == "up":
+                anchor = (sr - dist, sc)
+            elif side == "down":
+                anchor = (sr + dist, sc)
+            elif side == "left":
+                anchor = (sr, sc - dist)
+            else:
+                anchor = (sr, sc + dist)
