+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        rows = random.choice([3, 4])
+        cols = random.choice([3, 4])
+        total_cells = rows * cols
+        num_targets = random.randint(3, min(5, total_cells - 1))
+        connected_count = random.randint(2, min(4, num_targets - 1))
