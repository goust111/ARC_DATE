+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+GREY = 5
+
+INNER = 3
+BOX = INNER + 2
+GAP = 3
+PITCH = BOX + GAP
+
+TEMPLATE_COLORS = [1, 3, 4, 6, 7, 8, 9]
+SIDE_ORDER = ("left", "top", "right", "bottom")
+SIDE_TO_ORIENTATION = {
+    "left": "V",
+    "right": "V",
+    "top": "H",
+    "bottom": "H",
+}
+ROTATION_FOR_SIDE = {
+    "left": 0,
+    "top": -1,
+    "right": 2,
+    "bottom": 1,
