+        if assignment is None:
+            continue
+
+        for _target, _side, path, _shape in assignment:
+            for r, c in path:
+                base[r, c] = GREY
+
+        try:
+            _validate_semantics(base)
+        except AssertionError:
+            continue
+        return base
