# Layout constraints.
MARKER_CHEB_GAP, OBJECT_CHEB_GAP = 2, 3
OBJECT_LEGEND_MANHATTAN_GAP = 2
OBJECT_ZONE_MIN_SPAN, OBJECT_ZONE_BORDER = 8, 1
LEGEND_ZONE_GAP, LEGEND_SIDE_OFFSET = 2, 10

