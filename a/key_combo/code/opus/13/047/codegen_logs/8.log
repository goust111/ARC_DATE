+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    m = patch != BLACK
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    view[m] = patch[m]
+
+
+def _sample_marker_cells(
+    legend_box: tuple[int, int, int, int], count: int
+) -> list[tuple[int, int]] | None:
+    r0, c0, r1, c1 = legend_box
