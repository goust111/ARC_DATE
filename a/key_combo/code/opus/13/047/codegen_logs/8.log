spec:
  grid: 14-19 rows x 20-25 cols, background 0
  legend:
    body: solid filled rectangle of color 5 (gray), size 6-10 x 6-8
    markers: 3-5 single-pixel colored dots inside the legend rectangle
    marker_colors: all distinct, differ from bg/legend/placeholder colors
    marker_spacing: pairwise Chebyshev distance >= 2 between markers
    no bg pixels inside legend rectangle
  objects:
    count: equals number of markers (3-5)
    color: single placeholder color (not bg, not 5, not any marker color)
    connectivity: 8-connected, each 5-15 pixels, bbox 2-4 rows x 3-6 cols
    fill_ratio: 0.47-0.78 (not fully filled rectangles, have holes/notches)
    separation: pairwise Chebyshev distance >= 3 between objects
  layout:
    legend and objects-bbox do not overlap (no row/col range intersection)
    legend may touch grid edges; objects stay >= 1 cell from grid border
    min Manhattan distance from legend rect to any object pixel >= 2
  transform:
    match each object to a marker by closest relative position (object bbox-center in objects-bbox vs marker position in legend-bbox)
    recolor each object's pixels to its matched marker color; legend unchanged

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid size, N markers (3-5), and N+3 distinct colors for bg(0), legend(5), placeholder, and N markers.
    2. Partition grid into two non-overlapping rectangular zones (legend zone, objects zone) with >= 2 cell gap.
    3. Place legend as a solid gray rectangle filling its zone.
    4. Choose N relative positions (well-separated) and place 1-pixel markers inside legend at those positions.
