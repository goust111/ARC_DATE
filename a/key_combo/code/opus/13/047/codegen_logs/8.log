+    assert grey_assignment != complete_assignment
+    assert any(gb != fb for gb, fb in zip(sorted(grey_boxes), sorted(full_boxes)))
+    return inp, out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        try:
