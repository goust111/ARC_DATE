+        col_map.setdefault(c, []).append(r)
+
+    for row, cols in row_map.items():
+        cols = sorted(cols)
+        if len(cols) >= 2 and cols == list(range(cols[0], cols[-1] + 1)):
+            candidates.append(("h", row, len(cols)))
+    for col, rows in col_map.items():
