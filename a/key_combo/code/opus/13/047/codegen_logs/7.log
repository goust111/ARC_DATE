+                v_markers = _sample_marker_pair(h, h_row, area + 1, rng, prefer="straddle")
+            elif branch == "cross_deleted":
+                h_markers = _sample_marker_pair(w, v_col, 2, rng, prefer="straddle")
+                v_markers = _sample_marker_pair(h, h_row, area + 1, rng, prefer="straddle")
+            else:
