+    h, w = features["shape"]
+    h_row = features["h_row"]
+    v_col = features["v_col"]
+    c_left = features["c_left"]
+    c_right = features["c_right"]
+    r_top = features["r_top"]
+    r_bottom = features["r_bottom"]
+    area = features["green_area"]
