+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _build_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ARC instance")

