+    grid[h_row, :] = BLUE
+    grid[:, v_col] = RED
+    grid[h_row, v_col] = RED
+    grid[h_row, c_left] = ORANGE
+    grid[h_row, c_right] = ORANGE
+    grid[r_top, v_col] = ORANGE
+    grid[r_bottom, v_col] = ORANGE
