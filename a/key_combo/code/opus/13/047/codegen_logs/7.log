+    kept_bottom = r_bottom - n_rows
+    for r in range(r_top, r_bottom + 1):
+        for c in range(c_left, c_right + 1):
+            if r > kept_bottom:
+                out[r, c] = BG
+            else:
+                parity = (r - r_top + c - c_left) % 2
+                out[r, c] = BLUE if parity == 0 else RED
