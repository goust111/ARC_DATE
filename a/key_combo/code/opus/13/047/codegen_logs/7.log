+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if seen[rr, cc]:
+            continue
+        stack = [(rr, cc)]
+        seen[rr, cc] = True
+        coords = []
+        while stack:
+            cr, cc = stack.pop()
+            coords.append((cr, cc))
+            for nr, nc in neighbors8(cr, cc):
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(np.array(coords, dtype=int))
+    return comps
