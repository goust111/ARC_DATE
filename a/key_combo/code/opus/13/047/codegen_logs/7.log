+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+GRID_H_RANGE = (12, 18)
+GRID_W_RANGE = (13, 19)
+GREEN_AREA_RANGE = (3, 7)
