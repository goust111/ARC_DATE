    doors: list[tuple[tuple[int, int], tuple[int, int]]] = []
    for r0, c0 in zip(*np.where(g == marker_color)):
        r, c = int(r0), int(c0)
        neighbors = []
        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            rr, cc = r + dr, c + dc
            assert in_bounds(g.shape, rr, cc)
            neighbors.append((int(g[rr, cc]), dr, dc, rr, cc))

