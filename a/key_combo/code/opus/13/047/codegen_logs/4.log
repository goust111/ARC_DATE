+def _interior_cells(rect: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    return {
+        (r, c)
+        for r in range(r0 + 1, r1)
+        for c in range(c0 + 1, c1)
+    }
+
