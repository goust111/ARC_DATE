+            periodic_clean[idx] = clean
+            periodic_noisy[idx] = noisy
+            grid[r0 : r0 + h, c0 : c0 + w] = noisy
+            expected[r0 : r0 + h, c0 : c0 + w] = clean
+        pos += size + 1
+
+    pos = 1
+    for idx, size in indexed_sizes:
+        if orientation == "horizontal":
+            r0, c0 = 1, pos
+            h, w = cross, size
+        else:
+            r0, c0 = pos, 1
