+        assert len(counts) == 1 or counts[0][1] > counts[1][1], "isolated frame must have a unique majority"
+        fill = int(counts[0][0])
+        r0 = frame["interior_r0"]
+        c0 = frame["interior_c0"]
+        h = frame["interior_h"]
+        w = frame["interior_w"]
+        out[r0 : r0 + h, c0 : c0 + w] = fill
