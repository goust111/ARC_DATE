+def _scenario() -> tuple[int, int]:
+    choices = [
+        (2, 0),
+        (2, 1),
+        (3, 1),
+        (4, 1),
+        (4, 2),
+    ]
+    weights = [1, 1, 4, 4, 2]
+    return random.choices(choices, weights=weights, k=1)[0]
