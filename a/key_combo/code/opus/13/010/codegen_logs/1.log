+    H, W = occupied.shape
+    if r0 < 0 or c0 < 0 or r0 + h > H or c0 + w > W:
+        return False
+    rr0 = max(0, r0 - padding)
+    cc0 = max(0, c0 - padding)
+    rr1 = min(H, r0 + h + padding)
+    cc1 = min(W, c0 + w + padding)
+    return not occupied[rr0:rr1, cc0:cc1].any()
