+def _place_patch(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray, padding: int) -> bool:
+    H, W = grid.shape
+    h, w = patch.shape
+    candidates = [(r, c) for r in range(H - h + 1) for c in range(W - w + 1)]
