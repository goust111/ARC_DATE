+    random.shuffle(candidates)
+    for r0, c0 in candidates:
+        if not _fits(occupied, patch, r0, c0, padding):
+            continue
+        mask = patch != BG
+        grid[r0 : r0 + h, c0 : c0 + w][mask] = patch[mask]
