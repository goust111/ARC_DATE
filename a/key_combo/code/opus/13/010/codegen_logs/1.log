+    pairs: list[tuple[int, int]] = []
+    bridged = set()
+    for coords in _component_cells(grid, BRIDGE):
+        touched: set[int] = set()
+        for r, c in coords:
+            for nr, nc in _neighbors4(int(r), int(c)):
+                owner = border_owner.get((nr, nc))
+                if owner is not None:
+                    touched.add(owner)
