+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _generate_once()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid bridge/fill/mirror ARC input")

