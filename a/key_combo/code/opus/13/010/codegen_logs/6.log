+    r0, c0, r1, c1 = _bbox_coords(coords)
+    if r1 - r0 < 4 or c1 - c0 < 4:
+        return False
+    if (r1 - r0) % 2 != 0 or (c1 - c0) % 2 != 0:
+        return False
+    points = {tuple(map(int, p)) for p in coords}
+    expected: set[tuple[int, int]] = set()
+    for r in range(r0, r1 + 1, 2):
+        expected.add((r, c0))
+        expected.add((r, c1))
+    for c in range(c0, c1 + 1, 2):
