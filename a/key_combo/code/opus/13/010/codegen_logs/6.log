+
+def _random_sparse_sprite() -> dict | None:
+    for _ in range(200):
+        h = random.randint(3, 4)
+        w = random.randint(3, 4)
+        parity = random.randint(0, 1)
+        allowed = [(r, c) for r in range(h) for c in range(w) if (r + c) % 2 == parity]
+        if len(allowed) < 4:
+            continue
+        k = random.randint(4, min(7, len(allowed)))
+        chosen = np.array(random.sample(allowed, k), dtype=int)
