import itertools, random, numpy as np
random.seed(0)

def dense_mask(coords):
    coords=np.array(coords)
    r0,c0=coords.min(0); r1,c1=coords.max(0)
    rel=coords-[r0,c0]
    m=np.zeros((r1-r0+2,c1-c0+2),dtype=bool)
    for r,c in rel:
        m[r:r+2,c:c+2]=True
    return m

def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; st=[tuple(pts[0])]
    h,w=mask.shape
    while st:
        r,c=st.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); st.append((nr,nc))
    return len(seen)==mask.sum()

def make():
    for _ in range(1000):
        h=random.randint(3,4); w=random.randint(3,4); p=random.randint(0,1)
        allowed=[(r,c) for r in range(h) for c in range(w) if (r+c)%2==p]
        if len(allowed)<4: continue
        k=random.randint(4,min(7,len(allowed)))
        arr=np.array(random.sample(allowed,k))
        if arr[:,0].min()"'!=0 or arr[:,0].max()!=h-1 or arr[:,1].min()!=0 or arr[:,1].max()!=w-1: continue
        if not np.any(arr[:,1]==0) or not np.any(arr[:,1]==w-1): continue
        dm=dense_mask(arr)
        if not connected(dm): continue
        return arr
    return None

def info(coords):
    coords=np.array(coords)
    h=coords[:,0].max()+1; w=coords[:,1].max()+1
    sl={int(r) for r,c in coords if c==0}
    sr={int(r) for r,c in coords if c==w-1}
    dm=dense_mask(coords)
    dl=set(np.where(dm[:,0])[0].tolist())
    dr=set(np.where(dm[:,-1])[0].tolist())
    return {'"'coords':coords,'sparse_left':sl,'sparse_right':sr,'dense_left':dl,'dense_right':dr,'shape':(h,w),'dense_shape':dm.shape}

def dmatch(a,b): return bool(a['dense_right'] & b['dense_left'])

def smatch(a,b): return bool(a['sparse_right'] & b['sparse_left'])

cand=[]; seen=set()
while len(cand)<80:
    arr=make()
    key=tuple(sorted(map(tuple,arr)))
    if key in seen: continue
    seen.add(key); cand.append(info(arr))
print('cand', len(cand))
for trial in range(200000):
    s=random.sample(cand, 4)
    if any(smatch(a,b) for a,b in itertools.permutations(s,2)):
        continue
    perms=[perm for perm in itertools.permutations(range(4)) if all(dmatch(s[perm[i]], s[perm[i+1]]) for i in range(3))]
    if len(perms)==1:
        print('FOUND4', perms[0])
        for c in s:
            print(c['shape'], c['dense_shape'], c['sparse_left'], c['sparse_right'], sorted(map(tuple,c['coords'])))
        break
else:
    print('no 4-chain found')
for trial in range(200000):
    s=random.sample(cand, 3)
    if any(smatch(a,b) for a,b in itertools.permutations(s,2)):
        continue
    perms=[perm for perm in itertools.permutations(range(3)) if all(dmatch(s[perm[i]], s[perm[i+1]]) for i in range(2))]
    if len(perms)==1:
        print('FOUND3', perms[0])
        for c in s:
            print(c['shape'], c['dense_shape'], c['sparse_left'], c['sparse_right'], sorted(map(tuple,c['coords'])))
        break
else:
    print('no 3-chain found')
