+    assert g.ndim == 2
+    bg = _get_bg(g)
+
+    counts = Counter(map(int, g.ravel()))
+    non_bg = [int(c) for c in sorted(counts) if int(c) != int(bg)]
+    assert non_bg, "expected non-background colors"
