+        total = sum(sizes)
+        slack = int(inner_h - total)
+        assert slack >= 0, "frame interior is too short"
+        gap = slack // (len(ordered) + 1)
+        extra = slack - gap * (len(ordered) + 1)
+        lead = gap + (extra + 1) // 2
+        cursor = int(r0 + 1 + lead)
