/bin/bash -lc "python - <<'PY'
import itertools, random, numpy as np

def dense_mask(coords):
    coords=np.array(coords)
    r0,c0=coords.min(0); r1,c1=coords.max(0)
    rel=coords-[r0,c0]
    m=np.zeros((r1-r0+2,c1-c0+2),dtype=bool)
    for r,c in rel:
        m[r:r+2,c:c+2]=True
    return m

def connected(mask):
    pts=np.argwhere(mask)
    if len(pts)==0:return False
    seen={tuple(pts[0])}; st=[tuple(pts[0])]
    h,w=mask.shape
    while st:
        r,c=st.pop()
        for nr,nc in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and (nr,nc) not in seen:
                seen.add((nr,nc)); st.append((nr,nc))
    return len(seen)==mask.sum()

def info(coords):
    coords=np.array(coords)
    h=coords[:,0].max()+1; w=coords[:,1].max()+1
    sl={int(r) for r,c in coords if c==0}
    sr={int(r) for r,c in coords if c==w-1}
    dm=dense_mask(coords)
    dl=set(np.where(dm[:,0])[0].tolist())
    dr=set(np.where(dm[:,-1])[0].tolist())
    return {'coords':coords,'sparse_left':sl,'sparse_right':sr,'dense_left':dl,'dense_right':dr,'shape':(h,w),'dense_shape':dm.shape}

def dmatch(a,b): return bool(a['dense_right'] & b['dense_left'])

def smatch(a,b): return bool(a['sparse_right'] & b['sparse_left'])

cand=[]
for h in (3,4):
  for w in (3,4):
    for p in (0,1):
      allowed=[(r,c) for r in range(h) for c in range(w) if (r+c)%2==p]
      for k in range(4,min(7,len(allowed))+1):
        for comb in itertools.combinations(allowed,k):
          arr=np.array(comb)
          if arr[:,0].min()"'!=0 or arr[:,0].max()!=h-1 or arr[:,1].min()!=0 or arr[:,1].max()!=w-1:
            continue
          if not np.any(arr[:,1]==0) or not np.any(arr[:,1]==w-1):
            continue
          dm=dense_mask(arr)
          if not connected(dm):
            continue
          cand.append(info(arr))
print('"'candidates', len(cand))
# dedup by coords bytes+shape
uniq=[]; seen=set()
for c in cand:
    key=(tuple(map(tuple,sorted(map(tuple,c['coords'])))), c['shape'])
    if key not in seen:
        seen.add(key); uniq.append(c)
print('uniq', len(uniq))

# find a few 4-chains
found=[]
for combo in itertools.combinations(range(len(uniq)), 4):
    s=[uniq[i] for i in combo]
    if any(smatch(a,b) for a,b in itertools.permutations(s,2)):
        continue
    perms=[perm for perm in itertools.permutations(range(4)) if all(dmatch(s[perm[i]], s[perm[i+1]]) for i in range(3))]
    if len(perms)==1:
        found.append((combo, perms[0]))
        if len(found)>=8:
            break
print('found', len(found))
for combo,perm in found[:5]:
    print('combo', combo, 'perm', perm)
    for idx in combo:
        c=uniq[idx]
        print(' ',idx,'shape',c['shape'],'dense',c['dense_shape'],'sl',c['sparse_left'],'sr',c['sparse_right'],'dl',c['dense_left'],'dr',c['dense_right'],'coords',sorted(map(tuple,c['coords'])))
    print()
