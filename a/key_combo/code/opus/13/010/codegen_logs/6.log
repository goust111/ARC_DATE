+            c0 = random.randint(0, canvas_w - w)
+            box = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if any(_overlap(box, other, pad=1) for other in boxes):
+                continue
+            pos[idx] = (int(r0), int(c0))
+            boxes.append(box)
