diff --git a/key_combo/code/opus/13/010/6.py b/key_combo/code/opus/13/010/6.py
new file mode 100644
index 0000000000000000000000000000000000000000..f2101bb1b34e2fa16adad13a7ffd8ae55f3df9e1
--- /dev/null
+++ b/key_combo/code/opus/13/010/6.py
@@ -0,0 +1,436 @@
+from __future__ import annotations
+
+from collections import Counter
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 8
+SPRITE_COLORS = [1, 2, 3, 4]
+LATTICE_CHOICES = [5, 6, 7, 9]
+MAX_GEN_ATTEMPTS = 800
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _dense_mask_from_coords(coords: np.ndarray) -> np.ndarray:
+    coords = np.asarray(coords, dtype=int)
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    rel = coords - np.array([r0, c0], dtype=int)
