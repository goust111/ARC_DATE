  pass_columns:
    bottom-align at row H-3; contiguous pass runs may slide 1 col right if an obstacle with a horizontal neighbor exists below them AND the shifted 3-tall landing zone is clear
    bottom_edge_gap: if pass col lands through an obstacle bar spanning >= marker_w on the bottom row, the interior of that bar under the marker width is cleared to bg
