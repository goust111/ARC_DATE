import random
import numpy as np
from collections import deque

BG, BLUE, RED, GREY, MAROON = 0,1,2,5,9


def drop(grid):
    g=grid.copy()
    H,W=g.shape
    out=g.copy()
    out[:2,:]=BG
    for c in range(W):
        stack=np.array([MAROON,g[1,c]])
        obs=np.flatnonzero(g[2:,c]==GREY)
        bottom = (2+obs[0]-1) if len(obs) else H-1
        top = bottom-1
        out[top:bottom+1,c]=stack
    return out


def enclosed(grid):
    H,W=grid.shape
    seen=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if grid[r,c]==BG and not seen[r,c]:
                seen[r,c]=True;q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if grid[r,c]==BG and not seen[r,c]:
                seen[r,c]=True;q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and grid[nr,nc]==BG and not seen[nr,nc]:
                seen[nr,nc]=True;q.append((nr,nc))
    comps=[]
    seen2=np.zeros((H,W),bool)
    for r in range(H):
        for c in range(W):
            if grid[r,c]==BG and not seen[r,c] and not seen2[r,c]:
                comp=[];seen2[r,c]=True;q=deque([(r,c)])
                while q:
                    rr,cc=q.popleft();comp.append((rr,cc))
                    for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                        nr,nc=rr+dr,cc+dc
                        if 0<=nr<H and 0<=nc<W and grid[nr,nc]==BG and not seen[nr,nc] and not seen2[nr,nc]:
                            seen2[nr,nc]=True;q.append((nr,nc))
                comps.append(comp)
    return comps

H,W=16,20
g=np.zeros((H,W),int)
g[0,:]=MAROON
g[1,:]=np.random.randint(1,3,size=W)
# room
r0=5; c0=5; ih=3; iw=3
r1=r0+ih+1; c1=c0+iw+1
# full rectangle
for c in range(c0,c1+1):
    g[r0,c]=GREY; g[r1,c]=GREY
for r in range(r0,r1+1):
    g[r,c0]=GREY; g[r,c1]=GREY
# left opening top two cells
for rr in (r0,r0+1):
    g[rr,c0]=BG
# set control color for plug col
#g[1,c0]=BLUE

out=drop(g)
print(out)
print('enclosed', [len(c) for c in enclosed(out)])
