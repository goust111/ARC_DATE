 258:                 touch1 = _touches_border(e1, h, w)
 259:                 if touch0 == touch1:
 260:                     continue  # require exactly one endpoint on border
 261:                 # Orientation must be perpendicular to the edge it touches.
 262:                 rs = [r for r, _ in comp]
 263:                 cs = [c for _, c in comp]
 264:                 vertical = len(set(cs)) == 1
 265:                 border_ep = e0 if touch0 else e1
 266:                 if vertical:
 267:                     if border_ep[0] not in (0, h - 1):
 268:                         continue
 269:                 else:
 270:                     if border_ep[1] not in (0, w - 1):
 271:                         continue
