+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
+    out[:2, :] = BG
+
+    assert np.all(g[0, :] == MAROON), "expected a full maroon top row"
+    assert set(np.unique(g[1, :])).issubset(set(CONTROL_COLORS)), "expected blue/red control row"
+
