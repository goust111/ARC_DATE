+def _tile_crop(pattern: np.ndarray, h: int, w: int) -> np.ndarray:
+    if h <= 0 or w <= 0:
+        return np.zeros((max(h, 0), max(w, 0)), dtype=int)
+    ph, pw = pattern.shape
+    reps_h = (h + ph - 1) // ph
+    reps_w = (w + pw - 1) // pw
+    return np.tile(pattern, (reps_h, reps_w))[:h, :w]
