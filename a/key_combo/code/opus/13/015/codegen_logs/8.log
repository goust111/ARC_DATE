+def _random_composition(total: int, parts: int, minimum: int) -> list[int]:
+    values = [minimum] * parts
+    extra = total - minimum * parts
+    for _ in range(extra):
+        values[random.randrange(parts)] += 1
+    random.shuffle(values)
+    return values
+
