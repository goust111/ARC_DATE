+) -> list[tuple[int, int]]:
+    positions: list[tuple[int, int]] = []
+    for step, seg_idx in enumerate(range(len(segments) - 1, -1, -1)):
+        lo, hi = segments[seg_idx]
+        if step % 2 == 0:
