+        grid[pair[1], c] = color
+        current = color
+
+    if not changed:
+        pair = random.choice(chosen_rows)
+        grid[pair[1], c] = _opposite_color(bottom_color)
+
+    return bottom_color, [int(grid[r, c]) for _seg_idx, r in chosen_rows]
+
