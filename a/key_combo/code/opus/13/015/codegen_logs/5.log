+    r, c = start
+    rr, cc = r + dr, c + dc
+    while _in_bounds(grid.shape, rr, cc):
+        if (rr, cc) in repaired:
+            return "repair", (rr, cc)
+        if int(grid[rr, cc]) == MAIN:
+            return "main", (rr, cc)
