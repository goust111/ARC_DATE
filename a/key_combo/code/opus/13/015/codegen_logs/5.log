+            below_right = below_left + widths[r + 1] - 1
+            lo = max(0, below_left - (width - 2))
+            hi = min(patch_w - width, below_right - 1)
+            options = [x for x in range(lo, hi + 1) if abs(x - below_left) <= 1]
+            if not options:
+                options = list(range(lo, hi + 1))
+            if not options:
