+    grid_w = random.randint(min_w, 18)
+
+    top = random.randint(2, grid_h - patch_h - 3)
+    left = random.randint(2, grid_w - patch_w - 2)
+
+    out = np.zeros((grid_h, grid_w), dtype=int)
+    out[0, :] = EDGE
