+from __future__ import annotations
+
+import itertools
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+BG = 0
+MAIN = 1
+MARKER = 2
+EDGE = 5
+
+GEN_RETRIES = 400
+PATCH_RETRIES = 200
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
