spec:
  grid: 9x9 [observed], background black
  seed:
    shape: exactly 2x2, fully occupied (no bg cells)
    colors: exactly 1 paint color (any non-red, non-black) + 1-3 red corner pixels
    red_corners: 1-3 cells of the 2x2 are red; remaining cells are paint color
    position: at least 1 cell from every grid edge [observed]; min ray length >= 4
  output:
    background: black (same as input)
    content: for each red corner, a diagonal ray of 2x2 paint-color stamps
    ray_direction: red at TL -> up-left, TR -> up-right, BL -> down-left, BR -> down-right
    ray_stamping: starting at seed position, step +/-1 row and +/-1 col per stamp, until fully off-grid
    overlap: multiple rays may overlap; all painted cells use the same paint color
    seed_itself: painted with paint color (red replaced)
