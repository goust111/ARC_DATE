+def _neighbors4(r: int, c: int) -> Iterable[tuple[int, int]]:
+    yield int(r) - 1, int(c)
+    yield int(r) + 1, int(c)
+    yield int(r), int(c) - 1
+    yield int(r), int(c) + 1
