+def _split_region_for_count(
+    region: tuple[int, int, int, int],
+    count: int,
+) -> list[tuple[int, int, int, int]]:
+    r0, c0, r1, c1 = map(int, region)
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
