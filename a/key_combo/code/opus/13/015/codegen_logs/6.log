+
+
+def _grow_polyomino(area: int, box_h: int, box_w: int, rng: np.random.Generator) -> np.ndarray | None:
+    mask = np.zeros((int(box_h), int(box_w)), dtype=bool)
+    seed = (int(rng.integers(0, box_h)), int(rng.integers(0, box_w)))
+    mask[seed] = True
+    cells = {seed}
