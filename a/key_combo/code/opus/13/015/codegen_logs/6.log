+            if not choices:
+                return {}
+            name = choices[int(rng.integers(0, len(choices)))]
+            counts[name] += 1
+            remaining -= 1
+
+    if sum(counts[name] for name in kept_regions) < 2:
+        return {}
+    if use_two_controls and any(counts[name] > 1 for name in kept_regions + dropped_regions):
+        return {}
+    return counts
