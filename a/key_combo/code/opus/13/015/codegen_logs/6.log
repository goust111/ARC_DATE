+    for (name, slot), (color, area) in zip(slots, specs):
+        if area >= (slot[2] - slot[0] + 1) * (slot[3] - slot[1] + 1):
+            return None
+        if not _place_component_in_slot(grid, slot, int(color), int(area), rng):
