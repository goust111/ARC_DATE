128: def main(grid: np.ndarray) -> np.ndarray:
129:     """
130:     Overlay the three stacked panels, decode each restored 3x3 glyph by pixel area, and draw the resulting path on the start canvas.
131: 
132:     Input structure:
133:     - A full-height magenta divider splits the grid into a left instruction half and a right drawing half.
134:     - The left half is stacked into three equal-height black panels whose foreground fragments use red, blue, and green.
135:     - The right half is otherwise black and contains exactly one gray start pixel.
136: 
137:     Rule:
138:     - Composite the left panels with middle as base, top overwriting middle, and bottom overwriting both.
139:     - In the composite, read every non-empty 3x3 glyph tile in column-major order using the occupied 3-row and 3-column bands.
140:     - Decode each glyph by its non-background area: 3 -> right 2, 4 -> down 2, 5 -> left 3, 6 -> up 3, 7 -> right 4.
141:     - Starting from the gray marker on the right half, step down one row before every segment, draw the yellow segment, and keep the gray start pixel unchanged.
142: 
143:     Key insight:
144:     - No single panel contains the instruction by itself; only the three-layer overlay restores the full 3x3 occupancy pattern whose area encodes each movement.
145:     """
146:     g = np.asarray(grid, dtype=int)
147:     assert g.ndim == 2
148: 
149:     div_c = _find_divider_col(g)
150:     composite = _overlay_left(g)
151:     areas = _decode_areas_from_composite(composite)
152: 
153:     right = g[:, div_c + 1 :]
154:     start_pts = np.argwhere(right == START)
155:     assert start_pts.shape[0] == 1, "expected exactly one gray start pixel"
156:     start = tuple(map(int, start_pts[0]))
157:     return _trace_path(right.shape, start, areas)
