+        horiz_edge = "left" if rng.random() < 0.5 else "right"
+        ctrl_pts.append((0 if vert_edge == "top" else h - 1, int(col_split)))
+        ctrl_pts.append((int(row_split), 0 if horiz_edge == "left" else w - 1))
+        control_edges = {vert_edge, horiz_edge}
+    else:
