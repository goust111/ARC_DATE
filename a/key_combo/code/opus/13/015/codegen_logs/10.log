+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        sample = _gen_attempt(rng)
+        if sample is not None:
+            return sample
+    raise RuntimeError("failed to generate a valid sample")

