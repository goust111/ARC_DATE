+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    values = patch[patch != 0]
+    counts = Counter(map(int, values))
+    anchor_color = min(counts, key=lambda color: (counts[color], color))
+    anchor_pos = tuple(map(int, np.argwhere(patch == anchor_color)[0]))
+    return {
