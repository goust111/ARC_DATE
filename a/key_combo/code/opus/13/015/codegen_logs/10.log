+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+ANCHOR_COLORS = (RED, GREEN, YELLOW)
+ANCHOR_PLACEHOLDER = 9
