+    if height - arrangement_h - 1 < 1 or right_width - arrangement_w - 1 < 1:
+        return None
+    right_top = rng.randint(1, height - arrangement_h - 1)
+    right_left = rng.randint(1, right_width - arrangement_w - 1)
+
