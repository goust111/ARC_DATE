+
+
+def _random_mask(rng: np.random.Generator, h: int, w: int, *, require_lr_asym: bool) -> np.ndarray | None:
+    area_min = max(4, (h * w) // 2)
+    area_max = h * w - 1
+    if area_min > area_max:
+        area_min = area_max
+    for _ in range(80):
