+
+
+BG = 0
+TRAIN_FRAME = 5
+TEST_FRAME = 7
+FRAME_SIDE_RANGE = (5, 7)
+GRID_HEIGHT_RANGE = (14, 22)
+FRAME_GAP_RANGE = (2, 3)
+VERTICAL_MARGIN_RANGE = (4, 8)
+HORIZONTAL_MARGIN_RANGE = (1, 2)
