+
+
+def _validate_layout(grid: np.ndarray, groups: list[dict[str, Any]]) -> bool:
+    h, w = grid.shape
+    ordered = sorted(groups, key=lambda g: (g["mask_top"], g["mask_left"], g["seed_top"], g["seed_left"]))
