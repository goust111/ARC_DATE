+            groups.append(
+                {
+                    "mask_top": int(mr),
+                    "mask_left": int(mc),
+                    "seed_top": int(seed_top),
+                    "seed_left": int(seed_left),
+                    "paint": int(paint),
+                    "k": int(corner_count),
