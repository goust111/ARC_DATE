+    if not idx:
+        return []
+    out: list[tuple[int, int]] = []
+    start = prev = idx[0]
+    for val in idx[1:]:
+        if val == prev + 1:
+            prev = val
+            continue
+        out.append((start, prev))
+        start = prev = val
+    out.append((start, prev))
+    return out
