+    sr, sc = map(int, start)
+    out[sr, sc] = START
+    anchor = (sr, sc)
+    for area in areas:
+        cells = _segment_cells(anchor, int(area))
+        for r, c in cells:
+            assert 0 <= r < h and 0 <= c < w, "path exits canvas"
