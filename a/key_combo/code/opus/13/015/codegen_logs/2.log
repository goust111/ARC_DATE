+    else:
+        chosen = list(LAYER_COLORS) if rng.random() < 0.65 else rng.sample(LAYER_COLORS, 2)
+    rng.shuffle(chosen)
+    return chosen
+
+
+def _split_counts(total: int, parts: int, rng: random.Random) -> list[int]:
