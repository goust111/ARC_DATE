+def _segment_cells(anchor: tuple[int, int], area: int) -> list[tuple[int, int]]:
+    r, c = map(int, anchor)
+    sr, sc = r + 1, c
+    if area == 3:
+        return [(sr, sc + dc) for dc in range(2)]
+    if area == 4:
+        return [(sr + dr, sc) for dr in range(2)]
+    if area == 5:
+        return [(sr, sc - dc) for dc in range(3)]
+    if area == 6:
+        return [(sr - dr, sc) for dr in range(3)]
+    if area == 7:
