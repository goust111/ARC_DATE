+def _trace_path(shape: tuple[int, int], start: tuple[int, int], areas: list[int]) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.full((h, w), BG, dtype=int)
+    sr, sc = map(int, start)
+    out[sr, sc] = START
+    anchor = (sr, sc)
+    for area in areas:
+        cells = _segment_cells(anchor, int(area))
+        for r, c in cells:
+            assert 0 <= r < h and 0 <= c < w, "path exits canvas"
+            if (r, c) != (sr, sc):
