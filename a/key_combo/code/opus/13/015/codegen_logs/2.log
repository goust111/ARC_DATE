+    if not idx:
+        return []
+    out: list[tuple[int, int]] = []
+    start = prev = idx[0]
+    for val in idx[1:]:
+        if val == prev + 1:
+            prev = val
+            continue
+        out.append((start, prev))
+        start = prev = val
+    out.append((start, prev))
+    return out
+
+
+def _find_divider_col(grid: np.ndarray) -> int:
+    for c in range(int(grid.shape[1])):
+        col = grid[:, c]
+        if np.all(col == DIVIDER):
+            return int(c)
+    raise AssertionError("expected one full-height divider column")
+
