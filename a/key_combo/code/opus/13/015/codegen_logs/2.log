+                    if layer == TOP:
+                        top[rr, cc] = TOP
+                    elif layer == MID:
+                        middle[rr, cc] = MID
+                    else:
+                        bottom[rr, cc] = BOT
+                    visible_counts[layer] += 1
+                offset += count
+            missing_visible -= set(visible_layers)
+
+            for rr, cc in coords:
+                if bottom[rr, cc] == BOT:
+                    if rng.random() < 0.55:
+                        top[rr, cc] = TOP
+                    if rng.random() < 0.55:
