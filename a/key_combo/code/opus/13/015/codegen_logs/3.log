+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MARKER_COLORS = (RED, GREEN, YELLOW)
+TEMPLATE_MARKER = 9
+
+_TEMPLATE_ROWS = (
+    (
+        "1110",
+        "1911",
+        "1101",
+        "0111",
+    ),
+    (
+        "00110",
+        "11191",
+        "10011",
+        "01110",
+    ),
+    (
+        "01110",
+        "19101",
+        "11001",
+        "01110",
+    ),
