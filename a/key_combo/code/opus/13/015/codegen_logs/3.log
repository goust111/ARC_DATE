+def _extract_single_hole_shape(occupied_coords: np.ndarray) -> tuple[tuple[int, int], ...]:
+    r0, c0, r1, c1 = _bbox(occupied_coords)
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
