+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != -1:
+                continue
+            idx = len(comps)
+            q = deque([(r, c)])
+            labels[r, c] = idx
+            pts = []
+            while q:
+                cr, cc = q.popleft()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
