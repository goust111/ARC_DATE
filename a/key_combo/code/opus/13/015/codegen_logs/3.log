+TEMPLATE_MARKER = 9
+
+_TEMPLATE_ROWS = (
+    (
+        "1110",
+        "1911",
+        "1101",
+        "0111",
+    ),
+    (
+        "01110",
+        "11191",
+        "10011",
+        "11110",
+    ),
+    (
+        "11111",
+        "19101",
+        "11001",
+        "11110",
+    ),
