+_BASE_TEMPLATES = tuple(_template_variants())
+_BASE_HOLE_SHAPES = tuple(_validate_template(t.copy()) for t in _BASE_TEMPLATES)
+
+
+def _transform_template(template: np.ndarray) -> np.ndarray:
