+def _distribute_rows(total: int, heights: list[int]) -> list[int] | None:
+    mandatory = sum(heights) + max(0, len(heights) - 1)
+    if mandatory > total:
+        return None
+    slots = [0] + [1] * (len(heights) - 1) + [0]
+    extra = total - mandatory
+    for _ in range(extra):
