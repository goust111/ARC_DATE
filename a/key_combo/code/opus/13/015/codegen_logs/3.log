+        anchor = right_by_color[color]
+        for dr, dc in hole_shape:
+            rr = anchor[0] + dr
+            cc = anchor[1] + dc
+            assert 0 <= rr < g.shape[0] and 0 <= cc < g.shape[1]
+            out[rr, cc] = BLUE
