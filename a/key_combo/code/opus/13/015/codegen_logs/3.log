+
+    objects: dict[int, dict] = {idx: {"blue": coords} for idx, coords in enumerate(comps)}
+    marker_cells = []
+    for color in MARKER_COLORS:
+        for r, c in np.argwhere(left == color):
+            marker_cells.append((int(r), int(c), int(color)))
