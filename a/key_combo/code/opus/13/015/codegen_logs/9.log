+    sprite = odd_sprites[0]
+    sprite_box = bbox(sprite != bg)
+    assert sprite_box is not None, "anomalous sprite must be non-empty"
+    cropped = crop_bbox(sprite, sprite_box)
+    return _swap_two_colors(cropped, bg)
