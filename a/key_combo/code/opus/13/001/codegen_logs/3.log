+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    cells = {tuple(map(int, rc)) for rc in coords}
+    stack = [next(iter(cells))]
+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        r, c = cell
+        for dr, dc in DIR4:
+            nb = (r + dr, c + dc)
+            if nb in cells and nb not in seen:
+                stack.append(nb)
+    return len(seen) == len(cells)
+
+
+def _valid_vertical_axes(mask: np.ndarray) -> list[int]:
+    h, w = mask.shape
+    cells = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    valid = []
+    for axis2 in range(2 * w - 1):
+        reflected = set()
+        ok = True
+        for r, c in cells:
+            nc = axis2 - c
+            if not (0 <= nc < w):
+                ok = False
+                break
+            reflected.add((r, nc))
+        if ok and reflected == cells:
+            valid.append(axis2)
+    return valid
+
+
+def _valid_horizontal_axes(mask: np.ndarray) -> list[int]:
+    h, w = mask.shape
+    cells = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    valid = []
+    for axis2 in range(2 * h - 1):
+        reflected = set()
+        ok = True
+        for r, c in cells:
+            nr = axis2 - r
+            if not (0 <= nr < h):
+                ok = False
+                break
+            reflected.add((nr, c))
+        if ok and reflected == cells:
