+    grid_center = ((shape[0] - 1) / 2.0, (shape[1] - 1) / 2.0)
+    dr = center[0] - grid_center[0]
+    dc = center[1] - grid_center[1]
+    return (dr * dr + dc * dc, center[0], center[1])
