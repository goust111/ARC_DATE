+    coords = orange_comps[0]
+    r0, c0, r1, c1 = _bbox(coords)
+    assert r1 - r0 == 2 and c1 - c0 == 2, "reference pattern must occupy a 3x3 bbox"
+    pattern = np.zeros((3, 3), dtype=bool)
+    for r, c in coords:
+        pattern[int(r - r0), int(c - c0)] = True
