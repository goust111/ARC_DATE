+def _render_output(
+    base: np.ndarray, pattern: np.ndarray, records: list[dict[str, object]]
+) -> np.ndarray:
+    out = np.asarray(base, dtype=int).copy()
+    immutable = base != BG
+    ordered = sorted(
+        records,
+        key=lambda rec: _distance_key(rec["center"], base.shape),
