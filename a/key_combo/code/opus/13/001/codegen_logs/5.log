+    shape: tuple[int, int], pattern: np.ndarray, corner: str
+) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    h, w = shape
+    if corner == "tl":
+        r0, c0 = 0, 0
+    elif corner == "tr":
+        r0, c0 = 0, w - 3
+    elif corner == "bl":
+        r0, c0 = h - 3, 0
+    else:
+        r0, c0 = h - 3, w - 3
+    cells = {
+        (r0 + pr, c0 + pc)
+        for pr in range(3)
+        for pc in range(3)
+        if pattern[pr, pc]
