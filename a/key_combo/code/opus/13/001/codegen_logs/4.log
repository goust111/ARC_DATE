+    grid[row0 : row0 + rect_h, left_c0 : left_c0 + rect_w] = RECT_COLOR
+    grid[row0 : row0 + rect_h, right_c0 : right_c0 + rect_w] = RECT_COLOR
+    out = _expected_grid(grid, seq)
+    return grid, out
