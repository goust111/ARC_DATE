+def _axis_runs(g: np.ndarray, axis: int) -> tuple[bool, list[int]]:
+    colors = [int(color) for color in np.unique(g)]
+    color_means: dict[int, float] = {}
+    color_totals: dict[int, int] = {}
+    for color in colors:
