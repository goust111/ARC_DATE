+    part_cols = int(blueprint["part_cols"])
+    row_sizes = list(blueprint["row_sizes"])
+    col_sizes = list(blueprint["col_sizes"])
+    colors = np.asarray(blueprint["colors"], dtype=int)
+    region = np.zeros((sum(row_sizes), sum(col_sizes)), dtype=int)
