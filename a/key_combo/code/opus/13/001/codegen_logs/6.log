+def _split_lengths(total: int, parts: int, min_size: int = 2) -> list[int]:
+    lengths = [min_size] * parts
+    for _ in range(total - min_size * parts):
+        lengths[random.randrange(parts)] += 1
+    random.shuffle(lengths)
+    return lengths
