+        survivor_counts = set(blueprints[survivor_a]["counts"]) & set(blueprints[survivor_b]["counts"])
+        feasible_targets = []
+        for target in sorted(survivor_counts):
+            ok = True
+            for pos, blueprint in blueprints.items():
