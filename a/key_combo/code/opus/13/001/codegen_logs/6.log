+        want_diff_shapes = random.random() < 0.5
+
+        blueprints: dict[tuple[int, int], dict[str, object]] = {}
+        for rr in range(region_rows):
+            for cc in range(region_cols):
+                blueprints[(rr, cc)] = _make_region_blueprint(region_h, region_w)
+
