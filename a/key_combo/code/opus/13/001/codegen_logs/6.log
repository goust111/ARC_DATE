+    for r in range(part_rows):
+        for c in range(part_cols):
+            if not keep_mask[r, c]:
+                continue
+            r0 = row_starts[r]
+            c0 = col_starts[c]
+            region[r0 : r0 + row_sizes[r], c0 : c0 + col_sizes[c]] = int(colors[r, c])
