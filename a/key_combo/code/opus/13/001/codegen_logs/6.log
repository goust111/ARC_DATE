+    row_offsets: dict[int, int] = {}
+    cur = 0
+    for row_id in row_ids:
+        row_offsets[row_id] = cur
+        cur += row_heights[row_id] + GAP
+
+    col_offsets: dict[int, int] = {}
+    cur = 0
+    for col_id in col_ids:
+        col_offsets[col_id] = cur
+        cur += col_widths[col_id] + GAP
