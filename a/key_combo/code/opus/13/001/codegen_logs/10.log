+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+Coord = tuple[int, int]
+DIR4: tuple[Coord, ...] = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+BG = 0
+SOURCE = 1
+TRAIL = 2
+TOP = 3
+SEP = 5
+
+GEN_ATTEMPTS = 400
+PATH_ATTEMPTS = 160
