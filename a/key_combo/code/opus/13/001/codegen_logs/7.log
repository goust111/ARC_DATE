+    total_min = max(TOTAL_COUNT_RANGE[0], keep_count + 1)
+    total_max = min(TOTAL_COUNT_RANGE[1], keep_count + 4)
+    if total_min > total_max:
+        return None
+    total_count = rng.randint(total_min, total_max)
+    other_count = total_count - keep_count
