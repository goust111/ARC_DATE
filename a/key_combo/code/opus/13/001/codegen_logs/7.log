+        return None
+    r_a, r_b = rng.choice(pairs)
+    return (r_a, col), (r_b, col)
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    shape = (rng.choice(GRID_SIZES), rng.choice(GRID_SIZES))
+    mode = rng.choice(["lr", "tb"])
