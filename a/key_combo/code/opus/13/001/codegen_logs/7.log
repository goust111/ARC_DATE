+    kept_only[kr0 : kr1 + 1, kc0 : kc1 + 1] = True
+    blue_kept = components_mask((grid == BLUE) & kept_only)
+    if len(blue_kept) != keep_count:
+        return None
+    if not np.any(out == GREEN):
+        return None
+    if np.any((grid == MARKER) & (out == GREEN)):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
