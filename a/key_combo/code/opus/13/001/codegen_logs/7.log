+            direction,
+            source_block,
+            source_cells,
+            target_block,
+            rng,
+        )
+        if placed is None:
+            return None
+        cells, translated = placed
+        kept_components.append(cells)
+        source_cells |= cells
+        source_block |= _expanded(cells, shape)
+        target_cells |= translated
+        target_block |= _expanded(translated, shape)
