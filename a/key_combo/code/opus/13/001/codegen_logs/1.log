+    start_choices = [i for i, wt in enumerate(weights) if wt <= target_area]
+
+    for _ in range(SHAPE_RETRIES):
+        chosen = {random.choice(start_choices)}
+        area = sum(weights[i] for i in chosen)
+        while area < target_area:
