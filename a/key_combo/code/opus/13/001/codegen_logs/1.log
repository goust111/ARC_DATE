+def _mask_from_orbit_ids(h: int, w: int, orbits: list[list[tuple[int, int]]], chosen: set[int]) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    for idx in chosen:
+        for r, c in orbits[idx]:
