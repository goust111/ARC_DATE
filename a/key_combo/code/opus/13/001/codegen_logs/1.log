 113:     cavity = np.zeros((h, w), dtype=bool)
 114:     for ro, co in _CAVITY_OFFSETS:
 115:         cavity |= (dr == ro) & (dc == co)
 116:     grid[corner | cavity] = _EMPTY
 117:     return grid
