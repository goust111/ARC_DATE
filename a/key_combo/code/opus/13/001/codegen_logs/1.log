  45: ROW_MIN, ROW_MAX, COL_MIN, COL_MAX = 8, 16, 10, 12
  46: DIMENSION_OBJECT_FACTOR, DIMENSION_EXTRA = 2, 2
  47: BORDER_MARGIN, PLACEMENT_PADDING, PLACEMENT_CONNECTIVITY = 1, 2, 4
  48: 
  49: # Object count, object size, and foreground density.
  50: OBJECT_COUNT_MIN, OBJECT_COUNT_MAX, OBJECT_SIZE_MIN, OBJECT_SIZE_MAX = 2, 5, 2, 8
  51: DENSITY_MIN_NUM, DENSITY_MIN_DEN, DENSITY_MAX_NUM, DENSITY_MAX_DEN = 1, 10, 15, 100
  52: 
  53: # Blob growth shape bias.
  54: BLOB_BBOX_MAX, ADJACENCY_WEIGHT, COMPACTNESS_BONUS_BASE = 4, 3.0, 5
  55: THIN_BLOB_SIZE_THRESHOLD, THIN_BLOB_WEIGHT = 4, 0.12
  56: ORTHOGONAL_NEIGHBORS = ((1, 0), (-1, 0), (0, 1), (0, -1))
  57: 
  58: # Retry limit for full input generation.
