+                    0 <= nr < h
+                    and 0 <= nc < w
+                    and mask[nr, nc]
+                    for r, c in cells
+                    for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+                ):
+                    frontier.append(idx)
+            if not frontier:
