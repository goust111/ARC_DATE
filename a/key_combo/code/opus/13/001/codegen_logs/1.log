+def _valid_axes(visible: np.ndarray, unknown: np.ndarray) -> list[tuple[int, int, int]]:
+    h, w = visible.shape
+    coords = np.argwhere(visible)
+    if coords.size == 0:
+        return []
+    candidates: list[tuple[int, int, int]] = []
+    for x2 in range(2 * w - 1):
+        added = set()
+        matched = 0
+        ok = True
+        for r, c in coords:
+            mc = int(x2 - c)
+            if not (0 <= mc < w):
+                ok = False
+                break
+            if visible[r, mc]:
