+        if local_idx in winners:
+            color = int(np.max(cand["patch"][cand["patch"] != RED]))
+            expected[r0 : r1 + 1, c0 : c1 + 1] = color
+    if not np.array_equal(out, expected):
+        return None
+    return grid
