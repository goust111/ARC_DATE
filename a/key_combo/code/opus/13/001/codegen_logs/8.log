+    endpoint_nodes = [len(orbit_cells), len(orbit_cells) + 1]
+    node_costs = orbit_costs + [0, 0]
+    adjacency = [set() for _ in range(len(node_costs))]
+    endpoint_node_of = {endpoints[0]: endpoint_nodes[0], endpoints[1]: endpoint_nodes[1]}
