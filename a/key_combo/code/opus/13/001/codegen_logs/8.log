+    chosen: set[int] = set()
+
+    def collect(mask: int, node: int):
+        chosen.add(node)
+        info = parent[mask][node]
+        assert info is not None
+        kind = info[0]
+        if kind == "start":
+            return
+        if kind == "move":
+            collect(mask, info[1])
+            return
+        if kind == "merge":
+            collect(info[1], node)
+            collect(info[2], node)
+            return
+        raise AssertionError(f"unknown parent kind: {kind}")
