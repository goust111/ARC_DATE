  91: def main(grid: np.ndarray) -> np.ndarray:
  92:     """
  93:     Rotate each 2x2 block's four diagonal corner colors clockwise, then extend the rotated colors outward as diagonal rays.
  94: 
  95:     Input structure
  96:     - The background is the dominant color.
  97:     - One foreground color forms one or more solid 2x2 blocks.
  98:     - Each block has four non-background, non-block corner pixels diagonally adjacent to it.
  99: 
 100:     Rule
 101:     - Around every block, move the NW corner color to NE, NE to SE, SE to SW, and SW to NW.
 102:     - From each rotated corner, paint along the outward diagonal until the grid edge or another 2x2 block is reached.
 103:     - If a ray reaches a same-colored outgoing corner of another block that has its own visible continuation, stop the incoming ray at that junction.
 104: 
 105:     Key insight
 106:     - The 2x2 blocks are color rotators and ray blockers; the corner pixels are not independent dots but the four ports of each block.
 107:     """
 108:     g = np.asarray(grid, dtype=int)
 109:     assert g.ndim == 2
 110:     bg = int(get_bg(g))
 111:     block_color = _block_color(g, bg)
 112: 
 113:     rays: list[Ray] = []
 114:     h, w = g.shape
 115:     for r0, c0 in _blocks(g, block_color, bg):
 116:         corner_colors: dict[str, int] = {}
 117:         for corner, (dr, dc) in CORNER_OFFSETS.items():
 118:             r = r0 + dr
 119:             c = c0 + dc
 120:             assert 0 <= r < h and 0 <= c < w, "expected all four block corners in bounds"
 121:             color = int(g[r, c])
 122:             assert color != bg and color != block_color, "expected colored corner ports around each block"
 123:             corner_colors[corner] = color
 124: 
 125:         for corner, offset in CORNER_OFFSETS.items():
 126:             start = (r0 + offset[0], c0 + offset[1])
 127:             color = corner_colors[ROTATED_SOURCE[corner]]
 128:             path = _ray_path(g, start, DIAGONAL_DIRS[corner], block_color)
 129:             rays.append((start, color, path))
 130: 
 131:     starts_by_color: dict[int, set[tuple[int, int]]] = {}
 132:     path_len: dict[tuple[int, tuple[int, int]], int] = {}
 133:     for start, color, path in rays:
 134:         starts_by_color.setdefault(color, set()).add(start)
 135:         path_len[(color, start)] = len(path)
 136: 
 137:     planned: dict[tuple[int, int], int] = {}
 138:     for start, color, path in rays:
 139:         keep = len(path)
 140:         other_starts = starts_by_color[color] - {start}
 141:         for i, cell in enumerate(path):
 142:             if i == 0:
 143:                 continue
 144:             for nr, nc in neighbors4(*cell):
 145:                 other_start = (int(nr), int(nc))
 146:                 if other_start in other_starts and path_len[(color, other_start)] > 1:
 147:                     keep = i + 1
 148:                     break
 149:             if keep != len(path):
 150:                 break
 151: 
 152:         for cell in path[:keep]:
 153:             previous = planned.get(cell)
 154:             assert previous is None or previous == color, "conflicting rays must not overlap"
 155:             planned[cell] = color
 156: 
 157:     out = g.copy()
 158:     for (r, c), color in planned.items():
 159:         out[r, c] = color
 160:     return out
