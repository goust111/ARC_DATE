+                if not in_bounds(grid.shape, nr, nc):
+                    continue
+                other = (nr, nc)
+                if other in cell_to_orbit:
+                    j = cell_to_orbit[other]
+                    if j != idx:
+                        adjacency[idx].add(j)
+                        adjacency[j].add(idx)
+                elif other in endpoint_node_of:
+                    ep = endpoint_node_of[other]
+                    adjacency[idx].add(ep)
+                    adjacency[ep].add(idx)
