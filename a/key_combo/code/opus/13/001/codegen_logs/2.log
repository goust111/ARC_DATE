+
+    sep_row = maze.shape[0]
+    motif_h = random.randint(4, 5)
+    full = np.zeros((maze.shape[0] + 1 + motif_h, maze.shape[1]), dtype=int)
+    full[: maze.shape[0], :] = maze
+    full[sep_row, :] = WALL
+
+    try:
