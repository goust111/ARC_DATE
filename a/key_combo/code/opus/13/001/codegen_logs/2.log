0009: def _distances_from(sources: np.ndarray, passable: np.ndarray) -> np.ndarray:
0010:     h, w = passable.shape
0011:     dist = np.full((h, w), -1, dtype=int)
0012:     q: deque[tuple[int, int]] = deque()
0013:     for r, c in sources:
0014:         rr = int(r)
0015:         cc = int(c)
0016:         assert passable[rr, cc]
0017:         dist[rr, cc] = 0
0018:         q.append((rr, cc))
0019: 
0020:     while q:
0021:         r, c = q.popleft()
0022:         nd = int(dist[r, c]) + 1
0023:         for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
0024:             nr = r + dr
0025:             nc = c + dc
0026:             if 0 <= nr < h and 0 <= nc < w and passable[nr, nc] and dist[nr, nc] < 0:
0027:                 dist[nr, nc] = nd
0028:                 q.append((nr, nc))
0029:     return dist
