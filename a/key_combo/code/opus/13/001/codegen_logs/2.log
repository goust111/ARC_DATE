0032: def _framed_square_rooms(g: np.ndarray, wall: int, sizes: set[int]) -> list[tuple[int, int, int]]:
0033:     h, w = g.shape
0034:     rooms: list[tuple[int, int, int]] = []
0035:     for n in sorted(sizes):
0036:         assert n > 1
0037:         for r in range(h - n + 1):
0038:             for c in range(w - n + 1):
0039:                 if np.any(g[r : r + n, c : c + n] == wall):
0040:                     continue
0041: 
0042:                 side_wall_counts: list[int] = []
0043:                 if r > 0:
0044:                     side_wall_counts.append(int(np.count_nonzero(g[r - 1, c : c + n] == wall)))
0045:                 if r + n < h:
0046:                     side_wall_counts.append(int(np.count_nonzero(g[r + n, c : c + n] == wall)))
0047:                 if c > 0:
0048:                     side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c - 1] == wall)))
0049:                 if c + n < w:
0050:                     side_wall_counts.append(int(np.count_nonzero(g[r : r + n, c + n] == wall)))
0051: 
0052:                 if len(side_wall_counts) >= 3 and all(count >= n - 1 for count in side_wall_counts):
0053:                     rooms.append((r, c, n))
0054:     return rooms
