+        return None
+
+    try:
+        out = main(full)
+    except Exception:
+        return None
+    if out.ndim != 2 or max(out.shape) > 30:
+        return None
+    return full
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = generate_attempt()
+        if grid is not None:
