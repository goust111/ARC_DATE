0115:     def spans_contain(intervals_a: list[tuple[int, int]], intervals_b: list[tuple[int, int]], lo: int, hi: int) -> bool:
0116:         if not intervals_a or not intervals_b:
0117:             return False
0118:         a0 = min(start for start, _end in intervals_a)
0119:         a1 = max(end for _start, end in intervals_a)
0120:         b0 = min(start for start, _end in intervals_b)
0121:         b1 = max(end for _start, end in intervals_b)
0122:         return lo >= a0 and hi <= a1 and lo >= b0 and hi <= b1
