    col_pair_choices = [
        (a, b)
        for i, a in enumerate(col_pairs)
        for b in col_pairs[i + 1 :]
        if set(a).isdisjoint(b)
    ]
    rows = list(random.choice(row_pair_choices))
    cols = list(random.choice(col_pair_choices))
