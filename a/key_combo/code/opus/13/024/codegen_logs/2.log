    h_count = int(np.random.randint(GEN_MIN_LINES_PER_AXIS, GEN_MAX_LINES_PER_AXIS + 1))
    v_count = int(np.random.randint(GEN_MIN_LINES_PER_AXIS, GEN_MAX_LINES_PER_AXIS + 1))
