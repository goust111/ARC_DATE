    isolated_markers = [
        (int(r), int(c)) for r, c in np.argwhere(markers)
        if (int(r), int(c)) not in line_members
    ]
    if len(isolated_markers) != GEN_ISOLATED_MARKERS:
        return False

    return np.array_equal(main(inp), out)


