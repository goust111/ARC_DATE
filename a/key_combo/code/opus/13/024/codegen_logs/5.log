+def _neighbor_sum(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    padded = np.pad(mask.astype(int), 1)
+    total = np.zeros((h, w), dtype=int)
+    for dr in range(3):
+        for dc in range(3):
