+
+    if len(active) < 3 or len(inactive) < 1:
+        return None
+
+    for _ in range(50):
+        active_count = int(rng.integers(3, count))
+        inactive_count = count - active_count
+        plan = [True] * active_count + [False] * inactive_count
+        rng.shuffle(plan)
+        chosen: list[tuple[int, int, bool]] = []
+
+        def backtrack(step: int) -> bool:
+            if step == len(plan):
