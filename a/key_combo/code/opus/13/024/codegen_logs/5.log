+        top &= ~_smooth_blob(half, width, float(rng.uniform(0.08, 0.16)), rng)
+        bottom &= ~_smooth_blob(half, width, float(rng.uniform(0.08, 0.16)), rng)
+        top |= _smooth_blob(half, width, float(rng.uniform(0.09, 0.18)), rng)
+        bottom |= _smooth_blob(half, width, float(rng.uniform(0.09, 0.18)), rng)
+
+        top_density = float(top.mean())
+        bottom_density = float(bottom.mean())
+        overlap = int(np.count_nonzero(top & bottom))
+        top_only = int(np.count_nonzero(top & ~bottom))
+        bottom_only = int(np.count_nonzero(bottom & ~top))
+        xor_count = top_only + bottom_only
+        if not (0.30 <= top_density <= 0.50 and 0.30 <= bottom_density <= 0.50):
+            continue
+        if overlap < max(6, area // 10):
+            continue
+        if top_only < 4 or bottom_only < 4:
+            continue
+        if xor_count < max(10, area // 6):
+            continue
+        return top, bottom
+    return None
+
+
+def _blocks_conflict(a: tuple[int, int], b: tuple[int, int]) -> bool:
