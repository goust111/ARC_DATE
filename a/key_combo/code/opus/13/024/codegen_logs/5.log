+        chosen: list[tuple[int, int, bool, bool]] = []
+
+        def backtrack(start_idx: int, active_used: int, inactive_used: int) -> bool:
+            if len(chosen) == count:
+                return active_used == active_count and inactive_used == inactive_count
+            remaining_slots = count - len(chosen)
+            if len(columns) - start_idx < remaining_slots:
