+    rmax, cmax = coords.max(axis=0)
+    sub = mask[rmin : rmax + 1, cmin : cmax + 1].astype(int)
+    integral = sub.cumsum(axis=0).cumsum(axis=1)
+
+    best_area = 0
+    best: list[tuple[int, int, int, int]] = []
+    h, w = sub.shape
+    for r0 in range(h):
+        for c0 in range(w):
