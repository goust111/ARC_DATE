+def _rect_sum(integral: np.ndarray, r0: int, c0: int, r1: int, c1: int) -> int:
+    total = int(integral[r1, c1])
+    if r0 > 0:
+        total -= int(integral[r0 - 1, c1])
+    if c0 > 0:
+        total -= int(integral[r1, c0 - 1])
+    if r0 > 0 and c0 > 0:
+        total += int(integral[r0 - 1, c0 - 1])
+    return total
