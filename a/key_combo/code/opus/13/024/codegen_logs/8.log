+def _max_stem_length(h: int, w: int, axis_is_col: bool) -> int:
+    area = h * w
+    axis_len = w if axis_is_col else h
+    return min(8, area - axis_len - 1)
+
+
+def _center_choices(length: int) -> list[int]:
+    if length % 2 == 1:
+        return [length // 2]
+    return [length // 2 - 1, length // 2]
