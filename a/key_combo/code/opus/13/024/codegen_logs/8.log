+HORIZONTAL_BODY_OPTIONS = {
+    6: [(3, 2)],
+    8: [(2, 4), (4, 2)],
+    9: [(3, 3)],
+    12: [(3, 4), (4, 3)],
+    16: [(4, 4)],
+}
+
+VERTICAL_BODY_OPTIONS = {
+    6: [(2, 3)],
