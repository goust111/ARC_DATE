+                    if area < best_area:
+                        continue
+                    if _rect_sum(integral, r0, c0, r1, c1) != area:
+                        continue
+                    box = (int(rmin + r0), int(cmin + c0), int(rmin + r1), int(cmin + c1))
+                    if area > best_area:
+                        best_area = area
+                        best = [box]
+                    else:
+                        best.append(box)
