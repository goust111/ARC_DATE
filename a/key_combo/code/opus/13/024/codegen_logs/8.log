+
+def _assign_collision_axis_positions(specs: list[dict], axis_is_col: bool, sign: int, total: int, collision_count: int) -> bool:
+    gaps = [random.randint(1, 3) for _ in range(collision_count - 1)]
+
+    if sign > 0:
