+def _direction_spec(direction: str) -> tuple[bool, int]:
+    if direction == "right":
+        return True, 1
+    if direction == "left":
+        return True, -1
+    if direction == "down":
+        return False, 1
+    assert direction == "up"
+    return False, -1
