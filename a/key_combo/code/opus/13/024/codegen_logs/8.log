                bbox_canvas, patch, transparent=BACKGROUND_COLOR,
                border=PLACEMENT_BORDER, padding=PLACEMENT_PADDING,
            )
        except ValueError:
            return False
        paste(bbox_canvas, patch, r, c, transparent=BACKGROUND_COLOR)

