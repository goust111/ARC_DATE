0014: def main(input_grid):
0015:     """
0016:     Shoot green rays from both ends of a teal diagonal line and reflect them off the red rectangle.
0017: 
0018:     Input structure:
0019:     - The grid contains one short teal diagonal line on a black background.
0020:     - A single red rectangle or bar lies in the ray path.
0021:     - The scene may be rotated.
0022: 
0023:     Rule:
0024:     - Detect the teal line endpoints and the red rectangle.
0025:     - Draw green in both outward diagonal directions from the teal line.
0026:     - When a ray hits red, flip the appropriate direction component and keep drawing.
0027: 
0028:     Key insight:
0029:     - The teal line gives the initial ray direction, and the red object acts as a reflecting
0030:       obstacle for the green path.
0031:     """
0032:     # Plan:
0033:     # 1. Detect the objects
0034:     # 2. Determine the orientation of the teal line, and its endpoints
0035:     # 3. Shoot a green line outward until it hits the red rectangle
0036:     # 4. Reflect the green line off the red rectangle, continuing in green
0037: 
0038:     teal_line = detect_objects(input_grid, colors=[Color.TEAL], monochromatic=True, connectivity=8)
0039:     assert len(teal_line) == 1, "There should be exactly one teal line"
0040:     teal_line = list(teal_line)[0]
0041:     red_rectangle = detect_objects(input_grid, colors=[Color.RED], monochromatic=True, connectivity=8)
0042:     assert len(red_rectangle) == 1, "There should be exactly one red rectangle"
0043:     red_rectangle = list(red_rectangle)[0]
0044: 
0045:     output_grid = input_grid.copy()
0046: 
0047:     # To get the orientation of a line, find the endpoints and compare their x and y coordinates
0048:     x1, y1 = max( (r, c) for r, c in np.argwhere(teal_line == Color.TEAL) )
0049:     x2, y2 = min( (r, c) for r, c in np.argwhere(teal_line == Color.TEAL) )
0050:     direction12 = (int(np.sign(x2 - x1)), int(np.sign(y2 - y1)))
0051:     direction21 = (-direction12[0], -direction12[1])
0052: 
0053:     # Try both (direction, x2, y2) and (-direction, x1, y1) as starting points
0054:     for (dr,dc), start_r, start_c in [ (direction12, x2, y2), (direction21, x1, y1) ]:
0055:         start_r += dr
0056:         start_c += dc
0057:         # Loop, shooting lines off of red things, until we run out of the canvas
0058:         while 0 <= start_r < input_grid.shape[0] and 0 <= start_c < input_grid.shape[1]:
0059:             stop_r, stop_c = draw_line(output_grid, start_r, start_c, direction=(dr,dc), color=Color.GREEN, stop_at=[Color.RED])
0060: 
0061:             # reflection geometry depends on if we hit the red rectangle on our left/right/up/down
0062:             # did we hit the red rectangle on our right? 
0063:             if stop_r+1 < output_grid.shape[0] and output_grid[stop_r+1, stop_c] != Color.BLACK:
0064:                 dr = -dr
0065:             # did we hit the red rectangle on our left?
0066:             elif stop_r-1 >= 0 and output_grid[stop_r-1, stop_c] != Color.BLACK:
0067:                 dr = -dr
0068:             # did we hit the red rectangle on our bottom?
0069:             elif stop_c+1 < output_grid.shape[1] and output_grid[stop_r, stop_c+1] != Color.BLACK:
0070:                 dc = -dc
0071:             # did we hit the red rectangle on our top?
0072:             elif stop_c-1 >= 0 and output_grid[stop_r, stop_c-1] != Color.BLACK:
0073:                 dc = -dc
0074:             else:
0075:                 # didn't do any reflections, so stop
0076:                 break
0077: 
0078:             start_r, start_c = stop_r + dr, stop_c + dc
0079:     
0080:     return output_grid
