0038: def main(grid: np.ndarray) -> np.ndarray:
0039:     """
0040:     Summarize the large square-tile mosaic as a 3x3 mask colored by the sparse marker color.
0041: 
0042:     Input structure:
0043:     - The background is the dominant color.
0044:     - Exactly two foreground colors appear.
0045:     - One foreground color forms equal solid square tiles on a 3x3 lattice; the
0046:       other foreground color is sparse marker noise.
0047: 
0048:     Rule:
0049:     - Find the unique foreground color whose mask bbox divides into 3x3 equal
0050:       square regions, each either completely filled or empty.
0051:     - Output a 3x3 grid with the other foreground color at filled tile positions
0052:       and background elsewhere.
0053: 
0054:     Key insight:
0055:     - The noisy marker color is only the output paint color; the large tiled
0056:       object encodes the output pattern by which coarse lattice cells are filled.
0057:     """
0058:     g = np.asarray(grid, dtype=int)
0059:     assert g.ndim == 2, "expected a 2D grid"
0060: 
0061:     bg = get_bg(g)
0062:     foreground = colors_present(g, exclude={bg})
0063:     assert len(foreground) == 2, "expected exactly two foreground colors"
0064: 
0065:     candidates: list[tuple[int, np.ndarray]] = []
0066:     for color in foreground:
0067:         occ = _tile_occupancy(g == color)
0068:         if occ is not None:
0069:             candidates.append((int(color), occ))
0070: 
0071:     assert len(candidates) == 1, "expected exactly one color to form the 3x3 tile mosaic"
0072:     tile_color, occupancy = candidates[0]
0073:     marker_colors = [int(color) for color in foreground if int(color) != tile_color]
0074:     assert len(marker_colors) == 1, "expected the remaining foreground color to be the marker color"
0075: 
0076:     out = np.full((3, 3), int(bg), dtype=int)
0077:     out[occupancy] = marker_colors[0]
0078:     return out
