+                ok = False
+                break
+            patch[group != 0] = group[group != 0]
+        if not ok:
+            continue
+
+        out = main(grid)
+        assert out.shape == grid.shape
+        if np.array_equal(out, grid):
+            continue
+        return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(400):
+        grid = _gen_attempt(rng)
+        if grid is not None:
