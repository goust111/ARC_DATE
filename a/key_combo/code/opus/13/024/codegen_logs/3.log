+        parsed = _parse_body_and_stem(movers[0])
+        direction = parsed["direction"]
+        stem_len = int(parsed["stem_len"])
+        dr, dc = DIR_VECS[direction]
+        body = parsed["body"]
+        moved_body = shift_cells(body, dr, dc, stem_len)
