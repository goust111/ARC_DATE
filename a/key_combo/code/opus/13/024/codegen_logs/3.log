+
+
+def _build_group_local(color: int, rng: random.Random) -> np.ndarray | None:
+    for _ in range(200):
+        direction = rng.choice(DIR_NAMES)
+        stem_len = rng.randint(2, 5)
+        stop_offset = rng.randint(0, 1)
+
+        if direction in ("up", "down"):
+            body_h, body_w = 2, 3
