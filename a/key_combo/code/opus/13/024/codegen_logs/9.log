+    n_cols = int(rng.choice([3, 4]))
+    lattice_w = STRIDE * n_cols - 1
+    top = int(rng.integers(0, 6))
+    bottom = int(rng.integers(0, 7))
+    left = int(rng.integers(0, 6))
+    right = int(rng.integers(0, 7))
