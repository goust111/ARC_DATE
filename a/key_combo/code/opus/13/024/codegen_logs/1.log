    out, placements = placed
    inp = out.copy()
    _gen_hide_target_markers(inp, records, placements)
    if _gen_oracle_accepts(inp, out):
        return inp
    return None


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS):
