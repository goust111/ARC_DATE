spec:
  grid: 9x9
  background: 6 [observed]
  colors: 2 distinct foreground colors
  anchors:
    count: 2 (one per color)
    shape: solid 3x3 block
    placement: opposite corners at (0,0) and (6,6), one color each
  rays:
    definition: each loose pixel sits on a straight H/V/diagonal ray from an anchor-edge terminal cell outward
    terminals_per_anchor: 7 possible (3 along each cardinal face + 1 diagonal corner)
    rays_used: 3-6 of 7 terminals chosen per color
    pixels_per_ray: exactly 1 loose pixel
    distance: 1-5 cells from terminal (uniform within available range)
    types: horizontal, vertical, and/or diagonal; diagonal used 0-1 times per color [observed]
  constraints:
    no two foreground pixels (same or different color) share a cell
    loose pixels must not land on anchor cells of either color
  output:
    rule: pack each loose pixel inward to its terminal cell (adjacent to anchor)
    result: 3x3 anchor + 1 cell at each used terminal = connected shape within 4x4 corner bbox
    pixel count preserved per color

generation_strategy:
  approach: output-first
  steps:
    1. Pick 2 distinct non-bg colors and assign to corners (0,0) and (6,6).
    2. For each color, choose 3-6 of 7 terminal cells (3 cardinal-face + 1 diag).
       Packed output = anchor 3x3 + chosen terminals. Verify the two output regions
       (top-left 4x4 and bottom-right 4x4) don't conflict.
    3. For each terminal, pick a random distance 1-5 along the outward ray (must stay
       in bounds). Place the loose pixel there. Reject if cell already occupied.
    4. Fill remaining cells with background.
