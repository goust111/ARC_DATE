+def _raw_symmetry_flags(grid: np.ndarray, infos: list[dict[str, object]]) -> dict[int, bool]:
+    return {
+        int(info["color"]): _is_rot180_symmetric(_window(grid, info["center"]))
+        for info in infos
+    }
+
+
+def _compressed_symmetry_flags(
