+def _max_raw_distance(
+    center: tuple[int, int], step: tuple[int, int], shape: tuple[int, int]
+) -> int:
+    cr, cc = center
+    t = 0
+    while True:
+        nr = cr + (t + 1) * step[0]
+        nc = cc + (t + 1) * step[1]
+        if not _in_bounds(shape, nr, nc):
