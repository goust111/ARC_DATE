  "type": "move_along_path",
  "src": "red marker with a four-pixel pink trail",
  "path": "ray from the red marker away from the pink trail until the first non-background pixel",
  "trajectory": "ray itself is not painted; it selects the first hit pixel",
  "dst": "first border or obstacle pixel hit by the ray",
  "transform": "recolor the hit pixel to background; keep all other pixels unchanged"
}
</annotation>
<generation_spec>
