+    cr, cc = center
+    for wr in range(size):
+        for wc in range(size):
+            gr = cr + wr - radius
+            gc = cc + wc - radius
+            if _in_bounds(grid.shape, gr, gc):
+                out[wr, wc] = int(grid[gr, gc])
+    return out
