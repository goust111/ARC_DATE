+    dc = int(coord[1]) - int(center[1])
+    assert not (dr == 0 and dc == 0)
+    assert dr == 0 or dc == 0 or abs(dr) == abs(dc)
+    step = (_sign(dr), _sign(dc))
+    dist = max(abs(dr), abs(dc))
+    assert dist >= 2
+    return step, dist
