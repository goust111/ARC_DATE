+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+MAX_GENERATION_ATTEMPTS = 300
+REPEAT_CHOICES = {
+    3: (2, 3, 4),
+    4: (2, 3),
+    5: (2,),
+}
