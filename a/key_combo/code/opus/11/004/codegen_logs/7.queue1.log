+    outer_h = r1 - r0 + 1
+    outer_w = c1 - c0 + 1
+    assert outer_h >= 5 and outer_w >= 8, "frame too small"
+
+    expected_red = np.zeros_like(g, dtype=bool)
+    expected_red[r0, c0 : c1 + 1] = True
+    expected_red[r1, c0 : c1 + 1] = True
+    expected_red[r0 : r1 + 1, c0] = True
