+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+START_COLOR = 2
+CORRIDOR_COLORS = {(0, 0): 3, (0, 1): 4, (1, 0): 6, (1, 1): 9}
+MARKER_COLOR = 7
+TARGET_COLOR = 8
+BLOCK_SIZE = 2
+
+GRID_ROW_RANGE = (18, 28)
+GRID_COL_RANGE = (18, 29)
