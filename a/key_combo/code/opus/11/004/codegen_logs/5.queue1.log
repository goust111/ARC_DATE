+    inner_cells = [(r, c) for r in range(1, k - 1) for c in range(1, k - 1)]
+    discriminating = [(k - 1, c) for c in range(1, k - 1)] + [(r, k - 1) for r in range(1, k - 1)]
+
+    for _ in range(200):
