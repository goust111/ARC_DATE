+GEN_GRID_ROWS = (16, 24)
+GEN_GRID_COLS = (16, 24)
+GEN_RELATIONS = ("above", "below", "left", "right")
+GEN_MARGIN_RANGE = (1, 4)
+GEN_MAX_ATTEMPTS = 600
