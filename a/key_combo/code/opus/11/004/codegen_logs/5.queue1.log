+            rr = random.randint(lo, hi)
+            cc = random.randint(0, cols - palette_len)
+        elif relation == "below":
+            if rows < ph + margin + 1:
+                return None
+            pr = random.randint(0, rows - ph - margin - 1)
+            pc = random.randint(0, cols - pw)
+            lo, hi = pr + ph + margin, rows - 1
+            if lo > hi or cols < palette_len:
+                continue
+            rr = random.randint(lo, hi)
+            cc = random.randint(0, cols - palette_len)
