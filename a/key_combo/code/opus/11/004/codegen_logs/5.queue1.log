+def _wrong_prefix_output(mask: np.ndarray, palette: list[int]) -> np.ndarray:
+    k = int(mask.shape[0])
+    out = np.zeros((2 * k, 2 * k), dtype=int)
+    for tile_r in range(2):
+        for tile_c in range(2):
+            base_r = tile_r * k
+            base_c = tile_c * k
+            for r in range(k):
