+    candidates = [(k, s) for k in ALLOWED_K for s in ALLOWED_S if k * s == int(size)]
+    assert len(candidates) == 1, f"ambiguous expanded mask size: {size}"
+    return candidates[0]
+
+
+def _downsample_mask(grid: np.ndarray) -> np.ndarray:
+    box = _bbox(grid == GREY)
