+    r0, c0, r1, c1 = _bbox(comp)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    if height < 4 or width < 4:
+        return False
+    expected_area = 2 * height + 2 * width - 4
+    if len(comp) != expected_area:
+        return False
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if not np.all(patch[0, :] == FRAME):
+        return False
+    if not np.all(patch[-1, :] == FRAME):
+        return False
+    if not np.all(patch[:, 0] == FRAME):
+        return False
+    if not np.all(patch[:, -1] == FRAME):
+        return False
