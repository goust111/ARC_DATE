+                    stop_step = step_idx
+                    blockers = step_blockers
+                    events.append(
+                        {
+                            "anchor_idx": anchor_idx,
+                            "arm": arm_name,
+                            "step": step_idx,
+                            "blockers": step_blockers,
+                        }
+                    )
