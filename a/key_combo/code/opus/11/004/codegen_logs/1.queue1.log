+        return grid
+    return None
+
+
+def _gen_attempt() -> np.ndarray | None:
+    P = random.randint(3, 5)
+    n_anchors = random.randint(2, 4)
+    min_h = max(15, 2 * P + 6)
+    min_w = max(18, 3 * P + 6)
+    H = random.randint(min_h, min(30, min_h + 10))
+    W = random.randint(min_w, min(30, min_w + 10))
+    palette_start = random.randint(0, W - P)
