+    events = []
+    for anchor_idx, anchor in enumerate(anchors, start=1):
+        anchor_rec = {"anchor": anchor, "arms": {}}
+        for arm_name in ("up_right", "down_left"):
+            dirs = _arm_dirs(arm_name)
+            r, c = anchor
