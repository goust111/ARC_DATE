+
+
+BG = Color.BLACK
+ANCHOR = Color.GREY
+PALETTE_POOL = [Color.YELLOW, Color.ORANGE, Color.PINK, Color.MAROON, Color.GREEN]
+GEN_ATTEMPTS = 500
+PAIR_ATTEMPTS = 250
+EXTRA_ATTEMPTS = 150
