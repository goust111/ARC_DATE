+    assert blue_box is not None
+    r0, c0, r1, c1 = blue_box
+    assert (r1 - r0 + 1, c1 - c0 + 1) == (MASK_SIZE, MASK_SIZE)
+    assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == BLUE)
