spec:
  grid: odd square, side length 5-15
  background: single dominant color (always 8 in eval) [observed]
  markers:
    count: exactly 4, one per corner orientation (TL, TR, BL, BR)
    shape: 3-pixel L in a 2x2 bounding box (one cell of the 2x2 is empty)
    orientation: the missing-cell position encodes the corner (e.g. missing bottom-right -> top_left)
    colors: 3-4 distinct non-bg colors; one color MAY be reused for two markers
    placement: anywhere on grid; marker pixels must not overlap each other (bbox overlap OK)
  output:
    grid cleared to bg
    each corner gets an L-shaped border drawn in the marker color whose orientation matches
    arm_length: grid_side // 2 (includes the corner pixel)
    the four corner Ls together leave a 1-pixel-wide cross of bg at the grid center row/col

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid side N = random odd in [5, 15].
    2. Pick bg color (use 8 or any single color).
    3. Assign 4 corner colors from non-bg palette; allow one color to repeat for at most 2 corners.
    4. Build the output grid: fill with bg, then draw the four corner Ls with arm = N//2.
    5. Derive input: start from bg-filled grid of same size.
    6. For each corner, create its 3-pixel L marker (orientation matching the corner) and place it at a random position on the input grid, ensuring no pixel collision with previously placed markers.
```
