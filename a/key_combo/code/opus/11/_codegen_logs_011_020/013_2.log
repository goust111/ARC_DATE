+def _choose_area_set(n_objects: int) -> list[int]:
+    pool = []
+    for combo in combinations(range(9, 16), n_objects):
+        if 1 <= combo[-1] - combo[-2] <= 4:
+            pool.append(combo)
+    chosen = list(random.choice(pool))
+    prefix = chosen[:-1]
+    random.shuffle(prefix)
+    return prefix + [chosen[-1]]
+
