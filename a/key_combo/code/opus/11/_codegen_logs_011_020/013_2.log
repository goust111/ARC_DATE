+    corner_boxes = [
+        (1, height // 2 - 3, 1, width // 2 - 3),
+        (1, height // 2 - 3, width // 2 + 2, width - 2),
+        (height // 2 + 2, height - 2, 1, width // 2 - 3),
+        (height // 2 + 2, height - 2, width // 2 + 2, width - 2),
+    ]
+    random.shuffle(corner_boxes)
