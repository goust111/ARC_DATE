62: def _gen_blob(size: int, fg: int, bg: int) -> np.ndarray:
63:     target_size = int(size)
64:     coords = {(0, 0)}
65:     while len(coords) < target_size:
66:         candidates, weights = [], []
67:         for r, c in coords:
68:             for dr, dc in ORTHOGONAL_NEIGHBORS:
69:                 nr, nc = r + dr, c + dc
70:                 if (nr, nc) in coords:
71:                     continue
72:                 rs = [p[0] for p in coords] + [nr]
73:                 cs = [p[1] for p in coords] + [nc]
74:                 h = max(rs) - min(rs) + 1
75:                 w = max(cs) - min(cs) + 1
76:                 if h <= BLOB_BBOX_MAX and w <= BLOB_BBOX_MAX:
77:                     adj = sum((nr + ar, nc + ac) in coords for ar, ac in ORTHOGONAL_NEIGHBORS)
78:                     weight = 1.0 + ADJACENCY_WEIGHT * adj + max(0, COMPACTNESS_BONUS_BASE - max(h, w))
79:                     if target_size >= THIN_BLOB_SIZE_THRESHOLD and min(h, w) == 1:
80:                         weight *= THIN_BLOB_WEIGHT
81:                     candidates.append((nr, nc))
82:                     weights.append(weight)
83:         if not candidates:
84:             return np.full((1, 1), bg, dtype=int)
85:         coords.add(random.choices(candidates, weights=weights, k=1)[0])
86: 
87:     norm = np.array(list(coords), dtype=int)
88:     norm -= norm.min(axis=0)
89:     h, w = norm.max(axis=0) + 1
90:     patch = np.full((h, w), bg, dtype=int)
91:     patch[norm[:, 0], norm[:, 1]] = fg
92:     return patch
