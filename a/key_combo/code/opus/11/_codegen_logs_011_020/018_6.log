    inp = _render_input(rows, cols, bg, (outline, fill, marker), (outline_color, fill_color, marker_color))

    expected = np.full((rows, cols), bg, dtype=int)
    expected[contour] = marker_color
    if not np.array_equal(main(inp), expected):
        return None
    return inp

