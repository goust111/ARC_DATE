+
+def _paint_half(grid: np.ndarray, bar: dict, half: str, color: int) -> None:
+    mid = bar["r0"] + bar["h"] // 2
+    if half == "top":
+        grid[bar["r0"] : mid, bar["c"]] = color
+    else:
+        grid[mid : bar["r1"] + 1, bar["c"]] = color
