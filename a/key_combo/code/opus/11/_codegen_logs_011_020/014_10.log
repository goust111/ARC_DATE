    cells = int(h) * int(w)
    lo = max(SPRITE_AREA_MIN, math.ceil(SPRITE_FILL_MIN * cells))
    hi = min(SPRITE_AREA_MAX, math.floor(SPRITE_FILL_MAX * cells))
    return lo, hi


