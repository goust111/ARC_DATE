spec:
  grid: horizontal (3 x 3N) or vertical (3N x 3) strip of 3x3 tiles on black background
  tile_count: 3-5
  orientation: horizontal or vertical, roughly equal likelihood
  tiles:
    size: 3x3 each
    each_tile: exactly one non-black foreground color, with 1+ foreground pixels
    all_colors_distinct: true
    colors: chosen from non-black ARC palette (1-9)
  losers:
