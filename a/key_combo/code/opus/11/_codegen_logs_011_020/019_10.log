+        start = random.choice(cells)
+        path = [start]
+        seen = {start}
+
+        def dfs() -> bool:
+            if len(path) == target_len:
+                return True
+            moves = []
+            r, c = path[-1]
+            for nr, nc in _neighbors4(r, c):
