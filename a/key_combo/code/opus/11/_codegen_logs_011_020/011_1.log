+    h, w = boundary_mask.shape
+    exterior = np.zeros_like(boundary_mask, dtype=bool)
+    q = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not boundary_mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if not boundary_mask[r, c] and not exterior[r, c]:
+                exterior[r, c] = True
+                q.append((r, c))
+
