+                ok = False
+                break
+
+            choices = [2, 3]
+            if remaining >= 2:
+                if extra_budget_h - min_needed < 4:
+                    choices_h = [2]
+                else:
+                    choices_h = choices
+                if extra_budget_w - min_needed < 4:
+                    choices_w = [2]
+                else:
+                    choices_w = choices
