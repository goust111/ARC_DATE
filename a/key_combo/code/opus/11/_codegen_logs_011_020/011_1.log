+        for dr, dc in N4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not boundary_mask[nr, nc] and not exterior[nr, nc]:
+                exterior[nr, nc] = True
+                q.append((nr, nc))
+
+    return (~exterior) & (~boundary_mask)
