+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in N4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
