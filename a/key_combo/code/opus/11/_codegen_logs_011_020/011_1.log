+        if width >= 6 and ir0 - r0 >= 3:
+            safe_sides.append("top")
+        if width >= 6 and r1 - ir1 >= 3:
+            safe_sides.append("bottom")
+        if height >= 6 and ic0 - c0 >= 3:
+            safe_sides.append("left")
+        if height >= 6 and c1 - ic1 >= 3:
+            safe_sides.append("right")
+
