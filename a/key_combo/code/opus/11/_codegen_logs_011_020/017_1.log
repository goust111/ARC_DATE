+    "right": ((0, -3), (0, -2), (0, -1), (0, 0), (-1, -2), (1, -2)),
+    "left": ((0, 0), (0, 1), (0, 2), (0, 3), (-1, 2), (1, 2)),
+    "down": ((-3, 0), (-2, 0), (-1, 0), (0, 0), (-2, -1), (-2, 1)),
+    "up": ((0, 0), (1, 0), (2, 0), (3, 0), (2, -1), (2, 1)),
+}
+DIR_STEP = {
+    "right": (0, 1),
+    "left": (0, -1),
+    "down": (1, 0),
+    "up": (-1, 0),
