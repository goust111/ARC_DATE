+    bar_c = long_cols[0]
+    cross_r = cross_rows[0]
+    line_rows = sorted(r for r, c in pts if c == bar_c)
+    cross_cs = sorted(c for r, c in pts if r == cross_r)
+    assert line_rows == list(range(line_rows[0], line_rows[0] + 4))
+    assert cross_cs == [bar_c - 1, bar_c, bar_c + 1]
