+        for tip_r in range(tip_r_min, tip_r_max + 1):
+            for tip_c in range(tip_c_min, tip_c_max + 1):
+                arrow_cells = {(tip_r + dr, tip_c + dc) for dr, dc in rels}
+                ray_cells: list[tuple[int, int]] = []
+                for step in range(room["area"]):
