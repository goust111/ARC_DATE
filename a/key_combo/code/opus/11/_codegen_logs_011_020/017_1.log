+        right_dist = line_cols[-1] - cross_c
+        assert {left_dist, right_dist} == {1, 2}
+        if left_dist < right_dist:
+            return {"color": color, "tip": (bar_r, line_cols[-1]), "dir": (0, 1), "coords": pts}
