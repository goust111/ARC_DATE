+        length = region_sizes[region_id]
+        tip_r, tip_c = arrow["tip"]
+        dr, dc = arrow["dir"]
+        for step in range(length):
+            rr = tip_r + dr * step
+            cc = tip_c + dc * step
+            if not _in_bounds(g.shape, rr, cc):
