+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _components_mask(mask: np.ndarray) -> tuple[np.ndarray, list[list[tuple[int, int]]]]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    components: list[list[tuple[int, int]]] = []
+    current = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            current += 1
+            labels[r, c] = current
+            queue = deque([(r, c)])
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = current
+                        queue.append((nr, nc))
+            components.append(coords)
+    return labels, components
+
+
+def _exterior_background(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    queue: deque[tuple[int, int]] = deque()
+
+    def add(r: int, c: int) -> None:
+        if grid[r, c] == BG and not exterior[r, c]:
+            exterior[r, c] = True
+            queue.append((r, c))
+
+    for r in range(h):
+        add(r, 0)
+        add(r, w - 1)
+    for c in range(w):
+        add(0, c)
+        add(h - 1, c)
+
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if _in_bounds(grid.shape, nr, nc):
+                add(nr, nc)
