+    down_dist = line_rows[-1] - cross_r
+    assert {up_dist, down_dist} == {1, 2}
+    if up_dist < down_dist:
+        return {"color": color, "tip": (line_rows[-1], bar_c), "dir": (1, 0), "coords": pts}
