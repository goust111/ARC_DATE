+
+
+def _room_bbox_cells(room: dict) -> set[tuple[int, int]]:
+    return {
+        (r, c)
+        for r in range(room["top"], room["top"] + room["outer_h"])
+        for c in range(room["left"], room["left"] + room["outer_w"])
+    }
+
+
+def _inside_bbox(cell: tuple[int, int], room: dict) -> bool:
