+    bottom_band_h = max((sizes[slot][0] + 2 for slot in bottom_slots), default=0)
+    left_band_w = max((sizes[slot][1] + 2 for slot in left_slots), default=0)
+    right_band_w = max((sizes[slot][1] + 2 for slot in right_slots), default=0)
+
