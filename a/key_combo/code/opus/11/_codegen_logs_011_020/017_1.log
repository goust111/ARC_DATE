+        band_c0, band_c1 = left_band if slot.endswith("L") else right_band
+        max_r_jitter = (band_r1 - band_r0 + 1) - outer_h
+        max_c_jitter = (band_c1 - band_c0 + 1) - outer_w
+        if max_r_jitter < 0 or max_c_jitter < 0:
+            return None
