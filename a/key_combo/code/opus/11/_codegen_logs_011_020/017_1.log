+
+    top_band = (margin_top, margin_top + top_band_h - 1)
+    bottom_band = (margin_top + top_band_h + gap_row, margin_top + top_band_h + gap_row + bottom_band_h - 1)
+    left_band = (margin_left, margin_left + left_band_w - 1)
