+        return random.choice((("TL", "BR"), ("TR", "BL")))
+    if count == 3:
+        omitted = random.choice(SLOTS)
+        return tuple(slot for slot in SLOTS if slot != omitted)
+    return SLOTS
+
+
+def _layout_rooms() -> list[dict] | None:
