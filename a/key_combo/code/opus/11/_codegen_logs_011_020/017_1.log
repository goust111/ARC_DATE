+    bottom = top + room["outer_h"] - 1
+    right = left + room["outer_w"] - 1
+    grid[top, left : right + 1] = WALL
+    grid[bottom, left : right + 1] = WALL
+    grid[top : bottom + 1, left] = WALL
+    grid[top : bottom + 1, right] = WALL
