+    chosen = _select_candidates(rooms, room_candidates, require_non_truncated=require_non_truncated)
+    if chosen is None:
+        return None
+
+    by_index = {entry["room_index"]: entry["candidate"] for entry in chosen}
+    grid = np.full((height, width), BG, dtype=int)
