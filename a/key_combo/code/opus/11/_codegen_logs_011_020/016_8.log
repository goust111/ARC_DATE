  "type": "transform_in_place",
  "src": "top-anchored one-pixel grey vertical bar on black background",
  "transform": "preserve the bar; in each column d to its left fill teal downward for bar_height+2*d cells, and in each column d to its right fill pink downward for each positive bar_height-2*d cells, clipped to the grid"
}
</annotation>
