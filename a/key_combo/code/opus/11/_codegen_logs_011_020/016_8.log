}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 10-20 rows x 17-27 cols; black background with green rectangles and red pixels
  colors: input uses BLACK, GREEN, RED; output adds BLUE
  green_rectangles:
    count: 2-3 solid-filled green rectangles
    dimensions: 4-14 rows x 4-12 cols each
    fill: every cell inside bbox is GREEN or RED (no black holes)
    non_overlapping: bounding boxes separated by manhattan gap >= 2
    edge_touch: may touch grid boundary [observed]
  active_markers:
    definition: red pixels located inside a green rectangle's bbox
    count_per_rect: 1-7 (every rectangle has >= 1)
    total: 4-18 across all rectangles
    adjacency: pairs may be 8-adjacent (Chebyshev dist 1); solver preserves both as red
  distractor_red:
    definition: red pixels outside all green bboxes
    count: 6-13
    placement: manhattan distance 1-5 from nearest green bbox
    some pairs may be 8-adjacent [observed]
  transform:
    rule: for each active marker, paint its 8-neighborhood blue; active marker centers stay red
    overlap: if two active markers are 8-adjacent, each center stays red (not overwritten to blue)
    distractors: unchanged unless in an active marker's 8-neighborhood (then overwritten to blue)

generation_strategy:
  approach: direct construction (input-first); constraints are straightforward to satisfy
  steps:
