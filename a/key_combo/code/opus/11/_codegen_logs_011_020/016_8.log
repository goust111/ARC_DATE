# Canvas and fixed selector geometry.
_GEN_H = 15
_GEN_W = 15
_GEN_SHAPE = (_GEN_H, _GEN_W)
_GEN_BG = 0
_GEN_COLORS = tuple(range(1, 10))
_GEN_BRACKET_COLOR = 5
_GEN_BRACKET_SIZE = 4
_GEN_BRACKET_EDGE = _GEN_BRACKET_SIZE - 1
_GEN_MARKER_POS = (1, 1)
