    anchored: top edge (row 0), contiguous downward
    height: 4-7 cells
    column: 2-4 (at least 1 col on each side)
  transform:
    preserve: grey bar unchanged
    left_fill: for each column d=1..bar_col, fill teal from top for min(grid_height, bar_height + 2*d) cells
    right_fill: for each column d=1..cols_right, fill pink from top for bar_height - 2*d cells; stop when non-positive
