import random, numpy as np
from collections import deque, defaultdict


def init_dir(H,W,r,c):
    if r==0: dr=1
    elif r==H-1: dr=-1
    else: dr=1 if r < H//2 else -1
    if c==0: dc=1
    elif c==W-1: dc=-1
    else: dc=1 if c < W//2 else -1
    return dr,dc


def simulate(grid):
    H,W=grid.shape
    pos=np.argwhere(grid==1)
    r,c=map(int,pos[0])
    dr,dc=init_dir(H,W,r,c)
    path=[]
    seen_states=set()
    steps=0
    while 0<=r<H and 0<=c<W:
        path.append((r,c))
        state=(r,c,dr,dc)
        if state in seen_states:
            return None
        seen_states.add(state)
        nr,nc=r+dr,c+dc
        if nr<0 or nr>=H:
            break
        if nc<0 or nc>=W:
            dc=-dc
            nc=c+dc
        if grid[nr,nc]==2:
            # enter wall cell, then flip horizontal for subsequent steps
            r,c=nr,nc
            dc=-dc
        else:
            r,c=nr,nc
        steps+=1
        if steps>1000:
            return None
    return path


def regions_graph(grid,path):
    H,W=grid.shape
    sep=np.zeros((H,W),bool)
    for r,c in path: sep[r,c]=True
    sep |= (grid==2)
    black=(grid==0)
    lab=np.zeros((H,W),int)
    rid=0
    for r in range(H):
        for c in range(W):
            if black[r,c] and lab[r,c]==0:
                rid+=1
                dq=deque([(r,c)])
                lab[r,c]=rid
                while dq:
                    x,y=dq.popleft()
                    for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                        nx,ny=x+dx,y+dy
                        if 0<=nx<H and 0<=ny<W and black[nx,ny] and lab[nx,ny]==0:
                            lab[nx,ny]=rid; dq.append((nx,ny))
    graph=defaultdict(set)
    for r in range(H):
        for c in range(W):
            if not sep[r,c]: continue
            adj=set()
            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                nx,ny=r+dx,c+dy
                if 0<=nx<H and 0<=ny<W and lab[nx,ny]>0:
                    adj.add(lab[nx,ny])
            adj=list(adj)
            for i,a in enumerate(adj):
                for b in adj[i+1:]:
                    graph[a].add(b); graph[b].add(a)
    return rid,lab,graph


def bipartite(graph,start,n):
    color={start:0}
    dq=deque([start])
    while dq:
        a=dq.popleft()
        for b in graph[a]:
            cb=1-color[a]
            if b in color:
                if color[b]"'!=cb: return False,None
            else:
                color[b]=cb; dq.append(b)
    return len(color)==n,color


def rand_wall(H,W,L):
    # simple orth path, interior start, avoid border mostly but can touch
    for _ in range(100):
        r=random.randrange(1,H-1); c=random.randrange(1,W-1)
        cells=[(r,c)]; used={(r,c)}; d=random.choice([(1,0),(-1,0),(0,1),(0,-1)])
        turns=0
        while len(cells)<L:
            if random.random()<0.3:
                opts=[x for x in [(1,0),(-1,0),(0,1),(0,-1)] if x!=d and x!=(-d[0],-d[1])]
                random.shuffle(opts)
                for nd in opts:
                    nr,nc=cells[-1][0]+nd[0],cells[-1][1]+nd[1]
                    if 0<=nr<H and 0<=nc<W and (nr,nc) not in used:
                        d=nd; turns+=1; break
            nr,nc=cells[-1][0]+d[0],cells[-1][1]+d[1]
            if not(0<=nr<H and 0<=nc<W) or (nr,nc) in used:
                opts=[x for x in [(1,0),(-1,0),(0,1),(0,-1)] if x!=(-d[0],-d[1])]
                random.shuffle(opts)
                ok=False
                for nd in opts:
                    nr,nc=cells[-1][0]+nd[0],cells[-1][1]+nd[1]
                    if 0<=nr<H and 0<=nc<W and (nr,nc) not in used:
                        d=nd; turns+=1; ok=True; break
                if not ok: break
                nr,nc=cells[-1][0]+d[0],cells[-1][1]+d[1]
            cells.append((nr,nc)); used.add((nr,nc))
        if len(cells)==L:
            return cells
    return None

