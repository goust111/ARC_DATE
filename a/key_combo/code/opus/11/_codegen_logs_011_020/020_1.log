from __future__ import annotations
import random, hashlib
from collections import defaultdict, deque
import numpy as np

BLACK, BLUE, RED, GREEN, GREY = 0,1,2,3,5


def in_bounds(shape,r,c):
    H,W=shape
    return 0<=r<H and 0<=c<W


def neighbors4(r,c):
    yield r-1,c; yield r+1,c; yield r,c-1; yield r,c+1


def inside_direction(H,W,r,c):
    if r==0: dr=1
    elif r==H-1: dr=-1
    else: dr=1 if 2*r < H-1 else -1
    if c==0: dc=1
    elif c==W-1: dc=-1
    else: dc=1 if 2*c < W-1 else -1
    return dr,dc


def simulate_path(grid):
    H,W=grid.shape
    pts=np.argwhere(grid==BLUE)
    r,c=map(int,pts[0])
    dr,dc=inside_direction(H,W,r,c)
    path=[]; seen=set(); wh=bh=0
    while 0<=r<H and 0<=c<W:
        path.append((r,c))
        st=(r,c,dr,dc)
        if st in seen:
            return None
        seen.add(st)
        nr,nc=r+dr,c+dc
        if nr<0 or nr>=H:
            break
        if nc<0 or nc>=W:
            bh+=1
            dc=-dc
            nc=c+dc
        if grid[nr,nc]==RED:
            wh+=1
            r,c=nr,nc
            dc=-dc
        else:
            r,c=nr,nc
        if len(path)>H*W*4:
            return None
    return path,wh,bh


def label_regions(grid,path):
    H,W=grid.shape
    sep=np.zeros((H,W),bool)
    for r,c in path: sep[r,c]=True
    sep |= (grid==RED)
    black=(grid==BLACK)
    lab=np.zeros((H,W),int); rid=0
    for r in range(H):
        for c in range(W):
            if black[r,c] and lab[r,c]==0:
                rid+=1
                dq=deque([(r,c)])
                lab[r,c]=rid
                while dq:
                    x,y=dq.popleft()
                    for nx,ny in neighbors4(x,y):
                        if in_bounds((H,W),nx,ny) and black[nx,ny] and lab[nx,ny]==0:
                            lab[nx,ny]=rid; dq.append((nx,ny))
    graph=defaultdict(set)
    for r in range(H):
        for c in range(W):
            if not sep[r,c]:
                continue
            adj=[]
            seen=set()
            for nr,nc in neighbors4(r,c):
                if in_bounds((H,W),nr,nc):
                    reg=int(lab[nr,nc])
                    if reg>0 and reg not in seen:
                        seen.add(reg); adj.append(reg)
            for i,a in enumerate(adj):
                for b in adj[i+1:]:
                    graph[a].add(b); graph[b].add(a)
    return lab,rid,graph,sep


def choose_start_region(labels):
    H,W=labels.shape
    if labels[H-1,0]>0:
        return int(labels[H-1,0])
    for r in range(H-1,-1,-1):
        for c in range(W):
            if labels[r,c]>0:
                return int(labels[r,c])
    return 0


def parity_map(labels,n_regions,graph):
    colors={}
    start=choose_start_region(labels)
    if start:
        colors[start]=0
        dq=deque([start])
        while dq:
            x=dq.popleft()
            for y in graph.get(x,()):
                cy=1-colors[x]
                if y in colors:
                    if colors[y]"'!=cy:
                        return None
                else:
                    colors[y]=cy; dq.append(y)
    for rid in range(1,n_regions+1):
        if rid in colors: continue
        colors[rid]=0
        dq=deque([rid])
        while dq:
            x=dq.popleft()
            for y in graph.get(x,()):
                cy=1-colors[x]
                if y in colors:
                    if colors[y]!=cy:
                        return None
                else:
                    colors[y]=cy; dq.append(y)
    return colors


def main(grid):
    g=np.array(grid,dtype=int)
    out=g.copy()
    sim=simulate_path(g)
    assert sim is not None
    path,_,_=sim
    labels,n_regions,graph,_=label_regions(g,path)
    par=parity_map(labels,n_regions,graph)
    assert par is not None
    out[g==BLACK]=BLACK
    for rid,val in par.items():
        out[labels==rid]=GREY if val==0 else GREEN
    for r,c in path:
        if g[r,c]!=RED:
            out[r,c]=BLUE
    out[g==RED]=RED
    return out


def border_start(H,W,mode):
    if mode=='"'tb':
        edge=random.choice(['top','bottom'])
        if edge=='top': return 0, random.randint(1,W-2)
        return H-1, random.randint(1,W-1)
    edge=random.choice(['left','right'])
    if edge=='left': return random.randint(0,H-2), 0
    return random.randint(0,H-1), W-1


def straight_candidates(H,W,p,pathset):
    r,c=p
    for ori in random.sample(['h','v'],2):
        dirs=[(0,1),(0,-1)] if ori=='h' else [(1,0),(-1,0)]
        arms=[]
        for dr,dc in dirs:
            pts=[]; rr,cc=r,c
            while True:
