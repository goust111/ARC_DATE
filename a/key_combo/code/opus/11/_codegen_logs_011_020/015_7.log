    sparse=[d for d,k in counts.items() if k==1 and pre[d]>0 and surv[d]==0]
    bad_sparse=[d for d,k in counts.items() if k==1 and surv[d]>0]
    return counts,dense,sparse,bad_sparse,surv,pre

