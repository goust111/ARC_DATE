import numpy as np, random, collections

BASE = [(0,0),(0,1),(1,0),(2,2),(3,1),(3,2)]

def transform(points, k):
    pts = points
    h = max(r for r,c in pts)+1
    w = max(c for r,c in pts)+1
    if k == 0:
        out = pts
    elif k == 1:
        out = [(c, h-1-r) for r,c in pts]
    elif k == 2:
        out = [(h-1-r, w-1-c) for r,c in pts]
    elif k == 3:
        out = [(w-1-c, r) for r,c in pts]
    elif k == 4:
        out = [(r, w-1-c) for r,c in pts]
    elif k == 5:
        out = [(w-1-c, h-1-r) for r,c in pts]  # reflect+rot90 variant
    elif k == 6:
        out = [(h-1-r, c) for r,c in pts]
    else:
        out = [(c, r) for r,c in pts]
    mr = min(r for r,c in out); mc = min(c for r,c in out)
    out = sorted((r-mr, c-mc) for r,c in out)
    return out

def metrics(g):
    H,W=g.shape
    counts=collections.Counter(r-c for r,c in np.argwhere(g"'!=0))
    selected=set(counts)
    surv=collections.Counter(); pre=collections.Counter()
    for r in range(H):
        for c in range(W):
            d=r-c
            if g[r,c]==0 and d in selected:
                pre[d]+=1
                tl = r>0 and c>0 and g[r-1,c]!=0 and g[r,c-1]!=0
                br = r+1<H and c+1<W and g[r+1,c]!=0 and g[r,c+1]!=0
                if tl or br:
