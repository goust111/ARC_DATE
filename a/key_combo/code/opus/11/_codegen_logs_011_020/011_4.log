+    ordered_dirs = [tail_dir, LEFT_TURN[tail_dir], RIGHT_TURN[tail_dir], OPPOSITE[tail_dir]]
+    candidates: list[tuple[int, int]] = []
+    for dr, dc in ordered_dirs:
+        pos = (er + dr, ec + dc)
+        if pos in forbidden:
+            continue
+        candidates.append(pos)
+    return candidates
