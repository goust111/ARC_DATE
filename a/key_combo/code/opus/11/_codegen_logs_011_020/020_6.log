+        if all(key not in prototype_signatures for key in _all_transform_keys(mask)):
+            return mask
+    raise RuntimeError("failed to generate distractor")
+
+
+def _extension_rect(
+    top: tuple[int, int],
+    mask: np.ndarray,
+    direction: str,
+) -> tuple[int, int, int, int]:
