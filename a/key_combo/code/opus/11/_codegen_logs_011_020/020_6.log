+    if direction == "left":
+        return r0, c0 - w, r0 + h - 1, c0 - 1
+    raise ValueError(f"unknown direction: {direction}")
+
+
+def _fits_rect(rect: tuple[int, int, int, int], h: int, w: int) -> bool:
+    r0, c0, r1, c1 = rect
+    return 0 <= r0 <= r1 < h and 0 <= c0 <= c1 < w
+
+
+def _place_object(
