            )
            if weight:
                choices.append(nxt)
                weights.append(weight)
        nxt = _gen_weighted_choice(choices, weights)
        offsets.append(nxt)
        pos += 1
        last = nxt
        score_left -= abs(nxt)
        pos_count += int(nxt > 0)
        neg_count += int(nxt < 0)
    return np.array(offsets, dtype=int)


