+        return None
+    cavity_w = random.randint(2 * band_count, cavity_w_max)
+
+    return band_count, upper_h, width, cavity_h, cavity_w
+
+
+def _build_example() -> np.ndarray | None:
+    dims = _choose_dimensions()
