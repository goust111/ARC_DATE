+    shape: tuple[int, int],
+    markers: list[tuple[int, int, int]],
+    *,
+    require_crossing: bool,
+) -> bool:
+    if not _pairwise_spacing_ok(markers):
+        return False
+    if not _every_marker_has_target(markers):
+        return False
+    if _has_crossing(shape, markers) != require_crossing:
+        return False
+
