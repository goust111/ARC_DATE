+    H, W = shape
+    candidates: list[tuple[int, int, int]] = []
+    for tr, tc, _target_color in markers:
+        for offset in (-1, 0, 1):
+            for dist in range(5, max(H, W)):
+                extras = (
+                    (tr - dist, tc + offset, 3),
+                    (tr + dist, tc + offset, 1),
+                    (tr + offset, tc - dist, 2),
+                    (tr + offset, tc + dist, 4),
+                )
+                for candidate in extras:
