+        right_r = mid_r + rng.choice((-1, 0, 1))
+        bottom_c = mid_c + rng.choice((-1, 0, 1))
+        if not _in_bounds((H, W), right_r, right_c):
+            continue
+        if not _in_bounds((H, W), bottom_r, bottom_c):
+            continue
+
+        markers = [
+            (mid_r, left_c, 2),
+            (right_r, right_c, 4),
+            (top_r, mid_c, 3),
+            (bottom_r, bottom_c, 1),
+        ]
+        if with_extra:
