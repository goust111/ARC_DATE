+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+HALO = 5
+DIR_BY_COLOR = {
+    1: (-1, 0),  # blue -> up
+    2: (0, 1),   # red -> right
+    3: (1, 0),   # green -> down
+    4: (0, -1),  # yellow -> left
