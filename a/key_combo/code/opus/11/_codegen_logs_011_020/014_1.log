+        bottom_r = rng.randint(max(top_r + 6, H - 4), H - 1)
+        if right_c - left_c < 6 or bottom_r - top_r < 6:
+            continue
+
+        mid_r = rng.randint(top_r + 3, bottom_r - 3)
+        mid_c = rng.randint(left_c + 3, right_c - 3)
