            candidates.append((row, col, inp_r, inp_c))

        if len(candidates) < count:
            return None

        rng.shuffle(candidates)
        for out_r, out_c, inp_r, inp_c in candidates[:count]:
            occupied_out.add((out_r, out_c))
            occupied_inp.add((inp_r, inp_c))
