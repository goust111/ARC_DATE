+def _directions(grid: np.ndarray) -> dict[int, tuple[int, int, str]]:
+    top = _solid_color(grid[0, 1:-1])
+    bottom = _solid_color(grid[-1, 1:-1])
+    left = _solid_color(grid[1:-1, 0])
+    right = _solid_color(grid[1:-1, -1])
