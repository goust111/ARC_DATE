  "path": "one orthogonal step toward the same-colored frame side",
  "trajectory": "translate each pixel one cell; pixels already adjacent to their matching side stay in place",
  "transform": "keep the rectangular frame and all non-side-colored interior pixels unchanged"
}
</annotation>
<generation_spec>
