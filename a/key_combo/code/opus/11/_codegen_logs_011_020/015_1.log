+
+
+def _ray_canvas(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    directions = _directions(g)
+    out = np.zeros_like(g)
+
+    for wanted_orientation in ("horizontal", "vertical"):
+        for r in range(1, h - 1):
