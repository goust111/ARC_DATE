+    while True:
+        patterns: list[list[tuple[str, int, int]]] = []
+        counts = [rng.randint(1, 2) for _ in range(SQUARE_COUNT)]
+        if len(set(counts)) == 1:
+            counts[rng.randrange(SQUARE_COUNT)] = 3 - counts[0]
