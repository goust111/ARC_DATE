+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not visited[nr, nc] and grid[nr, nc] == GREY:
+                        visited[nr, nc] = True
+                        queue.append((nr, nc))
