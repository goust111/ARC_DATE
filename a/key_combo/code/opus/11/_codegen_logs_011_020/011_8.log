+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            if len(coords) == 9 and r1 - r0 == 2 and c1 - c0 == 2:
+                if np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == GREY):
+                    squares.append((r0, c0, r1, c1))
