            if mask[r][c] and (r,c) not in seen:
                stack=[(r,c)]; seen.add((r,c)); cur=[]
                while stack:
                    x,y=stack.pop(); cur.append((x,y))
                    for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
