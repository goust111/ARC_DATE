GRID_HEIGHT_RANGE, GRID_WIDTH_RANGE = (17, 20), (18, 20)
MARKER_ROW_RANGE, GAP_RANGE, LEGEND_SPACING_RANGE = (0, 1), (2, 4), (4, 5)
LEGEND_ENTRY_SPAN = 3

