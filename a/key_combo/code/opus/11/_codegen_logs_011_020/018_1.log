+
+def _choose_dirs(rng: random.Random, n: int) -> list[str]:
+    mode = rng.random()
+    if mode < 0.22:
+        return ["R"] * (n - 1)
+    if mode < 0.44:
+        return ["D"] * (n - 1)
+    dirs = [rng.choice(["R", "D"]) for _ in range(n - 1)]
+    if len(set(dirs)) == 1:
+        dirs[rng.randrange(n - 1)] = "D" if dirs[0] == "R" else "R"
+    return dirs
