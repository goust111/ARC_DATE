+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _extract_frames(grid: np.ndarray) -> list[dict]:
+    mask = np.isin(grid, (GREY, ORANGE))
+    frames = []
+    for coords in _components(mask):
+        r0, c0, r1, c1 = _bbox(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
