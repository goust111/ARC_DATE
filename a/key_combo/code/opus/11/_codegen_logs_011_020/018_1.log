+def _draw_frame(grid: np.ndarray, box: tuple[int, int, int, int], ports: dict[str, int]) -> None:
+    r, c, h, w = box
+    grid[r, c : c + w] = GREY
+    grid[r + h - 1, c : c + w] = GREY
+    grid[r : r + h, c] = GREY
+    grid[r : r + h, c + w - 1] = GREY
+    for side, offset in ports.items():
