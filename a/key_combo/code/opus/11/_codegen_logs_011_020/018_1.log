+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+CHAIN_COLORS = [BLUE, RED, GREEN, YELLOW, PINK]
+MAX_RETRIES = 400
