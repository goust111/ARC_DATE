+    if side == "left":
+        return int(offset), 0
+    if side == "right":
+        return int(offset), width - 1
+    raise ValueError(side)
+
+
+def _solve(grid: np.ndarray) -> tuple[list[dict], list[int]]:
+    frames = _extract_frames(grid)
+    order = _chain_order(frames)
+    return frames, order
+
