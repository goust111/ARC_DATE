+def _disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    ra, ca, ha, wa = a
+    rb, cb, hb, wb = b
+    return (
+        ra + ha - 1 + gap < rb
+        or rb + hb - 1 + gap < ra
+        or ca + wa - 1 + gap < cb
+        or cb + wb - 1 + gap < ca
+    )
+
