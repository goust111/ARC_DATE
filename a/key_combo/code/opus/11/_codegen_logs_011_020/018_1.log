+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    n = rng.choice([4, 5])
+    heights = [rng.randint(4, 6) for _ in range(n)]
+    widths = [rng.randint(4, 6) for _ in range(n)]
