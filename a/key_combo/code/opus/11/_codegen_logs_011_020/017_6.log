+    coords = {anchor}
+    while len(coords) < area:
+        frontier = []
+        for r, c in coords:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in coords:
+                    frontier.append((nr, nc))
