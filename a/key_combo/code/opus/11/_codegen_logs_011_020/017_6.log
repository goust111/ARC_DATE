+            bridge_cells = [(-d, 0) for d in range(1, bridge + 1)]
+        elif side == "down":
+            anchor_global = (bridge + 1, 0)
+            bridge_cells = [(d, 0) for d in range(1, bridge + 1)]
+        elif side == "left":
