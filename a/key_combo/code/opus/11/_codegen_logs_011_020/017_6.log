+def _grow_patch(area: int, side: str) -> tuple[set[tuple[int, int]], tuple[int, int]]:
+    dims = [
+        (h, w)
+        for h in range(2, 6)
+        for w in range(2, 6)
+        if area <= h * w and area >= h + w - 1
