_GEN_LOOP_SIZE_MAX = 7
_GEN_LOOP_PERIMETER_MIN = 12
_GEN_LOOP_PERIMETER_MAX = 22
_GEN_LOOP_INTERIOR_MIN = 3
_GEN_LOOP_COUNT_OPTIONS = (2, 3, 4)
_GEN_APPEND_TOTAL_MIN = 2
