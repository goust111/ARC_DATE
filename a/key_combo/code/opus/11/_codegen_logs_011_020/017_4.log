    input_grid = _gen_base_scaffold()
    for (rect, cells), color in zip(chosen, colors):
        pixel_count = random.randint(*_GEN_MARKER_PIXELS_RANGE)
        for r, c in _gen_marker_positions(rect, cells, pixel_count):
