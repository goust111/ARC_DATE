+
+def _marker_mask(shape: tuple[int, int], segments: list[dict[str, object]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for seg in segments:
+        for cell in (seg["start"], seg["end"]):
+            mask[cell] = True
+    return mask
