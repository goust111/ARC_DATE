+
+GEN_SIZE_RANGE = (13, 18)
+GEN_LENGTH_TRIPLES = ((5, 7, 9), (5, 7, 11), (5, 9, 11), (7, 9, 11))
+GEN_BACKBONE_RANKS = ("medium", "long")
+GEN_MAX_ATTEMPTS = 600
