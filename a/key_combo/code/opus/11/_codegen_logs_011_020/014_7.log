+
+def _band_mask(shape: tuple[int, int], cells: list[tuple[int, int]]) -> np.ndarray:
+    rows, cols = shape
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in cells:
+        r0 = max(0, r - 1)
+        r1 = min(rows, r + 2)
+        c0 = max(0, c - 1)
+        c1 = min(cols, c + 2)
+        mask[r0:r1, c0:c1] = True
+    return mask
