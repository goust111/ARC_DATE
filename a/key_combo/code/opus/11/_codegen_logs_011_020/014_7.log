+    segments: list[dict[str, object]] = []
+    for color in colors:
+        coords = np.argwhere(g == color)
+        assert coords.shape == (2, 2), "each color must appear exactly twice"
+        start = tuple(map(int, coords[0]))
+        end = tuple(map(int, coords[1]))
+        cells = _line_cells(start, end)
+        segments.append(
