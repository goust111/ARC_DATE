+            rows, cols = np.nonzero(mask)
+            return mask[rows.min() : rows.max() + 1, cols.min() : cols.max() + 1]
+    raise RuntimeError(f"failed to generate distractor mask for area={area}")
+
+
+def _can_place_patch(
