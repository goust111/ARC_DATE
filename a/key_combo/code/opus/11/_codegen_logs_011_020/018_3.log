002: import numpy as np
003: from typing import *
004: import random
005: from arc_utils import Color, bbox, crop_bbox, draw_line, find_components, first_free_location, paste
006: 
007: # concepts:
008: # punching holes, geometric pattern
009: 
010: # description:
011: # In the input you will see a grid with some rectangles. Each rectangle is three pixels along its short side, and is monochromatic.
012: # To make the output, you should draw black pixels along the middle of each rectangle with a period of 2 starting one pixel in.
013: # Effectively punching holes in the middle of each rectangle, skipping alternating pixels.
014: 
015: def main(input_grid):
016:     """
017:     Punch alternating black holes through the center line of each monochromatic 3-wide rectangle.
018: 
019:     Input structure:
020:     - The grid contains one or more separated non-black monochromatic rectangles.
021:     - Each rectangle has short side length 3 and an odd long side.
022:     - Rectangles may be horizontal or vertical on a black background.
023: 
024:     Rule:
025:     - Detect each rectangle and rotate vertical ones into a horizontal working orientation.
026:     - Set every other pixel along the middle line, starting one pixel in, to black.
027:     - Restore the original orientation and paste the edited rectangle back onto a black output.
028: 
029:     Key insight:
030:     - The hole pattern is defined along the rectangle's long axis, so orientation is handled
031:       by canonicalizing the rectangle before editing it.
032:     """
033:     # Plan:
034:     # 1. Extract the rectangles from the input grid
035:     # 2. Canonicalize the rectangles: ensure that they are horizontal (remember to rotate back otherwise)
036:     # 3. Draw black pixels inside each rectangle (horizontally, skipping every other pixel)
037:     # 4. Rotate the rectangle back if it was not originally horizontal
038: 
039:     # 1. Extract the rectangles from the input grid
040:     rectangle_objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
041: 
042:     output_grid = np.full_like(input_grid, Color.BLACK)
043:     for rectangle_object in rectangle_objects:
044:         # 2. Canonicalize the rectangle sprite
045:         _b = bbox(rectangle_object != Color.BLACK)
046:         assert _b is not None
047:         original_r, original_c, _r1, _c1 = _b
048:         width = _r1 - original_r + 1
049:         height = _c1 - original_c + 1
050:         # crop to convert object to sprite
051:         _b = bbox(rectangle_object != Color.BLACK)
052:         assert _b is not None
053:         rectangle_sprite = crop_bbox(rectangle_object, _b)
054: 
055:         # Flip it to be horizontal if it isn't already
056:         is_horizontal = width > height
057:         if not is_horizontal:
058:             rectangle_sprite = np.rot90(rectangle_sprite)
059:             width, height = height, width
060: 
061:         # 3. Punch holes through the middle of the rectangle
062:         # The inner row is y=height//2
063:         for r in range(1, width, 2):
064:             rectangle_sprite[r, height//2] = Color.BLACK
065:         
066:         # 4. Rotate back if it was originally vertical, and then draw it to the output grid
067:         if not is_horizontal:
068:             rectangle_sprite = np.rot90(rectangle_sprite, k=-1)
069:         
070:         # draw it back in its original location
071:         paste(output_grid, rectangle_sprite, original_r, original_c, transparent=Color.BLACK, clip=True)
072: 
073:     return output_grid
074: 
