001: 
002: import numpy as np
003: from typing import *
004: from arc_utils import Color, bbox, crop_bbox, draw_line, find_components, first_free_location, paste, random_sprite
005: import random
006: 
007: # concepts:
008: # symmetries, objects
009: 
010: # description:
011: # In the input you will see one or two medium-sized multicolor objects, and some multicolor pixels sprinkled around in one or two clusters
012: # To make the output, take each of the medium-sized object and move it so that it perfectly covers some of the pixels sprinkled around, matching colors wherever they overlap.
013: # You can rotate and flip the objects in order to make them fit the pixels, but they have to match colors wherever they overlap.
014: 
015: def main(input_grid):
016:     """
017:     Place each large multicolor object over the sparse matching pixels after trying rotations and flips.
018: 
019:     Input structure:
020:     - The input contains one or two larger multicolor objects on a black background.
021:     - It also contains small clusters of colored pixels that are partial views of those objects.
022:     - Objects may need rotation or reflection to align with their pixel guides.
023: 
024:     Rule:
025:     - Separate large objects from small pixel clusters.
026:     - Generate rotated and flipped variants of each large object.
027:     - Choose the placement and variant that covers the most guide pixels without any color mismatch.
028: 
029:     Key insight:
030:     - The sparse pixels are anchors for transformed copies: color-consistent overlap identifies both
031:       the orientation and the position of each object.
032:     """
033:     # Plan:
034:     # 1. Break the input into 1-2 big object(s) and a mask containing the remaining pixels
035:     # 2. For each object, create rotations and flips of it
036:     # 3. For each object, find the best way to place one of its rotations/flips so that it covers the most number of the pixels (remember the pixel has to match object color)
037: 
038:     # Extract the objects from the input and categorize them into objects and pixels
039:     # Objects can be multicolored
040:     connected_components = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
041:     objects = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) > 4 ]
042:     pixels = [ cc for cc in connected_components if np.count_nonzero(cc != Color.BLACK) <= 4 ]
043: 
044:     # Make the pixel mask, which shows where the pixels are. These guide the placement of objects.
045:     pixel_mask = np.full(input_grid.shape, Color.BLACK)
046:     for pixel_object in pixels:
047:         paste(pixel_mask, pixel_object, 0, 0, transparent=Color.BLACK, clip=True)
048:     
049:     output_grid = np.full(input_grid.shape, Color.BLACK)
050:     
051:     # For each object, find the best way to place it so that it covers the most number of the pixels
052:     for obj in objects:
053:         # The object can be rotated and flipped to match the pixels
054:         # First, convert it to a sprite before transforming, because these operations are independent of position
055:         _b = bbox(obj != Color.BLACK)
056:         assert _b is not None
057:         sprite = crop_bbox(obj, _b)
058:         sprite_variations = [sprite, np.rot90(sprite), np.rot90(sprite, 2), np.rot90(sprite, 3), np.flipud(sprite), np.fliplr(sprite), np.flipud(np.rot90(sprite)), np.fliplr(np.rot90(sprite))]
059: 
060:         # We are going to optimize the position and variation, so we need to keep track of the best placement so far
061:         best_output, best_pixels_covered = None, 0
062:         for r, c, sprite_variation in [(r, c, variant) for r in range(input_grid.shape[0]) for c in range(input_grid.shape[1]) for variant in sprite_variations]:
063:             test_grid = np.copy(output_grid)
064:             paste(test_grid, sprite_variation, r, c, transparent=Color.BLACK, clip=True)
065:             # Check if there was any color mismatch: A colored pixel in the mask which is different from what we just made
066:             # If there is a mismatch, we can't place the object here
067:             if np.any((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK) & (pixel_mask != test_grid)):
068:                 continue
069:             num_covered_pixels = np.count_nonzero((pixel_mask != Color.BLACK) & (test_grid != Color.BLACK))
070:             if num_covered_pixels > best_pixels_covered:
071:                 best_output, best_pixels_covered = test_grid, num_covered_pixels
072:         output_grid = best_output
073: 
074:     return output_grid
075: 
