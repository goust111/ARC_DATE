096:     sprite = np.full((num_colors, num_colors), Color.BLACK)
097:     line_t = np.transpose(line)
098:     paste(sprite, line, 0, cross_points, transparent=Color.BLACK, clip=True)
099:     paste(sprite, line_t, cross_points, 0, transparent=Color.BLACK, clip=True)
