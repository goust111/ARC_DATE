008: # concepts:
009: # growing, connecting
010: 
011: # description:
012: # In the input you will see two pixels of different colors aligned horizontally or vertically.
013: # To make the output, you need to connect the two pixels with two lines and a hollow rectangle of size 4x5 in the middle.
014: # Half of the rectangle is colored with the color of the one side's pixel, and the other half with the color of the other side's pixel.
015: 
016: def main(input_grid):
017:     """
018:     Connect two aligned colored pixels through a centered split-color hollow rectangle.
019: 
020:     Input structure:
021:     - Two single pixels of different colors are aligned horizontally or vertically.
022:     - The background is black.
023:     - There is enough space between the pixels for the hollow rectangle bridge.
024: 
025:     Rule:
026:     - Rotate vertical cases into a horizontal canonical form.
027:     - Build a hollow rectangle whose left half uses the left color and right half uses the right color.
028:     - Paste it midway between the pixels and connect each pixel to the nearest side.
029: 
030:     Key insight:
031:     - After canonical rotation, the task is a symmetric bridge between left and right color anchors.
032:     """
033:     # Plan (from the original seed solver):
034:     # 1. Parse the input
035:     # 2. Canonicalize the input: because it could be horizontal or vertical, rotate to make horizontal (we will rotate back at the end)
036:     # 3. Prepare a 4x5 rectangle sprite whose left half is left_color and right half is right_color
037:     # 4. Place the rectangle in the middle of the two pixels
038:     # 5. Draw lines to connect the original two pixels with the rectangle
039:     # 6. Rotate the grid back if it was not originally horizontal
040:     #
041:     # Implementation note:
042:     # - The legacy seed solver runs under a transpose wrapper; this migrated version runs canonical `(r,c)`.
043:     #   The high-level structure is preserved (canonicalize -> build sprite -> paste -> connect -> unrotate).
044:     comps = find_components(
045:         input_grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict"
046:     )
047:     if len(comps) != 2:
048:         return input_grid.copy()
049: 
050:     p0 = tuple(map(int, comps[0]["coords"][0]))
051:     p1 = tuple(map(int, comps[1]["coords"][0]))
052: 
053:     rotated = False
054:     grid = input_grid
055:     if p0[0] != p1[0]:  # not same row => rotate to make them horizontal
056:         grid = np.rot90(grid)
057:         rotated = True
058: 
059:     comps = find_components(grid, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="dict")
060:     if len(comps) != 2:
061:         out = grid.copy()
062:         return np.rot90(out, k=-1) if rotated else out
063: 
064:     p0 = tuple(map(int, comps[0]["coords"][0]))
065:     p1 = tuple(map(int, comps[1]["coords"][0]))
066:     c0 = int(comps[0]["color"])
067:     c1 = int(comps[1]["color"])
068: 
069:     # Should now be horizontally aligned
070:     if p0[0] != p1[0]:
071:         out = grid.copy()
072:         return np.rot90(out, k=-1) if rotated else out
073: 
074:     # Sort left->right by column
075:     if p0[1] <= p1[1]:
076:         left_pos, right_pos = p0, p1
077:         left_color, right_color = c0, c1
078:     else:
079:         left_pos, right_pos = p1, p0
080:         left_color, right_color = c1, c0
081: 
082:     r = left_pos[0]
083:     c_left = left_pos[1]
084:     c_right = right_pos[1]
085: 
086:     output_grid = grid.copy()
087: 
088:     # Hollow rectangle: 4x5 (width x height) in the seed coordinate system.
089:     # In canonical (r,c) grids, that's height=5 rows, width=4 cols.
090:     rect_h, rect_w = 5, 4
091:     rect = np.full((rect_h, rect_w), Color.BLACK, dtype=int)
092:     rect[:, 0] = left_color
093:     rect[:, -1] = right_color
094:     rect[0, : rect_w // 2] = left_color
095:     rect[0, rect_w // 2 :] = right_color
096:     rect[-1, : rect_w // 2] = left_color
