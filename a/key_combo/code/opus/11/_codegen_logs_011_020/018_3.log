013: def main(grid: np.ndarray) -> np.ndarray:
014:     """
015:     Advance the marker from one half of a vertical bar to the same half of the next longer bar.
016: 
017:     Input structure
018:     - The grid has one dominant background color and exactly two foreground colors.
019:     - One foreground color forms many vertical one-cell-wide bars; the other appears as a single vertical marker segment.
020:     - The marker segment occupies exactly the top or bottom half of its containing vertical bar.
021:     Rule
022:     - Recolor the current marker segment back to the bar color.
023:     - Find the unique all-bar-color vertical bar whose height is two pixels greater than the marked source bar.
024:     - Recolor the same half of that next longer bar to the marker color.
025:     Key insight
026:     - Each bar's total height encodes an ordered size, and the marker advances from a 2k bar to the corresponding 2(k+1) bar while preserving whether it marks the top or bottom half.
027:     """
028:     g = np.asarray(grid, dtype=int)
029:     assert g.ndim == 2
030: 
031:     bg = int(get_bg(g))
032:     colors = colors_present(g, exclude={bg})
033:     assert len(colors) == 2, f"expected exactly two foreground colors, got {colors}"
034: 
035:     mono_component_counts = {
036:         int(color): len(
037:             find_components(
038:                 g,
039:                 bg=bg,
040:                 colors=[int(color)],
041:                 connectivity=4,
042:                 monochromatic=True,
043:             )
044:         )
045:         for color in colors
046:     }
047:     marker_colors = [color for color, count in mono_component_counts.items() if count == 1]
048:     assert len(marker_colors) == 1, f"expected one single-component marker color, got {mono_component_counts}"
049:     marker_color = int(marker_colors[0])
050: 
051:     bar_colors = [int(color) for color in colors if int(color) != marker_color]
052:     assert len(bar_colors) == 1
053:     bar_color = int(bar_colors[0])
054: 
055:     marker_components = find_components(
056:         g,
057:         bg=bg,
058:         colors=[marker_color],
059:         connectivity=4,
060:         monochromatic=True,
061:     )
062:     assert len(marker_components) == 1
063:     marker = marker_components[0]
064:     marker_area = int(marker["area"])
065:     mr0, mc0, mr1, _mc1 = marker["bbox"]
066:     assert _is_solid_vertical_bar(marker)
067: 
068:     bars = find_components(g, bg=bg, connectivity=4, monochromatic=False)
069:     source_bars = [
070:         bar
071:         for bar in bars
072:         if np.any(g[bar["coords"][:, 0], bar["coords"][:, 1]] == marker_color)
073:     ]
074:     assert len(source_bars) == 1, f"expected one bar containing the marker, got {len(source_bars)}"
075:     source = source_bars[0]
