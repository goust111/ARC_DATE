296: 
297: def crop_bbox(grid: np.ndarray, bbox: BBox) -> np.ndarray:
298:     """Crop a grid to bbox (inclusive)."""
299:     r0, c0, r1, c1 = map(int, bbox)
300:     return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
