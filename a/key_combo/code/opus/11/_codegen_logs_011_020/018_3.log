079:     # Randomly choose the number of regions that are going to form the output canvas
080:     w, h = np.random.randint(3, 6), np.random.randint(3, 6)
081:     # Keep track of the color of each region
082:     region_colors = np.full((w, h), Color.BLACK)
083: 
084:     # Randomly choose the colors. the separator gets a special color and colored regions get a color randomly selected from other_colors
