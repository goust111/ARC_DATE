007: # concepts:
008: # pixel patterns, expansion, color sequence
009: 
010: # description:
011: # In the input you will see a grid with a cross pattern. Each pixel in the cross has a different color.
012: # To make the output, you should expand the cross right/left/top/bottom following the original color sequence of the cross.
013: 
014: def main(input_grid):
015:     """
016:     Extend a multicolor cross across the canvas by repeating its color sequences.
017: 
018:     Input structure:
019:     - The grid contains one connected multicolor cross on a black background.
020:     - One full row and one full column of the cropped sprite meet at the cross center.
021:     - The row and column colors form the sequences to repeat.
022: 
023:     Rule:
024:     - Crop the cross and locate the row and column that pass through its center.
025:     - Copy the input grid as the output canvas.
026:     - Paste the center column and center row sequences repeatedly in both directions.
027: 
028:     Key insight:
029:     - The cross is a seed for periodic extension: its central row and column are reused
030:       at intervals equal to their own lengths.
031:     """
032:     # Plan:
033:     # 1. Parse the input and create output canvas to draw on top of
034:     # 2. Extract the vertical and horizontal parts of the cross, and make note of the coordinate of the middle
035:     # 3. Expand the horizontal part to the right and left, aligned with the middle y coordinate
036:     # 4. Expand the vertical part to the top and bottom, aligned with the middle x coordinate    
037: 
038:     # 1. Input parsing
039:     # Extract the cross, which has many colors and so is not monochromatic.
040:     objects = find_components(input_grid, bg=Color.BLACK, connectivity=4, monochromatic=False, return_format="objects")
041:     assert len(objects) == 1, "exactly one cross expected"
042:     obj = objects[0]
043:     _b = bbox(obj != Color.BLACK)
044:     assert _b is not None
045:     cross_r, cross_c = bbox_anchor(_b, anchor="upper left")
046: 
047:     # Create output grid, which we are going to draw on top of, so we start with the input grid
048:     output_grid = input_grid.copy()
049:     width, height = input_grid.shape
050: 
051:     # 2. Cross analysis: Extract subsprites, get the middle
052:     # Extract the horizontal/vertical parts of the cross sprite by figuring out where its middle is (where the horizontal and vertical lines meet)
053:     _b = bbox(obj != Color.BLACK)
054:     assert _b is not None
055:     sprite = crop_bbox(obj, _b)
056:     cross_width, cross_height = sprite.shape
057:     # Middle is where they meet
058:     cross_middle_r = next( r for r in range(cross_width) if np.all(sprite[r, :] != Color.BLACK) )
059:     cross_middle_c = next( c for c in range(cross_height) if np.all(sprite[:, c] != Color.BLACK) )
060:     # Extract the horizontal and vertical parts of the cross
061:     vertical_sprite = sprite[cross_middle_r:cross_middle_r+1, :]
062:     horizontal_sprite = sprite[:, cross_middle_c:cross_middle_c+1]
063: 
064:     # 3. Expand the horizontal line to the right and left
065:     r_start, c_start, len_line = cross_r, cross_c + cross_middle_c, cross_width
066:     for i in range(r_start, width, len_line):
067:         paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
068:     for i in range(r_start, -(len_line), -len_line):
069:         paste(output_grid, horizontal_sprite, i, c_start, transparent=Color.BLACK, clip=True)
070:     
071:     # 4. Expand the vertical line to the top and bottom
072:     r_start, c_start, len_line = cross_r + cross_middle_r, cross_c, cross_height
073:     for i in range(c_start, height, len_line):
074:         paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
075:     for i in range(c_start, -(len_line), -len_line):
076:         paste(output_grid, vertical_sprite, r_start, i, transparent=Color.BLACK, clip=True)
077:         
078:     return output_grid
