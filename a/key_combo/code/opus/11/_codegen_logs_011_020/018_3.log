007: 
008: # concepts:
009: # downscaling, mirror, horizontal/vertical bars
010: 
011: # description:
012: # In the input you will see horizontal and vertical bars separating different regions/cells/partitions with each cell containing different colors, like a chessboard.
013: # Each separated region has a single color.
014: # To make the output, make a grid with one colored pixel for each region of the chessboard.
015: # Finally mirror along the x-axis.
016: 
017: def main(input_grid):
018:     """
019:     Collapse a separator grid into one color per region, then mirror the compact grid left-to-right.
020: 
021:     Input structure:
022:     - The input is divided into uniformly colored cells by horizontal and vertical separator bars.
023:     - Each region between separators has a single color.
024:     - The separator color forms a connected partition spanning the full canvas.
025: 
026:     Rule:
027:     - Identify the separator color and extract all separator-delimited regions.
028:     - Replace each region with one pixel of its region color, preserving row and column order.
029:     - Mirror the compact region-color grid horizontally.
030: 
031:     Key insight:
032:     - The large chessboard-like image is an enlarged region map; the final step is a left-right
033:       reflection of that compressed map.
034:     """
035:     # Plan:
036:     # 1. Determine the color of the separator between the regions
037:     # 2. Extract all the regions separated by the separator color
038:     # 3. Find the region positions and their possible X/Y positions
039:     # 4. Create the output grid so that one pixel represents the original region, preserving X/Y ordering
040:     # 5. Mirror the output grid by x-axis
041: 
042:     H, W = input_grid.shape
043: 
044:     # 1. Determine the separator color.
045:     # Mirror the legacy seed approach: find the monochromatic component (non-black)
046:     # whose bbox spans the whole canvas.
047:     bg = Color.BLACK
048:     sep_objs = find_components(input_grid, bg=bg, connectivity=4, monochromatic=True, return_format="objects")
049:     sep_candidates = [obj for obj in sep_objs if bbox(obj != bg) == (0, 0, H - 1, W - 1)]
050:     assert len(sep_candidates) == 1, "There should be exactly 1 separator partitioning the input"
051:     separator_color = colors_present(sep_candidates[0], exclude={bg})[0]
052: 
053:     # 2. Extract all regions separated by the separator color.
054:     regions = find_components(
055:         input_grid,
056:         bg=int(separator_color),
057:         connectivity=4,
058:         monochromatic=True,
059:         return_format="dict",
060:     )
061: 
062:     # 3/4. Build the downscaled grid (one pixel per region), preserving row/col ordering.
063:     r_positions = sorted({int(reg["bbox"][0]) for reg in regions})
064:     c_positions = sorted({int(reg["bbox"][1]) for reg in regions})
065:     r_to_i = {r: i for i, r in enumerate(r_positions)}
066:     c_to_j = {c: j for j, c in enumerate(c_positions)}
067: 
068:     output_grid = np.full((len(r_positions), len(c_positions)), Color.BLACK, dtype=int)
069:     for reg in regions:
070:         r0, c0, _r1, _c1 = reg["bbox"]
071:         output_grid[r_to_i[int(r0)], c_to_j[int(c0)]] = int(reg["color"])
072: 
073:     # 5. Mirror the downscaled grid horizontally (left-right).
074:     output_grid = np.fliplr(output_grid)
075: 
076:     return output_grid
077: 
