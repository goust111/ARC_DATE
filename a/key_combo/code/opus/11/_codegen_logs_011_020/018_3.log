077: def generate_input():
078:     # to make the input, we make random objects
079:     # we need to make sure that the objects can match with the "sprinkled" pixels, so we make the pixels by placing some objects and then removing some parts of them
080: 
081:     n, m = np.random.randint(10, 20), np.random.randint(10, 20)
082:     grid = np.full((m, n), Color.BLACK)
083: 
084:     num_objects = np.random.randint(1, 3)
085:     sprites = [ random_sprite(np.random.randint(3, 6), np.random.randint(3, 6), color_palette=Color.NOT_BLACK, density=0.5)
086:                 for _ in range(num_objects) ]
087:     sprite_variations = [ [sprite, np.rot90(sprite, k=-1), np.rot90(sprite,-(2)), np.rot90(sprite,-(3)), np.fliplr(sprite), np.flipud(sprite), np.fliplr(np.rot90(sprite, k=-1)), np.flipud(np.rot90(sprite, k=-1))]
088:                           for sprite in sprites ]
089:     # Pick a variation for each sprite
090:     sprite_variations = [ random.choice(variations) for variations in sprite_variations ]
091:     
092:     # Remove parts of the sprite to create the "sprinkled" pixels
093:     # We remove enough of the sprite so that there are only 3 pixels remaining
094:     # We do this to the variation, which is what is going to be put on the canvas to be matched with
095:     occluded_sprites = []
096:     for sprite in sprite_variations:
097:         occluded_sprite = np.copy(sprite)
098:         could_be_removed = np.argwhere(occluded_sprite != Color.BLACK)
099:         np.random.shuffle(could_be_removed)
100:         for i in range(len(could_be_removed) - 3):
101:             r, c = could_be_removed[i]
102:             occluded_sprite[r, c] = Color.BLACK
103: 
104:         occluded_sprites.append(occluded_sprite)
105: 
106:     # place everything on the canvas but make sure that nothing overlaps
107:     for sprite in sprites + occluded_sprites:
108:         _loc = first_free_location(grid, sprite, transparent=Color.BLACK, border=2, padding=2, padding_connectivity=8)
109:         if _loc is None:
110:             # Retry generation (placement can fail due to padding constraints).
111:             return generate_input()
112:         r, c = _loc
113:         paste(grid, sprite, r, c, transparent=Color.BLACK, clip=True)
114:     
115:     return grid     
