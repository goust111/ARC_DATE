098: def main(grid: np.ndarray) -> np.ndarray:
099:     """
100:     Replicate a pre-drawn corner pattern to every other marker-bearing corner.
101: 
102:     Input structure:
103:     - bg = most frequent color. Hollow 0-frames (possibly partial L-shapes); each
104:       frame-corner cell is either 0 or a painted (non-bg, non-0) color.
105:     - >= 1 'source' corner: the pattern is already drawn (one color, both outward
106:       cells and an inward-diagonal trail).
107:     - Other corners: a single colored pixel on the inward diagonal at the pattern's
108:       deepest (k,k) offset; the pixel's color is that corner's target color.
109: 
110:     Rule:
111:     - Extract the canonical (TL-oriented) pattern from any source.
112:     - For each non-source corner whose marker cell is colored, paint the same
113:       pattern rotated to that corner's orientation, using the marker's color.
114: 
115:     Key insight: the pattern is symmetric about the corner's inward-diagonal axis
116:     (canonical dr == dc), so it reflects cleanly across all four corner orientations.
117:     Painting uses each target's OWN marker color, not the source color.
118:     """
119:     g = np.asarray(grid, dtype=int)
120:     H, W = g.shape
121:     bg = int(get_bg(g))
122: 
123:     corners = _find_corners(g, bg)
124:     assert corners, "no frame corner detected"
125: 
126:     per_corner = {c: _colored_around(g, *c, bg) for c in corners}
127: 
128:     # Source = corner with >=2 strictly-outward (canonical dr<0 or dc<0) colored cells
129:     # of a single color.
130:     def _is_outward(off): return off[0] < 0 or off[1] < 0
131:     sources = []
132:     for c_key, items in per_corner.items():
133:         outward = [(o, v) for (o, v) in items if _is_outward(o)]
134:         if len(outward) >= 2:
135:             colors = {v for (_, v) in outward}
136:             assert len(colors) == 1, (
137:                 f"source {c_key} has mixed outward colors: {colors}"
138:             )
139:             sources.append(c_key)
140:     assert sources, "at least one source corner (pre-drawn outward pattern) required"
141: 
142:     def _extract(c_key):
143:         items = per_corner[c_key]
144:         pat_col = Counter(v for (_, v) in items).most_common(1)[0][0]
145:         return frozenset(o for (o, v) in items if v == pat_col), pat_col
146: 
147:     canon, _ = _extract(sources[0])
148:     for s in sources[1:]:
149:         other, _ = _extract(s)
150:         assert other == canon, (
151:             f"source patterns disagree: {sorted(canon)} vs {sorted(other)}"
152:         )
153: 
154:     # Pattern must be symmetric about the corner's inward-diagonal axis (dr==dc).
155:     for (dr, dc) in canon:
156:         assert (dc, dr) in canon, (
157:             f"pattern not diagonally symmetric: ({dr},{dc}) has no mirror ({dc},{dr})"
158:         )
159: 
160:     # Pattern must anchor at least one inward-diagonal cell so targets have a marker.
161:     diag_ks = [dr for (dr, dc) in canon if dr == dc and dr > 0]
162:     assert diag_ks, "pattern has no inward-diagonal cell to anchor markers"
163:     marker_canon = (max(diag_ks), max(diag_ks))
164: 
165:     # Classify non-source corners as targets by reading their marker cell.
166:     src_set = set(sources)
167:     targets = []
168:     for c_key in corners:
169:         if c_key in src_set: continue
170:         r, c, kind = c_key
