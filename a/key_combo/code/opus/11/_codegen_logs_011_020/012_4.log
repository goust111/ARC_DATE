        return None
    shifted[new_rows, cols] = group[rows, cols]
    return shifted


def _gen_render_groups(groups, separator_width):
    width = sum(group.shape[1] for group in groups) + separator_width * (len(groups) - 1)
    canvas = np.zeros((GEN_HEIGHT, width), dtype=int)
