  "type": "move_to_match",
  "src": "red sprite mask s",
  "dst": "black candidate stamp window d in the gray pattern",
  "match_cond": "s.mask cells fit black cells in d; gray support inside s.bbox matches gray cells in d, or solid unsupported s maps to border-touching d",
  "transform": "paint the matched mask cells red; preserve all other cells",
  "multi_step": "scan d top-to-bottom, left-to-right; after each stamp, later d must still have black mask cells"
}
</annotation>
<generation_spec>
