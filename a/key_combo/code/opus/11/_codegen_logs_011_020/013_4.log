import random
import numpy as np

H,W=5,10
FG=4
BG=0

def roll_row(row,s):
    return np.roll(row, s)

def infer(rows):
    h,w=rows.shape
    cand=[]
    for p in range(1,h):
        for s in range(w):
            if all(np.array_equal(roll_row(rows[r-p],s), rows[r]) for r in range(p,h)):
                cand.append((p,s))
    if not cand:
        return None,cand
    mp=min(p for p,_ in cand)
    best=[x for x in cand if x[0]==mp]
    return best,best

def rand_row():
    row=np.zeros(W,dtype=int)
    kind=random.choice(['run','split','scatter'])
    if kind=='run':
        ln=random.randint(2,4)
        start=random.randint(0,W-ln)
        row[start:start+ln]=FG
    elif kind=='split':
        cols=random.sample(range(W), random.randint(2,4))
        for c in cols: row[c]=FG
        if np.all(np.diff(sorted(cols))==1):
            return rand_row()
    else:
        cols=sorted(random.sample(range(W), random.randint(2,4)))
        for c in cols: row[c]=FG
    return row

for _ in range(10000):
    p=random.choice([2,3])
    s=random.choice([1,2])
    missing=1 if p==3 else random.choice([1,2])
    visible=H-missing
    base=np.array([rand_row() for _ in range(p)])
    full=np.zeros((H,W),dtype=int)
    full[:p]=base
    for r in range(p,H):
        full[r]=roll_row(full[r-p],s)
    obs=full[:visible]
    best,_=infer(obs)
    if not best or len(best)"'!=1 or best[0]!=(p,s):
        continue
    if np.array_equal(full,np.fliplr(full)) or np.array_equal(full,np.flipud(full)):
        continue
    print('"'ok example',p,s,missing)
    print(full)
    break
else:
    print('none found')
