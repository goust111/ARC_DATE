def _valid_mask_positions(
    height: int,
    width: int,
    rect_h: int,
    rect_w: int,
) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
    mid_r = height // 2
    mid_c = width // 2
    priority: list[tuple[int, int]] = []
    fallback: list[tuple[int, int]] = []

    for r0 in range(height - rect_h + 1):
        if r0 <= mid_r <= r0 + rect_h - 1:
