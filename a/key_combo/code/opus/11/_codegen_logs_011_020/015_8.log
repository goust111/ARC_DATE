    inp[r0 : r0 + rect_h, c0 : c0 + rect_w] = MARKER
    expected = grid[:, width // 2].reshape(height, 1)

    try:
        actual = main(inp)
    except Exception:
        return None
    if not np.array_equal(actual, expected):
        return None
    if np.count_nonzero(inp == MARKER) != rect_h * rect_w:
        return None
    if np.count_nonzero(inp[:, width // 2] == MARKER) == 0:
        return None

    return inp


