+import numpy as np
+
+
+BG = 0
+GUIDE = 6
+SPRITE_SIZE = 3
+RING_COORDS = (
+    (0, 0),
+    (0, 1),
+    (0, 2),
+    (1, 0),
+    (1, 2),
+    (2, 0),
+    (2, 1),
+    (2, 2),
+)
+FRAME_SIDES = {
+    "top": 1,
+    "left": 2,
+    "right": 3,
+    "bottom": 4,
+}
+FRAME_COLORS = set(FRAME_SIDES.values())
+GEN_ATTEMPTS = 400
