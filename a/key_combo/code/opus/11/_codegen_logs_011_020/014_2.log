+        latest = height - 2 - 2 * remaining
+        earliest = next_min
+        latest = min(latest, earliest + 2)
+        if earliest > latest:
+            return None
+        row = rng.randint(earliest, latest)
+        rows.append(row)
+        next_min = row + 2
+    return rows
