+
+    grid = np.zeros((height, width), dtype=int)
+    for box in layout:
+        r0, c0, r1, c1 = box
+        _draw_frame(grid, r0, c0, r1 - r0 + 1, c1 - c0 + 1)
+
+    if not _accepts(grid, interaction):
+        return None
+    return grid
