+    grid[r0 : r1 + 1, c1] = BLUE
+    grid[r0 + 1, c0 + 1] = RED
+    grid[r0 + 1, c1 - 1] = RED
+    grid[r1 - 1, c0 + 1] = RED
+    grid[r1 - 1, c1 - 1] = RED
