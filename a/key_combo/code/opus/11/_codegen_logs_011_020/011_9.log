+        outer_markers: dict[str, tuple[int, int]] = {}
+        for name in CORNER_ORDER:
+            inner = _corner_point(corners[name], CORNER_DATA[name]["inner"])
+            outer = _corner_point(corners[name], CORNER_DATA[name]["outer"])
