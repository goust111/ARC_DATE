+    out = grid.copy()
+    blocks = len(_grey_components(out))
+    for _ in range(400):
+        if blocks >= target_blocks:
+            return out
+        cells = _candidate_block(*out.shape)
+        if not _can_place_block(out, cells):
+            continue
+        trial = out.copy()
+        for r, c in cells:
+            trial[r, c] = GREY
+        if _red_signature(trial) != baseline_red:
+            continue
+        if not _valid_obstacle_layout(trial):
