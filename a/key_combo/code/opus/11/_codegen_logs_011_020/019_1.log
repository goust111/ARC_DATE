+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+
+PALETTE = (GREEN, YELLOW, BLUE, MAGENTA)
+GEN_ATTEMPTS = 500
+CARDINAL_DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in CARDINAL_DIRS:
+        yield r + dr, c + dc
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _grow_paths(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    h, w = out.shape
+    starts = [(h - 1, int(c)) for c in np.flatnonzero(out[h - 1] == RED)]
+    for start_r, start_c in sorted(starts, key=lambda rc: rc[1]):
+        r, c = start_r, start_c
+        while r > 0:
+            above = int(out[r - 1, c])
+            if above == BLACK:
+                r -= 1
+                out[r, c] = RED
+                continue
+            if above == GREY:
+                nc = c + 1
+                if nc < w and int(out[r, nc]) == BLACK:
+                    c = nc
+                    out[r, c] = RED
+                    continue
+            break
+    return out
+
+
+def _distance_map(grown: np.ndarray) -> np.ndarray:
+    h, w = grown.shape
+    dist = np.full((h, w), -1, dtype=int)
+    q: deque[tuple[int, int]] = deque()
+
+    for r, c in np.argwhere(grown == RED):
+        rr, cc = int(r), int(c)
+        dist[rr, cc] = 0
+        q.append((rr, cc))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(grown.shape, nr, nc):
+                continue
+            if dist[nr, nc] != -1 or int(grown[nr, nc]) == GREY:
+                continue
+            dist[nr, nc] = dist[r, c] + 1
+            q.append((nr, nc))
+
+    return dist
+
+
+def _paint_rings(grown: np.ndarray) -> np.ndarray:
+    out = grown.copy()
+    dist = _distance_map(grown)
+    for r, c in np.argwhere(grown == BLACK):
+        rr, cc = int(r), int(c)
+        d = int(dist[rr, cc])
