+            "turn_rows": rows[:turns],
+            "terminate_row": rows[-1] if terminate else None,
+        }]
+
+    right_terminate = random.random() < 0.35
+    right_turns = random.randint(1, min(3, width - 1))
+    if right_terminate:
+        right_start = width - 1 - right_turns
+    else:
