+    if base is None:
+        return None
+
+    if not _valid_obstacle_layout(base) and np.count_nonzero(base == GREY) >= 4:
+        return None
+
+    mandatory_blocks = len(_grey_components(base))
+    if mandatory_blocks > 8:
+        return None
