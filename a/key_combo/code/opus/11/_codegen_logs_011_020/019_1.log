+    for r, c in cells:
+        if grid[r, c] != BLACK:
+            return False
+        for nr, nc in _neighbors8(r, c):
+            if not _in_bounds(grid.shape, nr, nc):
+                continue
+            if (nr, nc) in cell_set:
+                continue
+            if int(grid[nr, nc]) == GREY:
+                return False
+    return True
