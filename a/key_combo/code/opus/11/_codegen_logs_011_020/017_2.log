+        (1, 0): "D",
+        (0, -1): "L",
+        (0, 1): "R",
+    }
+    return mapping[(dr, dc)]
+
+
+def _opposite(direction: str) -> str:
+    return {"U": "D", "D": "U", "L": "R", "R": "L"}[direction]
