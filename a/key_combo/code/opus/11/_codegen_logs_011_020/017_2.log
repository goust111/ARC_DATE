+def _separator_pair(size: int, full_indices: list[int]) -> tuple[int, int]:
+    candidates = []
+    for i, a in enumerate(full_indices):
+        for b in full_indices[i + 1 :]:
+            if a == b:
+                continue
+            left = a
+            middle = b - a - 1
+            right = size - b - 1
