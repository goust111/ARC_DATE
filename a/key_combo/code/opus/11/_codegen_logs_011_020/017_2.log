def _gen_polyomino_patch(area: int) -> np.ndarray:
    coords = {(0, 0)}
    while len(coords) < area:
        frontier = []
        for r, c in coords:
            for dr, dc in DIRS_4:
                nr, nc = r + dr, c + dc
                if (nr, nc) in coords:
                    continue
                trial = coords | {(nr, nc)}
                rows = [p[0] for p in trial]
                cols = [p[1] for p in trial]
                h = max(rows) - min(rows) + 1
                w = max(cols) - min(cols) + 1
