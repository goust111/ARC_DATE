+    if len(dict.fromkeys(cell_ids)) < 3:
+        return None
+
+    try:
+        out = main(grid)
+    except AssertionError:
+        return None
+    if out.shape != (len(points), 1):
+        return None
+    if len(set(map(int, out[:, 0]))) < 3:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
