+    out = []
+    for cell_id in cell_ids:
+        if cell_id not in color_by_cell:
+            color_by_cell[cell_id] = next_color
+            next_color += 1
+        out.append(color_by_cell[cell_id])
+
+    return np.array(out, dtype=int).reshape(-1, 1)
