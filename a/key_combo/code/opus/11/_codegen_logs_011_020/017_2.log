+    full_cols = [c for c in range(g.shape[1]) if np.all(g[:, c] != bg)]
+    row_seps = _separator_pair(g.shape[0], full_rows)
+    col_seps = _separator_pair(g.shape[1], full_cols)
+
+    line_samples = np.concatenate(
