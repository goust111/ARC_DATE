+            palette = {GREEN if s == 1 else BLUE if s == 2 else ORANGE for s in sizes}
+            if len(palette) < 2:
+                continue
+            if max(sizes) == sum(sizes):
+                continue
+            if _branch_ok(sizes, branch):
+                return cells
+            if fallback is None and len(sizes) >= 2:
+                fallback = cells
+    return fallback
+
