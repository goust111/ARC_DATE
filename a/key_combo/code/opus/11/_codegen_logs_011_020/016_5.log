+    branch = rng.randrange(4)
+    counts = list(range(4, 9))
+    rng.shuffle(counts)
+    fallback: tuple[tuple[int, int], ...] | None = None
+    for count in counts:
+        configs = SAFE_CONFIGS_BY_SIZE[count][:]
+        rng.shuffle(configs)
+        for cells in configs:
