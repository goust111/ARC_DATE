+    has1 = 1 in sizes
+    has2 = 2 in sizes
+    has3 = any(size >= 3 for size in sizes)
+    if len(sizes) < 2:
+        return False
+    if branch == 0:
+        return has1 and has2
+    if branch == 1:
+        return has1 and has3
+    if branch == 2:
+        return has2 and has3
+    return has1 and has2 and has3
+
+
