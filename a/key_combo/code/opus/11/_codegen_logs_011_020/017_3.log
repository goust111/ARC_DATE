+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    """BBox of an (N,2) coords array in (r,c) order."""
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _legend_pairs(grid: np.ndarray) -> list[tuple[int, int]]:
+    pairs: list[tuple[int, int]] = []
+    h, w = grid.shape
+    assert w >= 2
+    for r in range(h):
+        left = int(grid[r, 0])
+        right = int(grid[r, 1])
+        if left == BG and right == BG:
+            break
+        assert left in SOURCE_COLORS and right in FILL_COLORS
+        pairs.append((left, right))
+    assert 2 <= len(pairs) <= 3
+    assert len({src for src, _ in pairs}) == len(pairs)
+    return pairs
+
