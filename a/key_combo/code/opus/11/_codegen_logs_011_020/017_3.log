+        pair = _overlap_rect_pair(rng, h, w, top_min, left_min)
+        if pair is None:
+            return None
+        rect1, rect2, overlap_h, overlap_w = pair
+        _attach_pocket(rect1, "br", overlap_h, overlap_w)
+        _attach_pocket(rect2, "tl", overlap_h, overlap_w)
+        rects.extend([rect1, rect2])
