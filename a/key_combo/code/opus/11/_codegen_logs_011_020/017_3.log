+def _marker_cells(rect: dict) -> tuple[tuple[int, int], tuple[int, int]]:
+    r0, c0, r1, c1 = rect["bbox"]
+    if rect["diag"] == "tlbr":
+        return (r0, c0), (r1, c1)
+    return (r0, c1), (r1, c0)
+
+
+def _chamber_bounds(rect: dict, corner: str, depth_r: int, depth_c: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = rect["bbox"]
+    if corner == "tl":
