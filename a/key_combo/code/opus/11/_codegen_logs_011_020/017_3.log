+def _place_rectangles(rng: random.Random, h: int, w: int, legend_rows: int, pair_count: int) -> tuple[list[dict], bool] | None:
+    top_min = legend_rows + 2
+    left_min = 4
+    force_overlap = pair_count >= 2 and rng.random() < 0.6
