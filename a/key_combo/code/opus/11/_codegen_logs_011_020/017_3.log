+    for rect in rects:
+        corner, depth_r, depth_c = rect["pocket"]
+        for cell in _l_wall_cells(rect, corner, depth_r, depth_c):
+            if cell in marker_cells:
+                return None
+            r, c = cell
+            if grid[r, c] not in (BG, WALL):
+                return None
+            grid[r, c] = WALL
