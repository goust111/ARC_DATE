+        earlier_fill = pairs[0][1]
+        if not np.any(out == earlier_fill):
+            return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(16, 23)
+    w = rng.randint(16, 23)
+    pair_count = rng.choice((2, 3))
