+        cells.extend((r1 - depth_r, c) for c in range(c0, c0 + depth_c + 1))
+    else:
+        cells.extend((r, c1 - depth_c) for r in range(r1 - depth_r, r1 + 1))
+        cells.extend((r1 - depth_r, c) for c in range(c1 - depth_c, c1 + 1))
+    return sorted(set(cells))
+
+
+def _rect_random(
+    rng: random.Random,
+    h: int,
+    w: int,
+    top_min: int,
+    left_min: int,
