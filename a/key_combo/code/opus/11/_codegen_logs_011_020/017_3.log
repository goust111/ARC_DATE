+    for rect, (source, _fill) in zip(rects, pairs):
+        rect["source"] = source
+        m0, m1 = _marker_cells(rect)
+        if m0 in marker_cells or m1 in marker_cells:
+            return None
+        marker_cells.add(m0)
+        marker_cells.add(m1)
