+        rects.append(rect)
+    return rects, force_overlap
+
+
+def _write_grid(h: int, w: int, pairs: list[tuple[int, int]], rects: list[dict]) -> np.ndarray | None:
+    grid = np.zeros((h, w), dtype=int)
+    legend_rows = len(pairs)
