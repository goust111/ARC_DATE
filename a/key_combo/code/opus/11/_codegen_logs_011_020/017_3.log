+
+def _boxes_overlap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0)
+
+
+def _strictly_inside(point: tuple[int, int], box: tuple[int, int, int, int]) -> bool:
+    r, c = point
+    r0, c0, r1, c1 = box
