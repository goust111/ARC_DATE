+    if corner == "bl":
+        return r1 - depth_r + 1, c0 + 1, r1 - 1, c0 + depth_c - 1
+    return r1 - depth_r + 1, c1 - depth_c + 1, r1 - 1, c1 - 1
+
+
+def _l_wall_cells(rect: dict, corner: str, depth_r: int, depth_c: int) -> list[tuple[int, int]]:
