+    placed = _place_rectangles(rng, h, w, len(pairs), pair_count)
+    if placed is None:
+        return None
+    rects, require_overlap = placed
+
+    grid = _write_grid(h, w, pairs, rects)
+    if grid is None:
+        return None
+    if not _validate_grid(grid, pairs, require_overlap):
+        return None
+    return grid
