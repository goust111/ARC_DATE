+
+def _enclosed_mask_for_rect(grid: np.ndarray, rect: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = rect
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    background = sub == BG
+    comps = _components(background)
