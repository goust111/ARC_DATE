  "type": "move_to_match",
  "src": "source-color cells in the mixed template object s with marker-color control cells",
  "dst": "detached marker-color square groups d",
  "match_cond": "d squares have one common side length k and their top-left corners match s marker-cell offsets scaled by k",
  "transform": "paint each s source cell as a k x k block at the matched instance origin, clipping off-grid and preserving existing marker cells"
}
</annotation>
<generation_spec>
