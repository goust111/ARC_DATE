+        for r in range(region_h)
+        for c in range(region_w)
+        if not (r < 2 and c < 2) and not (r < scaled_side and c < scaled_side)
+    ]
+    fallback = [
+        (r, c)
+        for r in range(region_h)
+        for c in range(region_w)
+        if not (r < 2 and c < 2)
+    ]
+    if len(preferred) >= count and random.random() < 0.8:
+        random.shuffle(preferred)
+        return preferred
+    random.shuffle(fallback)
+    return fallback
+
+
