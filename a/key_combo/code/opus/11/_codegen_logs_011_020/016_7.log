+
+        grey_comps = _component_coords(grey_mask)
+        if not grey_comps:
+            continue
+
+        keep = _largest_component(grey_comps)
+        _counts, color, _unique = _region_boundary_profile(drawn, line_mask, region)
+        for r, c in keep:
+            out[int(r), int(c)] = int(color)
