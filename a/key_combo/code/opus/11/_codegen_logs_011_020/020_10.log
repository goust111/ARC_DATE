+        top_h = int(sprite_h + _RNG.integers(1, 4))
+        lower_lead = int(_RNG.integers(0, 2))
+        lower_tail = int(_RNG.integers(0, 3))
+        lower_h = lower_lead + (2 * instr_count - 1) + lower_tail
+        height = top_h + 1 + lower_h
