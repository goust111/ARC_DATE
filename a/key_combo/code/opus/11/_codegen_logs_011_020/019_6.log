+    choice = min(
+        visible,
+        key=lambda item: (
+            item["dist"],
+            item["axis_priority"],
+            item["dir_priority"],
+            item["anchor_id"],
+        ),
+    )
+    return {
+        "src": src,
+        "color": color,
+        "visible": visible,
+        "blocked": blocked,
+        "choice": choice,
