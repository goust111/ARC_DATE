+    h, w = shape
+    border = [(0, c) for c in range(w)]
+    border.extend((r, w - 1) for r in range(1, h))
+    border.extend((h - 1, c) for c in range(w - 2, -1, -1))
+    border.extend((r, 0) for r in range(h - 2, 0, -1))
+    return border
