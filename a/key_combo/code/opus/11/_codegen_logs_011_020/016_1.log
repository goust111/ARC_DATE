+    out = ray_grid.copy()
+    for idx, comp in enumerate(regions):
+        color = FILL_SEQUENCE[idx % len(FILL_SEQUENCE)]
+        for r, c in comp["cells"]:
+            out[r, c] = color
+    return out
+
