+        return None
+
+    areas = [int(comp["area"]) for comp in comps]
+    if min(areas) < 3:
+        return None
+    if max(areas) - min(areas) < 2:
+        return None
+
+    reason_set = set(reasons)
+    if "obstacle" not in reason_set:
+        return None
+    if len(reason_set) < 2:
+        return None
+
+    if rng.random() < 0.4 and not _has_area_tie(areas):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
