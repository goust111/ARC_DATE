+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+
+FILL_SEQUENCE = (BLUE, RED, GREEN, ORANGE, MAGENTA, CYAN)
+
+SIZE_OPTIONS = (11, 13, 15, 17)
+COUNT_OPTIONS = (2, 2, 3, 3, 4)
+MAX_GENERATION_ATTEMPTS = 500
