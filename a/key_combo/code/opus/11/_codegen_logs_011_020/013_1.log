+
+    output_colors = {int(v) for v in np.unique(actual) if int(v) != BLACK}
+    if len(output_colors) < 3:
+        return None
+
+    if bar_count >= 6 and len(output_colors & {BLUE, RED, GREEN, YELLOW, PINK}) < 5:
+        return None
+
+    return grid
