+    out = np.full(g.shape, bg, dtype=int)
+    h, w = g.shape
+
+    for rank, bar in enumerate(ranked, start=1):
+        color = STAMP_CYCLE[(rank - 1) % len(STAMP_CYCLE)]
+        r = bar["top"]
+        c = bar["col"]
+
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                rr = r + dr
