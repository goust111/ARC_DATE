+
+
+def _preset_blockers(base_grid: np.ndarray, square_coords: np.ndarray) -> list[tuple[int, int]] | None:
+    quad = _quadrant_of_coords(square_coords, base_grid.shape)
+    r0, c0, r1, c1 = _bbox_coords(square_coords)
+    if quad == "NW":
