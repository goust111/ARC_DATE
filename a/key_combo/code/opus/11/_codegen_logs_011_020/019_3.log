+        grid = np.rot90(grid, -turns)
+        start = _rotate_coord(start, original_shape, turns)
+        placeholder_coords = [_rotate_coords(coords, original_shape, turns) for coords in placeholder_coords]
+    return grid, start, placeholder_coords, desired
+
+
+def generate_input() -> np.ndarray:
+    global _GEN_STATUS_COUNTER
