+    elif quad == "NE":
+        cells = [(r0 + 1, c0 - 2), (r0 + 3, c0 - 2), (r1 + 2, c0 + 1), (r1 + 2, c0 + 3), (r0 - 2, c1 + 2)]
+    elif quad == "SW":
+        cells = [(r0 + 1, c1 + 2), (r0 + 3, c1 + 2), (r0 - 2, c0 + 1), (r0 - 2, c0 + 3), (r1 + 2, c0 - 2)]
+    else:
+        cells = [(r0 + 1, c0 - 2), (r0 + 3, c0 - 2), (r0 - 2, c0 + 1), (r0 - 2, c0 + 3), (r1 + 2, c1 + 2)]
+
+    unique = []
