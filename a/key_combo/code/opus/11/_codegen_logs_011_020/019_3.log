+    target_count = random.randint(3, 5)
+    core_candidates = candidates
+    if desired[0] != desired[1]:
+        block_index = 0 if not desired[0] else 1
+        core_candidates = path_pools[block_index] + [c for c in candidates if c not in set(path_pools[block_index])]
+
+    min_core = 0 if desired == (True, True) else 1
+    max_core = min(3, len(core_candidates))
