+            parent[cell] = None
+            q.append(cell)
+
+    end = None
+    while q:
+        cell = q.popleft()
+        if cell in targets:
+            end = cell
+            break
+        for nr, nc in _neighbors4(*cell):
+            nxt = (nr, nc)
+            if (
+                _in_bounds(grid.shape, nr, nc)
