+from __future__ import annotations
+
+import numpy as np
+
+
+GREY = 5
+BACKGROUND = 0
+PALETTE = (1, 2, 3, 4, 6)
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+AREA_TO_SHAPES = {
+    6: ((2, 3), (3, 2)),
+    8: ((2, 4), (4, 2)),
+    9: ((3, 3),),
+    12: ((3, 4), (4, 3)),
+    16: ((4, 4),),
+}
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS.values():
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _marker_offset(height: int, width: int, direction: str) -> tuple[int, int]:
+    if direction == "up":
+        return 0, (width - 1) // 2
+    if direction == "down":
+        return height - 1, (width - 1) // 2
+    if direction == "left":
+        return (height - 1) // 2, 0
+    if direction == "right":
+        return (height - 1) // 2, width - 1
+    raise ValueError(direction)
+
+
+def _shape_options(area: int, direction: str) -> list[tuple[int, int]]:
+    out = []
+    for height, width in AREA_TO_SHAPES[area]:
+        if direction in ("up", "down") and width <= 2:
+            continue
+        if direction in ("left", "right") and height <= 2:
+            continue
+        out.append((height, width))
+    return out
+
+
+def _extract_rectangles(grid: np.ndarray) -> list[dict]:
