+def paint_bridge(
+    out: np.ndarray, geom: tuple[str, int, int, int], color: int = BRIDGE
+) -> None:
+    axis, fixed, start, end = geom
+    if axis == "H":
+        if 0 <= fixed < out.shape[0]:
+            c0 = max(0, start)
+            c1 = min(out.shape[1] - 1, end)
+            if c0 <= c1:
