+def reconstruct_all_rects(
+    grid: np.ndarray,
+) -> dict[int, list[tuple[int, int, int, int]]]:
+    visible = rects_from_grid(grid)
+    return {
+        color: infer_full_rects_for_color(rects, grid.shape)
+        for color, rects in visible.items()
+    }
