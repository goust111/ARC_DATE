+import random
+from collections import Counter, defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+BRIDGE = 8
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+FG_COLORS = [1, 2, 3, 4, 6, 7, 9]
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def find_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def component_bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def clip_rect_to_grid(
+    box: tuple[int, int, int, int], shape: tuple[int, int]
+) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = box
+    h, w = shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(h - 1, r1)
+    cc1 = min(w - 1, c1)
+    if rr0 > rr1 or cc0 > cc1:
+        return None
+    return rr0, cc0, rr1, cc1
+
+
+def paint_rect(grid: np.ndarray, box: tuple[int, int, int, int], color: int) -> None:
+    clipped = clip_rect_to_grid(box, grid.shape)
+    if clipped is None:
+        return
+    r0, c0, r1, c1 = clipped
+    grid[r0 : r1 + 1, c0 : c1 + 1] = color
