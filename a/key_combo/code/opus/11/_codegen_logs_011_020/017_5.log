+    return grid, fixed, visible_boxes, full_boxes
+
+
+def _group_params_variants() -> list[tuple[int, str]]:
+    return [
+        (4, "internal1"),
+        (5, "internal1"),
+        (5, "internal2"),
+        (4, "clip1"),
+        (5, "clip2"),
+    ]
+
