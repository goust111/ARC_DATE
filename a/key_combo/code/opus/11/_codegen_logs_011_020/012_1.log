+        (True, 1): [],
+        (True, 2): [],
+        (False, 0): [],
+        (False, 1): [],
+        (False, 2): [],
+    }
+
+    for h in range(4, 7):
+        for w in range(4, 7):
+            base = np.zeros((h, w), dtype=bool)
+            base[0, :] = True
+            base[-1, :] = True
+            base[:, 0] = True
+            base[:, -1] = True
