+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME = 5
+AREA_TO_COLOR = {
+    0: 2,  # area 2..3 -> red
+    1: 1,  # area 4..5 -> blue
+    2: 3,  # area 6..8 -> green
+}
+
+_CATALOG: dict[tuple[bool, int], list[np.ndarray]] | None = None
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _hole_mask_from_patch(patch: np.ndarray) -> np.ndarray:
+    h, w = patch.shape
+    black = patch == BACKGROUND
+    outside = np.zeros((h, w), dtype=bool)
+    stack: list[tuple[int, int]] = []
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if black[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((r, c))
+    for c in range(w):
+        for r in (0, h - 1):
+            if black[r, c] and not outside[r, c]:
+                outside[r, c] = True
+                stack.append((r, c))
+
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and black[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                stack.append((nr, nc))
+
+    return black & ~outside
+
+
+def _area_bin(area: int) -> int | None:
+    if 2 <= area <= 3:
+        return 0
+    if 4 <= area <= 5:
+        return 1
+    if 6 <= area <= 8:
+        return 2
+    return None
+
+
+def _max_degree(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    best = 0
+    for r, c in np.argwhere(mask):
+        degree = 0
+        for nr, nc in _neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                degree += 1
+        best = max(best, degree)
+    return best
+
+
+def _has_interior_2x2(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    for r in range(1, h - 2):
+        for c in range(1, w - 2):
+            if mask[r : r + 2, c : c + 2].all():
+                return True
+    return False
+
+
+def _is_reasonable_frame(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    base_area = 2 * h + 2 * w - 4
+    extra_grey = int(mask.sum()) - base_area
