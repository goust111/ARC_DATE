+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME = 5
+AREA_TO_COLOR = {
+    0: 2,  # area 2..3 -> red
+    1: 1,  # area 4..5 -> blue
+    2: 3,  # area 6..8 -> green
