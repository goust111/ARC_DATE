+        holes = _component_holes(comp, g.shape)
+        hole_count = int(holes.sum())
+        if 1 <= hole_count <= 2:
+            out[holes] = SMALL_FILL
+        elif hole_count >= 3:
+            out[holes] = LARGE_FILL
+
+    return out
