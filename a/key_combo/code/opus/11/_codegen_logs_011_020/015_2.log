+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+CTRL = 2
+FG = 3
+SMALL_FILL = 5
+LARGE_FILL = 7
+
+SMALL_DIMS = ((3, 3), (3, 4), (4, 3))
+LARGE_DIMS = ((4, 4),)
+GEN_ATTEMPTS = 400
