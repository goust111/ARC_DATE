+
+
+def _horizontal_piece(
+    grid: np.ndarray,
+    *,
+    left: int,
+    side: str,
+    cut_row: int,
+    height: int,
+    width: int,
+    open_after_cut: bool,
+) -> tuple[int, int]:
+    if side == "top":
+        bottom = cut_row if open_after_cut else cut_row - 1
+        r0 = bottom - height + 1
+    else:
+        r0 = cut_row if open_after_cut else cut_row + 1
