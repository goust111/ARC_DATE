+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(coords, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _component_holes(coords: np.ndarray, shape: tuple[int, int] | None = None) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    fg_mask = np.zeros((h, w), dtype=bool)
+    fg_mask[coords[:, 0] - r0, coords[:, 1] - c0] = True
+
+    bg_mask = ~fg_mask
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for rr in range(h):
+        for cc in (0, w - 1):
+            if bg_mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+    for cc in range(w):
+        for rr in (0, h - 1):
+            if bg_mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+
+    while q:
+        rr, cc = q.popleft()
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and bg_mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = bg_mask & ~outside
+    if shape is None:
+        shape = (int(coords[:, 0].max()) + 1, int(coords[:, 1].max()) + 1)
+    out = np.zeros(shape, dtype=bool)
+    out[r0 : r1 + 1, c0 : c1 + 1] = holes
+    return out
+
+
+def _hole_components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
