+    grid = np.full((h, w), BG, dtype=int)
+
+    edge = random.choice(("top", "bottom"))
+    ctrl_points = [(0 if edge == "top" else h - 1, cut_col)]
+    grid[ctrl_points[0]] = CTRL
+
+    left_status = ("small", False)
