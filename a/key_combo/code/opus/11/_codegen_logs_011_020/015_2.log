+def _choose_cut_positions(h: int, w: int) -> tuple[int, int]:
+    return random.randint(5, h - 6), random.randint(5, w - 6)
+
+
+def _vertical_piece(
+    grid: np.ndarray,
+    *,
+    top: int,
+    side: str,
