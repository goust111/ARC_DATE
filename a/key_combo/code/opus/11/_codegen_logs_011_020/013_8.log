+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+GEN_RETRIES = 400
+
+SIDE_TO_MARKER_SLOTS = {
+    0: ("nw", "ne"),
+    1: ("ne", "se"),
+    2: ("sw", "se"),
+    3: ("nw", "sw"),
