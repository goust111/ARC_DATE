+def _extend_seed(seed: np.ndarray, out_h: int, out_w: int, period: int, dc: int) -> np.ndarray:
+    out = np.zeros((out_h, out_w), dtype=int)
+    seed_h, seed_w = map(int, seed.shape)
+    copy_h = min(out_h, seed_h)
+    copy_w = min(out_w, seed_w)
