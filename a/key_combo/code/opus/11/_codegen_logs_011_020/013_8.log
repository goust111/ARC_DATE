+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert patch.shape[0] >= 3 and patch.shape[1] >= 3
+    border = np.zeros_like(patch, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
