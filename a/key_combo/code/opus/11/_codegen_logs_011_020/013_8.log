def _normalized(points: dict[int, tuple[int, int]]) -> dict[int, tuple[int, int]]:
    rows = [r for r, _ in points.values()]
    cols = [c for _, c in points.values()]
    r0 = min(rows)
    c0 = min(cols)
    return {color: (r - r0, c - c0) for color, (r, c) in points.items()}


