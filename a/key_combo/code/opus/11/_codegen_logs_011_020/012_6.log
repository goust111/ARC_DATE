+def _random_motif(tile_size: int) -> np.ndarray:
+    area = tile_size * tile_size
+    min_fg = max(4, area // 4)
+    max_fg = min(area - 2, max(min_fg, area // 2))
+    fg_count = random.randint(min_fg, max_fg)
+    motif = np.full((tile_size, tile_size), BLACK, dtype=int)
