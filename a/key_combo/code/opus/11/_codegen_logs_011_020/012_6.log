+GREEN = 3
+GREY = 5
+
+RETRY_LIMIT = 500
+
+
+def _separator_lines(grid: np.ndarray, axis: int) -> list[int]:
+    assert axis in (0, 1)
+    indices: list[int] = []
+    limit = grid.shape[axis]
+    for idx in range(limit):
+        line = grid[idx, 1:-1] if axis == 0 else grid[1:-1, idx]
+        if line.size > 0 and np.all(line == GREY):
+            indices.append(idx)
+    return indices
+
