+            "down": dist_values[1],
+            "left": dist_values[2],
+            "right": dist_values[3],
+        }
+        grid = _build_input(height, width, patch, distances)
+        if _valid_generated(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid input")

