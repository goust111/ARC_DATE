+
+
+def _gen_horizontal_attempt() -> np.ndarray:
+    repeated_color, singleton_a, singleton_b = random.sample(PALETTE, 3)
+    left_depth = random.choice(DEPTH_OPTIONS)
+    right_depth = random.choice(DEPTH_OPTIONS)
