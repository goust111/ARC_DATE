+        width = _actual_coord(axis_margin, max_track_unit) + BLOCK_SIZE + random.randint(1, 3)
+    else:
+        height = _actual_coord(axis_margin, max_track_unit) + BLOCK_SIZE + random.randint(1, 3)
+        width = perps[-1] + BLOCK_SIZE + random.randint(1, 3)
