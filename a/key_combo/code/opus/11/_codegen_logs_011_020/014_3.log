+    def backtrack(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        palette = list(BLOCK_COLORS)
+        random.shuffle(palette)
+        for color in palette:
+            if any(colors[other] == color for other in diff_edges[idx]):
+                continue
+            colors[idx] = color
+            if backtrack(pos + 1):
