+
+    if not isinstance(out, np.ndarray) or out.shape != inp.shape:
+        return None
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
