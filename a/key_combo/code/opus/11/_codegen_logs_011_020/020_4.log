6:def main(grid: np.ndarray) -> np.ndarray:
7:    """
8:    Reorder and stack rectangles by proximity to two colored edge lines.
9:
10:    Input structure:
11:    - bg = most common color.
12:    - Two edge lines (h + v) meet at a corner marked by a unique color.
13:    - "Blue" line is color 1 if present, else the longer line; other is "red."
14:    - Solid rectangles in the interior.
15:
16:    Rule:
17:    - Sort rectangles by (distance to blue edge, distance to red edge).
18:    - If the blue edge is vertical, rotate each rectangle 90° CCW.
19:    - Stack top-to-bottom, centered horizontally.
20:
21:    Key insight: Edge-line colors encode a coordinate system; proximity to each axis determines stacking order and rotation.
22:    """
23:    g = np.array(grid, dtype=int)
24:    H, W = g.shape
25:    bg = int(get_bg(g))
26:
27:    # --- locate the marked corner ---
28:    corners = [(0, 0), (0, int(W - 1)), (int(H - 1), 0), (int(H - 1), int(W - 1))]
29:    corner = None
30:    for r, c in corners:
31:        if int(g[r, c]) == int(bg):
32:            continue
33:        nbr = []
34:        if r == 0:
35:            nbr.append(int(g[r + 1, c]))
36:        if r == H - 1:
37:            nbr.append(int(g[r - 1, c]))
38:        if c == 0:
39:            nbr.append(int(g[r, c + 1]))
40:        if c == W - 1:
41:            nbr.append(int(g[r, c - 1]))
42:        if nbr and all(int(n) != int(g[r, c]) for n in nbr):
43:            corner = (int(r), int(c))
44:            break
45:    assert corner is not None
46:
47:    cr, cc = map(int, corner)
48:    marker = int(g[cr, cc])
49:
50:    # --- line colors adjacent to the corner ---
51:    hstep = 1 if cc == 0 else -1
52:    vstep = 1 if cr == 0 else -1
53:    hcol = int(g[cr, cc + hstep])
54:    vcol = int(g[cr + vstep, cc])
55:
56:    # Choose "blue" line color.
57:    if hcol == 1 or vcol == 1:
58:        blue_col = 1
59:        red_col = int(vcol if hcol == 1 else hcol)
60:    else:
61:        # Fallback: longer line is blue.
62:        hlen = 0
63:        c = int(cc + hstep)
64:        while 0 <= c < W and int(g[cr, c]) == int(hcol):
65:            hlen += 1
66:            c += int(hstep)
67:        vlen = 0
68:        r = int(cr + vstep)
69:        while 0 <= r < H and int(g[r, cc]) == int(vcol):
70:            vlen += 1
71:            r += int(vstep)
72:        if vlen >= hlen:
73:            blue_col = int(vcol)
74:            red_col = int(hcol)
75:        else:
76:            blue_col = int(hcol)
77:            red_col = int(vcol)
78:
79:    blue_orient = "h" if int(hcol) == int(blue_col) else "v"
80:    red_orient = "h" if int(hcol) == int(red_col) else "v"
81:
82:    # --- mask out the two edge lines (entire corner row + col) ---
83:    line_mask = np.zeros((H, W), dtype=bool)
84:    line_mask[cr, :] = True
85:    line_mask[:, cc] = True
86:
87:    # --- extract solid rectangles (no bg inside bbox) ---
88:    mask = (g != int(bg)) & (~line_mask) & (g != int(marker))
89:    rects = []
90:    for coords in components_mask(mask, connectivity=4):
91:        if coords.size == 0:
92:            continue
93:        b = bbox_coords(coords)
94:        sub = crop_bbox(g, b)
95:        if bool((sub == int(bg)).any()):
96:            continue
