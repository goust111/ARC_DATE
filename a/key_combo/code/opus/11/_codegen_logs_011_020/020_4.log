15:def main(input_grid):
16:    """
17:    Build successive rows by extending a left-to-right color run one cell at a time.
18:
19:    Input structure:
20:    - The input is a single row with one non-black color run and black remainder.
21:    - The row length is even.
22:    - The run starts at the left and grows rightward.
23:
24:    Rule:
25:    - Copy the input row as the first output row.
26:    - For each following row up to half the row length, add one colored cell to the right if possible.
27:    - Stack the generated rows into the output grid.
28:
29:    Key insight:
30:    - Each row represents the previous count incremented by one, capped by the row width.
31:    """
32:    # input is a single row; we grow the run of `color` to the right one pixel per row.
33:    row = np.array(input_grid[0], dtype=int).copy()
34:    L = int(row.shape[0])
35:    color = int(next(v for v in row.tolist() if v != Color.BLACK))
36:
37:    out_rows = [row.copy()]
38:    for _ in range(L // 2 - 1):
39:        rightmost = int(np.where(row == color)[0][-1])
40:        if rightmost < L - 1:
41:            row[rightmost + 1] = color
42:        out_rows.append(row.copy())
43:    return np.stack(out_rows, axis=0)
