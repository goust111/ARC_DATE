+_GRID_RANGE = (10, 14)
+_COUNT_CHOICES = (3, 4)
+_AREAS = (1, 2, 3, 4)
+_PALETTE = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+_MAX_ATTEMPTS = 400
+
