+    for idx, obj in enumerate(objects):
+        mask = np.asarray(obj["mask"], dtype=int)
+        h, w = map(int, mask.shape)
+        col = random.randint(0, grid_w - w)
+        color = int(obj["color"])
+        grid[row : row + h, col : col + w][mask == 1] = color
+        placed.append(
