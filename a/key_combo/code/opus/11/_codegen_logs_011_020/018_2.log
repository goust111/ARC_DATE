+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+TOP_COLOR = 1
+RIGHT_COLOR = 2
+BOTTOM_COLOR = 3
+LEFT_COLOR = 4
+CONTROL_COLOR = 5
+
+QUADRANTS = ("ul", "ur", "lr", "ll")
+DIRECTIONS = ("top", "right", "bottom", "left")
+BASE_MISMATCH_SPECS = (
+    ("ul", "left"),
+    ("ur", "top"),
+    ("lr", "right"),
+    ("ll", "bottom"),
+)
