+DIRECTIONS = ("top", "right", "bottom", "left")
+BASE_MISMATCH_SPECS = (
+    ("ul", "left"),
+    ("ur", "top"),
+    ("lr", "right"),
+    ("ll", "bottom"),
+)
+MATCH_SPECS = (
+    ("ul", "top"),
+    ("ur", "right"),
+    ("lr", "bottom"),
+    ("ll", "left"),
+)
+GRID_SIZE_CHOICES = (13, 15, 17, 19)
