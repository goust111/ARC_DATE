+            c0, c1 = min(cols), max(cols)
+            patch = g[r0 : r1 + 1, c0 : c1 + 1]
+            assert np.all(patch == color), "each foreground object must be a solid rectangle"
+            rects.append(
+                {
+                    "color": color,
+                    "bbox": (r0, c0, r1, c1),
+                    "h": r1 - r0 + 1,
+                    "w": c1 - c0 + 1,
+                    "area": (r1 - r0 + 1) * (c1 - c0 + 1),
