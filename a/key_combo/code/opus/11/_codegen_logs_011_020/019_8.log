+
+
+BLACK = 0
+PALETTE = (1, 2, 3, 4, 6)
+SIZE_CHOICES = tuple((h, w) for h in range(2, 6) for w in range(2, 6))
+GEN_ATTEMPTS = 1200
+FIVE_LAYOUT = (
+    (6, 15, 3, 2),
+    (18, 10, 4, 4),
+    (1, 13, 4, 5),
+    (14, 4, 5, 4),
+    (10, 9, 5, 5),
