+            _ray_hits(grid, (r0 - 1, c1 + 1), (-1, 1), color),
+            _ray_hits(grid, (r1 + 1, c0 - 1), (1, -1), color),
+            _ray_hits(grid, (r1 + 1, c1 + 1), (1, 1), color),
+        ]
+    )
