+
+def _area_order(rects: list[dict[str, int | tuple[int, int, int, int]]]) -> list[int]:
+    return [
+        int(rect["color"])
+        for rect in sorted(
+            rects,
+            key=lambda rect: (-int(rect["area"]), -max(int(rect["h"]), int(rect["w"]))),
+        )
+    ]
