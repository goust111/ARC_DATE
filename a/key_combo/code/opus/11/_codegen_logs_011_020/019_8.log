+def _find_rectangles(grid: np.ndarray) -> list[dict[str, int | tuple[int, int, int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros_like(g, dtype=bool)
+    rects: list[dict[str, int | tuple[int, int, int, int]]] = []
+
