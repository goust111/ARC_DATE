def _build_non_overlap_rects(n_marked, overlap_band_h, avail_h, avail_w, near_rows, near_cols, marked_bases, marker_color, pairs):
    min_h, max_h = RECT_H_RANGE
    min_w, max_w = RECT_W_RANGE
