+def _match_candidates(candidates: list[dict], pockets: list[dict]) -> list[dict]:
+    matches = []
+    for cand_idx, cand in enumerate(candidates):
+        for rotated in _unique_rotations(cand["patch"]):
+            rot_mask = rotated != BLACK
