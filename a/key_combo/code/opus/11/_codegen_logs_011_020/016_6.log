spec:
  grid: odd square, side length 7-13 (radius = side//2, range 3-6)
  background: single dominant color filling all non-marker cells [observed: always 7]
  markers:
    count: radius + 1 (one per Chebyshev distance 0..radius from center)
    each_size: exactly 1 pixel
    colors: all mutually distinct, all != background
    placement: exactly one marker at each Chebyshev distance d from grid center (d=0 is the center cell itself)
    position_within_ring: any valid cell at that Chebyshev distance (no further constraint)
  output:
    same dimensions as input
    concentric square rings centered on grid center
    ring at distance d filled with the color of the marker whose Chebyshev distance is d
