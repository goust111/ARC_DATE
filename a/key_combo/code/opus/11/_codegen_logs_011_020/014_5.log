+            final_left = c1 - shape_w + 1
+            max_gap = final_left - (c0 + 1)
+            if max_gap < 1:
+                return None
+            gap = random_gap(rng, max_gap, shape_w, branch_targets[idx])
+            start_left = final_left - gap
+        else:
