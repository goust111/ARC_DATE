+GEN_RETRIES = 500
+GRID_MIN = 12
+GRID_MAX = 19
+CARRIER_COUNT_CHOICES = (2, 3)
+RECT_HEIGHT_CHOICES = (4, 5, 6, 7)
+RECT_WIDTH_CHOICES = (4, 5, 6, 7, 8, 9)
