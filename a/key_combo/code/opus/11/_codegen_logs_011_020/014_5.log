+
+    has_overlap_case = False
+    has_disjoint_case = False
+    for idx, (rect, color, shape) in enumerate(specs):
+        r0, c0, r1, c1 = rect
+        car_h = r1 - r0 + 1
+        shape_h = max(r for r, _ in shape) + 1
+        shape_w = max(c for _, c in shape) + 1
+
+        top_low = r0 + 1
+        top_high = r1 - shape_h
+        if top_low > top_high:
+            return None
+        top = int(rng.integers(top_low, top_high + 1))
+
