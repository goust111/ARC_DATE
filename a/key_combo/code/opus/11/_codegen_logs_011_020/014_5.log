+import numpy as np
+from collections import deque
+
+
+class Color:
+    BLACK = 0
+    BLUE = 1
+    RED = 2
+    GREEN = 3
+    YELLOW = 4
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(cells, dtype=int))
+    return parts
+
+
+def same_color_component(grid: np.ndarray, start: tuple[int, int], color: int) -> np.ndarray:
+    q = deque([start])
+    seen = {start}
+    cells = []
+    while q:
+        r, c = q.popleft()
+        cells.append((r, c))
+        for nr, nc in neighbors4(r, c):
+            if in_bounds(grid.shape, nr, nc) and (nr, nc) not in seen and int(grid[nr, nc]) == color:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return np.array(cells, dtype=int)
+
+
+def normalize_shape(coords: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    r0 = min(r for r, _ in coords)
+    c0 = min(c for _, c in coords)
+    return tuple(sorted((r - r0, c - c0) for r, c in coords))
+
+
+def transform_shape(
+    shape: tuple[tuple[int, int], ...], rot: int, flip_h: bool, flip_v: bool
+) -> tuple[tuple[int, int], ...]:
+    coords = list(shape)
+    for _ in range(rot % 4):
+        coords = [(c, -r) for r, c in coords]
+    if flip_h:
+        coords = [(r, -c) for r, c in coords]
+    if flip_v:
+        coords = [(-r, c) for r, c in coords]
