+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return False
+    start = tuple(int(v) for v in coords[0])
+    seen = {start}
+    queue = deque([start])
+    while queue:
+        r, c = queue.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                if (nr, nc) not in seen:
+                    seen.add((nr, nc))
+                    queue.append((nr, nc))
+    return len(seen) == int(mask.sum())
+
