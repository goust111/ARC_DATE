+def _cell_positions(n: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    edge, interior = [], []
+    for i in range(n):
+        for j in range(n):
+            if i in (0, n - 1) or j in (0, n - 1):
+                edge.append((i, j))
+            else:
