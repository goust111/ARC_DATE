+    group = [cell for cell in cells if bool(cell["edge"]) == edge]
+    assert group
+    rep = min(group, key=lambda cell: (int(cell["count"]), int(cell["row"]), int(cell["col"])))
+    return np.array(rep["mask"], dtype=bool)
