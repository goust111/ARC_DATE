    for _ in range(n_runs):
        c = int(np.random.randint(1, 10))
        while prev is not None and c == prev:
            c = int(np.random.randint(1, 10))
        cols.append(c)
        prev = c
    stripes = [np.full((h, W), col, dtype=int) for col, h in reversed(list(zip(cols, heights)))]
    return np.vstack(stripes)

