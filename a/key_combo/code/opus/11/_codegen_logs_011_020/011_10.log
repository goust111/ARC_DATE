+            for c0 in range(width - pw + 1):
+                rr0 = max(0, r0 - PLACEMENT_GAP)
+                cc0 = max(0, c0 - PLACEMENT_GAP)
+                rr1 = min(height, r0 + ph + PLACEMENT_GAP)
+                cc1 = min(width, c0 + pw + PLACEMENT_GAP)
