+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+FILL_COLORS = (2, 3, 4)
+
+GRID_SIZE_RANGE = (20, 27)
+PLACEMENT_GAP = 2
+GENERATE_ATTEMPTS = 400
