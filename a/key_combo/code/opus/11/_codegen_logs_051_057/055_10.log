+            w = random.randint(*BBOX_SIDE_RANGE)
+        else:
+            h, w = forced_bbox
+
+        min_area = max(AREA_RANGE[0], max(h, w))
+        max_area = min(AREA_RANGE[1], h * w)
+        if require_hole:
+            max_area = min(max_area, h * w - 1)
+        if forced_area is not None:
+            area = forced_area
+            if not (min_area <= area <= max_area):
+                continue
+        else:
+            if min_area > max_area:
