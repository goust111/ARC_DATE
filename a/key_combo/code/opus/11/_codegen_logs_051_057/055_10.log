+def _build_shape_templates(case_id: int, scale: int) -> list[np.ndarray] | None:
+    forbidden_keys: set[tuple[tuple[int, int], bytes]] = set()
+    forbidden_dihedrals: set[tuple[tuple[int, int], bytes]] = set()
