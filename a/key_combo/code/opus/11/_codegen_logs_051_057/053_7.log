+    if len(marker_slots) < 4:
+        return None
+
+    double_count = rng.randint(1, min(3, len(marker_slots) - 2))
+    single_count = rng.randint(1, min(4, len(marker_slots) - double_count - 1))
+    while double_count + single_count < 4:
+        if single_count < min(4, len(marker_slots) - double_count):
+            single_count += 1
+        elif double_count < min(3, len(marker_slots) - single_count):
+            double_count += 1
+        else:
+            break
+
+    chosen = rng.sample(marker_slots, double_count + single_count)
+    doubles = sorted(chosen[:double_count])
+    singles = sorted(chosen[double_count:])
+    grid[1, singles] = RED
+    grid[1, doubles] = RED
+    grid[2, doubles] = RED
+
+    all_cols = set(range(w))
+    empty_cols = sorted(all_cols - set(singles) - set(doubles))
+    if len(empty_cols) < 2:
+        return None
+
+    specs = _build_specs(rng, singles, doubles, empty_cols)
+    single_set = set(singles)
+    double_set = set(doubles)
+    blocked: set[tuple[int, int]] = set()
+
+    for category, target_col, require_off_ray in specs:
+        shape_order = list(SHAPES)
+        rng.shuffle(shape_order)
+        candidates: list[list[tuple[int, int]]] = []
+        for shape in shape_order:
+            candidates.extend(
+                _candidate_object_cells(
+                    shape,
+                    h,
+                    w,
+                    blocked,
+                    category,
