        if inb(cur[0],cur[1]+dc) and (cur[0],cur[1]+dc) in walls:
            dc=-dc; events.append('side_h')
    return False,'limit',path,events

def shapes_at(top,left,orient):
    return (top,left,top,left+1) if orient=='h' else (top,left,top+1,left)

best=[]
for trial in range(2000000):
    upper_or=random.choice('hv'); lower_or=random.choice('hv')
    ut=random.randint(0,4); ul=random.randint(3,10)
