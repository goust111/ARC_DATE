import random, itertools, math
from collections import defaultdict

H=W=10

def inb(r,c): return 0<=r<H and 0<=c<W

def start_end(upper, lower):
    ur0,uc0,ur1,uc1=upper
    lr0,lc0,lr1,lc1=lower
    if uc1 < lc0:
        return (ur1,uc1),(lr0,lc0),1
    if lc1 < uc0:
        return (ur1,uc0),(lr0,lc1),-1
    return None

def rect_cells(b):
    r0,c0,r1,c1=b
    return {(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)}

def sim(upper, lower, walls, occupied=()):
    se = start_end(upper, lower)
    if not se: return None
    start, target_corner, dc = se
    target = rect_cells(lower)
    blockers=set(occupied)
    walls=set(walls)
    rects=rect_cells(upper)|target
    path=[]
    events=[]
    cur=start
    dr=1
    for step in range(50):
        nr,nc=cur[0]+dr,cur[1]+dc
        if not inb(nr,nc):
            return {'success':False,'reason':'out','path':path,'events':events,'end':cur}
        if (nr,nc) in blockers:
            return {'success':False,'reason':'blocker','path':path,'events':events,'end':cur}
        if (nr,nc) in target:
            return {'success':True,'reason':'target','path':path,'events':events,'end':cur}
        if (nr,nc) in rects:
            return {'success':False,'reason':'rect','path':path,'events':events,'end':cur}
        if (nr,nc) in walls:
            cand=(cur[0]+dr,cur[1]-dc)
            if inb(*cand) and cand not in walls and cand not in rects and cand not in blockers:
                dc=-dc
                events.append('head_h')
                continue
            cand=(cur[0]-dr,cur[1]+dc)
            if inb(*cand) and cand not in walls and cand not in rects and cand not in blockers:
                dr=-dr
                events.append('head_v')
                continue
            return {'success':False,'reason':'stuck','path':path,'events':events,'end':cur}
        cur=(nr,nc)
        path.append(cur)
        sv=(cur[0]+dr,cur[1])
        sh=(cur[0],cur[1]+dc)
        vertical = inb(*sv) and sv in walls
        horizontal = inb(*sh) and sh in walls
        if vertical:
            dr=-dr
            events.append('side_v')
        if horizontal:
            dc=-dc
            events.append('side_h')
    return {'success':False,'reason':'limit','path':path,'events':events,'end':cur}

def shapes_at(top,left,orient):
    if orient=='h': return (top,left,top,left+1)
    return (top,left,top+1,left)

cats=defaultdict(list)
for upper_or in 'hv':
  for lower_or in 'hv':
    for ut in range(0,3):
      for ul in range(2,6):
        upper=shapes_at(ut,ul,upper_or)
        for dcdir in (1,-1):
          for gap in range(3,7):
            if dcdir==1:
              s=(upper[2],upper[3])
              end=(s[0]+gap,s[1]+gap)
              lower=shapes_at(end[0], end[1] if lower_or=='h' else end[1], lower_or)
            else:
