+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    blocked_paths: set[tuple[int, int]] = set()
+
+    for pair in _extract_pairs(g):
+        trace = _trace_pair(g, pair, blocked_paths)
+        if trace["success"]:
+            for r, c in trace["path"]:
+                if int(out[r, c]) == BG:
