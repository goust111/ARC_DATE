+    start = pair["start"]
+    dr, dc = 1, int(pair["dc"])
+    upper_cells = _rect_cells(pair["upper"])
+    target_cells = _rect_cells(pair["lower"])
+    rect_obstacles = {(r, c) for r, c in np.argwhere((g != BG) & (g != WALL))}
+    rect_obstacles -= target_cells
+
