                walls=set(walls)
                if not any(p in walls for p in diag[:-1]):
                  continue
                res=sim(upper,lower,walls)
                if not res: continue
                key=('S' if res['success'] else 'F', tuple(sorted(set(res['events']))), res['reason'])
                cats[key].append((upper,lower,walls,res))
              
print('categories', len(cats))
for k,v in sorted(cats.items(), key=lambda kv:-len(kv[1]))[:20]:
    print(k, len(v))
