+    row_slack = CELL_SIZE - (local["max_r"] + 1)
+    col_slack = CELL_SIZE - (local["max_c"] + 1)
+    dr = origin[0] + random.randint(0, max(0, row_slack))
+    dc = origin[1] + random.randint(0, max(0, col_slack))
