+    max_r = max(r for r, _c in cells)
+    max_c = max(c for _r, c in cells)
+    return {
+        "upper": upper,
+        "lower": lower,
+        "walls": walls,
+        "max_r": max_r,
+        "max_c": max_c,
+    }
+
+
+def _shift_box(box: tuple[int, int, int, int], dr: int, dc: int) -> tuple[int, int, int, int]:
