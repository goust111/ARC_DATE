+    return (r0 + dr, c0 + dc, r1 + dr, c1 + dc)
+
+
+def _shift_cells(cells: set[tuple[int, int]], dr: int, dc: int) -> set[tuple[int, int]]:
+    return {(r + dr, c + dc) for r, c in cells}
+
