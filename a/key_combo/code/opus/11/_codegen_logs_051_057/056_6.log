+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+PAIR_COLORS = (1, 2, 3)
+CELL_SIZE = 12
+STAGE_SIZE = 25
+CELL_ORIGINS = ((0, 0), (0, 13), (13, 0), (13, 13))
+MAX_STEPS = 50
