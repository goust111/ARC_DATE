+        pairs.append(
+            {
+                "color": int(color),
+                "upper": tuple(map(int, upper["bbox"])),
+                "lower": tuple(map(int, lower["bbox"])),
+                "start": (int(start[0]), int(start[1])),
+                "dc": int(dc),
+            }
+        )
+    pairs.sort(key=lambda pair: (pair["upper"][0], pair["upper"][1], pair["color"]))
+    return pairs
+
+
+def _trace_pair(
+    grid: np.ndarray,
+    pair: dict,
+    blocked_paths: set[tuple[int, int]] | None = None,
