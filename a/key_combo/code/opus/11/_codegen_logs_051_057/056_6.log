import random
H=W=14

def inb(r,c): return 0<=r<H and 0<=c<W

def rect_cells(b):
    r0,c0,r1,c1=b
    return {(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)}

def start_end(upper, lower):
    ur0,uc0,ur1,uc1=upper; lr0,lc0,lr1,lc1=lower
    if uc1 < lc0: return (ur1,uc1),1
    if lc1 < uc0: return (ur1,uc0),-1
    return None

def sim(upper, lower, walls):
    se = start_end(upper, lower)
    if se is None: return None
    start,dc=se
    target=rect_cells(lower); walls=set(walls); rects=rect_cells(upper)|target
    path=[]; events=[]; cur=start; dr=1; seen=set()
    for step in range(50):
        state=(cur,dr,dc)
        if state in seen: return False,'loop',path,events
        seen.add(state)
        nr,nc=cur[0]+dr,cur[1]+dc
        if not inb(nr,nc): return False,'out',path,events
        if (nr,nc) in target: return True,'target',path,events
        if (nr,nc) in rects: return False,'rect',path,events
        if (nr,nc) in walls:
            cand=(cur[0]+dr,cur[1]-dc)
            if inb(*cand) and cand not in walls and cand not in rects:
