+    return out
+
+
+TEMPLATES = {
+    "head_h_success": {
+        "upper": (0, 4, 1, 4),
+        "lower": (5, 0, 6, 0),
+        "walls": {(6, 6), (2, 3), (7, 1), (3, 6)},
+    },
+    "side_h_success": {
+        "upper": (0, 4, 0, 5),
+        "lower": (4, 0, 5, 0),
+        "walls": {(3, 1), (6, 1), (1, 1), (3, 4)},
+    },
+    "head_v_fail": {
+        "upper": (0, 3, 1, 3),
+        "lower": (4, 6, 5, 6),
+        "walls": {(3, 3), (3, 5), (4, 8)},
