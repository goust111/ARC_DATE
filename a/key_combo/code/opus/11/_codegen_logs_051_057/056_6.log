+
+
+def _mirror_cells_h(cells: set[tuple[int, int]], width: int) -> set[tuple[int, int]]:
+    return {(r, width - 1 - c) for r, c in cells}
+
+
+def _apply_template(name: str, mirror: bool) -> dict:
