+        grid[r0 - 1 : r0 + rh + 1, c0 - 1] = WALL
+        grid[r0 - 1 : r0 + rh + 1, c0 + cw] = WALL
+        grid[r0 - 1, c0 - 1 : c0 + cw + 1] = WALL
+        grid[r0 + rh, c0 - 1 : c0 + cw + 1] = WALL
