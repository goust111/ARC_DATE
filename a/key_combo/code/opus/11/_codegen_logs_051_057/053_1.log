+def _build_walls(room_specs: list[dict]) -> np.ndarray:
+    h = max(spec["r0"] + spec["h"] for spec in room_specs) + 1
+    w = max(spec["c0"] + spec["w"] for spec in room_specs) + 1
+    grid = np.full((h, w), BG, dtype=int)
+    grid[0, :] = WALL
+    grid[-1, :] = WALL
+    grid[:, 0] = WALL
+    grid[:, -1] = WALL
+    for spec in room_specs:
