+    np.array([(0, 0), (1, 0), (2, 0)], dtype=int),                              # 3x1 line
+    np.array([(0, 1), (1, 0), (1, 1), (1, 2)], dtype=int),                      # T tetromino
+    np.array([(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)], dtype=int),              # plus
+    np.array([(0, 0), (0, 1), (0, 2), (1, 1)], dtype=int),                      # top-heavy T
