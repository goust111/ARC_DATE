+    if kind == "four":
+        row_heights = [random.choice([4, 5]), random.choice([4, 5])]
+        col_widths = [random.choice([4, 5]), random.choice([4, 5])]
+        specs = []
+        r0 = 1
+        for rh in row_heights:
+            c0 = 1
+            for cw in col_widths:
+                specs.append({"r0": r0, "c0": c0, "h": rh, "w": cw})
+                c0 += cw + 1
+            r0 += rh + 1
+        return specs
