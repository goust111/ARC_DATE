+
+def _validate_input(grid: np.ndarray) -> list[bool]:
+    assert isinstance(grid, np.ndarray)
+    assert grid.ndim == 2 and max(grid.shape) <= 30
+    assert set(np.unique(grid)).issubset(set(PALETTE) | {BG, WALL})
+    rooms = _room_components(grid)
