+    grid: np.ndarray,
+    forbidden: set[tuple[int, int]],
+    sprite_box: tuple[int, int, int, int],
+) -> None:
+    h, w = grid.shape
+    candidates = []
+    sr0, sc0, sr1, sc1 = sprite_box
+    for r in range(h):
+        for c in range(w):
+            if (r, c) in forbidden:
+                continue
+            if sr0 - 1 <= r <= sr1 + 1 and sc0 - 1 <= c <= sc1 + 1:
+                continue
+            ok = True
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if (nr, nc) in forbidden:
+                    ok = False
+                    break
+            if ok:
+                candidates.append((r, c))
