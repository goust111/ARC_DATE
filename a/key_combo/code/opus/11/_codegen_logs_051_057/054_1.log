from __future__ import annotations

import itertools
import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
TEAL = 8

DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

_SPRITE_MASKS: list[np.ndarray] | None = None


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
    coords = np.argwhere(mask)
    if coords.size == 0:
        return None
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
    r0, c0, r1, c1 = bbox
    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    seen: set[tuple[int, int]] = set()
    out: list[list[tuple[int, int]]] = []
    h, w = mask.shape
    for r, c in np.argwhere(mask):
        start = (int(r), int(c))
        if start in seen:
            continue
        stack = [start]
        seen.add(start)
        comp: list[tuple[int, int]] = []
        while stack:
            rr, cc = stack.pop()
            comp.append((rr, cc))
            for dr, dc in DIRS4:
                nr, nc = rr + dr, cc + dc
                if (
                    0 <= nr < h
                    and 0 <= nc < w
                    and bool(mask[nr, nc])
                    and (nr, nc) not in seen
                ):
                    seen.add((nr, nc))
                    stack.append((nr, nc))
        out.append(comp)
    return out


def _extract_sprite(grid: np.ndarray) -> np.ndarray:
    mask = grid == BLUE
    assert int(mask.sum()) >= 3, "expected one blue sprite"
    comps = _components(mask)
    assert len(comps) == 1, "expected exactly one blue component"
    b = _bbox(mask)
    assert b is not None
    sprite = np.where(_crop_bbox(mask.astype(int), b) != 0, BLUE, BLACK).astype(int)
    return sprite


