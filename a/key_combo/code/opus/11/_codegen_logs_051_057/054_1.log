+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+TEAL = 8
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+_SPRITE_MASKS: list[np.ndarray] | None = None
