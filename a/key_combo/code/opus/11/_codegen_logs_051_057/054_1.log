+    path_set = set(path_cells)
+    if len(path_set) != len(path_cells) or end in path_set:
+        return None
+
+    teal_cells: set[tuple[int, int]] = set()
+    for step_dir in DIRS4:
+        neighbor = _add(start, step_dir)
+        if step_dir != directions[0]:
