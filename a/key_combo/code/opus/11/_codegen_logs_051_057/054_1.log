+    return len(_components(mask)) == 1
+
+
+def _sprite_masks() -> list[np.ndarray]:
+    global _SPRITE_MASKS
+    if _SPRITE_MASKS is not None:
+        return _SPRITE_MASKS
+
+    masks: list[np.ndarray] = []
+    for h, w in ((2, 2), (2, 3), (3, 2), (3, 3)):
