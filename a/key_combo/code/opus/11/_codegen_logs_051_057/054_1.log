+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    out: list[list[tuple[int, int]]] = []
+    h, w = mask.shape
+    for r, c in np.argwhere(mask):
+        start = (int(r), int(c))
+        if start in seen:
+            continue
+        stack = [start]
+        seen.add(start)
+        comp: list[tuple[int, int]] = []
+        while stack:
+            rr, cc = stack.pop()
+            comp.append((rr, cc))
+            for dr, dc in DIRS4:
+                nr, nc = rr + dr, cc + dc
+                if (
+                    0 <= nr < h
+                    and 0 <= nc < w
+                    and bool(mask[nr, nc])
+                    and (nr, nc) not in seen
+                ):
+                    seen.add((nr, nc))
+                    stack.append((nr, nc))
+        out.append(comp)
+    return out
