+    if axis == "vertical":
+        for r, c in coords:
+            mirrored.add((int(r), int(c0 + c1 - c)))
+    else:
+        for r, c in coords:
+            mirrored.add((int(r0 + r1 - r), int(c)))
+    return mirrored
+
