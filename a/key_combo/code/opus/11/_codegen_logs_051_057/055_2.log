  13: def main(grid: np.ndarray) -> np.ndarray:
  14:     """
  15:     Recolor the grey object with the color of the marker set closest to it, erasing all markers.
  16: 
  17:     Input structure
  18:     - The grid has a black background with one 4-connected grey object.
  19:     - Every other foreground color appears as one or more isolated marker pixels.
  20: 
  21:     Rule
  22:     - For each marker color, measure the smallest squared Euclidean distance from any marker pixel of that color to any grey-object pixel.
  23:     - The unique marker color with the smallest such distance becomes the output color.
  24:     - Return a blank background grid with the grey object's mask painted in that selected color.
  25: 
  26:     Key insight
  27:     - The scattered pixels are competing color labels; only the label with the closest approach to the grey object survives.
  28:     """
  29:     g = np.asarray(grid, dtype=int)
  30:     assert g.ndim == 2, "expected a 2D grid"
  31: 
  32:     bg = int(get_bg(g))
  33:     assert bg == Color.BLACK, "expected black background"
  34: 
  35:     grey_mask = g == Color.GREY
  36:     grey_components = components_mask(grey_mask, connectivity=4)
  37:     assert len(grey_components) == 1, "expected exactly one grey object"
  38:     grey_coords = np.argwhere(grey_mask)
  39:     assert grey_coords.size > 0, "expected grey object pixels"
  40: 
  41:     scores: list[tuple[int, int]] = []
  42:     for color in colors_present(g, exclude={bg, Color.GREY}):
  43:         marker_mask = g == color
  44:         marker_components = components_mask(marker_mask, connectivity=4)
  45:         assert marker_components, "expected marker pixels for every candidate color"
  46:         assert all(comp.shape[0] == 1 for comp in marker_components), "candidate colors must form isolated markers"
  47: 
  48:         marker_coords = np.argwhere(marker_mask)
  49:         scores.append((_nearest_squared_distance(marker_coords, grey_coords), int(color)))
  50: 
  51:     assert scores, "expected at least one marker color"
  52:     best_distance = min(distance for distance, _color in scores)
  53:     winning_colors = [color for distance, color in scores if distance == best_distance]
  54:     assert len(winning_colors) == 1, "expected a unique closest marker color"
  55: 
  56:     out = np.full_like(g, bg)
  57:     out[grey_mask] = winning_colors[0]
  58:     return out
