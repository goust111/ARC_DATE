+    holes: list[list[tuple[int, int]]] = []
+    for comp in _components(~mask, connectivity=4):
+        touches_edge = bool(
+            np.any(comp[:, 0] == 0)
+            or np.any(comp[:, 0] == local_h - 1)
+            or np.any(comp[:, 1] == 0)
+            or np.any(comp[:, 1] == local_w - 1)
