    if target % 2 == 1:
        return int(np.random.choice(CELL_CENTER_AXIS_CHOICES)), int(np.random.choice(CELL_CENTER_AXIS_CHOICES))
    if target % 4 == 0 and np.random.random() < DOUBLE_CENTER_AXIS_PROB:
