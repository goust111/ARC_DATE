from collections import Counter

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/11/054/4.py')
mod = SourceFileLoader('new_arc_task_dbg13', str(p)).load_module()
counts = Counter()
for i in range(500):
    spec = mod._sample_spec()
    if spec is None:
        counts['sample_none'] += 1
        continue
    grid = mod._render_input(spec)
    exp = mod._render_expected(spec)
    try:
        pred = mod.main(grid)
    except Exception as e:
        counts[f'main_fail:{type(e).__name__}:{e}'] += 1
        continue
    if not np.array_equal(pred, exp):
        counts['pred_mismatch'] += 1
        continue
    if not mod._validate_generated(spec, grid, exp):
        counts['validate_false'] += 1
        continue
    counts['ok'] += 1
print(counts)
