+        H - GEN_MARGIN - hh + h_row_off,
+        H - GEN_MARGIN - vh + v_row_off - (v_len if v_side == "bottom" else 0),
+    )
+    overlap_c_lo = max(
+        GEN_MARGIN + v_col_off,
+        GEN_MARGIN + h_col_off + (h_len if h_side == "left" else 0),
