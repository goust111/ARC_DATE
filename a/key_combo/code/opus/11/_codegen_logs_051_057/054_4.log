+    vr0, vc0, vr1, vc1 = spec["v_final_box"]
+    h_only[hr0 : hr1 + 1, hc0 : hc1 + 1] = True
+    v_only[vr0 : vr1 + 1, vc0 : vc1 + 1] = True
