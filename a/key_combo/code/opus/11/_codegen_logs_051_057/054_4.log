+        "h_side": h_side,
+        "v_side": v_side,
+        "h_len": int(h_len),
+        "v_len": int(v_len),
+        "h_input_box": h_input_box,
+        "v_input_box": v_input_box,
+        "h_final_box": h_final_box,
+        "v_final_box": v_final_box,
+        "overlap_box": overlap_box,
+        "h_stem_row": int(h_stem_row),
+        "v_stem_col": int(v_stem_col),
