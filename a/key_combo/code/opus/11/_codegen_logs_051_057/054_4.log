+    h_cells = _box_cells(h_input_box)
+    v_cells = _box_cells(v_input_box)
+    if h_side == "left":
+        h_cells |= {(h_stem_row, c) for c in range(h_input_box[3] + 1, h_input_box[3] + 1 + h_len)}
