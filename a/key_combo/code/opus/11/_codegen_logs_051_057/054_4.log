            if not _in_bounds(h, w, nr, nc) or grid[nr, nc] != -1:
                continue
            # Keep path thin: reject if 8-adjacent to existing path (except cur)
            if any((nnr, nnc) != cur and (nnr, nnc) in path_set
                   for nnr, nnc in neighbors8(nr, nc)):
