+    if len(unique_cols) == 1:
+        col = unique_cols[0]
+        rows_sorted = sorted(map(int, rows))
+        assert rows_sorted == list(range(rows_sorted[0], rows_sorted[-1] + 1))
+        assert c0 <= col <= c1
+        if rows_sorted[-1] < r0:
+            return -1, 0, r0 - rows_sorted[0]
+        if r1 < rows_sorted[0]:
+            return 1, 0, rows_sorted[-1] - r1
