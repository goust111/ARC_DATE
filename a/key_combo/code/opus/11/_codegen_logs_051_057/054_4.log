+    unique_cols = sorted(set(map(int, cols)))
+    if len(unique_rows) == 1:
+        row = unique_rows[0]
+        cols_sorted = sorted(map(int, cols))
+        assert cols_sorted == list(range(cols_sorted[0], cols_sorted[-1] + 1))
