+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+            nr, nc = int(r) + dr, int(c) + dc
+            if 0 <= nr < H and 0 <= nc < W and (nr, nc) in pts_b:
+                return True
+    return False
+
