+        for c0 in range(w):
+            if not mask[r0, c0]:
+                continue
+            for r1 in range(r0, h):
+                for c1 in range(c0, w):
+                    area = (r1 - r0 + 1) * (c1 - c0 + 1)
+                    if area < best_area:
+                        continue
+                    if not mask[r0 : r1 + 1, c0 : c1 + 1].all():
+                        continue
+                    if area > best_area:
