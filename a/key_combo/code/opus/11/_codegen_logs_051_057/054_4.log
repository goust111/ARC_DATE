+    hw = random.randint(*GEN_H_WIDTH)
+    vh = random.randint(*GEN_V_HEIGHT)
+    vw = random.randint(*GEN_V_WIDTH)
+    h_len = random.randint(*GEN_STEM)
+    v_len = random.randint(*GEN_STEM)
