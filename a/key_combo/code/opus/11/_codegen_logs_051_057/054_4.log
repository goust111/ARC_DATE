+    overlap_c_hi = min(
+        W - GEN_MARGIN - vw + v_col_off,
+        W - GEN_MARGIN - hw + h_col_off - (h_len if h_side == "right" else 0),
+    )
+    if overlap_r_lo > overlap_r_hi or overlap_c_lo > overlap_c_hi:
+        return None
+
+    overlap_r0 = random.randint(overlap_r_lo, overlap_r_hi)
+    overlap_c0 = random.randint(overlap_c_lo, overlap_c_hi)
+    overlap_box = (overlap_r0, overlap_c0, overlap_r0 + ov_h - 1, overlap_c0 + ov_w - 1)
+
+    h_final_box = (
+        overlap_r0 - h_row_off,
+        overlap_c0 - h_col_off,
+        overlap_r0 - h_row_off + hh - 1,
+        overlap_c0 - h_col_off + hw - 1,
+    )
+    v_final_box = (
+        overlap_r0 - v_row_off,
+        overlap_c0 - v_col_off,
+        overlap_r0 - v_row_off + vh - 1,
+        overlap_c0 - v_col_off + vw - 1,
+    )
+
+    if h_side == "left":
+        h_input_box = (
+            h_final_box[0],
+            h_final_box[1] - h_len,
+            h_final_box[2],
+            h_final_box[3] - h_len,
+        )
+    else:
+        h_input_box = (
+            h_final_box[0],
+            h_final_box[1] + h_len,
+            h_final_box[2],
+            h_final_box[3] + h_len,
+        )
+
+    if v_side == "top":
+        v_input_box = (
+            v_final_box[0] - v_len,
