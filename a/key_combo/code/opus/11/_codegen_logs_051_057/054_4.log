+    assert 0 <= fr0 <= fr1 < H and 0 <= fc0 <= fc1 < W, "moved body must stay in bounds"
+    return {
+        "color": int(color),
+        "mask": mask,
+        "body_box": box,
+        "body_height": int(h),
+        "body_width": int(w),
+        "dr": int(dr),
+        "dc": int(dc),
+        "distance": int(dist),
+        "orientation": orientation,
+        "final_box": final_box,
+        "bg": int(bg),
+    }
+
