+import numpy as np
+
+
+BG = 0
+GEN_RETRIES = 600
+GEN_MARGIN = 1
+GEN_ROWS = (18, 24)
+GEN_COLS = (18, 24)
+GEN_STEM = (3, 5)
+GEN_H_HEIGHT = (2, 4)
+GEN_H_WIDTH = (5, 8)
+GEN_V_HEIGHT = (5, 8)
+GEN_V_WIDTH = (2, 4)
+GEN_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
+
