+
+def _shift_box(box: tuple[int, int, int, int], dr: int, dc: int, steps: int) -> tuple[int, int, int, int]:
+    r0, c0, r1, c1 = box
+    return r0 + dr * steps, c0 + dc * steps, r1 + dr * steps, c1 + dc * steps
+
+
+def _intersect_box(
+    box_a: tuple[int, int, int, int], box_b: tuple[int, int, int, int]
