+
+    h_side = random.choice(["left", "right"])
+    v_side = random.choice(["top", "bottom"])
+
+    row_pairs = [
+        (h_row_off, v_row_off)
+        for h_row_off in range(0, hh - ov_h + 1)
+        for v_row_off in range(1, vh - ov_h)
+    ]
+    col_pairs = [
+        (h_col_off, v_col_off)
+        for h_col_off in range(1, hw - ov_w)
+        for v_col_off in range(0, vw - ov_w + 1)
+    ]
+    if not row_pairs or not col_pairs:
