+    r0 = max(box_a[0], box_b[0])
+    c0 = max(box_a[1], box_b[1])
+    r1 = min(box_a[2], box_b[2])
+    c1 = min(box_a[3], box_b[3])
+    if r0 > r1 or c0 > c1:
+        return None
+    return r0, c0, r1, c1
+
+
