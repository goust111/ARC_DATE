+        if row not in overlap_rows:
+            score += 1
+        if col not in overlap_cols:
+            score += 1
+        preferred_pairs.append((score, row, col))
+    best_score = max(score for score, _row, _col in preferred_pairs)
+    candidates = [(row, col) for score, row, col in preferred_pairs if score == best_score]
+    h_stem_row, v_stem_col = random.choice(candidates)
+
+    spec = {
+        "shape": (H, W),
+        "h_color": int(h_color),
+        "v_color": int(v_color),
+        "h_side": h_side,
+        "v_side": v_side,
