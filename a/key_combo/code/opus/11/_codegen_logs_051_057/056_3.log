+    mirrored = np.flipud(mask)
+    symmetric = mask & mirrored
+    orange = mask & ~mirrored
+    cyan = mirrored & ~mask
+    patch = np.zeros(mask.shape, dtype=int)
+    patch[symmetric] = color
+    patch[orange] = ORANGE
+    patch[cyan] = CYAN
+    return patch, symmetric, orange, cyan
+
