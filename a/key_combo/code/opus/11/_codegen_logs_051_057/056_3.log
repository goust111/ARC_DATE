+        sizes = [(random.choice(BBOX_SIDE_CHOICES), random.choice(BBOX_SIDE_CHOICES)) for _ in range(count)]
+        boxes = _place_bboxes(rows, cols, sizes)
+        if boxes is None:
+            continue
+
+        grid = np.zeros((rows, cols), dtype=int)
+        ok = True
+        for color, (r0, c0, r1, c1) in zip(colors, boxes):
+            mask = _make_mask(r1 - r0 + 1, c1 - c0 + 1)
+            if mask is None:
+                ok = False
+                break
+            grid[r0 : r1 + 1, c0 : c1 + 1][mask] = color
+
+        if ok and _validate_scene(grid):
+            return grid
+
+    raise RuntimeError("failed to generate a valid input grid")

