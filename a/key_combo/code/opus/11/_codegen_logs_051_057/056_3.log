+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+INPUT_COLORS = (1, 2, 3)
+ORANGE = 7
+CYAN = 8
+
+GRID_SIDE_MIN = 10
+GRID_SIDE_MAX = 15
+MASK_COUNT_CHOICES = (2, 3)
+BBOX_SIDE_CHOICES = (4, 5, 6)
+BORDER = 1
+GAP = 1
+PIXELS_MIN = 8
+PIXELS_MAX = 15
+GENERATION_RETRIES = 600
+PLACEMENT_RETRIES = 200
+MASK_RETRIES = 300
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _foreground_colors(grid: np.ndarray) -> list[int]:
+    return sorted(int(color) for color in np.unique(grid) if int(color) != BACKGROUND)
+
+
+def _compare_with_vertical_mirror(mask: np.ndarray, color: int) -> np.ndarray:
+    mirrored = np.flipud(mask)
+    out = np.zeros(mask.shape, dtype=int)
+    out[mask & mirrored] = color
+    out[mask & ~mirrored] = ORANGE
+    out[mirrored & ~mask] = CYAN
+    return out
+
+
+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return (
+        a[2] + GAP < b[0]
+        or b[2] + GAP < a[0]
+        or a[3] + GAP < b[1]
+        or b[3] + GAP < a[1]
+    )
+
+
+def _is_adjacent(mask: np.ndarray, r: int, c: int) -> bool:
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc]:
+            return True
+    return False
+
+
+def _validate_local_mask(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    if _bbox(mask) != (0, 0, h - 1, w - 1):
+        return False
+    pixel_count = int(mask.sum())
+    if not (PIXELS_MIN <= pixel_count <= PIXELS_MAX):
+        return False
+
+    mirrored = np.flipud(mask)
+    symmetric = mask & mirrored
+    orange = mask & ~mirrored
+    cyan = mirrored & ~mask
+
+    if int(symmetric.sum()) < 2 or int(orange.sum()) < 1 or int(cyan.sum()) < 1:
+        return False
+    if np.array_equal(mask, mirrored):
+        return False
+
+    orange_rows = np.argwhere(orange)[:, 0]
+    cyan_rows = np.argwhere(cyan)[:, 0]
+    axis = (h - 1) / 2.0
+    if orange_rows.size == 0 or cyan_rows.size == 0:
+        return False
+    if not np.all(orange_rows < axis):
+        return False
+    if not np.all(cyan_rows > axis):
+        return False
+
+    return True
+
+
+def _candidate_moves(mask: np.ndarray, allow_center: bool) -> list[tuple[str, int, int]]:
+    h, w = mask.shape
+    moves: list[tuple[str, int, int]] = []
+    half = h // 2
+
+    for r in range(half):
+        mr = h - 1 - r
+        for c in range(w):
+            if not mask[r, c]:
+                moves.append(("top", r, c))
+            if not (mask[r, c] and mask[mr, c]):
+                moves.append(("pair", r, c))
+
+    if allow_center:
+        center_r = half
+        for c in range(w):
+            if not mask[center_r, c]:
+                moves.append(("center", center_r, c))
+
+    random.shuffle(moves)
+    return moves
+
+
+def _apply_move(mask: np.ndarray, move: tuple[str, int, int]) -> np.ndarray:
+    kind, r, c = move
+    candidate = mask.copy()
+    if kind == "top":
+        candidate[r, c] = True
+    elif kind == "pair":
+        candidate[r, c] = True
+        candidate[candidate.shape[0] - 1 - r, c] = True
+    else:
+        candidate[r, c] = True
+    return candidate
+
+
+def _score_move(mask: np.ndarray, move: tuple[str, int, int]) -> tuple[int, int, int, float]:
+    kind, r, c = move
+    h = mask.shape[0]
+    cells = [(r, c)]
+    if kind == "pair":
+        cells.append((h - 1 - r, c))
+    adjacency = sum(1 for rr, cc in cells if _is_adjacent(mask, rr, cc))
+    boundary_hits = sum(
+        1
+        for rr, cc in cells
+        if rr in (0, mask.shape[0] - 1) or cc in (0, mask.shape[1] - 1)
+    )
+    return adjacency, boundary_hits, 1 if kind == "pair" else 0, random.random()
+
+
+def _make_mask(h: int, w: int) -> np.ndarray | None:
+    for _ in range(MASK_RETRIES):
+        mask = np.zeros((h, w), dtype=bool)
+
+        sym_col = random.randrange(w)
+        right_col = random.randrange(w)
+        left_row = random.randrange(h // 2)
+
+        mask[0, sym_col] = True
+        mask[h - 1, sym_col] = True
+        mask[left_row, 0] = True
+        mask[0, w - 1] = True
+        mask[h - 1, right_col] = True
+        if h % 2 == 1 and random.random() < 0.5:
+            mask[h // 2, random.randrange(w)] = True
+
+        target = random.randint(PIXELS_MIN, min(PIXELS_MAX, h * w - 1))
+        while int(mask.sum()) < target:
+            moves = _candidate_moves(mask, allow_center=h % 2 == 1)
+            if not moves:
+                break
+            moves.sort(key=lambda move: _score_move(mask, move), reverse=True)
+            take = moves[: min(len(moves), 6)]
+            candidate = _apply_move(mask, random.choice(take))
+            if int(candidate.sum()) > PIXELS_MAX:
+                continue
+            mask = candidate
+
+        if _validate_local_mask(mask):
+            return mask
+
+    return None
+
+
+def _place_bboxes(
+    rows: int, cols: int, sizes: list[tuple[int, int]]
+) -> list[tuple[int, int, int, int]] | None:
+    for _ in range(PLACEMENT_RETRIES):
+        placed: list[tuple[int, int, int, int]] = []
+        order = list(range(len(sizes)))
+        random.shuffle(order)
+        slots: list[tuple[int, int, int, int] | None] = [None] * len(sizes)
+
+        ok = True
+        for idx in order:
+            h, w = sizes[idx]
+            candidates = [
+                (r, c, r + h - 1, c + w - 1)
+                for r in range(BORDER, rows - h - BORDER + 1)
