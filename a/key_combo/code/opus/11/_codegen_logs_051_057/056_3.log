def _expected_patch(mask: np.ndarray, color: int) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    mirrored = np.flipud(mask)
    symmetric = mask & mirrored
    orange = mask & ~mirrored
