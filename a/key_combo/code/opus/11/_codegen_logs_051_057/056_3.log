+        return False
+
+    mirrored = np.flipud(mask)
+    symmetric = mask & mirrored
+    orange = mask & ~mirrored
+    cyan = mirrored & ~mask
+
+    if int(symmetric.sum()) < 2 or int(orange.sum()) < 1 or int(cyan.sum()) < 1:
+        return False
+    if np.array_equal(mask, mirrored):
+        return False
+
