        if rr in (0, mask.shape[0] - 1) or cc in (0, mask.shape[1] - 1)
    )
    return adjacency, boundary_hits, 1 if kind == "pair" else 0, random.random()


def _make_mask(h: int, w: int) -> np.ndarray | None:
    for _ in range(MASK_RETRIES):
        mask = np.zeros((h, w), dtype=bool)

