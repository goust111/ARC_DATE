+            c0 = slot_c + random.randint(0, 6 - w)
+            r1 = r0 + h - 1
+            c1 = c0 + w - 1
+            grid[r0 : r1 + 1, c0 : c1 + 1][mask] = color
+
+        if not ok:
+            continue
+
+        cropped = _crop_with_border(grid, border=1)
+        if _validate_scene(cropped):
+            return cropped
+
+    raise RuntimeError("failed to generate a valid input grid")

