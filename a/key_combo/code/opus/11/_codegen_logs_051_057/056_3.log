+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+INPUT_COLORS = (1, 2, 3)
+ORANGE = 7
+CYAN = 8
+
+GRID_SIDE_MIN = 10
+GRID_SIDE_MAX = 15
+MASK_COUNT_CHOICES = (2, 3)
+BBOX_SIDE_CHOICES = (4, 5, 6)
