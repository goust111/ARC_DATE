+    for _ in range(400):
+        rows = sorted(random.sample(candidates, count))
+        if all(rows[i + 1] - rows[i] >= ROW_GAP_MIN for i in range(count - 1)):
+            return rows
+    raise RuntimeError("failed to place rings vertically")
+
+
+def _sample_cols(width: int, panel_width: int, count: int) -> list[int]:
