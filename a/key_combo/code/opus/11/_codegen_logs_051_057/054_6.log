+    if len(set(cols)) != len(cols):
+        return False
+    col_order = sorted(range(len(cols)), key=lambda i: cols[i])
+    if col_order == list(range(len(cols))):
+        return False
+
+    if len(set(directions)) < 2:
+        return False
