+    allowed = list(range(start, width - 2))
+    assert len(allowed) >= count
+    base = sorted(random.sample(allowed, count))
+    if count == 1:
+        return base
+    perm = list(range(count))
+    while perm == list(range(count)):
+        random.shuffle(perm)
+    return [base[i] for i in perm]
+
