+    r0 = min(box[0] for box in ring_boxes)
+    c0 = min(box[1] for box in ring_boxes)
+    r1 = max(box[2] for box in ring_boxes)
+    c1 = max(box[3] for box in ring_boxes)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
