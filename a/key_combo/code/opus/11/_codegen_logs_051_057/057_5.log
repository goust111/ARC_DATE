+        int(marker_rows[cell_r + 1]),
+        int(marker_cols[cell_c]),
+        int(marker_cols[cell_c + 1]),
+    )
+
+
+def _build_case(
+    cell_rows: int,
+    cell_cols: int,
+    first_r: int,
+    first_c: int,
+    plans: list[dict[str, int]],
+) -> tuple[np.ndarray, np.ndarray]:
