spec:
  grid: two equal panels joined H or V; panel 8-17 rows x 8-17 cols
  colors: src_bg, tgt_bg, 1 body_color, 1-2 marker_colors; all mutually distinct
  source_panel:
    background: solid src_bg
    sprites: 2-3 fully-filled rectangles (no holes), each 2-5 h x 2-7 w
    sprite_composition: each sprite uses exactly 1 body_color + 1 marker_color; marker pixels 1-4 per sprite, rest body
    separation: sprite bboxes non-overlapping (4-disconnected), min 1-cell gap on at least one axis
    edge_margin: >=1 cell from panel border [observed]
  target_panel:
    background: solid tgt_bg
    markers: isolated colored pixels (no two 4-adjacent), colors from marker_colors set
    count: equals sum of marker pixels of the 2 placed sprites (3-7 total)
  matching:
    each placed sprite's marker-pixel pattern (relative positions + colors) aligns exactly with a subset of target markers via translation
    the 2 placed sprites' marker sets partition all target markers (exact cover, unique solution)
    0-1 distractor sprites in source have no valid placement; their markers cannot cover remaining target cells
  output: target panel with placed sprites stamped (body+marker pixels); src_bg treated as transparent

generation_strategy:
  approach: output-first
  steps:
    1. Pick panel size (8-17 x 8-17), split direction (H or V), and 4-5 distinct colors for src_bg, tgt_bg, body_color, marker_color(s)
