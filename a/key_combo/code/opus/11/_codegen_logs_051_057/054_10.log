+    candidates: set[tuple[int, int]] = set()
+    for rect in rectangles:
+        r0, c0, r1, c1 = rect["r0"], rect["c0"], rect["r1"], rect["c1"]
+        for rr in range(max(0, r0 - 2), min(h, r1 + 3)):
