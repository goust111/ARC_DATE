+def _border_mask(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> np.ndarray:
+    h, w = shape
+    out = np.zeros((h, w), dtype=bool)
+    r0, c0, r1, c1 = bbox
+    out[r0 : r1 + 1, c0] = True
+    out[r0 : r1 + 1, c1] = True
+    out[r0, c0 : c1 + 1] = True
+    out[r1, c0 : c1 + 1] = True
+    return out
