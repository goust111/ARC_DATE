+        rng.shuffle(order)
+    return None
+
+
+def _sample_bar_positions(
+    rng: np.random.Generator,
+    height: int,
+    width: int,
+    sprite_patches: dict[int, np.ndarray],
+    lengths: dict[int, int],
+    rows: dict[int, int],
