+    for ring in RINGS:
+        row, col = placements[ring]
+        patch = sprite_patches[ring]
+        h, w = map(int, patch.shape)
+        dest_r0 = int(row) - h
+        dest_c0 = int(col + (lengths[ring] - w) // 2)
+        final_positions[ring] = (dest_r0, dest_c0)
+        paste(out, patch, dest_r0, dest_c0, transparent=int(BG))
