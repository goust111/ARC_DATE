+    multiplicities = [sum(int(mask[r, c]) for mask in masks) for r, c in cells]
+    assert 1 in multiplicities and max(multiplicities) > 1
+    return masks
+
+
+def _paint_frame(grid: np.ndarray, r0: int, c0: int, color: int, motif: np.ndarray) -> None:
+    r1 = r0 + FRAME_SIZE
+    c1 = c0 + FRAME_SIZE
