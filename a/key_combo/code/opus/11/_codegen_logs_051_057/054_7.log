+    raw_totals = {color: sum(int(mask.sum()) for mask in masks) for color, masks in group_masks.items()}
+    raw_max = {color: max(int(mask.sum()) for mask in masks) for color, masks in group_masks.items()}
+
+    total_order = tuple(color for color, _ in sorted(raw_totals.items(), key=lambda item: item[1]))
+    max_order = tuple(color for color, _ in sorted(raw_max.items(), key=lambda item: item[1]))
+
+    return total_order != union_order and max_order != union_order
+
