+            continue
+        subsets.append(tuple(i for i in range(group_size) if bits & (1 << i)))
+    return subsets
+
+
+def _distribute_motif(canonical: np.ndarray, group_size: int) -> list[np.ndarray]:
+    cells = [tuple(map(int, rc)) for rc in np.argwhere(canonical)]
