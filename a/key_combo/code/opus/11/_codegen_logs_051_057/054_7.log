+    random.shuffle(cells)
+    masks = [np.zeros_like(canonical, dtype=bool) for _ in range(group_size)]
+
+    if group_size == 2:
+        assert len(cells) >= 3
+        base = [(0,), (1,), (0, 1)]
+    else:
