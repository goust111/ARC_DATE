+            colors = sorted(set(map(int, block[block != bg])))
+            assert len(colors) == 1, "each block must contain exactly one frame color"
+            color = colors[0]
+            assert np.all(block[0, :] == color)
+            assert np.all(block[-1, :] == color)
+            assert np.all(block[:, 0] == color)
+            assert np.all(block[:, -1] == color)
