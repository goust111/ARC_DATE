+    for rep in reps:
+        orbit = d4_orbit(rep[0], rep[1], size)
+        neighbor_colors: list[int] = []
+        for rr, cc in orbit:
+            for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                if 0 <= nr < size and 0 <= nc < size and grid[nr, nc] != -1:
+                    neighbor_colors.append(int(grid[nr, nc]))
