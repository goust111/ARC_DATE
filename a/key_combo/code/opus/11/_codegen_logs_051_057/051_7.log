+            for cc in range(half, size - half):
+                r0, c0, r1, c1 = square_bbox((cr, cc), eff_side)
+                rr0 = max(0, r0 - 1)
+                cc0 = max(0, c0 - 1)
+                rr1 = min(size, r1 + 2)
+                cc1 = min(size, c1 + 2)
