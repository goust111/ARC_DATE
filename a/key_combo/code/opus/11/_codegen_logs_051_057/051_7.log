+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BASE_COLORS = (1, 4, 5)
+SQUARE_COLORS = (2, 3, 7)
+SIDE_CYCLE = (1, 3, 5, 7, 9)
+GRID_SIZES = (13, 15, 17, 19, 21)
+MAX_GENERATION_ATTEMPTS = 400
