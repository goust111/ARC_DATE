+        1: [2, 4, 3, 2],
+        2: [5, 4, 2, 1],
+    }
+    return random.choices([2, 3, 4, 5], weights=weights[rank], k=1)[0]
+
+
+def _sample_shape(size: int) -> tuple[tuple[int, int], ...]:
+    return random.choice(SHAPE_LIBRARY[size])
+
+
