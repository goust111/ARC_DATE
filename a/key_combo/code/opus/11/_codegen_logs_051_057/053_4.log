+def _draw_chamber(
+    grid: np.ndarray,
+    wall_col: int,
+    gap_row: int,
+    right_col: int,
+    top: int,
+    bottom: int,
+) -> None:
+    assert top < gap_row < bottom
+    grid[top, wall_col : right_col + 1] = GREY
+    grid[bottom, wall_col : right_col + 1] = GREY
+    grid[top : bottom + 1, right_col] = GREY
+    grid[gap_row, wall_col] = BG
+
