+    seen = {(sr, sc)}
+    queue = deque([(sr, sc)])
+    while queue:
+        r, c = queue.popleft()
+        out[r, c] = TEAL
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and grid[nr, nc] == BG:
