+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return seen
+
+
+def _simulate(
+    grid: np.ndarray,
+    *,
+    ignore_deflectors: bool = False,
+    fill_chambers: bool = True,
+) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
