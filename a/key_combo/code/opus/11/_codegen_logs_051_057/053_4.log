+def _flood_fill_chamber(out: np.ndarray, grid: np.ndarray, start: tuple[int, int]) -> set[tuple[int, int]]:
+    """Fill the background chamber reachable to the right of a wall gap."""
+    h, w = grid.shape
+    sr, sc = start
+    if not (0 <= sr < h and 0 <= sc < w) or grid[sr, sc] != BG:
+        return set()
