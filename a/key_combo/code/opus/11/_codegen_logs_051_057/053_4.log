+def _choose_chamber_spans(
+    rng: random.Random,
+    hit_rows: list[int],
+    h: int,
+) -> list[tuple[int, int]] | None:
+    rows = sorted(hit_rows)
+    options: list[list[tuple[int, int]]] = []
+    for row in rows:
