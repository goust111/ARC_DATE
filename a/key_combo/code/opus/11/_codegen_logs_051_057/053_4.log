+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _vertical_wall_columns(grid: np.ndarray) -> list[int]:
+    """Return full-height wall columns, allowing 1-2 one-pixel gaps."""
+    h, _ = grid.shape
