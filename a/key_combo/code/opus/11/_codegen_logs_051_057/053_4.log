+                r = nr
+                out[r, c] = TEAL
+                flow["deflections_before_wall"] += 1
+
+            next_c = c + 1
+            if next_c >= w:
+                break
+
+            if next_c in wall_cols:
+                flow["wall_col"] = int(next_c)
+                flow["row_at_wall"] = int(r)
+                if g[r, next_c] == GREY:
+                    break
+
+                flow["hit_gap"] = True
+                flow["gap_col"] = int(next_c)
+                out[r, next_c] = TEAL
