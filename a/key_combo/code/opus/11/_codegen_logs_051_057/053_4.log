+    ignore_deflectors: bool = False,
+    count_all_reds_before_wall: bool = False,
+    fill_chambers: bool = True,
+) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    out = g.copy()
