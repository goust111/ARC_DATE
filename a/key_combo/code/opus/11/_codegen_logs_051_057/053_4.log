+    source_rows = sorted(int(r) for r in np.where(g[:, 0] == TEAL)[0])
+    deflector_cols = sorted(int(c) for c in np.where(g[0] == RED)[0])
+    wall_cols = set(_vertical_wall_columns(g))
+
+    events: list[dict] = []
+
+    for source_row in source_rows:
