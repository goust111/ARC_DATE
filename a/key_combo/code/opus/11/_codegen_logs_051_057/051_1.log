+    reached = _flood_reached_black(g)
+    rects = _green_rectangles(g)
+
+    planned: list[tuple[dict, int]] = []
+    occupied_targets = np.zeros(g.shape, dtype=bool)
+    for rect in rects:
+        active = True if activate_all else _is_active(rect, reached)
+        if not active:
+            continue
