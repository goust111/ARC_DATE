+    seen = np.zeros(grid.shape, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    sr, sc = _seed_position(grid)
+    seen[sr, sc] = True
+    q.append((sr, sc))
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if not in_bounds(grid.shape, nr, nc) or seen[nr, nc]:
+                continue
+            if int(grid[nr, nc]) != BLACK:
+                continue
+            seen[nr, nc] = True
+            reached[nr, nc] = True
+            q.append((nr, nc))
+    return reached
