+    assert g.ndim == 2
+    assert max(g.shape) <= 30
+    assert set(map(int, np.unique(g))) <= {BLACK, BLUE, GREEN, GREY}
+    assert np.count_nonzero(g == BLUE) == 1
+
+    return _solve_with_variant(g)
