+    cells: list[tuple[int, int]] = []
+    for r0 in range(top, bottom - h + 2):
+        for c0 in range(left, right - w + 2):
+            src = (r0, c0, r0 + h - 1, c0 + w - 1)
+            if move_dr is not None:
