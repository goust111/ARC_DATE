+def _flood_reached_black(grid: np.ndarray) -> np.ndarray:
+    reached = np.zeros(grid.shape, dtype=bool)
+    seen = np.zeros(grid.shape, dtype=bool)
+    q: deque[tuple[int, int]] = deque()
