+    rng.shuffle(candidates)
+    for r0, c0 in candidates:
+        src = (r0, c0, r0 + h - 1, c0 + w - 1)
+        if _bbox_has_reserved(reserved, src, pad=1):
+            continue
+        if not _cells_are_black(grid, src):
