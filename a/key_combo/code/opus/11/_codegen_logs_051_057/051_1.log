+        extra = _select_shape([(1, 5), (5, 1), (1, 3), (3, 1), (2, 2)], right_w - 2, rng)
+        plans.append(("R", extra, None))
+
+    for chamber_name, (h, w), move_dr in plans:
+        bbox = _place_rectangle(grid, reserved, chambers[chamber_name], h, w, move_dr, rng)
