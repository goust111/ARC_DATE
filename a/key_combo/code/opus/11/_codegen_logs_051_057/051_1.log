+
+    plans = [
+        ("L", big_boundary, -big_boundary[0]),
+        ("M", big_other, -big_other[0]),
+        ("M", small_boundary, small_boundary[0]),
+        ("L", small_other, small_other[0]),
+        ("R", inactive_shape, None),
+    ]
