+def _random_segment(start: int, end: int, steps: int, lo: int, hi: int, max_step: int) -> list[int] | None:
+    if steps == 0:
+        return [start] if start == end else None
+    vals = [start]
+    cur = start
+    for pos in range(1, steps):
+        remaining = steps - pos
+        candidates = []
