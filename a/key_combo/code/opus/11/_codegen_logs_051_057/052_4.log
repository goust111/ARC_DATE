+    out[info["marker_mask"]] = bg
+    for frame in info["frames"]:
+        fill = int(count_to_color[int(frame["terrain_height"])])
+        out[int(frame["r0"]) + 1 : int(frame["r1"]), int(frame["c0"]) + 1 : int(frame["c1"])] = fill
+    return out
