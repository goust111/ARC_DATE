+import numpy as np
+
+
+BG = 0
+STRUCTURE = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+
+FRAME_OUTER = 5
+FRAME_INNER = 3
+FRAME_BORDER = 1
+
