+    assert all(int(frame["height"]) == FRAME_OUTER and int(frame["width"]) == FRAME_OUTER for frame in frames)
+
+    marker_cells = np.argwhere(info["marker_mask"])
+    for r, c in marker_cells:
+        for dr, dc in NEIGHBORS8:
+            nr = int(r) + dr
