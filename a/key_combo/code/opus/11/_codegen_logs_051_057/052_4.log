+def _draw_frame(grid: np.ndarray, r0: int, c0: int, fill: int | None = None) -> None:
+    r1 = r0 + FRAME_OUTER - 1
+    c1 = c0 + FRAME_OUTER - 1
+    grid[r0 : r1 + 1, c0] = STRUCTURE
+    grid[r0 : r1 + 1, c1] = STRUCTURE
+    grid[r0, c0 : c1 + 1] = STRUCTURE
+    grid[r1, c0 : c1 + 1] = STRUCTURE
