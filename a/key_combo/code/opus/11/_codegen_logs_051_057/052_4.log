+    h, w = grid.shape
+    heights = np.zeros(w, dtype=int)
+    mask = np.zeros_like(grid, dtype=bool)
+    for c in range(w):
+        height = 0
+        for r in range(h - 1, -1, -1):
+            if int(grid[r, c]) != structure:
+                break
+            height += 1
+        heights[c] = height
+        if height > 0:
