+        return False
+
+    return True
+
+
+def _attempt_generation() -> np.ndarray | None:
+    n_blocks = random.randint(3, 5)
+    side_choices = random.sample([2, 3, 4, 5, 6], n_blocks)
+    output_width = sum(sorted(side_choices)) + n_blocks - 1
