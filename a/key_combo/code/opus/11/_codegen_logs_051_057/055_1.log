+            return None
+
+        random.shuffle(candidates)
+        chosen = None
+        for top, left in candidates:
+            cells = {(top + int(rr), left + int(cc)) for rr, cc in shape}
+            if cells & blocked:
+                continue
+            chosen = np.array(sorted(cells), dtype=int)
+            placed.append(chosen)
