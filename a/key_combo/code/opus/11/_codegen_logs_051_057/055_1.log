+def _connected_cells(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS4:
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
+    return len(seen) == len(cells)
