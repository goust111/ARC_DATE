+    assert 3 <= len(marker_positions) <= 5, "expected 3-5 markers"
+    marker_colors = [int(g[r, c]) for r, c in marker_positions]
+    assert len(set(marker_colors)) == len(marker_colors), "marker colors must be unique"
+
