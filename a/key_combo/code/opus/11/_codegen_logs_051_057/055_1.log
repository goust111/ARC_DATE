+            remove_cell = random.choice(removable)
+            remaining = cells - {remove_cell}
+            add_candidates = []
+            for rr in range(canvas_h):
+                for cc in range(canvas_w):
+                    if (rr, cc) in remaining:
+                        continue
+                    if not any((rr + dr, cc + dc) in remaining for dr, dc in NEIGHBORS4):
+                        continue
