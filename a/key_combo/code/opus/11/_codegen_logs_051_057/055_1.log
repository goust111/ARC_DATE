+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        block_idx = order[pos]
+        for cell in candidate_lists[block_idx]:
+            if not compatible(block_idx, cell):
+                continue
+            chosen[block_idx] = cell
+            used.add(cell)
+            if dfs(pos + 1):
+                return True
+            used.remove(cell)
+            chosen[block_idx] = None
