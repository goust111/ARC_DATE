+        bbox_w = c1 - c0 + 1
+        if bbox_h < 2 or bbox_w < 2:
+            continue
+        if bbox_h * bbox_w == area:
+            continue
+        if bbox_h > side + 3 or bbox_w > side + 3:
+            continue
