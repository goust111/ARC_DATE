+
+def _build_grid(
+    h: int,
+    w: int,
+    components: list[np.ndarray],
+    markers: list[tuple[int, int]],
+    colors_by_block: list[int],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for comp in components:
+        for r, c in comp:
