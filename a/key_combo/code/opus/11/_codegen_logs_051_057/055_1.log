+
+def _search_markers(
+    components: list[np.ndarray],
+    target_distances: list[int],
+) -> list[tuple[int, int]] | None:
+    h = max(int(comp[:, 0].max()) for comp in components) + 1
+    w = max(int(comp[:, 1].max()) for comp in components) + 1
