+
+    return placed
+
+
+def _cell_touches_grey(coords: np.ndarray, cell: tuple[int, int]) -> bool:
+    r, c = cell
+    points = {tuple(map(int, xy)) for xy in coords.tolist()}
+    for dr, dc in NEIGHBORS4:
+        if (r + dr, c + dc) in points:
