+        frame["color"] = int(color)
+
+    max_ow = max(frame["ow"] for frame in shapes)
+    left_w_min = max(11, max_ow + 2)
+    left_w_max = min(13, max_ow + 4)
+    if left_w_min > left_w_max:
+        return None
+    left_w = random.randint(left_w_min, left_w_max)
