+    info = _analyze_input(grid)
+    frames = list(info["frames"])
+    true_sorted = _sorted_by_key(frames, "count")
+    true_out = _render_output(true_sorted, RIGHT_PANEL_WIDTH)
+
+    if _overlap_pixel_count(n_frames) == 0:
