+    output_h = SPRITE_SIZE + SPRITE_STEP * (n_frames - 1)
+    packed_h = sum(frame["oh"] for frame in shapes) + n_frames
+    left_h = max(output_h, packed_h) + random.randint(0, 3)
+    if left_h > 28:
+        return None
+
+    if not _place_frames(left_h, left_w, shapes):
+        return None
