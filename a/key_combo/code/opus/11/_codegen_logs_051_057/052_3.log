+    grid[:, left_w] = SEP
+    for frame in shapes:
+        patch = _frame_patch(int(frame["color"]), int(frame["ih"]), int(frame["iw"]))
+        r0, c0 = int(frame["r0"]), int(frame["c0"])
+        oh, ow = patch.shape
+        grid[r0 : r0 + oh, c0 : c0 + ow] = patch
