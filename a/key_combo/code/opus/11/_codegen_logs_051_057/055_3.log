+def _contiguous_runs(cols: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    if len(cols) == 0:
+        return runs
+    start = prev = int(cols[0])
+    for value in cols[1:]:
+        col = int(value)
+        if col == prev + 1:
+            prev = col
+            continue
+        runs.append((start, prev))
+        start = prev = col
+    runs.append((start, prev))
+    return runs
+
