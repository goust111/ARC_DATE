+            color = int(grid[r, c])
+            stack = [(r, c)]
+            visited[r, c] = True
+            coords = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
