+        length = end - start + 1
+        out[r, :length] = color
+        info.append((color, start, length))
+    return out, info
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[tuple[list[tuple[int, int]], set[int]]]:
+    mask = grid == int(color)
+    h, w = mask.shape
