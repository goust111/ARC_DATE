+    upper_h, upper_w = random.choice(BLOCK_SIZES)
+    overlap_lo = max(1, support_c - upper_w + 1)
+    overlap_hi = min(w - upper_w - 1, support_c + base_w - 1)
+    if overlap_lo > overlap_hi:
