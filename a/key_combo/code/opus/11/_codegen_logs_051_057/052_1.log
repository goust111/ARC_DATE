            allowed = {(ar, ac)}
            if idx > 0:
                allowed.add(path[idx - 1])
            if idx + 1 < len(path):
                allowed.add(path[idx + 1])
            for nr, nc in neighbors4(r, c):
                if (
                    in_bounds(g.shape, nr, nc)
                    and g[nr, nc] == _GEN_BLUE
                    and (nr, nc) not in allowed
                ):
                    ok = False
                    break
                if (nr, nc) in path_set and (nr, nc) not in allowed:
                    ok = False
                    break
            if not ok:
                break
        if ok:
            out.append(path)
    return out


