+
+
+def _horiz_disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    _r0a, c0a, _ha, wa = a
+    _r0b, c0b, _hb, wb = b
+    return c0a + wa <= c0b or c0b + wb <= c0a
+
+
+def _component_from_rect(rect: tuple[int, int, int, int]) -> dict:
+    r0, c0, h, w = rect
+    rr, cc = np.indices((h, w))
