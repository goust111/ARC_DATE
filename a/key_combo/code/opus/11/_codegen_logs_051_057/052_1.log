+def _choose_arrows(
+    shape: tuple[int, int],
+    input_block_mask: np.ndarray,
+    final_block_mask: np.ndarray,
+    arrow_count: int,
+) -> list[dict] | None:
+    candidates = _candidate_arrows(shape, input_block_mask, final_block_mask)
+    dir_sets = [("up", "down", "left", "right")]
+    if arrow_count == 3:
+        dir_sets = [
+            dirs
+            for dirs in (
+                ("up", "down", "left"),
+                ("up", "down", "right"),
+                ("up", "left", "right"),
+                ("down", "left", "right"),
+            )
+        ]
