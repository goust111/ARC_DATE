+        occupied[final_coords[:, 0], final_coords[:, 1]] = True
+        r0, c0 = final_coords.min(axis=0)
+        r1, c1 = final_coords.max(axis=0)
+        settled.append(
+            {
+                "color": int(comp["color"]),
+                "coords": final_coords,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "area": int(final_coords.shape[0]),
+            }
+        )
+    return settled
