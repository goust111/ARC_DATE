+                idx + 1,
+                chosen,
+                used_pad | cand["pad"],
+                used_output | cand["output_cells"],
+                seen_block or cand["reason"] == "block",
+                seen_boundary or cand["reason"] == "boundary",
+                seen_dep or cand["depends"],
+                seen_vertical or cand["vertical"],
+                seen_horizontal or (not cand["vertical"]),
