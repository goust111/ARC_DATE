+    input_block_cells = set(map(tuple, np.argwhere(input_block_mask)))
+    input_block_pad = _pad_cells(input_block_cells, shape)
+    by_dir: dict[str, list[dict]] = {"up": [], "down": [], "left": [], "right": []}
