+from __future__ import annotations
+
+from collections import deque
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+ARROW = 1
+BLOCK = 3
+
+ARROW_MAX_AREA = 5
+GRID_RANGE = (18, 24)
+BLOCK_COUNT_OPTIONS = (2, 3)
+ARROW_COUNT_OPTIONS = (3, 4)
