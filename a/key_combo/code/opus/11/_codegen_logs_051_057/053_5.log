+        same_pair = random.choice(same_pairs)
+        diff_pair = random.choice(diff_pairs)
+        chosen = set(same_pair) | set(diff_pair)
+        if len(chosen) > k:
+            continue
+
+        remaining = [i for i in range(len(candidates)) if i not in chosen]
+        random.shuffle(remaining)
+
+        if clip_branch and not any(candidates[i]["clipped"] for i in chosen):
+            clipped_remaining = [i for i in remaining if candidates[i]["clipped"]]
+            if not clipped_remaining:
