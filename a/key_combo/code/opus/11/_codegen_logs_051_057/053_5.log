+
+def _footprint_cells(
+    center: tuple[int, int], template: np.ndarray, shape: tuple[int, int]
+) -> tuple[frozenset[tuple[int, int]], int]:
+    h, w = shape
+    r, c = center
+    cells: set[tuple[int, int]] = set()
+    clipped = 0
+    for dr in range(-1, 2):
+        for dc in range(-1, 2):
