+
+def _draw_square_frame(grid: np.ndarray, top: int, left: int, side: int) -> None:
+    bottom = top + side - 1
+    right = left + side - 1
+    grid[top, left : right + 1] = GRAY
+    grid[bottom, left : right + 1] = GRAY
+    grid[top : bottom + 1, left] = GRAY
+    grid[top : bottom + 1, right] = GRAY
