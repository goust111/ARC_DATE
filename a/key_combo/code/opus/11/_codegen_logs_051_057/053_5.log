+    if mode == "actual":
+        marker_list.sort(key=lambda m: (m["depth"], m["r"], m["c"]))
+    elif mode == "scan_only":
+        marker_list.sort(key=lambda m: (m["r"], m["c"]))
+    elif mode == "reverse_depth":
