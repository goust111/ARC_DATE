+    elif side == "east":
+        cc = c0 + patch.shape[1] - 1
+        for rr in range(patch.shape[0]):
+            if int(patch[rr, patch.shape[1] - 1]) == int(item["color"]):
+                cells.append((r0 + rr, cc))
+    else:
+        cc = c0
+        for rr in range(patch.shape[0]):
