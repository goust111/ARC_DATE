+
+def _edge_attachment_cells(item: dict, side: str) -> list[tuple[int, int]]:
+    patch = item["patch"]
+    r0, c0 = item["r0"], item["c0"]
+    cells = []
+    if side == "south":
+        rr = r0 + patch.shape[0] - 1
+        for cc in range(patch.shape[1]):
+            if int(patch[patch.shape[0] - 1, cc]) == int(item["color"]):
