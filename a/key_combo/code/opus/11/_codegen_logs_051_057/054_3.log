+        elif side == "east":
+            for cc in (mc, mc + 1):
+                if int(inp[ar, cc]) != GREY:
+                    continue
+                inp[ar, cc] = int(item["color"])
+                changed += 1
+        else:
+            for cc in (mc + 1, mc):
+                if int(inp[ar, cc]) != GREY:
+                    continue
+                inp[ar, cc] = int(item["color"])
+                changed += 1
