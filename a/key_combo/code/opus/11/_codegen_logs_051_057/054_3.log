+
+
+def _add_component_tails(inp: np.ndarray, placed: list[dict], mr: int, mc: int) -> int:
+    changed = 0
+    for item in placed:
+        side = random.choice(item["flushes"])
+        attachments = _edge_attachment_cells(item, side)
+        if not attachments:
