+    for c in (mc, mc + 1):
+        rows = list(range(h))
+        random.shuffle(rows)
+        for r in rows[: random.randint(max(4, h // 4), max(5, h // 2))]:
+            if mr <= r <= mr + 1:
+                continue
+            if int(inp[r, c]) == GREY:
+                inp[r, c] = random.choice(colors)
