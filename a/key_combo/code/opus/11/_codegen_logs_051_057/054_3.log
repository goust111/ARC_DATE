+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _find_marker_top_left(grid: np.ndarray) -> tuple[int, int]:
+    h, w = grid.shape
+    hits = []
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if np.all(grid[r : r + 2, c : c + 2] == BLACK):
+                hits.append((r, c))
