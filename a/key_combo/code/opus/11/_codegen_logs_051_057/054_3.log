+            return None
+    else:
+        expected_order = sorted(
+            [(count, min(item["bbox"][0] for item in grouped[color]), color) for color, count in zip(colors, group_counts)],
+            key=lambda x: (-x[0], x[1], x[2]),
+        )
+        if [color for _count, _top, color in expected_order] != [x[2] for x in expected_order]:
+            return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
