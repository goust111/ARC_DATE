+                inp[rr, ac] = int(item["color"])
+                changed += 1
+        elif side == "north":
+            for rr in (mr + 1, mr):
+                if int(inp[rr, ac]) != GREY:
+                    continue
+                inp[rr, ac] = int(item["color"])
+                changed += 1
+        elif side == "east":
+            for cc in (mc, mc + 1):
+                if int(inp[ar, cc]) != GREY:
+                    continue
+                inp[ar, cc] = int(item["color"])
+                changed += 1
+        else:
+            for cc in (mc + 1, mc):
+                if int(inp[ar, cc]) != GREY:
+                    continue
+                inp[ar, cc] = int(item["color"])
+                changed += 1
