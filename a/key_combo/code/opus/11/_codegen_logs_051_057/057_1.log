        if (0, 0) in local and (n - 1, n - 1) not in local:
            return "TL"
        if (n - 1, n - 1) in local and (0, 0) not in local:
            return "BR"
    if anti_ok:
        if (0, n - 1) in local and (n - 1, 0) not in local:
            return "TR"
        if (n - 1, 0) in local and (0, n - 1) not in local:
            return "BL"
    return None


def main(grid: np.ndarray) -> np.ndarray:
