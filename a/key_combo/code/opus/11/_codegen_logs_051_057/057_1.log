+            (r, c)
+            for r in range(shift, height)
+            for c in range(width)
+            if (r, c) not in left_cells
+            and (r - shift, c) not in left_cells
+            and (r - shift, c) not in used_origins
+        ]
+        if len(right_shift_candidates) < right_only_count:
