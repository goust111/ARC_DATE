+def _validate_generated(
+    grid: np.ndarray,
+    left_mask: np.ndarray,
+    right_mask: np.ndarray,
+    shift: int,
+    require_edge: bool,
+    require_conflict: bool,
+) -> None:
+    height, width = left_mask.shape
