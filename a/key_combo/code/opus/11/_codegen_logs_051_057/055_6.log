def _generate_attempt(rng: random.Random) -> np.ndarray | None:
    h = rng.randint(18, 25)
    w = rng.randint(18, 25)
    n_groups = rng.randint(2, 3)
    total_objects = rng.randint(max(4, n_groups), 7)
    counts = _sample_counts(rng, n_groups, total_objects)
    colors = list(rng.sample(MARKER_COLORS, n_groups))
    bases = _pick_base_columns(rng, w, n_groups)
    if bases is None:
        return None

    groups: list[list[np.ndarray]] = []
    for count in counts:
        patches = [_random_object_patch(rng) for _ in range(count)]
        groups.append(patches)

    placed = _place_objects(rng, (h, w), groups, colors, bases)
    if placed is None:
        return None

    markers = _choose_markers(rng, (h, w), placed, colors)
    if markers is None:
        return None

    inp = _render_input((h, w), placed, markers)
    try:
        _validate_generated(inp)
    except Exception:
        return None
    return inp


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(400):
        grid = _generate_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid puzzle input")

