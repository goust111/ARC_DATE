+                {
+                    "group_index": group_index,
+                    "color": int(colors[group_index]),
+                    "patch": patch,
+                    "local_idx": int(local_idx),
+                    "left": int(base + offset),
+                    "height": int(patch.shape[0]),
+                    "width": int(patch.shape[1]),
+                }
+            )
+
+    object_specs.sort(key=lambda item: (-item["height"] * item["width"], rng.random()))
+    occ = np.zeros(shape, dtype=bool)
+    placed: list[dict] = []
+
+    def rec(i: int) -> bool:
+        if i == len(object_specs):
+            return True
+        spec = object_specs[i]
+        patch = spec["patch"]
+        rows = list(range(0, h - patch.shape[0] + 1))
+        rng.shuffle(rows)
+        for r0 in rows:
+            if not _fits(occ, patch, r0, spec["left"]):
+                continue
+            coords = np.argwhere(patch == GREY) + np.asarray([[r0, spec["left"]]], dtype=int)
