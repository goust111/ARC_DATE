def _available_marker_cells(shape: tuple[int, int], placed: list[dict]) -> list[tuple[int, int]]:
    h, w = shape
    blocked = np.zeros(shape, dtype=bool)
    for obj in placed:
        coords = obj["coords"]
        blocked[coords[:, 0], coords[:, 1]] = True
        for r, c in coords:
            for dr, dc in STRUCT4:
                nr, nc = int(r + dr), int(c + dc)
                if 0 <= nr < h and 0 <= nc < w:
                    blocked[nr, nc] = True
    return [(r, c) for r in range(h) for c in range(w) if not blocked[r, c]]


def _choose_markers(
    rng: random.Random, shape: tuple[int, int], placed: list[dict], colors: list[int]
) -> dict[int, tuple[int, int]] | None:
    available = _available_marker_cells(shape, placed)
    if len(available) < len(colors):
        return None

    by_color: dict[int, list[dict]] = defaultdict(list)
    for obj in placed:
        by_color[int(obj["color"])].append(obj)

    ranked: dict[int, list[tuple[int, int]]] = {}
    for color in colors:
        union = np.vstack([obj["coords"] for obj in by_color[int(color)]])
        ranked[int(color)] = sorted(
            available,
            key=lambda cell: (
                _point_to_object_sqdist(cell, union),
                abs(cell[0] - union[:, 0].mean()),
                abs(cell[1] - union[:, 1].mean()),
            ),
        )[: min(60, len(available))]

    for _ in range(1500):
        markers: dict[int, tuple[int, int]] = {}
        used = set()
        order = colors[:]
        rng.shuffle(order)
        ok = True
        for color in order:
            pool = ranked[int(color)][:]
            rng.shuffle(pool)
            pool.sort(key=lambda cell: _point_to_object_sqdist(cell, np.vstack([obj["coords"] for obj in by_color[int(color)]])))
            chosen = None
            for cell in pool[:25]:
                if cell in used:
                    continue
                if any(abs(cell[0] - other[0]) + abs(cell[1] - other[1]) == 1 for other in used):
                    continue
                chosen = cell
                break
            if chosen is None:
                ok = False
                break
            markers[int(color)] = chosen
            used.add(chosen)
        if not ok:
            continue
        if _markers_match_assignments(placed, markers):
            return markers
    return None


def _markers_match_assignments(placed: list[dict], markers: dict[int, tuple[int, int]]) -> bool:
    usage = defaultdict(int)
    for obj in placed:
        scores = sorted((_point_to_object_sqdist(marker, obj["coords"]), color) for color, marker in markers.items())
        if len(scores) < 2 or scores[0][0] == scores[1][0]:
            return False
        if int(scores[0][1]) != int(obj["color"]):
            return False
        usage[int(scores[0][1])] += 1
    return set(usage) == set(markers)


def _render_input(shape: tuple[int, int], placed: list[dict], markers: dict[int, tuple[int, int]]) -> np.ndarray:
    grid = np.zeros(shape, dtype=int)
    for obj in placed:
        coords = obj["coords"]
        grid[coords[:, 0], coords[:, 1]] = GREY
    for color, (r, c) in markers.items():
        grid[r, c] = int(color)
    return grid


