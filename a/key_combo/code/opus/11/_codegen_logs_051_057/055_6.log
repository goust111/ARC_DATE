+def _place_objects(
+    rng: random.Random,
+    shape: tuple[int, int],
+    groups: list[list[np.ndarray]],
+    colors: list[int],
+    base_cols: list[int],
+) -> list[dict] | None:
+    h, w = shape
+    object_specs = []
+    for group_index, patches in enumerate(groups):
+        base = base_cols[group_index]
+        items = list(enumerate(patches))
+        rng.shuffle(items)
+        max_offset = 6
+        column_pool = []
+        for offset in range(max_offset + 1):
+            ok = [idx for idx, patch in items if base + offset + patch.shape[1] <= w]
+            if ok:
+                column_pool.append(offset)
+        if len(column_pool) < len(patches):
+            return None
+        offsets = rng.sample(column_pool, len(patches))
+        if 0 not in offsets:
