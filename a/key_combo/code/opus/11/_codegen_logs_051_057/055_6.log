+
+def _choose_markers(
+    rng: random.Random, shape: tuple[int, int], placed: list[dict], colors: list[int]
+) -> dict[int, tuple[int, int]] | None:
+    available = _available_marker_cells(shape, placed)
+    if len(available) < len(colors):
+        return None
+
+    by_color: dict[int, list[dict]] = defaultdict(list)
+    for obj in placed:
+        by_color[int(obj["color"])].append(obj)
+
+    ranked: dict[int, list[tuple[int, int]]] = {}
+    for color in colors:
+        union = np.vstack([obj["coords"] for obj in by_color[int(color)]])
+        ranked[int(color)] = sorted(
+            available,
+            key=lambda cell: (
+                _point_to_object_sqdist(cell, union),
+                abs(cell[0] - union[:, 0].mean()),
+                abs(cell[1] - union[:, 1].mean()),
+            ),
+        )[: min(60, len(available))]
+
+    for _ in range(1500):
+        markers: dict[int, tuple[int, int]] = {}
+        used = set()
+        order = colors[:]
+        rng.shuffle(order)
+        ok = True
+        for color in order:
+            pool = ranked[int(color)][:]
+            rng.shuffle(pool)
+            pool.sort(key=lambda cell: _point_to_object_sqdist(cell, np.vstack([obj["coords"] for obj in by_color[int(color)]])))
+            chosen = None
+            for cell in pool[:25]:
+                if cell in used:
