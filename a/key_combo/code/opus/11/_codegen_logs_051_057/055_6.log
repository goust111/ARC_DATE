+                {
+                    **spec,
+                    "top": int(r0),
+                    "coords": coords,
+                    "bbox": _bbox(coords),
+                }
+            )
+            if rec(i + 1):
+                return True
+            placed.pop()
+            occ[coords[:, 0], coords[:, 1]] = False
+        return False
+
+    if not rec(0):
+        return None
+    return placed
