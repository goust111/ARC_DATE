+        rng.shuffle(order)
+        ok = True
+        for color in order:
+            pool = ranked[int(color)][:]
+            rng.shuffle(pool)
+            pool.sort(key=lambda cell: _point_to_object_sqdist(cell, np.vstack([obj["coords"] for obj in by_color[int(color)]])))
