+def _pick_base_columns(rng: random.Random, width: int, n_groups: int) -> list[int] | None:
+    candidates = list(range(0, max(1, width - 5)))
+    for _ in range(300):
+        bases = sorted(rng.sample(candidates, n_groups))
+        if all(bases[i + 1] - bases[i] >= 3 for i in range(n_groups - 1)):
+            return bases
+    return None
