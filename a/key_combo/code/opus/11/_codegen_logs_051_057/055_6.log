+            return None
+        chosen_offsets = rng.sample(valid_offsets, count)
+        if 0 not in chosen_offsets:
+            chosen_offsets[0] = 0
+        if len(set(chosen_offsets)) != len(chosen_offsets):
+            return None
+
+        order = list(range(count))
+        rng.shuffle(order)
+        for local_idx, offset in zip(order, chosen_offsets):
