+        return False
+    patch_coords = np.argwhere(patch == GREY)
+    patch_set = {(int(r0 + r), int(c0 + c)) for r, c in patch_coords}
+    for rr, cc in patch_set:
+        if mask[rr, cc]:
+            return False
+        for dr, dc in STRUCT4:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in patch_set and mask[nr, nc]:
