+def _sample_counts(rng: random.Random, n_groups: int, total_objects: int) -> list[int]:
+    cuts = sorted(rng.sample(range(1, total_objects), n_groups - 1))
+    parts = []
+    prev = 0
+    for cut in cuts + [total_objects]:
+        parts.append(cut - prev)
+        prev = cut
+    rng.shuffle(parts)
+    if max(parts) == 1:
+        parts[0] += 1
+        parts[-1] -= 1
+    return parts
+
