+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    src_h = rng.choice(SOURCE_HEIGHTS)
+    src_w = rng.choice(SOURCE_WIDTHS)
+    built = _random_connected_shape(src_h, src_w, rng)
+    if built is None:
+        return None
+    patch, marker_rc = built
+    mr, mc = marker_rc
+
