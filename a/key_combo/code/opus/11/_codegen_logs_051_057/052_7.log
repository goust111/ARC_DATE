+    for frame in frames:
+        ih, iw = int(frame["inner_h"]), int(frame["inner_w"])
+        sh, sw = patch.shape
+        assert ih % sh == 0 and iw % sw == 0, "frame interior must be an integer multiple of source size"
+        k_h = ih // sh
+        k_w = iw // sw
