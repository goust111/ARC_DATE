+        "bbox": (r0, c0, r1, c1),
+        "interior_bbox": (r0 + 1, c0 + 1, r1 - 1, c1 - 1),
+        "marker": (r0 + 1 + fr, c0 + 1 + fc),
+        "inner_h": oh - 2,
+        "inner_w": ow - 2,
