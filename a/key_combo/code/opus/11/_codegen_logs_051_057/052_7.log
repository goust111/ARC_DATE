+import numpy as np
+
+
+BG = 0
+RED = 2
+FRAME = 5
+SOURCE = 7
+
+MAX_GENERATION_ATTEMPTS = 500
+GRID_SIZE_RANGE = (22, 30)
+SOURCE_HEIGHTS = (4, 5)
+SOURCE_WIDTHS = (4, 5)
+SOURCE_AREA_RANGE = (8, 15)
+FRAME_COUNT_WEIGHTS = [(2, 5), (3, 4), (4, 1)]
