+        k = int(frame["k"])
+        scaled = scale_patch(patch, k)
+        fr, fc = frame["marker"]
+        place_r0 = fr - mr * k
+        place_c0 = fc - mc * k
+        ir0, ic0, ir1, ic1 = frame["interior_bbox"]
+        for rr, cc in np.argwhere(scaled != BG):
+            tr = int(place_r0 + rr)
+            tc = int(place_c0 + cc)
+            assert ir0 <= tr <= ir1 and ic0 <= tc <= ic1, "scaled motif must fit fully inside the frame interior"
