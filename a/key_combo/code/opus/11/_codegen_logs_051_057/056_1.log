+
+def _normalize_shape(coords: np.ndarray | list[Coord] | tuple[Coord, ...]) -> Shape:
+    arr = np.asarray(coords, dtype=int)
+    origin = arr.min(axis=0)
+    shifted = arr - origin
+    return tuple(sorted((int(r), int(c)) for r, c in shifted))
