+
+
+def _bbox_gap_ok(a: Box, b: Box, min_gap: int = 2) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    row_gap = max(ar0 - br1 - 1, br0 - ar1 - 1, 0)
+    col_gap = max(ac0 - bc1 - 1, bc0 - ac1 - 1, 0)
+    return max(row_gap, col_gap) >= int(min_gap)
