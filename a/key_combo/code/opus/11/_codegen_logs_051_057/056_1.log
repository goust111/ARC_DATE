+
+def _build_shape_library() -> tuple[dict[int, list[Shape]], dict[Shape, Shape], dict[tuple[int, int, int], list[Shape]]]:
+    cells = [(r, c) for r in range(SHAPE_BBOX_LIMIT) for c in range(SHAPE_BBOX_LIMIT)]
