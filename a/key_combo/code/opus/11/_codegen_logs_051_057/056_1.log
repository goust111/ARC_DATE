+
+def _bridge_info(upper: dict, lower: dict) -> tuple[list[Coord], int, int]:
+    ur0, uc0, ur1, uc1 = map(int, upper["bbox"])
+    lr0, lc0, lr1, lc1 = map(int, lower["bbox"])
+    assert ur0 < lr0, "pair must have a unique upper sprite"
