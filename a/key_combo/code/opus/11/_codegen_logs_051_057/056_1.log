+BG = 0
+PALETTE = (1, 2, 3, 4, 7, 8)
+PAIR_COUNTS = (3, 4)
+GAP_RANGE = (2, 6)
+MAX_GENERATION_ATTEMPTS = 400
+SHAPE_BBOX_LIMIT = 4
