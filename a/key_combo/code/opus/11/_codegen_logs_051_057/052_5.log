+    line_start = hidden_idx * (SLOT + GAP)
+    if axis == "row":
+        inp[line_start : line_start + SLOT, :] = OCCLUDER
+    else:
+        inp[:, line_start : line_start + SLOT] = OCCLUDER
+    return inp, out, shape_to_color
+
