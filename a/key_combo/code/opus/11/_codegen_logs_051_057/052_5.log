_GEN_BLACK = 0
_GEN_BLUE = 1
_GEN_TEMP_MARKER = 2
_GEN_BASE_COLORS = (_GEN_BLACK, _GEN_BLUE)
_GEN_MARKER_COLORS = tuple(range(2, 10))

# Blue wall size and topology targets.
_GEN_BLUE_TOTAL_MIN = 43
