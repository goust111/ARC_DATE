+    h, w = grid.shape
+    blobs_done = 0
+    for _ in range(200):
+        if blobs_done >= count:
+            return True
+        free = np.argwhere((grid == BG) & (~forbidden))
+        if free.size == 0:
+            break
+        sr, sc = map(int, random.choice(free))
+        length = random.randint(1, 3)
+        color = int(random.choice(color_choices))
+        cells = [(sr, sc)]
+        for _ in range(length - 1):
+            next_steps: list[tuple[int, int]] = []
+            for r, c in cells:
