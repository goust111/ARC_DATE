+def _find_complete_frame(grid: np.ndarray) -> tuple[int, tuple[int, int, int, int]]:
+    candidates: list[tuple[int, tuple[int, int, int, int]]] = []
+    for color in np.unique(grid):
+        color = int(color)
+        mask = grid == color
+        box = _bbox(mask)
+        if box is None:
+            continue
+        r0, c0, r1, c1 = box
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
