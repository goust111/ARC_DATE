+                    "source": (a, b),
+                    "dest": (da, db),
+                    "source_line": source_line,
+                    "dest_line": dest_line,
+                    "moved": int(a != da) + int(b != db),
+                    "length": len(dest_line),
+                    "source_is_diag": source_is_diag,
