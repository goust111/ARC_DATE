+    def rec(start: int) -> bool:
+        if len(selected) == pair_count:
+            return True
+        remaining = pair_count - len(selected)
+        for idx in range(start, len(pool)):
+            if len(pool) - idx < remaining:
+                return False
+            cand = pool[idx]
+            src_cells = set(cand["source"])
+            if src_cells & used_source:
