+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(13, 18)
+    w = rng.randint(13, 18)
+    direction = rng.choice(["left", "right", "up", "down"])
+    rod_len = rng.randint(2, 4)
