+def _build_compaction_map(
+    board_bbox: tuple[int, int, int, int],
+    parity: int,
+    direction: str,
+) -> dict[tuple[int, int], tuple[int, int]]:
+    mapping: dict[tuple[int, int], tuple[int, int]] = {}
+    r0, c0, r1, c1 = board_bbox
