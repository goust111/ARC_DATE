+    h, w = sub.shape
+
+    if h == 2 and w > 2:
+        col_counts = sub.sum(axis=0).astype(int).tolist()
+        if col_counts[:2] == [2, 2] and all(v == 1 for v in col_counts[2:]):
+            return "right"
+        if col_counts[-2:] == [2, 2] and all(v == 1 for v in col_counts[:-2]):
+            return "left"
