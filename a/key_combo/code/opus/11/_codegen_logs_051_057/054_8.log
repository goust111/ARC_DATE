+        for c in range(c0, c1 + 1):
+            grid[r, c] = Color.BLUE if (r + c) % 2 == parity else Color.BLACK
+
+
+def _place_pointer(
+    grid: np.ndarray,
+    board_bbox: tuple[int, int, int, int],
+    direction: str,
+    rod_len: int,
