+def _solve_with_direction(
+    grid: np.ndarray,
+    direction: str,
+    board_bbox: tuple[int, int, int, int],
+    marker_colors: list[int],
+) -> np.ndarray:
+    movable_colors = {Color.BLUE, *marker_colors}
