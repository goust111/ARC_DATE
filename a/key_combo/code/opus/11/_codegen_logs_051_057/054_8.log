+
+
+def _parse_board(grid: np.ndarray) -> tuple[tuple[int, int, int, int], int, list[int]]:
+    movable_mask = (grid != Color.BLACK) & (grid != Color.RED)
+    coords = np.argwhere(movable_mask)
