+    if direction == "left":
+        body_c = rod_len
+        row_hi = h - 2
+        body_r = rng.randint(1, row_hi - 1)
+        grid[body_r : body_r + 2, body_c : body_c + 2] = Color.RED
+        grid[body_r + attach, :body_c] = Color.RED
+        assert body_c + 2 < c0
+    elif direction == "right":
+        body_c = w - rod_len - 2
+        row_hi = h - 2
+        body_r = rng.randint(1, row_hi - 1)
+        grid[body_r : body_r + 2, body_c : body_c + 2] = Color.RED
+        grid[body_r + attach, body_c + 2 :] = Color.RED
