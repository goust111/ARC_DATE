+    else:
+        body_r = h - rod_len - 2
+        col_hi = w - 2
+        body_c = rng.randint(1, col_hi - 1)
+        grid[body_r : body_r + 2, body_c : body_c + 2] = Color.RED
+        grid[body_r + 2 :, body_c + attach] = Color.RED
