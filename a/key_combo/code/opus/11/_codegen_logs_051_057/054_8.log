+        src_dr = src[1][0] - src[0][0]
+        src_dc = src[1][1] - src[0][1]
+        if src_dr != 0 and abs(src_dr) == abs(src_dc):
+            assert set(_diag_cells(src[0], src[1])) != set(_diag_cells(dst[0], dst[1]))
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(13, 18)
