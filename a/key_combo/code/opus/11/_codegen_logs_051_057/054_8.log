+    for color in marker_colors:
+        src = sorted(map(tuple, np.argwhere(grid == color)))
+        dst = sorted(map(tuple, np.argwhere(compressed_only == color)))
+        assert len(src) == 2 and len(dst) == 2
+        dr = dst[1][0] - dst[0][0]
+        dc = dst[1][1] - dst[0][1]
