+    red = np.argwhere(clean == PATTERN)
+    pat_center = (int(red[:, 1].min()) + int(red[:, 1].max())) / 2.0
+    occ_center = (int(occ_box[1]) + int(occ_box[3])) / 2.0
+    if (extend_dir == "right") != (occ_center < pat_center):
+        return False
