+    return _extend_right(clean, period, BG, pat_c0, pat_c1, rows)
+
+
+def _validate_case(
+    inp: np.ndarray,
+    clean: np.ndarray,
+    expected: np.ndarray,
+    period: int,
+    extend_dir: str,
+) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+
+    occ_coords, occ_box = _solid_rectangle_component(inp, OCCLUDER)
+    occ_mask = np.zeros(inp.shape, dtype=bool)
+    occ_mask[occ_coords[:, 0], occ_coords[:, 1]] = True
+    if np.count_nonzero(clean[occ_mask] == PATTERN) == 0:
+        return False
