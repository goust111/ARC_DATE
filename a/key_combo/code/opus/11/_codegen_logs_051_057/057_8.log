338:             and _GEN_LOOP_MARGIN <= c < _GEN_W - _GEN_LOOP_MARGIN
339:         ):
340:             return False
341:         if not eligible[r, c] or g[r, c] != _GEN_BLACK:
342:             return False
343:         return all(
344:             not (in_bounds(g.shape, nr, nc) and g[nr, nc] == _GEN_BLUE)
345:             for nr, nc in neighbors4(r, c)
