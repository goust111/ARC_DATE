+            return int(period)
+    raise AssertionError("no horizontal period found")
+
+
+def _repair_occlusion(
+    grid: np.ndarray,
+    occ_mask: np.ndarray,
+    period: int,
+    bg: int,
+    c0: int,
+    c1: int,
+) -> np.ndarray:
