+def _expected_from_clean(clean: np.ndarray, period: int, extend_dir: str) -> np.ndarray:
+    red = np.argwhere(clean == PATTERN)
+    pat_c0 = int(red[:, 1].min())
+    pat_c1 = int(red[:, 1].max())
+    rows = sorted(set(int(r) for r in red[:, 0]))
+    if extend_dir == "right":
+        return _extend_right(clean, period, BG, pat_c0, pat_c1, rows)
+    return _extend_left(clean, period, BG, pat_c0, pat_c1, rows)
+
+
+def _naive_without_repair(inp: np.ndarray, period: int, extend_dir: str) -> np.ndarray:
+    erased = inp.copy()
+    erased[erased == OCCLUDER] = BG
+    red = np.argwhere(erased == PATTERN)
+    pat_c0 = int(red[:, 1].min())
+    pat_c1 = int(red[:, 1].max())
+    rows = sorted(set(int(r) for r in red[:, 0]))
+    if extend_dir == "right":
+        return _extend_right(erased, period, BG, pat_c0, pat_c1, rows)
+    return _extend_left(erased, period, BG, pat_c0, pat_c1, rows)
+
+
+def _opposite_direction(clean: np.ndarray, period: int, extend_dir: str) -> np.ndarray:
+    red = np.argwhere(clean == PATTERN)
+    pat_c0 = int(red[:, 1].min())
+    pat_c1 = int(red[:, 1].max())
+    rows = sorted(set(int(r) for r in red[:, 0]))
+    if extend_dir == "right":
