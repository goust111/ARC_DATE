+    return None
+
+
+def _render_clean_case(
+    period: int,
+    n_periods: int,
+    band_h: int,
+    top: int,
+    tile: np.ndarray,
+    left_margin: int,
+    right_margin: int,
+) -> np.ndarray:
+    h = top + band_h + random.randint(2, 4)
+    pattern_w = period * n_periods
+    w = left_margin + pattern_w + right_margin
+    grid = np.full((h, w), BG, dtype=int)
+    band = np.tile(tile, (1, n_periods))
