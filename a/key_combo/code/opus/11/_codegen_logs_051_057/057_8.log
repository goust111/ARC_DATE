+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 7
+PATTERN = 2
+OCCLUDER = 3
+
+GRID_H_RANGE = (10, 15)
+PERIOD_CHOICES = (3, 4)
+PERIOD_COUNT_CHOICES = (4, 5, 6)
+BAND_HEIGHT_RANGE = (3, 6)
+GEN_ATTEMPTS = 600
