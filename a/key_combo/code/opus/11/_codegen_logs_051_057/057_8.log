327:     black_labels, n_labels = label_mask(g == _GEN_BLACK, connectivity=4)
328:     if n_labels == 0:
329:         return []
330:     exterior = max(
331:         range(1, n_labels + 1), key=lambda label_id: int(np.sum(black_labels == label_id))
332:     )
333:     eligible = black_labels == exterior
334: 
