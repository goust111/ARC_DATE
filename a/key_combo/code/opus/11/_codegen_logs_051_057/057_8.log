+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _solid_rectangle_component(grid: np.ndarray, color: int) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    comps = _components_of_color(grid, color)
