352:     def extend(path: list[tuple[int, int]]) -> None:
353:         if len(out) >= _GEN_MAX_PATH_CANDIDATES:
354:             return
355:         if len(path) == length:
356:             out.append(path.copy())
357:             return
358:         last_r, last_c = path[-1]
359:         next_cells = list(neighbors4(last_r, last_c))
360:         random.shuffle(next_cells)
361:         used = set(path)
362:         for nr, nc in next_cells:
363:             if not in_bounds(g.shape, nr, nc) or not cell_ok(nr, nc) or (nr, nc) in used:
364:                 continue
365:             if any(
366:                 (ar, ac) in used and (ar, ac) != path[-1]
367:                 for ar, ac in neighbors4(nr, nc)
368:             ):
369:                 continue
370:             path.append((nr, nc))
371:             extend(path)
372:             path.pop()
373: 
374:     for start in starts:
375:         if len(out) >= _GEN_MAX_PATH_CANDIDATES:
376:             break
377:         if cell_ok(*start):
378:             extend([start])

