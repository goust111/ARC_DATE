+def _extend_right(grid: np.ndarray, period: int, bg: int) -> np.ndarray:
+    h, w = grid.shape
+    out = np.full((h, w + period), int(bg), dtype=int)
+    out[:, :w] = grid
+    out[:, w:] = grid[:, w - period : w]
+    return out
+
