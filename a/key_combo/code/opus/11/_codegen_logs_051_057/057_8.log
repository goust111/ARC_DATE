14: def main(input_grid):
15:     """
16:     Continue the translational pattern across the canvas and shift its phase one column right.
17: 
18:     Input structure:
19:     - The background is a non-black color inferred from the border.
20:     - Foreground pixels form a partially tiled translational pattern.
21:     - The pattern does not cover the full canvas in the input.
22: 
23:     Rule:
24:     - Infer the background color from the most common border color.
25:     - Detect translational symmetries of the foreground pattern.
26:     - Fill a one-column-wider canvas by symmetry orbits, then drop the first column.
27: 
28:     Key insight:
29:     - Extending before cropping creates the rightward phase shift without wraparound artifacts.
30:     """
31:     # Plan:
32:     # 1. Find the background color
33:     # 2. Find the repeated translation, which is a symmetry
34:     # 3. Extend the pattern by computing the orbit of each pixel in the pattern
35: 
36:     # Find the background color which is the most common color along the border of the canvas
37:     pixels_on_border = np.concatenate([input_grid[0, :], input_grid[-1, :], input_grid[:, 0], input_grid[:, -1]])
38:     background = max(set(pixels_on_border), key=list(pixels_on_border).count)
39:     
40:     # Find the repeated translation, which is a symmetry
41:     symmetries = detect_translational_symmetry(input_grid, ignore_colors=[], background=background)
42:     assert len(symmetries) > 0, "No translational symmetry found"
43: 
44:     # We want an *infinite-tiling* style shift (no wrap artifacts), so we:
45:     # - create a canvas that is 1 column wider
46:     # - extend the symmetric pattern into that wider canvas
47:     # - take a 1-column-shifted window (crop) to get the desired phase shift
48:     H, W = input_grid.shape
49:     wide = np.full((H, W + 1), background)
50: 
51:     for r, c in np.argwhere(input_grid != background):
52:         r = int(r)
53:         c = int(c)
54:         col = int(input_grid[r, c])
55:         for rr, cc in orbit(wide, r, c, symmetries):
56:             wide[rr, cc] = col
57: 
58:     # Drop the first column to restore the original shape; this yields the shifted phase.
