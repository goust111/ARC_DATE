+
+def _repair_occlusion(grid: np.ndarray, occ_mask: np.ndarray, period: int, bg: int) -> np.ndarray:
+    out = grid.copy()
+    h, w = out.shape
+    coords = np.argwhere(occ_mask)
+    for r, c in coords:
+        value = None
+        for step in range(1, w + 1):
