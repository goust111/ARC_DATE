    "bottom_left": ((GRID_SHAPE[0] - 2, 0), (GRID_SHAPE[0] - 3, 0), (GRID_SHAPE[0] - 2, 1)),
    "bottom_right": ((GRID_SHAPE[0] - 2, GRID_SHAPE[1] - 1), (GRID_SHAPE[0] - 3, GRID_SHAPE[1] - 1), (GRID_SHAPE[0] - 2, GRID_SHAPE[1] - 2)),
