+    starts = [0] * 5
+    starts[0] = top
+    starts[1] = starts[0] + h0 + gap01
+    starts[2] = starts[1] + h1 + gap12
+    end12 = max(starts[1] + h1, starts[2] + h2)
+    starts[3] = end12 + gap23
