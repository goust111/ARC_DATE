+    return bands
+
+
+def _fill_bands(grid: np.ndarray, bands: list[dict], *, borrow: str = "right", use_bbox_rows: bool = True) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    n = len(bands)
+    for i, band in enumerate(bands):
+        if borrow == "right":
+            fill_color = int(bands[(i + 1) % n]["color"])
+        elif borrow == "left":
+            fill_color = int(bands[(i - 1) % n]["color"])
+        else:
