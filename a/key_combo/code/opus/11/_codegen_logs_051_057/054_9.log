    mask_coords = [tuple(rc) for rc in np.argwhere(sprite != 0)]
    occupied = grid != 0
    candidates = []

    for r0 in range(H - h + 1):
        for c0 in range(W - w + 1):
            r1, c1 = r0 + h - 1, c0 + w - 1
            if any(not (r1 < br0 or br1 < r0 or c1 < bc0 or bc1 < c0) for br0, bc0, br1, bc1 in placed_bboxes):
