def _place_sprites(H: int, W: int, sprites: list[np.ndarray]) -> np.ndarray | None:
    grid = np.zeros((H, W), dtype=int)
    placed_bboxes: list[tuple[int, int, int, int]] = []
    for sprite in sprites:
