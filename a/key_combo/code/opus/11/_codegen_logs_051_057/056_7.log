                if rr < _GEN_GRID_SIZE and cc < _GEN_GRID_SIZE and grid[rr, cc] == _GEN_BACKGROUND:
                    cells = ((r, c), (rr, cc))
                    if not _gen_would_make_2x2(grid, color, cells):
