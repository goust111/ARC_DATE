+        for bottom in range(top, h):
+            full_cols &= mask[bottom]
+            col = 0
+            while col < w:
+                while col < w and not full_cols[col]:
+                    col += 1
+                if col == w:
+                    break
+                left = col
+                while col < w and full_cols[col]:
+                    col += 1
