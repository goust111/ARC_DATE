+        if np.array_equal(_render_output(info["crop"], cavities, color_order), out):
+            return False
+    for cavity_order in alt_cavity_orders:
+        if np.array_equal(_render_output(info["crop"], cavity_order, correct_colors), out):
+            return False
+    return True
