+                    (1, 1, h1, w1),
+                    (h1 + 2, 1, h2, w1),
+                    (1, w1 + 2, tall_h, w2),
+                ]
+            else:
+                rects = [
+                    (1, 1, tall_h, w1),
+                    (1, w1 + 2, h1, w2),
+                    (h1 + 2, w1 + 2, h2, w2),
