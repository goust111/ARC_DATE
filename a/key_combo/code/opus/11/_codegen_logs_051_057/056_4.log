+def _bbox_from_mask(mask: np.ndarray) -> tuple[int, int, int, int]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        raise ValueError("empty mask")
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
