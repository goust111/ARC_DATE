def _validate_candidate(grid: np.ndarray) -> bool:
    info = _analyze_grid(grid)
    cavities = info["cavities"]
    color_stats = info["color_stats"]
    if len(cavities) not in (3, 4) or len(color_stats) != len(cavities):
