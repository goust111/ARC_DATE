    cell_set = set(cells)
    for r, c in cells:
        for r0 in (r - 1, r):
            for c0 in (c - 1, c):
                if r0 < 0 or c0 < 0 or r0 + 1 >= _GEN_GRID_SIZE or c0 + 1 >= _GEN_GRID_SIZE:
                    continue
                ok = True
                for rr in (r0, r0 + 1):
                    for cc in (c0, c0 + 1):
                        if (rr, cc) not in cell_set and grid[rr, cc] != color:
                            ok = False
                            break
                    if not ok:
                        break
                if ok:
                    return True
    return False


