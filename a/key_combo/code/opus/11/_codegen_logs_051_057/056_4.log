+    if not np.all(crop[0] == GRAY) or not np.all(crop[-1] == GRAY):
+        raise AssertionError("frame border broken")
+    if not np.all(crop[:, 0] == GRAY) or not np.all(crop[:, -1] == GRAY):
+        raise AssertionError("frame border broken")
+
+    cavities = []
+    for idx, coords in enumerate(_components(crop != GRAY)):
+        rr, cc = coords.T
