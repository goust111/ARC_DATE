+        return False
+
+    cavity_areas = [item["area"] for item in cavities]
+    counts = [item["count"] for item in color_stats]
+    if len(set(cavity_areas)) != len(cavity_areas):
+        return False
+    if len(set(counts)) != len(counts):
+        return False
