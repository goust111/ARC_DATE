+
+def _sample_color_counts(k: int) -> dict[int, int]:
+    colors = random.sample(PALETTE, k)
+    counts = random.sample([1, 2, 3, 4, 5], k)
+    random.shuffle(counts)
+    return {color: count for color, count in zip(colors, counts)}
