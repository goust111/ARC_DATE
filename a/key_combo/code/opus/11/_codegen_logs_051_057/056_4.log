+            (h1 + 2, 1, h2, w1),
+            (h1 + 2, w1 + 2, h2, w2),
+        ]
+        for r0, c0, h, w in rects:
+            crop[r0 : r0 + h, c0 : c0 + w] = BG
+        return crop, rects
