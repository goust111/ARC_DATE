def _gen_bounded_counts(n: int, total: int, lo: int, hi: int) -> list[int] | None:
    if total < n * lo or total > n * hi:
        return None

    counts: list[int] = []
    remaining = total
    for i in range(n):
        left = n - i - 1
        v_min = max(lo, remaining - left * hi)
        v_max = min(hi, remaining - left * lo)
