+
+def _can_place_mask(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    gh, gw = grid.shape
+    if r0 < 0 or c0 < 0 or r0 + h > gh or c0 + w > gw:
+        return False
+    for rr, cc in np.argwhere(mask):
+        gr = r0 + int(rr)
+        gc = c0 + int(cc)
+        if grid[gr, gc] != BG:
