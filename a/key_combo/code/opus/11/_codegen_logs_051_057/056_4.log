                (1, w1 + 2, h1, w2),
                (h1 + 2, 1, h2, wide_w),
            ]
        else:
            rects = [
                (1, 1, h1, wide_w),
                (h1 + 2, 1, h2, w1),
                (h1 + 2, w1 + 2, h2, w2),
            ]
        for r0, c0, h, w in rects:
            crop[r0 : r0 + h, c0 : c0 + w] = BG
        return crop, rects
    raise RuntimeError("failed to build 3-cavity crop")


def _build_frame_crop() -> tuple[np.ndarray, list[tuple[int, int, int, int]]]:
