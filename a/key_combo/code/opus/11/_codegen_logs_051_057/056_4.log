+    ranked_counts = sorted(color_stats, key=lambda item: item["count"], reverse=True)
+    totals = [item["total_pixels"] for item in ranked_counts]
+    if all(totals[i] > totals[i + 1] for i in range(len(totals) - 1)):
+        return False
