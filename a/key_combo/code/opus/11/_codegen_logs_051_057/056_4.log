+    outside = np.array(grid, dtype=int)
+    outside[r0 : r1 + 1, c0 : c1 + 1] = BG
+    colors = [int(v) for v in np.unique(outside) if v not in (BG, GRAY)]
+    color_stats = []
+    for color in colors:
+        comps = _components(outside == color)
+        coords = np.argwhere(outside == color)
+        color_stats.append(
