+    g = np.asarray(grid, dtype=int)
+    out = np.zeros_like(g)
+    colors = sorted(int(v) for v in np.unique(g) if int(v) != BG)
+    assert 1 <= len(colors) <= 3, "expected 1-3 foreground colors"
