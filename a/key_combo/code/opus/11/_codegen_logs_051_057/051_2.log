+def _scene_from_choices(shape: tuple[int, int], choices: Sequence[dict]) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.zeros(shape, dtype=int)
+    out = np.zeros(shape, dtype=int)
+    for cand in choices:
