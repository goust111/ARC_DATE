+        mirrored = rows[:-1][::-1] if h % 2 else rows[::-1]
+        full_rows = rows + mirrored
+        patch = np.zeros((h, w), dtype=bool)
+        for r, (lft, rgt) in enumerate(full_rows):
+            patch[r, lft : rgt + 1] = True
