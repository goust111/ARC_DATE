+        return None
+    if np.array_equal(recovered, out_mask):
+        return None
+    if not np.array_equal(repaired, out_mask):
+        return None
+    if np.array_equal(wrong_repaired, out_mask):
+        return None
+    if np.array_equal(direct_repaired, out_mask):
+        return None
