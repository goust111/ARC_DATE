+        rows = [(0, w - 1)]
+        while len(rows) < half:
+            prev_l, prev_r = rows[-1]
+            candidates = _row_walk_candidates(prev_l, prev_r, w)
+            random.shuffle(candidates)
+            rows.append(candidates[0])
