+            pads[random.randrange(h - 1)] = min(max_pad, 1)
+        if pads == pads[::-1]:
+            continue
+        patch = np.zeros((h, w), dtype=bool)
+        for r, pad in enumerate(pads):
+            patch[r, pad : w - pad] = True
+        if not _is_connected4(patch):
+            continue
