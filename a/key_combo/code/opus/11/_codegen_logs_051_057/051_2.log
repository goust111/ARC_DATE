+def _place_patch_mask(shape: tuple[int, int], patch: np.ndarray, r0: int, c0: int) -> np.ndarray:
+    H, W = shape
+    h, w = patch.shape
+    mask = np.zeros((H, W), dtype=bool)
+    mask[r0 : r0 + h, c0 : c0 + w] = patch
