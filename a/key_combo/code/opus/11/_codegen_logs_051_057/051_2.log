+
+
+def _object_candidate(
+    patch: np.ndarray,
+    axis: str,
+    color: int,
+    shape: tuple[int, int],
+    r0: int,
+    c0: int,
+) -> dict | None:
+    area = int(patch.sum())
+    out_mask = _place_patch_mask(shape, patch, r0, c0)
+    in_mask, lost = _shear_left(out_mask)
+    if lost <= 0 or 2 * lost > area:
+        return None
