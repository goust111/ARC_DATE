+def _is_symmetric(mask: np.ndarray, axis: str) -> bool:
+    if axis == "lr":
+        return np.array_equal(mask, np.fliplr(mask))
+    assert axis == "tb"
+    return np.array_equal(mask, np.flipud(mask))
