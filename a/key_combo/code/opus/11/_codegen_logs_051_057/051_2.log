+def _wide_patch() -> np.ndarray:
+    for _ in range(SHAPE_RETRIES):
+        h = random.randint(4, 6)
+        w = random.randint(max(5, h + 1), min(9, h + 4))
+        max_pad = (w - 1) // 2
+        pads = [random.randint(0, max_pad) for _ in range(h)]
