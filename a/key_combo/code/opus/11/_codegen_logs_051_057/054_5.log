def _gen_add_segment(cells, r0, c0, r1, c1):
    if r0 == r1:
        a, b = sorted((int(c0), int(c1)))
        for c in range(a, b + 1):
            cells.add((int(r0), c))
    else:
        a, b = sorted((int(r0), int(r1)))
