+        return False
+    if max(grid.shape) > 30 or max(out.shape) > 30:
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        grid = _build_candidate()
+        if grid is None:
+            continue
+        if _validate_example(grid):
