+        patch = np.zeros((h, w), dtype=int)
+        patch[mask] = int(color)
+        return patch
+    return None
+
+
+def _random_noise_patch(color: int, area: int) -> np.ndarray:
+    if area == 1:
+        return np.array([[int(color)]], dtype=int)
+    if area == 2:
