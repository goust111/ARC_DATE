+        k = int(frame["count"])
+        color = int(rank_to_color[int(frame["rank"])])
+        fr0, fc0, fr1, fc1 = r0 - k, c0 - k, r1 + k, c1 + k
+        out[fr0 : fr1 + 1, fc0 : fc1 + 1] = color
