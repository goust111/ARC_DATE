+    if len({spec["side"] for spec in specs}) < 2:
+        return []
+
+    for spec in specs:
+        spec["final_side"] = int(spec["side"] + 2 * spec["count"])
+    if len({spec["final_side"] for spec in specs}) != frame_count:
+        return []
