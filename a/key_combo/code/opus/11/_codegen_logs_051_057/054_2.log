+
+def _render_output(grid: np.ndarray, frames: list[dict], rank_to_color: dict[int, int], *, clear_markers: bool = True) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    bg = int(get_bg(out))
+    if clear_markers:
