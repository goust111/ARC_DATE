+    rank_to_color = {entry["height"]: entry["color"] for entry in legend}
+    ranked = _ranked_frames(frames)
+    expected = _render_output(grid, ranked, rank_to_color)
+
+    try:
+        actual = main(grid)
+    except Exception:
