+        return int(b0 - a1 - 1)
+    if b1 < a0:
+        return int(a0 - b1 - 1)
+    return 0
+
+
+def _bboxes_visually_clear(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = _MIN_VISUAL_GAP) -> bool:
