+        side = int(spec["side"])
+        final_side = int(spec["final_side"])
+        candidates = []
+        for r in range(_TOP_CLEARANCE, height - final_side + 1):
+            for c in range(0, width - final_side + 1):
+                orig_r0 = r + k
+                orig_c0 = c + k
+                orig_r1 = orig_r0 + side - 1
+                orig_c1 = orig_c0 + side - 1
