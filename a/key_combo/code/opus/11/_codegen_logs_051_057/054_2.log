+
+
+def _feasible_sides(marker_count: int) -> list[int]:
+    return [side for side in range(3, 6) if (side - 2) ** 2 >= marker_count]
+
+
+def _choose_frame_specs() -> list[dict]:
+    frame_count = random.choice(_FRAME_COUNT_OPTIONS)
