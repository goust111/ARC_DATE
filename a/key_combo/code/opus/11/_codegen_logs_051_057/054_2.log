+_BG = Color.BLACK
+_FRAME_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW]
+_LEGEND_COLORS = [Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
+_GRID_SIZE_RANGE = (22, 30)
+_FRAME_COUNT_OPTIONS = (3, 4)
+_TOP_CLEARANCE = 6
+_EDGE_MARGIN = 4
+_MIN_FINAL_GAP = 1
+_MIN_VISUAL_GAP = 4
