    max_legend_len = MAX_FILL_LEN - rank  # legend occupies `rank` top rows
    shared_len = int(rng.integers(1, max_legend_len + 1))
    pool = [l for l in range(1, MAX_FILL_LEN + 1) if l != shared_len]
