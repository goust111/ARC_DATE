+        if not candidates:
+            return None
+
+        final_bbox, orig_bbox = random.choice(candidates)
+        placed.append(
+            {
+                "color": int(spec["color"]),
+                "count": k,
+                "side": side,
+                "final_side": final_side,
+                "bbox": orig_bbox,
+                "final_bbox": final_bbox,
+                "markers": _frame_marker_cells(spec),
+            }
+        )
+    return placed
+
