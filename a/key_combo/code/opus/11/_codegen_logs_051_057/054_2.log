+_BG = Color.BLACK
+_FRAME_COLORS = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW]
+_LEGEND_COLORS = [Color.PINK, Color.ORANGE, Color.TEAL, Color.MAROON]
