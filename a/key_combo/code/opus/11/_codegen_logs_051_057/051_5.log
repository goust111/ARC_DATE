+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = map(int, shape)
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _is_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _tile_grid(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = map(int, shape)
+    pr, pc = map(int, tile.shape)
+    out = np.empty((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = int(tile[r % pr, c % pc])
+    return out
+
+
+def _candidate_periods(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    candidates: list[dict] = []
+
+    for pr in range(1, h + 1):
+        for pc in range(1, w + 1):
+            phase_counts = [[Counter() for _ in range(pc)] for _ in range(pr)]
+            total_seen = 0
+            for r in range(h):
+                for c in range(w):
+                    color = int(g[r, c])
+                    if color == PINK:
+                        continue
+                    phase_counts[r % pr][c % pc][color] += 1
+                    total_seen += 1
+
+            tile = np.full((pr, pc), -1, dtype=int)
+            agree = 0
+            valid = True
+            for rr in range(pr):
+                for cc in range(pc):
+                    counts = phase_counts[rr][cc]
+                    if not counts:
+                        valid = False
+                        break
+                    phase_total = sum(counts.values())
+                    best_count = max(counts.values())
+                    winners = [color for color, count in counts.items() if count == best_count]
+                    if len(winners) != 1 or best_count * 2 <= phase_total:
+                        valid = False
+                        break
+                    tile[rr, cc] = winners[0]
+                    agree += best_count
+                if not valid:
+                    break
+
+            if valid:
+                candidates.append(
+                    {
+                        "period": (pr, pc),
+                        "tile": tile,
+                        "agree": agree,
+                        "area": pr * pc,
+                    }
+                )
+
+    return candidates
+
+
+def _infer_period_and_tile(grid: np.ndarray) -> tuple[int, int, np.ndarray]:
+    candidates = _candidate_periods(grid)
