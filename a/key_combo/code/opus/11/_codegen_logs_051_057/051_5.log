+    candidates.sort(key=lambda item: (-item["agree"], item["area"], item["period"][0], item["period"][1]))
+    best = candidates[0]
+    ambiguous = [
+        cand
+        for cand in candidates
+        if cand["agree"] == best["agree"] and cand["area"] == best["area"]
