+def _grow_cluster(shape: tuple[int, int], size: int, blocked: set[tuple[int, int]]) -> set[tuple[int, int]] | None:
+    h, w = map(int, shape)
+    starts = [(r, c) for r in range(h) for c in range(w) if (r, c) not in blocked]
+    random.shuffle(starts)
