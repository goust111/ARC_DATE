+            hits_other = sum((nr, nc) in others for nr, nc in neighbors4(r, c))
+            if hits_target >= 1 and hits_other == 0:
+                options.append((r, c))
+    return random.choice(options) if options else None
+
+
+def _corrupt_clusters(
