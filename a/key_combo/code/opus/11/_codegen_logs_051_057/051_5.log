+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+N4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+NONBLACK_TILE_COLORS = (BLUE, RED, GREEN, YELLOW)
