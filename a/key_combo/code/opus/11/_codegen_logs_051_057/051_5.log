+            if not frontier:
+                break
+            cell = random.choice(tuple(frontier))
+            frontier.remove(cell)
+            cluster.add(cell)
+            for nr, nc in neighbors4(*cell):
+                if (
+                    in_bounds(shape, nr, nc)
+                    and (nr, nc) not in cluster
+                    and (nr, nc) not in blocked
+                ):
+                    frontier.add((nr, nc))
+        if len(cluster) == size:
+            return cluster
+    return None
+
