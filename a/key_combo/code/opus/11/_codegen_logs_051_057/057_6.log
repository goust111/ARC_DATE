            for a in range(THREE_COMPONENT_WIDTH_MIN, THREE_COMPONENT_WIDTH_MAX + 1)
            for b in range(THREE_COMPONENT_WIDTH_MIN, THREE_COMPONENT_WIDTH_MAX + 1)
