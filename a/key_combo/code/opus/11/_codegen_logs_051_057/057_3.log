+
+    if np.array_equal(actual, inp):
+        return False
+
+    diversity_values = {int(spec["D"]) for spec in placed}
+    if len(diversity_values) < 2:
+        return False
+
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    specs = _choose_specs()
+    inp, placed = _build_input(specs)
+    if not _scene_is_valid(inp, placed):
