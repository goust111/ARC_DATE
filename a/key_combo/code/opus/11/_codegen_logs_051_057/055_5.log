+        key = (r, c, axis)
+        if key in seen_segments:
+            continue
+        seen_segments.add(key)
+        out[r, c] = RED
+
+        if axis == "h":
+            directions = [(0, 1)] if key == (start_r, start_c, "h") else [(0, -1), (0, 1)]
+            next_axis = "v"
+        else:
+            directions = [(-1, 0), (1, 0)]
+            next_axis = "h"
+
+        new_segments: list[tuple[int, int, str]] = []
+        for dr, dc in directions:
+            prev_r, prev_c = r, c
+            rr, cc = r + dr, c + dc
+            while 0 <= rr < h and 0 <= cc < w:
+                if (rr, cc) in markers:
