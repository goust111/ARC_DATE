spec:
  grid: 18x18 [observed]
  colors: grey (background) and black (foreground); no red in input
  black_density: 0.36-0.45 of all cells
  black_components: 32-46 4-connected components per grid
  component_types:
    qualifying: 3-5 per grid; size 6-17 cells; bbox 2x4 to 5x5;
      contains exactly one max solid rectangle with h>=2 and w>=2 (area 4-8);
      may have 1-2 tied max rects (1 comp in 1 example had 2 ties, rest had 1);
      remaining cells form thin arms/branches around the rectangle
    non_qualifying: 28-43 per grid; size 1-16 cells;
