+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+MARKER_COLORS = (GREEN, PINK)
+RANK_COLORS = (YELLOW, BLUE, ORANGE, GREY)
