    sr,sc=map(int,start[0])
    markers={(int(r),int(c)):int(g[r,c]) for r,c in np.argwhere((g==3)|(g==6))}
    out=g.copy(); opened=[]; seen=set(); stack=[(sr,sc,'h')]
    while stack:
        r,c,axis=stack.pop()
        if (r,c,axis) in seen: continue
        seen.add((r,c,axis))
        out[r,c]=2
        dirs=[(0,1)] if axis=='h' and (r,c)==(sr,sc) else ([(0,-1),(0,1)] if axis=='h' else [(-1,0),(1,0)])
        next_axis='v' if axis=='h' else 'h'
        new=[]
        for dr,dc in dirs:
            pr,pc=r,c
            rr,cc=r+dr,c+dc
            while 0<=rr<H and 0<=cc<W:
                if (rr,cc) in markers:
                    if (rr,cc) not in opened:
                        opened.append((rr,cc))
                        new.append((pr,pc,next_axis))
                    break
                if out[rr,cc]==0:
                    out[rr,cc]=2
                pr,pc=rr,cc
                rr+=dr; cc+=dc
        stack.extend(new)
    return out, opened

def regions_after_rays(ray_grid):
    H,W=ray_grid.shape
    black=ray_grid==0
    vis=np.zeros_like(black,bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if black[r,c] and not vis[r,c]: vis[r,c]=1; q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if black[r,c] and not vis[r,c]: vis[r,c]=1; q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and black[rr,cc] and not vis[rr,cc]: vis[rr,cc]=1; q.append((rr,cc))
    vis2=np.zeros_like(black,bool); regs=[]
    for r in range(H):
        for c in range(W):
            if black[r,c] and not vis[r,c] and not vis2[r,c]:
                q=deque([(r,c)]); vis2[r,c]=1; pts=[]
                while q:
                    x,y=q.popleft(); pts.append((x,y))
                    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                        xx,yy=x+dr,y+dc
                        if 0<=xx<H and 0<=yy<W and black[xx,yy] and not vis[xx,yy] and not vis2[xx,yy]: vis2[xx,yy]=1; q.append((xx,yy))
                regs.append(pts)
    regs.sort(key=lambda pts:(-len(pts), min(pts)))
    return regs

def solve(grid):
    out,opened=simulate(grid)
    regs=regions_after_rays(out)
    final=out.copy()
    for color,pts in zip(FILL_COLORS, regs):
        for r,c in pts: final[r,c]=color
    return final, out, opened, regs

def validate(inp):
    H,W=inp.shape
    final, ray, opened, regs = solve(inp)
    marks=[tuple(map(int,p)) for p in np.argwhere((inp==3)|(inp==6))]
    if len(marks)<4 or len(marks)>7: return False, 'count'
    if len(opened)"'!=len(marks): return False, ('"'unopened',len(opened),len(marks))
    areas=[len(r) for r in regs]
    if not (2<=len(areas)<=4): return False, ('regions',areas)
    if len(set(areas))"'!=len(areas): return False, ('"'ties',areas)
    if min(areas)<6 or max(areas)<12: return False, ('small',areas)
    # isolated / non-edge
    for r,c in marks:
        if r in (0,H-1) or c in (0,W-1): return False, 'edge'
        for rr,cc in marks:
            if (r,c)"'!=(rr,cc) and abs(r-rr)+abs(c-cc)<=1: return False, '"'adj'
    # necessary markers
    for r,c in marks:
        g2=inp.copy(); g2[r,c]=0
        final2,_,_,_=solve(g2)
        if np.array_equal(final2, final): return False, ('unnecessary', (r,c))
