    for c in range(xr+2, W-1): candidates.append((T,c))
    # bottom row extensions both sides
    for c in range(1, xl-1): candidates.append((B,c))
    for c in range(xr+2, W-1): candidates.append((B,c))
    # left wall above/below base rows
    for r in range(1, T-1): candidates.append((r, xl))
    for r in range(R+2, H-1): candidates.append((r, xl))
    # right wall above top marker or below bottom marker
    for r in range(1, rt): candidates.append((r, xr))
    for r in range(rb+1, H-1): candidates.append((r, xr))
    random.shuffle(candidates)
    chosen=[]
    for p in candidates:
        if any(abs(p[0]-q[0])+abs(p[1]-q[1])<=1 for q in base+chosen):
            continue
        chosen.append(p)
        if len(chosen)==need:
            break
    if len(chosen)"'!=need: return None
    for r,c in chosen: g[r,c]=3 if random.random()<0.5 else 6
    ok,info=validate(g)
    return g if ok else None

success=0
for t in range(100):
    for _ in range(500):
        g=gen_once()
        if g is not None:
            success+=1
            break
    else:
        print('"'failed at',t)
        break
print('success',success)
