+        for r, c in chosen:
+            grid[r, c] = random.choice(MARKER_COLORS)
+        if _validate_generated_case(grid):
+            return grid
+
+    return None
+
+
+def generate_input() -> np.ndarray:
+    target_count = random.choice([4, 5, 6, 7])
+    for _ in range(1000):
+        if target_count == 4:
+            grid = _make_base_case()
+        else:
