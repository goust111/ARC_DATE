+
+        candidates = _candidate_extra_markers(
+            h, w, start_row, left_wall, right_wall, top_row, bottom_row, top_marker_row, bottom_marker_row
+        )
+        chosen: list[tuple[int, int]] = []
+        for p in candidates:
