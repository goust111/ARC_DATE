+    return [tuple(map(int, p)) for p in np.argwhere(np.isin(grid, MARKER_COLORS))]
+
+
+def _trace_ray_network(grid: np.ndarray) -> tuple[np.ndarray, list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
