+    diff_masks: list[np.ndarray] = []
+    colors: list[int] = []
+    for shape, size in zip(shapes, group_sizes):
+        out_color = BLUE if size > 1 else RED
+        for _ in range(size):
+            diff_masks.append(shape)
+            colors.append(out_color)
