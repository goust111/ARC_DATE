+        if np.any(without == color):
+            continue
+        vertical.append(c)
+
+    horizontal = []
+    for r in range(1, h - 1):
+        color = int(g[r, 0])
+        if color == bg or not np.all(g[r, :] == color):
+            continue
+        if r != h - r - 1:
+            continue
+        without = np.concatenate((g[:r, :], g[r + 1 :, :]), axis=0)
+        if np.any(without == color):
+            continue
