+        return False
+
+    if owners.count("A") < 2 or owners.count("B") < 2:
+        return False
+    return True
+
+
+def _generate_case() -> np.ndarray | None:
+    orientation = random.choice(["vertical", "horizontal"])
+    panel_h = random.randint(9, 13)
+    panel_w = random.randint(9, 13)
