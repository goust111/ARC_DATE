+def _variants(base: set[tuple[int, int]]) -> list[tuple[tuple[int, int], ...]]:
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    cur = _normalize(base)
+    for _ in range(4):
+        seen.add(cur)
+        seen.add(_normalize(_flip_lr(cur)))
+        cur = _normalize(_rot90(cur))
+    return sorted(seen)
