+    if not np.any(output == RED):
+        return False
+    if not np.any(output == TEAL):
+        return False
+    if not np.any(output == MAGENTA):
+        return False
+
+    for info in infos:
+        if info["has_hole"]:
+            for hole in info["holes"]:
