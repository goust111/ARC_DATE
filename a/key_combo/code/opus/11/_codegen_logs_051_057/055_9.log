+
+def try_place_role(
+    rng: random.Random,
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    shape: set[tuple[int, int]],
+    color: int,
+    role: str,
+) -> bool:
+    h, w = grid.shape
+    shape_h = max(r for r, _ in shape) + 1
+    shape_w = max(c for _, c in shape) + 1
