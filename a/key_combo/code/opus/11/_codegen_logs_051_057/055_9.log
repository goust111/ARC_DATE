+    colors = list(INPUT_COLORS)
+    rng.shuffle(colors)
+
+    if place_shape(grid, occupied, top_t, colors[0], 0, 0) is None:
+        return None
+    occupied.update({(r, c) for r, c in np.argwhere(grid == colors[0])})
