+
+    ymask = output == YELLOW
+    ys = np.argwhere(ymask)
+    r0, c0 = ys.min(axis=0)
+    r1, c1 = ys.max(axis=0)
+    if not np.all(ymask[r0 : r1 + 1, c0 : c1 + 1]):
+        return False
+    if (r1 - r0 + 1) < 3 or (c1 - c0 + 1) < 3:
+        return False
+    if (r0, c0, r1, c1) != final_rect:
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        mode = "tie" if rng.random() < 0.25 else "unique"
+        grid = build_tie_grid(rng) if mode == "tie" else build_candidate_grid(rng, mode)
+        if grid is None:
+            continue
+        if validate_grid(grid, mode):
+            return grid
+    raise RuntimeError("failed to generate a valid input")

