+    elif role == "left":
+        ranges = [(0, max(0, h - shape_h), 0, max(0, w // 3))]
+    elif role == "right":
+        ranges = [(0, max(0, h - shape_h), max(0, 2 * w // 3 - shape_w), w - shape_w)]
+    elif role == "center":
+        ranges = [(max(0, h // 4), max(0, 3 * h // 4 - shape_h), max(0, w // 4), max(0, 3 * w // 4 - shape_w))]
+    elif role == "corner":
