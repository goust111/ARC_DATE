+            (0, max(0, h // 4), 0, max(0, w // 4)),
+            (0, max(0, h // 4), max(0, 3 * w // 4 - shape_w), w - shape_w),
+            (max(0, 3 * h // 4 - shape_h), h - shape_h, 0, max(0, w // 4)),
+            (max(0, 3 * h // 4 - shape_h), h - shape_h, max(0, 3 * w // 4 - shape_w), w - shape_w),
