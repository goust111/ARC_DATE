+def random_polyomino(rng: random.Random, target_area: int) -> set[tuple[int, int]]:
+    cells = {(0, 0)}
+    while len(cells) < target_area:
+        r, c = rng.choice(tuple(cells))
+        dr, dc = rng.choice(DIR4)
+        cells.add((r + dr, c + dc))
+    return normalize(cells)
