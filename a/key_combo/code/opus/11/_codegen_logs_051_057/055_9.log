+def choose_largest_rectangle(grid: np.ndarray) -> tuple[int, int, int, int] | None:
+    rects = all_black_rectangles(grid)
+    if not rects:
+        return None
+    _, r0, c0, r1, c1 = rects[0]
+    return r0, c0, r1, c1
