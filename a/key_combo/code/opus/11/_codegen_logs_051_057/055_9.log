+def place_shape(
+    grid: np.ndarray,
+    occupied: set[tuple[int, int]],
+    coords: set[tuple[int, int]],
+    color: int,
+    top: int,
+    left: int,
+) -> set[tuple[int, int]] | None:
+    placed = {(top + r, left + c) for r, c in coords}
+    h, w = grid.shape
+    for r, c in placed:
