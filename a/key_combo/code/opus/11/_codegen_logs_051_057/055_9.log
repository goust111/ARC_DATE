+def make_l_shape(rng: random.Random) -> set[tuple[int, int]]:
+    arm_r = rng.randint(5, 8)
+    arm_c = rng.randint(5, 8)
+    thick = 1 if rng.random() < 0.75 else 2
+    cells = set()
