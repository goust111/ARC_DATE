+        out[r, c] = RED
+
+
+def transform_before_fill(
+    grid: np.ndarray,
+    *,
+    fill_holes: bool = True,
+    recolor_hollow: bool = True,
+    draw_outline: bool = True,
+) -> tuple[np.ndarray, list[dict]]:
