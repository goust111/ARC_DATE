+            continue
+        cells = {(r, c) for r in range(outer_h) for c in range(outer_w)}
+        for r in range(pad_t, pad_t + hole_h):
+            for c in range(pad_l, pad_l + hole_w):
+                cells.remove((r, c))
+        side = rng.choice(["top", "bottom", "left", "right", "none"])
+        if side != "none":
+            if side in ("top", "bottom"):
