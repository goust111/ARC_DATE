+    if pts.size == 0:
+        return set()
+    if flip:
+        pts[:, 1] *= -1
+    for _ in range(rotation % 4):
+        pts = np.stack([pts[:, 1], -pts[:, 0]], axis=1)
+    out = {(int(r), int(c)) for r, c in pts}
+    return normalize(out)
