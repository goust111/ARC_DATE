+) -> tuple[np.ndarray, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    comps = color_components(g)
+    infos = []
+
+    for comp in comps:
+        coords = comp["coords"]
+        holes = enclosed_holes(g.shape, coords)
+        has_hole = bool(holes)
+        solid = set(coords)
+        if has_hole and recolor_hollow:
+            for r, c in coords:
+                out[r, c] = TEAL
+        for hole in holes:
+            if fill_holes:
+                for r, c in hole:
+                    out[r, c] = MAGENTA
+                    solid.add((r, c))
+        infos.append(
+            {
+                "color": comp["color"],
+                "coords": coords,
+                "holes": holes,
+                "has_hole": has_hole,
+                "solid": solid,
+            }
+        )
