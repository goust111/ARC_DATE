+    top = g[:sep_row, :]
+    thumb_mask = np.isin(top, PANEL_COLORS)
+    assert int(thumb_mask.sum()) == 4, "expected exactly four thumbnail pixels"
+    thumb_box = _bbox_from_mask(thumb_mask)
