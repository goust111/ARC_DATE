+        return False
+    if np.array_equal(expected, col_out):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_RETRIES):
+        panel_h = random.randint(8, 12)
+        panel_w = random.randint(4, 5)
