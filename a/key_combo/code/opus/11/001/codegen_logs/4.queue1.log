+    transformed = []
+    for mask in masks:
+        arr = mask
+        if op in ("flipud", "both"):
+            arr = np.flipud(arr)
+        if op in ("fliplr", "both"):
+            arr = np.fliplr(arr)
+        transformed.append(arr.copy())
+    return transformed
+
+
+def _choose_sequence(masks_by_color: dict[int, np.ndarray]) -> tuple[int, ...] | None:
+    natural_out, _ = _simulate_order(PANEL_COLORS, masks_by_color)
+    perm_data = []
