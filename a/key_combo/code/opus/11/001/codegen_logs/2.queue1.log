+            return False
+    for r, c in cells:
+        for nr, nc in neighbors4((r, c)):
+            if not in_bounds(grid.shape, (nr, nc)):
+                return False
+            if int(grid[nr, nc]) == GREY:
+                return False
+            if int(grid[nr, nc]) == ORANGE and (nr, nc) not in cells:
+                return False
