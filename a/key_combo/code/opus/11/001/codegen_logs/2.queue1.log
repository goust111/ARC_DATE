+
+    if TEAL not in out or RED not in out:
+        return False
+
+    if np.array_equal(out, grid):
+        return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_RETRIES):
+        h = random.randint(17, 22)
+        w = random.randint(17, 22)
+        grid = np.zeros((h, w), dtype=int)
