+
+def try_place_obstacle_for_ray(grid: np.ndarray, ray_key: tuple[tuple[int, int], tuple[int, int], str]):
+    _, primitives, rays, _grey_comps, _obstacle_comps = analyze_grid(grid)
+    target = None
+    for ray in rays:
+        key = (ray["start"], ray["direction"], ray["kind"])
+        if key == ray_key:
+            target = ray
+            break
