+def connected_components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in neighbors4((cr, cc)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(sorted(comp))
+    return comps
+
+
+def label_color_components(grid: np.ndarray, color: int):
+    h, w = grid.shape
+    labels = np.zeros((h, w), dtype=int)
+    comps = {}
+    next_id = 1
+    for comp in connected_components_of_color(grid, color):
+        for r, c in comp:
+            labels[r, c] = next_id
+        comps[next_id] = set(comp)
+        next_id += 1
