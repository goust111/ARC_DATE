+        placed = []
+        ok = True
+        for patch in sorted(patches, key=lambda p: (bbox_of(p)[2] - bbox_of(p)[0], bbox_of(p)[3] - bbox_of(p)[1]), reverse=True):
+            r0, c0, r1, c1 = bbox_of(patch)
