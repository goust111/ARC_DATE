+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+UP = (-1, 0)
+RIGHT = (0, 1)
+DOWN = (1, 0)
+LEFT = (0, -1)
+DIRS4 = (UP, RIGHT, DOWN, LEFT)
+
+PRIMITIVE_OFFSETS = {
+    "square": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "hbar": ((0, 0), (0, 1), (0, 2)),
+    "vbar": ((0, 0), (1, 0), (2, 0)),
+}
+
+RAY_DIRS = {
+    "square": (UP, DOWN, LEFT, RIGHT),
+    "hbar": (LEFT, RIGHT),
+    "vbar": (UP, DOWN),
+}
+
+RAY_COLOR = {
+    "square": TEAL,
+    "hbar": RED,
+    "vbar": RED,
+}
+
+OBSTACLE_BASES = [
+    {(0, 0), (1, 0), (1, 1)},
+    {(0, 0), (1, 0), (2, 0), (2, 1)},
+    {(0, 1), (1, 0), (1, 1), (1, 2)},
+    {(0, 0), (0, 1), (1, 1), (2, 1)},
+    {(0, 0), (0, 1), (1, 0), (1, 1), (2, 0)},
+]
+
+MAX_GEN_RETRIES = 500
+
