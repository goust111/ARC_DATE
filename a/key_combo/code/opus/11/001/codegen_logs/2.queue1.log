+def turn_right(d: tuple[int, int]) -> tuple[int, int]:
+    return DIRS4[(DIRS4.index(d) + 1) % 4]
+
+
+def turn_left(d: tuple[int, int]) -> tuple[int, int]:
+    return DIRS4[(DIRS4.index(d) - 1) % 4]
+
+
+def turn_back(d: tuple[int, int]) -> tuple[int, int]:
+    return DIRS4[(DIRS4.index(d) + 2) % 4]
