+PRIMITIVE_OFFSETS = {
+    "square": ((0, 0), (0, 1), (1, 0), (1, 1)),
+    "hbar": ((0, 0), (0, 1), (0, 2)),
+    "vbar": ((0, 0), (1, 0), (2, 0)),
