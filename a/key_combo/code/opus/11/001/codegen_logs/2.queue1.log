+        cells.append(pos)
+    return cells
+
+
+def obstacle_cells_valid(grid: np.ndarray, cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    for r, c in cells:
+        if not in_bounds(grid.shape, (r, c)):
