+def semantic_checks(grid: np.ndarray) -> bool:
+    try:
+        out, primitives, rays, grey_comps, obstacle_comps = analyze_grid(grid)
+    except AssertionError:
+        return False
+
+    if not (2 <= len(grey_comps) <= 3):
