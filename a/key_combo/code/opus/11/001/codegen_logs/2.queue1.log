+
+    def search(remaining: set[tuple[int, int]], chosen: list[int]):
+        if len(solutions) >= 2:
+            return
+        if not remaining:
+            solutions.append(chosen.copy())
+            return
+        pivot = None
+        pivot_options = None
+        for cell in sorted(remaining):
