+    for c in range(c0, c1 + 1):
+        coords.append((r0, c))
+        if r1 != r0:
+            coords.append((r1, c))
+    for r in range(r0 + 1, r1):
+        coords.append((r, c0))
+        if c1 != c0:
+            coords.append((r, c1))
+    return coords
