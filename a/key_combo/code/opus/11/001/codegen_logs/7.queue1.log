 291:         random.shuffle(cols)
 292:         for c in cols:
 293:             border = (r1, c)
 294:             outside = (r1 + 1, c)
 295:             if outside not in occupied:
 296:                 return border, outside
 297:     elif side == 'left':
 298:         rows = list(range(r0 + 1, r1))
 299:         random.shuffle(rows)
 300:         for r in rows:
 301:             border = (r, c0)
 302:             outside = (r, c0 - 1)
 303:             if outside not in occupied and 0 <= outside[1]:
 304:                 return border, outside
 305:     elif side == 'right':
 306:         rows = list(range(r0 + 1, r1))
 307:         random.shuffle(rows)
 308:         for r in rows:
