  86: def main(grid: np.ndarray) -> np.ndarray:
  87:     """
  88:     Untangle overlapping colored rectangular frames into concentric square frames ordered by their visible crossings.
  89: 
  90:     Input structure
  91:     - The background contains several one-cell-thick axis-aligned rectangular frames, one color per frame.
  92:     - Frames overlap, and the visible color at an overlap records a directed crossing from the hidden frame to the visible frame.
  93:     - Each foreground color still has visible pixels on the perimeter of its full rectangular bounding box.
  94: 
  95:     Rule
  96:     - Infer each color's full rectangular frame from the bounding box of its visible pixels.
  97:     - Add a directed edge A -> B when B is visible at a crossing of A and B's frame perimeters.
  98:     - Find the unique path that visits every frame color once, then render those colors as one-pixel-thick concentric square frames from outside to inside.
  99: 
 100:     Key insight
 101:     - The output is not a crop of the input; the crossing graph gives a single frame order, and that order is redrawn as nested rings.
 102:     """
 103:     g = np.asarray(grid, dtype=int)
 104:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
 105: 
 106:     bg = get_bg(g)
 107:     colors, frames = _color_frames(g, bg)
 108:     edges = _crossing_edges(g, colors, frames)
 109:     order = _unique_path(colors, edges)
 110:     return _render_nested(order)
