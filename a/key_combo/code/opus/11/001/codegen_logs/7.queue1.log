 455: def _connect_cycle(grid, frame_bboxes, centers, cw_order, occupied):
 456:     """Connect adjacent clockwise frames with bounded blue paths."""
 457:     grid_h, grid_w = grid.shape
 458:     n_frames = len(frame_bboxes)
 459:     for k in range(n_frames):
 460:         fi = cw_order[k]
 461:         fj = cw_order[(k + 1) % n_frames]
 462: 
 463:         ci_r, ci_c = centers[fi]
 464:         cj_r, cj_c = centers[fj]
 465: 
 466:         side_i = _best_side(frame_bboxes[fi], cj_r, cj_c)
 467:         side_j = _best_side(frame_bboxes[fj], ci_r, ci_c)
 468: 
 469:         border_i, start_i = _pick_attachment(frame_bboxes[fi], side_i, occupied)
 470:         if border_i is None:
 471:             return False
 472: 
 473:         border_j, start_j = _pick_attachment(frame_bboxes[fj], side_j, occupied)
 474:         if border_j is None:
 475:             return False
 476: 
 477:         path = _find_path(start_i, start_j, occupied)
 478:         if path is None:
 479:             return False
 480: 
 481:         min_len, max_len = CONNECTOR_LENGTH_RANGE
 482:         if len(path) < min_len or len(path) > max_len:
 483:             return False
 484: 
 485:         if not _path_in_bounds(path, grid_h, grid_w):
 486:             return False
 487:         _draw_path(grid, path, occupied)
 488:     return True
