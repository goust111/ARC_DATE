+def _occlusion_depths(g: np.ndarray, frames: list[dict]) -> list[int]:
+    masks = [_border_mask(g.shape, frame["bbox"]) for frame in frames]
+    depths = [0] * len(frames)
+    for i in range(len(frames)):
+        for j in range(i + 1, len(frames)):
