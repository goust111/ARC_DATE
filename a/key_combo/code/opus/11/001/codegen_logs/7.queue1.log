+
+def _shared_segment(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    ma = _border_mask((max(a[2], b[2]) + 1, max(a[3], b[3]) + 1), a)
+    mb = _border_mask((max(a[2], b[2]) + 1, max(a[3], b[3]) + 1), b)
