+def _connected_mask(size: int, color: int) -> np.ndarray:
+    total = (size - 2) * (size - 2)
+    min_fill = max(3, math.ceil(total * 0.30))
+    max_fill = max(min_fill, math.floor(total * 0.55))
+    target = random.randint(min_fill, max_fill)
