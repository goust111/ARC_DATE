  41: def main(grid: np.ndarray) -> np.ndarray:
  42:     """Recolor each closed orthogonal line loop so convex bend pixels are yellow and concave bend pixels are red.
  43: 
  44:     Input structure
  45:     - The grid has a dominant background and exactly one foreground color.
  46:     - The foreground forms one or more 4-connected one-pixel-wide closed cycles; every foreground pixel has degree 2.
  47:     Rule
  48:     - Trace each cycle and inspect the turn at each foreground pixel.
  49:     - Straight pixels keep the original foreground color.
  50:     - Bend pixels whose turn direction is the majority direction for that cycle are convex corners and become yellow.
  51:     - Bend pixels whose turn direction is the minority direction for that cycle are concave corners and become red.
  52:     Key insight
  53:     - A simple rectilinear closed boundary has exactly four more convex bends than concave bends, so convexity can be inferred structurally from the majority turn sign within each traced cycle.
  54:     """
  55:     g = np.asarray(grid, dtype=int)
  56:     bg = get_bg(g)
  57:     colors = colors_present(g, exclude={bg})
  58:     assert len(colors) == 1, colors
  59:     foreground = colors[0]
  60: 
  61:     out = g.copy()
  62:     for coords in components_mask(g == foreground, connectivity=4):
  63:         path = _trace_cycle(coords)
  64:         turn_signs: dict[tuple[int, int], int] = {}
  65:         counts: Counter[int] = Counter()
  66:         n = len(path)
  67:         for i, (r, c) in enumerate(path):
  68:             pr, pc = path[i - 1]
  69:             nr, nc = path[(i + 1) % n]
  70:             incoming = (r - pr, c - pc)
  71:             outgoing = (nr - r, nc - c)
  72:             cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
  73:             if cross == 0:
  74:                 continue
  75:             sign = 1 if cross > 0 else -1
  76:             turn_signs[(r, c)] = sign
  77:             counts[sign] += 1
  78: 
  79:         assert turn_signs
  80:         assert abs(counts[1] - counts[-1]) == 4, counts
  81:         convex_sign = 1 if counts[1] > counts[-1] else -1
  82:         for (r, c), sign in turn_signs.items():
  83:             out[r, c] = YELLOW if sign == convex_sign else RED
  84: 
  85:     return out
  86: 
