+
+
+def _stamp_cluster(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    shape: tuple[tuple[int, int], ...],
+    anchor_r: int,
+    anchor_c: int,
+) -> None:
+    for dr, dc in shape:
+        r = anchor_r + dr
+        c = anchor_c + dc
+        grid[r, c] = MARKER_COLOR
+        occupied[r, c] = True
+
+
+def _place_clusters_for_color(
+    grid: np.ndarray,
+    exclusive: np.ndarray,
+    count: int,
+) -> bool:
+    occupied = np.zeros_like(exclusive, dtype=bool)
+    coords = [(int(r), int(c)) for r, c in np.argwhere(exclusive)]
+    if count == 0:
+        return True
+    if len(coords) < count:
+        return False
+
+    for _ in range(120):
+        probe = grid.copy()
+        occupied.fill(False)
+        ok = True
+        for cluster_index in range(count):
+            shapes = list(_CLUSTER_SHAPES)
+            random.shuffle(shapes)
+            if cluster_index == count - 1:
