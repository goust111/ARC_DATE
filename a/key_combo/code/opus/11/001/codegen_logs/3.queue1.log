+def _output_signature(order: list[int], counts: dict[int, int], bboxes: dict[int, tuple[int, int, int, int]]) -> tuple[tuple[int, ...], tuple[int, ...], int]:
+    size = max(max(r1 - r0 + 1, c1 - c0 + 1) for r0, c0, r1, c1 in bboxes.values())
