+                final = (1, random.randint(2, w - 3))
+            elif direction == "D":
+                final = (h - 2, random.randint(2, w - 3))
+            elif direction == "L":
+                final = (random.randint(2, h - 3), 1)
+            else:
+                final = (random.randint(2, h - 3), w - 2)
