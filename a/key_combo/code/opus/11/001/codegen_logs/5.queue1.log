+        dr, dc = DIRS[direction]
+        max_back = 0
+        while True:
+            cand = (final[0] - dr * (max_back + 1), final[1] - dc * (max_back + 1))
+            if any(not (0 <= r < h and 0 <= c < w) for r, c in _block_cells(cand)):
