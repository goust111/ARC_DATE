+        row = expected[r, panel_w + 1 : width - 1]
+        row[row == BLUE] = color
+
+    meta = {
+        "active_rows": active_rows,
+        "kinds": kinds,
+        "controls": controls,
+        "has_ring": "ring" in kinds,
+    }
+    return inp, expected, meta
