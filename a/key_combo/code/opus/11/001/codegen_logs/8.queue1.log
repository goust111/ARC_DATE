+    marker_col = w - 1
+    for r in active_rows:
+        control = int(g[r, marker_col])
+        assert control in (RED, GREEN), f"active row {r} must have a red/green control marker"
+        row = out[r, sep + 1 : marker_col]
+        row[row == BLUE] = control
