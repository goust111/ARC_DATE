+    if with_details:
+        return out, {
+            "separator": sep,
+            "active_rows": active_rows,
+            "slid_left": left_slid,
+            "shifted_components": shifted_components,
+            "hole_components": hole_components,
+            "all_enclosed_bg": _enclosed_bg_components(left_slid, BG),
