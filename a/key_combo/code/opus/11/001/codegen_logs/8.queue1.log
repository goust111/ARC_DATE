+    left = np.full((height, panel_w), BG, dtype=int)
+    placements: list[dict] = []
+    r = gaps[0]
+    for idx, patch in enumerate(patches):
+        h, w = patch.shape
+        c = panel_w - w
+        left[r : r + h, c : c + w][patch == BLACK] = BLACK
+        placements.append({"row": r, "col": c, "patch": patch})
+        r += h + gaps[idx + 1]
+    return left, placements
