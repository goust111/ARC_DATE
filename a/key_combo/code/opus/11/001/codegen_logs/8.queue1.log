+    inp = np.full((height, width), BG, dtype=int)
+    inp[:, :panel_w] = input_left
+    inp[:, panel_w] = SEP
+    inp[:, panel_w + 1 :] = right_in
+
+    expected = np.full((height, width), BG, dtype=int)
+    expected[:, :panel_w] = flush_left
+    expected[:, panel_w] = SEP
+    expected[:, panel_w + 1 :] = right_in
