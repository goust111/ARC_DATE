+def _find_separator_col(grid: np.ndarray) -> int:
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == SEP)]
+    assert len(cols) == 1, f"expected one full-height separator column, got {cols}"
+    return int(cols[0])
