+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+SEP = 5
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+GRID_H_RANGE = (15, 22)
+PANEL_W_RANGE = (9, 13)
+SHAPE_COUNT_CHOICES = (2, 3)
+GEN_ATTEMPTS = 400
