+def _enclosed_bg_components(left: np.ndarray, bg: int) -> list[np.ndarray]:
+    h, w = left.shape
+    enclosed: list[np.ndarray] = []
+    for comp in _components(left == bg):
+        if any(r == 0 or r == h - 1 or c == 0 for r, c in comp):
+            continue
+        enclosed.append(comp)
+    return enclosed
