+    comps = _components(out == BLACK)
+    out[out == BLACK] = bg
+    target_col = left.shape[1] - 1
+    shifted: list[np.ndarray] = []
+    for comp in comps:
+        max_c = int(comp[:, 1].max())
+        delta = target_col - max_c
+        moved = comp.copy()
+        moved[:, 1] += delta
+        out[moved[:, 0], moved[:, 1]] = BLACK
+        shifted.append(moved)
+    return out, shifted
+
