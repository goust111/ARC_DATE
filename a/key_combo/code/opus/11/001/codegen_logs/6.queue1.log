+def _choose_canvas_and_center() -> tuple[tuple[int, int], int, int]:
+    h = random.randint(GRID_MIN, GRID_MAX)
+    w = random.randint(GRID_MIN, GRID_MAX)
+    r = random.randint(7, h - 8)
