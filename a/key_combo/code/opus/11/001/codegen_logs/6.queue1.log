+def _render_from_constants(
+    shape: tuple[int, int], blue_consts: list[int], red_consts: list[int], base_d: int, base_s: int
+) -> tuple[np.ndarray, list[dict]]:
+    h, w = shape
+    out = np.full((h, w), BLACK, dtype=int)
+    rhombi: list[dict] = []
+
+    for i in range(len(blue_consts) - 1):
