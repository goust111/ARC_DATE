+RED = int(Color.RED)
+GREEN = int(Color.GREEN)
+YELLOW = int(Color.YELLOW)
+GREY = int(Color.GREY)
+ORANGE = int(Color.ORANGE)
+BLACK = int(Color.BLACK)
+
+FILL_BY_COMPLEXITY = {2: GREEN, 3: YELLOW, 4: ORANGE}
