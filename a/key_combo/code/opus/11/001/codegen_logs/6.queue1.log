+        for r in range(h):
+            c = r + d
+            if 0 <= c < w:
+                out[r, c] = BLUE
+
+    return out, rhombi
+
+
+def _solve(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    info = _parse_input(grid)
+    out, rhombi = _render_from_constants(
+        info["shape"], info["blue_consts"], info["red_consts"], info["base_d"], info["base_s"]
+    )
+    return out, {**info, "rhombi": rhombi}
