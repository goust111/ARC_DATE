+    for idx in range(1, len(frame_specs)):
+        prev = frame_specs[idx - 1]
+        prev_top = tops[idx - 1]
+        prev_right_abs = prev_top + prev["right_rel"]
+        tops.append(prev_right_abs - frame_specs[idx]["left_rel"])
