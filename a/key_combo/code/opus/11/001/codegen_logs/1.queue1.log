+                "area": hole["area"],
+                "height": hole["height"],
+                "left_rows": hole["left_rows"],
+                "right_rows": hole["right_rows"],
+                "top_offset": assignment["top_offset"],
+                "left_rel": left_rel,
+                "right_rel": right_rel,
+                "embedded_patch": embedded_patch,
+                "sprite_patch": sprite,
+            }
