+    frame_top = random.randint(*FRAME_TOP_RANGE)
+    max_sprite_h = max(item["height"] for item in holes)
+    min_h = max(CANVAS_H_RANGE[0], frame_top + FRAME_H + 2 + max_sprite_h)
