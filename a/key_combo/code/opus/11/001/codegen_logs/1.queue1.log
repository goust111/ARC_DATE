+    inp = np.zeros((canvas_h, width), dtype=int)
+    frame_cols = []
+    col = 0
+    for idx, spec in enumerate(frame_specs):
+        frame_cols.append(col)
+        _paste(inp, _frame_patch(spec["mask"], spec["top_offset"]), frame_top, col)
+        col += FRAME_W
