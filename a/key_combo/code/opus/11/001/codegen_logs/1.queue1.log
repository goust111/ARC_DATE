+            left_rows = tuple(int(r) for r in np.flatnonzero(mask[:, 0]))
+            right_rows = tuple(int(r) for r in np.flatnonzero(mask[:, -1]))
+            if len(left_rows) < 2 or len(right_rows) < 2:
+                continue
