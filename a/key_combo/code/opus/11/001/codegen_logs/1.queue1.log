+
+    hole_full = hole_components[0]
+    hole_box = _bbox(hole_full)
+    assert hole_box is not None
+    hole_crop = _crop(hole_full, hole_box)
+    return {
+        "bbox": box,
+        "patch": patch,
+        "hole_box_rel": hole_box,
+        "hole_crop": hole_crop,
+    }
