+    left_rel = hr0 + int(sprite["left_row"])
+    right_rel = hr0 + int(sprite["right_row"])
+    patch[left_rel, 0] = int(sprite["color"])
+    patch[right_rel, -1] = int(sprite["color"])
+    return patch, int(left_rel), int(right_rel)
