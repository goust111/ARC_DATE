+    for spec in frame_specs:
+        left_choices = {1 + spec["top_offset"] + r for r in spec["left_rows"]}
+        right_choices = {1 + spec["top_offset"] + r for r in spec["right_rows"]}
+        if len(left_choices) < 2 or len(right_choices) < 2:
