+    min_top = min(tops)
+    max_bottom = max(top + FRAME_H for top in tops)
+    out = np.zeros((max_bottom - min_top, FRAME_W * len(frame_specs)), dtype=int)
+    c = 0
+    for top, spec in zip(tops, frame_specs):
+        _paste(out, spec["embedded_patch"], top - min_top, c)
+        c += FRAME_W
+    return out
