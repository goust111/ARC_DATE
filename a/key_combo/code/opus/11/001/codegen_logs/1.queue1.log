+    if not _place_sprites(inp, frame_specs, frame_cols, frame_top + FRAME_H - 1):
+        return None
+
+    expected = _expected_from_specs(frame_specs, frame_top)
+    if not _semantic_checks(inp, expected, frame_specs, seps):
+        return None
+    return inp
