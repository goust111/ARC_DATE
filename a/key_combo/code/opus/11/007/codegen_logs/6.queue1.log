+        if np.array_equal(_naive_unrotated_output(grid), expected):
+            return False
+        if np.array_equal(main(grid), _naive_unrotated_output(grid)):
+            return False
+        if not np.array_equal(main(grid), expected):
+            return False
+    except AssertionError:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    panel, expected = _build_aligned_panel()
+
+    control_colors = random.sample(COLOR_POOL, 2)
+    guide_color_pool = [c for c in COLOR_POOL if c not in control_colors and c not in set(map(int, expected.ravel()))]
+    if len(guide_color_pool) < 0:
