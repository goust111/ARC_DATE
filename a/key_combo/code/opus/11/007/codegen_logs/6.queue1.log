            if keep != len(path):
                break

        for cell in path[:keep]:
            previous = planned.get(cell)
            assert previous is None or previous == color, "conflicting rays must not overlap"
            planned[cell] = color

    out = g.copy()
    for (r, c), color in planned.items():
        out[r, c] = color
    return out

