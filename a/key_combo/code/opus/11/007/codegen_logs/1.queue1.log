+        elif edge == "bottom":
+            c0 = rng.randint(1, w - bw - 1)
+            bbox = (h - bh, c0, h - 1, c0 + bw - 1)
+        elif edge == "left":
+            r0 = rng.randint(1, h - bh - 1)
