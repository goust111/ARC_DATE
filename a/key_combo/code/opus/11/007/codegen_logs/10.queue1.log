+
+def _random_layout(shapes: list[tuple[int, int]], grid_shape: tuple[int, int], border: int = 1):
+    h, w = grid_shape
+    occupied = np.zeros(grid_shape, dtype=bool)
+    placements: list[tuple[int, int] | None] = [None] * len(shapes)
