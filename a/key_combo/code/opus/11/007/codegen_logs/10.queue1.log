+    if any(np.array_equal(expected_stretch, other) for other in distractor_stretches):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    inner_h = random.randint(5, 8)
+    inner_w = random.randint(5, 8)
