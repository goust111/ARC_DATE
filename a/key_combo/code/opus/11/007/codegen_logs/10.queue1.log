+    positions = [
+        (center_r0 - top_gap - marker_dims[0][0], center_c0 - left_gap - marker_dims[0][1]),
+        (center_r0 - top_gap - marker_dims[1][0], center_c0 + cw + right_gap),
+        (center_r0 + ch + bottom_gap, center_c0 - left_gap - marker_dims[2][1]),
