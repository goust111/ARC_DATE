+    sprite = grid[tr0 : tr1 + 1, tc0 : tc1 + 1] == color
+    expected_stretch = _stretch_mask(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1))
+    if not np.array_equal(out[fr0 + 1 : fr1, fc0 + 1 : fc1] == color, expected_stretch):
+        return False
