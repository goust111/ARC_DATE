+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME_COLOR = 5
+PALETTE = tuple(color for color in range(1, 10) if color != FRAME_COLOR)
+MARKER_DIMS = ((1, 2), (2, 1))
+GEN_ATTEMPTS = 500
