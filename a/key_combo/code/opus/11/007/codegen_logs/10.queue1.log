+            for bits in range(1 << area):
+                pop = bits.bit_count()
+                if pop < 3 or pop > 6:
+                    continue
+                mask = np.zeros((h, w), dtype=bool)
+                for idx in range(area):
+                    if (bits >> idx) & 1:
+                        mask[idx // w, idx % w] = True
