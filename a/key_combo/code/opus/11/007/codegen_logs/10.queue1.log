+
+def _draw_hv_line(canvas: np.ndarray, start: tuple[int, int], end: tuple[int, int]) -> None:
+    r0, c0 = start
+    r1, c1 = end
+    if r0 == r1:
+        lo, hi = sorted((c0, c1))
+        canvas[r0, lo : hi + 1] = True
+    elif c0 == c1:
+        lo, hi = sorted((r0, r1))
+        canvas[lo : hi + 1, c0] = True
