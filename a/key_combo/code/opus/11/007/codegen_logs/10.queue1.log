+
+    try:
+        expected = main(grid)
+    except Exception:
+        return None
+    return grid if _validate_generated(grid, expected) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
