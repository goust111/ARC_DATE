    intervals = []
    for width in GEN_ARCH_WIDTHS:
        stop = GEN_GRID_W - width - GEN_ARCH_RIGHT_MARGIN + 1
        for left in range(GEN_ARCH_LEFT_MIN, stop):
            intervals.append((left, left + width - 1, width))
    if count == 1:
