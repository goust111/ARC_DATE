+        candidates = _noise_candidate_cells(noisy, clean_panel, quadrant)
+        rng.shuffle(candidates)
+        placed = None
+        for r, c in candidates:
+            if any(max(abs(r - rr), abs(c - cc)) <= 1 for rr, cc in used):
+                continue
+            placed = (r, c)
+            break
+        if placed is None:
+            return None
