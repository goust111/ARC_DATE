+        host = int(clean_panel[r, c])
+        other = _foreground_colors(clean_panel)[1] if host == _foreground_colors(clean_panel)[0] else _foreground_colors(clean_panel)[0]
+        noisy[r, c] = int(other)
+        noise_map[(r, c)] = host
+        used.add((r, c))
+
+    return noisy, noise_map
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    clean_panel: np.ndarray,
+    panel_with_dents: np.ndarray,
+    defect_cells: set[tuple[int, int]],
