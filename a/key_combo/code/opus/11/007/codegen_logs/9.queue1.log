+    inactive_noise = [pos for pos in noise_map if int(expected[_quadrant_of_cell(*clean_panel.shape, *pos) // 2, _quadrant_of_cell(*clean_panel.shape, *pos) % 2]) == GEN_BG]
+    if not inactive_noise:
