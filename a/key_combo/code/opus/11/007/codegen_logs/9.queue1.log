+            delta = -1 if cuts[idx] == hi else 1
+            cuts[idx] += delta
+        left_color, right_color = (a, b) if rng.random() < 0.5 else (b, a)
+        for r, cut in enumerate(cuts):
+            panel[r, :cut] = left_color
+            panel[r, cut:] = right_color
+    else:
+        center = h // 2
+        lo = max(3, center - 2)
+        hi = min(h - 3, center + 2)
