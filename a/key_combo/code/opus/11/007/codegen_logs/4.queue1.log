+    assert distractors
+    assert any(
+        _metric(clear_anchor, (marker[0], marker[1])) > _metric(clear_anchor, (winner[0], winner[1]))
+        and (marker[0] < winner[0] or (marker[0] == winner[0] and marker[1] < winner[1]))
+        for marker in distractors
