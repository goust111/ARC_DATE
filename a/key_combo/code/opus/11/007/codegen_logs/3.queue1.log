+        right = int(legend[rr, 1])
+        assert left != BG and right != BG and left != right, "each legend row must contain a color pair"
+        assert left not in pair_map and right not in pair_map, "legend colors must be unique"
+        pair_map[left] = right
+        pair_map[right] = left
