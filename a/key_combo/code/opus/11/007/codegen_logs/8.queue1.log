+def _ring_background(shape: tuple[int, int], marker: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    out = np.empty((h, w), dtype=int)
+    mr, mc = marker
+    for r in range(h):
+        for c in range(w):
+            out[r, c] = RED if max(abs(r - mr), abs(c - mc)) % 2 == 0 else GREY
+    return out
