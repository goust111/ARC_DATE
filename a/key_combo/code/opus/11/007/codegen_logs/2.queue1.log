+def _has_clipping(obj: dict, width: int, *, local_shear: bool) -> bool:
+    for local_row, r in enumerate(obj["rows"]):
+        c0, c1 = obj["segments"][int(r)]
+        shift = int(local_row) if local_shear else int(r)
