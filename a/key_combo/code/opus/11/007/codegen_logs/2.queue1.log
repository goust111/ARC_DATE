spec:
  task_type: symmetry/pattern (diagonal shear)
  input:
    grid: 2-10 rows (H) x 1-9 cols (W), total cells 4-36 [observed]
    pixels: all non-zero (no black); 4-5 distinct colors [observed]
    content: arbitrary non-black pixel values, no structural constraint required
  output:
    grid: H rows x (W + H - 1) cols, same height as input
    rule: |
      row r is copied unchanged to output starting at column (H-1-r).
      Cells outside the placed row are black (0).
      Effect: rows shift left by 1 each step downward, forming a
      down-left parallelogram on a black canvas.
  constraint: output width W+H-1 <= 30, so W <= 31-H

generation_strategy:
  approach: direct (transformation is simple, no inversion needed)
  steps:
    1. Pick H in [2,10] and W in [1,9] such that W+H-1 <= 30
    2. Pick 4-5 non-zero colors from palette 1-9
    3. Fill an H x W grid with those colors (no zeros); any distribution is valid
    4. Output is deterministic from solver: place row r at column offset H-1-r on black H x (W+H-1) canvas
```
