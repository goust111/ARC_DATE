+    return None
+
+
+def _candidate_third_objects(h: int, w: int, others: list[dict], area_used: set[int], color: int) -> list[dict]:
+    candidates: list[dict] = []
+    for height in range(HEIGHT_RANGE[0], HEIGHT_RANGE[1] + 1):
