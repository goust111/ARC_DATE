+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+GRID_SIDE_RANGE = (13, 18)
+INTERIOR_HEIGHT_RANGE = (7, 9)
+INTERIOR_WIDTH_RANGE = (7, 9)
+SPRITE_SIZE_RANGE = (4, 7)
