+    out[fr0 : fr1 + 1, fc1] = RED
+    out[fr0, fc0 : fc1 + 1] = RED
+    out[fr1, fc0 : fc1 + 1] = RED
+    interior = out[fr0 + 1 : fr1, fc0 + 1 : fc1]
+    interior[a_mask & ~b_mask] = BLUE
+    interior[b_mask & ~a_mask] = GREEN
+    interior[a_mask & b_mask] = YELLOW
+    return out
+
