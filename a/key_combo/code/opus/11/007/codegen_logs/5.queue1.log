+def _parse_case(grid: np.ndarray) -> tuple[int, tuple[int, int, int, int], np.ndarray, np.ndarray]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    bg = _get_bg(g)
