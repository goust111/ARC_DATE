+    shape: tuple[int, int],
+    frame_bbox: tuple[int, int, int, int],
+    a_mask: np.ndarray,
+    b_mask: np.ndarray,
+    bg: int = BLACK,
+) -> np.ndarray:
+    out = np.full(shape, bg, dtype=int)
+    fr0, fc0, fr1, fc1 = frame_bbox
