+def _fill_enclosed(stroke: np.ndarray) -> np.ndarray:
+    open_space = ~stroke
+    padded = np.pad(open_space, 1, constant_values=True)
+    seen = np.zeros_like(padded, dtype=bool)
+    q = deque()
+    ph, pw = padded.shape
+
+    for r in range(ph):
+        for c in (0, pw - 1):
+            if padded[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+    for c in range(pw):
+        for r in (0, ph - 1):
+            if padded[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                q.append((r, c))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < ph and 0 <= nc < pw and padded[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
