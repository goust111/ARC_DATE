+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+MARK = 6
+PLUS_OFFSETS = ((-1, 0), (0, -1), (0, 1), (1, 0))
+X_OFFSETS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+SHAPES = (PLUS_OFFSETS, X_OFFSETS)
+PALETTE = (1, 2, 3, 4, 5, 7, 8, 9)
+GRID_SIZES = (19, 21, 23)
+GENERATION_ATTEMPTS = 300
