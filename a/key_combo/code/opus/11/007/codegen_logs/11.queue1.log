+def _orbit_from_kind(kind: str, radius: int, n: int) -> tuple[tuple[int, int], ...]:
+    mid = n // 2
+    if kind == "diag":
+        return _d4_orbit(mid + radius, mid + radius, n)
+    if kind == "cross":
+        return _d4_orbit(mid, mid + radius, n)
