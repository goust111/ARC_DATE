+
+    for dr, dc in offsets:
+        rr, cc = r + dr, c + dc
+        assert _in_bounds(grid.shape, rr, cc), "template must fit"
+        current = int(grid[rr, cc])
+        if current in (BG, MARK):
+            grid[rr, cc] = shell_color
+            changed = True
+        else:
+            assert current == shell_color, "shell color conflict"
+    return changed
+
+
