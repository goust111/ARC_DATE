spec:
  grid: 3-6 rows x even width (2*panel_width); panel_width 5-9 [observed: all examples 4x14]
  background: BLACK
  panels:
    layout: two equal side-by-side panels (left = cols 0..mid-1, right = cols mid..width-1)
    left_color: one non-BLACK foreground color [observed: always GREEN]
    right_color: one non-BLACK foreground color, distinct from left_color [observed: always RED]
    fg_density: 35-55% of panel cells are foreground, per panel
    no_structure: foreground cells are scattered without particular shape/symmetry [observed]
  output:
    size: same height x panel_width (half input width)
    rule: cell is GREY iff both aligned panel cells are BLACK; all other cells BLACK
    grey_density: 15-40% of output cells are GREY
    constraint: grey_count = panel_cells - left_fg - right_fg + overlap (inclusion-exclusion)

generation_strategy:
