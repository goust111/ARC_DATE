+    adjacency = [set() for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if _physical_adjacency(physical_rects[i], physical_rects[j]):
+                adjacency[i].add(j)
+                adjacency[j].add(i)
