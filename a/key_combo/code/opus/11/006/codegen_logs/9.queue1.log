+
+def _analyze_routes(compressed: np.ndarray) -> List[dict]:
+    occupied = {tuple(map(int, coord)) for coord in np.argwhere(compressed != BLACK)}
+    counts = Counter(int(v) for v in compressed.flat if int(v) != BLACK)
