+def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    row_count = int(rng.integers(6, 9))
+    col_count = int(rng.integers(6, 9))
+    row_sizes = [2] * row_count
+    col_sizes = [2] * col_count
