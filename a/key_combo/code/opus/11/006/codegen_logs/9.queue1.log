+    row_starts = np.cumsum([0, *row_sizes[:-1]])
+    col_starts = np.cumsum([0, *col_sizes[:-1]])
+
+    def rec() -> bool:
+        free = np.argwhere(~used)
+        if free.size == 0:
+            return True
+        r, c = map(int, free[0])
+        candidates: List[Tuple[int, int, int, int]] = []
+        for hr in (2, 1):
+            if r + hr > rows:
+                continue
+            height = int(sum(row_sizes[r : r + hr]))
+            if not (2 <= height <= 4):
+                continue
+            for wc in (2, 1):
+                if c + wc > cols:
