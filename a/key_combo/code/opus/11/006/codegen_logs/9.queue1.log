+        color = colors[index]
+        choices = [0, 1] + list(range(3, remaining + 1))
+        rng.shuffle(choices)
+        for count in choices:
+            if count > remaining:
+                continue
+            sub = rec(index + 1, remaining - count, used + (1 if count > 0 else 0))
+            if sub is not None:
+                if count > 0:
+                    sub = dict(sub)
+                    sub[color] = count
+                return sub
+        return None
