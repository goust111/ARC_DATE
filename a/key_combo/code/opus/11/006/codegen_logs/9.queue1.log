+
+
+def _build_input_from_layout(
+    rects: Sequence[Rect],
+    colors: Sequence[int],
+    mosaic_h: int,
+    mosaic_w: int,
+    rng: np.random.Generator,
+) -> np.ndarray:
+    pad_top = int(rng.integers(1, 4))
+    pad_bottom = int(rng.integers(1, 4))
+    pad_left = int(rng.integers(1, 4))
+    pad_right = int(rng.integers(1, 4))
