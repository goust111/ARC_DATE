+def _select_pairs(positions: Sequence[Coord], rng: np.random.Generator) -> List[dict] | None:
+    candidates = _candidate_pairs(positions)
+    if not candidates:
+        return None
+    rng.shuffle(candidates)
+    occupied_positions = set(positions)
