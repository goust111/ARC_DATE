+def _band_tiling(row_sizes: Sequence[int], col_sizes: Sequence[int], rng: np.random.Generator) -> List[Tuple[Tuple[int, int, int, int], Tuple[int, int, int, int]]]:
+    rows = len(row_sizes)
+    cols = len(col_sizes)
