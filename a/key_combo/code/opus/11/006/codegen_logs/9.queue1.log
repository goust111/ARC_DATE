+            pr0 = int(row_starts[br])
+            pc0 = int(col_starts[bc])
+            pr1 = int(row_starts[br] + sum(row_sizes[br : br + hr]) - 1)
+            pc1 = int(col_starts[bc] + sum(col_sizes[bc : bc + wc]) - 1)
+            placements.append(((br, bc, hr, wc), (pr0, pc0, pr1, pc1)))
+            if rec():
+                return True
+            placements.pop()
