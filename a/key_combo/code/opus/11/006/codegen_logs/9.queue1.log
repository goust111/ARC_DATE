+    a_r0, a_c0, a_r1, a_c1 = rect_a
+    b_r0, b_c0, b_r1, b_c1 = rect_b
+    row_overlap = max(0, min(a_r1, b_r1) - max(a_r0, b_r0) + 1)
+    col_overlap = max(0, min(a_c1, b_c1) - max(a_c0, b_c0) + 1)
+    if a_r1 + 1 == b_r0 or b_r1 + 1 == a_r0:
