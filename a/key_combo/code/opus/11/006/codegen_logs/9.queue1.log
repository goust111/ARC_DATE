+from __future__ import annotations
+
+from collections import Counter
+from typing import Dict, Iterable, List, Sequence, Tuple
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+PALETTE = (BLUE, RED, GREEN, YELLOW, PINK, ORANGE, TEAL)
+MAX_ATTEMPTS = 600
+
+Coord = Tuple[int, int]
+Rect = Tuple[int, int, int, int]
+
+
+def _neighbors4(r: int, c: int) -> Iterable[Coord]:
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> List[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: List[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: List[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> Rect:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _extract_partitions(grid: np.ndarray) -> List[Tuple[Rect, int]]:
+    g = np.asarray(grid, dtype=int)
+    comps = _components(g != BLACK)
+    parts: List[Tuple[Rect, int]] = []
+    for coords in comps:
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        color = int(g[r0, c0])
+        block = g[r0 : r1 + 1, c0 : c1 + 1]
+        if np.any(block != color):
+            raise ValueError("non-rectangular or non-monochromatic partition")
+        parts.append(((r0, c0, r1, c1), color))
