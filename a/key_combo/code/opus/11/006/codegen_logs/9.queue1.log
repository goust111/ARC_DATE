+            return None
+
+        result = dfs(0, [])
+        if result is None:
+            continue
+        endpoints = {pair["start"] for pair in result} | {pair["end"] for pair in result}
+        for pair in result:
+            blockers = set(pair["blocked"])
+            if blockers - (occupied_positions - endpoints):
+                break
+        else:
+            return result
+    return None
+
