+    if count_plan is None:
+        return None
+    remaining_counts = dict(count_plan)
+
+    unassigned = [idx for idx in range(n) if assigned[idx] == -1]
+    unassigned.sort(key=lambda idx: len(adjacency[idx]), reverse=True)
