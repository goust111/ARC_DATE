+    for color in sorted(c for c, n in counts.items() if n == 2):
+        pts = [tuple(map(int, coord)) for coord in np.argwhere(out == color)]
+        pts.sort()
+        start, end = pts
+        for r, c in _route_cells(start, end)[:-1]:
