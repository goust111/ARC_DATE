+        return None
+    rng.shuffle(candidates)
+    occupied_positions = set(positions)
+
+    def compatible(candidate: dict, chosen: Sequence[dict]) -> bool:
+        candidate_route = set(candidate["route"])
+        candidate_endpoints = {candidate["start"], candidate["end"]}
