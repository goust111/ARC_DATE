+    def rec(index: int, remaining: int, used: int) -> Dict[int, int] | None:
+        if remaining == 0:
+            return {} if used >= 2 else None
+        if index == len(colors):
+            return None
+        color = colors[index]
+        choices = [0, 1] + list(range(3, remaining + 1))
+        rng.shuffle(choices)
+        for count in choices:
+            if count > remaining:
