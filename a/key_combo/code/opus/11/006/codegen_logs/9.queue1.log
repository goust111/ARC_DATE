+        visible = [cell for cell in intermediates if cell not in occupied]
+        infos.append(
+            {
+                "color": color,
+                "start": start,
+                "end": end,
+                "intermediates": tuple(intermediates),
+                "blocked": tuple(blocked),
+                "visible": tuple(visible),
