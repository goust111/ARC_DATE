+    has_vertical_merge = any(band_rect[2] > 1 for band_rect, _phys in tiled)
+    has_horizontal_merge = any(band_rect[3] > 1 for band_rect, _phys in tiled)
+    if not (has_vertical_merge and has_horizontal_merge):
+        return None
