+def _candidate_pairs(positions: Sequence[Coord]) -> List[dict]:
+    occupied = set(positions)
+    out: List[dict] = []
+    for i in range(len(positions)):
+        for j in range(i + 1, len(positions)):
+            a = positions[i]
+            b = positions[j]
+            if a[0] == b[0] or a[1] == b[1]:
