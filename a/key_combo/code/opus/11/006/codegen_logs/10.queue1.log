+        areas = other_areas + [target_area]
+        target_rank = len(areas) - 1
+    else:
+        all_areas = sorted(rng.sample(list(range(4, 11)), region_count))
+        target_rank = 1
+        target_area = all_areas[target_rank]
+        areas = all_areas
