+    if quality["growth_cells"] < 5:
+        return False
+    if quality["barrier_hits"] < 1:
+        return False
+    if quality["filled_only_diff"] < 5:
+        return False
+    if len(quality["colors_after_growth"]) < 2:
+        return False
+    if len(seeds) == 2 and quality["contested"] < 1:
+        return False
+    return True
