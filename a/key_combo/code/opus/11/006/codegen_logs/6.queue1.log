+
+
+def _analyze_growth(
+    shape: tuple[int, int], rectangles: list[tuple[int, Rect]], seeds: list[Coord]
+) -> dict:
+    barrier = _barrier_mask(shape, rectangles)
+    seed_set = set(seeds)
+    sorted_seeds = _sorted_seeds(seeds)
+    priority = {seed: idx for idx, seed in enumerate(sorted_seeds)}
