# Grid size and filled-coverage bounds.
GRID_H_RANGE, GRID_W_RANGE = (6, 10), (8, 11)
COVERAGE_FRAC_RANGE = (0.25, 0.36)

# Rectangle count and inclusive side-length bounds.
N_RECTS_RANGE, RECT_SIDE_RANGE = (1, 2), (2, 7)

