+            key=lambda item: (
+                item[1]["ties"],
+                item[1]["contested"],
+                item[1]["growth_cells"],
+                item[1]["filled_only_diff"],
+            ),
+            reverse=True,
+        )
+    else:
+        pairs.sort(
+            key=lambda item: (
+                item[1]["contested"],
+                item[1]["growth_cells"],
+                item[1]["filled_only_diff"],
+            ),
