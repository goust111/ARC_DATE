+        ok = True
+        for color in colors:
+            placed = False
+            for _ in range(200):
+                rh = int(rng.integers(2, min(7, h - 2) + 1))
+                rw = int(rng.integers(2, min(7, w - 2) + 1))
+                r0 = int(rng.integers(1, h - rh))
