+    return {
+        "analysis": analysis,
+        "output": output,
+        "growth_cells": len(analysis["chosen"]),
+        "contested": len(analysis["contested_cells"]),
+        "ties": len(analysis["tie_cells"]),
+        "barrier_hits": barrier_hits,
