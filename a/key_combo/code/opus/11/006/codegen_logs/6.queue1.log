+
+
+def _all_input_points(rectangles: list[tuple[int, Rect]], seeds: list[Coord]) -> list[Coord]:
+    pts: list[Coord] = []
+    for _color, (r0, c0, r1, c1) in rectangles:
+        pts.extend([(r0, c0), (r1, c1)])
