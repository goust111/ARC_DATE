+
+
+def _pick_single_seed(
+    shape: tuple[int, int], rectangles: list[tuple[int, Rect]], candidates: list[dict]
+) -> list[Coord] | None:
+    good = [
+        cand
+        for cand in candidates
+        if cand["rect_stops"] >= 1
+        and cand["edge_stops"] >= 1
+        and cand["max_length"] >= 3
+        and cand["total_length"] >= 8
