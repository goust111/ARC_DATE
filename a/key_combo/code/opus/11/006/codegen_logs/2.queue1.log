+
+def _build_frame(h: int, w: int) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    grid[0, 1 : w - 1] = RED
+    grid[h - 1, 1 : w - 1] = BLUE
+    grid[1 : h - 1, 0] = GREEN
+    grid[1 : h - 1, w - 1] = YELLOW
+    return grid
+
+
+def _parse_input(grid: np.ndarray) -> tuple[tuple[tuple[int, int], ...], tuple[int, int], str]:
