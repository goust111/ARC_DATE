+        cells.add((nr, nc))
+    return _normalize(cells)
+
+
+def _shape_is_good(shape: tuple[tuple[int, int], ...], side: str) -> bool:
+    r0, c0, r1, c1 = _bbox(shape)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h > 4 or w > 4:
