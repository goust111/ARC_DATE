+    for _ in range(80):
+        area = random.randint(AREA_MIN, AREA_MAX)
+        shape = _random_polyomino(area)
+        if not _shape_is_good(shape, side):
+            continue
+
+        _, _, r1, c1 = _bbox(shape)
+        shape_h = r1 + 1
+        shape_w = c1 + 1
+        max_r = h - 2 - shape_h
+        max_c = w - 2 - shape_w
+        if max_r < 2 or max_c < 2:
