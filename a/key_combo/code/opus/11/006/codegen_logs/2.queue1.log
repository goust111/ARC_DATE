+            dirs = set()
+            if (nr + 1, nc) in shape_set:
+                dirs.add("top")
+            if (nr - 1, nc) in shape_set:
+                dirs.add("bottom")
+            if (nr, nc + 1) in shape_set:
+                dirs.add("left")
+            if (nr, nc - 1) in shape_set:
+                dirs.add("right")
+            if len(dirs) == 1:
+                out.append((nr, nc, next(iter(dirs))))
