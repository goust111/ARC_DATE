+    for r, c, side in out:
+        unique[(r, c)] = side
+    return [(r, c, side) for (r, c), side in unique.items()]
+
+
+def _semantic_checks(inp: np.ndarray, out: np.ndarray) -> bool:
+    try:
+        shape, marker, side = _parse_input(inp)
