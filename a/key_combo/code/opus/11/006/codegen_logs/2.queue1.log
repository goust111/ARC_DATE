+    assert g.ndim == 2
+    h, w = g.shape
+    assert 5 <= h <= 30 and 5 <= w <= 30
+    assert g[0, 0] == g[0, w - 1] == g[h - 1, 0] == g[h - 1, w - 1] == BG
+    assert np.all(g[0, 1 : w - 1] == RED)
+    assert np.all(g[h - 1, 1 : w - 1] == BLUE)
+    assert np.all(g[1 : h - 1, 0] == GREEN)
+    assert np.all(g[1 : h - 1, w - 1] == YELLOW)
