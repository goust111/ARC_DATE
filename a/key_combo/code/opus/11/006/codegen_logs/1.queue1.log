spec:
  grid: 10x10, background color 8
  path:
    structure: single 4-connected non-branching one-pixel-wide path with exactly 2 endpoints
    length: 8-28 cells
    turns: 2-8 direction changes
    straight_segments: each 2-8 cells long
    margin: path does not touch grid border; >=1 cell margin on all sides [observed]
    colors: 6-7 distinct non-background colors; colors may repeat along the path
    no_palindrome: color sequence along the path must not be a palindrome (otherwise output == input)
  transform:
    walk path endpoint-to-endpoint; reverse the color sequence onto the same cells
    path geometry unchanged; only colors are permuted

generation_strategy:
  approach: direct construction (path-first)
