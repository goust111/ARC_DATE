+        side_w = random.choice([2, 2, 3])
+        target_r = ac_r + random.choice([-2, -1, 1, 2])
+        target_c = ac_c + random.choice([-2, -1, 1, 2])
+        r0 = max(0, min(h - side_h, target_r))
+        c0 = max(0, min(w - side_w, target_c))
