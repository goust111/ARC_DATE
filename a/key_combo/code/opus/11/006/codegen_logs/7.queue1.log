+
+    inp = _build_input(shape, mask_color, mask, rects)
+    if not _semantic_checks(inp, mode):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
