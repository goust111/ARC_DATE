spec:
  grid: 7 rows (fixed) x 5-17 cols
  background: BLACK
  blocks:
    color: RED (input), alternating RED/TEAL (output)
    shape: 2x2 squares, all identical
    count: 2-9
    placement: distinct left-columns; no two blocks overlap or touch (4-connectivity)
    col_gaps: 1-3 between consecutive left-columns (sorted)
    top_rows: 0-5 (block fits within 7 rows)
    grid_width: rightmost block right edge == grid width [observed]
    leftmost_col: 0 in 5/6 examples, 1 in 1/6 [observed]
  transform:
    sort blocks right-to-left by left-column
    recolor even-ranked blocks (0, 2, 4, ...) to TEAL; odd-ranked stay RED

generation_strategy:
  approach: direct construction (simple placement task)
  steps:
    1. Pick n_blocks in 2-9.
    2. Generate n_blocks distinct left-columns with consecutive gaps uniformly in {1,2,3}. Start leftmost at 0 (or rarely 1). Grid width = max(left_col) + 2.
    3. For each block, pick a top_row in 0-5. If col_gap==1 with a neighbor, ensure their row ranges (top_row..top_row+1) do not overlap (differ by >=2) to maintain 4-connectivity separation.
    4. Fill each 2x2 block with RED on a 7 x width BLACK grid.
    5. Output = copy input, then recolor every even-ranked block (right-to-left order) to TEAL.
```
