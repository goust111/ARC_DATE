    left_cols = []
    for block in blocks:
        assert block["area"] == 4
        assert bbox_h(block["bbox"]) == 2
        assert bbox_w(block["bbox"]) == 2
        left_cols.append(block["bbox"][1])
    assert len(set(left_cols)) == len(left_cols)

    out = g.copy()
    for rank, block in enumerate(sorted(blocks, key=lambda b: b["bbox"][1], reverse=True)):
