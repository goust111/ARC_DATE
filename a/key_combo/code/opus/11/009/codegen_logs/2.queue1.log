    for_horizontal: motif_h rows x bar_len cols, immediately below bar (all BLACK in input)
    must fit within grid bounds
  separation: when 2 bars exist, their fill regions do not overlap
  transform: tile the motif to fill the entire fill_region (repeating along the bar axis)

generation_strategy:
  approach: output-first
  steps:
