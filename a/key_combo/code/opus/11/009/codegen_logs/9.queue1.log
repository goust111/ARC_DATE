+
+def _detect_centers(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    centers = []
+    for r in range(3, h - 3):
+        for c in range(3, w - 3):
+            if _is_hidden_center(grid, r, c):
+                centers.append((int(r), int(c)))
