+) -> tuple[dict[tuple[int, int], int], dict[tuple[int, int], tuple[str, ...]]]:
+    center_set = set(centers)
+    counts: dict[tuple[int, int], int] = {}
+    extras: dict[tuple[int, int], tuple[str, ...]] = {}
