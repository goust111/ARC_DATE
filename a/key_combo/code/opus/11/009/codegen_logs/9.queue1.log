+
+def _bar_orientation(cells: list[tuple[int, int]]) -> str | None:
+    (r0, c0), (r1, c1) = cells
+    if r0 == r1 and abs(c0 - c1) == 1:
+        return "h"
+    if c0 == c1 and abs(r0 - r1) == 1:
+        return "v"
+    return None
