+from arc_utils import Color, find_components
+
+
+BG = int(Color.BLACK)
+BAR = int(Color.BLUE)
+CENTER = int(Color.YELLOW)
+BRIDGE = int(Color.RED)
+
+CARDINAL_GAPS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MANDATORY_BARS = {
+    "up": ((-3, 0), (-2, 0)),
+    "down": ((2, 0), (3, 0)),
+    "left": ((0, -3), (0, -2)),
+    "right": ((0, 2), (0, 3)),
