+        _draw_bridge(out, a, b, min(counts[a], counts[b]) - 3)
+    return out
+
+
+def _validate_generated_instance(
+    grid: np.ndarray,
+    centers: list[tuple[int, int]],
+    counts: dict[tuple[int, int], int],
+    extras: dict[tuple[int, int], tuple[str, ...]],
