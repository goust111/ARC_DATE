+    "down": {"gap": (4, 0), "cells": ((5, 0), (6, 0))},
+    "left": {"gap": (0, -4), "cells": ((0, -6), (0, -5))},
+    "right": {"gap": (0, 4), "cells": ((0, 5), (0, 6))},
+}
+
