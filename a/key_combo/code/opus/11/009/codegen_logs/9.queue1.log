+def _aligned_pairs(centers: list[tuple[int, int]]) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    ordered = sorted((int(r), int(c)) for r, c in centers)
+    pairs = []
+    for i, a in enumerate(ordered):
