+    centers: list[tuple[int, int]],
+    counts: dict[tuple[int, int], int],
+) -> bool:
+    pairs = _aligned_pairs(centers)
+    rng.shuffle(pairs)
+    for a, b in pairs:
+        (r0, c0), (r1, c1) = a, b
+        if r0 == r1:
