+            _paint_bar(grid, cells)
+            return True
+    return False
+
+
+def _place_random_distractors(
+    grid: np.ndarray,
+    rng: random.Random,
+    target_count: int,
+) -> int:
+    placed = 0
+    h, w = grid.shape
