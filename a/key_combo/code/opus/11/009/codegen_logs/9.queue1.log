+        return False
+
+    blocker_hits = sum(
+        any((int(r), int(c)) in bridge_band for r, c in comp["coords"])
+        for comp in comps
+    )
+    if blocker_hits > distractor_count:
+        return False
+    return True
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    planned = _plan_layout(rng)
+    if planned is None:
