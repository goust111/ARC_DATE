+def _plan_layout(
+    rng: random.Random,
+) -> tuple[np.ndarray, list[tuple[int, int]], dict[tuple[int, int], int], dict[tuple[int, int], tuple[str, ...]]] | None:
+    template = _choose_template(rng)
