+    for a, b in _aligned_pairs(centers):
+        width = min(counts[a], counts[b]) - 3
+        (r0, c0), (r1, c1) = a, b
+        if r0 == r1:
+            left, right = sorted((c0, c1))
+            for c in range(left + 1, right):
