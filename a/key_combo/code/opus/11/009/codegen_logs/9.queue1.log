+
+
+def _sample_axis_positions(rng: random.Random, size: int, count: int) -> list[int] | None:
+    lo = 6
+    hi = int(size - 7)
+    if hi < lo:
+        return None
+    candidates = list(range(lo, hi + 1))
+    for _ in range(200):
