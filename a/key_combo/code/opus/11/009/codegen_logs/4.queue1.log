+def _make_positions(rng: random.Random) -> list[tuple[int, int]]:
+    row_margin = rng.randint(1, 2)
+    col_margin = rng.randint(1, 2)
+    row_steps = [rng.randint(4, 5), rng.randint(4, 5)]
+    col_steps = [rng.randint(5, 6), rng.randint(5, 6)]
