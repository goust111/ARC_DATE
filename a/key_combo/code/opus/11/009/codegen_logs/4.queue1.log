+                and np.all(block[2, :] == FRAME)
+                and np.all(block[:, 0] == FRAME)
+                and np.all(block[:, 2] == FRAME)
+            )
+            if not border_ok:
+                continue
+            if bool(used[r0 : r0 + 3, c0 : c0 + 3].any()):
+                continue
+            used[r0 : r0 + 3, c0 : c0 + 3] = True
+            frames.append(
+                {
+                    "top_left": (r0, c0),
+                    "bbox": (r0, c0, r0 + 2, c0 + 2),
+                    "center": (r0 + 1, c0 + 1),
