+def _find_frames(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    used = np.zeros((h, w), dtype=bool)
+    frames: list[dict] = []
+    for r0 in range(h - 2):
+        for c0 in range(w - 2):
+            block = grid[r0 : r0 + 3, c0 : c0 + 3]
+            if int(block[1, 1]) in (BG, FRAME):
+                continue
