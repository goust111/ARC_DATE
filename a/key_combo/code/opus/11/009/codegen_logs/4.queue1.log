+
+    left_hidden = False
+    total_hidden = 0
+    w = inp.shape[1]
+    for c in range(w // 2):
+        mc = w - 1 - c
+        if int(completed[c]) == BG:
+            continue
+        if int(inp[ctrl_r, c]) == BG:
+            left_hidden = True
+            total_hidden += 1
+        if int(inp[ctrl_r, mc]) == BG:
+            total_hidden += 1
+    return left_hidden and total_hidden >= 2
+
+
