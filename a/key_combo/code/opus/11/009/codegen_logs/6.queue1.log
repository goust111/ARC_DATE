+from __future__ import annotations
+
+import itertools
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+_RNG = np.random.default_rng()
+
+_DIM_CHOICES = (12, 14, 16, 18, 20, 22, 24, 26)
+_MAX_GENERATION_ATTEMPTS = 500
+_DIRECTIONS = ("up", "down", "left", "right")
