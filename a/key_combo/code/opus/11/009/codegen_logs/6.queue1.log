# Canvas/object sampling bounds.
GRID_SIZE_RANGE = (7, 19)
RECT_WIDTH_RANGE = (3, 17)
RECT_HEIGHT_RANGE = (4, 9)
RECT_AREA_RESERVED_CELLS = 3
RECT_AREA_DIVISOR = 2

