+BLACK = 0
+RED = 2
+ORANGE = 7
+
+NW_SE = "nw_se"
+NE_SW = "ne_sw"
+ORIENTATIONS = (NW_SE, NE_SW)
+
+GEN_ATTEMPTS = 600
+GRID_SIDE_RANGE = (14, 18)
