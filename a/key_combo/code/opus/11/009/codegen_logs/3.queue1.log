+    if len(set(r + c for r, c in pts)) == 1:
+        assert rows == list(range(rows[0], rows[0] + len(pts)))
+        assert cols == list(range(cols[0], cols[0] - len(pts), -1))
+        return NE_SW
+    raise AssertionError("orange component is not a straight diagonal segment")
