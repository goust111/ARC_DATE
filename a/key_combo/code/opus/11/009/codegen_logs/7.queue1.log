+    if total < parts or total > parts * max_part:
+        return None
+    for _ in range(200):
+        cuts = sorted(random.sample(range(1, total), parts - 1))
+        values = [cuts[0], *[b - a for a, b in zip(cuts, cuts[1:])], total - cuts[-1]]
