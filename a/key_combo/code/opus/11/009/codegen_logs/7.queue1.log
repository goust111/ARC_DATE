    for c in range(width - 1, 0, -1):
        _gen_append_segment(path, bottom[c], c, bottom[c], c - 1)
        _gen_append_segment(path, bottom[c], c - 1, bottom[c - 1], c - 1)
    _gen_append_segment(path, bottom[0], 0, top[0], 0)
    if path and path[-1] == path[0]:
