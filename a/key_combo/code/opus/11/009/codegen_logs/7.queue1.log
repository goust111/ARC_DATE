    blocked = set(blocked)
    return sorted(
        {
            nb
            for cell in skeleton
            for nb in neighbors8(*cell)
            if nb not in skeleton and nb not in blocked
        }
    )


def _gen_choose_anchor(skeleton):
    candidates = _gen_adjacent_open_cells(skeleton)
    random.shuffle(candidates)
