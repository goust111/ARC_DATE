+            c0, c1 = col_spans[cell_c]
+            grid[r0 : r1 + 1, c0 : c1 + 1] = minority
+
+        try:
+            _validate_generated_input(grid)
+        except AssertionError:
+            continue
+        return grid
+    raise RuntimeError("failed to generate a valid input")

