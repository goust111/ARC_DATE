+    col_counts = np.count_nonzero(g == PINK, axis=0)
+    sep_rows = [int(r) for r, count in enumerate(row_counts) if count > g.shape[1] // 2]
+    sep_cols = [int(c) for c, count in enumerate(col_counts) if count > g.shape[0] // 2]
