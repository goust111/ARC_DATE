+    cc0 = max(0, c0) if clip else c0
+    rr1 = min(dst.shape[0], r0 + h) if clip else r0 + h
+    cc1 = min(dst.shape[1], c0 + w) if clip else c0 + w
+    if rr0 >= rr1 or cc0 >= cc1:
