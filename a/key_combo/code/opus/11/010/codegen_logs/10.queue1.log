+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+
+SPRITE_COLORS = (BLUE, RED, GREEN, ORANGE, CYAN)
