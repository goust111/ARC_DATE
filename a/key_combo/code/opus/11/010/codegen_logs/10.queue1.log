+        r0, c0, r1, c1 = sprite["bbox"]
+        assert r1 < g.shape[0] // 2 + 1, "sprites must live in the upper half region"
+        assert r1 < canvas_r0 or c1 < canvas_c0 or c0 > canvas_c0 + 8, "sprites must stay outside the canvas"
