+def bbox_ring_positions(box: tuple[int, int, int, int], shape: tuple[int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    out: list[tuple[int, int]] = []
+    for r in range(max(0, r0 - 2), min(shape[0], r1 + 3)):
