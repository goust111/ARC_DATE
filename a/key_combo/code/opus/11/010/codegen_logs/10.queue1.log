+    r0, c0, r1, c1 = bbox_coords(coords)
+    assert (r1 - r0 + 1, c1 - c0 + 1) == (9, 9), "canvas must be 9x9"
+    assert np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == GRAY), "canvas must be filled"
