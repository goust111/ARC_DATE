+    out = np.full((9, 9), BLACK, dtype=int)
+    for sprite in ordered:
+        sr, sc = slot_top_left(sprite["direction"])
+        paste(out, sprite["patch"], sr, sc, transparent=BLACK, clip=False)
+    return out
