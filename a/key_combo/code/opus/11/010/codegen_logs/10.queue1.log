+
+
+def choose_mask(area: int, direction: tuple[int, int]) -> np.ndarray | None:
+    options = [mask for mask in SHAPE_LIBRARY[area] if fits_canvas_slot(direction, mask)]
+    if not options:
+        return None
+    return randomize_mask(random.choice(options))
