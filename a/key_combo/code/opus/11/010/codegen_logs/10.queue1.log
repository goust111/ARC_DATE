+    if any(not options for options in candidates.values()):
+        return None
+
+    order = sorted(candidates, key=lambda idx: len(candidates[idx]))
+    occupied: set[tuple[int, int]] = set()
+    placed: list[dict | None] = [None] * len(specs)
