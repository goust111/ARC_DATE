+    dc = -1 if pc < cc else (1 if pc > cc else 0)
+    return int(dr), int(dc)
+
+
+def slot_top_left(direction: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = direction
+    return 3 * (int(dr) + 1), 3 * (int(dc) + 1)
