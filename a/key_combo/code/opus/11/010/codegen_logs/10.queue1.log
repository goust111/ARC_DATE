    ep2 = _choose_endpoint_room(r2, c2, exit_room2, "top")
    rooms = _room_interiors(r1, c1, s1, r_1, c_1) + _room_interiors(r2, c2, s2, r_2, c_2)
    _paint_endpoint(grid, r_1, c_1, ep1, s1, paint)
    _paint_endpoint(grid, r_2, c_2, ep2, s2, paint)
