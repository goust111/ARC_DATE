+def adjacent_directions(direction: tuple[int, int]) -> list[tuple[int, int]]:
+    dr0, dc0 = direction
+    out = []
+    for dr, dc in ALL_DIRECTIONS:
+        if (dr, dc) == direction:
+            continue
+        if abs(dr - dr0) <= 1 and abs(dc - dc0) <= 1:
+            out.append((dr, dc))
+    return out
