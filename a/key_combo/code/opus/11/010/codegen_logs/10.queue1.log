+def point_bbox_manhattan(box: tuple[int, int, int, int], point: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = map(int, box)
+    pr, pc = map(int, point)
+    dr = 0 if r0 <= pr <= r1 else min(abs(pr - r0), abs(pr - r1))
+    dc = 0 if c0 <= pc <= c1 else min(abs(pc - c0), abs(pc - c1))
+    return int(dr + dc)
