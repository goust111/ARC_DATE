+def group_cells_for_candidate(
+    patch: np.ndarray,
+    top: int,
+    left: int,
+    control: tuple[int, int],
+) -> set[tuple[int, int]]:
+    cells = {(top + r, left + c) for r, c in np.argwhere(patch != BLACK)}
+    cells.add((int(control[0]), int(control[1])))
+    return cells
