+            r0, c0, r1, c1 = bbox_coords(arr)
+            patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+            patch[arr[:, 0] - r0, arr[:, 1] - c0] = color
+            components.append(
+                {
+                    "color": color,
+                    "coords": arr,
+                    "bbox": (r0, c0, r1, c1),
+                    "patch": patch,
+                    "area": int(arr.shape[0]),
+                    "bbox_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
+                }
+            )
+    return components
