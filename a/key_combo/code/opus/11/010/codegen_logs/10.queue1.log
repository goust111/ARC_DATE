+BLUE = 1
+RED = 2
+GREEN = 3
+GRAY = 5
+MAGENTA = 6
+ORANGE = 7
+CYAN = 8
+
+SPRITE_COLORS = (BLUE, RED, GREEN, ORANGE, CYAN)
+DIRECTION_VALUES = (-1, 0, 1)
+ALL_DIRECTIONS = [(dr, dc) for dr in DIRECTION_VALUES for dc in DIRECTION_VALUES]
+CORE_DIRECTIONS = [(-1, -1), (-1, 0), (0, -1), (0, 0)]
