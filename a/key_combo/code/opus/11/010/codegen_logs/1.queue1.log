+BG = 0
+STRIPE = 5
+MARKER = 6
+PALETTE = (1, 2, 3, 4, 7, 8)
+MIN_SEGMENTS = 4
+MAX_SEGMENTS = 6
+MIN_LENGTH = 2
+MAX_LENGTH = 10
+MAX_GENERATION_ATTEMPTS = 400
