+    stacked = np.full((height, width), BG, dtype=int)
+    stacked[stripe_row, :] = STRIPE
+    for stack_index, (length, color) in enumerate(sorted_pairs):
+        r = stripe_row - n_segments + stack_index
+        stacked[r, width - length : width] = int(color)
