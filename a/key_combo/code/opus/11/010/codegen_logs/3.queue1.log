+    return False
+
+
+def _sample_sequence(counts: dict[int, int]) -> list[int]:
+    sequence = [bend for bend, count in counts.items() for _ in range(count)]
+    for _ in range(300):
+        random.shuffle(sequence)
+        if _is_interleaved(sequence):
