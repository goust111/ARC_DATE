        mask[0, :] = True
        return mask
    if w == 1:
        mask[:, 0] = True
        return mask
    steps = max(h, w)
    for i in range(steps):
        r = int(round(i * (h - 1) / (steps - 1)))
        c = int(round(i * (w - 1) / (steps - 1)))
        mask[r, c] = True
