+    diag_noise, special_diag = _add_diag_noise(inp, h_gaps, v_gaps, periodic_rows, periodic_cols, rng)
+    if len(diag_noise) < 3:
+        return None
+    if not any(r in periodic_rows or c in periodic_cols for r, c in diag_noise):
+        return None
