+def _valid_diag_chain(base_mask: np.ndarray, cells: list[tuple[int, int]]) -> bool:
+    test = base_mask.copy()
+    for r, c in cells:
+        if test[r, c]:
+            return False
+        test[r, c] = True
+    for r, c in cells:
