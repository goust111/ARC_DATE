   548	    inp = pristine.copy()
   549	    periodic_rows = set(rows)
   550	    periodic_cols = set(cols)
   551	
   552	    untouched_rows = set(rng.sample(rows, 2))
   553	    untouched_cols = set(rng.sample(cols, 2))
   554	    damaged_rows = [r for r in rows if r not in untouched_rows]
