+                best_key = key
+                best = (period, residue)
+    assert best is not None, "failed to infer a periodic residue class"
+    return best
+
+
+def _infer_periodic_lines(grid: np.ndarray) -> tuple[list[int], list[int], np.ndarray]:
+    mask = grid == FG
+    diag = _diag_only_mask(mask)
