+            if b - a + 1 < gap_len:
+                continue
+            for start in range(a, b - gap_len + 2):
+                if start == 0 or start + gap_len - 1 == grid.shape[1] - 1:
+                    continue
+                candidates.append((start, start + gap_len - 1))
+    rng.shuffle(candidates)
