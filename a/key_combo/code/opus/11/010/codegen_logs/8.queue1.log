+                    cells = [(row + i * dr, start + i * dc) for i in range(length)]
+                    if any(
+                        rr < 0
+                        or rr >= grid.shape[0]
+                        or cc < 0
+                        or cc >= grid.shape[1]
+                        or cc in periodic_cols
