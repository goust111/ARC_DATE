+
+    special_candidates: list[list[tuple[int, int]]] = []
+    for gap in h_gaps:
+        if gap[2] - gap[1] + 1 >= 2:
+            chain = _find_chain_in_horizontal_gap(grid, gap, periodic_cols, rng)
+            if chain is not None:
+                special_candidates.append(chain)
+    for gap in v_gaps:
+        if gap[2] - gap[1] + 1 >= 2:
