+def _carve_horizontal_gaps(
+    grid: np.ndarray,
+    row: int,
+    periodic_cols: set[int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    intervals = _nonperiod_intervals(grid.shape[1], periodic_cols)
+    candidates: list[tuple[int, int]] = []
+    for a, b in intervals:
