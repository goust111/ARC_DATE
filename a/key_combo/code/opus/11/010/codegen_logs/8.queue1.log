+    if not candidates:
+        return None
+    return rng.choice(candidates)
+
+
+def _find_chain_in_vertical_gap(
+    grid: np.ndarray,
+    gap: tuple[int, int, int],
+    periodic_rows: set[int],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    col, r0, r1 = gap
+    base = grid == FG
