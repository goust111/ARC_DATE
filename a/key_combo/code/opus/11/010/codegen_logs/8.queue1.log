+                    continue
+                candidates.append((start, start + gap_len - 1))
+    rng.shuffle(candidates)
+    target = rng.randint(1, min(3, len(candidates)))
+    picked: list[tuple[int, int]] = []
+    occupied: set[int] = set()
+    for r0, r1 in candidates:
