+def _diag_only_mask(mask: np.ndarray) -> np.ndarray:
+    out = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if _orth_count(mask, rr, cc) == 0 and _has_diag_neighbor(mask, rr, cc):
+            out[rr, cc] = True
