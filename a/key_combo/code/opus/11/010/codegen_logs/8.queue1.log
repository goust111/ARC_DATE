+
+def _find_chain_in_horizontal_gap(
+    grid: np.ndarray,
+    gap: tuple[int, int, int],
+    periodic_cols: set[int],
+    rng: random.Random,
+) -> list[tuple[int, int]] | None:
+    row, c0, c1 = gap
+    base = grid == FG
+    candidates: list[list[tuple[int, int]]] = []
+    for start in range(c0, c1 + 1):
