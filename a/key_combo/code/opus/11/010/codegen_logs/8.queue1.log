   556	    if not damaged_rows or not damaged_cols:
   557	        return None
   558	
   559	    h_gaps: list[tuple[int, int, int]] = []
   560	    for row in damaged_rows:
   561	        for c0, c1 in _carve_horizontal_gaps(inp, row, periodic_cols, rng):
   562	            h_gaps.append((row, c0, c1))
   563	    v_gaps: list[tuple[int, int, int]] = []
   564	    for col in damaged_cols:
   565	        for r0, r1 in _carve_vertical_gaps(inp, col, periodic_rows, rng):
   566	            v_gaps.append((col, r0, r1))
   567	
   568	    diag_noise = _add_diag_noise(inp, h_gaps, v_gaps, periodic_rows, periodic_cols, rng)
   569	    if len(diag_noise) < 3:
   570	        return None
   571	    if not any(r in periodic_rows or c in periodic_cols for r, c in diag_noise):
   572	        return None
   573	
   574	    distractors = _add_offperiod_distractors(inp, periodic_rows, periodic_cols, rng)
   575	    if not (2 <= len(distractors) <= 4):
   576	        return None
   577	
   578	    if not _semantic_checks(inp, pristine, rows, cols, diag_noise, distractors):
   579	        return None
   580	
   581	    if row_period == col_period and rows[0] % row_period == cols[0] % col_period and np.array_equal(inp, pristine):
   582	        return None
   583	
   584	    return inp
   585	
   586	
   587	def generate_input() -> np.ndarray:
