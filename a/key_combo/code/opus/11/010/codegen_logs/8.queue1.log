+    for r in periodic_rows:
+        c = 0
+        while c < w:
+            if mask[r, c]:
+                c += 1
+                continue
+            c0 = c
+            while c < w and not mask[r, c]:
+                c += 1
+            c1 = c - 1
+            if c0 > 0 and c < w and c1 - c0 + 1 <= 3 and mask[r, c0 - 1] and mask[r, c]:
