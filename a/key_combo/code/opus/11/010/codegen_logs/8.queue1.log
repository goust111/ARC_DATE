+def _semantic_checks(
+    inp: np.ndarray,
+    expected: np.ndarray,
+    periodic_rows: list[int],
+    periodic_cols: list[int],
+    diag_noise: list[tuple[int, int]],
+    distractors: list[tuple[int, int]],
+    special_diag: list[tuple[int, int]],
+) -> bool:
+    if not np.array_equal(main(inp), expected):
