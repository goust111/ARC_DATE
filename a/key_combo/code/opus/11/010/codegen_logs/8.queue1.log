+def _carve_vertical_gaps(
+    grid: np.ndarray,
+    col: int,
+    periodic_rows: set[int],
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    intervals = _nonperiod_intervals(grid.shape[0], periodic_rows)
+    candidates: list[tuple[int, int]] = []
+    for a, b in intervals:
