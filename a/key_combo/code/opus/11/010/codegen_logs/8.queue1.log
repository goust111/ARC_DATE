+def _line_run_indices(mask: np.ndarray, axis: int) -> list[int]:
+    h, w = mask.shape
+    indices: list[int] = []
+    if axis == 0:
+        for r in range(h):
+            run = 0
+            for c in range(w):
+                if mask[r, c]:
+                    run += 1
+                    if run >= 3:
+                        indices.append(r)
+                        break
+                else:
+                    run = 0
+    else:
+        for c in range(w):
+            run = 0
+            for r in range(h):
