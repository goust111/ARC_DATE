+            for dr in (-1, 1):
+                for dc in (-1, 1):
+                    for length in (3, 2, 1):
+                        cells = [(r + i * dr, c + i * dc) for i in range(length)]
+                        if any(rr < 0 or rr >= h or cc < 0 or cc >= w for rr, cc in cells):
