+def _neighbors4(shape: tuple[int, int], r: int, c: int) -> Iterable[tuple[int, int]]:
+    h, w = shape
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr, cc = r + dr, c + dc
+        if 0 <= rr < h and 0 <= cc < w:
+            yield rr, cc
+
+
+def _neighbors8(shape: tuple[int, int], r: int, c: int) -> Iterable[tuple[int, int]]:
+    h, w = shape
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                yield rr, cc
+
