+    untouched_cols = set(rng.sample(cols, 2))
+    damaged_rows = [r for r in rows if r not in untouched_rows]
+    damaged_cols = [c for c in cols if c not in untouched_cols]
+    if not damaged_rows or not damaged_cols:
