+            h_gaps.append((row, c0, c1))
+    v_gaps: list[tuple[int, int, int]] = []
+    for col in damaged_cols:
+        for r0, r1 in _carve_vertical_gaps(inp, col, periodic_rows, rng):
+            v_gaps.append((col, r0, r1))
