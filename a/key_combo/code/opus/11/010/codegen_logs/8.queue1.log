+
+def _generic_diag_candidates(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    base = grid == FG
+    h, w = grid.shape
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if base[r, c]:
+                continue
+            for dr in (-1, 1):
+                for dc in (-1, 1):
+                    for length in (3, 2, 1):
