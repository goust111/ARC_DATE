+
+BLACK = 0
+GREY = 5
+PINK = 6
+CORE_COLORS = (1, 2, 3, 4, 7)
+CW_CORNERS = ("NW", "NE", "SE", "SW")
+GEN_RETRY_LIMIT = 500
+
