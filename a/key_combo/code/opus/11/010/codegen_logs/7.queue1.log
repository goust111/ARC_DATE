339:         rr1, cc1 = r0 + h, c0 + w
340:         pr0, pc0 = 0, 0
341:     else:
342:         rr0 = max(0, r0)
343:         cc0 = max(0, c0)
344:         rr1 = min(H, r0 + h)
345:         cc1 = min(W, c0 + w)
