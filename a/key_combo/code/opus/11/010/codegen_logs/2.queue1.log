+        return None
+
+    inp_sig = _signature(grid)
+    out_sig = _signature(_ring(analysis["ordered"]))
+    if inp_sig in _SEEN_INPUTS or out_sig in _SEEN_OUTPUTS:
+        return None
+    _SEEN_INPUTS.add(inp_sig)
+    _SEEN_OUTPUTS.add(out_sig)
+    return grid
