+
+def _split_columns(columns: list[int], k: int) -> list[list[int]]:
+    extra = len(columns) - 2 * k
+    assert extra >= 0
+    widths = [2] * k
+    for idx in random.sample(range(k), extra):
+        widths[idx] += 1
+
+    parts: list[list[int]] = []
+    start = 0
+    for width in widths:
+        parts.append(columns[start : start + width])
+        start += width
+    assert start == len(columns)
+    random.shuffle(parts)
+    return parts
