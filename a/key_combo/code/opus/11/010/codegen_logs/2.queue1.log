+def _sample_counts(segment_infos: list[dict], step_rows: list[int]) -> tuple[list[int], list[int]] | None:
+    blocked_capable = [idx for idx, info in enumerate(segment_infos) if info["blocked"]]
+    if len(blocked_capable) < 2:
+        return None
