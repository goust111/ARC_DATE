+    starts: list[int] = []
+    for idx, row in enumerate(step_rows):
+        for _ in range(80):
+            step_w = random.randint(*STEP_WIDTH_RANGE)
+            start = random.randint(left_wall + 1, right_wall - step_w)
+            cells = set(range(start, start + step_w))
+            if idx == 0:
