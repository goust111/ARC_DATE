+    if not row_sensitive_segments:
+        return None
+    row_sensitive_idx = random.choice([idx for idx in row_sensitive_segments if bottoms[idx] > 0])
+
+    forced_barriers: dict[int, int] = {}
+    if len(step_rows) == 2:
+        need_rows = step_rows[:]
+        random.shuffle(need_rows)
+        barrier_segments: list[int] = []
