   186	    assert used_keys == set(marker_map), "every marker must be used exactly once"
   187	    return cropped
   188	
   189	
   190	def _random_transform(mask: np.ndarray) -> np.ndarray:
   191	    out = np.array(mask, copy=True)
   192	    if int(RNG.integers(2)):
   193	        out = np.fliplr(out)
   194	    return np.rot90(out, k=int(RNG.integers(4)))
   195	
   196	
   197	def _hole_slot_ranges(
   198	    slot: str, object_h: int, object_w: int, shape_h: int, shape_w: int
   199	) -> tuple[list[int], list[int]]:
   200	    row_mid = object_h // 2
   201	    col_mid = object_w // 2
   202	    if SLOT_RULES[slot]["row_band"] == "top":
   203	        row_values = list(range(1, row_mid - shape_h + 1))
   204	    else:
   205	        row_values = list(range(row_mid, object_h - shape_h))
   206	    if SLOT_RULES[slot]["col_band"] == "left":
   207	        col_values = list(range(1, col_mid - shape_w + 1))
   208	    else:
   209	        col_values = list(range(col_mid, object_w - shape_w))
   210	    return row_values, col_values
   211	
   212	
   213	def _fits_with_padding(canvas: np.ndarray, patch: np.ndarray, r0: int, c0: int, pad: int = 1) -> bool:
   214	    h, w = patch.shape
   215	    if r0 < 0 or c0 < 0 or r0 + h > canvas.shape[0] or c0 + w > canvas.shape[1]:
   216	        return False
   217	    rr0 = max(0, r0 - pad)
   218	    cc0 = max(0, c0 - pad)
   219	    rr1 = min(canvas.shape[0], r0 + h + pad)
   220	    cc1 = min(canvas.shape[1], c0 + w + pad)
   221	    if np.any(canvas[rr0:rr1, cc0:cc1]):
   222	        return False
   223	    return True
   224	
   225	
   226	def _edge_anchor(hole_mask: np.ndarray, direction: str) -> tuple[int, int]:
   227	    coords = np.argwhere(hole_mask)
   228	    if direction == "left":
   229	        edge = coords[:, 1].min()
   230	        edge_cells = coords[coords[:, 1] == edge]
   231	        pick = edge_cells[len(edge_cells) // 2]
   232	        return int(pick[0]), int(edge)
   233	    if direction == "right":
   234	        edge = coords[:, 1].max()
   235	        edge_cells = coords[coords[:, 1] == edge]
   236	        pick = edge_cells[len(edge_cells) // 2]
   237	        return int(pick[0]), int(edge)
   238	    if direction == "up":
   239	        edge = coords[:, 0].min()
   240	        edge_cells = coords[coords[:, 0] == edge]
   241	        pick = edge_cells[len(edge_cells) // 2]
   242	        return int(edge), int(pick[1])
   243	    edge = coords[:, 0].max()
   244	    edge_cells = coords[coords[:, 0] == edge]
   245	    pick = edge_cells[len(edge_cells) // 2]
   246	    return int(edge), int(pick[1])
   247	
   248	
   249	def _channel_cells(hole_mask: np.ndarray, direction: str, object_h: int, object_w: int) -> np.ndarray:
   250	    out = np.zeros((object_h, object_w), dtype=bool)
   251	    rr, cc = _edge_anchor(hole_mask, direction)
   252	    if direction == "left":
   253	        out[rr, :cc] = True
   254	    elif direction == "right":
   255	        out[rr, cc + 1 :] = True
