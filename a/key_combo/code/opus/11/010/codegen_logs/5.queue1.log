+    "NE": {"row_band": "top", "col_band": "right", "top_dir": "up", "bottom_dir": "right"},
+    "SW": {"row_band": "bottom", "col_band": "left", "top_dir": "left", "bottom_dir": "down"},
+    "SE": {"row_band": "bottom", "col_band": "right", "top_dir": "right", "bottom_dir": "down"},
+}
