+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+MARKER_COLORS = (2, 3, 4, 7)
+GEN_RETRIES = 400
+RNG = np.random.default_rng()
+
+
+SHAPE_LIBRARY: dict[str, np.ndarray] = {
+    "domino": np.array([[1, 1]], dtype=bool),
+    "line3": np.array([[1, 1, 1]], dtype=bool),
