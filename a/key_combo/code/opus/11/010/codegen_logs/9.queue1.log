+
+
+def _endpoint_neighbor_options(
+    shape: tuple[int, int],
+    point: tuple[int, int],
+    *,
+    forbid: tuple[int, int] | None,
+) -> list[tuple[int, int]]:
+    opts = []
+    for dr, dc in CARDINALS:
+        if forbid is not None and (dr, dc) == forbid:
+            continue
