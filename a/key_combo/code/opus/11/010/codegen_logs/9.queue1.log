+        a = random.randint(2, 7)
+        b = random.randint(2, 7)
+        if a != b or random.random() < 0.25:
+            return dr * a, dc * b
+    return dr * 2, dc * 3
+
+
+def _touches_existing(candidate: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
