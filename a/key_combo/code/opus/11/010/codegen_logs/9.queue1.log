+    grid = np.zeros((h, w), dtype=int)
+    for item in paths:
+        for r, c in item["gray"]:
+            grid[r, c] = PATH_COLOR
+        sr, sc = item["start"]
+        er, ec = item["end"]
+        grid[sr, sc] = START_COLOR
+        grid[er, ec] = END_COLOR
+    return grid, paths
+
+
+def _validate_scene(grid: np.ndarray, meta: list[dict]) -> bool:
+    try:
+        parsed = _extract_paths(grid)
+    except AssertionError:
+        return False
