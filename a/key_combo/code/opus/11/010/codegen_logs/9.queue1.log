+                return {
+                    "start": start,
+                    "end": end,
+                    "direction": direction,
+                    "gray": sorted(gray),
+                    "gray_set": gray,
+                    "ray": ray,
+                    "turns": _count_turns(path),
+                    "first_step": (first_gray[0] - sr, first_gray[1] - sc),
+                    "delta": delta,
