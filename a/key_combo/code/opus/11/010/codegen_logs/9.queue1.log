+CARDINALS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
+MAX_GEN_ATTEMPTS = 500
+_RECENT_INPUT_SIGS: set[tuple[bytes, tuple[int, int]]] = set()
+_RECENT_OUTPUT_SIGS: set[tuple[bytes, tuple[int, int]]] = set()
+_GEN_CALL_COUNT = 0
