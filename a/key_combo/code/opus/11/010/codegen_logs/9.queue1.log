+    uniq: dict[tuple[tuple[int, int], ...], list[tuple[int, int]]] = {}
+    for path in candidates:
+        uniq.setdefault(tuple(path), path)
+    paths = list(uniq.values())
+    paths.sort(key=lambda p: (_count_turns(p), len(p)))
