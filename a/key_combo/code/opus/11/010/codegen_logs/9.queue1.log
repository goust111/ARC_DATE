+    expected = _render_output(grid.shape, meta)
+    try:
+        actual = main(grid)
+    except AssertionError:
+        return False
+    return np.array_equal(actual, expected)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
