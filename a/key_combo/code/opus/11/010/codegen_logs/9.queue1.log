+    any_bent = False
+    any_axis = False
+    any_diag_rect = False
+    for item in parsed:
+        m = meta_by_start.get(item["start"])
+        if m is None:
+            return False
+        if item["end"] != m["end"] or item["direction"] != m["direction"]:
+            return False
