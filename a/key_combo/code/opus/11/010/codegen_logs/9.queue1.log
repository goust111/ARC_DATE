+def _touches_existing(candidate: set[tuple[int, int]], occupied: set[tuple[int, int]]) -> bool:
+    for r, c in candidate:
+        if (r, c) in occupied:
+            return True
+        for nr, nc in _neighbors8(r, c):
+            if (nr, nc) in occupied:
