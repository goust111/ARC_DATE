+        out_sig = (out.tobytes(), tuple(map(int, out.shape)))
+        if in_sig in _RECENT_INPUT_SIGS or out_sig in _RECENT_OUTPUT_SIGS:
+            continue
+        _RECENT_INPUT_SIGS.add(in_sig)
+        _RECENT_OUTPUT_SIGS.add(out_sig)
+        return grid
