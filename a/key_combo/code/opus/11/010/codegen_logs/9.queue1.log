+                candidates = _candidate_gray_paths(shape, first_gray, last_gray, require_bent=require_bent)
+                if not candidates:
+                    continue
+                weighted = [p for p in candidates if _count_turns(p) >= (1 if require_bent else 0)]
+                if not weighted:
+                    weighted = candidates
+                path = random.choice(weighted)
+                gray = set(path)
+                cells = gray | {start, end}
+                if _touches_existing(cells, occupied):
+                    continue
+                if gray & ray:
+                    continue
+                if end in ray:
