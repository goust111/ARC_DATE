+
+
+def _place_scene() -> tuple[np.ndarray, list[dict]] | None:
+    family = _scene_family()
+    h = random.randint(14, 22)
+    w = random.randint(14, 22)
+    if family == "mixed":
+        n_paths = random.choice([3, 4])
+    elif family == "axis":
+        n_paths = random.choice([2, 3, 4])
+    else:
+        n_paths = random.choice([2, 3, 4])
