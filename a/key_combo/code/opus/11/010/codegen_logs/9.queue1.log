+                start_touch = sum((nr, nc) in gray for nr, nc in _neighbors4(*start))
+                end_touch = sum((nr, nc) in gray for nr, nc in _neighbors4(*end))
+                if start_touch != 1 or end_touch != 1:
+                    continue
