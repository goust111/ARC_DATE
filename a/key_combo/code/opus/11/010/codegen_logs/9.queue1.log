+            continue
+
+        start_forbid = direction if direction in CARDINALS else None
+        end_forbid = (-direction[0], -direction[1]) if (-direction[0], -direction[1]) in CARDINALS else None
+        start_neighbors = _endpoint_neighbor_options(shape, start, forbid=start_forbid if force_mislead else None)
+        end_neighbors = _endpoint_neighbor_options(shape, end, forbid=end_forbid if force_mislead else None)
+        if force_mislead:
+            start_neighbors = [p for p in start_neighbors if (p[0] - sr, p[1] - sc) != direction]
+            if not start_neighbors:
+                continue
+        for first_gray in start_neighbors:
+            for last_gray in end_neighbors:
