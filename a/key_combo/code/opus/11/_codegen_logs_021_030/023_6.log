+            if not (1 <= bs <= 5):
+                continue
+            red_area = rp + area_k
+            blue_area = bs + area_k
+            if not (3 <= red_area <= 6 and 3 <= blue_area <= 6):
+                continue
+            if rp + oh > 6 or bs + oh > 6:
+                continue
+            configs.append(
+                {
+                    "pattern": pattern,
+                    "rp": rp,
+                    "bs": bs,
+                    "red_area": red_area,
+                    "blue_area": blue_area,
+                }
+            )
+    return configs
+
+
+def _build_pair_local_masks(cfg: dict) -> tuple[np.ndarray, np.ndarray]:
+    pattern = cfg["pattern"]
+    oh = int(pattern["oh"])
+    kcoords = tuple((int(r), int(c)) for r, c in pattern["coords"])
+    rp = int(cfg["rp"])
+    bs = int(cfg["bs"])
+
+    red_attach = sorted(c for r, c in kcoords if r == 0)
+    blue_attach = sorted(c for r, c in kcoords if r == oh - 1)
+    red_col = int(random.choice(red_attach))
+    blue_col = int(random.choice(blue_attach))
+
+    red = {(r + rp, c) for r, c in kcoords}
+    red.update((r, red_col) for r in range(rp))
+
+    blue = set(kcoords)
+    blue.update((r, blue_col) for r in range(oh, oh + bs))
+
+    red_coords = np.array(sorted(red), dtype=int)
+    blue_coords = np.array(sorted(blue), dtype=int)
+    return red_coords, blue_coords
+
+
+def _choose_configs(n_regions: int) -> tuple[int, list[dict]] | None:
+    spans = [7, 8, 9]
+    random.shuffle(spans)
+    for span in spans:
+        configs = _feasible_configs(span)
+        by_rp: dict[int, list[dict]] = {}
+        for cfg in configs:
+            by_rp.setdefault(int(cfg["rp"]), []).append(cfg)
+        rps = sorted(by_rp)
+        if len(rps) < n_regions:
+            continue
+        for _ in range(80):
+            chosen_rps = sorted(random.sample(rps, n_regions))
+            picked = [random.choice(by_rp[rp]) for rp in chosen_rps]
+            if all(item["pattern"]["name"] in {"single", "v2"} for item in picked):
+                continue
+            return span + 2, picked
+    return None
+
+
+def _place_columns(widths: list[int], w: int) -> list[int] | None:
+    gaps = [random.randint(2, 4) for _ in range(len(widths) - 1)]
+    total = sum(widths) + sum(gaps)
+    if total > w:
+        return None
+    slack = w - total
+    start = random.randint(0, slack)
+    cols = []
+    cur = start
+    for i, width in enumerate(widths):
+        cols.append(cur)
+        cur += width
+        if i < len(widths) - 1:
+            cur += gaps[i]
+    return cols
+
+
+def _make_grid(h: int, w: int, red_objs: list[np.ndarray], blue_objs: list[np.ndarray]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    grid[0, :] = TOP_COLOR
+    grid[h - 1, :] = BOTTOM_COLOR
+    for obj in red_objs:
+        grid[obj[:, 0], obj[:, 1]] = TOP_COLOR
+    for obj in blue_objs:
+        grid[obj[:, 0], obj[:, 1]] = BOTTOM_COLOR
+    return grid
+
+
+def _partial_overlap_count(red_objs: list[np.ndarray], blue_objs: list[np.ndarray], h: int, w: int) -> int:
+    overlap, _masks = _overlap_mask(red_objs + blue_objs, (h, w))
+    return int(overlap.sum())
+
+
+def _validate_generated(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    assert bool(np.all(g[0, :] == TOP_COLOR))
+    assert bool(np.all(g[h - 1, :] == BOTTOM_COLOR))
+    assert set(map(int, np.unique(g))) <= {BG, TOP_COLOR, BOTTOM_COLOR}
+
+    red_objects = _extract_color_objects(g, TOP_COLOR)
+    blue_objects = _extract_color_objects(g, BOTTOM_COLOR)
+    assert 2 <= len(red_objects) <= 3
+    assert len(red_objects) == len(blue_objects)
+
+    all_objects = red_objects + blue_objects
+    for obj in all_objects:
+        assert 3 <= len(obj) <= 6, "object area must stay in the puzzle range"
+    for i in range(len(all_objects)):
+        for j in range(i + 1, len(all_objects)):
+            assert not _touches8(all_objects[i], all_objects[j]), "input objects must be visually separated"
+
+    moved_red = [_slide_red(obj) for obj in red_objects]
+    moved_blue = [_slide_blue(obj, h) for obj in blue_objects]
+    overlap, masks = _overlap_mask(moved_red + moved_blue, (h, w))
+    comps = _component_coords(overlap)
