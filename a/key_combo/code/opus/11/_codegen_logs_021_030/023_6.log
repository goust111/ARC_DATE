+TOP_COLOR = 2
+BOTTOM_COLOR = 1
+OVERLAP_COLOR = 6
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+ONE_REGION_TEMPLATES = [
+    {
+        "objects": [
+            ((0, 0), (1, 0), (1, 1), (2, 1)),
+            ((0, 2), (1, 1), (1, 2), (2, 1)),
+        ]
+    },
