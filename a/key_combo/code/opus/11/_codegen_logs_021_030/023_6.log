+            ((0, 2), (1, 1), (1, 2), (2, 1)),
+        ]
+    },
+    {
+        "objects": [
+            ((0, 0), (0, 1), (1, 1), (2, 1)),
+            ((0, 1), (0, 2), (1, 1), (2, 1)),
+        ]
+    },
+    {
+        "objects": [
+            ((0, 0), (1, 0), (2, 0), (2, 1)),
+            ((0, 1), (1, 1), (2, 0), (2, 1)),
+        ]
+    },
+]
+
+TWO_REGION_TEMPLATES = [
+    {
+        "objects": [
+            ((0, 0), (1, 0), (1, 1)),
+            ((0, 1), (1, 1), (2, 1), (2, 2), (3, 2)),
+            ((1, 2), (2, 2), (3, 2)),
+        ]
+    },
+    {
+        "objects": [
+            ((0, 0), (1, 0), (1, 1), (2, 1)),
+            ((1, 1), (2, 1), (2, 2), (3, 2)),
+            ((2, 2), (3, 2), (3, 3)),
+        ]
+    },
+]
