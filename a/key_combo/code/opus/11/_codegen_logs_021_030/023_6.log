+def _touches8(a: np.ndarray, b: np.ndarray) -> bool:
+    aset = {tuple(map(int, cell)) for cell in a.tolist()}
+    bset = {tuple(map(int, cell)) for cell in b.tolist()}
+    for r, c in aset:
+        for dr, dc in DIR8:
+            if (r + dr, c + dc) in bset:
+                return True
+    return bool(aset & bset)
