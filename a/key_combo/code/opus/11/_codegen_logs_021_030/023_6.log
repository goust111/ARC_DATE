+
+
+def _overlap_mask(object_coords: list[np.ndarray], shape: tuple[int, int]) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = map(int, shape)
+    occupancy = np.zeros((h, w), dtype=int)
