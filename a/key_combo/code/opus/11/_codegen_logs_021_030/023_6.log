+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+TOP_COLOR = 2
+BOTTOM_COLOR = 1
+OVERLAP_COLOR = 6
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+PATTERNS = [
+    {"name": "single", "coords": ((0, 0),), "oh": 1, "ow": 1},
+    {"name": "h2", "coords": ((0, 0), (0, 1)), "oh": 1, "ow": 2},
+    {"name": "v2", "coords": ((0, 0), (1, 0)), "oh": 2, "ow": 1},
+    {"name": "l3", "coords": ((0, 0), (1, 0), (1, 1)), "oh": 2, "ow": 2},
+    {"name": "j3", "coords": ((0, 1), (1, 0), (1, 1)), "oh": 2, "ow": 2},
+]
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    return (
+        int(coords[:, 0].min()),
+        int(coords[:, 1].min()),
+        int(coords[:, 0].max()),
+        int(coords[:, 1].max()),
+    )
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIR4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _extract_color_objects(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    mask = grid[1:-1, :] == int(color)
+    comps = _component_coords(mask)
+    result = []
+    for coords in comps:
+        lifted = coords + np.array([1, 0], dtype=int)
+        result.append(lifted)
+    return result
+
+
+def _shift(coords: np.ndarray, dr: int, dc: int = 0) -> np.ndarray:
+    return coords + np.array([dr, dc], dtype=int)
+
+
+def _slide_red(coords: np.ndarray) -> np.ndarray:
+    return _shift(coords, 1 - int(coords[:, 0].min()))
+
+
+def _slide_blue(coords: np.ndarray, h: int) -> np.ndarray:
+    return _shift(coords, (h - 2) - int(coords[:, 0].max()))
+
+
+def _overlap_mask(object_coords: list[np.ndarray], shape: tuple[int, int]) -> tuple[np.ndarray, list[np.ndarray]]:
+    h, w = map(int, shape)
+    occupancy = np.zeros((h, w), dtype=int)
+    masks = []
+    for coords in object_coords:
+        mask = np.zeros((h, w), dtype=bool)
+        mask[coords[:, 0], coords[:, 1]] = True
+        masks.append(mask)
+        occupancy += mask.astype(int)
+    return occupancy >= 2, masks
+
+
+def _diagonal_stitch(overlap_comps: list[np.ndarray]) -> np.ndarray:
+    ranked = sorted(overlap_comps, key=lambda comp: _bbox(comp)[:2])
+    patches: list[np.ndarray] = []
+    placements: list[tuple[int, int]] = []
+    cur_r = 0
+    cur_c = 0
+    for comp in ranked:
+        r0, c0, r1, c1 = _bbox(comp)
+        patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+        patch[comp[:, 0] - r0, comp[:, 1] - c0] = OVERLAP_COLOR
+        patches.append(patch)
+        placements.append((cur_r, cur_c))
+        cur_r += patch.shape[0]
+        cur_c += patch.shape[1]
+
+    out = np.zeros((cur_r, cur_c), dtype=int)
+    for patch, (r0, c0) in zip(patches, placements):
+        out[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = patch
+    return out
+
+
+def _slid_overlap_components(grid: np.ndarray) -> tuple[list[np.ndarray], list[np.ndarray]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    red_objects = _extract_color_objects(g, TOP_COLOR)
+    blue_objects = _extract_color_objects(g, BOTTOM_COLOR)
+    moved = [_slide_red(obj) for obj in red_objects] + [_slide_blue(obj, h) for obj in blue_objects]
+    overlap, masks = _overlap_mask(moved, (h, w))
+    return _component_coords(overlap), masks
+
+
+def _touches8(a: np.ndarray, b: np.ndarray) -> bool:
+    aset = {tuple(map(int, cell)) for cell in a.tolist()}
+    bset = {tuple(map(int, cell)) for cell in b.tolist()}
+    for r, c in aset:
+        for dr, dc in DIR8:
+            if (r + dr, c + dc) in bset:
+                return True
+    return bool(aset & bset)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Slide red and blue objects to their matching border bars, then extract and diagonally stitch the new overlaps.
+    
+    Input structure:
+    - The background is black.
+    - The top row is a full-width red bar and the bottom row is a full-width blue bar.
+    - The interior contains several 4-connected red objects and blue objects, each disjoint in the input.
+    
+    Rule:
+    - Slide every red object upward until its bbox top reaches row 1, and every blue object downward until its bbox bottom reaches row H-2.
+    - Mark every pixel occupied by at least two slid objects as magenta; these 4-connected magenta sets are the overlap regions.
+    - Crop each overlap region to its own bbox and place the cropped blocks on a new black canvas with cumulative down-right offsets.
+    
+    Key insight:
+    The magenta regions do not exist in the input at all; they appear only after both color groups are slid to the boundary bars, so the final stitched canvas depends on the induced intersections rather than on any preexisting shape.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    h, w = map(int, g.shape)
+    assert 5 <= h <= 30 and 5 <= w <= 30, "grid must satisfy ARC size limits"
+    assert bool(np.all(g[0, :] == TOP_COLOR)), "top row must be the red border bar"
+    assert bool(np.all(g[h - 1, :] == BOTTOM_COLOR)), "bottom row must be the blue border bar"
+    assert set(map(int, np.unique(g))) <= {BG, TOP_COLOR, BOTTOM_COLOR}, "unexpected colors in input"
+
+    red_objects = _extract_color_objects(g, TOP_COLOR)
+    blue_objects = _extract_color_objects(g, BOTTOM_COLOR)
+    assert red_objects and blue_objects, "expected movable objects for both border colors"
+
+    moved = [_slide_red(obj) for obj in red_objects] + [_slide_blue(obj, h) for obj in blue_objects]
+    overlap, _masks = _overlap_mask(moved, (h, w))
+    comps = _component_coords(overlap)
+    assert comps, "sliding must create at least one overlap region"
+    return _diagonal_stitch(comps)
+
+
+def _feasible_configs(span: int) -> list[dict]:
+    configs = []
+    for pattern in PATTERNS:
+        area_k = len(pattern["coords"])
+        oh = int(pattern["oh"])
+        for rp in range(1, span - oh):
+            bs = span - rp - oh
+            if not (1 <= bs <= 5):
+                continue
+            red_area = rp + area_k
+            blue_area = bs + area_k
+            if not (3 <= red_area <= 6 and 3 <= blue_area <= 6):
+                continue
+            if rp + oh > 6 or bs + oh > 6:
+                continue
+            configs.append(
+                {
+                    "pattern": pattern,
+                    "rp": rp,
+                    "bs": bs,
+                    "red_area": red_area,
+                    "blue_area": blue_area,
+                }
+            )
+    return configs
+
+
+def _build_pair_local_masks(cfg: dict) -> tuple[np.ndarray, np.ndarray]:
+    pattern = cfg["pattern"]
+    oh = int(pattern["oh"])
+    kcoords = tuple((int(r), int(c)) for r, c in pattern["coords"])
+    rp = int(cfg["rp"])
+    bs = int(cfg["bs"])
+
+    red_attach = sorted(c for r, c in kcoords if r == 0)
+    blue_attach = sorted(c for r, c in kcoords if r == oh - 1)
+    red_col = int(random.choice(red_attach))
+    blue_col = int(random.choice(blue_attach))
+
+    red = {(r + rp, c) for r, c in kcoords}
+    red.update((r, red_col) for r in range(rp))
+
+    blue = set(kcoords)
+    blue.update((r, blue_col) for r in range(oh, oh + bs))
+
+    red_coords = np.array(sorted(red), dtype=int)
+    blue_coords = np.array(sorted(blue), dtype=int)
+    return red_coords, blue_coords
+
+
+def _choose_configs(n_regions: int) -> tuple[int, list[dict]] | None:
+    spans = [7, 8, 9]
+    random.shuffle(spans)
+    for span in spans:
+        configs = _feasible_configs(span)
+        by_rp: dict[int, list[dict]] = {}
+        for cfg in configs:
+            by_rp.setdefault(int(cfg["rp"]), []).append(cfg)
+        rps = sorted(by_rp)
+        if len(rps) < n_regions:
+            continue
+        for _ in range(80):
+            chosen_rps = sorted(random.sample(rps, n_regions))
+            picked = [random.choice(by_rp[rp]) for rp in chosen_rps]
+            if all(item["pattern"]["name"] in {"single", "v2"} for item in picked):
+                continue
+            return span + 2, picked
+    return None
+
+
+def _place_columns(widths: list[int], w: int) -> list[int] | None:
+    gaps = [random.randint(2, 4) for _ in range(len(widths) - 1)]
+    total = sum(widths) + sum(gaps)
+    if total > w:
+        return None
+    slack = w - total
+    start = random.randint(0, slack)
+    cols = []
+    cur = start
+    for i, width in enumerate(widths):
+        cols.append(cur)
+        cur += width
+        if i < len(widths) - 1:
+            cur += gaps[i]
+    return cols
+
+
+def _make_grid(h: int, w: int, red_objs: list[np.ndarray], blue_objs: list[np.ndarray]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    grid[0, :] = TOP_COLOR
+    grid[h - 1, :] = BOTTOM_COLOR
+    for obj in red_objs:
+        grid[obj[:, 0], obj[:, 1]] = TOP_COLOR
+    for obj in blue_objs:
+        grid[obj[:, 0], obj[:, 1]] = BOTTOM_COLOR
+    return grid
+
+
+def _partial_overlap_count(red_objs: list[np.ndarray], blue_objs: list[np.ndarray], h: int, w: int) -> int:
+    overlap, _masks = _overlap_mask(red_objs + blue_objs, (h, w))
+    return int(overlap.sum())
+
+
+def _validate_generated(grid: np.ndarray) -> None:
+    g = np.asarray(grid, dtype=int)
+    h, w = map(int, g.shape)
+    assert bool(np.all(g[0, :] == TOP_COLOR))
+    assert bool(np.all(g[h - 1, :] == BOTTOM_COLOR))
+    assert set(map(int, np.unique(g))) <= {BG, TOP_COLOR, BOTTOM_COLOR}
+
+    red_objects = _extract_color_objects(g, TOP_COLOR)
+    blue_objects = _extract_color_objects(g, BOTTOM_COLOR)
+    assert 2 <= len(red_objects) <= 3
+    assert len(red_objects) == len(blue_objects)
+
+    all_objects = red_objects + blue_objects
+    for obj in all_objects:
+        assert 3 <= len(obj) <= 6, "object area must stay in the puzzle range"
+    for i in range(len(all_objects)):
+        for j in range(i + 1, len(all_objects)):
+            assert not _touches8(all_objects[i], all_objects[j]), "input objects must be visually separated"
+
+    moved_red = [_slide_red(obj) for obj in red_objects]
+    moved_blue = [_slide_blue(obj, h) for obj in blue_objects]
+    overlap, masks = _overlap_mask(moved_red + moved_blue, (h, w))
+    comps = _component_coords(overlap)
+    assert 2 <= len(comps) <= 3, "generator must produce 2-3 overlap regions"
+
+    bboxes = [_bbox(comp) for comp in comps]
+    ordered = sorted(bboxes)
+    assert ordered == bboxes or sorted(comps, key=lambda comp: _bbox(comp)[:2]), "bbox extraction must stay orderable"
+    for i in range(len(bboxes)):
+        for j in range(i + 1, len(bboxes)):
+            a = bboxes[i]
+            b = bboxes[j]
+            overlap_rows = not (a[2] < b[0] or b[2] < a[0])
+            overlap_cols = not (a[3] < b[1] or b[3] < a[1])
+            assert not (overlap_rows and overlap_cols), "overlap-region bboxes must not overlap"
+
+    for mask in masks:
+        assert bool(np.any(mask & overlap)), "every object must contribute to some overlap"
+
+    partial_red_only = _partial_overlap_count(moved_red, blue_objects, h, w)
+    partial_blue_only = _partial_overlap_count(red_objects, moved_blue, h, w)
+    assert partial_red_only == 0 and partial_blue_only == 0, "both slide directions must be necessary"
+
+    out = main(g)
+    assert out.ndim == 2 and max(out.shape) <= 30
+    assert set(map(int, np.unique(out))) <= {BG, OVERLAP_COLOR}
+    assert int((out == OVERLAP_COLOR).sum()) == int(overlap.sum())
+
+    ordered_comps = sorted(comps, key=lambda comp: _bbox(comp)[:2])
+    prev = None
+    for comp in ordered_comps:
+        bb = _bbox(comp)
+        if prev is not None:
+            assert bb[0] > prev[0] and bb[1] > prev[1], "top-left order must be unique and visible"
+        prev = bb
+
+
+def _gen_attempt() -> np.ndarray | None:
+    n_regions = random.choice([2, 3])
+    chosen = _choose_configs(n_regions)
+    if chosen is None:
+        return None
+    h, configs = chosen
+    widths = [int(cfg["pattern"]["ow"]) for cfg in configs]
+
+    min_w = max(10, sum(widths) + 2 * (n_regions - 1))
+    max_w = min(15, min_w + 4)
+    if min_w > max_w:
+        return None
+    w = random.randint(min_w, max_w)
+    cols = _place_columns(widths, w)
+    if cols is None:
+        return None
+
+    red_objs: list[np.ndarray] = []
+    blue_objs: list[np.ndarray] = []
+
+    for cfg, c0 in zip(configs, cols):
+        red_local, blue_local = _build_pair_local_masks(cfg)
+        rp = int(cfg["rp"])
+        bs = int(cfg["bs"])
+        oh = int(cfg["pattern"]["oh"])
+
+        final_red = red_local + np.array([1, c0], dtype=int)
+        final_blue = blue_local + np.array([rp + 1, c0], dtype=int)
+
+        hr = rp + oh
+        hb = oh + bs
+        assert hr <= 6 and hb <= 6
+        offset_pairs = [
+            (dr, db)
+            for dr in range(1, bs + 1)
+            for db in range(1, rp + 1)
+        ]
+        random.shuffle(offset_pairs)
+        chosen_offsets = None
+        for dr, db in offset_pairs:
+            candidate_red = final_red + np.array([dr, 0], dtype=int)
+            candidate_blue = final_blue - np.array([db, 0], dtype=int)
+            if _touches8(candidate_red, candidate_blue):
+                continue
+            moved_only_red = _partial_overlap_count([_slide_red(candidate_red)], [candidate_blue], h, w)
+            moved_only_blue = _partial_overlap_count([candidate_red], [_slide_blue(candidate_blue, h)], h, w)
+            if moved_only_red != 0 or moved_only_blue != 0:
+                continue
+            chosen_offsets = (candidate_red, candidate_blue)
+            break
+        if chosen_offsets is None:
+            return None
+
+        red_objs.append(chosen_offsets[0])
+        blue_objs.append(chosen_offsets[1])
+
+    grid = _make_grid(h, w, red_objs, blue_objs)
+    try:
+        _validate_generated(grid)
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 6")

