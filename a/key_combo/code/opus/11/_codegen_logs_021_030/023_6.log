+    grid = _make_grid(h, w, red_objs, blue_objs)
+    try:
+        _validate_generated(grid)
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
