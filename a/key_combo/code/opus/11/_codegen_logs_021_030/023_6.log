+            if moved_only_red != 0 or moved_only_blue != 0:
+                continue
+            chosen_offsets = (candidate_red, candidate_blue)
+            break
+        if chosen_offsets is None:
+            return None
+
+        red_objs.append(chosen_offsets[0])
+        blue_objs.append(chosen_offsets[1])
+
+    grid = _make_grid(h, w, red_objs, blue_objs)
+    try:
+        _validate_generated(grid)
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
