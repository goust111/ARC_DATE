+        blue_to_boundary=False if all_to_divider else True,
+    )
+    U = _half_count(painted, divider, "top")
+    D = _half_count(painted, divider, "bottom")
+    if U == D:
+        return painted
+    winner = "top" if U > D else "bottom"
+    return _mirror_winner(painted, divider, winner)
+
+
