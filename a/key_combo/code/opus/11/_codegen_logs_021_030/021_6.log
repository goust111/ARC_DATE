+    H, W = grid.shape
+    rows = _candidate_rows(H, divider, half)
+    cells = [(r, c) for r in rows for c in range(W)]
+    random.shuffle(cells)
+
+    used_cols: set[int] = set()
+    placed: list[tuple[int, int]] = []
+
+    for color, need in ((RED, red_count), (BLUE, blue_count)):
