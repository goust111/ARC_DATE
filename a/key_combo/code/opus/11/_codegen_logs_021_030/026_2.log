+@lru_cache(maxsize=1)
+def _shape_bank() -> dict[str, tuple[np.ndarray, ...]]:
+    by_type: dict[str, list[np.ndarray]] = {typ: [] for typ in TYPE_ORDER}
+    seen: dict[str, set[tuple[tuple[int, int], bytes]]] = {typ: set() for typ in TYPE_ORDER}
