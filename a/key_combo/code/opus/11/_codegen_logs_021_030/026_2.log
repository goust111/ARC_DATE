        for i in range(h*w):
          if bits>>i &1: mask[i//w,i%w]=1
        if mask.sum()<3 or mask.sum()>6 or mask.all(): continue
        if not connected(mask): continue
        nm=normalize(mask)
        if nm.shape"'!=(h,w): continue
        if cls(nm)!=typ: continue
        if not any(np.array_equal(nm,x) for x in uniq): uniq.append(nm)
  uniq=sorted(uniq,key=lambda m:(m.shape[0],m.shape[1],int(m.sum()),m.astype(int).tolist()))
  for m in uniq:
    print(m.shape, int(m.sum()))
    print(m.astype(int))
