def connected(mask):
    coords = set(map(tuple, np.argwhere(mask)))
    if not coords:
        return False
    stack=[next(iter(coords))]
    seen={stack[0]}
    while stack:
        r,c=stack.pop()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            p=(r+dr,c+dc)
            if p in coords and p not in seen:
