  v=np.array_equal(mask,np.fliplr(mask))
  r=np.array_equal(mask,np.rot90(mask,2))
  if h+v==0 and not r:return 'A'
  if h+v==1:return 'B'
  if h+v==2:return 'C'
  if h+v==0 and r:return 'D'
  return None
