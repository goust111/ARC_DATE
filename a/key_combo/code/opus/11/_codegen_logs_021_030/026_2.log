    def add(mask: np.ndarray) -> None:
        area = int(np.count_nonzero(mask))
        if not (_GEN_BLOB_AREA_RANGE[0] <= area <= _GEN_BLOB_AREA_RANGE[1]):
            return
        key = (tuple(map(int, mask.shape)), mask.tobytes())
