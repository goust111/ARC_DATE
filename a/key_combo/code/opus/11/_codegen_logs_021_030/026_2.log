                        break
                if not ok:
                    break
            if ok:
                locations.append((r0, c0))
    return locations


def _gen_paste_gray(grid: np.ndarray, mask: np.ndarray, r0: int, c0: int) -> None:
    patch = np.zeros(mask.shape, dtype=int)
    patch[mask] = Color.GREY
    paste(grid, patch, r0, c0, transparent=Color.BLACK)


