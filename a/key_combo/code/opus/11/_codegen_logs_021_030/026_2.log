+def _validate_input(grid: np.ndarray) -> bool:
+    try:
+        box = _legend_box(grid)
+        mapping = _legend_mapping(grid)
+        if tuple(mapping[typ] for typ in TYPE_ORDER) != ROW_TO_EXPECTED_COLOR:
