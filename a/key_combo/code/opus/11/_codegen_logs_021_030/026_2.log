+
+        r0, c0, r1, c1 = box
+        if c0 > 2:
+            return False
+
+        objs = _object_summaries(grid)
+        if not (3 <= len(objs) <= 5):
+            return False
+        types = [obj["type"] for obj in objs]
+        if len(objs) == 3:
+            if len(set(types)) != 3:
+                return False
+        elif set(types) != set(TYPE_ORDER):
+            return False
+
+        for obj in objs:
+            if not (3 <= obj["area"] <= 6):
+                return False
+            if max(obj["dims"]) > 3:
+                return False
+            if np.all(obj["mask"]):
+                return False
+            br0, bc0, br1, bc1 = obj["bbox"]
+            if br0 <= r1 + 1 and bc0 <= c1 + 1:
+                return False
+
+        same_dims_cross_type = False
+        same_area_cross_type = False
+        for i, a in enumerate(objs):
+            for b in objs[i + 1 :]:
+                if a["type"] == b["type"]:
