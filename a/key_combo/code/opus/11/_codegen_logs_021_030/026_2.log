_GEN_BLOB_HEIGHT_RANGE = (2, 9)
_GEN_BLOB_WIDTH_RANGE = (2, 12)
_GEN_BLOB_AREA_RANGE = (4, 56)
_GEN_TOTAL_HOLE_AREA_RANGE = (30, 110)

