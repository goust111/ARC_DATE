_GEN_HOLE_COLOR = 9

# Correlated base-pattern synthesis.
_GEN_COARSE_SIZE = 8
_GEN_COARSE_SCALE = 2
_GEN_NOISE_RATE_RANGE = (0.12, 0.28)
_GEN_SMOOTH_PASS_RANGE = (1, 3)
_GEN_SMOOTH_COPY_PROB = 0.28

# Hole component geometry and total damaged area.
