+    h, w = shape
+    out: list[tuple[int, int]] = []
+    total_out = len(spec["out_pixels"])
+    out_groups = spec["out_groups"]
+
+    row_order = list(range(h - spec["input_h"] + 1))
+    col_order = list(range(w - spec["input_w"] + 1))
