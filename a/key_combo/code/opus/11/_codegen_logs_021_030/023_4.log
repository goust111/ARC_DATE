+        return {
+            "orientation": "tall",
+            "input_h": total_h,
+            "input_w": width,
+            "in_pixels": tuple(in_pixels),
+            "out_groups": (tuple(top_out), tuple(bottom_out)),
+            "out_pixels": tuple(top_out + bottom_out),
+            "part_sizes": (top_h, bottom_h),
+            "asymmetric": top_h != bottom_h,
+        }
+    return None
+
+
+def _sample_orientations(count: int) -> list[str]:
+    if count == 2:
+        choices = [
+            ["wide", "tall"],
+            ["wide", "tall"],
+            ["wide", "tall"],
+            ["wide", "wide"],
+            ["tall", "tall"],
