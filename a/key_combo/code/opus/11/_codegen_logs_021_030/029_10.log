+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _trim(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return mask[:0, :0].copy()
+    r0, c0, r1, c1 = _bbox_from_coords(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _background_components(mask: np.ndarray) -> tuple[list[np.ndarray], np.ndarray]:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    exterior = np.zeros_like(mask, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            touches_border = False
+            while queue:
+                rr, cc = queue.popleft()
+                cells.append((rr, cc))
+                if rr == 0 or rr == h - 1 or cc == 0 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in DIR4:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            arr = np.array(cells, dtype=int)
+            comps.append(arr)
+            if touches_border:
+                exterior[arr[:, 0], arr[:, 1]] = True
+    return comps, exterior
+
+
+def _hole_components(mask: np.ndarray) -> list[np.ndarray]:
+    pad = np.pad(mask.astype(bool), 1, constant_values=False)
+    comps, exterior = _background_components(pad)
+    holes: list[np.ndarray] = []
+    for comp in comps:
