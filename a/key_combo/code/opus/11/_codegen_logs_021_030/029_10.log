+
+def _outline_distance_map(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    exterior = _exterior_background(mask)
+    dist = np.full((h, w), -1, dtype=int)
+    queue: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in range(w):
+            if not exterior[r, c]:
+                continue
+            for dr, dc in DIR4:
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc]:
+                    dist[r, c] = 1
+                    queue.append((r, c))
+                    break
+
+    while queue:
+        r, c = queue.popleft()
+        nd = dist[r, c] + 1
+        for dr, dc in DIR4:
+            nr = r + dr
+            nc = c + dc
+            if 0 <= nr < h and 0 <= nc < w and exterior[nr, nc] and dist[nr, nc] < 0:
+                dist[nr, nc] = nd
+                queue.append((nr, nc))
+
+    return dist
+
+
+def _analyze_object(mask: np.ndarray) -> dict:
+    comps = _components(mask)
+    assert len(comps) == 1
+    coords = comps[0]
+    holes = _hole_components(mask)
+    return {
+        "coords": coords,
+        "bbox": _bbox_from_coords(coords),
+        "area": int(mask.sum()),
+        "hole_count": len(holes),
+        "hole_sizes": sorted(int(len(hole)) for hole in holes),
+    }
+
+
+def _solve_with_options(
