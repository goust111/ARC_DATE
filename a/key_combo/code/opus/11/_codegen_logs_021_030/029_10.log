+        submask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        stats.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "area": int(submask.sum()),
+                "hole_count": _hole_count(submask),
+                "bbox_area": int((r1 - r0 + 1) * (c1 - c0 + 1)),
