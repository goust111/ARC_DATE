+            c0 = random.randint(0, w - ow)
+            box = (
+                max(0, r0 - MAX_HOLES),
+                max(0, c0 - MAX_HOLES),
+                min(h - 1, r0 + oh - 1 + MAX_HOLES),
+                min(w - 1, c0 + ow - 1 + MAX_HOLES),
+            )
+            overlaps = False
+            for br0, bc0, br1, bc1 in padded_boxes:
+                if not (box[2] < br0 or br1 < box[0] or box[3] < bc0 or bc1 < box[1]):
+                    overlaps = True
+                    break
