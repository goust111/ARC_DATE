+                break
+
+        try:
+            objects = [_make_object(hole_count, target_area) for hole_count, target_area in zip(hole_counts, target_areas)]
+        except RuntimeError:
+            continue
+
+        grid_h = random.randint(GRID_MIN, GRID_MAX)
+        grid_w = random.randint(GRID_MIN, GRID_MAX)
+        if n_objects == 3:
