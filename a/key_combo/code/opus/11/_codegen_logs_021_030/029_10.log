+def _object_stats(grid: np.ndarray) -> list[dict]:
+    mask = grid == OBJECT_COLOR
+    stats = []
+    for coords in _components(mask):
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        submask = mask[r0 : r1 + 1, c0 : c1 + 1]
+        stats.append(
