+        sub_in = grid[r0 : r1 + 1, c0 : c1 + 1]
+        sub_out = out[r0 : r1 + 1, c0 : c1 + 1]
+        assert np.array_equal(sub_in == OBJECT_COLOR, sub_out == OBJECT_COLOR)
+        holes = _hole_components(sub_in == OBJECT_COLOR)
