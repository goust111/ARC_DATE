+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if any(
+            0 <= rr + dr < mask.shape[0]
+            and 0 <= cc + dc < mask.shape[1]
+            and exterior[rr + dr, cc + dc]
+            for dr, dc in DIR4
