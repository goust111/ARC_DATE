+            continue
+
+        grid_h = random.randint(GRID_MIN, GRID_MAX)
+        grid_w = random.randint(GRID_MIN, GRID_MAX)
+        if n_objects == 3:
+            grid_h = max(grid_h, 21)
+            grid_w = max(grid_w, 21)
+
+        try:
+            placements = _place_objects((grid_h, grid_w), objects)
