+            if 0 <= nr < h and 0 <= nc < w and exterior[nr, nc] and dist[nr, nc] < 0:
+                dist[nr, nc] = nd
+                queue.append((nr, nc))
+
+    return dist
+
+
+def _analyze_object(mask: np.ndarray) -> dict:
+    comps = _components(mask)
