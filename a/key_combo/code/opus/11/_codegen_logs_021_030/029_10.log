+            if area < target_area:
+                if not _try_add(mask, hole_count):
+                    break
+            elif area > target_area:
+                if not _try_remove(mask, hole_count):
+                    break
+            else:
+                if random.random() < 0.65:
+                    _try_add(mask, hole_count)
+                else:
+                    _try_remove(mask, hole_count)
