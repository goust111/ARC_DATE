+
+BACKGROUND = 0
+OBJECT_COLOR = 5
+ODD_OUTLINE_COLOR = 2
+EVEN_OUTLINE_COLOR = 1
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_MIN = 18
+GRID_MAX = 26
+MAX_HOLES = 3
+MAX_GENERATION_ATTEMPTS = 400
+OBJECT_ATTEMPTS = 200
+PLACEMENT_ATTEMPTS = 200
+WORK_CANVAS = 15
+TARGET_AREA_MIN = 15
+TARGET_AREA_MAX = 30
