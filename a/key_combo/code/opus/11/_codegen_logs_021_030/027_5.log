+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BACKGROUND or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append({"color": color, "cells": cells})
+    return components
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _expected_cup_mask(height: int, width: int, orientation: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if orientation == "up":
+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+    elif orientation == "down":
+        mask[0, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+    elif orientation == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif orientation == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(f"unknown orientation: {orientation}")
+    return mask
+
+
+def _lip_local_coords(height: int, width: int, orientation: str) -> list[tuple[int, int]]:
+    if orientation == "up":
+        return [(0, 0), (0, width - 1)]
+    if orientation == "down":
+        return [(height - 1, 0), (height - 1, width - 1)]
+    if orientation == "left":
+        return [(0, 0), (height - 1, 0)]
+    if orientation == "right":
+        return [(0, width - 1), (height - 1, width - 1)]
+    raise ValueError(f"unknown orientation: {orientation}")
+
+
+def _identify_cup(component: dict) -> dict:
+    cells = component["cells"]
+    r0, c0, r1, c1 = _bbox(cells)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+
+    matches = []
+    for orientation in ("up", "down", "left", "right"):
+        expected = _expected_cup_mask(height, width, orientation)
+        if np.array_equal(mask, expected):
+            matches.append(orientation)
+    assert len(matches) == 1, "each component must be exactly one U-shaped cup"
