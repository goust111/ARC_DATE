+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = (1, 2, 3, 4)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+RAY_DIR = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GRID_SIDE_RANGE = (16, 22)
+SPAN_RANGE = (3, 5)
+DEPTH_RANGE = (2, 4)
+PAIR_GAP_RANGE = (4, 8)
+PAIR_MARGIN = 1
+PAIR_BOX_GAP = 2
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _find_components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BACKGROUND or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr = cr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append({"color": color, "cells": cells})
+    return components
+
+
+def _bbox(cells: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in cells]
+    cols = [c for _, c in cells]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _expected_cup_mask(height: int, width: int, orientation: str) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    if orientation == "up":
+        mask[-1, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+    elif orientation == "down":
+        mask[0, :] = True
+        mask[:, 0] = True
+        mask[:, -1] = True
+    elif orientation == "left":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, -1] = True
+    elif orientation == "right":
+        mask[0, :] = True
+        mask[-1, :] = True
+        mask[:, 0] = True
+    else:
+        raise ValueError(f"unknown orientation: {orientation}")
+    return mask
+
+
+def _lip_local_coords(height: int, width: int, orientation: str) -> list[tuple[int, int]]:
+    if orientation == "up":
+        return [(0, 0), (0, width - 1)]
+    if orientation == "down":
+        return [(height - 1, 0), (height - 1, width - 1)]
+    if orientation == "left":
+        return [(0, 0), (height - 1, 0)]
+    if orientation == "right":
+        return [(0, width - 1), (height - 1, width - 1)]
+    raise ValueError(f"unknown orientation: {orientation}")
+
+
+def _identify_cup(component: dict) -> dict:
+    cells = component["cells"]
+    r0, c0, r1, c1 = _bbox(cells)
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in cells:
+        mask[r - r0, c - c0] = True
+
+    matches = []
+    for orientation in ("up", "down", "left", "right"):
+        expected = _expected_cup_mask(height, width, orientation)
+        if np.array_equal(mask, expected):
+            matches.append(orientation)
+    assert len(matches) == 1, "each component must be exactly one U-shaped cup"
+    orientation = matches[0]
+    return {
+        "color": component["color"],
+        "cells": cells,
+        "cell_set": set(cells),
+        "bbox": (r0, c0, r1, c1),
+        "height": height,
+        "width": width,
+        "orientation": orientation,
+        "direction": RAY_DIR[orientation],
+        "lip_cells": [(r0 + dr, c0 + dc) for dr, dc in _lip_local_coords(height, width, orientation)],
+        "cavity_cells": [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)],
+    }
+
+
+def _owner_map(shape: tuple[int, int], cups: list[dict]) -> np.ndarray:
+    owner = np.full(shape, -1, dtype=int)
+    for idx, cup in enumerate(cups):
+        for r, c in cup["cells"]:
+            owner[r, c] = idx
+    return owner
+
+
+def _trace_rays(grid: np.ndarray, cups: list[dict]) -> list[dict]:
+    owner = _owner_map(grid.shape, cups)
+    enriched = []
+    for idx, cup in enumerate(cups):
+        dr, dc = cup["direction"]
+        target_ids = []
+        ray_cells = []
+        lengths = []
+        for lip_r, lip_c in cup["lip_cells"]:
+            r = lip_r + dr
+            c = lip_c + dc
+            path = []
+            hit = None
+            while 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:
+                other = int(owner[r, c])
+                if other != -1:
+                    hit = other
+                    break
+                path.append((r, c))
+                r += dr
+                c += dc
+            assert hit is not None and hit != idx, "each ray must hit exactly one opposite cup"
+            target_ids.append(hit)
+            ray_cells.extend(path)
+            lengths.append(len(path))
+        assert len(set(target_ids)) == 1, "all lip rays from a cup must point to the same target cup"
+        cup2 = dict(cup)
+        cup2["target"] = target_ids[0]
+        cup2["ray_cells"] = ray_cells
+        cup2["ray_lengths"] = lengths
+        enriched.append(cup2)
+    return enriched
+
+
+def _analyze_grid(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    components = _find_components(g)
+    assert len(components) == 4, "expected exactly four cups"
+    cups = [_identify_cup(component) for component in components]
+    return _trace_rays(g, cups)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Extend rays from each cup mouth, coloring each ray with the first opposite cup it faces.
+
+    Input structure:
+    - The grid has black background and exactly four monochrome cup shapes.
+    - Each cup is a one-cell-thick U shape or rotated U shape with an opening facing up, down, left, or right.
+    - The cups form two facing pairs separated by empty space, and each cup's opening direction points toward exactly one opposite cup.
+
+    Rule:
+    - Identify every cup's opening side from its U-shape orientation.
+    - From each mouth-edge pixel on that opening rim, extend a straight ray outward through black cells.
+    - Stop each ray one cell before the first opposite cup body it encounters, and color the whole ray with that opposite cup's color.
+    - Leave all cup pixels unchanged and keep the cavity inside every cup black.
+
+    Key insight:
+    - The ray color comes from the receiving cup, not the emitting cup, so solving requires pairing cups by direction before coloring anything.
+    """
+    g = np.asarray(grid, dtype=int)
+    cups = _analyze_grid(g)
+    planned = {}
+    for cup in cups:
+        target_color = cups[cup["target"]]["color"]
+        for cell in cup["ray_cells"]:
+            previous = planned.get(cell)
+            assert previous is None or previous == target_color, "ray colors must not conflict"
+            planned[cell] = target_color
+
+    out = g.copy()
+    for (r, c), color in planned.items():
+        out[r, c] = color
+    return out
+
+
+def _cup_dimensions(orientation: str, span: int, depth: int) -> tuple[int, int]:
+    if orientation in ("up", "down"):
+        return depth + 1, span
+    return span, depth + 1
+
+
+def _cup_cells_from_params(r0: int, c0: int, orientation: str, span: int, depth: int) -> tuple[list[tuple[int, int]], tuple[int, int, int, int]]:
+    height, width = _cup_dimensions(orientation, span, depth)
+    mask = _expected_cup_mask(height, width, orientation)
+    cells = [(r0 + r, c0 + c) for r, c in np.argwhere(mask)]
+    return cells, (r0, c0, r0 + height - 1, c0 + width - 1)
+
+
+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
+
+
+def _build_pair_template(kind: str, colors: list[int]) -> dict:
+    gap = random.randint(*PAIR_GAP_RANGE)
+    if kind == "H":
+        span = random.randint(*SPAN_RANGE)
+        left_depth = random.randint(*DEPTH_RANGE)
+        right_depth = random.randint(*DEPTH_RANGE)
+        left_height, left_width = _cup_dimensions("right", span, left_depth)
+        right_height, right_width = _cup_dimensions("left", span, right_depth)
+        assert left_height == right_height
+        return {
+            "kind": kind,
+            "box_h": left_height,
+            "box_w": left_width + gap + right_width,
+            "cups": [
+                {"orientation": "right", "span": span, "depth": left_depth, "color": colors[0], "offset": (0, 0)},
+                {"orientation": "left", "span": span, "depth": right_depth, "color": colors[1], "offset": (0, left_width + gap)},
+            ],
+        }
+    if kind == "V":
+        span = random.randint(*SPAN_RANGE)
+        top_depth = random.randint(*DEPTH_RANGE)
+        bottom_depth = random.randint(*DEPTH_RANGE)
+        top_height, top_width = _cup_dimensions("down", span, top_depth)
+        bottom_height, bottom_width = _cup_dimensions("up", span, bottom_depth)
+        assert top_width == bottom_width
+        return {
+            "kind": kind,
+            "box_h": top_height + gap + bottom_height,
+            "box_w": top_width,
+            "cups": [
+                {"orientation": "down", "span": span, "depth": top_depth, "color": colors[0], "offset": (0, 0)},
+                {"orientation": "up", "span": span, "depth": bottom_depth, "color": colors[1], "offset": (top_height + gap, 0)},
+            ],
+        }
+    raise ValueError(f"unknown pair kind: {kind}")
+
+
+def _place_template(template: dict, origin: tuple[int, int]) -> list[dict]:
+    r_base, c_base = origin
+    placed = []
+    for cup in template["cups"]:
+        dr, dc = cup["offset"]
+        cells, bbox = _cup_cells_from_params(r_base + dr, c_base + dc, cup["orientation"], cup["span"], cup["depth"])
+        placed.append(
+            {
+                "orientation": cup["orientation"],
+                "span": cup["span"],
+                "depth": cup["depth"],
+                "color": cup["color"],
+                "cells": cells,
+                "bbox": bbox,
+            }
+        )
+    return placed
+
+
+def _center_signature(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 + r1, c0 + c1
+
+
+def _validate_generated_grid(grid: np.ndarray) -> None:
+    cups = _analyze_grid(grid)
+    assert len({cup["color"] for cup in cups}) == 4
+
+    row_centers = Counter()
+    col_centers = Counter()
+    painted = {}
+    for idx, cup in enumerate(cups):
+        row_sig, col_sig = _center_signature(cup["bbox"])
+        row_centers[row_sig] += 1
+        col_centers[col_sig] += 1
+        assert cups[cup["target"]]["target"] == idx, "pairing must be reciprocal"
+        assert cups[cup["target"]]["orientation"] == OPPOSITE[cup["orientation"]]
+        assert cups[cup["target"]]["color"] != cup["color"]
+        assert all(length >= 3 for length in cup["ray_lengths"]), "pair gap must be visually non-trivial"
+        assert len(set(cup["ray_lengths"])) == 1, "parallel lip rays should stop at the same distance"
+        for cell in cup["ray_cells"]:
+            assert cell not in painted, "rays should stay visually separated"
+            painted[cell] = idx
+
+    assert max(row_centers.values()) <= 2, "no three cups may share a row alignment"
+    assert max(col_centers.values()) <= 2, "no three cups may share a column alignment"
+
+    out = main(grid)
+    assert out.shape == grid.shape
+    assert np.any(out != grid), "output must change the grid"
+    for cup in cups:
+        for r, c in cup["cavity_cells"]:
+            assert int(out[r, c]) == BACKGROUND, "cup cavities must stay black"
+
+
+def _render_grid(height: int, width: int, cups: list[dict]) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    for cup in cups:
+        for r, c in cup["cells"]:
+            assert 0 <= r < height and 0 <= c < width
+            assert grid[r, c] == BACKGROUND
+            grid[r, c] = cup["color"]
+    return grid
+
+
+def _random_origins(height: int, width: int, templates: list[dict]) -> list[tuple[int, int]] | None:
+    placed_boxes = []
+    origins = []
+    order = list(range(len(templates)))
+    random.shuffle(order)
+    for idx in order:
+        template = templates[idx]
+        candidates = []
+        for r0 in range(PAIR_MARGIN, height - template["box_h"] - PAIR_MARGIN + 1):
+            for c0 in range(PAIR_MARGIN, width - template["box_w"] - PAIR_MARGIN + 1):
+                box = (r0, c0, r0 + template["box_h"] - 1, c0 + template["box_w"] - 1)
+                if all(_boxes_separated(box, other, PAIR_BOX_GAP) for other in placed_boxes):
+                    candidates.append((r0, c0, box))
+        if not candidates:
+            return None
+        r0, c0, box = random.choice(candidates)
+        origins.append((idx, (r0, c0)))
+        placed_boxes.append(box)
+    origin_map = {idx: origin for idx, origin in origins}
+    return [origin_map[i] for i in range(len(templates))]
+
+
+def _generation_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_SIDE_RANGE)
+    width = random.randint(*GRID_SIDE_RANGE)
+    pair_kinds = random.choice([["H", "H"], ["H", "V"], ["V", "V"]])
+    colors = random.sample(PALETTE, 4)
+    templates = [
+        _build_pair_template(pair_kinds[0], colors[:2]),
+        _build_pair_template(pair_kinds[1], colors[2:]),
+    ]
+    origins = _random_origins(height, width, templates)
+    if origins is None:
+        return None
+
+    cups = []
+    for template, origin in zip(templates, origins):
+        cups.extend(_place_template(template, origin))
+    grid = _render_grid(height, width, cups)
+
+    try:
+        _validate_generated_grid(grid)
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generation_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError(f"failed to generate valid input after {MAX_GENERATION_ATTEMPTS} attempts")

