+        "color": component["color"],
+        "cells": cells,
+        "cell_set": set(cells),
+        "bbox": (r0, c0, r1, c1),
+        "height": height,
+        "width": width,
+        "orientation": orientation,
+        "direction": RAY_DIR[orientation],
+        "lip_cells": [(r0 + dr, c0 + dc) for dr, dc in _lip_local_coords(height, width, orientation)],
+        "cavity_cells": [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)],
+    }
+
+
+def _owner_map(shape: tuple[int, int], cups: list[dict]) -> np.ndarray:
+    owner = np.full(shape, -1, dtype=int)
+    for idx, cup in enumerate(cups):
+        for r, c in cup["cells"]:
+            owner[r, c] = idx
+    return owner
+
+
+def _trace_rays(grid: np.ndarray, cups: list[dict]) -> list[dict]:
+    owner = _owner_map(grid.shape, cups)
+    enriched = []
+    for idx, cup in enumerate(cups):
+        dr, dc = cup["direction"]
+        target_ids = []
+        ray_cells = []
+        lengths = []
+        for lip_r, lip_c in cup["lip_cells"]:
+            r = lip_r + dr
+            c = lip_c + dc
+            path = []
+            hit = None
+            while 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:
+                other = int(owner[r, c])
+                if other != -1:
+                    hit = other
+                    break
+                path.append((r, c))
+                r += dr
+                c += dc
+            assert hit is not None and hit != idx, "each ray must hit exactly one opposite cup"
+            target_ids.append(hit)
+            ray_cells.extend(path)
+            lengths.append(len(path))
+        assert len(set(target_ids)) == 1, "all lip rays from a cup must point to the same target cup"
+        cup2 = dict(cup)
+        cup2["target"] = target_ids[0]
+        cup2["ray_cells"] = ray_cells
+        cup2["ray_lengths"] = lengths
+        enriched.append(cup2)
+    return enriched
+
+
+def _analyze_grid(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    components = _find_components(g)
+    assert len(components) == 4, "expected exactly four cups"
+    cups = [_identify_cup(component) for component in components]
+    return _trace_rays(g, cups)
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """Extend rays from each cup mouth, coloring each ray with the first opposite cup it faces.
+
+    Input structure:
+    - The grid has black background and exactly four monochrome cup shapes.
+    - Each cup is a one-cell-thick U shape or rotated U shape with an opening facing up, down, left, or right.
+    - The cups form two facing pairs separated by empty space, and each cup's opening direction points toward exactly one opposite cup.
+
+    Rule:
+    - Identify every cup's opening side from its U-shape orientation.
+    - From each mouth-edge pixel on that opening rim, extend a straight ray outward through black cells.
+    - Stop each ray one cell before the first opposite cup body it encounters, and color the whole ray with that opposite cup's color.
+    - Leave all cup pixels unchanged and keep the cavity inside every cup black.
+
+    Key insight:
+    - The ray color comes from the receiving cup, not the emitting cup, so solving requires pairing cups by direction before coloring anything.
+    """
+    g = np.asarray(grid, dtype=int)
+    cups = _analyze_grid(g)
+    planned = {}
+    for cup in cups:
+        target_color = cups[cup["target"]]["color"]
+        for cell in cup["ray_cells"]:
+            previous = planned.get(cell)
+            assert previous is None or previous == target_color, "ray colors must not conflict"
+            planned[cell] = target_color
+
+    out = g.copy()
+    for (r, c), color in planned.items():
+        out[r, c] = color
+    return out
+
+
+def _cup_dimensions(orientation: str, span: int, depth: int) -> tuple[int, int]:
+    if orientation in ("up", "down"):
+        return depth + 1, span
+    return span, depth + 1
+
+
+def _cup_cells_from_params(r0: int, c0: int, orientation: str, span: int, depth: int) -> tuple[list[tuple[int, int]], tuple[int, int, int, int]]:
+    height, width = _cup_dimensions(orientation, span, depth)
+    mask = _expected_cup_mask(height, width, orientation)
+    cells = [(r0 + r, c0 + c) for r, c in np.argwhere(mask)]
+    return cells, (r0, c0, r0 + height - 1, c0 + width - 1)
+
+
+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
+
+
+def _build_pair_template(kind: str, colors: list[int]) -> dict:
+    gap = random.randint(*PAIR_GAP_RANGE)
+    if kind == "H":
+        span = random.randint(*SPAN_RANGE)
+        left_depth = random.randint(*DEPTH_RANGE)
+        right_depth = random.randint(*DEPTH_RANGE)
+        left_height, left_width = _cup_dimensions("right", span, left_depth)
+        right_height, right_width = _cup_dimensions("left", span, right_depth)
+        assert left_height == right_height
+        return {
+            "kind": kind,
+            "box_h": left_height,
+            "box_w": left_width + gap + right_width,
+            "cups": [
+                {"orientation": "right", "span": span, "depth": left_depth, "color": colors[0], "offset": (0, 0)},
+                {"orientation": "left", "span": span, "depth": right_depth, "color": colors[1], "offset": (0, left_width + gap)},
+            ],
+        }
+    if kind == "V":
+        span = random.randint(*SPAN_RANGE)
+        top_depth = random.randint(*DEPTH_RANGE)
+        bottom_depth = random.randint(*DEPTH_RANGE)
+        top_height, top_width = _cup_dimensions("down", span, top_depth)
+        bottom_height, bottom_width = _cup_dimensions("up", span, bottom_depth)
+        assert top_width == bottom_width
+        return {
+            "kind": kind,
+            "box_h": top_height + gap + bottom_height,
+            "box_w": top_width,
+            "cups": [
+                {"orientation": "down", "span": span, "depth": top_depth, "color": colors[0], "offset": (0, 0)},
+                {"orientation": "up", "span": span, "depth": bottom_depth, "color": colors[1], "offset": (top_height + gap, 0)},
+            ],
+        }
