+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+PALETTE = (1, 2, 3, 4)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
