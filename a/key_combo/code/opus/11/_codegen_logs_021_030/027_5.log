0051:     cup_width = _r1 - cup_r + 1
0052:     cup_height = _c1 - cup_c + 1
0053:     inside_cup_mask = np.zeros_like(input_grid, dtype=bool)
0054:     inside_cup_mask[cup_r:cup_r+cup_width, cup_c:cup_c+cup_height] = True
0055:     inside_cup_mask = inside_cup_mask & (obj == Color.BLACK)
0056: 
0057:     # 3. Extract the hole in the cup, which is what's inside and on the boundary of the bounding box
0058:     # what's inside...
0059:     hole_mask = inside_cup_mask.copy()
0060:     # ...and then we need to remove anything not on the boundary
0061:     hole_mask[cup_r+1 : cup_r+cup_width-1, cup_c+1 : cup_c+cup_height-1] = False
0062: 
0063:     # 4. Fill the cup with yellow
0064:     output_grid[inside_cup_mask] = Color.YELLOW
0065: 
0066:     # 5. Shoot pixels outward from the opening (straight out)
0067:     # Find the direction of the opening, which is the unit vector that points from the center of the cup to the hole
0068:     _b = bbox(hole_mask != Color.BLACK)
0069:     assert _b is not None
