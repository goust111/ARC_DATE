+        (cr - dc, cc + dr),
+        (cr - dr, cc - dc),
+        (cr + dc, cc - dr),
+    )
+    assert len(set(orbit)) == 4, "non-center ring cells must have 4-point quarter-turn orbits"
+    return orbit
