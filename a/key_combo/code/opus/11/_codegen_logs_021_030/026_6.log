+        row = int(row)
+        col = int(col)
+        dist = _chebyshev((row, col), center)
+        expected = _ring_color(dist)
+        orbit = _rotation_orbit(center, (row, col))
+        visible_support = 0
+        for rr, cc in orbit:
+            color = int(g[rr, cc])
+            if color in (RED, BLUE):
+                assert color == expected, "visible orbit mates must agree with the damaged ring color"
+                visible_support += 1
