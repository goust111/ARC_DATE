+        return None
+
+    holes = _choose_hole_positions(visible_orbits, center)
+    for r, c in holes:
+        grid[r, c] = HOLE
+
+    try:
+        out = main(grid)
+    except Exception:
+        return None
+    if not np.array_equal(out, _full_pattern(grid.shape, center)):
+        return None
+    if not _nondegenerate(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
