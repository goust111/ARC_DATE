+    orbits_by_ring: dict[int, list[tuple[tuple[int, int], ...]]] = {d: [] for d in range(1, MAX_RING + 1)}
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    for r in range(shape[0]):
+        for c in range(shape[1]):
