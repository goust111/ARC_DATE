+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+HOLE = 6
+MAX_RING = 4
+GEN_ATTEMPTS = 400
+GEN_SIZES = (9, 11, 13)
+
+
+def _chebyshev(a: tuple[int, int], b: tuple[int, int]) -> int:
+    return max(abs(int(a[0]) - int(b[0])), abs(int(a[1]) - int(b[1])))
+
+
