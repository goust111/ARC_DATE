+            col_hi = col_bounds[j + 1] - 1
+            if col_lo > col_hi:
+                continue
+            left_margin = 1 if j > 0 else 0
+            right_margin = 1 if j < len(col_bounds) - 2 else 0
+            left_start = col_lo + left_margin
+            left_end = col_hi - right_margin - shape_w + 1
+            if left_start > left_end:
+                continue
