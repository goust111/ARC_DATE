+                (r, c)
+                for r, c in frontier
+                if 0 <= r < h and 0 <= c < w and not mask[r, c]
+            ]
+            if not valid_frontier:
+                break
+            cell = random.choice(valid_frontier)
+            mask[cell] = True
+            frontier.discard(cell)
