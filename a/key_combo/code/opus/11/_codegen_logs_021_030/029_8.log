+        if not _connected(blue_mask):
+            return False
+
+        out = main(g)
+        if out.shape != g.shape:
+            return False
+        if not np.array_equal(out[g == BLUE], np.full(blue_count, BLUE, dtype=int)):
+            return False
+        if int(out[center]) != RED:
