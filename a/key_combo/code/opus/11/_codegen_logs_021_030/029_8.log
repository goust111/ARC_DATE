+            if not _in_bounds(g.shape, *mate) or not recovered[mate]:
+                return False
+        if int(recovered.sum()) != blue_count + len(actual_green):
+            return False
+        if not _connected(recovered):
+            return False
+        if not np.array_equal(out[(g != BLACK)], g[(g != BLACK)]):
