+
+        expected_green: set[tuple[int, int]] = set()
+        paired_blue_blue = 0
+        for r, c in np.argwhere(g == BLUE):
+            cell = (int(r), int(c))
+            mate = _mirror(center, cell)
+            if not _in_bounds(g.shape, *mate):
