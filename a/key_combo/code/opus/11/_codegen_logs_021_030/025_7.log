+    dst_r0 = int(np.floor(center_r - (h2 - 1) / 2.0 + 1e-9))
+    dst_c0 = int(np.floor(center_c - (w2 - 1) / 2.0 + 1e-9))
+    dst_r1 = dst_r0 + h2
+    dst_c1 = dst_c0 + w2
+    assert 0 <= dst_r0 and dst_r1 <= out_mask.shape[0]
+    assert 0 <= dst_c0 and dst_c1 <= out_mask.shape[1]
