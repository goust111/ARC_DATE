+            grid[int(r), 0] = GUIDE
+            grid[int(r), w - 1] = GUIDE
+        else:
+            c = rec["guide_abs"]
+            grid[0, int(c)] = GUIDE
+            grid[h - 1, int(c)] = GUIDE
