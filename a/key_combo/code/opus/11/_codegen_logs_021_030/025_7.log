+        return []
+    mid_r0 = max(1, h // 3 - 1)
+    mid_r1 = max(mid_r0, min(r_max, (2 * h) // 3 - obj_h))
+    mid_c0 = max(1, w // 3 - 1)
+    mid_c1 = max(mid_c0, min(c_max, (2 * w) // 3 - obj_w))
+    left_c1 = max(1, min(c_max, w // 4))
+    right_c0 = min(c_max, max(1, w - obj_w - 1 - w // 4))
