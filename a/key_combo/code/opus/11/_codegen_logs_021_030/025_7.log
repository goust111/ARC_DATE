+BG = 5
+OBJ = 1
+GUIDE = 2
+
+BRANCHES = ("left", "right", "top", "bottom")
+HORIZONTAL_BRANCHES = {"left", "right"}
+VERTICAL_BRANCHES = {"top", "bottom"}
