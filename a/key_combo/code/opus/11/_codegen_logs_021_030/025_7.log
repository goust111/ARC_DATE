+def _full_bbox(mask: np.ndarray) -> bool:
+    rows = np.where(mask.any(axis=1))[0]
+    cols = np.where(mask.any(axis=0))[0]
+    return (
+        rows.size > 0
+        and cols.size > 0
+        and rows[0] == 0
+        and rows[-1] == mask.shape[0] - 1
+        and cols[0] == 0
+        and cols[-1] == mask.shape[1] - 1
