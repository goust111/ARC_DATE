+        "bbox_cells": bbox_cells,
+        "bbox_margin_cells": bbox_margin_cells,
+        "size": int(size),
+        "diagonal": int(diagonal),
+        "area": int(2 * size * size),
+        "red_origins": red_origins,
+        "target_origins": target_origins,
+        "target_cells": target_cells,
+        "clipped": clipped,
+    }
