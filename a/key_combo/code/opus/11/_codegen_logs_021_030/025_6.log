+    clipped = False
+    target_cells: set[tuple[int, int]] = set()
+    for tr, tc in target_origins:
+        vis = _rect_cells(tr, tc, size, size, draw_h, width)
+        if not vis:
+            return None
+        target_cells |= vis
+        if tr < 0 or tc < 0 or tr + size > draw_h or tc + size > int(width):
+            clipped = True
