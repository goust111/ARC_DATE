+        objects.append(
+            {
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "size": size,
+                "area": area,
+                "diagonal": diagonal,
+                "target_origins": target_origins,
+                "target_cells": target_cells,
+            }
