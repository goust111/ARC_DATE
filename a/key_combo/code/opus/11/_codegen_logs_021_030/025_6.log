+    if candidate["bbox_margin_cells"] & state["bbox_cells"]:
+        return False
+    if candidate["bbox_cells"] & state["target_cells"]:
+        return False
+    if candidate["target_cells"] & state["bbox_margin_cells"]:
+        return False
+    if candidate["target_cells"] & state["target_cells"]:
