+        size = h // 2
+        sub = g[r0 : r1 + 1, c0 : c1 + 1]
+
+        occupied: set[tuple[int, int]] = set()
+        for br in range(2):
+            for bc in range(2):
+                block = sub[br * size : (br + 1) * size, bc * size : (bc + 1) * size]
+                if np.all(block == OBJECT):
+                    occupied.add((br, bc))
+                else:
+                    assert np.all(block == BACKGROUND), "only two diagonal blocks may be red"
+
