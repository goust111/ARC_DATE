+    bbox_cells = _rect_cells(r0, c0, 2 * size, 2 * size, draw_h, width)
+    bbox_margin_cells = _rect_cells(r0 - 1, c0 - 1, 2 * size + 2, 2 * size + 2, draw_h, width)
+    target_origins = _target_origins(r0, c0, size, diagonal)
