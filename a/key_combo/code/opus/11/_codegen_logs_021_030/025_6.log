+
+
+def _candidate_positions(height: int, width: int, size: int, diagonal: int, require_clip: bool | None) -> list[dict]:
+    options: list[dict] = []
+    max_r0 = int(height) - 1 - 2 * int(size)
+    max_c0 = int(width) - 2 * int(size)
