+    ar0, ac0, ar1, ac1 = anchor_bbox
+    if side == "left":
+        return {(ar0 + start + i, ac0 - 1) for i in range(k)}
+    if side == "right":
+        return {(ar0 + start + i, ac1 + 1) for i in range(k)}
+    if side == "up":
+        return {(ar0 - 1, ac0 + start + i) for i in range(k)}
+    return {(ar1 + 1, ac0 + start + i) for i in range(k)}
