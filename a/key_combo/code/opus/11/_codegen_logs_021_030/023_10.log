+                break
+        if not good:
+            continue
+        moved_all = [
+            _translate_cells(
+                obj["cells"],
+                0 if obj["side"] in ("left", "right") else (-1 if obj["side"] == "up" else 1),
+                (-1 if obj["side"] == "left" else 1) if obj["side"] in ("left", "right") else 0,
+                gap_vals[i],
