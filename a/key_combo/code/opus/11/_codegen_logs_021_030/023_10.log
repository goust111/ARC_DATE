+    settled: list[dict[str, object]] = []
+    occupied: set[tuple[int, int]] = set()
+    for side, start, k in sorted(zip(sides, starts, contacts), key=lambda x: (-x[2], x[0])):
+        cells = _generate_settled_shape((h, w), anchor_bbox, side, start, k, occupied)
