+        return c != ac1 + 1 or (r, c) in contact_cells
+    if side == "up":
+        if r > ar0 - 1 or ar0 - 1 - r > 3 or c < ac0 - 2 or c > ac1 + 2:
+            return False
+        return r != ar0 - 1 or (r, c) in contact_cells
+    if r < ar1 + 1 or r - (ar1 + 1) > 3 or c < ac0 - 2 or c > ac1 + 2:
