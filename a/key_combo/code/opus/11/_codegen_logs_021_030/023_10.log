+        others = [set().union(*(moved_all[:i] + moved_all[i + 1 :])) for i in range(len(moved_all))]
+        valid = True
+        for i, obj in enumerate(settled):
+            step_dr = int(obj["dr"])
+            step_dc = int(obj["dc"])
+            gap = gap_vals[i]
+            current = moved_all[i]
+            for step in range(1, gap + 1):
+                mid = _translate_cells(current, step_dr, step_dc, step)
+                if mid & others[i]:
