+            side = "up"
+            shift = ar0 - 1 - max(r for r, c in cell_set if c in col_overlap)
+            dr, dc = 1, 0
+        else:
+            assert min(rows) > ar1, "vertical-aligned object must lie strictly above or below anchor"
