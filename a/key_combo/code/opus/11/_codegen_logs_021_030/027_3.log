+    moved_left = any(final_cols[obj.color] < obj.c0 for obj in objects if obj.symmetric)
+    moved_right = any(final_cols[obj.color] > obj.c0 for obj in objects if not obj.symmetric)
+    if not (moved_left and moved_right):
