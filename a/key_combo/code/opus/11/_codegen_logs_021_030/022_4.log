+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h < 2 or w < 2:
+            continue
+        if area == h * w:
+            continue
+
+        degrees = []
+        cell_set = {tuple(map(int, xy)) for xy in coords}
+        for r, c in cell_set:
+            deg = sum((r + dr, c + dc) in cell_set for dr, dc in DIRS4)
+            degrees.append(deg)
+        if max(degrees) < 2 or min(degrees) > 2:
+            continue
+        if h > 5 or w > 5:
+            continue
+        return coords
