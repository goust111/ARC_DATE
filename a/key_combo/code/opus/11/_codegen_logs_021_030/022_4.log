+    mask[shifted[:, 0], shifted[:, 1]] = 1
+    return mask
+
+
+def _coords_from_mask(mask: np.ndarray) -> np.ndarray:
+    return np.argwhere(mask > 0).astype(int)
+
+
+def _random_polyomino(area: int) -> np.ndarray:
