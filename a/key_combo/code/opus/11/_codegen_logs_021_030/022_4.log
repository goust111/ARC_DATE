+    raise RuntimeError("failed to sample scattered points")
+
+
+def _sample_block(count: int, role: str, shape_h: int, shape_w: int, clip_mode: bool) -> np.ndarray:
+    assert count in (3, 4)
+    orientations = []
+    if count == 4:
