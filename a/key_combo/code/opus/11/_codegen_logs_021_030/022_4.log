+def _place_shape(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = _bbox_coords(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    margin_mode = random.random()
+    if margin_mode < 0.35:
