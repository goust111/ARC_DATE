+    shape = (random.randint(18, 24), random.randint(18, 24))
+    num_cups = 2 if random.random() < 0.65 else 3
+
+    sides = random.sample(("top", "bottom", "left", "right"), num_cups)
+    if num_cups == 2 and random.random() < 0.7:
