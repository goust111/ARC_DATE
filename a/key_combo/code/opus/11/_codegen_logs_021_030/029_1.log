+    for r, c in cells:
+        for dr in range(-radius, radius + 1):
+            for dc in range(-radius, radius + 1):
+                rr = r + dr
+                cc = c + dc
+                if _in_bounds(shape, rr, cc):
+                    expanded.add((rr, cc))
