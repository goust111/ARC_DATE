+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+CUP = 5
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+SIDE_TO_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if (
+                        _in_bounds((h, w), nr, nc)
+                        and not seen[nr, nc]
+                        and int(grid[nr, nc]) == color
+                    ):
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _perimeter_cells(bbox: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    cells: list[tuple[int, int]] = []
+    for c in range(c0, c1 + 1):
+        cells.append((r0, c))
+        cells.append((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.append((r, c0))
+        cells.append((r, c1))
+    return cells
+
+
+def _side_cells(
+    bbox: tuple[int, int, int, int], side: str, *, include_corners: bool = False
+) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = bbox
+    if side == "top":
+        cols = range(c0, c1 + 1) if include_corners else range(c0 + 1, c1)
+        return [(r0, c) for c in cols]
+    if side == "bottom":
+        cols = range(c0, c1 + 1) if include_corners else range(c0 + 1, c1)
+        return [(r1, c) for c in cols]
+    if side == "left":
+        rows = range(r0, r1 + 1) if include_corners else range(r0 + 1, r1)
+        return [(r, c0) for r in rows]
+    rows = range(r0, r1 + 1) if include_corners else range(r0 + 1, r1)
+    return [(r, c1) for r in rows]
+
+
+def _is_contiguous_gap(cells: list[tuple[int, int]], side: str) -> bool:
+    if not cells:
+        return False
+    if side in ("top", "bottom"):
+        idxs = sorted(c for _, c in cells)
+    else:
+        idxs = sorted(r for r, _ in cells)
+    return idxs == list(range(idxs[0], idxs[-1] + 1))
+
