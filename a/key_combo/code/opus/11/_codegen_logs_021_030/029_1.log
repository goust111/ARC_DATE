+            "opening_side": side,
+            "direction": (dr, dc),
+            "gap_cells": sorted(gap_cells),
+            "gap_len": gap_len,
+            "bbox_cells": bbox_cells,
+            "ray_cells": ray_cells,
+            "reserve": reserve,
+            "interior_painted": painted,
+            "counts": counts,
+            "ray_color": unique_color,
