+    assert cups, "expected at least one cup"
+    return cups
+
+
+def _ray_cells(
+    shape: tuple[int, int], start: tuple[int, int], direction: tuple[int, int], length: int
+) -> list[tuple[int, int]]:
+    cells: list[tuple[int, int]] = []
+    r, c = start
+    dr, dc = direction
+    for _ in range(length):
+        if not _in_bounds(shape, r, c):
