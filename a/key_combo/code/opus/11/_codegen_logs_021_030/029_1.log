+                "bbox": bbox,
+                "opening_side": side,
+                "gap_cells": gap_cells,
+                "direction": SIDE_TO_DIR[side],
+                "ray_color": ray_color,
+                "ray_len": ray_len,
+                "color_counts": color_counts,
