+        size_b = rng.randint(3, 6)
+        inp_a = _grow_toward_target(tip_a, dom_a, target, size_a, rng)
+        inp_b = _grow_toward_target(tip_b, dom_b, target, size_b, rng)
+        if inp_a is None or inp_b is None:
