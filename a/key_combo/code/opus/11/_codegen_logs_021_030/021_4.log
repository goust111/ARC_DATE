+        (mr, mc),
+        (mr - 1, mc),
+        (mr + 1, mc),
+        (mr, mc - 1),
+        (mr, mc + 1),
+    }
+
+
+_GENERIC_TEMPLATES = {
+    "up": [
+        {(0, 0), (-1, 0), (-2, 0)},
+        {(0, 0), (-1, 0), (-1, -1)},
+        {(0, 0), (-1, 0), (-1, 1), (-2, 1)},
+        {(0, 0), (0, -1), (-1, -1), (-2, -1)},
+    ],
+    "down": [
+        {(0, 0), (1, 0), (2, 0)},
+        {(0, 0), (1, 0), (1, -1)},
+        {(0, 0), (1, 0), (1, 1), (2, 1)},
+        {(0, 0), (0, -1), (1, -1), (2, -1)},
+    ],
+    "left": [
+        {(0, 0), (0, -1), (0, -2)},
+        {(0, 0), (0, -1), (-1, -1)},
+        {(0, 0), (0, -1), (1, -1), (1, -2)},
+        {(0, 0), (-1, 0), (-1, -1), (-2, -1)},
+    ],
+    "right": [
+        {(0, 0), (0, 1), (0, 2)},
+        {(0, 0), (0, 1), (-1, 1)},
+        {(0, 0), (0, 1), (1, 1), (1, 2)},
+        {(0, 0), (-1, 0), (-1, 1), (-2, 1)},
+    ],
+}
