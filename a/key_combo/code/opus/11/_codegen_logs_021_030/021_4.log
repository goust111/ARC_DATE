+        key = lambda obj: (obj["distance"], -obj["top"], obj["left"], obj["color"])
+    else:
+        key = lambda obj: (-obj["distance"], obj["top"], obj["left"], obj["color"])
+    return _render(shape, marker_cells, objects, key)
+
+
+def _validate_instance(grid: np.ndarray) -> None:
