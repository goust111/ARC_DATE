+    return ra - (mr + 2), cb - (mc + 2)
+
+
+def _pair_sides(mode: str) -> tuple[str, str]:
+    if mode == "TL":
+        return "up", "left"
+    if mode == "TR":
+        return "up", "right"
+    if mode == "BL":
+        return "down", "left"
+    return "down", "right"
+
+
+def _grow_toward_target(
+    seed: tuple[int, int],
