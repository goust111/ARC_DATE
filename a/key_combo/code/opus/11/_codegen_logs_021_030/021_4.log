+def _place_generic_object(
+    side: str,
+    mr: int,
+    mc: int,
+    h: int,
+    w: int,
+    marker_cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    rng: random.Random,
+) -> set[tuple[int, int]] | None:
