+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    mode = rng.choices(["TL", "BL", "TR", "BR"], weights=[4, 4, 2, 2])[0]
+    h = rng.randint(10, 12)
+    w = rng.randint(10, 12)
+    if mode in ("TL", "TR"):
+        mr = rng.randint(4, 5)
+    else:
+        mr = h - rng.randint(4, 5)
+    if mode in ("TL", "BL"):
+        mc = rng.randint(4, 5)
+    else:
+        mc = w - 1 - rng.randint(4, 5)
+    if not (2 <= mr <= h - 3 and 2 <= mc <= w - 3):
+        return None
+    marker_cells = _marker_cross(mr, mc)
+    want_tie = rng.random() < 0.4
+    pair = None
+    for candidate in _make_overlap_pair(mode, h, w, mr, mc, want_tie, rng):
+        occupied = set(marker_cells)
+        ok = True
+        for cells in candidate.values():
+            if cells & occupied:
+                ok = False
+                break
+            occupied |= cells
+        if ok:
+            pair = candidate
