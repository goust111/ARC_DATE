+            if (nr, nc) not in marker_cells:
+                continue
+            if r == nr - 1:
+                sides.add("up")
+            elif r == nr + 1:
+                sides.add("down")
+            elif c == nc - 1:
+                sides.add("left")
+            elif c == nc + 1:
