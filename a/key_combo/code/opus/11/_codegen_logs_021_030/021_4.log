+        dom_b = {(r, c) for r in range(mr, h) for c in range(0, mc - 1)}
+    else:
+        target = (h - 1, w - 1)
+        tip_a = (mr + 2, mc)
+        tip_b = (mr, mc + 2)
+        dom_a = {(r, c) for r in range(mr + 2, h) for c in range(mc, w)}
+        dom_b = {(r, c) for r in range(mr, h) for c in range(mc + 2, w)}
