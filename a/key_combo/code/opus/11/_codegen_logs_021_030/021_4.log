+    expected = {
+        center,
+        (center[0] - 1, center[1]),
+        (center[0] + 1, center[1]),
+        (center[0], center[1] - 1),
+        (center[0], center[1] + 1),
+    }
+    assert marker_cells == expected, "marker must be a small cross"
+    return center, marker_cells
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = set()
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (BG, MARKER) or (r, c) in seen:
+                continue
+            q = deque([(r, c)])
+            seen.add((r, c))
+            cells = set()
+            while q:
+                rr, cc = q.popleft()
+                cells.add((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and int(grid[nr, nc]) == color:
