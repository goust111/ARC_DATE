+def _marker_cross(mr: int, mc: int) -> set[tuple[int, int]]:
+    return {
+        (mr, mc),
+        (mr - 1, mc),
+        (mr + 1, mc),
+        (mr, mc - 1),
+        (mr, mc + 1),
+    }
+
+
+_GENERIC_TEMPLATES = {
