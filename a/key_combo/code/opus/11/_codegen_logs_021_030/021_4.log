+    expected = {
+        center,
+        (center[0] - 1, center[1]),
+        (center[0] + 1, center[1]),
+        (center[0], center[1] - 1),
+        (center[0], center[1] + 1),
+    }
+    assert marker_cells == expected, "marker must be a small cross"
+    return center, marker_cells
