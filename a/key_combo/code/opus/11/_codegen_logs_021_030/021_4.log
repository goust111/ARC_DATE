+    path = {(r, c)}
+    for dr, dc in steps:
+        r += dr
+        c += dc
+        path.add((r, c))
+    return path
+
+
+def _grow_shape(
+    base: set[tuple[int, int]],
+    domain: set[tuple[int, int]],
