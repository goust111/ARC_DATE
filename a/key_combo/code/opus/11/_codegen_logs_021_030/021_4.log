+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    mode = rng.choices(["TL", "BL", "TR", "BR"], weights=[4, 4, 2, 2])[0]
+    h = rng.randint(10, 12)
+    w = rng.randint(10, 12)
