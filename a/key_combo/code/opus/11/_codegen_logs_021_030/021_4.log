+BG = 0
+MARKER = 9
+OBJECT_COLORS = (1, 2, 3, 4)
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_DIR = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
