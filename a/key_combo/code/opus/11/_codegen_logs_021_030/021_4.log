+def _random_shortest_path(start: tuple[int, int], end: tuple[int, int], rng: random.Random) -> set[tuple[int, int]]:
+    r, c = start
+    er, ec = end
+    steps = []
+    if er > r:
+        steps.extend([(1, 0)] * (er - r))
+    else:
+        steps.extend([(-1, 0)] * (r - er))
+    if ec > c:
+        steps.extend([(0, 1)] * (ec - c))
+    else:
+        steps.extend([(0, -1)] * (c - ec))
+    rng.shuffle(steps)
+    path = {(r, c)}
+    for dr, dc in steps:
+        r += dr
+        c += dc
+        path.add((r, c))
+    return path
