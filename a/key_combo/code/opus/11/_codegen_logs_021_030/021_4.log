+    if side == "down":
+        return mr + 2, mc
+    if side == "left":
+        return mr, mc - 2
+    return mr, mc + 2
+
+
+def _place_generic_object(
+    side: str,
+    mr: int,
+    mc: int,
+    h: int,
+    w: int,
+    marker_cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    rng: random.Random,
