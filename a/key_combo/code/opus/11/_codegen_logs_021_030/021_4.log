from itertools import combinations
from collections import deque

def neighbors4(cell):
    r,c=cell
    for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        yield (r+dr,c+dc)

def connected(shape):
    s=set(shape)
    q=deque([next(iter(s))]); vis={next(iter(s))}
    while q:
        p=q.popleft()
        for n in neighbors4(p):
            if n in s and n not in vis:
                vis.add(n); q.append(n)
    return len(vis)==len(s)

def classify(shape, marker):
    sides=set()
    for r,c in shape:
        for nr,nc in neighbors4((r,c)):
            if (nr,nc) in marker:
                if r==nr-1: sides.add('up')
                elif r==nr+1: sides.add('down')
                elif c==nc-1: sides.add('left')
                elif c==nc+1: sides.add('right')
    return sides

def bbox(shape):
    rs=[r for r,_ in shape]; cs=[c for _,c in shape]
    return min(rs),min(cs),max(rs),max(cs)

def push(shape, side, H,W):
    r0,c0,r1,c1=bbox(shape)
    if side=='up': d=r0; return d,{(r-d,c) for r,c in shape}
    if side=='down': d=H-1-r1; return d,{(r+d,c) for r,c in shape}
    if side=='left': d=c0; return d,{(r,c-d) for r,c in shape}
    d=W-1-c1; return d,{(r,c+d) for r,c in shape}

for mode in ['BL','BR']:
  for H in [8,9,10]:
    W=H
    for mr in range(2,H-2):
      mc = 3 if mode=='BL' else W-4
      if mr+2>=H or mc-2<0 or (mode=='BR' and mc+2>=W):
        continue
      marker={(mr,mc),(mr-1,mc),(mr+1,mc),(mr,mc-1),(mr,mc+1)}
      if mode=='BL':
        domA=[(r,c) for r in range(mr+2,H) for c in range(0,mc+1)]
        domB=[(r,c) for r in range(mr,H) for c in range(0,mc-1)]
        tipA=(mr+2,mc); tipB=(mr,mc-2); sideA='down'; sideB='left'
      else:
        domA=[(r,c) for r in range(mr+2,H) for c in range(mc,W)]
        domB=[(r,c) for r in range(mr,H) for c in range(mc+2,W)]
        tipA=(mr+2,mc); tipB=(mr,mc+2); sideA='down'; sideB='right'
      validA=[]; validB=[]
      for k in range(3,7):
        for combo in combinations(domA,k):
          s=set(combo)
          if tipA not in s or s & marker or not connected(s) or classify(s,marker)"'!={sideA}: continue
          d,f=push(s,sideA,H,W)
          validA.append((s,d,f))
        for combo in combinations(domB,k):
          s=set(combo)
          if tipB not in s or s & marker or not connected(s) or classify(s,marker)!={sideB}: continue
          d,f=push(s,sideB,H,W)
          validB.append((s,d,f))
      print('"'checking',mode,H,mr,'counts',len(validA),len(validB))
      for sA,dA,fA in validA:
        for sB,dB,fB in validB:
          if sA & sB: continue
          if dA"'!=dB: continue
          if fA & fB:
            print('"'FOUND',mode,H,mr,mc,dA,sA,sB,fA&fB)
            raise SystemExit
print('NONE')
