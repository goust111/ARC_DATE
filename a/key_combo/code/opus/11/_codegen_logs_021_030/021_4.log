+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = set()
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (BG, MARKER) or (r, c) in seen:
+                continue
