+    return next(iter(sides))
+
+
+def _push_to_boundary(cells: set[tuple[int, int]], side: str, shape: tuple[int, int]) -> tuple[int, set[tuple[int, int]]]:
+    h, w = shape
+    r0, c0, r1, c1 = _bbox(cells)
