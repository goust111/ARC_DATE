+    return comps
+
+
+def _classify_side(cells: set[tuple[int, int]], marker_cells: set[tuple[int, int]]) -> str:
+    sides = set()
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) not in marker_cells:
+                continue
+            if r == nr - 1:
+                sides.add("up")
+            elif r == nr + 1:
+                sides.add("down")
+            elif c == nc - 1:
+                sides.add("left")
+            elif c == nc + 1:
+                sides.add("right")
