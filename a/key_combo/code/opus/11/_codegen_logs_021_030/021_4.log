+
+def _marker_cross(mr: int, mc: int) -> set[tuple[int, int]]:
+    return {
+        (mr, mc),
+        (mr - 1, mc),
+        (mr + 1, mc),
+        (mr, mc - 1),
+        (mr, mc + 1),
+    }
+
+
+_GENERIC_TEMPLATES = {
+    "up": [
+        {(0, 0), (-1, 0), (-2, 0)},
+        {(0, 0), (-1, 0), (-1, -1)},
+        {(0, 0), (-1, 0), (-1, 1), (-2, 1)},
+        {(0, 0), (0, -1), (-1, -1), (-2, -1)},
+    ],
+    "down": [
+        {(0, 0), (1, 0), (2, 0)},
+        {(0, 0), (1, 0), (1, -1)},
+        {(0, 0), (1, 0), (1, 1), (2, 1)},
+        {(0, 0), (0, -1), (1, -1), (2, -1)},
+    ],
+    "left": [
+        {(0, 0), (0, -1), (0, -2)},
+        {(0, 0), (0, -1), (-1, -1)},
+        {(0, 0), (0, -1), (1, -1), (1, -2)},
+        {(0, 0), (-1, 0), (-1, -1), (-2, -1)},
+    ],
+    "right": [
+        {(0, 0), (0, 1), (0, 2)},
+        {(0, 0), (0, 1), (-1, 1)},
+        {(0, 0), (0, 1), (1, 1), (1, 2)},
+        {(0, 0), (-1, 0), (-1, 1), (-2, 1)},
+    ],
+}
+
+
+def _contact_tip(side: str, mr: int, mc: int) -> tuple[int, int]:
+    if side == "up":
+        return mr - 2, mc
+    if side == "down":
+        return mr + 2, mc
+    if side == "left":
+        return mr, mc - 2
+    return mr, mc + 2
+
+
+def _place_generic_object(
+    side: str,
+    mr: int,
+    mc: int,
+    h: int,
+    w: int,
+    marker_cells: set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    rng: random.Random,
+) -> set[tuple[int, int]] | None:
+    tip = _contact_tip(side, mr, mc)
+    templates = _GENERIC_TEMPLATES[side][:]
+    rng.shuffle(templates)
+    for template in templates:
+        cells = {(tip[0] + dr, tip[1] + dc) for dr, dc in template}
