spec:
  colors: 3 distinct — background (most common), lattice_color, marker_color
  grid: 17-22 rows x 20-22 cols
  lattice:
    type: single-pixel-thick regular grid of lattice_color lines
    horizontal_lines: 3-4, evenly spaced (gap 4-5 cells between lines)
    vertical_lines: 4-5, evenly spaced (same gap as horizontal)
    cell_size: 3x3 or 4x4 (always square, = gap between lines)
    first_line_offset: equals cell_size (one full cell band before first line)
    lines_are_complete: every pixel on a lattice line is lattice_color except the 4 holes
  holes:
    count: exactly 4, at lattice intersections, forming axis-aligned rectangle corners
    value: background color (makes them detectable as missing intersection pixels)
    rectangle_span: 1-2 lattice-line steps in each dimension (not necessarily same)
  markers:
