+    if rows_over_cols:
+        for c, color in sorted(col_colors.items()):
+            out[:, c] = int(color)
+        for r, color in sorted(row_colors.items()):
+            out[r, :] = int(color)
+    else:
+        for r, color in sorted(row_colors.items()):
+            out[r, :] = int(color)
+        for c, color in sorted(col_colors.items()):
