+    rng.shuffle(col_order)
+    for col in col_order:
+        color = colors[cols.index(col)]
+        starts = []
+        for r0 in range(height - 1):
+            cells = [(r0, col), (r0 + 1, col)]
+            if r0 in blocked_rows or r0 + 1 in blocked_rows:
+                continue
+            if _can_place(grid, cells):
+                starts.append(r0)
