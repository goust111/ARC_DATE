  colors: 3 distinct — background (most common), lattice_color, marker_color
  grid: 17-22 rows x 20-22 cols
  lattice:
    type: single-pixel-thick regular grid of lattice_color lines
    horizontal_lines: 3-4, evenly spaced (gap 4-5 cells between lines)
    vertical_lines: 4-5, evenly spaced (same gap as horizontal)
    cell_size: 3x3 or 4x4 (always square, = gap between lines)
    first_line_offset: equals cell_size (one full cell band before first line)
    lines_are_complete: every pixel on a lattice line is lattice_color except the 4 holes
  holes:
    count: exactly 4, at lattice intersections, forming axis-aligned rectangle corners
    value: background color (makes them detectable as missing intersection pixels)
    rectangle_span: 1-2 lattice-line steps in each dimension (not necessarily same)
  markers:
    color: one non-bg non-lattice color
    placement: only inside cell interiors (never on lattice lines)
    density: 1-3 markers per cell on average; individual cells may have 0-6 [observed]
  output: inclusive crop from hole-corner rectangle (rows and cols of the 4 holes)

generation_strategy:
  approach: output-first
  steps:
    1. Pick 3 distinct colors for bg, lattice, marker.
    2. Choose cell_size in {3, 4}, num_h_lines in [3,4], num_v_lines in [4,5].
    3. Choose hole rectangle span (1-2 steps in rows, 1-2 steps in cols); pick which pair of lattice row/col indices form the 4 hole corners.
    4. Build the full grid — place lattice lines at regular intervals starting at offset=cell_size, fill cells with bg.
    5. Set exactly the 4 intersection pixels (hole corners) to bg instead of lattice_color.
    6. Scatter marker pixels randomly into cell interiors (density ~10-20% of cell area).
    7. Verify grid dimensions are 17-22 in each direction; pad/trim trailing cell strip if needed (rows/cols after last line can be 0 to cell_size).
    8. Output = inclusive crop inp[r0:r1+1, c0:c1+1] where (r0,c0)/(r1,c1) are hole positions.

