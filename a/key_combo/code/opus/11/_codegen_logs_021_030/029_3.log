+        primary = (np.indices(out.shape)[0] - start) % 2 == 0
+    else:
+        start = int(coords[:, 1].min())
+        primary = (np.indices(out.shape)[1] - start) % 2 == 0
+
+    color = int(pair["color"])
+    out[fill_mask & primary] = color
+    out[fill_mask & ~primary] = YELLOW
+    return out
