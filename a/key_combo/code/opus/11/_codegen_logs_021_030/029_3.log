  11: def main(grid: np.ndarray) -> np.ndarray:
  12:     """
  13:     Fill the parallelogram-shaped region between parallel anti-diagonal line segments with red.
  14: 
  15:     Input structure:
  16:     - bg = most common color.
  17:     - One non-bg color forms short diagonal segments, each lying on a single anti-diagonal (r+c = const).
  18:     - Segments come in parallel pairs bounding a region to be filled.
  19: 
  20:     Rule:
  21:     - For each main-diagonal axis (r−c = const), collect anti-diagonal segments whose span covers that axis.
  22:     - Sort those segments by their anti-diagonal index (r+c).
  23:     - Fill all bg cells lying strictly between consecutive segment pairs along that axis with red (color 2).
  24: 
  25:     Key insight: The two diagonal directions decouple — segments sit on anti-diagonals, and filling sweeps along main diagonals between them, forming parallelogram regions.
  26:     """
  27:     g = np.asarray(grid, dtype=int)
  28:     h, w = g.shape
  29: 
  30:     bg = _bg_color(g)
  31:     non_bg = [c for c in sorted(set(map(int, g.ravel()))) if c != bg]
  32:     assert non_bg, "grid must contain at least one non-background color"
  33: 
  34:     # This task uses one diagonal-line color and fills with 2.
  35:     line = max(non_bg, key=lambda c: int(np.sum(g == c)))
  36:     fill = 2
  37: 
  38:     comps = _cc8(g == line)
  39: 
  40:     # Each diagonal segment is on a constant anti-diagonal sum k=r+c,
  41:     # and spans a continuous range of main-diagonal indices b=r-c.
  42:     segs: list[tuple[int, int, int]] = []
  43:     for pts in comps:
  44:         ks = {r + c for r, c in pts}
  45:         if len(ks) != 1:
  46:             continue
  47:         k = int(next(iter(ks)))
  48:         bs = [r - c for r, c in pts]
  49:         segs.append((k, int(min(bs)), int(max(bs))))
  50: 
  51:     out = g.copy()
  52: 
  53:     # Scan each main diagonal b=r-c. For every b, find the active diagonal segments
  54:     # (those whose b-range covers b), sort them by k=r+c, then fill between adjacent
  55:     # segments for cells on this b with k strictly between.
  56:     for b in range(-(w - 1), h):
  57:         active = [s for s in segs if s[1] <= b <= s[2]]
  58:         if len(active) < 2:
  59:             continue
  60:         active.sort(key=lambda t: t[0])
  61:         ks = [t[0] for t in active]
  62: 
  63:         r_min = max(0, b)
  64:         r_max = min(h - 1, (w - 1) + b)
  65:         for k_left, k_right in zip(ks, ks[1:]):
  66:             for r in range(r_min, r_max + 1):
  67:                 c = r - b
  68:                 k = r + c
  69:                 if k_left < k < k_right and out[r, c] == bg:
  70:                     out[r, c] = fill
  71: 
  72:     return out
  73: 
