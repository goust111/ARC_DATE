+
+def _apply_symmetry(grid: np.ndarray, code: int) -> np.ndarray:
+    g = np.asarray(grid)
+    if code == 0:
+        return g.copy()
+    if code == 1:
+        return np.rot90(g, 1).copy()
+    if code == 2:
+        return np.rot90(g, 2).copy()
+    if code == 3:
