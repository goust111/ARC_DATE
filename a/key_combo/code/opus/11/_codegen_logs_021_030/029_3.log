  grid: 16x16 [observed]
  background: 8 (azure)
  colors:
    line: single non-bg color, not 2; varies per puzzle (3/4/9 observed)
    fill: always 2 (red), added in output
  segments:
    description: contiguous anti-diagonal line segments; each lies on a single anti-diagonal (r+c=k)
    count: 4-6 connected components (8-conn)
    distinct_k_values: 4-5 anti-diagonals used
    length: 2-9 cells per segment; each cell steps (r+1,c-1) so b=r-c increments by 2
    k_span: total k range 14-17 within [0,30]
    same_k_allowed: two segments may share the same k if their b-ranges are well-separated
  fill_rule: |
    For each main diagonal b=r-c, collect segments whose b-range covers b.
    Sort active segments by k. Fill bg cells strictly between consecutive active k-values with red.
    Line cells are preserved. This creates parallelogram-shaped fill regions.
  fill_regions: 3-5 distinct parallelogram regions per puzzle
  constraints:
    - at least 2 segments must have overlapping b-ranges to produce fill
    - all segment cells must be within grid bounds
    - segments are contiguous (no gaps along their anti-diagonal)

generation_strategy:
