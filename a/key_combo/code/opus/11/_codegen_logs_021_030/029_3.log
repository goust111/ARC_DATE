+                    rr, cc = r, c
+                    cells: list[tuple[int, int]] = []
+                    while rr < h and cc < w and mask[rr, cc]:
+                        cells.append((rr, cc))
+                        rr += 1
+                        cc += 1
+                    if len(cells) >= 2:
