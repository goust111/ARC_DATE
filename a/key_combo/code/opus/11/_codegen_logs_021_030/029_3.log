+def _segment_from_cells(color: int, orientation: str, cells: list[tuple[int, int]]) -> dict:
+    arr = np.array(sorted(cells), dtype=int)
+    if orientation == MAIN:
+        diag_values = arr[:, 0] - arr[:, 1]
+        span_values = arr[:, 0] + arr[:, 1]
+    else:
+        diag_values = arr[:, 0] + arr[:, 1]
+        span_values = arr[:, 0] - arr[:, 1]
+    assert len(set(map(int, diag_values))) == 1
+    return {
