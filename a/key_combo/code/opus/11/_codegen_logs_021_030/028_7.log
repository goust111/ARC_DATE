+import numpy as np
+
+
+GRID_SIZE = 6
+SEED_SIZE = 3
+BACKGROUND = 0
+SEED_COLOR = 5
+SPRITE_COLORS = (1, 2, 3)
+GENERATION_ATTEMPTS = 400
+
+
+BASE_SHAPES = (
+    ((0, 0), (0, 1)),                  # horizontal domino
+    ((0, 0), (1, 0)),                  # vertical domino
+    ((0, 0), (0, 1), (0, 2)),          # horizontal triomino
+    ((0, 0), (1, 0), (2, 0)),          # vertical triomino
+    ((0, 0), (1, 0), (1, 1)),          # L triomino
+    ((0, 1), (1, 0), (1, 1)),
+    ((0, 0), (0, 1), (1, 0)),
+    ((0, 0), (0, 1), (1, 1)),
+)
+
+MODE_WEIGHTS = (
+    ("independent2", 18),
+    ("chain2", 28),
+    ("independent3", 16),
+    ("mixed3", 24),
+    ("chain3", 14),
+)
