    if not ok or not fixed(arr): continue
    triple+=1
    rows=[set(r for r,c in a) for a in arr]
    graph=[[False]*3 for _ in range(3)]
    for i in range(3):
        for j in range(i+1,3):
            if rows[i]&rows[j]: graph[i][j]=graph[j][i]=True
    seen={0}; stack=[0]
    while stack:
        i=stack.pop()
        for j in range(3):
            if graph[i][j] and j not in seen:
                seen.add(j); stack.append(j)
    if len(seen)==3 and any(graph[i][j] for i in range(3) for j in range(i+1,3)):
        chain3+=1
print('pair fixed',pair,'indep',independent,'chain2',chain2)
print('triple fixed',triple,'chain3 connected',chain3)
