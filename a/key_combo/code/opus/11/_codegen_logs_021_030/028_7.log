+
+def _coords_set(coords: np.ndarray | tuple[tuple[int, int], ...]) -> set[tuple[int, int]]:
+    if isinstance(coords, np.ndarray):
+        return {tuple(map(int, cell)) for cell in coords}
+    return set(coords)
