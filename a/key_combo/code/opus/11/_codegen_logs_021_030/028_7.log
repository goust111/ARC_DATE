import itertools
H=W=6
seed={(r,c) for r in range(3) for c in range(3)}
shapes={
'h2':[(0,0),(0,1)],
'v2':[(0,0),(1,0)],
'h3':[(0,0),(0,1),(0,2)],
'v3':[(0,0),(1,0),(2,0)],
'Ldr':[(0,0),(1,0),(1,1)],
'Ldl':[(0,1),(1,0),(1,1)],
'Lur':[(0,0),(0,1),(1,0)],
'Lub':[(0,0),(0,1),(1,1)],
}
cands=[]
for name,cells in shapes.items():
    maxr=max(r for r,c in cells)
    maxc=max(c for r,c in cells)
    for r0 in range(H-maxr):
        for c0 in range(W-maxc):
            coords={(r0+r,c0+c) for r,c in cells}
            if coords & seed:
                continue
            if not all(0<=r<H and 0<=c<W for r,c in coords):
                continue
            rows=sorted({r for r,c in coords})
            right=max(c for r,c in coords)
            width=max(c for r,c in coords)-min(c for r,c in coords)+1
            cands.append((name,r0,c0,coords,rows,right,width))
print('cands',len(cands))
# fixed points under right gravity condition local only for single arrangement? We'll brute pairs/triples and count types.
def no_adj(a,b):
    for r,c in a:
        for rr,cc in b:
            if max(abs(r-rr),abs(c-cc))<=1:
                return False
    return True

def movable(comp, others):
    for r,c in comp:
        nc=c+1
        if nc>=W:
            return False
        if (r,nc) in others and (r,nc) not in comp:
            return False
    return True

def settle(arr):
    arr=[set(x) for x in arr]
    for _ in range(W):
        occ=set().union(*arr)
        mv=[]
        for i,comp in enumerate(arr):
            ok=True
            for r,c in comp:
                nc=c+1
                if nc>=W or ((r,nc) in occ and (r,nc) not in comp):
                    ok=False;break
            if ok:
                mv.append(i)
        if not mv: break
        for i in mv:
            arr[i]={(r,c+1) for r,c in arr[i]}
    return arr

def fixed(arr):
    s=settle(arr)
    return all(a==b for a,b in zip(arr,s))

pair=0; chain2=0; independent=0; triple=0; chain3=0
for comb in itertools.combinations(cands,2):
    arr=[c[3] for c in comb]
    if any(arr[0]&arr[1] for _ in [0]):
        continue
    if not no_adj(arr[0],arr[1]):
        continue
    if not fixed(arr):
        continue
    pair+=1
    rows=[set(r for r,c in a) for a in arr]
    overlap=bool(rows[0]&rows[1])
    if overlap: chain2+=1
    else: independent+=1
for comb in itertools.combinations(cands,3):
