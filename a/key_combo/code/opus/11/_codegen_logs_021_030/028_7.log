+    n = len(sprites)
+    rows = [{int(r) for r in sp["coords"][:, 0]} for sp in sprites]
+    graph = [[False] * n for _ in range(n)]
+    for i in range(n):
+        for j in range(i + 1, n):
+            if rows[i] & rows[j]:
+                graph[i][j] = graph[j][i] = True
+    return graph
+
