+BASE_SHAPES = (
+    ((0, 0), (0, 1)),                  # horizontal domino
+    ((0, 0), (1, 0)),                  # vertical domino
+    ((0, 0), (0, 1), (0, 2)),          # horizontal triomino
+    ((0, 0), (1, 0), (2, 0)),          # vertical triomino
+    ((0, 0), (1, 0), (1, 1)),          # L triomino
+    ((0, 1), (1, 0), (1, 1)),
+    ((0, 0), (0, 1), (1, 0)),
+    ((0, 0), (0, 1), (1, 1)),
+)
+
