+
+def _sprite_occupancy(sprites: list[dict]) -> set[tuple[int, int]]:
+    occ: set[tuple[int, int]] = set()
+    for sprite in sprites:
+        occ.update(_coords_set(sprite["coords"]))
+    return occ
