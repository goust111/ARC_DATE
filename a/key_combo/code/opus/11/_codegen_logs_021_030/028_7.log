+def _sprites_from_grid(grid: np.ndarray) -> list[dict]:
+    work = np.asarray(grid, dtype=int).copy()
+    work[:SEED_SIZE, :SEED_SIZE] = BACKGROUND
+    sprites: list[dict] = []
+    for color in SPRITE_COLORS:
+        mask = work == color
