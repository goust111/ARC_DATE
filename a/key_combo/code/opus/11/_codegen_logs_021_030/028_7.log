+    patterns: list[np.ndarray] = []
+    for bits in range(1 << (SEED_SIZE * SEED_SIZE)):
+        mask = np.zeros((SEED_SIZE, SEED_SIZE), dtype=bool)
+        for idx in range(SEED_SIZE * SEED_SIZE):
+            if bits & (1 << idx):
