+def _row_overlap_graph(sprites: list[dict]) -> list[list[bool]]:
+    n = len(sprites)
+    rows = [{int(r) for r in sp["coords"][:, 0]} for sp in sprites]
+    graph = [[False] * n for _ in range(n)]
