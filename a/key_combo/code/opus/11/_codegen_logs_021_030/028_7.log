 228: def main(grid: np.ndarray) -> np.ndarray:
 229:     """
 230:     Swing an irregular line segment around a nearby obstacle sprite, preserving its pixel count.
 231: 
 232:     Input structure:
 233:     - bg, bar color (straight lines perpendicular to the grid edge, one end on the border), segment color (irregular stroke attached to bar's inner endpoint), obstacle color (sprite near the bar terminal).
 234: 
 235:     Rule:
 236:     - Each bar is perpendicular to the edge it touches; its inner (terminal) endpoint has an attached irregular segment.
 237:     - The segment detaches and re-routes: it travels from the terminal toward the nearest obstacle, hugs the obstacle's boundary, then exits at a 45° diagonal.
 238:     - Total painted pixels equal the original segment length.
 239: 
 240:     Key insight: The segment behaves like a rope swung around the obstacle — attach at the nearest point, trace the skin, exit diagonally, conserving length.
 241:     """
 242:     g = np.asarray(grid, dtype=int)
 243:     h, w = g.shape
 244:     bg = get_bg(g)
 245: 
 246:     colors = sorted(set(int(v) for v in np.unique(g)) - {bg})
 247: 
 248:     out = g.copy()
 249: 
 250:     def bar_candidates():
 251:         # Yield (bar_color, bar_component, terminal_endpoint).
 252:         for col in colors:
 253:             for comp in _components(g, col, conn8=False):
 254:                 if len(comp) < 2 or not _is_straight_line(comp):
 255:                     continue
 256:                 e0, e1 = _bar_endpoints(comp)
 257:                 touch0 = _touches_border(e0, h, w)
 258:                 touch1 = _touches_border(e1, h, w)
 259:                 if touch0 == touch1:
 260:                     continue  # require exactly one endpoint on border
 261:                 # Orientation must be perpendicular to the edge it touches.
 262:                 rs = [r for r, _ in comp]
 263:                 cs = [c for _, c in comp]
 264:                 vertical = len(set(cs)) == 1
 265:                 border_ep = e0 if touch0 else e1
 266:                 if vertical:
 267:                     if border_ep[0] not in (0, h - 1):
 268:                         continue
 269:                 else:
 270:                     if border_ep[1] not in (0, w - 1):
 271:                         continue
 272:                 terminal_ep = e1 if touch0 else e0
 273:                 # Must have an attached non-bg neighbor at terminal.
 274:                 tr, tc = terminal_ep
 275:                 if not any(
 276:                     0 <= nr < h and 0 <= nc < w and int(g[nr, nc]) != bg and int(g[nr, nc]) != col
 277:                     for nr, nc in neighbors4(tr, tc)
 278:                 ):
 279:                     continue
 280:                 yield col, comp, terminal_ep
 281: 
 282:     # Process all valid bars; compute moves based on the original grid.
 283:     moves = []  # list of (seg_comp_pts, seg_color, new_pts)
 284:     for bar_col, bar_comp, terminal in sorted(list(bar_candidates()), key=lambda x: (-len(x[1]), x[0], x[2])):
 285:         # Segment neighbor candidates at terminal.
 286:         neigh = []
 287:         for nr, nc in neighbors4(terminal[0], terminal[1]):
 288:             if 0 <= nr < h and 0 <= nc < w:
 289:                 v = int(g[nr, nc])
 290:                 if v != bg and v != bar_col:
 291:                     neigh.append((v, (nr, nc)))
 292:         assert neigh, f"bar terminal {terminal} must have a non-bg/non-bar neighbor"
 293: 
 294:         # Choose a segment that behaves like a 1-cell-thick stroke attached at an endpoint.
 295:         best_seg = None  # (L, comp_size, seg_col, seg_start, seg_comp)
 296:         for cand_col, cand_start in neigh:
 297:             for comp in _components(g, cand_col, conn8=True):
 298:                 if cand_start in comp:
 299:                     if len(comp) < 2:
 300:                         break
 301:                     deg = _segment_degrees(comp)
 302:                     if deg.get(cand_start, 0) != 1:
 303:                         break
 304:                     path = _segment_main_path(comp, cand_start)
 305:                     L = len(path)
 306:                     key = (L, len(comp), cand_col, cand_start[0], cand_start[1])
 307:                     if best_seg is None or key > best_seg[0]:
 308:                         best_seg = (key, cand_col, cand_start, comp)
 309:                     break
 310:         assert best_seg is not None, f"no valid segment for bar at {terminal}"
 311:         (L, _, _, _, _), seg_col, seg_start, seg_comp = best_seg
 312: 
 313:         # Nearest obstacle component (any other non-bg color) to the terminal.
 314:         obstacle_candidates = [c for c in colors if c not in (bar_col, seg_col)]
 315:         assert obstacle_candidates, "must have at least one obstacle color distinct from bar and segment"
 316: 
