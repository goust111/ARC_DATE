+def _find_nested_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    candidates: list[dict] = []
+    seen: set[tuple[int, int, int, int, int]] = set()
