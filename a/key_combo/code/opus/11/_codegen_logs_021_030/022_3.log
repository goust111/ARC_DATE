+    for color in sorted(int(v) for v in np.unique(g) if int(v) != BACKGROUND):
+        rows = np.flatnonzero(np.any(g == color, axis=1))
+        cols = np.flatnonzero(np.any(g == color, axis=0))
+        for r0 in rows:
+            for r1 in rows:
+                if r1 - r0 < 2:
+                    continue
+                for c0 in cols:
