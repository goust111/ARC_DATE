  "src": "one 8-connected largest foreground outline object and smaller interior marker colors on a dominant background",
  "transform": "erase all original foreground pixels; repaint the background pixels 4-adjacent to the outline with the unique smallest non-outline marker color"
}
</annotation>
<generation_spec>
