+
+import numpy as np
+
+
+OUTER_COLOR = 5
+MIDDLE_COLOR = 2
+INNER_COLOR = 1
+FRAME_COLORS = (OUTER_COLOR, MIDDLE_COLOR, INNER_COLOR)
