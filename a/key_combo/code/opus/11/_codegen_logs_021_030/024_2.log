+def _stamp_object(
+    grid: np.ndarray,
+    occupied: np.ndarray,
+    color: int,
+    patch: np.ndarray,
+    forbidden: np.ndarray,
+) -> bool:
+    ph, pw = patch.shape
+    positions = [
+        (r, c)
+        for r in range(grid.shape[0] - ph + 1)
+        for c in range(grid.shape[1] - pw + 1)
