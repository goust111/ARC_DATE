+def _render_output(
+    grid: np.ndarray,
+    legend_bbox: tuple[int, int, int, int],
+    items: list[tuple[int, int, tuple[int, ...]]],
+) -> np.ndarray:
+    out = np.zeros_like(grid)
+    r0, c0, r1, c1 = legend_bbox
+    out[r0 : r1 + 1, c0 : c1 + 1] = grid[r0 : r1 + 1, c0 : c1 + 1]
