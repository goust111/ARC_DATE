+def _can_place(grid: np.ndarray, occupied: np.ndarray, patch: np.ndarray, top: int, left: int) -> bool:
+    ph, pw = patch.shape
+    if top < 0 or left < 0 or top + ph > grid.shape[0] or left + pw > grid.shape[1]:
+        return False
+    for r in range(ph):
+        for c in range(pw):
+            if patch[r, c] == 0:
