+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (12, 20)
+TRUNC_H_RANGE = (10, 12)
+NONTRUNC_H_RANGE = (13, 20)
+GRID_W_RANGE = (14, 26)
+TRUNC_W_RANGE = (20, 26)
+NONTRUNC_W_RANGE = GRID_W_RANGE
+KEY_COUNT_RANGE = (2, 4)
+COUNT_RANGE = (1, 4)
+LEGEND_W_RANGE = (5, 7)
+MOTIF_LEN_RANGE = (2, 3)
+OBJECT_SIZE_RANGE = (3, 6)
+OBJECT_BBOXES = [(2, 2), (2, 3), (3, 2), (3, 3)]
+TRUNCATE_PROB = 0.45
