+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    legend_bbox = _find_legend_bbox(g)
+    items = _extract_keys_and_motifs(g, legend_bbox)
+    return _render_output(g, legend_bbox, items)
