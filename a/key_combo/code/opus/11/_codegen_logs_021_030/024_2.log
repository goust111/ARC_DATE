+    if truncate_mode:
+        counts = [random.randint(2, COUNT_RANGE[1]) for _ in range(k)]
+    else:
+        counts = [random.randint(*COUNT_RANGE) for _ in range(k)]
+    if len(set(counts)) == 1:
+        idx = random.randrange(k)
