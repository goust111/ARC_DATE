+    grid[h - 1, legend_c0 : legend_c1 + 1] = GREY
+    for row, color, motif in zip(key_rows, key_colors, motifs):
+        grid[row, legend_c0 + 1] = int(color)
+        for i, value in enumerate(motif, start=2):
