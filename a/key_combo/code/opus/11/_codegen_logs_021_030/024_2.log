+    out[:, c0 : c1 + 1] = grid[:, c0 : c1 + 1]
+    write_r = 0
+    start_c = c1 + 1
+    for motif, count in zip(motifs, counts):
+        for _ in range(count):
+            if write_r >= h:
+                return out
+            for dc, value in enumerate(motif):
+                cc = start_c + dc
+                if cc < w:
