+BLACK = 0
+GREY = 5
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GEN_ATTEMPTS = 400
+GRID_H_RANGE = (12, 20)
+TRUNC_H_RANGE = (10, 12)
+NONTRUNC_H_RANGE = (13, 20)
+GRID_W_RANGE = (14, 26)
