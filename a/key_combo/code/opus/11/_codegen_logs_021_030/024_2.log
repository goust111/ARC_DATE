+        for r in range(grid.shape[0] - ph + 1)
+        for c in range(grid.shape[1] - pw + 1)
+    ]
+    random.shuffle(positions)
+    for top, left in positions:
+        if forbidden[top : top + ph, left : left + pw].any():
