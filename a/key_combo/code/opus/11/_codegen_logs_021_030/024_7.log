+def _placement_options(sprite: dict, holes: list[dict]) -> list[dict]:
+    rel = sprite["rel"]
+    colors = sprite["colors"]
+    max_r = int(rel[:, 0].max())
+    max_c = int(rel[:, 1].max())
+    placements = []
+    seen: set[frozenset[tuple[int, int]]] = set()
+
+    for hole in holes:
+        r0, c0, r1, c1 = hole["bbox"]
