+def _normalize_cells(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    r0 = min(r for r, _c in cells)
+    c0 = min(c for _r, c in cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
