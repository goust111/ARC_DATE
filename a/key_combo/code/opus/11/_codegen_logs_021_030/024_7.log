+
+def _hole_parts_for_component(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for rr in range(h):
+        for cc in (0, w - 1):
+            if not mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+    for cc in range(w):
+        for rr in (0, h - 1):
+            if not mask[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIR4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc] and not outside[nr, nc]:
+                outside[nr, nc] = True
+                q.append((nr, nc))
