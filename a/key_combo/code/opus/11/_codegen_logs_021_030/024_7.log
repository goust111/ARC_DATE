+def _component_holes(grid: np.ndarray, comp: dict) -> list[dict]:
+    r0, c0, r1, c1 = comp["bbox"]
+    coords = comp["coords"]
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    local[coords[:, 0] - r0, coords[:, 1] - c0] = True
