+
+def _build_unique_group() -> tuple[np.ndarray, np.ndarray, list[np.ndarray]]:
+    accents = list(random.sample(list(ACCENTS), k=3))
+    local_colors = {}
+    order = list(U6)
+    split = random.randint(2, 4)
+    for idx, cell in enumerate(order):
+        if idx < split:
+            local_colors[cell] = accents[0]
+        elif idx < 5:
