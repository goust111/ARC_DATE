        if side == "left":
            for r in range(a + 1, b):
                cells.discard((r, 0))
            _gen_add_segment(cells, a, 0, a, depth)
            _gen_add_segment(cells, b, 0, b, depth)
            _gen_add_segment(cells, a, depth, b, depth)
        else:
            c = w - 1
            inner = c - depth
            for r in range(a + 1, b):
                cells.discard((r, c))
            _gen_add_segment(cells, a, c, a, inner)
