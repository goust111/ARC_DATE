+    accents = list(random.sample(list(ACCENTS), k=4))
+    contacts = _contact_sets(shape, anchors)
+
+    if count == 2:
+        a, b, c = accents[:3]
+        specs = [
+            {"base": a, "prev": a, "next": WILDCARD},
+            {"base": c, "prev": b, "next": c},
+        ]
+    else:
+        a, b, c, d = accents
+        specs = [
+            {"base": a, "prev": a, "next": WILDCARD},
+            {"base": b, "prev": b, "next": c},
+            {"base": d, "prev": c, "next": d},
+        ]
