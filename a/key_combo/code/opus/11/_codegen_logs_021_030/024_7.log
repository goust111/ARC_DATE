+    shape_set = set(shape)
+    contacts = [{"prev": set(), "next": set()} for _ in anchors]
+    for idx in range(len(anchors) - 1):
+        a_r, a_c = anchors[idx]
+        b_r, b_c = anchors[idx + 1]
+        for cell in shape:
+            gr, gc = a_r + cell[0], a_c + cell[1]
+            for dr, dc in DIR4:
+                nbr = (gr + dr - b_r, gc + dc - b_c)
+                if nbr in shape_set:
