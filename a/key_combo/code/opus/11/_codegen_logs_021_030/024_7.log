+def _place_holes(
+    hole_masks: list[np.ndarray], hole_fills: list[np.ndarray]
+) -> tuple[np.ndarray, np.ndarray, list[tuple[int, int]]]:
+    assert len(hole_masks) == len(hole_fills)
+    if len(hole_masks) == 1:
+        top = random.randint(2, 3)
+        left = random.randint(2, 4)
