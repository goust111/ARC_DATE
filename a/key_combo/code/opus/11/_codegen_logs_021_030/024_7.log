+def _hole_parts_for_component(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for rr in range(h):
