            _gen_add_segment(cells, r, b, inner, b)
            _gen_add_segment(cells, inner, a, inner, b)
    else:
        span = random.randint(NOTCH_SPAN[0], min(NOTCH_SPAN[1], h - 3))
        a = random.randint(1, h - span - 2)
        b = a + span
