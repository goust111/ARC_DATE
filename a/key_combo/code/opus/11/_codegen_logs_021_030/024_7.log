+def _bbox_of_cells(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...]) -> tuple[int, int]:
+    h = max(r for r, _c in cells) + 1
+    w = max(c for _r, c in cells) + 1
+    return h, w
