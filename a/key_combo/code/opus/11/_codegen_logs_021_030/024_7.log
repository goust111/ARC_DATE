+        colors = [int(g[r, c]) for r, c in coords_list]
+        r0 = min(r for r, _c in coords_list)
+        c0 = min(c for _r, c in coords_list)
+        rel = np.array([(r - r0, c - c0) for r, c in coords_list], dtype=int)
