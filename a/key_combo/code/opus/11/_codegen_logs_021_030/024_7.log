+                "coords": global_coords,
+                "cells": frozenset(map(tuple, global_coords.tolist())),
+                "bbox": (
+                    int(global_coords[:, 0].min()),
+                    int(global_coords[:, 1].min()),
+                    int(global_coords[:, 0].max()),
+                    int(global_coords[:, 1].max()),
+                ),
+                "area": int(global_coords.shape[0]),
+            }
+        )
+    return holes
