+def _make_group(kind: str) -> tuple[np.ndarray, np.ndarray, list[np.ndarray]]:
+    if kind == "pair_l3_h":
+        return _build_chain_group(L3, [(0, 0), (0, 2)])
+    if kind == "pair_l3_v":
