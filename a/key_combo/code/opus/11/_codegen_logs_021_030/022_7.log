+
+    components: list[dict] = []
+    for idx, (zone, color, area) in enumerate(zip(zones, colors, areas)):
+        mode = special_mode if idx == special_index else "any"
+        variants = _candidate_shape_variants(area, mode)
+        if not variants:
+            return None
