+def _normalize_shape(cells: set[tuple[int, int]]) -> np.ndarray:
+    arr = np.array(sorted(cells), dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
