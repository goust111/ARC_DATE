+        if radius_mode == "area":
+            radius = int(comp["area"])
+        elif radius_mode == "bbox_area":
+            radius = _bbox_area(comp["bbox"])
+        else:
+            raise ValueError(f"unknown radius_mode: {radius_mode}")
