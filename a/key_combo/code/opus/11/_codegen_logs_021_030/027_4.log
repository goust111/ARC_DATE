  grid: 3 rows; width = sum(group widths) + (N-1) separator columns
  background: 0
  groups:
    count: 3-4 monochrome 4-connected path fragments, ordered left to right
    width: 2-3 columns each
    cells: 2-4 foreground cells per group; each forms a single connected component
    color: each group is monochrome (one non-bg color); colors may repeat across groups
    shape: path-like polyomino where every cell has degree 1 or 2; exactly 2 global endpoints
    endpoints: exactly 1 degree-1 cell on left edge column, exactly 1 on right edge column
    row_span: occupies 1-3 of the 3 rows; bounding box height 1-3
  separators: exactly 1 all-background column between each adjacent pair of groups [observed]
  layout: first group starts at column 0 [observed]
  output:
    height: same 3 rows
    width: sum of all group widths (separators removed)
    rule: keep first group at its original row offset; for each subsequent group left-to-right, shift it vertically so its left endpoint row aligns with the previous group's right endpoint row, then paste it immediately adjacent
    result: all groups form a single 4-connected component in the output
    vertical_shift_range: -2 to +2

generation_strategy:
  approach: output-first
  steps:
    1. Choose N=3-4. For each group, pick a width (2-3) and a monochrome color (non-zero).
    2. Build the assembled output chain on a 3-row canvas by generating groups left to right.
       For each group, create a valid path polyomino (2-4 cells, 4-connected, all degree<=2, exactly 1 endpoint on each side column). Place it so the left endpoint row matches the previous group's right endpoint row, ensuring all cells stay in rows 0-2.
