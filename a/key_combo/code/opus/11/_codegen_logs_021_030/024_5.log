+def _outer_head_candidates(shape: dict) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    border = {tuple(map(int, p)) for p in shape["border"]}
+    interior = {tuple(map(int, p)) for p in shape["interior"]}
