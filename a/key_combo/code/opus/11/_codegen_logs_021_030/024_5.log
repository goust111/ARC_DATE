/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
from itertools import combinations, product
import numpy as np
p = Path('/home/lixinyu/snap/a/key_combo/code/opus/11/024/5.py')
mod = SourceFileLoader('arc_new5', str(p)).load_module()

def add_segment(cells, r0, c0, r1, c1):
    if r0 == r1:
        a,b = sorted((c0,c1))
        for c in range(a,b+1):
            cells.add((r0,c))
    else:
        a,b = sorted((r0,r1))
        for r in range(a,b+1):
            cells.add((r,c0))

def rect(h,w):
    cells=set()
    for c in range(w):
        cells.add((0,c)); cells.add((h-1,c))
    for r in range(h):
        cells.add((r,0)); cells.add((r,w-1))
    return cells

def apply_notch(cells,h,w,side,a,span,depth):
    b=a+span
    if side=='top':
        for c in range(a+1,b): cells.discard((0,c))
        add_segment(cells,0,a,depth,a); add_segment(cells,0,b,depth,b); add_segment(cells,depth,a,depth,b)
    elif side=='bottom':
        r=h-1; inner=r-depth
        for c in range(a+1,b): cells.discard((r,c))
        add_segment(cells,r,a,inner,a); add_segment(cells,r,b,inner,b); add_segment(cells,inner,a,inner,b)
    elif side=='left':
        for r in range(a+1,b): cells.discard((r,0))
        add_segment(cells,a,0,a,depth); add_segment(cells,b,0,b,depth); add_segment(cells,a,depth,b,depth)
    else:
        c=w-1; inner=c-depth
        for r in range(a+1,b): cells.discard((r,c))
        add_segment(cells,a,c,a,inner); add_segment(cells,b,c,b,inner); add_segment(cells,a,inner,b,inner)

best=None
for h in range(4,9):
  for w in range(4,9):
    base=rect(h,w)
    opts=[]
    for side in ['top','bottom']:
      for span in [2,3]:
        for a in range(1, w-span-1):
          for depth in range(1, max(1,(h-3)//2)+1):
            opts.append((side,a,span,depth))
    for side in ['left','right']:
      for span in [2,3]:
        for a in range(1, h-span-1):
          for depth in range(1, max(1,(w-3)//2)+1):
            opts.append((side,a,span,depth))
    for k in [1,2,3]:
      for chosen in combinations(opts,k):
        cells=set(base)
        try:
          for o in chosen: apply_notch(cells,h,w,*o)
        except Exception:
          continue
        mask=np.zeros((h,w),dtype=bool)
        for r,c in cells: mask[r,c]=True
        comps=mod._components(mask)
        if len(comps)"'!=1: continue
        border=comps[0]
        try:
          path=mod._trace_cycle(border)
          turns,sign,conv=mod._turn_data(path)
        except Exception:
          continue
        interior=mod._enclosed_region(border)
        if interior is None or len(interior)==0: continue
        heads=mod._outer_head_candidates({'"'border':border,'interior':interior,'turns':turns})
        if not heads: continue
        area=len(interior)
        if area < conv:
          cand=(area,conv,h,w,chosen,{k:len(v) for k,v in heads.items()})
          if best is None or cand<best: best=cand
print('best',best)
