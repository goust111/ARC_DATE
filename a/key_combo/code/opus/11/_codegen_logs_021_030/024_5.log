+from collections import Counter
+import random
+
+import numpy as np
+
+
+BG = 6
+BORDER = 0
+CONCAVE = 2
+CONVEX = 4
+GREY = 5
+ORANGE = 7
+MARKER = 9
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [
+    (-1, -1),
+    (-1, 0),
+    (-1, 1),
+    (0, -1),
+    (0, 1),
+    (1, -1),
