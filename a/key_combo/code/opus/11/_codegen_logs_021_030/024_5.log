+    for idx, spec in enumerate(specs):
+        dirs = list(spec["head_candidates"].keys())
+        random.shuffle(dirs)
+        dirs.sort(key=lambda d: (d in used_dirs, random.random()))
+        ok = False
+        for direction in dirs:
+            heads = spec["head_candidates"][direction][:]
