+    elif direction == (1, 0):
+        key = lambda p: (-p[0], p[1])
+    else:
+        key = lambda p: (p[0], p[1])
+    return sorted(pts, key=key)
+
+
+def _find_head_and_dest(
+    g: np.ndarray,
+    border_coords: np.ndarray,
+    interior_coords: np.ndarray,
