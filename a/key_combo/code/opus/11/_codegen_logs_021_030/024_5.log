+        out[item["out_head"]] = MARKER
+        out[item["dest"]] = MARKER
+
+    return inp, out, placed
+
+
+def _make_specs(n: int) -> list[dict]:
+    base = [
+        _sample_shape("energy", 8),
+        _sample_shape("grey", random.choice([5, 6])),
