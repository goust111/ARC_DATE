+        for cc in (0, w - 1):
+            if passable[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+    for cc in range(w):
+        for rr in (0, h - 1):
+            if passable[rr, cc] and not outside[rr, cc]:
