+                "border": comp,
+                "border_set": {tuple(map(int, p)) for p in comp},
+                "interior": interior,
+                "head": head,
+                "dest": dest,
+                "dir": direction,
+                "head_dist": head_dist,
+                "convex_count": convex_count,
+                "bend_colors": bend_colors,
+                "turns": turns,
+            }
+        )
