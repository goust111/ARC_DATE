+        if len({d["convex_count"] for d in details}) < 2:
+            continue
+        if not any(d["steps"] < d["convex_count"] for d in details):
+            continue
+        if not any(d["steps"] == d["convex_count"] for d in details):
+            continue
+        if np.count_nonzero(out == CONVEX) == 0 or np.count_nonzero(out == CONCAVE) == 0:
+            continue
+        if np.array_equal(inp, out):
