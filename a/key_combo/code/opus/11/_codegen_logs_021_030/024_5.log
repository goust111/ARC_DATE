+        return None
+    return comps[0] + np.array([r0, c0], dtype=int)
+
+
+def _charge_order(interior: np.ndarray, direction: tuple[int, int]) -> list[tuple[int, int]]:
+    pts = [tuple(map(int, p)) for p in interior]
+    if direction == (0, 1):
+        key = lambda p: (-p[1], p[0])
+    elif direction == (0, -1):
