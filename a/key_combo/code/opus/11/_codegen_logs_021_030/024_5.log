+
+
+def _expand(cells: set[tuple[int, int]], shape: tuple[int, int]) -> set[tuple[int, int]]:
+    out = set()
+    for r, c in cells:
+        for dr, dc in DIRS8 + [(0, 0)]:
+            rr, cc = r + dr, c + dc
+            if _in_bounds(shape, rr, cc):
