/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import random, numpy as np
p = Path('/home/lixinyu/snap/a/key_combo/code/opus/11/024/5.py')
mod = SourceFileLoader('arc_new5', str(p)).load_module()
random.seed(3)

def find_conv8(limit=200000, H=8, W=8):
    dirs=[(-1,0),(1,0),(0,-1),(0,1)]
    found=[]
    for _ in range(limit):
        start=(random.randrange(H), random.randrange(W))
        target_len=random.randint(10,24)
        path=[start]
        used={start}
        for _step in range(target_len*5):
            cur=path[-1]
            neigh=[]
            for dr,dc in dirs:
                nr,nc=cur[0]+dr, cur[1]+dc
                if not (0<=nr<H and 0<=nc<W):
                    continue
                if (nr,nc)==start and len(path)>=4:
                    neigh.append((nr,nc))
                elif (nr,nc) not in used:
                    neigh.append((nr,nc))
            random.shuffle(neigh)
            moved=False
            for nxt in neigh:
                if nxt==start:
                    pts=np.array(path,dtype=int)
                    try:
                        traced=mod._trace_cycle(pts)
                        turns,sign,conv=mod._turn_data(traced)
                        interior=mod._enclosed_region(pts)
                    except Exception:
                        continue
                    if interior is None or len(interior)==0 or conv "'!= 8:
                        continue
                    shape={'"'border':pts,'interior':interior,'turns':turns}
                    heads=mod._outer_head_candidates(shape)
                    if not heads:
                        continue
                    found.append((len(interior), pts.tolist(), {str(k):len(v) for k,v in heads.items()}))
                    if len(found)>=5:
                        return sorted(found)
                    break
                cnt=0
                for dr,dc in dirs:
                    pp=(nxt[0]+dr,nxt[1]+dc)
                    if pp in used or pp==start:
                        cnt+=1
                if cnt>1 and len(path)<target_len-1:
                    continue
                path.append(nxt)
                used.add(nxt)
                moved=True
                break
            if not moved:
                break
    return sorted(found)

print(find_conv8())
