+        if r == r0 and (r - 1, c) not in filled:
+            out[(-1, 0)].append((r - 1, c))
+        if r == r1 and (r + 1, c) not in filled:
+            out[(1, 0)].append((r + 1, c))
+        if c == c0 and (r, c - 1) not in filled:
+            out[(0, -1)].append((r, c - 1))
+        if c == c1 and (r, c + 1) not in filled:
