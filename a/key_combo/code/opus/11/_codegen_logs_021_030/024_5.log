+                                "move_dist": move_dist,
+                                "origin": (fr, fc),
+                                "head_rel": head_rel,
+                                "in_border": in_border,
+                                "in_interior": in_interior,
+                                "in_head": in_head,
+                                "out_border": out_border,
+                                "out_interior": out_interior,
+                                "out_head": out_head,
+                                "dest": dest,
+                            }
+                        )
+                        ok = True
+                        break
+                    if ok:
+                        break
+                if ok:
+                    break
+            if ok:
