+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+GREY = 5
+SEED_COLORS = (1, 2, 3, 6, 7, 8, 9)
+DIRS4 = ((-1, 0), (0, 1), (1, 0), (0, -1))
+
+GEN_ATTEMPTS = 600
