+    must_take = min(len(path_candidates), max(1, blocker_count // 2))
+    for cell in path_candidates:
+        if len(blockers) >= must_take:
+            break
+        if is_valid(cell):
+            blockers.add(cell)
+    if len(blockers) < must_take:
+        return None
