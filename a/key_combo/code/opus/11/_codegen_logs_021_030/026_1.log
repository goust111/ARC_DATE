/bin/bash -lc "python - <<'PY'
import random
from collections import deque
import numpy as np
DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
COLORS=[1,2,3,6,7,8,9]

class S:
    def __init__(self,pos,color):
        self.start=pos; self.r,self.c=pos; self.color=color; self.di=0; self.leg=1; self.used=0; self.active=True

def advance_leg(s):
    s.di=(s.di+1)%4; s.used=0
    if s.di in (0,2): s.leg+=1

def blocked(shape, occ, blockers, r,c):
    h,w=shape
    return r<0 or c<0 or r>=h or c>=w or (r,c) in blockers or (r,c) in occ

def parse(grid):
    seeds=[]; blockers=set();
    for r in range(grid.shape[0]):
        for c in range(grid.shape[1]):
            v=int(grid[r,c])
            if v==5: blockers.add((r,c))
            elif v"'!=0: seeds.append((r,c,v))
    return seeds, blockers

def fill(base):
    h,w=base.shape; out=base.copy(); seen=set()
    for r in range(h):
        for c in range(w):
            if out[r,c]!=0 or (r,c) in seen: continue
            q=deque([(r,c)]); seen.add((r,c)); comp=[]; adj=set()
            while q:
                x,y=q.popleft(); comp.append((x,y))
                for dx,dy in DIRS:
                    nx,ny=x+dx,y+dy
                    if 0<=nx<h and 0<=ny<w:
                        v=int(out[nx,ny])
                        if v==0 and (nx,ny) not in seen:
                            seen.add((nx,ny)); q.append((nx,ny))
                        elif v not in (0,5): adj.add(v)
            color=0 if not adj else (list(adj)[0] if len(adj)==1 else 4)
            for x,y in comp: out[x,y]=color
    return out

def sync(grid):
    h,w=grid.shape
    seedinfo, blockers = parse(grid)
    states=[S((r,c),v) for r,c,v in seedinfo]
    occ={(s.r,s.c):s.color for s in states}
    for _ in range(5000):
        if not any(s.active for s in states): break
        occset=set(occ)
        props=[]
        for i,s in enumerate(states):
            if not s.active: continue
            dr,dc=DIRS[s.di]; nr,nc=s.r+dr,s.c+dc
            if blocked((h,w),occset,blockers,nr,nc):
                advance_leg(s)
                dr2,dc2=DIRS[s.di]; tr,tc=s.r+dr2,s.c+dc2
                if blocked((h,w),occset,blockers,tr,tc): s.active=False
                continue
            props.append((i,nr,nc))
        by={}
        for i,nr,nc in props: by.setdefault((nr,nc),[]).append(i)
        for cell, ids in by.items():
            if len(ids)>1:
                for i in ids: states[i].active=False
                continue
            s=states[ids[0]]; s.r,s.c=cell; occ[cell]=s.color; s.used+=1
            if s.used==s.leg: advance_leg(s)
    out=grid.copy()
    for (r,c),v in occ.items(): out[r,c]=v
    return fill(out)

def indep(grid):
    h,w=grid.shape
    seedinfo, blockers=parse(grid)
    occ={}
    for r,c,v in seedinfo:
        s=S((r,c),v)
        own={(r,c)}
        for _ in range(5000):
            if not s.active: break
            dr,dc=DIRS[s.di]; nr,nc=s.r+dr,s.c+dc
            if blocked((h,w),own,blockers,nr,nc):
                advance_leg(s)
                dr2,dc2=DIRS[s.di]; tr,tc=s.r+dr2,s.c+dc2
                if blocked((h,w),own,blockers,tr,tc): s.active=False
                continue
            s.r,s.c=nr,nc; own.add((nr,nc)); occ[(nr,nc)] = v; s.used+=1
            if s.used==s.leg: advance_leg(s)
        occ[(r,c)] = v
    out=grid.copy()
    for (r,c),v in occ.items(): out[r,c]=v
    return fill(out)

rand=random.Random(0)
diff=0
for trial in range(200):
    h=w=15
    g=np.zeros((h,w),int)
    seed_count=rand.choice([2,3])
    pts=[]
    for _ in range(seed_count):
        for _ in range(100):
            p=(rand.randint(4,10),rand.randint(4,10))
            if all(abs(p[0]-q[0])+abs(p[1]-q[1])>=6 for q in pts):
                pts.append(p); break
    cols=COLORS[:seed_count]
    for p,col in zip(pts,cols): g[p]=col
    for _ in range(rand.randint(3,5)):
        for _ in range(100):
            p=(rand.randint(0,14),rand.randint(0,14))
            if g[p]!=0: continue
            if any(abs(p[0]-q[0])+abs(p[1]-q[1])==1 for q in pts): continue
            g[p]=5; break
    if not np.array_equal(sync(g), indep(g)):
        diff +=1
print('"'diff', diff)
