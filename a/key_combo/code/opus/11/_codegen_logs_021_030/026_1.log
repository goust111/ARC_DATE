+    region_stats = _analyze_regions(sync_sim["regions"])
+    if region_stats["single_area"] < MIN_SINGLE_REGION_AREA:
+        return False
+    if require_multi_region and region_stats["multi_area"] < MIN_MULTI_REGION_AREA:
+        return False
+    if region_stats["single_count"] == 0:
