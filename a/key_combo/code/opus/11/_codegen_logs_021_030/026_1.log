+        for c in range(w):
+            cell = (r, c)
+            if not is_valid(cell):
+                continue
+            if bbox_r0 - 2 <= r <= bbox_r1 + 2 and bbox_c0 - 2 <= c <= bbox_c1 + 2:
+                focal.append(cell)
+            else:
