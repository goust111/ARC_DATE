  58:     [
  59:         (0x00, 0x00, 0x00),  # 0 black
  60:         (0x00, 0x74, 0xD9),  # 1 blue
  61:         (0xFF, 0x41, 0x36),  # 2 red
  62:         (0x2E, 0xCC, 0x40),  # 3 green
  63:         (0xFF, 0xDC, 0x00),  # 4 yellow
  64:         (0xA0, 0xA0, 0xA0),  # 5 grey
  65:         (0xF0, 0x12, 0xBE),  # 6 magenta/pink
  66:         (0xFF, 0x85, 0x1B),  # 7 orange
  67:         (0x7F, 0xDB, 0xFF),  # 8 teal/azure
  68:         (0x87, 0x0C, 0x25),  # 9 maroon
  69:         (0xFF, 0xFF, 0xFF),  # 10 white
