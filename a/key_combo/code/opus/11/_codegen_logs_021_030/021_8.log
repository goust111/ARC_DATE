 - 1]             colors = set(map(int, np.unique(inside)))             colors.discard(bg)             colors.discard(x)             return int(sz), int(x), colors     assert False, "no legend border found in grid"   def main(grid: np.ndarray) -> np.ndarray:     """     Delete connected components whose colors match a legend swatch.      Input structure:     - Background (bg) fills most of the grid.     - Top-left corner: a small square legend region bordered on its bottom and right edges by a single color; the interior holds a set of "target" colors.     - Elsewhere: multicolored objects (4-connected components) on the bg.      Rule:     - Read the target color set from inside the legend border.     - For each connected component, check whether it contains **all** target colors.     - Erase (fill with bg) every component that does; leave all others unchanged.     - Output grid is the same size.      Key insight: The legend acts as a filter specification — only components carrying the full color palette shown in the legend are removed.     """     g = np.asarray(grid, dtype=int)     bg = _bg_boundary(g)      legend = _find_legend(g, bg)     _sz, _x, legend_colors = legend     assert legend_colors, "legend interior contains no target colors"      out = g.copy()     comps = components_mask(g != bg, connectivity=4)     for pts in comps:         cols = {int(g[r, c]) for r, c in pts}         if legend_colors.issubset(cols):             for r, c in pts:                 out[r, c] = bg     return out  # --------------- generator (o5x) ---------------  # -- Grid & legend constants -- GRID_H, GRID_W = 16, 16 BG = 7 BORDER = 3 LEGEND_SIZE = 4                       # 4x4 legend at top-left PALETTE = [1, 2, 4, 5, 6, 8, 9] NUM_TARGETS = 3                       # target colors sampled from PALETTE  # -- Component shape weights: (mode, weight) -- SHAPE_WEIGHTS = [5, 3, 2]            # medium, tall, wide TALL_H = (8, 16);  TALL_W = (2, 4) WIDE_H = (3, 5);   WIDE_W = (5, 9) MED_H  = (3, 7);   MED_W  = (2, 9)  # -- Component fill density (fraction of non-zero pixels) -- DENSITY_LO = 0.10 DENSITY_HI = 0.55  # -- Component count & kept/deleted split -- COMP_COUNTS = [4, 5, 6] COMP_WEIGHTS = [1, 4, 25] NUM_KEPT = 3                          # always keep exactly 3  # -- Generation retry budget -- MAX_RETRIES = 300   def _place_legend(inp: np.ndarray, out: np.ndarray, targets: list[int]) -> None:     """Draw the 4x4 legend box (border color 3) at top-left and place target colors."""     s = LEGEND_SIZE     for g in (inp, out):         g[:s, :s] = BG         g[s - 1, :s] = BORDER         g[:s, s - 1] = BORDER      # Pick 3 positions in the 3x3 interior: one isolated corner + two non-adjacent border cells     isolated = random.choice([(0, 0), (0, 1), (1, 0), (1, 1)])     border_side = [(0, 2), (1, 2), (2, 0), (2, 1), (2, 2)]     side_choices = [         p for p in border_side         if abs(p[0] - isolated[0]) + abs(p[1] - isolated[1]) != 1     ]     positions = [isolated] + random.sample(side_choices, 2)     random.shuffle(positions)     for color, (r, c) in zip(targets, positions):         inp[r, c] = color         out[r, c] = color   def _component_dims() -> tuple[int, int]:     """Sample component (h, w) according to shape-mode weights."""     mode = random.choices(["medium", "tall", "wide"], weights=SHAPE_WEIGHTS)[0]     if mode == "tall":         return random.randint(*TALL_H), random.randint(*TALL_W)     if mode == "wide":         return random.randint(*WIDE_H), random.randint(*WIDE_W)     return random.randint(*MED_H), random.randint(*MED_W)   def _component_patch(h: int, w: int, targets: list[int], deleted: bool) -> np.ndarray:     """Build an h x w patch filled with color-0 base and sprinkled colored pixels."""     area = h * w     lo = max(1, math.ceil(area * DENSITY_LO))     hi = max(lo, math.floor(area * DENSITY_HI))     if deleted:         lo = max(lo, NUM_TARGETS)      n_colored = random.randint(lo, hi)     coords = random.sample([(r, c) for r in range(h) for c in range(w)], n_colored)     non_targets = [v for v in PALETTE if v not in targets]      if deleted:         colors = list(targets) + [random.choice(PALETTE) for _ in range(n_colored - NUM_TARGETS)]     else:         used_target_count = random.randint(0, NUM_TARGETS - 1)         allowed = non_targets + random.sample(targets, used_target_count)         colors = [random.choice(allowed) for _ in range(n_colored)]      random.shuffle(colors)     patch = np.zeros((h, w), dtype=int)     rs, cs = zip(*coords)     patch[rs, cs] = colors     return patch   def _gen_attempt() -> np.ndarray | None:     """Try once to build a valid (input, output) pair; return input or None on failure."""     inp = np.full((GRID_H, GRID_W), BG, dtype=int)     out = inp.copy()      targets = random.sample(PALETTE, NUM_TARGETS)     _place_legend(inp, out, targets)      component_count = random.choices(COMP_COUNTS, weights=COMP_WEIGHTS)[0]     roles = [True] * (component_count - NUM_KEPT) + [False] * NUM_KEPT     random.shuffle(roles)      for deleted in roles:         h, w = _component_dims()         patch = _component_patch(h, w, targets, deleted)         try:             r, c = random_free_location(                 inp, np.zeros_like(patch), transparent=BG, padding=1, padding_connectivity=8,             )         except ValueError:             return None         paste(inp, patch, r, c)         if not deleted:             paste(out, patch, r, c)      if np.array_equal(main(inp), out):         return inp     return None   def generate_input() -> np.ndarray:     for _ in range(MAX_RETRIES):         grid = _gen_attempt()         if grid is not None:             return grid     raise RuntimeError("failed to generate valid input")      ```      ## 原始任务规格（Spec）      以下是从原始 solver 代码和示例中提炼的完整任务规格，包含精确的数值约束和生成策略。     Spec 本身就是原题代码生成时的参考文件，因此：     - 在**设计分析**阶段，参考 spec 理解原始任务的完整设计细节（对象结构、空间关系、生成策略等），以此为基础思考变体的改动如何落实     - 在**实现**阶段，参考 spec 中的数值约束（网格尺寸、对象数量/尺寸、颜色数等），确保变体在物理上可实现  