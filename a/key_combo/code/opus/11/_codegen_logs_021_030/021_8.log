import random, numpy as np
from collections import deque

random.seed(0)
np.set_printoptions(linewidth=200)

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def enclosed_regions(grid):
    H,W=grid.shape
    mask=grid==0
    seen=np.zeros((H,W),bool)
    out=[]
    for r in range(H):
        for c in range(W):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)]); seen[r,c]=1; pts=[]; touch=False
            while q:
                x,y=q.popleft(); pts.append((x,y))
                if x in (0,H-1) or y in (0,W-1): touch=True
                for nx,ny in neighbors4(x,y):
                    if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
                        seen[nx,ny]=1; q.append((nx,ny))
            if not touch:
                out.append(set(pts))
    return out

def tile4(g):
    H,W=g.shape
    return np.tile(g,(2,2))

def paint_feature(tile, cells):
    H,W=tile.shape
    for i,(r,c) in enumerate(cells):
        tr,tc=r%H,c%W
        color=1 if (r+c+i)%2==0 else 2
        if tile[tr,tc] not in (0,color):
            return False
        tile[tr,tc]=color
    return True

def add_vertical(tile, combined):
    H,W=tile.shape
    top_min=2
    top_max=(H-4 if combined else H-3)
    if top_max < top_min:
        return False
    r0=random.randint(top_min, top_max)
    r1=random.randint(r0+1, min(r0+3, H-3 if not combined else H-4))
    cells=[]
    for r in range(r0-1,r1+2):
        for c in range(W-2,W+2):
            if r in (r0-1,r1+1) or c in (W-2,W+1):
                cells.append((r,c))
    return paint_feature(tile,cells)

def add_horizontal(tile, combined):
    H,W=tile.shape
