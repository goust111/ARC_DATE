+def _boundary_distance(coords: np.ndarray, direction: tuple[int, int], shape: tuple[int, int]) -> int:
+    h, w = shape
+    min_r = int(coords[:, 0].min())
+    max_r = int(coords[:, 0].max())
+    min_c = int(coords[:, 1].min())
+    max_c = int(coords[:, 1].max())
