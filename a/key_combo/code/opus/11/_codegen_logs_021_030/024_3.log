+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+DIR_BY_CENTER = {
+    RED: (1, 0),      # down
+    BLUE: (0, -1),    # left
+    GREEN: (0, 1),    # right
+    YELLOW: (-1, 0),  # up
