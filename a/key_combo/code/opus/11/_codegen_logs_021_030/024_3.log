+
+
+def _frame_ring(center_r: int, center_c: int) -> list[tuple[int, int]]:
+    return [
+        (center_r - 1, center_c - 1),
+        (center_r - 1, center_c),
+        (center_r - 1, center_c + 1),
+        (center_r, center_c - 1),
+        (center_r, center_c + 1),
+        (center_r + 1, center_c - 1),
+        (center_r + 1, center_c),
+        (center_r + 1, center_c + 1),
+    ]
