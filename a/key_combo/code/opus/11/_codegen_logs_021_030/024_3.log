def _gen_partition_sum(total, lows, highs):
    vals = []
    remaining = int(total)
    for i, (lo, hi) in enumerate(zip(lows, highs)):
        rest_l = sum(lows[i + 1 :])
        rest_h = sum(highs[i + 1 :])
        a = max(int(lo), remaining - rest_h)
        b = min(int(hi), remaining - rest_l)
        if a > b:
