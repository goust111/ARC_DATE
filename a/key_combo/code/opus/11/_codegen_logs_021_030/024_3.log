+BASE_SHAPES = (
+    ((0, 0), (1, 0), (1, 1)),
+    ((0, 1), (1, 0), (1, 1)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (0, 1), (0, 2), (1, 1)),
+    ((0, 1), (0, 2), (1, 0), (1, 1)),
+    ((0, 1), (1, 0), (1, 1), (1, 2), (2, 1)),
+    ((0, 0), (1, 0), (2, 0), (2, 1), (2, 2)),
+    ((0, 0), (0, 1), (1, 0), (1, 1), (2, 0)),
+)
+
+GEN_HEIGHT_RANGE = (18, 22)
+GEN_WIDTH_RANGE = (18, 22)
+GEN_FRAME_COUNT_RANGE = (3, 4)
+GEN_OBJECT_COUNT_RANGE = (3, 5)
+GEN_DISTRACTOR_COUNT_RANGE = (1, 4)
+GEN_FRAME_LOCAL_DISTANCE = 9
+GEN_ATTEMPTS = 400
