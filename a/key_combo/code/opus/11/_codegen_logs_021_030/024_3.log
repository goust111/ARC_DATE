+                frames.append(
+                    {
+                        "center": (r, c),
+                        "center_color": center,
+                        "direction": DIR_BY_CENTER[center],
+                    }
+                )
+    return frames
+
+
+def _find_orange_objects(grid: np.ndarray) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objects = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != ORANGE:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
