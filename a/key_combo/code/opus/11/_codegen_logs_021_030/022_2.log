+
+
+def _attempt_generate(rng: random.Random) -> np.ndarray | None:
+    mask = rng.choice(_mask_library()).copy()
+    sprite_h, sprite_w = mask.shape
+    count = rng.randint(*SPRITE_COUNT)
+
