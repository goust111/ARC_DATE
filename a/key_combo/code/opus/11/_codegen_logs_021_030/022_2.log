+        return None
+    anchor_top, other_tops = top_sample
+
+    anchor_idx = rng.randrange(count)
+    colors = rng.sample(list(NON_ANCHOR_COLORS), count - 1)
+    tops_by_index = [None] * count
+    tops_by_index[anchor_idx] = anchor_top
+    j = 0
+    for i in range(count):
