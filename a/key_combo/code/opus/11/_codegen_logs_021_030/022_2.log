+    j = 0
+    for i in range(count):
+        if i == anchor_idx:
+            continue
+        tops_by_index[i] = other_tops[j]
+        j += 1
+
+    sprite_colors = []
+    non_anchor_iter = iter(colors)
+    for i in range(count):
