+        fill_color = int(left_sprite["color"]) if width % 2 == 1 else int(right_sprite["color"])
+        block = out[int(anchor["top"]) : int(anchor["top"]) + h, gap_l : gap_r + 1]
+        assert block.shape == (h, width)
