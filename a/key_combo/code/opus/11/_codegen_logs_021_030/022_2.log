        gap_l = int(left_sprite["right"]) + 1
        gap_r = int(right_sprite["left"]) - 1
        width = gap_r - gap_l + 1
        fill_color = int(left_sprite["color"]) if width % 2 == 1 else int(right_sprite["color"])
