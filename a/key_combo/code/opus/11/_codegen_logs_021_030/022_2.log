+
+    inp = np.full((rows, cols), BLACK, dtype=int)
+    sprites: list[dict] = []
+    for i in range(count):
+        top = int(tops_by_index[i])
+        left = int(lefts[i])
+        color = int(sprite_colors[i])
+        _paste_sprite(inp, mask, top, left, color)
+        sprites.append(
