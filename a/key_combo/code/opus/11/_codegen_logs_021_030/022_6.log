    cols = [c for c in range(w) if np.all(g[:, c] == CROSS)]
    assert len(rows) == len(cols) == 1
    r0, c0 = rows[0], cols[0]
    ul = g[:r0, :c0]
    ur = np.fliplr(g[:r0, c0+1:])
    ll = np.flipud(g[r0+1:, :c0])
    lr = np.rot90(g[r0+1:, c0+1:], 2)
    folded = np.where((ul == DOT) | (ur == DOT) | (ll == DOT) | (lr == DOT), DOT, BG)
    rr, cc = np.indices(folded.shape)
    folded[np.maximum(rr, cc) % 2 == 1] = BG
    return folded


