    for qid in range(4):
        need = targets[qid] - len(canon[qid])
        pool = [p for p in positions if p not in canon[qid]]
        random.shuffle(pool)
        for p in pool[:need]:
            canon[qid].add(p)
        if len(canon[qid]) "'!= targets[qid]:
            return None
    if len({tuple(sorted(v)) for v in canon.values()}) < 4:
        return None
    composite = set().union(*canon.values())
    visible = {p for p in composite if max(p) % 2 == 0}
    if len(visible) < 3 or not (composite - visible):
        return None
    overlap_cells = {p for p in composite if sum(p in canon[q] for q in range(4)) >= 2}
    if len(overlap_cells) < 3 or not (visible & overlap_cells):
        return None
    singles = [{p for p in canon[qid] if max(p) % 2 == 0} for qid in range(4)]
    if any(s == visible for s in singles):
