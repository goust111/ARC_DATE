    counts.append(np.count_nonzero(g[q+1:,:q] == DOT))
    counts.append(np.count_nonzero(g[q+1:,q+1:] == DOT))
    if not all(2 <= c <= 4 for c in counts):
        return None
    return q, canon, raw_sets, g, visible, composite

