import random
import numpy as np

BG, CROSS, DOT = 0, 3, 4
QUADS = ('ul','ur','ll','lr')

TEMPLATES = [
    [(0,1),(0,2),(1,3)],
    [(0,1),(2,3),(0,3)],
    [(0,2),(1,2),(1,3)],
    [(0,1,2),(1,3),(0,2,3)],
    [(0,1),(0,2,3),(1,2,3)],
]

def maxd(p):
    return max(p)

def raw_from_canon(qid, q, pos):
    r, c = pos
    if qid == 0:
        return (r, c)
    if qid == 1:
        return (r, q - 1 - c)
    if qid == 2:
        return (q - 1 - r, c)
    return (q - 1 - r, q - 1 - c)

def attempt():
    q = random.randint(5, 10)
