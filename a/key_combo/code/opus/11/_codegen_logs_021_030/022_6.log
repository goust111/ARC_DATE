+    if quadrant_id == 2:
+        return half - 1 - r, c
+    return half - 1 - r, half - 1 - c
+
+
+def _build_grid(half: int, quadrant_positions: dict[int, set[tuple[int, int]]]) -> np.ndarray:
+    side = 2 * half + 1
