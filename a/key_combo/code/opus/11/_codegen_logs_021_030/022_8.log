def _gen_small_slalom(n: int) -> np.ndarray:
    g = np.zeros((n, n), dtype=int)
    mid_choices = [n // 2 + offset for offset in SMALL_MID_OFFSETS]
    e0 = random.choice(mid_choices)
    s1 = random.choice(mid_choices)
    if n == 5 and e0 == 2 and s1 == 3:
