GEN_MAX_ATTEMPTS = 300
GEN_VARIANTS = ("small", "large", "turn6", "turn7", "turn8", "five", "dense", "density")
GEN_VARIANT_WEIGHTS = (2, 3, 2, 2, 1, 1, 1, 3)

# Validation bounds from the task spec.
