+    prev_obj = None
+    prev_far = None
+    for idx, obj in enumerate(order):
+        coords = obj["coords"]
+        r0, c0, r1, c1 = obj["bbox"]
+        height = _bbox_h(obj["bbox"])
+        width = _bbox_w(obj["bbox"])
