+        cur = axis_len - 2 - lead_gap
+        for idx, obj in enumerate(objs):
+            pos.append(cur)
+            cur -= obj["height"]
+            if idx < len(objs) - 1:
+                cur -= inner_gaps[idx]
+    elif side == "left":
+        cur = 1 + lead_gap
+        for idx, obj in enumerate(objs):
+            pos.append(cur)
+            cur += obj["width"]
+            if idx < len(objs) - 1:
+                cur += inner_gaps[idx]
+    else:
+        cur = axis_len - 2 - lead_gap
