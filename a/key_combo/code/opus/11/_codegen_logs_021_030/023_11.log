+    order = sorted(objects, key=lambda obj: _sort_key(obj, side))
+    if reverse_order:
+        order = list(reversed(order))
+
+    out = np.full_like(g, BG)
+    if side == "top":
+        out[0, :] = MARKER
+    elif side == "bottom":
+        out[-1, :] = MARKER
+    elif side == "left":
+        out[:, 0] = MARKER
+    else:
+        out[:, -1] = MARKER
