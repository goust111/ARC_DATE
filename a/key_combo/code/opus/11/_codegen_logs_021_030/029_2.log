+            tiled = np.tile(seed, (h // sub_h, w // sub_w))
+            if np.array_equal(tiled, tile):
+                return True
+    return False
+
+
+def _damage_sites(tile: np.ndarray, symmetry: str) -> list[tuple[int, int]]:
+    h, w = map(int, tile.shape)
+    sites: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
