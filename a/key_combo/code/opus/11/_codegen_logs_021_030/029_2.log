+        rr = int(damage_origin[0] + local_site[0])
+        cc = int(damage_origin[1] + local_site[1])
+        pr = int(damage_origin[0] + partner[0])
+        pc = int(damage_origin[1] + partner[1])
+        if int(grid[rr, cc]) != MAGENTA:
+            return False
+        if int(grid[pr, pc]) == MAGENTA:
