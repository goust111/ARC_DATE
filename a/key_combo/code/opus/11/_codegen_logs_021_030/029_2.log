+    tiles = list(_iter_tiles(grid, tile_h, tile_w))
+    damaged = [(r0, c0, tile.copy()) for r0, c0, tile in tiles if np.any(tile == MAGENTA)]
+    normal = [tile.copy() for _r0, _c0, tile in tiles if not np.any(tile == MAGENTA)]
