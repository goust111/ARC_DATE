+BG = int(Color.BLACK)
+SAFE_COLORS = tuple(
+    color for color in Color.NOT_BLACK if int(color) != MAGENTA
+)
+GEN_RETRIES = 400
+LAYOUTS = (
+    (3, 3, 4, 4),
+    (4, 3, 3, 4),
+)
