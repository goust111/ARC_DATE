+    width = left_margin + STEP * (total_slots - 1) + PATCH_SIZE + right_margin
+    height = max(full_tops) + PATCH_SIZE + rng.randint(0, 3)
+    if max(height, width) > 30:
+        raise AssertionError("grid too large")
