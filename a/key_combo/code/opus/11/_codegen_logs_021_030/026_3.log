+BODY = 2
+STEP = 4
+PATCH_SIZE = 3
+TOTAL_SLOT_CHOICES = (4, 5)
+PERIOD_CHOICES = (2, 3)
+CENTER_POOL = (1, 3, 4, 6, 8, 9)
+MAX_ATTEMPTS = 400
