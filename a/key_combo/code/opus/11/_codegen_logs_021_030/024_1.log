+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [2, 3, 4, 8]
+BASE_SHAPES = [
+    ((0, 0), (0, 1)),
+    ((0, 0), (0, 1), (0, 2)),
+    ((0, 0), (1, 0), (1, 1)),
+    ((0, 1), (1, 0), (1, 1)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 0), (0, 1), (1, 1), (1, 2)),
+    ((0, 1), (1, 0), (1, 1), (1, 2)),
