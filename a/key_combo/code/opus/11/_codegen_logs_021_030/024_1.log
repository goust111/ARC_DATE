+                "color": int(component["color"]),
+                "original_coords": coords,
+                "settled_coords": dest,
+                "bbox": component["bbox"],
+                "original_right": int(c1),
+                "original_left": int(c0),
+                "distance": int(shift),
+                "seed": seed,
+                "blocked_by_wall": blocked_by_wall,
+                "blocked_by_object": blocked_by_object,
