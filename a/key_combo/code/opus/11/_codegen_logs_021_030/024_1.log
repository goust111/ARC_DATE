    remaining = total_pixels - sum(counts.values())
    recipients = other_colors + ([_GEN_BRACKET_COLOR] if include_bracket_color else [])
    while remaining > 0:
        eligible = [color for color in recipients if counts[color] < _GEN_MAX_OTHER_COLOR_COUNT]
