+
+def _ring_cells(seed: tuple[int, int], radius: int, shape: tuple[int, int]) -> set[tuple[int, int]]:
+    if radius <= 0:
+        return set()
+    h, w = shape
+    sr, sc = seed
+    cells = set()
+    top = sr - radius
+    bottom = sr + radius
+    left = sc - radius
