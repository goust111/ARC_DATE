    left_widths = _gen_width_options(height, left_area)
    right_widths = _gen_width_options(height, right_area)
    pairs = [(lw, rw) for lw in left_widths for rw in right_widths if lw + rw <= grid_width - 1]
    random.shuffle(pairs)
