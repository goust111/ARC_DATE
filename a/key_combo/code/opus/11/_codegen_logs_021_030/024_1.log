+
+def _render_from_infos(
+    infos: list[dict],
+    shape: tuple[int, int],
+    *,
+    seed_mode: str = "settled",
+    distance_mode: str = "actual",
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
