+                )
+            )
+            if blocked_by_wall or blocked_by_object:
+                break
+            shift += 1
+
+        dest = coords.copy()
+        dest[:, 1] += shift
+        occupied[dest[:, 0], dest[:, 1]] = True
+        seed = (
+            _round_half_up(float(dest[:, 0].mean())),
+            _round_half_up(float(dest[:, 1].mean())),
