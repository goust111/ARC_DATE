+    for alt_dir in DIRS:
+        for alt_d in info["counts"].values():
+            if alt_dir == info["direction"] and alt_d == info["distance"]:
+                continue
+            alt = set(
+                _translate_blue(
+                    info["blue_cells"],
+                    alt_dir,
+                    alt_d,
+                    info["shape"],
+                    info["sep_r"],
+                    info["sep_c"],
+                )[0]
