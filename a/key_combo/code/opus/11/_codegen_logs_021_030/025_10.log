+
+
+def _blue_uniqueness_ok(info: dict) -> bool:
+    actual = set(
+        _translate_blue(
+            info["blue_cells"],
+            info["direction"],
+            info["distance"],
+            info["shape"],
+            info["sep_r"],
+            info["sep_c"],
+        )[0]
+    )
+    if len(actual) < 2:
