   266	) -> list[tuple[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...], str]]:
   267	    bounds = _region_bounds(h, w, sep_r, sep_c)
   268	    shape_h = 1 + max(r for r, _ in shape_cells)
   269	    shape_w = 1 + max(c for _, c in shape_cells)
   270	    out = []
   271	
   272	    for region_key, (r0, r1, c0, c1) in bounds.items():
   273	        if r1 - r0 + 1 < shape_h or c1 - c0 + 1 < shape_w:
   274	            continue
   275	        for base_r in range(r0, r1 - shape_h + 2):
   276	            for base_c in range(c0, c1 - shape_w + 2):
   277	                src = tuple(sorted((base_r + dr, base_c + dc) for dr, dc in shape_cells))
   278	                moved, oob, divider = _translate_blue(src, direction, distance, (h, w), sep_r, sep_c)
   279	                if len(moved) < 2 or not _connected(moved):
   280	                    continue
   281	                if marker in moved:
   282	                    continue
   283	                if moved == src:
   284	                    continue
   285	                crossed = _crosses_relevant_divider(src, moved, direction, sep_r, sep_c)
   286	                ok = False
   287	                if scenario == "plain":
   288	                    ok = oob == 0 and divider == 0 and not crossed
   289	                elif scenario == "boundary_clip":
   290	                    ok = oob > 0 and divider == 0
   291	                elif scenario == "divider_clip":
   292	                    ok = divider > 0 and oob == 0
   293	                elif scenario == "cross_divider":
   294	                    ok = oob == 0 and divider == 0 and crossed
   295	                if ok:
   296	                    out.append((src, moved, region_key))
   297	    return out
   298	
   299	
   300	def _orange_points(
   301	    bbox: tuple[int, int, int, int],
   302	    count: int,
   303	    blocked: set[tuple[int, int]],
   304	) -> list[tuple[int, int]] | None:
   305	    r0, r1, c0, c1 = bbox
   306	    cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1) if (r, c) not in blocked]
   307	    if len(cells) < count:
   308	        return None
   309	    for radius in (1, 0):
   310	        for _ in range(200):
   311	            picks = random.sample(cells, count)
   312	            good = True
   313	            for i, (r1_, c1_) in enumerate(picks):
   314	                for r2_, c2_ in picks[i + 1 :]:
   315	                    if max(abs(r1_ - r2_), abs(c1_ - c2_)) <= radius:
   316	                        good = False
   317	                        break
   318	                if not good:
   319	                    break
   320	            if good:
   321	                return picks
   322	    return None
   323	
   324	
   325	def _halo(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
   326	    out = set(cells)
   327	    for r, c in list(cells):
   328	        for dr in (-1, 0, 1):
   329	            for dc in (-1, 0, 1):
   330	                nr = r + dr
   331	                nc = c + dc
   332	                if 0 <= nr < h and 0 <= nc < w:
   333	                    out.add((nr, nc))
   334	    return out
   335	
   336	
   337	def _counts_assignment() -> dict[str, int]:
   338	    if random.random() < 0.5:
   339	        values = [1, 2, 3, 4]
   340	    else:
   341	        missing = random.choice([1, 2, 3, 4])
   342	        values = [v for v in [1, 2, 3, 4, 5] if v != missing]
   343	    random.shuffle(values)
   344	    return {key: values[i] for i, key in enumerate(REGION_KEYS)}
   345	
   346	
   347	def _blue_uniqueness_ok(info: dict) -> bool:
   348	    actual = set(
   349	        _translate_blue(
   350	            info["blue_cells"],
   351	            info["direction"],
   352	            info["distance"],
   353	            info["shape"],
   354	            info["sep_r"],
   355	            info["sep_c"],
   356	        )[0]
   357	    )
   358	    if len(actual) < 2:
   359	        return False
   360	    for alt_dir in DIRS:
   361	        for alt_d in info["counts"].values():
   362	            if alt_dir == info["direction"] and alt_d == info["distance"]:
   363	                continue
   364	            alt = set(
   365	                _translate_blue(
   366	                    info["blue_cells"],
   367	                    alt_dir,
   368	                    alt_d,
   369	                    info["shape"],
   370	                    info["sep_r"],
   371	                    info["sep_c"],
   372	                )[0]
   373	            )
   374	            if alt == actual:
   375	                return False
   376	    return True
   377	
   378	
   379	def _instance_checks(inp: np.ndarray) -> bool:
   380	    try:
   381	        info = _analyze_grid(inp)
   382	        out = main(inp)
   383	    except Exception:
   384	        return False
   385	
   386	    if not np.array_equal(out[info["sep_r"], :], inp[info["sep_r"], :]):
   387	        return False
   388	    if not np.array_equal(out[:, info["sep_c"]], inp[:, info["sep_c"]]):
   389	        return False
   390	    if out[info["marker"]] != RED:
   391	        return False
   392	    if not _blue_uniqueness_ok(info):
   393	        return False
   394	
   395	    actual_winner_orange = {(int(r), int(c)) for r, c in np.argwhere(out == ORANGE)}
   396	    if actual_winner_orange != info["orange_cells"][info["winner"]]:
   397	        return False
   398	
   399	    for wrong in REGION_KEYS:
   400	        if wrong == info["winner"]:
   401	            continue
   402	        if info["orange_cells"][wrong] == actual_winner_orange:
   403	            return False
   404	    return True
   405	
   406	
   407	def _gen_attempt() -> np.ndarray | None:
   408	    h, w, top_h, _bottom_h, left_w, _right_w = _choose_dimensions()
   409	    sep_r = top_h
   410	    sep_c = left_w
   411	    direction = random.choice(tuple(DIRS))
   412	    scenario = random.choice(SCENARIOS)
   413	    counts = _counts_assignment()
   414	    distance = max(counts.values())
   415	    marker = _place_marker(h, w, sep_r, sep_c, direction)
   416	    shape_cells = _random_shape()
   417	
   418	    candidates = _blue_candidates(shape_cells, h, w, sep_r, sep_c, marker, direction, distance, scenario)
   419	    if not candidates:
   420	        return None
   421	    blue_cells, moved_cells, _blue_region = random.choice(candidates)
   422	    winner = max(counts, key=counts.get)
   423	    bounds = _region_bounds(h, w, sep_r, sep_c)
   424	
   425	    grid = np.full((h, w), BG, dtype=int)
   426	    grid[sep_r, :] = GREY
   427	    grid[:, sep_c] = GREY
   428	    grid[marker] = RED
   429	    for r, c in blue_cells:
   430	        grid[r, c] = BLUE
   431	
   432	    for key in REGION_KEYS:
   433	        blocked = set(blue_cells)
   434	        if key == winner:
   435	            blocked |= set(moved_cells)
   436	        blocked = _halo(blocked, h, w)
   437	        points = _orange_points(bounds[key], counts[key], blocked)
   438	        if points is None:
   439	            return None
   440	        for r, c in points:
   441	            if grid[r, c] != BG:
   442	                return None
   443	            grid[r, c] = ORANGE
   444	
   445	    info = _analyze_grid(grid)
   446	    if info["distance"] != distance or info["direction"] != direction or info["winner"] != winner:
   447	        return None
   448	    if set(info["blue_cells"]) != set(blue_cells):
   449	        return None
   450	    pred = main(grid)
   451	
   452	    expected = grid.copy()
   453	    expected[expected == ORANGE] = BG
   454	    expected[expected == BLUE] = BG
   455	    for r, c in info["orange_cells"][winner]:
   456	        expected[r, c] = ORANGE
   457	    for r, c in moved_cells:
   458	        expected[r, c] = BLUE
   459	    if not np.array_equal(pred, expected):
   460	        return None

diff --git a/key_combo/code/opus/11/025/10.py b/key_combo/code/opus/11/025/10.py
new file mode 100644
index 0000000000000000000000000000000000000000..31c845105ebbea042a588691fef7377485c18331
--- /dev/null
+++ b/key_combo/code/opus/11/025/10.py
@@ -0,0 +1,471 @@
+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREY = 5
+ORANGE = 7
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+REGION_KEYS = ("tl", "tr", "bl", "br")
+SCENARIOS = ("plain", "boundary_clip", "divider_clip", "cross_divider")
+GEN_ATTEMPTS = 600
+
+BASE_SHAPES = [
+    {(0, 0), (0, 1), (1, 0)},
+    {(0, 0), (1, 0), (2, 0)},
+    {(0, 0), (0, 1), (1, 1)},
+    {(0, 0), (1, 0), (2, 0), (2, 1)},
+    {(0, 1), (1, 0), (1, 1), (1, 2)},
+    {(0, 0), (0, 1), (1, 1), (2, 1)},
+    {(0, 1), (1, 0), (1, 1), (1, 2), (2, 1)},
+    {(0, 0), (0, 1), (0, 2), (1, 1), (2, 1)},
+    {(0, 0), (1, 0), (1, 1), (2, 1), (2, 2)},
+]
+
+
+def _normalize(cells: set[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return tuple(sorted((r - r0, c - c0) for r, c in cells))
+
+
+def _random_shape() -> tuple[tuple[int, int], ...]:
+    cells = set(random.choice(BASE_SHAPES))
+    if random.random() < 0.5:
+        cells = {(c, r) for r, c in cells}
+    if random.random() < 0.5:
+        mr = max(r for r, _ in cells)
+        cells = {(mr - r, c) for r, c in cells}
+    if random.random() < 0.5:
+        mc = max(c for _, c in cells)
+        cells = {(r, mc - c) for r, c in cells}
+    return _normalize(cells)
+
+
+def _connected(cells: list[tuple[int, int]] | tuple[tuple[int, int], ...] | set[tuple[int, int]]) -> bool:
+    pts = {tuple(cell) for cell in cells}
+    if not pts:
+        return False
+    seen = set()
+    queue = deque([next(iter(pts))])
+    while queue:
+        r, c = queue.popleft()
+        if (r, c) in seen:
+            continue
+        seen.add((r, c))
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if (nr, nc) in pts and (nr, nc) not in seen:
+                queue.append((nr, nc))
+    return seen == pts
+
+
+def _find_dividers(grid: np.ndarray) -> tuple[int, int]:
+    sep_rows = np.where(np.all(grid == GREY, axis=1))[0]
+    sep_cols = np.where(np.all(grid == GREY, axis=0))[0]
+    assert len(sep_rows) == 1 and len(sep_cols) == 1, "expected one full grey row and one full grey column"
+    return int(sep_rows[0]), int(sep_cols[0])
+
+
+def _region_bounds(h: int, w: int, sep_r: int, sep_c: int) -> dict[str, tuple[int, int, int, int]]:
+    return {
+        "tl": (0, sep_r - 1, 0, sep_c - 1),
+        "tr": (0, sep_r - 1, sep_c + 1, w - 1),
+        "bl": (sep_r + 1, h - 1, 0, sep_c - 1),
+        "br": (sep_r + 1, h - 1, sep_c + 1, w - 1),
+    }
+
+
+def _translate_blue(
+    cells: list[tuple[int, int]] | tuple[tuple[int, int], ...],
+    direction: str,
+    distance: int,
+    shape: tuple[int, int],
+    sep_r: int,
+    sep_c: int,
+) -> tuple[tuple[tuple[int, int], ...], int, int]:
+    h, w = map(int, shape)
+    dr, dc = DIRS[direction]
+    kept = []
+    out_count = 0
+    divider_count = 0
+    for r, c in cells:
+        nr = int(r + dr * distance)
+        nc = int(c + dc * distance)
+        if nr < 0 or nr >= h or nc < 0 or nc >= w:
+            out_count += 1
+            continue
+        if nr == sep_r or nc == sep_c:
+            divider_count += 1
+            continue
+        kept.append((nr, nc))
+    return tuple(sorted(set(kept))), int(out_count), int(divider_count)
+
+
+def _analyze_grid(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = map(int, g.shape)
+    sep_r, sep_c = _find_dividers(g)
+    bounds = _region_bounds(h, w, sep_r, sep_c)
+
+    red_cells = np.argwhere(g == RED)
+    assert red_cells.shape[0] == 1, "expected exactly one red marker"
+    marker = tuple(map(int, red_cells[0]))
+    mr, mc = marker
+    assert mr in (0, h - 1) or mc in (0, w - 1), "red marker must be on the boundary"
+    assert marker not in ((0, 0), (0, w - 1), (h - 1, 0), (h - 1, w - 1)), "red marker must not be a corner"
+    if mr == 0:
+        direction = "up"
+    elif mr == h - 1:
+        direction = "down"
+    elif mc == 0:
+        direction = "left"
+    else:
+        direction = "right"
+
+    blue_cells = [tuple(map(int, rc)) for rc in np.argwhere(g == BLUE)]
+    assert 3 <= len(blue_cells) <= 5, "blue object must have 3-5 pixels"
+    assert _connected(blue_cells), "blue object must be 4-connected"
+
+    counts = {}
+    orange_cells = {}
+    for key, (r0, r1, c0, c1) in bounds.items():
+        region = g[r0 : r1 + 1, c0 : c1 + 1]
+        counts[key] = int(np.sum(region == ORANGE))
+        local = np.argwhere(region == ORANGE)
+        orange_cells[key] = {(int(r0 + rr), int(c0 + cc)) for rr, cc in local}
+
+    count_values = list(counts.values())
+    assert len(set(count_values)) == 4, "region orange counts must be distinct"
+    assert all(1 <= v <= 5 for v in count_values), "region orange counts must be within 1..5"
+    winner = max(counts, key=counts.get)
+    distance = int(counts[winner])
+    return {
+        "shape": (h, w),
+        "sep_r": sep_r,
+        "sep_c": sep_c,
+        "bounds": bounds,
+        "marker": marker,
+        "direction": direction,
+        "blue_cells": tuple(sorted(blue_cells)),
+        "counts": counts,
+        "orange_cells": orange_cells,
+        "winner": winner,
+        "distance": distance,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Keep only the orange votes in the densest partition, then slide the blue object by that winning vote count.
+
+    Input structure:
+    - Black background contains one full grey horizontal divider row and one full grey vertical divider column.
+    - The dividers split the grid into four rectangular regions containing scattered orange vote pixels.
+    - A single 4-connected blue object lies inside one region, and a single red boundary marker sits on one non-corner edge cell.
+
+    Rule:
+    - Detect the grey divider row and column to recover the four regions.
+    - Count orange pixels in each region, keep only the unique densest region's orange pixels, and erase orange pixels in the other three regions.
+    - Use that maximum orange count as distance D, read the red marker's edge as the slide direction, and translate the blue object by D cells.
+    - Drop translated blue pixels that land outside the grid or on the grey divider row/column; keep the grey dividers and red marker unchanged.
+
+    Key insight:
+    The orange votes do two jobs at once: they identify the winning region visually and they encode the blue object's slide distance numerically.
+    """
+    g = np.asarray(grid, dtype=int)
+    info = _analyze_grid(g)
+    out = g.copy()
+    out[out == ORANGE] = BG
+    out[out == BLUE] = BG
+
+    for r, c in info["orange_cells"][info["winner"]]:
+        out[r, c] = ORANGE
+
+    moved, _oob, _divider = _translate_blue(
+        info["blue_cells"],
+        info["direction"],
+        info["distance"],
+        info["shape"],
+        info["sep_r"],
+        info["sep_c"],
+    )
+    for r, c in moved:
+        if out[r, c] not in (GREY, RED):
+            out[r, c] = BLUE
+    return out
+
+
+def _choose_dimensions() -> tuple[int, int, int, int, int, int]:
+    top_h = random.randint(5, 8)
+    bottom_h = random.randint(5, 8)
+    left_w = random.randint(5, 8)
+    right_w = random.randint(5, 8)
+    h = top_h + 1 + bottom_h
+    w = left_w + 1 + right_w
+    return h, w, top_h, bottom_h, left_w, right_w
+
+
+def _marker_candidates(length: int, blocked_index: int) -> list[int]:
+    lo = max(1, length // 2 - 2)
+    hi = min(length - 2, length // 2 + 2)
+    preferred = [i for i in range(lo, hi + 1) if i != blocked_index]
+    if preferred:
+        return preferred
+    return [i for i in range(1, length - 1) if i != blocked_index]
+
+
+def _place_marker(h: int, w: int, sep_r: int, sep_c: int, direction: str) -> tuple[int, int]:
+    if direction == "up":
+        return 0, random.choice(_marker_candidates(w, sep_c))
+    if direction == "down":
+        return h - 1, random.choice(_marker_candidates(w, sep_c))
+    if direction == "left":
+        return random.choice(_marker_candidates(h, sep_r)), 0
+    return random.choice(_marker_candidates(h, sep_r)), w - 1
+
+
+def _relevant_side(cells: tuple[tuple[int, int], ...], direction: str, sep_r: int, sep_c: int) -> str:
+    if direction in ("left", "right"):
+        return "left" if all(c < sep_c for _, c in cells) else "right"
+    return "top" if all(r < sep_r for r, _ in cells) else "bottom"
+
+
+def _crosses_relevant_divider(
+    src: tuple[tuple[int, int], ...],
+    dst: tuple[tuple[int, int], ...],
+    direction: str,
+    sep_r: int,
+    sep_c: int,
+) -> bool:
+    return _relevant_side(src, direction, sep_r, sep_c) != _relevant_side(dst, direction, sep_r, sep_c)
+
+
+def _blue_candidates(
+    shape_cells: tuple[tuple[int, int], ...],
+    h: int,
+    w: int,
+    sep_r: int,
+    sep_c: int,
+    marker: tuple[int, int],
+    direction: str,
+    distance: int,
+    scenario: str,
+) -> list[tuple[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...], str]]:
+    bounds = _region_bounds(h, w, sep_r, sep_c)
+    shape_h = 1 + max(r for r, _ in shape_cells)
+    shape_w = 1 + max(c for _, c in shape_cells)
+    out = []
+
+    for region_key, (r0, r1, c0, c1) in bounds.items():
+        if r1 - r0 + 1 < shape_h or c1 - c0 + 1 < shape_w:
+            continue
+        for base_r in range(r0, r1 - shape_h + 2):
+            for base_c in range(c0, c1 - shape_w + 2):
+                src = tuple(sorted((base_r + dr, base_c + dc) for dr, dc in shape_cells))
+                moved, oob, divider = _translate_blue(src, direction, distance, (h, w), sep_r, sep_c)
+                if len(moved) < 2 or not _connected(moved):
+                    continue
+                if marker in moved:
+                    continue
+                if moved == src:
+                    continue
+                crossed = _crosses_relevant_divider(src, moved, direction, sep_r, sep_c)
+                ok = False
+                if scenario == "plain":
+                    ok = oob == 0 and divider == 0 and not crossed
+                elif scenario == "boundary_clip":
+                    ok = oob > 0 and divider == 0
+                elif scenario == "divider_clip":
+                    ok = divider > 0 and oob == 0
+                elif scenario == "cross_divider":
+                    ok = oob == 0 and divider == 0 and crossed
+                if ok:
+                    out.append((src, moved, region_key))
+    return out
+
+
+def _orange_points(
+    bbox: tuple[int, int, int, int],
+    count: int,
+    blocked: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    r0, r1, c0, c1 = bbox
+    cells = [(r, c) for r in range(r0, r1 + 1) for c in range(c0, c1 + 1) if (r, c) not in blocked]
+    if len(cells) < count:
+        return None
+    for radius in (1, 0):
+        for _ in range(200):
+            picks = random.sample(cells, count)
+            good = True
+            for i, (r1_, c1_) in enumerate(picks):
+                for r2_, c2_ in picks[i + 1 :]:
+                    if max(abs(r1_ - r2_), abs(c1_ - c2_)) <= radius:
+                        good = False
+                        break
+                if not good:
+                    break
+            if good:
+                return picks
+    return None
+
+
+def _halo(cells: set[tuple[int, int]], h: int, w: int) -> set[tuple[int, int]]:
+    out = set(cells)
+    for r, c in list(cells):
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if 0 <= nr < h and 0 <= nc < w:
+                    out.add((nr, nc))
+    return out
+
+
+def _counts_assignment() -> dict[str, int]:
+    if random.random() < 0.5:
+        values = [1, 2, 3, 4]
+    else:
+        missing = random.choice([1, 2, 3, 4])
+        values = [v for v in [1, 2, 3, 4, 5] if v != missing]
+    random.shuffle(values)
+    return {key: values[i] for i, key in enumerate(REGION_KEYS)}
+
+
+def _blue_uniqueness_ok(info: dict) -> bool:
+    actual = set(
+        _translate_blue(
+            info["blue_cells"],
+            info["direction"],
+            info["distance"],
+            info["shape"],
+            info["sep_r"],
+            info["sep_c"],
+        )[0]
+    )
+    if len(actual) < 2:
+        return False
+    for alt_dir in DIRS:
+        for alt_d in info["counts"].values():
+            if alt_dir == info["direction"] and alt_d == info["distance"]:
+                continue
+            alt = set(
+                _translate_blue(
+                    info["blue_cells"],
+                    alt_dir,
+                    alt_d,
+                    info["shape"],
+                    info["sep_r"],
+                    info["sep_c"],
+                )[0]
+            )
+            if alt == actual:
+                return False
+    return True
+
+
+def _instance_checks(inp: np.ndarray) -> bool:
+    try:
+        info = _analyze_grid(inp)
+        out = main(inp)
+    except Exception:
