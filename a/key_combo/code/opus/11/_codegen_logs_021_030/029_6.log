+
+
+def _move_red_marker(inp: np.ndarray, origin: Coord, old_step: Coord, new_corner: Coord) -> np.ndarray:
+    out = inp.copy()
+    old_r, old_c = STEP_TO_CORNER[old_step]
+    out[origin[0] + old_r, origin[1] + old_c] = BLUE
