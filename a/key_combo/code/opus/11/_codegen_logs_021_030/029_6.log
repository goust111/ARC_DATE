0022: def main(grid: np.ndarray) -> np.ndarray:
0023:     """
0024:     Extend the 2x2 seed diagonally from each red corner, recoloring every stamped cell with the seed's non-red color.
0025: 
0026:     Input structure
0027:     - The grid has a dominant background color.
0028:     - All foreground pixels form one full 2x2 seed block.
0029:     - The seed contains one non-red paint color and one or more red corner control pixels.
0030: 
0031:     Rule
0032:     - Replace every red control pixel with the paint color.
0033:     - A red pixel in the top-left, top-right, bottom-left, or bottom-right corner selects the matching diagonal direction.
0034:     - For each selected direction, repeatedly stamp a filled 2x2 square of the paint color one row and one column at a time until the square is fully outside the grid.
0035: 
0036:     Key insight
0037:     - The red pixels are not output colors; their corner positions encode the diagonal rays along which the 2x2 seed is copied.
0038:     """
0039:     g = np.asarray(grid, dtype=int)
0040:     assert g.ndim == 2
0041:     bg = int(get_bg(g))
0042: 
0043:     seed_bbox = bbox(g != bg)
0044:     assert seed_bbox is not None, "expected a foreground seed"
0045:     r0, c0, r1, c1 = seed_bbox
0046:     assert r1 - r0 == 1 and c1 - c0 == 1, "foreground seed must be exactly 2x2"
0047: 
0048:     seed = g[r0 : r1 + 1, c0 : c1 + 1]
0049:     assert np.all(seed != bg), "2x2 seed must be fully occupied"
0050:     paint_colors = {int(v) for v in np.unique(seed)} - {Color.RED}
0051:     assert len(paint_colors) == 1, "expected exactly one non-red seed color"
0052:     paint = paint_colors.pop()
0053: 
0054:     red_corners = np.argwhere(seed == Color.RED)
0055:     assert len(red_corners) > 0, "expected at least one red control corner"
0056: 
0057:     out = np.full_like(g, bg)
0058:     for local_r, local_c in red_corners:
0059:         step_r = -1 if int(local_r) == 0 else 1
