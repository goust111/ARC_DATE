+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+STAMP_SIZE = 3
+STEP = 3
+GEN_RETRY_LIMIT = 800
+GEN_GRID_RANGE = (13, 18)  # high is exclusive
+GEN_EXTRA_STAMP_CHOICES = (2, 3)
