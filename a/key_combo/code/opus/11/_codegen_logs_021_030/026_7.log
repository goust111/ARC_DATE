+            qh, qw = sprite.shape
+            dr = int(rng.integers(0, quadrant_size - qh + 1))
+            dc = int(rng.integers(0, quadrant_size - qw + 1))
+            slot_r0, _slot_r1, slot_c0, _slot_c1 = slots[src_idx]
+            _paste_sprite(grid, sprite, slot_r0 + base_r + dr, slot_c0 + base_c + dc)
