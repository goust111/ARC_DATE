+        if len(np.unique(core)) < 2:
+            continue
+        if np.all(core == core[0, 0]):
+            continue
+        return core
+    return None
+
+
+def _legend_positions(shape: tuple[int, int], corner: str, layout: str) -> list[tuple[int, int]]:
