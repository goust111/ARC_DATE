            color = target[0][j]
        elif row_idx == len(wall_rows) - 1:
            color = target[-1][j]
        elif target[row_idx - 1][j] == target[row_idx][j]:
            color = target[row_idx][j]
        else:
            continue
        for c in cols:
            out.append((wall_rows[row_idx], c, color))
    random.shuffle(out)
    return out


def _gen_col_candidates(col_idx, wall_cols, row_bands, target):
    out = []
