def _gen_cd3c21df_color_sets(palette: list[int]) -> list[tuple[int, ...]]:
    colors = palette[:]
    random.shuffle(colors)
    sets = [{colors[i]} for i in range(BASE_SPRITE_COUNT)]
    for color in colors[BASE_SPRITE_COUNT:]:
