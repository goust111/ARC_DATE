+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _find_objects(grid: np.ndarray) -> list[dict]:
+    """Return non-background 4-connected monochrome components."""
+    h, w = grid.shape
