+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+
+            rows = [rr for rr, _ in coords]
+            cols = [cc for _, cc in coords]
+            bbox = (min(rows), min(cols), max(rows), max(cols))
+            objects.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "coord_set": set(coords),
+                    "bbox": bbox,
+                    "area": len(coords),
+                }
+            )
+    return objects
+
+
