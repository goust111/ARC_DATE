+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            break
+    else:
+        raise RuntimeError("failed to generate a valid puzzle-6 input")
+
+    for _ in range(SELF_CHECKS):
+        _validate_input(grid)
+    return grid

