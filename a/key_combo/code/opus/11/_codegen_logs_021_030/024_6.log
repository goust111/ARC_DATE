+    g = np.asarray(grid, dtype=int)
+    info = _analyze(g)
+    r0, c0, r1, c1 = info["bbox"]
+    winners = info["winners"]
+    r_mid = r0 + (r1 - r0 + 1) // 2
+    c_mid = c0 + (c1 - c0 + 1) // 2
