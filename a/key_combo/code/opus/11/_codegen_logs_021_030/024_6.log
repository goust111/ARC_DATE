+
+    for region, items in expanded_objects:
+        for color in items:
+            if not _place_object(grid, reserved, region, color, (r0, c0, r1, c1), rng):
+                return None
+
+    try:
+        _validate_input(grid)
+    except AssertionError:
+        return None
+    return grid
+
