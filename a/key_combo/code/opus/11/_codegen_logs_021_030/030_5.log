+    line_records.append(first)
+    patch_boxes.append(first["box"])
+
+    second_index = 1
+    if force_collision:
+        target_cells = _candidate_target_cells(patterns[first["step"] - 1], first["center"])
+        rng.shuffle(target_cells)
