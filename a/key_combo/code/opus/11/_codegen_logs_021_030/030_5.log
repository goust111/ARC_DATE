+    is_bottom = len(bottom_grey_cols) == 3 and np.all(np.diff(bottom_grey_cols) == 4)
+    is_right = len(right_grey_rows) == 3 and np.all(np.diff(right_grey_rows) == 4)
+    assert is_bottom ^ is_right
