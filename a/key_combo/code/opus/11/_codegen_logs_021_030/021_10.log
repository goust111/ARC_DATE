+def _build_specs(k: int, branch: str) -> list[dict]:
+    specs: list[dict] = []
+    if branch == "horizontal":
+        specs.append({"side": "left", "role": "singleton", "sprite": _make_object_sprite(branch, "singleton")})
+        widths = random.sample([2, 3, 4, 5], k - 1)
+        random.shuffle(widths)
+        for width in widths:
