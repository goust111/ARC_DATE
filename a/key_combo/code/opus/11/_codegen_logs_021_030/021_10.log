+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+PALETTE_COLORS = (BLUE, RED, GREEN, YELLOW, PINK, ORANGE, TEAL)
