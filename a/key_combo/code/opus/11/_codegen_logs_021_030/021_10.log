+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(14, 17)
+    w = random.randint(16, 19)
+    k = random.randint(3, 5)
+    branch = random.choices(["mixed", "horizontal", "vertical"], weights=[5, 2, 2])[0]
