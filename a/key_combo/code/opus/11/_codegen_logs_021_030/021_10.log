+            for row in marker_rows:
+                top = int(row - edge_r)
+                candidates.add((top, left))
+    elif side == "right":
+        left = marker_left + mw
+        if left + w > grid_shape[1]:
+            return []
+        marker_rows = [marker_top + int(r) for r, c in marker_cells if int(c) == mw - 1]
+        sprite_rows = np.where(sprite[:, 0])[0]
+        for edge_r in sprite_rows:
+            for row in marker_rows:
+                top = int(row - edge_r)
