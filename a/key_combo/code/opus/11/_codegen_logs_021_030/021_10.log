+def _expanded_cells(coords: np.ndarray) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r, c in coords:
+        rr = int(r)
+        cc = int(c)
+        out.add((rr, cc))
+        out.add((rr - 1, cc))
+        out.add((rr + 1, cc))
+        out.add((rr, cc - 1))
+        out.add((rr, cc + 1))
+    return out
