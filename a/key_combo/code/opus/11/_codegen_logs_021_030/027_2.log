+            return False
+        if np.any(block_out == ORANGE):
+            return False
+        if np.array_equal(block_out == GREY, block_in == GREY):
+            return False
+        alternate = _rotate_pattern(pattern, "v" if orientation == "h" else "h")
+        if np.array_equal(block_out == GREY, alternate):
