+
+def _parse_orientation(orange_coords: np.ndarray) -> str:
+    cells = sorted(tuple(map(int, coord)) for coord in orange_coords)
+    (r0, c0), (r1, c1) = cells
+    if r0 == r1 and c1 == c0 + 1 and r0 in (0, 2):
+        return "h"
+    if c0 == c1 and r1 == r0 + 1 and c0 in (0, 2):
+        return "v"
