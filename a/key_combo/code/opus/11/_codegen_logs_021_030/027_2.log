+
+BLACK = 0
+GREY = 5
+ORANGE = 7
+
+BLOCK_SIZE = 3
+MACRO_SIDE = 5
+GRID_SIDE = BLOCK_SIZE * MACRO_SIDE
+GENERATION_RETRIES = 400
