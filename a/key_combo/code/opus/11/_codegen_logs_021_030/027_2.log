+        r0 = br * BLOCK_SIZE
+        c0 = bc * BLOCK_SIZE
+        block_in = inp[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE]
+        block_out = actual[r0 : r0 + BLOCK_SIZE, c0 : c0 + BLOCK_SIZE]
+        if np.count_nonzero(block_in == ORANGE) != 2:
+            return False
