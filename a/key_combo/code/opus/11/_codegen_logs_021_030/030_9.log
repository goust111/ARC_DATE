+GRID_WIDTH_RANGE = (13, 18)
+PREFIX_LEN_RANGE = (3, 6)
+MAX_GENERATION_ATTEMPTS = 500
+
+_GEN_CALL_COUNT = 0
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
