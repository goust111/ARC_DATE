+    if built is None:
+        return None
+
+    prefix, _path_cells = built
+    grid = _make_grid((height, width), prefix, start)
+    out = main(grid)
+    if not np.any(out == ORANGE):
+        return None
+    if not _validate_instance(grid):
+        return None
+    return grid
