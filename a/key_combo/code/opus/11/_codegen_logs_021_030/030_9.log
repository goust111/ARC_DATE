+    dr, dc = DIR_BY_COLOR[color]
+    r, c = start
+    cells: list[tuple[int, int]] = []
+    for _ in range(STEP_LEN):
+        r += dr
+        c += dc
+        if not _in_bounds(shape, r, c):
+            return cells, "bound"
