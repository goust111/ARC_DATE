+        (BLUE, RED, GREEN),
+        (RED, GREEN, YELLOW),
+        (BLUE, GREEN, YELLOW),
+        (BLUE, RED, YELLOW),
+        (BLUE, RED, GREEN, YELLOW),
+        (BLUE, RED, GREEN, YELLOW),
