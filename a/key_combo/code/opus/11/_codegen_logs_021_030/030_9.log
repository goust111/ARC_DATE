+    row_low = max(prefix_len + 1, 3)
+    row_high = height - 3
+    col_low = 2
+    col_high = width - 3
+    if row_low > row_high or col_low > col_high:
+        return None
+
+    start = (
+        int(rng.integers(row_low, row_high + 1)),
+        int(rng.integers(col_low, col_high + 1)),
