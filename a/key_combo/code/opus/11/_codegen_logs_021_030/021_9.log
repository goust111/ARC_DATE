+    return out
+
+
+def _region_values(length: int, family: str) -> list[int]:
+    mid = (length - 1) / 2.0
+    vals = [v for v in range(2, length - 2) if v != mid]
+    if family == "top":
+        return [v for v in vals if v < mid]
+    if family == "bottom":
