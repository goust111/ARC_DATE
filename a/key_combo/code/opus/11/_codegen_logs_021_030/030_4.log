+    frame_h = random.randint(*FRAME_SIDE_RANGE)
+    frame_w = random.randint(*FRAME_SIDE_RANGE)
+    height = random.randint(max(GRID_H_RANGE[0], frame_h + 6), GRID_H_RANGE[1])
