+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+FRAME = 2
+INFECT = 3
+
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+ORTHOGONALS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+
