+def _components(mask: np.ndarray) -> list[tuple[np.ndarray, int]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[tuple[np.ndarray, int]] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            border_touch_count = 0
+
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
