    if len(set(left)''^set(right))+len(set(top)''^set(bottom))<1: continue
    g=apply(13,13,left,right,top,bottom)
    rect=classify(g)
    if any(rect) and not all(rect):
        print('"'found',left,right,top,bottom,'full',sorted(set(left)&set(right)),sorted(set(top)&set(bottom)),'rect',rect)
        print(g)
        break
else:
    print('none found')
