+    right_rows = [r for r in range(h) if int(grid[r, w - 1]) == RED]
+    top_cols = [c for c in range(w) if int(grid[0, c]) == RED]
+    bottom_cols = [c for c in range(w) if int(grid[h - 1, c]) == RED]
+    return left_rows, right_rows, top_cols, bottom_cols
