import random, numpy as np
from collections import deque

def apply(h,w,left,right,top,bottom):
    full_rows=sorted(set(left)&set(right)); left_only=sorted(set(left)-set(right)); right_only=sorted(set(right)-set(left))
    full_cols=sorted(set(top)&set(bottom)); top_only=sorted(set(top)-set(bottom)); bottom_only=sorted(set(bottom)-set(top))
    g=np.zeros((h,w),int)
    for r in full_rows: g[r,:]=2
    for c in full_cols: g[:,c]=2
    # order left,right,top,bottom
    for r in left_only:
        c=0
        while c<w and g[r,c]"'!=2:
            g[r,c]=2; c+=1
    for r in right_only:
        c=w-1
        while c>=0 and g[r,c]!=2:
            g[r,c]=2; c-=1
    for c in top_only:
        r=0
        while r<h and g[r,c]!=2:
            g[r,c]=2; r+=1
    for c in bottom_only:
        r=h-1
        while r>=0 and g[r,c]!=2:
            g[r,c]=2; r-=1
    return g

def comps(mask):
    h,w=mask.shape;seen=np.zeros_like(mask,bool);out=[]
    for r in range(h):
      for c in range(w):
        if not mask[r,c] or seen[r,c]: continue
        q=deque([(r,c)]);seen[r,c]=1;pts=[]
        while q:
          rr,cc=q.popleft();pts.append((rr,cc))
          for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=rr+dr,cc+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
              seen[nr,nc]=1;q.append((nr,nc))
        out.append(pts)
    return out

def classify(g):
    rect=[]
    for pts in comps(g==0):
      rs=[r for r,c in pts]; cs=[c for r,c in pts]
      area=len(pts); box=(max(rs)-min(rs)+1)*(max(cs)-min(cs)+1)
      rect.append(area==box)
    return rect

rows=list(range(1,12)); cols=list(range(1,12))
for _ in range(1000000):
    lc=random.randint(2,3); rc=random.randint(2,3); tc=random.randint(2,3); bc=random.randint(2,3)
    left=sorted(random.sample(rows,lc)); right=sorted(random.sample(rows,rc)); top=sorted(random.sample(cols,tc)); bottom=sorted(random.sample(cols,bc))
    total=len(set(left)|set(right))+len(set(top)|set(bottom))
