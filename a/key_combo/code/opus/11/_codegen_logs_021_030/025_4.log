import numpy as np
from collections import deque

def draw(order):
    h=w=13
    full_rows=[4,8]; full_cols=[4,8]; left_rows=[5]; top_cols=[2]
    g=np.zeros((h,w),int)
    for r in full_rows:g[r,:]=2
    for c in full_cols:g[:,c]=2
    for item in order:
      if item=='L':
        for r in left_rows:
          c=0
          while c<w and g[r,c]"'!=2:
            g[r,c]=2;c+=1
      if item=='"'T':
        for c in top_cols:
          r=0
          while r<h and g[r,c]"'!=2:
            g[r,c]=2;r+=1
    return g

def comps(mask):
    h,w=mask.shape;seen=np.zeros_like(mask,bool);out=[]
    for r in range(h):
      for c in range(w):
        if not mask[r,c] or seen[r,c]: continue
        q=deque([(r,c)]);seen[r,c]=1;pts=[]
        while q:
          rr,cc=q.popleft();pts.append((rr,cc))
          for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=rr+dr,cc+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
              seen[nr,nc]=1;q.append((nr,nc))
        out.append(pts)
    return out

def classify(g):
    out=[]
    for pts in comps(g==0):
      rs=[r for r,c in pts]; cs=[c for r,c in pts]
      area=len(pts); box=(max(rs)-min(rs)+1)*(max(cs)-min(cs)+1)
      out.append((area,box,area==box))
    return out
for order in ['"'LT','TL']:
    g=draw(order)
    print(order,classify(g))
    print(g)
