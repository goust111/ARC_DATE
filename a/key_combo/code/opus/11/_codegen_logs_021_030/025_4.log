from __future__ import annotations
import numpy as np
from collections import deque, Counter

BG, BLUE, RED, YELLOW = 0,1,2,4
DIRS = {'L':(0,1),'R':(0,-1),'T':(1,0),'B':(-1,0)}


def components(mask):
    h,w=mask.shape
    seen=np.zeros((h,w),dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            pts=[]
            border=0
            while q:
                rr,cc=q.popleft()
                pts.append((rr,cc))
                if rr in (0,h-1) or cc in (0,w-1):
                    border += 1
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True
                        q.append((nr,nc))
            out.append((np.asarray(pts,dtype=int), border))
    return out


def parse(inp):
    h,w=inp.shape
    left=[r for r in range(h) if inp[r,0]==RED]
    right=[r for r in range(h) if inp[r,w-1]==RED]
    top=[c for c in range(w) if inp[0,c]==RED]
    bottom=[c for c in range(h) if inp[h-1,c]==RED]
    return left,right,top,bottom


def line_mask(inp):
    h,w=inp.shape
    left,right,top,bottom=parse(inp)
    full_rows=sorted(set(left)&set(right))
    full_cols=sorted(set(top)&set(bottom))
    line=np.zeros((h,w),dtype=bool)
    for r in full_rows: line[r,:]=True
    for c in full_cols: line[:,c]=True
    rays=[]
    for r in sorted(set(left)-set(right)):
        rays.append([r,0,*DIRS['L'],True,'L'])
    for r in sorted(set(right)-set(left)):
        rays.append([r,w-1,*DIRS['R'],True,'R'])
    for c in sorted(set(top)-set(bottom)):
        rays.append([0,c,*DIRS['T'],True,'T'])
    for c in sorted(set(bottom)-set(top)):
        rays.append([h-1,c,*DIRS['B'],True,'B'])
    for r,c,dr,dc,a,tag in rays:
        line[r,c]=True
    collision_steps=0
    while True:
        claims={}
        any_active=False
        for i,(r,c,dr,dc,active,tag) in enumerate(rays):
            if not active:
                continue
            nr,nc=r+dr,c+dc
            if not (0<=nr<h and 0<=nc<w) or line[nr,nc]:
                rays[i][4]=False
                continue
            claims.setdefault((nr,nc),[]).append(i)
            any_active=True
        if not any_active:
            break
        progressed=False
        for cell,idxs in claims.items():
            if len(idxs)==1:
                i=idxs[0]
                nr,nc=cell
                line[nr,nc]=True
                rays[i][0],rays[i][1]=nr,nc
                progressed=True
            else:
                collision_steps += 1
                for i in idxs:
                    rays[i][4]=False
        if not progressed:
            break
    return line, collision_steps


def solve(inp):
    line, collisions = line_mask(inp)
    comps=components(~line)
    infos=[]
    for idx,(coords,border) in enumerate(comps):
        rs=coords[:,0]; cs=coords[:,1]
        r0,c0,r1,c1=rs.min(),cs.min(),rs.max(),cs.max()
        area=len(coords)
        box=(r1-r0+1)*(c1-c0+1)
        infos.append((idx,area,box,border,r0,c0,coords))
    outside=max(infos,key=lambda t:(t[1],t[3],-t[4],-t[5]))[0]
    out=np.zeros(inp.shape,dtype=int)
    out[line]=RED
    for idx,area,box,border,r0,c0,coords in infos:
        if idx==outside:
            continue
        out[coords[:,0],coords[:,1]] = BLUE if area==box else YELLOW
    return out, infos, outside, collisions


def choose_two(rng, lo, hi):
    vals=list(range(lo,hi+1))
    if len(vals)<2:
        return None
    a,b=sorted(rng.choice(vals,size=2,replace=False).tolist())
    return a,b


def make_case(rng):
    h=int(rng.integers(12,17)); w=int(rng.integers(12,17))
    corner=rng.choice(['TL','TR','BL','BR']).item()
    maxd=min(h,w)-5
    if maxd < 2:
        return None
    d=int(rng.integers(2,maxd+1))
    if corner=='BR':
        ru,cu=h-1-d,w-1-d
        rows=choose_two(rng,2,ru-2); cols=choose_two(rng,2,cu-2)
        if rows is None or cols is None: return None
        lr=list(rows); rr=list(rows)+[ru]; tc=list(cols); bc=list(cols)+[cu]
    elif corner=='BL':
        ru,cu=h-1-d,d
        rows=choose_two(rng,2,ru-2); cols=choose_two(rng,cu+2,w-3)
        if rows is None or cols is None: return None
        lr=list(rows)+[ru]; rr=list(rows); tc=list(cols); bc=list(cols)+[cu]
    elif corner=='TR':
        ru,cu=d,w-1-d
        rows=choose_two(rng,ru+2,h-3); cols=choose_two(rng,2,cu-2)
        if rows is None or cols is None: return None
        lr=list(rows); rr=list(rows)+[ru]; tc=list(cols)+[cu]; bc=list(cols)
    else:
        ru,cu=d,d
        rows=choose_two(rng,ru+2,h-3); cols=choose_two(rng,cu+2,w-3)
        if rows is None or cols is None: return None
        lr=list(rows)+[ru]; rr=list(rows); tc=list(cols)+[cu]; bc=list(cols)
    inp=np.zeros((h,w),dtype=int)
    for r in lr: inp[r,0]=RED
    for r in rr: inp[r,w-1]=RED
    for c in tc: inp[0,c]=RED
    for c in bc: inp[h-1,c]=RED
    out, infos, outside, collisions = solve(inp)
    areas=sorted([x[1] for x in infos], reverse=True)
    if len(areas)<3 or areas[0]==areas[1]: return None
    colors=set(np.unique(out))
    if not {BG,BLUE,RED,YELLOW} <= colors: return None
    if collisions < 1: return None
    # exactly 6 guide positions, 2 unmatched markers total
    left,right,top,bottom=parse(inp)
    if len(set(left)|set(right))+len(set(top)|set(bottom)) "'!= 6: return None
    if len(set(left)''^set(right))+len(set(top)''^set(bottom)) != 2: return None
    # dependency checks: removing either unmatched marker changes output and kills or moves yellow
    unmatched=[]
    for r in sorted(set(left)''^set(right)):
        unmatched.append((r,0) if inp[r,0]==RED and r not in set(right) else (r,w-1))
    for c in sorted(set(top)''^set(bottom)):
        unmatched.append((0,c) if inp[0,c]==RED and c not in set(bottom) else (h-1,c))
    for r,c in unmatched:
        altered=inp.copy(); altered[r,c]=0
        alt,_i,_o,_c=solve(altered)
        if np.array_equal(alt,out): return None
    return inp,out,corner,areas

rng=np.random.default_rng(0)
count=0
for i in range(200):
    x=make_case(rng)
    if x is not None:
        count+=1
        if count<=5:
            inp,out,corner,areas=x
            print('"'sample',count,inp.shape,corner,areas)
            print(inp)
            print(out)
print('count',count)
