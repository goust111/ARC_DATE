import numpy as np
from collections import deque

def draw(h,w,full_rows,full_cols,left_rows=(),right_rows=(),top_cols=(),bottom_cols=()):
    g=np.zeros((h,w),int)
    for r in full_rows:g[r,:]=2
    for c in full_cols:g[:,c]=2
    # deterministic order horiz then vert left,right,top,bottom
    for r in left_rows:
        c=0
        while c<w and g[r,c]"'!=2:
            g[r,c]=2;c+=1
    for r in right_rows:
        c=w-1
        while c>=0 and g[r,c]!=2:
            g[r,c]=2;c-=1
    for c in top_cols:
        r=0
        while r<h and g[r,c]!=2:
            g[r,c]=2;r+=1
    for c in bottom_cols:
        r=h-1
        while r>=0 and g[r,c]!=2:
            g[r,c]=2;r-=1
    return g

def comps(mask):
    h,w=mask.shape;seen=np.zeros_like(mask,bool);out=[]
    for r in range(h):
      for c in range(w):
        if not mask[r,c] or seen[r,c]: continue
        q=deque([(r,c)]);seen[r,c]=1;pts=[];touch=False
        while q:
          rr,cc=q.popleft();pts.append((rr,cc))
          if rr in (0,h-1) or cc in (0,w-1): touch=True
          for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=rr+dr,cc+dc
            if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
              seen[nr,nc]=1;q.append((nr,nc))
        out.append((pts,touch))
    return out

def classify(g):
    out=[]
    for pts,touch in comps(g==0):
      if touch: continue
      rs=[r for r,c in pts]; cs=[c for r,c in pts]
      area=len(pts); box=(max(rs)-min(rs)+1)*(max(cs)-min(cs)+1)
      out.append((area,box, area==box))
    return out

