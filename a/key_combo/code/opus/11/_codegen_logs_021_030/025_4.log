+            return None
+        left_rows = list(row_pair) + [unmatched_row]
+        right_rows = list(row_pair)
+        top_cols = list(col_pair) + [unmatched_col]
+        bottom_cols = list(col_pair)
+
+    grid = np.zeros((h, w), dtype=int)
