    for r in right_rows:rays.append([r,w-1,0,-1,True])
    for c in top_cols:rays.append([0,c,1,0,True])
    for c in bottom_cols:rays.append([h-1,c,-1,0,True])
    # starting marker cells already red
    for r,c,dr,dc,a in rays:g[r,c]=2
    while True:
        claims={}
        any_active=False
