from __future__ import annotations

from collections import deque
import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
GREY = 5

DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]

GRID_H_RANGE = (15, 19)
GRID_W_RANGE = (15, 19)
REGION_COUNT_RANGE = (3, 5)
AREA_CHOICES = [4, 6, 8, 10, 12, 14]
PLACEMENT_MARGIN = 1
PLACEMENT_GAP = 2
GEN_ATTEMPTS = 400
SHAPE_ATTEMPTS = 200


def _neighbors4(r: int, c: int):
    for dr, dc in DIR4:
        yield r + dr, c + dc


def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _crop_mask(mask: np.ndarray) -> np.ndarray:
    coords = np.argwhere(mask)
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    comps: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            coords: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                coords.append((rr, cc))
                for nr, nc in _neighbors4(rr, cc):
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(np.array(coords, dtype=int))
    return comps


def _is_connected(mask: np.ndarray) -> bool:
    coords = np.argwhere(mask)
    return coords.size > 0 and len(_components(mask)) == 1


def _dilate4(mask: np.ndarray) -> np.ndarray:
    h, w = mask.shape
    out = mask.copy()
    for r, c in np.argwhere(mask):
        rr = int(r)
        cc = int(c)
        for nr, nc in _neighbors4(rr, cc):
            if 0 <= nr < h and 0 <= nc < w:
                out[nr, nc] = True
    return out


def _boundary_from_region(region: np.ndarray) -> np.ndarray:
    padded = np.pad(region.astype(bool), 1, constant_values=False)
    boundary = _dilate4(padded) & ~padded
    return _crop_mask(boundary)


def _symmetry_flags(mask: np.ndarray) -> tuple[bool, bool]:
    horizontal = bool(np.array_equal(mask, np.flipud(mask)))
    vertical = bool(np.array_equal(mask, np.fliplr(mask)))
    return horizontal, vertical


def _classify_boundary(mask: np.ndarray) -> int:
    horizontal, vertical = _symmetry_flags(mask)
    if horizontal and vertical:
        return GREEN
    if horizontal:
        return BLUE
    if vertical:
        return RED
    raise ValueError("boundary does not match a supported symmetry class")


def _row_interval_mask(intervals: list[tuple[int, int]], width: int) -> np.ndarray:
    mask = np.zeros((len(intervals), width), dtype=bool)
    for r, (c0, c1) in enumerate(intervals):
        mask[r, c0 : c1 + 1] = True
    return mask


def _choose_overlapping_interval(prev: tuple[int, int], width: int, centered: bool) -> tuple[int, int] | None:
    prev_l, prev_r = prev
    candidates: list[tuple[int, int]] = []
    if centered:
        for left in range(width):
            right = width - 1 - left
            if left > right:
                continue
            if max(left, prev_l) <= min(right, prev_r):
                candidates.append((left, right))
    else:
        for left in range(width):
            for right in range(left, width):
                if max(left, prev_l) <= min(right, prev_r):
                    candidates.append((left, right))
    if not candidates:
        return None
    return random.choice(candidates)


def _make_h_intervals(height: int, width: int) -> list[tuple[int, int]] | None:
    if height < 3 or width < 3:
        return None

    if height % 2:
        center_choices = [(l, r) for l in range(width) for r in range(l, width) if r - l + 1 >= 2]
        center = random.choice(center_choices)
        above: list[tuple[int, int]] = []
        prev = center
        for _ in range(height // 2):
            nxt = _choose_overlapping_interval(prev, width, centered=False)
            if nxt is None:
                return None
            above.append(nxt)
            prev = nxt
        intervals = above[::-1] + [center] + above
    else:
        upper_choices = [(l, r) for l in range(width) for r in range(l, width) if r - l + 1 >= 2]
        upper_mid = random.choice(upper_choices)
        above = []
        prev = upper_mid
        for _ in range(height // 2 - 1):
            nxt = _choose_overlapping_interval(prev, width, centered=False)
            if nxt is None:
                return None
            above.append(nxt)
            prev = nxt
        top = above[::-1] + [upper_mid]
        intervals = top + top[::-1]

    mask = _row_interval_mask(intervals, width)
    horizontal, vertical = _symmetry_flags(mask)
    if horizontal and not vertical and _is_connected(mask):
        return intervals
    return None


def _make_both_intervals(height: int, width: int) -> list[tuple[int, int]] | None:
    if height < 3 or width < 3:
        return None

    centered_choices = [(l, width - 1 - l) for l in range((width + 1) // 2) if width - 2 * l >= 2]
    if not centered_choices:
        return None

    if height % 2:
        center = random.choice(centered_choices)
        above: list[tuple[int, int]] = []
        prev = center
        for _ in range(height // 2):
            nxt = _choose_overlapping_interval(prev, width, centered=True)
            if nxt is None:
                return None
            above.append(nxt)
            prev = nxt
        intervals = above[::-1] + [center] + above
    else:
        upper_mid = random.choice(centered_choices)
        above = []
        prev = upper_mid
        for _ in range(height // 2 - 1):
            nxt = _choose_overlapping_interval(prev, width, centered=True)
            if nxt is None:
                return None
            above.append(nxt)
            prev = nxt
        top = above[::-1] + [upper_mid]
        intervals = top + top[::-1]

    mask = _row_interval_mask(intervals, width)
    horizontal, vertical = _symmetry_flags(mask)
    if horizontal and vertical and _is_connected(mask):
        return intervals
    return None


def _make_region(kind: str, target_area: int) -> np.ndarray | None:
    for _ in range(SHAPE_ATTEMPTS):
        if kind == "V":
            height = random.randint(3, 6)
            width = random.randint(3, 7)
            intervals = _make_h_intervals(width, height)
            if intervals is None:
                continue
            mask = _row_interval_mask(intervals, height).T
        elif kind == "H":
            height = random.randint(3, 7)
            width = random.randint(3, 6)
            intervals = _make_h_intervals(height, width)
            if intervals is None:
                continue
            mask = _row_interval_mask(intervals, width)
        else:
            height = random.randint(3, 7)
            width = random.randint(3, 7)
            intervals = _make_both_intervals(height, width)
            if intervals is None:
                continue
            mask = _row_interval_mask(intervals, width)

