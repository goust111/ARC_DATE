            continue
        if not _is_connected(mask):
            continue

        boundary = _boundary_from_region(mask)
        if boundary.sum() < 10 or boundary.sum() > 30:
            continue
        if not _is_connected(boundary):
            continue

        color = _classify_boundary(boundary)
        if (kind == "H" and color != BLUE) or (kind == "V" and color != RED) or (kind == "B" and color != GREEN):
            continue
        return mask
    return None


def _region_to_patch(region: np.ndarray) -> np.ndarray:
    boundary = _boundary_from_region(region)
    patch = np.zeros(boundary.shape, dtype=int)
    patch[boundary] = GREY
    return patch


