+def generate_input() -> np.ndarray:
+    global _GEN_COUNTER
+
+    branch_index = _GEN_COUNTER
+    _GEN_COUNTER += 1
+    preferred_corner = _CORNERS[branch_index % len(_CORNERS)]
+
