+    for r in full_rows:
+        line[r, :] = True
+    for c in full_cols:
+        line[:, c] = True
+
+    rays: list[list[int | bool | str]] = []
+    for r in left_only:
+        dr, dc = _DIR_BY_SIDE["L"]
+        rays.append([r, 0, dr, dc, True, "L"])
+    for r in right_only:
