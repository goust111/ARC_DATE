spec:
  grid: 14-19 rows x 10-17 cols, black background
  colors: input has only black (0) and red (2); output adds green (3)
  red_pixels:
    count: 4-7 total
    spine: exactly 2 red pixels share one row or one column (no other pair shares a row/col); this defines the spine axis and endpoints
    axis: horizontal (row) or vertical (col), both occur [observed ~equal split]
    spine_length: 6-12 cells (60-86% of grid dimension along spine axis)
    branches: 2-5 off-spine red pixels, each at a unique perpendicular position strictly between spine endpoints (never at endpoint positions)
    branch_length: 2-5 cells (perpendicular distance from branch pixel to spine)
    branch_sides: branches appear on both sides of the spine [observed, all examples]
  output:
    spine_fill: green fills all background cells between the two spine endpoints along the spine line (red endpoints preserved)
    branch_connectors: for each off-spine red pixel, a green segment connects it orthogonally to the spine; red pixel preserved, intermediate cells painted green
    crossings: where a branch meets the spine, cell stays green (or red if it was red)

generation_strategy:
