+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        stack = [(r, c)]
+        seen[r, c] = True
+        comp: list[tuple[int, int]] = []
+        while stack:
+            cr, cc = stack.pop()
+            comp.append((cr, cc))
+            for dr, dc in DIRS4:
+                nr, nc = cr + dr, cc + dc
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    stack.append((nr, nc))
+        comps.append(comp)
+    return comps
+
+
+def _color_patch(mask3: np.ndarray, color: int) -> np.ndarray:
+    out = np.zeros_like(mask3, dtype=int)
+    out[mask3.astype(bool)] = color
+    return out
+
+
+def _scan_runs(mask: np.ndarray, axis: str) -> list[tuple[str, int, int, int, int]]:
+    runs: list[tuple[str, int, int, int, int]] = []
+    h, w = mask.shape
+    if axis == "row":
+        for r in range(h):
+            c = 0
+            while c < w:
+                if not mask[r, c]:
+                    c += 1
+                    continue
+                start = c
+                while c + 1 < w and mask[r, c + 1]:
+                    c += 1
+                runs.append(("row", r, start, c, c - start + 1))
+                c += 1
