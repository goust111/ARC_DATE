+
+    branches = meta["branches"]
+    if len({len(branch["cells"]) for branch in branches}) != 1:
+        return False
+    if len(meta["used_dirs"]) != 2:
+        return False
+    if any(np.array_equal(inp == BLUE, np.roll(out == BLUE, shift=s, axis=a)) for a in (0, 1) for s in (-1, 1)):
+        return False
+    return True
+
