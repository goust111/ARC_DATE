+        er, ec = branch["end"]
+        anchor = (er + dr, ec + dc)
+        assert _in_bounds(g.shape, *anchor), "sprite anchor must stay in bounds"
+        assert int(g[anchor]) == BLUE, "expected a blue sprite one step beyond each branch end"
