+        down_positions = _choose_spaced_positions(trunk_len, down_count, 4)
+        if up_positions is None or down_positions is None:
+            return None
+
+        boxes: list[tuple[int, int, int, int]] = []
+        used_attach = set()
+        for rel in up_positions:
