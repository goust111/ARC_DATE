import random
from collections import Counter

import numpy as np


BG = 0
BLUE = 1
RED = 2

DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
CW_TURNS = {"U": 0, "R": 3, "D": 2, "L": 1}

# Each template is a 3x3 asymmetric 4-connected sprite that touches all four sides,
# so the same unrotated shape can sit at the end of branches from any direction.
SPRITE_TEMPLATES = [
    np.array(
        [
            [0, 1, 0],
            [1, 1, 1],
            [0, 0, 1],
        ],
        dtype=int,
    ),
    np.array(
        [
            [1, 1, 0],
            [0, 1, 1],
            [0, 1, 0],
        ],
        dtype=int,
    ),
    np.array(
        [
            [0, 1, 1],
            [1, 1, 0],
            [1, 0, 0],
        ],
        dtype=int,
    ),
]

# For each branch direction, the adjacent cell one step beyond the branch end maps
# to this occupied local coordinate inside the shared 3x3 sprite bbox.
ANCHOR_LOCAL = {
    "U": (2, 2),
    "D": (0, 1),
    "L": (1, 2),
    "R": (1, 0),
}

GEN_MAX_ATTEMPTS = 400
GEN_H_RANGE = (18, 25)
GEN_W_RANGE = (18, 25)
GEN_BRANCH_COUNT_RANGE = (2, 4)
GEN_BRANCH_LEN_RANGE = (2, 3)
GEN_TRUNK_LEN_RANGE = (5, 10)


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    return 0 <= r < shape[0] and 0 <= c < shape[1]


def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
    seen = np.zeros_like(mask, dtype=bool)
    comps: list[list[tuple[int, int]]] = []
    for r, c in np.argwhere(mask):
        r = int(r)
        c = int(c)
        if seen[r, c]:
            continue
        stack = [(r, c)]
        seen[r, c] = True
        comp: list[tuple[int, int]] = []
        while stack:
            cr, cc = stack.pop()
            comp.append((cr, cc))
            for dr, dc in DIRS4:
                nr, nc = cr + dr, cc + dc
                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
                    seen[nr, nc] = True
                    stack.append((nr, nc))
        comps.append(comp)
    return comps


def _color_patch(mask3: np.ndarray, color: int) -> np.ndarray:
    out = np.zeros_like(mask3, dtype=int)
    out[mask3.astype(bool)] = color
    return out


def _scan_runs(mask: np.ndarray, axis: str) -> list[tuple[str, int, int, int, int]]:
    runs: list[tuple[str, int, int, int, int]] = []
    h, w = mask.shape
    if axis == "row":
        for r in range(h):
            c = 0
            while c < w:
                if not mask[r, c]:
                    c += 1
                    continue
                start = c
                while c + 1 < w and mask[r, c + 1]:
                    c += 1
                runs.append(("row", r, start, c, c - start + 1))
                c += 1
    else:
        for c in range(w):
            r = 0
            while r < h:
                if not mask[r, c]:
                    r += 1
                    continue
        order = pool[:]
        random.shuffle(order)
        for pos in order:
            next_pool = [x for x in pool if x > pos and x - pos >= min_gap]
            chosen.append(pos)
            if search(next_pool):
                return True
            chosen.pop()
        return False

    if search(slots):
        return chosen[:]
    return None


def _branch_side_counts(branch_count: int) -> tuple[int, int]:
    if branch_count == 2:
        return 1, 1
    if branch_count == 3:
        return random.choice([(1, 2), (2, 1)])
    return 2, 2


def _sprite_top_left(direction: str, anchor_r: int, anchor_c: int) -> tuple[int, int]:
    lr, lc = ANCHOR_LOCAL[direction]
    return anchor_r - lr, anchor_c - lc


def _place_sprite(
    grid: np.ndarray,
    sprite_mask: np.ndarray,
    direction: str,
    anchor_r: int,
    anchor_c: int,
) -> tuple[int, int, int, int]:
    r0, c0 = _sprite_top_left(direction, anchor_r, anchor_c)
    h, w = sprite_mask.shape
    assert h == 3 and w == 3
    assert 0 <= r0 and 0 <= c0 and r0 + h <= grid.shape[0] and c0 + w <= grid.shape[1]
    patch = _color_patch(sprite_mask, BLUE)
    sub = grid[r0 : r0 + h, c0 : c0 + w]
    assert not np.any((patch == BLUE) & (sub != BG)), "sprite overlap"
    sub[patch == BLUE] = BLUE
    return r0, c0, r0 + h - 1, c0 + w - 1


def _boxes_disjoint(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
    ar0, ac0, ar1, ac1 = a
    br0, bc0, br1, bc1 = b
    return ar1 < br0 or br1 < ar0 or ac1 < bc0 or bc1 < ac0


def _template_is_good(mask3: np.ndarray) -> bool:
    if mask3.shape != (3, 3) or int(mask3.sum()) < 3 or int(mask3.sum()) > 5:
        return False
    if len(_components(mask3.astype(bool))) != 1:
        return False
    if not (mask3[0, :].any() and mask3[2, :].any() and mask3[:, 0].any() and mask3[:, 2].any()):
        return False
    variants = {np.rot90(mask3, k).tobytes() for k in range(4)}
    return len(variants) == 4


assert all(_template_is_good(mask) for mask in SPRITE_TEMPLATES)


def _sample_layout() -> tuple[np.ndarray, np.ndarray] | None:
    h = random.randint(*GEN_H_RANGE)
    w = random.randint(*GEN_W_RANGE)
    branch_count = random.randint(*GEN_BRANCH_COUNT_RANGE)
    branch_len = random.randint(*GEN_BRANCH_LEN_RANGE)
    axis = random.choice(["row", "col"])
    sprite_mask = random.choice(SPRITE_TEMPLATES)

