+
+    red_cells = int(np.sum(inp == RED))
+    blue_cells = int(np.sum(inp == BLUE))
+    if red_cells <= blue_cells:
+        return False
+    if Counter(inp.flatten())[BG] <= red_cells + blue_cells:
