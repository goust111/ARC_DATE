+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+CW_TURNS = {"U": 0, "R": 3, "D": 2, "L": 1}
+
+# Each template is a 3x3 asymmetric 4-connected sprite that touches all four sides,
+# so the same unrotated shape can sit at the end of branches from any direction.
+SPRITE_TEMPLATES = [
+    np.array(
+        [
+            [0, 1, 0],
+            [1, 1, 1],
+            [0, 0, 1],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [1, 1, 0],
+            [0, 1, 1],
+            [0, 1, 0],
+        ],
+        dtype=int,
+    ),
+    np.array(
+        [
+            [0, 1, 1],
+            [1, 1, 0],
+            [1, 0, 0],
+        ],
+        dtype=int,
+    ),
+]
+
+# For each branch direction, the adjacent cell one step beyond the branch end maps
+# to this occupied local coordinate inside the shared 3x3 sprite bbox.
+ANCHOR_LOCAL = {
+    "U": (2, 2),
+    "D": (0, 1),
+    "L": (1, 2),
+    "R": (1, 0),
+}
+
+GEN_MAX_ATTEMPTS = 400
+GEN_H_RANGE = (18, 25)
