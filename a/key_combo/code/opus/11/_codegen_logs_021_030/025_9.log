+def _random_layout(size: int) -> tuple[int, int, int, int, int, int]:
+    H = random.randint(max(10, size + 5), 14)
+    W = random.randint(max(11, 2 * size + 4), 16)
+    src_r = random.randint(1, H - size - 1)
