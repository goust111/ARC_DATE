from importlib.machinery import SourceFileLoader
from pathlib import Path
from collections import Counter
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/11/025/9.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()

sigs = set()
branches = Counter()
sizes = Counter()
quadrants = Counter()
for i in range(200):
    inp = mod.generate_input()
    out = mod.main(inp)
    scene = mod._extract_scene(inp)
    body = scene['body']
    marker = scene['marker']
    size = body.shape[0]
    branch = 'lr' if marker[1] < size / 2 else 'ud'
    alt = np.flipud(body) if branch == 'lr' else np.fliplr(body)
    transformed = mod._scene_transform(body, marker)
    sigs.add(hashlib.md5(inp.tobytes() + str(inp.shape).encode()).hexdigest())
    sizes[size] += 1
    branches[branch] += 1
    q = ('T' if marker[0] < size // 2 else 'B') + ('L' if marker[1] < size // 2 else 'R')
    quadrants[q] += 1
    assert isinstance(inp, np.ndarray) and isinstance(out, np.ndarray)
    assert inp.ndim == 2 and out.ndim == 2
    assert max(inp.shape) <= 30 and max(out.shape) <= 30
    assert not np.array_equal(body, transformed)
    assert not np.array_equal(transformed, alt)
    assert np.array_equal(out, mod.main(inp))
    sr0, sc0, sr1, sc1 = scene['source_box']
    tr0, tc0, tr1, tc1 = scene['target_box']
    assert np.all(out[sr0:sr1+1, sc0:sc1+1] == 0)
    assert np.array_equal(out[tr0:tr1+1, tc0:tc1+1], transformed)

print('variants', len(sigs))
print('sizes', dict(sizes))
print('branches', dict(branches))
print('quadrants', dict(quadrants))
assert len(sigs) >= 20
assert len(sizes) == 2
assert len(branches) == 2
assert len(quadrants) == 4
