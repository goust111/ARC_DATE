+    sr0, sc0, sr1, sc1 = scene["source_box"]
+    tr0, tc0, tr1, tc1 = scene["target_box"]
+    mirrored = _scene_transform(scene["body"], scene["marker"])
+
+    out[sr0 : sr1 + 1, sc0 : sc1 + 1] = BG
+    out[tr0 : tr1 + 1, tc0 : tc1 + 1] = mirrored
+    return out
