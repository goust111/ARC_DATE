+        bottom_rows = [2, 3]
+        left_cols = [0, 1]
+        right_cols = [2, 3]
+    else:
+        top_rows = [0, 1]
+        bottom_rows = [3, 4]
+        left_cols = [0, 1]
+        right_cols = [3, 4]
+
+    if quadrant == "TL":
+        return [(r, c) for r in top_rows for c in left_cols]
+    if quadrant == "TR":
+        return [(r, c) for r in top_rows for c in right_cols]
+    if quadrant == "BL":
+        return [(r, c) for r in bottom_rows for c in left_cols]
+    return [(r, c) for r in bottom_rows for c in right_cols]
