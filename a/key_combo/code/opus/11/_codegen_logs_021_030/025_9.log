+    if quadrant == "TR":
+        return [(r, c) for r in top_rows for c in right_cols]
+    if quadrant == "BL":
+        return [(r, c) for r in bottom_rows for c in left_cols]
+    return [(r, c) for r in bottom_rows for c in right_cols]
+
