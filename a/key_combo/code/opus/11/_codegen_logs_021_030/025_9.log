+    while queue:
+        r, c = queue.popleft()
+        for dr, dc in NEIGHBORS4:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < H and 0 <= nc < W and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                queue.append((nr, nc))
+    return len(seen) == len(cells)
