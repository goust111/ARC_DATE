                if 0 <= nr < size and 0 <= nc < size and not mask[nr, nc]:
                    frontier.add((nr, nc))
        if not frontier:
            break
        nr, nc = random.choice(list(frontier))
        mask[nr, nc] = True
    return mask


def _quadrant_cells(size: int, quadrant: str) -> list[tuple[int, int]]:
    if size == 4:
        top_rows = [0, 1]
        bottom_rows = [2, 3]
