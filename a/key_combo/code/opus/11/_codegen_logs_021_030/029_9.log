+
+        coord_order = (
+            sorted(range(len(placed)), key=lambda i: (placed[i][1], placed[i][0]))
+            if axis == "horizontal"
+            else sorted(range(len(placed)), key=lambda i: (placed[i][0], placed[i][1]))
+        )
+        if coord_order == list(range(len(placed))):
+            continue
+        return [(int(r), int(c)) for r, c in placed]
