+    if len(heights) < 2 or len(widths) < 2:
+        return None
+
+    area_order = list(range(count))
+    bbox_order = sorted(range(count), key=lambda i: (specs[i]["bbox_area"], specs[i]["bbox_shape"]))
+    if area_order == bbox_order:
