+
+
+def _place_frame(grid: np.ndarray, patch: np.ndarray, rng: random.Random) -> tuple[int, int, int, int]:
+    h, w = grid.shape
+    positions = [(r, c) for r in range(0, min(3, h - 3)) for c in range(0, min(3, w - 3))]
+    rng.shuffle(positions)
+    r0, c0 = positions[0]
