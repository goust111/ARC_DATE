+        if axis == "horizontal":
+            xs = [c for _, c in placed]
+            if len(set(xs)) != len(xs):
+                continue
+        else:
+            ys = [r for r, _ in placed]
+            if len(set(ys)) != len(ys):
+                continue
+
+        centers = []
+        for sprite, (r0, c0) in zip(sprites, placed):
+            h, w = sprite["crop"].shape
+            centers.append((r0 + (h - 1) / 2, c0 + (w - 1) / 2))
