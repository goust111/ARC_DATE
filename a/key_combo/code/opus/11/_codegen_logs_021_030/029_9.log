+def _frame_patch(open_side: str) -> np.ndarray:
+    patch = np.zeros((4, 4), dtype=int)
+    patch[0, :] = FRAME
+    patch[-1, :] = FRAME
+    patch[:, 0] = FRAME
+    patch[:, -1] = FRAME
