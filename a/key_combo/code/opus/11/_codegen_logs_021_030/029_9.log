+    return r0, c0, r0 + patch.shape[0] - 1, c0 + patch.shape[1] - 1
+
+
+def _placement_candidates(
+    grid_shape: tuple[int, int],
+    crop: np.ndarray,
+    axis: str,
+    rng: random.Random,
+) -> list[tuple[int, int]]:
+    gh, gw = grid_shape
+    h, w = crop.shape
+    rows = list(range(gh - h + 1))
+    cols = list(range(gw - w + 1))
+    rng.shuffle(rows)
+    rng.shuffle(cols)
+
+    pairs = []
+    if axis == "horizontal":
+        for r in rows:
+            for c in cols:
+                pairs.append((r, c))
+    else:
+        for c in cols:
+            for r in rows:
+                pairs.append((r, c))
+    rng.shuffle(pairs)
