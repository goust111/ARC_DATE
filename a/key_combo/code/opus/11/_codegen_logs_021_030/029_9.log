+    if not np.any(crop[0, 1:-1] == FRAME):
+        missing.append("top")
+    if not np.any(crop[-1, 1:-1] == FRAME):
+        missing.append("bottom")
+    if not np.any(crop[1:-1, 0] == FRAME):
+        missing.append("left")
+    if not np.any(crop[1:-1, -1] == FRAME):
+        missing.append("right")
