+            weights = []
+            for r, c in frontier:
+                score = 1
+                if r in (0, h - 1):
+                    score += 2
+                if c in (0, w - 1):
+                    score += 2
+                weights.append(score)
+            cells.add(frontier[rng.choices(range(len(frontier)), weights=weights, k=1)[0]])
