+
+
+def _occupied_with_halo(
+    crop: np.ndarray,
+    r0: int,
+    c0: int,
+    shape: tuple[int, int],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    cells = set()
+    halo = set()
+    for r, c in np.argwhere(crop != BG):
+        rr = int(r0 + r)
+        cc = int(c0 + c)
+        cells.add((rr, cc))
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = rr + dr
+                nc = cc + dc
