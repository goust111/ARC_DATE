+            continue
+        rows = {r for r, _ in cells}
+        cols = {c for _, c in cells}
+        if 0 not in rows or h - 1 not in rows or 0 not in cols or w - 1 not in cols:
+            continue
+        mask = np.zeros((h, w), dtype=int)
+        for r, c in cells:
+            mask[r, c] = 1
+        return mask
