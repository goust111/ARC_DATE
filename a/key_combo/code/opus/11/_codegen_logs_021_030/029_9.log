+def _colorize_specs(specs: list[dict], rng: random.Random) -> list[dict]:
+    colors = list(SPRITE_COLORS)
+    rng.shuffle(colors)
+    out = []
+    for spec, color in zip(specs, colors):
+        crop = spec["mask"] * int(color)
+        out.append(
+            {
+                "area": int(spec["area"]),
+                "bbox_area": int(spec["bbox_area"]),
+                "crop": crop.astype(int),
+                "color": int(color),
+            }
+        )
+    return out
+
