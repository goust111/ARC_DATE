+    gh, gw = grid_shape
+    h, w = crop.shape
+    rows = list(range(gh - h + 1))
+    cols = list(range(gw - w + 1))
+    rng.shuffle(rows)
+    rng.shuffle(cols)
+
+    pairs = []
+    if axis == "horizontal":
+        for r in rows:
+            for c in cols:
+                pairs.append((r, c))
+    else:
+        for c in cols:
+            for r in rows:
