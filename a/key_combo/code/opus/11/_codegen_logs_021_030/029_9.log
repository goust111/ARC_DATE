+def _expected_output(sprites: list[dict], axis: str) -> np.ndarray:
+    ordered = [sprite["crop"] for sprite in sorted(sprites, key=lambda s: (s["area"], s["color"]))]
+    return _pack_crops(ordered, axis)
+
+
+def _alternative_position_output(
