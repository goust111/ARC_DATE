+        occupied_halo = set(blocked)
+        order = list(range(len(sprites)))
+        rng.shuffle(order)
+
+        ok = True
+        for idx in order:
+            crop = sprites[idx]["crop"]
+            found = None
+            for r0, c0 in _placement_candidates(grid_shape, crop, axis, rng):
+                cells, halo = _occupied_with_halo(crop, r0, c0, grid_shape)
