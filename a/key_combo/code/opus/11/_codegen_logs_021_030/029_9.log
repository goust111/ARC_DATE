+    blocked = set()
+    for r in range(max(0, fh0 - 1), min(grid_shape[0], fh1 + 2)):
+        for c in range(max(0, fw0 - 1), min(grid_shape[1], fw1 + 2)):
+            blocked.add((r, c))
