+    elif open_side == "bottom":
+        patch[-1, 1:-1] = BG
+    elif open_side == "left":
+        patch[1:-1, 0] = BG
+    else:
+        patch[1:-1, -1] = BG
+    return patch
+
+
+def _occupied_with_halo(
+    crop: np.ndarray,
+    r0: int,
+    c0: int,
+    shape: tuple[int, int],
+) -> tuple[set[tuple[int, int]], set[tuple[int, int]]]:
+    cells = set()
+    halo = set()
+    for r, c in np.argwhere(crop != BG):
+        rr = int(r0 + r)
+        cc = int(c0 + c)
+        cells.add((rr, cc))
+        for dr in (-1, 0, 1):
