+def _pack_crops(crops: list[np.ndarray], axis: str) -> np.ndarray:
+    assert crops
+    if axis == "horizontal":
+        out_h = max(int(c.shape[0]) for c in crops)
+        out_w = sum(int(c.shape[1]) for c in crops)
