+def _make_sprite_specs(rng: random.Random, count: int) -> list[dict] | None:
+    area_choices = sorted(rng.sample(list(range(4, 10)), count))
+    specs = []
+    for area in area_choices:
+        made = None
+        dims = [
+            (h, w)
+            for h in range(2, 6)
+            for w in range(2, 6)
+            if h * w >= area and h * w <= 12
+        ]
+        rng.shuffle(dims)
+        for h, w in dims:
+            mask = _shape_with_exact_bbox(h, w, area, rng)
+            if mask is not None:
+                made = {
+                    "area": area,
+                    "bbox_shape": (h, w),
+                    "bbox_area": h * w,
+                    "mask": mask,
+                }
+                break
+        if made is None:
+            return None
+        specs.append(made)
