+        patch[0, 1:-1] = BG
+    elif open_side == "bottom":
+        patch[-1, 1:-1] = BG
+    elif open_side == "left":
+        patch[1:-1, 0] = BG
+    else:
+        patch[1:-1, -1] = BG
+    return patch
+
