+def _paste(dst, patch, r0, c0, transparent=None):
+    h, w = patch.shape
+    assert 0 <= r0 and 0 <= c0 and r0 + h <= dst.shape[0] and c0 + w <= dst.shape[1]
+    view = dst[r0 : r0 + h, c0 : c0 + w]
