+    h, w = patch.shape
+    assert 0 <= r0 and 0 <= c0 and r0 + h <= dst.shape[0] and c0 + w <= dst.shape[1]
+    view = dst[r0 : r0 + h, c0 : c0 + w]
+    if transparent is None:
+        view[:] = patch
+    else:
+        mask = patch != int(transparent)
+        view[mask] = patch[mask]
+    return dst
+
+
+def _connected(mask):
+    coords = list(map(tuple, np.argwhere(mask)))
+    if not coords:
+        return False
+    seen = {coords[0]}
+    q = deque([coords[0]])
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS4:
+            rr, cc = r + dr, c + dc
+            if 0 <= rr < mask.shape[0] and 0 <= cc < mask.shape[1] and mask[rr, cc] and (rr, cc) not in seen:
+                seen.add((rr, cc))
+                q.append((rr, cc))
+    return len(seen) == len(coords)
+
+
+def _find_components(grid, colors):
+    colors = set(map(int, colors))
+    seen = np.zeros(grid.shape, dtype=bool)
+    comps = []
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            color = int(grid[r, c])
+            if seen[r, c] or color not in colors:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1] and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
+            )
+    return comps
+
+
+def _local_coords(mask):
