+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GUIDE_COLORS = [BLUE, RED]
+GRID_SIDE_RANGE = (17, 24)
+GEN_RETRIES = 400
