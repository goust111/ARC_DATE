+def _first_full_color_col(grid: np.ndarray, color: int) -> int:
+    for c in range(1, grid.shape[1]):
+        if np.all(grid[:, c] == color):
+            return int(c)
+    raise AssertionError("expected a full placeholder column right of the visible tile")
