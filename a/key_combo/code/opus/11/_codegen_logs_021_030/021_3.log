+    h, w = grid_shape
+    r0 = (int(r) // tile_h) * tile_h
+    c0 = (int(c) // tile_w) * tile_w
+    r1 = min(r0 + tile_h, h)
+    c1 = min(c0 + tile_w, w)
+    return r0, r1, c0, c1
