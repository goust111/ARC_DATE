+def _matches_period(tile: np.ndarray, period_h: int, period_w: int) -> bool:
+    h, w = tile.shape
+    for r in range(h):
+        for c in range(w):
+            if int(tile[r, c]) != int(tile[r % period_h, c % period_w]):
+                return False
+    return True
