+def _first_full_color_row(grid: np.ndarray, color: int) -> int:
+    for r in range(1, grid.shape[0]):
+        if np.all(grid[r, :] == color):
+            return int(r)
+    raise AssertionError("expected a full placeholder row below the visible tile")
