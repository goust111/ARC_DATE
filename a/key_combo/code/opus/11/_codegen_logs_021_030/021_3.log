        (0, random.randrange(q)),
        (h - 1, random.randrange(q)),
    ]
    for anchor in anchors:
        _gen_mark_half_path(half, bridge, anchor)

    lo, hi = _gen_area_bounds(h, w)
    base = _gen_half_area(half, w)
    targets = [
        a
        for a in range(max(lo, base), hi + 1)
