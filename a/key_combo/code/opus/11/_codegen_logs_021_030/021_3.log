+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TILE_COLORS = (BLUE, RED, YELLOW)
+
+TILE_SIZE_CHOICES = (3, 4)
+REPETITION_RANGE = (3, 6)
+MARKER_COUNT_RANGE = (2, 4)
+MAX_GENERATION_ATTEMPTS = 400
