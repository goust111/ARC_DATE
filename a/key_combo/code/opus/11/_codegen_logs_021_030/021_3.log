+def _is_minimal_tile(tile: np.ndarray) -> bool:
+    h, w = tile.shape
+    for period_h in range(1, h + 1):
+        if h % period_h != 0:
+            continue
+        for period_w in range(1, w + 1):
+            if w % period_w != 0:
+                continue
+            if period_h == h and period_w == w:
+                continue
+            if _matches_period(tile, period_h, period_w):
+                return False
+    return True
+
