+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+PHASE_TO_COLOR = {0: 2, 1: 3, 2: 1}
+
+GEN_ATTEMPTS = 800
+LAYOUTS = ((2, 2), (2, 3), (3, 2))
+ROW_CHOICES = (2, 3, 4, 5, 6)
+COL_CHOICES = (2, 3, 4, 5, 6)
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.asarray(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _touches_border(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return bool(
+        np.any(coords[:, 0] == 0)
+        or np.any(coords[:, 1] == 0)
+        or np.any(coords[:, 0] == h - 1)
+        or np.any(coords[:, 1] == w - 1)
+    )
+
+
+def _erode8(mask: np.ndarray) -> np.ndarray:
+    if not mask.any():
+        return mask.copy()
+    padded = np.pad(mask, 1, constant_values=False)
+    out = np.ones_like(mask, dtype=bool)
+    for dr in range(3):
+        for dc in range(3):
+            out &= padded[dr : dr + mask.shape[0], dc : dc + mask.shape[1]]
+    return out
+
+
+def _inner_border(mask: np.ndarray, width: int) -> np.ndarray:
+    interior = mask.copy()
+    for _ in range(width):
+        interior = _erode8(interior)
+        if not interior.any():
+            break
+    return mask & ~interior
+
+
+def _extract_regions(grid: np.ndarray) -> list[dict]:
+    regions: list[dict] = []
+    for coords in _component_coords(grid == BG):
+        if _touches_border(coords, grid.shape):
+            continue
+        mask = np.zeros_like(grid, dtype=bool)
+        mask[coords[:, 0], coords[:, 1]] = True
+        r0, c0, r1, c1 = _bbox(coords)
+        area = int(coords.shape[0])
+        width = 1 + area // 12
+        border = _inner_border(mask, width)
+        regions.append(
+            {
+                "coords": coords,
+                "mask": mask,
+                "bbox": (r0, c0, r1, c1),
+                "area": area,
+                "width": width,
+                "phase": (r0 + c0) % 3,
+                "border": border,
+            }
+        )
