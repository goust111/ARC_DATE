+    row_cuts = _cuts(row_heights)
+    col_cuts = _cuts(col_widths)
+    h = row_cuts[-1] + 1
+    w = col_cuts[-1] + 1
+    grid = np.full((h, w), BG, dtype=int)
+    grid[row_cuts, :] = WALL
+    grid[:, col_cuts] = WALL
+    return grid
+
+
