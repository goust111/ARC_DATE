+    assert fully_colored >= 1
+    assert partially_colored >= 1
+
+    out = main(grid)
+    assert out.shape == grid.shape
+    assert np.all(out[grid == WALL] == WALL)
+    assert {1, 2, 3}.issubset(set(np.unique(out)))
+
+    for region in regions:
