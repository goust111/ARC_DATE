+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (15, 19)
