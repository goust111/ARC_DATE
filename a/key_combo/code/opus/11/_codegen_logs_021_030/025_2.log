+        placed = False
+        for r0, c0 in positions:
+            rr0 = max(0, r0 - PLACEMENT_GAP)
+            cc0 = max(0, c0 - PLACEMENT_GAP)
+            rr1 = min(grid_h, r0 + ph + PLACEMENT_GAP)
+            cc1 = min(grid_w, c0 + pw + PLACEMENT_GAP)
+            if occupied[rr0:rr1, cc0:cc1].any():
