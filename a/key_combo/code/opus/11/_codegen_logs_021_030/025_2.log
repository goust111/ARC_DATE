+def _ring_from_notches(
+    height: int,
+    width: int,
+    top_notches: list[tuple[int, int, int]],
+    bottom_notches: list[tuple[int, int, int]],
+) -> np.ndarray:
+    mask = np.zeros((height, width), dtype=bool)
+    mask[0, :] = True
+    mask[height - 1, :] = True
+    mask[:, 0] = True
+    mask[:, width - 1] = True
