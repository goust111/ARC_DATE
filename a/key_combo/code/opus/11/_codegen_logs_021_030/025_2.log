+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (16, 20)
+GRID_W_RANGE = (16, 20)
+REGION_COUNT_RANGE = (3, 5)
+AREA_CHOICES = [4, 6, 8, 10, 12, 14]
+PLACEMENT_MARGIN = 1
+PLACEMENT_GAP = 1
+GEN_ATTEMPTS = 400
