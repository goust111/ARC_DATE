+    for idx in order:
+        patch = patches[idx]
+        ph, pw = patch.shape
+        positions = [
+            (r0, c0)
+            for r0 in range(PLACEMENT_MARGIN, grid_h - ph - PLACEMENT_MARGIN + 1)
+            for c0 in range(PLACEMENT_MARGIN, grid_w - pw - PLACEMENT_MARGIN + 1)
