+def _paste_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    window = grid[r0 : r0 + h, c0 : c0 + w]
+    nonzero = patch != BLACK
+    window[nonzero] = patch[nonzero]
