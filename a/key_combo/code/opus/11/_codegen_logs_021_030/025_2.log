+    if height % 2:
+        center = random.choice(core_choices)
+        above: list[tuple[int, int]] = []
+        prev = center
+        for _ in range(height // 2):
+            nxt = _choose_overlapping_interval(prev, width, centered=False)
+            if nxt is None:
+                return None
+            above.append(nxt)
+            prev = nxt
