+                "boundary_area": int(boundary_mask.sum()),
+                "color": int(_classify_boundary(boundary_mask)),
+            }
+        )
+    return info
+
+
+def _is_valid_input(grid: np.ndarray) -> bool:
+    if grid.ndim != 2 or max(grid.shape) > 30:
