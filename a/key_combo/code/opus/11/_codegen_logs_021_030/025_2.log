+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GRID_H_RANGE = (15, 19)
+GRID_W_RANGE = (15, 19)
+REGION_COUNT_RANGE = (3, 5)
+AREA_CHOICES = [4, 6, 8, 10, 12, 14]
+PLACEMENT_MARGIN = 1
+PLACEMENT_GAP = 2
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 200
+
+
+def _neighbors4(r: int, c: int):
+    for dr, dc in DIR4:
+        yield r + dr, c + dc
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    coords = np.argwhere(mask)
+    return coords.size > 0 and len(_components(mask)) == 1
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
+
+
+def _symmetry_flags(mask: np.ndarray) -> tuple[bool, bool]:
+    horizontal = bool(np.array_equal(mask, np.flipud(mask)))
+    vertical = bool(np.array_equal(mask, np.fliplr(mask)))
+    return horizontal, vertical
+
+
+def _classify_boundary(mask: np.ndarray) -> int:
+    horizontal, vertical = _symmetry_flags(mask)
+    if horizontal and vertical:
+        return GREEN
+    if horizontal:
+        return BLUE
+    if vertical:
+        return RED
+    raise ValueError("boundary does not match a supported symmetry class")
+
+
+def _row_interval_mask(intervals: list[tuple[int, int]], width: int) -> np.ndarray:
+    mask = np.zeros((len(intervals), width), dtype=bool)
+    for r, (c0, c1) in enumerate(intervals):
+        mask[r, c0 : c1 + 1] = True
+    return mask
+
+
+def _append_segment(path: list[tuple[int, int]], r0: int, c0: int, r1: int, c1: int) -> None:
+    if r0 == r1:
+        step = 1 if c1 >= c0 else -1
+        cells = [(r0, c) for c in range(c0, c1 + step, step)]
+    else:
+        step = 1 if r1 >= r0 else -1
+        cells = [(r, c0) for r in range(r0, r1 + step, step)]
+    if path and cells and path[-1] == cells[0]:
+        cells = cells[1:]
+    path.extend(cells)
+
+
+def _path_from_profiles(top: list[int], bottom: list[int]) -> list[tuple[int, int]]:
+    width = len(top)
+    path: list[tuple[int, int]] = []
+    _append_segment(path, top[0], 0, top[0], 0)
+    for c in range(width - 1):
+        _append_segment(path, top[c], c, top[c], c + 1)
+        _append_segment(path, top[c], c + 1, top[c + 1], c + 1)
+    _append_segment(path, top[-1], width - 1, bottom[-1], width - 1)
+    for c in range(width - 1, 0, -1):
+        _append_segment(path, bottom[c], c, bottom[c], c - 1)
+        _append_segment(path, bottom[c], c - 1, bottom[c - 1], c - 1)
+    _append_segment(path, bottom[0], 0, top[0], 0)
+    if path and path[-1] == path[0]:
+        path.pop()
+    return path
+
+
+def _cycle_mask_from_profiles(top: list[int], bottom: list[int]) -> np.ndarray:
+    height = max(bottom) + 1
+    width = len(top)
+    mask = np.zeros((height, width), dtype=bool)
+    for r, c in _path_from_profiles(top, bottom):
+        mask[r, c] = True
+    return mask
+
+
+def _is_cycle(mask: np.ndarray) -> bool:
+    if mask.sum() == 0 or len(_components(mask)) != 1:
+        return False
+    pts = {tuple(map(int, rc)) for rc in np.argwhere(mask)}
+    for r, c in pts:
+        degree = sum((nr, nc) in pts for nr, nc in _neighbors4(r, c))
+        if degree != 2:
+            return False
+    return True
+
+
+def _symmetric_interval(width: int) -> tuple[int, int]:
+    left = random.randint(1, max(1, width // 2 - 1))
+    max_right = width - 2
+    right = width - 1 - left
+    if left > right or right > max_right:
+        return (1, width - 2)
+    return left, right
+
+
+def _build_cycle_patch(kind: str) -> np.ndarray | None:
+    for _ in range(SHAPE_ATTEMPTS):
+        height = random.randint(4, 8)
+        width = random.randint(4, 8)
+        top = [0] * width
+        bottom = [height - 1] * width
+
+        if kind == "H":
+            max_depth = (height - 3) // 2
+            if max_depth < 1 or width < 5:
+                continue
+            length = random.randint(1, width - 3)
+            start = random.randint(1, width - length - 1)
+            if start == width - start - length:
+                continue
+            depth = random.randint(1, max_depth)
+            for c in range(start, start + length):
+                top[c] = depth
+                bottom[c] = height - 1 - depth
+        elif kind == "V":
+            if height < 5 or width < 4:
+                continue
+            left, right = _symmetric_interval(width)
+            depth = random.randint(1, height - 3)
+            for c in range(left, right + 1):
+                top[c] = depth
+        else:
+            max_depth = (height - 3) // 2
+            if max_depth < 1 or width < 4:
+                continue
+            if random.random() < 0.35:
+                pass
+            else:
+                left, right = _symmetric_interval(width)
+                depth = random.randint(1, max_depth)
+                for c in range(left, right + 1):
+                    top[c] = depth
+                    bottom[c] = height - 1 - depth
+
+        if any(bottom[c] - top[c] < 2 for c in range(width)):
+            continue
+        mask = _cycle_mask_from_profiles(top, bottom)
+        if not _is_cycle(mask):
+            continue
+
+        horizontal, vertical = _symmetry_flags(mask)
+        if kind == "H" and not (horizontal and not vertical):
+            continue
+        if kind == "V" and not (vertical and not horizontal):
+            continue
+        if kind == "B" and not (horizontal and vertical):
+            continue
+
+        patch = np.zeros(mask.shape, dtype=int)
+        patch[mask] = GREY
+        enclosed = _extract_enclosed_regions(patch)
+        if len(enclosed) != 1:
+            continue
+        if not (4 <= int(enclosed[0].shape[0]) <= 20):
+            continue
+        if not (10 <= int(mask.sum()) <= 30):
+            continue
+        return patch
+    return None
+
+
+def _paste_patch(grid: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    window = grid[r0 : r0 + h, c0 : c0 + w]
+    nonzero = patch != BLACK
+    window[nonzero] = patch[nonzero]
+
+
+def _extract_enclosed_regions(grid: np.ndarray) -> list[np.ndarray]:
+    h, w = grid.shape
+    black = grid == BLACK
+    seen = np.zeros((h, w), dtype=bool)
+    enclosed: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not black[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
