        if _gen_base_area(kind, h, w) <= upper and lower <= upper:
            options.append((h, w))
    return options


def _gen_frontier_orbits(mask, kind, forbidden, limit):
    h, w = mask.shape
    seen = set()
    choices = []
    for r in range(h):
        for c in range(w):
            if mask[r, c]:
                continue
            orbit = _gen_orbit(kind, mask.shape, r, c)
            if orbit in seen or any(cell in forbidden for cell in orbit):
                continue
            seen.add(orbit)
