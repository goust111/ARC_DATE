+    mask[0, :] = True
+    mask[height - 1, :] = True
+    mask[:, 0] = True
+    mask[:, width - 1] = True
+
+    for left, right, depth in top_notches:
+        mask[0, left + 1 : right] = False
+        mask[: depth + 1, left] = True
+        mask[: depth + 1, right] = True
+        mask[depth, left : right + 1] = True
