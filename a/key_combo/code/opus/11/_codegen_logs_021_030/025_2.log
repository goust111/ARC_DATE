+GRID_H_RANGE = (15, 19)
+GRID_W_RANGE = (15, 19)
+REGION_COUNT_RANGE = (3, 5)
+AREA_CHOICES = [4, 6, 8, 10, 12, 14]
+PLACEMENT_MARGIN = 1
+PLACEMENT_GAP = 2
+GEN_ATTEMPTS = 400
+SHAPE_ATTEMPTS = 200
