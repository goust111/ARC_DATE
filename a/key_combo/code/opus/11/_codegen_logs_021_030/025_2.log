+                continue
+            max_depth = (height - 3) // 2
+            if max_depth < 1:
+                continue
+            depth = random.randint(1, max_depth)
+            top_notches = [(left, right, depth)]
+            bottom_notches = [(left, right, depth)]
+        elif kind == "V":
+            if height < 5 or width < 5:
+                continue
+            left = random.randint(1, max(1, width // 2 - 1))
+            right = width - 1 - left
+            if left >= right:
