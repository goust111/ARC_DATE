    assert len(centers) == 1
    center = centers[0]
    lengths = {}
    covered = {center}
    for dr, dc in DIRS4:
        rr, cc = center
        length = 0
        while (rr + dr, cc + dc) in cells:
            rr += dr
            cc += dc
            covered.add((rr, cc))
            length += 1

