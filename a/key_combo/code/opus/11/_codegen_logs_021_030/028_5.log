    expected[final_blue[:, 0], final_blue[:, 1]] = BLUE
    for r, c in _mirror_coords(final_blue, _parse_wall(expected + (expected == GREY) * 0 + (expected == GREY) * 0)):
        if expected[r, c] != BG:
