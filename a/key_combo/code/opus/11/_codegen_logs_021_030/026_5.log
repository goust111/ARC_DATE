38: def main(grid: np.ndarray) -> np.ndarray:
39:     """
40:     Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.
41: 
42:     Input structure:
43:     - Blue is absent from the input.
44:     - One rare marker color appears in exactly two pixels.
45:     - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.
46:     - The whole grid, including background and foreground objects, is the sprite to transform.
47: 
48:     Rule:
49:     - Rotate the entire input grid 90 degrees counterclockwise.
50:     - Create a blue one-pixel frame around two vertical copies of the rotated grid.
51:     - Use the input background color for the two endpoints of every horizontal frame/separator row.
52: 
53:     Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.
54:     """
55:     g = np.asarray(grid, dtype=int)
56:     assert g.ndim == 2
57: 
58:     bg, objects = _infer_background_and_objects(g)
59:     assert bg != Color.BLUE
60:     assert Color.BLUE not in set(map(int, g.ravel()))
61: 
62:     copies = len(objects)
63: 
64:     tile = np.rot90(g, 1)
65:     tile_h, tile_w = map(int, tile.shape)
66: 
67:     out_h = copies * tile_h + copies + 1
68:     out_w = tile_w + 2
69:     out = np.full((out_h, out_w), Color.BLUE, dtype=int)
70: 
71:     for i in range(copies):
72:         row = i * (tile_h + 1)
73:         out[row, 0] = bg
74:         out[row, -1] = bg
75:         paste(out, tile, row + 1, 1)
76: 
77:     out[-1, 0] = bg
78:     out[-1, -1] = bg
79:     return out
80: 
81: # --------------- generator (att2, o5x) ---------------
82: # CFG: ranges use numpy's high-exclusive convention where applicable.
83: CANVAS_SHAPE_RANGES = ((5, 10), (5, 11))
84: OBJECT_SHAPE_RANGES = ((2, 5), (2, 5))
85: MIN_SEPARATION_GAP = 1
86: MAX_OUTPUT_SIZE = 30
87: INPUT_COLORS = [0, 2, 3, 4, 5, 6, 7, 8, 9]
88: PALETTE_SIZE = 3
89: FRAME_COLOR = Color.BLUE
90: OUTPUT_TILE_COPIES = 2
91: FRAME_THICKNESS = 1
92: MAX_GENERATION_ATTEMPTS = 300
93: 
94: def _edge_cells(h: int, w: int) -> list[tuple[int, int]]:
95:     return [
96:         (r, c)
97:         for r in range(h)
98:         for c in range(w)
99:         if r in (0, h - 1) or c in (0, w - 1)
100:     ]
101: 
102: def _expected_output(inp: np.ndarray, bg: int) -> np.ndarray:
103:     tile = np.rot90(inp, 1)
104:     tile_h, tile_w = tile.shape
105:     out_h = OUTPUT_TILE_COPIES * tile_h + (OUTPUT_TILE_COPIES + 1) * FRAME_THICKNESS
106:     out_w = tile_w + 2 * FRAME_THICKNESS
107:     out = np.full((out_h, out_w), FRAME_COLOR, dtype=int)
108:     out[0, 0] = out[0, -1] = bg
109:     out[tile_h + FRAME_THICKNESS, 0] = out[tile_h + FRAME_THICKNESS, -1] = bg
110:     out[-1, 0] = out[-1, -1] = bg
111:     out[FRAME_THICKNESS : FRAME_THICKNESS + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile
112:     second_top = tile_h + 2 * FRAME_THICKNESS
113:     out[second_top : second_top + tile_h, FRAME_THICKNESS : FRAME_THICKNESS + tile_w] = tile
114:     return out
115: 
116: def _sample_object_dims(canvas_h: int, canvas_w: int) -> tuple[int, int] | None:
117:     feasible_dims = [
118:         (oh, ow)
119:         for oh in range(*OBJECT_SHAPE_RANGES[0])
120:         for ow in range(*OBJECT_SHAPE_RANGES[1])
121:         if oh <= canvas_h and ow <= canvas_w and (
122:             canvas_h - 2 * oh >= MIN_SEPARATION_GAP
123:             or canvas_w - 2 * ow >= MIN_SEPARATION_GAP
124:         )
125:     ]
126:     if not feasible_dims:
127:         return None
128:     return feasible_dims[int(np.random.randint(len(feasible_dims)))]
129: 
130: 
131: def _gen_attempt() -> np.ndarray | None:
132:     H = int(np.random.randint(*CANVAS_SHAPE_RANGES[0]))
133:     W = int(np.random.randint(*CANVAS_SHAPE_RANGES[1]))
134: 
135:     dims = _sample_object_dims(H, W)
136:     if dims is None:
137:         return None
138:     oh, ow = dims
139: 
140:     bg, body, marker = map(int, np.random.choice(INPUT_COLORS, size=PALETTE_SIZE, replace=False))
141:     inp = np.full((H, W), bg, dtype=int)
142:     inp[:oh, :ow] = body
143:     inp[H - oh : H, W - ow : W] = body
144:     mr, mc = _edge_cells(oh, ow)[int(np.random.randint(2 * oh + 2 * ow - 4))]
145:     inp[mr, mc] = marker
146:     inp[H - oh + mr, W - ow + mc] = marker
147: 
148:     expected = _expected_output(inp, bg)
149:     if expected.shape[0] > MAX_OUTPUT_SIZE or expected.shape[1] > MAX_OUTPUT_SIZE:
150:         return None
151: 
152:     try:
153:         actual = main(inp)
154:     except AssertionError:
155:         return None
156:     if not np.array_equal(actual, expected):
157:         return None
158:     return inp
159: 
160: 
161: def generate_input() -> np.ndarray:
162:     for _ in range(MAX_GENERATION_ATTEMPTS):
163:         inp = _gen_attempt()
164:         if inp is not None:
165:             return inp
166:     raise RuntimeError("failed to generate valid input")
