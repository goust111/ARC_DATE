15: def main(input_grid: np.ndarray) -> np.ndarray:
16:     """
17:     Crop the colored rectangle frame and connect scattered pixels to the same-colored frame side.
18: 
19:     Input structure:
20:     - Four full non-black lines form a rectangle on a black background.
21:     - Each frame side has a distinct color.
22:     - Extra scattered pixels share the color of exactly one frame side.
23: 
24:     Rule:
25:     - Locate the two full horizontal and two full vertical frame lines.
26:     - Identify the scattered pixel color outside those lines.
27:     - Crop to the frame and draw straight connections from each scattered pixel to the matching-colored side.
28: 
29:     Key insight:
30:     - The scattered pixel color selects which frame side to connect to after the rectangle
31:       is cropped out of the larger grid.
32:     """
33:     output_grid = np.copy(input_grid)
34:     
35:     # Identify two vertical and two horizontal lines
36:     horizontal_lines = np.where(np.all(output_grid != Color.BLACK, axis=1))[0]
37:     vertical_lines = np.where(np.all(output_grid != Color.BLACK, axis=0))[0]
38:     
39:     # Find out the color of the scattered pixels
40:     mask = np.ones(output_grid.shape, dtype=bool)
41:     mask[horizontal_lines, :] = False
42:     mask[:, vertical_lines] = False
43:     color = output_grid[mask & (output_grid != Color.BLACK)][0]
44:     
45:     # Crop the grid by the rectangle formed by the four lines
46:     output_grid = output_grid[horizontal_lines[0] : horizontal_lines[1] + 1, vertical_lines[0] : vertical_lines[1] + 1]
47:     
48:     # Extend the scattered pixels to the line that has same color as the scattered pixels
49:     for r in range(len(output_grid)):
50:         for c in range(len(output_grid[0])):
51:             # did we find a scattered pixel? (of color `color`)
52:             if output_grid[r, c] == color:
53:                 # draw a line to the matching color line, which is going to be either left/right/top/bottom
54:                 # so we need to examine four cases for each location that the matching color line might be
55: 
56:                 # Left: x=0 indicates this is the left line
57:                 if output_grid[0, c] == color:
58:                     draw_line(output_grid, r, c, end_r= 0, end_c= c, color = color)
59:                 # Right: x=len(output_grid) - 1 indicates this is the right line
60:                 if output_grid[len(output_grid) - 1, c] == color:
61:                     draw_line(output_grid, r, c, end_r= len(output_grid) - 1, end_c= c, color = color)
62:                 # Top: y=0 indicates this is the top line
63:                 if output_grid[r, 0] == color:
64:                     draw_line(output_grid, r, c, end_r= r, end_c= 0, color = color)
65:                 # Bottom: y=len(output_grid[0]) - 1 indicates this is the bottom line
66:                 if output_grid[r, len(output_grid[0]) - 1] == color:
67:                     draw_line(output_grid, r, c, end_r= r, end_c= len(output_grid[0]) - 1, color = color)
68: 
69:     return output_grid
