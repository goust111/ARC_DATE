+        pool = [v for v in range(4, 11)]
+        values.extend(rng.choice(pool, size=3, replace=False).tolist())
+    elif mode == 1:
+        values = [10]
+        pool = [v for v in range(3, 10)]
+        values.extend(rng.choice(pool, size=3, replace=False).tolist())
+    else:
+        values = rng.choice(np.arange(3, 11), size=4, replace=False).tolist()
