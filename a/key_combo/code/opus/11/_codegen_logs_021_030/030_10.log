+    for comp in comps:
+        if not _is_rectangular_frame(comp):
+            raise AssertionError("all red components must be 1-pixel rectangular frames")
+        rows = comp[:, 0]
+        cols = comp[:, 1]
+        boxes.append((int(rows.min()), int(cols.min()), int(rows.max()), int(cols.max())))
