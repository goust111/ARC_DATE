+    has_diag = any((r + dr, c + dc) in frame for dr, dc in ((-1, -1), (-1, 1), (1, -1), (1, 1)))
+    has_ortho = any((r + dr, c + dc) in frame for dr, dc in DIR4)
+    return has_diag and not has_ortho
