+    h, w = grid.shape
+    rounds = 0
+    prev_box = None
+    for box in boxes:
+        r0, c0, r1, c1 = box
+        corners = [(r0 - 1, c0 - 1), (r0 - 1, c1 + 1), (r1 + 1, c0 - 1), (r1 + 1, c1 + 1)]
+        for rr, cc in corners:
+            if not _in_bounds((h, w), rr, cc):
+                raise AssertionError("outer frame must have padding for diagonal validation")
+            if grid[rr, cc] != BG:
