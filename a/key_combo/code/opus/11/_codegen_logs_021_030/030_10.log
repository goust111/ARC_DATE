+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+GEN_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _bbox(mask: np.ndarray):
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    dirs = DIR4 if connectivity == 4 else DIR8
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for dr, dc in dirs:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _frame_local_mask(height: int, width: int) -> np.ndarray:
+    out = np.zeros((height, width), dtype=bool)
+    out[0, :] = True
+    out[-1, :] = True
+    out[:, 0] = True
+    out[:, -1] = True
+    return out
+
+
+def _frame_coords(box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = box
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _is_rectangular_frame(comp: np.ndarray) -> bool:
+    if len(comp) < 8:
+        return False
+    rows = comp[:, 0]
+    cols = comp[:, 1]
+    r0, c0 = rows.min(), cols.min()
+    r1, c1 = rows.max(), cols.max()
+    h = int(r1 - r0 + 1)
+    w = int(c1 - c0 + 1)
+    if h < 3 or w < 3:
+        return False
+    local = np.zeros((h, w), dtype=bool)
+    local[rows - r0, cols - c0] = True
+    return np.array_equal(local, _frame_local_mask(h, w))
+
+
+def _extract_frame_boxes(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    comps = _components(grid == RED, connectivity=4)
