+    order = sorted(range(len(representatives)), key=lambda idx: (counts[idx], idx))
+    return np.array([[int(representatives[idx]) for idx in order]], dtype=int)
+
+
+def _validate_generated(grid: np.ndarray, expected: np.ndarray) -> None:
