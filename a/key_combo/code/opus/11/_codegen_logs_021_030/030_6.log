+
+def _runs(values: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    start: int | None = None
+    sentinel = list(map(bool, values)) + [False]
+    for idx, value in enumerate(sentinel):
+        if value and start is None:
+            start = idx
+        elif not value and start is not None:
+            runs.append((start, idx - 1))
+            start = None
+    return runs
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = map(int, mask.shape)
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _reflection_orbit(row: int, col: int, height: int, width: int) -> tuple[tuple[int, int], ...]:
+    return tuple(
+        sorted(
+            {
+                (row, col),
+                (row, width - 1 - col),
+                (height - 1 - row, col),
+                (height - 1 - row, width - 1 - col),
+            }
+        )
+    )
+
+
+def _repair_tile(tile: np.ndarray) -> tuple[np.ndarray, int]:
+    h, w = map(int, tile.shape)
+    out = tile.copy()
+    seen: set[tuple[tuple[int, int], ...]] = set()
+    repaired = 0
+    for r in range(h):
+        for c in range(w):
+            orbit = _reflection_orbit(r, c, h, w)
+            if orbit in seen:
+                continue
+            seen.add(orbit)
