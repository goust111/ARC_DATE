+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+GREY = 5
+PALETTE = np.array([1, 2, 4, 6, 7, 8, 9], dtype=int)
+RNG = np.random.default_rng()
