+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+TEAL = 8
+
+MACRO_ROWS = 3
+MACRO_COLS = 3
+CELL_SIZE = 2
+MACRO_SHAPE = (MACRO_ROWS * CELL_SIZE, MACRO_COLS * CELL_SIZE)
