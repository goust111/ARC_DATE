+
+    for _ in range(80):
+        chosen = random.sample(candidates, count)
+        if all(max(abs(r0 - r1), abs(c0 - c1)) > 1 for i, (r0, c0) in enumerate(chosen) for r1, c1 in chosen[i + 1 :]):
+            return chosen
