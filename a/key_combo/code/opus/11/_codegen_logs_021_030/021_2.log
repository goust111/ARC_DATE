from __future__ import annotations
import random
from collections import deque
import numpy as np

BG=0
FILL=3
COLORS=(1,2,4,6)

def find_rectangles(g):
    H,W=g.shape
    seen=np.zeros((H,W),bool)
    rects=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]==0 or seen[r,c]:
                continue
            color=int(g[r,c])
            q=deque([(r,c)])
            seen[r,c]=1
            pts=[]
            while q:
                rr,cc=q.popleft(); pts.append((rr,cc))
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and not seen[nr,nc] and g[nr,nc]==color:
                        seen[nr,nc]=1; q.append((nr,nc))
            rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
            r0,r1=min(rs),max(rs); c0,c1=min(cs),max(cs)
            h,w=r1-r0+1,c1-c0+1
            patch=g[r0:r1+1,c0:c1+1]
            assert np.all(patch==color)
            rects.append(dict(color=color, top=r0, left=c0, h=h, w=w))
    rects.sort(key=lambda d:d['left'])
    return rects

def stack_rectangles(rects):
    H=sum(r['h'] for r in rects)-len(rects)+1
    W=sum(r['w'] for r in rects)-len(rects)+1
    patch=np.zeros((H,W),int)
    placed=[]
    r0=c0=0
    for i,rect in enumerate(rects):
        h,w,color=rect['h'],rect['w'],rect['color']
        patch[r0:r0+h,c0:c0+w]=color
        placed.append((r0,c0,h,w,color))
        if i+1 < len(rects):
            r0 += h-1
            c0 += w-1
    return patch,placed

def mirror_patch(src):
    H,W=src.shape
    out=np.zeros_like(src)
    for rt in range(H):
        for ct in range(W):
            sr=min(H-1, int((ct + 0.5) * H / W))
            sc=min(W-1, int((rt + 0.5) * W / H))
            out[rt, ct] = src[sr, sc]
    return out

def enclosed_fill(combined):
    H,W=combined.shape
    vis=np.zeros((H,W),bool)
    q=deque()
    for r in range(H):
        for c in (0,W-1):
            if combined[r,c]==0 and not vis[r,c]:
                vis[r,c]=1;q.append((r,c))
    for c in range(W):
        for r in (0,H-1):
            if combined[r,c]==0 and not vis[r,c]:
                vis[r,c]=1;q.append((r,c))
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nr,nc=r+dr,c+dc
            if 0<=nr<H and 0<=nc<W and combined[nr,nc]==0 and not vis[nr,nc]:
                vis[nr,nc]=1;q.append((nr,nc))
    gap=(combined==0)&(~vis)
    out=combined.copy(); out[gap]=FILL
    return out,gap

def solve_from_rects(rects, shape=(18,18)):
    patch,_=stack_rectangles(rects)
    mir=mirror_patch(patch)
    combined=patch.copy()
    m=(combined==0)&(mir"'!=0)
    combined[m]=mir[m]
    local,gap=enclosed_fill(combined)
    out=np.zeros(shape,int)
    out[:local.shape[0],:local.shape[1]] = local
    return out,patch,mir,gap

def gen_one():
    for _ in range(10000):
        n=random.choice([3,4])
        prefer_nonsquare = random.random() < 0.65
        dims=[]
        sumh=sumw=0
        for _i in range(n):
            h=random.randint(3,5); w=random.randint(2,4)
            dims.append((h,w)); sumh+=h; sumw+=w
        if prefer_nonsquare and sumh==sumw:
            continue
        if not prefer_nonsquare and sumh!=sumw:
            continue
        rects=[{'"'h':h,'w':w,'color':c} for (h,w),c in zip(dims, random.sample(COLORS,n))]
        patch,_=stack_rectangles(rects)
        if patch.shape[0] > 20 or patch.shape[1] > 20:
            continue
        out,stacked,mir,gap=solve_from_rects(rects, shape=(22,22))
        if gap.sum() < 2:
            continue
        if np.array_equal(stacked, mir):
            continue
        if np.count_nonzero((stacked==0)&(mir"'!=0)) < 3:
            continue
        gaps=[random.randint(1,3) for _ in range(n-1)]
        input_w=sum(r['"'w'] for r in rects)+sum(gaps)
        grid_h=random.randint(max(16,patch.shape[0]),22)
        grid_w=random.randint(max(16,input_w,patch.shape[1]),22)
        left=random.randint(0, grid_w-input_w)
        g=np.zeros((grid_h,grid_w),int)
        c=left
        for rect, gapw in zip(rects, gaps+[None]):
            r0=grid_h-rect['h']
            g[r0:grid_h, c:c+rect['w']] = rect['color']
            c += rect['w'] + (gapw or 0)
        return g,out,gap.sum(),patch.shape
    raise RuntimeError

for i in range(20):
    inp,out,gc,shape=gen_one()
    rects=find_rectangles(inp)
    out2,patch,mir,gap=solve_from_rects(rects, shape=inp.shape)
    assert np.array_equal(out, out2)
    print(i, inp.shape, shape, gc, len(rects))
print('ok')
