+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                assert int(grid[rr, cc]) == color, "foreground regions must be monochromatic"
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
