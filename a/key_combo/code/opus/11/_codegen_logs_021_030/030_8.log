+    out_h = max(int(comp["area"]) for comp in ordered)
+    out_w = len(ordered)
+    out = np.zeros((out_h, out_w), dtype=int)
+
+    for col, comp in enumerate(ordered):
+        height = int(comp["area"])
+        color = int(comp["color"])
+        out[out_h - height :, col] = color
