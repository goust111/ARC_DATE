    r0, c0, r1, c1 = box
    g[r0, c0 : c1 + 1] = _GEN_BLUE
    g[r1, c0 : c1 + 1] = _GEN_BLUE
    g[r0 : r1 + 1, c0] = _GEN_BLUE
    g[r0 : r1 + 1, c1] = _GEN_BLUE


