spec:
  grid: 10x10
  background: 0 (black)
  layout: |
    row 0:    marker run (contiguous horizontal, starts at col 0, color 8/azure)
    rows 1-5: empty (all background)
    row 6:    full-width separator (solid color 5/gray)
    row 7:    empty (all background)
    row 8:    code row (every cell non-background)
    row 9:    empty (all background)
  marker:
    color: 8 (azure) [observed]
    length: 1-4 (contiguous run starting at col 0)
    row: 0 [observed]
  separator:
    color: 5 (gray), distinct from bg, marker, and all code colors [observed]
    row: 6 [observed]
  code_row:
    row: 8 [observed]
    colors: 2-5 distinct non-bg non-separator colors per row
    each cell is non-background
    at least one color must appear exactly marker_length times
    constraint: marker_length <= separator_row so bars fit above separator
  transform:
    count marker pixels (= N)
    find code-row colors whose frequency == N
    for each such cell, draw a vertical bar of that color N cells tall immediately above the separator
    output is same as input plus these bars (bg cells overwritten)
  output_bars:
    selected_columns: 1-6 columns get bars
    matching_colors: 1-3 distinct colors with frequency == marker_length

generation_strategy:
  approach: direct construction (layout is rigid, constraints are simple)
