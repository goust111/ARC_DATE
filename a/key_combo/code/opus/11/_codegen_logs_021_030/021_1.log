+                other = int(labels[rr, cc])
+                if other in emitter_ids:
+                    result = {"source": comp_id, "dir": (dr, dc), "kind": "blocked", "target": other}
+                    break
+                if other in receivers:
+                    hit_counts[other] += 1
+                    result = {"source": comp_id, "dir": (dr, dc), "kind": "hit", "target": other}
+                    break
