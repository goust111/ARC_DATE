+    rays = []
+    emitter_ids = set(emitters)
+    for comp_id, info in emitters.items():
+        hole_r, hole_c = info["hole"]
+        for dr, dc in DIRS4:
+            rr, cc = hole_r, hole_c
+            result = {"source": comp_id, "dir": (dr, dc), "kind": "edge", "target": None}
+            while True:
