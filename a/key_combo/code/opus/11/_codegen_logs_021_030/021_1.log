+        return False
+    if not (out == RED).any():
+        return False
+    if not (out == GREY).any():
+        return False
+
+    blue_components = 0
+    red_components = 0
+    grey_receiver_components = 0
+    for comp_id, info in receivers.items():
+        color = int(out[info["coords"][0][0], info["coords"][0][1]])
