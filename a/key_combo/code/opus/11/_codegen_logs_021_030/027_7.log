+def _detect_crosses(grid: np.ndarray) -> list[dict[str, int | tuple[int, int] | set[tuple[int, int]]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    crosses = []
+    claimed: set[tuple[int, int]] = set()
