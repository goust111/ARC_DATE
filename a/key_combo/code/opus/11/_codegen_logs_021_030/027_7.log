    q, n_cells = int(winner.shape[0]), int(winner.size)
    masks = [winner == layer for layer in range(_GEN_LAYER_COUNT)]
    layer_lower, layer_upper, hidden_choices = [], [], []
    for layer, mask in enumerate(masks):
