+def _ray_length(grid: np.ndarray, r: int, c: int, dr: int, dc: int, color: int) -> int:
+    steps = 0
+    rr = r + dr
+    cc = c + dc
+    while _in_bounds(grid.shape, rr, cc) and int(grid[rr, cc]) == color:
+        steps += 1
+        rr += dr
+        cc += dc
