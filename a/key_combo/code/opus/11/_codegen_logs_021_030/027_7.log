+        grid[r, c] = center_color
+        for step in range(1, arm_len + 1):
+            grid[r - step, c] = arm_color
+            grid[r + step, c] = arm_color
+            grid[r, c - step] = arm_color
+            grid[r, c + step] = arm_color
