+                _ray_length(g, r, c, -1, 0, arm_color),
+                _ray_length(g, r, c, 1, 0, arm_color),
+                _ray_length(g, r, c, 0, -1, arm_color),
+                _ray_length(g, r, c, 0, 1, arm_color),
