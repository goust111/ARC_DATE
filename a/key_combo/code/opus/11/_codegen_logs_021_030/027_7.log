+        for c in range(g.shape[1]):
+            center_color = int(g[r, c])
+            if center_color == bg:
+                continue
+            neighbor_colors = []
+            ok = True
+            for dr, dc in _ORTHO_DIRS:
+                rr = r + dr
+                cc = c + dc
+                if not _in_bounds(g.shape, rr, cc):
+                    ok = False
+                    break
+                val = int(g[rr, cc])
+                if val == bg or val == center_color:
+                    ok = False
+                    break
