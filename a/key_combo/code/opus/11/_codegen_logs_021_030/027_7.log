+    height_lo = max(_GRID_MIN, cluster_h + 2)
+    width_lo = max(_GRID_MIN, cluster_w + 2)
+    height = random.randint(height_lo, _GRID_MAX)
+    width = random.randint(width_lo, _GRID_MAX)
