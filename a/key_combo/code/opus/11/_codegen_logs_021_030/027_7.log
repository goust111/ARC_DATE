+                    if (rr, cc) in expected:
+                        if (rr, cc) == (r, c):
+                            if val != center_color:
+                                ok = False
+                                break
+                        elif val != arm_color:
+                            ok = False
+                            break
+                    elif val != bg:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if not ok or expected & claimed:
+                continue
+
+            claimed |= expected
+            crosses.append(
+                {
+                    "center": (r, c),
+                    "arm_len": arm_len,
+                    "arm_color": arm_color,
+                    "center_color": center_color,
+                    "input_cells": expected,
+                }
+            )
