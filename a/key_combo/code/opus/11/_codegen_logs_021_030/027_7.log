+import numpy as np
+
+
+_ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+_DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+_COLOR_POOL = tuple(range(1, 10))
+_GRID_MIN = 13
+_GRID_MAX = 19
+_GEN_RETRIES = 400
