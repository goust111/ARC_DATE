+    r, c = center
+    cells = {(r, c)}
+    for step in range(1, arm_len + 1):
+        cells.add((r - step, c))
+        cells.add((r + step, c))
+        cells.add((r, c - step))
+        cells.add((r, c + step))
+    return cells
+
