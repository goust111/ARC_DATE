+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+SOURCE = 5
+PALETTE = (BLUE, RED, GREEN, YELLOW)
+SIDES = ("top", "bottom", "left", "right")
+
+GRID_MIN = 18
+GRID_MAX = 24
+INNER_MIN = 5
+INNER_MAX = 8
+GEN_RETRIES = 400
+
+_GEN_CALL_COUNT = 0
+
+
