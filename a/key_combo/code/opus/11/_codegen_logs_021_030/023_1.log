+def _gap_patterns(layer_count: int) -> list[tuple[int, ...]]:
+    if layer_count == 3:
+        return [(2, 2), (2, 3), (3, 2), (3, 3)]
+    return [(2, 2, 2), (2, 2, 3), (2, 3, 2), (3, 2, 2)]
+
+
+def _build_boxes(
+    rng: np.random.Generator, shape: tuple[int, int], layer_count: int
+) -> list[BBox] | None:
