+        comp = comps[0]
+        blocks.append(
+            {
+                "color": int(src),
+                "coords": comp,
+                "bbox": _bbox(comp),
+                "area": int(comp.shape[0]),
+            }
+        )
+    assert len(blocks) == len(cavities), "outline count and block count must match"
