    output, triangle_mask, motif_mask = placed

    inp = output.copy()
    inp[triangle_mask] = 0

    if not _gen_add_controls(inp, triangle_mask, motif_mask, corner, side, colors, fill_color, motif_color):
        return None

    try:
        solved = main(inp)
    except Exception:
        return None
    if not np.array_equal(solved, output):
        return None
    return inp


