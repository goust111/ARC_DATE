+        grid = _build_candidate_grid(orientation, guide_idx, rect_h, rect_w, rect_r0, rect_c0)
+        if grid is None:
+            continue
+        _validate_generated_input(grid)
+        return grid
+
+    raise RuntimeError("failed to generate a valid guided-tiling rectangle input")

