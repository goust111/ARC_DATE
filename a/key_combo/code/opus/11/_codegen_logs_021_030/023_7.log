+        grid[rect_mask] = rect_color
+        grid[guide_mask] = GUIDE_COLOR
+
+        distractor_count = random.randint(2, min(4, len(free_cells) - 2))
+        distractors = set(random.sample(free_cells, distractor_count))
+        for r, c in free_cells:
