+
+    rect_mask = np.zeros_like(g, dtype=bool)
+    rect_mask[r0 : r0 + h, c0 : c0 + w] = True
+    guide_mask = np.zeros_like(g, dtype=bool)
+    if orient == "row":
+        guide_mask[guide_idx, :] = True
+    else:
