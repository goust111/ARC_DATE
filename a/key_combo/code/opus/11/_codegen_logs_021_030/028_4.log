               and g + 2 <= SHAPE_WIDTH_BOUNDS[1]]
    if not factors:
        return None
    arm_gap, arm_height = random.choice(factors)

    pixels = set()
    for ri in range(arm_height):
        pixels.add((ri, 0))
        pixels.add((ri, arm_gap + 1))
    for c in range(arm_gap + 2):
        pixels.add((arm_height, c))


