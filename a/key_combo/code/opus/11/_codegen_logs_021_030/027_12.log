+    refs = _reference_values(grid, r, c, blocked={GREY, ORANGE})
+    if not refs:
+        return 0
+    values = [value for _name, _coord, value in refs]
+    if len(set(values)) == 1:
+        return values[0]
+    return refs[0][2]
