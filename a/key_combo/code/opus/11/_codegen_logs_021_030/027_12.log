    m = int(seed.shape[0])
    side = 2 * m - 1
    full = np.zeros((side, side), dtype=int)
    for r in range(side):
        rr = min(r, side - 1 - r)
        for c in range(side):
            cc = min(c, side - 1 - c)
            full[r, c] = int(seed[rr, cc])
    return full


