+        pr0, pc0, pr1, pc1 = bboxes[-1]
+        parent_h = pr1 - pr0 + 1
+        parent_w = pc1 - pc0 + 1
+        offset_r = (parent_h - child_h) // 2
+        offset_c = (parent_w - child_w) // 2
