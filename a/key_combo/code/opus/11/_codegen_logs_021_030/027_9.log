+        coords = info["coords"]
+        keep = (
+            (coords[:, 0] == r0)
+            | (coords[:, 0] == r1)
+            | (coords[:, 1] == c0)
+            | (coords[:, 1] == c1)
+        )
+        removable = coords[~keep]
+        if removable.size:
+            out[removable[:, 0], removable[:, 1]] = BG
+
+    out[inner_r0 + 1 : inner_r1, inner_c0 + 1 : inner_c1] = marker_color
+    return out
+
+
+def _build_expected(
+    grid: np.ndarray,
+    component_masks: list[np.ndarray],
+    bboxes: list[tuple[int, int, int, int]],
+    marker_color: int,
+) -> np.ndarray:
