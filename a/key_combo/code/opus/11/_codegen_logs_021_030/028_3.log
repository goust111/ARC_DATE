+            obj = objects[color]
+            patch, top_left, _ = _copy_spec(obj, assignment[color], grid.shape)
+            original_cells = _absolute_mask_cells(obj["mask"], obj["bbox"][:2])
+            copy_cells = _absolute_mask_cells(patch, top_left)
+            if not (copy_cells - original_cells):
+                return False
