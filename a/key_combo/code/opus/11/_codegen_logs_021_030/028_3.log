+            for r, c in np.argwhere(mask):
+                r = int(r)
+                c = int(c)
+                for dr, dc in DIRS4:
+                    nr = r + dr
+                    nc = c + dc
+                    if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                        frontier.add((nr, nc))
+            if not frontier:
+                break
+            frontier_list = list(frontier)
+            cell = frontier_list[int(rng.integers(len(frontier_list)))]
+            mask[cell] = True
