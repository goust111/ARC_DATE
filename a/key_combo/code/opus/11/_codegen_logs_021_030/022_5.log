+from __future__ import annotations
+
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+OBJECT = 2
+LINE = 5
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_GENERATION_ATTEMPTS = 400
+SHAPE_CHAR = "#"
