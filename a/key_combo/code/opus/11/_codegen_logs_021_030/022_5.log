+
+def _bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> tuple[int, int]:
+    row_gap = max(0, max(a[0], b[0]) - min(a[2], b[2]) - 1)
+    col_gap = max(0, max(a[1], b[1]) - min(a[3], b[3]) - 1)
+    if a[2] < b[0]:
+        row_gap = b[0] - a[2] - 1
+    elif b[2] < a[0]:
+        row_gap = a[0] - b[2] - 1
+    else:
+        row_gap = 0
+    if a[3] < b[1]:
+        col_gap = b[1] - a[3] - 1
+    elif b[3] < a[1]:
+        col_gap = a[1] - b[3] - 1
+    else:
+        col_gap = 0
+    return int(row_gap), int(col_gap)
