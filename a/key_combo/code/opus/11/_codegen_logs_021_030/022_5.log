+        visible_shrink = False
+        visible_dilate = False
+        for idx, comp in enumerate(comps):
+            cr, cc = comp["center"]
+            parity = (row_rank[cr] + col_rank[cc]) % 2
+            alt_op = "dilate" if parity == 0 else "shrink"
