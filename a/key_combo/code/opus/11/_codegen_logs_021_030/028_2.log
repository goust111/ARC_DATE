+def _wall_span(row: np.ndarray) -> tuple[int, int]:
+    cols = np.flatnonzero(row == GRAY)
+    assert 2 <= cols.size <= 4, "each wall row must have 2..4 gray pixels"
+    return int(cols[0]), int(cols[-1])
