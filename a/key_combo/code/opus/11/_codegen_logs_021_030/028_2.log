+    gap = g[sep + 1 + mask_h : wall_rows[0]]
+    assert gap.shape[0] >= GAP_ROW_MIN, "expected at least one gap row before the walls"
+    assert not np.any(gap == GRAY), "gap rows cannot contain wall pixels"
