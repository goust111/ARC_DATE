+                bottom[r] = _flip_some_cells(base, rng)
+        else:
+            top[r] = base
+            bottom[r] = base.copy()
+
+    return top, bottom
+
+
+def _build_grid(
+    top: np.ndarray,
+    bottom: np.ndarray,
+    intervals: list[tuple[int, int]],
+    rng: np.random.Generator,
