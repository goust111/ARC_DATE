  15: def main(input_grid):
  16:     """
  17:     Compute the XOR of the red patterns above and below the yellow separator row.
  18: 
  19:     Input structure:
  20:     - A full yellow horizontal row separates two equal-sized red and black masks.
  21:     - The top and bottom masks have the same width and height.
  22:     - Red and black encode active and inactive mask cells.
  23: 
  24:     Rule:
  25:     - Locate the yellow separator row.
  26:     - Split the input into top and bottom masks.
  27:     - Output green where the two masks differ and black where they match.
  28: 
  29:     Key insight:
  30:     - The separator only aligns the two masks; the output is their pixelwise exclusive-or.
  31:     """
  32: 
  33:     H, W = input_grid.shape
  34: 
  35:     # Find the yellow horizontal line/bar (a full row of YELLOW).
  36:     c_bar = None
  37:     for r in range(H):
  38:         if np.all(input_grid[r, :] == Color.YELLOW):
  39:             c_bar = r
  40:             break
  41:     assert c_bar is not None
  42:     
  43:     # Extract top and bottom patterns.
  44:     top_pattern = input_grid[:c_bar, :]
  45:     bottom_pattern = input_grid[c_bar + 1 :, :] 
  46: 
  47:     output_grid = np.zeros_like(top_pattern)
  48: 
  49:     # applying the XOR pattern, which is where they are different
  50:     output_grid[(top_pattern != bottom_pattern)] = Color.GREEN
  51:     output_grid[(top_pattern == bottom_pattern)] = Color.BLACK
  52: 
  53:     return output_grid
