+    path = _l_path(start, end, "h")
+    if _path_clear(path, blocked, shape, endpoints):
+        return {
+            "color": pair["color"],
+            "endpoints": pair["endpoints"],
+            "anchor": pair["anchor"],
+            "path": path,
+            "length": len(path) - 1,
+            "kind": "Lh",
+        }
+
+    path = _l_path(start, end, "v")
+    if _path_clear(path, blocked, shape, endpoints):
