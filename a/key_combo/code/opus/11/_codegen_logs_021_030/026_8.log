+                    "color": pair["color"],
+                    "endpoints": pair["endpoints"],
+                    "anchor": pair["anchor"],
+                    "path": candidate,
+                    "length": len(candidate) - 1,
+                    "kind": "Zh",
+                    "mid": mid_c,
