+    return sorted(pairs, key=lambda pair: pair["anchor"])
+
+
+def _plan_pair(pair: dict, shape: tuple[int, int], walls: set[Coord], all_endpoints: dict[Coord, int]) -> dict:
+    start, end = pair["endpoints"]
