+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        add_third = bool(np.random.randint(2))
+        mode = str(np.random.choice(np.array(["ll_diff", "ll_equal", "lz_diff"], dtype=object)))
