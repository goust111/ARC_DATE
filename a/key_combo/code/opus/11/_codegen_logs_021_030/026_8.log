+    candidates: list[dict] = []
+    rows, cols = shape
+    for mid_c in range(cols):
+        if mid_c in (start[1], end[1]):
+            continue
+        candidate = _z_path(start, end, "h", mid_c)
+        if _path_clear(candidate, blocked, shape, endpoints):
