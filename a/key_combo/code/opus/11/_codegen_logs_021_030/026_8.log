+def _l_path(start: Coord, end: Coord, first_axis: str) -> list[Coord]:
+    r0, c0 = start
+    r1, c1 = end
+    if first_axis == "h":
+        corner = (r0, c1)
+        return _join_segments([_segment(start, corner), _segment(corner, end)])
+    if first_axis == "v":
