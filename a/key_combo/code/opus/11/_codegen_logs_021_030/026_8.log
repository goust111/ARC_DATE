+    _paint_cells(grid, set(pair_b), int(colors[1]))
+
+    if add_third:
+        pair_c = [(height - 5, width - 5), (height - 2, width - 2)]
+        walls.add((height - 3, width - 5))
+        _paint_cells(grid, set(pair_c), int(colors[2]))
