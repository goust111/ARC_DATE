+    masks: dict[int, set[tuple[int, int]]] = {}
+    all_mandatory = set(mandatory.values())
+    for h in ordered:
+        forbidden = all_mandatory - {mandatory[h]}
+        masks[h] = _random_marker_set(h, width, forbidden, mandatory[h])
