+GRID_ROWS = (18, 24)
+GRID_COLS = (20, 28)
+SOURCE_COUNT_CHOICES = (3, 4)
+WIDTH_CHOICES = (3, 4, 5, 6)
+HEIGHT_CHOICES = (3, 4, 5, 6, 7)
+TARGET_EXTRA_HEIGHT = (0, 2)
