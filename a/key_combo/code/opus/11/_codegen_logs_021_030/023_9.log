+
+def _paint_by_row_overlap(grid: np.ndarray) -> np.ndarray:
+    sources, targets = _extract_objects(grid)
+    out = np.asarray(grid, dtype=int).copy()
+    for target in targets:
+        tr0, tc0, tr1, _tc1 = target["bbox"]
+        matches = [
