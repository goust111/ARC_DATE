+    if np.array_equal(actual, _nearest_source_output(inp)):
+        return False
+
+    if np.array_equal(actual, inp):
+        return False
+
+    for tgt in targets:
+        r0, c0, r1, c1 = tgt["bbox"]
+        if not np.any(actual[r0 : r1 + 1, c0 : c1 + 1] == MARKER):
+            return False
+    return True
