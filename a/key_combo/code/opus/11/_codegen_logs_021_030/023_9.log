+    split = random.randint(7, cols - 10)
+    gap = random.choice((2, 3))
+    left_lo, left_hi = 1, split
+    right_lo, right_hi = split + gap + 1, cols - 2
+    if right_hi - right_lo + 1 < max(t["w"] for t in target_specs):
