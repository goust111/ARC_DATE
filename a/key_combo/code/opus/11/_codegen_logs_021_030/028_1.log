+    bg = get_bg(g)
+    comps = components_mask(g != bg, connectivity=4)
+    assert comps, "expected at least one foreground sprite"
+    objects = []
+    for coords in comps:
+        values = g[coords[:, 0], coords[:, 1]]
+        colors = np.unique(values)
+        assert len(colors) == 1, "each sprite must be monochromatic"
