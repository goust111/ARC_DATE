    motif_h: 1-6, motif_w: 1-6 (one dimension often 1)
    repeats: 4-6 times along bar axis
    colors: 2-3 distinct non-black non-grey colors per motif
  fill_region:
    for_vertical: bar_len rows x motif_w cols, immediately right of bar (all BLACK in input)
    for_horizontal: motif_h rows x bar_len cols, immediately below bar (all BLACK in input)
    must fit within grid bounds
  separation: when 2 bars exist, their fill regions do not overlap
  transform: tile the motif to fill the entire fill_region (repeating along the bar axis)

generation_strategy:
  approach: output-first
  steps:
    1. Choose 1-2 bars; for each pick orientation, position, and length (4-8, must leave room for motif)
    2. Choose motif dimensions such that bar_len % motif_dim_along_bar == 0, giving repeats 4-6
    3. Fill motif cells with 2-3 random non-black non-grey colors (no color 5)
    4. Build output grid with bar + tiled fill region
    5. Derive input by erasing the fill region except the original motif at the bar's end
    6. Verify no overlap between bars/motifs/fills; all structures fit in 10x10
