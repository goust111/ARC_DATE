+        dr, dc = DIR_VECTORS[obj["direction"]]
+        while True:
+            candidate = coords + np.array([[dr, dc]], dtype=int)
+            if (
+                np.any(candidate[:, 0] < 0)
+                or np.any(candidate[:, 0] >= shape[0])
+                or np.any(candidate[:, 1] < 0)
+                or np.any(candidate[:, 1] >= shape[1])
