  39: def main(grid: np.ndarray) -> np.ndarray:
  40:     """
  41:     Decode the colored 3x3 contour motif into a 16x16 periodic lattice with the motif stamped in maroon at the center.
  42: 
  43:     Input structure:
  44:     - The grid is 6x6 with orange background and one non-orange color.
  45:     - The non-orange pixels have a tight 3x3 bbox containing one contour glyph.
  46:     - The glyph is one of the task's period-3 contour forms: plus, H, X, or four corners.
  47: 
  48:     Rule:
  49:     - Decode the 3x3 glyph into the period-3 orange phase tile.
  50:     - Fill a black 16x16 canvas by repeating that orange phase tile.
  51:     - Tile the original 3x3 glyph 2x2 and recolor its true pixels to maroon in the centered 6x6 region.
  52: 
  53:     Key insight:
  54:     - The colored object is not copied at its input location; it is a small contour code whose phase tells where orange appears in the repeated lattice.
  55:     """
  56:     g = np.asarray(grid, dtype=int)
  57:     assert g.shape == (6, 6)
  58: 
  59:     bg = int(get_bg(g))
  60:     assert bg == Color.ORANGE
  61:     assert len(colors_present(g, exclude={bg})) == 1
  62: 
  63:     fg = g != bg
  64:     b = bbox(fg)
  65:     assert b is not None
  66:     motif = crop_bbox(fg, b).astype(bool)
  67:     assert motif.shape == (3, 3)
  68: 
  69:     phase = _decode_phase_tile(motif)
  70:     phase_colors = np.where(phase, bg, Color.BLACK).astype(int)
  71:     out_shape = (3 * g.shape[0] - 2, 3 * g.shape[1] - 2)
  72:     out = tile_fill(out_shape, phase_colors)
  73: 
  74:     center = np.tile(motif, (2, 2))
  75:     r0 = (out.shape[0] - center.shape[0]) // 2
  76:     c0 = (out.shape[1] - center.shape[1]) // 2
  77:     out[r0 : r0 + center.shape[0], c0 : c0 + center.shape[1]][center] = Color.MAROON
  78:     return out
