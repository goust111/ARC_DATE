+        patch = np.zeros((box[2] - box[0] + 1, box[3] - box[1] + 1), dtype=bool)
+        rel = coords - np.array([[box[0], box[1]]], dtype=int)
+        patch[rel[:, 0], rel[:, 1]] = True
+        direction = _decode_direction(patch)
+        objects.append(
