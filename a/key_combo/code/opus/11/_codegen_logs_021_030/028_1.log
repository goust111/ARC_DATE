+        return _render(moved, shape, bg)
+    except AssertionError:
+        return None
+
+
+def _global_direction_result(objects: list[dict], shape: tuple[int, int], bg: int, direction: str) -> np.ndarray:
+    alt = []
+    for obj in objects:
+        alt.append(
+            {
+                "color": obj["color"],
+                "coords": np.asarray(obj["coords"], dtype=int).copy(),
+                "direction": direction,
+                "steps": 0,
+                "stop_reason": None,
+            }
+        )
