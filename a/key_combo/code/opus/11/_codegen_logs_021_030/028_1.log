+    shifts = list(chain_shifts)
+    for spec in specs[chain_len:]:
+        max_shift = _max_reverse_shift(spec["direction"], spec["final_top_left"], shape)
+        if max_shift < 1:
+            return None
+        shifts.append(int(rng.integers(1, min(max_shift, 6) + 1)))
