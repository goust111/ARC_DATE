  44: def main(grid: np.ndarray) -> np.ndarray:
  45:     """
  46:     Slide every foreground object horizontally to the right until it settles against the border or another settled object.
  47: 
  48:     Input structure
  49:     - The grid has a dominant background color and several separate 4-connected foreground objects.
  50:     - Each foreground object is a small multicolor rectangle-like sprite on the same canvas.
  51:     - Objects may overlap in their row ranges, so rightward movement can make a left object stop behind a right object.
  52: 
  53:     Rule
  54:     - Treat each 4-connected foreground object as a rigid sprite.
  55:     - Simultaneously move every sprite one column right whenever its next cells are inside the grid and not blocked by a sprite that cannot move.
  56:     - Repeat the simultaneous move until no sprite can move; preserve each sprite's internal colors and shape.
  57: 
  58:     Key insight
  59:     - The output is the terminal state of eastward gravity on the foreground sprites, not a recoloring or per-row sort.
  60:     """
  61:     g = np.asarray(grid, dtype=int)
  62:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
  63: 
  64:     bg = get_bg(g)
  65:     components = components_mask(g != bg, connectivity=4)
  66:     assert components, "expected at least one foreground object"
  67: 
  68:     objects = []
  69:     for coords in components:
  70:         coords = coords.astype(int)
  71:         values = g[coords[:, 0], coords[:, 1]].astype(int)
  72:         objects.append((coords.copy(), values))
  73: 
  74:     h, w = g.shape
  75:     for _step in range(w):
  76:         occ = _occupancy((h, w), objects)
  77:         movable = _objects_that_can_shift_right(objects, occ)
  78:         if not movable:
  79:             break
  80:         for idx in movable:
  81:             objects[idx][0][:, 1] += 1
  82:     else:
  83:         raise AssertionError("rightward gravity did not settle within the grid width")
  84: 
  85:     out = np.full_like(g, bg)
  86:     for coords, values in objects:
  87:         assert np.all(out[coords[:, 0], coords[:, 1]] == bg), "settled objects must not overlap"
  88:         out[coords[:, 0], coords[:, 1]] = values
  89: 
  90:     return out
