  73:                 else:
  74:                     assert g[r, c] == bg
  75: 
  76:         assert len(missing) in (0, 1)
  77:         assert frame["area"] == border_area - len(missing)
  78: 
  79:         out[r0 + 1 : r1, c0 + 1 : c1] = Color.TEAL
