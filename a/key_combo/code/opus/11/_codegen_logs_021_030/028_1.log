  59:         h = r1 - r0 + 1
  60:         w = c1 - c0 + 1
  61:         assert h >= 3 and w >= 3
  62: 
  63:         coords = frame["coords"]
  64:         assert all(r in (r0, r1) or c in (c0, c1) for r, c in coords)
