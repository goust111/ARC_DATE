+        if order != list(range(len(rows))):
+            return sizes
+
+
+def _tie_sizes(rows: list[int]) -> list[int]:
+    shared = random.choice((6, 7, 8))
+    if len(rows) == 2:
+        return [shared, shared]
+    other = random.choice([value for value in (6, 7, 8) if value != shared])
