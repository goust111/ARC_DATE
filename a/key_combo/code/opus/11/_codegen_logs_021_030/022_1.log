+    found = []
+    for combo in itertools.combinations(fit, hit_count):
+        right_points = [_right_point_from_left(coord) for coord in combo]
+        if not _points_are_spaced(right_points):
+            continue
+        if len({c for _, c in combo}) != len(combo):
