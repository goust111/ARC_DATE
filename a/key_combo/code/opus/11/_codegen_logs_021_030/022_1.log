+def _connected_component(mask: np.ndarray) -> list[tuple[int, int]]:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return []
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen = {start}
+    out = []
+    while q:
+        r, c = q.popleft()
+        out.append((r, c))
+        for dr, dc in ORTHO:
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc]:
+                nxt = (nr, nc)
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
+    return out
