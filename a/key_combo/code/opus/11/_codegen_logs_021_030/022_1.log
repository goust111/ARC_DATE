+    out, stamp_sets = _render_output_from_hits(sprite_coords, hits)
+    return {
+        "grid": g,
+        "bg": bg,
+        "sep": sep,
+        "sprite": sprite_coords,
+        "points": point_cells,
+        "hits": hits,
+        "misses": misses,
+        "output": out,
+        "stamp_sets": stamp_sets,
+    }
