+def _shape_mask(coords: list[tuple[int, int]]) -> np.ndarray:
+    nr = _normalize(coords)
+    _, _, r1, c1 = _bbox(nr)
+    mask = np.zeros((r1 + 1, c1 + 1), dtype=bool)
+    for r, c in nr:
+        mask[r, c] = True
+    return mask
+
+
+def _is_irregular(coords: list[tuple[int, int]]) -> bool:
