+    if mask.shape[0] < 2 or mask.shape[1] < 2:
+        return False
+    if np.array_equal(mask, np.flipud(mask)):
+        return False
+    if np.array_equal(mask, np.fliplr(mask)):
+        return False
+    if np.array_equal(mask, np.flipud(np.fliplr(mask))):
