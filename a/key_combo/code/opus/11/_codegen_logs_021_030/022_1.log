+
+BG = 0
+SPRITE_COLOR = 1
+SEPARATOR_COLOR = 5
+POINT_COLORS = (2, 3, 4, 6)
+GRID_H = 14
+HALF_W = 14
+FULL_W = HALF_W * 2 + 1
+ORTHO = ((1, 0), (-1, 0), (0, 1), (0, -1))
