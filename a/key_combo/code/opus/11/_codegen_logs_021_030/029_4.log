    assert 1 <= len(mapping) <= 2, "expected 1-2 left-edge legend blocks"
    assert not np.any((grid[:, :LEGEND_W] != bg) & ~legend_mask[:, :LEGEND_W]), "left-edge foreground must belong to legends"
