+    return _solve_with_options(g, mapping, legend_mask, dilate_mode="selected")
+
+
+def _intervals_overlap(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    return not (a[1] < b[0] or b[1] < a[0])
+
