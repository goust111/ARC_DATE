+
+BG = 0
+GREY = 5
+MAROON = 9
+UPPER_CODE = GREY
+LOWER_CODE = MAROON
+LEGEND_H = 2
+LEGEND_W = 3
+SOURCE_POOL = (1, 2, 3, 4, 6, 7, 8)
+SIZE_RETRIES = 200
+PLACEMENT_RETRIES = 400
+GENERATION_RETRIES = 500
