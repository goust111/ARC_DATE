+import itertools
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+CORRIDOR = 7
+WALL = 9
+PLACEHOLDER = 5
+PARTICLE_COLORS = (1, 2, 3, 4, 6, 8)
+MAX_ATTEMPTS = 800
+EPS = 1e-9
