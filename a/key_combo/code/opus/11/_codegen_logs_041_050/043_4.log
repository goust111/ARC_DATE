+    base_c_max = w - 2.2 - col_span
+    if base_r_max < min_row + 0.4 or base_c_max < 0.8:
+        return None
+    base_r = rng.uniform(min_row + 0.4, base_r_max)
+    base_c = rng.uniform(0.8, base_c_max)
