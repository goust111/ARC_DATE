import itertools
import math
import random
from collections import deque

import numpy as np


BG = 0
CORRIDOR = 7
WALL = 9
PLACEHOLDER = 5
PARTICLE_COLORS = (1, 2, 3, 4, 6, 8)
MAX_ATTEMPTS = 500
EPS = 1e-9


def _bbox(coords):
    rows = [r for r, _ in coords]
    cols = [c for _, c in coords]
    return min(rows), min(cols), max(rows), max(cols)


def _normalize_point(point, box):
    r, c = point
    r0, c0, r1, c1 = box
    rr = 0.0 if r1 == r0 else (float(r) - float(r0)) / float(r1 - r0)
    cc = 0.0 if c1 == c0 else (float(c) - float(c0)) / float(c1 - c0)
    return rr, cc


def _centroid(coords):
    arr = np.asarray(coords, dtype=float)
    return float(arr[:, 0].mean()), float(arr[:, 1].mean())


def _components_of_color(grid, color):
    h, w = grid.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(grid[r, c]) != int(color):
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            cells = []
            while q:
                rr, cc = q.popleft()
                cells.append((rr, cc))
                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == int(color):
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(sorted(cells))
    return comps


def _assignment_details(src_points, dst_points):
    n = len(src_points)
    best_perm = None
    best_cost = None
    second_cost = None
    second_perm = None
    for perm in itertools.permutations(range(n)):
        cost = 0.0
        for i, j in enumerate(perm):
            sr, sc = src_points[i]
            dr, dc = dst_points[j]
            cost += math.hypot(sr - dr, sc - dc)
        if best_cost is None or cost < best_cost - EPS:
