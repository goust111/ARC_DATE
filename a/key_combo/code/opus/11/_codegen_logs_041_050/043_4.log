+
+
+def _build_particle_rows(h, w, rng, n):
+    top_limit = rng.randint(5, 7)
+    if top_limit + 7 >= h:
+        return None
+    rows = sorted(rng.sample(range(1, top_limit + 1), n))
+    if rows[-1] - rows[0] < 2:
