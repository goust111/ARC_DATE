+BG = 0
+CORRIDOR = 7
+WALL = 9
+PLACEHOLDER = 5
+PARTICLE_COLORS = (1, 2, 3, 4, 6, 8)
+MAX_ATTEMPTS = 500
+EPS = 1e-9
