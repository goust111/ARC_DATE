    return True


def _gen_attempt(rng):
    h = rng.randint(15, 19)
    w = rng.randint(15, 19)
    n = rng.choice((3, 4))
    grid = np.zeros((h, w), dtype=int)

    particles = _build_particle_rows(h, w, rng, n)
    if particles is None:
        return None
    _paint_top(grid, particles)

    temp_info = _analyze(grid if False else grid.copy())
    bottom_min_row = max(p["row"] for p in particles) + rng.randint(3, 4)
    if bottom_min_row > h - 4:
        return None
    placed = _place_placeholders(grid, temp_info["end_points"], bottom_min_row, rng)
    if placed is None:
        return None
    if not _validate_non_degenerate(grid):
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt(rng)
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid particle-endpoint matching sample")

