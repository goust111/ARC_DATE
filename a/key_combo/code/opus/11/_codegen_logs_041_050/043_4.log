+def _rank_offsets(values, scale):
+    order = sorted(range(len(values)), key=lambda i: (values[i], i))
+    base = {
+        3: (-0.8, 0.8, 0.0),
+        4: (-1.0, 0.7, -0.3, 0.9),
+    }[len(values)]
+    offsets = [0.0] * len(values)
+    for pos, idx in enumerate(order):
+        offsets[idx] = base[pos] * scale
+    return offsets
+
