+
+
+SHAPES = _build_shape_variants()
+
+
+def _shift_shape(shape, anchor_r, anchor_c):
+    return [(anchor_r + r, anchor_c + c) for r, c in shape]
+
+
+def _shape_centroid(shape):
+    return _centroid(shape)
+
+
+def _cells_in_bounds(cells, h, w, min_row):
