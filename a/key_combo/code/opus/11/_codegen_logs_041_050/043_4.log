+
+
+def _build_shape_variants():
+    bases = [
+        [(0, 0), (1, 0), (1, 1)],
+        [(0, 0), (1, 0), (2, 0), (2, 1)],
+        [(0, 1), (1, 0), (1, 1), (1, 2)],
+        [(0, 0), (0, 1), (1, 1), (1, 2)],
