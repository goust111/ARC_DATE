+    c_lo, c_hi = 0, W - w
+    need = 1 if canonical else MIN_RAY_LEN
+    if dir_idx == 0:
+        r_lo = need
+    elif dir_idx == 1:
+        c_hi = W - w - need
+    elif dir_idx == 2:
+        r_hi = H - h - need
