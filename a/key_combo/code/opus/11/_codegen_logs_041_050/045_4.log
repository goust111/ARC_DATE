+
+_validate_template_catalog()
+
+
+def _group_size_options(group_count: int) -> list[tuple[int, ...]]:
+    if group_count == 2:
+        return [(2, 4), (3, 3), (3, 4), (4, 4)]
+    return [(2, 2, 2), (2, 2, 3), (2, 2, 4), (2, 3, 3), (2, 3, 4), (3, 3, 3)]
+
+
+def _build_instances(rng: random.Random) -> list[dict]:
