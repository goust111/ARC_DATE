+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+
+# Each template is a grey-body shape around a colored marker at (0, 0).
+# The body centroid is biased toward the key direction.
+SPRITE_TEMPLATES = {
+    "left": [
+        [(-1, -2), (0, -2), (1, -2), (1, -1), (0, -1)],
+        [(-1, -2), (0, -2), (1, -2), (1, -1), (0, -1), (-1, -1)],
+    ],
+    "right": [
+        [(-1, 2), (0, 2), (1, 2), (1, 1), (0, 1)],
+        [(-1, 2), (0, 2), (1, 2), (1, 1), (0, 1), (-1, 1)],
+    ],
+    "up": [
+        [(-2, -1), (-2, 0), (-2, 1), (-1, 1), (-1, 0)],
+        [(-2, -1), (-2, 0), (-2, 1), (-1, 1), (-1, 0), (-1, -1)],
+    ],
+    "down": [
+        [(2, -1), (2, 0), (2, 1), (1, 1), (1, 0)],
+        [(2, -1), (2, 0), (2, 1), (1, 1), (1, 0), (1, -1)],
+    ],
+}
+
+_GEN_COUNTER = 0
+
+
+@dataclass(frozen=True)
+class SpriteInfo:
+    color: int
+    marker: tuple[int, int]
+    grey_coords: tuple[tuple[int, int], ...]
+    body_direction: str
+    stretch_direction: str
+    cells: frozenset[tuple[int, int]]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    return out
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _box_intersects(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> bool:
+    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])
+
