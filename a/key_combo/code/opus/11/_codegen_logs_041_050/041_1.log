+def _inflate_box(box: tuple[int, int, int, int], pad: int, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    return (
+        max(0, box[0] - pad),
+        max(0, box[1] - pad),
+        min(h - 1, box[2] + pad),
+        min(w - 1, box[3] + pad),
+    )
+
+
+def _box_margin(box: tuple[int, int, int, int], shape: tuple[int, int]) -> tuple[int, int, int, int]:
