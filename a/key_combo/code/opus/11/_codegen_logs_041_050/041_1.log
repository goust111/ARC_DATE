                    continue
                nr = r + dr
                nc = c + dc
                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
                    if forbidden is None or (nr, nc) != forbidden:
                        candidates.add((nr, nc))
    return candidates


