+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+GREY = 5
+RECT_COLORS = (1, 2, 3)
+COLOR_DRAW_ORDER = (1, 2, 3)
+CARDINALS = ("up", "down", "left", "right")
+DIR_TO_VEC = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
