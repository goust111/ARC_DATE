        rows.append(r)
        r += h
        if i < len(rects) - 1:
            r += _GEN_MIN_ROW_GAP + int(slots[i + 1])
    return rows


def _gen_place_region_objects(
    out: np.ndarray,
    inp: np.ndarray,
    region: dict[str, int | str],
