+        mask[r, left + shift : right + shift + 1] = True
+    return mask
+
+
+def _recover_base_rectangle(source_mask: np.ndarray) -> tuple[int, int, int, int]:
+    h, w = source_mask.shape
+    base = np.zeros_like(source_mask, dtype=bool)
+    bottom = h - 1
+
