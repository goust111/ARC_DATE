+        cols = np.flatnonzero(source_mask[r])
+        if cols.size == 0:
+            continue
+        shift = _wave_shift(bottom - r)
+        if shift:
+            assert int(cols.min()) >= shift, "shifted rows must be recoverable"
+            cols = cols - shift
+        base[r, cols] = True
+
