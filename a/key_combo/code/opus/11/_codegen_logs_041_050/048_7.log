+        "rejected": rejected,
+        "source_object": source_object,
+        "axis_object": axis_object,
+        "axis_r": axis_r,
+        "axis_c": axis_c,
+    }
+
+
+def _step4_stamp_only(info: dict) -> np.ndarray:
+    g = info["grid"]
+    anchor = info["anchor"]
+    source = info["source_object"]
+    offsets = [(r - anchor[0], c - anchor[1]) for r, c in source["coords"]]
+    out = np.zeros_like(g)
+    for tr, tc in info["targets"]:
