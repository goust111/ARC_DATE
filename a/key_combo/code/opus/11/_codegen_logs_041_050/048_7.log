    active_count = random.choice(_GEN_ACTIVE_MARKER_COUNTS)
    total_min, total_max = _GEN_TOTAL_OBJECTS_RANGE
    per_marker_max = _GEN_OBJECTS_PER_MARKER_RANGE[1]
