+                break
+            other_rejected.append((placed_cells, color))
+            occupied |= placed_cells
+        if failed:
+            continue
+
+        marker_cols = random.sample(range(dims[1]), marker_count)
+        marker_cols.sort()
+        if any(abs(marker_cols[i] - marker_cols[i - 1]) <= 1 for i in range(1, len(marker_cols))):
