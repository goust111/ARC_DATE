+
+BACKGROUND = 0
+ANCHOR_COLOR = 7
+TARGET_COLOR = 9
+PALETTE = [1, 2, 3, 4, 5, 6, 8]
+NEIGHBORS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+NEIGHBORS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+MAX_GEN_ATTEMPTS = 600
