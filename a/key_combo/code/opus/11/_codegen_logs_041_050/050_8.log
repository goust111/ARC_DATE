+from __future__ import annotations
+
+from collections import Counter, defaultdict
+import random
+
+import numpy as np
+
+
+DIR4 = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
+OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
+PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+TEMP_CANVAS = 60
+MAX_GEN_ATTEMPTS = 500
