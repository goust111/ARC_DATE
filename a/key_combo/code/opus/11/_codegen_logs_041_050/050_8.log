+def _extend_toward(
+    out: np.ndarray,
+    start: tuple[int, int],
+    target: tuple[int, int],
+    color: int,
+) -> list[tuple[int, int]]:
+    sr, sc = start
+    tr, tc = target
+    assert sr == tr or sc == tc
+    dr = 0 if sr == tr else (1 if tr > sr else -1)
+    dc = 0 if sc == tc else (1 if tc > sc else -1)
+    added = []
+    r, c = sr, sc
+    while True:
+        nr, nc = r + dr, c + dc
+        if (nr, nc) == (tr, tc):
+            break
+        if not _in_bounds(out.shape, nr, nc) or int(out[nr, nc]) != 0:
+            break
