MIN_RUN_SPAN = 3
MAX_RUN_SPAN = 7
MAX_RUN_SPAN_PERCENT = 88
PERCENT_DENOMINATOR = 100
RED_MARKER_COUNTS = (2, 3, 4)
DIRECTIONS = (-1, 1)
LINE_ORIENTATION_FLAGS = (True, False)

