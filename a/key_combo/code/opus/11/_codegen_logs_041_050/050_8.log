# Canvas and lattice bounds.
GRID_SIZE_BOUNDS = (22, 28)
CELL_SIZE_BOUNDS = (2, 5)
WALL_COUNT_BOUNDS = (4, 8)
TOTAL_CELLS_BOUNDS = (5, 8)
LATTICE_WALL_WIDTH = 1

