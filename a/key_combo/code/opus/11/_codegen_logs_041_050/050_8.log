+        top_tip = meta["tip_a"][0]
+        bottom_tip = meta["tip_b"][0]
+        y = random.randint(top_tip + 2, bottom_tip - 2)
+        k = random.randint(1, count)
+        if direction == "R":
+            spike_col = meta["line_value"] - k
+        else:
