+    if connection is None or not connection["aligned"]:
+        return False
+    if len(connection["added"]) == 0:
+        return False
+    end_a, end_b = connection["endpoints"]
+    total_gap = abs(end_a[0] - end_b[0]) + abs(end_a[1] - end_b[1]) - 1
+    if total_gap < 1:
+        return False
+    if mode == "blocked":
