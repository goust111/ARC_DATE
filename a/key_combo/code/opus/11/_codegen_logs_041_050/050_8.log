+
+    alt = inp.copy()
+    ar, ac = _global_content_cells(pair_cups[0])[0]
+    alt[ar, ac] = 0
+    try:
+        alt_out = main(alt)
+    except Exception:
+        return False
+    if np.array_equal(alt_out, out):
+        return False
+    return True
