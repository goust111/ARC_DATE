+
+
+def _make_decoy(axis: str, pair_cups: list[dict], content_color: int, border_color: int) -> dict:
+    bbox = _pair_bbox(pair_cups)
+    if axis == "H":
+        direction = "D"
+        decoy = _build_cup_patch(direction, border_color, content_color, random.randint(2, 4))
