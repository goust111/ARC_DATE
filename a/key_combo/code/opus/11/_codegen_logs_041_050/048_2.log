+    if must_have_large and not placed_large:
+        return None
+    if not _validate_case(grid, blobs, counts, stop_idx, yellow_row, start_col):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
