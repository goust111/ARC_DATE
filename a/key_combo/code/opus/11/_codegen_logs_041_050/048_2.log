+        r += dr
+        c += dc
+        steps += 1
+        if not _in_bounds((h, w), r, c):
+            return traced, None
+        if max_steps is not None and steps > max_steps:
+            return traced, None
+        if (r, c) in cell_to_blob:
+            return traced, cell_to_blob[(r, c)]
+        traced.append((r, c))
