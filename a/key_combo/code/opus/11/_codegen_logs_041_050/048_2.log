+    cur = first_blob
+    seen: set[int] = set()
+    while cur is not None and cur not in seen:
+        seen.add(cur)
+        activated_order.append(cur)
+        info = infos[cur]
+        _, cur = _cast_until_blue(grid, info["port"], info["port_dir"], cell_to_blob, info["gray_count"])
