+        if idx > stop_idx:
+            break
+        for r, c in blob["cells"]:
+            out[r, c] = RED
+        pr, pc = blob["port"]
+        dr, dc = blob["out_dir"]
+        limit = counts[idx]
+        if idx == stop_idx and idx < len(blobs) - 1:
+            for step in range(1, limit + 1):
+                rr = pr + dr * step
+                cc = pc + dc * step
+                if _in_bounds(out.shape, rr, cc) and int(out[rr, cc]) == BG:
+                    out[rr, cc] = RED
+            break
