+    if activated_order != list(range(stop_idx + 1)):
+        return False
+
+    for idx in range(stop_idx):
+        if counts[idx] != blobs[idx]["gap_to_next"]:
+            return False
+    if stop_idx < len(blobs) - 1 and counts[stop_idx] + 1 != blobs[stop_idx]["gap_to_next"]:
