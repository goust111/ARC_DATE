+    expected = _render_expected(grid, blobs, counts, stop_idx, yellow_row, start_col)
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return False
+    if np.array_equal(actual, grid):
+        return False
+    if np.count_nonzero(actual == RED) <= np.count_nonzero(grid == RED):
+        return False
+    return True
+
