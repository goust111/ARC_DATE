+        if idx < stop_idx:
+            counts.append(int(blob["gap_to_next"]))
+            continue
+        if idx == stop_idx:
+            if idx < len(blobs) - 1:
+                counts.append(int(blob["gap_to_next"]) - 1)
+            else:
+                pr, pc = blob["port"]
+                dr, dc = blob["out_dir"]
