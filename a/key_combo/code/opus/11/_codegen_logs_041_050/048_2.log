+                chosen.pop()
+            return None
+
+        return dfs(0, [], set(blocked))
+
+    if require_large:
+        for obj in multis:
+            blocked = set(gray_cells)
+            blocked.update(obj)
+            for r, c in obj:
+                blocked.update(_neighbors4(r, c))
+            singles_chosen = pick_singletons(singles, count - 1, blocked)
+            if singles_chosen is not None:
