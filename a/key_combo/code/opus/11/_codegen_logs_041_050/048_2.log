+    traced, first_blob = _cast_until_blue(grid, (yellow_row, start_col), UP, cell_to_blob, None)
+    if first_blob is None:
+        return False
+    expected_first = next(i for i, blob in enumerate(blobs) if (yellow_row - len(traced), start_col) in blob["cells"])
+    if first_blob != expected_first:
+        return False
