def _validate_case(
    grid: np.ndarray,
    blobs: list[dict],
    counts: list[int],
    stop_idx: int,
    yellow_row: int,
    start_col: int,
) -> bool:
    infos, cell_to_blob, _ = _extract_blob_infos(grid)
    if len(infos) != len(blobs):
        return False
    expected_counts = {frozenset(blob["cells"]): count for blob, count in zip(blobs, counts)}
    expected_ports = {frozenset(blob["cells"]): blob["port"] for blob in blobs}
    for info in infos:
        key = frozenset(info["cells"])
        if key not in expected_counts:
            return False
        if info["gray_count"] != expected_counts[key]:
            return False
        if info["port"] != expected_ports[key]:
            return False

    traced, first_blob = _cast_until_blue(grid, (yellow_row, start_col), UP, cell_to_blob, None)
    if first_blob is None:
        return False
    expected_first = next(i for i, blob in enumerate(blobs) if (yellow_row - len(traced), start_col) in blob["cells"])
    if first_blob != expected_first:
        return False

    activated_order: list[int] = []
    cur = first_blob
    seen: set[int] = set()
    while cur is not None and cur not in seen:
        seen.add(cur)
