+        return None
+
+    stop_idx = random.randrange(num_blobs)
+    counts = _desired_counts(blobs, stop_idx, (h, w))
+    if counts is None:
+        return None
+
+    grid = np.full((h, w), BG, dtype=int)
+    _paint_base(grid, blobs, yellow_row, start_col)
