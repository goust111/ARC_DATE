+    return _expand_lattice(cells, spans, spans, SEPARATOR)
+
+
+def _exemplar_choices() -> list[tuple[int, int]]:
+    interior = [(r, c) for r in range(1, ABSTRACT_SIZE - 1) for c in range(1, ABSTRACT_SIZE - 1)]
