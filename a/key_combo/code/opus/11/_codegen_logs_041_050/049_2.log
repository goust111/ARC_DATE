+    assert 2 <= len(colors) <= 4
+    assert len(set(colors)) == len(colors)
+    return exemplar, template
+
+
+def _shift_right(seq: list[int], amount: int) -> list[int]:
+    if not seq:
+        return []
+    k = amount % len(seq)
+    if k == 0:
+        return list(seq)
+    return list(seq[-k:] + seq[:-k])
