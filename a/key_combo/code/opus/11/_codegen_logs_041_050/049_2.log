+    exemplar, template = _find_exemplar(cells)
+    er, ec = exemplar
+    sequence = [color for _dr, _dc, color in template]
+    h, w = cells.shape
+
+    for r, c in [tuple(map(int, rc)) for rc in np.argwhere(cells == MARKER)]:
