+
+def _stamp_cells(center: tuple[int, int], offsets: list[tuple[int, int, int]], size: int = ABSTRACT_SIZE) -> tuple[set[tuple[int, int]], bool]:
+    r, c = center
+    in_bounds: set[tuple[int, int]] = set()
