+    offsets: list[tuple[int, int, int]],
+    targets: list[tuple[int, int]],
+    size: int = ABSTRACT_SIZE,
+) -> np.ndarray:
+    cells = np.zeros((size, size), dtype=int)
+    centers = [exemplar, *targets]
+    sequence = [color for _dr, _dc, color in offsets]
