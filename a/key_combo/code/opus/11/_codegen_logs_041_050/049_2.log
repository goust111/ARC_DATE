+    groups: list[tuple[int, int]] = []
+    start = prev = indices[0]
+    for idx in indices[1:]:
+        if idx == prev + 1:
+            prev = idx
+        else:
+            groups.append((start, prev))
+            start = prev = idx
+    groups.append((start, prev))
+    return groups
