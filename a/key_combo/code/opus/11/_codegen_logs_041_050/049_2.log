+
+
+def _find_exemplar(cells: np.ndarray) -> tuple[tuple[int, int], list[tuple[int, int, int]]]:
+    markers = [tuple(map(int, rc)) for rc in np.argwhere(cells == MARKER)]
+    assert 4 <= len(markers) <= 5
