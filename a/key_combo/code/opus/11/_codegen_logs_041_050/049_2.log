+    for i, center_a in enumerate(centers):
+        for center_b in centers[i + 1 :]:
+            if _chebyshev(center_a, center_b) <= 1:
+                return False
+    for i, cand_a in enumerate(combo):
+        for cand_b in combo[i + 1 :]:
+            if cand_a["output_occ"] & cand_b["output_occ"]:
