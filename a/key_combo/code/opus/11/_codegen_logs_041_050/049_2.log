+            valid.append([cand["center"] for cand in combo])
+    if not valid:
+        return None
+    return valid[int(RNG.integers(len(valid)))]
+
+
+def _extract_case_facts(cells: np.ndarray) -> dict:
+    exemplar, template = _find_exemplar(cells)
