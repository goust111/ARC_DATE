+        return False
+    if len({cand["distance"] % template_len for cand in combo}) < 2:
+        return False
+    if want_clipping:
+        if not any(cand["clipped"] for cand in combo):
+            return False
+        if len(combo) > 1 and not any(not cand["clipped"] for cand in combo):
+            return False
+    else:
+        if any(cand["clipped"] for cand in combo):
+            return False
