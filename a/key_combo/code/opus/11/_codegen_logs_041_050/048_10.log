+def _paint_grid(h: int, w: int, pieces: list[list[tuple[int, int]]], markers: list[tuple[int, int]], colors: list[int]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for piece in pieces:
+        for r, c in piece:
+            grid[r, c] = PIECE_COLOR
+    for (r, c), color in zip(markers, colors):
+        assert grid[r, c] == BG
+        grid[r, c] = int(color)
+    return grid
