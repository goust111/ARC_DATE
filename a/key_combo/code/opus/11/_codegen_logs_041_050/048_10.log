    sh, sw = socket_shape
    if open_dir in [(-1, 0), (1, 0)]:
        if sw == 2:
            if area == 2:
                return 1, 2
            if area == 4:
                return 2, 2
        if sw == 3 and area == 3:
            return 1, 3
    else:
