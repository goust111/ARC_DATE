    ps=[tuple(row[i] for row in rows) for i in range(4)]
    areas=[sum(p) for p in ps]
    if not all(4<=a<=8 for a in areas):
      continue
    if len(set(ps))<4 or sum(len(set(p))>1 for p in ps)<2:
      continue
    c=combo_count(ps)
