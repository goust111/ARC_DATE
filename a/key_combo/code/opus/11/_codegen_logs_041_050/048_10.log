import random, itertools, numpy as np

def normalize(coords):
    pts=sorted(set((int(r),int(c)) for r,c in coords))
    r0=min(r for r,c in pts); c0=min(c for r,c in pts)
    return tuple(sorted((r-r0,c-c0) for r,c in pts))

def coords_to_mask(coords):
    pts=np.array(coords)
    h=pts[:,0].max()+1; w=pts[:,1].max()+1
    m=np.zeros((h,w),dtype=int)
    for r,c in coords: m[r,c]=1
    return m

def orientations(coords):
    base=coords_to_mask(normalize(coords))
    keys=set(); out=[]
    for flip in [False,True]:
        m=np.fliplr(base) if flip else base
        for k in range(4):
            v=np.rot90(m,k)
            cs=tuple(map(tuple,np.argwhere(v)))
            if cs not in keys:
                keys.add(cs); out.append(cs)
    return out

def prof(coords, axis):
    cs=normalize(coords)
    pts=np.array(cs)
    if axis=='h':
        h=pts[:,0].max()+1; rows=[[] for _ in range(h)]
        for r,c in cs: rows[r].append(c)
        out=[]
        for cols in rows:
            cols=sorted(cols)
            if not cols or cols[0]"'!=0 or cols!=list(range(cols[-1]+1)): return None
            out.append(len(cols))
        return tuple(out)
    w=pts[:,1].max()+1; cols=[[] for _ in range(w)]
    for r,c in cs: cols[c].append(r)
    out=[]
    for rows in cols:
        rows=sorted(rows)
        if not rows or rows[0]!=0 or rows!=list(range(rows[-1]+1)): return None
        out.append(len(rows))
    return tuple(out)

def combo_count(ps):
    pieces=[]
    for p in ps:
        coords=[(r,c) for r,w in enumerate(p) for c in range(w)]
        pieces.append(coords)
    opts=[]
    for p in pieces:
        s=set()
        for o in orientations(p):
            pr=prof(o,'"'h')
            if pr is not None:
                s.add(pr)
        opts.append(s)
    count=0
    for combo in itertools.product(*[sorted(x) for x in opts]):
        if len({len(x) for x in combo})"'!=1: continue
        totals=[sum(v) for v in zip(*combo)]
        if len(set(totals))==1:
            count+=1
    return count

ok=0
for _ in range(500):
    H=random.choice([4,5]); W=random.choice([5,6]); E=W-4
    rows=[]
    for _ in range(H):
      extra=random.sample(range(4),E)
      row=[1]*4
      for i in extra: row[i]+=1
