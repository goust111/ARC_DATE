import random, itertools
import numpy as np

def normalize(coords):
    pts=sorted(set((int(r),int(c)) for r,c in coords))
    r0=min(r for r,c in pts); c0=min(c for r,c in pts)
    return tuple(sorted((r-r0,c-c0) for r,c in pts))

def coords_to_mask(coords):
    pts=np.array(coords)
    h=pts[:,0].max()+1; w=pts[:,1].max()+1
    m=np.zeros((h,w),dtype=int)
    for r,c in coords: m[r,c]=1
    return m

def orientations(coords):
    base=coords_to_mask(normalize(coords))
    seen=[]; keys=set()
    for flip in [False,True]:
        m=np.fliplr(base) if flip else base
        for k in range(4):
            v=np.rot90(m,k)
            cs=tuple(map(tuple,np.argwhere(v)))
            if cs not in keys:
                keys.add(cs); seen.append(cs)
    return seen

def hprof(coords):
    cs=normalize(coords)
    pts=np.array(cs)
    h=pts[:,0].max()+1
    rows=[[] for _ in range(h)]
    for r,c in cs: rows[r].append(c)
    prof=[]
    for cols in rows:
        cols=sorted(cols)
        if not cols or cols[0]"'!=0 or cols!=list(range(cols[-1]+1)):
            return None
        prof.append(len(cols))
    return tuple(prof)

def vprof(coords):
    cs=normalize(coords)
    pts=np.array(cs)
    w=pts[:,1].max()+1
    cols=[[] for _ in range(w)]
    for r,c in cs: cols[c].append(r)
    prof=[]
    for rows in cols:
        rows=sorted(rows)
        if not rows or rows[0]!=0 or rows!=list(range(rows[-1]+1)):
            return None
        prof.append(len(rows))
    return tuple(prof)

def combos(pieces, axis):
    opts=[]
    for p in pieces:
        s=set()
        for o in orientations(p):
            pr=hprof(o) if axis=='"'h' else vprof(o)
            if pr is not None:
                s.add(pr)
        opts.append(sorted(s))
    val=[]
    for combo in itertools.product(*opts):
        lens={len(x) for x in combo}
        if len(lens)"'!=1: continue
        totals=[sum(v) for v in zip(*combo)]
        if len(set(totals))!=1: continue
        val.append(combo)
    return val

def make_profiles():
  for _ in range(10000):
    H=random.choice([4,5]); W=random.choice([5,6]); E=W-4
    rows=[]
    for _ in range(H):
      extra=random.sample(range(4),E)
      row=[1]*4
      for i in extra: row[i]+=1
      rows.append(tuple(row))
    ps=[tuple(row[i] for row in rows) for i in range(4)]
    areas=[sum(p) for p in ps]
    if not all(4<=a<=8 for a in areas):
      continue
    if len(set(ps))<4 or sum(len(set(p))>1 for p in ps)<2:
      continue
    if any(ps[i]==ps[j][::-1] for i in range(4) for j in range(i+1,4)):
      continue
    return ps
for _ in range(20):
  ps=make_profiles()
  pieces=[]
  for p in ps:
    coords=[(r,c) for r,w in enumerate(p) for c in range(w)]
    pieces.append(coords)
  c=combos(pieces,'"'h')
  print(ps,len(c),c[:3])
