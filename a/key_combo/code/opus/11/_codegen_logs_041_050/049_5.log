+    for color in parsed["marker_colors"]:
+        if color in parsed["left_colors"]:
+            blocks.append(tile)
+        else:
+            assert color in parsed["right_colors"], "marker color must be encoded by the legend"
+            blocks.append(mirrored)
+
+    return np.concatenate(blocks, axis=1)
