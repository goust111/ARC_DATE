+    for _ in range(100):
+        bits = [random.randint(0, 1) for _ in range(n)]
+        if len(set(bits)) != 2:
+            continue
+        if not any(bits[i] == bits[i + 1] for i in range(n - 1)):
+            continue
+        if not any(bits[i] != bits[i + 1] for i in range(n - 1)):
+            continue
+        return bits
+    raise RuntimeError("failed to sample a non-trivial orientation sequence")
+
+
