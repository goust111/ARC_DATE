+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+TILE_SIZE = 4
+COLOR_POOL = tuple(range(1, 10))
+MAX_GENERATION_ATTEMPTS = 400
+
+
+def _get_bg(grid: np.ndarray) -> int:
