+def _find_components(grid: np.ndarray, allowed_colors):
+    allowed = set(int(c) for c in allowed_colors)
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if seen[r, c] or color not in allowed:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords = []
