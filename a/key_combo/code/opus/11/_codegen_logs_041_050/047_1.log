+        return False
+
+    intervals = []
+    strip_union = np.zeros_like(grid, dtype=bool)
+    for sprite in sprites:
+        r0, c0, r1, c1 = sprite["bbox"]
+        if not (3 <= r0 <= 12):
+            return False
+        if not (3 <= sprite["area"] <= 6):
+            return False
