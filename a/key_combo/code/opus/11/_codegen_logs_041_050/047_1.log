+        intervals.append((c0, c1))
+
+        strip_union[1 : r1 + 1, c0 : c1 + 1] = True
+        eaten = int(np.count_nonzero(g[1 : r1 + 1, c0 : c1 + 1] == YELLOW))
+        final_color = _count_to_color(eaten)
+        dr = 1 - r0
