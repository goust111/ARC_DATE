+            return False
+    yellow_set = set(yellow_cells)
+    for r, c in yellow_cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in yellow_set:
+                return False
+
+    for sprite in sprites:
+        r0, c0, _r1, c1 = sprite["bbox"]
+        if not np.any(grid[1:r0, c0 : c1 + 1] == YELLOW):
+            return False
