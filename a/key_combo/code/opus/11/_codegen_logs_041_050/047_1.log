+                "color": int(comp["color"]),
+                "coords": comp["coords"],
+                "bbox": comp["bbox"],
+                "local": local,
+                "height": r1 - r0 + 1,
+                "width": c1 - c0 + 1,
+                "area": len(comp["coords"]),
+            }
