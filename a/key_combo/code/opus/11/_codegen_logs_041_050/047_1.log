+
+
+def _build_attempt():
+    h = random.randint(14, 18)
+    w = random.randint(15, 20)
+    n_sprites = random.randint(3, 5)
+    counts = _sample_counts(n_sprites)
+    special_options = [idx for idx, count in enumerate(counts) if count >= 2]
