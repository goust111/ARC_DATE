spec:
  grid: 15-19 rows x 15-19 cols
  background: 0
  wall:
    position: one full edge (top/bottom/left/right), spanning entire edge
    color: 5 [observed]
  segments:
    count: 3-4
    shape: 1-cell-thick bars parallel to the wall edge, length 2-9
    colors: distinct per segment, not bg or wall_color
    distance_to_wall: all distinct, range 2-14, min distance >= 2, gaps >= 2
    length_ordering: nearer segments <= farther segments [observed]
    overlap: >= 1 pair of segments has overlapping span along the wall axis
    placement: segments may touch side edges but never touch wall or opposite edge
  no_equal_distance_conflict: if two segments share a distance, their projection strips must not overlap (in practice all distances are distinct)

generation_strategy:
  approach: output-first
  steps:
    - Pick grid size H x W in [15,19]. Pick wall edge (top/bottom/left/right).
    - Pick N segments (3-4). For each, choose a distinct color (not 0 or wall_color).
    - Assign distinct distances from wall, sorted ascending, each >= 2, with gaps >= 2.
    - Assign segment lengths increasing with distance (nearer <= farther), range [2, min(grid_parallel_dim-2, 9)].
    - Place segments along the wall axis ensuring >= 1 overlapping pair (span overlap along wall).
    - Build output by painting projection strips from farthest to nearest (farther first, nearer overwrites).
    - Derive input by erasing all projection fill, keeping only original 1-cell segments and wall bar.
