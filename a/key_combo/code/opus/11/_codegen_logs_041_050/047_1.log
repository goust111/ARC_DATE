+        r0, c0, r1, c1 = before["bbox"]
+        count = int(np.count_nonzero(grid[1 : r1 + 1, c0 : c1 + 1] == YELLOW))
+        if after["color"] != _count_to_color(count):
+            return False
+        if before["color"] != after["color"]:
