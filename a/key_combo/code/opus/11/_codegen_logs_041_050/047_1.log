+    if not color_changed:
+        return False
+    if not has_bbox_only_marker:
+        return False
+    if not has_interior_consumed_marker:
+        return False
+
+    preserved = (grid == YELLOW) & (~strip_union)
+    if int(np.count_nonzero(preserved)) != remaining_yellow:
+        return False
+
+    return True
