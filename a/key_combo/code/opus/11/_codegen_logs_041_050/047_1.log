+    total_consumed = sum(sprite["target_count"] for sprite in sprites)
+    extra_min = max(1, 8 - total_consumed)
+    extra_max = min(3, 15 - total_consumed)
+    if extra_min > extra_max:
+        return None
+    extra_needed = random.randint(extra_min, extra_max)
