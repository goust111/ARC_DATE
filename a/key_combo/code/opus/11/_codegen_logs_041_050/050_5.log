+def _relative_to_centroid(coords: Iterable[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    pts = list(coords)
+    cr, cc = _centroid_floor(pts)
+    return frozenset((r - cr, c - cc) for r, c in pts)
+
