+                "coords_set": frozenset(odd_coords),
+                "rel": _relative_to_centroid(odd_coords),
+                "centroid": _centroid_floor(odd_coords),
+            }
+        )
+        majority_shapes.append(
+            {
+                "coords_set": frozenset(maj_coords),
+                "rel": _relative_to_centroid(maj_coords),
+            }
+        )
