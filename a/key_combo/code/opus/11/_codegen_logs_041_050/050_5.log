+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _is_connected(coords: Iterable[tuple[int, int]]) -> bool:
+    pts = set(coords)
+    if not pts:
+        return False
+    stack = [next(iter(pts))]
+    seen = {stack[0]}
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in pts and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
