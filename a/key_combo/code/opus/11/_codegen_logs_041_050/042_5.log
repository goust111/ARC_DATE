+            cc = rng.randint(1, w - length - 1)
+            cells = [(rr, cc + delta) for delta in range(length)]
+        else:
+            rr = rng.randint(1, h - length - 1)
+            cc = rng.randint(1, w - 2)
+            cells = [(rr + delta, cc) for delta in range(length)]
