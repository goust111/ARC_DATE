+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(21, 26)
+    w = rng.randint(21, 26)
+    count = 4 if rng.random() < 0.45 else 3
+    chosen_slots = rng.sample(SLOTS, count)
+    chosen_sizes = rng.sample((2, 3, 4, 5), count)
