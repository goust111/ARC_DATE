+    r0, c0, r1, c1 = r - 1, c - 1, r + side, c + side
+    gaps: list[tuple[int, int]] = []
+    for rr, cc in _border_cells(r0, c0, r1, c1):
+        value = int(grid[rr, cc])
+        if value == BLACK:
+            gaps.append((rr, cc))
+        elif value != GREY:
+            return None
+    if len(gaps) != 1:
