+def _candidate_from_window(grid: np.ndarray, r: int, c: int, side: int) -> Pocket | None:
+    h, w = grid.shape
+    if r <= 0 or c <= 0 or r + side >= h or c + side >= w:
+        return None
+    if not np.all(grid[r : r + side, c : c + side] == BLACK):
+        return None
