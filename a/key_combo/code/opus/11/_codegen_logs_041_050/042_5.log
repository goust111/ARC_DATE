+from dataclasses import dataclass
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+RANK_COLORS = (BLUE, RED, GREEN, YELLOW)
+
+DIRECTIONS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+INWARD = {
+    "tl": ("down", "right"),
+    "tr": ("down", "left"),
+    "bl": ("up", "right"),
+    "br": ("up", "left"),
+}
+OUTWARD = {
+    "tl": ("up", "left"),
+    "tr": ("up", "right"),
+    "bl": ("down", "left"),
+    "br": ("down", "right"),
+}
+SLOTS = ("tl", "tr", "bl", "br")
+
+GEN_ATTEMPTS = 600
+ASSIGNMENT_ATTEMPTS = 240
+PLACEMENT_ATTEMPTS = 80
+LINE_ATTEMPTS = 40
+
+
+@dataclass(frozen=True)
+class Pocket:
+    r: int
+    c: int
+    side: int
