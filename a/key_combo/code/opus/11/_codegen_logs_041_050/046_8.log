+        covering = [
+            group
+            for group in merged_groups
+            if group["diag_range"][0] <= diag_sum <= group["diag_range"][1]
+        ]
+        if len({group["authority"] for group in covering}) != 1:
+            return False
+        if next(iter({group["authority"] for group in covering})) != diag_colors[diag_sum]:
+            return False
