+import numpy as np
+
+
+PALETTE = (1, 2, 3, 4)
+GREY = 5
+N4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+MAX_GENERATION_ATTEMPTS = 800
+_FRAGMENT_CACHE: dict[tuple[int, int], list[dict]] = {}
+_CANDIDATE_CACHE: dict[tuple[int, int, int], tuple[list[dict], list[dict]]] = {}
