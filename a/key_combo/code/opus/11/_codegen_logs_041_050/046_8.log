+                        "coords": coord_list,
+                        "fragments": list(combo),
+                        "bbox": bbox,
+                        "diag_range": diag_range,
+                        "authority": authority,
+                        "authority_counts": counts,
+                        "allowed_ds": allowed_ds,
+                        "side": side,
+                    }
