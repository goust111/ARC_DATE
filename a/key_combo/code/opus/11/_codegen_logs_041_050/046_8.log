+            inp[r, c] = alt if idx in pick else correct
+        alt_colors[diag_sum] = alt
+    return alt_colors
+
+
+def _validate_instance(inp: np.ndarray, solution: np.ndarray, conflict_to_group: dict[int, int], raw_groups: list[dict]) -> bool:
