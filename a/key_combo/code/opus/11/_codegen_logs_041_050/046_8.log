+    out = g.copy()
+    for diag_sum, color in diag_colors.items():
+        coords = _diagonal_cells(g.shape, diag_sum)
+        if any(int(g[r, c]) == GREY for r, c in coords) or len({int(g[r, c]) for r, c in coords if int(g[r, c]) != GREY}) > 1:
