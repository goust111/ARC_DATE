+    values = [int(grid[r, c]) for r, c in coords]
+    non_grey = [v for v in values if v != GREY]
+    counts = Counter(non_grey)
+    resolved = None
+    if counts:
+        items = counts.most_common()
+        if len(items) == 1 or items[0][1] > items[1][1]:
+            resolved = int(items[0][0])
