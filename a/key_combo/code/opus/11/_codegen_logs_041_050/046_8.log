+    diag_colors: dict[int, int] = {}
+    unresolved: list[int] = []
+    for diag_sum in range(g.shape[0] + g.shape[1] - 1):
+        info = _diagonal_info(g, diag_sum)
+        if info["resolved_visible"] is not None:
+            diag_colors[diag_sum] = info["resolved_visible"]
