+def _iter_combinations(items: list[dict], count: int):
+    n = len(items)
+    if count == 2:
+        for i in range(n):
+            for j in range(i + 1, n):
+                yield (items[i], items[j])
+    elif count == 3:
+        for i in range(n):
+            for j in range(i + 1, n):
+                for k in range(j + 1, n):
+                    yield (items[i], items[j], items[k])
+
