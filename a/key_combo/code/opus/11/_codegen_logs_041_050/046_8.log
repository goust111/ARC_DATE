+
+def _build_attempt() -> np.ndarray | None:
+    h = random.randint(13, 16)
+    w = random.randint(13, 16)
+    phase = random.randint(0, 3)
+    solution = np.fromfunction(lambda r, c: ((r + c + phase) % 4) + 1, (h, w), dtype=int)
