+    else:
+        sizes = [random.choice(SMALL_INTERIORS), random.choice(WIDE_INTERIORS), random.choice(TALL_INTERIORS)]
+    if topology == "double":
+        sizes.sort(key=lambda size: size[0] * size[1], reverse=True)
+    else:
