+    r0, c0, r1, c1 = box
+    return r0 - 1, c0 - 1, r1 + 1, c1 + 1
+
+
+def _corners(rect: tuple[int, int, int, int]) -> frozenset[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    return frozenset(((r0, c0), (r0, c1), (r1, c0), (r1, c1)))
+
+
+def _box_area(box: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = box
+    return (r1 - r0 + 1) * (c1 - c0 + 1)
