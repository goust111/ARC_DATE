+        c0 = rc1 - ow + 1
+        r0 = r1 - h + 1
+        c1 = c0 + w - 1
+    elif mode == "sw":
+        r0 = rr1 - oh + 1
+        c1 = rc0 + ow - 1
+        r1 = r0 + h - 1
+        c0 = c1 - w + 1
+    else:
