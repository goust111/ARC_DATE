+    pair_overlaps = [_box_overlap_area(boxes[i], boxes[j]) for i, j in ((0, 1), (0, 2), (1, 2))]
+    if not any(area in (2, 3, 4, 6) for area in pair_overlaps):
+        return False
+
+    if set(winners) != set(WINNER_COLORS):
+        return False
+    return True
+
