+GRID_CHOICES = (15, 17, 19)
+SMALL_INTERIORS = ((2, 2), (2, 3), (3, 2))
+WIDE_INTERIORS = ((3, 4), (2, 4), (3, 5))
+TALL_INTERIORS = ((4, 3), (4, 2), (5, 3))
