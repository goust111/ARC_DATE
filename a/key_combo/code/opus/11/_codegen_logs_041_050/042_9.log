+    candidates = _candidate_rectangles(grid)
+    by_corner: dict[tuple[int, int], list[int]] = {corner: [] for corner in yellows}
+    for idx, (_rect, corners) in enumerate(candidates):
+        for corner in corners:
+            by_corner[corner].append(idx)
