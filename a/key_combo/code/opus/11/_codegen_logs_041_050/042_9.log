+def _random_box(shape: tuple[int, int], size: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = size
+    max_r0 = shape[0] - h - 1
+    max_c0 = shape[1] - w - 1
+    r0 = random.randint(1, max_r0)
+    c0 = random.randint(1, max_c0)
+    return (r0, c0, r0 + h - 1, c0 + w - 1)
