+    for _ in range(120):
+        boxes: list[tuple[int, int, int, int]] = []
+        if topology == "double":
+            boxes.append(_central_box(shape, sizes[0]))
+            mode_pairs = [("nw", "se"), ("ne", "sw"), ("nw", "ne"), ("sw", "se"), ("nw", "sw"), ("ne", "se")]
