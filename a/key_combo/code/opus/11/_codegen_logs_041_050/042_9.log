spec:
  summary: |
    Input has n colored objects on a black grid, with a legend (one singleton pixel per color)
    in the rightmost column at rows 0..n-1. Output is an n x n pairwise relation table:
    2x2 color labels on top/left edges, RED (2) for same dihedral shape, GREY (5) otherwise,
    diagonal blank, all separated by 1-cell bg gaps. Output size = (3n+2) x (3n+2).
  grid: 20-25 rows x 20-23 cols, large enough for n non-overlapping objects + legend column
  background: 0 (black)
  n: 4-7 foreground colors
  legend:
    position: rightmost column, rows 0 through n-1, one singleton pixel per color
    colors: each unique, never RED (2) or GREY (5)
    ordering: determines row/column order in output table
  objects:
    count: exactly n, one per legend color
    shape: 4-connected monochromatic, area 5-13, bbox 2-7 rows x 2-7 cols
    no_enclosed_holes: true
    placement: non-overlapping, min Manhattan gap >= 3, all within cols 0..W-2 (avoid legend col)
    each_color_appears_twice: once as main object (area > 1), once as legend singleton
  equivalence_classes:
