+
+
+def _render_with_order(
+    shape: tuple[int, int],
+    rects: list[tuple[int, int, int, int]],
+    fill_colors: dict[tuple[int, int, int, int], int],
+    order: list[tuple[int, int, int, int]],
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    for rect in rects:
+        for r, c in _corners(rect):
+            out[r, c] = YELLOW
