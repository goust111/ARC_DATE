+        random.shuffle(dist_candidates)
+        chosen = sorted(dist_candidates[:n_squares])
+        r0s = chosen if positive else list(reversed(chosen))
+        for _ in range(300):
+            cols = random.sample(range(RIGHT_MIN_COL, w - SQUARE + 1), n_squares)
