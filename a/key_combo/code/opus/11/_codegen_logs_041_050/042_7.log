+            cols = random.sample(range(RIGHT_MIN_COL, w - SQUARE + 1), n_squares)
+            placed: list[tuple[int, int]] = []
+            ok = True
+            result: list[tuple[int, int]] = []
+            for r0, c0 in zip(r0s, cols):
