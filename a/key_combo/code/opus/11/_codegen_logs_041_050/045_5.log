+def _sample_band_sizes(rng: random.Random) -> tuple[int, int, int]:
+    outer_min, outer_max = OUTER_BAND_RANGE
+    center_min, center_max = CENTER_BAND_RANGE
+    center = 3 if rng.random() < 0.35 else rng.randint(center_min, center_max)
+    return (
