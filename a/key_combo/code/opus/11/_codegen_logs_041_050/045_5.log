+
+def _random_counts(rng: random.Random) -> list[int]:
+    while True:
+        counts = rng.sample(COUNT_POOL, 8)
+        ordered = sorted(counts)
+        if ordered == list(range(1, 9)):
+            continue
+        if any(value != rank + 1 for rank, value in enumerate(ordered)):
+            return counts
