+    ("TL", (0, 0)),
+    ("TC", (0, 1)),
+    ("TR", (0, 2)),
+    ("ML", (1, 0)),
+    ("MR", (1, 2)),
+    ("BL", (2, 0)),
+    ("BC", (2, 1)),
