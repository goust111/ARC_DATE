+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    row_sizes = _sample_band_sizes(rng)
+    col_sizes = _sample_band_sizes(rng)
+    h = sum(row_sizes) + 2
+    w = sum(col_sizes) + 2
