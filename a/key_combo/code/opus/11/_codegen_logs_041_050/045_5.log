+    inward_horizontal = right if ci == 0 else left if ci == 2 else 0
+    outward_vertical = top if ri == 0 else bottom if ri == 2 else max(top, bottom)
+    outward_horizontal = left if ci == 0 else right if ci == 2 else max(left, right)
+    diag_a = -(abs(r - c))
