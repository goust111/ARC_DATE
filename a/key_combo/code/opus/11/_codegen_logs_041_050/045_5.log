+    ranks = {name: rank + 1 for rank, (name, _count) in enumerate(sorted(planted_counts.items(), key=lambda item: item[1]))}
+    if not any(planted_counts[name] != ranks[name] for name in planted_counts):
+        return False
+
+    return True
+
