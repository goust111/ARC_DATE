+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        if int(grid[rr, cc]) == BG or int(out[rr, cc]) == RAY:
+            out[rr, cc] = COLLISION
+    return out
+
+
