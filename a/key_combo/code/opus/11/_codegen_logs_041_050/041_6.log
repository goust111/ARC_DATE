+        if idx == template_idx:
+            mr, mc = motif["marker_abs"]
+            assert int(grid[mr, mc]) == BG
+            grid[mr, mc] = MARKER
+
+    try:
+        _validate_instance(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
