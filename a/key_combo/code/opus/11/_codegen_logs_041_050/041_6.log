+        rr = int(r)
+        cc = int(c)
+        if int(grid[rr, cc]) == BG or int(out[rr, cc]) == RAY:
+            out[rr, cc] = COLLISION
+    return out
+
+
+def _render_from_mask(
+    grid: np.ndarray,
+    ray_cells_list: list[tuple[tuple[int, int], ...]],
+    mask: np.ndarray,
+) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    for ray_cells in ray_cells_list:
+        for r, c in ray_cells:
