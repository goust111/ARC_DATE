+    points = set(shape) | {tuple(point)}
+    rotated = set(points)
+    for _ in range(turns % 4):
+        rotated = _rotate_once(rotated)
+    shape_rot = rotated - {tuple(point)} if tuple(point) not in rotated else set(rotated)
+    point_rot = None
+    if tuple(point) in rotated:
+        shape_rot.remove(tuple(point))
+        point_rot = tuple(point)
+    else:
