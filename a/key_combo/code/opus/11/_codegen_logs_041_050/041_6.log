+def _normalize(cells: set[tuple[int, int]]) -> frozenset[tuple[int, int]]:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return frozenset((r - r0, c - c0) for r, c in cells)
+
+
+def _rotate_once(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    return {(c, -r) for r, c in cells}
+
+
+def _rotate_shape_and_point(
+    shape: frozenset[tuple[int, int]],
+    point: tuple[int, int],
+    turns: int,
+) -> tuple[frozenset[tuple[int, int]], tuple[int, int]]:
+    points = set(shape) | {tuple(point)}
+    rotated = set(points)
+    for _ in range(turns % 4):
+        rotated = _rotate_once(rotated)
+    shape_rot = rotated - {tuple(point)} if tuple(point) not in rotated else set(rotated)
+    point_rot = None
+    if tuple(point) in rotated:
+        shape_rot.remove(tuple(point))
+        point_rot = tuple(point)
+    else:
+        rotated_list = list(rotated)
+        raise AssertionError(f"rotated point missing: {rotated_list}")
