   172	    assert bg == BG
   173	
   174	    comps = find_components(g, bg=bg, connectivity=8, monochromatic=False)
   175	    assert 4 <= len(comps) <= 5, "expected one template and 3-4 copies"
   176	
   177	    template_ids = [
   178	        idx
   179	        for idx, comp in enumerate(comps)
   180	        if any(int(g[int(r), int(c)]) == MARKER for r, c in comp["coords"])
   181	    ]
   182	    assert len(template_ids) == 1, "expected exactly one template"
   183	    template_id = template_ids[0]
   184	
   185	    template = comps[template_id]
   186	    template_skeleton_abs = {
   187	        (int(r), int(c))
   188	        for r, c in template["coords"]
   189	        if int(g[int(r), int(c)]) == SKELETON
   190	    }
   191	    template_marker_abs = [
   192	        (int(r), int(c))
   193	        for r, c in template["coords"]
   194	        if int(g[int(r), int(c)]) == MARKER
   195	    ]
   196	    assert len(template_marker_abs) == 1
   197	    template_marker_abs = template_marker_abs[0]
   198	
   199	    for r, c in template_skeleton_abs:
   200	        assert any((nr, nc) == template_marker_abs for nr, nc in neighbors8(r, c)) or any(
   201	            (nr, nc) in template_skeleton_abs for nr, nc in neighbors4(r, c)
   202	        )
   203	
   204	    tr0 = min(r for r, _ in template_skeleton_abs)
   205	    tc0 = min(c for _, c in template_skeleton_abs)
   206	    template_shape = frozenset((r - tr0, c - tc0) for r, c in template_skeleton_abs)
   207	    template_marker = (template_marker_abs[0] - tr0, template_marker_abs[1] - tc0)
   208	    variants = []
   209	    seen_shapes = set()
   210	    for turns, (shape_rot, marker_rot) in enumerate(_shape_with_point_rotations(template_shape, template_marker)):
   211	        assert marker_rot not in shape_rot
   212	        direction = _direction_from_centroid(shape_rot, marker_rot)
   213	        seen_shapes.add(shape_rot)
   214	        variants.append(
   215	            {
   216	                "turns": turns,
   217	                "shape": shape_rot,
   218	                "marker": marker_rot,
   219	                "direction": direction,
   220	                "extents": _full_extents(shape_rot, marker_rot),
   221	            }
   222	        )
   223	    assert len(seen_shapes) == 4, "template skeleton must have four distinct rotations"
   224	
   225	    motifs = []
   226	    ray_cells_list: list[tuple[tuple[int, int], ...]] = []
   227	    copy_rotations = []
   228	    all_virtual_markers = set()
   229	
   230	    for idx, comp in enumerate(comps):
   231	        skeleton_abs = {
   232	            (int(r), int(c))
   233	            for r, c in comp["coords"]
   234	            if int(g[int(r), int(c)]) == SKELETON
   235	        }
   236	        assert len(skeleton_abs) == len(template_skeleton_abs), "all skeletons must share one shape"
   237	        r0 = min(r for r, _ in skeleton_abs)
   238	        c0 = min(c for _, c in skeleton_abs)
   239	        shape_norm = frozenset((r - r0, c - c0) for r, c in skeleton_abs)
   240	        matches = [variant for variant in variants if variant["shape"] == shape_norm]
   241	        assert len(matches) == 1, "each copy must have a unique rotation match"
   242	        variant = matches[0]
   243	
   244	        marker_abs = (r0 + variant["marker"][0], c0 + variant["marker"][1])
   245	        direction = variant["direction"]
   246	        if idx == template_id:
   247	            assert marker_abs == template_marker_abs
   248	            copy_kind = "template"
   249	        else:
   250	            assert int(g[marker_abs]) == BG, "copy virtual marker must stay empty in the input"
   251	            copy_kind = "copy"
   252	            copy_rotations.append(int(variant["turns"]))
   253	            all_virtual_markers.add(marker_abs)
   254	
   255	        cells: list[tuple[int, int]] = []
   256	        rr, cc = marker_abs
   257	        first = True
   258	        while in_bounds(g.shape, rr, cc):
   259	            val = int(g[rr, cc])
   260	            if val == BG:
   260	            if val == BG:
   261	                cells.append((rr, cc))
   262	            else:
   263	                assert first and val == MARKER, "only the template marker may occupy a ray start"
   264	            rr += direction[0]
   265	            cc += direction[1]
   266	            first = False
   267	        assert cells, "every ray must paint at least one background cell"
   268	
   269	        ray_tuple = tuple(cells)
   270	        motifs.append(
   271	            {
   272	                "kind": copy_kind,
   273	                "turns": int(variant["turns"]),
   274	                "direction": direction,
   275	                "marker_abs": marker_abs,
   276	                "ray_cells": ray_tuple,
   277	                "skeleton_abs": skeleton_abs,
   278	            }
   279	        )
   280	        ray_cells_list.append(ray_tuple)
   281	
   282	    out = _render_from_rays(g, ray_cells_list)
   283	    cover = np.zeros(g.shape, dtype=int)
   284	    exact_overlap = np.zeros(g.shape, dtype=int)
   285	    for ray_cells in ray_cells_list:
   286	        for r, c in ray_cells:
   287	            exact_overlap[r, c] += 1
   288	        for r, c in _dilate8(ray_cells, g.shape):
   289	            cover[r, c] += 1
   290	
   291	    return {
   292	        "output": out,
   293	        "motifs": motifs,
   294	        "ray_cells": ray_cells_list,
   295	        "collision_mask": cover >= 2,
   296	        "exact_overlap_mask": exact_overlap >= 2,
   297	        "copy_rotations": tuple(copy_rotations),
   298	        "template_id": template_id,
   299	        "virtual_markers": frozenset(all_virtual_markers),
   300	    }
   301	
   302	
   303	def main(grid: np.ndarray) -> np.ndarray:
   304	    """Recover each copy's missing marker by rotation-aligning its grey skeleton to the red-marked template, then cast rays and paint their collision halos.
   305	
   306	    Input structure:
   307	    - The background is black.
   308	    - One 8-connected template sprite contains a grey skeleton plus one red marker pixel that is 8-neighbor-adjacent to the skeleton.
   309	    - Three or four other 8-connected sprites contain only the same grey skeleton, each rotated by 0/90/180/270 degrees.
   310	
   311	    Rule:
   312	    - Identify the template as the only component containing the red marker.
   313	    - For every grey-only copy, find the unique rotation that makes the template skeleton coincide with that copy's skeleton, and transfer the template marker to the correspondingly rotated empty position.
   314	    - Convert each real or virtual marker into a cardinal ray direction by comparing the marker position to its skeleton centroid and taking the nearest axis.
   315	    - Paint yellow along every ray from the marker position to the grid edge, skipping already non-black start cells, then 8-dilate each yellow ray by one pixel and recolor every background-or-yellow cell covered by at least two dilated rays to cyan.
   316	
   317	    Key insight:
   318	    - The copies do not show their markers explicitly, so the ray starts and directions are hidden in the skeleton rotation; the cyan result appears only after all inferred rays are dilated and intersected.
   319	    """
   320	    return _solve_details(np.asarray(grid, dtype=int))["output"]
   321	
   322	
   323	def _random_skeleton(rng: random.Random) -> frozenset[tuple[int, int]] | None:
   324	    size = rng.randint(*SKELETON_SIZE_RANGE)
   325	    cells = {(0, 0)}
   326	    while len(cells) < size:
   327	        frontier = set()
   328	        for r, c in cells:
   329	            for nr, nc in neighbors4(r, c):
   330	                if (nr, nc) not in cells:
   331	                    frontier.add((nr, nc))
   332	        if not frontier:
   333	            return None
   334	        cells.add(rng.choice(tuple(frontier)))
   335	    shape = _normalize(cells)
   336	    rows = [r for r, _ in shape]
   337	    cols = [c for _, c in shape]
   338	    if max(rows) + 1 > SKELETON_BBOX_MAX or max(cols) + 1 > SKELETON_BBOX_MAX:
   339	        return None
   340	    if len({_shape for _shape, _marker in _shape_with_point_rotations(shape, (0, 0))}) != 4:
   341	        return None
   342	    return shape
   343	
   344	
   345	def _pick_marker(
   346	    shape: frozenset[tuple[int, int]],
   347	    rng: random.Random,
   348	) -> tuple[tuple[int, int], dict[tuple[int, int], dict]] | None:
   349	    candidates = set()
   350	    for r, c in shape:
   351	        for nr, nc in neighbors8(r, c):
   352	            if (nr, nc) not in shape:
   353	                candidates.add((nr, nc))
   354	    valid = []
   355	    shape_rows = [r for r, _ in shape]
   356	    shape_cols = [c for _, c in shape]
   357	    for marker in candidates:
   358	        try:
   359	            direction = _direction_from_centroid(shape, marker)
   360	        except AssertionError:
   361	            continue
   362	        if direction == (0, 1) and marker[1] <= max(shape_cols):
   363	            continue
   364	        if direction == (0, -1) and marker[1] >= min(shape_cols):
   365	            continue
   366	        if direction == (1, 0) and marker[0] <= max(shape_rows):
   367	            continue
   368	        if direction == (-1, 0) and marker[0] >= min(shape_rows):
   369	            continue
   370	
   371	        by_dir: dict[tuple[int, int], dict] = {}
   372	        ok = True
   373	        for turns, (shape_rot, marker_rot) in enumerate(_shape_with_point_rotations(shape, marker)):
   374	            if marker_rot in shape_rot:
   375	                ok = False
   376	                break
   377	            try:
   378	                dir_rot = _direction_from_centroid(shape_rot, marker_rot)
   379	            except AssertionError:
   380	                ok = False
   381	                break
   382	            by_dir[dir_rot] = {
   383	                "turns": turns,
   384	                "shape": shape_rot,
   385	                "marker": marker_rot,
   386	                "extents": _full_extents(shape_rot, marker_rot),
   387	            }
   388	        if ok and len(by_dir) == 4:
   389	            valid.append((marker, by_dir))
   390	    if not valid:
   391	        return None
   392	    return rng.choice(valid)
   393	
   394	
   395	def _lane_offsets(count: int) -> tuple[int, ...]:
   396	    if count == 2:
   397	        return (-4, 4)
   398	    assert count == 3
   399	    return (-6, 0, 6)
   400	
   401	
   402	def _min_manhattan(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> int:
   403	    return min(abs(r0 - r1) + abs(c0 - c1) for r0, c0 in a for r1, c1 in b)
   404	
   405	
   406	def _place_motifs(
   407	    height: int,
   408	    width: int,
   409	    variants: dict[tuple[int, int], dict],
   410	    motif_dirs: list[tuple[int, int]],
   411	    rng: random.Random,
   412	) -> list[dict] | None:
   413	    horiz_count = sum(direction in {(0, -1), (0, 1)} for direction in motif_dirs)
   414	    vert_count = len(motif_dirs) - horiz_count
   415	    row_offsets = _lane_offsets(horiz_count)
   416	    col_offsets = _lane_offsets(vert_count)
   417	    for _ in range(80):
   418	        center_r = rng.randint(8, height - 9)
   419	        center_c = rng.randint(8, width - 9)
   420	        rows = [center_r + off for off in row_offsets]
   421	        cols = [center_c + off for off in col_offsets]
   422	        rng.shuffle(rows)
   423	        rng.shuffle(cols)
   424	
   425	        row_iter = iter(rows)
   426	        col_iter = iter(cols)
   427	        placed: list[dict] = []
   428	        occupied_full: list[set[tuple[int, int]]] = []
   429	        failed = False
   430	
   431	        for direction in motif_dirs:
   432	            variant = variants[direction]
   433	            min_dr, max_dr, min_dc, max_dc = variant["extents"]
   434	            if direction == (0, 1):
   435	                marker_r = next(row_iter)
   436	                lo = max(-min_dc, 2)
   437	                hi = min(width - 1 - max_dc, 7)
   438	                if not (0 <= marker_r - min_dr and marker_r + max_dr < height and lo <= hi):
   439	                    failed = True
   440	                    break
   441	                marker_c = rng.randint(lo, hi)
   442	            elif direction == (0, -1):
   443	                marker_r = next(row_iter)
   444	                lo = max(-min_dc, width - 8)
   445	                hi = min(width - 1 - max_dc, width - 3)
   446	                if not (0 <= marker_r - min_dr and marker_r + max_dr < height and lo <= hi):
   447	                    failed = True
   448	                    break
   449	                marker_c = rng.randint(lo, hi)
   450	            elif direction == (1, 0):
   451	                marker_c = next(col_iter)
   452	                lo = max(-min_dr, 2)
   453	                hi = min(height - 1 - max_dr, 7)
   454	                if not (0 <= marker_c - min_dc and marker_c + max_dc < width and lo <= hi):
   455	                    failed = True
   456	                    break
   457	                marker_r = rng.randint(lo, hi)
   458	            else:
   459	                marker_c = next(col_iter)
   460	                lo = max(-min_dr, height - 8)
   461	                hi = min(height - 1 - max_dr, height - 3)
   462	                if not (0 <= marker_c - min_dc and marker_c + max_dc < width and lo <= hi):
   463	                    failed = True
   464	                    break
   465	                marker_r = rng.randint(lo, hi)
   466	
   467	            r0 = marker_r - variant["marker"][0]
   468	            c0 = marker_c - variant["marker"][1]
   469	            skeleton_abs = {(r0 + r, c0 + c) for r, c in variant["shape"]}
   470	            marker_abs = (marker_r, marker_c)
   471	            full_abs = set(skeleton_abs) | {marker_abs}
   472	
   473	            if any(not in_bounds((height, width), r, c) for r, c in full_abs):
   474	                failed = True
   475	                break
   476	            for prev in occupied_full:
   477	                if _min_manhattan(full_abs, prev) < 5:
   478	                    failed = True
   479	                    break
   480	            if failed:
   481	                break
   482	
   483	            placed.append(
   484	                {
   485	                    "direction": direction,
   486	                    "turns": variant["turns"],
   487	                    "skeleton_abs": skeleton_abs,
   488	                    "marker_abs": marker_abs,
   489	                    "full_abs": full_abs,
   490	                }
   491	            )
   492	            occupied_full.append(full_abs)
   493	
   494	        if failed:
   495	            continue
   496	
   497	        all_full = set().union(*occupied_full)
   498	        clear = True
   499	        for motif in placed:
   500	            rr, cc = motif["marker_abs"]
   501	            dr, dc = motif["direction"]
   502	            while in_bounds((height, width), rr, cc):
   503	                if (rr, cc) in all_full and (rr, cc) != motif["marker_abs"]:
   504	                    clear = False
   505	                    break
   506	                rr += dr
   507	                cc += dc
   508	            if not clear:
   509	                break
   510	        if clear:
   511	            return placed
   512	    return None
   513	
   514	
   515	def _validate_instance(grid: np.ndarray) -> None:
   516	    details = _solve_details(grid)
   517	    out = details["output"]
   518	    exact_out = _render_from_mask(grid, details["ray_cells"], details["exact_overlap_mask"])
   519	
   520	    assert np.any(out == COLLISION), "dilated ray intersections must exist"
   521	    assert not np.array_equal(exact_out, out), "dilation must enlarge the direct ray collisions"
   522	    assert details["copy_rotations"], "expected at least one copy"
   523	    assert any(turns != 0 for turns in details["copy_rotations"]), "at least one copy must be rotated"
   524	    assert len({motif["direction"] for motif in details["motifs"]}) >= 4, "the sample must expose all four directions"
   525	
   526	    collision_count = int(np.count_nonzero(details["collision_mask"]))
   527	    assert collision_count <= 70, "collision area should stay visually local"
   528	
   529	    for idx in range(len(details["ray_cells"])):
   530	        reduced = [ray for j, ray in enumerate(details["ray_cells"]) if j != idx]
   531	        alt = _render_from_rays(grid, reduced)
   532	        assert not np.array_equal(alt, out), "every ray must affect the final result"
   533	
   534	
   535	def _gen_attempt(rng: random.Random) -> np.ndarray | None:
   536	    height = rng.randint(GRID_MIN, GRID_MAX)
   537	    width = rng.randint(GRID_MIN, GRID_MAX)
   538	
   539	    shape = _random_skeleton(rng)
   540	    if shape is None:
   541	        return None
   542	    marker_pick = _pick_marker(shape, rng)
   543	    if marker_pick is None:
   544	        return None
   545	    _marker, variants = marker_pick
   546	
   547	    copy_count = rng.choice(COPY_COUNT_CHOICES)
   548	    motif_dirs = list(DIRS)
   549	    if copy_count == 4:
   550	        motif_dirs.append(rng.choice(DIRS))
   551	    rng.shuffle(motif_dirs)
   552	
   553	    placed = _place_motifs(height, width, variants, motif_dirs, rng)
   554	    if placed is None:
   555	        return None
   556	
   557	    template_idx = rng.randrange(len(placed))
   558	    grid = np.full((height, width), BG, dtype=int)
   559	    for idx, motif in enumerate(placed):
   560	        for r, c in motif["skeleton_abs"]:

