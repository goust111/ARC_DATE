+    min_r = min(r for r, _ in shape_rot)
+    min_c = min(c for _, c in shape_rot)
+    norm_shape = frozenset((r - min_r, c - min_c) for r, c in shape_rot)
+    norm_point = (point_rot[0] - min_r, point_rot[1] - min_c)
+    return norm_shape, norm_point
