+        if direction == (0, -1) and marker[1] >= min(shape_cols):
+            continue
+        if direction == (1, 0) and marker[0] <= max(shape_rows):
+            continue
+        if direction == (-1, 0) and marker[0] >= min(shape_rows):
+            continue
