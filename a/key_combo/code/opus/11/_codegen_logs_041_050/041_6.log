+        failed = False
+
+        for direction in motif_dirs:
+            variant = variants[direction]
+            min_dr, max_dr, min_dc, max_dc = variant["extents"]
+            if direction == (0, 1):
+                marker_r = next(row_iter)
+                lo = max(-min_dc, 2)
