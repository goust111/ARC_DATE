+                "kind": copy_kind,
+                "turns": int(variant["turns"]),
+                "direction": direction,
+                "marker_abs": marker_abs,
+                "ray_cells": ray_tuple,
+                "skeleton_abs": skeleton_abs,
+            }
+        )
+        ray_cells_list.append(ray_tuple)
