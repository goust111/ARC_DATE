+
+def _sequential_depths(grid: np.ndarray, objects: list[dict]) -> list[int]:
+    reserved: set[Coord] = set()
+    depths: list[int] = []
+    for obj in objects:
+        depth, claimed = _depth_for_object(grid, obj, reserved)
+        depths.append(depth)
