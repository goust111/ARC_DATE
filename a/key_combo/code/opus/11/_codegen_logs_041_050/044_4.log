+
+
+def _free_depths(grid: np.ndarray, objects: list[dict]) -> list[int]:
+    return [_depth_for_object(grid, obj, set())[0] for obj in objects]
+
+
+def _rotate_cell_cw(r: int, c: int, pivot: Coord, turns: int) -> Coord:
+    pr, pc = pivot
+    dr = r - pr
+    dc = c - pc
+    turns %= 4
+    for _ in range(turns):
