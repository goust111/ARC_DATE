+def _is_connected(mask: np.ndarray) -> bool:
+    cells = {(int(r), int(c)) for r, c in np.argwhere(mask)}
+    if not cells:
+        return False
+    seen = set()
+    q = deque([next(iter(cells))])
+    seen.add(q[0])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return seen == cells
