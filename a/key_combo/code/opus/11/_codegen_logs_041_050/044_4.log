+    return None
+
+
+def _sample_shapes(count: int) -> list[np.ndarray]:
+    return [random.choice(SHAPE_LIBRARY) for _ in range(count)]
+
+
+def _generate_attempt() -> np.ndarray | None:
+    side = random.randint(*GRID_RANGE)
+    grid_shape = (side, side)
