+
+
+def _depth_for_object(grid: np.ndarray, obj: dict, reserved: set[Coord]) -> tuple[int, set[Coord]]:
+    foreground = {(int(r), int(c)) for r, c in np.argwhere(grid != 0)}
+    other_foreground = foreground - obj["cells"]
+    current = set(obj["cells"])
