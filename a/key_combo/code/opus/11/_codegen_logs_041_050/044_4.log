+                continue
+            placements = [
+                (shape_a, a_top, a_left, color_a),
+                (shape_b, b_top, b_left, color_b),
+            ]
+            grid = _paint_objects(grid_shape, placements)
+            info = _analyze(grid)
+            if len(info["objects"]) != 2:
+                continue
+            if info["sequential_depths"] == [1, 0] and info["free_depths"] == [1, 1]:
+                return placements
+    return None
+
