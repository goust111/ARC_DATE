+        if len(info["objects"]) != 4:
+            continue
+        if info["sequential_depths"][:3] != [1, 0, target_depth]:
+            continue
+        if info["free_depths"][:3] != [1, 1, target_depth]:
+            continue
+        if info["sequential_depths"][3] > 2:
+            continue
