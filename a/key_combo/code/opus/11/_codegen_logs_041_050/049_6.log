+    start = (sr, sc, 1)
+    step_dist: dict[tuple[int, int, int], int] = {start: 0}
+    order = [start]
+    q = deque([start])
+
+    while q:
+        r, c, dprev = q.popleft()
+        step = step_dist[(r, c, dprev)]
