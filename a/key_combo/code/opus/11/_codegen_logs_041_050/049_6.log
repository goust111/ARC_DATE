+def _extract_bars(grid: np.ndarray) -> list[dict[str, int]]:
+    h, _w = grid.shape
+    bars: list[dict[str, int]] = []
+    for comp in _components(grid == RED):
+        r0, c0 = comp.min(axis=0)
+        r1, c1 = comp.max(axis=0)
