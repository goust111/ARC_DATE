from collections import deque
import heapq
import random
import numpy as np

BG, RED, GREEN = 8, 2, 3
DIRS = [(-1,0),(0,1),(1,0),(0,-1)]

def components(mask):
    h,w = mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    out=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            comp=[]
            while q:
                cr,cc=q.popleft(); comp.append((cr,cc))
                for dr,dc in DIRS:
                    nr,nc=cr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]:
                        seen[nr,nc]=True; q.append((nr,nc))
            out.append(comp)
    return out

def parse(g):
    pts=np.argwhere(g==GREEN)
    sr,sc=map(int,pts[0])
    bars=[]
    for comp in components(g==RED):
        rows=[r for r,c in comp]; cols=[c for r,c in comp]
        bars.append((min(rows), max(rows), cols[0], len(comp)))
    bars.sort(key=lambda x:x[2])
    return sr,sc,bars

def blocked(g):
    h,w=g.shape
    b=np.zeros((h,w),dtype=bool)
    for r0,r1,c,ht in parse(g)[2]:
        rr0=max(0,r0-ht); rr1=min(h-1,r1+ht)
        cc0=max(0,c-ht); cc1=min(w-1,c+ht)
        b[rr0:rr1+1,cc0:cc1+1]=True
    b[g==RED]=True
    return b

def solve(g):
    h,w=g.shape
    sr,sc,bars=parse(g)
    blk=blocked(g)
    blk[sr,sc]=False
    INF=(10**9,10**9)
    start=(sr,sc,1)
    best={start:(0,0)}
    cnt={start:1}
    prev={}
    heap=[(0,0,sr,sc,1)]
    while heap:
        steps,turns,r,c,d=heapq.heappop(heap)
        if (steps,turns)"'!=best.get((r,c,d)): continue
        for nd,(dr,dc) in enumerate(DIRS):
            if steps==0 and nd!=1:
                continue
            rr,cc=r+dr,c+dc
            if not (0<=rr<h and 0<=cc<w):
                continue
            if blk[rr,cc]:
                continue
            nc=(steps+1, turns + (nd!=d))
            key=(rr,cc,nd)
            oc=best.get(key)
            if oc is None or nc<oc:
                best[key]=nc; cnt[key]=cnt[(r,c,d)]; prev[key]=(r,c,d)
                heapq.heappush(heap,(nc[0],nc[1],rr,cc,nd))
            elif nc==oc:
                cnt[key]=min(2,cnt[key]+cnt[(r,c,d)])
                if (r,c,d) < prev.get(key,(99,99,99)):
                    prev[key]=(r,c,d)
    goals=[(cost,r,d) for (r,c,d),cost in best.items() if c==w-1]
    if not goals:
        return None
    best_cost=min(cost for cost,_,_ in goals)
    row=min(r for cost,r,_ in goals if cost==best_cost)
    end_states=[(r,w-1,d) for cost,r,d in goals if cost==best_cost and r==row]
    return best_cost,row,sum(cnt[s] for s in end_states), len([1 for cost,r,_ in goals if cost[0]==best_cost[0]])

def bfs_stats(g):
    h,w=g.shape
    sr,sc,bars=parse(g)
    blk=blocked(g)
    blk[sr,sc]=False
    start=(sr,sc,1)
    dist={start:0}
    q=deque([start])
    order=[start]
    while q:
        r,c,d=q.popleft()
        for nd,(dr,dc) in enumerate(DIRS):
            if dist[(r,c,d)]==0 and nd!=1:
                continue
            rr,cc=r+dr,c+dc
            if not (0<=rr<h and 0<=cc<w) or blk[rr,cc]:
                continue
            nxt=(rr,cc,nd)
            if nxt not in dist:
                dist[nxt]=dist[(r,c,d)]+1
                q.append(nxt)
                order.append(nxt)
    goals=[s for s,dv in dist.items() if s[1]==w-1]
    L=min(dist[s] for s in goals)
    min_turn={start:0}
    max_turn={start:0}
    for s in order[1:]:
        min_turn[s]=10**9
        max_turn[s]=-10**9
    by_step={}
    for s,dv in dist.items(): by_step.setdefault(dv,[]).append(s)
    for step in range(L):
        for r,c,d in by_step.get(step,[]):
            for nd,(dr,dc) in enumerate(DIRS):
                if step==0 and nd!=1: continue
                rr,cc=r+dr,c+dc
