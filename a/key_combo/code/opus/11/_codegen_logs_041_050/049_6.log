+    min_turns = {start: 0}
+    max_turns = {start: 0}
+    by_step: dict[int, list[tuple[int, int, int]]] = {}
+    for state, step in step_dist.items():
+        by_step.setdefault(step, []).append(state)
+        if state != start:
+            min_turns[state] = 10**9
+            max_turns[state] = -10**9
