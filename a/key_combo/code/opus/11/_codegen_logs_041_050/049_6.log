                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<h and 0<=nc<w and mask[nr,nc] and not seen[nr,nc]: seen[nr,nc]=1; q.append((nr,nc))
            out.append(cur)
    return out

def analyze(g):
    h,w=g.shape
    pts=np.argwhere(g==GREEN)
    sr,sc=map(int,pts[0])
    bars=[]
    for comp in comps(g==RED):
        rows=[r for r,c in comp]; cols=[c for r,c in comp]
        bars.append((min(rows),max(rows),cols[0],len(comp)))
    blk=np.zeros((h,w),dtype=bool)
    for r0,r1,c,ht in bars:
        blk[max(0,r0-ht):min(h-1,r1+ht)+1, max(0,c-ht):min(w-1,c+ht)+1]=1
    blk[g==RED]=1; blk[sr,sc]=0
    start=(sr,sc,1)
    dist={start:0}
    q=deque([start]); order=[start]
    while q:
        r,c,d=q.popleft(); step=dist[(r,c,d)]
        for nd,(dr,dc) in enumerate(DIRS):
            if step==0 and nd"'!=1: continue
            rr,cc=r+dr,c+dc
            if not (0<=rr<h and 0<=cc<w) or blk[rr,cc]: continue
            nxt=(rr,cc,nd)
            if nxt not in dist:
                dist[nxt]=step+1; q.append(nxt); order.append(nxt)
    goals=[s for s in dist if s[1]==w-1]
    if not goals: return None
    L=min(dist[s] for s in goals)
    min_turn={start:0}; max_turn={start:0}; cnt={start:1}
    for s in order[1:]: min_turn[s]=10**9; max_turn[s]=-10**9; cnt[s]=0
    by_step={}
    for s,d in dist.items(): by_step.setdefault(d,[]).append(s)
    for step in range(L):
        for r,c,d in by_step.get(step,[]):
            for nd,(dr,dc) in enumerate(DIRS):
                if step==0 and nd!=1: continue
                rr,cc=r+dr,c+dc; nxt=(rr,cc,nd)
                if dist.get(nxt)!=step+1: continue
                turn=min_turn[(r,c,d)] + (nd!=d)
                min_turn[nxt]=min(min_turn[nxt],turn)
                max_turn[nxt]=max(max_turn[nxt],max_turn[(r,c,d)]+(nd!=d))
    goal_min_turn=min(min_turn[s] for s in goals if dist[s]==L)
    best_rows=[s[0] for s in goals if dist[s]==L and min_turn[s]==goal_min_turn]
    return L, goal_min_turn, max(max_turn[s] for s in goals if dist[s]==L), min(best_rows)

for _ in range(20):
