+    h, w = shape
+    blocked = np.zeros((h, w), dtype=bool)
+    for bar in bars:
+        radius = int(bar["height"])
+        rr0 = max(0, int(bar["row0"]) - radius)
+        rr1 = min(h - 1, int(bar["row1"]) + radius)
+        cc0 = max(0, int(bar["col"]) - radius)
