+        _validate_generated(
+            grid,
+            block_rows,
+            block_cols,
+            block_size,
+            template,
+            states,
+            clean_sprite_ids,
+            noisy_blocks,
+        )
+        return grid
+
+    raise RuntimeError("failed to generate a valid ARC input")

