+        noisy_blocks.append(random.choice(preferred or noisy_sprite_pool))
+    if noisy_blank_pool:
+        preferred = [idx for idx in noisy_blank_pool if idx in prefix]
+        pick = random.choice(preferred or noisy_blank_pool)
+        if pick not in noisy_blocks:
