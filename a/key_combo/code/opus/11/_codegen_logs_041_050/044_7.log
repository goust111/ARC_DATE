+GRID_ROW_OPTIONS = (2, 3, 4)
+GRID_COL_OPTIONS = (2, 3, 4)
+CONTROL_LENGTH_OPTIONS = (2, 3, 4)
+GENERATION_ATTEMPTS = 500
