+def _rod_input_cells(plan: dict) -> set[tuple[int, int]]:
+    hr, hc = plan["hinge"]
+    fr, fc = plan["fixed_dir"]
+    cells = {(hr, hc)}
+    for step in range(1, plan["fixed_steps"] + 1):
+        cells.add((hr + fr * step, hc + fc * step))
+    for step in range(1, plan["active_len"] + 1):
+        cells.add((hr - fr * step, hc - fc * step))
+    return cells
