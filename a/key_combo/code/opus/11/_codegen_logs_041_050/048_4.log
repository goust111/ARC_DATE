+                "hinge": rod["hinge"],
+                "fold_dir": rod["fold_dir"],
+                "active_len": rod["active_len"],
+            }
+        )
+        ray_probe = (new_end[0] + rod["fold_dir"][0], new_end[1] + rod["fold_dir"][1])
+        seen_target = False
+        while in_bounds(grid.shape, *ray_probe):
+            value = int(grid[ray_probe])
+            if value != BG:
+                if value != TARGET:
