+def _rod_fold_cells(plan: dict) -> list[tuple[int, int]]:
+    hr, hc = plan["hinge"]
+    dr, dc = plan["fold_dir"]
+    return [(hr + dr * step, hc + dc * step) for step in range(1, plan["active_len"] + 1)]
