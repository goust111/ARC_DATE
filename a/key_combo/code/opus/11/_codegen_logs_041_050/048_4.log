+    rods.sort(key=lambda rod: rod["endpoint"])
+    return rods
+
+
+def _simulate(grid: np.ndarray, trace: bool = False):
+    g = np.array(grid, dtype=int)
+    assert g.ndim == 2
+    assert get_bg(g) == BG
+    rods = _parse_rods(g)
+    assert 3 <= len(rods) <= 4
+    targets, target_by_cell = _trace_targets(g)
+    assert 3 <= len(targets) <= 5
