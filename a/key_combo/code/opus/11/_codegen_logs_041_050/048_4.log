+def _line_target_count(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    target_by_cell: dict[tuple[int, int], int],
+) -> set[int]:
+    out: set[int] = set()
+    r, c = start
+    dr, dc = direction
+    while in_bounds(grid.shape, r, c):
+        if int(grid[r, c]) == TARGET:
+            out.add(target_by_cell[(r, c)])
+        r += dr
+        c += dc
