+            return False
+        opposite = (-rod["fold_dir"][0], -rod["fold_dir"][1])
+        opp_start = (rod["hinge"][0] + opposite[0], rod["hinge"][1] + opposite[1])
+        if _line_target_count(grid, opp_start, opposite, target_by_cell):
+            return False
