+
+def _get_bg(grid: np.ndarray) -> int:
+    values, counts = np.unique(np.asarray(grid, dtype=int), return_counts=True)
+    return int(values[np.argmax(counts)])
+
+
+def _neighbors4(r: int, c: int) -> tuple[Coord, Coord, Coord, Coord]:
+    return (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)
+
+
+def _components_from_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    components: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                cr, cc = stack.pop()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _segment_endpoints(coords: np.ndarray) -> tuple[Coord, Coord]:
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    if np.all(rows == rows[0]):
+        row = int(rows[0])
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        assert len(coords) == c1 - c0 + 1
+        return (row, c0), (row, c1)
+    if np.all(cols == cols[0]):
+        col = int(cols[0])
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        assert len(coords) == r1 - r0 + 1
+        return (r0, col), (r1, col)
+    raise AssertionError("red object must be one straight horizontal or vertical segment")
+
+
+def _bresenham(a: Coord, b: Coord) -> list[Coord]:
+    r0, c0 = map(int, a)
+    r1, c1 = map(int, b)
+    x0, y0, x1, y1 = c0, r0, c1, r1
+    dx = abs(x1 - x0)
+    sx = 1 if x0 < x1 else -1
+    dy = -abs(y1 - y0)
+    sy = 1 if y0 < y1 else -1
+    err = dx + dy
+    pts: list[Coord] = []
+    while True:
+        pts.append((y0, x0))
+        if x0 == x1 and y0 == y1:
+            return pts
+        e2 = 2 * err
+        if e2 >= dy:
+            err += dy
+            x0 += sx
+        if e2 <= dx:
+            err += dx
+            y0 += sy
+
+
+def _sprite_components(grid: np.ndarray) -> tuple[list[np.ndarray], list[Coord], tuple[Coord, ...]]:
+    comps = _components_from_mask(np.isin(grid, (BLUE, YELLOW)))
+    assert len(comps) == 3
+    anchors: list[Coord] = []
+    normalized_shapes: list[tuple[Coord, ...]] = []
