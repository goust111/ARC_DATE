+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+
+Coord = tuple[int, int]
+
+GRID_H_RANGE = (18, 25)
+GRID_W_RANGE = (18, 25)
+RECT_COUNT_CHOICES = (2, 3)
