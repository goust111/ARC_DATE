+    sprite_only_out[grey_mask] = GREY
+    _stamp_sprite(sprite_only_out, segment_endpoints[0], offsets)
+    _stamp_sprite(sprite_only_out, segment_endpoints[1], offsets)
+    if np.array_equal(sprite_only_out, out):
