 102:         color: [
 103:             component["coords"]
 104:             for component in find_components(g, bg=bg, colors=[color], connectivity=8)
 105:         ]
 106:         for color in colors
 107:     }
 108: 
 109:     connector_colors = [
 110:         color
 111:         for color, components in components_by_color.items()
 112:         if len(components) == 1 and _segment_endpoints(components[0]) is not None
 113:     ]
 114:     sprite_colors = [
 115:         color
 116:         for color, components in components_by_color.items()
