+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    if np.all(rows == rows[0]):
+        row = int(rows[0])
+        c0 = int(cols.min())
+        c1 = int(cols.max())
+        assert len(coords) == c1 - c0 + 1
+        return (row, c0), (row, c1)
+    if np.all(cols == cols[0]):
+        col = int(cols[0])
+        r0 = int(rows.min())
+        r1 = int(rows.max())
+        assert len(coords) == r1 - r0 + 1
