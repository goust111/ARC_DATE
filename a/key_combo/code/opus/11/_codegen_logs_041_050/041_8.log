+
+def _line_mask_from_anchors(shape: tuple[int, int], anchors: list[Coord], grey_mask: np.ndarray) -> np.ndarray:
+    red_mask = np.zeros(shape, dtype=bool)
+    for a, b in combinations(anchors, 2):
+        for r, c in _bresenham(a, b):
+            if grey_mask[r, c]:
+                red_mask[r, c] = True
