+        colors = [int(grid[r, c]) for r, c in comp]
+        assert colors.count(YELLOW) == 1
+        anchor_arr = comp[np.array(colors) == YELLOW][0]
+        anchor = (int(anchor_arr[0]), int(anchor_arr[1]))
