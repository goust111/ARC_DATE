+def _make_input_grid(
+    h: int,
+    w: int,
+    anchors: list[Coord],
+    offsets: tuple[Coord, ...],
+    rects: list[tuple[int, int, int, int]],
+    segment_endpoints: tuple[Coord, Coord],
+) -> np.ndarray:
