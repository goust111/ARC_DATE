+    mid_r = h // 2
+    mid_c = w // 2
+    if slot in ("tl", "tr"):
+        r_lo, r_hi = 2, mid_r - box_h - 1
+    else:
+        r_lo, r_hi = mid_r + 1, h - box_h - 2
+    if slot in ("tl", "bl"):
+        c_lo, c_hi = 2, mid_c - box_w - 1
+    else:
+        c_lo, c_hi = mid_c + 1, w - box_w - 2
+    if r_lo > r_hi or c_lo > c_hi:
