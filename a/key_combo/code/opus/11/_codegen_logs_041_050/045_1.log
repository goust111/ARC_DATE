+            continue
+        max_count = max(all_counts.values())
+        winners = [color for color, cnt in all_counts.items() if cnt == max_count]
+        if len(winners) != 1:
+            continue
+        outside_winner = winners[0]
+        if all(majority == outside_winner for majority in majorities):
+            continue
+        return assignments
+    return None
