+
+def _draw_loop_walls(grid: np.ndarray, loops: list[dict]) -> None:
+    for loop in loops:
+        r0 = int(loop["r0"])
+        c0 = int(loop["c0"])
+        r1 = int(loop["r1"])
+        c1 = int(loop["c1"])
+        grid[r0 : r1 + 1, c0] = WALL
+        grid[r0 : r1 + 1, c1] = WALL
+        grid[r0, c0 : c1 + 1] = WALL
+        grid[r1, c0 : c1 + 1] = WALL
