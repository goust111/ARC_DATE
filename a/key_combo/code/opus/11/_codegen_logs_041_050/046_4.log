+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BACKGROUND = 7
+GREY = 5
+CONTROL_COLORS = (1, 2, 3, 4)
+DIR4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR8 = tuple((dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0))
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
