+                "coords": coords,
+                "mask": mask,
+                "passable": _classify_region(mask),
+                "top": int(rows.min()),
+                "bottom": int(rows.max()),
+                "left": int(cols.min()),
+                "right": int(cols.max()),
+                "size": int(coords.shape[0]),
+            }
+        )
+    return regions, region_index
+
