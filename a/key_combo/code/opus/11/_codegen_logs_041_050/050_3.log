    placement: bars of different colors do not share any columns or row intervals
  rays:
    rule: |
      Each bar extends upward and downward in blocks of bar_height rows.
      At each block away from the original interval, the left bar shifts 1 column left
      and the right bar shifts 1 column right. Clipped at grid edges.
    total_steps_per_pair: 4-15 (sum of up and down extension steps)
