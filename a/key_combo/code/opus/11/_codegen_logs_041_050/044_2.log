+        if c0 <= c <= c1:
+            d = _distance_to_bar(g, r, c)
+            out[r, c] = palette[d % k]
+        else:
+            out[r, c] = BLACK
+    return out
+
+
+def _wrong_ignore_coverage(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    palette = _palette(g)
+    out = g.copy()
+    k = len(palette)
