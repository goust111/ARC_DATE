+    distances = distances[:count]
+    rng.shuffle(distances)
+    return distances
+
+
+def _build_attempt(rng: random.Random) -> tuple[np.ndarray, np.ndarray] | None:
+    height = rng.randint(10, 16)
+    palette_len = rng.randint(3, 4)
