+    g = np.asarray(grid, dtype=int)
+    c0, c1 = _control_span(g)
+    palette = _palette(g)
+    out = g.copy()
+    k = len(palette)
+
+    for r, c in _blue_pixels(g):
+        if c0 <= c <= c1:
+            d = _distance_to_bar(g, r, c)
+            out[r, c] = palette[d % k]
+        else:
+            out[r, c] = BLACK
+    return out
