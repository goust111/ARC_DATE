+    g = np.asarray(grid, dtype=int)
+    c0, c1 = _control_span(g)
+    palette = _palette(g)
+    out = g.copy()
+    for r, c in _blue_pixels(g):
+        out[r, c] = palette[0] if c0 <= c <= c1 else BLACK
+    return out
+
+
+def _wrong_no_wrap(grid: np.ndarray) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    c0, c1 = _control_span(g)
+    palette = _palette(g)
+    out = g.copy()
+    for r, c in _blue_pixels(g):
+        if c0 <= c <= c1:
