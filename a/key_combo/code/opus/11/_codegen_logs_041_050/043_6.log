+        axis = forced_axis if forced_axis is not None else random.choice(("horizontal", "vertical"))
+        direction = random.choice(HORIZONTAL_DIRS if axis == "horizontal" else VERTICAL_DIRS)
+        shape = _pick_template(axis, target=False)
