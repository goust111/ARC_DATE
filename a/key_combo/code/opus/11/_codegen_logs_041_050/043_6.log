        crop = _component_crop(g, coords, bg)
        mask = crop != bg
        if not np.array_equal(mask, np.fliplr(mask)):
            asymmetric_crops.append(crop)

    assert len(asymmetric_crops) == 1, "expected exactly one left-right-asymmetric object"
