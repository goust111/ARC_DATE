+def _frame_cells(box: BBox) -> set[Coord]:
+    r0, c0, r1, c1 = box
+    cells: set[Coord] = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0 + 1, r1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _is_hollow_rect(coords: np.ndarray) -> bool:
