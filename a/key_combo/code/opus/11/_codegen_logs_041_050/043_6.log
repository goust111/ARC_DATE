+def _coords_in_bounds(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    return bool(
+        np.all(coords[:, 0] >= 0)
+        and np.all(coords[:, 1] >= 0)
+        and np.all(coords[:, 0] < shape[0])
+        and np.all(coords[:, 1] < shape[1])
+    )
