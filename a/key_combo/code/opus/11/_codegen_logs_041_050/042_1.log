+        {"name": "top", "r0": top_r, "c0": frame_col, "side": "top", "offset": 1},
+        {"name": "right", "r0": mid_r, "c0": frame_col, "side": "right", "offset": 2},
+        {"name": "bottom", "r0": bottom_r, "c0": frame_col, "side": "bottom", "offset": 1},
+    ]
