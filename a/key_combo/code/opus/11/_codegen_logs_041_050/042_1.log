+def _render_start_strip(grid: np.ndarray, start_point: tuple[int, int]) -> None:
+    edge = (start_point[0] + 1, start_point[1] - 1)
+    grid[start_point] = GREEN
+    grid[edge] = GREEN
+
+
+def _validate_scene(grid: np.ndarray) -> None:
