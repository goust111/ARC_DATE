+        if (nr, nc) in obstacle_map:
+            direction = _reflect(direction, obstacle_map[(nr, nc)])
+            hits.append((nr, nc))
+            bounces += 1
+            assert bounces <= 3, "valid scenes use at most three bounces"
+            continue
