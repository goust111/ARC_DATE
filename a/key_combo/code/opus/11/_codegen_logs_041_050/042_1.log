+def _valid_start_point(
+    shape: tuple[int, int],
+    b0: tuple[int, int],
+    blocked: set[tuple[int, int]],
+    path_cells: set[tuple[int, int]],
+) -> bool:
+    h, w = shape
+    if not _in_bounds(shape, b0[0], b0[1]):
+        return False
+    if b0 in blocked or b0 in path_cells:
+        return False
+    edge = (b0[0] + 1, b0[1] - 1)
+    if not _in_bounds(shape, edge[0], edge[1]):
+        return False
+    if edge in blocked or edge in path_cells:
+        return False
+    if not (edge[1] == 0 or edge[0] == h - 1):
+        return False
+    if b0[0] < h // 2 or b0[1] > min(4, w - 2):
