+        assert side in {"top", "right", "bottom"}, "allowed gap sides are top/right/bottom only"
+        assert 1 <= offset <= 3, "gap must be a non-corner border cell"
+        inner = {
+            (r, c)
+            for r in range(r0 + 1, r1)
+            for c in range(c0 + 1, c1)
+        }
+        frames.append(
+            {
+                "bbox": (r0, c0, r1, c1),
+                "gap": gap,
+                "side": side,
+                "offset": offset,
+                "inner": inner,
+                "cells": cells,
+            }
+        )
