+                "name": spec["name"],
+                "bbox": (spec["r0"], spec["c0"], spec["r0"] + 4, spec["c0"] + 4),
+                "gap": gap,
+                "side": spec["side"],
+                "offset": spec["offset"],
+                "inner": inner,
+                "dir": spec["dir"],
+            }
