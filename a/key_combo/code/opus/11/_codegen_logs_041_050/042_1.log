+def _bar_candidates(
+    shape: tuple[int, int],
+    hit: tuple[int, int],
+    orientation: str,
+    reserved: set[tuple[int, int]],
+    existing_red: set[tuple[int, int]],
+) -> list[list[tuple[int, int]]]:
+    h, w = shape
+    out: list[list[tuple[int, int]]] = []
+    for length in (3, 4, 5):
+        for offset in range(1, length - 1):
+            if orientation == "H":
+                c0 = hit[1] - offset
+                cells = [(hit[0], c0 + i) for i in range(length)]
+            else:
+                r0 = hit[0] - offset
+                cells = [(r0 + i, hit[1]) for i in range(length)]
+            if any(not _in_bounds((h, w), r, c) for r, c in cells):
+                continue
+            if any(cell in reserved for cell in cells):
+                continue
+            ok = True
+            cell_set = set(cells)
+            for r, c in cells:
+                for nr, nc in _neighbors4(r, c):
+                    if (nr, nc) in existing_red and (nr, nc) not in cell_set:
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                out.append(cells)
+    random.shuffle(out)
+    return out
