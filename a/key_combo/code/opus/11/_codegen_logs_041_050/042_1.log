        cell_set = set(cells)
        touching = False
        for r, c in cells:
            for nr, nc in _neighbors4(r, c):
                if (nr, nc) in red_cells and (nr, nc) not in cell_set:
                    touching = True
                    break
            if touching:
                break
        if touching:
            continue

        trial = current.copy()
        for r, c in cells:
            trial[r, c] = RED
        try:
            info = _trace_scene(trial)
        except AssertionError:
            continue
        if info["bounces"] != bounce_count or info["target"]["gap"] != target["gap"]:
            continue
        if info["path"] != expected_path or info["hit_cells"] != expected_hits:
            continue
        current = trial
        red_cells |= cell_set
        extras_needed -= 1

    if extras_needed != 0:
        return None

    try:
        _validate_scene(current)
    except AssertionError:
        return None
    return current


def generate_input() -> np.ndarray:
    for _ in range(600):
        grid = _attempt_generate()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid puzzle instance")

