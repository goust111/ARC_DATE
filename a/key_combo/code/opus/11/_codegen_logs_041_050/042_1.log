    blocked = {tuple(map(int, rc)) for rc in np.argwhere(grid "'!= mod.BLACK)}
    blocked |= {frame['"'gap'] for frame in frames if frame['name'] "'!= target['"'name']}
    ok = mod._search_path(grid.shape, blocked, target['gap'], end_direction, seq) is not None
    stats[(bc, target_name)] += ok
