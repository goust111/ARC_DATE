+        hit_cells: list[tuple[int, int] | None] = [None] * len(seq)
+        bounce_points[-1] = last_bounce
+        result = rec(
+            len(seq),
+            last_bounce,
+            end_direction,
+            set(final_segment) | {last_bounce},
+            bounce_points,
+            hit_cells,
+            set(),
