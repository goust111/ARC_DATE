+            obstacle_map[cell] = orientation
+        records.append({"cells": cells, "orientation": orientation, "bbox": (r0, c0, r1, c1)})
+    return obstacle_map, records
+
+
+def _find_frames(grid: np.ndarray) -> list[dict]:
