+        current = trial
+        red_cells |= cell_set
+        extras_needed -= 1
+
+    if extras_needed != 0:
+        return None
+
+    try:
+        _validate_scene(current)
+    except AssertionError:
+        return None
+    return current
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(600):
+        grid = _attempt_generate()
+        if grid is not None:
