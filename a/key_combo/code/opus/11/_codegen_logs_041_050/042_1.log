+
+def _build_base_scene(height: int, width: int) -> tuple[np.ndarray, list[dict]]:
+    grid = np.zeros((height, width), dtype=int)
+
+    legend_c0 = random.randint(2, 5)
+    grid[0, legend_c0 : legend_c0 + 3] = np.array([BLUE, YELLOW, PINK], dtype=int)
+
+    frame_col_low = max(width // 2 + 1, width - 9)
+    frame_col_high = width - 6
+    frame_col = random.randint(frame_col_low, frame_col_high)
+
+    top_r = random.randint(1, 2)
+    bottom_r = random.randint(height - 8, height - 7)
+    mid_low = top_r + 5
+    mid_high = bottom_r - 5
+    mid_r = random.randint(mid_low, mid_high)
+
+    frame_specs = [
+        {"name": "top", "r0": top_r, "c0": frame_col, "side": "top", "offset": 1, "dir": (1, 1)},
+        {"name": "right", "r0": mid_r, "c0": frame_col, "side": "right", "offset": 3, "dir": (-1, -1)},
+        {"name": "bottom", "r0": bottom_r, "c0": frame_col, "side": "bottom", "offset": 1, "dir": (-1, 1)},
+    ]
