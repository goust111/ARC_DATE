+        (r, c)
+        for r in range(r0, r0 + FRAME_SIZE)
+        for c in range(c0, c0 + FRAME_SIZE)
+        if r in (r0, r0 + FRAME_SIZE - 1) or c in (c0, c0 + FRAME_SIZE - 1)
+    }
+    border.remove(gap)
+    inner = {
+        (r, c)
+        for r in range(r0 + 1, r0 + FRAME_SIZE - 1)
+        for c in range(c0 + 1, c0 + FRAME_SIZE - 1)
