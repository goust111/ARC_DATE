def _sample_block_states(n: int) -> tuple[np.ndarray, int]:
    block_count = n * n
    max_blanks = max(MIN_BLANK_BLOCKS, block_count // MAX_BLANK_BLOCK_DENOMINATOR)
    blank_blocks = random.randint(MIN_BLANK_BLOCKS, max_blanks)
