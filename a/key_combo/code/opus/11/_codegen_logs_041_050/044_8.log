+def _apply_rule(grid: np.ndarray, fill_len: int, *, match_required: bool = True, full_row: bool = False) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    out[out == GREY] = BG
