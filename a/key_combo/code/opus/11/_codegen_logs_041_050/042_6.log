+    for quadrant, (rs, cs) in slices.items():
+        block = g[rs, cs]
+        non_default = sorted(set(map(int, np.unique(block))) - {BG, ORANGE})
+        if quadrant == "tl":
+            assert not non_default, "top-left quadrant should only contain orange template pixels"
