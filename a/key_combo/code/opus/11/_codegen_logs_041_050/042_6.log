import itertools, numpy as np
from collections import deque

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def is_conn(cells):
    cells=set(cells)
    q=deque([next(iter(cells))]); vis=set(q)
    while q:
        p=q.popleft()
        for n in neighbors4(*p):
            if n in cells and n not in vis:
                vis.add(n); q.append(n)
    return len(vis)==len(cells)

def canon(cells):
    cells=np.array(list(cells))
    cells=cells-cells.min(axis=0)
    return tuple(sorted(map(tuple,cells)))

def sym(cells):
    arr=np.array(cells)
    h=arr[:,0].max()+1; w=arr[:,1].max()+1
    m=np.zeros((h,w),int)
    for r,c in cells:m[r,c]=1
    return np.array_equal(m,np.fliplr(m)), np.array_equal(m,np.flipud(m))

def layers(cells):
    cells=set(cells)
    rem=set(cells)
    ls=[]
    while rem:
        layer={p for p in rem if any(n not in rem for n in neighbors4(*p))}
        ls.append(layer)
        rem-=layer
    return [len(x) for x in ls]

for H in range(4,6):
  for W in range(4,6):
    coords=[(r,c) for r in range(H) for c in range(W)]
    for n in [12,13,14]:
      found=0
      for comb in itertools.combinations(coords,n):
        cells=set(comb)
        if not is_conn(cells):
          continue
        ls=layers(cells)
        if len(ls)==3:
          lr,ud=sym(canon(cells))
          if not lr and not ud:
            print('H,W,n',H,W,n,'layers',ls,'cells',canon(cells))
            raise SystemExit
print('none')
