+    return True
+
+
+def _replace_sprite(grid: np.ndarray, sprite_patch: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    patch = _find_template_patch(out)
+    red_coords = np.argwhere((patch == RED) | (patch == GRAY))
+    full_red = np.argwhere((out == RED) | (out == GRAY))
+    assert red_coords.shape[0] == full_red.shape[0]
+    r0, c0, _, _ = _bbox(full_red)
+    out[r0 : r0 + 5, c0 : c0 + 5] = sprite_patch
