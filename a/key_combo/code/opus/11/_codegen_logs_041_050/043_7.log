+def _render(rotated_patch: np.ndarray, control_colors: list[int], gaps: list[int]) -> np.ndarray:
+    tile_h, tile_w = rotated_patch.shape
+    width = len(control_colors) * tile_w + sum(gaps)
+    out = np.zeros((tile_h, width), dtype=int)
