   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Split the scene at the red divider and output the union of the two orange masks in blue.
  11: 
  12:     Input structure:
  13:     - The grid contains two same-sized black/orange masks.
  14:     - A single full-height red column separates the left and right masks.
  15: 
  16:     Rule:
  17:     - Locate the red separator column and split the input into the two aligned masks.
  18:     - For each corresponding cell, output blue if either mask has an orange pixel there.
  19:     - Output black where both masks have black.
  20: 
  21:     Key insight:
  22:     - The red column is only a delimiter; the visible operation is a pixelwise OR of the two
  23:       aligned orange masks, with active pixels recolored blue.
  24:     """
  25:     g = np.asarray(grid, dtype=int)
  26:     assert g.ndim == 2, "expected a 2D grid"
  27: 
  28:     separator_cols = np.flatnonzero(np.all(g == Color.RED, axis=0))
  29:     assert len(separator_cols) == 1, "expected one full-height red separator column"
  30:     c = int(separator_cols[0])
  31: 
  32:     left = g[:, :c]
  33:     right = g[:, c + 1 :]
  34:     assert left.shape == right.shape, "expected equal-sized masks on both sides"
  35:     assert left.size > 0, "expected nonempty masks"
  36:     assert set(np.unique(left)) <= {Color.BLACK, Color.ORANGE}
  37:     assert set(np.unique(right)) <= {Color.BLACK, Color.ORANGE}
  38: 
  39:     out = np.full(left.shape, Color.BLACK, dtype=int)
  40:     out[(left == Color.ORANGE) | (right == Color.ORANGE)] = Color.BLUE
