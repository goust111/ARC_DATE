+    ((0, 2), (1, 0), (2, 1)),  # d = 2,3,7
+    ((0, 2), (1, 1), (2, 0)),  # d = 2,4,6
+    ((0, 2), (1, 2), (2, 0)),  # invalid repeated col, filtered below
