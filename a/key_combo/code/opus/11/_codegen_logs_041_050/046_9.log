  "dst": "square rings d centered on the lower seed pixel, ordered inside-out by Chebyshev distance",
  "match_cond": "rank(s) == d.chebyshev_radius",
  "transform": "fill each ring d with s.color, leaving background-code rings blank; preserve the header and separator except a non-background code pixel directly above the seed column becomes the separator color",
  "symbol_instructions": "the top row is the radius-indexed palette; the lower singleton gives the center and must match the first palette color"
}
</annotation>
