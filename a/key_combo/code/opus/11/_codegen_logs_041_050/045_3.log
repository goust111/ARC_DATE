0101: def _canonical_output(h: int, w: int, border_color: int, fill_color: int) -> np.ndarray:
0102:     """Render the top-left canonical answer before restoring orientation."""
0103:     out = np.full((h, w), 8, dtype=int)
0104:     out[0, 1:] = fill_color
0105:     out[1:, 0] = fill_color
0106:     out[1, 2:] = border_color
0107:     out[2:, 1] = border_color
0108:     diag = np.arange(min(h - 2, w - 2))
0109:     out[2 + diag, 2 + diag] = fill_color
0110:     return out
0111: 
0112: 
0113: def _restore_orientation(grid: np.ndarray, corner: int) -> np.ndarray:
0114:     """Flip a canonical top-left grid back to the sampled corner."""
0115:     flip_rows, flip_cols = CORNER_FLIPS[corner]
0116:     if flip_cols:
0117:         grid = np.fliplr(grid)
0118:     if flip_rows:
0119:         grid = np.flipud(grid)
0120:     return grid
0121: 
0122: 
0123: def _gen_attempt() -> np.ndarray | None:
0124:     h, w, border_color, fill_color, corner = _sample_params()
0125:     inp = np.full((h, w), fill_color, dtype=int)
0126:     _paint_corner_l(inp, border_color, corner)
0127:     out = _restore_orientation(_canonical_output(h, w, border_color, fill_color), corner)
0128: 
0129:     if not np.array_equal(main(inp), out):
0130:         return None
0131:     return inp
0132: 
0133: 
0134: def generate_input() -> np.ndarray:
