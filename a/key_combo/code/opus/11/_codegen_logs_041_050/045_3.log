0055:             if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and g[nr, nc] == bg:
0056:                 contour.add((int(nr), int(nc)))
0057:     assert contour, "expected outline to touch background contour cells"
0058: 
0059:     for r, c in contour:
0060:         out[r, c] = marker_color
0061:     return out
