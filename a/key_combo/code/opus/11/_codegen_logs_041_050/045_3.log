0103: def _gen_marker_rows(height: int, marker_count: int) -> list[int]:
0104:     last_marker_row = height - 1 - BOTTOM_NON_MARKER_ROWS
0105:     if marker_count == 1:
0106:         return [_gen_randint(0, last_marker_row)]
0107: 
0108:     min_span = MARKER_GAP_RANGE[0] * (marker_count - 1)
0109:     max_span = min(MARKER_GAP_RANGE[1] * (marker_count - 1), last_marker_row)
0110:     span = _gen_randint(min_span, max_span)
0111:     start = _gen_randint(0, last_marker_row - span)
0112:     deltas = _gen_bounded_composition(marker_count - 1, span, *MARKER_GAP_RANGE)
0113: 
0114:     rows = [start]
0115:     for delta in deltas:
0116:         rows.append(rows[-1] + delta)
0117:     return rows
0118: 
0119: 
0120: def _gen_marker_cols(marker_count: int, segment_width: int, grid_width: int) -> list[int]:
0121:     max_blue = min(
0122:         BLUE_COL_RANGE[1],
0123:         grid_width - segment_width - 2,
