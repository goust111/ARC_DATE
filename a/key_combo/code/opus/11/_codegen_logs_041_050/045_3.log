0024: def main(grid: np.ndarray) -> np.ndarray:
0025:     """Rewrite a corner L block into two nested L borders and a diagonal trace.
0026: 
0027:     Input structure
0028:     A rectangular grid has exactly two colors: one color forms a one-cell-thick
0029:     L on two adjacent outer edges, and the other color fills the remaining
0030:     rectangle.
0031: 
0032:     Rule
0033:     Normalize the L to the top-left corner. Paint the outer top-left L with the
0034:     fill color, the next inner L with the original border color, and the main
0035:     diagonal of the remaining inner rectangle with the fill color. All other
0036:     cells become color 8, then the original orientation is restored.
0037: 
0038:     Key insight
0039:     The corner of the input L determines the orientation; after flipping to a
0040:     canonical top-left L, the output is the same nested-layer pattern for every
0041:     example.
0042:     """
0043:     g = np.asarray(grid, dtype=int)
0044:     h, w = g.shape
0045:     assert h >= 3 and w >= 3
0046:     assert 8 not in np.unique(g)
0047: 
0048:     border_color, fill_color, flip_rows, flip_cols = _corner_l_spec(g)
0049: 
0050:     canon = g
0051:     if flip_rows:
0052:         canon = np.flipud(canon)
0053:     if flip_cols:
0054:         canon = np.fliplr(canon)
0055: 
0056:     assert np.all(canon[0, :] == border_color)
0057:     assert np.all(canon[:, 0] == border_color)
0058:     assert np.all(canon[1:, 1:] == fill_color)
0059: 
0060:     out = np.full((h, w), 8, dtype=int)
0061:     out[0, 1:] = fill_color
0062:     out[1:, 0] = fill_color
0063:     out[1, 2:] = border_color
0064:     out[2:, 1] = border_color
0065:     for k in range(min(h - 2, w - 2)):
0066:         out[2 + k, 2 + k] = fill_color
0067: 
0068:     if flip_cols:
0069:         out = np.fliplr(out)
0070:     if flip_rows:
0071:         out = np.flipud(out)
0072:     return out
0073: 
0074: # --------------- generator (att2) ---------------
0075: 
0076: # Canvas, palette, and orientation sampling knobs.
0077: HEIGHT_RANGE = (5, 11)
0078: WIDTH_RANGE = (6, 11)
0079: AVAILABLE_COLORS = [0, 1, 2, 3, 4, 5, 6, 7, 9]
0080: CORNER_EDGES = ((0, 0), (0, -1), (-1, 0), (-1, -1))
0081: CORNER_FLIPS = ((False, False), (False, True), (True, False), (True, True))
0082: # Rejection budget: oracle check should pass on the first attempt.
0083: MAX_ATTEMPTS = 300
0084: 
0085: def _sample_params() -> tuple[int, int, int, int, int]:
0086:     """Sample dimensions, ordered colors, and one of the four L corners."""
0087:     h = int(np.random.randint(*HEIGHT_RANGE))
0088:     w = int(np.random.randint(*WIDTH_RANGE))
0089:     border_color, fill_color = np.random.choice(AVAILABLE_COLORS, size=2, replace=False)
0090:     corner = int(np.random.randint(len(CORNER_EDGES)))
0091:     return h, w, int(border_color), int(fill_color), corner
0092: 
0093: 
0094: def _paint_corner_l(inp: np.ndarray, border_color: int, corner: int) -> None:
0095:     """Paint the full row and column for the requested corner in-place."""
0096:     edge_r, edge_c = CORNER_EDGES[corner]
0097:     inp[edge_r, :] = border_color
0098:     inp[:, edge_c] = border_color
