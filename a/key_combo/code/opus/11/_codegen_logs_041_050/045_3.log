0059: # Canvas/panel geometry.
0060: CANVAS_SHAPE, PANEL_HEIGHT_BOUNDS, PANEL_WIDTH_BOUNDS, PANEL_COUNT_BOUNDS = (16, 16), (3, 5), (3, 5), (2, 4)
0061: # Mark blob sizing and preferred output coverage.
0062: BLANK_COLOR, MARK_SIZE_VALUES, COVERAGE_MIN, COVERAGE_MAX = 0, range(2, 6), 0.45, 0.80
0063: # Color/placement constraints.
0064: ARC_COLORS, PANEL_BORDER, PANEL_GAP, PADDING_CONNECTIVITY = range(1, 10), 1, 2, 8
0065: # Retry limit and 4-neighbor growth.
0066: MAX_GENERATION_ATTEMPTS, NEIGHBORS4 = 300, ((-1, 0), (1, 0), (0, -1), (0, 1))
0067: 
0068: def _gen_neighbors4(r, c, h, w):
0069:     for dr, dc in NEIGHBORS4:
0070:         rr, cc = r + dr, c + dc
0071:         if 0 <= rr < h and 0 <= cc < w:
0072:             yield rr, cc
0073: 
0074: 
0075: def _gen_size_tuple(h, w, n):
0076:     """Choose per-panel mark sizes near the observed output coverage range."""
0077:     area = h * w
0078:     tuples = [sizes for sizes in itertools.product(MARK_SIZE_VALUES, repeat=n) if sum(sizes) <= area]
0079:     preferred = [sizes for sizes in tuples if COVERAGE_MIN <= sum(sizes) / area <= COVERAGE_MAX]
0080:     if preferred:
0081:         return random.choice(preferred)
0082:     def coverage_distance(sizes):
0083:         coverage = sum(sizes) / area
0084:         return min(abs(coverage - COVERAGE_MIN), abs(coverage - COVERAGE_MAX))
0085: 
0086:     best_distance = min(coverage_distance(sizes) for sizes in tuples)
0087:     closest = [sizes for sizes in tuples if coverage_distance(sizes) == best_distance]
0088:     return random.choice(closest)
0089: 
0090: 
0091: def _gen_blob_cells(h, w, size, occupied):
0092:     """Grow one connected mark inside the panel, avoiding already-used cells."""
0093:     free = [(r, c) for r in range(h) for c in range(w) if (r, c) not in occupied]
0094:     if len(free) < size:
0095:         return None
0096: 
0097:     blob = {random.choice(free)}
0098:     frontier = {
0099:         nbr
0100:         for cell in blob
0101:         for nbr in _gen_neighbors4(*cell, h, w)
0102:         if nbr not in occupied and nbr not in blob
0103:     }
0104:     while len(blob) < size:
0105:         if not frontier:
0106:             return None
0107:         cell = random.choice(tuple(frontier))
0108:         frontier.remove(cell)
0109:         blob.add(cell)
0110:         blocked = occupied | blob
0111:         for nbr in _gen_neighbors4(cell[0], cell[1], h, w):
0112:             if nbr not in blocked:
0113:                 frontier.add(nbr)
0114:     return blob
0115: 
0116: 
0117: def _gen_output_panel(h, w, mark_colors, sizes):
0118:     """Render non-overlapping connected marks, or return None if packing fails."""
0119:     out = np.full((h, w), BLANK_COLOR, dtype=int)
0120:     occupied = set()
0121:     for color, size in zip(mark_colors, sizes):
0122:         cells = _gen_blob_cells(h, w, size, occupied)
0123:         if cells is None:
0124:             return None
0125:         for r, c in cells:
0126:             out[r, c] = color
0127:         occupied.update(cells)
0128:     return out
