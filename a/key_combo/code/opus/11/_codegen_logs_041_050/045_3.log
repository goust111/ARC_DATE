+    glyphs: dict[int, np.ndarray] = {}
+    for depth, (r, c) in enumerate(grey_coords, start=1):
+        assert 1 <= r <= grid.shape[0] - 2, "grey marker must sit on the middle row of a 3x3 glyph"
