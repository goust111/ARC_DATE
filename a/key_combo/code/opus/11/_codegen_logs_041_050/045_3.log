  marker_rows:
    count: 1-5 rows, each containing exactly one blue pixel left of one teal pixel
    segment: cells strictly between blue and teal markers; all segments have equal width (3-7)
    segment_content: only black(0) and red(2), ~30-75% red
    marker_positions: blue col 0-5, teal col 4-10; vary across rows (not fixed columns)
