0008: def main(grid: np.ndarray) -> np.ndarray:
0009:     """
0010:     Extract the horizontal red/black segments bracketed by blue and teal markers, stacking them in marker-row order.
0011: 
0012:     Input structure
0013:     - The grid is a black/red field with blue and teal control pixels.
0014:     - Each marked row has exactly one blue control pixel to the left of exactly one teal control pixel.
0015:     - All marked rows have the same number of cells between the two control pixels.
0016: 
0017:     Rule
0018:     - Read marked rows from top to bottom.
0019:     - For each marked row, copy the cells strictly between the blue and teal markers into the next output row.
0020:     - Drop the marker pixels and all unmarked rows.
0021: 
0022:     Key insight
0023:     - Each blue/teal pair brackets one output row; the puzzle is a compact extraction of those bracketed row segments.
0024:     """
0025:     g = np.asarray(grid, dtype=int)
0026:     assert g.ndim == 2 and g.size > 0, "expected a non-empty 2D grid"
0027: 
0028:     rows = []
0029:     for r in range(g.shape[0]):
0030:         left_cols = np.flatnonzero(g[r] == Color.BLUE)
0031:         right_cols = np.flatnonzero(g[r] == Color.TEAL)
0032:         if len(left_cols) == 0 and len(right_cols) == 0:
0033:             continue
0034: 
0035:         assert len(left_cols) == 1 and len(right_cols) == 1, "each marked row must have one blue and one teal marker"
0036:         left = int(left_cols[0])
0037:         right = int(right_cols[0])
0038:         assert left < right, "blue marker must be left of teal marker"
0039: 
0040:         segment = g[r, left + 1 : right]
0041:         assert segment.size > 0, "marker pair must bracket at least one cell"
0042:         assert not np.isin(segment, [Color.BLUE, Color.TEAL]).any(), "marker colors only delimit segments"
0043:         rows.append(segment.copy())
0044: 
0045:     assert rows, "expected at least one marked row"
0046:     width = int(rows[0].size)
0047:     assert all(int(row.size) == width for row in rows), "all bracketed segments must have equal width"
0048: 
0049:     return np.vstack(rows)
