0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Fill each background chamber with the majority color of the colored marker pixels touching it.
0020: 
0021:     Input structure
0022:     - A 2-D grid has one dominant background color, one wall color, and marker colors.
0023:     - Background pixels form 4-connected chambers separated by wall and marker pixels.
0024:     Rule
0025:     - Infer the background as the unique most frequent color and the wall as the unique most frequent remaining color.
0026:     - For each 4-connected background chamber, collect the distinct orthogonally adjacent marker pixels.
0027:     - Recolor that whole chamber to the unique majority marker color, preserving all non-background pixels.
0028:     Key insight
0029:     - The colored pixels are boundary votes for adjacent empty regions; the grey wall structure only separates the regions.
0030:     """
0031:     g = np.asarray(grid, dtype=int)
0032:     assert g.ndim == 2
0033: 
0034:     flat_counts = Counter(map(int, g.ravel()))
0035:     colors = list(flat_counts)
0036:     bg = _unique_most_common(flat_counts, colors, "background")
0037:     wall = _unique_most_common(flat_counts, [color for color in colors if color != bg], "wall")
0038:     marker_colors = set(colors) - {bg, wall}
0039:     assert marker_colors, "expected marker colors besides background and wall"
0040: 
0041:     out = g.copy()
0042:     height, width = g.shape
0043:     chambers = components_mask(g == bg, connectivity=4)
0044:     assert chambers, "expected at least one background chamber"
0045: 
0046:     for coords in chambers:
0047:         adjacent_markers: dict[tuple[int, int], int] = {}
0048:         for r0, c0 in coords:
0049:             for r, c in neighbors4(int(r0), int(c0)):
0050:                 if 0 <= r < height and 0 <= c < width and int(g[r, c]) in marker_colors:
0051:                     adjacent_markers[(r, c)] = int(g[r, c])
0052:         assert adjacent_markers, "each chamber must touch at least one marker"
0053: 
0054:         marker_counts = Counter(adjacent_markers.values())
0055:         fill = _unique_most_common(marker_counts, list(marker_counts), "majority marker")
0056:         out[coords[:, 0], coords[:, 1]] = fill
0057: 
0058:     return out
