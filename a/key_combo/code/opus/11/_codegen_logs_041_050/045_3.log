0090: def _gen_bounded_composition(n: int, total: int, lo: int, hi: int) -> list[int]:
0091:     parts: list[int] = []
0092:     remaining = total
0093:     for i in range(n):
0094:         left = n - i - 1
0095:         min_here = max(lo, remaining - hi * left)
0096:         max_here = min(hi, remaining - lo * left)
0097:         value = _gen_randint(min_here, max_here)
0098:         parts.append(value)
0099:         remaining -= value
0100:     return parts
0101: 
