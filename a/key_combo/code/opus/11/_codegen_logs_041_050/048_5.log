0274:         rr, cc = r0, c0
0275:     elif anchor == "upperright":
0276:         rr, cc = r0, c1
0277:     elif anchor == "lowerleft":
0278:         rr, cc = r1, c0
0279:     elif anchor == "lowerright":
0280:         rr, cc = r1, c1
0281:     elif anchor == "center":
0282:         rr, cc = r0 + (h - 1) / 2, c0 + (w - 1) / 2
0283:     elif anchor == "uppercenter":
0284:         rr, cc = r0, c0 + (w - 1) / 2
0285:     elif anchor == "lowercenter":
0286:         rr, cc = r1, c0 + (w - 1) / 2
0287:     elif anchor == "leftcenter":
0288:         rr, cc = r0 + (h - 1) / 2, c0
0289:     elif anchor == "rightcenter":
0290:         rr, cc = r0 + (h - 1) / 2, c1
0291:     else:
0292:         raise ValueError("bbox_anchor: invalid anchor")
0293: 
0294:     return int(round(rr)), int(round(cc))
