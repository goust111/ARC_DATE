+        "sides": {"N": (0, 1)},
+    },
+    "end_b": {
+        "size": 3,
+        "cells": [
+            (0, 1, "conn"),
+            (1, 1, "a"),
+            (1, 0, "b"),
+            (2, 0, "c"),
+            (2, 1, "d"),
+        ],
+        "sides": {"N": (0, 1)},
