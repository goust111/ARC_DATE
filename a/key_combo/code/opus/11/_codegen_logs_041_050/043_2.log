+
+BG = 0
+RED = 2
+CORRIDOR_COLORS = (1, 3, 4)
+BODY_COLORS = (5, 6, 7, 8, 9)
+DIRS = {
+    "N": (-1, 0),
+    "E": (0, 1),
+    "S": (1, 0),
+    "W": (0, -1),
+}
+OPPOSITE = {"N": "S", "E": "W", "S": "N", "W": "E"}
+DIR_ORDER = ("N", "E", "S", "W")
+
+
+TEMPLATES = {
+    "end_a": {
+        "size": 3,
+        "cells": [
+            (0, 1, "conn"),
+            (1, 1, "a"),
+            (1, 0, "b"),
+            (2, 1, "c"),
+        ],
+        "sides": {"N": (0, 1)},
+    },
+    "end_b": {
+        "size": 3,
+        "cells": [
+            (0, 1, "conn"),
+            (1, 1, "a"),
+            (1, 0, "b"),
+            (2, 0, "c"),
+            (2, 1, "d"),
+        ],
+        "sides": {"N": (0, 1)},
+    },
+    "straight": {
+        "size": 3,
+        "cells": [
+            (0, 1, "conn0"),
+            (1, 1, "a"),
+            (1, 0, "b"),
+            (1, 2, "c"),
+            (2, 1, "conn1"),
+        ],
+        "sides": {"N": (0, 1), "S": (2, 1)},
+    },
+    "elbow": {
+        "size": 3,
+        "cells": [
+            (0, 1, "conn0"),
+            (1, 1, "a"),
+            (1, 0, "b"),
+            (1, 2, "conn1"),
+            (2, 1, "c"),
+        ],
+        "sides": {"N": (0, 1), "E": (1, 2)},
+    },
