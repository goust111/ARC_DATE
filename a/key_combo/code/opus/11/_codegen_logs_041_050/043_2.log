+        "sides": {"N": (0, 1), "S": (2, 1)},
+    },
+    "elbow": {
+        "size": 3,
+        "cells": [
+            (0, 1, "conn0"),
+            (1, 1, "a"),
+            (1, 0, "b"),
+            (1, 2, "conn1"),
+            (2, 1, "c"),
