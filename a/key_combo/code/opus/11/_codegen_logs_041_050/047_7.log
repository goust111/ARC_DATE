+        count_options = [2]
+        if (
+            placeholder_mask.shape[0] <= 3
+            and placeholder_mask.shape[1] <= 3
+            and distractor_mask.shape[0] <= 3
+            and distractor_mask.shape[1] <= 3
+        ):
+            count_options.append(3)
+        rng.shuffle(count_options)
