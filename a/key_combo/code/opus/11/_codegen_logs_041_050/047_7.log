+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    box = _bbox(mask)
+    if box is None:
+        return np.zeros((0, 0), dtype=bool)
+    r0, c0, r1, c1 = box
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            rows = [p[0] for p in coords]
+            cols = [p[1] for p in coords]
+            r0, r1 = min(rows), max(rows)
+            c0, c1 = min(cols), max(cols)
+            crop = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in coords:
+                crop[rr - r0, cc - c0] = True
+            out.append(
+                {
+                    "coords": coords,
+                    "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                    "mask": crop,
+                    "area": len(coords),
+                }
+            )
+    return out
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    comps = _components(mask)
+    return len(comps) == 1
+
+
+def _mask_signature(mask: np.ndarray) -> tuple[tuple[int, int], tuple[int, ...]]:
+    m = np.asarray(mask, dtype=bool)
+    return m.shape, tuple(int(v) for v in m.reshape(-1))
+
+
+def _interior_mask(shape: tuple[int, int], box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    assert r1 - r0 + 1 >= 4 and c1 - c0 + 1 >= 4
+    out = np.zeros(shape, dtype=bool)
+    out[r0 + 1 : r1, c0 + 1 : c1] = True
+    return out
+
+
+def _paint_mask(grid: np.ndarray, mask: np.ndarray, top: int, left: int, color: int) -> None:
+    h, w = mask.shape
+    patch = grid[top : top + h, left : left + w]
+    patch[mask] = int(color)
