+        "sep": sep,
+        "left": left,
+        "right": right,
+        "a_box": a_box,
+        "b_box": b_box,
+        "a_inner_crop": _crop_mask(a_inner),
+        "b_inner_crop": _crop_mask(b_inner),
+        "stamp": stamp,
+        "yellow_components": yellow_components,
+        "matching_count": len(transformed),
+        "yellow_classes": classes,
+    }
+
