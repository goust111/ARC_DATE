+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+GREY = 5
+PINK = 6
+
+SEPARATOR_COLUMN = 8
+GRID_WIDTH = 18
+LEFT_WIDTH = 8
+RIGHT_WIDTH = 9
+
+GEN_HEIGHT_RANGE = (11, 17)
+GEN_ATTEMPTS = 600
+RECT_ATTEMPTS = 300
+PLACE_ATTEMPTS = 120
