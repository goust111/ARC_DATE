+    for mask, (r, c) in zip(masks, positions):
+        _paint_mask(grid[:, SEPARATOR_COLUMN + 1 :], mask, r, c, YELLOW)
+    return grid
+
+
+def _validate_generation(grid: np.ndarray) -> bool:
