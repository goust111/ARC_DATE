+def _mark_blocked(mask: np.ndarray, top: int, left: int, blocked: np.ndarray) -> None:
+    h, w = blocked.shape
+    for r, c in np.argwhere(mask):
+        rr = int(top + r)
+        cc = int(left + c)
+        blocked[rr, cc] = True
+        for nr, nc in _neighbors8(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w:
