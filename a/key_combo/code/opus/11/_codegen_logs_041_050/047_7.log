+def _can_place(mask: np.ndarray, top: int, left: int, blocked: np.ndarray) -> bool:
+    h, w = mask.shape
+    coords = np.argwhere(mask)
+    for r, c in coords:
+        rr = int(top + r)
+        cc = int(left + c)
+        if blocked[rr, cc]:
+            return False
+    return True
