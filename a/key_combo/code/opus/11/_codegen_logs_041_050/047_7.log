+    assert np.any(left[ar0, ac0 : ac1 + 1] == RED)
+    assert np.any(left[ar1, ac0 : ac1 + 1] == RED)
+    assert np.any(left[ar0 : ar1 + 1, ac0] == RED)
+    assert np.any(left[ar0 : ar1 + 1, ac1] == RED)
