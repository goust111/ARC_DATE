+        left = np.zeros((height, LEFT_WIDTH), dtype=int)
+        left[a_box[0] : a_box[2] + 1, a_box[1] : a_box[3] + 1] = RED
+        left[b_box[0] : b_box[2] + 1, b_box[1] : b_box[3] + 1] = BLUE
