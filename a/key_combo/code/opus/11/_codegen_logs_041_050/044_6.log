```yaml
spec:
  grid: 10x10, background 0 [observed]
  objects: exactly 2 hollow rectangular frames, each a different non-zero color
  frame_structure:
    border: 1-cell-thick rectangle of a single color
    interior: filled with background color
    dimensions: 3-10 rows x 3-10 cols per frame
    interior_areas: must differ (unique largest)
  placement:
    frames do not overlap or touch (min Manhattan distance between any two frame cells >= 2)
    both frames fit within the grid
  output: 2x2 grid filled with the color of the frame whose interior area is strictly larger

generation_strategy:
