def _gen_pick_sum_pair(lo, hi, max_sum):
    total = random.randint(2 * lo, max_sum)
    a_min = max(lo, total - hi)
    a_max = min(hi, total - lo)
    a = random.randint(a_min, a_max)
    if random.random() < 0.5:
        return a, total - a
    return total - a, a

