    left = corner[1] == "L"
    inside = (mr0 if top else mr1, mc0 if left else mc1)
    outside_row = (mr0 - 1 if top else mr1 + 1, c1 if left else c0)
    outside_col = (r1 if top else r0, mc0 - 1 if left else mc1 + 1)
