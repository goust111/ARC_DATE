  "type": "move_to_match",
  "src": "unique teal 3x3 symbol slot s in the separated table",
  "dst": "all 3x3 symbol slots d in the table",
  "match_cond": "d.mask == s.mask",
  "transform": "recolor every matching d teal; recolor nonmatching symbol slots strictly between consecutive matching slots in the same row or column orange"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: always 17x25 (4 row-slots x 6 col-slots of 3x3 cells, separated by 1px black grid lines)
  background: black (0); all row/col separator lines are background
  slots:
    count: 24 (4x6), every slot occupied with a monochromatic symbol mask
    colors_in_input: exactly one slot is teal (8); all others are blue (1)
    mask_pixels: 1-9 per slot (no empty slots)
    distinct_shapes: 4-6 unique 3x3 binary masks across all 24 slots [observed]
    connectivity: masks need not be 4-connected
  prototype:
    definition: the unique teal slot's 3x3 binary mask
    pixel_count: 4-8
    copies: 3-6 total slots share the prototype mask (including the teal one); the rest are blue in input
  output_transform:
    matching_slots: recolored teal (8), preserving mask shape
    connector_slots: non-matching slots strictly between consecutive matching slots in same row or column recolored orange (7)
    all_others: unchanged (remain blue)
  constraints:
    at_least_one_row_or_col_has_>=2_matching_slots: guarantees connectors >= 1
    connectors_observed: 3-10

generation_strategy:
  approach: output-first
  steps:
    1. Fix grid 17x25 (4x6 table with 1px black separators).
    2. Generate 4-6 distinct 3x3 binary masks (each with 1-9 pixels, no all-zero). Designate one as the prototype (4-8 pixels).
    3. Choose 3-6 slot positions for prototype placement; ensure >=2 share a row or column (so connectors exist). Place prototype mask at those positions.
    4. Fill remaining 18-21 slots with randomly chosen non-prototype masks (from the other distinct shapes).
    5. Color exactly one prototype slot teal; color all other slots blue. This is the input.
    6. Output: recolor all prototype-mask slots teal; recolor non-matching slots between consecutive same-row/col matching pairs orange; leave rest blue.
