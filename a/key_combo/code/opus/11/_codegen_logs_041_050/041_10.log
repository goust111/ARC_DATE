+    seen = {(ar, ac)}
+    queue = deque([(ar, ac)])
+    cells: list[tuple[int, int]] = []
+    while queue:
+        r, c = queue.popleft()
+        cells.append((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if not _in_bounds(grid.shape, nr, nc):
