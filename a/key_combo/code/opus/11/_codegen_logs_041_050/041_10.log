+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in cells:
+        patch[r - r0, c - c0] = int(grid[r, c])
