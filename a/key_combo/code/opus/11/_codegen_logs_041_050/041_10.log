+def _generate_target_one() -> np.ndarray | None:
+    h = random.randint(*GRID_SIZE_RANGE)
+    w = random.randint(*GRID_SIZE_RANGE)
+    red = (random.randint(4, 8), random.randint(w - 9, w - 5))
