+def _maybe_reflect(grid: np.ndarray) -> np.ndarray:
+    out = grid
+    if random.choice((False, True)):
+        out = _flip_lr(out)
+    if random.choice((False, True)):
+        out = _flip_ud(out)
+    return out.copy()
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
