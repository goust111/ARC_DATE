    def search(i: int) -> bool:
        if i == len(sizes):
            return True
        h, w = sizes[i]
        positions = [
            (r, c)
            for r in range(_GEN_LOOP_MARGIN, _GEN_H - h - _GEN_LOOP_MARGIN + 1)
            for c in range(_GEN_LOOP_MARGIN, _GEN_W - w - _GEN_LOOP_MARGIN + 1)
