+            col_counts[int(c)] = col_counts.get(int(c), 0) + 1
+        best_row, best_row_count = max(row_counts.items(), key=lambda x: x[1])
+        best_col, best_col_count = max(col_counts.items(), key=lambda x: x[1])
+        if best_row_count >= best_col_count:
