+            patch = local != BLACK
+            canvas[top : top + sh, left : left + sw][patch] = local[patch]
+            occupied[top : top + sh, left : left + sw] |= patch
+            placements.append((top, left, local))
+            success = True
+            break
+        if not success:
+            return None
+    return placements
