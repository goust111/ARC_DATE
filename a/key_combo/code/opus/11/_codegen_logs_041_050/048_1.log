+def transform(grid: np.ndarray, *, do_dock: bool = True, do_mirror: bool = True) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    structures = detect_structures(g)
+    reds, assignments, _ = compute_assignments(g, structures)
+
+    out = g.copy()
+    out[out == RED] = BLACK
