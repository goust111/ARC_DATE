+        if len(candidates) == 1:
+            sid, cid, shift = candidates[0]
+            if (sid, cid) in used_slots:
+                continue
+            assignments.append((rid, sid, cid, shift))
+            matched_reds.add(rid)
+            used_slots.add((sid, cid))
