+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+
+
+@dataclass(frozen=True)
+class BBox:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def height(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def width(self) -> int:
+        return self.c1 - self.c0 + 1
+
+
+@dataclass
+class Structure:
+    bbox: BBox
+    orient: str
+    axis: int
+    source_sign: int
+    cavities: list[tuple[np.ndarray, BBox]]
+
+
+@dataclass
