+@dataclass(frozen=True)
+class BBox:
+    r0: int
+    c0: int
+    r1: int
+    c1: int
+
+    @property
+    def height(self) -> int:
+        return self.r1 - self.r0 + 1
+
+    @property
+    def width(self) -> int:
+        return self.c1 - self.c0 + 1
+
