+                else:
+                    target_rows = range(b.r0, struct.axis)
+                for r in target_rows:
+                    src_r = 2 * struct.axis - r
+                    for c in range(b.c0, b.c1 + 1):
+                        src = int(out[src_r, c])
+                        if src != YELLOW and out[r, c] != YELLOW:
