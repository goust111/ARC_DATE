+        for cid, (cavity_coords, cavity_bbox) in enumerate(struct.cavities):
+            if struct.orient == "v":
+                if not interval_overlap(red.bbox.r0, red.bbox.r1, cavity_bbox.r0, cavity_bbox.r1):
