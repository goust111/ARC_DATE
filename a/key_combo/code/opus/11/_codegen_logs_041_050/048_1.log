+def structure_move(struct: Structure) -> tuple[int, int]:
+    if struct.orient == "v":
+        return (0, -struct.source_sign)
+    return (-struct.source_sign, 0)
+
+
+def place_matched_reds(canvas: np.ndarray, matched_sids: set[int], rng: np.random.Generator) -> bool:
