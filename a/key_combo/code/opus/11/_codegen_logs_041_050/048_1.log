+def rotate_shape(shape: np.ndarray, k: int) -> np.ndarray:
+    pts = shape.copy()
+    for _ in range(k % 4):
+        pts = np.stack([pts[:, 1], -pts[:, 0]], axis=1)
+    pts -= pts.min(axis=0)
+    return pts
