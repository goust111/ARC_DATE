+VERTICAL_ONE = ((1, 2), (2, 2), (3, 2))
+HORIZONTAL_ONE = ((2, 1), (2, 2), (2, 3))
+DISTRACTOR_SHAPES = (
+    np.array([(0, 0), (0, 1)], dtype=int),
+    np.array([(0, 0), (1, 0)], dtype=int),
+    np.array([(0, 0), (0, 1), (1, 0)], dtype=int),
+    np.array([(0, 0), (0, 1), (1, 1)], dtype=int),
