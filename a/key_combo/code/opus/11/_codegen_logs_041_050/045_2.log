+def _find_objects(grid: np.ndarray, sep_row: int) -> list[dict]:
+    upper = np.asarray(grid[:sep_row, :], dtype=int)
+    seen = np.zeros_like(upper, dtype=bool)
+    objects: list[dict] = []
+    h, w = upper.shape
+    for r in range(h):
