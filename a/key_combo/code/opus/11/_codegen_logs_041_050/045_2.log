+        yield r + dr, c + dc
+
+
+def _is_connected(mask: np.ndarray) -> bool:
+    cells = np.argwhere(mask)
+    if len(cells) == 0:
+        return False
+    start = tuple(map(int, cells[0]))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < mask.shape[0] and 0 <= nc < mask.shape[1] and mask[nr, nc] and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
