+_COUNT_OPTIONS = [(2, 3), (3, 2), (2, 4), (4, 2), (3, 4), (4, 3)]
+_MODE_WEIGHTS = [("any", 2), ("v_obstacle", 1), ("h_obstacle", 1)]
