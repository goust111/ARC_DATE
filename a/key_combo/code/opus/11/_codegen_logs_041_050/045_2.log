+    for i in range(n_horizontal):
+        out[sep + 1 + i, right_c0 + i] = BLUE
+
+    if with_meta:
+        return out, {
+            "sep": sep,
+            "objects": objects,
+            "n_vertical": n_vertical,
+            "n_horizontal": n_horizontal,
+            "movement": movement_meta,
