+
+def _random_symmetric_mask(kind: str) -> np.ndarray | None:
+    for _ in range(300):
+        h = random.randint(2, 4)
+        w = random.randint(2, 5)
+        raw = np.zeros((h, w), dtype=bool)
+        if kind == "vertical":
+            half = (w + 1) // 2
+            p = random.uniform(0.35, 0.7)
+            for r in range(h):
+                for c in range(half):
+                    if random.random() < p:
+                        raw[r, c] = True
+                        raw[r, w - 1 - c] = True
+        else:
+            half = (h + 1) // 2
+            p = random.uniform(0.35, 0.7)
+            for r in range(half):
+                for c in range(w):
+                    if random.random() < p:
+                        raw[r, c] = True
+                        raw[h - 1 - r, c] = True
+        if not raw.any():
+            continue
+        mask = _crop_mask(raw)
+        area = int(mask.sum())
+        if not (3 <= area <= 6):
+            continue
+        if not _is_connected(mask):
+            continue
+        vertical = bool(np.array_equal(mask, np.fliplr(mask)))
+        horizontal = bool(np.array_equal(mask, np.flipud(mask)))
+        if kind == "vertical" and not (vertical and not horizontal):
+            continue
+        if kind == "horizontal" and not (horizontal and not vertical):
+            continue
+        return mask
+    return None
