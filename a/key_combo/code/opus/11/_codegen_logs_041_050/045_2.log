+    return _solve(grid)
+
+
+def _random_symmetric_mask(kind: str) -> np.ndarray | None:
+    for _ in range(300):
+        h = random.randint(2, 4)
+        w = random.randint(2, 5)
+        raw = np.zeros((h, w), dtype=bool)
+        if kind == "vertical":
+            half = (w + 1) // 2
+            p = random.uniform(0.35, 0.7)
+            for r in range(h):
+                for c in range(half):
+                    if random.random() < p:
+                        raw[r, c] = True
+                        raw[r, w - 1 - c] = True
+        else:
+            half = (h + 1) // 2
+            p = random.uniform(0.35, 0.7)
+            for r in range(half):
+                for c in range(w):
