+def _solve(grid: np.ndarray, *, with_meta: bool = False):
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    sep_candidates = [r for r in range(g.shape[0]) if np.all(g[r, :] == GREY)]
