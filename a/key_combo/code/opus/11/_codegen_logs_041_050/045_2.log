+    kinds = [obj["kind"] for obj in objects]
+    n_vertical = sum(kind == "vertical" for kind in kinds)
+    n_horizontal = sum(kind == "horizontal" for kind in kinds)
+    assert 2 <= n_vertical <= 4 and 2 <= n_horizontal <= 4 and n_vertical != n_horizontal
