+    h, w = mask.shape
+    rel = _rel_coords(mask)
+    options: list[tuple[int, int]] = []
+    for r0 in range(sep - h + 1):
+        for c0 in range(blocked.shape[1] - w + 1):
+            ok = True
+            for rr, cc in rel:
+                ar, ac = r0 + rr, c0 + cc
+                if blocked[ar, ac]:
+                    ok = False
+                    break
+            if ok:
+                options.append((int(r0), int(c0)))
+    return options
