+            if color in (BG, GREY) or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((int(cr), int(cc)))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(upper[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
