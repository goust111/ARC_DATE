+        ar, ac = int(r0 + rr), int(c0 + cc)
+        for dr, dc in _DIR8 + [(0, 0)]:
+            nr, nc = ar + dr, ac + dc
+            if 0 <= nr < blocked.shape[0] and 0 <= nc < blocked.shape[1]:
+                blocked[nr, nc] = True
+
