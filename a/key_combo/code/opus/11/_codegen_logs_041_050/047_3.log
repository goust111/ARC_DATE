+def _parse_frames(grid: np.ndarray, divider_c: int, panel_shape: tuple[int, int]) -> list[dict]:
+    right = grid[:, divider_c + 1 :]
+    frame_comps = _component_cells(right == BLUE)
+    frames: list[dict] = []
+    for coords in frame_comps:
+        r0, c0, r1, c1 = bbox_coords(coords)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
