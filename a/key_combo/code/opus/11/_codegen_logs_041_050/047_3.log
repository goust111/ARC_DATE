  "dst": "next panel in the sequence",
  "transform": "continue the visible per-frame rule one step: translate a moving sprite by the same offset, extend a growing mask by the same shifted increment, or recolor the next foreground columns of a fixed mask while preserving background holes",
  "grid_shape": "same shape as one panel"
}
</annotation>
<generation_spec>
