+        sub = right[r0 : r1 + 1, c0 : c1 + 1]
+        border = np.zeros_like(sub, dtype=bool)
+        border[0, :] = True
+        border[-1, :] = True
+        border[:, 0] = True
+        border[:, -1] = True
+        if not np.all(sub[border] == BLUE):
+            continue
+        if np.any(sub[~border] == BLUE):
+            continue
+        interior = sub[1:-1, 1:-1]
+        if interior.shape != panel_shape:
+            continue
