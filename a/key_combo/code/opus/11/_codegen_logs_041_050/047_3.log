        fc = frame_colors[idx]
        expected[rr:rr + frame_size, cc:cc + frame_size] = fc
        content = sprite_by_k[k].copy()
        content[content == BG] = fc
        expected[rr + 1:rr + 1 + sprite_size, cc + 1:cc + 1 + sprite_size] = content
    return expected


