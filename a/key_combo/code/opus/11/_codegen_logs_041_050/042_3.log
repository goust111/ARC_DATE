+SHAPE_LIBRARY = {
+    "tri_l": np.array(
+        [
+            [1, 0],
+            [1, 1],
+        ],
+        dtype=bool,
+    ),
+    "tet_l": np.array(
+        [
+            [1, 0],
+            [1, 0],
+            [1, 1],
+        ],
+        dtype=bool,
+    ),
+    "pent_p": np.array(
+        [
+            [1, 1],
+            [1, 1],
+            [1, 0],
+        ],
+        dtype=bool,
+    ),
