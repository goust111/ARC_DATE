+                if 0 <= nr < h and 0 <= nc < w:
+                    expanded.add((nr, nc))
+    return expanded
+
+
+def _mask_cells(mask: np.ndarray, top: int, left: int) -> set[tuple[int, int]]:
+    return {
+        (top + int(r), left + int(c))
