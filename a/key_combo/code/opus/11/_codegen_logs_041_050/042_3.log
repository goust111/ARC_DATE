+BLACK = 0
+GREY = 5
+SEPARATOR_ROW = 12
+STAMP_ROW = 14
+INPUT_HEIGHT = 18
+WIDTH_RANGE = (18, 22)
+OBJECT_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+PARTITIONS = [
+    (3, 3),
+    (2, 2, 2),
+    (2, 2, 3),
+    (2, 3, 3),
+]
