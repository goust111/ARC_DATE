+    components = _extract_components(g)
+    groups = _group_components(components, include_flips=include_flips)
+    if not groups:
+        out = np.full_like(g, BLACK)
+        out[SEPARATOR_ROW, :] = GREY
+        return out, groups, []
+
+    out = np.full_like(g, BLACK)
+    out[SEPARATOR_ROW, :] = GREY
