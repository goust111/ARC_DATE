+                }
+            )
+
+    expected, planned_placements = _expected_from_plan(width, groups_plan)
+    actual, groups, placement_info = _solve(grid, include_flips=True)
+    if not np.array_equal(actual, expected):
+        return None
+
+    if len(groups) != len(partition):
