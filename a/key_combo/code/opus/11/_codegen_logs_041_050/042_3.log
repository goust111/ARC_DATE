+            return None
+        rep_top, rep_left = rep_loc
+        group["placed_members"].append(
+            {
+                "color": rep_color,
+                "mask": rep_mask.copy(),
+                "bbox": (rep_top, rep_left, rep_top + rep_mask.shape[0] - 1, rep_left + rep_mask.shape[1] - 1),
