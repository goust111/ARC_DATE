  "type": "symmetry/pattern",
  "src": "the top-left horizontal foreground bar; its length n controls the run pattern",
  "transform": "replace the grid with foreground runs of lengths 1, 2, ..., n, n-1, ..., 2, 1 separated by one background pixel and wrapped row-major across the input width",
  "grid_shape": "input width, minimum height needed for the wrapped sequence"
}
</annotation>
<generation_spec>
```yaml
spec:
  background: 0
  foreground: one non-zero color (any from 1-9)
  input_grid:
    width: 5-23
    height: 7-13, must be >= ceil(seq_len / width) where seq_len = n^2 + 2n - 2
    content: all background except a contiguous horizontal bar of fg color in row 0
  bar:
    position: row 0, columns 0..n-1 (left-aligned)
    length_n: 3-8, must be < width
  output_grid:
    width: same as input
    height: ceil(seq_len / width), may differ from input height
    content: |
      1D sequence of fg runs with lengths 1, 2, ..., n, n-1, ..., 2, 1
      separated by single bg pixels, wrapped row-major into rows of input width,
      last row padded with bg

generation_strategy:
  approach: direct construction (no inversion needed; transformation is deterministic)
  steps:
    - pick fg color from 1-9
    - pick n in 3-8
    - compute seq_len = n^2 + 2n - 2
    - pick width in range max(n+2, 5)..23
    - pick h_in in range ceil(seq_len/width)..13
    - build input grid h_in x width, all bg, fill row 0 cols 0..n-1 with fg
```
