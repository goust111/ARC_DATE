  37:     assert np.all(coords[:, 0] == 0), "foreground bar must be in the top row"
  38:     cols = np.sort(coords[:, 1])
  39:     n = int(len(cols))
  40:     assert np.array_equal(cols, np.arange(n)), "foreground bar must start at the left edge and be contiguous"
