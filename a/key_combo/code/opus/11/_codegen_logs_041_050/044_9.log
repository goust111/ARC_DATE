+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    grey_comps = _components_of_color(g, Color.GREY)
+    red_comps = _components_of_color(g, Color.RED)
+    blue_comps = _components_of_color(g, Color.BLUE)
