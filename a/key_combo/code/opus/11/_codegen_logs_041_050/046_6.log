+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+ARRAY_N = 3
+TILE_SIZE = 4
+SEP = 1
+FRAME_SIZE = ARRAY_N * TILE_SIZE + (ARRAY_N + 1) * SEP  # 16
+LOCAL_CENTER = (1, 1)
+MAX_GEN_ATTEMPTS = 300
+
