            if not _paint_rect_covering_col(grid, control_cols[idx], control_colors[idx]):
                return False

        if not has_diff:
            idx = random.randrange(len(control_cols))
            diff_choices = [c for c in non_bg_colors if c != control_colors[idx]]
            if not diff_choices:
