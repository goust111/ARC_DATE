GEN_SEPARATOR_WIDTH = 1
GEN_BG, GEN_COLOR_COUNT = 0, 10
GEN_FG_COLORS = [c for c in range(GEN_COLOR_COUNT) if c != GEN_BG]
# Tile subset sampling.
GEN_PRESENT_RATIO_MIN, GEN_PRESENT_RATIO_MAX = 0.4, 0.6
# Oracle validation.
