+        3: [{"template": "single23", "areas": [3], "decoys": [None]}],
+        4: [
+            {"template": "single22", "areas": [4], "decoys": [None]},
+            {"template": "double22", "areas": [2, 2], "decoys": [None, None]},
+        ],
+        5: [
+            {"template": "single22", "areas": [2], "decoys": [None]},
+            {"template": "single23", "areas": [3], "decoys": [None]},
