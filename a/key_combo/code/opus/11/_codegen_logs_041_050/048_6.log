+def _red_components(grid: np.ndarray):
+    comps = _components_mask(grid == RED)
+    by_cell: dict[tuple[int, int], int] = {}
+    result = []
+    for rid, coords in enumerate(comps):
+        bbox = _bbox(coords)
+        cells = {(int(r), int(c)) for r, c in coords}
+        for cell in cells:
