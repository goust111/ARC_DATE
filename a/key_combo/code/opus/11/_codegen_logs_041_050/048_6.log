+def _shift_cells(cells: list[tuple[int, int]] | set[tuple[int, int]], dr: int, dc: int):
+    return [(r + dr, c + dc) for r, c in cells]
+
+
+def _fits_empty(grid: np.ndarray, cells: list[tuple[int, int]]) -> bool:
