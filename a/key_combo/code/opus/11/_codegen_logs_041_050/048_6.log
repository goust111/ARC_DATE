+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR_TO_SIDE = {(-1, 0): "top", (1, 0): "bottom", (0, -1): "left", (0, 1): "right"}
+SIDE_TO_DIR = {v: k for k, v in DIR_TO_SIDE.items()}
