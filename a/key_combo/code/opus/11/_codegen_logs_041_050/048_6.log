+
+
+def _region_slots(region: tuple[int, int, int, int], n_structs: int):
+    r0, c0, r1, c1 = region
+    if n_structs == 1:
+        return [region], [None]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h >= w:
+        mid = (r0 + r1) // 2
+        return [(r0, c0, mid - 1, c1), (mid + 1, c0, r1, c1)], [(-1, 0), (1, 0)]
+    mid = (c0 + c1) // 2
+    return [(r0, c0, r1, mid - 1), (r0, mid + 1, r1, c1)], [(0, -1), (0, 1)]
+
+
+def _render_attempt(rng: random.Random):
