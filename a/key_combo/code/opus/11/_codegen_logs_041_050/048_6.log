+            sockets.append(
+                {
+                    "bbox": (r0 + br0, c0 + bc0, r0 + br1, c0 + bc1),
+                    "open_dir": SIDE_TO_DIR[touched[0]],
+                }
+            )
+        structures.append({"bbox": (r0, c0, r1, c1), "coords": coords, "sockets": sockets})
+    return structures
