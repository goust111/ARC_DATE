+    elif layout == "3v":
+        h = rng.randint(17, 22)
+        widths = [9, 9, rng.randint(9, 10)]
+        rng.shuffle(widths)
+        w = sum(widths) + 2
+        c1 = widths[0]
+        c2 = widths[0] + 1 + widths[1]
