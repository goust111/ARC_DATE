+
+    solved = main(grid)
+    if np.count_nonzero(solved == ORANGE) != min(out_counts):
+        return False
+    if np.count_nonzero(solved == TEAL) != max(out_counts):
+        return False
+    if not np.any(grid == RED):
+        return False
+    if not np.any(grid == GREY):
+        return False
+    return True
