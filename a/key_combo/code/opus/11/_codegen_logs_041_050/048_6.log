+        ac_max = c1 - bc1
+        if ar_min > ar_max or ac_min > ac_max:
+            continue
+        anchors = [(ar, ac) for ar in range(ar_min, ar_max + 1) for ac in range(ac_min, ac_max + 1)]
+        rng.shuffle(anchors)
