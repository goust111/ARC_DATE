+    blue = {(r, c) for r, c in np.argwhere(patch == 1)}
+    selected = []
+    extra = []
+    for sock_bbox, area, decoy_area in zip(rot_sockets, areas, decoys):
+        sr0, sc0, sr1, sc1 = sock_bbox
+        sh = sr1 - sr0 + 1
+        sw = sc1 - sc0 + 1
+        ph, pw = _shape_dims_for_area((sh, sw), open_dir, area)
+        gap1 = rng.randint(1, 2)
