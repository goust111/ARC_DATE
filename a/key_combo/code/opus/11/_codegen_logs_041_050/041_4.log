+        poses: list[tuple[int, int]] = []
+        while len(poses) < 3:
+            r0 = rng.randint(row_lo, row_hi)
+            c0 = rng.randint(col_lo, col_hi)
+            rect = (r0, c0, r0 + BLOCK_SIZE - 1, c0 + BLOCK_SIZE - 1)
