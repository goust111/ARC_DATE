+        elif mode == "original":
+            hole_mask = sprite_mask
+        elif mode == "mirrored":
+            hole_mask = np.fliplr(sprite_mask)
+        elif mode == "symmetric":
+            hole_mask = sprite_mask ^ np.fliplr(sprite_mask)
+        elif mode == "none":
+            hole_mask = np.zeros_like(sprite_mask, dtype=bool)
+        else:
+            raise ValueError(f"unknown mode: {mode}")
