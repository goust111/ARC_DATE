+    Key insight:
+    - The hole stencil is not the sprite itself but the one-sided mismatch between the sprite and its own horizontal reflection.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    entries = _analyze_grid(g)
+    for entry in entries:
