+        sprite = entry["sprite"]  # type: ignore[assignment]
+        color = int(entry["color"])  # type: ignore[arg-type]
+        block_bbox = block["bbox"]
+        sprite_bbox = sprite["bbox"]
+        sprite_mask = np.array(sprite["mask"], dtype=bool, copy=True)
