+def _sample_block_positions(h: int, w: int, rng: random.Random) -> list[tuple[int, int]]:
+    row_lo = h // 2
+    row_hi = h - BLOCK_SIZE - 1
+    col_lo = 1
+    col_hi = w - BLOCK_SIZE - 1
