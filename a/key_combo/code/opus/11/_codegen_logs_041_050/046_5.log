+    object_specs = []
+    for idx, role in enumerate(roles):
+        colors = _object_role_colors(targets, role, idx)
+        area = random.randint(4, 8)
+        if request_overlap and role.startswith("one_target_") and not any(spec["overlap"] for spec in object_specs):
