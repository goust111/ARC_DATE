+
+def _extract_target_colors(grid: np.ndarray) -> tuple[int, int]:
+    legend = grid[:4, :4]
+    assert legend.shape == (4, 4)
+    border_mask = np.zeros((4, 4), dtype=bool)
+    border_mask[0, :] = True
+    border_mask[-1, :] = True
+    border_mask[:, 0] = True
+    border_mask[:, -1] = True
+    assert np.all(legend[border_mask] == FILL), "legend border must be magenta"
