+    info = _analyze(grid)
+    if len(info["components"]) != survivor_count + deleted_count:
+        return None
+    if len(info["kept"]) != survivor_count or len(info["deleted"]) != deleted_count:
+        return None
+    if survivor_count > min(h, w) // 2:
+        return None
+
+    _check_generated_input(grid, request_overlap)
+    return grid
+
