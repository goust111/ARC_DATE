def _gen_patch_variants(patch):
    variants = []
    seen = set()
    for k in range(4):
        rotated = np.rot90(patch, k)
        for variant in (rotated, np.fliplr(rotated)):
            key = tuple(map(tuple, variant.astype(int)))
            if key not in seen:
