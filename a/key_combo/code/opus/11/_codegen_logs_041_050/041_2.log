+            stack = [(r, c)]
+            seen[r, c] = True
+            touches_border = False
+            while stack:
+                rr, cc = stack.pop()
+                if rr == 0 or cc == 0 or rr == h - 1 or cc == w - 1:
+                    touches_border = True
+                for dr, dc in _neighbors(4):
+                    nr = rr + dr
+                    nc = cc + dc
