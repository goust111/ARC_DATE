def map_idx(i, side, n):
    return (i*(side-1))//(n-1)

def arm_cells(k):
    side=2*k-1
    cells=[]
    # all blue cells from four rotated corner Ls
    for c in range(k):
        cells.append((0,c))
        cells.append((0,side-1-c))
        cells.append((side-1,c))
        cells.append((side-1,side-1-c))
    for r in range(k):
        cells.append((r,0))
        cells.append((r,side-1))
        cells.append((side-1-r,0))
        cells.append((side-1-r,side-1))
    return sorted(set(cells))

def input_l_cells(n,k,corner):
