+def _corner_l_cells(side: int, k: int, corner: str) -> set[tuple[int, int]]:
+    vertex, directions = _corner_spec(corner, side)
+    cells = set()
+    for dr, dc in directions:
+        for step in range(k):
+            cells.add((vertex[0] + dr * step, vertex[1] + dc * step))
+    return cells
