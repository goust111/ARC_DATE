from collections import defaultdict

def map_idx(i, side, n):
    return (i*(side-1))//(n-1)

def input_l_cells(n,k,corner):
    top,left=corner
    row=0 if top else n-1
    col=0 if left else n-1
    row_cols=range(0,k) if left else range(n-k,n)
    col_rows=range(0,k) if top else range(n-k,n)
    return {(row,c) for c in row_cols}|{(r,col) for r in col_rows}

def arm_lists(side,k,corner):
    if corner==(True,True):
        v=(0,0); dirs=[(0,1),(1,0)]
    elif corner==(True,False):
        v=(0,side-1); dirs=[(0,-1),(1,0)]
    elif corner==(False,True):
        v=(side-1,0); dirs=[(-1,0),(0,1)]
    else:
        v=(side-1,side-1); dirs=[(-1,0),(0,-1)]
    arms=[]
    for d in dirs:
        arm=[]
        for t in range(k):
            arm.append((v[0]+d[0]*t,v[1]+d[1]*t))
        arms.append(tuple(arm))
    return arms

def rot(side,p):
    r,c=p; return (c, side-1-r)

for k in [3,4,5]:
  side=2*k-1
  for n in range(max(5,k+1), side+1):
    top,left=True,True
    L=input_l_cells(n,k,(top,left))
    arms=arm_lists(side,k,(top,left))
    all_arms=[]
    cur=arms
    for _ in range(4):
      all_arms.extend(cur)
      cur=[tuple(rot(side,p) for p in arm) for arm in cur]
    arm_set=set(p for arm in all_arms for p in arm)
    cands=[]
    for r in range(n):
      for c in range(n):
        if (r,c) in L or (r,c) in [(0,0),(0,n-1),(n-1,0),(n-1,n-1)]:
          continue
        out=(map_idx(r,side,n),map_idx(c,side,n))
        if out in arm_set:
          cands.append(((r,c),out))
    print('k',k,'n',n,'cands',len(cands),'mapped',len(set(o for _,o in cands)),'midpoints',[o for _,o in cands if o in {(0,k-1),(k-1,0),(k-1,side-1),(side-1,k-1)}][:4])
