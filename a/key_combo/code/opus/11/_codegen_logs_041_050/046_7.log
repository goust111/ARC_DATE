+    if not candidates:
+        return None
+    shared = [cand for cand in candidates if len(cand["hits"]) == 2]
+    for _ in range(200):
+        count = random.choices((1, 2, 3), weights=(3, 4, 3), k=1)[0]
+        chosen: list[dict] = []
+        used_outputs: set[tuple[int, int]] = set()
+        used_arms: set[int] = set()
+
