    for orb in full_orbs:
        for pos in orb["cells"]:
            retain[pos] = True
    if center_orb:
        retain[center_orb[0]["cells"][0]] = True
    for pos in _gen_choose_retained(side, full_orbs, center_orb, partial_orbs):
