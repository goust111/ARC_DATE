+    if corner == "TR":
+        return (0, side - 1), ((0, -1), (1, 0))
+    if corner == "BL":
+        return (side - 1, 0), ((-1, 0), (0, 1))
+    assert corner == "BR"
+    return (side - 1, side - 1), ((-1, 0), (0, -1))
+
