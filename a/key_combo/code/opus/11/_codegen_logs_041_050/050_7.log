+    cells = {"top": set(), "bottom": set()}
+
+    for row in range(height):
+        offset = _outward_offset(row, spec["r0"], spec["r1"], spec["height"])
+        left = spec["left"] - offset
+        right = spec["right"] + offset
+        for col in (left, right):
