+def _outward_offset(row: int, r0: int, r1: int, bar_height: int) -> int:
+    if row < r0:
+        return ((r0 - 1 - row) // bar_height) + 1
+    if row > r1:
+        return ((row - r1 - 1) // bar_height) + 1
+    return 0
