+        r = int(r0)
+        c = int(c0)
+        color = int(grid[r, c])
+        assert color not in used_colors, "colored pixels must have distinct colors"
+        used_colors.add(color)
+        adjacent_markers = []
+        for nr, nc in _neighbors4(r, c):
