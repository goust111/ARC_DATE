+
+
+def _render_input(shape: tuple[int, int], bbox: tuple[int, int, int, int], specs: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = GREY
+    for spec in specs:
+        r, c = spec["pos"]
+        mr, mc = r + spec["ray_dir"][0], c + spec["ray_dir"][1]
