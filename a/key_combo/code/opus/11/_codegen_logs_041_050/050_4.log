+        "obstacle_stops": sum(reason == "obstacle" for reason in meta["ray_reasons"]),
+        "boundary_stops": sum(reason == "boundary" for reason in meta["ray_reasons"]),
+        "changed_by_accumulation": changed_by_accumulation,
