+
+
+def _valid_layout_position(shape: tuple[int, int], bbox: tuple[int, int, int, int]) -> bool:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    return 0 <= r0 < r1 < h and 0 <= c0 < c1 < w
+
+
+def _gen_attempt(rng: random.Random, force_tie: bool) -> np.ndarray | None:
+    h = rng.randint(15, 19)
+    w = rng.randint(15, 19)
+    rect_h = rng.choice([3, 4])
