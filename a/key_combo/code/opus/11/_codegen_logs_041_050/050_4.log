+        if any(abs(pos[0] - rr) + abs(pos[1] - cc) == 1 for rr, cc in used_positions):
+            continue
+        specs.append({"side": side, "lane": lane, "distance": distance, "pos": pos})
+        used_positions.add(pos)
+
+    for spec in specs:
+        r, c = spec["pos"]
