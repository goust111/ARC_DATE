+        return None
+    if not analysis["reverse_diff"]:
+        return None
+    if force_tie and not analysis["has_tie"]:
+        return None
+    if np.array_equal(analysis["out"], analysis["post_slide"]):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for attempt in range(500):
