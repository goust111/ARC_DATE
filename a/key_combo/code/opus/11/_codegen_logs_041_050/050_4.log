+) -> list[dict] | None:
+    primary = rng.choice(["top", "bottom", "left", "right"])
+    span = _lane_span(primary, bbox)
+    separated_pairs = [(a, b) for a in range(span) for b in range(span) if abs(a - b) >= 2]
+    if not separated_pairs:
+        return None
+    lane_chain, lane_mate = rng.choice(separated_pairs)
