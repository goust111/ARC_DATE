+def _paths_to_initial_body(specs: list[dict], gray_body: np.ndarray) -> list[set[tuple[int, int]]]:
+    paths = []
+    for spec in specs:
+        steps, slide_dir = _distance_and_direction_to_body(spec["pos"], gray_body)
+        dr, dc = slide_dir
+        r, c = spec["pos"]
+        path = set()
+        for k in range(1, steps + 1):
+            path.add((r + dr * k, c + dc * k))
+        paths.append(path)
+    return paths
+
