+
+def _find_gray_rectangle(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    grey = grid == GREY
+    coords = np.argwhere(grey)
+    assert len(coords) >= 9, "expected a gray rectangle"
