+BG = 0
+GREY = 5
+MARKER = 9
+PALETTE = (1, 2, 3, 4, 7)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDE_TO_SLIDE = {
+    "top": (1, 0),
+    "bottom": (-1, 0),
+    "left": (0, 1),
+    "right": (0, -1),
