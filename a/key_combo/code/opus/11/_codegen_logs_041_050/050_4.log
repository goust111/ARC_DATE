+
+    toward = None
+    away = None
+    if primary in ("top", "bottom"):
+        if lane_mate > lane_chain:
+            toward = (0, -1)
+            away = (0, 1)
+        else:
+            toward = (0, 1)
+            away = (0, -1)
+    else:
+        if lane_mate > lane_chain:
+            toward = (-1, 0)
+            away = (1, 0)
+        else:
+            toward = (1, 0)
