+    row_min = 5
+    row_max = h - rect_h - 5
+    col_min = 5
+    col_max = w - rect_w - 5
+    if row_min > row_max or col_min > col_max:
+        return None
+    r0 = rng.randint(row_min, row_max)
+    c0 = rng.randint(col_min, col_max)
