+        dr, dc = slide_dir
+        r, c = spec["pos"]
+        path = set()
+        for k in range(1, steps + 1):
+            path.add((r + dr * k, c + dc * k))
+        paths.append(path)
+    return paths
+
+
+def _choose_marker_dirs(
