+    assert 3 <= len(objects) <= 5, "expected 3-5 colored pixels"
+    return objects
+
+
+def _distance_and_direction_to_body(pos: tuple[int, int], body: np.ndarray) -> tuple[int, tuple[int, int]]:
+    h, w = body.shape
+    r, c = pos
+    candidates = []
+    for dr, dc in DIRS4:
