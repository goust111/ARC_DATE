+    for spec in specs:
+        r, c = spec["pos"]
+        if not _in_bounds(shape, r, c):
+            return None
+
+    colors = list(PALETTE)
+    rng.shuffle(colors)
+    for spec, color in zip(specs, colors):
+        spec["color"] = color
+
+    toward = None
+    away = None
+    if primary in ("top", "bottom"):
+        if lane_mate > lane_chain:
+            toward = (0, -1)
+            away = (0, -1)
+        else:
+            toward = (0, 1)
+            away = (0, 1)
+    else:
+        if lane_mate > lane_chain:
+            toward = (-1, 0)
+            away = (-1, 0)
+        else:
+            toward = (1, 0)
+            away = (1, 0)
