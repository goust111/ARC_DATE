+    gray_body, _ = _find_gray_rectangle(grid)
+    objects = _parse_objects(grid)
+    static_only, _ = _slide_with_order(objects, gray_body, meta["order"])
+    reverse_only, _ = _slide_with_order(objects, gray_body, list(reversed(meta["order"])))
