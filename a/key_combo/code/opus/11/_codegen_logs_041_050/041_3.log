+
+
+def _place_marker_pair(
+    grid: np.ndarray,
+    r0: int,
+    c0: int,
+    h: int,
+    w: int,
+    orientation: str,
+    colors: tuple[int, int],
+    rng: np.random.Generator,
+) -> None:
+    color_a, color_b = map(int, colors)
+    if orientation == "h":
+        row = int(rng.integers(0, h))
+        grid[r0 + row, c0 + 0] = color_a
+        grid[r0 + row, c0 + w - 1] = color_b
