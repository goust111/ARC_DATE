+                    "paint": paint,
+                    "orientation": "h",
+                    "branch": "adjacent",
+                }
+            paint[row, left_c] = left_color
+            paint[row, right_c] = right_color
+            left_c += 1
+            right_c -= 1
+
+    col = int(info["line"])
+    top_r = int(info["near"])
+    bottom_r = int(info["far"])
+    top_color = int(info["near_color"])
+    bottom_color = int(info["far_color"])
+    while True:
