+
+def _divider_indices(grid: np.ndarray, axis: int) -> list[int]:
+    if axis == 0:
+        return [r for r in range(grid.shape[0]) if np.all(grid[r, :] == MAGENTA)]
+    return [c for c in range(grid.shape[1]) if np.all(grid[:, c] == MAGENTA)]
+
