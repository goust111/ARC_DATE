+    "down": [(0, 0), (0, 1), (0, 2), (0, 3), (1, 0), (1, 3)],
+    "up": [(0, 0), (0, 3), (1, 0), (1, 1), (1, 2), (1, 3)],
+    "right": [(0, 0), (1, 0), (2, 0), (3, 0), (0, 1), (3, 1)],
+    "left": [(0, 0), (3, 0), (0, 1), (1, 1), (2, 1), (3, 1)],
