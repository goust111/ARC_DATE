+                if turn_cell in (BG, PATH):
+                    options.append((tdr, tdc))
+            assert len(options) == 1, "each blocker collision must force one turn"
+            dr, dc = options[0]
+            continue
+
+        assert cell == BG, "path may only traverse background cells"
+        out[nr, nc] = PATH
+        length += 1
+        r, c = nr, nc
+
+    return out, length
