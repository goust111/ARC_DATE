+
+def _sprite_cells(top: int, left: int, sprite: np.ndarray) -> list[tuple[int, int]]:
+    return [
+        (top + r, left + c)
+        for r in range(sprite.shape[0])
+        for c in range(sprite.shape[1])
+        if sprite[r, c]
