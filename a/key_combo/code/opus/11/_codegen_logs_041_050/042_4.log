+                    path = [(start_row, 1 + step) for step in range(1, a + 1)]
+                    if vertical == "up":
+                        path += [(start_row - step, turn_col) for step in range(1, b + 1)]
+                        end_row = start_row - b
+                        wrong1 = (start_row + 1, turn_col)
+                        ahead2 = (end_row - 1, turn_col)
+                    else:
+                        path += [(start_row + step, turn_col) for step in range(1, b + 1)]
+                        end_row = start_row + b
+                        wrong1 = (start_row - 1, turn_col)
+                        ahead2 = (end_row + 1, turn_col)
