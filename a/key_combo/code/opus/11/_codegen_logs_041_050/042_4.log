+                if not (1 <= start_row <= h - 2):
+                    continue
+                turn_col = 1 + a
+                path = [(start_row, 1 + step) for step in range(1, a + 1)]
+                if vertical == "up":
+                    path += [(start_row - step, turn_col) for step in range(1, b + 1)]
+                    wrong = (start_row + 1, turn_col)
+                else:
+                    path += [(start_row + step, turn_col) for step in range(1, b + 1)]
+                    wrong = (start_row - 1, turn_col)
+                blockers = [(start_row, turn_col + 1), wrong]
