+        cell = int(g[nr, nc])
+        if cell == BLOCKER:
+            options: list[tuple[int, int]] = []
+            for tdr, tdc in ((-dc, dr), (dc, -dr)):
+                tr, tc = r + tdr, c + tdc
+                if not _in_bounds(g.shape, tr, tc):
+                    continue
