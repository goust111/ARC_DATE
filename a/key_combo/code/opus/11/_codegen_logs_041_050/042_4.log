+        return None
+    if Counter(map(int, inp.flatten()))[PATH] != 2:
+        return None
+    if not _nondegenerate(inp, direction, total_length):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
