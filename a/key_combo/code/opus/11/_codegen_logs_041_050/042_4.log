+
+def _place_cells(grid: np.ndarray, coords: list[tuple[int, int]], color: int) -> bool:
+    for r, c in coords:
+        if not _in_bounds(grid.shape, r, c) or grid[r, c] != BG:
+            return False
+    for r, c in coords:
+        grid[r, c] = color
