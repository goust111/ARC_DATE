+        dest_bottom = floor - 1 if below_rows.size else floor
+        shift = dest_bottom - int(comp[:, 0].max())
+        moved = comp.copy()
+        moved[:, 0] += shift
+        assert int(moved[:, 0].min()) >= divider_r + 1
