+def _find_divider_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == RED)]
+    assert len(rows) == 1, "expected exactly one full-width red divider row"
+    return int(rows[0])
