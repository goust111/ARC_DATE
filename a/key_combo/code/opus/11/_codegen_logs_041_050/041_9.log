+            continue
+        row_h = max(int(p.shape[0]) for p in patches)
+        row_w = sum(int(p.shape[1]) for p in patches) + (len(patches) - 1)
+        strip = np.zeros((row_h, row_w), dtype=int)
+        c = 0
+        for patch in patches:
+            ph, pw = map(int, patch.shape)
+            strip[:ph, c : c + pw] = patch
