+def _bands(size: int, separators: Iterable[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for cut in sorted(int(v) for v in separators):
+        if start < cut:
+            bands.append((start, cut))
+        start = cut + 1
+    if start < size:
+        bands.append((start, size))
+    return bands
