+    mask = cell != BG
+    count = int(mask.sum())
+    if count == 0 or count % w != 0:
+        return False, 0
+    block_h = count // w
+    if block_h > h:
+        return False, 0
+    expected = np.zeros((h, w), dtype=bool)
+    expected[h - block_h :, :] = True
+    return bool(np.array_equal(mask, expected)), int(block_h)
+
