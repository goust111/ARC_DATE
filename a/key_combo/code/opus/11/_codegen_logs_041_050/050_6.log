+        if not np.all(out[:count, col] == color):
+            return False
+        if not np.all(out[count:, col] == BLACK):
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        decoded = _sample_decoded_sequence()
+        inp = _render_panels(decoded)
+        if _validate_generated(inp):
+            return inp
