+    assert len(heights) == 1 and len(widths) == 1, "all merged tiles must share one size"
+    tile_h = heights.pop()
+    tile_w = widths.pop()
+    assert tile_h in (4, 5) and tile_w in (4, 5) and tile_h == tile_w
