+def _infer_structure(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert set(map(int, np.unique(g))).issubset({BG, FG}), "expected only black and teal"
