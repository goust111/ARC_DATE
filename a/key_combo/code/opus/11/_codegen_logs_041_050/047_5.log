+
+
+def _is_ring_mask(mask: np.ndarray) -> bool:
+    if not (mask[0, :].any() and mask[-1, :].any() and mask[:, 0].any() and mask[:, -1].any()):
+        return False
+    if len(_components_mask(mask, connectivity=4)) != 1:
+        return False
+    if not _interior_hole(mask):
