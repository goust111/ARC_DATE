0916: def randomly_scatter_points(
0917:     grid: np.ndarray,
0918:     color: int,
0919:     *,
0920:     density: float = 0.5,
0921:     background: int = Color.BLACK,
0922: ) -> np.ndarray:
0923:     """Randomly scatter points of `color` into `background` cells until reaching density."""
0924:     bg = int(background)
0925:     col = int(color)
0926:     colored = 0
0927:     H, W = grid.shape
0928:     target = int(round(float(density) * H * W))
0929:     while colored < target:
0930:         r = np.random.randint(0, H)
0931:         c = np.random.randint(0, W)
0932:         if int(grid[r, c]) == bg:
0933:             grid[r, c] = col
0934:             colored += 1
0935:     return grid
