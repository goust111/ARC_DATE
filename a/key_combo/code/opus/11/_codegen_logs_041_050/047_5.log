+
+def _chebyshev_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = p
+    qr, qc = q
+    path = [(r, c)]
+    while (r, c) != (qr, qc):
+        r += _sign(qr - r)
+        c += _sign(qc - c)
+        path.append((r, c))
+    return path
