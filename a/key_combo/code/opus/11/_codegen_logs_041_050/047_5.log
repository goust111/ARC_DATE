+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+GREEN = 3
+PINK = 6
+ORANGE = 7
+TEAL = 8
+
+LR_SIDES = ("left", "right")
+TB_SIDES = ("top", "bottom")
