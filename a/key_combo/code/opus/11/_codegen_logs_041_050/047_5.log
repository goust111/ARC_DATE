+                best_key = key
+                best_pair = (p, q)
+    assert best_pair is not None
+    return best_pair
+
+
+def _chebyshev_path(p: tuple[int, int], q: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = p
+    qr, qc = q
+    path = [(r, c)]
+    while (r, c) != (qr, qc):
+        r += _sign(qr - r)
+        c += _sign(qc - c)
+        path.append((r, c))
+    return path
+
+
+def _coords_from_mask(mask: np.ndarray, top: int, left: int) -> np.ndarray:
+    coords = np.argwhere(mask)
+    coords = coords.astype(int)
+    coords[:, 0] += int(top)
+    coords[:, 1] += int(left)
+    return coords
+
+
+def _interior_hole(mask: np.ndarray) -> bool:
+    h, w = mask.shape
+    bg = ~mask
+    seen = np.zeros_like(mask, dtype=bool)
+    queue = deque()
+    for r in range(h):
+        for c in range(w):
+            if r not in (0, h - 1) and c not in (0, w - 1):
+                continue
+            if bg[r, c] and not seen[r, c]:
+                seen[r, c] = True
+                queue.append((r, c))
+    while queue:
+        rr, cc = queue.popleft()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                queue.append((nr, nc))
