+        for br, bc in b_coords:
+            q = (int(br), int(bc))
+            key = (max(abs(p[0] - q[0]), abs(p[1] - q[1])), p[0], p[1], q[0], q[1])
+            if best_key is None or key < best_key:
+                best_key = key
+                best_pair = (p, q)
+    assert best_pair is not None
+    return best_pair
