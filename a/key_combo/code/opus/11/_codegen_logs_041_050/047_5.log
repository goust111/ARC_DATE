+                "bbox": bbox,
+                "side": side,
+                "shape": patch.shape,
+                "tab_count": int(patch.sum()),
+                "side_counts": (
+                    int(patch[:, 0].sum()),
+                    int(patch[:, -1].sum()),
+                    int(patch[0, :].sum()),
+                    int(patch[-1, :].sum()),
