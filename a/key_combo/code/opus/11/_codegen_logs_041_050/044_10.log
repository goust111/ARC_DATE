+                overlap_pair = True
+                break
+        if overlap_pair:
+            break
+    if not overlap_pair:
+        return None
+
+    if not _validate_case(grid, expected, mapping, clear, blocked, blockers):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
