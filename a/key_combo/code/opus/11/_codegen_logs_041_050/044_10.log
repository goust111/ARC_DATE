def _gen_raw_star5(height, width):
    choices = []
    for up, down, left, right in itertools.product(_GEN_STEP_VALUES, repeat=4):
        row_span = up + down
        col_span = left + right
        if _gen_span_fits(row_span, col_span, height, width):
