+    for coords in comps:
+        area = int(coords.shape[0])
+        r0, c0, r1, c1 = _bbox(coords)
+        if area == 1:
+            r, c = map(int, coords[0])
+            markers.append((c, r, int(top[r, c])))
+            continue
