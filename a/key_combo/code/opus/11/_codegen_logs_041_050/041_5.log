+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "input must be a 2D grid"
+
+    sep = _find_separator_col(g)
+    left = g[:, :sep]
+    right = g[:, sep + 1 :]
+    assert left.size > 0 and right.size > 0, "separator must leave non-empty halves"
