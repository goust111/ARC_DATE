+import numpy as np
+
+
+BG = 0
+SEP = 5
+PATH_COLORS = (1, 2, 3)
+MIN_PATH_LEN = 3
+MAX_PATH_LEN = 7
+MIN_PATHS = 2
+MAX_PATHS = 3
+MAX_ATTEMPTS = 500
