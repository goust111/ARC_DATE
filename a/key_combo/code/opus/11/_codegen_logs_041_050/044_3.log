+        if side == "left":
+            mirrored.add((r, 2 * ac0 - 1 - c))
+        elif side == "right":
+            mirrored.add((r, 2 * ac1 + 1 - c))
+        elif side == "above":
+            mirrored.add((2 * ar0 - 1 - r, c))
+        else:
