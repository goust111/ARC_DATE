+
+def _generate_attempt() -> np.ndarray | None:
+    n_groups = random.choice((2, 3))
+    shape = (
+        random.randint(max(GRID_MIN, 15 if n_groups == 3 else GRID_MIN), GRID_MAX),
+        random.randint(max(GRID_MIN, 15 if n_groups == 3 else GRID_MIN), GRID_MAX),
+    )
