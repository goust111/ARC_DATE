+            output_cells = layout["output_cells"]
+            path_cells = layout["path_cells"]
+            if input_cells & (_expand(reserved_input, shape, PAIR_PADDING) | reserved_path):
+                continue
+            if path_cells & (_expand(reserved_input, shape, PAIR_PADDING) | reserved_path):
+                continue
+            if output_cells & _expand(reserved_output, shape, PAIR_PADDING):
+                continue
