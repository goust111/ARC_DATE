+    step_r = 0 if ir == sr else (1 if sr > ir else -1)
+    step_c = 0 if ic == sc else (1 if sc > ic else -1)
+    path: set[tuple[int, int]] = set()
+    cur_r, cur_c = ir, ic
+    for _ in range(gap + 1):
