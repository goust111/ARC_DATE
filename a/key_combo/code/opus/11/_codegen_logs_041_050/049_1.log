+        idx = 0
+        for (color, _total), parts in zip(counts_by_color, parts_by_color):
+            for height in parts:
+                specs.append((columns[idx], int(color), int(height)))
+                idx += 1
+        return specs
+    return None
+
+
+def _sample_positions(
+    height: int,
+    count: int,
+    *,
+    require_unsettled: bool,
+    require_gap: bool,
+) -> tuple[int, ...] | None:
+    settled = tuple(range(height - count, height))
+    for _ in range(200):
+        positions = tuple(sorted(random.sample(range(height), count)))
+        if require_unsettled and positions == settled:
+            continue
+        if require_gap and count >= 2 and all(positions[i + 1] == positions[i] + 1 for i in range(count - 1)):
+            continue
+        return positions
