+
+    assert floating_columns >= 2
+    assert multi_columns >= 1
+    assert gappy_columns >= 1
+
+    out = main(grid)
+    expected = _render_rings(sorted_counts, bg=bg)
+    assert np.array_equal(out, expected)
+    assert out.shape[0] == 2 * counts[0] - 1
