+    if not tall_indices:
+        return None
+
+    gap_idx = random.choice(tall_indices)
+    unsettled_indices = set(random.sample(range(len(column_specs)), k=min(2, len(column_specs))))
+    extra_unsettled = [i for i in range(len(column_specs)) if i not in unsettled_indices and random.random() < 0.35]
+    unsettled_indices.update(extra_unsettled)
+
+    for i, (col, color, count) in enumerate(column_specs):
+        positions = _sample_positions(
+            height,
+            count,
+            require_unsettled=i in unsettled_indices,
+            require_gap=i == gap_idx,
+        )
+        if positions is None:
+            return None
+        grid[list(positions), int(col)] = int(color)
+    return grid
+
+
+def _validate_generated_input(grid: np.ndarray) -> None:
