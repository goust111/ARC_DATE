+GRID_WIDTH_RANGE = (11, 14)
+COLOR_COUNT_RANGE = (3, 5)
+PIXELS_PER_COLOR = (2, 6)
+PARTS_PER_COLOR_MAX = 3
+GEN_ATTEMPTS = 400
+
+
+def _sample_counts(num_colors: int) -> list[int]:
+    while True:
+        counts = random.sample(range(PIXELS_PER_COLOR[0], PIXELS_PER_COLOR[1] + 1), num_colors)
+        counts.sort(reverse=True)
+        if counts[0] >= num_colors:
+            return counts
+
+
+def _positive_partition(total: int, parts: int) -> list[int]:
+    if parts == 1:
+        return [total]
+    cut_points = sorted(random.sample(range(1, total), parts - 1))
+    prev = 0
+    values: list[int] = []
+    for cut in [*cut_points, total]:
+        values.append(cut - prev)
+        prev = cut
+    random.shuffle(values)
+    return values
+
+
