+GRID_WIDTH_RANGE = (11, 14)
+COLOR_COUNT_RANGE = (3, 5)
+PIXELS_PER_COLOR = (2, 6)
+PARTS_PER_COLOR_MAX = 3
+GEN_ATTEMPTS = 400
+
+
+def _sample_counts(num_colors: int) -> list[int]:
