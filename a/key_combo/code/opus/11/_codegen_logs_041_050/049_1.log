+    unsettled_indices.update(extra_unsettled)
+
+    for i, (col, color, count) in enumerate(column_specs):
+        positions = _sample_positions(
+            height,
+            count,
+            require_unsettled=i in unsettled_indices,
+            require_gap=i == gap_idx,
