+        for _color, total in counts_by_color:
+            parts = _choose_parts(total)
+            parts_by_color.append(_positive_partition(total, parts))
+
+        heights = [h for parts in parts_by_color for h in parts]
+        if sum(len(parts) for parts in parts_by_color) > width:
+            continue
+        if not any(len(parts) > 1 for parts in parts_by_color):
+            continue
+        if max(heights) < 2:
+            continue
+
