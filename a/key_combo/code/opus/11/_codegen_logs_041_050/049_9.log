TARGET_ONE_STEP_PROB = 0.85
MIN_PLACED_TARGETS = 3

# Retry limits.
GEN_ATTEMPTS = 300


def _gen_apply_chain(color: int, pairs: list[tuple[int, int]]) -> int:
    current = color
    for src, dst in pairs:
