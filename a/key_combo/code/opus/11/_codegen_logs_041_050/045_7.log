+def place_rectangles(shapes: list[np.ndarray], canvas_h: int, canvas_w: int) -> list[tuple[int, int]] | None:
+    rects = []
+    order = list(range(len(shapes)))
+    order.sort(key=lambda i: int(shapes[i].shape[0] * shapes[i].shape[1]), reverse=True)
