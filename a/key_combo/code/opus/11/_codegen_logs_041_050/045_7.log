+
+def complete_local_mask(local_mask: np.ndarray, candidate: dict) -> np.ndarray:
+    if candidate["axis"] == "vertical":
+        return local_mask | np.fliplr(local_mask)
+    return local_mask | np.flipud(local_mask)
