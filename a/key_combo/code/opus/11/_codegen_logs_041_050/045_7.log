+            1
+            for nr, nc in neighbors4(int(r), int(c))
+            if in_bounds(g.shape, nr, nc) and int(g[nr, nc]) == BLUE
+        )
+        if blue_neighbors >= 3:
+            to_repair.append((int(r), int(c)))
+    for r, c in to_repair:
