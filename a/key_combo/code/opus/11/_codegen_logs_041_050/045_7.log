+def build_object(axis: str, hole_count: int, style: str) -> np.ndarray:
+    vertical = build_vertical_object(hole_count, style)
+    return vertical if axis == "vertical" else vertical.T
+
+
+def partialize_mask(full_mask: np.ndarray, axis: str, complete_side: str) -> np.ndarray:
+    partial = full_mask.copy()
+    h, w = partial.shape
