+        assert style == "single_cap"
+        gaps = random.choice([[1, 3], [2, 3], [2, 4]])
+        base_h = sum(gaps) + 3
+        base_w = 7
+    else:
+        assert style == "double_cap"
+        gaps = list(random.sample([1, 2, 3], 3))
+        base_h = sum(gaps) + 4
+        base_w = 5
+
+    base = np.zeros((base_h, base_w), dtype=bool)
+    base[0, :] = True
+    base[-1, :] = True
+    base[:, 0] = True
+    base[:, -1] = True
+
+    row = 1
+    for gap in gaps[:-1]:
+        row += gap
+        base[row, :] = True
+        row += 1
+
+    center = base_w // 2
+    if style == "single_cap":
+        with_tab = np.zeros((base_h + 1, base_w), dtype=bool)
+        if random.random() < 0.5:
+            with_tab[1:, :] = base
+            with_tab[0, center - 1 : center + 2] = True
+        else:
+            with_tab[:-1, :] = base
+            with_tab[-1, center - 1 : center + 2] = True
+    else:
+        with_tab = np.zeros((base_h + 2, base_w), dtype=bool)
+        with_tab[1:-1, :] = base
+        with_tab[0, center - 1 : center + 2] = True
+        with_tab[-1, center - 1 : center + 2] = True
+
+    assert 20 <= int(with_tab.sum()) <= 40
