+    for r, c in np.argwhere(local_mask):
+        rr = int(r)
+        cc = int(c)
+        blue_neighbors = sum(
+            1
+            for nr, nc in neighbors4(rr, cc)
+            if in_bounds(local_mask.shape, nr, nc) and local_mask[nr, nc]
