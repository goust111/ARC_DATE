+            if not np.array_equal(complete_local_mask(partial_mask, axis_info[0]), full_mask):
+                continue
+
+            full_holes = enclosed_black_holes(np.where(full_mask, BLUE, BLACK))
+            if len(full_holes) != hole_count:
