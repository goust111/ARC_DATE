+    full_blue_grid[full_blue] = BLUE
+    output_grid = solve_core(full_blue_grid, do_repair=False, do_complete=False, do_fill=True)
+
+    isolated_reds = choose_isolated_reds(input_grid, output_grid)
+    for r, c in isolated_reds:
