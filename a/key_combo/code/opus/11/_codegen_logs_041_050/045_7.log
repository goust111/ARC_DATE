+        base_w = inner_w + 2
+    else:
+        inner_w = random.choice([3, 5])
+        gaps = list(random.sample([1, 2, 3], 3))
+        base_h = sum(gaps) + 4
+        base_w = inner_w + 2
+
+    base = np.zeros((base_h, base_w), dtype=bool)
+    base[0, :] = True
+    base[-1, :] = True
+    base[:, 0] = True
+    base[:, -1] = True
