+def build_vertical_object(hole_count: int) -> np.ndarray:
+    if hole_count == 1:
+        inner_h = random.choice([5, 6])
+        inner_w = random.choice([5, 7])
+        base_h = inner_h + 2
+        base_w = inner_w + 2
+        gaps: list[int] = [inner_h]
+    elif hole_count == 2:
+        inner_w = random.choice([3, 5])
+        g1, g2 = random.sample([1, 2, 3, 4], 2)
+        gaps = [g1, g2]
