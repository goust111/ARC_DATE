+    assert 2 <= len(embedded) <= 4
+    assert 1 <= len(isolated) <= 2
+
+    repaired = repair_embedded_red(inp)
+    comps = components(repaired == BLUE)
+    assert 1 <= len(comps) <= 2
+
+    completed = repaired.copy()
+    changed = False
