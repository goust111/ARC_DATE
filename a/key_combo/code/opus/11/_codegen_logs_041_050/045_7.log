+
+def build_example() -> tuple[np.ndarray, np.ndarray]:
+    object_count = 1 if random.random() < 0.45 else 2
+    if object_count == 1:
+        object_specs = [(3, "double_cap")]
+    else:
+        if random.random() < 0.5:
+            object_specs = [(1, "double_cap"), (1, "double_cap")]
+        else:
+            object_specs = random.sample([(1, "double_cap"), (2, "single_cap")], 2)
+
+    full_masks = []
+    partial_masks = []
+    safe_sites_per_object = []
+    hole_areas: list[int] = []
+    partial_areas: list[int] = []
