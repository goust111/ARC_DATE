+            {
+                "coords": coords,
+                "area": int(len(coords)),
+                "top_left": (int(r0), int(c0)),
+            }
+        )
+    holes.sort(key=lambda h: (h["area"], h["top_left"][1], h["top_left"][0]))
+    return holes
