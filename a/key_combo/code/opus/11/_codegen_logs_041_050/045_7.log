+
+    isolated_reds = choose_isolated_reds(input_grid, output_grid)
+    for r, c in isolated_reds:
+        input_grid[r, c] = RED
+        output_grid[r, c] = RED
+
+    return input_grid, output_grid
+
+
+def validate_example(inp: np.ndarray, out: np.ndarray) -> None:
+    assert inp.ndim == 2 and out.ndim == 2
