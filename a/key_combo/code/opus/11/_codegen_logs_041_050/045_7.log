+            if r >= mr:
+                continue
+            for c in range(w):
+                top = bool(local_mask[r, c])
+                bottom = bool(local_mask[mr, c])
+                different |= top != bottom
+                if top and not bottom:
+                    top_subset_bottom = False
+                if bottom and not top:
+                    bottom_subset_top = False
+        if different:
