+def build_vertical_object(hole_count: int, style: str) -> np.ndarray:
+    if hole_count == 1:
+        assert style == "double_cap"
+        inner_h = random.choice([5, 6, 7])
+        base_h = inner_h + 2
+        base_w = 7
+        gaps: list[int] = [inner_h]
