+
+def build_example() -> tuple[np.ndarray, np.ndarray]:
+    object_count = 1 if random.random() < 0.65 else 2
+    hole_plan = [random.choice([2, 3])] if object_count == 1 else random.sample([2, 1], 2)
+
+    full_masks = []
+    partial_masks = []
+    axes = []
+    safe_sites_per_object = []
