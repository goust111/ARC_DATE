+def enclosed_black_holes(grid: np.ndarray) -> list[dict]:
+    holes = []
+    for coords in components(grid == BLACK):
+        r0, c0, r1, c1 = bbox_of(coords)
+        if r0 == 0 or c0 == 0 or r1 == grid.shape[0] - 1 or c1 == grid.shape[1] - 1:
