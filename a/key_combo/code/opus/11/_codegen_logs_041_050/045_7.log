+            completed = complete_local_mask(local_mask, candidates[0])
+            patch = out[r0 : r1 + 1, c0 : c1 + 1].copy()
+            patch[completed] = BLUE
+            out[r0 : r1 + 1, c0 : c1 + 1] = patch
