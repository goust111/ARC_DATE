+    if do_fill:
+        holes = enclosed_black_holes(out)
+        assert 2 <= len(holes) <= 3, "expected two or three enclosed holes after completion"
+        for hole, color in zip(holes, FILL_COLORS):
+            out[hole["coords"][:, 0], hole["coords"][:, 1]] = color
