+        shape = shapes[idx]
+        h, w = shape.shape
+        options = []
+        for r in range(canvas_h - h + 1):
+            for c in range(canvas_w - w + 1):
+                ok = True
+                for j, (rr, cc) in placed.items():
+                    hh, ww = shapes[j].shape
+                    if not (
