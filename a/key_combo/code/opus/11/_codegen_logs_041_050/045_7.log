+                        or rr + hh - 1 + BBOX_GAP < r
+                        or c + w - 1 + BBOX_GAP < cc
+                        or cc + ww - 1 + BBOX_GAP < c
+                    ):
+                        ok = False
+                        break
+                if ok:
+                    options.append((r, c))
+        if not options:
+            return None
+        placed[idx] = random.choice(options)
+
+    for idx in range(len(shapes)):
+        rects.append(placed[idx])
