+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+FILL_COLORS = (YELLOW, GREEN, ORANGE)
+
+GEN_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 200
+BBOX_GAP = 2
+
+ONE_HOLE_VERTICALS = [
