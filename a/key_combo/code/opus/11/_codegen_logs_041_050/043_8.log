+def _hole_quadrant(coords: list[tuple[int, int]], shape: tuple[int, int]) -> str:
+    h, w = shape
+    n = len(coords)
+    sum_r = sum(r for r, _ in coords)
+    sum_c = sum(c for _, c in coords)
+    top = 2 * sum_r < n * (h - 1)
+    left = 2 * sum_c < n * (w - 1)
+    if top and left:
+        return "tl"
+    if top and not left:
+        return "tr"
+    if not top and left:
+        return "bl"
+    return "br"
