+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            touches_boundary = False
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                if cr in (0, h - 1) or cc in (0, w - 1):
