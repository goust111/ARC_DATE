+def _hole_quadrant(coords: list[tuple[int, int]], shape: tuple[int, int]) -> str:
+    h, w = shape
+    n = len(coords)
+    sum_r = sum(r for r, _ in coords)
+    sum_c = sum(c for _, c in coords)
