 274: def main(grid: np.ndarray) -> np.ndarray:
 275:     """
 276:     Fill hollow sprites' interiors using a color-palette legend on the grid edge.
 277: 
 278:     Input structure:
 279:     - bg = most common color. Several hollow sprites with distinct border colors.
 280:     - A small 2×N or N×2 palette block sits on one grid edge; one row/column lists border colors, the other lists corresponding fill colors.
 281: 
 282:     Rule:
 283:     - Locate the palette legend on a grid edge and read it as a border→fill color mapping.
 284:     - Find enclosed bg regions (holes) inside sprites that don't touch the grid boundary.
 285:     - For each hole, identify the most common adjacent border color, look it up in the palette, and fill the hole with the mapped fill color.
 286: 
 287:     Key insight: The palette's edge position and orientation determine reading direction; border colors in the palette uniquely key into fill colors.
 288:     """
 289:     g = np.asarray(grid, dtype=int)
 290:     bg = _bg_boundary(g)
 291: 
 292:     mapping, pal_mask = _palette_mapping(g, bg)
 293:     assert mapping, "main: palette mapping must be non-empty"
 294: 
 295:     out = g.copy()
 296:     _fill_enclosed_bg_regions(out, bg, mapping, pal_mask)
 297: 
 298:     return out
 299: 
 300: # --------------- generator (c) ---------------
 301: 
 302: # -- Configuration constants --------------------------------------------------
 303: # Grid dimensions
 304: _GRID_H_MIN, _GRID_H_MAX = 4, 13
 305: _GRID_W_MIN, _GRID_W_MAX = 10, 15
 306: _SMALL_H_THRESHOLD = 6        # below this, prefer left/right palette
 307: _SMALL_H_PALETTE_FLIP = 0.7   # probability of flipping top/bottom -> left/right
 308: _TINY_H_THRESHOLD = 5         # below this, cap sprite height at 3
 309: 
 310: # Palette
 311: _PALETTE_N_MIN, _PALETTE_N_MAX = 2, 5
 312: 
 313: # Sprite geometry
 314: _SPRITE_H_MAX = 7
 315: _SPRITE_W_MAX = 6
 316: _SPRITE_DIM_SUM_CAP = 10      # if sh + sw exceeds this, clamp sw
 317: _SPRITE_CELL_MAX = 16
 318: _FILLED_SPRITE_MAX = 3
 319: 
 320: # Sprite mutation probabilities
 321: _P_HORIZ_WALL = 0.3           # add horizontal internal wall
 322: _P_VERT_WALL = 0.3            # add vertical internal wall
 323: _P_BORDER_REMOVAL = 0.4       # remove border cells for irregular shapes
 324: _P_DIAMOND = 0.2              # use diamond shape for 3x3
 325: 
 326: # Generation
 327: _MAX_RETRIES = 300
 328: # -- End configuration --------------------------------------------------------
 329: 
 330: 
 331: def _get_enclosed_holes(sprite):
 332:     """Return list of point-arrays for bg components not touching sprite boundary."""
 333:     h, w = sprite.shape
 334:     return [pts for pts in components_mask(~sprite, connectivity=4)
 335:             if not any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in pts)]
 336: 
 337: 
 338: def _make_diamond():
 339:     """Return a 3x3 diamond-shaped boolean mask."""
 340:     s = np.zeros((3, 3), dtype=bool)
 341:     s[0, 1] = s[1, 0] = s[1, 2] = s[2, 1] = True
 342:     return s
 343: 
 344: 
 345: def _make_hollow_sprite(h, w, rng):
 346:     """Create hollow sprite (h x w) with at least 1 enclosed bg hole, cell count <= _SPRITE_CELL_MAX."""
 347:     sprite = np.ones((h, w), dtype=bool)
 348:     if h >= 3 and w >= 3:
 349:         sprite[1:-1, 1:-1] = False
 350:     # Optionally add internal horizontal wall
 351:     if h >= 5 and w >= 4 and rng.random() < _P_HORIZ_WALL:
 352:         br = rng.randint(2, h - 2)
 353:         n = rng.randint(1, w - 2)
 354:         s = rng.randint(1, w - 1 - n + 1)
 355:         sprite[br, s:s + n] = True
 356:     # Optionally add internal vertical wall
 357:     if h >= 4 and w >= 5 and rng.random() < _P_VERT_WALL:
 358:         bc = rng.randint(2, w - 2)
 359:         n = rng.randint(1, h - 2)
 360:         s = rng.randint(1, h - 1 - n + 1)
 361:         sprite[s:s + n, bc] = True
 362:     # Optionally remove border cells for irregularity
 363:     if rng.random() < _P_BORDER_REMOVAL:
 364:         bcells = [(r, c) for r in range(h) for c in range(w)
 365:                   if sprite[r, c] and (r in (0, h - 1) or c in (0, w - 1))]
 366:         rng.shuffle(bcells)
 367:         for cr, cc in bcells[:rng.randint(1, min(4, len(bcells)))]:
 368:             test = sprite.copy()
 369:             test[cr, cc] = False
