+    right_opts = _all_row_sets(h_right)
+    pairs = [
+        (a, b)
+        for a in left_opts
+        for b in right_opts
+        if len(a) == len(b) and a[0] != b[0]
+    ]
+    assert pairs
+    return rng.choice(pairs)
+
+
+def _make_sprite(
+    kind: str,
+    h: int,
+    w: int,
+    left_rows: tuple[int, ...],
+    right_rows: tuple[int, ...],
+    color: int,
+) -> np.ndarray:
+    g = np.zeros((h, w), dtype=int)
+    g[0, :] = color
+    g[-1, :] = color
+    if kind == "open_right":
+        g[:, 0] = color
+        for r in right_rows:
+            g[r, :] = color
+    else:
+        assert kind == "open_left"
+        g[:, -1] = color
+        for r in left_rows:
+            g[r, :] = color
