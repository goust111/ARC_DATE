+
+def _valid_instance(inp: np.ndarray, output_sprites: list[dict[str, object]]) -> bool:
+    fill_map = QUADRANT_MARKERS.copy()
+    expected = _assemble_solution(output_sprites, fill_map, reverse_order=False, align=True, fill=True)
