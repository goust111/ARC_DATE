+
+def _all_row_sets(h: int) -> list[tuple[int, ...]]:
+    rows: list[tuple[int, ...]] = []
+    for r in range(1, h - 1):
+        rows.append((r,))
+    for r in range(1, h - 2):
+        rows.append((r, r + 1))
+    return rows
+
