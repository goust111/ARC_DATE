+            comp: list[tuple[int, int]] = []
+            touches_boundary = False
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                if cr in (0, h - 1) or cc in (0, w - 1):
+                    touches_boundary = True
+                for nr, nc in _neighbors4(cr, cc):
