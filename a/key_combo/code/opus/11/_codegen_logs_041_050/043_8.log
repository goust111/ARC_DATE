+def _place_sprites(
+    sprites: list[dict[str, object]],
+    *,
+    align: bool,
+) -> np.ndarray:
+    tops = [0]
+    lefts = [0]
+    for i in range(1, len(sprites)):
+        prev = sprites[i - 1]
+        cur = sprites[i]
+        if align:
+            top = _aligned_top(
