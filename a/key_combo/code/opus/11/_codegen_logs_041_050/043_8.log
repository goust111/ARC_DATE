+    return rng.choice(pairs)
+
+
+def _make_sprite(
+    kind: str,
+    h: int,
+    w: int,
+    left_rows: tuple[int, ...],
+    right_rows: tuple[int, ...],
+    color: int,
+) -> np.ndarray:
+    g = np.zeros((h, w), dtype=int)
+    g[0, :] = color
+    g[-1, :] = color
