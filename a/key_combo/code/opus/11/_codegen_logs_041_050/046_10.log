+    occupied = main_mask.copy()
+    while len(masks) < 2:
+        outside_mask = _place_component(
+            height=height,
+            period=period,
+            occupied=occupied,
+            rows_r=rows_r,
+            relation="disjoint",
+            max_area=max(3, main_area - 1),
+            rng=rng,
+        )
