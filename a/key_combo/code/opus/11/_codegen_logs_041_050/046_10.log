+    full[start_row : start_row + tile.shape[0], :] = _repeat_tile(tile)
+    return full
+
+
+def _place_component(
+    height: int,
+    period: int,
+    occupied: np.ndarray,
+    rows_r: set[int],
+    relation: str,
+    max_area: int,
+    rng: random.Random,
