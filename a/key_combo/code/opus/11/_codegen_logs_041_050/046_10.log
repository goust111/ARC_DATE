+    comps = _foreground_components(occupied)
+    if len(comps) != target_components:
+        return None
+    comp_areas = sorted((len(comp) for comp in comps), reverse=True)
+    if len(comp_areas) > 1 and comp_areas[0] <= comp_areas[1]:
+        return None
+    if comp_areas[0] != main_area:
