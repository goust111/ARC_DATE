    idx=list(range(len(later)))
    rng.shuffle(idx)
    cut=rng.randint(1,len(idx)-1)
    keep=set(idx[:cut])
    M=np.zeros((rows,W),bool); B=np.zeros((rows,W),bool)
    for r,c in pos: M[r,c]=1
    for i,(r,c) in enumerate(later):
