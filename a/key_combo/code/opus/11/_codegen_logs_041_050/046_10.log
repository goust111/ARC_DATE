    if not ok: continue
    if len(comps(M))!=1 or len(comps(B))!=1: continue
    if M.sum() <= B.sum(): continue
    print('"'FOUND')
    print(first.astype(int))
    print('M')
    print(M.astype(int))
    print('B')
    print(B.astype(int))
    break
else:
    print('none')
