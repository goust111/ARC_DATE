import random, numpy as np
rng=random.Random(0)

def neigh8(r,c):
    for dr in (-1,0,1):
        for dc in (-1,0,1):
            if dr==0 and dc==0: continue
            yield r+dr,c+dc

def comps(mask):
    H,W=mask.shape
    seen=np.zeros((H,W),bool); out=[]
    for r in range(H):
      for c in range(W):
        if not mask[r,c] or seen[r,c]: continue
        st=[(r,c)]; seen[r,c]=1; cc=[]
        while st:
          x,y=st.pop(); cc.append((x,y))
          for nx,ny in neigh8(x,y):
            if 0<=nx<H and 0<=ny<W and mask[nx,ny] and not seen[nx,ny]:
              seen[nx,ny]=1; st.append((nx,ny))
        out.append(cc)
    return out

def period(g):
    W=g.shape[1]
    for p in range(1,W+1):
      if np.array_equal(g[:,p:], g[:,:-p]): return p
    return W

def grow_connected(h,w,area):
    start=(rng.randrange(h),rng.randrange(w))
    cells={start}; frontier={start}
    while len(cells)<area and frontier:
      base=rng.choice(tuple(frontier))
      nbr=[(nr,nc) for nr,nc in neigh8(*base) if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells]
      if not nbr:
        frontier.remove(base); continue
      nxt=rng.choice(nbr)
      cells.add(nxt); frontier.add(nxt)
