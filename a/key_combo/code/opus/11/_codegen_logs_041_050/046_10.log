+def _tile_to_full_mask(tile: np.ndarray, start_row: int, height: int) -> np.ndarray:
+    full = np.zeros((height, GEN_WIDTH), dtype=bool)
+    full[start_row : start_row + tile.shape[0], :] = _repeat_tile(tile)
+    return full
+
+
+def _place_component(
+    height: int,
+    period: int,
+    occupied: np.ndarray,
+    rows_r: set[int],
+    relation: str,
+    max_area: int,
+    rng: random.Random,
