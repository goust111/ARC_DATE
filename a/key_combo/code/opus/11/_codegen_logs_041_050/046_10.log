    W=g.shape[1]
    for q in range(1,W+1):
      if np.array_equal(g[:,q:], g[:,:-q]): return q
    return W

def forb(mask):
    out=mask.copy(); H,W=mask.shape
    for r,c in zip(*np.where(mask)):
      for nr,nc in neigh8(r,c):
        if 0<=nr<H and 0<=nc<W: out[nr,nc]=1
    return out

def grow_connected(h,w,area):
    start=(rng.randrange(h),rng.randrange(w)); cells={start}; frontier={start}
    while len(cells)<area and frontier:
      base=rng.choice(tuple(frontier))
      nbr=[(nr,nc) for nr,nc in neigh8(*base) if 0<=nr<h and 0<=nc<w and (nr,nc) not in cells]
      if not nbr:
        frontier.remove(base); continue
      nxt=rng.choice(nbr); cells.add(nxt); frontier.add(nxt)
    a=np.zeros((h,w),bool)
    for r,c in cells: a[r,c]=1
    return a

