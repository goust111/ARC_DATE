+def _forbidden_mask(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    coords = np.argwhere(mask)
+    for r0, c0 in coords:
+        r = int(r0)
+        c = int(c0)
+        for nr, nc in _neighbors8(r, c):
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
