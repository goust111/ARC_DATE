+
+    largest_phase = np.where(_component_phase_map(g, largest, period) != BG, 1, 0)
+    assert _minimal_horizontal_period(largest_phase) == period
+
+    outside_rows = []
+    largest_set = set(largest)
+    for r in range(g.shape[0]):
