+ORANGE = 7
+BLUE = 1
+BLACK = 0
+MARK_COLORS = (2, 3, 4, 6)
+
+GEN_ATTEMPTS = 400
+LAYOUTS = ((1, 3), (3, 1), (2, 2))
+MIN_DENSITY = 0.30
+MAX_DENSITY = 0.50
+MIN_MISSING = 0.10
+MAX_MISSING = 0.20
