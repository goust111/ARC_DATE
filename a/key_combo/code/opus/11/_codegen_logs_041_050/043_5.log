+    out = np.zeros_like(panels[0], dtype=int)
+    for panel in panels:
+        mask = panel != BLACK
+        clash = mask & (out != BLACK) & (out != panel)
+        assert not np.any(clash), "panel overlay conflict"
+        out[mask] = panel[mask]
+    return out
