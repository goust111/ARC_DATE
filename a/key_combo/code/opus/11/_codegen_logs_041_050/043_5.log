+def _bands(length: int, separators: Iterable[int]) -> list[tuple[int, int]]:
+    bands: list[tuple[int, int]] = []
+    start = 0
+    for idx in sorted(int(x) for x in separators):
+        if start < idx:
+            bands.append((int(start), int(idx)))
+        start = int(idx) + 1
+    if start < int(length):
+        bands.append((int(start), int(length)))
+    return bands
