+        expected = np.full_like(patch, bg)
+        expected[1, :] = GREY
+        expected[-1, :] = GREY
+        expected[2:-1, 0] = GREY
+        expected[2:-1, -1] = GREY
+        if left_cap:
+            expected[0, :2] = GREY
+            direction = "right"
+        else:
+            expected[0, -2:] = GREY
+            direction = "left"
+        if not np.array_equal(patch, expected):
+            raise AssertionError("grey component is not a valid capped hollow frame")
