+    seq_offset = frame["seq_offset"]
+    for idx, color in enumerate(frame["seq"]):
+        grid[seq_row, left + 1 + seq_offset + idx] = int(color)
+
+
+def _candidate_positions(frame: dict, shape: tuple[int, int], occupied: set[tuple[int, int]]) -> list[dict]:
