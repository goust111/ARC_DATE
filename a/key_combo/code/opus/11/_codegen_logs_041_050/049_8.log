+    seq_row = bottom + 1
+    seq_offset = frame["seq_offset"]
+    for idx in range(len(frame["seq"])):
+        cells.add((seq_row, left + 1 + seq_offset + idx))
+    return cells
+
+
+def _draw_frame(grid: np.ndarray, frame: dict) -> None:
+    top = frame["top"]
+    left = frame["left"]
+    bottom = frame["bottom"]
+    right = frame["right"]
+
