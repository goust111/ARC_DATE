+def _filled_grid(grid: np.ndarray, frames: list[dict]) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for frame in frames:
+        top = frame["top"]
+        left = frame["left"]
+        bottom = frame["bottom"]
+        right = frame["right"]
+        seq = frame["seq"]
