+    expected = _scale2(_filled_grid(grid, frames))
+    if not np.array_equal(main(grid), expected):
+        return None
+    if not _non_degenerate(grid, frames):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
