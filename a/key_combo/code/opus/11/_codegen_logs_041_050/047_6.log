+        if descending
+        else (lambda obj: (obj["area"], obj["bbox0"][0], obj["bbox0"][1]))
+    )
+    ordered = sorted(objects, key=key)
+
+    occupied: set[tuple[int, int]] = set()
+    placed: list[dict] = []
+    for obj in ordered:
+        row = int(obj["src_row"])
+        col = int(obj["src_col"])
+        if blocking:
+            while row > 1 and not any((row + r - 1, col + c) in occupied for r, c in obj["shape"]):
