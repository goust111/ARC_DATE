SIDE_MARGIN_MAX = 3

# Red bars and rejection sampling.
RED_COUNT_MIN, RED_COUNT_CAP = 1, 5
RED_BAR_HEIGHT_RANGE, INPUT_GAP_MIN = (1, 7), 3
