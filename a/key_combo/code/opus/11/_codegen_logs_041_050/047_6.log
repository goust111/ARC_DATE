+            need_occlusion = idx > 0 and not have_occlusion
+            filtered = [
+                cand
+                for cand in candidates
+                if (not need_overlap or cand[6]) and (not need_occlusion or cand[7] > 0)
+            ]
+            if not filtered:
+                filtered = [cand for cand in candidates if not need_overlap or cand[6]]
+            if not filtered:
