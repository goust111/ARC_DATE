+    inp = np.zeros((h, w), dtype=int)
+    inp[0, :] = BAR
+    for obj, color in zip(final_objs, colors):
+        obj["color"] = int(color)
+        for dr, dc in obj["shape"]:
+            inp[obj["src_row"] + dr, obj["col"] + dc] = int(color)
+
