}

def norm(c):
    r0=min(r for r,_ in c); c0=min(c for _,c in c)
    return frozenset((r-r0,cc-c0) for r,cc in c)

def variants(base):
    out=set(); cur=set(base)
    for _ in range(4):
        maxr=max(r for r,_ in cur)
        maxc=max(c for _,c in cur)
        out.add(norm(cur))
        out.add(norm({(r,maxc-c) for r,c in cur}))
        cur={(c,maxr-r) for r,c in cur}
    return [set(v) for v in out]
shape_vars={a:[] for a in SHAPES}
for a,l in SHAPES.items():
