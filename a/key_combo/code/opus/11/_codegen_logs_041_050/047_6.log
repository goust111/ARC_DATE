    for b in l:
        for v in variants(b):
            k=tuple(sorted(v))
            if k not in seen:
                seen.add(k); shape_vars[a].append(set(v))

def bbox(shape,row,col):
    return row, col, row+max(r for r,_ in shape), col+max(c for _,c in shape)

def slide(shape,start_row,col,occupied):
    row=start_row
    while row>1 and not any((row+r-1,col+c) in occupied for r,c in shape):
        row-=1
    px={(row+r,col+c) for r,c in shape}
    return row, px, bbox(shape,row,col)

def rect_overlap(a,b):
    r0=max(a[0],b[0]); c0=max(a[1],b[1]); r1=min(a[2],b[2]); c1=min(a[3],b[3])
