+        else:
+            row = 1
+        pixels = {(row + r, col + c) for r, c in obj["shape"]}
+        bbox = _bbox_from_shape(obj["shape"], row, col)
+        placed.append({**obj, "row": row, "col": col, "pixels": pixels, "bbox": bbox})
+        occupied |= pixels
+
+    for i, obj in enumerate(placed):
+        visible = set(obj["pixels"])
+        if occlusion:
