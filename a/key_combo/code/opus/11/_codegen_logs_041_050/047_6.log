            if not good:
                good=[c for c in candlist if (not need_col or c[6])]
            if not good:
                good=candlist
            shape,col,sr,row,px,bb,overlap_cols,occount=rnd.choice(good)
            placed.append({'area':a,'shape':shape,'col':col,'final_row':row,'bbox':bb,'h':max(r for r,_ in shape)+1,'w':max(c for _,c in shape)+1})
            occ|=px
            occluded |= occount>0
            colover |= overlap_cols
            blocked |= row>1
        else:
            if occluded and colover and blocked:
                # choose source rows backtracking
                placed_sorted=placed[:]  # same order desc
                def input_pixels(obj, src):
                    return {(src+r, obj['col']+c) for r,c in obj['shape']}
                choices=[]
                for obj in placed_sorted:
                    mx=min(14, H-obj['h'])
                    rows=[r for r in range(max(4,obj['final_row']+2), mx+1)]
                    rnd.shuffle(rows)
                    choices.append(rows)
                assign=[]
                occ_in=set()
                def bt(i):
                    if i==len(placed_sorted): return True
                    obj=placed_sorted[i]
                    for src in choices[i]:
                        px=input_pixels(obj, src)
                        if px & occ_in: continue
                        assign.append(src); occ_in.update(px)
                        if bt(i+1): return True
                        assign.pop(); occ_in.difference_update(px)
                    return False
                if bt(0):
                    for obj,src in zip(placed_sorted,assign): obj['src_row']=src
                    return H,W,placed_sorted
    return None

rnd=random.Random(1)
for i in range(20):
    s=choose_scene(rnd)
    print('scene',i, bool(s), s[:2] if s else None)
