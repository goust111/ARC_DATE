+                    if src_row_probe < 4:
+                        continue
+                    row = src_row_probe
+                    while row > 1 and not any((row + r - 1, col + c) in occupied for r, c in shape):
+                        row -= 1
+                    if idx == 0 and row != 1:
+                        continue
+                    if idx > 0 and row == 1:
+                        continue
+
+                    bbox = _bbox_from_shape(shape, row, col)
