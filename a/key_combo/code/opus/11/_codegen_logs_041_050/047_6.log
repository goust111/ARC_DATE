                if row<1 or row>=start_row: pass
                if idx==0 and row"'!=1: continue
                if idx>0 and row==1: 
                    continue
                # source possible
                possible=[sr for sr in range(max(row+2,4), min(14,H-h)+1)]
                if not possible: continue
                col_ol=False
                occount=0
                for p in placed:
                    olw=min(bb[3],p['"'bbox'][3])-max(bb[1],p['bbox'][1])+1
                    if 1<=olw<=2:
                        col_ol=True
                    rect=overlap_rect(bb,p['bbox'])
                    if rect:
                        r0,c0,r1,c1=rect
                        occount += sum(r0<=r<=r1 and c0<=c<=c1 for r,c in px)
                # prefer needed features
                need_ol = idx>0 and (not any(1<=min(o['bbox'][3],p['bbox'][3])-max(o['bbox'][1],p['bbox'][1])+1<=2 for oi,o in enumerate(placed) for p in placed[:oi]))
                if need_ol and not col_ol: 
                    continue
                need_occ = idx>0 and occluded==0
                if need_occ and occount==0:
                    continue
                chosen=(shape,col,start_row,row,px,bb,occount)
                break
            if chosen: break
        if not chosen:
            ok=False; break
        shape,col,src,row,px,bb,occount=chosen
