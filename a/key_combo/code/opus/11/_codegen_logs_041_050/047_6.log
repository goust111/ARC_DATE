}

def norm(c):
    r0=min(r for r,_ in c); c0=min(c for _,c in c)
    return frozenset((r-r0,cc-c0) for r,cc in c)

def vars(base):
    arr=np.array(list(base))
    out=set()
    cells=set(base)
    cur=set(base)
    for _ in range(4):
        maxr=max(r for r,_ in cur); maxc=max(c for _,c in cur)
        out.add(norm(cur))
        mir={(r,maxc-c) for r,c in cur}
        out.add(norm(mir))
        cur={(c,maxr-r) for r,c in cur}
    return [set(v) for v in out]

shape_vars={a:[v for b in lst for v in vars(b)] for a,lst in SHAPES.items()}
for a in shape_vars:
    uniq=[]; seen=set()
    for s in shape_vars[a]:
        k=tuple(sorted(s))
        if k not in seen:
            seen.add(k); uniq.append(s)
    shape_vars[a]=uniq
print({a:len(v) for a,v in shape_vars.items()})

def bbox(cells,row,col):
    rs=[row+r for r,_ in cells]; cs=[col+c for _,c in cells]
    return min(rs),min(cs),max(rs),max(cs)

def slide(shape,start_row,col,occupied):
    row=start_row
    while row>1:
        if any((row+r-1,col+c) in occupied for r,c in shape):
            break
        row-=1
    px={(row+r,col+c) for r,c in shape}
    return row,px,bbox(shape,row,col)

def overlap_rect(b1,b2):
    r0=max(b1[0],b2[0]); c0=max(b1[1],b2[1]); r1=min(b1[2],b2[2]); c1=min(b1[3],b2[3])
