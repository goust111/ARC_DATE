+                    "area": len(coords),
+                    "src_row": int(r0),
+                    "src_col": int(c0),
+                    "bbox0": (int(r0), int(c0), int(max(rows)), int(max(cols))),
+                    "shape": shape,
+                }
+            )
+    return objs
