+        max_r = max(r for r, _ in cur)
+        max_c = max(c for _, c in cur)
+        out.add(_normalize_cells(cur))
+        out.add(_normalize_cells({(r, max_c - c) for r, c in cur}))
+        cur = {(c, max_r - r) for r, c in cur}
+    return [set(v) for v in out]
