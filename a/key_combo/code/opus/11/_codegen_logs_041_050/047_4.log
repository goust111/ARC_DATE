+from __future__ import annotations
+
+from collections import deque
+from itertools import permutations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+MARKER_COLORS = (RED, BLUE, ORANGE)
+RANK_RECOLORS = (RED, BLUE, YELLOW)
+
