+                if np.any(reserved & candidate["mask"]):
+                    continue
+                chosen = candidate
+                break
+            if chosen is None:
+                shapes = []
+                break
+            shapes.append(chosen)
+            reserved |= _dilate8(chosen["mask"])
+
+        if len(shapes) != 3:
+            continue
+
+        colors = list(MARKER_COLORS)
+        np.random.shuffle(colors)
+        for shape, color in zip(shapes, colors):
