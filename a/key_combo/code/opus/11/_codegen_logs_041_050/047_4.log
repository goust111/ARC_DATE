+            assert max(abs(r0 - r1), abs(c0 - c1)) > 1, "grey pixels must be isolated"
+        for mr, mc in marker_coords:
+            assert max(abs(r0 - mr), abs(c0 - mc)) > 1, "grey pixels must not touch markers"
+
