+def _capacity_up_to_six(coords: list[tuple[int, int]], shape: tuple[int, int]) -> int:
+    for target in range(min(6, len(coords)), 1, -1):
+        if _pick_isolated_cells(coords, target, shape) is not None:
+            return target
+    return 1
