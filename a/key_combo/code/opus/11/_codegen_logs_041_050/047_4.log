+        p = (int(np.random.randint(r_lo, r_hi + 1)), int(np.random.randint(c_lo, c_hi + 1)))
+        q = (p[0] + int(straight_vec[0] + diag_vec[0]), p[1] + int(straight_vec[1] + diag_vec[1]))
