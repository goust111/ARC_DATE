+    straight_vec, diag_vec, dominant_axis = _decompose_marker_vector(p, q)
+    straight_corner = (p[0] + straight_vec[0], p[1] + straight_vec[1])
+    diag_corner = (p[0] + diag_vec[0], p[1] + diag_vec[1])
+
