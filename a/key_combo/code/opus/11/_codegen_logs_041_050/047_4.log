+            ],
+            dtype=int,
+        )
+        margin = int(np.random.choice(np.array([1, 1, 2], dtype=int)))
+        r_lo = int(margin - np.min(rel[:, 0]))
+        r_hi = int((h - 1 - margin) - np.max(rel[:, 0]))
+        c_lo = int(margin - np.min(rel[:, 1]))
+        c_hi = int((w - 1 - margin) - np.max(rel[:, 1]))
+        if r_lo > r_hi or c_lo > c_hi:
