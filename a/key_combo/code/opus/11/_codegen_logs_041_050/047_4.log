+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        h = int(np.random.randint(GRID_MIN, GRID_MAX + 1))
+        w = int(np.random.randint(GRID_MIN, GRID_MAX + 1))
