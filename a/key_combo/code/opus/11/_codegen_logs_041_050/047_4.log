+    for rank, shape in enumerate(ranked):
+        recolor_mask = shape["interior"] & (g == GREY)
+        assert int(np.count_nonzero(recolor_mask)) == shape["grey_count"]
+        assert np.all(out[recolor_mask] == RANK_RECOLORS[rank])
+
+    outside_mask = (g == GREY).copy()
