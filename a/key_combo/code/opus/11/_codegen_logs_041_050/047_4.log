+    diag_len = min(abs_dr, abs_dc)
+    straight_len = abs(abs_dr - abs_dc)
+    sr = _sign(dr)
+    sc = _sign(dc)
+    diag_vec = (sr * diag_len, sc * diag_len)
+    if abs_dr > abs_dc:
+        return (sr * straight_len, 0), diag_vec, "row"
+    return (0, sc * straight_len), diag_vec, "col"
