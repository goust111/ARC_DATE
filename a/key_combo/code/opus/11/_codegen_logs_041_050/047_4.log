+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+MARKER_COLORS = (RED, BLUE, ORANGE)
+RANK_RECOLORS = (RED, BLUE, YELLOW)
+
+GRID_MIN = 18
+GRID_MAX = 25
+DIAG_LEN_RANGE = (3, 6)
+STRAIGHT_LEN_RANGE = (3, 7)
+COUNT_PATTERNS = ((2, 4, 6), (2, 3, 5), (2, 4, 5), (3, 4, 6))
+TOTAL_GREY_RANGE = (15, 25)
