+        if counts is None:
+            continue
+
+        grid = _build_grid_from_shapes(h, w, shapes, counts)
+        if grid is None:
+            continue
+
+        try:
+            _validate_generated_input(grid)
+        except AssertionError:
+            continue
+        return grid
