+    perimeter = np.zeros(shape, dtype=bool)
+    for a, b in ((p, straight_corner), (p, diag_corner), (straight_corner, q), (diag_corner, q)):
+        for r, c in _segment_cells(a, b):
+            assert _in_bounds(shape, r, c)
