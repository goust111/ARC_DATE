+        reserved = np.zeros((h, w), dtype=bool)
+
+        for dominant_axis in branch_plan:
+            chosen = None
+            for _ in range(SHAPE_ATTEMPTS):
+                candidate = _sample_shape(h, w, dominant_axis)
