+    assert {"row", "col"} <= {shape["dominant_axis"] for shape in shapes}
+
+    dilated_occupied = np.zeros(g.shape, dtype=bool)
+    for shape in shapes:
+        assert not np.any(dilated_occupied & shape["mask"])
+        dilated_occupied |= _dilate8(shape["mask"])
