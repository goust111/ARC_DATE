+        p = tuple(map(int, marker_coords[0]))
+        q = tuple(map(int, marker_coords[1]))
+        info = _shape_from_markers(g.shape, marker_color, p, q)
+        assert not np.any(occupied & info["mask"]), "parallelograms must not overlap"
+        occupied |= info["mask"]
