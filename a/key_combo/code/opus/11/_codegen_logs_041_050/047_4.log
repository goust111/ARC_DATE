+        branch_plan = ["row", "col", str(np.random.choice(np.array(["row", "col"], dtype=object)))]
+        np.random.shuffle(branch_plan)
+        shapes: list[dict] = []
+        reserved = np.zeros((h, w), dtype=bool)
