+def _line_is_tree(grid: np.ndarray) -> bool:
+    mask = grid == WALL
+    comps = components_mask(mask, connectivity=4)
+    if len(comps) != 1:
+        return False
+    vertices = int(mask.sum())
+    edge_count = int((mask[:, :-1] & mask[:, 1:]).sum() + (mask[:-1, :] & mask[1:, :]).sum())
+    return edge_count == vertices - 1
+
+
+def _fill_by_order(grid: np.ndarray, regions: list[dict], order_key) -> np.ndarray:
+    out = grid.copy()
+    ordered = sorted(regions, key=order_key)
