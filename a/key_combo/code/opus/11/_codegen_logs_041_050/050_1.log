+    if np.array_equal(out, by_smallest_first):
+        return False
+
+    return True
+
+
+def _sample_split(count: int) -> tuple[int, int]:
+    candidates = [(a, count - a) for a in range(1, count) if max(a, count - a) <= 3]
+    return random.choice(candidates)
+
+
