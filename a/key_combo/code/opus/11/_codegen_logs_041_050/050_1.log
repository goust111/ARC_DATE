spec:
  grid: 21-25 rows x 21-25 cols, black background
  line_object:
    color: single non-black color (any except black/green/red)
    structure: 1-pixel-wide rectilinear graph of H and V segments, all 4-connected as one component
    h_segments: 4-5, lengths 5-25
    v_segments: 3-5, lengths 7-22
    total_segments: 7-9
    intersections: 8-11 points, mostly degree-4 (+) with 0-1 degree-3 (T)
    endpoints: 13-18 degree-1 cells; 1-2 on grid border, rest interior (dist 1-10 from border)
    no_2x2_blocks: true (pure 1-pixel-wide lines)
    gap_between_parallel_segments: 3-7 cells
    fg_ratio: 0.18-0.22 of grid area
  enclosed_regions:
    count: 2-3 (bounded faces of planar graph = E - V + 1 where V=vertices, E=edges)
    sizes: 6-66 cells each, at least one large (>=15) region
  border_contact: line touches 1-2 grid borders (via H-segment endpoints or V-segment endpoints)
  transform:
    exterior_bg (4-connected to border) -> green
    enclosed_bg (not 4-connected to border) -> red
    line pixels preserved

generation_strategy:
  approach: build rectilinear graph directly, verify enclosed regions exist
  steps:
    1. Pick grid size 21-25 x 21-25 and a fg color (not black/green/red)
    2. Place 3-5 vertical lines at random columns (gaps 3-7), each spanning a large row range (7-22 rows)
    3. Place 4-5 horizontal lines at random rows (gaps 3-7), each spanning a large col range (5-25 cols)
    4. Ensure each H/V segment intersects at least one perpendicular segment (4-connected)
    5. Trim some segment endpoints so not all reach the border -- keep 1-2 border-touching endpoints
    6. Verify the result is one 4-connected component with no 2x2 blocks
    7. Flood-fill from border to find exterior; verify >=2 enclosed (non-border-connected) bg regions exist
    8. If validation fails, retry from step 2
```
