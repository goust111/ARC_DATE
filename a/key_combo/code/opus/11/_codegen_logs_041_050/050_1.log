+def _enclosed_regions(grid: np.ndarray) -> list[dict]:
+    exterior = _exterior_mask(grid)
+    enclosed = (grid == BACKGROUND) & (~exterior)
+    regions = []
+    for coords in components_mask(enclosed, connectivity=4):
+        regions.append(
+            {
+                "coords": coords,
+                "area": int(coords.shape[0]),
+                "bbox": _bbox(coords),
+            }
