+    right_rows: list[int],
+) -> np.ndarray:
+    width = left_width + right_width + 3
+    spine_col = left_width + 1
+    grid = np.zeros((height, width), dtype=int)
+    grid[:, spine_col] = WALL
+    for row in left_rows:
+        grid[row, : spine_col + 1] = WALL
+    for row in right_rows:
+        grid[row, spine_col:] = WALL
+    return grid
