+        grid[row, : spine_col + 1] = WALL
+    for row in right_rows:
+        grid[row, spine_col:] = WALL
+    return grid
+
+
+def _line_is_tree(grid: np.ndarray) -> bool:
+    mask = grid == WALL
+    comps = components_mask(mask, connectivity=4)
+    if len(comps) != 1:
+        return False
+    vertices = int(mask.sum())
