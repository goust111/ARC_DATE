+    for r in range(h):
+        for c in range(w):
+            if seen[r, c]:
+                continue
+            color = int(patch[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: set[tuple[int, int]] = set()
+            touches = False
+            while q:
+                rr, cc = q.popleft()
+                cells.add((rr, cc))
+                touches |= rr in (0, h - 1) or cc in (0, w - 1)
