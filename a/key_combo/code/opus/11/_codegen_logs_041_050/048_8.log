+
+BG = 5
+NOISE = 4
+PAYLOAD_COLORS = (1, 2, 3, 6, 7, 8, 9)
+NEIGHBORS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+GEN_RETRIES = 400
