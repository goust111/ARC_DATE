+            if seen[r, c]:
+                continue
+            color = int(patch[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: set[tuple[int, int]] = set()
+            touches = False
+            while q:
+                rr, cc = q.popleft()
+                cells.add((rr, cc))
