+def _connected_prefix(component: set[tuple[int, int]], size: int) -> list[tuple[int, int]] | None:
+    boundary_cells = [cell for cell in component]
+    random.shuffle(boundary_cells)
+    for start in boundary_cells:
+        q = deque([start])
+        seen = {start}
+        ordered: list[tuple[int, int]] = []
+        while q and len(ordered) < size:
+            cell = q.popleft()
+            ordered.append(cell)
+            for dr, dc in NEIGHBORS4:
