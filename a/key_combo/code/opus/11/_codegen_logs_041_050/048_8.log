+    if not any(action["decision"] == "delete" for action in analysis["noise_actions"]):
+        return None
+    if not np.array_equal(analysis["seed"], _scale2(template)):
+        return None
+    if max(grid.shape) > 30 or max(analysis["seed"].shape) > 30:
+        return None
+    return grid
