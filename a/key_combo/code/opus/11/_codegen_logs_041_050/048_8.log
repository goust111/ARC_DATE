+    seen = set()
+    start = tuple(map(int, coords[0]))
+    q = deque([start])
+    seen.add(start)
+    target = {tuple(map(int, rc)) for rc in coords}
+    while q:
+        r, c = q.popleft()
+        for dr, dc in NEIGHBORS4:
+            nxt = (r + dr, c + dc)
+            if nxt in target and nxt not in seen:
+                seen.add(nxt)
+                q.append(nxt)
