+    occupied = np.zeros((h, w), dtype=bool)
+
+    tr = random.randint(0, 1)
+    tc = random.randint(0, 1)
+    _paint_patch(grid, template, (tr, tc))
+    occupied[max(0, tr - 1) : min(h, tr + template.shape[0] + 1), max(0, tc - 1) : min(w, tc + template.shape[1] + 1)] = True
