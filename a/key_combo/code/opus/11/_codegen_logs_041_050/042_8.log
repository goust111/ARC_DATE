+    same_parity = (rr % 2 == parity[0]) & (cc % 2 == parity[1])
+
+    assert np.count_nonzero((grid == BLACK) & inside & same_parity) >= 4
+    assert np.any((grid == BLACK) & inside & ~same_parity)
+    assert np.any((grid == BLACK) & ~inside & same_parity)
