+def _bag_pick(name: str, options: tuple[object, ...] | list[object]) -> object:
+    bag = _GEN_BAGS.get(name)
+    if not bag:
+        bag = list(options)
+        random.shuffle(bag)
+        _GEN_BAGS[name] = bag
