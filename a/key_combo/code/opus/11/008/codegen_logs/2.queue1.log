+def _build_input(rect_specs: list[dict], shape: tuple[int, int]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for rect in rect_specs:
+        r = int(rect["r"])
+        c = int(rect["c"])
+        h = int(rect["h"])
+        w = int(rect["w"])
+        grid[r : r + h, c : c + w] = int(rect["color"])
+    return grid
+
