+
+def _enumerate_instances(rect: dict, shape: tuple[int, int], source: int) -> list[dict]:
+    h = int(rect["h"])
+    w = int(rect["w"])
+    r0 = int(rect["r"])
+    c0 = int(rect["c"])
+    grid_h, grid_w = shape
+
+    instances: list[dict] = []
+    for step, direction in ((0, 0),):
+        body = _body_cells(shape, r0, c0, h, w)
+        instances.append(
