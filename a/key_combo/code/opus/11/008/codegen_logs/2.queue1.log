+                    "source": int(source),
+                    "color": int(rect["color"]),
+                    "step": int(step),
+                    "direction": int(direction),
+                    "r": int(rr),
+                    "c": int(cc),
+                    "h": h,
+                    "w": w,
+                    "body": body,
+                    "halo": _halo_cells(shape, rr, cc, h, w),
+                    "clipped": len(body) < h * w,
+                }
+            )
+            step += 1
