+    grid_h, grid_w = shape
+    rr0 = max(0, int(r))
+    cc0 = max(0, int(c))
+    rr1 = min(grid_h, int(r + h))
+    cc1 = min(grid_w, int(c + w))
+    if rr0 >= rr1 or cc0 >= cc1:
+        return set()
+    return {(rr, cc) for rr in range(rr0, rr1) for cc in range(cc0, cc1)}
