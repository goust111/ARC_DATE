+                "source": int(source),
+                "color": int(rect["color"]),
+                "step": int(step),
+                "direction": int(direction),
+                "r": int(r0),
+                "c": int(c0),
+                "h": h,
+                "w": w,
+                "body": body,
+                "halo": _halo_cells(shape, r0, c0, h, w),
+                "clipped": False,
+            }
+        )
