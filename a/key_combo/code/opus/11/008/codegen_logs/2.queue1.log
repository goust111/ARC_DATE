+        for c in range(0, grid_w - w + 1):
+            probe = {"color": 1, "r": r, "c": c, "h": h, "w": w}
+            counts = _direction_counts(_enumerate_instances(probe, (grid_h, grid_w), 0))
+            if counts[-1] >= min_steps and counts[1] >= min_steps:
+                if counts[-1] <= 5 and counts[1] <= 5:
