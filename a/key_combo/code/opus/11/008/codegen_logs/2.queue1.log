+DIM_OPTIONS = ((2, 3), (3, 2), (2, 4), (4, 2), (3, 3), (3, 4), (4, 3))
+COLOR_OPTIONS = (2, 3, 6, 7, 8, 9)
+GRID_RANGE = (18, 25)
