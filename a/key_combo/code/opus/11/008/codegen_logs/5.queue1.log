+    h, w = grid.shape
+    sr, sc = start
+    dist = np.full((h, w), -1, dtype=int)
+    dq = deque([(int(sr), int(sc))])
+    dist[int(sr), int(sc)] = 0
+    while dq:
+        r, c = dq.popleft()
+        nd = int(dist[r, c]) + 1
+        for rr, cc in _neighbors4(r, c):
+            if 0 <= rr < h and 0 <= cc < w and dist[rr, cc] == -1:
+                if int(grid[rr, cc]) in (BG, BAR, MARKER):
+                    dist[rr, cc] = nd
+                    dq.append((int(rr), int(cc)))
+    return dist
