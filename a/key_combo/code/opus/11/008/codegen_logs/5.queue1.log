+    if int(np.count_nonzero(grid == WALL)) < 10 or int(np.count_nonzero(grid == WALL)) > 20:
+        return False
+
+    bars_by_col = {int(bar["col"]): int(bar["height"]) for bar in details["bars"]}
+    expected_bars = dict(meta["reachable_map"])
