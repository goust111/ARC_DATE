+def _find_bars(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    bars: list[dict] = []
+    used = np.zeros_like(grid, dtype=bool)
+    for c in range(w):
+        if int(grid[h - 1, c]) != BAR:
+            continue
+        r = h - 1
+        rows: list[int] = []
+        while r >= 0 and int(grid[r, c]) == BAR:
+            rows.append(r)
+            used[r, c] = True
+            r -= 1
+        rows.reverse()
+        bars.append(
