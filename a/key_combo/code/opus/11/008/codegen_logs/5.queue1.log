+                "rows": np.array(rows, dtype=int),
+                "height": int(len(rows)),
+                "bottom": (int(h - 1), int(c)),
+            }
+        )
+    assert not np.any((grid == BAR) & (~used)), "all maroon cells must belong to bottom-aligned vertical bars"
+    return bars
