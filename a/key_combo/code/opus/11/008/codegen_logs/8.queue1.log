    return random.randint(lo, hi)


def _gen_marker_slots(h: int, w: int) -> list[tuple[int, int]]:
    offset = GEN_MARKER_CORNER_OFFSET
    slots = [
        (offset, offset),
        (offset, w - offset - 1),
        (h - offset - 1, offset),
        (h - offset - 1, w - offset - 1),
    ]
    random.shuffle(slots)
    return slots[:GEN_MARKER_COUNT]


