+
+
+def _choose_corner(code_pixels: list[tuple[int, int, int]], lattice_n: int) -> list[tuple[int, int, int]]:
+    orientations = []
+    for flip_r in (False, True):
+        for flip_c in (False, True):
+            local = []
+            for lr, lc, color in code_pixels:
