+    used_colors = random.sample(CODE_COLORS, num_rings + len(chosen))
+    corner_colors = {depth: used_colors[depth] for depth in range(num_rings)}
+    horizontal_colors = {}
+    vertical_colors = {}
+    cursor = num_rings
+    for axis, depth in sorted(chosen, key=lambda item: (item[1], item[0])):
+        if axis == "h":
