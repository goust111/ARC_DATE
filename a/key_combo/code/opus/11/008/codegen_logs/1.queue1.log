+    lose = int(cur_mask & ~next_mask)
+    changed = gain | lose
+    if changed == 0:
+        return int(last_color)
+    assert changed & (changed - 1) == 0, "a 4-neighbor step may cross at most one frame boundary"
+    layer_idx = changed.bit_length() - 1
+    return int(frames[layer_idx]["color"])
