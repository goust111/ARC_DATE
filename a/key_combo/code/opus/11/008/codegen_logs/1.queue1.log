+def _generate_once() -> np.ndarray:
+    h = random.randint(13, 19)
+    w = random.randint(13, 19)
+    grid, frames, branch = _build_frames((h, w))
+    _place_seed(grid, frames[0], align_with_gap=random.random() < 0.7)
