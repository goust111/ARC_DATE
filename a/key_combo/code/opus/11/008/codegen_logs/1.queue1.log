+        if side == "bottom":
+            row = random.randint(r1 + 1, h - 1)
+            grid[row, gap_c] = SEED
+            return
+        if side == "left":
+            col = random.randint(0, c0 - 1)
+            grid[gap_r, col] = SEED
+            return
+        col = random.randint(c1 + 1, w - 1)
+        grid[gap_r, col] = SEED
+        return
