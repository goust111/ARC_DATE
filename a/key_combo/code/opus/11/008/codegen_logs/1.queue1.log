+    frames.sort(
+        key=lambda frame: (
+            -(frame["bbox"][2] - frame["bbox"][0] + 1) * (frame["bbox"][3] - frame["bbox"][1] + 1),
+            frame["bbox"][0],
+            frame["bbox"][1],
