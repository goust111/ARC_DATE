+            (top, left, top + outer_h - 1, left + outer_w - 1),
+            (top + gap1, left + gap1, top + outer_h - gap1 - 1, left + outer_w - gap1 - 1),
+            (
+                top + gap1 + gap2,
+                left + gap1 + gap2,
+                top + outer_h - gap1 - gap2 - 1,
+                left + outer_w - gap1 - gap2 - 1,
+            ),
