+        quad_yellow = int(np.count_nonzero(inp[r0q:r1q, c0q:c1q] == YELLOW))
+        quad_pink = int(np.count_nonzero(inp[r0q:r1q, c0q:c1q] == PINK))
+        if quadrant_index == template_quadrant:
+            if quad_yellow == 0 or quad_pink == 0:
+                return False
+            continue
+        if quad_yellow != 0 or quad_pink == 0:
+            return False
