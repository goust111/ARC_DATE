+def _expected_rotation_k(template_quadrant: int, other_quadrant: int) -> int:
+    delta = (int(other_quadrant) - int(template_quadrant)) % 4
+    mapping = {1: 3, 2: 2, 3: 1}
+    assert delta in mapping, "quadrants must differ"
+    return mapping[delta]
