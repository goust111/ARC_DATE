+        if not valid or visible_yellow == 0:
+            continue
+        candidates.append(
+            {
+                "k": int(record["k"]),
+                "mirror": bool(record["mirror"]),
+                "top": int(top),
+                "left": int(left),
+                "yellow": record["yellow"],
+                "additions": tuple(additions),
