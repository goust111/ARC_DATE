/bin/bash -lc "python - <<'PY'
import numpy as np
H,W=3,4

def orient(arr,mirror,k):
    base=np.fliplr(arr) if mirror else arr
    return np.rot90(base,k)

def norm(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    mr,mc=min(rs),min(cs)
    return tuple(sorted((r-mr,c-mc) for r,c in coords)), (mr,mc)

count=0
samples=[]
for bits in range(1,1<<(H*W)-1):
    arr=np.full((H,W),4,int)
    for i in range(H*W):
        if bits>>i &1:
            arr[i//W,i%W]=6
    y=np.argwhere(arr==4)
    if (tuple(y.min(0))+tuple(y.max(0)))"'!=(0,0,H-1,W-1):
        continue
    p=np.argwhere(arr==6)
    if len(p)<3 or len(p)>5:
        continue
    if len(set(p[:,0]))<2 or len(set(p[:,1]))<2:
        continue
    info=[]
    for mirror in [False,True]:
        for k in range(4):
            a=orient(arr,mirror,k)
            pm=[tuple(x) for x in np.argwhere(a==6)]
            py=[tuple(x) for x in np.argwhere(a==4)]
            shp,off=norm(pm)
            mr,mc=off
            yrel=tuple(sorted((r-mr,c-mc) for r,c in py))
            info.append({'"'mirror':mirror,'k':k,'shape':shp,'yrel':yrel})
    ok=True
    for need in [1,2,3]:
        target=[x for x in info if (not x['mirror'] and x['k']==need)][0]
        group=[x for x in info if x['shape']==target['shape']]
        if len(group)"'!=2:
            ok=False; break
        if sum(1 for x in group if x['"'k']==need)"'!=1:
            ok=False; break
        if len({x['"'yrel'] for x in group})<2:
            ok=False; break
    if ok:
        count+=1
        if len(samples)<20:
            samples.append(arr)
print('count',count)
for a in samples:
    print(a)
