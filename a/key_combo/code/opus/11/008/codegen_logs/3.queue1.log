+import numpy as np
+
+
+BLACK = 0
+YELLOW = 4
+PINK = 6
+
+_QUADRANT_ORDER = ("TL", "TR", "BR", "BL")
+_GEN_ROW_CHOICES = (14, 16, 18, 20)
+_GEN_COL_CHOICES = (14, 16, 18, 20)
+_GEN_TEMPLATE_SHAPE = (3, 4)
+_GEN_ATTEMPTS = 400
