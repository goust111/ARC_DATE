+
+def _quadrants(shape: tuple[int, int]) -> tuple[tuple[int, int, int, int], ...]:
+    h, w = map(int, shape)
+    hr = h // 2
+    wc = w // 2
+    return (
+        (0, hr, 0, wc),
+        (0, hr, wc, w),
+        (hr, h, wc, w),
+        (hr, h, 0, wc),
+    )
