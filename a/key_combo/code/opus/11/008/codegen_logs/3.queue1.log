/bin/bash -lc "python - <<'PY'
import itertools, numpy as np

H,W=3,4

def orients(arr):
    out=[]
    for mirror in [False,True]:
        base=np.fliplr(arr) if mirror else arr
        for k in range(4):
            a=np.rot90(base,k)
            out.append((mirror,k,a))
    return out

def norm(coords):
    rs=[r for r,c in coords]; cs=[c for r,c in coords]
    mr,mc=min(rs),min(cs)
    return tuple(sorted((r-mr,c-mc) for r,c in coords)), (mr,mc)

sol=[]
for bits in range(1,1<<(H*W)-1):
    arr=np.full((H,W),4,int)
    for i in range(H*W):
        if bits>>i &1:
            arr[i//W,i%W]=6
    y=np.argwhere(arr==4)
    if not len(y):
        continue
    r0,c0=y.min(axis=0); r1,c1=y.max(axis=0)
    if (r0,c0,r1,c1)"'!=(0,0,H-1,W-1):
        continue
    info=[]
    for mirror,k,a in orients(arr):
        pm=[tuple(x) for x in np.argwhere(a==6)]
        py=[tuple(x) for x in np.argwhere(a==4)]
        shp,off=norm(pm)
        yr,offy=norm(py)
        # yellow rel to magenta min
        mr,mc=off
        yrel=tuple(sorted((r-mr,c-mc) for r,c in py))
        info.append({'"'mirror':mirror,'k':k,'shape':shp,'off':off,'yrel':yrel,'shapehw':a.shape})
    ok=True
    ambks=[]
    for need in [1,2,3]:
        target=[x for x in info if (not x['mirror'] and x['k']==need)][0]
        group=[x for x in info if x['shape']==target['shape']]
        if len(group)<2:
            ok=False; break
        if sum(1 for x in group if x['k']==need)"'!=1:
            ok=False; break
        if len({x['"'yrel'] for x in group})<2:
            ok=False; break
        ambks.append((need,[(x['mirror'],x['k']) for x in group]))
    if ok:
        sol.append((arr,ambks))
print('count',len(sol))
for arr,amb in sol[:20]:
    print(arr)
    print(amb)
    print()
