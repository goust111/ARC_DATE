        if np.any(coords[:, 0] == GEN_BAND_BOTTOM_INDEX)
    ]


def _gen_build_band() -> tuple[np.ndarray, int, list[np.ndarray]] | None:
    grid = np.zeros(GEN_GRID_SHAPE, dtype=int)
    top = int(np.random.randint(*GEN_BAND_TOP_ROW_RANGE))
