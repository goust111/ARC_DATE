+
+    for conn in connections:
+        for r, c in conn["cells"]:
+            passable[r, c] = True
+
+    return {
+        "frames": frames,
+        "connections": connections,
+        "passable": passable,
+        "mirrored_union_by_frame": mirrored_union_by_frame,
+        "active_frames": active_frames,
+        "seed_cells": sorted(seed_cells),
+    }
+
