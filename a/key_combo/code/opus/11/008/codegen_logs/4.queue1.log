+
+def _detect_frames(grid: np.ndarray) -> list[dict]:
+    colors = {int(v) for v in np.unique(grid) if int(v) not in (BG, BLUE)}
+    comps = _same_color_components(grid, colors)
+    frames: list[dict] = []
+    for comp in comps:
+        color = comp["color"]
+        top, left, bottom, right = comp["bbox"]
+        if bottom - top < 4 or right - left < 4:
+            continue
+
+        boundary: set[tuple[int, int]] = set()
+        for c in range(left, right + 1):
+            boundary.add((top, c))
+            boundary.add((bottom, c))
+        for r in range(top + 1, bottom):
+            boundary.add((r, left))
+            boundary.add((r, right))
+
+        gaps: list[dict] = []
+        for pos in sorted(boundary):
+            if pos in comp["coords"]:
+                continue
