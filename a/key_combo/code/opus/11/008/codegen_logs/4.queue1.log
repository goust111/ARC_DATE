+            gap_records.append({"frame": idx, "gap": gap_idx, "pos": gap["pos"], "side": gap["side"]})
+
+    connections: list[dict] = []
+    for i in range(len(gap_records)):
+        for j in range(i + 1, len(gap_records)):
+            a = gap_records[i]
+            b = gap_records[j]
+            if a["frame"] == b["frame"]:
+                continue
