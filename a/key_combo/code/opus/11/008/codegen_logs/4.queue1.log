+        center = (left + right) / 2.0
+        if c < center:
+            return "left"
+        if c > center:
+            return "right"
+        return None
+    center = (top + bottom) / 2.0
+    if r < center:
+        return "top"
+    if r > center:
+        return "bottom"
+    return None
