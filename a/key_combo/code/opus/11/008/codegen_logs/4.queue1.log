+            ar, ac = a["pos"]
+            br, bc = b["pos"]
+            cells: list[tuple[int, int]] | None = None
+
+            if ar == br and {a["side"], b["side"]} == {"E", "W"}:
+                left_gap, right_gap = (a, b) if ac < bc else (b, a)
+                if left_gap["side"] != "E" or right_gap["side"] != "W":
+                    continue
+                if bc - ac < 2:
+                    continue
+                ok = True
+                for c in range(ac + 1, bc):
