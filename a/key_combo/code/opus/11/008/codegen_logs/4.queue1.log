+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.add((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
