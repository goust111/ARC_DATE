+            if side is None:
+                raise AssertionError("corners cannot be gaps")
+            gaps.append({"pos": pos, "side": side})
+
+        expected = boundary - {gap["pos"] for gap in gaps}
+        if comp["coords"] != expected:
+            raise AssertionError("non-frame component structure")
+
