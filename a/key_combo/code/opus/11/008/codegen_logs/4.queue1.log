+import numpy as np
+
+
+BG = 0
+BLUE = 1
+FRAME_COLORS = (2, 3, 5, 6, 7, 8, 9)
+FRAME_DIMS = ((5, 7), (7, 5), (5, 5))
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 500
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _same_color_components(grid: np.ndarray, colors: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.add((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "bbox": _bbox(coords)})
+    return comps
+
+
+def _gap_side(frame: dict, pos: tuple[int, int]) -> str | None:
+    top, left, bottom, right = frame["bbox"]
+    r, c = pos
+    if pos in {(top, left), (top, right), (bottom, left), (bottom, right)}:
+        return None
+    if r == top:
+        return "N"
+    if r == bottom:
+        return "S"
+    if c == left:
+        return "W"
+    if c == right:
+        return "E"
+    return None
+
+
+def _gap_inner(frame: dict, gap: dict) -> tuple[int, int]:
+    r, c = gap["pos"]
+    side = gap["side"]
+    if side == "N":
+        return r + 1, c
+    if side == "S":
+        return r - 1, c
+    if side == "W":
+        return r, c + 1
+    return r, c - 1
+
+
+def _detect_frames(grid: np.ndarray) -> list[dict]:
+    colors = {int(v) for v in np.unique(grid) if int(v) not in (BG, BLUE)}
+    comps = _same_color_components(grid, colors)
+    frames: list[dict] = []
+    for comp in comps:
+        color = comp["color"]
+        top, left, bottom, right = comp["bbox"]
+        if bottom - top < 4 or right - left < 4:
+            continue
+
+        boundary: set[tuple[int, int]] = set()
+        for c in range(left, right + 1):
+            boundary.add((top, c))
+            boundary.add((bottom, c))
+        for r in range(top + 1, bottom):
+            boundary.add((r, left))
+            boundary.add((r, right))
+
+        gaps: list[dict] = []
+        for pos in sorted(boundary):
+            if pos in comp["coords"]:
+                continue
+            if int(grid[pos]) != BG:
+                raise AssertionError("frame gap must be black")
