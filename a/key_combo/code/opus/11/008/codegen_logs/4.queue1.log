+        center = (left + right) / 2.0
+        for r in range(top + 1, bottom):
+            for c in range(left + 1, right):
+                if side == "left" and c < center:
+                    cells.append((r, c))
+                if side == "right" and c > center:
+                    cells.append((r, c))
+    else:
