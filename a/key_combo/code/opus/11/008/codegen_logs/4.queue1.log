+
+def _reflect_point(frame: dict, coord: tuple[int, int]) -> tuple[int, int]:
+    top, left, bottom, right = frame["bbox"]
+    r, c = coord
+    if _mirror_mode(frame) == "LR":
+        return r, left + right - c
+    return top + bottom - r, c
