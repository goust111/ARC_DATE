+    side_c = "S" if vdir == -1 else "N"
+
+    row_a_choices = _row_offset_choices(h_a, w_a, side_a, active_idx == 0)
+    row_b_choices = _row_offset_choices(h_b, w_b, side_b_h, False)
+    col_b_choices = _col_offset_choices(h_b, w_b, side_b_v, False)
