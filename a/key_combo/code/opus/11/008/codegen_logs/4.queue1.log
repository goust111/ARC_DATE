+    for coord in blue_cells:
+        union.add(_reflect_point(frame, coord))
+    for idx, gap in enumerate(frame["gaps"]):
+        inner = _gap_inner(frame, gap)
+        if inner in blue_cells:
+            before.add(idx)
+        if inner in union:
