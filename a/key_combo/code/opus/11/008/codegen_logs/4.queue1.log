+import numpy as np
+
+
+BG = 0
+BLUE = 1
+FRAME_COLORS = (2, 3, 5, 6, 7, 8, 9)
+FRAME_DIMS = ((5, 7), (7, 5), (5, 5))
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+GEN_RETRIES = 500
