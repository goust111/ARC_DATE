+def _gap_side(frame: dict, pos: tuple[int, int]) -> str | None:
+    top, left, bottom, right = frame["bbox"]
+    r, c = pos
+    if pos in {(top, left), (top, right), (bottom, left), (bottom, right)}:
+        return None
+    if r == top:
+        return "N"
+    if r == bottom:
+        return "S"
+    if c == left:
+        return "W"
+    if c == right:
+        return "E"
+    return None
+
+
+def _gap_inner(frame: dict, gap: dict) -> tuple[int, int]:
+    r, c = gap["pos"]
+    side = gap["side"]
+    if side == "N":
+        return r + 1, c
+    if side == "S":
+        return r - 1, c
+    if side == "W":
+        return r, c + 1
+    return r, c - 1
