+        return out
+
+    visited = np.zeros_like(g, dtype=bool)
+    q = deque(info["seed_cells"])
+    for r, c in info["seed_cells"]:
+        visited[r, c] = True
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if 0 <= nr < g.shape[0] and 0 <= nc < g.shape[1] and info["passable"][nr, nc] and not visited[nr, nc]:
