+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: set[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _same_color_components(grid: np.ndarray, colors: set[int]) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color not in colors or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: set[tuple[int, int]] = set()
+            while q:
+                rr, cc = q.popleft()
+                coords.add((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "bbox": _bbox(coords)})
+    return comps
+
+
+def _gap_side(frame: dict, pos: tuple[int, int]) -> str | None:
+    top, left, bottom, right = frame["bbox"]
+    r, c = pos
+    if pos in {(top, left), (top, right), (bottom, left), (bottom, right)}:
+        return None
+    if r == top:
+        return "N"
+    if r == bottom:
+        return "S"
+    if c == left:
+        return "W"
+    if c == right:
+        return "E"
+    return None
+
+
+def _gap_inner(frame: dict, gap: dict) -> tuple[int, int]:
+    r, c = gap["pos"]
+    side = gap["side"]
+    if side == "N":
+        return r + 1, c
+    if side == "S":
+        return r - 1, c
+    if side == "W":
+        return r, c + 1
+    return r, c - 1
