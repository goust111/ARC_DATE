+    else:
+        center = (top + bottom) / 2.0
+        for r in range(top + 1, bottom):
+            for c in range(left + 1, right):
+                if side == "top" and r < center:
+                    cells.append((r, c))
+                if side == "bottom" and r > center:
+                    cells.append((r, c))
+    return cells
+
