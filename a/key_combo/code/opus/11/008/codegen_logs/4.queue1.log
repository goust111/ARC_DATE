+            if ac == bc and {a["side"], b["side"]} == {"N", "S"}:
+                top_gap, bottom_gap = (a, b) if ar < br else (b, a)
+                if top_gap["side"] != "S" or bottom_gap["side"] != "N":
+                    continue
+                if br - ar < 2:
+                    continue
+                ok = True
+                for r in range(ar + 1, br):
