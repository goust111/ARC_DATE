+    for idx, frame in enumerate(frames):
+        top, left, bottom, right = frame["bbox"]
+        passable[top + 1 : bottom, left + 1 : right] = True
+        union = _mirrored_blue_union(frame)
+        mirrored_union_by_frame.append(union)
+        touched = False
+        for gap in frame["gaps"]:
