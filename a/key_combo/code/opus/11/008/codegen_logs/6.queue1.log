+
+BACKGROUND = 0
+BLUE = 1
+FRAME_COLORS = tuple(range(2, 10))
+GEN_RETRY_LIMIT = 500
+
+GRID_HEIGHT_RANGE = (18, 26)
+GRID_WIDTH_RANGE = (18, 26)
+WIDE_OUTER_HEIGHT_RANGE = (6, 8)
+WIDE_OUTER_WIDTH_RANGE = (8, 11)
+TALL_OUTER_HEIGHT_RANGE = (8, 11)
+TALL_OUTER_WIDTH_RANGE = (6, 8)
