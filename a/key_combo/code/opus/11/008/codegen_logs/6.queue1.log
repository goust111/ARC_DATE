+        color = int(vals[0])
+        r0, c0, r1, c1 = _bbox_from_coords(coords)
+        height = r1 - r0 + 1
+        width = c1 - c0 + 1
+        if height < 3 or width < 3:
+            continue
+        expected = _frame_border_mask(height, width)
+        observed = grid[r0 : r1 + 1, c0 : c1 + 1] == color
+        if not np.array_equal(expected, observed):
+            continue
+        frames.append(
+            {
+                "color": color,
+                "bbox": (r0, c0, r1, c1),
