+def _render_output(
+    shape: tuple[int, int],
+    sources: list[dict],
+    *,
+    sprite_overrides: dict[int, np.ndarray] | None = None,
+    stride_overrides: dict[int, tuple[int, int]] | None = None,
+    reverse_priority: bool = False,
+    only_original: bool = False,
