+    left_col = int(np.random.randint(center_c - radius + 2, center_c - 1))
+    right_col = int(np.random.randint(center_c + 2, center_c + radius - 1))
+    grid[center_r, left_col] = BLOCKER
+    grid[center_r, right_col] = BLOCKER
+
+    offset = int(np.random.randint(1, min(2, radius - 2) + 1))
+    tie_above = bool(np.random.randint(2))
+    tie_row = center_r - offset if tie_above else center_r + offset
+    grid[tie_row, center_c] = BLOCKER
+
