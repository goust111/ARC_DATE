+def _interior_mask(shape: tuple[int, int], center_r: int, center_c: int, radius: int) -> np.ndarray:
+    rows = np.arange(shape[0])[:, None]
+    cols = np.arange(shape[1])[None, :]
+    return np.abs(rows - center_r) + np.abs(cols - center_c) < radius
