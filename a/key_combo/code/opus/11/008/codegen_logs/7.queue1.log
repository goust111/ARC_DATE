+        if inside:
+            entered = True
+            if int(grid[rr, cc]) != BG:
+                return "blocker" if int(grid[rr, cc]) == BLOCKER else "other"
+        elif entered:
+            return "frame"
+        rr += dr
+        cc += dc
+    return "none"
+
