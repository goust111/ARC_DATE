from importlib.machinery import SourceFileLoader
import numpy as np
p='/home/lixinyu/snap/a/key_combo/code/opus/11/008/7.py'
mod=SourceFileLoader('m',p).load_module()

def search(radius):
    h=w=2*radius+7
    cr=cc=h//2
    base=np.full((h,w), mod.BG, dtype=int)
    mod._draw_diamond(base, cr, cc, radius)
    m=mod._marker_positions(cr,cc,radius)
    base[m['left']]=mod.RAY; base[m['right']]=mod.RAY; base[m['top']]=mod.PATH; base[m['bottom']]=mod.PATH
    interior=[(r,c) for r in range(h) for c in range(w) if abs(r-cr)+abs(c-cc)<radius]
    top_entry=mod._entry_inside(m['top'],(1,0),cr,cc,radius,base.shape)
    bottom_entry=mod._entry_inside(m['bottom'],(-1,0),cr,cc,radius,base.shape)
    left_entry=mod._entry_inside(m['left'],(0,1),cr,cc,radius,base.shape)
    right_entry=mod._entry_inside(m['right'],(0,-1),cr,cc,radius,base.shape)
    bad={top_entry,bottom_entry,left_entry,right_entry}
    found=[]
    for l_off in range(-(radius-2), -1):
      for r_off in range(2, radius-1):
        for br in interior:
          if br[0]==cr and br[1] in (cc+l_off, cc+r_off):
            continue
          if br in bad: continue
          if br[0]==cr: continue
          g=base.copy()
          g[cr,cc+l_off]=mod.BLOCKER
          g[cr,cc+r_off]=mod.BLOCKER
          g[br]=mod.BLOCKER
          after,_=mod._simulate_red_phase(g,cr,cc,radius)
          pre,pc=mod._path_on_grid(g,cr,cc,radius)
          post,qc=mod._path_on_grid(after,cr,cc,radius)
          if pre is None or post is None: continue
          if pre==post: continue
          if qc<2: continue
          if pc<2: continue
          if not any(c"'!=cc for _,c in post): continue
          found.append((l_off,r_off,br, len(pre), pc, len(post), qc, np.count_nonzero(after==mod.RAY)))
    return found

for radius in [4,5,6,7]:
    found=search(radius)
    print('"'radius', radius, 'count', len(found))
    for item in found[:20]:
        print(' ', item)
