+def _bfs_dist(passable: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    dist = np.full(passable.shape, -1, dtype=int)
+    if not passable[start]:
+        return dist
+    q = deque([start])
+    dist[start] = 0
+    while q:
+        cur = q.popleft()
+        for nxt in _lex_neighbors(cur, passable.shape):
+            if passable[nxt] and dist[nxt] < 0:
+                dist[nxt] = dist[cur] + 1
+                q.append(nxt)
+    return dist
