+def _entry_inside(
+    marker: tuple[int, int],
+    step: tuple[int, int],
+    center_r: int,
+    center_c: int,
+    radius: int,
+    shape: tuple[int, int],
+) -> tuple[int, int]:
+    r, c = marker
+    dr, dc = step
+    rr = r + dr
+    cc = c + dc
+    while 0 <= rr < shape[0] and 0 <= cc < shape[1]:
+        if abs(rr - center_r) + abs(cc - center_c) < radius:
+            return rr, cc
+        rr += dr
+        cc += dc
+    raise AssertionError("marker does not lead into the diamond interior")
