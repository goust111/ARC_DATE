+def _draw_diamond(grid: np.ndarray, center_r: int, center_c: int, radius: int) -> None:
+    for r in range(center_r - radius, center_r + radius + 1):
+        dc = radius - abs(r - center_r)
+        grid[r, center_c - dc] = FRAME
+        grid[r, center_c + dc] = FRAME
