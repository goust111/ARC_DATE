+        if mask is None:
+            continue
+
+        if int(mask.sum()) < 2 or int((~mask).sum()) < 2:
+            continue
+        if not np.all(mask.any(axis=0)) or not np.all(mask.any(axis=1)):
+            continue
+        if h >= 3 and w >= 3 and not np.any(~mask[1:-1, 1:-1]):
+            continue
+
+        if bool(rng.integers(2)):
+            mask = np.flipud(mask)
+        if bool(rng.integers(2)):
+            mask = np.fliplr(mask)
+        if bool(rng.integers(2)):
+            mask = mask.T
+            h, w = mask.shape
+            if h * s > 30 or w * s > 30:
