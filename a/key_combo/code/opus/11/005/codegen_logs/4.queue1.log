+
+def _random_connected_mask(h: int, w: int, target: int, rng: np.random.Generator) -> np.ndarray | None:
+    mask = np.zeros((h, w), dtype=bool)
+    steps = ["D"] * (h - 1) + ["R"] * (w - 1)
+    rng.shuffle(steps)
