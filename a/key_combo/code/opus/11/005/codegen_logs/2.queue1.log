```yaml
spec:
  grid: 14-17 rows x 18-19 cols, background 0
  foreground: single non-zero color (any of 1-9)
  blocks:
    count: 4-5 identical-size 5x5 blocks, all same fg color
    structure: solid fg border (all edge cells fg), 3x3 interior filled with fg except holes
    holes: bg pixels in the interior; placed only at non-center positions of 3x3 interior (8 candidates, never center (1,1))
    hole_counts: 1-4 holes per block; no two holes are 4-adjacent within a block
    separation: minimum Chebyshev gap >= 1 between any two block bboxes (no touching/overlapping)
    border_touch: blocks may touch grid edges [observed]
  outlier_rule:
    all blocks except one share the same hole count (the "common" count, 2-3)
    exactly one block has a different hole count (the "unique" count, 1-4, differs from common)
    common count appears N-1 times where N is block count
  output: 5x5 crop of the unique/outlier block

generation_strategy:
  approach: direct construction (structure is simple enough)
