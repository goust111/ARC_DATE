+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 7 or w < 7:
+        return None
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    mask = sub == int(color)
+    perimeter = np.zeros((h, w), dtype=bool)
+    perimeter[0, :] = True
+    perimeter[-1, :] = True
+    perimeter[:, 0] = True
+    perimeter[:, -1] = True
+    if np.array_equal(mask, perimeter):
+        return r0, c0, r1, c1
+    return None
+
+
+def _get_bg(grid: np.ndarray) -> int:
