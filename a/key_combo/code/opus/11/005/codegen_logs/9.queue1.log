    frame_perimeter = np.zeros_like(frame_region, dtype=bool)
    frame_perimeter[0, :] = True
    frame_perimeter[-1, :] = True
    frame_perimeter[:, 0] = True
    frame_perimeter[:, -1] = True
    frame_region[frame_perimeter] = frame_color
    return out

