+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    coords = np.argwhere(grid == int(color))
+    if coords.size == 0:
+        return []
+    cells = {tuple(map(int, rc)) for rc in coords}
+    comps: list[np.ndarray] = []
+    while cells:
+        start = cells.pop()
+        stack = [start]
+        comp = [start]
+        while stack:
