+def _palette_positions(W: int, n: int, rng: random.Random) -> list[int]:
+    gaps = [rng.randint(1, 3) for _ in range(n - 1)]
+    total = 2 * n + sum(gaps)
+    while total > W:
+        idx = max(range(len(gaps)), key=lambda i: gaps[i])
+        gaps[idx] -= 1
+        total = 2 * n + sum(gaps)
+    start = rng.randint(0, W - total)
