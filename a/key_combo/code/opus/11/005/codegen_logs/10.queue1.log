+    for base_color in colors:
+        for subset in _all_subsets(colors):
+            if len(subset) < 1:
+                continue
+            winners = [
+                _cell_color(base_color, subset, r, periods, offsets)
+                for r in range(height)
+            ]
+            shown_colors = set(int(color) for color in winners)
+            if len(shown_colors) < 2:
+                continue
+            if not all(
+                any(
+                    r % periods[color] == offsets[color] and winners[r] == color
+                    for r in range(height)
+                )
+                for color in subset
+            ):
+                continue
+            ok = True
+            for absent in colors:
+                if absent in subset or absent == base_color:
+                    continue
+                if not any(
+                    r % periods[absent] == offsets[absent] and winners[r] != absent
+                    for r in range(height)
+                ):
