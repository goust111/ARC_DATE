+    periods = {color: periods_desc[idx] for idx, color in enumerate(colors)}
+    height = _lcm(list(periods.values()))
+    assert height == 12
+    offsets = {color: random.randrange(periods[color]) for color in colors}
+
+    p_col = random.choice((3, 4, 5))
+    width_choices = {3: (9, 12), 4: (8, 12), 5: (10,)}
+    width = random.choice(width_choices[p_col])
+    candidate_configs = _config_candidates(colors, periods, offsets, height)
+    if not candidate_configs:
+        raise AssertionError("no valid residue configuration for these offsets")
+    random.shuffle(candidate_configs)
