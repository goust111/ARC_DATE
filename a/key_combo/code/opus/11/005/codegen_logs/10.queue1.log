+
+
+def _pick_spaced_columns(width: int, n: int) -> list[int]:
+    choices = list(range(1, width - 1))
+    for _ in range(200):
+        cols = sorted(random.sample(choices, n))
+        if all(cols[i + 1] - cols[i] >= 3 for i in range(n - 1)):
+            return cols
+    raise RuntimeError("failed to place spaced bar columns")
+
+
+def _make_holes(
+    table: np.ndarray,
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    height, width = table.shape
+    repeats = width // p_col
+    hole_mask = np.zeros_like(table, dtype=bool)
+    generic, overlap = _find_forced_missing_positions(table, periods, offsets, p_col, residue_configs)
+    forced_missing: list[tuple[int, int]] = []
+    tie_missing: list[tuple[int, int]] = []
+    if overlap:
+        r, residue = random.choice(overlap)
+        for c in range(residue, width, p_col):
+            hole_mask[r, c] = True
+        forced_missing.append((r, residue))
+        tie_missing.append((r, residue))
+    extra_count = random.randint(1, min(3, len(generic)))
+    random.shuffle(generic)
+    for r, residue in generic:
+        if len(forced_missing) >= 1 + extra_count:
+            break
+        if (r, residue) in forced_missing or r in (0, height - 1):
+            continue
+        for c in range(residue, width, p_col):
+            hole_mask[r, c] = True
+        forced_missing.append((r, residue))
+
+    for _ in range(random.randint(2, 4)):
+        rh = random.randint(1, 3)
+        cw = random.randint(1, 2)
+        r0 = random.randint(1, height - rh - 2)
+        c0 = random.randint(1, width - cw - 2)
+        hole_mask[r0 : r0 + rh, c0 : c0 + cw] = True
+
+    hole_mask[0, :] = False
+    hole_mask[-1, :] = False
+    hole_mask[:, 0] = False
+    hole_mask[:, -1] = False
+
+    for color in colors:
+        if not np.any((table == color) & (~hole_mask)):
+            return table.copy(), [], []
+    for residue in range(p_col):
+        _base_color, subset = residue_configs[residue]
+        for color in subset:
+            if not any(
+                not hole_mask[r, c]
+                and table[r, c] == color
+                for r in range(height)
+                for c in range(residue, width, p_col)
+            ):
+                return table.copy(), [], []
+        absent = [color for color in colors if color not in subset]
+        for color in absent:
+            if not any(
+                not hole_mask[r, c]
+                and r % periods[color] == offsets[color]
+                and table[r, c] != color
+                for r in range(height)
+                for c in range(residue, width, p_col)
+            ):
+                return table.copy(), [], []
+    if hole_mask.sum() < max(6, table.size // 8):
+        return table.copy(), [], []
+    if not _same_row_copy_shortcut_fails(hole_mask, p_col):
+        return table.copy(), [], []
+
+    damaged = table.copy()
+    damaged[hole_mask] = BLACK
+    return damaged, forced_missing, tie_missing
+
+
+def _build_full_grid(
+    top: np.ndarray,
+    periods_desc: tuple[int, ...],
+) -> tuple[np.ndarray, dict]:
+    k = len(periods_desc)
+    colors = list(COLOR_ORDER[:k])
+    periods = {color: periods_desc[idx] for idx, color in enumerate(colors)}
+    height = _lcm(list(periods.values()))
+    assert height == 12
+    offsets = {color: random.randrange(periods[color]) for color in colors}
+
+    p_col = random.choice((3, 4, 5))
+    width_choices = {3: (9, 12), 4: (8, 12), 5: (10,)}
+    width = random.choice(width_choices[p_col])
+    candidate_configs = _config_candidates(colors, periods, offsets, height)
+    if not candidate_configs:
+        raise AssertionError("no valid residue configuration for these offsets")
+    random.shuffle(candidate_configs)
+    residue_configs = [random.choice(candidate_configs) for _ in range(p_col)]
+    if len(set(residue_configs)) < 2:
+        raise AssertionError("need at least two distinct column residues")
+    if _strict_period(residue_configs) != p_col:
+        raise AssertionError("column pattern accidentally has a smaller period")
+    if not any(
+        _has_smaller_period_overlap(config[1], periods, offsets, height)
+        for config in residue_configs
+    ):
+        raise AssertionError("need at least one overlap resolved by smaller period")
+
+    table = _build_table(height, width, p_col, periods, offsets, residue_configs)
+    if len(set(np.unique(table)) - {0}) != k:
+        raise AssertionError("every color must appear in the full table")
+    if not any(
+        len({table[r, c] for c in range(width)}) >= 2
+        for r in range(height)
+    ):
+        raise AssertionError("column period would be visually irrelevant")
+
+    damaged, forced_missing, tie_missing = _make_holes(
+        table, colors, periods, offsets, p_col, residue_configs
+    )
+    if not forced_missing or not tie_missing:
+        raise AssertionError("failed to create informative missing cells")
+
+    top_r = random.choice((0, 1))
+    grid_h = 21 + top_r
+    grid_w = random.randint(max(18, width + 6), 22)
+    left = random.randint(1, grid_w - width - 1)
+    sep_r = top_r + height
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    grid[top_r : top_r + height, left : left + width] = damaged
+    grid[sep_r, :] = GREY
+
+    bar_cols = _pick_spaced_columns(grid_w, k)
+    heights_left_to_right = []
+    baseline = grid_h - 1 - random.randint(0, 1)
+    for col, period in zip(bar_cols, random.sample(list(periods_desc), k)):
+        top_bar = baseline - period + 1
+        if top_bar <= sep_r + 1:
+            raise AssertionError("bar would touch separator")
+        grid[top_bar : baseline + 1, col] = GREY
+        heights_left_to_right.append(period)
+    if tuple(heights_left_to_right) == periods_desc:
+        raise AssertionError("left-to-right bar order should not match the rank order")
+
+    expected = grid.copy()
+    expected[top_r : top_r + height, left : left + width] = table
+    meta = {
+        "top_r": top_r,
+        "left": left,
+        "height": height,
+        "width": width,
+        "sep_r": sep_r,
+        "p_col": p_col,
+        "colors": colors,
+        "periods": periods,
+        "offsets": offsets,
+        "residue_configs": residue_configs,
+        "forced_missing": forced_missing,
+        "tie_missing": tie_missing,
+        "table": table,
+        "damaged": damaged,
+        "expected": expected,
+    }
+    return grid, meta
+
+
+def _validate_generated(grid: np.ndarray, meta: dict) -> None:
+    produced = main(grid)
+    if not np.array_equal(produced, meta["expected"]):
+        raise AssertionError("solver does not reconstruct the intended output")
+    top = meta["damaged"]
+    if not np.any(top == BLACK):
+        raise AssertionError("top table must contain holes")
+    if not _has_period_ambiguity(
+        top,
+        meta["forced_missing"],
+        meta["colors"],
+        meta["periods"],
+        meta["offsets"],
+        meta["residue_configs"],
+    ):
+        raise AssertionError("visible top rows already determine all periods without the bars")
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        try:
+            k = random.choice((3, 4))
+            periods_desc = random.choice(PERIOD_CHOICES[k])
+            grid, meta = _build_full_grid(np.zeros((1, 1), dtype=int), periods_desc)
+            _validate_generated(grid, meta)
+            return grid
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid puzzle instance")

diff --git a/key_combo/code/opus/11/005/10.py b/key_combo/code/opus/11/005/10.py
new file mode 100644
index 0000000000000000000000000000000000000000..b91039f9c0cc1eae440a1b6f17ee63a261dcb538
--- /dev/null
+++ b/key_combo/code/opus/11/005/10.py
@@ -0,0 +1,591 @@
+import math
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+GREY = 5
+BLACK = 0
+COLOR_ORDER = (1, 2, 3, 4)
+ALLOWED_PERIODS = (2, 3, 4, 6)
+PERIOD_CHOICES = {
+    3: ((6, 4, 2), (6, 4, 3), (4, 3, 2)),
+    4: ((6, 4, 3, 2),),
+}
+MAX_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        raise ValueError("empty mask")
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _lcm(values: list[int]) -> int:
+    out = 1
+    for v in values:
+        out = out * v // math.gcd(out, v)
+    return out
+
+
+def _active_colors(
+    subset: tuple[int, ...] | list[int],
+    local_r: int,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+) -> list[int]:
+    return [
+        color
+        for color in subset
+        if local_r % periods[color] == offsets[color]
+    ]
+
+
+def _cell_color(
+    base_color: int,
+    subset: tuple[int, ...] | list[int],
+    local_r: int,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+) -> int:
+    active = _active_colors(subset, local_r, periods, offsets)
+    if not active:
+        return base_color
+    return min(active, key=lambda color: periods[color])
+
+
+def _all_subsets(colors: list[int]) -> list[tuple[int, ...]]:
+    out: list[tuple[int, ...]] = []
+    for size in range(1, len(colors) + 1):
+        out.extend(combinations(colors, size))
+    return out
+
+
+def _infer_separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == GREY)]
+    if len(rows) != 1:
+        raise AssertionError("expected exactly one full-width grey separator row")
+    return rows[0]
+
+
+def _infer_table_bbox(grid: np.ndarray, sep_r: int) -> tuple[int, int, int, int]:
+    top = grid[:sep_r]
+    mask = (top != BLACK) & (top != GREY)
+    return _bbox(mask)
+
+
+def _infer_bars(grid: np.ndarray, sep_r: int) -> list[tuple[int, list[tuple[int, int]]]]:
+    lower = grid[sep_r + 1 :]
+    comps = _components(lower == GREY)
+    bars: list[tuple[int, list[tuple[int, int]]]] = []
+    for comp in comps:
+        rows = [r for r, _ in comp]
+        cols = {c for _, c in comp}
+        if len(cols) != 1:
+            raise AssertionError("grey lower components must be 1-pixel-wide vertical bars")
+        height = max(rows) - min(rows) + 1
+        bars.append((height, [(r + sep_r + 1, c) for r, c in comp]))
+    bars.sort(key=lambda item: item[0], reverse=True)
+    heights = [height for height, _ in bars]
+    if len(heights) not in (3, 4) or len(set(heights)) != len(heights):
+        raise AssertionError("expected 3 or 4 bars with distinct heights")
+    return bars
+
+
+def _infer_periods_from_bars(grid: np.ndarray, sep_r: int) -> dict[int, int]:
+    bars = _infer_bars(grid, sep_r)
+    colors = list(COLOR_ORDER[: len(bars)])
+    return {color: bars[idx][0] for idx, color in enumerate(colors)}
+
+
+def _infer_offsets(top: np.ndarray, periods: dict[int, int]) -> dict[int, int]:
+    offsets: dict[int, int] = {}
+    for color, period in periods.items():
+        rows = np.argwhere(top == color)[:, 0]
+        if rows.size == 0:
+            raise AssertionError(f"missing visible witness for color {color}")
+        residues = {int(r) % period for r in rows}
+        if len(residues) != 1:
+            raise AssertionError(f"inconsistent row residue for color {color}")
+        offsets[color] = residues.pop()
+    return offsets
+
+
+def _find_column_subsets(
+    top: np.ndarray,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+) -> tuple[int, list[tuple[int, tuple[int, ...]]]]:
+    colors = sorted(periods)
+    h, w = top.shape
+    config_pool = [
+        (base_color, subset)
+        for base_color in colors
+        for subset in _all_subsets(colors)
+    ]
+    for p_col in range(1, w + 1):
+        residue_configs: list[tuple[int, tuple[int, ...]]] = []
+        ok = True
+        for residue in range(p_col):
+            observations = [
+                (r, int(top[r, c]))
+                for r in range(h)
+                for c in range(w)
+                if c % p_col == residue and int(top[r, c]) in periods
+            ]
+            if not observations:
+                ok = False
+                break
+            valid_configs = []
+            for base_color, subset in config_pool:
+                if all(
+                    _cell_color(base_color, subset, r, periods, offsets) == color
+                    for r, color in observations
+                ):
+                    valid_configs.append((base_color, subset))
+            if len(valid_configs) != 1:
+                ok = False
+                break
+            residue_configs.append(valid_configs[0])
+        if ok:
+            return p_col, residue_configs
+    raise AssertionError("failed to infer a unique column period")
+
+
+def _fill_table(
+    top: np.ndarray,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> np.ndarray:
+    out = top.copy()
+    h, w = top.shape
+    for r in range(h):
+        for c in range(w):
+            base_color, subset = residue_configs[c % p_col]
+            color = _cell_color(base_color, subset, r, periods, offsets)
+            if out[r, c] == BLACK:
+                out[r, c] = color
+            elif int(out[r, c]) != color:
+                raise AssertionError("visible cell disagrees with inferred periodic structure")
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Repair the missing cells in the upper color table using row periods encoded by ranked grey bars.
+
+    Input structure:
+    - A full-width grey separator row splits the grid into an upper table region and a lower metadata region.
+    - The upper region contains one rectangular color table on black background, using 3 or 4 colors among blue(1), red(2), green(3), yellow(4); some interior table cells are replaced by black(0) holes.
+    - The lower region contains the same number of 1-pixel-wide grey vertical bars, each a separate 4-connected component with a distinct height.
+
+    Rule:
+    - Sort the lower grey bars by height descending and map them to blue, red, green, yellow in that rank order; each mapped height is that color's row period.
+    - Infer the table rectangle, then infer each color's row offset from its visible occurrences.
+    - Infer the smallest column period whose residues each admit a unique subset of allowed colors such that, at every row, the visible winner is the active color in that subset with the smallest period.
+    - Fill every black hole in the table from this periodic rule while preserving all existing visible cells, the separator row, and the grey bars.
+
+    Key insight:
+    - The grey bars do not recolor anything directly: their height ranking assigns colors to row periods, and those periods are the missing parameters needed to reconstruct the damaged periodic color table.
+    """
+    g = np.asarray(grid, dtype=int)
+    sep_r = _infer_separator_row(g)
+    r0, c0, r1, c1 = _infer_table_bbox(g, sep_r)
+    top = g[r0 : r1 + 1, c0 : c1 + 1]
+    periods = _infer_periods_from_bars(g, sep_r)
+    offsets = _infer_offsets(top, periods)
+    p_col, residue_configs = _find_column_subsets(top, periods, offsets)
+    repaired = _fill_table(top, periods, offsets, p_col, residue_configs)
+    out = g.copy()
+    out[r0 : r1 + 1, c0 : c1 + 1] = repaired
+    return out
+
+
+def _config_candidates(
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    height: int,
+) -> list[tuple[int, tuple[int, ...]]]:
+    candidates = []
+    for base_color in colors:
+        for subset in _all_subsets(colors):
+            if len(subset) < 1:
+                continue
+            winners = [
+                _cell_color(base_color, subset, r, periods, offsets)
+                for r in range(height)
+            ]
+            shown_colors = set(int(color) for color in winners)
+            if len(shown_colors) < 2:
+                continue
+            if not all(
+                any(
+                    r % periods[color] == offsets[color] and winners[r] == color
+                    for r in range(height)
+                )
+                for color in subset
+            ):
+                continue
+            ok = True
+            for absent in colors:
+                if absent in subset or absent == base_color:
+                    continue
+                if not any(
+                    r % periods[absent] == offsets[absent] and winners[r] != absent
+                    for r in range(height)
+                ):
+                    ok = False
+                    break
+            if ok and any(
+                not _active_colors(subset, r, periods, offsets)
+                for r in range(height)
+            ):
+                candidates.append((base_color, subset))
+    return candidates
+
+
+def _has_smaller_period_overlap(
+    subset: tuple[int, ...],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    height: int,
+) -> bool:
+    for r in range(height):
+        active = _active_colors(subset, r, periods, offsets)
+        if len(active) >= 2:
+            winning_period = min(periods[color] for color in active)
+            if any(periods[color] > winning_period for color in active):
+                return True
+    return False
+
+
+def _build_table(
+    height: int,
+    width: int,
+    p_col: int,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> np.ndarray:
+    table = np.zeros((height, width), dtype=int)
+    for r in range(height):
+        for c in range(width):
+            base_color, subset = residue_configs[c % p_col]
+            table[r, c] = _cell_color(base_color, subset, r, periods, offsets)
+    return table
+
+
+def _strict_period(seq: list[object]) -> int:
+    for period in range(1, len(seq) + 1):
+        if len(seq) % period != 0:
+            continue
+        if all(seq[i] == seq[i % period] for i in range(len(seq))):
+            return period
+    return len(seq)
+
+
+def _find_forced_missing_positions(
+    table: np.ndarray,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    generic: list[tuple[int, int]] = []
+    overlap: list[tuple[int, int]] = []
+    for r in range(table.shape[0]):
+        for residue in range(p_col):
+            generic.append((r, residue))
+            _base_color, subset = residue_configs[residue]
+            active = _active_colors(subset, r, periods, offsets)
+            if len(active) >= 2:
+                overlap.append((r, residue))
+    return generic, overlap
+
+
+def _visible_rows_by_color(top: np.ndarray, colors: list[int]) -> dict[int, list[int]]:
+    return {
+        color: sorted({int(r) for r in np.argwhere(top == color)[:, 0]})
+        for color in colors
+    }
+
+
+def _has_period_ambiguity(
+    top: np.ndarray,
+    forced_missing: list[tuple[int, int]],
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> bool:
+    visible_rows = _visible_rows_by_color(top, colors)
+    for color in colors:
+        rows = visible_rows[color]
+        if not rows:
+            continue
+        for alt_period in ALLOWED_PERIODS:
+            if alt_period == periods[color]:
+                continue
+            residue = rows[0] % alt_period
+            if any(r % alt_period != residue for r in rows):
+                continue
+            alt_periods = dict(periods)
+            alt_offsets = dict(offsets)
+            alt_periods[color] = alt_period
+            alt_offsets[color] = residue
+            for r, residue_col in forced_missing:
+                base_color, subset = residue_configs[residue_col]
+                actual = _cell_color(base_color, subset, r, periods, offsets)
+                alt = _cell_color(base_color, subset, r, alt_periods, alt_offsets)
+                if actual != alt:
+                    return True
+    return False
+
+
+def _same_row_copy_shortcut_fails(mask: np.ndarray, p_col: int) -> bool:
+    height, width = mask.shape
+    for r in range(height):
+        for residue in range(p_col):
+            cols = [c for c in range(width) if c % p_col == residue]
+            if cols and all(mask[r, c] for c in cols):
+                return True
+    return False
+
+
+def _pick_spaced_columns(width: int, n: int) -> list[int]:
+    choices = list(range(1, width - 1))
+    for _ in range(200):
+        cols = sorted(random.sample(choices, n))
+        if all(cols[i + 1] - cols[i] >= 3 for i in range(n - 1)):
+            return cols
+    raise RuntimeError("failed to place spaced bar columns")
+
+
+def _make_holes(
+    table: np.ndarray,
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    height, width = table.shape
+    repeats = width // p_col
+    hole_mask = np.zeros_like(table, dtype=bool)
+    generic, overlap = _find_forced_missing_positions(table, periods, offsets, p_col, residue_configs)
+    forced_missing: list[tuple[int, int]] = []
+    tie_missing: list[tuple[int, int]] = []
+    if overlap:
+        r, residue = random.choice(overlap)
