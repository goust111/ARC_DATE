+import numpy as np
+
+
+GREY = 5
+BLACK = 0
+COLOR_ORDER = (1, 2, 3, 4)
+ALLOWED_PERIODS = (2, 3, 4, 6)
+PERIOD_CHOICES = {
+    3: ((6, 4, 2), (6, 4, 3), (4, 3, 2)),
