+
+def _make_holes(
+    table: np.ndarray,
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> tuple[np.ndarray, list[tuple[int, int]], list[tuple[int, int]]]:
+    height, width = table.shape
+    repeats = width // p_col
+    hole_mask = np.zeros_like(table, dtype=bool)
+    generic, overlap = _find_forced_missing_positions(table, periods, offsets, p_col, residue_configs)
+    forced_missing: list[tuple[int, int]] = []
+    tie_missing: list[tuple[int, int]] = []
+    if overlap:
+        r, residue = random.choice(overlap)
+        for c in range(residue, width, p_col):
+            hole_mask[r, c] = True
+        forced_missing.append((r, residue))
+        tie_missing.append((r, residue))
+    extra_count = random.randint(1, min(3, len(generic)))
+    random.shuffle(generic)
+    for r, residue in generic:
+        if len(forced_missing) >= 1 + extra_count:
+            break
+        if (r, residue) in forced_missing or r in (0, height - 1):
+            continue
+        for c in range(residue, width, p_col):
+            hole_mask[r, c] = True
+        forced_missing.append((r, residue))
+
+    for _ in range(random.randint(2, 4)):
+        rh = random.randint(1, 3)
+        cw = random.randint(1, 2)
+        r0 = random.randint(1, height - rh - 2)
+        c0 = random.randint(1, width - cw - 2)
+        hole_mask[r0 : r0 + rh, c0 : c0 + cw] = True
