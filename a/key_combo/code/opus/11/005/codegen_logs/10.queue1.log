+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int]:
+    pts = np.argwhere(mask)
+    if pts.size == 0:
+        raise ValueError("empty mask")
+    r0, c0 = pts.min(axis=0)
+    r1, c1 = pts.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _lcm(values: list[int]) -> int:
+    out = 1
+    for v in values:
+        out = out * v // math.gcd(out, v)
+    return out
+
+
+def _winner(
+    subset: tuple[int, ...] | list[int],
+    local_r: int,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+) -> int | None:
+    active = [
+        color
+        for color in subset
+        if local_r % periods[color] == offsets[color]
+    ]
+    if not active:
+        return None
+    return min(active, key=lambda color: periods[color])
+
+
+def _active_colors(
+    subset: tuple[int, ...] | list[int],
+    local_r: int,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+) -> list[int]:
+    return [
+        color
+        for color in subset
+        if local_r % periods[color] == offsets[color]
+    ]
+
+
+def _all_subsets(colors: list[int]) -> list[tuple[int, ...]]:
+    out: list[tuple[int, ...]] = []
+    for size in range(1, len(colors) + 1):
+        out.extend(combinations(colors, size))
+    return out
+
+
+def _infer_separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == GREY)]
+    if len(rows) != 1:
+        raise AssertionError("expected exactly one full-width grey separator row")
+    return rows[0]
+
+
+def _infer_table_bbox(grid: np.ndarray, sep_r: int) -> tuple[int, int, int, int]:
+    top = grid[:sep_r]
+    mask = (top != BLACK) & (top != GREY)
