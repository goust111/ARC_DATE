+
+def _config_candidates(
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    height: int,
+) -> list[tuple[int, tuple[int, ...]]]:
+    candidates = []
+    for base_color in colors:
+        for subset in _all_subsets(colors):
+            if len(subset) < 1:
+                continue
+            winners = [
+                _cell_color(base_color, subset, r, periods, offsets)
+                for r in range(height)
+            ]
+            shown_colors = set(int(color) for color in winners)
+            if len(shown_colors) < 2:
+                continue
+            if not all(
+                any(
+                    r % periods[color] == offsets[color] and winners[r] == color
+                    for r in range(height)
+                )
+                for color in subset
+            ):
+                continue
+            ok = True
+            for absent in colors:
+                if absent in subset or absent == base_color:
+                    continue
+                if not any(
+                    r % periods[absent] == offsets[absent] and winners[r] != absent
+                    for r in range(height)
+                ):
+                    ok = False
+                    break
+            if ok and any(
+                not _active_colors(subset, r, periods, offsets)
+                for r in range(height)
+            ):
+                candidates.append((base_color, subset))
+    return candidates
+
+
+def _has_smaller_period_overlap(
+    subset: tuple[int, ...],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    height: int,
+) -> bool:
+    for r in range(height):
+        active = _active_colors(subset, r, periods, offsets)
+        if len(active) >= 2:
+            winning_period = min(periods[color] for color in active)
+            if any(periods[color] > winning_period for color in active):
+                return True
+    return False
+
+
+def _build_table(
+    height: int,
+    width: int,
+    p_col: int,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> np.ndarray:
+    table = np.zeros((height, width), dtype=int)
+    for r in range(height):
+        for c in range(width):
+            base_color, subset = residue_configs[c % p_col]
+            table[r, c] = _cell_color(base_color, subset, r, periods, offsets)
+    return table
+
+
+def _strict_period(seq: list[object]) -> int:
+    for period in range(1, len(seq) + 1):
+        if len(seq) % period != 0:
+            continue
+        if all(seq[i] == seq[i % period] for i in range(len(seq))):
+            return period
+    return len(seq)
+
+
+def _find_forced_missing_positions(
+    table: np.ndarray,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    generic: list[tuple[int, int]] = []
+    overlap: list[tuple[int, int]] = []
+    for r in range(table.shape[0]):
+        for residue in range(p_col):
+            generic.append((r, residue))
+            _base_color, subset = residue_configs[residue]
+            active = _active_colors(subset, r, periods, offsets)
+            if len(active) >= 2:
+                overlap.append((r, residue))
+    return generic, overlap
+
+
+def _visible_rows_by_color(top: np.ndarray, colors: list[int]) -> dict[int, list[int]]:
+    return {
+        color: sorted({int(r) for r in np.argwhere(top == color)[:, 0]})
+        for color in colors
+    }
+
+
+def _has_period_ambiguity(
+    top: np.ndarray,
+    forced_missing: list[tuple[int, int]],
+    colors: list[int],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> bool:
+    visible_rows = _visible_rows_by_color(top, colors)
+    for color in colors:
+        rows = visible_rows[color]
+        if not rows:
+            continue
+        for alt_period in ALLOWED_PERIODS:
+            if alt_period == periods[color]:
+                continue
+            residue = rows[0] % alt_period
+            if any(r % alt_period != residue for r in rows):
+                continue
+            alt_periods = dict(periods)
+            alt_offsets = dict(offsets)
+            alt_periods[color] = alt_period
+            alt_offsets[color] = residue
+            for r, residue_col in forced_missing:
+                base_color, subset = residue_configs[residue_col]
+                actual = _cell_color(base_color, subset, r, periods, offsets)
+                alt = _cell_color(base_color, subset, r, alt_periods, alt_offsets)
+                if actual != alt:
