+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Repair the missing cells in the upper color table using row periods encoded by ranked grey bars.
+
+    Input structure:
+    - A full-width grey separator row splits the grid into an upper table region and a lower metadata region.
+    - The upper region contains one rectangular color table on black background, using 3 or 4 colors among blue(1), red(2), green(3), yellow(4); some interior table cells are replaced by black(0) holes.
+    - The lower region contains the same number of 1-pixel-wide grey vertical bars, each a separate 4-connected component with a distinct height.
+
+    Rule:
+    - Sort the lower grey bars by height descending and map them to blue, red, green, yellow in that rank order; each mapped height is that color's row period.
+    - Infer the table rectangle, then infer each color's row offset from its visible occurrences.
+    - Infer the smallest column period whose residues each admit a unique subset of allowed colors such that, at every row, the visible winner is the active color in that subset with the smallest period.
+    - Fill every black hole in the table from this periodic rule while preserving all existing visible cells, the separator row, and the grey bars.
+
+    Key insight:
+    - The grey bars do not recolor anything directly: their height ranking assigns colors to row periods, and those periods are the missing parameters needed to reconstruct the damaged periodic color table.
+    """
+    g = np.asarray(grid, dtype=int)
+    sep_r = _infer_separator_row(g)
+    r0, c0, r1, c1 = _infer_table_bbox(g, sep_r)
+    top = g[r0 : r1 + 1, c0 : c1 + 1]
+    periods = _infer_periods_from_bars(g, sep_r)
+    offsets = _infer_offsets(top, periods)
+    p_col, residue_configs = _find_column_subsets(top, periods, offsets)
+    repaired = _fill_table(top, periods, offsets, p_col, residue_configs)
+    out = g.copy()
+    out[r0 : r1 + 1, c0 : c1 + 1] = repaired
