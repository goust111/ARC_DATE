+        "top_r": top_r,
+        "left": left,
+        "height": height,
+        "width": width,
+        "sep_r": sep_r,
+        "p_col": p_col,
+        "colors": colors,
+        "periods": periods,
+        "offsets": offsets,
+        "residue_configs": residue_configs,
+        "forced_missing": forced_missing,
+        "tie_missing": tie_missing,
+        "table": table,
+        "damaged": damaged,
+        "expected": expected,
