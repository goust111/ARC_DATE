+
+BLACK = 0
+GREY = 5
+COLOR_ORDER = (1, 2, 3, 4)
+PERIOD_CHOICES = {
+    3: ((6, 4, 2), (6, 4, 3), (4, 3, 2)),
+    4: ((6, 4, 3, 2),),
