+
+def _infer_bars(grid: np.ndarray, sep_r: int) -> list[tuple[int, list[tuple[int, int]]]]:
+    lower = grid[sep_r + 1 :]
+    comps = _components(lower == GREY)
+    bars: list[tuple[int, list[tuple[int, int]]]] = []
+    for comp in comps:
+        rows = [r for r, _ in comp]
+        cols = {c for _, c in comp}
+        if len(cols) != 1:
+            raise AssertionError("grey lower components must be 1-pixel-wide vertical bars")
+        height = max(rows) - min(rows) + 1
+        bars.append((height, [(r + sep_r + 1, c) for r, c in comp]))
