+    heights = [height for height, _ in bars]
+    if len(heights) not in (3, 4) or len(set(heights)) != len(heights):
+        raise AssertionError("expected 3 or 4 bars with distinct heights")
+    return bars
+
+
+def _infer_periods_from_bars(grid: np.ndarray, sep_r: int) -> dict[int, int]:
+    bars = _infer_bars(grid, sep_r)
+    colors = list(COLOR_ORDER[: len(bars)])
+    return {color: bars[idx][0] for idx, color in enumerate(colors)}
+
+
+def _infer_offsets(top: np.ndarray, periods: dict[int, int]) -> dict[int, int]:
+    offsets: dict[int, int] = {}
+    for color, period in periods.items():
+        rows = np.argwhere(top == color)[:, 0]
+        if rows.size == 0:
+            raise AssertionError(f"missing visible witness for color {color}")
+        residues = {int(r) % period for r in rows}
+        if len(residues) != 1:
+            raise AssertionError(f"inconsistent row residue for color {color}")
+        offsets[color] = residues.pop()
+    return offsets
+
+
+def _find_column_subsets(
+    top: np.ndarray,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+) -> tuple[int, list[tuple[int, tuple[int, ...]]]]:
+    colors = sorted(periods)
+    h, w = top.shape
+    config_pool = [
+        (base_color, subset)
+        for base_color in colors
+        for subset in _all_subsets(colors)
+    ]
+    for p_col in range(1, w + 1):
+        residue_configs: list[tuple[int, tuple[int, ...]]] = []
+        ok = True
+        for residue in range(p_col):
+            observations = [
+                (r, int(top[r, c]))
+                for r in range(h)
+                for c in range(w)
+                if c % p_col == residue and int(top[r, c]) in periods
+            ]
+            if not observations:
+                ok = False
+                break
+            valid_configs = []
+            for base_color, subset in config_pool:
+                if all(
+                    _cell_color(base_color, subset, r, periods, offsets) == color
+                    for r, color in observations
+                ):
+                    valid_configs.append((base_color, subset))
