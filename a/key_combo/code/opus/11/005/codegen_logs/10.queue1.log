+    if not forced_missing or not tie_missing:
+        raise AssertionError("failed to create informative missing cells")
+
+    top_r = random.choice((0, 1))
+    grid_h = 21 + top_r
+    grid_w = random.randint(max(18, width + 6), 22)
+    left = random.randint(1, grid_w - width - 1)
+    sep_r = top_r + height
+    grid = np.zeros((grid_h, grid_w), dtype=int)
+    grid[top_r : top_r + height, left : left + width] = damaged
+    grid[sep_r, :] = GREY
