+    table: np.ndarray,
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    p_col: int,
+    residue_configs: list[tuple[int, tuple[int, ...]]],
+) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+    generic: list[tuple[int, int]] = []
+    overlap: list[tuple[int, int]] = []
+    for r in range(table.shape[0]):
+        for residue in range(p_col):
+            generic.append((r, residue))
+            _base_color, subset = residue_configs[residue]
+            active = _active_colors(subset, r, periods, offsets)
+            if len(active) >= 2:
+                overlap.append((r, residue))
+    return generic, overlap
+
+
+def _visible_rows_by_color(top: np.ndarray, colors: list[int]) -> dict[int, list[int]]:
+    return {
+        color: sorted({int(r) for r in np.argwhere(top == color)[:, 0]})
+        for color in colors
+    }
+
