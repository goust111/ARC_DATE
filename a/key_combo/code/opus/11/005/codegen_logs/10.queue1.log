+
+def _has_smaller_period_overlap(
+    subset: tuple[int, ...],
+    periods: dict[int, int],
+    offsets: dict[int, int],
+    height: int,
+) -> bool:
+    for r in range(height):
+        active = _active_colors(subset, r, periods, offsets)
+        if len(active) >= 2:
+            winning_period = min(periods[color] for color in active)
+            if any(periods[color] > winning_period for color in active):
+                return True
+    return False
