+    hole_mask[0, :] = False
+    hole_mask[-1, :] = False
+    hole_mask[:, 0] = False
+    hole_mask[:, -1] = False
+
+    for color in colors:
+        if not np.any((table == color) & (~hole_mask)):
+            return table.copy(), [], []
+    for residue in range(p_col):
+        _base_color, subset = residue_configs[residue]
