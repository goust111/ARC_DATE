    count: 1-6 total, all visited by path (no distractors)
    at_least_one_type: may have 0 of one type but >=1 total
  path:
    initial_direction: rightward (0,+1) from green start toward first control on same row
    segments: 2 to 7 straight segments separated by turns at controls
    segment_length: 1-4 cells each
