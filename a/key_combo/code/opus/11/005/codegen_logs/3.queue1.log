+            grid = np.zeros((h, w), dtype=int)
+            grid[start] = GREEN
+            for r, c, color in controls:
+                grid[r, c] = color
+
+            if _validate_generated_input(grid):
+                return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
