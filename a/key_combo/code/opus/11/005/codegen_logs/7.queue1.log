+
+def _apply_stamp(out: np.ndarray, bbox: Tuple[int, int, int, int], stamp: np.ndarray) -> None:
+    r0, c0, r1, c1 = bbox
+    bh = r1 - r0 + 1
+    bw = c1 - c0 + 1
+    hh = min(bh, stamp.shape[0])
+    ww = min(bw, stamp.shape[1])
+    cut = stamp[:hh, :ww]
+    view = out[r0 : r0 + hh, c0 : c0 + ww]
+    view[cut] = BLACK
