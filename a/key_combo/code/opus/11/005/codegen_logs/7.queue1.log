+
+
+def _place_scene(rng: random.Random, H: int, W: int, components: List[Dict[str, object]], sprites: Dict[int, Dict[str, object]]) -> np.ndarray | None:
+    grid = np.zeros((H, W), dtype=int)
+    occupied = np.zeros((H, W), dtype=bool)
