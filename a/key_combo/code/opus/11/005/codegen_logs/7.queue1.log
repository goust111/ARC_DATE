+        hh = min(comp["patch"].shape[0], stamp.shape[0])
+        ww = min(comp["patch"].shape[1], stamp.shape[1])
+        if hh == stamp.shape[0] and ww == stamp.shape[1]:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        rng = random.Random(random.getrandbits(64))
