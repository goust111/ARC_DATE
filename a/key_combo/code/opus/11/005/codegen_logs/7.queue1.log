+    for rank, comp in enumerate(ranked_components):
+        color = int(colors_ranked[rank])
+        patch = comp["patch"]
+        occupied = np.zeros(shape, dtype=bool)
+        _paint_patch(out, occupied, patch, int(comp["r"]), int(comp["c"]), color)
