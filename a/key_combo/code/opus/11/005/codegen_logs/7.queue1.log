+    grid = _place_scene(rng, H, W, components, sprites)
+    if grid is None:
+        return None
+
+    area_rank_ids = _ranked_component_ids(components)
+    row_major_ids = _row_major_component_ids(components)
+    if area_rank_ids == row_major_ids:
