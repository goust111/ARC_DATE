+
+
+def _ranked_component_ids(components: List[Dict[str, object]]) -> List[int]:
+    return [int(comp["id"]) for comp in sorted(components, key=lambda comp: (-int(comp["area"]), int(comp["r"]), int(comp["c"])))]
+
