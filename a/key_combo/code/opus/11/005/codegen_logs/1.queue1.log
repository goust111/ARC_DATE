+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(18, 24)
+    w = rng.randint(18, 24)
+    n_frames = rng.randint(2, 4)
+    need_shadow = rng.random() < 0.65
+    need_multicount = rng.random() < 0.7
