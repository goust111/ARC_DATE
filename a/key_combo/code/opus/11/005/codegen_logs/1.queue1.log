+            painted: list[tuple[int, int]] = []
+            entered_frame = None
+            stop_reason = "boundary"
+            while True:
+                nr, nc = r + dr, c + dc
+                if not _in_bounds(out.shape, nr, nc):
+                    stop_reason = "boundary"
+                    break
