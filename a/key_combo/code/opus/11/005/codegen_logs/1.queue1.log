+def _frame_cells(frame: dict) -> set[tuple[int, int]]:
+    r0, c0, r1, c1 = frame["bbox"]
+    cells = set()
+    for rr in range(r0, r1 + 1):
+        cells.add((rr, c0))
+        cells.add((rr, c1))
+    for cc in range(c0, c1 + 1):
+        cells.add((r0, cc))
+        cells.add((r1, cc))
+    return cells
