+BG = 0
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+MAX_GENERATION_ATTEMPTS = 600
+FRAME_RETRIES = 120
+SOURCE_SELECTION_RETRIES = 220
+TEMP_SOURCE_COLOR = 9
