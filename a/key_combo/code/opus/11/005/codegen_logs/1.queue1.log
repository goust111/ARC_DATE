+    for frame in frames:
+        r0, c0, r1, c1 = frame["bbox"]
+        frame_mask[r0 : r1 + 1, c0 : c1 + 1] |= (
+            (np.arange(r0, r1 + 1)[:, None] == r0)
+            | (np.arange(r0, r1 + 1)[:, None] == r1)
+            | (np.arange(c0, c1 + 1)[None, :] == c0)
+            | (np.arange(c0, c1 + 1)[None, :] == c1)
