+        ordered = spec["path"] if spec["visible_index"] == len(spec["path"]) - 1 else list(reversed(spec["path"]))
+        if spec["visible_index"] == 0:
+            ordered = spec["path"]
+        else:
+            ordered = list(reversed(spec["path"]))
+        other_to_visible = list(reversed(ordered))
+        far_tail = other_to_visible[: len(spec["gap"])]
+        for cell in far_tail:
+            out[cell] = tail_color
+    return out
+
+
+def _build_input(h: int, w: int, frame_layers: list[dict], pair_specs: list[dict]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
