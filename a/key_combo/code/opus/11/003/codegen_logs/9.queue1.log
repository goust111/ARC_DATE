+def _gap_options(
+    region: BBox,
+    path: list[Coord],
+    visible_index: int,
+    occupied_pairs: set[Coord],
+    frame_cells: set[Coord],
+) -> list[tuple[tuple[Coord, ...], Coord]]:
+    r0, c0, r1, c1 = region
+    path_cells = set(path)
+    endpoint = path[visible_index]
+    options: list[tuple[tuple[Coord, ...], Coord]] = []
+    for dr, dc in DIRECTIONS:
