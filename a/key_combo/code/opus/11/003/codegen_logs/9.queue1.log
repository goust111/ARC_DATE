+        pair_specs.append(spec)
+        occupied_pairs.update(spec["path"])
+        occupied_pairs.add(spec["marker"])
+
+    grid = _build_input(h, w, frame_layers, pair_specs)
+    _validate_instance(grid, pair_specs, frame_layers)
