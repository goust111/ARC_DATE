+    out[:, 0] = int(left_color)
+    out[:, w - 1] = int(right_color)
+    trace: list[dict] = []
+
+    for obj in processed:
+        if same_color_only:
+            active_occ = wall_occ | settled_by_color[int(obj["current_color"])]
+        else:
+            active_occ = wall_occ | settled_all
+
+        shift = 0
+        direction = int(obj["direction"])
+        while True:
+            candidate = obj["coords"] + np.array([0, shift + direction])
+            cols = candidate[:, 1]
+            if int(cols.min()) < 0 or int(cols.max()) >= w:
