        if roots > total - 1 or total < min_total:
            continue
        k_choices = [
            k
            for k in range(_GEN_PALETTE_SIZE_RANGE[0], min(_GEN_PALETTE_SIZE_RANGE[1], total) + 1)
            if _gen_count_options(total, roots, k)
