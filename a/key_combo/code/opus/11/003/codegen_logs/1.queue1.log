+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in NEIGHBORS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(coords, dtype=int))
+    out.sort(key=_bbox_key)
+    return out
+
+
+def _swap_color(color: int, left_color: int, right_color: int) -> int:
+    if int(color) == int(left_color):
+        return int(right_color)
+    if int(color) == int(right_color):
+        return int(left_color)
+    raise AssertionError("unexpected movable color")
+
+
+def _extract_objects(grid: np.ndarray) -> tuple[int, int, int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2 and min(g.shape) >= 3, "expected a 2D grid with two side walls"
+
+    bg = _get_bg(g)
+    h, w = g.shape
+    left_color = int(g[0, 0])
+    right_color = int(g[0, w - 1])
+
+    assert left_color != right_color, "left and right walls must differ"
+    assert left_color != bg and right_color != bg, "wall colors must be foreground"
+    assert np.all(g[:, 0] == left_color), "left wall must fill the full left column"
+    assert np.all(g[:, w - 1] == right_color), "right wall must fill the full right column"
+
+    movable = g != bg
+    movable[:, 0] = False
+    movable[:, w - 1] = False
+    comps = _components(movable)
+    assert 4 <= len(comps) <= 6, "expected 4 to 6 inner sprites"
+
+    objects: list[dict] = []
+    for idx, coords in enumerate(comps):
+        colors = np.unique(g[coords[:, 0], coords[:, 1]])
+        assert len(colors) == 1, "each sprite must be monochrome"
+        input_color = int(colors[0])
+        assert input_color in {left_color, right_color}, "sprites must use the wall colors"
+
+        crop = _crop_component_mask(coords)
+        assert 3 <= int(crop.sum()) <= 6, "sprite area must be 3 to 6"
+        assert crop.shape[0] <= 3 and crop.shape[1] <= 3, "sprite bbox must fit within 3x3"
+
+        symmetric = bool(np.array_equal(crop, np.fliplr(crop)))
+        bbox = _bbox(coords)
+        objects.append(
+            {
+                "id": int(idx),
+                "coords": coords,
+                "bbox": bbox,
+                "input_color": input_color,
+                "symmetric": symmetric,
+                "mask": crop,
+            }
+        )
+    return bg, left_color, right_color, objects
+
+
+def _solve(
+    grid: np.ndarray,
+    *,
+    disable_recolor: bool = False,
+    same_color_only: bool = False,
+    return_trace: bool = False,
+) -> tuple[np.ndarray, list[dict]] | np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    bg, left_color, right_color, objects = _extract_objects(g)
+    h, w = g.shape
+
+    wall_occ = np.zeros((h, w), dtype=bool)
+    wall_occ[:, 0] = True
+    wall_occ[:, w - 1] = True
+    settled_all = np.zeros((h, w), dtype=bool)
+    settled_by_color = {
+        int(left_color): np.zeros((h, w), dtype=bool),
+        int(right_color): np.zeros((h, w), dtype=bool),
+    }
+
+    processed: list[dict] = []
+    for obj in objects:
+        current_color = int(obj["input_color"])
+        if not disable_recolor and not bool(obj["symmetric"]):
+            current_color = _swap_color(current_color, left_color, right_color)
+        direction = -1 if current_color == left_color else 1
+        bbox = obj["bbox"]
+        distance = int(bbox[1] - 1) if direction == -1 else int((w - 2) - bbox[3])
+        processed.append(
+            {
+                **obj,
+                "current_color": current_color,
+                "direction": direction,
+                "distance": distance,
+            }
+        )
+
+    processed.sort(key=lambda obj: (obj["distance"], obj["bbox"][0], obj["bbox"][1], obj["id"]))
+
+    out = np.full_like(g, int(bg))
+    out[:, 0] = int(left_color)
+    out[:, w - 1] = int(right_color)
+    trace: list[dict] = []
+
+    for obj in processed:
+        if same_color_only:
+            active_occ = wall_occ | settled_by_color[int(obj["current_color"])]
+        else:
+            active_occ = wall_occ | settled_all
+
+        shift = 0
+        direction = int(obj["direction"])
+        while True:
+            candidate = obj["coords"] + np.array([0, shift + direction])
+            cols = candidate[:, 1]
+            if int(cols.min()) < 0 or int(cols.max()) >= w:
+                break
+            if bool(np.any(active_occ[candidate[:, 0], candidate[:, 1]])):
+                break
+            shift += direction
+
+        final_coords = obj["coords"] + np.array([0, shift])
+        assert not bool(np.any(wall_occ[final_coords[:, 0], final_coords[:, 1]])), "sprite may not overlap a wall"
+        assert not bool(np.any(settled_all[final_coords[:, 0], final_coords[:, 1]])), "sprites may not overlap"
+
+        out[final_coords[:, 0], final_coords[:, 1]] = int(obj["current_color"])
+        settled_all[final_coords[:, 0], final_coords[:, 1]] = True
+        settled_by_color[int(obj["current_color"])][final_coords[:, 0], final_coords[:, 1]] = True
+
+        next_coords = final_coords + np.array([0, direction])
+        if bool(np.any(wall_occ[next_coords[:, 0], next_coords[:, 1]])):
+            stop_cause = "wall"
+        elif bool(np.any(settled_all[next_coords[:, 0], next_coords[:, 1]])):
+            stop_cause = "object"
+        else:
+            stop_cause = "free"
+
+        trace.append(
+            {
+                "id": int(obj["id"]),
+                "input_color": int(obj["input_color"]),
+                "current_color": int(obj["current_color"]),
+                "symmetric": bool(obj["symmetric"]),
+                "distance": int(obj["distance"]),
+                "direction": int(direction),
+                "shift": int(shift),
+                "stop_cause": stop_cause,
+                "input_bbox": tuple(map(int, obj["bbox"])),
+                "final_bbox": _bbox(final_coords),
+            }
+        )
+
+    if return_trace:
+        return out, trace
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Recolor each non-symmetric sprite, then slide every sprite horizontally toward the wall matching its resulting color.
+
+    Input structure:
+    - The background is black.
+    - The left column is a solid wall of one foreground color and the right column is a solid wall of the other.
+    - The interior contains 4 to 6 monochrome 4-connected sprites, each with 3 to 6 cells inside a bbox no larger than 3x3.
+
+    Rule:
+    - Crop each sprite to its own bbox and test left-right mirror symmetry.
+    - Symmetric sprites keep their color; non-symmetric sprites swap to the opposite wall color.
+    - Using the post-test color, assign each sprite to the matching wall, sort all sprites globally by distance to that wall from nearest to farthest, and slide them horizontally in that order.
+    - A sprite stops when its next step would hit the wall or any already settled sprite; walls stay fixed.
+
+    Key insight:
+    - Vertical symmetry is not the output selector; it decides whether a sprite flips color, and that color flip changes which wall the sprite is pulled toward.
+    """
+    return _solve(grid)
+
+
+def _shape_key(mask: np.ndarray) -> tuple[tuple[int, ...], ...]:
+    return tuple(tuple(int(x) for x in row) for row in mask.astype(int))
+
+
+def _enumerate_shape_pools() -> dict[bool, list[np.ndarray]]:
+    pools = {True: [], False: []}
+    seen: set[tuple[tuple[int, ...], ...]] = set()
+    for bits in range(1, 1 << 9):
+        raw = np.zeros((3, 3), dtype=bool)
+        for idx in range(9):
+            if bits & (1 << idx):
+                raw[idx // 3, idx % 3] = True
+        cells = int(raw.sum())
+        if cells < 3 or cells > 6:
+            continue
+        comps = _components(raw)
+        if len(comps) != 1 or len(comps[0]) != cells:
+            continue
+        crop = _crop_component_mask(comps[0])
+        key = _shape_key(crop)
+        if key in seen:
+            continue
+        pools[bool(np.array_equal(crop, np.fliplr(crop)))].append(crop.copy())
+        seen.add(key)
+    return pools
+
+
+_SHAPE_POOLS = _enumerate_shape_pools()
+_RICH_SYMMETRIC = [m for m in _SHAPE_POOLS[True] if m.shape[1] >= 2 and m.shape[0] >= 2]
+_RICH_ASYMMETRIC = [m for m in _SHAPE_POOLS[False] if m.shape[1] >= 2 and m.shape[0] >= 2]
+
+
+def _category_spec(name: str) -> dict:
+    if name == "blue_sym":
+        return {"name": name, "input_color": 1, "symmetric": True, "final_color": 1}
+    if name == "red_asym":
+        return {"name": name, "input_color": 2, "symmetric": False, "final_color": 1}
+    if name == "red_sym":
+        return {"name": name, "input_color": 2, "symmetric": True, "final_color": 2}
+    if name == "blue_asym":
+        return {"name": name, "input_color": 1, "symmetric": False, "final_color": 2}
+    raise ValueError(f"unknown category: {name}")
+
+
+def _choose_mask(expect_symmetric: bool, *, rich: bool) -> np.ndarray:
+    if rich and expect_symmetric and _RICH_SYMMETRIC:
+        return random.choice(_RICH_SYMMETRIC).copy()
+    if rich and (not expect_symmetric) and _RICH_ASYMMETRIC:
+        return random.choice(_RICH_ASYMMETRIC).copy()
+    return random.choice(_SHAPE_POOLS[bool(expect_symmetric)]).copy()
+
+
+def _boxes_separated(a: tuple[int, int, int, int], b: tuple[int, int, int, int], gap: int = 1) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return ar1 + gap < br0 or br1 + gap < ar0 or ac1 + gap < bc0 or bc1 + gap < ac0
+
+
+def _make_bbox(mask: np.ndarray, r0: int, c0: int) -> tuple[int, int, int, int]:
+    h, w = mask.shape
+    return int(r0), int(c0), int(r0 + h - 1), int(c0 + w - 1)
+
+
+def _input_col(mask: np.ndarray, final_color: int, distance: int, width: int) -> int | None:
+    sprite_w = mask.shape[1]
+    if final_color == 1:
+        c0 = 1 + int(distance)
+    else:
+        c0 = (width - 2 - int(distance)) - (sprite_w - 1)
+    if c0 < 1 or c0 + sprite_w > width - 1:
+        return None
+    return int(c0)
+
+
+def _place_remaining(
+    specs: list[dict],
+    placed: list[dict],
+    used_distances: set[int],
+    height: int,
+    width: int,
+) -> bool:
+    distance_pool = list(range(2, width - 4))
+    specs = sorted(specs, key=lambda spec: int(spec["mask"].sum()), reverse=True)
+    for spec in specs:
+        choices = [d for d in distance_pool if d not in used_distances]
+        random.shuffle(choices)
+        placed_here = False
+        for distance in choices:
+            c0 = _input_col(spec["mask"], int(spec["final_color"]), distance, width)
+            if c0 is None:
+                continue
+            row_choices = list(range(1, height - spec["mask"].shape[0]))
+            random.shuffle(row_choices)
+            for r0 in row_choices:
+                bbox = _make_bbox(spec["mask"], r0, c0)
+                if all(_boxes_separated(bbox, other["bbox"], gap=1) for other in placed):
+                    placed.append({**spec, "r0": int(r0), "c0": int(c0), "bbox": bbox, "distance": int(distance)})
+                    used_distances.add(int(distance))
+                    placed_here = True
+                    break
+            if placed_here:
+                break
+        if not placed_here:
+            return False
+    return True
+
+
+def _render_input(height: int, width: int, placements: list[dict]) -> np.ndarray:
+    grid = np.zeros((height, width), dtype=int)
+    grid[:, 0] = 1
+    grid[:, width - 1] = 2
+    for spec in placements:
+        mask = spec["mask"]
+        r0 = int(spec["r0"])
+        c0 = int(spec["c0"])
+        patch = np.where(mask, int(spec["input_color"]), 0)
+        window = grid[r0 : r0 + mask.shape[0], c0 : c0 + mask.shape[1]]
+        assert not bool(np.any(window[mask] != 0)), "input sprites may not overlap"
+        window[mask] = int(spec["input_color"])
+    return grid
+
+
+def _validate_candidate(grid: np.ndarray) -> bool:
+    try:
+        out, trace = _solve(grid, return_trace=True)
+        _bg, _left, _right, objects = _extract_objects(grid)
+    except Exception:
+        return False
+
+    if len({entry["distance"] for entry in trace}) != len(trace):
+        return False
+    if not all(entry["shift"] != 0 for entry in trace):
+        return False
+    if not any(entry["symmetric"] for entry in trace):
+        return False
+    if not any(not entry["symmetric"] for entry in trace):
+        return False
+    if not any(entry["stop_cause"] == "object" for entry in trace):
+        return False
+
+    by_color_sym = {(1, True): 0, (1, False): 0, (2, True): 0, (2, False): 0}
+    for obj in objects:
+        key = (int(obj["input_color"]), bool(obj["symmetric"]))
+        by_color_sym[key] += 1
+    if min(by_color_sym.values()) < 1:
+        return False
+
+    wrong_no_recolor = _solve(grid, disable_recolor=True)
+    if np.array_equal(out, wrong_no_recolor):
+        return False
+
+    wrong_same_color_only = _solve(grid, same_color_only=True)
+    if np.array_equal(out, wrong_same_color_only):
+        return False
+
+    input_sig = _grid_hash(grid)
+    output_sig = _grid_hash(out)
+    if input_sig in _SEEN_INPUTS or output_sig in _SEEN_OUTPUTS:
+        return False
+
+    _SEEN_INPUTS.add(input_sig)
+    _SEEN_OUTPUTS.add(output_sig)
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    height = random.randint(17, 22)
+    width = random.randint(18, 22)
+    total = random.randint(4, 6)
+
+    names = ["blue_sym", "red_asym", "red_sym", "blue_asym"]
+    extras = [random.choice(names) for _ in range(total - 4)]
+    specs = [_category_spec(name) for name in names + extras]
+    for idx, spec in enumerate(specs):
+        spec["mask"] = _choose_mask(bool(spec["symmetric"]), rich=idx < 3)
+
+    trio = [specs[0], specs[1], specs[2]]
+    max_h = max(spec["mask"].shape[0] for spec in trio)
+    if height - max_h - 1 <= 1:
+        return None
+
+    placed: list[dict] = []
+    used_distances: set[int] = set()
+    for _ in range(200):
+        base_row = random.randint(1, height - max_h - 1)
+        a_mask = trio[0]["mask"]
+        c_mask = trio[1]["mask"]
+        b_mask = trio[2]["mask"]
+        d_a = random.randint(2, 4)
+        d_c_max = min(width - 7, d_a + 6)
+        if d_c_max < d_a + 2:
+            continue
+        d_c = random.randint(d_a + 2, d_c_max)
+        d_b_max = min(width - 5, d_c + 5)
+        if d_b_max < d_c + 1:
+            continue
+        d_b = random.randint(d_c + 1, d_b_max)
+
+        c_a = _input_col(a_mask, int(trio[0]["final_color"]), d_a, width)
+        c_c = _input_col(c_mask, int(trio[1]["final_color"]), d_c, width)
+        c_b = _input_col(b_mask, int(trio[2]["final_color"]), d_b, width)
+        if c_a is None or c_b is None or c_c is None:
+            continue
+
+        placements = []
+        for spec, distance, c0 in (
+            (trio[0], d_a, c_a),
+            (trio[1], d_c, c_c),
+            (trio[2], d_b, c_b),
+        ):
+            bbox = _make_bbox(spec["mask"], base_row, c0)
+            placements.append({**spec, "r0": int(base_row), "c0": int(c0), "bbox": bbox, "distance": int(distance)})
+
+        left_to_right = sorted(placements, key=lambda spec: spec["c0"])
+        if [spec["name"] for spec in left_to_right] != ["blue_sym", "red_sym", "red_asym"]:
+            continue
+        if not all(_boxes_separated(placements[i]["bbox"], placements[j]["bbox"], gap=1) for i in range(3) for j in range(i + 1, 3)):
+            continue
+
+        placed = placements
+        used_distances = {int(d_a), int(d_b), int(d_c)}
+        break
+    else:
+        return None
+
+    if not _place_remaining(specs[3:], placed, used_distances, height, width):
+        return None
+
+    grid = _render_input(height, width, placed)
+    if not _validate_candidate(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid symmetry-recolor-slide input")

