+    except Exception:
+        return False
+
+    if len({entry["distance"] for entry in trace}) != len(trace):
+        return False
+    if not all(entry["shift"] != 0 for entry in trace):
+        return False
+    if not any(entry["symmetric"] for entry in trace):
+        return False
+    if not any(not entry["symmetric"] for entry in trace):
+        return False
+    if not any(entry["stop_cause"] == "object" for entry in trace):
+        return False
+
+    by_color_sym = {(1, True): 0, (1, False): 0, (2, True): 0, (2, False): 0}
+    for obj in objects:
+        key = (int(obj["input_color"]), bool(obj["symmetric"]))
+        by_color_sym[key] += 1
+    if min(by_color_sym.values()) < 1:
+        return False
+
+    try:
+        wrong_no_recolor = _solve(grid, disable_recolor=True)
+    except Exception:
+        wrong_no_recolor = None
+    if wrong_no_recolor is not None and np.array_equal(out, wrong_no_recolor):
+        return False
+
+    try:
+        wrong_same_color_only = _solve(grid, same_color_only=True)
+    except Exception:
+        wrong_same_color_only = None
+    if wrong_same_color_only is not None and np.array_equal(out, wrong_same_color_only):
+        return False
+
+    input_sig = _grid_hash(grid)
+    output_sig = _grid_hash(out)
+    if input_sig in _SEEN_INPUTS or output_sig in _SEEN_OUTPUTS:
+        return False
+
+    _SEEN_INPUTS.add(input_sig)
+    _SEEN_OUTPUTS.add(output_sig)
+    return True
+
+
+def _attempt_generate() -> np.ndarray | None:
+    width = random.randint(22, 24)
+    shift = random.randint(0, 2)
+    height = 20 + shift
+
+    placed: list[dict] = [
+        {
+            "name": "red_sym",
+            "input_color": 2,
+            "symmetric": True,
+            "final_color": 2,
+            "mask": _TEMPLATE_RED_WALL,
+            "r0": 7 + shift,
+            "distance": random.choice((2, 3)),
+        },
+        {
+            "name": "blue_asym",
+            "input_color": 1,
+            "symmetric": False,
+            "final_color": 2,
+            "mask": _TEMPLATE_BLUE_TO_RED,
+            "r0": 11 + shift,
+            "distance": random.choice((3, 4, 5)),
+        },
+        {
+            "name": "red_asym",
+            "input_color": 2,
+            "symmetric": False,
+            "final_color": 1,
+            "mask": _TEMPLATE_RED_TO_BLUE,
+            "r0": 1 + shift,
+            "distance": random.choice((4, 5, 6)),
+        },
+        {
+            "name": "red_sym",
+            "input_color": 2,
+            "symmetric": True,
+            "final_color": 2,
+            "mask": _TEMPLATE_RED_MID,
+            "r0": 13 + shift,
+            "distance": width - 7,
+        },
+        {
+            "name": "blue_sym",
+            "input_color": 1,
+            "symmetric": True,
+            "final_color": 1,
+            "mask": _TEMPLATE_BLUE_LATE,
+            "r0": 15 + shift,
+            "distance": width - 6,
+        },
+    ]
+
+    for spec in placed:
+        c0 = _input_col(spec["mask"], int(spec["final_color"]), int(spec["distance"]), width)
+        if c0 is None:
+            return None
+        spec["c0"] = int(c0)
+        spec["bbox"] = _make_bbox(spec["mask"], int(spec["r0"]), int(c0))
+
+    if not all(_boxes_separated(placed[i]["bbox"], placed[j]["bbox"], gap=1) for i in range(len(placed)) for j in range(i + 1, len(placed))):
+        return None
+
+    if random.random() < 0.6:
+        extra = _category_spec(random.choice(("blue_sym", "red_asym", "red_sym", "blue_asym")))
+        extra["mask"] = _choose_mask(bool(extra["symmetric"]), rich=random.random() < 0.7)
+        if not _place_remaining([extra], placed, {int(spec["distance"]) for spec in placed}, height, width):
+            return None
+
+    grid = _render_input(height, width, placed)
+    if not _validate_candidate(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _attempt_generate()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid symmetry-recolor-slide input")

