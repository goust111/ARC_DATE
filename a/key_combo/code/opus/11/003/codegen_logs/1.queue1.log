        return False

    height, width = grid.shape
    for r, c in zip(rows, cols):
        r = int(r)
        c = int(c)
        for nr_delta, nc_delta in _GEN_NEIGHBORS8:
            nr = r + nr_delta
            nc = c + nc_delta
            if 0 <= nr < height and 0 <= nc < width and int(grid[nr, nc]) == int(color):
