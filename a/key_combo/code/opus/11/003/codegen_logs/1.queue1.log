+        assert not bool(np.any(wall_occ[final_coords[:, 0], final_coords[:, 1]])), "sprite may not overlap a wall"
+        assert not bool(np.any(settled_all[final_coords[:, 0], final_coords[:, 1]])), "sprites may not overlap"
+
+        out[final_coords[:, 0], final_coords[:, 1]] = int(obj["current_color"])
+        settled_all[final_coords[:, 0], final_coords[:, 1]] = True
+        settled_by_color[int(obj["current_color"])][final_coords[:, 0], final_coords[:, 1]] = True
+
+        next_coords = final_coords + np.array([0, direction])
+        if bool(np.any(wall_occ[next_coords[:, 0], next_coords[:, 1]])):
+            stop_cause = "wall"
+        elif bool(np.any(settled_all[next_coords[:, 0], next_coords[:, 1]])):
+            stop_cause = "object"
+        else:
+            stop_cause = "free"
+
+        trace.append(
+            {
+                "id": int(obj["id"]),
+                "input_color": int(obj["input_color"]),
+                "current_color": int(obj["current_color"]),
+                "symmetric": bool(obj["symmetric"]),
+                "distance": int(obj["distance"]),
+                "direction": int(direction),
+                "shift": int(shift),
+                "stop_cause": stop_cause,
