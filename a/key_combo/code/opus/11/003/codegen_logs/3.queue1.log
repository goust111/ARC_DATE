+    elif mode == "tie_row":
+        assert winner["distance"] == loser["distance"]
+        assert winner["marker_pos"][0] < loser["marker_pos"][0]
+    else:
+        assert mode == "tie_col"
+        assert winner["distance"] == loser["distance"]
+        assert winner["marker_pos"][0] == loser["marker_pos"][0]
+        assert winner["marker_pos"][1] < loser["marker_pos"][1]
