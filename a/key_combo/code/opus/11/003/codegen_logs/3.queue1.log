+            c_choices = list(
+                range(
+                    PLACEMENT_MARGIN,
+                    w - conflict_spec["width"] - PLACEMENT_MARGIN + 1,
+                )
+            )
+            if not c_choices:
+                return None
+            c0 = random.choice(c_choices)
+        else:
+            r_choices = list(
+                range(
+                    PLACEMENT_MARGIN,
+                    h - conflict_spec["height"] - PLACEMENT_MARGIN + 1,
