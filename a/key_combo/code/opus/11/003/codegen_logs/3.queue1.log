+def _is_rectangular_perimeter(component: dict[str, Any]) -> bool:
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    coords = component["coords"]
+    if h == 1 or w == 1:
+        return int(component["area"]) == h * w
+    border = (
+        (coords[:, 0] == r0)
+        | (coords[:, 0] == r1)
+        | (coords[:, 1] == c0)
+        | (coords[:, 1] == c1)
+    )
