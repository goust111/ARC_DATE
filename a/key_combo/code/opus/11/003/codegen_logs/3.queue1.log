+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            grid, meta = _build_instance()
+            _validate_generated_instance(grid, meta)
+            return grid
+        except (AssertionError, ValueError, IndexError, StopIteration):
+            continue
