+    r, c = pos[0] + dr, pos[1] + dc
+    while 0 <= r < grid.shape[0] and 0 <= c < grid.shape[1]:
+        if int(grid[r, c]) != BACKGROUND:
+            return (int(r), int(c)), abs(int(r - pos[0])) + abs(int(c - pos[1]))
+        r += dr
+        c += dc
+    return None
+
+
+def _winner_key(hit: dict[str, Any]) -> tuple[int, int, int]:
