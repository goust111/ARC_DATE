+    changed_pixels = 0
+    for root_idx in roots:
+        r0, c0, r1, c1 = map(int, analysis["rects"][root_idx]["bbox"])
+        source = grid[r0 : r1 + 1, c0 : c1 + 1]
+        target = out[r0 : r1 + 1, c0 : c1 + 1]
+        protected = analysis["marker_mask"][r0 : r1 + 1, c0 : c1 + 1]
