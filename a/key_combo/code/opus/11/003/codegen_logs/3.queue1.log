+    hit_counts = {root_idx: len(analysis["hits_by_root"][root_idx]) for root_idx in roots}
+    assert 2 in hit_counts.values(), "need one doubly hit root"
+    assert 0 in hit_counts.values(), "need one untouched root"
+    if len(roots) == 3:
