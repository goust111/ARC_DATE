+    else:
+        return None
+
+    for spec in group_specs[1:]:
+        options = []
+        for r0 in range(PLACEMENT_MARGIN, h - spec["height"] - PLACEMENT_MARGIN + 1):
+            for c0 in range(PLACEMENT_MARGIN, w - spec["width"] - PLACEMENT_MARGIN + 1):
