+def _render_output(case: dict) -> np.ndarray:
+    inner = case["inner"]
+    blocks = []
+    live_tile = np.where(inner, ORANGE, PINK).astype(int)
+    dead_tile = np.full(inner.shape, PINK, dtype=int)
+    for bit in case["survivor"]:
