+    candidates = []
+    for r in range(H - stamp_size + 1):
+        for c in range(W - stamp_size + 1):
+            stamp_box = (r, c, r + stamp_size - 1, c + stamp_size - 1)
+            dr, dc = _bbox_distance(stamp_box, pattern_box)
+            if max(dr, dc) < 2:
