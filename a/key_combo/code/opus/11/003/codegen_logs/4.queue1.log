+def _bbox_distance(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> tuple[int, int]:
+    dr = max(0, b[0] - a[2] - 1, a[0] - b[2] - 1)
+    dc = max(0, b[1] - a[3] - 1, a[1] - b[3] - 1)
+    return int(dr), int(dc)
