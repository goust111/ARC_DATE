+    for r, c in candidates:
+        stamp_box = (r, c, r + stamp_size - 1, c + stamp_size - 1)
+        ok = True
+        for rr, cc in chosen:
+            other = (rr, cc, rr + stamp_size - 1, cc + stamp_size - 1)
+            dr, dc = _bbox_distance(stamp_box, other)
