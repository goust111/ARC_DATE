    spots = [(r, c) for r in range(_GEN_QUAD_SIZE) for c in range(r, _GEN_QUAD_SIZE)]
    random.shuffle(spots)
    for color in colors:
        if color not in used and spots:
            r, c = spots.pop()
            _gen_set_q_orbit(q, r, c, color)
            used.add(color)


