+    half_w = pw // 2
+    side = "left" if rng.random() < 0.5 else "right"
+    sizes = list(OCCLUDER_SIZES)
+    rng.shuffle(sizes)
+
+    for size in sizes:
+        rows = list(range(ph - size + 1))
+        cols = list(range(half_w - size + 1))
+        rng.shuffle(rows)
+        rng.shuffle(cols)
