+def _find_dividers(grid: np.ndarray):
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == DIVIDER)]
+    cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == DIVIDER)]
