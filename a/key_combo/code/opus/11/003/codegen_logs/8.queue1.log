+    for pos in markers:
+        dir_idx = _direction(current, pos)
+        if dir_idx is None or dir_idx == _reverse_dir(facing):
+            continue
+        dist = abs(pos[0] - current[0]) + abs(pos[1] - current[1])
+        candidates.append((int(dir_idx), int(dist), pos))
+    if not candidates:
