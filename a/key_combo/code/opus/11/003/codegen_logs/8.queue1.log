+
+def _first_entered_order(plan: dict, cols: int) -> tuple[list[int], list[list[int]]]:
+    current = int(plan["start"])
+    visited = {current}
+    entered: list[int] = []
+    per_step: list[list[int]] = []
+    for target in [int(cid) for cid in plan["marker_cells"]]:
