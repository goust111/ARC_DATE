+def _compose_input(cols: int, cell_h: int, cell_w: int, plan: dict, marker_positions: list[tuple[int, int]], colors: list[int]) -> np.ndarray:
+    grid, cells, _lookup = _build_layout(int(cols), int(cell_h), int(cell_w))
