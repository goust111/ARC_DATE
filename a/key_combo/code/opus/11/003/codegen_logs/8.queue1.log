+            r0 = int(divider_rows[r] + 1)
+            r1 = int(divider_rows[r + 1] - 1)
+            c0 = int(divider_cols[c] + 1)
+            c1 = int(divider_cols[c + 1] - 1)
+            center = ((r0 + r1) // 2, (c0 + c1) // 2)
+            cid = len(cells)
