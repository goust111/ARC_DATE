+def _build_layout(cols: int, cell_h: int, cell_w: int) -> tuple[np.ndarray, list[dict], np.ndarray]:
+    rows = 3
+    divider_rows = [0]
+    for _ in range(rows):
+        divider_rows.append(divider_rows[-1] + int(cell_h) + 1)
+    divider_cols = [0]
+    for _ in range(cols):
