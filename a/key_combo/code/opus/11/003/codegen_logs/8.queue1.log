+
+def _sample_colors(n: int, marker_cells: list[int], entered_order: list[int]) -> list[int]:
+    while True:
+        colors = [int(random.choice(MARKER_COLORS)) for _ in range(n)]
+        if len(set(colors)) < 2:
+            continue
+        if n >= 4 and len(set(colors)) < 3:
