+        dir_idx = _direction(prev_pos, pos)
+        if dir_idx is None or dir_idx == _reverse_dir(prev_facing):
+            continue
+        dist = abs(int(pos[0]) - int(prev_pos[0])) + abs(int(pos[1]) - int(prev_pos[1]))
