+        ],
+        4: [
+            {"start": 0, "init_dir": 0, "marker_cells": [2, 5, 4, 1], "dirs": [1, 2, 3, 0]},
+        ],
+        5: [
+            {"start": 0, "init_dir": 0, "marker_cells": [1, 7, 8, 5, 4], "dirs": [1, 2, 1, 0, 3]},
