+    cells: list[dict] = []
+    cell_lookup = np.full(grid.shape, -1, dtype=int)
+    for r in range(len(divider_rows) - 1):
+        r0 = divider_rows[r] + 1
+        r1 = divider_rows[r + 1] - 1
+        if r0 > r1:
+            continue
+        for c in range(len(divider_cols) - 1):
+            c0 = divider_cols[c] + 1
+            c1 = divider_cols[c + 1] - 1
+            if c0 > c1:
+                continue
+            cid = len(cells)
+            center = ((r0 + r1) // 2, (c0 + c1) // 2)
+            cells.append(
