            c0,c1=dc[c]+1,dc[c+1]-1
            cells.append((r,c,r0,r1,c0,c1))
    return cells

def cell_positions(cell):
    _,_,r0,r1,c0,c1=cell
    return [(r,c) for r in range(r0,r1+1) for c in range(c0,c1+1)]

def center(cell):
    _,_,r0,r1,c0,c1=cell
    return ((r0+r1)//2,(c0+c1)//2)

def direction(a,b):
    ar,ac=a; br,bc=b
    if ac==bc:
        if br<ar: return 0
        if br>ar: return 2
    if ar==br:
        if bc>ac: return 1
        if bc<ac: return 3
    return None

def compatible(history,pos):
    for p,f,chosen_dir,chosen_dist in history:
        d=direction(p,pos)
        if d is None or d==reverse(f):
            continue
        dist=abs(p[0]-pos[0])+abs(p[1]-pos[1])
        if d"'!=chosen_dir or dist<=chosen_dist:
            return False
    return True

