+def _trace_cell_path_by_ids(start_cid: int, end_cid: int, cols: int) -> list[int]:
+    sr, sc = _cid_to_rc(start_cid, cols)
+    er, ec = _cid_to_rc(end_cid, cols)
+    if sr == er:
