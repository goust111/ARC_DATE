+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+MARKER_COLORS = (BLUE, GREEN, YELLOW, GREY)
+DIRS4 = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # U, R, D, L
+GEN_ATTEMPTS = 400
+
+
