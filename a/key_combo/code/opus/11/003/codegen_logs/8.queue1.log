+def _detect_layout(grid: np.ndarray) -> tuple[list[dict], np.ndarray]:
+    divider_rows = [r for r in range(grid.shape[0]) if np.all(grid[r, :] == ORANGE)]
+    divider_cols = [c for c in range(grid.shape[1]) if np.all(grid[:, c] == ORANGE)]
