+            key=lambda pos: abs(int(pos[0]) - int(current[0])) + abs(int(pos[1]) - int(current[1])),
+            reverse=True,
+        )
+        for pos in candidates:
+            dist = abs(int(pos[0]) - int(current[0])) + abs(int(pos[1]) - int(current[1]))
+            res = rec(
+                idx + 1,
+                pos,
+                step_dir,
+                used | {pos},
+                history + [(current, facing, step_dir, dist)],
+                acc + [pos],
