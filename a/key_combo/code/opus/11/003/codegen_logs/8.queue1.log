+
+def _cid_to_rc(cid: int, cols: int) -> tuple[int, int]:
+    return divmod(int(cid), int(cols))
+
+
+def _rc_to_cid(r: int, c: int, cols: int) -> int:
+    return int(r) * int(cols) + int(c)
