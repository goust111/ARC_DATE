+    dir_idx = _direction(start, end)
+    assert dir_idx is not None, "movement must be axis-aligned"
+    dr, dc = DIRS4[dir_idx]
+    r, c = start
+    out: list[int] = []
+    steps = abs(int(end[0]) - int(start[0])) + abs(int(end[1]) - int(start[1]))
+    for _ in range(steps):
+        r += dr
+        c += dc
+        cid = int(cell_lookup[r, c])
