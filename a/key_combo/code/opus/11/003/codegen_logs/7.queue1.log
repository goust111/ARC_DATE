0090:     line = np.full((num_colors, 1), Color.BLACK)
0091:     for i in range(num_colors):
0092:         line[i, 0] = colors[i]
0093: 
0094:     # form a cross pattern randomly
0095:     cross_points = random.randint(0, num_colors - 1)
0096:     sprite = np.full((num_colors, num_colors), Color.BLACK)
0097:     line_t = np.transpose(line)
0098:     paste(sprite, line, 0, cross_points, transparent=Color.BLACK, clip=True)
0099:     paste(sprite, line_t, cross_points, 0, transparent=Color.BLACK, clip=True)
