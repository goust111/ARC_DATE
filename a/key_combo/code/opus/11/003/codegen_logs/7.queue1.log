+def _paint_shape(grid: np.ndarray, shape: np.ndarray, top: int, left: int, color: int) -> bool:
+    H, W = grid.shape
+    coords = np.argwhere(shape)
+    for rr, cc in coords:
+        dr = top + int(rr)
+        dc = left + int(cc)
+        if not (0 <= dr < H and 0 <= dc < W) or int(grid[dr, dc]) != 0:
+            return False
