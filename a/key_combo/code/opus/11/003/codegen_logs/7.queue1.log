+    for c, h in enumerate(heights):
+        mirror_c = width - 1 - c
+        mask[height - h :, c] = True
+        mask[height - h :, mirror_c] = True
+    if len(set(heights)) == 1:
+        idx = random.randrange(len(heights))
+        heights[idx] = 1 if heights[idx] == 2 else 2
+        c = idx
+        mirror_c = width - 1 - c
+        mask[:, c] = False
+        mask[:, mirror_c] = False
+        h = heights[idx]
+        mask[height - h :, c] = True
+        mask[height - h :, mirror_c] = True
