+                break
+        if not placed:
+            return None
+
+    try:
+        analysis = _analyze(grid)
+    except AssertionError:
+        return None
+
+    if not _semantic_checks(grid, analysis, require_truncation=include_truncation):
+        return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
