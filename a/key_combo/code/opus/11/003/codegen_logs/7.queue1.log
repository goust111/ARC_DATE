0078: def generate_input():
0079:     # Randomly choose the number of regions that are going to form the output canvas
0080:     w, h = np.random.randint(3, 6), np.random.randint(3, 6)
0081:     # Keep track of the color of each region
0082:     region_colors = np.full((w, h), Color.BLACK)
0083: 
0084:     # Randomly choose the colors. the separator gets a special color and colored regions get a color randomly selected from other_colors
0085:     num_other_colors = np.random.randint(1, 4)
0086:     separator_color, *other_colors = np.random.choice(Color.NOT_BLACK, num_other_colors + 1, replace=False)
0087: 
0088:     # Randomly color the regions
0089:     for r, c in np.ndindex(w, h):
0090:         # Randomly determine if the cell should be colored
0091:         if np.random.choice([True, False]):
0092:             # Randomly choose the color
0093:             region_colors[r, c] = np.random.choice(other_colors)
0094:     
0095:     # Randomly choose the scale factor and scale the regions so that they are bigger than just a single pixel
0096:     scale_factor = np.random.randint(3, 6)
0097:     grid = scale_sprite(region_colors, scale_factor)
0098:     
0099:     # Draw horizontal/vertical lines to separate the colors
0100:     interval = scale_factor
0101:     # First draw vertical lines
0102:     for r in range(interval, w * scale_factor, interval):
0103:         draw_line(grid, r=r, c=0, direction=(0, 1), color=separator_color)
0104:     # Then draw horizontal lines
0105:     for c in range(interval, h * scale_factor, interval):
