+    return [(0, 0), (0, w - cut), (cut, w), (h, w), (h, 0)]
+
+
+def _make_pent_left() -> list[tuple[int, int]]:
+    h = random.randint(5, 8)
+    w = random.randint(5, 8)
+    cut = random.randint(2, min(h - 1, w - 1, 4))
+    return [(0, cut), (0, w), (h, w), (h, 0), (cut, 0)]
