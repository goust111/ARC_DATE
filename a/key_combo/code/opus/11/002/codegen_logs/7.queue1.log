+    w = random.randint(5, 8)
+    cut1 = random.randint(2, min(h - 1, w - 1, 4))
+    cut2 = random.randint(2, min(h - 1, w - 1, 4))
+    return [(0, 0), (0, w - cut1), (cut1, w), (h, w), (h, cut2), (h - cut2, 0)]
