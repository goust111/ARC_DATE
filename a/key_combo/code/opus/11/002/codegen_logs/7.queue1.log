+    for start in random.sample(vertices, len(vertices)):
+        for offset in random.sample(DIR8, len(DIR8)):
+            rr, cc = start[0] + offset[0], start[1] + offset[1]
+            if not in_bounds(shape, rr, cc) or (rr, cc) in vertices_set:
+                continue
