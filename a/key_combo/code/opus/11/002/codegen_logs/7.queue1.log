+def _input_grid(shape: tuple[int, int], vertices: list[tuple[int, int]], start: tuple[int, int], offset: tuple[int, int]) -> np.ndarray:
+    g = np.zeros(shape, dtype=int)
+    for r, c in vertices:
+        g[r, c] = VERTEX
