+        )
+
+    debug = {
+        "vertices": vertices,
+        "cycle": cycle,
+        "start_vertex": start_vertex,
+        "shadow_offset": shadow_offset,
+        "edges": edges,
+        "shadow_events": shadow_events,
+        "shadow_skip_blue": shadow_skip_blue,
+        "shadow_skip_oob": shadow_skip_oob,
