+
+def _place_targeted_blockers(
+    g: np.ndarray,
+    vertices: list[tuple[int, int]],
+    anchor_red: tuple[int, int],
+    dbg: dict,
+    clip_bias: float,
+) -> set[tuple[int, int]]:
