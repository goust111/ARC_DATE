+def _aligned_8(a: tuple[int, int], b: tuple[int, int]) -> bool:
+    dr = b[0] - a[0]
+    dc = b[1] - a[1]
+    return (dr == 0 and dc != 0) or (dc == 0 and dr != 0) or (dr != 0 and abs(dr) == abs(dc))
