+def _polygon_template() -> list[tuple[int, int]]:
+    builders = [_make_rectangle, _make_diamond, _make_pent_right, _make_pent_left, _make_hex]
+    weights = [20, 18, 20, 20, 22]
+    return random.choices(builders, weights=weights, k=1)[0]()
+
