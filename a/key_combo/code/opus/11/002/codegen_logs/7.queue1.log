+        cells = _line_cells(a, b) if aligned else []
+        edge = {
+            "a": a,
+            "b": b,
+            "aligned": aligned,
+            "clear": clear,
+            "drawn": aligned and clear,
+            "cells": cells if aligned and clear else [],
+            "dir": _step_dir(a, b) if aligned else None,
