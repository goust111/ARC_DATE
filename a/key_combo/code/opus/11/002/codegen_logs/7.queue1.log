+                event = {
+                    "edge_index": edge_index,
+                    "point_index": point_index,
+                    "edge_dir": edge["dir"],
+                    "base_point": (r, c),
+                    "source": (rr, cc),
+                    "placed": False,
+                    "skip": None,
+                }
+                if not (0 <= rr < h and 0 <= cc < w):
