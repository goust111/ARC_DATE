+    if len(_RECENT_OUTPUT_SIGS) >= RECENT_OUTPUT_LIMIT:
+        _RECENT_OUTPUT_SIGS.clear()
+    _RECENT_OUTPUT_SIGS.add(sig)
+    return inp
+
