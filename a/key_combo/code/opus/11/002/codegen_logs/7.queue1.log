+    ph = r1 - r0 + 1
+    pw = c1 - c0 + 1
+    if ph > h - 2 or pw > w - 2:
+        return None
+
+    base_top = random.randint(2, max(2, h - ph - 2))
+    base_left = random.randint(2, max(2, w - pw - 2))
+    top = base_top
+    left = base_left
