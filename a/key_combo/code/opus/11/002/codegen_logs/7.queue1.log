+
+def _rotate_cw90(v: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = v
+    return dc, -dr
+
+
+def _rotate_ccw90(v: tuple[int, int]) -> tuple[int, int]:
+    dr, dc = v
+    return -dc, dr
+
+
+def _outer_normal(
+    source: tuple[int, int],
+    edge_dir: tuple[int, int],
+    centroid: tuple[float, float],
+) -> tuple[int, int]:
