+    mid = h // 2
+    for _ in range(200):
+        upper_cols = _sample_spaced_columns(rng, w, n_pairs)
+        lower_base = upper_cols[:]
+        rng.shuffle(lower_base)
+        lower_cols = [int(np.clip(c + int(rng.integers(-3, 4)), 1, w - 2)) for c in lower_base]
+        if len(set(lower_cols)) < n_pairs:
