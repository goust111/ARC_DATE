def bres(p0,p1):
    r0,c0=p0; r1,c1=p1
    pts=[]
    dr=abs(r1-r0); dc=abs(c1-c0)
    sr=1 if r0<r1 else -1
    sc=1 if c0<c1 else -1
    err=dr-dc
    r,c=r0,c0
