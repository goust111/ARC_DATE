import numpy as np, random

PALETTE=[1,2,3]


def candidate_info(grid):
    g=np.asarray(grid,int)
    H,W=g.shape
    infos=[]
    for P in range(1,H+1):
        for Q in range(1,W+1):
            mapping={}
            ok=True
            for r in range(H):
                for c in range(W):
                    col=int(g[r,c])
                    if col==0:
                        continue
                    k=(r%P,c%Q)
                    prev=mapping.get(k)
                    if prev is None:
                        mapping[k]=col
                    elif prev"'!=col:
                        ok=False; break
                if not ok: break
            if not ok:
                continue
            out=np.zeros_like(g)
            for (rr,cc),col in mapping.items():
                out[rr::P,cc::Q]=col
            infos.append((P,Q,out,np.array_equal(out,out[:,::-1]),len(mapping)))
    return infos


def minimal_periods(full):
    H,W=full.shape
    best=None
    for P in range(1,H+1):
        if H%P: continue
        for Q in range(1,W+1):
            if W%Q: continue
            ok=True
            for r in range(H):
                for c in range(W):
                    if full[r,c]!=full[r%P,c%Q]: ok=False; break
                if not ok: break
            if ok:
                if best is None or P*Q<best[0]*best[1]:
                    best=(P,Q)
    return best


def random_tile(P,Q):
    tile=np.zeros((P,Q),int)
    half=Q//2
    colors=PALETTE[:random.randint(2,3)]
    random.shuffle(colors)
    used=set()
    for r in range(P):
        active=False
        for c in range(half):
            if random.random()<0.45:
                col=random.choice(colors)
                tile[r,c]=tile[r,Q-1-c]=col
                used.add(col)
                active=True
        if Q%2 and random.random()<0.35:
            col=random.choice(colors)
            tile[r,half]=col
            used.add(col)
            active=True
        if not active:
            c=random.randrange(half) if half else 0
            col=random.choice(colors)
            tile[r,c]=tile[r,Q-1-c]=col
            used.add(col)
    if len(used)<2:
        return None
    if np.count_nonzero(tile)<max(4,P+1):
        return None
    return tile


def build_full():
    for _ in range(2000):
        P=random.randint(2,4)
        Q=random.randint(3,6)
        mult_w=random.choice([m for m in (2,3,4) if Q*m<=18 and (Q*m)%2==0])
        mult_h=random.choice([m for m in (2,3,4) if P*m<=16])
        H,W=P*mult_h,Q*mult_w
        tile=random_tile(P,Q)
        if tile is None: continue
        full=np.tile(tile,(mult_h,mult_w))
        if not np.array_equal(full,full[:,::-1]):
            continue
        mp=minimal_periods(full)
        if mp!=(P,Q):
            continue
        return full,P,Q
    return None


def residue_occurrences(H,W,P,Q):
    d={}
    for r in range(H):
        for c in range(W):
            d.setdefault((r%P,c%Q),[]).append((r,c))
    return d


def sample_input(full,P,Q):
    H,W=full.shape
    occ=residue_occurrences(H,W,P,Q)
    inp=np.zeros_like(full)
    classes=[]
    for rr in range(P):
        for cc in range(Q):
            col=int(full[rr,cc])
            if col!=0:
                classes.append((rr,cc,col))
    # maybe choose 1 or 2 witnesses per class
    for rr,cc,col in classes:
        positions=occ[(rr,cc)]
        weights=[]
        for r,c in positions:
            # bias away from mirrored mate, top-leftish asymmetry
            w=1
            if c!=W-1-c: w+=2
            if r<H-1-r: w+=1
            if c<W-1-c: w+=1
            weights.append(w)
        k=1 if random.random()<0.75 else min(2,len(positions))
        chosen=random.choices(positions,weights=weights,k=k)
        # de-dup while keeping count small
        uniq=[]
        seen=set()
        for p in chosen:
            if p not in seen:
                uniq.append(p); seen.add(p)
        if not uniq:
            uniq=[random.choice(positions)]
        for r,c in uniq:
            inp[r,c]=col
    return inp


def valid(inp,full,P,Q):
    infos=candidate_info(inp)
    sym=[x for x in infos if x[3]]
    if len(infos)<2 or len(sym)!=1:
        return False, len(infos), [i[:2] for i in sym], None
    if sym[0][0:2]!=(P,Q):
        return False, len(infos), [i[:2] for i in sym], '"'wrong-period'
    if not np.array_equal(sym[0][2],full):
        return False, len(infos), [i[:2] for i in sym], 'wrong-output'
    smaller=[(p,q) for p,q,_,_,_ in infos if p*q<P*Q]
    if not smaller:
        return False, len(infos), [i[:2] for i in sym], 'no-smaller'
    return True, len(infos), [i[:2] for i in sym], smaller[:5]

ok=0
for t in range(100):
    made=False
    for _ in range(100):
        x=build_full()
        if not x: continue
        full,P,Q=x
        for _ in range(300):
            inp=sample_input(full,P,Q)
            good,*rest=valid(inp,full,P,Q)
            if good:
                ok+=1; made=True
                print('ok',t,full.shape,(P,Q),np.count_nonzero(inp),rest)
                break
        if made: break
    if not made:
        print('failed at',t)
        break
print('total ok',ok)
