            k=1 if random.random()<0.8 else 2
            for r,c in set(random.choices(ps,weights=weights,k=k)): inp[r,c]=col
        infos=candidate_info(inp)
        sym=[x for x in infos if x[3]]
        if len(infos)>=2 and len(sym)==1 and sym[0][:2]==(P,Q) and np.array_equal(sym[0][2],full) and any(p*q<P*Q for p,q,_,_ in infos):
