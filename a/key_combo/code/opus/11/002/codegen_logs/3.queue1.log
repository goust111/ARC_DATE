    return infos

def min_period(full):
    H,W=full.shape; best=None
    for P in range(1,H+1):
        if H%P: continue
        for Q in range(1,W+1):
            if W%Q: continue
            if all(full[r,c]==full[r%P,c%Q] for r in range(H) for c in range(W)):
                if best is None or P*Q<best[0]*best[1]: best=(P,Q)
    return best

