from __future__ import annotations
import random, time
import numpy as np

ARC_COLORS=(1,2,3,4,5,6,7,8,9)
FAMILIES=[
    np.array([[0,1,1,0],[1,2,2,1]],dtype=int),
    np.array([[0,1,1,0],[2,3,3,2]],dtype=int),
    np.array([[0,1,1,0],[0,1,1,0],[1,2,2,1]],dtype=int),
    np.array([[0,1,1,0],[0,1,1,0],[2,3,3,2]],dtype=int),
    np.array([[0,0,1,0,0],[0,1,2,1,0]],dtype=int),
    np.array([[0,0,1,0,0],[2,1,3,1,2]],dtype=int),
    np.array([[0,0,1,0,0],[0,2,3,2,0]],dtype=int),
    np.array([[0,0,1,0,0],[0,0,2,0,0],[3,1,2,1,3]],dtype=int),
    np.array([[0,0,1,0,0],[0,1,2,1,0],[0,0,3,0,0]],dtype=int),
    np.array([[0,0,1,1,0,0],[1,0,2,2,0,1]],dtype=int),
    np.array([[0,0,1,1,0,0],[2,0,3,3,0,2]],dtype=int),
]

def complete(shape,P,Q,mapping):
    out=np.zeros(shape,dtype=int)
    for (rr,cc),col in mapping.items():
        out[rr::P,cc::Q]=col
    return out

def enum(grid):
    g=np.asarray(grid,int)
    H,W=g.shape
    pts=[(int(r),int(c),int(g[r,c])) for r,c in np.argwhere(g"'!=0)]
    infos=[]
    for P in range(1,H+1):
        for Q in range(1,W+1):
            mapping={}
            ok=True
            for r,c,col in pts:
                k=(r%P,c%Q)
                prev=mapping.get(k)
                if prev is None: mapping[k]=col
                elif prev!=col:
                    ok=False; break
            if not ok: continue
            out=complete((H,W),P,Q,mapping)
            infos.append((P,Q,out,np.array_equal(out,out[:,::-1])))
    return infos

def min_period(full):
    H,W=full.shape
    for area in range(1,H*W+1):
        for P in range(1,H+1):
            if area%P: continue
            Q=area//P
            if P>H or Q>W or H%P or W%Q: continue
            if all(full[r,c]==full[r%P,c%Q] for r in range(H) for c in range(W)):
                return (P,Q)
    raise AssertionError

def relabel(template):
    labels=sorted(int(x) for x in np.unique(template) if x)
    colors=random.sample(ARC_COLORS, k=len(labels))
    out=np.zeros_like(template)
    for src,dst in zip(labels,colors):
        out[template==src]=dst
    return out

def choose_repeats(P,Q):
    row_opts=[4,5] if P==2 else [3,4]
    col_opts=[]
    for rep in (2,3,4):
        W=Q*rep
        if W<=18 and W%2==0:
            col_opts.append(rep)
    return random.choice(row_opts), random.choice(col_opts)

def occ(H,W,P,Q):
    d={}
    for r in range(H):
        for c in range(W):
            d.setdefault((r%P,c%Q), []).append((r,c))
    return d

def w(pos,H,W):
    r,c=pos
    score=1
    if c<W//2: score+=4
    if r<H//2: score+=2
    if c!=W-1-c: score+=1
    if r!=H-1-r: score+=1
    return score

def valid(inp,full,P,Q):
    infos=enum(inp)
    sym=[x for x in infos if x[3]]
    if len(infos)<2 or len(sym)!=1: return False
    if sym[0][:2]!=(P,Q): return False
    if not np.array_equal(sym[0][2],full): return False
    if not any(p*q<P*Q for p,q,_,_ in infos if (p,q)!=(P,Q)): return False
    if np.array_equal(inp,full): return False
    return True

def sample(full,P,Q):
    H,W=full.shape
    O=occ(H,W,P,Q)
    classes=[(r,c,int(full[r,c])) for r in range(P) for c in range(Q) if full[r,c]!=0]
    for _ in range(180):
        inp=np.zeros_like(full)
        order=classes[:]
        random.shuffle(order)
        for rr,cc,col in order:
            positions=O[(rr,cc)]
            weights=[w(p,H,W) for p in positions]
            k=1 if random.random()<0.72 else 2
            picks=[]
            for p in random.choices(positions, weights=weights, k=k+2):
                if p not in picks:
                    picks.append(p)
                if len(picks)==k:
                    break
            if not picks:
                picks=[random.choice(positions)]
            for r,c in picks:
                inp[r,c]=col
        if valid(inp,full,P,Q):
            return inp
    return None

def gen():
    for _ in range(200):
        base=np.array(random.choice(FAMILIES), copy=True)
        P,Q=base.shape
        base=np.roll(base, shift=random.randrange(P), axis=0)
        tile=relabel(base)
        rr,cr=choose_repeats(P,Q)
        full=np.tile(tile,(rr,cr))
        if min_period(full)!=(P,Q):
            continue
        inp=sample(full,P,Q)
        if inp is not None:
            return inp, full, (P,Q)
    raise RuntimeError

start=time.time()
for i in range(30):
    inp, full, pq = gen()
    if i<5:
        print(i, inp.shape, pq, np.count_nonzero(inp), len(np.unique(full))-1)
print('"'elapsed', time.time()-start)
