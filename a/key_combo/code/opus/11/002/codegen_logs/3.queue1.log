import itertools, numpy as np, random
COLS=[0,1,2,3]

def candidate_info(grid):
    g=np.asarray(grid,int); H,W=g.shape; infos=[]
    for P in range(1,H+1):
        for Q in range(1,W+1):
            mapping={}; ok=True
            for r in range(H):
                for c in range(W):
                    col=int(g[r,c])
                    if col==0: continue
                    k=(r%P,c%Q)
                    prev=mapping.get(k)
                    if prev is None: mapping[k]=col
                    elif prev"'!=col: ok=False; break
                if not ok: break
            if not ok: continue
            out=np.zeros_like(g)
            for (rr,cc),col in mapping.items(): out[rr::P,cc::Q]=col
            infos.append((P,Q,out,np.array_equal(out,out[:,::-1])))
    return infos

def min_period(full):
    H,W=full.shape; best=None
    for P in range(1,H+1):
        if H%P: continue
        for Q in range(1,W+1):
            if W%Q: continue
            if all(full[r,c]==full[r%P,c%Q] for r in range(H) for c in range(W)):
                if best is None or P*Q<best[0]*best[1]: best=(P,Q)
    return best

def occ(H,W,P,Q):
    d={}
    for r in range(H):
        for c in range(W): d.setdefault((r%P,c%Q),[]).append((r,c))
    return d

def sym_rows(Q):
    half=Q//2
    mids=[[]] if Q%2==0 else [[m] for m in COLS]
    rows=[]
    for pairs in itertools.product(COLS, repeat=half):
        for mid in mids:
            row=list(pairs)+mid+list(reversed(pairs))
            if any(x!=0 for x in row): rows.append(tuple(row))
    return rows

for P,Q,mh,mw in [(3,4,3,2),(2,5,3,2),(3,5,2,2),(2,6,3,2)]:
    rows=sym_rows(Q)
    found=0
    for tile_rows in itertools.product(rows, repeat=P):
        tile=np.array(tile_rows)
        full=np.tile(tile,(mh,mw))
        if min_period(full)!=(P,Q):
            continue
        classes=[(r,c,int(tile[r,c])) for r in range(P) for c in range(Q) if tile[r,c]!=0]
        if len(classes)<4 or len({cl[2] for cl in classes})<2: continue
        O=occ(*full.shape,P,Q)
        good=None
        for _ in range(250):
            inp=np.zeros_like(full)
            for rr,cc,col in classes:
                ps=O[(rr,cc)]
                # choose one or two witnesses, bias left/top and avoid mirrors
                weights=[3 + (c < full.shape[1]//2) + (r < full.shape[0]//2) + (c != full.shape[1]-1-c) for r,c in ps]
                k=1 if random.random()<0.8 else 2
                picks=random.choices(ps,weights=weights,k=k)
                for r,c in set(picks): inp[r,c]=col
            infos=candidate_info(inp)
            sym=[x for x in infos if x[3]]
            if len(infos)>=2 and len(sym)==1 and sym[0][:2]==(P,Q) and np.array_equal(sym[0][2],full) and any(p*q<P*Q for p,q,_,_ in infos):
                good=inp; break
        if good is not None:
            found+=1
            print('"'family', (P,Q),'tile=\\n', tile)
            print('cands',[(p,q,s) for p,q,_,s in candidate_info(good)][:10], '...')
            break
    print('summary', (P,Q), found)
