+    else:
+        assert abs(dr) == abs(dc)
+        sr = 1 if dr > 0 else -1
+        sc = 1 if dc > 0 else -1
+        steps = abs(dr)
+    return [(r0 + i * sr, c0 + i * sc) for i in range(steps + 1)]
