+def local_vertices(template: str, scaled_shape: tuple[int, int], rng: random.Random):
+    sh, sw = scaled_shape
+    if template == "diamond":
+        a_min = max((sh + 2) // 2 + 1, (sw + 2) // 2 + 1, 4)
+        a_max = min(10, 14)
+        if a_min > a_max:
+            return None
+        a = rng.randint(a_min, a_max)
+        return [(0, a), (a, 2 * a), (2 * a, a), (a, 0)]
+    if template == "hhex":
