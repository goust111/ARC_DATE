+
+def cells_for_placement(sprite: np.ndarray, placement: tuple[int, int, int]):
+    scaled, r0, c0, sh, sw = placement_lookup(sprite, placement)
+    cells = {}
+    for rr in range(sh):
+        for cc in range(sw):
+            color = int(scaled[rr, cc])
+            if color != BLACK:
+                cells[(r0 + rr, c0 + cc)] = color
+    return cells
