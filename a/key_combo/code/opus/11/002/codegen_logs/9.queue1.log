+def placement_lookup(sprite: np.ndarray, placement: tuple[int, int, int]):
+    k, r0, c0 = placement
+    scaled = scale_sprite(sprite, k)
+    sh, sw = scaled.shape
+    return scaled, r0, c0, sh, sw
