+    lower_boundary = _row_with_optional_hole(lower_left, lower_len, lower_hole)
+    upper_boundary = _row_with_optional_hole(upper_left, upper_len, upper_hole)
+    lower_rows = _grow_half(lower_boundary, half_h, w)
