    for start, direction in red_specs:
        _paint_red_ray(g, out, bg, start, direction)

    yellow_specs = [
        ((r0 - 1, cm), (-1, 1), "h", "asc"),
        ((rm, c0 - 1), (-1, -1), "v", "desc"),
        ((r1 + 1, cm), (1, -1), "h", "desc"),
        ((rm, c1 + 1), (1, 1), "v", "asc"),
    ]
    for start, direction, odd_axis, odd_order in yellow_specs:
        _paint_yellow_ribbon(g, out, bg, start, direction, odd_axis, odd_order)

    return out

