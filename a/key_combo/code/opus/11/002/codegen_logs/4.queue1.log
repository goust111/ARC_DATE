+    split_row = top + half_h
+
+    max_total = w - 8
+    lower_len = random.randint(3, min(6, max_total - 3))
+    upper_len = random.randint(3, min(6, max_total - lower_len))
+    left_max = w - 5 - (lower_len + upper_len)
+    if left_max < 4:
