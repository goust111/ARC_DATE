+
+    out = np.full_like(g, int(bg))
+    out[g == BLOCKER] = BLOCKER
+
+    lower_rows = np.array([r for r, _ in info["lower_coords"]], dtype=int)
+    lower_cols = np.array([c for _, c in info["lower_coords"]], dtype=int)
