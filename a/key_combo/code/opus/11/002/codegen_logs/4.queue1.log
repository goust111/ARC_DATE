+    lower_left = random.randint(4, left_max)
+    upper_left = lower_left + lower_len
+
+    lower_hole = lower_len >= 4 and random.random() < 0.8
+    upper_hole = upper_len >= 4 and random.random() < 0.8
+    if not lower_hole and not upper_hole:
