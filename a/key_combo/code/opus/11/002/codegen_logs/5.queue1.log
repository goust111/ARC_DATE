+    ar, ac = anchor
+    for tr, tc, _color in sorted(targets):
+        out[tr, tc] = BG
+        for r in range(sprite.shape[0]):
+            for c in range(sprite.shape[1]):
+                value = int(sprite[r, c])
+                if value in (BG, GRAY):
+                    continue
+                out[tr + (r - ar), tc + (c - ac)] = value
