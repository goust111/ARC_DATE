+            cc = tc + (int(c) - sc)
+            value = int(g[int(r), int(c)])
+            if value == GRAY:
+                continue
+            assert _in_bounds(g.shape, rr, cc), "translated copy must stay in bounds"
+            out[rr, cc] = value
+        for dr in range(2):
+            for dc in range(2):
+                if mask[dr, dc]:
+                    rr, cc = tr + dr, tc + dc
