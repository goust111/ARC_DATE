+
+
+def _entry_columns(n_legend: int) -> list[int]:
+    cols = [random.randint(1, 3)]
+    for _ in range(n_legend - 1):
+        cols.append(cols[-1] + random.randint(4, 6))
+    return cols
+
+
+def _place_targets(
