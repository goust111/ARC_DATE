+
+def _anchor_candidates(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    total = int(mask.sum())
+    candidates: list[tuple[int, int]] = []
+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if r + 1 >= h or c + 1 >= w:
+            continue
+        if not any(0 <= nr < h and 0 <= nc < w and mask[nr, nc] for nr, nc in _neighbors4(r, c)):
+            continue
