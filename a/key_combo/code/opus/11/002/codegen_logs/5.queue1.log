+    colors = random.sample(list(LEGEND_COLORS), n)
+    masks = [TEMPLATE_MASKS[0].copy()]
+    if n == 2:
+        masks.append(TEMPLATE_MASKS[4].copy() if random.random() < 0.7 else random.choice(TEMPLATE_MASKS[1:4]).copy())
+    else:
