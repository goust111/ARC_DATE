  26: def main(grid: np.ndarray) -> np.ndarray:
  27:     """
  28:     Erase every pixel whose color matches the marker inside the corner bracket, except for the marker itself.
  29: 
  30:     Input structure
  31:     - The background is the most common color.
  32:     - There is exactly one monochromatic 4-connected corner bracket object.
  33:     - Inside the bracket bbox, outside the bracket cells, there is exactly one foreground marker pixel.
  34:     Rule
  35:     - Read the marker color.
  36:     - Recolor every other pixel of that color to the background.
  37:     - Leave the bracket, the marker, and all other colors unchanged.
  38:     Key insight
  39:     - The bracket is a color selector: its enclosed marker names the color to delete everywhere else.
  40:     """
  41:     g = np.asarray(grid, dtype=int)
  42:     assert g.ndim == 2
  43: 
  44:     bg = get_bg(g)
  45:     components = find_components(g, bg=bg, connectivity=4, monochromatic=True, min_area=3)
  46:     brackets = [component for component in components if _is_corner_bracket(component)]
  47:     assert len(brackets) == 1, "expected exactly one corner bracket"
  48: 
  49:     bracket = brackets[0]
  50:     bracket_coords = {tuple(map(int, p)) for p in bracket["coords"]}
  51:     r0, c0, r1, c1 = bracket["bbox"]
  52:     markers = [
  53:         (r, c)
  54:         for r in range(r0, r1 + 1)
  55:         for c in range(c0, c1 + 1)
  56:         if (r, c) not in bracket_coords and g[r, c] != bg
  57:     ]
  58:     assert len(markers) == 1, "expected one marker inside the bracket"
  59: 
  60:     marker = markers[0]
  61:     marker_color = int(g[marker])
  62:     assert marker_color != bg and marker_color != int(bracket["color"])
  63: 
  64:     out = g.copy()
  65:     out[out == marker_color] = bg
  66:     out[marker] = marker_color
  67:     return out
