+def _random_connected_mask() -> np.ndarray:
+    for _ in range(120):
+        h = random.randint(4, 6)
+        w = random.randint(4, 6)
+        lo = max(8, int(np.ceil(0.45 * h * w)))
+        hi = min(14, int(np.floor(0.75 * h * w)))
