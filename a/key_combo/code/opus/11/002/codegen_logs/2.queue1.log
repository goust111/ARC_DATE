+def _paste(dst: np.ndarray, patch: np.ndarray, top: int, left: int) -> None:
+    h, w = patch.shape
+    area = dst[top : top + h, left : left + w]
+    assert np.all((area == BG) | (patch == BG))
+    area[patch != BG] = patch[patch != BG]
