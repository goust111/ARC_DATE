+            grey_cells = [(r, c) for r, c in coords if int(g[r, c]) == GREY]
+            assert len(key_cells) == 1 and len(grey_cells) >= 3
+            kr, kc = key_cells[0]
+            legend.append(
+                {
+                    "bbox": box,
+                    "shape": _normalize(grey_cells),
+                    "count": len(grey_cells),
+                    "key_color": int(g[kr, kc]),
