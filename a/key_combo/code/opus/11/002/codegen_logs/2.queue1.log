+def _analyze_grid(grid: np.ndarray) -> dict[str, list[dict[str, object]]]:
+    g = np.asarray(grid, dtype=int)
+    comps = _component_coords(g != BG)
+    legend: list[dict[str, object]] = []
+    panels: list[dict[str, object]] = []
