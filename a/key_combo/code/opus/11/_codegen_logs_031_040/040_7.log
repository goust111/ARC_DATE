+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+LEGEND_PALETTE = (1, 2, 3, 4, 6)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+MAX_ATTEMPTS = 400
