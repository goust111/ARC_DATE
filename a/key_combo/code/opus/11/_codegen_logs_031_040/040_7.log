  68:             pr, pc = path[i - 1]
  69:             nr, nc = path[(i + 1) % n]
  70:             incoming = (r - pr, c - pc)
  71:             outgoing = (nr - r, nc - c)
  72:             cross = incoming[0] * outgoing[1] - incoming[1] * outgoing[0]
  73:             if cross == 0:
