+    top, left, step = _infer_stack_geometry(normals, order)
+    h, w = normal_mask.shape
+    assert step >= h
+    assert 0 <= top and top + (len(order) - 1) * step + h <= g.shape[0]
+    assert 0 <= left and left + w <= g.shape[1]
