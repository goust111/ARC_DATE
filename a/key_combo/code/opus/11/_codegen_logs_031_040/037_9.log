+            continue
+        d1, d2 = rng.choice(dir_pairs)
+        if mode == "overlap_shorter":
+            k1 = rng.randint(2, 4)
+            k2_choices = [k for k in range(2, 6) if k != k1]
+            k2 = rng.choice(k2_choices)
+        else:
+            k1 = rng.randint(2, 5)
+            k2 = k1
+
