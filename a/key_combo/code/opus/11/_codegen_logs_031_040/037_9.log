+                edge_added = True
+                break
+            if not edge_added:
+                continue
+            target_count = 5
+        elif rng.random() < 0.5:
+            target_count = 5
+
+        extras = [cand for cand in candidates if _fits_candidate(cand, placements)]
+        rng.shuffle(extras)
