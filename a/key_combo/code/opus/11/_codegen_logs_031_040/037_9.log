+
+def _trace_landpoint(
+    start: tuple[int, int],
+    direction: tuple[int, int],
+    occupied: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> tuple[tuple[int, int], str, tuple[int, int] | None, list[tuple[int, int]]]:
+    h, w = shape
+    r, c = start
+    dr, dc = direction
+    rr, cc = r + dr, c + dc
+    path: list[tuple[int, int]] = []
