+            for i in range(len(tris)):
+                for j in range(i + 1, len(tris)):
+                    a, b = tris[i], tris[j]
+                    if a["distance"] == b["distance"] and a["start"][0] != b["start"][0]:
+                        ok = True
+                        break
+                if ok:
+                    break
+            if ok:
+                break
+        if not ok:
+            return False
+
+    if mode == "overlap_tie_col":
+        ok = False
+        for items in scene["overlap_cells"].values():
+            tris = [item["triangle"] for item in items]
+            for i in range(len(tris)):
+                for j in range(i + 1, len(tris)):
