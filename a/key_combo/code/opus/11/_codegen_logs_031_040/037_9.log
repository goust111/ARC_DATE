+
+def _make_grid(h: int, w: int, template_grid: np.ndarray, placements: list[dict], colors: list[int]) -> np.ndarray:
+    grid = template_grid.copy()
+    for cand, color in zip(placements, colors):
+        for r, c in cand["cells"]:
