+    while 0 <= rr < h and 0 <= cc < w:
+        cur = (rr, cc)
+        if cur in occupied:
+            if last is None:
+                raise ValueError("projectile has no free landing cell")
+            return last, "obstacle", cur, path
+        path.append(cur)
+        last = cur
+        rr += dr
+        cc += dc
+    if last is None:
+        raise ValueError("projectile leaves the grid immediately")
