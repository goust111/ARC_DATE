+        extras = [cand for cand in candidates if _fits_candidate(cand, placements)]
+        rng.shuffle(extras)
+        while len(placements) < target_count:
+            added = False
+            for cand in extras:
+                if _fits_candidate(cand, placements):
+                    placements.append(cand)
+                    added = True
+                    break
+            if not added:
+                break
+            extras = [cand for cand in candidates if _fits_candidate(cand, placements)]
+            rng.shuffle(extras)
+        if len(placements) < 4:
+            continue
+        return placements
+    return None
+
+
+def _build_generic_random(
+    h: int,
+    w: int,
+    template_grid: np.ndarray,
+    candidates: list[dict],
+    rng: random.Random,
+) -> list[dict] | None:
+    for _ in range(320):
+        target_count = rng.choice((4, 5))
+        order = candidates[:]
+        rng.shuffle(order)
+        placements: list[dict] = []
