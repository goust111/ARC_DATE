tg, tc, off = mod._place_template(h,w,mask,'tl',rng)
cands, by_sd, by_cell = mod._generate_candidates(h,w,tc)
for mode in ['overlap_shorter','overlap_tie_row','overlap_tie_col']:
    ok=0
    for i in range(20):
        pl=mod._build_overlap(h,w,off,cands,by_sd,by_cell,rng,mode)
        if not pl:
            continue
