+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE_COLOR = 5
+TRIANGLE_COLORS = (2, 3, 4, 6, 7)
+DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
