+                rr, cc = r + dr, c + dc
+                bad = False
+                while 0 <= rr < h and 0 <= cc < w:
+                    cur = (rr, cc)
+                    if cur in template_cells:
+                        bad = True
+                        break
+                    path.append(cur)
+                    rr += dr
+                    cc += dc
+                if bad or not path:
