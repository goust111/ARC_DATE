+
+def _triangle_cells(start: tuple[int, int], direction: tuple[int, int]) -> tuple[tuple[int, int], ...]:
+    r, c = start
+    dr, dc = direction
+    return ((r, c), (r + dr, c), (r, c + dc))
+
+
+def _halo(cells: tuple[tuple[int, int], ...], h: int, w: int) -> frozenset[tuple[int, int]]:
