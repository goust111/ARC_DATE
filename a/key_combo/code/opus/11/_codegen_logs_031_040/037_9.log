+            rng.shuffle(extras)
+            edge_added = False
+            for cand in extras:
+                if not cand["edge_ok"]:
+                    continue
+                if any(cell in occupied for cell in cand["path"]):
+                    continue
+                placements.append(cand)
+                occupied.update(cand["cell_set"])
+                edge_added = True
+                break
+            if not edge_added:
+                continue
+            target_count = 5
+        elif rng.random() < 0.5:
+            target_count = 5
