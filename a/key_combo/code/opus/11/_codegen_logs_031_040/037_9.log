+    cells = {(int(r), int(c)) for r, c in coords}
+    r0, c0, r1, c1 = _bbox(coords)
+    if r1 - r0 != 1 or c1 - c0 != 1:
+        return None
+    corners = {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}
