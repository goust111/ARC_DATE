+    if (r0 + r1) % 2 != 0 or (c0 + c1) % 2 != 0:
+        raise ValueError("template bbox center must lie on a grid cell")
+    cr = (r0 + r1) // 2
+    cc = (c0 + c1) // 2
+    return tuple(sorted((int(r - cr), int(c - cc)) for r, c in mask_coords))
