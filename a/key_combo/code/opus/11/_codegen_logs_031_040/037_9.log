+    if direction not in DIRS:
+        return None
+    expect = set(_triangle_cells(start, direction))
+    if expect != cells:
+        return None
+    return {
+        "start": start,
+        "dir": direction,
+        "cells": tuple(sorted(cells)),
+    }
