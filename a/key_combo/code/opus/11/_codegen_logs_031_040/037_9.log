+        extras = [cand for cand in candidates if _fits_candidate(cand, placements)]
+        rng.shuffle(extras)
+        while len(placements) < target_count:
+            added = False
+            for cand in extras:
+                if _fits_candidate(cand, placements):
+                    placements.append(cand)
+                    added = True
