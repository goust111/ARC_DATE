+    return _analyze_scene(np.asarray(grid, dtype=int))["output"]
+
+
+def _rot90_mask(mask: np.ndarray, k: int) -> np.ndarray:
+    return np.rot90(mask, k)
+
+
+def _random_template_mask(rng: random.Random, family: str) -> np.ndarray:
