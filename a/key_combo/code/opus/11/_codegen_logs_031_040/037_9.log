+
+def _build_generic_random(
+    h: int,
+    w: int,
+    template_grid: np.ndarray,
+    candidates: list[dict],
+    rng: random.Random,
+) -> list[dict] | None:
+    for _ in range(320):
+        target_count = rng.choice((4, 5))
+        order = candidates[:]
+        rng.shuffle(order)
+        placements: list[dict] = []
+        for cand in order:
