+            _pick_candidate_at_start(by_start_dir, starts[0], d1),
+            _pick_candidate_at_start(by_start_dir, starts[1], d2),
+        ]
+        if shooters[0] is None or shooters[1] is None:
+            continue
+        if not _fits_candidate(shooters[0], placements):
