+            added = False
+            for cand in extras:
+                if _fits_candidate(cand, placements):
+                    placements.append(cand)
+                    added = True
+                    break
+            if not added:
+                break
+            extras = [cand for cand in candidates if _fits_candidate(cand, placements)]
+            rng.shuffle(extras)
+        if len(placements) < 4:
+            continue
+        return placements
+    return None
+
+
+def _assign_colors(rng: random.Random, n: int) -> list[int]:
+    cols = list(TRIANGLE_COLORS)
+    rng.shuffle(cols)
+    return cols[:n]
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        rng = random.Random()
+        h = rng.randint(18, 24)
+        w = rng.randint(18, 24)
