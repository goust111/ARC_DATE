+    out[r0, c0 : c0 + size] = border
+    out[r0 + size - 1, c0 : c0 + size] = border
+    out[r0 : r0 + size, c0] = border
+    out[r0 : r0 + size, c0 + size - 1] = border
+    out[r0 + 1 : r0 + size - 1, c0 + 1 : c0 + size - 1] = fill
