+
+def _generate_case(rng: np.random.Generator) -> np.ndarray | None:
+    size = int(rng.choice([3, 4]))
+    nr = int(rng.choice([3, 4]))
+    nc = int(rng.choice([3, 4]))
+    dy = int(rng.integers(max(size + 1, 5), 8))
+    dx = int(rng.integers(max(size + 1, 5), 8))
+
