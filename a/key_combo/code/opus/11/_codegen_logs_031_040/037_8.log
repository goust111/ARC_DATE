+import itertools
+from collections import Counter, deque
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _parse_legend(grid: np.ndarray) -> dict[int, int]:
+    top = grid[-2]
+    bottom = grid[-1]
+    mapping: dict[int, int] = {}
+    for c in range(grid.shape[1]):
+        border = int(top[c])
+        fill = int(bottom[c])
+        if border == 0 and fill == 0:
+            continue
+        assert border != 0 and fill != 0, "legend entries must be vertically aligned"
+        assert border not in mapping, "legend border colors must be unique"
+        mapping[border] = fill
+    assert len(mapping) >= 2
+    return mapping
+
+
+def _extract_sprites(body: np.ndarray) -> list[dict]:
+    sprites = []
+    for comp in _components_mask(body != 0):
+        r0, c0, r1, c1 = _bbox_coords(comp)
+        h = r1 - r0 + 1
+        w = c1 - c0 + 1
+        if h != w or h not in (3, 4):
+            continue
+        colors = {int(body[r, c]) for r, c in comp}
+        if len(colors) != 1:
+            continue
+        color = next(iter(colors))
+        patch = body[r0 : r1 + 1, c0 : c1 + 1]
+        expected = np.zeros((h, h), dtype=int)
+        expected[0, :] = color
+        expected[-1, :] = color
+        expected[:, 0] = color
+        expected[:, -1] = color
+        if not np.array_equal(patch, expected):
+            continue
+        sprites.append(
+            {
+                "r0": r0,
+                "c0": c0,
+                "size": h,
+                "color": color,
+                "center": (r0 + (h - 1) / 2.0, c0 + (h - 1) / 2.0),
+            }
+        )
+    assert sprites, "no hollow sprites found"
+    return sprites
+
