+def _axis_support_counts(indices: list[tuple[int, int]], axis: str) -> dict[int, int]:
+    assert axis in {"h", "v"}
+    counts: Counter[int] = Counter()
+    for r1, c1 in indices:
+        for r2, c2 in indices:
+            if axis == "h":
+                if r1 == r2 and c2 > c1:
+                    counts[c2 - c1] += 1
+            else:
