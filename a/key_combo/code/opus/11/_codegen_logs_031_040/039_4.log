   175	) -> tuple[int, int]:
   176	    if quadrant == "TL":
   177	        return marker_r - dr, marker_c - dc
   178	    if quadrant == "TR":
   179	        return marker_r - dr, marker_c + 1 + dc
   180	    if quadrant == "BL":
   181	        return marker_r + 1 + dr, marker_c - dc
   182	    if quadrant == "BR":
   183	        return marker_r + 1 + dr, marker_c + 1 + dc
   184	    raise ValueError(f"unknown quadrant: {quadrant}")
