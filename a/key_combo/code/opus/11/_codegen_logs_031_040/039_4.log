+def _apply_gravity_without_marker_block(grid: np.ndarray) -> np.ndarray:
+    g = np.array(grid, dtype=int, copy=True)
+    h, w = g.shape
+    out = np.full_like(g, BG)
+    red_mask = g == RED
+    for c in range(w):
+        count = int(red_mask[:, c].sum())
+        if count:
+            out[h - count : h, c] = RED
+    out[g == GREEN] = GREEN
+    return out
