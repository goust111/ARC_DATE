   269	def _place_obstacles(
   270	    shape: tuple[int, int],
   271	    marker_r: int,
   272	    marker_c: int,
   273	    source_cells: set[tuple[int, int]],
   274	    source_quadrants: set[str],
   275	    blocked_goal: int,
   276	    total_goal: int,
   277	) -> set[tuple[int, int]] | None:
   278	    blocked_candidates: set[tuple[int, int]] = set()
   279	    for r, c in source_cells:
   280	        for rr, cc in _reflection_positions(r, c, marker_r, marker_c):
   281	            quadrant = _quadrant_of(rr, cc, marker_r, marker_c)
   282	            if quadrant is None or quadrant in source_quadrants:
   283	                continue
   284	            if (rr, cc) in source_cells or _marker_adjacent(rr, cc, marker_r, marker_c):
   285	                continue
   286	            blocked_candidates.add((rr, cc))
   287	    if len(blocked_candidates) < blocked_goal:
   288	        return None
   289	
   290	    blocked = set(random.sample(tuple(blocked_candidates), blocked_goal))
   291	    obstacles = set(blocked)
   292	
   293	    h, w = shape
   294	    extra_candidates = []
   295	    for r in range(h):
   296	        for c in range(w):
   297	            quadrant = _quadrant_of(r, c, marker_r, marker_c)
   298	            if quadrant is None or quadrant in source_quadrants:
   299	                continue
   300	            if (r, c) in source_cells or (r, c) in obstacles:
   301	                continue
   302	            if _marker_adjacent(r, c, marker_r, marker_c):
   303	                continue
   304	            extra_candidates.append((r, c))
   305	    random.shuffle(extra_candidates)
   306	
   307	    for cell in extra_candidates:
   308	        if len(obstacles) >= total_goal:
   309	            break
   310	        if all(max(abs(cell[0] - r), abs(cell[1] - c)) > 1 for r, c in obstacles):
   311	            obstacles.add(cell)
   312	
   313	    if len(obstacles) != total_goal:
   314	        return None
   315	    return obstacles
