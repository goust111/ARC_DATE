+    if quadrant == "TL":
+        return marker_r - dr, marker_c - dc
+    if quadrant == "TR":
+        return marker_r - dr, marker_c + 1 + dc
+    if quadrant == "BL":
+        return marker_r + 1 + dr, marker_c - dc
+    if quadrant == "BR":
+        return marker_r + 1 + dr, marker_c + 1 + dc
+    raise ValueError(f"unknown quadrant: {quadrant}")
