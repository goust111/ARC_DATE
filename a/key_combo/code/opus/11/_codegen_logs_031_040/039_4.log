   247	def _count_components(mask: np.ndarray) -> int:
   248	    h, w = mask.shape
   249	    seen = np.zeros_like(mask, dtype=bool)
   250	    count = 0
   251	    for r, c in np.argwhere(mask):
   252	        r = int(r)
   253	        c = int(c)
   254	        if seen[r, c]:
   255	            continue
   256	        count += 1
   257	        stack = [(r, c)]
   258	        seen[r, c] = True
   259	        while stack:
   260	            cr, cc = stack.pop()
   261	            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   262	                nr, nc = cr + dr, cc + dc
   263	                if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
   264	                    seen[nr, nc] = True
   265	                    stack.append((nr, nc))
   266	    return count
