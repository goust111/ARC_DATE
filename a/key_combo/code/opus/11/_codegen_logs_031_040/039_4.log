   150	def main(grid: np.ndarray) -> np.ndarray:
   151	    """Complete four-way reflections around the green 2x2 center, let orange blockers delete some mirrored cells, then drop the resulting red pixels under gravity.
   152	
   153	    Input structure:
   154	    - Black background dominates the grid.
   155	    - A unique green 2x2 square marks the geometric symmetry center.
   156	    - Red source pixels lie in one or two quadrants around that center, and orange single-cell obstacles occupy other quadrants.
   157	
   158	    Rule:
   159	    - For every red pixel, compute its horizontal reflection, vertical reflection, and 180-degree reflection across the center of the green 2x2 block.
   160	    - Paint each reflected location red if it is black; if that reflected location is orange, block that single reflection and leave it empty; existing red and green cells stay unchanged.
   161	    - Erase all orange obstacle cells, then apply gravity column by column to all red pixels while keeping the green block fixed; in columns containing green cells, reds stack separately above and below the green block.
   162	
   163	    Key insight:
   164	    - The orange cells do not block falling; they selectively delete specific mirrored pixels before gravity, so the final falling shape depends on both incomplete symmetry completion and marker-aware settling.
   165	    """
   166	    g = np.asarray(grid, dtype=int)
   167	    assert g.ndim == 2, "expected a 2D grid"
   168	    reflected, _ = _symmetry_stage(g, obstacles_block=True)
   169	    cleared = _erase_obstacles(reflected)
   170	    return _apply_gravity(cleared)
