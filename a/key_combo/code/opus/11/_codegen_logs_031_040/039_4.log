+def _place_obstacles(
+    shape: tuple[int, int],
+    marker_r: int,
+    marker_c: int,
+    source_cells: set[tuple[int, int]],
+    source_quadrants: set[str],
+    blocked_goal: int,
+    total_goal: int,
+) -> set[tuple[int, int]] | None:
