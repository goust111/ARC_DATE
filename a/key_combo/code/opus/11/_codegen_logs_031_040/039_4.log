   236	    pool: set[tuple[int, int]], size: int, preferred_seed: tuple[int, int] | None = None
   237	) -> set[tuple[int, int]] | None:
   238	    if size > len(pool):
   239	        return None
   240	    remaining = list(pool)
   241	    if preferred_seed is not None and preferred_seed in pool:
   242	        remaining.remove(preferred_seed)
   243	        return {preferred_seed, *random.sample(remaining, size - 1)}
   244	    return set(random.sample(remaining, size))
