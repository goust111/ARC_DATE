   211	) -> set[tuple[int, int]] | None:
   212	    if not pool or size > len(pool):
   213	        return None
   214	    cells = {preferred_seed} if preferred_seed is not None else {random.choice(tuple(pool))}
   215	    frontier = set()
   216	    for r, c in cells:
   217	        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   218	            nb = (r + dr, c + dc)
   219	            if nb in pool and nb not in cells:
   220	                frontier.add(nb)
   221	    while len(cells) < size:
   222	        if not frontier:
   223	            return None
   224	        picked = random.choice(tuple(frontier))
   225	        frontier.remove(picked)
   226	        cells.add(picked)
   227	        r, c = picked
   228	        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
   229	            nb = (r + dr, c + dc)
   230	            if nb in pool and nb not in cells:
   231	                frontier.add(nb)
   232	    return cells
