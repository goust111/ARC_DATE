+        and max(ar0, br0) - 1 <= mr <= min(ar1, br1) + 1
+    )
+    vertical = (
+        ((ar1 < mr < br0) or (br1 < mr < ar0))
+        and max(ac0, bc0) - 1 <= mc <= min(ac1, bc1) + 1
