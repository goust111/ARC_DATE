+        for c in range(c0, c1 + 1):
+            for nr, nc in _neighbors4(r, c):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc]:
+                    total += 1
+    return int(total)
+
+
+def _trace_spiral(grid: np.ndarray, marker: tuple[int, int]) -> dict[str, object]:
