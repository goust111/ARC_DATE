+
+
+def _build_grid(
+    shape: tuple[int, int],
+    marker: tuple[int, int],
+    chosen: list[dict[str, object]],
+) -> tuple[np.ndarray, dict[int, int]]:
+    grid = np.zeros(shape, dtype=int)
+    grid[marker] = GREY
+    colors = random.sample(list(REGION_COLORS), len(chosen))
