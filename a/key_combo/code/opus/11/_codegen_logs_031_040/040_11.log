+
+def _marker_between_pair(
+    marker: tuple[int, int],
+    bbox_a: tuple[int, int, int, int],
+    bbox_b: tuple[int, int, int, int],
+) -> bool:
+    mr, mc = marker
+    ar0, ac0, ar1, ac1 = bbox_a
+    br0, bc0, br1, bc1 = bbox_b
+
+    horizontal = (
