+def _edge_adjacency_to_mask(
+    bbox: tuple[int, int, int, int],
+    mask: np.ndarray,
+) -> int:
+    r0, c0, r1, c1 = bbox
+    total = 0
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            for nr, nc in _neighbors4(r, c):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc]:
+                    total += 1
+    return int(total)
+
+
