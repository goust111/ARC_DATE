+
+    while empty_dirs < 4 and step_len <= max_step_len:
+        for _ in range(2):
+            dr, dc = dirs[dir_idx % 4]
+            drew_in_direction = False
+            for _ in range(step_len):
+                nr = r + dr
+                nc = c + dc
+                if _in_bounds(g.shape, nr, nc):
+                    if g[nr, nc] == BLACK and not mask[nr, nc]:
+                        r, c = nr, nc
+                        if not mask[r, c]:
+                            mask[r, c] = True
+                            coords.append((r, c))
+                        drew_in_direction = True
+                    else:
+                        skipped_blocked += 1
