+                c1 = c0 + rect_w - 1
+                bbox = (r0, c0, r1, c1)
+                if r0 <= mr <= r1 and c0 <= mc <= c1:
+                    continue
+                marker_dist = _bbox_distance_to_point(bbox, marker)
+                if marker_dist < 2:
+                    continue
+                overlap = int(empty_mask[r0 : r1 + 1, c0 : c1 + 1].sum())
+                adjacency = _edge_adjacency_to_mask(bbox, empty_mask)
+                if adjacency < 2 or adjacency > 7:
