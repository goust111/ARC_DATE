+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_distance_to_point(bbox: tuple[int, int, int, int], point: tuple[int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    pr, pc = point
+    dr = 0 if r0 <= pr <= r1 else min(abs(pr - r0), abs(pr - r1))
+    dc = 0 if c0 <= pc <= c1 else min(abs(pc - c0), abs(pc - c1))
+    return int(dr + dc)
