+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+REGION_COLORS = (BLUE, RED, GREEN, YELLOW)
+
+RECT_DIMS = tuple(
+    (h, w)
+    for h in range(2, 6)
+    for w in range(2, 6)
