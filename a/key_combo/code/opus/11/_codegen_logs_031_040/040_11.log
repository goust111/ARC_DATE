+
+def _winning_color(counts: dict[int, int]) -> int:
+    winners = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+    assert winners and winners[0][1] > 0, "spiral must touch at least one region"
+    if len(winners) >= 2:
