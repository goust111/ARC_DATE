+
+def _vote_counts(
+    grid: np.ndarray,
+    spiral_mask: np.ndarray,
+    region_colors: list[int],
+) -> dict[int, int]:
+    counts = {color: 0 for color in region_colors}
+    for r, c in np.argwhere(spiral_mask):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors4(rr, cc):
+            if _in_bounds(grid.shape, nr, nc):
+                color = int(grid[nr, nc])
+                if color in counts:
