+        "TR": ("bottom", "left"),
+        "BL": ("top", "right"),
+        "BR": ("top", "left"),
+    }[zone_name]
+    side = inward_sides[int(rng.integers(0, 2))]
+    if side == "top":
+        c = int(rng.integers(c0 + 1, c1))
