+        for rr, cc in _ray_cells(marker, direction, g.shape):
+            out[rr, cc] = color
+
+    return out
+
+
+def _draw_rect_ring(grid: np.ndarray, rect: tuple[int, int, int, int]) -> None:
+    r0, c0, r1, c1 = rect
+    grid[r0, c0 : c1 + 1] = GREEN
+    grid[r1, c0 : c1 + 1] = GREEN
