+    colors = colors[:room_count]
+    rng.shuffle(colors)
+
+    for zone_name, direction_key, color in zip(zone_names, direction_keys, colors):
+        rect = _pick_room_rect(rng, viable[zone_name], zone_name)
+        if rect is None:
