+
+def _validate_input(grid: np.ndarray) -> None:
+    assert grid.ndim == 2 and min(grid.shape) >= 18 and max(grid.shape) <= 30
+    assert set(np.unique(grid)).issubset({BLACK, BLUE, RED, GREEN})
