+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+MARKER_COLORS = {BLUE, RED}
+QUADRANT_DIRS = {
+    "ul": (-1, -1),
+    "ur": (-1, 1),
+    "dl": (1, -1),
+    "dr": (1, 1),
