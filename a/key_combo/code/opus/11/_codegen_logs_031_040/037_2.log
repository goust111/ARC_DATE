+        lo, hi = sorted((r0, r1))
+        grid[lo : hi + 1, c0] = GREEN
+
+
+def _quadrant_cells(rect: tuple[int, int, int, int], key: str) -> list[tuple[int, int]]:
+    r0, c0, r1, c1 = rect
+    cells: list[tuple[int, int]] = []
+    for r in range(r0 + 1, r1):
