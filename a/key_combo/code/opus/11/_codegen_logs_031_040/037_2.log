+    return key, QUADRANT_DIRS[key]
+
+
+def _analyze_regions(grid: np.ndarray) -> list[dict]:
+    passable = grid != GREEN
+    regions: list[dict] = []
+    for coords in _components(passable):
+        vals = grid[coords[:, 0], coords[:, 1]]
