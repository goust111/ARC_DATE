+        grid[marker] = color
+
+    try:
+        _validate_input(grid)
+    except AssertionError:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(GEN_RETRIES):
+        grid = _generate_attempt(rng)
