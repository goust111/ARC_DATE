+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _touches_edge(coords: np.ndarray, shape: tuple[int, int]) -> bool:
+    h, w = shape
+    rows = coords[:, 0]
+    cols = coords[:, 1]
+    return bool(np.any((rows == 0) | (rows == h - 1) | (cols == 0) | (cols == w - 1)))
