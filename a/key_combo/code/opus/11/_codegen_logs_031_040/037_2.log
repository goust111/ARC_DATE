+def _direction_from_marker(marker: tuple[int, int], bbox: tuple[int, int, int, int]) -> tuple[str, tuple[int, int]]:
+    mr, mc = marker
+    r0, c0, r1, c1 = bbox
+    top_half = 2 * mr <= r0 + r1
+    left_half = 2 * mc <= c0 + c1
