+    post_candidates = [path[i] for i in range(first_bounce + 1, len(path)) if 2 <= path[i][0] < shape[0] - 2 and 2 <= path[i][1] < shape[1] - 2]
+    if not pre_candidates or len(post_candidates) < 1:
