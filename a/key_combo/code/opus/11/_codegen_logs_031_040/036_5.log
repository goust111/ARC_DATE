+def _analyze(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    ray_out, path, reflections = _trace_ray(g)
+    path_index = {cell: idx for idx, cell in enumerate(path)}
+    sprites, controls = _sprite_and_control_data(g, bg)
