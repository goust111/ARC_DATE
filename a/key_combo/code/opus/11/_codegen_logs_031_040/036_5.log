+            coords = [(mr + r, mc + c) for r, c in template["cells"]]
+            coord_set = set(coords)
+            if not all(in_bounds(grid.shape, r, c) for r, c in coords):
+                continue
+            if coord_set & path_set:
+                continue
+            if coord_set & occupied_cells or coord_set & occupied_buffer:
