+    return None
+
+
+def _all_moved_output(grid: np.ndarray) -> np.ndarray:
+    analysis = _analyze(grid)
+    return _apply_moves(grid, analysis, analysis["sprites"])
+
+
+def _instance_is_valid(grid: np.ndarray) -> bool:
