    for s in analysis['"'selected']:
        control = analysis['controls'][s['marker_color']]
        visible, _ = mod._translated_visible(s, control, g.shape)
        clipped += int(len(visible) < len(s['coords']))
    if clipped:
        stats['has_clipped_move'] += 1
print(stats)
assert stats['reflections_1'] > 0 and stats['reflections_2'] > 0
assert stats['has_clipped_move'] > 0
assert stats['split_across_bounce'] == 80
assert stats['remaining_control_ok'] == 80
