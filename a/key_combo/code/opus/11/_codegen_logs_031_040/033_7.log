            inp[r, c] = BACKGROUND_COLOR

    try:
        if np.array_equal(main(inp), out):
            return inp
    except Exception:
        return None
    return None


def _gen_attempt() -> np.ndarray | None:
    h = random.randint(*GRID_HEIGHT_RANGE)
