+        signal = int(counts[counts >= threshold].sum())
+        cand = (support, signal, threshold)
+        if best is None or cand > best[0]:
+            best = (cand, runs)
+    assert best is not None, f"failed to detect dense runs from counts={counts.tolist()}"
+    return best[1]
+
+
+def _vote_blocks(blocks):
