+
+
+def _build_orbits(h, w):
+    orbits = []
+    cell_to_orbit = {}
+    for r in range(h):
+        for c in range((w + 1) // 2):
+            mc = w - 1 - c
+            coords = tuple(sorted({(r, c), (r, mc)}))
+            idx = len(orbits)
+            orbits.append(coords)
+            for cell in coords:
+                cell_to_orbit[cell] = idx
+    adj = [set() for _ in orbits]
+    for idx, coords in enumerate(orbits):
