+                choices.append(j)
+                weights.append(edge_bias)
+            if not choices:
+                break
+            pick = int(rng.choice(len(choices), p=np.array(weights) / np.sum(weights)))
+            active.add(choices[pick])
+            area = sum(len(orbits[i]) for i in active)
+
+        mask = np.zeros((h, w), dtype=bool)
+        for idx in active:
+            for r, c in orbits[idx]:
