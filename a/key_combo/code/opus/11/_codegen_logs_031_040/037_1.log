+def _runs_from_mask(mask: np.ndarray):
+    runs = []
+    i = 0
+    while i < len(mask):
+        if not mask[i]:
+            i += 1
+            continue
+        j = i
+        while j < len(mask) and mask[j]:
+            j += 1
+        runs.append((i, j))
+        i = j
+    return runs
