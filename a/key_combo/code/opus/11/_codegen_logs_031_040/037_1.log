+
+
+def _fill_unknowns(voted, counts, axis_s):
+    out = voted.copy()
+    mirror_fills = []
+    fallback_pairs = []
+    seen_pairs = set()
+    for r, c in np.argwhere(out == UNKNOWN):
+        r = int(r)
+        c = int(c)
+        if out[r, c] != UNKNOWN:
+            continue
+        mc = int(axis_s - c)
