+
+def _majority_pattern(n_slots, true_color):
+    other = 1 if true_color == 2 else 2
+    maj = n_slots // 2 + 1
+    rem = n_slots - maj
+    return {true_color: maj, other: rem // 2, 0: rem - rem // 2}
