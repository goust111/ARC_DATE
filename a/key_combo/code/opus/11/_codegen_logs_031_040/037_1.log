+    if int(np.argmax(pair_counts)) != int(sprite[left_cell]):
+        return None
+    if int(voted[known_cell]) != int(sprite[known_cell]):
+        return None
+    if int(np.count_nonzero(inp)) <= int(np.count_nonzero(out)):
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
