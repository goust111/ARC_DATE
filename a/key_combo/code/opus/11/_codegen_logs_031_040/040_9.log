+        if not blue_fill_cols:
+            return None
+        for col in blue_fill_cols:
+            if not np.all(out[anchor_rows, col] == BLUE):
+                return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        sample = _gen_attempt(rng)
