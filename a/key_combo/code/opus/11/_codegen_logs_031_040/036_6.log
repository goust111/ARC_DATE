+
+
+def _bfs_distances(grid: np.ndarray, start: tuple[int, int]) -> np.ndarray:
+    dist = np.full(grid.shape, -1, dtype=int)
+    q = deque([start])
+    dist[start] = 0
+    while q:
+        r, c = q.popleft()
+        for dr, dc in DIRS:
+            rr, cc = r + dr, c + dc
+            if not _in_bounds(grid.shape, rr, cc):
+                continue
