+
+
+def _place_seeds(base: np.ndarray, pair: tuple[dict[str, object], dict[str, object]]) -> tuple[np.ndarray, dict[int, dict[str, object]]]:
+    colors = list(SEED_COLORS)
+    random.shuffle(colors)
