+            if dir_idx == 0 and wall_r != top:
+                continue
+            if dir_idx == 1 and wall_c != right:
+                continue
+            if dir_idx == 2 and wall_r != bottom:
+                continue
+            if dir_idx == 3 and wall_c != left:
+                continue
