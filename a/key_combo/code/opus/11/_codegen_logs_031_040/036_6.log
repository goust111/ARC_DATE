+            d_up, d_right, d_down, d_left = map(int, info["distances"])
+            vert_open = d_up + d_down - 1
+            horiz_open = d_left + d_right - 1
+            if dir_idx in (0, 2):
+                if vert_open < horiz_open or vert_open < 4:
+                    continue
+            else:
+                if horiz_open < vert_open or horiz_open < 4:
+                    continue
+
+            candidates.append(
+                {
+                    "pos": (r, c),
+                    "landing": info["landing"],
+                    "move": move,
+                    "dir_idx": dir_idx,
+                    "tied": bool(info["tied"]),
+                    "chamber": chamber,
+                }
+            )
+    return candidates
+
