+            row_band, col_band = chamber
+            top, bottom = wall_rows[row_band], wall_rows[row_band + 1]
+            left, right = wall_cols[col_band], wall_cols[col_band + 1]
+            wall_r, wall_c = info["wall"]
+            dir_idx = int(info["dir_idx"])
+            if dir_idx == 0 and wall_r != top:
