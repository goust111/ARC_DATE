+    pair = _choose_pair(candidates)
+    if pair is None:
+        return None
+
+    grid, chosen = _place_seeds(base, pair)
+    if not _validate_generated(grid, base, chosen):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
