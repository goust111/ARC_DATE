+    success: list[tuple[tuple[int, int], ...]] = []
+    fail_diag: list[tuple[tuple[int, int], ...]] = []
+    fail_split2: list[tuple[tuple[int, int], ...]] = []
+    fail_split3: list[tuple[tuple[int, int], ...]] = []
