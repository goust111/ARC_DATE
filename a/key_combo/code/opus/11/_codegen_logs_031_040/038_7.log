+
+def _render_input(
+    table_rows: int,
+    table_cols: int,
+    verdict_h: int,
+    query_cells: list[tuple[int, int]],
+    glyph_specs: dict[tuple[int, int], tuple[int, int]],
+) -> tuple[np.ndarray, list[int], list[int]]:
