+
+def _render_expected(
+    grid: np.ndarray,
+    matched_cells: list[tuple[int, int]],
+    table_rows_px: list[int],
+    table_cols_px: list[int],
+    *,
+    success: bool,
+    top_sep: int,
+    bottom_sep: int,
+) -> np.ndarray:
+    out = np.array(grid, copy=True)
+    for ri, ci in matched_cells:
+        r = table_rows_px[ri]
+        c = table_cols_px[ci]
+        cell = out[r : r + CELL, c : c + CELL]
+        cell[cell == BG] = GREEN
+    if success:
