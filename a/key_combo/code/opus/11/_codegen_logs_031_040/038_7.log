+
+def _validate_rendered_instance(
+    grid: np.ndarray,
+    expected_nodes: set[tuple[int, int]],
+    *,
+    success: bool,
+    expected_output: np.ndarray,
+) -> bool:
+    try:
+        info = _analyze_grid(grid)
+    except AssertionError:
