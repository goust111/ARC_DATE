+def _component_count(nodes: set[tuple[int, int]]) -> int:
+    remaining = set(nodes)
+    count = 0
+    while remaining:
+        count += 1
+        start = next(iter(remaining))
+        queue = deque([start])
+        while queue:
+            node = queue.popleft()
+            if node not in remaining:
+                continue
+            remaining.remove(node)
+            for nb in _neighbors4(node):
+                if nb in remaining:
+                    queue.append(nb)
+    return count
