+def _is_connected(nodes: set[tuple[int, int]], *, eight: bool = False) -> bool:
+    if not nodes:
+        return False
+    step = _neighbors8 if eight else _neighbors4
+    seen = set()
+    queue = deque([next(iter(nodes))])
+    while queue:
+        node = queue.popleft()
+        if node in seen:
+            continue
+        seen.add(node)
+        for nb in step(node):
+            if nb in nodes and nb not in seen:
+                queue.append(nb)
+    return seen == nodes
