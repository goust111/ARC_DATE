+    table_lookup: dict[tuple[int, tuple[int, ...]], tuple[int, int, int, int]] = {}
+    shape_colors: dict[tuple[int, ...], set[int]] = {}
+    color_shapes: dict[int, set[tuple[int, ...]]] = {}
