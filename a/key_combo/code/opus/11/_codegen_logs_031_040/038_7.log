+def _neighbors8(node: tuple[int, int]) -> tuple[tuple[int, int], ...]:
+    r, c = node
+    return tuple((r + dr, c + dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc)
