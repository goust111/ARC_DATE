+import numpy as np
+
+
+BG = 8
+SEP = 6
+GREEN = 3
+RED = 2
+CELL = 5
+INNER = slice(1, 4)
+
+GLYPH_COLORS = (0, 1, 4, 5, 7, 9)
+TABLE_SHAPES = ((3, 4), (4, 3))
+MAX_ATTEMPTS = 400
