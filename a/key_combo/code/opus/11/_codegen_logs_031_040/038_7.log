+    for (ri, ci), (mask, color) in glyph_specs.items():
+        glyph = _render_glyph(mask, color)
+        r = table_rows_px[ri]
+        c = table_cols_px[ci]
+        grid[r : r + CELL, c : c + CELL] = glyph
