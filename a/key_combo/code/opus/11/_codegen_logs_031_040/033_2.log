+    cols: list[int] = []
+    for idx, residue in enumerate(residues):
+        min_bars = 2 if idx == 0 else random.choice((1, 2))
+        candidates = _candidate_seed_cols(width, residue, min_bars)
+        if idx == 0 and residue == 0 and random.random() < 0.5 and 0 in candidates:
+            cols.append(0)
