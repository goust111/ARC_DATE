+
+def _make_line_station(
+    size: int, vertical: bool, edge: str, shape: tuple[int, int], rng: random.Random
+) -> dict | None:
+    h, w = shape
+    if vertical:
+        if edge == "top":
+            r0 = rng.randint(4, 6)
+            c = rng.randint(6, w - 7)
+        elif edge == "bottom":
