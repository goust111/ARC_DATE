+                for r in range(r0 + sign, r0 + sign * (depth_limit + 1), sign)
+                for c in range(c0 - 1, c1 + 2)
+                if _in_bounds(shape, r, c)
+            }
+            extra_choices -= station_cells
+            extra_choices -= body
+            while len(body) < target_size:
