+def _choose_marker(
+    body: tuple[tuple[int, int], ...],
+    edge: str,
+    shape: tuple[int, int],
+    station_cells: set[tuple[int, int]],
+    forbidden: set[tuple[int, int]],
+) -> tuple[int, int] | None:
+    dr, dc = DIR_VECTORS[edge]
+    candidates = []
+    body_set = set(body)
+    for br, bc in body:
