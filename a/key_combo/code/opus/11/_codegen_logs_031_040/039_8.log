+
+def _build_docked_patch(body: set[tuple[int, int]], station: dict, marker: tuple[int, int]) -> np.ndarray:
+    cells = set(body) | set(station["coords"]) | {marker}
+    r0, c0, r1, c1 = _bbox(list(cells))
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
