+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+BODY = 8
+COUPLER = 9
+MARKER = 3
+OPS = tuple((flip, rot) for flip in (False, True) for rot in range(4))
+DIR_VECTORS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
