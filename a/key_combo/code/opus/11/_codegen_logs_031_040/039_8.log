+
+def _make_station(
+    size: int, vertical: bool, edge: str, shape: tuple[int, int], rng: random.Random
+) -> dict | None:
+    h, w = shape
+    if vertical:
+        if edge == "top":
+            r0 = rng.randint(4, 6)
+            c = rng.randint(6, w - 7)
+        elif edge == "bottom":
+            r0 = h - size - rng.randint(4, 6)
+            c = rng.randint(6, w - 7)
+        elif edge == "left":
+            c = rng.randint(4, 6)
+            r0 = rng.randint(6, h - size - 7)
+        else:
+            c = w - 1 - rng.randint(4, 6)
+            r0 = rng.randint(6, h - size - 7)
+        coords = [(r0 + i, c) for i in range(size)]
+    else:
+        if edge == "top":
+            r = rng.randint(4, 6)
+            c0 = rng.randint(6, w - size - 7)
+        elif edge == "bottom":
+            r = h - 1 - rng.randint(4, 6)
+            c0 = rng.randint(6, w - size - 7)
+        elif edge == "left":
+            c0 = rng.randint(4, 6)
+            r = rng.randint(6, h - 7)
+        else:
+            c0 = w - size - rng.randint(4, 6)
+            r = rng.randint(6, h - 7)
