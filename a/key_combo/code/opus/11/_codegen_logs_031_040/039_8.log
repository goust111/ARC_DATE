+            c0 = rng.randint(6, w - size - 7)
+        elif edge == "left":
+            c0 = rng.randint(4, 6)
+            r = rng.randint(6, h - 7)
+        else:
+            c0 = w - size - rng.randint(4, 6)
+            r = rng.randint(6, h - 7)
