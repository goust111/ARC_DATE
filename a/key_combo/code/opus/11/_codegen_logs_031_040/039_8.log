+        for side in sides:
+            sign = -1 if side == "top" else 1
+            base = {(r0 + sign, c) for c in range(c0, c1 + 1)}
+            if not all(_in_bounds(shape, r, c) for r, c in base):
+                continue
+            body = set(base)
+            extra_choices = {
+                (r, c)
+                for r in range(r0 + sign, r0 + sign * (depth_limit + 1), sign)
