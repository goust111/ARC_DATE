+    out = g.copy()
+    for sprite in sprites:
+        for r, c in sprite["coords"]:
+            out[r, c] = BG
+
+    placements: list[dict] = []
+    occupied = {tuple(map(int, rc)) for rc in np.argwhere(out != BG)}
+    for sprite in sprites:
