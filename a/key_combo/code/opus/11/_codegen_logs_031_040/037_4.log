0084: def _cover_order(g: np.ndarray, group: list[tuple[int, int, np.ndarray]]) -> list[tuple[int, int, np.ndarray]]:
0085:     if len(group) == 1:
0086:         return group
0087: 
0088:     by_color = {int(item[0]): item for item in group}
0089:     above: dict[int, set[int]] = {color: set() for color, _rooms, _walls in group}
0090:     indegree: dict[int, int] = {color: 0 for color, _rooms, _walls in group}
0091: 
0092:     for i, (ca, _ra, wa) in enumerate(group):
0093:         for cb, _rb, wb in group[i + 1 :]:
0094:             overlap = wa & wb
0095:             if not bool(overlap.any()):
0096:                 continue
0097:             visible = set(int(v) for v in np.unique(g[overlap]))
0098:             top_colors = visible & {int(ca), int(cb)}
0099:             assert len(top_colors) == 1
0100:             top = top_colors.pop()
0101:             under = int(cb) if top == int(ca) else int(ca)
0102:             if top not in above[under]:
0103:                 above[under].add(top)
0104:                 indegree[top] += 1
0105: 
0106:     ordered: list[tuple[int, int, np.ndarray]] = []
0107:     remaining = set(by_color)
0108:     while remaining:
0109:         ready = [color for color in remaining if indegree[color] == 0]
0110:         assert len(ready) == 1
0111:         color = ready[0]
0112:         remaining.remove(color)
0113:         ordered.append(by_color[color])
0114:         for nxt in above[color]:
0115:             indegree[nxt] -= 1
