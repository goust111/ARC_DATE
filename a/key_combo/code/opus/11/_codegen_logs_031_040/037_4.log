0029: def _reconstruct_walls(mask: np.ndarray) -> np.ndarray:
0030:     h, _w = mask.shape
0031:     col_counts = mask.sum(axis=0)
0032:     v_threshold = max(3, math.ceil(0.45 * h))
0033:     vcols = [int(c) for c, n in enumerate(col_counts) if int(n) >= v_threshold]
0034:     if len(vcols) < 2:
0035:         return mask.copy()
0036: 
0037:     row_counts = mask.sum(axis=1)
0038:     h_threshold = max(3, len(vcols) + 1)
0039:     hrows = [int(r) for r, n in enumerate(row_counts) if int(n) >= h_threshold]
0040:     assert len(hrows) >= 2
0041: 
0042:     walls = np.zeros_like(mask, dtype=bool)
0043: 
0044:     for r in hrows:
0045:         for c0, c1 in zip(vcols, vcols[1:]):
0046:             segment = mask[r, c0 : c1 + 1]
0047:             length = int(c1 - c0 + 1)
0048:             hits = int(segment.sum())
0049:             dense = hits >= max(2, math.ceil(0.45 * length))
0050:             interior_evidence = length > 2 and hits >= 2 and bool(segment[1:-1].any())
0051:             if dense or interior_evidence:
0052:                 walls[r, c0 : c1 + 1] = True
0053: 
0054:     for c in vcols:
0055:         for r0, r1 in zip(hrows, hrows[1:]):
0056:             segment = mask[r0 : r1 + 1, c]
0057:             length = int(r1 - r0 + 1)
0058:             hits = int(segment.sum())
0059:             if hits >= max(2, math.ceil(0.45 * length)):
0060:                 walls[r0 : r1 + 1, c] = True
0061: 
0062:     return walls
