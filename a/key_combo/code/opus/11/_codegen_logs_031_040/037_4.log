from collections import defaultdict, deque

def draw(centers, H=25, W=25):
    g=[[0]*W for _ in range(H)]
    for r,c in centers:
        for rr,cc in [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]:
            g[rr][cc]=2
    rows=defaultdict(list); cols=defaultdict(list)
    for r,c in centers:
        rows[r].append(c); cols[c].append(r)
    for r,cs in rows.items():
        cs=sorted(cs)
        for a,b in zip(cs,cs[1:]):
            for c in range(a+2,b-1):
                g[r][c]=1
    for c,rs in cols.items():
        rs=sorted(rs)
        for a,b in zip(rs,rs[1:]):
            for r in range(a+2,b-1):
                g[r][c]=1
    return g

def regions(g, centers):
    H=len(g); W=len(g[0])
    vis=[[False]*W for _ in range(H)]
    reg=[]
    for r in range(H):
      for c in range(W):
        if g[r][c]==0 and not vis[r][c]:
          q=deque([(r,c)]); vis[r][c]=True; pts=[]; edge=False; markers=set()
          while q:
            x,y=q.popleft(); pts.append((x,y))
            if x in (0,H-1) or y in (0,W-1): edge=True
            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
