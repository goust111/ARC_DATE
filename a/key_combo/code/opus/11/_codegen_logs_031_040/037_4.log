0011: def _count_enclosed_regions(walls: np.ndarray) -> int:
0012:     labels, n_labels = label_mask(~walls, connectivity=4)
0013:     h, w = walls.shape
0014:     count = 0
0015:     for k in range(1, n_labels + 1):
0016:         coords = np.argwhere(labels == k)
0017:         assert coords.size > 0
0018:         touches_edge = (
0019:             np.any(coords[:, 0] == 0)
0020:             or np.any(coords[:, 0] == h - 1)
0021:             or np.any(coords[:, 1] == 0)
0022:             or np.any(coords[:, 1] == w - 1)
0023:         )
0024:         if not touches_edge:
0025:             count += 1
0026:     return int(count)
