0169: _ROOM_COUNT_RANGE = (1, 6)            # rooms per frame
0170: _TIE_PROBABILITY = 0.35              # chance of one tied room-count pair
0171: _GRID_SIZE_BY_FRAMES = {             # (h_min, h_max, w_min, w_max, frame_max_h, frame_max_w)
0172:     5: (25, 30, 25, 30, 16, 18),
0173:     4: (22, 30, 22, 30, 18, 22),
