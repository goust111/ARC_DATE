          if not edge and len(pts)>1: out.append((len(pts),len(marks)))
    return sorted(out)

for pats in product('APF', repeat=4):
    if pats[0]=='A' and pats[1]=='A' and pats[2]=='A' and pats[3]=='A':
        continue
    centers=centers_from(pats)
