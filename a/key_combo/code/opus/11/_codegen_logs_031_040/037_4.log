0119: def main(grid: np.ndarray) -> np.ndarray:
0120:     """
0121:     Convert each colored partitioned frame into a horizontal bar whose length is its number of enclosed regions.
0122: 
0123:     Input structure:
0124:     - Black background with several axis-aligned colored line drawings.
0125:     - The line drawings are damaged by scattered pixels of one non-background noise color and by overlaps with other drawings.
0126:     - Each real drawing is a rectangular partitioned frame enclosing one or more background regions.
0127: 
0128:     Rule:
0129:     - For each non-background color, reconstruct its horizontal and vertical wall segments from dense row/column evidence.
0130:     - Count the 4-connected background regions fully enclosed by those reconstructed walls.
0131:     - The color with no enclosed region is the noise/pad color.
0132:     - Sort drawing colors by enclosed-region count; equal counts are ordered by which reconstructed frame covers the other.
0133: 
0134:     Key insight:
0135:     - The scattered color is not an object; it only pads the histogram, while each true object's room count is stable after rectilinear wall reconstruction.
0136:     """
0137:     g = np.asarray(grid, dtype=int)
0138:     bg = int(get_bg(g))
0139:     assert bg == 0
0140: 
0141:     counts: list[tuple[int, int, np.ndarray]] = []
0142:     for color in colors_present(g, exclude={bg}):
0143:         rooms = _room_count_for_color(g, int(color))
0144:         walls = _walls_for_color(g, int(color))
0145:         counts.append((int(color), int(rooms), walls))
0146: 
0147:     drawings = [(color, rooms, walls) for color, rooms, walls in counts if rooms > 0]
0148:     pad_colors = [color for color, rooms, _walls in counts if rooms == 0]
0149:     assert drawings
0150:     assert len(pad_colors) == 1
0151: 
0152:     pad = int(pad_colors[0])
0153:     ordered: list[tuple[int, int, np.ndarray]] = []
0154:     for rooms in sorted({rooms for _color, rooms, _walls in drawings}):
0155:         group = [item for item in drawings if item[1] == rooms]
0156:         ordered.extend(_cover_order(g, group))
0157: 
0158:     width = max(rooms for _color, rooms, _walls in ordered)
0159: 
0160:     out = np.full((len(ordered), width), pad, dtype=int)
0161:     for r, (color, rooms, _walls) in enumerate(ordered):
0162:         out[r, :rooms] = int(color)
0163:     return out
