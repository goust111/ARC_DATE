0176: _CELL_GAP_RANGE = (3, 13)            # min/max gap between grid lines within a frame
0177: _NOISE_FRACTION_RANGE = (0.04, 0.09) # fraction of total cells as noise
0178: _WALL_DAMAGE_FRACTION = 0.25         # max fraction of wall pixels replaced by noise
0179: _EXTRA_OVERLAP_RANGE = (0, 3)        # non-tied overlap pairs to force
0180: _OVERLAP_RETRY = 100                 # attempts to place overlapping frame
