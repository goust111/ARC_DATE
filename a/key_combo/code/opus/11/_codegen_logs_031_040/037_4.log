0046: def main(grid: np.ndarray) -> np.ndarray:
0047:     """Fill black gaps with the unique known color from each cell's horizontal/vertical mirror orbit.
0048: 
0049:     Input structure
0050:     The grid is an otherwise nonblack pattern with color 0 marking missing pixels. Nonblack cells reveal a horizontal reflection over the lower row band and a vertical reflection over the right column band.
0051: 
0052:     Rule
0053:     Infer the row-reflection and column-reflection constants whose reflected nonblack pairs agree. For each black pixel, collect its row mirror, column mirror, and combined row+column mirror positions that stay in bounds; the known colors in that orbit must be unique, and every black pixel in the orbit is recolored to it.
0054: 
0055:     Key insight
0056:     A gap can face another gap across one mirror axis, so the fill must use the full two-axis reflection orbit rather than a single reflected cell.
0057:     """
0058:     g = np.asarray(grid, dtype=int)
0059:     assert g.ndim == 2
0060: 
0061:     missing = Color.BLACK
0062:     assert np.any(g == missing)
0063: 
0064:     h, w = g.shape
0065:     row_s = _best_reflection_constant(g, axis=0, missing=missing)
0066:     col_s = _best_reflection_constant(g, axis=1, missing=missing)
0067: 
0068:     out = g.copy()
0069:     for r, c in np.argwhere(g == missing):
0070:         rows = {int(r)}
0071:         rr = row_s - int(r)
0072:         if 0 <= rr < h:
0073:             rows.add(rr)
0074: 
0075:         cols = {int(c)}
0076:         cc = col_s - int(c)
0077:         if 0 <= cc < w:
0078:             cols.add(cc)
0079: 
0080:         orbit = {(orow, ocol) for orow in rows for ocol in cols}
0081:         values = {int(g[orow, ocol]) for orow, ocol in orbit if g[orow, ocol] != missing}
0082:         assert len(values) == 1
0083:         value = values.pop()
0084: 
0085:         for orow, ocol in orbit:
0086:             if out[orow, ocol] == missing:
0087:                 out[orow, ocol] = value
0088:             else:
0089:                 assert out[orow, ocol] == value
0090: 
0091:     assert not np.any(out == missing)
0092:     return out
0093: 
