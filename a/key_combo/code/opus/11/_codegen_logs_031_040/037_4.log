0008: def _best_reflection_constant(g: np.ndarray, axis: int, missing: int) -> int:
0009:     n = g.shape[axis]
0010:     candidates: list[tuple[int, int, int]] = []
0011: 
0012:     for s in range(2 * n - 1):
0013:         pair_count = 0
0014:         compared = 0
0015:         touches_missing = 0
0016:         ok = True
0017: 
0018:         for i in range(n):
0019:             j = s - i
0020:             if not (0 <= j < n) or i > j:
0021:                 continue
0022: 
0023:             a = g[i, :] if axis == 0 else g[:, i]
0024:             b = g[j, :] if axis == 0 else g[:, j]
0025:             known = (a != missing) & (b != missing)
0026:             if np.any(a[known] != b[known]):
0027:                 ok = False
0028:                 break
0029: 
0030:             pair_count += 1
0031:             compared += int(np.sum(known))
0032:             touches_missing += int(np.sum((a == missing) | (b == missing)))
0033: 
0034:         if ok and touches_missing:
0035:             candidates.append((pair_count, compared, s))
0036: 
0037:     assert candidates
0038:     max_pairs = max(pair_count for pair_count, _, _ in candidates)
0039:     widest = [candidate for candidate in candidates if candidate[0] == max_pairs]
0040:     max_compared = max(compared for _, compared, _ in widest)
0041:     best = [s for _, compared, s in widest if compared == max_compared]
0042:     assert len(best) == 1
0043:     return best[0]
0044: 
