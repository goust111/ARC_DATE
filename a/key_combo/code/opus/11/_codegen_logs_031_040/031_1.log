0044:     H, W = base.shape
0045:     assert cols
0046:     if cols[-1] + 1 >= W:
0047:         return False
0048: 
0049:     for floor_r in range(marker_bottom_r + 1, H):
0050:         target_rows = np.arange(floor_r - height + 1, floor_r + 1)
0051:         if int(target_rows[0]) < 0:
0052:             continue
0053: 
0054:         shifted_cols = [c + 1 for c in cols]
0055:         target_is_clear = all(np.all(base[target_rows, c] == bg) for c in shifted_cols)
0056:         if not target_is_clear:
0057:             continue
0058: 
0059:         for c in cols:
0060:             if int(base[floor_r, c]) != obstacle:
0061:                 continue
0062:             has_horizontal_neighbor = (
0063:                 (c > 0 and int(base[floor_r, c - 1]) == obstacle)
0064:                 or (c + 1 < W and int(base[floor_r, c + 1]) == obstacle)
0065:             )
0066:             if has_horizontal_neighbor:
0067:                 return True
0068: 
0069:     return False
