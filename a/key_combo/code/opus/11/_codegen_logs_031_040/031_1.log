+        nr, nc = r + dr, c + dc
+        if not _in_bounds(shape, nr, nc):
+            return {"final": (r, c), "trace": trace, "encounters": encounters, "reason": "edge"}
+
+        hit = border_lookup.get((nr, nc))
+        if hit is not None:
+            frame = frames[hit]
+            encounters.append(hit)
+            if same_color_pass and color == frame["color"]:
