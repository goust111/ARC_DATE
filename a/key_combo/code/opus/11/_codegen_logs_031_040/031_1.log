0141:         if bottom_control == stop_color:
0142:             obstacles_below = np.flatnonzero(base[r1 + 1 :, c] == obstacle)
0143:             if len(obstacles_below):
0144:                 floor_r = int(r1 + 1 + obstacles_below[0])
0145:                 top_r = floor_r - marker_h
0146:             else:
0147:                 top_r = H - marker_h
