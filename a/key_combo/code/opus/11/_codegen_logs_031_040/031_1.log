+import random
+from collections import deque
+
+import numpy as np
+
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+PALETTE = [1, 2, 3, 4]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == 0 or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if not _in_bounds(grid.shape, nr, nc):
+                        continue
+                    if seen[nr, nc] or int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            comps.append({"color": color, "coords": coords, "bbox": _bbox(coords)})
+    return comps
+
+
+def _frame_info(grid: np.ndarray, comp: dict) -> dict | None:
+    color = int(comp["color"])
+    coords = comp["coords"]
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 5:
+        return None
+    coord_set = set(coords)
+    border = {
+        (r, c)
+        for r in range(r0, r1 + 1)
+        for c in range(c0, c1 + 1)
+        if r in (r0, r1) or c in (c0, c1)
+    }
+    if not coord_set.issubset(border):
+        return None
+    missing = sorted(border - coord_set)
+    if len(missing) != 1:
+        return None
+    gap = missing[0]
+    if gap in {(r0, c0), (r0, c1), (r1, c0), (r1, c1)}:
+        return None
+    if np.any(grid[r0 + 1 : r1, c0 + 1 : c1] != 0):
+        return None
+    if gap[0] == r0:
+        gap_side = "up"
+    elif gap[0] == r1:
+        gap_side = "down"
+    elif gap[1] == c0:
+        gap_side = "left"
+    else:
+        gap_side = "right"
+    return {
+        "color": color,
+        "bbox": (r0, c0, r1, c1),
+        "cells": coord_set,
+        "gap": gap,
+        "gap_side": gap_side,
+        "gap_dir": DIRS[gap_side],
+    }
+
+
+def _parse_scene(grid: np.ndarray) -> tuple[list[dict], list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    frames: list[dict] = []
+    frame_cells: set[tuple[int, int]] = set()
