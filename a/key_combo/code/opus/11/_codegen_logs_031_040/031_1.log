0028:     if not values:
0029:         return []
0030: 
0031:     runs: list[tuple[int, int]] = []
0032:     start = prev = values[0]
0033:     for value in values[1:]:
0034:         if value == prev + 1:
0035:             prev = value
0036:             continue
0037:         runs.append((start, prev))
0038:         start = prev = value
0039:     runs.append((start, prev))
0040:     return runs
