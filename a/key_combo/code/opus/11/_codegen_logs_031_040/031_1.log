1028: def object_interior(grid: np.ndarray, background: int = Color.BLACK) -> np.ndarray:
1029:     """Return a boolean mask of the object's interior (including boundary)."""
1030:     bg = int(background)
1031:     mask = 1 * (grid != bg)
1032:     H, W = grid.shape
1033: 
1034:     # Flood fill exterior (mark as 42) starting from any background pixel on the border.
1035:     for r in range(H):
1036:         if int(grid[r, 0]) == bg:
1037:             flood_fill(mask, r, 0, 42)
1038:         if int(grid[r, W - 1]) == bg:
1039:             flood_fill(mask, r, W - 1, 42)
1040:     for c in range(W):
1041:         if int(grid[0, c]) == bg:
1042:             flood_fill(mask, 0, c, 42)
1043:         if int(grid[H - 1, c]) == bg:
1044:             flood_fill(mask, H - 1, c, 42)
1045: 
1046:     return mask != 42
1047: 
1048: 
1049: def object_boundary(grid: np.ndarray, background: int = Color.BLACK) -> np.ndarray:
1050:     """Return a boolean mask of the object's boundary (excluding interior holes)."""
1051:     bg = int(background)
1052:     exterior = ~object_interior(grid, background=bg)
1053: 
1054:     canvas_boundary = np.zeros_like(grid, dtype=bool)
1055:     canvas_boundary[0, :] = True
1056:     canvas_boundary[-1, :] = True
1057:     canvas_boundary[:, 0] = True
1058:     canvas_boundary[:, -1] = True
