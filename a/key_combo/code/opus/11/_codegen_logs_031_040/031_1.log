0121:         return None
0122:     total = np.random.randint(min_sum, max_sum + 1)
0123:     sizes = [lo] * n
0124:     extra = total - min_sum
0125:     while extra:
0126:         choices = [i for i, size in enumerate(sizes) if size < hi]
0127:         i = int(np.random.choice(choices))
0128:         add = np.random.randint(1, min(hi - sizes[i], extra) + 1)
0129:         sizes[i] += int(add)
0130:         extra -= int(add)
0131:     np.random.shuffle(sizes)
0132:     return sizes
