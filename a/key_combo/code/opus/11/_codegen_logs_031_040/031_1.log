0099:     - Contiguous maroon-ended columns pass through obstacles and bottom-align;
0100:       if such a run has a clear down-right slide from a grey ledge, shift the
0101:       run one column right before bottom-aligning.
0102:     - When a maroon-ended drop lands through a grey bar on the bottom edge, clear
0103:       the rest of the marker-width gap in that bottom bar.
0104: 
0105:     Key insight
0106:     - The bottom row of the top marker is a control strip: blue cells mean
0107:       "stick to the first obstacle," while maroon cells mean "fall through."
0108:     """
0109:     g = np.asarray(grid, dtype=int)
0110:     H = g.shape[0]
0111:     bg = int(get_bg(g))
0112: 
0113:     non_bg = colors_present(g, exclude={bg})
0114:     assert len(non_bg) == 3, "expected obstacle color plus two marker colors"
0115:     obstacle = _unique_largest_count_color(g, non_bg)
0116:     marker_colors = [color for color in non_bg if color != obstacle]
0117:     assert len(marker_colors) == 2, "expected exactly two marker colors"
0118: 
0119:     r0, c0, r1, c1 = _marker_bbox(g, marker_colors)
0120:     marker = g[r0 : r1 + 1, c0 : c1 + 1]
0121:     marker_h, marker_w = marker.shape
0122:     assert (marker_h, marker_w) == (3, 3), "expected a 3x3 marker"
0123:     assert np.all(np.isin(marker, marker_colors)), "marker bbox must contain only marker colors"
0124: 
0125:     pass_color = int(marker[0, 0])
0126:     assert np.all(marker[:2, :] == pass_color), "top two marker rows must be the pass-through color"
0127:     stop_colors = [color for color in marker_colors if color != pass_color]
0128:     assert len(stop_colors) == 1, "expected one stop color"
0129:     stop_color = stop_colors[0]
0130: 
0131:     out = g.copy()
0132:     out[r0 : r1 + 1, c0 : c1 + 1] = bg
0133:     base = out.copy()
0134: 
0135:     pass_columns: list[int] = []
0136:     for j in range(marker_w):
0137:         c = c0 + j
0138:         stack = marker[:, j]
0139:         bottom_control = int(stack[-1])
