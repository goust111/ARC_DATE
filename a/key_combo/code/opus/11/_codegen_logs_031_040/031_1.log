0154:     for start_j, end_j in _runs(pass_columns):
0155:         source_cols = list(range(c0 + start_j, c0 + end_j + 1))
0156:         shift = 1 if _can_slide_right(base, obstacle, bg, source_cols, r1, marker_h) else 0
0157:         top_r = H - marker_h
0158: 
0159:         for j in range(start_j, end_j + 1):
0160:             c = c0 + j + shift
