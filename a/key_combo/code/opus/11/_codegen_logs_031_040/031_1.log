+    sources: list[dict] = []
+    for r in range(g.shape[0]):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color == 0 or (r, c) in frame_cells:
+                continue
+            if color not in PALETTE:
+                raise AssertionError("unexpected source color")
