0108: def neighbors4(r: int, c: int) -> Iterator[Coord]:
0109:     """4-neighborhood of (r,c)."""
0110:     r = int(r)
0111:     c = int(c)
0112:     yield r - 1, c
0113:     yield r + 1, c
0114:     yield r, c - 1
0115:     yield r, c + 1
