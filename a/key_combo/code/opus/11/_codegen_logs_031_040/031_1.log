0010:     Slide a solid square through a winding channel to reach a same-sized target square.
0011: 
0012:     Input structure:
0013:     - bg (most common color). A river color forms a winding corridor.
0014:     - Two same-sized NxN solid squares on the river: mover and destination, each a distinct color.
0015: 
0016:     Rule:
0017:     - The mover square travels along the river toward the destination.
0018:     - It can only pass through positions where the full NxN area is river.
0019:     - If reachable, the mover replaces the destination; otherwise it stops at the farthest reachable point.
0020:     - The mover's original position is filled with the river color.
0021: 
0022:     Key insight: Chokepoints narrower than N pixels block the square, forcing it to stop short.
0023:     """
0024:     g = np.array(grid, dtype=int)
0025:     H, W = g.shape
0026: 
0027:     # Corner-majority background (more stable than global mode here).
0028:     bg = int(Counter([int(g[0, 0]), int(g[0, -1]), int(g[-1, 0]), int(g[-1, -1])]).most_common(1)[0][0])
0029: 
0030:     # Detect solid square components (excluding bg).
0031:     squares: list[dict] = []
0032:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True, return_format="dict"):
0033:         col = int(comp["color"])
0034:         b = comp["bbox"]
0035:         if bbox_h(b) != bbox_w(b):
0036:             continue
0037:         patch = g[int(b[0]) : int(b[2]) + 1, int(b[1]) : int(b[3]) + 1]
0038:         if not bool((patch == int(col)).all()):
0039:             continue
0040:         squares.append({"col": int(col), "r0": int(b[0]), "c0": int(b[1]), "n": int(bbox_h(b))})
0041: 
0042:     assert not (len(squares) < 2)
0043: 
0044:     # Choose the size that appears at least twice (most common size).
0045:     by_n: dict[int, list[dict]] = defaultdict(list)
0046:     for s in squares:
0047:         by_n[int(s["n"])].append(s)
0048:     nside = max(by_n.items(), key=lambda kv: (len(kv[1]), kv[0]))[0]
0049:     cand = by_n[int(nside)]
0050:     assert not (len(cand) < 2)
0051: 
0052:     cand.sort(key=lambda s: int(s["col"]))
0053:     mover = cand[0]
0054:     dest = cand[1]
0055: 
0056:     n = int(mover["n"])
0057:     sr, sc = int(mover["r0"]), int(mover["c0"])
0058:     dr, dc = int(dest["r0"]), int(dest["c0"])
0059: 
0060:     # River = most common remaining color (excluding bg and the two square colors).
0061:     counts = Counter(map(int, g.flatten()))
0062:     river = None
0063:     for col, _ct in counts.most_common():
0064:         if int(col) == int(bg):
0065:             continue
0066:         if int(col) in (int(mover["col"]), int(dest["col"])):
0067:             continue
0068:         river = int(col)
0069:         break
0070:     assert not (river is None)
0071: 
0072:     trav = (g == int(river)) | (g == int(mover["col"])) | (g == int(dest["col"]))
0073: 
0074:     # Feasible top-left placements: NxN window fully inside trav.
0075:     h2 = int(H - n + 1)
0076:     w2 = int(W - n + 1)
0077:     assert not (h2 <= 0 or w2 <= 0)
0078:     assert not (not (0 <= sr < h2 and 0 <= sc < w2))
0079: 
0080:     feasible = np.zeros((h2, w2), dtype=bool)
0081:     for r in range(h2):
0082:         for c in range(w2):
0083:             if bool(trav[int(r) : int(r + n), int(c) : int(c + n)].all()):
0084:                 feasible[int(r), int(c)] = True
0085:     assert not (not bool(feasible[int(sr), int(sc)]))
0086: 
0087:     # BFS on placement grid.
0088:     dist = -np.ones((h2, w2), dtype=int)
0089:     q = deque([(int(sr), int(sc))])
0090:     dist[int(sr), int(sc)] = 0
0091:     DIR4 = [(1, 0), (-1, 0), (0, 1), (0, -1)]
0092:     while q:
0093:         r, c = q.popleft()
0094:         for dr2, dc2 in DIR4:
0095:             rr = int(r + dr2)
0096:             cc = int(c + dc2)
0097:             if 0 <= rr < h2 and 0 <= cc < w2 and bool(feasible[rr, cc]) and int(dist[rr, cc]) == -1:
0098:                 dist[rr, cc] = int(dist[int(r), int(c)] + 1)
0099:                 q.append((int(rr), int(cc)))
0100: 
0101:     # Pick target.
0102:     if 0 <= dr < h2 and 0 <= dc < w2 and bool(feasible[int(dr), int(dc)]) and int(dist[int(dr), int(dc)]) >= 0:
0103:         tr, tc = int(dr), int(dc)
0104:     else:
0105:         best = -1
0106:         tr, tc = int(sr), int(sc)
0107:         for r in range(h2):
0108:             for c in range(w2):
0109:                 if int(dist[int(r), int(c)]) > best:
0110:                     best = int(dist[int(r), int(c)])
0111:                     tr, tc = int(r), int(c)
0112: 
0113:     out = g.copy()
0114:     out[int(sr) : int(sr + n), int(sc) : int(sc + n)] = int(river)
0115:     out[int(tr) : int(tr + n), int(tc) : int(tc + n)] = int(mover["col"])
0116:     return out
0117: 
0118: 
0119: # --- Generator ---
0120: 
0121: _BG, _RIVER, _MOVER, _DEST = 3, 1, 0, 2
0122: 
0123: 
0124: def _bfs_placement(feasible, sr, sc):
0125:     h2, w2 = feasible.shape
0126:     dist = -np.ones((h2, w2), dtype=int)
