1167:     background: int | None = None,
1168: ) -> list[Symmetry]:
1169:     """Detect translational symmetries using a scoring heuristic."""
1170:     if ignore_colors is None:
1171:         ignore_colors = [Color.BLACK]
1172:     ignore_colors = [int(c) for c in ignore_colors]
1173: 
1174:     n, m = grid.shape
1175:     r_poss = [TranslationalSymmetry(dr=tr, dc=0) for tr in range(1, n)]
1176:     r_poss += [TranslationalSymmetry(dr=-tr, dc=0) for tr in range(1, n)]
1177:     c_poss = [TranslationalSymmetry(dr=0, dc=tc) for tc in range(1, m)]
1178:     c_poss += [TranslationalSymmetry(dr=0, dc=-tc) for tc in range(1, m)]
1179:     rc_poss = [TranslationalSymmetry(dr=tr, dc=tc) for tr in range(1, n) for tc in range(1, m)]
1180: 
1181:     def score(sym: Symmetry) -> float:
1182:         perfectly_preserved, outside_canvas, conflict = _score_symmetry(grid, sym, ignore_colors, background=background)
1183:         return perfectly_preserved - 0.01 * outside_canvas - 100000 * conflict
1184: 
1185:     r_scores = [score(s) for s in r_poss]
1186:     c_scores = [score(s) for s in c_poss]
