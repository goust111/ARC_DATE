+def _frame_patch(h: int, w: int, color: int, gap_side: str, gap_index: int) -> np.ndarray:
+    patch = np.zeros((h, w), dtype=int)
+    patch[0, :] = color
+    patch[-1, :] = color
+    patch[:, 0] = color
+    patch[:, -1] = color
+    if gap_side == "up":
+        patch[0, gap_index] = 0
+    elif gap_side == "down":
+        patch[-1, gap_index] = 0
+    elif gap_side == "left":
+        patch[gap_index, 0] = 0
+    else:
+        patch[gap_index, -1] = 0
+    return patch
