GEN_BLOCK_INTERIOR_RATIO_CAP = 0.44
GEN_BLOCK_GOAL_MIN_AREA_DIVISOR = 78.0
GEN_BLOCK_GOAL_MAX_AREA_DIVISOR = 13.0
