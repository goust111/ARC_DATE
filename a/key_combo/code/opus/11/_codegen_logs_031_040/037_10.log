+                    if hit is not None and hit != j:
+                        blocked = True
+                if _is_direction_toward(b, a, direction):
+                    hit = ray_hits[(j, direction)]
+                    if hit is not None and hit != i:
+                        blocked = True
+            if blocked:
+                blocked_pairs.add((i, j))
