GEN_BLOCK_H_MAX = 7
GEN_BLOCK_W_MIN = 3
GEN_BLOCK_W_MAX = 12
GEN_MIN_BLOCKS = 2
GEN_MAX_BLOCKS = 9
GEN_BLOCK_MIN_AREA = 9
GEN_INITIAL_BLOCK_WINDOW = 8
GEN_INITIAL_BLOCK_JITTER = 3
GEN_ADD_SIZE_WINDOW = 18
GEN_ADD_CHOICE_WINDOW = 24
GEN_CORRIDOR_LEN_MIN = 1
GEN_CORRIDOR_LEN_MAX = 6

