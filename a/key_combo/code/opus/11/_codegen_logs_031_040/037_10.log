+
+    if sprites:
+        seen = {0}
+        q = deque([0])
+        while q:
+            cur = q.popleft()
+            for nxt in neighbors[cur]:
+                if nxt not in seen:
+                    seen.add(nxt)
+                    q.append(nxt)
