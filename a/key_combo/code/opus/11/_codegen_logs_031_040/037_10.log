+
+    return {
+        "sprites": sprites,
+        "directed": directed,
+        "edges": edges,
+        "neighbors": neighbors,
+        "nearest": nearest,
+        "incoming": incoming,
+        "oneway_pairs": oneway_pairs,
+        "blocked_pairs": blocked_pairs,
+        "connected": connected,
+        "unique_nearest": unique_nearest,
+    }
