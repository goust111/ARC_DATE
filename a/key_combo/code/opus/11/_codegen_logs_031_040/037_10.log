+    for sp in sprites:
+        i = int(sp["idx"])
+        for direction in CARDINALS:
+            hit = _trace_ray(grid, coord_to_sprite, sprites, i, direction)
+            ray_hits[(i, direction)] = hit
+            if hit is not None:
+                directed[i].add(int(hit))
