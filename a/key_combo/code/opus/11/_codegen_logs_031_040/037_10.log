+def _ray_start(sprite: dict, direction: tuple[int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = sprite["bbox"]
+    dr, dc = direction
+    if (dr, dc) == (-1, 0):
+        return r0 - 1, c0 + 1
+    if (dr, dc) == (1, 0):
+        return r1 + 1, c0 + 1
+    if (dr, dc) == (0, -1):
+        return r0 + 1, c0 - 1
+    if (dr, dc) == (0, 1):
+        return r0 + 1, c1 + 1
