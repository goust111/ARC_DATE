+    has_oneway = bool(info["oneway_pairs"])
+    has_blocked = bool(info["blocked_pairs"])
+
+    if mode == "conflict":
+        return has_conflict
+    if mode == "oneway":
+        return has_oneway
+    if mode == "blocked":
+        return has_blocked
+    if mode == "mixed":
+        return has_conflict and (has_oneway or has_blocked)
+    return True
