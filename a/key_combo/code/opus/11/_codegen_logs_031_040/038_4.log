+    top_range: tuple[int, int],
+    left_range: tuple[int, int] | None = None,
+    height_range: tuple[int, int] = (4, 6),
+    width_range: tuple[int, int] = (4, 7),
+    must_span: int | None = None,
+    avoid_span_cols: set[int] | None = None,
+    hole_side: str | None = None,
