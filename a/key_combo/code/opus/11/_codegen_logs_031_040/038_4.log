+MAX_GEN_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Container:
+    top: int
+    bottom: int
+    left: int
+    right: int
+    hole_side: str | None
+    hole_row: int | None
+
+    @property
