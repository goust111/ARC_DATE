+    for hist in histories:
+        sig.append(
+            (
+                hist["column"],
+                hist["outcome"],
+                hist["leak_count"],
+                tuple(hist["hit_ids"]),
+                hist.get("captured_id"),
+                hist.get("blocked_by"),
+            )
