+        raise AssertionError("multileak case leak2 out of room")
+    b = Container(b.top, b.bottom, b.left, b.right, "right", rng.randint(b.top + 1, b.bottom - 1))
+
+    c_width = rng.randint(5, 7)
+    c_height = rng.randint(4, 6)
+    c_left = max(1, leak2 - rng.randint(1, 2))
+    c_left = min(c_left, w - c_width - 2)
+    c = Container(
+        b.bottom + rng.randint(2, 4),
+        b.bottom + rng.randint(2, 4) + c_height - 1,
+        c_left,
+        c_left + c_width - 1,
+        None,
+        None,
+    )
+    if c.top >= h - 3:
+        raise AssertionError("multileak case C too low")
+
+    d_width = rng.randint(4, 6)
+    d_height = rng.randint(4, 5)
+    d_left_lo = max(c.right + 2, leak2 + 3)
+    d_left_hi = w - d_width - 2
+    if d_left_lo > d_left_hi:
+        raise AssertionError("multileak case lacks side capture lane")
+    d_left = rng.randint(d_left_lo, d_left_hi)
+    d_top = rng.randint(max(a.bottom + 2, 7), min(c.top - 2, h - d_height - 2))
+    d = Container(d_top, d_top + d_height - 1, d_left, d_left + d_width - 1, None, None)
+
+    containers = [a, b, c, d]
+    if any(_boxes_touch(x, y) for x, y in combinations(containers, 2)):
+        raise AssertionError("multileak case containers touch")
+
+    for cont in containers:
