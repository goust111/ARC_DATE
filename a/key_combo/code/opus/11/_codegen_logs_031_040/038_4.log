+        a.bottom + gap < b.top
+        or b.bottom + gap < a.top
+        or a.right + gap < b.left
+        or b.right + gap < a.left
+    )
+
+
+def _random_unused_container(
+    rng: random.Random,
+    h: int,
+    w: int,
+    placed: list[Container],
+    forbidden_cols: set[int],
+) -> Container | None:
+    for _ in range(120):
+        height = rng.randint(4, 6)
+        width = rng.randint(4, 7)
+        top = rng.randint(2, h - height - 2)
+        left = rng.randint(1, w - width - 2)
+        cont = Container(top, top + height - 1, left, left + width - 1, None, None)
+        if any(_boxes_touch(cont, other) for other in placed):
+            continue
+        if forbidden_cols & set(range(cont.left, cont.right + 1)):
+            continue
+        if rng.random() < 0.55:
+            side = "left" if rng.random() < 0.5 else "right"
+            if side == "left" and cont.left <= 0:
+                side = "right"
+            if side == "right" and cont.right >= w - 1:
+                side = "left"
+            cont = Container(
+                cont.top,
+                cont.bottom,
+                cont.left,
+                cont.right,
+                side,
+                rng.randint(cont.top + 1, cont.bottom - 1),
+            )
+        return cont
+    return None
+
+
+def _blocked_case(rng: random.Random) -> tuple[np.ndarray, str]:
+    h = rng.randint(15, 20)
+    w = rng.randint(18, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    a_left = rng.randint(1, max(2, w // 5))
+    a_width = rng.randint(4, 6)
+    a_height = rng.randint(4, 5)
+    a_top = rng.randint(2, 4)
+    a = Container(
+        a_top,
+        a_top + a_height - 1,
+        a_left,
+        a_left + a_width - 1,
+        "right",
+        rng.randint(a_top + 1, a_top + a_height - 2),
+    )
+    leak_col = a.right + 1
+
+    b_width = rng.randint(5, 7)
+    b_left = max(1, leak_col - rng.randint(1, 2))
+    b_left = min(b_left, w - b_width - 2)
+    b = Container(
+        a.bottom + rng.randint(2, 4),
+        a.bottom + rng.randint(2, 4) + rng.randint(4, 5) - 1,
+        b_left,
+        b_left + b_width - 1,
+        None,
+        None,
+    )
+    if b.top >= h - 4:
+        raise AssertionError("blocked case: B too low")
+
+    c_width = rng.randint(4, 6)
+    c_height = rng.randint(4, 5)
+    c_top = min(h - c_height - 2, b.bottom + 2)
+    if c_top <= b.bottom + 1:
+        c_top = b.bottom + 2
+    c_left = rng.randint(max(b.right + 2, 1), w - c_width - 2) if b.right + c_width + 3 < w else 1
+    c = Container(c_top, c_top + c_height - 1, c_left, c_left + c_width - 1, None, None)
+
+    containers = [a, b, c]
+    if any(_boxes_touch(x, y) for x, y in combinations(containers, 2)):
+        raise AssertionError("blocked case containers touch")
+
+    for cont in containers:
+        _paint_container(grid, cont)
+
+    m1 = rng.choice(a.interior_cols())
+    b_choices = [c0 for c0 in b.interior_cols() if c0 > a.right]
+    if not b_choices:
+        raise AssertionError("blocked case lacks direct target column")
+    m2 = rng.choice(b_choices)
+    markers = [(m1, None), (m2, None)]
+    if rng.random() < 0.5:
+        extra_cols = [c0 for c0 in c.interior_cols() if c0 not in {m1, m2}]
+        if extra_cols:
+            markers.append((rng.choice(extra_cols), None))
+
+    return _finalize_case(rng, grid, containers, [c for c, _ in markers]), "blocked"
+
+
+def _bottom_case(rng: random.Random) -> tuple[np.ndarray, str]:
+    h = rng.randint(15, 20)
+    w = rng.randint(18, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    a_left = rng.randint(1, max(2, w // 4))
+    a_width = rng.randint(4, 6)
+    a_height = rng.randint(4, 5)
+    a_top = rng.randint(2, 4)
+    side = "right" if a_left + a_width + 2 < w else "left"
+    a = Container(
+        a_top,
+        a_top + a_height - 1,
+        a_left,
+        a_left + a_width - 1,
+        side,
+        rng.randint(a_top + 1, a_top + a_height - 2),
+    )
+    leak_col = a.left - 1 if side == "left" else a.right + 1
+
+    b_width = rng.randint(5, 7)
+    b_height = rng.randint(4, 6)
