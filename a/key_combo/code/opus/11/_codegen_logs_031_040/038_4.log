+    histories: list[dict[str, object]] = []
+
+    for col, color in markers:
+        out[0, col] = BG
+        state_seen: set[tuple[int, int, tuple[int, ...]]] = set()
+        row = 1
+        history: dict[str, object] = {
+            "column": col,
+            "color": color,
+            "leak_count": 0,
+            "hit_ids": [],
