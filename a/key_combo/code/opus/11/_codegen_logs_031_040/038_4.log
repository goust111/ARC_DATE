+    return _finalize_case(rng, grid, containers, marker_cols, {leak1, leak2}), "multileak"
+
+
+def _finalize_case(
+    rng: random.Random,
+    grid: np.ndarray,
+    containers: list[Container],
+    marker_cols: list[int],
+    protected_cols: set[int],
+) -> np.ndarray:
