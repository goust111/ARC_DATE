+        height = rng.randint(4, 6)
+        width = rng.randint(4, 7)
+        top = rng.randint(2, h - height - 2)
+        left = rng.randint(1, w - width - 2)
+        cont = Container(top, top + height - 1, left, left + width - 1, None, None)
