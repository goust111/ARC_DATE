+            marker_cols.sort()
+
+    return _finalize_case(rng, grid, containers, marker_cols, {leak_col}), "bottom"
+
+
+def _multileak_case(rng: random.Random) -> tuple[np.ndarray, str]:
+    h = rng.randint(16, 20)
+    w = rng.randint(19, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    a = _sample_container(
+        rng,
+        h,
+        w,
+        [],
+        top_range=(2, 4),
+        left_range=(1, max(2, w // 5)),
+        height_range=(4, 5),
+        width_range=(4, 6),
+        hole_side="right",
+    )
+    leak1 = a.right + 1
+
+    b = _sample_container(
+        rng,
+        h,
+        w,
+        [a],
+        top_range=(a.bottom + 2, h - 8),
+        left_range=(max(1, leak1 - 1), min(leak1, w - 6)),
+        height_range=(4, 5),
+        width_range=(4, 6),
+        must_span=leak1,
+        hole_side="right",
+    )
+    leak2 = b.right + 1
+
+    c = _sample_container(
+        rng,
+        h,
+        w,
+        [a, b],
+        top_range=(b.bottom + 2, h - 6),
+        left_range=(max(1, leak2 - 2), min(leak2, w - 7)),
+        height_range=(4, 6),
+        width_range=(5, 7),
+        must_span=leak2,
