+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _find_containers(grid: np.ndarray) -> list[Container]:
+    containers: list[Container] = []
+    for coords in _components(grid == WALL):
+        top, left, bottom, right = _bbox(coords)
+        if bottom - top + 1 < 3 or right - left + 1 < 4:
+            continue
+        patch = grid[top : bottom + 1, left : right + 1]
+        h, w = patch.shape
+        if np.any((patch != BG) & (patch != WALL)):
+            continue
+        if not np.all(patch[-1, :] == WALL):
+            continue
+        if not np.all(patch[:-1, 1:-1] == BG):
+            continue
+        if patch[0, 0] != WALL or patch[0, -1] != WALL:
+            continue
+        left_missing = [i for i in range(h - 1) if patch[i, 0] != WALL]
+        right_missing = [i for i in range(h - 1) if patch[i, -1] != WALL]
+        if any(i == 0 for i in left_missing + right_missing):
+            continue
+        if len(left_missing) + len(right_missing) > 1:
+            continue
