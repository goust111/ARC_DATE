+                    hole_row: int | None = None
+                    if left_missing:
+                        hole_side = "left"
+                        hole_row = top + left_missing[0]
+                    elif right_missing:
+                        hole_side = "right"
+                        hole_row = top + right_missing[0]
+                    containers.append(Container(top, bottom, left, right, hole_side, hole_row))
