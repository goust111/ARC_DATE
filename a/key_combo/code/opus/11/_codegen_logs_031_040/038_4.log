+                side = "right"
+            if side == "right" and cont.right >= w - 1:
+                side = "left"
+            cont = Container(
+                cont.top,
+                cont.bottom,
+                cont.left,
+                cont.right,
+                side,
+                rng.randint(cont.top + 1, cont.bottom - 1),
