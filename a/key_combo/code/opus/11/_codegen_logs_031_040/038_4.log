+
+def _boxes_touch(a: Container, b: Container, gap: int = 1) -> bool:
+    return not (
+        a.bottom + gap < b.top
+        or b.bottom + gap < a.top
+        or a.right + gap < b.left
+        or b.right + gap < a.left
+    )
+
