+
+
+def _bottom_case(rng: random.Random) -> tuple[np.ndarray, str]:
+    h = rng.randint(15, 20)
+    w = rng.randint(18, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    side = "right"
+    a = _sample_container(
+        rng,
+        h,
+        w,
+        [],
+        top_range=(2, 4),
+        left_range=(1, max(2, w // 4)),
+        height_range=(4, 5),
+        width_range=(4, 6),
+        hole_side=side,
+    )
+    leak_col = a.left - 1 if side == "left" else a.right + 1
+
+    b = _sample_container(
+        rng,
+        h,
+        w,
+        [a],
+        top_range=(7, h - 6),
+        left_range=(max(leak_col + 3, w // 2), w - 6),
+        height_range=(4, 6),
+        width_range=(5, 7),
+        avoid_span_cols={leak_col},
+    )
+
+    c = _sample_container(
+        rng,
+        h,
+        w,
+        [a, b],
+        top_range=(2, h - 6),
+        height_range=(4, 5),
+        width_range=(4, 6),
+        avoid_span_cols={leak_col},
