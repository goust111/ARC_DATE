+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        rng = random.Random()
+        family = rng.choice(("blocked", "bottom", "multileak"))
+        try:
+            if family == "blocked":
+                grid, family_name = _blocked_case(rng)
+            elif family == "bottom":
+                grid, family_name = _bottom_case(rng)
+            else:
