+
+
+def _bottom_case(rng: random.Random) -> tuple[np.ndarray, str]:
+    h = rng.randint(15, 20)
+    w = rng.randint(18, 24)
+    grid = np.zeros((h, w), dtype=int)
+
+    side = "right"
+    a = _sample_container(
+        rng,
+        h,
+        w,
+        [],
+        top_range=(2, 4),
+        left_range=(1, max(2, w // 4)),
+        height_range=(4, 5),
+        width_range=(4, 6),
+        hole_side=side,
