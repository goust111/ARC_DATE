+def _history_signature(histories: list[dict[str, object]]) -> tuple[tuple[object, ...], ...]:
+    sig = []
+    for hist in histories:
+        sig.append(
+            (
+                hist["column"],
+                hist["outcome"],
+                hist["leak_count"],
+                tuple(hist["hit_ids"]),
+                hist.get("captured_id"),
+                hist.get("blocked_by"),
+            )
+        )
+    return tuple(sig)
