+        top, bottom = _split_sprite_parts(assembled, layout)
+        grid = _place_sprites(top, bottom)
+        if grid is None:
+            continue
+        if _validate_generated(grid):
+            return grid
+    raise RuntimeError("failed to generate a valid input")

