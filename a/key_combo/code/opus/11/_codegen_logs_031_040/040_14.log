+HEIGHT_RANGE = (10, 14)
+WIDTH_RANGE = (18, 24)
+SMALL_AREA_CHOICES = [3, 4, 5]
+MAX_GENERATION_ATTEMPTS = 500
+PLACEMENT_ATTEMPTS = 160
+SHAPE_ATTEMPTS = 120
