+def _input_neighbors_nonblack(grid: np.ndarray, r: int, c: int) -> int:
+    total = 0
+    for nr, nc in _neighbors4(r, c):
+        if _in_bounds(grid.shape, nr, nc) and grid[nr, nc] != BLACK:
+            total += 1
+    return total
+
