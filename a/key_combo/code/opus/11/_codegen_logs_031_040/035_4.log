import random
from collections import deque
import numpy as np

BLACK=0; BLUE=1; RED=2; GREEN=3; YELLOW=4; GREY=5; PINK=6; ORANGE=7
DIRS={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
CTRL_OPTIONS=[('U',(-1,0),'U'),('U',(-1,1),'U'),('D',(2,0),'D'),('D',(2,1),'D'),('L',(0,-1),'L'),('L',(1,-1),'L'),('R',(0,2),'R'),('R',(1,2),'R')]


def in_bounds(shape,r,c):
    return 0<=r<shape[0] and 0<=c<shape[1]

def neighbors4(r,c):
    return [(r-1,c),(r+1,c),(r,c-1),(r,c+1)]

def detect(grid):
    H,W=grid.shape
    used=np.zeros((H,W),bool)
    sq=[]
    for r in range(H-1):
      for c in range(W-1):
        block=grid[r:r+2,c:c+2]
        if np.any(used[r:r+2,c:c+2]):
            continue
        if np.all(np.isin(block,[BLUE,RED,GREEN,YELLOW])):
            positions=[(r-1,c),(r-1,c+1),(r+2,c),(r+2,c+1),(r,c-1),(r+1,c-1),(r,c+2),(r+1,c+2)]
            ctrls=[p for p in positions if in_bounds(grid.shape,*p) and grid[p]==GREY]
            if len(ctrls)"'!=1:
                continue
            rr,cc=ctrls[0]
            if rr==r-1: d='"'U'
            elif rr==r+2: d='D'
            elif cc==c-1: d='L'
            else: d='R'
            sq.append((r,c,d,len(set(map(int,block.flatten())))))
            used[r:r+2,c:c+2]=True
    return sq

def main(grid):
    g=np.array(grid,dtype=int)
    out=g.copy()
    for r,c,d,k in detect(g):
        ctrl=[(r-1,c),(r-1,c+1),(r+2,c),(r+2,c+1),(r,c-1),(r+1,c-1),(r,c+2),(r+1,c+2)]
        # find actual grey on side d
        pos=None
        for p in ctrl:
            if in_bounds(g.shape,*p) and g[p]==GREY:
                pos=p;break
        dr,dc=DIRS[d]
        for t in range(k):
            rr=pos[0]+dr*t; cc=pos[1]+dc*t
            if in_bounds(g.shape,rr,cc): out[rr,cc]=ORANGE
    H,W=out.shape
    vis=np.zeros((H,W),bool)
    for r in range(H):
      for c in range(W):
        if out[r,c]"'!=BLACK or vis[r,c]: continue
        q=deque([(r,c)]); vis[r,c]=1; pts=[]; touch=False
        while q:
          x,y=q.popleft(); pts.append((x,y))
          if x in (0,H-1) or y in (0,W-1): touch=True
          for nx,ny in neighbors4(x,y):
            if in_bounds(out.shape,nx,ny) and out[nx,ny]==BLACK and not vis[nx,ny]:
              vis[nx,ny]=1; q.append((nx,ny))
        if not touch:
          for x,y in pts: out[x,y]=PINK
    return out

def make_square(k):
    cols=[BLUE,RED,GREEN,YELLOW]
    random.shuffle(cols)
    if k==4:
        arr=np.array(cols[:4]).reshape(2,2)
    elif k==3:
        uniq=cols[:3]
        vals=uniq+[random.choice(uniq)]
        random.shuffle(vals)
        arr=np.array(vals).reshape(2,2)
    else:
        a,b=cols[:2]
        vals=[a,a,b,b]
        if random.random()<0.5:
            vals[random.randrange(4)]=a
        random.shuffle(vals)
        arr=np.array(vals).reshape(2,2)
        if len(set(arr.flatten()))<2:
            arr[0,0]=a;arr[1,1]=b
    assert len(set(map(int,arr.flatten())))==k
    return arr

def place_extra(grid, squares, min_top_left_l1=6):
    H,W=grid.shape
    for _ in range(200):
        r=random.randint(1,H-4); c=random.randint(1,W-4)
        if any(abs(r-r0)+abs(c-c0)<min_top_left_l1 for r0,c0,*_ in squares):
            continue
        patch=make_square(random.choice([2,3,4]))
        opts=CTRL_OPTIONS[:]
        random.shuffle(opts)
        for name,(dr0,dc0),d in opts:
            rr,cc=r+dr0,c+dc0
            if not in_bounds(grid.shape,rr,cc) or grid[rr,cc]!=BLACK:
                continue
            # place test
            g=grid.copy()
            if np.any(g[r:r+2,c:c+2]!=BLACK):
                continue
            g[r:r+2,c:c+2]=patch
            g[rr,cc]=GREY
            # control must have exactly one nonblack neighbor
            if sum(in_bounds(g.shape,nx,ny) and g[nx,ny]!=BLACK for nx,ny in neighbors4(rr,cc))!=1:
                continue
            return g,(r,c,d,len(set(map(int,patch.flatten()))))
    return None,None

def gen():
