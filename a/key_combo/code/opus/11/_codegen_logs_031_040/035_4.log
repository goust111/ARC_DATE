+        if np.any(grid[r : r + 2, c : c + 2] != BLACK):
+            continue
+
+        sprite = _make_square(k)
+        trial_options = options[:]
+        random.shuffle(trial_options)
+        for _name, (dr0, dc0), direction in trial_options:
