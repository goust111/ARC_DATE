            g=g2; squares.append(meta)
        if not ok: continue
        if random.random()<0.5: g=np.flipud(g)
        if random.random()<0.5: g=np.transpose(g)
        out=main(g)
        if np.count_nonzero(out==PINK)==0: continue
        alt=g.copy()
        # fixed K=4 alt
        out4=alt.copy()
        # not implemented quick check by compare after changing all blocks to 4 impossible here, skip
        return g,out
    raise RuntimeError

for i in range(20):
    inp,out=gen()
    print(i, inp.shape, len(detect(inp)), np.count_nonzero(out==PINK), np.count_nonzero(out==ORANGE))
print('ok')
