+
+def _cross_sprite(step_h: int, step_w: int) -> tuple[np.ndarray, int, int]:
+    sprite = np.zeros((step_h, step_w), dtype=int)
+    rr = step_h // 2
+    cc = step_w // 2
+    sprite[rr, :] = BLUE
+    sprite[:, cc] = RED
+    sprite[rr, cc] = BLUE
