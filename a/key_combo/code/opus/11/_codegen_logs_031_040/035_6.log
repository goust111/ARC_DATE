+
+
+def _count_shortest_paths(
+    open_mask: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    blocked_cells: set[tuple[int, int]] | None = None,
+) -> int:
+    blocked_cells = blocked_cells or set()
+    h, w = open_mask.shape
+    dist = {start: 0}
+    ways = {start: 1}
+    q = deque([start])
+    while q:
+        cur = q.popleft()
+        for dr, dc in DIR4:
