+
+    doors = []
+    for v, h in zip(vertical, horizontal):
+        doors.append({"kind": "V", **v})
+        doors.append({"kind": "H", **h})
+
+    markers = sorted(structure["markers"])
+    start = markers[0]
+    end = markers[1]
+    return doors, [start] + [door["center"] for door in doors] + [end]
