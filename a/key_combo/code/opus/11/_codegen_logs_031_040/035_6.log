+                        _rect_overlap(b4, cross_box, pad=0)
+                        or _rect_overlap(b4, b1, pad=0)
+                        or _rect_overlap(b4, b2, pad=0)
+                        or _rect_overlap(b4, b3, pad=0)
+                    ):
+                        continue
