+        if v_match:
+            wall_col = _nearest_unique((c0 + c1) / 2.0, col_walls)
+            vertical_doors.append(
+                {
+                    "wall": wall_col,
+                    "start": r0 + 1,
+                    "end": r1 - 1,
+                    "center": ((r0 + 1 + r1 - 1) // 2, wall_col),
+                    "box": box,
