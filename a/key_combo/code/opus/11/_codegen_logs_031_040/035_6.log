+        "bbox": (r0, c0, r1, c1),
+        "crop": crop,
+        "step_h": crop.shape[0],
+        "step_w": crop.shape[1],
+        "seed_row": r0 + row_idx,
+        "seed_col": c0 + col_idx,
+    }
+
+
+def _periodic_positions(seed: int, step: int, limit: int) -> list[int]:
+    vals = []
+    x = int(seed)
+    while x >= 0:
+        vals.append(x)
+        x -= int(step)
+    vals.reverse()
+    x = int(seed) + int(step)
+    while x < limit:
+        vals.append(x)
+        x += int(step)
+    return vals
+
+
+def _frame_is_hollow_rect(grid: np.ndarray, box: tuple[int, int, int, int]) -> bool:
+    r0, c0, r1, c1 = box
+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    if patch.shape[0] < 3 or patch.shape[1] < 3:
+        return False
+    border = np.zeros_like(patch, dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
+    return bool(np.all(patch[border] == YELLOW) and np.all(patch[1:-1, 1:-1] != YELLOW))
