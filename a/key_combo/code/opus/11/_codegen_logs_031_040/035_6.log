+def _generate_case() -> np.ndarray | None:
+    family_index = random.randrange(len(FAMILIES))
+    variants = _family_variants(family_index)
+    boxes = random.choice(variants)
+    return _build_family_grid(FAMILIES[family_index], boxes)
