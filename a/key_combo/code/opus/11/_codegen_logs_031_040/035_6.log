+
+    boxes_v1 = _candidate_vertical_boxes(col_walls[0], 1, gap_h, (height, width), col_walls)
+    boxes_h1 = _candidate_horizontal_boxes(row_walls[0], col_walls[0] + 1, gap_w, (height, width), row_walls)
+    boxes_v2 = _candidate_vertical_boxes(col_walls[1], row_walls[0] + 1, gap_h, (height, width), col_walls)
+    boxes_h2 = _candidate_horizontal_boxes(row_walls[1], col_walls[1], gap_w, (height, width), row_walls)
+
+    start = (1, 1)
+    end = (height - 2, width - 2)
+    marker_boxes = [(start[0], start[1], start[0], start[1]), (end[0], end[1], end[0], end[1])]
+
+    for b1 in boxes_v1[:16]:
+        if any(_rect_overlap(b1, box, pad=0) for box in marker_boxes) or _rect_overlap(b1, cross_box, pad=0):
