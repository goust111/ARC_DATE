+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+DIR4 = ((0, 1), (1, 0), (0, -1), (-1, 0))
+SAFE_OTHER_SIZES = (2, 4)
+GEN_RETRIES = 400
