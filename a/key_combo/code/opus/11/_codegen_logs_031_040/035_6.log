+    prefer: str = "horizontal",
+) -> list[tuple[int, int]] | None:
+    blocked_cells = blocked_cells or set()
+    if start == goal:
+        return [start]
+    h, w = open_mask.shape
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
