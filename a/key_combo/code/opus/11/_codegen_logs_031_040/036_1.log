+def _transform_bars(
+    bars: list[dict],
+    shape: tuple[int, int],
+    rotate_colors: set[int],
+) -> np.ndarray:
+    h, w = shape
+    out = np.full(shape, BLACK, dtype=int)
+    seen: dict[tuple[int, int], int] = {}
+    for bar in bars:
