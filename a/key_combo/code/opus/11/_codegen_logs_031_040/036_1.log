+def _find_bars(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    h, w = g.shape
+    seen = np.zeros_like(g, dtype=bool)
+    bars: list[dict] = []
