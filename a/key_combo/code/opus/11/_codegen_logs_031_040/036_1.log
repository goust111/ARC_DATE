+    ra0, ca0, ra1, ca1 = box_a
+    rb0, cb0, rb1, cb1 = box_b
+    row_gap = _axis_gap(ra0, ra1, rb0, rb1)
+    col_gap = _axis_gap(ca0, ca1, cb0, cb1)
+    return row_gap >= 1 or col_gap >= 1
