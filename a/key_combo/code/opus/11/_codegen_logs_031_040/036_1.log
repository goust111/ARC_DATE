+            assert 0 <= r < h and 0 <= c < w
+            prev = seen.get(cell)
+            assert prev is None, "transformed bars must not overlap"
+            seen[cell] = int(bar["color"])
+            out[r, c] = int(bar["color"])
+    return out
+
