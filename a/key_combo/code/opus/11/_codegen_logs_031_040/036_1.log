+def _bar_pixels(center: tuple[int, int], length: int, orient: str) -> list[tuple[int, int]]:
+    r, c = center
+    half = length // 2
+    if orient == HORIZONTAL:
+        return [(r, cc) for cc in range(c - half, c + half + 1)]
+    return [(rr, c) for rr in range(r - half, r + half + 1)]
