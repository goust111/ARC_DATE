+def _apply_connectors(base: np.ndarray) -> np.ndarray:
+    out = np.array(base, copy=True)
+    h, w = base.shape
+    colors = sorted(int(c) for c in np.unique(base) if c not in (BLACK, GREEN))
+    for color in colors:
+        mask = base == color
+        for r in range(h):
+            cols = np.flatnonzero(mask[r])
+            if cols.size >= 2:
