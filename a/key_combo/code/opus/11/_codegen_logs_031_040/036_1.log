+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+
+HORIZONTAL = "H"
+VERTICAL = "V"
+
+MIN_SIZE = 13
+MAX_SIZE = 16
+ODD_LENGTHS = (3, 5, 7)
