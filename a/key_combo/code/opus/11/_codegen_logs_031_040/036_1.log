+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or g[r, c] == bg:
+                continue
+            color = int(g[r, c])
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and g[nr, nc] == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
