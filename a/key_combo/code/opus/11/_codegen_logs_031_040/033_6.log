+
+
+def _draw_bars(
+    canvas: np.ndarray,
+    rows: list[int],
+    cols: list[int],
+    box: tuple[int, int, int, int],
+    color: int = GREY,
+) -> None:
+    r0, c0, r1, c1 = box
