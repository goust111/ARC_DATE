+    rebuilt = np.zeros_like(patch, dtype=bool)
+    rebuilt[[r - r0 for r in rows], :] = True
+    rebuilt[:, [c - c0 for c in cols]] = True
+    assert np.array_equal(rebuilt, patch), "line drawing must be exactly full rows and columns"
