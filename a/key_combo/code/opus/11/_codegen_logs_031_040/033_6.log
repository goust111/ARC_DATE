+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+FILL_COLORS = (BLUE, RED, GREEN, YELLOW)
+GEN_RETRIES = 600
+SIDES = ("top", "bottom", "left", "right")
+LAYOUT_TYPES = ("v1", "h1", "v2", "h2", "cross")
