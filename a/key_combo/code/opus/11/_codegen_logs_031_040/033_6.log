# Canvas/colors: same-size grids with the fixed observed palette.
GRID_HEIGHT_RANGE = (8, 16)
GRID_WIDTH_RANGE = (15, 17)
BG_COLOR = 0
LINE_COLOR = 3
MARKER_COLOR = 6
