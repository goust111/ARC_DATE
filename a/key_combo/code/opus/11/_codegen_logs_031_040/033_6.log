+    for a, b in zip(rows, rows[1:]):
+        assert b - a >= 2, "horizontal bars must leave at least one interior row"
+    for a, b in zip(cols, cols[1:]):
+        assert b - a >= 2, "vertical bars must leave at least one interior column"
