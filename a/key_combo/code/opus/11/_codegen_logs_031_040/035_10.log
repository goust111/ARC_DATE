+def _reserve_visible_cells(grid, period):
+    ph, pw = period
+    keep = set()
+    for rr in range(ph):
+        for cc in range(pw):
+            options = [(r, c) for r in range(rr, grid.shape[0], ph) for c in range(cc, grid.shape[1], pw) if int(grid[r, c]) in PATTERN_COLORS]
+            if not options:
+                return None
+            keep.add(random.choice(options))
+    return keep
