+def _pick_non_overlapping_starts(width):
+    starts = list(range(1, width - RECT_W))
+    random.shuffle(starts)
+    chosen = []
+    for start in starts:
+        if all(abs(start - prev) >= RECT_W + 2 for prev in chosen):
+            chosen.append(start)
+        if len(chosen) == 2:
+            break
