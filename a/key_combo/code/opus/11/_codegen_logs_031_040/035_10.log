+    marker_cols = spec["marker_cols"]
+    markers = [(target_top, start_col + c) for c in marker_cols]
+    distractors = []
+    band_rows = [r for r in range(rect_top, current_top) if r != target_top]
+    random.shuffle(band_rows)
+    for row in band_rows:
