+            if ac0 != 0 or ac1 != RECT_W - 1:
+                continue
+            top_cols = [c for r, c in frag if r == fr0]
+            out[rect_h].append(
+                {
+                    "rect_h": rect_h,
+                    "frag_cells": sorted(frag),
+                    "anchor_cells": sorted(anchor),
+                    "frag_top_offset": fr0,
+                    "frag_h": fr1 - fr0 + 1,
+                    "top_cols": sorted(top_cols),
+                    "frag_area": len(frag),
