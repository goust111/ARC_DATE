+            overlap = min(fc1, ac1) - max(fc0, ac0) + 1
+            if overlap <= 0 or ar1 >= fr0:
+                continue
+            candidates.append((overlap, -abs((fc0 + fc1) - (ac0 + ac1)), idx, anchor))
