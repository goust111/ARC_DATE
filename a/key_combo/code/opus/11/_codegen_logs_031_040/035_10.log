+        _overlap, _center_score, idx, anchor = candidates[0]
+        used.add(idx)
+        pairs.append((frag, anchor))
+    return pairs
+
+
+def _solve_with_details(grid):
+    g = np.asarray(grid, dtype=int)
+    ph, pw, tile = _infer_min_tile(g)
