from collections import deque
import numpy as np

def trace(H,W,c0):
    r=H-1;c=c0;dc=1;path=[];b=0
    while True:
        path.append((r,c))
        nr=r-1
        if nr<0: break
        nc=c+dc
        if nc<0 or nc>=W:
            dc=-dc;b+=1;nc=c+dc
        r,c=nr,nc
    return path,b

def regions(H,W,c0):
    g=np.zeros((H,W),int)
    p,b=trace(H,W,c0)
    for r,c in p:g[r,c]=1
    seen=np.zeros((H,W),bool)
    regs=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]"'!=0 or seen[r,c]:
