                    if 0<=nr<H and 0<=nc<W and g[nr,nc]==0 and not seen[nr,nc]:
                        seen[nr,nc]=1;q.append((nr,nc))
            regs.append(coords)
    regs.sort(key=lambda reg:(min(c for _,c in reg), min(r for r,_ in reg)))
    return [len(r) for r in regs], b

for H in [14,16,18]:
