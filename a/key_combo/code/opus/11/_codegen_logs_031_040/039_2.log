from collections import deque
import numpy as np

def trace(H,W,c0):
    r=H-1;c=c0;dc=1;path=[];b=0
    while True:
        path.append((r,c))
        nr=r-1
        if nr<0: break
        nc=c+dc
        if nc<0 or nc>=W:
            dc=-dc;b+=1;nc=c+dc
        r,c=nr,nc
    return path,b

def regions(H,W,c0):
    g=np.zeros((H,W),int)
    p,b=trace(H,W,c0)
    for r,c in p:g[r,c]=1
    seen=np.zeros((H,W),bool)
    comps=0
    sizes=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]"'!=0 or seen[r,c]:
                continue
            comps+=1
            q=deque([(r,c)]);seen[r,c]=1;sz=0
            while q:
                rr,cc=q.popleft();sz+=1
                for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                    nr,nc=rr+dr,cc+dc
                    if 0<=nr<H and 0<=nc<W and g[nr,nc]==0 and not seen[nr,nc]:
                        seen[nr,nc]=1;q.append((nr,nc))
            sizes.append(sz)
    return comps,sizes,b,p[-1]

for H in [12,14,16,18]:
  for W in [5,6,7,8,9,10]:
    vals=[]
    for c0 in range(1,W-1):
      comps,sizes,b,end=regions(H,W,c0)
      vals.append((c0,b,comps,end))
    print('"'H',H,'W',W,vals)
  print()
