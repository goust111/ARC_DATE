+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIRS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if (dr, dc) != (0, 0)
+)
+
+GEN_ATTEMPTS = 400
+MARKER_ATTEMPTS = 120
