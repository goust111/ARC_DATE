+
+def _non_adjacent(cell: tuple[int, int], chosen: list[tuple[int, int]]) -> bool:
+    row, col = cell
+    return all(max(abs(row - rr), abs(col - cc)) > 1 for rr, cc in chosen)
+
+
+def _sample_markers(
