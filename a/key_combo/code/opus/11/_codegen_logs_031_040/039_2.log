def _find_marked_rectangle(g: np.ndarray) -> tuple[int, int, int, int, int, int]:
    height, width = map(int, g.shape)
    candidates: list[tuple[int, int, int, int, int, int, int]] = []

    for a, b in itertools.combinations(colors_present(g), 2):
        allowed = (g == a) | (g == b)
