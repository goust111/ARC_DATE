+        region_count = len(analysis["regions"])
+        if analysis["bounces"] < 2 or region_count <= k:
+            continue
+        chosen = _selected_region_indices(region_count, k)
+        if min(analysis["region_sizes"][idx] for idx in chosen) < 3:
