+    row = height - 1
+    col = int(start_col)
+    dc = 1
+    path: list[tuple[int, int]] = []
+    bounces = 0
+
+    while True:
+        path.append((row, col))
+        next_row = row - 1
+        if next_row < 0:
+            break
+        next_col = col + dc
+        if next_col < 0 or next_col >= width:
+            dc = -dc
+            bounces += 1
+            next_col = col + dc
+        row, col = next_row, next_col
+
+    return path, bounces
