+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+TEAL = 8
+
+UP, RIGHT, DOWN, LEFT = range(4)
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]
+TURN_CCW = "L"
+TURN_CW = "R"
+
+LEGEND_H = 2
+LEGEND_SLOT_STARTS = (1, 4, 7)
+OBSTACLE_COLORS = (RED, GREEN, YELLOW)
+FILL_COLORS = (BLUE, RED, GREEN, YELLOW, PINK)
+GEN_ATTEMPTS = 1500
