+
+    if trace["total_hits"] < len(trace["blocks"]):
+        return None
+
+    area_order = [idx for _area, idx in sorted((region["area"], idx) for idx, region in enumerate(regions))]
+    spatial_order = [idx for _r, _c, idx in _spatial_order(regions)]
