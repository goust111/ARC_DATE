+        signs = [TURN_CCW, TURN_CW]
+        random.shuffle(signs)
+        return {color: sign for color, sign in zip(colors, signs)}
+    signs = [TURN_CCW, TURN_CW, random.choice([TURN_CCW, TURN_CW])]
+    random.shuffle(signs)
+    return {color: sign for color, sign in zip(colors, signs)}
+
