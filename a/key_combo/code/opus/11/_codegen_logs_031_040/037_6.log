+def _place_random_blocks(height: int, width: int, emitter_r0: int, emitter_c0: int) -> list[dict] | None:
+    block_count = random.choice([4, 5])
+    color_count = random.choice([2, 3])
+    palette = random.sample(OBSTACLE_COLORS, color_count)
+    forbidden = _expand_cells([(r, c) for r in range(emitter_r0, emitter_r0 + 3) for c in range(emitter_c0, emitter_c0 + 3)], (height, width))
+    blocks: list[dict] = []
+
+    for _ in range(block_count):
+        placed = False
+        for _ in range(200):
+            color = random.choice(palette)
+            orientation = random.choice(["h", "v"])
+            if orientation == "h":
+                r = random.randint(1, height - 2)
+                c = random.randint(1, width - 3)
+                cells = [(r, c), (r, c + 1)]
+            else:
+                r = random.randint(1, height - 3)
+                c = random.randint(1, width - 2)
+                cells = [(r, c), (r + 1, c)]
+            if any(cell in forbidden for cell in cells):
+                continue
+            blocks.append({"color": color, "cells": tuple(cells)})
+            forbidden |= _expand_cells(cells, (height, width))
+            placed = True
+            break
+        if not placed:
+            return None
+    return blocks
