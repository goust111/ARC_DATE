0184: def _random_gaps(n: int, min_gap: int, max_gap: int, max_total: int) -> list[int] | None:
0185:     """Generate n gaps each in [min_gap, max_gap] with sum <= max_total."""
0186:     if n * min_gap > max_total:
0187:         return None
0188:     gaps = [min_gap] * n
0189:     remaining = max_total - sum(gaps)
0190:     for i in range(n):
0191:         extra = min(max_gap - gaps[i], remaining)
0192:         if extra > 0:
0193:             add = random.randint(0, extra)
0194:             gaps[i] += add
0195:             remaining -= add
0196:     random.shuffle(gaps)
0197:     return gaps
