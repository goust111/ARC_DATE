+                break
+
+            assert value in turn_map, "every obstacle color must be present in the legend"
+            block_id = cell_to_block[(nr, nc)]
+            trace["used_block_ids"].add(block_id)
+            trace["used_colors"].add(value)
+            trace["total_hits"] += 1
+            hits.append(block_id)
