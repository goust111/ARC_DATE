+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _rot(direction: int, turn: str) -> int:
+    return (direction - 1) % 4 if turn == TURN_CCW else (direction + 1) % 4
