+                        q.append((nr, nc))
+            if not touches_edge:
+                r0, c0, r1, c1 = _bbox(coords)
+                regions.append(
+                    {
+                        "coords": coords,
+                        "area": len(coords),
+                        "bbox": (r0, c0, r1, c1),
