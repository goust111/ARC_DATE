+    for block_id in used_block_ids:
+        variant = base.copy()
+        for r, c in trace["blocks"][block_id]["cells"]:
+            variant[r, c] = BLACK
+        altered = _alternate_output(variant, turn_map)
+        if altered is None or np.array_equal(altered, expected):
