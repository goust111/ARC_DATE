+    for start_r, start_c, start_dir in ray_specs:
+        r, c, direction = start_r, start_c, start_dir
+        seen_states: set[tuple[int, int, int]] = set()
+        painted = 0
+        hits: list[int] = []
+        termination = "edge"
+        while True:
+            state = (r, c, direction)
+            assert state not in seen_states, "ray path must not cycle"
+            seen_states.add(state)
