+
+        trace["rays"].append(
+            {
+                "start": (start_r, start_c, start_dir),
+                "painted": painted,
+                "hits": tuple(hits),
+                "termination": termination,
+            }
+        )
+
+    return out, trace
+
+
+def _enclosed_regions(grid: np.ndarray) -> list[dict]:
+    seen = np.zeros(grid.shape, dtype=bool)
+    regions: list[dict] = []
+    for r in range(grid.shape[0]):
+        for c in range(grid.shape[1]):
+            if int(grid[r, c]) != BLACK or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                if rr == 0 or rr == grid.shape[0] - 1 or cc == 0 or cc == grid.shape[1] - 1:
+                    touches_edge = True
+                for dr, dc in DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) == BLACK and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
