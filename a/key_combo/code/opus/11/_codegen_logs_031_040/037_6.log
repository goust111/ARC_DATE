+    ray_specs = [
+        (emitter_r0, emitter_c0 + 1, UP),
+        (emitter_r1, emitter_c0 + 1, DOWN),
+        (emitter_r0 + 1, emitter_c0, LEFT),
+        (emitter_r0 + 1, emitter_c1, RIGHT),
+    ]
+
+    trace = {
+        "rays": [],
+        "used_block_ids": set(),
+        "used_colors": set(),
+        "total_hits": 0,
+        "blocks": blocks,
+    }
