+
+
+def _base_grid(height: int, width: int, emitter_r0: int, emitter_c0: int, blocks: list[dict]) -> np.ndarray:
+    base = np.zeros((height, width), dtype=int)
+    base[emitter_r0 : emitter_r0 + 3, emitter_c0 : emitter_c0 + 3] = TEAL
+    for block in blocks:
