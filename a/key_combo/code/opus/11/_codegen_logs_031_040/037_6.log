+    if not (2 <= len(regions) <= 5):
+        return None
+
+    areas = [region["area"] for region in regions]
+    if areas != sorted(areas) and sorted(areas) == areas:
+        return None
+    if len(areas) != len(set(areas)):
+        return None
+
+    used_block_ids = sorted(trace["used_block_ids"])
+    if len(used_block_ids) != len(trace["blocks"]):
+        return None
+
+    used_turns = {turn_map[int(trace["blocks"][block_id]["color"])] for block_id in used_block_ids}
+    if used_turns != {TURN_CCW, TURN_CW}:
+        return None
+
+    terminations = {ray["termination"] for ray in trace["rays"]}
+    if "path" not in terminations or "edge" not in terminations:
+        return None
+
+    if trace["total_hits"] < len(trace["blocks"]):
+        return None
+
+    area_order = [idx for _area, idx in sorted((region["area"], idx) for idx, region in enumerate(regions))]
+    spatial_order = [idx for _r, _c, idx in _spatial_order(regions)]
+    if area_order == spatial_order:
