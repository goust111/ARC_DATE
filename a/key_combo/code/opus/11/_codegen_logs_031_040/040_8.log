spec:
  grid: (2H+1) rows x W cols; H=3-6, W=4-7 [observed H=4, W=5]
  background: black (0)
  divider: single full-width row at the exact center (row H), uniform non-black color
  top_mask: rows 0..H-1, exactly one foreground color on black; density 30-70%
  bottom_mask: rows H+1..2H, exactly one foreground color on black; density 30-70%
  color_constraints:
    top_color, bottom_color, divider_color all distinct, all non-black
    top=red(2), bottom=blue(1), divider=yellow(4) [observed]
  overlap: masks partially overlap (1-40% of cells) and leave some cells both-black (>=10% of cells)
  output:
    shape: H x W (divider removed)
    rule: cell is green(3) if either mask has foreground there; else black(0)
    output density 65-90% of cells are green

generation_strategy:
