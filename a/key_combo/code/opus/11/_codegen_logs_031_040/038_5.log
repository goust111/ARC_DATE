+
+    return out, row_ranges, col_ranges
+
+
+def _collect_markers(
+    grid: np.ndarray,
+    row_ranges: list[tuple[int, int]],
+    col_ranges: list[tuple[int, int]],
+) -> dict[tuple[int, int], list[tuple[int, int]]]:
