+    markers = _collect_markers(grid, row_ranges, col_ranges)
+    out = grid.copy()
+    horizontal_offsets: dict[tuple[int, int], set[tuple[int, int]]] = defaultdict(set)
+    debug = {
+        "horizontal_draws": set(),
+        "vertical_draws": set(),
+        "yellow_draws": set(),
+    }
+
+    for offset, cells in markers.items():
