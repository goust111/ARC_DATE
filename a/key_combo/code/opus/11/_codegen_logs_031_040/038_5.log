+
+
+def _paint_local(
+    grid: np.ndarray,
+    row_ranges: list[tuple[int, int]],
+    col_ranges: list[tuple[int, int]],
+    cell_r: int,
+    cell_c: int,
+    offset: tuple[int, int],
+    color: int,
+) -> None:
+    r = row_ranges[cell_r][0] + offset[0]
+    c = col_ranges[cell_c][0] + offset[1]
+    grid[r, c] = int(color)
+
+
+def _connect_markers(
+    grid: np.ndarray,
+    row_ranges: list[tuple[int, int]],
+    col_ranges: list[tuple[int, int]],
