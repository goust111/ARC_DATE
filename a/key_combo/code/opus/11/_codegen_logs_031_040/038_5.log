+    for color in sorted(set(map(int, cells.ravel())) - {-1}):
+        for comp in _components(cells == color):
+            assert len(comp) == 3, "each quartet group must show exactly three occupied cells"
+            rs = [r for r, _ in comp]
+            cs = [c for _, c in comp]
