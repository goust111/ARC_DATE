+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+
+CELL_GRID_SIZE = 6
+CELL_SIZE_CHOICES = (3, 4)
+BASE_COLORS = (BLUE, RED, GREEN)
+QUARTET_STARTS = {
+    "left": (2, 0),
+    "right": (2, 4),
+    "top": (0, 2),
+    "bottom": (4, 2),
+}
+QUARTET_FAMILIES = {
+    "left": "horizontal",
+    "right": "horizontal",
+    "top": "vertical",
+    "bottom": "vertical",
+}
+CARDINAL_STEPS = ((1, 0), (-1, 0), (0, 1), (0, -1))
