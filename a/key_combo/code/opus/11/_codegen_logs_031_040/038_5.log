    n_groups = int(np.random.randint(*GROUP_COUNT_RANGE))
    marker_colors = [int(c) for c in colors[2 : 2 + n_groups]]
    offsets = [(int(r), int(c)) for r, c in np.random.permutation(LOCAL_OFFSETS)[:n_groups]]
