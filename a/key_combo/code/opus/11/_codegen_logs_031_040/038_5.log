+def _ranges_between(size: int, dividers: list[int]) -> list[tuple[int, int]]:
+    points = [-1] + list(dividers) + [int(size)]
+    return [
+        (points[i] + 1, points[i + 1] - 1)
+        for i in range(len(points) - 1)
+        if points[i] + 1 <= points[i + 1] - 1
+    ]
