+    for offset, cells in markers.items():
+        by_row: dict[int, list[int]] = defaultdict(list)
+        by_col: dict[int, list[int]] = defaultdict(list)
+        for cell_r, cell_c in cells:
+            by_row[cell_r].append(cell_c)
+            by_col[cell_c].append(cell_r)
