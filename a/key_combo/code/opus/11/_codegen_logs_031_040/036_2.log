+            path.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
