+            kept_internal.append((rr, cc))
+
+    return {
+        "labels": labels,
+        "regions": regions,
+        "outer_id": outer_id,
+        "votes": votes,
+        "erasable": erasable,
+        "kept_internal": kept_internal,
+        "kept_outer": kept_outer,
+    }
