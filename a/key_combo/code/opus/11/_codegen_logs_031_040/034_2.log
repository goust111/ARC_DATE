+    info = _analyze(g)
+    labels = info["labels"]
+    votes = info["votes"]
+    outer_id = info["outer_id"]
+
+    out = g.copy()
+    for region in info["regions"]:
+        vote = votes[region["id"]]
+        for r, c in region["cells"]:
+            if int(out[r, c]) == BLACK:
+                out[r, c] = vote
