+    outer_inner_w = margin_in[2] + slot_w[0] + gap_c + slot_w[1] + margin_in[3]
+    grid_h = margin_out[0] + outer_inner_h + 2 + margin_out[1]
+    grid_w = margin_out[2] + outer_inner_w + 2 + margin_out[3]
