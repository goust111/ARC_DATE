+    outer_c0 = margin_out[2]
+    outer_r1 = outer_r0 + outer_inner_h + 1
+    outer_c1 = outer_c0 + outer_inner_w + 1
+    _draw_rect_loop(grid, outer_r0, outer_c0, outer_r1, outer_c1)
