+                continue
+            comp_id = len(comps)
+            stack = [(r, c)]
+            labels[r, c] = comp_id
+            cells: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == -1:
+                        labels[nr, nc] = comp_id
+                        stack.append((nr, nc))
+            comps.append(cells)
+    return labels, comps
