+        (row_starts[0], col_starts[1], row_starts[0] + slot_h[0] - 1, col_starts[1] + slot_w[1] - 1),
+        (row_starts[1], col_starts[0], row_starts[1] + slot_h[1] - 1, col_starts[0] + slot_w[0] - 1),
