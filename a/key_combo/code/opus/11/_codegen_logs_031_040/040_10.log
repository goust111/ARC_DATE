+        growth = _notch_growth_side(notch["side"])
+        if growth in ("up", "down"):
+            dim = rot.shape[0]
+        else:
+            dim = rot.shape[1]
+        assert sum(dim + k for k in range(1, 4)) >= 9
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    size_pool = [(2, 2), (2, 3), (1, 2), (1, 3)]
