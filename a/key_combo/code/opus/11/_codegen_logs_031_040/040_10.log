+from __future__ import annotations
+
+import random
+from itertools import combinations
+
+import numpy as np
+
+
+BG = 0
+BAR = 5
+SPRITE_COLORS = (1, 2, 3, 4)
+SIDES = ("top", "bottom", "left", "right")
+GENERATION_ATTEMPTS = 400
+
