  grid: 10x10 [observed]
  background: BLACK
  foreground: single non-BLACK, non-GREY color
  strokes:
    definition: each stroke draws 2-3 sides of its bounding box (L-shape for 2, U-shape for 3)
    side_set: same for all strokes; 2-side combos must be adjacent (share a corner); 3-side = any 3 of 4
    all_strokes_identical_sides: true
  arithmetic_sequence:
    bbox_corners: (r0, c0, r1, c1) form an arithmetic sequence with constant step delta
    step_rule: step[j] != 0 iff the corresponding edge is in the side set; all nonzero step components have equal absolute magnitude
    growth: boxes grow outward (top->up, bottom->down, left->left, right->right)
    fixed_edges: edges NOT in side set are pinned to grid boundary (r0=0 or c0=0 or r1=H-1 or c1=W-1)
    step_magnitude: 2-3 [observed]; equals min(h,w) of smallest box [observed]
  input_strokes: 2-3 consecutive members of the sequence, fully visible within the grid
  smallest_box: min dimension 2-4 [observed]
  output:
    extend sequence in both directions until clipped strokes leave grid entirely
    paint extended strokes with fg color; fill remaining cells with GREY
    total_visible_strokes: 3-5

generation_strategy:
  approach: output-first
  steps:
    1. Pick grid 10x10, fg color (not BLACK/GREY), side_set (2 adjacent or 3 of 4 sides)
    2. Choose anchor corner from grid boundary based on absent sides (e.g. top absent => r0=0 for all boxes)
    3. Pick step magnitude M (2-3) and smallest box dimensions (min dim = M, other dim >= M)
    4. Build full arithmetic bbox sequence from smallest outward until clipped strokes leave grid
    5. Render output -- all strokes in fg, rest GREY
    6. Select 2-3 consecutive strokes that are fully within the grid as input strokes
    7. Render input -- selected strokes in fg on BLACK background, rest BLACK
