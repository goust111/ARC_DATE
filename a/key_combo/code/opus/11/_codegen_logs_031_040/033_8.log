+    r0, c0, r1, c1 = bbox
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _trace_diagonal(base: np.ndarray, start: Coord, dc: int) -> tuple[list[Coord], str]:
+    h, w = map(int, base.shape)
+    r, c = start
+    rr = r - 1
+    cc = c + dc
