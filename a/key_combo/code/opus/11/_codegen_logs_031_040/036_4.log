+def _mask_from_shape(shape: tuple[tuple[int, int], ...]) -> np.ndarray:
+    rows = [r for r, _c in shape]
+    cols = [c for _r, c in shape]
+    h = max(rows) + 1
+    w = max(cols) + 1
