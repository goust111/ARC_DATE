+    slot_cols = {int(bar["col"]) for bar in bars}
+    pair_map: dict[int, int] = {}
+
+    for start in sorted(starts):
+        if start not in unseen:
+            continue
+        queue = deque([start])
+        component = {start}
+        unseen.remove(start)
+        while queue:
+            r, c = queue.popleft()
+            for dr, dc in ((-2, 0), (2, 0), (0, -2), (0, 2)):
+                nxt = (r + dr, c + dc)
+                if nxt in unseen:
+                    unseen.remove(nxt)
+                    component.add(nxt)
+                    queue.append(nxt)
