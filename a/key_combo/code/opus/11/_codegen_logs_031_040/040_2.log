+        endpoints = sorted(
+            int(c)
+            for r, c in component
+            if r == base_r + 1 and c in slot_cols
+        )
+        assert len(endpoints) == 2, "each guide component must connect exactly two slots"
+        a, b = endpoints
+        pair_map[a] = b
+        pair_map[b] = a
