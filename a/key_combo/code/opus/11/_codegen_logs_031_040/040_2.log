+        return _horizontal_segment(start_r, a_col, b_col)
+
+    points = set()
+    points |= _vertical_segment(start_r, lane_r, a_col)
+    points |= _horizontal_segment(lane_r, a_col, b_col)
+    points |= _vertical_segment(lane_r, start_r, b_col)
+    return points
+
+
