+def _guide_nodes(grid: np.ndarray, base_r: int) -> set[tuple[int, int]]:
+    rows, cols = np.where(grid[base_r + 1 :, :] == GREY)
+    return {(int(base_r + 1 + r), int(c)) for r, c in zip(rows, cols)}
