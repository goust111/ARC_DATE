+    assert len(pair_map) == len(bars), "all bars must be paired"
+    return pair_map
+
+
+def _render_with_heights(grid: np.ndarray, base_r: int, bars: list[dict[str, int]], new_heights: dict[int, int]) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
