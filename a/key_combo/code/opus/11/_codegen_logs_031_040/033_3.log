+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        marker_pos = random.choice(NON_CENTER_POSITIONS)
+        tile = _sample_colored_cells(marker_pos)
+        if _is_valid_generated_input(tile):
+            return tile
