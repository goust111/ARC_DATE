+                req_local_c = int(np.random.randint(0, box_w))
+                required = (req_local_r, req_local_c)
+
+            shape = _random_connected_shape(box_h, box_w, int(np.random.randint(area_lo, area_hi + 1)), required)
+            if shape is None:
+                ok = False
+                break
