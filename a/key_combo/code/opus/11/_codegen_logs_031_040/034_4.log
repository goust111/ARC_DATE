+            global_cells = np.array([[allowed_rows[r], c0 + c] for r, c in shape], dtype=int)
+            for cell in map(tuple, global_cells):
+                if cell in occupied or cell in used:
+                    ok = False
+                    break
+            if not ok:
+                break
