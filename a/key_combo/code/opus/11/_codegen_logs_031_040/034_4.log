+def _sample_boxes(width: int, count: int, widths: list[int]) -> list[tuple[int, int]] | None:
+    for _ in range(120):
+        starts = []
+        intervals = []
+        for box_w in widths:
+            c0 = int(np.random.randint(0, width - box_w + 1))
+            intervals.append((c0, c0 + box_w - 1))
