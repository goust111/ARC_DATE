+                grid[r, c] = ORANGE
+            occupied |= set(map(tuple, comp))
+
+    if not placed_required:
+        return None
+
+    try:
+        _validate_input(grid)
+    except Exception:
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GRID_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

