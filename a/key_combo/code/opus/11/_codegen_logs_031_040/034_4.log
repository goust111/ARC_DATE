+def _gen_attempt() -> np.ndarray | None:
+    seed_count = 3 if np.random.rand() < 0.6 else 2
+    colors = list(np.random.permutation(SEED_COLORS)[:seed_count])
+
+    first_gap = int(np.random.choice([4, 6]))
+    gaps: list[int] = [first_gap]
+    if seed_count == 3:
