+        symmetric = True
+        for r, c in grey_coords:
+            if grid[r, _mirror_col(grid.shape[1], c)] != GREY:
+                symmetric = False
+                break
+        if symmetric:
+            for r, c in grey_coords:
+                out[r, c] = GREEN
+    return out
+
+
+def _wrong_pairwise_output(grid: np.ndarray) -> np.ndarray:
+    filled = _fill_gaps(grid)
+    grey = grid == GREY
+    paired = grey & np.fliplr(grey)
+    filled[paired] = GREEN
+    return filled
