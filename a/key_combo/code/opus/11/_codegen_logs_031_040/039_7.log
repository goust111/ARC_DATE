+from __future__ import annotations
+
+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+GREY = 5
+
+WIDTH_OPTIONS = (11, 13, 15, 17)
+SEPARATOR_COUNT_OPTIONS = (2, 3)
+BAND_HEIGHT_OPTIONS = (2, 3, 4)
