+            "u": key[0],
+            "v": key[1],
+            "a_center": da,
+            "b_center": db,
+            "weight": abs(da[0] - db[0]) + abs(da[1] - db[1]),
+            "tie0": lo,
+            "tie1": hi,
+        }
