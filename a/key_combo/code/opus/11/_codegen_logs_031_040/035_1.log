+    casts = _analyze_casts(g, rects)
+    source_counts = Counter(cast["source"] for cast in casts)
+    target_counts = Counter(cast["target"] for cast in casts)
+    assert all(source_counts[rect.name] == 1 for rect in rects)
+    assert all(target_counts[rect.name] == 1 for rect in rects)
+
+    door_by_rect = {cast["target"]: cast["door_center"] for cast in casts}
+    out = g.copy()
+    for cast in casts:
+        out[cast["control"]] = BG
+    for cast in casts:
+        for cell in cast["door_cells"]:
+            out[cell] = BG
