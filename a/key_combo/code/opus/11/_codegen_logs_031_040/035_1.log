+
+def _required_gap(src: Rect, dst: Rect, direction: str) -> bool:
+    if direction == "E":
+        return dst.c0 - src.c1 - 1 >= 4
+    if direction == "W":
+        return src.c0 - dst.c1 - 1 >= 4
+    if direction == "S":
+        return dst.r0 - src.r1 - 1 >= 4
+    if direction == "N":
+        return src.r0 - dst.r1 - 1 >= 4
+    raise ValueError(direction)
