+    edges = sorted(
+        edge_map.values(),
+        key=lambda edge: (
+            edge["weight"],
+            edge["tie0"][0],
+            edge["tie0"][1],
+            edge["tie1"][0],
+            edge["tie1"][1],
+            edge["u"],
+            edge["v"],
