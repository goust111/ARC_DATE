+
+def _perp_overlap(src: Rect, dst: Rect, direction: str) -> tuple[int, int] | None:
+    if direction in ("E", "W"):
+        return _interval_overlap(src.r0, src.r1, dst.r0, dst.r1)
+    return _interval_overlap(src.c0, src.c1, dst.c0, dst.c1)
