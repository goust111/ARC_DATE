+    door_by_rect = {cast["target"]: cast["door_center"] for cast in casts}
+    out = g.copy()
+    for cast in casts:
+        out[cast["control"]] = BG
+    for cast in casts:
+        for cell in cast["door_cells"]:
+            out[cell] = BG
