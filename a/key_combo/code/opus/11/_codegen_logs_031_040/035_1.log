+        cells = [(start + k, hc) for k in range(3)]
+        return cells, (start + 1, hc)
+    assert dr != 0
+    assert hr in (rect.r0, rect.r1)
+    start = min(max(hc - 1, rect.c0), rect.c1 - 2)
+    cells = [(hr, start + k) for k in range(3)]
+    return cells, (hr, start + 1)
+
