def _gen_spaced_choice(values, count, min_gap):
    combos = [
        combo
        for combo in itertools.combinations(values, count)
        if all(b - a >= min_gap for a, b in zip(combo, combo[1:]))
    ]
    if not combos:
        return None
    return list(random.choice(combos))

