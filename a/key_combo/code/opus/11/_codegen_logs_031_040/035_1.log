+    edge_map: dict[tuple[str, str], dict] = {}
+    for cast in casts:
+        a = cast["source"]
+        b = cast["target"]
+        key = tuple(sorted((a, b)))
+        if key in edge_map:
+            continue
+        da = door_by_rect[a]
+        db = door_by_rect[b]
+        lo, hi = _edge_key(da, db)
