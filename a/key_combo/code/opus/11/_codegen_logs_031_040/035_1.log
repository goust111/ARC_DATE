+        return (coord, src.c1 + 1), (coord, dst.c0)
+    if direction == "W":
+        return (coord, src.c0 - 1), (coord, dst.c1)
+    if direction == "S":
+        return (src.r1 + 1, coord), (dst.r0, coord)
+    if direction == "N":
+        return (src.r0 - 1, coord), (dst.r1, coord)
+    raise ValueError(direction)
