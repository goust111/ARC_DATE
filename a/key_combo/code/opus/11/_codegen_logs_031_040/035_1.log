+        door_cells, door_center = _door_cells(target, hit, (dr, dc))
+        casts.append(
+            {
+                "control": control,
+                "source": source.name,
+                "target": target.name,
+                "hit": hit,
+                "ray_dir": (dr, dc),
+                "door_cells": tuple(door_cells),
+                "door_center": door_center,
+                "shifted": door_center != hit,
+            }
+        )
+    return casts
