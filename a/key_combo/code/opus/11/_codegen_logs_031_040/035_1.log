+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _interval_overlap(a0: int, a1: int, b0: int, b1: int) -> tuple[int, int] | None:
+    lo = max(a0, b0)
+    hi = min(a1, b1)
+    return (lo, hi) if lo <= hi else None
+
+
+def _interval_gap(a0: int, a1: int, b0: int, b1: int) -> int:
+    if a1 < b0:
+        return b0 - a1 - 1
+    if b1 < a0:
+        return a0 - b1 - 1
+    return 0
+
+
+def _components4(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                comp.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _extract_rectangles(grid: np.ndarray) -> list[Rect]:
+    comps = _components4(grid == FRAME)
+    rects: list[Rect] = []
+    for comp in comps:
+        rows = [r for r, _ in comp]
+        cols = [c for _, c in comp]
+        r0, r1 = min(rows), max(rows)
+        c0, c1 = min(cols), max(cols)
+        if r1 - r0 + 1 < 4 or c1 - c0 + 1 < 4:
+            raise AssertionError("frame too small")
+        expected = set()
+        for r in range(r0, r1 + 1):
+            expected.add((r, c0))
+            expected.add((r, c1))
+        for c in range(c0, c1 + 1):
+            expected.add((r0, c))
+            expected.add((r1, c))
