+        for b in rects[i + 1 :]:
+            row_gap = _rect_row_gap(a, b)
+            col_gap = _rect_col_gap(a, b)
+            if row_gap == 0 and col_gap < 4:
+                return False
+            if col_gap == 0 and row_gap < 4:
+                return False
+            if row_gap > 0 and col_gap > 0 and (row_gap < 3 or col_gap < 3):
+                return False
