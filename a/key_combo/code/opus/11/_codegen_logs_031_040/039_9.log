    assert pattern_h % macro_h == 0 and pattern_w % macro_w == 0, "pattern must divide into macro-cells"
    cell_h, cell_w = pattern_h // macro_h, pattern_w // macro_w

    selector = np.zeros((macro_h, macro_w), dtype=bool)
