    paste(grid, stamp, top_pad, left_pad)
    paste(grid, pattern, top_pad, left_pad + stamp.shape[1] + OBJECT_GAP)
    paste(grid, canvas, top_pad + top_h + OBJECT_GAP, left_pad)
    return grid


