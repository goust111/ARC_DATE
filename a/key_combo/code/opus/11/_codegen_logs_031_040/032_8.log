+
+def _normalize(coords: tuple[tuple[int, int], ...]) -> tuple[tuple[int, int], ...]:
+    min_r = min(r for r, _ in coords)
+    min_c = min(c for _, c in coords)
+    return tuple(sorted((r - min_r, c - min_c) for r, c in coords))
