+
+def _component_count(coords: set[tuple[int, int]]) -> int:
+    if not coords:
+        return 0
+    unseen = set(coords)
+    count = 0
+    while unseen:
+        count += 1
+        start = unseen.pop()
+        stack = [start]
+        while stack:
+            r, c = stack.pop()
+            for nr, nc in _neighbors4(r, c):
+                if (nr, nc) in unseen:
+                    unseen.remove((nr, nc))
+                    stack.append((nr, nc))
