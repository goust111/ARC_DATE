+
+
+def _pair_specs_square_vs_square(top_row: int, left_col: int, colors: tuple[int, int]) -> list[dict]:
+    top_moved = _translate(SHAPES["square"], top_row, left_col)
+    bottom_moved = _translate(SHAPES["square"], top_row + 1, left_col - 1)
+    return [
