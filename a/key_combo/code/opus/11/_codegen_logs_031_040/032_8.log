+        ordered, collisions, occupancy = _simulate(inp)
+    except AssertionError:
+        return False
+    if len(collisions) < 2:
+        return False
+    collision_pairs = set()
+    for cell, ranks in occupancy.items():
+        if len(ranks) > 1:
+            for pair in combinations(sorted(ranks), 2):
+                collision_pairs.add(pair)
+    if len(collision_pairs) < 2:
+        return False
+
