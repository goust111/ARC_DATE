+    inp = _render_input(objects, (h, w))
+    if not _validate_case(inp):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _attempt()
+        if grid is not None:
+            return grid
