+
+    for _ in range(40):
+        c2 = random.randint(2, w - 3)
+        trial_objects = [obj.copy() for obj in objects]
+        trial_input = input_coords_seen.copy()
+        trial_moved = moved_coords_seen.copy()
+        pair2 = _pair_specs_square_vs_square(r2, c2, (colors[2], colors[3]))
