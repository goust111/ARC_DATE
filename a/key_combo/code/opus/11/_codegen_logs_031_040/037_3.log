+
+    b4 = c_left_2
+    a4 = b4 - len4 + 1
+
+    a5 = c_right_2
+    b5 = a5 + len5 - 1
+
+    leftmost = min(a1, a2, a4, center)
+    rightmost = max(b1, b3, b5, center)
+    assert leftmost >= 0 and rightmost < width
