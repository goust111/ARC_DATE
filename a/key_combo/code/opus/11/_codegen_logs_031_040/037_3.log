+        delta = int(hint_cols[0] - c)
+        if delta == -1:
+            mapping[color] = DIR_LEFT
+        elif delta == 0:
+            mapping[color] = DIR_BOTH
+        elif delta == 1:
+            mapping[color] = DIR_RIGHT
