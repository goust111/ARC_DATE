+        pair["moving_input_origin"] = placed
+        occupied.append((placed[0], placed[1], placed[0] + mh - 1, placed[1] + mw - 1))
+    return True
+
+
+def _validate_generated(inp: np.ndarray, out: np.ndarray) -> bool:
+    if np.array_equal(inp, out):
