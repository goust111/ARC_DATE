+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "patch": patch,
+        "conn_color": conn_color,
+        "conn_local": conn_local,
+        "conn_global": (r0 + conn_local[0], c0 + conn_local[1]),
+        "sides": sides,
+        "role": _role_from_sides(sides),
+    }
