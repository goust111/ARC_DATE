+        final_rect = (final_r, final_c, final_r + pair["moving_output_patch"].shape[0] - 1, final_c + pair["moving_output_patch"].shape[1] - 1)
+        for r, c in choices:
+            rect = (r, c, r + mh - 1, c + mw - 1)
+            if not all(_rect_gap_ok(rect, old, 2) for old in occupied):
