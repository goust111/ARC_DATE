        area = int(_RNG.integers(*AREA_RANGE))
        comp = _make_component(area, colors[ci], bg)
        if comp["shape_key"] in used_shape_keys:
            continue
        used_shape_keys.add(comp["shape_key"])
        bottom.append(comp)
        ci += 1
    return top, bottom


