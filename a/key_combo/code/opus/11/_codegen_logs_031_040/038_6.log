+        origin = (sr + dr - conn_local[0], sc + dc - conn_local[1])
+        if grid_shape is not None and not _fits(grid_shape, rotated, origin):
+            continue
+        valid.append(
+            {
+                "rotation": k,
+                "patch": rotated,
+                "origin": origin,
+                "needed_side": needed_side,
+                "conn_local": conn_local,
+            }
+        )
