+            "stationary_side": "right",
+            "target_rotation": target_rotation,
+            "stationary_conn_local": (stationary_conn_row, stationary_patch.shape[1] - 1),
+            "moving_output_conn_local": _connector_pos(moved_patch, conn_color),
