+def _place_input_movers(pairs: list[dict], canvas: tuple[int, int]) -> bool:
+    occupied: list[tuple[int, int, int, int]] = []
+    for pair in pairs:
+        sr, sc = pair["stationary_origin"]
+        sh, sw = pair["stationary_patch"].shape
+        occupied.append((sr, sc, sr + sh - 1, sc + sw - 1))
