spec:
  grid: 11 columns (fixed); rows = 2 + num_bands * 4 - 1 (1-row margin top/bottom, 1-row bg separator between bands)
  background: 7
  template_color: 8
  num_bands: 2-4
  band_height: 3 rows (fixed) [observed]
  layout: |
    Two equal-width slots (slot_w=5) separated by 1 bg column (col 5).
    Bands are stacked vertically, each separated by 1 bg row.
    Top and bottom each have 1 bg row margin.
  left_slot_template:
    structure: each row is a left-anchored prefix of template_color (8); remaining cells are bg
    prefix_length: 1-4 per row (always >=1 and <= slot_w-1, so complement is nonempty)
    complement: the bg cells in the left slot form a right-anchored suffix per row
    uniqueness: all complement suffix-length tuples must be distinct across bands
  right_slot_source:
    structure: each row is a right-anchored suffix of a single source color; remaining cells are bg
    suffix_lengths: equal to the complement suffix-length tuple of some other band's template
    color: one distinct non-bg non-template color per band; all source colors are distinct
  matching: source[i] suffix-length tuple == complement[perm[i]] suffix-length tuple; perm is a bijection (not necessarily a derangement)
  output: clear all right-slot pixels to bg; paint each left-slot complement with its matched source color

generation_strategy:
  approach: output-first
  steps:
    1. Pick num_bands in [2,4]. Choose num_bands distinct source colors from {1..6,9} (excluding 8).
    2. Generate num_bands distinct complement suffix-length tuples, each a 3-tuple with values in [1, slot_w-1].
    3. Build a random bijection (permutation) mapping each band index to a complement index.
    4. For each band, set template prefix lengths = slot_w - complement_suffix_lengths.
       Fill left slot rows with left-anchored 8-prefix; fill right slot rows with right-anchored source color suffix
       whose lengths come from complement[perm[band_idx]].
    5. Assemble grid: 1 bg row, then bands interleaved with 1 bg separator row, then 1 bg row.
