+def _open_rect_perimeter(box: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    cells = set(_rect_perimeter(box))
+    r0, c0, r1, c1 = box
+    side = random.choice(["top", "bottom", "left", "right"])
