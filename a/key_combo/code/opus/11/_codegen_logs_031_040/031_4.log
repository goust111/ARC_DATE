+            continue
+
+        infos = [info for info in _region_infos(inp) if info["markers"]]
+        if len(infos) != frame_count:
+            continue
+
+        valid = True
+        for info in infos:
+            if info["dark_majority"] is None or info["all_majority"] is None:
+                valid = False
+                break
+            if info["dark_majority"] == info["all_majority"]:
