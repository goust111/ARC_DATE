+    for info in _region_infos(g):
+        fill_color = info["dark_majority"]
+        if fill_color is None:
+            continue
+        region = info["region"]
+        out[region[:, 0], region[:, 1]] = fill_color
+        filled[region[:, 0], region[:, 1]] = True
