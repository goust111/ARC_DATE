+        gap_len = random.choice([1, 2])
+        start = random.randint(c0 + 1, c1 - gap_len)
+        for c in range(start, start + gap_len):
+            cells.discard((row, c))
+    else:
+        col = c0 if side == "left" else c1
+        gap_len = random.choice([1, 2])
