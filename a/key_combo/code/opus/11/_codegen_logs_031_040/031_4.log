+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+    for rr in range(h):
+        for cc in (0, w - 1):
+            if passable[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+    for cc in range(w):
+        for rr in (0, h - 1):
+            if passable[rr, cc] and not outside[rr, cc]:
+                outside[rr, cc] = True
+                q.append((rr, cc))
+
+    while q:
+        rr, cc = q.popleft()
+        for dr, dc in N4:
+            nr, nc = rr + dr, cc + dc
