+        return None
+    if expected.shape[0] < 4 or expected.shape[1] < 4:
+        return None
+    if len(set(map(int, expected.flat))) < 3:
+        return None
+
+    if not _validate_scene(
+        inp,
+        expected,
+        tile_h=tile_h,
+        tile_w=tile_w,
+        visible=visible,
+        hidden=hidden,
+        occ_bbox=occ_bbox,
+    ):
+        return None
+    return inp
