+
+
+def _table_layout() -> tuple[np.ndarray, list[dict], int, int, int]:
+    bands = random.choice([3, 4])
+    cell_size = random.choice([3, 4])
+    table_h = bands * cell_size + (bands + 1)
+    table_w = bands * cell_size + (bands + 1)
