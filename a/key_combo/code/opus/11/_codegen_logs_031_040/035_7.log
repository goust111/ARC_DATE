+
+def _path_coords(src_col: int, end_r: int, end_c: int) -> set[tuple[int, int]]:
+    coords = {(r, src_col) for r in range(end_r + 1)}
+    for c in range(min(src_col, end_c), max(src_col, end_c) + 1):
+        coords.add((end_r, c))
