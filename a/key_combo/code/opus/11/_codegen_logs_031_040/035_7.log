+def _cell_crossings(paths: list[dict], cells: list[dict]) -> dict[int, list[int]]:
+    crossed: dict[int, list[int]] = {cell["id"]: [] for cell in cells}
+    for cell in cells:
+        for path in paths:
+            hit = any(
+                cell["r0"] <= r <= cell["r1"] and cell["c0"] <= c <= cell["c1"]
+                for r, c in path["coords"]
