def _gen_build_frames(k: int, n: int) -> list[Frame] | None:
    for _ in range(FRAME_BUILD_ATTEMPTS):
        frames = [INITIAL_FRAME]
        for _ in range(k - 1):
            added = False
            for _ in range(FRAME_LINK_ATTEMPTS):
