def _gen_red_count(g: np.ndarray) -> int:
    return int(np.count_nonzero(g == GEN_RED))


def _gen_eligible_dot_centers(
    g: np.ndarray, frames: list[Frame]
) -> list[tuple[int, int]]:
    centers: list[tuple[int, int]] = []
    for r, c, h, w in frames:
