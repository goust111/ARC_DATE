    min_pairs, max_pairs = _GEN_PAIR_COUNT_RANGE
    pair_count = random.randint(min_pairs, min(max_pairs, total_pixels // 2))
    occupied: set[tuple[int, int]] = set()
    cells: list[tuple[int, int]] = []

