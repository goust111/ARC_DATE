        shifted = _shift_group(group, bg, dr)
        assert out[prev_right_row, c - 1] != bg
        assert shifted[prev_right_row, 0] != bg
        out[:, c : c + group.shape[1]] = shifted
        prev_right_row = _endpoint_row(shifted, bg, "right")
        c += group.shape[1]

    return out

