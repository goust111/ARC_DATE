def _gen_draw_frame(g: np.ndarray, frame: Frame) -> None:
    r, c, h, w = frame
    g[r, c : c + w] = GEN_RED
    g[r + h - 1, c : c + w] = GEN_RED
    g[r : r + h, c] = GEN_RED
    g[r : r + h, c + w - 1] = GEN_RED


