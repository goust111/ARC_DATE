        r = cr + dr
        c = cc + dc
        while in_bounds(g.shape, r, c):
            assert int(out[r, c]) == bg, "diagonal ray must cross only background"
            out[r, c] = Color.BLUE
            r += dr
            c += dc

    cardinal_pattern = (Color.TEAL, Color.TEAL, Color.YELLOW)
