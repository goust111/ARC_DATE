    r0, c0, r1, c1 = b
    assert (r1 - r0, c1 - c0) == (2, 2), "red plus must have a 3x3 bounding box"

    cr = r0 + 1
    cc = c0 + 1
    expected = {
        (cr, cc),
        (cr - 1, cc),
        (cr + 1, cc),
        (cr, cc - 1),
        (cr, cc + 1),
    }
    assert set(map(tuple, coords)) == expected, "red foreground must be a plus shape"
    return cr, cc


