+    _paint_edge_rows(grid, trigger_rows, edge_only_rows)
+    _insert_blockers(grid, trigger_rows, scene)
+    _add_fillers(grid, trigger_rows)
+
+    if not _validate_example(grid):
+        return None
+    return grid
