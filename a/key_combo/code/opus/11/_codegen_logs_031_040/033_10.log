+        return False
+
+    for rr, cc in np.argwhere(yellow_mask):
+        if int(np.concatenate([grid, grid], axis=1)[rr, cc]) != BG:
+            return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = int(_RNG.integers(MIN_H, MAX_H + 1))
+    width = int(_RNG.integers(MIN_W, MAX_W + 1))
