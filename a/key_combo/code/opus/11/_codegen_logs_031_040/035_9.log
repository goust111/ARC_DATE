+    grid[rows[1], seed_cols[0]] = sequence[1]
+    grid[rows[2], seed_cols[1]] = sequence[2]
+    grid[rows[3], seed_cols[1]] = sequence[3]
+    return grid
+
+
+def _make_horizontal_case() -> np.ndarray:
+    grid = _make_vertical_case().T
