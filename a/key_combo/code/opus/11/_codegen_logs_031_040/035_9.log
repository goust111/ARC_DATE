+
+
+def _extract_seed_pattern(grid: np.ndarray, layout: str, corridor: tuple[int, int]) -> dict:
+    groups: dict[int, dict[int, int]] = defaultdict(dict)
+    for r, c in np.argwhere(np.isin(grid, [3, 4])):
+        r = int(r)
+        c = int(c)
+        color = int(grid[r, c])
