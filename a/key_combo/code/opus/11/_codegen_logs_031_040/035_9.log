+        coord = r if layout == "vertical" else c
+        if color in groups[key]:
+            raise AssertionError("each seed line can contain only one green and one yellow")
+        groups[key][color] = coord
+    if len(groups) != 2:
+        raise AssertionError("expected two seed pairs")
