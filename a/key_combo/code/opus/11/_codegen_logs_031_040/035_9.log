+        rr = center[0] + 2 * stem[0]
+        cc = center[1] + 2 * stem[1]
+        axis_pos = cc if layout == "vertical" else rr
+        run_idx = _run_index_for(runs, axis_pos)
+        target_runs.append(run_idx)
+        run = runs[run_idx]
+        if layout == "vertical":
+            out[:, run["start"] : run["end"] + 1] = source_color
+        else:
