            else:
                grid[rs, cs] = _gen_random_tile()

    if np.array_equal(main(grid), output):
        return grid
    return None


def generate_input() -> np.ndarray:
    for _ in range(GEN_RETRIES):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate a valid 6d0160f0 input")

