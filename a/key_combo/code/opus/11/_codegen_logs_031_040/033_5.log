+    assert np.array_equal(out[row_seps, :], inp[row_seps, :])
+    assert np.array_equal(out[:, col_seps], inp[:, col_seps])
+    assert np.array_equal(out[inp == GREEN], inp[inp == GREEN])
+    assert np.array_equal(out[inp == RED], inp[inp == RED])
+    return True
+
