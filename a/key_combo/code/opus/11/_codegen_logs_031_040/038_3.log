+    bands = [g[:s0], g[s0 + 1 : s1], g[s1 + 1 :]]
+    assert all(np.all(band != SEP) for band in bands), "separator color must not appear inside bands"
+    return bands
+
+
+def _masks_from_bands(bands: list[np.ndarray]) -> list[np.ndarray]:
