0177: def _gen_marker_components_rectangular(mask: np.ndarray) -> bool:
0178:     for coords in components_mask(mask, connectivity=4):
0179:         r0, c0 = np.min(coords, axis=0)
0180:         r1, c1 = np.max(coords, axis=0)
0181:         if int(np.count_nonzero(mask[r0 : r1 + 1, c0 : c1 + 1])) != int(
0182:             (r1 - r0 + 1) * (c1 - c0 + 1)
0183:         ):
0184:             return False
0185:     return True
