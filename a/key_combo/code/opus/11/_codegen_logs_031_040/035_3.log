0183: 
0184:         pair_candidates = [
0185:             p for p in candidates if _gen_orbit_weight(p[1], w) == MIRROR_ORBIT_PAIR_WEIGHT
0186:         ]
0187:         single_candidates = [
0188:             p for p in candidates if _gen_orbit_weight(p[1], w) == MIRROR_ORBIT_SINGLE_WEIGHT
0189:         ]
0190:         remaining = target - area
0191:         if remaining % MIRROR_ORBIT_PAIR_WEIGHT == 0 and pair_candidates:
0192:             nr, nc = random.choice(pair_candidates)
0193:         elif single_candidates:
0194:             nr, nc = random.choice(single_candidates)
0195:         else:
0196:             nr, nc = random.choice(list(candidates))
0197:         half[nr, nc] = True
0198:     return True
