0123: def _gen_append_segment(path, r0, c0, r1, c1):
0124:     if r0 == r1:
0125:         step = 1 if c1 >= c0 else -1
0126:         cells = [(r0, c) for c in range(c0, c1 + step, step)]
0127:     else:
0128:         step = 1 if r1 >= r0 else -1
0129:         cells = [(r, c0) for r in range(r0, r1 + step, step)]
0130:     if path and cells and path[-1] == cells[0]:
0131:         cells = cells[1:]
0132:     path.extend(cells)
