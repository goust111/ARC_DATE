+        for _row in range(1, h):
+            lo = max(1, widths[-1] - 1)
+            hi = min(upper, widths[-1] + 1)
+            widths.append(random.randint(lo, hi))
+        candidate_area = sum(w - widths[r] for r in range(1, h))
+        if candidate_area >= max(3, math.ceil(0.2 * h * w)):
+            return widths
+    return None
