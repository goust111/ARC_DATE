0023: def _find_source(
0024:     g: np.ndarray, bg: int
0025: ) -> tuple[int, int, np.ndarray]:
0026:     source_candidates: list[tuple[int, int, np.ndarray]] = []
0027: 
0028:     for comp in find_components(g, bg=bg, connectivity=4, monochromatic=True):
0029:         fill_color = int(comp["color"])
0030:         r0, c0, r1, c1 = map(int, comp["bbox"])
0031:         region = g[r0 : r1 + 1, c0 : c1 + 1]
0032:         colors = set(map(int, np.unique(region)))
0033:         marker_colors = colors - {bg, fill_color}
0034: 
0035:         if bg in colors or len(marker_colors) != 1:
0036:             continue
0037:         if int(np.count_nonzero(region == fill_color)) != int(comp["area"]):
0038:             continue
0039: 
0040:         marker_color = marker_colors.pop()
0041:         marker_mask = region == marker_color
0042:         source_candidates.append((fill_color, marker_color, marker_mask))
0043: 
0044:     assert len(source_candidates) == 1, "expected one filled rectangle with embedded markers"
0045:     return source_candidates[0]
