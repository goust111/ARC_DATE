0135: def _gen_path_from_profiles(top, bottom):
0136:     width = len(top)
0137:     path = []
0138:     _gen_append_segment(path, top[0], 0, top[0], 0)
0139:     for c in range(width - 1):
0140:         _gen_append_segment(path, top[c], c, top[c], c + 1)
0141:         _gen_append_segment(path, top[c], c + 1, top[c + 1], c + 1)
0142:     _gen_append_segment(path, top[-1], width - 1, bottom[-1], width - 1)
0143:     for c in range(width - 1, 0, -1):
0144:         _gen_append_segment(path, bottom[c], c, bottom[c], c - 1)
0145:         _gen_append_segment(path, bottom[c], c - 1, bottom[c - 1], c - 1)
0146:     _gen_append_segment(path, bottom[0], 0, top[0], 0)
0147:     if path and path[-1] == path[0]:
0148:         path.pop()
0149:     return path
