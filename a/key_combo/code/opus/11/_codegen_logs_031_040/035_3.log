0181: # Masks / coords
0182: # =============================================================================
0183: 
0184: 
0185: def coords_where(mask: np.ndarray) -> np.ndarray:
0186:     """Return coords where mask is True as an (N,2) array of (r,c)."""
0187:     return np.argwhere(mask)
