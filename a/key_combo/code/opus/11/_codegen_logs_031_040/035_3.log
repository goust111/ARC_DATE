0017: def main(grid: np.ndarray) -> np.ndarray:
0018:     """
0019:     Copy the interior motif from the unique patterned frame into every same-sized frame, recolored to each frame, and remove all other frames.
0020: 
0021:     Input structure
0022:     - The grid contains a uniform background and several one-cell-thick rectangular frames.
0023:     - Each foreground color marks one frame, and exactly one frame also has same-colored interior motif pixels.
0024:     Rule
0025:     - Use the patterned frame's outer height, width, and interior motif as the template.
0026:     - Redraw only frames whose outer dimensions match the template frame, using each frame's own color for both the border and copied motif.
0027:     - Leave frames with other dimensions as background.
0028:     Key insight
0029:     - The unique non-hollow frame supplies the motif; matching outer dimensions distinguish true target frames from distractor frames.
0030:     """
0031:     g = np.asarray(grid, dtype=int)
0032:     bg = get_bg(g)
0033: 
0034:     frames = []
0035:     for color in colors_present(g, exclude={bg}):
0036:         color_mask = g == color
0037:         box = bbox(color_mask)
0038:         assert box is not None
0039:         r0, c0, r1, c1 = box
0040:         window = g[r0 : r1 + 1, c0 : c1 + 1]
0041:         h, w = window.shape
0042:         assert h >= 3 and w >= 3
0043:         assert np.all((window == color) | (window == bg))
0044: 
0045:         local_mask = window == color
0046:         border = _border_mask(h, w)
0047:         assert np.all(local_mask[border])
0048:         interior = local_mask & ~border
0049:         frames.append((color, box, (h, w), border, interior))
0050: 
0051:     patterned = [frame for frame in frames if np.any(frame[4])]
0052:     assert len(patterned) == 1
0053:     _, _, template_shape, template_border, template_interior = patterned[0]
0054:     template = template_border | template_interior
0055: 
0056:     out = np.full_like(g, bg)
0057:     for color, box, shape, _, _ in frames:
0058:         if shape != template_shape:
0059:             continue
0060:         r0, c0, r1, c1 = box
0061:         target = out[r0 : r1 + 1, c0 : c1 + 1]
0062:         target[template] = color
0063: 
0064:     return out
