0209: def _gen_symmetric_sprite(color: int) -> np.ndarray | None:
0210:     h, w = _gen_pick_dims()
0211:     q = (w + 1) // 2
0212:     half = np.zeros((h, q), dtype=bool)
0213: 
0214:     bridge = (random.randrange(h), q - 1)
0215:     anchors = [
0216:         (random.randrange(h), 0),
0217:         (0, random.randrange(q)),
0218:         (h - 1, random.randrange(q)),
0219:     ]
0220:     for anchor in anchors:
0221:         _gen_mark_half_path(half, bridge, anchor)
0222: 
0223:     lo, hi = _gen_area_bounds(h, w)
0224:     base = _gen_half_area(half, w)
0225:     targets = [
0226:         a
0227:         for a in range(max(lo, base), hi + 1)
0228:         if (a - base) % MIRROR_ORBIT_PAIR_WEIGHT == 0
0229:     ]
0230:     if not targets:
0231:         return None
0232: 
0233:     target = random.choice(targets)
0234:     if not _gen_grow_half(half, w, target):
0235:         return None
0236: 
0237:     mask = _gen_full_from_half(half, w)
0238:     if not np.array_equal(mask, np.fliplr(mask)):
0239:         return None
0240:     if not is_contiguous(mask.astype(int), background=0, connectivity=8):
0241:         return None
