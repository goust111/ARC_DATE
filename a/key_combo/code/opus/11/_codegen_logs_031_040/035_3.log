1506:                 color_palate=color_palate,
1507:                 connectivity=connectivity,
1508:                 background=bg,
1509:                 no_repeated_colors=no_repeated_colors,
1510:             )
1511:     elif symmetry_type == "diagonal":
1512:         if diagonal_orientation:
1513:             grid = np.flipud(grid)
1514:             grid = apply_diagonal_symmetry(grid, background=bg)
1515:             grid = np.flipud(grid)
1516:         else:
1517:             grid = apply_diagonal_symmetry(grid, background=bg)
1518: 
1519:     return grid
