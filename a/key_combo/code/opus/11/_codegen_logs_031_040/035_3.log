0096: def main(grid: np.ndarray) -> np.ndarray:
0097:     """
0098:     Fill each empty rectangle whose marker pixels match a transformed copy of the source sprite's marker mask.
0099: 
0100:     Input structure
0101:     - A dominant background contains one solid rectangular source sprite made from a fill color and embedded marker-color pixels.
0102:     - Additional marker-color pixels are scattered elsewhere, and some groups form transformed copies of the source marker mask.
0103: 
0104:     Rule
0105:     - Find the source rectangle as the unique fill-color component whose bbox is fully occupied by fill and marker colors.
0106:     - Consider all unique rotations and reflections of the source rectangle's marker mask.
0107:     - Wherever a transformed marker mask exactly overlays marker-color pixels and every other in-bounds cell of that rectangle is background, paint those background cells with the fill color.
0108: 
0109:     Key insight
0110:     The scattered marker pixels identify empty stamp locations by reproducing the source sprite's internal marker pattern.
0111:     """
0112:     g = np.asarray(grid, dtype=int)
0113:     bg = int(get_bg(g))
0114:     fill_color, marker_color, marker_mask = _find_source(g, bg)
0115: 
0116:     out = g.copy()
0117:     for fill_cells in _matching_fill_cells(g, bg, marker_color, marker_mask):
0118:         for r, c in fill_cells:
0119:             out[r, c] = fill_color
0120:     return out
0121: 
0122: # --------------- generator (o5x) ---------------
0123: 
0124: # Canvas and fixed colors.
0125: GRID_SIZE = 23
0126: BG_COLOR = 0
0127: FILL_COLOR = 1
0128: MARKER_COLOR = 4
0129: 
0130: # Source rectangle and interior marker constraints.
0131: SOURCE_H_MIN = 3
0132: SOURCE_H_MAX_EXCL = 6
0133: SOURCE_W_MIN = 4
0134: SOURCE_W_MAX_EXCL = 6
0135: SOURCE_MARK_MIN = 2
0136: SOURCE_MARK_MAX = 3
0137: SOURCE_MIN_UNIQUE_TRANSFORMS = 2
0138: 
0139: # Generated match slots, distractors, and retry budget.
0140: MATCH_COUNT_MIN = 1
0141: MATCH_COUNT_MAX_EXCL = 6
0142: DISTRACTOR_COUNT_MIN = 11
0143: DISTRACTOR_COUNT_MAX_EXCL = 36
0144: GEN_RETRY_LIMIT = 300
0145: 
