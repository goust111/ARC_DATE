+BG = 0
+FILL = 1
+MARK = 2
+
+GRID_ROWS = (18, 24)
+GRID_COLS = (18, 24)
+RECT_CHOICES = ((3, 4), (3, 5), (4, 4), (4, 5))
+MATCH_COUNT_CHOICES = (2, 3)
+DISTRACTOR_COUNT_CHOICES = (1, 2)
+PLACEMENT_GAP = 1
+GEN_ATTEMPTS = 500
