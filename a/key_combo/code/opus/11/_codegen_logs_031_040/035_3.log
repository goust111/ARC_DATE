0048: def _matching_fill_cells(
0049:     g: np.ndarray, bg: int, marker_color: int, marker_mask: np.ndarray
0050: ) -> list[frozenset[tuple[int, int]]]:
0051:     H, W = map(int, g.shape)
0052:     matches: list[frozenset[tuple[int, int]]] = []
0053:     seen: set[frozenset[tuple[int, int]]] = set()
0054: 
0055:     for transformed in _unique_transforms(marker_mask):
0056:         h, w = map(int, transformed.shape)
0057:         marker_total = int(np.count_nonzero(transformed))
0058:         assert marker_total > 0, "source marker mask must be nonempty"
0059: 
0060:         for r0 in range(1 - h, H):
0061:             for c0 in range(1 - w, W):
0062:                 marker_hits = 0
0063:                 fill_cells: list[tuple[int, int]] = []
0064:                 ok = True
0065: 
0066:                 for rr in range(h):
0067:                     for cc in range(w):
0068:                         r = r0 + rr
0069:                         c = c0 + cc
0070:                         if not (0 <= r < H and 0 <= c < W):
0071:                             continue
0072: 
0073:                         if transformed[rr, cc]:
0074:                             if int(g[r, c]) != marker_color:
0075:                                 ok = False
0076:                                 break
0077:                             marker_hits += 1
0078:                         else:
0079:                             if int(g[r, c]) != bg:
0080:                                 ok = False
0081:                                 break
0082:                             fill_cells.append((r, c))
0083:                     if not ok:
0084:                         break
0085: 
0086:                 if ok and marker_hits == marker_total and fill_cells:
0087:                     frozen = frozenset(fill_cells)
0088:                     if frozen not in seen:
0089:                         seen.add(frozen)
0090:                         matches.append(frozen)
0091: 
0092:     assert matches, "expected at least one empty rectangle matching the marker mask"
0093:     return matches
