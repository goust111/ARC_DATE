0155: def _gen_mark_half_path(half: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> None:
0156:     r, c = a
0157:     tr, tc = b
0158:     half[r, c] = True
0159:     while (r, c) != (tr, tc):
0160:         moves = []
0161:         if r < tr:
0162:             moves.append((r + 1, c))
0163:         elif r > tr:
0164:             moves.append((r - 1, c))
0165:         if c < tc:
0166:             moves.append((r, c + 1))
0167:         elif c > tc:
0168:             moves.append((r, c - 1))
0169:         r, c = random.choice(moves)
0170:         half[r, c] = True
