0633: # =============================================================================
0634: # Motion / interaction (translate, collision/contact)
0635: # =============================================================================
0636: 
0637: 
0638: def translate(obj: np.ndarray, dr: int, dc: int, *, background: int = Color.BLACK) -> np.ndarray:
0639:     """Translate a full-grid object by (dr,dc), filling empty with background."""
0640:     dr = int(dr)
0641:     dc = int(dc)
0642:     bg = int(background)
0643:     H, W = obj.shape
0644:     out = np.full_like(obj, bg)
0645:     rr, cc = np.nonzero(obj != bg)
0646:     rr2 = rr + dr
0647:     cc2 = cc + dc
0648:     inb = (0 <= rr2) & (rr2 < H) & (0 <= cc2) & (cc2 < W)
0649:     out[rr2[inb], cc2[inb]] = obj[rr[inb], cc[inb]]
0650:     return out
0651: 
0652: 
0653: def collision(
0654:     *,
0655:     object1: np.ndarray,
0656:     object2: np.ndarray,
0657:     r1: int = 0,
0658:     c1: int = 0,
0659:     r2: int = 0,
0660:     c2: int = 0,
0661:     background: int = Color.BLACK,
0662: ) -> bool:
0663:     """Return True iff non-background pixels overlap with object2 placed at (r2,c2) relative to object1 at (r1,c1)."""
0664:     bg = int(background)
0665:     a = object1
0666:     b = object2
0667:     H1, W1 = a.shape
0668:     H2, W2 = b.shape
0669: 
0670:     dr = int(r2) - int(r1)
0671:     dc = int(c2) - int(c1)
0672: 
0673:     ra0 = max(0, dr)
0674:     ca0 = max(0, dc)
0675:     ra1 = min(H1, dr + H2)
0676:     ca1 = min(W1, dc + W2)
0677:     if ra0 >= ra1 or ca0 >= ca1:
0678:         return False
0679: 
0680:     rb0 = ra0 - dr
0681:     cb0 = ca0 - dc
0682:     rb1 = rb0 + (ra1 - ra0)
0683:     cb1 = cb0 + (ca1 - ca0)
0684:     return bool(((a[ra0:ra1, ca0:ca1] != bg) & (b[rb0:rb1, cb0:cb1] != bg)).any())
0685: 
0686: 
0687: def contact(
0688:     *,
0689:     object1: np.ndarray,
0690:     object2: np.ndarray,
0691:     r1: int = 0,
0692:     c1: int = 0,
0693:     r2: int = 0,
0694:     c2: int = 0,
0695:     background: int = Color.BLACK,
0696:     connectivity: int = 4,
0697: ) -> bool:
0698:     """Return True iff objects touch (share edge/diagonal) or overlap."""
0699:     bg = int(background)
0700:     struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
0701:     m2 = (object2 != bg)
0702:     m2d = ndimage.binary_dilation(m2, structure=struct)
0703:     return collision(
0704:         object1=(object1 != bg).astype(int),
0705:         object2=m2d.astype(int),
0706:         r1=r1,
0707:         c1=c1,
0708:         r2=r2,
0709:         c2=c2,
0710:         background=0,
0711:     )
0712: 
