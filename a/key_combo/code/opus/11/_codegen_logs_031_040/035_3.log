1397: def is_contiguous(bitmask: np.ndarray, background: int = Color.BLACK, connectivity: int = 4) -> bool:
1398:     """Return True iff the mask contains exactly one connected component."""
1399:     struct = STRUCT4 if int(connectivity) == 4 else STRUCT8
1400:     _lab, n = label(bitmask != int(background), structure=struct)
1401:     return int(n) == 1
