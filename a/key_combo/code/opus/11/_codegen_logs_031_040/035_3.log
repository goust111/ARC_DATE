1434:         diagonal_orientation = True
1435:     elif symmetry_type == "horizontal":
1436:         r, c = random.randint(0, n - 1), m // 2
1437:         diagonal_orientation = True
1438:     elif symmetry_type == "vertical":
1439:         r, c = n // 2, random.randint(0, m - 1)
1440:         diagonal_orientation = True
1441:     elif symmetry_type == "diagonal":
1442:         diagonal_orientation = random.choice([True, False])
1443:         r = random.randint(0, n - 1)
1444:         c = r if diagonal_orientation else n - 1 - r
1445:     elif symmetry_type == "mirror":
1446:         original_n, original_m = n, m
1447:         n, m = int(n / 2 + 0.5), int(m / 2 + 0.5)
1448:         r, c = random.randint(0, n - 1), random.randint(0, m - 1)
1449:         grid = np.full((n, m), bg)
1450:         diagonal_orientation = True
1451:     elif symmetry_type == "radial":
1452:         if n != m:
1453:             raise ValueError("Radial symmetry requires a square grid.")
1454:         original_length = n
1455:         n, m = int(n / 2 + 0.5), int(m / 2 + 0.5)
1456:         r, c = n - 1, m - 1
1457:         diagonal_orientation = True
1458:     else:
1459:         raise ValueError(f"Invalid symmetry type {symmetry_type}.")
1460: 
1461:     if int(connectivity) == 4:
1480:         if 0 <= r2 < n and 0 <= c2 < m:
1481:             r, c = r2, c2
1482: 
1483:     if symmetry_type in ("horizontal", "vertical"):
1484:         grid = apply_symmetry(grid, symmetry_type, background=bg)
1485:     elif symmetry_type == "radial":
1486:         output = np.full((original_length, original_length), bg)
1487:         paste(output, grid, 0, 0, transparent=bg)
1488:         for _ in range(3):
1489:             paste(output, np.rot90(output), 0, 0, transparent=bg)
1490:         grid = output
1491:     elif symmetry_type == "mirror":
1492:         output = np.full((original_n, original_m), bg)
1493:         output[:n, :m] = grid
1494:         dx = 0 if original_n % 2 == 0 else -1
1495:         dy = 0 if original_m % 2 == 0 else -1
1496:         output[n + dx :, :m] = np.flipud(grid)
1497:         output[:n, m + dy :] = np.fliplr(grid)
1498:         output[n + dx :, m + dy :] = np.flipud(np.fliplr(grid))
1499:         grid = output
1500:         if not is_contiguous(grid, background=bg, connectivity=connectivity):
1501:             return generate_sprite(
1502:                 n=original_n,
