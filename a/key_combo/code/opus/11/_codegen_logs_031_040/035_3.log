0173: def _gen_grow_half(half: np.ndarray, w: int, target: int) -> bool:
0174:     while _gen_half_area(half, w) < target:
0175:         area = _gen_half_area(half, w)
0176:         candidates = {
0177:             (r, c)
0178:             for r, c in _gen_frontier_cells(half)
0179:             if _gen_orbit_weight(c, w) <= target - area
0180:         }
0181:         if not candidates:
