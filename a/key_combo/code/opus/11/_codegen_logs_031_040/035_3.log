1363: def apply_symmetry(sprite: np.ndarray, symmetry_type: str, background: int = Color.BLACK) -> np.ndarray:
1364:     """Apply horizontal/vertical mirror symmetry within sprite bounds."""
1365:     bg = int(background)
1366:     n, m = sprite.shape
1367:     if symmetry_type == "horizontal":
1368:         for c in range(m):
1369:             for r in range(n // 2):
1370:                 sprite[r, c] = sprite[n - 1 - r, c] = sprite[r, c] if sprite[r, c] != bg else sprite[n - 1 - r, c]
1371:     elif symmetry_type == "vertical":
1372:         for r in range(n):
1373:             for c in range(m // 2):
1374:                 sprite[r, c] = sprite[r, m - 1 - c] = sprite[r, c] if sprite[r, c] != bg else sprite[r, m - 1 - c]
1375:     else:
1376:         raise ValueError(f"Invalid symmetry type {symmetry_type}.")
1377:     return sprite
1378: 
1379: 
1380: def apply_diagonal_symmetry(sprite: np.ndarray, background: int = Color.BLACK) -> np.ndarray:
1381:     """Apply diagonal symmetry within bounds (square sprite only)."""
1382:     bg = int(background)
1383:     n, m = sprite.shape
1384:     if n != m:
1385:         raise ValueError("Diagonal symmetry requires a square sprite.")
1386:     for r in range(n):
1387:         for c in range(r + 1, m):
1388:             col = bg
1389:             if sprite[c, r] != bg:
1390:                 col = int(sprite[c, r])
1391:             if sprite[r, c] != bg:
1392:                 col = int(sprite[r, c])
1393:             sprite[r, c] = sprite[c, r] = col
1394:     return sprite
1395: 
