+        ok = True
+        marker_count = 0
+        for rr in range(r0, r1 + 1):
+            for cc in range(c0, c1 + 1):
+                if (rr, cc) in union:
+                    continue
+                if int(grid[rr, cc]) != MARK:
+                    ok = False
+                    break
