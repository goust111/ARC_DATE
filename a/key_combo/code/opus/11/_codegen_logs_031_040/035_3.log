+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    for k in range(4):
+        rot = np.rot90(mask, k)
+        for transformed in (rot, np.fliplr(rot)):
+            key = (tuple(map(int, transformed.shape)), transformed.astype(np.uint8).tobytes())
+            if key in seen:
