0147: def _gen_mask_from_cells(shape: tuple[int, int], cells) -> np.ndarray:
0148:     mask = np.zeros(shape, dtype=bool)
0149:     for r, c in cells:
0150:         mask[r, c] = True
0151:     return mask
0152: 
0153: 
0154: def _gen_source_mask() -> np.ndarray:
0155:     h = int(np.random.randint(SOURCE_H_MIN, SOURCE_H_MAX_EXCL))
0156:     w = int(np.random.randint(SOURCE_W_MIN, SOURCE_W_MAX_EXCL))
0157:     interior = [(r, c) for r in range(1, h - 1) for c in range(1, w - 1)]
0158: 
0159:     by_count = {}
0160:     for n_marks in range(SOURCE_MARK_MIN, min(SOURCE_MARK_MAX, len(interior)) + 1):
0161:         choices = []
0162:         for combo in combinations(interior, n_marks):
0163:             mask = _gen_mask_from_cells((h, w), combo)
0164:             if _gen_marker_components_rectangular(mask) and len(
0165:                 _unique_transforms(mask)
0166:             ) >= SOURCE_MIN_UNIQUE_TRANSFORMS:
0167:                 choices.append(combo)
0168:         if choices:
0169:             by_count[n_marks] = choices
0170: 
0171:     counts = sorted(by_count)
0172:     n_marks = counts[int(np.random.randint(0, len(counts)))]
0173:     combo = by_count[n_marks][int(np.random.randint(0, len(by_count[n_marks])))]
0174:     return _gen_mask_from_cells((h, w), combo)
0175: 
