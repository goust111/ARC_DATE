+
+def _rectangle_dims(total_area: int, pieces: list[dict]) -> list[tuple[int, int]]:
+    max_h = max(piece["scaled"].shape[0] for piece in pieces)
+    max_w = max(piece["scaled"].shape[1] for piece in pieces)
