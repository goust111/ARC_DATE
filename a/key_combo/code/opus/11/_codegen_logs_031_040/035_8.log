+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+CONTOUR = 7
+PALETTE = (1, 2, 3)
+
+
+MOTIFS = {
+    "L3_A": ((0, 0), (1, 0), (1, 1)),
+    "L3_B": ((0, 0), (0, 1), (1, 1)),
+    "L4_A": ((0, 0), (0, 1), (0, 2), (1, 0)),
+    "L4_B": ((0, 0), (0, 1), (1, 1), (2, 1)),
+    "L4_C": ((0, 2), (1, 0), (1, 1), (1, 2)),
+}
+
+
+TEMPLATES = [
+    {
+        "weight": 1,
+        "size": (4, 6),
+        "pieces": [
+            {"motif": "L3_A", "scale": 2, "offset": (0, 0)},
+            {"motif": "L3_B", "scale": 2, "offset": (0, 2)},
+        ],
+    },
+    {
+        "weight": 1,
+        "size": (6, 9),
+        "pieces": [
+            {"motif": "L3_A", "scale": 3, "offset": (0, 0)},
+            {"motif": "L3_B", "scale": 3, "offset": (0, 3)},
+        ],
+    },
+    {
+        "weight": 1,
+        "size": (8, 12),
+        "pieces": [
+            {"motif": "L3_A", "scale": 4, "offset": (0, 0)},
+            {"motif": "L3_B", "scale": 4, "offset": (0, 4)},
+        ],
+    },
+    {
+        "weight": 1,
+        "size": (4, 8),
+        "pieces": [
+            {"motif": "L4_A", "scale": 2, "offset": (0, 0)},
+            {"motif": "L4_C", "scale": 2, "offset": (0, 2)},
+        ],
+    },
+    {
+        "weight": 1,
+        "size": (6, 12),
+        "pieces": [
+            {"motif": "L4_A", "scale": 3, "offset": (0, 0)},
+            {"motif": "L4_C", "scale": 3, "offset": (0, 3)},
+        ],
+    },
+    {
+        "weight": 3,
