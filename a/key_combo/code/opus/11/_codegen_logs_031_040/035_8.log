+def _factor_pairs(area: int, min_h: int, min_w: int) -> list[tuple[int, int]]:
+    pairs = []
+    for h in range(1, area + 1):
+        if area % h:
+            continue
+        w = area // h
+        if h >= min_h and w >= min_w:
+            pairs.append((h, w))
+        if w >= min_h and h >= min_w and h != w:
