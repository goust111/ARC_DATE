+from __future__ import annotations
+
+import math
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+CONTOUR = 7
+PALETTE = (1, 2, 3)
+
+
+MOTIFS = {
+    "L3_A": ((0, 0), (1, 0), (1, 1)),
+    "L3_B": ((0, 0), (0, 1), (1, 1)),
