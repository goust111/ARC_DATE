+        patches = [_region_patch(piece) for piece in pieces]
+        inp = _place_patches(patches)
+        if inp is None:
+            continue
+        if _validate_case(inp, expected_out, scales):
+            return inp
+    raise RuntimeError("failed to generate a valid puzzle instance")

