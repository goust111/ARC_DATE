+    assert coords, f"missing color {color}"
+    r0, c0, r1, c1 = _bbox(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    for r, c in coords:
+        out[r - r0, c - c0] = color
+    return out
