+def _factor_pairs(area: int, min_h: int, min_w: int) -> list[tuple[int, int]]:
+    pairs = []
+    for h in range(1, area + 1):
+        if area % h:
+            continue
+        w = area // h
+        if h >= min_h and w >= min_w:
+            pairs.append((h, w))
+        if w >= min_h and h >= min_w and h != w:
+            pairs.append((w, h))
+    pairs = [pair for pair in set(pairs) if max(pair) <= 6 and min(pair) >= 3]
+    if not pairs:
+        pairs = [(h, w) for h, w in set(pairs) if h >= min_h and w >= min_w]
+    return sorted(set(pairs), key=lambda pair: (abs(pair[0] - pair[1]), max(pair)))
