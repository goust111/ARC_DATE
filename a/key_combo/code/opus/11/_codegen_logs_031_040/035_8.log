+    ph, pw = sprite.shape
+    placements = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            mask = 0
+            shifted = []
+            for rr, cc in cells:
+                r = r0 + rr
+                c = c0 + cc
