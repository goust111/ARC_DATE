+    },
+    {
+        "weight": 3,
+        "size": (8, 12),
+        "pieces": [
+            {"motif": "L4_A", "scale": 4, "offset": (0, 0)},
+            {"motif": "L4_A", "scale": 2, "offset": (4, 4)},
+            {"motif": "L4_C", "scale": 2, "offset": (4, 6)},
