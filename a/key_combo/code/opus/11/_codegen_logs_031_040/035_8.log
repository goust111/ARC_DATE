+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(coords)
+    return comps
+
+
+def _scale_sprite(sprite: np.ndarray, factor: int) -> np.ndarray:
+    return np.kron(sprite, np.ones((factor, factor), dtype=int))
+
+
+def _sprite_from_coords(coords: tuple[tuple[int, int], ...], color: int) -> np.ndarray:
+    h = max(r for r, _ in coords) + 1
+    w = max(c for _, c in coords) + 1
+    sprite = np.zeros((h, w), dtype=int)
+    for r, c in coords:
+        sprite[r, c] = color
+    return sprite
