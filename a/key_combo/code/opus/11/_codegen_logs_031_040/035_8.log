+def _connected_black_after_placement(inner_h: int, inner_w: int, sprite: np.ndarray, top: int, left: int) -> bool:
+    canvas = np.zeros((inner_h, inner_w), dtype=int)
+    h, w = sprite.shape
+    patch = canvas[top : top + h, left : left + w]
+    patch[sprite != BG] = 1
+    black = canvas == 0
+    comps = _components(black)
+    return len(comps) == 1
