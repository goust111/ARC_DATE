+def _can_place_rect(rects: list[tuple[int, int, int, int]], r0: int, c0: int, h: int, w: int, gap: int) -> bool:
+    r1 = r0 + h - 1
+    c1 = c0 + w - 1
+    for rr0, cc0, rr1, cc1 in rects:
+        if not (r1 + gap < rr0 or rr1 + gap < r0 or c1 + gap < cc0 or cc1 + gap < c0):
+            return False
+    return True
+
