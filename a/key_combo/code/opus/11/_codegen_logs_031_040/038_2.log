+def _parse_scene(grid: np.ndarray) -> tuple[list[TemplateInfo], list[SourceInfo]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+    assert _most_common_value(g) == BG, "background must be black"
