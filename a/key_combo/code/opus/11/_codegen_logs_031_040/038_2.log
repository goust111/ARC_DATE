+from __future__ import annotations
+
+from collections import Counter, deque
+from dataclasses import dataclass
+import random
+
+import numpy as np
+
+
+BG = 0
+EMITTER = 7
+TEMPLATE_COLORS = (1, 5, 6, 8, 9)
+SOURCE_COLORS = (2, 3, 4)
+MAX_ATTEMPTS = 400
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
