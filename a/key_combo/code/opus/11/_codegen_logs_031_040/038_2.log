+        off_c = random.randint(1, max_off_c)
+        gap_coords = tuple(sorted((r0 + off_r + dr, c0 + off_c + dc) for dr, dc in sig))
+        bbox = (r0, c0, r0 + h - 1, c0 + w - 1)
