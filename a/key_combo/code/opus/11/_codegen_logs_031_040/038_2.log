+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords_t = tuple(sorted(coords))
+            comp = MonoComponent(color=color, coords=coords_t, bbox=_bbox(coords_t))
+            comp_id = len(components)
+            components.append(comp)
+            for coord in coords_t:
