+    if row_layout is None:
+        return None
+
+    template_colors = random.sample(TEMPLATE_COLORS, count)
+    source_colors = random.sample(SOURCE_COLORS, count)
+    grid = np.full((height, width), BG, dtype=int)
+    expected = grid.copy()
