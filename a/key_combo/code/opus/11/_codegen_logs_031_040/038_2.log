+            grid = np.pad(grid, ((0, extra), (0, 0)), constant_values=BG)
+            expected = np.pad(expected, ((0, extra), (0, 0)), constant_values=BG)
+            occupied = np.pad(occupied, ((0, extra), (0, 0)), constant_values=False)
+            height += extra
+        lane_offsets = [0, 3]
