+    color: int
+    bbox: BBox
+    gap_coords: tuple[Coord, ...]
+    gap_sig: frozenset[Coord]
+
+
+@dataclass(frozen=True)
+class PlannedSource:
+    color: int
+    coords: tuple[Coord, ...]
+    emitter: Coord
+    target_index: int
+    should_match: bool
