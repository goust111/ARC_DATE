+
+        should_match = not (target_index == 0 and no_match_left)
+        _paint_source(grid, source_colors[target_index], coords, emitter)
+        for r, c in coords:
+            occupied[r, c] = True
+        occupied[emitter] = True
+
+        sources.append(
+            PlannedSource(
