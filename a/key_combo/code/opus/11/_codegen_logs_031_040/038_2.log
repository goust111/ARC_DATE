+    parsed_templates, parsed_sources = _parse_scene(grid)
+    if len(parsed_templates) != count or len(parsed_sources) != count:
+        return None
+
+    visible_match_counts: list[int] = []
+    skip_then_match = 0
+    first_match = 0
