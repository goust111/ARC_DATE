+            if not gap_mask[rr, cc] or seen[rr, cc]:
+                continue
+            seen[rr, cc] = True
+            q: deque[Coord] = deque([(rr, cc)])
+            part: list[Coord] = []
+            while q:
+                pr, pc = q.popleft()
+                part.append((pr, pc))
+                for nr, nc in _neighbors4(pr, pc):
+                    if 0 <= nr < gap_mask.shape[0] and 0 <= nc < gap_mask.shape[1] and gap_mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
