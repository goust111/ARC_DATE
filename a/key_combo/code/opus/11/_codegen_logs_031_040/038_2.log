+def _paint_template(grid: np.ndarray, color: int, bbox: BBox, gap_coords: tuple[Coord, ...]) -> None:
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = color
+    for r, c in gap_coords:
