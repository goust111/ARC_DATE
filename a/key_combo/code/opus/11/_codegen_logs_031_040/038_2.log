+    expected = grid.copy()
+
+    templates: list[PlannedTemplate] = []
+    row_ranges: list[set[int]] = []
+    for idx, sig in enumerate(shapes):
+        sh_h, sh_w = _shape_dims(sig)
+        r0, h = row_layout[idx]
+        c0, w = col_layout[idx]
+        max_off_r = h - sh_h - 1
+        max_off_c = w - sh_w - 1
+        if max_off_r < 1 or max_off_c < 1:
