+
+    if skip_then_match < 1 or first_match < 1:
+        return None
+    if no_match_left:
+        if no_match < 1:
+            return None
+    elif no_match != 0:
+        return None
+
+    actual = main(grid)
+    if not np.array_equal(actual, expected):
+        return None
+    return grid, expected
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        built = _build_instance()
+        if built is not None:
