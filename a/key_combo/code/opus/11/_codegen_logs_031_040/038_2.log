+def _find_monochrome_components(grid: np.ndarray, ignored: set[int]) -> tuple[list[MonoComponent], dict[Coord, int]]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[MonoComponent] = []
+    coord_to_id: dict[Coord, int] = {}
