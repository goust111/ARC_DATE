+    for i in range(len(row_lines) - 1):
+        for j in range(len(col_lines) - 1):
+            out[(i, j)] = (row_lines[i] + 1, col_lines[j] + 1, row_lines[i + 1] - 1, col_lines[j + 1] - 1)
+    return out
+
