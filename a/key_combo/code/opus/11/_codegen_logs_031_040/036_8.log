+
+def _connect_red_spans(grid: np.ndarray) -> np.ndarray:
+    """Fill red row/column spans using only the original red markers as endpoints."""
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+    markers = g == RED
+
