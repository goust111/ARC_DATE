+    for i in range(len(row_lines) - 1):
+        for j in range(len(col_lines) - 1):
+            boxes.append((row_lines[i] + 1, col_lines[j] + 1, row_lines[i + 1] - 1, col_lines[j + 1] - 1))
+    return boxes
+
+
+def _box_lookup(
+    row_lines: list[int],
+    col_lines: list[int],
+) -> dict[tuple[int, int], tuple[int, int, int, int]]:
