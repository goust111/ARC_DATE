+        for comp in comps:
+            if len(comp) == 1:
+                r, c = map(int, comp[0])
+                singletons[(r, c)] = color
+
+    legends: dict[int, int] = {}
+    used_positions: set[tuple[int, int]] = set()
+    for (r, c), src in sorted(singletons.items()):
+        if src not in SRC_POOL:
+            continue
+        below = (r + 1, c)
+        if below not in singletons:
