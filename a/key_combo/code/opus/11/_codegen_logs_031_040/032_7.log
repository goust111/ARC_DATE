+SRC_POOL = (BLUE, RED, GREEN)
+TGT_POOL = (ORANGE, TEAL, MAROON)
+MAX_GENERATION_ATTEMPTS = 400
+STRUCT4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
