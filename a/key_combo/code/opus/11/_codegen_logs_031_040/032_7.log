+    row_gaps = [sep_rows[i + 1] - sep_rows[i] - 1 for i in range(len(sep_rows) - 1)]
+    col_gaps = [sep_cols[i + 1] - sep_cols[i] - 1 for i in range(len(sep_cols) - 1)]
