+    row_keep = [r for r in range(sep_rows[0] + 1, sep_rows[-1]) if r not in set(sep_rows)]
+    col_keep = [c for c in range(sep_cols[0] + 1, sep_cols[-1]) if c not in set(sep_cols)]
