 156: def _sprite_cells(apex: tuple[int, int], direction: tuple[int, int]) -> tuple[tuple[int, int], ...]:
 157:     """Return the 3 pixel coords of a triangle sprite with given apex and firing direction.
 158: 
 159:     Diagonal dir -> L-shape occupying 3 corners of a 2x2 (missing the corner opposite dir).
 160:     Axis dir -> V-shape with apex + 2 diagonal legs pointing opposite dir.
