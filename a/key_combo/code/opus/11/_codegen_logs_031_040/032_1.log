+    rel_cells = _template_rel_cells(g)
+    infos = _marker_infos(g, rel_cells)
+
+    out = g.copy()
+    out[g == TEMPLATE_COLOR] = BG
+    for info in infos:
+        mr, mc = info["marker"]
+        out[mr, mc] = BG
