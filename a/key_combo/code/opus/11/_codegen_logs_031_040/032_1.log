+    if obstacle_mask is None:
+        return None
+    oh, ow = obstacle_mask.shape
+    min_r = 4
+    max_r = h - oh - 4
+    min_c = 4
+    max_c = w - ow - 4
+    if min_r > max_r or min_c > max_c:
+        return None
+
+    for _ in range(30):
+        obstacle_pos = (random.randint(min_r, max_r), random.randint(min_c, max_c))
