+
+def _concave_2x2_count(mask: np.ndarray) -> int:
+    h, w = mask.shape
+    total = 0
+    for r in range(h - 1):
+        for c in range(w - 1):
+            if int(mask[r : r + 2, c : c + 2].sum()) == 3:
+                total += 1
+    return total
+
+
+def _random_obstacle_mask() -> np.ndarray | None:
+    for _ in range(200):
+        h = random.randint(4, 6)
+        w = random.randint(4, 6)
