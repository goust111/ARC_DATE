+    if len({info["marker"][0] for info in infos}) != len(infos):
+        return False
+    if len({info["marker"][1] for info in infos}) != len(infos):
+        return False
+    if len({info["k"] for info in infos}) < 2 or max(info["k"] for info in infos) < 2:
