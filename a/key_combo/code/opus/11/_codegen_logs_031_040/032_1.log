+                {
+                    "marker": (r, c),
+                    "landing": landing,
+                    "direction": direction,
+                    "gap": gap,
+                    "lengths": lengths,
+                    "k": k,
+                    "distance": r + c,
+                    "footprint": _stamp_footprint(grid.shape, rel_cells, landing, k),
