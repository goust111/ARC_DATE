+        grid = _render_input((h, w), obstacle_mask, obstacle_pos, template_mask, template_pos, combo)
+        if _validate_generated(grid):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
