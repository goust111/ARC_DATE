+    if len(_components4(grid == TEMPLATE_COLOR)) != 1:
+        return False
+    rows = template_coords[:, 0]
+    cols = template_coords[:, 1]
+    if int(rows.max() - rows.min() + 1) > 3 or int(cols.max() - cols.min() + 1) > 3:
+        return False
