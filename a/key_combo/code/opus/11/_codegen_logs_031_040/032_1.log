+def _trace_one_direction(grid: np.ndarray, start: Coord, first_step: Coord) -> tuple[int, Coord]:
+    sr, sc = start
+    dr, dc = first_step
+    nr, nc = sr + dr, sc + dc
+    if not _in_bounds(grid.shape, nr, nc):
+        return 0, start
+    if int(grid[nr, nc]) != BG or not _adjacent_to_obstacle(grid, (nr, nc)):
+        return 0, start
