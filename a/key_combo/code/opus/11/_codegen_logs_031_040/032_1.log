+    return out
+
+
+def _all_template_masks() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    seen: set[tuple[bytes, tuple[int, int]]] = set()
+    for base in BASE_TEMPLATE_MASKS:
+        cur = base
+        for _ in range(4):
+            for variant in (cur, np.fliplr(cur)):
+                cropped = _crop_mask(variant)
