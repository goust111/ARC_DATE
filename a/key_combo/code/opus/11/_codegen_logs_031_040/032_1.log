+                "marker": marker,
+                "direction": direction,
+                "landing": landing,
+                "lengths": lengths,
+                "k": k,
+                "distance": marker[0] + marker[1],
+                "cells": _stamp_cells(grid.shape, rel_cells, landing, k),
