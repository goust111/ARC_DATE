+
+
+def _enumerate_candidates(grid: np.ndarray, rel_cells: list[Coord]) -> list[dict]:
+    h, w = grid.shape
+    raw: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if int(grid[r, c]) != BG:
+                continue
+            hits = _sightline_hits(grid, (r, c))
+            if len(hits) != 1:
