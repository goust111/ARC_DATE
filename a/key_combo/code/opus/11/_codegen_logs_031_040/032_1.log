+            hits = _sightline_hits(grid, (r, c))
+            if len(hits) != 1:
+                continue
+            direction, landing, gap = hits[0]
+            if not (2 <= gap <= 6):
+                continue
+            lengths = _trace_lengths(grid, landing, direction)
+            k = max(lengths)
+            if lengths[0] == lengths[1] or not (1 <= k <= 4):
+                continue
