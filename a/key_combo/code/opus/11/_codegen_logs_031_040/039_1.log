+    levels[0] = max(0, levels[0])
+    levels[-1] = min(max_row, levels[-1])
+
+    for i in range(1, len(levels)):
+        levels[i] = max(levels[i], levels[i - 1] + 1)
+    for i in range(len(levels) - 2, -1, -1):
+        levels[i] = min(levels[i], levels[i + 1] - 1)
