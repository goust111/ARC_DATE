+        c = int(marker.col)
+        color = int(marker.color)
+
+        for cc in range(width):
+            if (r, cc) in marker_cells or out[r, cc] == WALL:
+                continue
+            out[r, cc] = color
+
+        for rr in range(height):
+            if (rr, c) in marker_cells or out[rr, c] == WALL:
+                continue
+            out[rr, c] = color
+
+    return out
