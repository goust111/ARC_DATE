+    min_gap = 2
+    base_width = width - (count - 1) * (min_gap - 1)
+    base = np.sort(rng.choice(base_width, size=count, replace=False))
+    cols = [int(base[i] + i * (min_gap - 1)) for i in range(count)]
+    assert all(cols[i + 1] - cols[i] >= min_gap for i in range(count - 1))
+    return cols
