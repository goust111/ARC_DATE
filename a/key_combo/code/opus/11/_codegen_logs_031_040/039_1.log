+    swapped = list(markers)
+    a = order[0]
+    b = order[1]
+    row_a = swapped[a].row
+    row_b = swapped[b].row
+    swapped[a] = Marker(row_b, swapped[a].col, swapped[a].color)
+    swapped[b] = Marker(row_a, swapped[b].col, swapped[b].color)
