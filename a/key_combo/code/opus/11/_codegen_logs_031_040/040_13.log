  10: # The input consists of a black grid. The grid is divided with red lines into black rectangles of different sizes.
  11: # To produce the output grid, fill in the smallest black rectangles with teal, and fillin in the largest black rectangles with blue.
  12: 
  13: def main(input_grid):
  14:     """
  15:     Fill smallest red-bounded black rectangles teal and largest ones blue.
  16: 
  17:     Input structure:
  18:     - Red divider lines partition a black grid into rectangular black regions.
  19:     - The red lines remain as separators.
  20:     - There may be multiple regions tied for smallest or largest area.
  21: 
  22:     Rule:
  23:     - Treat red as the background and find the black rectangular components.
  24:     - Compute each component's black area.
  25:     - Recolor smallest-area regions teal and largest-area regions blue, leaving red dividers intact.
  26: 
  27:     Key insight:
  28:     - The output depends only on relative region area within the red partition, not on
  29:       the regions' positions.
  30:     """
  31:     # to get the black rectangles, find connected components with red as background
  32:     objects = find_components(input_grid, bg=Color.RED, connectivity=4, monochromatic=True, return_format="objects")
  33: 
  34:     # get object areas
  35:     object_areas = [np.sum(obj == Color.BLACK) for obj in objects]
  36: 
  37:     # find the smallest and largest areas
  38:     smallest_area = min(object_areas)
  39:     largest_area = max(object_areas)
  40: 
  41:     # fill in the smallest rectangles with teal, and the largest rectangles with blue
  42:     new_objects = []
  43:     for obj in objects:
  44:         area = int(np.sum(obj == Color.BLACK))
  45:         if area == smallest_area:
  46:             obj[obj == Color.BLACK] = Color.TEAL
  47:         elif area == largest_area:
  48:             obj[obj == Color.BLACK] = Color.BLUE
  49:         new_objects.append(obj)
  50: 
  51:     # create an output grid to store the result
  52:     output_grid = np.full(input_grid.shape, Color.RED)
  53: 
  54:     # blit the objects back into the grid
  55:     for obj in new_objects:
  56:         output_grid = paste(output_grid, obj, 0, 0, transparent=Color.RED)
  57: 
  58:     return output_grid
  59: 
