+
+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[Coord]:
+    h, w = shape
+    out: list[Coord] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            if connectivity == 4 and abs(dr) + abs(dc) != 1:
+                continue
+            rr = r + dr
+            cc = c + dc
+            if 0 <= rr < h and 0 <= cc < w:
+                out.append((rr, cc))
+    return out
+
+
+def _components_from_mask(mask: np.ndarray, connectivity: int = 8) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[Coord] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors(rr, cc, (h, w), connectivity):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
