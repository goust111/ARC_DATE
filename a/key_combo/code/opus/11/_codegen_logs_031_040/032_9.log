+
+def _neighbors(r: int, c: int, shape: tuple[int, int], connectivity: int) -> list[Coord]:
+    h, w = shape
+    out: list[Coord] = []
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
