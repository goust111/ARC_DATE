    elif kind=='V':
        c=p
        cells=[(r,c) for r in range(n)]
    elif kind=='D':
        k=p
        for r in range(n):
            c=r-k
            if 0<=c<n:
                cells.append((r,c))
    else:
        s=p
        for r in range(n):
            c=s-r
            if 0<=c<n:
                cells.append((r,c))
    return set(cells)

def count_regions(n, lines):
    barrier=set().union(*lines)
    seen=set(); ints=0
    for r in range(n):
        for c in range(n):
            if (r,c) in barrier or (r,c) in seen: continue
            q=[(r,c)]; seen.add((r,c)); touch=False
            while q:
                x,y=q.pop()
                if x in (0,n-1) or y in (0,n-1): touch=True
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<n and 0<=ny<n and (nx,ny) not in barrier and (nx,ny) not in seen:
                        seen.add((nx,ny)); q.append((nx,ny))
            if not touch: ints+=1
    return ints

def intersections(lines):
    pts=[]
    for a,b in itertools.combinations(lines,2):
        inter=lines[a]&lines[b]
        if len(inter)"'!=1: return None
        pts.append(next(iter(inter)))
    return pts

