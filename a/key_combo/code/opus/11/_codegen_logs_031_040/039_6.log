+        grid = np.full((height, width), BG, dtype=int)
+        grid[separator_row, :] = SEP
+        for c, ref_color, src_color in zip(cols, ref_colors, src_colors):
+            grid[separator_row - 1, c] = int(ref_color)
+            grid[source_row, c] = int(src_color)
