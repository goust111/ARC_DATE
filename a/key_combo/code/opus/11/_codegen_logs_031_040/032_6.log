+    rc = rows // 2
+    cc = cols // 2
+    if mode == "axis_row":
+        return [(rc, c) for c in range(cols) if c != cc]
+    if mode == "axis_col":
+        return [(r, cc) for r in range(rows) if r != rc]
+    if mode == "quadrant":
+        return [(r, c) for r in range(rows) for c in range(cols) if r != rc and c != cc]
