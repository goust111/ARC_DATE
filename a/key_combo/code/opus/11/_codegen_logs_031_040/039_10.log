+    try:
+        out = main(grid)
+    except Exception:
+        return False
+
+    if out.shape != grid.shape:
+        return False
+    if not np.all(out[:, stripe_cols] == RED):
+        return False
+    if np.array_equal(out, grid):
+        return False
+    if np.array_equal(out, _render_with_policy(grid, "none")):
+        return False
+    if np.array_equal(out, _render_with_policy(grid, "all")):
+        return False
+
+    return True
+
