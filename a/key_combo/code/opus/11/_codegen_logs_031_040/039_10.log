+                "c0": c0,
+                "c1": c1,
+                "width": width,
+                "seed": seed,
+                "seed_key": _seed_key(seed),
+                "right": center > midline,
+            }
+        )
+    return bands
+
+
+def _has_scale_witness(bands: list[dict[str, object]]) -> bool:
+    for i, a in enumerate(bands):
+        for b in bands[i + 1 :]:
+            if a["right"] != b["right"]:
+                continue
+            if a["seed_key"] != b["seed_key"]:
+                continue
+            if a["width"] != b["width"]:
+                return True
+    return False
+
+
+def _has_mirror_witness(bands: list[dict[str, object]]) -> bool:
+    for i, a in enumerate(bands):
+        for b in bands[i + 1 :]:
+            if a["right"] == b["right"]:
+                continue
+            if a["seed_key"] != b["seed_key"]:
+                continue
+            if a["width"] != b["width"]:
+                continue
+            return True
