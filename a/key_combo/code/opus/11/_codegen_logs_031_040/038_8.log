+
+    @property
+    def right(self) -> int:
+        return self.bbox[3]
+
+    @property
+    def top(self) -> int:
+        return self.bbox[0]
+
+    @property
+    def bottom(self) -> int:
+        return self.bbox[2]
+
+    @property
