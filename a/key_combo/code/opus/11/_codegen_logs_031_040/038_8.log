+        "original_left": sprite.left,
+        "target_left": target_left,
+        "final_pixels": final_pixels,
+        "detours": detours,
+        "clipped": clipped,
+        "all_lost": len(final_pixels) == 0,
+    }
+
+
+def _transform(
+    grid: np.ndarray,
+    *,
+    respect_obstacles: bool = True,
+    draw_trails: bool = True,
+    mirror: bool = True,
