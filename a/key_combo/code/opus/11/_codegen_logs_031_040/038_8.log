+
+    @property
+    def left(self) -> int:
+        return self.bbox[1]
+
+    @property
+    def right(self) -> int:
+        return self.bbox[3]
+
+    @property
+    def top(self) -> int:
+        return self.bbox[0]
+
+    @property
+    def bottom(self) -> int:
+        return self.bbox[2]
+
+    @property
+    def width(self) -> int:
+        return self.right - self.left + 1
+
+    @property
+    def height(self) -> int:
+        return self.bottom - self.top + 1
+
