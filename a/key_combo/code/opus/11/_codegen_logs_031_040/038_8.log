+OBSTACLE = 5
+GROUND = 9
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8)
+MAX_GENERATION_ATTEMPTS = 400
+
+HEIGHT1_SHAPES = (
+    np.array([[1, 1, 1]], dtype=int),
+    np.array([[1, 1, 1, 1]], dtype=int),
