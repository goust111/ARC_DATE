        mask = np.zeros((h, w), dtype=bool)
        for r, c in cells:
            mask[r, c] = True
        coords = np.argwhere(mask)
        r0, c0 = coords.min(axis=0)
        r1, c1 = coords.max(axis=0)
        mask = mask[r0 : r1 + 1, c0 : c1 + 1]
        if random.random() < 0.5:
            mask = mask.T
        if random.random() < 0.5:
            mask = np.flipud(mask)
        if random.random() < 0.5:
            mask = np.fliplr(mask)

        coords = np.argwhere(mask)
        if not (OPEN_AREA[0] <= len(coords) <= OPEN_AREA[1]):
