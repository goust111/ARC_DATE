+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+LINE_COLORS = (BLUE, RED, GREEN)
+DIRS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
+ROTATION_BY_FACING = {
+    (-1, 0): 0,   # up
+    (0, 1): 3,    # right
+    (1, 0): 2,    # down
+    (0, -1): 1,   # left
+}
+GEN_MAX_ATTEMPTS = 400
+GEN_HEIGHT_RANGE = (13, 18)
+GEN_WIDTH_RANGE = (13, 18)
