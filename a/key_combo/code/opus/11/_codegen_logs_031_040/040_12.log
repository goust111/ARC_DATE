    pairs = []
    for h in range(SPRITE_HEIGHT_MIN, SPRITE_HEIGHT_MAX + 1):
        for w in range(SPRITE_WIDTH_MIN, SPRITE_WIDTH_MAX + 1):
            lo, hi = _gen_area_bounds(h, w)
            if lo <= hi:
                pairs.append((h, w))
    return tuple(pairs)


VALID_SPRITE_DIMS = _gen_valid_dim_pairs()


