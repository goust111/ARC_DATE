+    out = g.copy()
+    baseline_hits_by_color: Counter[int] = Counter()
+    baseline_adjacent_endpoint_counts: Counter[int] = Counter()
+    directions: list[tuple[int, int]] = []
+    endpoints_info: list[dict] = []
