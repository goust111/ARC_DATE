+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(comp)
+    return parts
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _centered_patch(mask: np.ndarray, center: tuple[int, int], color: int) -> set[tuple[int, int]]:
+    h, w = mask.shape
+    cr, cc = h // 2, w // 2
+    base_r, base_c = center
+    pts = set()
+    for rr in range(h):
+        for cc2 in range(w):
+            if mask[rr, cc2]:
+                pts.add((base_r + rr - cr, base_c + cc2 - cc))
+    return pts
+
+
+def _mask_is_connected(mask: np.ndarray) -> bool:
+    return bool(mask.any()) and len(_components(mask.astype(bool))) == 1
