    if w >= REGION_SPLIT_MIN_SIZE:
        choices.append("v")
    if not choices:
        return None
    orient = choices[int(rng.integers(len(choices)))]
    if orient == "h":
        cut = _gen_cut_span(h, rng)
        return [(r0, r0 + cut, c0, c1), (r0 + cut, r1, c0, c1)]

    cut = _gen_cut_span(w, rng)
