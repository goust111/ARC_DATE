+            patch[r0 + cell_h + 1, c0 : c0 + cell_w + 2] = 1
+            patch[r0 : r0 + cell_h + 2, c0] = 1
+            patch[r0 : r0 + cell_h + 2, c0 + cell_w + 1] = 1
