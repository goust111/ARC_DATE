+        for start in starts[:20]:
+            for goal in goals[:20]:
+                path = _shortest_path(blocked, start, goal, passable_extra=grey_cells)
+                if path is None or len(path) < 2:
+                    continue
+                if best is None or len(path) < len(best):
+                    best = path
+            if best is not None:
