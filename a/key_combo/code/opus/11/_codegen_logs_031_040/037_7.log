+    assert len(comps) == 1, f"color {color} should form one sprite"
+    cells = comps[0]
+    r0, c0, r1, c1 = _bbox(cells)
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    holes = []
+    for comp in _components(sub == BLACK):
+        if any(
+            r == 0 or c == 0 or r == sub.shape[0] - 1 or c == sub.shape[1] - 1
+            for r, c in comp
