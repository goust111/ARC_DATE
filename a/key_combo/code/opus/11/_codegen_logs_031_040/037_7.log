+def _random_spanning_tree(cells: set[tuple[int, int]]) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    cell_list = list(cells)
+    start = random.choice(cell_list)
+    seen = {start}
+    tree: list[tuple[tuple[int, int], tuple[int, int]]] = []
