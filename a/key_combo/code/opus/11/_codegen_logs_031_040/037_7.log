+        occupied = np.zeros((H, W), dtype=bool)
+        hole_counts = [1, 2, 3, 4]
+        random.shuffle(hole_counts)
+        colors = random.sample(SPRITE_COLORS, 4)
+
+        placements: list[tuple[int, int, np.ndarray, int]] = []
+        ok = True
