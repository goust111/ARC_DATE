+
+
+def _shortest_path(
+    blocked: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    passable_extra: set[tuple[int, int]] | None = None,
+) -> list[tuple[int, int]] | None:
+    extra = passable_extra or set()
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for dr, dc in DIRS4:
+            nr, nc = cur[0] + dr, cur[1] + dc
+            nxt = (nr, nc)
