+    H, W = occupied.shape
+    if top < 0 or left < 0 or top + h > H or left + w > W:
+        return False
+    r0 = max(0, top - margin)
+    c0 = max(0, left - margin)
+    r1 = min(H, top + h + margin)
+    c1 = min(W, left + w + margin)
+    return not bool(occupied[r0:r1, c0:c1].any())
