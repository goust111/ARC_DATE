+            patch[r0 + cell_h + 1, c0 : c0 + cell_w + 2] = 1
+            patch[r0 : r0 + cell_h + 2, c0] = 1
+            patch[r0 : r0 + cell_h + 2, c0 + cell_w + 1] = 1
+
+        for a, b in _adjacent_cell_edges(poly):
+            if frozenset((a, b)) not in open_edges:
+                continue
+            if a[0] == b[0]:
+                pr = a[0]
+                left = min(a[1], b[1])
