+def _adjacent_cell_edges(cells: set[tuple[int, int]]) -> list[tuple[tuple[int, int], tuple[int, int]]]:
+    edges: list[tuple[tuple[int, int], tuple[int, int]]] = []
+    for r, c in cells:
+        for dr, dc in [(1, 0), (0, 1)]:
+            nbr = (r + dr, c + dc)
+            if nbr in cells:
