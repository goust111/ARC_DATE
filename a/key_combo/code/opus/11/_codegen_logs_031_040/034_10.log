+    while len(cells) < count:
+        frontier: set[tuple[int, int]] = set()
+        for r, c in cells:
+            for nr, nc in _neighbors4(r, c):
+                if 0 <= nr < height and 0 <= nc < width and (nr, nc) not in cells:
+                    frontier.add((nr, nc))
+        nr, nc = random.choice(list(frontier))
+        cells.add((nr, nc))
+        mask[nr, nc] = True
+    return mask
+
