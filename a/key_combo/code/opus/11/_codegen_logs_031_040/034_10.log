+def _sample_sizes(n_frames: int) -> list[tuple[int, int]]:
+    shared = random.choice([(4, 4), (4, 5), (5, 4), (5, 5)])
+    sizes = [shared, shared]
+
+    while len(sizes) < n_frames:
