+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    frames = _extract_frames(g)
+    ordered = sorted(frames, key=lambda frame: frame["count"])
+    return _compose_output([frame["inner"] for frame in ordered])
