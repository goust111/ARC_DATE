0096: def _gen_domino_placements(grid: np.ndarray, horizontal: bool) -> list[tuple[tuple[int, int], ...]]:
0097:     h, w = grid.shape
0098:     placements = []
0099:     col_stop = w - 1 if horizontal else w
0100:     for r in range(h):
0101:         for c in range(col_stop):
0102:             coords = ((r, c), (r, c + 1)) if horizontal else ((r, c), (r + 1, c))
0103:             if coords[-1][0] < h and _gen_object_fits(grid, coords):
0104:                 placements.append(coords)
0105:     return placements
