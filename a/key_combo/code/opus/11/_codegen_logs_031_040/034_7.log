0034: def main(grid: np.ndarray) -> np.ndarray:
0035:     """
0036:     Move every red object horizontally until it is flush with the side of its enclosing blue or teal region.
0037: 
0038:     Input structure
0039:     - The grid contains only blue, red, and teal pixels.
0040:     - The red pixels form one or more 4-connected objects.
0041:     - Each red object is embedded in exactly one adjacent non-red carrier color.
0042: 
0043:     Rule
0044:     - Clear each red object back to its carrier color to recover the blue and teal regions.
0045:     - A red object carried by blue moves right until its bounding box touches the right edge of that blue region.
0046:     - A red object carried by teal moves left until its bounding box touches the left edge of that teal region.
0047:     - Preserve the object's shape and rows, and apply all object moves simultaneously.
0048: 
0049:     Key insight
0050:     - The red objects are sliders inside colored horizontal lanes; the carrier color encodes the slide direction.
0051:     """
0052:     g = np.asarray(grid, dtype=int)
0053:     assert g.ndim == 2, "input must be a 2D grid"
0054:     assert set(map(int, np.unique(g))) == {Color.BLUE, Color.RED, Color.TEAL}, "expected blue, red, and teal only"
0055: 
0056:     red_objects = components_mask(g == Color.RED, connectivity=4)
0057:     assert red_objects, "expected at least one red object"
0058: 
0059:     base = g.copy()
0060:     objects: list[tuple[np.ndarray, int]] = []
0061:     for coords in red_objects:
0062:         carrier = _carrier_color(g, coords)
0063:         base[coords[:, 0], coords[:, 1]] = carrier
0064:         objects.append((coords, carrier))
0065: 
0066:     out = base.copy()
0067:     occupied = np.zeros(g.shape, dtype=bool)
0068:     H, W = g.shape
0069: 
0070:     for coords, carrier in objects:
0071:         obj_box = bbox_coords(coords)
0072:         region = _containing_region(base, coords, carrier)
0073:         region_box = bbox_coords(region)
0074:         obj_c0, obj_c1 = obj_box[1], obj_box[3]
0075:         reg_c0, reg_c1 = region_box[1], region_box[3]
0076: 
0077:         obj_w = int(obj_c1 - obj_c0 + 1)
0078:         if carrier == Color.BLUE:
0079:             dst_c0 = int(reg_c1 - obj_w + 1)
0080:         else:
0081:             assert carrier == Color.TEAL
0082:             dst_c0 = int(reg_c0)
0083: 
0084:         moved = coords.copy()
0085:         moved[:, 1] += dst_c0 - int(obj_c0)
0086: 
0087:         assert np.all((0 <= moved[:, 0]) & (moved[:, 0] < H) & (0 <= moved[:, 1]) & (moved[:, 1] < W))
0088:         assert np.all(base[moved[:, 0], moved[:, 1]] == carrier), "destination must stay inside the carrier region"
0089:         assert not np.any(occupied[moved[:, 0], moved[:, 1]]), "moved red objects must not overlap"
0090: 
0091:         occupied[moved[:, 0], moved[:, 1]] = True
0092:         out[moved[:, 0], moved[:, 1]] = Color.RED
0093: 
0094:     return out
