0140:         coords = placements[int(rng.integers(0, len(placements)))]
0141:         for r, c in coords:
0142:             grid[r, c] = GEN_FOREGROUND
0143:         domino_boxes.append(bbox_coords(np.array(coords, dtype=int)))
0144:     return domino_boxes
