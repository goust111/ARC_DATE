+    height_choices = list(range(min_h, GEN_HEIGHT_RANGE[1]))
+    width_choices = list(range(min_w, GEN_WIDTH_RANGE[1]))
+    rng.shuffle(height_choices)
+    rng.shuffle(width_choices)
