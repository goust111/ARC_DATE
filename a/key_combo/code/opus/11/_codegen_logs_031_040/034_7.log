0120:     h, w = out.shape
0121:     r0, c0, r1, c1 = box
0122:     er0 = max(0, r0 - 1)
0123:     ec0 = max(0, c0 - 1)
0124:     er1 = min(h - 1, r1 + 1)
0125:     ec1 = min(w - 1, c1 + 1)
0126:     for r in range(er0, er1 + 1):
0127:         for c in range(ec0, ec1 + 1):
0128:             if (r in (er0, er1) or c in (ec0, ec1)) and out[r, c] == GEN_BACKGROUND:
0129:                 out[r, c] = GEN_FRAME
