0084: def _gen_object_fits(grid: np.ndarray, coords: tuple[tuple[int, int], ...]) -> bool:
0085:     h, w = grid.shape
0086:     coord_set = set(coords)
0087:     for r, c in coords:
0088:         if grid[r, c] != GEN_BACKGROUND:
0089:             return False
0090:         for nr, nc in _gen_neighbors4(r, c, h, w):
0091:             if (nr, nc) not in coord_set and grid[nr, nc] == GEN_FOREGROUND:
0092:                 return False
0093:     return True
