+    half_step_mapping = tuple((dr // 2, dc // 2) for dr, dc in DELTAS)
+    alt = _simulate_output(grid.shape, start, glyphs, mapping=half_step_mapping)
+    if alt is not None and np.array_equal(alt, solved):
+        return False
+    return True
