+        return False
+    if not np.all(solved[:, 0] == DIVIDER):
+        return False
+    if not np.all(solved[:2, 1:] == BG):
+        return False
+    if solved[start] != START:
+        return False
+    if not _visible_color_check(solved, glyphs):
+        return False
+
