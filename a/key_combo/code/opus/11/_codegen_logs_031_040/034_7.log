0058:             output_grid[0:red_r, red_c-(width-1) : red_c+(width-1)+1] = rectangle_color
0059:             # Draw the red line from the red pixel to the border
0060:             draw_line(output_grid, r=red_r, c=red_c, direction=(-1, 0), color=indicator_color)
0061:         elif red_r == r + width - 1:
