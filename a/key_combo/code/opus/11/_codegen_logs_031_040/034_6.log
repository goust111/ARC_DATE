+        "br": (slice(n + 2, 2 * n + 2), slice(n + 2, 2 * n + 2)),
+    }
+
+
+def _anchor_by_quadrant(marker: np.ndarray) -> dict[str, int]:
+    return {
+        "br": int(marker[0, 0]),
+        "bl": int(marker[0, 1]),
+        "tr": int(marker[1, 0]),
