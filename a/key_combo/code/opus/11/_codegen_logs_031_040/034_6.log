+
+def _row_col_nondup(partial: np.ndarray) -> bool:
+    n = partial.shape[0]
+    for i in range(n):
+        row = [int(v) for v in partial[i] if v != BG]
+        col = [int(v) for v in partial[:, i] if v != BG]
+        if len(row) != len(set(row)) or len(col) != len(set(col)):
