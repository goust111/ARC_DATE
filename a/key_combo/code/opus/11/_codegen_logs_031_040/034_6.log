+
+        if _valid_partial(partial, palette, anchor, min_anchor_visible, must_keep_color):
+            return partial
+    return None
+
+
+def _build_case() -> tuple[np.ndarray, np.ndarray] | None:
+    n = random.choice(QUADRANT_SIZES)
+    marker = _random_marker()
+    extra = None
+    if n == 5:
+        extra = random.choice(EXTRA_CHOICES)
