+    partial: np.ndarray, palette: tuple[int, ...], anchor: int
+) -> np.ndarray:
+    matches = _matching_candidates(partial, palette, anchor)
+    assert len(matches) == 1, f"expected a unique anchored completion, got {len(matches)}"
+    return matches[0]
