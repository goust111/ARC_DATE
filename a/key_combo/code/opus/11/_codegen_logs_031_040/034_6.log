+
+
+def _candidate_from_indices(indices: np.ndarray, palette: tuple[int, ...]) -> np.ndarray:
+    arr = np.array(palette, dtype=int)
+    return arr[indices]
+
+
+def _partial_symbol_grid(partial: np.ndarray, palette: tuple[int, ...]) -> np.ndarray:
