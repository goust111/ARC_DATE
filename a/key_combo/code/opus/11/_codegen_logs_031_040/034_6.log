+    if not _anchorless_ambiguous(partial, palette):
+        return False
+    return True
+
+
+def _make_quadrant_input(
+    output: np.ndarray,
+    palette: tuple[int, ...],
+    anchor: int,
+    must_keep_color: int | None,
+) -> np.ndarray | None:
