+        partial = encoded.copy()
+        removed = 0
+        for r, c in _blanking_order(encoded, output, anchor, must_keep_color):
+            trial = partial.copy()
+            trial[r, c] = BG
+            if _valid_partial(trial, palette, anchor, min_anchor_visible, must_keep_color):
+                partial = trial
+                removed += 1
