+        output[rs, cs] = quadrant_output
+        quadrant_inputs[name] = quadrant_input
+
+    inp = np.zeros_like(output)
+    inp[n : n + 2, n : n + 2] = marker
+
+    for name, (rs, cs) in slices.items():
+        inp[rs, cs] = quadrant_inputs[name]
+
