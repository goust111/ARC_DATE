+        "bl": int(marker[0, 1]),
+        "tr": int(marker[1, 0]),
+        "tl": int(marker[1, 1]),
+    }
+
+
+def _apply_color_map(grid: np.ndarray, color_map: dict[int, int]) -> np.ndarray:
+    lut = np.arange(10, dtype=int)
+    for src, dst in color_map.items():
