+
+def _anchorless_ambiguous(partial: np.ndarray, palette: tuple[int, ...]) -> bool:
+    count, _ = _count_matching_candidates(partial, palette, None, stop_after=2)
+    return count > 1
+
+
+def _valid_partial(
+    partial: np.ndarray,
+    palette: tuple[int, ...],
+    anchor: int,
