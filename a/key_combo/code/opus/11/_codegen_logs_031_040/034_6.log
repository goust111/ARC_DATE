+
+
+def _candidate_index_grids(n: int) -> list[np.ndarray]:
+    cached = _INDEX_GRID_CACHE.get(n)
+    if cached is not None:
+        return cached
+
+    seen: set[bytes] = set()
+    out: list[np.ndarray] = []
+    perms = list(itertools.permutations(range(n)))
+    cols = np.arange(n, dtype=int)
+    for row_perm in perms:
