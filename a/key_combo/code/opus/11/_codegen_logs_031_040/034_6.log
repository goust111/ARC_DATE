+            for transpose in (False, True):
+                grid = base.T.copy() if transpose else base.copy()
+                key = grid.tobytes()
+                if key not in seen:
+                    seen.add(key)
+                    out.append(grid)
+
+    _INDEX_GRID_CACHE[n] = out
+    return out
+
