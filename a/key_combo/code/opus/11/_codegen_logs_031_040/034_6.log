+
+def _anchorless_ambiguous(partial: np.ndarray, palette: tuple[int, ...]) -> bool:
+    return len(_matching_candidates(partial, palette, None)) > 1
+
+
+def _valid_partial(
+    partial: np.ndarray,
+    palette: tuple[int, ...],
+    anchor: int,
+    min_anchor_visible: int,
+    must_keep_color: int | None,
+) -> bool:
