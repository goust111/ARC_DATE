+            return False
+    return True
+
+
+def _visible_per_line(partial: np.ndarray) -> bool:
+    return np.all(np.count_nonzero(partial != BG, axis=0) >= 1) and np.all(
+        np.count_nonzero(partial != BG, axis=1) >= 1
+    )
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
