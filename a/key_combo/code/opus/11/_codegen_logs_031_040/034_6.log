+    return inp, output
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        built = _build_case()
+        if built is None:
+            continue
+        inp, _ = built
+        return inp
+    raise RuntimeError("failed to generate a non-degenerate anchored Latin-square input")

