+def _reflected_cells(shape: dict, axis_col: int) -> list[tuple[int, int]]:
+    right = int(shape["right"])
+    cells = []
+    for r, c in shape["coords"]:
+        offset = right - int(c)
+        cells.append((int(r), axis_col + 1 + offset))
+    return cells
