+def _cells_touch(cells_a: set[tuple[int, int]], cells_b: set[tuple[int, int]]) -> bool:
+    for r1, c1 in cells_a:
+        for r2, c2 in cells_b:
+            if max(abs(r1 - r2), abs(c1 - c2)) <= 1:
+                return True
+    return False
+
+
+def _build_instance(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(15, 20)
+    n_shapes = rng.randint(2, 4)
+    strip_w = rng.randint(4, 5)
+
+    pair_h = rng.randint(3, 5)
+    pair_w = rng.randint(2, min(4, strip_w))
+    core_size = rng.randint(3, 4)
+    core_local = _random_connected_shape(rng, pair_h, pair_w, core_size)
+    if core_local is None:
+        return None
+    row0 = rng.randint(1, h - pair_h - 1)
+    off0 = rng.randint(0, strip_w - pair_w)
+    core = {(row0 + r, off0 + c) for r, c in core_local}
+
+    size_a = rng.randint(max(core_size + 1, 4), min(8, core_size + 3))
+    size_b = rng.randint(max(core_size + 1, 4), min(8, core_size + 3))
+    branch_a = _grow_branch(rng, core, set(core), size_a - core_size, row0, row0 + pair_h - 1, strip_w - 1)
+    if branch_a is None:
+        return None
+    branch_b = _grow_branch(
+        rng,
+        core,
+        set(core) | branch_a,
+        size_b - core_size,
+        row0,
+        row0 + pair_h - 1,
+        strip_w - 1,
+    )
+    if branch_b is None:
+        return None
+
+    target_shapes: list[set[tuple[int, int]]] = [set(core) | branch_a, set(core) | branch_b]
+    overlap_cells = set(core)
+    if len(overlap_cells) < 3:
+        return None
+
+    reserved_rows = set(range(row0 - 1, row0 + pair_h + 1))
+    for _ in range(n_shapes - 2):
+        placed = False
+        for _ in range(40):
+            box_h = rng.randint(2, 4)
+            box_w = rng.randint(2, min(4, strip_w))
+            possible_rows = [r for r in range(1, h - box_h) if not reserved_rows.intersection(range(r, r + box_h))]
+            if not possible_rows:
+                possible_rows = list(range(1, h - box_h))
+            if not possible_rows:
+                return None
+            rr = rng.choice(possible_rows)
+            cc = rng.randint(0, strip_w - box_w)
+            size = rng.randint(3, min(6, box_h * box_w))
+            shape_local = _random_connected_shape(rng, box_h, box_w, size)
+            if shape_local is None:
+                continue
+            shape = {(rr + r, cc + c) for r, c in shape_local}
+            if any(shape & prev for prev in target_shapes):
+                continue
+            target_shapes.append(shape)
+            reserved_rows.update(range(rr - 1, rr + box_h + 1))
+            placed = True
+            break
+        if not placed:
+            return None
+
+    overlap_graph = {i: set() for i in range(n_shapes)}
+    cover_count: dict[tuple[int, int], list[int]] = defaultdict(list)
+    for idx, shape in enumerate(target_shapes):
+        for cell in shape:
+            cover_count[cell].append(idx)
+    for owners in cover_count.values():
+        if len(owners) > 1:
+            for i in owners:
+                for j in owners:
+                    if i != j:
+                        overlap_graph[i].add(j)
+    if not any(overlap_graph[i] for i in range(n_shapes)):
+        return None
+
+    marker_colors = _choose_marker_colors(rng, overlap_graph, n_shapes)
+    if marker_colors is None:
+        return None
+
+    distances_pool = [1, 3, 5, 7]
+    if n_shapes > len(distances_pool):
+        return None
+    distances = rng.sample(distances_pool, n_shapes)
+    if distances[0] > distances[1]:
+        distances[0], distances[1] = distances[1], distances[0]
+
+    max_offset = max(max(c for _r, c in shape) for shape in target_shapes)
+    axis_col = max(distances) + max_offset + rng.randint(2, 4)
+    w = axis_col + max_offset + rng.randint(4, 7)
+    if w > 30:
+        return None
+
+    source_shapes: list[set[tuple[int, int]]] = []
+    for dist, target_shape in zip(distances, target_shapes):
+        source = {(r, axis_col - dist - off) for r, off in target_shape}
+        if min(c for _r, c in source) < 0:
+            return None
+        if max(c for _r, c in source) >= axis_col:
+            return None
+        source_shapes.append(source)
+
+    for i in range(n_shapes):
+        for j in range(i + 1, n_shapes):
+            if source_shapes[i] & source_shapes[j]:
+                return None
+            if _cells_touch(source_shapes[i], source_shapes[j]):
+                return None
+
+    unique_cells_by_shape: list[list[tuple[int, int]]] = []
+    for idx, shape in enumerate(target_shapes):
+        unique = [cell for cell in shape if len(cover_count[cell]) == 1]
+        if not unique:
+            return None
+        unique_cells_by_shape.append(unique)
+
+    marker_positions: list[tuple[int, int]] = []
+    used_markers: set[tuple[int, int]] = set()
+    for idx, unique in enumerate(unique_cells_by_shape):
+        candidates = [cell for cell in unique if cell[1] >= 1]
+        rng.shuffle(candidates)
+        chosen = None
+        for cell in candidates:
+            if cell in used_markers:
+                continue
+            if any(max(abs(cell[0] - r), abs(cell[1] - c)) <= 1 for r, c in used_markers):
+                continue
+            chosen = cell
+            break
+        if chosen is None:
+            return None
+        marker_positions.append(chosen)
+        used_markers.add(chosen)
+
+    grid = np.full((h, w), BG, dtype=int)
+    grid[:, axis_col] = AXIS
+
+    obj_colors = [rng.choice(OBJ_COLORS) for _ in range(n_shapes)]
+    for color, cells in zip(obj_colors, source_shapes):
+        for r, c in cells:
+            grid[r, c] = color
+
+    for color, (r, off) in zip(marker_colors, marker_positions):
+        c = axis_col + 1 + off
+        if c >= w:
+            return None
+        if grid[r, c] != BG:
+            return None
+        grid[r, c] = color
+
+    out = main(grid)
+
+    if np.any(np.isin(out, MARKER_COLORS) & (grid == BG)):
+        return None
+    if len(set(marker_colors)) < 2:
+        return None
+
+    winning_overlap_colors = {
+        int(out[r, axis_col + 1 + off])
+        for r, off in overlap_cells
+    }
+    losing_overlap_colors = {
+        marker_colors[idx]
+        for owners in cover_count.values()
+        if len(owners) > 1
+        for idx in owners
+    }
+    if len(overlap_cells) < 3:
+        return None
+    if len(winning_overlap_colors) == 1 and len(losing_overlap_colors) == 1:
+        return None
+
+    for idx, unique in enumerate(unique_cells_by_shape):
+        marker_hits = 0
+        for r, off in unique:
+            c = axis_col + 1 + off
+            if int(grid[r, c]) in MARKER_COLORS:
+                marker_hits += 1
+        if marker_hits != 1:
+            return None
+
+    for r, off in overlap_cells:
+        c = axis_col + 1 + off
+        if int(grid[r, c]) in MARKER_COLORS:
+            return None
+
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(800):
+        grid = _build_instance(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid reflection-overlap instance")

