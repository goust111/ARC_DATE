+def _extract_left_shapes(grid: np.ndarray, axis_col: int) -> list[dict]:
+    shapes: list[dict] = []
+    for color in OBJ_COLORS:
+        mask = (grid == color)
+        if axis_col > 0:
+            mask[:, axis_col:] = False
+        for coords in _components_of_color(mask):
+            rows = coords[:, 0]
+            cols = coords[:, 1]
+            shapes.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "top": int(rows.min()),
+                    "right": int(cols.max()),
+                }
