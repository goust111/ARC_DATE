+    def dfs(pos: int) -> bool:
+        if pos == len(order):
+            return True
+        idx = order[pos]
+        rng.shuffle(colors)
+        for color in colors:
+            if any(chosen[nb] == color for nb in overlap_graph[idx]):
+                continue
+            chosen[idx] = color
+            if dfs(pos + 1):
