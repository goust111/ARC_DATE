+            if not _in_bounds(grid.shape, gr, gc):
+                return None
+            if lr < 0 or lr >= rh or lc < 0 or lc >= rw:
+                if grid[gr, gc] != BG:
+                    return None
+                grid[gr, gc] = color
+
+    return grid if _grid_passes_constraints(grid) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_grid()
+        if grid is not None:
+            return grid
