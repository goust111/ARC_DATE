+    boxes = [rect["bbox"] for rect in rects]
+
+    for _ in range(count):
+        placed = False
+        for _ in range(120):
+            shape_choice = rng.choice([(3, 4), (4, 3), (4, 4), (3, 5), (5, 3), (4, 5), (5, 4)])
