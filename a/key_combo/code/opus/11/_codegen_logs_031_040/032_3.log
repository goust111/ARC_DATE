+    out = g.copy()
+    rects = _extract_rectangles(g)
+    specs: list[dict] = []
+
+    for rect in rects:
+        if not rect["markers"]:
+            continue
+        if len(rect["markers"]) != 1:
+            raise AssertionError("each marked rectangle must contain exactly one grey marker")
+
+        r0, c0, r1, c1 = rect["bbox"]
+        mr, mc = rect["markers"][0]
