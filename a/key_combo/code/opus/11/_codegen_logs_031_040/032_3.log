+    for spec in specs:
+        r0, c0, r1, c1 = spec["bbox"]
+        if spec["orientation"] == "v":
+            c = spec["fixed"]
+            rr = r0 - 1
+            while rr >= 0 and out[rr, c] == BLACK:
