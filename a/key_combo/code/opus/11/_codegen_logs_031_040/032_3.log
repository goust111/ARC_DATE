+def _horizontal_rect_spec(rng: random.Random, shape: tuple[int, int], y: int, left_w: int, right_w: int) -> dict | None:
+    h_grid, w_grid = shape
+    for _ in range(30):
+        w = rng.randint(3, 4)
+        h = rng.randint(max(4, w + 1), 6)
