+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+RECT_COLORS = (BLUE, RED, GREEN, YELLOW)
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _extract_rectangles(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    rects: list[dict] = []
+    for color in RECT_COLORS:
+        for coords in _component_coords(g == color):
+            r0, c0, r1, c1 = _bbox(coords)
+            view = g[r0 : r1 + 1, c0 : c1 + 1]
+            if not np.all((view == color) | (view == GREY)):
+                raise AssertionError("expected solid rectangles optionally containing grey markers")
+            markers = [(r0 + rr, c0 + cc) for rr, cc in np.argwhere(view == GREY)]
+            rects.append(
+                {
+                    "color": int(color),
+                    "bbox": (r0, c0, r1, c1),
+                    "markers": markers,
+                }
+            )
+    rects.sort(key=lambda rect: rect["bbox"])
+    return rects
+
+
