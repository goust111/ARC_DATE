+                    "orientation": "v",
+                    "bbox": rect["bbox"],
+                    "marker": (mr, mc),
+                    "fixed": mc,
+                    "neg_len": 0,
+                    "pos_len": 0,
+                }
+            )
+        else:
+            out[mr, c0 : c1 + 1] = GREY
+            specs.append(
+                {
+                    "orientation": "h",
+                    "bbox": rect["bbox"],
+                    "marker": (mr, mc),
+                    "fixed": mr,
+                    "neg_len": 0,
+                    "pos_len": 0,
+                }
+            )
