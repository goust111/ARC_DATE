+    return rects
+
+
+def _build_vertical_example(rng: random.Random) -> np.ndarray | None:
+    shape = (rng.randint(15, 20), rng.randint(15, 20))
+    h, w = shape
+    marked_count = rng.randint(1, 2)
+    xs = _sample_spaced_positions(rng, list(range(4, w - 4)), marked_count, gap=6)
+    if xs is None:
