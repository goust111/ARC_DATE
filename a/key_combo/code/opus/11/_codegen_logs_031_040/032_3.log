+            specs.append(
+                {
+                    "orientation": "h",
+                    "bbox": rect["bbox"],
+                    "marker": (mr, mc),
+                    "fixed": mr,
+                    "neg_len": 0,
+                    "pos_len": 0,
+                }
+            )
