+            if avoid_cols and any(box[1] <= col <= box[3] for col in avoid_cols):
+                continue
+            if avoid_rows and any(box[0] <= row <= box[2] for row in avoid_rows):
+                continue
+            if not _can_place(box, boxes, shape):
