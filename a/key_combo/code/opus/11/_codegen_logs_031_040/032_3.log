+        kind = rng.choices(["wide", "square"], weights=[3, 2])[0]
+        if kind == "square":
+            h = w = rng.randint(4, 5)
+        else:
+            h = rng.randint(3, 4)
+            w = rng.randint(max(4, h + 1), 6)
+
+        local_col = rng.randint(1, w - 2)
+        c0 = x - local_col
+        c1 = c0 + w - 1
+        if c0 < 1 or c1 > w_grid - 2:
+            continue
+
+        min_r0 = top_h + 2
+        max_r0 = h_grid - bottom_h - h - 2
+        if min_r0 > max_r0:
