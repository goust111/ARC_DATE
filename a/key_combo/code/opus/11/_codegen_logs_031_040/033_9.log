+        c0 = bc * (TILE_SIZE + 1)
+        grid[r0 : r0 + TILE_SIZE, c0 : c0 + TILE_SIZE] = tile
+    return grid
+
+
+def _rotate_coord_cw(r: int, c: int, turns: int, size: int) -> tuple[int, int]:
+    turns %= 4
+    if turns == 0:
+        return r, c
+    if turns == 1:
+        return c, size - 1 - r
+    if turns == 2:
+        return size - 1 - r, size - 1 - c
+    return size - 1 - c, r
