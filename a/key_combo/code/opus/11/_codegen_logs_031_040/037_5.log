    return True


def _gen_place_cycles(canvas, patches):
    occupied = set()
    boxes = []
    for patch in sorted(patches, key=lambda p: int(np.count_nonzero(p)), reverse=True):
        h, w = patch.shape
        coords = np.argwhere(patch != GEN_BACKGROUND_COLOR)
