+def _gen_attempt(rng: random.Random, branch: int) -> np.ndarray | None:
+    panel_count, panel_w = GEN_LAYOUTS[branch % len(GEN_LAYOUTS)]
+    preferred_abs_dy = 2 if panel_count == 4 and (branch // (2 * len(GEN_LAYOUTS))) % 2 == 0 else 1
