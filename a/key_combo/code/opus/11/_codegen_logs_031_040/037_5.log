+    expected = _render_panel(
+        int(info["panel_h"]),
+        int(info["panel_w"]),
+        int(info["frame"]),
+        np.asarray(info["sprite_mask"], dtype=bool),
+        int(info["next_top"]),
+        int(info["left"]),
