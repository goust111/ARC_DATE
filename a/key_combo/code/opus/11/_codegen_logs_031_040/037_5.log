+                    outside = [(r, c) for r in range(h) for c in range(w) if not base[r, c]]
+                    for extra_count in range(min(4, len(outside)) + 1):
+                        for extra_cells in combinations(outside, extra_count):
+                            mask = base.copy()
+                            for rr, cc in extra_cells:
