+    panel_h = rng.choice(panel_h_choices)
+    interior_h = panel_h - 2
+    interior_w = panel_w - 2
+    sign = 1 if branch % 2 == 0 else -1
+    cycle_offset = (branch // len(GEN_LAYOUTS)) % 3
