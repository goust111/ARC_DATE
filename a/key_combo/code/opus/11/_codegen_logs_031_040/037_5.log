+def _render_panel(
+    panel_h: int,
+    panel_w: int,
+    frame: int,
+    sprite_mask: np.ndarray,
+    top: int,
+    left: int,
+    interior_rc: tuple[int, int],
+    marker_color: int,
+) -> np.ndarray:
+    out = np.zeros((panel_h, panel_w), dtype=int)
+    out[0, :] = frame
+    out[-1, :] = frame
+    out[:, 0] = frame
+    out[:, -1] = frame
+    rr, cc = np.where(sprite_mask)
+    out[top + rr, left + cc] = BLUE
+    ir, ic = interior_rc
+    out[top + ir, left + ic] = marker_color
+    return out
