+def _render_panel(
+    panel_h: int,
+    panel_w: int,
+    frame: int,
+    sprite_mask: np.ndarray,
+    top: int,
+    left: int,
+    interior_rc: tuple[int, int],
+    marker_color: int,
+) -> np.ndarray:
+    out = np.zeros((panel_h, panel_w), dtype=int)
