+        & mask[:-2, 2:]
+        & mask[1:-1, :-2]
+        & mask[1:-1, 1:-1]
+        & mask[1:-1, 2:]
+        & mask[2:, :-2]
+        & mask[2:, 1:-1]
+        & mask[2:, 2:]
