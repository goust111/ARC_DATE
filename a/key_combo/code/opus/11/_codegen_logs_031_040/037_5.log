+
+
+def _build_input(
+    panel_h: int,
+    panel_w: int,
+    panel_count: int,
+    sprite_mask: np.ndarray,
+    left: int,
+    start_top: int,
+    dy: int,
+    cycle_offset: int,
+) -> np.ndarray:
+    stride = panel_w - 1
+    width = panel_count * stride + 1
+    grid = np.zeros((panel_h, width), dtype=int)
+    grid[0, :] = GREY
+    grid[-1, :] = GREY
