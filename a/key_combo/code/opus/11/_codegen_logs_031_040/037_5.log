    """Scatter one same-sized single-color patch per mark color on the canvas."""
    grid = np.full(CANVAS_SHAPE, separator, dtype=int)
    for color in mark_colors:
        patch = np.full_like(out, BLANK_COLOR)
        patch[out == color] = color
        try:
