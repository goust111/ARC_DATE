+from __future__ import annotations
+
+from collections import deque
+from itertools import combinations
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+CYCLE = (RED, GREEN, YELLOW)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_HEIGHTS = (10, 11, 12, 13)
