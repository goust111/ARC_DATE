+    centers, cross, claims = _analyze(g)
+    out = np.full_like(g, BG)
+    out[g == FG] = FG
+    out[cross] = CROSS
+    out[(claims == 1) & ~cross] = RAY
+    out[(claims >= 2) & ~cross] = OVERLAP
+    return out
