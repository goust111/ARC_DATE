+        for c in range(1, w - 1):
+            if not fg[r, c]:
+                continue
+            if all(fg[r + dr, c + dc] for dr, dc in DIRS4):
+                centers.append((r, c))
+    return centers
+
+
+def _cross_mask(shape: tuple[int, int], centers: list[tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for r, c in centers:
+        mask[r, c] = True
+        for dr, dc in DIRS4:
+            mask[r + dr, c + dc] = True
+    return mask
+
+
