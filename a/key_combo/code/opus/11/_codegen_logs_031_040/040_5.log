+                if 0 <= nr < h and grid[nr, c] == BG:
+                    grid[nr, c] = FG
+                    used_spur_cols.add(c)
+                    break
+
+    intended_centers = {(r, c0) for r in rows}
+    if not _validate_case(grid, intended_centers):
+        return None
+    return grid
+
