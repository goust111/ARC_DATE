+def _feasible_mask(traversable: np.ndarray, h: int, w: int) -> np.ndarray:
+    rows, cols = traversable.shape
+    out = np.zeros((rows - h + 1, cols - w + 1), dtype=bool)
+    for r in range(rows - h + 1):
+        for c in range(cols - w + 1):
