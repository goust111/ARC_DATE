+        hi = sc1 - 1
+        if lo > hi:
+            return False
+        length = random.randint(1, min(4, hi - lo + 1))
+        start = random.randint(lo, hi - length + 1)
+        mask[row, start : start + length] = False
+        return True
+    if w < 3 or sr1 - sr0 + 1 < h + 2:
