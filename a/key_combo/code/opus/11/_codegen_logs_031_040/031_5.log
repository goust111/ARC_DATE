+    choices = []
+    if sc0 - 1 >= zc0:
+        choices.append(sc0 - 1)
+    if sc1 + 1 <= zc1:
+        choices.append(sc1 + 1)
+    if not choices:
+        return False
+    cc = random.choice(choices)
+    mask[sr0 : sr1 + 1, cc] = True
