+        bend_r = random.randint(zr0, zr1)
+        pts = [(sr, sc), (sr, mid_c), (bend_r, mid_c), (bend_r, 0), (dr, 0)]
+    return _compress_waypoints(pts)
+
+
+def _marker_offset(side: str, h: int, w: int) -> tuple[int, int]:
