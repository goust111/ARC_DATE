+            b = out[i]
+            c = out[i + 1]
+            if (a[0] == b[0] == c[0]) or (a[1] == b[1] == c[1]):
+                changed = True
+                continue
+            nxt.append(b)
+        nxt.append(out[-1])
+        out = nxt
+    return out
