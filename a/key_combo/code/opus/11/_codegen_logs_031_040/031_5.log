+        dst_ok = 0 <= dst_r0 < feasible.shape[0] and 0 <= dst_c0 < feasible.shape[1] and feasible[dst_r0, dst_c0]
+        can_move = len(entries) == 1 and dst_ok and _reachable(feasible, entries[0], (dst_r0, dst_c0))
+        meta.append(
