+        else:
+            return None
+
+        canvas[mask] = ORANGE
+        canvas[anchor] = spec["anchor_color"]
+        occupied |= mask
+        occupied[anchor] = True
+        sprite_starts.append((patch, start_tl))
+
+    for patch, start_tl in sprite_starts:
+        r0, c0 = start_tl
+        if (canvas[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] != BG).any():
