+    blocked_indices = set(random.sample(range(len(sides)), blocked_count))
+    specs = []
+    for i, side in enumerate(sides):
+        blocked = i in blocked_indices
+        if blocked:
+            if random.random() < 0.5:
+                h, w = 3, random.choice([2, 3])
