+def _entry_candidates(feasible: np.ndarray, start: tuple[int, int]) -> list[tuple[int, int]]:
+    rows, cols = feasible.shape
+    out = []
+    for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
+        for step in range(1, max(rows, cols) + 1):
+            rr = start[0] + dr * step
+            cc = start[1] + dc * step
+            if not (0 <= rr < rows and 0 <= cc < cols):
+                break
+            if feasible[rr, cc]:
+                out.append((rr, cc))
+                break
