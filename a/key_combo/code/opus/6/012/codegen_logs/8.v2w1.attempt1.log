+            if other.idx in (a.idx, b.idx):
+                continue
+            if other.r0 == a.r0 and left_c < other.c0 < right_c:
+                return False
+        return True
+    if orient == "v":
+        top_r = min(a.r0, b.r0)
+        bot_r = max(a.r0, b.r0)
+        for other in frames:
+            if other.idx in (a.idx, b.idx):
