+        coords,
+        direction,
+        width,
+        wall_mask,
+        anchor_cells,
+    )
+    swept_no_wall = {cell for cell in swept if not bool((probe == WALL)[cell])}
+    if (swept_no_wall & reserved_paths) or ({tuple(rc) for rc in final_coords.tolist()} & reserved_outputs):
