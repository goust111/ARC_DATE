+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return {
+        "color": color,
+        "coords": coords,
+        "coord_set": {tuple(rc) for rc in cells},
+        "area": int(coords.shape[0]),
+        "bbox": (r0, c0, r1, c1),
+        "top_row": r0,
+        "left_col": c0,
