+
+def _component_from(
+    grid: np.ndarray,
+    start: tuple[int, int],
+    visited: np.ndarray,
+) -> dict:
+    color = int(grid[start])
+    q: deque[tuple[int, int]] = deque([start])
+    visited[start] = True
+    cells: list[tuple[int, int]] = []
+    while q:
+        r, c = q.popleft()
+        cells.append((int(r), int(c)))
+        for nr, nc in _neighbors4(r, c):
