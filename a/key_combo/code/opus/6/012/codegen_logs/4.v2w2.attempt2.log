+
+def _add_sprite(
+    grid: np.ndarray,
+    color: int,
+    coords: np.ndarray,
+    marker: tuple[int, int],
+    reserved_paths: set[tuple[int, int]],
+    reserved_outputs: set[tuple[int, int]],
+) -> bool:
+    H, W = grid.shape
+    coord_set = {tuple(rc) for rc in coords.tolist()}
+    mr, mc = marker
