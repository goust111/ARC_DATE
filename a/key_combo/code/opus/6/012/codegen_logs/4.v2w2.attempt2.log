SEGMENT_LEN_MAX = 6          # max segment length before a bend
MAX_PATHS_PER_SEED = 3       # cap on paths connecting one seed to hub
PATH_FIRST_ROUND_RETRIES = 60   # retries for first mandatory path per seed
