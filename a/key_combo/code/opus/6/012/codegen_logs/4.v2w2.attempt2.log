+
+def _parse_scene(grid: np.ndarray) -> dict:
+    g = np.asarray(grid, dtype=int)
+    wall_col = _wall_column(g)
+    anchors = _find_components(g, ANCHOR_COLORS)
+    sprites = _find_components(g, SPRITE_COLORS)
