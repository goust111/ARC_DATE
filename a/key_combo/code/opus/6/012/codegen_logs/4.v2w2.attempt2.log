+        direction = _direction_from_marker(probe, coords)
+    except AssertionError:
+        return False
+    width = _perp_width(coords, direction)
+    wall_mask = probe == WALL
+    anchor_cells = set()
+    for anchor in _find_components(probe, ANCHOR_COLORS):
+        anchor_cells |= anchor["coord_set"]
