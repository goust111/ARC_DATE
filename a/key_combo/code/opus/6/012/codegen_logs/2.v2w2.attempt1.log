+    source_specs = [hole_specs[i] for i in perm]
+    source_occupied = occupied.copy()
+    source_colors = SOURCE_COLORS[:num]
+    random.shuffle(source_colors)
+    sources_for_expected = []
+    for color, hole in zip(source_colors, source_specs):
+        mask = hole["mask"]
+        sh, sw = mask.shape
+        placed = False
+        for _ in range(80):
