+        tc0 = hole["template_c0"]
+        th = hole["template_h"]
+        tw = hole["template_w"]
+        if tc0 >= w // 2:
+            return None
+        template = np.full((th, tw), TEMPLATE, dtype=int)
+        hr, hc = hole["hole_offset"]
+        mask = hole["mask"]
+        template[hr : hr + mask.shape[0], hc : hc + mask.shape[1]][mask] = BG
+        if _can_place_mask(occupied, np.ones((th, tw), dtype=bool), tr0, tc0):
