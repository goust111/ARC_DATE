+from __future__ import annotations
+
+import itertools
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE = 5
+SOURCE_COLORS = [1, 3, 4]
+PALETTE_COLORS = [2, 6, 7, 8, 9]
+MAX_ATTEMPTS = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = box
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste_clip(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    rr0 = max(0, r0)
+    cc0 = max(0, c0)
+    rr1 = min(dst.shape[0], r0 + h)
+    cc1 = min(dst.shape[1], c0 + w)
+    if rr0 >= rr1 or cc0 >= cc1:
+        return
+    pr0 = rr0 - r0
+    pc0 = cc0 - c0
+    dst[rr0:rr1, cc0:cc1] = patch[pr0 : pr0 + (rr1 - rr0), pc0 : pc0 + (cc1 - cc0)]
+
+
+def _normalize_coords(coords: np.ndarray) -> tuple[tuple[int, int], ...]:
