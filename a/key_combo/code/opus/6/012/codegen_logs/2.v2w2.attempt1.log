+    g = np.asarray(grid, dtype=int)
+    palette, templates, sources, _palette_r0 = _parse(g)
+    template_by_key = {t["hole_key"]: t for t in templates}
+
+    out = g.copy()
+    for src in sources:
+        rr = src["coords"][:, 0]
+        cc = src["coords"][:, 1]
+        out[rr, cc] = BG
+
+    for src in sources:
