+        bg = int(palette[1, k - 1])
+        patch = np.where(np.kron(tpl["hole_mask"].astype(int), src["shape_mask"].astype(int)).astype(bool), fg, bg)
+        stamp_sigs.add((patch.shape, patch.tobytes()))
+    return len(stamp_sigs) == len(sources)
