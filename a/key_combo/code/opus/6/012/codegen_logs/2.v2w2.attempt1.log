+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(22, 26)
+    w = random.randint(27, 30)
+    inp = np.zeros((h, w), dtype=int)
+    palette = _ordered_palette()
+    palette_c0 = random.randint(w // 2 - 1, w // 2 + 2)
