_GEN_SKELETON_BBOX_MAX = (5, 5)
_GEN_MARKER_COUNT_RANGE = (3, 5)
_GEN_MIN_MOTIF_GAP = 4
_GEN_REQUIRED_COMBO_VARIANTS = 8

