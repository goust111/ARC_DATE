+    return tuple(sorted((int(r - r0), int(c - c0)) for r, c in coords))
+
+
+def _mask_from_key(key: tuple[tuple[int, int], ...]) -> np.ndarray:
+    h = max(r for r, _ in key) + 1
+    w = max(c for _, c in key) + 1
+    mask = np.zeros((h, w), dtype=bool)
+    for r, c in key:
+        mask[r, c] = True
