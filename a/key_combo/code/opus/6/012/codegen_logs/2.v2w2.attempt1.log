+    for src in sources:
+        rr = src["coords"][:, 0]
+        cc = src["coords"][:, 1]
+        out[rr, cc] = BG
+    for hole, src in zip(holes, sources):
+        k = _component_count(src["mask"])
+        fg = int(palette[0, k - 1])
+        bg = int(palette[1, k - 1])
+        patch = np.where(np.kron(hole["mask"].astype(int), src["mask"].astype(int)).astype(bool), fg, bg)
