+def _render_from_target(grid: np.ndarray, bars_by_rank: list[dict], target_rank: int, half_name: str) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    out[out == MARKER] = BAR
+
+    target = bars_by_rank[target_rank - 1]
