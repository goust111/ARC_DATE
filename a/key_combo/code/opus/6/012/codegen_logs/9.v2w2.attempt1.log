+        if heights[target_rank - 1] == 2 * heights[source_rank - 1]:
+            continue
+        return heights
+    return None
+
+
+def _pick_source_rank(count: int) -> int:
+    upper = count // 2
+    nontrivial = list(range(2, upper + 1))
+    if nontrivial and random.random() < 0.8:
+        return random.choice(nontrivial)
