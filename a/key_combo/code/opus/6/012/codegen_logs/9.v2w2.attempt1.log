+def _segment_bounds(top: int, bottom: int, half_name: str) -> tuple[int, int]:
+    height = bottom - top + 1
+    half = height // 2
+    if half_name == "top":
+        return top, top + half - 1
+    if half_name == "bottom":
+        return bottom - half + 1, bottom
+    raise ValueError(f"unknown half {half_name}")
