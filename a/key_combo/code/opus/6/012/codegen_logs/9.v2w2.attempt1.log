+    out[seg_top : seg_bottom + 1, target["col"]] = MARKER
+    if with_rays:
+        _trace_ray(out, seg_top, target["col"], -1, -1)
+        _trace_ray(out, seg_top, target["col"], -1, 1)
+        _trace_ray(out, seg_bottom, target["col"], 1, -1)
+        _trace_ray(out, seg_bottom, target["col"], 1, 1)
+    return out
