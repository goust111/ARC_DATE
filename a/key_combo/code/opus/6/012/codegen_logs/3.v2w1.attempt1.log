+    if hub_size == 5 and len(parsed["seeds"]) not in (2, 3):
+        return None
+    if count_hist == [1, 1, 1]:
+        return None
+
+    return g, {"hub_size": hub_size, "counts": counts}
+
+
+def generate_input() -> np.ndarray:
