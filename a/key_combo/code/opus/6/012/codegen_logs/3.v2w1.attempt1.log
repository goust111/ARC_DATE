+    parsed = _extract_structure(g)
+    parsed_counts = sorted(int(seed["count"]) for seed in parsed["seeds"])
+    if parsed["hub_size"] != hub_size or parsed_counts != sorted(counts):
+        return None
+
+    out = _transform_from_structure(parsed)
