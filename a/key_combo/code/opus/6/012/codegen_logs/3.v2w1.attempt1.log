+
+    for req in requests:
+        path = _route_branch(blocked, path_mask, hub_mask, seed_id_grid, req["start"], req["target"], req["seed_id"])
+        if path is None:
+            return None
+        for r, c in path:
+            g[r, c] = PATH
+            blocked[r, c] = True
+            path_mask[r, c] = True
