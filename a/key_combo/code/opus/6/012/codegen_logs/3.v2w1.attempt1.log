+    if count > 1:
+        sh = sw = 3
+    else:
+        sh = random.choice([2, 3])
+        sw = random.choice([2, 3])
+
+    if side == "N":
+        max_r0 = hr0 - gap - sh
+        lo_c = max(1, hc0 - 5)
+        hi_c = min(w - sw - 2, hc1 + 2)
+        if max_r0 < 1 or lo_c > hi_c:
