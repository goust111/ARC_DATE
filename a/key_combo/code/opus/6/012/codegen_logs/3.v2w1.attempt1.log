+    if hub_size == 4:
+        seed_count = 2
+        branch_count = random.choice([3, 4, 5])
+        count_options = {3: [(1, 2)], 4: [(1, 3), (2, 2)], 5: [(2, 3)]}[branch_count]
+    else:
+        seed_count = random.choices([2, 3], weights=[2, 3])[0]
+        if seed_count == 2:
