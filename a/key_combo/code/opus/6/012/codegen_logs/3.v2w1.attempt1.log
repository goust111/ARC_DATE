+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+PATH = 5
+SEED_COLORS = (1, 2, 3, 4, 6)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SIDES = ("N", "S", "W", "E")
