+        "W": {1: [("E",), ("N",), ("S",)], 2: [("E", "N"), ("E", "S"), ("N", "S")], 3: [("E", "N", "S")]},
+        "E": {1: [("W",), ("N",), ("S",)], 2: [("W", "N"), ("W", "S"), ("N", "S")], 3: [("W", "N", "S")]},
