    gap = (r + dr, c + dc)
    exterior = (r + GEN_EXTERIOR_STEP * dr, c + GEN_EXTERIOR_STEP * dc)

    r0, r1 = r - GEN_FRAME_RADIUS, r + GEN_FRAME_RADIUS + 1
    c0, c1 = c - GEN_FRAME_RADIUS, c + GEN_FRAME_RADIUS + 1
