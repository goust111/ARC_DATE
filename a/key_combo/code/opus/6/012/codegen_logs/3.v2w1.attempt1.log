+        "hub_bbox": (hub_r0, hub_c0, hub_r1, hub_c1),
+        "hub_size": hub_size,
+        "hub_mask": hub_mask,
+        "branch_components": branch_components,
+        "branch_to_seed": branch_to_seed,
