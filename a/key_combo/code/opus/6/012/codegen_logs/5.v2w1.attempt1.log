+        if cand is None:
+            return None
+        input_grid[cand] = int(color)
+        distractors[color] = cand
+
+    if not _semantic_check(input_grid, cycles_by_color, distractors, palette_cells):
+        return None
+    return input_grid
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
