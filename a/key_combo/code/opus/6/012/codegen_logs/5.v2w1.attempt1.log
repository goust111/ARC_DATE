+from arc_utils import Color, label_mask
+
+
+POLY_COLORS = (Color.BLUE, Color.GREEN, Color.YELLOW)
+FILL_A = Color.GREY
+FILL_B = Color.PINK
+PALETTE_COLORS = {Color.GREY, Color.PINK}
+
+GRID_MIN = 18
+GRID_MAX = 24
+GEN_ATTEMPTS = 400
+PLACE_ATTEMPTS = 120
+DISTRACTOR_ATTEMPTS = 300
