+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+TOP_COLOR = 1
+RIGHT_COLOR = 2
+BOTTOM_COLOR = 3
+LEFT_COLOR = 4
+MARKER_COLOR = 5
+HINT_COLOR = 6
+MAIN_COLOR = 7
+
+SIDE_TO_COLOR = {
+    "top": TOP_COLOR,
