+from __future__ import annotations
+
+from collections import Counter, deque
+import random
+
+import numpy as np
+
+
+BG = 0
+TOP_COLOR = 1
+RIGHT_COLOR = 2
+BOTTOM_COLOR = 3
+LEFT_COLOR = 4
+MARKER_COLOR = 5
+HINT_COLOR = 6
+MAIN_COLOR = 7
+
+SIDE_TO_COLOR = {
+    "top": TOP_COLOR,
+    "bottom": BOTTOM_COLOR,
+    "left": LEFT_COLOR,
+    "right": RIGHT_COLOR,
+}
+SIDE_TO_STEP = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+SIDES = tuple(SIDE_TO_COLOR)
+
+GRID_ROWS = (13, 16)
+GRID_COLS = (13, 16)
+BLOB_AREA = (15, 25)
+GEN_ATTEMPTS = 400
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _largest_component(mask: np.ndarray) -> set[tuple[int, int]]:
+    comps = _components(mask)
+    assert comps, "expected at least one component"
+    comps.sort(key=len, reverse=True)
+    if len(comps) > 1:
+        assert len(comps[0]) > len(comps[1]), "largest component must be unique"
+    return set(comps[0])
+
+
+def _is_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    q = deque([start])
+    seen = {start}
+    while q:
+        r, c = q.popleft()
+        for nb in _neighbors4(r, c):
+            if nb in cells and nb not in seen:
+                seen.add(nb)
+                q.append(nb)
+    return len(seen) == len(cells)
+
+
+def _frame_grid(h: int, w: int) -> np.ndarray:
+    g = np.full((h, w), BG, dtype=int)
+    g[0, 1:-1] = TOP_COLOR
+    g[-1, 1:-1] = BOTTOM_COLOR
+    g[1:-1, 0] = LEFT_COLOR
+    g[1:-1, -1] = RIGHT_COLOR
+    return g
+
