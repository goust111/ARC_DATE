+        if int(g[r, w - 1]) == HINT_COLOR:
+            hints.append((r, w - 1, "right"))
+    return hints
+
+
+def _aligned_hints(g: np.ndarray, r: int, c: int) -> list[tuple[int, int, str]]:
+    out = []
+    for hr, hc, side in _find_side_hints(g):
+        if hr == 0 or hr == g.shape[0] - 1:
+            if hc == c:
+                out.append((hr, hc, side))
+        else:
+            if hr == r:
