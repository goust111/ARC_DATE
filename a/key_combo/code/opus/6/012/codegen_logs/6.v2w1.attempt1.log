+def _marker_destination(r: int, c: int, side: str, steps: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    if side == "top":
+        return max(1, r - steps), c
+    if side == "bottom":
+        return min(h - 2, r + steps), c
+    if side == "left":
+        return r, max(1, c - steps)
+    return r, min(w - 2, c + steps)
