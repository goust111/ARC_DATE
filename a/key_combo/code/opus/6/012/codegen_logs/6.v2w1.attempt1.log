+            inp,
+            blob,
+            side,
+            steps,
+            force_clamp,
+            used_rows,
+            used_cols,
+            reserved_cells,
+        )
+        if not candidates:
+            return None
+        r, c, nr, nc = candidates[0]
+        used_rows.add(r)
+        used_cols.add(c)
+        reserved_cells.add((r, c))
+        reserved_cells.add((nr, nc))
+        inp[r, c] = MARKER_COLOR
+        if side == "top":
+            hint = (0, c)
+        elif side == "bottom":
+            hint = (h - 1, c)
+        elif side == "left":
+            hint = (r, 0)
+        else:
+            hint = (r, w - 1)
+        inp[hint] = HINT_COLOR
+        isolated_records.append({"src": (r, c), "dst": (nr, nc), "hint": hint, "side": side})
+
+    if not _validate_generated_case(inp, blob, embedded, isolated_records):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _build_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input")

