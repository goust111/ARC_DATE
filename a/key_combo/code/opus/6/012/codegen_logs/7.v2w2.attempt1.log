+PALETTE = (1, 2, 3, 4, 6)
+TEMPLATE_SIZE = 5
+MIN_VISIBLE = 4
+
+GRID_H_RANGE = (13, 18)
+GRID_W_RANGE = (13, 18)
+SPRITE_COUNTS = (4, 5)
+MAX_GENERATION_ATTEMPTS = 600
+MAX_NOISE_ATTEMPTS = 120
