+
+def _cells_for_offset(shape: tuple[int, int], offset: tuple[int, int]) -> set[tuple[int, int]]:
+    h, w = shape
+    r0, c0 = offset
+    cells = set()
+    for dr, dc in RING5:
+        r = r0 + dr
+        c = c0 + dc
+        if 0 <= r < h and 0 <= c < w:
