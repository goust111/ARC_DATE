+        visible_order[i]: int(visible_order[i - 1])
+        for i in range(len(visible_order))
+    }
+
+    out = np.full_like(g, BG)
+    for color in layer_order:
+        paint = rotated_color[color]
+        for r, c in sprites[color]["expected"]:
