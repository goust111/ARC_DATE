+def _sample_distractors(control: tuple[int, int], count: int) -> list[tuple[int, int, int]]:
+    blocked = {control}
+    for nbr in neighbors8(*control):
+        if 0 <= nbr[0] < GRID_SIZE and 0 <= nbr[1] < GRID_SIZE:
