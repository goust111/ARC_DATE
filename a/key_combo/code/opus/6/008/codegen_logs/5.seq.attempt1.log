+from __future__ import annotations
+
+import random
+from typing import Iterable
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+OBJECT_COLORS = (1, 2, 4, 7)
+NEIGHBORS8 = tuple(
+    (dr, dc)
+    for dr in (-1, 0, 1)
+    for dc in (-1, 0, 1)
+    if not (dr == 0 and dc == 0)
+)
+
+GEN_RETRIES = 400
+PLACE_RETRIES = 160
