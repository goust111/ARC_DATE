+def _sample_blob_size() -> int:
+    sizes = [2, 3, 4, 5, 6, 7, 8, 9, 10]
+    weights = [8, 9, 9, 8, 6, 4, 3, 1, 1]
+    return int(random.choices(sizes, weights=weights, k=1)[0])
