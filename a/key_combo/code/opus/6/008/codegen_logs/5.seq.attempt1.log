+def _component_side(coords: np.ndarray, rect: tuple[int, int, int, int]) -> str:
+    r0, c0, r1, c1 = rect
+    inside = (
+        (coords[:, 0] >= r0)
+        & (coords[:, 0] <= r1)
+        & (coords[:, 1] >= c0)
+        & (coords[:, 1] <= c1)
+    )
+    if bool(np.all(inside)):
+        return "inside"
+    if not bool(np.any(inside)):
