+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors8(r: int, c: int) -> Iterable[tuple[int, int]]:
+    for dr, dc in NEIGHBORS8:
+        yield r + dr, c + dc
