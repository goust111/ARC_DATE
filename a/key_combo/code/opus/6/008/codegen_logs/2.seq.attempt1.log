+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+RED = 2
+SEED_COLORS = (1, 2, 3, 4, 7)
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+GRID_RANGE = (27, 29)
+GEN_ATTEMPTS = 400
