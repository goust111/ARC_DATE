+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _most_common_color(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _component_lists(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _touches_border(coords: list[tuple[int, int]], shape: tuple[int, int]) -> bool:
+    h, w = shape
+    return any(r == 0 or c == 0 or r == h - 1 or c == w - 1 for r, c in coords)
+
+
+def _shell_of(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    shell: set[tuple[int, int]] = set()
+    for r, c in cells:
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) not in cells:
+                shell.add((nr, nc))
+    return shell
+
+
+def _is_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    start = next(iter(cells))
+    seen = {start}
+    q = deque([start])
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
+
+
+def _normalize_cells(cells: set[tuple[int, int]]) -> set[tuple[int, int]]:
+    min_r = min(r for r, _ in cells)
+    min_c = min(c for _, c in cells)
+    return {(r - min_r, c - min_c) for r, c in cells}
+
+
+def _port_candidates(
+    cells: set[tuple[int, int]], side: str
+) -> list[dict[str, tuple[int, int]]]:
+    dr, dc = DIRS[side]
+    shell = _shell_of(cells)
+    candidates = []
+    seen_gates = set()
+    for r, c in cells:
+        gate = (r + dr, c + dc)
+        outer = (r + 2 * dr, c + 2 * dc)
+        if gate not in shell or outer in cells or outer in shell:
+            continue
+        if sum((gr, gc) in cells for gr, gc in _neighbors4(*gate)) != 1:
+            continue
+        if gate in seen_gates:
