+                            (item["gates"][1][0] + r0, item["gates"][1][1] + c0),
+                        ],
+                        "outers": [
+                            (item["outers"][0][0] + r0, item["outers"][0][1] + c0),
+                            (item["outers"][1][0] + r0, item["outers"][1][1] + c0),
+                        ],
+                    }
+                )
