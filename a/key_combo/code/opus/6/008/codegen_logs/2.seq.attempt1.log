+            full = set(path) | set(src["gates"]) | set(src["outers"]) | set(dst["gates"]) | set(dst["outers"])
+            if any(not _in_bounds(shape, *cell) for cell in full):
+                continue
+            if any(grid[r, c] != BG and cell not in allowances for cell in full for r, c in [cell]):
