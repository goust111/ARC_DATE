+        exp_a = _expanded_bbox(first_bbox, shape)
+        exp_b = _expanded_bbox(bbox, shape)
+        if exp_a[2] < exp_b[0] or exp_b[2] < exp_a[0] or exp_a[3] < exp_b[1] or exp_b[3] < exp_a[1]:
