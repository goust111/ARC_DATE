+
+def _mask_from_rows(rows: list[str]) -> np.ndarray:
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+HOLE_MASKS = [
+    _mask_from_rows(["111", "101", "111"]),
+    _mask_from_rows(["1111", "1001", "1111"]),
+    _mask_from_rows(["111", "101", "101", "111"]),
