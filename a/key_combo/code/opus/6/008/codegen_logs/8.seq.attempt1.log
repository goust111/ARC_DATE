+    holes: set[tuple[int, int]],
+    wedge_footprint: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> set[tuple[int, int]]:
+    h, w = shape
+    r0, c0, r1, c1 = bbox
+    rr0 = max(0, r0 - 1)
+    cc0 = max(0, c0 - 1)
+    rr1 = min(h - 1, r1 + 1)
+    cc1 = min(w - 1, c1 + 1)
