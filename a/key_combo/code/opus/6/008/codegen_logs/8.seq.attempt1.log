+
+
+def _place_relative_object(
+    mask: np.ndarray,
+    shape: tuple[int, int],
+    reserved: set[tuple[int, int]],
+    first_cells: set[tuple[int, int]],
+    first_holes: set[tuple[int, int]],
+    wedge_footprint: set[tuple[int, int]],
+) -> tuple[int, int] | None:
