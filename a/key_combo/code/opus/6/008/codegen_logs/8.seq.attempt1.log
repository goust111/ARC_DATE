+
+
+def _placement_ok(
+    cells: set[tuple[int, int]],
+    reserved: set[tuple[int, int]],
+    shape: tuple[int, int],
+) -> bool:
+    h, w = shape
+    for r, c in cells:
+        if not (1 <= r < h - 1 and 1 <= c < w - 1):
