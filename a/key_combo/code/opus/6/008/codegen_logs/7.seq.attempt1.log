+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+WALL = 5
+ARROW_PALETTE = (1, 2, 3, 4, 7)
+DIAG_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+BOUNCE_TYPES = ("front", "row", "col")
