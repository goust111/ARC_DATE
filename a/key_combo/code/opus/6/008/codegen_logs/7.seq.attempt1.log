+    counts: list[int] = []
+    traces: list[list[dict]] = []
+    for arrow in arrows:
+        count, trace = _simulate_arrow(grid, arrow, all_arrow_cells)
+        counts.append(int(count))
+        traces.append(trace)
+    return arrows, counts, traces
