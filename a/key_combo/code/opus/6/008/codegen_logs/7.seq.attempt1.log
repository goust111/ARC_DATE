+    if sampled is None:
+        return None
+    desired_counts, want_duplicate = sampled
+    positive = [i for i, count in enumerate(desired_counts) if count > 0]
+    if not positive:
+        return None
+    required_prefix: dict[int, list[str]] = {i: [] for i in range(n_arrows)}
+    if sum(desired_counts) >= 2:
+        front_holder = max(positive, key=lambda i: desired_counts[i])
+        required_prefix[front_holder].append("front")
+        remaining_side_holders = [i for i in positive if i != front_holder]
+        if remaining_side_holders:
+            side_holder = rng.choice(remaining_side_holders)
+            required_prefix[side_holder].append(rng.choice(("row", "col")))
+        elif desired_counts[front_holder] >= 2:
+            required_prefix[front_holder].append(rng.choice(("row", "col")))
+        else:
+            return None
