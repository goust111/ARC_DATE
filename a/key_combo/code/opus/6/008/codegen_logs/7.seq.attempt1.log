+                break
+            state = (int(pos[0]), int(pos[1]), int(cur_dir[0]), int(cur_dir[1]))
+            if state in seen_states:
+                ok = False
+                break
+            seen_states.add(state)
+        if not ok:
+            continue
+
+        return {
+            "color": None,
+            "bbox": (int(r0), int(c0), int(r0 + 1), int(c0 + 1)),
+            "cells": cells,
+            "start": start,
+            "dir": direction,
+            "walls": local_walls,
+            "guard": local_guard,
+            "bounce_types": ["row", "front", "col"],
