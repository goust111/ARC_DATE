+def _plan_front_macro_arrow(
+    rng: random.Random,
+    shape: tuple[int, int],
+    all_arrow_cells: set[tuple[int, int]],
+    all_wall_cells: set[tuple[int, int]],
+    global_bg_guard: set[tuple[int, int]],
+) -> dict | None:
+    h, w = map(int, shape)
+    for _ in range(ARROW_ATTEMPTS):
+        r0 = rng.randint(1, h - 3)
+        c0 = rng.randint(1, w - 3)
