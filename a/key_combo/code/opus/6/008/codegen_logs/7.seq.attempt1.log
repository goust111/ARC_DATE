+        if max(counts) == 0:
+            continue
+        if sum(counts) > 16:
+            continue
+        if want_duplicate and len(set(counts)) == len(counts):
+            continue
+        if not want_duplicate and len(set(counts)) < len(counts) and rng.random() < 0.5:
