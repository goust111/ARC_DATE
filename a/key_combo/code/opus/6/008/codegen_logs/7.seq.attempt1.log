+    if want_duplicate and len(set(counts)) == len(counts):
+        return None
+    if not want_duplicate and len(set(counts)) < len(counts) and rng.random() < 0.6:
+        return None
+
+    out = main(grid)
+    if out.shape[1] != len(arrows):
+        return None
+    return grid
