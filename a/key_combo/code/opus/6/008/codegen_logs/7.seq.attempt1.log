+                rng.shuffle(bounce_choices)
+            applied = None
+            for bounce_type in bounce_choices:
+                result = _apply_bounce(
+                    shape,
+                    pos,
+                    cur_dir,
+                    bounce_type,
+                    all_arrow_cells | cells,
+                    all_wall_cells | local_walls,
+                    global_bg_guard,
