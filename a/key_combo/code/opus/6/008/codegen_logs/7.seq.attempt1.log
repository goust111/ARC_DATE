+        direction = (-1 if start[0] == r0 else 1, -1 if start[1] == c0 else 1)
+        dr, dc = direction
+        if not _in_bounds(shape, int(start[0] - dr), int(start[1] + 4 * dc)):
+            continue
+        if not _in_bounds(shape, int(start[0] - 4 * dr), int(start[1] + 4 * dc)):
+            continue
