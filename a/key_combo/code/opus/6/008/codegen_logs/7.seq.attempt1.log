+        counts = [rng.randint(0, 5) for _ in range(n_arrows)]
+        if len(set(counts)) == 1:
+            continue
+        if max(counts) == 0:
+            continue
+        if sum(counts) > 16:
+            continue
+        if want_duplicate and len(set(counts)) == len(counts):
+            continue
+        if not want_duplicate and len(set(counts)) < len(counts) and rng.random() < 0.5:
+            continue
+        return counts, want_duplicate
+    return None
