+        return None
+    if new_pos in wall_cells or new_pos in arrow_cells:
+        return None
+
+    new_walls.add(wall_pos)
+    new_guard = {cell for cell in needed_clear if _in_bounds(shape, cell[0], cell[1])}
+    new_guard.add(new_pos)
