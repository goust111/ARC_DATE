+            local_guard |= {cell for cell in _step_guard(pos, cur_dir) if _in_bounds(shape, cell[0], cell[1])}
+            pos = (nr, nc)
+            exit_steps += 1
+            if exit_steps > h * w:
+                ok = False
+                break
+            state = (int(pos[0]), int(pos[1]), int(cur_dir[0]), int(cur_dir[1]))
+            if state in seen_states:
