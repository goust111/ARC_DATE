+        if not ok:
+            continue
+
+        combined_walls = all_wall_cells | local_walls
+        combined_arrows = all_arrow_cells | cells
+        exit_steps = 0
+        while True:
+            nr = int(pos[0] + cur_dir[0])
+            nc = int(pos[1] + cur_dir[1])
+            if not _in_bounds(shape, nr, nc):
