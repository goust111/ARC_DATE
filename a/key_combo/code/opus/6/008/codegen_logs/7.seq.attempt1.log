+    assert checked >= 1, "removing a bounce wall must change at least one count"
+
+    return arrows, counts, traces
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(18, 24)
+    w = rng.randint(18, 24)
+    n_arrows = rng.randint(3, 5)
