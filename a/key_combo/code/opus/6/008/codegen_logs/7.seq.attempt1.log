+    total_bounces = sum(counts)
+    event_kinds = {
+        step["event"]
+        for trace in traces
+        for step in trace
+        if step["event"] != "none"
+    }
+    if total_bounces >= 2:
+        assert "front" in event_kinds
+        assert any(kind in event_kinds for kind in ("row", "col", "row+col"))
