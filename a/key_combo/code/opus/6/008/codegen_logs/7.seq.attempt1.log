+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(18, 24)
+    w = rng.randint(18, 24)
+    n_arrows = rng.randint(3, 5)
+    sampled = _sample_counts(rng, n_arrows)
+    if sampled is None:
+        return None
+    desired_counts, want_duplicate = sampled
+    positive = [i for i, count in enumerate(desired_counts) if count > 0]
+    if not positive:
+        return None
+    required_prefix: dict[int, list[str]] = {i: [] for i in range(n_arrows)}
+    if sum(desired_counts) >= 2:
+        front_holder = max(positive, key=lambda i: desired_counts[i])
+        required_prefix[front_holder].append("front")
+        remaining_side_holders = [i for i in positive if i != front_holder]
+        if remaining_side_holders:
+            side_holder = rng.choice(remaining_side_holders)
+            required_prefix[side_holder].append(rng.choice(("row", "col")))
+        elif desired_counts[front_holder] >= 2:
+            required_prefix[front_holder].append(rng.choice(("row", "col")))
+        else:
+            return None
+
+    all_arrow_cells: set[tuple[int, int]] = set()
+    all_wall_cells: set[tuple[int, int]] = set()
+    global_bg_guard: set[tuple[int, int]] = set()
+    plans: list[dict] = []
+
+    order = list(range(n_arrows))
+    rng.shuffle(order)
+    for idx in order:
+        plan = _plan_arrow(
+            rng,
+            (h, w),
+            desired_counts[idx],
+            all_arrow_cells,
+            all_wall_cells,
+            global_bg_guard,
+            want_duplicate,
+            tuple(required_prefix[idx]),
+        )
+        if plan is None:
+            return None
+        plans.append(plan)
+        all_arrow_cells |= plan["cells"]
+        all_wall_cells |= plan["walls"]
+        global_bg_guard |= plan["guard"]
+
+    total_bounces = sum(desired_counts)
+    used_types = {bounce_type for plan in plans for bounce_type in plan["bounce_types"]}
+    if total_bounces >= 2 and ("front" not in used_types or not ({"row", "col"} & used_types)):
+        return None
+    if len(all_wall_cells) > 20:
+        return None
+
+    colors = list(ARROW_PALETTE)
+    rng.shuffle(colors)
+    for plan, color in zip(plans, colors[:n_arrows]):
+        plan["color"] = int(color)
+
+    grid = np.zeros((h, w), dtype=int)
+    for plan in plans:
+        for r, c in plan["cells"]:
+            grid[r, c] = int(plan["color"])
+    for r, c in all_wall_cells:
+        grid[r, c] = WALL
+
+    wall_target = rng.randint(max(8, len(all_wall_cells)), 20)
