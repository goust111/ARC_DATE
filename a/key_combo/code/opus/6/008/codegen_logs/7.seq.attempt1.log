+
+    if bounce_type == "front":
+        wall_pos = diag
+        needed_clear |= {row_side, col_side}
+        new_dir = (-int(dr), -int(dc))
+    elif bounce_type == "row":
+        wall_pos = row_side
+        needed_clear |= {diag, col_side}
+        new_dir = (-int(dr), int(dc))
+    else:
