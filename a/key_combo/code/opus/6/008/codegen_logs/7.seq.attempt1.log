+def _arrow_cells_from_bbox(r0: int, c0: int, start: tuple[int, int]) -> set[tuple[int, int]]:
+    bbox_cells = {
+        (int(r0), int(c0)),
+        (int(r0), int(c0 + 1)),
+        (int(r0 + 1), int(c0)),
+        (int(r0 + 1), int(c0 + 1)),
+    }
+    bbox_cells.remove((int(start[0]), int(start[1])))
+    return bbox_cells
+
