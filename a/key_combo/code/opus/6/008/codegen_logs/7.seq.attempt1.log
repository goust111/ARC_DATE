+        if (nr, nc) in all_arrow_cells - self_cells:
+            return int(bounces), trace
+        assert (nr, nc) not in self_cells, "invalid input: ray entered its own arrow body"
+        assert int(g[nr, nc]) != WALL, "invalid input: reflected move landed on a wall"
