+        plan = _plan_arrow(
+            rng,
+            (h, w),
+            desired_counts[idx],
+            all_arrow_cells,
+            all_wall_cells,
+            global_bg_guard,
+            want_duplicate,
+            tuple(required_prefix[idx]),
