+
+
+def _straight_ok(
+    shape: tuple[int, int],
+    pos: tuple[int, int],
+    direction: tuple[int, int],
+    arrow_cells: set[tuple[int, int]],
+    wall_cells: set[tuple[int, int]],
+) -> bool:
+    r, c = map(int, pos)
+    dr, dc = map(int, direction)
+    diag = (int(r + dr), int(c + dc))
+    row_side = (int(r + dr), int(c))
+    col_side = (int(r), int(c + dc))
