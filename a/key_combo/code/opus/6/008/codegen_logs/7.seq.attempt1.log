+            if not _straight_ok(shape, pos, cur_dir, all_arrow_cells | cells, all_wall_cells | local_walls):
+                ok = False
+                break
+            local_guard |= {cell for cell in _step_guard(pos, cur_dir) if _in_bounds(shape, cell[0], cell[1])}
