+        return {
+            "color": None,
+            "bbox": (int(r0), int(c0), int(r0 + 1), int(c0 + 1)),
+            "cells": cells,
+            "start": start,
+            "dir": direction,
+            "walls": local_walls,
+            "guard": local_guard,
+            "bounce_types": ["row", "front", "col"],
