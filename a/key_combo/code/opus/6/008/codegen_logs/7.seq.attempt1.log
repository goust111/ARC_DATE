+def _histogram(arrows: list[dict], counts: list[int]) -> np.ndarray:
+    height = max(1, max(counts))
+    out = np.zeros((height, len(arrows)), dtype=int)
+    order = sorted(
+        range(len(arrows)),
+        key=lambda i: (int(counts[i]), int(arrows[i]["bbox"][0]), int(arrows[i]["bbox"][1])),
