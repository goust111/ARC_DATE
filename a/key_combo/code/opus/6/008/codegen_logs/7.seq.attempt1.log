+
+def _simulate_arrow(grid: np.ndarray, arrow: dict, all_arrow_cells: set[tuple[int, int]]) -> tuple[int, list[dict]]:
+    g = np.asarray(grid, dtype=int)
+    r, c = map(int, arrow["start"])
+    dr, dc = map(int, arrow["dir"])
