+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, cnts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(cnts)])
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components4(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = _bbox(coords)
+    return mask[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _adjacent_sites_from_topleft(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c + 1), (r + 3, c + 1), (r + 1, c - 1), (r + 1, c + 3)]
+
+
+def _find_template(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
+    blue_mask = grid == TEMPLATE_COLOR
+    candidates = []
