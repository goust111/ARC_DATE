        if coords is None:
            return False
        _paint_coords(grid, coords, color)
        placed_blobs.append(coords)
    return True


def _choose_placeable_blob(grid: np.ndarray, placed_blobs: list[set], rng) -> set | None:
    for _ in range(BLOB_PLACE_TRIES):
