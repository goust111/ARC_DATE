+    sc0 = left_margin
+    dr0 = sr0 + k_v * period_v
+    dc0 = sc0 + k_h * period_h
+    sr1 = sr0 + ANCHOR_SIZE - 1
+    sc1 = sc0 + ANCHOR_SIZE - 1
+    dr1 = dr0 + ANCHOR_SIZE - 1
+    dc1 = dc0 + ANCHOR_SIZE - 1
