+        (sr0, sc0, sr1, sc1),
+        (dr0, dc0, dr1, dc1),
+        patch,
+        slots,
+        c1,
+        period_h,
+        r1,
+        period_v,
+    )
+
+    if not _visible_source_detail(expected, (sr0, sc0, sr1, sc1), patch):
+        return None
+    if not _visible_source_detail(expected, (sr0, dc0, sr1, dc1), patch):
+        return None
+    if not _visible_source_detail(expected, (dr0, sc0, dr1, sc1), patch):
