+def _periodic_positions(lo: int, hi: int, phase: int, period: int) -> list[int]:
+    positions = []
+    k0 = int(np.floor((lo - phase) / period))
+    k1 = int(np.ceil((hi - phase) / period))
+    for k in range(k0, k1 + 1):
+        pos = phase + k * period
+        if lo <= pos <= hi:
