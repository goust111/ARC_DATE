+
+BG = 0
+GREY = 5
+ANCHOR_SIZE = 5
+SLOT_OFFSETS = {
+    "cross": (1, 1),
+    "top_border": (1, 3),
+    "side_border": (3, 1),
+    "periodic": (3, 3),
+}
+PALETTE = [1, 2, 3, 4, 6, 7, 8, 9]
+MAX_RETRIES = 400
