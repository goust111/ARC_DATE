+
+    rows = random.randint(struct_h + 2, min(30, struct_h + 5))
+    cols = random.randint(struct_w + 2, min(30, struct_w + 5))
+    top_margin = random.randint(1, rows - struct_h - 1)
+    left_margin = random.randint(1, cols - struct_w - 1)
+
