+from __future__ import annotations
+
+from collections import deque
+import itertools
+import random
+
+import numpy as np
+
+
+WALL = 5
+BG = 0
+ROOM_H = 3
+ROOM_W = 4
+SOURCE_W = 2
+MIN_OBJECTS = 5
+MAX_OBJECTS = 8
+MAX_ATTEMPTS = 400
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _component_dict(mask: np.ndarray, color: int) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(cells)
+            comp_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                comp_mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": cells,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": comp_mask,
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _all_components(grid: np.ndarray) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in {BG, WALL}):
+        comps.extend(_component_dict(grid == color, color))
+    return comps
+
+
+def _is_solid_rect(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return comp["area"] == (r1 - r0 + 1) * (c1 - c0 + 1) and bool(np.all(comp["mask"]))
+
+
+def _center2(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 + r1 + 1, c0 + c1 + 1
+
+
+def _contains_coord(x: float, limit: int) -> list[int]:
+    vals = {int(np.floor(x + 1e-9))}
+    if abs(x - round(x)) < 1e-9:
+        vals.add(int(round(x)) - 1)
+    return [v for v in vals if 0 <= v < limit]
+
+
+def _edge_open(open_mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> bool:
+    h, w = open_mask.shape
+    ar, ac = a
+    br, bc = b
+    mr = (ar + br) / 4.0
+    mc = (ac + bc) / 4.0
+    rows = _contains_coord(mr, h)
+    cols = _contains_coord(mc, w)
+    return any(open_mask[r, c] for r in rows for c in cols)
+
+
+def _edge_maps(open_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = open_mask.shape
+    horiz = np.zeros((2 * h + 1, 2 * w), dtype=bool)
+    vert = np.zeros((2 * h, 2 * w + 1), dtype=bool)
+
+    for r in range(2 * h + 1):
+        mr = r / 2.0
+        rows = _contains_coord(mr, h)
+        for c in range(2 * w):
+            mc = (c + 0.5) / 2.0
+            cols = _contains_coord(mc, w)
+            horiz[r, c] = any(open_mask[rr, cc] for rr in rows for cc in cols)
+
+    for r in range(2 * h):
+        mr = (r + 0.5) / 2.0
+        rows = _contains_coord(mr, h)
+        for c in range(2 * w + 1):
+            mc = c / 2.0
+            cols = _contains_coord(mc, w)
+            vert[r, c] = any(open_mask[rr, cc] for rr in rows for cc in cols)
+
+    return horiz, vert
+
+
+def _shortest_path_info(
+    edge_maps: tuple[np.ndarray, np.ndarray], start: tuple[int, int], goal: tuple[int, int]
+) -> tuple[int | None, int]:
+    horiz, vert = edge_maps
+    node_h = horiz.shape[0]
+    node_w = vert.shape[1]
+    q = deque([start])
+    dist = np.full((node_h, node_w), -1, dtype=int)
+    count = np.zeros((node_h, node_w), dtype=np.uint8)
+    dist[start] = 0
+    count[start] = 1
+
+    while q:
+        cur = q.popleft()
+        cr, cc = cur
+        nd = dist[cr, cc] + 1
+        neighbors = []
+        if cr > 0 and vert[cr - 1, cc]:
+            neighbors.append((cr - 1, cc))
+        if cr + 1 < node_h and vert[cr, cc]:
+            neighbors.append((cr + 1, cc))
+        if cc > 0 and horiz[cr, cc - 1]:
+            neighbors.append((cr, cc - 1))
+        if cc + 1 < node_w and horiz[cr, cc]:
+            neighbors.append((cr, cc + 1))
+        for nr, nc in neighbors:
+            if dist[nr, nc] == -1:
+                dist[nr, nc] = nd
+                count[nr, nc] = count[cr, cc]
+                q.append((nr, nc))
+            elif dist[nr, nc] == nd:
+                count[nr, nc] = min(2, int(count[nr, nc]) + int(count[cr, cc]))
+
+    goal_dist = int(dist[goal])
+    return (goal_dist if goal_dist >= 0 else None), int(count[goal])
+
+
+def _draw_walls(open_mask: np.ndarray) -> np.ndarray:
+    h, w = open_mask.shape
+    grid = np.full((h, w), BG, dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if open_mask[r, c]:
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc]:
+                    grid[r, c] = WALL
+                    break
+    return grid
+
+
