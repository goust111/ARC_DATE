+    random.shuffle(specs)
+
+    room_count = random.randint(MIN_OBJECTS, min(MAX_OBJECTS, len(specs)))
+    rooms: list[dict] = []
+    used_rows: set[int] = set()
+    for branch_type, r, side, spine_c, branch_len in specs:
