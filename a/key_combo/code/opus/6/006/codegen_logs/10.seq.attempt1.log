+        room_mask = np.zeros_like(open_mask)
+        room_mask[r0 : r0 + ROOM_H, c0 : c0 + ROOM_W] = True
+        corridor_mask = np.zeros_like(open_mask)
+        corridor_mask[r, corridor] = True
