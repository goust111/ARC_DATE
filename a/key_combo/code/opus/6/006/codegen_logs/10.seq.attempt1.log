+    in_rep = [comp for comp in comps_in if comp["color"] == repeated_color]
+    out_rep = [comp for comp in comps_out if comp["color"] == repeated_color]
+    if len(out_rep) != len(in_rep):
+        return False
+
+    return bool(np.any(inp != out))
