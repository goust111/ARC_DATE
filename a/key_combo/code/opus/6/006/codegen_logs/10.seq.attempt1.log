+                        best_target = trg_idx
+                        tie = False
+                    elif dist == best_dist:
+                        tie = True
+                if not ok or tie or best_target is None:
+                    ok = False
+                    break
+                targets.append(best_target)
+            if ok and len(set(targets)) == len(targets):
+                return repeated, targets
