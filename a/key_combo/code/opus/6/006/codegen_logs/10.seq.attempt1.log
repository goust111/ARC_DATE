/bin/bash -lc "python - <<'PY'
import random, numpy as np
from collections import deque

ROOM_H, ROOM_W = 3, 4

def containing(x, limit):
    vals={int(np.floor(x+1e-9))}
    if abs(x-round(x))<1e-9:
        vals.add(int(round(x))-1)
    return [v for v in vals if 0<=v<limit]

def edge_open(open_mask,a,b):
    H,W=open_mask.shape
    ar,ac=a; br,bc=b
    mr=(ar+br)/4.0; mc=(ac+bc)/4.0
    rs=containing(mr,H); cs=containing(mc,W)
    return any(open_mask[r,c] for r in rs for c in cs)

def shortest(open_mask,start,goal):
    H,W=open_mask.shape
    q=deque([start]); d={start:0}; cnt={start:1}
    while q:
        cur=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nxt=(cur[0]+dr,cur[1]+dc)
            if not (0<=nxt[0]<=2*H and 0<=nxt[1]<=2*W):
                continue
            if not edge_open(open_mask,cur,nxt):
                continue
            nd=d[cur]+1
            if nxt not in d:
                d[nxt]=nd; cnt[nxt]=cnt[cur]; q.append(nxt)
            elif d[nxt]==nd:
                cnt[nxt]=min(2,cnt[nxt]+cnt[cur])
    return d.get(goal), cnt.get(goal,0)

def center2(b):
    r0,c0,r1,c1=b
    return (r0+r1+1, c0+c1+1)

def make_attempt():
    H=random.randint(22,28); W=random.randint(24,29)
    slots=list(range(4, H-4, 4))
    if len(slots)<5: return None
    trunk_c=random.randint(10, W-11)
    use_side=random.random()<0.75
    side_info=None
    if use_side:
        side=random.choice([-1,1])
        pivot=random.choice(slots[1:-1])
        span_slots=[s for s in slots if abs(s-pivot)>=4]
        lo=random.choice([s for s in span_slots if s < pivot] or [slots[0]])
        hi=random.choice([s for s in span_slots if s > pivot] or [slots[-1]])
        if lo>hi: lo,hi=hi,lo
        spine_c=trunk_c + side*random.randint(5,7)
        if not (5 <= spine_c <= W-6):
            return None
        side_info=(side,pivot,lo,hi,spine_c)
    candidates=[]
    for r in slots:
        for side in (-1,1):
            # primary trunk leaves, avoid crowding near side connector on same side
            length=random.randint(2,4)
            if side==-1:
                c0=trunk_c-length-ROOM_W
            else:
                c0=trunk_c+length+1
            if 1<=c0 and c0+ROOM_W < W-1:
                candidates.append(('trunk',r,side,length,c0))
    if side_info:
        side,pivot,lo,hi,spine_c=side_info
        outward=side
        for r in [s for s in slots if lo<=s<=hi and s"'!=pivot]:
            length=random.randint(2,4)
            if outward==-1:
                c0=spine_c-length-ROOM_W
            else:
                c0=spine_c+length+1
            if 1<=c0 and c0+ROOM_W < W-1:
                candidates.append(('"'side',r,outward,length,c0))
    random.shuffle(candidates)
    n=random.randint(5, min(8,len(candidates)))
    leaves=[]
    used_rows_by_key={}
    open_mask=np.zeros((H,W),dtype=bool)
    open_mask[min(slots):max(slots)+1, trunk_c]=True
    if side_info:
        side,pivot,lo,hi,spine_c=side_info
        c1,c2=sorted((trunk_c,spine_c))
        open_mask[pivot, c1:c2+1]=True
        open_mask[lo:hi+1, spine_c]=True
    def ok_room(r,c0):
        r0=r-1
        return r0>=1 and r0+ROOM_H<=H-1 and c0>=1 and c0+ROOM_W<=W-1
    for kind,r,side,length,c0 in candidates:
        key=(kind,side)
        prev=used_rows_by_key.setdefault(key,[])
        if any(abs(r-pr)<4 for pr in prev):
            continue
        if not ok_room(r,c0):
            continue
        r0=r-1
        room=np.zeros_like(open_mask)
        room[r0:r0+ROOM_H, c0:c0+ROOM_W]=True
        if kind=='trunk': spine_c=trunk_c
        else: spine_c=side_info[4]
        if side==-1:
            corridor_cols=slice(c0+ROOM_W, spine_c)
            room_door=(r,c0+ROOM_W-1)
        else:
            corridor_cols=slice(spine_c+1, c0)
            room_door=(r,c0)
        add=np.zeros_like(open_mask)
        add[r, corridor_cols]=True
        add |= room
        if np.any(open_mask & add & ~(open_mask & np.isin(np.indices(open_mask.shape)[0], [r]))):
            pass
        # simple overlap check excluding existing spine/corridor cells
        if np.any((add & open_mask) & ~((np.indices(open_mask.shape)[1]==trunk_c) | (side_info is not None and np.indices(open_mask.shape)[1]==side_info[4]) | (side_info is not None and np.indices(open_mask.shape)[0]==side_info[1]))):
            continue
        open_mask |= add
