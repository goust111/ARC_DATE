+    dst_c0 = (trg_c2 - src_w) // 2
+    for rr in range(source["mask"].shape[0]):
+        for cc in range(source["mask"].shape[1]):
+            if source["mask"][rr, cc]:
+                out[dst_r0 + rr, dst_c0 + cc] = int(source["color"])
+
