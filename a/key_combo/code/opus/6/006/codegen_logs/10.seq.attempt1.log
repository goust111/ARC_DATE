+def _shortest_path_info(
+    open_mask: np.ndarray, start: tuple[int, int], goal: tuple[int, int]
+) -> tuple[int | None, int]:
+    h, w = open_mask.shape
+    q = deque([start])
+    dist = {start: 0}
+    count = {start: 1}
+
+    while q:
+        cur = q.popleft()
+        for dr, dc in DIRS4:
+            nxt = (cur[0] + dr, cur[1] + dc)
+            if not (0 <= nxt[0] <= 2 * h and 0 <= nxt[1] <= 2 * w):
+                continue
+            if not _edge_open(open_mask, cur, nxt):
+                continue
+            nd = dist[cur] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                count[nxt] = count[cur]
+                q.append(nxt)
+            elif dist[nxt] == nd:
