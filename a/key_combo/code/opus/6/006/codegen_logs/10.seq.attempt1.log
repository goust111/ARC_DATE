+from __future__ import annotations
+
+from collections import deque
+import itertools
+import random
+
+import numpy as np
+
+
+WALL = 5
+BG = 0
+ROOM_H = 3
+ROOM_W = 4
+SOURCE_W = 2
+MIN_OBJECTS = 5
+MAX_OBJECTS = 8
+MAX_ATTEMPTS = 400
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _component_dict(mask: np.ndarray, color: int) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(cells)
+            comp_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                comp_mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": cells,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": comp_mask,
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _all_components(grid: np.ndarray) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in {BG, WALL}):
+        comps.extend(_component_dict(grid == color, color))
+    return comps
+
+
+def _is_solid_rect(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return comp["area"] == (r1 - r0 + 1) * (c1 - c0 + 1) and bool(np.all(comp["mask"]))
+
+
+def _center2(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 + r1 + 1, c0 + c1 + 1
+
+
+def _contains_coord(x: float, limit: int) -> list[int]:
+    vals = {int(np.floor(x + 1e-9))}
+    if abs(x - round(x)) < 1e-9:
+        vals.add(int(round(x)) - 1)
+    return [v for v in vals if 0 <= v < limit]
+
+
+def _edge_open(open_mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> bool:
+    h, w = open_mask.shape
+    ar, ac = a
+    br, bc = b
+    mr = (ar + br) / 4.0
+    mc = (ac + bc) / 4.0
+    rows = _contains_coord(mr, h)
+    cols = _contains_coord(mc, w)
+    return any(open_mask[r, c] for r in rows for c in cols)
+
+
+def _shortest_path_info(
+    open_mask: np.ndarray, start: tuple[int, int], goal: tuple[int, int]
+) -> tuple[int | None, int]:
+    h, w = open_mask.shape
+    q = deque([start])
+    dist = {start: 0}
+    count = {start: 1}
+
+    while q:
+        cur = q.popleft()
+        for dr, dc in DIRS4:
+            nxt = (cur[0] + dr, cur[1] + dc)
+            if not (0 <= nxt[0] <= 2 * h and 0 <= nxt[1] <= 2 * w):
+                continue
+            if not _edge_open(open_mask, cur, nxt):
+                continue
+            nd = dist[cur] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                count[nxt] = count[cur]
+                q.append(nxt)
+            elif dist[nxt] == nd:
+                count[nxt] = min(2, count[nxt] + count[cur])
+
+    return dist.get(goal), count.get(goal, 0)
+
+
+def _draw_walls(open_mask: np.ndarray) -> np.ndarray:
+    h, w = open_mask.shape
+    grid = np.full((h, w), BG, dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if open_mask[r, c]:
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc]:
+                    grid[r, c] = WALL
+                    break
+    return grid
+
+
+def _stamp(out: np.ndarray, source: dict, target: dict) -> None:
+    src_h = source["bbox"][2] - source["bbox"][0] + 1
