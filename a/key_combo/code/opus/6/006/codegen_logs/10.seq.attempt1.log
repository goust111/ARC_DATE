+    if abs(x - round(x)) < 1e-9:
+        vals.add(int(round(x)) - 1)
+    return [v for v in vals if 0 <= v < limit]
+
+
+def _edge_open(open_mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> bool:
+    h, w = open_mask.shape
+    ar, ac = a
+    br, bc = b
+    mr = (ar + br) / 4.0
+    mc = (ac + bc) / 4.0
+    rows = _contains_coord(mr, h)
+    cols = _contains_coord(mc, w)
+    return any(open_mask[r, c] for r in rows for c in cols)
+
+
+def _edge_maps(open_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = open_mask.shape
+    horiz = np.zeros((2 * h + 1, 2 * w), dtype=bool)
+    vert = np.zeros((2 * h, 2 * w + 1), dtype=bool)
+
+    for r in range(2 * h + 1):
+        mr = r / 2.0
+        rows = _contains_coord(mr, h)
+        for c in range(2 * w):
