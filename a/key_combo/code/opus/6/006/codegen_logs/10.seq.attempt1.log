+
+
+def _paint_repeated(grid: np.ndarray, room: dict, color: int) -> None:
+    r0, c0, _r1, _c1 = room["bbox"]
+    grid[r0 : r0 + ROOM_H, c0 + 1 : c0 + 3] = int(color)
