+
+def _is_solid_rect(comp: dict) -> bool:
+    r0, c0, r1, c1 = comp["bbox"]
+    return comp["area"] == (r1 - r0 + 1) * (c1 - c0 + 1) and bool(np.all(comp["mask"]))
+
+
+def _center2(bbox: tuple[int, int, int, int]) -> tuple[int, int]:
+    r0, c0, r1, c1 = bbox
+    return r0 + r1 + 1, c0 + c1 + 1
+
+
+def _contains_coord(x: float, limit: int) -> list[int]:
+    vals = {int(np.floor(x + 1e-9))}
+    if abs(x - round(x)) < 1e-9:
+        vals.add(int(round(x)) - 1)
+    return [v for v in vals if 0 <= v < limit]
+
+
+def _edge_open(open_mask: np.ndarray, a: tuple[int, int], b: tuple[int, int]) -> bool:
+    h, w = open_mask.shape
+    ar, ac = a
+    br, bc = b
+    mr = (ar + br) / 4.0
+    mc = (ac + bc) / 4.0
+    rows = _contains_coord(mr, h)
+    cols = _contains_coord(mc, w)
+    return any(open_mask[r, c] for r in rows for c in cols)
+
+
+def _shortest_path_info(
+    open_mask: np.ndarray, start: tuple[int, int], goal: tuple[int, int]
+) -> tuple[int | None, int]:
+    h, w = open_mask.shape
+    q = deque([start])
+    dist = {start: 0}
+    count = {start: 1}
+
+    while q:
+        cur = q.popleft()
+        for dr, dc in DIRS4:
+            nxt = (cur[0] + dr, cur[1] + dc)
+            if not (0 <= nxt[0] <= 2 * h and 0 <= nxt[1] <= 2 * w):
+                continue
+            if not _edge_open(open_mask, cur, nxt):
+                continue
+            nd = dist[cur] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                count[nxt] = count[cur]
+                q.append(nxt)
+            elif dist[nxt] == nd:
+                count[nxt] = min(2, count[nxt] + count[cur])
+
+    return dist.get(goal), count.get(goal, 0)
+
+
+def _draw_walls(open_mask: np.ndarray) -> np.ndarray:
+    h, w = open_mask.shape
+    grid = np.full((h, w), BG, dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if open_mask[r, c]:
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc]:
+                    grid[r, c] = WALL
+                    break
+    return grid
+
+
+def _stamp(out: np.ndarray, source: dict, target: dict) -> None:
+    src_h = source["bbox"][2] - source["bbox"][0] + 1
+    src_w = source["bbox"][3] - source["bbox"][1] + 1
+    trg_r2, trg_c2 = _center2(target["bbox"])
+    dst_r0 = (trg_r2 - src_h) // 2
+    dst_c0 = (trg_c2 - src_w) // 2
+    for rr in range(source["mask"].shape[0]):
+        for cc in range(source["mask"].shape[1]):
+            if source["mask"][rr, cc]:
+                out[dst_r0 + rr, dst_c0 + cc] = int(source["color"])
+
