+from __future__ import annotations
+
+from collections import deque
+import itertools
+import random
+
+import numpy as np
+
+
+WALL = 5
+BG = 0
+ROOM_H = 3
+ROOM_W = 4
+SOURCE_W = 2
+MIN_OBJECTS = 5
+MAX_OBJECTS = 8
+MAX_ATTEMPTS = 400
+DIRS4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
