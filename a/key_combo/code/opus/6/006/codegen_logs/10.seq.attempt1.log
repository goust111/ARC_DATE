+        add_mask = room_mask | corridor_mask
+        overlap = add_mask & open_mask
+        if np.any(overlap & ~(np.arange(w)[None, :] == spine_c)):
+            continue
+
+        open_mask |= add_mask
+        used_rows.add(r)
+        rooms.append(
+            {
+                "bbox": (r0, c0, r0 + ROOM_H - 1, c0 + ROOM_W - 1),
