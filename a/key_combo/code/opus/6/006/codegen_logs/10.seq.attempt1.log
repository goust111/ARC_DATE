+
+def _edge_maps(open_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = open_mask.shape
+    horiz = np.zeros((2 * h + 1, 2 * w), dtype=bool)
+    vert = np.zeros((2 * h, 2 * w + 1), dtype=bool)
+
+    for r in range(2 * h + 1):
+        mr = r / 2.0
+        rows = _contains_coord(mr, h)
+        for c in range(2 * w):
+            mc = (c + 0.5) / 2.0
+            cols = _contains_coord(mc, w)
+            horiz[r, c] = any(open_mask[rr, cc] for rr in rows for cc in cols)
+
+    for r in range(2 * h):
+        mr = (r + 0.5) / 2.0
+        rows = _contains_coord(mr, h)
+        for c in range(2 * w + 1):
+            mc = c / 2.0
+            cols = _contains_coord(mc, w)
+            vert[r, c] = any(open_mask[rr, cc] for rr in rows for cc in cols)
