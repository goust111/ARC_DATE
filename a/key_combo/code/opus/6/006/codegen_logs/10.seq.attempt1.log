+
+        open_mask |= add_mask
+        used_rows.add(r)
+        rooms.append(
+            {
+                "bbox": (r0, c0, r0 + ROOM_H - 1, c0 + ROOM_W - 1),
+                "branch_type": branch_type,
+                "side": side,
+                "spine_c": spine_c,
+                "row": r,
+            }
