+                _paint_repeated(grid, room, repeated_color)
+            else:
+                _paint_single(grid, room, next(single_iter))
+
+        if max(grid.shape) > 30:
+            continue
+        if not _semantic_ok(grid):
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

