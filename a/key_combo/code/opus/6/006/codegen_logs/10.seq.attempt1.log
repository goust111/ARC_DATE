+def _component_dict(mask: np.ndarray, color: int) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = cr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            r0, c0, r1, c1 = _bbox(cells)
+            comp_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                comp_mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": cells,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": comp_mask,
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _all_components(grid: np.ndarray) -> list[dict]:
+    comps: list[dict] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in {BG, WALL}):
+        comps.extend(_component_dict(grid == color, color))
+    return comps
+
