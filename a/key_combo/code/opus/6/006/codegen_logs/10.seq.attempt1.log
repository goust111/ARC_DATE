+    node_h = horiz.shape[0]
+    node_w = vert.shape[1]
+    q = deque([start])
+    dist = np.full((node_h, node_w), -1, dtype=int)
+    count = np.zeros((node_h, node_w), dtype=np.uint8)
+    dist[start] = 0
+    count[start] = 1
+
+    while q:
+        cur = q.popleft()
+        cr, cc = cur
+        nd = dist[cr, cc] + 1
+        neighbors = []
+        if cr > 0 and vert[cr - 1, cc]:
+            neighbors.append((cr - 1, cc))
+        if cr + 1 < node_h and vert[cr, cc]:
+            neighbors.append((cr + 1, cc))
+        if cc > 0 and horiz[cr, cc - 1]:
+            neighbors.append((cr, cc - 1))
+        if cc + 1 < node_w and horiz[cr, cc]:
+            neighbors.append((cr, cc + 1))
+        for nr, nc in neighbors:
+            if dist[nr, nc] == -1:
+                dist[nr, nc] = nd
+                count[nr, nc] = count[cr, cc]
+                q.append((nr, nc))
+            elif dist[nr, nc] == nd:
+                count[nr, nc] = min(2, int(count[nr, nc]) + int(count[cr, cc]))
+
+    goal_dist = int(dist[goal])
+    return (goal_dist if goal_dist >= 0 else None), int(count[goal])
