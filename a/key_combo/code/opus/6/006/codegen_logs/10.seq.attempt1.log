+            comp_mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+            for rr, cc in cells:
+                comp_mask[rr - r0, cc - c0] = True
+            comps.append(
+                {
+                    "color": int(color),
+                    "coords": cells,
+                    "bbox": (r0, c0, r1, c1),
+                    "mask": comp_mask,
+                    "area": len(cells),
