+                    break
+                if best_dist is None or dist < best_dist:
+                    best_dist = dist
+                    best_target = trg_idx
+                    tie = False
+                elif dist == best_dist:
+                    tie = True
+            if not ok or tie or best_target is None:
+                ok = False
