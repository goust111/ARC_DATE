+
+        grid = _draw_walls(open_mask)
+        repeated_set = set(repeated_idx)
+        single_iter = iter(single_colors)
+        for idx, room in enumerate(rooms):
+            if idx in repeated_set:
+                _paint_repeated(grid, room, repeated_color)
+            else:
+                _paint_single(grid, room, next(single_iter))
+
+        if max(grid.shape) > 30:
+            continue
+        if not _semantic_ok(grid):
+            continue
+
+        assignments = []
+        singles = [idx for idx in range(len(rooms)) if idx not in repeated_set]
+        for src_idx in repeated_idx:
+            best_dist = None
+            best_target = None
+            tie = False
+            for trg_idx in singles:
+                dist, count = _shortest_path_info(open_mask, rooms[src_idx]["center2"], rooms[trg_idx]["center2"])
+                if dist is None or count != 1:
+                    tie = True
+                    break
+                if best_dist is None or dist < best_dist:
+                    best_dist = dist
+                    best_target = trg_idx
+                    tie = False
+                elif dist == best_dist:
+                    tie = True
+            if tie or best_target is None:
+                assignments = []
+                break
+            assignments.append(best_target)
+        if not assignments or len(set(assignments)) != len(assignments):
+            continue
+        if set(assignments) != set(target_idx):
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid puzzle instance")

