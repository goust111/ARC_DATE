+
+def _draw_walls(open_mask: np.ndarray) -> np.ndarray:
+    h, w = open_mask.shape
+    grid = np.full((h, w), BG, dtype=int)
+    for r in range(h):
+        for c in range(w):
+            if open_mask[r, c]:
+                continue
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc]:
+                    grid[r, c] = WALL
+                    break
