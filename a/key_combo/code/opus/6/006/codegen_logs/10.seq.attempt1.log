+    horiz, vert = edge_maps
+    node_h = horiz.shape[0]
+    node_w = vert.shape[1]
+    q = deque([start])
+    dist = np.full((node_h, node_w), -1, dtype=int)
+    count = np.zeros((node_h, node_w), dtype=np.uint8)
+    dist[start] = 0
+    count[start] = 1
