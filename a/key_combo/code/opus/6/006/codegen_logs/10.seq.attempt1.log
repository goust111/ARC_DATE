+        repeated = random.sample(range(len(rooms)), rep_count)
+        singles = [i for i in range(len(rooms)) if i not in repeated]
+        targets: list[int] = []
+        ok = True
+        for src_idx in repeated:
+            best_dist = None
+            best_target = None
+            tie = False
+            for trg_idx in singles:
+                dist, count = _shortest_path_info(open_mask, centers[src_idx], centers[trg_idx])
+                if dist is None or count != 1:
