+        rooms.append(
+            {
+                "bbox": (r0, c0, r0 + ROOM_H - 1, c0 + ROOM_W - 1),
+                "center2": _center2((r0, c0, r0 + ROOM_H - 1, c0 + ROOM_W - 1)),
+                "branch_type": branch_type,
