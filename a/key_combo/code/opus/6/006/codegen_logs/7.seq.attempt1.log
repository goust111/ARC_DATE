+    values = [idx for idx in range(2, size - 1) if idx not in blocked]
+    for _ in range(200):
+        if duplicate:
+            dup_size = 2 if count == 2 else random.choice((2, 2, min(3, count)))
+            dup_value = random.choice(values)
