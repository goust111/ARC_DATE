+    if g.ndim != 2:
+        raise ValueError("expected a 2D grid")
+    left_rows, top_cols, horizontal_triggers, vertical_triggers = _parse_input(g)
+    return _render_output(g.shape, left_rows, top_cols, horizontal_triggers, vertical_triggers)
+
