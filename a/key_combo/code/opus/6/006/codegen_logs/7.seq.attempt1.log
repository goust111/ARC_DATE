+
+def _render_output(
+    shape: tuple[int, int],
+    left_rows: list[int],
+    top_cols: list[int],
+    horizontal_triggers: list[tuple[int, int]],
+    vertical_triggers: list[tuple[int, int]],
+    *,
+    collapse_duplicate_splits: bool = False,
+    keep_triggers_magenta: bool = True,
