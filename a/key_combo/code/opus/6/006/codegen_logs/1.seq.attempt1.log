+BG = 0
+BASELINE = 5
+LANE_MARKERS = (1, 3, 2)  # left-to-right marker colors: blue, green, red
+SYM_TO_LANE = {"horizontal": 1, "vertical": 3, "none": 2}
+SPRITE_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
