+            ordered = [cols[color] for color in LANE_MARKERS]
+            if ordered[1] - ordered[0] == ordered[2] - ordered[1]:
+                baseline_row = r
+                lane_cols = {color: col for color, col in zip(LANE_MARKERS, ordered)}
+                break
