+        if not placed:
+            return None
+
+    noises: list[tuple[int, int, int]] = []
+    for _ in range(random.randint(2, 3)):
+        candidates = [(r, c) for r in range(0, baseline_row - 1) for c in range(width) if inp[r, c] == BG]
+        random.shuffle(candidates)
