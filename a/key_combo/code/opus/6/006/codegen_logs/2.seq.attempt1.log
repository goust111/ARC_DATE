+        b = (int(pts[1, 0]), int(pts[1, 1]))
+        pairs.append((color, a, b))
+    pairs.sort(key=lambda item: _pair_sort_key(*item))
+    return pairs
+
+
+def _distance_map(start: Coord, walkable: np.ndarray) -> np.ndarray:
