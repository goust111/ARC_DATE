+
+def _path_adjacent_to_gray(path: list[Coord], obstacle_mask: np.ndarray) -> int:
+    total = 0
+    for cell in path[1:-1]:
+        for nr, nc in neighbors4(*cell):
+            if in_bounds(obstacle_mask.shape, nr, nc) and bool(obstacle_mask[nr, nc]):
+                total += 1
+    return total
