+    obstacle_count = _count_obstacles(inp)
+    if not (OBSTACLE_COUNT_RANGE[0] <= obstacle_count <= OBSTACLE_COUNT_RANGE[1]):
+        return False
+
+    pairs = _connector_pairs(inp)
