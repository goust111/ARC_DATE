/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
import random, numpy as np
p='/home/lixinyu/snap/a/key_combo/code/opus/6/006/2.py'
mod=SourceFileLoader('arc_task_dbg4', p).load_module()

def swap_first_two_out(grid):
    pairs = mod._connector_pairs(grid)
    if len(pairs) < 2:
        return None
    alt = pairs[:]
    alt[0], alt[1] = alt[1], alt[0]
    try:
        out,_ = mod._render_with_pairs(grid, alt)
    except Exception:
        return None
    return out

build=0
swapdiff=0
for trial in range(40):
    h = random.randint(*mod.GRID_H_RANGE)
    w = random.randint(*mod.GRID_W_RANGE)
    oc = random.randint(4,5)
    try:
        input_grid = mod._place_obstacles((h,w), oc)
    except Exception:
        continue
    sim_grid = input_grid.copy(); compare_grid = input_grid.copy(); chosen=[]; used=[]; last=None
    comps = mod._obstacle_components(input_grid)
    paired_templates = random.choice([[\"TR\", \"LB\"], [\"TL\", \"RB\"]])
    plan=[(comps[0],[paired_templates[0]],False),(comps[0],[paired_templates[1]],False)]
    ok=True
    for comp,templates,need in plan:
        picked = mod._pick_component_pair(input_grid, sim_grid, compare_grid, comp, templates, used, last, need)
        if picked is None:
            ok=False; break
        a,b,path=picked; chosen.append((a,b,path)); used.extend([a,b]); last=mod._pair_sort_key(0,a,b)
        input_grid[a]=1; input_grid[b]=1; sim_grid[a]=1; sim_grid[b]=1
        for cell in path[1:-1]: sim_grid[cell]=1
    while ok and len(chosen)<4:
        picked = mod._pick_next_pair(input_grid, sim_grid, compare_grid, comps, used, last)
        if picked is None:
            ok=False; break
        a,b,path=picked; chosen.append((a,b,path)); used.extend([a,b]); last=mod._pair_sort_key(0,a,b)
        input_grid[a]=1; input_grid[b]=1; sim_grid[a]=1; sim_grid[b]=1
        for cell in path[1:-1]: sim_grid[cell]=1
    if not ok:
        continue
    build += 1
    final=input_grid.copy(); final[final==1]=0
    colors=random.sample(mod.PATH_COLORS,len(chosen))
    for color,(a,b,_p) in zip(colors,chosen):
        final[a]=color; final[b]=color
    out = mod.main(final)
    alt = swap_first_two_out(final)
    if alt is not None and not np.array_equal(out, alt):
        swapdiff += 1
print('build', build, 'swapdiff', swapdiff)
