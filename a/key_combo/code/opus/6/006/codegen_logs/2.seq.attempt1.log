+def _render_with_pairs(grid: np.ndarray, ordered_pairs: list[Pair]) -> tuple[np.ndarray, list[list[Coord]]]:
+    g = np.asarray(grid, dtype=int)
+    bg = int(get_bg(g))
+    assert bg == BG, "generator and solver assume black background"
