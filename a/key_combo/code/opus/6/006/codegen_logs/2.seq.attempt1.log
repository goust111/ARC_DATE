+def _pair_needs_reroute(occupied: np.ndarray, a: Coord, b: Coord) -> bool:
+    paths = _monotone_l_paths(a, b)
+    if not paths:
+        return False
+    blocked = occupied.copy()
+    blocked[a] = False
+    blocked[b] = False
