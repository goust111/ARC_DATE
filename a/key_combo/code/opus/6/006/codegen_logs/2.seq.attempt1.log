+) -> tuple[Coord, Coord, list[Coord]] | None:
+    if a[0] == b[0] or a[1] == b[1]:
+        return None
+    if input_grid[a] != BG or input_grid[b] != BG or sim_grid[a] != BG or sim_grid[b] != BG:
+        return None
+    if not _well_spaced(a, used_endpoints) or not _well_spaced(b, used_endpoints):
