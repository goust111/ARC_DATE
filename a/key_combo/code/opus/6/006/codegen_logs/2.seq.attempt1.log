+def _boundary_band_cells(shape: tuple[int, int]) -> list[Coord]:
+    h, w = shape
+    cells = []
+    for r in range(h):
+        for c in range(w):
+            d = min(r, c, h - 1 - r, w - 1 - c)
+            if 1 <= d <= 3:
