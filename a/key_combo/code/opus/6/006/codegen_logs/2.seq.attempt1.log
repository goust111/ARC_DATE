+    extra_templates = ["TR", "LB", "TL", "RB"]
+    for comp in components[1:]:
+        random.shuffle(extra_templates)
+        plan.append((comp, extra_templates[:], False))
+    while len(plan) < pair_count:
+        comp = random.choice(components)
+        random.shuffle(extra_templates)
+        plan.append((comp, extra_templates[:], False))
