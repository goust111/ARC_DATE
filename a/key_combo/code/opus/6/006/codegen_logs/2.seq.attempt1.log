+        return []
+
+    def walk(first_vertical: bool) -> list[Coord]:
+        r, c = a
+        cells = [a]
+        while r != b[0]:
+            r += 1 if b[0] > r else -1
+            cells.append((r, c))
+        while c != b[1]:
+            c += 1 if b[1] > c else -1
+            cells.append((r, c))
+        return cells
