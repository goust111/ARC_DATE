+
+        try:
+            walkable = probe_sim == BG
+            walkable[a] = True
+            walkable[b] = True
+            path = _shortest_hugging_path(a, b, walkable)
+        except ValueError:
+            continue
+
+        if len(path) - 2 != key[0]:
+            continue
+        if _path_adjacent_to_gray(path, obstacle_mask) == 0:
