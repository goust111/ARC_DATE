+def _reverse_order_output(grid: np.ndarray) -> np.ndarray | None:
+    ordered_pairs = _connector_pairs(grid)
+    reversed_pairs = list(reversed(ordered_pairs))
+    try:
+        out, _paths = _render_with_pairs(grid, reversed_pairs)
+    except ValueError:
+        return None
+    return out
