+def _can_place_obstacle(mask: np.ndarray, grid: np.ndarray, r0: int, c0: int) -> bool:
+    h, w = mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > grid.shape[0] or c0 + w > grid.shape[1]:
+        return False
+    coords = np.argwhere(mask)
+    for rr, cc in coords:
+        r = int(r0 + rr)
+        c = int(c0 + cc)
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
