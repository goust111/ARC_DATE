+                picked = _validate_candidate_pair(
+                    input_grid,
+                    sim_grid,
+                    compare_grid,
+                    used_endpoints,
+                    min_key,
+                    require_interaction,
+                    a,
+                    b,
+                )
+                if picked is not None:
+                    return picked
+    return None
