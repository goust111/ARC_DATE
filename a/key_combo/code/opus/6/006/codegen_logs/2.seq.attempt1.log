+
+def _pair_sort_key(color: int, a: Coord, b: Coord) -> tuple[int, int, int, int, int]:
+    p0, p1 = _sorted_pair_cells(a, b)
+    return (_manhattan(a, b) - 1, p0[0], p0[1], p1[0], p1[1])
