+
+
+def _template_endpoints(shape: tuple[int, int], anchor: Coord, template: str) -> tuple[Coord, Coord]:
+    h, w = shape
+    rr, cc = anchor
+    band_a = random.randint(1, 3)
+    band_b = random.randint(1, 3)
+    if template == "TR":
