+GRID_H_RANGE = (19, 26)
+GRID_W_RANGE = (19, 26)
+OBSTACLE_COUNT_RANGE = (3, 5)
+OBSTACLE_AREA_RANGE = (5, 12)
+PAIR_COUNT_WEIGHTS = [3, 3, 4, 4, 5]
+PAIR_DISTANCE_RANGE = (10, 32)
+MAX_GENERATION_ATTEMPTS = 400
+MAX_COMPONENT_ATTEMPTS = 80
+MAX_CANDIDATE_ATTEMPTS = 500
