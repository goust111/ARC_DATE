+    r, c = a
+    cells = [a]
+    while c != b[1]:
+        c += 1 if b[1] > c else -1
+        cells.append((r, c))
+    while r != b[0]:
+        r += 1 if b[0] > r else -1
+        cells.append((r, c))
+    col_first = cells
+    return [row_first, col_first]
