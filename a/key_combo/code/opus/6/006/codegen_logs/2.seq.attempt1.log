+def _dir_priority(cur: Coord, end: Coord, prev_dir: int) -> list[int]:
+    r, c = cur
+    er, ec = end
+    row_dir = 0 if er < r else 2
+    col_dir = 1 if ec > c else 3
+    wanted = []
+    if r != er:
+        wanted.append(row_dir)
+    if c != ec:
+        wanted.append(col_dir)
+
