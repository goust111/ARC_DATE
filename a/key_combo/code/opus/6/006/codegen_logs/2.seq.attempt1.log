+        r0 = random.randint(r_lo, r_hi)
+        c0 = random.randint(c_lo, c_hi)
+        center_r = r0 + (mh - 1) / 2.0
+        center_c = c0 + (mw - 1) / 2.0
+        if not (h * 0.25 <= center_r <= h * 0.75 and w * 0.25 <= center_c <= w * 0.75):
