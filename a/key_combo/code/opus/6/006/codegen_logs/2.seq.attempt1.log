+    for comp, templates, need_interaction in plan[:pair_count]:
+        picked = _pick_component_pair(
+            input_grid,
+            sim_grid,
+            compare_grid,
+            comp,
+            templates,
+            used_endpoints,
+            last_key,
+            need_interaction,
