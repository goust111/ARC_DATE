+        last_key = _pair_sort_key(0, a, b)
+        chosen_pairs.append((a, b, path))
+
+        input_grid[a] = 1
+        input_grid[b] = 1
+        sim_grid[a] = 1
+        sim_grid[b] = 1
+        for cell in path[1:-1]:
