+            if nr < 0 or nc < 0 or nr >= h or nc >= w or not bool(walkable[nr, nc]):
+                continue
+            if dist[nr, nc] != -1:
+                continue
+            dist[nr, nc] = dist[r, c] + 1
+            q.append((nr, nc))
