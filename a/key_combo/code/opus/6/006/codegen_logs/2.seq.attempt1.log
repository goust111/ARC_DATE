+def _monotone_l_paths(a: Coord, b: Coord) -> list[list[Coord]]:
+    if a[0] == b[0] or a[1] == b[1]:
+        return []
+
+    def walk(first_vertical: bool) -> list[Coord]:
+        r, c = a
+        cells = [a]
+        while r != b[0]:
+            r += 1 if b[0] > r else -1
+            cells.append((r, c))
+        while c != b[1]:
+            c += 1 if b[1] > c else -1
+            cells.append((r, c))
+        return cells
+
+    row_first = walk(True)
+    r, c = a
+    cells = [a]
+    while c != b[1]:
+        c += 1 if b[1] > c else -1
+        cells.append((r, c))
+    while r != b[0]:
+        r += 1 if b[0] > r else -1
+        cells.append((r, c))
+    col_first = cells
+    return [row_first, col_first]
+
