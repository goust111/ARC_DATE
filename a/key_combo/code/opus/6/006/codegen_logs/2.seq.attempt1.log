+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid connector-routing puzzle")

