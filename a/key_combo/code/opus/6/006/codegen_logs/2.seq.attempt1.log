+            frontier = []
+            for r, c in cells:
+                for nr, nc in neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w and not bool(mask[nr, nc]):
+                        frontier.append((nr, nc))
+            if not frontier:
+                break
+            nxt = random.choice(frontier)
+            mask[nxt] = True
+            cells.append(nxt)
+
+        if int(mask.sum()) != area:
+            continue
+        if not np.any(~mask):
