+def _anchor_candidates(comp: dict, limit: int = 4) -> list[Coord]:
+    coords = comp["coords"]
+    mean_r = float(coords[:, 0].mean())
+    mean_c = float(coords[:, 1].mean())
+    ranked = sorted(
+        [(int(r), int(c)) for r, c in coords],
