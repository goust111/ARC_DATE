+
+def _place_obstacles(shape: tuple[int, int], count: int) -> np.ndarray:
+    h, w = shape
+    grid = np.full((h, w), BG, dtype=int)
+    if count == 0:
+        return grid
+    attempts = 0
+    placed = 0
