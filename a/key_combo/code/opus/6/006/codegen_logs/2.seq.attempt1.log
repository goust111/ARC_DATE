+def _pick_component_pair(
+    input_grid: np.ndarray,
+    sim_grid: np.ndarray,
+    compare_grid: np.ndarray,
+    comp: dict,
+    templates: list[str],
+    used_endpoints: list[Coord],
+    min_key: tuple[int, int, int, int, int] | None,
+    require_interaction: bool,
+) -> tuple[Coord, Coord, list[Coord]] | None:
