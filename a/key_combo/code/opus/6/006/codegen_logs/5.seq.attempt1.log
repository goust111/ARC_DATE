+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            return _gen_attempt()
+        except AssertionError:
+            continue
+    raise RuntimeError("failed to generate a valid reference-pixel branch puzzle input")

