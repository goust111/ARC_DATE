+def _gen_attempt() -> np.ndarray:
+    height = random.randint(*GRID_HEIGHT_RANGE)
+    width = random.randint(*GRID_WIDTH_RANGE)
+    op_width = width - SEPARATOR_COL - 1
+
+    grid = np.zeros((height, width), dtype=int)
+    grid[:, SEPARATOR_COL] = SEPARATOR
