+BACKGROUND = 0
+SEPARATOR = 5
+REFERENCE_COLORS = (1, 2, 3, 4)
+DISTRACTOR_COLORS = (6, 7, 8, 9)
+REF_COL = 2
+SEPARATOR_COL = 4
+
+GRID_HEIGHT_RANGE = (10, 17)
