+        grid[r, REF_COL] = int(meta["ref_color"])
+        grid[r, SEPARATOR_COL + 1 :] = row
+
+    _validate_generated_grid(grid)
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        try:
+            return _gen_attempt()
+        except AssertionError:
+            continue
