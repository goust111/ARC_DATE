+def _separator_col(grid: np.ndarray) -> int:
+    cols = np.flatnonzero(np.all(grid == SEPARATOR, axis=0))
+    assert len(cols) == 1, "expected exactly one full-height grey separator"
+    return int(cols[0])
+
