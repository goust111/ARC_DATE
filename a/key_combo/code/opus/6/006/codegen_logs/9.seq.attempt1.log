+    all_rs = [pos[0] for cells in cell_sets for pos in cells]
+    all_cs = [pos[1] for cells in cell_sets for pos in cells]
+    if max(all_rs) - min(all_rs) + 1 > 30 or max(all_cs) - min(all_cs) + 1 > 30:
