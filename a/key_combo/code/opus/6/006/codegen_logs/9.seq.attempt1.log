+def _normalized_positions(placement: dict[int, tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    pts = list(placement.values())
+    r0 = min(r for r, _ in pts)
+    c0 = min(c for _, c in pts)
+    return tuple(sorted((r - r0, c - c0) for r, c in pts))
