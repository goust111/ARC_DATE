+    expected = _render_tiles(tiles, output_positions)
+    if max(expected.shape) > 30:
+        return None
+
+    inp = _scatter_tiles(tiles, output_positions)
+    if inp is None:
+        return None
+    if not _validate_instance(inp, expected, edges):
+        return None
+    return inp
