                        "near_out": (outside_r, outside_c),
                        "far": far,
                        "far_out": far_out,
                        "dir": (dr, dc),
                    }
                )
    return slots


def _gen_protected_cells(slot: dict) -> set[tuple[int, int]]:
    return {slot["near"], slot["near_out"], slot["far"], slot["far_out"]}


