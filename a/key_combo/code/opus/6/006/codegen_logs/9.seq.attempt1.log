+    cs = [c for _, c in cells]
+    out = np.zeros((max(rs) - min(rs) + 1, max(cs) - min(cs) + 1), dtype=int)
+    for (r, c), val in cells.items():
+        out[r - min(rs), c - min(cs)] = val
+    return out
