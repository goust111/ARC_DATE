+        for bc in range(3)
+        if (br, bc) != (1, 1)
+    }) < 2:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(16, 24)
+    w = random.randint(16, 24)
+    if h < EXPANDED or w < EXPANDED:
+        return None
