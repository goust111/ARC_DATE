+def _valid_example(inp: np.ndarray, out: np.ndarray) -> bool:
+    if inp.ndim != 2 or out.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(out.shape) > 30:
+        return False
+    if np.array_equal(inp, out):
