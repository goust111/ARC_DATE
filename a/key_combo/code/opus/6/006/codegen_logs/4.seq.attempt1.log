+FRAME_OUTER = 18
+FRAME_SLOTS = ((4, 5), (7, 12), (11, 6), (13, 13))
+AREA_TO_SHAPES = {
+    1: ((1, 1),),
+    3: ((1, 3), (3, 1)),
+    5: ((1, 5),),
+    9: ((3, 3),),
