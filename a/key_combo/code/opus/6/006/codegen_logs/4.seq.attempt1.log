+    high = min(patch_w - ow, fill_c0 + fw - 1)
+    orn_c0 = random.randint(low, high)
+    orn_r0 = fill_r0 - oh
+
+    patch = np.zeros((patch_h, patch_w), dtype=int)
+    fill_mask = np.zeros_like(patch, dtype=bool)
