+    patch = np.zeros((patch_h, patch_w), dtype=int)
+    fill_mask = np.zeros_like(patch, dtype=bool)
+    patch[fill_r0 : fill_r0 + fh, fill_c0 : fill_c0 + fw] = int(fill_color)
+    fill_mask[fill_r0 : fill_r0 + fh, fill_c0 : fill_c0 + fw] = True
