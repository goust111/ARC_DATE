+def _swap_two_colors(patch: np.ndarray) -> np.ndarray:
+    cols = sorted(int(v) for v in np.unique(patch) if int(v) != BG)
+    assert len(cols) == 2
+    a, b = cols
+    out = patch.copy()
+    out[patch == a] = b
+    out[patch == b] = a
+    return out
