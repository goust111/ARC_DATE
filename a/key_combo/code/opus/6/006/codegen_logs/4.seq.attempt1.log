+def _chebyshev_touches(a: np.ndarray, b: np.ndarray, gap: int = 1) -> bool:
+    dr = np.abs(a[:, None, 0] - b[None, :, 0])
+    dc = np.abs(a[:, None, 1] - b[None, :, 1])
+    return bool(np.any((dr <= gap) & (dc <= gap)))
