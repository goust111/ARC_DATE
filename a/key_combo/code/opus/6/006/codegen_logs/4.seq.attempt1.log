+def _rotate_cw(arr: np.ndarray, k: int) -> np.ndarray:
+    return np.rot90(arr, -int(k))
+
+
+def _crop_mask(mask: np.ndarray) -> np.ndarray:
+    return crop_bbox(mask.astype(int), _bbox_of_mask(mask)).astype(bool)
