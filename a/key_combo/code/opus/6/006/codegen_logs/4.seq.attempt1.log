+def _match_sprites_to_cavities(sprites: list[dict], cavities: list[dict]) -> list[tuple[dict, dict, int]]:
+    areas = [int(cavity["area"]) for cavity in cavities]
+    matches = []
+    used = set()
+    for cavity in cavities:
