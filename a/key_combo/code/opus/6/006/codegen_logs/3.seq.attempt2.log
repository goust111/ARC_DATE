+def _paired_subset(coords: np.ndarray, axis2: int) -> np.ndarray:
+    pts = {(int(r), int(c)) for r, c in coords}
+    kept: list[tuple[int, int]] = []
+    for r, c in pts:
+        mc = int(axis2) - c
+        if (r, mc) in pts:
