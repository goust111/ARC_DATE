+    colors = [int(c) for c in np.unique(g) if int(c) not in (BG, WALL)]
+    layers: list[dict] = []
+    for color in colors:
+        coords = np.argwhere(g == int(color))
+        assert len(coords) > 0
+        info = _best_axis_info(coords, w)
+        clean = info["clean"]
+        assert len(clean) > 0
+        cols = coords[:, 1]
