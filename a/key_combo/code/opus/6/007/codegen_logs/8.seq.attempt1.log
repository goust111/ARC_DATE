+    h, w = out.shape
+    for r, c in np.argwhere(filled):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in neighbors8(rr, cc):
+            if 0 <= nr < h and 0 <= nc < w and not filled[nr, nc] and int(out[nr, nc]) == bg:
+                contour.add((nr, nc))
