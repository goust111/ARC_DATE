+def _parse_marker_pairs(grid: np.ndarray, bg: int) -> tuple[int, list[dict]]:
+    rows = np.where(np.any(grid != bg, axis=1))[0]
+    assert len(rows) > 0
+    marker_row = int(rows[0])
