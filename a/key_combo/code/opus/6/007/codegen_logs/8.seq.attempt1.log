+    for spec in left_specs + right_specs:
+        r0 = spec["r0"]
+        c0 = spec["c0"]
+        patch = spec["patch"]
+        mask = spec["mask"]
+        view = grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]]
+        view[mask] = patch[mask]
+    return grid
+
