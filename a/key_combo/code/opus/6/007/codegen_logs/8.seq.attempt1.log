+    sub = mask[r0 : r1 + 1, c0 : c1 + 1]
+    holes: list[np.ndarray] = []
+    for comp in components_mask(~sub, connectivity=4):
+        rs = comp[:, 0]
+        cs = comp[:, 1]
+        if np.any(rs == 0) or np.any(cs == 0) or np.any(rs == sub.shape[0] - 1) or np.any(cs == sub.shape[1] - 1):
