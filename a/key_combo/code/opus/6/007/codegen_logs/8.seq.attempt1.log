+def _apply_hole_branch(out: np.ndarray, obj: dict, bg: int) -> None:
+    mask = obj["mask"]
+    out[mask] = TEAL
+    filled = mask.copy()
+    for hole in obj["holes"]:
+        out[hole[:, 0], hole[:, 1]] = PINK
+        filled[hole[:, 0], hole[:, 1]] = True
