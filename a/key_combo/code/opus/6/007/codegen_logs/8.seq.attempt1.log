+        assert len(run) == 2
+        assert run in ([RED, GREY], [GREY, RED])
+        pairs.append(
+            {
+                "cols": (start, start + 1),
+                "center_c": start + 0.5,
+                "side": "left" if run == [RED, GREY] else "right",
+            }
