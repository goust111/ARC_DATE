+                "coords": comp,
+                "mask": obj_mask,
+                "bbox": b,
+                "area": int(len(comp)),
+                "holes": holes,
+                "has_hole": len(holes) > 0,
+                "center_r": center_r,
+                "center_c": center_c,
+                "half": "left" if center_c < mid else "right",
