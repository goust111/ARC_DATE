+                "pos": pos,
+                "dir_name": dirs[pos],
+                "color": int(colors[pos]),
+                "role": "pair" if pos in pair_set else "filler",
+            }
+        )
+    return items
+
+
+def _validate_generated(rows: int, cols: int, items: list[dict]) -> bool:
+    grid = _render_layout(rows, cols, items)
