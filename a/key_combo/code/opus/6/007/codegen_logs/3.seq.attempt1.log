+BG = 0
+BLUE = 1
+MAROON = 9
+INPUT_COLORS = (2, 3, 4, 7)
+DIR_VECS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+GAP_CELLS = {
+    "up": (0, 1),
+    "down": (2, 1),
+    "left": (1, 0),
+    "right": (1, 2),
+}
+SIDE_CELLS = tuple(GAP_CELLS.values())
+CORNER_CELLS = ((0, 0), (0, 2), (2, 0), (2, 2))
