+    for sym in order:
+        sr, sc = sym["out_rc"]
+        dr, dc = sym["dir"]
+        color = int(sym["color"])
+        r, c = sr, sc
+        while True:
+            nr = r + dr
+            nc = c + dc
+            if nr < 0 or nr >= h or nc < 0 or nc >= w:
