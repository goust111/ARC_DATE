+    if np.array_equal(out, changed):
+        return False
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        rows = random.randint(*GEN_SIZE_RANGE)
+        cols = random.randint(*GEN_SIZE_RANGE)
