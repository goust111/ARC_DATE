+    point_lookup = {tuple(sym["out_rc"]): sym for sym in symbols}
+    order = sorted(symbols, key=lambda sym: (sym["out_rc"][0], sym["out_rc"][1]))
+    for sym in symbols:
+        rr, cc = sym["out_rc"]
+        out[rr, cc] = int(sym["color"])
