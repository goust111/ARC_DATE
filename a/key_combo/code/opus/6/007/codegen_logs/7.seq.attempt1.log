+
+    if analysis["selected_by_dir"]["right"]["color"] != analysis["selected_by_dir"]["down"]["color"]:
+        return False
+
+    expected = _expected_from_meta(g, meta)
+    actual = main(g)
+    if not np.array_equal(expected, actual):
