+def _paint_room(grid, bbox, color, door_side=None, door_pos=None):
+    r0, c0, r1, c1 = bbox
+    grid[r0 : r1 + 1, c0 : c1 + 1] = int(color)
+    grid[r0, c0 : c1 + 1] = WALL
+    grid[r1, c0 : c1 + 1] = WALL
+    grid[r0 : r1 + 1, c0] = WALL
+    grid[r0 : r1 + 1, c1] = WALL
