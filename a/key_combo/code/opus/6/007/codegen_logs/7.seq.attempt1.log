+                "color": meta["selected"][direction]["color"],
+                "dist": meta["selected"][direction]["dist"],
+                "dir": direction,
+            }
+            for direction in ("left", "up", "right", "down")
+        ],
+        "selected_by_dir": {
+            direction: {
