+        "target": target_rc,
+        "template_mask": template_mask,
+        "markers": markers,
+        "reachable_markers": reachable_markers,
+        "selected": selected,
+        "selected_by_dir": selected_by_dir,
+    }
+
+
+def _place_patch(dst, patch, anchor_rc):
+    ar, ac = anchor_rc
+    h, w = patch.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(patch[r, c])
+            if color == BG:
