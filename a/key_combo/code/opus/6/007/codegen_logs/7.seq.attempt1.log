+    H, W = grid.shape
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    if corner == "tl":
+        anchor = (0, 0)
+    elif corner == "tr":
+        anchor = (0, W - w)
+    elif corner == "bl":
+        anchor = (H - h, 0)
+    else:
+        anchor = (H - h, W - w)
