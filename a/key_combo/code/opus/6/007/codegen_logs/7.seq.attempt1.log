+    _paint_room(grid, left_bbox, left_color, "east", (tr, left_bbox[3]))
+    _paint_room(grid, right_bbox, right_down_color, "west", (tr, right_bbox[1]))
+    _paint_room(grid, up_bbox, up_color, "south", (up_bbox[2], tc))
