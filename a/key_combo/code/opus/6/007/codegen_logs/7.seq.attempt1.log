+        out[r, c] = entry["color"]
+
+    tr, tc = analysis["target"]
+    anchors = {
+        "left": (tr, tc - 1),
+        "up": (tr - 1, tc),
+        "right": (tr, tc + 1),
+        "down": (tr + 1, tc),
+    }
