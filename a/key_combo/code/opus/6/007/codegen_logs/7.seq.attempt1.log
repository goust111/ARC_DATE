+
+
+def _infer_floor_color(grid, marker_rc):
+    g = np.asarray(grid, dtype=int)
+    r, c = marker_rc
+    local = []
+    for nr, nc in _neighbors4(int(r), int(c)):
+        if _in_bounds(g.shape, nr, nc) and int(g[nr, nc]) in FLOOR_COLORS:
+            local.append(int(g[nr, nc]))
