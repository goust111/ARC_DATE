+            cc = int(ac + c)
+            if _in_bounds(dst.shape, rr, cc):
+                dst[rr, cc] = color
+
+
+def _render_output(grid, analysis):
+    g = np.asarray(grid, dtype=int)
+    out = g.copy()
+
+    out[g == TEAL] = BG
+    for entry in analysis["selected"]:
+        r, c = entry["pos"]
+        out[r, c] = entry["color"]
+
+    tr, tc = analysis["target"]
+    anchors = {
+        "left": (tr, tc - 1),
+        "up": (tr - 1, tc),
+        "right": (tr, tc + 1),
+        "down": (tr + 1, tc),
