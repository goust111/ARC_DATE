+    grid[ar0 + 1 : ar1, ac0 + 1 : ac1] = hub_color
+    grid[ar0, ac0 : ac1 + 1] = WALL
+    grid[ar1, ac0 : ac1 + 1] = WALL
+    grid[ar0 : ar1 + 1, ac0] = WALL
+    grid[ar0 : ar1 + 1, ac1] = WALL
