+    for cell in _deep_cells(bbox):
+        if _primary_direction(cell, target) != direction:
+            continue
+        dr = abs(cell[0] - target[0])
+        dc = abs(cell[1] - target[1])
+        if tie_only and dr != dc:
+            continue
+        if not tie_only and min(dr, dc) == 0 and max(dr, dc) < 2:
