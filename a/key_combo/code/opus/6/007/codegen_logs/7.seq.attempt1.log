+        return False
+
+    for direction in ("left", "up", "right", "down"):
+        got = analysis["selected_by_dir"][direction]
+        want = meta["selected"][direction]
+        if got["pos"] != want["pos"] or got["color"] != want["color"] or got["dist"] != want["dist"]:
