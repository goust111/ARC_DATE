+    if np.array_equal(actual, g):
+        return False
+    if np.any(actual == TEAL):
+        return False
+    return True
+
+
+def _gen_attempt():
+    H = random.randint(27, 30)
+    W = random.randint(27, 30)
+    grid = np.zeros((H, W), dtype=int)
+
+    arena = (3, 3, H - 4, W - 4)
