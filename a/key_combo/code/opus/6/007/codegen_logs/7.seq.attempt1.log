+
+def _place_patch(dst, patch, anchor_rc):
+    ar, ac = anchor_rc
+    h, w = patch.shape
+    for r in range(h):
+        for c in range(w):
+            color = int(patch[r, c])
+            if color == BG:
+                continue
+            rr = int(ar + r)
+            cc = int(ac + c)
+            if _in_bounds(dst.shape, rr, cc):
