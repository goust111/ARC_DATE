+    for r, c in np.argwhere(mask):
+        r = int(r)
+        c = int(c)
+        if seen[r, c]:
+            continue
+        comp = []
+        q = deque([(r, c)])
+        seen[r, c] = True
+        while q:
+            rr, cc = q.popleft()
+            comp.append((rr, cc))
+            for nr, nc in _neighbors4(rr, cc):
+                if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+        out.append(np.array(comp, dtype=int))
+    return out
+
