+def _neighbors4(r, c):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _in_bounds(shape, r, c):
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
