+        return False
+    if {m["dir"] for m in selected} != {"left", "up", "right", "down"}:
+        return False
+    if len({m["dist"] for m in analysis["reachable_markers"]}) != len(analysis["reachable_markers"]):
+        return False
+
+    for direction in ("left", "up", "right", "down"):
