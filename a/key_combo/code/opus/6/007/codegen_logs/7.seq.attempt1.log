+def _room_interior(bbox):
+    r0, c0, r1, c1 = bbox
+    return r0 + 1, c0 + 1, r1 - 1, c1 - 1
+
+
+def _deep_cells(bbox):
+    r0, c0, r1, c1 = _room_interior(bbox)
+    cells = []
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
