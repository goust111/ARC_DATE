+
+
+def _choose_selected(room_bboxes, room_colors, target):
+    directions = ("left", "up", "right", "down")
+    tie_dir = random.choice(("up", "down")) if random.random() < 0.45 else None
+    candidate_map = {}
+    for direction in directions:
+        bbox = room_bboxes[direction]
