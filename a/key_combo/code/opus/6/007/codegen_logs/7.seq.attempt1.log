+
+def _stamp_template_in_corner(grid):
+    h, w = BASE_TEMPLATE.shape
+    H, W = grid.shape
+    corner = random.choice(("tl", "tr", "bl", "br"))
+    if corner == "tl":
+        anchor = (0, 0)
+    elif corner == "tr":
