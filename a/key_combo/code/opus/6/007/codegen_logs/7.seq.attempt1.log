+        return None
+
+    for entry in selected.values():
+        r, c = entry["pos"]
+        grid[r, c] = MARKER
+
+    for cell in extra_reachable:
+        grid[cell] = MARKER
+
+    for cell in trap_markers:
+        grid[cell] = MARKER
+
+    grid[tr, tc] = RED
+    _stamp_template_in_corner(grid)
