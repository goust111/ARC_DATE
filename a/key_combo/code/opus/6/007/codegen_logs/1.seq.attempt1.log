+
+from arc_utils import bbox_coords, components_mask, crop_bbox, find_components, get_bg, paste
+
+
+BG = 0
+FRAME = 5
+WALL = 6
+SPRITE_COLORS = (1, 2, 3, 4)
+GEN_ATTEMPTS = 300
