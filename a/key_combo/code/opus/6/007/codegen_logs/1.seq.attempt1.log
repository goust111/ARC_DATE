+                "local_top_left": (int(r0), int(c0)),
+                "key": _shape_key(mask),
+                "area": int(mask.sum()),
+                "bbox": (frame_bbox[0] + int(r0), frame_bbox[1] + int(c0), frame_bbox[0] + int(r0) + mask.shape[0] - 1, frame_bbox[1] + int(c0) + mask.shape[1] - 1),
