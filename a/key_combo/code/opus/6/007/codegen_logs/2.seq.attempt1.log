+    random.shuffle(pool)
+    for rc in pool:
+        if len(chosen) == count:
+            break
+        if all(abs(rc[0] - rr) + abs(rc[1] - cc) >= 2 for rr, cc in chosen):
+            chosen.append(rc)
+    if len(chosen) < count:
+        remaining = [rc for rc in pool if rc not in chosen]
