  40: def main(grid: np.ndarray) -> np.ndarray:
  41:     """Extrapolate the moving sprite from a horizontal sequence of shared-border frames into the next standalone frame.
  42: 
  43:     Input structure
  44:     - The grid is a row of equal-width framed panels sharing their vertical border columns.
  45:     - Each panel has the same fill color and one identical interior sprite at the same local columns.
  46:     - The sprite's top row changes by a constant amount from panel to panel.
  47: 
  48:     Rule
  49:     - Build one output panel with the same height, frame color, fill color, and sprite.
  50:     - Continue the sprite's diagonal motion one more panel to the right.
  51:     - Because the output is a standalone panel, advance by the full panel width, not the shared-border spacing.
  52: 
  53:     Key insight
  54:     - The panels are consecutive frames of motion; the output is the next frame after the sequence.
  55:     """
  56:     g = np.asarray(grid, dtype=int)
  57:     h, w = g.shape
  58:     frame = int(g[0, 0])
  59:     assert h >= 3 and w >= 3
  60:     assert np.all(g[0, :] == frame)
  61:     assert np.all(g[-1, :] == frame)
  62: 
  63:     separators = [c for c in range(w) if np.all(g[:, c] == frame)]
  64:     assert len(separators) >= 3
  65:     assert separators[0] == 0 and separators[-1] == w - 1
  66:     strides = [b - a for a, b in zip(separators, separators[1:])]
  67:     assert len(set(strides)) == 1
  68:     stride = strides[0]
  69:     panel_w = stride + 1
  70: 
  71:     interior_values = []
  72:     for c0, c1 in zip(separators, separators[1:]):
  73:         interior_values.extend(g[1:-1, c0 + 1 : c1].ravel())
  74:     fill = _unique_most_common(interior_values)
  75: 
  76:     panels = []
  77:     for c0, c1 in zip(separators, separators[1:]):
  78:         panel = g[:, c0 : c1 + 1]
  79:         assert panel.shape == (h, panel_w)
  80:         assert np.all(panel[0, :] == frame)
  81:         assert np.all(panel[-1, :] == frame)
  82:         assert np.all(panel[:, 0] == frame)
  83:         assert np.all(panel[:, -1] == frame)
  84:         panels.append(panel)
  85: 
  86:     template_sprite, template_mask, first_top, template_left = _extract_sprite(panels[0], fill)
  87:     top_rows = [first_top]
  88:     for panel in panels[1:]:
  89:         sprite, sprite_mask, top, local_c0 = _extract_sprite(panel, fill)
  90:         assert local_c0 == template_left
  91:         assert sprite_mask.shape == template_mask.shape
  92:         assert np.array_equal(sprite_mask, template_mask)
  93:         assert np.array_equal(sprite[sprite_mask], template_sprite[template_mask])
  94:         top_rows.append(top)
  95: 
  96:     deltas = [b - a for a, b in zip(top_rows, top_rows[1:])]
  97:     assert len(deltas) >= 1 and len(set(deltas)) == 1
  98:     next_top = _round_half_up(
  99:         Fraction(top_rows[-1], 1) + Fraction(deltas[0] * panel_w, stride)
 100:     )
 101: 
 102:     sprite_h, sprite_w = template_sprite.shape
 103:     assert 1 <= next_top and next_top + sprite_h <= h - 1
 104:     assert 1 <= template_left and template_left + sprite_w <= panel_w - 1
 105: 
 106:     out = np.full((h, panel_w), fill, dtype=int)
 107:     out[0, :] = frame
 108:     out[-1, :] = frame
 109:     out[:, 0] = frame
 110:     out[:, -1] = frame
 111: 
 112:     target = out[next_top : next_top + sprite_h, template_left : template_left + sprite_w]
 113:     target[template_mask] = template_sprite[template_mask]
 114:     return out
