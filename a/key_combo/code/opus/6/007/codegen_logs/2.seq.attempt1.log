+def _reachable_marker_count(grid: np.ndarray, center: tuple[int, int]) -> int:
+    h, w = grid.shape
+    seen = {center}
+    stack = [center]
+    while stack:
+        r, c = stack.pop()
+        for nr, nc in neighbors4(r, c):
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if (nr, nc) in seen:
