+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _square_ring_mask(size: int) -> np.ndarray:
+    mask = np.zeros((size, size), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _is_square_ring_component(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    size = r1 - r0 + 1
+    if size != c1 - c0 + 1 or size < 5:
+        return False
+    rel = coords - np.array([r0, c0], dtype=int)
+    mask = np.zeros((size, size), dtype=bool)
+    mask[rel[:, 0], rel[:, 1]] = True
+    return np.array_equal(mask, _square_ring_mask(size))
+
+
+def _outside_contour(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    contour = np.zeros_like(mask, dtype=bool)
+    for r, c in np.argwhere(mask):
+        for nr, nc in neighbors4(int(r), int(c)):
+            if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
+                contour[nr, nc] = True
+    return contour
+
