+    if not np.array_equal(expected, main(grid)):
+        return None
+    if not _semantic_check(grid, trace, ambiguous_expected=ambiguous_expected):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
