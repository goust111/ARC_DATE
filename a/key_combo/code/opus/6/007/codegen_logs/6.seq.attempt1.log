+def _window_fill_coords(mask: np.ndarray, r0: int, c0: int) -> list[tuple[int, int]]:
+    rows, cols = np.nonzero(mask)
+    return [(int(r0 + rr), int(c0 + cc)) for rr, cc in zip(rows.tolist(), cols.tolist())]
