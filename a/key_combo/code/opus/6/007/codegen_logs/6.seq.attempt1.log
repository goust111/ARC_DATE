+        return None
+
+    grid = np.zeros((H, W), dtype=int)
+    central_colors = random.sample(list(RECT_COLORS), len(hidden_rects) + len(front_rects))
+
+    hidden_specs = []
+    for i, rect in enumerate(hidden_rects):
+        hidden_specs.append(
+            {
+                "bbox": rect,
+                "color": int(central_colors[i]),
+                "window": windows[i],
+                "spec": spec_names[i],
