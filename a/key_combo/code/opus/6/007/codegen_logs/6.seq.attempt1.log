+                "rect_bbox": rect["bbox"],
+                "window_bbox": window,
+                "raw_match_count": len(raw_candidates),
+                "symmetry_match_count": len(symmetry_candidates),
+                "final_match_count": len(final_candidates),
+                "final_colors": [int(item[0]["color"]) for item in final_candidates],
+            }
