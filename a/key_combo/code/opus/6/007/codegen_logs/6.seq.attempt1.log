+def _solve(grid: np.ndarray, return_trace: bool = False):
+    g = np.array(grid, dtype=int)
+    rects = extract_rectangles(g)
+    frags = extract_fragments(g)
+    rect_colors = {rect["color"] for rect in rects}
+
+    out = g.copy()
+    used_fragments: set[int] = set()
