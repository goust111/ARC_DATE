+def _gen_attempt() -> np.ndarray | None:
+    mode, spec_names = _choose_spec_set()
+    ambiguous_expected = any(SPECS[name]["ambiguous"] for name in spec_names)
+
+    if mode == "single":
+        chosen_spec = SPECS[spec_names[0]]
