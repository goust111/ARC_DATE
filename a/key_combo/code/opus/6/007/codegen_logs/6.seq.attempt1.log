+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+FRAGMENT_COLORS = (3, 5, 7)
+RECT_COLORS = (1, 2, 4, 6, 8, 9)
+ARC_MAX = 30
+MAX_GEN_ATTEMPTS = 500
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            cells = []
+            while stack:
+                rr, cc = stack.pop()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(cells, dtype=int))
+    return comps
+
+
+def mask_from_coords(coords: np.ndarray) -> np.ndarray:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    out = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    rel = coords - np.array([r0, c0])
+    out[rel[:, 0], rel[:, 1]] = True
+    return out
+
+
+def all_orientations(mask: np.ndarray) -> list[np.ndarray]:
+    seen: set[tuple[tuple[int, int], bytes]] = set()
+    out: list[np.ndarray] = []
+    m0 = mask.astype(bool)
+    for flip in (False, True):
+        m1 = np.fliplr(m0) if flip else m0
+        for k in range(4):
+            m2 = np.rot90(m1, k)
+            key = (m2.shape, m2.tobytes())
+            if key not in seen:
+                seen.add(key)
+                out.append(m2.copy())
+    return out
+
+
+def paste_mask(dst: np.ndarray, mask: np.ndarray, r0: int, c0: int, color: int) -> None:
+    rows, cols = np.nonzero(mask)
