+    if len(fragment_pool) < 2:
+        extra_mask = random.choice([SHAPES["l3"], SHAPES["bar2"]])
+        fragment_pool.append({"role": "extra", "mask": extra_mask, "color": int(random.choice(FRAGMENT_COLORS)), "for_rect": None})
