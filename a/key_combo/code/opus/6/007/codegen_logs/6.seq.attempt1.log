+    return False
+
+
+def _rect_hidden_window(rect: dict, rect_colors: set[int], grid: np.ndarray) -> tuple[int, int, int, int] | None:
+    r0, c0, r1, c1 = rect["bbox"]
+    sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+    mask = (sub != BG) & (sub != rect["color"]) & np.isin(sub, list(rect_colors))
+    if not mask.any():
