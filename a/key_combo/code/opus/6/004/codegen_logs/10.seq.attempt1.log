+def _touches_axis(coords: np.ndarray, axis: dict[str, int | str | tuple[int, int]]) -> bool:
+    adj = int(axis["adj_index"])
+    if axis["kind"] == "row":
+        return bool(np.any(coords[:, 0] == adj))
+    return bool(np.any(coords[:, 1] == adj))
