+        if built is None:
+            return None
+        grid = built["grid"]
+        records.append(built["record"])
+
+    if not _validate_semantics(grid, records):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate valid input for puzzle 10")

