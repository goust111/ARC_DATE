+                    "marker": marker,
+                    "orientation": option["orientation"],
+                    "coords": option["coords"],
+                    "long_end": long_path["end"],
+                    "short_end": short_path["end"],
+                    "long_len": int(long_path["length"]),
+                    "short_len": int(short_path["length"]),
+                }
+            )
+    return candidates
+
