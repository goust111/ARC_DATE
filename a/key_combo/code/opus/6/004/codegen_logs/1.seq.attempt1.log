+
+from arc_utils import Color, find_components, get_bg, in_bounds, neighbors4, paste
+
+
+NW_SE = "nw_se"
+NE_SW = "ne_sw"
+BLUE = Color.BLUE
+GREY = Color.GREY
+BG = Color.BLACK
+MAJ_COLOR = Color.TEAL
+MIN_COLOR = Color.RED
+
+DIAG8 = (
+    (-1, -1),
+    (-1, 1),
+    (1, -1),
+    (1, 1),
+)
+
+GEN_RETRIES = 400
+CANVAS_MIN = 14
