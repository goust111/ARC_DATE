+        grid = np.zeros((canvas_h, canvas_w), dtype=int)
+        for spec in placed_specs:
+            _paint_frame(grid, spec["top"], spec["left"], spec["h"], spec["w"], int(spec["color"]))
+        if not _place_sprites(grid, reserved.copy(), placed_specs):
