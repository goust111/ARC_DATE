+def _normalize_shape(coords: np.ndarray) -> np.ndarray:
+    coords = np.asarray(coords, dtype=int)
+    coords = coords - coords.min(axis=0)
+    order = np.lexsort((coords[:, 1], coords[:, 0]))
+    return coords[order]
