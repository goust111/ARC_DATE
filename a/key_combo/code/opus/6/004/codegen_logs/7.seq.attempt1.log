+                    "color": int(color),
+                    "count": int(count),
+                    "inner_h": int(inner_h),
+                    "inner_w": int(inner_w),
+                    "h": int(inner_h + 2),
+                    "w": int(inner_w + 2),
+                }
+            )
+
+        total_frame_area = sum(spec["h"] * spec["w"] for spec in frame_specs)
+        total_sprites = sum(spec["count"] for spec in frame_specs)
+        side = max(22, min(30, int(round((total_frame_area + 9 * total_sprites) ** 0.5)) + 8))
