+    heights = [3] * n
+    even_idx = random.randrange(n)
+    heights[even_idx] = 4
+    budget = max_inner_sum - sum(heights)
+    indices = list(range(n))
+    random.shuffle(indices)
+    for idx in indices:
+        while budget > 0:
+            step = random.choice([0, 1, 2, 3])
+            if step == 0 or heights[idx] + step > 6 or step > budget:
+                break
+            heights[idx] += step
+            budget -= step
