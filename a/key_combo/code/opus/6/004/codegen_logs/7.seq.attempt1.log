+        frame_specs: list[dict] = []
+        for color, count, inner_h in zip(colors, counts, inner_heights):
+            min_inner_w = max(5, 2 * count - 1)
+            inner_w = random.randint(min_inner_w, min(10, min_inner_w + 3))
+            frame_specs.append(
