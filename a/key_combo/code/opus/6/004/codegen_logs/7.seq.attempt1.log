+def _reserve_box(mask: np.ndarray, top: int, left: int, h: int, w: int, pad: int) -> None:
+    h0, w0 = mask.shape
+    r0 = max(0, top - pad)
+    c0 = max(0, left - pad)
+    r1 = min(h0, top + h + pad)
+    c1 = min(w0, left + w + pad)
+    mask[r0:r1, c0:c1] = True
