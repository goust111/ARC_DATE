+        if item[1][1] >= barrier_col + 2
+    ]
+    valid_pairs: list[tuple[Coord, Coord]] = []
+    for li, _left_anchor, left_marker in left_candidates:
+        if li < 2:
+            continue
+        for ri, _right_anchor, right_marker in right_candidates:
+            if ri <= li or len(path) - 1 - ri < 2:
+                continue
+            if ri - li + 1 < 4:
