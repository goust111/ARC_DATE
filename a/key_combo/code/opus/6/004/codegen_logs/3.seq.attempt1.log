    larger = NW_SE if counts[NW_SE] > counts[NE_SW] else NE_SW
    out = grid.copy()
    for orientation, coords in placed:
        color = LARGER_COLOR if orientation == larger else SMALLER_COLOR
        _paint_coords(out, coords, color)
    return out


