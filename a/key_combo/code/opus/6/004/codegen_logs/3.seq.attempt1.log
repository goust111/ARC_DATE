+
+def _path_cells(grid: np.ndarray) -> set[Coord]:
+    return {
+        (int(r), int(c))
+        for r, c in np.argwhere(np.isin(grid, np.asarray(PATH_COLORS, dtype=int)))
+    }
+
+
+def _ordered_path(path: set[Coord]) -> list[Coord]:
+    degrees = {
+        cell: sum((nbr in path) for nbr in neighbors4(*cell))
+        for cell in path
+    }
