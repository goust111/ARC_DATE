+        barrier_row,
+        int(np.flatnonzero(inp[barrier_row] == GREY)[0]),
+        int(np.flatnonzero(inp[barrier_row] == GREY)[-1]),
+        int(np.flatnonzero((inp == BLUE).any(axis=1))[0]),
