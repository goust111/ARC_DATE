+            if len(chosen) == count:
+                break
+        if len(chosen) != count:
+            continue
+
+        reversed_target = int(ref_left + 1)
+        valid_reversed = [
+            int(left)
+            for left in chosen
+            if int(left) != reversed_target
+            and all(abs(int(other - reversed_target)) >= 3 for other in chosen if other != left)
+        ]
+        if not valid_reversed:
+            continue
+        reversed_left = random.choice(valid_reversed)
