+def _well_spaced(lefts: list[int], min_gap: int = 3) -> bool:
+    ordered = sorted(lefts)
+    return all(int(b - a) >= int(min_gap) for a, b in zip(ordered, ordered[1:]))
+
+
+def _sample_left_layout(
+    width: int,
+    barrier_left: int,
+    barrier_right: int,
