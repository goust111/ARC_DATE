+        return False
+
+    bar_row = barrier_row + 1
+    if np.count_nonzero(np.isin(out[bar_row], [BLUE, RED])) != 2 * len(pairs):
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    height = random.randint(12, 16)
+    width = random.randint(12, 18)
+
