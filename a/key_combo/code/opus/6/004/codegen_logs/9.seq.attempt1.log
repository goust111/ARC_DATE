+        barrier_left,
+        barrier_right,
+        reference_row,
+        reference_left,
+        pairs,
+    )
+
+    try:
+        produced = main(grid)
+    except Exception:
+        return None
+
+    if not np.array_equal(produced, expected):
+        return None
+    if not _semantic_checks(grid, produced, barrier_row, reference_left, pairs):
+        return None
+    return grid
