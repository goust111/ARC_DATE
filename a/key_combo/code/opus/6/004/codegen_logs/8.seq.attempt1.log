  50:     candidates: list[tuple[int, tuple[tuple[int, int], ...]]] = []
  51:     for outline_color in colors:
  52:         source_colors = [c for c in colors if c != outline_color]
  53:         assert len(source_colors) == 1
  54:         source_color = int(source_colors[0])
  55:         source_count = int(np.count_nonzero(g == source_color))
  56:         assert source_count > 0, "source color must be present"
