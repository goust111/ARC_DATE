   9:     """
  10:     Extract the unique cell from each lattice row into a single-column lattice.
  11: 
  12:     Input structure:
  13:     - Grid divided into equal square cells by uniform gridlines of color L.
  14:     - Cell interiors filled with bg; each cell has an inner sprite pattern.
  15:     - Each row of cells has exactly one cell with a unique pattern; the rest are copies.
  16: 
  17:     Rule:
  18:     - For each lattice row, find the cell whose inner pattern appears exactly once (the "odd one out").
  19:     - Construct a single-column lattice preserving the original row heights, containing only the unique cells.
  20: 
  21:     Key insight: The task is per-row "odd one out" — every cell in a row is identical except one oddball, which must be extracted.
  22:     """
  23:     g = np.array(grid, dtype=int)
  24:     H, W = g.shape
  25: 
  26:     # Gridlines appear as fully-uniform rows/cols.
  27:     row_lines = [r for r in range(H) if len(set(map(int, g[r, :]))) == 1]
  28:     col_lines = [c for c in range(W) if len(set(map(int, g[:, c]))) == 1]
  29:     assert not (not row_lines or not col_lines)
  30: 
  31:     # Lattice color = most common value among uniform rows/cols.
  32:     vals = [int(g[r, 0]) for r in row_lines] + [int(g[0, c]) for c in col_lines]
  33:     L = int(Counter(vals).most_common(1)[0][0])
  34:     row_lines = sorted([r for r in row_lines if int(g[r, 0]) == int(L)])
  35:     col_lines = sorted([c for c in col_lines if int(g[0, c]) == int(L)])
  36: 
  37:     # Cell slices are the gaps between consecutive grid lines.
  38:     r_slices = [(int(row_lines[i]) + 1, int(row_lines[i + 1])) for i in range(len(row_lines) - 1)]
  39:     c_slices = [(int(col_lines[j]) + 1, int(col_lines[j + 1])) for j in range(len(col_lines) - 1)]
  40:     r_slices = [(a, b) for a, b in r_slices if int(b) > int(a)]
  41:     c_slices = [(a, b) for a, b in c_slices if int(b) > int(a)]
  42:     assert not (not r_slices or not c_slices)
  43: 
  44:     cell_w = int(c_slices[0][1] - c_slices[0][0])
  45: 
  46:     # Background inside cells = most common non-lattice color.
  47:     bg_candidates = [int(x) for x in g.flatten() if int(x) != int(L)]
  48:     assert bg_candidates
  49:     bg = int(Counter(bg_candidates).most_common(1)[0][0])
