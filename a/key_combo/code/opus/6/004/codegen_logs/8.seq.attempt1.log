 139: def _right_anchored_mask(widths: list[int], patch_width: int) -> np.ndarray:
 140:     """Return a mask whose true cells fill each row from the right edge."""
 141:     row_widths = np.asarray(widths, dtype=int)[:, None]
 142:     cols = np.arange(patch_width)[None, :]
 143:     return cols >= patch_width - row_widths
