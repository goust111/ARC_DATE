  56: def _fill_grid(h, w, palette):
  57:     k = len(palette)
  58:     mode = random.choice(FILL_MODES)
  59:     arr = np.zeros((h, w), dtype=int)
  60: 
  61:     if mode == "noise":
  62:         arr[:] = np.random.choice(palette, size=(h, w))
  63:     elif mode == "row_runs":
  64:         for r in range(h):
  65:             cuts = sorted(random.sample(range(1, w), random.randint(0, min(w - 1, MAX_ROW_RUN_CUTS)))) if w > 1 else []
  66:             starts = [0] + cuts
  67:             ends = cuts + [w]
  68:             last = None
  69:             for c0, c1 in zip(starts, ends):
  70:                 choices = [c for c in palette if c != last] or list(palette)
  71:                 last = random.choice(choices)
  72:                 arr[r, c0:c1] = last
  73:     elif mode == "column_bands":
  74:         for c in range(w):
  75:             arr[:, c] = random.choice(palette)
  76:         if random.random() < COLUMN_NOISE_PROB:
  77:             for r in range(h):
  78:                 arr[r, random.randrange(w)] = random.choice(palette)
  79:     else:
  80:         band = random.randint(MIN_DIAGONAL_BAND, MAX_DIAGONAL_BAND)
  81:         phase = random.randrange(k)
  82:         rows, cols = np.indices((h, w))
  83:         arr[:] = np.asarray(palette)[((rows + cols) // band + phase) % k]
  84:         if random.random() < DIAGONAL_FLIP_PROB:
  85:             arr = np.fliplr(arr)
  86: 
  87:     _ensure_palette_coverage(arr, palette)
  88:     return arr
