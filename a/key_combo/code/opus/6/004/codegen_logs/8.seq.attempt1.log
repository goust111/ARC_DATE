+    placed_order = [ordered[0]]
+    open_markers = {
+        color: {"abs_pos": rec["pos"], "dir": rec["dir"]}
+        for color, rec in objects[ordered[0]]["markers"].items()
+    }
+    candidate_history = []
+    placed_cells = occupied_abs(objects[ordered[0]]["sprite"], (0, 0), bg)
