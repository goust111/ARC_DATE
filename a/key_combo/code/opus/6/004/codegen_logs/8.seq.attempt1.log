+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BODY = 5
+MARKERS = (1, 2, 3, 4)
+SIDES = ("T", "B", "L", "R")
+DIRS = {"T": (-1, 0), "B": (1, 0), "L": (0, -1), "R": (0, 1)}
+OPPOSITE = {"T": "B", "B": "T", "L": "R", "R": "L"}
+
+MAX_GENERATION_ATTEMPTS = 500
+SPRITE_BUILD_ATTEMPTS = 180
+SCATTER_ATTEMPTS = 240
+PORT_ATTEMPTS = 80
