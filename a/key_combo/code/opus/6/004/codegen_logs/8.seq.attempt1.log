 136: def _is_8_connected(pixels):
 137:     """Check if pixels form a single 8-connected component."""
 138:     pixel_set = set(pixels)
 139:     if not pixel_set:
 140:         return False
 141:     visited = {(start := next(iter(pixel_set)))}
 142:     stack = [start]
 143:     while stack:
 144:         r, c = stack.pop()
 145:         for dr in (-1, 0, 1):
 146:             for dc in (-1, 0, 1):
 147:                 if dr == 0 and dc == 0:
 148:                     continue
 149:                 nb = (r + dr, c + dc)
 150:                 if nb in pixel_set and nb not in visited:
 151:                     visited.add(nb)
 152:                     stack.append(nb)
 153:     return len(visited) == len(pixel_set)
