 124: def _cavity_cells(pixels):
 125:     """Return cavity cell coordinates."""
 126:     pixel_set = set(map(tuple, pixels))
 127:     rows = _cavity_rows(pixels)
 128:     cells = []
 129:     for r, cols in rows.items():
 130:         s = sorted(cols)
