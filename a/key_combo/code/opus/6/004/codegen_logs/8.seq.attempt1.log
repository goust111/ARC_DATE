 126: def _gen_symmetric_widths(height: int, width: int, *, min_width: int = MIN_ROW_WIDTH,
 127:                           varied: bool = False, include_max: bool = False) -> list[int]:
 128:     """Sample row widths and mirror them vertically."""
 129:     half = (height + 1) // 2
 130:     vals = [random.randint(min_width, width) for _ in range(half)]
 131:     if include_max:
 132:         vals[random.randrange(half)] = width
 133:     if varied and width > min_width and len(set(vals + vals[: height // 2][::-1])) == 1:
 134:         j = random.randrange(half)
 135:         vals[j] = min(width, vals[j] + 1) if vals[j] < width else vals[j] - 1
 136:     return vals + vals[: height // 2][::-1]
