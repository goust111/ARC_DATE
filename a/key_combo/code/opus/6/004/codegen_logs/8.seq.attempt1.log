+def simulate_sorted_assembly(objects: list[dict], bg: int) -> tuple[dict[int, tuple[int, int]], list[list[int]]]:
+    ordered = sorted(range(len(objects)), key=lambda idx: int(objects[idx]["area"]), reverse=True)
