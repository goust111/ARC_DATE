+def scatter_input(sprites: list[np.ndarray]) -> np.ndarray | None:
+    h = random.randint(*CANVAS_RANGE)
+    w = random.randint(*CANVAS_RANGE)
+    canvas = np.zeros((h, w), dtype=int)
+    shadow = np.zeros((h, w), dtype=bool)
