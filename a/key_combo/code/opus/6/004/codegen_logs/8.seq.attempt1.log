+
+
+def connector_dir(sprite: np.ndarray, r: int, c: int, bg: int) -> tuple[int, int]:
+    dirs = []
+    h, w = sprite.shape
+    for dr, dc in DIRS.values():
+        rr, cc = r + dr, c + dc
