+    if out.shape != (h, w):
+        return False
+    if not np.array_equal(out[0], spec["palette"]):
+        return False
+    if spec["depth"] + 1 < h and np.any(out[spec["depth"] + 1 :, :] != int(BG)):
+        return False
+    for k in range(1, spec["depth"] + 1):
