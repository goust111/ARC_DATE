+def _mark_neighbors(mask: np.ndarray, r: int, c: int) -> None:
+    h, w = mask.shape
+    for rr in range(max(0, r - 1), min(h, r + 2)):
+        for cc in range(max(0, c - 1), min(w, c + 2)):
+            mask[rr, cc] = True
