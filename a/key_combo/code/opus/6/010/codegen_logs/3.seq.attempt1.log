+    return markers
+
+
+def _render_instance(
+    shape: tuple[int, int],
+    placements: list[dict],
+    counts_by_color: dict[int, int],
+    markers: dict[int, list[tuple[int, int]]],
+) -> tuple[np.ndarray, np.ndarray]:
