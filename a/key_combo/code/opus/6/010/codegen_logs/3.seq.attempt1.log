+from arc_utils import bbox_coords, find_components, get_bg
+
+
+BG = 0
+FRAME = 5
+MARKER_COLORS = [1, 2, 3, 4, 6, 7, 8, 9]
+
+GRID_H_RANGE = (20, 24)
+GRID_W_RANGE = (20, 24)
+NUM_CUPS_CHOICES = (3, 4)
+CAPACITY_CHOICES = (3, 4, 5, 6, 7)
+GEN_RETRIES = 400
