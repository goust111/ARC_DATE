+            for r0, c0, r1, c1 in boxes:
+                if r0 - 1 <= r <= r1 + 1 and c0 - 1 <= c <= c1 + 1:
+                    return False
+    if np.count_nonzero((inp != BG) & (inp != FRAME)) != sum(capacities):
+        return False
+    return True
