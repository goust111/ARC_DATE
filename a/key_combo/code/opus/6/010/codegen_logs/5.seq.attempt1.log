+
+def _line_cells(start: Coord, end: Coord) -> list[Coord]:
+    r0, c0 = start
+    r1, c1 = end
+    dr = (r1 > r0) - (r1 < r0)
+    dc = (c1 > c0) - (c1 < c0)
+    steps = max(abs(r1 - r0), abs(c1 - c0))
+    assert dr == 0 or dc == 0
+    return [(r0 + dr * i, c0 + dc * i) for i in range(steps + 1)]
