+    if side == "top":
+        limit = r0
+    elif side == "bottom":
+        limit = H - 1 - r1
+    elif side == "left":
+        limit = c0
+    else:
+        limit = W - 1 - c1
+    return [d for d in range(2, limit - trail_cap + 1)]
