+def _render_output(shape: tuple[int, int], rect: BBox, markers: list[dict]) -> np.ndarray:
+    out = np.full(shape, BG, dtype=int)
+    r0, c0, r1, c1 = rect
+    out[r0 : r1 + 1, c0 : c1 + 1] = RECT_OUT
