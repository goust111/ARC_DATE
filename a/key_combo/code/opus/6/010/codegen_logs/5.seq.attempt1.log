+BG = 0
+RECT_IN = 1
+DIR_TRAIL = 2
+RECT_OUT = 3
+CROSS = 4
+MARK = 9
+
+DIRS = {
+    "up": (-1, 0),
+    "down": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+OPPOSITE = {
+    "up": "down",
+    "down": "up",
+    "left": "right",
+    "right": "left",
+}
+SIDE_TO_TRAIL = {
+    "top": "up",
+    "bottom": "down",
+    "left": "left",
+    "right": "right",
+}
+CORNER_SLOTS = {
+    "tl": (("top", "left"), ("left", "top")),
+    "tr": (("top", "right"), ("right", "top")),
+    "bl": (("bottom", "left"), ("left", "bottom")),
+    "br": (("bottom", "right"), ("right", "bottom")),
