+def _random_rect(shape: tuple[int, int]) -> BBox:
+    H, W = shape
+    rh = random.randint(4, 5)
+    rw = random.randint(4, 6)
+    r0 = random.randint(4, H - rh - 5)
+    c0 = random.randint(4, W - rw - 5)
+    return r0, c0, r0 + rh - 1, c0 + rw - 1
