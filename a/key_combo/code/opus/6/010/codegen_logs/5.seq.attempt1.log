+        ("top", "right"): (r0, c1),
+        ("bottom", "left"): (r1, c0),
+        ("bottom", "right"): (r1, c1),
+        ("left", "top"): (r0, c0),
+        ("left", "bottom"): (r1, c0),
+        ("right", "top"): (r0, c1),
+        ("right", "bottom"): (r1, c1),
