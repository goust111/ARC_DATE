+    own_red_neighbors: dict[Coord, set[Coord]] = defaultdict(set)
+    for marker in markers:
+        cells = [marker["start"], *marker["trail"]]
+        for rr, cc in cells:
+            if not (0 <= rr < H and 0 <= cc < W):
+                return False
+            if (rr, cc) in seen_input:
+                return False
+            seen_input[(rr, cc)] = "input"
