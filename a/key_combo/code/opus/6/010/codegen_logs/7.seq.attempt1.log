9: def main(grid: np.ndarray) -> np.ndarray:
10:     """
11:     Complete every colored sprite by applying the union of all aligned partial sprite masks.
12: 
13:     Input structure:
14:     - The dominant color is the background.
15:     - Each non-background color appears as a separated partial copy of one common sprite mask.
16:     - The copies share a top-left-aligned sprite window; some copies may be missing lower or right edge pixels.
17: 
18:     Rule:
19:     - Crop each same-color mask to its bounding box.
20:     - Pad the crops to the maximum observed height and width, aligned at the top-left, and OR them into one complete template.
21:     - Fill that template at every sprite location using the sprite's own color.
22: 
23:     Key insight:
24:     - No single input sprite is complete, but their missing cells are complementary, so the aligned union reveals the full mask.
25:     """
26:     g = np.asarray(grid, dtype=int)
27:     assert g.ndim == 2, "expected a 2D grid"
28:     height, width = map(int, g.shape)
29: 
30:     bg = get_bg(g)
31:     colors = colors_present(g, exclude={bg})
32:     assert len(colors) >= 2, "expected multiple partial sprite copies"
33: 
34:     sprites: list[tuple[int, int, int, np.ndarray]] = []
35:     for color in colors:
36:         mask = g == color
37:         box = bbox(mask)
38:         assert box is not None, "each foreground color must be present"
39:         r0, c0, r1, c1 = box
40:         local = mask[r0 : r1 + 1, c0 : c1 + 1]
41:         assert np.any(local), "expected a nonempty sprite mask"
42:         sprites.append((int(color), int(r0), int(c0), local))
43: 
44:     template_h = max(local.shape[0] for _, _, _, local in sprites)
45:     template_w = max(local.shape[1] for _, _, _, local in sprites)
46:     assert template_h > 0 and template_w > 0
47: 
48:     template = np.zeros((template_h, template_w), dtype=bool)
49:     for _, _, _, local in sprites:
50:         local_h, local_w = map(int, local.shape)
51:         template[:local_h, :local_w] |= local
52:     assert np.any(template), "expected a nonempty recovered sprite template"
