+
+def _symmetry_violations(inner: np.ndarray, period_h: int, period_w: int, axes: Iterable[str]) -> set[tuple[int, int]]:
+    out: set[tuple[int, int]] = set()
+    for r in range(inner.shape[0]):
+        for c in range(inner.shape[1]):
+            if int(inner[r, c]) == BG:
