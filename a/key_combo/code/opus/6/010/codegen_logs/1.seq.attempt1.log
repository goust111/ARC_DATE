+def _period_violations(inner: np.ndarray, template: np.ndarray) -> set[tuple[int, int]]:
+    period_h, period_w = map(int, template.shape)
+    out: set[tuple[int, int]] = set()
+    for r in range(inner.shape[0]):
+        for c in range(inner.shape[1]):
+            if int(inner[r, c]) == BG:
