+        palette = list(rng.choice(INPUT_COLORS, size=color_count, replace=False))
+        tile = _build_base_tile(rng, height, width, axes, palette)
+        if axes != ("h", "v"):
+            _break_unwanted_axis(rng, tile, axes, palette)
