+
+def _symmetry_orbits(height: int, width: int, axes: Iterable[str]) -> list[list[tuple[int, int]]]:
+    seen: set[tuple[int, int]] = set()
+    orbits: list[list[tuple[int, int]]] = []
+    axes = tuple(axes)
+    for r in range(height):
