+                continue
+            orbit = {(int(r), int(c))}
+            frontier = [(int(r), int(c))]
+            while frontier:
+                rr, cc = frontier.pop()
+                for axis in axes:
+                    nr, nc = _mirror_local(rr, cc, height, width, axis)
+                    if (nr, nc) not in orbit:
+                        orbit.add((nr, nc))
+                        frontier.append((nr, nc))
