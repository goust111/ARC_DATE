+
+def _get_inner_window(grid: np.ndarray) -> tuple[np.ndarray, int, int]:
+    g = np.asarray(grid, dtype=int)
+    if (
+        g.shape[0] >= 3
+        and g.shape[1] >= 3
+        and np.all(g[0, :] == BG)
+        and np.all(g[-1, :] == BG)
+        and np.all(g[:, 0] == BG)
+        and np.all(g[:, -1] == BG)
