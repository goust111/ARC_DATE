+def _symmetry_violation(inner: np.ndarray, r: int, c: int, period_h: int, period_w: int, axes: Iterable[str]) -> bool:
+    local_r = int(r % period_h)
+    local_c = int(c % period_w)
+    base_r = int(r - local_r)
+    base_c = int(c - local_c)
+    value = int(inner[r, c])
