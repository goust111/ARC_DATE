+    if (dr, dc) == (1, 0):
+        return rr0 == r0 and rc0 == c0 and rr1 == r1 - 1 and rc1 == c1
+    if (dr, dc) == (0, -1):
+        return rr0 == r0 and rc0 == c0 + 1 and rr1 == r1 and rc1 == c1
+    return rr0 == r0 and rc0 == c0 and rr1 == r1 and rc1 == c1 - 1
+
