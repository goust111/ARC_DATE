+    candidates = []
+    for cell in sorted(cells):
+        neighbors = []
+        r, c = cell
+        for dr, dc in DIRS.values():
+            nxt = (r + dr, c + dc)
+            if nxt in cells:
+                neighbors.append(nxt)
+        if len(neighbors) != 1:
