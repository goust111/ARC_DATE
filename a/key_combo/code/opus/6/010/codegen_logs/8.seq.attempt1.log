+def _is_connected(cells):
+    if not cells:
+        return False
+    stack = [next(iter(cells))]
+    seen = set()
+    while stack:
+        cell = stack.pop()
+        if cell in seen:
+            continue
+        seen.add(cell)
+        r, c = cell
+        for dr, dc in DIRS.values():
+            nxt = (r + dr, c + dc)
+            if nxt in cells and nxt not in seen:
+                stack.append(nxt)
+    return seen == cells
