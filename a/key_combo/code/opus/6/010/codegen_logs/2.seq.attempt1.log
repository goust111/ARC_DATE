+        nr0 = r0 - (h - ov_r)
+        nc0 = c1 - ov_c + 1
+    elif quadrant == "UL":
+        nr0 = r0 - (h - ov_r)
+        nc0 = c0 - (w - ov_c)
+    elif quadrant == "DR":
+        nr0 = r1 - ov_r + 1
+        nc0 = c1 - ov_c + 1
+    elif quadrant == "DL":
+        nr0 = r1 - ov_r + 1
+        nc0 = c0 - (w - ov_c)
+    else:
+        raise ValueError(quadrant)
+    return (int(nr0), int(nc0), int(nr0 + h - 1), int(nc0 + w - 1))
