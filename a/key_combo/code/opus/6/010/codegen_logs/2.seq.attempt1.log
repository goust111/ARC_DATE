+    height = rng.randint(max(18, h_min), min(30, h_min + 5))
+    width = rng.randint(max(18, w_min), min(30, w_min + 5))
+    slack_h = height - h_min
+    slack_w = width - w_min
+    off_r = margins["U"] + rng.randint(0, slack_h) - min_r
+    off_c = margins["L"] + rng.randint(0, slack_w) - min_c
