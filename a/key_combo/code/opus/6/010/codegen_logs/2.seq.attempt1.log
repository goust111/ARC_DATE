+        nr0 = r0 - (h - ov_r)
+        nc0 = c1 - ov_c + 1
+    elif quadrant == "UL":
+        nr0 = r0 - (h - ov_r)
+        nc0 = c0 - (w - ov_c)
+    elif quadrant == "DR":
