+        if len(owners) != 1:
+            raise AssertionError("each orange cell must belong to exactly one frame")
+        owner = owners[0]
+        if owner["color"] in assigned_colors:
+            raise AssertionError("each frame must own exactly one orange cell")
+        owner["content"] = cell
+        assigned_colors.add(owner["color"])
