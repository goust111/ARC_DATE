+        rr = frame["tail"][0] + dr * rank
+        cc = frame["tail"][1] + dc * rank
+        out[rr, cc] = CONTENT
+    return out
+
+
+def _semantic_checks(inp: np.ndarray, frames: list[dict], expected: np.ndarray) -> bool:
