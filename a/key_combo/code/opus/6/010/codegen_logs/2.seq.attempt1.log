        masks.append(m)

    if not np.array_equal(np.logical_or.reduce(masks), template):
        return None
    return masks


def _gen_attempt() -> np.ndarray | None:
    height = random.randint(*GRID_HEIGHT_RANGE)
    width = random.randint(*GRID_WIDTH_RANGE)
