+            out.append(("U", tail))
+    if len(by_row[max_row]) == 1:
+        tail = (max_row, by_row[max_row][0])
+        if (tail[0] - 1, tail[1]) in coords_set:
+            out.append(("D", tail))
+    if len(by_col[min_col]) == 1:
+        tail = (by_col[min_col][0], min_col)
+        if (tail[0], tail[1] + 1) in coords_set:
