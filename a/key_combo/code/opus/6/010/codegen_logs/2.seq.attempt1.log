+        raise AssertionError("missing frame color")
+    coords_set = set(coords)
+
+    candidates = _tail_candidates(coords_set)
+    if len(candidates) != 1:
+        raise AssertionError("frame tail must be uniquely recoverable")
+    direction, tail = candidates[0]
