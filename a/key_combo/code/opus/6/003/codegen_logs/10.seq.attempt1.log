+    assert get_bg(g) == BG
+    assert set(colors_present(g, exclude={BG})) <= {1, 2, 3, 4, SEP, HOLE}
+    records = _solve_regions(g)
+    assert sorted(int(rec["missing"]) for rec in records) == [1, 2, 3, 4]
+    return _render_output(g, records)
