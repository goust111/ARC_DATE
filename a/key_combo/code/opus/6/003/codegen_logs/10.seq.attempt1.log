+    records = []
+    for name, (r0, r1, c0, c1) in _region_bounds(grid):
+        region = grid[r0:r1, c0:c1]
+        missing, hole_local = _infer_region(region)
+        records.append(
+            {
+                "name": name,
+                "bounds": (r0, r1, c0, c1),
+                "missing": missing,
+                "hole_local": hole_local,
+            }
+        )
+    return records
