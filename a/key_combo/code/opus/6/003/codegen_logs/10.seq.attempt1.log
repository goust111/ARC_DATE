 197:     extra = int(length) - sum(sizes) - int(min_gap) * (len(sizes) - 1)
 198:     if extra < 0:
 199:         return None
 200:     gaps = _composition(extra, len(sizes) + 1)
 201:     intervals: list[tuple[int, int]] = []
 202:     pos = gaps[0]
 203:     for i, size in enumerate(sizes):
 204:         intervals.append((pos, pos + int(size) - 1))
 205:         pos += int(size)
 206:         if i + 1 < len(sizes):
 207:             pos += int(min_gap) + gaps[i + 1]
 208:     return intervals
