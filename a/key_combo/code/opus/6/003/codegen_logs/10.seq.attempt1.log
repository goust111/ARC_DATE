+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4)
+SEP = 5
+HOLE = 7
+BAR = 9
+MAX_GEN_ATTEMPTS = 400
+
+
