+import random
+from collections import deque
+from typing import Dict, Iterable, List, Sequence, Set, Tuple
+
+import numpy as np
+
+
+BG = 0
+TOP_COLOR = 1
+BOTTOM_COLOR = 2
+SEP_COLOR = 4
+
+Coord = Tuple[int, int]
+
+TOP_PARTIAL_SHAPES = [
+    ((0, 0), (1, 0), (1, 1), (2, 1)),
+    ((0, 1), (1, 0), (1, 1), (2, 0)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((0, 1), (1, 1), (2, 0), (2, 1)),
+]
+
+BOTTOM_BLOCKED_SHAPES = [
+    ((0, 0), (0, 1), (1, 1), (2, 1)),
+    ((0, 0), (0, 1), (1, 0), (2, 0)),
+    ((0, 1), (1, 0), (1, 1), (2, 1)),
+    ((0, 0), (1, 0), (1, 1), (2, 1)),
