+    g1 = gaps[0]
+    g2 = gaps[-1]
+    partial_neighbor = g2 + 1 if g2 + 1 < w - 1 and g2 + 1 not in gaps else g2 - 1
+    if partial_neighbor in gaps or partial_neighbor <= 0 or partial_neighbor >= w - 1:
