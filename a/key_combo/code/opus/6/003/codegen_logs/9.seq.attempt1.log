+                "original": rec["coords"],
+                "side": rec["side"],
+                "distance": int(rec["distance"]),
+                "columns": tuple(rec["cols"]),
+                "crossed": crossed,
+                "stop_reason": stop_reason,
+                "final_color": int(final_color),
+                "final_coords": _sorted_coords(current),
+            }
