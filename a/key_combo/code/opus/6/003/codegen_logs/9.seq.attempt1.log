+    bot_len = random.randint(3, 4)
+
+    top_a = _top_bar(sep_r, g1, top_near, top_len_a)
+    top_b = _top_bar(sep_r, g1, top_far, top_len_b)
+    top_c = _top_partial(sep_r, min(g2, partial_neighbor), top_partial_dist)
