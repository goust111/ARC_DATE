+        existing.append(list(cells))
+
+    inp = np.full((h, w), BG, dtype=int)
+    inp[sep_r, :] = SEP_COLOR
+    inp[sep_r, gaps] = BG
+    _paint(inp, top_a, TOP_COLOR)
