+        _active_signature(top_c): {"kind": "top_partial", "should_cross": False},
+        _active_signature(bottom_d): {"kind": "bottom_cross", "should_cross": True},
+        _active_signature(bottom_e): {"kind": "bottom_blocked", "should_cross": False},
