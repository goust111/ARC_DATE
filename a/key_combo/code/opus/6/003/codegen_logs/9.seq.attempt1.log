+    used = 0
+    for cell in bot_candidates:
+        if used >= bot_count:
+            break
+        if can_use(cell):
+            inp[cell] = TOP_COLOR
+            out[cell] = TOP_COLOR
+            placed.add(cell)
+            used += 1
