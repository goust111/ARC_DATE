+    if not any(rec["crossed"] for rec in meta["active"] if rec["side"] == "top"):
+        return False
+    if not any(rec["crossed"] for rec in meta["active"] if rec["side"] == "bottom"):
+        return False
+    if not any(rec["stop_reason"] == "body" for rec in meta["active"]):
