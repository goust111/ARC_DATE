+
+def _pick_gap_columns(width: int, count: int) -> List[int]:
+    for _ in range(200):
+        cols = sorted(random.sample(range(2, width - 2), count))
+        if all(cols[i + 1] - cols[i] >= 2 for i in range(len(cols) - 1)):
+            return cols
