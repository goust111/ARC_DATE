+    owner = np.full((out_h, out_w), -1, dtype=int)
+    ah, aw = anchor_hw
+    _place_rect(owner, 0, 0, 0, ah, aw)
+
+    def rec(idx: int, prev_area: int, rects: list[dict]) -> list[dict] | None:
+        if idx == len(branches):
+            return rects.copy() if np.all(owner != -1) else None
