+        ph, pw = patch.shape
+        candidates: list[tuple[int, int]] = []
+        for r0 in range(1, canvas_h - ph):
+            for c0 in range(1, canvas_w - pw):
+                r1 = r0 + ph - 1
+                c1 = c0 + pw - 1
