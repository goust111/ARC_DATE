+def _place_rect(owner: np.ndarray, rect_id: int, r0: int, c0: int, h: int, w: int) -> None:
+    owner[r0 : r0 + h, c0 : c0 + w] = int(rect_id)
+
+
+def _search_output_layout(
+    out_h: int,
+    out_w: int,
+    anchor_hw: tuple[int, int],
+    branches: list[int],
