+def _sample_marker_positions(h: int, w: int, branch: int, rng: random.Random) -> tuple[set[int], set[int]]:
+    if branch == 90:
+        top_need, right_need = 2, 1
+    elif branch == 270:
+        top_need, right_need = 1, 2
+    elif branch == 180:
+        top_need, right_need = 1, 1
