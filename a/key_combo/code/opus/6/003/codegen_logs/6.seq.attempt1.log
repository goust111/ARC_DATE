+            area = int(h * w)
+            _place_rect(owner, idx + 1, r0, c0, h, w)
+            rects.append({"id": idx + 1, "r0": r0, "c0": c0, "h": h, "w": w, "branch": branch, "area": area})
+            solved = rec(idx + 1, area, rects)
+            if solved is not None:
+                return solved
+            rects.pop()
+            owner[r0 : r0 + h, c0 : c0 + w] = -1
