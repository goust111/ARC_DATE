+            if solved is not None:
+                return solved
+            rects.pop()
+            owner[r0 : r0 + h, c0 : c0 + w] = -1
+        return None
+
+    solved = rec(0, out_h * out_w + 1, [{"id": 0, "r0": 0, "c0": 0, "h": ah, "w": aw, "branch": 0, "area": ah * aw}])
