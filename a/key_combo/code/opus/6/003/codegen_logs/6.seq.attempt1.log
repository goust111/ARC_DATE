+        return None
+    anchor = anchors[0]
+    others = [s for s in sprites if s is not anchor]
+    others.sort(key=lambda s: (-s["area"], s["bbox"][0], s["bbox"][1]))
+    total_area = sum(int(s["area"]) for s in sprites)
+    anchor_rot = int(rotations.get(id(anchor), 0))
