+                "bbox": (r0, c0, r1, c1),
+                "patch": patch,
+                "restored": restored,
+                "base": base,
+                "height": int(patch.shape[0]),
+                "width": int(patch.shape[1]),
+                "area": int(patch.shape[0] * patch.shape[1]),
+                "mark_count": mark_count,
+                "top_marks": top_marks,
