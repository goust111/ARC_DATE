+        ah = rng.randint(2, max(2, out_h - 2))
+        aw = rng.randint(2, max(2, out_w - 2))
+        if ah >= out_h or aw >= out_w:
+            continue
+        branches = [90, 180, 270]
+        rng.shuffle(branches)
+        solved = _search_output_layout(out_h, out_w, (ah, aw), branches, rng)
