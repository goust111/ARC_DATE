    pa_c0, pa_c1 = border_left, split_c - 1
    pb_c0, pb_c1 = split_c, W - 1 - border_right
    if pa_r1 - pa_r0 + 1 < MIN_PANEL_DIM or pb_r1 - pb_r0 + 1 < MIN_PANEL_DIM:
        return None

