+
+
+def _naive_any_hit_output(
+    grid: np.ndarray,
+    slot_layout: dict[tuple[int, int], dict],
+    protos: dict[int, tuple[tuple[int, int], ...]],
+    hits: dict[tuple[int, int], int],
+) -> np.ndarray:
+    out = grid.copy()
+    for slot, rec in slot_layout.items():
