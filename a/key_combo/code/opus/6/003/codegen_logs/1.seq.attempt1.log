+                    "slot": slot,
+                    "color": int(color),
+                    "coords": comp,
+                    "top_left": (int(r0), int(c0)),
+                    "shape": key,
+                    "rows": {int(r) for r, _c in comp},
+                    "cols": {int(c) for _r, c in comp},
