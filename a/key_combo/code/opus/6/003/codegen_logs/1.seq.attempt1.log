+        usable_left = list(range(rows[0] + 1, rows[-1]))
+        usable_right = list(range(rows[0] + 1, rows[-1]))
+        usable_top = list(range(cols[0] + 1, cols[-1]))
+        usable_bottom = list(range(cols[0] + 1, cols[-1]))
