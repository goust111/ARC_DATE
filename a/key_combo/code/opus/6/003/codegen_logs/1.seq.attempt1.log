+def _draw_frame(slot_h: int, slot_w: int) -> tuple[np.ndarray, list[int], list[int]]:
+    h = 3 * slot_h + 6
+    w = 3 * slot_w + 6
+    rows = [1, slot_h + 2, 2 * slot_h + 3, 3 * slot_h + 4]
+    cols = [1, slot_w + 2, 2 * slot_w + 3, 3 * slot_w + 4]
