+def _paint_edge(
+    grid: np.ndarray,
+    origin_r: int,
+    origin_c: int,
+    a: tuple[int, int],
+    b: tuple[int, int],
+    rng: random.Random,
+) -> None:
+    ar = origin_r + a[0] * 6
+    ac = origin_c + a[1] * 6
+    br = origin_r + b[0] * 6
+    bc = origin_c + b[1] * 6
+    if ar == br:
+        lane = rng.randint(0, 1)
+        row = ar + lane
+        c0, c1 = sorted((ac, bc))
+        grid[row, c0 + 2 : c1] = YELLOW
+    else:
+        lane = rng.randint(0, 1)
+        col = ac + lane
+        r0, r1 = sorted((ar, br))
+        grid[r0 + 2 : r1, col] = YELLOW
+
+
+def _semantic_check(grid: np.ndarray) -> np.ndarray:
+    layout = _extract_layout(grid)
+    path, shortest_count = _shortest_path(layout["adj"], layout["terminals"][0], layout["terminals"][1])
