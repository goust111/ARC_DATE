+def _enumerate_path_shapes() -> list[tuple[tuple[int, int], ...]]:
+    seen: dict[tuple[tuple[int, int], ...], tuple[tuple[int, int], ...]] = {}
+
+    def dfs(path: list[tuple[int, int]]) -> None:
