+    expanded = np.zeros((9, 9), dtype=int)
+    for rr in range(3):
+        for cc in range(3):
+            if int(mask[rr, cc]) == 1:
+                block = micro
+            else:
+                block = np.full((3, 3), GREY, dtype=int)
+            expanded[rr * 3 : (rr + 1) * 3, cc * 3 : (cc + 1) * 3] = block
