+            elif nd == dist[nxt]:
+                count[nxt] += count[cur]
+    if goal not in dist:
+        raise ValueError("terminals are disconnected")
+    path = []
+    cur = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path, int(count[goal])
+
+
+def _mask_from_path(path: list[int], id_to_pos: dict[int, tuple[int, int]]) -> np.ndarray:
+    mask = np.zeros((3, 3), dtype=int)
+    for nid in path:
+        rr, cc = id_to_pos[nid]
+        mask[rr, cc] = 1
+    return mask
+
+
