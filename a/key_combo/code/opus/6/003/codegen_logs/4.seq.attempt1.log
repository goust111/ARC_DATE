+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+MAROON = 9
+
+BASE_COLORS = (BLUE, RED, GREEN, YELLOW)
+MAX_GENERATION_ATTEMPTS = 400
+
