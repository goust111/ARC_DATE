+        assert all(np.all(grid[:, c] == BG) for c in cuts)
+        return [grid[:, i * (size + 1): i * (size + 1) + size].copy() for i in range(4)]
+    if h == 4 * w + 3:
+        size = w
+        cuts = [size, 2 * size + 1, 3 * size + 2]
+        assert all(np.all(grid[r, :] == BG) for r in cuts)
