+    for comp in _components(panel == BG):
+        if any(r == 0 or c == 0 or r == panel.shape[0] - 1 or c == panel.shape[1] - 1 for r, c in comp):
+            continue
+        holes.append(comp)
+    holes.sort(key=_component_key)
+    return holes
+
+
