+def _find_containers(g: np.ndarray, axis_r: int) -> list[dict]:
+    mask = np.zeros_like(g, dtype=bool)
+    mask[axis_r + 1 :, :] = g[axis_r + 1 :, :] == CONTAINER
+    comps = _components_mask(mask)
