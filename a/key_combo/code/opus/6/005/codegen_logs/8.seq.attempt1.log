+        assert bool(np.all(patch[:, 0] == CONTAINER))
+        assert bool(np.all(patch[:, 2] == CONTAINER))
+        assert bool(np.all(patch[-1, :] == CONTAINER))
+        assert bool(np.all(patch[:-1, 1] == BG))
+        interior = [(rr, c0 + 1) for rr in range(r0, r1)]
+        containers.append(
