+def _find_axis_row(g: np.ndarray) -> int:
+    rows = [r for r in range(g.shape[0]) if bool(np.all(g[r, :] == AXIS))]
+    assert len(rows) == 1, f"expected exactly one full-width axis row, got {rows}"
+    return int(rows[0])
