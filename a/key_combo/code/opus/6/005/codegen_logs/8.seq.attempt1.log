+    markers: list[tuple[int, int, int]] = []
+    cols_seen: set[int] = set()
+    for r in range(axis_r):
+        for c in range(g.shape[1]):
+            color = int(g[r, c])
+            if color in (BG, AXIS, CONTAINER):
