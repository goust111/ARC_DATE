+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+CONTAINER_PALETTE = [1, 2, 3, 6, 7, 8, 9]
+DISTRACTOR_PALETTE = [1, 2, 3, 4, 5, 6, 7, 8, 9]
+SMALL_SHAPES = [
+    np.array([[1, 1]], dtype=int),
+    np.array([[1], [1]], dtype=int),
