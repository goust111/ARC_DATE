+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color == BG or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in DIR4:
