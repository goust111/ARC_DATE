+def _render_output(
+    passable: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    sprite: np.ndarray,
+    blank_color: int,
+) -> np.ndarray:
+    path = _lexicographic_shortest_path(passable, start, goal)
+    path_set = set(path)
+    block_size = int(sprite.shape[0])
+    macro_h, macro_w = passable.shape
