+    center_row[block_size // 2, :] = True
+    mask_bank.append(center_row)
+
+    corners = np.zeros((block_size, block_size), dtype=bool)
+    corners[0, 0] = True
+    corners[0, -1] = True
+    corners[-1, 0] = True
+    corners[-1, -1] = True
+    mask_bank.append(corners)
