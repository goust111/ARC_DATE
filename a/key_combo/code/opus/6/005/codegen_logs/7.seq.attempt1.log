+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _lex_key(cell: tuple[int, int]) -> tuple[int, int]:
+    r, c = cell
+    return int(c), int(r)
+
+
+def _separator_indices(grid: np.ndarray, axis: int) -> list[int]:
+    n = grid.shape[axis]
+    out = []
+    for idx in range(n):
+        line = grid[idx, :] if axis == 0 else grid[:, idx]
+        if bool(np.all(line == BLACK)):
+            out.append(int(idx))
+    return out
