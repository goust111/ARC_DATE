   8: def main(grid: np.ndarray) -> np.ndarray:
   9:     """
  10:     Fill holes in a target object with colors from a source object's subsprites, then tight-crop.
  11: 
  12:     Input structure:
  13:     - bg = background. Two similar 8-connected objects share an outline color.
  14:     - Source has colored subsprites in cavities; target has empty cavities.
  15: 
  16:     Rule:
  17:     - Find the two 8-connected objects.
  18:     - Target = object with more hole area. Align subsprites to holes (rotation/flip if needed).
  19:     - Fill each hole with its matched subsprite color; tight-crop.
  20: 
  21:     Key insight: Hole centers in the target are matched to source subsprite centers under the best rotation/flip transform.
  22:     """
  23:     g = np.array(grid, dtype=int)
  24:     bg = int(get_bg(g))
  25: 
  26:     def _components(mask: np.ndarray) -> list[dict]:
  27:         lab, n = label_mask(mask, connectivity=8)
  28:         comps = []
  29:         for cid in range(1, int(n) + 1):
  30:             pts = np.argwhere(lab == int(cid))
  31:             if pts.size == 0:
  32:                 continue
  33:             r0, c0 = pts.min(axis=0)
  34:             r1, c1 = pts.max(axis=0)
  35:             comps.append(
  36:                 {
  37:                     "cid": int(cid),
  38:                     "pts": pts,
  39:                     "size": int(len(pts)),
  40:                     "cent": (float(pts[:, 0].mean()), float(pts[:, 1].mean())),
  41:                     "bbox": (int(r0), int(c0), int(r1), int(c1)),
  42:                 }
  43:             )
  44:         comps.sort(key=lambda d: int(d["size"]), reverse=True)
  45:         return comps
  46: 
  47:     def _extract_two_objects():
  48:         comps = _components(g != int(bg))
  49:         if len(comps) < 2:
  50:             return [comps]
  51:         return [[comps[0]], [comps[1]]]
  52: 
  53:     def _bbox_of(group: list[dict]) -> tuple[int, int, int, int]:
  54:         r0 = min(int(d["bbox"][0]) for d in group)
  55:         c0 = min(int(d["bbox"][1]) for d in group)
  56:         r1 = max(int(d["bbox"][2]) for d in group)
  57:         c1 = max(int(d["bbox"][3]) for d in group)
  58:         return int(r0), int(c0), int(r1), int(c1)
  59: 
  60:     def _extract_group_subgrid(group: list[dict]) -> np.ndarray:
  61:         r0, c0, r1, c1 = _bbox_of(group)
  62:         sub = np.full((int(r1 - r0 + 1), int(c1 - c0 + 1)), int(bg), dtype=int)
  63:         for d in group:
  64:             for rr, cc in d["pts"]:
  65:                 sub[int(rr) - int(r0), int(cc) - int(c0)] = int(g[int(rr), int(cc)])
  66:         return sub
  67: 
  68:     def _enclosed_bg_components(sub: np.ndarray) -> list[dict]:
  69:         m = sub == int(bg)
  70:         lab, n = label_mask(m, connectivity=4)
  71:         Hs, Ws = sub.shape
  72:         holes = []
  73:         for cid in range(1, int(n) + 1):
  74:             pts = np.argwhere(lab == int(cid))
  75:             if pts.size == 0:
  76:                 continue
  77:             r0, c0 = pts.min(axis=0)
  78:             r1, c1 = pts.max(axis=0)
  79:             if bool(r0 == 0 or c0 == 0 or r1 == int(Hs - 1) or c1 == int(Ws - 1)):
  80:                 continue
  81:             cent = (int(round(float(pts[:, 0].mean()))), int(round(float(pts[:, 1].mean()))))
  82:             holes.append({"pts": pts, "cent": cent, "size": int(len(pts))})
  83:         return holes
  84: 
  85:     def _outline_col(sub: np.ndarray) -> int:
  86:         cnt = Counter(map(int, sub.flatten()))
  87:         opts = [(c, n) for c, n in cnt.items() if int(c) != int(bg)]
  88:         return int(max(opts, key=lambda t: t[1])[0]) if opts else int(bg)
