+    out = []
+    for d in DIRS:
+        if d in forbidden:
+            continue
+        nxt = _add(cur, d)
+        if not (0 <= nxt[0] < LATTICE_SIZE and 0 <= nxt[1] < LATTICE_SIZE):
+            continue
+        if nxt in blocked:
+            continue
+        out.append(d)
+    return out
