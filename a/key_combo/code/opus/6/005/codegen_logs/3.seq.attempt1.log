+def _transform_template(cells: list[tuple[int, int]], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    out = []
+    for r, c in cells:
+        rr = r - 1
+        cc = c - 1
+        if direction == (-1, 0):
