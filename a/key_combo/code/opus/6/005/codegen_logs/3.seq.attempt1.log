+
+
+def _transform_template(cells: list[tuple[int, int]], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    out = []
+    for r, c in cells:
+        rr = r - 1
+        cc = c - 1
+        if direction == (-1, 0):
+            tr, tc = rr, cc
+        elif direction == (1, 0):
+            tr, tc = -rr, cc
+        elif direction == (0, -1):
+            tr, tc = cc, rr
+        else:
+            tr, tc = cc, -rr
+        out.append((tr + 1, tc + 1))
