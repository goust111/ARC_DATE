+    left = random.randint(0, min(3, c0))
+    bottom = random.randint(0, min(3, BASE_GRID - 1 - r1))
+    right = random.randint(0, min(3, BASE_GRID - 1 - c1))
+    return grid[r0 - top : r1 + bottom + 1, c0 - left : c1 + right + 1]
