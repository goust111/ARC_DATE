 122:         dst_c0 = max(0, -dc)
 123:         dst_c1 = min(W, W - dc)
 124:         out[dst_r0:dst_r1, dst_c0:dst_c1] |= mask[
 125:             dst_r0 + dr:dst_r1 + dr,
 126:             dst_c0 + dc:dst_c1 + dc,
 127:         ]
 128:     return out
