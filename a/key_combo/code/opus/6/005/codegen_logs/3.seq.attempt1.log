+        "path": path,
+        "extra_parent_idx": extra_parent_idx,
+        "extra_pos": extra_pos,
+        "main_decoys": main_decoys,
+        "extra_stub_dirs": extra_stub_dirs,
+        "main_junctions": main_junctions,
