+            final_cell = (r, c)
+            return {
+                "reached_dest": False,
+                "visited_junctions": visited_junctions,
+                "final_cell": final_cell,
+                "nodes": nodes,
+                "comps": comps,
+                "adjacency": adjacency,
+            }
