+        center = ((r0 + r1) // 2, (c0 + c1) // 2)
+        nodes.append({"kind": "junction", "center": center, "coords": pts})
+
+    walkable = np.isin(g, [CORRIDOR, DEST, MOVER, SPRITE])
+    corridor = walkable.copy()
+    for node in nodes:
