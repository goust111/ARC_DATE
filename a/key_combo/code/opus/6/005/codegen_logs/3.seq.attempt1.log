  28:     for r in range(H):
  29:         for c in range(W):
  30:             if int(base[r, c]) != 1:
  31:                 continue
  32:             nb = 0
  33:             oob = 0
  34:             for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
  35:                 rr = int(r + dr)
  36:                 cc = int(c + dc)
  37:                 if not (0 <= rr < H and 0 <= cc < W):
  38:                     oob += 1
  39:                     continue
