+
+    blocked = set(path)
+    extra_parent_idx = None
+    extra_pos = None
+    extra_stub_dirs = None
+
+    if extra:
+        candidates = []
+        for idx in range(1, len(path) - 1):
+            for d in _free_decoy_dirs(path, idx, blocked):
+                pos = _add(path[idx], d)
+                free2 = []
+                for d2 in DIRS:
+                    if d2 == OPPOSITE[d]:
