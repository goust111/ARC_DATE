+def _has_turn(path: list[tuple[int, int]]) -> bool:
+    for i in range(1, len(path) - 1):
+        incoming = _dir(path[i], path[i - 1])
+        outgoing = _dir(path[i], path[i + 1])
+        if outgoing != OPPOSITE[incoming]:
+            return True
+    return False
