+    if not any((axes & {"d", "a"}) and not (axes & {"h", "v"}) for axes in axes_list):
+        return False
+
+    odd = objects[asym_idx]
+    growth = growth_pixels(grid.shape, odd, grid)
+    if not growth:
+        return False
