+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = [1, 2, 3, 4, 7]
+ORTHOGONALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+
+def neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0:r1 + 1, c0:c1 + 1].copy()
+
+
+def trim_mask(mask: np.ndarray) -> np.ndarray:
+    coords = np.argwhere(mask)
+    r0, c0, r1, c1 = bbox_coords(coords)
+    return mask[r0:r1 + 1, c0:c1 + 1].copy()
+
+
+def find_components(grid: np.ndarray, bg: int = BG) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(g[r, c])
+            if color == bg or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc):
+                    if in_bounds(g.shape, nr, nc) and not seen[nr, nc] and int(g[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            coords = np.array(cells, dtype=int)
+            out.append(
+                {
+                    "color": color,
+                    "coords": coords,
+                    "bbox": bbox_coords(coords),
+                    "area": int(coords.shape[0]),
+                }
+            )
+    return out
+
+
+def object_mask(obj: dict) -> np.ndarray:
+    r0, c0, r1, c1 = obj["bbox"]
+    local = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+    for r, c in obj["coords"]:
+        local[int(r) - r0, int(c) - c0] = True
+    return local
+
+
+def symmetry_axes(mask: np.ndarray) -> set[str]:
+    axes: set[str] = set()
+    if np.array_equal(mask, mask[::-1, :]):
+        axes.add("h")
+    if np.array_equal(mask, mask[:, ::-1]):
+        axes.add("v")
+    if mask.shape[0] == mask.shape[1]:
+        if np.array_equal(mask, mask.T):
+            axes.add("d")
+        anti = np.fliplr(np.flipud(mask)).T
+        if np.array_equal(mask, anti):
+            axes.add("a")
+    return axes
+
