+    for idx, obj in enumerate(objects):
+        if idx == asym_idx:
+            continue
+        if not endpoint_pixels(obj):
+            return False
+        obj_cells = {tuple(map(int, rc)) for rc in obj["coords"]}
+        for gr, gc in growth:
+            if any(max(abs(gr - r), abs(gc - c)) <= 1 for r, c in obj_cells):
+                return False
