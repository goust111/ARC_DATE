+    added = set(map(tuple, np.argwhere((grid == BG) & (out != BG))))
+    removed = set(map(tuple, np.argwhere((grid != BG) & (out == BG))))
+    expected_removed = set()
+    for idx, obj in enumerate(objects):
+        if idx != asym_idx:
+            expected_removed.update(endpoint_pixels(obj))
