+                coords = _mask_coords(mask, top, left)
+                if _placeable(coords, placed):
+                    picked = coords
+                    break
+            if picked is None:
+                ok = False
+                break
+            placed.append(
+                {
+                    "role": spec["role"],
+                    "mask": mask,
+                    "color": spec["color"],
+                    "coords": picked,
+                }
+            )
+        if not ok:
+            continue
+
+        grid = _render_case(placed, (height, width))
+        if _semantic_checks(grid):
+            return grid
