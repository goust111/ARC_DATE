+        rng.choice(DIAG_ONLY_POOL),
+        rng.choice(small_choices),
+        rng.choice(large_choices),
+    ]
+    while len(chosen) < n_objects - 1:
+        chosen.append(rng.choice(ORTH_SYM_POOL + DIAG_ONLY_POOL))
