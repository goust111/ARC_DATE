+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 4 or w < 4:
+        return False
+    expected = 2 * (h + w) - 4
+    if int(area) != expected:
+        return False
+    patch = grid[r0:r1 + 1, c0:c1 + 1]
+    if not np.all(patch[0, :] == FRAME_COLOR):
+        return False
+    if not np.all(patch[-1, :] == FRAME_COLOR):
+        return False
+    if not np.all(patch[:, 0] == FRAME_COLOR):
