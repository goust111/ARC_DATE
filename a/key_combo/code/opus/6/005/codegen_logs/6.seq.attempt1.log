+
+        if bg is None:
+            vals, counts = np.unique(grid, return_counts=True)
+            bg = int(vals[np.argmax(counts)])
+        dirs = [(-1, 0), (1, 0), (0, -1), (0, 1)] if connectivity == 4 else [
+            (dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)
