+
+
+def _decoy_candidates(
+    shape: tuple[int, int],
+    source_line: tuple[str, int],
+    active: tuple[str, int],
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    upper_rows = list(range((h - 1) // 2))
