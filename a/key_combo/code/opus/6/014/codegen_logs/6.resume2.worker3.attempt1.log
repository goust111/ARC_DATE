+
+def _active_candidates(
+    shape: tuple[int, int],
+    source_line: tuple[str, int],
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    h, w = shape
+    axis, index = source_line
+    out: list[tuple[int, int]] = []
+
+    if axis == "row":
+        r = index
+        for c in range(w):
+            src = (r, c)
+            dst = _sym(shape, r, c)
+            if src in forbidden or dst in forbidden:
+                continue
+            out.append(src)
+    else:
+        c = index
+        upper_rows = list(range((h - 1) // 2))
+        for r in upper_rows:
+            src = (r, c)
+            dst = _sym(shape, r, c)
+            if src in forbidden or dst in forbidden:
+                continue
+            out.append(src)
