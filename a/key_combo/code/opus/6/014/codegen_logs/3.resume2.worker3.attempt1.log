+def _tight_mask_from_cells(cells: set[tuple[int, int]] | frozenset[tuple[int, int]]) -> np.ndarray:
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    r0, c0 = min(rows), min(cols)
+    h = max(rows) - r0 + 1
+    w = max(cols) - c0 + 1
