+    return 0 <= r < n_rows and 0 <= c < LEGEND_COLS
+
+
+def _find_dominoes(grid: np.ndarray, legend_rows: int):
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    dominoes = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or _cells_in_legend(r, c, legend_rows):
+                continue
+            color = int(grid[r, c])
+            if color == BG:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = rr + dr, cc + dc
+                    if not (0 <= nr < h and 0 <= nc < w):
+                        continue
+                    if seen[nr, nc] or _cells_in_legend(nr, nc, legend_rows):
+                        continue
+                    if int(grid[nr, nc]) != color:
+                        continue
+                    seen[nr, nc] = True
+                    q.append((nr, nc))
+            coords = sorted(coords)
+            if len(coords) != 2:
+                raise AssertionError("every non-legend object must be a 2-pixel domino")
+            (r0, c0), (r1, c1) = coords
+            if r0 == r1 and abs(c0 - c1) == 1:
+                orient = "h"
+                row = r0
+                left = min(c0, c1)
+                distance = min(left + 1, w - left - 1)
+                dominoes.append(
