+    if _bbox(a)[0] < INSTR_H or _bbox(b)[0] < INSTR_H:
+        return None
+    return {a_dir: a, b_dir: b}
+
+
+def _place_extra(direction, h, w, occupied, pair_info):
+    step = DIR_STEP[direction]
+    for _ in range(150):
+        shape = _random_extra_shape(direction)
+        sh_h, sh_w = _shape_dims(shape)
