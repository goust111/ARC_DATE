+    h, w = shape
+    dr, dc = step
+    current = set(coords)
+    distance = 0
+    while True:
+        nxt = {(r + dr, c + dc) for r, c in current}
+        hit_boundary = False
+        blockers = set()
+        for nr, nc in nxt:
