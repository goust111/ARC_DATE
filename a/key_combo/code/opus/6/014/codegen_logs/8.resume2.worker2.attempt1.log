  "path": "vertical ray down the same column from each control pixel to the bottom edge",
  "trajectory": "below the control pixel, cells already in the control color are erased to the background; all other cells on the ray are painted the control color",
  "transform": "leave non-ray cells and the top-row control pixels unchanged"
}
</annotation>
