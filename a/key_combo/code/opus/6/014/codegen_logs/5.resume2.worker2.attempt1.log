  "path": "straight center ray from the bar center going away from the control pixel to the grid edge",
  "trajectory": "ray itself is not painted; it selects each 4-connected target-color object it crosses",
  "transform": "recolor all pixels of selected target objects to background; leave the marker and other target objects unchanged"
}
</annotation>
