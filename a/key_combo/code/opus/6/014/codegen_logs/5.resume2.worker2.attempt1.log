0038: def main(grid: np.ndarray) -> np.ndarray:
0039:     """
0040:     Infer the background, rotate the whole input 90 degrees counterclockwise, and stack two framed copies vertically.
0041: 
0042:     Input structure:
0043:     - Blue is absent from the input.
0044:     - One rare marker color appears in exactly two pixels.
0045:     - The background is the unique non-marker color whose removal leaves exactly two 4-connected foreground objects, each with one marker pixel and one body color.
0046:     - The whole grid, including background and foreground objects, is the sprite to transform.
0047: 
0048:     Rule:
0049:     - Rotate the entire input grid 90 degrees counterclockwise.
0050:     - Create a blue one-pixel frame around two vertical copies of the rotated grid.
0051:     - Use the input background color for the two endpoints of every horizontal frame/separator row.
0052: 
0053:     Key insight: The output is not a crop of the foreground objects; it is two copies of the complete rotated input, separated and enclosed by a newly added blue border.
0054:     """
0055:     g = np.asarray(grid, dtype=int)
0056:     assert g.ndim == 2
0057: 
0058:     bg, objects = _infer_background_and_objects(g)
0059:     assert bg != Color.BLUE
0060:     assert Color.BLUE not in set(map(int, g.ravel()))
0061: 
0062:     copies = len(objects)
0063: 
0064:     tile = np.rot90(g, 1)
0065:     tile_h, tile_w = map(int, tile.shape)
0066: 
0067:     out_h = copies * tile_h + copies + 1
0068:     out_w = tile_w + 2
0069:     out = np.full((out_h, out_w), Color.BLUE, dtype=int)
0070: 
0071:     for i in range(copies):
0072:         row = i * (tile_h + 1)
0073:         out[row, 0] = bg
0074:         out[row, -1] = bg
0075:         paste(out, tile, row + 1, 1)
0076: 
0077:     out[-1, 0] = bg
0078:     out[-1, -1] = bg
0079:     return out
