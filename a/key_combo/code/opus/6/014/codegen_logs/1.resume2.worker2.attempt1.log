+    for r, c in coords:
+        lines[(r - c) if axis == "nwse" else (r + c)].append((r, c))
+
+    best = 0
+    want_dc = 1 if axis == "nwse" else -1
+    for pts in lines.values():
+        pts.sort()
+        cur = 1
+        best = max(best, cur)
