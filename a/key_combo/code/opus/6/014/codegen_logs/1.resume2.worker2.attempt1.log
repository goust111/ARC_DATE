+
+
+def _diagonal_orientations_between(a: set[tuple[int, int]], b: set[tuple[int, int]]) -> set[str]:
+    orientations = set()
+    for r, c in a:
+        for dr, dc in ((-1, -1), (-1, 1), (1, -1), (1, 1)):
+            if (r + dr, c + dc) in b:
