+                    owner = growth_owner[(nr, nc)]
+                    reason = "occupied_other" if owner != info["id"] else "occupied_self"
+                    seed_meta["stop_reasons"][reason] += 1
+                    meta["stop_reasons"][reason] += 1
+                    if owner != info["id"]:
