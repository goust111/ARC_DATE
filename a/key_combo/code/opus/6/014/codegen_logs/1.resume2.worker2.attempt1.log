+BLACK = 0
+RED = 2
+GREY = 5
+PINK = 6
+ORANGE = 7
+
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+AXIS_DIRS = {
+    "nwse": [(-1, -1), (1, 1)],
+    "nesw": [(-1, 1), (1, -1)],
+}
+
+GEN_ATTEMPTS = 400
+GRID_MIN = 15
