+def _render_grid(regions: list[set[tuple[int, int]]], h: int, w: int) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for coords in regions:
+        for r, c in coords:
+            grid[r, c] = GREY
+    return grid
