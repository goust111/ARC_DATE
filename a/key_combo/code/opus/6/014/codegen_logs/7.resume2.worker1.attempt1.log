+    candidates = _bar_candidates(target_cols, sep_col, width, require_visible_non_target)
+    if not candidates:
+        return None
+    top = candidates[: min(10, len(candidates))]
+    chosen = dict(rng.choice(top))
+    chosen["row"] = int(row)
+    return chosen
