+def _children_between_gapped_pairs(mask: np.ndarray) -> np.ndarray:
+    mask = np.asarray(mask, dtype=bool)
+    children = np.zeros_like(mask, dtype=bool)
+    if mask.size >= 3:
+        children[1:-1] = mask[:-2] & (~mask[1:-1]) & mask[2:]
+    return children
