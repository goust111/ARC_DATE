+def _extract_bars(grid: np.ndarray, sep_col: int, bg: int) -> list[dict]:
+    bars: list[dict] = []
+    h, w = grid.shape
+    for r in range(h):
+        c = sep_col + 1
+        while c < w:
+            value = int(grid[r, c])
+            if value in (bg, SEP):
