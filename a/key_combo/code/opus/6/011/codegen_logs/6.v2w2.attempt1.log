+def _all_full_indices(grid: np.ndarray, color: int, axis: int) -> list[int]:
+    if axis == 0:
+        return [int(r) for r in range(grid.shape[0]) if np.all(grid[r, :] == color)]
+    return [int(c) for c in range(grid.shape[1]) if np.all(grid[:, c] == color)]
