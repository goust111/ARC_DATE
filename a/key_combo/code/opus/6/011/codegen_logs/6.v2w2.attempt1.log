+    while int(np.count_nonzero(colors)) < target_filled:
+        empties = list(zip(*np.where(colors == 0)))
+        if not empties:
+            break
+        r, c = random.choice(empties)
+        colors[r, c] = _maybe_bias_color(colors, int(r), int(c))
