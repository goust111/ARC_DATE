+def _adjacent_pairs(colors: np.ndarray) -> tuple[list[tuple[tuple[int, int], tuple[int, int]]], list[tuple[tuple[int, int], tuple[int, int]]]]:
+    horiz = []
+    vert = []
+    for ri in range(colors.shape[0]):
+        for ci in range(colors.shape[1] - 1):
