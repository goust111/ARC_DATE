+
+def _band_sizes(count: int) -> list[int]:
+    while True:
+        sizes = [random.choice((2, 3)) for _ in range(count)]
+        if 2 in sizes and 3 in sizes:
+            return sizes
+
+
+def _band_positions(sizes: Iterable[int]) -> tuple[list[int], list[tuple[int, int]]]:
+    seps = [0]
+    bands = []
+    cursor = 0
+    for size in sizes:
+        r0 = cursor + 1
+        r1 = r0 + int(size) - 1
+        bands.append((r0, r1))
+        cursor = r1 + 1
+        seps.append(cursor)
