+
+
+def _validate_input_structure(grid: np.ndarray, row_sizes: list[int], col_sizes: list[int], colors: np.ndarray) -> bool:
+    try:
+        sep_rows, sep_cols, row_bands, col_bands, parsed = _parse_cells(grid)
