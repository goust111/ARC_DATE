+    horiz_pairs, vert_pairs = _adjacent_pairs(colors)
+    same_h = 0
+    same_v = 0
+    diff_or_empty = 0
+    has_empty_neighbor = False
+    for a, b in horiz_pairs + vert_pairs:
+        ca = int(colors[a])
+        cb = int(colors[b])
+        if ca != 0 and ca == cb:
+            if a[0] == b[0]:
+                same_h += 1
+            else:
+                same_v += 1
+        else:
+            diff_or_empty += 1
+            if (ca == 0) != (cb == 0):
+                has_empty_neighbor = True
