+
+
+def _seed_offset(height: int, width: int, ri: int, ci: int) -> tuple[int, int]:
+    choices = {
+        (2, 2): [(0, 0), (1, 1), (0, 1), (1, 0)],
+        (2, 3): [(0, 1), (1, 2), (1, 0), (0, 2)],
+        (3, 2): [(1, 0), (0, 1), (2, 1), (1, 1)],
+        (3, 3): [(1, 1), (0, 0), (2, 2), (0, 2), (2, 0)],
