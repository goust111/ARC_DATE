+    return True
+
+
+def _place_segment(colors: np.ndarray, orient: str, length: int, color: int, blocked: set[tuple[int, int]]) -> bool:
+    nr, nc = colors.shape
+    for _ in range(80):
+        if orient == "h":
+            ri = random.randrange(nr)
+            ci = random.randrange(nc - length + 1)
+            coords = [(ri, ci + k) for k in range(length)]
+        else:
