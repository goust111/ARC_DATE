+def _semantic_checks(colors: np.ndarray, row_sizes: list[int], col_sizes: list[int]) -> bool:
+    total = int(colors.size)
+    filled = int(np.count_nonzero(colors))
+    if not (int(np.ceil(0.6 * total)) <= filled <= int(np.floor(0.8 * total))):
