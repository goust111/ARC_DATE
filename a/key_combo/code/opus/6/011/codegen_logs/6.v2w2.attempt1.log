+def _render_from_cells(
+    shape: tuple[int, int],
+    sep_rows: list[int],
+    sep_cols: list[int],
+    row_bands: list[tuple[int, int]],
+    col_bands: list[tuple[int, int]],
+    colors: np.ndarray,
