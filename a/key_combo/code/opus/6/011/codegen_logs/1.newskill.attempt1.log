+def _make_line(axis_col: int, h: int, w: int, orientation: str, used_rows: set[int], used_cols: set[int]) -> dict | None:
+    max_len = min(LINE_LEN_RANGE[1], axis_col - 1, h - 2 if orientation == "v" else axis_col - 1)
