+        mc = _mirror_col(axis_col, col)
+        for i, color in enumerate(seq):
+            grid[start + i, mc] = color
+
+
+def _line_cells(line: dict) -> list[tuple[int, int]]:
+    axis_col = int(line["axis_col"])
+    seq = list(line["seq"])
+    cells: list[tuple[int, int]] = []
