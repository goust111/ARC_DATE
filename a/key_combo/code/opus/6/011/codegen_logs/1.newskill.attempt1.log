+
+def _fill_local_gaps(grid: np.ndarray, axis_col: int) -> tuple[np.ndarray, set[tuple[int, int]]]:
+    base = np.asarray(grid, dtype=int)
+    out = base.copy()
+    filled: set[tuple[int, int]] = set()
+    h, _w = base.shape
+    left_max = axis_col - 1
+    right_min = axis_col + 1
+    right_max = base.shape[1] - 1
