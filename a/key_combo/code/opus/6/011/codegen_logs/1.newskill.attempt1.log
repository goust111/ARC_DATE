+BG = 0
+BLUE = 1
+RED = 2
+AXIS = 5
+LINE_COLORS = (BLUE, RED)
+
+MAX_ATTEMPTS = 400
+HEIGHT_RANGE = (13, 19)
+WIDTH_RANGE = (13, 19)
+LINE_COUNT_RANGE = (4, 6)
+LINE_LEN_RANGE = (7, 10)
+GAP_LEN_RANGE = (1, 3)
