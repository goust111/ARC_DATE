+def _build_output_and_specs() -> tuple[np.ndarray, list[dict], dict] | None:
+    h = random.choice([n for n in range(HEIGHT_RANGE[0], HEIGHT_RANGE[1] + 1)])
+    w = random.choice([n for n in range(WIDTH_RANGE[0], WIDTH_RANGE[1] + 1) if n % 2 == 1])
