+            seq[gap_start - 1] = color
+            seq[gap_start - 2] = color
+        else:
+            seq[gap_start - 1] = other if color == fill else fill
+            seq[gap_start - 2] = color
+            seq[gap_start - 3] = color
+
+    def set_right(dist: int, color: int) -> None:
+        if dist == 1:
+            seq[gap_end + 1] = color
+            seq[gap_end + 2] = color
+        else:
+            seq[gap_end + 1] = other if color == fill else fill
+            seq[gap_end + 2] = color
+            seq[gap_end + 3] = color
