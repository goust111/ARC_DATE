+        if mode in {"right", "both"}:
+            for c in cols:
+                cells.add((row, _mirror_col(axis_col, c)))
+    else:
+        col = int(line["fixed"])
+        mc = _mirror_col(axis_col, col)
+        start = int(line["start"])
+        rows = [start + i for i in range(start_idx, end_idx + 1)]
+        if mode in {"left", "both"}:
+            for r in rows:
+                cells.add((r, col))
+        if mode in {"right", "both"}:
+            for r in rows:
