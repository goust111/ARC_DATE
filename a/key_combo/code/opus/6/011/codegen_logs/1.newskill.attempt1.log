+        start_min = 1
+        start_max = axis_col - length
+        if start_min > start_max:
+            return None
+        start = random.randint(start_min, start_max)
+        used_rows.add(row)
+        return {
+            "orientation": "h",
+            "fixed": row,
+            "start": start,
+            "seq": _random_run_sequence(length),
+            "axis_col": axis_col,
+        }
