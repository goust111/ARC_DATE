+        "orientation": "v",
+        "fixed": col,
+        "start": start,
+        "seq": _random_run_sequence(length),
+        "axis_col": axis_col,
+    }
+
+
+def _rewrite_double_gap(line: dict, branch: str) -> tuple[int, int]:
+    seq = list(map(int, line["seq"]))
+    length = len(seq)
