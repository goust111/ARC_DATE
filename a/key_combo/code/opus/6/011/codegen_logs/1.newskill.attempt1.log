+            left = int(out[r, c])
+            right = int(out[r, mc])
+            if left == BG and _line_mask(right):
+                out[r, c] = right
+                filled.add((r, c))
+            elif right == BG and _line_mask(left):
+                out[r, mc] = left
+                filled.add((r, mc))
