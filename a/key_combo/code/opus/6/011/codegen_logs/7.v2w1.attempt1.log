+def _scenario_spec(index: int) -> tuple[str, int]:
+    cycle = index % 4
+    if cycle == 0:
+        return "clean", 3
+    if cycle == 1:
+        return "collision", 3
+    if cycle == 2:
+        return "clean", 2
+    return "collision", 3
+
