+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr in (-1, 0, 1):
+                    for dc in (-1, 0, 1):
+                        if dr == 0 and dc == 0:
+                            continue
+                        nr = rr + dr
+                        nc = cc + dc
+                        if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
