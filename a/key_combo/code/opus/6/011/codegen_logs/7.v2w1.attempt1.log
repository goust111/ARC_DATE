+def _touches_existing(occupied: set[tuple[int, int]], coords: list[tuple[int, int]]) -> bool:
+    probe = set(coords)
+    for r, c in coords:
+        for dr in (-1, 0, 1):
+            for dc in (-1, 0, 1):
+                nr = r + dr
+                nc = c + dc
+                if (nr, nc) in occupied and (nr, nc) not in probe:
+                    return True
