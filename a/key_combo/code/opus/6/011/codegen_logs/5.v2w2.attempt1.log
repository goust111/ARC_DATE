    s=set()
    for c in range(c0,c1+1): s.add((r0,c)); s.add((r1,c))
    for r in range(r0,r1+1): s.add((r,c0)); s.add((r,c1))
    return s

def draw(g,box,col):
    r0,c0,r1,c1=box
    g[r0,c0:c1+1]=col; g[r1,c0:c1+1]=col; g[r0:r1+1,c0]=col; g[r0:r1+1,c1]=col

def render(shape, boxes, order):
    g=np.zeros(shape,int)
    for col in reversed(order):
        draw(g, boxes[col], col)
    return g

def valid(boxes, order):
    g=render((15,15), boxes, order)
    rank={c:i for i,c in enumerate(order)}
    cols=list(boxes)
    for a,b in itertools.combinations(cols,2):
        pts=perim(boxes[a]) & perim(boxes[b])
        if not pts:
            return False,'no inter'
        vals={int(g[r,c]) for r,c in pts}
        front=a if rank[a]<rank[b] else b
        back=b if front==a else a
        if front not in vals or back in vals:
            return False,('witness',a,b,vals,front,back)
    for col,box in boxes.items():
        r0,c0,r1,c1=box
        lr=np.all(g[r0:r1+1,c0]==col) and np.all(g[r0:r1+1,c1]==col)
        tb=np.all(g[r0,c0:c1+1]==col) and np.all(g[r1,c0:c1+1]==col)
