import random, itertools
import numpy as np

PALETTE=[1,2,3,4,7]

def perim(box):
    r0,c0,r1,c1=box
    s=set()
    for c in range(c0,c1+1): s.add((r0,c)); s.add((r1,c))
    for r in range(r0,r1+1): s.add((r,c0)); s.add((r,c1))
    return s

def draw(g,box,col):
    r0,c0,r1,c1=box
    g[r0,c0:c1+1]=col; g[r1,c0:c1+1]=col; g[r0:r1+1,c0]=col; g[r0:r1+1,c1]=col

def render(shape, boxes, order):
    g=np.zeros(shape,int)
    for col in reversed(order):
        draw(g, boxes[col], col)
    return g

def vis_pair(g,box,col):
    r0,c0,r1,c1=box
    left=np.all(g[r0:r1+1,c0]==col)
    right=np.all(g[r0:r1+1,c1]==col)
    top=np.all(g[r0,c0:c1+1]==col)
    bottom=np.all(g[r1,c0:c1+1]==col)
    return (left and right) or (top and bottom)

def overlap2(a,b):
    r0=max(a[0],b[0]); c0=max(a[1],b[1]); r1=min(a[2],b[2]); c1=min(a[3],b[3])
    return r1-r0+1>=2 and c1-c0+1>=2

def valid_scene(H=15,W=15,n=3):
    colors=random.sample(PALETTE,n)
    order=random.sample(colors,n)
    base_r=random.randint(4,H-5)
    base_c=random.randint(4,W-5)
    patterns=[(-2,-2),(-2,2),(2,-2),(2,2)]
    random.shuffle(patterns)
    boxes={}
    for col,(dr,dc) in zip(colors,patterns):
        h=random.randint(4,8); w=random.randint(4,8)
        cr=base_r+dr+random.randint(-1,1)
        cc=base_c+dc+random.randint(-1,1)
        r0=cr-h//2; c0=cc-w//2
        r0=max(0,min(H-h,r0)); c0=max(0,min(W-w,c0))
        boxes[col]=(r0,c0,r0+h-1,c0+w-1)
    for a,b in itertools.combinations(colors,2):
        if not overlap2(boxes[a],boxes[b]): return False
        if not (perim(boxes[a]) & perim(boxes[b])): return False
    g=render((H,W),boxes,order)
    for col in colors:
        if not vis_pair(g,boxes[col],col): return False
    rank={c:i for i,c in enumerate(order)}
    for a,b in itertools.combinations(colors,2):
        pts=perim(boxes[a]) & perim(boxes[b])
        front=a if rank[a]<rank[b] else b
        back=b if front==a else a
        vals={int(g[r,c]) for r,c in pts}
        if back in vals: return False
        if front not in vals: return False
    return True

for n in [3,4]:
    cnt=0
    trials=5000
    for _ in range(trials):
        if valid_scene(n=n): cnt+=1
    print('n',n,'rate',cnt/trials)
