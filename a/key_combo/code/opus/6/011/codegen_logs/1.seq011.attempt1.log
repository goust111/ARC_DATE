    local_pieces: small rectangular runs and blocks with varied heights/widths
    local_piece_identity: mask-sensitive length/width evidence is per single-color local rectangle, not from a larger multi-color rectangle
    piece_dimensions: height 1-5, width 1-4
    colors: 3-7 distinct (including background); color 8 never used in mosaic
    background: most frequent color, occupies all 4 corners and grid perimeter
    non_bg_colors: 2-6, fill irregular rectilinear regions made from local pieces
  plus_masks:
