+
+def _extract_objects(grid: np.ndarray) -> list[dict]:
+    mask = np.zeros_like(grid, dtype=bool)
+    mask[1:, :] = grid[1:, :] != 0
+    objects: list[dict] = []
+    for coords in _components8(mask):
+        r0, c0, r1, c1 = _bbox(coords)
