+
+def _gen_attempt() -> np.ndarray | None:
+    body_h = random.randint(*BODY_SIDE_RANGE)
+    body_w = random.randint(*BODY_SIDE_RANGE)
+
+    base_objects = _place_base_objects(body_h, body_w)
