+
+def _draw_objects(grid: np.ndarray, objects: list[dict], emitter_color: int) -> None:
+    for obj in objects:
+        r0, c0 = obj["r0"] + LEGEND_H, obj["c0"]
+        if obj["kind"] == "emitter":
