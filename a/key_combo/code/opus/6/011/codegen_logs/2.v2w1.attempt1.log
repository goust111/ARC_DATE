+    border_mask[1:3, 1:3] = False
+    border_vals = sub[border_mask]
+    if np.all(sub[1:3, 1:3] == BG) and np.all(border_vals == border_vals[0]) and border_vals[0] in EMITTER_COLORS:
+        return "emitter", int(border_vals[0])
