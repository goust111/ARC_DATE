+    occupied = [(obj["r0"], obj["c0"]) for obj in objects]
+    body_h = grid.shape[0] - LEGEND_H
+    body_w = grid.shape[1]
+
+    candidates = [(r, c) for r in range(body_h - 3) for c in range(body_w - 3)]
+    random.shuffle(candidates)
