      cands.append((r0,c0))

# near center only
cands=[p for p in cands if abs(p[0]-ER)<=7 and abs(p[1]-EC)<=7]

DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
CW={0:1,1:2,2:3,3:0}
CCW={0:3,3:2,2:1,1:0}
name2d={'U':0,'R':1,'D':2,'L':3}

def simulate(obstacles, turns):
    # obstacles: list[(r0,c0,color)] turns color->'L'/'R'
    obj={} ; et=set((r,c) for r in range(ER,ER+4) for c in range(EC,EC+4))
    for r0,c0,col in obstacles:
        for r in range(r0,r0+4):
