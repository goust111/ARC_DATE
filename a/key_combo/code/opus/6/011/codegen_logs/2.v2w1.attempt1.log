# choose obstacle positions from candidate set, maybe 5 obstacles with repeated colors later.
# Prefer exactly one per sector rough.
sector={}
for p in cands:
    r,c=p
    sr='N' if r<ER else 'S' if r>ER else 'M'
    sc='W' if c<EC else 'E' if c>EC else 'M'
    sector[p]=sr+sc

random.seed(0)
for _ in range(200000):
    # sample 5 nonadjacent placements
    placed=[]
    avail=cands[:]
    random.shuffle(avail)
    for p in avail:
        if ok_place(*p, [(r,c) for r,c,_ in placed]):
            placed.append((p[0],p[1], random.choice(colors)))
            if len(placed)==5:
                break
    if len(placed)<5:
        continue
    # prefer one in each cardinal side region
    s=[sector[(r,c)] for r,c,_ in placed]
    if not any(x.startswith('N') for x in s):
        continue
    if not any(x.startswith('S') for x in s):
        continue
    if not any(x.endswith('W') for x in s):
        continue
    if not any(x.endswith('E') for x in s):
        continue
    for turns in turn_maps:
        res=simulate(placed,turns)
        if res is None:
            continue
        paths,cross=res
        if cross:
            print('found',placed,turns)
