+    {"kind": "obstacle", "role": "S", "turn": "R", "r0": 11, "c0": 5},
+    {"kind": "obstacle", "role": "W", "turn": "R", "r0": 4, "c0": 1},
+    {"kind": "obstacle", "role": "SW", "turn": "R", "r0": 9, "c0": 0},
