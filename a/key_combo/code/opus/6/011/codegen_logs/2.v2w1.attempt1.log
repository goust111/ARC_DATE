+    all_right_out, _ = _simulate(grid, turn_map, objects, forced_turn="R")
+    assert not np.array_equal(out, all_left_out)
+    assert not np.array_equal(out, all_right_out)
+    assert np.any(out[:LEGEND_H, :] != BG)
