+def _find_objects(grid: np.ndarray) -> list[dict]:
+    body = np.asarray(grid[LEGEND_H:], dtype=int)
+    comps = _components(body != BG)
+    objects = []
+    for comp in comps:
+        r0, c0 = comp.min(axis=0)
+        r1, c1 = comp.max(axis=0)
+        sub = body[r0 : r1 + 1, c0 : c1 + 1]
+        info = _classify_bbox(sub)
+        if info is None:
+            continue
+        kind, color = info
+        objects.append(
+            {
+                "kind": kind,
+                "color": color,
+                "r0": int(r0 + LEGEND_H),
+                "c0": int(c0),
+                "r1": int(r1 + LEGEND_H),
+                "c1": int(c1),
