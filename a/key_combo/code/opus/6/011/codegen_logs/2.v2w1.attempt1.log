            if (nr,nc) in obj:
                hit=True
                d = CCW[d] if turns[obj[(nr,nc)]]=='L' else CW[d]
                continue
            # advance through empty or emitter cells
            r,c=nr,nc
            path.append((r,c))
            if (r,c) not in et:
                left_emitter=True
            elif left_emitter:
                cross=True
        paths[nm]=path
        hit_any[nm]=hit
    if not all(hit_any.values()):
        return None
    return paths,cross

# candidate turns over 3 colors 2,4,7 maybe any assignment with both L and R used
colors=[2,4,7]
turn_maps=[]
for bits in product('LR', repeat=3):
    if 'L' in bits and 'R' in bits:
