from itertools import combinations, product

H=W=18
ER,EC=7,7  # emitter top-left in body
emitter={(r,c) for r in range(ER,ER+4) for c in range(EC,EC+4) if r in (ER,ER+3) or c in (EC,EC+3)}
# representative center upper-left of interior
starts=[('U',(ER,EC+1),(-1,0)),('R',(ER+1,EC+3),(0,1)),('D',(ER+3,EC+1),(1,0)),('L',(ER+1,EC), (0,-1))]
# Wait right and down start from border cells? represent current on border.
# object cells full 4x4 for collision, emitter transparent.

def ok_place(r0,c0,placed):
    if not (0<=r0 and 0<=c0 and r0+3<H and c0+3<W): return False
    # not overlap, not adjacent (Chebyshev gap >=2 between bboxes)
    for rr,cc in placed:
        if not (r0+3 < rr-1 or rr+3 < r0-1 or c0+3 < cc-1 or cc+3 < c0-1):
            return False
    # against emitter
    rr,cc=ER,EC
    if not (r0+3 < rr-1 or rr+3 < r0-1 or c0+3 < cc-1 or cc+3 < c0-1):
        return False
    return True

cands=[]
for r0 in range(H-3):
  for c0 in range(W-3):
