+
+    inp = input_scene.copy()
+    for r, c in markers:
+        inp[r, c] = GREEN
+
+    expected = _apply_markers(final_scene, markers)
+    if not _validate_semantics(inp, expected, markers):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _attempt_generate()
+        if grid is not None:
