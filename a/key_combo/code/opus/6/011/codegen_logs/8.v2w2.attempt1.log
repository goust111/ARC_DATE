+        return False
+    marker_set = set(markers)
+    for rr in range(r - 1, r + 2):
+        for cc in range(c - 1, c + 2):
+            if not (0 <= rr < scene.shape[0] and 0 <= cc < scene.shape[1]):
+                continue
+            if (rr, cc) in marker_set:
+                return False
+            if int(scene[rr, cc]) != BG:
+                return False
