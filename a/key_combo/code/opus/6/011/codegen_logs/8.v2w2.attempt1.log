+    h, w = g.shape
+    seen = np.zeros((h, w), dtype=bool)
+    objs: list[dict] = []
+    for r in range(1, h - 1):
+        for c in range(w):
+            if seen[r, c] or int(g[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr, nc = rr + dr, cc + dc
