+        top = shifted["bbox"][0]
+        if top <= prev_top or top < 2 or shifted["bbox"][2] > h - 3:
+            continue
+        if not _objects_separated(placed + [shifted]):
+            continue
+        found = _search_blue_inputs(h, ordered_blue, placed + [shifted], pos + 1, top)
