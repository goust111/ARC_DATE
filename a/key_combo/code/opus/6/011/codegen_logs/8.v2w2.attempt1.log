+    arr = arr - arr.min(axis=0, keepdims=True)
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
+
+
+def _shape_mask_from_coords(coords: np.ndarray) -> np.ndarray:
