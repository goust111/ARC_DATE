+    h = int(norm[:, 0].max()) + 1
+    w = int(norm[:, 1].max()) + 1
+    mask = np.zeros((h, w), dtype=int)
+    mask[norm[:, 0], norm[:, 1]] = 1
+    return mask
+
+
+def _random_shape(*, stack_friendly: bool = False) -> np.ndarray:
+    for _ in range(80):
