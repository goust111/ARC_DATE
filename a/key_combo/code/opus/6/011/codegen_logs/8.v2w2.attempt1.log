    logical grid become thick colored rectangles; adjacent same-color dots are
    joined by bars (horizontal first, vertical only for unclaimed endpoints).
  input_grid:
    shape: (2R+1) x (2C+1) where R, C each from {1,2,3,4,6,8}
    observed_range: R in 2-4, C in 1-4 [observed]
    background: 0
    structure: |
      Even rows/cols are all-bg spacers; odd rows/cols hold the lattice dots.
      Every odd row has >=1 fg pixel; every odd col has >=1 fg pixel.
  lattice:
    dimensions: R x C (the logical dot grid)
    fill_rate: 88-100% foreground [observed]
    distinct_fg_colors: 2-6
    bg_cells_allowed: yes, but every row and column must have >=1 fg cell
    horizontal_connections: 0-4 same-color adjacent pairs per example [observed]
    vertical_connections: 0-1 unclaimed vertical pairs per example [observed]
  output_grid:
    shape: always 26x26
    band_size: (24 - 2*N) / N per axis, guaranteed integer by choice of R, C
    spacer_thickness: 2 (bg between bands)
  connection_rule: |
