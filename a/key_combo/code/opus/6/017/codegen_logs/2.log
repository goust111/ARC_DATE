import random
from collections import deque

import numpy as np


BG = 0
WALL = 1
MARKER_COLORS = (2, 3, 4, 6)
CORNER_ORDER = ("tl", "tr", "bl", "br")
CORNER_SPECS = {
    "tl": {
        "direction": (1, 1),
        "shape": ((0, 0), (0, 1), (1, 0), (1, 1)),
        "anchor_rel": (1, 1),
    },
    "tr": {
        "direction": (1, -1),
        "shape": ((0, 0), (1, 0), (2, 0)),
        "anchor_rel": (2, 0),
    },
    "bl": {
        "direction": (-1, 1),
        "shape": ((0, 0), (0, 1), (0, 2)),
        "anchor_rel": (0, 2),
    },
    "br": {
        "direction": (-1, -1),
        "shape": ((0, 0), (1, 0), (1, 1)),
        "anchor_rel": (0, 0),
    },
}
GEN_HEIGHT_RANGE = (11, 15)
GEN_WIDTH_RANGE = (11, 15)
GEN_BLOCKER_COUNT_RANGE = (3, 5)
GEN_RETRY_LIMIT = 500


def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
    h, w = shape
    return 0 <= r < h and 0 <= c < w


def _corner_position(shape: tuple[int, int], name: str) -> tuple[int, int]:
    h, w = shape
    if name == "tl":
        return 0, 0
    if name == "tr":
        return 0, w - 1
    if name == "bl":
        return h - 1, 0
    if name == "br":
        return h - 1, w - 1
    raise ValueError(f"unknown corner {name}")


def _ray_cells(shape: tuple[int, int], name: str) -> list[tuple[int, int]]:
    r, c = _corner_position(shape, name)
    dr, dc = CORNER_SPECS[name]["direction"]
    cells = []
    while True:
        r += dr
        c += dc
        if not _in_bounds(shape, r, c):
            return cells
        cells.append((r, c))


def _stamp_cells(name: str, anchor: tuple[int, int]) -> list[tuple[int, int]]:
    ar, ac = anchor
    off_r, off_c = CORNER_SPECS[name]["anchor_rel"]
    top = ar - off_r
    left = ac - off_c
    return [(top + dr, left + dc) for dr, dc in CORNER_SPECS[name]["shape"]]


def _trace_anchor(grid: np.ndarray, name: str) -> tuple[int, int]:
    shape = tuple(map(int, grid.shape))
    r, c = _corner_position(shape, name)
    dr, dc = CORNER_SPECS[name]["direction"]
    last = None
    while True:
        r += dr
        c += dc
        if not _in_bounds(shape, r, c):
            raise AssertionError("expected a wall on the corner ray")
        if int(grid[r, c]) == WALL:
            assert last is not None, "wall cannot be adjacent to the corner"
            return last
        last = (r, c)


def _active_markers(grid: np.ndarray) -> list[tuple[str, int]]:
    g = np.asarray(grid, dtype=int)
    seen_colors = set()
    active = []
    for name in CORNER_ORDER:
        r, c = _corner_position(g.shape, name)
        color = int(g[r, c])
        if color == BG:
            continue
        assert color in MARKER_COLORS, "unexpected corner marker color"
        assert color not in seen_colors, "corner marker colors must be distinct"
        seen_colors.add(color)
        active.append((name, color))
    assert 2 <= len(active) <= 3, "expected 2-3 corner markers"
    return active


def _components_of_color(grid: np.ndarray, color: int) -> list[list[tuple[int, int]]]:
    g = np.asarray(grid, dtype=int)
    h, w = g.shape
    seen = np.zeros((h, w), dtype=bool)
    comps = []
    for r in range(h):
        for c in range(w):
            if seen[r, c] or int(g[r, c]) != color:
                continue
            seen[r, c] = True
            q = deque([(r, c)])
            comp = []
            while q:
                cr, cc = q.popleft()
                comp.append((cr, cc))
                for nr, nc in ((cr - 1, cc), (cr + 1, cc), (cr, cc - 1), (cr, cc + 1)):
                    if _in_bounds((h, w), nr, nc) and not seen[nr, nc] and int(g[nr, nc]) == color:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            comps.append(comp)
    return comps


def _fixed_offset_output(grid: np.ndarray) -> np.ndarray:
    out = np.asarray(grid, dtype=int).copy()
    for name, color in _active_markers(out):
        r0, c0 = _corner_position(out.shape, name)
        dr, dc = CORNER_SPECS[name]["direction"]
        out[r0, c0] = BG
        anchor = (r0 + 3 * dr, c0 + 3 * dc)
        for r, c in _stamp_cells(name, anchor):
            if _in_bounds(out.shape, r, c):
                out[r, c] = color
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Replace corner markers by corner-specific colored stamps whose anchor is found by a diagonal wall-seeking ray.

    Input structure:
    - The grid has black background, 3-5 blue obstacle components in the interior, and 2-3 distinct colored corner markers.
    - Each active marker sits exactly on a grid corner and uses one of the colors {2,3,4,6}.
    - Each active corner has at least one blue obstacle somewhere on its 45-degree diagonal ray toward the center.

    Rule:
    - Read each non-black corner marker to determine both its template and its ray direction.
    - Cast a diagonal ray from that corner toward the center and stop at the first blue obstacle pixel; the anchor is the previous ray cell.
    - Stamp the corner's template in the marker color using the corner-specific anchor alignment, erase the original corner marker, and leave blue obstacles unchanged.
    - Apply multiple stamps in corner reading order from top-left to bottom-right, so later stamps overwrite earlier ones if they overlap.

    Key insight:
    The corner position simultaneously chooses the template shape and the ray direction, while the blue obstacle layout chooses the final placement cell where that template is stamped.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    out = g.copy()
