+    candidates = list(range(4, long_side - 4))
+    if len(candidates) < gate_count:
+        return None
+    for _ in range(200):
+        picked = sorted(random.sample(candidates, gate_count))
+        if all(b - a >= GATE_SPACING for a, b in zip(picked, picked[1:])):
