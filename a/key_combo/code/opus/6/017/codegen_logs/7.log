+    patch = grid[r0 : r1 + 1, c0 : c1 + 1]
+    assert np.all(patch == color), f"color {color} must form one solid rectangle"
+    assert int(np.count_nonzero(grid == color)) == patch.size, f"color {color} must be unique"
+    return r0, c0, r1, c1
