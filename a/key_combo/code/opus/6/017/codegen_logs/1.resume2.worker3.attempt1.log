+            continue
+        min_height = max(16, 1 + max(side + 2 for side in sides) + 6)
+        height = random.randint(max(GRID_H_RANGE[0], min_height), GRID_H_RANGE[1])
+        colors = random.sample(list(SQUARE_COLORS), count)
+        random.shuffle(colors)
+        try:
+            grid = _build_input(height, width, colors, sides, starts)
+            _validate_generated(grid)
+            return grid
+        except Exception:
