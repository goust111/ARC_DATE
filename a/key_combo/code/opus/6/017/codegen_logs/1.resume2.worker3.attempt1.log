+def _sample_sides(count: int) -> list[int]:
+    base = [2, 3, 4, 5]
+    if count == 4:
+        sides = base
+    else:
+        sides = base + [random.choice(SIDE_CHOICES)]
+    random.shuffle(sides)
+    odd_sides = [s for s in sides if s % 2 == 1]
+    even_sides = [s for s in sides if s % 2 == 0]
+    assert len(odd_sides) >= 2 and len(even_sides) >= 2
+    assert min(odd_sides) < max(even_sides)
+    assert max(odd_sides) > min(even_sides)
+    return sides
+
+
+def _sample_width_for_sides(sides: list[int]) -> int:
+    min_w = sum(sides) + (len(sides) - 1)
+    max_w = GRID_W_RANGE[1]
+    return random.randint(max(min_w, GRID_W_RANGE[0]), max_w)
+
+
+def _sample_column_starts(width: int, sides: list[int]) -> list[int] | None:
+    free = width - sum(sides)
+    gap_count = len(sides) + 1
+    if free < gap_count - 1:
+        return None
+    gaps = [0] * gap_count
+    remaining = free
+    mandatory_internal = len(sides) - 1
+    for i in range(1, gap_count - 1):
+        gaps[i] = 1
+        remaining -= 1
+    for _ in range(remaining):
+        gaps[random.randrange(gap_count)] += 1
+    starts = []
+    c = gaps[0]
+    for side, gap_after in zip(sides, gaps[1:]):
+        starts.append(c)
+        c += side + gap_after
+    if c - gaps[-1] + 0 > width:
+        return None
+    return starts
+
+
+def _choose_input_row_ranges(height: int, sides: list[int]) -> list[tuple[int, int]]:
+    floor_top = height - 1
+    ranges = []
+    upper_cap = max(1, height // 2)
+    for side in sides:
+        landed_r0 = floor_top - (2 if side % 2 == 1 else 0) - side
+        max_input_r0 = min(upper_cap - side, landed_r0 - 2)
+        min_input_r0 = 0
+        assert max_input_r0 >= min_input_r0, "height too small to lift square above landing row"
+        ranges.append((min_input_r0, max_input_r0))
+    return ranges
+
+
+def _build_input(height: int, width: int, colors: list[int], sides: list[int], starts: list[int]) -> np.ndarray:
+    grid = np.full((height, width), BG, dtype=int)
