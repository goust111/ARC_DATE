+
+@dataclass(frozen=True)
+class Square:
+    color: int
+    r0: int
+    c0: int
+    side: int
+
+    @property
+    def r1(self) -> int:
+        return self.r0 + self.side - 1
+
+    @property
+    def c1(self) -> int:
+        return self.c0 + self.side - 1
+
+    @property
+    def is_odd(self) -> bool:
+        return self.side % 2 == 1
+
+    @property
