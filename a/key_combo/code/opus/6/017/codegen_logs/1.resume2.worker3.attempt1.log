+
+
+BG = 0
+FLOOR = 5
+MARK = 7
+SQUARE_COLORS = (1, 2, 3, 4, 6)
+DIR4 = ((1, 0), (-1, 0), (0, 1), (0, -1))
+
+GRID_H_RANGE = (16, 24)
+GRID_W_RANGE = (18, 28)
