+    if len(active) != len(active_info):
+        return False
+
+    wall_comps = _components_of_color(grid, WALL)
+    if not (GEN_BLOCKER_COUNT_RANGE[0] <= len(wall_comps) <= GEN_BLOCKER_COUNT_RANGE[1]):
+        return False
+    if any(not (1 <= len(comp) <= 3) for comp in wall_comps):
+        return False
