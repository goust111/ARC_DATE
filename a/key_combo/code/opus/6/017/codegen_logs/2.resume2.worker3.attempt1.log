+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Replace corner markers by corner-specific colored stamps whose anchor is found by a diagonal wall-seeking ray.
+
+    Input structure:
+    - The grid has black background, 3-5 blue obstacle components in the interior, and 2-3 distinct colored corner markers.
+    - Each active marker sits exactly on a grid corner and uses one of the colors {2,3,4,6}.
+    - Each active corner has at least one blue obstacle somewhere on its 45-degree diagonal ray toward the center.
+
+    Rule:
+    - Read each non-black corner marker to determine both its template and its ray direction.
+    - Cast a diagonal ray from that corner toward the center and stop at the first blue obstacle pixel; the anchor is the previous ray cell.
+    - Stamp the corner's template in the marker color using the corner-specific anchor alignment, erase the original corner marker, and leave blue obstacles unchanged.
+    - Apply multiple stamps in corner reading order from top-left to bottom-right, so later stamps overwrite earlier ones if they overlap.
+
+    Key insight:
+    The corner position simultaneously chooses the template shape and the ray direction, while the blue obstacle layout chooses the final placement cell where that template is stamped.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    out = g.copy()
+    active = _active_markers(g)
+    for name, color in active:
+        r0, c0 = _corner_position(g.shape, name)
+        out[r0, c0] = BG
+        anchor = _trace_anchor(g, name)
+        for r, c in _stamp_cells(name, anchor):
+            assert _in_bounds(g.shape, r, c), "stamp must stay in bounds"
+            assert int(g[r, c]) != WALL, "stamp must not cover blue obstacles"
+            out[r, c] = color
+    return out
+
+
+def _far_from_set(
+    cells: list[tuple[int, int]] | set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    margin: int = 1,
+) -> bool:
+    for r, c in cells:
+        for rr in range(r - margin, r + margin + 1):
+            for cc in range(c - margin, c + margin + 1):
+                if (rr, cc) in occupied:
+                    return False
+    return True
+
+
+def _central(shape: tuple[int, int], cell: tuple[int, int], margin: int = 2) -> bool:
+    h, w = shape
+    r, c = cell
+    return margin <= r < h - margin and margin <= c < w - margin
+
+
+def _seed_candidates(
+    shape: tuple[int, int],
+    active_corners: list[str],
+) -> dict[str, list[dict[str, object]]]:
+    ray_sets = {name: set(_ray_cells(shape, name)) for name in active_corners}
+    candidates: dict[str, list[dict[str, object]]] = {}
+    for name in active_corners:
+        other_rays = set().union(*(ray_sets[o] for o in active_corners if o != name))
+        own_ray = _ray_cells(shape, name)
+        options = []
+        for idx in range(3, len(own_ray) - 1):
+            obstacle = own_ray[idx]
+            anchor = own_ray[idx - 1]
+            stamp = _stamp_cells(name, anchor)
+            if obstacle in other_rays or not _central(shape, obstacle):
+                continue
+            if not all(_in_bounds(shape, r, c) for r, c in stamp):
+                continue
+            options.append(
+                {
+                    "obstacle": obstacle,
+                    "anchor": anchor,
+                    "stamp": tuple(stamp),
+                    "distance": idx + 1,
+                }
+            )
+        random.shuffle(options)
+        candidates[name] = options
+    return candidates
+
+
+def _choose_seed_plan(
+    shape: tuple[int, int],
+    active_corners: list[str],
+) -> dict[str, dict[str, object]] | None:
+    candidates = _seed_candidates(shape, active_corners)
+    if any(not candidates[name] for name in active_corners):
+        return None
+
+    ordered = sorted(active_corners, key=lambda name: len(candidates[name]))
+    chosen: dict[str, dict[str, object]] = {}
+    used_stamps: set[tuple[int, int]] = set()
+    used_seeds: set[tuple[int, int]] = set()
+
+    def search(i: int) -> bool:
+        if i == len(ordered):
+            distances = {int(chosen[name]["distance"]) for name in ordered}
+            return len(distances) >= 2
+
+        name = ordered[i]
+        for cand in candidates[name]:
+            seed = cand["obstacle"]
+            stamp = set(cand["stamp"])
+            if seed in used_stamps or stamp & used_stamps:
+                continue
+            if not _far_from_set(stamp, used_stamps, margin=0):
+                continue
+            if not _far_from_set([seed], used_seeds, margin=1):
+                continue
+            chosen[name] = cand
+            used_stamps.update(stamp)
+            used_seeds.add(seed)
+            if search(i + 1):
+                return True
+            del chosen[name]
+            used_seeds.remove(seed)
+            used_stamps.difference_update(stamp)
+        return False
+
+    if not search(0):
+        return None
+    return chosen
+
+
+def _forbidden_ray_cells(shape: tuple[int, int], active_corners: list[str]) -> set[tuple[int, int]]:
+    forbidden = set()
+    for name in active_corners:
+        forbidden.update(_ray_cells(shape, name))
+    return forbidden
+
+
+def _grow_component(
+    shape: tuple[int, int],
+    seed: tuple[int, int],
+    target_size: int,
+    blocked: set[tuple[int, int]],
+    all_obstacles: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    comp = [seed]
+    comp_set = {seed}
+    while len(comp) < target_size:
+        frontier = []
+        for r, c in comp:
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if not _in_bounds(shape, nr, nc):
+                    continue
+                if (nr, nc) in blocked or (nr, nc) in all_obstacles or (nr, nc) in comp_set:
+                    continue
+                conflict = False
+                for rr in range(nr - 1, nr + 2):
+                    for cc in range(nc - 1, nc + 2):
+                        if (rr, cc) in all_obstacles and (rr, cc) not in comp_set:
+                            conflict = True
+                            break
+                    if conflict:
+                        break
+                if not conflict:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        cell = random.choice(frontier)
+        comp.append(cell)
+        comp_set.add(cell)
+    return comp
+
+
+def _place_distractor_components(
+    shape: tuple[int, int],
+    count: int,
+    blocked: set[tuple[int, int]],
+    all_obstacles: set[tuple[int, int]],
+) -> list[list[tuple[int, int]]] | None:
+    h, w = shape
+    comps = []
+    attempts = 0
