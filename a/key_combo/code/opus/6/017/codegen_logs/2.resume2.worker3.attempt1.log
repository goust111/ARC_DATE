+    "tl": {
+        "direction": (1, 1),
+        "shape": ((0, 0), (0, 1), (1, 0), (1, 1)),
+        "anchor_rel": (1, 1),
+    },
+    "tr": {
+        "direction": (1, -1),
+        "shape": ((0, 0), (1, 0), (2, 0)),
+        "anchor_rel": (2, 0),
+    },
+    "bl": {
+        "direction": (-1, 1),
+        "shape": ((0, 0), (0, 1), (0, 2)),
+        "anchor_rel": (0, 2),
+    },
+    "br": {
+        "direction": (-1, -1),
+        "shape": ((0, 0), (1, 0), (1, 1)),
+        "anchor_rel": (0, 0),
+    },
+}
+GEN_HEIGHT_RANGE = (11, 15)
+GEN_WIDTH_RANGE = (11, 15)
+GEN_BLOCKER_COUNT_RANGE = (3, 5)
+GEN_RETRY_LIMIT = 500
