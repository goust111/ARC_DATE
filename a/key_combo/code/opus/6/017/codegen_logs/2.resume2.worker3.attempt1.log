+
+def _fixed_offset_output(grid: np.ndarray) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for name, color in _active_markers(out):
+        r0, c0 = _corner_position(out.shape, name)
+        dr, dc = CORNER_SPECS[name]["direction"]
+        out[r0, c0] = BG
+        anchor = (r0 + 3 * dr, c0 + 3 * dc)
+        for r, c in _stamp_cells(name, anchor):
+            if _in_bounds(out.shape, r, c):
+                out[r, c] = color
+    return out
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Replace corner markers by corner-specific colored stamps whose anchor is found by a diagonal wall-seeking ray.
+
+    Input structure:
+    - The grid has black background, 3-5 blue obstacle components in the interior, and 2-3 distinct colored corner markers.
+    - Each active marker sits exactly on a grid corner and uses one of the colors {2,3,4,6}.
+    - Each active corner has at least one blue obstacle somewhere on its 45-degree diagonal ray toward the center.
+
+    Rule:
+    - Read each non-black corner marker to determine both its template and its ray direction.
+    - Cast a diagonal ray from that corner toward the center and stop at the first blue obstacle pixel; the anchor is the previous ray cell.
+    - Stamp the corner's template in the marker color using the corner-specific anchor alignment, erase the original corner marker, and leave blue obstacles unchanged.
+    - Apply multiple stamps in corner reading order from top-left to bottom-right, so later stamps overwrite earlier ones if they overlap.
+
+    Key insight:
+    The corner position simultaneously chooses the template shape and the ray direction, while the blue obstacle layout chooses the final placement cell where that template is stamped.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    out = g.copy()
+    active = _active_markers(g)
+    for name, color in active:
+        r0, c0 = _corner_position(g.shape, name)
+        out[r0, c0] = BG
+        anchor = _trace_anchor(g, name)
+        for r, c in _stamp_cells(name, anchor):
+            assert _in_bounds(g.shape, r, c), "stamp must stay in bounds"
+            assert int(g[r, c]) != WALL, "stamp must not cover blue obstacles"
+            out[r, c] = color
+    return out
+
+
+def _far_from_set(
+    cells: list[tuple[int, int]] | set[tuple[int, int]],
+    occupied: set[tuple[int, int]],
+    margin: int = 1,
+) -> bool:
+    for r, c in cells:
+        for rr in range(r - margin, r + margin + 1):
+            for cc in range(c - margin, c + margin + 1):
+                if (rr, cc) in occupied:
+                    return False
+    return True
+
+
+def _central(shape: tuple[int, int], cell: tuple[int, int], margin: int = 2) -> bool:
+    h, w = shape
+    r, c = cell
+    return margin <= r < h - margin and margin <= c < w - margin
+
+
+def _seed_candidates(
+    shape: tuple[int, int],
+    active_corners: list[str],
+) -> dict[str, list[dict[str, object]]]:
+    ray_sets = {name: set(_ray_cells(shape, name)) for name in active_corners}
+    candidates: dict[str, list[dict[str, object]]] = {}
+    for name in active_corners:
+        other_rays = set().union(*(ray_sets[o] for o in active_corners if o != name))
+        own_ray = _ray_cells(shape, name)
+        options = []
+        for idx in range(3, len(own_ray) - 1):
+            obstacle = own_ray[idx]
+            anchor = own_ray[idx - 1]
+            stamp = _stamp_cells(name, anchor)
+            if obstacle in other_rays or not _central(shape, obstacle):
+                continue
+            if not all(_in_bounds(shape, r, c) for r, c in stamp):
+                continue
+            options.append(
+                {
+                    "obstacle": obstacle,
+                    "anchor": anchor,
+                    "stamp": tuple(stamp),
+                    "distance": idx + 1,
+                }
+            )
+        random.shuffle(options)
+        candidates[name] = options
+    return candidates
+
+
+def _choose_seed_plan(
+    shape: tuple[int, int],
+    active_corners: list[str],
+) -> dict[str, dict[str, object]] | None:
+    candidates = _seed_candidates(shape, active_corners)
+    if any(not candidates[name] for name in active_corners):
+        return None
+
+    ordered = sorted(active_corners, key=lambda name: len(candidates[name]))
+    chosen: dict[str, dict[str, object]] = {}
+    used_stamps: set[tuple[int, int]] = set()
+    used_seeds: set[tuple[int, int]] = set()
+
+    def search(i: int) -> bool:
+        if i == len(ordered):
+            distances = {int(chosen[name]["distance"]) for name in ordered}
+            return len(distances) >= 2
+
+        name = ordered[i]
+        for cand in candidates[name]:
+            seed = cand["obstacle"]
+            stamp = set(cand["stamp"])
+            if seed in used_stamps or stamp & used_stamps:
+                continue
+            if not _far_from_set(stamp, used_stamps, margin=0):
+                continue
+            if not _far_from_set([seed], used_seeds, margin=1):
+                continue
+            chosen[name] = cand
+            used_stamps.update(stamp)
+            used_seeds.add(seed)
+            if search(i + 1):
+                return True
+            del chosen[name]
+            used_seeds.remove(seed)
+            used_stamps.difference_update(stamp)
+        return False
+
+    if not search(0):
+        return None
+    return chosen
+
+
+def _forbidden_ray_cells(shape: tuple[int, int], active_corners: list[str]) -> set[tuple[int, int]]:
+    forbidden = set()
+    for name in active_corners:
+        forbidden.update(_ray_cells(shape, name))
+    return forbidden
+
+
+def _grow_component(
+    shape: tuple[int, int],
+    seed: tuple[int, int],
+    target_size: int,
+    blocked: set[tuple[int, int]],
+    all_obstacles: set[tuple[int, int]],
+) -> list[tuple[int, int]] | None:
+    comp = [seed]
+    comp_set = {seed}
+    while len(comp) < target_size:
+        frontier = []
+        for r, c in comp:
+            for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+                if not _in_bounds(shape, nr, nc):
+                    continue
+                if (nr, nc) in blocked or (nr, nc) in all_obstacles or (nr, nc) in comp_set:
+                    continue
+                conflict = False
+                for rr in range(nr - 1, nr + 2):
+                    for cc in range(nc - 1, nc + 2):
+                        if (rr, cc) in all_obstacles and (rr, cc) not in comp_set:
+                            conflict = True
+                            break
+                    if conflict:
+                        break
+                if not conflict:
+                    frontier.append((nr, nc))
+        if not frontier:
+            return None
+        cell = random.choice(frontier)
+        comp.append(cell)
+        comp_set.add(cell)
+    return comp
+
+
+def _place_distractor_components(
+    shape: tuple[int, int],
+    count: int,
+    blocked: set[tuple[int, int]],
+    all_obstacles: set[tuple[int, int]],
+) -> list[list[tuple[int, int]]] | None:
+    h, w = shape
+    comps = []
+    attempts = 0
+    while len(comps) < count and attempts < 300:
+        attempts += 1
+        seed = (random.randint(2, h - 3), random.randint(2, w - 3))
+        if seed in blocked or seed in all_obstacles:
+            continue
+        ok = True
+        for rr in range(seed[0] - 1, seed[0] + 2):
+            for cc in range(seed[1] - 1, seed[1] + 2):
+                if (rr, cc) in all_obstacles:
+                    ok = False
+                    break
+            if not ok:
+                break
+        if not ok:
+            continue
+        size = random.randint(1, 3)
+        comp = _grow_component(shape, seed, size, blocked, all_obstacles)
+        if comp is None:
+            continue
+        comps.append(comp)
+        all_obstacles.update(comp)
+    return comps if len(comps) == count else None
+
+
+def _validate_instance(
+    grid: np.ndarray,
+    active_info: dict[str, dict[str, object]],
+    distractor_count: int,
+) -> bool:
+    try:
+        out = main(grid)
+    except Exception:
+        return False
+
+    if np.array_equal(out, grid):
+        return False
+
+    active = _active_markers(grid)
+    if len(active) != len(active_info):
+        return False
+
+    wall_comps = _components_of_color(grid, WALL)
+    if not (GEN_BLOCKER_COUNT_RANGE[0] <= len(wall_comps) <= GEN_BLOCKER_COUNT_RANGE[1]):
+        return False
+    if any(not (1 <= len(comp) <= 3) for comp in wall_comps):
+        return False
+
+    ray_hit_cells = set()
+    for name, color in active:
+        anchor = _trace_anchor(grid, name)
+        spec = active_info[name]
+        if anchor != spec["anchor"]:
+            return False
+        seed = tuple(spec["obstacle"])
+        dr, dc = CORNER_SPECS[name]["direction"]
+        if seed != (anchor[0] + dr, anchor[1] + dc):
+            return False
+        ray_hit_cells.add(seed)
+        for r, c in spec["stamp"]:
+            if int(out[r, c]) != color:
+                return False
+
+    if len(wall_comps) - len(active_info) != distractor_count:
+        return False
+
+    if np.array_equal(_fixed_offset_output(grid), out):
+        return False
+
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GEN_HEIGHT_RANGE)
+    w = random.randint(*GEN_WIDTH_RANGE)
+    if h == w:
+        w = w + 1 if w < GEN_WIDTH_RANGE[1] else w - 1
+    shape = (h, w)
+
+    active_count = random.choice((2, 3))
+    active_corners = random.sample(list(CORNER_ORDER), active_count)
+    seed_plan = _choose_seed_plan(shape, active_corners)
+    if seed_plan is None:
+        return None
+
+    colors = random.sample(MARKER_COLORS, active_count)
+    color_by_corner = dict(zip(active_corners, colors))
+
+    stamp_cells = set()
+    for info in seed_plan.values():
+        stamp_cells.update(info["stamp"])
+
+    forbidden = _forbidden_ray_cells(shape, active_corners)
+    blocked = set(stamp_cells) | set(_corner_position(shape, name) for name in CORNER_ORDER) | forbidden
+
+    all_obstacles: set[tuple[int, int]] = set()
+    components = []
+    for name in active_corners:
+        seed = tuple(seed_plan[name]["obstacle"])
+        target_size = random.randint(1, 3)
+        comp = _grow_component(shape, seed, target_size, blocked - {seed}, all_obstacles)
+        if comp is None:
+            return None
+        components.append(comp)
+        all_obstacles.update(comp)
+
+    blocker_count = random.randint(max(GEN_BLOCKER_COUNT_RANGE[0], active_count + 1), GEN_BLOCKER_COUNT_RANGE[1])
+    distractor_count = blocker_count - active_count
+    extra = _place_distractor_components(shape, distractor_count, blocked, all_obstacles)
+    if extra is None:
+        return None
+    components.extend(extra)
+
+    grid = np.zeros(shape, dtype=int)
+    for comp in components:
+        for r, c in comp:
+            grid[r, c] = WALL
+    for name, color in color_by_corner.items():
+        r, c = _corner_position(shape, name)
+        grid[r, c] = color
+
+    if not _validate_instance(grid, seed_plan, distractor_count):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRY_LIMIT):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input for puzzle 2")

