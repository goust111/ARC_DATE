def check(rows):
    mask=[[c=='#' for c in row] for row in rows]
    pts=[(r,c) for r in range(H) for c in range(W) if mask[r][c]]
    # conn
    q=deque([pts[0]]); seen={pts[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[rr][cc] and (rr,cc) not in seen:
