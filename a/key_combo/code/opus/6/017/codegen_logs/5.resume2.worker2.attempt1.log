    bbox=(min(rs),min(cs),max(rs),max(cs))
    # holes
    seen=set(); holes=0
    for r in range(H):
      for c in range(W):
        if mask[r][c] or (r,c) in seen: continue
        q=deque([(r,c)]); seen.add((r,c)); touch=False
        while q:
