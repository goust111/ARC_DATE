          for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            xx,yy=x+dr,y+dc
            if 0<=xx<H and 0<=yy<W and not mask[xx][yy] and (xx,yy) not in seen:
              seen.add((xx,yy)); q.append((xx,yy))
        if not touch: holes+=1
    return conn,bbox,holes,sum(sum(r) for r in mask)

for name,rows in patterns.items():
    print(name, check(rows))
    print('\\n'.join(rows), '\\n')
