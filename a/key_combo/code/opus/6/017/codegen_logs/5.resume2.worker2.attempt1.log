import random
from collections import defaultdict, deque

H=W=5
cells=[(r,c) for r in range(H) for c in range(W)]

def conn(mask):
    pts=[p for p,v in mask.items() if v]
    if not pts: return False
    q=deque([pts[0]])
    seen={pts[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            rr,cc=r+dr,c+dc
            if 0<=rr<H and 0<=cc<W and mask[(rr,cc)] and (rr,cc) not in seen:
                seen.add((rr,cc)); q.append((rr,cc))
    return len(seen)==len(pts)

def bbox_exact(mask):
    pts=[p for p,v in mask.items() if v]
    rs=[r for r,c in pts]; cs=[c for r,c in pts]
    return min(rs)==0 and max(rs)==H-1 and min(cs)==0 and max(cs)==W-1

def holes(mask):
    seen=set(); h=0
    for r in range(H):
        for c in range(W):
            if mask[(r,c)] or (r,c) in seen: continue
            q=deque([(r,c)]); seen.add((r,c)); touch=False
            while q:
                x,y=q.popleft()
                if x in (0,H-1) or y in (0,W-1): touch=True
                for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                    xx,yy=x+dr,y+dc
                    if 0<=xx<H and 0<=yy<W and not mask[(xx,yy)] and (xx,yy) not in seen:
                        seen.add((xx,yy)); q.append((xx,yy))
            if not touch: h+=1
    return h

def show(mask):
    return [''.join('#' if mask[(r,c)] else '.' for c in range(W)) for r in range(H)]

found=defaultdict(list)
for _ in range(200000):
    # random walk connected mask with area 10..20 and required edge touches
    area=random.randint(10,20)
    start=random.choice(cells)
    pts={start}
    frontier=[start]
    while len(pts)<area:
        r,c=random.choice(list(pts))
        nbrs=[(r+dr,c+dc) for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)] if 0<=r+dr<H and 0<=c+dc<W and (r+dr,c+dc) not in pts]
        if not nbrs:
            if len(pts)==25: break
            continue
        pts.add(random.choice(nbrs))
    mask={p:(p in pts) for p in cells}
    if not bbox_exact(mask): continue
    if not conn(mask): continue
    h=holes(mask)
    if h>5: continue
    s=tuple(show(mask))
    if s not in found[h]:
        found[h].append(s)

for h in sorted(found):
    print('holes',h,'count',len(found[h]))
    for s in found[h][:8]:
        print('\\n'.join(s)); print()
