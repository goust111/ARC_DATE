+def _validate_example(grid: np.ndarray, objects: list[dict], mapping: dict[int, int]) -> bool:
+    expected = _reconstruct(objects, mapping, align="top_left", recolor=True)
+    try:
+        solved = main(grid)
+    except AssertionError:
