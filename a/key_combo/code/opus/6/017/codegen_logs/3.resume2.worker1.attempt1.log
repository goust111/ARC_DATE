    h, w = mask.shape
    choices = []
    for r in range(h):
        for c in range(w):
            if mask[r, c]:
                continue
            touches = sum(
                0 <= r + dr < h and 0 <= c + dc < w and mask[r + dr, c + dc]
                for dr, dc in GEN_NEIGHBORS_4
