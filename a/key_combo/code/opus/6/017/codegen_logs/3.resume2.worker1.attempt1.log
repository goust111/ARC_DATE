+    chain = [{"kind": leaf_kind, "height": leaf_h, "width": leaf_w}]
+    cur_h, cur_w = leaf_h, leaf_w
+    for _ in range(count - 1):
+        cur_h += random.randint(4, 6)
+        cur_w += random.randint(4, 6)
+        chain.append({"kind": "frame", "height": cur_h, "width": cur_w})
