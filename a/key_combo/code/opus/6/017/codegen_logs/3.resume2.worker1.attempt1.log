+def _render_patch(kind: str, height: int, width: int, color: int) -> np.ndarray:
+    patch = np.zeros((int(height), int(width)), dtype=int)
+    if kind == "solid":
+        patch[:, :] = int(color)
+        return patch
+    if kind != "frame":
+        raise ValueError(f"unknown rectangle kind: {kind}")
+    patch[0, :] = int(color)
+    patch[-1, :] = int(color)
+    patch[:, 0] = int(color)
+    patch[:, -1] = int(color)
+    return patch
+
