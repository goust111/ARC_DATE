+    root = roots[0]
+    cur = root
+    depth = 0
+    seen: set[int] = set()
+    while cur is not None:
+        assert cur not in seen, "containment chain must be acyclic"
+        seen.add(cur)
+        depths[cur] = depth
+        next_children = children[cur]
+        cur = next_children[0] if next_children else None
+        depth += 1
