+
+
+def _place_bars(
+    h: int,
+    w: int,
+    specs: list[dict],
+    anchors: list[dict],
+    fixed_dilated: np.ndarray,
+    rng: np.random.Generator,
+) -> list[dict] | None:
+    candidates = []
+    for spec in specs:
+        cand = _candidate_positions(h, w, spec, spec["target"], anchors, fixed_dilated, rng)
+        if not cand:
