+    return (2 * int(anchor_c0) + 2 - int(width)) // 2
+
+
+def _bar_shape_cells(width: int, protrusions: tuple[int, ...]) -> list[tuple[int, int]]:
+    cells = [(1, dc) for dc in range(width)]
+    cells.extend((0, dc) for dc in protrusions)
