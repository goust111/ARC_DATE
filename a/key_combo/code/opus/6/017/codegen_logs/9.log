+                "top": pos["top"],
+                "left": pos["left"],
+                "width": spec["width"],
+                "protrusions": spec["protrusions"],
+                "target": spec["target"],
+                "mode": spec["mode"],
+                "role": spec["role"],
+            }
+        )
