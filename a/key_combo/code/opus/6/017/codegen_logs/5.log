0027:     def is_border(r: int, c: int) -> bool:
0028:         return int(r) in (0, int(H - 1)) or int(c) in (0, int(W - 1))
0029: 
0030:     # --- STEP 1) Detect anchors: isolated border pixels (non-bg) ---
0031:     anchors_by_color: dict[int, tuple[int, int]] = {}
0032:     for r in range(H):
0033:         for c in range(W):
0034:             if not is_border(r, c):
0035:                 continue
0036:             v = int(g[r, c])
0037:             if v == int(bg):
0038:                 continue
0039:             ok = True
0040:             for rr, cc in neighbors4(int(r), int(c)):
0041:                 if 0 <= rr < H and 0 <= cc < W and int(g[rr, cc]) != int(bg):
0042:                     ok = False
0043:                     break
0044:             if ok and v not in anchors_by_color:
0045:                 anchors_by_color[int(v)] = (int(r), int(c))
0046: 
0047:     assert not (not anchors_by_color)
0048: 
0049:     anchor_cells = {(int(r), int(c)) for (r, c) in anchors_by_color.values()}
0050: 
0051:     # --- STEP 2) Extract all foreground connected components as candidate sprites. ---
0052:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
0053: 
0054:     def component_marker_color(coords: np.ndarray) -> int | None:
0055:         # For multi-color sprites, the marker color is the least frequent color inside the component.
0056:         vals = [int(g[int(r), int(c)]) for r, c in coords]
0057:         cnt = Counter(vals)
0058:         if len(cnt) <= 1:
0059:             return None
0060:         return int(min(cnt.items(), key=lambda kv: (int(kv[1]), int(kv[0])))[0])
0061: 
0062:     def marker_pixel(coords: np.ndarray, marker: int) -> tuple[int, int] | None:
0063:         # If marker appears multiple times, prefer one attached to the main body (4-adjacent to non-marker).
0064:         pts = [(int(r), int(c)) for r, c in coords if int(g[int(r), int(c)]) == int(marker)]
0065:         if not pts:
0066:             return None
0067:         if len(pts) == 1:
0068:             return pts[0]
0069:         S = {(int(r), int(c)) for r, c in coords}
0070:         for r, c in pts:
0071:             for rr, cc in neighbors4(int(r), int(c)):
0072:                 if (int(rr), int(cc)) in S and int(g[int(rr), int(cc)]) != int(marker):
0073:                     return (int(r), int(c))
0074:         return pts[0]
0075: 
0076:     moves: list[tuple[np.ndarray, int, int]] = []
0077: 
0078:     for comp in comps:
0079:         coords = comp["coords"]
0080:         if coords.size == 0:
0081:             continue
0082: 
0083:         # --- STEP 3) Decide marker color for this component. ---
0084:         marker_col = component_marker_color(coords)
0085:         if marker_col is None:
0086:             # Single-color component: move only if it's a singleton of an anchor color, not the anchor itself.
0087:             if int(coords.shape[0]) != 1:
0088:                 continue
0089:             r, c = map(int, coords[0])
0090:             v = int(g[r, c])
0091:             if v == int(bg) or v not in anchors_by_color or (r, c) in anchor_cells:
0092:                 continue
0093:             marker_col = int(v)
0094: 
0095:         if int(marker_col) not in anchors_by_color:
0096:             continue
0097: 
0098:         mp = marker_pixel(coords, int(marker_col))
0099:         if mp is None:
0100:             continue
0101: 
0102:         ar, ac = anchors_by_color[int(marker_col)]
0103: 
0104:         # --- STEP 4) Compute translation (dr,dc). ---
0105:         on_top_bottom = int(ar) in (0, int(H - 1))
0106:         on_left_right = int(ac) in (0, int(W - 1))
0107:         horizontal = bool(on_top_bottom and not on_left_right)  # top/bottom but not a corner
0108: 
0109:         dr = 0
0110:         dc = 0
0111:         if horizontal:
0112:             dc = int(ac - mp[1])
0113:         else:
0114:             dr = int(ar - mp[0])
0115: 
0116:         moves.append((coords, int(dr), int(dc)))
0117: 
0118:     out = g.copy()
0119: 
0120:     # --- STEP 5) Apply all moves. ---
0121:     # Clear moved components first (prevents collisions with their original locations).
0122:     for coords, _dr, _dc in moves:
0123:         out[coords[:, 0], coords[:, 1]] = int(bg)
0124: 
0125:     # Paste moved components:
0126:     # - clip out-of-bounds pixels
0127:     # - do not overwrite existing non-bg pixels
0128:     for coords, dr, dc in moves:
0129:         for r, c in coords:
0130:             rr = int(r) + int(dr)
0131:             cc = int(c) + int(dc)
0132:             if 0 <= rr < H and 0 <= cc < W and int(out[rr, cc]) == int(bg):
0133:                 out[rr, cc] = int(g[int(r), int(c)])
0134: 
0135:     return out
0136: 
