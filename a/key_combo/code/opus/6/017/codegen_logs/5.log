    has_neighbor[:, 2] |= mask[1:4, 4]   # col right of interior
    candidates = has_neighbor & ~interior
    rs, cs = np.where(candidates)
    return [(int(r) + 1, int(c) + 1) for r, c in zip(rs, cs)]


