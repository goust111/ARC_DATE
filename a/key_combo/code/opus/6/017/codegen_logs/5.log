_OTHER = {"h": "v", "v": "h"}
# Edge-pair keys: (leading edge of predecessor, trailing edge of successor)
_EDGE_PAIRS = {"h": ("right", "left"), "v": ("bot", "top")}
# _make_block keyword mapping per orientation:
#   orient -> (leading_kw, trailing_kw)
