0031: def main(grid: np.ndarray) -> np.ndarray:
0032:     """
0033:     Sort objects to top or bottom edge by whether their shape (up to rotation/flip) is shared.
0034: 
0035:     Input structure:
0036:     - bg = most common color.
0037:     - Several multicolor connected components (8-connected) scattered across the grid.
0038: 
0039:     Rule:
0040:     - Compute each object's canonical shape (binary mask, invariant to rotation and flip).
0041:     - Objects whose shape appears in two or more components → translate to TOP edge (row 0).
0042:     - Objects whose shape is unique → translate to BOTTOM edge (row H−h).
0043:     - Horizontal position (left column) is preserved; only vertical translation changes.
0044: 
0045:     Key insight: The sorting criterion is shape frequency (rotation-invariant), not area — duplicated shapes go up, unique shapes go down.
0046:     """
0047:     g = np.array(grid, dtype=int)
0048:     H, W = g.shape
0049:     bg = int(get_bg(g))
0050: 
0051:     comps = find_components(g, bg=bg, connectivity=8, monochromatic=False, return_format="dict")
0052:     assert not (not comps)
0053: 
0054:     extracted = []
0055:     for comp in comps:
0056:         r0, c0, r1, c1 = map(int, comp["bbox"])
0057:         patch = crop_bbox(g, (r0, c0, r1, c1))
0058: 
0059:         # Isolate this component exactly (bbox rectangle may include background).
0060:         rel_coords = [(int(r) - r0, int(c) - c0) for r, c in comp["coords"]]
0061:         m = mask_from_coords(rel_coords, patch.shape)
0062:         pat = np.full_like(patch, bg)
0063:         pat[m] = patch[m]
0064: 
0065:         extracted.append(
0066:             {
0067:                 "c0": int(c0),
0068:                 "pat": pat,
0069:                 "shape_key": canonical_shape_key(m),
0070:             }
0071:         )
0072: 
0073:     freq = Counter(d["shape_key"] for d in extracted)
0074:     out = np.full((H, W), int(bg), dtype=int)
0075: 
0076:     for d in extracted:
0077:         pat = d["pat"]
0078:         h, w = map(int, pat.shape)
0079:         dest_r0 = 0 if int(freq[d["shape_key"]]) >= 2 else int(H - h)
0080:         dest_c0 = int(d["c0"])
0081:         paste(out, pat, dest_r0, dest_c0, transparent=int(bg))
0082: 
0083:     return out
0084: 
0085: # --------------- generator (att2) ---------------
0086: 
0087: _RNG = np.random.default_rng()
0088: 
0089: # ── CFG: canvas ──────────────────────────────────────────────────────
0090: GRID_H_RANGE = (19, 31)          # H uniform in [19, 30]
0091: GRID_W_RANGE = (19, 31)          # W uniform in [19, 30]
0092: NUM_COLORS = 10                   # palette 0-9
0093: 
0094: # ── CFG: component shapes ───────────────────────────────────────────
0095: BBOX_MAX = 5                      # max h or w of a component bbox
0096: AREA_RANGE = (3, 13)              # component area in [3, 12]
0097: MIN_FILL_RATIO_X10 = 4            # area * 10 >= 4 * h * w
0098: IRREGULAR_PROB = 0.85             # prefer non-rectangular bboxes
0099: 
0100: # ── CFG: layout ─────────────────────────────────────────────────────
0101: DUP_LAYOUTS = [(2,), (3,), (2, 2)]  # possible duplicate-group structures
0102: MIN_COL_GAP = 1                   # minimum column gap between components
0103: MIN_VERTICAL_GAP = 5              # min gap between top-group bottom and bottom-group top
0104: 
0105: # ── CFG: generation ─────────────────────────────────────────────────
0106: MAX_RETRIES = 300                 # outer generate_input retry budget
0107: 
0108: _NEIGHBORS8 = [(-1, -1), (-1, 0), (-1, 1), (0, -1),
0109:                (0, 1), (1, -1), (1, 0), (1, 1)]
0110: 
0111: 
0112: def _feasible_dims(area: int) -> list[tuple[int, int]]:
0113:     """Return all (h, w) bboxes where area fits with fill_ratio >= MIN_FILL_RATIO_X10/10."""
0114:     dims = []
0115:     for h in range(1, BBOX_MAX + 1):
0116:         for w in range(1, BBOX_MAX + 1):
0117:             if area > h * w:
0118:                 continue
0119:             if area * 10 < MIN_FILL_RATIO_X10 * h * w:
0120:                 continue
0121:             if h == 1 and area != w:
0122:                 continue
0123:             if w == 1 and area != h:
0124:                 continue
0125:             if h > 1 and w > 1 and area < max(h, w):
0126:                 continue
0127:             dims.append((h, w))
0128:     return dims
0129: 
0130: 
0131: def _line_mask(h: int, w: int) -> np.ndarray:
0132:     """Create a seed mask along a diagonal line spanning the bbox, randomly flipped."""
0133:     mask = np.zeros((h, w), dtype=bool)
0134:     if h == 1:
0135:         mask[0, :] = True
0136:         return mask
0137:     if w == 1:
0138:         mask[:, 0] = True
0139:         return mask
0140:     steps = max(h, w)
0141:     for i in range(steps):
0142:         r = int(round(i * (h - 1) / (steps - 1)))
0143:         c = int(round(i * (w - 1) / (steps - 1)))
0144:         mask[r, c] = True
0145:     if bool(_RNG.integers(0, 2)):
0146:         mask = np.flipud(mask)
0147:     if bool(_RNG.integers(0, 2)):
0148:         mask = np.fliplr(mask)
0149:     return mask
0150: 
0151: 
0152: def _make_mask(h: int, w: int, area: int) -> np.ndarray:
0153:     """Grow an 8-connected mask from a line seed to the target area."""
0154:     mask = _line_mask(h, w)
0155:     while int(mask.sum()) < area:
0156:         frontier = set()
0157:         for r, c in np.argwhere(mask):
0158:             for dr, dc in _NEIGHBORS8:
0159:                 nr, nc = int(r) + dr, int(c) + dc
0160:                 if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
0161:                     frontier.add((nr, nc))
0162:         pick = list(frontier)
0163:         nr, nc = pick[int(_RNG.integers(0, len(pick)))]
0164:         mask[nr, nc] = True
0165:     return mask
0166: 
0167: 
0168: def _mask_to_pat(mask: np.ndarray, color: int, bg: int) -> np.ndarray:
0169:     """Paint a boolean mask into a colored patch on a bg-filled array."""
0170:     pat = np.full(mask.shape, bg, dtype=int)
0171:     pat[mask] = color
0172:     return pat
0173: 
0174: 
0175: def _make_component(area: int, color: int, bg: int) -> dict:
0176:     """Generate a random 8-connected component with the given area and color."""
0177:     dims = _feasible_dims(area)
0178:     irregular_dims = [d for d in dims if d[0] * d[1] > area]
0179:     if irregular_dims and _RNG.random() < IRREGULAR_PROB:
0180:         dims = irregular_dims
0181:     h, w = dims[int(_RNG.integers(0, len(dims)))]
0182:     mask = _make_mask(h, w, area)
0183:     return {"area": area, "color": color, "h": h, "w": w,
0184:             "mask": mask, "pat": _mask_to_pat(mask, color, bg),
0185:             "shape_key": canonical_shape_key(mask)}
0186: 
0187: 
0188: def _random_transform(mask: np.ndarray) -> np.ndarray:
0189:     """Apply a random rotation (0-3) and optional horizontal flip to a mask."""
0190:     mask = np.rot90(mask, int(_RNG.integers(0, 4)))
