0055: def main(grid: np.ndarray) -> np.ndarray:
0056:     """
0057:     Move each marked cross object away from its marker to the grid edge while rotating the colored cross 180 degrees.
0058: 
0059:     Input structure:
0060:     - The background is the dominant color.
0061:     - Each 8-connected foreground object has nine pixels: a 4-pixel marker-color
0062:       sprite attached to a 5-pixel non-marker colored cross.
0063:     - Each object bbox is either 3x6 or 6x3, so the marker sprite is on exactly
0064:       one side of the cross.
0065: 
0066:     Rule:
0067:     - Move the whole object straight away from its marker side until the object
0068:       bbox touches the corresponding grid edge.
0069:     - Keep the marker sprite unchanged within the object.
0070:     - Rotate the 3x3 colored cross block by 180 degrees before placing it.
0071: 
0072:     Key insight:
0073:     The marker sprite is a directional tail; the cross is the leading payload,
0074:     and only that payload turns around during the slide to the edge.
0075:     """
0076:     g = np.asarray(grid, dtype=int)
0077:     H, W = g.shape
0078:     bg = get_bg(g)
0079:     marker = _marker_color(g, bg)
0080: 
0081:     out = np.full_like(g, int(bg))
0082:     objects = find_components(g, bg=bg, connectivity=8, monochromatic=False)
0083:     assert objects, "expected at least one composite object"
0084: 
0085:     for obj in objects:
0086:         assert int(obj["area"]) == 9, "each composite should contain 9 foreground pixels"
0087:         r0, c0, _r1, _c1 = obj["bbox"]
0088:         patch = crop_bbox(g, obj["bbox"])
0089:         h, w = patch.shape
0090:         moved = patch.copy()
0091: 
0092:         if (h, w) == (3, 6):
0093:             left = patch[:, :3]
0094:             right = patch[:, 3:]
0095:             left_kind = _block_kind(left, bg, marker)
0096:             right_kind = _block_kind(right, bg, marker)
0097:             assert {left_kind, right_kind} == {"marker", "cross"}, "expected one marker and one cross"
0098: 
0099:             if left_kind == "marker":
0100:                 moved[:, 3:] = np.rot90(right, 2)
0101:                 target_r, target_c = int(r0), W - w
0102:             else:
0103:                 moved[:, :3] = np.rot90(left, 2)
0104:                 target_r, target_c = int(r0), 0
0105: 
0106:         elif (h, w) == (6, 3):
0107:             top = patch[:3, :]
0108:             bottom = patch[3:, :]
0109:             top_kind = _block_kind(top, bg, marker)
0110:             bottom_kind = _block_kind(bottom, bg, marker)
0111:             assert {top_kind, bottom_kind} == {"marker", "cross"}, "expected one marker and one cross"
0112: 
0113:             if top_kind == "marker":
0114:                 moved[3:, :] = np.rot90(bottom, 2)
0115:                 target_r, target_c = H - h, int(c0)
0116:             else:
0117:                 moved[:3, :] = np.rot90(top, 2)
0118:                 target_r, target_c = 0, int(c0)
0119: 
0120:         else:
0121:             raise AssertionError("each composite bbox should be 3x6 or 6x3")
0122: 
0123:         _paste_checked(out, moved, target_r, target_c, bg)
0124: 
0125:     return out
