+def _sample_counts() -> tuple[int, ...]:
+    if random.random() < 0.65:
+        weights = [4, 4, 2, 2, 1, 1]
+        return random.choices(COUNT_PATTERNS_4, weights=weights, k=1)[0]
+    return random.choice(COUNT_PATTERNS_5)
