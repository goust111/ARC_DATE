+def _build_lattice(nr: int, nc: int, top: int, left: int, bottom_margin: int, right_margin: int) -> tuple[np.ndarray, list[dict], dict]:
+    lattice_h = 4 * nr + 1
+    lattice_w = 4 * nc + 1
