+
+def _classify_bar(coords: list[tuple[int, int]]) -> tuple[str, frozenset[tuple[int, int]]] | None:
+    if len(coords) != 2:
+        return None
+    (r1, c1), (r2, c2) = sorted(coords)
+    cells = frozenset(coords)
