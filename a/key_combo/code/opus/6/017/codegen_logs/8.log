 152:     min_num, min_den = SPRITE_FG_MIN_RATIO
 153:     max_num, max_den = SPRITE_FG_MAX_RATIO
 154:     fg_min = math.ceil(area * min_num / min_den)
 155:     fg_max = math.floor(area * max_num / max_den)
 156:     if fg_min > fg_max:
 157:         fg_min = fg_max = round(area * min_num / min_den)
 158:     fg_count = random.randint(fg_min, fg_max)
 159:     blank_count = area - fg_count
 160: 
