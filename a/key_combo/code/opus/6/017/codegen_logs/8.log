  90: # --------------- generator (o5x) ---------------
  91: 
  92: # --- CFG: tunable generation parameters ---
  93: _LATTICE = 8                       # lattice / frame color
  94: _EMPTY = 0                        # background / cavity color
  95: _TILE_RANGE = (3, 4)              # rows/cols of tiles (N, M each sampled from this)
  96: _MAX_MARKERS = 9                  # upper bound on marker count per grid
  97: _MAX_DISTINCT_NON_LATTICE = 3     # max distinct non-lattice marker colors
  98: _LATTICE_MARKER_PROB = 0.35       # probability of including lattice-color markers
  99: _NON_LATTICE_COLORS = (1, 2, 3, 4, 5, 6, 7, 9)
 100: _GEN_RETRIES = 300                # max attempts before giving up
 101: 
 102: # Reuse cavity offsets from the solver section (identical to _INTERIOR_OFFSETS).
 103: _CAVITY_OFFSETS = _INTERIOR_OFFSETS
 104: 
 105: 
 106: def _base_lattice(n_tiles: int, m_tiles: int) -> np.ndarray:
 107:     """Build an empty lattice grid: all lattice cells = _LATTICE, corners and cavities = _EMPTY."""
 108:     h, w = 5 * n_tiles + 1, 5 * m_tiles + 1
 109:     grid = np.full((h, w), _LATTICE, dtype=int)
 110:     rs, cs = np.mgrid[:h, :w]
 111:     dr, dc = rs % 5, cs % 5
 112:     corner = (dr == 0) & (dc == 0)
 113:     cavity = np.zeros((h, w), dtype=bool)
 114:     for ro, co in _CAVITY_OFFSETS:
 115:         cavity |= (dr == ro) & (dc == co)
 116:     grid[corner | cavity] = _EMPTY
 117:     return grid
 118: 
 119: 
 120: def _choose_marker_colors(marker_count: int) -> list[int]:
 121:     """Pick and assign marker colors: optionally include lattice color, plus 1-3 non-lattice colors."""
 122:     include_lattice = random.random() < _LATTICE_MARKER_PROB
 123:     if include_lattice:
 124:         non_count = random.randint(0, min(_MAX_DISTINCT_NON_LATTICE, marker_count - 1))
 125:     else:
 126:         non_count = random.randint(1, min(_MAX_DISTINCT_NON_LATTICE, marker_count))
 127: 
 128:     colors = random.sample(_NON_LATTICE_COLORS, non_count)
 129:     if include_lattice:
 130:         colors.append(_LATTICE)
 131: 
 132:     assignments = colors[:]
 133:     assignments.extend(random.choice(colors) for _ in range(marker_count - len(assignments)))
 134:     random.shuffle(assignments)
 135:     return assignments
 136: 
 137: 
 138: def _gen_attempt() -> np.ndarray | None:
 139:     """Try to generate one valid input grid. Returns None on oracle mismatch."""
 140:     n_tiles = random.randint(*_TILE_RANGE)
 141:     m_tiles = random.randint(*_TILE_RANGE)
 142:     total_tiles = n_tiles * m_tiles
 143:     marker_count = random.randint(1, min(_MAX_MARKERS, total_tiles - 1))
 144: 
 145:     marked_tiles = [(i, j) for i in range(n_tiles) for j in range(m_tiles)]
 146:     random.shuffle(marked_tiles)
 147:     marked_tiles = marked_tiles[:marker_count]
 148:     marker_colors = _choose_marker_colors(marker_count)
 149: 
 150:     out = _base_lattice(n_tiles, m_tiles)
 151:     for (i, j), color in zip(marked_tiles, marker_colors):
 152:         r0, c0 = 5 * i, 5 * j
 153:         for dr, dc in _CAVITY_OFFSETS:
 154:             out[r0 + dr, c0 + dc] = color
 155: 
 156:     inp = out.copy()
 157:     for (i, j), color in zip(marked_tiles, marker_colors):
 158:         r0, c0 = 5 * i, 5 * j
 159:         for dr, dc in _CAVITY_OFFSETS:
 160:             inp[r0 + dr, c0 + dc] = _EMPTY
 161:         inp[r0, c0] = color
 162: 
 163:     try:
 164:         solved = main(inp)
 165:     except Exception:
 166:         return None
 167:     if np.array_equal(solved, out):
 168:         return inp

