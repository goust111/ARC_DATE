+    r1 = int(rows.max())
+    c0 = int(cols.min())
+    c1 = int(cols.max())
+    left_offsets = {int(r - r0) for r, c in coords if int(c) == c0}
+    right_offsets = {int(r - r0) for r, c in coords if int(c) == c1}
+    return {
