+def _find_object_span(grid: np.ndarray) -> tuple[int, int]:
+    mask = (grid[0] == GREEN) & (grid[1] == GREEN) & np.isin(grid[2], [BLUE, MAROON])
+    runs = _contiguous_runs(mask)
