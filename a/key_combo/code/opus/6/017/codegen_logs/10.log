    dc = near_c - pivot_c
    assert abs(dr) + abs(dc) == 1

    expected_source = {
        (pivot_r + k * dr, pivot_c + k * dc)
        for k in range(1, length + 1)
    }
    assert red_set == expected_source

    out = g.copy()
    out[g == Color.RED] = Color.GREEN

    rotated_dr, rotated_dc = dc, -dr
