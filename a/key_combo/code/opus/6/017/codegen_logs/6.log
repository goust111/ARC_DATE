+        kinds[r0 : r0 + side, c0 : c0 + side] = 2
+        center_r = r0 + side // 2
+        center_c = c0 + side // 2
+        marked[center_r, center_c] = ODD_CENTER_COLOR
+        kinds[center_r, center_c] = 3
+        odd_count += 1
