+    marked = np.zeros(shape, dtype=int)
+    kinds = np.zeros(shape, dtype=np.int8)
+    # kinds: 0 bg, 1 even square, 2 odd non-center, 3 odd center
+    odd_count = 0
+    even_count = 0
+
+    for sq in squares:
+        color = int(sq["color"])
+        r0 = int(sq["r0"])
+        c0 = int(sq["c0"])
+        side = int(sq["side"])
+        marked[r0 : r0 + side, c0 : c0 + side] = color
