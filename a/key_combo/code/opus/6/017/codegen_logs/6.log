def _choose_borders() -> tuple[int, int, int, int]:
    borders = [random.choice(BORDER_CHOICES) for _ in range(4)]
    while sum(borders) < MIN_VISIBLE_BORDERS:
        borders[random.randint(0, 3)] = 1
