+ODD_CENTER_COLOR = 4
+INPUT_COLORS = (1, 2, 3)
+INPUT_SIZES = (4, 5)
+MAX_GENERATION_ATTEMPTS = 300
+NEIGHBORS4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
