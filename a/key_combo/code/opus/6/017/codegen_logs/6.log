def _gen_expected_output(inp: np.ndarray) -> np.ndarray:
    h, w = inp.shape
    masks = {int(color): np.where(inp == int(color), int(color), 0) for color in np.unique(inp)}
    out = np.zeros((h * h, w * w), dtype=int)
    for r in range(h):
        for c in range(w):
