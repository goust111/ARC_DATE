+            return False
+    return True
+
+
+def _paint_scene(specs: list[dict], h: int, w: int) -> tuple[np.ndarray, list[dict]]:
+    grid = np.zeros((h, w), dtype=int)
+    meta = []
+    for spec in specs:
+        r0 = spec["top"]
+        c0 = spec["left"]
+        for layer in range(spec["depth"]):
+            rr = r0 + 2 * layer
+            cc = c0 + 2 * layer
