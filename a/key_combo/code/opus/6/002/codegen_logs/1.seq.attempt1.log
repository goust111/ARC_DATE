+        iw = spec["inner_w"] - 2
+        mr = random.randint(ir0, ir0 + ih - 1)
+        mc = random.randint(ic0, ic0 + iw - 1)
+        grid[mr, mc] = spec["color"]
+        meta.append(
+            {
+                "depth": spec["depth"],
+                "color": spec["color"],
+                "marker": (mr, mc),
+                "outer_box": (r0, c0, r0 + spec["outer_h"] - 1, c0 + spec["outer_w"] - 1),
+                "outer_area": spec["outer_area"],
