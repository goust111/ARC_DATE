+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RING = 5
+MARKER_COLORS = (1, 2, 3, 4, 6, 7, 8, 9)
+N4 = ((-1, 0), (1, 0), (0, -1), (0, 1))
