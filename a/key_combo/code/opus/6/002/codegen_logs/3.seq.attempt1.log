+            orientations.extend(("left", "right"))
+        random.shuffle(orientations)
+
+        for orientation in orientations:
+            patch = np.zeros((interior_h + 2, interior_w + 2), dtype=int)
+            patch[0, :] = GREY
+            patch[-1, :] = GREY
