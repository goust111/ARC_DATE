+                "area_without_marker": int(coords.shape[0]),
+                "marker_colors": tuple(sorted(marker_colors)),
+                "touches_border": int(touches_border),
+                "component_id": int(comp_id),
+                "size": int(sizes[comp_id]),
+            }
