+def _assemble_grid(
+    regions: list[tuple[int, int, bool, str]]
+) -> tuple[np.ndarray, list[tuple[int, int]], list[int]]:
+    left_regions = [spec for spec in regions if spec[3] == "L"]
+    right_regions = [spec for spec in regions if spec[3] == "R"]
