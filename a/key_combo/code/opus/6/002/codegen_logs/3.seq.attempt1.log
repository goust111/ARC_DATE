+def _choose_marker(fill_cells: set[tuple[int, int]]) -> tuple[int, int] | None:
+    candidates = []
+    for cell in fill_cells:
+        if _connected(set(fill_cells) - {cell}):
+            candidates.append(cell)
+    return random.choice(candidates) if candidates else None
+
