+            c = int(c_raw)
+            if r in (0, grid.shape[0] - 1) or c in (0, grid.shape[1] - 1):
+                touches_border = True
+            for nr, nc in neighbors4(r, c):
+                if 0 <= nr < grid.shape[0] and 0 <= nc < grid.shape[1]:
+                    v = int(grid[nr, nc])
+                    if v not in (0, GREY, ORANGE):
