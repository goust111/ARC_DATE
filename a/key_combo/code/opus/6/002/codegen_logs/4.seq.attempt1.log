+    elif direction == "left":
+        for i, vis in enumerate(visible):
+            full_len = c0
+            if vis < full_len:
+                obs.add((r0 + 1 + i, c0 - 1 - vis))
+    else:
+        c1 = c0 + w - 1
+        for i, vis in enumerate(visible):
