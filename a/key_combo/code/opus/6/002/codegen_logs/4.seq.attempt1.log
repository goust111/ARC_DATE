+    color = int(grid[seed_r, seed_c])
+    return {
+        "bbox": (r0, c0, r1, c1),
+        "direction": direction,
+        "seed": (seed_r, seed_c),
+        "color": color,
+    }
+
+
+def _parse_legend(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> dict:
+    r0, c0, r1, c1 = bbox
+    keys = {}
