+def _opening_direction(submask: np.ndarray) -> str:
+    top = np.all(submask[0, 1:-1])
+    bottom = np.all(submask[-1, 1:-1])
+    left = np.all(submask[1:-1, 0])
+    right = np.all(submask[1:-1, -1])
