+    frame[-1, :] = True
+    frame[:, 0] = True
+    frame[:, -1] = True
+    return frame
+
+
+def _is_legend_component(grid: np.ndarray, comp: np.ndarray) -> bool:
+    r0, c0, r1, c1 = bbox_coords(comp)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    if h < 5 or w < 7:
