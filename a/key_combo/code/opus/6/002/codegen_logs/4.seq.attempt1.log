+
+def _visible_tuples(span: int, full_len: int, target_sum: int) -> list[tuple[int, ...]]:
+    out = []
+    if full_len < 0:
+        return out
+
+    def rec(idx: int, rem: int, cur: list[int]) -> None:
+        if idx == span:
+            if rem == 0:
