+        theoretical += sum(len(lane) for lane in _ray_lanes(bbox, direction, grid.shape))
+        obstacle_flags.append(len(filled) < theoretical)
+    assert any(obstacle_flags)
+    assert any(not flag for flag in obstacle_flags)
+    assert set(legend["keys"]) == set(expected_counts)
+
+
+def generate_input() -> np.ndarray:
