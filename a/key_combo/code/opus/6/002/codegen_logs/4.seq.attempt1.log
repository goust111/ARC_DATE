+    grid[legend_r0 : legend_r1 + 1, legend_c0 : legend_c1 + 1][frame] = GREY
+
+    for row, color in zip(legend_rows, [color for color in KEY_ORDER if color in {spec["color"] for spec in specs}]):
+        grid[row, legend_c0 + 1] = color
