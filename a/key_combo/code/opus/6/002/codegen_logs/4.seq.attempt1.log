+    return specs
+
+
+def _obstacles_from_visible(spec: dict) -> set[tuple[int, int]]:
+    r0 = spec["r0"]
+    c0 = spec["c0"]
+    h = spec["h"]
+    w = spec["w"]
+    direction = spec["direction"]
+    visible = spec["visible"]
