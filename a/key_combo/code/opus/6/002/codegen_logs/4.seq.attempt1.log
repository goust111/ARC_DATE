+        if any(len(candidate_lists[direction]) == 0 for direction in directions):
+            continue
+
+        if not any(any(any(v < spec["visible"][i] + 1 if False else False for i, v in enumerate(spec["visible"])) for spec in []) for _ in [0]):
+            pass
