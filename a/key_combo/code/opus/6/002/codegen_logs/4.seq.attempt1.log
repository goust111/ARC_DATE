+                            for vis in _visible_tuples(lane_span, full_len, target_count - area):
+                                specs.append({"r0": r0, "c0": c0, "h": h, "w": w, "direction": direction, "visible": vis})
+            else:
+                lane_span = h - 2
+                row_starts = [height // 2 + 1, height // 2 + 2, height // 2 + 3]
