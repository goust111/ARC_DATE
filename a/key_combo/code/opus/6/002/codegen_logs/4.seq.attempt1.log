+                col_starts = [c for c in (1, 2, 3) if c + w <= play_w]
+                for full_len in (1, 2, 3):
+                    r0 = full_len
+                    if r0 + h > height:
+                        continue
+                    for c0 in col_starts:
+                        for vis in _visible_tuples(lane_span, full_len, target_count - area):
