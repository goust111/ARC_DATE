+    return out
+
+
+def _candidate_specs(direction: str, target_count: int, height: int, play_w: int) -> list[dict]:
+    specs = []
+    for h in range(3, 6):
+        for w in range(3, 6):
+            area = (h - 2) * (w - 2)
+            if area <= 0 or area > target_count or area > 6:
+                continue
