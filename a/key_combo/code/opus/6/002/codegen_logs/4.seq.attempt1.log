+def _filled_cells(grid: np.ndarray, wall: dict) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    r0, c0, r1, c1 = wall["bbox"]
+    seed_r, seed_c = wall["seed"]
+    color = wall["color"]
+    direction = wall["direction"]
