+        for c in range(c0, c1 + 1):
+            cells.add((r0, c))
+    if direction != "down":
+        for c in range(c0, c1 + 1):
+            cells.add((r1, c))
+    if direction != "left":
+        for r in range(r0, r1 + 1):
+            cells.add((r, c0))
+    if direction != "right":
+        for r in range(r0, r1 + 1):
+            cells.add((r, c1))
