+    "filled4": [(0, 0), (1, -1), (1, 0), (1, 1)],
+    "pike5": [(0, 0), (1, -1), (1, 0), (1, 1), (2, 0)],
+    "dart5": [(0, 0), (1, 0), (2, -1), (2, 0), (2, 1)],
