+
+def _rotate_offsets(offsets: list[tuple[int, int]], turns: int) -> list[tuple[int, int]]:
+    out = [(int(dr), int(dc)) for dr, dc in offsets]
+    for _ in range(int(turns) % 4):
+        out = [_rot90(dr, dc) for dr, dc in out]
+    return out
