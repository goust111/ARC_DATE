+    out[fr1, fc0 + 1 : fc1] = scene["side_colors"]["bottom"]
+    out[fr0 + 1 : fr1, fc0] = scene["side_colors"]["left"]
+    out[fr0 + 1 : fr1, fc1] = scene["side_colors"]["right"]
