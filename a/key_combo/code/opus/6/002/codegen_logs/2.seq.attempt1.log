+def _free_segments(occupied: np.ndarray, width: int, gap: int = 1) -> list[int]:
+    starts = []
+    n = occupied.size
+    for s in range(0, n - width + 1):
+        left = max(0, s - gap)
+        right = min(n, s + width + gap)
+        if not occupied[left:right].any():
+            starts.append(s)
+    return starts
