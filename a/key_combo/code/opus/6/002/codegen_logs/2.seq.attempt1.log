+    bottom_dist = ir1 - row
+    if top_dist < bottom_dist:
+        return side_colors["top"]
+    if bottom_dist < top_dist:
+        return side_colors["bottom"]
+    return random.choice((side_colors["top"], side_colors["bottom"]))
