from collections import deque

def sim(H,W,blocks,start,d,mode='pair',limit=1000):
    dirs=[(-1,0),(0,1),(1,0),(0,-1)] # N,E,S,W
    odd={0:1,1:0,2:3,3:2}  # N->E,E->N,S->W,W->S
    even={0:3,1:2,2:1,3:0} # N->W,E->S,S->E,W->N
    sameL=lambda di:(di-1)%4
    pos=start
    occ=set(blocks)|{start}
    path=[]
    di=dirs.index(d)
    collisions=0
    stopped='limit'
    for _ in range(limit):
        nr,nc=pos[0]+dirs[di][0], pos[1]+dirs[di][1]
        blocked= not (0<=nr<H and 0<=nc<W) or (nr,nc) in occ
        if not blocked:
            pos=(nr,nc); occ.add(pos); path.append(pos); continue
        collisions+=1
        if 0<=nr<H and 0<=nc<W:
            occ.add((nr,nc)); path.append((nr,nc))
        if mode=='pair':
            ndi=(odd if collisions%2 else even)[di]
        else:
            ndi=sameL(di)
        tr,tc=pos[0]+dirs[ndi][0], pos[1]+dirs[ndi][1]
        if not (0<=tr<H and 0<=tc<W) or (tr,tc) in occ:
            stopped='turnblock'; break
        di=ndi
    else:
        stopped='limit'
    return path, collisions, stopped, occ

def enclosed(H,W,occ,blocks,start):
    # nonblack obstacles = occ|blocks|start? occ already includes blocks,start
    free=[[1]*W for _ in range(H)]
    for r,c in occ:
        free[r][c]=0
    seen=[[0]*W for _ in range(H)]
    comps=[]
    for r in range(H):
      for c in range(W):
        if free[r][c] and not seen[r][c]:
          q=[(r,c)]; seen[r][c]=1; comp=[]
          while q:
            x,y=q.pop(); comp.append((x,y))
            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
              xx,yy=x+dx,y+dy
              if 0<=xx<H and 0<=yy<W and free[xx][yy] and not seen[xx][yy]:
                seen[xx][yy]=1; q.append((xx,yy))
          comps.append(comp)
    if not comps: return 0,[]
    comps.sort(key=len, reverse=True)
    return len(comps)-1, [len(c) for c in comps[1:]]

