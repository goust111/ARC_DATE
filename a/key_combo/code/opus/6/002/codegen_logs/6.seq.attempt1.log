from collections import deque

def sim(H,W,blocks,start,d,limit=1000):
    dirs=[(-1,0),(0,1),(1,0),(0,-1)]
    odd={0:1,1:0,2:3,3:2}
    even={0:3,1:2,2:1,3:0}
    pos=start
    di=dirs.index(d)
    path=[]
    grid={}  # painted path/final colors dummy
    occ=set(blocks)|{start}
    collisions=[]
    step=0
    while step<limit:
        nr,nc=pos[0]+dirs[di][0],pos[1]+dirs[di][1]
        blocked=not (0<=nr<H and 0<=nc<W) or (nr,nc) in occ
        if not blocked:
            pos=(nr,nc); occ.add(pos); path.append(pos); step+=1; continue
        kind='oob' if not (0<=nr<H and 0<=nc<W) else ('block' if (nr,nc) in blocks else 'path')
        collisions.append(kind)
        if kind=='oob':
            path.append(pos)  # repaint current cell yellow
        ndi=(odd if len(collisions)%2 else even)[di]
        tr,tc=pos[0]+dirs[ndi][0], pos[1]+dirs[ndi][1]
        if not (0<=tr<H and 0<=tc<W) or (tr,tc) in occ:
            return collisions,('occupied_turn' if (0<=tr<H and 0<=tc<W) else 'oob_turn'),occ|set(path)
        di=ndi
    return collisions,('limit'),occ|set(path)

def comps(H,W,obstacles):
    free={(r,c) for r in range(H) for c in range(W)}-obstacles
    seen=set(); sizes=[]
    for p in list(free):
        if p in seen: continue
        q=[p]; seen.add(p); comp=[]
        while q:
            r,c=q.pop(); comp.append((r,c))
            for dr,dc in [(-1,0),(1,0),(0,-1),(0,1)]:
                np=(r+dr,c+dc)
                if np in free and np not in seen:
                    seen.add(np); q.append(np)
        sizes.append(len(comp))
    return sorted(sizes, reverse=True)

H=W=18
blocks=set()
for i in range(3):
  for r in [0,1]:
    for c in [i*3,i*3+1]:
      blocks.add((r,c))
for start in [(0,9),(1,17),(4,0),(0,15)]:
  d=(1,0) if start[0]==0 else (-1,0) if start[0]==H-1 else (0,1) if start[1]==0 else (0,-1)
  colls,stop,obs=sim(H,W,blocks,start,d)
  print(start,stop,colls[:10],len(colls),comps(H,W,obs)[:5])
