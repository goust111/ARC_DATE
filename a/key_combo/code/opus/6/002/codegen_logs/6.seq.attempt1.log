+
+    draw_step: dict[tuple[int, int], int] = {}
+    collision_kinds: list[str] = []
+    path_cells: set[tuple[int, int]] = set()
+
+    current = start
+    cycle_idx = 0
+    step_idx = 0
+    max_iters = h * w * 8
+
