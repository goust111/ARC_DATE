+def _edge_candidates(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    pts = []
+    for c in range(1, w - 1):
+        if int(grid[0, c]) == BG:
+            pts.append((0, c))
+        if int(grid[h - 1, c]) == BG:
+            pts.append((h - 1, c))
+    for r in range(1, h - 1):
+        if int(grid[r, 0]) == BG:
+            pts.append((r, 0))
+        if int(grid[r, w - 1]) == BG:
+            pts.append((r, w - 1))
+    return pts
