+import numpy as np
+
+
+BG = 0
+START = 5
+HIT = 4
+DIRS = [(-1, 0), (0, 1), (1, 0), (0, -1)]  # N, E, S, W
+ODD_TURN = [1, 0, 3, 2]   # N->E, E->N, S->W, W->S
