+        except AssertionError:
+            continue
+        if _valid_instance(grid, out, meta):
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(MAX_RETRIES):
+        grid = _gen_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

