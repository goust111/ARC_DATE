+    largest_count = sum(area == largest_area for area, _ in areas)
+    exterior_idx = max(range(len(comps)), key=lambda idx: len(comps[idx]))
+
+    filled_regions = []
+    total_filled = 0
+    for idx, comp in enumerate(comps):
+        if idx == exterior_idx:
