import numpy as np

def solve(grid):
    BG,START,HIT=0,5,4
    DIRS=[(-1,0),(0,1),(1,0),(0,-1)]
    g=np.array(grid,copy=True)
    pts=np.argwhere(g==START)
    r,c=map(int,pts[0])
    if r==0: d=2
    elif r==g.shape[0]-1: d=0
    elif c==0: d=1
    else: d=3
    cycle=[]
    mask=(g"'!=0)&(g!=5)
    seen=np.zeros_like(mask,dtype=bool)
    blocks=[]
    from collections import deque
    for rr in range(g.shape[0]):
      for cc in range(g.shape[1]):
        if not mask[rr,cc] or seen[rr,cc]: continue
        q=deque([(rr,cc)]); seen[rr,cc]=True; comp=[]
        while q:
          x,y=q.popleft(); comp.append((x,y))
          for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
            xx,yy=x+dx,y+dy
            if 0<=xx<g.shape[0] and 0<=yy<g.shape[1] and mask[xx,yy] and not seen[xx,yy]:
              seen[xx,yy]=True; q.append((xx,yy))
        blocks.append(comp)
    blocks=sorted(blocks,key=lambda comp:min(c for _,c in comp))
    cycle=[int(g[comp[0]]) for comp in blocks]
    draw={}
    cur=(r,c); idx=0; step=0
    for _ in range(g.size*8):
      nr,nc=cur[0]+DIRS[d][0],cur[1]+DIRS[d][1]
      if 0<=nr<g.shape[0] and 0<=nc<g.shape[1] and g[nr,nc]==0:
        step+=1; g[nr,nc]=cycle[idx%len(cycle)]; idx+=1; draw[(nr,nc)]=step; cur=(nr,nc); continue
      if not (0<=nr<g.shape[0] and 0<=nc<g.shape[1]) and cur!=(r,c):
        step+=1; g[cur]=HIT; draw[cur]=step
      nd=(d-1)%4
      tr,tc=cur[0]+DIRS[nd][0], cur[1]+DIRS[nd][1]
      if not (0<=tr<g.shape[0] and 0<=tc<g.shape[1]) or g[tr,tc]!=0: break
      d=nd
    return g

