+    if np.array_equal(inp, out):
+        return False
+    changed = int(np.sum(inp != out))
+    return changed >= 12
+
+
+def _gen_attempt(rng: random.Random) -> np.ndarray | None:
+    h = rng.randint(15, 22)
+    w = rng.randint(15, 22)
+    try:
