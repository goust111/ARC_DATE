+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        built = _build_case()
+        if built is None:
+            continue
+        grid, expected, meta = built
+        if _validate_case(grid, expected, meta):
+            return grid
+    raise RuntimeError("failed to generate a valid puzzle instance")

