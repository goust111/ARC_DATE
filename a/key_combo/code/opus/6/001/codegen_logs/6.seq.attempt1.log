+        return None
+    for color in (a, b):
+        color_rows = np.flatnonzero(np.any(grid == int(color), axis=1))
+        color_cols = np.flatnonzero(np.any(grid == int(color), axis=0))
+        if len(color_rows) < 2 or len(color_cols) < 2:
+            return None
