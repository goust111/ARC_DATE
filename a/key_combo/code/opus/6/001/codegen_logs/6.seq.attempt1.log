+def _run_bits(length: int) -> np.ndarray:
+    n_runs = random.randint(2, min(4, length))
+    cuts = sorted(random.sample(range(1, length), n_runs - 1))
+    bits = np.zeros(length, dtype=int)
+    start = 0
+    bit = random.randint(0, 1)
+    for end in cuts + [length]:
+        bits[start:end] = bit
+        bit ^= 1
+        start = end
+    return bits
+
