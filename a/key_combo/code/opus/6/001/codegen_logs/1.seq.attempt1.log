+        assert fixed_sign != 0
+        tail_step = (-fixed_sign, 0)
+        fixed_red = [(hinge[0] + fixed_sign * k, col) for k in range(1, 99) if (hinge[0] + fixed_sign * k, col) in cells]
+
+    tail: list[tuple[int, int]] = []
+    step = 1
+    while True:
