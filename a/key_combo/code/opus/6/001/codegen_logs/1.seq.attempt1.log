    else:
        for r in range(q):
            coords.extend((r, c) for c in range(_SNAKE_HOLE_WIDTH))
        coords.extend((q, c) for c in range(rem))
    mask = np.zeros((max(r for r, _ in coords) + 1, _SNAKE_HOLE_WIDTH), dtype=bool)
    for r, c in coords:
        mask[r, c] = True
    return mask


