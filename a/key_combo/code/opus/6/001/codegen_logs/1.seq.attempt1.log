        or b[3] + pad < a[1]
    )


def _place_patch(
    grid: np.ndarray, patch: np.ndarray, bg: int, placed: list[BBox], *, margin: int = 0
) -> BBox | None:
    """Paste one patch if a separated location exists; returns its foreground bbox."""
    h, w = patch.shape
    patch_mask = patch != bg
    patch_box = bbox(patch_mask)
