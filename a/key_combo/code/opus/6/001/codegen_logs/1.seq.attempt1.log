    left, right = c, n - 1 - c
    if left == right:
        return None
    return (fixed_sign, 0), ((0, -1) if left > right else (0, 1))


def _ray_cells(origin: tuple[int, int], step: tuple[int, int], count: int) -> list[tuple[int, int]]:
