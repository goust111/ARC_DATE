+
+def _adjacency(passable: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    out: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in np.argwhere(passable):
+        node = (int(r), int(c))
+        nbrs = []
+        for rr, cc in _neighbors4(*node):
