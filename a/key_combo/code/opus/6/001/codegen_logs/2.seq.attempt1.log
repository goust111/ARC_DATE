+                placed = True
+                break
+            if not placed:
+                continue
+
+        blocked_lower_cols = set()
+        for col in blocker_cols:
+            blocked_lower_cols.update({col - 1, col, col + 1})
+
+        for _ in range(lower_branch_count):
+            placed = False
+            for _ in range(80):
+                anchor = random.randint(c0 + 2, c_end - 2)
+                if anchor in blocked_lower_cols:
+                    continue
+                length = random.randint(2, 4)
+                direction = random.choice([-1, 1])
+                tip = anchor + direction * length
+                lo = min(anchor, tip)
+                hi = max(anchor, tip)
+                if lo < c0 + 1 or hi > c_end - 1:
