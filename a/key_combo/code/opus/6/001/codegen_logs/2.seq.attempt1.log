+def _passable_mask(
+    grid: np.ndarray,
+    *,
+    use_periodic: bool,
+    use_blockers: bool,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    track = _track_mask(g)
+    blocked = np.zeros(g.shape, dtype=bool)
