+        upper_intervals: list[tuple[int, int]] = []
+        lower_intervals: list[tuple[int, int]] = []
+        blocker_cols: list[int] = []
+
+        _paint_h(grid, r0, c0, c_end, TRACK)
+
+        for kind, lo, hi in modules:
