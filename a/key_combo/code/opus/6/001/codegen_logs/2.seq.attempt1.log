+                expected[r, c] = PATH
+        expected[r0 : r1 + 1, c0 : c1 + 1] = BG
+        if not np.array_equal(out, expected):
+            return False
+
+        if np.count_nonzero(grid == ORANGE) < 1 or np.count_nonzero(grid == ORANGE) > 3:
+            return False
+        if np.count_nonzero(grid == PATH) != 2:
+            return False
+        return True
+    except Exception:
+        return False
+
