+    if use_periodic:
+        orient, period, offset, _frame_box = _decode_periodic_rule(g)
+        if orient == "row":
+            rows = np.arange(g.shape[0]) % period == offset
+            blocked |= track & rows[:, None]
+        else:
+            cols = np.arange(g.shape[1]) % period == offset
+            blocked |= track & cols[None, :]
