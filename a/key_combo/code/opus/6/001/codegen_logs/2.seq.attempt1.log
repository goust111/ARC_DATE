+    grid[fr, fc : fc + fw] = GREY
+    grid[fr + fh - 1, fc : fc + fw] = GREY
+    grid[fr : fr + fh, fc] = GREY
+    grid[fr : fr + fh, fc + fw - 1] = GREY
+
+    left = fc + 1
+    right = fc + fw - 2
+    top_bar = fr + 1
+    bot_bar = fr + fh - 2
+    grid[top_bar, left : right + 1] = BLUE
+    grid[bot_bar, left : right + 1] = BLUE
