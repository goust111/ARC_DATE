+    r0, c0, r1, c1 = frame_box
+    out[r0 : r1 + 1, c0 : c1 + 1] = BG
+    return out
+
+
+def _encode_frame(grid: np.ndarray, period: int, offset: int) -> None:
+    fr, fc = 1, 1
+    fh, fw = 9, 6
