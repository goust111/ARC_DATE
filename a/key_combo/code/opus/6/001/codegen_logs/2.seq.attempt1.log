+
+def _bfs_path(
+    passable: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+) -> list[tuple[int, int]]:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for nxt in _neighbors4(*cur):
