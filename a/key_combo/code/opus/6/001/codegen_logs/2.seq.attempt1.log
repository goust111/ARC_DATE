+    grid[fr, fc : fc + fw] = GREY
+    grid[fr + fh - 1, fc : fc + fw] = GREY
+    grid[fr : fr + fh, fc] = GREY
+    grid[fr : fr + fh, fc + fw - 1] = GREY
