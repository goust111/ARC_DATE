+                _paint_h(grid, rf, lo, hi, TRACK)
+                _paint_v(grid, hi, rf, r0, TRACK)
+                _reserve_interval(lo, hi, upper_intervals)
+            else:
+                _paint_v(grid, lo, r0, r1, TRACK)
+                _paint_h(grid, r1, lo, hi, TRACK)
+                _paint_v(grid, hi, r0, r1, TRACK)
