+    path = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _count_simple_paths(
+    passable: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    limit: int = 2,
+) -> int:
+    adj = _adjacency(passable)
+    seen = {start}
+    count = 0
+
+    def dfs(node: tuple[int, int]) -> None:
+        nonlocal count
+        if count >= limit:
+            return
+        if node == goal:
+            count += 1
+            return
+        for nxt in adj[node]:
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            dfs(nxt)
+            seen.remove(nxt)
