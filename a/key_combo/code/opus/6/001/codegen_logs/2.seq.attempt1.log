+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _paint_h(grid: np.ndarray, row: int, c0: int, c1: int, color: int) -> None:
+    if c0 > c1:
+        c0, c1 = c1, c0
+    grid[row, c0 : c1 + 1] = color
+
+
