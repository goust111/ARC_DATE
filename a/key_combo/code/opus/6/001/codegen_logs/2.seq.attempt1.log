    if any(not in_bounds(shape, rr, cc) for rr, cc in all_cells):
        return None

    endpoint = fixed[-1]
    fixed_red = fixed[:-1]
    input_cells = {hinge, endpoint, *fixed_red, *tail}
    envelope = input_cells | set(folded)
    if len(envelope) != len(input_cells) + len(folded):
        return None

    return {
        "hinge": hinge,
        "endpoint": endpoint,
        "fixed_red": fixed_red,
        "tail": tail,
        "folded": folded,
        "envelope": envelope,
