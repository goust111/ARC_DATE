+
+def _adjacency(passable: np.ndarray) -> dict[tuple[int, int], list[tuple[int, int]]]:
+    out: dict[tuple[int, int], list[tuple[int, int]]] = {}
+    for r, c in np.argwhere(passable):
+        node = (int(r), int(c))
+        nbrs = []
+        for rr, cc in _neighbors4(*node):
+            if _in_bounds(passable.shape, rr, cc) and passable[rr, cc]:
+                nbrs.append((rr, cc))
+        out[node] = nbrs
+    return out
+
+
+def _bfs_path(
+    passable: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+) -> list[tuple[int, int]]:
+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for nxt in _neighbors4(*cur):
+            if _in_bounds(passable.shape, *nxt) and passable[nxt] and nxt not in prev:
+                prev[nxt] = cur
+                q.append(nxt)
+    assert goal in prev
+    path = []
+    cur: tuple[int, int] | None = goal
+    while cur is not None:
+        path.append(cur)
+        cur = prev[cur]
+    path.reverse()
+    return path
+
+
+def _count_simple_paths(
+    passable: np.ndarray,
+    start: tuple[int, int],
+    goal: tuple[int, int],
+    limit: int = 2,
+) -> int:
+    adj = _adjacency(passable)
+    seen = {start}
+    count = 0
+
+    def dfs(node: tuple[int, int]) -> None:
+        nonlocal count
+        if count >= limit:
+            return
+        if node == goal:
+            count += 1
+            return
+        for nxt in adj[node]:
+            if nxt in seen:
+                continue
+            seen.add(nxt)
+            dfs(nxt)
+            seen.remove(nxt)
+            if count >= limit:
+                return
+
+    dfs(start)
+    return count
+
