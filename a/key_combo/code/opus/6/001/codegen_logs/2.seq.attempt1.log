+    if r0 > r1:
+        r0, r1 = r1, r0
+    grid[r0 : r1 + 1, col] = color
+
+
+def _track_mask(grid: np.ndarray) -> np.ndarray:
+    return (grid == TRACK) | (grid == PATH)
+
+
