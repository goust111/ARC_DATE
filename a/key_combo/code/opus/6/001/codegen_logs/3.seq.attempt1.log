+def _describe_input_bar(comp: dict[str, object]) -> BarSpec:
+    coords = np.asarray(comp["coords"], dtype=int)
+    r0, c0, r1, c1 = map(int, comp["bbox"])
+    height = r1 - r0 + 1
+    width = c1 - c0 + 1
