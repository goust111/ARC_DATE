+def _pair_solution(bar1: BarSpec, bar2: BarSpec, *, require_open: bool) -> dict[str, object]:
+    candidates = _diagonal_endpoint_candidates(
+        bar1["rot_endpoints"], bar2["rot_endpoints"], require_open=require_open
+    )
