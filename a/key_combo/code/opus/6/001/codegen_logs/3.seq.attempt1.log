   287	    h = box[2] - box[0] + 1
   288	    w = box[3] - box[1] + 1
   289	    lengths = [length for length in ODD_LENGTHS if length <= min(h, w)]
   290	    if not lengths:
   291	        return None
   292	
   293	    out_orients = (_swap_orient(input_orients[0]), _swap_orient(input_orients[1]))
   294	    axis1 = _axis_for(out_orients[0])
   295	    axis2 = _axis_for(out_orients[1])
   296	
   297	    for _ in range(PAIR_ATTEMPTS):
   298	        length1 = random.choice(lengths)
   299	        length2 = random.choice(lengths)
   300	        half1 = length1 // 2
   301	        half2 = length2 // 2
   302	        center1 = random.choice(_center_choices(box, half1))
   303	        endpoint_side1 = random.choice((-1, 1))
   304	        endpoint_side2 = random.choice((-1, 1))
   305	        row_sign = random.choice((-1, 1))
   306	        distance = random.randint(2, 5)
   307	        delta = (row_sign * distance, row_sign * slope_sign * distance)
   308	
   309	        center2 = (
   310	            int(center1[0] + endpoint_side1 * half1 * axis1[0] + delta[0] - endpoint_side2 * half2 * axis2[0]),
   311	            int(center1[1] + endpoint_side1 * half1 * axis1[1] + delta[1] - endpoint_side2 * half2 * axis2[1]),
   312	        )
   313	        if center2 not in _center_choices(box, half2):
   314	            continue
   315	
   316	        bar1 = _make_bar(center1, length1, input_orients[0], color)
   317	        bar2 = _make_bar(center2, length2, input_orients[1], color)
   318	        if not _inside_box(bar1["pixels"], box) or not _inside_box(bar2["pixels"], box):
   319	            continue
   320	        if not _inside_box(bar1["rot_pixels"], box) or not _inside_box(bar2["rot_pixels"], box):
   321	            continue
   322	        if _same_line(bar1, bar2):
   323	            continue
   324	        if _touching_or_overlapping(set(bar1["pixels"]), set(bar2["pixels"])):
   325	            continue
   326	        if set(bar1["rot_pixels"]) & set(bar2["rot_pixels"]):
   327	            continue
   328	        if _diagonal_endpoint_candidates(bar1["endpoints"], bar2["endpoints"], require_open=True):
   329	            continue
   330	
   331	        candidates = _diagonal_endpoint_candidates(
   332	            bar1["rot_endpoints"], bar2["rot_endpoints"], require_open=True
   333	        )
   334	        if len(candidates) != 1:
   335	            continue
   336	        connector = candidates[0]
   337	        if int(connector["slope_sign"]) != int(slope_sign):
   338	            continue
   339	        footprint = set(bar1["rot_pixels"]) | set(bar2["rot_pixels"])
   340	        if footprint & set(connector["path"]):
   341	            continue
   342	        if not _inside_box(connector["path"], box):
   343	            continue
   344	
   345	        return {
   346	            "color": int(color),
   347	            "bars": (bar1, bar2),
   348	            "connector": connector,
   349	            "box": box,
   350	        }
   351	    return None
   352	
   353	
   354	def _sample_layout() -> tuple[tuple[int, int], list[Box]]:
   355	    top = random.randint(*OUTER_MARGIN_RANGE)
   356	    bottom = random.randint(*OUTER_MARGIN_RANGE)
   357	    left = random.randint(*OUTER_MARGIN_RANGE)
   358	    right = random.randint(*OUTER_MARGIN_RANGE)
   359	    gap_r = random.randint(*CELL_GAP_RANGE)
   360	    gap_c = random.randint(*CELL_GAP_RANGE)
   361	    h0 = random.randint(*CELL_SIZE_RANGE)
   362	    h1 = random.randint(*CELL_SIZE_RANGE)
   363	    w0 = random.randint(*CELL_SIZE_RANGE)
   364	    w1 = random.randint(*CELL_SIZE_RANGE)
   365	    rows = top + h0 + gap_r + h1 + bottom
   366	    cols = left + w0 + gap_c + w1 + right
   367	    boxes = [
   368	        (top, left, top + h0 - 1, left + w0 - 1),
   369	        (top, left + w0 + gap_c, top + h0 - 1, left + w0 + gap_c + w1 - 1),
   370	        (top + h0 + gap_r, left, top + h0 + gap_r + h1 - 1, left + w0 - 1),
   371	        (
   372	            top + h0 + gap_r,
   373	            left + w0 + gap_c,
   374	            top + h0 + gap_r + h1 - 1,
   375	            left + w0 + gap_c + w1 - 1,
   376	        ),
   377	    ]
   378	    return (rows, cols), boxes
   379	
   380	
   381	def _target_patterns(count: int) -> list[tuple[str, str]]:
   382	    pool = list(PATTERN_CATALOG)
   383	    random.shuffle(pool)
   384	    if count <= len(pool):
   385	        return pool[:count]
   386	    out = []
   387	    while len(out) < count:
   388	        random.shuffle(pool)
   389	        out.extend(pool)
   390	    return out[:count]
   391	
   392	
   393	def _target_slopes(count: int) -> list[int]:
   394	    slopes = [1, -1]
   395	    while len(slopes) < count:
   396	        slopes.append(random.choice((-1, 1)))
   397	    random.shuffle(slopes)
   398	    return slopes[:count]
   399	
   400	
   401	def _render_input(shape: tuple[int, int], pairs: list[PairSpec]) -> np.ndarray:
   402	    grid = np.full(shape, BG, dtype=int)
   403	    for pair in pairs:
   404	        for bar in pair["bars"]:
   405	            color = int(bar["color"])
   406	            for r, c in bar["pixels"]:
   407	                assert grid[r, c] == BG
   408	                grid[r, c] = color
   409	    return grid
   410	
   411	
   412	def _expected_from_pairs(shape: tuple[int, int], pairs: list[PairSpec]) -> np.ndarray:
   413	    bars = [bar for pair in pairs for bar in pair["bars"]]
   414	    pair_info = {int(pair["color"]): dict(pair["connector"]) for pair in pairs}
   415	    return _render_rotated_output(shape, bars, pair_info, BG)
   416	
   417	
   418	def _semantic_validator(inp: np.ndarray, expected: np.ndarray) -> bool:
   419	    try:
   420	        bars, pair_info = _analyze_scene(inp, require_open=True)
   421	        actual = main(inp)
   422	    except Exception:
   423	        return False
   424	    if not np.array_equal(actual, expected):
   425	        return False
   426	    rebuilt = _render_rotated_output(inp.shape, bars, pair_info, _get_bg(inp))
   427	    if not np.array_equal(rebuilt, expected):
   428	        return False
   429	    if len({tuple(sorted(info["path"])) for info in pair_info.values()}) != len(pair_info):
   430	        return False
   431	    return True
   432	
   433	
   434	def _gen_attempt() -> np.ndarray | None:
   435	    shape, boxes = _sample_layout()
   436	    pair_count = random.randint(*PAIR_COUNT_RANGE)
   437	    chosen_cells = random.sample(range(4), pair_count)
   438	    colors = random.sample(PAIR_COLORS, pair_count)
   439	    patterns = _target_patterns(pair_count)
   440	    slopes = _target_slopes(pair_count)
   441	
   442	    pairs: list[PairSpec] = []
   443	    for cell_idx, color, pattern, slope in zip(chosen_cells, colors, patterns, slopes):
   444	        pair = _construct_pair(boxes[cell_idx], color, pattern, slope)
   445	        if pair is None:
   446	            return None
   447	        pairs.append(pair)
   448	
   449	    inp = _render_input(shape, pairs)
   450	    expected = _expected_from_pairs(shape, pairs)
   451	    if not _semantic_validator(inp, expected):
   452	        return None
   453	    return inp
   454	
   455	
   456	def generate_input() -> np.ndarray:
   457	    for _ in range(GRID_ATTEMPTS):
   458	        grid = _gen_attempt()
   459	        if grid is not None:
   460	            return grid
   461	    raise RuntimeError("failed to generate a valid rotate-then-connect sample")

