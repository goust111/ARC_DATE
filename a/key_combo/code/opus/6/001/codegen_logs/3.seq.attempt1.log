+    )
+    assert len(candidates) == 1
+    candidate = candidates[0]
+    rot_pixels = set(bar1["rot_pixels"]) | set(bar2["rot_pixels"])
+    assert not (rot_pixels & set(candidate["path"]))
+    return candidate
