+
+        center2 = (
+            int(center1[0] + endpoint_side1 * half1 * axis1[0] + delta[0] - endpoint_side2 * half2 * axis2[0]),
+            int(center1[1] + endpoint_side1 * half1 * axis1[1] + delta[1] - endpoint_side2 * half2 * axis2[1]),
