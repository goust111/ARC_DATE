+    comps = _find_components(g, bg)
+    assert 4 <= len(comps) <= 8 and len(comps) % 2 == 0
+
+    bars = [_describe_input_bar(comp) for comp in comps]
+    by_color: dict[int, list[BarSpec]] = {}
+    for bar in bars:
