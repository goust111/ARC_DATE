+import numpy as np
+
+
+Coord = tuple[int, int]
+BarSpec = dict[str, object]
+PairSpec = dict[str, object]
+Box = tuple[int, int, int, int]
+
+
+BG = 0
+PAIR_COLORS = (1, 2, 3, 4)
+ODD_LENGTHS = (3, 5, 7)
+ORIENTATIONS = ("H", "V")
+PATTERN_CATALOG = (("H", "V"), ("V", "H"), ("H", "H"), ("V", "V"))
+CELL_SIZE_RANGE = (8, 11)
+OUTER_MARGIN_RANGE = (1, 2)
+CELL_GAP_RANGE = (2, 3)
+PAIR_COUNT_RANGE = (2, 4)
+PAIR_ATTEMPTS = 500
+GRID_ATTEMPTS = 300
