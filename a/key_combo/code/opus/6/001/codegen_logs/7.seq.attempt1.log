                if mask.sum()==desired:
                    break
        if AREA_MIN <= mask.sum() <= AREA_MAX and removed>0 and is_connected(mask) and not is_point_symmetric(mask):
            return mask
    return None

def bbox_far(a,b,pad=1):
    return a[2]+pad < b[0] or b[2]+pad < a[0] or a[3]+pad < b[1] or b[3]+pad < a[1]

def row_gap(a,b):
    if a[2] < b[0]: return b[0]-a[2]-1
    if b[2] < a[0]: return a[0]-b[2]-1
    return 0

def make_palette(w):
    k=random.randint(2, min(4,w))
    colors=random.sample(PALETTE_COLORS, k)
    row=np.array([random.choice(colors) for _ in range(w)], dtype=int)
    for color in colors:
        row[random.randrange(w)] = color
    random.shuffle(row)
    return row

def place(boxes, gh, gw, h, w, row_range=None):
    if row_range is None:
        rows=range(0, gh-h+1)
    else:
        lo,hi=row_range
        lo=max(0,lo); hi=min(gh-h,hi)
        if lo>hi: return None
        rows=range(lo, hi+1)
    cands=[]
    for r in rows:
        for c in range(0, gw-w+1):
            box=(r,c,r+h-1,c+w-1)
            if all(bbox_far(box,b,1) for b in boxes):
                cands.append((r,c,box))
    return random.choice(cands) if cands else None

def main(grid):
    g=np.asarray(grid,dtype=int)
    bg=get_bg(g)
    pal_mask=(g!=bg) & (g!=OBJ)
    pal_comps=components_mask(pal_mask)
    assert len(pal_comps)==1
    pb=bbox_coords(pal_comps[0]); assert pb[0]==pb[2]
    pal=g[pb[0], pb[1]:pb[3]+1]
    grey_comps=components_mask(g==OBJ)
    syms=[]
    for comp in grey_comps:
        b=bbox_coords(comp)
        h=b[2]-b[0]+1; w=b[3]-b[1]+1
        local=np.zeros((h,w),dtype=bool)
        rel=comp - np.array([b[0],b[1]])
        local[rel[:,0], rel[:,1]] = True
        if is_point_symmetric(local):
            syms.append((b,local))
    assert len(syms)==1
    b,local=syms[0]
    assert local.shape[1] == len(pal)
    out=np.zeros(local.shape,dtype=int)
    for j,color in enumerate(pal):
        out[local[:,j], j] = int(color)
    return out

def validate(grid):
    g=grid
    pb=bbox((g!=BG)&(g!=OBJ))
    comps=components_mask(g==OBJ)
    assert 3 <= len(comps) <= 5
    infos=[]
    for comp in comps:
        b=bbox_coords(comp)
        h,w=b[2]-b[0]+1, b[3]-b[1]+1
        local=np.zeros((h,w),dtype=bool)
        rel=comp-np.array([b[0],b[1]])
        local[rel[:,0], rel[:,1]]=True
        infos.append({'"'bbox':b,'area':int(local.sum()),'w':w,'sym':is_point_symmetric(local)})
    sym=[x for x in infos if x['sym']]
    assert len(sym)==1
    t=sym[0]
    ds=[x for x in infos if x is not t]
    assert any(d['w']==t['w'] for d in ds)
    assert any(d['w']"'!=t['"'w'] for d in ds)
    assert max(d['area'] for d in ds) >= t['area']
    assert any(row_gap(d['bbox'], pb) < row_gap(t['bbox'], pb) for d in ds)
    out=main(g)
    assert out.shape[1]==t['w']
    return True

