        while mask.sum() > desired and changed:
            changed=False
            random.shuffle(cells)
            for r,c in cells:
                if not mask[r,c] or mask.sum()-1 < desired:
                    continue
                cand=mask.copy(); cand[r,c]=False
                if bbox(cand)!=(0,0,h-1,w-1):
                    continue
