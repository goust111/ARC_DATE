+    box = bbox_coords(coords)
+    h = int(box[2] - box[0] + 1)
+    w = int(box[3] - box[1] + 1)
+    local = np.zeros((h, w), dtype=bool)
+    rel = coords - np.array([box[0], box[1]])
+    local[rel[:, 0], rel[:, 1]] = True
