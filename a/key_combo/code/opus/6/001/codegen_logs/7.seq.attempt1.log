def bbox_coords(coords):
    r0,c0=coords.min(axis=0)
    r1,c1=coords.max(axis=0)
    return int(r0),int(c0),int(r1),int(c1)

def bbox(mask):
    coords=np.argwhere(mask)
    return None if coords.size==0 else bbox_coords(coords)

def is_connected(mask):
    if not mask.any():
