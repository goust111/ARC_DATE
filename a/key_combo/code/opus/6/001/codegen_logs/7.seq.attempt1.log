+
+
+def neighbors4(r: int, c: int, shape: tuple[int, int]):
+    h, w = shape
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def components_mask(mask: np.ndarray) -> list[np.ndarray]:
+    mask = np.asarray(mask, dtype=bool)
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components: list[np.ndarray] = []
+
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            queue = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while queue:
+                rr, cc = queue.popleft()
+                coords.append((rr, cc))
+                for nr, nc in neighbors4(rr, cc, mask.shape):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+
+    return components
+
+
+def bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    return bbox_coords(coords)
+
+
+def crop_bbox(grid: np.ndarray, box: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = map(int, box)
+    return np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def bbox_w(box: tuple[int, int, int, int]) -> int:
+    return int(box[3] - box[1] + 1)
+
+
+def row_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> int:
+    if a[2] < b[0]:
+        return int(b[0] - a[2] - 1)
+    if b[2] < a[0]:
+        return int(a[0] - b[2] - 1)
+    return 0
+
+
+def bbox_far(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    pad: int = 1,
+) -> bool:
+    return (
+        a[2] + pad < b[0]
+        or b[2] + pad < a[0]
+        or a[3] + pad < b[1]
+        or b[3] + pad < a[1]
