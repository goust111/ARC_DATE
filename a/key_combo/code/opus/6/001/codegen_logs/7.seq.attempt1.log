def neighbors4(r,c,shape):
    h,w=shape
    if r>0: yield r-1,c
    if r+1<h: yield r+1,c
    if c>0: yield r,c-1
    if c+1<w: yield r,c+1

def components_mask(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    comps=[]
    for r in range(h):
        for c in range(w):
            if not mask[r,c] or seen[r,c]:
                continue
            q=deque([(r,c)])
            seen[r,c]=True
            coords=[]
            while q:
                rr,cc=q.popleft()
                coords.append((rr,cc))
                for nr,nc in neighbors4(rr,cc,mask.shape):
