    return len(components_mask(mask))==1

def is_point_symmetric(mask):
    return np.array_equal(mask, mask[::-1, ::-1])

def orbits(h,w):
    seen=set(); out=[]
    for r in range(h):
        for c in range(w):
            pair=tuple(sorted({(r,c),(h-1-r,w-1-c)}))
            if pair not in seen:
                seen.add(pair)
                out.append(list(pair))
    return out

def make_symmetric_mask(width=None):
    for _ in range(400):
