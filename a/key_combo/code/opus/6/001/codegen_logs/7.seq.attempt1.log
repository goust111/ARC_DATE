                mask=cand
                removed+=k
                changed=True
                if mask.sum() == desired:
                    break
        if AREA_MIN <= mask.sum() <= AREA_MAX and removed > 0 and is_point_symmetric(mask) and is_connected(mask):
            return mask
    return None

def make_nonsymmetric_mask(width=None, area_min=AREA_MIN, area_max=AREA_MAX):
    for _ in range(600):
        if width is None:
            w = random.randint(3, 7)
        else:
