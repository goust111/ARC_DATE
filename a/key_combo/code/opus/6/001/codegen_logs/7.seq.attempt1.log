+def _place_bbox(
+    blocked: list[tuple[int, int, int, int]],
+    grid_h: int,
+    grid_w: int,
+    patch_h: int,
+    patch_w: int,
+    row_band: tuple[int, int] | None = None,
+) -> tuple[int, int, tuple[int, int, int, int]] | None:
+    if row_band is None:
