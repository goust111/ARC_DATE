            if np.any(patch_mask & (grid[r : r + h, c : c + w] != bg)):
                continue
            candidates.append((r, c, box))
    if not candidates:
        return None
    r, c, box = random.choice(candidates)
    paste(grid, patch, r, c, transparent=bg)
    placed.append(box)
    return box


