+    top = random.choice([True, False])
+    left = random.choice([True, False])
+    strip_r = 0 if top else h - strip_h
+    strip_c = 0 if left else w - strip_w
+    legend_box = (strip_r, strip_c, strip_r + strip_h - 1, strip_c + strip_w - 1)
