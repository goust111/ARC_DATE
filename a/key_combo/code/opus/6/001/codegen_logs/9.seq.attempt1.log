+        changed += int(np.count_nonzero(out_inner != grid[r0 + 1 : r0 + 6, c0 + 1 : c0 + 6]))
+        fill_colors = sorted(set(map(int, out_inner[grid[r0 + 1 : r0 + 6, c0 + 1 : c0 + 6] == BG].tolist())))
+        if len(fill_colors) < 3:
