+            for i in range(len(side_colors))
+            for j in range(i + 1, len(side_colors))
+        )
+        if not (same_color_diff_side and same_side_diff_color):
+            return False
+    else:
+        if not (len(set(side_colors)) == 3 and len(set(touched_sides)) < 3):
+            return False
+
+    return True
+
