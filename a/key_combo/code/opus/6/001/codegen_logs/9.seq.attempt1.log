+    meta = {"legends": legends, "panels": panels_meta}
+    expected = _expected_from_meta(grid, meta)
+    if not _semantic_ok(grid, expected, meta):
+        return None
+    if not np.array_equal(main(grid), expected):
+        return None
+    return grid
