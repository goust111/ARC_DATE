+def _replace_color(color: int, rules: list[tuple[int, int]]) -> tuple[int, int]:
+    current = int(color)
+    changes = 0
+    for left, right in rules:
+        if current == int(left):
+            current = int(right)
+            changes += 1
+    return current, changes
