+def _apply_chain_to_patch(patch: np.ndarray, rules: list[tuple[int, int]]) -> tuple[np.ndarray, int]:
+    out = patch.copy()
+    max_changes = 0
+    for dr, dc in RING_CELLS:
+        out[dr, dc], changes = _replace_color(int(out[dr, dc]), rules)
