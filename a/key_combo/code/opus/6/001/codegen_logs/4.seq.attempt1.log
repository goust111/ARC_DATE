+                    if 0 <= nr < h and 0 <= nc < w and bool(mask[nr, nc]) and not bool(seen[nr, nc]):
+                        seen[nr, nc] = True
+                        queue.append((nr, nc))
+            comps.append(
+                {
+                    "coords": coords,
+                    "bbox": _bbox_from_coords(coords),
+                    "area": len(coords),
+                }
