+
+
+def _random_ring_values(pool: list[int]) -> list[int]:
+    palette_size = random.randint(2, min(4, len(pool)))
+    palette = random.sample(pool, palette_size)
+    values = [random.choice(palette) for _ in range(8)]
+    if len(set(values)) < 2:
