+                    "glyph": glyph,
+                    "line": line,
+                    "line_after_gap": line_after_gap,
+                    "marker_a": marker_a,
+                    "marker_b": marker_b,
+                    "visible_markers": sorted(visible_markers),
+                    "hidden_noise": hidden_noise,
+                    "input_cells": sorted(input_cells),
+                    "noise_cells": sorted(set(gap_noise) | set(hidden_noise)),
