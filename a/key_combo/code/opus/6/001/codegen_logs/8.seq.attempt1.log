+        ends: list[int] = []
+        prev = int(rows[0])
+        for r in rows[1:]:
+            r = int(r)
+            if r == prev + 1:
+                prev = r
+            else:
+                ends.append(prev)
+                starts.append(r)
+                prev = r
+        ends.append(prev)
+        for end0, start1 in zip(ends, starts[1:]):
+            gap0 = end0 + 1
+            gap1 = start1 - 1
