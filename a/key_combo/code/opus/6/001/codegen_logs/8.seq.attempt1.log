+        mask = top == int(color)
+        if not mask.any():
+            continue
+        comps = _components(mask, connectivity=4)
+        assert len(comps) == 1
+        bbox = _bbox_from_coords(comps[0])
+        patch = _crop_bbox(top, bbox)
+        assert patch.shape[0] in (3, 5) and patch.shape[1] in (3, 5)
+        assert patch.shape[0] % 2 == 1 and patch.shape[1] % 2 == 1
