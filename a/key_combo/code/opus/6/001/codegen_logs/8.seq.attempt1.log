+def _place_templates(
+    grid: np.ndarray,
+    chosen: list[tuple[int, int, np.ndarray]],
+    mid: int,
+) -> list[tuple[int, int, int, int]]:
+    placed: list[tuple[int, int, int, int]] = []
+    for color, _idx, glyph in chosen:
+        gh, gw = glyph.shape
+        candidates = []
