+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _diag_neighbors(r: int, c: int):
+    yield r - 1, c - 1
+    yield r - 1, c + 1
+    yield r + 1, c - 1
+    yield r + 1, c + 1
