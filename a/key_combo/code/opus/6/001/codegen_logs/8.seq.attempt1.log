+def _components(mask: np.ndarray, *, connectivity: int = 4) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    h, w = mask.shape
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
