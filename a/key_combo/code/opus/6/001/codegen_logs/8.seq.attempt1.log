+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= int(r) < h and 0 <= int(c) < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _diag_neighbors(r: int, c: int):
+    yield r - 1, c - 1
+    yield r - 1, c + 1
+    yield r + 1, c - 1
+    yield r + 1, c + 1
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop_bbox(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _paste(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int, *, transparent: int = BG) -> None:
+    h, w = patch.shape
+    assert 0 <= r0 and 0 <= c0 and r0 + h <= dst.shape[0] and c0 + w <= dst.shape[1]
+    if transparent == BG:
+        mask = patch != BG
+        dst[r0 : r0 + h, c0 : c0 + w][mask] = patch[mask]
+    else:
+        dst[r0 : r0 + h, c0 : c0 + w] = patch
+
+
+def _components(mask: np.ndarray, *, connectivity: int = 4) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    h, w = mask.shape
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                if connectivity == 4:
+                    nbrs = _neighbors4(rr, cc)
+                else:
