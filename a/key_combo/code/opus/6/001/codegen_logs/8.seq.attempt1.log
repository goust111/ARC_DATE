+
+
+def _expected_markers(line: dict[str, int]) -> tuple[tuple[int, int], tuple[int, int]]:
+    if line["orientation"] == "H":
+        r = int(line["r"])
+        c0 = int(line["c0"])
+        c1 = int(line["c1"])
+        return (r - 1, c0 - 1), (r + 1, c1 + 1)
+    c = int(line["c"])
+    r0 = int(line["r0"])
+    r1 = int(line["r1"])
