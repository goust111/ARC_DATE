+        if rows.size < 2:
+            continue
+        starts = [int(rows[0])]
+        ends: list[int] = []
+        prev = int(rows[0])
+        for r in rows[1:]:
+            r = int(r)
+            if r == prev + 1:
+                prev = r
+            else:
+                ends.append(prev)
+                starts.append(r)
+                prev = r
+        ends.append(prev)
+        for end0, start1 in zip(ends, starts[1:]):
+            gap0 = end0 + 1
+            gap1 = start1 - 1
+            if gap1 < gap0 or gap1 - gap0 + 1 > span:
+                continue
+            rr0 = max(work_r0, gap0 - 1)
+            rr1 = min(h - 1, gap1 + 1)
+            cc0 = max(1, c - 1)
+            cc1 = min(w - 2, c + 1)
