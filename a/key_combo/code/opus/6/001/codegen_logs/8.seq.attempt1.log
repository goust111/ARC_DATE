+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _diag_neighbors(r: int, c: int):
+    yield r - 1, c - 1
+    yield r - 1, c + 1
+    yield r + 1, c - 1
+    yield r + 1, c + 1
