+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                if connectivity == 4:
+                    nbrs = _neighbors4(rr, cc)
+                else:
