+                (
+                    _manhattan(sprite["connector"], other["connector"]),
+                    tuple(map(int, other["bbox"][:2])),
+                    other["id"],
+                )
+            )
+        distances.sort()
+        if not distances:
+            return False
+        nearest_mismatch |= distances[0][2] != sprite["partner"]
