+
+from arc_utils import bbox_coords, find_components, get_bg, in_bounds, neighbors4
+
+
+BG = 0
+MARKER_COLORS = (1, 2, 3)
+CONNECTOR = 5
+SPRITE = 8
+SIDES = ("up", "down", "left", "right")
+OPPOSITE = {"up": "down", "down": "up", "left": "right", "right": "left"}
+SIDE_STEP = {"up": (-1, 0), "down": (1, 0), "left": (0, -1), "right": (0, 1)}
