+def _scene_is_non_degenerate(scene: dict) -> bool:
+    sprites = scene["sprites"]
+    pairs = scene["pairs"]
+
+    side_counts: dict[str, int] = {}
+    for pair in pairs:
+        side_counts[pair["base_side"]] = side_counts.get(pair["base_side"], 0) + 1
+    if max(side_counts.values()) < 2:
+        return False
