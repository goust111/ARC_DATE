+        assert len(touched) == 1
+        sprite_id = next(iter(touched))
+        assert sprite_id not in sprite_marker
+        sprite_marker[sprite_id] = (rr, cc, int(g[rr, cc]))
+    assert len(sprite_marker) == len(sprites)
