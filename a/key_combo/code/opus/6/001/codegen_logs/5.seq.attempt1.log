+    c0 = min(c for _, c in coords)
+    norm = tuple(sorted((r - r0, c - c0) for r, c in coords))
+    return norm, (connector[0] - r0, connector[1] - c0)
+
+
+def _shape_bbox(coords: tuple[tuple[int, int], ...]) -> tuple[int, int, int, int]:
