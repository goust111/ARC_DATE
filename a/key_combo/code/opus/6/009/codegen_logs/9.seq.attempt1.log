"""Generator for ARC-AGI-2 task 898e7135.

Output-first strategy:
  1. Build a hole/wall layout of 4-conn slots (8-separated, includes unit slots).
  2. For each slot, pick a distinct color + dihedral transform; upscale slot mask
     by k to get the piece sprite (solid k*k blocks).
  3. Assemble the frame (layout + 1-cell border of frame_color).
  4. Scatter pieces outside the frame on a bg=0 canvas, plus single-pixel
     distractor noise in a fresh color.

The generator validates main(input) == expected_output before returning.
"""

import random
import numpy as np

from arc_utils import paste, random_free_location

# --- tunables ----------------------------------------------------------------

K_CHOICES = [2, 3]                  # block scale factor
LAYOUT_H_RANGE = (4, 12)           # inner layout rows
LAYOUT_W_RANGE = (4, 8)            # inner layout cols
N_SLOTS_RANGE = (3, 6)             # total slot count (incl. unit)
N_UNITS_MAX = 2                    # max unit-slot count per example
NON_UNIT_SIZE_CHOICES = [2, 3, 4, 5, 6, 7]  # area of non-unit slots

HOLE_DENSITY_RANGE = (0.20, 0.50)  # valid hole fraction of layout area
UNIT_SLOT_RETRIES = 20             # attempts per unit slot placement
NON_UNIT_SLOT_RETRIES = 30         # attempts per non-unit slot placement
GROW_SEED_TRIES = 8                # random seed cells tried per _grow_slot call

CANVAS_DIM_RANGE = (15, 30)        # min/max for canvas height and width
AREA_BUFFER_MULT = 4               # multiplier on piece area for canvas sizing
AREA_BUFFER_CONST = 50             # additive constant for canvas area budget

DISTRACTOR_RANGE = (8, 13)         # singleton distractor pixel count
DISTRACTOR_RETRY_MULT = 10         # retry multiplier for distractor placement
MIN_DISTRACTORS = 8                # minimum placed distractors to accept

GENERATE_MAX_RETRIES = 300         # outer retry limit in generate_input


# --- layout generation -------------------------------------------------------

def _canonical_shape_key(mask: np.ndarray) -> bytes:
    """Canonical bytes representation under D4 for a bool mask (tight-cropped)."""
    variants = []
    for kk in range(4):
        r = np.rot90(mask, kk)
        variants.append(r.tobytes() + bytes([r.shape[0], r.shape[1]]))
        fr = np.fliplr(r)
        variants.append(fr.tobytes() + bytes([fr.shape[0], fr.shape[1]]))
    return min(variants)


def _grow_slot(forbidden: np.ndarray, target_size: int) -> np.ndarray | None:
    """Grow a 4-conn slot of given size starting from a random free cell.
    `forbidden` marks cells that must not be used. Returns coords array or None.
    """
    H, W = forbidden.shape
    free_cells = np.argwhere(~forbidden)
    if free_cells.size == 0:
        return None
    random.shuffle(free_cells)
    for start in free_cells[:GROW_SEED_TRIES]:
        r0, c0 = int(start[0]), int(start[1])
        chosen = {(r0, c0)}
        frontier = {(r0 - 1, c0), (r0 + 1, c0), (r0, c0 - 1), (r0, c0 + 1)}
        while len(chosen) < target_size and frontier:
            cands = [p for p in frontier if 0 <= p[0] < H and 0 <= p[1] < W
                     and not forbidden[p[0], p[1]] and p not in chosen]
            if not cands:
                break
            nr, nc = random.choice(cands)
            chosen.add((nr, nc))
            frontier.discard((nr, nc))
            frontier.update({(nr - 1, nc), (nr + 1, nc), (nr, nc - 1), (nr, nc + 1)})
        if len(chosen) == target_size:
            return np.array(sorted(chosen))
    return None


def _dilate8(mask: np.ndarray) -> np.ndarray:
    """Dilate a bool mask by 1 cell (8-connectivity)."""
from __future__ import annotations

import numpy as np

from arc_utils import bbox_h, bbox_w, crop_bbox, find_components, get_bg, paste
import random

BBox = tuple[int, int, int, int]


def _intersects(a: BBox, b: BBox) -> bool:
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _solid_rectangles(g: np.ndarray, bg: int, color: int) -> list[dict]:
    rectangles: list[dict] = []
    for comp in find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[color],
        return_format="dict",
    ):
        h = bbox_h(comp["bbox"])
        w = bbox_w(comp["bbox"])
        if int(comp["area"]) > 1 and int(comp["area"]) == h * w:
            rectangles.append(comp)
    return rectangles


def _find_sprites(g: np.ndarray, bg: int) -> list[tuple[BBox, np.ndarray, int]]:
    sprites: list[tuple[BBox, np.ndarray, int]] = []
    for comp in find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=False,
        return_format="dict",
    ):
        b = comp["bbox"]
        if bbox_h(b) != 3 or bbox_w(b) != 3 or int(comp["area"]) != 9:
            continue

        patch = crop_bbox(g, b)
        border = np.ones((3, 3), dtype=bool)
        border[1, 1] = False
        border_colors = set(map(int, patch[border]))
        if len(border_colors) != 1:
            continue

        body = border_colors.pop()
        center = int(patch[1, 1])
        if body == bg or center == bg or body == center:
            continue
        sprites.append((b, patch, center))

    return sprites


def _direction_to_target(sprite: BBox, target: BBox) -> tuple[int, int]:
    r0, c0, r1, c1 = sprite
    tr0, tc0, tr1, tc1 = target
    row_overlap = not (r1 < tr0 or tr1 < r0)
    col_overlap = not (c1 < tc0 or tc1 < c0)

    directions: list[tuple[int, int]] = []
    if row_overlap and tc0 > c1:
        directions.append((0, 1))
    if row_overlap and tc1 < c0:
        directions.append((0, -1))
    if col_overlap and tr0 > r1:
        directions.append((1, 0))
    if col_overlap and tr1 < r0:
        directions.append((-1, 0))

    assert len(directions) == 1, "expected exactly one cardinal target direction"
    return directions[0]


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repeat each 3x3 control-center sprite toward the matching solid rectangle until a copy first overlaps that rectangle.

    Input structure
    - The background is the dominant color.
    - Each sprite is a 3x3 foreground object whose eight border pixels have one color and whose center has a different control color.
    - For every control color, there is exactly one separate solid rectangular object of that color.

    Rule
    - Match each sprite to the unique solid rectangle whose color equals the sprite center.
    - Copy the whole 3x3 sprite in the cardinal direction of that rectangle, stepping by three cells each time.
    - Stop after pasting the first copy whose 3x3 bbox overlaps the rectangle; copied pixels overwrite the rectangle there.

    Key insight
    The center pixel is not the paint color: it is a destination key, while the entire 3x3 sprite is the motif tiled along the straight path.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    h, w = g.shape
    assert h >= 3 and w >= 3

    bg = int(get_bg(g))
    sprites = _find_sprites(g, bg)
    assert sprites, "expected at least one 3x3 control-center sprite"

    out = g.copy()
    for sprite_bbox, patch, center in sprites:
        targets = _solid_rectangles(g, bg, center)
        assert len(targets) == 1, "each control color must have one solid rectangular target"
        target_bbox = targets[0]["bbox"]
        assert not _intersects(sprite_bbox, target_bbox), "sprite and target must start separate"

        dr, dc = _direction_to_target(sprite_bbox, target_bbox)
        r, c = sprite_bbox[0], sprite_bbox[1]

        while True:
            current_bbox = (r, c, r + 2, c + 2)
            assert 0 <= r and r + 3 <= h and 0 <= c and c + 3 <= w
            paste(out, patch, r, c)

            if _intersects(current_bbox, target_bbox):
                break

            r += dr * 3
            c += dc * 3

    return out

# --------------- generator (att1) ---------------
# Canvas and colors.
BG_COLOR, COLOR_COUNT = 8, 10
GRID_MIN_SIZE, GRID_MAX_SIZE = 20, 25

# Rectangles.
RECT_COUNT_MIN, RECT_COUNT_MAX = 2, 4
RECT_SIDE_MIN, RECT_SIDE_MAX = 2, 14
RECT_MARGIN, RECT_SPACING_PAD = 1, 5
RECT_PLACEMENT_ATTEMPTS = 50

# Sprites and paths.
SPRITE_SIZE, SPRITE_TOTAL_MAX = 3, 5
SPRITE_GAPS = [1, 4, 7, 10]
DIRECTIONS = [(0, 1), (0, -1), (1, 0), (-1, 0)]

# Retry limits.
GENERATION_ATTEMPTS = 300


def _intersects_check(a, b):
    return not (a[2] < b[0] or b[2] < a[0] or a[3] < b[1] or b[3] < a[1])


def _has_bg_border(grid, sr, sc, bg):
    H, W = grid.shape
    for r in range(sr, sr + SPRITE_SIZE):
        for c in range(sc, sc + SPRITE_SIZE):
            for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < H and 0 <= nc < W:
                    if not (sr <= nr < sr + SPRITE_SIZE and sc <= nc < sc + SPRITE_SIZE):
                        if grid[nr, nc] != bg:
                            return False
    return True


def _sample_palette(bg):
    all_colors = [c for c in range(COLOR_COUNT) if c != bg]
    random.shuffle(all_colors)
    num_rects = random.randint(RECT_COUNT_MIN, RECT_COUNT_MAX)
    body_color = all_colors[0]
    target_colors = all_colors[1:1 + num_rects]
    return body_color, target_colors


def _rect_has_spacing(rect, rects, pad):
    r0, c0, r1, c1 = rect
    for rr0, rc0, rr1, rc1, _ in rects:
        if not (r1 + pad < rr0 or rr1 + pad < r0 or c1 + pad < rc0 or rc1 + pad < c0):
            return False
    return True


def _place_rectangles(grid, target_colors):
    H, W = grid.shape
    rects = []
    for color in target_colors:
        for _ in range(RECT_PLACEMENT_ATTEMPTS):
            rh = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, H - 4))
            rw = random.randint(RECT_SIDE_MIN, min(RECT_SIDE_MAX, W - 4))
            r0 = random.randint(RECT_MARGIN, H - rh - RECT_MARGIN)
            c0 = random.randint(RECT_MARGIN, W - rw - RECT_MARGIN)
            r1 = r0 + rh - 1
            c1 = c0 + rw - 1
            if _rect_has_spacing((r0, c0, r1, c1), rects, RECT_SPACING_PAD):
                rects.append((r0, c0, r1, c1, color))
                break
        else:
            return None
    for (r0, c0, r1, c1, color) in rects:
        grid[r0:r1 + 1, c0:c1 + 1] = color
    return rects


def _assign_sprites(rects):
    num_rects = len(rects)
    sprite_assignments = []
    for i, (_, _, _, _, color) in enumerate(rects):
        sprite_assignments.append((i, color))
    max_extra = min(SPRITE_TOTAL_MAX - len(sprite_assignments), num_rects)
    if max_extra > 0:
        extra = random.randint(0, max_extra)
        for _ in range(extra):
            i = random.randint(0, num_rects - 1)
            sprite_assignments.append((i, rects[i][4]))
    if len(sprite_assignments) > SPRITE_TOTAL_MAX:
        sprite_assignments = sprite_assignments[:SPRITE_TOTAL_MAX]
    return sprite_assignments


from itertools import product
from collections import defaultdict

import numpy as np

from arc_utils import find_components, get_bg, paste, random_free_location
import random


QUADS = ((0, 0), (0, 1), (1, 0), (1, 1))


def _record_components(g: np.ndarray, bg: int) -> list[dict]:
    comps = []
    for idx, comp in enumerate(
        find_components(g, bg=bg, connectivity=8, monochromatic=True)
    ):
        r0, c0, r1, c1 = comp["bbox"]
        comps.append(
            {
                **comp,
                "id": idx,
                "h": r1 - r0 + 1,
                "w": c1 - c0 + 1,
                "cr2": r0 + r1,
                "cc2": c0 + c1,
            }
        )
    return comps


def _bbox(comp: dict) -> tuple[int, int, int, int]:
    return comp["bbox"]


def _aligned_markers(markers: tuple[dict, dict, dict, dict]) -> bool:
    bnw, bne, bsw, bse = map(_bbox, markers)
    return (
        (bnw[0], bnw[2]) == (bne[0], bne[2])
        and (bsw[0], bsw[2]) == (bse[0], bse[2])
        and (bnw[1], bnw[3]) == (bsw[1], bsw[3])
        and (bne[1], bne[3]) == (bse[1], bse[3])
        and bnw[2] < bsw[0]
        and bne[2] < bse[0]
        and bnw[3] < bne[1]
        and bsw[3] < bse[1]
    )


def _is_cluster(center: dict, markers: tuple[dict, dict, dict, dict]) -> bool:
    nw, ne, sw, _ = markers
    if not _aligned_markers(markers):
        return False

    r0, c0, r1, c1 = _bbox(center)
    outer_r0 = min(_bbox(marker)[0] for marker in markers)
    outer_c0 = min(_bbox(marker)[1] for marker in markers)
    outer_r1 = max(_bbox(marker)[2] for marker in markers)
    outer_c1 = max(_bbox(marker)[3] for marker in markers)

    return (
        outer_r0 <= r0 <= r1 <= outer_r1
        and outer_c0 <= c0 <= c1 <= outer_c1
        and nw["cr2"] < center["cr2"] < sw["cr2"]
        and nw["cc2"] < center["cc2"] < ne["cc2"]
    )


def main(grid: np.ndarray) -> np.ndarray:
    """Extract the central object from the marker cluster whose markers have the same color.

    Input structure
    The grid has a dominant background and several clusters; each cluster has four
    same-color corner marker objects around one central monochromatic object.
    Rule
    Find every central object enclosed by four aligned corner markers of one color,
    then choose the unique one whose object color equals the marker color.
    Key insight
    The answer is not the largest or most frequent object; it is the center of the
    self-colored cluster, cropped to that object's bounding box with background kept.
    """
    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    comps = _record_components(g, bg)

    targets = {}
    for center in comps:
        by_marker_role = defaultdict(lambda: defaultdict(list))
        for marker in comps:
            if marker["id"] == center["id"]:
                continue
            if marker["cr2"] == center["cr2"] or marker["cc2"] == center["cc2"]:
                continue
            quad = (
                0 if marker["cr2"] < center["cr2"] else 1,
                0 if marker["cc2"] < center["cc2"] else 1,
            )
            key = (marker["color"], marker["area"], marker["h"], marker["w"])
            by_marker_role[key][quad].append(marker)

        for key, markers_by_quad in by_marker_role.items():
            if not all(quad in markers_by_quad for quad in QUADS):
                continue
            for markers in product(*(markers_by_quad[quad] for quad in QUADS)):
                if len({marker["id"] for marker in markers}) != 4:
                    continue
                if _is_cluster(center, markers) and center["color"] == key[0]:
                    targets[center["id"]] = center

    assert len(targets) == 1
    target = next(iter(targets.values()))
    r0, c0, r1, c1 = _bbox(target)
    out = g[r0 : r1 + 1, c0 : c1 + 1].copy()
    assert np.all((out == bg) | (out == target["color"]))
    return out

# --------------- generator (att2) ---------------

# Canvas, palette, and placement.
GRID_SHAPE = (30, 30)
COLOR_COUNT = 10
PLACEMENT_BORDER = 1

# Cluster structure and shared center bbox ranges.
MARKER_SIZES = (2, 3)
CENTER_BOUNDS_BY_MARKER = {
    2: ((2, 4), (2, 5)),
    3: ((3, 4), (3, 5)),
}
CLUSTER_COUNT_RANGE = (4, 6)
CENTER_OFFSET = 2

# Center sprite area and retry bounds.
MIN_CENTER_AREA = 3
MAX_CENTER_AREA = 14
GEN_ATTEMPTS = 300


def _gen_l_marker(marker_size: int, color: int, bg: int) -> np.ndarray:
    marker = np.full((marker_size, marker_size), bg, dtype=int)
    marker[0, :] = color
    marker[:, 0] = color
    return marker


def _gen_center_mask(height: int, width: int, area: int) -> np.ndarray:
    mask = np.zeros((height, width), dtype=bool)
    if random.randrange(2):
        r, c, end_r, end_c = 0, 0, height - 1, width - 1
    else:
        r, c, end_r, end_c = 0, width - 1, height - 1, 0

    mask[r, c] = True
    while (r, c) != (end_r, end_c):
        if r < end_r:
            r += 1
        elif r > end_r:
            r -= 1
        if c < end_c:
            c += 1
        elif c > end_c:
            c -= 1
        mask[r, c] = True

    while int(mask.sum()) < area:
        candidates = set()
        for rr, cc in np.argwhere(mask):
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    nr, nc = int(rr) + dr, int(cc) + dc
                    if 0 <= nr < height and 0 <= nc < width and not mask[nr, nc]:
                        candidates.add((nr, nc))
        nr, nc = random.choice(tuple(candidates))
        mask[nr, nc] = True
    return mask


def _gen_center_patch(height: int, width: int, color: int, bg: int) -> np.ndarray:
    min_area = max(MIN_CENTER_AREA, height, width)
    max_area = min(MAX_CENTER_AREA, height * width - 1)
    area = random.randint(min_area, max_area)
    patch = np.full((height, width), bg, dtype=int)
    patch[_gen_center_mask(height, width, area)] = color
    return patch


def _gen_cluster_patch(
    marker_size: int,
    center_height: int,
    center_width: int,
    marker_color: int,
    center_color: int,
    bg: int,
) -> tuple[np.ndarray, np.ndarray]:
    overlap = marker_size - 2
    center_r0 = CENTER_OFFSET
    center_c0 = CENTER_OFFSET
    bottom_r0 = center_r0 + center_height - overlap
    right_c0 = center_c0 + center_width - overlap
    patch = np.full((bottom_r0 + marker_size, right_c0 + marker_size), bg, dtype=int)

    marker = _gen_l_marker(marker_size, marker_color, bg)
    paste(patch, marker, 0, 0, transparent=bg)
    paste(patch, np.fliplr(marker), 0, right_c0, transparent=bg)
    paste(patch, np.flipud(marker), bottom_r0, 0, transparent=bg)
    paste(patch, np.flipud(np.fliplr(marker)), bottom_r0, right_c0, transparent=bg)

    center = _gen_center_patch(center_height, center_width, center_color, bg)
    paste(patch, center, center_r0, center_c0, transparent=bg)
    return patch, center


def _place_cluster_patches(patches: list[np.ndarray], bg: int) -> np.ndarray | None:
    grid = np.full(GRID_SHAPE, bg, dtype=int)
    occupied = np.zeros(GRID_SHAPE, dtype=int)
    n_clusters = len(patches)
    order = list(range(n_clusters))
    random.shuffle(order)

