+def _column_groups(mask: np.ndarray) -> list[tuple[int, int]]:
+    cols = np.where(mask.any(axis=0))[0]
+    if cols.size == 0:
+        return []
+    groups = []
+    start = int(cols[0])
+    prev = int(cols[0])
+    for col in cols[1:]:
+        col = int(col)
+        if col != prev + 1:
+            groups.append((start, prev))
+            start = col
+        prev = col
+    groups.append((start, prev))
+    return groups
