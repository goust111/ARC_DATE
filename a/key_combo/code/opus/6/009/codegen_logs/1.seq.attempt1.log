+    mask_a, mask_b = _pick_templates(rng, k)
+
+    max_side = 30 // k
+    m = rng.randint(3, min(5, max_side))
+    n = rng.randint(3, min(5, max_side))
+    color1, color2 = rng.sample(PALETTE, 2)
