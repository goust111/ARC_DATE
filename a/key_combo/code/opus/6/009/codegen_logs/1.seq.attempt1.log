+    even_uses_first_color = (_GEN_COUNTER % 2) == 1
+
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt(rng, forced_k, even_uses_first_color)
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after retries")

