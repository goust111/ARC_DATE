+def _paste_template(grid: np.ndarray, mask: np.ndarray, top: int, left: int) -> None:
+    patch = np.where(mask, MASK_COLOR, BG)
+    grid[top : top + patch.shape[0], left : left + patch.shape[1]] = patch
+
