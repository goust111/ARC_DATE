+    if not np.array_equal(parsed, expected):
+        return False
+    if np.array_equal(expected, _render(board, mask_b, mask_a)):
+        return False
+    if np.array_equal(expected, _render(board, mask_a, mask_a)):
+        return False
+    if np.array_equal(expected, _render(board, mask_b, mask_b)):
+        return False
