+        return False
+    if np.array_equal(expected, _render(board, mask_a, mask_a)):
+        return False
+    if np.array_equal(expected, _render(board, mask_b, mask_b)):
+        return False
+
+    solid = np.kron(board, np.ones(mask_a.shape, dtype=int))
+    if np.array_equal(expected, solid):
