+def _base_masks(k: int) -> list[np.ndarray]:
+    rr, cc = np.indices((k, k))
+    mid = k // 2
+    masks = [
+        rr == cc,
+        rr + cc == k - 1,
+        (rr == cc) | (rr + cc == k - 1),
+        (rr == 0) | (cc == 0),
+        (rr == 0) | (cc == mid),
+        (rr == mid) | (cc == mid),
+        (rr == 0) | (rr == k - 1) | (cc == 0) | (cc == k - 1),
+        cc <= rr,
+        cc >= rr,
+        (rr + cc) % 2 == 0,
+        (rr + cc) % 2 == 1,
+    ]
+    if k == 4:
+        masks.extend(
+            [
+                (rr <= 1) | (cc >= 2),
+                (rr >= 1) | (cc == 0),
+                ((rr == 1) | (rr == 2) | (cc == 1)),
+            ]
+        )
+    return [mask.astype(bool) for mask in masks]
