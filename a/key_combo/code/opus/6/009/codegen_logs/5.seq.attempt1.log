+def _paint_rays(shape: tuple[int, int], horiz_rows: list[int], vert_cols: list[int]) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.full((h, w), BG, dtype=int)
+    for r in horiz_rows:
+        out[int(r), :] = RAY
+    for c in vert_cols:
+        out[:, int(c)] = RAY
+    return out
+
