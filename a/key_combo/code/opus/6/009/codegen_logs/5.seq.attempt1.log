+    bottom = [(h - 1, c) for c in range(1, w - 1) if int(grid[h - 1, c]) == RAY]
+    left = [(r, 0) for r in range(1, h - 1) if int(grid[r, 0]) == RAY]
+    right = [(r, w - 1) for r in range(1, h - 1) if int(grid[r, w - 1]) == RAY]
+
+    markers = top + bottom + left + right
