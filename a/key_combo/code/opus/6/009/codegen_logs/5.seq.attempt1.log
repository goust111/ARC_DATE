+    best = np.full((h, w), h + w + 10, dtype=int)
+    for sr, sc in seeds:
+        best = np.minimum(best, np.abs(rr - int(sr)) + np.abs(cc - int(sc)))
+    non_ray = ~ray_mask
+    out[non_ray] = np.take(np.array(PALETTE, dtype=int), best[non_ray] % len(PALETTE))
+    out[ray_mask] = RAY
+    return out
