+    markers, horiz_rows, vert_cols = _validate_input_structure(grid)
+    ray_grid = _paint_rays(grid.shape, horiz_rows, vert_cols)
+    return _distance_colors(grid.shape, markers, ray_grid == RAY)
+
+
