+    ray_mask: np.ndarray,
+) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.full((h, w), BG, dtype=int)
+    rr, cc = np.indices((h, w))
+    best = np.full((h, w), h + w + 10, dtype=int)
+    for sr, sc in seeds:
