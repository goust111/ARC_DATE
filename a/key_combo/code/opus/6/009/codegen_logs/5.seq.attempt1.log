+            for n_vert in range(1, min(4, total - 1) + 1)
+            if 1 <= total - n_vert <= 4
+        ]
+        n_vert, n_horiz = rng.choice(possible_splits)
+        if n_vert == 1 or n_horiz == 1:
+            if rng.random() < 0.6:
+                continue
+
+        cols = _sample_positions(w, n_vert, rng)
+        rows = _sample_positions(h, n_horiz, rng)
