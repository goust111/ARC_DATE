+        for r in left_rows:
+            grid[int(r), 0] = RAY
+        for r in right_rows:
+            grid[int(r), w - 1] = RAY
+
+        if _is_semantically_valid(grid):
+            return grid
+
+    raise RuntimeError("generate_input: failed to build a valid ray-intersection distance-field task")

