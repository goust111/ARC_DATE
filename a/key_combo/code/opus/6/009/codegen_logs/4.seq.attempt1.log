+            dt, dl, db, dr = [rng.randint(3, 4) for _ in range(4)]
+            nxt = (prev[0] + dt, prev[1] + dl, prev[2] - db, prev[3] - dr)
+            if nxt[2] - nxt[0] + 1 < 7 or nxt[3] - nxt[1] + 1 < 7:
+                ok = False
+                break
+            frames.append(nxt)
