+
+
+def build_repaired_grid(h: int, w: int, frames: list[BBox], gaps: list[dict]) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    for bbox in frames:
+        for r, c in border_cells(bbox):
+            grid[r, c] = FRAME
