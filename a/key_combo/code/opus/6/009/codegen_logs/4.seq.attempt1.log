+            marker = (edge_r, c0 - 1) if side == "left" else (edge_r, c1 + 1)
+        gaps.append(
+            {
+                "bbox": bbox,
+                "side": side,
+                "length": length,
+                "cells": cells,
+                "marker": marker,
+                "marker_at_end": marker_at_end,
+            }
+        )
+    return gaps
