+                    break
+            if too_close:
+                continue
+            red_abs = (top + red_local[0], left + red_local[1])
+            dists = sorted(
+                ((abs(red_abs[0] - mr) + abs(red_abs[1] - mc), idx) for idx, (mr, mc) in enumerate(target_markers)),
+                key=lambda x: (x[0], x[1]),
