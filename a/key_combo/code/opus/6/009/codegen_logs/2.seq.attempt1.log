+    i = 0
+    while i < len(path) - 1:
+        dr = path[i + 1][0] - path[i][0]
+        dc = path[i + 1][1] - path[i][1]
+        j = i + 1
+        while j < len(path) - 1:
+            ndr = path[j + 1][0] - path[j][0]
+            ndc = path[j + 1][1] - path[j][1]
+            if (ndr, ndc) != (dr, dc):
+                break
+            j += 1
+        segments.append(
+            {
+                "start_index": i,
+                "cells": path[i : j + 1],
+                "direction": (dr, dc),
+            }
+        )
+        i = j
+    return segments
