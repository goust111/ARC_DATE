    shape: tuple[int, int],
    start: tuple[int, int],
    goal: tuple[int, int],
    safe: np.ndarray,
    blocked_used: set[tuple[int, int]],
    forbidden: set[tuple[int, int]],
) -> list[tuple[int, int]] | None:
    q = deque([start])
    prev = {start: None}

