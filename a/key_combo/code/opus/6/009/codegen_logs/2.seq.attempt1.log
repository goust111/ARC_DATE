+    q = deque([start])
+    prev = {start: None}
+    while q:
+        cur = q.popleft()
+        if cur == goal:
+            break
+        for nr, nc in neighbors4(*cur):
+            nxt = (nr, nc)
+            if not in_bounds(shape, nr, nc):
+                continue
+            if nxt in prev:
