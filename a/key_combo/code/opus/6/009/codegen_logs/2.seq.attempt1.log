+
+def paint_canonical_yellows(rng: random.Random, grid: np.ndarray, room_a: dict, room_b: dict) -> None:
+    stack_room = rng.choice([0, 1])
+
+    def room_cells(room: dict) -> list[tuple[int, int]]:
