+def append_line(path: list[tuple[int, int]], end: tuple[int, int]) -> None:
+    r, c = path[-1]
+    er, ec = end
+    if r != er and c != ec:
+        raise ValueError("append_line requires axis-aligned move")
+    dr = 0 if r == er else (1 if er > r else -1)
+    dc = 0 if c == ec else (1 if ec > c else -1)
+    while (r, c) != (er, ec):
+        r += dr
+        c += dc
+        path.append((r, c))
