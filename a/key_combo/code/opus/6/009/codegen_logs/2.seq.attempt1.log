+            continue
+        for p in movers:
+            out[p] = BG
+        dr, dc = reg["gravity"]
+        stopped = set()
+        ordered = sorted(movers, key=lambda p: (projection(p, (dr, dc)), p[0], p[1]), reverse=True)
+        for r, c in ordered:
+            nr, nc = r, c
+            while (nr + dr, nc + dc) in reg["cell_set"] and (nr + dr, nc + dc) not in stopped:
+                nr += dr
+                nc += dc
+            stopped.add((nr, nc))
+        for p in stopped:
+            out[p] = YELLOW
