+    append_line(path, (a_r0 - 1, 0))
+    append_line(path, (a_r0 - 1, b_c1 + 1))
+    append_line(path, (b_r1 + 1, b_c1 + 1))
+    append_line(path, (b_r1 + 1, a_c0 - 1))
+    append_line(path, (a_r0 + 1, a_c0 - 1))
+    return path
