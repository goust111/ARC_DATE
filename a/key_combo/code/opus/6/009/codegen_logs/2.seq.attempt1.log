+    return None
+
+
+def canonical_snake(room_a: dict, room_b: dict) -> list[tuple[int, int]]:
+    a_r0, a_c0, _a_r1, _a_c1 = room_a["box"]
+    _b_r0, _b_c0, b_r1, b_c1 = room_b["box"]
