+    if orientation == "horizontal":
+        pairs.sort(key=lambda rc: (rc[1] - rc[0], -rc[0]), reverse=True)
+    else:
+        pairs.sort(key=lambda rc: (rc[0] - rc[1], -rc[1]), reverse=True)
