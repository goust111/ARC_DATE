+def _validate_instance(inp: np.ndarray, expected: np.ndarray, meta: list[dict]) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2 or max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+    if np.array_equal(inp, expected):
