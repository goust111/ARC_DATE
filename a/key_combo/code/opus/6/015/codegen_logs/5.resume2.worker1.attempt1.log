+
+
+def _make_rect(name: str, color: int, r0: int, c0: int, h: int, w: int) -> dict:
+    return {
+        "name": str(name),
+        "color": int(color),
+        "r0": int(r0),
+        "c0": int(c0),
+        "h": int(h),
+        "w": int(w),
+        "r1": int(r0 + h - 1),
+        "c1": int(c0 + w - 1),
