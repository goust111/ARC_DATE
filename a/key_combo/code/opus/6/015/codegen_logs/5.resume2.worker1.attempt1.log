+    stopped: list[dict] = []
+    events: list[dict] = []
+    split_index = 0
+
+    for source in order:
+        mover = _copy_rect(source)
+        while True:
+            obstacle = _choose_obstacle(mover, stopped)
+            if obstacle is None:
+                shift = h - 1 - mover["r1"]
+                mover["r0"] += shift
+                mover["r1"] += shift
+                break
+
+            gap = obstacle["r0"] - mover["r1"] - 1
+            mover["r0"] += gap
+            mover["r1"] += gap
+
+            if gate_mode == "height":
+                can_split = mover["h"] >= obstacle["h"]
+            elif gate_mode == "area":
+                can_split = mover["area"] >= obstacle["area"]
+            elif gate_mode == "always_stop":
+                can_split = False
+            else:
+                raise ValueError(f"unknown gate_mode: {gate_mode}")
