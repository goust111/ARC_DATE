+    left = _make_rect(
+        f"{obstacle['name']}_L{split_index}",
+        obstacle["color"],
+        obstacle["r0"],
+        obstacle["c0"] - 1,
+        obstacle["h"],
+        mover["c0"] - obstacle["c0"],
