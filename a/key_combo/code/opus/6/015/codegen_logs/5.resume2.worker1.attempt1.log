+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+MARKER = 9
+PALETTE = [1, 2, 3, 4, 5, 8]
+RETRY_LIMIT = 400
+
+
+def _make_rect(name: str, color: int, r0: int, c0: int, h: int, w: int) -> dict:
+    return {
+        "name": str(name),
+        "color": int(color),
+        "r0": int(r0),
+        "c0": int(c0),
+        "h": int(h),
+        "w": int(w),
+        "r1": int(r0 + h - 1),
+        "c1": int(c0 + w - 1),
+        "area": int(h * w),
+    }
+
+
+def _copy_rect(rect: dict) -> dict:
+    return _make_rect(rect["name"], rect["color"], rect["r0"], rect["c0"], rect["h"], rect["w"])
+
+
+def _interval_overlap(a0: int, a1: int, b0: int, b1: int) -> bool:
+    return max(int(a0), int(b0)) <= min(int(a1), int(b1))
+
+
+def _rect_center(rect: dict) -> tuple[float, float]:
+    return ((rect["r0"] + rect["r1"]) / 2.0, (rect["c0"] + rect["c1"]) / 2.0)
+
+
+def _dist2_to_center(rect: dict, grid_center: tuple[float, float]) -> float:
+    rr, cc = _rect_center(rect)
+    dr = rr - grid_center[0]
+    dc = cc - grid_center[1]
+    return dr * dr + dc * dc
+
+
+def _paint_rect(grid: np.ndarray, rect: dict) -> None:
+    grid[rect["r0"] : rect["r1"] + 1, rect["c0"] : rect["c1"] + 1] = int(rect["color"])
+
+
+def _rotate_back(grid: np.ndarray, k: int) -> np.ndarray:
+    return np.rot90(grid, -int(k)).copy()
+
+
+def _rotation_to_down(marker: tuple[int, int], shape: tuple[int, int]) -> int:
+    r, c = map(int, marker)
+    h, w = map(int, shape)
+    if r == h - 1:
+        return 0
+    if r == 0:
+        return 2
+    if c == 0:
+        return 1
+    if c == w - 1:
+        return 3
+    raise AssertionError("marker must lie on exactly one grid edge")
+
+
+def _find_marker(grid: np.ndarray) -> tuple[int, int]:
+    pts = np.argwhere(grid == MARKER)
+    assert pts.shape[0] == 1, "expected exactly one maroon marker"
+    r, c = map(int, pts[0])
+    h, w = grid.shape
+    assert r in (0, h - 1) or c in (0, w - 1), "marker must sit on the border"
+    return r, c
+
+
+def _component_rectangles(grid: np.ndarray) -> list[dict]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    rects: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            color = int(grid[r, c])
+            if color in (BG, MARKER) or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            rs = [rr for rr, _ in cells]
+            cs = [cc for _, cc in cells]
+            r0, r1 = min(rs), max(rs)
+            c0, c1 = min(cs), max(cs)
+            area = (r1 - r0 + 1) * (c1 - c0 + 1)
+            assert area == len(cells), "each foreground object must be a solid rectangle"
+            rects.append(_make_rect(f"in_{len(rects)}", color, r0, c0, r1 - r0 + 1, c1 - c0 + 1))
+    return rects
+
+
+def _choose_obstacle(mover: dict, stopped: list[dict]) -> dict | None:
+    candidates = []
+    for obstacle in stopped:
+        if obstacle["r0"] <= mover["r1"]:
+            continue
+        if not _interval_overlap(mover["c0"], mover["c1"], obstacle["c0"], obstacle["c1"]):
+            continue
+        gap = obstacle["r0"] - mover["r1"] - 1
+        candidates.append((gap, obstacle["r0"], obstacle["c0"], obstacle["name"], obstacle))
+    if not candidates:
+        return None
+    candidates.sort(key=lambda item: item[:-1])
+    return candidates[0][-1]
+
+
+def _split_obstacle(
+    obstacle: dict,
+    mover: dict,
+    shape: tuple[int, int],
+    split_index: int,
+    wrong_recolor: str | None = None,
+) -> tuple[list[dict], str]:
+    h, w = map(int, shape)
+    assert obstacle["c0"] < mover["c0"] and mover["c1"] < obstacle["c1"], "split path must leave two obstacle halves"
+
+    left = _make_rect(
+        f"{obstacle['name']}_L{split_index}",
+        obstacle["color"],
+        obstacle["r0"],
+        obstacle["c0"] - 1,
+        obstacle["h"],
+        mover["c0"] - obstacle["c0"],
+    )
+    right = _make_rect(
+        f"{obstacle['name']}_R{split_index}",
+        obstacle["color"],
+        obstacle["r0"],
+        mover["c1"] + 2,
+        obstacle["h"],
+        obstacle["c1"] - mover["c1"],
+    )
+    assert left["c0"] >= 0 and right["c1"] < w
+    assert left["w"] > 0 and right["w"] > 0
+
+    if wrong_recolor == "left-original":
+        keep_side = "left"
+    elif wrong_recolor == "right-original":
+        keep_side = "right"
+    else:
+        grid_center = ((h - 1) / 2.0, (w - 1) / 2.0)
+        left_d = _dist2_to_center(left, grid_center)
+        right_d = _dist2_to_center(right, grid_center)
+        assert abs(left_d - right_d) > 1e-9, "split halves must have a unique nearer/farther relation"
+        keep_side = "left" if left_d < right_d else "right"
+
+    recolor = int(mover["color"])
+    if keep_side == "left":
+        right["color"] = recolor
+    else:
+        left["color"] = recolor
+    return [left, right], keep_side
+
+
+def _simulate_down(
+    rects: list[dict],
+    shape: tuple[int, int],
+    *,
+    gate_mode: str = "height",
+    order_mode: str = "area_desc",
+    wrong_recolor: str | None = None,
+) -> tuple[list[dict], list[dict]]:
+    h, _w = map(int, shape)
+    working = [_copy_rect(rect) for rect in rects]
+    if order_mode == "area_desc":
+        order = sorted(working, key=lambda rect: (-rect["area"], rect["r0"], rect["c0"], rect["color"]))
+    elif order_mode == "height_desc":
+        order = sorted(working, key=lambda rect: (-rect["h"], -rect["w"], rect["r0"], rect["c0"], rect["color"]))
+    elif order_mode == "top_to_bottom":
+        order = sorted(working, key=lambda rect: (rect["r0"], rect["c0"], -rect["area"], rect["color"]))
+    else:
+        raise ValueError(f"unknown order_mode: {order_mode}")
+
+    stopped: list[dict] = []
+    events: list[dict] = []
+    split_index = 0
+
+    for source in order:
+        mover = _copy_rect(source)
+        while True:
+            obstacle = _choose_obstacle(mover, stopped)
+            if obstacle is None:
+                shift = h - 1 - mover["r1"]
+                mover["r0"] += shift
+                mover["r1"] += shift
+                break
+
+            gap = obstacle["r0"] - mover["r1"] - 1
+            mover["r0"] += gap
+            mover["r1"] += gap
+
+            if gate_mode == "height":
+                can_split = mover["h"] >= obstacle["h"]
+            elif gate_mode == "area":
+                can_split = mover["area"] >= obstacle["area"]
+            elif gate_mode == "always_stop":
+                can_split = False
+            else:
+                raise ValueError(f"unknown gate_mode: {gate_mode}")
+
+            if not can_split:
+                events.append(
+                    {
+                        "type": "stop",
+                        "mover": mover["name"],
+                        "obstacle": obstacle["name"],
+                        "mover_h": mover["h"],
+                        "obstacle_h": obstacle["h"],
+                    }
+                )
+                break
+
+            split_index += 1
+            stopped.remove(obstacle)
+            pieces, keep_side = _split_obstacle(obstacle, mover, shape, split_index, wrong_recolor=wrong_recolor)
+            stopped.extend(pieces)
+            events.append(
+                {
+                    "type": "split",
+                    "mover": mover["name"],
+                    "obstacle": obstacle["name"],
+                    "mover_h": mover["h"],
+                    "obstacle_h": obstacle["h"],
+                    "keep_side": keep_side,
+                }
+            )
+
+        stopped.append(mover)
+
+    stopped.sort(key=lambda rect: (rect["r0"], rect["c0"], rect["name"]))
+    return stopped, events
+
+
+def _render_down(shape: tuple[int, int], rects: list[dict], marker_c: int) -> np.ndarray:
+    h, w = map(int, shape)
+    out = np.zeros((h, w), dtype=int)
+    for rect in rects:
+        _paint_rect(out, rect)
+    assert out[h - 1, marker_c] == BG, "marker cell must stay free"
+    out[h - 1, marker_c] = MARKER
+    return out
+
+
+def _solve_down(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    marker = _find_marker(grid)
+    assert marker[0] == h - 1, "canonical solver expects the direction marker on the bottom edge"
+
+    rects = _component_rectangles(grid)
+    assert 4 <= len(rects) <= 6, "expected four to six rectangles"
+    assert len({rect["color"] for rect in rects}) == len(rects), "input rectangle colors must be unique"
+    areas = [rect["area"] for rect in rects]
+    assert len(set(areas)) == len(areas), "rectangle areas must be distinct"
+    for rect in rects:
+        assert rect["w"] > rect["h"], "canonical orientation expects horizontal rectangles"
+
+    final_rects, _events = _simulate_down(rects, (h, w))
+    return _render_down((h, w), final_rects, marker[1])
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Rank solid rectangles by area, slide them toward the marker edge, and split wider-blocked obstacles into recolored halves.
+
+    Input structure:
+    - The background is black and one maroon border pixel marks the common slide direction.
+    - There are four to six non-touching monochrome solid rectangles, each in a unique color.
+    - All rectangles share the same bar orientation, so after rotating to the marker direction they become horizontal bars.
+    - Rectangle areas are all distinct, so their processing rank is uniquely determined.
+
+    Rule:
+    - Rotate the scene conceptually so the maroon marker points downward, then sort the rectangles by area from largest to smallest.
+    - Process them in that rank order: each bar slides downward until it reaches the grid edge or a previously stopped bar.
+    - On contact, compare the moving bar's thickness to the obstacle's thickness. If the mover is thinner, it stops flush against the obstacle.
+    - Otherwise the mover passes through: clear a vertical path through the obstacle under the mover span, shift the two remaining obstacle halves one cell outward, keep the half nearer the grid center in the old color, and recolor the farther half with the mover color.
+    - After all rectangles have been processed, rotate back and keep the maroon marker pixel unchanged.
+
+    Key insight:
+    - Area ranking decides who settles first, but collision branching depends on cross-section thickness rather than area, and the split recolor depends on which half ends up closer to the grid center.
+    """
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    marker = _find_marker(g)
+    k = _rotation_to_down(marker, g.shape)
+    canonical = np.rot90(g, k).copy()
+    solved = _solve_down(canonical)
+    return _rotate_back(solved, k)
+
+
+def _random_nested_spans(width: int, marker_c: int) -> dict[str, tuple[int, int]] | None:
+    side_options = []
+    if marker_c - 2 >= 9:
+        side_options.append(("left", 1, marker_c - 2))
+    if width - marker_c - 3 >= 9:
+        side_options.append(("right", marker_c + 2, width - 2))
+    if not side_options:
+        return None
+
+    _side, band_start, band_end = random.choice(side_options)
+
+    len_a = random.randint(9, min(10, band_end - band_start + 1))
+    a_start_min = band_start
+    a_start_max = band_end - len_a + 1
+    if a_start_min > a_start_max:
+        return None
+    a0 = random.randint(a_start_min, a_start_max)
+
+    len_c = random.randint(5, min(6, len_a - 2))
+    c0_min = a0 + 1
+    c0_max = a0 + len_a - len_c - 1
+    if c0_min > c0_max:
+        return None
+    c0 = random.randint(c0_min, c0_max)
+
+    len_b = 5
+    if len_c < len_b:
+        return None
+    b0_min = c0
+    b0_max = c0 + len_c - len_b
+    if b0_min > b0_max:
+        return None
+    b0 = random.randint(b0_min, b0_max)
+
+    len_d = 3
+    if len_b < len_d + 2:
+        return None
+    d0_min = b0 + 1
+    d0_max = b0 + len_b - len_d - 1
+    if d0_min > d0_max:
+        return None
+    d0 = random.randint(d0_min, d0_max)
+
+    return {
+        "A": (a0, len_a),
+        "C": (c0, len_c),
+        "B": (b0, len_b),
+        "D": (d0, len_d),
+    }
+
+
+def _extra_span(width: int, marker_c: int, occupied: list[tuple[int, int]], area_forbidden: set[int]) -> tuple[int, int, int] | None:
+    sides = [("left", 1, marker_c - 3), ("right", marker_c + 3, width - 2)]
+    random.shuffle(sides)
+    for _side, lo, hi in sides:
+        if hi - lo + 1 < 4:
+            continue
+        for _ in range(20):
+            length = random.randint(3, min(5, hi - lo + 1))
+            c0 = random.randint(lo, hi - length + 1)
+            c1 = c0 + length - 1
+            if any(_interval_overlap(c0, c1, a0, a1) for a0, a1 in occupied):
+                continue
+            for height in (1, 2):
+                area = height * length
+                if area not in area_forbidden:
+                    return c0, length, height
+    return None
+
+
+def _build_canonical_candidate() -> np.ndarray | None:
+    height = random.randint(20, 26)
