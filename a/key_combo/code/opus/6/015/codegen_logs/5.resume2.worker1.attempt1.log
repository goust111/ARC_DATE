+            events.append(
+                {
+                    "type": "split",
+                    "mover": mover["name"],
+                    "obstacle": obstacle["name"],
+                    "mover_h": mover["h"],
+                    "obstacle_h": obstacle["h"],
+                    "keep_side": keep_side,
+                }
