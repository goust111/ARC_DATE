+
+            gap = obstacle["r0"] - mover["r1"] - 1
+            mover["r0"] += gap
+            mover["r1"] += gap
+
+            if gate_mode == "height":
+                can_split = mover["h"] >= obstacle["h"]
+            elif gate_mode == "area":
