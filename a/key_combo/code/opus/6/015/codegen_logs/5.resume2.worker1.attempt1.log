+    b0 = random.randint(b0_min, b0_max)
+
+    len_d = 3
+    if len_b < len_d + 2:
+        return None
+    d0_min = b0 + 1
+    d0_max = b0 + len_b - len_d - 1
+    if d0_min > d0_max:
+        return None
+    d0 = random.randint(d0_min, d0_max)
+
+    return {
+        "A": (a0, len_a),
+        "C": (c0, len_c),
+        "B": (b0, len_b),
+        "D": (d0, len_d),
+    }
+
