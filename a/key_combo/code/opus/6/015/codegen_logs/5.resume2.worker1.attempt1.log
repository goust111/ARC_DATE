+            if not can_split:
+                events.append(
+                    {
+                        "type": "stop",
+                        "mover": mover["name"],
+                        "obstacle": obstacle["name"],
+                        "mover_h": mover["h"],
+                        "obstacle_h": obstacle["h"],
