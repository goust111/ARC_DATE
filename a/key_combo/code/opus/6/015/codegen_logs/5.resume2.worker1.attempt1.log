+def _build_canonical_candidate() -> np.ndarray | None:
+    height = random.randint(20, 26)
+    width = random.randint(18, 24)
+    marker_options = [col for col in (width // 2 - 1, width // 2, width // 2 + 1) if 0 <= col < width]
+    marker_c = random.choice(marker_options)
+
+    spans = _random_nested_spans(width, marker_c)
+    if spans is None:
+        return None
+
+    heights = {"A": 3, "C": 4, "B": 2, "D": 2}
+    rect_specs = {}
+    for name in ("A", "B", "C", "D"):
+        c0, rect_w = spans[name]
+        rect_specs[name] = {"h": heights[name], "w": rect_w, "c0": c0}
+
+    area_order = [rect_specs[name]["h"] * rect_specs[name]["w"] for name in ("A", "C", "B", "D")]
+    if not (area_order[0] > area_order[1] > area_order[2] > area_order[3]):
+        return None
+
+    names = ["A", "B", "C", "D"]
+    occupied_rows = 1
+    random_order = names[:]
+    random.shuffle(random_order)
+    rows: dict[str, int] = {}
+    for name in random_order:
+        rows[name] = occupied_rows
+        occupied_rows += rect_specs[name]["h"] + random.randint(1, 2)
+
+    extra_name = None
+    if random.random() < 0.45:
+        occupied = [(spans["A"][0], spans["A"][0] + spans["A"][1] - 1)]
+        extra = _extra_span(width, marker_c, occupied, set(area_order))
+        if extra is not None:
+            c0, rect_w, rect_h = extra
+            rect_specs["E"] = {"h": rect_h, "w": rect_w, "c0": c0}
+            extra_name = "E"
+            rows["E"] = occupied_rows
+            occupied_rows += rect_h + random.randint(1, 2)
+
+    if occupied_rows >= height:
+        return None
+
+    color_count = 4 + int(extra_name is not None)
+    colors = random.sample(PALETTE, color_count)
+    rects = []
+    for idx, name in enumerate(["A", "C", "B", "D"] + ([extra_name] if extra_name is not None else [])):
+        spec = rect_specs[name]
+        rects.append(_make_rect(name, colors[idx], rows[name], spec["c0"], spec["h"], spec["w"]))
