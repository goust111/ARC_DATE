+    return None
+
+
+def _assign_colors(objects: list[Triomino], meta: list[dict]) -> list[Triomino]:
+    successes = [m["bbox"] for m in meta if m["success"]]
+    blocks = [m["bbox"] for m in meta if not m["success"]]
