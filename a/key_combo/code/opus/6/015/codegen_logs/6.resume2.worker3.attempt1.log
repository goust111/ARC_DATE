+    payload_boxes = [_bbox(group["payload"] + group["marker"]) for group in groups]
+    for i, box_a in enumerate(payload_boxes):
+        for box_b in payload_boxes[i + 1 :]:
+            if not _box_far_enough(box_a, box_b):
+                return False
