+) -> bool:
+    h, w = grid.shape
+    template = _sample_template_for_side(kind, emission_side)
+    if template is None:
+        return False
+    payload_rel = template["payload"]
+    marker_rel = template["marker"]
+    coords_rel = list(payload_rel + marker_rel)
