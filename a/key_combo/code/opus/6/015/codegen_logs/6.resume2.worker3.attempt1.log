+    rays: list[dict[str, object]] = []
+    ray_directions: set[int] = set()
+    axis_orientations: set[str] = set()
+    for group in groups:
+        mirror_kind = str(group["mirror_kind"])
+        if mirror_kind == "row":
+            axis_orientations.add("horizontal")
+        elif mirror_kind == "col":
+            axis_orientations.add("vertical")
