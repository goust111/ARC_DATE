from itertools import combinations
from collections import deque


def conn(cells):
    cells=set(cells)
    q=deque([next(iter(cells))])
    seen={q[0]}
    while q:
        r,c=q.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            nb=(r+dr,c+dc)
            if nb in cells and nb not in seen:
                seen.add(nb); q.append(nb)
    return len(seen)==len(cells)

def holes(occ,bounds):
    rlo,rhi,clo,chi=bounds
    unseen={(r,c) for r in range(rlo,rhi+1) for c in range(clo,chi+1) if (r,c) not in occ}
    hs=[]
    while unseen:
        start=unseen.pop(); q=deque([start]); cc={start}; touch=start[0] in (rlo,rhi) or start[1] in (clo,chi)
        while q:
            r,c=q.popleft()
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                nb=(r+dr,c+dc)
                if rlo<=nb[0]<=rhi and clo<=nb[1]<=chi and nb not in occ and nb in unseen:
                    unseen.remove(nb); q.append(nb); cc.add(nb)
                    if nb[0] in (rlo,rhi) or nb[1] in (clo,chi): touch=True
        if not touch: hs.append(cc)
    return hs

def row_open_dir(occ,hole):
    # hole is set of coords; require each row exactly one open direction to bbox boundary when padded with 1 empty col each side
    rows=sorted({r for r,_ in hole})
    dirs=[]
    for row in rows:
        cols=sorted(c for r,c in hole if r==row)
        left=max(cols)
        # open iff the immediate left path from left representative stays empty to clo-1 in padded bounds
        c=left
        left_span=0
        while (row,c) not in occ:
            left_span+=1; c-=1
            if c < -6: break
        right=min(cols)
        c=right
        right_span=0
        while (row,c) not in occ:
            right_span+=1; c+=1
            if c > 6: break
        # want only one side more than hole cells
        left_open = left_span >= 2
        right_open = right_span >= 2
        if left_open == right_open:
            return None
        dirs.append('L' if left_open else 'R')
    return dirs[0] if len(set(dirs))==1 else None

print('POINT templates')
coords=[(r,c) for r in range(-2,3) for c in range(-3,4) if (r,c)"'!=(0,0)]
found=0
for k in range(4,9):
