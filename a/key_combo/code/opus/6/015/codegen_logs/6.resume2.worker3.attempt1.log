+    rows = sorted({r for r, _ in marker})
+    cols = sorted({c for _, c in marker})
+    if len(rows) == 1:
+        row = rows[0]
+        ordered = sorted(c for _, c in marker)
+        if ordered[-1] - ordered[0] + 1 == len(ordered):
