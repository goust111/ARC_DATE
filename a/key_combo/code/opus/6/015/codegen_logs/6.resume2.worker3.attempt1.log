+                "payload": payload,
+                "marker": marker,
+                "payload_color": payload_color,
+                "mirror_kind": mirror_kind,
+                "reflected": valid_reflected,
+                "composite": composite,
+                "composite_size": len(composite),
+                "holes": holes,
+                "marker_length": len(marker),
