+            return None
+
+    return grid if _validate_generated(grid, group_count) else None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
