+            continue
+        holes.append([(rr + r0, cc + c0) for rr, cc in comp])
+    return holes
+
+
+def _ray_from_hole_row(
+    base: np.ndarray,
+    composite: set[tuple[int, int]],
+    row: int,
+    cols: list[int],
+) -> tuple[int, list[tuple[int, int]]]:
