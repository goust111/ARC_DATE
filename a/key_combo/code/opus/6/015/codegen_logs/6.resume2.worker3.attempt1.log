+AXIS_TEMPLATES = (
+    {
+        "payload": ((-1, -2), (-1, -1), (0, -2), (1, -2), (1, -1)),
+        "marker": ((-1, 0), (0, 0)),
+    },
+    {
+        "payload": ((-1, -2), (-1, -1), (0, -2), (1, -2), (1, -1)),
+        "marker": ((-1, 0), (0, 0), (1, 0)),
+    },
