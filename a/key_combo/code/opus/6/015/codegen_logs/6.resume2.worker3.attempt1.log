+def _ray_from_hole_row(
+    base: np.ndarray,
+    composite: set[tuple[int, int]],
+    row: int,
+    cols: list[int],
+) -> tuple[int, list[tuple[int, int]]]:
+    dirs = set()
+    for c in cols:
+        left = c
+        right = base.shape[1] - 1 - c
+        if left == right:
+            raise ValueError("hole row has a center-tie ray direction")
+        dirs.add(-1 if left < right else 1)
