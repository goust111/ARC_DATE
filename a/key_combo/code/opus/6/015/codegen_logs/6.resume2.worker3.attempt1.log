+        "marker": ((-1, 0), (0, 0)),
+    },
+)
+
+POINT_TEMPLATES = (
+    {
+        "payload": ((-2, -1), (-2, 0), (-2, 1), (-1, -1), (-1, 1)),
+        "marker": ((0, 0),),
+    },
+    {
+        "payload": ((-1, -2), (-1, -1), (-1, 0), (-1, 1), (0, -2)),
+        "marker": ((0, 0),),
+    },
+    {
+        "payload": ((-2, -2), (-2, -1), (-2, 0), (-2, 1), (-1, -1), (-1, 1)),
+        "marker": ((0, 0),),
+    },
+)
+
+
+def _sample_template(kind: str) -> dict[str, tuple[tuple[int, int], ...]]:
