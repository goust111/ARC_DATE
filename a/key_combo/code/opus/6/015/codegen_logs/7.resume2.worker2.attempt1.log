            {"side": "bottom", "r0": cut, "r1": height - 1, "c0": 0, "c1": width - 1},
        ]
    return [
        {"side": "left", "r0": 0, "r1": height - 1, "c0": 0, "c1": cut - 1},
        {"side": "right", "r0": 0, "r1": height - 1, "c0": cut, "c1": width - 1},
    ]


