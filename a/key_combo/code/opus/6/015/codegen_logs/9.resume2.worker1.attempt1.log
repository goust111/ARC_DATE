+def _stripe_colors(segment: dict[str, object], extent: int) -> list[tuple[int, int]]:
+    colors = (YELLOW, YELLOW, GREEN)
+    start = int(segment["start"])
+    direction = int(segment["direction"])
+    striped: list[tuple[int, int]] = []
+    step_idx = 0
+    while True:
+        pos = start + direction * (2 * step_idx)
+        if not (0 <= pos < extent):
