+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+YELLOW = 4
+PALETTE = (1, 2, 5, 6, 7, 8, 9)
+STEP = 4
+BLOCK_SIZE_OPTIONS = (2, 3)
+EDGE_OPTIONS = ("top", "bottom", "left", "right")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def _find_square_blocks(grid: np.ndarray, *, exclude_colors: set[int]) -> list[dict[str, int]]:
+    blocks: list[dict[str, int]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in exclude_colors):
+        for pts in _components_of_color(grid, color):
+            if len(pts) < 4:
+                continue
+            r0, c0, r1, c1 = _bbox(pts)
+            side_r = r1 - r0 + 1
+            side_c = c1 - c0 + 1
+            if side_r != side_c or side_r < 2:
+                continue
+            if len(pts) != side_r * side_c:
+                continue
+            blocks.append({"r0": r0, "c0": c0, "size": side_r, "color": int(color)})
+    return sorted(blocks, key=lambda b: (b["r0"], b["c0"], b["color"]))
+
+
+def _find_yellow_segment(grid: np.ndarray) -> dict[str, object]:
+    h, w = grid.shape
+    border_yellow = np.zeros_like(grid, dtype=bool)
+    border_yellow[0, :] = grid[0, :] == YELLOW
+    border_yellow[h - 1, :] = grid[h - 1, :] == YELLOW
+    border_yellow[:, 0] |= grid[:, 0] == YELLOW
+    border_yellow[:, w - 1] |= grid[:, w - 1] == YELLOW
+    pts = np.argwhere(border_yellow)
+    assert len(pts) >= 2, "expected one yellow border segment"
+    r0, c0, r1, c1 = _bbox(pts)
+    if r0 == r1:
+        edge = "top" if r0 == 0 else "bottom"
+        return {
+            "edge": edge,
+            "axis": "h",
+            "start": int(r0),
+            "direction": 1 if edge == "top" else -1,
+            "span0": int(c0),
+            "span1": int(c1),
+        }
+    assert c0 == c1, "yellow border marker must be a straight segment"
+    edge = "left" if c0 == 0 else "right"
+    return {
+        "edge": edge,
+        "axis": "v",
+        "start": int(c0),
+        "direction": 1 if edge == "left" else -1,
+        "span0": int(r0),
+        "span1": int(r1),
+    }
+
+
+def _extract_legend(grid: np.ndarray, blocks: list[dict[str, int]]) -> tuple[np.ndarray, list[tuple[int, int, int]], tuple[int, int]]:
+    used = np.zeros_like(grid, dtype=bool)
+    for block in blocks:
+        r0 = block["r0"]
+        c0 = block["c0"]
+        size = block["size"]
+        used[r0 : r0 + size, c0 : c0 + size] = True
+    legend_pts = [
+        (r, c, int(grid[r, c]))
+        for r, c in np.argwhere((grid != BG) & (grid != YELLOW) & (~used))
+    ]
+    assert legend_pts, "legend pixels not found"
+    coords = np.array([(r, c) for r, c, _ in legend_pts], dtype=int)
+    r0, c0, r1, c1 = _bbox(coords)
+    sprite = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    local = [(r - r0, c - c0, v) for r, c, v in legend_pts]
+    return sprite, sorted(local), (r0, c0)
+
+
+def _dominant_block_size(blocks: list[dict[str, int]]) -> int:
+    counts = Counter(block["size"] for block in blocks)
+    size, _ = counts.most_common(1)[0]
+    return int(size)
+
+
+def _infer_step(blocks: list[dict[str, int]]) -> int:
+    diffs = set()
+    rows = sorted({block["r0"] for block in blocks})
+    cols = sorted({block["c0"] for block in blocks})
+    for arr in (rows, cols):
+        for i in range(len(arr)):
+            for j in range(i + 1, len(arr)):
+                diff = arr[j] - arr[i]
+                if diff > 0:
+                    diffs.add(diff)
+    assert diffs, "need multiple block rows or cols to infer scale"
+    step = min(diffs)
+    for diff in diffs:
+        step = int(np.gcd(step, diff))
+    assert step >= 2, "invalid block lattice step"
+    return step
+
+
+def _candidate_bases(
+    legend_cells: list[tuple[int, int, int]],
+    blocks: list[dict[str, int]],
+    step: int,
+) -> list[tuple[int, int]]:
+    seen: set[tuple[int, int]] = set()
+    for lr, lc, color in legend_cells:
+        for block in blocks:
+            if block["color"] != color:
+                continue
+            seen.add((block["r0"] - lr * step, block["c0"] - lc * step))
+    return sorted(seen)
+
+
+def _valid_base(
+    base: tuple[int, int],
+    legend: np.ndarray,
+    blocks: list[dict[str, int]],
+    grid_shape: tuple[int, int],
+    block_size: int,
+    step: int,
+) -> bool:
+    h, w = grid_shape
+    base_r, base_c = base
+    index_by_anchor = {(block["r0"], block["c0"]): block["color"] for block in blocks}
+    for block in blocks:
+        dr = block["r0"] - base_r
+        dc = block["c0"] - base_c
+        if dr % step != 0 or dc % step != 0:
+            return False
+        lr = dr // step
+        lc = dc // step
+        if not (0 <= lr < legend.shape[0] and 0 <= lc < legend.shape[1]):
+            return False
+        if int(legend[lr, lc]) != block["color"]:
+            return False
+    for lr in range(legend.shape[0]):
+        for lc in range(legend.shape[1]):
+            color = int(legend[lr, lc])
+            if color == BG:
+                continue
+            r0 = base_r + lr * step
+            c0 = base_c + lc * step
+            if not (0 <= r0 <= h - block_size and 0 <= c0 <= w - block_size):
+                return False
+            if (r0, c0) in index_by_anchor and index_by_anchor[(r0, c0)] != color:
+                return False
+    return True
+
+
+def _infer_mapping(grid: np.ndarray) -> dict[str, object]:
+    blocks = _find_square_blocks(grid, exclude_colors={BG, YELLOW})
+    assert blocks, "no block anchors found"
+    block_size = _dominant_block_size(blocks)
+    blocks = [block for block in blocks if block["size"] == block_size]
+    legend, legend_cells, legend_origin = _extract_legend(grid, blocks)
+    step = _infer_step(blocks)
+    candidates = [
+        base
+        for base in _candidate_bases(legend_cells, blocks, step)
+        if _valid_base(base, legend, blocks, grid.shape, block_size, step)
+    ]
+    assert len(candidates) == 1, "legend-to-block mapping must be unique"
+    base_r, base_c = candidates[0]
+    return {
+        "blocks": blocks,
+        "block_size": block_size,
+        "legend": legend,
+        "legend_cells": legend_cells,
+        "legend_origin": legend_origin,
+        "step": step,
+        "base": (base_r, base_c),
+    }
+
+
+def _complete_from_mapping(grid: np.ndarray, mapping: dict[str, object]) -> tuple[np.ndarray, list[dict[str, int]], set[tuple[int, int]]]:
+    out = np.array(grid, dtype=int, copy=True)
+    block_size = int(mapping["block_size"])
+    step = int(mapping["step"])
+    base_r, base_c = mapping["base"]
+    existing = {(block["r0"], block["c0"]) for block in mapping["blocks"]}
+    new_blocks: list[dict[str, int]] = []
+    for lr, lc, color in mapping["legend_cells"]:
+        r0 = base_r + lr * step
+        c0 = base_c + lc * step
+        if (r0, c0) in existing:
+            continue
+        out[r0 : r0 + block_size, c0 : c0 + block_size] = color
+        new_blocks.append({"r0": r0, "c0": c0, "size": block_size, "orig_color": color})
+    return out, new_blocks, existing
+
+
+def _stripe_colors(segment: dict[str, object], extent: int) -> list[tuple[int, int]]:
+    colors = (YELLOW, YELLOW, GREEN)
+    start = int(segment["start"])
+    direction = int(segment["direction"])
+    striped: list[tuple[int, int]] = []
+    step_idx = 0
+    while True:
+        pos = start + direction * (2 * step_idx)
+        if not (0 <= pos < extent):
+            break
+        striped.append((pos, colors[step_idx % 3]))
+        step_idx += 1
+    return striped
+
+
+def _apply_stripes(
+    grid: np.ndarray,
+    *,
+    segment: dict[str, object],
+    new_blocks: list[dict[str, int]],
+    bg: int,
+) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    span0 = int(segment["span0"])
+    span1 = int(segment["span1"])
+    if segment["axis"] == "h":
+        for pos, color in _stripe_colors(segment, h):
+            if color == GREEN:
+                for block in new_blocks:
+                    if block["r0"] == pos:
+                        r0 = block["r0"]
+                        c0 = block["c0"]
+                        size = block["size"]
+                        out[r0 : r0 + size, c0 : c0 + size] = GREEN
+                mask = out[pos, :] != bg
+                out[pos, mask] = GREEN
+            for c in range(span0, span1 + 1):
+                if out[pos, c] == bg:
+                    out[pos, c] = color
+    else:
+        for pos, color in _stripe_colors(segment, w):
+            if color == GREEN:
+                for block in new_blocks:
+                    if block["c0"] == pos:
+                        r0 = block["r0"]
+                        c0 = block["c0"]
+                        size = block["size"]
+                        out[r0 : r0 + size, c0 : c0 + size] = GREEN
+                mask = out[:, pos] != bg
+                out[mask, pos] = GREEN
+            for r in range(span0, span1 + 1):
+                if out[r, pos] == bg:
+                    out[r, pos] = color
+    return out
+
+
+def _axis_distance(edge: str, coord: int, size: int) -> int:
+    if edge in ("top", "left"):
+        return coord
+    return size - 1 - coord
+
+
+def _axis_color(edge: str, coord: int, size: int) -> int | None:
+    dist = _axis_distance(edge, coord, size)
+    if dist % 2 != 0:
+        return None
+    return (YELLOW, YELLOW, GREEN)[(dist // 2) % 3]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a scaled block layout from a top-left minimap, then modulate only the newly added blocks with propagated stripes.
+
+    Input structure:
+    - The background is black.
+    - A small top-left minimap contains colored cells and black empties.
+    - Farther in the canvas, some uniformly colored square blocks already occupy a regular lattice, and a short yellow border segment marks one edge.
+
+    Rule:
+    - Infer the square block size, lattice step, and lattice offset by matching the existing blocks to the minimap colors and coordinates.
+    - For every non-black minimap cell whose mapped lattice position is still empty, add a solid square block of that minimap color.
+    - Propagate one-cell stripes from the yellow edge segment toward the opposite side with the repeating color cycle yellow, yellow, green on every other row or column.
+    - Yellow stripes only appear on background cells inside the segment span. Green stripes recolor every non-background pixel on their full row or column to green, and any newly added block anchored on that stripe becomes entirely green; pre-existing blocks are never wholly replaced.
+
+    Key insight:
+    - The minimap fixes where missing blocks belong, but the border stripes then selectively override some of those new blocks, so the final result requires combining a coordinate-mapping completion rule with a separate stripe-based recoloring rule.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    assert bg == BG, "this task uses black background"
+    mapping = _infer_mapping(g)
+    completed, new_blocks, _existing = _complete_from_mapping(g, mapping)
+    segment = _find_yellow_segment(g)
+    return _apply_stripes(completed, segment=segment, new_blocks=new_blocks, bg=bg)
+
+
+def _assign_colors(mask: np.ndarray, palette: tuple[int, ...]) -> np.ndarray | None:
+    k = mask.shape[0]
+    legend = np.zeros((k, k), dtype=int)
+    cells = [(r, c) for r in range(k) for c in range(k) if mask[r, c]]
+    random.shuffle(cells)
+    for r, c in cells:
+        forbidden = set()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < k and 0 <= nc < k and legend[nr, nc] != 0:
+                forbidden.add(int(legend[nr, nc]))
+        choices = [color for color in palette if color not in forbidden]
+        if not choices:
+            return None
+        legend[r, c] = random.choice(choices)
+    return legend
+
+
+def _build_mask(k: int, edge: str, axis_colors: list[int]) -> np.ndarray | None:
+    mask = np.zeros((k, k), dtype=bool)
+    if edge in ("top", "bottom"):
+        green_rows = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_rows = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        if not green_rows or not yellow_rows:
+            return None
+        grow = random.choice(green_rows)
+        yrow = random.choice(yellow_rows)
+        gcols = random.sample(range(k), min(k, 3))
+        for c in gcols:
+            mask[grow, c] = True
+        ycols = random.sample(range(k), min(k, 2))
+        for c in ycols:
+            mask[yrow, c] = True
+        for r in range(k):
+            if mask[r].sum() == 0:
+                cols = random.sample(range(k), random.randint(1, min(3, k)))
+                for c in cols:
+                    mask[r, c] = True
+        for c in range(k):
+            if mask[:, c].sum() == 0:
+                mask[random.randrange(k), c] = True
+    else:
+        green_cols = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_cols = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        if not green_cols or not yellow_cols:
+            return None
+        gcol = random.choice(green_cols)
+        ycol = random.choice(yellow_cols)
+        grows = random.sample(range(k), min(k, 3))
+        for r in grows:
+            mask[r, gcol] = True
+        yrows = random.sample(range(k), min(k, 2))
+        for r in yrows:
+            mask[r, ycol] = True
+        for c in range(k):
+            if mask[:, c].sum() == 0:
+                rows = random.sample(range(k), random.randint(1, min(3, k)))
+                for r in rows:
+                    mask[r, c] = True
+        for r in range(k):
+            if mask[r].sum() == 0:
+                mask[r, random.randrange(k)] = True
+    for r in range(k):
+        for c in range(k):
+            if mask[r, c] and random.random() < 0.25:
+                tmp = mask.copy()
+                tmp[r, c] = False
+                if tmp.sum() >= 6 and tmp[r].any() and tmp[:, c].any():
+                    mask = tmp
+    if mask.sum() < 6:
+        return None
+    return mask
+
+
+def _select_existing(mask: np.ndarray, edge: str, axis_colors: list[int]) -> set[tuple[int, int]] | None:
+    filled = {(r, c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r, c]}
+    if edge in ("top", "bottom"):
+        green_rows = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_rows = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        green_cells = [(r, c) for (r, c) in filled if r in green_rows]
+        yellow_cells = [(r, c) for (r, c) in filled if r in yellow_rows]
+    else:
+        green_cols = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_cols = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        green_cells = [(r, c) for (r, c) in filled if c in green_cols]
+        yellow_cells = [(r, c) for (r, c) in filled if c in yellow_cols]
+    if len(green_cells) < 3 or len(yellow_cells) < 2 or len(filled) < 7:
+        return None
+
+    existing = {random.choice(green_cells)}
+    existing.add(random.choice(yellow_cells))
+    remaining = [cell for cell in filled if cell not in existing]
+    random.shuffle(remaining)
+    for cell in remaining:
+        existing.add(cell)
+        rows = {r for r, _ in existing}
+        cols = {c for _, c in existing}
+        if len(existing) >= 4 and len(rows) >= 2 and len(cols) >= 2:
+            break
+    if len(existing) < 4:
+        return None
+    missing = filled - existing
+    if len(missing) < 3:
+        return None
+    if edge in ("top", "bottom"):
+        miss_green = sum(1 for r, _ in missing if axis_colors[r] == GREEN)
+        miss_yellow = sum(1 for r, _ in missing if axis_colors[r] == YELLOW)
+        ex_green = sum(1 for r, _ in existing if axis_colors[r] == GREEN)
+    else:
+        miss_green = sum(1 for _, c in missing if axis_colors[c] == GREEN)
+        miss_yellow = sum(1 for _, c in missing if axis_colors[c] == YELLOW)
+        ex_green = sum(1 for _, c in existing if axis_colors[c] == GREEN)
+    if miss_green < 2 or miss_yellow < 1 or ex_green < 1:
+        return None
+    return existing
+
+
+def _place_segment(grid: np.ndarray, edge: str, length: int, k: int) -> None:
+    h, w = grid.shape
+    if edge == "top":
+        starts = [c for c in range(max(k + 2, 1), w - length) if c >= 1]
+        start = random.choice(starts or list(range(1, w - length)))
+        grid[0, start : start + length] = YELLOW
+    elif edge == "bottom":
+        start = random.randint(1, w - length - 1)
+        grid[h - 1, start : start + length] = YELLOW
+    elif edge == "left":
+        starts = [r for r in range(max(k + 2, 1), h - length) if r >= 1]
+        start = random.choice(starts or list(range(1, h - length)))
+        grid[start : start + length, 0] = YELLOW
+    else:
+        start = random.randint(1, h - length - 1)
+        grid[start : start + length, w - 1] = YELLOW
+
+
+def _render_input(
+    *,
+    h: int,
+    w: int,
+    legend: np.ndarray,
+    edge: str,
+    base_r: int,
+    base_c: int,
+    block_size: int,
+    existing: set[tuple[int, int]],
+) -> np.ndarray:
+    grid = np.zeros((h, w), dtype=int)
+    k = legend.shape[0]
+    grid[1 : 1 + k, 1 : 1 + k] = legend
+    for lr in range(k):
+        for lc in range(k):
+            color = int(legend[lr, lc])
+            if color == BG or (lr, lc) not in existing:
+                continue
+            r0 = base_r + lr * STEP
+            c0 = base_c + lc * STEP
+            grid[r0 : r0 + block_size, c0 : c0 + block_size] = color
+    _place_segment(grid, edge, random.randint(2, 3), k)
+    return grid
+
+
+def _search_axis_base(size: int, k: int, block_size: int, edge: str) -> tuple[int, list[int]] | None:
+    layout_end = (k - 1) * STEP + block_size
+    candidates = []
+    for base in range(k + 3, size - layout_end - 1):
+        if _axis_distance(edge, base, size) % 2 != 0:
+            continue
+        axis_colors = [_axis_color(edge, base + idx * STEP, size) for idx in range(k)]
+        if None in axis_colors:
+            continue
+        axis_colors = [int(v) for v in axis_colors]
+        if GREEN in axis_colors and YELLOW in axis_colors:
+            candidates.append((base, axis_colors))
+    if not candidates:
+        return None
+    return random.choice(candidates)
+
+
+def _search_non_axis_base(size: int, k: int, block_size: int) -> int | None:
+    layout_end = (k - 1) * STEP + block_size
+    starts = list(range(k + 3, size - layout_end - 1))
+    if not starts:
+        return None
+    return random.choice(starts)
+
+
+def _semantic_check(inp: np.ndarray) -> bool:
+    mapping = _infer_mapping(inp)
+    completed, new_blocks, existing = _complete_from_mapping(inp, mapping)
+    final = _apply_stripes(completed, segment=_find_yellow_segment(inp), new_blocks=new_blocks, bg=BG)
+    if len(new_blocks) < 3 or np.array_equal(final, completed):
+        return False
+    segment = _find_yellow_segment(inp)
+    if segment["axis"] == "h":
+        miss_green = sum(1 for block in new_blocks if _axis_color(segment["edge"], block["r0"], inp.shape[0]) == GREEN)
+        miss_yellow = sum(1 for block in new_blocks if _axis_color(segment["edge"], block["r0"], inp.shape[0]) == YELLOW)
+        ex_green = sum(1 for r0, _ in existing if _axis_color(segment["edge"], r0, inp.shape[0]) == GREEN)
+    else:
+        miss_green = sum(1 for block in new_blocks if _axis_color(segment["edge"], block["c0"], inp.shape[1]) == GREEN)
+        miss_yellow = sum(1 for block in new_blocks if _axis_color(segment["edge"], block["c0"], inp.shape[1]) == YELLOW)
+        ex_green = sum(1 for _, c0 in existing if _axis_color(segment["edge"], c0, inp.shape[1]) == GREEN)
+    if miss_green < 2 or miss_yellow < 1 or ex_green < 1:
+        return False
+    if main(inp).shape != inp.shape:
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    k = random.choice((3, 4, 4, 5, 5))
+    block_size = random.choice(BLOCK_SIZE_OPTIONS)
+    edge = random.choice(EDGE_OPTIONS)
+    h = random.randint(max(18, k * STEP + 6), 30)
+    w = random.randint(max(18, k * STEP + 6), 30)
+
+    if edge in ("top", "bottom"):
+        axis_pick = _search_axis_base(h, k, block_size, edge)
+        base_c = _search_non_axis_base(w, k, block_size)
+        if axis_pick is None or base_c is None:
+            return None
+        base_r, axis_colors = axis_pick
+    else:
+        axis_pick = _search_axis_base(w, k, block_size, edge)
+        base_r = _search_non_axis_base(h, k, block_size)
+        if axis_pick is None or base_r is None:
+            return None
+        base_c, axis_colors = axis_pick
+
+    mask = _build_mask(k, edge, axis_colors)
+    if mask is None:
+        return None
+
+    palette_size = random.choice((3, 4))
+    palette = tuple(random.sample(PALETTE, palette_size))
+    legend = _assign_colors(mask, palette)
+    if legend is None:
+        return None
+
+    existing = _select_existing(mask, edge, axis_colors)
+    if existing is None:
+        return None
+
+    inp = _render_input(
+        h=h,
+        w=w,
+        legend=legend,
+        edge=edge,
+        base_r=base_r,
+        base_c=base_c,
+        block_size=block_size,
+        existing=existing,
+    )
+
+    try:
+        if not _semantic_check(inp):
+            return None
+        out = main(inp)
+        if max(inp.shape) > 30 or max(out.shape) > 30:
+            return None
+    except AssertionError:
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("generate_input: failed after 500 attempts")

diff --git a/key_combo/code/opus/6/015/9.py b/key_combo/code/opus/6/015/9.py
new file mode 100644
index 0000000000000000000000000000000000000000..2605d1409e67582707ec14c7b875c4fda57f982f
--- /dev/null
+++ b/key_combo/code/opus/6/015/9.py
@@ -0,0 +1,600 @@
+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+YELLOW = 4
+PALETTE = (1, 2, 5, 6, 7, 8, 9)
+STEP = 4
+BLOCK_SIZE_OPTIONS = (2, 3)
+EDGE_OPTIONS = ("top", "bottom", "left", "right")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def _find_square_blocks(grid: np.ndarray, *, exclude_colors: set[int]) -> list[dict[str, int]]:
+    blocks: list[dict[str, int]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in exclude_colors):
+        for pts in _components_of_color(grid, color):
+            if len(pts) < 4:
+                continue
+            r0, c0, r1, c1 = _bbox(pts)
+            side_r = r1 - r0 + 1
+            side_c = c1 - c0 + 1
+            if side_r != side_c or side_r < 2:
+                continue
+            if len(pts) != side_r * side_c:
+                continue
+            blocks.append({"r0": r0, "c0": c0, "size": side_r, "color": int(color)})
+    return sorted(blocks, key=lambda b: (b["r0"], b["c0"], b["color"]))
+
+
+def _find_yellow_segment(grid: np.ndarray) -> dict[str, object]:
+    h, w = grid.shape
+    border_yellow = np.zeros_like(grid, dtype=bool)
+    border_yellow[0, :] = grid[0, :] == YELLOW
+    border_yellow[h - 1, :] = grid[h - 1, :] == YELLOW
+    border_yellow[:, 0] |= grid[:, 0] == YELLOW
+    border_yellow[:, w - 1] |= grid[:, w - 1] == YELLOW
+    pts = np.argwhere(border_yellow)
+    assert len(pts) >= 2, "expected one yellow border segment"
+    r0, c0, r1, c1 = _bbox(pts)
+    if r0 == r1:
+        edge = "top" if r0 == 0 else "bottom"
+        return {
+            "edge": edge,
+            "axis": "h",
+            "start": int(r0),
+            "direction": 1 if edge == "top" else -1,
+            "span0": int(c0),
+            "span1": int(c1),
+        }
+    assert c0 == c1, "yellow border marker must be a straight segment"
+    edge = "left" if c0 == 0 else "right"
+    return {
+        "edge": edge,
+        "axis": "v",
+        "start": int(c0),
+        "direction": 1 if edge == "left" else -1,
+        "span0": int(r0),
+        "span1": int(r1),
+    }
+
+
+def _extract_legend(grid: np.ndarray, blocks: list[dict[str, int]]) -> tuple[np.ndarray, list[tuple[int, int, int]], tuple[int, int]]:
+    used = np.zeros_like(grid, dtype=bool)
+    for block in blocks:
+        r0 = block["r0"]
+        c0 = block["c0"]
+        size = block["size"]
+        used[r0 : r0 + size, c0 : c0 + size] = True
+    legend_pts = [
+        (r, c, int(grid[r, c]))
+        for r, c in np.argwhere((grid != BG) & (grid != YELLOW) & (~used))
+    ]
+    assert legend_pts, "legend pixels not found"
+    coords = np.array([(r, c) for r, c, _ in legend_pts], dtype=int)
+    r0, c0, r1, c1 = _bbox(coords)
+    sprite = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    local = [(r - r0, c - c0, v) for r, c, v in legend_pts]
+    return sprite, sorted(local), (r0, c0)
+
+
+def _dominant_block_size(blocks: list[dict[str, int]]) -> int:
+    counts = Counter(block["size"] for block in blocks)
+    size, _ = counts.most_common(1)[0]
+    return int(size)
+
+
+def _infer_step(blocks: list[dict[str, int]]) -> int:
+    diffs = set()
+    rows = sorted({block["r0"] for block in blocks})
+    cols = sorted({block["c0"] for block in blocks})
+    for arr in (rows, cols):
+        for i in range(len(arr)):
+            for j in range(i + 1, len(arr)):
+                diff = arr[j] - arr[i]
+                if diff > 0:
+                    diffs.add(diff)
+    assert diffs, "need multiple block rows or cols to infer scale"
+    step = min(diffs)
+    for diff in diffs:
+        step = int(np.gcd(step, diff))
+    assert step >= 2, "invalid block lattice step"
+    return step
+
+
+def _candidate_bases(
+    legend_cells: list[tuple[int, int, int]],
+    blocks: list[dict[str, int]],
+    step: int,
+) -> list[tuple[int, int]]:
+    seen: set[tuple[int, int]] = set()
+    for lr, lc, color in legend_cells:
+        for block in blocks:
+            if block["color"] != color:
+                continue
+            seen.add((block["r0"] - lr * step, block["c0"] - lc * step))
+    return sorted(seen)
+
+
+def _valid_base(
+    base: tuple[int, int],
+    legend: np.ndarray,
+    blocks: list[dict[str, int]],
+    grid_shape: tuple[int, int],
+    block_size: int,
+    step: int,
+) -> bool:
+    h, w = grid_shape
+    base_r, base_c = base
+    index_by_anchor = {(block["r0"], block["c0"]): block["color"] for block in blocks}
+    for block in blocks:
+        dr = block["r0"] - base_r
+        dc = block["c0"] - base_c
+        if dr % step != 0 or dc % step != 0:
+            return False
+        lr = dr // step
+        lc = dc // step
+        if not (0 <= lr < legend.shape[0] and 0 <= lc < legend.shape[1]):
+            return False
+        if int(legend[lr, lc]) != block["color"]:
+            return False
+    for lr in range(legend.shape[0]):
+        for lc in range(legend.shape[1]):
+            color = int(legend[lr, lc])
+            if color == BG:
+                continue
+            r0 = base_r + lr * step
+            c0 = base_c + lc * step
+            if not (0 <= r0 <= h - block_size and 0 <= c0 <= w - block_size):
+                return False
+            if (r0, c0) in index_by_anchor and index_by_anchor[(r0, c0)] != color:
+                return False
+    return True
+
+
+def _infer_mapping(grid: np.ndarray) -> dict[str, object]:
+    blocks = _find_square_blocks(grid, exclude_colors={BG, YELLOW})
+    assert blocks, "no block anchors found"
+    block_size = _dominant_block_size(blocks)
+    blocks = [block for block in blocks if block["size"] == block_size]
+    legend, legend_cells, legend_origin = _extract_legend(grid, blocks)
+    step = _infer_step(blocks)
+    candidates = [
+        base
+        for base in _candidate_bases(legend_cells, blocks, step)
+        if _valid_base(base, legend, blocks, grid.shape, block_size, step)
+    ]
+    assert len(candidates) == 1, "legend-to-block mapping must be unique"
+    base_r, base_c = candidates[0]
+    return {
+        "blocks": blocks,
+        "block_size": block_size,
+        "legend": legend,
+        "legend_cells": legend_cells,
+        "legend_origin": legend_origin,
+        "step": step,
+        "base": (base_r, base_c),
+    }
+
+
+def _complete_from_mapping(grid: np.ndarray, mapping: dict[str, object]) -> tuple[np.ndarray, list[dict[str, int]], set[tuple[int, int]]]:
+    out = np.array(grid, dtype=int, copy=True)
+    block_size = int(mapping["block_size"])
+    step = int(mapping["step"])
+    base_r, base_c = mapping["base"]
+    existing = {(block["r0"], block["c0"]) for block in mapping["blocks"]}
+    new_blocks: list[dict[str, int]] = []
+    for lr, lc, color in mapping["legend_cells"]:
+        r0 = base_r + lr * step
+        c0 = base_c + lc * step
+        if (r0, c0) in existing:
+            continue
+        out[r0 : r0 + block_size, c0 : c0 + block_size] = color
+        new_blocks.append({"r0": r0, "c0": c0, "size": block_size, "orig_color": color})
+    return out, new_blocks, existing
+
+
+def _stripe_colors(segment: dict[str, object], extent: int) -> list[tuple[int, int]]:
+    colors = (YELLOW, YELLOW, GREEN)
+    start = int(segment["start"])
+    direction = int(segment["direction"])
+    striped: list[tuple[int, int]] = []
+    step_idx = 0
+    while True:
+        pos = start + direction * (2 * step_idx)
+        if not (0 <= pos < extent):
+            break
+        striped.append((pos, colors[step_idx % 3]))
+        step_idx += 1
+    return striped
+
+
+def _apply_stripes(
+    grid: np.ndarray,
+    *,
+    segment: dict[str, object],
+    new_blocks: list[dict[str, int]],
+    bg: int,
+) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    span0 = int(segment["span0"])
+    span1 = int(segment["span1"])
+    if segment["axis"] == "h":
+        for pos, color in _stripe_colors(segment, h):
+            if color == GREEN:
+                for block in new_blocks:
+                    if block["r0"] == pos:
+                        r0 = block["r0"]
+                        c0 = block["c0"]
+                        size = block["size"]
+                        out[r0 : r0 + size, c0 : c0 + size] = GREEN
+                mask = out[pos, :] != bg
+                out[pos, mask] = GREEN
+            for c in range(span0, span1 + 1):
+                if out[pos, c] == bg:
+                    out[pos, c] = color
+    else:
+        for pos, color in _stripe_colors(segment, w):
+            if color == GREEN:
+                for block in new_blocks:
+                    if block["c0"] == pos:
+                        r0 = block["r0"]
+                        c0 = block["c0"]
+                        size = block["size"]
+                        out[r0 : r0 + size, c0 : c0 + size] = GREEN
+                mask = out[:, pos] != bg
+                out[mask, pos] = GREEN
+            for r in range(span0, span1 + 1):
+                if out[r, pos] == bg:
+                    out[r, pos] = color
+    return out
+
+
+def _axis_distance(edge: str, coord: int, size: int) -> int:
+    if edge in ("top", "left"):
+        return coord
+    return size - 1 - coord
+
+
+def _axis_color(edge: str, coord: int, size: int) -> int | None:
+    dist = _axis_distance(edge, coord, size)
+    if dist % 2 != 0:
+        return None
+    return (YELLOW, YELLOW, GREEN)[(dist // 2) % 3]
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a scaled block layout from a top-left minimap, then modulate only the newly added blocks with propagated stripes.
+
+    Input structure:
+    - The background is black.
+    - A small top-left minimap contains colored cells and black empties.
+    - Farther in the canvas, some uniformly colored square blocks already occupy a regular lattice, and a short yellow border segment marks one edge.
+
+    Rule:
+    - Infer the square block size, lattice step, and lattice offset by matching the existing blocks to the minimap colors and coordinates.
+    - For every non-black minimap cell whose mapped lattice position is still empty, add a solid square block of that minimap color.
+    - Propagate one-cell stripes from the yellow edge segment toward the opposite side with the repeating color cycle yellow, yellow, green on every other row or column.
+    - Yellow stripes only appear on background cells inside the segment span. Green stripes recolor every non-background pixel on their full row or column to green, and any newly added block anchored on that stripe becomes entirely green; pre-existing blocks are never wholly replaced.
+
+    Key insight:
+    - The minimap fixes where missing blocks belong, but the border stripes then selectively override some of those new blocks, so the final result requires combining a coordinate-mapping completion rule with a separate stripe-based recoloring rule.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    assert bg == BG, "this task uses black background"
+    mapping = _infer_mapping(g)
+    completed, new_blocks, _existing = _complete_from_mapping(g, mapping)
+    segment = _find_yellow_segment(g)
+    return _apply_stripes(completed, segment=segment, new_blocks=new_blocks, bg=bg)
+
+
+def _assign_colors(mask: np.ndarray, palette: tuple[int, ...]) -> np.ndarray | None:
+    k = mask.shape[0]
+    legend = np.zeros((k, k), dtype=int)
+    cells = [(r, c) for r in range(k) for c in range(k) if mask[r, c]]
+    random.shuffle(cells)
+    for r, c in cells:
+        forbidden = set()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            if 0 <= nr < k and 0 <= nc < k and legend[nr, nc] != 0:
+                forbidden.add(int(legend[nr, nc]))
+        choices = [color for color in palette if color not in forbidden]
+        if not choices:
+            return None
+        legend[r, c] = random.choice(choices)
+    return legend
+
+
+def _build_mask(k: int, edge: str, axis_colors: list[int]) -> np.ndarray | None:
+    mask = np.zeros((k, k), dtype=bool)
+    if edge in ("top", "bottom"):
+        green_rows = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_rows = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        if not green_rows or not yellow_rows:
+            return None
+        grow = random.choice(green_rows)
+        yrow = random.choice(yellow_rows)
+        gcols = random.sample(range(k), min(k, 3))
+        for c in gcols:
+            mask[grow, c] = True
+        ycols = random.sample(range(k), min(k, 2))
+        for c in ycols:
+            mask[yrow, c] = True
+        for r in range(k):
+            if mask[r].sum() == 0:
+                cols = random.sample(range(k), random.randint(1, min(3, k)))
+                for c in cols:
+                    mask[r, c] = True
+        for c in range(k):
+            if mask[:, c].sum() == 0:
+                mask[random.randrange(k), c] = True
+    else:
+        green_cols = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_cols = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        if not green_cols or not yellow_cols:
+            return None
+        gcol = random.choice(green_cols)
+        ycol = random.choice(yellow_cols)
+        grows = random.sample(range(k), min(k, 3))
+        for r in grows:
+            mask[r, gcol] = True
+        yrows = random.sample(range(k), min(k, 2))
+        for r in yrows:
+            mask[r, ycol] = True
+        for c in range(k):
+            if mask[:, c].sum() == 0:
+                rows = random.sample(range(k), random.randint(1, min(3, k)))
+                for r in rows:
+                    mask[r, c] = True
+        for r in range(k):
+            if mask[r].sum() == 0:
+                mask[r, random.randrange(k)] = True
+    for r in range(k):
+        for c in range(k):
+            if mask[r, c] and random.random() < 0.25:
+                tmp = mask.copy()
+                tmp[r, c] = False
+                if tmp.sum() >= 6 and tmp[r].any() and tmp[:, c].any():
+                    mask = tmp
+    if mask.sum() < 6:
+        return None
+    return mask
+
+
+def _select_existing(mask: np.ndarray, edge: str, axis_colors: list[int]) -> set[tuple[int, int]] | None:
+    filled = {(r, c) for r in range(mask.shape[0]) for c in range(mask.shape[1]) if mask[r, c]}
+    if edge in ("top", "bottom"):
+        green_rows = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_rows = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        green_cells = [(r, c) for (r, c) in filled if r in green_rows]
+        yellow_cells = [(r, c) for (r, c) in filled if r in yellow_rows]
+    else:
+        green_cols = [idx for idx, color in enumerate(axis_colors) if color == GREEN]
+        yellow_cols = [idx for idx, color in enumerate(axis_colors) if color == YELLOW]
+        green_cells = [(r, c) for (r, c) in filled if c in green_cols]
+        yellow_cells = [(r, c) for (r, c) in filled if c in yellow_cols]
+    if len(green_cells) < 3 or len(yellow_cells) < 2 or len(filled) < 7:
