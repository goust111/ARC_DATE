+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Complete a scaled block layout from a top-left minimap, then modulate only the newly added blocks with propagated stripes.
+
+    Input structure:
+    - The background is black.
+    - A small top-left minimap contains colored cells and black empties.
+    - Farther in the canvas, some uniformly colored square blocks already occupy a regular lattice, and a short yellow border segment marks one edge.
+
+    Rule:
+    - Infer the square block size, lattice step, and lattice offset by matching the existing blocks to the minimap colors and coordinates.
+    - For every non-black minimap cell whose mapped lattice position is still empty, add a solid square block of that minimap color.
+    - Propagate one-cell stripes from the yellow edge segment toward the opposite side with the repeating color cycle yellow, yellow, green on every other row or column.
+    - Yellow stripes only appear on background cells inside the segment span. Green stripes recolor every non-background pixel on their full row or column to green, and any newly added block anchored on that stripe becomes entirely green; pre-existing blocks are never wholly replaced.
+
+    Key insight:
+    - The minimap fixes where missing blocks belong, but the border stripes then selectively override some of those new blocks, so the final result requires combining a coordinate-mapping completion rule with a separate stripe-based recoloring rule.
+    """
+    g = np.asarray(grid, dtype=int)
+    bg = _get_bg(g)
+    assert bg == BG, "this task uses black background"
+    mapping = _infer_mapping(g)
+    completed, new_blocks, _existing = _complete_from_mapping(g, mapping)
+    segment = _find_yellow_segment(g)
+    return _apply_stripes(completed, segment=segment, new_blocks=new_blocks, bg=bg)
+
+
+def _assign_colors(mask: np.ndarray, palette: tuple[int, ...]) -> np.ndarray | None:
+    k = mask.shape[0]
+    legend = np.zeros((k, k), dtype=int)
+    cells = [(r, c) for r in range(k) for c in range(k) if mask[r, c]]
