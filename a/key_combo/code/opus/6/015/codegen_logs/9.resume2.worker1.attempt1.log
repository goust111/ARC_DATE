+    assert len(candidates) == 1, "legend-to-block mapping must be unique"
+    base_r, base_c = candidates[0]
+    return {
+        "blocks": blocks,
+        "block_size": block_size,
+        "legend": legend,
+        "legend_cells": legend_cells,
+        "legend_origin": legend_origin,
+        "step": step,
+        "base": (base_r, base_c),
+    }
+
+
+def _complete_from_mapping(grid: np.ndarray, mapping: dict[str, object]) -> tuple[np.ndarray, list[dict[str, int]], set[tuple[int, int]]]:
+    out = np.array(grid, dtype=int, copy=True)
+    block_size = int(mapping["block_size"])
+    step = int(mapping["step"])
+    base_r, base_c = mapping["base"]
