+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+GREEN = 3
+YELLOW = 4
+PALETTE = (1, 2, 5, 6, 7, 8, 9)
+STEP = 4
+BLOCK_SIZE_OPTIONS = (2, 3)
+EDGE_OPTIONS = ("top", "bottom", "left", "right")
+
+
+def _get_bg(grid: np.ndarray) -> int:
+    vals, counts = np.unique(grid, return_counts=True)
+    return int(vals[np.argmax(counts)])
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _components_of_color(grid: np.ndarray, color: int) -> list[np.ndarray]:
+    h, w = grid.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts = []
+            while stack:
+                rr, cc = stack.pop()
+                pts.append((rr, cc))
+                for nr, nc in ((rr - 1, cc), (rr + 1, cc), (rr, cc - 1), (rr, cc + 1)):
+                    if 0 <= nr < h and 0 <= nc < w and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            out.append(np.array(pts, dtype=int))
+    return out
+
+
+def _find_square_blocks(grid: np.ndarray, *, exclude_colors: set[int]) -> list[dict[str, int]]:
+    blocks: list[dict[str, int]] = []
+    for color in sorted(int(v) for v in np.unique(grid) if int(v) not in exclude_colors):
+        for pts in _components_of_color(grid, color):
+            if len(pts) < 4:
+                continue
+            r0, c0, r1, c1 = _bbox(pts)
+            side_r = r1 - r0 + 1
+            side_c = c1 - c0 + 1
+            if side_r != side_c or side_r < 2:
+                continue
+            if len(pts) != side_r * side_c:
+                continue
+            blocks.append({"r0": r0, "c0": c0, "size": side_r, "color": int(color)})
+    return sorted(blocks, key=lambda b: (b["r0"], b["c0"], b["color"]))
+
+
+def _find_yellow_segment(grid: np.ndarray) -> dict[str, object]:
+    h, w = grid.shape
+    border_yellow = np.zeros_like(grid, dtype=bool)
+    border_yellow[0, :] = grid[0, :] == YELLOW
+    border_yellow[h - 1, :] = grid[h - 1, :] == YELLOW
+    border_yellow[:, 0] |= grid[:, 0] == YELLOW
+    border_yellow[:, w - 1] |= grid[:, w - 1] == YELLOW
+    pts = np.argwhere(border_yellow)
+    assert len(pts) >= 2, "expected one yellow border segment"
+    r0, c0, r1, c1 = _bbox(pts)
+    if r0 == r1:
+        edge = "top" if r0 == 0 else "bottom"
+        return {
+            "edge": edge,
+            "axis": "h",
+            "start": int(r0),
+            "direction": 1 if edge == "top" else -1,
+            "span0": int(c0),
+            "span1": int(c1),
+        }
+    assert c0 == c1, "yellow border marker must be a straight segment"
+    edge = "left" if c0 == 0 else "right"
+    return {
+        "edge": edge,
+        "axis": "v",
+        "start": int(c0),
+        "direction": 1 if edge == "left" else -1,
+        "span0": int(r0),
+        "span1": int(r1),
+    }
+
+
+def _extract_legend(grid: np.ndarray, blocks: list[dict[str, int]]) -> tuple[np.ndarray, list[tuple[int, int, int]], tuple[int, int]]:
+    used = np.zeros_like(grid, dtype=bool)
+    for block in blocks:
+        r0 = block["r0"]
+        c0 = block["c0"]
+        size = block["size"]
+        used[r0 : r0 + size, c0 : c0 + size] = True
+    legend_pts = [
+        (r, c, int(grid[r, c]))
+        for r, c in np.argwhere((grid != BG) & (grid != YELLOW) & (~used))
+    ]
+    assert legend_pts, "legend pixels not found"
+    coords = np.array([(r, c) for r, c, _ in legend_pts], dtype=int)
+    r0, c0, r1, c1 = _bbox(coords)
+    sprite = grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+    local = [(r - r0, c - c0, v) for r, c, v in legend_pts]
+    return sprite, sorted(local), (r0, c0)
