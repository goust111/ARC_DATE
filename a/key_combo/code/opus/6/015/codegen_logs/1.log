+    "right": (0, 1),
+    "left": (0, -1),
+    "up": (-1, 0),
+    "down": (1, 0),
+}
+_PERP = {
+    "right": ("up", "down"),
+    "left": ("up", "down"),
+    "up": ("left", "right"),
+    "down": ("left", "right"),
+}
+
+
+def _mode_color(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])
