+def _has_corridor(grid: np.ndarray, r: int, c: int, direction: str, bg: int) -> bool:
+    h, w = grid.shape
+    if not (0 <= r < h and 0 <= c < w):
+        return False
+    if int(grid[r, c]) not in {bg, PARTICLE}:
+        return False
+    if direction in {"left", "right"}:
+        if r == 0 or r == h - 1:
+            return False
+        a = int(grid[r - 1, c])
+        b = int(grid[r + 1, c])
+    else:
+        if c == 0 or c == w - 1:
+            return False
+        a = int(grid[r, c - 1])
+        b = int(grid[r, c + 1])
+    return a == b and a not in {bg, PARTICLE}
+
