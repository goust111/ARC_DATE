+def _find_legend(grid: np.ndarray, bg: int) -> list[int]:
+    h, w = grid.shape
+    candidates: list[tuple[int, list[int]]] = []
+    for c in range(w):
+        vals: list[int] = []
+        ok = True
+        for r in range(h):
+            v = int(grid[r, c])
+            if v in {bg, PARTICLE}:
+                break
+            if c > 0 and int(grid[r, c - 1]) != bg:
+                ok = False
+                break
+            if c + 1 < w and int(grid[r, c + 1]) != bg:
+                ok = False
+                break
+            vals.append(v)
+        if not ok:
+            continue
+        k = len(vals)
+        if 2 <= k <= 4 and len(set(vals)) == k:
