+            block = g[r0:r1, c0:c1]
+            assert block.shape == (block_size, block_size)
+            assert not np.any(block == GREY), "separator color must stay out of blocks"
+            assert not np.any(block == TEAL), "cross color must stay on separator lines"
+            blocks[br, bc] = block
