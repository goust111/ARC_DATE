+        "cross_col_sep_index": cross_col_sep_index,
+    }
+
+
+def _consensus_and_damage(parsed: dict) -> tuple[np.ndarray, tuple[int, int], np.ndarray]:
+    blocks = parsed["blocks"]
+    block_rows, block_cols, block_size, _ = blocks.shape
