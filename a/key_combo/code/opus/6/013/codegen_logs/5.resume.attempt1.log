+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+SEP = 5
+PATTERN_COLORS = (BLUE, GREEN)
+OCCLUDER_COLORS = (RED, YELLOW)
+TILE_SHAPES = ((2, 2), (2, 3), (3, 2), (3, 3))
+HALF_HEIGHT_RANGE = (6, 9)
+WIDTH_RANGE = (10, 16)
+MAX_GENERATION_ATTEMPTS = 500
+RECTANGLE_ATTEMPTS = 120
+SET_ATTEMPTS = 120
+TILE_ATTEMPTS = 80
+MASK_COVER_MIN = 0.18
+MASK_COVER_MAX = 0.42
+
+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    parts: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                cells.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            parts.append(np.array(cells, dtype=int))
+    return parts
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _is_full_rectangle(coords: np.ndarray) -> bool:
+    r0, c0, r1, c1 = _bbox(coords)
+    return int(coords.shape[0]) == (r1 - r0 + 1) * (c1 - c0 + 1)
+
+
+def _repeat_tile(tile: np.ndarray, shape: tuple[int, int]) -> np.ndarray:
+    h, w = shape
+    rr = np.arange(h)[:, None] % tile.shape[0]
+    cc = np.arange(w)[None, :] % tile.shape[1]
+    return tile[rr, cc]
+
+
+def _phase_repeat(tile: np.ndarray, shape: tuple[int, int], row_phase: int, col_phase: int) -> np.ndarray:
+    h, w = shape
+    rr = (np.arange(h)[:, None] + row_phase) % tile.shape[0]
+    cc = (np.arange(w)[None, :] + col_phase) % tile.shape[1]
+    return tile[rr, cc]
+
+
+def _row_period(grid: np.ndarray) -> int:
+    h = grid.shape[0]
+    for period in range(1, h + 1):
+        ok = True
+        for r in range(h):
+            if not np.array_equal(grid[r], grid[r % period]):
+                ok = False
+                break
+        if ok:
+            return period
+    raise AssertionError("row period should exist")
+
+
+def _col_period(grid: np.ndarray) -> int:
+    w = grid.shape[1]
+    for period in range(1, w + 1):
+        ok = True
+        for c in range(w):
+            if not np.array_equal(grid[:, c], grid[:, c % period]):
+                ok = False
+                break
+        if ok:
+            return period
+    raise AssertionError("column period should exist")
+
+
+def _minimal_tile(grid: np.ndarray) -> np.ndarray:
+    rp = _row_period(grid)
+    cp = _col_period(grid)
+    return grid[:rp, :cp].copy()
+
+
+def _periodic_canvases_from_visible(
+    target: np.ndarray,
+    visible_mask: np.ndarray,
+    *,
+    limit: int | None = None,
+) -> list[np.ndarray]:
+    h, w = target.shape
+    coords = np.argwhere(visible_mask)
+    visible = target[visible_mask]
+    outputs: dict[bytes, np.ndarray] = {}
+    for rp, cp in TILE_SHAPES:
+        if rp > h or cp > w:
+            continue
+        residue_values: dict[tuple[int, int], int] = {}
+        consistent = True
+        for r, c in coords:
+            key = (int(r) % rp, int(c) % cp)
+            value = int(target[int(r), int(c)])
+            if key in residue_values and residue_values[key] != value:
+                consistent = False
+                break
+            residue_values[key] = value
+        if not consistent:
+            continue
+
+        missing = [(r, c) for r in range(rp) for c in range(cp) if (r, c) not in residue_values]
+        for bits in range(1 << len(missing)):
+            tile = np.empty((rp, cp), dtype=int)
+            for (r, c), value in residue_values.items():
+                tile[r, c] = value
+            for i, (r, c) in enumerate(missing):
+                tile[r, c] = PATTERN_COLORS[(bits >> i) & 1]
+            if set(map(int, tile.ravel())) != set(PATTERN_COLORS):
+                continue
+            full = _repeat_tile(tile, (h, w))
+            if not np.array_equal(full[visible_mask], visible):
+                continue
+            if _minimal_tile(full).shape != tile.shape:
+                continue
+            key = full.tobytes()
+            if key not in outputs:
+                outputs[key] = full
+                if limit is not None and len(outputs) >= limit:
+                    return list(outputs.values())
+    return list(outputs.values())
+
+
+def _separator_row(grid: np.ndarray) -> int:
+    rows = [r for r in range(grid.shape[0]) if np.all(grid[r] == SEP)]
+    assert len(rows) == 1, "expected one full separator row"
+    sep = rows[0]
+    assert grid.shape[0] == 2 * sep + 1, "separator must split the grid into equal halves"
+    return int(sep)
+
+
+def _validate_half(half: np.ndarray) -> np.ndarray:
+    allowed = set(PATTERN_COLORS) | set(OCCLUDER_COLORS)
+    assert set(map(int, np.unique(half))).issubset(allowed), "unexpected color in half-grid"
+    occluder_mask = ~np.isin(half, PATTERN_COLORS)
+    parts = _components(occluder_mask)
+    assert 1 <= len(parts) <= 2, "each half should contain one or two occluders"
+    for coords in parts:
+        assert _is_full_rectangle(coords), "occluders must be solid rectangles"
