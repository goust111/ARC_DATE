+        return False
+
+    top_candidates = _periodic_canvases_from_visible(full_top, ~top_mask, limit=2)
+    mirrored_candidates = _periodic_canvases_from_visible(full_top, ~mirrored_mask, limit=2)
+    if len(top_candidates) < 2 or len(mirrored_candidates) < 2:
+        return False
+    if not any(np.array_equal(cand, full_top) for cand in top_candidates):
+        return False
+    if not any(np.array_equal(cand, full_top) for cand in mirrored_candidates):
+        return False
