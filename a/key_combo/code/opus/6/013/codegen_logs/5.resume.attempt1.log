+    full_top: np.ndarray,
+    top_rects: list[tuple[int, int, int, int]],
+    mirrored_bottom_rects: list[tuple[int, int, int, int]],
+) -> bool:
+    h, w = full_top.shape
+    top_mask = _mask_from_rectangles((h, w), top_rects)
+    mirrored_mask = _mask_from_rectangles((h, w), mirrored_bottom_rects)
