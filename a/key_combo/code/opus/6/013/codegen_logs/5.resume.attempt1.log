        elif single_candidates:
            nr, nc = random.choice(single_candidates)
        else:
            nr, nc = random.choice(list(candidates))
        half[nr, nc] = True
    return True


def _gen_full_from_half(half: np.ndarray, w: int) -> np.ndarray:
    h, q = half.shape
