    height: 4-8 rows per bar
    gap: exactly 1 bg row between consecutive bars
    colors: each bar has unique fill_color and unique border_color; fill != border; all fill colors distinct across bars
    border_color: may equal another bar's fill_color [observed]
  sprites:
    location: top area (above first bar), separated by bg
    count: 2-3 visual sprites (connected non-bg components)
    size: 2x2 to 5x9; height 2-5, width 2-9
