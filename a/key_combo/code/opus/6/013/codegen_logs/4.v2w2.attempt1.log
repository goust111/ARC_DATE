    symmetry: LR-symmetric [observed]
    matching: sprite outer_color == target bar's fill_color; 1-2 sprites per bar, 0 sprites for some bars allowed
    fit: sprite height <= target bar height; sprite x-range within cols 1..W-2
    no_x_overlap: sprites sharing same target bar must not overlap horizontally
  transform:
    erase: clear all sprites from top area (fill with bg)
    place: bottom-align each sprite within its matched bar at original x-position
