+    side_h = int(r1 - r0 + 1)
+    side_w = int(c1 - c0 + 1)
+    if side_h != side_w or side_h < 2:
+        return False
+    border = np.zeros((side_h, side_w), dtype=bool)
+    border[0, :] = True
+    border[-1, :] = True
+    border[:, 0] = True
+    border[:, -1] = True
