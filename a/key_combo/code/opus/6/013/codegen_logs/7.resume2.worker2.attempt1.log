+    col_range = range(1 if require_margin else 0, gw - w - (1 if require_margin else 0) + 1)
+    candidates = [(r0, c0) for r0 in row_range for c0 in col_range]
+    random.shuffle(candidates)
+    for r0, c0 in candidates:
