+        pad_c0 = max(0, c0 - 1)
+        pad_r1 = min(gh - 1, r1 + 1)
+        pad_c1 = min(gw - 1, c1 + 1)
+        if np.any(reserved[pad_r0 : pad_r1 + 1, pad_c0 : pad_c1 + 1]):
