+OUTPUT_CYCLE = (2, 8, 5)
+SQUARE_COLOR_POOL = (1, 3, 4, 6, 7, 9)
+ALL_OBJECT_COLORS = (1, 2, 3, 4, 5, 6, 7, 8, 9)
+GEN_ATTEMPTS = 600
+_SEEN_OUTPUT_SIGNATURES: set[str] = set()
