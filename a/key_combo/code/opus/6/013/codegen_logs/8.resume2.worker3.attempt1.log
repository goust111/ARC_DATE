+GRID_W_RANGE = (13, 18)
+MARKER_COUNT_RANGE = (2, 4)
+OFFSET_POOL = [
+    (-3, -2),
+    (-3, -1),
+    (-2, -3),
+    (-2, -1),
+    (-2, 2),
+    (-1, -3),
+    (-1, 2),
+    (-1, 3),
+    (1, -3),
+    (1, 3),
+    (2, -2),
+    (2, 1),
+    (3, -1),
