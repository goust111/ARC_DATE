+def _infer_order(grid: np.ndarray, rects: list[dict]) -> list[int] | None:
+    n = len(rects)
+    edges: set[tuple[int, int]] = set()
+
+    for i, j in combinations(range(n), 2):
+        a = rects[i]
+        b = rects[j]
+        ar0, ac0, ar1, ac1 = a["bbox"]
+        br0, bc0, br1, bc1 = b["bbox"]
+        r0 = max(ar0, br0)
+        c0 = max(ac0, bc0)
+        r1 = min(ar1, br1)
+        c1 = min(ac1, bc1)
