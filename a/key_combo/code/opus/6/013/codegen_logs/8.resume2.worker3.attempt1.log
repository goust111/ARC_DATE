 251: def _gen_attempt() -> np.ndarray | None:
 252:     dims = _sample_dimensions()
 253:     if dims is None:
 254:         return None
 255:     mask_h, mask_w, gap, grid_h, grid_w = dims
 256: 
 257:     column_colors, hole_color = _sample_palette(mask_w)
 258:     area = int(mask_h) * int(mask_w)
 259:     min_area = int(np.ceil(MASK_DENSITY_MIN * area))
 260:     max_area = int(np.floor(MASK_DENSITY_MAX * area))
 261:     target_area = random.randint(min_area, max_area)
 262:     mask = _connected_mask(mask_h, mask_w, target_area)
 263:     if mask is None:
 264:         return None
 265: 
 266:     output = np.tile(column_colors, (int(mask_h), 1))
 267:     output[~mask] = int(hole_color)
 268:     mask = output != int(hole_color)
 269:     grid = _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color)
 270:     if np.array_equal(main(grid), output):
 271:         return grid
 272:     return None
