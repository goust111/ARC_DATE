+
+    anchor_r = random.randint(lo_r, hi_r)
+    anchor_c = random.randint(lo_c, hi_c)
+    positions = [(anchor_r + dr, anchor_c + dc) for dr, dc in offsets]
+    return rect_shape, positions, list(base["order"]), (gh, gw)
