 207: def _sample_dimensions() -> tuple[int, int, int, int, int] | None:
 208:     """Sample mask size, layout gap, and compatible grid size."""
 209:     mask_h = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)
 210:     mask_w = random.randint(MASK_SIDE_MIN, MASK_SIDE_MAX)
 211:     gap = random.randint(GAP_MIN, GAP_MAX)
 212:     grid_choices = _grid_choices(mask_h, mask_w, gap)
 213:     if not grid_choices:
 214:         return None
 215:     grid_h, grid_w = random.choice(grid_choices)
 216:     return mask_h, mask_w, gap, grid_h, grid_w
