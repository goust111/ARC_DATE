 228: def _compose_grid(grid_h, grid_w, gap, mask, column_colors, hole_color) -> np.ndarray:
 229:     """Paste mask and palette into disjoint row bands of a blank grid."""
 230:     mask_h, mask_w = map(int, mask.shape)
 231:     hole_row = np.full(int(mask_w), int(hole_color), dtype=int)
 232:     palette = np.vstack([column_colors, column_colors, hole_row])
 233:     mask_sprite = np.where(mask, MASK_COLOR, BACKGROUND_COLOR)
 234:     grid = np.zeros((int(grid_h), int(grid_w)), dtype=int)
 235:     block_h = int(mask_h) + PALETTE_HEIGHT + int(gap)
 236:     top = random.randint(0, int(grid_h) - block_h)
 237:     palette_above = random.choice([True, False])
 238:     if palette_above:
 239:         palette_r = top
 240:         mask_r = top + PALETTE_HEIGHT + int(gap)
 241:     else:
 242:         mask_r = top
 243:         palette_r = top + int(mask_h) + int(gap)
 244:     mask_c = random.randint(0, int(grid_w) - int(mask_w))
 245:     palette_c = random.randint(0, int(grid_w) - int(mask_w))
 246:     paste(grid, mask_sprite, mask_r, mask_c, transparent=BACKGROUND_COLOR)
 247:     paste(grid, palette, palette_r, palette_c, transparent=None)
 248:     return grid
