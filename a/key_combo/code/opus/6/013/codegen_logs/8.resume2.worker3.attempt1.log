 128: def _palette_row(width: int, colors: list[int]) -> np.ndarray:
 129:     valid_counts = [
 130:         n_runs for n_runs in RUN_COUNT_OPTIONS if _valid_run_lengths(int(width), n_runs)
 131:     ]
 132:     n_runs = random.choice(valid_counts)
 133:     valid_lengths = _valid_run_lengths(int(width), n_runs)
 134:     lengths = random.choice(valid_lengths)
 135:     n_distinct = random.randint(
 136:         COLUMN_COLOR_DISTINCT_MIN, min(COLUMN_COLOR_DISTINCT_MAX, n_runs)
 137:     )
 138:     chosen = random.sample(colors, n_distinct)
 139:     seq = _run_colors(chosen, n_runs)
 140:     return np.repeat(seq, lengths).astype(int)
