+def sparse_components(mask: np.ndarray) -> list[np.ndarray]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    remaining = set(coords)
+    comps = []
+    while remaining:
+        start = remaining.pop()
+        q = deque([start])
+        pts = [start]
