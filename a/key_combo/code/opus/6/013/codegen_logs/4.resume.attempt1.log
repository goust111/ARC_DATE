+
+
+def largest_bg_rectangle(subgrid: np.ndarray, bg: int) -> tuple[int, int, int, int] | None:
+    h, w = subgrid.shape
+    best = None
+    best_key = None
+    bg_mask = subgrid == int(bg)
+    for r0 in range(h):
+        for c0 in range(w):
+            if not bg_mask[r0, c0]:
+                continue
+            for r1 in range(r0, h):
+                for c1 in range(c0, w):
+                    if not bg_mask[r0 : r1 + 1, c0 : c1 + 1].all():
