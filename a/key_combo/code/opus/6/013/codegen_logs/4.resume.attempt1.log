+            shift_r = 0
+            shift_c = cavity_c0 - dense_c0
+            assert dense_r0 == cavity_r0 and dense_r1 == cavity_r1
+        else:
+            shift_r = cavity_r0 - dense_r0
+            shift_c = 0
+            assert dense_c0 == cavity_c0 and dense_c1 == cavity_c1
