+        for r, c in dense_coords:
+            rr = int(r + shift_r)
+            cc = int(c + shift_c)
+            if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+                out[rr, cc] = int(sprite["color"])
+    return out
+
