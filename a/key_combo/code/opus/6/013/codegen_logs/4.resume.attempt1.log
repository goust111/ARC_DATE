+        for cc in range(w):
+            val = int(patch[rr, cc])
+            if val != int(transparent):
+                canvas[r0 + rr, c0 + cc] = val
+
+
+def random_free_location(canvas: np.ndarray, patch: np.ndarray, *, transparent: int = BACKGROUND, padding: int = 0) -> tuple[int, int] | None:
+    h, w = canvas.shape
+    ph, pw = patch.shape
+    mask = patch != transparent
+    if not mask.any():
+        return 0, 0
+    occ = canvas != transparent
+    if padding > 0:
+        expanded = occ.copy()
+        base = occ.copy()
+        for dr in range(-padding, padding + 1):
+            for dc in range(-padding, padding + 1):
+                if dr == 0 and dc == 0:
+                    continue
+                src_r0 = max(0, -dr)
+                src_r1 = min(h, h - dr)
+                src_c0 = max(0, -dc)
+                src_c1 = min(w, w - dc)
+                dst_r0 = max(0, dr)
+                dst_r1 = min(h, h + dr)
+                dst_c0 = max(0, dc)
+                dst_c1 = min(w, w + dc)
