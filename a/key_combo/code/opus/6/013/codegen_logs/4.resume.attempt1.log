+    if expect_extra and not place_extra_sprite(inp, out, colors):
+        return None
+    if not semantic_checks(inp, out, n_structures, expect_extra):
+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = gen_attempt()
+        if grid is not None:
+            return grid
