+        if loc is None:
+            return False
+        r0, c0 = loc
+        trial_inp = inp.copy()
+        trial_out = out.copy()
+        paste(trial_inp, patch, r0, c0)
+        paste(trial_out, patch, r0, c0)
+        try:
