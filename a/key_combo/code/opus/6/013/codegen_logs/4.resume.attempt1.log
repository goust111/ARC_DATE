+    directions: dict[int, tuple[int, int]] = {}
+    used_sprites: set[int] = set()
+    for structure in structures:
+        matches = []
+        for direction in DIRS:
+            comp_id = ray_hit_component(grid, structure, direction, coord_to_comp, bg)
