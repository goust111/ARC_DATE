+
+BACKGROUND = 0
+TRAIL = 9
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+STRUCTURE_COLORS = (1, 3, 6, 7, 8)
+GEN_RETRIES = 500
+GRID_RANGE = (20, 28)
