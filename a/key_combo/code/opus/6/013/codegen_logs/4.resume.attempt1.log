0147: def _build_bars(bg: int, fills: list[int], borders: list[int],
0148:                 heights: list[int]) -> tuple[np.ndarray, list[dict]]:
0149:     """Render horizontal bars bottom-up and return (grid, bar_info_list)."""
0150:     grid = np.full((GRID_H, GRID_W), bg, dtype=int)
0151:     bars = [None] * len(heights)
0152:     r = GRID_H
0153:     for i in range(len(heights) - 1, -1, -1):
0154:         h = heights[i]
0155:         r0, r1 = r - h, r - 1
0156:         grid[r0:r1 + 1, 1:GRID_W - 1] = fills[i]
0157:         grid[r0:r1 + 1, 0] = borders[i]
0158:         grid[r0:r1 + 1, GRID_W - 1] = borders[i]
0159:         bars[i] = {"fill": fills[i], "border": borders[i],
0160:                     "h": h, "r_min": r0, "r_max": r1}
0161:         r = r0 - 1
0162:     return grid, bars
