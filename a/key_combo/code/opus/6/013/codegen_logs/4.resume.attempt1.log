+    bg, _, sprites, _ = detect_structures(inp)
+    unmatched = [sp for sp in sprites if sp["id"] not in matched_sprite_ids]
+    if expect_extra and len(unmatched) != 1:
+        return False
+    if not expect_extra and unmatched:
+        return False
+    for structure in structures:
