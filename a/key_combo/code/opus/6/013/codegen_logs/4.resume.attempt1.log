            }
        )
    structure_ids = {s["id"] for s in structures}
    sprites = [comp for comp in components if comp["id"] not in structure_ids]
    return bg, structures, sprites, coord_to_comp


def cavity_center(cavity_bbox: tuple[int, int, int, int]) -> tuple[int, int]:
    r0, c0, r1, c1 = cavity_bbox
    return (r0 + r1 + 1) // 2, (c0 + c1 + 1) // 2


def ray_hit_component(
    grid: np.ndarray,
    structure: dict,
    direction: tuple[int, int],
    coord_to_comp: dict[tuple[int, int], int],
    bg: int,
) -> int | None:
    h, w = grid.shape
    sr0, sc0, sr1, sc1 = structure["bbox"]
    rr, cc = cavity_center(structure["cavity_bbox"])
    dr, dc = direction
    rr += dr
    cc += dc
    left_bbox = False
    while 0 <= rr < h and 0 <= cc < w and int(grid[rr, cc]) == int(bg):
        if not (sr0 <= rr <= sr1 and sc0 <= cc <= sc1):
            left_bbox = True
        rr += dr
        cc += dc
    if not (0 <= rr < h and 0 <= cc < w):
        return None
    if not left_bbox:
        return None
    if int(grid[rr, cc]) != int(structure["color"]):
        return None
    comp_id = coord_to_comp.get((int(rr), int(cc)))
    if comp_id is None or comp_id == int(structure["id"]):
        return None
    return int(comp_id)



