0011: def _unique_shortest_path(g: np.ndarray, start: tuple[int, int], goal: tuple[int, int]) -> list[tuple[int, int]]:
0012:     H, W = map(int, g.shape)
0013:     dist = {start: 0}
0014:     q: deque[tuple[int, int]] = deque([start])
0015: 
0016:     while q:
0017:         r, c = q.popleft()
0018:         for nr, nc in neighbors4(r, c):
0019:             if not in_bounds((H, W), nr, nc):
0020:                 continue
0021:             if int(g[nr, nc]) == Color.BLUE:
0022:                 continue
0023:             if (nr, nc) not in dist:
0024:                 dist[(nr, nc)] = dist[(r, c)] + 1
0025:                 q.append((nr, nc))
0026: 
0027:     assert goal in dist, "expected the red endpoints to be connected through background cells"
0028: 
0029:     path: list[tuple[int, int]] = []
0030:     cur = goal
0031:     while cur != start:
0032:         r, c = cur
0033:         predecessors = [
0034:             (nr, nc)
0035:             for nr, nc in neighbors4(r, c)
0036:             if (nr, nc) in dist and dist[(nr, nc)] == dist[cur] - 1
0037:         ]
0038:         assert len(predecessors) == 1, "expected a unique shortest path between the red endpoints"
0039:         cur = predecessors[0]
0040:         if cur != start:
0041:             path.append(cur)
0042: 
0043:     assert len(path) == dist[goal] - 1, "path reconstruction length mismatch"
0044:     return path
0045: 
