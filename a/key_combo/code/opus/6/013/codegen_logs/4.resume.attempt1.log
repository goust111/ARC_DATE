+def sparse_components(mask: np.ndarray) -> list[np.ndarray]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    remaining = set(coords)
+    comps = []
+    while remaining:
+        start = remaining.pop()
+        q = deque([start])
+        pts = [start]
+        while q:
+            r, c = q.popleft()
+            near = [
+                (rr, cc)
+                for rr, cc in list(remaining)
+                if abs(rr - r) <= 2
+                and abs(cc - c) <= 2
+                and max(abs(rr - r), abs(cc - c)) == 2
+            ]
+            for nxt in near:
+                remaining.remove(nxt)
+                q.append(nxt)
+                pts.append(nxt)
