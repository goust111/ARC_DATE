0047: def main(grid: np.ndarray) -> np.ndarray:
0048:     """
0049:     Paint the unique shortest background path between the two red endpoints yellow.
0050: 
0051:     Input structure
0052:     - The grid contains black background cells, blue blocker cells, and exactly two red endpoint pixels.
0053:     - The endpoints are connected by one shortest 4-neighbor route through non-blue cells.
0054: 
0055:     Rule
0056:     - Keep every original cell unchanged.
0057:     - Find the unique shortest 4-neighbor path from one red endpoint to the other while treating blue cells as blocked.
0058:     - Recolor only the black interior cells of that path to yellow.
0059: 
0060:     Key insight
0061:     - The blue cells form maze walls, and the output is the single shortest corridor between the two red endpoints.
0062:     """
0063:     g = np.asarray(grid, dtype=int)
0064:     assert g.ndim == 2, "expected a 2D grid"
0065:     assert set(map(int, np.unique(g))) <= {Color.BLACK, Color.BLUE, Color.RED}, "unexpected input colors"
0066: 
0067:     red_coords = np.argwhere(g == Color.RED)
0068:     assert red_coords.shape == (2, 2), "expected exactly two red endpoints"
0069:     start = tuple(map(int, red_coords[0]))
0070:     goal = tuple(map(int, red_coords[1]))
0071: 
0072:     out = g.copy()
0073:     for r, c in _unique_shortest_path(g, start, goal):
0074:         assert int(out[r, c]) == Color.BLACK, "path interior should contain only background cells"
0075:         out[r, c] = Color.YELLOW
0076:     return out
