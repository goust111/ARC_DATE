+        assert dense_bbox[2] - dense_bbox[0] == cavity_bbox[2] - cavity_bbox[0]
+        assert dense_bbox[3] - dense_bbox[1] == cavity_bbox[3] - cavity_bbox[1]
+    return structures, assignments, directions
