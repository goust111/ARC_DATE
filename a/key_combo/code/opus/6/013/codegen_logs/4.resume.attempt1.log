+        for r, c in open_ray_cells(inp, struct, directions[int(struct["id"])], BACKGROUND):
+            blocked[int(r), int(c)] = max(1, int(struct["color"]))
+    struct = structure_by_color[color]
+    for r, c in open_ray_cells(inp, struct, directions[int(struct["id"])], BACKGROUND):
+        blocked[int(r), int(c)] = max(1, color)
