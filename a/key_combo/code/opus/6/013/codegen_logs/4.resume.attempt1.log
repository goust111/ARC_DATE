+import numpy as np
+
+
+BACKGROUND = 0
+TRAIL = 9
+DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+STRUCTURE_COLORS = (1, 3, 6, 7, 8)
+GEN_RETRIES = 500
+GRID_RANGE = (20, 28)
+STRUCTURE_COUNT_CHOICES = (2, 3)
+SLIDE_RANGE = (5, 8)
+PLACE_PADDING = 2
+EXTRA_SPRITE_PROB = 0.6
