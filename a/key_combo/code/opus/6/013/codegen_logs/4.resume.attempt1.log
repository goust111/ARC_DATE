+            return False
+        if direction[0] == 0 and dense_bbox[0] != cavity_bbox[0]:
+            return False
+        if direction[1] == 0 and dense_bbox[1] != cavity_bbox[1]:
+            return False
+    for sprite in unmatched:
+        for r, c in sprite["coords"]:
+            if int(out[r, c]) != int(sprite["color"]):
+                return False
+    return True
