+def sparse_patch(logical_mask: np.ndarray, color: int) -> np.ndarray:
+    patch = np.full((3, 3), BACKGROUND, dtype=int)
+    for lr in range(2):
+        for lc in range(2):
+            if logical_mask[lr, lc]:
