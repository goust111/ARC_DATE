+        sprite = assignments[int(structure["id"])]
+        cavity_bbox = structure["cavity_bbox"]
+        dense_bbox = bbox_coords(densify_component(sprite["coords"]))
+        if (dense_bbox[2] - dense_bbox[0], dense_bbox[3] - dense_bbox[1]) != (
