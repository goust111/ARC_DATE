+def gen_attempt() -> np.ndarray | None:
+    h = random.randint(*GRID_RANGE)
+    w = random.randint(*GRID_RANGE)
+    n_structures = random.choice(STRUCTURE_COUNT_CHOICES)
+    expect_extra = n_structures == 2 and random.random() < EXTRA_SPRITE_PROB
