    specs = []
    for color in colors:
        logical = random.choice(mod.LOGICAL_MASKS)
        slide = random.randint(*mod.SLIDE_RANGE)
        rot_k = random.randrange(4)
        inp_patch, out_patch = mod.canonical_patches(color, logical, slide)
        specs.append({'input': np.rot90(inp_patch, rot_k).copy(), 'output': np.rot90(out_patch, rot_k).copy()})
    specs.sort(key=lambda item: np.count_nonzero(item['output']), reverse=True)
    inp = np.full((h, w), mod.BACKGROUND, dtype=int)
    out = np.full((h, w), mod.BACKGROUND, dtype=int)
    occ = np.zeros((h, w), dtype=int)
    fail = None
    for spec in specs:
        block = np.ones(spec['output'].shape, dtype=int)
        loc = mod.random_free_location(occ, block, transparent=0, padding=mod.PLACE_PADDING)
        if loc is None:
            fail = 'place'
            break
        mod.paste(inp, spec['input'], loc[0], loc[1])
        mod.paste(out, spec['output'], loc[0], loc[1])
        mod.paste(occ, block, loc[0], loc[1], transparent=0)
    if fail is None and expect_extra and not mod.place_extra_sprite(inp, out, colors):
        fail = 'extra'
    if fail is None and not mod.semantic_checks(inp, out, n_structures, expect_extra):
        fail = 'semantic'
    if fail is None:
        fail = 'ok'
    reasons[fail] = reasons.get(fail, 0) + 1
print(reasons)
