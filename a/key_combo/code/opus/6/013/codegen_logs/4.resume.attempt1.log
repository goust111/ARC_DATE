0131:     g = np.asarray(grid, dtype=int)
0132:     assert g.ndim == 2
0133: 
0134:     bg = get_bg(g)
0135:     counts = Counter(map(int, g.ravel()))
0136:     non_bg = colors_present(g, exclude={bg})
0137:     assert non_bg, "expected foreground colors"
