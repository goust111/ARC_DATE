+    color = int(random.choice(colors))
+    logical = random.choice(LOGICAL_MASKS)
+    patch = sparse_patch(logical, color)
+    blocked = inp.copy()
+    for struct in structures:
+        for r, c in open_ray_cells(inp, struct, directions[int(struct["id"])], BACKGROUND):
