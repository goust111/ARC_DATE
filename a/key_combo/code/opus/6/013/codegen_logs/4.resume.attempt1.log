+        sprite = assignments[int(structure["id"])]
+        direction = directions[int(structure["id"])]
+        dense_coords = densify_component(sprite["coords"])
+        dr, dc = direction
+        cavity_r0, cavity_c0, cavity_r1, cavity_c1 = structure["cavity_bbox"]
