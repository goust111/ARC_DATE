0047:             else:
0048:                 if current_bar:
0049:                     bars.append(current_bar)
0050:                     current_bar = None
0051:         else:
0052:             if current_bar:
0053:                 bars.append(current_bar)
0054:                 current_bar = None
0055:     if current_bar:
0056:         bars.append(current_bar)
0057: 
