def _gen_max_trail_total(n: int, k: int) -> int:
    bg_gt_trail = (n * n - n - 2 * k - 1) // 2
    bg_gt_separator = n * n - 2 * n - 2 * k - 1
    return min(bg_gt_trail, bg_gt_separator)


def _gen_segment_options(
    n: int,
