+def _place_object(shape: tuple[int, int], path: list[Coord], occupied: set[Coord]) -> tuple[Coord, list[Coord]] | None:
+    rows = [0] + [dr for dr, _dc in path]
+    cols = [0] + [dc for _dr, dc in path]
