+    prev = source
+    cur = adjacent[0]
+    ordered: list[Coord] = []
+    seen: set[Coord] = set()
+    while True:
+        assert cur not in seen, "path cannot loop"
+        ordered.append(cur)
+        seen.add(cur)
+        nxt = [neighbor for neighbor in neighbors4(*cur) if neighbor in cells and neighbor != prev]
+        assert len(nxt) <= 1, "path traversal must be unique"
