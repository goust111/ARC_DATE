+def _path_dirs(path: list[Coord], source: Coord) -> list[Coord]:
+    points = [source] + path
+    return [
+        (points[i + 1][0] - points[i][0], points[i + 1][1] - points[i][1])
+        for i in range(len(points) - 1)
