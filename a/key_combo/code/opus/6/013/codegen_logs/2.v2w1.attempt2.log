_GEN_DIRECTIONS = ((-1, 0), (1, 0), (0, -1), (0, 1))


def _gen_neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))


def _gen_in_bottom(r: int, c: int, n: int, sep: int) -> bool:
