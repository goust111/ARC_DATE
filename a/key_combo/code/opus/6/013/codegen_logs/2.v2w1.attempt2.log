+    alternative_orders = [
+        sorted(infos, key=lambda info: info["endpoint"]),
+        sorted(infos, key=lambda info: (info["endpoint"][1], info["endpoint"][0])),
+        sorted(infos, key=lambda info: info["source"]),
+        sorted(infos, key=lambda info: (info["source"][1], info["source"][0])),
