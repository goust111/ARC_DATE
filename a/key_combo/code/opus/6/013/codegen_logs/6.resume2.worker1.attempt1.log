+            if too_close:
+                continue
+            candidates.append((r0, c0))
+    return candidates
+
+
+def _place_sprite(
+    grid_shape: tuple[int, int],
+    sprite_mask: np.ndarray,
+    occupied: np.ndarray,
+    frame_bboxes: list[tuple[int, int, int, int]],
