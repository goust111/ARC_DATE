+MARKER_MASKS = {
+    opening: np.array(
+        [[1 if (r, c) in cells else 0 for c in range(2)] for r in range(2)],
+        dtype=bool,
+    )
+    for cells, opening in ((coords, opening) for coords, opening in LOCAL_TO_OPENING.items())
