+        frontier = set()
+        for r, c in np.argwhere(mask):
+            for nr, nc in ((int(r) - 1, int(c)), (int(r) + 1, int(c)), (int(r), int(c) - 1), (int(r), int(c) + 1)):
+                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
