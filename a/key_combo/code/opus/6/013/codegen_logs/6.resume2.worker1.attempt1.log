+            pts = [(r0 + dr, c0 + dc) for dr, dc in sprite_pts]
+            if any(occupied[r, c] for r, c in pts):
+                continue
+            bbox = (r0, c0, r0 + sh - 1, c0 + sw - 1)
+            if any(not _boxes_separate(bbox, frame_bbox, 0) for frame_bbox in frame_bboxes):
