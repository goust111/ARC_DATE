+        out[info["marker_coords"][:, 0], info["marker_coords"][:, 1]] = BG
+        fr0, fc0, fr1, fc1 = info["bbox"]
+        interior = _stretch_sprite(sprite, (fr1 - fr0 - 1, fc1 - fc0 - 1), info["anchor"])
