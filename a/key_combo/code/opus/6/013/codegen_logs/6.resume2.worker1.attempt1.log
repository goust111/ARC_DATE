+def _stretch_sprite(sprite: np.ndarray, target_shape: tuple[int, int], anchor: str) -> np.ndarray:
+    src_h, src_w = sprite.shape
+    dst_h, dst_w = target_shape
+    assert src_h >= 1 and src_w >= 1 and dst_h >= 1 and dst_w >= 1
