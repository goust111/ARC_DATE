+        iw = random.randint(max(INTERIOR_MIN, sw + 1), INTERIOR_MAX)
+        pairs.append((ih, iw))
+    if not any(h != w for h, w in pairs):
+        idx = random.randrange(k)
+        h, w = pairs[idx]
+        if h == w:
+            if w < INTERIOR_MAX:
