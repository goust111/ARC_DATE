+        comps = find_components(out, bg=bg, colors=[int(color)], connectivity=4, return_format="dict")
+        assert len(comps) == 2, "each frame color must form exactly one frame and one marker"
+        frame_comp = None
+        marker_comp = None
+        for comp in comps:
