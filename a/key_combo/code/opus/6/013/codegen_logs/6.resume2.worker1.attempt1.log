+def _render_solution(g: np.ndarray, frame_infos: list[dict], sprite: np.ndarray, sprite_coords: np.ndarray) -> np.ndarray:
+    out = np.array(g, copy=True)
+    out[sprite_coords[:, 0], sprite_coords[:, 1]] = BG
