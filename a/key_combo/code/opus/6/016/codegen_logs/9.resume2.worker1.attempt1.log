+
+def _marker_candidates(active_side: str, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    cells: list[tuple[int, int]] = []
+    if active_side == "left":
+        for r in range(3, h - 3):
+            for c in (2, 3):
+                cells.append((r, c))
+    elif active_side == "right":
+        for r in range(3, h - 3):
+            for c in (w - 4, w - 3):
+                cells.append((r, c))
+    elif active_side == "top":
+        for c in range(3, w - 3):
+            for r in (2, 3):
+                cells.append((r, c))
+    else:
+        for c in range(3, w - 3):
+            for r in (h - 4, h - 3):
+                cells.append((r, c))
+    return cells
+
+
+def _place_markers(grid: np.ndarray, active_side: str, rng: np.random.Generator) -> None:
+    cells = _marker_candidates(active_side, grid.shape)
+    rng.shuffle(cells)
+    count = int(rng.integers(4, 7))
+    placed = 0
+    for r, c in cells:
+        if grid[r, c] == BG:
+            grid[r, c] = ORANGE
+            placed += 1
+            if placed == count:
+                return
+    raise RuntimeError("failed to place orange markers")
+
+
+def _plus_cells(center: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = center
+    return [(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _place_plus(grid: np.ndarray, center: tuple[int, int]) -> bool:
+    h, w = grid.shape
+    cells = _plus_cells(center)
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
+        return False
+    if any(grid[r, c] != BG for r, c in cells):
+        return False
+    for r, c in cells:
+        grid[r, c] = YELLOW
+    return True
+
+
+def _planned_dest_mask(active_side: str, positions: list[int], shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for pos in positions:
+        r0, c0, r1, c1 = _dest_bbox(active_side, pos, shape)
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _trigger_center(active_side: str, trigger_side: str, pos: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    if active_side == "left":
+        center_c = w - 2
+        return (pos + 2, center_c) if trigger_side == "top" else (pos - 2, center_c)
+    if active_side == "right":
+        center_c = 1
+        return (pos + 2, center_c) if trigger_side == "top" else (pos - 2, center_c)
+    if active_side == "top":
+        center_r = h - 2
+        return (center_r, pos + 2) if trigger_side == "left" else (center_r, pos - 2)
+    center_r = 1
+    return (center_r, pos + 2) if trigger_side == "left" else (center_r, pos - 2)
+
+
+def _choose_trigger(active_side: str, positions: list[int], rng: np.random.Generator) -> tuple[int, str]:
+    if active_side in ("left", "right"):
+        trigger_side = "top" if rng.random() < 0.5 else "bottom"
+        trigger_pos = min(positions) if trigger_side == "top" else max(positions)
+    else:
+        trigger_side = "left" if rng.random() < 0.5 else "right"
+        trigger_pos = min(positions) if trigger_side == "left" else max(positions)
+    return trigger_pos, trigger_side
+
+
+def _idle_plus_center(
+    grid: np.ndarray,
+    dest_mask: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    centers = [(r, c) for r in range(2, h - 2) for c in range(2, w - 2)]
+    rng.shuffle(centers)
+    for center in centers:
+        if any(grid[r, c] != BG for r, c in _plus_cells(center)):
+            continue
+        r, c = center
+        probes = [(r - 2, c), (r + 2, c), (r, c - 2), (r, c + 2)]
+        if any(dest_mask[rr, cc] for rr, cc in probes):
+            continue
+        return center
+    return None
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    *,
+    expected_side: str,
+    expected_positions: list[int],
+    trigger_pos: int,
+    trigger_side: str,
+) -> bool:
+    try:
+        out, meta = _solve(grid, extend=True)
+        transfer_only, meta_noext = _solve(grid, extend=False)
+    except AssertionError:
+        return False
+
+    if not np.array_equal(transfer_only, meta["transfer_only"]):
+        return False
+    if meta["active_side"] != expected_side:
+        return False
+    if meta["moving_positions"] != expected_positions:
+        return False
+    if len(meta["triggers"]) != 1:
+        return False
+    trig = meta["triggers"][0]
+    if trig["side"] != trigger_side:
+        return False
+    if trig["bbox"] != _dest_bbox(expected_side, trigger_pos, grid.shape):
+        return False
+    if np.array_equal(out, transfer_only):
+        return False
+
+    changed = out != transfer_only
+    if not np.any(changed):
+        return False
+    if np.any(transfer_only[changed] != BG):
+        return False
+    if not np.all(np.isin(out[changed], [RED, GREEN])):
+        return False
+    if np.any(out[grid == YELLOW] != YELLOW):
+        return False
+
+    counts = _nearest_edge_counts(grid, ORANGE)
+    best = max(counts.values())
+    if counts[expected_side] != best or list(counts.values()).count(best) != 1:
+        return False
+    if expected_positions == [trigger_pos]:
+        return False
+    return True
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(16, 23))
+    w = int(rng.integers(16, 23))
+    grid = np.zeros((h, w), dtype=int)
+
+    active_side = SIDES[int(rng.integers(0, 4))]
+    _paint_source_band(grid, active_side, int(rng.integers(0, 2)))
+
+    axis_len = h if active_side in ("left", "right") else w
+    move_count = 3 if axis_len >= 19 and rng.random() < 0.5 else 2
+    positions = _choose_spaced_positions(axis_len, move_count, rng)
+    if positions is None:
+        return None
+
+    _place_blues(grid, active_side, positions)
+    _place_markers(grid, active_side, rng)
+
+    trigger_pos, trigger_side = _choose_trigger(active_side, positions, rng)
+    trigger_center = _trigger_center(active_side, trigger_side, trigger_pos, grid.shape)
+    if not _place_plus(grid, trigger_center):
+        return None
+
+    dest_mask = _planned_dest_mask(active_side, positions, grid.shape)
+    if rng.random() < 0.65:
+        idle_center = _idle_plus_center(grid, dest_mask, rng)
+        if idle_center is None:
+            return None
+        if not _place_plus(grid, idle_center):
+            return None
+
+    if not _validate_generated(
+        grid,
+        expected_side=active_side,
+        expected_positions=positions,
+        trigger_pos=trigger_pos,
+        trigger_side=trigger_side,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

diff --git a/key_combo/code/opus/6/016/9.py b/key_combo/code/opus/6/016/9.py
new file mode 100644
index 0000000000000000000000000000000000000000..47d08ee1c93552d4f2f5ddb221c594c4ef6e69da
--- /dev/null
+++ b/key_combo/code/opus/6/016/9.py
@@ -0,0 +1,505 @@
+from __future__ import annotations
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+SIDES = ("top", "bottom", "left", "right")
+DIRS = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox_from_coords(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _label_mask4(mask: np.ndarray) -> tuple[np.ndarray, dict[int, tuple[int, int, int, int]]]:
+    h, w = mask.shape
+    labels = np.zeros((h, w), dtype=int)
+    bboxes: dict[int, tuple[int, int, int, int]] = {}
+    cid = 0
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or labels[r, c] != 0:
+                continue
+            cid += 1
+            stack = [(r, c)]
+            labels[r, c] = cid
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and labels[nr, nc] == 0:
+                        labels[nr, nc] = cid
+                        stack.append((nr, nc))
+            bboxes[cid] = _bbox_from_coords(coords)
+    return labels, bboxes
+
+
+def _nearest_edge_counts(grid: np.ndarray, color: int) -> dict[str, int]:
+    h, w = grid.shape
+    counts = {side: 0 for side in SIDES}
+    for r, c in np.argwhere(grid == color):
+        distances = {
+            "top": int(r),
+            "bottom": int(h - 1 - r),
+            "left": int(c),
+            "right": int(w - 1 - c),
+        }
+        best = min(distances.values())
+        winners = [side for side, dist in distances.items() if dist == best]
+        if len(winners) == 1:
+            counts[winners[0]] += 1
+    return counts
+
+
+def _active_side(grid: np.ndarray) -> str:
+    counts = _nearest_edge_counts(grid, ORANGE)
+    best = max(counts.values())
+    winners = [side for side, count in counts.items() if count == best]
+    assert best > 0 and len(winners) == 1, "orange markers must identify one active edge"
+    return winners[0]
+
+
+def _moving_positions(grid: np.ndarray, active_side: str) -> list[int]:
+    if active_side in ("left", "right"):
+        return [r for r in range(grid.shape[0]) if np.any(grid[r] == BLUE)]
+    return [c for c in range(grid.shape[1]) if np.any(grid[:, c] == BLUE)]
+
+
+def _src_slice(grid: np.ndarray, active_side: str, pos: int) -> np.ndarray:
+    h, w = grid.shape
+    if active_side == "left":
+        return grid[pos : pos + 1, :2].copy()
+    if active_side == "right":
+        return grid[pos : pos + 1, w - 2 : w].copy()
+    if active_side == "top":
+        return grid[:2, pos : pos + 1].copy()
+    return grid[h - 2 : h, pos : pos + 1].copy()
+
+
+def _dest_bbox(active_side: str, pos: int, shape: tuple[int, int]) -> tuple[int, int, int, int]:
+    h, w = shape
+    if active_side == "left":
+        return pos, w - 2, pos, w - 1
+    if active_side == "right":
+        return pos, 0, pos, 1
+    if active_side == "top":
+        return h - 2, pos, h - 1, pos
+    return 0, pos, 1, pos
+
+
+def _copy_transfers(grid: np.ndarray, active_side: str) -> tuple[np.ndarray, np.ndarray, list[int]]:
+    out = grid.copy()
+    moved_mask = np.zeros_like(grid, dtype=bool)
+    positions = _moving_positions(grid, active_side)
+    for pos in positions:
+        src = _src_slice(grid, active_side, pos)
+        r0, c0, r1, c1 = _dest_bbox(active_side, pos, grid.shape)
+        out[r0 : r1 + 1, c0 : c1 + 1] = src
+        moved_mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    out[out == BLUE] = BG
+    return out, moved_mask, positions
+
+
+def _find_plus_centers(grid: np.ndarray) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    centers: list[tuple[int, int]] = []
+    expected = np.array(
+        [[False, True, False], [True, True, True], [False, True, False]],
+        dtype=bool,
+    )
+    yellow = grid == YELLOW
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            if not yellow[r, c]:
+                continue
+            patch = yellow[r - 1 : r + 2, c - 1 : c + 2]
+            if np.array_equal(patch, expected):
+                centers.append((r, c))
+    return centers
+
+
+def _trigger_side(center: tuple[int, int], moved_labels: np.ndarray) -> tuple[str, int] | None:
+    r, c = center
+    h, w = moved_labels.shape
+    probes = {
+        "top": (r - 2, c),
+        "bottom": (r + 2, c),
+        "left": (r, c - 2),
+        "right": (r, c + 2),
+    }
+    hits: list[tuple[str, int]] = []
+    for side, (rr, cc) in probes.items():
+        if 0 <= rr < h and 0 <= cc < w and moved_labels[rr, cc] > 0:
+            hits.append((side, int(moved_labels[rr, cc])))
+    if len(hits) != 1:
+        return None
+    return hits[0]
+
+
+def _paste_background_only(dst: np.ndarray, patch: np.ndarray, r0: int, c0: int) -> None:
+    h, w = patch.shape
+    for dr in range(h):
+        for dc in range(w):
+            rr = r0 + dr
+            cc = c0 + dc
+            if 0 <= rr < dst.shape[0] and 0 <= cc < dst.shape[1] and dst[rr, cc] == BG:
+                val = int(patch[dr, dc])
+                if val != BG:
+                    dst[rr, cc] = val
+
+
+def _extend_periodic(
+    out: np.ndarray,
+    tile: np.ndarray,
+    bbox: tuple[int, int, int, int],
+    direction: tuple[int, int],
+) -> None:
+    r0, c0, r1, c1 = bbox
+    h, w = tile.shape
+    dr, dc = direction
+    if (dr, dc) == (-1, 0):
+        rr = r0 - h
+        while rr + h - 1 >= 0:
+            _paste_background_only(out, tile, rr, c0)
+            rr -= h
+    elif (dr, dc) == (1, 0):
+        rr = r1 + 1
+        while rr < out.shape[0]:
+            _paste_background_only(out, tile, rr, c0)
+            rr += h
+    elif (dr, dc) == (0, -1):
+        cc = c0 - w
+        while cc + w - 1 >= 0:
+            _paste_background_only(out, tile, r0, cc)
+            cc -= w
+    elif (dr, dc) == (0, 1):
+        cc = c1 + 1
+        while cc < out.shape[1]:
+            _paste_background_only(out, tile, r0, cc)
+            cc += w
+    else:
+        raise ValueError("invalid extension direction")
+
+
+def _solve(grid: np.ndarray, *, extend: bool) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2, "expected a 2D grid"
+
+    active = _active_side(g)
+    transfer_only, moved_mask, positions = _copy_transfers(g, active)
+    out = transfer_only.copy()
+
+    moved_labels, moved_bboxes = _label_mask4(moved_mask)
+    triggers: list[dict] = []
+    for center in _find_plus_centers(g):
+        hit = _trigger_side(center, moved_labels)
+        if hit is None:
+            continue
+        side, cid = hit
+        bbox = moved_bboxes[cid]
+        r0, c0, r1, c1 = bbox
+        tile = transfer_only[r0 : r1 + 1, c0 : c1 + 1].copy()
+        triggers.append({"center": center, "side": side, "cid": cid, "bbox": bbox, "tile": tile})
+        if extend:
+            _extend_periodic(out, tile, bbox, DIRS[side])
+
+    return out, {
+        "active_side": active,
+        "moving_positions": positions,
+        "moved_mask": moved_mask,
+        "transfer_only": transfer_only,
+        "triggers": triggers,
+    }
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Copy marked edge-band slices across the grid, then let adjacent '+' triggers periodically extend them outward.
+
+    Input structure:
+    - The background is black, with one red/green patterned 2-pixel edge band on a single side.
+    - Orange markers sit nearest one edge and identify that edge as active, while blue trail pixels mark which perpendicular rows or columns should move.
+    - One or two yellow 5-pixel '+' shapes lie away from the source band; after transfer, some moved slices may land adjacent to one arm of a '+'.
+
+    Rule:
+    - Choose the edge nearest to the most orange markers as the active edge.
+    - For every row or column containing blue and perpendicular to that edge, copy the corresponding 2-pixel band slice to the opposite edge, keep the source band, and erase all blue pixels.
+    - If a just-transferred slice now sits adjacent to exactly one side of a yellow '+', repeat that slice pattern periodically farther outward in that side's direction until the boundary, but only onto background cells.
+
+    Key insight:
+    - The '+' objects do nothing on their own: only slices created by the edge transfer become valid extension seeds, and the side of adjacency determines the ray direction.
+    """
+    out, _meta = _solve(grid, extend=True)
+    return out
+
+
+def _paint_source_band(grid: np.ndarray, active_side: str, phase: int) -> None:
+    h, w = grid.shape
+    if active_side == "left":
+        for r in range(h):
+            grid[r, :2] = [RED, GREEN] if (r + phase) % 2 == 0 else [GREEN, RED]
+    elif active_side == "right":
+        for r in range(h):
+            grid[r, w - 2 : w] = [RED, GREEN] if (r + phase) % 2 == 0 else [GREEN, RED]
+    elif active_side == "top":
+        for c in range(w):
+            grid[:2, c] = np.array([[RED], [GREEN]])[:, 0] if (c + phase) % 2 == 0 else np.array([[GREEN], [RED]])[:, 0]
+    else:
+        for c in range(w):
+            grid[h - 2 : h, c] = np.array([[RED], [GREEN]])[:, 0] if (c + phase) % 2 == 0 else np.array([[GREEN], [RED]])[:, 0]
+
+
+def _choose_spaced_positions(axis_len: int, count: int, rng: np.random.Generator) -> list[int] | None:
+    candidates = list(range(3, axis_len - 3))
+    for _ in range(200):
+        rng.shuffle(candidates)
+        chosen: list[int] = []
+        for pos in candidates:
+            if all(abs(pos - prev) >= 5 for prev in chosen):
+                chosen.append(int(pos))
+                if len(chosen) == count:
+                    return sorted(chosen)
+    return None
+
+
+def _blue_anchor(active_side: str, shape: tuple[int, int]) -> int:
+    h, w = shape
+    if active_side in ("left", "right"):
+        return w // 2
+    return h // 2
+
+
+def _place_blues(grid: np.ndarray, active_side: str, positions: list[int]) -> None:
+    anchor = _blue_anchor(active_side, grid.shape)
+    if active_side in ("left", "right"):
+        for r in positions:
+            grid[r, anchor] = BLUE
+    else:
+        for c in positions:
+            grid[anchor, c] = BLUE
+
+
+def _marker_candidates(active_side: str, shape: tuple[int, int]) -> list[tuple[int, int]]:
+    h, w = shape
+    cells: list[tuple[int, int]] = []
+    if active_side == "left":
+        for r in range(3, h - 3):
+            for c in (2, 3):
+                cells.append((r, c))
+    elif active_side == "right":
+        for r in range(3, h - 3):
+            for c in (w - 4, w - 3):
+                cells.append((r, c))
+    elif active_side == "top":
+        for c in range(3, w - 3):
+            for r in (2, 3):
+                cells.append((r, c))
+    else:
+        for c in range(3, w - 3):
+            for r in (h - 4, h - 3):
+                cells.append((r, c))
+    return cells
+
+
+def _place_markers(grid: np.ndarray, active_side: str, rng: np.random.Generator) -> None:
+    cells = _marker_candidates(active_side, grid.shape)
+    rng.shuffle(cells)
+    count = int(rng.integers(4, 7))
+    placed = 0
+    for r, c in cells:
+        if grid[r, c] == BG:
+            grid[r, c] = ORANGE
+            placed += 1
+            if placed == count:
+                return
+    raise RuntimeError("failed to place orange markers")
+
+
+def _plus_cells(center: tuple[int, int]) -> list[tuple[int, int]]:
+    r, c = center
+    return [(r, c), (r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _place_plus(grid: np.ndarray, center: tuple[int, int]) -> bool:
+    h, w = grid.shape
+    cells = _plus_cells(center)
+    if any(not (0 <= r < h and 0 <= c < w) for r, c in cells):
+        return False
+    if any(grid[r, c] != BG for r, c in cells):
+        return False
+    for r, c in cells:
+        grid[r, c] = YELLOW
+    return True
+
+
+def _planned_dest_mask(active_side: str, positions: list[int], shape: tuple[int, int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for pos in positions:
+        r0, c0, r1, c1 = _dest_bbox(active_side, pos, shape)
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
+
+
+def _trigger_center(active_side: str, trigger_side: str, pos: int, shape: tuple[int, int]) -> tuple[int, int]:
+    h, w = shape
+    if active_side == "left":
+        center_c = w - 2
+        return (pos + 2, center_c) if trigger_side == "top" else (pos - 2, center_c)
+    if active_side == "right":
+        center_c = 1
+        return (pos + 2, center_c) if trigger_side == "top" else (pos - 2, center_c)
+    if active_side == "top":
+        center_r = h - 2
+        return (center_r, pos + 2) if trigger_side == "left" else (center_r, pos - 2)
+    center_r = 1
+    return (center_r, pos + 2) if trigger_side == "left" else (center_r, pos - 2)
+
+
+def _choose_trigger(active_side: str, positions: list[int], rng: np.random.Generator) -> tuple[int, str]:
+    if active_side in ("left", "right"):
+        trigger_side = "top" if rng.random() < 0.5 else "bottom"
+        trigger_pos = min(positions) if trigger_side == "top" else max(positions)
+    else:
+        trigger_side = "left" if rng.random() < 0.5 else "right"
+        trigger_pos = min(positions) if trigger_side == "left" else max(positions)
+    return trigger_pos, trigger_side
+
+
+def _idle_plus_center(
+    grid: np.ndarray,
+    dest_mask: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[int, int] | None:
+    h, w = grid.shape
+    centers = [(r, c) for r in range(2, h - 2) for c in range(2, w - 2)]
+    rng.shuffle(centers)
+    for center in centers:
+        if any(grid[r, c] != BG for r, c in _plus_cells(center)):
+            continue
+        r, c = center
+        probes = [(r - 2, c), (r + 2, c), (r, c - 2), (r, c + 2)]
+        if any(dest_mask[rr, cc] for rr, cc in probes):
+            continue
+        return center
+    return None
+
+
+def _validate_generated(
+    grid: np.ndarray,
+    *,
+    expected_side: str,
+    expected_positions: list[int],
+    trigger_pos: int,
+    trigger_side: str,
+) -> bool:
+    try:
+        out, meta = _solve(grid, extend=True)
+        transfer_only, meta_noext = _solve(grid, extend=False)
+    except AssertionError:
+        return False
+
+    if not np.array_equal(transfer_only, meta["transfer_only"]):
+        return False
+    if meta["active_side"] != expected_side:
+        return False
+    if meta["moving_positions"] != expected_positions:
+        return False
+    if len(meta["triggers"]) != 1:
+        return False
+    trig = meta["triggers"][0]
+    if trig["side"] != trigger_side:
+        return False
+    if trig["bbox"] != _dest_bbox(expected_side, trigger_pos, grid.shape):
+        return False
+    if np.array_equal(out, transfer_only):
+        return False
+
+    changed = out != transfer_only
+    if not np.any(changed):
+        return False
+    if np.any(transfer_only[changed] != BG):
+        return False
+    if not np.all(np.isin(out[changed], [RED, GREEN])):
+        return False
+    if np.any(out[grid == YELLOW] != YELLOW):
+        return False
+
+    counts = _nearest_edge_counts(grid, ORANGE)
+    best = max(counts.values())
+    if counts[expected_side] != best or list(counts.values()).count(best) != 1:
+        return False
+    if expected_positions == [trigger_pos]:
+        return False
+    return True
+
+
+def _generate_attempt(rng: np.random.Generator) -> np.ndarray | None:
+    h = int(rng.integers(16, 23))
+    w = int(rng.integers(16, 23))
+    grid = np.zeros((h, w), dtype=int)
+
+    active_side = SIDES[int(rng.integers(0, 4))]
+    _paint_source_band(grid, active_side, int(rng.integers(0, 2)))
+
+    axis_len = h if active_side in ("left", "right") else w
+    move_count = 3 if axis_len >= 19 and rng.random() < 0.5 else 2
+    positions = _choose_spaced_positions(axis_len, move_count, rng)
+    if positions is None:
+        return None
+
+    _place_blues(grid, active_side, positions)
+    _place_markers(grid, active_side, rng)
+
+    trigger_pos, trigger_side = _choose_trigger(active_side, positions, rng)
+    trigger_center = _trigger_center(active_side, trigger_side, trigger_pos, grid.shape)
+    if not _place_plus(grid, trigger_center):
+        return None
+
+    dest_mask = _planned_dest_mask(active_side, positions, grid.shape)
+    if rng.random() < 0.65:
+        idle_center = _idle_plus_center(grid, dest_mask, rng)
+        if idle_center is None:
+            return None
+        if not _place_plus(grid, idle_center):
+            return None
+
+    if not _validate_generated(
+        grid,
+        expected_side=active_side,
+        expected_positions=positions,
+        trigger_pos=trigger_pos,
+        trigger_side=trigger_side,
+    ):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    rng = np.random.default_rng()
+    for _ in range(500):
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid input")

