from __future__ import annotations

from importlib.machinery import SourceFileLoader

import numpy as np


_ARC_UTILS = SourceFileLoader(
    "_arc_utils_shared",
    "/home/lixinyu/snap/new/solvers/arc_utils.py",
).load_module()

Color = _ARC_UTILS.Color
tile_fill = _ARC_UTILS.tile_fill


OUTPUT_SHAPE = (15, 15)
SEPARATOR = Color.YELLOW
BG = Color.BLACK
PHASE = Color.ORANGE
CENTER = Color.MAROON
MAX_RETRIES = 400


def _separator_columns(grid: np.ndarray) -> tuple[int, int]:
    cols = [c for c in range(grid.shape[1]) if bool(np.all(grid[:, c] == SEPARATOR))]
    assert len(cols) == 2, "expected exactly two full-height yellow separator columns"
    assert cols[0] + 1 < cols[1], "separators must leave room for the middle panel"
    return int(cols[0]), int(cols[1])


def _panel_slices(grid: np.ndarray) -> list[slice]:
    s0, s1 = _separator_columns(grid)
    w0 = s0
    w1 = s1 - s0 - 1
    w2 = grid.shape[1] - s1 - 1
    assert w0 == w1 == w2 and w0 > 0, "panels must have equal positive widths"
    return [slice(0, s0), slice(s0 + 1, s1), slice(s1 + 1, grid.shape[1])]


def _nonempty_row_color(row: np.ndarray) -> int | None:
    vals = set(map(int, row))
    if vals == {BG}:
        return None
    assert BG not in vals, "a stripe row must fill the entire panel width"
    assert len(vals) == 1, "a stripe row must be monochrome"
    return int(next(iter(vals)))


def _scan_panel(panel: np.ndarray) -> list[int]:
    colors: list[int] = []
    for r in range(panel.shape[0]):
        color = _nonempty_row_color(panel[r, :])
        if color is not None:
            colors.append(color)
    return colors


def _extract_sequence(grid: np.ndarray) -> tuple[list[int], list[list[int]]]:
    assert grid.ndim == 2
    assert np.issubdtype(grid.dtype, np.integer)
    assert int(grid.shape[0]) <= 30 and int(grid.shape[1]) <= 30
    assert int(np.min(grid)) >= 0 and int(np.max(grid)) <= 9
    assert int(np.min(grid)) == BG, "black background must be present"

    panels = [grid[:, s] for s in _panel_slices(grid)]
    per_panel = [_scan_panel(panel) for panel in panels]
    seq: list[int] = []
    for colors in reversed(per_panel):
        seq.extend(colors)

    assert all(colors for colors in per_panel), "each panel must contain at least one stripe"
    assert 4 <= len(seq) <= 9, "decoded sequence length must be between 4 and 9"
    assert len(set(seq)) == len(seq), "each stripe color must appear exactly once across panels"
    return seq, per_panel


def _decode_mask(length: int) -> np.ndarray:
    assert 4 <= int(length) <= 9
    mask = np.zeros((3, 3), dtype=bool)
    mask.reshape(-1)[: int(length)] = True
    return mask


def _build_output(length: int) -> np.ndarray:
    glyph = _decode_mask(length)
    tile = np.where(glyph, PHASE, BG).astype(int)
    out = tile_fill(OUTPUT_SHAPE, tile).astype(int)

    center_patch = np.tile(glyph, (2, 2))
    r0 = (out.shape[0] - center_patch.shape[0]) // 2
    c0 = (out.shape[1] - center_patch.shape[1]) // 2
    out[r0 : r0 + 6, c0 : c0 + 6][center_patch] = CENTER
    return out


def main(grid: np.ndarray) -> np.ndarray:
    """
    Compress the reverse-scanned panel stripes into a sequence, decode its length as a 3x3 phase glyph, and tile that glyph into a lattice.

    Input structure:
    - The background is black, and two full-height yellow columns split the grid into three equal-width panels.
    - Inside each panel, every non-empty row is a one-pixel-thick full-width monochrome stripe; empty rows are all black.
    - Across all three panels, the stripe colors are pairwise distinct, each panel contributes at least one stripe, and the total stripe count is between 4 and 9.

    Rule:
    - Scan panels from right to left, and within each panel scan rows from top to bottom.
    - Keep only the non-empty rows, recording their colors in that order to form a compressed sequence.
    - Interpret the sequence length N as a 3x3 row-major binary glyph whose first N positions are foreground.
    - Use that 3x3 glyph as an orange-on-black phase tile repeated over a 15x15 output, then overwrite the centered 6x6 block with a 2x2 tiling of the same glyph recolored to maroon.

    Key insight:
    - The panel rows are not copied directly; they first collapse into a one-dimensional code, and only the amount of retained information is then re-expanded into the periodic lattice phase.
    """
    g = np.asarray(grid, dtype=int)
    seq, _ = _extract_sequence(g)
    return _build_output(len(seq))


def _compositions(total: int, cap: int) -> list[tuple[int, int, int]]:
    out: list[tuple[int, int, int]] = []
    for a in range(1, cap + 1):
        for b in range(1, cap + 1):
            c = total - a - b
            if 1 <= c <= cap:
                out.append((a, b, c))
    return out


def _has_gap(rows: list[int]) -> bool:
    return rows[0] > 0 or any(b - a > 1 for a, b in zip(rows, rows[1:]))


def _choose_rows(rng: np.random.Generator, height: int, count: int, *, require_gap: bool) -> list[int]:
    for _ in range(100):
        rows = sorted(int(x) for x in rng.choice(height, size=count, replace=False))
        if require_gap and not _has_gap(rows):
            continue
        return rows
    raise RuntimeError("failed to choose informative row positions")


def _build_input(
    height: int,
    panel_w: int,
    groups: tuple[int, int, int],
    sequence: list[int],
    rng: np.random.Generator,
) -> np.ndarray:
    grid = np.full((height, 3 * panel_w + 2), BG, dtype=int)
    grid[:, panel_w] = SEPARATOR
    grid[:, 2 * panel_w + 1] = SEPARATOR

    right_n, middle_n, left_n = groups
    splits = [right_n, right_n + middle_n]
    right_seq = sequence[: splits[0]]
    middle_seq = sequence[splits[0] : splits[1]]
    left_seq = sequence[splits[1] :]

    gap_panel = None
    for name, count in (("right", right_n), ("middle", middle_n), ("left", left_n)):
        if count < height:
            gap_panel = name
            break
    assert gap_panel is not None

    panel_rows = {
        "left": _choose_rows(rng, height, left_n, require_gap=gap_panel == "left"),
        "middle": _choose_rows(rng, height, middle_n, require_gap=gap_panel == "middle"),
        "right": _choose_rows(rng, height, right_n, require_gap=gap_panel == "right"),
    }
    if not any(_has_gap(rows) for rows in panel_rows.values()):
        for name, count in (("middle", middle_n), ("left", left_n), ("right", right_n)):
            if count < height:
                panel_rows[name] = _choose_rows(rng, height, count, require_gap=True)
                break

    assignments = [
        (slice(0, panel_w), panel_rows["left"], left_seq),
        (slice(panel_w + 1, 2 * panel_w + 1), panel_rows["middle"], middle_seq),
        (slice(2 * panel_w + 2, 3 * panel_w + 2), panel_rows["right"], right_seq),
    ]
    for cols, rows, colors in assignments:
        assert len(rows) == len(colors)
        for r, color in zip(rows, colors):
            grid[int(r), cols] = int(color)
    return grid


def _validate_generated(grid: np.ndarray) -> bool:
    try:
        seq, per_panel = _extract_sequence(grid)
    except AssertionError:
        return False

    if not any(_has_gap(sorted(np.flatnonzero(np.any(grid[:, s] != BG, axis=1)).tolist())) for s in _panel_slices(grid)):
        return False

    left_to_right: list[int] = []
    for colors in per_panel:
        left_to_right.extend(colors)
    if left_to_right == seq:
        return False

    out = main(grid)
    expected = _build_output(len(seq))
    if not np.array_equal(out, expected):
        return False

    center_patch = out[4:10, 4:10]
    if int(np.count_nonzero(center_patch == CENTER)) != 4 * len(seq):
        return False

    if len(set(map(int, np.unique(out)))) < 2:
        return False
    return True


def _gen_attempt(rng: np.random.Generator) -> np.ndarray | None:
    height = int(rng.integers(5, 9))
    panel_w = int(rng.integers(4, 8))
    length = int(rng.integers(4, 10))

    compositions = _compositions(length, height)
    if not compositions:
        return None
    groups = compositions[int(rng.integers(len(compositions)))]
    if len(set(groups)) == 1 and height > max(groups):
        # Keep some asymmetry so the panel grouping is visible.
        groups = compositions[(int(rng.integers(len(compositions))) + 1) % len(compositions)]

    palette = list(range(1, 10))
    colors = rng.choice(palette, size=length, replace=False).tolist()
    sequence = [int(c) for c in colors]

    try:
        grid = _build_input(height, panel_w, groups, sequence, rng)
    except (AssertionError, RuntimeError):
        return None
    if not _validate_generated(grid):
        return None
    return grid


def generate_input() -> np.ndarray:
    rng = np.random.default_rng()
