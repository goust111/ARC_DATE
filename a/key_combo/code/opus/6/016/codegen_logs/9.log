   147	def _trigger_specs(
   148	    out: np.ndarray,
   149	    moved_mask: np.ndarray,
   150	    dest_side: str,
   151	    center: tuple[int, int],
   152	) -> list[tuple[np.ndarray, int, int, tuple[int, int]]]:
   153	    h, w = out.shape
   154	    r, c = center
   155	    specs: list[tuple[np.ndarray, int, int, tuple[int, int]]] = []
   156	
   157	    if dest_side == "top" and r == 1:
   158	        for dc, direction in ((-2, (0, -1)), (2, (0, 1))):
   159	            cc = c + dc
   160	            if 0 <= cc < w and np.all(moved_mask[:BAND_THICKNESS, cc]):
   161	                specs.append((out[:BAND_THICKNESS, cc : cc + 1].copy(), 0, cc, direction))
   162	    elif dest_side == "bottom" and r == h - 2:
   163	        for dc, direction in ((-2, (0, -1)), (2, (0, 1))):
   164	            cc = c + dc
   165	            if 0 <= cc < w and np.all(moved_mask[h - BAND_THICKNESS : h, cc]):
   166	                specs.append(
   167	                    (
   168	                        out[h - BAND_THICKNESS : h, cc : cc + 1].copy(),
   169	                        h - BAND_THICKNESS,
   170	                        cc,
   171	                        direction,
   172	                    )
   173	                )
   174	    elif dest_side == "left" and c == 1:
   175	        for dr, direction in ((-2, (-1, 0)), (2, (1, 0))):
   176	            rr = r + dr
   177	            if 0 <= rr < h and np.all(moved_mask[rr, :BAND_THICKNESS]):
   178	                specs.append((out[rr : rr + 1, :BAND_THICKNESS].copy(), rr, 0, direction))
   179	    elif dest_side == "right" and c == w - 2:
   180	        for dr, direction in ((-2, (-1, 0)), (2, (1, 0))):
   181	            rr = r + dr
   182	            if 0 <= rr < h and np.all(moved_mask[rr, w - BAND_THICKNESS : w]):
   183	                specs.append(
   184	                    (
   185	                        out[rr : rr + 1, w - BAND_THICKNESS : w].copy(),
   186	                        rr,
   187	                        w - BAND_THICKNESS,
   188	                        direction,
   189	                    )
   190	                )
   191	    return specs
