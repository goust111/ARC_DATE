   194	def main(grid: np.ndarray) -> np.ndarray:
   195	    """
   196	    Move selected two-cell edge-band slices across the grid, then let nearby '+' crosses project them outward periodically.
   197	
   198	    Input structure:
   199	    - The background is black.
   200	    - One grid edge carries a 2-pixel-thick red/green patterned band, and orange markers sit 1-3 cells from that same edge.
   201	    - Sparse blue trail pixels lie on rows or columns perpendicular to the active edge, and one or two yellow '+' crosses sit inside the grid near the opposite side.
   202	
   203	    Rule:
   204	    - Find the edge with the most orange markers and treat it as the active source edge.
   205	    - For every perpendicular row or column containing a blue trail pixel, copy that line's 2-cell edge-band slice to the opposite edge at the matching position, then erase all blue pixels while keeping the source band and orange markers.
   206	    - For each yellow '+' whose outer-adjacent side now touches a transferred slice, extend that 2-cell slice periodically away from the '+' toward the boundary, writing only onto background cells and never overwriting the '+' or any other existing non-background pixel.
   207	
   208	    Key insight:
   209	    - The orange markers choose which edge supplies slices, but the yellow '+' only becomes meaningful after transfer: a moved slice landing beside one arm turns the cross into a directional periodic repeater.
   210	    """
   211	    out, moved_mask, dest_side = _transfer_only(grid)
   212	    for center in _find_cross_centers(out):
   213	        for tile, r0, c0, direction in _trigger_specs(out, moved_mask, dest_side, center):
   214	            _extend_periodic(out, tile, r0, c0, direction)
   215	    return out
   216	
