   218	def _paint_cross(grid: np.ndarray, center: tuple[int, int]) -> None:
   219	    r, c = center
   220	    grid[r, c] = YELLOW
   221	    grid[r - 1, c] = YELLOW
   222	    grid[r + 1, c] = YELLOW
   223	    grid[r, c - 1] = YELLOW
   224	    grid[r, c + 1] = YELLOW
   225	
   226	
   227	def _paint_band(grid: np.ndarray, side: str, line_patterns: np.ndarray) -> None:
   228	    h, w = grid.shape
   229	    if side == "top":
   230	        grid[:BAND_THICKNESS, :] = line_patterns.T
   231	    elif side == "bottom":
   232	        grid[h - BAND_THICKNESS : h, :] = line_patterns.T
   233	    elif side == "left":
   234	        grid[:, :BAND_THICKNESS] = line_patterns
   235	    else:
   236	        grid[:, w - BAND_THICKNESS : w] = line_patterns
   237	
   238	
   239	def _pattern_for_lines(count: int, rng: np.random.Generator) -> np.ndarray:
   240	    phase = int(rng.integers(0, 2))
   241	    mode = int(rng.integers(0, 3))
   242	    patterns = np.zeros((count, BAND_THICKNESS), dtype=int)
   243	    for i in range(count):
   244	        parity = (i + phase) % 2
   245	        if mode == 0:
   246	            pair = (RED, GREEN) if parity == 0 else (GREEN, RED)
   247	        elif mode == 1:
   248	            pair = (RED, GREEN) if (i // 2 + phase) % 2 == 0 else (GREEN, RED)
   249	        else:
   250	            pair = (RED, GREEN) if (i + (i // 3) + phase) % 2 == 0 else (GREEN, RED)
   251	        patterns[i] = pair
   252	    return patterns
   253	
   254	
   255	def _edge_marker_positions(
   256	    shape: tuple[int, int],
   257	    side: str,
   258	    count: int,
   259	    rng: np.random.Generator,
   260	) -> list[tuple[int, int]]:
   261	    h, w = shape
   262	    positions: list[tuple[int, int]] = []
   263	    tries = 0
   264	    while len(positions) < count and tries < 500:
   265	        tries += 1
   266	        depth = int(rng.integers(MARKER_DEPTH_MIN, MARKER_DEPTH_MAX + 1))
   267	        if side == "top":
   268	            r, c = depth, int(rng.integers(2, w - 2))
   269	        elif side == "bottom":
   270	            r, c = h - 1 - depth, int(rng.integers(2, w - 2))
   271	        elif side == "left":
   272	            r, c = int(rng.integers(2, h - 2)), depth
   273	        else:
   274	            r, c = int(rng.integers(2, h - 2)), w - 1 - depth
   275	        if (r, c) not in positions:
   276	            positions.append((r, c))
   277	    if len(positions) < count:
   278	        raise RuntimeError("failed to place orange markers")
   279	    return positions
   280	
   281	
   282	def _separated_choices(
   283	    candidates: list[int],
   284	    need: int,
   285	    min_gap: int,
   286	    rng: np.random.Generator,
   287	) -> list[int] | None:
   288	    order = list(rng.permutation(candidates))
   289	    chosen: list[int] = []
   290	    for val in order:
   291	        if all(abs(val - prev) >= min_gap for prev in chosen):
   292	            chosen.append(int(val))
   293	            if len(chosen) == need:
   294	                return sorted(chosen)
   295	    return None
   296	
