   347	    r, c = center
   348	    cells = _cross_cells(center)
   349	    if not all(0 <= rr < h and 0 <= cc < w for rr, cc in cells):
   350	        return False
   351	    return all(grid[rr, cc] == BG for rr, cc in cells)
