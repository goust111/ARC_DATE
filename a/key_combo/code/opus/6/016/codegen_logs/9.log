+def _pattern_for_lines(count: int, rng: np.random.Generator) -> np.ndarray:
+    phase = int(rng.integers(0, 2))
+    mode = int(rng.integers(0, 3))
+    patterns = np.zeros((count, BAND_THICKNESS), dtype=int)
+    for i in range(count):
