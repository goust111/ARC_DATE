   110	def _extend_periodic(out: np.ndarray, tile: np.ndarray, r0: int, c0: int, direction: tuple[int, int]) -> None:
   111	    h, w = out.shape
   112	    tile_h, tile_w = tile.shape
   113	    dr, dc = direction
   114	
   115	    if (dr, dc) == (0, 1):
   116	        for step, tc in enumerate(range(c0 + tile_w, w)):
   117	            src_c = step % tile_w
   118	            for rr in range(r0, r0 + tile_h):
   119	                val = int(tile[rr - r0, src_c])
   120	                if val != BG and out[rr, tc] == BG:
   121	                    out[rr, tc] = val
   122	    elif (dr, dc) == (0, -1):
   123	        for step, tc in enumerate(range(c0 - 1, -1, -1), start=1):
   124	            src_c = (-step) % tile_w
   125	            for rr in range(r0, r0 + tile_h):
   126	                val = int(tile[rr - r0, src_c])
   127	                if val != BG and out[rr, tc] == BG:
   128	                    out[rr, tc] = val
   129	    elif (dr, dc) == (1, 0):
   130	        for step, tr in enumerate(range(r0 + tile_h, h)):
   131	            src_r = step % tile_h
   132	            for cc in range(c0, c0 + tile_w):
   133	                val = int(tile[src_r, cc - c0])
   134	                if val != BG and out[tr, cc] == BG:
   135	                    out[tr, cc] = val
   136	    elif (dr, dc) == (-1, 0):
   137	        for step, tr in enumerate(range(r0 - 1, -1, -1), start=1):
   138	            src_r = (-step) % tile_h
   139	            for cc in range(c0, c0 + tile_w):
   140	                val = int(tile[src_r, cc - c0])
   141	                if val != BG and out[tr, cc] == BG:
   142	                    out[tr, cc] = val
   143	    else:
   144	        raise ValueError("invalid direction")
