INPUT_OFFSET_START, INPUT_OFFSET_STOP = 1, 4
INPUT_OFFSETS = tuple(
    (dr, dc) for dr in range(INPUT_OFFSET_START, INPUT_OFFSET_STOP)
    for dc in range(INPUT_OFFSET_START, INPUT_OFFSET_STOP) if (dr, dc) != (CENTER_OFFSET, CENTER_OFFSET)
)
