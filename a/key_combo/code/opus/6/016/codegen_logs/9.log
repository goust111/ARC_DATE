+        if mode == 0:
+            pair = (RED, GREEN) if parity == 0 else (GREEN, RED)
+        elif mode == 1:
+            pair = (RED, GREEN) if (i // 2 + phase) % 2 == 0 else (GREEN, RED)
+        else:
+            pair = (RED, GREEN) if (i + (i // 3) + phase) % 2 == 0 else (GREEN, RED)
+        patterns[i] = pair
+    return patterns
 
 
