    94	def _find_cross_centers(grid: np.ndarray) -> list[tuple[int, int]]:
    95	    h, w = grid.shape
    96	    centers: list[tuple[int, int]] = []
    97	    for r in range(1, h - 1):
    98	        for c in range(1, w - 1):
    99	            if (
   100	                grid[r, c] == YELLOW
   101	                and grid[r - 1, c] == YELLOW
   102	                and grid[r + 1, c] == YELLOW
   103	                and grid[r, c - 1] == YELLOW
   104	                and grid[r, c + 1] == YELLOW
   105	            ):
   106	                centers.append((r, c))
   107	    return centers
