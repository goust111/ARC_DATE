  "type": "move_along_path",
  "src": "marker tile (non-bg patch) attached to a '+' sprite",
  "path": "straight ray starting from the marker tile, going away from the '+' attachment side until boundary",
  "trajectory": "repeat the marker tile periodically along the ray (tile repeats every tile width/height)",
  "dst": "grid edge",
  "transform": "copy the repeated marker pattern into background; keep the '+' pixels unchanged"
}
</annotation>
<generation_spec>
```yaml
spec:
  grid: 20-26 rows x 13-18 cols, bg=8 (teal)
  plus_shapes:
    color: 1 (blue), detected as dominant big-component color (most 4-connected components with bbox ≥ 3×3)
    count: 2-3
    shape: cross/plus-like, symmetric LR+UD, top/bottom rows indented by 1 each side
    variants: |
      .1.   .11.   .11.
      111   1111   1111
      .1.   .11.   1111
                   1111
                   .11.
    bbox: 3×3, 3×4, or 5×4
    placement: ≥1 cell from grid edges, ≥5 cell bbox separation between pluses
  marker_tiles:
    per_plus: exactly 1, 4-adjacent to exactly one side of its plus
    tile_size: each dimension 1-2, total area ≥ 2 (valid: 1×2, 2×1, 2×2)
    width_match: tile dimension along plus contact edge = min(contact-edge width, 2)
    colors: all cells distinct, drawn from non-bg non-plus palette
    isolation: tile must not 4-connect to any other non-bg non-plus pixel
    extension_room: ≥1 cell between tile far end and grid edge in extension direction
  transformation:
    for each plus, extend each adjacent marker tile away from the plus to grid edge
    tile pattern repeats periodically; plus-colored pixels are protected (not overwritten)

generation_strategy:
  approach: construct input directly, validate with solver
  steps:
    1. Choose grid H=20-26, W=13-18, bg=8, plus_col=1
    2. Generate 2-3 plus shapes from the 3 template variants
    3. Place pluses with ≥5 cell bbox separation and ≥1 cell from edges
    4. For each plus, pick a random side with ≥3 cells of room to the edge
    5. Create a small tile (1-2 cells in extension dir, total area ≥ 2) with distinct non-bg non-plus colors
    6. Place tile immediately adjacent to the chosen side; verify isolation from other non-bg non-plus pixels
    7. Validate main(input) ≠ input (solver extended at least one tile)
