   298	def _empty_with_band(side: str, h: int, w: int, rng: np.random.Generator) -> tuple[np.ndarray, np.ndarray]:
   299	    grid = np.zeros((h, w), dtype=int)
   300	    line_count = w if side in ("top", "bottom") else h
   301	    patterns = _pattern_for_lines(line_count, rng)
   302	    _paint_band(grid, side, patterns)
   303	    return grid, patterns
