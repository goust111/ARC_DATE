+
+        top_rows_used: set[int] = set()
+        segments: list[dict] = []
+        for _idx in range(count):
+            segment = _sample_segment_spec(rng, h, w, protected, ray_forbidden, top_rows_used)
+            if segment is None:
+                ok = False
