        assert set(_ray_interior(arrow)).isdisjoint(occupied), "generated rays must be visually unobstructed"


def generate_input() -> np.ndarray:
    rng = random.Random()
    for _ in range(GEN_ATTEMPTS):
        h = rng.randint(16, 22)
        w = rng.randint(16, 22)
