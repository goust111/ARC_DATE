+        if not ok:
+            continue
+
+        grid = _build_grid(h, w, arrows, segments, arrow_colors, segment_colors)
+        try:
+            _validate_generated(grid)
+        except AssertionError:
+            continue
+        return grid
+
+    raise RuntimeError("failed to generate a valid input for puzzle 4")

