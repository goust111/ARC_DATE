+
+def _build_grid(
+    h: int,
+    w: int,
+    arrows: list[dict],
+    segments: list[dict],
+    arrow_colors: list[int],
+    segment_colors: list[int],
+) -> np.ndarray:
+    grid = np.full((h, w), BG, dtype=int)
+    grid[0, :] = grid[-1, :] = grid[:, 0] = grid[:, -1] = FRAME
+    for arrow, color in zip(arrows, arrow_colors):
