+
+
+def generate_input() -> np.ndarray:
+    rng = random.Random()
+    for _ in range(GEN_ATTEMPTS):
+        h = rng.randint(16, 22)
+        w = rng.randint(16, 22)
+        count = rng.randint(2, 4)
