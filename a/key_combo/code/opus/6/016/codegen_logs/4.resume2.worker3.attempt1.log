+            direction = rng.choice(["up", "down"])
+            start = rng.randint(1, h - 5)
+            spec = _arrow_cells(orientation, direction, axis, start)
+            target = (0, axis) if direction == "up" else (h - 1, axis)
+            opposite = (h - 1, axis) if direction == "up" else (0, axis)
