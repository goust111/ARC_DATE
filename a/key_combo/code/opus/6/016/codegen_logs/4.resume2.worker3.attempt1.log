+            if segment is None:
+                ok = False
+                break
+            segments.append(segment)
+            protected |= _expanded(segment["cells"], h, w)
+            top_rows_used.add(segment["top_row"])
+        if not ok:
+            continue
+
+        grid = _build_grid(h, w, arrows, segments, arrow_colors, segment_colors)
+        try:
