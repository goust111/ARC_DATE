+        protected: set[tuple[int, int]] = set()
+        ray_forbidden: set[tuple[int, int]] = set()
+        endpoint_used: set[tuple[int, int]] = set()
+        row_axes: set[int] = set()
+        col_axes: set[int] = set()
+        arrows: list[dict] = []
+
+        ok = True
