from __future__ import annotations

from collections import Counter
from itertools import permutations
import random

import numpy as np


BACKGROUND = 0
LINE_KINDS = ("horizontal", "vertical", "diag_down", "diag_up")
MIN_GRID_SIZE = 13
MAX_GRID_SIZE = 18
MIN_LINE_COUNT = 3
MAX_LINE_COUNT = 5
MIN_DIAGONAL_LENGTH = 5
MIN_VISIBLE_PIXELS = 2
GENERATION_ATTEMPTS = 400


def _get_bg(grid: np.ndarray) -> int:
    return int(Counter(map(int, grid.ravel())).most_common(1)[0][0])


def _colors_present(grid: np.ndarray, bg: int) -> list[int]:
    return sorted(int(v) for v in np.unique(grid) if int(v) != int(bg))


def _line_cells(shape: tuple[int, int], kind: str, value: int) -> frozenset[tuple[int, int]]:
    h, w = map(int, shape)
    if kind == "horizontal":
        return frozenset((int(value), c) for c in range(w))
    if kind == "vertical":
        return frozenset((r, int(value)) for r in range(h))
    if kind == "diag_down":
        return frozenset((r, r - int(value)) for r in range(h) if 0 <= r - int(value) < w)
    if kind == "diag_up":
        return frozenset((r, int(value) - r) for r in range(h) if 0 <= int(value) - r < w)
    raise AssertionError(f"unknown line kind: {kind}")


def _infer_signature(coords: np.ndarray) -> tuple[str, int]:
    assert coords.ndim == 2 and coords.shape[1] == 2
    assert int(coords.shape[0]) >= MIN_VISIBLE_PIXELS

    rows = coords[:, 0]
    cols = coords[:, 1]
    candidates: list[tuple[str, int]] = []
    if np.all(rows == rows[0]):
        candidates.append(("horizontal", int(rows[0])))
    if np.all(cols == cols[0]):
        candidates.append(("vertical", int(cols[0])))
    diffs = rows - cols
    if np.all(diffs == diffs[0]):
        candidates.append(("diag_down", int(diffs[0])))
    sums = rows + cols
    if np.all(sums == sums[0]):
        candidates.append(("diag_up", int(sums[0])))
    assert len(candidates) == 1, "each visible color must determine exactly one full line"
    return candidates[0]


def _infer_lines(grid: np.ndarray, bg: int) -> dict[int, frozenset[tuple[int, int]]]:
    lines: dict[int, frozenset[tuple[int, int]]] = {}
    seen_signatures: set[tuple[str, int]] = set()
    for color in _colors_present(grid, bg):
        coords = np.argwhere(grid == color)
        signature = _infer_signature(coords)
        assert signature not in seen_signatures, "two colors cannot encode the same line"
        seen_signatures.add(signature)
        cells = _line_cells(grid.shape, *signature)
        assert set(map(tuple, coords)).issubset(cells)
        lines[int(color)] = cells
    assert MIN_LINE_COUNT <= len(lines) <= MAX_LINE_COUNT
    return lines


def _valid_orders(colors: list[int], below_edges: set[tuple[int, int]]) -> list[tuple[int, ...]]:
    orders: list[tuple[int, ...]] = []
    for order in permutations(colors):
        pos = {color: i for i, color in enumerate(order)}
        if all(pos[lower] < pos[upper] for lower, upper in below_edges):
            orders.append(tuple(int(v) for v in order))
    return orders


def _infer_order(grid: np.ndarray, lines: dict[int, frozenset[tuple[int, int]]], bg: int) -> tuple[int, ...]:
    below_edges: set[tuple[int, int]] = set()
    h, w = map(int, grid.shape)
    items = list(lines.items())
    for r in range(h):
        for c in range(w):
            covering = [color for color, cells in items if (r, c) in cells]
            visible = int(grid[r, c])
            if visible == bg:
                assert not covering
                continue
            assert visible in covering
            if len(covering) >= 2:
                for color in covering:
                    if color != visible:
                        below_edges.add((int(color), visible))
    valid = _valid_orders(list(lines), below_edges)
    assert len(valid) == 1, "crossing colors must imply a unique full layer order"
    return valid[0]


def _render_input(shape: tuple[int, int], ordered_lines: list[tuple[int, frozenset[tuple[int, int]]]]) -> np.ndarray:
    grid = np.full(shape, BACKGROUND, dtype=int)
    for color, cells in ordered_lines:
        for r, c in cells:
            grid[r, c] = int(color)
    return grid


def _render_shifted(
    shape: tuple[int, int],
    lines: dict[int, frozenset[tuple[int, int]]],
    shift_by_color: dict[int, int],
    draw_order: tuple[int, ...],
) -> np.ndarray:
    h, w = map(int, shape)
    out = np.full((h, w), BACKGROUND, dtype=int)
    for color in draw_order:
        shift = int(shift_by_color[int(color)])
        for r, c in lines[int(color)]:
            rr = int(r) + shift
            if 0 <= rr < h and 0 <= int(c) < w:
                out[rr, int(c)] = int(color)
    return out


def _shifted_cells(shape: tuple[int, int], cells: frozenset[tuple[int, int]], shift: int) -> frozenset[tuple[int, int]]:
    h, w = map(int, shape)
    moved = {(int(r) + int(shift), int(c)) for r, c in cells if 0 <= int(r) + int(shift) < h and 0 <= int(c) < w}
    return frozenset(moved)


def main(grid: np.ndarray) -> np.ndarray:
    """
    Infer the stacked order of crossing lines, then slide each whole line downward by its layer depth.

    Input structure:
    - The background is black.
    - The foreground consists of 3-5 one-cell-thick straight lines, each in a different color.
    - Every foreground color is the visible subset of one full horizontal, vertical, or 45-degree diagonal line.
    - At crossings, only the topmost line's color is visible and lower lines are hidden at that cell.

    Rule:
    - Reconstruct each line's full geometric path from its visible collinear cells.
    - Use visible crossing colors to infer the unique bottom-to-top layer order: the visible color at a crossing is above every other line through that cell.
    - Erase the input and redraw the full lines from bottom to top, shifting each line downward by K rows where K is its layer index (bottom=1, ..., top=N).
    - Clip any shifted pixels that fall below the grid, and let later (higher-layer) redraws overwrite earlier ones at new crossings.

    Key insight:
    - The hidden-layer ordering is not the final output itself; it is converted into per-line shift distances, so correct displacement and correct redraw order both depend on the inferred occlusion hierarchy.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    bg = _get_bg(g)
    assert bg == BACKGROUND

    lines = _infer_lines(g, bg)
    order = _infer_order(g, lines, bg)
    shifts = {color: idx for idx, color in enumerate(order, start=1)}
    return _render_shifted(g.shape, lines, shifts, order)


def _candidate_lines(size: int) -> list[tuple[str, int, frozenset[tuple[int, int]]]]:
    pool: list[tuple[str, int, frozenset[tuple[int, int]]]] = []
    for row in range(size):
        pool.append(("horizontal", row, _line_cells((size, size), "horizontal", row)))
    for col in range(size):
        pool.append(("vertical", col, _line_cells((size, size), "vertical", col)))
    for diff in range(-(size - 1), size):
        cells = _line_cells((size, size), "diag_down", diff)
        if len(cells) >= MIN_DIAGONAL_LENGTH:
            pool.append(("diag_down", diff, cells))
    for total in range(0, 2 * size - 1):
        cells = _line_cells((size, size), "diag_up", total)
        if len(cells) >= MIN_DIAGONAL_LENGTH:
            pool.append(("diag_up", total, cells))
    return pool


def _crosses(
    a: tuple[str, int, frozenset[tuple[int, int]]],
    b: tuple[str, int, frozenset[tuple[int, int]]],
) -> bool:
    return bool(a[2] & b[2])


def _build_ordered_signatures(size: int, count: int) -> list[tuple[str, int, frozenset[tuple[int, int]]]] | None:
    pool = _candidate_lines(size)
    allow_extra_cross = random.random() < 0.45

    for _ in range(120):
        order: list[tuple[str, int, frozenset[tuple[int, int]]]] = [random.choice(pool)]
        used = {(order[0][0], order[0][1])}
        cover_counts = Counter({cell: 1 for cell in order[0][2]})

        def backtrack() -> bool:
            if len(order) == count:
                return True

            prev_idx = len(order) - 1
            candidates = []
            for cand in pool:
                key = (cand[0], cand[1])
                if key in used:
                    continue
                crossers = [i for i, other in enumerate(order) if _crosses(cand, other)]
                if prev_idx not in crossers:
                    continue
                if allow_extra_cross:
                    if len(crossers) > 2:
                        continue
                else:
                    if len(crossers) != 1:
                        continue

