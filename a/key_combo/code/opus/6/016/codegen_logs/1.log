    inp, expected = placed
    if not np.all(inp[0] == BACKGROUND):
        return None
    if not np.array_equal(main(inp), expected):
        return None
    return inp


def generate_input():
    for _ in range(MAX_ATTEMPTS):
        grid = _gen_attempt()
        if grid is not None:
            return grid
    raise RuntimeError("failed to generate valid 8e301a54 input")

