        target = coords + np.array([out_r, 0])
        clipped = bool(np.any(target[:, 0] >= height))
        if clipped != want_clip:
            continue
        if not np.any(target[:, 0] < height):
            continue
        for out_c in range(0, width - shape_w + 1):
