spec:
  grid: 10x10 [observed]
  background: 7 (orange) [observed]
  objects:
    count: 3 [observed]
    colors: 3 distinct non-bg colors, one per object; {2,5,9} [observed]
    connectivity: 4-connected monochromatic
    area: 1-5 per object
    shape: arbitrary 4-connected polyomino within bounding box
  placement:
    no overlap in input
    row 0 is all background [observed]
    topmost object starts at row >= 1 [observed]
  rule: each object translates down by exactly its own pixel count (area)
  output_constraints:
    moved objects must not overlap each other
    at least 1 pixel per object remains visible (not fully clipped below grid)
    partial clipping allowed (0-2 objects may clip) [observed]

generation_strategy:
