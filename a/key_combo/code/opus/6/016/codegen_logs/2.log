+def _runs_1d(arr: np.ndarray) -> list[tuple[int, int]]:
+    runs: list[tuple[int, int]] = []
+    i = 0
+    n = arr.shape[0]
+    while i < n:
+        if not arr[i]:
+            i += 1
+            continue
+        j = i
+        while j + 1 < n and arr[j + 1]:
+            j += 1
+        runs.append((i, j))
+        i = j + 1
+    return runs
 
 
