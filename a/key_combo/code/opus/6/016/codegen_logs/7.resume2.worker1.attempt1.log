+
+def _neighbors4(r: int, c: int) -> tuple[tuple[int, int], ...]:
+    return ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1))
+
+
+def _component_coords(mask: np.ndarray) -> list[np.ndarray]:
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    h, w = mask.shape
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while q:
+                cr, cc = q.popleft()
+                coords.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _normalize_shape(coords: list[tuple[int, int]]) -> np.ndarray:
+    arr = np.array(coords, dtype=int)
+    arr[:, 0] -= int(arr[:, 0].min())
+    arr[:, 1] -= int(arr[:, 1].min())
+    order = np.lexsort((arr[:, 1], arr[:, 0]))
+    return arr[order]
+
+
+def _oriented_shape(
+    base: tuple[tuple[int, int], ...],
+    axis_kind: str,
+    source_side: str,
+) -> np.ndarray:
+    arr = np.array(base, dtype=int)
+    if axis_kind == "v":
+        if source_side == "right":
+            arr[:, 1] = int(arr[:, 1].max()) - arr[:, 1]
+    else:
+        arr = arr[:, [1, 0]]
+        if source_side == "bottom":
+            arr[:, 0] = int(arr[:, 0].max()) - arr[:, 0]
+    return _normalize_shape([tuple(map(int, rc)) for rc in arr])
+
+
+def _shape_span(shape: np.ndarray) -> tuple[int, int]:
+    return int(shape[:, 0].max()) + 1, int(shape[:, 1].max()) + 1
+
+
+def _mirror_coords(coords: np.ndarray, axis_kind: str, axis_idx: int) -> np.ndarray:
+    mirrored = coords.copy()
+    if axis_kind == "h":
+        mirrored[:, 0] = 2 * axis_idx - mirrored[:, 0]
+    else:
+        mirrored[:, 1] = 2 * axis_idx - mirrored[:, 1]
+    return mirrored
