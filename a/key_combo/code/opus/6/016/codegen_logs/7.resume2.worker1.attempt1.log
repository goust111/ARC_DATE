+        for r, c in choices:
+            if int(grid[r, c]) != BACKGROUND:
+                continue
+            grid[r, c] = WALL
+            try:
+                new_details = _solve_details(grid)
+            except AssertionError:
+                grid[r, c] = BACKGROUND
+                continue
+            old_sig = _path_signature(info["path"])
+            new_sig = None
+            for new_info in new_details["paths"]:
+                if int(new_info["color"]) == int(info["color"]):
+                    new_sig = _path_signature(new_info["path"])
+                    break
+            grid[r, c] = BACKGROUND
+            if new_sig is not None and new_sig != old_sig:
+                grid[r, c] = WALL
+                return True
+    return False
+
+
+def _add_decorative_walls(grid: np.ndarray, axis_kind: str, axis_idx: int, source_side: str) -> bool:
+    other_half = {
+        "left": "right",
+        "right": "left",
+        "top": "bottom",
+        "bottom": "top",
+    }[source_side]
+    halves = [source_side, other_half, source_side, other_half]
+    for half in halves:
+        if random.random() < 0.55 and _valid_wall_layout(grid, axis_kind, axis_idx):
+            continue
+        seg = _random_free_segment(grid, axis_kind, axis_idx, half, random.randint(1, 3))
+        if seg is None:
+            continue
+        for r, c in seg:
+            grid[r, c] = WALL
+        try:
+            _solve_details(grid)
+        except AssertionError:
+            for r, c in seg:
+                grid[r, c] = BACKGROUND
+    return _valid_wall_layout(grid, axis_kind, axis_idx)
+
+
+def _validate_semantics(grid: np.ndarray) -> bool:
