+def _path_candidates(
+    start: tuple[int, int],
+    stop: tuple[int, int],
+) -> list[tuple[tuple[int, int], list[tuple[int, int]]]]:
+    if start == stop:
+        return [((start[0], start[1]), [start])]
+    if start[0] == stop[0] or start[1] == stop[1]:
+        bend = (min(start[0], stop[0]), min(start[1], stop[1]))
+        return [(bend, _full_segment(start, stop))]
+
+    turn_a = (start[0], stop[1])
+    turn_b = (stop[0], start[1])
+    path_a = _full_segment(start, turn_a) + _full_segment(turn_a, stop)[1:]
+    path_b = _full_segment(start, turn_b) + _full_segment(turn_b, stop)[1:]
+    return [(turn_a, path_a), (turn_b, path_b)]
