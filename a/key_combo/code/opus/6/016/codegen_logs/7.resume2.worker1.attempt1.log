+def _path_clear(path: list[tuple[int, int]], canvas: np.ndarray, color: int) -> bool:
+    allowed = {BACKGROUND, GUIDE, color}
+    return all(int(canvas[r, c]) in allowed for r, c in path)
+
+
+def _best_connector(
+    comp_a: np.ndarray,
+    comp_b: np.ndarray,
+    canvas: np.ndarray,
+    color: int,
+) -> dict | None:
+    best: dict | None = None
+    for a_raw in comp_a:
+        start = (int(a_raw[0]), int(a_raw[1]))
+        for b_raw in comp_b:
+            stop = (int(b_raw[0]), int(b_raw[1]))
+            for bend, path in _path_candidates(start, stop):
+                if not _path_clear(path, canvas, color):
+                    continue
+                record = {
+                    "start": start,
+                    "stop": stop,
+                    "bend": (int(bend[0]), int(bend[1])),
+                    "path": path,
+                    "length": len(path) - 1,
+                }
+                key = (
+                    int(record["length"]),
+                    int(record["bend"][0]),
+                    int(record["bend"][1]),
+                    int(record["stop"][0]),
+                    int(record["stop"][1]),
+                    int(record["start"][0]),
+                    int(record["start"][1]),
+                    tuple(record["path"]),
+                )
+                if best is None or key < best["key"]:
+                    record["key"] = key
+                    best = record
