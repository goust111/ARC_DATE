+
+def _random_free_segment(
+    grid: np.ndarray,
+    axis_kind: str,
+    axis_idx: int,
+    half: str,
+    length: int,
+) -> list[tuple[int, int]] | None:
+    h, w = grid.shape
+    orientations = ["h", "v"]
+    random.shuffle(orientations)
+    for orient in orientations:
+        cells: list[list[tuple[int, int]]] = []
+        if orient == "h":
+            for r in range(h):
+                if axis_kind == "h" and r == axis_idx:
+                    continue
+                for c0 in range(w - length + 1):
+                    seg = [(r, c0 + dc) for dc in range(length)]
+                    cells.append(seg)
+        else:
+            for c in range(w):
+                if axis_kind == "v" and c == axis_idx:
+                    continue
+                for r0 in range(h - length + 1):
+                    seg = [(r0 + dr, c) for dr in range(length)]
+                    cells.append(seg)
+        random.shuffle(cells)
+        for seg in cells:
+            if half == "left" and any(c >= axis_idx for _, c in seg):
+                continue
+            if half == "right" and any(c <= axis_idx for _, c in seg):
+                continue
+            if half == "top" and any(r >= axis_idx for r, _ in seg):
+                continue
+            if half == "bottom" and any(r <= axis_idx for r, _ in seg):
+                continue
+            if all(int(grid[r, c]) == BACKGROUND for r, c in seg):
+                return seg
+    return None
+
+
+def _path_signature(path: list[tuple[int, int]]) -> tuple[tuple[int, int], ...]:
+    return tuple((int(r), int(c)) for r, c in path)
+
+
+def _try_forced_wall(grid: np.ndarray, path_info: list[dict], axis_kind: str, axis_idx: int) -> bool:
+    random_paths = path_info[:]
+    random.shuffle(random_paths)
+    for info in random_paths:
+        path = info["path"]
+        if len(path) <= 2:
+            continue
+        choices = [cell for cell in path[1:-1] if not ((axis_kind == "h" and cell[0] == axis_idx) or (axis_kind == "v" and cell[1] == axis_idx))]
+        random.shuffle(choices)
+        for r, c in choices:
+            if int(grid[r, c]) != BACKGROUND:
+                continue
+            grid[r, c] = WALL
+            try:
+                new_details = _solve_details(grid)
+            except AssertionError:
+                grid[r, c] = BACKGROUND
+                continue
+            old_sig = _path_signature(info["path"])
+            new_sig = None
+            for new_info in new_details["paths"]:
+                if int(new_info["color"]) == int(info["color"]):
+                    new_sig = _path_signature(new_info["path"])
+                    break
+            grid[r, c] = BACKGROUND
+            if new_sig is not None and new_sig != old_sig:
+                grid[r, c] = WALL
+                return True
+    return False
