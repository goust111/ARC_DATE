+        if inferred is None:
+            return None
+        tile, key, mismatches = inferred
+        bbox_h = int(key[2] * 0 + (_bbox(coords)[2] - _bbox(coords)[0] + 1))
+        bbox_w = int(key[3] * 0 + (_bbox(coords)[3] - _bbox(coords)[1] + 1))
+        if bbox_h < 2 * tile.shape[0] or bbox_w < 2 * tile.shape[1]:
+            return None
+        tiles.append(tile)
+        total_mismatches += mismatches
+
+    return {
+        "run": run,
+        "colors": colors,
+        "rays": rays,
+        "regions": regions,
+        "tiles": tiles,
