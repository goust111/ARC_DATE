from __future__ import annotations

import random
from collections import Counter, deque

import numpy as np


BG = 0
RAY = 5
DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
ORTHO_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
NON_BG_NON_RAY = [1, 2, 3, 4, 6, 7, 8, 9]
TILE_SHAPES = [(2, 2), (2, 3), (3, 2), (3, 3)]
GEN_ATTEMPTS = 400


def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
    r0, c0 = coords.min(axis=0)
    r1, c1 = coords.max(axis=0)
    return int(r0), int(c0), int(r1), int(c1)


def _components(mask: np.ndarray) -> list[np.ndarray]:
    h, w = mask.shape
    seen = np.zeros((h, w), dtype=bool)
    out: list[np.ndarray] = []
    for r in range(h):
        for c in range(w):
            if not mask[r, c] or seen[r, c]:
                continue
            q = deque([(r, c)])
            seen[r, c] = True
            pts: list[tuple[int, int]] = []
            while q:
                rr, cc = q.popleft()
                pts.append((rr, cc))
                for dr, dc in ORTHO_DIRS:
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
                        seen[nr, nc] = True
                        q.append((nr, nc))
            out.append(np.array(pts, dtype=int))
    return out


def _run_candidates(grid: np.ndarray) -> list[list[tuple[int, int]]]:
    h, w = grid.shape
    counts = Counter(map(int, grid.flat))
    out: list[list[tuple[int, int]]] = []
    for r in range(h):
        c = 0
        while c < w:
            color = int(grid[r, c])
            if color == BG or counts[color] != 1:
                c += 1
                continue
            start = c
            while c < w and int(grid[r, c]) != BG and counts[int(grid[r, c])] == 1:
                c += 1
            if c - start >= 4:
                out.append([(r, cc) for cc in range(start, c)])
    return out


def _find_main_run(grid: np.ndarray) -> list[tuple[int, int]]:
    candidates = _run_candidates(grid)
    assert candidates, "expected a horizontal multicolor run"
    best_len = max(len(cand) for cand in candidates)
    best = [cand for cand in candidates if len(cand) == best_len]
    assert len(best) == 1, "main multicolor run must be unique"
    return best[0]


def _cast_rays(
    shape: tuple[int, int],
    run: list[tuple[int, int]],
    run_colors: list[int],
    *,
    reverse: bool = False,
) -> np.ndarray:
    h, w = shape
    out = np.zeros((h, w), dtype=int)
    ordered = list(zip(run, run_colors))
    if reverse:
        ordered = ordered[::-1]
    for (r, c), color in ordered:
        out[r, c] = int(color)
    for (r, c), _color in ordered:
        for dr, dc in DIAG_DIRS:
            nr, nc = r + dr, c + dc
            while 0 <= nr < h and 0 <= nc < w and out[nr, nc] == BG:
                out[nr, nc] = RAY
                nr += dr
                nc += dc
    return out


def _region_components(shape: tuple[int, int], run: list[tuple[int, int]], ray_canvas: np.ndarray) -> list[np.ndarray]:
    mask = ray_canvas == BG
    for r, c in run:
        mask[r, c] = False
    return _components(mask)


def _infer_periodic_tile(
    grid: np.ndarray,
    coords: np.ndarray,
    *,
    max_period: int = 3,
) -> tuple[np.ndarray, tuple[int, int], int]:
    r0, c0, r1, c1 = _bbox(coords)
    bbox_h = r1 - r0 + 1
    bbox_w = c1 - c0 + 1
    rel = coords - np.array([[r0, c0]], dtype=int)
    values = np.array([int(grid[r, c]) for r, c in coords], dtype=int)
    best: tuple[tuple[int, int, int, int], np.ndarray, int] | None = None

    for ph in range(1, min(max_period, bbox_h) + 1):
        if bbox_h < 2 * ph:
            continue
        for pw in range(1, min(max_period, bbox_w) + 1):
            if bbox_w < 2 * pw:
                continue
            tile = np.zeros((ph, pw), dtype=int)
            for rr in range(ph):
                for cc in range(pw):
                    mask = (rel[:, 0] % ph == rr) & (rel[:, 1] % pw == cc)
                    assert np.any(mask), "every residue must appear inside the region"
                    votes = values[mask]
                    tile[rr, cc] = Counter(map(int, votes)).most_common(1)[0][0]
            pred = tile[rel[:, 0] % ph, rel[:, 1] % pw]
            mismatches = int(np.count_nonzero(pred != values))
            key = (mismatches, ph * pw, ph, pw)
            if best is None or key < best[0]:
                best = (key, tile, mismatches)

    assert best is not None, "no admissible repeating tile found"
    _key, tile, mismatches = best
    return tile, tile.shape, mismatches


def _paint_region(out: np.ndarray, coords: np.ndarray, tile: np.ndarray) -> None:
    r0, c0, _r1, _c1 = _bbox(coords)
    ph, pw = tile.shape
    for r, c in coords:
        out[r, c] = int(tile[(r - r0) % ph, (c - c0) % pw])


def _minimal_period(tile: np.ndarray) -> tuple[int, int]:
    h, w = tile.shape
    for ph in range(1, h + 1):
        for pw in range(1, w + 1):
            ok = True
            for r in range(h):
                for c in range(w):
                    if tile[r, c] != tile[r % ph, c % pw]:
                        ok = False
                        break
                if not ok:
                    break
            if ok:
                return ph, pw
    raise AssertionError("unreachable")


def _random_tile(colors: tuple[int, int]) -> np.ndarray:
    a, b = map(int, colors)
    for _ in range(200):
        ph, pw = random.choice(TILE_SHAPES)
        tile = np.random.choice(np.array([a, b], dtype=int), size=(ph, pw))
        if len(set(map(int, tile.flat))) < 2:
            continue
        if _minimal_period(tile) != (ph, pw):
            continue
        return tile.astype(int)
    raise RuntimeError("failed to sample an irreducible tile")


def _best_global_mismatch(grid: np.ndarray, coords: np.ndarray) -> int:
    _tile, _shape, mismatches = _infer_periodic_tile(grid, coords)
    return mismatches


def _sample_region_variant(
    shape: tuple[int, int],
    coords: np.ndarray,
    pattern_colors: tuple[int, int],
    used_tiles: set[tuple[tuple[int, int], tuple[int, ...]]],
) -> tuple[np.ndarray, np.ndarray, np.ndarray] | None:
    h, w = shape
    region_size = int(coords.shape[0])
    for _ in range(250):
        tile = _random_tile(pattern_colors)
        sig = (tile.shape, tuple(map(int, tile.flat)))
        if sig in used_tiles:
            continue

        clean = np.zeros((h, w), dtype=int)
        noisy = np.zeros((h, w), dtype=int)
        _paint_region(clean, coords, tile)
        _paint_region(noisy, coords, tile)

        inferred_clean, clean_shape, _ = _infer_periodic_tile(clean, coords)
        if clean_shape != tile.shape or not np.array_equal(inferred_clean, tile):
            continue

        max_noise = min(3, max(1, region_size // 5))
        n_noise = random.randint(1, max_noise)
        for idx in random.sample(range(region_size), n_noise):
            r, c = map(int, coords[idx])
            current = int(noisy[r, c])
            choices = [color for color in pattern_colors if int(color) != current]
            noisy[r, c] = int(random.choice(choices))

        inferred_noisy, noisy_shape, mismatches = _infer_periodic_tile(noisy, coords)
        if noisy_shape != tile.shape or mismatches < 1:
            continue
        if not np.array_equal(inferred_noisy, tile):
            continue

        used_tiles.add(sig)
        return tile, clean, noisy
    return None


def main(grid: np.ndarray) -> np.ndarray:
    """
    Repair noisy periodic tiles independently inside diagonal ray partitions cast from a multicolor row.

    Input structure:
    - Black background with one horizontal multicolor run near the middle and no visible grey rays yet.
    - The run's pixels are processed left-to-right; diagonal black gaps around it correspond to where occluding grey rays will be drawn.
    - Every 4-connected region outside those future rays contains a noisy periodic two-color pattern.

    Rule:
    - Reconstruct the multicolor run, then cast grey diagonal rays from each run pixel on a blank canvas, stopping at the first previously painted cell or the grid edge.
    - Use those rays as region boundaries; for each resulting region, ignore the run and the grey rays and infer the smallest repeating tile that still repeats at least twice in both bbox axes.
    - Repaint each region with its clean tile and keep the multicolor run while adding the grey rays to the output.

    Key insight:
    - The left-to-right ray order changes the partition geometry, and each partition must be repaired with its own local period; mixing regions destroys the tile evidence.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2

    run = _find_main_run(g)
    run_colors = [int(g[r, c]) for r, c in run]
    rays = _cast_rays(g.shape, run, run_colors)
    regions = _region_components(g.shape, run, rays)

    out = g.copy()
    for coords in regions:
        tile, _shape, _mismatches = _infer_periodic_tile(g, coords)
        _paint_region(out, coords, tile)

    out[rays == RAY] = RAY
    for (r, c), color in zip(run, run_colors):
        out[r, c] = int(color)
    return out


def _region_signature(coords: np.ndarray) -> tuple[int, tuple[int, int]]:
    r0, c0, r1, c1 = _bbox(coords)
    return int(coords.shape[0]), (r1 - r0 + 1, c1 - c0 + 1)


def _build_example() -> tuple[np.ndarray, np.ndarray] | None:
    h = random.randint(18, 26)
    w = random.randint(12, 15)
    run_len = random.randint(5, 6)
    left_gap = random.randint(3, max(3, w - run_len - 4))
    right_gap = w - run_len - left_gap
    if right_gap < 3:
        return None

    upper_row_lo = max(6, h // 4)
    upper_row_hi = max(upper_row_lo, h // 2 - 2)
    lower_row_lo = min(h - 7, h // 2 + 1)
    lower_row_hi = h - 7
    if lower_row_lo > lower_row_hi:
        return None
    if random.random() < 0.5:
        row = random.randint(upper_row_lo, upper_row_hi)
    else:
        row = random.randint(lower_row_lo, lower_row_hi)

    run_cols = list(range(left_gap, left_gap + run_len))
    color_pool = NON_BG_NON_RAY[:]
    random.shuffle(color_pool)
    run_colors = color_pool[:run_len]
    pattern_pool = color_pool[run_len:]
    if len(pattern_pool) < 2:
        return None
    pattern_colors = tuple(pattern_pool[:2])

    run = [(row, c) for c in run_cols]
    rays = _cast_rays((h, w), run, run_colors)
    reverse_rays = _cast_rays((h, w), run, run_colors, reverse=True)
    if np.array_equal(rays == RAY, reverse_rays == RAY):
        return None

    regions = _region_components((h, w), run, rays)
    if len(regions) < 4:
        return None
    if any(coords.shape[0] < 12 for coords in regions):
        return None

    bboxes = [_bbox(coords) for coords in regions]
    if any((r1 - r0 + 1) < 4 or (c1 - c0 + 1) < 4 for r0, c0, r1, c1 in bboxes):
        return None

    clean = np.zeros((h, w), dtype=int)
    noisy = np.zeros((h, w), dtype=int)
    for (r, c), color in zip(run, run_colors):
        clean[r, c] = int(color)
        noisy[r, c] = int(color)

    used_tiles: set[tuple[tuple[int, int], tuple[int, ...]]] = set()
    region_tiles: list[np.ndarray] = []
    for coords in regions:
        sampled = _sample_region_variant((h, w), coords, pattern_colors, used_tiles)
        if sampled is None:
            return None
        tile, clean_region, noisy_region = sampled
        region_tiles.append(tile)
        clean[clean_region != BG] = clean_region[clean_region != BG]
        noisy[noisy_region != BG] = noisy_region[noisy_region != BG]

    expected = clean.copy()
    expected[rays == RAY] = RAY

    try:
        if _find_main_run(noisy) != run:
            return None
    except AssertionError:
        return None
    if not np.array_equal(main(noisy), expected):
        return None

    all_region_coords = np.argwhere(clean != BG)
    run_mask = np.zeros((h, w), dtype=bool)
    for r, c in run:
        run_mask[r, c] = True
    all_pattern_coords = np.argwhere((clean != BG) & ~run_mask)
    global_mismatch = _best_global_mismatch(clean, all_pattern_coords)
    if global_mismatch < max(10, all_pattern_coords.shape[0] // 8):
        return None

    for coords, tile in zip(regions, region_tiles):
        inferred, shape, mismatches = _infer_periodic_tile(noisy, coords)
        if shape != tile.shape or not np.array_equal(inferred, tile):
            return None
        if mismatches < 1:
            return None

    if len({(tile.shape, tuple(map(int, tile.flat))) for tile in region_tiles}) != len(region_tiles):
        return None
    if len({_region_signature(coords) for coords in regions}) < 2:
        return None

    return noisy, expected


def generate_input() -> np.ndarray:
    for _ in range(GEN_ATTEMPTS):
        built = _build_example()
        if built is not None:
            inp, _out = built
            return inp
    raise RuntimeError("failed to generate a valid ray-partition tile-repair example")


