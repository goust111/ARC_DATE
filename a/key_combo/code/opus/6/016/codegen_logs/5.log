-def main(grid: np.ndarray) -> np.ndarray:
-    """
-    Repair noisy periodic tiles independently inside diagonal ray partitions cast from a multicolor row.
-
-    Input structure:
-    - Black background with one horizontal multicolor run near the middle and no visible grey rays yet.
-    - The run's pixels are processed left-to-right; diagonal black gaps around it correspond to where occluding grey rays will be drawn.
-    - Every 4-connected region outside those future rays contains a noisy periodic two-color pattern.
-
-    Rule:
-    - Reconstruct the multicolor run, then cast grey diagonal rays from each run pixel on a blank canvas, stopping at the first previously painted cell or the grid edge.
-    - Use those rays as region boundaries; for each resulting region, ignore the run and the grey rays and infer the smallest repeating tile that still repeats at least twice in both bbox axes.
-    - Repaint each region with its clean tile and keep the multicolor run while adding the grey rays to the output.
-
-    Key insight:
-    - The left-to-right ray order changes the partition geometry, and each partition must be repaired with its own local period; mixing regions destroys the tile evidence.
-    """
-    g = np.asarray(grid, dtype=int)
-    assert g.ndim == 2
-
-    run = _find_main_run(g)
-    run_colors = [int(g[r, c]) for r, c in run]
-    rays = _cast_rays(g.shape, run, run_colors)
-    regions = _region_components(g.shape, run, rays)
-
-    out = g.copy()
-    for coords in regions:
-        tile, _shape, _mismatches = _infer_periodic_tile(g, coords)
-        _paint_region(out, coords, tile)
-
-    out[rays == RAY] = RAY
-    for (r, c), color in zip(run, run_colors):
-        out[r, c] = int(color)
-    return out
-
-
-def _region_signature(coords: np.ndarray) -> tuple[int, tuple[int, int]]:
-    r0, c0, r1, c1 = _bbox(coords)
-    return int(coords.shape[0]), (r1 - r0 + 1, c1 - c0 + 1)
-
