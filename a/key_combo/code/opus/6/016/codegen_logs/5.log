        reasons['max_left'] += 1
        continue
    left_gap = random.randint(2, max_left)
    right_gap = w - run_len - left_gap
    if right_gap < 2:
        reasons['right_gap'] += 1
        continue

    upper_lo = max(5, h // 4)
    upper_hi = max(upper_lo, h // 2 - 2)
    lower_lo = min(h - 6, h // 2 + 1)
    lower_hi = h - 6
    if lower_lo > lower_hi:
        reasons['row_range'] += 1
        continue
    row = random.randint(upper_lo, upper_hi) if random.random() < 0.5 else random.randint(lower_lo, lower_hi)

