+        if inferred is None:
+            return None
+        tile, key, mismatches = inferred
+        r0, c0, r1, c1 = _bbox(coords)
+        bbox_h = int(r1 - r0 + 1)
+        bbox_w = int(c1 - c0 + 1)
+        if bbox_h < 2 * tile.shape[0] or bbox_w < 2 * tile.shape[1]:
+            return None
+        tiles.append(tile)
+        total_mismatches += mismatches
+
+    return {
+        "run": run,
+        "colors": colors,
+        "rays": rays,
+        "regions": regions,
+        "tiles": tiles,
+        "score": (int(total_mismatches), -int(len(regions)), -int(len(run))),
