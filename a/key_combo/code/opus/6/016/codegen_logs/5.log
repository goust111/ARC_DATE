-    all_pattern_coords = np.argwhere((clean != BG) & ~run_mask)
-    global_mismatch = _best_global_mismatch(clean, all_pattern_coords)
-    if global_mismatch < max(10, all_pattern_coords.shape[0] // 8):
-        return None
-
-    for coords, tile in zip(regions, region_tiles):
