def main(grid: np.ndarray) -> np.ndarray:
    """
    Rotate every blue-started bar chain, then truncate losing horizontal bars where different chains collide.

    Input structure:
    - Black background with bottom-aligned one-pixel-wide vertical bars.
    - Blue bars mark chain starts; red bars may continue a chain or remain independent.
    - Each bar is a solid vertical segment in its own column, and all bars share one baseline.

    Rule:
    - From each blue bar, repeatedly follow the red bar whose column equals the current bar's column plus its height.
    - Erase every bar in each discovered chain, then rotate each such bar into a blue horizontal bar drawn rightward from the original bottom cell with the same length as its height.
    - When rotated bars from different chains collide, the chain with larger total chain height keeps the shared pixels; the weaker chain's colliding bar is cut off at its first collision column. If totals tie, the chain whose blue start is farther left wins.
    - Red bars that belong to no blue-started chain stay vertical and unchanged.

    Key insight:
    - A bar's height simultaneously encodes the next chain jump and the rotated width, while collision priority depends on the whole chain's total size rather than the local bar length.
    """
    g = np.asarray(grid, dtype=int)
    bg = _get_bg(g)
    bars, baseline = _extract_bars(g, bg)
    chains, _unchained = _build_chains(bars)
    assert 1 <= len(chains)
    return _render_rotated(g, bars, chains, baseline, bg)


def _make_chain(start_col: int, heights: list[int]) -> list[dict]:
    bars = []
    col = int(start_col)
    for idx, height in enumerate(heights):
        bars.append({"color": START if idx == 0 else BODY, "col": col, "height": int(height)})
        col += int(height)
    return bars


def _all_bar_cols(chains: list[dict]) -> list[int]:
    cols: list[int] = []
    for chain in chains:
        cols.extend(int(bar["col"]) for bar in chain["bars"])
    return sorted(cols)


