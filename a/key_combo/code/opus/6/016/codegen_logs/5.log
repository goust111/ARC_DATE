reasons = Counter()
for attempt in range(1000):
    h = random.randint(18, 26)
    w = random.randint(10, 14)
    run_len = random.randint(5, min(8, w - 4))
    max_left = w - run_len - 2
    if max_left < 2:
        reasons['max_left'] += 1
        continue
    left_gap = random.randint(2, max_left)
    right_gap = w - run_len - left_gap
    if right_gap < 2:
        reasons['right_gap'] += 1
        continue

    upper_lo = max(5, h // 4)
    upper_hi = max(upper_lo, h // 2 - 2)
    lower_lo = min(h - 6, h // 2 + 1)
    lower_hi = h - 6
    if lower_lo > lower_hi:
        reasons['row_range'] += 1
        continue
    row = random.randint(upper_lo, upper_hi) if random.random() < 0.5 else random.randint(lower_lo, lower_hi)

    run_colors = random.sample(mod.PALETTE, run_len)
    run = [(row, c) for c in range(left_gap, left_gap + run_len)]
    rays = mod._cast_rays((h, w), run, run_colors)
    reverse_rays = mod._cast_rays((h, w), run, run_colors, reverse=True)
    if np.array_equal(rays == mod.RAY, reverse_rays == mod.RAY):
        reasons['reverse_same'] += 1
        continue

    regions = mod._region_components((h, w), run, rays)
    if len(regions) < 4:
        reasons[f'region_count_{len(regions)}'] += 1
        continue
    bad_bbox = False
    for coords in regions:
        r0, c0, r1, c1 = mod._bbox(coords)
        if (r1 - r0 + 1) < 4 or (c1 - c0 + 1) < 4:
            bad_bbox = True
            break
    if bad_bbox:
        reasons['small_bbox'] += 1
        continue

    clean = np.zeros((h, w), dtype=int)
    noisy = np.zeros((h, w), dtype=int)
    for (r, c), color in zip(run, run_colors):
        clean[r, c] = int(color)
        noisy[r, c] = int(color)

    used_signatures = set()
    ok = True
    for coords in regions:
        sampled = mod._sample_region_variant((h, w), coords, used_signatures)
        if sampled is None:
            ok = False
            reasons['sample_region'] += 1
            break
        _tile, clean_region, noisy_region = sampled
        clean[clean_region "'!= mod.BG] = clean_region[clean_region != mod.BG]
        noisy[noisy_region != mod.BG] = noisy_region[noisy_region != mod.BG]
    if not ok:
        continue

    expected = clean.copy()
    expected[rays == mod.RAY] = mod.RAY

    try:
        details = mod._solve_details(noisy)
    except AssertionError as exc:
        reasons[f'"'solve:{exc}'] += 1
        continue
    best = details['best']
    if tuple(best['run']) "'!= tuple(run):
        reasons['"'wrong_run'] += 1
        continue
    if not np.array_equal(mod._render_solution(noisy, details), expected):
        reasons['wrong_output'] += 1
        continue

    global_mismatch = mod._global_partition_mismatch(clean, run)
    if global_mismatch < max(8, int(np.count_nonzero(clean) // 10)):
        reasons['global_mismatch'] += 1
        continue
    reasons['success'] += 1
print(reasons)
