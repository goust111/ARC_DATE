-    left_gap = random.randint(3, max(3, w - run_len - 4))
-    right_gap = w - run_len - left_gap
-    if right_gap < 3:
-        return None
-
-    upper_row_lo = max(6, h // 4)
-    upper_row_hi = max(upper_row_lo, h // 2 - 2)
-    lower_row_lo = min(h - 7, h // 2 + 1)
-    lower_row_hi = h - 7
-    if lower_row_lo > lower_row_hi:
-        return None
-    if random.random() < 0.5:
-        row = random.randint(upper_row_lo, upper_row_hi)
-    else:
-        row = random.randint(lower_row_lo, lower_row_hi)
-
-    run_cols = list(range(left_gap, left_gap + run_len))
-    color_pool = NON_BG_NON_RAY[:]
-    random.shuffle(color_pool)
-    run_colors = color_pool[:run_len]
-    pattern_pool = color_pool[run_len:]
-    if len(pattern_pool) < 2:
-        return None
-    pattern_colors = tuple(pattern_pool[:2])
-
-    run = [(row, c) for c in run_cols]
-    rays = _cast_rays((h, w), run, run_colors)
-    reverse_rays = _cast_rays((h, w), run, run_colors, reverse=True)
-    if np.array_equal(rays == RAY, reverse_rays == RAY):
-        return None
-
-    regions = _region_components((h, w), run, rays)
-    if len(regions) < 4:
-        return None
-    if any(coords.shape[0] < 12 for coords in regions):
-        return None
-
-    bboxes = [_bbox(coords) for coords in regions]
-    if any((r1 - r0 + 1) < 4 or (c1 - c0 + 1) < 4 for r0, c0, r1, c1 in bboxes):
-        return None
-
-    clean = np.zeros((h, w), dtype=int)
-    noisy = np.zeros((h, w), dtype=int)
-    for (r, c), color in zip(run, run_colors):
-        clean[r, c] = int(color)
-        noisy[r, c] = int(color)
-
-    used_tiles: set[tuple[tuple[int, int], tuple[int, ...]]] = set()
-    region_tiles: list[np.ndarray] = []
-    for coords in regions:
-        sampled = _sample_region_variant((h, w), coords, pattern_colors, used_tiles)
-        if sampled is None:
-            return None
-        tile, clean_region, noisy_region = sampled
-        region_tiles.append(tile)
-        clean[clean_region != BG] = clean_region[clean_region != BG]
-        noisy[noisy_region != BG] = noisy_region[noisy_region != BG]
-
-    expected = clean.copy()
-    expected[rays == RAY] = RAY
-
-    try:
-        if _find_main_run(noisy) != run:
-            return None
-    except AssertionError:
-        return None
-    if not np.array_equal(main(noisy), expected):
-        return None
-
-    all_region_coords = np.argwhere(clean != BG)
