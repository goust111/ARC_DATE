def main(grid: np.ndarray) -> np.ndarray:
    """
    Repack the mixed-color sprites by area and use embedded blue counts to set the following gaps.

    Input structure:
    - The background is azure (8), and the bottom row is a full orange (7) baseline.
    - Above the baseline sit 3-4 irregular 4-connected sprites; each sprite uses one main color plus optional blue (1) pixels.
    - Blue pixels belong to the sprite's own connected shape, so each sprite's total area includes both blue and main-color cells.

    Rule:
    - Find each sprite as a 4-connected non-background, non-baseline component.
    - For every sprite, measure its total area including blue pixels and count its blue pixels B.
    - Sort sprites by total area from smallest to largest, then place their bounding-box sprites from left to right with bottoms aligned to the row just above the baseline.
    - The first sprite starts at column 0; each later sprite begins after a horizontal gap equal to the previous sprite's blue count, except B=0 uses a minimum gap of 1.
    - After placement, recolor every blue pixel inside each sprite to that sprite's main color; keep the baseline and background unchanged.

    Key insight:
    - Blue pixels carry two visible roles at once: they increase the sprite's sortable area and also encode the gap that follows that sprite in the packed arrangement.
    """
    g = np.asarray(grid, dtype=int)
    assert g.ndim == 2
    assert np.all(g[-1, :] == BASELINE), "expected a full bottom baseline"

    sprites = _extract_sprites(g)
    assert 3 <= len(sprites) <= 4

    areas = [sprite["area"] for sprite in sprites]
    blue_counts = [sprite["blue_count"] for sprite in sprites]
    assert len(set(areas)) == len(areas), "sprite areas must be unique"
    assert len(set(blue_counts)) == len(blue_counts), "blue counts must be unique"
    assert all(0 <= b <= 3 for b in blue_counts)

    return _packed_output(
        g.shape,
        sprites,
        sort_key=lambda item: item["area"],
        gap_mode="encoded",
        recolor_blue=True,
    )


