+    for coords, tile in zip(best["regions"], best["tiles"]):
+        _paint_region(out, coords, tile)
+    out[best["rays"] == RAY] = RAY
+    for (r, c), color in zip(best["run"], best["colors"]):
+        out[r, c] = int(color)
+    return out
