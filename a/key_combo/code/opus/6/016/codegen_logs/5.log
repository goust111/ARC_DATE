-        if shape != tile.shape or not np.array_equal(inferred, tile):
-            return None
-        if mismatches < 1:
-            return None
-
-    if len({(tile.shape, tuple(map(int, tile.flat))) for tile in region_tiles}) != len(region_tiles):
-        return None
-    if len({_region_signature(coords) for coords in regions}) < 2:
-        return None
-
-    return noisy, expected
-
-
-def generate_input() -> np.ndarray:
-    for _ in range(GEN_ATTEMPTS):
-        built = _build_example()
-        if built is not None:
-            inp, _out = built
-            return inp
-    raise RuntimeError("failed to generate a valid ray-partition tile-repair example")

