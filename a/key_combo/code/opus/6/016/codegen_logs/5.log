            break
        _tile, clean_region, noisy_region = sampled
        clean[clean_region "'!= mod.BG] = clean_region[clean_region != mod.BG]
        noisy[noisy_region != mod.BG] = noisy_region[noisy_region != mod.BG]
    if not ok:
        continue

    expected = clean.copy()
    expected[rays == mod.RAY] = mod.RAY

    try:
        details = mod._solve_details(noisy)
    except AssertionError as exc:
        reasons[f'"'solve:{exc}'] += 1
        continue
    best = details['best']
    if tuple(best['run']) "'!= tuple(run):
        reasons['"'wrong_run'] += 1
        continue
    if not np.array_equal(mod._render_solution(noisy, details), expected):
        reasons['wrong_output'] += 1
        continue

    global_mismatch = mod._global_partition_mismatch(clean, run)
    if global_mismatch < max(8, int(np.count_nonzero(clean) // 10)):
        reasons['global_mismatch'] += 1
        continue
    reasons['success'] += 1
print(reasons)
