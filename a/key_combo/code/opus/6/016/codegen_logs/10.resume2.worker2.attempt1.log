+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in neigh:
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
