+def _components_mask(mask: np.ndarray, connectivity: int = 4) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    neigh = NEIGHBORS4 if connectivity == 4 else NEIGHBORS8
