# Retry limit and 4-neighbor growth.
MAX_GENERATION_ATTEMPTS, NEIGHBORS4 = 300, ((-1, 0), (1, 0), (0, -1), (0, 1))

def generate_input():
    for _ in range(MAX_GENERATION_ATTEMPTS):
