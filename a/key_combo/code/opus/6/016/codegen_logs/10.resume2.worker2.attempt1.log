+        if i > 0:
+            pr, pc = path[i - 1]
+            dirs.append((r - pr, c - pc))
+        if i + 1 < len(path):
+            nr, nc = path[i + 1]
+            dirs.append((nr - r, nc - c))
+        for dr, dc in dirs:
+            lr, lc = _left_normal(dr, dc)
+            if (r + lr, c + lc) not in channel:
