+        lower_min = last_start + upper_area + gap
+        lower_max = last_end - 2 * lower_area + 1
+        if lower_min > lower_max:
+            continue
+        lower_start = random.randint(lower_min, lower_max)
+        lower = (lower_start, lower_start + lower_area - 1)
