        comp_mask[coords[:, 0], coords[:, 1]] = True
        masks.append(comp_mask)
    channel = _dilate8(masks[0]) & _dilate8(masks[1]) & ~path_mask
    return channel, comps


def _extract_objects(grid: np.ndarray, channel: np.ndarray) -> list[dict]:
