        for shift in range(1, area + 1):
            shifted = coords.copy()
            shifted[:, 0] += shift
            in_bounds = (0 <= shifted[:, 0]) & (shifted[:, 0] < h) & (0 <= shifted[:, 1]) & (shifted[:, 1] < w)
            if use_channel:
                keep = in_bounds.copy()
                if np.any(keep):
