0095: def _bounded_compositions(total, count, min_value, max_value):
0096:     values: list[tuple[int, ...]] = []
0097: 
0098:     def rec(prefix: list[int], remaining: int, slots: int) -> None:
0099:         if slots == 0:
0100:             if remaining == 0:
0101:                 values.append(tuple(prefix))
0102:             return
0103:         tail_slots = slots - 1
0104:         low = max(min_value, remaining - max_value * tail_slots)
0105:         high = min(max_value, remaining - min_value * tail_slots)
0106:         for value in range(low, high + 1):
0107:             prefix.append(value)
0108:             rec(prefix, remaining - value, tail_slots)
0109:             prefix.pop()
0110: 
0111:     rec([], total, count)
0112:     return values
