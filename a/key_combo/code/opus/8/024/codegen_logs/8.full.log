+
+
+def _paint(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
+    for r, c in cells:
+        grid[int(r), int(c)] = int(color)
+
+
+def _place_chamber(
+    grid: np.ndarray,
+    *,
+    corner: str,
+    size: int,
+    color: int,
+    bounds: tuple[int, int, int, int],
