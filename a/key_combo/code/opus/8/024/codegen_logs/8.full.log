+        "corner": corner,
+        "size": int(size),
+        "color": int(color),
+        "bbox": (r0, c0, r0 + size, c0 + size),
+        "diag": diag,
+        "notch": None,
+    }
+
+
+def _choose_notches(chambers: list[dict], require_twist: bool) -> None:
