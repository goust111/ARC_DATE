from collections import Counter, deque

import numpy as np

from arc_utils import Color, get_bg, in_bounds


def _sign(n: int) -> int:
    if n > 0:
        return 1
    if n < 0:
        return -1
    return 0


def _reachable(
    g: np.ndarray,
    bg: int,
    seed: tuple[int, int],
    moves: list[tuple[int, int]],
