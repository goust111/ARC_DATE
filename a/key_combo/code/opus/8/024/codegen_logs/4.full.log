+    src_r0 = max(0, -dr)
+    src_r1 = min(h, h - dr)
+    src_c0 = max(0, -dc)
+    src_c1 = min(w, w - dc)
+    if src_r0 >= src_r1 or src_c0 >= src_c1:
+        return out
+
+    dst_r0 = max(0, dr)
+    dst_r1 = min(h, h + dr)
+    dst_c0 = max(0, dc)
+    dst_c1 = min(w, w + dc)
+    out[dst_r0:dst_r1, dst_c0:dst_c1] = grid[src_r0:src_r1, src_c0:src_c1]
+    return out
