+def _compose_panel(mask_a: np.ndarray, mask_b: np.ndarray) -> np.ndarray:
+    out = np.zeros(mask_a.shape, dtype=int)
+    overlap = mask_a & mask_b
+    out[mask_a & ~mask_b] = BLUE
+    out[mask_b & ~mask_a] = RED
+    out[overlap] = YELLOW
+    return out
