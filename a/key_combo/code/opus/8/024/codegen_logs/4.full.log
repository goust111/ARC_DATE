+    offsets_a = [_find_unique_translation(layer_a[i], layer_a[i + 1]) for i in range(OBSERVED_FRAMES - 1)]
+    offsets_b = [_find_unique_translation(layer_b[i], layer_b[i + 1]) for i in range(OBSERVED_FRAMES - 1)]
