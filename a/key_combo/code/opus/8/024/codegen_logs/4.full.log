+def _decode_layer(panel: np.ndarray, layer_color: int) -> np.ndarray:
+    if layer_color == BLUE:
+        return (panel == BLUE) | (panel == YELLOW)
+    if layer_color == RED:
+        return (panel == RED) | (panel == YELLOW)
+    raise ValueError("unknown layer color")
