+    panels = []
+    start = 0
+    for sep in separator_rows:
+        panels.append(g[start:sep, :].copy())
+        start = sep + 1
+    panels.append(g[start:, :].copy())
+    assert len({panel.shape for panel in panels}) == 1, "panel sizes must match"
