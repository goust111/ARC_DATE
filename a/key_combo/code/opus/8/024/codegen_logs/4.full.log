+
+def _safe_window(h: int, w: int, dr: int, dc: int) -> np.ndarray:
+    r0 = max(0, -4 * dr)
+    r1 = h - 1 - max(0, 4 * dr)
+    c0 = max(0, -4 * dc)
+    c1 = w - 1 - max(0, 4 * dc)
+    out = np.zeros((h, w), dtype=bool)
+    if r0 <= r1 and c0 <= c1:
+        out[r0 : r1 + 1, c0 : c1 + 1] = True
+    return out
+
+
+def _manhattan_path(a: tuple[int, int], b: tuple[int, int], row_first: bool) -> list[tuple[int, int]]:
+    r, c = map(int, a)
+    tr, tc = map(int, b)
+    path = [(r, c)]
+    if row_first:
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+    else:
+        while c != tc:
+            c += 1 if tc > c else -1
+            path.append((r, c))
+        while r != tr:
+            r += 1 if tr > r else -1
+            path.append((r, c))
+    return path
