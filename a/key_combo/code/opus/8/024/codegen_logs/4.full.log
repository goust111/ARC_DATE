+    next_a = _shift_mask(layer_a[-1], offsets_a[0][0], offsets_a[0][1])
+    next_b = _shift_mask(layer_b[-1], offsets_b[0][0], offsets_b[0][1])
+    return _compose_panel(next_a, next_b)
