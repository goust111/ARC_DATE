GEN_PATCH_HEIGHT_RANGE, GEN_PATCH_WIDTH_RANGE = (3, 10), (3, 12)
GEN_THREE_CYCLE_PATCH_HEIGHT_RANGE, GEN_THREE_CYCLE_PATCH_WIDTH_RANGE = (3, 7), (3, 9)
