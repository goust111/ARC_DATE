+GEN_WIDTH_RANGE = (16, 22)
+GEN_BLOCK_COUNTS = (2, 3, 4)
+GEN_BLOCK_COUNT_WEIGHTS = (2, 3, 3)
+GEN_MIN_CENTER_SEP = 4
+GEN_ATTEMPTS = 400
