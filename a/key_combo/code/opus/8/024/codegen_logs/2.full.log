+    n = base.shape[0]
+    return [
+        orbit
+        for orbit in _ORBIT_CACHE[n]
+        if all(int(base[r, c]) == BLACK for r, c in orbit)
+    ]
+
+
+def _hidden_seed_changes_output(
+    base: np.ndarray,
+    orbit: tuple[tuple[int, int], ...],
+    color: int,
+    mask_cells: set[tuple[int, int]],
+) -> bool:
