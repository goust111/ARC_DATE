+
+            if not hidden_candidates or len(visible_candidates) < 1:
+                continue
+
+            for _ in range(30):
+                selected: list[tuple[tuple[tuple[int, int], ...], int]] = []
+                hidden_pixels = 0
+
+                one_cell_hidden = [
