+    red_dirs = ((0, -1), (0, 1)) if swap_mapping else ((-1, 0), (1, 0))
+    blue_dirs = ((-1, 0), (1, 0)) if swap_mapping else ((0, -1), (0, 1))
+
+    for r, c in np.argwhere(g == RED):
