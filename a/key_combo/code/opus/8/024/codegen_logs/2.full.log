+                    color = random.choice(colors)
+                    selected = [(orbit, color)]
+                    hidden_pixels = int(hidden_count)
+
+                used = {orbit for orbit, _color in selected}
+                extras = [orbit for orbit in visible_candidates if orbit not in used]
+                if not extras:
+                    continue
+
