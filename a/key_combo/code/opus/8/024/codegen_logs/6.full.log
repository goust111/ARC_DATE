+def _walk_path(start: tuple[int, int], waypoints: list[tuple[int, int]]) -> list[tuple[int, int]] | None:
+    r, c = start
+    path = [(int(r), int(c))]
+    for nr, nc in waypoints:
+        nr = int(nr)
+        nc = int(nc)
+        if r != nr and c != nc:
+            return None
+        dr = 0 if nr == r else (1 if nr > r else -1)
+        dc = 0 if nc == c else (1 if nc > c else -1)
