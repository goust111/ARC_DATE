BLOCK_SIZE = 5
INTERIOR_SIZE = 3
INTERIOR_OFFSET = 1
INTERIOR_CENTER = (1, 1)
HOLE_COUNT_RANGE = (1, 4)
COMMON_HOLE_RANGE = (2, 3)
BLOCK_COUNT_RANGE = (4, 5)
HOLE_CONNECTIVITY = 4
