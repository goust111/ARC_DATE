+def _turn_count(path: list[tuple[int, int]]) -> int:
+    turns = 0
+    prev = None
+    for (r0, c0), (r1, c1) in zip(path, path[1:]):
+        step = (0 if r1 == r0 else (1 if r1 > r0 else -1), 0 if c1 == c0 else (1 if c1 > c0 else -1))
+        if prev is not None and step != prev:
+            turns += 1
+        prev = step
+    return turns
