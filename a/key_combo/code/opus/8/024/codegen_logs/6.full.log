    block = np.full((BLOCK_SIZE, BLOCK_SIZE), fg, dtype=int)
    for r, c in _gen_hole_pattern(holes):
        block[r + INTERIOR_OFFSET, c + INTERIOR_OFFSET] = BG
    return block

