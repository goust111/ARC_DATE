+                return None
+            obstacle = (int(r), int(random.choice(possible)))
+            if obstacle in used:
+                return None
+            obstacles.add(obstacle)
+            used.add(obstacle)
+
+    return markers, seeds, obstacles, branch_case
+
+
+def _semantic_checks(
+    grid: np.ndarray,
+    expected: np.ndarray,
+    branch_case: bool,
+    obstacles: set[tuple[int, int]],
+    markers: list[tuple[int, int]],
