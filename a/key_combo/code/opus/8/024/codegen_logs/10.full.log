+        grid[r0 : r1 + 1, c0] = FRAME
+        grid[r0 : r1 + 1, c1] = FRAME
+    for col, color in marker_pairs:
+        grid[0, col] = color
+    return grid
+
+
+def _validate_spec(inp: np.ndarray, boxes: list[dict], markers: dict[int, int]) -> bool:
