_GEN_CORNER_OFFSETS = ((-1, -1), (-1, 2), (2, -1), (2, 2))
_GEN_DIAGONAL_DIRS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
# Acceptance checks.
