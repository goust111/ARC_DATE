+
+    marker_cols = sorted(markers)
+    leaf_boxes = [box for box in boxes if not any(_contains(box["bbox"], other["bbox"]) for other in boxes if other is not box)]
+    if not leaf_boxes:
+        return False
+
+    multi_match = False
+    for box in boxes:
+        c0 = box["bbox"][1]
+        c1 = box["bbox"][3]
+        matches = [c for c in marker_cols if c0 <= c <= c1]
+        if not matches:
