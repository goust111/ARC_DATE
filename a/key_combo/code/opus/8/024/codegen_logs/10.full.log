+        comp_mask = np.zeros((h, w), dtype=bool)
+        rel = coords - np.array([[box[0], box[1]]], dtype=int)
+        comp_mask[rel[:, 0], rel[:, 1]] = True
+        ring = _ring_mask(h, w)
