+    out = np.array(grid, copy=True)
+    marker_cols = sorted(markers)
+    reverse = order_mode == "inner_first"
+    if order_mode not in {"outer_first", "inner_first"}:
+        raise ValueError(f"unknown order mode: {order_mode}")
