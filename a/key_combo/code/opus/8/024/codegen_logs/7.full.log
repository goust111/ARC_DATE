+BG = 0
+FG = 1
+SLOT_SIZE = 5
+GAP = 1
+SLOTS_PER_AXIS = 4
+ARRAY_SPAN = SLOTS_PER_AXIS * SLOT_SIZE + (SLOTS_PER_AXIS - 1) * GAP
+STEP = SLOT_SIZE + GAP
+MAX_GENERATE_ATTEMPTS = 400
+MIN_CORRUPT_SLOTS = 2
+MAX_CORRUPT_SLOTS = 4
+MIN_NOISE = 3
+MAX_NOISE = 7
