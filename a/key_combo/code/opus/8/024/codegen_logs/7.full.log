+        (anchor_r - 1, anchor_c + 2, -1, 1),
+        (anchor_r + 2, anchor_c - 1, 1, -1),
+        (anchor_r + 2, anchor_c + 2, 1, 1),
+    ]
+    for seed_r, seed_c, dr, dc in candidates:
