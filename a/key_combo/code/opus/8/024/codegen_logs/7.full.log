+
+    outside = _outside_positions(shape, row_start, col_start)
+    noise_count = int(rng.integers(MIN_NOISE, MAX_NOISE + 1))
+    chosen = rng.choice(len(outside), size=noise_count, replace=False).tolist()
+    for idx in chosen:
+        r, c = outside[int(idx)]
