+    stack = np.stack(blocks, axis=0)
+    fg_counts = np.count_nonzero(stack != int(bg), axis=0)
+    sprite = np.full((SLOT_SIZE, SLOT_SIZE), int(bg), dtype=int)
+    sprite[fg_counts > len(blocks) // 2] = FG
