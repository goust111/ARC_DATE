+            rng,
+            sprite,
+            require_critical=(i == 0),
+        )
+        inp[r0 : r0 + SLOT_SIZE, c0 : c0 + SLOT_SIZE] = corrupted
+        touched_critical |= hit
+
+    assert touched_critical
+    assert any(
