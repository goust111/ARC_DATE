+
+
+def _build_input(
+    shape: tuple[int, int],
+    row_start: int,
+    col_start: int,
+    sprite: np.ndarray,
+    rng: np.random.Generator,
+) -> tuple[np.ndarray, np.ndarray]:
+    inp = np.zeros(shape, dtype=int)
