+
+    expected = _oracle_output(shape, row_start, col_start, sprite)
+    return inp, expected
+
+
+def _validate_sprite(sprite: np.ndarray) -> None:
+    assert sprite.shape == (SLOT_SIZE, SLOT_SIZE)
+    assert np.all((sprite == BG) | (sprite == FG))
