+        band_idx = _band_cells(start)
+        gap_idx = _gap_cells(start)
+        score = int(counts[band_idx].sum()) * 3 - int(counts[gap_idx].sum())
+        if best_score is None or score > best_score:
+            best_score = score
+            best_starts = [start]
