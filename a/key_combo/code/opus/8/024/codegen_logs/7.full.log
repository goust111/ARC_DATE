+        inp[r0 : r0 + SLOT_SIZE, c0 : c0 + SLOT_SIZE] = sprite
+
+    corrupt_count = int(rng.integers(MIN_CORRUPT_SLOTS, MAX_CORRUPT_SLOTS + 1))
+    corrupt_ids = rng.choice(len(slot_origins), size=corrupt_count, replace=False).tolist()
