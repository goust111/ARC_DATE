+    shape = (ARRAY_SPAN + top + bottom, ARRAY_SPAN + left + right)
+    row_start = top
+    col_start = left
+    inp, expected = _build_input(shape, row_start, col_start, sprite, rng)
+
+    slot_mask = _slot_mask(shape, row_start, col_start)
+    if np.any(expected[~slot_mask] != BG):
+        return None
