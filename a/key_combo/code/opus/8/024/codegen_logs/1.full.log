+MARKER_COLORS = (Color.BLUE, Color.RED, Color.YELLOW)
+OBJECT_COLORS = (Color.BLUE, Color.RED, Color.YELLOW, Color.ORANGE)
+MAX_GENERATION_ATTEMPTS = 300
+
+SMALL_SHAPES: dict[int, tuple[tuple[tuple[int, int], ...], ...]] = {
