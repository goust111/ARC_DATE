  "type": "move_to_match",
  "src": "fully annotated foreground motif s with a yellow skeleton, red anchor, and other marker pixels",
  "dst": "incomplete motifs d with the same yellow skeleton and only the red anchor",
  "match_cond": "s.skeleton and s.anchor align to d.skeleton and d.anchor under a unique rotation/flip/translation",
  "transform": "stamp all transformed non-skeleton marker pixels from s onto each d"
}
</annotation>
</reference_puzzle>

