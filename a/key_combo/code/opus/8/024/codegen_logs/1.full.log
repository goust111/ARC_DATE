+def _semantic_valid(grid: np.ndarray) -> bool:
+    H, W = grid.shape
+    if grid.ndim != 2 or H > 30 or W > 30:
+        return False
+    if np.any(grid[:, 1:-1] == GREEN):
+        return False
+    if np.any(grid[:, 0] == GREEN) or np.any(grid[:, -1] == GREEN):
+        return False
+    for r in range(H):
+        left = int(grid[r, 0])
+        right = int(grid[r, -1])
+        if (left == BACKGROUND) != (right == BACKGROUND):
