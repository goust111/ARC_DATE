+    if seed_role == "diag":
+        return r0, c0
+    if seed_role == "upper":
+        return r0, c1
+    if seed_role == "lower":
+        return r1, c0
+    if seed_role == "both_a":
+        return r0, c0 if (room_i + room_j) % 2 == 0 else c1
+    return r1, c1 if (room_i + room_j) % 2 == 0 else c0
+
+
+def _room_bbox(intervals: list[tuple[int, int]], i: int, j: int) -> tuple[int, int, int, int]:
