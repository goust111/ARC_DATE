+import random
+from collections import Counter
+
+import numpy as np
+
+
+BACKGROUND = 0
+FRAME_COLOR = 7
+RANK_COLORS = (2, 1, 3, 4, 6)
+INPUT_FILL_COLORS = (1, 2, 3, 4, 5, 6, 8, 9)
+GENERATION_RETRIES = 400
+
+
+def get_bg(grid: np.ndarray) -> int:
+    return int(Counter(map(int, grid.flat)).most_common(1)[0][0])
+
+
