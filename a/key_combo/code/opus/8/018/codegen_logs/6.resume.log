+        visited = np.zeros_like(mask, dtype=bool)
+        coords_all = np.argwhere(mask)
+        for sr, sc in coords_all:
+            sr = int(sr)
+            sc = int(sc)
+            if visited[sr, sc]:
+                continue
+            stack = [(sr, sc)]
