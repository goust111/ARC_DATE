+    for rank, record in enumerate(sorted(records, key=lambda record: record["empty_rows"])):
+        target_color = int(RANK_COLORS[rank])
+        coords = record["fill_coords"]
+        out[coords[:, 0], coords[:, 1]] = target_color
+    return out
+
