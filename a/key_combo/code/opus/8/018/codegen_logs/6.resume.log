+def find_components(
+    grid: np.ndarray,
+    *,
+    bg: int | None = None,
+    colors: list[int] | tuple[int, ...] | None = None,
+    connectivity: int = 4,
+) -> list[dict]:
+    if bg is None:
+        bg = get_bg(grid)
+    if connectivity != 4:
+        raise ValueError("this task only needs 4-connected components")
+
+    if colors is None:
+        color_list = colors_present(grid, exclude={bg})
+    else:
+        color_list = [int(color) for color in colors if int(color) != int(bg)]
