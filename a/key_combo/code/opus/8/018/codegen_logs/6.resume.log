+        h = bbox_h(frame["bbox"])
+        w = bbox_w(frame["bbox"])
+        assert h >= 4 and w >= 3, "frame too small"
+        outer_sizes.add((h, w))
+
+        rel = np.zeros((h, w), dtype=bool)
+        coords = frame["coords"]
+        rel[coords[:, 0] - r0, coords[:, 1] - c0] = True
+        expected = np.zeros((h, w), dtype=bool)
+        expected[:, 0] = True
+        expected[:, -1] = True
+        expected[-1, :] = True
+        assert np.array_equal(rel, expected), "orange component must be a U frame"
