+def bbox_h(bbox: tuple[int, int, int, int]) -> int:
+    return int(bbox[2] - bbox[0] + 1)
+
+
+def bbox_w(bbox: tuple[int, int, int, int]) -> int:
+    return int(bbox[3] - bbox[1] + 1)
+
