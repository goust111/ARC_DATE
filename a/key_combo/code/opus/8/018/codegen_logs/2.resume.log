    left_cols = _build_left_cols(start_col, gaps)
    width = left_cols[-1] + BLOCK_SIZE
    if not MIN_WIDTH <= width <= MAX_WIDTH:
        return None

    top_rows = _gen_rows_for_left_cols(left_cols)
    if top_rows is None:
