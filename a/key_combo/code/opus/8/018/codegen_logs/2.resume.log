+def _choose_nonadjacent_rows(height: int, count: int) -> list[int] | None:
+    choices = []
+    for rows in itertools.combinations(range(height), count):
+        if all(rows[i + 1] - rows[i] >= 2 for i in range(count - 1)):
+            choices.append(rows)
+    if not choices:
+        return None
+    return list(random.choice(choices))
