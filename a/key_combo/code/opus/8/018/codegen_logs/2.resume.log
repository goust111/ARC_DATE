+            if c > 0 and black_labels[r, c - 1] > 0:
+                labels.add(int(black_labels[r, c - 1]))
+            if c + 1 < g.shape[1] and black_labels[r, c + 1] > 0:
+                labels.add(int(black_labels[r, c + 1]))
