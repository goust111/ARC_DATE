+    for label, coords in enumerate(components_mask(g == BG, connectivity=4), start=1):
+        r0 = int(coords[:, 0].min())
+        c0 = int(coords[:, 1].min())
+        r1 = int(coords[:, 0].max())
+        c1 = int(coords[:, 1].max())
+        rooms.append(
+            {
+                "label": label,
+                "coords": coords,
+                "bbox": (r0, c0, r1, c1),
+                "open": _touches_edge(coords, g.shape),
+                "segments": [],
