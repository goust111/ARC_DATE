+            for i, seg in enumerate(ordered):
+                length = int(seg["length"])
+                out[r0 + i, c0 : c0 + length] = int(seg["color"])
+        else:
+            for i, seg in enumerate(ordered):
+                length = int(seg["length"])
+                out[r1 - i, c1 - length + 1 : c1 + 1] = int(seg["color"])
