        top = max(lr0, rr0) + pad
        bot = min(lr1, rr1) - pad
        if top <= r <= bot:
            return True

    # Vertical between: objects separated along rows, and col overlap is sufficient.
    top_obj, bot_obj = ((r1, c1, r1b, c1b), (r2, c2, r2b, c2b)) if r1 <= r2 else ((r2, c2, r2b, c2b), (r1, c1, r1b, c1b))
