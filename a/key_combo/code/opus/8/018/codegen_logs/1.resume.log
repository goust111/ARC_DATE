+        if not np.all(inner_after[transformed] == RED):
+            return False
+        if not np.array_equal(inner_after[~transformed], inner_before[~transformed]):
+            return False
+    return len(transformed_bytes) == 4
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
