+            continue
+        for start_left in (False, True):
+            choice = np.zeros(len(cells), dtype=bool)
+            pos = 0
+            is_left = start_left
+            for part in parts:
+                choice[pos : pos + part] = is_left
+                pos += part
+                is_left = not is_left
+            options.append(choice)
+    random.shuffle(options)
+    return options
