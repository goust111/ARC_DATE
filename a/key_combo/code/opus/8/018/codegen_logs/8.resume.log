    assert np.any(left) and np.any(right)
    assert not np.array_equal(~left, empty_mask)
    assert not np.array_equal(~right, empty_mask)

    if len(comps) >= 4:
        assert np.any(out == MAROON)
    else:
        assert not np.any(out == MAROON)


