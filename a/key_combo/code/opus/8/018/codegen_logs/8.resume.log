+def _components(mask: np.ndarray) -> list[dict]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[dict] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            r0 = r1 = r
+            c0 = c1 = c
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                r0 = min(r0, rr)
+                c0 = min(c0, cc)
+                r1 = max(r1, rr)
+                c1 = max(c1, cc)
+                for nr, nc in _neighbors4(rr, cc):
