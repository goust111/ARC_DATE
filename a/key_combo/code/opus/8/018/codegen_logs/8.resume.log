+    def build_masks() -> tuple[np.ndarray, np.ndarray]:
+        left_mask = np.zeros_like(barrier_mask, dtype=bool)
+        for seg_idx, cells in enumerate(segments):
+            choice = chosen[seg_idx]
+            for keep_left, (r, c) in zip(choice, cells):
