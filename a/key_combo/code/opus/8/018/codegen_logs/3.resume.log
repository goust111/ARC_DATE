from importlib.machinery import SourceFileLoader
from pathlib import Path
import hashlib
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/8/018/3.py')
mod = SourceFileLoader('new_arc_task', str(p)).load_module()
sigs = set()
for i in range(100):
