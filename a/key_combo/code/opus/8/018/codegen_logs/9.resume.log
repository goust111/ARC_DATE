+    ray_cells: set[tuple[int, int]] = set()
+    for info in _ray_infos(base, squares):
+        ray_cells.update(info["cells"])
+
+    out = base.copy()
+    for r, c in ray_cells:
+        out[r, c] = RAY_COLOR
+    return out
+
+
+def _input_from_layout(
+    shape: tuple[int, int],
+    squares: list[dict[str, object]],
+    blockers: list[tuple[int, int]],
+) -> np.ndarray:
