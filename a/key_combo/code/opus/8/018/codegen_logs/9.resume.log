+def _gen_attempt() -> np.ndarray | None:
+    shape = (random.choice(GRID_RANGE), random.choice(GRID_RANGE))
+    target_count = random.choice(L_COUNT_RANGE)
+
+    witness_pair = _witness_pair(shape)
+    if witness_pair is None:
