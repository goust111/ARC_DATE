+    desired = 0 if random.random() < 0.25 else random.randint(1, 4)
+    blockers: list[tuple[int, int]] = []
+    reserved = set(witness["clear_path"])
+    completed_cells = {cell for square in squares for cell in _square_cells(square["origin"])}
+
+    if desired == 0:
+        return blockers
+
