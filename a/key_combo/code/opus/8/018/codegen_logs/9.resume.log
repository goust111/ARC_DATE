+    out = base.copy()
+    for info in _ray_infos(base, squares):
+        for r, c in info["cells"]:
+            out[r, c] = RAY_COLOR
+    return out
+
+
+def _completed_base_from_layout(
+    shape: tuple[int, int],
+    squares: list[dict[str, object]],
+    blockers: list[tuple[int, int]],
+) -> np.ndarray:
