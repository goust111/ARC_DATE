+def _trace_ray(base: np.ndarray, start: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    dr, dc = map(int, direction)
+    r = int(start[0] + dr)
+    c = int(start[1] + dc)
+    path: list[tuple[int, int]] = []
+    while in_bounds(base.shape, r, c) and int(base[r, c]) == BG_COLOR:
+        path.append((r, c))
+        r += dr
+        c += dc
+    return path
