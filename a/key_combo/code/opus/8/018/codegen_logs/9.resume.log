+        return None
+
+    if not _validate_layout(shape, squares, blockers, witness):
+        return None
+    return _input_from_layout(shape, squares, blockers)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
