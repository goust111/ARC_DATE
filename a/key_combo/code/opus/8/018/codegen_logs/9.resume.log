+
+
+def _extract_l_shapes(grid: np.ndarray) -> list[dict[str, object]]:
+    g = np.asarray(grid, dtype=int)
+    bg = get_bg(g)
+    assert bg == BG_COLOR, "expected black background"
+    assert set(map(int, np.unique(g))).issubset({BG_COLOR, L_COLOR, BLOCKER_COLOR})
