+            return None
+        sr = random.randint(0, h - rh)
+        sc = random.randint(0, w - rw)
+        block = outside[sr : sr + rh, sc : sc + rw]
+        if not np.all(block):
+            continue
+        if used[sr : sr + rh, sc : sc + rw].any():
