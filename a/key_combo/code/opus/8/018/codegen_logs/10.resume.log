+def _outside_mask(grey_mask: np.ndarray) -> np.ndarray:
+    h, w = grey_mask.shape
+    outside = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    def push(r: int, c: int) -> None:
+        if 0 <= r < h and 0 <= c < w and not grey_mask[r, c] and not outside[r, c]:
+            outside[r, c] = True
+            q.append((r, c))
