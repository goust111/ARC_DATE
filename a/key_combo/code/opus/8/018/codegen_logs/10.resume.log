+    for r in range(h):
+        push(r, 0)
+        push(r, w - 1)
+    for c in range(w):
+        push(0, c)
+        push(h - 1, c)
+
+    while q:
+        r, c = q.popleft()
+        for nr, nc in ((r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)):
+            push(nr, nc)
+    return outside
