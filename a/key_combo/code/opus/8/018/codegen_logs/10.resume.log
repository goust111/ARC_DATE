+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+GREY = 5
+VISIBLE_COLORS = (1, 2, 3, 4, 8, 9)
+
+GRID_HEIGHT_RANGE = (12, 18)
+GRID_WIDTH_RANGE = (12, 18)
