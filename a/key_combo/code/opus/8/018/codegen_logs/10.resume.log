+def _col_period(tile: np.ndarray) -> int:
+    tc = tile.shape[1]
+    for period in range(1, tc + 1):
+        ok = True
+        for c in range(tc):
+            if not np.array_equal(tile[:, c], tile[:, c % period]):
+                ok = False
+                break
+        if ok:
+            return period
+    raise AssertionError("col period must exist")
