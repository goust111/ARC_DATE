+    for room in rooms:
+        if room["id"] in assigned or rng.random() > 0.35:
+            continue
+        allowed = _non_path_cells(room)
+        if not allowed:
+            continue
+        shape = _sample_connected_shape(rng, allowed, rng.randint(1, min(4, len(allowed))))
+        if shape is not None:
+            room["content"] = shape
