+        if sum(_manhattan(cand, node) == 1 for node in path_nodes) != 0:
+            continue
+        if _manhattan(cand, checker_center) < 4 or _manhattan(cand, target_center) < 4:
+            continue
+        if any(_manhattan(cand, old) < 4 for old in others):
+            continue
+        others.append(cand)
+        if len(others) == total_rings - 1:
+            return others
+    return None
