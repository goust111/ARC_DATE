+
+def _target_center_candidates(
+    end_node: tuple[int, int],
+    path_nodes: set[tuple[int, int]],
+    checker_center: tuple[int, int],
+    lattice_h: int,
+    lattice_w: int,
+) -> list[tuple[int, int]]:
+    out: list[tuple[int, int]] = []
