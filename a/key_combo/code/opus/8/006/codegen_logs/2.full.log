+            candidates.append((rr, cc))
+    if len(candidates) < count:
+        return False
+    for rr, cc in random.sample(candidates, count):
+        grid[rr, cc] = 6
+        reserved[rr, cc] = True
+    return True
+
+
+def _generate_attempt() -> np.ndarray | None:
+    h = random.randint(18, 26)
+    w = random.randint(18, 26)
