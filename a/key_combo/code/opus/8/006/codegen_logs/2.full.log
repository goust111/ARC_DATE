+        _reserve_rect(banned, (r0, c0, r1, c1), pad=2)
+    for rr in range(max(0, tr - 3), min(h, tr + 4)):
+        for cc in range(max(0, tc - 3), min(w, tc + 4)):
+            if tr - 1 <= rr <= tr + 1 and tc - 1 <= cc <= tc + 1:
+                continue
+            if reserved[rr, cc] or banned[rr, cc]:
