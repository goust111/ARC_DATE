+        for c in range(w - 2):
+            window = grid[r : r + 3, c : c + 3]
+            border = np.array(
+                [
+                    window[0, 0],
+                    window[0, 1],
+                    window[0, 2],
+                    window[1, 0],
+                    window[1, 2],
+                    window[2, 0],
+                    window[2, 1],
+                    window[2, 2],
+                ]
