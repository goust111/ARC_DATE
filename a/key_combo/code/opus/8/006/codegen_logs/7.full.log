+        }
+
+    cavity_mask = _large_cavity_mask()
+    h, w = cavity_mask.shape
+    cavity = np.zeros((h + 2, w + 2), dtype=bool)
+    cavity[1:-1, 1:-1] = True
+    wall = np.zeros((h + 2, w + 2), dtype=bool)
+    wall[0, :] = True
+    wall[-1, :] = True
+    wall[:, 0] = True
+    wall[:, -1] = True
