+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != LINE:
+                continue
+            neighbors = []
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if _in_bounds(grid.shape, nr, nc) and grid[nr, nc] == LINE:
+                    neighbors.append((dr, dc))
+            if len(neighbors) == 1:
+                dr, dc = neighbors[0]
+                pts.append((r, c, -dr, -dc))
