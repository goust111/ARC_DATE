+    for r, c in fills:
+        out[r, c] = LINE
+    return out
+
+
+def _closed_regions(grid: np.ndarray) -> list[set[tuple[int, int]]]:
+    mask = grid != LINE
+    regions: list[set[tuple[int, int]]] = []
+    h, w = grid.shape
+    for comp in _components(mask):
+        pts = set(comp)
+        if any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in pts):
