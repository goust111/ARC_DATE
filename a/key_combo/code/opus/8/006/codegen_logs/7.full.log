+        items.sort()
+        for i in range(len(items)):
+            r1, dr1, dc1 = items[i]
+            if (dr1, dc1) != (1, 0):
+                continue
+            for j in range(i + 1, len(items)):
+                r2, dr2, dc2 = items[j]
+                gap = r2 - r1 - 1
+                if gap > 3:
