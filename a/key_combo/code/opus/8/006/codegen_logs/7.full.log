+    return out
+
+
+def _region_shape(kind: str) -> dict:
+    cavity_mask = _large_cavity_mask() if kind == "large" else _small_cavity_mask()
+    cavity, wall = _build_patch(cavity_mask)
+    if kind == "small":
+        marker = (2, 2)
+    else:
+        marker = random.choice(_interior_candidates(cavity_mask))
+    return {
+        "kind": kind,
+        "cavity": cavity,
+        "wall": wall,
+        "marker": marker,
+        "qualifies": _qualifies(cavity_mask, marker),
+    }
+
+
+def _can_place(occ: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int, pad: int = 2) -> bool:
+    h, w = patch_mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > occ.shape[0] or c0 + w > occ.shape[1]:
