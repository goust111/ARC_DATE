+        cavity[1, 3] = True
+        cavity[2, 1] = True
+        cavity[2, 2] = True
+        cavity[2, 3] = True
+        cavity[3, 2] = True
+        cavity[3, 3] = True
+        wall = np.zeros((5, 5), dtype=bool)
+        wall[0, :] = True
+        wall[-1, :] = True
