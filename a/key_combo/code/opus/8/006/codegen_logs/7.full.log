+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _endpoints(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    pts: list[tuple[int, int, int, int]] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != LINE:
+                continue
+            neighbors = []
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if _in_bounds(grid.shape, nr, nc) and grid[nr, nc] == LINE:
+                    neighbors.append((dr, dc))
+            if len(neighbors) == 1:
