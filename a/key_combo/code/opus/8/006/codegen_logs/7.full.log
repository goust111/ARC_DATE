+    gap_counts = [1] * n_shapes
+    large_indices = [i for i, shape in enumerate(shapes) if shape["kind"] == "large"]
+    for _ in range(total_gaps - n_shapes):
+        gap_counts[random.choice(large_indices)] += 1
