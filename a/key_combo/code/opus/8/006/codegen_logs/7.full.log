+    for r, c in bg_cells:
+        ok = True
+        for dr, dc in DIRS8:
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(grid.shape, nr, nc):
+                ok = False
+                break
+            if grid[nr, nc] != LINE and (nr, nc) not in bg_cells:
+                ok = False
+                break
+        if ok:
+            return True
+    return False
