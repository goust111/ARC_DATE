+    random.shuffle(candidates)
+
+    chosen: list[set[tuple[int, int]]] = []
+    used: set[tuple[int, int]] = set()
+    for cand in candidates:
+        halo = {(r + dr, c + dc) for r, c in cand for dr, dc in DIRS8 + [(0, 0)]}
