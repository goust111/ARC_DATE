+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+LINE = 1
+MARKER_COLORS = (2, 3, 4, 6, 7, 8, 9)
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIRS8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for dr, dc in DIRS4:
+                    nr, nc = rr + dr, cc + dc
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _endpoints(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    pts: list[tuple[int, int, int, int]] = []
+    h, w = grid.shape
+    for r in range(h):
+        for c in range(w):
+            if grid[r, c] != LINE:
+                continue
+            neighbors = []
+            for dr, dc in DIRS4:
+                nr, nc = r + dr, c + dc
+                if _in_bounds(grid.shape, nr, nc) and grid[nr, nc] == LINE:
+                    neighbors.append((dr, dc))
+            if len(neighbors) == 1:
+                dr, dc = neighbors[0]
+                pts.append((r, c, -dr, -dc))
+    return pts
+
+
+def _fill_facing_gaps(grid: np.ndarray) -> np.ndarray:
+    out = grid.copy()
+    endpoints = _endpoints(grid)
+    horiz: dict[int, list[tuple[int, int, int]]] = {}
+    vert: dict[int, list[tuple[int, int, int]]] = {}
+    for r, c, dr, dc in endpoints:
+        if dr == 0:
+            horiz.setdefault(r, []).append((c, dr, dc))
+        else:
+            vert.setdefault(c, []).append((r, dr, dc))
+
+    fills: set[tuple[int, int]] = set()
+
+    for r, items in horiz.items():
+        items.sort()
+        for i in range(len(items)):
+            c1, dr1, dc1 = items[i]
+            if (dr1, dc1) != (0, 1):
+                continue
+            for j in range(i + 1, len(items)):
+                c2, dr2, dc2 = items[j]
+                gap = c2 - c1 - 1
+                if gap > 3:
+                    break
+                if (dr2, dc2) != (0, -1) or gap < 1:
+                    continue
+                if np.all(grid[r, c1 + 1 : c2] == BG):
+                    fills.update((r, cc) for cc in range(c1 + 1, c2))
+                    break
+
+    for c, items in vert.items():
+        items.sort()
+        for i in range(len(items)):
+            r1, dr1, dc1 = items[i]
+            if (dr1, dc1) != (1, 0):
+                continue
+            for j in range(i + 1, len(items)):
+                r2, dr2, dc2 = items[j]
+                gap = r2 - r1 - 1
+                if gap > 3:
+                    break
+                if (dr2, dc2) != (-1, 0) or gap < 1:
+                    continue
+                if np.all(grid[r1 + 1 : r2, c] == BG):
+                    fills.update((rr, c) for rr in range(r1 + 1, r2))
+                    break
+
+    for r, c in fills:
+        out[r, c] = LINE
+    return out
+
+
+def _closed_regions(grid: np.ndarray) -> list[set[tuple[int, int]]]:
+    mask = grid != LINE
+    regions: list[set[tuple[int, int]]] = []
+    h, w = grid.shape
+    for comp in _components(mask):
+        pts = set(comp)
+        if any(r == 0 or r == h - 1 or c == 0 or c == w - 1 for r, c in pts):
+            continue
+        regions.append(pts)
+    return regions
+
+
+def _region_has_internal_bg(grid: np.ndarray, region: set[tuple[int, int]]) -> bool:
+    for r, c in region:
+        if grid[r, c] != BG:
+            continue
+        ok = True
+        for dr, dc in DIRS8:
+            nr, nc = r + dr, c + dc
+            if not _in_bounds(grid.shape, nr, nc):
+                ok = False
+                break
+            if grid[nr, nc] != LINE and (nr, nc) not in region:
+                ok = False
+                break
+        if ok:
+            return True
+    return False
+
+
+def main(grid: np.ndarray) -> np.ndarray:
+    """
+    Fill short blue gaps so open line fragments become closed rooms, then only paint rooms that contain a true interior pixel.
+
+    Input structure:
+    - The background is black (0).
+    - Blue (1) pixels form a sparse one-cell-thick orthogonal line network with short missing segments.
+    - Non-blue singleton marker pixels lie inside regions that would become enclosed after the blue gaps are repaired.
+
+    Rule:
+    - Find blue endpoints, meaning blue pixels with exactly one blue 4-neighbor.
+    - For endpoint pairs in the same row or column that face each other across 1 to 3 background cells, fill the whole gap with blue.
+    - In the repaired grid, find every 4-connected non-blue region that does not touch the outer border.
+    - If such a region contains at least one background pixel whose full 3x3 neighborhood stays inside that region or on blue border pixels, fill that region's background pixels with its unique marker color; otherwise leave the region unfilled.
+
+    Key insight:
+    - The decisive step is not the original fragments but the enclosed regions that emerge only after repairing short facing gaps; only geometrically thick regions receive the marker color.
+    """
+    g = np.asarray(grid, dtype=int)
+    repaired = _fill_facing_gaps(g)
+    out = repaired.copy()
+
+    for region in _closed_regions(repaired):
+        marker_colors = {int(repaired[r, c]) for r, c in region if repaired[r, c] not in (BG, LINE)}
+        if len(marker_colors) != 1:
+            continue
+        if not _region_has_internal_bg(repaired, region):
+            continue
+        fill_color = next(iter(marker_colors))
+        for r, c in region:
+            if out[r, c] == BG:
+                out[r, c] = fill_color
+    return out
+
+
+def _dilate4(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def _build_patch(region_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    h, w = region_mask.shape
+    padded = np.zeros((h + 2, w + 2), dtype=bool)
+    padded[1:-1, 1:-1] = region_mask
+    wall = _dilate4(padded) & ~padded
+    return padded, wall
+
+
+def _qualifies(region_mask: np.ndarray) -> bool:
+    region, wall = _build_patch(region_mask)
+    pts = set(map(tuple, np.argwhere(region)))
+    patch = np.zeros(region.shape, dtype=int)
+    patch[wall] = LINE
+    return _region_has_internal_bg(patch, pts)
+
+
+def _interior_candidates(region_mask: np.ndarray) -> list[tuple[int, int]]:
+    region, _ = _build_patch(region_mask)
+    pts = set(map(tuple, np.argwhere(region)))
+    patch = np.zeros(region.shape, dtype=int)
+    candidates = []
+    for r, c in pts:
+        if patch[r, c] != BG:
+            continue
+        if all((r + dr, c + dc) in pts for dr, dc in DIRS4):
+            candidates.append((r, c))
+    return candidates
+
+
+def _large_region_mask() -> np.ndarray:
+    h = random.randint(3, 6)
+    w = random.randint(3, 6)
+    return np.ones((h, w), dtype=bool)
+
+
+def _small_region_mask() -> np.ndarray:
+    mask = np.ones((3, 3), dtype=bool)
+    corner = random.choice([(0, 0), (0, 2), (2, 0), (2, 2)])
+    mask[corner] = False
+    return mask
+
+
+def _segment_runs(wall: np.ndarray) -> list[tuple[str, int, int, int]]:
+    runs: list[tuple[str, int, int, int]] = []
+    h, w = wall.shape
+    for r in range(h):
+        c = 0
+        while c < w:
+            if not wall[r, c]:
+                c += 1
+                continue
+            c0 = c
+            while c < w and wall[r, c]:
+                c += 1
+            if c - c0 >= 3:
+                runs.append(("h", r, c0, c))
+    for c in range(w):
+        r = 0
+        while r < h:
+            if not wall[r, c]:
+                r += 1
+                continue
+            r0 = r
+            while r < h and wall[r, c]:
+                r += 1
+            if r - r0 >= 3:
+                runs.append(("v", c, r0, r))
+    return runs
+
+
+def _open_gaps(wall: np.ndarray, gap_count: int) -> np.ndarray | None:
+    candidates: list[set[tuple[int, int]]] = []
+    for axis, fixed, start, end in _segment_runs(wall):
+        seg_len = end - start
+        for gap_len in range(1, min(3, seg_len - 2) + 1):
+            for gap_start in range(start + 1, end - gap_len):
+                gap_cells = set()
+                if axis == "h":
+                    gap_cells = {(fixed, cc) for cc in range(gap_start, gap_start + gap_len)}
+                else:
+                    gap_cells = {(rr, fixed) for rr in range(gap_start, gap_start + gap_len)}
+                candidates.append(gap_cells)
+    random.shuffle(candidates)
+
+    chosen: list[set[tuple[int, int]]] = []
+    used: set[tuple[int, int]] = set()
+    for cand in candidates:
+        halo = {(r + dr, c + dc) for r, c in cand for dr, dc in DIRS8 + [(0, 0)]}
+        if halo & used:
+            continue
+        chosen.append(cand)
+        used |= halo
+        if len(chosen) == gap_count:
+            break
+    if len(chosen) != gap_count:
+        return None
+
+    out = wall.copy()
+    for cand in chosen:
+        for r, c in cand:
+            out[r, c] = False
+    return out
+
+
+def _region_shape(kind: str) -> dict:
+    region_mask = _large_region_mask() if kind == "large" else _small_region_mask()
+    region, wall = _build_patch(region_mask)
+    marker = random.choice(_interior_candidates(region_mask))
+    return {
+        "kind": kind,
+        "region": region,
+        "wall": wall,
+        "marker": marker,
+        "qualifies": _qualifies(region_mask),
+    }
+
+
+def _can_place(occ: np.ndarray, patch_mask: np.ndarray, r0: int, c0: int, pad: int = 2) -> bool:
+    h, w = patch_mask.shape
+    if r0 < 0 or c0 < 0 or r0 + h > occ.shape[0] or c0 + w > occ.shape[1]:
+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(occ.shape[0], r0 + h + pad)
+    cc1 = min(occ.shape[1], c0 + w + pad)
+    return not occ[rr0:rr1, cc0:cc1].any()
+
+
+def _place_shapes(shapes: list[dict], height: int, width: int) -> np.ndarray | None:
+    grid = np.zeros((height, width), dtype=int)
+    occ = np.zeros((height, width), dtype=bool)
+    colors = random.sample(MARKER_COLORS, len(shapes))
+
+    for shape, color in zip(shapes, colors, strict=False):
+        patch_mask = shape["region"] | shape["wall"]
+        ph, pw = patch_mask.shape
+        options = [(r, c) for r in range(height - ph + 1) for c in range(width - pw + 1)]
+        random.shuffle(options)
+        placed = False
+        for r0, c0 in options:
+            if not _can_place(occ, patch_mask, r0, c0):
+                continue
+            wall_cells = np.argwhere(shape["wall"])
+            for rr, cc in wall_cells:
+                grid[r0 + rr, c0 + cc] = LINE
+            mr, mc = shape["marker"]
+            grid[r0 + mr, c0 + mc] = color
+            occ[r0 : r0 + ph, c0 : c0 + pw] |= patch_mask
+            placed = True
+            break
+        if not placed:
+            return None
+    return grid
+
+
+def _make_input_attempt() -> np.ndarray | None:
+    height = random.randint(16, 24)
+    width = random.randint(16, 24)
+    n_shapes = random.choice([2, 2, 3])
+    kinds = ["large", "small"]
+    if n_shapes == 3:
+        kinds.append(random.choice(["large", "small"]))
+
+    shapes = [_region_shape(kind) for kind in kinds]
+    if not any(shape["qualifies"] for shape in shapes):
+        return None
+    if not any(not shape["qualifies"] for shape in shapes):
+        return None
+
+    total_gaps = random.randint(n_shapes, min(4, 2 * n_shapes))
+    gap_counts = [1] * n_shapes
+    for _ in range(total_gaps - n_shapes):
+        gap_counts[random.randrange(n_shapes)] += 1
+
+    opened_shapes = []
+    for shape, gap_count in zip(shapes, gap_counts, strict=False):
+        opened = _open_gaps(shape["wall"], gap_count)
+        if opened is None:
+            return None
+        opened_shapes.append({**shape, "wall": opened})
+
+    grid = _place_shapes(opened_shapes, height, width)
+    if grid is None:
+        return None
+
+    repaired = _fill_facing_gaps(grid)
+    regions = _closed_regions(repaired)
