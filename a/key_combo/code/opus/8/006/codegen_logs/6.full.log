+    gate = np.zeros((3, 3), dtype=bool)
+    for br in range(3):
+        for bc in range(3):
+            block = g[br * k : (br + 1) * k, bc * k : (bc + 1) * k]
+            gate[br, bc] = bool(np.any(block == RED))
+
