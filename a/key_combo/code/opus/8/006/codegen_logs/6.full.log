+        r, c = top_left
+        br, bc = _block_index(r + 1, c + 1, k)
+        active = bool(gate[br, bc])
+        if active:
+            if not is_complete:
+                out[r : r + 3, c : c + 3][missing_mask] = YELLOW
+        else:
+            erase_mask = skeleton_mask | missing_mask if is_complete else skeleton_mask
+            out[r : r + 3, c : c + 3][erase_mask] = BG
