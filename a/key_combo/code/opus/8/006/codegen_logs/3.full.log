+
+        noise_blocks = [(0, 0), (0, 2), (1, 1), (2, 0), (2, 2)]
+        random.shuffle(noise_blocks)
+        for br, bc in noise_blocks[: random.randint(0, 2)]:
+            place_red(br, bc, 1)
+
+        out = main(grid)
+        if np.array_equal(out, grid):
+            continue
+        if np.count_nonzero(out == BLUE) <= np.count_nonzero(grid == BLUE):
