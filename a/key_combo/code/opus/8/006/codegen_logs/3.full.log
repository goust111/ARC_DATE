+def _neighbor_dirs(mask: np.ndarray, r: int, c: int) -> list[tuple[int, int]]:
+    h, w = mask.shape
+    out: list[tuple[int, int]] = []
+    for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+        rr = r + dr
+        cc = c + dc
+        if 0 <= rr < h and 0 <= cc < w and mask[rr, cc]:
