+    if marked(1, 0):
+        blue = _stretch_left(blue)
+    if marked(1, 2):
+        blue = _stretch_right(blue)
+
+    blue = _fill_short_gaps(blue, blocked)
+
+    out = grid.copy()
+    out[out == BLUE] = BG
+    out[blue] = BLUE
+    return out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(300):
+        k = random.randint(4, 6)
+        size = 3 * k
+        grid = np.zeros((size, size), dtype=int)
+
+        local = np.zeros((k, k), dtype=bool)
