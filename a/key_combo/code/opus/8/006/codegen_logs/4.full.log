+    counts = Counter(values)
+    winners = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
+    assert len(winners) >= 1
+    if len(winners) > 1:
+        assert winners[0][1] > winners[1][1]
+    return int(winners[0][0])
+
