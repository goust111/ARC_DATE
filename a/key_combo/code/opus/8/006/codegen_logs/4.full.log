+        "UR": grid[:mid_r, mid_c + 1 :].copy(),
+        "LR": grid[mid_r + 1 :, mid_c + 1 :].copy(),
+        "LL": grid[mid_r + 1 :, :mid_c].copy(),
+    }
+
+
