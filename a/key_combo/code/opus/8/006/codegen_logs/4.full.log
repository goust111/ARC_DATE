+    if name == "UL":
+        return int(r), int(c)
+    if name == "UR":
+        return int(c), int(size - 1 - r)
+    if name == "LR":
+        return int(size - 1 - r), int(size - 1 - c)
+    assert name == "LL"
+    return int(size - 1 - c), int(r)
