+    ll = np.rot90(ul, 1)
+
+    grid[:size, :size] = ul
+    grid[:size, size + 1 :] = ur
+    grid[size + 1 :, size + 1 :] = lr
+    grid[size + 1 :, :size] = ll
+
+    for i, key in enumerate(LEGEND_KEYS):
+        grid[-4 + i, -2] = key
+        grid[-4 + i, -1] = repair_order[i]
+
+    return grid
+
+
+def _tamper_grid(grid: np.ndarray, ul: np.ndarray) -> np.ndarray:
+    size = ul.shape[0]
+    out = grid.copy()
