+    masks = {name: np.ones((size, size), dtype=bool) for name in QUADRANT_ORDER}
+    lr_actual_mask = np.ones((size, size), dtype=bool)
+    lr_actual_mask[size - 4 : size, size - 2 : size] = False
+    masks["LR"] = np.rot90(lr_actual_mask, 2)
+    return masks
+
