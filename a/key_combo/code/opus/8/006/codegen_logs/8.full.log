+        size = int(size_a)
+        ur0 = min(r0a, r0b)
+        uc0 = min(c0a, c0b)
+        pos = {
+            ((r0a - ur0) // size, (c0a - uc0) // size),
+            ((r0b - ur0) // size, (c0b - uc0) // size),
+        }
+        if pos == {(0, 0), (1, 1)}:
+            vacancies = [(0, 1), (1, 0)]
+        elif pos == {(0, 1), (1, 0)}:
+            vacancies = [(0, 0), (1, 1)]
+        else:
+            continue
+        groups.append(
+            {
+                "color": int(color),
+                "size": size,
+                "bbox": (ur0, uc0, ur0 + 2 * size - 1, uc0 + 2 * size - 1),
+                "vacancies": [
+                    (ur0 + br * size, uc0 + bc * size, br, bc) for br, bc in vacancies
