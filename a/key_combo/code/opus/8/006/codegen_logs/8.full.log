+    _, r0, c0, size = min(candidates)
+    patch_r0 = r0 - size
+    patch_c0 = c0 - size
+    patch = grid[patch_r0 : patch_r0 + 3 * size, patch_c0 : patch_c0 + 3 * size].copy()
