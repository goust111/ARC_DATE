+
+import numpy as np
+
+from arc_utils import bbox_coords, components_mask, get_bg, paste
+
+
+BG = 0
+RED = 2
+CYAN = 8
+GROUP_COLORS = (1, 3, 4, 5, 6, 7, 9)
+SOURCE_PATTERNS = (
+    ((0, 1), (0, 2), (1, 2)),
+    ((0, 0), (0, 1), (1, 0)),
+    ((1, 0), (2, 0), (2, 1)),
+    ((1, 2), (2, 1), (2, 2)),
+    ((0, 0), (0, 1), (0, 2), (1, 2)),
+    ((0, 0), (1, 0), (2, 0), (2, 1)),
+    ((1, 0), (2, 0), (2, 1), (2, 2)),
+    ((0, 1), (0, 2), (1, 2), (2, 2)),
+)
+SCALE_SETS_2 = ((1, 1), (1, 2), (1, 3), (2, 2), (2, 3))
+SCALE_SETS_3 = ((1, 1, 1), (1, 1, 2), (1, 1, 3), (1, 2, 2), (1, 2, 3))
+RETRY_LIMIT = 400
