+def _is_square_component(grid: np.ndarray, coords: np.ndarray, color: int) -> tuple[int, int, int] | None:
+    r0, c0, r1, c1 = bbox_coords(coords)
+    size_r = int(r1 - r0 + 1)
+    size_c = int(c1 - c0 + 1)
+    if size_r != size_c:
+        return None
+    if not np.all(grid[r0 : r1 + 1, c0 : c1 + 1] == int(color)):
+        return None
+    return int(r0), int(c0), int(size_r)
