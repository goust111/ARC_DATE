+    col_axes = _find_full_line(panel, YELLOW, "col")
+    assert panel.shape[0] == panel.shape[1] and p >= 6
+    assert (len(row_axes) == 1) ^ (len(col_axes) == 1), "expected exactly one guide line"
+
+    out = np.full_like(panel, BG)
+    if row_axes:
+        axis = row_axes[0]
+        out[axis, :] = YELLOW
+        for r in range(p):
+            if r == axis:
+                continue
+            src_r = 2 * axis - r
+            if 0 <= src_r < p:
+                out[r, :] = panel[src_r, :]
+        out[axis, :] = YELLOW
+        return out
+
+    axis = col_axes[0]
+    out[:, axis] = YELLOW
+    for c in range(p):
+        if c == axis:
+            continue
+        src_c = 2 * axis - c
+        if 0 <= src_c < p:
+            out[:, c] = panel[:, src_c]
