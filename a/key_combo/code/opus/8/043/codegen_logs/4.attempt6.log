+
+def _invert_shape(shape, orient, axis):
+    inverted = set()
+    for r, c in shape:
+        if orient == "h":
+            inverted.add((2 * axis - r, c))
+        else:
+            inverted.add((r, 2 * axis - c))
+    return inverted
