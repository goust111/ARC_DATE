+def _neighbors4(r, c):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    comps = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_full_line(panel, color, axis):
+    if axis == "row":
+        rows = [r for r in range(panel.shape[0]) if np.all(panel[r, :] == color)]
+        return rows
+    cols = [c for c in range(panel.shape[1]) if np.all(panel[:, c] == color)]
+    return cols
+
+
+def _reflect_panel(panel):
+    panel = np.asarray(panel, dtype=int)
+    p = panel.shape[0]
