+    panel = np.full((p, p), BG, dtype=int)
+    output = np.full((p, p), BG, dtype=int)
+    if orient == "h":
+        panel[axis, :] = YELLOW
+        output[axis, :] = YELLOW
+    else:
+        panel[:, axis] = YELLOW
+        output[:, axis] = YELLOW
+    for r, c in in_shape:
+        panel[r, c] = BLUE
+    for r, c in out_shape:
+        output[r, c] = chosen_color
