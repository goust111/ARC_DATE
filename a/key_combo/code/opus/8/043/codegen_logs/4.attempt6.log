+        if side == "top":
+            return (0, 2), (1, p - 1)
+        if side == "bottom":
+            return (p - 2, p), (1, p - 1)
+        if side == "left":
+            return (1, p - 1), (0, 2)
+        return (1, p - 1), (p - 2, p)
+    axis = _quiet_axis(p)
+    if side == "top":
+        return (axis - 2, axis), (1, p - 1)
+    if side == "bottom":
