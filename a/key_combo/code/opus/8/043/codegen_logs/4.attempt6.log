+    return "h" if side in ("top", "bottom") else "v"
+
+
+def _touch_axis(side, p):
+    return 2 if side in ("top", "left") else p - 3
+
+
+def _quiet_axis(p):
+    return p // 2
+
+
+def _target_box(side, p, touched):
