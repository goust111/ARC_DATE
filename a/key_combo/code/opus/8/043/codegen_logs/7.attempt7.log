+    sep_rows = [r for r in range(h) if np.all(input_grid[r, :] == SEPARATOR)]
+    sep_cols = [c for c in range(w) if np.all(input_grid[:, c] == SEPARATOR)]
+    if len(sep_rows) != 2 or len(sep_cols) != 2:
+        return False
