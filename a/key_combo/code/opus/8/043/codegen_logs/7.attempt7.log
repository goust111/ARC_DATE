+def generate_input() -> np.ndarray:
+    for _ in range(MAX_ATTEMPTS):
+        built = _build_example()
+        if built is None:
+            continue
+        input_grid, expected, metadata = built
+        if _validate_generated_example(input_grid, expected, metadata):
+            return input_grid
