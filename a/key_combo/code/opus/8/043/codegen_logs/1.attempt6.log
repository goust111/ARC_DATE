+def _validate_generated(inp: np.ndarray, expected: np.ndarray) -> bool:
+    if inp.ndim != 2 or expected.ndim != 2:
+        return False
+    if max(inp.shape) > 30 or max(expected.shape) > 30:
+        return False
+    if get_bg(inp) != BG:
+        return False
