+    while True:
+        trial = shifted + np.array([1, 0], dtype=int)
+        if np.any(trial[:, 0] >= occupied.shape[0]):
+            break
+        if np.any(occupied[trial[:, 0], trial[:, 1]]):
+            break
+        shifted = trial
+    return shifted
+
+
