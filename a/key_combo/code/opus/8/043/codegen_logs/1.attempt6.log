+    if not multi_seen and random.random() < 0.3:
+        return False
+    try:
+        actual = main(inp)
+    except Exception:
+        return False
+    return bool(np.array_equal(actual, expected))
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        built = _construct_input()
+        if built is None:
+            continue
+        inp, expected = built
+        if _validate_generated(inp, expected):
