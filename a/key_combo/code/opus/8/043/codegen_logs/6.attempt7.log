+
+def _hole_slots(frame_h: int, frame_w: int) -> list[tuple[int, int, int, int]]:
+    mid_r = frame_h // 2
+    mid_c = frame_w // 2
+    return [
+        (1, 1, mid_r - 2, mid_c - 2),
+        (1, mid_c + 1, mid_r - 2, frame_w - 2),
+        (mid_r + 1, 1, frame_h - 2, mid_c - 2),
+        (mid_r + 1, mid_c + 1, frame_h - 2, frame_w - 2),
