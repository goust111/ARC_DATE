+            return None
+        top = random.randint(sr0, max_r)
+        left = random.randint(sc0, max_c)
+        placed.append(
+            {
+                **item,
+                "slot": int(slot_idx),
+                "top": int(top),
+                "left": int(left),
+            }
+        )
+    return placed
