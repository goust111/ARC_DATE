+BG = 0
+FRAME_COLOR = 3
+SPRITE_COLORS = (1, 2, 4, 6, 7, 8, 9)
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIR8 = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+MAX_GEN_ATTEMPTS = 400
