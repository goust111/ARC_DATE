+def _color_components(grid: np.ndarray, bg: int, connectivity: int) -> list[dict]:
+    out: list[dict] = []
+    for color in sorted(set(map(int, np.unique(grid))) - {int(bg)}):
+        for coords in _components(grid == color, connectivity):
+            out.append(
