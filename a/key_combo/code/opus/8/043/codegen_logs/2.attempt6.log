+            return None
+        region, entry, out_gate, path = found_move
+        nonadjacent_pair = nonadjacent_pair or (
+            abs(region[0] - current_region[0]) + abs(region[1] - current_region[1]) > 1
+        )
+        entry_gate[region] = entry
