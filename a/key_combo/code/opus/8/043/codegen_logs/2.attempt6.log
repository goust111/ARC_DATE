+        final = len(sequence) == visit_count - 1
+        candidate_moves = []
+        random.shuffle(remaining_regions)
+        for region in remaining_regions:
+            entry_choices = gates[region][:]
+            random.shuffle(entry_choices)
+            for entry in entry_choices:
