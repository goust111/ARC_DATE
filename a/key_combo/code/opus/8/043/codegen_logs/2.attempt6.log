+def _separator_mask(shape: tuple[int, int], sep_rows: list[int], sep_cols: list[int]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    mask[sep_rows, :] = True
+    mask[:, sep_cols] = True
+    return mask
