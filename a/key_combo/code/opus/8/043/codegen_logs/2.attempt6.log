+            nxt = (nr, nc)
+            if not (0 <= nr < h and 0 <= nc < w):
+                continue
+            if not sep_mask[nr, nc] or nxt in blocked:
+                continue
+            nd = dist[cur] + 1
+            if nxt not in dist:
+                dist[nxt] = nd
+                parents[nxt] = [cur]
+                q.append(nxt)
+            elif dist[nxt] == nd:
+                parents[nxt].append(cur)
+    if goal not in dist:
+        return None
