+def _fill_erased_segments(
+    out: np.ndarray,
+    erase_mask: np.ndarray,
+    mirror_box: tuple[int, int, int, int],
+) -> None:
+    r0, c0, r1, c1 = mirror_box
+    out[erase_mask] = BG
+    for c in range(c0, c1 + 1):
