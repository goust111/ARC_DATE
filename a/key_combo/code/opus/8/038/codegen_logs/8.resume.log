+
+
+def _assign_sprite_colors(mask: np.ndarray) -> tuple[np.ndarray, tuple[int, ...], int]:
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(mask)]
+    color_count = random.choice([2, 3])
