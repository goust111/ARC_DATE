+    reserved_not_target: set[tuple[int, int]] = set()
+
+    by_col: dict[int, list[int]] = {}
+    for r, c in coords:
+        by_col.setdefault(c, []).append(r)
+    split_candidates = [c for c, rows in by_col.items() if len(rows) >= 3]
