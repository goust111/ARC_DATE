+    sprite_box = _bbox(np.argwhere(grid != 0))
+    _ = sprite_box
+    return grid
+
+
+def _parse_generated(grid: np.ndarray):
+    bracket_cells, bracket_box, marker, marker_color = _find_bracket_and_marker(grid)
+    ignored = set(bracket_cells)
+    ignored.add(marker)
