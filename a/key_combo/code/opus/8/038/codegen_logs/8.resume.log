+        {(0, c) for c in range(w)} | {(r, w - 1) for r in range(h)},
+        {(h - 1, c) for c in range(w)} | {(r, 0) for r in range(h)},
+        {(h - 1, c) for c in range(w)} | {(r, w - 1) for r in range(h)},
