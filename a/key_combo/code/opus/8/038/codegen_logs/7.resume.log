+                if out[r, c] == BLACK:
+                    counts["untouched_black"] += 1
+                continue
+            if source_color == BLACK:
+                counts["source_black_skip"] += 1
+                if out[r, c] == BLACK:
+                    counts["untouched_black"] += 1
