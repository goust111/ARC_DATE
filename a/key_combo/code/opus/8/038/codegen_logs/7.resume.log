+    height = row_bands * TILE_SIZE + (row_bands - 1) * SEPARATOR_SIZE
+    width = col_bands * TILE_SIZE + (col_bands - 1) * SEPARATOR_SIZE
+    grid = np.zeros((height, width), dtype=int)
