+        "source_black": 0,
+        "blue_fill": 0,
+        "red_fill": 0,
+        "deep_fill": 0,
+        "untouched_black": 0,
+        "blocked_red": 0,
+        "grey_source_skip": 0,
+        "source_black_skip": 0,
+        "oob_skip": 0,
