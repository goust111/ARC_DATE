+            continue
+        runs.append((start, prev))
+        start = prev = value
+    runs.append((start, prev))
+    return runs
+
+
+def _tile_runs(grid: np.ndarray) -> tuple[list[tuple[int, int]], list[tuple[int, int]], np.ndarray, np.ndarray]:
