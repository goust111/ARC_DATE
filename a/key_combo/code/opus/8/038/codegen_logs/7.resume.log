+    return flat.reshape(TILE_SIZE, TILE_SIZE).astype(bool)
+
+
+TOP_TILE_MASKS: list[np.ndarray] = []
+GENERAL_TILE_MASKS: list[np.ndarray] = []
+for _bits in range(1, 2 ** (TILE_SIZE * TILE_SIZE) - 1):
