  "type": "transform_in_place",
  "src": "red/grey foreground pixels on the top row; first and last foreground pixels define the span",
  "transform": "copy the input; fill row r inside span_left+r..span_right-r by copying the top-row color r columns up-left with red/grey flipped each step"
}
</annotation>
<generation_spec>
