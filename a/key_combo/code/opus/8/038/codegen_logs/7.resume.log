+    out = _oracle_transform(grid)
+    if not np.array_equal(out, main(grid)):
+        return False
+    if np.count_nonzero(out == BLUE) < 2:
+        return False
+    if np.count_nonzero(sep_rows) == 0 or np.count_nonzero(sep_cols) == 0:
+        return False
+    return True
