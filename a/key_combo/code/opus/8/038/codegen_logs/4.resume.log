        delta = width - prev_width
        if delta == 2:
            left -= 1
            right += 1
        elif delta == 1:
            if random.choice([False, True]):
                left -= 1
            else:
                right += 1
        elif delta == 0:
            shift = random.choice(ZERO_DELTA_SHIFTS) if width >= 2 else 0
            left += shift
            right += shift
        elif delta == -1:
            if random.choice([False, True]):
                left += 1
            else:
