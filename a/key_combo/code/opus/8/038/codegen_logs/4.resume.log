+def _enumerate_sprite_masks() -> list[np.ndarray]:
+    masks: list[np.ndarray] = []
+    for bits in range(1 << 9):
+        area = bits.bit_count()
+        if not 3 <= area <= 5:
+            continue
+        mask = np.zeros((3, 3), dtype=bool)
+        for idx in range(9):
+            if (bits >> idx) & 1:
+                mask[idx // 3, idx % 3] = True
