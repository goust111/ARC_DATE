    bands = _gen_split_bands(GRID_SIZE, n_rects)
    if bands is None:
        return None
    if axis == "row":
        return [(r0, r1, 0, GRID_SIZE) for r0, r1 in bands]
    return [(0, GRID_SIZE, c0, c1) for c0, c1 in bands]


def _gen_grid_cells(n_rects):
