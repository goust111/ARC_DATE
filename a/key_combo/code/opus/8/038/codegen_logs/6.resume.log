+from __future__ import annotations
+
+from collections import defaultdict, deque
+import random
+
+import numpy as np
+
+
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+RECT_COLORS = (BLUE, GREEN, YELLOW, TEAL)
+GRID_H_RANGE = (14, 18)
+GRID_W_RANGE = (14, 18)
