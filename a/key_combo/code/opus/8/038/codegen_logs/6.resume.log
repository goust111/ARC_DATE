)
_GEN_SCATTER_SET = frozenset(_GEN_SCATTER_CELLS)
_GEN_BRACKET_TOUCH_CELLS = frozenset(
    (r + dr, c + dc)
    for r, c in _GEN_BRACKET_CELLS
