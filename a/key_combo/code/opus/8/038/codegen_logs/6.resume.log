+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return reachable_maroons
+
+
+def _reachable_background(grid: np.ndarray, target_box: tuple[int, int, int, int]) -> list[tuple[int, int]]:
+    h, w = grid.shape
+    starts = []
+    seen = set()
