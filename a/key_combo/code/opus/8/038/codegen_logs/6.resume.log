+    return [(r, c) for r in range(r0 + 1, r1) for c in range(c0 + 1, c1)]
+
+
+def _reachable_maroons(grid: np.ndarray, target_box: tuple[int, int, int, int]) -> set[tuple[int, int]]:
+    h, w = grid.shape
+    starts = []
