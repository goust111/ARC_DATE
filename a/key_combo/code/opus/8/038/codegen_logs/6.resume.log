+
+
+def _rank_key(cell: tuple[int, int], target_box: tuple[int, int, int, int]) -> tuple[int, int, int]:
+    r, c = cell
+    r0, c0, r1, c1 = target_box
+    return abs(2 * r - (r0 + r1)) + abs(2 * c - (c0 + c1)), r, c
+
+
+def _analyze(grid: np.ndarray) -> dict:
