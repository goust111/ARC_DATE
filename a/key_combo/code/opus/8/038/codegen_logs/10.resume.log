+    grid[target_r0 : target_r0 + target_h, target_c0 : target_c0 + target_w] = patch
+    grid[mover_r0 : mover_r0 + 2, mover_c0 : mover_c0 + source_w] = MOVER
+    grid[pusher_r0 : pusher_r0 + pusher_h, pusher_c0 : pusher_c0 + pusher_w] = PUSHER
