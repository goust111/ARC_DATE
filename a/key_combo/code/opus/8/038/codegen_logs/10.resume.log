+
+    assert _center2(source["bbox"], perp) == _center2(target["bbox"], perp) == _center2(pusher["bbox"], perp)
+    assert _center2(target["bbox"], axis) > _center2(source["bbox"], axis) > _center2(pusher["bbox"], axis)
