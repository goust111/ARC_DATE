+    counts = [int(np.count_nonzero(first == MARKER)), int(np.count_nonzero(second == MARKER))]
+    assert min(counts) > 0
+    assert counts[0] != counts[1]
+    winner = 0 if counts[0] > counts[1] else 1
+    return [first, second], counts, winner
