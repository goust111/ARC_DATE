        win_lo, win_hi = ranges[winner]
        other_los = [lo for i, (lo, _hi) in enumerate(ranges) if i != winner]
        min_runner = max(other_los)
        for win_count in range(max(win_lo, min_runner + WINNER_MARKER_MARGIN), win_hi + 1):
            rem = total - win_count
