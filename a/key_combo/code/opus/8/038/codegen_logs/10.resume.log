+    grid[pusher_r0 : pusher_r0 + pusher_h, pusher_c0 : pusher_c0 + pusher_w] = PUSHER
+
+    guide_cols = [target_c0 - 1, target_c0 + target_w]
+    random.shuffle(guide_cols)
