+        "axis": axis,
+        "perp": perp,
+        "unit": unit,
+        "step": step,
+        "source": source,
+        "target": target,
+        "pusher": pusher,
+        "target_patch": target_patch,
+        "split_low": rel0,
+        "split_high": rel1,
+        "gap": gap,
+    }
