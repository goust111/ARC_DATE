+    assert (dr == 0) ^ (dc == 0), "guide markers must be horizontal or vertical"
+    assert dr >= 0 and dc >= 0, "row-major ordering fixes the forward direction"
+    step = abs(dr) + abs(dc)
+    assert step > 0
+    if dr != 0:
+        return (1, 0), step, 0
+    return (0, 1), step, 1
+
+
