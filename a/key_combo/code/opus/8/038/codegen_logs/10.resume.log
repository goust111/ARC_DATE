+def _split_fragments(meta: dict) -> tuple[list[np.ndarray], list[int], int]:
+    patch = meta["target_patch"]
+    axis = meta["axis"]
+    rel0 = meta["split_low"]
+    rel1 = meta["split_high"]
+
+    if axis == 1:
+        first = patch[: rel0 + 1, :].copy()
+        second = patch[rel1:, :].copy()
+    else:
+        first = patch[:, : rel0 + 1].copy()
+        second = patch[:, rel1:].copy()
