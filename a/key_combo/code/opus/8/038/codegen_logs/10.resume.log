+    ends = [ordered[0], ordered[2]]
+    target_candidates = [obj for obj in ends if MARKER in obj["colors"]]
+    assert len(target_candidates) == 1, "expected exactly one marked target"
+    target = target_candidates[0]
+    pusher = ends[0] if ends[1] is target else ends[1]
