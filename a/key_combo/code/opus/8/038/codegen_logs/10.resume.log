+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+TARGET = 1
+MARKER = 2
+MOVER = 3
+PUSHER = 4
+GUIDE = 5
+RAY = 9
+
+GEN_RETRIES = 400
+
+
+def _bbox_from_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _crop(grid: np.ndarray, bbox: tuple[int, int, int, int]) -> np.ndarray:
+    r0, c0, r1, c1 = bbox
+    return grid[r0 : r1 + 1, c0 : c1 + 1].copy()
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q: deque[tuple[int, int]] = deque([(r, c)])
+            seen[r, c] = True
+            cells: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                    nr = rr + dr
+                    nc = cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.asarray(cells, dtype=int))
+    return out
+
+
+def _center2(bbox: tuple[int, int, int, int], dim: int) -> int:
+    if dim == 0:
+        return int(bbox[0] + bbox[2])
+    return int(bbox[1] + bbox[3])
+
+
+def _span(bbox: tuple[int, int, int, int], dim: int) -> int:
+    if dim == 0:
+        return int(bbox[2] - bbox[0] + 1)
+    return int(bbox[3] - bbox[1] + 1)
