+    return int(bbox[1] + bbox[3])
+
+
+def _span(bbox: tuple[int, int, int, int], dim: int) -> int:
+    if dim == 0:
+        return int(bbox[2] - bbox[0] + 1)
+    return int(bbox[3] - bbox[1] + 1)
