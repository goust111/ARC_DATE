+    ordered = sorted(objects, key=lambda obj: _center2(obj["bbox"], axis))
+    assert _center2(ordered[0]["bbox"], axis) < _center2(ordered[1]["bbox"], axis) < _center2(ordered[2]["bbox"], axis)
+
