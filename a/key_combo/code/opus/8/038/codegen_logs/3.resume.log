+
+def _paint_cells(grid: np.ndarray, cells: list[tuple[int, int]], color: int) -> None:
+    for r, c in cells:
+        grid[r, c] = int(color)
+
+
+def _shift_cells(cells: list[tuple[int, int]], dr: int) -> list[tuple[int, int]]:
+    return [(r - dr, c) for r, c in cells]
