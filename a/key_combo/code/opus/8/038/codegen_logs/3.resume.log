+def _is_bracket_component(component: dict) -> bool:
+    if int(component["color"]) != BRACKET:
+        return False
+    r0, c0, r1, c1 = map(int, component["bbox"])
+    if (r1 - r0, c1 - c0, int(component["area"])) != (2, 2, 5):
+        return False
