spec:
  grid:
    background: orange (7)
    height: (span_width - 1) / 2 + 1 to (span_width - 1) / 2 + 2
    width: span_width to span_width + 2 (extra cols are bg padding)
  top_row_span:
    colors: red (2) and/or grey (5) only
    width: odd, range 3-15
    defined_by: leftmost and rightmost non-bg pixels on row 0
    content: all positions from left to right filled with signal colors (no bg gaps for width >= 5); for width = 3, pattern is [signal, bg, signal] [observed]
    color_mix: any ratio of red to grey, including all-one-color
  below_top: all orange background in input
  output:
    top_row: unchanged
    triangle_fill: for row r (1-based), fill columns [left+r, right-r] with alternate(top_row[col-r], r) where alternate swaps red<->grey each row step
    remaining_cells: stay orange

generation_strategy:
  approach: direct construction (input is simple; output is deterministic)
  steps:
    1. Choose span_width as odd integer in [3, 15]
    2. Generate top-row span content - array of span_width signal colors (red/grey); for width=3 use pattern [signal, bg, signal]; for width>=5 fill all positions with random red/grey
    3. Choose grid height >= (span_width-1)//2 + 1 (prefer exact or +1)
    4. Choose grid width >= span_width; place span starting at column 0 to max(0, width - span_width)
    5. Fill rest of grid with orange; place span on row 0
    6. Verify solver produces valid output (no assertion failures)
```
