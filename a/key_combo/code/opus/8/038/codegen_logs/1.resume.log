+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+PALETTE = (1, 3, 4, 5, 6, 7, 8, 9)
+VECTORS = [(0, 1), (1, 0), (1, 1), (1, -1), (0, 2), (2, 0), (2, 2), (2, -2), (0, 3), (3, 0), (3, 3), (3, -3)]
+MAX_GENERATION_ATTEMPTS = 400
