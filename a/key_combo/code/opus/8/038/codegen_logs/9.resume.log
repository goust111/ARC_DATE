spec:
  grid: 19-30 rows x 16-30 cols, black background
  sprite:
    shape: 3x3 hollow square (8 pixels, center empty) [observed]
    color: blue (1) [observed]
    all instances identical (solver-enforced)
  lattice:
    rows: 3-4 distinct row positions
    cols: 3-5 distinct column positions
    row_gaps: 4-7 (non-uniform, each >= sprite height)
    col_gaps: 4-6 (non-uniform, each >= sprite width)
  occupancy:
    pattern: exactly 1 complete row + 1 complete column, forming an L-shape
    complete_row: first or last lattice row [observed]
    complete_col: first (leftmost) lattice column [observed]
    sprite_count: nrows + ncols - 1 (intersection counted once)
    missing_slots: (nrows-1)*(ncols-1), always >= 1
  margins: 1-3 on each side [observed]; grid sized to tightly fit lattice
  output:
    same grid, missing lattice slots filled with teal (8) copies of the sprite
    original blue sprites preserved unchanged

generation_strategy:
  approach: output-first, then remove missing-slot sprites
  steps:
    1. Pick lattice_rows (3-4) and lattice_cols (3-5)
    2. Choose non-uniform gaps 4-7 between row positions, 4-6 between col positions
    3. Add margins 1-3 on each side to determine grid size
    4. Build full output grid with all lattice slots filled (blue sprite at every position)
    5. Pick one edge row (first or last) as the complete row, pick first column as the complete col
    6. Mark L-shape slots (complete row + complete col) as original (blue); all others as added (teal)
    7. To create input, erase teal sprites (set to black); keep blue sprites
    8. Verify grid fits within 30x30 and has >= 1 missing slot
