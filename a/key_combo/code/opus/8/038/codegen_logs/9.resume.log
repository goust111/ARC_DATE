+        c += -1 if best_col < c else 1
+
+    raise AssertionError("drop simulation did not converge")
+
+
+def _slot_bands(info: dict) -> list[dict]:
+    mask = info["mask"]
+    width = int(mask.shape[1])
+    grouped: dict[int, list[tuple[int, int]]] = {}
+    for r0, c0 in info["missing"]:
