import numpy as np, random

MASKS=[np.array([[1,1,1]],int),np.array([[1,1,1],[0,1,0]],int),np.array([[1,1,1],[1,0,1]],int)]

def simulate(base,start):
    H,W=base.shape
    r,c=start
    for _ in range(H*W*4):
        if r+1 < H and base[r+1,c]==0:
            r+=1
            continue
        if r+1>=H:
            break
        L=c
        while L-1>=0 and base[r,L-1]==0:
            L-=1
        R=c
        while R+1<W and base[r,R+1]==0:
            R+=1
        drops=[x for x in range(L,R+1) if base[r+1,x]==0]
        if not drops:
            break
        best=min(abs(x-c) for x in drops)
        target=min(x for x in drops if abs(x-c)==best)
        if target==c:
            raise RuntimeError('bad')
        c += -1 if target < c else 1
    return r,c

def slot_id(c, slots):
    hits=[i for i,(_,c0,w) in enumerate(slots) if c0 <= c < c0+w]
    return hits[0] if len(hits)==1 else None

success=0
for seed in range(200):
    random.seed(seed)
    mask=random.choice(MASKS)
    mh,mw=mask.shape
    nr=random.randint(3,4)
    nc=random.randint(3,5)
    k=random.randint(2,min(4,nc-1))
    row_step=random.randint(mh+2,mh+4)
    col_step=random.randint(mw+2,mw+4)
    top=random.randint(8,10)
    left=random.randint(1,3)
    rows=[top+i*row_step for i in range(nr)]
    cols=[left+j*col_step for j in range(nc)]
    H=rows[-1]+mh+random.randint(1,3)
    W=cols[-1]+mw+random.randint(1,3)
    if H>30 or W>30: continue
    anchor=random.randrange(nr)
    miss_cols=sorted(random.sample(range(nc),k))
    miss=[(random.choice([i for i in range(nr) if i"'!=anchor]), j) for j in miss_cols]
    g=np.zeros((H,W),int)
    for i,r0 in enumerate(rows):
      for j,c0 in enumerate(cols):
        if (i,j) in miss: continue
        for rr in range(mh):
          for cc in range(mw):
            if mask[rr,cc]: g[r0+rr,c0+cc]=8
    centers=[cols[j]+mw//2 for _,j in miss]
    bomb_row=1
    slots=[(i, cols[j], mw) for i,j in miss]
    base0=g.copy()
    base_ids=[]
    ok=True
    for c in centers:
      sid=slot_id(simulate(base0,(bomb_row,c))[1], slots)
      base_ids.append(sid)
      ok &= sid is not None
    if not ok: continue
    found=False
    for _ in range(1000):
      base=g.copy()
      nbar=random.randint(1,2)
      avail=list(range(bomb_row+2, rows[0]-1))
      if len(avail)<nbar: break
      bar_rows=sorted(random.sample(avail,nbar))
      bars=[]
      for br in bar_rows:
        w=random.randint(3,5)
        c0=random.randint(0,W-w)
        bars.append((br,c0,w))
        base[br,c0:c0+w]=5
      ids=[]
      pos=[]
      for c in centers:
        rr,cc=simulate(base,(bomb_row,c))
        sid=slot_id(cc,slots)
        ids.append(sid)
        pos.append((rr,cc))
      if None in ids: continue
      if sorted(ids)!=list(range(k)): continue
      if all(i==j for i,j in zip(ids, range(k))):
        # index order of slots follows miss order
        continue
      if all(a==b for a,b in zip(ids, base_ids)):
        continue
      found=True
      # print('"'seed',seed,'ok',mask.shape,miss,centers,bars,base_ids,ids,pos,'rows0',rows[0],'W',W)
      break
    if found: success+=1
print('success',success)
