+    return bands
+
+
+def _band_index_for_col(col: int, bands: list[dict]) -> int | None:
+    hits = [i for i, band in enumerate(bands) if int(band["c0"]) <= int(col) <= int(band["c1"])]
+    if len(hits) != 1:
+        return None
+    return int(hits[0])
+
+
