+    for r, c in walls:
+        for rr, cc in (
+            (r, c),
+            (r, 2 * w - 1 - c),
+            (2 * h - 1 - r, c),
+            (2 * h - 1 - r, 2 * w - 1 - c),
+        ):
+            out[rr, cc] = True
+    return out
+
+
+def _reachable_background(band: np.ndarray, wall_mask: np.ndarray) -> np.ndarray:
+    h, w = band.shape
+    passable = (band == BG) & (~wall_mask)
+    reachable = np.zeros((h, w), dtype=bool)
+    if not passable[0, 0]:
+        return reachable
+
+    queue = deque([(0, 0)])
+    reachable[0, 0] = True
+    while queue:
