+            [[random.choice(palette) for _ in range(width)] for _ in range(period)],
+            dtype=int,
+        )
+        if set(int(x) for x in tile.ravel()) & {color_a, color_b} != {color_a, color_b}:
+            continue
+        if any(np.all(tile[:, col] == BG) for col in range(width)):
+            continue
