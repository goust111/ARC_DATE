  10: # description:
  11: # In the input you will see multiple grey rectangular objects, each with a black hole inside of it. There are also monochromatic objects somewhere exactly the same shape as each hole, and random other distracter objects (distracters all the same color). 
  12: # To make the output, check to see if each non-distracter object perfectly fits inside the black hole inside of a gray object, like it is a puzzle piece. If it does, place it inside the black hole. If it doesn't, leave it where it is.
  13: 
  14: def main(input_grid):
  15:     """
  16:     Move each non-distractor puzzle piece into the matching black hole inside a gray object.
  17: 
  18:     Input structure:
  19:     - Gray rectangular objects contain black interior holes.
  20:     - Colored objects outside the rectangles may match those hole shapes.
  21:     - Distractor objects share the most common non-gray object color.
  22: 
  23:     Rule:
  24:     - Extract gray objects and their black interior masks.
  25:     - Treat the most common non-gray object color as the distractor color.
  26:     - For every other colored sprite, compare its mask to each hole mask and paste exact matches into the hole.
  27: 
  28:     Key insight:
  29:     - Fit is determined by binary shape equality, not by the piece color or its original position.
  30:     """
  31:     # Plan:
  32:     # 1. Parse the input into objects, sprites, and black holes inside the grey objects
  33:     # 2. Identify color of distracter objects.
  34:     # 3. Turn each object into a sprite
  35:     # 4. Check if each sprite can be moved into a black hole, and if so, move it there
  36:     
  37:     # Parse, separating greys from other objects
  38:     grey_input = input_grid.copy()
  39:     grey_input[input_grid != Color.GREY] = Color.BLACK
  40:     grey_objects = find_components(grey_input, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  41: 
  42:     # extracting a mask for the black region is tricky, because black is also the color of the background
  43:     # get the black region inside the object by getting the interior mask, then just the black pixels
  44:     interior_black_regions = [ object_interior(obj, background=Color.BLACK) & (obj == Color.BLACK)
  45:                                for obj in grey_objects ]
  46: 
  47:     not_grey_input = input_grid.copy()
  48:     not_grey_input[input_grid == Color.GREY] = Color.BLACK
  49:     not_grey_objects = find_components(not_grey_input, bg=Color.BLACK, connectivity=4, monochromatic=True, return_format="objects")
  50: 
  51:     # Get the sprites
  52:     not_grey_sprites = []
  53:     for obj in not_grey_objects:
  54:         _b = bbox(obj != Color.BLACK)
  55:         if _b is None:
  56:             continue
  57:         not_grey_sprites.append(crop_bbox(obj, _b))
  58: 
  59:     # Get the color of the distracter objects
  60:     # This is the most common color of the non-grey objects
  61:     color_of_each_object = [ np.unique(obj[obj!=Color.BLACK])[0] for obj in not_grey_objects ]
  62:     distracter_color = max(set(color_of_each_object), key=color_of_each_object.count)
  63:     
  64:     # Check if each sprite perfectly fits in a black hole/black interior region
  65:     # do this by checking if it has the same shape as a black interior region
  66:     # if it does, place it there
  67:     output_grid = np.copy(input_grid)
  68:     for sprite, obj, color in zip(not_grey_sprites, not_grey_objects, color_of_each_object):
  69:         # Try to find a perfect fit (if it is not the distracter color)
  70:         if color == distracter_color:
  71:             continue
  72:         
  73:         for interior_obj_mask in interior_black_regions:
  74:             # check the sprite masks are the same, meaning that they have the same shape
  75:             # to convert a sprite to a mask you check if it is not background (black)
  76:             sprite_mask = sprite != Color.BLACK
  77:             # to convert an object to a spright you crop it
  78:             _b = bbox(interior_obj_mask)
  79:             if _b is None:
  80:                 continue
  81:             interior_sprite_mask = crop_bbox(interior_obj_mask, _b)
  82:             perfect_fit = np.array_equal(sprite_mask, interior_sprite_mask)
  83: 
  84:             if perfect_fit:
  85:                 # remove the object from its original location
  86:                 object_mask = obj != Color.BLACK
  87:                 output_grid[object_mask] = Color.BLACK
  88: 
  89:                 # place the sprite in the black hole by blitting it
  90:                 _b = bbox(interior_obj_mask)
  91:                 assert _b is not None
  92:                 interior_r, interior_c, _r1, _c1 = _b
  93:                 interior_width = _r1 - interior_r + 1
  94:                 interior_height = _c1 - interior_c + 1
