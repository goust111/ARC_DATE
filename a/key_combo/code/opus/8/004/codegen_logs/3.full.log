   7: def main(grid: np.ndarray) -> np.ndarray:
   8:     """
   9:     Straighten the single foreground mask into a centered horizontal segment of the same color and length.
  10: 
  11:     Input structure:
  12:     - The grid has one dominant background color.
  13:     - All non-background pixels share one foreground color.
  14:     - The number of foreground pixels fits in one centered row of the grid.
  15: 
  16:     Rule:
  17:     - Erase the original foreground mask.
  18:     - Count its pixels, keep its color, and paint that many pixels as a horizontal segment.
  19:     - Place the segment on the middle row with equal background margin on the left and right.
  20: 
  21:     Key insight:
  22:     - The original foreground shape is irrelevant except for its color and area; the output is the area normalized into the grid's central horizontal line.
  23:     """
  24:     g = np.asarray(grid, dtype=int)
  25:     assert g.ndim == 2, "expected a 2D grid"
  26:     height, width = map(int, g.shape)
  27: 
  28:     bg = get_bg(g)
  29:     fg_colors = colors_present(g, exclude={bg})
  30:     assert len(fg_colors) == 1, "expected exactly one foreground color"
  31: 
  32:     color = fg_colors[0]
  33:     count = int(np.count_nonzero(g == color))
  34:     assert 0 < count <= width, "foreground pixels must fit in one row"
  35:     assert height % 2 == 1, "expected a unique middle row"
  36:     assert (width - count) % 2 == 0, "foreground segment must center with equal side margins"
  37: 
  38:     out = np.full(g.shape, bg, dtype=int)
  39:     row = height // 2
  40:     start = (width - count) // 2
  41:     out[row, start : start + count] = color
  42:     return out
  43: 
