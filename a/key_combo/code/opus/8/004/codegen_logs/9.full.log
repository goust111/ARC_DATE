    c0 = min(c for _r, c in shape)
    return frozenset((r - r0, c - c0) for r, c in shape)


_GEN_SKELETON_CACHE = {}


def _gen_skeleton_pool(size):
    size = int(size)
    if size in _GEN_SKELETON_CACHE:
        return _GEN_SKELETON_CACHE[size]

    shapes = {frozenset({(0, 0)})}
    for _ in range(size - 1):
        next_shapes = set()
        for shape in shapes:
            frontier = set()
            for cell in shape:
