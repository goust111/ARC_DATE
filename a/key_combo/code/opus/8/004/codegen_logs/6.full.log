+
+BG = 7
+WALL = 5
+PATH = 6
+TARGET = 1
+
+WALKABLE = {BG, PATH, TARGET}
+ORTHOGONALS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAGONALS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+GEN_MAX_ATTEMPTS = 300
