+            for nbr in _neighbors4(grid.shape, *cur)
+            if nbr != prev and int(grid[nbr]) in WALKABLE
+        ]
+        assert len(candidates) == 1, "corridor must define a unique forward step"
+        nxt = candidates[0]
+        path.append(nxt)
+        prev, cur = cur, nxt
