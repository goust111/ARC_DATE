+    if analysis["trail_count"] == 0:
+        return None
+    if np.array_equal(grid, analysis["actual"]):
+        return None
+    if not np.any((analysis["actual"] != BACKGROUND) & (analysis["actual"] != TRAIL)):
+        return None
+    if not any(
