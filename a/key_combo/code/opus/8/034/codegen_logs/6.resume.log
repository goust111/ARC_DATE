+        want_reoccupy=want_reoccupy,
+    )
+
+    grid = np.full((h, w), BACKGROUND, dtype=int)
+    blocked = np.zeros((h, w), dtype=bool)
+    placed_objects: list[dict] = []
+    remaining = dict(shifts)
+
+    diagonal_used = False
+
+    if want_overlap:
