+    h, w = grid.shape
+    for _ in range(RANDOM_PLACE_TRIES):
+        anchor = _random_anchor(rng, h, w)
+        rel = _sample_shape(rng, force_diagonal=force_diagonal)
+        coords = _abs_coords(anchor, rel)
