+    if any(analysis["shifts8"].get(color, 0) != shift for color, shift in shifts.items()):
+        return None
+    if len(set(analysis["shifts8"].values())) != len(analysis["shifts8"]):
+        return None
+    if not any(np.any(grid == color) for color in shifts):
