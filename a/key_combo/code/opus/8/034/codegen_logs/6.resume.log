+
+
+def _try_place_reoccupy_pair(
+    grid: np.ndarray,
+    blocked: np.ndarray,
+    mover_color: int,
+    mover_shift: int,
+    target_color: int,
+    rng: random.Random,
+    placed_objects: list[dict],
+    *,
+    force_diagonal_mover: bool = False,
+) -> np.ndarray | None:
