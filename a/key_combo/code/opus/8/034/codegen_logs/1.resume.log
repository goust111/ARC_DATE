+    depth = {}
+    q = deque()
+    for comp in sorted(exterior):
+        depth[int(comp)] = 0
+        q.append(int(comp))
+
+    while q:
+        comp = q.popleft()
+        for nxt in adj[comp]:
+            if nxt not in depth:
+                depth[nxt] = depth[comp] + 1
