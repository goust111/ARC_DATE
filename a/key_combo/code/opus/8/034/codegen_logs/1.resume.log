+        return None
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        rng = np.random.default_rng()
+        grid = _generate_attempt(rng)
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid ray-depth input")

