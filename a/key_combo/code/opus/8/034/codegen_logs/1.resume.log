+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+RAY = 1
+DEPTH_COLORS = (0, 3, 4, 7, 2, 6)
+
+GEN_ATTEMPTS = 300
+AXIS_ATTEMPTS = 200
