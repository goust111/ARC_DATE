+        right_stop = cols[n - 1 - d]
+        horizontal[row, : left_stop + 1] = True
+        horizontal[row, right_stop:w] = True
+
+    for i, col in enumerate(cols):
+        d = _ring_index(i, n)
+        top_stop = rows[d]
+        bottom_stop = rows[n - 1 - d]
+        vertical[: top_stop + 1, col] = True
+        vertical[bottom_stop:h, col] = True
+
+    return horizontal, vertical
+
