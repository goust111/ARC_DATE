+        parsed_rows, parsed_cols = _extract_marker_axes(inp)
+    except Exception:
+        return False
+    if parsed_rows != rows or parsed_cols != cols:
+        return False
+
+    expected = _render_from_axes(inp.shape, rows, cols)
+    try:
+        out = main(inp)
+    except Exception:
+        return False
+    if not np.array_equal(out, expected):
