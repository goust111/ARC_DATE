+    counts: dict[int, int] = {}
+    for depth, color in enumerate(DEPTH_COLORS):
+        if depth == 0:
+            continue
+        labels, n = _label_components(out == color)
+        if n:
+            counts[depth] = int(n)
+    return counts
+
