+    count = int(rng.choice(MARKER_COUNT_CHOICES, p=MARKER_COUNT_WEIGHTS))
+    expected_max_depth = count // 2
+
+    h_min = {2: 13, 3: 16, 4: 21}[count]
+    w_min = {2: 13, 3: 16, 4: 21}[count]
+    h = int(rng.integers(h_min, 29))
+    w = int(rng.integers(w_min, 29))
+
