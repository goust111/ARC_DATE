+def _component_depths(horizontal: np.ndarray, vertical: np.ndarray) -> tuple[np.ndarray, dict[int, int]]:
+    ray_mask = horizontal | vertical
+    open_mask = ~ray_mask
+    labels, n_comp = _label_components(open_mask)
+    h, w = labels.shape
