+    inner = np.arange(1, length - 1, dtype=int)
+    if inner.size < count:
+        return None
+
+    min_gap = {2: 5, 3: 4, 4: 3}[count]
+    for _ in range(AXIS_ATTEMPTS):
+        pos = sorted(int(x) for x in rng.choice(inner, size=count, replace=False))
