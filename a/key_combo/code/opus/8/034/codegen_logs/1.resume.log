+def _validate_candidate(
+    inp: np.ndarray,
+    rows: list[int],
+    cols: list[int],
+    expected_max_depth: int,
+) -> bool:
+    try:
+        parsed_rows, parsed_cols = _extract_marker_axes(inp)
+    except Exception:
