spec:
  grid: 10x10, background ORANGE(7)
  palette: fixed order [GREY(5), RED(2), TEAL(8), MAROON(9), PINK(6)]
  foreground:
    colors_used: 3-5 of the 5 palette colors
    objects: monochromatic 8-connected components, 1-16 pixels each
    total_objects: 4-12 across all colors
    per_color_count: 0-6 (at least one color has >=2 objects)
    max_count: 2-6 (determines output height)
    separation: same-color objects have Chebyshev distance >=2 (8-disconnected)
    density: 21-41% of grid is foreground [observed]
  output:
    shape: max_count rows x 5 cols, background ORANGE(7)
    rule: column i filled from bottom with palette[i] color for count[i] cells
    interpretation: histogram of per-color 8-connected object counts

generation_strategy:
