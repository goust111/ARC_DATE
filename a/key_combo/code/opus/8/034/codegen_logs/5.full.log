spec:
  grid: 6-18 rows x 8-14 cols
  colors: black(0), grey(5), orange(7) only
  background: random mix of grey(5) and orange(7); grey fraction 0.2-0.6 of non-black cells
  black_rectangles:
    count: 1-8 solid rectangles
    each_touches: exactly one grid edge (top/bottom/left/right)
    dimensions: 1-6 per side, area 2-18
    depth: perpendicular extent < half the grid dimension on that axis
    no_same_axis_overlap: vertical-moving rects have non-overlapping column bands; horizontal-moving rects have non-overlapping row bands
    multiple_per_edge: allowed (same edge can host multiple rects)
  transformation:
    each rect slides to the opposite edge along its perpendicular axis
    the full column-band (top/bottom rects) or row-band (left/right rects) is recolored orange
    the rect is stamped black at the opposite edge in the same band
    all rects move simultaneously; destination rects overwrite orange trails

generation_strategy:
  approach: output-first (build output, then invert to get input)
