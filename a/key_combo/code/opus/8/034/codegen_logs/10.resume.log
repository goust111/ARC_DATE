+                continue
+            dr = abs(r - hr)
+            dc = abs(c - vc)
+            assert row_sign == -1 if r < hr else row_sign == 1
+            assert col_sign == -1 if c < vc else col_sign == 1
+            for rr, cc in _orbit_positions(hr, vc, dr, dc, (h, w)):
+                if work[rr, cc] == BLACK:
+                    work[rr, cc] = color
