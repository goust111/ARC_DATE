+    assert ordered[0][1] > 0, "expected one non-empty pattern quadrant"
+    assert ordered[0][1] > ordered[1][1], "pattern quadrant must be uniquely dominant"
+    return ordered[0][0]
+
+
+def _orbit_positions(
+    hr: int,
+    vc: int,
+    dr: int,
+    dc: int,
