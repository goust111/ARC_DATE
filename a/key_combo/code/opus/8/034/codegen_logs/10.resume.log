+def _absolute_position(source_name: str, hr: int, vc: int, dr: int, dc: int) -> tuple[int, int]:
+    row_sign, col_sign = QUADRANTS[source_name]
+    return hr + row_sign * dr, vc + col_sign * dc
+
+
+def _non_source_positions(
+    source_name: str,
+    hr: int,
+    vc: int,
+    dr: int,
+    dc: int,
+    shape: tuple[int, int],
+) -> list[tuple[int, int]]:
