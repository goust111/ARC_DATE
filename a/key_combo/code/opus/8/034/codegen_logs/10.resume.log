+def _quadrant_slice(grid: np.ndarray, hr: int, vc: int, name: str) -> np.ndarray:
+    h, w = grid.shape
+    ((r0, r1), (c0, c1)) = _quadrant_bounds(h, w, hr, vc)[name]
+    return grid[r0:r1, c0:c1]
+
