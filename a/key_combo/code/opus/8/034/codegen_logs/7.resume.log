+def _paint_orbits(
+    n: int,
+    orbit_colors: dict[tuple[tuple[int, int], ...], int],
+) -> np.ndarray:
+    square = np.zeros((n, n), dtype=int)
+    for orbit, color in orbit_colors.items():
+        for r, c in orbit:
