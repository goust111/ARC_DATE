+        train_masked = _make_masked_square(
+            train_base,
+            target_orbit,
+            rng,
+            min_total_masks=4 if n == 5 else 6,
+            min_outside_target=2,
+        )
+        test_masked = _make_masked_square(
+            test_base,
+            target_orbit,
+            rng,
+            min_total_masks=4 if n == 5 else 6,
+            min_outside_target=2,
+        )
