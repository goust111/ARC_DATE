+    out: list[tuple[tuple[int, int], ...]] = []
+    for r in range(n):
+        for c in range(n):
+            orbit = _symmetry_orbit(n, r, c)
+            if orbit not in seen:
+                seen.add(orbit)
+                out.append(orbit)
+    return out
+
