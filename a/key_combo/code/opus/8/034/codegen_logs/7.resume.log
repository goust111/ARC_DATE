+                dst_color,
+                test_answer,
+            )
+            if not np.array_equal(main(grid), test_answer):
+                continue
+            return grid
+        except AssertionError:
+            continue
+
+    raise RuntimeError("failed to generate a valid analogy symmetry puzzle")

