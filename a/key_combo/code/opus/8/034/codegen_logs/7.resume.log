+    non_target = [orbit for orbit in orbits if orbit != target_orbit]
+    rng.shuffle(non_target)
+    orbit_colors[non_target[0]] = 1
+    orbit_colors[non_target[1]] = 2
+    orbit_colors[non_target[2]] = src_color
