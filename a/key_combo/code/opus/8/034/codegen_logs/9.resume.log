import numpy as np

def bbox(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(0); r1,c1=pts.max(0)
    return r0,c0,r1,c1

def valid(mask):
    N=mask.shape[0]
    k=mask.sum()
    if not (2<=k<=5): return False
    rows=np.where(mask.any(1))[0]
    cols=np.where(mask.any(0))[0]
    if len(rows)==1 or len(cols)==1: return False
    r0,c0,r1,c1=bbox(mask)
    if (r1-r0+1)*(c1-c0+1)-k < 2: return False
    return True

def expand(mask):
    return np.kron(mask.astype(int), (~mask).astype(int))

def compress(exp, d):
    g=exp.astype(int)
    H,W=g.shape
    out=np.zeros_like(g)
    if d in ('left','right'):
        for r in range(H):
            pos=np.flatnonzero(g[r])
            k=len(pos)
            if d=='left': final=np.arange(k)
            else: final=np.arange(W-k,W)
            out[r,final]=1
    else:
        for c in range(W):
            pos=np.flatnonzero(g[:,c])
            k=len(pos)
            if d=='up': final=np.arange(k)
            else: final=np.arange(H-k,H)
            out[final,c]=1
    trail=(g==1)&(out==0)
