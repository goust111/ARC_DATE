+
+    for marker in markers:
+        if int(np.count_nonzero(out == marker["color"])) <= 1:
+            return False
+
+    if len(markers) == 2:
+        for marker in markers:
+            reduced = inp.copy()
+            rr, cc = marker["pos"]
+            reduced[rr, cc] = BLACK
+            try:
