+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+GRID_HEIGHT_RANGE = (13, 18)
+GRID_WIDTH_RANGE = (15, 21)
+SOURCE_BBOX_RANGE = (3, 5)
+SOURCE_PIXELS_RANGE = (5, 10)
+MARKER_GAPS = (4, 5, 6, 7, 8)
