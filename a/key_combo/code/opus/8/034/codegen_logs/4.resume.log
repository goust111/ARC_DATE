+    ar, ac = anchor
+    out = []
+    if axis_kind == "row":
+        for r, c in mask_coords:
+            out.append((r, ac + mc - c))
+    else:
+        for r, c in mask_coords:
+            out.append((ar + mr - r, c))
+    return out
+
