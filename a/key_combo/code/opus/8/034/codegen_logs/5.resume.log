+from __future__ import annotations
+
+from collections import Counter
+import random
+
+import numpy as np
+
+
+FRAME = 5
+PATTERN_COLORS = (1, 2, 3, 4)
+CORRUPT_COLORS = (0, 1, 2, 3, 4)
