  "src": "black rectangular mask s touching exactly one outer border",
  "path": "straight slide from s to the opposite border along its row band or column band, determined by the touched border",
  "trajectory": "recolor the complete swept row/column stripe orange, then place s at the opposite edge",
  "transform": "all black masks move simultaneously; destination black masks overwrite orange trails and any grey cells, while cells outside swept stripes remain unchanged"
}
</annotation>
<generation_spec>
