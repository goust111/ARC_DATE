+    rooms: list[dict[str, tuple[int, int, int, int] | int]] = []
+    for rr in range(room_rows):
+        for cc in range(room_cols):
+            r0 = wall_rows[rr] + 1
+            r1 = wall_rows[rr + 1] - 1
+            c0 = wall_cols[cc] + 1
+            c1 = wall_cols[cc + 1] - 1
+            rooms.append(
+                {
+                    "bbox": (r0, c0, r1, c1),
+                    "height": r1 - r0 + 1,
+                    "width": c1 - c0 + 1,
+                }
+            )
+    return grid, rooms
