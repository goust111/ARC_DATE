+    for idx in marked:
+        r0, c0, r1, c1 = rooms[idx]["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = GREEN
+    return out
+
+
+def _verify_generated(
+    inp: np.ndarray,
