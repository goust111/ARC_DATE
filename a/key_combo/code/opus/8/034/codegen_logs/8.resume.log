+        col_widths = [random.choice(ROOM_SIZE_OPTIONS) for _ in range(room_cols)]
+        plus_candidates = sum(h == 5 for h in row_heights) * sum(w == 5 for w in col_widths)
+        if plus_candidates >= 2:
