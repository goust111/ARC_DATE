+def _draw_room_grid(
+    room_rows: int,
+    room_cols: int,
+    row_heights: list[int],
+    col_widths: list[int],
+    top_margin: int,
+    left_margin: int,
+) -> tuple[np.ndarray, list[dict[str, tuple[int, int, int, int] | int]]]:
+    wall_rows = [top_margin]
+    for height in row_heights:
