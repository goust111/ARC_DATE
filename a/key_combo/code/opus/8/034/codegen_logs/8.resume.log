+
+    wall_cols = [left_margin]
+    for width in col_widths:
+        wall_cols.append(wall_cols[-1] + width + 1)
+
+    height = wall_rows[-1] + top_margin + 1
+    width = wall_cols[-1] + left_margin + 1
