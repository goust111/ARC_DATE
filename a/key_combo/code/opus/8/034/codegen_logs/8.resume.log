+
+    for wr in wall_rows:
+        grid[wr, wall_cols[0] : wall_cols[-1] + 1] = GREEN
+    for wc in wall_cols:
+        grid[wall_rows[0] : wall_rows[-1] + 1, wc] = GREEN
+
+    rooms: list[dict[str, tuple[int, int, int, int] | int]] = []
+    for rr in range(room_rows):
+        for cc in range(room_cols):
