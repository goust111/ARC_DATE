+BLACK = 0
+RED = 2
+GREEN = 3
+ORANGE = 7
+
+OFFSETS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PLUS_OFFSETS = [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)]
+
+ROOM_SIZE_OPTIONS = (4, 5)
+GRID_SHAPES = ((2, 2), (2, 3), (3, 2), (3, 3))
+MARGIN_OPTIONS = (1, 2, 3)
+MAX_GENERATION_ATTEMPTS = 400
