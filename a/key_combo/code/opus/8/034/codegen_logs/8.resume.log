+    for r, c in exterior[:orange_count]:
+        grid[r, c] = ORANGE
+
+
+def _scatter_green_distractors(grid: np.ndarray, contour_bbox: tuple[int, int, int, int]) -> None:
+    if random.random() < 0.45:
