+            sub = np.zeros((hh, ww), dtype=bool)
+            sub[comp[:, 0] - r0, comp[:, 1] - c0] = True
+            border = np.zeros_like(sub, dtype=bool)
+            border[0, :] = True
+            border[-1, :] = True
+            border[:, 0] = True
+            border[:, -1] = True
+            if np.any(sub & ~border):
+                continue
+            missing = np.argwhere(border & ~sub)
+            if len(missing) != 1:
