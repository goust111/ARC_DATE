+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+MAGENTA = 6
+ORANGE = 7
+MAROON = 9
+
+FRAME_COLORS = (BLUE, GREEN, ORANGE, MAROON)
+DIRS = ((-1, 0), (1, 0), (0, -1), (0, 1))
+DIR_TO_GAP_SIDE = {
+    (-1, 0): "bottom",
+    (1, 0): "top",
+    (0, -1): "right",
+    (0, 1): "left",
