+
+def _nearest_frame(frames: list[dict], pos: tuple[int, int]) -> dict:
+    r, c = pos
+    best = None
+    best_frame = None
+    for frame in frames:
+        dist = min(abs(r - br) + abs(c - bc) for br, bc in frame["border_cells"])
