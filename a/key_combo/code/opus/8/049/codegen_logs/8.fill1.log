+
+
+def _aligned_candidates(grid: np.ndarray, frame: dict, frames: list[dict]) -> list[tuple[int, int]]:
+    gr, gc = frame["gap"]
+    dr, dc = frame["direction"]
+    cur = (gr - dr, gc - dc)
+    out = []
+    while _in_bounds(grid.shape, cur[0], cur[1]):
+        r, c = cur
+        if int(grid[r, c]) != BLACK:
