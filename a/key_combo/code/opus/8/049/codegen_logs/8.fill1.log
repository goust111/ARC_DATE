+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    h, w = shape
+    return 0 <= r < h and 0 <= c < w
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            pts: list[tuple[int, int]] = []
+            while stack:
+                cr, cc = stack.pop()
+                pts.append((cr, cc))
+                for nr, nc in _neighbors4(cr, cc):
+                    if _in_bounds(mask.shape, nr, nc) and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(pts, dtype=int))
+    return comps
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _legend_direction_map(grid: np.ndarray) -> dict[int, tuple[int, int]]:
+    h, w = grid.shape
+    found: dict[tuple[int, int], tuple[int, tuple[int, int]]] = {}
+    starts = set()
+    for c in range(w - 2):
+        starts.add((0, c))
+        starts.add((h - 3, c))
+    for r in range(h - 2):
+        starts.add((r, 0))
+        starts.add((r, w - 3))
+
+    for r0, c0 in starts:
+        patch = grid[r0 : r0 + 3, c0 : c0 + 3]
+        vals, counts = np.unique(patch, return_counts=True)
+        colors = {int(v): int(k) for v, k in zip(vals, counts)}
+        if colors.get(GREY) != 2:
+            continue
+        if int(patch[1, 1]) != GREY:
+            continue
+        grey_pos = {(int(r), int(c)) for r, c in np.argwhere(patch == GREY)}
+        if grey_pos not in ({(1, 1), (0, 1)}, {(1, 1), (2, 1)}, {(1, 1), (1, 0)}, {(1, 1), (1, 2)}):
+            continue
+        fill_colors = [int(v) for v in vals if int(v) != GREY]
+        if len(fill_colors) != 1:
