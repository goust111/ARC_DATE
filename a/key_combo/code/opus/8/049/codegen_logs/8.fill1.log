+    gap_side = DIR_TO_GAP_SIDE[direction]
+    if gap_side == "top":
+        gap = (r0, c0 + random.randint(1, w - 2))
+    elif gap_side == "bottom":
+        gap = (r0 + h - 1, c0 + random.randint(1, w - 2))
+    elif gap_side == "left":
+        gap = (r0 + random.randint(1, h - 2), c0)
+    else:
+        gap = (r0 + random.randint(1, h - 2), c0 + w - 1)
+    frame = {
