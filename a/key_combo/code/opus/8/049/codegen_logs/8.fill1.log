+            assignments[frame["color"]] = 0
+        elif cat == 1:
+            assignments[frame["color"]] = random.randint(1, min(2, capacities[frame["color"]]))
+        elif cat == 2:
+            assignments[frame["color"]] = random.randint(3, min(4, capacities[frame["color"]]))
+        else:
