GENERATION_ATTEMPTS = 300


def _gen_frame_patch(height: int, width: int) -> np.ndarray:
    patch = np.full((height, width), Color.BLACK, dtype=int)
    patch[0, :] = Color.RED
    patch[-1, :] = Color.RED
    patch[:, 0] = Color.RED
    patch[:, -1] = Color.RED
