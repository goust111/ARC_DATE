+        elif cat == 1:
+            assignments[color] = random.randint(1, min(2, capacities[color]))
+        elif cat == 2:
+            assignments[color] = random.randint(3, min(4, capacities[color]))
+        else:
+            assignments[color] = random.randint(5, capacities[color])
