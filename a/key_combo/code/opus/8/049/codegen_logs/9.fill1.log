+def _find_divider_rows(grid: np.ndarray) -> list[int]:
+    width = grid.shape[1]
+    allowed = set(MARKER_COLORS + (DIVIDER,))
+    rows = [
+        r
+        for r in range(grid.shape[0])
+        if int(np.count_nonzero(grid[r] == DIVIDER)) > width // 2
+        and all(int(v) in allowed for v in grid[r])
