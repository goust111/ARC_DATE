+    patches: list[list[np.ndarray | None]] = [[None for _ in range(cols)] for _ in range(rows)]
+
+    for rr in range(rows):
+        for cc in _source_cols(side, cols):
+            if active[rr, cc]:
+                src = _make_patch(region_h, region_w, require_lr_asym=True)
+                patches[rr][cc] = src
