+    for rr in range(len(div_rows) - 1):
+        for cc in range(len(div_cols) - 1):
+            patch = _region_patch(grid, div_rows, div_cols, rr, cc)
+            if np.any(patch == DIVIDER) or np.any(np.isin(patch, MARKER_COLORS)):
