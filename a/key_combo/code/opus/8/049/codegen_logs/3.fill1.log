+        same_right = c0 >= mid and c1 >= mid
+        assert same_left ^ same_right, "row-aligned markers must lie in one horizontal half"
+        out = grid[:, :mid].copy() if same_left else grid[:, mid:].copy()
+    elif c0 == c1:
