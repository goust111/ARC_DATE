/bin/bash -lc "python - <<'PY'
from importlib.machinery import SourceFileLoader
from pathlib import Path
import numpy as np

p = Path('/home/lixinyu/snap/a/key_combo/code/opus/8/049/1.py')
mod = SourceFileLoader('new_arc_task_semantic', str(p)).load_module()

BG, BLUE, RED, GREEN = 0, 1, 2, 3


def nearest_row_edge(r, h):
    return 0 if r < (h - 1 - r) else h - 1


def nearest_col_edge(c, w):
    return 0 if c < (w - 1 - c) else w - 1


def ray_mask(shape, r, c):
    h, w = shape
    rr = nearest_row_edge(r, h)
    cc = nearest_col_edge(c, w)
    mask = np.zeros(shape, dtype=bool)
    mask[min(r, rr):max(r, rr) + 1, c] = True
    mask[r, min(c, cc):max(c, cc) + 1] = True
    return mask


def independent_expected(grid):
    g = np.asarray(grid)
    reds = [(int(r), int(c)) for r, c in np.argwhere(g == RED)]
    blues = [(int(r), int(c)) for r, c in np.argwhere(g == BLUE)]
    red_occ = np.zeros(g.shape, dtype=bool)
    blue_occ = np.zeros(g.shape, dtype=bool)
    for r, c in reds:
        red_occ |= ray_mask(g.shape, r, c)
    for r, c in blues:
        blue_occ |= ray_mask(g.shape, r, c)
    out = np.zeros_like(g)
    out[red_occ & ~blue_occ] = RED
    out[blue_occ & ~red_occ] = BLUE
    out[red_occ & blue_occ] = GREEN
    for r, c in reds:
        out[r, c] = RED
    for r, c in blues:
        out[r, c] = BLUE
    return out


def row_interval(r, h):
    e = nearest_row_edge(r, h)
    return min(r, e), max(r, e)


def col_interval(c, w):
    e = nearest_col_edge(c, w)
    return min(c, e), max(c, e)


# Hand-crafted case: blue horizontal ray passes through a red marker, which must stay red.
grid = np.zeros((9, 14), dtype=int)
grid[4, 4] = RED
grid[4, 6] = BLUE
expected = independent_expected(grid)
actual = mod.main(grid)
assert np.array_equal(actual, expected)
assert actual[4, 4] == RED, 'red marker must stay red under overlap'
assert actual[4, 6] == BLUE, 'blue marker must stay blue under overlap'
assert GREEN in actual, 'crafted case should still contain visible green overlap cells'

# Batch semantic audit on generated examples.
for _ in range(50):
    inp = mod.generate_input()
    out = mod.main(inp)
    assert np.array_equal(out, independent_expected(inp))

    reds = [(int(r), int(c)) for r, c in np.argwhere(inp == RED)]
    blues = [(int(r), int(c)) for r, c in np.argwhere(inp == BLUE)]
    all_pts = reds + blues
    h, w = inp.shape

    assert 2 <= len(reds) <= 4 and 2 <= len(blues) <= 4
    assert len({r for r, _ in all_pts}) == len(all_pts)
    assert len({c for _, c in all_pts}) == len(all_pts)
    assert all(2 * r "'!= h - 1 and 2 * c != w - 1 for r, c in all_pts)
    assert all(max(abs(r1-r2), abs(c1-c2)) > 1 for i, (r1, c1) in enumerate(all_pts) for r2, c2 in all_pts[i+1:])

    type_a = set()
    type_b = set()
    for rr, rc in reds:
        rv = row_interval(rr, h)
        rh = col_interval(rc, w)
        for br, bc in blues:
            bv = row_interval(br, h)
            bh = col_interval(bc, w)
            if rv[0] <= br <= rv[1] and bh[0] <= rc <= bh[1]:
                type_a.add((br, rc))
            if rh[0] <= bc <= rh[1] and bv[0] <= rr <= bv[1]:
                type_b.add((rr, bc))

    greens = {(int(r), int(c)) for r, c in np.argwhere(out == GREEN)}
    assert len(greens) >= 2
    assert len(type_a) >= 1 and len(type_b) >= 1
    assert greens == (type_a | type_b)

print('"'semantic checks passed')
