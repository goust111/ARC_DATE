+def _frame_border_ok(block: np.ndarray) -> bool:
+    return bool(
+        np.all(block[0, :] == GREY)
+        and np.all(block[2, :] == GREY)
+        and np.all(block[:, 0] == GREY)
+        and np.all(block[:, 2] == GREY)
