+        cr, cc = centers[i]
+        squares.append(
+            {
+                "r0": cr - 1,
+                "c0": cc - 1,
+                "r1": cr + 1,
+                "c1": cc + 1,
+                "center_r": cr,
+                "center_c": cc,
+                "color": color,
+            }
+        )
+    return squares
+
