+
+BACKGROUND = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+MAROON = 9
+
+INNER_PALETTE = (GREEN, YELLOW, PINK, ORANGE, MAROON)
+GRID_MIN = 14
+GRID_MAX = 18
+MAX_GENERATION_ATTEMPTS = 500
