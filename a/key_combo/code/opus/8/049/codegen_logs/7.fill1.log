+    paths = _hamiltonian_paths(_adjacency(template))
+    pairs = _ordered_pair_candidates(paths, by_index)
+    if not pairs:
+        return None
+    path_red, path_blue = random.choice(pairs)
+
+    seq_red = [colors[i] for i in path_red]
+    seq_blue = [colors[i] for i in path_blue]
+    if seq_red == seq_blue:
