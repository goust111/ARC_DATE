+def _bridge_layer(sequence: list[int], by_color: dict[int, Square]) -> tuple[set[Coord], int, int]:
+    cells: set[Coord] = set()
+    horiz = 0
+    vert = 0
+    for ca, cb in zip(sequence, sequence[1:]):
+        segment = _bridge_cells(by_color[ca], by_color[cb])
+        if not segment:
