+        if not placed_ok:
+            continue
+
+        if random.random() < 0.65:
+            available_lanes = [lane for lane in range(1, lane_len - 1) if lane not in used_matched_lanes]
+            random.shuffle(available_lanes)
+            for lane in available_lanes[:]:
