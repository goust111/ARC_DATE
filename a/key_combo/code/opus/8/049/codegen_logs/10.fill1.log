+    cells = {(r, c)}
+    if not _clear_cells(cells, occupied):
+        return False
+    if grid[r, c] != BG:
+        return False
+    grid[r, c] = color
+    occupied.add((r, c))
+    marker_records.append(MarkerPlan(color=color, primary=primary, lane=lane, bar_color=color if color in BAR_COLORS else None))
