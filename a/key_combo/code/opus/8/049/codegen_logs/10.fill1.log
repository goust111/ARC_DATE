+                                "bar_primary": bar_primary,
+                            }
+                        )
+                        placed_this = True
+                        total_marker_count += 1
+                    else:
+                        choice = _choose_shared(spec)
+                        if choice is None:
+                            continue
+                        far_primary, near_primary, gate_primary = choice
+                        if not _place_gate(grid, orientation, gate_primary, lane, gate_id, occupied, []):
