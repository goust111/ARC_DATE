+
+@dataclass(frozen=True)
+class Bar:
+    color: int
+    primary: int
+
+
+@dataclass(frozen=True)
+class Gate:
+    gate_id: int
+    primary: int
+    lane: int
+    consumed: bool
+
+
+@dataclass(frozen=True)
+class MarkerPlan:
+    color: int
+    primary: int
+    lane: int
+    bar_color: int | None
