+
+def _place_marker(
+    grid: np.ndarray,
+    orientation: str,
+    primary: int,
+    lane: int,
+    color: int,
+    occupied: set[tuple[int, int]],
+    marker_records: list[MarkerPlan],
+) -> bool:
