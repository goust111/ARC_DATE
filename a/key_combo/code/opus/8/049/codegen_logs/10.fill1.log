+    return True
+
+
+def _place_marker(
+    grid: np.ndarray,
+    orientation: str,
+    primary: int,
+    lane: int,
+    color: int,
+    occupied: set[tuple[int, int]],
+    marker_records: list[MarkerPlan],
+) -> bool:
+    r, c = _coord(orientation, primary, lane)
+    cells = {(r, c)}
+    if not _clear_cells(cells, occupied):
+        return False
+    if grid[r, c] != BG:
+        return False
