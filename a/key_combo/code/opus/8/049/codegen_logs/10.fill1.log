+BG = 0
+BAR_COLORS = (1, 2, 7)
+GATE_CENTER = 3
+UNMATCHED_COLORS = (4, 5, 6, 8)
+GATE_END = 9
+
+GRID_MIN = 12
+GRID_MAX = 16
+BAR_COUNT_CHOICES = (2, 3)
+MARKER_COUNT_MIN = 3
+MARKER_COUNT_MAX = 6
