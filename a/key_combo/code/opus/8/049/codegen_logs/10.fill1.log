+def _place_gate(
+    grid: np.ndarray,
+    orientation: str,
+    gate_primary: int,
+    lane: int,
+    gate_id: int,
+    occupied: set[tuple[int, int]],
+    gate_records: list[Gate],
+) -> bool:
+    if orientation == "horizontal":
+        if not (1 <= lane < grid.shape[1] - 1):
