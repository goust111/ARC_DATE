+        if len(markers) < MARKER_COUNT_MIN or len(markers) > MARKER_COUNT_MAX:
+            continue
+        if not any(marker["bar_color"] is None for marker in markers):
+            continue
+        if not any(marker["bar_color"] is not None for marker in markers):
