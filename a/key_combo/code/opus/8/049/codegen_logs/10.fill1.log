+import random
+from dataclasses import dataclass
+
+import numpy as np
+
+
+BG = 0
+BAR_COLORS = (1, 2, 7)
+GATE_CENTER = 3
+UNMATCHED_COLORS = (4, 5, 6, 8)
+GATE_END = 9
+
+GRID_MIN = 12
+GRID_MAX = 16
+BAR_COUNT_CHOICES = (2, 3)
+MARKER_COUNT_MIN = 3
+MARKER_COUNT_MAX = 6
+GENERATION_ATTEMPTS = 400
+
+
+@dataclass(frozen=True)
+class Bar:
+    color: int
+    primary: int
+
+
+@dataclass(frozen=True)
+class Gate:
+    gate_id: int
+    primary: int
+    lane: int
+    consumed: bool
+
+
+@dataclass(frozen=True)
+class MarkerPlan:
+    color: int
