+        turn_cell = seg_cells[-1]
+        ahead = _add(turn_cell, heading)
+        if not _in_bounds(shape, ahead) or ahead in blocked_now or ahead in used:
+            return None
+
+        extras = [ahead]
+        if next_name == RIGHT_OF[heading_name]:
+            pass
+        elif next_name == LEFT_OF[heading_name]:
