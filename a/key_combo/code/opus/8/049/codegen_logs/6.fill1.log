+BG = 0
+OBSTACLE = 8
+LEGEND_COLORS = (1, 2, 3, 4, 6, 7)
+
+DIRS = {
+    "N": (-1, 0),
+    "E": (0, 1),
+    "S": (1, 0),
+    "W": (0, -1),
+}
+RIGHT_OF = {"N": "E", "E": "S", "S": "W", "W": "N"}
+LEFT_OF = {value: key for key, value in RIGHT_OF.items()}
+OPPOSITE = {"N": "S", "S": "N", "E": "W", "W": "E"}
+
+PATTERNS_BY_SIDE = {
+    "left": [["E", "S", "E"], ["E", "N", "E"], ["E"]],
+    "right": [["W", "S", "W"], ["W", "N", "W"], ["W"]],
+    "top": [["S", "E", "S"], ["S", "W", "S"], ["S"]],
+    "bottom": [["N", "E"], ["N", "W"], ["N"]],
+}
+
+MAX_GENERATION_ATTEMPTS = 500
+_SEEN_OUTPUT_SIGS: set[str] = set()
