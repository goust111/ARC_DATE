+def _parse_legends(grid: np.ndarray) -> list[dict]:
+    top = list(map(int, grid[0]))
+    legends: list[dict] = []
+    c = 0
+    while c < len(top):
+        if top[c] in (BG, OBSTACLE):
+            c += 1
+            continue
+        c0 = c
+        seq = []
+        while c < len(top) and top[c] not in (BG, OBSTACLE):
+            seq.append(int(top[c]))
+            c += 1
