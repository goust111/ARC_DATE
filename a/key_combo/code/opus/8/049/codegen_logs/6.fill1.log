+def _paint_legend(
+    out: np.ndarray,
+    base: np.ndarray,
+    seq: tuple[int, ...],
+    anchor_idx: int,
+    prefix: list[tuple[int, int]],
+    path: list[tuple[int, int]],
+) -> None:
+    anchor = path[0]
+    for idx, color in enumerate(seq):
+        step = idx - anchor_idx
+        target = None
+        if step == 0:
+            target = anchor
+        elif step > 0:
+            if step < len(path):
+                target = path[step]
