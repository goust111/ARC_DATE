        bottom_layouts = _gen_edge_layouts(bottom, lengths, width, height - 1)
        for top_layout in top_layouts:
            for bottom_layout in bottom_layouts:
                layout = {}
                for idx, row, c0 in top_layout + bottom_layout:
                    layout[idx] = (row, c0)
                layouts.append(layout)
    return layouts


