+def _trace_forward_path(grid: np.ndarray, start: tuple[int, int], direction: tuple[int, int]) -> list[tuple[int, int]]:
+    path = [start]
+    cell = start
+    heading = direction
+    seen_states = set()
+
+    while True:
+        state = (cell, heading)
+        assert state not in seen_states, "path must not loop"
+        seen_states.add(state)
