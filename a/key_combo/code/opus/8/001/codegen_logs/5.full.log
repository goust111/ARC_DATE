def _periodic_tile(g: np.ndarray) -> np.ndarray:
    h, w = g.shape
    seen = np.argwhere(g != 0)
    assert len(seen) > 0

    for p in range(1, min(h, w) + 1):
        tile = np.full((p, p), -1, dtype=int)
        ok = True
        for r, c in seen:
