            v = g[r, c]
            if tile[rr, cc] == -1:
                tile[rr, cc] = v
            elif tile[rr, cc] != v:
                ok = False
                break
        if ok and np.all(tile != -1):
            return tile

    raise AssertionError("no complete repeating tile fits the visible cells")


