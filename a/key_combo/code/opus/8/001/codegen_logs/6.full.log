_GEN_MAX_COMPONENTS = 2
_GEN_MAX_ATTEMPTS = 300


def _gen_sprite_patch(mask, bg, fg):
    patch = np.full(_GEN_PATCH_SHAPE, bg, dtype=int)
    rows, cols = zip(*mask)
