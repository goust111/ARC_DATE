        lo = max(_GEN_MIN_COLOR_ORBITS, remaining - _GEN_MAX_COLOR_ORBITS * slots)
        hi = min(_GEN_MAX_COLOR_ORBITS, remaining - _GEN_MIN_COLOR_ORBITS * slots)
        count = int(np.random.randint(lo, hi + 1))
        counts.append(count)
        remaining -= count
    np.random.shuffle(counts)
    return counts


