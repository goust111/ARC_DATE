+def _component_count_by_color(grid: np.ndarray) -> dict[int, int]:
+    counts: dict[int, int] = {}
+    for color in (int(v) for v in np.unique(grid) if int(v) != BG):
+        counts[color] = len(
+            find_components(
+                grid,
+                bg=BG,
+                connectivity=4,
+                monochromatic=True,
+                colors=[color],
