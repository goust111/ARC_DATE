    mr = marker[0] - anchor[0]
    mc = marker[1] - anchor[1]
    assert abs(mr) == 1 and abs(mc) == 1, "marker must be diagonally adjacent to L bend"

    tr = target[0] - anchor[0]
    tc = target[1] - anchor[1]
    dist = -tr * mr
    assert dist >= 1 and tr == -mr * dist and tc == -mc * dist, (
