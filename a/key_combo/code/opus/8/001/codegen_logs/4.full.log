+    dc = _sign(c1 - c0)
+    assert abs(r1 - r0) == abs(c1 - c0) and dr != 0 and dc != 0
+    dist = abs(r1 - r0)
+    return [(r0 + k * dr, c0 + k * dc) for k in range(dist + 1)]
