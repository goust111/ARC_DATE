+                        expandable_ids.append(oid)
+                    if 0 < idx < len(segment) - 1 and oid not in endpoint_ids and oid not in internal_anchor_ids:
+                        internal_anchor_ids.append(oid)
+
+            if not internal_anchor_ids:
+                continue
