+    assert abs(r1 - r0) == abs(c1 - c0) and abs(r1 - r0) >= 2
+    if (r1 - r0) * (c1 - c0) > 0:
+        return _segment_cells((r0, c0), (r1, c1))
+    return _segment_cells((r0, c0), (r1, c1))
+
+
