+        lambda a, b, s: b + s,
+        lambda a, b, s: a + 2 * b + s,
+        lambda a, b, s: a * b + a + b + s,
+        lambda a, b, s: 2 * (a % 2) + b + s,
+    ]
+    for _ in range(60):
