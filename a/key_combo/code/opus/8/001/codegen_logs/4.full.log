+def _orbit(n: int, r: int, c: int) -> tuple[tuple[int, int], ...]:
+    s = n - 1
+    pts = {
+        (r, c),
+        (c, r),
+        (s - r, c),
+        (r, s - c),
+        (s - r, s - c),
+        (s - c, s - r),
+        (c, s - r),
+        (s - c, r),
+    }
+    return tuple(sorted(pts))
