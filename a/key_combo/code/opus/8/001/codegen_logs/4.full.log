+    seen: dict[tuple[tuple[int, int], ...], int] = {}
+    orbits: list[tuple[tuple[int, int], ...]] = []
+    orbit_id: dict[tuple[int, int], int] = {}
+    for r in range(n):
+        for c in range(n):
+            orb = _orbit(n, r, c)
+            if orb not in seen:
+                seen[orb] = len(orbits)
+                orbits.append(orb)
+            orbit_id[(r, c)] = seen[orb]
+    return orbits, orbit_id
