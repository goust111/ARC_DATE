+def _highlight_slot(out: np.ndarray, slot_idx: int) -> None:
+    c0, c1 = SLOT_BANDS[slot_idx]
+    out[TOP_ROW, c0 : c1 + 1] = BLUE
+    out[BOTTOM_ROW, c0 : c1 + 1] = BLUE
