+    n = len(bits)
+    for p in range(1, n):
+        if n % p == 0 and bits == bits[:p] * (n // p):
+            return p
+    return n
+
+
+def _periodic_patterns(period: int) -> list[tuple[int, ...]]:
+    patterns: list[tuple[int, ...]] = []
