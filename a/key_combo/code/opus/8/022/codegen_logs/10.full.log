+def _render_grid(seq: list[int], sprite_coords: tuple[tuple[int, int], ...]) -> np.ndarray:
+    grid = np.full((GRID_H, GRID_W), BG, dtype=int)
+    grid[TOP_ROW, :] = GREY
+    grid[BOTTOM_ROW, :] = GREY
