+SLOT_BANDS = [(i * (SLOT_W + 1), i * (SLOT_W + 1) + SLOT_W - 1) for i in range(SLOT_COUNT)]
+SEP_COLS = [c1 + 1 for _c0, c1 in SLOT_BANDS[:-1]]
