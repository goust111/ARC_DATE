        block_tops.append((r0, c0))
        g[r0 : r0 + _GEN_BLOCK_SIZE, c0 : c0 + _GEN_BLOCK_SIZE] = _GEN_BLOCK_COLOR
        for color, (dr, dc) in zip(random.sample(_GEN_CORNER_COLORS, 4), _GEN_CORNER_OFFSETS):
