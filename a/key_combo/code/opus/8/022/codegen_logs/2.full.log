+        return out
+
+    out = np.full((CHAIN_LENGTH * BLOCK_SIZE + (CHAIN_LENGTH - 1), BLOCK_SIZE), BG, dtype=int)
+    for i, block in enumerate(blocks):
+        r0 = i * (BLOCK_SIZE + 1)
+        out[r0 : r0 + BLOCK_SIZE, :] = block
+        if i < CHAIN_LENGTH - 1:
