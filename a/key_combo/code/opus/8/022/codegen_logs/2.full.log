+        for idx in range(CHAIN_LENGTH):
+            c0 = idx * (BLOCK_SIZE + 1)
+            out_block = out[:, c0 : c0 + BLOCK_SIZE]
+            own_color = _main_color(expected_output[:, c0 : c0 + BLOCK_SIZE])
+            fill_color = _main_color(expected_output[:, ((idx + 1) % CHAIN_LENGTH) * (BLOCK_SIZE + 1) : ((idx + 1) % CHAIN_LENGTH) * (BLOCK_SIZE + 1) + BLOCK_SIZE])
