+        (tokens[0], tokens[1]),
+        (tokens[1], tokens[2]),
+        (tokens[2], None),
+    )
+    blocks = [_paint_block(_make_mask(orientation, incoming, outgoing), color) for (incoming, outgoing), color in zip(specs, colors)]
+    for block in blocks:
+        _validate_block(block)
+    return blocks
