+
+        chains = _all_chains(parsed_blocks, orientation)
+        if len(chains) != 1:
+            return False
+        if chains[0] != _inverse_order(input_order):
+            return False
+        if chains[0] == tuple(range(CHAIN_LENGTH)):
+            return False
