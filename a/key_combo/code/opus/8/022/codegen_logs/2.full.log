+        elif outgoing is None:
+            anchor = random.choice([outgoing_col for outgoing_col in INTERIOR_OFFSETS if abs(outgoing_col - incoming) <= 1])
+            mask = _vertical_stub("top", int(incoming), int(anchor))
+        else:
