+
+def _make_chain_blocks(orientation: str) -> list[np.ndarray]:
+    tokens = random.choice(((1, 2, 3), (3, 2, 1)))
+    colors = random.sample(list(CHAIN_COLORS), CHAIN_LENGTH)
