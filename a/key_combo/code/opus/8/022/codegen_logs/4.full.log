        block = np.full((scale, scale), int(source_color), dtype=int)
        for rel_r, rel_c in source_rel:
            paste(
                out,
                block,
                origin_r + rel_r * scale,
                origin_c + rel_c * scale,
                transparent=bg,
                overwrite=False,
                clip=True,
            )

    return out

