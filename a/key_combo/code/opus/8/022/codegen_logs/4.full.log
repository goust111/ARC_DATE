+
+BLACK = 0
+BLUE = 1
+RED = 2
+YELLOW = 4
+ORANGE = 7
+
+PAIR_COLORS = (BLUE, RED, YELLOW)
+COARSE_SIZE = 3
+TILE_SIZE = 5
