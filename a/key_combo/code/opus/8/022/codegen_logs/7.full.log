    mask = _line_mask(h, w)
    while int(mask.sum()) < area:
        frontier = set()
        for r, c in np.argwhere(mask):
            for dr, dc in _NEIGHBORS8:
                nr, nc = int(r) + dr, int(c) + dc
                if 0 <= nr < h and 0 <= nc < w and not mask[nr, nc]:
                    frontier.add((nr, nc))
        pick = list(frontier)
        nr, nc = pick[int(_RNG.integers(0, len(pick)))]
