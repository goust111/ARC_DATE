+        "cols": cols,
+        "cell_size": cell_size,
+        "row_lines": row_lines,
+        "col_lines": col_lines,
+        "path_col": path_col,
+        "main_start": main_start,
+        "main_gap_cols": main_gap_cols,
+        "main_gap_positions": main_gap_positions,
+        "extra_gap_positions": extra_gap_positions,
