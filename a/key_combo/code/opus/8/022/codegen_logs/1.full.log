+    bottom_margin = int(rng.integers(3, 6))
+
+    lattice_h = rows * cell_size + rows + 1
+    lattice_w = cols * cell_size + cols + 1
+    h = top + lattice_h + bottom_margin
+    w = left + lattice_w + right_margin
