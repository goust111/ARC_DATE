+        plus_mask = np.zeros((3, 3), dtype=bool)
+        plus_mask[1, 1] = True
+        plus_mask[0, 1] = True
+        plus_mask[2, 1] = True
+        plus_mask[1, 0] = True
+        plus_mask[1, 2] = True
