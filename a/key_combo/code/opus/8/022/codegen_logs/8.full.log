+def _simulate_ray(shape: tuple[int, int], start: Coord) -> list[Coord]:
+    H, W = shape
+    r, c = start
+    dr, dc = -1, 1
+    path = [(r, c)]
+    seen_states = {(r, c, dr, dc)}
+    while True:
