+            assert np.all(out[mr, cc0 : cc1 + 1][out[mr, cc0 : cc1 + 1] != YELLOW] == GREEN)
+            assert np.all(out[rr0 : rr1 + 1, mc][out[rr0 : rr1 + 1, mc] != YELLOW] == GREEN)
