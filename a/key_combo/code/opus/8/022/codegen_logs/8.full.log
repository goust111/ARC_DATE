+def _expanded_mask(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for nr, nc in _neighbors8(rr, cc):
+            if _in_bounds(mask.shape, nr, nc):
+                out[nr, nc] = True
