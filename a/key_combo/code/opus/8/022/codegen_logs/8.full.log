+def _rect_mask(shape: tuple[int, int], rects: list[dict[str, object]]) -> np.ndarray:
+    mask = np.zeros(shape, dtype=bool)
+    for rect in rects:
+        r0, c0, r1, c1 = rect["bbox"]
+        mask[r0 : r1 + 1, c0 : c1 + 1] = True
+    return mask
