+def _plus_sprite() -> np.ndarray:
+    sprite = np.zeros((3, 3), dtype=int)
+    sprite[1, 1] = GREEN
+    sprite[0, 1] = GREEN
+    sprite[2, 1] = GREEN
+    sprite[1, 0] = GREEN
+    sprite[1, 2] = GREEN
+    return sprite
+
