+        seen_states.add(state)
+        r, c = nr, nc
+        path.append((r, c))
+    return path
+
+
+def _ray_background_and_cross_output(grid: np.ndarray, stamp_mask: np.ndarray, ray_path: list[Coord], start: Coord) -> np.ndarray:
+    out = grid.copy()
+    out[stamp_mask] = GREEN
