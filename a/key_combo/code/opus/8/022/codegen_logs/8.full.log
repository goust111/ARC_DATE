+    for r, c in ray_path:
+        if (r, c) == start:
+            assert int(out[r, c]) == BLUE
+        elif stamp_mask[r, c]:
+            assert int(out[r, c]) == YELLOW
+        elif int(inp[r, c]) == BLACK:
+            assert int(out[r, c]) == BLUE
+        elif rect_mask[r, c]:
+            assert int(out[r, c]) == int(inp[r, c])
+        else:
+            assert int(out[r, c]) == int(inp[r, c])
