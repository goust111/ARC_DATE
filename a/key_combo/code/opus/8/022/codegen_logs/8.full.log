+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+
+Coord = tuple[int, int]
+BBox = tuple[int, int, int, int]
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _neighbors8(r: int, c: int):
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
+
+
+def _bbox(coords: list[Coord]) -> BBox:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components_of_color(grid: np.ndarray, color: int, connectivity: int = 4) -> list[list[Coord]]:
+    H, W = grid.shape
+    seen = np.zeros((H, W), dtype=bool)
+    comps: list[list[Coord]] = []
+    deltas = list(_neighbors4(0, 0)) if connectivity == 4 else list(_neighbors8(0, 0))
+    if connectivity == 4:
+        offsets = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+    else:
+        offsets = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if (dr, dc) != (0, 0)]
+
+    for r in range(H):
+        for c in range(W):
+            if seen[r, c] or int(grid[r, c]) != color:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            comp: list[Coord] = []
+            while q:
+                cr, cc = q.popleft()
+                comp.append((cr, cc))
+                for dr, dc in offsets:
+                    nr, nc = cr + dr, cc + dc
+                    if _in_bounds(grid.shape, nr, nc) and not seen[nr, nc] and int(grid[nr, nc]) == color:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _find_template(grid: np.ndarray) -> dict[str, object]:
+    candidates = []
+    for comp in _components_of_color(grid, GREEN, connectivity=4):
+        if len(comp) != 5:
+            continue
+        r0, c0, r1, c1 = _bbox(comp)
+        if (r1 - r0 + 1, c1 - c0 + 1) != (3, 3):
+            continue
+        sprite = grid[r0 : r1 + 1, c0 : c1 + 1]
+        center = (1, 1)
+        plus_mask = np.zeros((3, 3), dtype=bool)
+        plus_mask[1, 1] = True
+        plus_mask[0, 1] = True
+        plus_mask[2, 1] = True
+        plus_mask[1, 0] = True
+        plus_mask[1, 2] = True
