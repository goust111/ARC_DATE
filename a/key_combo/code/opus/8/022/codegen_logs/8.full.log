+    grid[start] = BLUE
+    return grid
+
+
+def _corner_sprite_bbox(H: int, W: int) -> BBox:
+    if random.random() < 0.5:
+        r0 = random.randint(0, 2)
+        c0 = random.randint(0, 2)
+    else:
+        r0 = H - 3 - random.randint(0, 2)
+        c0 = W - 3 - random.randint(0, 2)
