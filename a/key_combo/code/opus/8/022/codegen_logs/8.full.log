+    for rect in rects:
+        r0, c0, r1, c1 = rect["bbox"]
+        for mr, mc in rect["markers"]:
+            mask[mr, mc] = True
+            if horizontal:
+                mask[mr, c0 : c1 + 1] = True
+            if vertical:
+                mask[r0 : r1 + 1, mc] = True
+    return mask
+
+
+def _simulate_ray(shape: tuple[int, int], start: Coord) -> list[Coord]:
+    H, W = shape
+    r, c = start
+    dr, dc = -1, 1
+    path = [(r, c)]
+    seen_states = {(r, c, dr, dc)}
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if nr < 0 or nr >= H:
+            dr = -dr
+            nr = r + dr
+        if nc < 0 or nc >= W:
+            dc = -dc
+            nc = c + dc
+        if (nr, nc) == start:
+            break
+        state = (nr, nc, dr, dc)
+        if state in seen_states:
+            break
+        seen_states.add(state)
+        r, c = nr, nc
+        path.append((r, c))
+    return path
+
+
+def _ray_background_and_cross_output(grid: np.ndarray, stamp_mask: np.ndarray, ray_path: list[Coord], start: Coord) -> np.ndarray:
+    out = grid.copy()
+    out[stamp_mask] = GREEN
+    for r, c in ray_path:
+        if (r, c) == start:
+            out[r, c] = BLUE
+        elif stamp_mask[r, c]:
+            out[r, c] = YELLOW
+        elif int(grid[r, c]) == BLACK:
