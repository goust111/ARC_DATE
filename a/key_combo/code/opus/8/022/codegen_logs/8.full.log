+def _simulate_ray(shape: tuple[int, int], start: Coord) -> list[Coord]:
+    H, W = shape
+    r, c = start
+    dr, dc = -1, 1
+    path = [(r, c)]
+    seen_states = {(r, c, dr, dc)}
+    while True:
+        nr = r + dr
+        nc = c + dc
+        if nr < 0 or nr >= H:
+            dr = -dr
+            nr = r + dr
+        if nc < 0 or nc >= W:
+            dc = -dc
+            nc = c + dc
