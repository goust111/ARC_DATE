+    anchor_by_region: dict[tuple[int, int], tuple[int, int]] = {}
+    for comp in anchors:
+        r0, c0, r1, c1 = map(int, comp["bbox"])
+        hits = []
+        for ri, (rs, re) in enumerate(row_spans):
