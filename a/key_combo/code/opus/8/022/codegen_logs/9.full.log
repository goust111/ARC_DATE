        {"side": "right", "r0": 0, "r1": height - 1, "c0": cut, "c1": width - 1},
    ]


def _gen_safe_rows(region: dict[str, int | str], split_type: str) -> tuple[int, int] | None:
    r0 = int(region["r0"])
    r1 = int(region["r1"])
