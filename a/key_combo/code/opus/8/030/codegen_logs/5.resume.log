+
+def _frame_border_mask(h: int, w: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
+
+
+def _local_mirror(lr: int, lc: int, inner_h: int, inner_w: int) -> tuple[int, int]:
