+        motif_mask = (original_inner != BG) & (original_inner != FRAME_COLOR)
+        if not (3 <= int(motif_mask.sum()) <= 6):
+            return False
+        motif_colors = list(dict.fromkeys(int(value) for value in original_inner[motif_mask]))
+        if not (2 <= len(set(motif_colors)) <= 3):
+            return False
