+def _allowed_source_mask(inner_h: int, inner_w: int) -> np.ndarray:
+    orient = _orientation_from_inner(inner_h, inner_w)
+    mask = np.zeros((inner_h, inner_w), dtype=bool)
+    if orient in {"wide", "square"}:
+        max_c = (inner_w - 1) // 2
+        mask[:, : max_c + 1] = True
+    else:
+        max_r = (inner_h - 1) // 2
+        mask[: max_r + 1, :] = True
