+    H, W = map(int, shape)
+    grid = np.zeros((H, W), dtype=int)
+    motif_infos: list[dict] = []
+    for kind, inner_h, inner_w, r0, c0 in placed:
+        patch = _frame_patch(inner_h, inner_w)
+        grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]] = patch
