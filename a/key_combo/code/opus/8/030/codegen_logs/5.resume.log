+def _frame_patch(inner_h: int, inner_w: int) -> np.ndarray:
+    patch = np.zeros((inner_h + 2, inner_w + 2), dtype=int)
+    patch[0, :] = FRAME_COLOR
+    patch[-1, :] = FRAME_COLOR
+    patch[:, 0] = FRAME_COLOR
+    patch[:, -1] = FRAME_COLOR
