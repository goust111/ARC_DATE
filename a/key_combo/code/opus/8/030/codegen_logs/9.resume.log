+def _find_markers(grid: np.ndarray, frame_box: tuple[int, int, int, int]) -> list[tuple[int, int, int]]:
+    markers: list[tuple[int, int, int]] = []
+    comps = find_components(
+        grid,
+        bg=BG,
+        connectivity=4,
+        monochromatic=True,
