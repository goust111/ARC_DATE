+def _render_expected(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int], list[tuple[int, int]], list[tuple[int, int, int]]]:
+    frame_box, offsets = _find_frame(grid)
+    markers = _find_markers(grid, frame_box)
