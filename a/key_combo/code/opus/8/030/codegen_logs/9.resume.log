+def _border_mask(height: int, width: int) -> np.ndarray:
+    mask = np.zeros((int(height), int(width)), dtype=bool)
+    mask[0, :] = True
+    mask[-1, :] = True
+    mask[:, 0] = True
+    mask[:, -1] = True
+    return mask
