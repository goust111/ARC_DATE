+    noise_count = random.choices([0, 1, 2], weights=[1, 3, 2])[0]
+    if not _place_noise(grid, blocked, noise_count):
+        return None
+
+    return grid if _validate_input(grid) else None
+
+
+def generate_input() -> np.ndarray:
