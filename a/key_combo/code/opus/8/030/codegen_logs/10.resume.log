+            return False
+
+    out = main(grid)
+    if out.shape != grid.shape:
+        return False
+    if not np.array_equal(out[grid == GREY], np.full(int((grid == GREY).sum()), GREY)):
+        return False
+    return True
+
+
+def _gen_attempt() -> np.ndarray | None:
+    h = random.randint(18, 22)
+    w = random.randint(18, 22)
