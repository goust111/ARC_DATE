+    4: [_mask([".#", "##", ".#"])],
+    5: [_mask(["#..", "###", "#.."])],
+    6: [_mask(["#...", "####", "#..."])],
+    7: [_mask(["##.", "###", "##."])],
+}
+
+V_ONLY_MASKS = {
+    4: [_mask([".#.", "###"])],
+    5: [_mask(["###", ".#.", ".#."])],
+    6: [_mask(["###", ".#.", ".#.", ".#."])],
+    7: [_mask(["###", "###", ".#."])],
+}
+
+BOTH_MASKS = {
+    3: [_mask(["###"]), _mask(["#", "#", "#"])],
+    4: [_mask(["##", "##"])],
+    5: [_mask([".#.", "###", ".#."])],
+    6: [_mask(["###", "###"])],
+}
+
