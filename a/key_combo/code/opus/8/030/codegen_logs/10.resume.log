from __future__ import annotations

from collections import Counter
import random

import numpy as np


BLACK = 0
BLUE = 1
RED = 2
GREEN = 3
YELLOW = 4
GREY = 5
ORANGE = 7

GEN_ATTEMPTS = 400
DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]


def _mask(rows: list[str]) -> np.ndarray:
