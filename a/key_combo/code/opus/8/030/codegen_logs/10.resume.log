+
+
+def _choose_grey_pair(grid: np.ndarray, blocked: np.ndarray, threshold: int) -> bool:
+    h, w = grid.shape
+    free = [(r, c) for r in range(h) for c in range(w) if grid[r, c] == BLACK and not blocked[r, c]]
