+    for r1, c1 in free:
+        targets = [(r2, c2) for r2, c2 in free if (r2, c2) != (r1, c1) and abs(r1 - r2) + abs(c1 - c2) == threshold]
+        random.shuffle(targets)
+        for r2, c2 in targets:
+            grid[r1, c1] = GREY
+            grid[r2, c2] = GREY
