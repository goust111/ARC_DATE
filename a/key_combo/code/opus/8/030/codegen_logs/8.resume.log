def _carrier_color(g: np.ndarray, coords: np.ndarray) -> int:
    adjacent = set()
    for r_raw, c_raw in coords:
        r = int(r_raw)
        c = int(c_raw)
        for nr, nc in neighbors4(r, c):
            if in_bounds(g.shape, nr, nc) and int(g[nr, nc]) != Color.RED:
