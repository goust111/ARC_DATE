+        bounds = (1, sep_r - 1, 0, sep_c - 1)
+    elif quadrant == "tr":
+        bounds = (1, sep_r - 1, sep_c + 1, w - 1)
+    elif quadrant == "bl":
+        bounds = (sep_r + 1, h - 1, 0, sep_c - 1)
+    elif quadrant == "br":
