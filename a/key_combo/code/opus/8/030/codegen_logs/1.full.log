+
+def _cheb_between_coords(a: np.ndarray, b: np.ndarray) -> int:
+    dist = np.abs(a[:, None, :] - b[None, :, :])
+    return int(np.maximum(dist[..., 0], dist[..., 1]).min())
+
+
+def _sample_spec() -> list[dict]:
+    count = random.choice([3, 4])
+    kinds = ["H", "V", "D"]
+    if count == 4:
