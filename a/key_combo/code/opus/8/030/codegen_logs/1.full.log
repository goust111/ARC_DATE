+
+def _place_objects(height: int, width: int, specs: list[dict]) -> list[dict] | None:
+    placed: list[dict] = []
+    order = sorted(
+        specs,
+        key=lambda spec: (spec["mask"].shape[0] + 2 * (spec["D"] - 1)) * (spec["mask"].shape[1] + 2 * (spec["D"] - 1)),
+        reverse=True,
