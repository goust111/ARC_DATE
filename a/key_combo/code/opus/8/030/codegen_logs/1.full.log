+        top = random.choice(positions)
+        coords = _render_coords(mask, top)
+        bbox = _placed_bbox(top, mask)
+        spec = dict(spec)
+        spec["top"] = top
+        spec["coords"] = coords
+        spec["bbox"] = bbox
+        spec["halo_box"] = _expand_bbox(bbox, halo)
+        placed.append(spec)
