+GRID_SIDE = 13
+PRESENT_COUNT_CHOICES = (5, 6)
+PALETTE_COLORS = (1, 2, 3)
+MAX_GENERATION_ATTEMPTS = 500
+_GEN_RNG = np.random.default_rng()
