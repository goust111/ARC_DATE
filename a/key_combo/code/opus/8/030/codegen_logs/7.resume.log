+
+        candidates = _find_family_candidates(inp)
+        if len(candidates) != 1:
+            continue
+
+        out = _full_output(shape, boxes, pattern, singleton)
+        try:
+            pred = main(inp)
+        except Exception:
+            continue
+        if not np.array_equal(pred, out):
+            continue
+        if np.array_equal(inp, out):
