+
+
+def _boxes_full_visible(shape: tuple[int, int], boxes: list[BBox]) -> int:
+    return sum(1 for r0, c0, r1, c1 in boxes if 0 <= r0 <= r1 < shape[0] and 0 <= c0 <= c1 < shape[1])
+
+
+def _corner_rect(box: BBox, pattern: str, rh: int, rw: int) -> BBox:
