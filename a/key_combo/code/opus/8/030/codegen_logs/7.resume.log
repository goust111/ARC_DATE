+
+
+def _render_input(shape: tuple[int, int], boxes: list[BBox], pattern: str, red_boxes: list[BBox], singleton: list[tuple[int, int, int]]) -> np.ndarray:
+    grid = np.full(shape, BLACK, dtype=int)
