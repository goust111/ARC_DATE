+def _box_hw(box: BBox) -> tuple[int, int]:
+    r0, c0, r1, c1 = box
+    return int(r1 - r0 + 1), int(c1 - c0 + 1)
+
+
+def _add_box(box: BBox, delta: BBox, mul: int = 1) -> BBox:
+    return tuple(int(box[i] + mul * delta[i]) for i in range(4))
