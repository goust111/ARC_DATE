+    return not (ar1 + 1 < br0 or br1 + 1 < ar0 or ac1 + 1 < bc0 or bc1 + 1 < ac0)
+
+
+def _sample_singleton(shape: tuple[int, int], forbidden: np.ndarray) -> list[tuple[int, int, int]]:
+    if random.random() < 0.45:
