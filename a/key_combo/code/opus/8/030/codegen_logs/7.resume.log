+GEN_H_RANGE = (13, 19)
+GEN_W_RANGE = (13, 19)
+GEN_BASE_LONG_SIDE = (2, 5)
+GEN_RED_COUNT = (2, 3)
+GEN_RED_SIDE = (2, 3)
+GEN_SINGLETON_COLORS = [BLUE, 4, 6, 7, 8, 9]
