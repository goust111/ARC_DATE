+
+
+def _hidden_member_stats(shape: tuple[int, int], boxes: list[BBox], pattern: str, grid: np.ndarray) -> tuple[int, int]:
+    hidden_partial = 0
+    fully_visible = 0
+    for box in boxes:
+        mask = _stroke_mask(shape, box, pattern)
