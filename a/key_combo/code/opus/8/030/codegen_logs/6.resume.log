+    edges = []
+    if r0 == 0:
+        edges.append("top")
+    if r1 == H - 1:
+        edges.append("bottom")
+    if c0 == 0:
+        edges.append("left")
+    if c1 == W - 1:
+        edges.append("right")
+    assert len(edges) == 1, f"expected exactly one touched edge, got {edges}"
+    return edges[0]
