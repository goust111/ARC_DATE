+
+
+def _render_input_grid(
+    grid_shape: tuple[int, int],
+    frame: tuple[int, int, int, int],
+    objects: list[dict],
+) -> np.ndarray:
+    top, left, _bottom, _right = frame
+    grid = _render_frame_only(grid_shape, frame)
+    r_off = top + 1
+    c_off = left + 1
+    for obj in objects:
+        for r, c in obj["coords"]:
