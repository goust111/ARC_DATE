+        if height > interior_h - 2 or width > interior_w - 2:
+            return None
+
+        options: list[tuple[int, int]] = []
+        if role in {"base", "mid", "top"}:
+            col_lo = max(1, central_col - 1)
+            col_hi = min(interior_w - width - 1, central_col + 1)
+            if col_lo > col_hi:
+                return None
+            if role == "top":
+                row_lo = 1
+                row_hi = max(row_lo, interior_h // 4)
+            elif role == "mid":
