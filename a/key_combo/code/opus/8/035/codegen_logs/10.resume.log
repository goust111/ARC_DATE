+
+
+def _settle_relative(
+    objects: list[dict],
+    interior_h: int,
+) -> tuple[list[np.ndarray], list[set[str]], list[int], list[dict]]:
+    components = []
+    for obj in objects:
+        coords = np.asarray(sorted(obj["coords"]), dtype=int)
+        components.append(coords)
