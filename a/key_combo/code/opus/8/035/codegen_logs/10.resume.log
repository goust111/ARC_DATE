+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+
+SIDE_ORDER = ("top", "left", "bottom", "right")
+SIDE_COLORS = {"top": RED, "left": YELLOW, "bottom": GREEN, "right": BLUE}
