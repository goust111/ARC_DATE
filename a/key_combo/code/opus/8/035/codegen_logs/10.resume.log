+    sort_descending: bool = True,
+) -> tuple[list[np.ndarray], list[set[str]], list[int]]:
+    ordered = sorted(
+        components,
+        key=_component_order_key,
+        reverse=False,
+    )
+    if not sort_descending:
+        ordered = list(reversed(ordered))
