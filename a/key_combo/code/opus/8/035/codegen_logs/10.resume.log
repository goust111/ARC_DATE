+        while nr + 1 < interior_h and (nr + 1, c) not in occupied:
+            nr += 1
+        occupied.add((nr, c))
+        final.add((nr, c))
+    return final
+
+
+def _recolor_without_gravity(
+    grid_shape: tuple[int, int],
+    frame: tuple[int, int, int, int],
+    objects: list[dict],
+) -> np.ndarray:
+    top, left, bottom, right = frame
