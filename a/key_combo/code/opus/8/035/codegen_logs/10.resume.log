+            row_hi = min(interior_h - height - 2, interior_h // 2)
+            col_lo = 1
+            col_hi = min(interior_w - width - 1, 2)
+            if row_lo > row_hi or col_lo > col_hi:
+                return None
+            for r in range(row_lo, row_hi + 1):
+                for c in range(col_lo, col_hi + 1):
