   343	        while nr + 1 < interior_h and (nr + 1, c) not in occupied:
   344	            nr += 1
   345	        occupied.add((nr, c))
   346	        final.add((nr, c))
   347	    return final
   348	
   349	
   350	def _recolor_without_gravity(
   351	    grid_shape: tuple[int, int],
   352	    frame: tuple[int, int, int, int],
   353	    objects: list[dict],
   354	) -> np.ndarray:
   355	    top, left, bottom, right = frame
   356	    out = _render_frame_only(grid_shape, frame)
   357	    r_off = top + 1
   358	    c_off = left + 1
   359	    for obj in objects:
   360	        for r, c in obj["coords"]:
   361	            rr = r_off + r
   362	            cc = c_off + c
   363	            out[rr, cc] = _nearest_side_color(rr, cc, top, left, bottom, right)
   364	    return out
   365	
   366	
   367	def _validate_semantics(
   368	    grid_shape: tuple[int, int],
   369	    frame: tuple[int, int, int, int],
   370	    interior_h: int,
   371	    interior_w: int,
   372	    objects: list[dict],
   373	) -> bool:
   374	    settled, blockers, shifts, ordered_objects = _settle_relative(objects, interior_h)
   375	    correct_out = _render_output_grid_from_relative(grid_shape, frame, settled)
   376	    input_grid = _render_input_grid(grid_shape, frame, objects)
   377	    if not np.array_equal(main(input_grid), correct_out):
   378	        return False
   379	
   380	    input_bottoms = []
   381	    changed_assignment = False
   382	    for obj, final_coords, shift in zip(ordered_objects, settled, shifts):
   383	        coords = np.asarray(sorted(obj["coords"]), dtype=int)
   384	        input_bottoms.append(_bbox(coords)[2])
   385	        if shift <= 0:
   386	            return False
   387	        before = _class_map_for_relative(coords, (-1, -1, interior_h, interior_w))
   388	        after = _class_map_for_relative(final_coords, (-1, -1, interior_h, interior_w))
   389	        if before != after:
   390	            changed_assignment = True
   391	    if len(set(input_bottoms)) != len(input_bottoms):
   392	        return False
   393	    if not changed_assignment:
   394	        return False
   395	
   396	    if not any("floor" in hit for hit in blockers):
   397	        return False
   398	    if not any("object" in hit for hit in blockers):
   399	        return False
   400	
   401	    sprite_colors = set()
   402	    tie_present = False
   403	    for coords in settled:
   404	        for r, c in coords:
   405	            color = _nearest_side_color(int(frame[0] + 1 + r), int(frame[1] + 1 + c), *frame)
   406	            sprite_colors.add(color)
   407	            if color == GRAY:
   408	                tie_present = True
   409	    if not tie_present:
   410	        return False
   411	    if len(sprite_colors) < 3:
   412	        return False
   413	
   414	    wrong_order_settled, _wrong_blockers, _wrong_shifts, _ = _settle_relative(list(reversed(objects)), interior_h)
   415	    wrong_order_out = _render_output_grid_from_relative(grid_shape, frame, wrong_order_settled)
   416	    if np.array_equal(correct_out, wrong_order_out):
   417	        return False
   418	
   419	    pixelwise = _pixelwise_gravity(objects, interior_h)
   420	    correct_pixels = {tuple(map(int, p)) for comp in settled for p in comp}
   421	    if pixelwise == correct_pixels:
   422	        return False
   423	
   424	    no_gravity_out = _recolor_without_gravity(grid_shape, frame, objects)
   425	    if np.array_equal(correct_out, no_gravity_out):
   426	        return False
   427	
   428	    return True
   429	
   430	
   431	def _try_place_object(
   432	    shape: tuple[tuple[int, int], ...],
   433	    anchor_options: list[tuple[int, int]],
   434	    others: list[set[tuple[int, int]]],
   435	) -> tuple[int, int, set[tuple[int, int]]] | None:
   436	    options = anchor_options[:]
   437	    random.shuffle(options)
   438	    for anchor_r, anchor_c in options:
   439	        coords = _placed_coords(shape, anchor_r, anchor_c)
   440	        if _separated(coords, others):
   441	            return anchor_r, anchor_c, coords
   442	    return None
   443	
   444	
   445	def _candidate_roles(count: int) -> list[str]:
   446	    if count == 3:
   447	        return ["base", "top", random.choice(["left", "right"])]
   448	    if count == 4:
   449	        if random.random() < 0.5:
   450	            return ["base", "mid", "top", random.choice(["left", "right"])]
   451	        return ["base", "top", "left", "right"]
   452	    return ["base", "mid", "top", "left", "right"]
   453	
   454	
   455	def _build_objects(interior_h: int, interior_w: int, count: int) -> list[dict] | None:
   456	    roles = _candidate_roles(count)
   457	    objects: list[dict] = []
   458	    placed_sets: list[set[tuple[int, int]]] = []
   459	    center_band = max(1, interior_w // 2 - 1)
   460	
   461	    central_col = random.randint(max(1, center_band - 1), min(interior_w - 4, center_band + 1))
   462	    top_cursor = 1
   463	    for role in roles:
   464	        shape = _random_shape(role)
   465	        height, width = _shape_dims(shape)
   466	        if height > interior_h - 2 or width > interior_w - 2:
   467	            return None
   468	
   469	        options: list[tuple[int, int]] = []
   470	        if role in {"base", "mid", "top"}:
   471	            col_lo = max(1, central_col - 1)
   472	            col_hi = min(interior_w - width - 1, central_col + 1)
   473	            if col_lo > col_hi:
   474	                return None
   475	            if role == "base":
   476	                row_lo = max(1, interior_h // 3)
   477	                row_hi = max(row_lo, interior_h // 2)
   478	            elif role == "mid":
   479	                row_lo = top_cursor
   480	                row_hi = max(row_lo, interior_h // 3)
   481	            else:
   482	                row_lo = 1
   483	                row_hi = max(1, min(interior_h // 4, top_cursor))
   484	            row_hi = min(row_hi, interior_h - height - 2)
   485	            if row_lo > row_hi:
   486	                return None
   487	            for r in range(row_lo, row_hi + 1):
   488	                for c in range(col_lo, col_hi + 1):
   489	                    options.append((r, c))
   490	        elif role == "left":
   491	            row_lo = 1
   492	            row_hi = min(interior_h - height - 2, interior_h // 2)
   493	            col_lo = 1
   494	            col_hi = min(interior_w - width - 1, 2)
   495	            if row_lo > row_hi or col_lo > col_hi:
   496	                return None
   497	            for r in range(row_lo, row_hi + 1):
   498	                for c in range(col_lo, col_hi + 1):
   499	                    options.append((r, c))
   500	        else:  # right
   501	            row_lo = 1
   502	            row_hi = min(interior_h - height - 2, interior_h // 2)
   503	            col_lo = max(1, interior_w - width - 2)
   504	            col_hi = interior_w - width - 1
   505	            if row_lo > row_hi or col_lo > col_hi:
   506	                return None
   507	            for r in range(row_lo, row_hi + 1):
   508	                for c in range(col_lo, col_hi + 1):
   509	                    options.append((r, c))
   510	
   511	        placed = _try_place_object(shape, options, placed_sets)
   512	        if placed is None:
   513	            return None
   514	        anchor_r, anchor_c, coords = placed
   515	        top_cursor = max(top_cursor, anchor_r + height + 1)
   516	        placed_sets.append(coords)
   517	        objects.append({"role": role, "shape": shape, "coords": coords, "anchor": (anchor_r, anchor_c)})
   518	
   519	    return objects
   520	
   521	
   522	def generate_input() -> np.ndarray:
   523	    for _ in range(400):
   524	        interior_h = random.randint(8, 12)
   525	        interior_w = random.randint(8, 12)
   526	        if interior_h == interior_w:
   527	            continue
   528	
   529	        top_margin = random.randint(1, 3)
   530	        left_margin = random.randint(1, 3)
   531	        bottom_margin = random.randint(1, 3)
   532	        right_margin = random.randint(1, 3)
   533	        grid_h = top_margin + interior_h + 2 + bottom_margin
   534	        grid_w = left_margin + interior_w + 2 + right_margin
   535	        if max(grid_h, grid_w) > 30:
   536	            continue
   537	
   538	        frame = (
   539	            top_margin,
   540	            left_margin,
   541	            top_margin + interior_h + 1,
   542	            left_margin + interior_w + 1,
   543	        )
   544	        count = random.randint(3, 5)
   545	        objects = _build_objects(interior_h, interior_w, count)
   546	        if objects is None:
   547	            continue
   548	
   549	        input_grid = _render_input_grid((grid_h, grid_w), frame, objects)
   550	        gray_components = _components_of_color(input_grid, GRAY)
   551	        if len(gray_components) != count:
   552	            continue
   553	        if any(not (3 <= len(comp) <= 8) for comp in gray_components):
   554	            continue
   555	
   556	        if _validate_semantics((grid_h, grid_w), frame, interior_h, interior_w, objects):
   557	            return input_grid
   558	
   559	    raise RuntimeError("failed to generate a valid puzzle instance")

