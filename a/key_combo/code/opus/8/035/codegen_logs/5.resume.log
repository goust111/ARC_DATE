+    rank_to_color = _rank_color_map(g)
+    out = g.copy()
+    for comp in _gray_components(g):
+        holes = int(comp["holes"])
+        assert 0 <= holes <= 3, "gray sprite hole count must be in 0..3"
+        new_color = rank_to_color[holes + 1]
+        for r, c in comp["coords"]:
+            out[r, c] = new_color
+    return out
