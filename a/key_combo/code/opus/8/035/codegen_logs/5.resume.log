+        hole_coords = np.argwhere(~mask)
+        r0, c0, _, _ = sprite["bbox"]
+        for rr, cc in hole_coords:
+            gr = r0 + int(rr)
+            gc = c0 + int(cc)
+            if int(grid[gr, gc]) == BG:
+                assert int(out[gr, gc]) == BG
+
