+    assert len(cols) == 1, f"{name} side must be vertical"
+    assert rows == list(range(rows[0], rows[-1] + 1)), f"{name} side must be contiguous"
+    return {
+        "name": name,
+        "orientation": "v",
+        "col": cols[0],
+        "r0": rows[0],
