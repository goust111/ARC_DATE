+        random.shuffle(candidates)
+        placed = False
+        for nr, nc in candidates:
+            trial = canvas.copy()
+            trial[nr, nc] = True
+            cropped = _crop_mask(trial)
+            if _count_holes(cropped) == hole_count:
+                canvas = trial
