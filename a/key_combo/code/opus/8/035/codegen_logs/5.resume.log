+def _transform_mask(mask: np.ndarray) -> np.ndarray:
+    out = mask.copy()
+    for _ in range(random.randint(0, 3)):
+        out = np.rot90(out)
+    if random.random() < 0.5:
+        out = np.fliplr(out)
+    if random.random() < 0.5:
+        out = np.flipud(out)
+    return out.copy()
