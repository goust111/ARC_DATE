+        for r in range(row_lo, row_hi - sh + 2)
+        for c in range(col_lo, col_hi - sw + 2)
+    ]
+    random.shuffle(positions)
+    for r, c in positions[:PLACE_RETRIES]:
+        window = blocked[r : r + sh, c : c + sw]
+        if np.any(window & shape):
