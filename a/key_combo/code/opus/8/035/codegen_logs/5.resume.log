+        canvas[start] = True
+        cells = [start]
+        target = random.randint(5, min(10, h * w - 1))
+        while len(cells) < target:
+            r, c = random.choice(cells)
+            candidates = []
+            for dr, dc in NEIGHBORS4:
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < h and 0 <= nc < w and not canvas[nr, nc]:
+                    candidates.append((nr, nc))
+            if not candidates:
