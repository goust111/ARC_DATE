+def _augment_sprite(mask: np.ndarray, hole_count: int) -> np.ndarray:
+    canvas = np.pad(mask.astype(bool), 2, constant_values=False)
+    max_extra = random.randint(1, 4)
+    for _ in range(max_extra):
