+def _dilate8(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    out = mask.copy()
+    for r, c in np.argwhere(mask):
+        rr = int(r)
+        cc = int(c)
+        for dr, dc in NEIGHBORS8:
+            nr, nc = rr + dr, cc + dc
+            if 0 <= nr < h and 0 <= nc < w:
+                out[nr, nc] = True
+    return out
