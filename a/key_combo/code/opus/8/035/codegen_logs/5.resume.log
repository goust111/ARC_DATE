+def _gray_components(grid: np.ndarray) -> list[dict]:
+    comps = []
+    for comp in _components(grid == GREY):
+        r0, c0, r1, c1 = _bbox(comp)
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in comp:
+            mask[r - r0, c - c0] = True
+        comps.append(
+            {
+                "coords": comp,
+                "bbox": (r0, c0, r1, c1),
+                "mask": mask,
+                "holes": _count_holes(mask),
+            }
+        )
+    return comps
