+
+def _bar_cells(orientation, length, anchor):
+    r, c = anchor
+    if orientation == "h":
+        return [(r, c + k) for k in range(length)]
+    return [(r + k, c) for k in range(length)]
+
+
+def _touches_any(cells_a, cells_b):
