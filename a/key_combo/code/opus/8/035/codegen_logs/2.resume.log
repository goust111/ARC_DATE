+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLOR = 7
+BAR_COLORS = (1, 2, 3, 4, 8)
+DIRS = {
+    "left": (0, -1),
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+}
+MISSING_TO_DIR = {
+    (0, 0): "left",
+    (0, 1): "up",
+    (1, 1): "right",
+    (1, 0): "down",
+}
+DIR_TO_MISSING = {v: k for k, v in MISSING_TO_DIR.items()}
+
+
+def _neighbors4(r, c):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _bbox(coords):
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _component_cells(grid, start, seen):
+    h, w = grid.shape
+    sr, sc = start
+    color = int(grid[sr, sc])
+    stack = [(sr, sc)]
+    seen.add((sr, sc))
+    cells = []
+    while stack:
+        r, c = stack.pop()
+        cells.append((r, c))
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and (nr, nc) not in seen and int(grid[nr, nc]) == color:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    cells.sort()
+    return color, cells
