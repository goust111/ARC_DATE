+        return None
+    return placed
+
+
+def _marker_cells(top_left, missing):
+    r0, c0 = top_left
+    cells = []
+    for dr in (0, 1):
+        for dc in (0, 1):
+            if (dr, dc) != missing:
+                cells.append((r0 + dr, c0 + dc))
+    return cells
+
+
+def _assign_markers(rng, shape, bars):
