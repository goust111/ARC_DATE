+            else:
+                if any(rr < 0 or rr >= h or cc < 0 or cc >= w for rr, cc in nxt):
+                    pass
+                else:
+                    continue
+            return bar
+    return None
+
+
+def _assign_input_positions(rng, shape, settled_bars):
+    candidates = []
