+    if input_bars is None:
+        return None
+
+    markers = _assign_markers(rng, (h, w), input_bars)
+    if markers is None:
+        return None
+
+    grid = _build_grid((h, w), input_bars, markers, colors)
+    if not _validate_example(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(500):
+        grid = _gen_attempt(random.Random())
+        if grid is not None:
+            return grid
