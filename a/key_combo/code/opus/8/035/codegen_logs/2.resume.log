+        dr, dc = DIRS[bar["direction"]]
+        cells = list(bar["cells"])
+        cur = cells
+        reason = None
+        while True:
+            nxt = [(r + dr, c + dc) for r, c in cur]
+            if any(r < 0 or r >= h or c < 0 or c >= w for r, c in nxt):
