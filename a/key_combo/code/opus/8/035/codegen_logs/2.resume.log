+    for r in range(h):
+        for c in range(w):
+            if (r, c) in seen:
+                continue
+            if int(grid[r, c]) not in color_set:
+                continue
+            color, cells = _component_cells(grid, (r, c), seen)
+            comps.append(
+                {
+                    "color": color,
+                    "cells": cells,
+                    "bbox": _bbox(cells),
+                    "area": len(cells),
+                }
+            )
+    return comps
+
+
+def _is_bar(comp):
+    r0, c0, r1, c1 = comp["bbox"]
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    return (h == 1 or w == 1) and comp["area"] == max(h, w) and comp["area"] >= 3
+
+
+def _is_marker(comp):
