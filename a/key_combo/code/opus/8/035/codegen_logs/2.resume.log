+    if len(marker_indices) != len(set(marker_indices)) or len(markers) != len(bars):
+        return False
+    return True
+
+
+def _gen_attempt(rng):
+    h = rng.randint(16, 22)
+    w = rng.randint(16, 22)
+    count = rng.randint(4, 5)
+    lengths = sorted(rng.sample(range(3, 8), count))
+    colors = rng.sample(list(BAR_COLORS), count)
