  rule:
    sort bars by height (ascending); sort slots (bar positions) left-to-right
    assign i-th shortest bar shape to i-th leftmost slot, recoloring to slot's original color
    base line preserved; background fills the rest

generation_strategy:
  approach: output-first
  steps:
    1. Pick odd grid size N in [7,17]. Set H=W=N, base_row=N//2, bg=8, base_color=6.
    2. Choose num_bars in [3,5]. Pick that many distinct column anchors spaced >= 2 apart
