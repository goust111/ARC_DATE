+    used_markers = set()
+    for bar in bars:
+        dists = []
+        for idx, marker in enumerate(markers):
+            dists.append((_min_manhattan(bar["cells"], marker["cells"]), idx))
+        dists.sort()
+        assert len(dists) >= 2 or dists[0][1] not in used_markers
