+import random
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+MARKER_COLOR = 7
+BAR_COLORS = (1, 2, 3, 4, 8)
+DIRS = {
+    "left": (0, -1),
+    "up": (-1, 0),
+    "right": (0, 1),
+    "down": (1, 0),
+}
+MISSING_TO_DIR = {
+    (0, 0): "left",
+    (0, 1): "up",
+    (1, 1): "right",
+    (1, 0): "down",
+}
+DIR_TO_MISSING = {v: k for k, v in MISSING_TO_DIR.items()}
