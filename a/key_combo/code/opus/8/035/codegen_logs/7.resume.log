+            continue
+        if len(edge_markers["left"]) != 1 or len(edge_markers["right"]) != 1:
+            continue
+
+        col = edge_markers["top"][0][1]
+        row = edge_markers["left"][0][0]
+        if edge_markers["bottom"][0][1] != col or edge_markers["right"][0][0] != row:
