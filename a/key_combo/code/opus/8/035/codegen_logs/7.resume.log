+
+    expected = _expected_output_from_regions(inp, row, col, template_name)
+    solved = main(inp)
+    assert np.array_equal(solved, expected)
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GEN_ATTEMPTS):
