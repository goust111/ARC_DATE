            cc = int(c)
            if template[rr, cc] != DIVIDER and region[rr, cc] == BG:
                region[rr, cc] = DIVIDER
    return out


def _validate_semantics(
    inp: np.ndarray,
    template_name: str,
    template_region: np.ndarray,
    non_template_regions: dict[str, np.ndarray],
