        assert int(np.count_nonzero(fill_mask)) == (side - 2) ** 2 - 1
        out_view = out[r0 + 1 : r1, c0 + 1 : c1]
        out_view[fill_mask] = FILL_BY_SIDE[side]

    assert used_markers == markers
    return out

