+from __future__ import annotations
+
+import hashlib
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+
+
+_SEED_ROWS = (
+    (".###", "#.#.", "####", "#.#."),
+    ("####", "#.#.", "####", "#.#."),
