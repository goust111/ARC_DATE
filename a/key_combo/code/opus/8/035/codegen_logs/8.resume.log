import numpy as np, random
from collections import deque, Counter

def holes_zero(g):
    H,W=g.shape
    vis=np.zeros((H,W),bool); out=[]
    for r in range(H):
        for c in range(W):
            if g[r,c]"'!=0 or vis[r,c]: continue
            q=deque([(r,c)]); vis[r,c]=1; cells=[]; touch=False
            while q:
                x,y=q.popleft(); cells.append((x,y))
                if x in (0,H-1) or y in (0,W-1): touch=True
                for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx,ny=x+dx,y+dy
                    if 0<=nx<H and 0<=ny<W and g[nx,ny]==0 and not vis[nx,ny]:
                        vis[nx,ny]=1; q.append((nx,ny))
            if not touch: out.append(cells)
    return out

def conn(mask):
    pts=np.argwhere(mask)
    if len(pts)==0: return False
    vis={tuple(pts[0])}; q=[tuple(pts[0])]
    H,W=mask.shape
    while q:
        x,y=q.pop()
        for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
