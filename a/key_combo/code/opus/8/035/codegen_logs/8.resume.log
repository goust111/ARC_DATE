        box_a[2] + _GEN_MIN_BBOX_GAP < box_b[0]
        or box_b[2] + _GEN_MIN_BBOX_GAP < box_a[0]
        or box_a[3] + _GEN_MIN_BBOX_GAP < box_b[1]
        or box_b[3] + _GEN_MIN_BBOX_GAP < box_a[1]
    )


