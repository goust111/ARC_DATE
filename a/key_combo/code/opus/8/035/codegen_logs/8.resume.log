    return len(vis)==mask.sum()

def compose(s): return np.block([[s, np.rot90(s,-1)],[np.rot90(s,1), np.rot90(s,2)]])

def bbox(mask):
    pts=np.argwhere(mask)
    r0,c0=pts.min(0); r1,c1=pts.max(0)
    return r0,c0,r1,c1

