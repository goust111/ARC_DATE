+        if not black_cells:
+            continue
+        fill = _fill_color_for_area(len(black_cells))
+        for r, c in black_cells:
+            out[r, c] = fill
+    return out
+
+
+def _choose_specs() -> list[tuple[str, int, int]]:
+    count = random.choice([3, 4])
+    bins = ["small", "medium", "large"]
+    if count == 4:
+        bins.append(random.choice(bins))
+    random.shuffle(bins)
