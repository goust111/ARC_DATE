+    if {_fill_color_for_area(area) for area in actual_areas} != {BLUE, YELLOW, GREEN}:
+        return False
+
+    if any({int(repaired[r, c]) for r, c in region} != {BLACK} for region in repaired_regions):
+        return False
+
