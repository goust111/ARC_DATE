+    if np.array_equal(correct, repaired):
+        return False
+    if np.array_equal(correct, _naive_without_repair(grid)):
+        return False
+
+    present = set(map(int, np.unique(correct)))
+    if not {BLUE, YELLOW, GREEN}.issubset(present):
+        return False
+    return True
