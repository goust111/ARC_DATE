+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+FILL_BY_RANGE = {
+    range(1, 4): BLUE,
+    range(4, 7): YELLOW,
+    range(7, 11): GREEN,
+}
+
+AREA_OPTIONS = {
+    "small": [(1, 1), (2, 1), (1, 3)],
+    "medium": [(1, 5), (2, 3)],
+    "large": [(1, 7), (3, 3), (2, 5)],
+}
+
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                comp.append((r, c))
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
+            parts.append(comp)
+    return parts
+
+
+def _mirror_repair(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    for r in range(h):
+        for c in range(w):
