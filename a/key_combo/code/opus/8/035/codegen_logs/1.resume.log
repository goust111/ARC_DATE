+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+
+FILL_BY_RANGE = {
+    range(1, 4): BLUE,
+    range(4, 7): YELLOW,
+    range(7, 11): GREEN,
+}
+
+AREA_OPTIONS = {
+    "small": [(1, 1), (2, 1), (1, 3)],
+    "medium": [(1, 5), (2, 3)],
+    "large": [(1, 7), (3, 3), (2, 5)],
+}
+
+GEN_RETRIES = 400
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    parts: list[list[tuple[int, int]]] = []
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            while q:
+                r, c = q.popleft()
+                comp.append((r, c))
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
+            parts.append(comp)
+    return parts
+
+
+def _mirror_repair(grid: np.ndarray) -> np.ndarray:
+    out = np.array(grid, dtype=int, copy=True)
+    h, w = out.shape
+    for r in range(h):
+        for c in range(w):
+            if int(out[r, c]) != GREY:
+                continue
+            mc = w - 1 - c
+            mirror_value = int(out[r, mc])
+            assert mirror_value != GREY, "grey mask must be asymmetric across the vertical axis"
+            out[r, c] = mirror_value
+    return out
+
+
+def _fill_color_for_area(area: int) -> int:
+    for area_range, color in FILL_BY_RANGE.items():
+        if area in area_range:
+            return color
+    raise AssertionError(f"unexpected enclosed area {area}")
+
+
+def _enclosed_void_regions(grid: np.ndarray, wall_color: int = RED) -> list[list[tuple[int, int]]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    mask = g != wall_color
+    regions: list[list[tuple[int, int]]] = []
+    seen = np.zeros((h, w), dtype=bool)
+    for r0 in range(h):
+        for c0 in range(w):
+            if not mask[r0, c0] or seen[r0, c0]:
+                continue
+            q = deque([(r0, c0)])
+            seen[r0, c0] = True
+            comp: list[tuple[int, int]] = []
+            touches_edge = False
+            while q:
+                r, c = q.popleft()
+                comp.append((r, c))
+                if r == 0 or c == 0 or r == h - 1 or c == w - 1:
+                    touches_edge = True
+                for rr, cc in _neighbors4(r, c):
+                    if 0 <= rr < h and 0 <= cc < w and mask[rr, cc] and not seen[rr, cc]:
+                        seen[rr, cc] = True
+                        q.append((rr, cc))
+            if not touches_edge:
+                regions.append(comp)
+    return regions
