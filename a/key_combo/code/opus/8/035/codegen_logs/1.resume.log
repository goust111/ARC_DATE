+    outer_h = hole_h + 2
+    outer_w = hole_w + 2
+    r1 = r0 + outer_h - 1
+    c1 = c0 + outer_w - 1
+    grid[r0, c0 : c1 + 1] = RED
+    grid[r1, c0 : c1 + 1] = RED
+    grid[r0 : r1 + 1, c0] = RED
+    grid[r0 : r1 + 1, c1] = RED
+    return {
