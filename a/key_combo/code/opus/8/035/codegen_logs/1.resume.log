+        if top_stub:
+            top_r0 = max(0, frames[0]["frame_bbox"][0] - top_stub)
+            top_r1 = frames[0]["frame_bbox"][0]
+            grid[top_r0 : top_r1 + 1, center_c] = RED
+    if random.random() < 0.6:
+        bottom_stub = random.randint(0, 2)
+        if bottom_stub:
