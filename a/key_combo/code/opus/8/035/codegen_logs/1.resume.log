+        "hole_bbox": (r0 + 1, c0 + 1, r0 + hole_h, c0 + hole_w),
+        "area": hole_h * hole_w,
+        "hole_h": hole_h,
+        "hole_w": hole_w,
+    }
+
+
+def _naive_without_repair(grid: np.ndarray) -> np.ndarray:
