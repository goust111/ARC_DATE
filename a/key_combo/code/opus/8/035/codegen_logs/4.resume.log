+            else:
+                neighbor = ordered[-2]
+            trail_dir = (neighbor[0] - endpoint[0], neighbor[1] - endpoint[1])
+            ray_dir = (-trail_dir[0], -trail_dir[1])
+            hits = _collect_grey_hits(g, endpoint, ray_dir)
