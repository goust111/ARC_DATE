+        dc = int(np.sign(nxt_point[1] - cur[1]))
+        assert dr == 0 or dc == 0
+        steps = abs(nxt_point[0] - cur[0]) + abs(nxt_point[1] - cur[1])
+        for _ in range(steps):
+            cur = (cur[0] + dr, cur[1] + dc)
+            if not (0 <= cur[0] < box_h and 0 <= cur[1] < box_w):
+                return False
+            if cur in occ:
+                return False
+            if _occupied_neighbor_count(occ, cur) != 1:
