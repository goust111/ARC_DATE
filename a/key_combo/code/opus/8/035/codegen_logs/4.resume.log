+        best_score = max(score for score, _ in scored)
+        options = [nxt for score, nxt in scored if score == best_score]
+        nxt = options[int(rng.integers(0, len(options)))]
+        path.append(nxt)
+        occ.add(nxt)
+        prev, cur = cur, nxt
