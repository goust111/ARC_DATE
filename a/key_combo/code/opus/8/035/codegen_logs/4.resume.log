+
+
+def _tree_like(cells: set[tuple[int, int]]) -> bool:
+    if not _connected(cells):
+        return False
+    edges = 0
+    for r, c in cells:
+        for nr, nc in ((r + 1, c), (r, c + 1)):
+            if (nr, nc) in cells:
+                edges += 1
