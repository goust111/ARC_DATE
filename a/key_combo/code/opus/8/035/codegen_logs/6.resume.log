+    depth: int,
+    depths: np.ndarray,
+    rng: random.Random,
+) -> tuple[np.ndarray, bool]:
+    layer_mask = depths == depth
+    coords = [tuple(map(int, rc)) for rc in np.argwhere(layer_mask)]
+    size = len(coords)
+    min_keep = int(np.ceil(size * KEEP_RATIO_MIN))
+    max_remove = size - min_keep
+    min_remove = 1 if size <= 4 else 2
+
+    for _ in range(200):
