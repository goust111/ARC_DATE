+    assert g.ndim == 2 and g.shape[0] == g.shape[1] and g.size > 0
+
+    depths = _depth_grid(g.shape)
+    layer_count = int(depths.max()) + 1
+
+    settled_masks = []
+    layer_colors = []
+    for depth in range(layer_count):
