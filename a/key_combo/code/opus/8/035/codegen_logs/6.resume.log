  "trajectory": "paint only the final position of each moved object, preserving its shape and color",
  "transform": "clear all original foreground pixels before placing the settled objects on the background",
  "multi_step": "settle objects in descending original right-edge order; use original bbox position to break ties"
}
</annotation>
