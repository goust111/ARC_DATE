+            try:
+                _validate_example(grid)
+            except AssertionError:
+                continue
+            return grid
+    return None
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_RETRIES):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid distance-coded connector puzzle")

