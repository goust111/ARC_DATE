+            return None
+        row = random.randint(1, h - 2)
+        start = random.randint(1, w - span - 1)
+        end = start + span - 1
+        return {"color": color, "orientation": orientation, "distance": distance, "row": row, "start": start, "end": end}
+
+    if h < span + 2:
+        return None
+    col = random.randint(1, w - 2)
+    start = random.randint(1, h - span - 1)
+    end = start + span - 1
