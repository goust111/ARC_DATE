+    distances = _sample_distances(pair_count)
+
+    dims = list(range(GRID_MIN, GRID_MAX + 1))
+    random.shuffle(dims)
+    for h in dims:
+        for w in random.sample(dims, k=len(dims)):
+            specs: list[dict] = []
+            blocked: set[tuple[int, int]] = set()
+            order = sorted(
+                zip(colors, orientations, distances),
