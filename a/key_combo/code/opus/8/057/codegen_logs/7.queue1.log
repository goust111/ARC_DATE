+    return None
+
+
+def _col_scenario(H: int, W: int, aligned_color: int) -> list[dict] | None:
+    other_color = GREEN if aligned_color == RED else RED
+    masks = [_random_mask("left"), _random_mask("left"), _random_mask("left"), _random_mask("right")]
