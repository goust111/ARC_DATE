+    if not col_candidates:
+        return None
+    final_objs = random.choice(col_candidates)
+
+    for _ in range(200):
+        objs = [dict(obj) for obj in final_objs]
+        for obj in objs[:2]:
+            h, _ = obj["mask"].shape
+            obj["input_anchor"] = (random.randint(1, H - h - 2), obj["final_anchor"][1])
+        row_target = random.randint(H // 3, H * 2 // 3)
+        ok = True
+        for obj in objs[2:]:
+            h, _ = obj["mask"].shape
+            mr = obj["marker_rel"][0]
+            r0 = row_target - mr
+            if obj["side"] == "top":
