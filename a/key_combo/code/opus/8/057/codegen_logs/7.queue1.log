+        for rr, cc in np.argwhere(obj["mask"]):
+            grid[r0 + int(rr), c0 + int(cc)] = BLUE
+        mr, mc = obj["marker_rel"]
+        grid[r0 + mr, c0 + mc] = obj["marker_color"]
+    return grid
