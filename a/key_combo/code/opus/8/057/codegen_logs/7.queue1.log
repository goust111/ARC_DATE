+    for color, pair in groups.items():
+        p1 = _marker_abs(pair[0], pair[0]["final_anchor"])
+        p2 = _marker_abs(pair[1], pair[1]["final_anchor"])
+        for rr, cc in _segment_cells(p1, p2):
+            if expected[rr, cc] == BG:
+                expected[rr, cc] = color
+    return expected
