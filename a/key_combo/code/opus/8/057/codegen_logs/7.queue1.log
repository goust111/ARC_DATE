+
+
+def _segment_cells(a: tuple[int, int], b: tuple[int, int]) -> list[tuple[int, int]]:
+    if a[0] == b[0]:
+        row = a[0]
+        c0, c1 = sorted((a[1], b[1]))
+        return [(row, c) for c in range(c0 + 1, c1)]
+    if a[1] == b[1]:
+        col = a[1]
+        r0, r1 = sorted((a[0], b[0]))
+        return [(r, col) for r in range(r0 + 1, r1)]
+    return []
