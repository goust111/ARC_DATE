0581:         dc = ec - cc
0582:         length = max(abs(dr), abs(dc)) + 1
0583:         dr = 0 if dr == 0 else int(dr / abs(dr))
0584:         dc = 0 if dc == 0 else int(dc / abs(dc))
0585:     else:
0586:         if direction is None:
0587:             raise ValueError("draw_line: must provide endpoint or direction")
0588:         dr, dc = map(int, direction)
0589:         dr = 0 if dr == 0 else int(dr / abs(dr))
0590:         dc = 0 if dc == 0 else int(dc / abs(dc))
