0020: def main(grid: np.ndarray) -> np.ndarray:
0021:     """
0022:     Fill each blue rectangular frame with teal and extend teal outward from any one-cell border gap.
0023: 
0024:     Input structure
0025:     - The grid has a black background and one foreground color forming 4-connected rectangular frame objects.
0026:     - Each frame's bounding-box border is either complete or has exactly one missing non-corner border pixel.
0027:     - Frame interiors and the outward line from each border gap are black in the input.
0028:     Rule
0029:     - For every frame, recolor all pixels strictly inside its bbox to teal.
0030:     - If the frame has a missing border pixel, recolor that gap and every black pixel from it straight outward, perpendicular to that side, through the grid edge.
0031:     - Keep the blue frame pixels and all other black background pixels unchanged.
0032:     Key insight
0033:     - A missing border pixel is not a defect to repair with blue; it is a doorway that defines the direction of the teal spill from the filled rectangle.
0034:     """
0035:     g = np.asarray(grid, dtype=int)
0036:     assert g.ndim == 2
0037: 
0038:     bg = get_bg(g)
0039:     assert bg == Color.BLACK
0040:     frame_colors = set(map(int, g.ravel())) - {bg}
0041:     assert len(frame_colors) == 1
0042:     frame_color = next(iter(frame_colors))
0043:     assert frame_color == Color.BLUE
0044: 
0045:     frames = find_components(
0046:         g,
0047:         bg=bg,
0048:         connectivity=4,
0049:         monochromatic=True,
0050:         colors=[frame_color],
0051:         return_format="dict",
0052:     )
0053:     assert frames
0054: 
0055:     out = g.copy()
0056:     h_grid, w_grid = g.shape
0057:     for frame in frames:
0058:         r0, c0, r1, c1 = frame["bbox"]
0059:         h = r1 - r0 + 1
0060:         w = c1 - c0 + 1
0061:         assert h >= 3 and w >= 3
0062: 
0063:         coords = frame["coords"]
0064:         assert all(r in (r0, r1) or c in (c0, c1) for r, c in coords)
0065: 
0066:         missing: list[tuple[int, int]] = []
0067:         border_area = 2 * h + 2 * w - 4
0068:         for r in range(r0, r1 + 1):
0069:             for c in range(c0, c1 + 1):
0070:                 if r in (r0, r1) or c in (c0, c1):
0071:                     if g[r, c] != frame_color:
0072:                         missing.append((r, c))
0073:                 else:
0074:                     assert g[r, c] == bg
0075: 
0076:         assert len(missing) in (0, 1)
0077:         assert frame["area"] == border_area - len(missing)
0078: 
0079:         out[r0 + 1 : r1, c0 + 1 : c1] = Color.TEAL
0080: 
0081:         if missing:
0082:             dr, dc = _gap_direction(missing[0], frame["bbox"])
0083:             r, c = missing[0]
0084:             while 0 <= r < h_grid and 0 <= c < w_grid:
0085:                 assert g[r, c] == bg
0086:                 out[r, c] = Color.TEAL
0087:                 r += dr
0088:                 c += dc
0089: 
0090:     return out
