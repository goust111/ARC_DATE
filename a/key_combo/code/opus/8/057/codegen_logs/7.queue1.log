+        for obj in objs[:2]:
+            h, _ = obj["mask"].shape
+            obj["input_anchor"] = (random.randint(1, H - h - 2), obj["final_anchor"][1])
+        row_target = random.randint(H // 3, H * 2 // 3)
+        ok = True
+        for obj in objs[2:]:
