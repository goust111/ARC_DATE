+        h, w = obj["mask"].shape
+        side = obj["side"]
+        r0, c0, _, _ = obj["bbox"]
+        if side == "top":
+            obj["final_anchor"] = (0, c0)
+        elif side == "bottom":
+            obj["final_anchor"] = (H - h, c0)
+        elif side == "left":
+            obj["final_anchor"] = (r0, 0)
+        elif side == "right":
+            obj["final_anchor"] = (r0, W - w)
+        else:
+            raise ValueError(side)
+    return _render_output(g.shape, objects)
