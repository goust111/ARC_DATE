+
+def _gen_attempt() -> np.ndarray | None:
+    H = random.randint(13, 16)
+    W = random.randint(13, 16)
+    aligned_color = random.choice((RED, GREEN))
+    axis = random.choice(("row", "col"))
+    if axis == "row":
