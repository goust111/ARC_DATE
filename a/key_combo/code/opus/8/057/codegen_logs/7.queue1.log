+    right_rows = {r for r, _ in _boundary_positions(masks[0], "right")}
+    left_rows = {r for r, _ in _boundary_positions(masks[1], "left")}
+    common_rows = sorted(right_rows & left_rows)
+    if not common_rows:
+        return None
