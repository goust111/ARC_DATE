+                "id": idx,
+                "mask": mask,
+                "marker_rel": tuple(map(int, marker_rel)),
+                "marker_color": color,
+                "side": side,
+            }
+        )
+
+    row_candidates = []
+    for _ in range(120):
+        rows = []
+        for obj in objects:
+            h, w = obj["mask"].shape
+            if obj["id"] == 0:
+                r = random.randint(1, max(1, H // 4))
+            elif obj["id"] == 1:
+                r = random.randint(max(0, H * 3 // 5 - h), H - h - 1)
+            elif obj["id"] == 2:
+                r = random.randint(0, max(0, H // 5))
+            else:
+                r = random.randint(max(0, H * 4 // 5 - h), H - h)
+            rows.append(r)
+        temp = []
+        for obj, r in zip(objects, rows):
