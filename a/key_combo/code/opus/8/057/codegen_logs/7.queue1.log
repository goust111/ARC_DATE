+
+def _validate_objects(objects: list[dict], grid_shape: tuple[int, int], aligned_color: int) -> bool:
+    H, W = grid_shape
+    for obj in objects:
+        h, w = obj["mask"].shape
+        for key in ("input_anchor", "final_anchor"):
