0010: # To make the output, copy the pattern in each corner of the input to the corresponding corner of the output. The output grid is one pixel larger in each dimension than the maximum pattern side length.
0011: 
0012: def main(input_grid):
0013:     """
0014:     Copy the four corner patterns into a minimal square output frame.
0015: 
0016:     Input structure:
0017:     - Same-color patterns occupy square regions in the four input corners.
0018:     - Black cells separate the corner regions.
0019:     - At least one foreground pixel is present.
0020: 
0021:     Rule:
0022:     - Assign foreground pixels to their nearest input corner.
0023:     - Infer the largest needed corner square side length.
0024:     - Copy each corner square into the corresponding corner of an output one cell larger.
0025: 
0026:     Key insight:
0027:     - The task preserves each pattern's corner-relative offsets while shrinking the canvas.
0028:     """
0029:     bg = Color.BLACK
0030:     H, W = input_grid.shape
0031: 
0032:     # Infer the square "corner region" side length k from the farthest non-black pixel
0033:     # in each corner, after assigning pixels to their nearest corner.
0034:     coords = np.argwhere(input_grid != bg)
0035:     assert coords.size > 0
0036: 
