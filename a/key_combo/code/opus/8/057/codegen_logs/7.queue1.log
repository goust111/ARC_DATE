+        for obj in objs[:2]:
+            _, w = obj["mask"].shape
+            obj["input_anchor"] = (obj["final_anchor"][0], random.randint(1, W - w - 2))
+        col_target = random.randint(W // 3, W * 2 // 3)
+        ok = True
+        for obj in objs[2:]:
