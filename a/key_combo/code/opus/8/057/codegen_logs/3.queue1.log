import random
from collections import deque,Counter
import numpy as np

CLOSED=[(-1,0,-2,-2),(-2,1,-1,-2),(0,0,-3,-2),(-1,2,0,-2)]
OPEN=[(-2,-2,-2,-2),(-1,-1,2,-2),(0,-2,0,0),(-2,2,2,2),(-2,0,2,1)]

def shear(g):
    h,w=g.shape
    out=np.zeros((h,w+h-1),dtype=int)
    for r in range(h):
        out[r,r:r+w]=g[r]
    return out

def exterior(g):
    h,w=g.shape
    ext=np.zeros((h,w),dtype=bool)
    dq=deque()
    for r in range(h):
        for c in (0,w-1):
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append((r,c))
    while dq:
        r,c=dq.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and g[rr,cc]==0 and not ext[rr,cc]:
                ext[rr,cc]=True; dq.append((rr,cc))
    return ext

def enclosed(g):
    return (g==0)&(~exterior(g))

def comp_count(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool); n=0
    for r,c in np.argwhere(mask):
        if seen[r,c]: continue
        n+=1; seen[r,c]=True; dq=deque([(int(r),int(c))])
        while dq:
            rr,cc=dq.popleft()
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                r2,c2=rr+dr,cc+dc
                if 0<=r2<h and 0<=c2<w and mask[r2,c2] and not seen[r2,c2]:
                    seen[r2,c2]=True; dq.append((r2,c2))
    return n

def draw_shape(g,t,b,L,span,offs):
    ts,te,bs,be=offs
    R=L+span
    g[t+1:b, L]=2
    g[t+1:b, R]=2
    g[t, L+ts:R+te+1]=2
    g[b, L+bs:R+be+1]=2
    mid=(t+b)//2
    seed=(mid, L+mid+max(1, span//2))
    minc=min(L,L+ts,L+bs)
    maxc=max(R,R+te,R+be)
