def enclosed(g):
    h,w=g.shape
    ext=np.zeros((h,w),dtype=bool)
    dq=deque()
    for r in range(h):
        for c in (0,w-1):
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append((r,c))
