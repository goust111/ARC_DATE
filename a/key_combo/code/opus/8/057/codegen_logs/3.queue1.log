import random
from collections import deque
import numpy as np

CLOSED=[(-1,0,-2,-2),(-2,1,-1,-2),(0,0,-3,-2),(-1,2,0,-2)]
OPEN=[(-2,-2,-2,-2),(-1,-1,2,-2),(0,-2,0,0),(-2,2,2,2),(-2,0,2,1)]

def shear(g):
    h,w=g.shape
    out=np.zeros((h,w+h-1),dtype=int)
    for r in range(h):
        out[r,r:r+w]=g[r]
    return out

def exterior(g):
    h,w=g.shape
    ext=np.zeros((h,w),dtype=bool)
    dq=deque()
    for r in range(h):
        for c in (0,w-1):
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append((r,c))
    for c in range(w):
        for r in (0,h-1):
            if g[r,c]==0 and not ext[r,c]: ext[r,c]=True; dq.append((r,c))
    while dq:
        r,c=dq.popleft()
        for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
            rr,cc=r+dr,c+dc
            if 0<=rr<h and 0<=cc<w and g[rr,cc]==0 and not ext[rr,cc]:
                ext[rr,cc]=True; dq.append((rr,cc))
    return ext

def enclosed(g):
    return (g==0)&(~exterior(g))

def comp_count(mask):
    h,w=mask.shape
    seen=np.zeros_like(mask,dtype=bool)
    n=0
    for r,c in np.argwhere(mask):
        if seen[r,c]: continue
        n+=1
        dq=deque([(int(r),int(c))]); seen[r,c]=True
        while dq:
            rr,cc=dq.popleft()
            for dr,dc in ((1,0),(-1,0),(0,1),(0,-1)):
                r2,c2=rr+dr,cc+dc
                if 0<=r2<h and 0<=c2<w and mask[r2,c2] and not seen[r2,c2]:
                    seen[r2,c2]=True; dq.append((r2,c2))
    return n

def draw_shape(g,t,b,L,span,offs):
    ts,te,bs,be=offs
    R=L+span
    g[t+1:b, L]=2
    g[t+1:b, R]=2
    g[t, L+ts:R+te+1]=2
    g[b, L+bs:R+be+1]=2
    rows=np.arange(t+1,b)
    mid=(t+b)//2
    seed=(mid, L+mid+max(1, span//2))
    minc=min(L,L+ts,L+bs)
    maxc=max(R,R+te,R+be)
    return {'bbox':(t,minc,b,maxc),'seed':seed,'kind':'closed' if offs in CLOSED else 'open'}

def fits(blocked,bbox):
    h,w=blocked.shape
    t,l,b,r=bbox
    t=max(0,t-1); l=max(0,l-1); b=min(h-1,b+1); r=min(w-1,r+1)
    return not blocked[t:b+1,l:r+1].any()

def mark(blocked,bbox):
    h,w=blocked.shape
    t,l,b,r=bbox
    t=max(0,t-1); l=max(0,l-1); b=min(h-1,b+1); r=min(w-1,r+1)
    blocked[t:b+1,l:r+1]=True

def gen_one():
    for _ in range(500):
        H=random.randint(7,10)
        W=random.randint(8,12)
        g=np.zeros((H,W),dtype=int)
        blocked=np.zeros((H,W),dtype=bool)
        objs=[]
        target_closed=2 if W>=10 and random.random()<0.7 else 1
        if W>=12 and random.random()<0.25:
            target_closed=3
        for _i in range(target_closed):
            placed=False
            for _ in range(150):
                offs=random.choice(CLOSED)
                span=random.randint(4, min(6,W-3))
                height=random.randint(5, min(7,H))
                t=random.randint(0,H-height)
                b=t+height-1
                left_min=max(0,-offs[0],-offs[2])
                left_max=min(W-1-span, W-1-(span+offs[1]), W-1-(span+offs[3]))
                if left_min>left_max:
                    continue
                L=random.randint(left_min,left_max)
                obj=draw_shape(g.copy(),t,b,L,span,offs)
                if not fits(blocked,obj['bbox']):
                    continue
                draw_shape(g,t,b,L,span,offs)
                obj['kind']='closed'; objs.append(obj); mark(blocked,obj['bbox'])
                placed=True
                break
            if not placed:
                break
        if len([o for o in objs if o['kind']=='closed'])"'!=target_closed:
