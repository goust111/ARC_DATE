        if c >= DISTRACTOR_MIN_BORDER_GAP:
            for a, b in _gen_span_pairs(r, r1):
                if np.all(g[a : b + 1, :c] == GEN_BLACK):
                    opts.append((DISTRACTOR_REDS_PER_EXTENSION * c, (a, c, b, c, "left")))

        if n - 1 - c1 >= DISTRACTOR_MIN_BORDER_GAP:
            for a, b in _gen_span_pairs(r, r1):
