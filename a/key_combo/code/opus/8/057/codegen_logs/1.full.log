+        return None
+    _place_marker(grid, side)
+
+    if not _validate_generated(grid):
+        return None
+    return grid
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _generate_attempt()
+        if grid is not None:
+            return grid
