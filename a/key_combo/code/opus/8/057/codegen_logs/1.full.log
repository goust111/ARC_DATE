+def _enclosed_components(grid: np.ndarray) -> list[list[tuple[int, int]]]:
+    passable = _passable_mask(grid)
+    exterior = _exterior_reachable(passable)
+    enclosed = passable & ~exterior
+    return _mask_components(enclosed)
