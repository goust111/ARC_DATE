+
+def _particle_sort_key(pos: tuple[int, int], delta: tuple[int, int]) -> tuple[int, int]:
+    r, c = pos
+    dr, dc = delta
+    if dr == 1:
+        return (-r, c)
+    if dr == -1:
+        return (r, c)
+    if dc == 1:
+        return (-c, r)
+    return (c, r)
