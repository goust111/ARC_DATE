+    for _ in range(240):
+        seed = (random.randrange(cell_h), random.randrange(cell_w))
+        cells = {seed}
+        frontier = {
+            nbr
+            for nbr in _neighbors4(*seed)
+            if 0 <= nbr[0] < cell_h and 0 <= nbr[1] < cell_w
+        }
+        while len(cells) < area:
