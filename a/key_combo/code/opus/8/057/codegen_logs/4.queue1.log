+def _shape_signature(mask: np.ndarray) -> bytes:
+    coords = np.argwhere(mask)
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    cropped = mask[r0 : r1 + 1, c0 : c1 + 1]
+    return cropped.astype(np.uint8).tobytes() + bytes(cropped.shape)
