+    for spec in specs:
+        shape = _random_connected_shape(cell_h, cell_w, spec["area"])
+        sig = _shape_signature(shape)
+        if len(seen_shapes[spec["area"]]) < 3 and sig in seen_shapes[spec["area"]]:
