+                center_bias = (cell_h - abs(2 * r - cell_h + 1)) + (cell_w - abs(2 * c - cell_w + 1))
+                weights.append(max(1, 3 * adj + center_bias))
+            pick = random.choices(choices, weights=weights, k=1)[0]
+            frontier.remove(pick)
+            cells.add(pick)
+            for nbr in _neighbors4(*pick):
