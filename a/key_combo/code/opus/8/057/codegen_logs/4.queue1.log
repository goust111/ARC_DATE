+    if erows != n_rows or ecols != n_cols:
+        return False
+
+    spec_map = {(spec["row"], spec["col"]): spec for spec in specs}
+    for cell in extracted:
+        spec = spec_map[(cell["row"], cell["col"])]
+        if cell["area"] != spec["area"] or cell["color"] != spec["color"]:
