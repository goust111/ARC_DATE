+import hashlib
+import math
+import random
+
+import numpy as np
+
+
+GREY = 5
+BLACK = 0
+SPRITE_COLORS = (1, 2, 3, 4, 7, 8)
+SQUARE_AREAS = (4, 9, 16)
+NON_SQUARE_AREAS = tuple(area for area in range(3, 17) if area not in SQUARE_AREAS)
+MAX_GENERATION_ATTEMPTS = 600
