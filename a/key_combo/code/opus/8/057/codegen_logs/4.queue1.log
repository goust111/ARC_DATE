+    width = n_cols * cell_w + (n_cols + 1)
+    grid = np.zeros((height, width), dtype=int)
+    grid[0, :] = GREY
+    grid[-1, :] = GREY
+    grid[:, 0] = GREY
+    grid[:, -1] = GREY
+    for row in range(1, n_rows):
+        grid[row * (cell_h + 1), :] = GREY
+    for col in range(1, n_cols):
+        grid[:, col * (cell_w + 1)] = GREY
