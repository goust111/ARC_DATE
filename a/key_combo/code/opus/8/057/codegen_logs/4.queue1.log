+    large_pos = (internal_rows[0], internal_cols[0])
+    tie_a_pos = (internal_rows[0], internal_cols[-1])
+    tie_b_pos = (internal_rows[-1], internal_cols[0])
+    small_pos = (internal_rows[-1], internal_cols[-1])
