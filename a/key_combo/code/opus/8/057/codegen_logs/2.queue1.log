+            return None
+        left_col_max = max(1, w - left_w - 4)
+        left_col = random.randint(1, left_col_max)
+        right_col = random.randint(min(w - right_w - 1, left_col + 2), w - right_w - 1)
+        placements = [
+            (left, bottom_row, left_col),
+            (right, top_row, right_col),
