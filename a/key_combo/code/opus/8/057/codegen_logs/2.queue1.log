+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8)
+POSITIVE_SIDES = {"top", "right"}
+NEGATIVE_SIDES = {"bottom", "left"}
+GEN_RETRIES = 400
+
+
+def _neighbors(r: int, c: int, connectivity: int):
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+        return
+    for dr in (-1, 0, 1):
