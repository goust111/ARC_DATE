+        if mid_low > mid_high:
+            return None
+        mid_col = random.randint(mid_low, mid_high)
+        placements = [
+            (left, bottom_row, left_col),
+            (middle, top_row, mid_col),
+            (right, bottom_row, right_col),
+        ]
+
+    grid = np.zeros((h, w), dtype=int)
