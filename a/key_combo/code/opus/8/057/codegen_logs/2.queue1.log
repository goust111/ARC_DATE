+    summaries = []
+    for group in groups:
+        colors = [layer["color"] for layer in group["layers"]]
+        if group["notch_side"] in NEGATIVE_SIDES:
+            colors = list(reversed(colors))
+        summaries.append(_build_ring(colors))
