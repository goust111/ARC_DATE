+    first_marker = parsed["markers"][(0, 0)]
+    wrong_markers = {key: first_marker for key in parsed["markers"]}
+    return _render_right(parsed["mask"], parsed["right"], parsed["row_spans"], parsed["col_spans"], wrong_markers)
+
