+
+def _is_strongly_asymmetric(mask: np.ndarray) -> bool:
+    variants = [
+        np.flipud(mask),
+        np.fliplr(mask),
+        np.rot90(mask, 1),
+        np.rot90(mask, 2),
+        np.rot90(mask, 3),
