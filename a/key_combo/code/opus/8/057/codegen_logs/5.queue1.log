0024:     assert g.ndim == 2
0025: 
0026:     counts = Counter(map(int, g.flat))
0027:     ranked = counts.most_common()
0028:     assert len(ranked) >= 2
0029:     main_color, main_count = ranked[0]
0030:     assert main_count > ranked[1][1]
0031: 
0032:     out = g.copy()
0033:     rows, cols = np.where(g == main_color)
0034:     out[rows, g.shape[1] - 1 - cols] = main_color
0035:     return out
