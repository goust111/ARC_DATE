+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+GRID_SHAPE = (11, 11)
+CROSS_ROW = 5
+CROSS_COL = 5
+FRAME_COLORS = (PINK, ORANGE, MAROON)
+RANK_TO_COLOR = {0: RED, 1: BLUE, 2: YELLOW}
+QUADRANT_ORDER = ("tl", "tr", "bl", "br")
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if coords.size == 0:
+        return None
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            comp: list[tuple[int, int]] = []
+            while q:
+                rr, cc = q.popleft()
+                comp.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(comp)
+    return out
+
+
+def _count_enclosed_regions(walls: np.ndarray) -> int:
+    h, w = walls.shape
+    bg = ~walls
+    count = 0
+    seen = np.zeros_like(bg, dtype=bool)
+    for r in range(h):
+        for c in range(w):
+            if not bg[r, c] or seen[r, c]:
+                continue
+            seen[r, c] = True
+            q = deque([(r, c)])
+            touches_edge = r in (0, h - 1) or c in (0, w - 1)
+            while q:
+                rr, cc = q.popleft()
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and bg[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        if nr in (0, h - 1) or nc in (0, w - 1):
+                            touches_edge = True
+                        q.append((nr, nc))
+            if not touches_edge:
+                count += 1
+    return count
+
+
+def _outer_ring() -> np.ndarray:
+    walls = np.zeros((5, 5), dtype=bool)
+    walls[0, :] = True
+    walls[4, :] = True
+    walls[:, 0] = True
+    walls[:, 4] = True
+    return walls
+
+
+def _build_templates() -> dict[str, np.ndarray]:
+    outer = _outer_ring()
+    templates: dict[str, np.ndarray] = {}
+
+    walls = outer.copy()
+    templates["rooms1"] = walls
+
+    walls = outer.copy()
+    walls[:, 2] = True
+    templates["rooms2_v"] = walls
+
+    walls = outer.copy()
+    walls[2, :] = True
+    templates["rooms2_h"] = walls
+
+    walls = outer.copy()
+    walls[:, 2] = True
+    walls[2, 0:3] = True
+    templates["rooms3_left"] = walls
+
+    walls = outer.copy()
+    walls[:, 2] = True
+    walls[2, 2:5] = True
+    templates["rooms3_right"] = walls
+
+    walls = outer.copy()
+    walls[2, :] = True
+    walls[0:3, 2] = True
+    templates["rooms3_top"] = walls
+
+    walls = outer.copy()
+    walls[2, :] = True
+    walls[2:5, 2] = True
+    templates["rooms3_bottom"] = walls
+
+    walls = outer.copy()
