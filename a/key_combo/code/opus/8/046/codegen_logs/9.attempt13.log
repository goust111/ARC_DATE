+            continue
+        if not np.any(mask[3, :]) or not np.any(mask[:, 0]) or not np.any(mask[:, 3]):
+            continue
+        if not all(np.any(mask[list({r for r, _c in quad}), :][:, list({c for _r, c in quad})]) for quad in quadrants):
