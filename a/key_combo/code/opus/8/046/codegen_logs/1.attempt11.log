GEN_GRID_ROWS, GEN_GRID_COLS = (16, 26), (14, 24)
GEN_COLORS = range(1, 10)
CLOSED_OUTLINE_COUNT, OPEN_OUTLINE_COUNT = (1, 3), (0, 1)
OUTLINE_BBOX_GAP = 3
