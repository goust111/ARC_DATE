    return grid


def _gen_attempt():
    rows = _gen_random.randint(*GRID_ROWS)
    cols = _gen_random.randint(*GRID_COLS)
    n_regions = _gen_random.randint(*REGION_COUNTS)

    rects = _gen_partition(rows, cols, n_regions)
