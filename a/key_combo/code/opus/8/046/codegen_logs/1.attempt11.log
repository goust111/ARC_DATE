+    expected[:2, :] = source_patch[:2, :]
+    expected[2, :] = YELLOW
+    expected[3, :] = source_patch[1, :]
+    expected[4, :] = source_patch[0, :]
+    return _solve_crop(expected, "h", 2, int(next(iter(set(np.unique(source_patch)) - {BLACK, RED, YELLOW, ORANGE}))))
