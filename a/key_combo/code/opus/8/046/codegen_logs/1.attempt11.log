+    mirrored = _mirror_crop(crop, orient, axis, source_sign)
+    for coords in _enclosed_regions(mirrored, outline_color):
+        rr, cc = coords[:, 0], coords[:, 1]
+        fill_color = _majority_marker(mirrored[rr, cc])
+        mirrored[rr, cc] = fill_color
+    return mirrored
