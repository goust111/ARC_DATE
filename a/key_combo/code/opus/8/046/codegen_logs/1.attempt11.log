+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        built = _build_case()
+        if built is None:
+            continue
+        inp, expected = built
+        actual = main(inp)
+        if np.array_equal(actual, expected):
+            return inp
+    raise RuntimeError("failed to generate a valid input")

