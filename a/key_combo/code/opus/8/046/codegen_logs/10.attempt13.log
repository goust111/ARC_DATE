+                "source_c": int(source_c),
+                "cells": cells,
+                "regions": visited_regions,
+                "column_bands": sorted({region[1] for region in visited_regions}),
+            }
+        )
+    return traces
+
+
+def _analyze(grid: np.ndarray, *, use_deflectors: bool = True) -> dict:
+    g = np.asarray(grid, dtype=int)
