+    ranked = votes.most_common()
+    assert ranked, "expected at least one visited region"
+    assert len(ranked) == 1 or ranked[0][1] > ranked[1][1], "expected a unique winning region"
+
+    return {
+        "grid": g,
+        "divider_rows": divider_rows,
+        "divider_cols": divider_cols,
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "sources": sources,
+        "deflector_rows": deflector_rows,
+        "region_ids": region_ids,
+        "traces": traces,
+        "votes": votes,
+        "winner": ranked[0][0],
+        "winner_votes": int(ranked[0][1]),
+    }
