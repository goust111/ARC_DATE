+        "divider_rows": divider_rows,
+        "divider_cols": divider_cols,
+        "row_spans": row_spans,
+        "col_spans": col_spans,
+        "sources": sources,
+        "deflector_rows": deflector_rows,
+        "region_ids": region_ids,
+        "traces": traces,
+        "votes": votes,
+        "winner": winner,
+        "winner_votes": int(ranked[0][1]),
