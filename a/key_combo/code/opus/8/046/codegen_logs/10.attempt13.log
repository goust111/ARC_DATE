+        for r, c in chosen:
+            grid[r, c] = ORANGE
+            occupied.add((r, c))
+    return True
+
+
+def _generator_semantics_ok(grid: np.ndarray) -> bool:
+    try:
+        analysis = _analyze(grid, use_deflectors=True)
+        straight = _analyze(grid, use_deflectors=False)
+    except AssertionError:
