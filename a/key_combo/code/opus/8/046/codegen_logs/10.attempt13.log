+    c0, c1 = col_spans[region[1]]
+    rr0 = min(r1, r0 + 1)
+    rr1 = max(rr0, r1 - 1)
+    cc0 = min(c1, c0 + 1)
+    cc1 = max(cc0, c1 - 1)
