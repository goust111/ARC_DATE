+def _spans(size: int, dividers: list[int]) -> list[tuple[int, int]]:
+    spans: list[tuple[int, int]] = []
+    start = 0
+    for divider in sorted(dividers):
+        if start <= divider - 1:
+            spans.append((start, divider - 1))
+        start = divider + 1
+    if start <= size - 1:
+        spans.append((start, size - 1))
+    return spans
+
