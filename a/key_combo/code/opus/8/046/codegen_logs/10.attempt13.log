+
+def _render_output(grid: np.ndarray, analysis: dict) -> np.ndarray:
+    out = np.asarray(grid, dtype=int).copy()
+    for ri, (r0, r1) in enumerate(analysis["row_spans"]):
+        for ci, (c0, c1) in enumerate(analysis["col_spans"]):
