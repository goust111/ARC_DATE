+    region_ids = [(ri, ci) for ri in range(len(row_spans)) for ci in range(len(col_spans))]
+    traces = _trace_paths(g, row_spans, col_spans, use_deflectors=use_deflectors)
+    votes: Counter[tuple[int, int]] = Counter()
+    for trace in traces:
