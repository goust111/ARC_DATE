+
+def _unique_winner(votes: Counter[tuple[int, int]]) -> tuple[int, int] | None:
+    ranked = votes.most_common()
+    if not ranked:
+        return None
+    if len(ranked) > 1 and ranked[0][1] == ranked[1][1]:
+        return None
+    return ranked[0][0]
