+                    "kind": "H",
+                    "a": (int(r), int(c0)),
+                    "b": (int(r), int(c1)),
+                    "steps": int(c1 - c0 - 3),
+                }
+            )
+    for c, rows_in_col in cols.items():
+        ordered = sorted(rows_in_col)
+        for r0, r1 in zip(ordered, ordered[1:]):
+            edges.append(
