+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+
+GEN_ATTEMPTS = 500
+REGION_ATTEMPTS = 250
