+        return [(br, c1), (br, c2)], (mr, random.randint(0, c1 - 1))
+    if h >= 6:
+        bc = random.randint(0, w - 2)
+        r1 = random.randint(1, h - 5)
+        r2 = random.randint(r1 + 3, h - 2)
