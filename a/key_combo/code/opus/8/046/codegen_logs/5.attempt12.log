+        region_analyses: dict[int, dict[str, int | bool]] = {}
+
+        wr0, wr1, wc0, wc1 = regions[winner_idx]
+        winner_h, winner_w = wr1 - wr0 + 1, wc1 - wc0 + 1
+        winner_candidate = _generate_region_candidate(
