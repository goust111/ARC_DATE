+        winner_score = int(region_analyses[winner_idx]["score"])
+
+        if role_indices:
+            low_idx = role_indices.pop()
+            lr0, lr1, lc0, lc1 = regions[low_idx]
+            low_candidate = _generate_region_candidate(
