+    r = 1
+    for height in row_heights:
+        c = 1
+        for width in col_widths:
+            grid[r : r + height, c : c + width] = BLACK
+            c += width + 1
+        r += height + 1
+    return grid, _extract_regions(grid)
+
+
+def generate_input() -> np.ndarray:
