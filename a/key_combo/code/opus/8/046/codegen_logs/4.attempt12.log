+    candidates.sort(
+        key=lambda item: (
+            item["dist"],
+            item["frame_idx"],
+            item["gap"][0],
+            item["gap"][1],
+            item["dir"][0],
+            item["dir"][1],
+        )
+    )
+    assigned_frames: set[int] = set()
+    assigned_reds: set[int] = set()
+    assignments: list[dict] = []
+    for cand in candidates:
+        if cand["frame_idx"] in assigned_frames or cand["red_id"] in assigned_reds:
