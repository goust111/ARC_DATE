+        c0 = random.randint(1, w - sw - 2)
+        cells = [(r0 + r, c0 + c) for r, c in shape]
+        if any(grid[r, c] != BG for r, c in cells):
+            continue
+        rr0 = max(0, r0 - 2)
+        cc0 = max(0, c0 - 2)
+        rr1 = min(h - 1, r0 + sh + 1)
+        cc1 = min(w - 1, c0 + sw + 1)
