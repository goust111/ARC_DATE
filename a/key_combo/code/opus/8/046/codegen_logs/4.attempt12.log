+
+
+def _ray_hit(
+    grid: np.ndarray,
+    gap: tuple[int, int],
+    direction: tuple[int, int],
+    red_at: dict[tuple[int, int], int],
+) -> tuple[int, tuple[int, int], int] | None:
+    g = np.asarray(grid, dtype=int)
+    dr, dc = direction
+    r, c = gap
+    dist = 0
+    while True:
+        r += dr
+        c += dc
+        dist += 1
+        if not _in_bounds(g.shape, r, c):
+            return None
+        val = int(g[r, c])
+        if val == BG:
+            continue
+        if val == RED:
+            return red_at[(r, c)], (r, c), dist
+        return None
+
