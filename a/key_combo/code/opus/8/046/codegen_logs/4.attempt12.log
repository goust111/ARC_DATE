+        if active_dir == (-1, 0):
+            hit = (active_gap[0] - slide_dist, active_gap[1])
+            red_cells = [(hit[0] - k, hit[1]) for k in range(red_len)]
+        elif active_dir == (1, 0):
+            hit = (active_gap[0] + slide_dist, active_gap[1])
