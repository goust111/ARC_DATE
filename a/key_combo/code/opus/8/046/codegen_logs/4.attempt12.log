+                clear = False
+                break
+        if not clear:
+            continue
+
+        if any(reserved[max(0, r - RAY_PAD) : min(h, r + RAY_PAD + 1), max(0, c - RAY_PAD) : min(w, c + RAY_PAD + 1)].any() for r, c in red_cells):
