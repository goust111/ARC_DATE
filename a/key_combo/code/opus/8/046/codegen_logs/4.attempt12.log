+        step_c = 0 if shift_c == 0 else (1 if shift_c > 0 else -1)
+        steps = abs(shift_r) + abs(shift_c)
+
+        for step in range(steps):
+            off_r = step * step_r
+            off_c = step * step_c
+            for r, c in comp:
