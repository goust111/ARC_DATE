+        if not all(_in_bounds(grid.shape, r, c) and grid[r, c] == BG for r, c in red_cells):
+            continue
+
+        clear = True
+        rr, cc = active_gap
+        dr, dc = active_dir
+        for step in range(1, slide_dist):
