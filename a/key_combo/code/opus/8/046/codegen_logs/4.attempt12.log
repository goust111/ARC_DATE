+
+
+def _diagonal_fill_cells(grid: np.ndarray, frame: dict) -> set[tuple[int, int]]:
+    g = np.asarray(grid, dtype=int)
+    h, w = g.shape
+    frame_color = int(frame["frame_color"])
+    new_cells: set[tuple[int, int]] = set()
+    for r in range(h):
+        for c in range(w):
