+        inactive_side, inactive_offset = [item for item in gap_defs if item[0] != active_side][0]
+        active_dir = SIDE_DIR[active_side]
+        red_len = random.choice(RED_LEN_CHOICES)
+        slide_dist = random.randint(*SLIDE_DIST_RANGE)
+
+        if active_dir == (-1, 0):
