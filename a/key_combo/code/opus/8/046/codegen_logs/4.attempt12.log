+                gap = (r0, c0 + (1 if dc > 0 else fw - 2))
+            elif side == "bottom":
+                gap = (r1, c0 + (1 if dc > 0 else fw - 2))
+            elif side == "left":
+                gap = (r0 + (1 if dr > 0 else fh - 2), c0)
+            else:
+                gap = (r0 + (1 if dr > 0 else fh - 2), c1)
+            gaps.append(gap)
