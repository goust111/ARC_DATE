+
+
+def _place_frame(
+    grid: np.ndarray,
+    reserved: np.ndarray,
+    frame_color: int,
+    inner_color: int,
+) -> dict | None:
+    h, w = grid.shape
+    for _ in range(300):
+        fh = random.randint(*FRAME_SIZE_RANGE)
+        fw = random.randint(*FRAME_SIZE_RANGE)
+        notch = random.choice(sorted(NOTCH_GAPS))
+        gap_defs = NOTCH_GAPS[notch]
