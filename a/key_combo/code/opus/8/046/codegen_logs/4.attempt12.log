+
+def _frame_boundary_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _frame_side_of_gap(frame: dict, gap: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = frame["bbox"]
+    r, c = gap
+    sides = []
+    if r == r0:
+        sides.append("top")
+    if r == r1:
+        sides.append("bottom")
+    if c == c0:
+        sides.append("left")
+    if c == c1:
+        sides.append("right")
+    if len(sides) != 1:
+        return None
+    return sides[0]
