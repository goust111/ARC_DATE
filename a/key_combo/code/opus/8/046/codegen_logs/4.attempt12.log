+
+BG = 0
+RED = 2
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+FRAME_COLORS = [1, 3, 6, 8, 9]
+INNER_COLORS = [4, 5, 7, 1, 3, 6, 8, 9]
+
+GRID_MIN = 18
+GRID_MAX = 24
+FRAME_COUNT_CHOICES = [2, 3]
+FRAME_SIZE_RANGE = (5, 8)
+INNER_COUNT_RANGE = (2, 4)
+RED_LEN_CHOICES = [2, 3]
