+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+FRAME_COLORS = [1, 3, 6, 8, 9]
+INNER_COLORS = [4, 5, 7, 1, 3, 6, 8, 9]
+
+GRID_MIN = 18
+GRID_MAX = 24
+FRAME_COUNT_CHOICES = [2, 3]
+FRAME_SIZE_RANGE = (5, 8)
+INNER_COUNT_RANGE = (2, 4)
+RED_LEN_CHOICES = [2, 3]
+SLIDE_DIST_RANGE = (4, 7)
+GEN_RETRIES = 500
+FRAME_PADDING = 3
+RAY_PAD = 1
+
+NOTCH_GAPS = {
+    "TL": [("top", (0, 1)), ("left", (1, 0))],
+    "TR": [("top", (0, -1)), ("right", (1, 0))],
+    "BL": [("bottom", (0, 1)), ("left", (-1, 0))],
+    "BR": [("bottom", (0, -1)), ("right", (-1, 0))],
+}
+
+SIDE_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ORTH_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_boundary_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _frame_side_of_gap(frame: dict, gap: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = frame["bbox"]
+    r, c = gap
+    sides = []
+    if r == r0:
+        sides.append("top")
+    if r == r1:
+        sides.append("bottom")
+    if c == c0:
+        sides.append("left")
+    if c == c1:
+        sides.append("right")
+    if len(sides) != 1:
+        return None
+    return sides[0]
+
+
+def _detect_frames(grid: np.ndarray) -> list[dict]:
+    g = np.asarray(grid, dtype=int)
+    colors = sorted(int(v) for v in np.unique(g) if int(v) not in (BG, RED))
+    frames: list[dict] = []
+    for color in colors:
+        comps = _components(g == color)
+        for comp in comps:
+            if len(comp) < 12:
+                continue
+            r0, c0, r1, c1 = _bbox(comp)
+            if r1 - r0 + 1 < 5 or c1 - c0 + 1 < 5:
+                continue
+            boundary = _frame_boundary_cells(r0, c0, r1, c1)
+            comp_set = set(comp)
+            if not comp_set <= boundary:
+                continue
+            gaps = sorted(boundary - comp_set)
+            if not (1 <= len(gaps) <= 2):
+                continue
+            inner = g[r0 + 1 : r1, c0 + 1 : c1]
+            inner_colors = sorted(int(v) for v in np.unique(inner) if int(v) not in (BG, RED, color))
+            if len(inner_colors) != 1:
+                continue
+            frames.append(
+                {
+                    "frame_color": color,
+                    "inner_color": inner_colors[0],
+                    "bbox": (r0, c0, r1, c1),
+                    "frame_pixels": comp_set,
+                    "gaps": gaps,
+                }
+            )
