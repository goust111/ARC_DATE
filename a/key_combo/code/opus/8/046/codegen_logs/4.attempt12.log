+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+FRAME_COLORS = [1, 3, 6, 8, 9]
+INNER_COLORS = [4, 5, 7, 1, 3, 6, 8, 9]
