+from __future__ import annotations
+
+import random
+from collections import defaultdict
+
+import numpy as np
+
+
+BG = 0
+RED = 2
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+FRAME_COLORS = [1, 3, 6, 8, 9]
+INNER_COLORS = [4, 5, 7, 1, 3, 6, 8, 9]
+
+GRID_MIN = 18
+GRID_MAX = 24
+FRAME_COUNT_CHOICES = [2, 3]
+FRAME_SIZE_RANGE = (5, 8)
+INNER_COUNT_RANGE = (2, 4)
+RED_LEN_CHOICES = [2, 3]
+SLIDE_DIST_RANGE = (4, 7)
+GEN_RETRIES = 500
+FRAME_PADDING = 3
+RAY_PAD = 1
+
+NOTCH_GAPS = {
+    "TL": [("top", (0, 1)), ("left", (1, 0))],
+    "TR": [("top", (0, -1)), ("right", (1, 0))],
+    "BL": [("bottom", (0, 1)), ("left", (-1, 0))],
+    "BR": [("bottom", (0, -1)), ("right", (-1, 0))],
+}
+
+SIDE_DIR = {
+    "top": (-1, 0),
+    "bottom": (1, 0),
+    "left": (0, -1),
+    "right": (0, 1),
+}
+
+
+def _in_bounds(shape: tuple[int, int], r: int, c: int) -> bool:
+    return 0 <= r < shape[0] and 0 <= c < shape[1]
+
+
+def _bbox(coords: list[tuple[int, int]]) -> tuple[int, int, int, int]:
+    rows = [r for r, _ in coords]
+    cols = [c for _, c in coords]
+    return min(rows), min(cols), max(rows), max(cols)
+
+
+def _components(mask: np.ndarray) -> list[list[tuple[int, int]]]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[list[tuple[int, int]]] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            comp: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                comp.append((rr, cc))
+                for dr, dc in ORTH_DIRS:
+                    nr, nc = rr + dr, cc + dc
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(comp)
+    return comps
+
+
+def _frame_boundary_cells(r0: int, c0: int, r1: int, c1: int) -> set[tuple[int, int]]:
+    cells = set()
+    for c in range(c0, c1 + 1):
+        cells.add((r0, c))
+        cells.add((r1, c))
+    for r in range(r0, r1 + 1):
+        cells.add((r, c0))
+        cells.add((r, c1))
+    return cells
+
+
+def _frame_side_of_gap(frame: dict, gap: tuple[int, int]) -> str | None:
+    r0, c0, r1, c1 = frame["bbox"]
+    r, c = gap
+    sides = []
+    if r == r0:
+        sides.append("top")
+    if r == r1:
+        sides.append("bottom")
+    if c == c0:
+        sides.append("left")
+    if c == c1:
