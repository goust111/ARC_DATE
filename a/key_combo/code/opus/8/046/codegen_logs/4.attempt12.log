+            r0_max = h - fh - 2
+            c0_min = slide_dist + red_len
+            c0_max = w - fw - 2
+        else:
+            r0_min = 1
+            r0_max = h - fh - 2
+            c0_min = 1
+            c0_max = w - fw - slide_dist - red_len - 1
+
+        if r0_min > r0_max or c0_min > c0_max:
