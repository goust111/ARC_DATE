+            slot = {"frame_idx": frame_idx, "gap": gap, "dir": direction}
+            slots.append(slot)
+            hit = _ray_hit(g, gap, direction, red_at)
+            if hit is not None:
+                red_id, hit_coord, dist = hit
+                candidates.append(
+                    {
+                        "frame_idx": frame_idx,
+                        "gap": gap,
+                        "dir": direction,
+                        "red_id": red_id,
+                        "hit": hit_coord,
