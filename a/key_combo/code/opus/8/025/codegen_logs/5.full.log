+def _noise_rel_candidates(orientation: str, gap_len: int, count: int) -> list[list[tuple[int, int]]]:
+    assert 1 <= count <= gap_len <= 3
+    horizontal: list[list[tuple[int, int]]] = []
+    if count == gap_len:
+        if gap_len == 1:
+            horizontal = [[(1, 0)], [(-1, 0)]]
+        elif gap_len == 2:
+            horizontal = [[(1, 0), (-1, 1)], [(-1, 0), (1, 1)]]
+        else:
+            horizontal = [
+                [(-1, 0), (0, 1), (1, 2)],
+                [(1, 0), (0, 1), (-1, 2)],
