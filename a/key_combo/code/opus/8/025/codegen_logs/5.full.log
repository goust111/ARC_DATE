+        aux_r1 = rng.randint(aux_r0 + 4, work_r_max)
+    else:
+        raise ValueError("not enough side space for auxiliary lines")
+
+    aux_col_choices = [
+        c
+        for c in range(1, work_c_max + 1)
+        if all(abs(int(c) - int(main_c)) >= 3 for main_c in cols)
+    ]
+    if not aux_col_choices:
+        raise ValueError("no auxiliary vertical column")
+    aux_c = int(rng.choice(aux_col_choices))
+    aux_len = int(aux_r1 - aux_r0 + 1)
+    aux_gap_len = rng.randint(1, min(3, aux_len - 4))
+    aux_gap_start = rng.randint(int(aux_r0 + 2), int(aux_r1 - aux_gap_len - 1))
+    aux_fillable = {
+        "orientation": "v",
+        "fixed": int(aux_c),
+        "start": int(aux_r0),
+        "end": int(aux_r1),
+        "gap_start": int(aux_gap_start),
+        "gap_len": int(aux_gap_len),
+        "fillable": True,
+    }
+    _apply_line(expected_blue, aux_fillable, broken=False)
+
+    decoy_rows = [
