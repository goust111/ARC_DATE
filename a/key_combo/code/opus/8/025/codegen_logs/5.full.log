+def _solve_blue(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    blue = np.asarray(grid == BLUE, dtype=bool)
+    noise = _find_diagonal_noise(blue)
+    erased = blue & (~noise)
