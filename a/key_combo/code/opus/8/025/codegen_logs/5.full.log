+
+def _segments_1d(indices: np.ndarray) -> list[tuple[int, int]]:
+    if indices.size == 0:
+        return []
+    segs: list[tuple[int, int]] = []
+    start = prev = int(indices[0])
+    for x in indices[1:]:
+        x = int(x)
+        if x == prev + 1:
+            prev = x
+            continue
+        segs.append((int(start), int(prev)))
+        start = prev = x
+    segs.append((int(start), int(prev)))
+    return segs
