+    template = _random_template(rng)
+    template_offset_r = rng.randint(0, 1)
+    template_offset_c = rng.randint(0, 1)
+    inp = np.zeros((h, w), dtype=int)
+    inp[input_blue] = BLUE
+    _paint_template_zone(inp, template, template_offset_r, template_offset_c)
