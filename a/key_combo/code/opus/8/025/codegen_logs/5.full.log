+    total = 1
+    if axis == 0:
+        rr = int(r - 1)
+        while rr >= 0 and bool(mask[rr, c]):
+            total += 1
+            rr -= 1
+        rr = int(r + 1)
+        while rr < h and bool(mask[rr, c]):
+            total += 1
+            rr += 1
+    else:
+        cc = int(c - 1)
+        while cc >= 0 and bool(mask[r, cc]):
+            total += 1
+            cc -= 1
+        cc = int(c + 1)
+        while cc < w and bool(mask[r, cc]):
+            total += 1
+            cc += 1
+    return int(total)
