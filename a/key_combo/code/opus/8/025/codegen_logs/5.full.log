+def _pick_spaced(rng: random.Random, low: int, high: int, count: int, gap: int) -> list[int] | None:
+    values = list(range(int(low), int(high) + 1))
+    rng.shuffle(values)
+    picked: list[int] = []
+    for v in values:
+        if all(abs(int(v) - int(p)) >= int(gap) for p in picked):
+            picked.append(int(v))
+            if len(picked) == count:
+                return sorted(picked)
+    return None
