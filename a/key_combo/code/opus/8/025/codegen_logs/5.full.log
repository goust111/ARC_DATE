+
+    assert all(not bool(completed[r, c]) for r, c in _gap_cells(decoy_spec))
+    assert np.array_equal(main(inp), exp)
+    return inp, exp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        rng = random.Random()
+        try:
