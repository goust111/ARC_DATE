+    work_c_max = int(w - 5)
+
+    n_rows = 3 if h >= 22 and rng.random() < 0.45 else 2
+    row_gap = 3
+    row_span = int((n_rows - 1) * row_gap)
+    row0_low = 6
+    row0_high = int(work_r_max - 5 - row_span)
