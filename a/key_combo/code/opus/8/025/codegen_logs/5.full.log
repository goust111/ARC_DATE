+    elif count == 1:
+        horizontal = [[(1, 0)], [(-1, 0)], [(1, gap_len - 1)], [(-1, gap_len - 1)]]
+    else:
+        horizontal = [[(1, 0), (-1, gap_len - 1)], [(-1, 0), (1, gap_len - 1)]]
