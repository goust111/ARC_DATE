+            if (r, int(c)) not in gap_cells:
+                mask[r, int(c)] = True
+        return
+
+    c = int(spec["fixed"])
+    if not broken:
+        mask[int(spec["start"]) : int(spec["end"]) + 1, c] = True
+        return
+    gap_cells = {tuple(cell) for cell in _gap_cells(spec)}
+    for r in range(int(spec["start"]), int(spec["end"]) + 1):
+        if (int(r), c) not in gap_cells:
+            mask[int(r), c] = True
