+    base_out = np.zeros((h, w), dtype=int)
+    base_out[expected_blue] = BLUE
+    _paint_template_zone(base_out, template, template_offset_r, template_offset_c)
+    exp = _add_stamps(base_out, template, _intersections(expected_blue))
