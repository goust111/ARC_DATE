+        "fixed": int(decoy_r),
+        "start": int(decoy_start),
+        "end": int(decoy_end),
+        "gap_start": int(decoy_gap_start),
+        "gap_len": int(decoy_gap_len),
+        "fillable": False,
+        "noise_count": int(decoy_noise_count),
