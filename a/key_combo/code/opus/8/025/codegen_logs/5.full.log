+    for tr in range(3):
+        for tc in range(3):
+            if int(template[tr, tc]) != RED:
+                continue
+            rr = int(cr + tr - 1)
+            cc2 = int(cc + tc - 1)
+            if 0 <= rr < h and 0 <= cc2 < w:
+                out[rr, cc2] = RED
+
+
+def _solve_blue(grid: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
+    blue = np.asarray(grid == BLUE, dtype=bool)
