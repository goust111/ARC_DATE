+        "noise_count": int(decoy_noise_count),
+    }
+    _apply_line(expected_blue, decoy_spec, broken=True)
+
+    input_blue = expected_blue.copy()
+    for spec in [*main_specs, aux_fillable]:
+        for r, c in _gap_cells(spec):
+            input_blue[r, c] = False
+
+    occupied_forbidden = np.zeros((h, w), dtype=bool)
+    occupied_forbidden[h - 4 :, w - 4 :] = True
+    inserted_noise: list[tuple[int, int]] = []
+
+    for spec, count in [*[(spec, int(spec["gap_len"])) for spec in main_specs], (aux_fillable, int(aux_fillable["gap_len"])), (decoy_spec, int(decoy_spec["noise_count"]))]:
+        coords = _place_gap_noise(input_blue, occupied_forbidden, spec, count)
+        if coords is None:
