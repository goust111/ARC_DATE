+                continue
+            gap_len = int(gap1 - gap0 + 1)
+            rr0 = max(0, int(r - 1))
+            rr1 = min(int(h - 1), int(r + 1))
+            nearby = int(np.count_nonzero(removed_noise[rr0 : rr1 + 1, gap0 : gap1 + 1]))
+            if gap_len <= nearby:
