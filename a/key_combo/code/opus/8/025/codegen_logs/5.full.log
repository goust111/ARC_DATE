+BG = 0
+BLUE = 1
+RED = 2
+
+ORTH_DIRS = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+DIAG_DIRS = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
+
+GRID_SIDE_MIN = 20
+GRID_SIDE_MAX = 24
+MAIN_ROW_GAP = 3
+MAIN_COL_GAP = 5
+GEN_ATTEMPTS = 300
