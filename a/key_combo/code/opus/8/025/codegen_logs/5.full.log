+    row0 = rng.randint(row0_low, row0_high)
+    rows = [int(row0 + i * row_gap) for i in range(n_rows)]
+
+    n_cols = 3 if w >= 24 and rng.random() < 0.45 else 2
+    col_gap = 5
+    col_span = int((n_cols - 1) * col_gap)
+    col0_low = 4
+    col0_high = int(work_c_max - 4 - col_span)
