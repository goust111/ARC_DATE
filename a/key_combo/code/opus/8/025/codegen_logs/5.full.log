+            continue
+        rs = [r for r, _ in cells]
+        cs = [c for _, c in cells]
+        if max(rs) - min(rs) != 2 or max(cs) - min(cs) != 2:
+            continue
+        for r, c in cells:
+            patch[r, c] = RED
+        return patch
