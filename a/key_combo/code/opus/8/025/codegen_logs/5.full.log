+            "fixed": int(r),
+            "start": int(start),
+            "end": int(end),
+            "gap_start": int(gap_start),
+            "gap_len": int(gap_len),
+            "fillable": True,
+        }
+        _apply_line(expected_blue, spec, broken=False)
+        main_specs.append(spec)
+
+    for c in cols:
