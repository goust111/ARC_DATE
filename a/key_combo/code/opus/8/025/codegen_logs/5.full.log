+def _stamp_red(out: np.ndarray, template: np.ndarray, center: tuple[int, int]) -> None:
+    h, w = map(int, out.shape)
+    cr, cc = map(int, center)
+    for tr in range(3):
+        for tc in range(3):
+            if int(template[tr, tc]) != RED:
+                continue
+            rr = int(cr + tr - 1)
+            cc2 = int(cc + tc - 1)
+            if 0 <= rr < h and 0 <= cc2 < w:
+                out[rr, cc2] = RED
+
