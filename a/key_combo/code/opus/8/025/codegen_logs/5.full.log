+            "fixed": int(c),
+            "start": int(start),
+            "end": int(end),
+        }
+        _apply_line(expected_blue, spec, broken=False)
+
+    above_span = int(rows[0] - 2)
+    below_span = int(work_r_max - rows[-1] - 1)
+    if above_span >= 5 and (below_span < 5 or rng.random() < 0.5):
+        aux_side = "above"
