+    start = prev = int(indices[0])
+    for x in indices[1:]:
+        x = int(x)
+        if x == prev + 1:
+            prev = x
+            continue
+        segs.append((int(start), int(prev)))
+        start = prev = x
+    segs.append((int(start), int(prev)))
+    return segs
