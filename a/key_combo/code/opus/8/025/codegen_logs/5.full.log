+                r = int(spec["fixed"])
+                c0 = int(spec["gap_start"])
+                rr0 = max(0, r - 1)
+                rr1 = min(h - 1, r + 1)
+                if int(np.count_nonzero(found_noise[rr0 : rr1 + 1, c0 : c0 + spec["gap_len"]])) < int(spec["gap_len"]):
