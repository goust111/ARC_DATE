+    assert b is not None, "expected a red template in the lower-right 4x4 zone"
+    r0, c0, r1, c1 = map(int, b)
+    patch = region[r0 : r1 + 1, c0 : c1 + 1]
+    assert patch.shape == (3, 3), f"template bbox must be 3x3, got {patch.shape}"
