+def _intersections(mask: np.ndarray) -> list[tuple[int, int]]:
+    h, w = map(int, mask.shape)
+    pts: list[tuple[int, int]] = []
+    for r in range(h):
+        for c in range(w):
+            if not bool(mask[r, c]):
+                continue
+            if _run_length(mask, r, c, axis=1) >= 3 and _run_length(mask, r, c, axis=0) >= 3:
