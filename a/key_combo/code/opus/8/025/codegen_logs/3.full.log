+def _empty_cells_with_allowed_sides(h: int, w: int, dominoes: list[dict]) -> dict[tuple[int, int], tuple[int, ...]]:
+    side_forbidden = []
+    for side in (0, 1):
+        forbidden = set()
+        for domino in dominoes:
+            if domino["owner"] != side:
+                continue
+            for r, c in domino["cells"]:
+                forbidden.add((r, c))
+                for nr, nc in neighbors4(r, c):
+                    if 0 <= nr < h and 0 <= nc < w:
+                        forbidden.add((nr, nc))
+        side_forbidden.append(forbidden)
+
+    allowed = {}
+    for r in range(h):
+        for c in range(w):
+            if any((r, c) in side_forbidden[side] and (r, c) in {cell for d in dominoes for cell in d["cells"]} for side in (0, 1)):
+                continue
+            if any((r, c) in d["cells"] for d in dominoes):
+                continue
+            sides = tuple(side for side in (0, 1) if (r, c) not in side_forbidden[side])
+            if sides:
+                allowed[(r, c)] = sides
+    return allowed
+
