+    by_dom = {}
+    for idx, info in enumerate(ray_infos):
+        by_dom.setdefault(info["dom_idx"], []).append(idx)
+
+    for dom_idx, ray_ids in by_dom.items():
+        candidates = []
+        for ray_id in ray_ids:
+            info = ray_infos[ray_id]
