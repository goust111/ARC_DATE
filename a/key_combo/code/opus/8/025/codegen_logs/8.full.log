+        used_variant_sigs: dict[int, set[tuple[tuple[int, int], bytes]]] = {int(color): set() for color in chosen_colors}
+        block_specs: list[dict] = []
+        ok = True
+        for (r0, c0), color in zip(positions, assignments):
