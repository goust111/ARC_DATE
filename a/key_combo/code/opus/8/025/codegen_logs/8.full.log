+from __future__ import annotations
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+LEGEND_COLOR_POOL = (BLUE, RED, GREEN, YELLOW)
+BLOCK_SIZE = 7
+PANEL_SLOT_SHAPE = (4, 4)
+PANEL_SHAPE = (11, 11)
+PANEL_SLOT_ORIGINS = ((1, 1), (1, 6), (6, 1), (6, 6))
