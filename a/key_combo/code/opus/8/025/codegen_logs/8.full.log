+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GREY = 5
+ORANGE = 7
+TEAL = 8
+
+LEGEND_COLOR_POOL = (BLUE, RED, GREEN, YELLOW)
