+    return candidates[0]
+
+
+def _find_block_boxes(grid: np.ndarray) -> list[tuple[int, int, int, int]]:
+    comps = _components_mask(grid != BLACK, connectivity=4)
+    boxes: list[tuple[int, int, int, int]] = []
+    for coords in comps:
