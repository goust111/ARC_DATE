+    return sorted(boxes)
+
+
+def _match_block_color(block: np.ndarray, legend: dict[int, np.ndarray]) -> int:
+    orange = block == ORANGE
+    assert orange.any() and set(np.unique(block)).issubset({GREY, ORANGE})
