+def _place_shape_in_slot(shape: np.ndarray, slot_shape: tuple[int, int], rng: np.random.Generator) -> np.ndarray:
+    slot_h, slot_w = slot_shape
+    h, w = shape.shape
+    dr = int(rng.integers(slot_h - h + 1))
+    dc = int(rng.integers(slot_w - w + 1))
