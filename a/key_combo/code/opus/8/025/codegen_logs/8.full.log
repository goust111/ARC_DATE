+                    "color": int(color),
+                    "marker_shape": marker_shape.copy(),
+                }
+            )
+        if not ok:
+            continue
+
+        expected = _build_output_from_meta(grid, block_specs, palette)
+        _validate_generated(grid, expected, legend_shapes, palette, block_specs)
+        return grid
