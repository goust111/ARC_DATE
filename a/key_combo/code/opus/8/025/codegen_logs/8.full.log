+        (r, c)
+        for r in range(h - BLOCK_SIZE + 1)
+        for c in range(w - BLOCK_SIZE + 1)
+        if (r > palette_row + 1 or c > pc1 + 1)
+    ]
+    rng.shuffle(candidates)
