+    c0 = (BLOCK_SIZE - w) // 2
+    view = block[r0 : r0 + h, c0 : c0 + w]
+    view[marker_shape] = ORANGE
+    return block
+
+
+def _expanded(mask: np.ndarray, pad: int = 1) -> np.ndarray:
