+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+GRAY = 5
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+GRID_BANDS = 3
+DIVIDER_WIDTH = 1
+MARKER_CELLS = [(0, 1), (0, 2), (1, 1), (1, 2), (2, 1), (2, 2)]
+ROW_MARKER_COLORS = [BLUE, GREEN, YELLOW, PINK, ORANGE, TEAL]
+MAX_GENERATION_ATTEMPTS = 500
