+    """
+    g = np.asarray(grid, dtype=int)
+    info = _solve_metadata(g)
+    out = g.copy()
+    for rr, cc in _worker_cells():
+        cell = _cell(out, info["row_segments"], info["col_segments"], rr, cc)
+        variant_idx = info["marker_map"][(rr, cc)]
+        color = info["row_colors"][rr]
