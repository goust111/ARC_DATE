+
+def _variant_coord_sets(mask: np.ndarray) -> list[frozenset[tuple[int, int]]]:
+    return [_mask_coords(v) for v in _d4_variants(mask)]
+
+
+def _paint_mask(cell: np.ndarray, coords: frozenset[tuple[int, int]], color: int) -> None:
+    cell[:, :] = BG
