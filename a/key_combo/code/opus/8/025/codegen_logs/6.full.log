+    return grid
+
+
+def _validate_instance(grid: np.ndarray) -> None:
+    info = _solve_metadata(grid)
+    assert info["bg"] == BG
+    assert grid.shape[0] == grid.shape[1]
+    assert info["cell_size"] in (5, 6)
