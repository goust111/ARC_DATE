+            _mask_from_coords(7, [(0, 0), (0, 6), (6, 0), (6, 6)]),
+            _mask_from_coords(7, [(0, 3), (3, 0), (3, 6), (6, 3)]),
+            _mask_from_coords(7, [(1, 1), (1, 5), (5, 1), (5, 5)]),
