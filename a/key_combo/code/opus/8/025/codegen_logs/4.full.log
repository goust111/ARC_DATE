+        for r, c in coords:
+            rr = r0 + int(r)
+            cc = c0 + int(c)
+            assert not occupied[rr, cc], "centered damage masks must not overlap"
+            occupied[rr, cc] = True
+            out[rr, cc] = int(color)
+    return out
+
+
+def _center_overlay(specs: list[tuple[int, np.ndarray]]) -> np.ndarray:
