+    for r, c in coords:
+        mask[int(r), int(c)] = True
+    return mask
+
+
+MASK_PARTITIONS: dict[int, list[list[np.ndarray]]] = {
+    5: [
+        [
+            _mask_from_coords(5, [(0, 0), (0, 4), (4, 0), (4, 4)]),
+            _mask_from_coords(5, [(0, 2), (2, 0), (2, 4), (4, 2)]),
+            _mask_from_coords(5, [(1, 1), (1, 3), (3, 1), (3, 3)]),
+            _mask_from_coords(5, [(2, 2)]),
