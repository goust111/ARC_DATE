+PALETTE = (Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW)
+GRID_RANGE = (24, 29)
+GEN_ATTEMPTS = 400
+PAIR_ATTEMPTS = 200
+
+
+def _mask_from_coords(size: int, coords: list[tuple[int, int]]) -> np.ndarray:
