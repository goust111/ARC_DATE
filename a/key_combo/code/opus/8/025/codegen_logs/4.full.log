+            _mask_from_coords(5, [(0, 2), (2, 0), (2, 4), (4, 2)]),
+            _mask_from_coords(5, [(1, 1), (1, 3), (3, 1), (3, 3)]),
+            _mask_from_coords(5, [(2, 2)]),
