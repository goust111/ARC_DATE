+            _mask_from_coords(7, [(0, 3), (3, 0), (3, 6), (6, 3)]),
+            _mask_from_coords(7, [(1, 3), (3, 1), (3, 5), (5, 3)]),
+            _mask_from_coords(7, [(2, 2), (2, 4), (3, 3), (4, 2), (4, 4)]),
