from arc_utils import Color, bbox_h, bbox_w, find_components, get_bg, neighbors4


PALETTE = [Color.BLUE, Color.RED, Color.GREEN, Color.YELLOW, Color.GREY, Color.ORANGE, Color.TEAL, Color.MAROON]
GRID_H_RANGE = (17, 24)
GRID_W_RANGE = (16, 24)
