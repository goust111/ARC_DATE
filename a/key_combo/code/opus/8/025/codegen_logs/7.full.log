+            0 <= nr < grid.shape[0]
+            and 0 <= nc < grid.shape[1]
+            and grid[nr, nc] != Color.BLACK
+            for nr, nc in neighbors4(r, c)
+        ):
+            continue
+        color = random.choice(color_pool)
+        grid[r, c] = int(color)
+        placed += 1
+
