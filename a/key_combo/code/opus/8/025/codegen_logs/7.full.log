        if not any(rect["d"] < rect["h"] for rect in scene["rectangles"]):
            continue

        out = main(grid)
        _validate_output(grid, out)
        assert max(grid.shape) <= 30 and max(out.shape) <= 30
        return grid

    raise RuntimeError("failed to generate a valid puzzle instance")

