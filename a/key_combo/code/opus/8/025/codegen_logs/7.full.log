+                "color": color,
+                "bbox": (r0, c0, r1, c1),
+                "r0": r0,
+                "c0": c0,
+                "r1": r1,
+                "c1": c1,
+                "h": h,
+                "w": w,
+                "d": d,
+                "mirror_top": mirror_top,
+                "mirror_bottom": mirror_bottom,
+            }
