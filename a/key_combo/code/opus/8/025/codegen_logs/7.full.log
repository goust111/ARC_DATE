+def _composition(total: int, parts: int) -> list[int]:
+    if total == 0:
+        return [0] * parts
+    cuts = sorted(random.sample(range(total + parts - 1), parts - 1))
+    values: list[int] = []
+    prev = -1
+    for cut in cuts + [total + parts - 1]:
+        values.append(cut - prev - 1)
+        prev = cut
+    return values
