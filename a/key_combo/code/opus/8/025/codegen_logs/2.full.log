+
+
+def _make_connected_shape(
+    allowed_cells: list[tuple[int, int]],
+    target_area: int,
+    center_r: int,
+    center_c: int,
+    quadrant: str,
+    force_axis_touch: bool,
+) -> set[tuple[int, int]] | None:
+    allowed = set(allowed_cells)
+    axis_cells = {
+        (r, c)
+        for r, c in allowed
+        if r == center_r or c == center_c
