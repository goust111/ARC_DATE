+    h, w = shape
+    caps = _axis_capacities(h, w, center_r, center_c)
+    cells: list[tuple[int, int]] = []
+
+    if quadrant in ("UL", "UR"):
+        row_offsets = range(0, min(caps["top"], max_row_span) + 1)
+    else:
+        row_offsets = range(1, min(caps["bottom"], max_row_span) + 1)
