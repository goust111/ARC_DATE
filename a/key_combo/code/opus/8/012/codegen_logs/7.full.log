def _pick_segments(
    full: np.ndarray,
    missing_bbox: tuple[int, int, int, int],
) -> tuple[np.ndarray, np.ndarray] | None:
    n = full.shape[0]
    missing_mask = np.zeros((n, n), dtype=bool)
    r0, c0, r1, c1 = missing_bbox
    missing_mask[r0 : r1 + 1, c0 : c1 + 1] = True
    missing_area = int(missing_mask.sum())

