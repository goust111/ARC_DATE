+    candidates[0]["body_mask"] = body_mask
+    candidates[0]["shape_key"] = _canonical_shape_key(body_mask)
+    return candidates[0]
+
+
+def _parse_movers(grid: np.ndarray) -> list[dict]:
+    movers = []
