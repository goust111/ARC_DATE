+                placed.append(
+                    {
+                        "color": plan["color"],
+                        "body": body,
+                        "attach_row": attach_row,
+                        "rod_len": rod_len,
+                        "top": top,
+                        "left": left,
+                        "bracket_idx": bracket_idx,
+                        "is_match": plan["is_match"],
+                        "shape_key": _canonical_shape_key(body),
+                        "template_key": template_key,
