+                    "body_coords": body_coords_local + np.array([[r0, c0]]),
+                    "rod_coords": np.argwhere(rod) + np.array([[r0, c0]]),
+                    "body_mask": body,
+                    "rod_len": rod_len,
+                    "attach_row": r0 + row,
