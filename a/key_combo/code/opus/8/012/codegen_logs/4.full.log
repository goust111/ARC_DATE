+            continue
+        cols = np.flatnonzero(local[row])
+        for start in cols:
+            rod_len = max_c - start + 1
+            if not 1 <= rod_len <= 4:
+                continue
+            rod = np.zeros_like(local, dtype=bool)
+            rod[row, start : max_c + 1] = True
+            if np.any(local[:, start:] & ~rod[:, start:]):
+                continue
+            if not local[row, start - 1]:
+                continue
