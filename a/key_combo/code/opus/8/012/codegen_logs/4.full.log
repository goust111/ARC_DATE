+    if sum(int(spec["is_match"]) for spec in placed) != match_count:
+        return None
+    if len({spec["shape_key"] for spec in placed if spec["is_match"]}) != 1:
+        return None
+    if any(spec["shape_key"] == template_key for spec in placed if not spec["is_match"]):
+        return None
