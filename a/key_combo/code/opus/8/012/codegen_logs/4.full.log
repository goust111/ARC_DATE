+        return None
+
+    return {
+        "grid": grid,
+        "template_mask": template_mask,
+        "template_key": template_key,
+        "frame_bbox": frame_bbox,
+        "brackets": brackets,
+        "objects": placed,
+    }
+
+
+def _expected_output_from_spec(spec: dict) -> np.ndarray:
+    out = spec["grid"].copy()
