+            oriented = _rand_variant(base)
+            bracket_idx = random.randrange(bracket_count)
+        attach_options = _attach_rows(oriented)
+        if not attach_options:
+            return None
+        attach_row = random.choice(attach_options)
+        rod_len = random.randint(1, 4)
+        br0, bc0, br1, _bc1 = brackets[bracket_idx]["bbox"]
+        body_h, body_w = oriented.shape
+        top_lo = br0 + 1
+        top_hi = br1 - body_h
+        if top_lo > top_hi:
+            return None
+        top = random.randint(top_lo, top_hi)
+        body_right = bc0 - rod_len - 1
+        left = body_right - body_w + 1
+        if left <= fc1 + 1:
+            return None
+        specs.append(
+            {
+                "color": colors[i],
+                "body": oriented,
+                "attach_row": attach_row,
+                "rod_len": rod_len,
+                "top": top,
+                "left": left,
+                "bracket_idx": bracket_idx,
+                "is_match": is_match,
+                "shape_key": _canonical_shape_key(oriented),
+                "template_key": template_key,
+            }
+        )
+
+    occupied = set(map(tuple, np.argwhere(grid != BG)))
+    padded = _neighborhood(list(occupied), height, width, pad=1)
+    placed = []
+    random.shuffle(specs)
+    for spec in specs:
+        body_cells, rod_cells = _object_cells(spec["top"], spec["left"], spec["body"], spec["rod_len"], spec["attach_row"])
+        all_cells = body_cells + rod_cells
+        if any(not (0 <= r < height and 0 <= c < width) for r, c in all_cells):
+            return None
+        if any((r, c) in occupied for r, c in all_cells):
+            return None
+        if any((r, c) in padded for r, c in all_cells):
+            return None
+        _place_cells(grid, all_cells, spec["color"])
+        occupied.update(all_cells)
+        padded |= _neighborhood(all_cells, height, width, pad=1)
