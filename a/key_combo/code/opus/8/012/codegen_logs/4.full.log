+    placed = []
+    random.shuffle(specs)
+    for spec in specs:
+        body_cells, rod_cells = _object_cells(spec["top"], spec["left"], spec["body"], spec["rod_len"], spec["attach_row"])
+        all_cells = body_cells + rod_cells
+        if any(not (0 <= r < height and 0 <= c < width) for r, c in all_cells):
