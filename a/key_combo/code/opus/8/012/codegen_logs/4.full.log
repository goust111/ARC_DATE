+
+def _draw_l_frame(grid: np.ndarray, top: int, left: int, h: int, w: int) -> tuple[int, int, int, int]:
+    grid[top : top + h, left + w - 1] = GREY
+    grid[top + h - 1, left : left + w] = GREY
+    return top, left, top + h - 1, left + w - 1
