+            for cc in range(start, max_c + 1):
+                if row > 0 and local[row - 1, cc]:
+                    vertical_ok = False
+                if row + 1 < local.shape[0] and local[row + 1, cc]:
+                    vertical_ok = False
+            if not vertical_ok:
