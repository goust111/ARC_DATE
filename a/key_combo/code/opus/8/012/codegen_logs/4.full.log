+
+
+def _draw_bracket(grid: np.ndarray, top: int, left: int, h: int) -> tuple[int, int, int, int]:
+    right = left + BRACKET_WIDTH - 1
+    grid[top, left : right + 1] = PINK
+    grid[top + h - 1, left : right + 1] = PINK
