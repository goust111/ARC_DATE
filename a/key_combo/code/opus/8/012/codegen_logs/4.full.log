+    candidates = []
+    for row in range(local.shape[0]):
+        if not local[row, max_c]:
+            continue
+        cols = np.flatnonzero(local[row])
+        for start in cols:
+            if start >= max_c:
+                continue
+            rod_len = max_c - start + 1
+            if not 1 <= rod_len <= 4:
