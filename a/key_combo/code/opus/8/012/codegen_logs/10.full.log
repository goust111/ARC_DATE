20:def main(grid: np.ndarray) -> np.ndarray:
21:    """
22:    Return the missing rectangular patch by completing the square's full reflection symmetry.
23:
24:    Input structure:
25:    - A square patterned grid has one solid rectangular region of black missing pixels.
26:    - Outside that missing rectangle, the pattern obeys the same value under all eight square symmetries.
27:
28:    Rule:
29:    - Find the bounding box of the black missing region.
30:    - For each missing pixel, inspect its D4 symmetry orbit across horizontal, vertical, and diagonal reflections.
31:    - Copy the unique non-black value found elsewhere in that orbit into the corresponding output cell.
32:
33:    Key insight:
34:    - The output is not the repaired full grid; it is exactly the hidden rectangle, and every hidden value is determined by its symmetric copies.
35:    """
36:    g = np.asarray(grid, dtype=int)
37:    assert g.ndim == 2, "expected a 2D grid"
38:    height, width = map(int, g.shape)
39:    assert height == width, "expected a square grid"
40:
41:    missing = g == 0
42:    missing_bbox = bbox(missing)
43:    assert missing_bbox is not None, "expected one black missing region"
44:    r0, c0, r1, c1 = missing_bbox
45:    patch_h = r1 - r0 + 1
46:    patch_w = c1 - c0 + 1
47:    assert int(missing.sum()) == patch_h * patch_w, "missing pixels must form a solid rectangle"
48:
49:    out = np.zeros((patch_h, patch_w), dtype=int)
50:    for r in range(r0, r1 + 1):
51:        for c in range(c0, c1 + 1):
52:            values = {
53:                int(g[rr, cc])
54:                for rr, cc in _d4_orbit(r, c, height)
55:                if int(g[rr, cc]) != 0
56:            }
57:            assert len(values) == 1, "each missing pixel must have one symmetric value"
58:            out[r - r0, c - c0] = values.pop()
59:
60:    return out
