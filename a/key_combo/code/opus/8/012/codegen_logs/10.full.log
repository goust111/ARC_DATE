401:            b = g[r0 + dr : r1 + dr, c0 + dc : c1 + dc]
402:            visible = (a != GEN_BACKGROUND) & (b != GEN_BACKGROUND)
403:            support = int(np.count_nonzero(visible))
404:            if support == 0:
405:                continue
406:            if not np.all(a[visible] == b[visible]):
407:                continue
408:            if support > best_support:
409:                best_support = support
410:                best = [(dr, dc)]
411:            elif support == best_support:
412:                best.append((dr, dc))
