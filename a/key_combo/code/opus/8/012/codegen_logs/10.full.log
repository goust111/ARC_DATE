82:def main(grid: np.ndarray) -> np.ndarray:
83:    """
84:    Slide the rectangular body of the non-rectangular foreground object along its straight stem until it touches the rectangular anchor.
85:
86:    Input structure
87:    - A black-background grid with exactly two foreground colors.
88:    - One foreground color is a solid rectangular anchor object.
89:    - The other foreground color is one connected object made from a unique largest
90:      solid rectangular body plus a straight one-cell-wide connector stem.
91:    Rule
92:    - Erase the whole non-rectangular object.
93:    - Translate only its rectangular body along the connector direction by the
94:      connector length, so the body lands next to the anchor.
95:    Key insight
96:    - The connector is not kept; it is a path telling how far and in which
97:      direction the solid body should slide.
98:    """
99:    g = np.asarray(grid, dtype=int)
100:    assert g.ndim == 2, "expected a 2D grid"
101:    bg = get_bg(g)
102:
103:    colors = colors_present(g, exclude={bg})
104:    assert len(colors) == 2, "expected exactly two foreground colors"
105:    masks = {color: g == color for color in colors}
106:
107:    rectangular = {color: _is_solid_rectangle(mask) for color, mask in masks.items()}
108:    moving_colors = [color for color in colors if not rectangular[color]]
109:    anchor_colors = [color for color in colors if rectangular[color]]
110:    assert len(moving_colors) == 1, "expected one non-rectangular moving object"
111:    assert len(anchor_colors) == 1, "expected one rectangular anchor object"
112:
113:    moving_color = moving_colors[0]
114:    anchor_color = anchor_colors[0]
115:    moving_mask = masks[moving_color]
116:    assert len(components_mask(moving_mask, connectivity=4)) == 1, "moving object must be 4-connected"
117:    body_box = _largest_solid_rectangle(moving_mask)
118:    r0, c0, r1, c1 = body_box
119:
120:    body_mask = np.zeros_like(moving_mask)
121:    body_mask[r0 : r1 + 1, c0 : c1 + 1] = True
122:    stem = moving_mask & ~body_mask
123:    dr, dc, distance = _stem_shift(stem, body_box)
124:
125:    body_rows, body_cols = np.where(body_mask)
126:    new_rows = body_rows + dr * distance
127:    new_cols = body_cols + dc * distance
128:    h, w = g.shape
129:    assert np.all((0 <= new_rows) & (new_rows < h) & (0 <= new_cols) & (new_cols < w)), "moved body must stay in bounds"
130:    assert _touches_anchor(new_rows, new_cols, masks[anchor_color]), "moved body must land adjacent to the anchor"
131:
132:    out = g.copy()
133:    out[moving_mask] = bg
134:    assert np.all(out[new_rows, new_cols] == bg), "moved body must land on background after erasing its source object"
135:    out[new_rows, new_cols] = moving_color
136:    return out
