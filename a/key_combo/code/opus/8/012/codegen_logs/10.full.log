50:def main(grid: np.ndarray) -> np.ndarray:
51:    """Fill black gaps by propagating the maximally supported repeating translation.
52:
53:    Input structure
54:    A same-size colored periodic field contains black pixels that mark missing cells.
55:    All non-black pixels are already correct and provide many repeated-color pairs.
56:
57:    Rule
58:    Find the nonzero translation vector whose overlapping visible cells have the
59:    largest support with no color disagreements.  Cells connected by this vector
60:    and its inverse are one periodic equivalence class; replace each black cell by
61:    the unique visible color in its class.
62:
63:    Key insight
64:    The occlusions hide a repeated lattice, and the strongest self-translation of
65:    the visible pixels identifies exactly how to copy colors through the gaps.
66:    """
67:    g = np.asarray(grid, dtype=int)
68:    missing_color = Color.BLACK
69:    assert np.any(g == missing_color)
70:
71:    h, w = g.shape
72:    shifts = _max_supported_translations(g, missing_color)
73:
74:    parent = list(range(h * w))
75:
76:    def find(x: int) -> int:
77:        while parent[x] != x:
78:            parent[x] = parent[parent[x]]
79:            x = parent[x]
80:        return x
81:
82:    def union(a: int, b: int) -> None:
83:        ra = find(a)
84:        rb = find(b)
85:        if ra != rb:
86:            parent[rb] = ra
87:
88:    for dr, dc in shifts:
89:        r0, r1, c0, c1 = _overlap_slices(g.shape, dr, dc)
90:        for r in range(r0, r1):
91:            rr = r + dr
92:            for c in range(c0, c1):
93:                union(r * w + c, rr * w + c + dc)
94:
95:    colors_by_root: dict[int, set[int]] = {}
96:    for r in range(h):
97:        for c in range(w):
98:            color = int(g[r, c])
99:            if color == missing_color:
100:                continue
101:            root = find(r * w + c)
102:            colors_by_root.setdefault(root, set()).add(color)
103:
104:    assert all(len(colors) == 1 for colors in colors_by_root.values())
105:
106:    out = g.copy()
107:    for r, c in np.argwhere(g == missing_color):
108:        colors = colors_by_root.get(find(int(r) * w + int(c)), set())
109:        assert len(colors) == 1
110:        out[int(r), int(c)] = next(iter(colors))
111:
112:    return out
