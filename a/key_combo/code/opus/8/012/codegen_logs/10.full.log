+    tile_h, tile_w = tile.shape
+    reps_h = (out_h + tile_h - 1) // tile_h
+    reps_w = (out_w + tile_w - 1) // tile_w
+    return np.tile(tile, (reps_h, reps_w))[:out_h, :out_w].copy()
