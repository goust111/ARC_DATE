53:def main(grid: np.ndarray) -> np.ndarray:
54:    """Summarize a gridded table of colored square sprites as count bars ordered by increasing count.
55:
56:    Input structure
57:    The input is a table on a dominant background. A unique non-background color
58:    forms full horizontal and vertical gridline bars. Each occupied table cell
59:    contains one solid 2 by 2 square sprite, and some sprites may use the same
60:    color as the gridline.
61:
62:    Rule
63:    Ignore empty cells and ignore sprites whose color is the gridline color. For
64:    every other sprite color, count how many table cells contain that color.
65:    Create one output row per counted color, sorted by increasing count; each row
66:    is a left-aligned horizontal bar of that color with length equal to its
67:    count, padded with background to the maximum count.
68:
69:    Key insight
70:    The large grid is only a frequency table: the separator color is not part of
71:    the histogram, even when it appears as a cell sprite.
72:    """
73:    g = np.asarray(grid, dtype=int)
74:    assert g.ndim == 2
75:
76:    bg = get_bg(g)
77:    separator, row_bars, col_bars = _separator_color(g, bg)
78:
79:    counts: Counter[int] = Counter()
80:    for r0, r1 in _spans(g.shape[0], row_bars):
81:        for c0, c1 in _spans(g.shape[1], col_bars):
82:            color = _single_cell_color(g[r0:r1, c0:c1], bg)
83:            if color is not None and color != separator:
84:                counts[color] += 1
85:
86:    assert counts, "expected at least one non-separator sprite color"
87:    assert len(set(counts.values())) == len(counts), "sprite color counts must be unique"
88:
89:    ordered = sorted(counts.items(), key=lambda item: item[1])
90:    out = np.full((len(ordered), max(counts.values())), bg, dtype=int)
91:    for r, (color, count) in enumerate(ordered):
92:        out[r, :count] = color
93:    return out
