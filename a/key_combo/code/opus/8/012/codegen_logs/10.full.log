16:def _max_supported_translations(g: np.ndarray, missing_color: int) -> list[tuple[int, int]]:
17:    h, w = g.shape
18:    best_support = 0
19:    best: list[tuple[int, int]] = []
20:
21:    for dr in range(-(h - 1), h):
22:        for dc in range(-(w - 1), w):
23:            if dr == 0 and dc == 0:
24:                continue
25:            r0, r1, c0, c1 = _overlap_slices(g.shape, dr, dc)
26:            if r0 >= r1 or c0 >= c1:
27:                continue
28:
29:            a = g[r0:r1, c0:c1]
30:            b = g[r0 + dr : r1 + dr, c0 + dc : c1 + dc]
31:            visible = (a != missing_color) & (b != missing_color)
32:            support = int(np.count_nonzero(visible))
33:            if support == 0:
34:                continue
35:            if not np.all(a[visible] == b[visible]):
36:                continue
37:
38:            if support > best_support:
39:                best_support = support
40:                best = [(dr, dc)]
41:            elif support == best_support:
42:                best.append((dr, dc))
43:
44:    assert best_support > 0
45:    assert len(best) == 2
46:    assert best[0] == (-best[1][0], -best[1][1])
47:    return best
