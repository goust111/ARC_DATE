+def _repair_left_square(left: np.ndarray) -> tuple[np.ndarray, np.ndarray, tuple[int, int, int, int]]:
+    n = int(left.shape[0])
+    assert left.shape == (n, n), "left region must be square"
+    assert n % 2 == 1, "left square must have odd side length"
