6:def _d4_orbit(r: int, c: int, n: int) -> set[tuple[int, int]]:
7:    last = n - 1
8:    return {
9:        (r, c),
10:        (r, last - c),
11:        (last - r, c),
12:        (last - r, last - c),
13:        (c, r),
14:        (c, last - r),
15:        (last - c, r),
16:        (last - c, last - r),
17:    }
