270:def _gen_split_total(total, k, lo=GEN_BLOB_AREA_RANGE[0], hi=GEN_BLOB_AREA_RANGE[1]):
271:    sizes = [lo] * k
272:    remaining = total - lo * k
273:    order = list(range(k))
274:    random.shuffle(order)
275:    for pos, idx in enumerate(order[:-1]):
276:        cap = min(hi - lo, remaining)
277:        max_add = min(cap, remaining)
278:        add = random.randint(0, max_add)
279:        sizes[idx] += add
280:        remaining -= add
281:    sizes[order[-1]] += remaining
282:    if any(s < lo or s > hi for s in sizes):
283:        return None
284:    random.shuffle(sizes)
285:    return sizes
