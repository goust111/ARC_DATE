7:def _overlap_slices(shape: tuple[int, int], dr: int, dc: int):
8:    h, w = shape
9:    r0 = max(0, -dr)
10:    r1 = min(h, h - dr)
11:    c0 = max(0, -dc)
12:    c1 = min(w, w - dc)
13:    return r0, r1, c0, c1
