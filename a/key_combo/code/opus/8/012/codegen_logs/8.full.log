def _gen_paint_bar(grid, pivot_r, pivot_c, dr, dc, length, color):
    for k in range(1, length + 1):
        grid[pivot_r + k * dr, pivot_c + k * dc] = color


def _gen_attempt():
    H = random.randint(*GRID_ROWS)
    W = random.randint(*GRID_COLS)
