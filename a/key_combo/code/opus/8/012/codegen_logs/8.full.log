    length = random.randint(BAR_LENGTH[0], max_len)
    dr, dc = random.choice(DIRECTIONS)
    rot_dr, rot_dc = dc, -dr

    min_r = 0
    max_r = H - 1
    min_c = 0
    max_c = W - 1
    for vr, vc in ((dr, dc), (rot_dr, rot_dc)):
