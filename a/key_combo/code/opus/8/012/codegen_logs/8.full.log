        for b in GEN_REDUCED_COEFF_RANGE:
            if a == 0 and b == 0:
                continue
            vec = (a * v1[0] + b * v2[0], a * v1[1] + b * v2[1])
            if vec == v1 or vec == (-v1[0], -v1[1]):
                continue
            if vec == (0, 0):
