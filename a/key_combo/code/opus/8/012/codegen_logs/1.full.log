+def _trace_path(
+    height: int,
+    width: int,
+    source_col: int,
+    obstacle_by_cell: dict[tuple[int, int], tuple[int, int]],
+) -> tuple[list[tuple[int, int]], int]:
+    r = 0
+    c = int(source_col)
+    cells = [(0, c)]
+    hits = 0
+    seen_states = {(r, c, hits)}
