+    while r < height - 1:
+        below = (r + 1, c)
+        if below not in obstacle_by_cell:
+            r += 1
+            cells.append((r, c))
+        else:
+            hits += 1
+            left, right = obstacle_by_cell[below]
+            side_col = _nearest_outside(c, left, right, width)
