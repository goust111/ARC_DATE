    out[g == Color.RED] = Color.GREEN

    rotated_dr, rotated_dc = dc, -dr
    H, W = g.shape
    for k in range(1, length + 1):
        r = pivot_r + k * rotated_dr
        c = pivot_c + k * rotated_dc
        assert 0 <= r < H and 0 <= c < W
        assert int(g[r, c]) == bg
        out[r, c] = Color.RED

    return out

