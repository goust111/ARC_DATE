+    for obstacle in obstacles:
+        row = obstacle["row"]
+        left = obstacle["left"]
+        right = obstacle["right"]
+        assert row > 0
+        assert 1 <= left <= right <= width - 2
+        assert 2 <= right - left + 1 <= 5
+        for col in range(left, right + 1):
