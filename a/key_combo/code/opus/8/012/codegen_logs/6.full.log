+
+def _simulate(
+    grid: np.ndarray,
+    *,
+    repair: bool,
+    bottom_first: bool,
+) -> np.ndarray:
+    g = np.asarray(grid, dtype=int)
+    field_mask = np.isin(g, BACKGROUND_COLORS)
+    field_box = bbox(field_mask)
+    assert field_box is not None
