+    for spec, lift in zip(specs, lifts):
+        spec["lift"] = lift
+        spec["input_top"] = spec["final_top"] - lift
+        spec["input_left"] = spec["final_left"]
+        spec["input_coords"] = _shape_coords(spec["shape"], spec["input_top"], spec["input_left"])
+        h, w = spec["shape"].shape
+        spec["input_bbox"] = (
