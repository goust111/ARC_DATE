+def _has_smaller_period(tile: np.ndarray, ph: int, pw: int) -> bool:
+    for sh in range(1, ph + 1):
+        for sw in range(1, pw + 1):
+            if sh == ph and sw == pw:
+                continue
+            if ph % sh != 0 or pw % sw != 0:
+                continue
+            ok = True
+            for r in range(ph):
+                for c in range(pw):
+                    if int(tile[r, c]) != int(tile[r % sh, c % sw]):
+                        ok = False
+                        break
+                if not ok:
+                    break
+            if ok:
+                return True
+    return False
+
