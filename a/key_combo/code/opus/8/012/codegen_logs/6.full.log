+                "color": int(comp["color"]),
+                "coords": coords,
+                "bbox": (int(r0), int(c0), int(r1), int(c1)),
+                "shape": np.asarray(grid, dtype=int)[r0 : r1 + 1, c0 : c1 + 1] == int(comp["color"]),
