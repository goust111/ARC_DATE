+    for obj in ordered:
+        coords = np.array(obj["coords"], dtype=int)
+        while True:
+            shifted = coords + np.array([1, 0], dtype=int)
+            if int(shifted[:, 0].max()) >= scene.shape[0]:
+                break
+            if any(int(scene[r, c]) != Color.BLACK for r, c in shifted):
+                break
+            coords = shifted
+        scene[coords[:, 0], coords[:, 1]] = obj["color"]
+    return scene
