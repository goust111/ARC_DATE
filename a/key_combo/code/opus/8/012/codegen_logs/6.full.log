+
+def _under_color(
+    r: int,
+    c: int,
+    field_box: tuple[int, int, int, int],
+    classes: dict[tuple[int, int], int],
+) -> int:
+    if not _inside(field_box, r, c):
+        return Color.BLACK
+    ph = 1 + max(key[0] for key in classes)
+    pw = 1 + max(key[1] for key in classes)
+    return classes[(r % ph, c % pw)]
+
+
+def _simulate(
+    grid: np.ndarray,
+    *,
+    repair: bool,
+    bottom_first: bool,
+) -> np.ndarray:
