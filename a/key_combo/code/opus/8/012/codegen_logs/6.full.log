+        return None
+    iph, ipw, _classes = _infer_period(inp, field_box)
+    if (iph, ipw) != (ph, pw):
+        return None
+
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        grid = _attempt_case()
+        if grid is not None:
+            return grid
+    raise RuntimeError("failed to generate a valid periodic-repair gravity input")

