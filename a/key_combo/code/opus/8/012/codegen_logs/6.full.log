+    for comp in find_components(
+        np.asarray(grid, dtype=int),
+        bg=Color.BLACK,
+        colors=list(FOREGROUND_COLORS),
+        connectivity=4,
+        monochromatic=True,
+    ):
+        r0, c0, r1, c1 = comp["bbox"]
+        coords = [(int(r), int(c)) for r, c in comp["coords"]]
+        objects.append(
