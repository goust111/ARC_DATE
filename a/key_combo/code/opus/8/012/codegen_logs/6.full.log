+    field_w = random.randint(max(pw + 5, 8), width)
+    field_r0 = random.randint(height - field_h - 2, height - field_h)
+    field_c0 = random.randint(0, width - field_w)
+    field_box = (field_r0, field_c0, field_r0 + field_h - 1, field_c0 + field_w - 1)
