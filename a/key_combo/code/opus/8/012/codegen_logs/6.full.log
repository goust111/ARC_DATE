+def _has_smaller_period(tile: np.ndarray, ph: int, pw: int) -> bool:
+    for sh in range(1, ph + 1):
+        for sw in range(1, pw + 1):
+            if sh == ph and sw == pw:
+                continue
+            if ph % sh != 0 or pw % sw != 0:
+                continue
