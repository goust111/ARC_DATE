+        return tile
+    raise RuntimeError("failed to build an exact-period tile")
+
+
+def _render_field(
+    shape: tuple[int, int],
+    field_box: tuple[int, int, int, int],
+    tile: np.ndarray,
+) -> np.ndarray:
+    out = np.zeros(shape, dtype=int)
+    r0, c0, r1, c1 = field_box
+    ph, pw = tile.shape
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
