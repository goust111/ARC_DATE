+    residue_counts: dict[tuple[int, int], int] = {}
+    for r in range(r0, r1 + 1):
+        for c in range(c0, c1 + 1):
+            key = (r % ph, c % pw)
+            residue_counts[key] = residue_counts.get(key, 0) + 1
