+    r0, c0, r1, c1 = field_box
+    ph, pw = tile.shape
+    field_area = (r1 - r0 + 1) * (c1 - c0 + 1)
+    min_holes = (field_area * 15 + 99) // 100
+    max_holes = (field_area * 30) // 100
