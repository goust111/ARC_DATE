+    random.shuffle(candidates)
+    for r, c in candidates:
+        if len(holes) >= target:
+            break
+        key = (r % ph, c % pw)
+        if residue_counts[key] <= 1:
+            continue
+        residue_counts[key] -= 1
+        holes.add((r, c))
+
