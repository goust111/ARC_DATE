+    th, tw = mask.shape
+    out = np.full((th * len(ring_infos), tw), BACKGROUND, dtype=int)
+    for idx, (_top, color) in enumerate(ring_infos):
+        patch = np.full((th, tw), BACKGROUND, dtype=int)
+        patch[mask] = int(color)
+        out[idx * th : (idx + 1) * th, :] = patch
