+from __future__ import annotations
+
+from collections import Counter, deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+TEMPLATE_COLOR = 5
+PALETTE = tuple(color for color in range(10) if color not in (BACKGROUND, TEMPLATE_COLOR))
+RING_COUNT = 3
+MAX_GENERATION_ATTEMPTS = 400
