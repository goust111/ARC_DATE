+                visited[r, c] = True
+                q.append((r, c))
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c):
+            if 0 <= nr < h and 0 <= nc < w and open_mask[nr, nc] and not visited[nr, nc]:
+                visited[nr, nc] = True
