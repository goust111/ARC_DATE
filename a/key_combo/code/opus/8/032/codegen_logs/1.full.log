155: def _consume_alias(kwargs: dict, primary: str, aliases: Sequence[str]):
156:     """
157:     Consume a keyword argument by primary name or any alias, ensuring no conflicts.
158: 
159:     Returns:
160:         (value, used_name) or (None, None) if not found.
161:     """
162:     used = None
163:     if primary in kwargs:
164:         used = primary
165:     else:
166:         for a in aliases:
167:             if a in kwargs:
168:                 used = a
169:                 break
170:     if used is None:
171:         return None, None
172:     val = kwargs.pop(used)
173:     names = [primary, *aliases]
174:     for n in names:
175:         if n != used and n in kwargs:
176:             raise TypeError(f"got multiple values for {primary}: {used} and {n}")
177:     return val, used
