+        return "up", r0 - r
+    if r0 <= r <= r1 and c > c1:
+        return "right", c - c1
+    if c0 <= c <= c1 and r > r1:
+        return "down", r - r1
+    if r0 <= r <= r1 and c < c0:
+        return "left", c0 - c
+    raise AssertionError("marker must lie on a cardinal ray of the grey block")
+
