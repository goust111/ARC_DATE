+
+TOP_COLOR = 1
+BOTTOM_COLOR = 2
+OVERLAP_COLOR = 4
+BACKGROUND = 0
+
+PANEL_SIZE_RANGE = (5, 10)  # sampled as [5, 9]
+AREA_RANGE = (5, 11)  # sampled as [5, 10]
