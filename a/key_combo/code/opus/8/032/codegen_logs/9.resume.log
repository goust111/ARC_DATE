+        mask[seed] = True
+        while int(mask.sum()) < area:
+            frontier = set()
+            current = np.argwhere(mask)
+            for r, c in current:
+                for nr, nc in _neighbors4(int(r), int(c), size):
+                    if not mask[nr, nc]:
