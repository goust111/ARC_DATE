+        "flipud": np.flipud(bottom_input_mask),
+        "fliplr": np.fliplr(bottom_input_mask),
+        "rot90": np.rot90(bottom_input_mask, 1),
+        "rot180": np.rot90(bottom_input_mask, 2),
+        "rot270": np.rot90(bottom_input_mask, 3),
