def _gen_symmetric_sprite(color: int) -> np.ndarray | None:
    h, w = _gen_pick_dims()
    q = (w + 1) // 2
    half = np.zeros((h, q), dtype=bool)

    bridge = (random.randrange(h), q - 1)
