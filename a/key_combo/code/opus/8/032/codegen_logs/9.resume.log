  grid: 10-12 rows x 10-11 cols, background 0
  sprite:
    size: 3x3, fully filled (no background pixels)
    colors: exactly 2 distinct non-bg non-marker colors [observed always 1 and 8]
    color_split: 3-6 pixels of one color, remainder of the other
    asymmetry: must NOT be invariant under any rot90 k=1,2,3
