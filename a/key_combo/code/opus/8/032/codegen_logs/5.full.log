spec:
  grid: 13-19 rows x 15-19 cols
  background: color 0 (black); must be the most common color [observed]
  rectangles:
    count: 1-4
    shape: solid filled axis-aligned rectangles, each a single non-bg color
    dimensions: each side 5-10 cells (minimum 3x3 required by solver)
    colors: each rectangle has a distinct non-bg color (1-9)
    placement: no bounding-box overlap; pairwise gap >= 2 in at least one axis [observed]
    may touch grid border [observed]
    bg fraction: 30-70% of total grid area [observed]
  transform:
    border: 1-cell-wide border of each rectangle preserved unchanged
    interior: cells where (row + col) parity == 0 relative to interior top-left become bg
    remaining interior cells keep original rectangle color (checkerboard pattern)

generation_strategy:
