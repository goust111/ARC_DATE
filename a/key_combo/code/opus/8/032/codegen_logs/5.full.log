+from __future__ import annotations
+
+import hashlib
+import random
+
+import numpy as np
+
+
+BG = 0
+LINE = 5
+RECT_COLOR_POOL = [1, 2, 3, 4, 6, 7, 8, 9]
+GEN_RETRIES = 600
+
+_SEEN_INPUT_HASHES: set[str] = set()
+_SEEN_OUTPUT_HASHES: set[str] = set()
