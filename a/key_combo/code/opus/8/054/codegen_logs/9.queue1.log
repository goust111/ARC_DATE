+    ar, ac = _template_anchor(template)
+    top = endpoint[0] - ar
+    left = endpoint[1] - ac
+    for r in range(h):
+        for c in range(w):
+            rr = top + r
+            cc = left + c
+            if 0 <= rr < out.shape[0] and 0 <= cc < out.shape[1]:
+                value = int(template[r, c])
+                out[rr, cc] = GREEN if value == BLUE else RED
