+
+def _quadrant_cells(
+    side: int,
+    center: tuple[int, int],
+    direction: tuple[int, int],
+    forbidden: set[tuple[int, int]],
+) -> list[tuple[int, int]]:
+    dr, dc = direction
+    cells = []
+    for r in range(side):
