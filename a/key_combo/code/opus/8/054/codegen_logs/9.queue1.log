# Canvas and panel geometry.
GRID_SHAPE, PANEL_SHAPE = (6, 9), (3, 3)
SOURCE_ROWS, SOURCE_COLS = slice(0, 3), slice(3, 6)
MARKER_ROWS, MARKER_COLS = slice(3, 6), SOURCE_COLS
