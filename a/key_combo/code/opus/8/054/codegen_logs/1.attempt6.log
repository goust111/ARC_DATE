+        r0, c0, r1, c1 = info["bbox"]
+        out_block = actual[r0 : r1 + 1, c0 : c1 + 1]
+        seen_output_blocks.add((out_block.shape, out_block.tobytes()))
+    if len(seen_output_blocks) != copy_count:
+        return None
