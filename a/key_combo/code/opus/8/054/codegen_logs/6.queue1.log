+    painted = np.asarray(tile, dtype=int).copy()
+    top_surface = int(surfaces[deepest_col])
+    painted[1:top_surface, deepest_col] = ORANGE
+    top_surface = int(surfaces[shallowest_col])
+    painted[1:top_surface, shallowest_col] = YELLOW
