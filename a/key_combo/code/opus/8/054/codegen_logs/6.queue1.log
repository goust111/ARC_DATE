+        diffs = np.diff(profile)
+        if int(profile.min()) == int(profile.max()):
+            continue
+        if np.count_nonzero(profile == int(profile.min())) != 1:
+            continue
+        if np.count_nonzero(profile == int(profile.max())) != 1:
