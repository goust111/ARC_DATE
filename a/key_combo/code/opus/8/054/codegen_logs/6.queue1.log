+    assert np.array_equal(composite[:tile_h, :tile_w], tile)
+    assert np.array_equal(composite[:tile_h, tile_w:], np.fliplr(tile))
+    assert np.array_equal(composite[tile_h:, :], np.flipud(composite[:tile_h, :]))
+
