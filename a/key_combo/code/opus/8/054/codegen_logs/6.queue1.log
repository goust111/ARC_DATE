+    top_surface = int(surfaces[shallowest_col])
+    painted[1:top_surface, shallowest_col] = YELLOW
+
+    tile_h = painted.shape[0]
+    marker_positions = [tuple(map(int, rc)) for rc in np.argwhere(painted == RED)]
