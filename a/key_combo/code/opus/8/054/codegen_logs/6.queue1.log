+def generate_input() -> np.ndarray:
+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        tile = _gen_attempt()
+        if tile is not None:
+            return tile
+    raise RuntimeError("failed to generate a valid mirrored-terrain input")

