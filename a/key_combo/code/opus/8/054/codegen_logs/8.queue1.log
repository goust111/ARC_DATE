+def _render_terrain(surface: np.ndarray, height: int) -> np.ndarray:
+    grid = np.full((height, int(surface.shape[0])), BG, dtype=int)
+    for c, start in enumerate(surface):
+        grid[int(start) :, int(c)] = TERRAIN
+    return grid
