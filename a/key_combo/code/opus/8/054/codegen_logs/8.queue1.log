+def _strictly_wrong_nearest_valley(
+    positions: list[tuple[int, int]],
+    patches: list[np.ndarray],
+    valleys: list[dict],
+) -> bool:
+    centers = [0.5 * (v["left"] + v["right"]) for v in valleys]
