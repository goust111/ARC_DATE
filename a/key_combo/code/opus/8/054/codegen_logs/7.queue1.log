+def _locate_panel(panels: list[list[tuple[int, int, int, int]]], r: int, c: int) -> tuple[int, int] | None:
+    for pr in range(2):
+        for pc in range(3):
+            r0, c0, r1, c1 = panels[pr][pc]
+            if r0 <= r <= r1 and c0 <= c <= c1:
