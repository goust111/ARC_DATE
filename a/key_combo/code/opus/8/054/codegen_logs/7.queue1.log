+            panel_r, panel_c = panel_rc
+
+            if nr != r:
+                selected_rows.add(panel_r)
+                axis = "row"
+            else:
+                selected_cols.add(panel_c)
+                axis = "col"
+
+            protrusions.append(
+                {
+                    "pixel": (r, c),
+                    "neighbor": (nr, nc),
+                    "panel": panel_rc,
+                    "axis": axis,
