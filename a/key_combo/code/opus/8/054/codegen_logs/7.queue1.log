spec:
  grid:
    separator_color: 0 (always black)
    separator_row_thickness: 2 [observed]
    separator_col_thickness: 1-2
    layout: 2 panel columns x 2-4 row bands, all panels identical shape
  panels:
    shape: 6-8 rows x 7-8 cols, uniform across entire grid
    each_panel: exactly 2 colors -- dominant base color (>=70% cells) and 1 minority motif color
    motif_fraction: 10-31% of panel cells
    motif_border: never touches panel edge (>=1 cell margin on all sides)
    motif_connectivity: usually 1 connected component, occasionally 2-4
  pair_colors:
