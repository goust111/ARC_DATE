+            return None
+
+        choices = list(frontier)
+        random.shuffle(choices)
+        pick = None
+        for cand in choices:
+            rr, cc = cand
+            border_penalty = int(rr in (0, height - 1)) + int(cc in (0, width - 1))
+            if required is None and border_penalty == 2:
