+    if side == "top":
+        cc = random.randint(1, panel_w - 2)
+        return (0, cc), (-1, 0)
+    if side == "bottom":
+        cc = random.randint(1, panel_w - 2)
+        return (panel_h - 1, cc), (1, 0)
