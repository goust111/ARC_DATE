+def _anchor_for_side(panel_h: int, panel_w: int, side: str) -> tuple[tuple[int, int], tuple[int, int]]:
+    if side == "left":
+        rr = random.randint(1, panel_h - 2)
+        return (rr, 0), (0, -1)
+    if side == "right":
+        rr = random.randint(1, panel_h - 2)
