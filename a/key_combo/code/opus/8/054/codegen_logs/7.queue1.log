+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+GREY = 5
+BLACK = 0
+BASE_PALETTE = (1, 2, 3, 4, 6, 7)
+MOTIF_PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GEN_ATTEMPTS = 500
