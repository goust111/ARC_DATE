+    protrusion_by_panel = {tuple(item["panel"]): item for item in protrusions}
+    masks: list[np.ndarray] = []
+    mask_keys: set[bytes] = set()
+    used_anchors: set[tuple[int, int, int, int]] = set()
+
+    for pr in range(2):
