+        grid[simple_obstacle] = OBSTACLE
+    elif random.random() < 0.5:
+        simple_obstacle = _find_single_detour_obstacle(grid)
+        if simple_obstacle is not None:
+            grid[simple_obstacle] = OBSTACLE
+
