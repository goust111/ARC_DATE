+        out[r, c] = MARKER
+
+        while r > 0:
+            above = (r - 1, c)
+            if above in occupied:
+                cause = "ray"
+            elif int(g[above]) == OBSTACLE:
+                cause = "obstacle"
+            else:
+                cause = None
+
+            if cause is None:
+                if int(g[above]) != BACKGROUND:
+                    clear_up_moves = False
+                r -= 1
+                path.append((r, c))
+                occupied.add((r, c))
+                out[r, c] = MARKER
+                continue
+
+            if cause == "obstacle":
+                obstacle_detours += 1
+            else:
+                ray_detours += 1
+
+            if c + 1 >= w:
+                break
+
+            landing = (r, c + 1)
+            if landing in occupied or int(g[landing]) != BACKGROUND:
+                clear_landings = False
+            c += 1
+            path.append((r, c))
+            detours.append((cause, (r, c)))
+            occupied.add((r, c))
+            out[r, c] = MARKER
+
