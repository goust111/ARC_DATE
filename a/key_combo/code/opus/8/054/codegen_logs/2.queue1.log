+    target_obstacles = random.randint(max(5, int(np.count_nonzero(grid == OBSTACLE))), 10)
+    if not _add_distractor_obstacles(grid, target_obstacles):
+        return None
+    if not _validate_case(grid, require_collision=include_collision):
+        return None
+    return grid
