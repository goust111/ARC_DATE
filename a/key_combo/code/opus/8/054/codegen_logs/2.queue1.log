+            trial = grid.copy()
+            trial[obstacle] = OBSTACLE
+            try:
+                _, ray_infos, stats = _simulate_rays(trial)
+            except AssertionError:
+                continue
+            if not stats["clear_up_moves"] or not stats["clear_landings"]:
+                continue
