+
+    if include_top_pair:
+        ef_pair = (min(color_map["E"], color_map["F"]), max(color_map["E"], color_map["F"]))
+        if ef_pair not in fills:
+            return False
+        if fills[ef_pair]["fill_color"] != GREY:
+            return False
+        if _new_pixels(grid, out, fills[ef_pair]["gap"]) <= 0:
