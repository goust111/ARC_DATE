+    if _overlap_area(boxes["B"], boxes["C"]) != 0:
+        raise AssertionError("bottom rectangles must stay disjoint")
+    if include_top_pair and _overlap_area(boxes["E"], boxes["F"]) != 0:
+        raise AssertionError("top pair must stay disjoint")
