+
+    layer0 = [("A", color_map["A"], boxes["A"]), ("B", color_map["B"], boxes["B"]), ("C", color_map["C"], boxes["C"])]
+    layer1 = [("D", color_map["D"], boxes["D"])]
+    layer2 = [("E", color_map["E"], boxes["E"])]
+    if include_top_pair:
