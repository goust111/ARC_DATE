+            return False
+    else:
+        if len(new_colors) < 1:
+            return False
+
+    return True
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_ATTEMPTS):
+        include_top_pair = random.random() < 0.7
+        try:
