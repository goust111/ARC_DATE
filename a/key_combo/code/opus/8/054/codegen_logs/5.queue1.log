+    row0 = max(left_box[0], right_box[0])
+    row1 = min(left_box[2], right_box[2])
+    if row0 > row1:
+        return None
+    gap = (row0, left_box[3] + 1, row1, right_box[1] - 1)
+    if gap[1] > gap[3]:
