+    depth = {color: 1 for color in colors}
+    for color in topo:
+        for nxt in above[color]:
+            depth[nxt] = max(depth[nxt], depth[color] + 1)
+
+    reach = {color: set() for color in colors}
+    for color in reversed(topo):
