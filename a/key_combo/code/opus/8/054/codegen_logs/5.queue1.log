+        e_end = c_e + w_e - 1
+        c_f = f_end = -1
+
+    boxes = {
+        "A": (bottom_r, c_a, bottom_r + bottom_h - 1, c_a + w_a - 1),
+        "B": (bottom_r, c_b, bottom_r + bottom_h - 1, c_b + w_b - 1),
+        "C": (bottom_r, c_c, bottom_r + bottom_h - 1, c_c + w_c - 1),
+        "D": (mid_r, c_d, mid_r + mid_h - 1, d_end),
+        "E": (top_r, c_e, top_r + top_h - 1, e_end),
