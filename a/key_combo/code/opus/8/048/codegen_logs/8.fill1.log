+
+
+def _parse_frames(grid: np.ndarray) -> list[dict]:
+    frames = []
+    for coords in _components(grid == FRAME):
+        parsed = _parse_single_frame(grid, _bbox_coords(coords))
+        if parsed is not None:
+            frames.append(parsed)
