+import itertools
+from collections import Counter
+
+import numpy as np
+
+
+BG = 0
+FRAME = 3
+ROW_COUNT = 4
+STRIPE_HEIGHT = 2
+PATTERN_WIDTH = 10
+GEN_ATTEMPTS = 400
+PALETTE = (1, 2, 4, 5, 6, 7, 8, 9)
