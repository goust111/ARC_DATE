+    full_cols = [c for c in range(sub.shape[1]) if np.all(sub[:, c] == FRAME)]
+    if len(full_rows) != ROW_COUNT + 1 or len(full_cols) != 2:
+        return None
+    if full_rows[0] != 0 or full_rows[-1] != sub.shape[0] - 1:
