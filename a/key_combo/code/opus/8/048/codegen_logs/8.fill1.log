+    slot_colors: list[int | None] = []
+    for i in range(ROW_COUNT):
+        slot = sub[full_rows[i] + 1 : full_rows[i + 1], full_cols[0] + 1 : full_cols[1]]
+        if slot.size == 0:
+            return None
+        colors = set(map(int, np.unique(slot)))
+        colors.discard(BG)
+        colors.discard(FRAME)
