+
+
+def _sample_masks(rng: np.random.Generator) -> list[np.ndarray] | None:
+    combos = [np.array(mask, dtype=bool) for mask in itertools.combinations(range(PATTERN_WIDTH), PATTERN_WIDTH // 2)]
+    masks = []
+    for cols in combos:
+        mask = np.zeros(PATTERN_WIDTH, dtype=bool)
+        mask[list(cols)] = True
+        masks.append(mask)
