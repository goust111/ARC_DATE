  rows:
    count: 3 [observed], each processed independently
    native_color: one dominant non-bg color per row; chosen as most frequent non-bg color, ties broken by leftmost first occurrence
    native_colors_per_example: 3 distinct colors, always {YELLOW, MAGENTA, AZURE} [observed]; any 3 distinct non-bg colors should work
    native_pixel_fraction: 30-70% of row width
    distractors: 0-2 distinct distractor colors per row, 0-3 distractor pixels per row
    distractor_colors: never overlap with any row's native color; may share across rows
    distractor_color_count_per_example: 0-2 distinct distractor colors total [observed]
  transform:
    per row, swap native-color pixels to bg and all other pixels (bg + distractors) to native color
