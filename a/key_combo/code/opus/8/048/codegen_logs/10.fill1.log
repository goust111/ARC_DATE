+def _right_runs(grid: np.ndarray) -> np.ndarray:
+    h, w = grid.shape
+    runs = np.ones((h, w), dtype=int)
+    for r in range(h):
+        for c in range(w - 2, -1, -1):
+            if int(grid[r, c]) == int(grid[r, c + 1]):
+                runs[r, c] = runs[r, c + 1] + 1
+    return runs
