+        c0, c0 + width - 1, active_cols, single_cols, marker_cols
+    )
+    if category == "active":
+        return has_active
+    if category == "single_only":
+        return has_single and not has_active
+    if category == "inactive_clear":
+        return not has_marker
+    if category == "mixed":
