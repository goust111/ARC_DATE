+            color = int(grid[r0, c0])
+            max_w = w - c0
+            for r1 in range(r0, h):
+                if int(grid[r1, c0]) != color:
+                    break
+                max_w = min(max_w, int(runs[r1, c0]))
+                if r1 - r0 + 1 >= min_side and max_w >= min_side:
+                    rects.add((r0, c0, r1, c0 + max_w - 1, color))
