+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+PINK = 6
+ORANGE = 7
+TEAL = 8
+MAROON = 9
+
+NOISE_PALETTE = (GREEN, PINK, ORANGE, TEAL, MAROON)
