+
+def _choose_spaced_columns(width: int, count: int) -> list[int] | None:
+    for _ in range(300):
+        cols = sorted(random.sample(range(width), count))
+        if all(cols[i + 1] - cols[i] >= GEN_COLUMN_GAP for i in range(len(cols) - 1)):
