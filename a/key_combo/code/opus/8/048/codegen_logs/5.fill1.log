    g = np.asarray(grid, dtype=int)
    bg = get_bg(g)
    colors = colors_present(g, exclude={bg})
    assert len(colors) == 1
    fg_color = colors[0]

    out = g.copy()
    for cells, color in _unique_tile_cover(g, fg_color):
        for r, c in cells:
            out[r, c] = color

    assert not np.any(out == fg_color)
    return out

