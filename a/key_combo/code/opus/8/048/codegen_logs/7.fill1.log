+    def distance_key(item):
+        _idx, piece, _placement = item
+        pr, pc = _bbox_center(piece["bbox"])
+        dist2 = (pr - object_center[0]) ** 2 + (pc - object_center[1]) ** 2
+        return (dist2, piece["bbox"])
