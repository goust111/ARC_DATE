+                pieces.append(
+                    {
+                        "coords": coords,
+                        "bbox": bbox,
+                        "anchor_cells": anchor_cells,
+                        "fill_cells": fill_cells,
+                        "fill_values": [int(grid[r, c]) for r, c in fill_cells],
+                    }
+                )
