+
+
+def _finalize_settled(settled: np.ndarray) -> tuple[np.ndarray, list[np.ndarray]]:
+    H, W = settled.shape
+    out = settled.copy()
+    holes = _closed_holes(settled)
+    hole_mask = np.zeros((H, W), dtype=bool)
+    for hole in holes:
+        hole_mask[hole[:, 0], hole[:, 1]] = True
