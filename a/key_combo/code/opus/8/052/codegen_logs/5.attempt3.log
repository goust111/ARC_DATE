+    side_scores: dict[str, list[tuple[str, int]]] = {"left": [], "right": []}
+    shuffled = list(range(len(records)))
+    random.shuffle(shuffled)
+    shuffled.sort(key=lambda i: 0 if records[i]["role"] == "anchor" else (1 if records[i]["role"] == "blocker" else 2))
