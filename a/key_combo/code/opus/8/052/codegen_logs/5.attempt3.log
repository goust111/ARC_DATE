+    holes = _closed_holes(settled)
+    if not holes:
+        return None
+    return settled, records
+
+
+def _shifted_coords(coords: np.ndarray, side: str, offset: int) -> np.ndarray:
+    out = coords.copy()
+    out[:, 1] += offset if side == "left" else -offset
+    return out
