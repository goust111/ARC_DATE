+    template_first = [int(out[0, tri_cols[0]]), int(out[0, tri_cols[1]])]
+    same_order = 0
+    swapped_order = 0
+    for r in range(2, 5):
+        row_first = [int(out[r, tri_cols[0]]), int(out[r, tri_cols[1]])]
+        if row_first == template_first:
