+    for i, height in enumerate(heights):
+        bottom = top + height - 1
+        patch[top, :] = BLUE
+        patch[bottom, :] = BLUE
+        patch[top : bottom + 1, 0] = BLUE
+        patch[top : bottom + 1, outer_w - 1] = BLUE
+        frames.append((top, bottom))
+        if i < hole_count - 1:
+            top = bottom + 1 + gaps[i]
