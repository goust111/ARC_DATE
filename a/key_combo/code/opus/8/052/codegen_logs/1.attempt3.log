+    max_c = int(blue_coords[:, 1].max())
+    axis_sum = min_c + max_c
+    out = grid.copy()
+    for r, c in blue_coords:
+        mc = axis_sum - int(c)
+        if 0 <= mc < grid.shape[1] and out[int(r), mc] == BLACK:
+            out[int(r), mc] = BLUE
+    return out
+
