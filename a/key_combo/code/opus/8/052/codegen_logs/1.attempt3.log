+    if grid.ndim != 2 or max(grid.shape) > 30:
+        return False
+    colors = set(map(int, np.unique(grid)))
+    if not colors <= {BLACK, BLUE, GREY} or BLUE not in colors or GREY not in colors:
+        return False
+    if _blue_component_count(grid) != 1:
+        return False
