+    if np.array_equal(full, _apply_transform(grid, info, do_fill=False)):
+        return False
+    if np.array_equal(full, _apply_transform(grid, info, do_erase=False)):
+        return False
+    if np.array_equal(full, _apply_transform(grid, info, do_move=False)):
+        return False
+    return True
+
