+
+    for col, height, marked in bar_specs:
+        top = sep_r - height
+        g[top:sep_r, col] = BAR
+        if marked:
+            g[top : top + height // 2, col] = MARK
+    return g
+
+
+def _generator_checks(grid: np.ndarray) -> bool:
+    try:
+        info = _analyze(grid)
+    except AssertionError:
+        return False
