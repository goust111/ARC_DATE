+        assert values[half:] == [BAR] * half, "marked bar lower half must stay blue"
+        marked = True
+    else:
+        assert all(v == BAR for v in values), "unmarked bars must be fully blue"
+        marked = False
+
+    return {
+        "col": int(col),
+        "top": int(rows[0]),
+        "rows": np.array(rows, dtype=int),
+        "height": int(height),
+        "marked": marked,
+    }
+
+
+def _analyze(grid: np.ndarray) -> dict:
