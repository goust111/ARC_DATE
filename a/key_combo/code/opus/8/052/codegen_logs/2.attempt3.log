    _gen_add_markers_9def23fe(out, bbox, marked)
    inp = _gen_input_from_output_9def23fe(out, bbox)
    try:
        solved = main(inp)
    except AssertionError:
        return None
    return inp if np.array_equal(solved, out) else None


def generate_input():
    for _ in range(_GEN_MAX_ATTEMPTS_9DEF23FE):
        grid = _gen_attempt()
        if grid is not None:
