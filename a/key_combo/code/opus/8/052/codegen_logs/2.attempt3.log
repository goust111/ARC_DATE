+    out_sig = _signature(main(inp))
+    if out_sig in _SEEN_OUTPUT_SIGNATURES:
+        return None
+    _SEEN_OUTPUT_SIGNATURES.add(out_sig)
+    return inp
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GEN_MAX_ATTEMPTS):
+        case = _generate_case()
+        if case is not None:
