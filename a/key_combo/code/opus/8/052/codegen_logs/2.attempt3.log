+def _density_bounds(total: int) -> tuple[int, int]:
+    lo = int(np.ceil(total * PANEL_FG_DENSITY_RANGE[0]))
+    hi = int(np.floor(total * PANEL_FG_DENSITY_RANGE[1]))
+    return lo, hi
+
