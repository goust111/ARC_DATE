+    for _ in range(MAX_GENERATION_ATTEMPTS):
+        phase = _GENERATION_PHASE % 4
+        shape = (
+            random.randint(*GRID_SIZE_RANGE),
+            random.randint(*GRID_SIZE_RANGE),
