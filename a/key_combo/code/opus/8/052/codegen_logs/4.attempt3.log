    r0, r1 = bar["r0"], bar["r1"]
    if start_from_top:
        return [r for r in range(r0, r1 + 1) if (r - r0) % 2 == 0]
    return [r for r in range(r0, r1 + 1) if (r1 - r) % 2 == 0]


