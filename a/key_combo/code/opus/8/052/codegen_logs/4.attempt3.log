+from __future__ import annotations
+
+import hashlib
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+
+
+GEN_ROWS_RANGE = (14, 20)
+GEN_COLS_RANGE = (17, 24)
+GEN_BAR_COUNT_RANGE = (5, 7)
+GEN_MIN_HEIGHT = 5
+GEN_MIN_BAR_GAP = 2
+GEN_RETRY_LIMIT = 800
