        def rec(rem, parts):
            if len(parts) == n_groups:
                if rem == 0:
                    options.append(tuple(parts))
                return
            for x in range(min_per_group, min(max_per_group, rem) + 1):
                rec(rem - x, parts + [x])

        rec(total, [])
    return list(options[int(np.random.randint(len(options)))])


