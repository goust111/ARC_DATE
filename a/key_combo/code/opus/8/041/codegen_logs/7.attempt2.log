            "shape_key": canonical_shape_key(mask)}


def _assign_columns(widths: list[int], W: int) -> list[int] | None:
    """Distribute components horizontally with random spacing (min gap = MIN_COL_GAP)."""
    n = len(widths)
    total = sum(widths) + MIN_COL_GAP * (n - 1)
    if total > W:
