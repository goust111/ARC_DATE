def _gen_count_blue_neighbors(g: np.ndarray, r: int, c: int) -> int:
    return sum(
        1
        for nr, nc in neighbors4(r, c)
        if in_bounds(g.shape, nr, nc) and g[nr, nc] == _GEN_BLUE
    )


