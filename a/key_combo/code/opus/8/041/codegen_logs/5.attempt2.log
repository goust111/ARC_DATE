+    if not candidates:
+        return None
+    dist, gr, gc, yr, yc = candidates[int(rng.integers(len(candidates)))]
+    out = half.copy()
+    out[gr, gc] = GREEN
+    out[yr, yc] = YELLOW
+    return out, dist
+
+
+def _make_marked_half(
