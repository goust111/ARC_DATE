+def _grow_polyomino(box_h: int, box_w: int, target_area: int, rng: np.random.Generator) -> set[tuple[int, int]]:
+    cells = {(int(rng.integers(box_h)), int(rng.integers(box_w)))}
+    while len(cells) < target_area:
+        frontier = sorted(
