+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+
+BLACK = 0
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+MAROON = 9
+
+_DIR_SEQUENCE = [
+    (-1, -1),
+    (0, 1),
+    (1, 0),
+    (1, 1),
+    (0, -1),
+    (-1, 0),
+    (1, -1),
+    (-1, 1),
+]
