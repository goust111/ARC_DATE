+    clean[green] = BLACK
+    clean[yellow] = BLACK
+    assert np.any(clean == ORANGE), "each half must contain an orange pattern"
+    assert _orange_component_count(clean) == 1, "each half must contain one orange component"
+    return clean, direction, distance
+
