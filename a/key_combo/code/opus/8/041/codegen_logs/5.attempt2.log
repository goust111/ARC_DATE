+        return None
+    marked_half, distance = marked
+    return marked_half, orange_half, distance
+
+
+def _direction_for_call() -> tuple[int, int]:
+    global _GEN_CALL_COUNT
+    direction = _DIR_SEQUENCE[_GEN_CALL_COUNT % len(_DIR_SEQUENCE)]
+    _GEN_CALL_COUNT += 1
+    return direction
+
+
