+    half_h = height // 2
+    top = g[:half_h, :]
+    bottom = g[half_h:, :]
+
+    top_clean, top_dir, _top_dist = _clean_and_analyze_half(top)
+    bottom_clean, bottom_dir, _bottom_dist = _clean_and_analyze_half(bottom)
