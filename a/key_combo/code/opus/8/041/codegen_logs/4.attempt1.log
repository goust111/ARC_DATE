+            elif int(grid[r, c]) == GREY:
+                assert int(out[r, c]) == BLACK
+            else:
+                assert int(out[r, c]) == int(grid[r, c])
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(400):
+        grid = _build_attempt()
+        if grid is None:
