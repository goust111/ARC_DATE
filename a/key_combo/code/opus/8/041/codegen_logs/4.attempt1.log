+
+def _semantic_validate_input(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int], list[TriangleInstruction], list[Domino]]:
+    colors = set(map(int, np.unique(grid)))
+    assert colors <= {BLACK, BLUE, RED, GREEN, GREY}
