+
+def triangle_sprites() -> list[np.ndarray]:
+    sprites: list[np.ndarray] = []
+    seen: set[tuple[tuple[int, ...], ...]] = set()
+    for size in (2, 3):
+        base = np.zeros((size, size), dtype=int)
+        for r in range(size):
+            for c in range(size):
+                if r <= c:
+                    base[r, c] = GREY
