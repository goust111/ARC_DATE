+def extract_instructions(grid: np.ndarray) -> tuple[np.ndarray, tuple[int, int], list[TriangleInstruction], list[Domino]]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    assert max(g.shape) <= 30
