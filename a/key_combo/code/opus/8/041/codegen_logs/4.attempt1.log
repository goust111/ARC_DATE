+    for size in (2, 3):
+        base = np.zeros((size, size), dtype=int)
+        for r in range(size):
+            for c in range(size):
+                if r <= c:
+                    base[r, c] = GREY
+        for k in range(4):
+            sprite = np.rot90(base, k=k)
+            key = tuple(tuple(int(v) for v in row) for row in sprite)
+            if key not in seen:
