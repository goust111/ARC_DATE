WALL_COL_MAX = 8
WALL_COL_GAP_MIN = 3
WALL_COL_GAP_MAX = 5
WALL_COL_PAIRS = tuple(
    (c0, c0 + gap)
    for c0 in range(WALL_COL_MIN, WALL_COL_MAX + 1)
    for gap in range(WALL_COL_GAP_MIN, WALL_COL_GAP_MAX + 1)
    if c0 + gap <= WALL_COL_MAX
)

# Marker count constraints.
ROW_MARKER_MIN = 2
ROW_MARKER_MAX = 4
COL_MARKER_MIN = 1
COL_MARKER_MAX = 3
TOTAL_MARKER_MIN = 11
