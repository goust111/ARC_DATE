+def _occupied_too_close(grid: np.ndarray, cells: list[tuple[int, int]], allowed_colors: set[int]) -> bool:
+    for r, c in cells:
+        for nr, nc in neighbors8(r, c):
+            if in_bounds(grid.shape, nr, nc) and int(grid[nr, nc]) not in allowed_colors:
+                return True
+    return False
