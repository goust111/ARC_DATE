+    distances = {pt: min(chebyshev(pt, bp) for bp in blue) for pt in pts}
+    max_dist = max(distances.values())
+    tips = [pt for pt, dist in distances.items() if dist == max_dist]
+    assert len(tips) == 1, "triangle tip must be unique"
