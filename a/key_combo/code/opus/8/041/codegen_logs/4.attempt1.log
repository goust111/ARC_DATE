+def sprite_cells(sprite: np.ndarray, top: int, left: int) -> list[tuple[int, int]]:
+    pts = []
+    for r, c in np.argwhere(sprite == GREY):
+        pts.append((top + int(r), left + int(c)))
+    return pts
