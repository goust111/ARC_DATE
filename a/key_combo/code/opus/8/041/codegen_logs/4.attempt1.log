+def _force_color_mix(count: int) -> list[int]:
+    colors = [random.choice((RED, GREEN)) for _ in range(count)]
+    if count >= 2 and random.random() < 0.7:
+        colors[0] = RED
+        colors[1] = GREEN
+        random.shuffle(colors)
+    return colors
