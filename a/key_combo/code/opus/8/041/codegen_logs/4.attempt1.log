+
+def _triangle_candidates(grid: np.ndarray,
+                         blue_coords: np.ndarray,
+                         slope: tuple[int, int],
+                         used_tip_rows: set[int],
+                         used_line_keys: set[int]) -> list[tuple[np.ndarray, tuple[int, int], int]]:
