+    r0 = random.randint(GEN_MARGIN, h - core_h - GEN_MARGIN)
+    c0 = random.randint(GEN_MARGIN, w - core_w - GEN_MARGIN)
+    core_bbox = (r0, c0, r0 + core_h - 1, c0 + core_w - 1)
+
+    features = _sample_feature_plan(core_bbox, (h, w))
