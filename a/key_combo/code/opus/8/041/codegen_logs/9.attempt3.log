+def _exterior_background(mask: np.ndarray) -> np.ndarray:
+    h, w = mask.shape
+    exterior = np.zeros((h, w), dtype=bool)
+    q: deque[tuple[int, int]] = deque()
+
+    for r in range(h):
+        for c in (0, w - 1):
+            if not bool(mask[r, c]) and not exterior[r, c]:
+                exterior[r, c] = True
