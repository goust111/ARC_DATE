+
+    features = _sample_feature_plan(core_bbox, (h, w))
+    if not features:
+        return None
+
+    mask = _build_input_mask((h, w), core_bbox, features)
+    if not _validate_example(mask, features):
+        return None
+    return mask.astype(int)
+
+
+def generate_input() -> np.ndarray:
