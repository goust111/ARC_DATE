+            touches_new_tab = any((nr, nc) in added_tabs for nr, nc in _neighbors8(r, c))
+            if touches_new_tab:
+                yellow.add((r, c))
+            else:
+                green.add((r, c))
+
+    return green, yellow
+
+
+def _count_components(mask: np.ndarray) -> int:
+    seen = np.zeros(mask.shape, dtype=bool)
+    n = 0
+    for r in range(mask.shape[0]):
+        for c in range(mask.shape[1]):
