+        if available_rows:
+            choices.append("row")
+        if available_cols:
+            choices.append("col")
+        if not choices:
+            return None
+        random.shuffle(choices)
+
+        placed = False
+        for axis in choices:
+            offsets = available_rows[:] if axis == "row" else available_cols[:]
+            random.shuffle(offsets)
+            sides = ["left", "right"] if axis == "row" else ["top", "bottom"]
+            for offset in offsets:
