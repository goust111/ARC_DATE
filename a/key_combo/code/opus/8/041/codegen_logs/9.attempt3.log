+
+    for feature in features:
+        sr, sc = feature["source"]
+        tr, tc = feature["target"]
+        if feature["kind"] == "tab":
+            if not mask[sr, sc] or mask[tr, tc] is False:
+                pass
+        else:
+            if mask[sr, sc] or completed[tr, tc] is False:
