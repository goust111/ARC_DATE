+        return None
+    sprite_r0 = random.randint(sprite_top_min, sprite_top_max)
+    sprite_c0 = random.randint(0, width - sw)
+
+    grid = np.zeros((height, width), dtype=int)
+    for r, gap in zip(chosen_rows, row_gaps):
+        c0, c1 = _cols_for_gap(width, gap)
+        grid[r, c0] = RED
+        grid[r, c1] = RED
