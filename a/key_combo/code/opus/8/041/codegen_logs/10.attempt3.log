+    h, w = random.choice(list(MASK_LIBRARY))
+    mask = random.choice(MASK_LIBRARY[(h, w)])
+    area = int(mask.sum())
+    color_count = 2 if area <= 4 else random.choice((2, 3))
+    palette = random.sample(SPRITE_COLORS, color_count)
+    sprite = np.zeros((h, w), dtype=int)
