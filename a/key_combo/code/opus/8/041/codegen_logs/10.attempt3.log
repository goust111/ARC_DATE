+    return [gap for gap in range(2, 7) if gap <= width - 2 and gap % 2 == parity]
+
+
+def _cols_for_gap(width: int, gap: int) -> tuple[int, int]:
+    c0 = (width - gap - 2) // 2
+    c1 = width - 1 - c0
+    return int(c0), int(c1)
+
+
+def _make_case() -> np.ndarray | None:
