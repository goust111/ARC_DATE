+from __future__ import annotations
+
+import random
+from collections import deque
+
+import numpy as np
+
+
+BACKGROUND = 0
+RED = 2
+SPRITE_COLORS = (1, 3, 4, 6, 7, 8, 9)
+MAX_ATTEMPTS = 400
+
+
+def _bbox(mask: np.ndarray) -> tuple[int, int, int, int] | None:
+    coords = np.argwhere(mask)
+    if len(coords) == 0:
