+    original_blue = inp == BLUE
+    for spec in sorted(specs, key=lambda item: item["hole_count"]):
+        color = SIDE_TO_COLOR[spec["side"]]
+        for nr, nc in _copy_origins(spec, shape):
+            rr = nr + spec["cells"][:, 0]
+            cc = nc + spec["cells"][:, 1]
+            keep = ~original_blue[rr, cc]
+            out[rr[keep], cc[keep]] = color
+    return out
