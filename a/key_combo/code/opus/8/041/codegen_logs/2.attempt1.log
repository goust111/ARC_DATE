+    if side == "up":
+        row_lo = max(row_lo, 2 * oh, h // 2)
+    elif side == "down":
+        row_hi = min(row_hi, h - 3 * oh, h // 2 - 1)
+    elif side == "right":
+        col_hi = min(col_hi, w - 3 * ow, w // 2 - 1)
+    elif side == "left":
+        col_lo = max(col_lo, 2 * ow, w // 2)
