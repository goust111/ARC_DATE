+        ("010", "111", "110"),
+        ("0110", "1110", "0111", "0010"),
+    ],
+    1: [
+        ("111", "101", "111"),
+        ("1111", "1001", "1011", "1111"),
+        ("1111", "1001", "1001", "1011", "1111"),
+    ],
+    2: [
+        ("11111", "10001", "11111", "10001", "11111"),
