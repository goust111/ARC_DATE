+
+
+def _copy_bboxes(spec, shape):
+    h, w = spec["mask"].shape
+    bboxes = []
+    for nr, nc in _copy_origins(spec, shape):
+        bboxes.append((nr, nc, nr + h - 1, nc + w - 1))
+    return bboxes
+
+
+def _range_with_bias(side, shape, mask_shape):
+    h, w = shape
+    oh, ow = mask_shape
+    row_lo, row_hi = 1, h - oh - 2
+    col_lo, col_hi = 1, w - ow - 2
