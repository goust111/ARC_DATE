+    for side, (r, c) in _marker_positions(shape).items():
+        grid[r, c] = SIDE_TO_COLOR[side]
+    for spec in specs:
+        r0 = spec["r0"]
+        c0 = spec["c0"]
+        h, w = spec["mask"].shape
+        patch = grid[r0 : r0 + h, c0 : c0 + w]
+        patch[spec["mask"]] = BLUE
+    return grid
