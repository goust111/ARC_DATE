+
+def _placement_is_clear(shape, specs, mode):
+    for i, spec_a in enumerate(specs):
+        for spec_b in specs[i + 1 :]:
+            if _padded_bbox_intersects(spec_a["bbox"], spec_b["bbox"], pad=1):
