+    original_pixels = set()
+    for spec in specs:
+        rr = spec["r0"] + spec["cells"][:, 0]
+        cc = spec["c0"] + spec["cells"][:, 1]
+        original_pixels.update((int(r), int(c)) for r, c in zip(rr, cc))
