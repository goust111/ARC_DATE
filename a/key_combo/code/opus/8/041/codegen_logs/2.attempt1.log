+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if bg[r, c] and not seen[r, c]:
+                holes += 1
+                q = deque([(r, c)])
+                seen[r, c] = True
+                while q:
+                    rr, cc = q.popleft()
+                    for nr, nc in _neighbors4(rr, cc, h, w):
+                        if bg[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            q.append((nr, nc))
