+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
