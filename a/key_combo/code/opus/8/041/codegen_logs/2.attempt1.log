+            elif holes == 1:
+                preferences[holes] = (slot(row_lo, row_hi, "upper"), slot(col_lo, col_hi, "left"))
+            elif holes == 3:
+                preferences[holes] = (slot(row_lo, row_hi, "lower"), slot(col_lo, col_hi, "right"))
+        elif mode == "horizontal":
