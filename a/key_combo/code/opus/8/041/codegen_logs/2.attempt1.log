+        cc = nc + spec["cells"][:, 1]
+        cells.append({(int(r), int(c)) for r, c in zip(rr, cc)})
+    return cells
+
+
+def _copy_bboxes(spec, shape):
+    h, w = spec["mask"].shape
+    bboxes = []
+    for nr, nc in _copy_origins(spec, shape):
+        bboxes.append((nr, nc, nr + h - 1, nc + w - 1))
