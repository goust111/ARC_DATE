+
+
+def _template_to_mask(rows):
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _orientations(mask):
+    out = []
+    seen = set()
+    for flip in (False, True):
+        base = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            oriented = np.rot90(base, k)
+            key = oriented.tobytes() + bytes(oriented.shape)
+            if key not in seen:
+                seen.add(key)
+                out.append(oriented.copy())
+    return out
+
+
+def _neighbors4(r, c, h, w):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_components(mask):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox(coords):
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _hole_count(mask):
+    bg = np.pad(~mask, 1, constant_values=True)
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if bg[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if bg[r, c] and not seen[r, c]:
+                holes += 1
+                q = deque([(r, c)])
+                seen[r, c] = True
+                while q:
+                    rr, cc = q.popleft()
+                    for nr, nc in _neighbors4(rr, cc, h, w):
+                        if bg[nr, nc] and not seen[nr, nc]:
+                            seen[nr, nc] = True
+                            q.append((nr, nc))
+    return holes
+
+
+def _marker_positions(shape):
+    h, w = shape
+    return {
+        "up": (0, w // 2),
+        "right": (h // 2, w - 1),
+        "down": (h - 1, w // 2),
+        "left": (h // 2, 0),
+    }
+
+
+def _analyze_objects(grid):
+    blue_mask = grid == BLUE
+    records = []
+    for coords in _find_components(blue_mask):
+        r0, c0, r1, c1 = _bbox(coords)
+        local = blue_mask[r0 : r1 + 1, c0 : c1 + 1]
+        holes = _hole_count(local)
+        assert holes in HOLE_TO_SIDE, f"unsupported hole count: {holes}"
+        side = HOLE_TO_SIDE[holes]
+        step = local.shape[0] if side in ("up", "down") else local.shape[1]
+        local_coords = np.argwhere(local)
+        records.append(
+            {
+                "hole_count": holes,
+                "side": side,
+                "bbox": (r0, c0, r1, c1),
+                "mask": local,
+                "coords": coords,
+                "local_coords": local_coords,
+                "step": step,
+            }
+        )
+    return records
+
+
+def _copy_origins(spec, shape):
+    h, w = spec["mask"].shape
+    r0, c0, _, _ = spec["bbox"]
+    dr, dc = SIDE_TO_DELTA[spec["side"]]
+    step = spec["step"]
+    origins = []
+    k = 1
+    while True:
+        nr = r0 + dr * step * k
+        nc = c0 + dc * step * k
+        if nr < 0 or nc < 0 or nr + h > shape[0] or nc + w > shape[1]:
+            break
+        origins.append((nr, nc))
+        k += 1
+    return origins
+
