+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _hole_count(mask):
+    bg = np.pad(~mask, 1, constant_values=True)
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
