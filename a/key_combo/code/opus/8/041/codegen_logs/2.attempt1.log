+    has_horizontal = 1 in selected_holes and 3 in selected_holes
+    options = ["none"]
+    weights = [3]
+    if has_vertical:
+        options.append("vertical")
+        weights.append(2)
+    if has_horizontal:
+        options.append("horizontal")
+        weights.append(2)
+    return random.choices(options, weights=weights, k=1)[0]
