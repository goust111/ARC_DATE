+        col_hi = min(ranges[0][3], ranges[2][3])
+        if col_lo > col_hi:
+            return None
+        pair_col = near((col_lo + col_hi) // 2, col_lo, col_hi, radius=0)
+    elif mode == "horizontal":
+        if 1 not in by_holes or 3 not in by_holes:
+            return None
+        row_lo = max(ranges[1][0], ranges[3][0])
+        row_hi = min(ranges[1][1], ranges[3][1])
+        if row_lo > row_hi:
+            return None
+        pair_row = near((row_lo + row_hi) // 2, row_lo, row_hi, radius=0)
+
+    def slot(lo, hi, name):
+        span = hi - lo
+        if name == "top":
+            return lo
+        if name == "upper":
+            return lo + span // 3
+        if name == "center":
+            return (lo + hi) // 2
+        if name == "lower":
+            return hi - span // 3
+        if name == "bottom":
+            return hi
+        if name == "left":
+            return lo
+        if name == "right":
+            return hi
+        raise ValueError(name)
