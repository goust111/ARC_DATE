+
+
+def _range_with_bias(side, shape, mask_shape):
+    h, w = shape
+    oh, ow = mask_shape
+    row_lo, row_hi = 1, h - oh - 2
+    col_lo, col_hi = 1, w - ow - 2
+
+    if side == "up":
+        row_lo = max(row_lo, 2 * oh, h // 2)
+    elif side == "down":
+        row_hi = min(row_hi, h - 3 * oh, h // 2 - 1)
+    elif side == "right":
