+                "mask": local,
+                "coords": coords,
+                "local_coords": local_coords,
+                "step": step,
+            }
+        )
+    return records
+
+
+def _copy_origins(spec, shape):
+    h, w = spec["mask"].shape
+    r0, c0, _, _ = spec["bbox"]
+    dr, dc = SIDE_TO_DELTA[spec["side"]]
+    step = spec["step"]
+    origins = []
+    k = 1
+    while True:
