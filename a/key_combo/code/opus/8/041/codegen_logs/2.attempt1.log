+        col_mid_left = col_lo + (col_hi - col_lo) // 3
+        col_mid_right = col_hi - (col_hi - col_lo) // 3
+        if mode == "vertical":
+            if holes == 2:
+                preferences[holes] = (slot(row_lo, row_hi, "top"), pair_col)
+            elif holes == 0:
