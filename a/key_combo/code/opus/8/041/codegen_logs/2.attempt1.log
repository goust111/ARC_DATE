+    if mode == "none":
+        if total_overlap != 0:
+            return False
+    elif mode == "vertical":
+        if overlap_pairs.get((0, 2), 0) < 2:
+            return False
+    elif mode == "horizontal":
+        if overlap_pairs.get((1, 3), 0) < 2:
+            return False
+    else:
+        return False
+
+    if total_overlap > copy_pixel_total * 0.2 + 3:
+        return False
+    return True
