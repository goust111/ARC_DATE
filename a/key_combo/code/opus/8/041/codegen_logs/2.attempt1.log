+    for spec in specs:
+        origins = _copy_origins(spec, shape)
+        if len(origins) < 2:
+            return False
+        for cell_set in _copy_cells(spec, shape):
+            if any(cell in original_pixels for cell in cell_set):
+                return False
+            copy_pixel_total += len(cell_set)
+            for cell in cell_set:
+                if cell in all_seen:
+                    other = all_seen[cell]
+                    key = tuple(sorted((spec["hole_count"], other)))
+                    overlap_pairs[key] += 1
+                    total_overlap += 1
+                else:
+                    all_seen[cell] = spec["hole_count"]
