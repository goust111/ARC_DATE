+    for spec in specs:
+        origins = _copy_origins(spec, shape)
+        if len(origins) < 2:
+            return False
+        for cell_set in _copy_cells(spec, shape):
+            if any(cell in original_pixels for cell in cell_set):
+                return False
+            copy_pixel_total += len(cell_set)
+            for cell in cell_set:
+                if cell in all_seen:
+                    other = all_seen[cell]
+                    key = tuple(sorted((spec["hole_count"], other)))
+                    overlap_pairs[key] += 1
+                    total_overlap += 1
+                else:
+                    all_seen[cell] = spec["hole_count"]
+
+    if copy_pixel_total > shape[0] * shape[1] * 0.42:
+        return False
+
+    if mode == "none":
+        if total_overlap != 0:
+            return False
+    elif mode == "vertical":
+        if overlap_pairs.get((0, 2), 0) < 2:
+            return False
+    elif mode == "horizontal":
+        if overlap_pairs.get((1, 3), 0) < 2:
+            return False
+    else:
+        return False
