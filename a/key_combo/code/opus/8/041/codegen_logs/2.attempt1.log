+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+
+    out = g.copy()
+    marker_colors = {}
+    for side, (r, c) in _marker_positions(g.shape).items():
+        marker_colors[side] = int(g[r, c])
