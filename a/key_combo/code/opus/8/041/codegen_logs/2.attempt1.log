+    if copy_pixel_total > shape[0] * shape[1] * 0.42:
+        return False
+
+    if mode == "none":
+        if total_overlap != 0:
+            return False
+    elif mode == "vertical":
+        if overlap_pairs.get((0, 2), 0) < 2:
+            return False
+    elif mode == "horizontal":
+        if overlap_pairs.get((1, 3), 0) < 2:
+            return False
+    else:
+        return False
