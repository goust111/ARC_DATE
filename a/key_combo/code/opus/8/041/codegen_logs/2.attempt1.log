+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+HOLE_TO_SIDE = {0: "up", 1: "right", 2: "down", 3: "left"}
+SIDE_TO_DELTA = {"up": (-1, 0), "right": (0, 1), "down": (1, 0), "left": (0, -1)}
+SIDE_TO_COLOR = {"up": RED, "right": GREEN, "down": YELLOW, "left": ORANGE}
