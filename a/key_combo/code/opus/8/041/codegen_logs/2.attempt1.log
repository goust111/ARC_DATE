+import random
+from collections import defaultdict, deque
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREEN = 3
+YELLOW = 4
+ORANGE = 7
+
+HOLE_TO_SIDE = {0: "up", 1: "right", 2: "down", 3: "left"}
+SIDE_TO_DELTA = {"up": (-1, 0), "right": (0, 1), "down": (1, 0), "left": (0, -1)}
+SIDE_TO_COLOR = {"up": RED, "right": GREEN, "down": YELLOW, "left": ORANGE}
+
+GRID_SIDE_RANGE = (23, 30)
+OBJECT_COUNT_CHOICES = (3, 4)
+GENERATION_ATTEMPTS = 400
+PLACEMENT_ATTEMPTS = 250
+
+
+TEMPLATE_STRINGS = {
+    0: [
+        ("110", "111", "010"),
+        ("010", "111", "110"),
+        ("0110", "1110", "0111", "0010"),
+    ],
+    1: [
+        ("111", "101", "111"),
+        ("1111", "1001", "1011", "1111"),
+        ("1111", "1001", "1001", "1011", "1111"),
+    ],
+    2: [
+        ("11111", "10001", "11111", "10001", "11111"),
+        ("111111", "100001", "111111", "100001", "111111"),
+    ],
+    3: [
+        ("11111", "10001", "11111", "10001", "11111", "10001", "11111"),
+        ("111111", "100001", "111111", "100001", "111111", "100001", "111111"),
+    ],
+}
+
+
+def _template_to_mask(rows):
+    return np.array([[ch == "1" for ch in row] for row in rows], dtype=bool)
+
+
+def _orientations(mask):
+    out = []
+    seen = set()
+    for flip in (False, True):
+        base = np.fliplr(mask) if flip else mask
+        for k in range(4):
+            oriented = np.rot90(base, k)
+            key = oriented.tobytes() + bytes(oriented.shape)
+            if key not in seen:
+                seen.add(key)
+                out.append(oriented.copy())
+    return out
+
+
+def _neighbors4(r, c, h, w):
+    if r > 0:
+        yield r - 1, c
+    if r + 1 < h:
+        yield r + 1, c
+    if c > 0:
+        yield r, c - 1
+    if c + 1 < w:
+        yield r, c + 1
+
+
+def _find_components(mask):
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    components = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            coords = []
+            while q:
+                rr, cc = q.popleft()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc, h, w):
+                    if mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            components.append(np.array(coords, dtype=int))
+    return components
+
+
+def _bbox(coords):
+    r0 = int(coords[:, 0].min())
+    c0 = int(coords[:, 1].min())
+    r1 = int(coords[:, 0].max())
+    c1 = int(coords[:, 1].max())
+    return r0, c0, r1, c1
+
+
+def _hole_count(mask):
+    bg = np.pad(~mask, 1, constant_values=True)
+    h, w = bg.shape
+    seen = np.zeros((h, w), dtype=bool)
+    q = deque([(0, 0)])
+    seen[0, 0] = True
+    while q:
+        r, c = q.popleft()
+        for nr, nc in _neighbors4(r, c, h, w):
+            if bg[nr, nc] and not seen[nr, nc]:
+                seen[nr, nc] = True
+                q.append((nr, nc))
+
+    holes = 0
+    for r in range(h):
+        for c in range(w):
+            if bg[r, c] and not seen[r, c]:
+                holes += 1
+                q = deque([(r, c)])
