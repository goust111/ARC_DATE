+def _validate_generated_scene(inp, expected, specs, mode):
+    marker_positions = _marker_positions(inp.shape)
+    for side, (r, c) in marker_positions.items():
+        if int(inp[r, c]) != SIDE_TO_COLOR[side]:
+            return False
