+    max_h = max(spec["mask"].shape[0] for spec in specs)
+    max_w = max(spec["mask"].shape[1] for spec in specs)
+    low = max(min_side, 3 * max_h + 3, 3 * max_w + 3)
+    high = GRID_SIDE_RANGE[1]
+    assert low <= high
+    return random.randint(low, high), random.randint(low, high)
+
+
+def _sample_positions(shape, specs, mode):
+    by_holes = {spec["hole_count"]: spec for spec in specs}
+    ranges = {}
+    for holes, spec in by_holes.items():
+        ranges[holes] = _range_with_bias(spec["side"], shape, spec["mask"].shape)
+        row_lo, row_hi, col_lo, col_hi = ranges[holes]
+        if row_lo > row_hi or col_lo > col_hi:
+            return None
+
+    def near(preferred, lo, hi, radius=2):
+        if lo > hi:
+            return None
+        preferred = min(max(preferred, lo), hi)
+        start = max(lo, preferred - radius)
+        stop = min(hi, preferred + radius)
+        return random.randint(start, stop)
+
+    mirror_x = random.random() < 0.5
+    mirror_y = random.random() < 0.5
+    pair_col = None
+    pair_row = None
+
+    if mode == "vertical":
+        if 0 not in by_holes or 2 not in by_holes:
+            return None
+        col_lo = max(ranges[0][2], ranges[2][2])
+        col_hi = min(ranges[0][3], ranges[2][3])
+        if col_lo > col_hi:
+            return None
+        pair_col = near((col_lo + col_hi) // 2, col_lo, col_hi, radius=1)
+    elif mode == "horizontal":
+        if 1 not in by_holes or 3 not in by_holes:
+            return None
+        row_lo = max(ranges[1][0], ranges[3][0])
+        row_hi = min(ranges[1][1], ranges[3][1])
+        if row_lo > row_hi:
+            return None
+        pair_row = near((row_lo + row_hi) // 2, row_lo, row_hi, radius=1)
+
+    preferences = {}
+    for holes in by_holes:
+        row_lo, row_hi, col_lo, col_hi = ranges[holes]
+        row_span = row_hi - row_lo
+        col_span = col_hi - col_lo
+        if mode == "vertical":
+            if holes == 2:
+                preferences[holes] = (row_lo, pair_col)
+            elif holes == 0:
+                preferences[holes] = (row_hi, pair_col)
+            elif holes == 1:
+                row_pref = row_lo if not mirror_y else row_hi
+                preferences[holes] = (row_pref, col_lo)
+            elif holes == 3:
+                row_pref = row_hi if not mirror_y else row_lo
+                preferences[holes] = (row_pref, col_hi)
+        elif mode == "horizontal":
+            if holes == 1:
+                preferences[holes] = (pair_row, col_lo)
+            elif holes == 3:
+                preferences[holes] = (pair_row, col_hi)
+            elif holes == 2:
+                preferences[holes] = (row_lo, col_hi if not mirror_x else col_lo)
+            elif holes == 0:
+                preferences[holes] = (row_hi, col_lo if not mirror_x else col_hi)
+        else:
+            if holes == 2:
+                preferences[holes] = (row_lo, col_hi if not mirror_x else col_lo)
+            elif holes == 1:
+                row_pref = row_lo + row_span // 3 if not mirror_y else row_hi - row_span // 3
+                preferences[holes] = (row_pref, col_lo)
+            elif holes == 0:
+                preferences[holes] = (row_hi, col_lo if not mirror_x else col_hi)
+            elif holes == 3:
+                row_pref = row_hi - row_span // 3 if not mirror_y else row_lo + row_span // 3
+                preferences[holes] = (row_pref, col_hi)
+            else:
+                preferences[holes] = (row_lo + row_span // 2, col_lo + col_span // 2)
+
+    for spec in specs:
+        holes = spec["hole_count"]
+        row_lo, row_hi, col_lo, col_hi = ranges[holes]
+        pref_r, pref_c = preferences[holes]
+        r0 = near(pref_r, row_lo, row_hi)
+        c0 = near(pref_c, col_lo, col_hi)
+        if r0 is None or c0 is None:
+            return None
+        h, w = spec["mask"].shape
+        spec["r0"] = r0
+        spec["c0"] = c0
+        spec["bbox"] = (r0, c0, r0 + h - 1, c0 + w - 1)
+        spec["step"] = h if spec["side"] in ("up", "down") else w
