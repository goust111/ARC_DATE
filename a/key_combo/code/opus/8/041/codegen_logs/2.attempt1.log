+            cc = nc + record["local_coords"][:, 1]
+            keep = ~original_blue[rr, cc]
+            out[rr[keep], cc[keep]] = color
+
+    return out
+
+
+def generate_input() -> np.ndarray:
+    for _ in range(GENERATION_ATTEMPTS):
+        grid = _gen_attempt()
+        if grid is not None:
+            return grid
