+        choices = _frontier(mask)
+        if not choices:
+            break
+        if random.random() < 0.35:
+            edge_cells = [cell for cell in choices if 0 in cell or cell[0] == h - 1 or cell[1] == w - 1]
+            pick_pool = edge_cells or choices
+        else:
+            pick_pool = choices
+        r, c = random.choice(pick_pool)
+        mask[r, c] = True
+    return mask
+
+
