+    area = left_mask.size
+    union_count = int(direct.sum())
+    union_lo = int(np.ceil(UNION_DENSITY_RANGE[0] * area))
+    union_hi = int(np.floor(UNION_DENSITY_RANGE[1] * area))
+    if not (union_lo <= union_count <= union_hi):
+        return False
