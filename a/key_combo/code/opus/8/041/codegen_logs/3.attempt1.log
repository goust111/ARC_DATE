+    lo = max(4, int(np.ceil(MASK_DENSITY_RANGE[0] * area)))
+    hi = max(lo, int(np.floor(MASK_DENSITY_RANGE[1] * area)))
+    target = random.randint(lo, hi)
+
+    for _ in range(80):
+        mask = _grow_connected_mask(h, w, target)
+        _add_spur(mask)
+        mask[0, 0] = False
+        count = int(mask.sum())
+        if count < lo or count > hi:
+            continue
