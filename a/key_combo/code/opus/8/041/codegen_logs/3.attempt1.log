+    left_only = int(np.count_nonzero(left_mask & ~right_mask))
+    right_only = int(np.count_nonzero(~left_mask & right_mask))
+    overlap = int(np.count_nonzero(left_mask & right_mask))
+    if min(left_only, right_only, overlap) < 1:
