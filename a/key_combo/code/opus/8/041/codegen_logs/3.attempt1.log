+    assert not np.array_equal(expected, alt)
+    return bool(expected_flip), bool(not expected_flip)
+
+
+def _gen_attempt() -> np.ndarray:
+    h = random.randint(MIN_HEIGHT, MAX_HEIGHT)
+    w = random.randint(MIN_HALF_WIDTH, MAX_HALF_WIDTH)
