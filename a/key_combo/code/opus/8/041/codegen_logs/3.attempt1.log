+    if random.random() < 0.45:
+        return random.choice(edge_bias)
+    while True:
+        cell = (random.randrange(h), random.randrange(w))
+        if cell != (0, 0):
+            return cell
+
+
+def _grow_connected_mask(h: int, w: int, target: int) -> np.ndarray:
+    mask = np.zeros((h, w), dtype=bool)
