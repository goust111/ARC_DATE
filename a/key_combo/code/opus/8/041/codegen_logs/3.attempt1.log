+def _semantic_check(grid: np.ndarray) -> tuple[bool, bool]:
+    left, right = _extract_halves(grid)
+    assert int(left[0, 0]) in MARKER_COLORS
+    assert int(right[0, 0]) in MARKER_COLORS
