def _gen_separated(cells: tuple[tuple[int, int], ...], used: tuple[tuple[int, int], ...]) -> bool:
    for r0, c0 in cells:
        for r1, c1 in used:
            if abs(r0 - r1) + abs(c0 - c1) < _GEN_MIN_HOLE_DISTANCE:
                return False
    return True


