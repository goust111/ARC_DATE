    options: list[tuple[tuple[int, int], ...]],
    remaining: int,
    used: tuple[tuple[int, int], ...],
    *,
    shuffled: bool,
) -> list[tuple[tuple[int, int], ...]] | None:
    if remaining == 0:
        return []

    pool = options[:]
    if shuffled:
        random.shuffle(pool)

    for cells in pool:
        if not _gen_separated(cells, used):
            continue
        tail = _gen_search_holes(options, remaining - 1, used + cells, shuffled=shuffled)
        if tail is not None:
            return [cells] + tail
