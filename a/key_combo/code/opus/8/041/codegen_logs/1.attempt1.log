        paste(inp, obj, r0, c0, transparent=Color.BLACK)
        out_obj = np.where(obj == int(fg), int(_GEN_HOLE_COLOR[n_holes]), _GEN_BACKGROUND_COLOR)
        paste(expected, out_obj, r0, c0, transparent=_GEN_BACKGROUND_COLOR)
