    bg = get_bg(g)
    fg_colors = colors_present(g, exclude={bg})
    assert len(fg_colors) == 1
    src_color = fg_colors[0]

    components = find_components(
        g,
        bg=bg,
        connectivity=4,
        monochromatic=True,
        colors=[src_color],
