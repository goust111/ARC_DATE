+        row = rows[0]
+        c0, c1 = cols[0], cols[-1]
+        assert len(cols) == c1 - c0 + 1
+        assert int(coords.shape[0]) == len(cols)
+        return _make_bar("H", row, c0, len(cols))
+    if len(cols) == 1:
+        col = cols[0]
+        r0, r1 = rows[0], rows[-1]
