+
+    r0 = int(anchor0)
+    col = int(anchor1)
+    cells = frozenset((r0 + dr, col) for dr in range(int(length)))
+    envelope = set()
+    for d in range(1, radius + 1):
+        top = r0 + d
+        bottom = r0 + int(length) - 1 - d
+        for cc in (col - d, col + d):
+            for rr in range(top, bottom + 1):
+                envelope.add((rr, cc))
+    return {
+        "orientation": "V",
+        "length": int(length),
+        "radius": radius,
+        "r0": r0,
+        "r1": r0 + int(length) - 1,
+        "col": col,
+        "cells": cells,
+        "envelope": frozenset(envelope),
+    }
+
+
