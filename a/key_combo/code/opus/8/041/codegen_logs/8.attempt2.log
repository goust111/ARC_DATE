+
+
+def _diamond_height(orientation: str, length: int) -> int:
+    radius = (length - 1) // 2
+    return 2 * radius + 1 if orientation == "H" else length
+
+
+def _transform_from_top(grid: np.ndarray, edge: str) -> np.ndarray:
+    if edge == "top":
+        return grid.copy()
+    if edge == "bottom":
+        return np.flipud(grid).copy()
