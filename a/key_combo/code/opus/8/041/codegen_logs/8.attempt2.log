+    h, w = grid.shape
+    if r == 0:
+        return (r, c), 0, 1, h - 1
+    if r == h - 1:
+        return (r, c), 0, -1, 0
+    if c == 0:
+        return (r, c), 1, 1, w - 1
+    if c == w - 1:
