+        candidates.append(
+            {
+                "projection_lo": lo,
+                "projection_hi": hi,
+                "target_cross": target,
+                "steps": steps,
+                "mode": mode,
+                "chosen": chosen,
+                "proj_width": proj_width,
+            }
+        )
