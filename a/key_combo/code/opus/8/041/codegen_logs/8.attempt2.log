        regions = _enclosed_region_coords(coords, (0, 0, h - 1, w - 1))
        if len(regions) != 1 or len(regions[0]) < 3:
            continue

        patch = np.zeros((h, w), dtype=int)
        patch[wall] = int(color)
        return patch
