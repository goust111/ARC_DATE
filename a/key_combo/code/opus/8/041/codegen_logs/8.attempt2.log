+    for detour in trace["detours"]:
+        forward_main = detour["at_main"] + trace["forward_sign"]
+        rr, cc = _set_axes(trace["main_axis"], forward_main, detour["from_cross"])
+        if not trace["forbidden"][rr, cc]:
+            return False
