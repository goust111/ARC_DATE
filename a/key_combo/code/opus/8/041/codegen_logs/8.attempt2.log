+    if center_bias:
+        weighted = []
+        for cand in candidates:
+            weight = 1
+            if cand["mode"] == "tie":
+                weight = 5
+            weighted.extend([cand] * weight)
+        return random.choice(weighted)
+    return random.choice(candidates)
