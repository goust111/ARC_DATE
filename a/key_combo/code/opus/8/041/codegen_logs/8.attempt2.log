+    return (main_value, cross_value) if main_axis == 0 else (cross_value, main_value)
+
+
+def _solve_with_trace(grid: np.ndarray) -> tuple[np.ndarray, dict]:
+    g = np.asarray(grid, dtype=int)
+    assert g.ndim == 2
+    h, w = g.shape
