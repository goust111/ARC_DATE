+                {
+                    "bbox": (bar_row, lo, bar_row, lo + length - 1),
+                    "orientation": "H",
+                    "length": length,
+                    "radius": radius,
+                },
+                1,
+            )
+        else:
+            col = lo + radius
+            top_row = placement["top"]
+            grid[top_row : top_row + length, col] = RED
+            temp = np.zeros((h, w), dtype=int)
+            _paint_diamond(
+                temp,
+                {
+                    "bbox": (top_row, col, top_row + length - 1, col),
+                    "orientation": "V",
+                    "length": length,
+                    "radius": radius,
+                },
+                1,
+            )
+        diamond = temp.astype(bool)
+        if (used & diamond).any():
+            return None
+        used |= diamond
