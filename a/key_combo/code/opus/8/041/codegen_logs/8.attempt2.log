+        temp = np.zeros((h, w), dtype=int)
+        _paint_diamond(temp, bar, 1)
+        diamond = temp.astype(bool)
+        assert not (forbidden & diamond).any(), "diamond keep-out zones must not overlap"
+        forbidden |= diamond
+        comp_id[diamond] = idx
+        coords = np.argwhere(diamond)
+        r0, c0, r1, c1 = _bbox(coords)
