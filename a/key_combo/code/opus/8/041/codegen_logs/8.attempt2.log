+def _start_setup(grid: np.ndarray) -> tuple[tuple[int, int], int, int, int]:
+    pts = np.argwhere(grid == GREEN)
+    assert pts.shape[0] == 1, "expected a single green start pixel"
+    r, c = map(int, pts[0])
+    h, w = grid.shape
+    if r == 0:
+        return (r, c), 0, 1, h - 1
+    if r == h - 1:
+        return (r, c), 0, -1, 0
+    if c == 0:
+        return (r, c), 1, 1, w - 1
+    if c == w - 1:
+        return (r, c), 1, -1, 0
