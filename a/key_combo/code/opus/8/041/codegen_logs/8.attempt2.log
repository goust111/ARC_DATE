+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+RED = 2
+GREEN = 3
+
+GRID_H_RANGE = (17, 25)
+GRID_W_RANGE = (17, 25)
+BAR_COUNT_RANGE = (2, 4)
+BAR_LENGTH_RANGE = (3, 7)
+ORIENTATIONS = ("H", "V")
+MAX_GENERATION_ATTEMPTS = 500
