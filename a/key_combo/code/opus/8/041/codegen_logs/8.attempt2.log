+from __future__ import annotations
+
+from collections import deque
+import random
+
+import numpy as np
+
+
+BG = 8
+RED = 2
+GREEN = 3
+
+GRID_H_RANGE = (17, 25)
+GRID_W_RANGE = (17, 25)
+BAR_COUNT_RANGE = (2, 4)
+BAR_LENGTH_RANGE = (3, 7)
+ORIENTATIONS = ("H", "V")
+MAX_GENERATION_ATTEMPTS = 500
+
+
+def _neighbors4(r: int, c: int):
+    yield r - 1, c
+    yield r + 1, c
+    yield r, c - 1
+    yield r, c + 1
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros((h, w), dtype=bool)
+    out: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            q = deque([(r, c)])
+            seen[r, c] = True
+            cells = []
+            while q:
+                rr, cc = q.popleft()
+                cells.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        q.append((nr, nc))
+            out.append(np.array(cells, dtype=int))
+    return out
+
+
+def _bbox(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _bar_info(coords: np.ndarray) -> dict:
+    r0, c0, r1, c1 = _bbox(coords)
+    h = r1 - r0 + 1
+    w = c1 - c0 + 1
+    area = int(coords.shape[0])
+    assert h == 1 or w == 1, "every red component must be a straight bar"
+    assert area == h * w, "bar must be solid"
+    length = max(h, w)
+    assert length >= 3, "bar must be long enough to define a diamond"
+    orientation = "H" if h == 1 else "V"
+    return {
+        "coords": coords,
+        "bbox": (r0, c0, r1, c1),
+        "orientation": orientation,
+        "length": int(length),
+        "radius": int((length - 1) // 2),
+    }
+
+
+def _paint_diamond(mask: np.ndarray, bar: dict, value: int) -> None:
+    r0, c0, r1, c1 = bar["bbox"]
+    radius = bar["radius"]
+    if bar["orientation"] == "H":
+        row = r0
+        mask[row, c0 : c1 + 1] = value
+        for d in range(1, radius + 1):
+            left = c0 + d
+            right = c1 - d
+            mask[row - d, left : right + 1] = value
+            mask[row + d, left : right + 1] = value
+    else:
