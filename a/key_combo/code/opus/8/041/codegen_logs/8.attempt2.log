+        if len(best) > 1:
+            center = (cross_size - 1) / 2.0
+            best.sort(
+                key=lambda opt: (
+                    abs(opt["target_cross"] - center),
+                    abs((pos_cross + opt["side_sign"]) - center),
+                    opt["target_cross"],
