+import numpy as np
+
+
+BG = 0
+YELLOW = 4
+GREY = 5
+FILL_COLORS = (1, 2, 3)
+DIAGONALS = ((-1, -1), (-1, 1), (1, -1), (1, 1))
+INNER = "inner"
+OUTER = "outer"
+BLOCK_SIZE = 4
