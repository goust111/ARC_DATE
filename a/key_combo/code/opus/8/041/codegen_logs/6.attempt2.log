    inp = np.full(INPUT_SHAPE, bg, dtype=int)
    inp[CENTER, CENTER] = marker
    inp[CENTER + dr, CENTER] = fill
    inp[CENTER, CENTER + dc] = fill
    inp[CENTER + dr, CENTER + dc] = fill
    return inp


def generate_input() -> np.ndarray:
