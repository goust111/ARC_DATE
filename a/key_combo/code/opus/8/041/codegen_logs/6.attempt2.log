+    return grid
+
+
+def _output_bbox(marker: tuple[int, int]) -> tuple[int, int, int, int]:
+    r, c = marker
+    return r - LOCAL_RADIUS, c - LOCAL_RADIUS, r + LOCAL_RADIUS, c + LOCAL_RADIUS
