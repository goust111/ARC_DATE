_SIDE_OPTIONS = ("left", "right")
_GAP_OFFSET_BY_SIDE = {"right": 1, "left": 2}

# Ray and placement constraints.
_RAY_LENGTH_RANGE, _TOUCH_DISTANCE = (4, 8), 1

