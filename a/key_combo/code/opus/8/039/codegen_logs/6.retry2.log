    r0, c0, r1, c1 = component["bbox"]
    if orient == "vertical":
        if c1 < axis:
            return -1
        if c0 > axis:
            return 1
    elif orient == "horizontal":
        if r1 < axis:
            return -1
        if r0 > axis:
            return 1
    else:
        raise AssertionError("unknown separator orientation")
    return 0


