+def _recolor_subgrid(subgrid: np.ndarray) -> np.ndarray:
+    g = np.asarray(subgrid, dtype=int)
+    colors = _colors_present(g)
+    assert len(colors) == 2, "extracted subgrid must be exactly two colors"
