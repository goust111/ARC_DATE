+    frame_colors = list(rng.choice(FRAME_COLORS, size=n_frames, replace=False))
+    boxes: list[tuple[int, int, int, int]] = []
+    largest_bbox = _choose_box(rng, grid.shape, largest_outer, boxes, margin=2)
+    if largest_bbox is None:
