+
+def _bbox_area(bbox: tuple[int, int, int, int]) -> int:
+    r0, c0, r1, c1 = bbox
+    return (r1 - r0 - 1) * (c1 - c0 - 1)
+
+
+def _iter_border_cells(r0: int, c0: int, r1: int, c1: int) -> Iterable[tuple[int, int]]:
+    for c in range(c0, c1 + 1):
+        yield r0, c
+        yield r1, c
+    for r in range(r0 + 1, r1):
+        yield r, c0
+        yield r, c1
