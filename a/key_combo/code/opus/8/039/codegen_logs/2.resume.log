    gaps = [MIN_BARRIER_GAP + int(v) for v in extras]

    pos = 0
    barriers: list[int] = []
    for gap in gaps[:-1]:
        pos += int(gap)
        barriers.append(pos)
    return barriers


def _build_input(
    rect_h: int,
    rect_w: int,
    marker_count: int,
    pads: tuple[int, int, int, int],
