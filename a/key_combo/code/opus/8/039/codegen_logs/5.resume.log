+from __future__ import annotations
+
+from itertools import combinations, product
+import random
+
+import numpy as np
+
+
+BLACK = 0
+RED = 2
+GREEN = 3
+GREY = 5
+
+GEN_MAX_ATTEMPTS = 400
+GEN_SLOT_EXTRA_PAD = (0, 2)
+GEN_ELBOW_WEIGHTS = ((2, 4), (3, 4), (4, 2))
+GEN_VERTICAL_OPTIONS = {
