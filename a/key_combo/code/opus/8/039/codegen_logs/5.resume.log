+    strip_width = _encode_strip(steps).shape[1]
+    uncropped = _render_uncropped_from_steps(steps, strip_width)
+    _divider_r, regions = _slot_regions(grid)
+    for region, patch in zip(regions, _rotations(uncropped, len(regions))):
