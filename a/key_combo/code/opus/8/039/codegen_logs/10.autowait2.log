+        return False
+    rr0 = max(0, r0 - pad)
+    cc0 = max(0, c0 - pad)
+    rr1 = min(H, r0 + h + pad)
+    cc1 = min(W, c0 + w + pad)
+    return not occupied[rr0:rr1, cc0:cc1].any()
+
+
+def _reserve(occupied: np.ndarray, r0: int, c0: int, h: int, w: int) -> None:
+    occupied[r0 : r0 + h, c0 : c0 + w] = True
