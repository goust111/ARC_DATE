+            continue
+        box = _bbox(coords)
+        patch = _crop(grid, box)
+        visible = (patch != BLACK) & (patch != GREY)
+        colors = tuple(sorted(int(x) for x in np.unique(patch[visible])))
+        templates.append(
+            {
+                "bbox": box,
+                "patch": patch,
+                "visible": visible,
+                "colors": colors,
+                "color_count": len(colors),
