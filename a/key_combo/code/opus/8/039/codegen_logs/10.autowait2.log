+def _stamp_template(out: np.ndarray, template: dict, anchor_r: int, anchor_c: int) -> tuple[int, int, int, int]:
+    patch = template["patch"]
+    visible = template["visible"]
+    h, w = patch.shape
+    for tr in range(h):
