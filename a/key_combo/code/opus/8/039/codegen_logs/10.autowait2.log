+def _random_template(existing_color_sets: set[tuple[int, ...]]) -> np.ndarray | None:
+    for _ in range(100):
+        h = random.randint(3, 4)
+        w = random.randint(3, 4)
+        k = random.randint(2, min(4, h * w))
