+def _neighbors(r: int, c: int, connectivity: int):
+    if connectivity == 4:
+        yield r - 1, c
+        yield r + 1, c
+        yield r, c - 1
+        yield r, c + 1
+        return
+    for dr in (-1, 0, 1):
+        for dc in (-1, 0, 1):
+            if dr == 0 and dc == 0:
+                continue
+            yield r + dr, c + dc
