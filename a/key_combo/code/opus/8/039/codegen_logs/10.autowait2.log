+def _is_filled_rectangle(rel_coords: list[tuple[int, int]]) -> bool:
+    if not rel_coords:
+        return False
+    rows = [r for r, _c in rel_coords]
+    cols = [c for _r, c in rel_coords]
+    r0, r1 = min(rows), max(rows)
+    c0, c1 = min(cols), max(cols)
