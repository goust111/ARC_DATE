+    ranked = sorted(matches, key=lambda item: item[0], reverse=True)
+    side = len(ranked)
+    out = np.zeros((side, side), dtype=int)
+    for layer in range((side + 1) // 2):
+        color = int(ranked[layer % len(ranked)][1])
+        out[layer : side - layer, layer : side - layer] = color
