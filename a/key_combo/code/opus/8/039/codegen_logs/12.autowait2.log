+def _factor_options(length: int) -> list[tuple[int, ...]]:
+    options = []
+    for factors in itertools.product((1, 2, 3), repeat=length):
+        if sum(factors) <= MAX_PATCH_SIDE:
+            options.append(tuple(int(v) for v in factors))
