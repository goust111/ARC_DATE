+    for area in range(DISTRACTOR_AREA_RANGE[0], DISTRACTOR_AREA_RANGE[1] + 1):
+        for mask in _POLYOMINOES[area]:
+            h, w = mask.shape
+            if min(h, w) < 2 or max(h, w) > 4:
+                continue
+            pool.append(mask.copy())
+    return pool
+
