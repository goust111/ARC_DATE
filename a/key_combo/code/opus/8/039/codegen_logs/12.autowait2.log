+        r2 = min(grid.shape[0], int(r) + PLACEMENT_PADDING + 1)
+        c1 = max(0, int(c) - PLACEMENT_PADDING)
+        c2 = min(grid.shape[1], int(c) + PLACEMENT_PADDING + 1)
+        blocked[r1:r2, c1:c2] = True
