+def _generate_attempt() -> np.ndarray | None:
+    height = random.randint(*GRID_ROWS_RANGE)
+    width = random.randint(*GRID_COLS_RANGE)
+    prototype = random.choice(PROTOTYPE_POOL)
+    prototype_signatures = _signature_set(prototype)
