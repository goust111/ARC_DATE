+
+    max_matches = min(MATCH_COUNT_RANGE[1], len(matches_by_area))
+    match_count = random.randint(MATCH_COUNT_RANGE[0], max_matches)
+    total_min = max(TOTAL_CANDIDATE_RANGE[0], match_count + 1)
+    total_max = TOTAL_CANDIDATE_RANGE[1]
