+from __future__ import annotations
+
+import itertools
+import random
+
+import numpy as np
+
+
+BG = 0
+PROTOTYPE_COLOR = 2
+CANDIDATE_COLORS = (1, 3, 4, 5, 6, 7)
+
+GRID_ROWS_RANGE = (15, 19)
+GRID_COLS_RANGE = (15, 19)
+PROTOTYPE_AREA_RANGE = (3, 5)
+DISTRACTOR_AREA_RANGE = (3, 6)
+MATCH_COUNT_RANGE = (3, 5)
