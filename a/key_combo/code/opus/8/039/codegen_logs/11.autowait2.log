+    predicted = _render_band(predicted_masks, col_colors, col_intervals, int(top.shape[1]), bg)
+
+    ref_mask = reference != bg
+    assert np.all(predicted[ref_mask] == reference[ref_mask])
+
+    out = predicted.copy()
+    out[ref_mask] = reference[ref_mask]
+    return out
