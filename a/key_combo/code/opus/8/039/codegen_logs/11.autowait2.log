+    if total_foreground == 0:
+        return None
+
+    column_cells = []
+    for col_index in range(n_cols):
+        c0 = col_index * STRIDE
+        coords = [tuple(map(int, rc)) for rc in np.argwhere(predicted[:, c0 : c0 + SPRITE_SIZE] != BG)]
