+    blue_components = find_components(
+        grid,
+        bg=get_bg(grid),
+        colors=[Color.BLUE],
+        connectivity=4,
+        monochromatic=True,
+        return_format="dict",
+    )
+    matches = []
+    for comp in blue_components:
+        coords = {(int(r), int(c)) for r, c in comp["coords"]}
+        if coords & adjacent_blue:
+            matches.append(comp)
+    assert len(matches) == 1, "marker must select exactly one blue object"
+    return matches[0]
