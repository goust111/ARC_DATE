+def _fits_with_gap(
+    occupied: set[tuple[int, int]],
+    cells: list[tuple[int, int]],
+    shape: tuple[int, int],
+) -> bool:
+    h, w = shape
+    for r, c in cells:
+        if not (0 <= r < h and 0 <= c < w):
+            return False
+        for rr in range(r - 1, r + 2):
+            for cc in range(c - 1, c + 2):
+                if (rr, cc) in occupied:
+                    return False
