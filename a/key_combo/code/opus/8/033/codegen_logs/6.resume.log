    out = np.full((h, w), BLANK_COLOR, dtype=int)
    occupied = set()
    for color, size in zip(mark_colors, sizes):
        cells = _gen_blob_cells(h, w, size, occupied)
        if cells is None:
            return None
        for r, c in cells:
            out[r, c] = color
        occupied.update(cells)
    return out


