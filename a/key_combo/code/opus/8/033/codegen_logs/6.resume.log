+                break
+        if not ok:
+            return False
+
+    pair_cells = _exclusive_overlap_cells(analysis["stats"], analysis["owner_grid"], 0, 1)
+    if not pair_cells:
+        return False
+
+    info0 = analysis["stats"][0]
+    info1 = analysis["stats"][1]
+    if info0["color"] == info1["color"]:
