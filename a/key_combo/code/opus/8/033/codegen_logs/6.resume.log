+    cleared = g.copy()
+    for r, c in pixels:
+        cleared[r, c] = BACKGROUND
+
+    owner_grid = np.full((h, w), -1, dtype=int)
+    out = cleared.copy()
+    for r in range(h):
+        for c in range(w):
+            if int(cleared[r, c]) != BACKGROUND:
+                continue
+            claimants = []
+            for idx, info in enumerate(stats):
