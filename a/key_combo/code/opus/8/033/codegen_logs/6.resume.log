+    anchors = _place_anchors(h, w, anchor_count, gap)
+    if anchors is None:
+        return None
+
+    counts = _choose_counts(anchor_count, mode)
+    if counts is None:
+        return None
+
+    nearest_dists = _choose_nearest_distances(anchor_count, mode)
