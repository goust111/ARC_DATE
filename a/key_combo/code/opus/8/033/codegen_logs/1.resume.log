+from __future__ import annotations
+
+import random
+from collections import Counter
+
+import numpy as np
+
+
+BLACK = 0
+NONBLACK = tuple(range(1, 10))
+CORNER_ORDER = ("TL", "TR", "BR", "BL")
+SIDE_ORDER = ("T", "R", "B", "L")
+SIDE_DIRS = {"T": (-1, 0), "R": (0, 1), "B": (1, 0), "L": (0, -1)}
+RING_OFFSETS = {
+    "TL": (0, 0),
+    "T": (0, 1),
+    "TR": (0, 2),
+    "L": (1, 0),
+    "R": (1, 2),
+    "BL": (2, 0),
+    "B": (2, 1),
+    "BR": (2, 2),
+}
+ALL_RING_SLOTS = ("TL", "T", "TR", "L", "R", "BL", "B", "BR")
