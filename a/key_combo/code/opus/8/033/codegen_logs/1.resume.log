+def _render_grid(shape: tuple[int, int], ring_specs: list[dict]) -> np.ndarray:
+    grid = np.zeros(shape, dtype=int)
+    for spec in ring_specs:
+        r0, c0 = spec["pos"]
+        grid[r0 : r0 + 3, c0 : c0 + 3] = spec["patch"]
+    return grid
