+    assert rings, "expected at least one one-gap ring"
+    nonblack = g != BLACK
+    assert np.all(cover[nonblack] == 1), "every non-black pixel must belong to exactly one ring"
+    assert np.all(cover[~nonblack] == 0), "only ring pixels may be non-black"
+    return rings
