+    reasons = Counter(spec["stop_reason"] for spec in rings)
+    if reasons["blocked"] < 1 or reasons["boundary"] < 1:
+        return False
+    if any(spec["ray_length"] < 1 for spec in rings):
+        return False
+
+    gap_dirs = {spec["gap_side"] for spec in rings}
+    if len(gap_dirs) < 2:
