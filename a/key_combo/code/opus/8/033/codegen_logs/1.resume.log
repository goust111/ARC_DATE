+        return random.choice(target_gap_options) if target_gap_options else None
+
+    target_gap_options = []
+    for target_gap in ("L", "R"):
+        col_choices = list(range(w - 2))
+        if target_gap == "L":
+            col_choices = [c0 for c0 in col_choices if c0 >= 2]
