+def _allowed_gap_dirs(r0: int, c0: int, h: int, w: int, min_clear: int = 1) -> list[str]:
+    choices = []
+    if r0 >= min_clear:
+        choices.append("T")
+    if c0 + 2 + min_clear < w:
+        choices.append("R")
+    if r0 + 2 + min_clear < h:
+        choices.append("B")
+    if c0 >= min_clear:
+        choices.append("L")
+    return choices
