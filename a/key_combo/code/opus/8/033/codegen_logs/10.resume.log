+    return grid
+
+
+def _choose_state_counts(area: int) -> tuple[int, int, int]:
+    misaligned = random.randint(1, max(1, area - 3))
+    correct = random.randint(2, area - misaligned - 1)
+    missing = area - correct - misaligned
