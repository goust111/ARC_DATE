+
+def generate_input() -> np.ndarray:
+    for _ in range(_MAX_ATTEMPTS):
+        case = _attempt_generate()
+        if case is not None:
+            return case[0]
+    raise RuntimeError("failed to generate a valid thumbnail-slide puzzle")

