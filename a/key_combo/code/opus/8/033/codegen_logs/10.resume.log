+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+def _neighbors4(r: int, c: int) -> list[tuple[int, int]]:
+    return [(r - 1, c), (r + 1, c), (r, c - 1), (r, c + 1)]
+
+
+def _components(mask: np.ndarray) -> list[np.ndarray]:
+    h, w = mask.shape
+    seen = np.zeros_like(mask, dtype=bool)
+    comps: list[np.ndarray] = []
+    for r in range(h):
+        for c in range(w):
+            if not mask[r, c] or seen[r, c]:
+                continue
+            stack = [(r, c)]
+            seen[r, c] = True
+            coords: list[tuple[int, int]] = []
+            while stack:
+                rr, cc = stack.pop()
+                coords.append((rr, cc))
+                for nr, nc in _neighbors4(rr, cc):
+                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and not seen[nr, nc]:
+                        seen[nr, nc] = True
+                        stack.append((nr, nc))
+            comps.append(np.array(coords, dtype=int))
+    return comps
+
+
+def _bbox_coords(coords: np.ndarray) -> tuple[int, int, int, int]:
+    r0, c0 = coords.min(axis=0)
+    r1, c1 = coords.max(axis=0)
+    return int(r0), int(c0), int(r1), int(c1)
+
+
+def _rect_intersects(
+    a: tuple[int, int, int, int],
+    b: tuple[int, int, int, int],
+    *,
+    min_gap: int = 0,
+) -> bool:
+    ar0, ac0, ar1, ac1 = a
+    br0, bc0, br1, bc1 = b
+    return not (
+        ar1 + min_gap < br0
+        or br1 + min_gap < ar0
+        or ac1 + min_gap < bc0
+        or bc1 + min_gap < ac0
+    )
+
+
+def _paint_block(grid: np.ndarray, top: tuple[int, int], size: int, color: int) -> None:
+    r, c = top
+    grid[r : r + size, c : c + size] = int(color)
+
+
+def _find_thumbnail(
+    grid: np.ndarray, bg: int
+) -> tuple[np.ndarray, tuple[int, int, int, int], set[tuple[int, int]]]:
+    candidates: list[tuple[int, int, int, tuple[int, int, int, int], np.ndarray, set[tuple[int, int]]]] = []
+    for coords in _components(grid != bg):
+        r0, c0, r1, c1 = _bbox_coords(coords)
+        sub = grid[r0 : r1 + 1, c0 : c1 + 1]
+        cells = {tuple(map(int, rc)) for rc in coords}
+        if len(cells) != sub.size:
+            continue
+        if np.any(sub == bg):
+            continue
+        flat = [int(v) for v in sub.flat]
+        if len(set(flat)) != len(flat):
