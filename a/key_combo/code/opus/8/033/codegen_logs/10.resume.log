+                _paint_block(out, expected, block_size, color)
+                color_to_block[color] = expected
+
+    for i in range(thumb.shape[0]):
+        for j in range(thumb.shape[1]):
+            color = int(thumb[i, j])
+            expected = (dr + i * step, dc + j * step)
+            if color_to_block.get(color) != expected:
+                _paint_block(out, expected, block_size, color)
