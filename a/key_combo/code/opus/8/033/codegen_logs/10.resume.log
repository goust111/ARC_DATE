+    block_size = random.choice(_BLOCK_SIZES)
+    step = block_size + random.choice(_GAPS)
+
+    max_base_r = h - 1 - block_size - (thumb_h - 1) * step
+    max_base_c = w - 1 - block_size - (thumb_w - 1) * step
+    thumb_r = random.randint(1, 2)
