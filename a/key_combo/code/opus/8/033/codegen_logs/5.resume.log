+        ordered = sorted(open_cells, key=lambda rc: rc[1])
+    else:
+        ordered = sorted(open_cells, key=lambda rc: rc[0])
+    idx = len(ordered) // 2
+    if len(ordered) % 2 == 0:
+        idx = idx if alt_even_midpoint else idx - 1
+    return ordered[idx]
