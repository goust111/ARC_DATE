+        return False
+    if not any(w["blocked_even"] > 0 for w in walls):
+        return False
+    if not all(w["exterior_fill"] > 0 and w["odd_black"] > 0 for w in walls):
+        return False
+
+    if any(w["opening_width"] % 2 == 0 for w in walls) and np.array_equal(out, alt_mid):
+        return False
+
+    return True
+
