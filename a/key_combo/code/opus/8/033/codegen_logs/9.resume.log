            if max(r[2] for r in T)+1 != min(r[0] for r in B): continue
            a=rec(T); b=rec(B)
            if a and b and a[1]==b[1]: memo[rs]=(a[0]+b[0],a[1]); return memo[rs]
        memo[rs]=None; return None
    return rec(rects)

