            if len(L)+len(R)!=len(rs) or not L or not R: continue
            if max(r[3] for r in L)+1 != min(r[1] for r in R): continue
            a=rec(L); b=rec(R)
            if a and b and a[0]==b[0]: memo[rs]=(a[0],a[1]+b[1]); return memo[rs]
        for cut in range(r0,r1):
            T=tuple(sorted([r for r in rs if r[2] <= cut])); B=tuple(sorted([r for r in rs if r[0] > cut]))
