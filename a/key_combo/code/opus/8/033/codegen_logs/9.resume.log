import numpy as np
from collections import deque

RED=2
MARK={1,3}


def main(grid):
    g=np.array(grid,int)
    H,W=g.shape
    out=g.copy()
    starts=np.argwhere(g==RED)
    r,c=map(int,starts[0])
    pending=[(r,c,'h')]
    opened=set()
    seen=set()
    while pending:
        r,c,axis=pending.pop()
        if (r,c,axis) in seen:
            continue
        seen.add((r,c,axis))
        out[r,c]=RED
        dirs=[(0,1),(0,-1)] if axis=='h' else [(1,0),(-1,0)]
        next_axis='v' if axis=='h' else 'h'
        new=[]
        for dr,dc in dirs:
            rr,cc=r+dr,c+dc
            pr,pc=r,c
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc] in MARK:
                    if (rr,cc) not in opened:
                        opened.add((rr,cc))
                        new.append((pr,pc,next_axis))
                    break
                if out[rr,cc]==RED:
                    break
                out[rr,cc]=RED
                pr,pc=rr,cc
                rr+=dr; cc+=dc
        pending.extend(new)
    return out


def regs(g):
    H,W=g.shape
    bad={RED,1,3}
    vis=np.zeros((H,W),bool)
    res=[]
    for r in range(H):
      for c in range(W):
        if vis[r,c] or g[r,c] in bad: continue
        q=[(r,c)]; vis[r,c]=1; pts=[]
        while q:
          x,y=q.pop(); pts.append((x,y))
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            xx,yy=x+dx,y+dy
            if 0<=xx<H and 0<=yy<W and not vis[xx,yy] and g[xx,yy] not in bad:
              vis[xx,yy]=1; q.append((xx,yy))
        rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
        res.append((min(rs),min(cs),max(rs),max(cs),len(pts)))
    return sorted(res)

