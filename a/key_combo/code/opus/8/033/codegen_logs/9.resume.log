        if (box[2]-box[0]+1)*(box[3]-box[1]+1)"'!=len(pts): return None
        regs.append(box)
    return sorted(regs)

def sliceable(rects):
    rects=tuple(sorted(rects)); memo={}
    def rec(rs):
        if rs in memo:return memo[rs]
        if len(rs)==1: memo[rs]=(1,1); return (1,1)
        r0=min(r[0] for r in rs); c0=min(r[1] for r in rs); r1=max(r[2] for r in rs); c1=max(r[3] for r in rs)
