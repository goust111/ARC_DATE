import numpy as np
RED=2
MARK={1,3}

def main(grid):
    g=np.array(grid,int)
    H,W=g.shape
    out=g.copy(); start=tuple(map(int,np.argwhere(g==RED)[0])); pending=[(*start,'h')]; opened=set(); seen=set()
    while pending:
        r,c,axis=pending.pop()
        if (r,c,axis) in seen: continue
        seen.add((r,c,axis)); out[r,c]=RED
        if axis=='h':
            dirs=[(0,-1),(0,1)]; na='v'
        else:
            dirs=[(-1,0),(1,0)]; na='h'
        new=[]
        for dr,dc in dirs:
            rr,cc=r+dr,c+dc; pr,pc=r,c
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc] in MARK:
                    if (rr,cc) not in opened:
                        opened.add((rr,cc)); new.append((pr,pc,na))
                    break
                if out[rr,cc]==RED: break
                out[rr,cc]=RED; pr,pc=rr,cc; rr+=dr; cc+=dc
        pending.extend(new)
    return out

def regs(g):
    H,W=g.shape; bad={RED,1,3}; vis=np.zeros((H,W),bool); rows=[]
    for r in range(H):
      for c in range(W):
        if vis[r,c] or g[r,c] in bad: continue
        st=[(r,c)]; vis[r,c]=1; pts=[]
        while st:
          x,y=st.pop(); pts.append((x,y))
