import numpy as np, random
RED=2
MARKS=(1,3)
LEAFCOLORS=(4,6,7,8,9)

def simulate(markers,H=15,W=15,start=None):
    if start is None:start=random.randrange(H)
    g=np.zeros((H,W),int); g[start,0]=2
    for p,c in markers.items(): g[p]=c
    out=g.copy(); pending=[(start,0,'h')]; opened=set(); seen=set()
    while pending:
        r,c,axis=pending.pop()
        if (r,c,axis) in seen: continue
        seen.add((r,c,axis)); out[r,c]=RED
        dirs=[(0,-1),(0,1)] if axis=='h' else [(-1,0),(1,0)]
        na='v' if axis=='h' else 'h'; new=[]
        for dr,dc in dirs:
            rr,cc=r+dr,c+dc; pr,pc=r,c
            while 0<=rr<H and 0<=cc<W:
                if g[rr,cc] in MARKS:
                    if (rr,cc) not in opened:
                        opened.add((rr,cc)); new.append((pr,pc,na))
                    break
                if out[rr,cc]==RED: break
                out[rr,cc]=RED; pr,pc=rr,cc; rr+=dr; cc+=dc
        pending.extend(new)
    return g,out

def regions(out):
    H,W=out.shape; block={1,2,3}; vis=np.zeros((H,W),bool); regs=[]
    for r in range(H):
      for c in range(W):
        if vis[r,c] or out[r,c] in block: continue
        st=[(r,c)]; vis[r,c]=1; pts=[]
        while st:
          x,y=st.pop(); pts.append((x,y))
          for dx,dy in ((1,0),(-1,0),(0,1),(0,-1)):
            xx,yy=x+dx,y+dy
            if 0<=xx<H and 0<=yy<W and not vis[xx,yy] and out[xx,yy] not in block:
              vis[xx,yy]=1; st.append((xx,yy))
        rs=[p[0] for p in pts]; cs=[p[1] for p in pts]
        box=(min(rs),min(cs),max(rs),max(cs))
        if (box[2]-box[0]+1)*(box[3]-box[1]+1)"'!=len(pts):
            return None
        regs.append(box)
    return sorted(regs)

def build(rects):
    rects=tuple(sorted(rects))
    memo={}
    def rec(rs):
        if rs in memo: return memo[rs]
        if len(rs)==1:
            memo[rs]=((1,1), rs[0])
            return memo[rs]
        r0=min(r[0] for r in rs); c0=min(r[1] for r in rs); r1=max(r[2] for r in rs); c1=max(r[3] for r in rs)
        # vertical cut
        for cut in range(c0, c1):
            L=tuple(sorted([r for r in rs if r[3] <= cut]))
            R=tuple(sorted([r for r in rs if r[1] > cut]))
            if len(L)+len(R)!=len(rs) or not L or not R: continue
            if max(r[3] for r in L)+1 != min(r[1] for r in R): continue
            a=rec(L); b=rec(R)
            if a and b and a[0][0]==b[0][0]:
                memo[rs]=((a[0][0], a[0][1]+b[0][1]), ('"'v',a,b))
                return memo[rs]
        for cut in range(r0, r1):
            T=tuple(sorted([r for r in rs if r[2] <= cut]))
            B=tuple(sorted([r for r in rs if r[0] > cut]))
            if len(T)+len(B)"'!=len(rs) or not T or not B: continue
            if max(r[2] for r in T)+1 != min(r[0] for r in B): continue
            a=rec(T); b=rec(B)
            if a and b and a[0][1]==b[0][1]:
                memo[rs]=((a[0][0]+b[0][0], a[0][1]), ('"'h',a,b))
                return memo[rs]
        memo[rs]=None
        return None
    return rec(rects)

cand=[(r,c) for r in range(15) for c in range(1,15)]
acc=0
for t in range(5000):
    start=random.randrange(15)
    n=random.randint(4,8)
    pts=random.sample(cand,n)
    if not any(r==start and c>0 for r,c in pts):
        continue
    markers={p:random.choice(MARKS) for p in pts}
    g,out=simulate(markers,start=start)
    regs=regions(out)
    if not regs or len(regs)<4 or len(regs)>5:
        continue
    if build(regs):
        acc+=1
        print('example',start,markers,regs,build(regs)[0])
        break
print('acc',acc)
