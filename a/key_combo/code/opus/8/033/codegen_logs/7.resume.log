+        stripe = g[top : top + LAYER_HEIGHT, left[3] + 1 : right[1]].copy()
+        assert stripe.shape[0] == LAYER_HEIGHT and stripe.shape[1] > 0
+        stripes.append(stripe)
+        widths.add(stripe.shape[1])
+
