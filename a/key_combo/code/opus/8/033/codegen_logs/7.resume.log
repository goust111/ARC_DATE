+        assert len(row_blocks) == 2
+        left, right = row_blocks
+        assert left[0] == right[0] and left[2] == right[2]
+        gap_width = right[1] - left[3] - 1
+        assert gap_width > 0
+        assert top + LAYER_HEIGHT <= grid.shape[0]
