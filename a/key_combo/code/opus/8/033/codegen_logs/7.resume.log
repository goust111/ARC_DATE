+            return _build_stripes(rng, num_layers, width)
+        stripes.append(band)
+
+    return stripes, shared_layers
+
+
+def _render_input(
+    rng: np.random.Generator,
+    stripes: list[np.ndarray],
+    width: int,
+) -> np.ndarray:
