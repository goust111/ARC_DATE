+    top_margin = int(rng.integers(0, 3))
+    inter_gaps = [int(rng.integers(1, 4)) for _ in range(num_layers - 1)]
+    tops = [top_margin]
+    for gap in inter_gaps:
+        tops.append(tops[-1] + LAYER_HEIGHT + gap)
+    height = tops[-1] + LAYER_HEIGHT + int(rng.integers(0, 3))
