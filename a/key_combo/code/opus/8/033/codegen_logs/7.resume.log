+
+    expected = _expected_from_stripes(stripes)
+    try:
+        actual = main(grid)
+    except Exception:
+        return False
+    if not np.array_equal(actual, expected):
+        return False
+
+    if actual.shape != (len(stripes) * LAYER_HEIGHT, stripes[0].shape[1]):
+        return False
