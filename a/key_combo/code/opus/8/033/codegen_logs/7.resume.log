    start_range = range(rule["start_min"], width - rule["start_stop_margin"])
    end_limit = width - rule["end_stop_margin"]
    for start in start_range:
        for end in range(start + 1, end_limit):
            intervals.append((start, end))

    out = []

    def rec(chosen, pos):
