+
+    row_need = 2 + sum(heights) + BASE_GAP * (group_count - 1)
+    col_need = 2 + sum(widths) + BASE_GAP * (group_count - 1)
+    if row_need > MAX_GRID_SIDE or col_need > MAX_GRID_SIDE:
