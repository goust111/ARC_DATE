+def _reflect_cells(cells: set[tuple[int, int]], h: int, w: int, corner: str) -> set[tuple[int, int]]:
+    reflected: set[tuple[int, int]] = set()
+    for r, c in cells:
+        rr, cc = int(r), int(c)
+        if corner in {"bl", "br"}:
