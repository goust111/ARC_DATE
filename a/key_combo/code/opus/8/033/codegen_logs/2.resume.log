+    "tl": (-1, -1),
+    "tr": (-1, 1),
+    "bl": (1, -1),
+    "br": (1, 1),
+}
+PREFERRED_MODE_CYCLE = ("row2", "col2", "chain3")
+
+MIN_SIDE = 4
+MAX_SIDE = 6
+BASE_GAP = 3
+MAX_GRID_SIDE = 30
