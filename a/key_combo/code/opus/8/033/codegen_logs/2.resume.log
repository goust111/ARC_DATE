+def _merge_fragment_groups(components: list[dict]) -> list[dict]:
+    groups = [{"coords": comp["coords"], "bbox": comp["bbox"]} for comp in components]
+    changed = True
+    while changed:
+        changed = False
+        for i in range(len(groups)):
+            if changed:
+                break
+            for j in range(i + 1, len(groups)):
