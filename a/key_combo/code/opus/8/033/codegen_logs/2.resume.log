+    out = g.copy()
+    for move in moves:
+        r0, c0, r1, c1 = move["bbox"]
+        out[r0 : r1 + 1, c0 : c1 + 1] = BG
+
+    for move in moves:
+        tr0, tc0, tr1, tc1 = move["target_bbox"]
+        assert np.all(out[tr0 : tr1 + 1, tc0 : tc1 + 1] == BG), "shifted rectangles must not overlap"
