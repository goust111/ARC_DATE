+    g = np.asarray(grid, dtype=int)
+    info = _analyze(g)
+    out = g.copy()
+    divider_rows = set(info["divider_rows"])
+    divider_cols = set(info["divider_cols"])
+    region_map = info["region_map"]
+    main_colors = info["main_colors"]
