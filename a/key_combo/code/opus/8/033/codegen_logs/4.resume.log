+import numpy as np
+
+
+BG = 0
+DIVIDER = 5
+PLUS = 8
+DIRS4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+PALETTE = [1, 2, 3, 4, 6, 7, 9]
+MAX_GEN_ATTEMPTS = 500
