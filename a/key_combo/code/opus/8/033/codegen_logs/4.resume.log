+    all_ray_cells: set[tuple[int, int]] = set()
+    changed = 0
+    crosses_region = False
+    blocker_seen = False
+    for ray in info["rays"]:
+        cells = ray["cells"]
+        region_seq = [int(region_map[r, c]) for r, c in cells]
+        if len(set(region_seq)) >= 2:
