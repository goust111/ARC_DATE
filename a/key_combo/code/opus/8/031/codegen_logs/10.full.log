+    palettes = (
+        (Color.BLUE, Color.GREEN),
+        (Color.RED, Color.TEAL),
+        (Color.BLUE, Color.RED),
+        (Color.BLUE, Color.MAROON),
+        (Color.RED, Color.GREEN),
+        (Color.GREEN, Color.TEAL),
