+            for r in range(seam):
+                first.add((r, c))
+            for r in range(seam + 1, h):
+                second.add((r, c))
+            if states[c] in (0, 2):
+                first.add((seam, c))
+            if states[c] in (1, 2):
+                second.add((seam, c))
+    return first, second
+
+
+def _candidate_patterns(success: bool, orientation: str) -> list[dict]:
