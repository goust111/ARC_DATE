+def _build_rect_parts(
+    orientation: str,
+    h: int,
+    w: int,
+    seam: int,
+    states: tuple[int, ...],
+) -> tuple[set[Coord], set[Coord]]:
+    first: set[Coord] = set()
+    second: set[Coord] = set()
+    if orientation == "h":
+        for r in range(h):
+            for c in range(seam):
+                first.add((r, c))
+            for c in range(seam + 1, w):
+                second.add((r, c))
+            if states[r] in (0, 2):
+                first.add((r, seam))
+            if states[r] in (1, 2):
+                second.add((r, seam))
+    else:
+        for c in range(w):
+            for r in range(seam):
+                first.add((r, c))
+            for r in range(seam + 1, h):
+                second.add((r, c))
+            if states[c] in (0, 2):
+                first.add((seam, c))
+            if states[c] in (1, 2):
+                second.add((seam, c))
+    return first, second
