+
+
+def _placeable_positions(shape: tuple[int, int], patch_shape: tuple[int, int], occupied: np.ndarray) -> list[Coord]:
+    h, w = shape
+    ph, pw = patch_shape
+    positions: list[Coord] = []
+    for r0 in range(h - ph + 1):
+        for c0 in range(w - pw + 1):
+            rr0 = max(0, r0 - PATCH_GAP)
