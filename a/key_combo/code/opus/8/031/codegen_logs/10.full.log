+def _connected(cells: set[Coord]) -> bool:
+    if not cells:
+        return False
+    mask = np.zeros((max(r for r, _ in cells) + 1, max(c for _, c in cells) + 1), dtype=bool)
+    for r, c in cells:
+        mask[r, c] = True
+    return len(components_mask(mask, connectivity=4)) == 1
