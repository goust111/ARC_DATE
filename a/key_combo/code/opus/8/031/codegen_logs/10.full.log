+        "patch": patch,
+        "orientation": orientation,
+        "success": bool(success),
+        "color": int(color),
+        "local_components": [first_orig, second_orig],
+        "local_rect_bbox": rect_bbox,
+    }
+
+
+def _choose_colors(pair_count: int) -> list[int]:
+    if pair_count == 3:
