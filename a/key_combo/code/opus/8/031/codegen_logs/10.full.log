+
+
+def _translate_cells(cells: set[Coord], dr: int, dc: int) -> set[Coord]:
+    return {(r + dr, c + dc) for r, c in cells}
+
+
+def _render_expected(inp: np.ndarray, specs: list[dict]) -> np.ndarray:
+    out = inp.copy()
