+def merge_candidates(cleaned: set[tuple[int, int]]) -> list[tuple[int, int]]:
+    candidates = []
+    for cell in cleaned:
+        if count_neighbors(cell, cleaned) < 2:
+            continue
+        body = cleaned - {cell}
+        if len(body) < 4:
+            continue
+        if is_connected(body):
