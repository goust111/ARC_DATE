+    cleaned = body_coords | merge_noise
+    r0, c0, r1, c1 = bbox_from_coords(cleaned)
+    patch = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=int)
+    mask = np.zeros_like(patch, dtype=bool)
+    for r, c in cleaned:
+        patch[r - r0, c - c0] = color
+        mask[r - r0, c - c0] = True
+    return patch, mask
