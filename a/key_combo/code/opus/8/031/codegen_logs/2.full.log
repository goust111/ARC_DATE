+        r0, c0, r1, c1 = bbox_from_coords(comp)
+        if r0 == 0 or c0 == 0 or r1 == crop.shape[0] - 1 or c1 == crop.shape[1] - 1:
+            continue
+        mask = np.zeros((r1 - r0 + 1, c1 - c0 + 1), dtype=bool)
+        for r, c in comp:
+            mask[r - r0, c - c0] = True
+        assert mask.all()
+        holes.append({"r0": r0, "c0": c0, "h": mask.shape[0], "w": mask.shape[1]})
+    return holes
