+    order = sorted(enumerate(patches), key=lambda x: x[1]["patch"].shape[0] * x[1]["patch"].shape[1], reverse=True)
+    for idx, spec in order:
+        ph, pw = spec["patch"].shape
+        choices = []
+        for r0 in range(H - ph + 1):
+            for c0 in range(W - pw + 1):
+                rr0 = max(0, r0 - 1)
+                cc0 = max(0, c0 - 1)
