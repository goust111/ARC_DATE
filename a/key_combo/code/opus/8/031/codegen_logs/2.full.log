+        placed[idx] = {"r0": r0, "c0": c0, "h": h, "w": w}
+    return [p for p in placed if p is not None]
+
+
+def place_patch_on_grid(
+    grid: np.ndarray,
+    patch: np.ndarray,
+    r0: int,
+    c0: int,
+) -> None:
+    nonzero = patch != BG
+    grid[r0 : r0 + patch.shape[0], c0 : c0 + patch.shape[1]][nonzero] = patch[nonzero]
