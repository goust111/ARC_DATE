+def is_connected(cells: set[tuple[int, int]]) -> bool:
+    if not cells:
+        return False
+    q = deque([next(iter(cells))])
+    seen = {q[0]}
+    while q:
+        r, c = q.popleft()
+        for nr, nc in neighbors4(r, c):
+            if (nr, nc) in cells and (nr, nc) not in seen:
+                seen.add((nr, nc))
+                q.append((nr, nc))
+    return len(seen) == len(cells)
