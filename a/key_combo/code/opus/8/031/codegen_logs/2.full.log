+import random
+from collections import Counter, deque
+
+import numpy as np
+
+
+BG = 0
+TEMPLATE = 5
+NOISE = 7
+DIR4 = [(-1, 0), (1, 0), (0, -1), (0, 1)]
+SPRITE_COLORS = [1, 2, 3, 4, 6, 8, 9]
+ALLOWED_DIMS = [(2, 3), (3, 2), (2, 4), (4, 2), (3, 3), (2, 5), (5, 2), (3, 4), (4, 3)]
+NOISY_TARGETS = [(3, 3), (3, 4), (4, 3)]
+MAX_GEN_ATTEMPTS = 400
