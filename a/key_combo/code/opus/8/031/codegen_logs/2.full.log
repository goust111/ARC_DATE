+    template_crop = np.full((template_h, template_w), TEMPLATE, dtype=int)
+    for hole in holes:
+        template_crop[hole["r0"] : hole["r0"] + hole["h"], hole["c0"] : hole["c0"] + hole["w"]] = BG
+
+    out = template_crop.copy()
