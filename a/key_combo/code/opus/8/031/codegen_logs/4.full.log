+    grid[border] = START
+    grid[inner] = START
+    for r, c in blockers:
+        grid[r, c] = BLOCK
+
+    extra_sites = _extra_blocker_sites(shape, set(path), blockers)
+    for cell in extra_sites[: random.randint(*EXTRA_BLOCKER_RANGE)]:
