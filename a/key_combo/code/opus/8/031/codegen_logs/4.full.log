+    total_turns = random.randint(MIN_TURNS, MAX_TURNS)
+
+    border, inner, direction = _choose_entry(shape)
+    base_path = [border, inner]
+    path_cells = set(base_path)
+    blocker_cells: set[tuple[int, int]] = set()
+
+    def extend(
+        pos: tuple[int, int],
+        current_dir: tuple[int, int],
