+def _block_slice(block_r: int, block_c: int) -> tuple[slice, slice]:
+    r0 = int(block_r) * BLOCK_SIZE
+    c0 = int(block_c) * BLOCK_SIZE
+    return slice(r0, r0 + BLOCK_SIZE), slice(c0, c0 + BLOCK_SIZE)
