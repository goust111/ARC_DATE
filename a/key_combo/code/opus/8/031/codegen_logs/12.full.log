+    max_blue = grid_width - seg_width - 2
+    choices = list(range(max_blue + 1))
+    if not choices:
+        return None
+    for _ in range(200):
+        cols = [random.choice(choices) for _ in range(count)]
+        if len(set(cols)) >= 2:
