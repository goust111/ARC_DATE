+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BLACK = 0
+BLUE = 1
+RED = 2
+GREY = 5
+TEAL = 8
+
+INPUT_COLORS = (BLACK, BLUE, RED, TEAL)
+MAX_GENERATION_ATTEMPTS = 800
+_SEEN_OUTPUT_SIGNATURES: set[tuple[tuple[int, int], bytes]] = set()
