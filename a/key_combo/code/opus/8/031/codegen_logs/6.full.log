+    out = main_area.copy()
+    ordered_specs = sorted(specs, key=lambda item: (item["bbox"][0], item["bbox"][1]))
+    assert len(ordered_specs) == len(legend_entries)
+    for spec, (_obj_color, halo_color, step) in zip(ordered_specs, legend_entries):
