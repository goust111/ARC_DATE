+def _simulate_from_specs(main_area: np.ndarray, specs: list[dict], mapping: dict[int, tuple[int, int]]) -> np.ndarray:
+    out = main_area.copy()
+    for spec in sorted(specs, key=lambda item: (item["bbox"][0], item["bbox"][1])):
