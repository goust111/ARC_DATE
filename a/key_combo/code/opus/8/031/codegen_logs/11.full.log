+        out[r - 1 : r + 2, c - 1 : c + 2] = ring_color
+        out[r, c] = center_color
+
+    for r, c in corner_list:
+        center_color = int(g[r, c])
+        ring_color = color_b if center_color == color_a else color_a
+        for dr, dc in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
