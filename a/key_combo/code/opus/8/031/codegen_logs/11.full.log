+    cols = sorted(int(c) for c in np.unique(coords[:, 1]))
+    assert len(rows) == 2 and len(cols) == 2, "markers must form a rectangle"
+    top, bottom = rows
+    left, right = cols
+    assert bottom > top and right > left
+    assert bottom - top >= 5 and right - left >= 5
+
+    corners = {
