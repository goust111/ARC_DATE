  input:
    markers: exactly 4 non-black pixels on an otherwise black grid
    colors: exactly 2 foreground colors (not grey), each appearing twice
    layout: the 4 pixels sit at corners of an axis-aligned rectangle (2 distinct rows, 2 distinct cols)
    diagonal_pairing: same color on diagonally opposite corners (TL==BR, TR==BL, TL!=TR)
    rectangle: height 5-11, width 5-11 (measured as row/col difference)
    margin: each corner pixel >=1 cell from every grid edge (for 3x3 glyph clearance)
