+from __future__ import annotations
+
+import random
+
+import numpy as np
+
+
+BG = 0
+PALETTE = (1, 2, 3, 4, 6, 7, 8, 9)
+GRID_RANGE = (17, 23)
+RADIATION_MARGIN = 3
