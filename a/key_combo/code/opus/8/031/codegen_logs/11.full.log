_GEN_GLYPH_RADIUS = 1
_GEN_DASH_INSET = 2
_GEN_MAX_ATTEMPTS = 300


def _gen_paint_dash_gap(out: np.ndarray, fixed: int, start: int, end: int, axis: str) -> None:
    offsets = np.arange(end - start + 1)
    positions = start + offsets[np.minimum(offsets, offsets[-1] - offsets) % 2 == 0]
