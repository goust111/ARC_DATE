    rows, cols = shape
    r0, c0, r1, c1 = bbox
    if side == "top":
        return r0
    if side == "bottom":
        return rows - r1 - 1
    if side == "left":
        return c0
    return cols - c1 - 1


def _gen_ray_step(side):
    if side == "top":
        return -1, 0
    if side == "bottom":
        return 1, 0
    if side == "left":
        return 0, -1
    return 0, 1


def _gen_side_cells(bbox, side):
    r0, c0, r1, c1 = bbox
    if side == "top":
        return [(r0, c) for c in range(c0 + 1, c1)]
    if side == "bottom":
        return [(r1, c) for c in range(c0 + 1, c1)]
    if side == "left":
        return [(r, c0) for r in range(r0 + 1, r1)]

