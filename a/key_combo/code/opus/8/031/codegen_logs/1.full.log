spec:
  grid: 20-29 rows x 20-29 cols, black background
  objects:
    count: 2
    color: any single non-yellow, non-black color; azure [observed]
    shape: |
      Rounded rectangle: a filled rectangle with corners cut as 45-degree chamfers.
      Row widths increase by +2 per row from edge toward center, plateau at max, then decrease by -2.
      Column heights follow the same pattern. All rows/cols are contiguous and centered.
    corner_radius: 1-4 steps per corner; left_r == right_r always; top_r == bottom_r [observed, 5/6]
    bbox_height: 6-15
    bbox_width: 5-17
    side_runs: each of top/bottom/left/right edge run >= 3 pixels (required by solver)
    symmetry: LR-symmetric always; UD-symmetric [observed, 5/6]
    fill_ratio: 0.76-0.93
  placement:
    objects non-overlapping with bounding boxes separated by >= 2 rows/cols gap
    caps from different objects must not overlap (yellow painted on bg only)
    at least one cap clipped by grid edge in every example [observed]
  transform:
    preserve all input pixels
    from each side's edge run, paint yellow shrinking caps outward by -2 width per step
    caps only overwrite black background cells; clipped at grid boundary

generation_strategy:
  approach: direct construction (shapes are simple enough)
  steps:
    1. Pick grid size 20-29 x 20-29.
    2. For each of 2 objects, choose corner_radius (1-4), full_width (2*radius+3 to ~17),
