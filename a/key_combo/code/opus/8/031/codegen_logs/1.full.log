            rr = r + int(np.random.randint(0, band_h - h + 1))
            bboxes.append((rr, c, rr + h - 1, c + w - 1))
            c += w + MIN_BBOX_GAP + col_gaps[j + 1]
        r += band_h
        if band_i + 1 < len(groups):
            r += MIN_BBOX_GAP + row_gaps[band_i + 1]
    return bboxes


def _gen_col_layout(rows, cols, count):
