+    r0, c0 = arr.min(axis=0)
+    shifted = arr - np.array([r0, c0], dtype=int)
+    h, w = shifted.max(axis=0) + 1
+    mask = np.zeros((int(h), int(w)), dtype=bool)
+    mask[shifted[:, 0], shifted[:, 1]] = True
+    return mask, (int(r0), int(c0))
