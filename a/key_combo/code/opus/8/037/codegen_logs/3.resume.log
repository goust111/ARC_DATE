+    while len(positions) < count:
+        random_target = (random.randint(0, height - 1), random.randint(0, width - 1))
+        snapped = _snap_to_valid(random_target, height, width, diamonds, used)
+        if snapped is None:
+            return None
+        positions.append(snapped)
+        used.add(snapped)
