+    return None
+
+
+def _sample_markers(
+    height: int,
+    width: int,
+    diamonds: list[dict[str, object]],
+    intervals: list[dict[str, int]],
+    want_tie: bool,
+) -> tuple[list[dict[str, int]], str | None] | None:
+    bbox_r0, bbox_c0, bbox_r1, bbox_c1 = _scene_bbox(diamonds)
