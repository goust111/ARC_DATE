def count_wall_components(grid):
    mask = grid == 5
    h, w = mask.shape
    seen = set()
    comps = 0
    for r, c in np.argwhere(mask):
        cell = (int(r), int(c))
        if cell in seen:
            continue
        comps += 1
        stack = [cell]
        seen.add(cell)
        while stack:
            rr, cc = stack.pop()
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    nr, nc = rr + dr, cc + dc
                    if 0 <= nr < h and 0 <= nc < w and mask[nr, nc] and (nr, nc) not in seen:
                        seen.add((nr, nc))
                        stack.append((nr, nc))
    return comps


def tie_exists(grid):
    markers = [
        {'r': int(r), 'c': int(c)}
        for r, c in np.argwhere((grid "'!= 0) & (grid != 5))
    ]
    for interval in mod._grid_row_intervals(grid):
        center = (interval['"'row'], interval['center_c'])
        dists = [abs(m['r'] - center[0]) + abs(m['c'] - center[1]) for m in markers]
        if dists.count(min(dists)) > 1:
            return True
    return False

stats = Counter()
for _ in range(200):
    g = mod.generate_input()
    stats[f\"diamonds_{count_wall_components(g)}\"] += 1
    stats[f\"tie_{tie_exists(g)}\"] += 1
print(dict(stats))
