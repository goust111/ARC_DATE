+        cells, tie_mode = tie_positions
+        for cell in cells:
+            positions.append(cell)
+            used.add(cell)
+
+    count = random.randint(*MARKER_COUNT_RANGE)
+    anchor_targets = [
+        (bbox_r0 - 3, bbox_c0 + 1),
+        (bbox_r1 + 3, (bbox_c0 + bbox_c1) // 2),
+        (bbox_r0 + 1, bbox_c1 + 4),
+        ((bbox_r0 + bbox_r1) // 2, bbox_c0 - 4),
+        (bbox_r1 - 1, bbox_c1 + 3),
+        (bbox_r0 - 4, (bbox_c0 + bbox_c1) // 2 + 2),
+        (bbox_r1 + 4, bbox_c0 + 2),
