+    while len(positions) < count and anchor_targets:
+        target = anchor_targets.pop()
+        snapped = _snap_to_valid(target, height, width, diamonds, used)
+        if snapped is None:
+            continue
+        positions.append(snapped)
+        used.add(snapped)
