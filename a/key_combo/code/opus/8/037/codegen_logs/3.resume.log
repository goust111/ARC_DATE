+                c = int(interval["center_c"])
+                for d in range(3, 6):
+                    options = [((r - d, c), (r, c - d)), ((r - d, c), (r, c + d))]
+                    random.shuffle(options)
+                    for a, b in options:
+                        if _is_valid_marker_cell(a[0], a[1], height, width, diamonds, used) and _is_valid_marker_cell(
+                            b[0], b[1], height, width, diamonds, used | {a}
