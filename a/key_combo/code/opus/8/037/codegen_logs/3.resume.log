+            {
+                **interval,
+                "winner": int(winner_idx),
+                "color": fill_color,
+                "tie": int(tie),
+            }
+        )
+    return out, annotated
+
+
+def _semantic_checks(
+    height: int,
+    width: int,
+    diamonds: list[dict[str, object]],
+    markers: list[dict[str, int]],
